                cg_alu_imm(5, 16, 4);
                cg_push(3);
                cg_lea_mr(4, 8, 3);
                cg_mov_rr(3, 0);
                store_enum_tag(k.val, enum_tag_type(ety));
                gen_variant_inits(k.inits, variant_payload_off(k.variant));
                cg_mov_mr(3, 0, 0);
                cg_pop(3);
                return
            }
            sz = sz + 15 & 0 - 16;
            cg_alu_imm(5, sz, 4);
            cg_push(3);
            cg_lea_mr(4, 8, 3);
            cg_mov_rr(3, 0);
            store_enum_tag(k.val, enum_tag_type(ety));
            gen_variant_inits(k.inits, variant_payload_off(k.variant));
            cg_mov_rr(3, 0);
            cg_pop(3);
            return
