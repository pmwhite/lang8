tag compiler_internal;

// Emit x86-64 from the typed AST.
new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    l
}

enum_mem_size(ty: *Type): int {
    if (!is_enum_ty(ty) || passes_by_ref(ty)) 0 else type_size(ty)
}

load_mem(ty: *Type) noregion raises Error, IndexOutOfBounds {
    esz: int = enum_mem_size(ty);
    if (esz == 1 || is_byte_ty(ty)) cg_movzb_mr(0, 0, 0) else {
        if (esz == 4 || is_i32_ty(ty)) cg_movsxd_mr(0, 0, 0) else {
            if (is_u32_ty(ty) || is_f32_ty(ty)) cg_movl_mr(0, 0, 0) else cg_mov_mr(0,
                0, 0)
        }
    }
}

// Load a scalar using an x86 memory displacement, without materializing
// the field address in a separate add instruction.
load_mem_at(
    ty: *Type,
    base: int,
    offset: int,
    dst: int
) noregion raises Error, IndexOutOfBounds {
    esz: int = enum_mem_size(ty);
    if (esz == 1 || is_byte_ty(ty)) cg_movzb_mr(base, offset, dst) else {
        if (esz == 4 || is_i32_ty(ty)) cg_movsxd_mr(base, offset, dst) else {
            if (is_u32_ty(ty) || is_f32_ty(ty)) cg_movl_mr(base, offset, dst) else cg_mov_mr(base,
                offset, dst)
        }
    }
}

store_mem(ty: *Type) noregion raises Error, IndexOutOfBounds {
    store_mem_at(ty, 7, 0)
}

store_mem_at(ty: *Type, base: int, offset: int) noregion raises Error, IndexOutOfBounds {
    esz: int = enum_mem_size(ty);
    if (esz == 1 || is_byte_ty(ty)) cg_movb_rm(0, base, offset) else {
        if (esz == 4 || is_i32_ty(ty) || is_u32_ty(ty) || is_f32_ty(ty)) cg_movl_rm(0,
            base, offset) else cg_mov_rm(0, base, offset)
    }
}

/* Write tag into (%rax). Width follows the enum's tag type. */
store_enum_tag(tag: int, tag_ty: *Type) noregion raises Error, IndexOutOfBounds {
    cg_mov_imm(tag, 7);
    if (is_i8_ty(tag_ty)) cg_movb_rm(7, 0, 0) else {
        if (is_i32_ty(tag_ty) || is_u32_ty(tag_ty)) cg_movl_rm(7, 0, 0) else cg_mov_rm(7,
            0, 0)
    }
}

variant_payload_off(v: ?*Variant): int {
    if (v == null) 8 else v.payload_offset
}

// Aggregate copies may clobber rax and xmm0. Incoming float parameters are
// spilled before these copies, and expression temporaries live in GPRs.
emit_memcpy(sz: int) noregion raises Error, IndexOutOfBounds {
    if (sz <= 0) sz = 8;
    i: int = 0;
    while (i + 16 <= sz) {
        cg_copy16(i);
        i = i + 16
    }
    while (i + 8 <= sz) {
        cg_mov_mr(6, i, 0);
        cg_mov_rm(0, 7, i);
        i = i + 8
    }
    while (i < sz) {
        cg_movzb_mr(6, i, 0);
        cg_movb_rm(0, 7, i);
        i = i + 1
    }
}

/* Store value in %rax into (%rdi). By-ref aggregates: %rax is a source pointer. */
store_value(ty: *Type) noregion raises Error, IndexOutOfBounds {
    if (passes_by_ref(ty)) {
        cg_mov_rr(0, 6);
        emit_memcpy(type_size(ty))
    } else store_mem(ty)
}

/* Fill in %r8, dest in %rdi. Struct/enum/exn literals are addresses. */
store_array_fill(fill: *Expr, base: *Type) noregion raises Error, IndexOutOfBounds {
    if (is_struct_ty(base) || is_enum_ty(base) || is_exn_ty(base)) {
        lit: bool = false;
        match fill.kind {
            StructLit _ -> lit = true;
            VariantLit _ -> lit = true;
            _ -> { }
        }
        if (lit || passes_by_ref(base)) {
            cg_mov_rr(8, 6);
            emit_memcpy(type_size(base));
            return
        }
    }
    cg_mov_rr(8, 0);
    store_mem(base)
}

/*
 * Object base in %rbx (absolute). Eval RHS first so a large aggregate stack
 * temp from gen_expr cannot bury a pushed destination address.
 * base_off is added to each field offset (0 for structs, 8 for enum payloads).
 */
gen_field_inits(inits: ?*FieldInit, base_off: int) noregion raises Error, IndexOutOfBounds {
    init: ?*FieldInit = inits;
    while (init != null) {
        lhs: ?*Expr = init.lhs;
        if (lhs != null) {
            mem: *Member = init.member or error("internal");
            mty: *Type = mem.ty;
            gen_expr(lhs);
            cg_mov_rr(3, 7);
            off: int = base_off + mem.offset;
            if (off != 0) cg_alu_imm(0, off, 7);
            store_value(mty)
        }
        init = init.next
    }
}

emit_exit1() noregion raises Error, IndexOutOfBounds {
    cg_mov_imm(1, 7);
    cg_call("exit")
}

/* Cap one allocation at 512MiB; n * esz + 8 must not wrap. */
emit_check_new_count(nreg: int, esz: int) noregion raises Error, IndexOutOfBounds {
    max_n: int = 536870904 / esz;
    if (max_n <= 0) max_n = 0;
    cg_alu_imm(7, max_n, nreg);
    cg_jump_id(7, oob_lab)
}

emit_malloc() noregion raises Error, IndexOutOfBounds {
    cg_call("malloc");
    cg_alu_imm(7, 0, 0);
    cg_jump_id(4, oob_lab)
}

emit_exc_malloc() noregion raises Error, IndexOutOfBounds {
    cg_call("l8_exc_malloc");
    cg_alu_imm(7, 0, 0);
    cg_jump_id(4, oob_lab)
}

/* Args already in rdi=dst, rsi=di, rdx=src, rcx=si, r8=n. Check ends, then
 * call runtime memcpy(dst+di, src+si, n). ja: di+n > len is OOB.
 * di/si are also compared to len first so a negative index cannot wrap. */
emit_memcpy_call() noregion raises Error, IndexOutOfBounds {
    cg_mov_mr(7, 0 - 8, 0);
    cg_alu_rr(57, 0, 6);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(6, 10);
    cg_alu_rr(1, 8, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_mov_mr(2, 0 - 8, 0);
    cg_alu_rr(57, 0, 1);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(1, 10);
    cg_alu_rr(1, 8, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_alu_rr(1, 6, 7);
    cg_alu_rr(1, 1, 2);
    cg_mov_rr(2, 6);
    cg_mov_rr(8, 2);
    cg_call("l8_memcpy")
}

/* Read args are already in registers. []i8 uses the length prefix; *i8 is one byte. */
emit_io_call(name: []i8@immortal, args: ?*Expr) noregion raises Error, IndexOutOfBounds {
    a0: ?*Expr = args;
    if (a0 == null) error("missing I/O args");
    a1: ?*Expr = a0.next;
    if (a1 == null) error("missing I/O args");
    t1: ?*Type = decay(a1.ty);
    a2: ?*Expr = a1.next;
    if (t1 != null && is_pointer(t1)) {
        cg_mov_imm(1, 2);
        cg_call(name);
        return
    }
    if (a2 == null) {
        cg_mov_mr(6, 0 - 8, 2);
        cg_call(name);
        return
    }
    if (a2.next == null) {
        cg_mov_mr(6, 0 - 8, 0);
        cg_alu_rr(57, 0, 2);
        cg_jump_id(7, oob_lab);
        cg_call(name);
        return
    }
    cg_mov_mr(6, 0 - 8, 0);
    cg_alu_rr(57, 0, 2);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(2, 10);
    cg_alu_rr(1, 1, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_alu_rr(1, 2, 6);
    cg_mov_rr(1, 2);
    cg_call(name)
}

emit_scale_offset(esz: int) noregion raises Error, IndexOutOfBounds {
    if (esz == 1) {
        cg_alu_rr(1, 1, 6);
        cg_mov_rr(6, 0)
    } else {
        cg_mov_rr(1, 0);
        if (esz != 0) cg_imul_imm(esz, 0);
        cg_alu_rr(1, 6, 0)
    }
}

index_atom(n: *Expr): bool {
    match n.kind {
        Num k -> k.str_label == 0;
        Var _p -> true;
        _ -> false
    }
}

index_simple(n: *Expr): bool {
    match n.kind {
        Num k -> k.str_label == 0;
        Var _p -> true;
        Binary k -> {
            match k.op {
                Add -> index_atom(k.lhs) && index_atom(k.rhs);
                _ -> false
            }
        }
        _ -> false
    }
}

gen_simple_idx(n: *Expr) noregion raises Error, IndexOutOfBounds {
    match n.kind {
        Num k -> {
            cg_mov_imm(k.val, 0);
            return
        }
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo == null) error("missing var");
            vu: *Obj = vo;
            if (vu.is_const) cg_mov_imm(vu.const_val, 0) else emit_load_var(vu, vu.ty or error("missing type"));
            return
        }
        Binary k -> {
            kn: int = index_idx_num(k.rhs);
            if (kn >= 0) {
                gen_simple_idx(k.lhs);
                if (kn != 0) cg_alu_imm(0, kn, 0);
                return
            }
            knl: int = index_idx_num(k.lhs);
            if (knl >= 0) {
                gen_simple_idx(k.rhs);
                if (knl != 0) cg_alu_imm(0, knl, 0);
                return
            }
            gen_simple_idx(k.lhs);
            cg_mov_rr(0, 1);
            gen_simple_idx(k.rhs);
            cg_alu_rr(1, 1, 0);
            return
        }
        _ -> error("internal: gen_simple_idx")
    }
}

gen_index_addr(lhs: *Expr, idx: *Expr) noregion raises Error, IndexOutOfBounds {
    raw: *Type = lhs.ty or error("missing type");
    esz: int = type_size(type_base(raw));
    lv: ?*Obj = index_lhs_var(lhs);
    if (lv != null && index_simple(idx)) {
        gen_simple_idx(idx);
        cg_mov_rr(0, 1);
        lvo: *Obj = lv;
        if (is_array(raw)) {
            if (lvo.is_local) cg_lea_mr(5, lvo.offset, 6) else cg_lea_rip(lvo.name,
                0, 6);
            emit_scale_offset(esz);
            return
        }
        lty: *Type = lvo.ty or error("missing type");
        emit_load_var(lvo, lty);
        cg_mov_rr(0, 6);
        if (!is_slice(raw) && !is_str(raw)) error("index requires str, []T, or [N]T");
        emit_scale_offset(esz);
        return
    }
    cg_push(3);
    if (is_array(raw)) {
        gen_expr(lhs);
        cg_mov_rr(0, 6);
        cg_push(6);
        gen_expr(idx);
        cg_mov_rr(0, 1);
        cg_pop(6)
    } else {
        if (!is_slice(raw) && !is_str(raw)) error("index requires str, []T, or [N]T");
        gen_expr(lhs);
        cg_mov_rr(0, 6);
        cg_push(6);
        gen_expr(idx);
        cg_mov_rr(0, 1);
        cg_pop(6)
    }
    emit_scale_offset(esz);
    cg_pop(3)
}

gen_struct_inits(inits: ?*FieldInit) noregion raises Error, IndexOutOfBounds {
    gen_field_inits(inits, 0)
}

gen_variant_inits(inits: ?*FieldInit, base_off: int) noregion raises Error, IndexOutOfBounds {
    gen_field_inits(inits, base_off)
}

gen_addr(n: *Expr) noregion raises Error, IndexOutOfBounds {
    if (gen_simple_addr(n, 0)) return;
    match n.kind {
        Var k -> {
            var: ?*Obj = k.var;
            if (var == null) error("missing var");
            vo: *Obj = var;
            if (vo.is_local) cg_lea_mr(5, vo.offset, 0) else cg_lea_rip(vo.name, 0,
                0);
            return
        }
        Deref k -> {
            gen_expr(k.lhs);
            return
        }
        Index k -> {
            gen_index_addr(k.lhs, k.idx);
            return
        }
        MemberAccess k -> {
            t: ?*Type = decay(k.lhs.ty);
            if (t != null && is_any_pointer(t) && (is_struct_ty(type_base(t)) || is_exn_ty(type_base(t)))) gen_expr(k.lhs) else gen_addr(k.lhs);
            mem: *Member = k.member or error("internal");
            if (mem.offset != 0) cg_alu_imm(0, mem.offset, 0);
            return
        }
        _ -> error("not an lvalue")
    }
}

/* Scalar load of a variable into %rax without lea+deref. */
emit_load_var(vo: *Obj, ty: *Type) noregion raises Error, IndexOutOfBounds {
    if (vo.cg_register as int > 1) {
        cg_mov_rr(vo.cg_register as int, 0);
        return
    }
    esz: int = enum_mem_size(ty);
    if (vo.is_local) {
        if (esz == 1 || is_byte_ty(ty)) cg_movzb_mr(5, vo.offset, 0) else {
            if (esz == 4 || is_i32_ty(ty)) cg_movsxd_mr(5, vo.offset, 0) else {
                if (is_u32_ty(ty) || is_f32_ty(ty)) cg_movl_mr(5, vo.offset, 0) else cg_mov_mr(5,
                    vo.offset, 0)
            }
        }
    } else {
        cg_mov_rip_r(vo.name, 0, 0);
        if (esz == 4 || is_i32_ty(ty)) cg_movsxd_eax();
        if (is_u32_ty(ty) || is_f32_ty(ty)) cg_movl_eax()
    }
}

emit_store_var(vo: *Obj, ty: *Type) noregion raises Error, IndexOutOfBounds {
    if (vo.cg_register as int > 1) {
        cg_mov_rr(0, vo.cg_register as int);
        return
    }
    esz: int = enum_mem_size(ty);
    if (vo.is_local) {
        if (esz == 1 || is_byte_ty(ty)) cg_movb_rm(0, 5, vo.offset) else {
            if (esz == 4 || is_i32_ty(ty) || is_u32_ty(ty) || is_f32_ty(ty)) cg_movl_rm(0,
                5, vo.offset) else cg_mov_rm(0, 5, vo.offset)
        }
    } else cg_mov_r_rip(0, vo.name, 0)
}

fits_imm32(v: int): bool {
    lo: int = 0 - 2147483647;
    lo = lo - 1;
    hi: int = 2147483647;
    if (v < lo) return false;
    if (v > hi) return false;
    true
}

/* Store an immediate into a scalar variable (no %rax round-trip). */
emit_store_imm(vo: *Obj, ty: *Type, v: int) noregion raises Error, IndexOutOfBounds {
    if (vo.cg_register as int > 1) {
        cg_mov_imm(v, vo.cg_register as int);
        return
    }
    esz: int = enum_mem_size(ty);
    if (vo.is_local) {
        if (esz == 1 || is_byte_ty(ty)) cg_movb_imm_m(v, 5, vo.offset) else {
            if (esz == 4 || is_i32_ty(ty) || is_u32_ty(ty) || is_f32_ty(ty)) cg_movl_imm_m(v,
                5, vo.offset) else cg_movq_imm_m(v, 5, vo.offset)
        }
    } else {
        if (esz == 1 || is_byte_ty(ty)) cg_movb_imm_rip(v, vo.name) else cg_movq_imm_rip(v,
            vo.name)
    }
}

// These address paths are rooted in locals and use reg plus r10/r11.
// In particular they preserve rax when reg is rdi, so a scalar assignment
// can retain its evaluated RHS without a push/pop pair. A failed attempt
// emits no calls or writes and the normal address path may safely retry.
// A value already resident in a register can be used without a scratch copy.
// These locals cannot be changed through aliases (allocation excludes addresses).
cg_value_register(n: *Expr): int {
    match n.kind {
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo != null && vo.cg_register as int > 1) vo.cg_register as int else 0
        }
        _ -> 0
    }
}

gen_simple_pointer(n: *Expr, reg: int) noregion raises Error, IndexOutOfBounds: bool {
    match n.kind {
        Var _ -> gen_simple_operand(n, reg);
        MemberAccess _ -> gen_simple_operand(n, reg);
        _ -> false
    }
}

gen_simple_member_base(lhs: *Expr, reg: int) noregion raises Error, IndexOutOfBounds: bool {
    ty: ?*Type = decay(lhs.ty);
    if (ty != null && is_any_pointer(ty) && (is_struct_ty(type_base(ty)) || is_exn_ty(type_base(ty)))) return gen_simple_pointer(lhs,
        reg);
    gen_simple_addr(lhs, reg)
}

gen_simple_store(lhs: *Expr, ty: *Type) noregion raises Error, IndexOutOfBounds: bool {
    match lhs.kind {
        MemberAccess k -> {
            base: int = cg_value_register(k.lhs);
            if (base == 0) {
                if (!gen_simple_member_base(k.lhs, 7)) return false;
                base = 7
            }
            member: *Member = k.member or error("internal");
            store_mem_at(ty, base, member.offset);
            true
        }
        _ -> {
            if (!gen_simple_addr(lhs, 7)) return false;
            store_mem(ty);
            true
        }
    }
}

gen_simple_addr(n: *Expr, reg: int) noregion raises Error, IndexOutOfBounds: bool {
    match n.kind {
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo == null || !vo.is_local) return false;
            cg_lea_mr(5, vo.offset, reg);
            true
        }
        Deref k -> gen_simple_pointer(k.lhs, reg);
        MemberAccess k -> {
            if (!gen_simple_member_base(k.lhs, reg)) return false;
            member: *Member = k.member or error("internal");
            if (member.offset != 0) cg_lea_mr(reg, member.offset, reg);
            true
        }
        Index k -> {
            if (!index_simple(k.idx)) return false;
            ty: *Type = k.lhs.ty or error("missing type");
            if (is_array(ty)) {
                if (!gen_simple_addr(k.lhs, reg)) return false
            } else if (!gen_simple_pointer(k.lhs, reg)) return false;
            size: int = type_size(type_base(ty));
            if (imm_operand(k.idx)) {
                offset: int = imm_value(k.idx) * size;
                if (fits_imm32(offset)) {
                    if (offset != 0) cg_lea_mr(reg, offset, reg);
                    return true
                }
            }
            match k.idx.kind {
                Binary sum -> {
                    if (!gen_simple_operand(sum.lhs, 10)) return false;
                    if (!gen_simple_operand(sum.rhs, 11)) return false;
                    cg_alu_rr(1, 11, 10)
                }
                _ -> {
                    if (!gen_simple_operand(k.idx, 10)) return false
                }
            }
            if (size != 1) cg_imul_imm(size, 10);
            cg_alu_rr(1, 10, reg);
            true
        }
        _ -> false
    }
}

gen_load(n: *Expr) noregion raises Error, IndexOutOfBounds {
    ty: *Type = n.ty or error("missing type");
    if (passes_by_ref(ty)) {
        gen_addr(n);
        return
    }
    match n.kind {
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo != null) {
                emit_load_var(vo, ty);
                return
            }
        }
        _ -> { }
    }
    match n.kind {
        MemberAccess k -> {
            base: int = cg_value_register(k.lhs);
            if (base != 0) {
                member: *Member = k.member or error("internal");
                load_mem_at(ty, base, member.offset, 0);
                return
            }
            base_ty: ?*Type = decay(k.lhs.ty);
            if (base_ty != null && is_any_pointer(base_ty) && (is_struct_ty(type_base(base_ty)) || is_exn_ty(type_base(base_ty)))) gen_expr(k.lhs) else gen_addr(k.lhs);
            member: *Member = k.member or error("internal");
            load_mem_at(ty, 0, member.offset, 0);
            return
        }
        _ -> { }
    }
    if (!gen_simple_addr(n, 0)) gen_addr(n);
    load_mem(ty)
}

/* Load a side-effect-free scalar directly into an operand register. Evaluate
 * the left operand first: even a simple RHS local may be changed by that call. */
gen_simple_operand(n: *Expr, reg: int) noregion raises Error, IndexOutOfBounds: bool {
    if (imm_operand(n)) {
        cg_mov_imm(imm_value(n), reg);
        return true
    }
    match n.kind {
        Var k -> {
            vo: ?*Obj = k.var;
            ty: ?*Type = n.ty;
            if (vo == null || ty == null || passes_by_ref(ty)) return false;
            if (vo.is_const) {
                cg_mov_imm(vo.const_val, reg);
                return true
            }
            if (!vo.is_local) return false;
            if (vo.cg_register as int > 1) {
                cg_mov_rr(vo.cg_register as int, reg);
                return true
            }
            esz: int = enum_mem_size(ty);
            if (esz == 1 || is_byte_ty(ty)) cg_movzb_mr(5, vo.offset, reg) else {
                if (esz == 4 || is_i32_ty(ty)) cg_movsxd_mr(5, vo.offset, reg) else {
                    if (is_u32_ty(ty) || is_f32_ty(ty)) cg_movl_mr(5, vo.offset, reg) else cg_mov_mr(5,
                        vo.offset, reg)
                }
            }
            true
        }
        Index _ -> {
            ty: ?*Type = n.ty;
            if (ty == null || passes_by_ref(ty)) return false;
            if (!gen_simple_addr(n, reg)) return false;
            load_mem_at(ty, reg, 0, reg);
            true
        }
        MemberAccess k -> {
            ty: ?*Type = n.ty;
            if (ty == null || passes_by_ref(ty)) return false;
            base: int = cg_value_register(k.lhs);
            if (base == 0) {
                if (!gen_simple_member_base(k.lhs, reg)) return false;
                base = reg
            }
            member: *Member = k.member or error("internal");
            load_mem_at(ty, base, member.offset, reg);
            true
        }
        _ -> false
    }
}

// Restrict address formation to a local or one of its fields. Neither form
// calls code, changes memory, or uses another ABI argument register as scratch.
cg_local_call_address(n: *Expr): bool {
    match n.kind {
        Var k -> k.var != null && k.var.is_local && !k.var.is_const;
        MemberAccess k -> {
            match k.lhs.kind {
                Var v -> v.var != null && v.var.is_local && !v.var.is_const;
                _ -> false
            }
        }
        _ -> false
    }
}

// These arguments read only constants, local values, or local addresses.
// Loading ABI registers cannot change later arguments or clobber earlier ones:
// allocated locals live in callee-saved registers, and the rest use rbp slots.
cg_direct_call_args(args: ?*Expr): bool {
    a: ?*Expr = args;
    while (a != null) {
        ty: ?*Type = a.ty;
        if (ty == null || is_float_ty(ty)) return false;
        if (!imm_operand(a)) {
            match a.kind {
                Var k -> {
                    vo: ?*Obj = k.var;
                    if (vo == null || !vo.is_local && !vo.is_const) return false;
                    if (passes_by_ref(ty) && (!vo.is_local || vo.is_const)) return false
                }
                MemberAccess _ -> {
                    if (!cg_local_call_address(a)) return false
                }
                Addr k -> {
                    if (!cg_local_call_address(k.lhs)) return false
                }
                _ -> return false
            }
        }
        a = a.next
    }
    true
}

cg_load_call_arg(a: *Expr, reg: int) noregion raises Error, IndexOutOfBounds {
    ty: *Type = a.ty or error("missing call argument type");
    if (passes_by_ref(ty)) {
        if (!gen_simple_addr(a, reg)) error("internal: simple aggregate argument");
        return
    }
    match a.kind {
        Addr k -> {
            if (!gen_simple_addr(k.lhs, reg)) error("internal: simple address argument");
            return
        }
        _ -> { }
    }
    if (!gen_simple_operand(a, reg)) error("internal: simple call argument")
}

gen_binop_setup(lhs: *Expr, rhs: *Expr) noregion raises Error, IndexOutOfBounds {
    gen_expr(lhs);
    if (gen_simple_operand(rhs, 7)) return;
    cg_push(0);
    gen_expr(rhs);
    cg_mov_rr(0, 7);
    cg_pop(0)
}

bits_to_xmm(xmm: int, wide: bool) noregion raises Error {
    if (wide) cg_movq_r_xmm(0, xmm) else cg_movd_r_xmm(0, xmm)
}

xmm_to_bits(xmm: int, wide: bool) noregion raises Error {
    if (wide) cg_movq_xmm_r(xmm, 0) else cg_movd_xmm_r(xmm, 0)
}

gpr_to_xmm(gpr: int, xmm: int, wide: bool) noregion raises Error {
    if (wide) cg_movq_r_xmm(gpr, xmm) else cg_movd_r_xmm(gpr, xmm)
}

gen_float_binop(
    op: BinOp,
    lhs: *Expr,
    rhs: *Expr,
    wide: bool
) noregion raises Error, IndexOutOfBounds {
    gen_binop_setup(lhs, rhs);
    bits_to_xmm(0, wide);
    gpr_to_xmm(7, 1, wide);
    match op {
        Add -> {
            if (wide) cg_addsd(0, 1) else cg_addss(0, 1)
        }
        Sub -> {
            if (wide) cg_subsd(0, 1) else cg_subss(0, 1)
        }
        Mul -> {
            if (wide) cg_mulsd(0, 1) else cg_mulss(0, 1)
        }
        Div -> {
            if (wide) cg_divsd(0, 1) else cg_divss(0, 1)
        }
        _ -> error("invalid float operator")
    }
    xmm_to_bits(0, wide)
}

gen_float_cmp(
    lhs: *Expr,
    rhs: *Expr,
    setcc: []i8,
    wide: bool
) noregion raises Error, IndexOutOfBounds {
    gen_binop_setup(lhs, rhs);
    bits_to_xmm(0, wide);
    gpr_to_xmm(7, 1, wide);
    if (wide) cg_ucomisd(0, 1) else cg_ucomiss(0, 1);
    gen_cmp_set(setcc)
}

wrap_after(ty: ?*Type) noregion raises Error {
    if (ty != null) {
        if (is_i8_ty(ty)) cg_movzb_al_rax();
        if (is_i32_ty(ty)) cg_movsxd_eax();
        if (is_u32_ty(ty)) cg_movl_eax()
    }
}

emit_convert(from: ?*Type, to: ?*Type) noregion raises Error, IndexOutOfBounds {
    if (from == null || to == null) return;
    if (types_equal(from, to)) return;
    if (is_i32_ty(from) && is_int_ty(to)) {
        cg_movsxd_eax();
        return
    }
    if (is_u32_ty(from) && is_int_ty(to)) {
        cg_movl_eax();
        return
    }
    if (is_i8_ty(from) && is_int_ty(to)) {
        cg_movzb_al_rax();
        return
    }
    if (is_int_width_ty(from) && is_f32_ty(to)) {
        if (is_i32_ty(from)) cg_movsxd_eax();
        if (is_u32_ty(from) || is_i8_ty(from)) {
            if (is_i8_ty(from)) cg_movzb_al_rax() else cg_movl_eax()
        }
        cg_cvtsi2ss();
        xmm_to_bits(0, false);
        return
    }
    if (is_int_width_ty(from) && is_f64_ty(to)) {
        if (is_i32_ty(from)) cg_movsxd_eax();
        if (is_u32_ty(from) || is_i8_ty(from)) {
            if (is_i8_ty(from)) cg_movzb_al_rax() else cg_movl_eax()
        }
        cg_cvtsi2sd();
        xmm_to_bits(0, true);
        return
    }
    if (is_f32_ty(from) && is_int_ty(to)) {
        bits_to_xmm(0, false);
        cg_cvttss2si();
        return
    }
    if (is_f64_ty(from) && is_int_ty(to)) {
        bits_to_xmm(0, true);
        cg_cvttsd2si();
        return
    }
    if (is_f32_ty(from) && is_f64_ty(to)) {
        bits_to_xmm(0, false);
        cg_cvtss2sd();
        xmm_to_bits(0, true);
        return
    }
    if (is_f64_ty(from) && is_f32_ty(to)) {
        bits_to_xmm(0, true);
        cg_cvtsd2ss();
        xmm_to_bits(0, false);
        return
    }
}

emit_trunc_to(to: ?*Type) noregion raises Error {
    wrap_after(to)
}

is_sse_ty(t: ?*Type): bool {
    t != null && is_float_ty(t)
}

/* Immediate integer operand for codegen (numeric literal or null). */
imm_operand(n: *Expr): bool {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) false else true
        }
        Null -> true;
        _ -> false
    }
}

imm_value(n: *Expr): int {
    match n.kind {
        Num k -> k.val;
        Null -> 0;
        _ -> 0
    }
}

gen_cmp_set(setcc: []i8) noregion raises Error {
    cc: int = 4;
    if (streq(setcc, "setne")) cc = 5;
    if (streq(setcc, "setb")) cc = 2;
    if (streq(setcc, "setae")) cc = 3;
    if (streq(setcc, "setbe")) cc = 6;
    if (streq(setcc, "seta")) cc = 7;
    if (streq(setcc, "setl")) cc = 12;
    if (streq(setcc, "setge")) cc = 13;
    if (streq(setcc, "setle")) cc = 14;
    if (streq(setcc, "setg")) cc = 15;
    cg_setcc(cc);
    cg_movzb_al_rax()
}

gen_cmp_flags(lhs: *Expr, rhs: *Expr) noregion raises Error, IndexOutOfBounds {
    if (imm_operand(rhs) && fits_imm32(imm_value(rhs))) {
        reg: int = cg_value_register(lhs);
        if (reg == 0) gen_expr(lhs);
        cg_alu_imm(7, imm_value(rhs), reg);
        return
    }
    if (imm_operand(lhs) && fits_imm32(imm_value(lhs))) {
        gen_expr(rhs);
        cg_mov_rr(0, 7);
        cg_mov_imm(imm_value(lhs), 0);
        cg_alu_rr(57, 7, 0);
        return
    }
    left_reg: int = cg_value_register(lhs);
    if (left_reg != 0 && gen_simple_operand(rhs, 7)) {
        cg_alu_rr(57, 7, left_reg);
        return
    }
    right_reg: int = cg_value_register(rhs);
    if (right_reg != 0) {
        gen_expr(lhs);
        cg_alu_rr(57, right_reg, 0);
        return
    }
    gen_binop_setup(lhs, rhs);
    cg_alu_rr(57, 7, 0)
}

gen_cmp(lhs: *Expr, rhs: *Expr, setcc: []i8) noregion raises Error, IndexOutOfBounds {
    gen_cmp_flags(lhs, rhs);
    gen_cmp_set(setcc)
}

/* Branch-only conditions keep comparison flags live. Leave floating-point and
 * string comparisons on their existing value path; do not change their semantics. */
gen_cond(n: *Expr, target: int, when_true: bool) noregion raises Error, IndexOutOfBounds {
    match n.kind {
        Not k -> {
            gen_cond(k.lhs, target, !when_true);
            return
        }
        LogAnd k -> {
            if (!when_true) {
                gen_cond(k.lhs, target, false);
                gen_cond(k.rhs, target, false)
            } else {
                done: int = new_label();
                gen_cond(k.lhs, done, false);
                gen_cond(k.rhs, target, true);
                cg_label_id(done)
            }
            return
        }
        LogOr k -> {
            if (when_true) {
                gen_cond(k.lhs, target, true);
                gen_cond(k.rhs, target, true)
            } else {
                done: int = new_label();
                gen_cond(k.lhs, done, true);
                gen_cond(k.rhs, target, false);
                cg_label_id(done)
            }
            return
        }
        Binary k -> {
            ty: ?*Type = decay(k.lhs.ty);
            if (ty != null && !is_float_ty(ty) && !is_str(ty) && !is_opt_str(ty)) {
                cc: int = -1;
                unsigned: bool = is_u32_ty(ty);
                match k.op {
                    Eq -> cc = 4;
                    Ne -> cc = 5;
                    Lt -> cc = (if (unsigned) 2 else 12);
                    Le -> cc = (if (unsigned) 6 else 14);
                    Gt -> cc = (if (unsigned) 7 else 15);
                    Ge -> cc = (if (unsigned) 3 else 13);
                    _ -> { }
                }
                if (cc >= 0) {
                    gen_cmp_flags(k.lhs, k.rhs);
                    if (!when_true) cc = cc ^ 1;
                    cg_jump_id(cc, target);
                    return
                }
            }
        }
        _ -> { }
    }
    gen_expr(n);
    cg_alu_imm(7, 0, 0);
    cg_jump_id(if (when_true) 5 else 4, target)
}

gen_str_cmp(lhs: *Expr, rhs: *Expr, ne: bool) noregion raises Error, IndexOutOfBounds {
    gen_expr(rhs);
    cg_push(0);
    gen_expr(lhs);
    cg_mov_rr(0, 7);
    cg_pop(6);
    lt: ?*Type = decay(lhs.ty);
    if (lt != null && is_opt_str(lt)) cg_call("l8_opt_str_eq") else cg_call("l8_str_eq");
    if (ne) cg_alu_imm(6, 1, 0)
}

gen_binary(op: BinOp, lhs: *Expr, rhs: *Expr) noregion raises Error, IndexOutOfBounds {
    lty: ?*Type = decay(lhs.ty);
    if (lty != null && is_float_ty(lty)) {
        wide: bool = false;
        if (is_f64_ty(lty)) wide = true;
        match op {
            Add -> {
                gen_float_binop(op, lhs, rhs, wide);
                return
            }
            Sub -> {
                gen_float_binop(op, lhs, rhs, wide);
                return
            }
            Mul -> {
                gen_float_binop(op, lhs, rhs, wide);
                return
            }
            Div -> {
                gen_float_binop(op, lhs, rhs, wide);
                return
            }
            Eq -> {
                gen_float_cmp(lhs, rhs, "sete", wide);
                return
            }
            Ne -> {
                gen_float_cmp(lhs, rhs, "setne", wide);
                return
            }
            Lt -> {
                gen_float_cmp(lhs, rhs, "setb", wide);
                return
            }
            Le -> {
                gen_float_cmp(lhs, rhs, "setbe", wide);
                return
            }
            Gt -> {
                gen_float_cmp(lhs, rhs, "seta", wide);
                return
            }
            Ge -> {
                gen_float_cmp(lhs, rhs, "setae", wide);
                return
            }
            _ -> error("invalid float operator")
        }
    }
    match op {
        Add -> {
            if (imm_operand(rhs) && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v: int = imm_value(rhs);
                if (v != 0) cg_alu_imm(0, v, 0);
                return
            }
            if (imm_operand(lhs) && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                v2: int = imm_value(lhs);
                if (v2 != 0) cg_alu_imm(0, v2, 0);
                return
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(1, 7, 0);
            return
        }
        Sub -> {
            if (imm_operand(rhs) && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v3: int = imm_value(rhs);
                if (v3 != 0) cg_alu_imm(5, v3, 0);
                return
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(41, 7, 0);
            return
        }
        Mul -> {
            if (imm_operand(rhs) && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                mv: int = imm_value(rhs);
                if (mv == 0) {
                    cg_mov_imm(0, 0);
                    return
                }
                if (mv == 1) return;
                if (mv == 2) {
                    cg_alu_rr(1, 0, 0);
                    return
                }
                cg_imul_imm(mv, 0);
                return
            }
            if (imm_operand(lhs) && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                mv2: int = imm_value(lhs);
                if (mv2 == 0) {
                    cg_mov_imm(0, 0);
                    return
                }
                if (mv2 == 1) return;
                if (mv2 == 2) {
                    cg_alu_rr(1, 0, 0);
                    return
                }
                cg_imul_imm(mv2, 0);
                return
            }
            gen_binop_setup(lhs, rhs);
            cg_imul_rr(7, 0);
            return
        }
        Div -> {
            if (imm_operand(rhs)) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                return
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            return
        }
        Mod -> {
            if (imm_operand(rhs)) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                cg_mov_rr(2, 0);
                return
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            cg_mov_rr(2, 0);
            return
        }
        Eq -> {
            if (lty != null && (is_str(lty) || is_opt_str(lty))) {
                gen_str_cmp(lhs, rhs, false);
                return
            }
            gen_cmp(lhs, rhs, "sete");
            return
        }
        Ne -> {
            if (lty != null && (is_str(lty) || is_opt_str(lty))) {
                gen_str_cmp(lhs, rhs, true);
                return
            }
            gen_cmp(lhs, rhs, "setne");
            return
        }
        Lt -> {
            if (lty != null && is_u32_ty(lty)) gen_cmp(lhs, rhs, "setb") else gen_cmp(lhs,
                rhs, "setl");
            return
        }
        Le -> {
            if (lty != null && is_u32_ty(lty)) gen_cmp(lhs, rhs, "setbe") else gen_cmp(lhs,
                rhs, "setle");
            return
        }
        Gt -> {
            if (lty != null && is_u32_ty(lty)) gen_cmp(lhs, rhs, "seta") else gen_cmp(lhs,
                rhs, "setg");
            return
        }
        Ge -> {
            if (lty != null && is_u32_ty(lty)) gen_cmp(lhs, rhs, "setae") else gen_cmp(lhs,
                rhs, "setge");
            return
        }
        And -> {
            if (imm_operand(rhs) && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(4, imm_value(rhs), 0)
            } else if (imm_operand(lhs) && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(4, imm_value(lhs), 0)
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(33, 7, 0)
            }
            return
        }
        Or -> {
            if (imm_operand(rhs) && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(1, imm_value(rhs), 0)
            } else if (imm_operand(lhs) && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(1, imm_value(lhs), 0)
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(9, 7, 0)
            }
            return
        }
        Xor -> {
            if (imm_operand(rhs) && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(6, imm_value(rhs), 0)
            } else if (imm_operand(lhs) && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(6, imm_value(lhs), 0)
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(49, 7, 0)
            }
            return
        }
        Shl -> {
            if (imm_operand(rhs)) {
                gen_expr(lhs);
                cg_shift_imm(4, imm_value(rhs), 0)
            } else {
                gen_binop_setup(lhs, rhs);
                cg_mov_rr(7, 1);
                cg_shift_cl(4, 0)
            }
            return
        }
        Shr -> {
            sh: int = 7;
            if (lty != null && is_u32_ty(lty)) sh = 5;
            if (imm_operand(rhs)) {
                gen_expr(lhs);
                cg_shift_imm(sh, imm_value(rhs), 0)
            } else {
                gen_binop_setup(lhs, rhs);
                cg_mov_rr(7, 1);
                cg_shift_cl(sh, 0)
            }
            return
        }
    }
}

/* Dest address in %rax. Fill a [N]T or heap-slot run from a list of elements. */
gen_fill_array(elems: ?*Expr, base: *Type) noregion raises Error, IndexOutOfBounds {
    esz: int = type_size(base);
    if (esz <= 0) esz = 8;
    cg_alu_imm(5, 24, 4);
    cg_mov_rm(12, 4, 0);
    cg_mov_rm(13, 4, 8);
    cg_mov_rm(3, 4, 16);
    cg_mov_rr(4, 13);
    cg_mov_rr(0, 12);
    cg_mov_rr(12, 3);
    ae: ?*Expr = elems;
    while (ae != null) {
        gen_expr(ae);
        cg_mov_rr(3, 7);
        store_value(base);
        cg_alu_imm(0, esz, 3);
        ae = ae.next
    }
    cg_mov_rr(12, 0);
    cg_mov_mr(13, 16, 3);
    cg_mov_mr(13, 0, 12);
    cg_mov_mr(13, 8, 13)
}

/* Fold only nontrapping integer/Boolean arithmetic. In particular, runtime
 * shift masking differs from the global-constant evaluator, and signed division
 * may trap. Float comparisons must not compare their integer bit patterns. */
cg_foldable(n: *Expr): bool {
    ty: ?*Type = n.ty;
    if (ty == null || !is_int_width_ty(ty) && !is_bool_ty(ty)) return false;
    match n.kind {
        Num k -> k.str_label == 0;
        Var k -> {
            vo: ?*Obj = k.var;
            vo != null && vo.is_const
        }
        Neg k -> cg_foldable(k.lhs);
        BitNot k -> cg_foldable(k.lhs);
        Not k -> cg_foldable(k.lhs);
        Binary k -> {
            match k.op {
                Div -> return false;
                Mod -> return false;
                Shl -> return false;
                Shr -> return false;
                _ -> { }
            }
            cg_foldable(k.lhs) && cg_foldable(k.rhs)
        }
        _ -> false
    }
}

cg_emit_constant(n: *Expr) noregion raises Error, IndexOutOfBounds: bool {
    if (!cg_foldable(n)) return false;
    cg_mov_imm(const_value(n), 0);
    true
}

gen_expr(n: *Expr) noregion raises Error, IndexOutOfBounds {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) cg_lea_rip(cg_name_num(".L.str", k.str_label - 1),
                8, 0) else cg_mov_imm(k.val, 0);
            return
        }
        Null -> {
            cg_mov_imm(0, 0);
            return
        }
        Var p -> {
            v: ?*Obj = p.var;
            if (v != null && v.is_const) cg_mov_imm(v.const_val, 0) else gen_load(n);
            return
        }
        MemberAccess _p -> {
            gen_load(n);
            return
        }
        FuncAddr k -> {
            cg_lea_rip(k.name, 0, 0);
            return
        }
        Addr k -> {
            gen_addr(k.lhs);
            return
        }
        As k -> {
            gen_expr(k.lhs);
            emit_convert(k.lhs.ty, n.ty);
            return
        }
        Trunc k -> {
            gen_expr(k.lhs);
            emit_trunc_to(n.ty);
            return
        }
        New k -> {
            base: *Type = type_base(n.ty or error("missing type"));
            esz: int = type_size(base);
            if (esz <= 0) esz = 8;
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                fill: ?*Expr = k.fill;
                if (fill == null) error("new T[n] requires an initial value (new T[n](v))");
                gen_expr(lhs);
                cg_push(12);
                cg_mov_rr(0, 12);
                emit_check_new_count(12, esz);
                gen_expr(fill);
                cg_push(13);
                cg_mov_rr(0, 13);
                cg_mov_rr(12, 0);
                if (esz != 1) cg_imul_imm(esz, 0);
                cg_alu_imm(0, 8, 0);
                cg_mov_rr(0, 7);
                emit_malloc();
                cg_mov_rm(12, 0, 0);
                cg_alu_imm(0, 8, 0);
                cg_push(3);
                cg_mov_rr(0, 3);
                agg: bool = false;
                if (is_struct_ty(base) || is_enum_ty(base) || is_exn_ty(base)) agg = true;
                if (esz == 1) {
                    cg_mov_rr(0, 7);
                    cg_mov_rr(12, 1);
                    cg_mov_rr(13, 0);
                    cg_cld();
                    cg_rep_stosb()
                } else if (esz == 4 && !agg) {
                    cg_mov_rr(0, 7);
                    cg_mov_rr(12, 1);
                    cg_mov_rr(13, 0);
                    cg_cld();
                    cg_rep_stosl()
                } else {
                    if (esz == 8) {
                        cg_mov_rr(0, 7);
                        cg_mov_rr(12, 1);
                        if (agg && passes_by_ref(base)) cg_mov_mr(13, 0, 0) else cg_mov_rr(13,
                            0);
                        cg_cld();
                        cg_rep_stosq()
                    } else {
                        cg_mov_rr(0, 9);
                        cg_mov_rr(12, 1);
                        cg_mov_rr(13, 8);
                        loop: int = new_label();
                        done: int = new_label();
                        cg_label_id(loop);
                        cg_alu_imm(7, 0, 1);
                        cg_jump_id(4, done);
                        cg_mov_rr(9, 7);
                        store_array_fill(fill, base);
