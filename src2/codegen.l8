                    error("new T[n] requires an initial value (new T[n](v))");
                }
                gen_expr(lhs);
                cg_push(12);
                cg_mov_rr(0, 12);
                emit_check_new_count(12, esz);
                gen_expr(fill);
                cg_push(13);
                cg_mov_rr(0, 13);
                cg_mov_rr(12, 0);
                if (esz != 1) {
                    cg_imul_imm(esz, 0);
                }
                cg_alu_imm(0, 8, 0);
                cg_mov_rr(0, 7);
                emit_malloc();
                cg_mov_rm(12, 0, 0);
                cg_alu_imm(0, 8, 0);
                cg_push(3);
                cg_mov_rr(0, 3);
                agg: int = 0;
                if (is_struct_ty(base) || is_enum_ty(base) || is_exn_ty(base)) {
                    agg = 1;
                }
                if (esz == 1) {
                    cg_mov_rr(0, 7);
                    cg_mov_rr(12, 1);
                    cg_mov_rr(13, 0);
                    cg_cld();
                    cg_rep_stosb();
                } else {
                    if (esz == 8) {
                        cg_mov_rr(0, 7);
                        cg_mov_rr(12, 1);
                        if (agg != 0 && passes_by_ref(base)) {
                            cg_mov_mr(13, 0, 0);
                        } else {
                            cg_mov_rr(13, 0);
                        }
                        cg_cld();
                        cg_rep_stosq();
                    } else {
                        cg_mov_rr(0, 9);
                        cg_mov_rr(12, 1);
                        cg_mov_rr(13, 8);
                        loop: int = new_label();
                        done: int = new_label();
                        cg_label_id(loop);
                        cg_alu_imm(7, 0, 1);
                        cg_jump_id(4, done);
                        cg_mov_rr(9, 7);
                        store_array_fill(fill, base);
                        cg_alu_imm(0, esz, 9);
                        cg_alu_imm(5, 1, 1);
                        cg_jump_id(0 - 1, loop);
                        cg_label_id(done);
