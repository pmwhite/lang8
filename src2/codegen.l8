gen_match_tag_compare(tag: int) noregion raises Error, IndexOutOfBounds {
    if (fits_imm32(tag)) cg_alu_imm(7, tag, 0) else {
        cg_mov_imm(tag, 7);
        cg_alu_rr(57, 7, 0)
    }
}

// Dispatch before emitting bodies, keeping the enum tag in rax. Split larger
// matches by tag range; small leaves use direct comparisons. No jump table or
// new assembler instruction is needed. Stop at the first wildcard arm.
gen_enum_dispatch(
    arms: ?*MatchArm,
    low: int,
    high: int,
    fallback: int
) noregion raises Error, IndexOutOfBounds {
    count: int = 0;
    first: int = high;
    last: int = low;
    arm: ?*MatchArm = arms;
    while (arm != null && arm.variant != null) {
        variant: ?*Variant = arm.variant;
        if (variant == null) error("missing variant");
        tag: int = variant.tag;
        if (low <= tag && tag <= high) {
            count = count + 1;
            if (tag < first) first = tag;
            if (tag > last) last = tag
        }
        arm = arm.next
    }
    if (count <= 3 || first < 0 || last > 2147483647 || first == last) {
        arm = arms;
        while (arm != null && arm.variant != null) {
            variant: ?*Variant = arm.variant;
            if (variant == null) error("missing variant");
            if (low <= variant.tag && variant.tag <= high) {
                gen_match_tag_compare(variant.tag);
                cg_jump_id(4, arm.codegen_label)
            }
            arm = arm.next
        }
        cg_jump_id(-1, fallback);
        return
    }
    middle: int = first + (last - first) / 2;
    left: int = new_label();
    cg_alu_imm(7, middle, 0);
    cg_jump_id(14, left);
    gen_enum_dispatch(arms, middle + 1, last, fallback);
    cg_label_id(left);
    gen_enum_dispatch(arms, first, middle, fallback)
}

gen_match(cond: *Expr, arms: ?*MatchArm) noregion raises Error, IndexOutOfBounds {
    lend: int = new_label();
    cty: ?*Type = cond.ty;
    if (cty != null && is_enum_ty(cty)) {
        match cond.kind {
            Var _p -> gen_addr(cond);
            MemberAccess _p -> gen_addr(cond);
            Deref _p -> gen_addr(cond);
            _ -> gen_expr(cond)
        }
    } else gen_expr(cond);
    cg_push(0);
    if (cty != null && is_enum_ty(cty)) load_mem(enum_tag_type(cty));
    cg_push(0);
    enum_dispatch: bool = cty != null && is_enum_ty(cty);
    missing: int = new_label();
    if (enum_dispatch) {
        fallback: int = missing;
        low: int = 0;
        high: int = 0;
        scan: ?*MatchArm = arms;
        while (scan != null) {
            scan.codegen_label = new_label();
            variant: ?*Variant = scan.variant;
            if (variant != null) {
                if (variant.tag > high) high = variant.tag;
                if (variant.tag < low) low = variant.tag
            } else if (fallback == missing) fallback = scan.codegen_label;
            scan = scan.next
        }
        gen_enum_dispatch(arms, low, high, fallback)
    }
    arm: ?*MatchArm = arms;
    while (arm != null) {
        la: int = new_label();
        av: ?*Variant = arm.variant;
        if (enum_dispatch) cg_label_id(arm.codegen_label) else if (av != null) {
            cg_mov_mr(4, 0, 0);
            gen_match_tag_compare(av.tag);
            cg_jump_id(5, la)
        } else if (arm.is_literal) {
            cg_mov_mr(4, 0, 0);
            cg_mov_imm(arm.literal, 7);
            cg_alu_rr(57, 7, 0);
            cg_jump_id(5, la)
        }
        bv: ?*Obj = arm.binder;
        fn: ?*Function = current_fn;
        if (bv != null && (bv.used || fn == null || !fn.used)) {
            if (av == null) error("missing variant");
            psz: int = av.payload_size;
            poff: int = av.payload_offset;
            cg_mov_mr(4, 8, 6);
            if (poff != 0) cg_alu_imm(0, poff, 6);
            cg_lea_mr(5, bv.offset, 7);
            emit_memcpy(psz)
        }
        gen_stmt(arm.body);
        cg_jump_id(0 - 1, lend);
        if (!enum_dispatch && (av != null || arm.is_literal)) cg_label_id(la);
        arm = arm.next
    }
    cg_label_id(missing);
    cg_mov_imm(1, 7);
    cg_call("exit");
    cg_label_id(lend);
    cg_alu_imm(0, 16, 4)
}

// For-loop bounds and counters are integer locals with no evaluation effects.
emit_loop_compare(item: *Obj, bound: *Obj) noregion raises Error, IndexOutOfBounds {
    left: int = item.cg_register as int;
    if (left <= 1) {
        left = 1;
        cg_mov_mr(5, item.offset, left)
    }
    right: int = bound.cg_register as int;
    if (right <= 1) {
        right = 0;
        cg_mov_mr(5, bound.offset, right)
    }
    cg_alu_rr(57, right, left)
}

emit_loop_increment(item: *Obj) noregion raises Error, IndexOutOfBounds {
    if (item.cg_register as int > 1) cg_alu_imm(0, 1, item.cg_register as int) else {
        emit_load_var(item, ty_int);
        cg_alu_imm(0, 1, 0);
        emit_store_var(item, ty_int)
    }
}

gen_stmt(n: *Stmt) noregion raises Error, IndexOutOfBounds {
    match n.kind {
        Return k -> {
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                gen_expr(lhs);
                sret: ?*Obj = current_sret;
                if (sret != null) {
                    cg_mov_rr(0, 6);
                    cg_mov_mr(5, sret.offset, 7);
                    emit_memcpy(type_size(current_return_ty or error("missing return type")));
                    cg_mov_rr(7, 0)
                }
            } else cg_mov_imm(0, 0);
            rd: int = cg_region_depth;
            while (rd > 0) {
                cg_call("l8_region_pop");
                rd = rd - 1
            }
            cg_jump_id(0 - 1, current_return_lab);
            return
        }
        ExprStmt k -> {
            gen_expr(k.lhs);
            return
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                gen_stmt(s);
                s = s.next
            }
            return
        }
        If k -> {
            le: int = new_label();
            els: ?*Stmt = k.els;
            if (els == null) {
                gen_cond(k.cond, le, false);
                gen_stmt(k.then);
                cg_label_id(le);
                return
            }
            lelse: int = new_label();
            gen_cond(k.cond, lelse, false);
            gen_stmt(k.then);
            cg_jump_id(0 - 1, le);
            cg_label_id(lelse);
            gen_stmt(els);
            cg_label_id(le);
            return
        }
        While k -> {
            lb: int = new_label();
            le2: int = new_label();
            cg_label_id(lb);
            gen_cond(k.cond, le2, false);
            gen_stmt(k.body);
            cg_jump_id(0 - 1, lb);
            cg_label_id(le2);
            return
        }
        For k -> {
            lb3: int = new_label();
            le3: int = new_label();
            hu3: ?*Expr = k.hi;
            if (hu3 != null) {
                gen_expr(k.iter);
                emit_store_var(k.item, ty_int);
                gen_expr(hu3);
                emit_store_var(k.n, ty_int);
                cg_label_id(lb3);
                emit_loop_compare(k.item, k.n);
                cg_jump_id(13, le3);
                gen_stmt(k.body);
                emit_loop_increment(k.item);
                cg_jump_id(0 - 1, lb3);
                cg_label_id(le3);
                return
            }
            co2: ?*Obj = k.coll;
            ix2: ?*Obj = k.idx;
            if (co2 == null || ix2 == null) error("internal: for array missing temps");
            cu2: *Obj = co2;
            iu2: *Obj = ix2;
            sty: *Type = cu2.ty or error("missing type");
            ity: *Type = k.item.ty or error("missing type");
            esz: int = type_size(ity);
            if (is_array(sty)) {
                gen_expr(k.iter);
                cg_lea_mr(5, cu2.offset, 7);
                cg_mov_rr(0, 6);
                emit_memcpy(type_size(sty));
                emit_store_imm(iu2, ty_int, 0);
                emit_store_imm(k.n, ty_int, array_len(sty));
                cg_label_id(lb3);
                emit_loop_compare(iu2, k.n);
                cg_jump_id(3, le3);
                cg_lea_mr(5, cu2.offset, 6);
                emit_load_var(iu2, ty_int);
                cg_mov_rr(0, 1);
                emit_scale_offset(esz);
                if (passes_by_ref(ity)) {
                    cg_mov_rr(0, 6);
                    cg_lea_mr(5, k.item.offset, 7);
                    emit_memcpy(esz)
                } else {
                    load_mem(ity);
                    emit_store_var(k.item, ity)
                }
                gen_stmt(k.body);
                emit_loop_increment(iu2);
                cg_jump_id(0 - 1, lb3);
                cg_label_id(le3);
                return
            }
            gen_expr(k.iter);
            emit_store_var(cu2, sty);
            emit_store_imm(iu2, ty_int, 0);
            emit_load_var(cu2, sty);
            cg_mov_mr(0, 0 - 8, 0);
            emit_store_var(k.n, ty_int);
            cg_label_id(lb3);
            emit_loop_compare(iu2, k.n);
            cg_jump_id(3, le3);
            emit_load_var(cu2, sty);
            cg_mov_rr(0, 6);
            emit_load_var(iu2, ty_int);
            cg_mov_rr(0, 1);
            emit_scale_offset(esz);
            if (passes_by_ref(ity)) {
                cg_mov_rr(0, 6);
                cg_lea_mr(5, k.item.offset, 7);
                emit_memcpy(esz)
            } else {
                load_mem(ity);
                emit_store_var(k.item, ity)
            }
            gen_stmt(k.body);
            emit_loop_increment(iu2);
            cg_jump_id(0 - 1, lb3);
            cg_label_id(le3);
            return
        }
        Match k -> {
            gen_match(k.cond, k.arms);
            return
        }
        Raise k -> {
            ex: *ExnDef = k.exn or error("internal");
            if (ex.members != null) {
                esz: int = ex.size;
                if (esz <= 0) esz = 8;
                cg_mov_imm(esz, 7);
                emit_exc_malloc();
                cg_push(3);
                cg_mov_rr(0, 3);
                gen_struct_inits(k.inits);
                cg_mov_rr(3, 6);
                cg_pop(3)
            } else cg_mov_imm(0, 6);
            cg_mov_imm(ex.tag, 7);
            cg_call("l8_raise");
            return
        }
        Try k -> {
            lcatch: int = new_label();
            ltryend: int = new_label();
            cg_lea_mr(5, k.buf.offset, 7);
            cg_call("l8_try_begin");
            cg_alu_imm(7, 0, 0);
            cg_jump_id(5, lcatch);
            gen_stmt(k.body);
            cg_call("l8_try_end");
            cg_jump_id(0 - 1, ltryend);
            cg_label_id(lcatch);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                la2: int = new_label();
                ced: *ExnDef = arm2.exn or error("internal");
                cg_mov_rip_r("l8_exc_tag", 0, 0);
                cg_alu_imm(7, ced.tag, 0);
                cg_jump_id(5, la2);
                binder: ?*Obj = arm2.binder;
                if (binder != null) {
                    psz2: int = ced.size;
                    if (psz2 > 0) {
                        cg_mov_rip_r("l8_exc_ptr", 0, 6);
                        cg_lea_mr(5, binder.offset, 7);
                        emit_memcpy(psz2)
                    }
                }
                gen_stmt(arm2.body);
                cg_jump_id(0 - 1, ltryend);
                cg_label_id(la2);
                arm2 = arm2.next
            }
            cg_mov_rip_r("l8_exc_tag", 0, 7);
            cg_mov_rip_r("l8_exc_ptr", 0, 6);
            cg_call("l8_raise");
            cg_label_id(ltryend);
            return
        }
        Region k -> {
            cg_call("l8_heap_mark");
            emit_store_var(k.mark, ty_int);
            emit_load_var(k.mark, ty_int);
            cg_mov_rr(0, cg_arg_reg(0));
            cg_call("l8_region_push");
            cg_region_depth = cg_region_depth + 1;
            gen_stmt(k.body);
            cg_region_depth = cg_region_depth - 1;
            cg_call("l8_region_pop");
            return
        }
        Comment _c -> {
            if (compile_expect_mode) {
                // The low byte marks a checkpoint; the next seven bytes encode
                // its source offset so skipped or reordered comments are caught.
                cg_alu_imm(5, 16, 4);
                cg_mov_rm(0, 4, 8);
                cg_mov_imm(n.pos * 256 + 30, 0);
                cg_mov_rm(0, 4, 0);
                cg_mov_imm(1, 7);
                cg_mov_rr(4, 6);
                cg_mov_imm(8, 2);
                cg_call("l8_os_write");
                cg_mov_mr(4, 8, 0);
                cg_alu_imm(0, 16, 4)
            }
            return
        }
        Decl k -> {
            vo: ?*Obj = k.var;
            init: ?*Expr = k.init;
            if (init != null && vo != null) {
                ae: *Expr = new_assign(new_var_node(vo), init);
                gen_expr(ae)
            }
            return
        }
        _ -> error("invalid statement")
    }
}

emit_ret_to_rax(ty: ?*Type) noregion raises Error {
    if (ty != null && is_f32_ty(ty)) xmm_to_bits(0, false);
    if (ty != null && is_f64_ty(ty)) xmm_to_bits(0, true)
}

emit_rax_to_ret(ty: ?*Type) noregion raises Error {
    if (ty != null && is_f32_ty(ty)) bits_to_xmm(0, false);
    if (ty != null && is_f64_ty(ty)) bits_to_xmm(0, true)
}

emit_reverse_stack(n: int) noregion raises Error, IndexOutOfBounds {
    if (n <= 1) return;
    l: int = 0;
    r: int = n - 1;
    while (l < r) {
        cg_mov_mr(4, 8 * l, 10);
        cg_mov_mr(4, 8 * r, 0);
        cg_mov_rm(0, 4, 8 * l);
        cg_mov_rm(10, 4, 8 * r);
        l = l + 1;
        r = r - 1
    }
}

emit_place_call_regs(nslots: int) noregion raises Error, IndexOutOfBounds {
    if (nslots <= 6) {
        i: int = nslots - 1;
        while (i >= 0) {
            cg_pop(cg_arg_reg(i));
            i = i - 1
        }
        return
    }
    emit_reverse_stack(nslots);
    for i2 in 0..6 cg_pop(cg_arg_reg(i2))
}

emit_store_incoming(slot: int, dest_off: int) noregion raises Error, IndexOutOfBounds {
    if (slot < 6) {
        cg_mov_rm(cg_arg_reg(slot), 5, dest_off);
        return
    }
    cg_mov_mr(5, 16 + 8 * (slot - 6), 0);
    cg_mov_rm(0, 5, dest_off)
}

assign_lvar_offsets(fn: *Function) raises Error {
    off: int = 0;
    v: ?*Obj = fn.locals;
    while (v != null) {
        vty: *Type = v.ty or error("missing local type");
        sz: int = type_size(vty);
        if (sz <= 0) sz = 8;
        if (sz < 8) sz = 8;
        off = off + sz;
        v.offset = 0 - off;
        v = v.next
    }
    fn.stack_size = (off + 7) / 16 * 16 + 8
}

emit_global_init(g: *Obj) noregion raises Error, IndexOutOfBounds {
    init: *Expr = g.init or error("missing global initializer");
    gty: *Type = g.ty or error("missing global type");
    sz: int = type_size(gty);
    if (sz <= 0) sz = 8;
    v: int = const_value(init);
    cg_label(g.name);
    if (sz > 8) error("global initializer must be a scalar constant");
    cg_quad(v)
}

emit_bss_global(g: *Obj) noregion raises Error, IndexOutOfBounds {
    sz: int = 8;
    gty: ?*Type = g.ty;
    if (gty != null) sz = type_size(gty);
    if (sz <= 0) sz = 8;
    if (gty != null && sz < 8) sz = 8;
    cg_label(g.name);
    cg_skip(sz)
}

emit_data() noregion raises Error, IndexOutOfBounds {
    g: ?*Obj = globals;
    any_data: bool = false;
    while (g != null) {
        if (!g.is_func && !g.is_const && is_const_init(g.init)) {
            if (!any_data) {
                cg_section(as_SEC_DATA);
                cg_align(8);
                any_data = true
            }
            emit_global_init(g)
        }
        g = g.next
    }
    g = globals;
    any_bss: bool = false;
    while (g != null) {
        if (!g.is_func && !g.is_const && !is_const_init(g.init)) {
            if (!any_bss) {
                cg_section(as_SEC_BSS);
                cg_align(8);
                any_bss = true
            }
            emit_bss_global(g)
        }
        g = g.next
    }
    if (!any_bss) {
        cg_section(as_SEC_BSS);
        cg_align(8)
    }
    cg_global("l8_init_done");
    cg_label("l8_init_done");
    cg_skip(8);
    cg_section(as_SEC_DATA);
    cg_align(8);
    s: ?*StrLit = str_lits;
    while (s != null) {
        cg_label(cg_name_num(".L.str", s.label));
        cg_quad(s.count);
        cg_bytes(s.data, 0, s.count);
        cg_bytes(s.data, s.count, 1);
        s = s.next
    }
}

emit_dyn_global_inits(g: ?*Obj) noregion raises Error, IndexOutOfBounds {
    if (g == null) return;
    emit_dyn_global_inits(g.next);
    if (g.is_func || g.is_const) return;
    init: ?*Expr = g.init;
    if (is_const_init(init)) return;
    e: *Expr = init or error("missing global initializer");
    ty: *Type = g.ty or error("missing global type");
    gen_expr(e);
    if (passes_by_ref(ty)) {
        cg_lea_rip(g.name, 0, 7);
        cg_mov_rr(0, 6);
        emit_memcpy(type_size(ty))
    } else emit_store_var(g, ty)
}

emit_l8_init_globals_fn() noregion raises Error, IndexOutOfBounds {
    already: int = new_label();
    cg_global("l8_init_globals");
    cg_label("l8_init_globals");
    cg_rsp_off = 0;
    cg_push(5);
    cg_mov_rr(4, 5);
    cg_mov_rip_r("l8_init_done", 0, 0);
    cg_alu_imm(7, 0, 0);
    cg_jump_id(5, already);
    cg_mov_imm(1, 0);
    cg_mov_r_rip(0, "l8_init_done", 0);
    emit_dyn_global_inits(globals);
    cg_label_id(already);
    cg_mov_rr(5, 4);
    cg_pop(5);
    cg_ret()
}

/* A conservative whitelist of paths that never modify rbx/r12/r13.
 * Unknown and aggregate/exception construction paths keep all saves;
 * in particular, returns inside initializers must unwind to saved registers.
 * Calls are safe because both generated and external callees obey SysV. */
cg_local_address_base(n: *Expr): bool {
    match n.kind {
        Var k -> k.var != null && k.var.is_local;
        MemberAccess k -> cg_local_address_base(k.lhs);
        _ -> false
    }
}

cg_scalar_expr(n: ?*Expr): bool {
    if (n == null) return true;
    match n.kind {
        Num _ -> true;
        Null -> true;
        Var _ -> true;
        FuncAddr _ -> true;
        Sizeof _ -> true;
        Index k -> index_simple(k.idx) && cg_local_address_base(k.lhs);
        Binary k -> cg_scalar_expr(k.lhs) && cg_scalar_expr(k.rhs);
        Assign k -> cg_scalar_expr(k.lhs) && cg_scalar_expr(k.rhs);
        Addr k -> cg_scalar_expr(k.lhs);
        Deref k -> cg_scalar_expr(k.lhs);
        MemberAccess k -> cg_scalar_expr(k.lhs);
        Not k -> cg_scalar_expr(k.lhs);
        Neg k -> cg_scalar_expr(k.lhs);
        BitNot k -> cg_scalar_expr(k.lhs);
        As k -> cg_scalar_expr(k.lhs);
        Trunc k -> cg_scalar_expr(k.lhs);
        LogAnd k -> cg_scalar_expr(k.lhs) && cg_scalar_expr(k.rhs);
        LogOr k -> cg_scalar_expr(k.lhs) && cg_scalar_expr(k.rhs);
        OrElse k -> cg_scalar_expr(k.lhs) && cg_scalar_expr(k.rhs);
        If k -> cg_scalar_expr(k.cond) && cg_scalar_expr(k.then) && cg_scalar_expr(k.els);
        Block k -> cg_scalar_stmts(k.body);
        Funcall k -> {
            if (k.target != null) return false;
            a: ?*Expr = k.args;
            while (a != null) {
                if (!cg_scalar_expr(a)) return false;
                a = a.next
            }
            true
        }
        _ -> false
    }
}

cg_scalar_stmt(n: *Stmt): bool {
    match n.kind {
        Return k -> cg_scalar_expr(k.lhs);
        ExprStmt k -> cg_scalar_expr(k.lhs);
        Decl k -> cg_scalar_expr(k.init);
        Block k -> cg_scalar_stmts(k.body);
        If k -> cg_scalar_expr(k.cond) && cg_scalar_stmt(k.then) && cg_scalar_stmts(k.els);
        While k -> cg_scalar_expr(k.cond) && cg_scalar_stmt(k.body);
        For k -> cg_scalar_expr(k.iter) && cg_scalar_expr(k.hi) && cg_scalar_stmt(k.body);
        Comment _ -> true;
        _ -> false
    }
}

cg_scalar_stmts(n: ?*Stmt): bool {
    s: ?*Stmt = n;
    while (s != null) {
        if (!cg_scalar_stmt(s)) return false;
        s = s.next
    }
    true
}

emit_text() noregion raises Error, IndexOutOfBounds {
    fn: ?*Function = functions;
    cg_section(as_SEC_TEXT);
    oob_lab = new_label();
    emit_l8_init_globals_fn();
    while (fn != null) {
        if (!fn.is_extern) {
            narrow_top = null;
            catch_top = null;
            assign_lvar_offsets(fn);
            save_regs: bool = !cg_scalar_stmts(fn.body);
            // The same whitelist that permits omitting scratch-register saves
            // also lets allocation use r12/r13 throughout the function.
            allocated: int = cg_assign_registers(fn, if (save_regs) 2 else 4);
            current_fn_name = fn.name;
            current_return_ty = fn.return_ty;
            current_sret = fn.sret;
            current_fn = fn;
            current_return_lab = new_label();
            cg_region_depth = 0;
            cg_global(fn.name);
            cg_label(fn.name);
            cg_rsp_off = 0;
            cg_push(5);
            cg_mov_rr(4, 5);
            register_space: int = (allocated + 1) / 2 * 16;
            register_base: int = fn.stack_size + (if (save_regs) 24 else 8);
            // Keep the local offsets and 16-byte call alignment in either case.
            if (save_regs) {
                cg_alu_imm(5, fn.stack_size + 24 + register_space, 4);
                cg_mov_rm(3, 5, 0 - fn.stack_size - 8);
                cg_mov_rm(12, 5, 0 - fn.stack_size - 16);
                cg_mov_rm(13, 5, 0 - fn.stack_size - 24)
            } else cg_alu_imm(5, fn.stack_size + 8 + register_space, 4);
            if (allocated > 0) {
                cg_mov_rm(14, 5, 0 - register_base - 8);
                cg_mov_rm(15, 5, 0 - register_base - 16);
                if (allocated > 2) cg_mov_rm(12, 5, 0 - register_base - 24);
                if (allocated > 3) cg_mov_rm(13, 5, 0 - register_base - 32)
            }
            ri: int = 0;
            rs: int = 0;
            nst: int = 0;
            sret: ?*Obj = fn.sret;
            if (sret != null) {
                emit_store_incoming(ri, sret.offset);
                ri = ri + 1
            }
            /* Preserve incoming args before copying aggregates. Allocated scalars
             * go straight to callee-saved registers; copies do not clobber them. */
            i: int = 0;
            while (i < fn.nparams) {
                po: ?*Obj = fn_param(fn, i);
                if (po == null) error("null obj");
                p: *Obj = po;
                pty0: ?*Type = p.ty;
                if (pty0 != null && is_float_ty(pty0)) {
                    fw: bool = false;
                    if (is_f64_ty(pty0)) fw = true;
                    if (rs < 8) {
                        xmm_to_bits(rs, fw);
                        if (is_f32_ty(pty0)) cg_movl_rm(0, 5, p.offset) else cg_mov_rm(0,
                            5, p.offset);
                        rs = rs + 1
                    } else {
                        cg_mov_mr(5, 16 + 8 * nst, 0);
                        if (is_f32_ty(pty0)) cg_movl_rm(0, 5, p.offset) else cg_mov_rm(0,
                            5, p.offset);
                        nst = nst + 1
                    }
                } else {
                    preg: int = p.cg_register as int;
                    if (ri < 6) {
                        if (preg > 1) cg_mov_rr(cg_arg_reg(ri), preg) else emit_store_incoming(ri,
                            p.offset);
                        ri = ri + 1
                    } else {
                        if (preg > 1) cg_mov_mr(5, 16 + 8 * nst, preg) else {
                            cg_mov_mr(5, 16 + 8 * nst, 0);
                            cg_mov_rm(0, 5, p.offset)
                        }
                        nst = nst + 1
                    }
                }
                i = i + 1
            }
            i = 0;
            while (i < fn.nparams) {
                po2: ?*Obj = fn_param(fn, i);
                if (po2 == null) error("null obj");
                p2: *Obj = po2;
                pty: ?*Type = p2.ty;
                if (pty == null) error("missing param type");
                if (passes_by_ref(pty)) {
                    cg_mov_mr(5, p2.offset, 6);
                    cg_lea_mr(5, p2.offset, 7);
                    emit_memcpy(type_size(pty))
                }
                i = i + 1
            }
            if (streq(fn.name, "main")) cg_call("l8_init_globals");
            body: ?*Stmt = fn.body;
            if (body == null) error("missing body");
            gen_stmt(body);
            sret2: ?*Obj = current_sret;
            if (sret2 != null) {
                cg_mov_rr(0, 6);
                cg_mov_mr(5, sret2.offset, 7);
                emit_memcpy(type_size(current_return_ty or error("missing return type")));
                cg_mov_rr(7, 0)
            }
            cg_label_id(current_return_lab);
            emit_rax_to_ret(current_return_ty);
            if (allocated > 0) {
                cg_mov_mr(5, 0 - register_base - 8, 14);
                cg_mov_mr(5, 0 - register_base - 16, 15);
                if (allocated > 2) cg_mov_mr(5, 0 - register_base - 24, 12);
                if (allocated > 3) cg_mov_mr(5, 0 - register_base - 32, 13)
            }
            if (save_regs) {
                cg_mov_mr(5, 0 - fn.stack_size - 8, 3);
                cg_mov_mr(5, 0 - fn.stack_size - 16, 12);
                cg_mov_mr(5, 0 - fn.stack_size - 24, 13)
            }
            cg_mov_rr(5, 4);
            cg_pop(5);
            cg_ret()
        }
        fn = fn.next
    }
    cg_label_id(oob_lab);
    emit_exit1()
}

codegen() noregion raises Error, IndexOutOfBounds {
    emit_data();
    emit_text();
    if (!cg_direct_mode) emit_flush()
}
