// Emit x86-64 from the typed AST.
new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    l;
}

enum_mem_size(ty: *Type): int {
    if (!is_enum_ty(ty) || passes_by_ref(ty)) {
        0;
    } else {
        type_size(ty);
    }
}

load_mem(ty: *Type) noregion {
    esz: int = enum_mem_size(ty);
    if (esz == 1 || is_byte_ty(ty)) {
        cg_movzb_mr(0, 0, 0);
    } else {
        if (esz == 4 || is_i32_ty(ty)) {
            cg_movsxd_mr(0, 0, 0);
        } else {
            if (is_u32_ty(ty) || is_f32_ty(ty)) {
                cg_movl_mr(0, 0, 0);
            } else {
                cg_mov_mr(0, 0, 0);
            }
        }
    }
}

store_mem(ty: *Type) noregion {
    esz: int = enum_mem_size(ty);
    if (esz == 1 || is_byte_ty(ty)) {
        cg_movb_rm(0, 7, 0);
    } else {
        if (esz == 4 || is_i32_ty(ty) || is_u32_ty(ty) || is_f32_ty(ty)) {
            cg_movl_rm(0, 7, 0);
        } else {
            cg_mov_rm(0, 7, 0);
        }
    }
}

/* Write tag into (%rax). Width follows the enum's tag type. */
store_enum_tag(tag: int, tag_ty: *Type) noregion {
    cg_mov_imm(tag, 7);
    if (is_i8_ty(tag_ty)) {
        cg_movb_rm(7, 0, 0);
    } else {
        if (is_i32_ty(tag_ty) || is_u32_ty(tag_ty)) {
            cg_movl_rm(7, 0, 0);
        } else {
            cg_mov_rm(7, 0, 0);
        }
    }
}

variant_payload_off(v: ?*Variant): int {
    if (v == null) {
        8;
    } else {
        v.payload_offset;
    }
}

emit_memcpy(sz: int) noregion {
    if (sz <= 0) {
        sz = 8;
    }
    i: int = 0;
    while (i + 8 <= sz) {
        cg_mov_mr(6, i, 0);
        cg_mov_rm(0, 7, i);
        i = i + 8;
    }
    while (i < sz) {
        cg_movzb_mr(6, i, 0);
        cg_movb_rm(0, 7, i);
        i = i + 1;
    }
}

/* Store value in %rax into (%rdi). By-ref aggregates: %rax is a source pointer. */
store_value(ty: *Type) noregion {
    if (passes_by_ref(ty)) {
        cg_mov_rr(0, 6);
        emit_memcpy(type_size(ty));
    } else {
        store_mem(ty);
    }
}

/* Fill in %r8, dest in %rdi. Struct/enum/exn literals are addresses. */
store_array_fill(fill: *Expr, base: *Type) noregion {
    if (is_struct_ty(base) || is_enum_ty(base) || is_exn_ty(base)) {
        lit: int = 0;
        match fill.kind {
            StructLit _ -> {
                lit = 1;
            }
            VariantLit _ -> {
                lit = 1;
            }
            _ -> { }
        }
        if (lit != 0 || passes_by_ref(base)) {
            cg_mov_rr(8, 6);
            emit_memcpy(type_size(base));
            return;
        }
    }
    cg_mov_rr(8, 0);
    store_mem(base);
}

/*
 * Object base in %rbx (absolute). Eval RHS first so a large aggregate stack
 * temp from gen_expr cannot bury a pushed destination address.
 * base_off is added to each field offset (0 for structs, 8 for enum payloads).
 */
gen_field_inits(inits: ?*FieldInit, base_off: int) noregion raises Error {
    init: ?*FieldInit = inits;
    while (init != null) {
        lhs: ?*Expr = init.lhs;
        if (lhs != null) {
            mem: *Member = init.member or error("internal");
            mty: *Type = mem.ty;
            gen_expr(lhs);
            cg_mov_rr(3, 7);
            off: int = base_off + mem.offset;
            if (off != 0) {
                cg_alu_imm(0, off, 7);
            }
            store_value(mty);
        }
        init = init.next;
    }
}

emit_exit1() noregion {
    cg_mov_imm(1, 7);
    cg_call("exit");
}

/* Heap is 64MiB. n * esz + 8 must not wrap; negative n is huge unsigned. */
emit_check_new_count(nreg: int, esz: int) noregion {
    max_n: int = 67108856 / esz;
    if (max_n <= 0) {
        max_n = 0;
    }
    cg_alu_imm(7, max_n, nreg);
    cg_jump_id(7, oob_lab);
}

emit_malloc() noregion {
    cg_call("malloc");
    cg_alu_imm(7, 0, 0);
    cg_jump_id(4, oob_lab);
}

emit_exc_malloc() noregion {
    cg_call("l8_exc_malloc");
    cg_alu_imm(7, 0, 0);
    cg_jump_id(4, oob_lab);
}

emit_check_idx() noregion {
    cg_alu_rr(57, 2, 1);
    cg_jump_id(3, oob_lab);
}

/* Args already in rdi=dst, rsi=di, rdx=src, rcx=si, r8=n. Check ends, then
 * call runtime memcpy(dst+di, src+si, n). ja: di+n > len is OOB.
 * di/si are also compared to len first so a negative index cannot wrap. */
emit_memcpy_call() noregion {
    cg_mov_mr(7, 0 - 8, 0);
    cg_alu_rr(57, 0, 6);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(6, 10);
    cg_alu_rr(1, 8, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_mov_mr(2, 0 - 8, 0);
    cg_alu_rr(57, 0, 1);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(1, 10);
    cg_alu_rr(1, 8, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_alu_rr(1, 6, 7);
    cg_alu_rr(1, 1, 2);
    cg_mov_rr(2, 6);
    cg_mov_rr(8, 2);
    cg_call("l8_memcpy");
}

/* Args already in registers. []i8 uses the length prefix; *i8 is one byte. */
emit_io_call(name: []i8@immortal, args: ?*Expr) noregion raises Error {
    a0: ?*Expr = args;
    if (a0 == null) {
        error("missing I/O args");
    }
    a1: ?*Expr = a0.next;
    if (a1 == null) {
        error("missing I/O args");
    }
    t1: ?*Type = decay(a1.ty);
    a2: ?*Expr = a1.next;
    if (t1 != null && is_pointer(t1)) {
        cg_mov_imm(1, 2);
        cg_call(name);
        return;
    }
    if (a2 == null) {
        cg_mov_mr(6, 0 - 8, 2);
        cg_call(name);
        return;
    }
    if (a2.next == null) {
        cg_mov_mr(6, 0 - 8, 0);
        cg_alu_rr(57, 0, 2);
        cg_jump_id(7, oob_lab);
        cg_call(name);
        return;
    }
    cg_mov_mr(6, 0 - 8, 0);
    cg_alu_rr(57, 0, 2);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(2, 10);
    cg_alu_rr(1, 1, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_alu_rr(1, 2, 6);
    cg_mov_rr(1, 2);
    cg_call(name);
}

emit_scale_offset(esz: int) noregion {
    if (esz == 1) {
        cg_alu_rr(1, 1, 6);
        cg_mov_rr(6, 0);
    } else {
        cg_mov_rr(1, 0);
        if (esz != 0) {
            cg_imul_imm(esz, 0);
        }
        cg_alu_rr(1, 6, 0);
    }
}

index_atom(n: *Expr): bool {
    match n.kind {
        Num k -> {
            k.str_label == 0;
        }
        Var _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

index_simple(n: *Expr): bool {
    match n.kind {
        Num k -> {
            k.str_label == 0;
        }
        Var _p -> {
            true;
        }
        Binary k -> {
            match k.op {
                Add -> {
                    index_atom(k.lhs) && index_atom(k.rhs);
                }
                _ -> {
                    false;
                }
            }
        }
        _ -> {
            false;
        }
    }
}

gen_simple_idx(n: *Expr) noregion raises Error {
    match n.kind {
        Num k -> {
            cg_mov_imm(k.val, 0);
            return;
        }
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo == null) {
                error("missing var");
            }
            vu: *Obj = vo;
            emit_load_var(vu, vu.ty or error("missing type"));
            return;
        }
        Binary k -> {
            kn: int = index_idx_num(k.rhs);
            if (kn >= 0) {
                gen_simple_idx(k.lhs);
                if (kn != 0) {
                    cg_alu_imm(0, kn, 0);
                }
                return;
            }
            knl: int = index_idx_num(k.lhs);
            if (knl >= 0) {
                gen_simple_idx(k.rhs);
                if (knl != 0) {
                    cg_alu_imm(0, knl, 0);
                }
                return;
            }
            gen_simple_idx(k.lhs);
            cg_mov_rr(0, 1);
            gen_simple_idx(k.rhs);
            cg_alu_rr(1, 1, 0);
            return;
        }
        _ -> {
            error("internal: gen_simple_idx");
        }
    }
}

gen_index_addr(lhs: *Expr, idx: *Expr) noregion raises Error {
    raw: *Type = lhs.ty or error("missing type");
    esz: int = type_size(type_base(raw));
    lv: ?*Obj = index_lhs_var(lhs);
    if (lv != null && index_simple(idx)) {
        gen_simple_idx(idx);
        cg_mov_rr(0, 1);
        lvo: *Obj = lv;
        lty: *Type = lvo.ty or error("missing type");
        emit_load_var(lvo, lty);
        cg_mov_rr(0, 6);
        if (is_zptr(raw)) {
            emit_scale_offset(esz);
            return;
        }
        if (!is_slice(raw)) {
            error("index requires []T or [z]T");
        }
        cg_mov_mr(6, 0 - 8, 2);
        emit_check_idx();
        emit_scale_offset(esz);
        return;
    }
    cg_push(3);
    if (is_zptr(raw)) {
        gen_expr(lhs);
        cg_mov_rr(0, 6);
        cg_push(6);
        gen_expr(idx);
        cg_mov_rr(0, 1);
        cg_pop(6);
    } else {
        if (!is_slice(raw)) {
            error("index requires []T or [z]T");
        }
        gen_expr(lhs);
        cg_mov_rr(0, 6);
        cg_mov_mr(6, 0 - 8, 2);
        cg_push(6);
        cg_push(2);
        gen_expr(idx);
        cg_mov_rr(0, 1);
        cg_pop(2);
        cg_pop(6);
        emit_check_idx();
    }
    emit_scale_offset(esz);
    cg_pop(3);
}

gen_struct_inits(inits: ?*FieldInit) noregion raises Error {
    gen_field_inits(inits, 0);
}

gen_variant_inits(inits: ?*FieldInit, base_off: int) noregion raises Error {
    gen_field_inits(inits, base_off);
}

gen_addr(n: *Expr) noregion raises Error {
    match n.kind {
        Var k -> {
            var: ?*Obj = k.var;
            if (var == null) {
                error("missing var");
            }
            vo: *Obj = var;
            if (vo.is_local != 0) {
                cg_lea_mr(5, vo.offset, 0);
            } else {
                cg_lea_rip(vo.name, 0, 0);
            }
            return;
        }
        Deref k -> {
            gen_expr(k.lhs);
            return;
        }
        Index k -> {
            gen_index_addr(k.lhs, k.idx);
            return;
        }
        MemberAccess k -> {
            t: ?*Type = decay(k.lhs.ty);
            if (t != null && is_pointer(t) && (is_struct_ty(type_base(t)) || is_exn_ty(type_base(t)))) {
                gen_expr(k.lhs);
            } else {
                gen_addr(k.lhs);
            }
            mem: *Member = k.member or error("internal");
            if (mem.offset != 0) {
                cg_alu_imm(0, mem.offset, 0);
            }
            return;
        }
        _ -> {
            error("not an lvalue");
        }
    }
}

/* Scalar load of a variable into %rax without lea+deref. */
emit_load_var(vo: *Obj, ty: *Type) noregion {
    esz: int = enum_mem_size(ty);
    if (vo.is_local != 0) {
        if (esz == 1 || is_byte_ty(ty)) {
            cg_movzb_mr(5, vo.offset, 0);
        } else {
            if (esz == 4 || is_i32_ty(ty)) {
                cg_movsxd_mr(5, vo.offset, 0);
            } else {
                if (is_u32_ty(ty) || is_f32_ty(ty)) {
                    cg_movl_mr(5, vo.offset, 0);
                } else {
                    cg_mov_mr(5, vo.offset, 0);
                }
            }
        }
    } else {
        cg_mov_rip_r(vo.name, 0, 0);
        if (esz == 4 || is_i32_ty(ty)) {
            cg_movsxd_eax();
        }
        if (is_u32_ty(ty) || is_f32_ty(ty)) {
            cg_movl_eax();
        }
    }
}

emit_store_var(vo: *Obj, ty: *Type) noregion {
    esz: int = enum_mem_size(ty);
    if (vo.is_local != 0) {
        if (esz == 1 || is_byte_ty(ty)) {
            cg_movb_rm(0, 5, vo.offset);
        } else {
            if (esz == 4 || is_i32_ty(ty) || is_u32_ty(ty) || is_f32_ty(ty)) {
                cg_movl_rm(0, 5, vo.offset);
            } else {
                cg_mov_rm(0, 5, vo.offset);
            }
        }
    } else {
        cg_mov_r_rip(0, vo.name, 0);
    }
}

fits_imm32(v: int): bool {
    lo: int = 0 - 2147483647;
    lo = lo - 1;
    hi: int = 2147483647;
    if (v < lo) {
        return false;
    }
    if (v > hi) {
        return false;
    }
    true;
}

/* Store an immediate into a scalar variable (no %rax round-trip). */
emit_store_imm(vo: *Obj, ty: *Type, v: int) noregion {
    esz: int = enum_mem_size(ty);
    if (vo.is_local != 0) {
        if (esz == 1 || is_byte_ty(ty)) {
            cg_movb_imm_m(v, 5, vo.offset);
        } else {
            if (esz == 4 || is_i32_ty(ty) || is_u32_ty(ty) || is_f32_ty(ty)) {
                cg_movl_imm_m(v, 5, vo.offset);
            } else {
                cg_movq_imm_m(v, 5, vo.offset);
            }
        }
    } else {
        if (esz == 1 || is_byte_ty(ty)) {
            cg_movb_imm_rip(v, vo.name);
        } else {
            cg_movq_imm_rip(v, vo.name);
        }
    }
}

gen_load(n: *Expr) noregion raises Error {
    ty: *Type = n.ty or error("missing type");
    if (passes_by_ref(ty)) {
        gen_addr(n);
        return;
    }
    match n.kind {
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo != null) {
                emit_load_var(vo, ty);
                return;
            }
        }
        _ -> { }
    }
    gen_addr(n);
    load_mem(ty);
}

gen_binop_setup(lhs: *Expr, rhs: *Expr) noregion raises Error {
    gen_expr(lhs);
    cg_push(0);
    gen_expr(rhs);
    cg_mov_rr(0, 7);
    cg_pop(0);
}

bits_to_xmm(xmm: int, wide: int) noregion {
    if (wide != 0) {
        cg_movq_r_xmm(0, xmm);
    } else {
        cg_movd_r_xmm(0, xmm);
    }
}

xmm_to_bits(xmm: int, wide: int) noregion {
    if (wide != 0) {
        cg_movq_xmm_r(xmm, 0);
    } else {
        cg_movd_xmm_r(xmm, 0);
    }
}

gpr_to_xmm(gpr: int, xmm: int, wide: int) noregion {
    if (wide != 0) {
        cg_movq_r_xmm(gpr, xmm);
    } else {
        cg_movd_r_xmm(gpr, xmm);
    }
}

gen_float_binop(
    op: BinOp,
    lhs: *Expr,
    rhs: *Expr,
    wide: int
) noregion raises Error {
    gen_binop_setup(lhs, rhs);
    bits_to_xmm(0, wide);
    gpr_to_xmm(7, 1, wide);
    match op {
        Add -> {
            if (wide != 0) {
                cg_addsd(0, 1);
            } else {
                cg_addss(0, 1);
            }
        }
        Sub -> {
            if (wide != 0) {
                cg_subsd(0, 1);
            } else {
                cg_subss(0, 1);
            }
        }
        Mul -> {
            if (wide != 0) {
                cg_mulsd(0, 1);
            } else {
                cg_mulss(0, 1);
            }
        }
        Div -> {
            if (wide != 0) {
                cg_divsd(0, 1);
            } else {
                cg_divss(0, 1);
            }
        }
        _ -> {
            error("invalid float operator");
        }
    }
    xmm_to_bits(0, wide);
}

gen_float_cmp(
    lhs: *Expr,
    rhs: *Expr,
    setcc: []i8,
    wide: int
) noregion raises Error {
    gen_binop_setup(lhs, rhs);
    bits_to_xmm(0, wide);
    gpr_to_xmm(7, 1, wide);
    if (wide != 0) {
        cg_ucomisd(0, 1);
    } else {
        cg_ucomiss(0, 1);
    }
    gen_cmp_set(setcc);
}

wrap_after(ty: ?*Type) noregion {
    if (ty != null) {
        if (is_i8_ty(ty)) {
            cg_movzb_al_rax();
        }
        if (is_i32_ty(ty)) {
            cg_movsxd_eax();
        }
        if (is_u32_ty(ty)) {
            cg_movl_eax();
        }
    }
}

emit_convert(from: ?*Type, to: ?*Type) noregion raises Error {
    if (from == null || to == null) {
        return;
    }
    if (types_equal(from, to)) {
        return;
    }
    if (is_i32_ty(from) && is_int_ty(to)) {
        cg_movsxd_eax();
        return;
    }
    if (is_u32_ty(from) && is_int_ty(to)) {
        cg_movl_eax();
        return;
    }
    if (is_i8_ty(from) && is_int_ty(to)) {
        cg_movzb_al_rax();
        return;
    }
    if (is_int_width_ty(from) && is_f32_ty(to)) {
        if (is_i32_ty(from)) {
            cg_movsxd_eax();
        }
        if (is_u32_ty(from) || is_i8_ty(from)) {
            if (is_i8_ty(from)) {
                cg_movzb_al_rax();
            } else {
                cg_movl_eax();
            }
        }
        cg_cvtsi2ss();
        xmm_to_bits(0, 0);
        return;
    }
    if (is_int_width_ty(from) && is_f64_ty(to)) {
        if (is_i32_ty(from)) {
            cg_movsxd_eax();
        }
        if (is_u32_ty(from) || is_i8_ty(from)) {
            if (is_i8_ty(from)) {
                cg_movzb_al_rax();
            } else {
                cg_movl_eax();
            }
        }
        cg_cvtsi2sd();
        xmm_to_bits(0, 1);
        return;
    }
    if (is_f32_ty(from) && is_int_ty(to)) {
        bits_to_xmm(0, 0);
        cg_cvttss2si();
        return;
    }
    if (is_f64_ty(from) && is_int_ty(to)) {
        bits_to_xmm(0, 1);
        cg_cvttsd2si();
        return;
    }
    if (is_f32_ty(from) && is_f64_ty(to)) {
        bits_to_xmm(0, 0);
        cg_cvtss2sd();
        xmm_to_bits(0, 1);
        return;
    }
    if (is_f64_ty(from) && is_f32_ty(to)) {
        bits_to_xmm(0, 1);
        cg_cvtsd2ss();
        xmm_to_bits(0, 0);
        return;
    }
}

emit_trunc_to(to: ?*Type) noregion {
    wrap_after(to);
}

is_sse_ty(t: ?*Type): int {
    if (t != null && is_float_ty(t)) {
        1;
    } else {
        0;
    }
}

/* Immediate integer operand for codegen (numeric literal or null). */
imm_operand(n: *Expr): int {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) {
                0;
            } else {
                1;
            }
        }
        Null -> {
            1;
        }
        _ -> {
            0;
        }
    }
}

imm_value(n: *Expr): int {
    match n.kind {
        Num k -> {
            k.val;
        }
        Null -> {
            0;
        }
        _ -> {
            0;
        }
    }
}

gen_cmp_set(setcc: []i8) noregion {
    cc: int = 4;
    if (streq(setcc, "setne")) {
        cc = 5;
    }
    if (streq(setcc, "setb")) {
        cc = 2;
    }
    if (streq(setcc, "setae")) {
        cc = 3;
    }
    if (streq(setcc, "setbe")) {
        cc = 6;
    }
    if (streq(setcc, "seta")) {
        cc = 7;
    }
    if (streq(setcc, "setl")) {
        cc = 12;
    }
    if (streq(setcc, "setge")) {
        cc = 13;
    }
    if (streq(setcc, "setle")) {
        cc = 14;
    }
    if (streq(setcc, "setg")) {
        cc = 15;
    }
    cg_setcc(cc);
    cg_movzb_al_rax();
}

gen_cmp(lhs: *Expr, rhs: *Expr, setcc: []i8) noregion raises Error {
    if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
        gen_expr(lhs);
        cg_alu_imm(7, imm_value(rhs), 0);
        gen_cmp_set(setcc);
        return;
    }
    if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
        gen_expr(rhs);
        cg_mov_rr(0, 7);
        cg_mov_imm(imm_value(lhs), 0);
        cg_alu_rr(57, 7, 0);
        gen_cmp_set(setcc);
        return;
    }
    gen_binop_setup(lhs, rhs);
    cg_alu_rr(57, 7, 0);
    gen_cmp_set(setcc);
