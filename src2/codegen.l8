            esz: int = type_size(base);
            if (esz <= 0) esz = 8;
            cnt: int = 0;
            ce: ?*Expr = k.elems;
            while (ce != null) {
                cnt = cnt + 1;
                ce = ce.next
            }
            /* Save rbx/r12/r13 below later struct-lit temps; r13 holds that slot. */
            cg_alu_imm(5, 24, 4);
            cg_mov_rm(12, 4, 0);
            cg_mov_rm(13, 4, 8);
            cg_mov_rm(3, 4, 16);
            cg_mov_rr(4, 13);
            cg_mov_imm(cnt, 12);
