                    error("sizeof");
                }
                sty = se.ty;
            }
            cg_mov_imm(type_size(sty or error("sizeof")), 0);
            return;
        }
        ArrayLit k -> {
            base: *Type = type_base(n.ty or error("missing type"));
            esz: int = type_size(base);
            if (esz <= 0) {
                esz = 8;
            }
            cnt: int = 0;
            ce: ?*Expr = k.elems;
            while (ce != null) {
                cnt = cnt + 1;
                ce = ce.next;
            }
            /* Save rbx/r12/r13 below later struct-lit temps; r13 holds that slot. */
            cg_alu_imm(5, 24, 4);
            cg_mov_rm(12, 4, 0);
            cg_mov_rm(13, 4, 8);
            cg_mov_rm(3, 4, 16);
            cg_mov_rr(4, 13);
            cg_mov_imm(cnt, 12);
            emit_check_new_count(12, esz);
            cg_mov_rr(12, 0);
            if (esz != 1) {
                cg_imul_imm(esz, 0);
            }
            cg_alu_imm(0, 8, 0);
            cg_mov_rr(0, 7);
            emit_malloc();
            cg_mov_rm(12, 0, 0);
            cg_alu_imm(0, 8, 0);
            cg_mov_rr(0, 3);
            cg_mov_rr(0, 12);
            ae: ?*Expr = k.elems;
            while (ae != null) {
                gen_expr(ae);
                cg_mov_rr(3, 7);
                store_value(base);
                cg_alu_imm(0, esz, 3);
                ae = ae.next;
            }
            cg_mov_rr(12, 0);
            cg_mov_mr(13, 16, 3);
            cg_mov_mr(13, 0, 12);
            cg_mov_mr(13, 8, 13);
            return;
        }
        _ -> {
            error("invalid expression");
        }
    }
}

gen_match(cond: *Expr, arms: ?*MatchArm) noregion raises Error {
    lend: int = new_label();
    match cond.kind {
        Var _p -> {
            gen_addr(cond);
        }
        MemberAccess _p -> {
            gen_addr(cond);
        }
        Deref _p -> {
            gen_addr(cond);
        }
        _ -> {
            gen_expr(cond);
        }
    }
    cg_push(0);
    cty: ?*Type = cond.ty;
    if (cty != null && is_enum_ty(cty)) {
        load_mem(enum_tag_type(cty));
    } else {
        cg_mov_mr(0, 0, 0);
    }
    cg_push(0);
    arm: ?*MatchArm = arms;
    while (arm != null) {
        la: int = new_label();
        av: ?*Variant = arm.variant;
        if (av != null) {
            cg_mov_mr(4, 0, 0);
            cg_alu_imm(7, av.tag, 0);
            cg_jump_id(5, la);
        }
        bv: ?*Obj = arm.binder;
        if (bv != null) {
            if (av == null) {
                error("missing variant");
            }
            psz: int = av.payload_size;
            poff: int = av.payload_offset;
            cg_mov_mr(4, 8, 6);
            if (poff != 0) {
                cg_alu_imm(0, poff, 6);
            }
            cg_lea_mr(5, bv.offset, 7);
            emit_memcpy(psz);
        }
        gen_stmt(arm.body);
        cg_jump_id(0 - 1, lend);
        if (av != null) {
            cg_label_id(la);
        }
        arm = arm.next;
    }
    cg_mov_imm(1, 7);
    cg_call("exit");
    cg_label_id(lend);
    cg_alu_imm(0, 16, 4);
}

gen_stmt(n: *Stmt) noregion raises Error {
    match n.kind {
        Return k -> {
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                gen_expr(lhs);
                sret: ?*Obj = current_sret;
                if (sret != null) {
                    cg_mov_rr(0, 6);
                    cg_mov_mr(5, sret.offset, 7);
                    emit_memcpy(type_size(current_return_ty or error("missing return type")));
                    cg_mov_rr(7, 0);
                }
            } else {
                cg_mov_imm(0, 0);
            }
            rd: int = cg_region_depth;
            while (rd > 0) {
                cg_call("l8_region_pop");
                rd = rd - 1;
            }
            cg_jump_id(0 - 1, current_return_lab);
            return;
        }
        ExprStmt k -> {
            gen_expr(k.lhs);
            return;
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                gen_stmt(s);
                s = s.next;
            }
            return;
        }
        If k -> {
            le: int = new_label();
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            els: ?*Stmt = k.els;
            if (els == null) {
                cg_jump_id(4, le);
                gen_stmt(k.then);
                cg_label_id(le);
                return;
            }
            lelse: int = new_label();
            cg_jump_id(4, lelse);
            gen_stmt(k.then);
            cg_jump_id(0 - 1, le);
            cg_label_id(lelse);
            gen_stmt(els);
            cg_label_id(le);
            return;
        }
        While k -> {
            lb: int = new_label();
            le2: int = new_label();
            cg_label_id(lb);
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, le2);
            gen_stmt(k.body);
            cg_jump_id(0 - 1, lb);
            cg_label_id(le2);
            return;
        }
        For k -> {
            lb3: int = new_label();
            le3: int = new_label();
            hu3: ?*Expr = k.hi;
            if (hu3 != null) {
                gen_expr(k.iter);
                emit_store_var(k.item, ty_int);
                gen_expr(hu3);
                emit_store_var(k.n, ty_int);
                cg_label_id(lb3);
                emit_load_var(k.item, ty_int);
                cg_mov_rr(0, 1);
                emit_load_var(k.n, ty_int);
                cg_alu_rr(57, 0, 1);
                cg_jump_id(13, le3);
                gen_stmt(k.body);
                emit_load_var(k.item, ty_int);
                cg_alu_imm(0, 1, 0);
                emit_store_var(k.item, ty_int);
                cg_jump_id(0 - 1, lb3);
                cg_label_id(le3);
                return;
            }
            co2: ?*Obj = k.coll;
            ix2: ?*Obj = k.idx;
            if (co2 == null || ix2 == null) {
                error("internal: for array missing temps");
            }
            cu2: *Obj = co2;
            iu2: *Obj = ix2;
            sty: *Type = cu2.ty or error("missing type");
            ity: *Type = k.item.ty or error("missing type");
            esz: int = type_size(ity);
            gen_expr(k.iter);
            emit_store_var(cu2, sty);
            emit_store_imm(iu2, ty_int, 0);
            emit_load_var(cu2, sty);
            cg_mov_mr(0, 0 - 8, 0);
            emit_store_var(k.n, ty_int);
            cg_label_id(lb3);
            emit_load_var(iu2, ty_int);
            cg_mov_rr(0, 1);
            emit_load_var(k.n, ty_int);
            cg_alu_rr(57, 0, 1);
            cg_jump_id(3, le3);
            emit_load_var(cu2, sty);
            cg_mov_rr(0, 6);
            emit_load_var(iu2, ty_int);
            cg_mov_rr(0, 1);
            emit_scale_offset(esz);
            if (passes_by_ref(ity)) {
                cg_mov_rr(0, 6);
                cg_lea_mr(5, k.item.offset, 7);
                emit_memcpy(esz);
            } else {
                load_mem(ity);
                emit_store_var(k.item, ity);
            }
            gen_stmt(k.body);
            emit_load_var(iu2, ty_int);
            cg_alu_imm(0, 1, 0);
            emit_store_var(iu2, ty_int);
            cg_jump_id(0 - 1, lb3);
            cg_label_id(le3);
            return;
        }
        Match k -> {
            gen_match(k.cond, k.arms);
            return;
        }
        Raise k -> {
            ex: *ExnDef = k.exn or error("internal");
            if (ex.members != null) {
                esz: int = ex.size;
                if (esz <= 0) {
                    esz = 8;
                }
                cg_mov_imm(esz, 7);
                emit_exc_malloc();
                cg_push(3);
                cg_mov_rr(0, 3);
                gen_struct_inits(k.inits);
                cg_mov_rr(3, 6);
                cg_pop(3);
            } else {
                cg_mov_imm(0, 6);
            }
            cg_mov_imm(ex.tag, 7);
            cg_call("l8_raise");
            return;
        }
        Try k -> {
            lcatch: int = new_label();
            ltryend: int = new_label();
            cg_lea_mr(5, k.buf.offset, 7);
            cg_call("l8_try_begin");
            cg_alu_imm(7, 0, 0);
            cg_jump_id(5, lcatch);
            gen_stmt(k.body);
            cg_call("l8_try_end");
            cg_jump_id(0 - 1, ltryend);
            cg_label_id(lcatch);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                la2: int = new_label();
                ced: *ExnDef = arm2.exn or error("internal");
                cg_mov_rip_r("l8_exc_tag", 0, 0);
                cg_alu_imm(7, ced.tag, 0);
                cg_jump_id(5, la2);
                binder: ?*Obj = arm2.binder;
                if (binder != null) {
                    psz2: int = ced.size;
                    if (psz2 > 0) {
                        cg_mov_rip_r("l8_exc_ptr", 0, 6);
                        cg_lea_mr(5, binder.offset, 7);
                        emit_memcpy(psz2);
                    }
                }
                gen_stmt(arm2.body);
                cg_jump_id(0 - 1, ltryend);
                cg_label_id(la2);
                arm2 = arm2.next;
            }
            cg_mov_rip_r("l8_exc_tag", 0, 7);
            cg_mov_rip_r("l8_exc_ptr", 0, 6);
            cg_call("l8_raise");
            cg_label_id(ltryend);
            return;
        }
        Region k -> {
            cg_call("l8_heap_mark");
            emit_store_var(k.mark, ty_int);
            emit_load_var(k.mark, ty_int);
            cg_mov_rr(0, cg_arg_reg(0));
            cg_call("l8_region_push");
            cg_region_depth = cg_region_depth + 1;
            gen_stmt(k.body);
            cg_region_depth = cg_region_depth - 1;
            cg_call("l8_region_pop");
            return;
        }
        Comment _c -> {
            return;
        }
        Decl k -> {
            vo: ?*Obj = k.var;
            init: ?*Expr = k.init;
            if (init != null && vo != null) {
                ae: *Expr = new_assign(new_var_node(vo), init);
                gen_expr(ae);
            }
            return;
        }
        _ -> {
            error("invalid statement");
        }
    }
}

emit_ret_to_rax(ty: ?*Type) noregion {
    if (ty != null && is_f32_ty(ty)) {
        xmm_to_bits(0, 0);
    }
    if (ty != null && is_f64_ty(ty)) {
        xmm_to_bits(0, 1);
    }
}

emit_rax_to_ret(ty: ?*Type) noregion {
    if (ty != null && is_f32_ty(ty)) {
        bits_to_xmm(0, 0);
    }
    if (ty != null && is_f64_ty(ty)) {
        bits_to_xmm(0, 1);
    }
}

emit_reverse_stack(n: int) noregion {
    if (n <= 1) {
        return;
    }
    l: int = 0;
    r: int = n - 1;
    while (l < r) {
        cg_mov_mr(4, 8 * l, 10);
        cg_mov_mr(4, 8 * r, 0);
        cg_mov_rm(0, 4, 8 * l);
        cg_mov_rm(10, 4, 8 * r);
        l = l + 1;
        r = r - 1;
    }
}

emit_place_call_regs(nslots: int) noregion {
    if (nslots <= 6) {
        i: int = nslots - 1;
        while (i >= 0) {
            cg_pop(cg_arg_reg(i));
            i = i - 1;
        }
        return;
    }
    emit_reverse_stack(nslots);
    i2: int = 0;
    while (i2 < 6) {
        cg_pop(cg_arg_reg(i2));
        i2 = i2 + 1;
    }
}

emit_store_incoming(slot: int, dest_off: int) noregion {
    if (slot < 6) {
        cg_mov_rm(cg_arg_reg(slot), 5, dest_off);
        return;
    }
    cg_mov_mr(5, 16 + 8 * (slot - 6), 0);
    cg_mov_rm(0, 5, dest_off);
}

assign_lvar_offsets(fn: *Function) raises Error {
    off: int = 0;
    v: ?*Obj = fn.locals;
    while (v != null) {
        vty: *Type = v.ty or error("missing local type");
        sz: int = type_size(vty);
        if (sz <= 0) {
            sz = 8;
        }
        if (sz < 8) {
            sz = 8;
        }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 7) / 16 * 16 + 8;
}

emit_global_init(g: *Obj) noregion raises Error {
    init: *Expr = g.init or error("missing global initializer");
    gty: *Type = g.ty or error("missing global type");
    sz: int = type_size(gty);
    if (sz <= 0) {
        sz = 8;
    }
    v: int = const_value(init);
    cg_label(g.name);
    if (sz > 8) {
        error("global initializer must be a scalar constant");
    }
    cg_quad(v);
}

emit_bss_global(g: *Obj) noregion {
    sz: int = 8;
    gty: ?*Type = g.ty;
    if (gty != null) {
        sz = type_size(gty);
    }
    if (sz <= 0) {
        sz = 8;
    }
    if (gty != null && sz < 8) {
        sz = 8;
    }
    cg_label(g.name);
    cg_skip(sz);
}

emit_data() noregion raises Error {
    g: ?*Obj = globals;
    any_data: int = 0;
    while (g != null) {
        if (g.is_func == 0 && is_const_init(g.init)) {
            if (any_data == 0) {
                cg_section(as_SEC_DATA);
                cg_align(8);
                any_data = 1;
            }
            emit_global_init(g);
        }
        g = g.next;
    }
    g = globals;
    any_bss: int = 0;
    while (g != null) {
        if (g.is_func == 0 && !is_const_init(g.init)) {
            if (any_bss == 0) {
                cg_section(as_SEC_BSS);
                cg_align(8);
                any_bss = 1;
            }
            emit_bss_global(g);
        }
        g = g.next;
    }
    if (any_bss == 0) {
        cg_section(as_SEC_BSS);
        cg_align(8);
    }
    cg_global("l8_init_done");
    cg_label("l8_init_done");
    cg_skip(8);
    cg_section(as_SEC_RODATA);
    cg_align(8);
    s: ?*StrLit = str_lits;
    while (s != null) {
        cg_label(cg_name_num(".L.str", s.label));
        cg_quad(s.len);
        cg_bytes(s.data, 0, s.len);
        s = s.next;
    }
}

emit_dyn_global_inits(g: ?*Obj) noregion raises Error {
    if (g == null) {
        return;
    }
    emit_dyn_global_inits(g.next);
    if (g.is_func != 0) {
        return;
    }
    init: ?*Expr = g.init;
    if (is_const_init(init)) {
        return;
    }
    e: *Expr = init or error("missing global initializer");
    ty: *Type = g.ty or error("missing global type");
    gen_expr(e);
    emit_store_var(g, ty);
}

emit_l8_init_globals_fn() noregion raises Error {
    already: int = new_label();
    cg_global("l8_init_globals");
    cg_label("l8_init_globals");
    cg_rsp_off = 0;
    cg_push(5);
    cg_mov_rr(4, 5);
    cg_mov_rip_r("l8_init_done", 0, 0);
    cg_alu_imm(7, 0, 0);
    cg_jump_id(5, already);
    cg_mov_imm(1, 0);
    cg_mov_r_rip(0, "l8_init_done", 0);
    emit_dyn_global_inits(globals);
    cg_label_id(already);
    cg_mov_rr(5, 4);
    cg_pop(5);
    cg_ret();
}

emit_text() noregion raises Error {
    fn: ?*Function = functions;
    cg_section(as_SEC_TEXT);
    oob_lab = new_label();
    emit_l8_init_globals_fn();
    while (fn != null) {
        if (fn.is_extern == 0) {
            narrow_top = null;
            catch_top = null;
            assign_lvar_offsets(fn);
            current_fn_name = fn.name;
            current_return_ty = fn.return_ty;
            current_sret = fn.sret;
            current_fn = fn;
            current_return_lab = new_label();
            cg_region_depth = 0;
            cg_global(fn.name);
            cg_label(fn.name);
            cg_rsp_off = 0;
            cg_push(5);
            cg_mov_rr(4, 5);
            cg_alu_imm(5, fn.stack_size, 4);
            ri: int = 0;
            rs: int = 0;
            nst: int = 0;
            sret: ?*Obj = fn.sret;
            if (sret != null) {
                emit_store_incoming(ri, sret.offset);
                ri = ri + 1;
            }
            /* Spill incoming args first; by-ref memcpy clobbers %rsi/%rdi/%rax. */
            i: int = 0;
            while (i < fn.nparams) {
                po: ?*Obj = fn_param(fn, i);
                if (po == null) {
                    error("null obj");
                }
                p: *Obj = po;
                pty0: ?*Type = p.ty;
                if (pty0 != null && is_float_ty(pty0)) {
                    fw: int = 0;
                    if (is_f64_ty(pty0)) {
                        fw = 1;
                    }
                    if (rs < 8) {
                        xmm_to_bits(rs, fw);
                        if (is_f32_ty(pty0)) {
                            cg_movl_rm(0, 5, p.offset);
                        } else {
                            cg_mov_rm(0, 5, p.offset);
                        }
                        rs = rs + 1;
                    } else {
                        cg_mov_mr(5, 16 + 8 * nst, 0);
                        if (is_f32_ty(pty0)) {
                            cg_movl_rm(0, 5, p.offset);
                        } else {
                            cg_mov_rm(0, 5, p.offset);
                        }
                        nst = nst + 1;
                    }
                } else {
                    if (ri < 6) {
                        emit_store_incoming(ri, p.offset);
                        ri = ri + 1;
                    } else {
                        cg_mov_mr(5, 16 + 8 * nst, 0);
                        cg_mov_rm(0, 5, p.offset);
                        nst = nst + 1;
                    }
                }
                i = i + 1;
            }
            i = 0;
            while (i < fn.nparams) {
                po2: ?*Obj = fn_param(fn, i);
                if (po2 == null) {
                    error("null obj");
                }
                p2: *Obj = po2;
                pty: ?*Type = p2.ty;
                if (pty == null) {
                    error("missing param type");
                }
                if (passes_by_ref(pty)) {
                    cg_mov_mr(5, p2.offset, 6);
                    cg_lea_mr(5, p2.offset, 7);
                    emit_memcpy(type_size(pty));
                }
                i = i + 1;
            }
            if (streq(fn.name, "main")) {
                cg_call("l8_init_globals");
            }
            body: ?*Stmt = fn.body;
            if (body == null) {
                error("missing body");
            }
            gen_stmt(body);
            sret2: ?*Obj = current_sret;
            if (sret2 != null) {
                cg_mov_rr(0, 6);
                cg_mov_mr(5, sret2.offset, 7);
                emit_memcpy(type_size(current_return_ty or error("missing return type")));
                cg_mov_rr(7, 0);
            }
            cg_label_id(current_return_lab);
            emit_rax_to_ret(current_return_ty);
            cg_mov_rr(5, 4);
            cg_pop(5);
            cg_ret();
        }
        fn = fn.next;
    }
    cg_label_id(oob_lab);
    emit_exit1();
}

codegen() noregion raises Error {
    emit_data();
    emit_text();
    if (cg_direct_mode == 0) {
        emit_flush();
    }
}
