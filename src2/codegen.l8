            lt: int = new_label();
            lf2: int = new_label();
            le2: int = new_label();
            gen_cond(k.lhs, lt, true);
            gen_cond(k.rhs, lf2, false);
            cg_label_id(lt);
            cg_mov_imm(1, 0);
            cg_jump_id(0 - 1, le2);
