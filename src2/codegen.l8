                StructLit k -> {
                    lty: ?*Type = q.lhs.ty;
                    if (lty != null && is_struct_ty(lty)) {
                        gen_addr(q.lhs);
                        cg_push(3);
                        cg_mov_rr(0, 3);
                        gen_struct_inits(k.inits);
                        cg_mov_rr(3, 0);
                        cg_pop(3);
                        return
