            cg_push(3);
            cg_lea_mr(4, 8, 3);
            cg_mov_rr(3, 0);
            store_enum_tag(k.val, enum_tag_type(ety));
            gen_variant_inits(k.inits, variant_payload_off(k.variant));
            cg_mov_rr(3, 0);
            cg_pop(3);
