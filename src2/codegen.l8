gen_binary(op: BinOp, lhs: *Expr, rhs: *Expr) noregion raises Error {
    lty: ?*Type = decay(lhs.ty);
    if (lty != null && is_float_ty(lty)) {
        wide: int = 0;
        if (is_f64_ty(lty)) {
            wide = 1;
        }
        match op {
            Add -> {
                gen_float_binop(op, lhs, rhs, wide);
                return;
            }
            Sub -> {
                gen_float_binop(op, lhs, rhs, wide);
                return;
            }
            Mul -> {
                gen_float_binop(op, lhs, rhs, wide);
                return;
            }
            Div -> {
                gen_float_binop(op, lhs, rhs, wide);
                return;
            }
            Eq -> {
                gen_float_cmp(lhs, rhs, "sete", wide);
                return;
            }
            Ne -> {
                gen_float_cmp(lhs, rhs, "setne", wide);
                return;
            }
            Lt -> {
                gen_float_cmp(lhs, rhs, "setb", wide);
                return;
            }
            Le -> {
                gen_float_cmp(lhs, rhs, "setbe", wide);
                return;
            }
            Gt -> {
                gen_float_cmp(lhs, rhs, "seta", wide);
                return;
            }
            Ge -> {
                gen_float_cmp(lhs, rhs, "setae", wide);
                return;
            }
            _ -> {
                error("invalid float operator");
            }
        }
    }
    match op {
        Add -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v: int = imm_value(rhs);
                if (v != 0) {
                    cg_alu_imm(0, v, 0);
                }
                return;
            }
            if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                v2: int = imm_value(lhs);
                if (v2 != 0) {
                    cg_alu_imm(0, v2, 0);
                }
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(1, 7, 0);
            return;
        }
        Sub -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v3: int = imm_value(rhs);
                if (v3 != 0) {
                    cg_alu_imm(5, v3, 0);
                }
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(41, 7, 0);
            return;
        }
        Mul -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                mv: int = imm_value(rhs);
                if (mv == 0) {
                    cg_mov_imm(0, 0);
                    return;
                }
                if (mv == 1) {
                    return;
                }
                if (mv == 2) {
                    cg_alu_rr(1, 0, 0);
                    return;
                }
                cg_imul_imm(mv, 0);
                return;
            }
            if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                mv2: int = imm_value(lhs);
                if (mv2 == 0) {
                    cg_mov_imm(0, 0);
                    return;
                }
                if (mv2 == 1) {
                    return;
                }
                if (mv2 == 2) {
                    cg_alu_rr(1, 0, 0);
                    return;
                }
                cg_imul_imm(mv2, 0);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_imul_rr(7, 0);
            return;
        }
        Div -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            return;
        }
        Mod -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                cg_mov_rr(2, 0);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            cg_mov_rr(2, 0);
            return;
        }
        Eq -> {
            gen_cmp(lhs, rhs, "sete");
            return;
        }
        Ne -> {
            gen_cmp(lhs, rhs, "setne");
            return;
        }
        Lt -> {
            if (lty != null && is_u32_ty(lty)) {
                gen_cmp(lhs, rhs, "setb");
            } else {
                gen_cmp(lhs, rhs, "setl");
            }
            return;
        }
        Le -> {
            if (lty != null && is_u32_ty(lty)) {
                gen_cmp(lhs, rhs, "setbe");
            } else {
                gen_cmp(lhs, rhs, "setle");
            }
            return;
        }
        Gt -> {
            if (lty != null && is_u32_ty(lty)) {
                gen_cmp(lhs, rhs, "seta");
            } else {
                gen_cmp(lhs, rhs, "setg");
            }
            return;
        }
        Ge -> {
            if (lty != null && is_u32_ty(lty)) {
                gen_cmp(lhs, rhs, "setae");
            } else {
                gen_cmp(lhs, rhs, "setge");
            }
            return;
        }
        And -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(4, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(4, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(33, 7, 0);
            }
            return;
        }
        Or -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(1, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(1, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(9, 7, 0);
            }
            return;
        }
        Xor -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(6, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(6, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(49, 7, 0);
            }
            return;
        }
        Shl -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_shift_imm(4, imm_value(rhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_mov_rr(7, 1);
                cg_shift_cl(4, 0);
            }
            return;
        }
        Shr -> {
            sh: int = 7;
            if (lty != null && is_u32_ty(lty)) {
                sh = 5;
            }
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_shift_imm(sh, imm_value(rhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_mov_rr(7, 1);
                cg_shift_cl(sh, 0);
            }
            return;
        }
    }
}

gen_expr(n: *Expr) noregion raises Error {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) {
                cg_lea_rip(cg_name_num(".L.str", k.str_label - 1), 8, 0);
            } else {
                cg_mov_imm(k.val, 0);
            }
            return;
        }
        Null -> {
            cg_mov_imm(0, 0);
            return;
        }
        Var _p -> {
            gen_load(n);
            return;
        }
        MemberAccess _p -> {
            gen_load(n);
            return;
        }
        Addr k -> {
            gen_addr(k.lhs);
            return;
        }
        As k -> {
            gen_expr(k.lhs);
            emit_convert(k.lhs.ty, n.ty);
            return;
        }
        Trunc k -> {
            gen_expr(k.lhs);
            emit_trunc_to(n.ty);
            return;
        }
