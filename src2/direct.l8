// Typed compiler → assembler bridge. The compiler calls these structured
// operations for both sinks: textual assembly for `compile`, encoders for `build`.

cg_direct_mode: int;
cg_rsp_off: int;

cg_reg_name(r: int): *i8 {
    if (r == 0) { return "%rax"; }
    if (r == 1) { return "%rcx"; }
    if (r == 2) { return "%rdx"; }
    if (r == 3) { return "%rbx"; }
    if (r == 4) { return "%rsp"; }
    if (r == 5) { return "%rbp"; }
    if (r == 6) { return "%rsi"; }
    if (r == 7) { return "%rdi"; }
    if (r == 8) { return "%r8"; }
    if (r == 9) { return "%r9"; }
    if (r == 10) { return "%r10"; }
    if (r == 11) { return "%r11"; }
    if (r == 12) { return "%r12"; }
    if (r == 13) { return "%r13"; }
    if (r == 14) { return "%r14"; }
    return "%r15";
}

cg_arg_reg(i: int): int {
    if (i == 0) { return 7; }
    if (i == 1) { return 6; }
    if (i == 2) { return 2; }
    if (i == 3) { return 1; }
    if (i == 4) { return 8; }
    return 9;
}

cg_name_num(prefix: *i8, n: int): *i8 {
    pn: int = cstr_len(prefix);
    digits: int = 1;
    x: int = n;
    while (x >= 10) { digits = digits + 1; x = x / 10; }
    out: *i8 = new i8[pn + digits + 1];
    memcpy(out, prefix, pn);
    out[pn + digits] = 0 trunc i8;
    i: int = pn + digits - 1;
    x = n;
    while (i >= pn) {
        out[i] = (('0' as int) + (x % 10)) trunc i8;
        x = x / 10;
        i = i - 1;
    }
    return out;
}

cg_name_pair(a: *i8, b: *i8): *i8 {
    an: int = cstr_len(a);
    bn: int = cstr_len(b);
    out: *i8 = new i8[an + bn + 1];
    memcpy(out, a, an);
    memcpy(out + an, b, bn);
    out[an + bn] = 0 trunc i8;
    return out;
}

cg_emit_name(name: *i8) {
    i: int = 0;
    while (name[i] != 0 trunc i8) {
        emit_ch(name[i]);
        i = i + 1;
    }
}

cg_emit_mem(disp: int, base: int) {
    emit_num(disp); emit("("); emit(cg_reg_name(base)); emit(")");
}

cg_section(sec: int) {
    if (cg_direct_mode != 0) { as_cur_sec = sec; return; }
    if (sec == as_SEC_TEXT) { emit(".section .text\n"); }
    if (sec == as_SEC_RODATA) { emit(".section .rodata\n"); }
    if (sec == as_SEC_DATA) { emit(".section .data\n"); }
    if (sec == as_SEC_BSS) { emit(".section .bss\n"); }
}

cg_align(n: int) {
    if (cg_direct_mode != 0) { as_do_align(n); return; }
    emit(".align "); emit_num(n); emit("\n");
}

cg_global(name: *i8) {
    if (cg_direct_mode != 0) { as_add_globl(name); return; }
    emit(".globl "); cg_emit_name(name); emit("\n");
}

cg_label(name: *i8) {
    if (cg_direct_mode != 0) { as_define_sym(name); return; }
    cg_emit_name(name); emit(":\n");
}

cg_skip(n: int) {
    if (cg_direct_mode != 0) { as_skip_bytes(n); return; }
    emit("  .skip "); emit_num(n); emit("\n");
}

cg_quad(n: int) {
    if (cg_direct_mode != 0) { as_emit_u64(n); return; }
    emit("  .quad "); emit_num(n); emit("\n");
}

cg_bytes(p: *i8, n: int) {
    if (cg_direct_mode != 0) {
        i: int = 0;
        while (i < n) { as_emit_b(p[i] as int); i = i + 1; }
        as_emit_b(0);
        return;
    }
    emit("  .byte ");
    i: int = 0;
    while (i < n) {
        if (i != 0) { emit(","); }
        emit_num(p[i] as int);
        i = i + 1;
    }
    if (n == 0) { emit("0"); } else { emit(",0"); }
    emit("\n");
}

cg_push(r: int) {
    cg_rsp_off = cg_rsp_off + 8;
    if (cg_direct_mode != 0) { as_emit_push(r); return; }
    emit("  push "); emit(cg_reg_name(r)); emit("\n");
}

cg_pop(r: int) {
    cg_rsp_off = cg_rsp_off - 8;
    if (cg_direct_mode != 0) { as_emit_pop(r); return; }
    emit("  pop "); emit(cg_reg_name(r)); emit("\n");
}

cg_ret() {
    if (cg_direct_mode != 0) { as_emit_b(195); return; }
    emit("  ret\n");
}

cg_mov_rr(src: int, dst: int) {
    if (src == dst) { return; }
    if (cg_direct_mode != 0) { as_emit_mov_rr(src, dst); return; }
    emit("  mov "); emit(cg_reg_name(src)); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_mov_imm(imm: int, dst: int) {
    if (imm == 0) {
        if (cg_direct_mode != 0) { as_emit_xor_zero(dst); return; }
        emit("  xor "); emit(cg_reg_name(dst)); emit(", "); emit(cg_reg_name(dst)); emit("\n");
        return;
    }
    if (cg_direct_mode != 0) { as_emit_mov_imm_r(imm, dst); return; }
    emit("  mov $"); emit_num(imm); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_mov_mr(base: int, disp: int, dst: int) {
    if (cg_direct_mode != 0) { as_emit_mov_mr(dst, base, disp, 0, "", 0); return; }
    emit("  mov "); cg_emit_mem(disp, base); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_movzb_mr(base: int, disp: int, dst: int) {
    if (cg_direct_mode != 0) {
        as_emit_rex(1, (dst / 8) % 2, 0, (base / 8) % 2);
        as_emit_b(15); as_emit_b(182); as_emit_modrm_mem(dst, base, disp, 0); return;
    }
    emit("  movzb "); cg_emit_mem(disp, base); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_mov_rm(src: int, base: int, disp: int) {
    if (cg_direct_mode != 0) { as_emit_mov_rm(src, base, disp, 0, "", 0); return; }
    emit("  mov "); emit(cg_reg_name(src)); emit(", "); cg_emit_mem(disp, base); emit("\n");
}

cg_movb_rm(src: int, base: int, disp: int) {
    if (cg_direct_mode != 0) {
        if ((base / 8) % 2 != 0) { as_emit_b(65); }
        as_emit_b(136); as_emit_modrm_mem(src, base, disp, 0); return;
    }
    emit("  mov %al, "); cg_emit_mem(disp, base); emit("\n");
}

cg_movq_imm_m(imm: int, base: int, disp: int) {
    if (cg_direct_mode != 0) {
        as_emit_rex(1, 0, 0, (base / 8) % 2);
        as_emit_b(199); as_emit_modrm_mem(0, base, disp, 0); as_emit_i32(imm); return;
    }
    emit("  movq $"); emit_num(imm); emit(", "); cg_emit_mem(disp, base); emit("\n");
}

cg_movb_imm_m(imm: int, base: int, disp: int) {
    if (cg_direct_mode != 0) {
        if ((base / 8) % 2 != 0) { as_emit_b(65); }
        as_emit_b(198); as_emit_modrm_mem(0, base, disp, 0); as_emit_b(imm); return;
    }
    emit("  movb $"); emit_num(imm); emit(", "); cg_emit_mem(disp, base); emit("\n");
}

cg_mov_rip_r(name: *i8, extra: int, dst: int) {
    if (cg_direct_mode != 0) { as_emit_mov_mr(dst, 0, 0, 1, name, extra); return; }
    emit("  mov "); cg_emit_name(name);
    if (extra != 0) { emit("+"); emit_num(extra); }
    emit("(%rip), "); emit(cg_reg_name(dst)); emit("\n");
}

cg_mov_r_rip(src: int, name: *i8, extra: int) {
    if (cg_direct_mode != 0) { as_emit_mov_rm(src, 0, 0, 1, name, extra); return; }
    emit("  mov "); emit(cg_reg_name(src)); emit(", "); cg_emit_name(name);
    if (extra != 0) { emit("+"); emit_num(extra); }
    emit("(%rip)\n");
}

cg_movq_imm_rip(imm: int, name: *i8) {
    if (cg_direct_mode != 0) {
        as_emit_rex(1, 0, 0, 0); as_emit_b(199);
        off: int = as_cur_off() + 1;
        as_emit_modrm_mem(0, 0, 0, 1);
        as_add_reloc(off, as_R_X86_64_PC32, name, 0 - 8);
        as_emit_i32(imm); return;
    }
    emit("  movq $"); emit_num(imm); emit(", "); cg_emit_name(name); emit("(%rip)\n");
}

cg_movb_imm_rip(imm: int, name: *i8) {
    if (cg_direct_mode != 0) {
        as_emit_b(198);
        off: int = as_cur_off() + 1;
        as_emit_modrm_mem(0, 0, 0, 1);
        as_add_reloc(off, as_R_X86_64_PC32, name, 0 - 5);
        as_emit_b(imm); return;
    }
    emit("  movb $"); emit_num(imm); emit(", "); cg_emit_name(name); emit("(%rip)\n");
}

cg_lea_mr(base: int, disp: int, dst: int) {
    if (cg_direct_mode != 0) { as_emit_lea(dst, base, disp, 0, "", 0); return; }
    emit("  lea "); cg_emit_mem(disp, base); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_lea_rip(name: *i8, extra: int, dst: int) {
    if (cg_direct_mode != 0) { as_emit_lea(dst, 0, 0, 1, name, extra); return; }
    emit("  lea "); cg_emit_name(name);
    if (extra != 0) { emit("+"); emit_num(extra); }
    emit("(%rip), "); emit(cg_reg_name(dst)); emit("\n");
}

cg_test(r: int) {
    if (cg_direct_mode != 0) { as_emit_test_rr(r); return; }
    emit("  test "); emit(cg_reg_name(r)); emit(", "); emit(cg_reg_name(r)); emit("\n");
}

cg_alu_imm(op: int, imm: int, dst: int) {
    if (imm == 0) {
        if (op == 0) { return; }
        if (op == 4) { return; }
        if (op == 5) { return; }
        if (op == 7) { cg_test(dst); return; }
    }
    if (dst == 4) {
        if (op == 5) { cg_rsp_off = cg_rsp_off + imm; }
        if (op == 0) { cg_rsp_off = cg_rsp_off - imm; }
    }
    if (cg_direct_mode != 0) {
        opc: int = 0 - 1;
        if (op == 0) { opc = 5; }
        if (op == 4) { opc = 37; }
        if (op == 5) { opc = 45; }
        if (op == 7) { opc = 61; }
        as_emit_alu_imm(op, imm, dst, opc); return;
    }
    if (op == 0) { emit("  add $"); }
    if (op == 4) { emit("  and $"); }
    if (op == 5) { emit("  sub $"); }
    if (op == 7) { emit("  cmp $"); }
    emit_num(imm); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_alu_rr(opc: int, src: int, dst: int) {
    if (cg_direct_mode != 0) { as_emit_alu_rr(opc, src, dst); return; }
    if (opc == 1) { emit("  add "); }
    if (opc == 41) { emit("  sub "); }
    if (opc == 57) { emit("  cmp "); }
    emit(cg_reg_name(src)); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_imul_imm(imm: int, dst: int) {
    if (cg_direct_mode != 0) {
        rb: int = (dst / 8) % 2;
        as_emit_rex(1, rb, 0, rb);
        if (as_fits_imm8(imm)) {
            as_emit_b(107); as_emit_b(192 + (dst % 8) * 8 + (dst % 8)); as_emit_b(imm);
        } else {
            as_emit_b(105); as_emit_b(192 + (dst % 8) * 8 + (dst % 8)); as_emit_i32(imm);
        }
        return;
    }
    emit("  imul $"); emit_num(imm); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_imul_rr(src: int, dst: int) {
    if (cg_direct_mode != 0) {
        as_emit_rex(1, (dst / 8) % 2, 0, (src / 8) % 2);
        as_emit_b(15); as_emit_b(175);
        as_emit_b(192 + (dst % 8) * 8 + (src % 8)); return;
    }
    emit("  imul "); emit(cg_reg_name(src)); emit(", "); emit(cg_reg_name(dst)); emit("\n");
}

cg_setcc(cc: int) {
    if (cg_direct_mode != 0) {
        as_emit_b(15); as_emit_b(144 + cc); as_emit_b(192); return;
    }
    if (cc == 4) { emit("  sete %al\n"); }
    if (cc == 5) { emit("  setne %al\n"); }
    if (cc == 12) { emit("  setl %al\n"); }
    if (cc == 13) { emit("  setge %al\n"); }
    if (cc == 14) { emit("  setle %al\n"); }
    if (cc == 15) { emit("  setg %al\n"); }
}

cg_movzb_al_rax() {
    if (cg_direct_mode != 0) {
        as_emit_rex(1, 0, 0, 0); as_emit_b(15); as_emit_b(182); as_emit_b(192); return;
    }
    emit("  movzb %al, %rax\n");
}

cg_neg(r: int) {
    if (cg_direct_mode != 0) {
        as_emit_rex(1, 0, 0, (r / 8) % 2); as_emit_b(247); as_emit_b(216 + (r % 8)); return;
    }
    emit("  neg "); emit(cg_reg_name(r)); emit("\n");
}

cg_cqo() {
    if (cg_direct_mode != 0) { as_emit_b(72); as_emit_b(153); return; }
    emit("  cqo\n");
}

cg_idiv(r: int) {
    if (cg_direct_mode != 0) {
        as_emit_rex(1, 0, 0, (r / 8) % 2); as_emit_b(247); as_emit_b(248 + (r % 8)); return;
    }
    emit("  idiv "); emit(cg_reg_name(r)); emit("\n");
}

cg_call(name: *i8) {
    mis: int = cg_rsp_off % 16;
    pad: int = 0;
    if (mis != 0) { pad = 16 - mis; }
    if (pad != 0) { cg_alu_imm(5, pad, 4); }
    if (cg_direct_mode != 0) {
        as_op_kind = as_OP_SYM; as_op_name = name; as_emit_call();
    } else {
        emit("  call "); cg_emit_name(name); emit("\n");
    }
    if (pad != 0) { cg_alu_imm(0, pad, 4); }
}

cg_jump(cc: int, name: *i8) {
    if (cg_direct_mode != 0) {
        as_op_kind = as_OP_SYM; as_op_name = name;
        if (cc < 0) { as_emit_jmp_sym(); } else { as_emit_jcc(cc); }
        return;
    }
    if (cc < 0) { emit("  jmp "); }
    if (cc == 4) { emit("  je "); }
    if (cc == 5) { emit("  jne "); }
    if (cc == 7) { emit("  ja "); }
    cg_emit_name(name); emit("\n");
}
