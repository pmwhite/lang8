import "common.l8";
import "assembler.l8";
import "direct.l8";
import "compiler.l8";
import "elfpack.l8";

build_usage(): int {
    write(2, "error: usage: l8 build [--profile|-p] <source.l8> -o <executable>\n", len("error: usage: l8 build [--profile|-p] <source.l8> -o <executable>\n"));
    1;
}

build_main(argc: int, argv: [argc][z]i8): int {
    do_profile = 0;
    source: ?*i8 = null;
    output: ?*i8 = null;
    want_o: int = 0;
    ai: int = 1;
    while (ai < argc) {
        arg: [z]i8 = argv[ai];
        if (want_o != 0) {
            if (output != null) { return build_usage(); }
            output = arg;
            want_o = 0;
        } else {
            if (is_profile_flag(arg)) {
                do_profile = 1;
            } else {
                if (cli_streq(arg, "-o")) {
                    want_o = 1;
                } else {
                    if (source != null) { return build_usage(); }
                    source = arg;
                }
            }
        }
        ai = ai + 1;
    }
    if (source == null) { return build_usage(); }
    if (output == null) { return build_usage(); }
    if (want_o != 0) { return build_usage(); }
    src: *i8 = source;
    out: *i8 = output;
    rc: int = compiler_build_direct(src);
    if (rc != 0) { return rc; }
    pack_assembler_exec(out);
    profile_mark("pack");
    profile_end();
    0;
}

main(argc: int, argv: [argc][z]i8): int {
    if (argc < 2) {
        write(2, "usage: l8 <compile|as|elfpack|build> ...\n", len("usage: l8 <compile|as|elfpack|build> ...\n"));
        return 1;
    }
    command: *i8 = argv[1];
    if (cli_streq(command, "compile")) {
        return compiler_main(argc - 1, &argv[1]);
    }
    if (cli_streq(command, "as")) {
        return assembler_main(argc - 1, &argv[1]);
    }
    if (cli_streq(command, "elfpack")) {
        return elfpack_main(argc - 1, &argv[1]);
    }
    if (cli_streq(command, "build")) {
        return build_main(argc - 1, &argv[1]);
    }
    write(2, "error: unknown subcommand\n", len("error: unknown subcommand\n"));
    1;
}
