tag compiler_internal;

import "common.l8";

import "assembler.l8";

import "direct.l8";

import "compiler.l8";

import "elfpack.l8";

import "browse.l8";

import "fmt.l8";

import "boolint.l8";

import "forlint.l8";

import "unreachable.l8";

import "unusedfields.l8";

import "unusedassign.l8";

import "bounds_model.l8";

import "bounds_terms.l8";

import "bounds_state.l8";

import "bounds_solver.l8";

import "bounds_contracts.l8";

import "bounds_effects.l8";

import "bounds_records.l8";

import "bounds_implications.l8";

import "bounds_returns.l8";

import "bounds_flow.l8";

import "bounds_driver.l8";

import "testrun.l8";

import "cram.l8";

build_usage(): int {
    raw::raw_write(2, "error: usage: l8 build [--profile|-p] <source.l8> -o <executable>\n");
    1
}

build_main(argc: int, argv: []str) noregion raises IndexOutOfBounds: int requires (argc <= len(argv)) {
    do_profile = false;
    have_s: bool = false;
    have_o: bool = false;
    if (argc < 1) return build_usage();
    source: str = argv[0];
    output: str = argv[0];
    want_o: bool = false;
    for ai in 1..argc {
        arg: str = argv[ai];
        if (want_o) {
            if (have_o) return build_usage();
            output = arg;
            have_o = true;
            want_o = false
        } else {
            if (is_profile_flag(arg)) do_profile = true else {
                if (arg == "-o") want_o = true else {
                    if (have_s) return build_usage();
                    source = arg;
                    have_s = true
                }
            }
        }
    }
    if (!have_s) return build_usage();
    if (!have_o) return build_usage();
    if (want_o) return build_usage();
    rc: int = compiler_build_direct(bytes(source));
    if (rc != 0) return rc;
    pack_assembler_exec(output);
    profile_mark("pack");
    profile_end();
    0
}

main(argc: int, argv: []str@new) noregion raises IndexOutOfBounds: int {
    if (argc < 2) {
        raw::raw_write(2, "usage: l8 <compile|unused|boolint|forlint|unreachable|unusedfields|unusedassign|as|elfpack|build|test|browse|fmt> ...\n");
        return 1
    }
    command: str = argv[1];
    args: []str = argv_span(argv, 1);
    arg_count: int = len(args);
    if (command == "compile") return compiler_main(arg_count, args);
    if (command == "unused") return compiler_unused_main(arg_count, args);
    if (command == "boolint") return compiler_boolint_main(arg_count, args);
    if (command == "forlint") return compiler_forlint_main(arg_count, args);
    if (command == "unreachable") return compiler_unreachable_main(arg_count, args);
    if (command == "unusedfields") return compiler_unusedfields_main(arg_count, args);
    if (command == "unusedassign") return compiler_unusedassign_main(arg_count, args);
    if (command == "as") return assembler_main(arg_count, args);
    if (command == "elfpack") return elfpack_main(arg_count, args);
    if (command == "build") return build_main(arg_count, args);
    if (command == "test") return compiler_test_main(arg_count, args);
    if (command == "browse") return compiler_browse_main(arg_count, args);
    if (command == "fmt") return compiler_fmt_main(arg_count, args);
    raw::raw_write(2, "error: unknown subcommand\n");
    1
}
