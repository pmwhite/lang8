tag compiler_internal;

import "common.l8";

import "assembler.l8";

import "direct.l8";

import "compiler.l8";

import "elfpack.l8";

import "browse.l8";

import "fmt.l8";

import "boolint.l8";

import "forlint.l8";

import "unreachable.l8";

import "unusedfields.l8";

import "unusedassign.l8";

build_usage(): int {
    write(2, "error: usage: l8 build [--profile|-p] <source.l8> -o <executable>\n",
        len("error: usage: l8 build [--profile|-p] <source.l8> -o <executable>\n"));
    1
}

build_main(argc: int, argv: []str) noregion: int {
    do_profile = false;
    have_s: bool = false;
    have_o: bool = false;
    if (argc < 1) return build_usage();
    source: str = argv[0];
    output: str = argv[0];
    want_o: bool = false;
    for ai in 1..argc {
        arg: str = argv[ai];
        if (want_o) {
            if (have_o) return build_usage();
            output = arg;
            have_o = true;
            want_o = false
        } else {
            if (is_profile_flag(arg)) do_profile = true else {
                if (arg == "-o") want_o = true else {
                    if (have_s) return build_usage();
                    source = arg;
                    have_s = true
                }
            }
        }
    }
    if (!have_s) return build_usage();
    if (!have_o) return build_usage();
    if (want_o) return build_usage();
    rc: int = compiler_build_direct(bytes(source));
    if (rc != 0) return rc;
    pack_assembler_exec(output);
    profile_mark("pack");
    profile_end();
    0
}

main(argc: int, argv: []str@new) noregion: int {
    if (argc < 2) {
        write(2, "usage: l8 <compile|unused|boolint|forlint|unreachable|unusedfields|unusedassign|as|elfpack|build|browse|fmt> ...\n",
            len("usage: l8 <compile|unused|boolint|forlint|unreachable|unusedfields|unusedassign|as|elfpack|build|browse|fmt> ...\n"));
        return 1
    }
    command: str = argv[1];
    if (command == "compile") return compiler_main(argc - 1, argv_span(argv, 1));
    if (command == "unused") return compiler_unused_main(argc - 1, argv_span(argv,
        1));
    if (command == "boolint") return compiler_boolint_main(argc - 1, argv_span(argv,
        1));
    if (command == "forlint") return compiler_forlint_main(argc - 1, argv_span(argv,
        1));
    if (command == "unreachable") return compiler_unreachable_main(argc - 1, argv_span(argv,
        1));
    if (command == "unusedfields") return compiler_unusedfields_main(argc - 1, argv_span(argv,
        1));
    if (command == "unusedassign") return compiler_unusedassign_main(argc - 1, argv_span(argv,
        1));
    if (command == "as") return assembler_main(argc - 1, argv_span(argv, 1));
    if (command == "elfpack") return elfpack_main(argc - 1, argv_span(argv, 1));
    if (command == "build") return build_main(argc - 1, argv_span(argv, 1));
    if (command == "browse") return compiler_browse_main(argc - 1, argv_span(argv,
        1));
    if (command == "fmt") return compiler_fmt_main(argc - 1, argv_span(argv, 1));
    write(2, "error: unknown subcommand\n", len("error: unknown subcommand\n"));
    1
}
