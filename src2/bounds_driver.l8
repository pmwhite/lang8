tag compiler_internal;

// Dependency-ordered contract inference followed by strict validation.
bounds_scc_visit(fn: *Function@immortal) noregion {
    bounds_scc_counter = bounds_scc_counter + 1;
    fn.bounds_visit = bounds_scc_counter;
    fn.bounds_lowlink = bounds_scc_counter;
    fn.bounds_on_stack = true;
    bounds_scc_stack = new BoundsTodo { fn: fn, next: bounds_scc_stack };
    edge: ?*CallEdge = fn.callees;
    while (edge != null) {
        callee: *Function = edge.callee;
        if (!callee.is_extern) {
            if (callee.bounds_visit == 0) {
                bounds_scc_visit(callee);
                if (callee.bounds_lowlink < fn.bounds_lowlink) fn.bounds_lowlink = callee.bounds_lowlink
            } else if (callee.bounds_on_stack && callee.bounds_visit < fn.bounds_lowlink) fn.bounds_lowlink = callee.bounds_visit
        }
        edge = edge.next
    }
    if (fn.bounds_lowlink != fn.bounds_visit) return;
    component: *BoundsComponent = new BoundsComponent { members: null, next: null };
    done: bool = false;
    while (!done) {
        top: ?*BoundsTodo = bounds_scc_stack;
        if (top != null) {
            bounds_scc_stack = top.next;
            member: *Function = top.fn;
            member.bounds_on_stack = false;
            done = member == fn;
            top.next = component.members;
            component.members = top
        } else done = true
    }
    last: ?*BoundsComponent = bounds_scc_last;
    if (last == null) bounds_scc_first = component else last.next = component;
    bounds_scc_last = component
}

// An uncalled entry point cannot acquire an input contract, and no call site
// can use a return summary. Its strict pass is sufficient.
bounds_entry_needs_inference(entry: *Function): bool {
    if (entry.address_taken) return true;
    caller: ?*Function = functions;
    while (caller != null) {
        edge: ?*CallEdge = caller.callees;
        while (edge != null) {
            if (edge.callee == entry) return true;
            edge = edge.next
        }
        caller = caller.next
    }
    false
}

verify_bounds_program() noregion raises Error {
    bounds_infer_effects();
    prepared: ?*Function = functions;
    while (prepared != null) {
        bounds_prepare_ensures(prepared);
        prepared = prepared.next
    }
    profile_mark("bounds effects");
    bounds_infer_mode = true;
    entry: ?*Function = find_function("main");
    infer_entry: bool = entry != null && bounds_entry_needs_inference(entry);
    bounds_scc_counter = 0;
    bounds_scc_stack = null;
    bounds_scc_first = null;
    bounds_scc_last = null;
    first: ?*Function = functions;
    while (first != null) {
        if (!first.is_extern && first.bounds_visit == 0) bounds_scc_visit(first);
        first = first.next
    }
    profile_mark("bounds call groups");
    component: ?*BoundsComponent = bounds_scc_first;
    while (component != null) {
        recursive: bool = false;
        first_member: ?*BoundsTodo = component.members;
        if (first_member != null) {
            if (first_member.next != null) recursive = true else {
                edge2: ?*CallEdge = first_member.fn.callees;
                while (edge2 != null) {
                    if (edge2.callee == first_member.fn) recursive = true;
                    edge2 = edge2.next
                }
            }
        }
        changed: bool = true;
        while (changed) {
            changed = false;
            member: ?*BoundsTodo = component.members;
            while (member != null) {
                fn: *Function = member.fn;
                if (fn != entry || infer_entry) {
                    bounds_infer_changed = false;
                    bounds_input_changed = false;
                    bounds_current_fn = fn;
                    bounds_return_accum = null;
                    bounds_return_seen = false;
                    bounds_prepare_implications(fn);
                    f: ?*BoundsState = bounds_initial(fn);
                    out: ?*BoundsState = bounds_stmt(fn.body, f);
                    bounds_finish_returns(fn, out);
                    if (bounds_input_changed || recursive && bounds_infer_changed) changed = true
                }
                member = member.next
            }
        }
        component = component.next
    }
    bounds_infer_mode = false;
    profile_mark("bounds inference");
    if (entry != null) {
        if (entry.bounds_precondition != null) error_at_file(entry.browse_file, entry.browse_pos,
            "main cannot require a precondition");
        if (entry.bounds_requirements != null || entry.bounds_nonnegative_requirements != null || entry.bounds_nonnull_requirements != null || entry.bounds_separations != null) error_at_file(entry.browse_file,
            entry.browse_pos, "main cannot require unproved array bounds at entry");
        entry_param: ?*Obj = entry.params;
        while (entry_param != null) {
            if (len(entry_param.index_for_name) != 0) error_at_file(entry_param.browse_file,
                entry_param.browse_pos, "main cannot require an index_for argument at entry");
            entry_param = entry_param.param_next
        }
    }
    unsupported: ?*Function = functions;
    while (unsupported != null) {
        if (unsupported.address_taken) {
            if (unsupported.bounds_precondition != null) error_at_file(unsupported.browse_file,
                unsupported.browse_pos, "function with precondition cannot be called indirectly");
            if (unsupported.bounds_requirements != null) error_at_file(unsupported.browse_file,
                unsupported.browse_pos, "function with bounds requirement cannot be called indirectly");
            if (unsupported.bounds_nonnegative_requirements != null) error_at_file(unsupported.browse_file,
                unsupported.browse_pos, "function with nonnegative requirement cannot be called indirectly");
            if (unsupported.bounds_nonnull_requirements != null) error_at_file(unsupported.browse_file,
                unsupported.browse_pos, "function with non-null requirement cannot be called indirectly");
            if (unsupported.bounds_separations != null) error_at_file(unsupported.browse_file,
                unsupported.browse_pos, "function with separation requirement cannot be called indirectly");
            p0: ?*Obj = unsupported.params;
            while (p0 != null) {
                if (len(p0.index_for_name) != 0) error_at_file(unsupported.browse_file,
                    unsupported.browse_pos, "function with index_for requirement cannot be called indirectly");
                p0 = p0.param_next
            }
        }
        unsupported = unsupported.next
    }
    bounds_current_fn = null;
    g: ?*Obj = globals;
    while (g != null) {
        gf: ?*BoundsState = bounds_expr(g.init, null);
        init: ?*Expr = g.init;
        if (init != null) bounds_require_type_invariant(g.ty, init, gf);
        g = g.next
    }
    fn2: ?*Function = functions;
    while (fn2 != null) {
        bounds_current_fn = fn2;
        f2: ?*BoundsState = bounds_initial(fn2);
        if (!fn2.is_extern) {
            out2: ?*BoundsState = bounds_stmt(fn2.body, f2);
            bounds_check_fallthrough_ensures(fn2, out2)
        }
        fn2 = fn2.next
    }
    profile_mark("bounds validation")
}
