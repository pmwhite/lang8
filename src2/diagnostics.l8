tag compiler_internal;

type DiagnosticSource = {
    path: []i8;
    text: []i8;
    length: int
}

type DiagnosticSpan = {
    file: int;
    pos: int;
    length: int
}

type LifetimeDiagnostics = {
    output: *StrBuf;
    count: int
}

diagnostic_source(file: int): DiagnosticSource {
    imported: ?*ImportedFile = imported_files;
    while (imported != null) {
        if (imported.id == file) return DiagnosticSource { path: imported.path, text: imported.src, length: imported.src_len };
        imported = imported.next
    }
    DiagnosticSource { path: source_path, text: source, length: source_len }
}

append_diagnostic_location(output: *StrBuf@new, file: int, pos: int) raises Error {
    input: DiagnosticSource = diagnostic_source(file);
    line: int = 1;
    column: int = 1;
    cursor: int = 0;
    while (cursor < pos && cursor < input.length && cursor < len(input.text)) {
        if (input.text[cursor] == '\n') {
            line = line + 1;
            column = 1
        } else column = column + 1;
        cursor = cursor + 1
    }
    sb_puts(output, diag_relative(input.path));
    sb_putc(output, ':');
    sb_uint(output, line);
    sb_putc(output, ':');
    sb_uint(output, column)
}

append_diagnostic_excerpt(output: *StrBuf@new, location: DiagnosticSpan) raises Error {
    input: DiagnosticSource = diagnostic_source(location.file);
    append_diagnostic_location(output, location.file, location.pos);
    sb_puts(output, """


""");
    limit: int = input.length;
    if (limit > len(input.text)) limit = len(input.text);
    if (location.pos < 0 || location.pos >= limit) return;
    start: int = location.pos;
    while (start > 0 && input.text[start - 1] != '\n') start = start - 1;
    end: int = location.pos;
    while (end < limit && input.text[end] != '\n' && input.text[end] != '\r') end = end + 1;
    for cursor in start..end sb_putc(output, input.text[cursor]);
    sb_putc(output, '\n');
    for cursor in start..location.pos {
        if (input.text[cursor] == '\t') sb_putc(output, '\t') else sb_putc(output,
            ' ')
    }
    span: int = location.length;
    if (span < 1) span = 1;
    if (span > end - location.pos) span = end - location.pos;
    for _cursor in 0..span sb_putc(output, '^');
    sb_puts(output, """


""")
}

// Wrap prose between words, preserving complete identifiers even when a name is long.
append_diagnostic_paragraph(output: *StrBuf@new, text: []i8) raises Error {
    column: int = 0;
    cursor: int = 0;
    while (cursor < len(text)) {
        while (cursor < len(text) && text[cursor] == ' ') cursor = cursor + 1;
        start: int = cursor;
        while (cursor < len(text) && text[cursor] != ' ') cursor = cursor + 1;
        width: int = cursor - start;
        if (width > 0) {
            if (column > 0) {
                if (column + 1 + width > 72) {
                    sb_putc(output, '\n');
                    column = 0
                } else {
                    sb_putc(output, ' ');
                    column = column + 1
                }
            }
            for index in start..cursor sb_putc(output, text[index]);
            column = column + width
        }
    }
    sb_puts(output, """


""")
}

// A guard example may reuse the call only when evaluating its other inputs
// cannot change the local being narrowed, and the spelling fits on one line.
nullable_guard_call_available(call: *Expr): bool {
    match call.kind {
        Funcall invocation -> {
            target: ?*Expr = invocation.target;
            if (target != null) {
                match target.kind {
                    Var _ -> { }
                    _ -> return false
                }
            }
            argument: ?*Expr = invocation.args;
            while (argument != null) {
                match argument.kind {
                    Var _ -> { }
                    Num _ -> { }
                    Null -> { }
                    _ -> return false
                }
                argument = argument.next
            }
        }
        _ -> return false
    }
    input: DiagnosticSource = diagnostic_source(call.file);
    if (call.source_start < 0 || call.source_end <= call.source_start || call.source_end > input.length || call.source_end > len(input.text)) return false;
    for cursor in call.source_start..call.source_end {
        if (input.text[cursor] == '\n' || input.text[cursor] == '\r') return false
    }
    true
}

error_nullable_argument(
    call: *Expr,
    callee: *Function,
    argument: *Expr,
    parameter: *Obj
) noregion raises Error: noreturn {
    output: *StrBuf = sb_new();
    argument_pos: int = argument.pos;
    argument_file: int = argument.file;
    argument_length: int = argument.toklen;
    if (argument.source_end > argument.source_start) {
        argument_pos = argument.source_start;
        argument_length = argument.source_end - argument.source_start
    }
    if (argument_pos == 0) {
        argument_pos = call.pos;
        argument_file = call.file
    }
    append_diagnostic_excerpt(output, DiagnosticSpan { file: argument_file, pos: argument_pos, length: argument_length });
    local: ?*Obj = opt_local_var(argument);
    paragraph: *StrBuf = sb_new();
    match argument.kind {
        Var reference -> sb_puts(paragraph, reference.name);
        _ -> sb_puts(paragraph, "This argument")
    }
    sb_puts(paragraph, " has type ");
    append_type(paragraph, argument.ty);
    sb_puts(paragraph, " and may be null. Parameter ");
    sb_puts(paragraph, parameter.name);
    sb_puts(paragraph, " of ");
    callee_name: []i8 = callee.name;
    if (len(callee_name) == 0) callee_name = "this function value";
    sb_puts(paragraph, callee_name);
    sb_puts(paragraph, " requires ");
    append_type(paragraph, parameter.ty);
    sb_puts(paragraph, ", which does not accept null:");
    append_diagnostic_paragraph(output, sb_finish(paragraph));
    append_diagnostic_excerpt(output, DiagnosticSpan { file: parameter.browse_file, pos: parameter.declared_type_pos, length: parameter.declared_type_end - parameter.declared_type_pos });
    if (local != null) {
        paragraph.used = 0;
        sb_puts(paragraph, "If a missing value means there is nothing to do, make the call only when ");
        sb_puts(paragraph, local.name);
        sb_puts(paragraph, " != null.");
        append_diagnostic_paragraph(output, sb_finish(paragraph));
        if (nullable_guard_call_available(call)) {
            input: DiagnosticSource = diagnostic_source(call.file);
            sb_puts(output, "    if (");
            sb_puts(output, local.name);
            sb_puts(output, """
 != null) {
        """);
            for cursor in call.source_start..call.source_end sb_putc(output, input.text[cursor]);
            sb_puts(output, """

    }

""")
        }
    } else append_diagnostic_paragraph(output, "If a missing value means there is nothing to do, bind the argument to a local value, check it against null, and make the call only in the non-null branch. Binding it once avoids evaluating the argument twice.");
    append_diagnostic_paragraph(output, "If a missing value is an error, handle that case before making the call.");
    paragraph.used = 0;
    sb_puts(paragraph, "If ");
    sb_puts(paragraph, callee_name);
    sb_puts(paragraph, " should decide what absence means, change its parameter ");
    sb_puts(paragraph, parameter.name);
    sb_puts(paragraph, " to ");
    append_type(paragraph, argument.ty);
    sb_puts(paragraph, " and handle null there before ");
    expected: ?*Type = parameter.ty;
    if (expected != null && is_pointer(expected)) sb_puts(paragraph, "dereferencing it.") else if (expected != null && is_fnptr(expected)) sb_puts(paragraph,
        "calling it.") else sb_puts(paragraph, "using it as a non-null value.");
    append_diagnostic_paragraph(output, sb_finish(paragraph));
    if (callee.is_extern) append_diagnostic_paragraph(output, "Only change an external declaration if the external function really accepts null.");
    if (len(callee.name) == 0) append_diagnostic_paragraph(output, "For a function value, update its declared signature and the functions assigned to it consistently.");
    raise Error { diagnostic: Diagnostic.Document { text: sb_finish(output) } }
}

error_call_argument_type(
    call: *Expr,
    callee: *Function,
    argument: *Expr,
    parameter: *Obj
) noregion raises Error: noreturn {
    have: ?*Type = argument.ty;
    want: ?*Type = parameter.ty;
    if (have != null && want != null && is_optional(have) && !is_optional(want)) {
        if (types_equal(unwrap_optional(have), want)) error_nullable_argument(call,
            callee, argument, parameter)
    }
    callee_name: []i8 = callee.name;
    if (len(callee_name) == 0) error_have_expr_want(argument_type_mismatch_message("function value",
        parameter.name), argument, want);
    error_have_expr_want_at(call.file, call.pos, argument_type_mismatch_message(callee_name,
        parameter.name), argument, want)
}

// A propagated cause points to a function that already needed noregion, so the
// recorded explanation chains terminate even when the program's call graph cycles.
noregion_origin(fn: *Function): *Function@fn {
    origin: *Function = fn;
    while (origin.noregion_cause != null) {
        cause: *NoregionCause = origin.noregion_cause;
        match cause.reason {
            Call call -> {
                callee: ?*Function = find_function(call.callee);
                if (callee == null) return origin;
                origin = callee
            }
            _ -> return origin
        }
    }
    origin
}

missing_noregion(fn: *Function): bool {
    !fn.is_extern && fn.test_id < 0 && fn.need_imm_heap != 0 && fn.decl_imm_heap == 0
}

primary_noregion_diagnostic(fn: *Function): bool {
    root: *Function = noregion_origin(fn);
    if (missing_noregion(root)) return fn == root;
    earlier: ?*Function = functions;
    while (earlier != null && earlier != fn) {
        if (missing_noregion(earlier) && noregion_origin(earlier) == root) return false;
        earlier = earlier.next
    }
    true
}

append_noregion_callers(output: *StrBuf@new, root: *Function, primary: *Function) raises Error {
    caller: ?*Function = functions;
    while (caller != null) {
        if (caller != primary && missing_noregion(caller) && noregion_origin(caller) == root) {
            cause: ?*NoregionCause = caller.noregion_cause;
            if (cause != null) {
                match cause.reason {
                    Call call -> {
                        paragraph: *StrBuf = sb_new();
                        sb_puts(paragraph, caller.name);
                        sb_puts(paragraph, " calls ");
                        sb_puts(paragraph, call.callee);
                        sb_puts(paragraph, ", so choosing noregion also requires it on ");
                        sb_puts(paragraph, caller.name);
                        sb_putc(paragraph, '.');
                        append_diagnostic_paragraph(output, sb_finish(paragraph))
                    }
                    _ -> { }
                }
            }
        }
        caller = caller.next
    }
}

append_noregion_diagnostic(output: *StrBuf@new, fn: *Function) raises Error {
    cause: ?*NoregionCause = fn.noregion_cause;
    if (cause != null) append_diagnostic_excerpt(output, DiagnosticSpan { file: cause.file, pos: cause.pos, length: cause.span }) else {
        append_diagnostic_location(output, fn.browse_file, fn.browse_pos);
        sb_puts(output, """


""")
    }
    paragraph: *StrBuf = sb_new();
    sb_puts(paragraph, fn.name);
    if (cause != null) {
        match cause.reason {
            GlobalStore global -> {
                sb_puts(paragraph, " stores this allocation in global ");
                sb_puts(paragraph, global.name);
                sb_puts(paragraph, ". If ");
                sb_puts(paragraph, fn.name);
                sb_puts(paragraph, " runs inside a region, ");
                sb_puts(paragraph, global.name);
                sb_puts(paragraph, " could retain a pointer to memory freed when that region ends.")
            }
            Store -> sb_puts(paragraph, " stores this allocation in storage that can outlive a region. If the allocation is made inside a region, that storage could retain a pointer to memory freed when the region ends.");
            Payload -> sb_puts(paragraph, " puts this allocation in an exception payload. An exception can outlive the region where it was raised, leaving its payload pointing to freed memory.");
            Argument argument -> {
                sb_puts(paragraph, " passes this allocation to parameter ");
                sb_puts(paragraph, argument.parameter);
                sb_puts(paragraph, " of ");
                sb_puts(paragraph, argument.callee);
                sb_puts(paragraph, ", whose @immortal contract allows it to retain the value after the call. Memory allocated inside a region is freed when that region ends.")
            }
            Call call -> {
                sb_puts(paragraph, " calls ");
                sb_puts(paragraph, call.callee);
                sb_puts(paragraph, ", which requires noregion and cannot run inside a region.")
            }
        }
    } else sb_puts(paragraph, " requires noregion because it retains memory allocated in the caller's region.");
    append_diagnostic_paragraph(output, sb_finish(paragraph));
    paragraph.used = 0;
    if (cause != null) {
        match cause.reason {
            Call _ -> sb_puts(paragraph, "If this restriction is intended, declare ");
            _ -> sb_puts(paragraph, "If this value should be retained, declare ")
        }
    } else sb_puts(paragraph, "If this value should be retained, declare ");
    sb_puts(paragraph, fn.name);
    sb_puts(paragraph, " as noregion. Its callers also need noregion. This prevents those functions from being called inside a region.");
    append_diagnostic_paragraph(output, sb_finish(paragraph));
    if (cause != null) {
        match cause.reason {
            Call _ -> append_diagnostic_paragraph(output, "If this function should remain usable inside a region, call a function that does not require noregion instead. For a callee you own, keeping its temporary allocations local may remove that restriction.");
            Payload -> append_diagnostic_paragraph(output, "If the value is only needed temporarily, keep it local instead of putting it in the exception payload, and use it before its region ends.");
            Argument _ -> append_diagnostic_paragraph(output, "If the value is only needed during the call, use a parameter contract that permits borrowing it for the call. Only change a callee's @immortal contract if its implementation does not retain the value.");
            _ -> append_diagnostic_paragraph(output, "If the allocation is only needed temporarily, keep it local instead of storing it in longer-lived storage, and use it before its region ends.")
        }
    }
    append_noregion_callers(output, noregion_origin(fn), fn)
}
