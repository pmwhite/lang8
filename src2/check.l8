tag compiler_internal;

// Lifetimes, typing, and post-parse checks (unused, raises, definite assignment).
life_reset_imm() {
    life_arrays.n = 3;
    life_arrays.parent[0] = 0 - 1;
    life_arrays.kind[0] = 0;
    life_arrays.parent[1] = 0 - 1;
    life_arrays.kind[1] = 2;
    life_arrays.parent[2] = 0 - 1;
    life_arrays.kind[2] = 1;
    life_heap = LIFE_IMM;
    life_cur = LIFE_SELF;
    life_region_tc = 1;
    life_arrays.depth_frames[1] = LIFE_SELF;
    life_arrays.edge_n = 0
}

life_alloc_frame(parent: int, kind: int) raises Error: int {
    if (life_arrays.n >= len(life_arrays.parent)) error("too many lifetime frames");
    id: int = life_arrays.n;
    life_arrays.parent[id] = parent;
    life_arrays.kind[id] = kind;
    life_arrays.n = life_arrays.n + 1;
    id
}

life_add_edge(longer: int, shorter: int) {
    if (life_arrays.edge_n >= len(life_arrays.edge_long)) return;
    life_arrays.edge_long[life_arrays.edge_n] = longer;
    life_arrays.edge_short[life_arrays.edge_n] = shorter;
    life_arrays.edge_n = life_arrays.edge_n + 1
}

life_is_param(id: int): bool {
    id >= 3 && id < life_arrays.n && life_arrays.kind[id] == LIFE_KIND_PARAM
}

life_is_region(id: int): bool {
    id >= 3 && id < life_arrays.n && life_arrays.kind[id] == 2
}

life_parent_reaches(from: int, anc: int): bool {
    x: int = from;
    steps: int = 0;
    while (x >= 0 && x < life_arrays.n && steps < 64) {
        if (x == anc) return true;
        x = life_arrays.parent[x];
        steps = steps + 1
    }
    false
}

life_outlives_lim(a: int, b: int, depth: int): bool {
    if (depth > 32) return false;
    if (a == b) return true;
    if (a == LIFE_IMM) return true;
    if (b == LIFE_IMM) {
        if (a == LIFE_HEAPTOP) {
            fn: ?*Function = current_fn;
            if (fn != null) {
                fu: *Function = fn;
                if (fu.need_imm_heap != 0) return true
            }
        }
        return false
    }
    if (life_parent_reaches(b, a)) return true;
    if (b == LIFE_SELF) {
        if (a == LIFE_HEAPTOP) return true;
        if (life_is_param(a)) return true;
        return false
    }
    i: int = 0;
    while (i < life_arrays.edge_n) {
        if (life_arrays.edge_long[i] == a) {
            if (life_outlives_lim(life_arrays.edge_short[i], b, depth + 1)) return true
        }
        i = i + 1
    }
    if (a == LIFE_HEAPTOP && life_outlives_lim(LIFE_SELF, b, depth + 1)) return true;
    if (life_is_param(a) && life_outlives_lim(LIFE_SELF, b, depth + 1)) return true;
    false
}

life_outlives(a: int, b: int): bool {
    life_outlives_lim(a, b, 0)
}

obj_storage_life(o: *Obj): int {
    if (!o.is_local) return LIFE_IMM;
    d: int = o.storage_life;
    if (d <= 1) return LIFE_SELF;
    if (d < len(life_arrays.depth_frames)) {
        f: int = life_arrays.depth_frames[d];
        if (f != 0) return f
    }
    LIFE_SELF
}

find_fn_param(fn: *Function, name: []i8): ?*Obj@fn {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (streq(p.name, name)) return p;
        p = p.param_next
    }
    null
}

life_bound_immortal(b: []i8): bool {
    streq(b, "immortal")
}

life_is_self_bound(p: *Obj): bool {
    if (life_bound_immortal(p.life_bound)) return false;
    if (streq(p.life_bound, "new")) return false;
    len(p.life_bound) == 0 || streq(p.life_bound, p.name)
}

resolve_fn_bounds(fn: *Function) raises Error {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (type_is_ref(p.ty) || type_has_pointers(p.ty)) p.life = life_alloc_frame(0 - 1,
            LIFE_KIND_PARAM) else p.life = LIFE_IMM;
        p = p.param_next
    }
    p = fn.params;
    while (p != null) {
        b: []i8 = p.life_bound;
        if (streq(b, "new")) life_add_edge(p.life, LIFE_HEAPTOP) else if (len(b) != 0 && !life_bound_immortal(b) && !streq(b,
            p.name)) {
            q: ?*Obj = find_fn_param(fn, b);
            if (q == null) error("unknown lifetime bound");
            qu: *Obj = q;
            life_add_edge(p.life, qu.life)
        }
        p = p.param_next
    }
    if (len(fn.ret_bound) == 0 || life_bound_immortal(fn.ret_bound)) fn.ret_life = LIFE_IMM else if (streq(fn.ret_bound,
        "new")) fn.ret_life = LIFE_HEAPTOP else {
        r: ?*Obj = find_fn_param(fn, fn.ret_bound);
        if (r == null) error("unknown lifetime bound");
        fn.ret_life = r.life
    }
}

life_init_fn(fn: *Function) raises Error {
    life_arrays.n = 3;
    life_arrays.parent[0] = 0 - 1;
    life_arrays.kind[0] = 0;
    life_arrays.parent[1] = 0 - 1;
    life_arrays.kind[1] = 2;
    life_arrays.parent[2] = 0 - 1;
    life_arrays.kind[2] = 1;
    life_heap = LIFE_HEAPTOP;
    life_cur = LIFE_SELF;
    life_region_tc = 1;
    life_arrays.depth_frames[1] = LIFE_SELF;
    life_arrays.edge_n = 0;
    resolve_fn_bounds(fn)
}

life_enter_region() raises Error: int {
    f: int = life_alloc_frame(life_cur, 2);
    life_cur = f;
    life_heap = f;
    life_region_tc = life_region_tc + 1;
    if (life_region_tc >= 0 && life_region_tc < LIFE_MAX) life_arrays.depth_frames[life_region_tc] = f;
    f
}

life_leave_region(old_cur: int, old_heap: int) {
    life_cur = old_cur;
    life_heap = old_heap;
    life_region_tc = life_region_tc - 1
}

var_view_ty(var: ?*Obj): ?*Type@var {
    f: ?*NarrowFrame = narrow_top;
    while (f != null) {
        if (f.var == var) return f.ty;
        f = f.next
    }
    if (var != null) return var.ty;
    null
}

narrow_push(var: ?*Obj@new, ty: ?*Type@new) noregion {
    f: *NarrowFrame = new NarrowFrame {
        var: var,
        ty: ty,
        next: narrow_top,
        path: null,
        barrier: false,
        kill: false
    };
    narrow_top = f
}

narrow_push_kill(var: ?*Obj@new, ty: ?*Type@new) noregion {
    f: *NarrowFrame = new NarrowFrame {
        var: var,
        ty: ty,
        next: narrow_top,
        path: null,
        barrier: false,
        kill: true
    };
    narrow_top = f
}

narrow_push_path(path: *Expr@new, ty: ?*Type@new) noregion {
    f: *NarrowFrame = new NarrowFrame {
        var: null,
        ty: ty,
        next: narrow_top,
        path: path,
        barrier: false,
        kill: false
    };
    narrow_top = f
}

// No field path keeps its narrowing past here (logged, as a kill is, so
// that it holds after the branch it is in).
narrow_barrier() noregion {
    f: *NarrowFrame = new NarrowFrame {
        var: null,
        ty: null,
        next: narrow_top,
        path: null,
        barrier: true,
        kill: false
    };
    narrow_top = f;
    kill_note(null)
}

// ---- field paths (DESIGN: as variables are narrowed) ----
// A path: fields read from a local (h.p, h.a.b), its root that local.
path_root(n: *Expr): ?*Obj {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return null;
            if (!v.is_local || v.is_func || is_addr_taken(v)) return null;
            v
        }
        MemberAccess k -> path_root(k.lhs);
        _ -> null
    }
}

path_equal(a: *Expr, b: *Expr): bool {
    match a.kind {
        Var ka -> {
            match b.kind {
                Var kb -> ka.var != null && ka.var == kb.var;
                _ -> false
            }
        }
        MemberAccess ka -> {
            match b.kind {
                MemberAccess kb -> ka.member != null && ka.member == kb.member && path_equal(ka.lhs,
                    kb.lhs);
                _ -> false
            }
        }
        _ -> false
    }
}

// cond as `path != null` (ne) or `path == null`, path an optional field
// path: the path narrowed.
narrow_push_path_test(cond: ?*Expr, ne: bool) noregion raises Error {
    if (cond == null) return;
    match cond.kind {
        Binary k -> {
            tested: bool = false;
            match k.op {
                Ne -> tested = ne;
                Eq -> tested = !ne;
                _ -> { }
            }
            if (!tested) return;
            if (is_null_expr(k.rhs)) narrow_push_opt_path(k.lhs) else if (is_null_expr(k.lhs)) narrow_push_opt_path(k.rhs)
        }
        _ -> { }
    }
}

narrow_push_opt_path(n: *Expr@new) noregion raises Error {
    match n.kind {
        MemberAccess k -> {
            m: ?*Member = k.member;
            if (m == null || path_root(n) == null) return;
            t: ?*Type = decay(m.ty);
            if (t != null && is_optional(t)) narrow_push_path(n, unwrap_optional(t))
        }
        _ -> { }
    }
}

// Field path n's narrowed type, if a test still holds for it: none past a
// barrier, or a kill of its root.
path_view_ty(n: *Expr): ?*Type {
    root: ?*Obj = path_root(n);
    if (root == null) return null;
    f: ?*NarrowFrame = narrow_top;
    while (f != null) {
        if (f.barrier) return null;
        if (f.kill && f.var == root) return null;
        fp: ?*Expr = f.path;
        if (fp != null) {
            if (path_equal(fp, n)) return f.ty
        }
        f = f.next
    }
    null
}

// Whether n, just typed, may write memory a field path reads: a call, a
// store not into a plain local, or an address taken of other than one.
writes_memory(n: *Expr): bool {
    match n.kind {
        Funcall _ -> true;
        Assign k -> {
            match k.lhs.kind {
                Var v -> {
                    o: ?*Obj = v.var;
                    o == null || !o.is_local
                }
                _ -> true
            }
        }
        Addr k -> {
            match k.lhs.kind {
                Var _ -> false;
                _ -> true
            }
        }
        New _ -> false;
        _ -> false
    }
}

narrow_reset(saved: ?*NarrowFrame@immortal) {
    narrow_top = saved
}

kill_var_facts(o: ?*Obj@new) noregion {
    if (o == null) return;
    if (o.ty != null) {
        narrow_push_kill(o, o.ty);
        kill_note(o)
    }
}

// Every fact killed (a variable assigned, or its address taken), newest
// first, numbered. A branch's frames are let go when it ends, its kills
// with them; kill_again makes those of a branch that may fall through
// hold after the whole if, as its assignments do.
type KillEntry = {
    var: ?*Obj;
    seq: int;
    next: ?*KillEntry
}

kill_log: ?*KillEntry = null;

kill_n: int = 0;

narrow_push_barrier_again() noregion {
    f: *NarrowFrame = new NarrowFrame {
        var: null,
        ty: null,
        next: narrow_top,
        path: null,
        barrier: true,
        kill: false
    };
    narrow_top = f
}

kill_note(var: ?*Obj@new) noregion {
    e: *KillEntry = new KillEntry { var: var, seq: kill_n, next: kill_log };
    kill_log = e;
    kill_n = kill_n + 1
}

// Before a loop is checked: a local it assigns, or takes the address of,
// keeps no narrowing from before it, since a later turn may come after
// the assignment.
kill_assigned_stmts(s: ?*Stmt) noregion {
    n: ?*Stmt = s;
    while (n != null) {
        kill_assigned_stmt(n);
        n = n.next
    }
}

kill_assigned_stmt(s: *Stmt) noregion {
    match s.kind {
        Return k -> kill_assigned_expr(k.lhs);
        If k -> {
            kill_assigned_expr(k.cond);
            kill_assigned_stmt(k.then);
            els: ?*Stmt = k.els;
            if (els != null) kill_assigned_stmt(els)
        }
        While k -> {
            kill_assigned_expr(k.cond);
            kill_assigned_stmt(k.body)
        }
        For k -> {
            kill_assigned_expr(k.iter);
            kill_assigned_expr(k.hi);
            kill_assigned_stmt(k.body)
        }
        Block k -> kill_assigned_stmts(k.body);
        ExprStmt k -> kill_assigned_expr(k.lhs);
        Decl k -> kill_assigned_expr(k.init);
        Match k -> {
            kill_assigned_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                kill_assigned_stmt(arm.body);
                arm = arm.next
            }
        }
        Raise k -> kill_assigned_inits(k.inits);
        Try k -> {
            kill_assigned_stmt(k.body);
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                kill_assigned_stmt(arm.body);
                arm = arm.next
            }
        }
        Region k -> kill_assigned_stmt(k.body);
        Expect _ -> { }
    }
}

kill_assigned_inits(inits: ?*FieldInit) noregion {
    f: ?*FieldInit = inits;
    while (f != null) {
        kill_assigned_expr(f.lhs);
        f = f.next
    }
}

kill_assigned_list(e: ?*Expr) noregion {
    a: ?*Expr = e;
    while (a != null) {
        kill_assigned_expr(a);
        a = a.next
    }
}

kill_assigned_expr(e: ?*Expr) noregion {
    if (e == null) return;
    match e.kind {
        Assign k -> {
            match k.lhs.kind {
                Var v -> kill_var_facts(v.var);
                _ -> kill_assigned_expr(k.lhs)
            }
            kill_assigned_expr(k.rhs)
        }
        Addr k -> {
            match k.lhs.kind {
                Var v -> kill_var_facts(v.var);
                _ -> kill_assigned_expr(k.lhs)
            }
        }
        Binary k -> {
            kill_assigned_expr(k.lhs);
            kill_assigned_expr(k.rhs)
        }
        LogAnd k -> {
            kill_assigned_expr(k.lhs);
            kill_assigned_expr(k.rhs)
        }
        LogOr k -> {
            kill_assigned_expr(k.lhs);
            kill_assigned_expr(k.rhs)
        }
        OrElse k -> {
            kill_assigned_expr(k.lhs);
            kill_assigned_expr(k.rhs)
        }
        Index k -> {
            kill_assigned_expr(k.lhs);
            kill_assigned_expr(k.idx)
        }
        Deref k -> kill_assigned_expr(k.lhs);
        Not k -> kill_assigned_expr(k.lhs);
        Neg k -> kill_assigned_expr(k.lhs);
        BitNot k -> kill_assigned_expr(k.lhs);
        As k -> kill_assigned_expr(k.lhs);
        Trunc k -> kill_assigned_expr(k.lhs);
        MemberAccess k -> kill_assigned_expr(k.lhs);
        Funcall k -> {
            kill_assigned_list(k.args);
            kill_assigned_expr(k.target)
        }
        New k -> {
            kill_assigned_expr(k.lhs);
            kill_assigned_expr(k.fill);
            kill_assigned_inits(k.inits)
        }
        StructLit k -> kill_assigned_inits(k.inits);
        VariantLit k -> kill_assigned_inits(k.inits);
        If k -> {
            kill_assigned_expr(k.cond);
            kill_assigned_expr(k.then);
            kill_assigned_expr(k.els)
        }
        Match k -> {
            kill_assigned_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                kill_assigned_stmt(arm.body);
                arm = arm.next
            }
        }
        Block k -> kill_assigned_stmts(k.body);
        Sizeof k -> kill_assigned_expr(k.e);
        ArrayLit k -> kill_assigned_list(k.elems);
        _ -> { }
    }
}

// var just set to rhs: narrowed, if var is optional and rhs cannot be null
// (until it is assigned again, or the branch it is in ends).
narrow_after_store(var: ?*Obj@new, rhs: *Expr) noregion raises Error {
    if (var == null) return;
    if (!var.is_local || var.is_func || is_addr_taken(var)) return;
    vt: ?*Type = decay(var.ty);
    rt: ?*Type = decay(rhs.ty);
    if (vt == null || rt == null || !is_optional(vt) || is_optional(rt) || is_null_value_expr(rhs)) return;
    narrow_push(var, unwrap_optional(vt))
}

// The kills numbered lo up to hi made again.
kill_again(lo: int, hi: int) noregion {
    e: ?*KillEntry = kill_log;
    while (e != null && e.seq >= lo) {
        v: ?*Obj = e.var;
        if (e.seq < hi) {
            if (v != null) narrow_push_kill(v, v.ty) else narrow_push_barrier_again()
        }
        e = e.next
    }
}

is_stack_object(n: *Expr): bool {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return false;
            v.is_local && !v.is_func
        }
        MemberAccess k -> {
            lt: ?*Type = k.lhs.ty;
            if (lt != null && (is_pointer(lt) || is_opt_pointer(lt) || is_slice(lt) || is_opt_slice(lt))) return false;
            is_stack_object(k.lhs)
        }
        Index k -> {
            lt2: ?*Type = k.lhs.ty;
            if (lt2 != null && (is_slice(lt2) || is_str(lt2))) return false;
            is_stack_object(k.lhs)
        }
        _ -> false
    }
}

is_stack_addr_stmt(s: ?*Stmt): bool {
    if (s == null) return false;
    match s.kind {
        Return k -> is_stack_addr(k.lhs);
        ExprStmt k -> is_stack_addr(k.lhs);
        Block k -> is_stack_addr_stmt(last_stmt(k.body));
        If k -> is_stack_addr_stmt(k.then) || is_stack_addr_stmt(k.els);
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (is_stack_addr_stmt(arm.body)) return true;
                arm = arm.next
            }
            false
        }
        Try k -> {
            if (is_stack_addr_stmt(k.body)) return true;
            a: ?*CatchArm = k.arms;
            while (a != null) {
                if (is_stack_addr_stmt(a.body)) return true;
                a = a.next
            }
            false
        }
        Region k -> is_stack_addr_stmt(k.body);
        _ -> false
    }
}

is_stack_addr(n: ?*Expr): bool {
    if (n == null) return false;
    match n.kind {
        Addr k -> is_stack_object(k.lhs);
        As k -> is_stack_addr(k.lhs);
        Trunc k -> is_stack_addr(k.lhs);
        If k -> is_stack_addr(k.then) || is_stack_addr(k.els);
        OrElse k -> is_stack_addr(k.lhs) || is_stack_addr(k.rhs);
        Block k -> is_stack_addr_stmt(last_stmt(k.body));
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (is_stack_addr_stmt(arm.body)) return true;
                arm = arm.next
            }
            false
        }
        _ -> false
    }
}

is_tainted_obj(o: ?*Obj): bool {
    if (o == null) return false;
    f: ?*InitFrame = taint_top;
    while (f != null) {
        if (f.var == o) return true;
        f = f.next
    }
    false
}

mark_tainted(o: *Obj@immortal) noregion {
    if (is_tainted_obj(o)) return;
    taint_top = new InitFrame { var: o, next: taint_top }
}

is_addr_taken(o: ?*Obj): bool {
    if (o == null) return false;
    f: ?*InitFrame = addr_top;
    while (f != null) {
        if (f.var == o) return true;
        f = f.next
    }
    false
}

mark_addr_taken(o: *Obj@immortal) noregion {
    if (is_addr_taken(o)) return;
    addr_top = new InitFrame { var: o, next: addr_top };
    kill_var_facts(o)
}

taint_result_ty(n: *Expr): ?*Type@n {
    if (n.ty != null) return n.ty;
    match n.kind {
        MemberAccess k -> {
            mo: ?*Member = k.member;
            if (mo == null) return null;
            mo.ty
        }
        _ -> null
    }
}

taint_from_inner(n: *Expr, inner: ?*Expr): bool {
    if (!type_has_pointers(taint_result_ty(n))) return false;
    is_tainted_expr(inner)
}

is_tainted_expr(n: ?*Expr): bool {
    if (n == null) return false;
    if (is_stack_addr(n)) return true;
    match n.kind {
        Var k -> is_tainted_obj(k.var);
        StructLit k -> field_inits_tainted(k.inits);
        New k -> field_inits_tainted(k.inits);
        VariantLit k -> field_inits_tainted(k.inits);
        ArrayLit k -> {
            a: ?*Expr = k.elems;
            while (a != null) {
                if (is_tainted_expr(a)) return true;
                a = a.next
            }
            false
        }
        As k -> is_tainted_expr(k.lhs);
        If k -> is_tainted_expr(k.then) || is_tainted_expr(k.els);
        OrElse k -> is_tainted_expr(k.lhs) || is_tainted_expr(k.rhs);
        Block k -> is_stack_addr_stmt(last_stmt(k.body));
        Match _m -> is_stack_addr(n);
        MemberAccess k -> taint_from_inner(n, k.lhs);
        Deref k -> taint_from_inner(n, k.lhs);
        Index k -> taint_from_inner(n, k.lhs);
        _ -> false
    }
}

field_inits_tainted(inits: ?*FieldInit): bool {
    a: ?*FieldInit = inits;
    while (a != null) {
        if (is_tainted_expr(a.lhs)) return true;
        a = a.next
    }
    false
}

io_allows_stack(name: []i8): bool {
    streq(name, "write") || streq(name, "read")
}

life_meet(a: int, b: int) raises Error: int {
    if (life_outlives(a, b)) return b;
    if (life_outlives(b, a)) return a;
    fn: ?*Function = current_fn;
    if (fn != null) {
        raw::raw_write(2, "incomparable lifetimes in ");
        raw::raw_write_bytes(2, fn.name);
        raw::raw_write_bytes_n(2, "\n", 1)
    }
    error("incomparable lifetimes")
}

object_storage_life(n: *Expr) raises Error: int {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return LIFE_IMM;
            obj_storage_life(v)
        }
        Deref k -> expr_life(k.lhs);
        Index k -> {
            lt: ?*Type = k.lhs.ty;
            if (lt != null && (is_slice(lt) || is_str(lt))) return expr_life(k.lhs);
            object_storage_life(k.lhs)
        }
        MemberAccess k -> {
            lt2: ?*Type = decay(k.lhs.ty);
            if (lt2 != null && (is_pointer(lt2) || is_opt_pointer(lt2) || is_slice(lt2) || is_opt_slice(lt2))) return expr_life(k.lhs);
            object_storage_life(k.lhs)
        }
        _ -> LIFE_SELF
    }
}

field_inits_life(inits: ?*FieldInit) raises Error: int {
    a: ?*FieldInit = inits;
    l: int = LIFE_IMM;
    saw: bool = false;
    while (a != null) {
        if (a.lhs != null) {
            fl: int = expr_life(a.lhs);
            if (!saw) l = fl else if (life_outlives(l, fl)) l = fl else if (!life_outlives(fl,
                l)) l = LIFE_SELF;
            saw = true
        }
        a = a.next
    }
    l
}

stmt_result_life(s: ?*Stmt) raises Error: int {
    if (s == null) return LIFE_IMM;
    match s.kind {
        ExprStmt k -> expr_life(k.lhs);
        Block k -> stmt_result_life(last_stmt(k.body));
        If k -> {
            els: ?*Stmt = k.els;
            if (els == null) return stmt_result_life(k.then);
            life_meet(stmt_result_life(k.then), stmt_result_life(els))
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            l: int = LIFE_IMM;
            saw: bool = false;
            while (arm != null) {
                al: int = stmt_result_life(arm.body);
                if (!saw) l = al else l = life_meet(l, al);
                saw = true;
                arm = arm.next
            }
            l
        }
        Try k -> {
            l2: int = stmt_result_life(k.body);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                l2 = life_meet(l2, stmt_result_life(a.body));
                a = a.next
            }
            l2
        }
        Region k -> stmt_result_life(k.body);
        _ -> LIFE_IMM
    }
}

instantiate_bound(fn: *Function, bound: []i8, args: ?*Expr) raises Error: int {
    if (len(bound) == 0 || life_bound_immortal(bound)) return LIFE_IMM;
    if (streq(bound, "new")) return life_heap;
    p: ?*Obj = fn.params;
    a: ?*Expr = args;
    while (p != null && a != null) {
        if (streq(p.name, bound)) return expr_life(a);
        p = p.param_next;
        a = a.next
    }
    error("unknown lifetime bound")
}

expr_life(n: ?*Expr) raises Error: int {
    if (n == null) return LIFE_IMM;
    match n.kind {
        Addr k -> object_storage_life(k.lhs);
        New _k -> life_heap;
        ArrayLit _k -> life_heap;
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return LIFE_IMM;
            if (!v.is_local) return LIFE_IMM;
            v.life
        }
        Deref k -> expr_life(k.lhs);
        MemberAccess k -> expr_life(k.lhs);
        Index k -> expr_life(k.lhs);
        Assign k -> expr_life(k.rhs);
        As k -> expr_life(k.lhs);
        Trunc k -> expr_life(k.lhs);
        If k -> life_meet(expr_life(k.then), expr_life(k.els));
        OrElse k -> life_meet(expr_life(k.lhs), expr_life(k.rhs));
        Block k -> stmt_result_life(last_stmt(k.body));
        Match k -> {
            arm: ?*MatchArm = k.arms;
            l: int = LIFE_IMM;
            saw: bool = false;
            while (arm != null) {
                al: int = stmt_result_life(arm.body);
                if (!saw) l = al else l = life_meet(l, al);
                saw = true;
                arm = arm.next
            }
            l
        }
        Funcall k -> {
            if (io_allows_stack(k.funcname)) return LIFE_IMM;
            if (streq(k.funcname, "len") || streq(k.funcname, "memcpy")) return LIFE_IMM;
            if (streq(k.funcname, "l8_cstr") || streq(k.funcname, "l8_bytes")) return life_heap;
            fno: ?*Function = k.fn;
            if (fno == null) fno = find_function(k.funcname);
            if (fno == null) return LIFE_IMM;
            instantiate_bound(fno, fno.ret_bound, k.args)
        }
        StructLit k -> field_inits_life(k.inits);
        VariantLit k -> field_inits_life(k.inits);
        Null -> LIFE_IMM;
        _ -> LIFE_IMM
    }
}

dest_life(n: *Expr) raises Error: int {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return LIFE_IMM;
            obj_storage_life(v)
        }
        Deref k -> expr_life(k.lhs);
        MemberAccess k -> {
            lt: ?*Type = decay(k.lhs.ty);
            if (lt != null && (is_pointer(lt) || is_opt_pointer(lt) || is_slice(lt) || is_opt_slice(lt))) return expr_life(k.lhs);
            dest_life(k.lhs)
        }
        Index k -> {
            lt2: ?*Type = k.lhs.ty;
            if (lt2 != null && (is_slice(lt2) || is_str(lt2))) return expr_life(k.lhs);
            dest_life(k.lhs)
        }
        _ -> LIFE_SELF
    }
}

escape_error(n: ?*Expr) noregion raises Error {
    fn: ?*Function = current_fn;
    if (is_tainted_expr(n) || is_stack_addr(n)) {
        if (fn != null) {
            sb: *StrBuf = sb_new();
            sb_puts(sb, "address of local cannot escape in ");
            sb_puts(sb, fn.name);
            error(sb_finish(sb))
        }
        error("address of local cannot escape")
    }
    if (fn != null) {
        sb2: *StrBuf = sb_new();
        sb_puts(sb2, "region pointer cannot escape in ");
        sb_puts(sb2, fn.name);
        error(sb_finish(sb2))
    }
    error("region pointer cannot escape")
}

note_imm_heap(value: *Expr, reason: NoregionReason@immortal) noregion {
    fn: ?*Function = current_fn;
    if (fn == null) return;
    fn.need_imm_heap = 1;
    if (fn.noregion_cause != null) return;
    pos: int = value.pos;
    file: int = value.file;
    if (pos == 0) {
        pos = diag_expr_pos;
        file = diag_expr_file
    }
    if (pos == 0) {
        pos = diag_stmt_pos;
        file = diag_stmt_file
    }
    fn.noregion_cause = new NoregionCause {
        file: file,
        pos: pos,
        span: value.toklen,
        reason: reason
    }
}

is_current_param(o: ?*Obj): bool {
    fn: ?*Function = current_fn;
    if (o == null || fn == null) return false;
    p: ?*Obj = fn.params;
    while (p != null) {
        if (p == o) return true;
        p = p.param_next
    }
    false
}

find_param_by_life(id: int): ?*Obj {
    fn: ?*Function = current_fn;
    if (fn == null) return null;
    if (!life_is_param(id)) return null;
    p: ?*Obj = fn.params;
    while (p != null) {
        if (p.life == id) return p;
        p = p.param_next
    }
    null
}

constrain_param_to_dest(p: *Obj, dest: int) {
    if (dest == LIFE_IMM) {
        p.bound_need_imm = true;
        return
    }
    if (dest == LIFE_HEAPTOP) {
        p.bound_need_new = true;
        return
    }
    q: ?*Obj = find_param_by_life(dest);
    if (q != null && q != p) {
        if (p.bound_named == null) p.bound_named = q
    }
}

note_params_in_inits(inits: ?*FieldInit, dest: int) raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        note_params_in_expr(a.lhs, dest);
        a = a.next
    }
}

note_params_in_stmt(s: ?*Stmt, dest: int) raises Error {
    if (s == null) return;
    match s.kind {
        ExprStmt k -> note_params_in_expr(k.lhs, dest);
        Block k -> note_params_in_stmt(last_stmt(k.body), dest);
        If k -> {
            note_params_in_stmt(k.then, dest);
            note_params_in_stmt(k.els, dest)
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                note_params_in_stmt(arm.body, dest);
                arm = arm.next
            }
        }
        Try k -> {
            note_params_in_stmt(k.body, dest);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                note_params_in_stmt(a.body, dest);
                a = a.next
            }
        }
        Region k -> note_params_in_stmt(k.body, dest);
        Return k -> note_params_in_expr(k.lhs, dest);
        _ -> { }
    }
}

// Taking an address borrows storage even when the stored value is scalar.
note_params_in_address(n: *Expr, dest: int) raises Error {
    match n.kind {
        Deref operand -> note_params_in_expr(operand.lhs, dest);
        MemberAccess member -> {
            if (type_is_ref(member.lhs.ty)) note_params_in_expr(member.lhs, dest) else note_params_in_address(member.lhs,
                dest)
        }
        Index index -> {
            if (type_is_ref(index.lhs.ty)) note_params_in_expr(index.lhs, dest) else note_params_in_address(index.lhs,
                dest)
        }
        _ -> { }
    }
}

note_params_in_expr(n: ?*Expr, dest: int) raises Error {
    if (n == null || !type_has_pointers(n.ty)) return;
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return;
            if (is_current_param(v)) {
                constrain_param_to_dest(v, dest);
                return
            }
            q: ?*Obj = find_param_by_life(v.life);
            if (q != null) constrain_param_to_dest(q, dest)
        }
        Addr k -> note_params_in_address(k.lhs, dest);
        Deref k -> note_params_in_expr(k.lhs, dest);
        MemberAccess k -> note_params_in_expr(k.lhs, dest);
        Index k -> note_params_in_expr(k.lhs, dest);
        As k -> note_params_in_expr(k.lhs, dest);
        Trunc k -> note_params_in_expr(k.lhs, dest);
        Assign k -> note_params_in_expr(k.rhs, dest);
        If k -> {
            note_params_in_expr(k.then, dest);
            note_params_in_expr(k.els, dest)
        }
        OrElse k -> {
            note_params_in_expr(k.lhs, dest);
            note_params_in_expr(k.rhs, dest)
        }
        Block k -> note_params_in_stmt(last_stmt(k.body), dest);
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                note_params_in_stmt(arm.body, dest);
                arm = arm.next
            }
        }
        StructLit k -> note_params_in_inits(k.inits, dest);
        VariantLit k -> note_params_in_inits(k.inits, dest);
        New k -> note_params_in_inits(k.inits, dest);
        ArrayLit k -> {
            a: ?*Expr = k.elems;
            while (a != null) {
                note_params_in_expr(a, dest);
                a = a.next
            }
        }
        _ -> { }
    }
}

note_bound_call_param(callee_po: *Obj@immortal, p: *Obj@immortal) noregion {
    fn: ?*Function = current_fn;
    if (fn == null) return;
    fn.bound_calls = new BoundCall { caller_param: p, callee_param: callee_po, next: fn.bound_calls }
}

note_bound_calls_in_inits(inits: ?*FieldInit, callee_po: *Obj@immortal) noregion raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        note_bound_calls_in_expr(a.lhs, callee_po);
        a = a.next
    }
}

note_bound_calls_in_stmt(s: ?*Stmt, callee_po: *Obj@immortal) noregion raises Error {
    if (s == null) return;
    match s.kind {
        ExprStmt k -> note_bound_calls_in_expr(k.lhs, callee_po);
        Block k -> note_bound_calls_in_stmt(last_stmt(k.body), callee_po);
        If k -> {
            note_bound_calls_in_stmt(k.then, callee_po);
            note_bound_calls_in_stmt(k.els, callee_po)
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                note_bound_calls_in_stmt(arm.body, callee_po);
                arm = arm.next
            }
        }
        Try k -> {
            note_bound_calls_in_stmt(k.body, callee_po);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                note_bound_calls_in_stmt(a.body, callee_po);
                a = a.next
            }
        }
        Region k -> note_bound_calls_in_stmt(k.body, callee_po);
        Return k -> note_bound_calls_in_expr(k.lhs, callee_po);
        _ -> { }
    }
}

note_bound_calls_in_address(n: *Expr, callee_po: *Obj@immortal) noregion raises Error {
    match n.kind {
        Deref operand -> note_bound_calls_in_expr(operand.lhs, callee_po);
        MemberAccess member -> {
            if (type_is_ref(member.lhs.ty)) note_bound_calls_in_expr(member.lhs, callee_po) else note_bound_calls_in_address(member.lhs,
                callee_po)
        }
        Index index -> {
            if (type_is_ref(index.lhs.ty)) note_bound_calls_in_expr(index.lhs, callee_po) else note_bound_calls_in_address(index.lhs,
                callee_po)
        }
        _ -> { }
    }
}

note_bound_calls_in_expr(n: ?*Expr, callee_po: *Obj@immortal) noregion raises Error {
    if (n == null || !type_has_pointers(n.ty) || !type_has_pointers(callee_po.ty)) return;
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return;
            if (is_current_param(v)) {
                note_bound_call_param(callee_po, v);
                return
            }
            q: ?*Obj = find_param_by_life(v.life);
            if (q != null) note_bound_call_param(callee_po, q)
        }
        Addr k -> note_bound_calls_in_address(k.lhs, callee_po);
        Deref k -> note_bound_calls_in_expr(k.lhs, callee_po);
        MemberAccess k -> note_bound_calls_in_expr(k.lhs, callee_po);
        Index k -> note_bound_calls_in_expr(k.lhs, callee_po);
        As k -> note_bound_calls_in_expr(k.lhs, callee_po);
        Trunc k -> note_bound_calls_in_expr(k.lhs, callee_po);
        Assign k -> note_bound_calls_in_expr(k.rhs, callee_po);
        If k -> {
            note_bound_calls_in_expr(k.then, callee_po);
            note_bound_calls_in_expr(k.els, callee_po)
        }
        OrElse k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
            note_bound_calls_in_expr(k.rhs, callee_po)
        }
        Block k -> note_bound_calls_in_stmt(last_stmt(k.body), callee_po);
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                note_bound_calls_in_stmt(arm.body, callee_po);
                arm = arm.next
            }
        }
        StructLit k -> note_bound_calls_in_inits(k.inits, callee_po);
        VariantLit k -> note_bound_calls_in_inits(k.inits, callee_po);
        New k -> note_bound_calls_in_inits(k.inits, callee_po);
        ArrayLit k -> {
            a: ?*Expr = k.elems;
            while (a != null) {
                note_bound_calls_in_expr(a, callee_po);
                a = a.next
            }
        }
        _ -> { }
    }
}

note_sig_store(src: ?*Expr, dest: int) raises Error {
    if (src == null) return;
    if (current_fn == null) return;
    sl: int = expr_life(src);
    if (sl == LIFE_HEAPTOP) {
        dp: ?*Obj = find_param_by_life(dest);
        if (dp != null) dp.bound_need_new = true
    }
    note_params_in_expr(src, dest)
}

note_sig_return(src: ?*Expr) raises Error {
    fn: ?*Function = current_fn;
    if (src == null || fn == null) return;
    sl: int = expr_life(src);
    if (sl == LIFE_HEAPTOP) fn.bound_ret_need_new = true;
    rp: ?*Obj = find_param_by_life(sl);
    if (rp != null) {
        if (fn.bound_ret_param == null) fn.bound_ret_param = rp;
        note_params_in_expr(src, rp.life);
        return
    }
    if (sl == LIFE_HEAPTOP) note_params_in_expr(src, LIFE_HEAPTOP)
}

// target supplies source context for an assignment; synthetic storage has no target expression.
check_store(src: ?*Expr, dest: int, target: ?*Expr) noregion raises Error {
    if (src == null) return;
    if (!type_has_pointers(src.ty) && !is_tainted_expr(src) && !is_stack_addr(src)) return;
    sl: int = expr_life(src);
    note_sig_store(src, dest);
    if (life_outlives(sl, dest)) return;
    if (dest == LIFE_IMM && sl == LIFE_HEAPTOP) {
        reason: NoregionReason = NoregionReason.Store;
        if (target != null) {
            match target.kind {
                Var reference -> {
                    variable: ?*Obj = reference.var;
                    if (variable != null && !variable.is_local) reason = NoregionReason.GlobalStore { name: strdup_n(variable.name,
                        0, len(variable.name)) }
                }
                _ -> { }
            }
        }
        note_imm_heap(src, reason);
        return
    }
    if (sl == LIFE_HEAPTOP && find_param_by_life(dest) != null) return;
    if (life_is_param(sl) && !is_tainted_expr(src) && !is_stack_addr(src)) return;
    escape_error(src)
}

return_needs_new() noregion raises Error {
    fn: ?*Function = current_fn;
    if (fn != null) {
        sb: *StrBuf = sb_new();
        sb_puts(sb, "return of new requires @new on ");
        sb_puts(sb, fn.name);
        error(sb_finish(sb))
    }
    error("return of new requires @new")
}

// (Reported at the value returned.)
check_return(src: ?*Expr) noregion raises Error {
    if (src == null) return;
    outer_pos: int = diag_expr_pos;
    outer_file: int = diag_expr_file;
    if (src.pos > 0) {
        diag_expr_pos = src.pos;
        diag_expr_file = src.file
    }
    check_return_value(src);
    diag_expr_pos = outer_pos;
    diag_expr_file = outer_file
}

check_return_value(src: *Expr) noregion raises Error {
    if (!type_has_pointers(src.ty) && !is_tainted_expr(src) && !is_stack_addr(src)) return;
    sl: int = expr_life(src);
    dest: int = LIFE_IMM;
    cfn: ?*Function = current_fn;
    if (cfn != null) dest = cfn.ret_life;
    note_sig_return(src);
    if (dest == LIFE_IMM && sl == LIFE_HEAPTOP) return_needs_new();
    if (life_outlives(sl, dest)) return;
    if (life_is_param(sl) && !is_tainted_expr(src) && !is_stack_addr(src)) return;
    escape_error(src)
}

check_exc_payload(src: ?*Expr) noregion raises Error {
    if (src == null) return;
    if (!type_has_pointers(src.ty) && !is_tainted_expr(src) && !is_stack_addr(src)) return;
    sl: int = expr_life(src);
    note_sig_store(src, LIFE_IMM);
    if (life_outlives(sl, LIFE_IMM)) return;
    if (sl == LIFE_HEAPTOP) {
        note_imm_heap(src, NoregionReason.Payload);
        return
    }
    if (life_is_param(sl) && !is_tainted_expr(src) && !is_stack_addr(src)) return;
    if (is_tainted_expr(src) || is_stack_addr(src)) error("exception payload cannot hold the address of a local");
    error("exception payload cannot hold a region pointer")
}

check_call_lifetimes(fno: *Function@immortal, args: ?*Expr) noregion raises Error {
    a: ?*Expr = args;
    po: ?*Obj = fno.params;
    cfn: ?*Function = current_fn;
    while (a != null) {
        if (po != null) {
            sl: int = expr_life(a);
            if (cfn != null && !fno.is_extern) {
                pou: *Obj = po;
                note_bound_calls_in_expr(a, pou)
            }
            if (!life_is_self_bound(po)) {
                need: int = instantiate_bound(fno, po.life_bound, args);
                if (!life_outlives(sl, need)) {
                    if (sl == LIFE_HEAPTOP && need == LIFE_IMM) {
                        callee_name: []i8 = fno.name;
                        if (len(callee_name) == 0) callee_name = "a function value";
                        note_imm_heap(a, NoregionReason.Argument { callee: strdup_n(callee_name,
                            0, len(callee_name)), parameter: strdup_n(po.name, 0,
                            len(po.name)) })
                    } else {
                        qp2: ?*Obj = find_param_by_life(sl);
                        if (qp2 != null && !is_tainted_expr(a) && !is_stack_addr(a)) constrain_param_to_dest(qp2,
                            need) else if (!is_tainted_expr(a) && !is_stack_addr(a) && type_has_pointers(a.ty)) {
                            note_params_in_expr(a, need);
                            if (qp2 == null && life_is_region(sl)) escape_error(a)
                        } else escape_error(a)
                    }
                } else {
                    qp3: ?*Obj = find_param_by_life(sl);
                    if (qp3 != null && sl != LIFE_IMM && need != LIFE_SELF && need != LIFE_IMM && need != LIFE_HEAPTOP) constrain_param_to_dest(qp3,
                        need)
                }
            }
            po = po.param_next
        }
        a = a.next
    }
}

index_lhs_var(n: *Expr): ?*Obj {
    match n.kind {
        Var k -> k.var;
        _ -> null
    }
}

index_idx_num(n: *Expr): int {
    match n.kind {
        Num k -> {
            if (k.str_label == 0) k.val else 0 - 1
        }
        _ -> 0 - 1
    }
}

opt_local_var(n: ?*Expr): ?*Obj {
    if (n != null) {
        match n.kind {
            Var k -> {
                var: ?*Obj = k.var;
                if (var != null) {
                    if (!var.is_local) return null;
                    if (is_addr_taken(var)) return null;
                    t: ?*Type = decay(var.ty);
                    if (t != null && is_optional(t)) return var;
                    return null
                }
                return null
            }
            _ -> return null
        }
    }
    null
}

null_sides(lhs: *Expr, rhs: *Expr): ?*Obj {
    if (is_null_expr(rhs)) return opt_local_var(lhs);
    if (is_null_expr(lhs)) return opt_local_var(rhs);
    null
}

null_check_var(cond: ?*Expr): ?*Obj {
    if (cond != null) {
        match cond.kind {
            Binary k -> {
                match k.op {
                    Ne -> return null_sides(k.lhs, k.rhs);
                    _ -> return null
                }
            }
            _ -> return null
        }
    }
    null
}

null_eq_var(cond: ?*Expr): ?*Obj {
    if (cond != null) {
        match cond.kind {
            Binary k -> {
                match k.op {
                    Eq -> return null_sides(k.lhs, k.rhs);
                    _ -> return null
                }
            }
            _ -> return null
        }
    }
    null
}

narrow_push_ne_nulls(cond: ?*Expr) noregion raises Error {
    if (!parse_resolve) return;
    if (cond != null) {
        match cond.kind {
            LogAnd k -> {
                narrow_push_ne_nulls(k.lhs);
                narrow_push_ne_nulls(k.rhs);
                return
            }
            _ -> {
                v: ?*Obj = null_check_var(cond);
                if (v != null) {
                    vt: ?*Type = decay(v.ty);
                    if (vt == null) error("missing type");
                    narrow_push(v, unwrap_optional(vt))
                }
                narrow_push_path_test(cond, true)
            }
        }
    }
}

narrow_push_eq_nulls(cond: ?*Expr) noregion raises Error {
    if (!parse_resolve) return;
    if (cond != null) {
        match cond.kind {
            LogOr k -> {
                narrow_push_eq_nulls(k.lhs);
                narrow_push_eq_nulls(k.rhs);
                return
            }
            _ -> {
                v: ?*Obj = null_eq_var(cond);
                if (v != null) {
                    vt: ?*Type = decay(v.ty);
                    if (vt == null) error("missing type");
                    narrow_push(v, unwrap_optional(vt))
                }
                narrow_push_path_test(cond, false)
            }
        }
    }
}

/* Assumes n is already typed. True if execution cannot fall through. */
/* Syntactic divergence for parse-time early-exit narrowing (no full typing). */
stmt_parse_diverges(n: *Stmt): bool {
    match n.kind {
        Return _p -> true;
        Raise _p -> true;
        ExprStmt q -> {
            match q.lhs.kind {
                Funcall k -> {
                    if (streq(k.funcname, "exit")) return true;
                    fno: ?*Function = find_function(k.funcname);
                    if (fno != null) {
                        frt: ?*Type = fno.return_ty;
                        if (frt != null && is_noreturn_ty(frt)) return true
                    }
                    false
                }
                _ -> false
            }
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_parse_diverges(s)) return true;
                s = s.next
            }
            false
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) stmt_parse_diverges(k.then) && stmt_parse_diverges(els) else false
        }
        While k -> {
            match k.cond.kind {
                Num q -> q.form == LIT_TRUE;
                _ -> false
            }
        }
        Match k -> {
            if (k.arms == null) return false;
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!stmt_parse_diverges(arm.body)) return false;
                arm = arm.next
            }
            true
        }
        Try k -> {
            if (!stmt_parse_diverges(k.body)) return false;
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!stmt_parse_diverges(arm2.body)) return false;
                arm2 = arm2.next
            }
            true
        }
        _ -> false
    }
}

stmt_always_diverges(n: *Stmt): bool {
    match n.kind {
        Return _p -> true;
        Raise _p -> true;
        ExprStmt k -> {
            lty: ?*Type = k.lhs.ty;
            lty != null && is_noreturn_ty(lty)
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_always_diverges(s)) return true;
                s = s.next
            }
            false
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) stmt_always_diverges(k.then) && stmt_always_diverges(els) else false
        }
        While k -> {
            match k.cond.kind {
                Num q -> q.form == LIT_TRUE;
                _ -> false
            }
        }
        Match k -> {
            if (k.arms == null) return false;
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!stmt_always_diverges(arm.body)) return false;
                arm = arm.next
            }
            true
        }
        Try k -> {
            if (!stmt_always_diverges(k.body)) return false;
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!stmt_always_diverges(arm2.body)) return false;
                arm2 = arm2.next
            }
            true
        }
        Region k -> stmt_always_diverges(k.body);
        _ -> false
    }
}

expr_nonnull_ty(n: ?*Expr): bool {
    if (n == null || is_null_expr(n)) return false;
    t: ?*Type = decay(n.ty);
    t != null && !is_optional(t)
}

stmt_assign_target(n: *Stmt): ?*Obj {
    match n.kind {
        ExprStmt k -> {
            match k.lhs.kind {
                Assign q -> {
                    match q.lhs.kind {
                        Var vp -> vp.var;
                        _ -> null
                    }
                }
                _ -> null
            }
        }
        _ -> null
    }
}

stmt_assigns_to(n: *Stmt, v: *Obj): bool {
    t: ?*Obj = stmt_assign_target(n);
    if (t == v) return true;
    match n.kind {
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_assigns_to(s, v)) return true;
                s = s.next
            }
            false
        }
        If k -> {
            if (stmt_assigns_to(k.then, v)) return true;
            els: ?*Stmt = k.els;
            if (els != null) stmt_assigns_to(els, v) else false
        }
        Region k -> stmt_assigns_to(k.body, v);
        _ -> false
    }
}

/* True if every fallthrough path assigns a non-optional value to v (or diverges). */
stmt_ensures_nonnull(n: *Stmt, v: *Obj): bool {
    if (stmt_always_diverges(n)) return true;
    match n.kind {
        ExprStmt k -> {
            match k.lhs.kind {
                Assign q -> {
                    match q.lhs.kind {
                        Var vp -> {
                            if (vp.var == v) expr_nonnull_ty(q.rhs) else false
                        }
                        _ -> false
                    }
                }
                _ -> false
            }
        }
        Block k -> {
            ok: bool = false;
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_always_diverges(s)) return true;
                if (stmt_ensures_nonnull(s, v)) ok = true else {
                    if (stmt_assigns_to(s, v)) ok = false
                }
                s = s.next
            }
            ok
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) stmt_ensures_nonnull(k.then, v) && stmt_ensures_nonnull(els,
                v) else false
        }
        Region k -> stmt_ensures_nonnull(k.body, v);
        _ -> false
    }
}

stmt_diverges(n: *Stmt): bool {
    stmt_always_diverges(n)
}

check_noreturn_functions() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        frt: ?*Type = fn.return_ty;
        if (frt != null && is_noreturn_ty(frt) && !fn.is_extern) {
            body: ?*Stmt = fn.body;
            if (body == null || !stmt_diverges(body)) error("noreturn function may return")
        }
        fn = fn.next
    }
}

mark_var_use(var: ?*Obj) {
    if (var != null) var.used = true
}

add_callee(callee: *Function@immortal) noregion {
    fn: ?*Function = current_fn;
    if (fn == null) return;
    fu: *Function = fn;
    fu.callees = new CallEdge { callee: callee, next: fu.callees }
}

mark_reachable(fn: *Function) {
    if (fn.used) return;
    fn.used = true;
    e: ?*CallEdge = fn.callees;
    while (e != null) {
        mark_reachable(e.callee);
        e = e.next
    }
}

mark_used_functions() {
    fn: ?*Function = functions;
    while (fn != null) {
        fn.used = false;
        fn = fn.next
    }
    main_fn: ?*Function = find_function("main");
    if (main_fn != null) mark_reachable(main_fn);
    // A program's hot reload entry (RELOAD.md), which the host calls.
    reload_fn: ?*Function = find_function("reload");
    if (reload_fn != null && !reload_fn.is_extern && reload_fn.nparams == 0) mark_reachable(reload_fn);
    fn = functions;
    while (fn != null) {
        if (fn.address_taken || fn.test_id >= 0) mark_reachable(fn);
        fn = fn.next
    }
}

collect_unused_functions() noregion {
    fn: ?*Function = functions;
    while (fn != null) {
        if (!fn.is_extern) {
            file: ?*ImportedFile = imported_files;
            match_file: ?*ImportedFile = null;
            while (file != null) {
                if (file.id == fn.browse_file) {
                    match_file = file;
                    file = null
                } else file = file.next
            }
            if (match_file != null) {
                mf: *ImportedFile = match_file;
                scan: ?*UnusedFunction = unused_functions;
                found: ?*UnusedFunction = null;
                while (scan != null) {
                    if (scan.pos == fn.browse_pos && streq(scan.path, mf.path) && streq(scan.name,
                        fn.name)) {
                        found = scan;
                        scan = null
                    } else scan = scan.next
                }
                if (found != null) {
                    hit: *UnusedFunction = found;
                    if (fn.used) hit.used = true
                } else {
                    item: *UnusedFunction = new UnusedFunction {
                        name: fn.name,
                        path: mf.path,
                        src: mf.src,
                        src_len: mf.src_len,
                        pos: fn.browse_pos,
                        used: fn.used,
                        next: null
                    };
                    tail: ?*UnusedFunction = unused_function_tail;
                    if (tail != null) tail.next = item else unused_functions = item;
                    unused_function_tail = item
                }
            }
        }
        fn = fn.next
    }
}

warn_unused_functions() raises Error {
    item: ?*UnusedFunction = unused_functions;
    while (item != null) {
        if (!item.used) warn_unused_function(item.path, item.src, item.src_len, item.pos,
            item.name);
        item = item.next
    }
}

check_unused_locals() raises Error {
    /* Names starting with `_` or `.` are ignored. Bare assignment does not count as a use. */
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.used && !fn.is_extern) {
            o: ?*Obj = fn.locals;
            while (o != null) {
                if (!o.used && !ignore_unused_local_name(o.name)) warn_unused_local(o.browse_file,
                    o.browse_pos, fn.name, o.name);
                o = o.next
            }
        }
        fn = fn.next
    }
}

expr_is_ignored_value(n: *Expr): bool {
    match n.kind {
        Assign _p -> false;
        Block _p -> false;
        If _p -> false;
        Match _p -> false;
        Funcall k -> {
            fno: ?*Function = k.fn;
            if (fno == null) false else if (fno.is_extern) false else {
                rt: ?*Type = fno.return_ty;
                if (rt == null) false else if (is_noreturn_ty(rt)) false else true
            }
        }
        _ -> true
    }
}

warn_return_style_expr(
    n: ?*Expr,
    tail: bool,
    used: bool,
    fn: *Function
) raises Error {
    if (n == null) return;
    match n.kind {
        Block q -> {
            warn_return_style_list(q.body, tail, used, fn);
            return
        }
        If q -> {
            warn_return_style_expr(q.then, tail, used, fn);
            warn_return_style_expr(q.els, tail, used, fn);
            return
        }
        Match q -> {
            arm: ?*MatchArm = q.arms;
            while (arm != null) {
                warn_return_style_list(arm.body, tail, used, fn);
                arm = arm.next
            }
            return
        }
        _ -> return
    }
}

warn_return_style_stmt(
    s: *Stmt,
    tail: bool,
    used: bool,
    fn: *Function
) raises Error {
    match s.kind {
        Return k -> {
            if (tail) {
                if (k.lhs != null) warn_unnecessary_return(fn.browse_file, s.pos,
                    fn.name)
            }
            return
        }
        ExprStmt k -> {
            warn_return_style_expr(k.lhs, tail, used, fn);
            if (!used) {
                rt: ?*Type = fn.return_ty;
                if (rt != null && !is_noreturn_ty(rt)) {
                    if (expr_is_ignored_value(k.lhs)) warn_ignored_value(fn.browse_file,
                        s.pos, fn.name)
                }
            }
            return
        }
        Block k -> {
            warn_return_style_list(k.body, tail, used, fn);
            return
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                warn_return_style_list(k.then, tail, used, fn);
                warn_return_style_list(els, tail, used, fn)
            } else warn_return_style_list(k.then, false, false, fn);
            return
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                warn_return_style_list(arm.body, tail, used, fn);
                arm = arm.next
            }
            return
        }
        Try k -> {
            warn_return_style_list(k.body, tail, used, fn);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                warn_return_style_list(arm2.body, tail, used, fn);
                arm2 = arm2.next
            }
            return
        }
        While k -> {
            warn_return_style_list(k.body, false, false, fn);
            return
        }
        For k -> {
            warn_return_style_list(k.body, false, false, fn);
            return
        }
        _ -> return
    }
}

warn_return_style_list(
    head: ?*Stmt,
    tail: bool,
    used: bool,
    fn: *Function
) raises Error {
    s: ?*Stmt = head;
    last: ?*Stmt = last_stmt(head);
    while (s != null) {
        is_last: bool = s == last;
        st: bool = false;
        su: bool = false;
        if (tail && is_last) st = true;
        if (used && is_last) su = true;
        warn_return_style_stmt(s, st, su, fn);
        s = s.next
    }
}

check_return_style() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        used: bool = false;
        rt: ?*Type = fn.return_ty;
        if (rt != null && !is_noreturn_ty(rt)) used = true;
        warn_return_style_list(fn.body, true, used, fn);
        fn = fn.next
    }
}

is_const_init(n: ?*Expr): bool {
    if (n == null) return false;
    match n.kind {
        Num k -> k.str_label == 0;
        Var k -> {
            g: ?*Obj = k.var;
            if (g == null) return false;
            g.is_const
        }
        Null -> true;
        Neg q -> is_const_init(q.lhs);
        BitNot q -> is_const_init(q.lhs);
        As q -> {
            if (n.ty != null && is_float_ty(n.ty)) false else {
                if (q.lhs.ty != null && is_float_ty(q.lhs.ty)) false else is_const_init(q.lhs)
            }
        }
        Trunc q -> is_const_init(q.lhs);
        Not q -> is_const_init(q.lhs);
        Binary q -> {
            if (n.ty != null && is_float_ty(n.ty)) false else is_const_init(q.lhs) && is_const_init(q.rhs)
        }
        _ -> false
    }
}

wrap_u8(v: int): int {
    while (v < 0) v = v + 256;
    while (v >= 256) v = v - 256;
    v
}

wrap_u32(v: int): int {
    v & 4294967295
}

wrap_i32(v: int): int {
    v = v & 4294967295;
    if (v >= 2147483648) v = v - 4294967296;
    v
}

wrap_width(v: int, t: ?*Type): int {
    if (t != null) {
        if (is_i8_ty(t)) return wrap_u8(v);
        if (is_i32_ty(t)) return wrap_i32(v);
        if (is_u32_ty(t)) return wrap_u32(v)
    }
    v
}

const_bit(a: int, b: int, kind: int): int {
    if (kind == 0) a & b else if (kind == 1) a | b else a ^ b
}

const_shl(a: int, n: int) raises Error: int {
    if (n < 0) error("negative shift in global initializer");
    if (n >= 64) return 0;
    for _i in 0..n a = a + a;
    a
}

const_sar1(a: int): int {
    a >> 1
}

const_sar(a: int, n: int) raises Error: int {
    if (n < 0) error("negative shift in global initializer");
    if (n >= 64) {
        if (a < 0) return 0 - 1;
        return 0
    }
    for _i in 0..n a = const_sar1(a);
    a
}

const_global_value(g: *Obj) raises Error: int {
    if (!g.is_const) error("const initializer references a mutable global");
    if (g.const_state == 2) return g.const_val;
    if (g.const_state == 1) error("cyclic const initializer");
    g.const_state = 1;
    init: *Expr = g.init or error("missing const initializer");
    value: int = const_value(init);
    g.const_val = value;
    g.const_state = 2;
    value
}

const_global_type(t: ?*Type): bool {
    is_int_width_ty(t) || is_bool_ty(t) || is_float_ty(t)
}

const_value(n: *Expr) raises Error: int {
    match n.kind {
        Num k -> k.val;
        Var k -> {
            g: *Obj = k.var or error("const initializer references an unknown global");
            const_global_value(g)
        }
        Null -> 0;
        Neg q -> {
            ntyn: ?*Type = n.ty;
            if (ntyn != null && is_f32_ty(ntyn)) return const_value(q.lhs) ^ 2147483648;
            if (ntyn != null && is_f64_ty(ntyn)) return const_value(q.lhs) ^ 1 << 63;
            wrap_width(0 - const_value(q.lhs), n.ty)
        }
        BitNot q -> {
            v0: int = 0 - 1 - const_value(q.lhs);
            wrap_width(v0, n.ty)
        }
        As q -> wrap_width(const_value(q.lhs), n.ty);
        Trunc q -> wrap_width(const_value(q.lhs), n.ty);
        Not q -> {
            if (const_value(q.lhs) == 0) return 1;
            0
        }
        Binary q -> {
            l: int = const_value(q.lhs);
            r: int = const_value(q.rhs);
            v: int = 0;
            match q.op {
                Add -> v = l + r;
                Sub -> v = l - r;
                Mul -> v = l * r;
                Div -> {
                    if (r == 0) error("division by zero in global initializer");
                    v = l / r
                }
                Mod -> {
                    if (r == 0) error("division by zero in global initializer");
                    v = l % r
                }
                And -> v = const_bit(l, r, 0);
                Or -> v = const_bit(l, r, 1);
                Xor -> v = const_bit(l, r, 2);
                Shl -> v = const_shl(l, r);
                Shr -> {
                    ntyS: ?*Type = n.ty;
                    if (ntyS != null && is_u32_ty(ntyS)) {
                        if (r < 0) error("negative shift in global initializer");
                        if (r >= 32) v = 0 else v = wrap_u32(l) >> r
                    } else v = const_sar(l, r)
                }
                Eq -> {
                    if (l == r) v = 1
                }
                Ne -> {
                    if (l != r) v = 1
                }
                Lt -> {
                    if (l < r) v = 1
                }
                Le -> {
                    if (l <= r) v = 1
                }
                Gt -> {
                    if (l > r) v = 1
                }
                Ge -> {
                    if (l >= r) v = 1
                }
            }
            nty: ?*Type = n.ty;
            if (nty != null) return wrap_width(v, nty);
            v
        }
        _ -> error("global initializer must be a constant")
    }
}

typecheck_global_inits() noregion raises Error {
    life_reset_imm();
    g: ?*Obj = globals;
    while (g != null) {
        if (!g.is_func) {
            init: ?*Expr = g.init;
            if (init == null) error("global requires an initializer (name: T = e)");
            add_type(init);
            if (!assignable(g.ty, init)) error_have_expr_want("global initializer type mismatch",
                init, g.ty);
            check_store(init, LIFE_IMM, null)
        }
        g = g.next
    }
    g = globals;
    while (g != null) {
        if (g.is_const) {
            if (!const_global_type(g.ty)) error("const global must have a scalar numeric or bool type");
            if (!is_const_init(g.init)) error("const initializer must be a constant expression");
            _value: int = const_global_value(g)
        }
        g = g.next
    }
    check_persistent_globals()
}

error_uninit(name: []i8) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, "use of uninitialized local ");
    sb_puts(sb, name);
    error(sb_finish(sb))
}

init_has(o: *Obj): bool {
    f: ?*InitFrame = init_top;
    while (f != null) {
        if (f.var == o) return true;
        f = f.next
    }
    false
}

init_mark(o: *Obj@immortal) noregion {
    if (init_has(o)) return;
    init_top = new InitFrame { var: o, next: init_top }
}

init_use(o: ?*Obj) noregion raises Error {
    if (o == null) return;
    if (!o.is_local) return;
    if (init_has(o)) return;
    error_uninit(o.name)
}

init_has_since(top: ?*InitFrame, save: ?*InitFrame, o: *Obj): bool {
    f: ?*InitFrame = top;
    while (f != null) {
        if (f == save) return false;
        if (f.var == o) return true;
        f = f.next
    }
    false
}

init_meet(then_top: ?*InitFrame@immortal, else_top: ?*InitFrame, save: ?*InitFrame@immortal) noregion {
    init_top = save;
    f: ?*InitFrame = then_top;
    while (f != null) {
        if (f == save) return;
        v: *Obj = f.var;
        if (init_has_since(else_top, save, v)) init_mark(v);
        f = f.next
    }
}

init_mark_fn(fn: *Function@immortal) noregion {
    init_top = null;
    p: ?*Obj = fn.params;
    while (p != null) {
        init_mark(p);
        p = p.param_next
    }
    o: ?*Obj = fn.locals;
    while (o != null) {
        if (len(o.name) > 0 && o.name[0] == '.') init_mark(o);
        o = o.next
    }
}

da_field_inits(inits: ?*FieldInit) noregion raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        _e: bool = da_expr(a.lhs);
        a = a.next
    }
}

da_write(n: *Expr) noregion raises Error {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v != null) init_mark(v)
        }
        MemberAccess k -> {
            _e: bool = da_expr(k.lhs)
        }
        Index k -> {
            _a: bool = da_expr(k.lhs);
            _i: bool = da_expr(k.idx)
        }
        Deref k -> {
            _d: bool = da_expr(k.lhs)
        }
        _ -> {
            _n: bool = da_expr(n)
        }
    }
}

da_expr(n: ?*Expr) noregion raises Error: bool {
    if (n == null) return false;
    p: *Expr = n;
    match p.kind {
        FuncAddr _ -> false;
        Num _k -> false;
        Null -> false;
        Var k -> {
            init_use(k.var);
            false
        }
        Binary k -> {
            _bl: bool = da_expr(k.lhs);
            _br: bool = da_expr(k.rhs);
            false
        }
        Assign k -> {
            _ar: bool = da_expr(k.rhs);
            da_write(k.lhs);
            false
        }
        Addr k -> {
            _ad: bool = da_expr(k.lhs);
            false
        }
        Deref k -> {
            _dr: bool = da_expr(k.lhs);
            false
        }
        Index k -> {
            _il: bool = da_expr(k.lhs);
            _ii: bool = da_expr(k.idx);
            false
        }
        Not k -> da_expr(k.lhs);
        Neg k -> da_expr(k.lhs);
        BitNot k -> da_expr(k.lhs);
        LogAnd k -> {
            _al: bool = da_expr(k.lhs);
            save: ?*InitFrame = init_top;
            _ar2: bool = da_expr(k.rhs);
            init_top = save;
            false
        }
        LogOr k -> {
            _ol: bool = da_expr(k.lhs);
            save2: ?*InitFrame = init_top;
            _or: bool = da_expr(k.rhs);
            init_top = save2;
            false
        }
        OrElse k -> {
            _xl: bool = da_expr(k.lhs);
            save3: ?*InitFrame = init_top;
            _xr: bool = da_expr(k.rhs);
            init_top = save3;
            false
        }
        Funcall k -> {
            _target: bool = da_expr(k.target);
            a: ?*Expr = k.args;
            while (a != null) {
                _fa: bool = da_expr(a);
                a = a.next
            }
            rt: ?*Type = p.ty;
            rt != null && is_noreturn_ty(rt)
        }
        MemberAccess k -> {
            _ma: bool = da_expr(k.lhs);
            false
        }
        As k -> da_expr(k.lhs);
        Trunc k -> da_expr(k.lhs);
        New k -> {
            _nl: bool = da_expr(k.lhs);
            _nf: bool = da_expr(k.fill);
            da_field_inits(k.inits);
            false
        }
        ArrayLit k -> {
            a: ?*Expr = k.elems;
            while (a != null) {
                _ae: bool = da_expr(a);
                a = a.next
            }
            false
        }
        StructLit k -> {
            da_field_inits(k.inits);
            false
        }
        VariantLit k -> {
            da_field_inits(k.inits);
            false
        }
        If k -> {
            _ic: bool = da_expr(k.cond);
            savei: ?*InitFrame = init_top;
            dt: bool = da_expr(k.then);
            then_top: ?*InitFrame = init_top;
            init_top = savei;
            de: bool = da_expr(k.els);
            else_top: ?*InitFrame = init_top;
            if (dt && de) return true;
            if (dt) {
                init_top = else_top;
                return false
            }
            if (de) {
                init_top = then_top;
                return false
            }
            init_meet(then_top, else_top, savei);
            false
        }
        Match k -> {
            _mc: bool = da_expr(k.cond);
            savem: ?*InitFrame = init_top;
            arm: ?*MatchArm = k.arms;
            any: bool = false;
            live: int = 0;
            acc: ?*InitFrame = null;
            while (arm != null) {
                init_top = savem;
                b: ?*Obj = arm.binder;
                if (b != null) init_mark(b);
                d: bool = da_stmt(arm.body);
                if (!d) {
                    if (live == 0) acc = init_top else {
                        init_meet(acc, init_top, savem);
                        acc = init_top
                    }
                    live = live + 1
                }
                any = true;
                arm = arm.next
            }
            if (!any) return false;
            if (live == 0) return true;
            init_top = acc;
            false
        }
        Block k -> da_stmt_list(k.body);
        Sizeof k -> da_expr(k.e)
    }
}

da_stmt_list(s: ?*Stmt) noregion raises Error: bool {
    a: ?*Stmt = s;
    d: bool = false;
    while (a != null) {
        if (da_stmt(a)) d = true;
        a = a.next
    }
    d
}

// (An error in s reported at it.)
da_stmt(s: ?*Stmt) noregion raises Error: bool {
    if (s == null) return false;
    outer_file: int = diag_stmt_file;
    outer: int = diag_enter_stmt(s, da_file);
    r: bool = da_stmt_node(s);
    diag_leave(outer, outer_file);
    r
}

da_stmt_node(s: *Stmt) noregion raises Error: bool {
    match s.kind {
        Return k -> {
            _re: bool = da_expr(k.lhs);
            true
        }
        Raise k -> {
            da_field_inits(k.inits);
            true
        }
        ExprStmt k -> da_expr(k.lhs);
        Block k -> da_stmt_list(k.body);
        If k -> {
            _sc: bool = da_expr(k.cond);
            save: ?*InitFrame = init_top;
            dt: bool = da_stmt(k.then);
            then_top: ?*InitFrame = init_top;
            els: ?*Stmt = k.els;
            if (els == null) {
                init_top = save;
                false
            } else {
                init_top = save;
                de: bool = da_stmt(els);
                else_top: ?*InitFrame = init_top;
                if (dt && de) return true;
                if (dt) {
                    init_top = else_top;
                    return false
                }
                if (de) {
                    init_top = then_top;
                    return false
                }
                init_meet(then_top, else_top, save);
                false
            }
        }
        While k -> {
            _wc: bool = da_expr(k.cond);
            savew: ?*InitFrame = init_top;
            _wb: bool = da_stmt(k.body);
            init_top = savew;
            false
        }
        For k -> {
            _fi: bool = da_expr(k.iter);
            _fh: bool = da_expr(k.hi);
            init_mark(k.item);
            savef: ?*InitFrame = init_top;
            _fb: bool = da_stmt(k.body);
            init_top = savef;
            false
        }
        Match k -> {
            _sm: bool = da_expr(k.cond);
            savem: ?*InitFrame = init_top;
            arm: ?*MatchArm = k.arms;
            any: bool = false;
            live: int = 0;
            acc: ?*InitFrame = null;
            while (arm != null) {
                init_top = savem;
                b: ?*Obj = arm.binder;
                if (b != null) init_mark(b);
                d: bool = da_stmt(arm.body);
                if (!d) {
                    if (live == 0) acc = init_top else {
                        init_meet(acc, init_top, savem);
                        acc = init_top
                    }
                    live = live + 1
                }
                any = true;
                arm = arm.next
            }
            if (!any) return false;
            if (live == 0) return true;
            init_top = acc;
            false
        }
        Try k -> {
            savet: ?*InitFrame = init_top;
            dtry: bool = da_stmt(k.body);
            try_top: ?*InitFrame = init_top;
            live: int = 0;
            acc: ?*InitFrame = null;
            if (!dtry) {
                acc = try_top;
                live = 1
            }
            arm: ?*CatchArm = k.arms;
            all_div: bool = dtry;
            while (arm != null) {
                init_top = savet;
                b: ?*Obj = arm.binder;
                if (b != null) init_mark(b);
                dc: bool = da_stmt(arm.body);
                if (!dc) {
                    if (live == 0) acc = init_top else {
                        init_meet(acc, init_top, savet);
                        acc = init_top
                    }
                    live = live + 1;
                    all_div = false
                }
                arm = arm.next
            }
            if (all_div && live == 0) return true;
            init_top = acc;
            false
        }
        Region k -> da_stmt(k.body);
        Decl k -> {
            _di: bool = da_expr(k.init);
            vo: ?*Obj = k.var;
            if (k.init != null && vo != null) init_mark(vo);
            false
        }
        Expect _ -> false
    }
}

check_fn_inited(fn: *Function@immortal) noregion raises Error {
    init_mark_fn(fn);
    da_file = fn.browse_file;
    _fn: bool = da_stmt(fn.body);
    init_top = null
}

// The file of the function whose locals' initialization is followed.
da_file: int = 0;

record_noregion_call_expr(owner: *Function@immortal, n: ?*Expr) raises Error: bool {
    if (n == null) return false;
    match n.kind {
        Funcall k -> {
            if (record_noregion_call_expr(owner, k.target)) return true;
            fno: ?*Function = k.fn;
            if (fno == null) fno = find_function(k.funcname);
            if (fno != null) {
                fu: *Function = fno;
                if (fu.need_imm_heap != 0) {
                    callee_name: []i8 = fu.name;
                    if (len(callee_name) == 0) callee_name = "a function value";
                    owner.noregion_cause = new NoregionCause {
                        file: n.file,
                        pos: n.pos,
                        span: n.toklen,
                        reason: NoregionReason.Call { callee: strdup_n(callee_name,
                            0, len(callee_name)) }
                    };
                    return true
                }
            }
            a: ?*Expr = k.args;
            while (a != null) {
                if (record_noregion_call_expr(owner, a)) return true;
                a = a.next
            }
            false
        }
        Binary k -> record_noregion_call_expr(owner, k.lhs) || record_noregion_call_expr(owner,
            k.rhs);
        Assign k -> record_noregion_call_expr(owner, k.lhs) || record_noregion_call_expr(owner,
            k.rhs);
        Addr k -> record_noregion_call_expr(owner, k.lhs);
        Deref k -> record_noregion_call_expr(owner, k.lhs);
        Index k -> record_noregion_call_expr(owner, k.lhs) || record_noregion_call_expr(owner,
            k.idx);
        Not k -> record_noregion_call_expr(owner, k.lhs);
        Neg k -> record_noregion_call_expr(owner, k.lhs);
        BitNot k -> record_noregion_call_expr(owner, k.lhs);
        LogAnd k -> record_noregion_call_expr(owner, k.lhs) || record_noregion_call_expr(owner,
            k.rhs);
        LogOr k -> record_noregion_call_expr(owner, k.lhs) || record_noregion_call_expr(owner,
            k.rhs);
        OrElse k -> record_noregion_call_expr(owner, k.lhs) || record_noregion_call_expr(owner,
            k.rhs);
        MemberAccess k -> record_noregion_call_expr(owner, k.lhs);
        As k -> record_noregion_call_expr(owner, k.lhs);
        Trunc k -> record_noregion_call_expr(owner, k.lhs);
        New k -> record_noregion_call_expr(owner, k.lhs) || record_noregion_call_expr(owner,
            k.fill) || record_noregion_call_inits(owner, k.inits);
        ArrayLit k -> {
            a: ?*Expr = k.elems;
            while (a != null) {
                if (record_noregion_call_expr(owner, a)) return true;
                a = a.next
            }
            false
        }
        StructLit k -> record_noregion_call_inits(owner, k.inits);
        VariantLit k -> record_noregion_call_inits(owner, k.inits);
        If k -> record_noregion_call_expr(owner, k.cond) || record_noregion_call_expr(owner,
            k.then) || record_noregion_call_expr(owner, k.els);
        Match k -> {
            if (record_noregion_call_expr(owner, k.cond)) return true;
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (record_noregion_call_stmt(owner, arm.body)) return true;
                arm = arm.next
            }
            false
        }
        Block k -> record_noregion_call_stmts(owner, k.body);
        Sizeof k -> record_noregion_call_expr(owner, k.e);
        _ -> false
    }
}

record_noregion_call_inits(owner: *Function@immortal, inits: ?*FieldInit) raises Error: bool {
    a: ?*FieldInit = inits;
    while (a != null) {
        if (record_noregion_call_expr(owner, a.lhs)) return true;
        a = a.next
    }
    false
}

record_noregion_call_stmt(owner: *Function@immortal, s: ?*Stmt) raises Error: bool {
    if (s == null) return false;
    match s.kind {
        Return k -> record_noregion_call_expr(owner, k.lhs);
        ExprStmt k -> record_noregion_call_expr(owner, k.lhs);
        Block k -> record_noregion_call_stmts(owner, k.body);
        If k -> record_noregion_call_expr(owner, k.cond) || record_noregion_call_stmt(owner,
            k.then) || record_noregion_call_stmt(owner, k.els);
        While k -> record_noregion_call_expr(owner, k.cond) || record_noregion_call_stmt(owner,
            k.body);
        For k -> record_noregion_call_expr(owner, k.iter) || record_noregion_call_expr(owner,
            k.hi) || record_noregion_call_stmt(owner, k.body);
        Match k -> {
            if (record_noregion_call_expr(owner, k.cond)) return true;
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (record_noregion_call_stmt(owner, arm.body)) return true;
                arm = arm.next
            }
            false
        }
        Raise k -> record_noregion_call_inits(owner, k.inits);
        Try k -> {
            if (record_noregion_call_stmt(owner, k.body)) return true;
            a: ?*CatchArm = k.arms;
            while (a != null) {
                if (record_noregion_call_stmt(owner, a.body)) return true;
                a = a.next
            }
            false
        }
        Region k -> record_noregion_call_stmt(owner, k.body);
        Decl k -> record_noregion_call_expr(owner, k.init);
        _ -> false
    }
}

record_noregion_call_stmts(owner: *Function@immortal, s: ?*Stmt) raises Error: bool {
    while (s != null) {
        if (record_noregion_call_stmt(owner, s)) return true;
        s = s.next
    }
    false
}

propagate_need_imm_heap() raises Error {
    changed: bool = true;
    while (changed) {
        changed = false;
        fn: ?*Function = functions;
        while (fn != null) {
            if (!fn.is_extern && fn.need_imm_heap == 0) {
                if (record_noregion_call_stmt(fn, fn.body)) {
                    fn.need_imm_heap = 1;
                    changed = true
                }
            }
            fn = fn.next
        }
    }
}

check_region_calls_expr(n: ?*Expr) noregion raises Error {
    if (n == null) return;
    match n.kind {
        Funcall k -> {
            check_region_calls_expr(k.target);
            fno: ?*Function = k.fn;
            if (fno == null) fno = find_function(k.funcname);
            if (fno != null) {
                fu: *Function = fno;
                if (fu.need_imm_heap != 0) {
                    if (life_heap != LIFE_HEAPTOP && life_heap != LIFE_IMM) {
                        message: *StrBuf = sb_new();
                        if (len(fu.name) == 0) sb_puts(message, "this function value") else sb_puts(message,
                            fu.name);
                        sb_puts(message, " requires noregion; move the call outside this region or use a function without that requirement");
                        error_at_file(n.file, n.pos, sb_finish(message))
                    }
                }
            }
            a: ?*Expr = k.args;
            while (a != null) {
                check_region_calls_expr(a);
                a = a.next
            }
            return
        }
        Binary k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return
        }
        Assign k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return
        }
        Addr k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        Deref k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        Index k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.idx);
            return
        }
        Not k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        Neg k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        BitNot k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        LogAnd k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return
        }
        LogOr k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return
        }
        OrElse k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return
        }
        MemberAccess k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        As k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        Trunc k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        New k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.fill);
            check_region_calls_inits(k.inits);
            return
        }
        ArrayLit k -> {
            a: ?*Expr = k.elems;
            while (a != null) {
                check_region_calls_expr(a);
                a = a.next
            }
            return
        }
        StructLit k -> {
            check_region_calls_inits(k.inits);
            return
        }
        VariantLit k -> {
            check_region_calls_inits(k.inits);
            return
        }
        If k -> {
            check_region_calls_expr(k.cond);
            check_region_calls_expr(k.then);
            check_region_calls_expr(k.els);
            return
        }
        Match k -> {
            check_region_calls_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                check_region_calls_stmt(arm.body);
                arm = arm.next
            }
            return
        }
        Block k -> {
            check_region_calls_stmt_list(k.body);
            return
        }
        _ -> return
    }
}

check_region_calls_inits(inits: ?*FieldInit) noregion raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        check_region_calls_expr(a.lhs);
        a = a.next
    }
}

// (An error in s reported at it, in the function checked.)
check_region_calls_stmt(s: ?*Stmt) noregion raises Error {
    if (s == null) return;
    fn: ?*Function = current_fn;
    // (Not an if expression: src1, which builds this, narrows only its
    // statement.)
    file: int = current_file_id;
    if (fn != null) file = fn.browse_file;
    outer_file: int = diag_stmt_file;
    outer: int = diag_enter_stmt(s, file);
    check_region_calls_node(s);
    diag_leave(outer, outer_file)
}

check_region_calls_node(s: *Stmt) noregion raises Error {
    match s.kind {
        Return k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        ExprStmt k -> {
            check_region_calls_expr(k.lhs);
            return
        }
        Block k -> {
            check_region_calls_stmt_list(k.body);
            return
        }
        If k -> {
            check_region_calls_expr(k.cond);
            check_region_calls_stmt(k.then);
            check_region_calls_stmt(k.els);
            return
        }
        While k -> {
            check_region_calls_expr(k.cond);
            check_region_calls_stmt(k.body);
            return
        }
        For k -> {
            check_region_calls_expr(k.iter);
            check_region_calls_expr(k.hi);
            check_region_calls_stmt(k.body);
            return
        }
        Match k -> {
            check_region_calls_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                check_region_calls_stmt(arm.body);
                arm = arm.next
            }
            return
        }
        Raise k -> {
            check_region_calls_inits(k.inits);
            return
        }
        Try k -> {
            check_region_calls_stmt(k.body);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                check_region_calls_stmt(a.body);
                a = a.next
            }
            return
        }
        Region k -> {
            old_heap: int = life_heap;
            life_heap = 99;
            check_region_calls_stmt(k.body);
            life_heap = old_heap;
            return
        }
        Decl k -> {
            check_region_calls_expr(k.init);
            return
        }
        _ -> return
    }
}

check_region_calls_stmt_list(s: ?*Stmt) noregion raises Error {
    while (s != null) {
        check_region_calls_stmt(s);
        s = s.next
    }
}

check_region_calls_all() noregion raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (!fn.is_extern) {
            life_heap = LIFE_HEAPTOP;
            check_region_calls_stmt(fn.body)
        }
        fn = fn.next
    }
}

typecheck_program() noregion raises Error {
    typecheck_global_inits();
    fn: ?*Function = functions;
    while (fn != null) {
        if (!fn.is_extern) {
            e: ?*ExnList = fn.raises_list;
            while (e != null) {
                e.seen = false;
                e = e.next
            }
            current_fn = fn;
            current_return_ty = fn.return_ty;
            catch_top = null;
            narrow_top = null;
            taint_top = null;
            addr_top = null;
            life_init_fn(fn);
            add_type_stmt(fn.body);
            check_fn_result(fn);
            check_fn_inited(fn)
        }
        fn = fn.next
    }
    propagate_need_imm_heap();
    propagate_param_bounds();
    check_region_calls_all();
    check_foreign_function_types();
    current_fn = null;
    current_return_ty = null;
    catch_top = null;
    narrow_top = null
}

check_fn_result(fn: *Function@immortal) noregion raises Error {
    if (fn.is_extern) return;
    rt: ?*Type = fn.return_ty;
    if (rt == null) return;
    if (is_noreturn_ty(rt)) return;
    want: *Type = rt;
    if (check_stmt_result(fn.body, want)) return;
    sb: *StrBuf = sb_new();
    sb_puts(sb, fn.name);
    sb_puts(sb, " can finish without returning ");
    append_type(sb, want);
    sb_puts(sb, "; add a final value or return from each branch");
    error_at_file(fn.browse_file, fn.browse_pos, sb_finish(sb))
}

check_raises_functions() noregion raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.raises_list != null) {
            e: ?*ExnList = fn.raises_list;
            while (e != null) {
                if (!e.seen) {
                    message: *StrBuf = sb_new();
                    sb_puts(message, e.exn.name);
                    sb_puts(message, " cannot escape ");
                    sb_puts(message, fn.name);
                    sb_puts(message, "; remove it from ");
                    sb_puts(message, fn.name);
                    sb_puts(message, "'s raises list.");
                    error_at_file(e.source_file, e.source_pos, sb_finish(message))
                }
                e = e.next
            }
        }
        fn = fn.next
    }
}

append_lifetime_diagnostic(
    report: *LifetimeDiagnostics@new,
    file: int,
    pos: int,
    msg: []i8
) raises Error {
    sb_puts(report.output, "error: ");
    append_diagnostic_location(report.output, file, pos);
    sb_puts(report.output, ": ");
    sb_puts(report.output, msg);
    sb_putc(report.output, '\n');
    report.count = report.count + 1
}

check_imm_heap_functions(report: *LifetimeDiagnostics@new) raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        // Test bodies cannot declare noregion; only the test entry calls them.
        if (!fn.is_extern && fn.test_id < 0) {
            if (missing_noregion(fn) && primary_noregion_diagnostic(fn)) {
                append_noregion_diagnostic(report.output, fn);
                report.count = report.count + 1
            }
            // (A function taken as a value may be noregion for its type: a
            // noregion fn the value is stored as, as another may need.)
            if (fn.need_imm_heap == 0 && fn.decl_imm_heap != 0 && !fn.address_taken) {
                sb2: *StrBuf = sb_new();
                sb_puts(sb2, "unnecessary noregion on ");
                sb_puts(sb2, fn.name);
                append_lifetime_diagnostic(report, fn.browse_file, fn.browse_pos,
                    sb_finish(sb2))
            }
        }
        fn = fn.next
    }
}

BOUND_OMIT: int = 0;

BOUND_NEW: int = 1;

BOUND_IMM: int = 2;

BOUND_NAMED: int = 0 - 1;

written_param_kind(p: *Obj): int {
    b: []i8 = p.life_bound;
    if (life_bound_immortal(b)) return BOUND_IMM;
    if (streq(b, "new")) return BOUND_NEW;
    if (len(b) == 0 || streq(b, p.name)) return BOUND_OMIT;
    BOUND_NAMED
}

inferred_param_kind(p: *Obj): int {
    if (p.bound_need_imm) return BOUND_IMM;
    if (p.bound_need_new) return BOUND_NEW;
    if (p.bound_named != null) return BOUND_NAMED;
    BOUND_OMIT
}

written_ret_kind(fn: *Function): int {
    b: []i8 = fn.ret_bound;
    if (len(b) == 0 || life_bound_immortal(b)) return BOUND_OMIT;
    if (streq(b, "new")) return BOUND_NEW;
    BOUND_NAMED
}

inferred_ret_kind(fn: *Function): int {
    if (fn.bound_ret_need_new) return BOUND_NEW;
    if (fn.bound_ret_param != null) return BOUND_NAMED;
    BOUND_OMIT
}

bound_err(report: *LifetimeDiagnostics@new, msg: []i8, fn: *Function) raises Error {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, fn.name);
    append_lifetime_diagnostic(report, fn.browse_file, fn.browse_pos, sb_finish(sb))
}

bound_err_param(
    report: *LifetimeDiagnostics@new,
    msg: []i8,
    fn: *Function,
    p: *Obj
) raises Error {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, p.name);
    sb_puts(sb, " in ");
    sb_puts(sb, fn.name);
    append_lifetime_diagnostic(report, p.browse_file, p.browse_pos, sb_finish(sb))
}

bound_use_named(report: *LifetimeDiagnostics@new, fn: *Function, p: ?*Obj) raises Error {
    if (p == null) {
        bound_err(report, "omit bound on ", fn);
        return
    }
    pu: *Obj = p;
    sb: *StrBuf = sb_new();
    sb_puts(sb, "use @");
    sb_puts(sb, pu.name);
    sb_puts(sb, " on ");
    sb_puts(sb, fn.name);
    append_lifetime_diagnostic(report, fn.browse_file, fn.browse_pos, sb_finish(sb))
}

bound_use_named_param(
    report: *LifetimeDiagnostics@new,
    fn: *Function,
    p: *Obj,
    inf: ?*Obj
) raises Error {
    if (inf == null) {
        bound_err_param(report, "omit bound on ", fn, p);
        return
    }
    iu: *Obj = inf;
    sb: *StrBuf = sb_new();
    sb_puts(sb, "use @");
    sb_puts(sb, iu.name);
    sb_puts(sb, " on ");
    sb_puts(sb, p.name);
    sb_puts(sb, " in ");
    sb_puts(sb, fn.name);
    append_lifetime_diagnostic(report, p.browse_file, p.browse_pos, sb_finish(sb))
}

param_needs_bound(p: *Obj): bool {
    type_is_ref(p.ty) || type_has_pointers(p.ty)
}

check_written_param(report: *LifetimeDiagnostics@new, fn: *Function, p: *Obj) raises Error {
    if (!param_needs_bound(p)) return;
    have: int = written_param_kind(p);
    want: int = inferred_param_kind(p);
    if (have == want) {
        if (have == BOUND_NAMED) {
            inf: ?*Obj = p.bound_named;
            if (inf == null) return;
            if (!streq(p.life_bound, inf.name)) bound_use_named_param(report, fn,
                p, inf)
        }
        return
    }
    if (want == BOUND_IMM) {
        bound_err_param(report, "use @immortal on ", fn, p);
        return
    }
    if (want == BOUND_NEW) {
        bound_err_param(report, "use @new on ", fn, p);
        return
    }
    if (want == BOUND_NAMED) {
        bound_use_named_param(report, fn, p, p.bound_named);
        return
    }
    bound_err_param(report, "omit bound on ", fn, p)
}

check_written_ret(report: *LifetimeDiagnostics@new, fn: *Function) raises Error {
    if (!type_is_ref(fn.return_ty)) return;
    have: int = written_ret_kind(fn);
    want: int = inferred_ret_kind(fn);
    if (have == want) {
        if (have == BOUND_NAMED) {
            rp: ?*Obj = fn.bound_ret_param;
            if (rp == null) return;
            if (!streq(fn.ret_bound, rp.name)) bound_use_named(report, fn, rp)
        }
        return
    }
    if (want == BOUND_NEW) {
        bound_err(report, "return of new requires @new on ", fn);
        return
    }
    if (have == BOUND_NEW) {
        bound_err(report, "return bound is @new on ", fn);
        return
    }
    if (want == BOUND_NAMED) {
        bound_use_named(report, fn, fn.bound_ret_param);
        return
    }
    bound_err(report, "omit bound on ", fn)
}

propagate_param_bounds() {
    changed: bool = true;
    while (changed) {
        changed = false;
        fn: ?*Function = functions;
        while (fn != null) {
            c: ?*BoundCall = fn.bound_calls;
            while (c != null) {
                if (c.callee_param.bound_need_imm && !c.caller_param.bound_need_imm) {
                    c.caller_param.bound_need_imm = true;
                    changed = true
                }
                if (c.callee_param.bound_need_new && !c.caller_param.bound_need_new) {
                    c.caller_param.bound_need_new = true;
                    changed = true
                }
                c = c.next
            }
            fn = fn.next
        }
    }
}

check_written_bounds(report: *LifetimeDiagnostics@new) noregion raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (!fn.is_extern) {
            p: ?*Obj = fn.params;
            while (p != null) {
                check_written_param(report, fn, p);
                p = p.param_next
            }
            check_written_ret(report, fn)
        }
        fn = fn.next
    }
    if (report.count != 0) raise Error { diagnostic: Diagnostic.Document { text: sb_finish(report.output) } }
}
