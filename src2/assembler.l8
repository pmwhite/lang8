// l8as: minimal x86-64 AT&T assembler → ELF64 ET_REL (elfpack-compatible).
// Usage: l8as -o out.o a.s b.s ...

type as_Sym = {
    as_name: []i8,
    as_val: int,
    as_sec: int,
    as_bind: int,
    as_defined: int,
    as_hash_next: int
}

type as_Rel = {
    as_off: int,
    as_typ: int,
    as_sym: int,
    as_addend: int
}

type as_LocPatch = {
    as_off: int,
    as_next_ip: int,
    as_digit: int
}

type as_LabPatch = {
    as_off: int,
    as_next_ip: int,
    as_next: int
}

as_O_RDONLY: int = 0;
as_O_WRONLY: int = 1;
as_O_CREAT: int = 64;
as_O_TRUNC: int = 512;
as_MODE_755: int = 493;
as_ET_REL: int = 1;
as_EM_X86_64: int = 62;
as_SHN_ABS: int = 65521;
as_SHT_NULL: int = 0;
as_SHT_PROGBITS: int = 1;
as_SHT_SYMTAB: int = 2;
as_SHT_STRTAB: int = 3;
as_SHT_RELA: int = 4;
as_SHT_NOBITS: int = 8;
as_SHF_WRITE: int = 1;
as_SHF_ALLOC: int = 2;
as_SHF_EXECINSTR: int = 4;
as_SHF_INFO_LINK: int = 64;
as_R_X86_64_PC32: int = 2;
as_R_X86_64_PLT32: int = 4;
as_STB_LOCAL: int = 0;
as_STB_GLOBAL: int = 1;
as_SEC_UND: int = 0;
as_SEC_TEXT: int = 1;
as_SEC_RODATA: int = 2;
as_SEC_DATA: int = 3;
as_SEC_BSS: int = 4;
as_SEC_ABS: int = 5;

as_text_buf: []i8 = "";
as_text_len: int = 0;
as_text_cap: int = 524288;
as_rodata_buf: []i8 = "";
as_rodata_len: int = 0;
as_rodata_cap: int = 65536;
as_data_buf: []i8 = "";
as_data_len: int = 0;
as_data_cap: int = 4096;
as_bss_size: int = 0;
as_cur_sec: int = 0;
as_pass_no: int = 0;

as_syms: []as_Sym = new as_Sym[0](as_Sym { as_name: "", as_val: 0, as_sec: 0, as_bind: 0, as_defined: 0, as_hash_next: 0 });
as_nsyms: int = 0;
as_syms_cap: int = 4096;
as_sym_buckets: []int = new int[0](0);
as_SYM_BUCKETS: int = 4096;
as_rels: []as_Rel = new as_Rel[0](as_Rel { as_off: 0, as_typ: 0, as_sym: 0, as_addend: 0 });
as_nrels: int = 0;
as_rels_cap: int = 16384;
as_globls: [][]i8 = new []i8[0](new i8[0](0i8));
as_nglobls: int = 0;
as_globls_cap: int = 1024;
as_globl_buckets: []int = new int[0](0);
as_globl_next: []int = new int[0](0);

as_loc_last_sec: []int = new int[0](0);
as_loc_last_off: []int = new int[0](0);
as_loc_defined: []int = new int[0](0);
as_loc_patches: []as_LocPatch = new as_LocPatch[0](as_LocPatch { as_off: 0, as_next_ip: 0, as_digit: 0 });
as_nloc_patches: int = 0;
as_loc_patches_cap: int = 16;

as_lab_off: []int = new int[0](0);
as_lab_def: []int = new int[0](0);
as_lab_patch: []int = new int[0](0);
as_nlab: int = 0;
as_lab_cap: int = 8192;
as_lpatches: []as_LabPatch = new as_LabPatch[0](as_LabPatch { as_off: 0, as_next_ip: 0, as_next: 0 });
as_nlpatches: int = 0;
as_lpatches_cap: int = 8192;

as_src: []i8 = "";
as_src_len: int = 0;
as_tokbuf: []i8 = "";
as_do_profile: int = 0;

type as_Timespec = { as_sec: int; as_nsec: int; }

as_mono_ns(): int {
    as_ts: as_Timespec = as_Timespec { as_sec: 0, as_nsec: 0 };
    syscall(228, 1, &as_ts, 0, 0, 0);
    as_ts.as_sec * 1000000000 + as_ts.as_nsec;
}

as_emit_num_fd(as_fd: int, as_n: int) {
    if (as_n == 0) { write(as_fd, "0", len("0")); return; }
    as_neg: int = 0;
    if (as_n < 0) { as_neg = 1; as_n = 0 - as_n; }
    as_buf: []i8 = new i8[32](0i8);
    as_i: int = 0;
    while (as_n > 0) {
        as_buf[as_i] = '0' + (as_n % 10) trunc i8;
        as_i = as_i + 1;
        as_n = as_n / 10;
    }
    if (as_neg != 0) { write(as_fd, "-", len("-")); }
    while (as_i > 0) {
        as_i = as_i - 1;
        write(as_fd, &as_buf[as_i], 1);
    }
}

as_profile_print(as_label: []i8, as_dt_ns: int) {
    write(2, "profile: ", len("profile: "));
    write(2, as_label, as_strlen0(as_label));
    write(2, " ", len(" "));
    as_ms: int = as_dt_ns / 1000000;
    as_us: int = (as_dt_ns / 1000) % 1000;
    as_emit_num_fd(2, as_ms);
    write(2, ".", len("."));
    if (as_us < 100) { write(2, "0", len("0")); }
    if (as_us < 10) { write(2, "0", len("0")); }
    as_emit_num_fd(2, as_us);
    write(2, " ms\n", len(" ms\n"));
}

as_is_profile_flag(as_s: [z]i8): bool {
    if (as_s[0] == '-' && as_s[1] == 'p' && as_s[2] == 0i8) { return true; }
    if (as_s[0] == '-' && as_s[1] == '-' && as_s[2] == 'p' && as_s[3] == 'r' && as_s[4] == 'o'
        && as_s[5] == 'f' && as_s[6] == 'i' && as_s[7] == 'l' && as_s[8] == 'e' && as_s[9] == 0i8) {
        return true;
    }
    false;
}


as_expr_s: []i8 = "";
as_expr_n: int = 0;
as_expr_i: int = 0;
as_OP_NONE: int = 0;
as_OP_REG: int = 1;
as_OP_IMM: int = 2;
as_OP_MEM: int = 3;
as_OP_MEMRIP: int = 4;
as_OP_MEMABS: int = 5;
as_OP_SYM: int = 6;
as_OP_LOC: int = 7;
as_OP_INDREG: int = 8;
as_op_kind: int = 0;
as_op_reg: int = 0;
as_op_is_al: int = 0;
as_op_imm: int = 0;
as_op_base: int = 0;
as_op_disp: int = 0;
as_op_name: []i8 = "";
as_op_extra: int = 0;
as_op_digit: int = 0;
as_op_fb: int = 0;
as_op2_kind: int = 0;
as_op2_reg: int = 0;
as_op2_is_al: int = 0;
as_op2_imm: int = 0;
as_op2_base: int = 0;
as_op2_disp: int = 0;
as_op2_name: []i8 = "";
as_op2_extra: int = 0;
as_op2_digit: int = 0;
as_op2_fb: int = 0;
as_jmp_rel_off: int = 0;
as_jmp_next_ip: int = 0;
as_op_a: []i8 = "";
as_op_b: []i8 = "";
as_op_a_buf: []i8 = "";
as_op_b_buf: []i8 = "";
as_args_buf: []i8 = "";
as_mem_base_buf: []i8 = "";
as_mem_disp_buf: []i8 = "";
as_mem_name_buf: []i8 = "";
as_n_ops: int = 0;
as_strtab_buf: []i8 = "";
as_strtab_len: int = 0;
as_strtab_cap: int = 0;

as_sh_out: []i8 = "";
as_sh_base: int = 0;
as_sh_idx: int = 0;
as_sh_nm: int = 0;
as_sh_typ: int = 0;
as_sh_flags: int = 0;
as_sh_offset: int = 0;
as_sh_size: int = 0;
as_sh_link: int = 0;
as_sh_info: int = 0;
as_sh_align: int = 0;
as_sh_entsize: int = 0;


as_fail(as_msg: []i8): noreturn {
    write(2, "l8as: ", len("l8as: "));
    write(2, as_msg, len(as_msg));
    write(2, "\n", len("\n"));
    exit(1);
}

as_memset0(as_dst: []i8, as_off: int, as_n: int) {
    as_i: int = 0;
    while (as_i < as_n) {
        as_dst[as_off + as_i] = 0i8;
        as_i = as_i + 1;
    }
}

as_streq(as_a: []i8, as_b: []i8): bool {
    if (as_a == as_b) { return true; }
    as_i: int = 0;
    while (true) {
        as_ae: bool = as_i >= len(as_a) || as_a[as_i] == 0i8;
        as_be: bool = as_i >= len(as_b) || as_b[as_i] == 0i8;
        if (as_ae || as_be) { return as_ae && as_be; }
        if (as_a[as_i] != as_b[as_i]) { return false; }
        as_i = as_i + 1;
    }
    false;
}

as_strlen0(as_s: []i8): int {
    as_i: int = 0;
    while (as_i < len(as_s) && as_s[as_i] != 0i8) { as_i = as_i + 1; }
    as_i;
}

as_strdup0(as_s: []i8): []i8 {
    as_n: int = as_strlen0(as_s);
    as_p: []i8 = new i8[as_n](0i8);
    memcpy(as_p, 0, as_s, 0, as_n);
    as_p;
}

as_strdup_n(as_s: []i8, as_off: int, as_n: int): []i8 {
    as_p: []i8 = new i8[as_n](0i8);
    memcpy(as_p, 0, as_s, as_off, as_n);
    as_p;
}

as_hash_str(as_s: []i8): int {
    as_h: int = 5381;
    as_i: int = 0;
    while (as_i < len(as_s) && as_s[as_i] != 0i8) {
        as_h = as_h * 33 + (as_s[as_i] as int);
        as_i = as_i + 1;
    }
    if (as_h < 0) { as_h = 0 - as_h; }
    as_h;
}

as_sym_bucket(as_h: int): int {
    as_h % as_SYM_BUCKETS;
}

as_clear_sym_buckets() {
    as_i: int = 0;
    while (as_i < as_SYM_BUCKETS) {
        as_sym_buckets[as_i] = 0 - 1;
        as_globl_buckets[as_i] = 0 - 1;
        as_i = as_i + 1;
    }
}

as_wr_le(as_b: []i8, as_o: int, as_v: int, as_n: int) {
    as_i: int = 0;
    as_x: int = as_v;
    while (as_i < as_n) {
        as_b[as_o + as_i] = (as_x & 255) trunc i8;
        as_x = as_x >> 8;
        as_i = as_i + 1;
    }
}

as_wr16(as_b: []i8, as_o: int, as_v: int) { as_wr_le(as_b, as_o, as_v, 2); }

as_wr32(as_b: []i8, as_o: int, as_v: int) { as_wr_le(as_b, as_o, as_v, 4); }

as_wr64(as_b: []i8, as_o: int, as_v: int) { as_wr_le(as_b, as_o, as_v, 8); }

as_align_up(as_x: int, as_a: int): int {
    ((as_x + as_a - 1) / as_a) * as_a;
}

as_is_digit(as_c: i8): bool {
    as_c >= '0' && as_c <= '9';
}

as_is_ident_start(as_c: i8): bool {
    (as_c >= 'a' && as_c <= 'z') || (as_c >= 'A' && as_c <= 'Z') || as_c == '_' || as_c == '.';
}

as_is_ident(as_c: i8): bool {
    as_is_ident_start(as_c) || as_is_digit(as_c);
}

as_fits_imm8(as_v: int): bool {
    as_v >= 0 - 128 && as_v <= 127;
}

as_fits_imm32(as_v: int): bool {
    as_v >= 0 - 2147483648 && as_v <= 2147483647;
}

as_u8(as_v: int): i8 {
    if (as_v < 0) { as_v = as_v + 256; }
    while (as_v >= 256) { as_v = as_v - 256; }
    as_v trunc i8;
}

/* ---- growable section buffers ---- */

as_ensure_cap(as_which: int, as_need: int) {
    as_buf: []i8 = as_text_buf;
    as_len0: int = as_text_len;
    as_cap: int = as_text_cap;
    if (as_which == as_SEC_RODATA) { as_buf = as_rodata_buf; as_len0 = as_rodata_len; as_cap = as_rodata_cap; }
    if (as_which == as_SEC_DATA) { as_buf = as_data_buf; as_len0 = as_data_len; as_cap = as_data_cap; }
    if (as_len0 + as_need <= as_cap) { return; }
    as_ncap: int = as_cap;
    if (as_ncap < 64) { as_ncap = 64; }
    while (as_len0 + as_need > as_ncap) { as_ncap = as_ncap * 2; }
    as_nbuf: []i8 = new i8[as_ncap](0i8);
    memcpy(as_nbuf, 0, as_buf, 0, as_len0);
    if (as_which == as_SEC_TEXT) { as_text_buf = as_nbuf; as_text_cap = as_ncap; }
    if (as_which == as_SEC_RODATA) { as_rodata_buf = as_nbuf; as_rodata_cap = as_ncap; }
    if (as_which == as_SEC_DATA) { as_data_buf = as_nbuf; as_data_cap = as_ncap; }
}

as_cur_off(): int {
    if (as_cur_sec == as_SEC_BSS) { as_bss_size; }
    else if (as_cur_sec == as_SEC_RODATA) { as_rodata_len; }
    else if (as_cur_sec == as_SEC_DATA) { as_data_len; }
    else { as_text_len; }
}

as_emit_b(as_v: int) {
    if (as_cur_sec == as_SEC_TEXT) {
        if (as_text_len >= as_text_cap) { as_ensure_cap(as_SEC_TEXT, 1); }
        as_text_buf[as_text_len] = as_v trunc i8;
        as_text_len = as_text_len + 1;
        return;
    }
    if (as_cur_sec == as_SEC_BSS) { as_fail("emit in .bss"); }
    if (as_cur_sec == as_SEC_RODATA) {
        if (as_rodata_len >= as_rodata_cap) { as_ensure_cap(as_SEC_RODATA, 1); }
        as_rodata_buf[as_rodata_len] = as_v trunc i8;
        as_rodata_len = as_rodata_len + 1;
        return;
    }
    if (as_data_len >= as_data_cap) { as_ensure_cap(as_SEC_DATA, 1); }
    as_data_buf[as_data_len] = as_v trunc i8;
    as_data_len = as_data_len + 1;
}

as_emit_i32(as_v: int) {
    if (as_cur_sec == as_SEC_TEXT) {
        if (as_text_len + 4 > as_text_cap) { as_ensure_cap(as_SEC_TEXT, 4); }
        as_wr32(as_text_buf, as_text_len, as_v);
        as_text_len = as_text_len + 4;
        return;
    }
    if (as_cur_sec == as_SEC_RODATA) {
        if (as_rodata_len + 4 > as_rodata_cap) { as_ensure_cap(as_SEC_RODATA, 4); }
        as_wr32(as_rodata_buf, as_rodata_len, as_v);
        as_rodata_len = as_rodata_len + 4;
        return;
    }
    if (as_cur_sec == as_SEC_DATA) {
        if (as_data_len + 4 > as_data_cap) { as_ensure_cap(as_SEC_DATA, 4); }
        as_wr32(as_data_buf, as_data_len, as_v);
        as_data_len = as_data_len + 4;
        return;
    }
    as_fail("emit in .bss");
}

as_emit_u64(as_v: int) {
    if (as_cur_sec == as_SEC_TEXT) {
        if (as_text_len + 8 > as_text_cap) { as_ensure_cap(as_SEC_TEXT, 8); }
        as_wr64(as_text_buf, as_text_len, as_v);
        as_text_len = as_text_len + 8;
        return;
    }
    if (as_cur_sec == as_SEC_RODATA) {
        if (as_rodata_len + 8 > as_rodata_cap) { as_ensure_cap(as_SEC_RODATA, 8); }
        as_wr64(as_rodata_buf, as_rodata_len, as_v);
        as_rodata_len = as_rodata_len + 8;
        return;
    }
    if (as_cur_sec == as_SEC_DATA) {
        if (as_data_len + 8 > as_data_cap) { as_ensure_cap(as_SEC_DATA, 8); }
        as_wr64(as_data_buf, as_data_len, as_v);
        as_data_len = as_data_len + 8;
        return;
    }
    as_fail("emit in .bss");
}

as_skip_bytes(as_n: int) {
    if (as_cur_sec == as_SEC_BSS) {
        as_bss_size = as_bss_size + as_n;
        return;
    }
    as_i: int = 0;
    while (as_i < as_n) {
        as_emit_b(0);
        as_i = as_i + 1;
    }
}

as_do_align(as_n: int) {
    as_off: int = as_cur_off();
    as_pad: int = (as_n - (as_off % as_n)) % as_n;
    as_skip_bytes(as_pad);
}

as_emit_rex(as_w: int, as_r: int, as_x: int, as_b: int) {
    as_emit_b(64 + as_w * 8 + as_r * 4 + as_x * 2 + as_b);
}

/* ---- symbols / relocs / globl ---- */

as_is_globl(as_name: []i8): bool {
    as_b: int = as_sym_bucket(as_hash_str(as_name));
    as_i: int = as_globl_buckets[as_b];
    while (as_i >= 0) {
        if (as_streq(as_globls[as_i], as_name)) { return true; }
        as_i = as_globl_next[as_i];
    }
    false;
}

as_add_globl(as_name: []i8) {
    if (as_is_globl(as_name)) { return; }
    if (as_nglobls + 1 > as_globls_cap) {
        as_ncap: int = as_globls_cap * 2;
        if (as_ncap < 16) { as_ncap = 16; }
        as_ng: [][]i8 = new []i8[as_ncap](new i8[0](0i8));
        as_nn: []int = new int[as_ncap](0);
        as_i: int = 0;
        while (as_i < as_nglobls) {
            as_ng[as_i] = as_globls[as_i];
            as_nn[as_i] = as_globl_next[as_i];
            as_i = as_i + 1;
        }
        as_globls = as_ng;
        as_globl_next = as_nn;
        as_globls_cap = as_ncap;
    }
    as_globls[as_nglobls] = as_strdup0(as_name);
    as_b: int = as_sym_bucket(as_hash_str(as_name));
    as_globl_next[as_nglobls] = as_globl_buckets[as_b];
    as_globl_buckets[as_b] = as_nglobls;
    as_nglobls = as_nglobls + 1;
}

as_find_sym(as_name: []i8): int {
    as_b: int = as_sym_bucket(as_hash_str(as_name));
    as_i: int = as_sym_buckets[as_b];
    while (as_i >= 0) {
        if (as_streq(as_syms[as_i].as_name, as_name)) { return as_i; }
        as_i = as_syms[as_i].as_hash_next;
    }
    0 - 1;
}

as_ensure_sym(as_name: []i8): int {
    as_i: int = as_find_sym(as_name);
    if (as_i >= 0) { return as_i; }
    if (as_nsyms + 1 > as_syms_cap) {
        as_ncap: int = as_syms_cap * 2;
        if (as_ncap < 64) { as_ncap = 64; }
        as_ns: []as_Sym = new as_Sym[as_ncap](as_Sym { as_name: "", as_val: 0, as_sec: 0, as_bind: 0, as_defined: 0, as_hash_next: 0 });
        as_j: int = 0;
        while (as_j < as_nsyms) {
            as_ns[as_j].as_name = as_syms[as_j].as_name;
            as_ns[as_j].as_val = as_syms[as_j].as_val;
            as_ns[as_j].as_sec = as_syms[as_j].as_sec;
            as_ns[as_j].as_bind = as_syms[as_j].as_bind;
            as_ns[as_j].as_defined = as_syms[as_j].as_defined;
            as_ns[as_j].as_hash_next = as_syms[as_j].as_hash_next;
            as_j = as_j + 1;
        }
        as_syms = as_ns;
        as_syms_cap = as_ncap;
    }
    as_bind: int = as_STB_LOCAL;
    if (len(as_name) >= 2 && as_name[0] == '.' && as_name[1] == 'L') {
    } else {
        if (as_is_globl(as_name)) { as_bind = as_STB_GLOBAL; }
    }
    as_syms[as_nsyms].as_name = as_strdup0(as_name);
    as_syms[as_nsyms].as_val = 0;
    as_syms[as_nsyms].as_sec = as_SEC_UND;
    as_syms[as_nsyms].as_bind = as_bind;
    as_syms[as_nsyms].as_defined = 0;
    as_b: int = as_sym_bucket(as_hash_str(as_name));
    as_syms[as_nsyms].as_hash_next = as_sym_buckets[as_b];
    as_sym_buckets[as_b] = as_nsyms;
    as_nsyms = as_nsyms + 1;
    as_nsyms - 1;
}

as_define_sym(as_name: []i8) {
    as_i: int = as_ensure_sym(as_name);
    as_syms[as_i].as_val = as_cur_off();
    as_syms[as_i].as_sec = as_cur_sec;
    as_syms[as_i].as_defined = 1;
    if (len(as_name) >= 2 && as_name[0] == '.' && as_name[1] == 'L') { as_syms[as_i].as_bind = as_STB_LOCAL; }
    else {
        if (as_is_globl(as_name)) { as_syms[as_i].as_bind = as_STB_GLOBAL; }
    }
}

as_add_reloc(as_off: int, as_typ: int, as_name: []i8, as_addend: int) {
    as_si: int = as_ensure_sym(as_name);
    if (as_nrels + 1 > as_rels_cap) {
        as_ncap: int = as_rels_cap * 2;
        if (as_ncap < 64) { as_ncap = 64; }
        as_nr: []as_Rel = new as_Rel[as_ncap](as_Rel { as_off: 0, as_typ: 0, as_sym: 0, as_addend: 0 });
        as_j: int = 0;
        while (as_j < as_nrels) {
            as_nr[as_j].as_off = as_rels[as_j].as_off;
            as_nr[as_j].as_typ = as_rels[as_j].as_typ;
            as_nr[as_j].as_sym = as_rels[as_j].as_sym;
            as_nr[as_j].as_addend = as_rels[as_j].as_addend;
            as_j = as_j + 1;
        }
        as_rels = as_nr;
        as_rels_cap = as_ncap;
    }
    as_rels[as_nrels].as_off = as_off;
    as_rels[as_nrels].as_typ = as_typ;
    as_rels[as_nrels].as_sym = as_si;
    as_rels[as_nrels].as_addend = as_addend;
    as_nrels = as_nrels + 1;
}

as_patch_i32(as_off: int, as_v: int) {
    as_wr32(as_text_buf, as_off, as_v);
}

as_lab_grow() {
    as_ncap: int = as_lab_cap * 2;
    if (as_ncap < 64) { as_ncap = 64; }
    as_no: []int = new int[as_ncap](0);
    as_nd: []int = new int[as_ncap](0);
    as_np: []int = new int[as_ncap](0);
    as_i: int = 0;
    while (as_i < as_nlab) {
        as_no[as_i] = as_lab_off[as_i];
        as_nd[as_i] = as_lab_def[as_i];
        as_np[as_i] = as_lab_patch[as_i];
        as_i = as_i + 1;
    }
    as_lab_off = as_no;
    as_lab_def = as_nd;
    as_lab_patch = as_np;
    as_lab_cap = as_ncap;
}

as_lab_ensure(as_id: int) {
    while (as_id >= as_lab_cap) { as_lab_grow(); }
    while (as_nlab <= as_id) {
        as_lab_def[as_nlab] = 0;
        as_lab_patch[as_nlab] = 0 - 1;
        as_nlab = as_nlab + 1;
    }
}

as_add_lab_patch(as_id: int, as_off: int, as_next_ip: int) {
    if (as_nlpatches + 1 > as_lpatches_cap) {
        as_ncap: int = as_lpatches_cap * 2;
        if (as_ncap < 64) { as_ncap = 64; }
        as_np: []as_LabPatch = new as_LabPatch[as_ncap](as_LabPatch { as_off: 0, as_next_ip: 0, as_next: 0 });
        as_j: int = 0;
        while (as_j < as_nlpatches) {
            as_np[as_j].as_off = as_lpatches[as_j].as_off;
            as_np[as_j].as_next_ip = as_lpatches[as_j].as_next_ip;
            as_np[as_j].as_next = as_lpatches[as_j].as_next;
            as_j = as_j + 1;
        }
        as_lpatches = as_np;
        as_lpatches_cap = as_ncap;
    }
    as_lpatches[as_nlpatches].as_off = as_off;
    as_lpatches[as_nlpatches].as_next_ip = as_next_ip;
    as_lpatches[as_nlpatches].as_next = as_lab_patch[as_id];
    as_lab_patch[as_id] = as_nlpatches;
    as_nlpatches = as_nlpatches + 1;
}

as_define_lab(as_id: int) {
    as_lab_ensure(as_id);
    as_lab_off[as_id] = as_cur_off();
    as_lab_def[as_id] = 1;
    as_pi: int = as_lab_patch[as_id];
    while (as_pi >= 0) {
        as_disp: int = as_lab_off[as_id] - as_lpatches[as_pi].as_next_ip;
        as_patch_i32(as_lpatches[as_pi].as_off, as_disp);
        as_pi = as_lpatches[as_pi].as_next;
    }
    as_lab_patch[as_id] = 0 - 1;
}

as_emit_jmp_lab(as_cc: int, as_id: int) {
    as_lab_ensure(as_id);
    if (as_cc < 0) {
        as_emit_b(233);
    } else {
        as_emit_b(15);
        as_emit_b(128 + as_cc);
    }
    as_rel: int = as_cur_off();
    as_emit_i32(0);
    as_next: int = as_cur_off();
    if (as_lab_def[as_id] != 0) {
        as_patch_i32(as_rel, as_lab_off[as_id] - as_next);
    } else {
        as_add_lab_patch(as_id, as_rel, as_next);
    }
}

/* ---- expression parser on tokbuf-style string ---- */


as_expr_ch(): i8 {
    if (as_expr_i >= as_expr_n) { 0i8; }
    else { as_expr_s[as_expr_i]; }
}

as_expr_skip() {
    while (as_expr_ch() == ' ' || as_expr_ch() == '\t') {
        as_expr_i = as_expr_i + 1;
    }
}

as_parse_expr_prim(): int {
    as_expr_skip();
    if (as_expr_ch() == '(') {
        as_expr_i = as_expr_i + 1;
        as_v: int = as_parse_expr_add();
        as_expr_skip();
        if (as_expr_ch() != ')') { as_fail("expr )"); }
        as_expr_i = as_expr_i + 1;
        return as_v;
    }
    as_neg: int = 0;
    if (as_expr_ch() == '-') {
        as_neg = 1;
        as_expr_i = as_expr_i + 1;
    }
    as_expr_skip();
    if (!as_is_digit(as_expr_ch())) { as_fail("bad number"); }
    as_v2: int = 0;
    while (as_is_digit(as_expr_ch())) {
        as_v2 = as_v2 * 10 + ((as_expr_ch() - '0') as int);
        as_expr_i = as_expr_i + 1;
    }
    if (as_neg != 0) { as_v2 = 0 - as_v2; }
    as_v2;
}

as_parse_expr_mul(): int {
    as_v: int = as_parse_expr_prim();
    while (true) {
        as_expr_skip();
        if (as_expr_ch() != '*') { return as_v; }
        as_expr_i = as_expr_i + 1;
        as_w: int = as_parse_expr_prim();
        as_v = as_v * as_w;
    }
    as_v;
}

as_parse_expr_add(): int {
    as_v: int = as_parse_expr_mul();
    while (true) {
        as_expr_skip();
        as_c: i8 = as_expr_ch();
        if (as_c != '+' && as_c != '-') { return as_v; }
        as_expr_i = as_expr_i + 1;
        as_w: int = as_parse_expr_mul();
        if (as_c == '+') { as_v = as_v + as_w; } else { as_v = as_v - as_w; }
    }
    as_v;
}

as_parse_expr_at(as_s: []i8, as_off: int, as_end: int): int {
    as_expr_s = as_s;
    as_expr_n = as_end;
    as_expr_i = as_off;
    as_v: int = as_parse_expr_add();
    as_expr_skip();
    if (as_expr_ch() != 0i8) { as_fail("bad expr trail"); }
    as_v;
}

as_parse_expr(as_s: []i8): int {
    as_parse_expr_at(as_s, 0, as_strlen0(as_s));
}

/* ---- register / operand parsing ---- */
/* Operand kinds stored in globals after parse_operand */



as_reg_code(as_s: []i8, as_o: int, as_n: int): int {
    if (as_n < 1 || as_s[as_o] != '%') { return 0 - 1; }
    if (as_n >= 2 && as_s[as_o + 1] == 'r') {
        if (as_n == 4 && as_s[as_o + 2] == 'a' && as_s[as_o + 3] == 'x') { return 0; }
        if (as_n == 4 && as_s[as_o + 2] == 'c' && as_s[as_o + 3] == 'x') { return 1; }
        if (as_n == 4 && as_s[as_o + 2] == 'd' && as_s[as_o + 3] == 'x') { return 2; }
        if (as_n == 4 && as_s[as_o + 2] == 'b' && as_s[as_o + 3] == 'x') { return 3; }
        if (as_n == 4 && as_s[as_o + 2] == 's' && as_s[as_o + 3] == 'p') { return 4; }
        if (as_n == 4 && as_s[as_o + 2] == 'b' && as_s[as_o + 3] == 'p') { return 5; }
        if (as_n == 4 && as_s[as_o + 2] == 's' && as_s[as_o + 3] == 'i') { return 6; }
        if (as_n == 4 && as_s[as_o + 2] == 'd' && as_s[as_o + 3] == 'i') { return 7; }
        if (as_n == 3 && as_s[as_o + 2] == '8') { return 8; }
        if (as_n == 3 && as_s[as_o + 2] == '9') { return 9; }
        if (as_n == 4 && as_s[as_o + 2] == '1' && as_s[as_o + 3] == '0') { return 10; }
        if (as_n == 4 && as_s[as_o + 2] == '1' && as_s[as_o + 3] == '1') { return 11; }
        if (as_n == 4 && as_s[as_o + 2] == '1' && as_s[as_o + 3] == '2') { return 12; }
        if (as_n == 4 && as_s[as_o + 2] == '1' && as_s[as_o + 3] == '3') { return 13; }
        if (as_n == 4 && as_s[as_o + 2] == '1' && as_s[as_o + 3] == '4') { return 14; }
        if (as_n == 4 && as_s[as_o + 2] == '1' && as_s[as_o + 3] == '5') { return 15; }
        if (as_n == 4 && as_s[as_o + 2] == 'i' && as_s[as_o + 3] == 'p') { return 0 - 2; }
        return 0 - 1;
    }
    if (as_n == 3 && as_s[as_o + 1] == 'a' && as_s[as_o + 2] == 'l') { return 0; }
    if (as_n == 3 && as_s[as_o + 1] == 'c' && as_s[as_o + 2] == 'l') { return 1; }
    0 - 1;
}

as_reg_code_z(as_s: []i8): int {
    as_reg_code(as_s, 0, as_strlen0(as_s));
}

as_save_op1_to_op2() {
    as_op2_kind = as_op_kind;
    as_op2_reg = as_op_reg;
    as_op2_is_al = as_op_is_al;
    as_op2_imm = as_op_imm;
    as_op2_base = as_op_base;
    as_op2_disp = as_op_disp;
    as_op2_name = as_op_name;
    as_op2_extra = as_op_extra;
    as_op2_digit = as_op_digit;
    as_op2_fb = as_op_fb;
}

as_copy_to_buf(as_dst: []i8, as_src: []i8, as_off: int, as_n: int, as_cap: int) {
    if (as_n >= as_cap) { as_fail("token too long"); }
    memcpy(as_dst, 0, as_src, as_off, as_n);
    as_dst[as_n] = 0i8;
}

as_parse_operand(as_s: []i8) {
    as_q: []i8 = as_s;
    as_n0: int = as_strlen0(as_s);
    as_o0: int = 0;
    while (as_o0 < as_n0 && (as_q[as_o0] == ' ' || as_q[as_o0] == '\t')) { as_o0 = as_o0 + 1; }
    as_end: int = as_n0;
    while (as_end > as_o0 && (as_q[as_end - 1] == ' ' || as_q[as_end - 1] == '\t')) {
        as_end = as_end - 1;
    }
    as_op_kind = as_OP_NONE;
    as_op_is_al = 0;
    as_op_extra = 0;
    if (as_end <= as_o0) { return; }
    if (as_q[as_o0] == '*' && as_end - as_o0 > 1 && as_q[as_o0 + 1] == '%') {
        as_r: int = as_reg_code(as_q, as_o0 + 1, as_end - as_o0 - 1);
        if (as_r < 0) { as_fail("bad ind reg"); }
        as_op_kind = as_OP_INDREG;
        as_op_reg = as_r;
        return;
    }
    if (as_q[as_o0] == '$') {
        as_op_kind = as_OP_IMM;
        as_op_imm = as_parse_expr_at(as_q, as_o0 + 1, as_end);
        return;
    }
    if (as_q[as_o0] == '%') {
        as_r2: int = as_reg_code(as_q, as_o0, as_end - as_o0);
        if (as_r2 < 0) { as_fail("bad reg"); }
        as_op_kind = as_OP_REG;
        as_op_reg = as_r2;
        if (as_end - as_o0 == 3 && as_q[as_o0 + 1] == 'a' && as_q[as_o0 + 2] == 'l') { as_op_is_al = 1; }
        return;
    }
    if (as_is_digit(as_q[as_o0])) {
        as_j: int = as_o0;
        as_d: int = 0;
        while (as_j < as_end && as_is_digit(as_q[as_j])) {
            as_d = as_d * 10 + ((as_q[as_j] - '0') as int);
            as_j = as_j + 1;
        }
        if (as_j + 1 == as_end && (as_q[as_j] == 'f' || as_q[as_j] == 'b')) {
            if (as_d > 9) { as_fail("local label >9"); }
            as_op_kind = as_OP_LOC;
            as_op_digit = as_d;
            if (as_q[as_j] == 'f') { as_op_fb = 1; } else { as_op_fb = 0; }
            return;
        }
    }
    as_paren: int = 0 - 1;
    as_k: int = as_o0;
    while (as_k < as_end) {
        if (as_q[as_k] == '(') { as_paren = as_k; }
        as_k = as_k + 1;
    }
    if (as_paren >= as_o0 && as_q[as_end - 1] == ')') {
        as_copy_to_buf(as_mem_base_buf, as_q, as_paren + 1, as_end - as_paren - 2, 64);
        as_copy_to_buf(as_mem_disp_buf, as_q, as_o0, as_paren - as_o0, 512);
        as_base_s: []i8 = as_mem_base_buf;
        as_disp_s: []i8 = as_mem_disp_buf;
        if (as_base_s[0] == '%' && as_base_s[1] == 'r' && as_base_s[2] == 'i' && as_base_s[3] == 'p' && as_base_s[4] == 0i8) {
            if (as_disp_s[0] == 0i8) { as_fail("bare (%rip)"); }
            as_db: []i8 = as_disp_s;
            as_dlen: int = as_strlen0(as_disp_s);
            as_plus: int = 0 - 1;
            as_t: int = 0;
            while (as_t < as_dlen) {
                if (as_db[as_t] == '+') { as_plus = as_t; }
                as_t = as_t + 1;
            }
            if (as_plus >= 0) {
                as_copy_to_buf(as_mem_name_buf, as_db, 0, as_plus, 512);
                as_op_name = as_mem_name_buf;
                as_op_extra = as_parse_expr_at(as_db, as_plus + 1, as_dlen);
            } else {
                as_op_name = as_disp_s;
                as_op_extra = 0;
            }
            as_op_kind = as_OP_MEMRIP;
            return;
        }
        as_br: int = as_reg_code_z(as_base_s);
        if (as_br < 0) { as_fail("bad mem base"); }
        as_op_base = as_br;
        if (as_disp_s[0] == 0i8) {
            as_op_kind = as_OP_MEM;
            as_op_disp = 0;
            return;
        }
        as_dd: []i8 = as_disp_s;
        as_dlen2: int = as_strlen0(as_disp_s);
        as_ti: int = 0;
        if (as_dlen2 > 0 && as_dd[0] == '-') { as_ti = 1; }
        as_allnum: int = 1;
        if (as_ti >= as_dlen2) { as_allnum = 0; }
        while (as_ti < as_dlen2) {
            if (!as_is_digit(as_dd[as_ti])) { as_allnum = 0; }
            as_ti = as_ti + 1;
        }
        if (as_allnum != 0) {
            as_op_kind = as_OP_MEM;
            as_op_disp = as_parse_expr(as_disp_s);
            return;
        }
        as_si: int = as_find_sym(as_disp_s);
        if (as_si >= 0 && as_syms[as_si].as_defined != 0 && as_syms[as_si].as_sec == as_SEC_ABS) {
            as_op_kind = as_OP_MEM;
            as_op_disp = as_syms[as_si].as_val;
            return;
        }
        as_op_kind = as_OP_MEMABS;
        as_op_name = as_disp_s;
        return;
    }
    if (as_is_ident_start(as_q[as_o0])) {
        as_copy_to_buf(as_mem_name_buf, as_q, as_o0, as_end - as_o0, 512);
        as_op_kind = as_OP_SYM;
        as_op_name = as_mem_name_buf;
        return;
    }
    as_fail("bad operand");
}

/* ---- ModRM memory emit ---- */

as_emit_modrm_mem(as_reg: int, as_base: int, as_disp: int, as_rip: int) {
    if (as_rip != 0) {
        as_emit_b(0 + (as_reg % 8) * 8 + 5);
        as_emit_i32(as_disp);
        return;
    }
    as_need_sib: int = 0;
    if ((as_base % 8) == 4) { as_need_sib = 1; }
    as_mod: int = 0;
    if (as_disp == 0 && (as_base % 8) != 5) {
        as_mod = 0;
    } else {
        if (as_fits_imm8(as_disp)) { as_mod = 1; } else { as_mod = 2; }
    }
    if ((as_base % 8) == 5 && as_disp == 0) { as_mod = 1; }
    if (as_need_sib != 0) {
        as_emit_b(as_mod * 64 + (as_reg % 8) * 8 + 4);
        as_emit_b(0 + 4 * 8 + (as_base % 8));
    } else {
        as_emit_b(as_mod * 64 + (as_reg % 8) * 8 + (as_base % 8));
    }
    if (as_mod == 1) { as_emit_b(as_disp); }
    if (as_mod == 2) { as_emit_i32(as_disp); }
}

/* ---- instruction pieces ---- */

as_emit_push(as_r: int) {
    if (as_r >= 8) { as_emit_b(65); as_emit_b(80 + (as_r % 8)); }
    else { as_emit_b(80 + as_r); }
}

as_emit_pop(as_r: int) {
    if (as_r >= 8) { as_emit_b(65); as_emit_b(88 + (as_r % 8)); }
    else { as_emit_b(88 + as_r); }
}

as_emit_mov_rr(as_src: int, as_dst: int) {
    as_emit_rex(1, (as_src / 8) % 2, 0, (as_dst / 8) % 2);
    as_emit_b(137);
    as_emit_b(192 + (as_src % 8) * 8 + (as_dst % 8));
}

as_emit_mov_rm(as_src: int, as_base: int, as_disp: int, as_rip: int, as_name: []i8, as_extra: int) {
    as_rb: int = 0;
    if (as_rip == 0) { as_rb = (as_base / 8) % 2; }
    as_emit_rex(1, (as_src / 8) % 2, 0, as_rb);
    as_emit_b(137);
    if (as_rip != 0) {
        as_off: int = as_cur_off() + 1;
        as_emit_modrm_mem(as_src, 0, 0, 1);
        as_add_reloc(as_off, as_R_X86_64_PC32, as_name, as_extra - 4);
    } else {
        as_emit_modrm_mem(as_src, as_base, as_disp, 0);
    }
}

as_emit_mov_mr(as_dst: int, as_base: int, as_disp: int, as_rip: int, as_name: []i8, as_extra: int) {
    as_rb: int = 0;
    if (as_rip == 0) { as_rb = (as_base / 8) % 2; }
    as_emit_rex(1, (as_dst / 8) % 2, 0, as_rb);
    as_emit_b(139);
    if (as_rip != 0) {
        as_off: int = as_cur_off() + 1;
        as_emit_modrm_mem(as_dst, 0, 0, 1);
        as_add_reloc(as_off, as_R_X86_64_PC32, as_name, as_extra - 4);
    } else {
        as_emit_modrm_mem(as_dst, as_base, as_disp, 0);
    }
}

as_emit_mov_imm_r(as_imm: int, as_dst: int) {
    as_emit_rex(1, 0, 0, (as_dst / 8) % 2);
    if (as_fits_imm32(as_imm)) {
        as_emit_b(199);
        as_emit_b(192 + (as_dst % 8));
        as_emit_i32(as_imm);
    } else {
        as_emit_b(184 + (as_dst % 8));
        as_emit_u64(as_imm);
    }
}

as_emit_lea(as_dst: int, as_base: int, as_disp: int, as_rip: int, as_name: []i8, as_extra: int) {
    as_rb: int = 0;
    if (as_rip == 0) { as_rb = (as_base / 8) % 2; }
    as_emit_rex(1, (as_dst / 8) % 2, 0, as_rb);
    as_emit_b(141);
    if (as_rip != 0) {
        as_off: int = as_cur_off() + 1;
        as_emit_modrm_mem(as_dst, 0, 0, 1);
        as_add_reloc(as_off, as_R_X86_64_PC32, as_name, as_extra - 4);
    } else {
        as_emit_modrm_mem(as_dst, as_base, as_disp, 0);
    }
}

as_emit_alu_imm(as_op_ext: int, as_imm: int, as_dst: int, as_rax_opc: int) {
    if (as_fits_imm8(as_imm)) {
        as_emit_rex(1, 0, 0, (as_dst / 8) % 2);
        as_emit_b(131);
        as_emit_b(192 + as_op_ext * 8 + (as_dst % 8));
        as_emit_b(as_imm);
    } else {
        if (as_dst == 0 && as_rax_opc >= 0) {
            as_emit_rex(1, 0, 0, 0);
            as_emit_b(as_rax_opc);
            as_emit_i32(as_imm);
        } else {
            as_emit_rex(1, 0, 0, (as_dst / 8) % 2);
            as_emit_b(129);
            as_emit_b(192 + as_op_ext * 8 + (as_dst % 8));
            as_emit_i32(as_imm);
        }
    }
}

as_emit_alu_rr(as_opc: int, as_src: int, as_dst: int) {
    as_emit_rex(1, (as_src / 8) % 2, 0, (as_dst / 8) % 2);
    as_emit_b(as_opc);
    as_emit_b(192 + (as_src % 8) * 8 + (as_dst % 8));
}

as_emit_xor_zero(as_r: int) {
    as_h: int = (as_r / 8) % 2;
    if (as_h != 0) { as_emit_b(69); }
    as_emit_b(49);
    as_emit_b(192 + (as_r % 8) * 9);
}

as_emit_test_rr(as_r: int) {
    as_h: int = (as_r / 8) % 2;
    as_emit_rex(1, as_h, 0, as_h);
    as_emit_b(133);
    as_emit_b(192 + (as_r % 8) * 9);
}

as_define_loc(as_digit: int) {
    as_off: int = as_cur_off();
    as_loc_last_sec[as_digit] = as_cur_sec;
    as_loc_last_off[as_digit] = as_off;
    as_loc_defined[as_digit] = 1;
    as_i: int = 0;
    while (as_i < as_nloc_patches) {
        if (as_loc_patches[as_i].as_digit == as_digit) {
            if (as_cur_sec != as_SEC_TEXT) { as_fail("loc label not in text"); }
            as_disp: int = as_off - as_loc_patches[as_i].as_next_ip;
            as_patch_i32(as_loc_patches[as_i].as_off, as_disp);
            as_loc_patches[as_i].as_digit = 0 - 1;
        }
        as_i = as_i + 1;
    }
}

/* jump helpers use pending fields */

as_do_jump_target() {
    if (as_op_kind == as_OP_LOC) {
        if (as_op_fb == 0) {
            if (as_loc_defined[as_op_digit] == 0) { as_fail("no local Nb"); }
            if (as_loc_last_sec[as_op_digit] != as_SEC_TEXT) { as_fail("loc cross-sec"); }
            as_disp: int = as_loc_last_off[as_op_digit] - as_jmp_next_ip;
            as_patch_i32(as_jmp_rel_off, as_disp);
            return;
        }
        if (as_nloc_patches + 1 > as_loc_patches_cap) {
            as_ncap: int = as_loc_patches_cap * 2;
            if (as_ncap < 16) { as_ncap = 16; }
            as_np: []as_LocPatch = new as_LocPatch[as_ncap](as_LocPatch { as_off: 0, as_next_ip: 0, as_digit: 0 });
            as_j: int = 0;
            while (as_j < as_nloc_patches) {
                as_np[as_j].as_off = as_loc_patches[as_j].as_off;
                as_np[as_j].as_next_ip = as_loc_patches[as_j].as_next_ip;
                as_np[as_j].as_digit = as_loc_patches[as_j].as_digit;
                as_j = as_j + 1;
            }
            as_loc_patches = as_np;
            as_loc_patches_cap = as_ncap;
        }
        as_loc_patches[as_nloc_patches].as_off = as_jmp_rel_off;
        as_loc_patches[as_nloc_patches].as_next_ip = as_jmp_next_ip;
        as_loc_patches[as_nloc_patches].as_digit = as_op_digit;
        as_nloc_patches = as_nloc_patches + 1;
        return;
    }
    if (as_op_kind != as_OP_SYM) { as_fail("bad jump target"); }
    /* Always reloc — enables single-pass assembly. */
    as_add_reloc(as_jmp_rel_off, as_R_X86_64_PLT32, as_op_name, 0 - 4);
}

as_emit_call() {
    as_emit_b(232);
    as_jmp_rel_off = as_cur_off();
    as_emit_i32(0);
    as_jmp_next_ip = as_cur_off();
    as_do_jump_target();
}

as_emit_jmp_sym() {
    as_emit_b(233);
    as_jmp_rel_off = as_cur_off();
    as_emit_i32(0);
    as_jmp_next_ip = as_cur_off();
    as_do_jump_target();
}

as_emit_jcc(as_cc: int) {
    as_emit_b(15);
    as_emit_b(128 + as_cc);
    as_jmp_rel_off = as_cur_off();
    as_emit_i32(0);
    as_jmp_next_ip = as_cur_off();
    as_do_jump_target();
}

/* ---- split operands by comma ---- */

as_split_ops(as_args: []i8) {
    as_n0: int = as_strlen0(as_args);
    if (as_n0 >= 512) { as_fail("token too long"); }
    memcpy(as_args_buf, 0, as_args, 0, as_n0);
    as_args_buf[as_n0] = 0i8;
    as_ap: []i8 = as_args_buf;
    as_n_ops = 0;
    as_op_a = as_op_a_buf;
    as_op_b = as_op_b_buf;
    as_op_a_buf[0] = 0i8;
    as_op_b_buf[0] = 0i8;
    as_an0: int = as_n0;
    as_ao: int = 0;
    while (as_ao < as_an0 && (as_ap[as_ao] == ' ' || as_ap[as_ao] == '\t')) { as_ao = as_ao + 1; }
    if (as_ao >= as_an0) { return; }
    as_an: int = as_an0;
    as_depth: int = 0;
    as_i: int = as_ao;
    as_start: int = as_ao;
    while (as_i < as_an) {
        if (as_ap[as_i] == '(') { as_depth = as_depth + 1; }
        if (as_ap[as_i] == ')') { as_depth = as_depth - 1; }
        if (as_ap[as_i] == ',' && as_depth == 0) {
            as_copy_to_buf(as_op_a_buf, as_ap, as_start, as_i - as_start, 512);
            as_n_ops = 1;
            as_start = as_i + 1;
            as_copy_to_buf(as_op_b_buf, as_ap, as_start, as_an - as_start, 512);
            as_n_ops = 2;
            return;
        }
        as_i = as_i + 1;
    }
    as_copy_to_buf(as_op_a_buf, as_ap, as_ao, as_an - as_ao, 512);
    as_n_ops = 1;
}

as_insn(as_mnem: []i8, as_args: []i8) {
    as_split_ops(as_args);
    if (as_n_ops >= 1) { as_parse_operand(as_op_a); }
    if (as_n_ops >= 2) {
        as_save_op1_to_op2();
        as_parse_operand(as_op_b);
        /* now op_* is second, op2_* is first — swap naming: AT&T src,dst
           So first operand = op2, second = op */
    }

    if (as_streq(as_mnem, "push") && as_n_ops == 1 && as_op_kind == as_OP_REG) {
        as_emit_push(as_op_reg); return;
    }
    if (as_streq(as_mnem, "pop") && as_n_ops == 1 && as_op_kind == as_OP_REG) {
        as_emit_pop(as_op_reg); return;
    }
    if (as_streq(as_mnem, "ret")) { as_emit_b(195); return; }
    if (as_streq(as_mnem, "syscall")) { as_emit_b(15); as_emit_b(5); return; }
    if (as_streq(as_mnem, "cqo")) { as_emit_b(72); as_emit_b(153); return; }
    if (as_streq(as_mnem, "neg") && as_op_kind == as_OP_REG) {
        as_emit_rex(1, 0, 0, (as_op_reg / 8) % 2);
        as_emit_b(247);
        as_emit_b(216 + (as_op_reg % 8));
        return;
    }
    if (as_streq(as_mnem, "not") && as_op_kind == as_OP_REG) {
        as_emit_rex(1, 0, 0, (as_op_reg / 8) % 2);
        as_emit_b(247);
        as_emit_b(208 + (as_op_reg % 8));
        return;
    }
    if (as_streq(as_mnem, "idiv") && as_op_kind == as_OP_REG) {
        as_emit_rex(1, 0, 0, (as_op_reg / 8) % 2);
        as_emit_b(247);
        as_emit_b(248 + (as_op_reg % 8));
        return;
    }
    if (as_streq(as_mnem, "test") && as_n_ops == 2 && as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
        as_emit_rex(1, (as_op2_reg / 8) % 2, 0, (as_op_reg / 8) % 2);
        as_emit_b(133);
        as_emit_b(192 + (as_op2_reg % 8) * 8 + (as_op_reg % 8));
        return;
    }
    if (as_streq(as_mnem, "xor") && as_n_ops == 2 && as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
        as_emit_alu_imm(6, as_op2_imm, as_op_reg, 53); return;
    }
    if (as_streq(as_mnem, "xor") && as_n_ops == 2 && as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
        if (as_op2_reg == as_op_reg) { as_emit_xor_zero(as_op_reg); return; }
        as_emit_rex(1, (as_op2_reg / 8) % 2, 0, (as_op_reg / 8) % 2);
        as_emit_b(49);
        as_emit_b(192 + (as_op2_reg % 8) * 8 + (as_op_reg % 8));
        return;
    }
    if (as_streq(as_mnem, "sete")) { as_emit_b(15); as_emit_b(148); as_emit_b(192); return; }
    if (as_streq(as_mnem, "setne")) { as_emit_b(15); as_emit_b(149); as_emit_b(192); return; }
    if (as_streq(as_mnem, "setl")) { as_emit_b(15); as_emit_b(156); as_emit_b(192); return; }
    if (as_streq(as_mnem, "setle")) { as_emit_b(15); as_emit_b(158); as_emit_b(192); return; }
    if (as_streq(as_mnem, "setg")) { as_emit_b(15); as_emit_b(159); as_emit_b(192); return; }
    if (as_streq(as_mnem, "setge")) { as_emit_b(15); as_emit_b(157); as_emit_b(192); return; }

    if (as_streq(as_mnem, "call") && as_n_ops == 1) {
        /* target in op_* */
        as_emit_call(); return;
    }
    if (as_streq(as_mnem, "jmp") && as_n_ops == 1) {
        if (as_op_kind == as_OP_INDREG) {
            if (as_op_reg >= 8) {
                as_emit_b(65); as_emit_b(255); as_emit_b(224 + (as_op_reg % 8));
            } else {
                as_emit_b(255); as_emit_b(224 + as_op_reg);
            }
            return;
        }
        as_emit_jmp_sym(); return;
    }
    if (as_streq(as_mnem, "je") || as_streq(as_mnem, "jz")) { as_emit_jcc(4); return; }
    if (as_streq(as_mnem, "jne")) { as_emit_jcc(5); return; }
    if (as_streq(as_mnem, "ja")) { as_emit_jcc(7); return; }

    if (as_streq(as_mnem, "movzb")) {
        /* op2=src, op=dst */
        as_dst: int = as_op_reg;
        if (as_op2_kind == as_OP_REG) {
            as_emit_rex(1, (as_dst / 8) % 2, 0, (as_op2_reg / 8) % 2);
            as_emit_b(15); as_emit_b(182);
            as_emit_b(192 + (as_dst % 8) * 8 + (as_op2_reg % 8));
        } else {
            if (as_op2_kind == as_OP_MEM) {
                as_emit_rex(1, (as_dst / 8) % 2, 0, (as_op2_base / 8) % 2);
                as_emit_b(15); as_emit_b(182);
                as_emit_modrm_mem(as_dst, as_op2_base, as_op2_disp, 0);
            } else { as_fail("movzb"); }
        }
        return;
    }

    if (as_streq(as_mnem, "movb")) {
        if (as_op2_kind == as_OP_REG && as_op2_is_al != 0 && as_op_kind == as_OP_MEM) {
            if ((as_op_base / 8) % 2 != 0) { as_emit_b(65); }
            as_emit_b(136);
            as_emit_modrm_mem(0, as_op_base, as_op_disp, 0);
            return;
        }
        as_imm: int = as_op2_imm;
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_MEM) {
            if ((as_op_base / 8) % 2 != 0) { as_emit_b(65); }
            as_emit_b(198);
            as_emit_modrm_mem(0, as_op_base, as_op_disp, 0);
            as_emit_b(as_imm);
        } else { as_fail("movb"); }
        return;
    }

    if (as_streq(as_mnem, "movq")) {
        as_imm2: int = as_op2_imm;
        if (as_op_kind == as_OP_MEM) {
            as_emit_rex(1, 0, 0, (as_op_base / 8) % 2);
            as_emit_b(199);
            as_emit_modrm_mem(0, as_op_base, as_op_disp, 0);
            as_emit_i32(as_imm2);
        } else {
            if (as_op_kind == as_OP_MEMRIP) {
                as_emit_rex(1, 0, 0, 0);
                as_emit_b(199);
                as_off: int = as_cur_off() + 1;
                as_emit_modrm_mem(0, 0, 0, 1);
                as_add_reloc(as_off, as_R_X86_64_PC32, as_op_name, as_op_extra - 8);
                as_emit_i32(as_imm2);
            } else { as_fail("movq"); }
        }
        return;
    }

    if (as_streq(as_mnem, "mov")) {
        /* op2=src, op=dst */
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_emit_mov_imm_r(as_op2_imm, as_op_reg); return;
        }
        if (as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
            as_emit_mov_rr(as_op2_reg, as_op_reg); return;
        }
        if (as_op2_kind == as_OP_REG && as_op2_is_al != 0 && as_op_kind == as_OP_MEM) {
            if ((as_op_base / 8) % 2 != 0) { as_emit_b(65); }
            as_emit_b(136);
            as_emit_modrm_mem(0, as_op_base, as_op_disp, 0);
            return;
        }
        if (as_op2_kind == as_OP_REG && as_op_kind == as_OP_MEM) {
            as_emit_mov_rm(as_op2_reg, as_op_base, as_op_disp, 0, "", 0); return;
        }
        if (as_op2_kind == as_OP_REG && as_op_kind == as_OP_MEMRIP) {
            as_emit_mov_rm(as_op2_reg, 0, 0, 1, as_op_name, as_op_extra); return;
        }
        if (as_op2_kind == as_OP_MEM && as_op_kind == as_OP_REG) {
            as_emit_mov_mr(as_op_reg, as_op2_base, as_op2_disp, 0, "", 0); return;
        }
        if (as_op2_kind == as_OP_MEMRIP && as_op_kind == as_OP_REG) {
            as_emit_mov_mr(as_op_reg, 0, 0, 1, as_op2_name, as_op2_extra); return;
        }
        as_fail("mov form");
    }

    if (as_streq(as_mnem, "lea")) {
        if (as_op2_kind == as_OP_MEM && as_op_kind == as_OP_REG) {
            as_emit_lea(as_op_reg, as_op2_base, as_op2_disp, 0, "", 0); return;
        }
        if (as_op2_kind == as_OP_MEMABS && as_op_kind == as_OP_REG) {
            as_si: int = as_find_sym(as_op2_name);
            if (as_si < 0 || as_syms[as_si].as_sec != as_SEC_ABS) { as_fail("lea abs"); }
            as_emit_lea(as_op_reg, as_op2_base, as_syms[as_si].as_val, 0, "", 0); return;
        }
        if (as_op2_kind == as_OP_MEMRIP && as_op_kind == as_OP_REG) {
            as_emit_lea(as_op_reg, 0, 0, 1, as_op2_name, as_op2_extra); return;
        }
        as_fail("lea form");
    }

    if (as_streq(as_mnem, "add")) {
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_emit_alu_imm(0, as_op2_imm, as_op_reg, 5); return;
        }
        if (as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
            as_emit_alu_rr(1, as_op2_reg, as_op_reg); return;
        }
        as_fail("add");
    }
    if (as_streq(as_mnem, "sub")) {
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_emit_alu_imm(5, as_op2_imm, as_op_reg, 45); return;
        }
        if (as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
            as_emit_alu_rr(41, as_op2_reg, as_op_reg); return;
        }
        as_fail("sub");
    }
    if (as_streq(as_mnem, "and")) {
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_emit_alu_imm(4, as_op2_imm, as_op_reg, 37); return;
        }
        if (as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
            as_emit_alu_rr(33, as_op2_reg, as_op_reg); return;
        }
        as_fail("and");
    }
    if (as_streq(as_mnem, "or")) {
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_emit_alu_imm(1, as_op2_imm, as_op_reg, 13); return;
        }
        if (as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
            as_emit_alu_rr(9, as_op2_reg, as_op_reg); return;
        }
        as_fail("or");
    }
    if (as_streq(as_mnem, "shl") || as_streq(as_mnem, "sal")) {
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_emit_rex(1, 0, 0, (as_op_reg / 8) % 2);
            as_emit_b(193);
            as_emit_b(192 + 4 * 8 + (as_op_reg % 8));
            as_emit_b(as_op2_imm);
            return;
        }
        if (as_op2_kind == as_OP_REG && as_op2_reg == 1 && as_op_kind == as_OP_REG) {
            as_emit_rex(1, 0, 0, (as_op_reg / 8) % 2);
            as_emit_b(211);
            as_emit_b(192 + 4 * 8 + (as_op_reg % 8));
            return;
        }
        as_fail("shl");
    }
    if (as_streq(as_mnem, "sar")) {
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_emit_rex(1, 0, 0, (as_op_reg / 8) % 2);
            as_emit_b(193);
            as_emit_b(192 + 7 * 8 + (as_op_reg % 8));
            as_emit_b(as_op2_imm);
            return;
        }
        if (as_op2_kind == as_OP_REG && as_op2_reg == 1 && as_op_kind == as_OP_REG) {
            as_emit_rex(1, 0, 0, (as_op_reg / 8) % 2);
            as_emit_b(211);
            as_emit_b(192 + 7 * 8 + (as_op_reg % 8));
            return;
        }
        as_fail("sar");
    }
    if (as_streq(as_mnem, "cmp")) {
        if (as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_emit_alu_imm(7, as_op2_imm, as_op_reg, 61); return;
        }
        if (as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
            as_emit_alu_rr(57, as_op2_reg, as_op_reg); return;
        }
        if (as_op2_kind == as_OP_MEMRIP && as_op_kind == as_OP_REG) {
            as_emit_rex(1, (as_op_reg / 8) % 2, 0, 0);
            as_emit_b(59);
            as_off2: int = as_cur_off() + 1;
            as_emit_modrm_mem(as_op_reg, 0, 0, 1);
            as_add_reloc(as_off2, as_R_X86_64_PC32, as_op2_name, as_op2_extra - 4);
            return;
        }
        as_fail("cmp");
    }
    if (as_streq(as_mnem, "imul")) {
        if (as_n_ops == 2 && as_op2_kind == as_OP_IMM && as_op_kind == as_OP_REG) {
            as_dst2: int = as_op_reg;
            as_imm3: int = as_op2_imm;
            as_rb: int = (as_dst2 / 8) % 2;
            as_emit_rex(1, as_rb, 0, as_rb);
            if (as_fits_imm8(as_imm3)) {
                as_emit_b(107);
                as_emit_b(192 + (as_dst2 % 8) * 8 + (as_dst2 % 8));
                as_emit_b(as_imm3);
            } else {
                as_emit_b(105);
                as_emit_b(192 + (as_dst2 % 8) * 8 + (as_dst2 % 8));
                as_emit_i32(as_imm3);
            }
            return;
        }
        if (as_n_ops == 2 && as_op2_kind == as_OP_REG && as_op_kind == as_OP_REG) {
            as_emit_rex(1, (as_op_reg / 8) % 2, 0, (as_op2_reg / 8) % 2);
            as_emit_b(15); as_emit_b(175);
            as_emit_b(192 + (as_op_reg % 8) * 8 + (as_op2_reg % 8));
            return;
        }
        as_fail("imul");
    }
    as_fail("unknown instruction");
}

as_directive(as_lp: []i8, as_o: int, as_ln: int) {
    as_i: int = as_o;
    while (as_i < as_ln && as_lp[as_i] != ' ' && as_lp[as_i] != '\t') {
        as_i = as_i + 1;
    }
    as_copy_to_buf(as_tokbuf, as_lp, as_o, as_i - as_o, 1024);
    as_dname: []i8 = as_tokbuf;
    while (as_i < as_ln && (as_lp[as_i] == ' ' || as_lp[as_i] == '\t')) { as_i = as_i + 1; }
    as_argn: int = as_ln - as_i;
    as_arg: []i8 = as_lp;
    as_arg0: int = as_i;
    if (as_streq(as_dname, ".section")) {
        as_j: int = 0;
        while (as_j < as_argn && as_arg[as_arg0 + as_j] != ' ' && as_arg[as_arg0 + as_j] != '\t') { as_j = as_j + 1; }
        as_copy_to_buf(as_mem_name_buf, as_arg, as_arg0, as_j, 512);
        as_sec: []i8 = as_mem_name_buf;
        if (as_streq(as_sec, ".text")) { as_cur_sec = as_SEC_TEXT; }
        else {
            if (as_streq(as_sec, ".rodata")) { as_cur_sec = as_SEC_RODATA; }
            else {
                if (as_streq(as_sec, ".data")) { as_cur_sec = as_SEC_DATA; }
                else {
                    if (as_streq(as_sec, ".bss")) { as_cur_sec = as_SEC_BSS; }
                    else { as_fail("bad section"); }
                }
            }
        }
        return;
    }
    if (as_streq(as_dname, ".align")) {
        as_do_align(as_parse_expr_at(as_arg, as_arg0, as_ln));
        return;
    }
    if (as_streq(as_dname, ".globl")) {
        as_j3: int = 0;
        while (as_j3 < as_argn && as_arg[as_arg0 + as_j3] != ' ' && as_arg[as_arg0 + as_j3] != '\t') { as_j3 = as_j3 + 1; }
        as_copy_to_buf(as_mem_name_buf, as_arg, as_arg0, as_j3, 512);
        as_gn: []i8 = as_mem_name_buf;
        as_add_globl(as_gn);
        as_gi: int = as_find_sym(as_gn);
        if (as_gi >= 0) { as_syms[as_gi].as_bind = as_STB_GLOBAL; }
        return;
    }
    if (as_streq(as_dname, ".equ")) {
        as_cpos: int = as_arg0;
        while (as_cpos < as_ln && as_arg[as_cpos] != ',') { as_cpos = as_cpos + 1; }
        if (as_cpos >= as_ln || as_arg[as_cpos] != ',') { as_fail(".equ"); }
        as_lo: int = as_arg0;
        while (as_lo < as_cpos && as_arg[as_lo] == ' ') { as_lo = as_lo + 1; }
        as_hi: int = as_cpos;
        while (as_hi > as_lo && as_arg[as_hi - 1] == ' ') { as_hi = as_hi - 1; }
        as_nm: []i8 = as_strdup_n(as_arg, as_lo, as_hi - as_lo);
        as_val: int = as_parse_expr_at(as_arg, as_cpos + 1, as_ln);
        as_si: int = as_ensure_sym(as_nm);
        as_syms[as_si].as_val = as_val;
        as_syms[as_si].as_sec = as_SEC_ABS;
        as_syms[as_si].as_defined = 1;
        return;
    }
    if (as_streq(as_dname, ".quad")) {
        as_emit_u64(as_parse_expr_at(as_arg, as_arg0, as_ln));
        return;
    }
    if (as_streq(as_dname, ".byte")) {
        as_bp: int = as_arg0;
        while (as_bp < as_ln) {
            while (as_bp < as_ln && (as_arg[as_bp] == ' ' || as_arg[as_bp] == '\t')) { as_bp = as_bp + 1; }
            if (as_bp >= as_ln) { return; }
            as_start: int = as_bp;
            while (as_bp < as_ln && as_arg[as_bp] != ',') { as_bp = as_bp + 1; }
            as_copy_to_buf(as_mem_base_buf, as_arg, as_start, as_bp - as_start, 64);
            as_emit_b(as_parse_expr(as_mem_base_buf));
            if (as_bp >= as_ln) { return; }
            as_bp = as_bp + 1;
        }
        return;
    }
    if (as_streq(as_dname, ".skip")) {
        as_skip_bytes(as_parse_expr_at(as_arg, as_arg0, as_ln));
        return;
    }
    as_fail("unknown directive");
}

as_handle_line(as_line: []i8, as_lo: int, as_hi: int) {
    as_n: int = as_hi;
    as_i: int = as_lo;
    while (as_i < as_n) {
        if (as_line[as_i] == 35i8) {
            as_n = as_i;
        } else {
            as_i = as_i + 1;
        }
    }
    as_o: int = as_lo;
    while (as_o < as_n && (as_line[as_o] == ' ' || as_line[as_o] == '\t')) { as_o = as_o + 1; }
    if (as_o >= as_n) { return; }
    as_more_labels: int = 1;
    while (as_more_labels != 0) {
        as_took: int = 0;
        if (as_o < as_n && as_is_digit(as_line[as_o])) {
            as_j: int = as_o;
            as_d: int = 0;
            while (as_j < as_n && as_is_digit(as_line[as_j])) {
                as_d = as_d * 10 + ((as_line[as_j] - '0') as int);
                as_j = as_j + 1;
            }
            if (as_j < as_n && as_line[as_j] == ':') {
                if (as_d > 9) { as_fail("local label >9"); }
                as_define_loc(as_d);
                as_o = as_j + 1;
                while (as_o < as_n && (as_line[as_o] == ' ' || as_line[as_o] == '\t')) { as_o = as_o + 1; }
                if (as_o >= as_n) { return; }
                as_took = 1;
            }
        }
        if (as_took == 0 && as_o < as_n && as_is_ident_start(as_line[as_o])) {
            as_j2: int = as_o;
            while (as_j2 < as_n && as_is_ident(as_line[as_j2])) { as_j2 = as_j2 + 1; }
            if (as_j2 < as_n && as_line[as_j2] == ':') {
                as_copy_to_buf(as_mem_disp_buf, as_line, as_o, as_j2 - as_o, 512);
                as_define_sym(as_mem_disp_buf);
                as_o = as_j2 + 1;
                while (as_o < as_n && (as_line[as_o] == ' ' || as_line[as_o] == '\t')) { as_o = as_o + 1; }
                if (as_o >= as_n) { return; }
                as_took = 1;
            }
        }
        if (as_took == 0) { as_more_labels = 0; }
    }
    if (as_o < as_n && as_line[as_o] == '.') {
        as_directive(as_line, as_o, as_n);
        return;
    }
    as_m: int = as_o;
    while (as_m < as_n && as_line[as_m] != ' ' && as_line[as_m] != '\t') { as_m = as_m + 1; }
    as_copy_to_buf(as_tokbuf, as_line, as_o, as_m - as_o, 1024);
    while (as_m < as_n && (as_line[as_m] == ' ' || as_line[as_m] == '\t')) { as_m = as_m + 1; }
    as_args: []i8 = "";
    if (as_m < as_n) {
        as_copy_to_buf(as_op_b_buf, as_line, as_m, as_n - as_m, 512);
        as_args = as_op_b_buf;
    }
    as_insn(as_tokbuf, as_args);
}
as_reset_buffers() {
    as_text_len = 0;
    as_rodata_len = 0;
    as_data_len = 0;
    as_bss_size = 0;
    as_cur_sec = as_SEC_TEXT;
    as_nloc_patches = 0;
    as_di: int = 0;
    while (as_di < 10) {
        as_loc_defined[as_di] = 0;
        as_di = as_di + 1;
    }
}

as_assemble_buf(as_buf: []i8, as_n: int) {
    as_pass_no = 1;
    as_reset_buffers();
    as_nrels = 0;
    as_assemble_append(as_buf, as_n);
}

as_assemble_append(as_buf: []i8, as_n: int) {
    as_pos: int = 0;
    while (as_pos < as_n) {
        as_start: int = as_pos;
        while (as_pos < as_n && as_buf[as_pos] != '\n') { as_pos = as_pos + 1; }
        as_handle_line(as_buf, as_start, as_pos);
        if (as_pos < as_n) { as_pos = as_pos + 1; }
    }
    as_pi: int = 0;
    while (as_pi < as_nloc_patches) {
        if (as_loc_patches[as_pi].as_digit >= 0) { as_fail("undefined local label"); }
        as_pi = as_pi + 1;
    }
}

as_assemble_file_append(as_path: []i8) {
    as_fd: int = open_path(as_path, as_O_RDONLY, 0);
    if (as_fd < 0) { as_fail("cannot open runtime.s"); }
    as_cap: int = 16384;
    as_buf: []i8 = new i8[as_cap](0i8);
    as_n: int = 0;
    while (true) {
        as_room: int = as_cap - as_n;
        if (as_room <= 1) {
            as_ncap: int = as_cap * 2;
            as_tmp: []i8 = new i8[as_ncap](0i8);
            memcpy(as_tmp, 0, as_buf, 0, as_n);
            as_buf = as_tmp;
            as_cap = as_ncap;
            as_room = as_cap - as_n;
        }
        as_r: int = read(as_fd, as_buf, as_n, as_room - 1);
        if (as_r <= 0) {
            close(as_fd);
            as_buf[as_n] = '\n';
            as_assemble_append(as_buf, as_n + 1);
            return;
        }
        as_n = as_n + as_r;
    }
}

as_init() {
    as_text_buf = new i8[as_text_cap](0i8);
    as_text_len = 0;
    as_rodata_buf = new i8[as_rodata_cap](0i8);
    as_rodata_len = 0;
    as_data_buf = new i8[as_data_cap](0i8);
    as_data_len = 0;
    as_bss_size = 0;
    as_syms = new as_Sym[as_syms_cap](as_Sym { as_name: "", as_val: 0, as_sec: 0, as_bind: 0, as_defined: 0, as_hash_next: 0 });
    as_nsyms = 0;
    as_sym_buckets = new int[as_SYM_BUCKETS](0);
    as_globl_buckets = new int[as_SYM_BUCKETS](0);
    as_clear_sym_buckets();
    as_rels = new as_Rel[as_rels_cap](as_Rel { as_off: 0, as_typ: 0, as_sym: 0, as_addend: 0 });
    as_nrels = 0;
    as_globls = new []i8[as_globls_cap](new i8[0](0i8));
    as_globl_next = new int[as_globls_cap](0);
    as_nglobls = 0;
    as_loc_last_sec = new int[10](0);
    as_loc_last_off = new int[10](0);
    as_loc_defined = new int[10](0);
    as_loc_patches = new as_LocPatch[as_loc_patches_cap](as_LocPatch { as_off: 0, as_next_ip: 0, as_digit: 0 });
    as_nloc_patches = 0;
    as_lab_off = new int[as_lab_cap](0);
    as_lab_def = new int[as_lab_cap](0);
    as_lab_patch = new int[as_lab_cap](0);
    as_nlab = 0;
    as_lpatches = new as_LabPatch[as_lpatches_cap](as_LabPatch { as_off: 0, as_next_ip: 0, as_next: 0 });
    as_nlpatches = 0;
    as_tokbuf = new i8[1024](0i8);
    as_op_a_buf = new i8[512](0i8);
    as_op_b_buf = new i8[512](0i8);
    as_args_buf = new i8[512](0i8);
    as_mem_base_buf = new i8[64](0i8);
    as_mem_disp_buf = new i8[512](0i8);
    as_mem_name_buf = new i8[512](0i8);
    as_op_a = as_op_a_buf;
    as_op_b = as_op_b_buf;
}


as_is_dash_o(as_s: [z]i8): bool {
    as_s[0] == '-' && as_s[1] == 'o' && as_s[2] == 0i8;
}





as_zcopy(as_dst: []i8, as_di: int, as_src: []i8, as_n: int) {
    as_i: int = 0;
    while (as_i < as_n) {
        as_dst[as_di + as_i] = as_src[as_i];
        as_i = as_i + 1;
    }
}

as_str_add(as_s: []i8): int {
    as_n: int = as_strlen0(as_s);
    if (as_strtab_len + as_n + 1 > as_strtab_cap) {
        as_ncap: int = as_strtab_cap * 2;
        while (as_strtab_len + as_n + 1 > as_ncap) { as_ncap = as_ncap * 2; }
        as_nb: []i8 = new i8[as_ncap](0i8);
        memcpy(as_nb, 0, as_strtab_buf, 0, as_strtab_len);
        as_strtab_buf = as_nb;
        as_strtab_cap = as_ncap;
    }
    as_off: int = as_strtab_len;
    as_zcopy(as_strtab_buf, as_strtab_len, as_s, as_n);
    as_strtab_len = as_strtab_len + as_n;
    as_strtab_buf[as_strtab_len] = 0i8;
    as_strtab_len = as_strtab_len + 1;
    as_off;
}

as_shstr_put(as_buf: []i8, as_pos: int, as_s: []i8): int {
    as_n: int = as_strlen0(as_s);
    as_zcopy(as_buf, as_pos, as_s, as_n);
    as_buf[as_pos + as_n] = 0i8;
    as_pos + as_n + 1;
}

as_build_shstr(as_buf: []i8): int {
    as_buf[0] = 0i8;
    as_pos: int = 1;
    as_pos = as_shstr_put(as_buf, as_pos, ".text");
    as_pos = as_shstr_put(as_buf, as_pos, ".rela.text");
    as_pos = as_shstr_put(as_buf, as_pos, ".data");
    as_pos = as_shstr_put(as_buf, as_pos, ".bss");
    as_pos = as_shstr_put(as_buf, as_pos, ".rodata");
    as_pos = as_shstr_put(as_buf, as_pos, ".symtab");
    as_pos = as_shstr_put(as_buf, as_pos, ".strtab");
    as_shstr_put(as_buf, as_pos, ".shstrtab");
}

as_sh_name_off(as_shstr: []i8, as_shstr_len: int, as_name: []i8): int {
    as_nm: []i8 = as_name;
    as_nlen: int = as_strlen0(as_name);
    as_i: int = 0;
    while (as_i < as_shstr_len) {
        if (as_i == 0 || as_shstr[as_i - 1] == 0i8) {
            as_j: int = 0;
            as_ok: int = 1;
            while (as_j < as_nlen) {
                if (as_i + as_j >= as_shstr_len || as_shstr[as_i + as_j] != as_nm[as_j]) { as_ok = 0; }
                as_j = as_j + 1;
            }
            if (as_ok != 0 && as_i + as_nlen < as_shstr_len && as_shstr[as_i + as_nlen] == 0i8) { return as_i; }
        }
        as_i = as_i + 1;
    }
    as_fail("sh name");
    0;
}



as_write_one_sh() {
    as_sh: int = as_sh_base + as_sh_idx * 64;
    as_wr32(as_sh_out, as_sh + 0, as_sh_nm);
    as_wr32(as_sh_out, as_sh + 4, as_sh_typ);
    as_wr64(as_sh_out, as_sh + 8, as_sh_flags);
    as_wr64(as_sh_out, as_sh + 16, 0);
    as_wr64(as_sh_out, as_sh + 24, as_sh_offset);
    as_wr64(as_sh_out, as_sh + 32, as_sh_size);
    as_wr32(as_sh_out, as_sh + 40, as_sh_link);
    as_wr32(as_sh_out, as_sh + 44, as_sh_info);
    as_wr64(as_sh_out, as_sh + 48, as_sh_align);
    as_wr64(as_sh_out, as_sh + 56, as_sh_entsize);
}

as_write_object(as_path: [z]i8) {
    as_gi: int = 0;
    while (as_gi < as_nglobls) {
        as_si: int = as_find_sym(as_globls[as_gi]);
        if (as_si >= 0) { as_syms[as_si].as_bind = as_STB_GLOBAL; }
        as_gi = as_gi + 1;
    }

    as_strtab_cap = 8192;
    as_strtab_buf = new i8[as_strtab_cap](0i8);
    as_strtab_len = 1;
    as_strtab_buf[0] = 0i8;

    as_order: []int = new int[as_nsyms + 1](0);
    as_norder: int = 0;
    as_first_global: int = 1;
    as_phase: int = 0;
    while (as_phase < 3) {
        as_i: int = 0;
        while (as_i < as_nsyms) {
            as_take: int = 0;
            if (as_phase == 0 && as_syms[as_i].as_defined != 0 && as_syms[as_i].as_bind == as_STB_LOCAL) { as_take = 1; }
            if (as_phase == 1 && as_syms[as_i].as_defined != 0 && as_syms[as_i].as_bind == as_STB_GLOBAL) { as_take = 1; }
            if (as_phase == 2 && as_syms[as_i].as_defined == 0) { as_take = 1; }
            if (as_take != 0) {
                as_order[as_norder] = as_i;
                as_norder = as_norder + 1;
            }
            as_i = as_i + 1;
        }
        if (as_phase == 0) { as_first_global = 1 + as_norder; }
        as_phase = as_phase + 1;
    }

    as_new_index: []int = new int[as_nsyms + 1](0);
    as_zi: int = 0;
    while (as_zi < as_nsyms) { as_new_index[as_zi] = 0; as_zi = as_zi + 1; }

    as_symtab_sz: int = (as_norder + 1) * 24;
    as_symtab: []i8 = new i8[as_symtab_sz](0i8);
    as_memset0(as_symtab, 0, as_symtab_sz);

    as_oi: int = 0;
    while (as_oi < as_norder) {
        as_si2: int = as_order[as_oi];
        as_new_index[as_si2] = as_oi + 1;
        as_no: int = as_str_add(as_syms[as_si2].as_name);
        as_st_info: int = as_syms[as_si2].as_bind * 16;
        as_shndx: int = 0;
        as_val: int = 0;
        if (as_syms[as_si2].as_defined != 0) {
            as_val = as_syms[as_si2].as_val;
            if (as_syms[as_si2].as_sec == as_SEC_ABS) { as_shndx = as_SHN_ABS; }
            if (as_syms[as_si2].as_sec == as_SEC_TEXT) { as_shndx = 1; }
            if (as_syms[as_si2].as_sec == as_SEC_DATA) { as_shndx = 3; }
            if (as_syms[as_si2].as_sec == as_SEC_BSS) { as_shndx = 4; }
            if (as_syms[as_si2].as_sec == as_SEC_RODATA) { as_shndx = 5; }
        }
        as_so: int = (as_oi + 1) * 24;
        as_wr32(as_symtab, as_so, as_no);
        as_symtab[as_so + 4] = as_u8(as_st_info);
        as_wr16(as_symtab, as_so + 6, as_shndx);
        as_wr64(as_symtab, as_so + 8, as_val);
        as_oi = as_oi + 1;
    }

    as_rela_sz: int = as_nrels * 24;
    as_rela: []i8 = new i8[as_rela_sz + 1](0i8);
    as_memset0(as_rela, 0, as_rela_sz + 1);
    as_rj: int = 0;
    while (as_rj < as_nrels) {
        as_ro: int = as_rj * 24;
        as_wr64(as_rela, as_ro, as_rels[as_rj].as_off);
        as_si3: int = as_new_index[as_rels[as_rj].as_sym];
        as_r_info: int = as_si3 * 4294967296 + as_rels[as_rj].as_typ;
        as_wr64(as_rela, as_ro + 8, as_r_info);
        as_wr64(as_rela, as_ro + 16, as_rels[as_rj].as_addend);
        as_rj = as_rj + 1;
    }

    as_shstr: []i8 = new i8[128](0i8);
    as_shstr_len: int = as_build_shstr(as_shstr);

    as_off: int = 64;
    as_text_off: int = as_off;
    as_off = as_off + as_text_len;
    as_off = as_align_up(as_off, 8);
    as_rod_off: int = as_off;
    as_off = as_off + as_rodata_len;
    as_dat_off: int = as_off;
    as_off = as_off + as_data_len;
    as_bss_off: int = as_off;
    as_off = as_align_up(as_off, 8);
    as_sym_off: int = as_off;
    as_off = as_off + as_symtab_sz;
    as_str_off: int = as_off;
    as_off = as_off + as_strtab_len;
    as_off = as_align_up(as_off, 8);
    as_rela_off: int = as_off;
    as_off = as_off + as_rela_sz;
    as_shstr_off: int = as_off;
    as_off = as_off + as_shstr_len;
    as_off = as_align_up(as_off, 8);
    as_shoff: int = as_off;
    as_shnum: int = 9;
    as_file_end: int = as_shoff + as_shnum * 64;

    as_out: []i8 = new i8[as_file_end](0i8);
    as_memset0(as_out, 0, as_file_end);

    as_out[0] = 127i8;
    as_out[1] = 'E';
    as_out[2] = 'L';
    as_out[3] = 'F';
    as_out[4] = 2i8;
    as_out[5] = 1i8;
    as_out[6] = 1i8;
    as_wr16(as_out, 16, as_ET_REL);
    as_wr16(as_out, 18, as_EM_X86_64);
    as_wr32(as_out, 20, 1);
    as_wr64(as_out, 40, as_shoff);
    as_wr16(as_out, 52, 64);
    as_wr16(as_out, 58, 64);
    as_wr16(as_out, 60, as_shnum);
    as_wr16(as_out, 62, 8);

    memcpy(as_out, as_text_off, as_text_buf, 0, as_text_len);
    if (as_rodata_len > 0) { memcpy(as_out, as_rod_off, as_rodata_buf, 0, as_rodata_len); }
    if (as_data_len > 0) { memcpy(as_out, as_dat_off, as_data_buf, 0, as_data_len); }
    memcpy(as_out, as_sym_off, as_symtab, 0, as_symtab_sz);
    memcpy(as_out, as_str_off, as_strtab_buf, 0, as_strtab_len);
    if (as_rela_sz > 0) { memcpy(as_out, as_rela_off, as_rela, 0, as_rela_sz); }
    memcpy(as_out, as_shstr_off, as_shstr, 0, as_shstr_len);

    as_sh_out = as_out;
    as_sh_base = as_shoff;

    as_sh_idx = 0; as_sh_nm = 0; as_sh_typ = as_SHT_NULL; as_sh_flags = 0; as_sh_offset = 0; as_sh_size = 0; as_sh_link = 0; as_sh_info = 0; as_sh_align = 0; as_sh_entsize = 0;
    as_write_one_sh();
    as_sh_idx = 1; as_sh_nm = as_sh_name_off(as_shstr, as_shstr_len, ".text"); as_sh_typ = as_SHT_PROGBITS; as_sh_flags = as_SHF_ALLOC + as_SHF_EXECINSTR; as_sh_offset = as_text_off; as_sh_size = as_text_len; as_sh_link = 0; as_sh_info = 0; as_sh_align = 1; as_sh_entsize = 0;
    as_write_one_sh();
    as_sh_idx = 2; as_sh_nm = as_sh_name_off(as_shstr, as_shstr_len, ".rela.text"); as_sh_typ = as_SHT_RELA; as_sh_flags = as_SHF_INFO_LINK; as_sh_offset = as_rela_off; as_sh_size = as_rela_sz; as_sh_link = 6; as_sh_info = 1; as_sh_align = 8; as_sh_entsize = 24;
    as_write_one_sh();
    as_sh_idx = 3; as_sh_nm = as_sh_name_off(as_shstr, as_shstr_len, ".data"); as_sh_typ = as_SHT_PROGBITS; as_sh_flags = as_SHF_ALLOC + as_SHF_WRITE; as_sh_offset = as_dat_off; as_sh_size = as_data_len; as_sh_link = 0; as_sh_info = 0; as_sh_align = 1; as_sh_entsize = 0;
    as_write_one_sh();
    as_sh_idx = 4; as_sh_nm = as_sh_name_off(as_shstr, as_shstr_len, ".bss"); as_sh_typ = as_SHT_NOBITS; as_sh_flags = as_SHF_ALLOC + as_SHF_WRITE; as_sh_offset = as_bss_off; as_sh_size = as_bss_size; as_sh_link = 0; as_sh_info = 0; as_sh_align = 8; as_sh_entsize = 0;
    as_write_one_sh();
    as_sh_idx = 5; as_sh_nm = as_sh_name_off(as_shstr, as_shstr_len, ".rodata"); as_sh_typ = as_SHT_PROGBITS; as_sh_flags = as_SHF_ALLOC; as_sh_offset = as_rod_off; as_sh_size = as_rodata_len; as_sh_link = 0; as_sh_info = 0; as_sh_align = 8; as_sh_entsize = 0;
    as_write_one_sh();
    as_sh_idx = 6; as_sh_nm = as_sh_name_off(as_shstr, as_shstr_len, ".symtab"); as_sh_typ = as_SHT_SYMTAB; as_sh_flags = 0; as_sh_offset = as_sym_off; as_sh_size = as_symtab_sz; as_sh_link = 7; as_sh_info = as_first_global; as_sh_align = 8; as_sh_entsize = 24;
    as_write_one_sh();
    as_sh_idx = 7; as_sh_nm = as_sh_name_off(as_shstr, as_shstr_len, ".strtab"); as_sh_typ = as_SHT_STRTAB; as_sh_flags = 0; as_sh_offset = as_str_off; as_sh_size = as_strtab_len; as_sh_link = 0; as_sh_info = 0; as_sh_align = 1; as_sh_entsize = 0;
    as_write_one_sh();
    as_sh_idx = 8; as_sh_nm = as_sh_name_off(as_shstr, as_shstr_len, ".shstrtab"); as_sh_typ = as_SHT_STRTAB; as_sh_flags = 0; as_sh_offset = as_shstr_off; as_sh_size = as_shstr_len; as_sh_link = 0; as_sh_info = 0; as_sh_align = 1; as_sh_entsize = 0;
    as_write_one_sh();

    as_flags: int = as_O_WRONLY + as_O_CREAT + as_O_TRUNC;
    as_ofd: int = open(as_path, as_flags, as_MODE_755);
    if (as_ofd < 0) { as_fail("cannot create output"); }
    as_w: int = 0;
    while (as_w < as_file_end) {
        as_chunk: int = as_file_end - as_w;
        if (as_chunk > 65536) { as_chunk = 65536; }
        as_wn: int = write(as_ofd, as_out, as_w, as_chunk);
        if (as_wn <= 0) { as_fail("write failed"); }
        as_w = as_w + as_wn;
    }
    close(as_ofd);
}

assembler_main(as_argc: int, as_argv: [][z]i8): int {
    as_init();

    if (as_argc < 4) { as_fail("usage: l8 as [-p|--profile] -o out.o a.s ..."); }
    as_do_profile = 0;
    as_out_p: [z]i8 = as_argv[0];
    as_out_set: int = 0;
    as_ai: int = 1;
    while (as_ai < as_argc) {
        as_arg: [z]i8 = as_argv[as_ai];
        if (as_is_profile_flag(as_arg)) {
            as_do_profile = 1;
            as_ai = as_ai + 1;
        } else {
            if (as_is_dash_o(as_arg)) {
                if (as_ai + 1 >= as_argc) { as_fail("usage: l8 as [-p|--profile] -o out.o a.s ..."); }
                as_out_p = as_argv[as_ai + 1];
                as_out_set = 1;
                as_ai = as_ai + 2;
            } else {
                as_ai = as_ai + 1;
            }
        }
    }
    if (as_out_set == 0) { as_fail("usage: l8 as [-p|--profile] -o out.o a.s ..."); }

    as_t0: int = 0;
    as_t1: int = 0;
    if (as_do_profile != 0) { as_t0 = as_mono_ns(); }

    as_cap: int = 65536;
    as_buf: []i8 = new i8[as_cap](0i8);
    as_n: int = 0;
    as_ai = 1;
    while (as_ai < as_argc) {
        as_arg2: [z]i8 = as_argv[as_ai];
        if (as_is_profile_flag(as_arg2)) {
            as_ai = as_ai + 1;
        } else {
            if (as_is_dash_o(as_arg2)) {
                as_ai = as_ai + 2;
            } else {
                as_fd: int = open(as_arg2, as_O_RDONLY, 0);
                if (as_fd < 0) { as_fail("cannot open input"); }
                as_reading: int = 1;
                while (as_reading != 0) {
                    if (as_n + 4096 > as_cap) {
                        as_cap = as_cap * 2;
                        as_tmp: []i8 = new i8[as_cap](0i8);
                        memcpy(as_tmp, 0, as_buf, 0, as_n);
                        as_buf = as_tmp;
                    }
                    as_r: int = read(as_fd, as_buf, as_n, 4096);
                    if (as_r <= 0) {
                        as_reading = 0;
                    } else {
                        as_n = as_n + as_r;
                    }
                }
                close(as_fd);
                if (as_n + 1 > as_cap) {
                    as_cap = as_cap * 2;
                    as_tmp2: []i8 = new i8[as_cap](0i8);
                    memcpy(as_tmp2, 0, as_buf, 0, as_n);
                    as_buf = as_tmp2;
                }
                as_buf[as_n] = '\n';
                as_n = as_n + 1;
                as_ai = as_ai + 1;
            }
        }
    }
    if (as_n == 0) { as_fail("usage: l8 as [-p|--profile] -o out.o a.s ..."); }
    if (as_n + 1 > as_cap) {
        as_cap = as_n + 1;
        as_tmp3: []i8 = new i8[as_cap](0i8);
        memcpy(as_tmp3, 0, as_buf, 0, as_n);
        as_buf = as_tmp3;
    }
    as_buf[as_n] = 0i8;

    if (as_do_profile != 0) {
        as_t1 = as_mono_ns();
        as_profile_print("load", as_t1 - as_t0);
        as_t0 = as_t1;
    }

    as_assemble_buf(as_buf, as_n);

    if (as_do_profile != 0) {
        as_t1 = as_mono_ns();
        as_profile_print("assemble", as_t1 - as_t0);
        write(2, "profile: nsyms ", len("profile: nsyms "));
        as_emit_num_fd(2, as_nsyms);
        write(2, " nrels ", len(" nrels "));
        as_emit_num_fd(2, as_nrels);
        write(2, " text ", len(" text "));
        as_emit_num_fd(2, as_text_len);
        write(2, "\n", len("\n"));
        as_t0 = as_t1;
    }

    as_write_object(as_out_p);

    if (as_do_profile != 0) {
        as_t1 = as_mono_ns();
        as_profile_print("write_object", as_t1 - as_t0);
    }
    0;
}
