tag compiler_internal;

// A contextual type introducer leaves existing variables named fn usable.
at_function_type(): bool {
    tok.kind == TokKind.Ident && name_eq_span("fn", source, tok.pos, tok.len) && tok.next.kind == TokKind.LParen
}

function_raises_equal(a: *Function, b: *Function): bool {
    p: ?*ExnList = a.raises_list;
    while (p != null) {
        if (!exn_in_list(b.raises_list, p.exn)) return false;
        p = p.next
    }
    q: ?*ExnList = b.raises_list;
    while (q != null) {
        if (!exn_in_list(a.raises_list, q.exn)) return false;
        q = q.next
    }
    true
}

check_function_signature(fn: *Function) raises Error {
    p: ?*Obj = fn.params;
    i: int = 0;
    while (p != null) {
        _bound: int = fnptr_bound(fn, p.life_bound, i);
        other: ?*Obj = p.param_next;
        while (other != null) {
            if (streq(p.name, other.name)) error("duplicate function parameter");
            other = other.param_next
        }
        i = i + 1;
        p = p.param_next
    }
    _return_bound: int = fnptr_bound(fn, fn.ret_bound, -1)
}

type ForeignTypeVisit = {
    ty: *Type;
    next: ?*ForeignTypeVisit
}

// A listener pointer can hide callbacks several records deep. Validate the
// declared foreign contract recursively, including nested callbacks and results.
check_foreign_type(ty: ?*Type, seen: ?*ForeignTypeVisit) raises Error {
    if (ty == null) return;
    v: ?*ForeignTypeVisit = seen;
    while (v != null) {
        if (v.ty == ty) return;
        v = v.next
    }
    visit: ForeignTypeVisit = ForeignTypeVisit { ty: ty, next: seen };
    match ty.* {
        FnPtr k -> {
            check_foreign_signature(k.fn);
            p: ?*Obj = k.fn.params;
            while (p != null) {
                check_foreign_type(p.ty, &visit);
                p = p.param_next
            }
            check_foreign_type(k.fn.return_ty, &visit)
        }
        Ptr k -> check_foreign_type(k.base, &visit);
        Refined k -> check_foreign_type(k.base, &visit);
        Slice k -> check_foreign_type(k.base, &visit);
        OptSlice k -> check_foreign_type(k.base, &visit);
        Array k -> check_foreign_type(k.base, &visit);
        Record k -> check_foreign_members(k.def.members, &visit);
        Exn k -> check_foreign_members(k.def.members, &visit);
        Enum k -> {
            arm: ?*Variant = k.def.variants;
            while (arm != null) {
                check_foreign_members(arm.fields, &visit);
                arm = arm.next
            }
        }
        _ -> { }
    }
}

check_foreign_members(members: ?*Member, seen: ?*ForeignTypeVisit) raises Error {
    m: ?*Member = members;
    while (m != null) {
        check_foreign_type(m.ty, seen);
        m = m.next
    }
}

check_foreign_function_types() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.is_extern) {
            p: ?*Obj = fn.params;
            while (p != null) {
                check_foreign_type(p.ty, null);
                p = p.param_next
            }
            check_foreign_type(fn.return_ty, null)
        }
        fn = fn.next
    }
}

// Function pointers have code lifetime, not object/region lifetime. Signatures
// reuse Function/Obj so indirect calls use the ordinary argument and bound checks.
is_fnptr(t: ?*Type): bool {
    if (t == null) return false;
    match t.* {
        FnPtr _ -> true;
        _ -> false
    }
}

is_opt_fnptr(t: *Type): bool {
    match t.* {
        FnPtr k -> k.optional;
        _ -> false
    }
}

fnptr_function(t: *Type) raises Error: *Function {
    match t.* {
        FnPtr k -> k.fn;
        _ -> error("expected function pointer")
    }
}

foreign_abi_type(t: *Type): bool {
    is_int_width_ty(t) || is_float_ty(t) || is_bool_ty(t) || is_any_pointer(t) || is_fnptr(t)
}

// -1: call-scoped parameter / immortal return, -2: immortal parameter,
// -3: current heap, nonnegative: parameter index. Names do not affect identity.
fnptr_bound(fn: *Function, bound: []i8, self: int) raises Error: int {
    if (len(bound) == 0) return -1;
    if (life_bound_immortal(bound)) {
        if (self < 0) return -1;
        return -2
    }
    if (streq(bound, "new")) return -3;
    p: ?*Obj = fn.params;
    i: int = 0;
    while (p != null) {
        if (streq(bound, p.name)) {
            if (i == self) return -1;
            return i
        }
        i = i + 1;
        p = p.param_next
    }
    error("unknown lifetime bound in function type")
}

check_foreign_signature(fn: *Function) raises Error {
    if (fn.raises_list != null) error("C callbacks cannot raise exceptions");
    if (fn.decl_imm_heap != 0 || fn.need_imm_heap != 0) error("C callbacks cannot require noregion");
    p: ?*Obj = fn.params;
    i: int = 0;
    while (p != null) {
        ty: *Type = p.ty or error("missing function parameter type");
        if (!foreign_abi_type(ty)) error("foreign callbacks require scalar, raw-pointer, or fn parameters");
        if (fnptr_bound(fn, p.life_bound, i) == -3) error("C callbacks cannot use @new bounds");
        other: ?*Obj = p.param_next;
        while (other != null) {
            if (streq(p.name, other.name)) error("duplicate function parameter");
            other = other.param_next
        }
        i = i + 1;
        p = p.param_next
    }
    rt: ?*Type = fn.return_ty;
    if (rt != null && !foreign_abi_type(rt)) error("foreign callback result must be a scalar, raw pointer, or fn value");
    if (fnptr_bound(fn, fn.ret_bound, -1) == -3) error("C callbacks cannot use @new bounds")
}

fnptr_signatures_equal(a: *Function, b: *Function) raises Error: bool {
    if (a.decl_imm_heap != b.decl_imm_heap || !function_raises_equal(a, b)) return false;
    if (a.nparams != b.nparams) return false;
    ar: ?*Type = a.return_ty;
    br: ?*Type = b.return_ty;
    if (ar == null || br == null) {
        if (ar != br) return false
    } else {
        if (!types_equal(ar, br)) return false
    }
    if (fnptr_bound(a, a.ret_bound, -1) != fnptr_bound(b, b.ret_bound, -1)) return false;
    ap: ?*Obj = a.params;
    bp: ?*Obj = b.params;
    i: int = 0;
    while (ap != null && bp != null) {
        if (!streq(ap.param_label, bp.param_label)) return false;
        at: *Type = ap.ty or error("missing function parameter type");
        bt: *Type = bp.ty or error("missing function parameter type");
        if (!types_equal(at, bt) || fnptr_bound(a, ap.life_bound, i) != fnptr_bound(b,
            bp.life_bound, i)) return false;
        ap = ap.param_next;
        bp = bp.param_next;
        i = i + 1
    }
    true
}

append_fnptr_type(sb: *StrBuf@immortal, fn: *Function, optional: bool) raises Error {
    if (optional) sb_putc(sb, '?');
    sb_puts(sb, "fn(");
    p: ?*Obj = fn.params;
    first: bool = true;
    while (p != null) {
        if (!first) sb_puts(sb, ", ");
        first = false;
        if (len(p.param_label) != 0) sb_puts(sb, "named ");
        sb_puts(sb, p.name);
        sb_puts(sb, ": ");
        append_type(sb, p.ty);
        if (len(p.life_bound) != 0) {
            sb_putc(sb, '@');
            sb_puts(sb, p.life_bound)
        }
        p = p.param_next
    }
    sb_putc(sb, ')');
    if (fn.decl_imm_heap != 0) sb_puts(sb, " noregion");
    er: ?*ExnList = fn.raises_list;
    if (er != null) sb_puts(sb, " raises ");
    while (er != null) {
        sb_puts(sb, er.exn.name);
        er = er.next;
        if (er != null) sb_puts(sb, ", ")
    }
    if (fn.return_ty != null) {
        sb_puts(sb, ": ");
        append_type(sb, fn.return_ty)
    }
    if (len(fn.ret_bound) != 0) {
        sb_putc(sb, '@');
        sb_puts(sb, fn.ret_bound)
    }
}

parse_fnptr_type(optional: bool) noregion raises Error: *Type@new {
    tok = tok.next;
    saved_locals: ?*Obj = locals;
    saved_scope: ?*Obj = scope_locals;
    saved_depth: int = scope_depth;
    saved_region: int = region_depth;
    saved_narrow: ?*NarrowFrame = narrow_top;
    saved_catch: ?*CatchFrame = catch_top;
    saved_fn: ?*Function = current_fn;
    saved_pos: int = browse_tok_pos;
    saved_file: int = browse_tok_file;
    saved_len: int = browse_tok_len;
    fn: *Function = parse_function("", 2);
    locals = saved_locals;
    scope_locals = saved_scope;
    scope_depth = saved_depth;
    region_depth = saved_region;
    narrow_top = saved_narrow;
    catch_top = saved_catch;
    current_fn = saved_fn;
    browse_tok_pos = saved_pos;
    browse_tok_file = saved_file;
    browse_tok_len = saved_len;
    new Type.FnPtr { fn: fn, optional: optional }
}

type_function_address(p: *Expr@new, name: []i8@p) noregion raises Error {
    fn: *Function = find_function(name) or error("unknown function");
    if (fn.is_extern) error("taking an extern function address is not supported; use an L8 wrapper");
    fn.address_taken = true;
    add_callee(fn);
    p.kind = ExprKind.FuncAddr { name: name, fn: fn };
    p.ty = new Type.FnPtr { fn: fn, optional: false }
}

call_argument_error(
    site: *Expr,
    pos: int,
    message: []i8,
    name: []i8
) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, message);
    sb_puts(sb, " '");
    sb_puts(sb, name);
    sb_putc(sb, '\'');
    error_at_file(site.file, pos, sb_finish(sb))
}

// Type expressions in source order before calling this. The checked argument
// list is in parameter order; arg_order preserves the evaluation order.
bind_call_arguments(fn: *Function, args: ?*Expr@immortal, site: *Expr) noregion raises Error: ?*Expr@args {
    if (args != null && args.arg_index >= 0) return args;
    labeled: bool = false;
    probe: ?*Expr = args;
    source_index: int = 0;
    while (probe != null) {
        if (len(probe.arg_label) != 0) labeled = true;
        probe.arg_order = source_index;
        probe.arg_index = source_index;
        source_index = source_index + 1;
        probe = probe.next
    }
    parameter: ?*Obj = fn.params;
    while (parameter != null) {
        if (len(parameter.param_label) != 0) labeled = true;
        parameter = parameter.param_next
    }
    if (!labeled) return args;
    ordered: ?*Expr = null;
    positional: int = 0;
    order: int = 0;
    a: ?*Expr = args;
    while (a != null) {
        a.arg_order = order;
        order = order + 1;
        index: int = 0;
        p: ?*Obj = fn.params;
        if (len(a.arg_label) != 0) {
            while (p != null && !streq(p.param_label, a.arg_label)) {
                p = p.param_next;
                index = index + 1
            }
            if (p == null) call_argument_error(site, a.arg_pos, "unknown argument label",
                a.arg_label)
        } else {
            index = positional;
            p = fn_param(fn, index);
            while (p != null && len(p.param_label) != 0) {
                p = p.param_next;
                index = index + 1
            }
            if (p == null) error_at_file(site.file, a.arg_pos, "too many positional arguments");
            positional = index + 1
        }
        a.arg_index = index;
        following: ?*Expr = a.next;
        previous: ?*Expr = null;
        slot: ?*Expr = ordered;
        while (slot != null && slot.arg_index < index) {
            previous = slot;
            slot = slot.next
        }
        if (slot != null && slot.arg_index == index) call_argument_error(site, a.arg_pos,
            "duplicate argument label", a.arg_label);
        a.next = slot;
        if (previous != null) previous.next = a else ordered = a;
        a = following
    }
    if (order != fn.nparams) {
        expected: int = 0;
        present: ?*Expr = ordered;
        while (present != null && present.arg_index == expected) {
            expected = expected + 1;
            present = present.next
        }
        missing: *Obj = fn_param(fn, expected) or error("missing required argument");
        call_argument_error(site, site.pos, "missing required argument", missing.name)
    }
    ordered
}

call_source_arg(args: ?*Expr, order: int): ?*Expr@args {
    a: ?*Expr = args;
    while (a != null) {
        if (a.arg_order == order) return a;
        a = a.next
    }
    null
}

type_call_arguments(args: ?*Expr@new) noregion raises Error {
    if (args != null && args.arg_index >= 0 && call_args_reordered(args)) {
        order: int = 0;
        argument: ?*Expr = call_source_arg(args, order);
        while (argument != null) {
            add_type(argument);
            order = order + 1;
            argument = call_source_arg(args, order)
        }
        return
    }
    argument: ?*Expr = args;
    while (argument != null) {
        add_type(argument);
        argument = argument.next
    }
}

call_args_reordered(args: ?*Expr): bool {
    a: ?*Expr = args;
    index: int = 0;
    while (a != null) {
        if (a.arg_order != index) return true;
        index = index + 1;
        a = a.next
    }
    false
}

// Named calls also capture aggregate values when no permutation is needed:
// a later argument can mutate the storage an earlier aggregate was read from.
call_needs_capture(args: ?*Expr): bool {
    if (call_args_reordered(args)) return true;
    labeled: bool = false;
    aggregate: bool = false;
    argument: ?*Expr = args;
    while (argument != null) {
        if (len(argument.arg_label) != 0) labeled = true;
        ty: ?*Type = argument.ty;
        if (ty != null && passes_by_ref(ty)) aggregate = true;
        argument = argument.next
    }
    labeled && aggregate
}

type_indirect_call(p: *Expr) noregion raises Error {
    match p.kind {
        Funcall q -> {
            target0: ?*Expr = q.target;
            args: ?*Expr = q.args;
            target: *Expr = target0 or error("missing function target");
            add_type(target);
            ty: *Type = target.ty or error("calling a value without a type");
            if (!is_fnptr(ty)) error("indirect call requires a fn value");
            if (is_opt_fnptr(ty)) error("optional function must be narrowed before calling");
            fn: *Function = fnptr_function(ty);
            type_call_arguments(args);
            args = bind_call_arguments(fn, args, p);
            a: ?*Expr = args;
            po: ?*Obj = fn.params;
            while (a != null && po != null) {
                if (!assignable(po.ty, a)) error_have_expr_want("function argument type mismatch",
                    a, po.ty);
                a = a.next;
                po = po.param_next
            }
            if (a != null || po != null) error("wrong number of function arguments");
            check_call_lifetimes(fn, args);
            er: ?*ExnList = fn.raises_list;
            while (er != null) {
                check_exn_allowed(er.exn, "indirect call raises");
                er = er.next
            }
            p.kind = ExprKind.Funcall {
                funcname: "",
                args: args,
                fn: fn,
                target: target
            };
            p.ty = fn.return_ty
        }
        _ -> error("expected indirect call")
    }
}

emit_indirect_call(target_off: int) noregion raises Error {
    // The caller has aligned the stack and placed arguments. Recover the target
    // without clobbering argument registers or disturbing stack arguments.
    cg_mov_mr(4, cg_rsp_off - target_off, 10);
    if (cg_arm) {
        arm_call_indirect();
        return
    }
    if (cg_direct_mode) {
        as_op_kind = as_OP_INDREG;
        as_op_reg = 10;
        as_emit_call()
    } else emit("  call *%r10\n")
}

// Reserve stable rbp-relative slots before evaluating arguments. Aggregate
// literals and nested calls can leave temporary stack storage behind; copy each
// argument into its slot before discarding those temporaries. The result area
// lives in the expression's fixed frame slot, as for ordinary direct calls.
gen_captured_call(n: *Expr) noregion raises Error {
    match n.kind {
        Funcall k -> {
            target: ?*Expr = k.target;
            fn: *Function = k.fn or error("missing function signature");
            rt: ?*Type = fn.return_ty;
            result_size: int = 0;
            ni: int = 0;
            if (rt != null && passes_by_ref(rt)) {
                result_size = align_up(type_size(rt), 16);
                ni = 1
            }
            ns: int = 0;
            nstack: int = 0;
            copies: int = 0;
            p: ?*Obj = fn.params;
            while (p != null) {
                ty: *Type = p.ty or error("missing function parameter type");
                if (passes_by_ref(ty)) copies = copies + align_up(type_size(ty), 8);
                if (is_float_ty(ty)) {
                    if (ns < 8) ns = ns + 1 else nstack = nstack + 1
                } else {
                    if (ni < 6) ni = ni + 1 else nstack = nstack + 1
                }
                p = p.param_next
            }
            if (target != null) gen_expr(target) else cg_mov_imm(0, 0);
            result_off: int = cg_rsp_off;
            scratch: int = 8 + fn.nparams * 8 + copies;
            cg_alu_imm(5, scratch, 4);
            fixed_off: int = cg_rsp_off;
            base: int = 8 - fixed_off;
            cg_mov_rm(0, 5, base);
            copy_off: int = base + 8 + fn.nparams * 8;
            index: int = 0;
            while (index < fn.nparams) {
                arg: *Expr = call_source_arg(k.args, index) or error("missing source argument");
                parameter: *Obj = fn_param(fn, arg.arg_index) or error("missing parameter");
                ty: *Type = parameter.ty or error("missing function parameter type");
                gen_expr(arg);
                if (passes_by_ref(ty)) {
                    cg_mov_rr(0, 6);
                    cg_lea_mr(5, copy_off, 7);
                    emit_memcpy(type_size(ty));
                    cg_lea_mr(5, copy_off, 0);
                    copy_off = copy_off + align_up(type_size(ty), 8)
                }
                cg_mov_rm(0, 5, base + 8 + arg.arg_index * 8);
                if (cg_rsp_off != fixed_off) cg_alu_imm(0, cg_rsp_off - fixed_off,
                    4);
                index = index + 1
            }
            pad: int = (16 - (cg_rsp_off + nstack * 8 + 8) % 16) % 16;
            cg_alu_imm(5, pad + nstack * 8, 4);
            ni = 0;
            ns = 0;
            if (result_size != 0) {
                cg_lea_mr(5, cg_temp_offset(n), cg_arg_reg(0));
                ni = 1
            }
            p = fn.params;
            index = 0;
            extra: int = 0;
            while (p != null) {
                ty: *Type = p.ty or error("missing function parameter type");
                cg_mov_mr(5, base + 8 + index * 8, 0);
                if (is_float_ty(ty) && ns < 8) {
                    wide: bool = false;
                    if (is_f64_ty(ty)) wide = true;
                    bits_to_xmm(ns, wide);
                    ns = ns + 1
                } else if (!is_float_ty(ty) && ni < 6) {
                    cg_mov_rr(0, cg_arg_reg(ni));
                    ni = ni + 1
                } else {
                    cg_mov_rm(0, 4, extra * 8);
                    extra = extra + 1
                }
                index = index + 1;
                p = p.param_next
            }
            cg_arm_nstack = nstack;
            if (target != null) emit_indirect_call(fixed_off) else cg_call(fn.link_name);
            cg_alu_imm(0, cg_rsp_off - result_off, 4);
            if (result_size != 0) cg_lea_mr(5, cg_temp_offset(n), 0) else emit_ret_to_rax(rt)
        }
        _ -> error("expected indirect call")
    }
}
