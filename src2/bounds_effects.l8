tag compiler_internal;

// Mutation dependencies and alias obligations for fact invalidation.
bounds_effect_add(
    sites: *BoundsEffectSites@new,
    fn: *Function@new,
    member: *Member@new,
    root_param: ?*Obj@new
): bool {
    root_id: int = if (root_param == null) 0 else root_param.browse_id;
    hash: int = fn.browse_id * 65599 + member.browse_id * 33 + root_id;
    slot: int = hash & len(sites.write_buckets) - 1;
    q: ?*BoundsWrite = sites.write_buckets[slot];
    while (q != null) {
        if (q.owner == fn && q.member == member && q.root_param == root_param) return false;
        q = q.hash_next
    }
    made: *BoundsWrite = new BoundsWrite {
        owner: fn,
        member: member,
        root_param: root_param,
        next: fn.bounds_writes,
        hash_next: sites.write_buckets[slot]
    };
    fn.bounds_writes = made;
    sites.write_buckets[slot] = made;
    true
}

bounds_effect_unknown(fn: *Function): bool {
    if (fn.bounds_unknown_write) return false;
    fn.bounds_unknown_write = true;
    true
}

bounds_effect_inits(sites: *BoundsEffectSites@new, fn: *Function@new, inits: ?*FieldInit) raises IndexOutOfBounds: bool {
    changed: bool = false;
    q: ?*FieldInit = inits;
    while (q != null) {
        if (bounds_effect_expr(sites, fn, q.lhs)) changed = true;
        q = q.next
    }
    changed
}

bounds_effect_exprs(sites: *BoundsEffectSites@new, fn: *Function@new, exprs: ?*Expr) raises IndexOutOfBounds: bool {
    changed: bool = false;
    q: ?*Expr = exprs;
    while (q != null) {
        if (bounds_effect_expr(sites, fn, q)) changed = true;
        q = q.next
    }
    changed
}

bounds_effect_two(
    sites: *BoundsEffectSites@new,
    fn: *Function@new,
    a: ?*Expr,
    b: ?*Expr
) raises IndexOutOfBounds: bool {
    x: bool = bounds_effect_expr(sites, fn, a);
    y: bool = bounds_effect_expr(sites, fn, b);
    x || y
}

bounds_effect_expr(sites: *BoundsEffectSites@new, fn: *Function@new, e: ?*Expr) raises IndexOutOfBounds: bool {
    if (e == null) return false;
    n: *Expr = e;
    match n.kind {
        Assign k -> {
            changed: bool = bounds_effect_expr(sites, fn, k.rhs);
            if (bounds_effect_expr(sites, fn, k.lhs)) changed = true;
            match k.lhs.kind {
                MemberAccess field -> {
                    m: ?*Member = field.member;
                    if (m == null) return bounds_effect_unknown(fn);
                    root: ?*Obj = bounds_var(field.lhs);
                    if (root != null && !bounds_param(fn, root)) root = null;
                    if (bounds_effect_add(sites, fn, m, root)) changed = true
                }
                Var v -> {
                    o: ?*Obj = v.var;
                    if (o == null) return bounds_effect_unknown(fn);
                    if (!o.is_local) return bounds_effect_unknown(fn)
                }
                Index _ -> {
                    if (!fn.bounds_element_write) changed = true;
                    fn.bounds_element_write = true
                }
                _ -> return bounds_effect_unknown(fn)
            }
            changed
        }
        Funcall k -> {
            changed: bool = bounds_effect_expr(sites, fn, k.target);
            if (bounds_effect_exprs(sites, fn, k.args)) changed = true;
            if (streq(k.funcname, "len") || streq(k.funcname, "sizeof")) return changed;
            callee: ?*Function = k.fn;
            if (callee == null) return bounds_effect_unknown(fn);
            bounds_effect_site(fn, callee, k.args);
            changed
        }
        Binary k -> bounds_effect_two(sites, fn, k.lhs, k.rhs);
        LogAnd k -> bounds_effect_two(sites, fn, k.lhs, k.rhs);
        LogOr k -> bounds_effect_two(sites, fn, k.lhs, k.rhs);
        OrElse k -> bounds_effect_two(sites, fn, k.lhs, k.rhs);
        Index k -> bounds_effect_two(sites, fn, k.lhs, k.idx);
        Not k -> bounds_effect_expr(sites, fn, k.lhs);
        Neg k -> bounds_effect_expr(sites, fn, k.lhs);
        BitNot k -> bounds_effect_expr(sites, fn, k.lhs);
        Addr k -> bounds_effect_expr(sites, fn, k.lhs);
        Deref k -> bounds_effect_expr(sites, fn, k.lhs);
        MemberAccess k -> bounds_effect_expr(sites, fn, k.lhs);
        As k -> bounds_effect_expr(sites, fn, k.lhs);
        Trunc k -> bounds_effect_expr(sites, fn, k.lhs);
        New k -> {
            changed: bool = bounds_effect_two(sites, fn, k.lhs, k.fill);
            if (bounds_effect_inits(sites, fn, k.inits)) changed = true;
            changed
        }
        StructLit k -> bounds_effect_inits(sites, fn, k.inits);
        VariantLit k -> bounds_effect_inits(sites, fn, k.inits);
        ArrayLit k -> bounds_effect_exprs(sites, fn, k.elems);
        If k -> {
            changed: bool = bounds_effect_expr(sites, fn, k.cond);
            if (bounds_effect_two(sites, fn, k.then, k.els)) changed = true;
            changed
        }
        Block k -> bounds_effect_stmts(sites, fn, k.body);
        Match k -> {
            changed: bool = bounds_effect_expr(sites, fn, k.cond);
            q: ?*MatchArm = k.arms;
            while (q != null) {
                if (bounds_effect_stmt(sites, fn, q.body)) changed = true;
                q = q.next
            }
            changed
        }
        Sizeof k -> bounds_effect_expr(sites, fn, k.e);
        _ -> false
    }
}

bounds_effect_stmt(sites: *BoundsEffectSites@new, fn: *Function@new, s: ?*Stmt) raises IndexOutOfBounds: bool {
    if (s == null) return false;
    n: *Stmt = s;
    match n.kind {
        ExprStmt k -> bounds_effect_expr(sites, fn, k.lhs);
        Decl k -> bounds_effect_expr(sites, fn, k.init);
        Return k -> bounds_effect_expr(sites, fn, k.lhs);
        Raise k -> bounds_effect_inits(sites, fn, k.inits);
        Block k -> bounds_effect_stmts(sites, fn, k.body);
        Region k -> bounds_effect_stmt(sites, fn, k.body);
        If k -> {
            changed: bool = bounds_effect_expr(sites, fn, k.cond);
            if (bounds_effect_stmt(sites, fn, k.then)) changed = true;
            if (bounds_effect_stmt(sites, fn, k.els)) changed = true;
            changed
        }
        While k -> {
            changed: bool = bounds_effect_expr(sites, fn, k.cond);
            if (bounds_effect_stmt(sites, fn, k.body)) changed = true;
            changed
        }
        For k -> {
            changed: bool = bounds_effect_two(sites, fn, k.iter, k.hi);
            if (bounds_effect_stmt(sites, fn, k.body)) changed = true;
            changed
        }
        Match k -> {
            changed: bool = bounds_effect_expr(sites, fn, k.cond);
            q: ?*MatchArm = k.arms;
            while (q != null) {
                if (bounds_effect_stmt(sites, fn, q.body)) changed = true;
                q = q.next
            }
            changed
        }
        Try k -> {
            changed: bool = bounds_effect_stmt(sites, fn, k.body);
            q: ?*CatchArm = k.arms;
            while (q != null) {
                if (bounds_effect_stmt(sites, fn, q.body)) changed = true;
                q = q.next
            }
            changed
        }
        _ -> false
    }
}

bounds_effect_stmts(sites: *BoundsEffectSites@new, fn: *Function@new, s: ?*Stmt) raises IndexOutOfBounds: bool {
    changed: bool = false;
    q: ?*Stmt = s;
    while (q != null) {
        if (bounds_effect_stmt(sites, fn, q)) changed = true;
        q = q.next
    }
    changed
}

bounds_effect_has(fn: *Function, member: *Member): bool {
    q: ?*BoundsWrite = fn.bounds_writes;
    while (q != null) {
        if (q.member == member) return true;
        q = q.next
    }
    false
}

bounds_effect_preserves_term(fn: *Function, e: *Expr) raises IndexOutOfBounds: bool {
    match e.kind {
        Num _ -> true;
        Null -> true;
        VariantLit k -> k.variant != null && k.inits == null;
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return false;
            v.is_local && !v.bounds_addr_taken
        }
        MemberAccess k -> {
            if (fn.bounds_unknown_write) return false;
            m: ?*Member = k.member;
            if (m == null || bounds_effect_has(fn, m)) return false;
            bounds_effect_preserves_term(fn, k.lhs)
        }
        Deref k -> !fn.bounds_unknown_write && bounds_effect_preserves_term(fn, k.lhs);
        Index k -> !fn.bounds_unknown_write && !fn.bounds_element_write && bounds_effect_preserves_term(fn,
            k.lhs) && bounds_effect_preserves_term(fn, k.idx);
        Funcall k -> {
            if (!streq(k.funcname, "len")) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            bounds_effect_preserves_term(fn, a)
        }
        _ -> false
    }
}

bounds_field_safe_args(args: ?*Expr, root: *Obj, member: *Member) raises IndexOutOfBounds: bool {
    q: ?*Expr = args;
    while (q != null) {
        if (!bounds_field_safe_expr(q, root, member)) return false;
        q = q.next
    }
    true
}

bounds_field_safe_expr(e: ?*Expr, root: *Obj, member: *Member) raises IndexOutOfBounds: bool {
    if (e == null) return true;
    n: *Expr = e;
    match n.kind {
        Num _ -> true;
        Null -> true;
        Var _ -> true;
        Binary k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.rhs,
            root, member);
        Assign k -> {
            match k.lhs.kind {
                Var x -> x.var != null && x.var != root && bounds_field_safe_expr(k.rhs,
                    root, member);
                Index x -> {
                    t: ?*Type = k.lhs.ty;
                    (is_int_width_ty(t) || is_float_ty(t) || is_bool_ty(t)) && (bounds_field_array(x.lhs,
                        root, member) || bounds_direct_value_member(root, member) && bounds_field_safe_expr(x.lhs,
                        root, member)) && bounds_field_safe_expr(x.idx, root, member) && bounds_field_safe_expr(k.rhs,
                        root, member)
                }
                _ -> false
            }
        }
        Index k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.idx,
            root, member);
        Not k -> bounds_field_safe_expr(k.lhs, root, member);
        Neg k -> bounds_field_safe_expr(k.lhs, root, member);
        BitNot k -> bounds_field_safe_expr(k.lhs, root, member);
        LogAnd k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.rhs,
            root, member);
        LogOr k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.rhs,
            root, member);
        OrElse k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.rhs,
            root, member);
        Funcall k -> {
            if (k.target != null || !bounds_field_safe_args(k.args, root, member)) return false;
            if (streq(k.funcname, "len")) return true;
            fn: ?*Function = k.fn;
            if (fn == null) return false;
            !fn.bounds_unknown_write && !bounds_effect_has(fn, member)
        }
        MemberAccess k -> bounds_field_safe_expr(k.lhs, root, member);
        As k -> bounds_field_safe_expr(k.lhs, root, member);
        Trunc k -> bounds_field_safe_expr(k.lhs, root, member);
        _ -> false
    }
}

bounds_field_safe_stmt_list(s: ?*Stmt, root: *Obj, member: *Member) raises IndexOutOfBounds: bool {
    q: ?*Stmt = s;
    while (q != null) {
        if (!bounds_field_safe_stmt(q, root, member)) return false;
        q = q.next
    }
    true
}

bounds_field_safe_stmt(s: *Stmt, root: *Obj, member: *Member) raises IndexOutOfBounds: bool {
    match s.kind {
        ExprStmt k -> bounds_field_safe_expr(k.lhs, root, member);
        Decl k -> bounds_field_safe_expr(k.init, root, member);
        Return k -> bounds_field_safe_expr(k.lhs, root, member);
        Block k -> bounds_field_safe_stmt_list(k.body, root, member);
        Region k -> bounds_field_safe_stmt(k.body, root, member);
        If k -> {
            if (!bounds_field_safe_expr(k.cond, root, member) || !bounds_field_safe_stmt(k.then,
                root, member)) return false;
            els: ?*Stmt = k.els;
            if (els != null && !bounds_field_safe_stmt(els, root, member)) return false;
            true
        }
        Comment _ -> true;
        _ -> false
    }
}

// An earlier assignment to a local does not make it an unstable loop bound.
// Only writes reachable from the loop body matter. Address-taken locals are
// excluded by the caller, so an ordinary call cannot change this local.
bounds_local_stable_expr(e: ?*Expr, local: *Obj): bool {
    if (e == null) return true;
    n: *Expr = e;
    match n.kind {
        Num _ -> true;
        Null -> true;
        Var _ -> true;
        Binary k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.rhs,
            local);
        Assign k -> bounds_var(k.lhs) != local && bounds_local_stable_expr(k.lhs,
            local) && bounds_local_stable_expr(k.rhs, local);
        Index k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.idx,
            local);
        Funcall k -> {
            if (!bounds_local_stable_expr(k.target, local)) return false;
            a: ?*Expr = k.args;
            while (a != null) {
                if (!bounds_local_stable_expr(a, local)) return false;
                a = a.next
            }
            true
        }
        MemberAccess k -> bounds_local_stable_expr(k.lhs, local);
        Deref k -> bounds_local_stable_expr(k.lhs, local);
        Not k -> bounds_local_stable_expr(k.lhs, local);
        Neg k -> bounds_local_stable_expr(k.lhs, local);
        BitNot k -> bounds_local_stable_expr(k.lhs, local);
        LogAnd k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.rhs,
            local);
        LogOr k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.rhs,
            local);
        OrElse k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.rhs,
            local);
        As k -> bounds_local_stable_expr(k.lhs, local);
        Trunc k -> bounds_local_stable_expr(k.lhs, local);
        If k -> bounds_local_stable_expr(k.cond, local) && bounds_local_stable_expr(k.then,
            local) && bounds_local_stable_expr(k.els, local);
        Block k -> bounds_local_stable_stmt_list(k.body, local);
        _ -> false
    }
}

bounds_local_stable_stmt_list(s: ?*Stmt, local: *Obj): bool {
    q: ?*Stmt = s;
    while (q != null) {
        if (!bounds_local_stable_stmt(q, local)) return false;
        q = q.next
    }
    true
}

bounds_local_stable_stmt(s: *Stmt, local: *Obj): bool {
    match s.kind {
        ExprStmt k -> bounds_local_stable_expr(k.lhs, local);
        Decl k -> bounds_local_stable_expr(k.init, local);
        Return k -> bounds_local_stable_expr(k.lhs, local);
        Block k -> bounds_local_stable_stmt_list(k.body, local);
        Region k -> bounds_local_stable_stmt(k.body, local);
        If k -> {
            if (!bounds_local_stable_expr(k.cond, local) || !bounds_local_stable_stmt(k.then,
                local)) return false;
            els: ?*Stmt = k.els;
            if (els != null && !bounds_local_stable_stmt(els, local)) return false;
            true
        }
        While k -> bounds_local_stable_expr(k.cond, local) && bounds_local_stable_stmt(k.body,
            local);
        For k -> k.item != local && bounds_local_stable_expr(k.iter, local) && bounds_local_stable_expr(k.hi,
            local) && bounds_local_stable_stmt(k.body, local);
        Comment _ -> true;
        _ -> false
    }
}

// Visit syntax once. Subsequent propagation processes only call sites whose
// callee summary changed, including recursive cycles.
bounds_effect_enqueue(work: *BoundsEffectQueue, fn: *Function@work) {
    fn.bounds_effect_queue_next = null;
    tail: ?*Function = work.tail;
    if (tail == null) work.head = fn else tail.bounds_effect_queue_next = fn;
    work.tail = fn
}

bounds_infer_effects() raises Error, IndexOutOfBounds {
    count: int = 0;
    fn: ?*Function = functions;
    while (fn != null) {
        fn.bounds_writes = null;
        fn.bounds_element_write = false;
        fn.bounds_unknown_write = fn.is_extern || fn.body == null;
        // The SCC numbering is assigned later; borrow its slot for dense IDs.
        fn.bounds_visit = count;
        fn.bounds_effect_queued = true;
        fn.bounds_effect_queue_next = null;
        fn.bounds_effect_head = null;
        count = count + 1;
        fn = fn.next
    }
    if (count < 0) error("too many functions for bounds analysis");
    write_capacity: int = 16;
    while (write_capacity < count * 8) write_capacity = write_capacity * 2;
    if (write_capacity <= 0) error("bounds analysis table exceeds addressable size");
    sites: *BoundsEffectSites = new BoundsEffectSites { write_buckets: new ?*BoundsWrite[write_capacity](null) };
    work: *BoundsEffectQueue = new BoundsEffectQueue { head: null, tail: null };
    fn = functions;
    while (fn != null) {
        if (!fn.is_extern) _changed: bool = bounds_effect_stmts(sites, fn, fn.body);
        bounds_effect_enqueue(work, fn);
        fn = fn.next
    }
    while (work.head != null) {
        callee: ?*Function = work.head;
        if (callee != null) {
            work.head = callee.bounds_effect_queue_next;
            if (work.head == null) work.tail = null;
            callee.bounds_effect_queue_next = null;
            callee.bounds_effect_queued = false;
            site: ?*BoundsEffectSite = callee.bounds_effect_head;
            while (site != null) {
                caller: ?*Function = site.caller;
                if (caller != null) {
                    changed: bool = bounds_effect_transfer(sites, caller, callee,
                        site.args);
                    if (changed && !caller.bounds_effect_queued) {
                        bounds_effect_enqueue(work, caller);
                        caller.bounds_effect_queued = true
                    }
                }
                site = site.next
            }
        }
    }
    fn = functions;
    while (fn != null) {
        fn.bounds_visit = 0;
        fn.bounds_effect_queued = false;
        fn = fn.next
    }
}

bounds_effect_site(caller: *Function@new, callee: *Function@new, args: ?*Expr@new) {
    row: *BoundsEffectSite = new BoundsEffectSite {
        caller: caller,
        callee: callee,
        args: args,
        next: callee.bounds_effect_head
    };
    callee.bounds_effect_head = row
}

bounds_effect_transfer(
    sites: *BoundsEffectSites@new,
    caller: *Function@new,
    callee: *Function@new,
    args: ?*Expr
): bool {
    changed: bool = false;
    if (callee.bounds_unknown_write && bounds_effect_unknown(caller)) changed = true;
    if (callee.bounds_element_write && !caller.bounds_element_write) {
        caller.bounds_element_write = true;
        changed = true
    }
    write: ?*BoundsWrite = callee.bounds_writes;
    while (write != null) {
        root: ?*Obj = null;
        formal: ?*Obj = write.root_param;
        if (formal != null) {
            actual: ?*Expr = bounds_arg_named(callee, args, formal.name);
            root = bounds_var(actual);
            if (root != null && !bounds_param(caller, root)) root = null
        }
        if (bounds_effect_add(sites, caller, write.member, root)) changed = true;
        write = write.next
    }
    changed
}

bounds_term_roots_stable(e: *Expr) raises IndexOutOfBounds: bool {
    match e.kind {
        Num _ -> true;
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return false;
            v.is_local && !v.bounds_addr_taken
        }
        MemberAccess k -> bounds_term_roots_stable(k.lhs);
        Deref k -> bounds_term_roots_stable(k.lhs);
        Funcall k -> {
            if (!streq(k.funcname, "len")) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            bounds_term_roots_stable(a)
        }
        _ -> false
    }
}

bounds_term_has_member(e: *Expr, member: *Member): bool {
    match e.kind {
        MemberAccess k -> k.member == member || bounds_term_has_member(k.lhs, member);
        Deref k -> bounds_term_has_member(k.lhs, member);
        Index k -> bounds_term_has_member(k.lhs, member) || bounds_term_has_member(k.idx,
            member);
        Binary k -> bounds_term_has_member(k.lhs, member) || bounds_term_has_member(k.rhs,
            member);
        Funcall k -> {
            a: ?*Expr = k.args;
            if (a == null) return false;
            bounds_term_has_member(a, member)
        }
        _ -> false
    }
}

bounds_term_has_index(e: *Expr): bool {
    match e.kind {
        Index _ -> true;
        MemberAccess k -> bounds_term_has_index(k.lhs);
        Deref k -> bounds_term_has_index(k.lhs);
        Funcall k -> {
            arg: ?*Expr = k.args;
            arg != null && bounds_term_has_index(arg)
        }
        Binary k -> bounds_term_has_index(k.lhs) || bounds_term_has_index(k.rhs);
        Neg k -> bounds_term_has_index(k.lhs);
        _ -> false
    }
}

// Element stores through another slice may alias an indexed value. Two
// distinct constant indexes on the same stable array path cannot.
bounds_element_fact_survives(term: ?*Expr, written: *Expr) raises IndexOutOfBounds: bool {
    if (term == null) return true;
    n: *Expr = term;
    if (!bounds_term_has_index(n)) return true;
    match n.kind {
        Index read -> {
            match written.kind {
                Index write -> {
                    if (!bounds_same_array_expr(read.lhs, write.lhs)) return false;
                    left: int = bounds_num(read.idx);
                    right: int = bounds_num(write.idx);
                    left >= 0 && right >= 0 && left != right
                }
                _ -> false
            }
        }
        _ -> false
    }
}

bounds_kill_elements(f: ?*BoundsState@new, written: *Expr) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(f)) return f;
    if (f == null) return f;
    found: bool = false;
    scan: int = 0;
    while (scan < bounds_count(f) && !found) {
        row: ?*BoundsRow = bounds_row(f, scan);
        if (row != null) {
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            if (!bounds_element_fact_survives(left, written) || !bounds_element_fact_survives(right,
                written)) found = true
        }
        scan = scan + 1
    }
    if (!found && f.implications == null) return f;
    head: ?*BoundsState = bounds_empty(f);
    for position in 0..f.count {
        row: ?*BoundsRow = bounds_row(f, position);
        if (row != null) {
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            if (bounds_element_fact_survives(left, written) && bounds_element_fact_survives(right,
                written)) head = bounds_filter_copy(head, f, row, position)
        }
    }
    head
}

bounds_term_has_any_member(e: *Expr): bool {
    match e.kind {
        MemberAccess _ -> true;
        Deref k -> bounds_term_has_any_member(k.lhs);
        Funcall k -> {
            a: ?*Expr = k.args;
            a != null && bounds_term_has_any_member(a)
        }
        _ -> false
    }
}

bounds_simple_term_on_root(e: *Expr, root: *Obj): bool {
    match e.kind {
        Num _ -> true;
        Var _ -> true;
        MemberAccess k -> bounds_var(k.lhs) == root && k.member != null;
        Funcall k -> {
            if (!streq(k.funcname, "len")) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            match a.kind {
                MemberAccess field -> bounds_var(field.lhs) == root && field.member != null;
                _ -> false
            }
        }
        _ -> false
    }
}

bounds_simple_relation_root(q: *BoundsRow): int {
    if (q.kind != BoundsKind.Difference) return -1;
    root: ?*Obj = q.array;
    if (root == null || q.index != root) return -1;
    fn: ?*Function = bounds_current_fn;
    if (fn == null || !bounds_param(fn, root)) return -1;
    left: ?*Expr = q.left;
    right: ?*Expr = q.right;
    if (left == null || right == null) return -1;
    if (!bounds_simple_term_on_root(left, root) || !bounds_simple_term_on_root(right,
        root)) return -1;
    root.browse_id
}

bounds_separation_extend(list: ?*BoundsSeparation@new, first: int, second: int): ?*BoundsSeparation@new {
    if (bounds_separation_contains(list, first, second)) return list;
    new BoundsSeparation { first: first, second: second, next: list }
}

bounds_field_array(a: *Expr, root: *Obj, member: *Member): bool {
    if (bounds_term_root(a) != root) return false;
    match a.kind {
        MemberAccess k -> k.member == member || bounds_field_array(k.lhs, root, member);
        Deref k -> bounds_field_array(k.lhs, root, member);
        _ -> false
    }
}

// A scalar field of an unaliased value record cannot change when a separate
// array element is written. This also keeps loop range bounds on such fields.
bounds_direct_value_member(root: *Obj, member: *Member): bool {
    if (!root.is_local || root.bounds_addr_taken) return false;
    ty: ?*Type = root.ty;
    if (ty == null) return false;
    field: ?*Member = null;
    match ty.* {
        Record k -> field = k.def.members;
        _ -> return false
    }
    while (field != null) {
        if (field == member) return true;
        field = field.next
    }
    false
}

// A field path stays stable through a loop only if each member in the path
// stays stable. Scalar element stores do not replace an array field.
bounds_field_path_safe_stmt(s: *Stmt, path: *Expr) raises IndexOutOfBounds: bool {
    root: ?*Obj = bounds_term_root(path);
    if (root == null) return false;
    match path.kind {
        MemberAccess k -> k.member != null && bounds_field_safe_stmt(s, root, k.member) && bounds_field_path_safe_stmt(s,
            k.lhs);
        Deref k -> bounds_field_path_safe_stmt(s, k.lhs);
        Var k -> k.var == root;
        _ -> false
    }
}

// Every path used by a range bound must keep its value for the loop body.
bounds_stable_bound_expr(body: *Stmt, expr: *Expr) raises IndexOutOfBounds: bool {
    match expr.kind {
        Num _ -> true;
        Var k -> {
            v: ?*Obj = k.var;
            v != null && v.is_local && !v.bounds_addr_taken && (!v.bounds_written || bounds_local_stable_stmt(body,
                v))
        }
        MemberAccess _ -> bounds_field_path_safe_stmt(body, expr);
        Binary k -> (k.op == BinOp.Add || k.op == BinOp.Sub) && bounds_stable_bound_expr(body,
            k.lhs) && bounds_stable_bound_expr(body, k.rhs);
        _ -> false
    }
}

bounds_sum_uses(row: *BoundsRow, v: *Obj): bool {
    if (row.kind != BoundsKind.SumUpper) return false;
    limit: ?*Expr = row.right;
    if (limit == null) return false;
    bounds_term_root(limit) == v
}

bounds_index_depends(e: *Expr, v: *Obj): bool {
    match e.kind {
        Index k -> bounds_term_root(k.idx) == v || bounds_index_depends(k.idx, v) || bounds_index_depends(k.lhs,
            v);
        MemberAccess k -> bounds_index_depends(k.lhs, v);
        Deref k -> bounds_index_depends(k.lhs, v);
        Funcall k -> {
            a: ?*Expr = k.args;
            a != null && bounds_index_depends(a, v)
        }
        Binary k -> bounds_index_depends(k.lhs, v) || bounds_index_depends(k.rhs,
            v);
        Neg k -> bounds_index_depends(k.lhs, v);
        _ -> false
    }
}

bounds_row_index_depends(row: *BoundsRow, v: *Obj): bool {
    left: ?*Expr = row.left;
    right: ?*Expr = row.right;
    left != null && bounds_index_depends(left, v) || right != null && bounds_index_depends(right,
        v)
}

bounds_kill(f: ?*BoundsState@new, v: *Obj) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(f)) return f;
    if (f == null) return f;
    // Assigning a value absent from the state leaves the snapshot intact.
    // This is common for short-lived locals and avoids copying every fact.
    scan_position: int = bounds_count(f) - 1;
    scan: ?*BoundsRow = bounds_row(f, scan_position);
    found: bool = false;
    while (scan != null && !found) {
        if (scan.index == v || scan.array == v || bounds_sum_uses(scan, v) || bounds_row_index_depends(scan,
            v)) found = true;
        scan_position = scan_position - 1;
        scan = bounds_row(f, scan_position)
    }
    if (!found) {
        if (f.implications == null) return f;
        return new BoundsState {
            arena: f.arena,
            unreachable: false,
            storage: f.storage,
            rows_view: f.rows_view,
            numeric_view: f.numeric_view,
            count: f.count,
            sum_count: f.sum_count,
            implications: null
        }
    }
    head: ?*BoundsState = bounds_empty(f);
    for q_position in 0..f.count {
        q: ?*BoundsRow = bounds_row(f, q_position);
        if (q != null && q.index != v && q.array != v && !bounds_sum_uses(q, v) && !bounds_row_index_depends(q,
            v)) head = bounds_filter_copy(head, f, q, q_position)
    }
    head
}

// Without a proven separation, another path with the same member may alias.
// Keep facts about other members, including those of the same record.
bounds_kill_member(f: ?*BoundsState@new, member: *Member, owner: *Expr) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(f)) return f;
    if (f == null) return f;
    head: ?*BoundsState = bounds_empty(f);
    for q_position in 0..f.count {
        q: ?*BoundsRow = bounds_row(f, q_position);
        if (q != null) {
            affected: bool = false;
            left: ?*Expr = q.left;
            right: ?*Expr = q.right;
            if (left != null && !bounds_member_write_preserves(left, member, owner,
                f)) affected = true;
            if (right != null && !bounds_member_write_preserves(right, member, owner,
                f)) affected = true;
            if (!affected) head = bounds_filter_copy(head, f, q, q_position)
        }
    }
    head
}

bounds_kill_record_fields(f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(f)) return f;
    if (f == null) return f;
    head: ?*BoundsState = bounds_empty(f);
    for q_position in 0..f.count {
        q: ?*BoundsRow = bounds_row(f, q_position);
        if (q != null) {
            affected: bool = false;
            left: ?*Expr = q.left;
            right: ?*Expr = q.right;
            if (left != null && bounds_term_has_any_member(left)) affected = true;
            if (right != null && bounds_term_has_any_member(right)) affected = true;
            if (!affected) head = bounds_filter_copy(head, f, q, q_position)
        }
    }
    head
}

bounds_shallow_record(sd: *StructDef) raises Error: bool {
    m: ?*Member = sd.members;
    while (m != null) {
        if (!is_int_width_ty(m.ty) && !is_float_ty(m.ty) && !is_bool_ty(m.ty) && !is_pointer(m.ty) && !is_opt_pointer(m.ty)) {
            if (is_struct_ty(m.ty)) {
                if (!bounds_shallow_record(type_struct_def(m.ty))) return false
            } else {
                if (!is_enum_ty(m.ty)) return false;
                ed: *EnumDef = type_enum_def(m.ty);
                variant: ?*Variant = ed.variants;
                while (variant != null) {
                    if (variant.fields != null || variant.payload_ty != null) return false;
                    variant = variant.next
                }
            }
        }
        m = m.next
    }
    true
}

bounds_shallow_record_contains(sd: *StructDef, owner: *StructDef) raises Error: bool {
    if (sd == owner) return true;
    m: ?*Member = sd.members;
    while (m != null) {
        if (is_struct_ty(m.ty) && bounds_shallow_record_contains(type_struct_def(m.ty),
            owner)) return true;
        m = m.next
    }
    false
}

bounds_term_has_record_member(e: *Expr, sd: *StructDef) raises Error: bool {
    match e.kind {
        MemberAccess k -> {
            owner: ?*StructDef = bounds_record_def(k.lhs.ty);
            if (owner != null && bounds_shallow_record_contains(sd, owner)) return true;
            bounds_term_has_record_member(k.lhs, sd)
        }
        Deref k -> bounds_term_has_record_member(k.lhs, sd);
        Funcall k -> {
            a: ?*Expr = k.args;
            a != null && bounds_term_has_record_member(a, sd)
        }
        _ -> false
    }
}

// A shallow record contains no embedded aggregate whose field could be reached
// through an alias. Replacing its element changes paths through that record
// type, but not fields of unrelated records or containing array lengths.
bounds_kill_shallow_record_fields(f: ?*BoundsState@new, sd: *StructDef) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(f)) return f;
    if (f == null) return f;
    head: ?*BoundsState = bounds_empty(f);
    for q_position in 0..f.count {
        q: ?*BoundsRow = bounds_row(f, q_position);
        if (q != null) {
            affected: bool = false;
            left: ?*Expr = q.left;
            right: ?*Expr = q.right;
            if (left != null && bounds_term_has_record_member(left, sd)) affected = true;
            if (right != null && bounds_term_has_record_member(right, sd)) affected = true;
            if (!affected) head = bounds_filter_copy(head, f, q, q_position)
        }
    }
    head
}

// A read-only call keeps every fact rooted in stable local values. Check
// without rebuilding the table, then retain its storage while dropping rules.
bounds_pure_call_keeps_all(f: ?*BoundsState, callee: *Function) raises IndexOutOfBounds: bool {
    storage: ?*BoundsStorage = if (f == null) null else f.storage;
    if (f == null || storage == null) return true;
    rows: []BoundsRow = f.rows_view;
    numeric: []BoundsNumericView = f.numeric_view;
    count: int = f.count;
    for position in 0..count {
        row: *BoundsRow = &rows[position];
        if (row.kind == BoundsKind.Equal || row.kind == BoundsKind.NotEqual) {
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            if (left == null || right == null || !bounds_effect_preserves_term(callee,
                left) || !bounds_effect_preserves_term(callee, right)) return false
        } else if (row.kind == BoundsKind.Difference) {
            left2: ?*Expr = row.left;
            right2: ?*Expr = row.right;
            if (left2 == null || right2 == null) return false;
            edge: *BoundsNumericView = &numeric[position];
            if (!bounds_numeric_local_value(&edge.left, left2) || !bounds_numeric_local_value(&edge.right,
                right2)) {
                if (!bounds_term_roots_stable(left2) || !bounds_term_roots_stable(right2)) return false
            }
        } else {
            if (!row.index.is_local || row.index.bounds_addr_taken) return false;
            array: ?*Obj = row.array;
            if (array != null && (!array.is_local || array.bounds_addr_taken)) return false
        }
    }
    true
}

bounds_after_call(f: ?*BoundsState@new, callee: ?*Function, args: ?*Expr) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(f)) return f;
    storage: ?*BoundsStorage = if (f == null) null else f.storage;
    if (f == null || storage == null || f.count == 0) return null;
    rows: []BoundsRow = f.rows_view;
    numeric: []BoundsNumericView = f.numeric_view;
    count: int = f.count;
    if (callee != null && !callee.bounds_unknown_write && callee.bounds_writes == null && !callee.bounds_element_write && bounds_pure_call_keeps_all(f,
        callee)) {
        if (f.implications == null) return f;
        return new BoundsState {
            arena: f.arena,
            unreachable: false,
            storage: f.storage,
            rows_view: f.rows_view,
            numeric_view: f.numeric_view,
            count: f.count,
            sum_count: f.sum_count,
            implications: null
        }
    }
    head: ?*BoundsState = bounds_empty(f);
    for q_position in 0..count {
        q: *BoundsRow = &rows[q_position];
        a: ?*Obj = q.array;
        stable: bool = q.index.is_local && !q.index.bounds_addr_taken;
        if (a != null) {
            if (!a.is_local || a.bounds_addr_taken) stable = false
        }
        if (q.kind == BoundsKind.Equal || q.kind == BoundsKind.NotEqual) {
            left_scalar: ?*Expr = q.left;
            right_scalar: ?*Expr = q.right;
            if (left_scalar != null && right_scalar != null) {
                if (callee != null) {
                    if (bounds_effect_preserves_term(callee, left_scalar) && bounds_effect_preserves_term(callee,
                        right_scalar)) head = bounds_filter_copy(head, f, q, q_position)
                } else if (bounds_term_local_value(left_scalar) && bounds_term_local_value(right_scalar)) head = bounds_filter_copy(head,
                    f, q, q_position)
            }
        } else if (q.kind == BoundsKind.Difference) {
            stable = false;
            local_left: ?*Expr = q.left;
            local_right: ?*Expr = q.right;
            edge: *BoundsNumericView = &numeric[q_position];
            local_values: bool = local_left != null && local_right != null && bounds_numeric_local_value(&edge.left,
                local_left) && bounds_numeric_local_value(&edge.right, local_right);
            if (local_values) head = bounds_filter_copy(head, f, q, q_position) else if (callee != null) {
                if (!callee.bounds_unknown_write) {
                    left: ?*Expr = q.left;
                    right: ?*Expr = q.right;
                    if (left != null && right != null) {
                        stable = bounds_term_roots_stable(left) && bounds_term_roots_stable(right);
                        sep: ?*BoundsSeparation = q.separation;
                        root: int = bounds_simple_relation_root(q);
                        w: ?*BoundsWrite = callee.bounds_writes;
                        while (w != null && stable) {
                            if (bounds_term_has_member(left, w.member) || bounds_term_has_member(right,
                                w.member)) {
                                formal: ?*Obj = w.root_param;
                                if (root < 0 || formal == null) stable = false else {
                                    actual: ?*Expr = bounds_arg_named(callee, args,
                                        formal.name);
                                    other: ?*Obj = bounds_var(actual);
                                    current: ?*Function = bounds_current_fn;
                                    if (other == null || current == null) stable = false else if (other.browse_id == root || !bounds_param(current,
                                        other)) stable = false else sep = bounds_separation_extend(sep,
                                        root, other.browse_id)
                                }
                            }
                            w = w.next
                        }
                        if (stable) head = bounds_copy_separation(head, q, sep)
                    }
                }
            }
        } else {
            if (stable) head = bounds_filter_copy(head, f, q, q_position)
        }
    }
    head
}

// A call cannot rebind a local scalar or slice whose address never escaped.
// A dereference is memory even when its root happens to be a local pointer.
bounds_term_local_value(term: *Expr) raises IndexOutOfBounds: bool {
    match term.kind {
        Num _ -> true;
        Null -> true;
        VariantLit k -> k.variant != null && k.inits == null;
        Var k -> {
            obj: ?*Obj = k.var;
            if (obj == null) return false;
            obj.is_local && !obj.bounds_addr_taken
        }
        Funcall k -> {
            arg: ?*Expr = k.args;
            k.target == null && streq(k.funcname, "len") && arg != null && bounds_term_local_value(arg)
        }
        _ -> false
    }
}

// Separation applies to the actual owner of the written field, not to the
// outermost root: distinct parent records may still share a child pointer.
bounds_member_write_preserves(
    term: *Expr,
    member: *Member,
    owner: *Expr,
    f: ?*BoundsState
) raises IndexOutOfBounds: bool {
    match term.kind {
        MemberAccess k -> {
            if (k.member == member && !bounds_separation_proved(k.lhs, owner, f)) return false;
            bounds_member_write_preserves(k.lhs, member, owner, f)
        }
        Deref k -> bounds_member_write_preserves(k.lhs, member, owner, f);
        Index k -> bounds_member_write_preserves(k.lhs, member, owner, f) && bounds_member_write_preserves(k.idx,
            member, owner, f);
        Binary k -> bounds_member_write_preserves(k.lhs, member, owner, f) && bounds_member_write_preserves(k.rhs,
            member, owner, f);
        Funcall k -> {
            arg: ?*Expr = k.args;
            arg != null && bounds_member_write_preserves(arg, member, owner, f)
        }
        _ -> true
    }
}

// Variable and len(variable) descriptors already hold the object identity.
// Read its current escape flags; other syntax retains the AST classification.
bounds_numeric_local_value(term: *BoundsTermRef, original: *Expr) raises IndexOutOfBounds: bool {
    obj: ?*Obj = term.obj;
    if (obj != null) return obj.is_local && !obj.bounds_addr_taken;
    bounds_term_local_value(original)
}
