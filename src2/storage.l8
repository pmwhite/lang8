compiler_reset_byte_pools() {
    compiler_bytes_32_used = 0;
    compiler_bytes_128_used = 0;
    compiler_bytes_512_used = 0;
    compiler_bytes_2048_used = 0;
    compiler_bytes_8192_used = 0;
    compiler_bytes_65536_used = 0;
    compiler_bytes_524288_used = 0;
    compiler_bytes_4194304_used = 0;
    compiler_bytes_16777216_used = 0;
    compiler_bytes_67108864_used = 0
}

// The slot size that can hold n bytes. Zero means n is above the largest class.
compiler_byte_capacity(n: int): int {
    if (n <= 32) return 32;
    if (n <= 128) return 128;
    if (n <= 512) return 512;
    if (n <= 2048) return 2048;
    if (n <= 8192) return 8192;
    if (n <= 65536) return 65536;
    if (n <= 524288) return 524288;
    if (n <= 4194304) return 4194304;
    if (n <= 16777216) return 16777216;
    if (n <= 67108864) return 67108864;
    0
}

type CompilerEmptySlot = {
    count: int;
    data: [1]i8
}

compiler_empty_slot: CompilerEmptySlot = CompilerEmptySlot { count: 0, data: zeroed([1]i8) };

extern compiler_as_ints(p: *i8): []int = l8_as_int;

extern compiler_as_bools(p: *i8): []bool = l8_as_int;

// nbytes of zeroed storage whose slice length is count, not the byte size.
compiler_take_sized(nbytes: int, count: int): *i8 {
    if (nbytes < 0 || count < 0) compiler_pool_exhausted("negative byte object size");
    if (nbytes == 0 || count == 0) return &compiler_empty_slot.data[0];
    header: *int = &compiler_empty_slot.count;
    out: []i8 = "";
    if (nbytes <= 32) {
        i: int = compiler_bytes_32_used;
        if (i >= COMPILER_BYTES_32_CAPACITY) compiler_pool_exhausted("bytes up to 32 (131072 slots)");
        compiler_bytes_32_used = i + 1;
        compiler_bytes_32[i].count = nbytes;
        header = &compiler_bytes_32[i].count;
        out = compiler_counted_bytes(&compiler_bytes_32[i].data[0])
    } else if (nbytes <= 128) {
        i: int = compiler_bytes_128_used;
        if (i >= COMPILER_BYTES_128_CAPACITY) compiler_pool_exhausted("bytes up to 128 (65536 slots)");
        compiler_bytes_128_used = i + 1;
        compiler_bytes_128[i].count = nbytes;
        header = &compiler_bytes_128[i].count;
        out = compiler_counted_bytes(&compiler_bytes_128[i].data[0])
    } else if (nbytes <= 512) {
        i: int = compiler_bytes_512_used;
        if (i >= COMPILER_BYTES_512_CAPACITY) compiler_pool_exhausted("bytes up to 512 (16384 slots)");
        compiler_bytes_512_used = i + 1;
        compiler_bytes_512[i].count = nbytes;
        header = &compiler_bytes_512[i].count;
        out = compiler_counted_bytes(&compiler_bytes_512[i].data[0])
    } else if (nbytes <= 2048) {
        i: int = compiler_bytes_2048_used;
        if (i >= COMPILER_BYTES_2048_CAPACITY) compiler_pool_exhausted("bytes up to 2048 (4096 slots)");
        compiler_bytes_2048_used = i + 1;
        compiler_bytes_2048[i].count = nbytes;
        header = &compiler_bytes_2048[i].count;
        out = compiler_counted_bytes(&compiler_bytes_2048[i].data[0])
    } else if (nbytes <= 8192) {
        i: int = compiler_bytes_8192_used;
        if (i >= COMPILER_BYTES_8192_CAPACITY) compiler_pool_exhausted("bytes up to 8192 (1024 slots)");
        compiler_bytes_8192_used = i + 1;
        compiler_bytes_8192[i].count = nbytes;
        header = &compiler_bytes_8192[i].count;
        out = compiler_counted_bytes(&compiler_bytes_8192[i].data[0])
    } else if (nbytes <= 65536) {
        i: int = compiler_bytes_65536_used;
        if (i >= COMPILER_BYTES_65536_CAPACITY) compiler_pool_exhausted("bytes up to 65536 (256 slots)");
        compiler_bytes_65536_used = i + 1;
        compiler_bytes_65536[i].count = nbytes;
        header = &compiler_bytes_65536[i].count;
        out = compiler_counted_bytes(&compiler_bytes_65536[i].data[0])
    } else if (nbytes <= 524288) {
        i: int = compiler_bytes_524288_used;
        if (i >= COMPILER_BYTES_524288_CAPACITY) compiler_pool_exhausted("bytes up to 524288 (32 slots)");
        compiler_bytes_524288_used = i + 1;
        compiler_bytes_524288[i].count = nbytes;
        header = &compiler_bytes_524288[i].count;
        out = compiler_counted_bytes(&compiler_bytes_524288[i].data[0])
    } else if (nbytes <= 4194304) {
        i: int = compiler_bytes_4194304_used;
        if (i >= COMPILER_BYTES_4194304_CAPACITY) compiler_pool_exhausted("bytes up to 4194304 (8 slots)");
        compiler_bytes_4194304_used = i + 1;
        compiler_bytes_4194304[i].count = nbytes;
        header = &compiler_bytes_4194304[i].count;
        out = compiler_counted_bytes(&compiler_bytes_4194304[i].data[0])
    } else if (nbytes <= 16777216) {
        i: int = compiler_bytes_16777216_used;
        if (i >= COMPILER_BYTES_16777216_CAPACITY) compiler_pool_exhausted("bytes up to 16777216 (4 slots)");
        compiler_bytes_16777216_used = i + 1;
        compiler_bytes_16777216[i].count = nbytes;
        header = &compiler_bytes_16777216[i].count;
        out = compiler_counted_bytes(&compiler_bytes_16777216[i].data[0])
    } else if (nbytes <= 67108864) {
        i: int = compiler_bytes_67108864_used;
        if (i >= COMPILER_BYTES_67108864_CAPACITY) compiler_pool_exhausted("bytes up to 67108864 (2 slots)");
        compiler_bytes_67108864_used = i + 1;
        compiler_bytes_67108864[i].count = nbytes;
        header = &compiler_bytes_67108864[i].count;
        out = compiler_counted_bytes(&compiler_bytes_67108864[i].data[0])
    } else compiler_pool_exhausted("byte object exceeds 67108864 bytes");
    for i in 0..nbytes out[i] = 0i8;
    header.* = count;
    &out[0]
}

compiler_take_bytes(n: int): []i8 {
    if (n < 0) compiler_pool_exhausted("negative byte object size");
    if (n == 0) return compiler_counted_bytes(&compiler_empty_slot.data[0]);
    compiler_counted_bytes(compiler_take_sized(n, n))
}

compiler_take_ints(n: int): []int {
    if (n < 0) compiler_pool_exhausted("negative byte object size");
    if (n == 0) return compiler_as_ints(&compiler_empty_slot.data[0]);
    if (n > 8388608) compiler_pool_exhausted("byte object exceeds 67108864 bytes");
    compiler_as_ints(compiler_take_sized(n * 8, n))
}

compiler_take_bools(n: int): []bool {
    if (n < 0) compiler_pool_exhausted("negative byte object size");
    if (n == 0) return compiler_as_bools(&compiler_empty_slot.data[0]);
    compiler_as_bools(compiler_take_sized(n, n))
}

// n pointer-sized zeros. The caller retags the address as its own slice type.
compiler_take_words(n: int): *i8 {
    if (n < 0) compiler_pool_exhausted("negative byte object size");
    if (n == 0) return &compiler_empty_slot.data[0];
    if (n > 8388608) compiler_pool_exhausted("byte object exceeds 67108864 bytes");
    compiler_take_sized(n * 8, n)
}

extern compiler_as_opt_strs(p: *i8): []?str = l8_as_int;

extern compiler_as_strs(p: *i8): []str = l8_as_int;

extern compiler_as_byte_slices(p: *i8): [][]i8 = l8_as_int;

extern compiler_as_opt_byte_slices(p: *i8): []?[]i8 = l8_as_int;

compiler_take_opt_strs(n: int): []?str {
    out: []?str = compiler_as_opt_strs(compiler_take_words(n));
    none: ?str = null;
    for i in 0..n out[i] = none;
    out
}

compiler_take_strs(n: int, fill: str): []str {
    out: []str = compiler_as_strs(compiler_take_words(n));
    for i in 0..n out[i] = fill;
    out
}

compiler_take_byte_slices(n: int): [][]i8 {
    out: [][]i8 = compiler_as_byte_slices(compiler_take_words(n));
    for i in 0..n out[i] = "";
    out
}

compiler_take_opt_byte_slices(n: int): []?[]i8 {
    out: []?[]i8 = compiler_as_opt_byte_slices(compiler_take_words(n));
    none: ?[]i8 = null;
    for i in 0..n out[i] = none;
    out
}

const COMPILER_STRBUF_CAPACITY: int = 65536;

compiler_strbuf_slots: []StrBuf = static_buffer(COMPILER_STRBUF_CAPACITY, StrBuf { data: "", used: 0 });

compiler_strbuf_used: int = 0;

compiler_take_strbuf(value: StrBuf): *StrBuf {
    i: int = compiler_strbuf_used;
    if (i >= COMPILER_STRBUF_CAPACITY) compiler_pool_exhausted("strbuf (65536)");
    compiler_strbuf_used = i + 1;
    compiler_strbuf_slots[i] = value;
    &compiler_strbuf_slots[i]
}

const COMPILER_SOURCE_TEXT_CAPACITY: int = 4096;

compiler_source_text_slots: []SourceText = static_buffer(COMPILER_SOURCE_TEXT_CAPACITY,
    SourceText { data: "", used: 0 });

compiler_source_text_used: int = 0;

compiler_take_source_text(value: SourceText): *SourceText {
    i: int = compiler_source_text_used;
    if (i >= COMPILER_SOURCE_TEXT_CAPACITY) compiler_pool_exhausted("source_text (4096)");
    compiler_source_text_used = i + 1;
    compiler_source_text_slots[i] = value;
    &compiler_source_text_slots[i]
}

// A str and a byte slice share the counted representation. This internal
// borrow is read-only: callers inspect argv, constants and text spans.
extern compiler_readonly_text(text: str): []i8 = l8_as_int;

extern compiler_text_at(p: *i8): str = l8_as_int;

compiler_copy_text(text: str): []i8 {
    n: int = len(text);
    out: []i8 = compiler_take_bytes(n);
    for i in 0..n out[i] = text[i];
    out
}

compiler_owned_text(bytes: []i8): str {
    n: int = len(bytes);
    p: *i8 = compiler_take_sized(n + 1, n);
    out: []i8 = compiler_counted_bytes(p);
    for i in 0..n {
        if (bytes[i] == 0i8) compiler_pool_exhausted("text contains NUL");
        out[i] = bytes[i]
    }
    // take_sized zeroes the extra byte before installing the logical length.
    compiler_text_at(p)
}

// Runner paths outlive frontend resets, so their owners are separate slots.
type CompilerToolText = {
    count: int;
    data: [4097]i8
}

compiler_tool_slots: []CompilerToolText = static_buffer([4]CompilerToolText);

compiler_tool_used: int = 0;

compiler_tool_text(bytes: []i8): str {
    i: int = compiler_tool_used;
    n: int = len(bytes);
    if (i >= 4 || n > 4096) compiler_pool_exhausted("runner paths (4 slots of 4096 bytes)");
    compiler_tool_used = i + 1;
    compiler_tool_slots[i].count = n;
    for k in 0..n {
        if (bytes[k] == 0i8) compiler_pool_exhausted("runner path contains NUL");
        compiler_tool_slots[i].data[k] = bytes[k]
    }
    compiler_tool_slots[i].data[n] = 0i8;
    compiler_text_at(&compiler_tool_slots[i].data[0])
}
