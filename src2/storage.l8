const COMPILER_OBJ_CAPACITY: int = 65536;

compiler_objs: []Obj = static_buffer(COMPILER_OBJ_CAPACITY, Obj {
    name: "",
    is_local: false,
    is_func: false,
    is_const: false,
    is_persistent: false,
    cg_register: 0 trunc i8,
    cg_score: 0 trunc u32,
    const_val: 0,
    const_state: 0,
    offset: 0,
    scope_depth: 0,
    ty: null,
    used: false,
    init: null,
    next: null,
    param_next: null,
    hash_next: null,
    life_bound: "",
    browse_id: 0,
    browse_pos: 0,
    browse_file: 0,
    browse_len: 0,
    lead: null,
    trail: null,
    wasm_slot: 0
});

compiler_obj_used: int = 0;

compiler_take_obj(value: Obj): *Obj {
    i: int = compiler_obj_used;
    if (i >= COMPILER_OBJ_CAPACITY) compiler_pool_exhausted("objs (65536)");
    compiler_objs[i] = value;
    compiler_obj_used = i + 1;
    &compiler_objs[i]
}

