tag compiler_internal;

// Compilation-owned slots: reset between compiler invocations, never within an
// invocation. References remain stable through parsing, analysis and codegen.
const COMPILER_TOKEN_CAPACITY: int = 1048576;

const COMPILER_EXPR_CAPACITY: int = 262144;

const COMPILER_STMT_CAPACITY: int = 131072;

compiler_tokens: []Token = static_buffer(COMPILER_TOKEN_CAPACITY, Token {
    kind: TokKind.Eof,
    val: 0,
    text: null,
    len: 0,
    pos: 0,
    qualifier: "",
    next: token_eof
});

compiler_exprs: []Expr = static_buffer(COMPILER_EXPR_CAPACITY, Expr {
    kind: ExprKind.Null,
    next: null,
    ty: null,
    pos: 0,
    file: 0,
    toklen: 0,
    cg_temp: 0,
    static_data: 0
});

compiler_stmts: []Stmt = static_buffer(COMPILER_STMT_CAPACITY, Stmt {
    kind: StmtKind.Block { body: null },
    next: null,
    lead: null,
    trail: null,
    pos: 0,
    end: 0
});

compiler_token_used: int = 0;

compiler_expr_used: int = 0;

compiler_stmt_used: int = 0;

compiler_pool_exhausted(name: str): noreturn {
    raw::raw_write(2, "error: compiler static pool exhausted: ");
    raw::raw_write(2, name);
    raw::raw_write(2, "\n");
    exit(1)
}

compiler_take_token(value: Token): *Token {
    i: int = compiler_token_used;
    if (i >= COMPILER_TOKEN_CAPACITY) compiler_pool_exhausted("tokens (1048576)");
    compiler_tokens[i] = value;
    compiler_token_used = i + 1;
    &compiler_tokens[i]
}

compiler_take_expr(value: Expr): *Expr {
    i: int = compiler_expr_used;
    if (i >= COMPILER_EXPR_CAPACITY) compiler_pool_exhausted("expressions (262144)");
    compiler_exprs[i] = value;
    compiler_expr_used = i + 1;
    &compiler_exprs[i]
}

compiler_take_stmt(value: Stmt): *Stmt {
    i: int = compiler_stmt_used;
    if (i >= COMPILER_STMT_CAPACITY) compiler_pool_exhausted("statements (131072)");
    compiler_stmts[i] = value;
    compiler_stmt_used = i + 1;
    &compiler_stmts[i]
}

compiler_reset_pools() {
    compiler_source_text_used = 0;
    compiler_strbuf_used = 0;
    if (!checking_unused_functions) compiler_reset_byte_pools();
    compiler_expect_site_used = 0;
    compiler_test_case_used = 0;
    compiler_catch_frame_used = 0;
    compiler_kill_entry_used = 0;
    compiler_parse_deferred_used = 0;
    compiler_browse_occ_used = 0;
    compiler_need_lib_used = 0;
    compiler_item_used = 0;
    compiler_tag_ref_used = 0;
    compiler_tagged_def_used = 0;
    compiler_tag_scope_used = 0;
    compiler_tag_set_used = 0;
    compiler_imported_file_used = 0;
    compiler_type_invariant_used = 0;
    compiler_init_frame_used = 0;
    compiler_narrow_frame_used = 0;
    compiler_call_edge_used = 0;
    compiler_arr_ent_used = 0;
    compiler_ty_ent_used = 0;
    compiler_str_lit_used = 0;
    compiler_intern_ent_used = 0;
    compiler_variant_used = 0;
    compiler_catch_arm_used = 0;
    compiler_match_arm_used = 0;
    compiler_field_init_used = 0;
    compiler_exn_list_used = 0;
    compiler_exn_def_used = 0;
    compiler_enum_def_used = 0;
    compiler_struct_def_used = 0;
    compiler_member_used = 0;
    compiler_com_used = 0;
    compiler_type_used = 0;
    compiler_function_used = 0;
    compiler_obj_used = 0;
    compiler_token_used = 0;
    compiler_expr_used = 0;
    compiler_stmt_used = 0
}

compiler_pool_report() {
    raw::raw_write(2, "profile: pool bytes_32 ");
    emit_num_fd(2, compiler_bytes_32_used);
    raw::raw_write(2, "/131072\n");
    raw::raw_write(2, "profile: pool bytes_128 ");
    emit_num_fd(2, compiler_bytes_128_used);
    raw::raw_write(2, "/65536\n");
    raw::raw_write(2, "profile: pool bytes_512 ");
    emit_num_fd(2, compiler_bytes_512_used);
    raw::raw_write(2, "/16384\n");
    raw::raw_write(2, "profile: pool bytes_2048 ");
    emit_num_fd(2, compiler_bytes_2048_used);
    raw::raw_write(2, "/4096\n");
    raw::raw_write(2, "profile: pool bytes_8192 ");
    emit_num_fd(2, compiler_bytes_8192_used);
    raw::raw_write(2, "/1024\n");
    raw::raw_write(2, "profile: pool bytes_65536 ");
    emit_num_fd(2, compiler_bytes_65536_used);
    raw::raw_write(2, "/256\n");
    raw::raw_write(2, "profile: pool bytes_524288 ");
    emit_num_fd(2, compiler_bytes_524288_used);
    raw::raw_write(2, "/32\n");
    raw::raw_write(2, "profile: pool bytes_4194304 ");
    emit_num_fd(2, compiler_bytes_4194304_used);
    raw::raw_write(2, "/8\n");
    raw::raw_write(2, "profile: pool bytes_16777216 ");
    emit_num_fd(2, compiler_bytes_16777216_used);
    raw::raw_write(2, "/4\n");
    raw::raw_write(2, "profile: pool bytes_67108864 ");
    emit_num_fd(2, compiler_bytes_67108864_used);
    raw::raw_write(2, "/2\n");
    raw::raw_write(2, "profile: pool unused_function ");
    emit_num_fd(2, compiler_unused_function_used);
    raw::raw_write(2, "/16384\n");
    raw::raw_write(2, "profile: pool expect_site ");
