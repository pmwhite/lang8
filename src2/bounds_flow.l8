tag compiler_internal;

bounds_retire_epoch: int = 0;

bounds_array_field_use: int = 0;

// Explicit raises select the nearest matching handler. An unknown call may
// throw any exception; notifying outer handlers too is conservative.
bounds_exception(exn: ?*ExnDef, f: ?*BoundsState) noregion raises Error, IndexOutOfBounds {
    if (!bounds_reachable(f)) return;
    handler: ?*BoundsHandler = bounds_handlers;
    while (handler != null) {
        if (exn == null || handler.arm.exn == exn) {
            handler.incoming = bounds_meet(handler.incoming, f);
            if (exn != null) return
        }
        handler = handler.next
    }
}

bounds_call_exceptions(callee: ?*Function, f: ?*BoundsState) noregion raises Error, IndexOutOfBounds {
    if (callee == null) {
        bounds_exception(null, f);
        return
    }
    declared: ?*ExnList = callee.raises_list;
    while (declared != null) {
        bounds_exception(declared.exn, f);
        declared = declared.next
    }
}

// AST transfer rules. Branches carry immutable fact-table snapshots.
bounds_value_facts(path: *Expr@new, value: *Expr@new, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@f {
    if (!bounds_reachable(f)) return f;
    local: ?*Obj = bounds_var(path);
    path_ty: ?*Type = path.ty;
    if (local != null) path_ty = local.ty;
    if (bounds_pure_condition(value)) f = bounds_copy_value(f, value, path);
    // Only an optional pointer destination can record the non-null fact.
    if (path_ty != null && is_opt_pointer(path_ty) && bounds_nonnull(f, value)) f = bounds_add_nonnull(f,
        path);
    if (is_int_ty(path_ty) && bounds_pure_condition(value)) f = bounds_numeric_value(path,
        value, f);
    match value.kind {
        Trunc narrowed -> {
            if (is_i8_ty(path.ty) && bounds_nonnegative_term(f, narrowed.lhs)) {
                upper: int = bounds_small_upper(narrowed.lhs, f);
                if (upper >= 0 && upper <= 255) {
                    f = bounds_add_relation(f, path, narrowed.lhs, 0);
                    f = bounds_add_relation(f, narrowed.lhs, path, 0)
                }
            }
        }
        _ -> { }
    }
    if (local != null && bounds_expression_nonnegative(value, f)) f = bounds_add_order(f,
        new_num(0), bounds_obj_expr(local), false);
    f = bounds_constant_value(path, value, f);
    if (bounds_scalar_constant(value)) f = bounds_add_scalar_relation(f, path, value,
        BoundsKind.Equal);
    match value.kind {
        Binary k -> {
            if (k.op == BinOp.Mod && bounds_pure_condition(value) && bounds_expression_nonnegative(k.lhs,
                f) && bounds_difference_proves(f, new_num(0), k.rhs, -1)) {
                // A nonnegative remainder stays below its positive divisor.
                // Retain that relation after assigning it to a local.
                f = bounds_add_order(f, new_num(0), path, false);
                f = bounds_add_order(f, path, k.rhs, true)
            }
            if (k.op == BinOp.Div && bounds_num(k.rhs) > 0 && bounds_nonnegative_term(f,
                k.lhs)) f = bounds_add_order(f, new_num(0), path, false);
            if (k.op == BinOp.Mod) {
                modulus: int = bounds_num(k.rhs);
                if (modulus > 0 && modulus < 536870912) {
                    f = bounds_add_order(f, new_num(1 - modulus), path, false);
                    f = bounds_add_order(f, path, new_num(modulus - 1), false)
                }
            }
            if (k.op == BinOp.And || k.op == BinOp.Shr || k.op == BinOp.Shl || k.op == BinOp.Or || k.op == BinOp.Xor || k.op == BinOp.Mod || k.op == BinOp.Div || k.op == BinOp.Add || k.op == BinOp.Sub || k.op == BinOp.Mul) {
                upper: int = bounds_small_upper(value, f);
                if (upper >= 0) {
                    f = bounds_add_order(f, new_num(0), path, false);
                    f = bounds_add_order(f, path, new_num(upper), false)
                }
            }
        }
        _ -> { }
    }
    match value.kind {
        New k -> {
            count: ?*Expr = k.lhs;
            fill: ?*Expr = k.fill;
            if (count != null && fill != null && bounds_effect_preserves_value(fill,
                count)) {
                affine: ?*BoundsAffine = bounds_affine(count, true);
                if (affine != null) {
                    // With a nonnegative base, positive-offset wrap would
                    // produce a negative allocation size and cannot succeed.
                    safe: bool = affine.offset == 0 || bounds_affine_safe(affine,
                        f) || affine.offset > 0 && bounds_nonnegative_term(f, affine.base);
                    length: *Expr = bounds_len_term(path);
                    if (safe && !bounds_same_term(length, affine.base)) {
                        f = bounds_add_relation(f, length, affine.base, affine.offset);
                        f = bounds_add_relation(f, affine.base, length, 0 - affine.offset)
                    }
                }
                match count.kind {
                    Binary sum -> {
                        if (sum.op == BinOp.Add && bounds_term(sum.lhs) && bounds_term(sum.rhs) && bounds_nonnegative_term(f,
                            sum.lhs) && bounds_nonnegative_term(f, sum.rhs)) {
                            // A successful allocation has a nonnegative size. Two
                            // nonnegative signed operands can wrap only to a
                            // negative size, so each fits in the new array.
                            length2: *Expr = bounds_len_term(path);
                            f = bounds_add_order(f, sum.lhs, length2, bounds_difference_proves(f,
                                new_num(1), sum.rhs, 0));
                            f = bounds_add_order(f, sum.rhs, length2, bounds_difference_proves(f,
                                new_num(1), sum.lhs, 0))
                        }
                    }
                    _ -> { }
                }
            }
            bounds_record_facts(path, k.inits, f)
        }
        StructLit k -> bounds_record_facts(path, k.inits, f);
        Funcall call -> {
            f = bounds_return_apply(path, value, f);
            // bytes(str) has the same length as the source string.
            if (streq(call.funcname, "l8_bytes") && call.target == null) {
                source: ?*Expr = call.args;
                if (source != null && source.next == null && bounds_term(source)) {
                    f = bounds_add_relation(f, bounds_len_term(path), bounds_len_term(source),
                        0);
                    f = bounds_add_relation(f, bounds_len_term(source), bounds_len_term(path),
                        0)
                }
            }
            // The built-in read validates its array span before the syscall.
            // A successful read cannot return more bytes than that span, and
            // a negative error result is also below the array length.
            if (is_int_ty(path.ty) && call.target == null && streq(call.funcname,
                "read")) {
                fd: ?*Expr = call.args;
                buffer: ?*Expr = if (fd == null) null else fd.next;
                if (buffer != null && bounds_term(buffer)) {
                    t: ?*Type = buffer.ty;
                    if (t != null && (is_slice(t) || is_array(t))) {
                        count: ?*Expr = buffer.next;
                        safe: bool = count == null;
                        if (count != null && count.next == null && bounds_nonnegative_term(f,
                            count) && bounds_difference_proves(f, count, bounds_len_term(buffer),
                            0)) safe = true;
                        if (safe) f = bounds_add_order(f, path, bounds_len_term(buffer),
                            false)
                    }
                }
            }
            f
        }
        _ -> f
    }
}

// A local boolean initialized from a pure condition can retain facts implied
// by either result. Mutation invalidation drops these implications alongside
// the ordinary facts on which they depend.
bounds_local_bool_facts(local: *Obj@new, init: *Expr, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@f {
    if (!is_bool_ty(local.ty) || !bounds_pure_condition(init)) return f;
    for truth in [false, true] {
        branch: ?*BoundsState = bounds_condition(init, truth, f);
        if (bounds_reachable(branch)) {
            position: int = bounds_count(f);
            while (position < bounds_count(branch)) {
                row: ?*BoundsRow = bounds_row(branch, position);
                if (row != null && row.kind == BoundsKind.Difference) {
                    premise: BoundsRow = BoundsRow {
                        index: local,
                        array: null,
                        kind: BoundsKind.Equal,
                        value: 0,
                        left: bounds_obj_expr(local),
                        right: bounds_bool_literal(truth),
                        separation: null
                    };
                    f = bounds_attach_implication(f, new BoundsImplication { premises: new BoundsPremise { fact: premise, next: null }, consequence: row.*, next: null })
                }
                position = position + 1
            }
        }
    }
    f
}

bounds_pure_condition(e: *Expr) raises IndexOutOfBounds: bool {
    if (!bounds_classify_enabled) return bounds_pure_condition_uncached(e);
    cached: int = e.bounds_pure_cache;
    if (cached == bounds_classify_epoch) return false;
    if (cached == bounds_classify_epoch + 1) return true;
    result: bool = bounds_pure_condition_uncached(e);
    if (result) e.bounds_pure_cache = bounds_classify_epoch + 1 else e.bounds_pure_cache = bounds_classify_epoch;
    result
}

bounds_pure_condition_uncached(e: *Expr) raises IndexOutOfBounds: bool {
    match e.kind {
        Num _ -> true;
        Null -> true;
        VariantLit k -> k.variant != null && k.inits == null;
        Var _ -> true;
        MemberAccess k -> bounds_pure_condition(k.lhs);
        Deref k -> bounds_pure_condition(k.lhs);
        Index k -> bounds_pure_condition(k.lhs) && bounds_pure_condition(k.idx);
        As k -> bounds_pure_condition(k.lhs);
        Trunc k -> bounds_pure_condition(k.lhs);
        Binary k -> bounds_pure_condition(k.lhs) && bounds_pure_condition(k.rhs);
        Neg k -> bounds_pure_condition(k.lhs);
        Not k -> bounds_pure_condition(k.lhs);
        LogAnd k -> bounds_pure_condition(k.lhs) && bounds_pure_condition(k.rhs);
        LogOr k -> bounds_pure_condition(k.lhs) && bounds_pure_condition(k.rhs);
        Funcall k -> {
            if (streq(k.funcname, "l8_bytes") && k.target == null) {
                source: ?*Expr = k.args;
                return source != null && source.next == null && bounds_pure_condition(source)
            }
            if (!streq(k.funcname, "len")) {
                // A read-only call cannot invalidate another conjunct's facts.
                // Element stores matter here even though they preserve lengths.
                callee: ?*Function = k.fn;
                if (callee == null || k.target != null) return false;
                if (callee.bounds_unknown_write || callee.bounds_writes != null || callee.bounds_element_write) return false;
                argument: ?*Expr = k.args;
                while (argument != null) {
                    if (!bounds_pure_condition(argument)) return false;
                    argument = argument.next
                }
                return true
            }
            a: ?*Expr = k.args;
            if (a == null) return false;
            if (a.next != null) return false;
            bounds_term(a)
        }
        _ -> false
    }
}

bounds_stable_scalar_operand(e: *Expr) raises IndexOutOfBounds: bool {
    match e.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return false;
            v.is_local && !v.bounds_addr_taken && bounds_scalar_term(e)
        }
        _ -> bounds_scalar_constant(e) && bounds_scalar_term(e)
    }
}

bounds_stable_scalar_condition(e: *Expr, yes: bool, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    match e.kind {
        Var _ -> {
            if (is_bool_ty(e.ty) && bounds_stable_scalar_operand(e) && bounds_implication_needs_scalar(f,
                e)) return bounds_add_scalar_relation(f, e, bounds_bool_literal(yes),
                BoundsKind.Equal);
            f
        }
        Not k -> bounds_stable_scalar_condition(k.lhs, !yes, f);
        LogAnd k -> {
            if (!yes) return f;
            bounds_stable_scalar_condition(k.rhs, true, bounds_stable_scalar_condition(k.lhs,
                true, f))
        }
        LogOr k -> {
            if (yes) return f;
            bounds_stable_scalar_condition(k.rhs, false, bounds_stable_scalar_condition(k.lhs,
                false, f))
        }
        Binary k -> {
            if (!bounds_stable_scalar_operand(k.lhs) || !bounds_stable_scalar_operand(k.rhs)) return f;
            if (yes && k.op == BinOp.Eq || !yes && k.op == BinOp.Ne) return bounds_add_scalar_relation(f,
                k.lhs, k.rhs, BoundsKind.Equal);
            if (yes && k.op == BinOp.Ne || !yes && k.op == BinOp.Eq) return bounds_add_scalar_relation(f,
                k.lhs, k.rhs, BoundsKind.NotEqual);
            f
        }
        _ -> f
    }
}

bounds_condition(e: *Expr, yes: bool, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(f)) return f;
    match e.kind {
        Num literal -> {
            if (literal.form == LIT_TRUE && !yes || literal.form == LIT_FALSE && yes) return bounds_unreachable()
        }
        _ -> { }
    }
    if (bounds_unroll_scale > 1 && bounds_condition_refuted(e, yes, f)) return bounds_unreachable();
    bounds_close_implications(bounds_condition_facts(e, yes, f))
}

// Whether the facts already prove that comparison e is not `yes`, so its
// branch cannot run. Only an iteration of an unrolled range checks this: its
// index is a known constant, so a guard such as i > 0 can rule a branch out.
bounds_condition_refuted(e: *Expr, yes: bool, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    if (!bounds_pure_condition(e)) return false;
    match e.kind {
        Binary k -> {
            if (!is_int_ty(k.lhs.ty) || !is_int_ty(k.rhs.ty)) return false;
            // The condition as small < big, strictly or not.
            small: *Expr = k.lhs;
            big: *Expr = k.rhs;
            strict: bool = true;
            if (k.op == BinOp.Lt) strict = true else if (k.op == BinOp.Le) strict = false else if (k.op == BinOp.Gt) {
                small = k.rhs;
                big = k.lhs
            } else if (k.op == BinOp.Ge) {
                small = k.rhs;
                big = k.lhs;
                strict = false
            } else return false;
            if (!yes) {
                swap: *Expr = small;
                small = big;
                big = swap;
                strict = !strict
            }
            // Refuted when big <= small (for <) or big < small (for <=).
            bounds_difference_proves(f, big, small, if (strict) 0 else 0 - 1)
        }
        _ -> false
    }
}

// In other == base + k with k > 0, base >= 0 and other >= base rule out
// signed overflow. The equality can then contribute exact difference edges.
bounds_positive_offset_equality(f: ?*BoundsState@new, other: *Expr, shifted: *Expr@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    affine: ?*BoundsAffine = bounds_affine(shifted, true);
    if (affine == null || affine.offset <= 0 || !bounds_term(other)) return f;
    if (!bounds_affine_safe(affine, f) && (!bounds_nonnegative_term(f, affine.base) || !bounds_difference_proves(f,
        affine.base, other, 0))) return f;
    f = bounds_add_relation(f, other, affine.base, affine.offset);
    bounds_add_relation(f, affine.base, other, 0 - affine.offset)
}

bounds_condition_facts(e: *Expr, yes: bool, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_pure_condition(e)) return bounds_stable_scalar_condition(e, yes, f);
    match e.kind {
        Var _ -> {
            if (is_bool_ty(e.ty) && bounds_implication_needs_scalar(f, e)) return bounds_add_scalar_relation(f,
                e, bounds_bool_literal(yes), BoundsKind.Equal);
            f
        }
        Funcall _ -> bounds_call_condition(e, yes, f);
        Not k -> bounds_condition(k.lhs, !yes, f);
        LogAnd k -> {
            if (!yes) return f;
            bounds_condition(k.rhs, true, bounds_condition(k.lhs, true, f))
        }
        LogOr k -> {
            if (yes) return f;
            bounds_condition(k.rhs, false, bounds_condition(k.lhs, false, f))
        }
        Binary k -> {
            if (yes && k.op == BinOp.Gt && bounds_num(k.rhs) == 0) {
                match k.lhs.kind {
                    Binary remainder -> {
                        if (remainder.op == BinOp.Mod && bounds_num(remainder.rhs) > 0 && bounds_nonnegative_term(f,
                            remainder.lhs)) f = bounds_add_order(f, new_num(0), remainder.lhs,
                            true)
                    }
                    _ -> { }
                }
            }
            if (yes && k.op == BinOp.Eq || !yes && k.op == BinOp.Ne) f = bounds_add_scalar_relation(f,
                k.lhs, k.rhs, BoundsKind.Equal);
            if (yes && k.op == BinOp.Ne || !yes && k.op == BinOp.Eq) f = bounds_add_scalar_relation(f,
                k.lhs, k.rhs, BoundsKind.NotEqual);
            if (yes && k.op == BinOp.Ne || !yes && k.op == BinOp.Eq) {
                lhs: ?*Obj = bounds_var(k.lhs);
                rhs: ?*Obj = bounds_var(k.rhs);
                if (lhs != null && rhs != null && lhs != rhs) f = bounds_add(f, lhs,
                    rhs, BoundsKind.Separate)
            }
            if (yes && k.op == BinOp.Lt || !yes && k.op == BinOp.Ge) return bounds_add_difference(f,
                k.lhs, k.rhs, true);
            if (yes && k.op == BinOp.Le || !yes && k.op == BinOp.Gt) return bounds_add_difference(f,
                k.lhs, k.rhs, false);
            if (yes && k.op == BinOp.Gt || !yes && k.op == BinOp.Le) return bounds_add_difference(f,
                k.rhs, k.lhs, true);
            if (yes && k.op == BinOp.Ge || !yes && k.op == BinOp.Lt) return bounds_add_difference(f,
                k.rhs, k.lhs, false);
            if (yes && k.op == BinOp.Eq || !yes && k.op == BinOp.Ne) {
                f = bounds_positive_offset_equality(f, k.lhs, k.rhs);
                f = bounds_positive_offset_equality(f, k.rhs, k.lhs);
                f = bounds_add_difference(f, k.lhs, k.rhs, false);
                return bounds_add_difference(f, k.rhs, k.lhs, false)
            }
            // A nonnegative integer that is not zero is at least one.
            if (yes && k.op == BinOp.Ne || !yes && k.op == BinOp.Eq) {
                if (bounds_num(k.lhs) == 0 && (bounds_length_expr(k.rhs) || bounds_nonnegative_term(f,
                    k.rhs))) return bounds_add_order(f, new_num(0), k.rhs, true);
                if (bounds_num(k.rhs) == 0 && (bounds_length_expr(k.lhs) || bounds_nonnegative_term(f,
                    k.lhs))) return bounds_add_order(f, new_num(0), k.lhs, true)
            }
            f
        }
        _ -> f
    }
}

bounds_invariant_proved(e: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    !bounds_reachable(f) || bounds_pure_condition(e) && bounds_precondition_proved(e,
        f)
}

bounds_infer_invariant_entry(e: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds {
    if (!bounds_infer_mode) return;
    match e.kind {
        LogAnd k -> {
            bounds_infer_invariant_entry(k.lhs, f);
            bounds_infer_invariant_entry(k.rhs, f)
        }
        Binary k -> {
            if (k.op == BinOp.Le && bounds_num(k.lhs) == 0 && !bounds_nonnegative_term(f,
                k.rhs)) {
                fn: ?*Function = bounds_current_fn;
                if (fn != null) _added: bool = bounds_add_nonnegative_requirement(fn,
                    k.rhs)
            }
            if (k.op == BinOp.Le && !bounds_difference_proves(f, k.lhs, k.rhs, 0)) {
                match k.rhs.kind {
                    Funcall length_call -> {
                        if (streq(length_call.funcname, "len") && length_call.target == null) {
                            array: ?*Expr = length_call.args;
                            fn2: ?*Function = bounds_current_fn;
                            if (array != null && fn2 != null) _added2: bool = bounds_add_requirement(fn2,
                                array, k.lhs, true)
                        }
                    }
                    _ -> { }
                }
            }
        }
        _ -> { }
    }
}

bounds_count_fits(a: *Expr@new, count: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    bounds_difference_proves(f, count, bounds_length(a), 0)
}

bounds_proves(a: *Expr@new, i: *Expr@new, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    // The expression range domain handles masks/products; all array-relative
    // reasoning uses the same difference query as contracts and invariants.
    if (bounds_difference_index(f, a, i)) return true;
    if (bounds_bounded_offset_index(f, a, i)) return true;
    symbolic: ?*BoundsAffine = bounds_symbolic_upper(i, f);
    if (symbolic != null) {
        if (bounds_difference_proves(f, symbolic.base, bounds_length(a), 0 - symbolic.offset - 1)) return true
    }
    upper: int = bounds_small_upper(i, f);
    upper >= 0 && bounds_difference_proves(f, new_num(upper), bounds_length(a), -1)
}

bounds_inits(inits: ?*FieldInit@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds: ?*BoundsState@f {
    q: ?*FieldInit = inits;
    while (q != null) {
        f = bounds_expr(q.lhs, f);
        if (!bounds_reachable(f)) return f;
        value: ?*Expr = q.lhs;
        member: ?*Member = q.member;
        if (value != null && member != null) bounds_require_type_invariant(member.ty,
            value, f);
        if (value != null && member != null) bounds_require_array_fill(member, value,
            f);
        q = q.next
    }
    f
}

bounds_expr_list(e: ?*Expr@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds: ?*BoundsState@f {
    q: ?*Expr = e;
    while (q != null) {
        f = bounds_expr(q, f);
        if (!bounds_reachable(f)) return f;
        q = q.next
    }
    f
}

bounds_expr(e: ?*Expr@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (e == null || !bounds_reachable(f)) return f;
    out: ?*BoundsState = bounds_expr_transfer(e, f);
    ty: ?*Type = e.ty;
    if (ty != null && is_noreturn_ty(ty)) return bounds_unreachable();
    out
}

// Boolean expressions need not retain both complementary predicate states.
// Coarsen a live skipped edge to the entry state, avoiding full-prefix copies
// at every &&/||. Refine it when it is the only survivor. Literal tests are
// cheap and retain the facts of an unconditionally evaluated RHS.
bounds_short_circuit_join(
    condition: *Expr,
    skip_when: bool,
    entry: ?*BoundsState@new,
    evaluated: ?*BoundsState
) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(evaluated)) return bounds_condition(condition, skip_when,
        entry);
    match condition.kind {
        Num _ -> bounds_meet(bounds_condition(condition, skip_when, entry), evaluated);
        _ -> bounds_meet(entry, evaluated)
    }
}

bounds_expr_transfer(e: *Expr@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds: ?*BoundsState@new {
    n: *Expr = e;
    match n.kind {
        Index k -> {
            saved_use: int = bounds_array_field_use;
            if (bounds_array_field(k.lhs) != null) bounds_array_field_use = 1;
            f = bounds_expr(k.lhs, f);
            bounds_array_field_use = saved_use;
            if (!bounds_reachable(f)) return f;
            f = bounds_expr(k.idx, f);
            if (!bounds_reachable(f)) return f;
            // The array is evaluated before the index. A mutating index
            // may replace its source path, so post-evaluation facts alone
            // cannot justify access to the captured array.
            proved: bool = false;
            // Missing parameter facts may become caller obligations.
            if (bounds_infer_mode && bounds_value_stable(k.idx)) bounds_require(k.lhs,
                k.idx, f, n.file, n.pos);
            // Proven accesses are obligations of final validation.
            if (!bounds_infer_mode) proved = bounds_value_stable(k.idx) && bounds_proves(k.lhs,
                k.idx, f);
            if (!bounds_infer_mode) {
                access: ?*BoundsAccess = n.bounds_access;
                if (access == null) {
                    access = new BoundsAccess {
                        file: n.file,
                        pos: n.pos,
                        array: k.lhs,
                        index: k.idx,
                        required: false,
                        next: bounds_accesses
                    };
                    bounds_accesses = access;
                    n.bounds_access = access
                }
                if (!proved) access.required = true
            }
            // On the normal successor the operands are in bounds.
            // Reuse source paths only when evaluating the index preserves them.
            if (!proved && bounds_term(k.lhs) && bounds_value_stable(k.idx)) {
                zero: *Expr = new_num(0);
                length: *Expr = bounds_length(k.lhs);
                if (!bounds_difference_entails(f, zero, k.idx, 0)) f = bounds_add_order(f,
                    zero, k.idx, false);
                if (!bounds_difference_entails(f, k.idx, length, -1)) f = bounds_add_order(f,
                    k.idx, length, true)
            }
            // A successful access on a nonnegative base plus a positive
            // offset also bounds the base. Overflow would make the index
            // negative, so it cannot occur on this normal edge.
            if (bounds_term(k.lhs) && bounds_value_stable(k.idx)) {
                affine: ?*BoundsAffine = bounds_affine(k.idx, true);
                if (affine != null && affine.offset > 0 && bounds_nonnegative_term(f,
                    affine.base)) f = bounds_add_order(f, affine.base, bounds_length(k.lhs),
                    true)
            }
            q: ?*ArrayInvariant = bounds_array_field(k.lhs);
            if (q != null && bounds_term(n) && bounds_value_stable(k.idx)) f = bounds_condition(bounds_array_predicate(q,
                n), true, f);
            f
        }
        Binary k -> bounds_expr(k.rhs, bounds_expr(k.lhs, f));
        Assign k -> {
            // Ordinary assignments evaluate the RHS before the LHS address.
            // Doing the same for aggregate literals is conservative.
            f = bounds_expr(k.rhs, f);
            saved_assign_use: int = bounds_array_field_use;
            if (bounds_array_field(k.lhs) != null) bounds_array_field_use = 1;
            f = bounds_expr(k.lhs, f);
            bounds_array_field_use = saved_assign_use;
            if (!bounds_reachable(f)) return f;
            match k.lhs.kind {
                MemberAccess field -> {
                    member: ?*Member = field.member;
                    if (member != null) bounds_require_array_fill(member, k.rhs, f)
                }
                Index indexed -> {
                    q: ?*ArrayInvariant = bounds_array_field(indexed.lhs);
                    if (q != null) bounds_require_array_element(q, k.rhs, f)
                }
                _ -> { }
            }
            v: ?*Obj = bounds_var(k.lhs);
            expected: ?*Type = k.lhs.ty;
            if (v != null) expected = v.ty;
            bounds_require_type_invariant(expected, k.rhs, f);
            if (v == null) {
                match k.lhs.kind {
                    MemberAccess field -> {
                        member: ?*Member = field.member;
                        if (member == null) return bounds_after_call(f, null, null);
                        sd: ?*StructDef = bounds_record_def(field.lhs.ty);
                        preproved: bool = false;
                        if (sd != null) {
                            if (sd.invariant != null) {
                                if (!bounds_term(field.lhs)) error_at_file(n.file,
                                    n.pos, "record invariant assignment requires a stable record path");
                                preproved = bounds_record_write_preproved(sd, field.lhs,
                                    member, k.rhs, f)
                            }
                        }
                        saved_pending: ?*Member = bounds_pending_member;
                        if (!preproved) bounds_pending_member = member;
                        f = bounds_kill_member(f, member, field.lhs);
                        f = bounds_value_facts(k.lhs, k.rhs, f);
                        if (sd != null) {
                            if (sd.invariant == null) {
                                bounds_pending_member = saved_pending;
                                return f
                            }
                            if (preproved) f = bounds_record_invariant_facts(sd, field.lhs,
                                f) else f = bounds_verify_record_invariant(sd, field.lhs,
                                f, n.file, n.pos)
                        }
                        bounds_pending_member = saved_pending;
                        return f
                    }
                    Index _ -> {
                        f = bounds_kill_elements(f, k.lhs);
                        // Replacing a record element may change fields seen
                        // through a pointer to that element.
                        t: ?*Type = k.lhs.ty;
                        if (t != null) {
                            if (is_struct_ty(t)) {
                                sd: *StructDef = type_struct_def(t);
                                if (bounds_shallow_record(sd)) f = bounds_kill_shallow_record_fields(f,
                                    sd) else f = bounds_kill_record_fields(f)
                            } else if (is_enum_ty(t) || is_exn_ty(t) || is_array(t)) f = bounds_kill_record_fields(f)
                        }
                        if (bounds_term_roots_stable(k.rhs) && bounds_pure_condition(k.rhs)) f = bounds_value_facts(k.lhs,
                            k.rhs, f);
                        return f
                    }
                    _ -> return bounds_after_call(f, null, null)
                }
            }
            v.bounds_written = true;
            rhs_upper: int = -1;
            if (bounds_pure_condition(k.rhs)) rhs_upper = bounds_small_upper(k.rhs,
                f);
            keep_nonnegative: bool = rhs_upper >= 0 || bounds_return_nonnegative(k.rhs,
                f);
            shift: int = bounds_return_self_offset(v, k.rhs);
            // A call whose arguments read v, as in i = next(i), states its
            // result in terms of the old v. Give those facts to a temporary
            // first, and make v equal to it once the old value is gone.
            result: ?*Obj = null;
            if (is_int_ty(v.ty) && bounds_call_reads(k.rhs, v)) {
                temp: *Obj = bounds_result_temporary(v.ty);
                f = bounds_value_facts(bounds_obj_expr(temp), k.rhs, f);
                result = temp
            }
            arithmetic_shift: bool = false;
            affine: ?*BoundsAffine = bounds_affine(k.rhs, true);
            if (affine != null) {
                if (bounds_var(affine.base) == v && bounds_affine_safe(affine, f)) {
                    shift = affine.offset;
                    arithmetic_shift = true
                }
            }
            if (shift == 1000000000) f = bounds_forget_scalar(f, v) else f = bounds_shift_value(f,
                v, shift);
            if (keep_nonnegative) f = bounds_add_order(f, new_num(0), bounds_obj_expr(v),
                false);
            if (arithmetic_shift) return f;
            if (result != null) {
                f = bounds_add_relation(f, bounds_obj_expr(v), bounds_obj_expr(result),
                    0);
                f = bounds_add_relation(f, bounds_obj_expr(result), bounds_obj_expr(v),
                    0);
                return bounds_forget_scalar(f, result)
            }
            bounds_value_facts(bounds_obj_expr(v), k.rhs, f)
        }
        LogAnd k -> {
            f = bounds_expr(k.lhs, f);
            if (!bounds_reachable(f)) return f;
            rhs: ?*BoundsState = bounds_expr(k.rhs, bounds_condition(k.lhs, true,
                f));
            bounds_short_circuit_join(k.lhs, false, f, rhs)
        }
        LogOr k -> {
            f = bounds_expr(k.lhs, f);
            if (!bounds_reachable(f)) return f;
            rhs: ?*BoundsState = bounds_expr(k.rhs, bounds_condition(k.lhs, false,
                f));
            bounds_short_circuit_join(k.lhs, true, f, rhs)
        }
        OrElse k -> {
            f = bounds_expr(k.lhs, f);
            if (!bounds_reachable(f)) return f;
            rhs2: ?*BoundsState = bounds_expr(k.rhs, f);
            bounds_meet(f, rhs2)
        }
        Funcall k -> {
            saved_call_use: int = bounds_array_field_use;
            if (streq(k.funcname, "len") && k.args != null && bounds_array_field(k.args) != null) bounds_array_field_use = 1;
            f = bounds_expr_list(k.args, bounds_expr(k.target, f));
            bounds_array_field_use = saved_call_use;
            if (!bounds_reachable(f)) return f;
            if (streq(k.funcname, "len") || streq(k.funcname, "sizeof")) return f;
            callee: ?*Function = k.fn;
            if (callee != null) bounds_check_call(callee, k.args, f, n.file, n.pos);
            // The type of a function value says nothing about what it writes.
            f = bounds_after_call(f, if (k.target == null) callee else null, k.args);
            bounds_call_exceptions(callee, f);
            f
        }
        If k -> {
            f = bounds_expr(k.cond, f);
            yes: ?*BoundsState = bounds_expr(k.then, bounds_condition(k.cond, true,
                f));
            no: ?*BoundsState = bounds_expr(k.els, bounds_condition(k.cond, false,
                f));
            bounds_meet(yes, no)
        }
        Block k -> bounds_stmt_list(k.body, f);
        Match k -> {
            f = bounds_expr(k.cond, f);
            surviving: ?*BoundsState = bounds_unreachable();
            q: ?*MatchArm = k.arms;
            while (q != null) {
                arm: ?*BoundsState = bounds_stmt(q.body, f);
                surviving = bounds_meet(surviving, arm);
                q = q.next
            }
            surviving
        }
        Addr k -> {
            match k.lhs.kind {
                Index indexed -> {
                    if (bounds_array_field(indexed.lhs) != null) error_at_file(n.file,
                        n.pos, "cannot take the address of an element in a forall array field")
                }
                MemberAccess field -> {
                    sd: ?*StructDef = bounds_record_def(field.lhs.ty);
                    if (sd != null) {
                        if (sd.invariant != null) error_at_file(n.file, n.pos, "cannot take the address of a field in a record with an invariant")
                    }
                }
                _ -> { }
            }
            bounds_expr(k.lhs, f)
        }
        Deref k -> {
            f = bounds_expr(k.lhs, f);
            if (!bounds_reachable(f)) return f;
            bounds_require_nonnull(k.lhs, f, k.lhs.file, k.lhs.pos);
            f
        }
        Not k -> bounds_expr(k.lhs, f);
        Neg k -> bounds_expr(k.lhs, f);
        BitNot k -> bounds_expr(k.lhs, f);
        As k -> bounds_expr(k.lhs, f);
        Trunc k -> bounds_expr(k.lhs, f);
        MemberAccess k -> {
            member: ?*Member = k.member;
            if (member != null && member.quantified && bounds_array_field_use == 0) error_at_file(n.file,
                n.pos, "forall array field cannot be aliased; use direct indexing or len");
            f = bounds_expr(k.lhs, f);
            if (!bounds_reachable(f)) return f;
            t: ?*Type = k.lhs.ty;
            if (t != null && is_any_pointer(t)) bounds_require_nonnull(k.lhs, f, n.file,
                n.pos);
            sd: ?*StructDef = bounds_record_def(k.lhs.ty);
            if (sd != null && bounds_term(k.lhs)) f = bounds_record_invariant_facts(sd,
                k.lhs, f);
            f
        }
        New k -> {
            f = bounds_inits(k.inits, bounds_expr(k.fill, bounds_expr(k.lhs, f)));
            if (!bounds_reachable(f)) return f;
            fill: ?*Expr = k.fill;
            ty: ?*Type = n.ty;
            if (fill != null && ty != null) bounds_require_type_invariant(type_base(ty),
                fill, f);
            bounds_verify_record_constructor(n, k.inits, f);
            f
        }
        StructLit k -> {
            f = bounds_inits(k.inits, f);
            if (!bounds_reachable(f)) return f;
            bounds_verify_record_constructor(n, k.inits, f);
            f
        }
        VariantLit k -> bounds_inits(k.inits, f);
        ArrayLit k -> {
            elem: ?*Type = n.ty;
            if (elem != null) elem = type_base(elem);
            item: ?*Expr = k.elems;
            while (item != null) {
                f = bounds_expr(item, f);
                if (!bounds_reachable(f)) return f;
                bounds_require_type_invariant(elem, item, f);
                item = item.next
            }
            f
        }
        Sizeof k -> bounds_expr(k.e, f);
        _ -> f
    }
}

bounds_stmt_transfer(s: ?*Stmt@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (s == null || !bounds_reachable(f)) return f;
    n: *Stmt = s;
    match n.kind {
        ExprStmt k -> bounds_expr(k.lhs, f);
        Decl k -> {
            f = bounds_expr(k.init, f);
            if (!bounds_reachable(f)) return f;
            v: ?*Obj = k.var;
            if (v != null) {
                init: ?*Expr = k.init;
                if (init != null) {
                    match init.kind {
                        New _ -> {
                            if (!v.bounds_static_fresh || !bounds_classify_enabled) f = bounds_add_value(f,
                                v, null, BoundsKind.Fresh, v.browse_id)
                        }
                        _ -> { }
                    }
                }
                if (bounds_infer_mode && bounds_num(k.init) >= 0 && is_int_ty(v.ty)) f = bounds_add_value(f,
                    v, null, BoundsKind.Cursor, bounds_num(k.init));
                if (init != null) {
                    bounds_require_type_invariant(v.ty, init, f);
                    f = bounds_value_facts(bounds_obj_expr(v), init, f);
                    f = bounds_local_bool_facts(v, init, f)
                }
            }
            f
        }
        Return k -> {
            f = bounds_expr(k.lhs, f);
            if (!bounds_reachable(f)) return f;
            fn: ?*Function = bounds_current_fn;
            value: ?*Expr = k.lhs;
            if (fn != null && value != null) bounds_require_type_invariant(fn.return_ty,
                value, f);
            bounds_return_visit(k.lhs, f);
            bounds_unreachable()
        }
        Raise k -> {
            f = bounds_inits(k.inits, f);
            bounds_exception(k.exn, f);
            bounds_unreachable()
        }
        Block k -> bounds_stmt_list(k.body, f);
        Region k -> bounds_stmt(k.body, f);
        If k -> {
            f = bounds_expr(k.cond, f);
            yes: ?*BoundsState = bounds_stmt(k.then, bounds_condition(k.cond, true,
                f));
            no: ?*BoundsState = bounds_condition(k.cond, false, f);
            els: ?*Stmt = k.els;
            if (els != null) no = bounds_stmt(els, no);
            bounds_meet(yes, no)
        }
        While k -> {
            inv: ?*Expr = k.invariant;
            if (inv != null) bounds_infer_invariant_entry(inv, f);
            if (inv != null && !bounds_infer_mode && !bounds_invariant_proved(inv,
                f)) error_at_file((bounds_current_fn or error("missing current function")).browse_file,
                n.pos, "loop invariant is not proved at entry");
            invariant: ?*BoundsState = bounds_loop_seed(f, n);
            changing: bool = true;
            while (changing) {
                // The invariant holds at the loop head, before evaluating a
                // condition that may read an array or change the state.
                head: ?*BoundsState = invariant;
                if (inv != null) head = bounds_condition(inv, true, head);
                tested: ?*BoundsState = bounds_expr(k.cond, head);
                at_body: ?*BoundsState = bounds_condition(k.cond, true, tested);
                at_end: ?*BoundsState = bounds_stmt(k.body, at_body);
                if (inv != null && !bounds_infer_mode && !bounds_invariant_proved(inv,
                    at_end)) error_at_file((bounds_current_fn or error("missing current function")).browse_file,
                    n.pos, "loop invariant is not preserved by body");
                next_inv: ?*BoundsState = invariant;
                if (!bounds_subset(invariant, tested) || !bounds_subset(invariant,
                    at_end)) next_inv = bounds_widen(invariant, bounds_meet(f, bounds_meet(tested,
                    at_end)));
                changing = !bounds_same(invariant, next_inv);
                invariant = next_inv
            }
            bounds_loop_remember(f, invariant, n);
            head2: ?*BoundsState = invariant;
            if (inv != null) head2 = bounds_condition(inv, true, head2);
            tested2: ?*BoundsState = bounds_expr(k.cond, head2);
            bounds_condition(k.cond, false, tested2)
        }
        For k -> {
            f = bounds_expr(k.hi, bounds_expr(k.iter, f));
            if (!bounds_reachable(f)) return f;
            hi: ?*Expr = k.hi;
            if (hi != null) {
                av: ?*Obj = bounds_len_var(hi);
                if (av == null) {
                    upper: ?*BoundsAffine = bounds_affine(hi, false);
                    if (upper != null) {
                        if (upper.offset < 0) av = bounds_len_var(upper.base)
                    }
                }
                field_path: ?*Expr = null;
                match hi.kind {
                    Funcall len_call -> {
                        field_arg: ?*Expr = len_call.args;
                        if (streq(len_call.funcname, "len") && len_call.target == null && field_arg != null) {
                            field_array: *Expr = field_arg;
                            if (field_array.next == null) {
                                match field_array.kind {
                                    MemberAccess _ -> field_path = field_array;
                                    _ -> { }
                                }
                            }
                        }
                    }
                    _ -> { }
                }
                if (field_path != null && !bounds_field_path_safe_stmt(k.body, field_path)) field_path = null;
                unrolled: ?*BoundsState = bounds_unrolled_range(k.item, k.iter, hi,
                    k.body, f);
                if (unrolled != null) return unrolled;
                stable_order_bound: bool = bounds_stable_bound_expr(k.body, hi);
                stable_lower_bound: bool = bounds_stable_bound_expr(k.body, k.iter);
                hiconst: int = bounds_num(hi);
                if (hiconst < 0 && bounds_pure_condition(hi)) hiconst = bounds_term_numeric_upper(f,
                    hi);
                lo_const: int = -1;
                if (bounds_pure_condition(k.iter)) lo_const = bounds_term_numeric_lower(f,
                    k.iter);
                invariant2: ?*BoundsState = bounds_loop_seed(f, n);
                changing2: bool = true;
                while (changing2) {
                    facts: ?*BoundsState = invariant2;
                    if (bounds_nonnegative_term(f, k.iter) || bounds_small_upper(k.iter,
                        f) >= 0) facts = bounds_add_order(facts, new_num(0), bounds_obj_expr(k.item),
                        false);
                    if (lo_const >= 0) facts = bounds_add_order(facts, new_num(lo_const),
                        bounds_obj_expr(k.item), false);
                    if (stable_lower_bound) facts = bounds_add_order(facts, k.iter,
                        bounds_obj_expr(k.item), false);
                    if (av != null) facts = bounds_add_order(facts, bounds_obj_expr(k.item),
                        bounds_len_term(bounds_obj_expr(av)), true);
                    if (stable_order_bound) facts = bounds_add_loop_order(facts, k.item,
                        hi);
                    if (field_path != null) facts = bounds_add_order(facts, bounds_obj_expr(k.item),
                        hi, true);
                    if (hiconst >= 0) facts = bounds_add_order(facts, bounds_obj_expr(k.item),
                        new_num(hiconst), true);
                    endfacts: ?*BoundsState = bounds_stmt(k.body, facts);
                    if (bounds_reachable(endfacts) && av != null && !bounds_order(endfacts,
                        bounds_obj_expr(k.item), bounds_len_term(bounds_obj_expr(av)),
                        true)) error_at_file(hi.file, n.pos, "array used as for-loop bound may change in loop");
                    if (hiconst >= 0 && (k.item.bounds_written || k.item.bounds_addr_taken)) error_at_file(hi.file,
                        n.pos, "range index may change in loop");
                    next_inv2: ?*BoundsState = invariant2;
                    if (!bounds_subset(invariant2, endfacts)) next_inv2 = bounds_widen(invariant2,
                        bounds_meet(f, endfacts));
                    changing2 = !bounds_same(invariant2, next_inv2);
                    invariant2 = next_inv2
                }
                bounds_loop_remember(f, invariant2, n);
                return invariant2
            }
            // The collection is evaluated once. Keep facts that survive any
            // number of iterations, including the zero-iteration path.
            invariant3: ?*BoundsState = bounds_loop_seed(f, n);
            changing3: bool = true;
            while (changing3) {
                endfacts3: ?*BoundsState = bounds_stmt(k.body, invariant3);
                next_inv3: ?*BoundsState = invariant3;
                if (!bounds_subset(invariant3, endfacts3)) next_inv3 = bounds_widen(invariant3,
                    bounds_meet(f, endfacts3));
                changing3 = !bounds_same(invariant3, next_inv3);
                invariant3 = next_inv3
            }
            bounds_loop_remember(f, invariant3, n);
            invariant3
        }
        Match k -> {
            f = bounds_expr(k.cond, f);
            surviving: ?*BoundsState = bounds_unreachable();
            q: ?*MatchArm = k.arms;
            while (q != null) {
                arm: ?*BoundsState = bounds_stmt(q.body, f);
                surviving = bounds_meet(surviving, arm);
                q = q.next
            }
            surviving
        }
        Try k -> {
            saved_c: ?*CatchFrame = catch_top;
            saved_handlers: ?*BoundsHandler = bounds_handlers;
            q0: ?*CatchArm = k.arms;
            while (q0 != null) {
                catch_push(q0.exn or error("internal"));
                bounds_handlers = new BoundsHandler { arm: q0, incoming: bounds_unreachable(), next: bounds_handlers };
                q0 = q0.next
            }
            surviving: ?*BoundsState = bounds_stmt(k.body, f);
            catch_reset(saved_c);
            handler: ?*BoundsHandler = bounds_handlers;
            bounds_handlers = saved_handlers;
            while (handler != null && handler != saved_handlers) {
                caught: ?*BoundsState = bounds_stmt(handler.arm.body, handler.incoming);
                surviving = bounds_meet(surviving, caught);
                handler = handler.next
            }
            surviving
        }
        _ -> f
    }
}

// A range over a few constant values is analyzed one iteration at a time,
// with the index known exactly in each, instead of through an invariant. A
// value changed by a fixed amount in each iteration, such as a write cursor,
// keeps its bounds; an invariant would have to forget them. A range has at
// most BOUNDS_UNROLL_TRIPS values, and nested ranges share a budget of
// analyzed iterations. Null when the range does not qualify.
const BOUNDS_UNROLL_TRIPS: int = 16;

const BOUNDS_UNROLL_BUDGET: int = 64;

bounds_unroll_scale: int = 1;

bounds_unrolled_range(
    item: *Obj@new,
    lo: *Expr,
    hi: *Expr,
    body: ?*Stmt@new,
    f: ?*BoundsState@new
) noregion raises Error, IndexOutOfBounds: ?*BoundsState@new {
    first: int = bounds_num(lo);
    end: int = bounds_num(hi);
    if (first < 0 || end < first || end >= 536870912) return null;
    trips: int = end - first;
    if (trips > BOUNDS_UNROLL_TRIPS || trips > BOUNDS_UNROLL_BUDGET / bounds_unroll_scale || item.bounds_written || item.bounds_addr_taken) return null;
    if (trips == 0) return f;
    saved_scale: int = bounds_unroll_scale;
    bounds_unroll_scale = bounds_unroll_scale * trips;
    index: *Expr = bounds_obj_expr(item);
    state: ?*BoundsState = f;
    value: int = first;
    while (value < end && bounds_reachable(state)) {
        facts: ?*BoundsState = bounds_forget_scalar(state, item);
        facts = bounds_add_relation(facts, index, new_num(value), 0);
        facts = bounds_add_relation(facts, new_num(value), index, 0);
        state = bounds_stmt(body, facts);
        value = value + 1
    }
    bounds_unroll_scale = saved_scale;
    bounds_forget_scalar(state, item)
}

bounds_stmt_list(s: ?*Stmt@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds: ?*BoundsState@f {
    q: ?*Stmt = s;
    while (q != null) {
        f = bounds_stmt(q, f);
        if (!bounds_reachable(f)) return f;
        q = q.next
    }
    f
}

bounds_last_stmt(first: ?*Stmt): ?*Stmt@first {
    last: ?*Stmt = null;
    q: ?*Stmt = first;
    while (q != null) {
        last = q;
        q = q.next
    }
    last
}

// Constants survive intervening effects; state-dependent transfers do not.
bounds_constant_value(path: *Expr@new, value: *Expr, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@f {
    number: int = bounds_num(value);
    if (number > -536870912 && number < 536870912 && bounds_num(path) != number) {
        f = bounds_add_order(f, path, new_num(number), false);
        f = bounds_add_order(f, new_num(number), path, false)
    }
    length: int = bounds_known_len(value);
    if (length >= 0 && bounds_known_len(path) != length) {
        f = bounds_add_order(f, bounds_len_term(path), new_num(length), false);
        f = bounds_add_order(f, new_num(length), bounds_len_term(path), false)
    }
    f
}

// Allocation can trap, but an allocation with stable inputs cannot mutate
// a previously evaluated field initializer's paths.
bounds_value_stable(value: *Expr) raises IndexOutOfBounds: bool {
    if (bounds_pure_condition(value)) return true;
    match value.kind {
        New k -> {
            count: ?*Expr = k.lhs;
            fill: ?*Expr = k.fill;
            if (count != null && !bounds_value_stable(count)) return false;
            if (fill != null && !bounds_value_stable(fill)) return false;
            bounds_inits_stable(k.inits)
        }
        StructLit k -> bounds_inits_stable(k.inits);
        VariantLit k -> bounds_inits_stable(k.inits);
        ArrayLit k -> {
            item: ?*Expr = k.elems;
            while (item != null) {
                if (!bounds_value_stable(item)) return false;
                item = item.next
            }
            true
        }
        _ -> false
    }
}

bounds_inits_stable(inits: ?*FieldInit) raises IndexOutOfBounds: bool {
    item: ?*FieldInit = inits;
    while (item != null) {
        value: ?*Expr = item.lhs;
        if (value != null && !bounds_value_stable(value)) return false;
        item = item.next
    }
    true
}

// Loop-local declarations are initialized afresh on each iteration. Other
// uses in a loop must survive its backedge. Exception regions remain atomic.
// Parameters and address-taken locals are never retired.
bounds_live_loop_start: int = 0;

bounds_live_use(obj: ?*Obj, step: int) {
    if (obj == null) return;
    if (step < 0) obj.bounds_keep_epoch = bounds_retire_epoch else if (step > obj.bounds_live_until) {
        if (bounds_live_loop_start == 0 || obj.bounds_live_decl_step as int < bounds_live_loop_start) obj.bounds_live_until = step
    }
}

bounds_live_expr(e: ?*Expr, step: int) {
    if (e == null) return;
    match e.kind {
        Var k -> bounds_live_use(k.var, step);
        Binary k -> {
            bounds_live_expr(k.lhs, step);
            bounds_live_expr(k.rhs, step)
        }
        Assign k -> {
            bounds_live_expr(k.lhs, step);
            bounds_live_expr(k.rhs, step)
        }
        LogAnd k -> {
            bounds_live_expr(k.lhs, step);
            bounds_live_expr(k.rhs, step)
        }
        LogOr k -> {
            bounds_live_expr(k.lhs, step);
            bounds_live_expr(k.rhs, step)
        }
        OrElse k -> {
            bounds_live_expr(k.lhs, step);
            bounds_live_expr(k.rhs, step)
        }
        Index k -> {
            bounds_live_expr(k.lhs, step);
            bounds_live_expr(k.idx, step)
        }
        Not k -> bounds_live_expr(k.lhs, step);
        Neg k -> bounds_live_expr(k.lhs, step);
        BitNot k -> bounds_live_expr(k.lhs, step);
        Addr k -> bounds_live_expr(k.lhs, step);
        Deref k -> bounds_live_expr(k.lhs, step);
        MemberAccess k -> bounds_live_expr(k.lhs, step);
        As k -> bounds_live_expr(k.lhs, step);
        Trunc k -> bounds_live_expr(k.lhs, step);
        Sizeof k -> bounds_live_expr(k.e, step);
        Funcall k -> {
            bounds_live_expr(k.target, step);
            bounds_live_exprs(k.args, step)
        }
        New k -> {
            bounds_live_expr(k.lhs, step);
            bounds_live_expr(k.fill, step);
            bounds_live_inits(k.inits, step)
        }
        StructLit k -> bounds_live_inits(k.inits, step);
        VariantLit k -> bounds_live_inits(k.inits, step);
        ArrayLit k -> bounds_live_exprs(k.elems, step);
        If k -> {
            bounds_live_expr(k.cond, step);
            bounds_live_expr(k.then, step);
            bounds_live_expr(k.els, step)
        }
        Block k -> bounds_live_stmts(k.body, step);
        Match k -> {
            bounds_live_expr(k.cond, step);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                bounds_live_stmt(arm.body, step);
                arm = arm.next
            }
        }
        _ -> { }
    }
}

bounds_live_exprs(e: ?*Expr, step: int) {
    q: ?*Expr = e;
    while (q != null) {
        bounds_live_expr(q, step);
        q = q.next
    }
}

bounds_live_inits(inits: ?*FieldInit, step: int) {
    q: ?*FieldInit = inits;
    while (q != null) {
        bounds_live_expr(q.lhs, step);
        q = q.next
    }
}

bounds_live_stmt(s: ?*Stmt, step: int) {
    if (s == null) return;
    match s.kind {
        Return k -> bounds_live_expr(k.lhs, step);
        ExprStmt k -> bounds_live_expr(k.lhs, step);
        Decl k -> {
            bounds_live_use(k.var, step);
            bounds_live_expr(k.init, step)
        }
        Block k -> bounds_live_stmts(k.body, step);
        Region k -> bounds_live_stmt(k.body, step);
        If k -> {
            bounds_live_expr(k.cond, step);
            bounds_live_stmt(k.then, step);
            bounds_live_stmt(k.els, step)
        }
        While k -> {
            bounds_live_expr(k.cond, step);
            bounds_live_expr(k.invariant, step);
            bounds_live_stmt(k.body, step)
        }
        For k -> {
            bounds_live_use(k.item, step);
            bounds_live_use(k.coll, step);
            bounds_live_use(k.idx, step);
            bounds_live_use(k.n, step);
            bounds_live_expr(k.iter, step);
            bounds_live_expr(k.hi, step);
            bounds_live_stmt(k.body, step)
        }
        Match k -> {
            bounds_live_expr(k.cond, step);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                bounds_live_stmt(arm.body, step);
                arm = arm.next
            }
        }
        Raise k -> bounds_live_inits(k.inits, step);
        Try k -> {
            bounds_live_stmt(k.body, step);
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                bounds_live_stmt(arm.body, step);
                arm = arm.next
            }
        }
        Expect _ -> { }
    }
}

bounds_live_stmts(s: ?*Stmt, step: int) {
    q: ?*Stmt = s;
    while (q != null) {
        bounds_live_stmt(q, step);
        q = q.next
    }
}

// Number statement boundaries, then extend external loop uses to its exit.
// Locals declared inside the loop retain their actual last-use boundaries.
// The second walk marks retirement points without changing last-use maxima.
bounds_live_points(
    s: ?*Stmt,
    step: int,
    points: []bool,
    loop_points: []bool
): int {
    if (s == null) return step;
    match s.kind {
        Block k -> {
            q: ?*Stmt = k.body;
            while (q != null) {
                step = bounds_live_points(q, step, points, loop_points);
                q = q.next
            }
        }
        Region k -> step = bounds_live_points(k.body, step, points, loop_points);
        If k -> {
            step = bounds_live_points(k.then, step, points, loop_points);
            step = bounds_live_points(k.els, step, points, loop_points);
            bounds_live_expr(k.cond, step)
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                step = bounds_live_points(arm.body, step, points, loop_points);
                arm = arm.next
            }
            bounds_live_expr(k.cond, step)
        }
        While k -> {
            start: int = step;
            step = bounds_live_points(k.body, step, loop_points, loop_points);
            bounds_live_loop_start = start;
            bounds_live_stmt(s, step);
            bounds_live_loop_start = 0
        }
        For k -> {
            start: int = step;
            step = bounds_live_points(k.body, step, loop_points, loop_points);
            bounds_live_loop_start = start;
            bounds_live_stmt(s, step);
            bounds_live_loop_start = 0
        }
        Decl k -> {
            local: ?*Obj = k.var;
            // Truncation can only make a declaration appear earlier,
            // conservatively extending its lifetime.
            if (local != null) local.bounds_live_decl_step = step trunc u32;
            bounds_live_stmt(s, step)
        }
        _ -> bounds_live_stmt(s, step)
    }
    if (step >= 0 && step < len(points)) s.bounds_live_step = (if (points[step]) step else 0);
    step + 1
}

bounds_prepare_liveness(fn: *Function) {
    body: ?*Stmt = fn.body;
    if (body == null) return;
    step: int = bounds_live_points(body, 1, new bool[0](false), new bool[0](false));
    match body.kind {
        Block k -> {
            last: ?*Stmt = bounds_last_stmt(k.body);
            if (last != null) {
                match last.kind {
                    ExprStmt k -> bounds_live_expr(k.lhs, step);
                    _ -> { }
                }
            }
        }
        ExprStmt k -> bounds_live_expr(k.lhs, step);
        _ -> { }
    }
    bounds_live_expr(fn.bounds_ensures, step);
    points: []bool = new bool[step](false);
    // Contract uses outlive the body, including entry-value snapshots.
    p: ?*Obj = fn.params;
    while (p != null) {
        p.bounds_live_until = step;
        p = p.param_next
    }
    local: ?*Obj = fn.locals;
    while (local != null) {
        last: int = local.bounds_live_until;
        if (!local.bounds_addr_taken && last > 0 && last < len(points)) points[last] = true;
        local = local.next
    }
    // Batch the new boundaries inside loops so temporary-heavy bodies do
    // not scan the surviving state after every statement. Delayed retirement only
    // retains additional facts; it cannot remove a live value.
    loop_points: []bool = new bool[len(points)](false);
    pending: int = 0;
    for i in 0..len(points) {
        if (points[i]) {
            pending = pending + 1;
            loop_points[i] = pending >= 4;
            if (pending >= 4) pending = 0
        }
    }
    _end: int = bounds_live_points(body, 1, points, loop_points)
}

bounds_stmt(s: ?*Stmt@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds: ?*BoundsState@new {
    result: ?*BoundsState = bounds_stmt_transfer(s, f);
    // Small states cost less to scan than to prepare and maintain liveness.
    // Prepare once, when any path in this function grows beyond that size.
    if (bounds_count(result) >= 64) {
        fn: ?*Function = bounds_current_fn;
        if (fn != null && !fn.bounds_liveness_prepared) {
            fn.bounds_liveness_prepared = true;
            bounds_prepare_liveness(fn)
        }
    }
    if (s != null && s.bounds_live_step > 0) result = bounds_retire_locals(result,
        s.bounds_live_step);
    result
}

bounds_retire_candidate(obj: *Obj, step: int): bool {
    obj.is_local && !obj.bounds_addr_taken && obj.bounds_live_until > 0 && obj.bounds_live_until <= step && obj.bounds_keep_epoch != bounds_retire_epoch
}

// Only independent intervals can be removed. Relationships between objects,
// compound paths, implications and contradictory intervals retain their roots.
// This avoids discarding a dead local that is still a bridge in a live proof.
bounds_retire_path(e: ?*Expr, root: *Obj): bool {
    if (e == null) return true;
    match e.kind {
        Var k -> k.var == root;
        Num _ -> true;
        Null -> true;
        Funcall k -> {
            arg: ?*Expr = k.args;
            k.target == null && streq(k.funcname, "len") && arg != null && arg.next == null && bounds_var(arg) == root
        }
        _ -> false
    }
}

bounds_retire_keep(row: *BoundsRow) {
    bounds_live_use(row.index, -1);
    bounds_live_use(row.array, -1);
    bounds_live_expr(row.left, -1);
    bounds_live_expr(row.right, -1)
}

bounds_retire_locals(f: ?*BoundsState@new, step: int) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (f == null || !bounds_reachable(f)) return f;
    bounds_retire_epoch = bounds_retire_epoch + 1;
    count: int = f.count;
    rows: []*BoundsRow = f.rows_view;
    for i in 0..count {
        row: *BoundsRow = rows[i];
        root: *Obj = row.index;
        // Numeric endpoints already identify simple variables and lengths.
        // Reuse them instead of walking the same source expressions again.
        edge: *BoundsNumericView = f.numeric_view[i];
        if (edge.left.valid && edge.right.valid) {
            if (row.array != null && row.array != root || row.separation != null || !edge.left.is_zero && edge.left.obj != root || !edge.right.is_zero && edge.right.obj != root) bounds_retire_keep(row)
        } else if (row.array != null && row.array != root || row.kind == BoundsKind.SumUpper || row.separation != null || !bounds_retire_path(row.left,
            root) || !bounds_retire_path(row.right, root)) bounds_retire_keep(row)
    }
    rule: ?*BoundsImplication = f.implications;
    while (rule != null) {
        bounds_retire_keep(&rule.consequence);
        premise: ?*BoundsPremise = rule.premises;
        while (premise != null) {
            bounds_retire_keep(&premise.fact);
            premise = premise.next
        }
        rule = rule.next
    }
    // A contradictory component can justify proofs elsewhere through zero.
    // Keep it: no proof result or unreachable-path behavior may be weakened.
    for i in 0..count {
        row: *BoundsRow = rows[i];
        if (bounds_retire_candidate(row.index, step) && row.kind == BoundsKind.Difference) {
            edge: *BoundsNumericView = f.numeric_view[i];
            if (edge.left.valid && edge.right.valid) {
                reverse: BoundsNumericView = edge.*;
                reverse.left = edge.right;
                reverse.right = edge.left;
                back: int = bounds_direct_bound(f, &reverse);
                implicit: int = bounds_empty_distance(reverse.left, reverse.right);
                if (implicit < back) back = implicit;
                if (edge.bound <= -536870912 || edge.bound >= 536870912 || back < 1000000000 && back < 0 - edge.bound) bounds_live_use(row.index,
                    -1)
            } else bounds_live_use(row.index, -1)
        }
    }
    prefix: int = 0;
    sums: int = 0;
    while (prefix < count && !bounds_retire_candidate(rows[prefix].index, step)) {
        if (rows[prefix].kind == BoundsKind.SumUpper) sums = sums + 1;
        prefix = prefix + 1
    }
    if (prefix == count) return f;
    if (prefix < 0 || prefix > count) error("invalid live fact prefix");
    result: ?*BoundsState = new BoundsState {
        arena: f.arena,
        unreachable: false,
        storage: f.storage,
        rows_view: f.rows_view,
        numeric_view: f.numeric_view,
        count: prefix,
        sum_count: sums,
        implications: null
    };
    for i in prefix..count {
        row: *BoundsRow = rows[i];
        if (!bounds_retire_candidate(row.index, step)) result = bounds_filter_copy(result,
            f, row, i)
    }
    bounds_meet_implications(f, f, result)
}
