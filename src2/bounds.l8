tag compiler_internal;

// Facts are immutable so branches can keep their entry state.
type BoundsFact = {
    index: *Obj;
    array: ?*Obj;
    kind: int;
    value: int;
    left: ?*Expr;
    right: ?*Expr;
    separation: ?*BoundsSeparation;
    next: ?*BoundsFact
}

type BoundsAffine = {
    base: *Expr;
    offset: int
}

type BoundsGraphNode = {
    term: *Expr;
    value: int;
    known: bool;
    next: ?*BoundsGraphNode
}

type BoundsGraphEdge = {
    from: *BoundsGraphNode;
    to: *BoundsGraphNode;
    weight: int;
    next: ?*BoundsGraphEdge
}

type BoundsGraph = {
    nodes: ?*BoundsGraphNode;
    edges: ?*BoundsGraphEdge;
    last: ?*BoundsGraphEdge
}

type BoundsBest = {
    value: int
}

// Numeric facts have one meaning regardless of their compact storage kind.
type BoundsInequality = {
    left: ?*Expr;
    right: ?*Expr;
    bound: int;
    separation: ?*BoundsSeparation
}

type BoundsTodo = {
    fn: *Function;
    next: ?*BoundsTodo
}

type BoundsComponent = {
    members: ?*BoundsTodo;
    next: ?*BoundsComponent
}

// A projected difference constraint at a successful function return.
// result_left means result - term <= bound; otherwise term - result <= bound.
type BoundsReturnFact = {
    term: *Expr;
    result_left: bool;
    bound: int;
    next: ?*BoundsReturnFact
}

bounds_infer_mode: bool = false;

bounds_infer_changed: bool = false;

bounds_input_changed: bool = false;

bounds_scc_counter: int = 0;

bounds_scc_stack: ?*BoundsTodo = null;

bounds_scc_first: ?*BoundsComponent = null;

bounds_scc_last: ?*BoundsComponent = null;

bounds_current_fn: ?*Function = null;

bounds_return_accum: ?*BoundsReturnFact = null;

bounds_return_seen: bool = false;

bounds_param(fn: *Function, obj: *Obj): bool {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (p == obj) return true;
        p = p.param_next
    }
    false
}

bounds_named_param(fn: *Function, name: []i8): ?*Obj@fn {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (streq(p.name, name)) return p;
        p = p.param_next
    }
    null
}

bounds_param_id(fn: *Function, id: int): ?*Obj@fn {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (p.browse_id == id) return p;
        p = p.param_next
    }
    null
}

bounds_separation_contains(list: ?*BoundsSeparation, first: int, second: int): bool {
    q: ?*BoundsSeparation = list;
    while (q != null) {
        if (q.first == first && q.second == second || q.first == second && q.second == first) return true;
        q = q.next
    }
    false
}

bounds_separation_same(a: ?*BoundsSeparation, b: ?*BoundsSeparation): bool {
    q: ?*BoundsSeparation = a;
    while (q != null) {
        if (!bounds_separation_contains(b, q.first, q.second)) return false;
        q = q.next
    }
    q2: ?*BoundsSeparation = b;
    while (q2 != null) {
        if (!bounds_separation_contains(a, q2.first, q2.second)) return false;
        q2 = q2.next
    }
    true
}

bounds_add_separation(fn: *Function@new, first: int, second: int): bool {
    if (first == second || bounds_separation_contains(fn.bounds_separations, first,
        second)) return false;
    fn.bounds_separations = new BoundsSeparation { first: first, second: second, next: fn.bounds_separations };
    bounds_infer_changed = true;
    bounds_input_changed = true;
    true
}

bounds_separation_in_facts(f: ?*BoundsFact, first: int, second: int): bool {
    q: ?*BoundsFact = f;
    while (q != null) {
        other: ?*Obj = q.array;
        if (q.kind == 12 && other != null) {
            if (q.index.browse_id == first && other.browse_id == second || q.index.browse_id == second && other.browse_id == first) return true
        }
        q = q.next
    }
    false
}

bounds_separations_available(list: ?*BoundsSeparation, f: ?*BoundsFact): bool {
    if (bounds_infer_mode) return true;
    fn: ?*Function = bounds_current_fn;
    q: ?*BoundsSeparation = list;
    while (q != null) {
        if (!bounds_separation_in_facts(f, q.first, q.second)) {
            if (fn == null) return false;
            if (!bounds_separation_contains(fn.bounds_separations, q.first, q.second)) return false
        }
        q = q.next
    }
    true
}

bounds_note_separations(list: ?*BoundsSeparation, f: ?*BoundsFact) {
    fn: ?*Function = bounds_current_fn;
    if (fn == null || !bounds_infer_mode) return;
    q: ?*BoundsSeparation = list;
    while (q != null) {
        if (!bounds_separation_in_facts(f, q.first, q.second)) bounds_add_separation(fn,
            q.first, q.second);
        q = q.next
    }
}

// Infer requirements rooted at a parameter path. An offset index can be
// passed to callers as two integer inequalities, provided its base is also
// a parameter path.
bounds_requirement_root(
    fn: *Function,
    a: *Expr,
    i: *Expr@new,
    allow_end: bool
): bool {
    root: ?*Obj = null;
    match a.kind {
        Var _ -> root = bounds_term_root(a);
        MemberAccess _ -> root = bounds_term_root(a);
        _ -> return false
    }
    if (root == null || !bounds_param(fn, root)) return false;
    if (bounds_num(i) >= 0 && bounds_num(i) < 536870912) return true;
    offset: ?*BoundsAffine = bounds_affine(i, true);
    if (offset != null && !allow_end) {
        match i.kind {
            Binary _ -> {
                base: *Expr = offset.base;
                match base.kind {
                    Var k -> {
                        v: ?*Obj = k.var;
                        return v != null && bounds_param(fn, v)
                    }
                    MemberAccess k -> {
                        other: ?*Obj = bounds_term_root(base);
                        return other == root && k.member != null
                    }
                    _ -> return false
                }
            }
            _ -> { }
        }
    }
    match i.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return false;
            allow_end && bounds_param(fn, v)
        }
        MemberAccess k -> {
            other: ?*Obj = bounds_term_root(i);
            if (other == root && k.member != null) return true;
            false
        }
        _ -> false
    }
}

bounds_same_requirement_index(a: *Expr@new, b: *Expr@new): bool {
    x: ?*BoundsAffine = bounds_affine(a, true);
    y: ?*BoundsAffine = bounds_affine(b, true);
    if (x == null || y == null) return false;
    x.offset == y.offset && bounds_same_term(x.base, y.base)
}

bounds_add_requirement(
    fn: *Function@new,
    a: *Expr@new,
    i: *Expr@new,
    allow_end: bool
): bool {
    if (!bounds_requirement_root(fn, a, i, allow_end)) return false;
    // For a fixed nonnegative index, the largest requirement subsumes the
    // smaller ones. For a cursor offset, keep only the smallest and largest:
    // together they establish both sides of every intermediate access.
    if (!allow_end) {
        number: int = bounds_num(i);
        next_affine: ?*BoundsAffine = bounds_affine(i, true);
        lowest: ?*BoundsRequirement = null;
        highest: ?*BoundsRequirement = null;
        low_offset: int = 536870912;
        high_offset: int = -1;
        scan: ?*BoundsRequirement = fn.bounds_requirements;
        while (scan != null) {
            if (!scan.allow_end && bounds_same_array_expr(scan.array, a)) {
                old_number: int = bounds_num(scan.index);
                if (number >= 0 && old_number >= 0) {
                    if (old_number >= number) return false;
                    scan.index = i;
                    bounds_infer_changed = true;
                    bounds_input_changed = true;
                    return true
                }
                old_affine: ?*BoundsAffine = bounds_affine(scan.index, true);
                if (number < 0 && next_affine != null && old_affine != null) {
                    if (next_affine.offset >= 0 && old_affine.offset >= 0 && bounds_same_term(next_affine.base,
                        old_affine.base)) {
                        if (old_affine.offset < low_offset) {
                            low_offset = old_affine.offset;
                            lowest = scan
                        }
                        if (old_affine.offset > high_offset) {
                            high_offset = old_affine.offset;
                            highest = scan
                        }
                    }
                }
            }
            scan = scan.next
        }
        if (lowest != null && highest != null && next_affine != null) {
            if (next_affine.offset >= low_offset && next_affine.offset <= high_offset) return false;
            if (lowest != highest) {
                if (next_affine.offset < low_offset) lowest.index = i else highest.index = i;
                bounds_infer_changed = true;
                bounds_input_changed = true;
                return true
            }
        }
    }
    q: ?*BoundsRequirement = fn.bounds_requirements;
    while (q != null) {
        if (q.allow_end == allow_end && bounds_same_array_expr(q.array, a) && bounds_same_requirement_index(q.index,
            i)) return false;
        q = q.next
    }
    fn.bounds_requirements = new BoundsRequirement {
        array: a,
        index: i,
        allow_end: allow_end,
        next: fn.bounds_requirements
    };
    bounds_infer_changed = true;
    bounds_input_changed = true;
    true
}

bounds_len_term(a: *Expr@new): *Expr@new {
    mk_expr(ExprKind.Funcall {
        funcname: "len",
        args: a,
        fn: null,
        target: null
    })
}

bounds_requirement_facts(f: ?*BoundsFact@new, r: *BoundsRequirement@new): ?*BoundsFact@new {
    match r.index.kind {
        Binary _ -> {
            index: ?*BoundsAffine = bounds_affine(r.index, true);
            if (index == null) return f;
            base: *Expr = index.base;
            length: *Expr = bounds_len_term(r.array);
            root: ?*Obj = bounds_term_root(base);
            if (root == null) return f;
            f = new BoundsFact {
                index: root,
                array: bounds_term_root(length),
                kind: 14,
                value: 0 - index.offset - 1,
                left: base,
                right: length,
                separation: null,
                next: f
            };
            new BoundsFact {
                index: root,
                array: root,
                kind: 14,
                value: index.offset,
                left: new_num(0),
                right: base,
                separation: null,
                next: f
            }
        }
        _ -> {
            n: int = bounds_num(r.index);
            if (n >= 0 && n < 536870911 && !r.allow_end) {
                direct: ?*Obj = bounds_var(r.array);
                if (direct != null) f = bounds_add_value(f, direct, null, 3, n + 1)
            }
            if (!r.allow_end && bounds_num(r.index) < 0) f = bounds_add_order(f, new_num(0),
                r.index, 10);
            bounds_add_order(f, r.index, bounds_len_term(r.array), if (r.allow_end) 10 else 9)
        }
    }
}

bounds_clone_path(e: *Expr@new): ?*Expr@new {
    match e.kind {
        Num k -> new_num(k.val);
        Var k -> {
            copied: *Expr = mk_expr(ExprKind.Var { var: k.var, name: k.name, member: k.member });
            copied.ty = e.ty;
            copied
        }
        MemberAccess k -> {
            lhs: ?*Expr = bounds_clone_path(k.lhs);
            if (lhs == null) return null;
            copied: *Expr = mk_expr(ExprKind.MemberAccess { lhs: lhs, name: k.name, member: k.member });
            copied.ty = e.ty;
            copied
        }
        _ -> null
    }
}

bounds_rebind_term(e: *Expr@new, callee: *Function, args: ?*Expr@new): ?*Expr@new {
    match e.kind {
        Num k -> new_num(k.val);
        Binary k -> {
            if (k.op != BinOp.Add && k.op != BinOp.Sub) return null;
            c: int = bounds_num(k.rhs);
            if (c < 0 || c >= 536870912) return null;
            lhs: ?*Expr = bounds_rebind_term(k.lhs, callee, args);
            if (lhs == null) return null;
            match lhs.kind {
                Num number -> {
                    if (number.form == LIT_INT && number.val >= 0 && number.val < 536870912) return new_num(if (k.op == BinOp.Add) number.val + c else number.val - c)
                }
                _ -> { }
            }
            mapped: *Expr = new_binary(k.op, lhs, new_num(c));
            mapped.ty = e.ty;
            mapped
        }
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null || !bounds_param(callee, v)) return null;
            actual: ?*Expr = bounds_arg_named(callee, args, v.name);
            if (actual == null || !bounds_pure_condition(actual)) return null;
            bounds_clone_path(actual)
        }
        MemberAccess k -> {
            copied: ?*Expr = bounds_rebind_term(k.lhs, callee, args);
            if (copied == null) return null;
            mapped: *Expr = mk_expr(ExprKind.MemberAccess { lhs: copied, name: k.name, member: k.member });
            mapped.ty = e.ty;
            mapped
        }
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return null;
            a: ?*Expr = k.args;
            if (a == null) return null;
            if (a.next != null) return null;
            mapped: ?*Expr = bounds_rebind_term(a, callee, args);
            if (mapped == null) return null;
            bounds_len_term(mapped)
        }
        _ -> null
    }
}

bounds_precondition_path(e: *Expr, fn: *Function): bool {
    match e.kind {
        Var k -> {
            v: ?*Obj = k.var;
            v != null && bounds_param(fn, v)
        }
        MemberAccess k -> bounds_precondition_path(k.lhs, fn);
        _ -> false
    }
}

bounds_precondition_term(e: *Expr, fn: *Function): bool {
    if (!is_int_ty(e.ty)) return false;
    match e.kind {
        Num _ -> bounds_num(e) >= 0;
        Var _ -> bounds_precondition_path(e, fn);
        MemberAccess _ -> bounds_precondition_path(e, fn);
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            if (a.next != null) return false;
            bounds_precondition_path(a, fn)
        }
        _ -> false
    }
}

bounds_precondition_valid(e: *Expr, fn: *Function): bool {
    match e.kind {
        LogAnd k -> bounds_precondition_valid(k.lhs, fn) && bounds_precondition_valid(k.rhs,
            fn);
        Binary k -> {
            if (k.op != BinOp.Lt && k.op != BinOp.Le && k.op != BinOp.Gt && k.op != BinOp.Ge && k.op != BinOp.Eq) return false;
            bounds_precondition_term(k.lhs, fn) && bounds_precondition_term(k.rhs,
                fn)
        }
        _ -> false
    }
}

bounds_rebind_precondition(e: *Expr@new, fn: *Function, args: ?*Expr@new): ?*Expr@new {
    match e.kind {
        LogAnd k -> {
            lhs: ?*Expr = bounds_rebind_precondition(k.lhs, fn, args);
            rhs: ?*Expr = bounds_rebind_precondition(k.rhs, fn, args);
            if (lhs == null || rhs == null) return null;
            mapped: *Expr = mk_expr(ExprKind.LogAnd { lhs: lhs, rhs: rhs });
            mapped.ty = e.ty;
            mapped
        }
        Binary k -> {
            lhs: ?*Expr = bounds_rebind_term(k.lhs, fn, args);
            rhs: ?*Expr = bounds_rebind_term(k.rhs, fn, args);
            if (lhs == null || rhs == null) return null;
            mapped: *Expr = new_binary(k.op, lhs, rhs);
            mapped.ty = e.ty;
            mapped
        }
        _ -> null
    }
}

bounds_precondition_proved(e: *Expr, f: ?*BoundsFact@new): bool {
    match e.kind {
        LogAnd k -> bounds_precondition_proved(k.lhs, f) && bounds_precondition_proved(k.rhs,
            f);
        Binary k -> {
            if (k.op == BinOp.Lt) return bounds_difference_proves(f, k.lhs, k.rhs,
                -1);
            if (k.op == BinOp.Le) return bounds_difference_proves(f, k.lhs, k.rhs,
                0);
            if (k.op == BinOp.Gt) return bounds_difference_proves(f, k.rhs, k.lhs,
                -1);
            if (k.op == BinOp.Ge) return bounds_difference_proves(f, k.rhs, k.lhs,
                0);
            if (k.op == BinOp.Eq) return bounds_difference_proves(f, k.lhs, k.rhs,
                0) && bounds_difference_proves(f, k.rhs, k.lhs, 0);
            false
        }
        _ -> false
    }
}

bounds_infer_requirement(a: *Expr, i: *Expr) {
    fn: ?*Function = bounds_current_fn;
    if (fn == null) return;
    av: ?*Obj = bounds_var(a);
    iv: ?*Obj = bounds_var(i);
    if (av == null || iv == null) return;
    if (!bounds_param(fn, av) || !bounds_param(fn, iv)) return;
    if (len(iv.index_for_name) != 0) return;
    iv.index_for_name = av.name;
    bounds_infer_changed = true;
    bounds_input_changed = true
}

// Kind 15 records the current cursor as an exact offset from its value at
// function entry (array == the parameter), or from zero (array == null).
bounds_cursor_origin(f: ?*BoundsFact, value: *Obj): ?*BoundsFact@f {
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.kind == 15 && q.index == value) return q;
        q = q.next
    }
    null
}

// Translate a failed requirement on the current cursor back to an entry
// requirement. The caller can then prove the entire sequence's capacity.
bounds_infer_cursor_requirement(a: *Expr@new, i: *Expr@new, f: ?*BoundsFact@new): bool {
    fn: ?*Function = bounds_current_fn;
    if (fn == null) return false;
    affine: ?*BoundsAffine = bounds_affine(i, true);
    if (affine == null) return false;
    v: ?*Obj = bounds_var(affine.base);
    if (v == null) return false;
    origin: ?*BoundsFact = bounds_cursor_origin(f, v);
    if (origin == null) return false;
    total: int = origin.value + affine.offset;
    if (total < 0 || total >= 536870912) return false;
    source: ?*Obj = origin.array;
    if (source == null) {
        if (!bounds_requirement_root(fn, a, new_num(total), false)) return false;
        _added: bool = bounds_add_requirement(fn, a, new_num(total), false);
        return true
    }
    if (!bounds_param(fn, source)) return false;
    if (source == v && origin.value == 0) return false;
    entry: *Expr = new_binary(BinOp.Add, bounds_obj_expr(source), new_num(total));
    if (!bounds_requirement_root(fn, a, entry, false)) return false;
    _added2: bool = bounds_add_requirement(fn, a, entry, false);
    true
}

bounds_infer_loop_requirement(a: *Expr@new, i: *Expr, f: ?*BoundsFact@new) {
    item: ?*Obj = bounds_var(i);
    fn: ?*Function = bounds_current_fn;
    if (item == null || fn == null) return;
    q: ?*BoundsFact = f;
    while (q != null) {
        bound: ?*Expr = q.right;
        if (q.index == item) {
            // Literal and path bounds both describe i < bound. Export the
            // same capacity requirement regardless of how the loop stores it.
            if (q.kind == 5) bound = new_num(q.value);
            if ((q.kind == 5 || q.kind == 11) && bound != null) {
                if (bounds_add_requirement(fn, a, bound, true)) return
            }
        }
        q = q.next
    }
}

bounds_require(
    a: *Expr@new,
    i: *Expr@new,
    f: ?*BoundsFact@new,
    file: int,
    pos: int
) raises Error {
    if (bounds_checked_index(a, i)) return;
    if (bounds_proves(a, i, f)) return;
    if (bounds_infer_mode) {
        if (bounds_infer_cursor_requirement(a, i, f)) return;
        affine: ?*BoundsAffine = bounds_affine(i, true);
        if (affine != null) {
            current: ?*Obj = bounds_var(affine.base);
            fn0: ?*Function = bounds_current_fn;
            if (current != null && fn0 != null) {
                origin0: ?*BoundsFact = bounds_cursor_origin(f, current);
                entry_value: bool = false;
                if (origin0 != null) entry_value = origin0.array == current && origin0.value == 0;
                if (bounds_param(fn0, current) && current.bounds_written && !entry_value) return
            }
        }
        bounds_infer_requirement(a, i);
        fn: ?*Function = bounds_current_fn;
        if (fn != null) {
            // A bounded expression need not be expressible in a caller's
            // contract: its largest possible value is enough instead.
            upper: int = bounds_small_upper(i, f);
            if (upper >= 0 && bounds_pure_condition(i) && bounds_requirement_root(fn,
                a, new_num(upper), false)) {
                bounds_add_requirement(fn, a, new_num(upper), false);
                return
            }
            bounds_add_requirement(fn, a, i, false)
        }
        bounds_infer_loop_requirement(a, i, f);
        return
    }
    current: ?*Function = bounds_current_fn;
    entry: ?*Function = find_function("main");
    if (current != null && current == entry) {
        array_param: ?*Obj = bounds_var(a);
        index_param: ?*Obj = bounds_var(i);
        if (array_param != null && bounds_param(current, array_param)) {
            if (index_param != null && bounds_param(current, index_param)) error_at_file(file,
                pos, "main cannot require an index_for argument at entry");
            if (bounds_num(i) >= 0) error_at_file(file, pos, "main cannot require unproved array bounds at entry")
        }
    }
    error_at_file(file, pos, "array index not proved in bounds (guard it or check_index after binding variables)")
}

bounds_arg_named(fn: *Function, args: ?*Expr, name: []i8): ?*Expr@args {
    p: ?*Obj = fn.params;
    a: ?*Expr = args;
    while (p != null && a != null) {
        if (streq(p.name, name)) return a;
        p = p.param_next;
        a = a.next
    }
    null
}

bounds_separation_proved(a: *Expr, b: *Expr, f: ?*BoundsFact): bool {
    av: ?*Obj = bounds_var(a);
    bv: ?*Obj = bounds_var(b);
    if (av == null || bv == null || av == bv) return false;
    if (bounds_has(f, av, bv, 12) || bounds_has(f, bv, av, 12)) return true;
    ai: int = bounds_fact_value(f, av, 13);
    bi: int = bounds_fact_value(f, bv, 13);
    ai >= 0 && bi >= 0 && ai != bi
}

bounds_infer_caller_separation(a: *Expr, b: *Expr) {
    fn: ?*Function = bounds_current_fn;
    if (fn == null) return;
    av: ?*Obj = bounds_var(a);
    bv: ?*Obj = bounds_var(b);
    if (av == null || bv == null || av == bv) return;
    if (bounds_param(fn, av) && bounds_param(fn, bv)) bounds_add_separation(fn, av.browse_id,
        bv.browse_id)
}

bounds_check_call(
    fn: *Function@new,
    args: ?*Expr@new,
    f: ?*BoundsFact@new,
    file: int,
    pos: int
) raises Error {
    p: ?*Obj = fn.params;
    a: ?*Expr = args;
    while (p != null && a != null) {
        if (len(p.index_for_name) != 0) {
            ar: ?*Expr = bounds_arg_named(fn, args, p.index_for_name);
            if (ar == null) error_at_file(file, pos, "index_for refers to unknown array parameter");
            if (!bounds_pure_condition(ar) || !bounds_pure_condition(a)) error_at_file(file,
                pos, "index_for array and index arguments must be free of side effects (bind them to variables first)");
            bounds_require(ar, a, f, file, pos)
        }
        p = p.param_next;
        a = a.next
    }
    sep: ?*BoundsSeparation = fn.bounds_separations;
    while (sep != null) {
        first_param: ?*Obj = bounds_param_id(fn, sep.first);
        second_param: ?*Obj = bounds_param_id(fn, sep.second);
        if (first_param == null || second_param == null) error_at_file(file, pos,
            "internal: separation requirement refers to missing parameter");
        first_arg: ?*Expr = bounds_arg_named(fn, args, first_param.name);
        second_arg: ?*Expr = bounds_arg_named(fn, args, second_param.name);
        if (first_arg == null || second_arg == null) error_at_file(file, pos, "internal: separation requirement refers to missing argument");
        if (!bounds_separation_proved(first_arg, second_arg, f)) {
            if (bounds_infer_mode) bounds_infer_caller_separation(first_arg, second_arg) else error_at_file(file,
                pos, "call requires distinct record arguments for bounds proof")
        }
        sep = sep.next
    }
    requirement: ?*BoundsRequirement = fn.bounds_requirements;
    while (requirement != null) {
        mapped_array: ?*Expr = bounds_rebind_term(requirement.array, fn, args);
        mapped_index: ?*Expr = bounds_rebind_term(requirement.index, fn, args);
        if (mapped_array == null || mapped_index == null) error_at_file(file, pos,
            "bounds requirement arguments must be simple, side-effect-free paths");
        affine_call: bool = false;
        match mapped_index.kind {
            Binary _ -> affine_call = true;
            _ -> { }
        }
        proved: bool = if (requirement.allow_end) bounds_count_fits(mapped_array,
            mapped_index, f) else if (affine_call) bounds_difference_index(f, mapped_array,
            mapped_index) else bounds_proves(mapped_array, mapped_index, f);
        if (!proved) {
            if (bounds_infer_mode) {
                caller: ?*Function = bounds_current_fn;
                translated: bool = false;
                if (!requirement.allow_end) translated = bounds_infer_cursor_requirement(mapped_array,
                    mapped_index, f);
                if (!translated && caller != null) {
                    base: ?*BoundsAffine = bounds_affine(mapped_index, true);
                    current: ?*Obj = null;
                    if (base != null) current = bounds_var(base.base);
                    skip: bool = false;
                    if (current != null) {
                        origin0: ?*BoundsFact = bounds_cursor_origin(f, current);
                        entry_value: bool = false;
                        if (origin0 != null) entry_value = origin0.array == current && origin0.value == 0;
                        skip = bounds_param(caller, current) && current.bounds_written && !entry_value
                    }
                    if (!skip) bounds_add_requirement(caller, mapped_array, mapped_index,
                        requirement.allow_end)
                }
            } else error_at_file(file, pos, "call does not prove inferred array bounds requirement")
        }
        requirement = requirement.next
    }
    precondition: ?*Expr = fn.bounds_precondition;
    if (precondition != null && !bounds_infer_mode) {
        mapped: ?*Expr = bounds_rebind_precondition(precondition, fn, args);
        if (mapped == null) error_at_file(file, pos, "function precondition requires stable argument paths");
        if (!bounds_precondition_proved(mapped, f)) error_at_file(file, pos, "call does not prove function precondition")
    }
}

bounds_initial(fn: *Function@new) raises Error: ?*BoundsFact@new {
    f: ?*BoundsFact = null;
    requirement: ?*BoundsRequirement = fn.bounds_requirements;
    while (requirement != null) {
        f = bounds_requirement_facts(f, requirement);
        requirement = requirement.next
    }
    sep: ?*BoundsSeparation = fn.bounds_separations;
    while (sep != null) {
        first: ?*Obj = bounds_param_id(fn, sep.first);
        second: ?*Obj = bounds_param_id(fn, sep.second);
        if (first == null || second == null) error("internal: separation requirement refers to missing parameter");
        f = bounds_add(f, first, second, 12);
        sep = sep.next
    }
    p: ?*Obj = fn.params;
    while (p != null) {
        if (bounds_infer_mode && is_int_ty(p.ty)) f = bounds_add_value(f, p, p, 15,
            0);
        if (len(p.index_for_name) != 0) {
            a: ?*Obj = bounds_named_param(fn, p.index_for_name);
            if (a == null) error_at_file(p.browse_file, p.browse_pos, "index_for refers to unknown array parameter");
            ty: ?*Type = a.ty;
            if (ty == null) error_at_file(p.browse_file, p.browse_pos, "index_for requires an array, slice, or string parameter");
            if (!is_indexable(ty)) error_at_file(p.browse_file, p.browse_pos, "index_for requires an array, slice, or string parameter");
            f = bounds_add(f, p, null, 1);
            f = bounds_add(f, p, a, 2)
        }
        p = p.param_next
    }
    precondition: ?*Expr = fn.bounds_precondition;
    if (precondition != null) f = bounds_condition(precondition, true, f);
    f
}

bounds_var(e: ?*Expr): ?*Obj {
    if (e == null) return null;
    n: *Expr = e;
    match n.kind {
        Var k -> k.var;
        _ -> null
    }
}

bounds_same_array_expr(a: *Expr, b: *Expr): bool {
    match a.kind {
        Var x -> {
            match b.kind {
                Var y -> x.var != null && x.var == y.var;
                _ -> false
            }
        }
        MemberAccess x -> {
            match b.kind {
                MemberAccess y -> x.member != null && x.member == y.member && bounds_same_array_expr(x.lhs,
                    y.lhs);
                _ -> false
            }
        }
        Deref x -> {
            match b.kind {
                Deref y -> bounds_same_array_expr(x.lhs, y.lhs);
                _ -> false
            }
        }
        _ -> false
    }
}

// A bounds term is a variable, a chain of named fields, or the length of one.
bounds_term(e: ?*Expr): bool {
    if (e == null) return false;
    n: *Expr = e;
    match n.kind {
        Num k -> k.form == LIT_INT;
        Var k -> k.var != null;
        MemberAccess k -> bounds_term(k.lhs);
        Deref k -> bounds_term(k.lhs);
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            if (a.next != null) return false;
            bounds_term(a)
        }
        _ -> false
    }
}

bounds_same_term(a: *Expr, b: *Expr): bool {
    match a.kind {
        Num x -> {
            match b.kind {
                Num y -> x.form == LIT_INT && y.form == LIT_INT && x.val == y.val;
                _ -> false
            }
        }
        Funcall x -> {
            match b.kind {
                Funcall y -> {
                    if (!streq(x.funcname, "len") || !streq(y.funcname, "len")) return false;
                    ax: ?*Expr = x.args;
                    ay: ?*Expr = y.args;
                    if (ax == null || ay == null) return false;
                    bounds_same_array_expr(ax, ay)
                }
                _ -> false
            }
        }
        _ -> bounds_same_array_expr(a, b)
    }
}

bounds_term_root(e: *Expr): ?*Obj {
    match e.kind {
        Var k -> k.var;
        MemberAccess k -> bounds_term_root(k.lhs);
        Deref k -> bounds_term_root(k.lhs);
        Funcall k -> {
            a: ?*Expr = k.args;
            if (a == null) return null;
            bounds_term_root(a)
        }
        _ -> null
    }
}

bounds_first_member(e: *Expr): ?*Member {
    match e.kind {
        MemberAccess k -> {
            inner: ?*Member = bounds_first_member(k.lhs);
            if (inner != null) return inner;
            k.member
        }
        Deref k -> bounds_first_member(k.lhs);
        _ -> null
    }
}

bounds_effect_add(fn: *Function@new, member: *Member@new, root_param: ?*Obj@new): bool {
    q: ?*BoundsWrite = fn.bounds_writes;
    while (q != null) {
        if (q.member == member && q.root_param == root_param) return false;
        q = q.next
    }
    fn.bounds_writes = new BoundsWrite { member: member, root_param: root_param, next: fn.bounds_writes };
    true
}

bounds_effect_unknown(fn: *Function): bool {
    if (fn.bounds_unknown_write) return false;
    fn.bounds_unknown_write = true;
    true
}

bounds_effect_inits(fn: *Function@new, inits: ?*FieldInit): bool {
    changed: bool = false;
    q: ?*FieldInit = inits;
    while (q != null) {
        if (bounds_effect_expr(fn, q.lhs)) changed = true;
        q = q.next
    }
    changed
}

bounds_effect_exprs(fn: *Function@new, exprs: ?*Expr): bool {
    changed: bool = false;
    q: ?*Expr = exprs;
    while (q != null) {
        if (bounds_effect_expr(fn, q)) changed = true;
        q = q.next
    }
    changed
}

bounds_effect_two(fn: *Function@new, a: ?*Expr, b: ?*Expr): bool {
    x: bool = bounds_effect_expr(fn, a);
    y: bool = bounds_effect_expr(fn, b);
    x || y
}

bounds_effect_expr(fn: *Function@new, e: ?*Expr): bool {
    if (e == null) return false;
    n: *Expr = e;
    match n.kind {
        Assign k -> {
            changed: bool = bounds_effect_expr(fn, k.rhs);
            if (bounds_effect_expr(fn, k.lhs)) changed = true;
            match k.lhs.kind {
                MemberAccess field -> {
                    m: ?*Member = field.member;
                    if (m == null) return bounds_effect_unknown(fn);
                    root: ?*Obj = bounds_var(field.lhs);
                    if (root != null && !bounds_param(fn, root)) root = null;
                    if (bounds_effect_add(fn, m, root)) changed = true
                }
                Var v -> {
                    o: ?*Obj = v.var;
                    if (o == null) return bounds_effect_unknown(fn);
                    if (!o.is_local) return bounds_effect_unknown(fn)
                }
                Index _ -> { }
                _ -> return bounds_effect_unknown(fn)
            }
            changed
        }
        Funcall k -> {
            changed: bool = bounds_effect_expr(fn, k.target);
            if (bounds_effect_exprs(fn, k.args)) changed = true;
            if (streq(k.funcname, "len") || streq(k.funcname, "sizeof") || streq(k.funcname,
                "check_index")) return changed;
            callee: ?*Function = k.fn;
            if (callee == null) return bounds_effect_unknown(fn);
            if (callee.bounds_unknown_write && bounds_effect_unknown(fn)) changed = true;
            q: ?*BoundsWrite = callee.bounds_writes;
            while (q != null) {
                root: ?*Obj = null;
                formal: ?*Obj = q.root_param;
                if (formal != null) {
                    actual: ?*Expr = bounds_arg_named(callee, k.args, formal.name);
                    root = bounds_var(actual);
                    if (root != null && !bounds_param(fn, root)) root = null
                }
                if (bounds_effect_add(fn, q.member, root)) changed = true;
                q = q.next
            }
            changed
        }
        Binary k -> bounds_effect_two(fn, k.lhs, k.rhs);
        LogAnd k -> bounds_effect_two(fn, k.lhs, k.rhs);
        LogOr k -> bounds_effect_two(fn, k.lhs, k.rhs);
        OrElse k -> bounds_effect_two(fn, k.lhs, k.rhs);
        Index k -> bounds_effect_two(fn, k.lhs, k.idx);
        Not k -> bounds_effect_expr(fn, k.lhs);
        Neg k -> bounds_effect_expr(fn, k.lhs);
        BitNot k -> bounds_effect_expr(fn, k.lhs);
        Addr k -> bounds_effect_expr(fn, k.lhs);
        Deref k -> bounds_effect_expr(fn, k.lhs);
        MemberAccess k -> bounds_effect_expr(fn, k.lhs);
        As k -> bounds_effect_expr(fn, k.lhs);
        Trunc k -> bounds_effect_expr(fn, k.lhs);
        New k -> {
            changed: bool = bounds_effect_two(fn, k.lhs, k.fill);
            if (bounds_effect_inits(fn, k.inits)) changed = true;
            changed
        }
        StructLit k -> bounds_effect_inits(fn, k.inits);
        VariantLit k -> bounds_effect_inits(fn, k.inits);
        ArrayLit k -> bounds_effect_exprs(fn, k.elems);
        If k -> {
            changed: bool = bounds_effect_expr(fn, k.cond);
            if (bounds_effect_two(fn, k.then, k.els)) changed = true;
            changed
        }
        Block k -> bounds_effect_stmts(fn, k.body);
        Match k -> {
            changed: bool = bounds_effect_expr(fn, k.cond);
            q: ?*MatchArm = k.arms;
            while (q != null) {
                if (bounds_effect_stmt(fn, q.body)) changed = true;
                q = q.next
            }
            changed
        }
        Sizeof k -> bounds_effect_expr(fn, k.e);
        _ -> false
    }
}

bounds_effect_stmt(fn: *Function@new, s: ?*Stmt): bool {
    if (s == null) return false;
    n: *Stmt = s;
    match n.kind {
        ExprStmt k -> bounds_effect_expr(fn, k.lhs);
        Decl k -> bounds_effect_expr(fn, k.init);
        Return k -> bounds_effect_expr(fn, k.lhs);
        Raise k -> bounds_effect_inits(fn, k.inits);
        Block k -> bounds_effect_stmts(fn, k.body);
        Region k -> bounds_effect_stmt(fn, k.body);
        If k -> {
            changed: bool = bounds_effect_expr(fn, k.cond);
            if (bounds_effect_stmt(fn, k.then)) changed = true;
            if (bounds_effect_stmt(fn, k.els)) changed = true;
            changed
        }
        While k -> {
            changed: bool = bounds_effect_expr(fn, k.cond);
            if (bounds_effect_stmt(fn, k.body)) changed = true;
            changed
        }
        For k -> {
            changed: bool = bounds_effect_two(fn, k.iter, k.hi);
            if (bounds_effect_stmt(fn, k.body)) changed = true;
            changed
        }
        Match k -> {
            changed: bool = bounds_effect_expr(fn, k.cond);
            q: ?*MatchArm = k.arms;
            while (q != null) {
                if (bounds_effect_stmt(fn, q.body)) changed = true;
                q = q.next
            }
            changed
        }
        Try k -> {
            changed: bool = bounds_effect_stmt(fn, k.body);
            q: ?*CatchArm = k.arms;
            while (q != null) {
                if (bounds_effect_stmt(fn, q.body)) changed = true;
                q = q.next
            }
            changed
        }
        _ -> false
    }
}

bounds_effect_stmts(fn: *Function@new, s: ?*Stmt): bool {
    changed: bool = false;
    q: ?*Stmt = s;
    while (q != null) {
        if (bounds_effect_stmt(fn, q)) changed = true;
        q = q.next
    }
    changed
}

bounds_infer_effects() {
    fn: ?*Function = functions;
    while (fn != null) {
        fn.bounds_writes = null;
        fn.bounds_unknown_write = fn.is_extern || fn.body == null;
        fn = fn.next
    }
    changed: bool = true;
    while (changed) {
        changed = false;
        fn = functions;
        while (fn != null) {
            if (!fn.is_extern && bounds_effect_stmts(fn, fn.body)) changed = true;
            fn = fn.next
        }
    }
}

bounds_effect_has(fn: *Function, member: *Member): bool {
    q: ?*BoundsWrite = fn.bounds_writes;
    while (q != null) {
        if (q.member == member) return true;
        q = q.next
    }
    false
}

bounds_effect_preserves_term(fn: *Function, e: *Expr): bool {
    if (fn.bounds_unknown_write) return false;
    match e.kind {
        Num _ -> true;
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return false;
            v.is_local && !v.bounds_addr_taken
        }
        MemberAccess k -> {
            m: ?*Member = k.member;
            if (m == null || bounds_effect_has(fn, m)) return false;
            bounds_effect_preserves_term(fn, k.lhs)
        }
        Deref k -> bounds_effect_preserves_term(fn, k.lhs);
        Funcall k -> {
            if (!streq(k.funcname, "len")) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            bounds_effect_preserves_term(fn, a)
        }
        _ -> false
    }
}

bounds_term_roots_stable(e: *Expr): bool {
    match e.kind {
        Num _ -> true;
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return false;
            v.is_local && !v.bounds_addr_taken
        }
        MemberAccess k -> bounds_term_roots_stable(k.lhs);
        Deref k -> bounds_term_roots_stable(k.lhs);
        Funcall k -> {
            if (!streq(k.funcname, "len")) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            bounds_term_roots_stable(a)
        }
        _ -> false
    }
}

bounds_term_has_member(e: *Expr, member: *Member): bool {
    match e.kind {
        MemberAccess k -> k.member == member || bounds_term_has_member(k.lhs, member);
        Deref k -> bounds_term_has_member(k.lhs, member);
        Funcall k -> {
            a: ?*Expr = k.args;
            if (a == null) return false;
            bounds_term_has_member(a, member)
        }
        _ -> false
    }
}

bounds_term_has_any_member(e: *Expr): bool {
    match e.kind {
        MemberAccess _ -> true;
        Deref k -> bounds_term_has_any_member(k.lhs);
        Funcall k -> {
            a: ?*Expr = k.args;
            a != null && bounds_term_has_any_member(a)
        }
        _ -> false
    }
}

bounds_simple_term_on_root(e: *Expr, root: *Obj): bool {
    match e.kind {
        Num _ -> true;
        Var _ -> true;
        MemberAccess k -> bounds_var(k.lhs) == root && k.member != null;
        Funcall k -> {
            if (!streq(k.funcname, "len")) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            match a.kind {
                MemberAccess field -> bounds_var(field.lhs) == root && field.member != null;
                _ -> false
            }
        }
        _ -> false
    }
}

bounds_simple_relation_root(q: *BoundsFact): int {
    if (q.kind != 9 && q.kind != 10) return -1;
    root: ?*Obj = q.array;
    if (root == null || q.index != root) return -1;
    fn: ?*Function = bounds_current_fn;
    if (fn == null || !bounds_param(fn, root)) return -1;
    left: ?*Expr = q.left;
    right: ?*Expr = q.right;
    if (left == null || right == null) return -1;
    if (!bounds_simple_term_on_root(left, root) || !bounds_simple_term_on_root(right,
        root)) return -1;
    root.browse_id
}

bounds_separation_extend(list: ?*BoundsSeparation@new, first: int, second: int): ?*BoundsSeparation@new {
    if (bounds_separation_contains(list, first, second)) return list;
    new BoundsSeparation { first: first, second: second, next: list }
}

bounds_field_array(a: *Expr, root: *Obj, member: *Member): bool {
    match a.kind {
        MemberAccess k -> bounds_var(k.lhs) == root && k.member == member;
        _ -> false
    }
}

bounds_field_safe_args(args: ?*Expr, root: *Obj, member: *Member): bool {
    q: ?*Expr = args;
    while (q != null) {
        if (!bounds_field_safe_expr(q, root, member)) return false;
        q = q.next
    }
    true
}

bounds_field_safe_expr(e: ?*Expr, root: *Obj, member: *Member): bool {
    if (e == null) return true;
    n: *Expr = e;
    match n.kind {
        Num _ -> true;
        Null -> true;
        Var _ -> true;
        Binary k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.rhs,
            root, member);
        Assign k -> {
            match k.lhs.kind {
                Var x -> x.var != null && x.var != root && bounds_field_safe_expr(k.rhs,
                    root, member);
                Index x -> {
                    t: ?*Type = k.lhs.ty;
                    (is_int_width_ty(t) || is_float_ty(t) || is_bool_ty(t)) && bounds_field_array(x.lhs,
                        root, member) && bounds_field_safe_expr(x.idx, root, member) && bounds_field_safe_expr(k.rhs,
                        root, member)
                }
                _ -> false
            }
        }
        Index k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.idx,
            root, member);
        Not k -> bounds_field_safe_expr(k.lhs, root, member);
        Neg k -> bounds_field_safe_expr(k.lhs, root, member);
        BitNot k -> bounds_field_safe_expr(k.lhs, root, member);
        LogAnd k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.rhs,
            root, member);
        LogOr k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.rhs,
            root, member);
        OrElse k -> bounds_field_safe_expr(k.lhs, root, member) && bounds_field_safe_expr(k.rhs,
            root, member);
        Funcall k -> {
            if (k.target != null || !bounds_field_safe_args(k.args, root, member)) return false;
            if (streq(k.funcname, "len") || streq(k.funcname, "check_index")) return true;
            fn: ?*Function = k.fn;
            if (fn == null) return false;
            !fn.bounds_unknown_write && !bounds_effect_has(fn, member)
        }
        MemberAccess k -> bounds_field_safe_expr(k.lhs, root, member);
        As k -> bounds_field_safe_expr(k.lhs, root, member);
        Trunc k -> bounds_field_safe_expr(k.lhs, root, member);
        _ -> false
    }
}

bounds_field_safe_stmt_list(s: ?*Stmt, root: *Obj, member: *Member): bool {
    q: ?*Stmt = s;
    while (q != null) {
        if (!bounds_field_safe_stmt(q, root, member)) return false;
        q = q.next
    }
    true
}

bounds_field_safe_stmt(s: *Stmt, root: *Obj, member: *Member): bool {
    match s.kind {
        ExprStmt k -> bounds_field_safe_expr(k.lhs, root, member);
        Decl k -> bounds_field_safe_expr(k.init, root, member);
        Return k -> bounds_field_safe_expr(k.lhs, root, member);
        Block k -> bounds_field_safe_stmt_list(k.body, root, member);
        Region k -> bounds_field_safe_stmt(k.body, root, member);
        If k -> {
            if (!bounds_field_safe_expr(k.cond, root, member) || !bounds_field_safe_stmt(k.then,
                root, member)) return false;
            els: ?*Stmt = k.els;
            if (els != null && !bounds_field_safe_stmt(els, root, member)) return false;
            true
        }
        Comment _ -> true;
        _ -> false
    }
}

// An earlier assignment to a local does not make it an unstable loop bound.
// Only writes reachable from the loop body matter. Address-taken locals are
// excluded by the caller, so an ordinary call cannot change this local.
bounds_local_stable_expr(e: ?*Expr, local: *Obj): bool {
    if (e == null) return true;
    n: *Expr = e;
    match n.kind {
        Num _ -> true;
        Null -> true;
        Var _ -> true;
        Binary k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.rhs,
            local);
        Assign k -> bounds_var(k.lhs) != local && bounds_local_stable_expr(k.lhs,
            local) && bounds_local_stable_expr(k.rhs, local);
        Index k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.idx,
            local);
        Funcall k -> {
            if (!bounds_local_stable_expr(k.target, local)) return false;
            a: ?*Expr = k.args;
            while (a != null) {
                if (!bounds_local_stable_expr(a, local)) return false;
                a = a.next
            }
            true
        }
        MemberAccess k -> bounds_local_stable_expr(k.lhs, local);
        Deref k -> bounds_local_stable_expr(k.lhs, local);
        Not k -> bounds_local_stable_expr(k.lhs, local);
        Neg k -> bounds_local_stable_expr(k.lhs, local);
        BitNot k -> bounds_local_stable_expr(k.lhs, local);
        LogAnd k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.rhs,
            local);
        LogOr k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.rhs,
            local);
        OrElse k -> bounds_local_stable_expr(k.lhs, local) && bounds_local_stable_expr(k.rhs,
            local);
        As k -> bounds_local_stable_expr(k.lhs, local);
        Trunc k -> bounds_local_stable_expr(k.lhs, local);
        If k -> bounds_local_stable_expr(k.cond, local) && bounds_local_stable_expr(k.then,
            local) && bounds_local_stable_expr(k.els, local);
        Block k -> bounds_local_stable_stmt_list(k.body, local);
        _ -> false
    }
}

bounds_local_stable_stmt_list(s: ?*Stmt, local: *Obj): bool {
    q: ?*Stmt = s;
    while (q != null) {
        if (!bounds_local_stable_stmt(q, local)) return false;
        q = q.next
    }
    true
}

bounds_local_stable_stmt(s: *Stmt, local: *Obj): bool {
    match s.kind {
        ExprStmt k -> bounds_local_stable_expr(k.lhs, local);
        Decl k -> bounds_local_stable_expr(k.init, local);
        Return k -> bounds_local_stable_expr(k.lhs, local);
        Block k -> bounds_local_stable_stmt_list(k.body, local);
        Region k -> bounds_local_stable_stmt(k.body, local);
        If k -> {
            if (!bounds_local_stable_expr(k.cond, local) || !bounds_local_stable_stmt(k.then,
                local)) return false;
            els: ?*Stmt = k.els;
            if (els != null && !bounds_local_stable_stmt(els, local)) return false;
            true
        }
        While k -> bounds_local_stable_expr(k.cond, local) && bounds_local_stable_stmt(k.body,
            local);
        For k -> k.item != local && bounds_local_stable_expr(k.iter, local) && bounds_local_stable_expr(k.hi,
            local) && bounds_local_stable_stmt(k.body, local);
        Comment _ -> true;
        _ -> false
    }
}

bounds_checked_index(a: *Expr, i: *Expr): bool {
    match i.kind {
        Funcall k -> {
            if (!streq(k.funcname, "check_index") || k.target != null) return false;
            checked_array: ?*Expr = k.args;
            if (checked_array == null) return false;
            bounds_same_array_expr(a, checked_array)
        }
        _ -> false
    }
}

bounds_len_var(e: ?*Expr): ?*Obj {
    if (e == null) return null;
    n: *Expr = e;
    match n.kind {
        Funcall k -> {
            if (!streq(k.funcname, "len")) return null;
            a: ?*Expr = k.args;
            if (a == null) return null;
            if (a.next != null) return null;
            bounds_var(a)
        }
        _ -> null
    }
}

bounds_num(e: ?*Expr): int {
    if (e == null) return -999999999;
    n: *Expr = e;
    match n.kind {
        Num k -> {
            if (k.form == LIT_INT && k.str_label == 0) return k.val;
            -999999999
        }
        _ -> -999999999
    }
}

bounds_offset_var(e: ?*Expr): ?*Obj {
    if (e == null) return null;
    n: *Expr = e;
    match n.kind {
        Binary k -> {
            if (k.op != BinOp.Add) return null;
            if (bounds_num(k.rhs) >= 0) return bounds_var(k.lhs);
            if (bounds_num(k.lhs) >= 0) return bounds_var(k.rhs);
            null
        }
        _ -> null
    }
}

bounds_offset_amount(e: ?*Expr): int {
    if (e == null) return -1;
    n: *Expr = e;
    match n.kind {
        Binary k -> {
            if (k.op != BinOp.Add) return -1;
            c: int = bounds_num(k.rhs);
            if (c < 0) c = bounds_num(k.lhs);
            if (c >= 0 && c < 536870912) return c;
            -1
        }
        _ -> -1
    }
}

bounds_known_len(e: ?*Expr): int {
    if (e == null) return -1;
    n: *Expr = e;
    t: ?*Type = n.ty;
    if (t != null && is_array(t)) return array_len(t);
    match n.kind {
        Num k -> {
            if (k.str_label == 0) return -1;
            lit: ?*StrLit = str_lits;
            while (lit != null) {
                if (lit.label == k.str_label - 1) return lit.len;
                lit = lit.next
            }
            -1
        }
        ArrayLit k -> {
            count: int = 0;
            q: ?*Expr = k.elems;
            while (q != null) {
                count = count + 1;
                q = q.next
            }
            count
        }
        New k -> bounds_num(k.lhs);
        _ -> -1
    }
}

bounds_record_facts(base: *Expr@new, inits: ?*FieldInit@new, f: ?*BoundsFact@new) raises Error: ?*BoundsFact@f {
    q: ?*FieldInit = inits;
    while (q != null) {
        member: ?*Member = q.member;
        value: ?*Expr = q.lhs;
        if (member != null && value != null) {
            path: *Expr = new_member_access(base, member.name, member);
            f = bounds_value_facts(path, value, f)
        }
        q = q.next
    }
    f
}

bounds_record_def(t: ?*Type) raises Error: ?*StructDef {
    if (t == null) return null;
    ty: *Type = t;
    if (is_pointer(ty)) ty = type_base(ty);
    match ty.* {
        Record k -> k.def;
        _ -> null
    }
}

bounds_invariant_member(sd: *StructDef, v: *Obj): ?*Member@sd {
    m: ?*Member = sd.members;
    while (m != null) {
        if (m.invariant_var == v) return m;
        m = m.next
    }
    null
}

// Field names in a type invariant are placeholders for paths through the
// record being checked. Reject globals and expressions outside the small
// difference-constraint language rather than silently dropping a promise.
bounds_invariant_map_with(
    e: *Expr@new,
    sd: *StructDef@new,
    base: *Expr@new,
    changed: ?*Member,
    value: ?*Expr
): ?*Expr@new {
    match e.kind {
        Num k -> new_num(k.val);
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return null;
            m: ?*Member = bounds_invariant_member(sd, v);
            if (m == null) return null;
            if (m == changed && value != null) return value;
            new_member_access(base, m.name, m)
        }
        MemberAccess k -> {
            lhs: ?*Expr = bounds_invariant_map_with(k.lhs, sd, base, changed, value);
            if (lhs == null) return null;
            mapped: *Expr = mk_expr(ExprKind.MemberAccess { lhs: lhs, name: k.name, member: k.member });
            mapped.ty = e.ty;
            mapped
        }
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return null;
            a: ?*Expr = k.args;
            if (a == null) return null;
            if (a.next != null) return null;
            mapped: ?*Expr = bounds_invariant_map_with(a, sd, base, changed, value);
            if (mapped == null) return null;
            bounds_len_term(mapped)
        }
        Binary k -> {
            lhs: ?*Expr = bounds_invariant_map_with(k.lhs, sd, base, changed, value);
            rhs: ?*Expr = bounds_invariant_map_with(k.rhs, sd, base, changed, value);
            if (lhs == null || rhs == null) return null;
            mapped: *Expr = new_binary(k.op, lhs, rhs);
            mapped.ty = e.ty;
            mapped
        }
        LogAnd k -> {
            lhs: ?*Expr = bounds_invariant_map_with(k.lhs, sd, base, changed, value);
            rhs: ?*Expr = bounds_invariant_map_with(k.rhs, sd, base, changed, value);
            if (lhs == null || rhs == null) return null;
            mapped: *Expr = mk_expr(ExprKind.LogAnd { lhs: lhs, rhs: rhs });
            mapped.ty = e.ty;
            mapped
        }
        _ -> null
    }
}

bounds_invariant_map(e: *Expr@new, sd: *StructDef@new, base: *Expr@new): ?*Expr@new {
    bounds_invariant_map_with(e, sd, base, null, null)
}

bounds_record_invariant_facts(sd: *StructDef@new, base: *Expr@new, f: ?*BoundsFact@new): ?*BoundsFact@new {
    inv: ?*Expr = sd.invariant;
    if (inv == null) return f;
    mapped: ?*Expr = bounds_invariant_map(inv, sd, base);
    if (mapped == null) return f;
    bounds_condition(mapped, true, f)
}

bounds_term_numeric_lower(f: ?*BoundsFact, term: *Expr): int {
    n: int = bounds_num(term);
    q: ?*BoundsFact = f;
    while (q != null) {
        left: ?*Expr = q.left;
        right: ?*Expr = q.right;
        if ((q.kind == 9 || q.kind == 10) && left != null && right != null && bounds_same_term(right,
            term) && bounds_separations_available(q.separation, f)) {
            value: int = bounds_num(left);
            if (value >= 0) {
                if (q.kind == 9) value = value + 1;
                if (value > n) n = value
            }
        }
        q = q.next
    }
    n
}

bounds_term_numeric_upper(f: ?*BoundsFact, term: *Expr): int {
    n: int = bounds_num(term);
    q: ?*BoundsFact = f;
    while (q != null) {
        left: ?*Expr = q.left;
        right: ?*Expr = q.right;
        if (q.kind == 4 && q.index == bounds_var(term) && q.value >= 0 && (n < 0 || q.value < n)) n = q.value;
        if (q.kind == 5 && q.index == bounds_var(term) && q.value > 0 && (n < 0 || q.value - 1 < n)) n = q.value - 1;
        if (q.kind == 11 && q.index == bounds_var(term) && right != null && bounds_separations_available(q.separation,
            f)) {
            hi: int = bounds_num(right);
            if (hi > 0 && (n < 0 || hi - 1 < n)) n = hi - 1
        }
        if ((q.kind == 9 || q.kind == 10) && left != null && right != null && bounds_same_term(left,
            term) && bounds_separations_available(q.separation, f)) {
            value: int = bounds_num(right);
            if (value >= 0) {
                if (q.kind == 9) value = value - 1;
                if (n < 0 || value < n) n = value
            }
        }
        q = q.next
    }
    n
}

bounds_record_upper_for_term(whole: *Expr, term: *Expr@new, f: ?*BoundsFact@new) raises Error: bool {
    match whole.kind {
        LogAnd k -> bounds_record_upper_for_term(k.lhs, term, f) || bounds_record_upper_for_term(k.rhs,
            term, f);
        Binary k -> {
            if (k.op != BinOp.Le) return false;
            first: ?*BoundsAffine = bounds_affine(k.lhs, true);
            second: ?*BoundsAffine = bounds_affine(term, true);
            if (first == null || second == null) return false;
            if (first.offset != second.offset || !bounds_same_term(first.base, second.base)) return false;
            constant: int = bounds_num(k.rhs);
            if (constant >= 0 && first.offset >= 0) {
                upper: int = bounds_term_numeric_upper(f, first.base);
                return upper >= 0 && upper <= constant - first.offset
            }
            match k.rhs.kind {
                Funcall call -> {
                    a: ?*Expr = call.args;
                    if (!streq(call.funcname, "len") || a == null) return false;
                    if (!bounds_difference_proves(f, first.base, bounds_len_term(a),
                        0 - first.offset)) return false;
                    bounds_difference_proves(f, new_num(0), first.base, first.offset)
                }
                _ -> false
            }
        }
        _ -> false
    }
}

bounds_record_invariant_proved_with(e: *Expr, whole: *Expr, f: ?*BoundsFact@new) raises Error: bool {
    match e.kind {
        LogAnd k -> bounds_record_invariant_proved_with(k.lhs, whole, f) && bounds_record_invariant_proved_with(k.rhs,
            whole, f);
        Binary k -> {
            if (k.op == BinOp.Le && bounds_num(k.rhs) >= 0) {
                affine_upper: ?*BoundsAffine = bounds_affine(k.lhs, true);
                if (affine_upper != null) {
                    au: *BoundsAffine = affine_upper;
                    upper: int = bounds_term_numeric_upper(f, au.base);
                    if (au.offset >= 0 && upper >= 0 && upper <= bounds_num(k.rhs) - au.offset) return true
                }
            }
            if (k.op == BinOp.Le && bounds_num(k.lhs) == 0 && (bounds_term_numeric_lower(f,
                k.rhs) >= 0 || bounds_difference_proves(f, new_num(0), k.rhs, 0))) return true;
            if (k.op == BinOp.Le && bounds_num(k.lhs) == 0) {
                affine: ?*BoundsAffine = bounds_affine(k.rhs, true);
                if (affine != null) {
                    if (affine.offset >= 0 && bounds_term_numeric_lower(f, affine.base) >= 0 && bounds_record_upper_for_term(whole,
                        k.rhs, f)) return true
                }
            }
            if (k.op == BinOp.Le) {
                match k.rhs.kind {
                    Funcall call -> {
                        a: ?*Expr = call.args;
                        if (streq(call.funcname, "len") && a != null) {
                            if (bounds_count_fits(a, k.lhs, f)) return true;
                            return bounds_record_upper_for_term(whole, k.lhs, f)
                        }
                    }
                    _ -> { }
                }
            }
            bounds_invariant_proved(e, f)
        }
        _ -> false
    }
}

bounds_record_invariant_proved(e: *Expr, f: ?*BoundsFact@new) raises Error: bool {
    bounds_record_invariant_proved_with(e, e, f)
}

bounds_record_write_preproved(
    sd: *StructDef@new,
    base: *Expr@new,
    member: *Member,
    value: *Expr,
    f: ?*BoundsFact@new
) raises Error: bool {
    if (!bounds_pure_condition(value)) return false;
    inv: ?*Expr = sd.invariant;
    if (inv == null) return false;
    mapped: ?*Expr = bounds_invariant_map_with(inv, sd, base, member, value);
    if (mapped == null) return false;
    bounds_record_invariant_proved(mapped, bounds_record_invariant_facts(sd, base,
        f))
}

bounds_verify_record_invariant(
    sd: *StructDef@new,
    base: *Expr@new,
    f: ?*BoundsFact@new,
    file: int,
    pos: int
) raises Error: ?*BoundsFact@new {
    inv: ?*Expr = sd.invariant;
    if (inv == null) return f;
    mapped: ?*Expr = bounds_invariant_map(inv, sd, base);
    if (mapped == null) error_at_file(file, pos, "record invariant requires stable field paths and supported comparisons");
    if (!bounds_infer_mode && !bounds_record_invariant_proved(mapped, f)) error_at_file(file,
        pos, "record invariant is not proved after construction or field assignment");
    bounds_condition(mapped, true, f)
}

bounds_verify_record_constructor(e: *Expr@new, inits: ?*FieldInit@new, f: ?*BoundsFact@new) noregion raises Error {
    sd: ?*StructDef = bounds_record_def(e.ty);
    if (sd == null) return;
    if (sd.invariant == null) return;
    saved_locals: ?*Obj = locals;
    saved_scope: ?*Obj = scope_locals;
    temp: *Obj = new_obj(".record-invariant", true);
    temp.ty = e.ty;
    base: *Expr = bounds_obj_expr(temp);
    facts: ?*BoundsFact = bounds_record_facts(base, inits, f);
    _verified: ?*BoundsFact = bounds_verify_record_invariant(sd, base, facts, e.file,
        e.pos);
    locals = saved_locals;
    scope_locals = saved_scope
}

bounds_direct_constructor(fn: ?*Function): ?*Expr {
    if (fn == null) return null;
    body: ?*Stmt = fn.body;
    if (body == null) return null;
    match body.kind {
        Block block -> {
            only: ?*Stmt = block.body;
            if (only == null) return null;
            if (only.next != null) return null;
            match only.kind {
                ExprStmt item -> {
                    match item.lhs.kind {
                        New _ -> item.lhs;
                        StructLit _ -> item.lhs;
                        _ -> null
                    }
                }
                Return item -> {
                    value: ?*Expr = item.lhs;
                    if (value == null) return null;
                    match value.kind {
                        New _ -> value;
                        StructLit _ -> value;
                        _ -> null
                    }
                }
                _ -> null
            }
        }
        _ -> null
    }
}

// Return facts refer to the callee's exit state. Map parameter paths only
// when their actual paths keep the same value through the call.
bounds_return_map(term: *Expr@new, callee: *Function, args: ?*Expr@new): ?*Expr@new {
    mapped: ?*Expr = bounds_rebind_term(term, callee, args);
    if (mapped == null) return null;
    if (!bounds_effect_preserves_term(callee, mapped)) return null;
    mapped
}

bounds_return_self_offset(value: *Obj, call: *Expr): int {
    match call.kind {
        Funcall k -> {
            callee: ?*Function = k.fn;
            if (callee == null || k.target != null) return 1000000000;
            upper: int = 1000000000;
            lower: int = 1000000000;
            q: ?*BoundsReturnFact = callee.bounds_returns;
            while (q != null) {
                mapped: ?*Expr = bounds_return_map(q.term, callee, k.args);
                if (mapped != null && bounds_var(mapped) == value) {
                    if (q.result_left) upper = q.bound else lower = q.bound
                }
                q = q.next
            }
            if (upper == 1000000000 || lower == 1000000000 || upper != 0 - lower) return 1000000000;
            upper
        }
        _ -> 1000000000
    }
}

// Rewrite difference edges when a cursor is replaced by its old value plus
// a proven constant. This is the compact equivalent of an SSA old-value node.
bounds_return_shift(f: ?*BoundsFact@new, value: *Obj@new, offset: int): ?*BoundsFact@new {
    head: ?*BoundsFact = bounds_kill(f, value);
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.kind == 15 && q.index == value) {
            next_offset: int = q.value + offset;
            if (next_offset >= 0 && next_offset < 536870912) head = bounds_add_value(head,
                value, q.array, 15, next_offset)
        }
        edge: BoundsInequality = bounds_inequality(q);
        left: ?*Expr = edge.left;
        right: ?*Expr = edge.right;
        if (left != null && right != null && edge.separation == null) {
            left_self: bool = bounds_var(left) == value;
            right_self: bool = bounds_var(right) == value;
            if (left_self != right_self) {
                weight: int = if (left_self) edge.bound + offset else edge.bound - offset;
                head = new BoundsFact {
                    index: value,
                    array: bounds_term_root(right),
                    kind: 14,
                    value: weight,
                    left: left,
                    right: right,
                    separation: null,
                    next: head
                }
            }
        }
        q = q.next
    }
    head
}

bounds_return_apply(value: *Obj@new, call: *Expr, f: ?*BoundsFact@new): ?*BoundsFact@f {
    path: *Expr = bounds_obj_expr(value);
    match call.kind {
        Funcall k -> {
            callee: ?*Function = k.fn;
            if (callee == null || k.target != null) return f;
            q: ?*BoundsReturnFact = callee.bounds_returns;
            while (q != null) {
                mapped: ?*Expr = bounds_return_map(q.term, callee, k.args);
                if (mapped != null && bounds_term(mapped) && !bounds_same_term(path,
                    mapped)) {
                    left: *Expr = if (q.result_left) path else mapped;
                    right: *Expr = if (q.result_left) mapped else path;
                    root: ?*Obj = bounds_term_root(left);
                    if (root == null) root = bounds_term_root(right);
                    if (root != null) f = new BoundsFact {
                        index: root,
                        array: bounds_term_root(right),
                        kind: 14,
                        value: q.bound,
                        left: left,
                        right: right,
                        separation: null,
                        next: f
                    };
                    if (q.bound <= 0) f = bounds_add_order(f, left, right, if (q.bound < 0) 9 else 10)
                }
                q = q.next
            }
            f
        }
        _ -> f
    }
}

bounds_value_facts(path: *Expr@new, value: *Expr, f: ?*BoundsFact@new) raises Error: ?*BoundsFact@f {
    local: ?*Obj = bounds_var(path);
    if (local != null) {
        if (local.is_local && is_int_ty(local.ty) && bounds_term(value)) {
            // A copied path keeps its already proved relationships to stable
            // terms even if the source field is subsequently changed.
            original: ?*BoundsFact = f;
            q: ?*BoundsFact = original;
            while (q != null) {
                if ((q.kind == 9 || q.kind == 10) && q.separation == null) {
                    left: ?*Expr = q.left;
                    right: ?*Expr = q.right;
                    if (left != null && right != null) {
                        if (bounds_same_term(left, value) && bounds_term_root(right) != local) f = bounds_add_order(f,
                            path, right, q.kind);
                        if (bounds_same_term(right, value) && bounds_term_root(left) != local) f = bounds_add_order(f,
                            left, path, q.kind)
                    }
                }
                q = q.next
            }
        }
    }
    n: int = bounds_num(value);
    if (local != null && bounds_term(value) && bounds_nonnegative_term(f, value)) f = bounds_add(f,
        local, null, 1);
    if (n >= 0) {
        f = bounds_add_order(f, path, new_num(n), 10);
        f = bounds_add_order(f, new_num(n), path, 10)
    }
    known: int = bounds_known_len(value);
    if (known >= 0) {
        f = bounds_add_order(f, new_num(known), bounds_len_term(path), 10);
        f = bounds_add_order(f, bounds_len_term(path), new_num(known), 10)
    }
    match value.kind {
        Binary k -> {
            if (k.op == BinOp.And || k.op == BinOp.Shr || k.op == BinOp.Shl || k.op == BinOp.Or || k.op == BinOp.Xor || k.op == BinOp.Mod || k.op == BinOp.Div || k.op == BinOp.Add || k.op == BinOp.Sub || k.op == BinOp.Mul) {
                upper: int = bounds_small_upper(value, f);
                if (upper >= 0) {
                    f = bounds_add_order(f, new_num(0), path, 10);
                    f = bounds_add_order(f, path, new_num(upper), 10)
                }
            }
        }
        _ -> { }
    }
    match value.kind {
        New k -> {
            // A completed dynamic allocation has exactly the evaluated count.
            // Only relate it to a still-stable term: the fill expression must
            // not write it, and assigning the result must not replace it.
            destination: ?*Obj = bounds_var(path);
            count: ?*Expr = k.lhs;
            fill: ?*Expr = k.fill;
            if (destination != null && count != null && fill != null) {
                stable_count: bool = bounds_term(count) && bounds_term_root(count) != destination;
                if (!stable_count) {
                    affine_count: ?*BoundsAffine = bounds_affine(count, true);
                    if (affine_count != null) {
                        ac: *BoundsAffine = affine_count;
                        if (bounds_term(ac.base) && bounds_term_root(ac.base) != destination) {
                            if (ac.offset < 0) stable_count = bounds_term_numeric_lower(f,
                                ac.base) >= 0 - ac.offset;
                            if (ac.offset > 0) stable_count = bounds_difference_proves(f,
                                new_num(0), ac.base, 0)
                        }
                    }
                }
                if (destination.is_local && stable_count && bounds_pure_condition(fill)) {
                    f = bounds_add_order(f, count, bounds_len_term(path), 10);
                    f = bounds_add_order(f, bounds_len_term(path), count, 10);
                    if (!bounds_term(count)) {
                        affine2: ?*BoundsAffine = bounds_affine(count, true);
                        if (affine2 != null) {
                            ac2: *BoundsAffine = affine2;
                            base_root: ?*Obj = bounds_term_root(ac2.base);
                            if (base_root != null) {
                                length: *Expr = bounds_len_term(path);
                                if (ac2.offset > 0) f = bounds_add_order(f, new_num(ac2.offset),
                                    length, 10);
                                f = new BoundsFact {
                                    index: base_root,
                                    array: destination,
                                    kind: 14,
                                    value: 0 - ac2.offset,
                                    left: ac2.base,
                                    right: length,
                                    separation: null,
                                    next: f
                                };
                                f = new BoundsFact {
                                    index: destination,
                                    array: base_root,
                                    kind: 14,
                                    value: ac2.offset,
                                    left: length,
                                    right: ac2.base,
                                    separation: null,
                                    next: f
                                }
                            }
                        }
                    }
                }
            }
            bounds_record_facts(path, k.inits, f)
        }
        StructLit k -> bounds_record_facts(path, k.inits, f);
        Funcall k -> {
            result_var: ?*Obj = bounds_var(path);
            if (result_var != null) f = bounds_return_apply(result_var, value, f);
            if (k.target != null) return f;
            made: ?*Expr = bounds_direct_constructor(k.fn);
            if (made == null) return f;
            bounds_value_facts(path, made, f)
        }
        _ -> f
    }
}

bounds_obj_expr(v: *Obj@new): *Expr@new {
    e: *Expr = mk_expr(ExprKind.Var { var: v, name: v.name, member: null });
    e.ty = v.ty;
    e
}

bounds_inequality(q: *BoundsFact@new): BoundsInequality@new {
    left: ?*Expr = q.left;
    right: ?*Expr = q.right;
    bound: int = 0;
    if (q.kind == 9) bound = -1 else if (q.kind == 14) bound = q.value else if (q.kind != 10) {
        left = null;
        right = null;
        if (q.kind == 1) {
            left = new_num(0);
            right = bounds_obj_expr(q.index)
        } else if (q.kind == 2) {
            a: ?*Obj = q.array;
            if (a != null) {
                left = bounds_obj_expr(q.index);
                right = bounds_len_term(bounds_obj_expr(a));
                bound = -1
            }
        } else if (q.kind == 3 && q.value >= 0 && q.value < 536870912) {
            left = new_num(q.value);
            right = bounds_len_term(bounds_obj_expr(q.index))
        } else if (q.kind == 4 && q.value >= 0 && q.value < 536870912) {
            left = bounds_obj_expr(q.index);
            right = new_num(0);
            bound = q.value
        } else if (q.kind == 5 && q.value > 0 && q.value < 536870912) {
            left = bounds_obj_expr(q.index);
            right = new_num(0);
            bound = q.value - 1
        } else if (q.kind == 7) {
            a: ?*Obj = q.array;
            if (a != null) {
                left = bounds_len_term(bounds_obj_expr(a));
                right = bounds_len_term(bounds_obj_expr(q.index))
            }
        } else if (q.kind == 11) {
            left = bounds_obj_expr(q.index);
            right = q.right;
            bound = -1
        }
    }
    BoundsInequality {
        left: left,
        right: right,
        bound: bound,
        separation: q.separation
    }
}

// A term plus a constant. In a guard, only normalize arithmetic that cannot
// wrap for any machine value. A query may normalize an index provisionally:
// proving it lies in [0, len(array)) also proves that its arithmetic did not
// wrap, since that interval is representable by int.
bounds_affine(e: *Expr@new, query: bool): ?*BoundsAffine@new {
    if (bounds_term(e)) return new BoundsAffine { base: e, offset: 0 };
    match e.kind {
        Binary k -> {
            lhs_number: int = bounds_num(k.lhs);
            rhs_number: int = bounds_num(k.rhs);
            if (lhs_number >= 0 && lhs_number < 536870912 && rhs_number >= 0 && rhs_number < 536870912 && (k.op == BinOp.Add || k.op == BinOp.Sub)) {
                folded: int = if (k.op == BinOp.Add) lhs_number + rhs_number else lhs_number - rhs_number;
                if (folded > -536870912 && folded < 536870912) return new BoundsAffine { base: new_num(folded), offset: 0 }
            }
            c: int = bounds_num(k.rhs);
            base: *Expr = k.lhs;
            if (c < 0 && k.op == BinOp.Add) {
                c = bounds_num(k.lhs);
                base = k.rhs
            }
            if (c < 0 || c >= 536870912 || !bounds_term(base)) return null;
            if (k.op != BinOp.Add && k.op != BinOp.Sub) return null;
            if (!query) {
                if (k.op != BinOp.Sub) return null;
                match base.kind {
                    // len is nonnegative, so subtracting a small positive
                    // constant cannot overflow a signed int.
                    Funcall call -> {
                        if (!streq(call.funcname, "len") || call.target != null) return null
                    }
                    _ -> return null
                }
            }
            new BoundsAffine { base: base, offset: if (k.op == BinOp.Add) c else 0 - c }
        }
        _ -> null
    }
}

// A guard may use a positive offset when a known upper bound on its base
// proves that evaluating the machine-integer addition cannot wrap.
bounds_guard_affine(e: *Expr@new, f: ?*BoundsFact): ?*BoundsAffine@new {
    ordinary: ?*BoundsAffine = bounds_affine(e, false);
    if (ordinary != null) return ordinary;
    match e.kind {
        Binary k -> {
            c: int = bounds_num(k.rhs);
            if (k.op != BinOp.Add || c < 0 || c >= 536870912 || !bounds_term(k.lhs)) return null;
            upper: int = bounds_term_numeric_upper(f, k.lhs);
            if (upper < 0 || upper > 536870911 - c) return null;
            new BoundsAffine { base: k.lhs, offset: c }
        }
        _ -> null
    }
}

// Kind 14 is a difference constraint: left - right <= value.
bounds_add_difference(
    f: ?*BoundsFact@new,
    left: *Expr@new,
    right: *Expr@new,
    strict: bool
): ?*BoundsFact@new {
    l: ?*BoundsAffine = bounds_guard_affine(left, f);
    r: ?*BoundsAffine = bounds_guard_affine(right, f);
    if (l == null || r == null) return f;
    if (l.offset == 0 && r.offset == 0) return f;
    root: ?*Obj = bounds_term_root(l.base);
    if (root == null) root = bounds_term_root(r.base);
    if (root == null) return f;
    new BoundsFact {
        index: root,
        array: bounds_term_root(r.base),
        kind: 14,
        value: r.offset - l.offset - (if (strict) 1 else 0),
        left: l.base,
        right: r.base,
        separation: null,
        next: f
    }
}

bounds_add_value(
    f: ?*BoundsFact@new,
    index: *Obj@new,
    array: ?*Obj@new,
    kind: int,
    value: int
): *BoundsFact@new {
    new BoundsFact {
        index: index,
        array: array,
        kind: kind,
        value: value,
        left: null,
        right: null,
        separation: null,
        next: f
    }
}

// Kinds 9 and 10 denote strict and non-strict inequalities respectively.
bounds_add_order(
    f: ?*BoundsFact@new,
    left: *Expr@new,
    right: *Expr@new,
    kind: int
): ?*BoundsFact@new {
    if (!bounds_term(left) || !bounds_term(right)) return f;
    root: ?*Obj = bounds_term_root(left);
    if (root == null) root = bounds_term_root(right);
    if (root == null) return f;
    new BoundsFact {
        index: root,
        array: bounds_term_root(right),
        kind: kind,
        value: 0,
        left: left,
        right: right,
        separation: null,
        next: f
    }
}

bounds_order(
    f: ?*BoundsFact,
    left: *Expr,
    right: *Expr,
    strict: bool
): bool {
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.kind == 9 || q.kind == 10) {
            l: ?*Expr = q.left;
            r: ?*Expr = q.right;
            if (l != null && r != null && bounds_same_term(l, left) && bounds_same_term(r,
                right) && (!strict || q.kind == 9)) return true
        }
        q = q.next
    }
    false
}

bounds_order_to_len(
    f: ?*BoundsFact,
    left: *Expr,
    array: *Expr,
    strict: bool
): bool {
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.kind == 9 || q.kind == 10) {
            l: ?*Expr = q.left;
            r: ?*Expr = q.right;
            numeric_implies: bool = false;
            if (l != null && bounds_num(left) >= 0 && bounds_num(l) >= 0) {
                if (q.kind == 9 && bounds_num(l) >= bounds_num(left)) numeric_implies = true;
                if (q.kind == 10 && bounds_num(l) > bounds_num(left)) numeric_implies = true
            }
            if (l != null && r != null && ((!strict || q.kind == 9) && bounds_same_term(l,
                left) || numeric_implies)) {
                match r.kind {
                    Funcall call -> {
                        a: ?*Expr = call.args;
                        if (streq(call.funcname, "len") && a != null && bounds_same_array_expr(a,
                            array)) {
                            if (bounds_separations_available(q.separation, f)) {
                                bounds_note_separations(q.separation, f);
                                return true
                            }
                        }
                    }
                    _ -> { }
                }
            }
        }
        q = q.next
    }
    false
}

bounds_nonnegative_term(f: ?*BoundsFact, term: *Expr): bool {
    if (bounds_num(term) >= 0) return true;
    v: ?*Obj = bounds_var(term);
    if (v != null && bounds_has(f, v, null, 1)) return true;
    q: ?*BoundsFact = f;
    while (q != null) {
        left: ?*Expr = q.left;
        right: ?*Expr = q.right;
        if (q.kind == 10 && left != null && right != null && bounds_num(left) == 0 && bounds_same_term(right,
            term)) {
            if (bounds_separations_available(q.separation, f)) {
                bounds_note_separations(q.separation, f);
                return true
            }
        }
        q = q.next
    }
    false
}

// Return a nonnegative upper bound for a machine-integer expression. A mask
// bounds either operand without knowing its value; nonnegative remainders are
// below their modulus. Shifts and OR require stable operands and an upper
// bound small enough to rule out overflow.
bounds_small_upper(e: *Expr, f: ?*BoundsFact): int {
    match e.kind {
        Num k -> {
            if (k.str_label == 0 && k.form == LIT_INT && k.val >= 0 && k.val < 536870912) return k.val;
            -1
        }
        Binary k -> {
            if (k.op == BinOp.And) {
                left_mask: int = bounds_num(k.lhs);
                right_mask: int = bounds_num(k.rhs);
                if (left_mask >= 0 && left_mask < 536870912) return left_mask;
                if (right_mask >= 0 && right_mask < 536870912) return right_mask;
                return -1
            }
            if (!bounds_pure_condition(e)) return -1;
            if (k.op == BinOp.Xor) {
                x: int = bounds_small_upper(k.lhs, f);
                y: int = bounds_small_upper(k.rhs, f);
                if (x < 0 || y < 0) return -1;
                largest: int = if (x > y) x else y;
                bit_limit: int = 1;
                while (bit_limit <= largest) bit_limit = bit_limit * 2;
                return bit_limit - 1
            }
            if (k.op == BinOp.Sub) {
                left_upper: int = bounds_small_upper(k.lhs, f);
                right_upper: int = bounds_small_upper(k.rhs, f);
                left_lower: int = bounds_term_numeric_lower(f, k.lhs);
                right_lower: int = bounds_term_numeric_lower(f, k.rhs);
                if (left_upper < 0 || right_upper < 0 || left_lower < right_upper || right_lower < 0) return -1;
                return left_upper - right_lower
            }
            if (k.op == BinOp.Div) {
                divisor: int = bounds_num(k.rhs);
                numerator: int = bounds_small_upper(k.lhs, f);
                if (divisor <= 0 || numerator < 0) return -1;
                return numerator / divisor
            }
            if (k.op == BinOp.Add || k.op == BinOp.Mul) {
                sum_left: int = bounds_small_upper(k.lhs, f);
                sum_right: int = bounds_small_upper(k.rhs, f);
                if (sum_left < 0 || sum_right < 0) return -1;
                if (k.op == BinOp.Add) {
                    if (sum_left > 536870911 - sum_right) return -1;
                    return sum_left + sum_right
                }
                if (sum_right != 0 && sum_left > 536870911 / sum_right) return -1;
                return sum_left * sum_right
            }
            if (k.op == BinOp.Mod) {
                modulus: int = bounds_num(k.rhs);
                if (modulus > 0 && modulus < 536870912 && bounds_nonnegative_term(f,
                    k.lhs)) return modulus - 1;
                return -1
            }
            if (k.op == BinOp.Shr || k.op == BinOp.Shl) {
                shift: int = bounds_num(k.rhs);
                if (shift < 0 || shift > 62) return -1;
                upper: int = bounds_small_upper(k.lhs, f);
                if (upper < 0) return -1;
                if (k.op == BinOp.Shr) return upper >> shift;
                if (upper > 536870911 >> shift) return -1;
                return upper << shift
            }
            if (k.op == BinOp.Or) {
                left: int = bounds_small_upper(k.lhs, f);
                right: int = bounds_small_upper(k.rhs, f);
                if (left < 0 || right < 0 || left > 536870911 - right) return -1;
                return left + right
            }
            -1
        }
        _ -> {
            if (!bounds_term(e) || !bounds_nonnegative_term(f, e)) return -1;
            upper2: int = bounds_term_numeric_upper(f, e);
            if (upper2 >= 0 && upper2 < 536870912) upper2 else -1
        }
    }
}

bounds_graph_node(graph: *BoundsGraph@new, term: *Expr@new): *BoundsGraphNode@new {
    p: ?*BoundsGraphNode = graph.nodes;
    while (p != null) {
        if (bounds_same_term(p.term, term)) return p;
        p = p.next
    }
    node: *BoundsGraphNode = new BoundsGraphNode {
        term: term,
        value: 0,
        known: false,
        next: graph.nodes
    };
    graph.nodes = node;
    node
}

// Graph edges encode x - y <= c as y -> x with weight c. A bounded
// relaxation keeps worst-case compilation predictable; stopping early only
// loses proofs. Paths longer than sixteen edges are deliberately ignored.
bounds_difference_proves_impl(
    f: ?*BoundsFact@new,
    left: *Expr@new,
    right: *Expr@new,
    limit: int,
    best: ?*BoundsBest
): bool {
    if (bounds_same_term(left, right)) {
        if (best != null) best.value = 0;
        return 0 <= limit
    }
    // Every array, slice, and string length is nonnegative. Include this
    // universal edge even when no guard mentions the length on this path.
    if (bounds_num(left) == 0 && (limit >= 0 || best != null)) {
        match right.kind {
            Funcall call -> {
                a: ?*Expr = call.args;
                if (a != null) {
                    if (streq(call.funcname, "len") && call.target == null && a.next == null) {
                        if (best == null) return true;
                        if (best.value > 0) best.value = 0
                    }
                }
            }
            _ -> { }
        }
    }
    zero: *Expr = new_num(0);
    graph: *BoundsGraph = new BoundsGraph { nodes: null, edges: null, last: null };
    source: *BoundsGraphNode = bounds_graph_node(graph, right);
    source.known = true;
    target: *BoundsGraphNode = bounds_graph_node(graph, left);
    match right.kind {
        Funcall call -> {
            a: ?*Expr = call.args;
            if (a != null) {
                if (a.next == null && call.target == null && streq(call.funcname,
                    "len")) {
                    length_zero: *BoundsGraphNode = bounds_graph_node(graph, zero);
                    length_zero.known = true
                }
            }
        }
        _ -> { }
    }
    q: ?*BoundsFact = f;
    while (q != null) {
        edge: BoundsInequality = bounds_inequality(q);
        l: ?*Expr = edge.left;
        r: ?*Expr = edge.right;
        weight: int = edge.bound;
        // All numeric literals share one zero node. This lets a known
        // length of six combine with an upper bound on a cursor of zero.
        if (l != null) {
            match l.kind {
                Num number -> {
                    if (number.form == LIT_INT && number.val >= 0 && number.val < 536870912) {
                        weight = weight - number.val;
                        l = zero
                    }
                }
                _ -> { }
            }
        }
        if (r != null) {
            match r.kind {
                Num number -> {
                    if (number.form == LIT_INT && number.val >= 0 && number.val < 536870912) {
                        weight = weight + number.val;
                        r = zero
                    }
                }
                _ -> { }
            }
        }
        // Propagating separation obligations through a graph path needs
        // provenance. Leave those facts to the existing direct prover.
        if (l != null && r != null && q.separation == null) {
            from: *BoundsGraphNode = bounds_graph_node(graph, r);
            to: *BoundsGraphNode = bounds_graph_node(graph, l);
            edge: *BoundsGraphEdge = new BoundsGraphEdge {
                from: from,
                to: to,
                weight: weight,
                next: null
            };
            last: ?*BoundsGraphEdge = graph.last;
            if (last == null) graph.edges = edge else last.next = edge;
            graph.last = edge
        }
        q = q.next
    }
    round: int = 0;
    while (round < 16) {
        changed: bool = false;
        e: ?*BoundsGraphEdge = graph.edges;
        while (e != null) {
            if (e.from.known) {
                value: int = e.from.value + e.weight;
                if (!e.to.known || value < e.to.value) {
                    e.to.value = value;
                    e.to.known = true;
                    changed = true;
                    if (e.to == target) {
                        if (best != null) {
                            if (value < best.value) best.value = value
                        }
                        if (best == null && value <= limit) return true
                    }
                }
            }
            e = e.next
        }
        if (!changed) return false;
        round = round + 1
    }
    false
}

bounds_difference_proves(
    f: ?*BoundsFact@new,
    left: *Expr,
    right: *Expr,
    limit: int
): bool {
    answer: bool = false;
    region {
        query_left: *Expr = left;
        query_right: *Expr = right;
        bound: int = limit;
        left_number: int = bounds_num(left);
        if (left_number > -536870912 && left_number < 536870912) {
            query_left = new_num(0);
            bound = bound - left_number
        }
        right_number: int = bounds_num(right);
        if (right_number > -536870912 && right_number < 536870912) {
            query_right = new_num(0);
            bound = bound + right_number
        }
        answer = bounds_difference_proves_impl(f, query_left, query_right, bound,
            null)
    }
    answer
}

// Read the tightest bound found by one graph search. As in ordinary queries,
// the fixed relaxation limit may miss a proof but never invents one.
bounds_return_bound(f: ?*BoundsFact@new, left: *Expr, right: *Expr): int {
    answer: int = 1000000000;
    region {
        query_left: *Expr = left;
        query_right: *Expr = right;
        shift: int = 0;
        left_number: int = bounds_num(left);
        if (left_number > -536870912 && left_number < 536870912) {
            query_left = new_num(0);
            shift = shift + left_number
        }
        right_number: int = bounds_num(right);
        if (right_number > -536870912 && right_number < 536870912) {
            query_right = new_num(0);
            shift = shift - right_number
        }
        best: *BoundsBest = new BoundsBest { value: 1000000000 };
        _proved: bool = bounds_difference_proves_impl(f, query_left, query_right,
            64, best);
        if (best.value < 1000000000) {
            value: int = best.value + shift;
            if (value <= 64) answer = (if (value < -64) -64 else value)
        }
    }
    answer
}

bounds_return_add_candidate(
    head: ?*BoundsReturnFact@new,
    fn: *Function,
    value: *BoundsAffine,
    candidate: *Expr@new,
    f: ?*BoundsFact@new
): ?*BoundsReturnFact@head {
    root: ?*Obj = bounds_term_root(candidate);
    if (root != null) {
        if (!bounds_param(fn, root) || root.bounds_written) return head
    }
    if (root == null && bounds_num(candidate) != 0) return head;
    if (!bounds_term(candidate)) return head;
    match candidate.kind {
        Num _ -> { }
        Funcall _ -> { }
        _ -> {
            if (!is_int_ty(candidate.ty)) return head
        }
    }
    q: ?*BoundsReturnFact = head;
    while (q != null) {
        if (bounds_same_term(q.term, candidate)) return head;
        q = q.next
    }
    upper: int = bounds_return_bound(f, value.base, candidate);
    lower: int = bounds_return_bound(f, candidate, value.base);
    if (upper != 1000000000) head = new BoundsReturnFact {
        term: candidate,
        result_left: true,
        bound: upper + value.offset,
        next: head
    };
    if (lower != 1000000000) head = new BoundsReturnFact {
        term: candidate,
        result_left: false,
        bound: lower - value.offset,
        next: head
    };
    head
}

bounds_return_no_wrap(value: *BoundsAffine, f: ?*BoundsFact@new, fn: *Function@new): bool {
    if (value.offset == 0) return true;
    if (value.offset < 0) return bounds_difference_proves(f, new_num(0), value.base,
        value.offset);
    p: ?*Obj = fn.params;
    while (p != null) {
        ty: ?*Type = p.ty;
        if (ty != null && (is_array(ty) || is_slice(ty))) {
            if (bounds_difference_proves(f, value.base, bounds_len_term(bounds_obj_expr(p)),
                0 - value.offset)) return true
        }
        p = p.param_next
    }
    false
}

// A check_index known to be invalid always traps, so its return statement is
// not a successful exit of the surrounding function.
bounds_return_traps(value: ?*Expr, f: ?*BoundsFact@new): bool {
    if (value == null) return false;
    match value.kind {
        Funcall k -> {
            if (!streq(k.funcname, "check_index") || k.target != null) return false;
            array: ?*Expr = k.args;
            if (array == null) return false;
            if (!bounds_pure_condition(array)) return false;
            index: ?*Expr = array.next;
            if (index == null) return false;
            affine: ?*BoundsAffine = bounds_affine(index, true);
            if (affine == null) return false;
            if (affine.offset == 0) return bounds_difference_proves(f, affine.base,
                new_num(0), -1) || bounds_difference_proves(f, bounds_len_term(array),
                affine.base, 0);
            if (affine.offset > 0 && bounds_difference_proves(f, new_num(0), affine.base,
                0)) return bounds_difference_proves(f, bounds_len_term(array), affine.base,
                affine.offset);
            false
        }
        _ -> false
    }
}

bounds_return_visit(value_expr: ?*Expr@new, f: ?*BoundsFact@new) noregion {
    fn: ?*Function = bounds_current_fn;
    if (fn == null || !bounds_infer_mode) return;
    if (!is_int_ty(fn.return_ty)) return;
    current: ?*BoundsReturnFact = null;
    if (value_expr != null) {
        value: ?*BoundsAffine = bounds_affine(value_expr, true);
        if (value != null && bounds_return_no_wrap(value, f, fn)) {
            current = bounds_return_add_candidate(current, fn, value, new_num(0),
                f);
            p: ?*Obj = fn.params;
            while (p != null) {
                current = bounds_return_add_candidate(current, fn, value, bounds_obj_expr(p),
                    f);
                ty: ?*Type = p.ty;
                if (ty != null && is_indexable(ty)) current = bounds_return_add_candidate(current,
                    fn, value, bounds_len_term(bounds_obj_expr(p)), f);
                p = p.param_next
            }
            // Use every caller-visible path in the exit state as a candidate.
            // Local facts may help prove a relationship, but cannot themselves
            // appear in the summary.
            q: ?*BoundsFact = f;
            while (q != null) {
                left: ?*Expr = q.left;
                right: ?*Expr = q.right;
                if (left != null) current = bounds_return_add_candidate(current, fn,
                    value, left, f);
                if (right != null) current = bounds_return_add_candidate(current,
                    fn, value, right, f);
                q = q.next
            }
            cursor: ?*Obj = bounds_var(value.base);
            if (cursor != null) {
                origin: ?*BoundsFact = bounds_cursor_origin(f, cursor);
                if (origin != null) {
                    source: ?*Obj = origin.array;
                    if (source != null && bounds_param(fn, source)) {
                        total: int = origin.value + value.offset;
                        if (total >= 0 && total < 536870912) {
                            entry: *Expr = bounds_obj_expr(source);
                            current = new BoundsReturnFact {
                                term: entry,
                                result_left: true,
                                bound: total,
                                next: current
                            };
                            current = new BoundsReturnFact {
                                term: entry,
                                result_left: false,
                                bound: 0 - total,
                                next: current
                            }
                        }
                    }
                }
            }
        } else {
            // Forward an exact cursor result from a tail call. The callee's
            // return fact and this function's cursor origin compose without
            // an extra source-level assignment.
            qtail: ?*BoundsFact = f;
            while (qtail != null) {
                source: ?*Obj = qtail.array;
                if (qtail.kind == 15 && source != null && bounds_param(fn, source)) {
                    delta: int = bounds_return_self_offset(qtail.index, value_expr);
                    total: int = qtail.value + delta;
                    if (delta != 1000000000 && total >= 0 && total < 536870912) {
                        entry: *Expr = bounds_obj_expr(source);
                        current = new BoundsReturnFact {
                            term: entry,
                            result_left: true,
                            bound: total,
                            next: current
                        };
                        current = new BoundsReturnFact {
                            term: entry,
                            result_left: false,
                            bound: 0 - total,
                            next: current
                        }
                    }
                }
                qtail = qtail.next
            }
        }
    }
    if (!bounds_return_seen) {
        bounds_return_accum = current;
        bounds_return_seen = true;
        return
    }
    joined: ?*BoundsReturnFact = null;
    old: ?*BoundsReturnFact = bounds_return_accum;
    while (old != null) {
        other: ?*BoundsReturnFact = current;
        matched: bool = false;
        while (other != null && !matched) {
            if (old.result_left == other.result_left && bounds_same_term(old.term,
                other.term)) {
                joined = new BoundsReturnFact {
                    term: old.term,
                    result_left: old.result_left,
                    bound: if (old.bound > other.bound) old.bound else other.bound,
                    next: joined
                };
                matched = true
            }
            other = other.next
        }
        old = old.next
    }
    bounds_return_accum = joined
}

bounds_return_same(a: ?*BoundsReturnFact, b: ?*BoundsReturnFact): bool {
    p: ?*BoundsReturnFact = a;
    while (p != null) {
        found: bool = false;
        q: ?*BoundsReturnFact = b;
        while (q != null) {
            if (p.result_left == q.result_left && p.bound == q.bound && bounds_same_term(p.term,
                q.term)) found = true;
            q = q.next
        }
        if (!found) return false;
        p = p.next
    }
    q2: ?*BoundsReturnFact = b;
    while (q2 != null) {
        found2: bool = false;
        p2: ?*BoundsReturnFact = a;
        while (p2 != null) {
            if (q2.result_left == p2.result_left && q2.bound == p2.bound && bounds_same_term(q2.term,
                p2.term)) found2 = true;
            p2 = p2.next
        }
        if (!found2) return false;
        q2 = q2.next
    }
    true
}

bounds_difference_index(f: ?*BoundsFact@new, array: *Expr@new, index: *Expr@new): bool {
    affine: ?*BoundsAffine = bounds_affine(index, true);
    if (affine == null) return false;
    // Both mathematical inequalities imply that the computed machine index
    // is representable, so provisional normalization above is justified.
    if (!bounds_difference_proves(f, affine.base, bounds_len_term(array), 0 - affine.offset - 1)) return false;
    bounds_difference_proves(f, new_num(0), affine.base, affine.offset)
}

// The range-loop variable is strictly below its stable upper-bound path.
bounds_add_loop_order(f: ?*BoundsFact@new, index: *Obj@new, hi: *Expr@new): ?*BoundsFact@new {
    if (!bounds_term(hi)) return f;
    new BoundsFact {
        index: index,
        array: bounds_term_root(hi),
        kind: 11,
        value: 0,
        left: null,
        right: hi,
        separation: null,
        next: f
    }
}

bounds_add(
    f: ?*BoundsFact@new,
    index: *Obj@new,
    array: ?*Obj@new,
    kind: int
): *BoundsFact@new {
    bounds_add_value(f, index, array, kind, 0)
}

bounds_has(
    f: ?*BoundsFact,
    index: *Obj,
    array: ?*Obj,
    kind: int
): bool {
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.index == index && q.array == array && q.kind == kind) return true;
        q = q.next
    }
    false
}

bounds_fact_value(f: ?*BoundsFact, index: *Obj, kind: int): int {
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.index == index && q.kind == kind) return q.value;
        q = q.next
    }
    -1
}

bounds_has_value(
    f: ?*BoundsFact,
    index: *Obj,
    array: ?*Obj,
    kind: int,
    value: int
): bool {
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.index == index && q.array == array && q.kind == kind && q.value == value) return true;
        q = q.next
    }
    false
}

bounds_has_fact(f: ?*BoundsFact, fact: *BoundsFact): bool {
    if (fact.kind == 1) {
        if (bounds_has_value(f, fact.index, null, 1, 0)) return true;
        q0: ?*BoundsFact = f;
        while (q0 != null) {
            left0: ?*Expr = q0.left;
            right0: ?*Expr = q0.right;
            if (q0.kind == 14 && q0.value <= 0 && q0.separation == null && left0 != null && right0 != null && bounds_num(left0) == 0 && bounds_var(right0) == fact.index) return true;
            q0 = q0.next
        }
        return false
    }
    if (fact.kind == 14) {
        l: ?*Expr = fact.left;
        r: ?*Expr = fact.right;
        if (l == null || r == null) return false;
        q: ?*BoundsFact = f;
        while (q != null) {
            left: ?*Expr = q.left;
            right: ?*Expr = q.right;
            if (q.kind == 14 && q.value <= fact.value && left != null && right != null && bounds_same_term(l,
                left) && bounds_same_term(r, right) && bounds_separation_same(q.separation,
                fact.separation)) return true;
            q = q.next
        }
        return false
    }
    if (fact.kind == 11) {
        q: ?*BoundsFact = f;
        while (q != null) {
            r: ?*Expr = q.right;
            fr: ?*Expr = fact.right;
            if (q.kind == 11 && q.index == fact.index && r != null && fr != null && bounds_same_term(r,
                fr) && bounds_separation_same(q.separation, fact.separation)) return true;
            q = q.next
        }
        return false
    }
    if (fact.kind == 9 || fact.kind == 10) {
        l: ?*Expr = fact.left;
        r: ?*Expr = fact.right;
        if (l == null || r == null) return false;
        q: ?*BoundsFact = f;
        while (q != null) {
            left: ?*Expr = q.left;
            right: ?*Expr = q.right;
            if ((q.kind == 9 || fact.kind == 10 && q.kind == 10) && left != null && right != null && bounds_same_term(l,
                left) && bounds_same_term(r, right) && bounds_separation_same(q.separation,
                fact.separation)) return true;
            q = q.next
        }
        return false
    }
    bounds_has_value(f, fact.index, fact.array, fact.kind, fact.value)
}

bounds_copy(f: ?*BoundsFact@new, q: *BoundsFact@new): *BoundsFact@new {
    new BoundsFact {
        index: q.index,
        array: q.array,
        kind: q.kind,
        value: q.value,
        left: q.left,
        right: q.right,
        separation: q.separation,
        next: f
    }
}

bounds_copy_separation(f: ?*BoundsFact@new, q: *BoundsFact@new, sep: ?*BoundsSeparation@new): *BoundsFact@new {
    new BoundsFact {
        index: q.index,
        array: q.array,
        kind: q.kind,
        value: q.value,
        left: q.left,
        right: q.right,
        separation: sep,
        next: f
    }
}

bounds_kill(f: ?*BoundsFact@new, v: *Obj): ?*BoundsFact@new {
    // Assigning a value absent from the state leaves the immutable list intact.
    // This is common for short-lived locals and avoids copying every fact.
    scan: ?*BoundsFact = f;
    found: bool = false;
    while (scan != null && !found) {
        if (scan.index == v || scan.array == v) found = true;
        scan = scan.next
    }
    if (!found) return f;
    head: ?*BoundsFact = null;
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.index != v && q.array != v) head = bounds_copy(head, q);
        q = q.next
    }
    head
}

// Without a proven separation, another path with the same member may alias.
// Keep facts about other members, including those of the same record.
bounds_kill_member(f: ?*BoundsFact@new, member: *Member): ?*BoundsFact@new {
    head: ?*BoundsFact = null;
    q: ?*BoundsFact = f;
    while (q != null) {
        affected: bool = q.kind == 8 && q.value == member.browse_id;
        left: ?*Expr = q.left;
        right: ?*Expr = q.right;
        if (left != null && bounds_term_has_member(left, member)) affected = true;
        if (right != null && bounds_term_has_member(right, member)) affected = true;
        if (!affected) head = bounds_copy(head, q);
        q = q.next
    }
    head
}

bounds_kill_record_fields(f: ?*BoundsFact@new): ?*BoundsFact@new {
    head: ?*BoundsFact = null;
    q: ?*BoundsFact = f;
    while (q != null) {
        affected: bool = q.kind == 8;
        left: ?*Expr = q.left;
        right: ?*Expr = q.right;
        if (left != null && bounds_term_has_any_member(left)) affected = true;
        if (right != null && bounds_term_has_any_member(right)) affected = true;
        if (!affected) head = bounds_copy(head, q);
        q = q.next
    }
    head
}

bounds_flat_record(sd: *StructDef): bool {
    m: ?*Member = sd.members;
    while (m != null) {
        if (!is_int_width_ty(m.ty) && !is_float_ty(m.ty) && !is_bool_ty(m.ty)) return false;
        m = m.next
    }
    true
}

bounds_member_of_record(sd: *StructDef, id: int): bool {
    m: ?*Member = sd.members;
    while (m != null) {
        if (m.browse_id == id) return true;
        m = m.next
    }
    false
}

bounds_term_has_record_member(e: *Expr, sd: *StructDef) raises Error: bool {
    match e.kind {
        MemberAccess k -> {
            owner: ?*StructDef = bounds_record_def(k.lhs.ty);
            if (owner == sd) return true;
            bounds_term_has_record_member(k.lhs, sd)
        }
        Deref k -> bounds_term_has_record_member(k.lhs, sd);
        Funcall k -> {
            a: ?*Expr = k.args;
            a != null && bounds_term_has_record_member(a, sd)
        }
        _ -> false
    }
}

// A write to one flat record element can change fields of that record type,
// but it cannot change the containing array's length or sibling record fields.
bounds_kill_flat_record_fields(f: ?*BoundsFact@new, sd: *StructDef) raises Error: ?*BoundsFact@new {
    head: ?*BoundsFact = null;
    q: ?*BoundsFact = f;
    while (q != null) {
        affected: bool = q.kind == 8 && bounds_member_of_record(sd, q.value);
        left: ?*Expr = q.left;
        right: ?*Expr = q.right;
        if (left != null && bounds_term_has_record_member(left, sd)) affected = true;
        if (right != null && bounds_term_has_record_member(right, sd)) affected = true;
        if (!affected) head = bounds_copy(head, q);
        q = q.next
    }
    head
}

bounds_after_call(f: ?*BoundsFact@new, callee: ?*Function, args: ?*Expr): ?*BoundsFact@new {
    head: ?*BoundsFact = null;
    q: ?*BoundsFact = f;
    while (q != null) {
        a: ?*Obj = q.array;
        stable: bool = q.index.is_local && !q.index.bounds_addr_taken;
        if (a != null) {
            if (!a.is_local || a.bounds_addr_taken) stable = false
        }
        if (q.kind == 9 || q.kind == 10 || q.kind == 14) {
            stable = false;
            if (callee != null) {
                if (!callee.bounds_unknown_write) {
                    left: ?*Expr = q.left;
                    right: ?*Expr = q.right;
                    if (left != null && right != null) {
                        stable = bounds_term_roots_stable(left) && bounds_term_roots_stable(right);
                        sep: ?*BoundsSeparation = q.separation;
                        root: int = bounds_simple_relation_root(q);
                        w: ?*BoundsWrite = callee.bounds_writes;
                        while (w != null && stable) {
                            if (bounds_term_has_member(left, w.member) || bounds_term_has_member(right,
                                w.member)) {
                                formal: ?*Obj = w.root_param;
                                if (root < 0 || formal == null) stable = false else {
                                    actual: ?*Expr = bounds_arg_named(callee, args,
                                        formal.name);
                                    other: ?*Obj = bounds_var(actual);
                                    current: ?*Function = bounds_current_fn;
                                    if (other == null || current == null) stable = false else if (other.browse_id == root || !bounds_param(current,
                                        other)) stable = false else sep = bounds_separation_extend(sep,
                                        root, other.browse_id)
                                }
                            }
                            w = w.next
                        }
                        if (stable) head = bounds_copy_separation(head, q, sep)
                    }
                }
            }
        } else {
            if (q.kind == 11) {
                stable = false;
                if (callee != null) {
                    right: ?*Expr = q.right;
                    if (right != null) stable = bounds_effect_preserves_term(callee,
                        right)
                }
            }
            if (q.kind == 8) {
                if (callee == null) stable = false else if (callee.bounds_unknown_write) stable = false else {
                    w: ?*BoundsWrite = callee.bounds_writes;
                    while (w != null) {
                        if (w.member.browse_id == q.value) stable = false;
                        w = w.next
                    }
                }
            }
            if (stable) head = bounds_copy(head, q)
        }
        q = q.next
    }
    head
}

bounds_meet(a: ?*BoundsFact@new, b: ?*BoundsFact): ?*BoundsFact@new {
    if (a == b) return a;
    head: ?*BoundsFact = null;
    q: ?*BoundsFact = a;
    while (q != null) {
        if (bounds_has_fact(b, q)) head = bounds_copy(head, q);
        q = q.next
    }
    // Distinct branch maxima, including constant assignments, imply their
    // larger common upper bound.
    q = a;
    while (q != null) {
        if (q.kind == 9 || q.kind == 10 || q.kind == 4) {
            left: ?*Expr = if (q.kind == 4) bounds_obj_expr(q.index) else q.left;
            right: ?*Expr = if (q.kind == 4) new_num(q.value) else q.right;
            if (left != null && right != null && bounds_num(right) >= 0) {
                v: ?*Obj = bounds_var(left);
                if (v != null) {
                    if (v.is_local && is_int_ty(v.ty) && bounds_nonnegative_term(a,
                        left) && bounds_nonnegative_term(b, left)) {
                        first: int = bounds_term_numeric_upper(a, left);
                        second: int = bounds_term_numeric_upper(b, left);
                        if (first >= 0 && second >= 0) {
                            bound: int = if (first > second) first else second;
                            if (bound < 536870912 && !bounds_order(head, left, new_num(bound),
                                false)) head = bounds_add_order(head, left, new_num(bound),
                                10)
                        }
                    }
                }
            }
        }
        q = q.next
    }
    head
}

bounds_same(a: ?*BoundsFact, b: ?*BoundsFact): bool {
    if (a == b) return true;
    q: ?*BoundsFact = a;
    while (q != null) {
        if (!bounds_has_fact(b, q)) return false;
        q = q.next
    }
    q2: ?*BoundsFact = b;
    while (q2 != null) {
        if (!bounds_has_fact(a, q2)) return false;
        q2 = q2.next
    }
    true
}

bounds_inc_preserves_nonnegative(v: *Obj@new, rhs: *Expr, f: ?*BoundsFact@new): bool {
    if (!bounds_has(f, v, null, 1)) return false;
    match rhs.kind {
        Binary k -> {
            if (k.op != BinOp.Add || bounds_var(k.lhs) != v || bounds_num(k.rhs) != 1) return false;
            q: ?*BoundsFact = f;
            while (q != null) {
                if (q.index == v && q.kind == 2) return true;
                if (q.index == v && q.kind == 5 && q.value < 9223372036854775807) return true;
                q = q.next
            }
            bounds_difference_proves(f, bounds_obj_expr(v), new_num(536870911), 0)
        }
        _ -> false
    }
}

bounds_pure_condition(e: *Expr): bool {
    match e.kind {
        Num _ -> true;
        Var _ -> true;
        MemberAccess k -> bounds_pure_condition(k.lhs);
        Deref k -> bounds_pure_condition(k.lhs);
        Index k -> bounds_pure_condition(k.lhs) && bounds_pure_condition(k.idx);
        Binary k -> bounds_pure_condition(k.lhs) && bounds_pure_condition(k.rhs);
        Not k -> bounds_pure_condition(k.lhs);
        LogAnd k -> bounds_pure_condition(k.lhs) && bounds_pure_condition(k.rhs);
        LogOr k -> bounds_pure_condition(k.lhs) && bounds_pure_condition(k.rhs);
        Funcall k -> {
            if (streq(k.funcname, "check_index") && k.target == null) {
                a: ?*Expr = k.args;
                if (a == null) return false;
                index: ?*Expr = a.next;
                if (index == null) return false;
                if (index.next != null) return false;
                return bounds_pure_condition(a) && bounds_pure_condition(index)
            }
            if (!streq(k.funcname, "len")) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            if (a.next != null) return false;
            bounds_term(a)
        }
        _ -> false
    }
}

bounds_condition(e: *Expr, yes: bool, f: ?*BoundsFact@new): ?*BoundsFact@new {
    if (!bounds_pure_condition(e)) return f;
    match e.kind {
        Not k -> bounds_condition(k.lhs, !yes, f);
        LogAnd k -> {
            if (!yes) return f;
            bounds_condition(k.rhs, true, bounds_condition(k.lhs, true, f))
        }
        LogOr k -> {
            if (yes) return f;
            bounds_condition(k.rhs, false, bounds_condition(k.lhs, false, f))
        }
        Binary k -> {
            if (yes && k.op == BinOp.Ne || !yes && k.op == BinOp.Eq) {
                lhs: ?*Obj = bounds_var(k.lhs);
                rhs: ?*Obj = bounds_var(k.rhs);
                if (lhs != null && rhs != null && lhs != rhs) f = bounds_add(f, lhs,
                    rhs, 12)
            }
            if (yes && k.op == BinOp.Lt || !yes && k.op == BinOp.Ge) {
                f = bounds_add_order(f, k.lhs, k.rhs, 9);
                f = bounds_add_difference(f, k.lhs, k.rhs, true)
            }
            if (yes && k.op == BinOp.Le || !yes && k.op == BinOp.Gt) {
                f = bounds_add_order(f, k.lhs, k.rhs, 10);
                f = bounds_add_difference(f, k.lhs, k.rhs, false)
            }
            if (yes && k.op == BinOp.Gt || !yes && k.op == BinOp.Le) {
                f = bounds_add_order(f, k.rhs, k.lhs, 9);
                f = bounds_add_difference(f, k.rhs, k.lhs, true)
            }
            if (yes && k.op == BinOp.Ge || !yes && k.op == BinOp.Lt) {
                f = bounds_add_order(f, k.rhs, k.lhs, 10);
                f = bounds_add_difference(f, k.rhs, k.lhs, false)
            }
            if (yes && k.op == BinOp.Eq || !yes && k.op == BinOp.Ne) {
                f = bounds_add_order(f, k.lhs, k.rhs, 10);
                f = bounds_add_order(f, k.rhs, k.lhs, 10);
                f = bounds_add_difference(f, k.lhs, k.rhs, false);
                f = bounds_add_difference(f, k.rhs, k.lhs, false)
            }
            left_len: ?*Obj = bounds_len_var(k.lhs);
            right_len: ?*Obj = bounds_len_var(k.rhs);
            if (left_len != null && right_len != null) {
                if (yes && k.op == BinOp.Eq || !yes && k.op == BinOp.Ne) {
                    f = bounds_add(f, left_len, right_len, 7);
                    return bounds_add(f, right_len, left_len, 7)
                }
                if (yes && (k.op == BinOp.Ge || k.op == BinOp.Gt) || !yes && (k.op == BinOp.Lt || k.op == BinOp.Le)) return bounds_add(f,
                    left_len, right_len, 7);
                if (yes && (k.op == BinOp.Le || k.op == BinOp.Lt) || !yes && (k.op == BinOp.Gt || k.op == BinOp.Ge)) return bounds_add(f,
                    right_len, left_len, 7)
            }
            offset_index: ?*Obj = bounds_offset_var(k.lhs);
            offset_array: ?*Obj = bounds_len_var(k.rhs);
            offset: int = bounds_offset_amount(k.lhs);
            if (offset_index != null && offset_array != null && offset >= 0 && bounds_has(f,
                offset_index, null, 1) && bounds_has(f, offset_index, offset_array,
                2) && (yes && k.op == BinOp.Lt || !yes && k.op == BinOp.Ge)) return bounds_add_value(f,
                offset_index, offset_array, 6, offset);
            offset_index = bounds_offset_var(k.rhs);
            offset_array = bounds_len_var(k.lhs);
            offset = bounds_offset_amount(k.rhs);
            if (offset_index != null && offset_array != null && offset >= 0 && bounds_has(f,
                offset_index, null, 1) && bounds_has(f, offset_index, offset_array,
                2) && (yes && k.op == BinOp.Gt || !yes && k.op == BinOp.Le)) return bounds_add_value(f,
                offset_index, offset_array, 6, offset);
            array0: ?*Obj = bounds_len_var(k.lhs);
            constant0: int = bounds_num(k.rhs);
            if (array0 != null && constant0 >= 0 && constant0 < 536870912) {
                minimum: int = -1;
                if (yes && k.op == BinOp.Ge || !yes && k.op == BinOp.Lt) minimum = constant0;
                if (yes && k.op == BinOp.Gt || !yes && k.op == BinOp.Le) minimum = constant0 + 1;
                if (yes && k.op == BinOp.Eq || !yes && k.op == BinOp.Ne) minimum = constant0;
                if (constant0 == 0 && (yes && k.op == BinOp.Ne || !yes && k.op == BinOp.Eq)) minimum = 1;
                if (minimum >= 0) return bounds_add_value(f, array0, null, 3, minimum)
            }
            array0 = bounds_len_var(k.rhs);
            constant0 = bounds_num(k.lhs);
            if (array0 != null && constant0 >= 0 && constant0 < 536870912) {
                minimum2: int = -1;
                if (yes && k.op == BinOp.Le || !yes && k.op == BinOp.Gt) minimum2 = constant0;
                if (yes && k.op == BinOp.Lt || !yes && k.op == BinOp.Ge) minimum2 = constant0 + 1;
                if (yes && k.op == BinOp.Eq || !yes && k.op == BinOp.Ne) minimum2 = constant0;
                if (constant0 == 0 && (yes && k.op == BinOp.Ne || !yes && k.op == BinOp.Eq)) minimum2 = 1;
                if (minimum2 >= 0) return bounds_add_value(f, array0, null, 3, minimum2)
            }
            i: ?*Obj = bounds_var(k.lhs);
            a: ?*Obj = bounds_len_var(k.rhs);
            if (i != null && a != null && (yes && k.op == BinOp.Lt || !yes && k.op == BinOp.Ge)) return bounds_add(f,
                i, a, 2);
            i = bounds_var(k.rhs);
            a = bounds_len_var(k.lhs);
            if (i != null && a != null && (yes && k.op == BinOp.Gt || !yes && k.op == BinOp.Le)) return bounds_add(f,
                i, a, 2);
            i = bounds_var(k.lhs);
            if (i != null && bounds_num(k.rhs) == 0 && (yes && k.op == BinOp.Ge || !yes && k.op == BinOp.Lt)) return bounds_add(f,
                i, null, 1);
            i = bounds_var(k.rhs);
            if (i != null && bounds_num(k.lhs) == 0 && (yes && k.op == BinOp.Le || !yes && k.op == BinOp.Gt)) return bounds_add(f,
                i, null, 1);
            f
        }
        _ -> f
    }
}

bounds_invariant_proved(e: *Expr, f: ?*BoundsFact@new) raises Error: bool {
    if (!bounds_pure_condition(e)) return false;
    match e.kind {
        LogAnd k -> bounds_invariant_proved(k.lhs, f) && bounds_invariant_proved(k.rhs,
            f);
        Binary _ -> {
            if (bounds_precondition_proved(e, f)) return true;
            need: ?*BoundsFact = bounds_condition(e, true, null);
            if (need == null) return false;
            q: ?*BoundsFact = need;
            while (q != null) {
                left: ?*Expr = q.left;
                right: ?*Expr = q.right;
                if (q.kind == 3) {
                    have: int = bounds_fact_value(f, q.index, 3);
                    if (have < q.value) return false
                } else if (q.kind == 10 && left != null && right != null && bounds_num(left) == 0 && bounds_nonnegative_term(f,
                    right)) { } else if (!bounds_has_fact(f, q)) return false;
                q = q.next
            }
            true
        }
        _ -> false
    }
}

bounds_count_fits(a: *Expr@new, count: *Expr, f: ?*BoundsFact@new): bool {
    // Array lengths are nonnegative even when the allocation size is not a
    // literal. This also covers a freshly initialized zero count.
    if (bounds_num(count) == 0) return true;
    if (bounds_order(f, count, new_num(0), false)) return true;
    if (bounds_order_to_len(f, count, a, false)) return true;
    if (bounds_difference_proves(f, count, bounds_len_term(a), 0)) return true;
    known: int = bounds_known_len(a);
    av: ?*Obj = bounds_var(a);
    if (av != null) {
        fact_len: int = bounds_fact_value(f, av, 3);
        if (fact_len > known) known = fact_len
    }
    q: ?*BoundsFact = f;
    while (q != null) {
        left: ?*Expr = q.left;
        right: ?*Expr = q.right;
        if ((q.kind == 9 || q.kind == 10) && left != null && right != null && bounds_num(left) >= 0 && bounds_num(left) < 536870912 && bounds_separations_available(q.separation,
            f)) {
            match right.kind {
                Funcall call -> {
                    arg: ?*Expr = call.args;
                    if (streq(call.funcname, "len") && arg != null && bounds_same_array_expr(arg,
                        a)) {
                        lower: int = bounds_num(left);
                        if (q.kind == 9) lower = lower + 1;
                        if (lower > known) {
                            bounds_note_separations(q.separation, f);
                            known = lower
                        }
                    }
                }
                _ -> { }
            }
        }
        q = q.next
    }
    if (known < 0) return false;
    n: int = bounds_term_numeric_upper(f, count);
    cv: ?*Obj = bounds_var(count);
    if (cv != null && n < 0) n = bounds_fact_value(f, cv, 4);
    if (n >= 0 && n <= known) return true;
    bounds_order(f, count, new_num(known), false)
}

bounds_proves(a: *Expr@new, i: *Expr@new, f: ?*BoundsFact@new) raises Error: bool {
    ty: *Type = a.ty or error("internal: untyped index");
    n: int = bounds_num(i);
    iv: ?*Obj = bounds_var(i);
    if (iv != null && n < 0) n = bounds_fact_value(f, iv, 4);
    if (n >= 0 && is_array(ty) && n < array_len(ty)) return true;
    if (iv != null && is_array(ty)) {
        hi: int = bounds_fact_value(f, iv, 5);
        if (hi >= 0 && hi <= array_len(ty) && bounds_has(f, iv, null, 1)) return true
    }
    av: ?*Obj = bounds_var(a);
    if (av != null && n >= 0 && n < bounds_fact_value(f, av, 3)) return true;
    upper: int = bounds_small_upper(i, f);
    if (upper >= 0) {
        if (is_array(ty) && upper < array_len(ty)) return true;
        if (av != null && upper < bounds_fact_value(f, av, 3)) return true;
        if (upper < bounds_term_numeric_lower(f, bounds_len_term(a))) return true
    }
    length_lower: int = bounds_term_numeric_lower(f, bounds_len_term(a));
    if (length_lower > 0 && length_lower < 536870912 && bounds_difference_proves(f,
        i, new_num(length_lower), -1) && bounds_difference_proves(f, new_num(0), i,
        0)) return true;
    offset_index: ?*Obj = bounds_offset_var(i);
    offset: int = bounds_offset_amount(i);
    if (av != null && offset_index != null && offset >= 0 && bounds_has(f, offset_index,
        null, 1)) {
        q: ?*BoundsFact = f;
        while (q != null) {
            if (q.index == offset_index && q.array == av && q.kind == 6 && q.value >= offset) return true;
            q = q.next
        }
    }
    if (bounds_term(i) && bounds_nonnegative_term(f, i) && bounds_order_to_len(f,
        i, a, true)) return true;
    if (iv != null && bounds_has(f, iv, null, 1)) {
        qloop: ?*BoundsFact = f;
        while (qloop != null) {
            bound: ?*Expr = qloop.right;
            if (qloop.kind == 11 && qloop.index == iv && bound != null && bounds_order_to_len(f,
                bound, a, false)) return true;
            qloop = qloop.next
        }
        match a.kind {
            MemberAccess k -> {
                root: ?*Obj = bounds_var(k.lhs);
                member: ?*Member = k.member;
                if (root != null && member != null) {
                    m: *Member = member;
                    if (bounds_has_value(f, iv, root, 8, m.browse_id)) return true
                }
            }
            _ -> { }
        }
    }
    if (bounds_difference_index(f, a, i)) return true;
    if (iv == null || av == null) return false;
    if (!bounds_has(f, iv, null, 1)) return false;
    if (bounds_has(f, iv, av, 2)) return true;
    q: ?*BoundsFact = f;
    while (q != null) {
        if (q.index == iv && q.array != null && q.kind == 2 && bounds_has(f, av, q.array,
            7)) return true;
        q = q.next
    }
    false
}

bounds_inits(inits: ?*FieldInit@new, f: ?*BoundsFact@new) noregion raises Error: ?*BoundsFact@f {
    q: ?*FieldInit = inits;
    while (q != null) {
        f = bounds_expr(q.lhs, f);
        q = q.next
    }
    f
}

bounds_expr_list(e: ?*Expr@new, f: ?*BoundsFact@new) noregion raises Error: ?*BoundsFact@f {
    q: ?*Expr = e;
    while (q != null) {
        f = bounds_expr(q, f);
        q = q.next
    }
    f
}

bounds_expr(e: ?*Expr@new, f: ?*BoundsFact@new) noregion raises Error: ?*BoundsFact@new {
    if (e == null) return f;
    n: *Expr = e;
    match n.kind {
        Index k -> {
            f = bounds_expr(k.lhs, f);
            f = bounds_expr(k.idx, f);
            bounds_require(k.lhs, k.idx, f, n.file, n.pos);
            if (!bounds_infer_mode) n.bounds_proven = true;
            f
        }
        Binary k -> bounds_expr(k.rhs, bounds_expr(k.lhs, f));
        Assign k -> {
            // Ordinary assignments evaluate the RHS before the LHS address.
            // Doing the same for aggregate literals is conservative.
            f = bounds_expr(k.rhs, f);
            f = bounds_expr(k.lhs, f);
            v: ?*Obj = bounds_var(k.lhs);
            if (v == null) {
                match k.lhs.kind {
                    MemberAccess field -> {
                        member: ?*Member = field.member;
                        if (member == null) return bounds_after_call(f, null, null);
                        sd: ?*StructDef = bounds_record_def(field.lhs.ty);
                        preproved: bool = false;
                        if (sd != null) {
                            if (sd.invariant != null) {
                                if (!bounds_term(field.lhs)) error_at_file(n.file,
                                    n.pos, "record invariant assignment requires a stable record path");
                                preproved = bounds_record_write_preproved(sd, field.lhs,
                                    member, k.rhs, f)
                            }
                        }
                        f = bounds_kill_member(f, member);
                        f = bounds_value_facts(k.lhs, k.rhs, f);
                        if (sd != null) {
                            if (sd.invariant == null) return f;
                            if (preproved) f = bounds_record_invariant_facts(sd, field.lhs,
                                f) else f = bounds_verify_record_invariant(sd, field.lhs,
                                f, n.file, n.pos)
                        }
                        return f
                    }
                    Index _ -> {
                        // Replacing a record element may change fields seen
                        // through a pointer to that element.
                        t: ?*Type = k.lhs.ty;
                        if (t != null) {
                            if (is_struct_ty(t)) {
                                sd: *StructDef = type_struct_def(t);
                                if (bounds_flat_record(sd)) return bounds_kill_flat_record_fields(f,
                                    sd)
                            }
                            if (is_struct_ty(t) || is_enum_ty(t) || is_exn_ty(t) || is_array(t)) return bounds_kill_record_fields(f)
                        }
                        return f
                    }
                    _ -> return bounds_after_call(f, null, null)
                }
            }
            v.bounds_written = true;
            match k.rhs.kind {
                _ -> { }
            }
            rhs_upper: int = -1;
            if (bounds_pure_condition(k.rhs)) rhs_upper = bounds_small_upper(k.rhs,
                f);
            keep_nonnegative: bool = rhs_upper >= 0 || bounds_inc_preserves_nonnegative(v,
                k.rhs, f);
            shift: int = bounds_return_self_offset(v, k.rhs);
            if (shift == 1000000000) f = bounds_kill(f, v) else f = bounds_return_shift(f,
                v, shift);
            if (bounds_num(k.rhs) >= 0) f = bounds_add(f, v, null, 1);
            if (keep_nonnegative) f = bounds_add(f, v, null, 1);
            if (bounds_num(k.rhs) >= 0) f = bounds_add_value(f, v, null, 4, bounds_num(k.rhs));
            if (bounds_known_len(k.rhs) >= 0) f = bounds_add_value(f, v, null, 3,
                bounds_known_len(k.rhs));
            bounds_value_facts(bounds_obj_expr(v), k.rhs, f)
        }
        LogAnd k -> {
            f = bounds_expr(k.lhs, f);
            rhs: ?*BoundsFact = bounds_expr(k.rhs, bounds_condition(k.lhs, true, f));
            bounds_meet(f, rhs)
        }
        LogOr k -> {
            f = bounds_expr(k.lhs, f);
            rhs: ?*BoundsFact = bounds_expr(k.rhs, bounds_condition(k.lhs, false,
                f));
            bounds_meet(f, rhs)
        }
        OrElse k -> {
            f = bounds_expr(k.lhs, f);
            rhs2: ?*BoundsFact = bounds_expr(k.rhs, f);
            bounds_meet(f, rhs2)
        }
        Funcall k -> {
            f = bounds_expr_list(k.args, bounds_expr(k.target, f));
            if (streq(k.funcname, "len") || streq(k.funcname, "sizeof")) return f;
            if (streq(k.funcname, "check_index")) {
                a: ?*Expr = k.args;
                if (a == null) error("internal: check_index arguments");
                checked_array: *Expr = a;
                checked_index: ?*Expr = checked_array.next;
                if (checked_index == null) error("internal: check_index arguments");
                av: ?*Obj = bounds_var(checked_array);
                iv: ?*Obj = bounds_var(checked_index);
                array_path: ?*Expr = bounds_clone_path(checked_array);
                index_path: ?*Expr = bounds_clone_path(checked_index);
                if (array_path != null && index_path != null) {
                    f = bounds_add_order(f, new_num(0), index_path, 10);
                    f = bounds_add_order(f, index_path, bounds_len_term(array_path),
                        9);
                    f = bounds_add_difference(f, new_num(0), index_path, false);
                    f = bounds_add_difference(f, index_path, bounds_len_term(array_path),
                        true)
                }
                if (array_path != null) {
                    affine_check: ?*BoundsAffine = bounds_affine(checked_index, true);
                    if (affine_check != null) {
                        affine: *BoundsAffine = affine_check;
                        if (affine.offset > -536870912 && affine.offset < 536870912 && (affine.offset < 0 && bounds_term_numeric_lower(f,
                            affine.base) >= 0 - affine.offset || affine.offset >= 0 && bounds_nonnegative_term(f,
                            affine.base))) {
                            root: ?*Obj = bounds_term_root(affine.base);
                            if (root != null) f = new BoundsFact {
                                index: root,
                                array: bounds_term_root(array_path),
                                kind: 14,
                                value: 0 - affine.offset - 1,
                                left: affine.base,
                                right: bounds_len_term(array_path),
                                separation: null,
                                next: f
                            }
                        }
                    }
                }
                if (av == null || iv == null) return f;
                f = bounds_add(f, iv, null, 1);
                return bounds_add(f, iv, av, 2)
            }
            callee: ?*Function = k.fn;
            if (callee != null) bounds_check_call(callee, k.args, f, n.file, n.pos);
            bounds_after_call(f, callee, k.args)
        }
        If k -> {
            f = bounds_expr(k.cond, f);
            yes: ?*BoundsFact = bounds_expr(k.then, bounds_condition(k.cond, true,
                f));
            no: ?*BoundsFact = bounds_expr(k.els, bounds_condition(k.cond, false,
                f));
            bounds_meet(yes, no)
        }
        Block k -> bounds_stmt_list(k.body, f);
        Match k -> {
            f = bounds_expr(k.cond, f);
            surviving: ?*BoundsFact = f;
            q: ?*MatchArm = k.arms;
            while (q != null) {
                arm: ?*BoundsFact = bounds_stmt(q.body, f);
                surviving = bounds_meet(surviving, arm);
                q = q.next
            }
            surviving
        }
        Addr k -> {
            match k.lhs.kind {
                MemberAccess field -> {
                    sd: ?*StructDef = bounds_record_def(field.lhs.ty);
                    if (sd != null) {
                        if (sd.invariant != null) error_at_file(n.file, n.pos, "cannot take the address of a field in a record with an invariant")
                    }
                }
                _ -> { }
            }
            bounds_expr(k.lhs, f)
        }
        Deref k -> bounds_expr(k.lhs, f);
        Not k -> bounds_expr(k.lhs, f);
        Neg k -> bounds_expr(k.lhs, f);
        BitNot k -> bounds_expr(k.lhs, f);
        As k -> bounds_expr(k.lhs, f);
        Trunc k -> bounds_expr(k.lhs, f);
        MemberAccess k -> {
            f = bounds_expr(k.lhs, f);
            sd: ?*StructDef = bounds_record_def(k.lhs.ty);
            if (sd != null && bounds_term(k.lhs)) f = bounds_record_invariant_facts(sd,
                k.lhs, f);
            f
        }
        New k -> {
            f = bounds_inits(k.inits, bounds_expr(k.fill, bounds_expr(k.lhs, f)));
            bounds_verify_record_constructor(n, k.inits, f);
            f
        }
        StructLit k -> {
            f = bounds_inits(k.inits, f);
            bounds_verify_record_constructor(n, k.inits, f);
            f
        }
        VariantLit k -> bounds_inits(k.inits, f);
        ArrayLit k -> bounds_expr_list(k.elems, f);
        Sizeof k -> bounds_expr(k.e, f);
        _ -> f
    }
}

bounds_stmt(s: ?*Stmt, f: ?*BoundsFact@new) noregion raises Error: ?*BoundsFact@new {
    if (s == null) return f;
    n: *Stmt = s;
    match n.kind {
        ExprStmt k -> bounds_expr(k.lhs, f);
        Decl k -> {
            f = bounds_expr(k.init, f);
            v: ?*Obj = k.var;
            if (v != null) {
                init: ?*Expr = k.init;
                if (init != null) {
                    match init.kind {
                        New _ -> f = bounds_add_value(f, v, null, 13, v.browse_id);
                        _ -> { }
                    }
                }
                if (bounds_num(k.init) >= 0) {
                    f = bounds_add(f, v, null, 1);
                    f = bounds_add_value(f, v, null, 4, bounds_num(k.init))
                }
                if (bounds_infer_mode && bounds_num(k.init) >= 0 && is_int_ty(v.ty)) f = bounds_add_value(f,
                    v, null, 15, bounds_num(k.init));
                if (bounds_known_len(k.init) >= 0) f = bounds_add_value(f, v, null,
                    3, bounds_known_len(k.init));
                if (init != null) f = bounds_value_facts(bounds_obj_expr(v), init,
                    f)
            }
            f
        }
        Return k -> {
            trapped: bool = bounds_return_traps(k.lhs, f);
            f = bounds_expr(k.lhs, f);
            if (!trapped) bounds_return_visit(k.lhs, f);
            f
        }
        Raise k -> bounds_inits(k.inits, f);
        Block k -> bounds_stmt_list(k.body, f);
        Region k -> bounds_stmt(k.body, f);
        If k -> {
            f = bounds_expr(k.cond, f);
            yes: ?*BoundsFact = bounds_stmt(k.then, bounds_condition(k.cond, true,
                f));
            no: ?*BoundsFact = f;
            els: ?*Stmt = k.els;
            if (els != null) no = bounds_stmt(els, bounds_condition(k.cond, false,
                f));
            if (stmt_always_diverges(k.then)) return bounds_condition(k.cond, false,
                f);
            if (els != null && stmt_always_diverges(els)) return bounds_condition(k.cond,
                true, f);
            bounds_meet(yes, no)
        }
        While k -> {
            inv: ?*Expr = k.invariant;
            if (inv != null && !bounds_infer_mode && !bounds_invariant_proved(inv,
                f)) error_at_file(k.cond.file, k.cond.pos, "loop invariant is not proved at entry");
            invariant: ?*BoundsFact = f;
            changing: bool = true;
            while (changing) {
                tested: ?*BoundsFact = bounds_expr(k.cond, invariant);
                head: ?*BoundsFact = tested;
                if (inv != null) head = bounds_condition(inv, true, head);
                at_body: ?*BoundsFact = bounds_condition(k.cond, true, head);
                at_end: ?*BoundsFact = bounds_stmt(k.body, at_body);
                if (inv != null && !bounds_infer_mode && !bounds_invariant_proved(inv,
                    at_end)) error_at_file(k.cond.file, k.cond.pos, "loop invariant is not preserved by body");
                next_inv: ?*BoundsFact = bounds_meet(f, bounds_meet(tested, at_end));
                changing = !bounds_same(invariant, next_inv);
                invariant = next_inv
            }
            tested2: ?*BoundsFact = bounds_expr(k.cond, invariant);
            if (inv != null) tested2 = bounds_condition(inv, true, tested2);
            bounds_condition(k.cond, false, tested2)
        }
        For k -> {
            f = bounds_expr(k.hi, bounds_expr(k.iter, f));
            hi: ?*Expr = k.hi;
            if (hi != null) {
                av: ?*Obj = bounds_len_var(hi);
                if (av == null) {
                    upper: ?*BoundsAffine = bounds_affine(hi, false);
                    if (upper != null) {
                        if (upper.offset < 0) av = bounds_len_var(upper.base)
                    }
                }
                field_root: ?*Obj = null;
                field_member: ?*Member = null;
                match hi.kind {
                    Funcall len_call -> {
                        field_arg: ?*Expr = len_call.args;
                        if (streq(len_call.funcname, "len") && len_call.target == null && field_arg != null) {
                            field_array: *Expr = field_arg;
                            if (field_array.next == null) {
                                match field_array.kind {
                                    MemberAccess field -> {
                                        field_root = bounds_var(field.lhs);
                                        field_member = field.member
                                    }
                                    _ -> { }
                                }
                            }
                        }
                    }
                    _ -> { }
                }
                if (field_root != null && field_member != null && !bounds_field_safe_stmt(k.body,
                    field_root, field_member)) {
                    field_root = null;
                    field_member = null
                }
                stable_order_bound: bool = false;
                match hi.kind {
                    Var bound_var -> {
                        v: ?*Obj = bound_var.var;
                        if (v != null) stable_order_bound = v.is_local && !v.bounds_addr_taken && (!v.bounds_written || bounds_local_stable_stmt(k.body,
                            v))
                    }
                    MemberAccess _ -> {
                        root: ?*Obj = bounds_term_root(hi);
                        member: ?*Member = bounds_first_member(hi);
                        if (root != null && member != null) stable_order_bound = bounds_field_safe_stmt(k.body,
                            root, member)
                    }
                    _ -> { }
                }
                hiconst: int = bounds_num(hi);
                if (hiconst < 0 && bounds_pure_condition(hi)) hiconst = bounds_term_numeric_upper(f,
                    hi);
                lo_const: int = -1;
                if (bounds_pure_condition(k.iter)) lo_const = bounds_term_numeric_lower(f,
                    k.iter);
                invariant2: ?*BoundsFact = f;
                changing2: bool = true;
                while (changing2) {
                    facts: ?*BoundsFact = invariant2;
                    if (bounds_nonnegative_term(f, k.iter) || bounds_small_upper(k.iter,
                        f) >= 0) facts = bounds_add(facts, k.item, null, 1);
                    if (lo_const >= 0) facts = bounds_add_order(facts, new_num(lo_const),
                        bounds_obj_expr(k.item), 10);
                    if (av != null) facts = bounds_add(facts, k.item, av, 2);
                    if (stable_order_bound) facts = bounds_add_loop_order(facts, k.item,
                        hi);
                    if (field_root != null && field_member != null) {
                        m2: *Member = field_member;
                        facts = bounds_add_value(facts, k.item, field_root, 8, m2.browse_id)
                    }
                    if (hiconst >= 0) facts = bounds_add_value(facts, k.item, null,
                        5, hiconst);
                    endfacts: ?*BoundsFact = bounds_stmt(k.body, facts);
                    if (av != null && !bounds_has(endfacts, k.item, av, 2)) error_at_file(hi.file,
                        n.pos, "array used as for-loop bound may change in loop");
                    if (hiconst >= 0 && (k.item.bounds_written || k.item.bounds_addr_taken)) error_at_file(hi.file,
                        n.pos, "range index may change in loop");
                    next_inv2: ?*BoundsFact = bounds_meet(f, endfacts);
                    changing2 = !bounds_same(invariant2, next_inv2);
                    invariant2 = next_inv2
                }
                return invariant2
            }
            _body2: ?*BoundsFact = bounds_stmt(k.body, null);
            null
        }
        Match k -> {
            f = bounds_expr(k.cond, f);
            surviving: ?*BoundsFact = f;
            q: ?*MatchArm = k.arms;
            while (q != null) {
                arm: ?*BoundsFact = bounds_stmt(q.body, f);
                surviving = bounds_meet(surviving, arm);
                q = q.next
            }
            surviving
        }
        Try k -> {
            _trybody: ?*BoundsFact = bounds_stmt(k.body, f);
            q: ?*CatchArm = k.arms;
            while (q != null) {
                _catch: ?*BoundsFact = bounds_stmt(q.body, null);
                q = q.next
            }
            null
        }
        _ -> f
    }
}

bounds_stmt_list(s: ?*Stmt, f: ?*BoundsFact@new) noregion raises Error: ?*BoundsFact@f {
    q: ?*Stmt = s;
    while (q != null) {
        f = bounds_stmt(q, f);
        q = q.next
    }
    f
}

bounds_last_stmt(first: ?*Stmt): ?*Stmt@first {
    last: ?*Stmt = null;
    q: ?*Stmt = first;
    while (q != null) {
        last = q;
        q = q.next
    }
    last
}

bounds_finish_returns(fn: *Function, out: ?*BoundsFact@new) noregion {
    body: ?*Stmt = fn.body;
    if (body != null) {
        match body.kind {
            Block block -> {
                last: ?*Stmt = bounds_last_stmt(block.body);
                if (last != null) {
                    match last.kind {
                        ExprStmt item -> bounds_return_visit(item.lhs, out);
                        _ -> { }
                    }
                }
            }
            ExprStmt item -> bounds_return_visit(item.lhs, out);
            _ -> { }
        }
    }
    // A path that falls through without a value cannot justify a summary.
    if (body != null && !stmt_always_diverges(body)) {
        last_value: bool = false;
        match body.kind {
            Block block -> {
                last2: ?*Stmt = bounds_last_stmt(block.body);
                if (last2 != null) {
                    match last2.kind {
                        ExprStmt _ -> last_value = true;
                        _ -> { }
                    }
                }
            }
            ExprStmt _ -> last_value = true;
            _ -> { }
        }
        if (!last_value) bounds_return_accum = null
    }
    next: ?*BoundsReturnFact = if (bounds_return_seen) bounds_return_accum else null;
    if (!bounds_return_same(fn.bounds_returns, next)) bounds_infer_changed = true;
    fn.bounds_returns = next
}

// Tarjan's algorithm emits each call group after its dependencies. Contract
// inference only needs iteration inside a recursive group (or for a function
// whose newly inferred entry facts change its own return summary).
bounds_scc_visit(fn: *Function@immortal) noregion {
    bounds_scc_counter = bounds_scc_counter + 1;
    fn.bounds_visit = bounds_scc_counter;
    fn.bounds_lowlink = bounds_scc_counter;
    fn.bounds_on_stack = true;
    bounds_scc_stack = new BoundsTodo { fn: fn, next: bounds_scc_stack };
    edge: ?*CallEdge = fn.callees;
    while (edge != null) {
        callee: *Function = edge.callee;
        if (!callee.is_extern) {
            if (callee.bounds_visit == 0) {
                bounds_scc_visit(callee);
                if (callee.bounds_lowlink < fn.bounds_lowlink) fn.bounds_lowlink = callee.bounds_lowlink
            } else if (callee.bounds_on_stack && callee.bounds_visit < fn.bounds_lowlink) fn.bounds_lowlink = callee.bounds_visit
        }
        edge = edge.next
    }
    if (fn.bounds_lowlink != fn.bounds_visit) return;
    component: *BoundsComponent = new BoundsComponent { members: null, next: null };
    done: bool = false;
    while (!done) {
        top: ?*BoundsTodo = bounds_scc_stack;
        if (top != null) {
            bounds_scc_stack = top.next;
            member: *Function = top.fn;
            member.bounds_on_stack = false;
            done = member == fn;
            top.next = component.members;
            component.members = top
        } else done = true
    }
    last: ?*BoundsComponent = bounds_scc_last;
    if (last == null) bounds_scc_first = component else last.next = component;
    bounds_scc_last = component
}

// An uncalled entry point cannot acquire an input contract, and no call site
// can use a return summary. Its strict pass is sufficient.
bounds_entry_needs_inference(entry: *Function): bool {
    if (entry.address_taken) return true;
    caller: ?*Function = functions;
    while (caller != null) {
        edge: ?*CallEdge = caller.callees;
        while (edge != null) {
            if (edge.callee == entry) return true;
            edge = edge.next
        }
        caller = caller.next
    }
    false
}

verify_bounds_program() noregion raises Error {
    bounds_infer_effects();
    profile_mark("bounds effects");
    bounds_infer_mode = true;
    entry: ?*Function = find_function("main");
    infer_entry: bool = entry != null && bounds_entry_needs_inference(entry);
    bounds_scc_counter = 0;
    bounds_scc_stack = null;
    bounds_scc_first = null;
    bounds_scc_last = null;
    first: ?*Function = functions;
    while (first != null) {
        if (!first.is_extern && first.bounds_visit == 0) bounds_scc_visit(first);
        first = first.next
    }
    profile_mark("bounds call groups");
    component: ?*BoundsComponent = bounds_scc_first;
    while (component != null) {
        recursive: bool = false;
        first_member: ?*BoundsTodo = component.members;
        if (first_member != null) {
            if (first_member.next != null) recursive = true else {
                edge2: ?*CallEdge = first_member.fn.callees;
                while (edge2 != null) {
                    if (edge2.callee == first_member.fn) recursive = true;
                    edge2 = edge2.next
                }
            }
        }
        changed: bool = true;
        while (changed) {
            changed = false;
            member: ?*BoundsTodo = component.members;
            while (member != null) {
                fn: *Function = member.fn;
                if (fn != entry || infer_entry) {
                    bounds_infer_changed = false;
                    bounds_input_changed = false;
                    bounds_current_fn = fn;
                    bounds_return_accum = null;
                    bounds_return_seen = false;
                    f: ?*BoundsFact = bounds_initial(fn);
                    out: ?*BoundsFact = bounds_stmt(fn.body, f);
                    bounds_finish_returns(fn, out);
                    if (bounds_input_changed || recursive && bounds_infer_changed) changed = true
                }
                member = member.next
            }
        }
        component = component.next
    }
    bounds_infer_mode = false;
    profile_mark("bounds inference");
    if (entry != null) {
        if (entry.bounds_precondition != null) error_at_file(entry.browse_file, entry.browse_pos,
            "main cannot require a precondition");
        if (entry.bounds_requirements != null || entry.bounds_separations != null) error_at_file(entry.browse_file,
            entry.browse_pos, "main cannot require unproved array bounds at entry");
        entry_param: ?*Obj = entry.params;
        while (entry_param != null) {
            if (len(entry_param.index_for_name) != 0) error_at_file(entry_param.browse_file,
                entry_param.browse_pos, "main cannot require an index_for argument at entry");
            entry_param = entry_param.param_next
        }
    }
    unsupported: ?*Function = functions;
    while (unsupported != null) {
        if (unsupported.address_taken) {
            if (unsupported.bounds_precondition != null) error_at_file(unsupported.browse_file,
                unsupported.browse_pos, "function with precondition cannot be called indirectly");
            if (unsupported.bounds_requirements != null) error_at_file(unsupported.browse_file,
                unsupported.browse_pos, "function with bounds requirement cannot be called indirectly");
            if (unsupported.bounds_separations != null) error_at_file(unsupported.browse_file,
                unsupported.browse_pos, "function with separation requirement cannot be called indirectly");
            p0: ?*Obj = unsupported.params;
            while (p0 != null) {
                if (len(p0.index_for_name) != 0) error_at_file(unsupported.browse_file,
                    unsupported.browse_pos, "function with index_for requirement cannot be called indirectly");
                p0 = p0.param_next
            }
        }
        unsupported = unsupported.next
    }
    bounds_current_fn = null;
    g: ?*Obj = globals;
    while (g != null) {
        _gf: ?*BoundsFact = bounds_expr(g.init, null);
        g = g.next
    }
    fn2: ?*Function = functions;
    while (fn2 != null) {
        bounds_current_fn = fn2;
        f2: ?*BoundsFact = bounds_initial(fn2);
        if (!fn2.is_extern) _out2: ?*BoundsFact = bounds_stmt(fn2.body, f2);
        fn2 = fn2.next
    }
    profile_mark("bounds validation")
}
