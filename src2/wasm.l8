        temps = cg_temps_expr(q.global.init, temps);
        q = q.next
    }
    current_fn = null;
    wasm_begin(null, 0);
    wl_rbp = (temps + 7) / 8 * 8;
    w_gget(WG_INIT_DONE);
    w_op(80);
    w_if();
    w_i64(1);
    w_gset(WG_INIT_DONE);
