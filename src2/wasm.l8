// ---- the module ----
wasm_is_exit(fn: *Function): bool {
    fn.is_extern && (streq(fn.link_name, "exit") || streq(fn.link_name, "l8_exit"))
}

wasm_emits(fn: *Function): bool {
    !fn.is_extern && fn.body != null && (fn.test_id < 0 || compile_test_mode)
}

// Number imports, runtime functions, and L8 functions.
wasm_plan() noregion raises Error {
    wf_read = wasm_add_import("read", wasm_sig_i64(3, 1));
    wf_argv = wasm_add_import("l8_argv", wasm_sig_i64(0, 1));
    if (compile_test_mode) {
        wf_test_index = wasm_add_import("l8_test_index", wasm_sig_i64(0, 1));
        wf_test_record = wasm_add_import("l8_test_record", wasm_sig_i64(2, 0));
        wf_test_expect = wasm_add_import("l8_test_expect", wasm_sig_i64(1, 0))
    }
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.is_extern && !wasm_is_exit(fn)) fn.wasm_index = wasm_add_import(fn.link_name,
            wasm_extern_sig(fn));
        fn = fn.next
    }
    base: int = wasm_nimports;
    wf_malloc = base;
    wf_region_push = base + 1;
    wf_region_pop = base + 2;
    wf_region_unwind = base + 3;
    wf_str_eq = base + 4;
    wf_opt_str_eq = base + 5;
    wf_cstr = base + 6;
    wf_bytes = base + 7;
    wf_raise = base + 8;
    wf_oob = base + 9;
    wf_init_globals = base + 10;
    wf_start = base + 11;
    wf_exit = base + 12;
    next: int = base + WASM_NRUNTIME;
    fn = functions;
    while (fn != null) {
        if (wasm_is_exit(fn)) fn.wasm_index = wf_exit;
        if (wasm_emits(fn)) {
            fn.wasm_index = next;
            next = next + 1
        }
        fn = fn.next
    }
}

wasm_pad(addr: int): int {
    (addr + 7) / 8 * 8
}

// Place string literals and initialized globals in the data segment, then
// the zeroed globals and region marks; the heap starts after them.
wasm_layout() noregion raises Error {
    wasm_str_addr = new int[str_count](0);
    addr: int = WASM_STACK_TOP;
    s: ?*StrLit = str_lits;
    while (s != null) {
        if (s.label < 0 || s.label >= len(wasm_str_addr)) error("internal: string literal label");
        wasm_str_addr[s.label] = addr;
        wb_le(wasm_data, s.count, 8);
        data: []i8 = s.data;
        for i in 0..s.count + 1 {
            if (i < len(data)) wb_byte(wasm_data, data[i] as int)
        }
        end: int = wasm_pad(addr + 8 + s.count + 1);
        for _pad in addr + 8 + s.count + 1..end wb_byte(wasm_data, 0);
        addr = end;
        s = s.next
    }
    g: ?*Obj = globals;
    while (g != null) {
        if (!g.is_func && !g.is_const && is_const_init(g.init)) {
            init: *Expr = g.init or error("missing global initializer");
            gty: *Type = g.ty or error("missing global type");
            if (type_size(gty) > 8) error("global initializer must be a scalar constant");
            g.wasm_slot = addr;
            wb_le(wasm_data, const_value(init), 8);
            addr = addr + 8
        }
        g = g.next
    }
    g = globals;
    while (g != null) {
        if (!g.is_func && !g.is_const && !is_const_init(g.init)) {
            sz: int = 8;
            gty2: ?*Type = g.ty;
            if (gty2 != null) sz = type_size(gty2);
            if (sz < 8) sz = 8;
            g.wasm_slot = addr;
            addr = wasm_pad(addr + sz)
