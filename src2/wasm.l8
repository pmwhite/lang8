// _start: build argv through the host, run main, and record its result as the
// exit status. An uncaught exception records status 1, like l8_raise without
// a handler.
wasm_gen_start() noregion raises Error {
    wasm_begin(null, 0);
    done: int = w_block();
    caught: int = w_block();
    w_op(31);
    w_op(WT_VOID);
    w_u(1);
    w_op(0);
    w_u(0);
    w_u(w_rel(caught));
    wl_depth = wl_depth + 1;
    if (compile_test_mode) wasm_gen_test_entry(done) else {
        user_main: ?*Function = find_function("main");
        if (user_main != null && !user_main.is_extern) {
            if (user_main.nparams > 0) {
                w_call(wf_argv);
                w_lset(0);
                wg_len_of(0);
                if (user_main.nparams > 1) w_lget(0)
            }
            w_call(user_main.wasm_index)
        } else w_i64(0);
        w_gset(WG_EXIT_STATUS)
    }
    w_end();
    w_br(done);
    w_end();
    // An exit has recorded its status; any other exception is uncaught.
    w_gget(WG_EXC_TAG);
    w_i64(WASM_EXIT_TAG);
    w_op(82);
    w_if();
    if (compile_test_mode) {
        w_i64(0 - 1);
        w_gget(WG_EXC_TAG);
        w_call(wf_test_record);
        w_i64(3)
    } else w_i64(1);
    w_gset(WG_EXIT_STATUS);
    w_end();
    w_end();
    wasm_emit_body(wasm_sig_i64(0, 0), 0, 1)
}

// `l8 test`: run the test whose index the host passes. A test that returns
// records -2; an uncaught exception records -1 and its tag (in _start).
wasm_gen_test_entry(done: int) raises Error {
    w_call(wf_test_index);
    w_lset(0);
    w_call(wf_init_globals);
    c: ?*TestCase = test_cases;
    while (c != null) {
        w_lget(0);
        w_i64(c.id);
        w_op(81);
        w_if();
        w_call(c.fn.wasm_index);
        w_op(26);
        w_i64(0 - 2);
        w_i64(0);
        w_call(wf_test_record);
        w_i64(0);
        w_gset(WG_EXIT_STATUS);
        w_br(done);
        w_end();
        c = c.next
    }
    w_i64(2);
    w_gset(WG_EXIT_STATUS)
}

// ---- runtime functions ----
wasm_region_marks: int = 0;

// The address of region mark n, from the i64 n on the stack.
