        g: *Obj = q.global;
        e: *Expr = g.init or error("missing global initializer");
        ty: *Type = g.ty or error("missing global type");
        if (passes_by_ref(ty)) {
            w_i32(g.wasm_slot);
            wg_expr(e);
            w_wrap();
            w_i32(wasm_copy_size(ty));
            w_memory_copy()
