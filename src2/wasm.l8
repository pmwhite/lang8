    fn: ?*Function = functions;
    while (fn != null) {
        if (wasm_emits(fn)) {
            wb_uleb(names, fn.wasm_index);
            wb_name(names, fn.link_name)
        }
        fn = fn.next
    }
    s: *StrBuf = sb_new();
    wb_name(s, "name");
    wb_byte(s, 1);
    wb_uleb(s, names.used);
    wb_append(s, names);
    wb_section(m, 0, s)
}

wasm_write_file(path: str, m: *StrBuf) raises Error {
    fd: int = open(path, 577, 420);
    if (fd < 0) error("cannot write the output file");
    off: int = 0;
    while (off < m.used) {
        n: int = raw::raw_write_some(fd, m.data, off, m.used - off);
        if (n <= 0) error("cannot write the output file");
        off = off + n
    }
    close(fd)
}

// Build for `l8 test --wasm`; the caller writes the module.
compiler_build_wasm(src_path: []i8@immortal) noregion raises IndexOutOfBounds: int {
    try {
        compiler_analyze(src_path);
        wasm_codegen();
        0
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1
    }
}

// web/run.mjs beside the compiler executable.
wasm_runner_path() raises Error: []i8@new {
    buffer: []i8 = new i8[4096](0i8);
    n: int = runtime_readlink(89, "/proc/self/exe", buffer, len(buffer));
    if (n <= 0 || n > len(buffer)) error("cannot locate the compiler executable");
    slash: int = 0;
    for i in 0..n {
        if (buffer[i] == '/') slash = i + 1
    }
    path: *StrBuf = sb_new();
    for k in 0..slash {
        if (k < len(buffer)) sb_putc(path, buffer[k])
    }
    sb_puts(path, "web/run.mjs");
    sb_finish(path)
}

wasm_usage(): int {
    raw::raw_write(2, "error: usage: l8 wasm [--profile|-p] <source.l8> -o <module.wasm>\n");
    1
}

compiler_wasm_main(argc: int, argv: []str) noregion raises IndexOutOfBounds: int requires (argc <= len(argv)) {
    do_profile = false;
    have_s: bool = false;
    have_o: bool = false;
    want_o: bool = false;
    if (argc < 1) return wasm_usage();
    source: str = argv[0];
    output: str = argv[0];
    for ai in 1..argc {
        arg: str = argv[ai];
        if (want_o) {
            if (have_o) return wasm_usage();
            output = arg;
            have_o = true;
            want_o = false
        } else if (is_profile_flag(arg)) do_profile = true else if (arg == "-o") want_o = true else {
            if (have_s) return wasm_usage();
            source = arg;
            have_s = true
        }
    }
    if (!have_s || !have_o || want_o) return wasm_usage();
    try {
        compiler_analyze(bytes(source));
        wasm_codegen();
        profile_mark("codegen");
        wasm_write_file(output, wasm_module());
        profile_mark("write");
        profile_end();
        0
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1
    }
}
