    w_lget(3);
    w_i64(256);
    w_op(124);
    w_wrap();
    w_op(64);
    w_op(0);
    w_i32(0 - 1);
    w_op(70);
    w_if();
    w_lget(3);
    w_wrap();
    w_op(64);
    w_op(0);
    w_i32(0 - 1);
    w_op(70);
    w_if();
    w_i64(0);
    w_op(15);
