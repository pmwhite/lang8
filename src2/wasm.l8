wasm_gen_function(fn: *Function@immortal) noregion raises Error, IndexOutOfBounds {
    narrow_top = null;
    catch_top = null;
    assign_lvar_offsets(fn);
    current_fn_name = fn.name;
    current_return_ty = fn.return_ty;
    current_sret = fn.sret;
    current_fn = fn;
    np: int = fn.nparams + (if (fn.sret != null) 1 else 0);
    wasm_begin(fn, np);
    wasm_assign_locals(fn, np);
    wl_tmp_base = np + 3 + wl_nvars;
    wl_rbp = fn.stack_size;
    body: *Stmt = fn.body or error("missing body");
    wg_stmt(body);
    // Falling off the end returns the last expression statement's value.
    w_lget(wl_acc);
    if (fn.sret != null) wg_copy_to_sret();
    wg_epilogue();
    wasm_prologue(fn);
    wasm_emit_body(wasm_fn_type(fn), 2, 1 + wl_nvars + wl_tmp_max)
