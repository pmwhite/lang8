    wasm_begin(null, 1);
    w_gget(WG_HEAP);
    w_lset(1);
    w_lget(1);
    w_lget(0);
    w_i64(7);
    w_op(124);
    w_i64(0 - 8);
    w_op(131);
    w_op(124);
    w_lset(2);
    w_lget(2);
    wr_memory_bytes();
    w_op(86);
    w_if();
    w_lget(2);
    wr_memory_bytes();
    w_op(125);
    w_i64(65535);
    w_op(124);
    w_i64(16);
    w_op(136);
    w_lset(3);
