wasm_codegen() noregion raises Error, IndexOutOfBounds {
    // The test entry point stands in for main.
    wasm_plan();
    wasm_layout();
    wr_malloc();
    wr_region_push();
    wr_region_pop();
    wr_region_unwind();
    wr_str_eq();
    wr_opt_str_eq();
    wr_cstr();
    wr_bytes();
    wr_raise();
    wr_oob();
    wasm_gen_init_globals();
    wasm_gen_start();
    wr_exit();
    fn: ?*Function = functions;
    while (fn != null) {
        if (wasm_emits(fn)) wasm_gen_function(fn);
        fn = fn.next
    }
}

wb_global(sb: *StrBuf@new, ty: int, value: int) raises Error {
    wb_byte(sb, ty);
