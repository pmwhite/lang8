// Copy a C-string into a counted []i8 so later indexes use len, not a guessed n.
zslice(s: [z]i8): []i8 {
    n: int = 0;
    while (s[n] != 0i8) { n = n + 1; }
    out: []i8 = new i8[n](0i8);
    i: int = 0;
    while (s[i] != 0i8) {
        out[i] = s[i];
        i = i + 1;
    }
    out;
}

/* Remaining args of a counted argv. */
argv_span(argv: [][z]i8, off: int): [][z]i8 {
    n: int = len(argv) - off;
    if (n < 0) { n = 0; }
    if (len(argv) < 1) { exit(1); }
    dst: [][z]i8 = new [z]i8[n](argv[0]);
    i: int = 0;
    while (i < n) {
        dst[i] = argv[off + i];
        i = i + 1;
    }
    dst;
}

cli_streq(a: [z]i8, b: []i8): bool {
    n: int = len(b);
    i: int = 0;
    while (a[i] != 0i8) {
        if (i >= n) { return false; }
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    i == n;
}

/* NUL-terminate a []i8 for the OS, then open. */
open_path(path: []i8, flags: int, mode: int): int {
    n: int = len(path);
    z: []i8 = new i8[n + 1](0i8);
    memcpy(z, 0, path, 0, n);
    z[n] = 0i8;
    open(z, flags, mode);
}
