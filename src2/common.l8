tag compiler_internal;

import "../stdlib/raw_write.l8";

exception Error {
    msg: []i8;
    pos: int;
    path: []i8;
    src: []i8;
    src_len: int
}

type Timespec = {
    sec: int;
    nsec: int
}

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

extern exit(code: int): noreturn;

extern rdtsc(): int;

extern clock_gettime(clk: int, ts: *Timespec): int;

extern getrusage(buf: *i8): int;

mono_ns(): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    ts.sec * 1000000000 + ts.nsec
}

// Command arguments must outlive compiler pool resets. One span is live.
argv_span_slots: []str = static_buffer(4096, "");

argv_span_len: int = 0;

/* Remaining args of a counted argv. The returned slice is longer than argv_span_len. */
argv_span(argv: []str@new, off: int): []str@new {
    n: int = len(argv) - off;
    if (len(argv) < 1) exit(1);
    if (n < 0 || n > len(argv_span_slots)) {
        raw::raw_write(2, "error: more than 4096 arguments\n");
        exit(1)
    }
    for i in 0..n argv_span_slots[i] = argv[off + i];
    argv_span_len = n;
    argv_span_slots
}

/* Convert an ordinary byte path only at the OS boundary. */
open_path(path: []i8, flags: int, mode: int): int {
    open(cstr(path), flags, mode)
}
