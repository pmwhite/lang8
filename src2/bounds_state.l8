tag compiler_internal;

// Empty states share one zero-length view. Its typed fill is never read.
bounds_empty_row_index: *Obj = new Obj {
    name: ".bounds-empty-row",
    is_local: true,
    is_func: false,
    is_const: false,
    const_val: 0,
    const_state: 0,
    offset: 0,
    scope_depth: 0,
    ty: null,
    used: false,
    init: null,
    next: null,
    param_next: null,
    hash_next: null,
    life: 0,
    storage_life: 0,
    life_bound: "",
    index_for_name: "",
    bounds_addr_taken: false,
    bounds_written: false,
    bounds_entry: null,
    bound_need_imm: false,
    bound_need_new: false,
    bound_named: null,
    browse_id: 0,
    browse_pos: 0,
    browse_file: 0,
    browse_len: 0,
    lead: null,
    trail: null
};

bounds_empty_row_view: []BoundsRow = new BoundsRow[0](BoundsRow {
    index: bounds_empty_row_index,
    array: null,
    kind: BoundsKind.Fresh,
    value: 0,
    left: null,
    right: null,
    separation: null
});

bounds_empty_rows(): []BoundsRow {
    bounds_empty_row_view
}

bounds_empty_numeric_view(): []BoundsNumericView@new {
    missing: BoundsTermRef = BoundsTermRef {
        path: null,
        obj: null,
        is_len: false,
        is_zero: false,
        valid: false
    };
    new BoundsNumericView[0](BoundsNumericView {
        left: missing,
        right: missing,
        bound: 0,
        separation: null
    })
}

bounds_graph_cache_new() raises IndexOutOfBounds: *BoundsGraphCache@new {
    graph: *BoundsGraph = bounds_graph_new(BOUNDS_GRAPH_CACHE_ROWS);
    capacity: int = len(graph.terms);
    new BoundsGraphCache {
        graph: graph,
        source: -2,
        complete: false,
        storage: null,
        count: -1,
        distances: new int[capacity](0),
        queued: new bool[capacity](false),
        queue: new int[capacity + 1](0)
    }
}

bounds_arena_new() raises IndexOutOfBounds: *BoundsArena@new {
    first: *BoundsGraphCache = bounds_graph_cache_new();
    second: *BoundsGraphCache = bounds_graph_cache_new();
    new BoundsArena {
        first_graph: first,
        second_graph: second,
        free: new ?*BoundsStorage[24](null),
        active: null
    }
}

bounds_arena_bin(capacity: int): int ensures (0 <= returned) {
    bin: u32 = 0u32;
    size: int = capacity;
    while (size > 1) {
        size = size / 2;
        bin = bin + 1u32
    }
    bin as int
}

// End of one function/pass: there must be no remaining users of its states.
// AST terms and exported summary rows are deliberately not reclaimed.
bounds_arena_reset(arena: *BoundsArena) {
    storage: ?*BoundsStorage = arena.active;
    arena.active = null;
    arena.first_graph.storage = null;
    arena.first_graph.count = -1;
    arena.second_graph.storage = null;
    arena.second_graph.count = -1;
    while (storage != null) {
        next: ?*BoundsStorage = storage.pool_next;
        bin: int = bounds_arena_bin(len(storage.rows));
        if (bin < len(arena.free)) {
            storage.pool_next = arena.free[bin];
            arena.free[bin] = storage
        }
        storage = next
    }
}

bounds_arena_state(arena: *BoundsArena@new): *BoundsState@new {
    new BoundsState {
        arena: arena,
        unreachable: false,
        storage: null,
        rows_view: bounds_empty_rows(),
        numeric_view: bounds_empty_numeric_view(),
        count: 0,
        sum_count: 0,
        implications: null
    }
}

bounds_empty(state: ?*BoundsState@new): ?*BoundsState@new {
    arena: ?*BoundsArena = if (state == null) null else state.arena;
    if (arena == null) null else bounds_arena_state(arena)
}

bounds_storage_new(arena: ?*BoundsArena@new, row: BoundsRow@new, capacity: int) raises IndexOutOfBounds: *BoundsStorage@new ensures (len(returned.rows) >= capacity) {
    if (capacity <= 0) raise IndexOutOfBounds;
    bin: int = bounds_arena_bin(capacity);
    if (arena != null && bin < len(arena.free)) {
        reused: ?*BoundsStorage = arena.free[bin];
        if (reused != null && len(reused.rows) >= capacity) {
            arena.free[bin] = reused.pool_next;
            reused.pool_next = arena.active;
            arena.active = reused;
            buckets: []?*BoundsLinkNode = reused.buckets;
            for i in 0..len(buckets) buckets[i] = null;
            reused.prefix_source = null;
            reused.prefix_count = 0;
            return reused
        }
    }
    bucket_count: int = capacity * 2;
    if (bucket_count <= 0) raise IndexOutOfBounds;
    storage: *BoundsStorage = new BoundsStorage {
        prefix_source: null,
        prefix_count: 0,
        pool_next: if (arena == null) null else arena.active,
        rows: new BoundsRow[capacity](row),
        numeric: new BoundsNumericView[capacity](bounds_numeric_query(null, null,
            0)),
        buckets: new ?*BoundsLinkNode[bucket_count](null),
        links: new BoundsLinkNode[capacity](BoundsLinkNode { position: 0, next: null }),
        used: 0
    };
    if (arena != null) arena.active = storage;
    storage
}

bounds_reachable(state: ?*BoundsState): bool {
    state == null || !state.unreachable
}

// Bottom has no rows and never enters the numeric solver. Keeping it explicit
// lets every control-flow join distinguish no predecessor from no information.
bounds_unreachable(): *BoundsState@new {
    new BoundsState {
        arena: null,
        unreachable: true,
        storage: null,
        rows_view: bounds_empty_rows(),
        numeric_view: bounds_empty_numeric_view(),
        count: 0,
        sum_count: 0,
        implications: null
    }
}

// A row belongs to a dense fact table, never to a linked list. Numeric rows
// lower to left - right <= bound; other rows describe identity/provenance.
// The AST adapter retains source paths for invalidation and diagnostics.
bounds_count(state: ?*BoundsState): int ensures (0 <= returned) {
    if (state == null) return 0;
    state.count
}

bounds_has_sum(state: ?*BoundsState): bool {
    if (state == null) return false;
    state.sum_count != 0
}

bounds_row(state: ?*BoundsState, position: int): ?*BoundsRow@state {
    if (state == null) return null;
    if (position < 0 || position >= state.count) return null;
    storage: ?*BoundsStorage = state.storage;
    if (storage == null) return null;
    &state.rows_view[position]
}

bounds_storage(state: ?*BoundsState@new, row: BoundsRow@new, count: int) raises IndexOutOfBounds: *BoundsStorage@new requires (0 <= count) ensures (returned.used == count && 0 <= count && count < len(returned.numeric)) {
    if (state != null) {
        old: ?*BoundsStorage = state.storage;
        if (old != null && old.used == count && count < len(old.numeric)) return old
    }
    capacity: int = 4;
    while (capacity <= count) {
        // Preserve a positive capacity when doubling a large fact table.
        if (capacity > 4611686018427387903) raise IndexOutOfBounds;
        capacity = capacity * 2
    }
    arena: ?*BoundsArena = if (state == null) null else state.arena;
    storage: *BoundsStorage = bounds_storage_new(arena, row, capacity);
    rows: []BoundsRow = storage.rows;
    numeric: []BoundsNumericView = storage.numeric;
    buckets: []?*BoundsLinkNode = storage.buckets;
    links: []BoundsLinkNode = storage.links;
    previous: ?*BoundsStorage = if (state == null) null else state.storage;
    if (previous != null) {
        source: []BoundsRow = previous.rows;
        source_numeric: []BoundsNumericView = previous.numeric;
        source_links: []BoundsLinkNode = previous.links;
        source_buckets: []?*BoundsLinkNode = previous.buckets;
        if (count > len(rows) || count > len(numeric) || count > len(links) || count > len(source) || count > len(source_numeric) || count > len(source_links)) raise IndexOutOfBounds;
        if (len(buckets) == len(source_buckets)) {
            // Append-only chains point backwards. Trim only bucket heads that
            // belong to rows after the snapshot. Older nodes can be shared.
            for i in 0..count {
                rows[i] = source[i];
                numeric[i] = source_numeric[i]
            }
            for slot in 0..len(buckets) {
                head: ?*BoundsLinkNode = source_buckets[slot];
                while (head != null && head.position >= count) head = head.next;
                buckets[slot] = head
            }
        } else {
            for i in 0..count {
                rows[i] = source[i];
                item: BoundsNumericView = source_numeric[i];
                numeric[i] = item;
                hash: int = bounds_row_hash(&rows[i], &item);
                slot: int = hash & len(buckets) - 1;
                links[i] = BoundsLinkNode { position: i, next: buckets[slot] };
                buckets[slot] = &links[i]
            }
        }
    }
    storage.prefix_source = previous;
    storage.prefix_count = count;
    storage.used = count;
    storage
}

bounds_push(state: ?*BoundsState@new, row: BoundsRow@new) raises IndexOutOfBounds: *BoundsState@new {
    if (state != null && state.unreachable) return state;
    // Numeric rows are normalized on entry, including rows made by joins.
    // After this boundary, source syntax no longer determines representation.
    if (row.kind == BoundsKind.Difference) {
        normal: BoundsNumericView = bounds_numeric_view(&row);
        row.value = normal.bound;
        if (normal.left.is_zero && bounds_num(row.left) != 0) row.left = new_num(0);
        if (normal.right.is_zero && bounds_num(row.right) != 0) row.right = new_num(0);
        left: ?*Expr = row.left;
        right: ?*Expr = row.right;
        if (left != null && right != null) {
            root: ?*Obj = bounds_term_root(left);
            if (root == null) root = bounds_term_root(right);
            if (root != null) row.index = root;
            row.array = bounds_term_root(right)
        }
    }
    decoded: BoundsNumericView = bounds_numeric_view(&row);
    hash: int = bounds_row_hash(&row, &decoded);
    if (state != null) {
        link: ?*BoundsLinkNode = bounds_bucket(state, hash);
        while (link != null) {
            existing: ?*BoundsRow = bounds_row(state, link.position);
            if (existing != null && bounds_row_same(existing, &row)) return state;
            link = link.next
        }
    }
    count: int = bounds_count(state);
    storage: *BoundsStorage = bounds_storage(state, row, count);
    storage.rows[count] = row;
    storage.numeric[count] = decoded;
    slot: int = hash & len(storage.buckets) - 1;
    storage.links[count] = BoundsLinkNode { position: count, next: storage.buckets[slot] };
    storage.buckets[slot] = &storage.links[count];
    storage.used = count + 1;
    implications: ?*BoundsImplication = null;
    if (state != null) implications = state.implications;
    sum_count: int = 0;
    if (state != null) sum_count = state.sum_count;
    if (row.kind == BoundsKind.SumUpper) sum_count = sum_count + 1;
    new BoundsState {
        arena: if (state == null) null else state.arena,
        unreachable: false,
        storage: storage,
        rows_view: storage.rows,
        numeric_view: storage.numeric,
        count: count + 1,
        sum_count: sum_count,
        implications: implications
    }
}

// Existing fact rows are already normalized and unique. Filtering a state
// can append them directly without normalizing and searching for duplicates.
// row must be the unchanged row at position in source. Its normalized
// descriptor is already cached and can be copied without inspecting the AST.
bounds_copy_storage(
    state: ?*BoundsState@new,
    row: *BoundsRow@new,
    count: int,
    hint: int
) raises IndexOutOfBounds: *BoundsStorage@new requires (0 <= count) ensures (0 <= count && count < len(returned.numeric)) {
    if (count == 0) {
        capacity: int = 4;
        while (capacity <= hint && capacity < 64) capacity = capacity * 2;
        arena: ?*BoundsArena = if (state == null) null else state.arena;
        return bounds_storage_new(arena, row.*, capacity)
    }
    bounds_storage(state, row.*, count)
}

bounds_storage_next_count(numeric: []BoundsNumericView, count: int): int requires (0 <= count && count < len(numeric)) ensures (0 <= returned && returned <= len(numeric)) {
    count + 1
}

bounds_copy_from(
    state: ?*BoundsState@new,
    source: ?*BoundsState,
    row: *BoundsRow@new,
    position: int
) raises IndexOutOfBounds: *BoundsState@new {
    if (state != null && state.unreachable) return state;
    hint: int = bounds_count(source);
    numeric: BoundsNumericView = bounds_numeric_at(source, position);
    count: int = bounds_count(state);
    storage: *BoundsStorage = bounds_copy_storage(state, row, count, hint);
    numeric_view: []BoundsNumericView = storage.numeric;
    next_count: int = bounds_storage_next_count(numeric_view, count);
    sum_count: int = if (state == null) 0 else state.sum_count;
    if (row.kind == BoundsKind.SumUpper) sum_count = sum_count + 1;
    arena: ?*BoundsArena = if (state == null) null else state.arena;
    implications: ?*BoundsImplication = if (state == null) null else state.implications;
    result: *BoundsState = new BoundsState {
        arena: arena,
        unreachable: false,
        storage: storage,
        rows_view: storage.rows,
        numeric_view: numeric_view,
        count: next_count,
        sum_count: sum_count,
        implications: implications
    };
    storage.rows[count] = row.*;
    storage.numeric[count] = numeric;
    hash: int = bounds_row_hash(row, &numeric);
    slot: int = hash & len(storage.buckets) - 1;
    storage.links[count] = BoundsLinkNode { position: count, next: storage.buckets[slot] };
    storage.buckets[slot] = &storage.links[count];
    storage.used = count + 1;
    result
}

// Filters visit source rows in order and pass the original row at position.
// Share the surviving prefix; the first append after a gap uses the normal
// copy-on-write path. Invalidation deliberately drops all implications.
bounds_filter_copy(
    head: ?*BoundsState@new,
    source: *BoundsState@new,
    row: *BoundsRow@new,
    position: int
) raises IndexOutOfBounds: *BoundsState@new requires (0 <= position && position < source.count) {
    if (position == 0 && bounds_count(head) == 0 || head != null && head.storage == source.storage && head.count == position) {
        sums: int = if (head == null) 0 else head.sum_count;
        if (row.kind == BoundsKind.SumUpper) sums = sums + 1;
        return new BoundsState {
            arena: source.arena,
            unreachable: false,
            storage: source.storage,
            rows_view: source.rows_view,
            numeric_view: source.numeric_view,
            count: position + 1,
            sum_count: sums,
            implications: null
        }
    }
    bounds_copy_from(head, source, row, position)
}

bounds_copy_separation(state: ?*BoundsState@new, row: *BoundsRow@new, separation: ?*BoundsSeparation) raises IndexOutOfBounds: *BoundsState@new {
    copy: BoundsRow = row.*;
    copy.separation = separation;
    bounds_push(state, copy)
}

bounds_row_same(a: *BoundsRow, b: *BoundsRow) raises IndexOutOfBounds: bool {
    if (a == b) return true;
    if (a.kind != b.kind || a.index != b.index || a.array != b.array || a.value != b.value || !bounds_separation_same(a.separation,
        b.separation)) return false;
    al: ?*Expr = a.left;
    bl: ?*Expr = b.left;
    ar: ?*Expr = a.right;
    br: ?*Expr = b.right;
    if (a.kind == BoundsKind.SumUpper) {
        if (al == null || bl == null || ar == null || br == null) return false;
        match al.kind {
            Binary sum_a -> {
                match bl.kind {
                    Binary sum_b -> return sum_a.op == BinOp.Add && sum_b.op == BinOp.Add && bounds_same_term(sum_a.lhs,
                        sum_b.lhs) && bounds_same_term(sum_a.rhs, sum_b.rhs) && bounds_same_term(ar,
                        br);
                    _ -> return false
                }
            }
            _ -> return false
        }
    }
    if (a.kind == BoundsKind.Equal || a.kind == BoundsKind.NotEqual) {
        if (al == null || bl == null || ar == null || br == null) return false;
        return bounds_same_scalar(al, bl) && bounds_same_scalar(ar, br) || bounds_same_scalar(al,
            br) && bounds_same_scalar(ar, bl)
    }
    if (al != null && bl != null) {
        if (!bounds_same_term(al, bl)) return false
    } else if (al != bl) return false;
    if (ar != null && br != null) {
        if (!bounds_same_term(ar, br)) return false
    } else if (ar != br) return false;
    true
}

bounds_has_fact_numeric(state: ?*BoundsState, row: *BoundsRow, numeric: *BoundsNumericView) raises IndexOutOfBounds: bool {
    if (!bounds_reachable(state)) return true;
    if (numeric.left.valid && numeric.right.valid) return bounds_numeric_entails(state,
        numeric);
    if (state == null) return false;
    link: ?*BoundsLinkNode = bounds_bucket(state, bounds_row_hash(row, numeric));
    while (link != null) {
        other: ?*BoundsRow = bounds_row(state, link.position);
        if (other != null && bounds_row_same(other, row)) return true;
        link = link.next
    }
    false
}

bounds_has_fact(state: ?*BoundsState, row: *BoundsRow) raises IndexOutOfBounds: bool {
    numeric: BoundsNumericView = bounds_numeric_view(row);
    bounds_has_fact_numeric(state, row, &numeric)
}

// row and position identify the same immutable source fact.
bounds_has_indexed_fact(
    state: ?*BoundsState,
    source: ?*BoundsState,
    row: *BoundsRow,
    position: int
) raises IndexOutOfBounds: bool {
    numeric: BoundsNumericView = bounds_numeric_at(source, position);
    bounds_has_fact_numeric(state, row, &numeric)
}

bounds_premises_has(head: ?*BoundsPremise, fact: *BoundsRow) raises IndexOutOfBounds: bool {
    q: ?*BoundsPremise = head;
    while (q != null) {
        if (bounds_row_same(&q.fact, fact)) return true;
        q = q.next
    }
    false
}

bounds_premises_same(a: ?*BoundsPremise, b: ?*BoundsPremise) raises IndexOutOfBounds: bool {
    p: ?*BoundsPremise = a;
    while (p != null) {
        if (!bounds_premises_has(b, &p.fact)) return false;
        p = p.next
    }
    q: ?*BoundsPremise = b;
    while (q != null) {
        if (!bounds_premises_has(a, &q.fact)) return false;
        q = q.next
    }
    true
}

bounds_implication_same(a: *BoundsImplication, b: *BoundsImplication) raises IndexOutOfBounds: bool {
    bounds_premises_same(a.premises, b.premises) && bounds_row_same(&a.consequence,
        &b.consequence)
}

bounds_has_implication(state: ?*BoundsState, wanted: *BoundsImplication) raises IndexOutOfBounds: bool {
    if (state == null) return false;
    q: ?*BoundsImplication = state.implications;
    while (q != null) {
        if (bounds_implication_same(q, wanted)) return true;
        q = q.next
    }
    false
}

bounds_attach_implication(state: ?*BoundsState@new, rule: *BoundsImplication@new) raises IndexOutOfBounds: *BoundsState@new {
    if (state != null && state.unreachable) return state;
    if (state != null) {
        if (bounds_has_implication(state, rule)) return state
    }
    previous: ?*BoundsImplication = if (state == null) null else state.implications;
    linked: *BoundsImplication = new BoundsImplication { premises: rule.premises, consequence: rule.consequence, next: previous };
    if (state == null) return new BoundsState {
        arena: null,
        unreachable: false,
        storage: null,
        rows_view: bounds_empty_rows(),
        numeric_view: bounds_empty_numeric_view(),
        count: 0,
        sum_count: 0,
        implications: linked
    };
    new BoundsState {
        arena: state.arena,
        unreachable: false,
        storage: state.storage,
        rows_view: state.rows_view,
        numeric_view: state.numeric_view,
        count: state.count,
        sum_count: state.sum_count,
        implications: linked
    }
}

bounds_meet_implications(a: ?*BoundsState@new, b: ?*BoundsState, result: ?*BoundsState@new) raises IndexOutOfBounds: ?*BoundsState@result {
    if (a == null) return result;
    q: ?*BoundsImplication = a.implications;
    while (q != null) {
        if (bounds_has_implication(b, q)) result = bounds_attach_implication(result,
            q);
        q = q.next
    }
    result
}

bounds_implications_same(a: ?*BoundsState, b: ?*BoundsState) raises IndexOutOfBounds: bool {
    if (a == null) {
        if (b == null) return true;
        return b.implications == null
    }
    q: ?*BoundsImplication = a.implications;
    while (q != null) {
        if (!bounds_has_implication(b, q)) return false;
        q = q.next
    }
    if (b == null) return true;
    other: ?*BoundsImplication = b.implications;
    while (other != null) {
        if (!bounds_has_implication(a, other)) return false;
        other = other.next
    }
    true
}

// Find a bound for the same canonical pair, independent of the syntax which
// established it. Alias assumptions may be weakened, never strengthened.
// Lattice queries compare obligations. Proof searches return any assumptions
// with their evidence, without changing the current function's contract.
bounds_direct_evidence(state: ?*BoundsState, wanted: *BoundsNumericView, prove: bool) raises IndexOutOfBounds: BoundsEvidence {
    best: int = 1000000000;
    obligation: ?*BoundsSeparation = null;
    storage: ?*BoundsStorage = if (state == null) null else state.storage;
    if (state == null || storage == null) return BoundsEvidence { bound: best, separation: null };
    numeric: []BoundsNumericView = state.numeric_view;
    buckets: []?*BoundsLinkNode = storage.buckets;
    count: int = state.count;
    link: ?*BoundsLinkNode = buckets[bounds_pair_hash(wanted) & len(buckets) - 1];
    while (link != null) {
        position: int = link.position;
        if (position < count) {
            edge: *BoundsNumericView = &numeric[position];
            if (edge.left.valid && edge.right.valid && edge.bound < best && bounds_ref_same_borrowed(&wanted.left,
                &edge.left) && bounds_ref_same_borrowed(&wanted.right, &edge.right)) {
                available: bool = if (prove) bounds_separations_available(edge.separation,
                    state) else edge.separation == null || bounds_separation_same(edge.separation,
                    wanted.separation);
                if (available) {
                    best = edge.bound;
                    obligation = edge.separation
                }
            }
        }
        link = link.next
    }
    BoundsEvidence { bound: best, separation: obligation }
}

// Pure entailment for lattice operations never discharges assumptions.
bounds_direct_bound(state: ?*BoundsState, wanted: *BoundsNumericView) raises IndexOutOfBounds: int {
    evidence: BoundsEvidence = bounds_direct_evidence(state, wanted, false);
    evidence.bound
}

bounds_rows_identical(a: *BoundsRow, b: *BoundsRow): bool {
    a.kind == b.kind && a.index == b.index && a.array == b.array && a.value == b.value && a.left == b.left && a.right == b.right && a.separation == b.separation
}

// Fact tables copied at a branch retain a byte-for-byte prefix.
bounds_common_prefix(a: ?*BoundsState, b: ?*BoundsState, cap: int): int requires (0 <= cap) ensures (returned <= cap) {
    if (a == null || b == null) return 0;
    limit: int = if (a.count < b.count) a.count else b.count;
    if (limit > cap) limit = cap;
    if (a.storage == b.storage) return limit;
    position: int = 0;
    // Copies of a parent or sibling share a known prefix. Verify only the
    // remaining rows, and cap provenance by both snapshot lengths.
    first_storage: ?*BoundsStorage = a.storage;
    second_storage: ?*BoundsStorage = b.storage;
    if (first_storage != null && second_storage != null) {
        if (first_storage.prefix_source == second_storage) position = first_storage.prefix_count else if (second_storage.prefix_source == first_storage) position = second_storage.prefix_count else if (first_storage.prefix_source != null && first_storage.prefix_source == second_storage.prefix_source) position = (if (first_storage.prefix_count < second_storage.prefix_count) first_storage.prefix_count else second_storage.prefix_count)
    }
    if (position > limit) position = limit;
    for index in position..limit {
        first: ?*BoundsRow = bounds_row(a, index);
        second: ?*BoundsRow = bounds_row(b, index);
        if (first == null || second == null || !bounds_rows_identical(first, second)) return index
    }
    limit
}

// Reuse the weaker snapshot when every one of its facts survives a join.
bounds_subset_from(a: ?*BoundsState, b: ?*BoundsState, prefix: int) raises IndexOutOfBounds: bool {
    if (a == null) return true;
    if (a == b) return true;
    if (b == null) return bounds_count(a) == 0 && a.implications == null;
    if (bounds_count(a) > bounds_count(b)) return false;
    for position in prefix..bounds_count(a) {
        row: ?*BoundsRow = bounds_row(a, position);
        if (row != null && !bounds_has_indexed_fact(b, a, row, position)) return false
    }
    rule: ?*BoundsImplication = a.implications;
    while (rule != null) {
        if (!bounds_has_implication(b, rule)) return false;
        rule = rule.next
    }
    true
}

bounds_subset(a: ?*BoundsState, b: ?*BoundsState) raises IndexOutOfBounds: bool {
    if (!bounds_reachable(b)) return true;
    if (!bounds_reachable(a)) return false;
    cap: int = bounds_count(a);
    bounds_subset_from(a, b, bounds_common_prefix(a, b, cap))
}

bounds_meet(a: ?*BoundsState@new, b: ?*BoundsState) raises IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(a)) return b;
    if (!bounds_reachable(b)) return a;
    if (a == b) return a;
    if (a == null || b == null) return null;
    prefix: int = bounds_common_prefix(a, b, a.count);
    if (bounds_subset_from(a, b, prefix)) return a;
    if (bounds_subset_from(b, a, prefix)) return b;
    result: ?*BoundsState = bounds_empty(a);
    if (prefix > 0) {
        prefix_sums: int = 0;
        for index in 0..if (bounds_has_sum(a)) prefix else 0 {
            row0: ?*BoundsRow = bounds_row(a, index);
            if (row0 != null && row0.kind == BoundsKind.SumUpper) prefix_sums = prefix_sums + 1
        }
        result = new BoundsState {
            arena: a.arena,
            unreachable: false,
            storage: a.storage,
            rows_view: a.rows_view,
            numeric_view: a.numeric_view,
            count: prefix,
            sum_count: prefix_sums,
            implications: null
        }
    }
    position: int = prefix;
    while (position < bounds_count(a)) {
        row: ?*BoundsRow = bounds_row(a, position);
        if (row != null) {
            if (bounds_has_indexed_fact(b, a, row, position)) {
                if (!bounds_has_indexed_fact(result, a, row, position)) result = bounds_copy_from(result,
                    a, row, position)
            } else {
                edge: BoundsNumericView = bounds_numeric_at(a, position);
                if (edge.left.valid && edge.right.valid) {
                    other: int = bounds_direct_bound(b, &edge);
                    if (other < 1000000000) {
                        if (other > edge.bound) edge.bound = other;
                        left: BoundsTermRef = edge.left;
                        right: BoundsTermRef = edge.right;
                        joined: BoundsRow = BoundsRow {
                            index: row.index,
                            array: row.array,
                            kind: BoundsKind.Difference,
                            value: edge.bound,
                            left: bounds_ref_ast(left),
                            right: bounds_ref_ast(right),
                            separation: row.separation
                        };
                        if (!bounds_has_fact(result, &joined)) result = bounds_push(result,
                            joined)
                    }
                }
            }
        }
        position = position + 1
    }
    // If one predecessor survived intact, it already contains every fact
    // that the other can contribute at this join.
    if (bounds_count(result) < bounds_count(a) && bounds_count(result) < bounds_count(b)) {
        impossible: int = 0;
        result = bounds_join_project(a, b, result, &impossible);
        // Joining with an impossible predecessor retains the other state,
        // including implications that an ordinary intersection would drop.
        if (impossible == 1) return b;
        if (impossible == 2) return a
    }
    bounds_meet_implications(a, b, result)
}

bounds_same(a: ?*BoundsState, b: ?*BoundsState) raises IndexOutOfBounds: bool {
    if (bounds_reachable(a) != bounds_reachable(b)) return false;
    if (a == b) return true;
    if (!bounds_implications_same(a, b)) return false;
    if (a != null && b != null && a.storage == b.storage && a.count == b.count) return true;
    position: int = bounds_count(a) - 1;
    while (position >= 0) {
        row: ?*BoundsRow = bounds_row(a, position);
        if (row != null && !bounds_has_indexed_fact(b, a, row, position)) return false;
        position = position - 1
    }
    position = bounds_count(b) - 1;
    while (position >= 0) {
        row: ?*BoundsRow = bounds_row(b, position);
        if (row != null && !bounds_has_fact(a, row)) return false;
        position = position - 1
    }
    true
}

bounds_insert(
    state: ?*BoundsState@new,
    index: *Obj,
    array: ?*Obj,
    kind: BoundsKind,
    value: int,
    left: ?*Expr,
    right: ?*Expr,
    separation: ?*BoundsSeparation
) raises IndexOutOfBounds: *BoundsState@new {
    row: BoundsRow = BoundsRow {
        index: index,
        array: array,
        kind: kind,
        value: value,
        left: left,
        right: right,
        separation: separation
    };
    bounds_push(state, row)
}

// Loop headers use widening, not the branch join. Retain only inequalities
// whose previous bound survives the back edge. The set is finite and strictly
// decreases, so advancing cursors cannot cause an endless sequence of maxima.
bounds_widen(previous: ?*BoundsState@new, incoming: ?*BoundsState) raises IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_reachable(previous)) return incoming;
    if (!bounds_reachable(incoming)) return previous;
    if (bounds_subset(previous, incoming)) return previous;
    result: ?*BoundsState = bounds_empty(previous);
    position: int = bounds_count(previous) - 1;
    while (position >= 0) {
        row: ?*BoundsRow = bounds_row(previous, position);
        if (row != null && bounds_has_indexed_fact(incoming, previous, row, position)) result = bounds_copy_from(result,
            previous, row, position);
        position = position - 1
    }
    bounds_meet_implications(previous, incoming, result)
}

// Numeric views are cached alongside the source rows. Branch snapshots share
// the prefix, and appends update both arrays together.
bounds_numeric_at(state: ?*BoundsState, position: int) raises IndexOutOfBounds: BoundsNumericView {
    if (state != null && position >= 0 && position < state.count) return state.numeric_view[position];
    bounds_numeric_query(null, null, 0)
}

// Borrow a cached descriptor for read-only use until the arena resets. Respect
// the snapshot count even when a sibling has appended to the same storage.
bounds_numeric_ref(state: ?*BoundsState, position: int): ?*BoundsNumericView@state {
    if (state != null && position >= 0 && position < state.count) return &state.numeric_view[position];
    null
}

bounds_pair_hash(edge: *BoundsNumericView): int {
    bounds_term_hash_borrowed(&edge.left) * 33 + bounds_term_hash_borrowed(&edge.right) & 2147483647
}

bounds_row_hash(row: *BoundsRow, edge: *BoundsNumericView): int {
    if (edge.left.valid && edge.right.valid) return bounds_pair_hash(edge);
    row.index.browse_id * 33 & 2147483647
}

bounds_bucket(state: ?*BoundsState, hash: int): ?*BoundsLinkNode@state {
    if (state == null) return null;
    storage: ?*BoundsStorage = state.storage;
    if (storage == null) return null;
    slots: []?*BoundsLinkNode = storage.buckets;
    slots[hash & len(slots) - 1]
}

// Rewrite difference edges when a cursor is replaced by its old value plus
// a proven constant. This is the compact equivalent of an SSA old-value node.
bounds_shift_value(f: ?*BoundsState@new, value: *Obj@new, offset: int) raises IndexOutOfBounds: ?*BoundsState@new {
    head: ?*BoundsState = bounds_kill(f, value);
    q_position: int = bounds_count(f) - 1;
    q: ?*BoundsRow = bounds_row(f, q_position);
    while (q != null) {
        if (offset >= 0 && q.kind == BoundsKind.SumUpper && q.index == value) {
            sum: ?*Expr = q.left;
            limit: ?*Expr = q.right;
            if (sum != null && limit != null && bounds_term_root(limit) != value) {
                match sum.kind {
                    Binary add -> {
                        if (add.op == BinOp.Add && bounds_var(add.lhs) == value && bounds_term_root(add.rhs) != value && bounds_difference_proves(f,
                            new_num(offset), add.rhs, 0)) head = bounds_add_order(head,
                            bounds_obj_expr(value), limit, false)
                    }
                    _ -> { }
                }
            }
        }
        if (q.kind == BoundsKind.Cursor && q.index == value) {
            next_offset: int = q.value + offset;
            if (next_offset >= 0 && next_offset < 536870912) head = bounds_add_value(head,
                value, q.array, BoundsKind.Cursor, next_offset)
        }
        edge: BoundsNumericView = bounds_numeric_at(f, q_position);
        if (edge.left.valid && edge.right.valid && edge.separation == null) {
            left: BoundsTermRef = edge.left;
            right: BoundsTermRef = edge.right;
            self: BoundsTermRef = bounds_ref_obj(value, false);
            left_self: bool = bounds_ref_same(left, self);
            right_self: bool = bounds_ref_same(right, self);
            if (left_self != right_self) {
                weight: int = if (left_self) edge.bound + offset else edge.bound - offset;
                left_ast: ?*Expr = bounds_ref_ast(left);
                right_ast: ?*Expr = bounds_ref_ast(right);
                if (left_ast != null && right_ast != null) head = bounds_add_relation(head,
                    left_ast, right_ast, weight)
            }
        }
        q_position = q_position - 1;
        q = bounds_row(f, q_position)
    }
    head
}

// Existentially eliminate the old scalar value before overwriting it. From
// left - old <= lower and old - right <= upper, retain left - right <= their
// sum. Merely deleting edges through old loses facts between unchanged values.
// Only unconditional edges participate; no new alias obligation is inferred.
bounds_forget_scalar(f: ?*BoundsState@new, value: *Obj) raises IndexOutOfBounds: ?*BoundsState@new {
    result: ?*BoundsState = bounds_kill(f, value);
    if (!is_int_ty(value.ty)) return result;
    self: BoundsTermRef = bounds_ref_obj(value, false);
    for i in 0..bounds_count(f) {
        upper: BoundsNumericView = bounds_numeric_at(f, i);
        upper_left: BoundsTermRef = upper.left;
        upper_right: BoundsTermRef = upper.right;
        if (upper.left.valid && upper.right.valid && upper.bound > -536870912 && upper.bound < 536870912 && upper.separation == null && bounds_ref_same(upper_left,
            self) && !bounds_ref_same(upper_right, self)) {
            for j in 0..bounds_count(f) {
                lower: BoundsNumericView = bounds_numeric_at(f, j);
                lower_left: BoundsTermRef = lower.left;
                lower_right: BoundsTermRef = lower.right;
                if (lower.left.valid && lower.right.valid && lower.bound > -536870912 && lower.bound < 536870912 && lower.separation == null && bounds_ref_same(lower_right,
                    self) && !bounds_ref_same(lower_left, self) && !bounds_ref_same(lower_left,
                    upper_right)) {
                    // Both operands are bounded in magnitude, so addition cannot wrap.
                    weight: int = upper.bound + lower.bound;
                    if (weight > -536870912 && weight < 536870912) {
                        left: ?*Expr = bounds_ref_ast(lower_left);
                        right: ?*Expr = bounds_ref_ast(upper_right);
                        if (left == null) left = new_num(0);
                        if (right == null) right = new_num(0);
                        query: BoundsNumericView = bounds_numeric_query(left, right,
                            weight);
                        if (bounds_direct_bound(result, &query) > query.bound) result = bounds_add_relation(result,
                            left, right, weight)
                    }
                }
            }
        }
    }
    result
}
