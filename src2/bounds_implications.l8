tag compiler_internal;

// Implications contain ordinary verifier facts. The premise list is a
// conjunction, and closure adds a conclusion only after proving every premise.
bounds_implication_fact(f: ?*BoundsState, fact: *BoundsRow) raises IndexOutOfBounds: bool {
    left: ?*Expr = fact.left;
    right: ?*Expr = fact.right;
    if (left == null || right == null) return false;
    if (fact.kind == BoundsKind.Difference) return bounds_difference_proves(f, left,
        right, fact.value);
    if (fact.kind == BoundsKind.SumUpper) return bounds_has_fact(f, fact);
    if (fact.kind == BoundsKind.Equal || fact.kind == BoundsKind.NotEqual) return bounds_scalar_proves(f,
        left, right, fact.kind);
    false
}

bounds_implication_ready(f: ?*BoundsState, rule: *BoundsImplication) raises IndexOutOfBounds: bool {
    premise: ?*BoundsPremise = rule.premises;
    while (premise != null) {
        if (!bounds_implication_fact(f, &premise.fact)) return false;
        premise = premise.next
    }
    true
}

bounds_implication_needs_scalar(f: ?*BoundsState, value: *Expr) raises IndexOutOfBounds: bool {
    if (f == null) return false;
    rule: ?*BoundsImplication = f.implications;
    while (rule != null) {
        premise: ?*BoundsPremise = rule.premises;
        while (premise != null) {
            left: ?*Expr = premise.fact.left;
            right: ?*Expr = premise.fact.right;
            if (left != null && bounds_same_scalar(left, value) || right != null && bounds_same_scalar(right,
                value)) return true;
            premise = premise.next
        }
        rule = rule.next
    }
    false
}

bounds_close_implications(f: ?*BoundsState@new) raises IndexOutOfBounds: ?*BoundsState@f {
    if (f == null) return f;
    changing: bool = true;
    while (changing) {
        changing = false;
        rule: ?*BoundsImplication = f.implications;
        while (rule != null) {
            if (bounds_implication_ready(f, rule) && !bounds_implication_fact(f, &rule.consequence)) {
                before: int = bounds_count(f);
                f = bounds_push(f, rule.consequence);
                if (bounds_count(f) != before) changing = true
            }
            rule = rule.next
        }
    }
    f
}

bounds_direct_call_ready(
    rule: *BoundsImplication@new,
    callee: *Function,
    args: ?*Expr@new,
    value: *Expr,
    f: ?*BoundsState
) raises IndexOutOfBounds: bool {
    premise: ?*BoundsPremise = rule.premises;
    while (premise != null) {
        fact: *BoundsRow = &premise.fact;
        left: ?*Expr = fact.left;
        right: ?*Expr = fact.right;
        if (left == null || right == null) return false;
        if (fact.kind == BoundsKind.Equal || fact.kind == BoundsKind.NotEqual) {
            literal: ?*Expr = null;
            if (bounds_var(left) == callee.bounds_result) literal = right else if (bounds_var(right) == callee.bounds_result) literal = left;
            if (literal != null && bounds_scalar_constant(literal)) {
                matches: bool = bounds_same_scalar(value, literal);
                if (fact.kind == BoundsKind.Equal && !matches || fact.kind == BoundsKind.NotEqual && matches) return false
            } else {
                mapped_left: ?*Expr = bounds_implication_map_term(left, callee, args,
                    value);
                mapped_right: ?*Expr = bounds_implication_map_term(right, callee,
                    args, value);
                if (mapped_left == null || mapped_right == null || !bounds_scalar_proves(f,
                    mapped_left, mapped_right, fact.kind)) return false
            }
        } else {
            mapped: ?*BoundsRow = bounds_implication_map_fact(fact, callee, args,
                value);
            if (mapped == null || !bounds_implication_fact(f, mapped)) return false
        }
        premise = premise.next
    }
    true
}

bounds_rule_tests_result(rule: *BoundsImplication, result: ?*Obj): bool {
    premise: ?*BoundsPremise = rule.premises;
    while (premise != null) {
        left: ?*Expr = premise.fact.left;
        right: ?*Expr = premise.fact.right;
        if (left != null && bounds_term_root(left) == result || right != null && bounds_term_root(right) == result) return true;
        premise = premise.next
    }
    false
}

bounds_call_condition(call: *Expr, yes: bool, f: ?*BoundsState@new) raises IndexOutOfBounds: ?*BoundsState@f {
    match call.kind {
        Funcall k -> {
            callee: ?*Function = k.fn;
            if (callee == null || k.target != null || !is_bool_ty(call.ty)) return f;
            value: *Expr = bounds_bool_literal(yes);
            f = bounds_apply_ensures(callee, k.args, value, f);
            rule: ?*BoundsImplication = callee.bounds_implications;
            while (rule != null) {
                if (bounds_rule_tests_result(rule, callee.bounds_result) && bounds_direct_call_ready(rule,
                    callee, k.args, value, f)) {
                    mapped: ?*BoundsRow = bounds_implication_map_fact(&rule.consequence,
                        callee, k.args, value);
                    if (mapped != null) f = bounds_push(f, mapped.*)
                }
                rule = rule.next
            }
            bounds_close_implications(f)
        }
        _ -> f
    }
}

bounds_implication_map_term(
    e: *Expr@new,
    fn: *Function,
    args: ?*Expr@new,
    destination: *Expr
) raises IndexOutOfBounds: ?*Expr@new {
    root: ?*Obj = bounds_term_root(e);
    if (root != null && root == fn.bounds_result) return bounds_rebase_path(e, bounds_obj_expr(root),
        destination);
    match e.kind {
        Null -> {
            copied: *Expr = mk_expr(e.kind);
            copied.ty = e.ty;
            copied
        }
        VariantLit k -> {
            if (k.inits != null) return null;
            copied: *Expr = mk_expr(e.kind);
            copied.ty = e.ty;
            copied
        }
        Num _ -> bounds_clone_path(e);
        _ -> bounds_return_map(e, fn, args)
    }
}

bounds_fold_length(e: *Expr@new): *Expr@new {
    copied: *Expr = mk_expr(e.kind);
    copied.ty = e.ty;
    match e.kind {
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return copied;
            arg: ?*Expr = k.args;
            if (arg == null) return copied;
            if (arg.next != null) return copied;
            known: int = bounds_known_len(arg);
            if (known >= 0) return new_num(known);
            copied
        }
        _ -> copied
    }
}

bounds_implication_map_fact(
    fact: *BoundsRow@new,
    fn: *Function,
    args: ?*Expr@new,
    destination: *Expr
) raises IndexOutOfBounds: ?*BoundsRow@new {
    left: ?*Expr = fact.left;
    right: ?*Expr = fact.right;
    if (left == null || right == null || fact.separation != null) return null;
    if (fact.kind != BoundsKind.Difference && fact.kind != BoundsKind.SumUpper && fact.kind != BoundsKind.Equal && fact.kind != BoundsKind.NotEqual) return null;
    mapped_left: ?*Expr = null;
    if (fact.kind == BoundsKind.SumUpper) {
        match left.kind {
            Binary sum -> {
                if (sum.op != BinOp.Add) return null;
                base: ?*Expr = bounds_implication_map_term(sum.lhs, fn, args, destination);
                part: ?*Expr = bounds_implication_map_term(sum.rhs, fn, args, destination);
                if (base == null || part == null) return null;
                mapped_left = new_binary(BinOp.Add, base, bounds_fold_length(part))
            }
            _ -> return null
        }
    } else mapped_left = bounds_implication_map_term(left, fn, args, destination);
    mapped_right: ?*Expr = bounds_implication_map_term(right, fn, args, destination);
    if (mapped_left == null || mapped_right == null) return null;
    if (fact.kind == BoundsKind.SumUpper) mapped_right = bounds_fold_length(mapped_right);
    if (fact.kind == BoundsKind.SumUpper) {
        match mapped_left.kind {
            Binary sum -> {
                if (!bounds_term(sum.lhs) || !bounds_term(sum.rhs) && bounds_num(sum.rhs) < 0 || !bounds_term(mapped_right) && bounds_num(mapped_right) < 0) return null;
                base: ?*Obj = bounds_term_root(sum.lhs);
                part: ?*Obj = bounds_term_root(sum.rhs);
                if (base == null) return null;
                return new BoundsRow {
                    index: base,
                    array: part,
                    kind: fact.kind,
                    value: fact.value,
                    left: mapped_left,
                    right: mapped_right,
                    separation: null
                }
            }
            _ -> return null
        }
    }
    first: ?*Obj = bounds_term_root(mapped_left);
    second: ?*Obj = bounds_term_root(mapped_right);
    if (first == null) {
        first = second;
        second = null
    } else {
        current: *Obj = first;
        if (second != null) {
            if (second.browse_id < current.browse_id) {
                first = second;
                second = current
            }
        }
    }
    if (first == null) return null;
    if (first == second) second = null;
    new BoundsRow {
        index: first,
        array: second,
        kind: fact.kind,
        value: fact.value,
        left: mapped_left,
        right: mapped_right,
        separation: null
    }
}

bounds_implication_map(
    rule: *BoundsImplication@new,
    fn: *Function,
    args: ?*Expr@new,
    destination: *Expr
) raises IndexOutOfBounds: ?*BoundsImplication@new {
    consequence: ?*BoundsRow = bounds_implication_map_fact(&rule.consequence, fn,
        args, destination);
    if (consequence == null) return null;
    premises: ?*BoundsPremise = null;
    current: ?*BoundsPremise = rule.premises;
    while (current != null) {
        mapped: ?*BoundsRow = bounds_implication_map_fact(&current.fact, fn, args,
            destination);
        if (mapped == null) return null;
        premises = new BoundsPremise { fact: mapped.*, next: premises };
        current = current.next
    }
    new BoundsImplication { premises: premises, consequence: consequence.*, next: null }
}

// Guarantees use the return value and parameter values at entry. The same
// comparison prover checks them at exits and adds them at call sites.
bounds_ensure_source_term(e: *Expr, fn: *Function) raises IndexOutOfBounds: bool {
    match e.kind {
        Num _ -> true;
        Null -> true;
        VariantLit k -> k.inits == null;
        Var k -> {
            v: ?*Obj = k.var;
            v != null && (v == fn.bounds_result || bounds_param(fn, v) || v.is_const && v.const_state == 2 && is_int_ty(v.ty))
        }
        MemberAccess k -> bounds_ensure_source_term(k.lhs, fn);
        Index k -> bounds_ensure_source_term(k.lhs, fn) && bounds_ensure_source_term(k.idx,
            fn);
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return false;
            arg: ?*Expr = k.args;
            if (arg == null) return false;
            if (arg.next != null) return false;
            bounds_term(arg) && bounds_ensure_source_term(arg, fn)
        }
        Binary k -> {
            if (k.op != BinOp.Add && k.op != BinOp.Sub) return false;
            if (k.op == BinOp.Sub && bounds_ensure_source_term(k.rhs, fn)) return bounds_ensure_source_term(k.lhs,
                fn);
            c: int = bounds_num(k.rhs);
            c >= 0 && c < 536870912 && bounds_ensure_source_term(k.lhs, fn)
        }
        _ -> false
    }
}

// Both contract clauses write comparisons that the ordinary fact domain can
// prove and assume. Each clause checks that its terms are available at its
// boundary; a guarantee may also refer to the return value.
bounds_contract_valid(e: *Expr, fn: *Function, guarantee: bool) raises IndexOutOfBounds: bool {
    match e.kind {
        LogAnd k -> bounds_contract_valid(k.lhs, fn, guarantee) && bounds_contract_valid(k.rhs,
            fn, guarantee);
        Binary k -> {
            if (guarantee && (!bounds_ensure_source_term(k.lhs, fn) || !bounds_ensure_source_term(k.rhs,
                fn))) return false;
            scalar: bool = if (guarantee) bounds_scalar_term(k.lhs) && bounds_scalar_term(k.rhs) else bounds_precondition_scalar_term(k.lhs,
                fn) && bounds_precondition_scalar_term(k.rhs, fn);
            numeric: bool = if (guarantee) is_int_ty(k.lhs.ty) && is_int_ty(k.rhs.ty) else bounds_precondition_term(k.lhs,
                fn) && bounds_precondition_term(k.rhs, fn);
            if (k.op == BinOp.Eq) return scalar || numeric;
            if (k.op == BinOp.Ne) return scalar || !guarantee && numeric;
            if (k.op != BinOp.Lt && k.op != BinOp.Le && k.op != BinOp.Gt && k.op != BinOp.Ge) return false;
            numeric
        }
        _ -> false
    }
}

bounds_ensure_valid(e: *Expr, fn: *Function) raises IndexOutOfBounds: bool {
    bounds_contract_valid(e, fn, true)
}

bounds_ensure_mentions(e: *Expr, param: *Obj): bool {
    match e.kind {
        Var k -> k.var == param;
        Funcall k -> {
            arg: ?*Expr = k.args;
            arg != null && bounds_ensure_mentions(arg, param)
        }
        Binary k -> bounds_ensure_mentions(k.lhs, param) || bounds_ensure_mentions(k.rhs,
            param);
        LogAnd k -> bounds_ensure_mentions(k.lhs, param) || bounds_ensure_mentions(k.rhs,
            param);
        _ -> false
    }
}

bounds_ensure_map_term(
    fn: *Function,
    e: *Expr@new,
    args: ?*Expr@new,
    destination: *Expr@new,
    at_call: bool
) raises IndexOutOfBounds: ?*Expr@new {
    match e.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return null;
            if (v.is_const && v.const_state == 2 && is_int_ty(v.ty)) return new_num(v.const_val);
            if (v == fn.bounds_result) return bounds_clone_path(destination);
            if (!bounds_param(fn, v)) return null;
            if (at_call) {
                actual: ?*Expr = bounds_arg_named(fn, args, v.name);
                if (actual == null || !bounds_pure_condition(actual)) return null;
                return bounds_return_map(bounds_obj_expr(v), fn, args)
            }
            entry: ?*Obj = v.bounds_entry;
            if (entry != null) return bounds_obj_expr(entry);
            if (v.bounds_written || v.bounds_addr_taken) return null;
            bounds_obj_expr(v)
        }
        MemberAccess k -> {
            base: ?*Expr = bounds_ensure_map_term(fn, k.lhs, args, destination, at_call);
            if (base == null) return null;
            member: *Expr = mk_expr(ExprKind.MemberAccess { lhs: base, name: k.name, member: k.member });
            member.ty = e.ty;
            member
        }
        Index k -> {
            base: ?*Expr = bounds_ensure_map_term(fn, k.lhs, args, destination, at_call);
            position: ?*Expr = bounds_ensure_map_term(fn, k.idx, args, destination,
                at_call);
            if (base == null || position == null) return null;
            element: *Expr = mk_expr(ExprKind.Index { lhs: base, idx: position, checked: k.checked });
            element.ty = e.ty;
            element
        }
        Num _ -> bounds_clone_path(e);
        Null -> new_null_expr();
        VariantLit k -> {
            if (k.inits != null) return null;
            copied: *Expr = mk_expr(e.kind);
            copied.ty = e.ty;
            copied
        }
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return null;
            arg: ?*Expr = k.args;
            if (arg == null) return null;
            if (arg.next != null) return null;
            mapped: ?*Expr = bounds_ensure_map_term(fn, arg, args, destination, at_call);
            if (mapped == null) return null;
            bounds_len_term(mapped)
        }
        Binary k -> {
            if (k.op != BinOp.Add && k.op != BinOp.Sub) return null;
            if (k.op == BinOp.Sub) {
                lhs: ?*Expr = bounds_ensure_map_term(fn, k.lhs, args, destination,
                    at_call);
                rhs: ?*Expr = bounds_ensure_map_term(fn, k.rhs, args, destination,
                    at_call);
                if (lhs == null || rhs == null) return null;
                mapped_span: *Expr = new_binary(BinOp.Sub, lhs, rhs);
                mapped_span.ty = e.ty;
                return mapped_span
            }
            c: int = bounds_num(k.rhs);
            if (c < 0 || c >= 536870912) return null;
            lhs2: ?*Expr = bounds_ensure_map_term(fn, k.lhs, args, destination, at_call);
            if (lhs2 == null) return null;
            mapped: *Expr = new_binary(k.op, lhs2, new_num(c));
            mapped.ty = e.ty;
            mapped
        }
        _ -> null
    }
}

bounds_ensure_map(
    fn: *Function,
    e: *Expr@new,
    args: ?*Expr@new,
    destination: *Expr@new,
    at_call: bool
) raises IndexOutOfBounds: ?*Expr@new {
    match e.kind {
        LogAnd k -> {
            left: ?*Expr = bounds_ensure_map(fn, k.lhs, args, destination, at_call);
            right: ?*Expr = bounds_ensure_map(fn, k.rhs, args, destination, at_call);
            if (left == null || right == null) return null;
            mapped: *Expr = mk_expr(ExprKind.LogAnd { lhs: left, rhs: right });
            mapped.ty = e.ty;
            mapped
        }
        Binary k -> {
            left: ?*Expr = bounds_ensure_map_term(fn, k.lhs, args, destination, at_call);
            right: ?*Expr = bounds_ensure_map_term(fn, k.rhs, args, destination, at_call);
            if (left == null || right == null) return null;
            mapped: *Expr = new_binary(k.op, left, right);
            mapped.ty = e.ty;
            mapped
        }
        _ -> null
    }
}

bounds_prepare_ensures(fn: *Function@new) noregion {
    guarantee: ?*Expr = fn.bounds_ensures;
    if (guarantee == null) return;
    param: ?*Obj = fn.params;
    while (param != null) {
        ty: ?*Type = param.ty;
        if (ty != null && bounds_scalar_type(ty) && param.bounds_entry == null && bounds_ensure_mentions(guarantee,
            param)) {
            saved_locals: ?*Obj = locals;
            saved_scope: ?*Obj = scope_locals;
            entry: *Obj = new_obj("$bounds_entry", true);
            locals = saved_locals;
            scope_locals = saved_scope;
            entry.ty = param.ty;
            param.bounds_entry = entry
        }
        param = param.param_next
    }
}

bounds_check_ensures(fn: *Function@new, value: ?*Expr@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds {
    guarantee: ?*Expr = fn.bounds_ensures;
    if (guarantee == null) return;
    destination: ?*Obj = fn.bounds_result;
    if (destination == null && value != null) destination = bounds_result_anchor(fn);
    if (destination == null) error_at_file(fn.browse_file, fn.browse_pos, "function guarantee needs a return value");
    result: *Expr = bounds_obj_expr(destination);
    if (value != null) {
        f = bounds_value_facts(result, value, f);
        if (bounds_scalar_constant(value)) f = bounds_add_scalar_relation(f, result,
            value, BoundsKind.Equal)
    }
    if (!bounds_contract_indices_proved(guarantee, f)) error_at_file(guarantee.file,
        guarantee.pos, "function guarantee has an unproved array access");
    mapped: ?*Expr = bounds_ensure_map(fn, guarantee, null, result, false);
    if (mapped == null) error_at_file(guarantee.file, guarantee.pos, "function guarantee needs stable parameter values");
    if (!bounds_precondition_proved(mapped, f)) {
        if (value != null) error_at_file(value.file, value.pos, "function guarantee is not proved") else error_at_file(fn.browse_file,
            fn.browse_pos, "function guarantee is not proved")
    }
}

bounds_apply_ensures(
    fn: *Function@new,
    args: ?*Expr@new,
    destination: *Expr@new,
    f: ?*BoundsState@new
) raises IndexOutOfBounds: ?*BoundsState@new {
    guarantee: ?*Expr = fn.bounds_ensures;
    if (guarantee == null) return f;
    mapped: ?*Expr = bounds_ensure_map(fn, guarantee, args, destination, true);
    if (mapped == null) return f;
    bounds_condition(mapped, true, f)
}

bounds_guard_add(fn: *Function@new, literal: *Expr) noregion raises IndexOutOfBounds {
    if (!bounds_scalar_constant(literal) || !bounds_scalar_term(literal)) return;
    copied: ?*Expr = null;
    match literal.kind {
        Num k -> {
            n: *Expr = mk_expr(ExprKind.Num {
                val: k.val,
                str_label: 0,
                form: k.form,
                spell: ""
            });
            n.ty = fn.return_ty;
            copied = n
        }
        Null -> copied = new_null_expr();
        VariantLit k -> {
            ty: ?*Type = fn.return_ty;
            if (ty != null) {
                match ty.* {
                    Enum et -> {
                        variant: ?*Variant = et.def.variants;
                        searching: bool = true;
                        while (variant != null && searching) {
                            if (variant.tag == k.val) searching = false else variant = variant.next
                        }
                        if (variant != null) copied = new_variant_lit("", "", variant,
                            k.val, null, ty)
                    }
                    _ -> { }
                }
            }
        }
        _ -> { }
    }
    if (copied == null) return;
    anchor: *Obj = bounds_result_anchor(fn);
    q: ?*BoundsGuardFacts = bounds_guards;
    while (q != null) {
        known: ?*Expr = q.literal;
        if (known != null && bounds_same_scalar(known, copied)) return;
        q = q.next
    }
    premise: BoundsRow = BoundsRow {
        index: anchor,
        array: null,
        kind: BoundsKind.Equal,
        value: 0,
        left: bounds_obj_expr(anchor),
        right: copied,
        separation: null
    };
    bounds_guards = new BoundsGuardFacts {
        premise: premise,
        literal: copied,
        facts: null,
        seen: false,
        next: bounds_guards
    }
}

bounds_guard_param_term(fn: *Function@new, e: *Expr) raises IndexOutOfBounds: ?*Expr@new {
    match e.kind {
        Num k -> new_num(k.val);
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return null;
            param: ?*Obj = fn.params;
            while (param != null) {
                if (param == v && !param.bounds_written && !param.bounds_addr_taken) return bounds_obj_expr(param);
                param = param.param_next
            }
            null
        }
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return null;
            arg: ?*Expr = k.args;
            if (arg == null) return null;
            if (arg.next != null) return null;
            mapped: ?*Expr = bounds_guard_param_term(fn, arg);
            if (mapped == null) return null;
            bounds_len_term(mapped)
        }
        _ -> null
    }
}

bounds_guard_observed(
    fn: *Function@new,
    source_left: *Expr,
    source_right: *Expr,
    bound: int
) noregion raises IndexOutOfBounds {
    if (!is_int_ty(fn.return_ty)) return;
    mapped_left: ?*Expr = bounds_guard_param_term(fn, source_left);
    mapped_right: ?*Expr = bounds_guard_param_term(fn, source_right);
    if (mapped_left == null || mapped_right == null) return;
    left: *Expr = mapped_left;
    right: *Expr = mapped_right;
    first: ?*Obj = bounds_term_root(left);
    second: ?*Obj = bounds_term_root(right);
    if (first == null) {
        first = second;
        second = null
    }
    if (first == null) return;
    if (first == second) second = null;
    _anchor: *Obj = bounds_result_anchor(fn);
    row: BoundsRow = BoundsRow {
        index: first,
        array: second,
        kind: BoundsKind.Difference,
        value: bound,
        left: left,
        right: right,
        separation: null
    };
    q: ?*BoundsGuardFacts = bounds_guards;
    input_guards: int = 0;
    while (q != null) {
        if (bounds_row_same(&q.premise, &row)) return;
        if (q.literal == null) input_guards = input_guards + 1;
        q = q.next
    }
    if (input_guards >= BOUNDS_SUMMARY_INPUT_GUARDS) return;
    bounds_guards = new BoundsGuardFacts {
        premise: row,
        literal: null,
        facts: null,
        seen: false,
        next: bounds_guards
    }
}

bounds_guard_condition(fn: *Function@new, e: *Expr) noregion raises IndexOutOfBounds {
    // A source comparison suggests a useful premise. Both outcomes are
    // candidates; return analysis keeps a rule only when every compatible
    // successful exit proves its conclusion.
    match e.kind {
        Not k -> bounds_guard_condition(fn, k.lhs);
        LogAnd k -> {
            bounds_guard_condition(fn, k.lhs);
            bounds_guard_condition(fn, k.rhs)
        }
        LogOr k -> {
            bounds_guard_condition(fn, k.lhs);
            bounds_guard_condition(fn, k.rhs)
        }
        Binary k -> {
            if (k.op == BinOp.Lt) {
                bounds_guard_observed(fn, k.lhs, k.rhs, -1);
                bounds_guard_observed(fn, k.rhs, k.lhs, 0)
            } else if (k.op == BinOp.Le) {
                bounds_guard_observed(fn, k.lhs, k.rhs, 0);
                bounds_guard_observed(fn, k.rhs, k.lhs, -1)
            } else if (k.op == BinOp.Gt) {
                bounds_guard_observed(fn, k.rhs, k.lhs, -1);
                bounds_guard_observed(fn, k.lhs, k.rhs, 0)
            } else if (k.op == BinOp.Ge) {
                bounds_guard_observed(fn, k.rhs, k.lhs, 0);
                bounds_guard_observed(fn, k.lhs, k.rhs, -1)
            }
        }
        _ -> { }
    }
}

bounds_guard_scan(fn: *Function@new, s: ?*Stmt) noregion raises IndexOutOfBounds {
    q: ?*Stmt = s;
    while (q != null) {
        match q.kind {
            Return k -> {
                value: ?*Expr = k.lhs;
                if (value != null) bounds_guard_add(fn, value)
            }
            ExprStmt _ -> { }
            Block k -> bounds_guard_scan(fn, k.body);
            Region k -> bounds_guard_scan(fn, k.body);
            If k -> {
                bounds_guard_condition(fn, k.cond);
                bounds_guard_scan(fn, k.then);
                bounds_guard_scan(fn, k.els)
            }
            While k -> {
                bounds_guard_condition(fn, k.cond);
                bounds_guard_scan(fn, k.body)
            }
            For k -> bounds_guard_scan(fn, k.body);
            Match k -> {
                arm: ?*MatchArm = k.arms;
                while (arm != null) {
                    bounds_guard_scan(fn, arm.body);
                    arm = arm.next
                }
            }
            Try k -> {
                bounds_guard_scan(fn, k.body);
                arm: ?*CatchArm = k.arms;
                while (arm != null) {
                    bounds_guard_scan(fn, arm.body);
                    arm = arm.next
                }
            }
            _ -> { }
        }
        q = q.next
    }
}

bounds_prepare_implications(fn: *Function@new) noregion raises IndexOutOfBounds {
    bounds_guards = null;
    if (fn.return_ty == null) return;
    bounds_guard_scan(fn, fn.body);
    body: ?*Stmt = fn.body;
    if (body != null) {
        match body.kind {
            Block k -> {
                last: ?*Stmt = bounds_last_stmt(k.body);
                if (last != null) {
                    match last.kind {
                        ExprStmt item -> bounds_guard_add(fn, item.lhs);
                        _ -> { }
                    }
                }
            }
            ExprStmt item -> bounds_guard_add(fn, item.lhs);
            _ -> { }
        }
    }
}

bounds_implication_record(guard: *BoundsGuardFacts@new, row: BoundsRow@new) raises IndexOutOfBounds {
    // Budgets affect precision only. No unproved row enters a summary.
    q: ?*BoundsSummaryFact = guard.facts;
    count: int = 0;
    while (q != null) {
        if (bounds_row_same(&q.fact, &row)) return;
        count = count + 1;
        q = q.next
    }
    if (count >= BOUNDS_SUMMARY_FACTS_PER_GUARD) return;
    guard.facts = new BoundsSummaryFact { fact: row, next: guard.facts }
}

bounds_implication_candidate(guard: *BoundsGuardFacts@new, f: ?*BoundsState, row: BoundsRow@new) raises IndexOutOfBounds {
    if (bounds_row_same(&guard.premise, &row)) return;
    if (bounds_implication_fact(f, &row)) bounds_implication_record(guard, row)
}

bounds_implication_opposite(f: ?*BoundsState, row: *BoundsRow) raises IndexOutOfBounds: bool {
    left: ?*Expr = row.left;
    right: ?*Expr = row.right;
    if (left == null || right == null) return false;
    if (row.kind == BoundsKind.Difference) return bounds_difference_proves(f, right,
        left, 0 - row.value - 1);
    if (row.kind == BoundsKind.Equal) return bounds_scalar_proves(f, left, right,
        BoundsKind.NotEqual);
    if (row.kind == BoundsKind.NotEqual) return bounds_scalar_proves(f, left, right,
        BoundsKind.Equal);
    false
}

bounds_implication_exit_fact(
    f: ?*BoundsState,
    value: *Expr,
    anchor: ?*Obj,
    row: *BoundsRow
) raises IndexOutOfBounds: bool {
    left: ?*Expr = row.left;
    right: ?*Expr = row.right;
    if (left == null || right == null) return false;
    if (row.kind == BoundsKind.Difference) {
        if (bounds_var(left) == anchor) return bounds_return_bound(f, value, right) <= row.value;
        if (bounds_var(right) == anchor) return bounds_return_bound(f, left, value) <= row.value
    }
    bounds_implication_fact(f, row)
}

bounds_implication_numeric_candidates(fn: *Function@new, guard: *BoundsGuardFacts@new,
    f: ?*BoundsState) raises IndexOutOfBounds {
    // Project proved rows whose terms still denote caller-visible values.
    // A numeric literal is treated like any other term; a difference row's
    // bound carries its offset after normalization.
    for position in 0..bounds_count(f) {
        row: ?*BoundsRow = bounds_row(f, position);
        if (row != null) {
            if (row.kind == BoundsKind.SumUpper) {
                source_sum: ?*Expr = row.left;
                source_limit: ?*Expr = row.right;
                if (source_sum != null && source_limit != null)
                    match source_sum.kind {
                        Binary sum -> {
                            base: ?*Expr = bounds_guard_param_term(fn, sum.lhs);
                            part: ?*Expr = bounds_guard_param_term(fn, sum.rhs);
                            limit: ?*Expr = bounds_guard_param_term(fn, source_limit);
                            if (base != null && part != null && limit != null) {
                                root: ?*Obj = bounds_term_root(base);
                                other: ?*Obj = bounds_term_root(part);
                                if (root != null && other != null) {
                                    candidate: BoundsRow = BoundsRow {
                                        index: root,
                                        array: other,
                                        kind: BoundsKind.SumUpper,
                                        value: row.value,
                                        left: new_binary(BinOp.Add, base, part),
                                        right: limit,
                                        separation: null
                                    };
                                    bounds_implication_candidate(guard, f, candidate)
                                }
                            }
                        }
                        _ -> { }
                    }
            }
            if ((row.kind == BoundsKind.Difference || row.kind == BoundsKind.Equal || row.kind == BoundsKind.NotEqual) && row.separation == null) {
                source_left: ?*Expr = row.left;
                source_right: ?*Expr = row.right;
                if (source_left != null && source_right != null) {
                    left: ?*Expr = bounds_guard_param_term(fn, source_left);
                    right: ?*Expr = bounds_guard_param_term(fn, source_right);
                    if (left != null && right != null) {
                        first: ?*Obj = bounds_term_root(left);
                        second: ?*Obj = bounds_term_root(right);
                        if (first == null) {
                            first = second;
                            second = null
                        }
                        if (first != null) {
                            candidate: BoundsRow = BoundsRow {
                                index: first,
                                array: second,
                                kind: row.kind,
                                value: row.value,
                                left: left,
                                right: right,
                                separation: null
                            };
                            bounds_implication_candidate(guard, f, candidate)
                        }
                    }
                }
            }
        }
    }
}

bounds_implication_scalar_literal(
    guard: *BoundsGuardFacts@new,
    f: ?*BoundsState,
    param: *Obj@new,
    literal: *Expr
) raises IndexOutOfBounds {
    path: *Expr = bounds_obj_expr(param);
    equal: BoundsRow = BoundsRow {
        index: param,
        array: null,
        kind: BoundsKind.Equal,
        value: 0,
        left: path,
        right: literal,
        separation: null
    };
    different: BoundsRow = equal;
    different.kind = BoundsKind.NotEqual;
    bounds_implication_candidate(guard, f, equal);
    bounds_implication_candidate(guard, f, different)
}

bounds_implication_scalar_candidates(fn: *Function@new, guard: *BoundsGuardFacts@new,
    f: ?*BoundsState) raises IndexOutOfBounds {
    param: ?*Obj = fn.params;
    while (param != null) {
        ty: ?*Type = param.ty;
        if (ty != null && !param.bounds_written && !param.bounds_addr_taken && bounds_scalar_type(ty)) {
            if (is_bool_ty(ty)) {
                bounds_implication_scalar_literal(guard, f, param, bounds_bool_literal(true));
                bounds_implication_scalar_literal(guard, f, param, bounds_bool_literal(false))
            } else if (is_any_pointer(ty)) bounds_implication_scalar_literal(guard,
                f, param, new_null_expr()) else {
                match ty.* {
                    Enum k -> {
                        variant: ?*Variant = k.def.variants;
                        while (variant != null) {
                            literal: *Expr = new_variant_lit("", "", variant, variant.tag,
                                null, ty);
                            bounds_implication_scalar_literal(guard, f, param, literal);
                            variant = variant.next
                        }
                    }
                    _ -> { }
                }
            }
        }
        param = param.param_next
    }
}

bounds_implication_result_term(
    fn: *Function@new,
    guard: *BoundsGuardFacts@new,
    value: *Expr,
    f: ?*BoundsState,
    term: *Expr
) raises IndexOutOfBounds {
    anchor: ?*Obj = fn.bounds_result;
    if (anchor == null) return;
    path: ?*Expr = bounds_guard_param_term(fn, term);
    if (path == null) return;
    result: *Expr = bounds_obj_expr(anchor);
    root: ?*Obj = bounds_term_root(path);
    upper_bound: int = bounds_return_bound(f, value, term);
    if (upper_bound < 1000000000) {
        upper: BoundsRow = BoundsRow {
            index: anchor,
            array: root,
            kind: BoundsKind.Difference,
            value: upper_bound,
            left: result,
            right: path,
            separation: null
        };
        bounds_implication_record(guard, upper)
    }
    lower_bound: int = bounds_return_bound(f, term, value);
    if (lower_bound < 1000000000) {
        lower: BoundsRow = BoundsRow {
            index: if (root == null) anchor else root,
            array: if (root == null) null else anchor,
            kind: BoundsKind.Difference,
            value: lower_bound,
            left: path,
            right: result,
            separation: null
        };
        bounds_implication_record(guard, lower)
    }
}

bounds_implication_result_candidates(
    fn: *Function@new,
    guard: *BoundsGuardFacts@new,
    value: *Expr,
    f: ?*BoundsState
) raises IndexOutOfBounds {
    if (!is_int_ty(fn.return_ty)) return;
    param: ?*Obj = fn.params;
    while (param != null) {
        if (is_int_ty(param.ty) && !param.bounds_written && !param.bounds_addr_taken) bounds_implication_result_term(fn,
            guard, value, f, bounds_obj_expr(param));
        param = param.param_next
    }
    // Terms already present in the exit state include literal thresholds and
    // lengths. Query only those terms, not a fixed list of favored constants.
    for position in 0..bounds_count(f) {
        row: ?*BoundsRow = bounds_row(f, position);
        if (row != null) {
            if (row.kind == BoundsKind.Difference && row.separation == null) {
                left: ?*Expr = row.left;
                right: ?*Expr = row.right;
                if (left != null) bounds_implication_result_term(fn, guard, value,
                    f, left);
                if (right != null) bounds_implication_result_term(fn, guard, value,
                    f, right)
            }
        }
    }
}

bounds_implication_visit(fn: *Function@new, value: *Expr, f: ?*BoundsState) noregion raises IndexOutOfBounds {
    guard: ?*BoundsGuardFacts = bounds_guards;
    while (guard != null) {
        disjoint: bool = false;
        literal: ?*Expr = guard.literal;
        if (literal != null) disjoint = bounds_scalar_constants_differ(value, literal) || bounds_scalar_proves(f,
            value, literal, BoundsKind.NotEqual) else disjoint = bounds_implication_opposite(f,
            &guard.premise);
        if (!disjoint) {
            if (!guard.seen) {
                guard.seen = true;
                bounds_implication_result_candidates(fn, guard, value, f);
                bounds_implication_numeric_candidates(fn, guard, f);
                bounds_implication_scalar_candidates(fn, guard, f)
            } else {
                kept: ?*BoundsSummaryFact = null;
                candidate: ?*BoundsSummaryFact = guard.facts;
                while (candidate != null) {
                    if (bounds_implication_exit_fact(f, value, fn.bounds_result, &candidate.fact)) kept = new BoundsSummaryFact { fact: candidate.fact, next: kept };
                    candidate = candidate.next
                }
                guard.facts = kept
            }
        }
        guard = guard.next
    }
}

bounds_implication_list_has(head: ?*BoundsImplication, rule: *BoundsImplication) raises IndexOutOfBounds: bool {
    q: ?*BoundsImplication = head;
    while (q != null) {
        if (bounds_implication_same(q, rule)) return true;
        q = q.next
    }
    false
}

bounds_implication_lists_same(a: ?*BoundsImplication, b: ?*BoundsImplication) raises IndexOutOfBounds: bool {
    q: ?*BoundsImplication = a;
    while (q != null) {
        if (!bounds_implication_list_has(b, q)) return false;
        q = q.next
    }
    other: ?*BoundsImplication = b;
    while (other != null) {
        if (!bounds_implication_list_has(a, other)) return false;
        other = other.next
    }
    true
}

bounds_infer_implications(fn: *Function@new) raises IndexOutOfBounds {
    old: ?*BoundsImplication = fn.bounds_implications;
    head: ?*BoundsImplication = null;
    count: int = 0;
    if (bounds_guards == null) {
        if (old != null) bounds_infer_changed = true;
        fn.bounds_implications = null;
        return
    }
    q: ?*BoundsGuardFacts = bounds_guards;
    while (q != null && count < BOUNDS_SUMMARY_IMPLICATIONS) {
        if (q.seen) {
            premise: *BoundsPremise = new BoundsPremise { fact: q.premise, next: null };
            fact: ?*BoundsSummaryFact = q.facts;
            while (fact != null && count < BOUNDS_SUMMARY_IMPLICATIONS) {
                candidate: *BoundsImplication = new BoundsImplication { premises: premise, consequence: fact.fact, next: head };
                if (!bounds_implication_list_has(head, candidate)) {
                    head = candidate;
                    count = count + 1
                }
                fact = fact.next
            }
        }
        q = q.next
    }
    if (!bounds_implication_lists_same(old, head)) bounds_infer_changed = true;
    fn.bounds_implications = head
}
