tag compiler_internal;

// A conservative dead-store check: only straight-line overwrites of locals.
// mode 0 finds uses; mode 1 finds addresses that could alias the local.
unusedassign_expr_has(e: ?*Expr, obj: *Obj, mode: bool): bool {
    if (e == null) return false;
    n: *Expr = e;
    match n.kind {
        Var k -> !mode && k.var == obj;
        Addr k -> unusedassign_expr_has(k.lhs, obj, false);
        Binary k -> unusedassign_expr_has(k.lhs, obj, mode) || unusedassign_expr_has(k.rhs,
            obj, mode);
        Assign k -> unusedassign_expr_has(k.lhs, obj, mode) || unusedassign_expr_has(k.rhs,
            obj, mode);
        Deref k -> unusedassign_expr_has(k.lhs, obj, mode);
        Index k -> unusedassign_expr_has(k.lhs, obj, mode) || unusedassign_expr_has(k.idx,
            obj, mode);
        Not k -> unusedassign_expr_has(k.lhs, obj, mode);
        Neg k -> unusedassign_expr_has(k.lhs, obj, mode);
        BitNot k -> unusedassign_expr_has(k.lhs, obj, mode);
        LogAnd k -> unusedassign_expr_has(k.lhs, obj, mode) || unusedassign_expr_has(k.rhs,
            obj, mode);
        LogOr k -> unusedassign_expr_has(k.lhs, obj, mode) || unusedassign_expr_has(k.rhs,
            obj, mode);
        OrElse k -> unusedassign_expr_has(k.lhs, obj, mode) || unusedassign_expr_has(k.rhs,
            obj, mode);
        Funcall k -> {
            if (unusedassign_expr_has(k.target, obj, mode)) return true;
            a: ?*Expr = k.args;
            while (a != null) {
                if (unusedassign_expr_has(a, obj, mode)) return true;
                a = a.next
            }
            false
        }
        MemberAccess k -> unusedassign_expr_has(k.lhs, obj, mode);
        As k -> unusedassign_expr_has(k.lhs, obj, mode);
        Trunc k -> unusedassign_expr_has(k.lhs, obj, mode);
        New k -> unusedassign_expr_has(k.lhs, obj, mode) || unusedassign_expr_has(k.fill,
            obj, mode) || unusedassign_inits_has(k.inits, obj, mode);
        StructLit k -> unusedassign_inits_has(k.inits, obj, mode);
        VariantLit k -> unusedassign_inits_has(k.inits, obj, mode);
        If k -> unusedassign_expr_has(k.cond, obj, mode) || unusedassign_expr_has(k.then,
            obj, mode) || unusedassign_expr_has(k.els, obj, mode);
        Match k -> {
            if (unusedassign_expr_has(k.cond, obj, mode)) return true;
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (unusedassign_stmt_has(arm.body, obj, mode)) return true;
                arm = arm.next
            }
            false
        }
        Block k -> unusedassign_stmts_has(k.body, obj, mode);
        Sizeof k -> unusedassign_expr_has(k.e, obj, mode);
        ArrayLit k -> {
            a2: ?*Expr = k.elems;
            while (a2 != null) {
                if (unusedassign_expr_has(a2, obj, mode)) return true;
                a2 = a2.next
            }
            false
        }
        _ -> false
    }
}

unusedassign_inits_has(inits: ?*FieldInit, obj: *Obj, mode: bool): bool {
    i: ?*FieldInit = inits;
    while (i != null) {
        if (unusedassign_expr_has(i.lhs, obj, mode)) return true;
        i = i.next
    }
    false
}

unusedassign_stmt_has(s: ?*Stmt, obj: *Obj, mode: bool): bool {
    if (s == null) return false;
    n: *Stmt = s;
    match n.kind {
        Return k -> unusedassign_expr_has(k.lhs, obj, mode);
        If k -> unusedassign_expr_has(k.cond, obj, mode) || unusedassign_stmt_has(k.then,
            obj, mode) || unusedassign_stmt_has(k.els, obj, mode);
        While k -> unusedassign_expr_has(k.cond, obj, mode) || unusedassign_stmt_has(k.body,
            obj, mode);
        For k -> unusedassign_expr_has(k.iter, obj, mode) || unusedassign_expr_has(k.hi,
            obj, mode) || unusedassign_stmt_has(k.body, obj, mode);
        Block k -> unusedassign_stmts_has(k.body, obj, mode);
        ExprStmt k -> unusedassign_expr_has(k.lhs, obj, mode);
        Decl k -> unusedassign_expr_has(k.init, obj, mode);
        Match k -> {
            if (unusedassign_expr_has(k.cond, obj, mode)) return true;
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (unusedassign_stmt_has(arm.body, obj, mode)) return true;
                arm = arm.next
            }
            false
        }
        Raise k -> unusedassign_inits_has(k.inits, obj, mode);
        Try k -> {
            if (unusedassign_stmt_has(k.body, obj, mode)) return true;
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (unusedassign_stmt_has(arm2.body, obj, mode)) return true;
                arm2 = arm2.next
            }
            false
        }
        Region k -> unusedassign_stmt_has(k.body, obj, mode);
        Comment _ -> false
    }
}

unusedassign_stmts_has(head: ?*Stmt, obj: *Obj, mode: bool): bool {
    s: ?*Stmt = head;
    while (s != null) {
        if (unusedassign_stmt_has(s, obj, mode)) return true;
        s = s.next
    }
    false
}

unusedassign_written(s: *Stmt): ?*Obj {
    match s.kind {
        Decl k -> {
            if (k.init != null) k.var else null
        }
        ExprStmt k -> {
            match k.lhs.kind {
                Assign q -> {
                    match q.lhs.kind {
                        Var v -> v.var;
                        _ -> null
                    }
                }
                _ -> null
            }
        }
        _ -> null
    }
}

unusedassign_rhs(s: *Stmt): ?*Expr {
    match s.kind {
        Decl k -> k.init;
        ExprStmt k -> {
            match k.lhs.kind {
                Assign q -> q.rhs;
                _ -> null
            }
        }
        _ -> null
    }
}

unusedassign_overwritten(s: ?*Stmt, obj: *Obj): bool {
    p: ?*Stmt = s;
    while (p != null) {
        n: *Stmt = p;
        match n.kind {
            Comment _ -> { }
            Decl k -> {
                if (unusedassign_expr_has(k.init, obj, false)) return false;
                if (k.var == obj && k.init != null) return true
            }
            ExprStmt k -> {
                target: ?*Obj = unusedassign_written(n);
                if (target == obj) {
                    if (unusedassign_expr_has(unusedassign_rhs(n), obj, false)) return false;
                    return true
                }
                if (unusedassign_expr_has(k.lhs, obj, false)) return false
            }
            _ -> return false
        }
        p = p.next
    }
    false
}

// A declaration can move to the first assignment in its own statement list.
// Also recognize an if or match whose every arm is a simple assignment.
unusedassign_initializer_kind(s: *Stmt, obj: *Obj): int {
    match s.kind {
        ExprStmt _k -> {
            if (unusedassign_written(s) != obj) return 0;
            if (unusedassign_expr_has(unusedassign_rhs(s), obj, false)) return 0;
            1
        }
        If k -> {
            if (unusedassign_expr_has(k.cond, obj, false)) return 0;
            els: ?*Stmt = k.els;
            if (els == null) return 0;
            if (unusedassign_initializer_kind(k.then, obj) != 1) return 0;
            if (unusedassign_initializer_kind(els, obj) != 1) return 0;
            2
        }
        Match k -> {
            if (unusedassign_expr_has(k.cond, obj, false)) return 0;
            if (k.arms == null) return 0;
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (unusedassign_initializer_kind(arm.body, obj) != 1) return 0;
                arm = arm.next
            }
            3
        }
        _ -> 0
    }
}

unusedassign_combination(s: ?*Stmt, obj: *Obj): int {
    p: ?*Stmt = s;
    while (p != null) {
        n: *Stmt = p;
        kind: int = unusedassign_initializer_kind(n, obj);
        if (kind != 0) return kind;
        if (unusedassign_stmt_has(n, obj, false)) return 0;
        if (stmt_always_diverges(n)) return 0;
        p = p.next
    }
    0
}

unusedassign_walk(s: ?*Stmt, fn: *Function) {
    if (s == null) return;
    n: *Stmt = s;
    match n.kind {
        Block k -> unusedassign_walk_list(k.body, fn);
        If k -> {
            unusedassign_walk(k.then, fn);
            unusedassign_walk(k.els, fn)
        }
        While k -> unusedassign_walk(k.body, fn);
        For k -> unusedassign_walk(k.body, fn);
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                unusedassign_walk(arm.body, fn);
                arm = arm.next
            }
        }
        Try k -> {
            unusedassign_walk(k.body, fn);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                unusedassign_walk(arm2.body, fn);
                arm2 = arm2.next
            }
        }
        Region k -> unusedassign_walk(k.body, fn);
        _ -> { }
    }
}

unusedassign_walk_list(head: ?*Stmt, fn: *Function) {
    s: ?*Stmt = head;
    while (s != null) {
        n: *Stmt = s;
        match n.kind {
            Decl k -> {
                v0: ?*Obj = k.var;
                if (k.init == null && v0 != null) {
                    v: *Obj = v0;
                    if (!ignore_unused_local_name(v.name) && !unusedassign_stmts_has(fn.body,
                        v, true)) {
                        kind: int = unusedassign_combination(n.next, v);
                        if (kind != 0) {
                            sb0: *StrBuf = sb_new();
                            sb_puts(sb0, "declaration of ");
                            sb_puts(sb0, v.name);
                            sb_puts(sb0, " can be combined with its first assignment");
                            warning_at(fn.browse_file, n.pos, sb_finish(sb0))
                        }
                    }
                }
            }
            _ -> { }
        }
        obj: ?*Obj = unusedassign_written(n);
        if (obj != null && !stmt_always_diverges(n)) {
            v: *Obj = obj;
            if (v.is_local && !ignore_unused_local_name(v.name) && !unusedassign_stmts_has(fn.body,
                v, true) && unusedassign_overwritten(n.next, v)) {
                sb: *StrBuf = sb_new();
                sb_puts(sb, "value assigned to ");
                sb_puts(sb, v.name);
                sb_puts(sb, " is overwritten before being read");
                warning_at(fn.browse_file, n.pos, sb_finish(sb))
            }
        }
        unusedassign_walk(n, fn);
        if (stmt_always_diverges(n)) return;
        s = s.next
    }
}

check_unused_assignments() {
    fn: ?*Function = functions;
    while (fn != null) {
        if (!fn.is_extern) unusedassign_walk_list(fn.body, fn);
        fn = fn.next
    }
}

compiler_unusedassign_main(argc: int, argv: []str) noregion: int {
    if (argc != 2) {
        write(2, "error: usage: l8 unusedassign <file.l8>\n", len("error: usage: l8 unusedassign <file.l8>\n"));
        return 1
    }
    try {
        compiler_analyze(bytes(argv[1]));
        check_unused_assignments();
        0
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1
    }
}
