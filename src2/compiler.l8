new_sizeof_ty(ty: *Type@new): *Expr@new {
    mk_expr(ExprKind.Sizeof { ty: ty, e: null });
}

new_sizeof_e(e: *Expr@new): *Expr@new {
    mk_expr(ExprKind.Sizeof { ty: null, e: e });
}

new_if_expr(cond: *Expr@new, then: *Expr@new, els: *Expr@new): *Expr@new {
    mk_expr(ExprKind.If { cond: cond, then: then, els: els });
}

new_match_expr(cond: *Expr@new, arms: ?*MatchArm@new): *Expr@new {
    mk_expr(ExprKind.Match { cond: cond, arms: arms });
}

new_block_expr(body: ?*Stmt@new): *Expr@new {
    mk_expr(ExprKind.Block { body: body });
}

new_match(cond: *Expr@new, arms: ?*MatchArm@new): *Stmt@new {
    mk_stmt(StmtKind.Match { cond: cond, arms: arms });
}

new_match_arm(
    name: []i8@new,
    variant: ?*Variant@new,
