// L8 self-hosted compiler → x86-64 Linux GAS
// Nominal AST; Type is a sum; Expr/Stmt are typed envelopes.
// Heap ADTs via new; aggregates by sret; *T vs ?*T with flow narrowing.
// noreturn return type; checked exceptions (exception/raises/raise/try/with).
// Pipeline: parse → typecheck → unused fn/local + raises/noreturn checks → codegen.
// This compiler reports failures via `exception Error` (caught in main).

type Type =
    | Int
    | I8
    | Bool
    | Noreturn
    | Ptr { base: *Type; }
    | OptPtr { base: *Type; }
    | Array { base: *Type; len: int; }
    | Record { def: *StructDef; }
    | Enum { def: *EnumDef; }
    | Exn { def: *ExnDef; };

type Member = {
    name: *i8;
    offset: int;
    ty: *Type;
    next: ?*Member;
};

type StructDef = {
    name: *i8;
    members: ?*Member;
    size: int;
    ty: ?*Type;
    next: ?*StructDef;
    hash_next: ?*StructDef;
};

type Variant = {
    name: *i8;
    tag: int;
    fields: ?*Member;
    payload_ty: ?*Type;
    payload_size: int;
    next: ?*Variant;
};

type EnumDef = {
    name: *i8;
    variants: ?*Variant;
    size: int;
    ty: ?*Type;
    next: ?*EnumDef;
    hash_next: ?*EnumDef;
};

type ExnDef = {
    name: *i8;
    tag: int;
    members: ?*Member;
    size: int;
    ty: ?*Type;
    next: ?*ExnDef;
    hash_next: ?*ExnDef;
};

type ExnList = {
    exn: *ExnDef;
    seen: int;
    next: ?*ExnList;
};

type ImportedFile = {
    path: *i8;
    next: ?*ImportedFile;
};

type TokKind =
    | Eof
    | Num
    | Char
    | Str
    | Ident
    | Int
    | I8
    | Bool
    | True
    | False
    | Null
    | Noreturn
    | If
    | Else
    | While
    | Return
    | TypeKw
    | Sizeof
    | Uninitialized
    | As
    | Trunc
    | New
    | Eq
    | Ne
    | Le
    | Ge
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | Lt
    | Gt
    | Assign
    | Not
    | Amp
    | LParen
    | RParen
    | LBrace
    | RBrace
    | LBrack
    | RBrack
    | Semi
    | Comma
    | Colon
    | And
    | Or
    | Dot
    | Match
    | Pipe
    | Arrow
    | Question
    | Exception
    | Raises
    | Raise
    | Try
    | With
    | Import;

type Token = {
    kind: TokKind;
    val: int;
    str: *i8;
    len: int;
    pos: int;
    next: *Token;
};

type FieldInit = {
    member: *Member;
    lhs: ?*Expr;
    next: ?*FieldInit;
};

type MatchArm = {
    variant: ?*Variant;
    binder: ?*Obj;
    body: *Stmt;
    next: ?*MatchArm;
};

type CatchArm = {
    exn: *ExnDef;
    binder: ?*Obj;
    body: *Stmt;
    next: ?*CatchArm;
};

type BinOp =
    | Add
    | Sub
    | Mul
    | Div
    | Mod
    | Eq
    | Ne
    | Lt
    | Le
    | Gt
    | Ge;

type ExprKind =
    | Num { val: int; str_label: int; }
    | Null
    | Var { var: ?*Obj; name: ?*i8; member: ?*Member; }
    | Binary { op: BinOp; lhs: *Expr; rhs: *Expr; }
    | Assign { lhs: *Expr; rhs: *Expr; }
    | Addr { lhs: *Expr; }
    | Deref { lhs: *Expr; }
    | Not { lhs: *Expr; }
    | Neg { lhs: *Expr; }
    | LogAnd { lhs: *Expr; rhs: *Expr; }
    | LogOr { lhs: *Expr; rhs: *Expr; }
    | Funcall { funcname: *i8; args: ?*Expr; fn: ?*Function; }
    | MemberAccess { lhs: *Expr; member: *Member; }
    | As { lhs: *Expr; }
    | Trunc { lhs: *Expr; }
    | New { lhs: ?*Expr; val: int; inits: ?*FieldInit; variant: ?*Variant; }
    | StructLit { inits: ?*FieldInit; }
    | VariantLit { variant: *Variant; val: int; inits: ?*FieldInit; };

type Expr = {
    kind: ExprKind;
    next: ?*Expr;
    ty: ?*Type;
};

type StmtKind =
    | Return { lhs: ?*Expr; }
    | If { cond: *Expr; then: *Stmt; els: ?*Stmt; }
    | While { cond: *Expr; body: *Stmt; }
    | Block { body: ?*Stmt; }
    | ExprStmt { lhs: *Expr; }
    | Match { cond: *Expr; arms: ?*MatchArm; }
    | Raise { exn: *ExnDef; inits: ?*FieldInit; }
    | Try { body: *Stmt; arms: ?*CatchArm; buf: *Obj; };

type Stmt = {
    kind: StmtKind;
    next: ?*Stmt;
};

type Obj = {
    name: *i8;
    is_local: int;
    is_func: int;
    offset: int;
    scope_depth: int;
    ty: ?*Type;
    used: int;
    next: ?*Obj;
    param_next: ?*Obj;
    hash_next: ?*Obj;
};

type Function = {
    name: *i8;
    nparams: int;
    params: ?*Obj;
    locals: ?*Obj;
    body: ?*Stmt;
    stack_size: int;
    return_ty: ?*Type;
    sret: ?*Obj;
    raises_list: ?*ExnList;
    used: int;
    next: ?*Function;
    hash_next: ?*Function;
};

type FnBucket = { head: ?*Function; };
type ObjBucket = { head: ?*Obj; };
type StructBucket = { head: ?*StructDef; };
type EnumBucket = { head: ?*EnumDef; };
type ExnBucket = { head: ?*ExnDef; };

type StrLit = {
    data: *i8;
    len: int;
    label: int;
    next: ?*StrLit;
};

source: *i8; source_len: int; pos: int;
source_path: *i8;
tok: *Token;
globals: ?*Obj;
locals: ?*Obj;
scope_depth: int;
functions: ?*Function;
function_tail: ?*Function;
imported_files: ?*ImportedFile;
struct_defs: ?*StructDef;
enum_defs: ?*EnumDef;
exn_defs: ?*ExnDef;
SYM_SIZE: int;
fn_buckets: *FnBucket;
global_buckets: *ObjBucket;
struct_buckets: *StructBucket;
enum_buckets: *EnumBucket;
exn_buckets: *ExnBucket;
next_exn_tag: int;
field_list_size: int;
ty_int: *Type;
ty_i8: *Type;
ty_bool: *Type;
ty_noreturn: *Type;
str_lits: ?*StrLit;
str_count: int;
label_id: int;
emit_buf: *i8;
emit_len: int;
emit_cap: int;
do_profile: int;
current_fn_name: ?*i8;
current_return_ty: ?*Type;
current_sret: ?*Obj;
current_fn: ?*Function;
type NarrowFrame = {
    var: ?*Obj;
    ty: ?*Type;
    next: ?*NarrowFrame;
};

narrow_top: ?*NarrowFrame;

type CatchFrame = {
    exn: *ExnDef;
    next: ?*CatchFrame;
};

catch_top: ?*CatchFrame;

L8_JMP_BUF_SIZE: int;

exception Error { msg: *i8; pos: int; path: *i8; src: *i8; src_len: int; };

streq_n(a: *i8, b: *i8, n: int): bool {
    i: int = 0;
    while (i < n) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

streq(a: *i8, b: *i8): bool {
    i: int = 0;
    while (true) {
        if (a[i] != b[i]) { return false; }
        if (a[i] == 0 trunc i8) { return true; }
        i = i + 1;
    }
    return false;
}

cstr_len(s: *i8): int {
    n: int = 0;
    while (s[n] != 0 trunc i8) { n = n + 1; }
    return n;
}

name_eq_span(name: *i8, s: *i8, n: int): bool {
    if (len(name) != n) { return false; }
    return streq_n(name, s, n);
}

hash_n(s: *i8, n: int): int {
    h: int = 5381;
    i: int = 0;
    while (i < n) {
        h = h * 33 + (s[i] as int);
        i = i + 1;
    }
    return h;
}

hash_str(s: *i8): int { return hash_n(s, len(s)); }

sym_bucket(h: int): int {
    if (h < 0) { h = 0 - h; }
    return h % SYM_SIZE;
}

clear_sym_tables() {
    i: int = 0;
    while (i < SYM_SIZE) {
        fn_buckets[i].head = null;
        global_buckets[i].head = null;
        struct_buckets[i].head = null;
        enum_buckets[i].head = null;
        exn_buckets[i].head = null;
        i = i + 1;
    }
}

memcpy(dst: *i8, src: *i8, n: int): *i8 {
    i: int = 0;
    while (i + 8 <= n) {
        d: *int = (dst + i) as *int;
        s: *int = (src + i) as *int;
        d.* = s.*;
        i = i + 8;
    }
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return dst;
}

strdup_n(s: *i8, n: int): *i8 {
    raw: *i8 = new i8[n + 16];
    p: *int = raw as *int;
    p.* = n;
    data: *i8 = raw + 8;
    memcpy(data, s, n);
    data[n] = 0 trunc i8;
    return data;
}

is_space(c: i8): bool { return c == ' ' || c == '\n' || c == '\r' || c == '\t'; }

is_digit(c: i8): bool { return c >= '0' && c <= '9'; }

is_ident1(c: i8): bool {
    if (c >= 'a' && c <= 'z') { return true; }
    if (c >= 'A' && c <= 'Z') { return true; }
    return c == '_';
}

is_ident2(c: i8): bool { return is_ident1(c) || is_digit(c); }

emit_flush() {
    if (emit_len > 0) {
        write(1, emit_buf, emit_len);
        emit_len = 0;
    }
}

emit(s: *i8) {
    n: int = len(s);
    if (n <= 0) { return; }
    if (n > emit_cap) {
        emit_flush();
        write(1, s, n);
        return;
    }
    if (emit_len + n > emit_cap) { emit_flush(); }
    memcpy(emit_buf + emit_len, s, n);
    emit_len = emit_len + n;
}

emit_ch(c: i8) {
    if (emit_len >= emit_cap) { emit_flush(); }
    emit_buf[emit_len] = c;
    emit_len = emit_len + 1;
}

emit_num(n: int) {
    buf: i8[32] = uninitialized;
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        emit_ch('0');
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = (('0' as int) + (n % 10)) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    need: int = i + neg;
    if (emit_len + need > emit_cap) { emit_flush(); }
    if (neg != 0) {
        emit_buf[emit_len] = '-';
        emit_len = emit_len + 1;
    }
    while (i > 0) {
        i = i - 1;
        emit_buf[emit_len] = buf[i];
        emit_len = emit_len + 1;
    }
}

error(msg: *i8) raises Error: noreturn {
    raise Error { msg: msg, pos: tok.pos, path: source_path, src: source, src_len: source_len };
}

error_at(p: int, msg: *i8) raises Error: noreturn {
    raise Error { msg: msg, pos: p, path: source_path, src: source, src_len: source_len };
}

print_error_at(path: *i8, src: *i8, src_len: int, pos: int, msg: *i8) {
    line: int = 1;
    col: int = 1;
    i: int = 0;
    while (i < pos && i < src_len) {
        if (src[i] == '\n') {
            line = line + 1;
            col = 1;
        } else { col = col + 1; }
        i = i + 1;
    }
    write(2, "error: ", len("error: "));
    write(2, path, cstr_len(path));
    write(2, ":", len(":"));
    emit_num_fd(2, line);
    write(2, ":", len(":"));
    emit_num_fd(2, col);
    write(2, ": ", len(": "));
    write(2, msg, len(msg));
    write(2, "\n", len("\n"));
}

warn_unused_function(name: *i8) {
    write(2, "warning: unused function ", len("warning: unused function "));
    write(2, name, len(name));
    write(2, "\n", len("\n"));
}

warn_unused_local(fn_name: *i8, name: *i8) {
    write(2, "warning: unused local ", len("warning: unused local "));
    write(2, name, len(name));
    write(2, " in ", len(" in "));
    write(2, fn_name, len(fn_name));
    write(2, "\n", len("\n"));
}

ignore_unused_local_name(name: *i8): bool {
    c: i8 = name[0];
    return c == '.' || c == '_';
}

type StrBuf = {
    data: *i8;
    len: int;
    cap: int;
};

sb_new(): *StrBuf {
    return new StrBuf {
        data: new i8[64],
        len: 0,
        cap: 64
    };
}

sb_grow(sb: *StrBuf, need: int) {
    if (sb.len + need <= sb.cap) { return; }
    ncap: int = sb.cap;
    while (ncap < sb.len + need) {
        ncap = ncap * 2;
    }
    nd: *i8 = new i8[ncap];
    memcpy(nd, sb.data, sb.len);
    sb.data = nd;
    sb.cap = ncap;
}

sb_putc(sb: *StrBuf, c: i8) {
    sb_grow(sb, 1);
    sb.data[sb.len] = c;
    sb.len = sb.len + 1;
}

sb_puts(sb: *StrBuf, s: *i8) {
    n: int = len(s);
    sb_grow(sb, n);
    memcpy(sb.data + sb.len, s, n);
    sb.len = sb.len + n;
}

sb_put_num(sb: *StrBuf, n: int) {
    if (n < 0) {
        sb_putc(sb, '-');
        n = 0 - n;
    }
    if (n == 0) {
        sb_putc(sb, '0');
        return;
    }
    buf: i8[32] = uninitialized;
    i: int = 0;
    while (n > 0) {
        buf[i] = (('0' as int) + (n % 10)) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    while (i > 0) {
        i = i - 1;
        sb_putc(sb, buf[i]);
    }
}

sb_finish(sb: *StrBuf): *i8 { return strdup_n(sb.data, sb.len); }

append_type(sb: *StrBuf, t: ?*Type) raises Error {
    if (t == null) {
        sb_puts(sb, "<unknown>");
        return;
    }
    match t.* {
        Int -> { sb_puts(sb, "int"); return; }
        I8 -> { sb_puts(sb, "i8"); return; }
        Bool -> { sb_puts(sb, "bool"); return; }
        Noreturn -> { sb_puts(sb, "noreturn"); return; }
        Ptr k -> {
            sb_putc(sb, '*');
            append_type(sb, k.base);
            return;
        }
        OptPtr k -> {
            sb_puts(sb, "?*");
            append_type(sb, k.base);
            return;
        }
        Array k -> {
            append_type(sb, k.base);
            sb_putc(sb, '[');
            sb_put_num(sb, k.len);
            sb_putc(sb, ']');
            return;
        }
        Record k -> { sb_puts(sb, k.def.name); return; }
        Enum k -> { sb_puts(sb, k.def.name); return; }
        Exn k -> { sb_puts(sb, k.def.name); return; }
    }
}

error_ty(msg: *i8, t: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": ");
    append_type(sb, t);
    error(sb_finish(sb));
}

error_ty_vs(msg: *i8, a: ?*Type, b: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": ");
    append_type(sb, a);
    sb_puts(sb, " vs ");
    append_type(sb, b);
    error(sb_finish(sb));
}

error_have_want(msg: *i8, have: ?*Type, want: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_type(sb, have);
    sb_puts(sb, ", want ");
    append_type(sb, want);
    error(sb_finish(sb));
}

error_have_and(msg: *i8, a: ?*Type, b: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_type(sb, a);
    sb_puts(sb, " and ");
    append_type(sb, b);
    error(sb_finish(sb));
}

append_expr_ty(sb: *StrBuf, e: ?*Expr) raises Error {
    if (e == null) {
        append_type(sb, null);
        return;
    }
    if (e.ty != null) {
        append_type(sb, decay(e.ty));
        return;
    }
    if (is_null_expr(e)) {
        sb_puts(sb, "null");
        return;
    }
    append_type(sb, null);
}

error_have_expr_want(msg: *i8, have: ?*Expr, want: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_expr_ty(sb, have);
    sb_puts(sb, ", want ");
    append_type(sb, want);
    error(sb_finish(sb));
}

emit_num_fd(fd: int, n: int) {
    buf: i8[32] = uninitialized;
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        z: i8 = '0';
        write(fd, &z, 1);
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = (('0' as int) + (n % 10)) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    if (neg != 0) {
        m: i8 = '-';
        write(fd, &m, 1);
    }
    while (i > 0) {
        i = i - 1;
        ch: i8 = buf[i];
        write(fd, &ch, 1);
    }
}

token_eof: *Token;

init_dummies() {
    token_eof = new Token {
        kind: TokKind.Eof,
        val: 0,
        str: "",
        len: 0,
        pos: 0,
        next: uninitialized
    };
    token_eof.next = token_eof;
}

expect_field_init(n: ?*FieldInit, msg: *i8) raises Error: *FieldInit {
    if (n != null) { return n; }
    error(msg);
}

expect_type(t: ?*Type, msg: *i8) raises Error: *Type {
    if (t != null) { return t; }
    error(msg);
}

expect_member(m: ?*Member, msg: *i8) raises Error: *Member {
    if (m != null) { return m; }
    error(msg);
}

init_runtime() {
    ty_int = new Type.Int;
    ty_i8 = new Type.I8;
    ty_bool = new Type.Bool;
    ty_noreturn = new Type.Noreturn;
    exn_defs = null;
    next_exn_tag = 1;
    catch_top = null;
    current_fn = null;
    L8_JMP_BUF_SIZE = 72;
    emit_cap = 65536;
    emit_buf = new i8[65536];
    emit_len = 0;
    SYM_SIZE = 256;
    fn_buckets = new FnBucket[256];
    global_buckets = new ObjBucket[256];
    struct_buckets = new StructBucket[256];
    enum_buckets = new EnumBucket[256];
    exn_buckets = new ExnBucket[256];
    clear_sym_tables();
}

read_file(path: *i8) raises Error: *i8 {
    fd: int = open(path, 0, 0);
    if (fd < 0) { error("cannot open file"); }
    cap: int = 65536;
    buf: *i8 = new i8[cap];
    n: int = 0;
    while (true) {
        if (n + 4096 > cap) {
            cap = cap * 2;
            tmp: *i8 = new i8[cap];
            memcpy(tmp, buf, n);
            buf = tmp;
        }
        r: int = read(fd, buf + n, 4096);
        if (r <= 0) {
            buf[n] = 0 trunc i8;
            close(fd);
            source_len = n;
            return buf;
        }
        n = n + r;
    }
    return buf;
}

normalize_path(path: *i8): *i8 {
    n: int = cstr_len(path);
    out: *i8 = new i8[n + 2];
    starts: *int = new int[n + 1];
    out_len: int = 0;
    nseg: int = 0;
    absolute: bool = n > 0 && path[0] == '/';
    if (absolute) {
        out[0] = '/';
        out_len = 1;
    }
    i: int = 0;
    while (i < n) {
        while (i < n && path[i] == '/') { i = i + 1; }
        if (i >= n) {
            i = n;
        } else {
            start: int = i;
            while (i < n && path[i] != '/') { i = i + 1; }
            part_len: int = i - start;
            is_dot: bool = part_len == 1 && path[start] == '.';
            is_dotdot: bool = part_len == 2 && path[start] == '.' && path[start + 1] == '.';
            if (is_dot) {
                /* nothing */
            } else if (is_dotdot && nseg > 0) {
                nseg = nseg - 1;
                out_len = starts[nseg];
            } else {
                starts[nseg] = out_len;
                nseg = nseg + 1;
                if (out_len > 0 && out[out_len - 1] != '/') {
                    out[out_len] = '/';
                    out_len = out_len + 1;
                }
                j: int = 0;
                while (j < part_len) {
                    out[out_len] = path[start + j];
                    out_len = out_len + 1;
                    j = j + 1;
                }
            }
        }
    }
    if (out_len == 0) {
        out[0] = '.';
        out_len = 1;
    }
    out[out_len] = 0 trunc i8;
    return out;
}

resolve_import_path(base: *i8, imported: *i8): *i8 {
    if (imported[0] == '/') { return normalize_path(imported); }
    base_len: int = cstr_len(base);
    slash: int = 0 - 1;
    i: int = 0;
    while (i < base_len) {
        if (base[i] == '/') { slash = i; }
        i = i + 1;
    }
    if (slash < 0) { return normalize_path(imported); }
    joined: *i8 = new i8[slash + 2 + cstr_len(imported)];
    j: int = 0;
    while (j <= slash) {
        joined[j] = base[j];
        j = j + 1;
    }
    k: int = 0;
    while (imported[k] != 0 trunc i8) {
        joined[j] = imported[k];
        j = j + 1;
        k = k + 1;
    }
    joined[j] = 0 trunc i8;
    return normalize_path(joined);
}

mark_imported(path: *i8): bool {
    f: ?*ImportedFile = imported_files;
    while (f != null) {
        if (streq(f.path, path)) { return false; }
        f = f.next;
    }
    imported_files = new ImportedFile { path: path, next: imported_files };
    return true;
}

type_size(t: *Type) raises Error: int {
    match t.* {
        Int -> { return 8; }
        I8 -> { return 1; }
        Bool -> { return 1; }
        Ptr _p -> { return 8; }
        OptPtr _p -> { return 8; }
        Array k -> { return type_size(k.base) * k.len; }
        Record k -> { return k.def.size; }
        Enum k -> {
            if (k.def.size <= 0) { return 8; }
            return k.def.size;
        }
        Exn k -> { return k.def.size; }
        Noreturn -> { return 0; }
    }
}

type_base(t: *Type) raises Error: *Type {
    match t.* {
        Ptr k -> { return k.base; }
        OptPtr k -> { return k.base; }
        Array k -> { return k.base; }
        _ -> { error("not a pointer or array"); }
    }
}

type_array_len(t: *Type) raises Error: int {
    match t.* {
        Array k -> { return k.len; }
        _ -> { error("not an array"); }
    }
}

type_struct_def(t: *Type) raises Error: *StructDef {
    match t.* {
        Record k -> { return k.def; }
        _ -> { error("not a record type"); }
    }
}

type_enum_def(t: *Type) raises Error: *EnumDef {
    match t.* {
        Enum k -> { return k.def; }
        _ -> { error("not an enum type"); }
    }
}

type_exn_def(t: *Type) raises Error: *ExnDef {
    match t.* {
        Exn k -> { return k.def; }
        _ -> { error("not an exception type"); }
    }
}

ptr_to(base: *Type): *Type {
    return new Type.Ptr { base: base };
}

opt_ptr_to(base: *Type): *Type {
    return new Type.OptPtr { base: base };
}

array_of(base: *Type, len: int): *Type {
    return new Type.Array { base: base, len: len };
}

struct_type(sd: *StructDef): *Type {
    existing: ?*Type = sd.ty;
    if (existing != null) { return existing; }
    p: *Type = new Type.Record { def: sd };
    sd.ty = p;
    return p;
}

enum_type(ed: *EnumDef): *Type {
    existing: ?*Type = ed.ty;
    if (existing != null) { return existing; }
    p: *Type = new Type.Enum { def: ed };
    ed.ty = p;
    return p;
}

exn_type(ed: *ExnDef): *Type {
    existing: ?*Type = ed.ty;
    if (existing != null) { return existing; }
    p: *Type = new Type.Exn { def: ed };
    ed.ty = p;
    return p;
}

find_struct_span(s: *i8, n: int): ?*StructDef {
    b: int = sym_bucket(hash_n(s, n));
    sd: ?*StructDef = struct_buckets[b].head;
    while (sd != null) {
        if (name_eq_span(sd.name, s, n)) { return sd; }
        sd = sd.hash_next;
    }
    return null;
}

find_struct(name: *i8): ?*StructDef { return find_struct_span(name, len(name)); }

find_enum_span(s: *i8, n: int): ?*EnumDef {
    b: int = sym_bucket(hash_n(s, n));
    e: ?*EnumDef = enum_buckets[b].head;
    while (e != null) {
        if (name_eq_span(e.name, s, n)) { return e; }
        e = e.hash_next;
    }
    return null;
}

find_enum(name: *i8): ?*EnumDef { return find_enum_span(name, len(name)); }

find_exn_span(s: *i8, n: int): ?*ExnDef {
    b: int = sym_bucket(hash_n(s, n));
    e: ?*ExnDef = exn_buckets[b].head;
    while (e != null) {
        if (name_eq_span(e.name, s, n)) { return e; }
        e = e.hash_next;
    }
    return null;
}

find_exn(name: *i8): ?*ExnDef { return find_exn_span(name, len(name)); }

hash_put_struct(sd: *StructDef) {
    b: int = sym_bucket(hash_str(sd.name));
    sd.hash_next = struct_buckets[b].head;
    struct_buckets[b].head = sd;
}

hash_put_enum(ed: *EnumDef) {
    b: int = sym_bucket(hash_str(ed.name));
    ed.hash_next = enum_buckets[b].head;
    enum_buckets[b].head = ed;
}

hash_put_exn(ed: *ExnDef) {
    b: int = sym_bucket(hash_str(ed.name));
    ed.hash_next = exn_buckets[b].head;
    exn_buckets[b].head = ed;
}

hash_put_fn(fn: *Function) {
    b: int = sym_bucket(hash_str(fn.name));
    fn.hash_next = fn_buckets[b].head;
    fn_buckets[b].head = fn;
}

hash_put_global(o: *Obj) {
    b: int = sym_bucket(hash_str(o.name));
    o.hash_next = global_buckets[b].head;
    global_buckets[b].head = o;
}

hash_remove_struct(name: *i8) {
    b: int = sym_bucket(hash_str(name));
    prev: ?*StructDef = null;
    s: ?*StructDef = struct_buckets[b].head;
    while (s != null) {
        if (streq(s.name, name)) {
            if (prev != null) {
                prev.hash_next = s.hash_next;
            } else { struct_buckets[b].head = s.hash_next; }
            return;
        }
        prev = s;
        s = s.hash_next;
    }
}

remove_struct(name: *i8) {
    hash_remove_struct(name);
    prev: ?*StructDef = null;
    s: ?*StructDef = struct_defs;
    while (s != null) {
        if (streq(s.name, name)) {
            if (prev != null) {
                prev.next = s.next;
            } else { struct_defs = s.next; }
            return;
        }
        prev = s;
        s = s.next;
    }
}

get_or_create_struct(name: *i8): *StructDef {
    sd: ?*StructDef = find_struct(name);
    if (sd != null) { return sd; }
    created: *StructDef = new StructDef {
        name: name, members: null, size: 0, ty: null, next: struct_defs, hash_next: null
    };
    struct_defs = created;
    hash_put_struct(created);
    return created;
}

get_or_create_enum(name: *i8): *EnumDef {
    ed: ?*EnumDef = find_enum(name);
    if (ed != null) { return ed; }
    created: *EnumDef = new EnumDef {
        name: name, variants: null, size: 0, ty: null, next: enum_defs, hash_next: null
    };
    enum_defs = created;
    hash_put_enum(created);
    return created;
}

rebind_struct_stub_to_enum(sd: *StructDef, ed: *EnumDef) {
    t: ?*Type = sd.ty;
    if (t != null) {
        t.* = Type.Enum { def: ed };
        ed.ty = t;
    }
}

find_variant(ed: *EnumDef, name: *i8): ?*Variant {
    v: ?*Variant = ed.variants;
    while (v != null) {
        if (streq(v.name, name)) { return v; }
        v = v.next;
    }
    return null;
}

variant_payload_name(enum_name: *i8, var_name: *i8): *i8 {
    n: int = len(enum_name) + 1 + len(var_name);
    raw: *i8 = new i8[n + 16];
    p: *int = raw as *int;
    p.* = n;
    data: *i8 = raw + 8;
    i: int = 0;
    j: int = 0;
    while (i < len(enum_name)) {
        data[j] = enum_name[i];
        j = j + 1;
        i = i + 1;
    }
    data[j] = '.';
    j = j + 1;
    i = 0;
    while (i < len(var_name)) {
        data[j] = var_name[i];
        j = j + 1;
        i = i + 1;
    }
    return data;
}

is_type_name(): bool {
    if (!equal(TokKind.Ident)) { return false; }
    if (find_struct_span(tok.str, tok.len) != null) { return true; }
    if (find_enum_span(tok.str, tok.len) != null) { return true; }
    if (find_exn_span(tok.str, tok.len) != null) { return true; }
    return false;
}

starts_type(): bool {
    if (equal(TokKind.Int) || equal(TokKind.I8) || equal(TokKind.Bool) || is_type_name()) { return true; }
    t: ?*Token = tok;
    done: int = 0;
    while (t != null && done == 0) {
        if (t.kind == TokKind.Question) {
            n1: ?*Token = t.next;
            if (n1 != null) {
                if (n1.kind != TokKind.Star) { return false; }
                t = n1.next;
            } else { return false; }
        } else {
            if (t.kind == TokKind.Star) {
                t = t.next;
            } else { done = 1; }
        }
    }
    if (t != null) {
        if (t != tok) {
            if (t.kind == TokKind.Int || t.kind == TokKind.I8 || t.kind == TokKind.Bool) { return true; }
            if (t.kind == TokKind.Ident) {
                if (find_struct_span(t.str, t.len) != null) { return true; }
                if (find_enum_span(t.str, t.len) != null) { return true; }
                if (find_exn_span(t.str, t.len) != null) { return true; }
            }
        }
    }
    return false;
}

find_field(members: ?*Member, name: *i8): ?*Member {
    m: ?*Member = members;
    while (m != null) {
        if (streq(m.name, name)) { return m; }
        m = m.next;
    }
    return null;
}

find_member(sd: *StructDef, name: *i8): ?*Member { return find_field(sd.members, name); }

find_exn_member(ed: *ExnDef, name: *i8): ?*Member { return find_field(ed.members, name); }

exn_in_list(list: ?*ExnList, ed: *ExnDef): bool {
    e: ?*ExnList = list;
    while (e != null) {
        if (e.exn == ed) { return true; }
        e = e.next;
    }
    return false;
}

exn_is_caught(ed: *ExnDef): bool {
    f: ?*CatchFrame = catch_top;
    while (f != null) {
        if (f.exn == ed) { return true; }
        f = f.next;
    }
    return false;
}

mark_raises_seen(ed: *ExnDef): bool {
    fn: ?*Function = current_fn;
    if (fn != null) {
        e: ?*ExnList = fn.raises_list;
        while (e != null) {
            if (e.exn == ed) {
                e.seen = 1;
                return true;
            }
            e = e.next;
        }
    }
    return false;
}

check_exn_allowed(ed: *ExnDef, _what: *i8) raises Error {
    if (exn_is_caught(ed)) { return; }
    if (mark_raises_seen(ed)) { return; }
    error("exception not in raises and not caught");
}

catch_push(ed: *ExnDef) {
    f: *CatchFrame = new CatchFrame { exn: ed, next: catch_top };
    catch_top = f;
}

catch_reset(saved: ?*CatchFrame) { catch_top = saved; }

is_pointer(t: *Type): bool {
    match t.* {
        Ptr _p -> { return true; }
        _ -> { return false; }
    }
}

is_opt_pointer(t: *Type): bool {
    match t.* {
        OptPtr _p -> { return true; }
        _ -> { return false; }
    }
}

is_any_pointer(t: *Type): bool { return is_pointer(t) || is_opt_pointer(t); }

is_array(t: *Type): bool {
    match t.* {
        Array _p -> { return true; }
        _ -> { return false; }
    }
}

is_struct_ty(t: *Type): bool {
    match t.* {
        Record _p -> { return true; }
        _ -> { return false; }
    }
}

is_enum_ty(t: *Type): bool {
    match t.* {
        Enum _p -> { return true; }
        _ -> { return false; }
    }
}

is_exn_ty(t: *Type): bool {
    match t.* {
        Exn _p -> { return true; }
        _ -> { return false; }
    }
}

passes_by_ref(t: *Type) raises Error: bool { return (is_struct_ty(t) || is_enum_ty(t) || is_exn_ty(t)) && type_size(t) > 8; }

is_null_expr(n: ?*Expr): bool {
    if (n != null) {
        match n.kind {
            Null -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

bind_null_to_pointer(pty: ?*Type, null_n: ?*Expr): bool {
    if (pty == null) { return false; }
    if (!is_opt_pointer(pty) || !is_null_expr(null_n)) { return false; }
    if (null_n != null) {
        null_n.ty = pty;
        return true;
    }
    return false;
}

assignable(to: ?*Type, from_n: ?*Expr) raises Error: bool {
    ft: ?*Type = null;
    if (from_n != null) {
        fty: ?*Type = from_n.ty;
        if (fty != null) { ft = decay(fty); }
    }
    tt: ?*Type = decay(to);
    if (ft != null) {
        from2: ?*Type = decay(ft);
        to2: ?*Type = decay(tt);
        if (from2 != null && to2 != null) {
            if (types_equal(from2, to2)) { return true; }
            if (is_opt_pointer(to2) && is_pointer(from2) && types_equal(type_base(from2), type_base(to2))) { return true; }
        }
    }
    if (bind_null_to_pointer(tt, from_n)) { return true; }
    return false;
}

is_i8_ty(t: *Type): bool {
    match t.* {
        I8 -> { return true; }
        _ -> { return false; }
    }
}

is_int_ty(t: *Type): bool {
    match t.* {
        Int -> { return true; }
        _ -> { return false; }
    }
}

is_bool_ty(t: *Type): bool {
    match t.* {
        Bool -> { return true; }
        _ -> { return false; }
    }
}

is_noreturn_ty(t: *Type): bool {
    match t.* {
        Noreturn -> { return true; }
        _ -> { return false; }
    }
}

types_equal(a: *Type, b: *Type) raises Error: bool {
    if (a == b) { return true; }
    if (is_int_ty(a) && is_int_ty(b)) { return true; }
    if (is_i8_ty(a) && is_i8_ty(b)) { return true; }
    if (is_bool_ty(a) && is_bool_ty(b)) { return true; }
    if (is_noreturn_ty(a) && is_noreturn_ty(b)) { return true; }
    if (is_pointer(a) && is_pointer(b)) { return types_equal(type_base(a), type_base(b)); }
    if (is_opt_pointer(a) && is_opt_pointer(b)) { return types_equal(type_base(a), type_base(b)); }
    if (is_array(a) && is_array(b)) {
        if (type_array_len(a) != type_array_len(b)) { return false; }
        return types_equal(type_base(a), type_base(b));
    }
    if (is_struct_ty(a) && is_struct_ty(b)) { return type_struct_def(a) == type_struct_def(b); }
    if (is_enum_ty(a) && is_enum_ty(b)) { return type_enum_def(a) == type_enum_def(b); }
    if (is_exn_ty(a) && is_exn_ty(b)) { return type_exn_def(a) == type_exn_def(b); }
    return false;
}

is_numeric_ty(t: *Type): bool {
    return is_int_ty(t) || is_i8_ty(t) || is_bool_ty(t);
}

check_as(from: ?*Type, to: ?*Type) raises Error {
    from = decay(from);
    to = decay(to);
    if (from == null) { error("invalid as conversion"); }
    if (to == null) { error("invalid as conversion"); }
    if (types_equal(from, to)) { return; }
    if (is_numeric_ty(from) && is_numeric_ty(to)) {
        if ((is_i8_ty(from) || is_bool_ty(from)) && is_int_ty(to)) { return; }
        if (type_size(from) == 1 && type_size(to) == 1) { return; }
        error_have_want("invalid as conversion (use trunc to narrow int→i8/bool)", from, to);
    }
    if (is_opt_pointer(from) && is_pointer(to)) {
        error_have_want("cannot cast optional pointer to non-optional (bind a local and use if (p != null))", from, to);
    }
    if (is_pointer(from) && is_pointer(to)) { return; }
    error_have_want("invalid as conversion", from, to);
}

check_trunc(from: ?*Type, to: ?*Type) raises Error {
    from = decay(from);
    to = decay(to);
    if (from == null) { error("invalid trunc conversion"); }
    if (to == null) { error("invalid trunc conversion"); }
    if (is_int_ty(from) && (is_i8_ty(to) || is_bool_ty(to))) { return; }
    error_have_want("invalid trunc conversion", from, to);
}

decay(t: ?*Type) raises Error: ?*Type {
    if (t != null) {
        if (is_array(t)) { return ptr_to(type_base(t)); }
    }
    return t;
}

is_byte_ty(t: *Type) raises Error: bool { return type_size(t) == 1; }

new_token(kind: TokKind, start: *i8, len: int): *Token {
    p: int = start - source;
    return new Token {
        kind: kind,
        val: 0,
        str: start,
        len: len,
        pos: p,
        next: token_eof
    };
}

ident_kind(s: *i8, n: int): TokKind {
    if (n == 3 && streq_n(s, "int", 3)) { return TokKind.Int; }
    if (n == 2 && streq_n(s, "i8", 2)) { return TokKind.I8; }
    if (n == 4 && streq_n(s, "bool", 4)) { return TokKind.Bool; }
    if (n == 4 && streq_n(s, "true", 4)) { return TokKind.True; }
    if (n == 5 && streq_n(s, "false", 5)) { return TokKind.False; }
    if (n == 4 && streq_n(s, "null", 4)) { return TokKind.Null; }
    if (n == 8 && streq_n(s, "noreturn", 8)) { return TokKind.Noreturn; }
    if (n == 2 && streq_n(s, "if", 2)) { return TokKind.If; }
    if (n == 4 && streq_n(s, "else", 4)) { return TokKind.Else; }
    if (n == 5 && streq_n(s, "while", 5)) { return TokKind.While; }
    if (n == 6 && streq_n(s, "return", 6)) { return TokKind.Return; }
    if (n == 4 && streq_n(s, "type", 4)) { return TokKind.TypeKw; }
    if (n == 6 && streq_n(s, "sizeof", 6)) { return TokKind.Sizeof; }
    if (n == 13 && streq_n(s, "uninitialized", 13)) { return TokKind.Uninitialized; }
    if (n == 2 && streq_n(s, "as", 2)) { return TokKind.As; }
    if (n == 5 && streq_n(s, "trunc", 5)) { return TokKind.Trunc; }
    if (n == 3 && streq_n(s, "new", 3)) { return TokKind.New; }
    if (n == 5 && streq_n(s, "match", 5)) { return TokKind.Match; }
    if (n == 9 && streq_n(s, "exception", 9)) { return TokKind.Exception; }
    if (n == 6 && streq_n(s, "raises", 6)) { return TokKind.Raises; }
    if (n == 5 && streq_n(s, "raise", 5)) { return TokKind.Raise; }
    if (n == 3 && streq_n(s, "try", 3)) { return TokKind.Try; }
    if (n == 4 && streq_n(s, "with", 4)) { return TokKind.With; }
    if (n == 6 && streq_n(s, "import", 6)) { return TokKind.Import; }
    return TokKind.Ident;
}

skip_line_comment() {
    while (pos < source_len) {
        if (source[pos] == '\n') { return; }
        pos = pos + 1;
    }
}

skip_block_comment() {
    while (pos < source_len) {
        if (source[pos] == '*' && source[pos + 1] == '/') {
            pos = pos + 2;
            return;
        }
        pos = pos + 1;
    }
}

read_number(): int {
    v: int = 0;
    while (pos < source_len) {
        if (!is_digit(source[pos])) { return v; }
        v = v * 10 + ((source[pos] as int) - ('0' as int));
        pos = pos + 1;
    }
    return v;
}

esc_char(c: i8): i8 {
    if (c == 'n') { return '\n'; }
    if (c == 't') { return '\t'; }
    if (c == 'r') { return '\r'; }
    if (c == '0') { return 0 trunc i8; }
    if (c == '\\') { return '\\'; }
    if (c == '\'') { return '\''; }
    if (c == '"') { return '"'; }
    return c;
}

scan_string_len() raises Error: int {
    start: int = pos;
    while (pos < source_len) {
        if (source[pos] == '"') { return pos - start; }
        if (source[pos] == '\\') { pos = pos + 1; }
        pos = pos + 1;
    }
    error("unterminated string");
}

scan_ident_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (!is_ident2(source[pos])) { return pos - start; }
        pos = pos + 1;
    }
    return pos - start;
}

punct_kind(c: i8) raises Error: TokKind {
    if (c == '+') { return TokKind.Plus; }
    if (c == '-') { return TokKind.Minus; }
    if (c == '*') { return TokKind.Star; }
    if (c == '%') { return TokKind.Percent; }
    if (c == '&') { return TokKind.Amp; }
    if (c == '.') { return TokKind.Dot; }
    if (c == ':') { return TokKind.Colon; }
    if (c == '(') { return TokKind.LParen; }
    if (c == ')') { return TokKind.RParen; }
    if (c == '{') { return TokKind.LBrace; }
    if (c == '}') { return TokKind.RBrace; }
    if (c == '[') { return TokKind.LBrack; }
    if (c == ']') { return TokKind.RBrack; }
    if (c == ';') { return TokKind.Semi; }
    if (c == ',') { return TokKind.Comma; }
    if (c == '/') { return TokKind.Slash; }
    if (c == '?') { return TokKind.Question; }
    error_at(pos, "unexpected character");
    return TokKind.Eof;
}

tokenize() raises Error: *Token {
    head: *Token = new Token {
        kind: TokKind.Eof,
        val: 0,
        str: "",
        len: 0,
        pos: 0,
        next: token_eof
    };
    cur: *Token = head;
    t: *Token = uninitialized;
    s: *i8 = uninitialized;
    n: int = 0;
    v: int = 0;
    c: i8 = 0 trunc i8;
    ch: i8 = 0 trunc i8;
    pk: TokKind = TokKind.Eof;
    pos = 0;
    while (pos < source_len) {
        c = source[pos];
        if (is_space(c)) {
            pos = pos + 1;
        } else if (c == '/' && source[pos + 1] == '/') {
            pos = pos + 2;
            skip_line_comment();
        } else if (c == '/' && source[pos + 1] == '*') {
            pos = pos + 2;
            skip_block_comment();
        } else if (is_digit(c)) {
            s = source + pos;
            v = read_number();
            t = new_token(TokKind.Num, s, (source + pos) - s);
            t.val = v;
            cur.next = t;
            cur = t;
        } else if (c == '"') {
            pos = pos + 1;
            s = source + pos;
            n = scan_string_len();
            t = new_token(TokKind.Str, s, n);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        } else if (c == '\'') {
            pos = pos + 1;
            if (source[pos] == '\\') {
                pos = pos + 1;
                ch = esc_char(source[pos]);
                pos = pos + 1;
            } else {
                ch = source[pos];
                pos = pos + 1;
            }
            if (source[pos] == '\'') { pos = pos + 1; }
            t = new_token(TokKind.Char, source + pos, 0);
            t.val = ch as int;
            cur.next = t;
            cur = t;
        } else if (is_ident1(c)) {
            s = source + pos;
            n = scan_ident_len();
            t = new_token(ident_kind(s, n), s, n);
            cur.next = t;
            cur = t;
        } else if (c == '=' && source[pos + 1] == '=') {
            t = new_token(TokKind.Eq, source + pos, 2);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '!' && source[pos + 1] == '=') {
            t = new_token(TokKind.Ne, source + pos, 2);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '<' && source[pos + 1] == '=') {
            t = new_token(TokKind.Le, source + pos, 2);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '>' && source[pos + 1] == '=') {
            t = new_token(TokKind.Ge, source + pos, 2);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '&' && source[pos + 1] == '&') {
            t = new_token(TokKind.And, source + pos, 2);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '|' && source[pos + 1] == '|') {
            t = new_token(TokKind.Or, source + pos, 2);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '-' && source[pos + 1] == '>') {
            t = new_token(TokKind.Arrow, source + pos, 2);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '|') {
            t = new_token(TokKind.Pipe, source + pos, 1);
            cur.next = t; cur = t; pos = pos + 1;
        } else if (c == '<') {
            t = new_token(TokKind.Lt, source + pos, 1);
            cur.next = t; cur = t; pos = pos + 1;
        } else if (c == '>') {
            t = new_token(TokKind.Gt, source + pos, 1);
            cur.next = t; cur = t; pos = pos + 1;
        } else if (c == '=') {
            t = new_token(TokKind.Assign, source + pos, 1);
            cur.next = t; cur = t; pos = pos + 1;
        } else if (c == '!') {
            t = new_token(TokKind.Not, source + pos, 1);
            cur.next = t; cur = t; pos = pos + 1;
        } else {
            pk = punct_kind(c);
            t = new_token(pk, source + pos, 1);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        }
    }
    t = new_token(TokKind.Eof, source + pos, 0);
    t.next = t;
    cur.next = t;
    return head.next;
}

equal(kind: TokKind): bool { return tok.kind == kind; }

skip(kind: TokKind) raises Error {
    if (!equal(kind)) { error("unexpected token"); }
    tok = tok.next;
}

cur_tokstr(): *i8 { return strdup_n(tok.str, tok.len); }

add_string(s: *i8, n: int): int {
    buf: *i8 = new i8[n + 1];
    i: int = 0;
    j: int = 0;
    while (i < n) {
        if (s[i] == '\\' && i + 1 < n) {
            i = i + 1;
            buf[j] = esc_char(s[i]);
            j = j + 1;
        } else {
            buf[j] = s[i];
            j = j + 1;
        }
        i = i + 1;
    }
    buf[j] = 0 trunc i8;
    lit: *StrLit = new StrLit {
        data: buf,
        len: j,
        label: str_count,
        next: str_lits
    };
    str_count = str_count + 1;
    str_lits = lit;
    return lit.label;
}

mk_expr(k: ExprKind): *Expr {
    return new Expr { kind: k, next: null, ty: null };
}

mk_stmt(k: StmtKind): *Stmt {
    return new Stmt { kind: k, next: null };
}

new_num(v: int): *Expr {
    n: *Expr = mk_expr(ExprKind.Num { val: v, str_label: 0 });
    n.ty = ty_int;
    return n;
}

new_str_num(label: int): *Expr {
    n: *Expr = mk_expr(ExprKind.Num { val: 0, str_label: label });
    n.ty = ptr_to(ty_i8);
    return n;
}

new_null_expr(): *Expr { return mk_expr(ExprKind.Null); }

new_var_node(var: *Obj): *Expr {
    n: *Expr = mk_expr(ExprKind.Var { var: var, name: null, member: null });
    n.ty = var.ty;
    return n;
}

new_binary(op: BinOp, lhs: *Expr, rhs: *Expr): *Expr {
    return mk_expr(ExprKind.Binary { op: op, lhs: lhs, rhs: rhs });
}
new_assign(lhs: *Expr, rhs: *Expr): *Expr { return mk_expr(ExprKind.Assign { lhs: lhs, rhs: rhs }); }
new_logand(lhs: *Expr, rhs: *Expr): *Expr { return mk_expr(ExprKind.LogAnd { lhs: lhs, rhs: rhs }); }
new_logor(lhs: *Expr, rhs: *Expr): *Expr { return mk_expr(ExprKind.LogOr { lhs: lhs, rhs: rhs }); }
new_addr(lhs: *Expr): *Expr { return mk_expr(ExprKind.Addr { lhs: lhs }); }
new_deref(lhs: *Expr): *Expr { return mk_expr(ExprKind.Deref { lhs: lhs }); }
new_not(lhs: *Expr): *Expr { return mk_expr(ExprKind.Not { lhs: lhs }); }
new_neg(lhs: *Expr): *Expr { return mk_expr(ExprKind.Neg { lhs: lhs }); }
new_as(lhs: *Expr, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.As { lhs: lhs });
    n.ty = ty;
    return n;
}
new_trunc(lhs: *Expr, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.Trunc { lhs: lhs });
    n.ty = ty;
    return n;
}
new_member_access(lhs: *Expr, m: *Member): *Expr {
    n: *Expr = mk_expr(ExprKind.MemberAccess { lhs: lhs, member: m });
    n.ty = m.ty;
    return n;
}
new_funcall(name: *i8, args: ?*Expr): *Expr {
    return mk_expr(ExprKind.Funcall { funcname: name, args: args, fn: null });
}
new_return(lhs: ?*Expr): *Stmt { return mk_stmt(StmtKind.Return { lhs: lhs }); }
new_if(cond: *Expr, then: *Stmt, els: ?*Stmt): *Stmt { return mk_stmt(StmtKind.If { cond: cond, then: then, els: els }); }
new_while(cond: *Expr, body: *Stmt): *Stmt { return mk_stmt(StmtKind.While { cond: cond, body: body }); }
new_block(body: ?*Stmt): *Stmt { return mk_stmt(StmtKind.Block { body: body }); }
new_expr_stmt(lhs: *Expr): *Stmt { return mk_stmt(StmtKind.ExprStmt { lhs: lhs }); }
new_field_init(m: *Member, lhs: ?*Expr): *FieldInit {
    return new FieldInit { member: m, lhs: lhs, next: null };
}
new_heap_node(lhs: ?*Expr, val: int, inits: ?*FieldInit, variant: ?*Variant, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.New { lhs: lhs, val: val, inits: inits, variant: variant });
    n.ty = ty;
    return n;
}
new_struct_lit(inits: ?*FieldInit, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.StructLit { inits: inits });
    n.ty = ty;
    return n;
}
new_variant_lit(v: *Variant, val: int, inits: ?*FieldInit, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.VariantLit { variant: v, val: val, inits: inits });
    n.ty = ty;
    return n;
}
new_match(cond: *Expr, arms: ?*MatchArm): *Stmt { return mk_stmt(StmtKind.Match { cond: cond, arms: arms }); }
new_match_arm(variant: ?*Variant, binder: ?*Obj, body: *Stmt): *MatchArm {
    return new MatchArm { variant: variant, binder: binder, body: body, next: null };
}
new_raise(exn: *ExnDef, inits: ?*FieldInit): *Stmt { return mk_stmt(StmtKind.Raise { exn: exn, inits: inits }); }
new_try(body: *Stmt, arms: ?*CatchArm, buf: *Obj): *Stmt { return mk_stmt(StmtKind.Try { body: body, arms: arms, buf: buf }); }
new_catch_arm(exn: *ExnDef, binder: ?*Obj, body: *Stmt): *CatchArm {
    return new CatchArm { exn: exn, binder: binder, body: body, next: null };
}

find_function(name: *i8): ?*Function {
    b: int = sym_bucket(hash_str(name));
    fn: ?*Function = fn_buckets[b].head;
    while (fn != null) {
        if (streq(fn.name, name)) { return fn; }
        fn = fn.hash_next;
    }
    return null;
}

find_global(name: *i8): ?*Obj {
    b: int = sym_bucket(hash_str(name));
    o: ?*Obj = global_buckets[b].head;
    while (o != null) {
        if (streq(o.name, name)) { return o; }
        o = o.hash_next;
    }
    return null;
}

find_obj(list: ?*Obj, name: *i8): ?*Obj {
    if (list == globals) { return find_global(name); }
    o: ?*Obj = list;
    while (o != null) {
        if (streq(o.name, name)) { return o; }
        o = o.next;
    }
    return null;
}

find_local(name: *i8): ?*Obj {
    o: ?*Obj = locals;
    while (o != null) {
        if (o.scope_depth <= scope_depth) {
            if (streq(o.name, name)) { return o; }
        }
        o = o.next;
    }
    return null;
}

find_var(name: *i8): ?*Obj {
    o: ?*Obj = find_local(name);
    if (o != null) { return o; }
    return find_global(name);
}

enter_scope() { scope_depth = scope_depth + 1; }

leave_scope() raises Error {
    if (scope_depth <= 0) { error("internal: leave_scope"); }
    scope_depth = scope_depth - 1;
}

new_obj(name: *i8, is_local: int): *Obj {
    o: *Obj = new Obj {
        name: name,
        is_local: is_local,
        is_func: 0,
        offset: 0,
        scope_depth: 0,
        ty: null,
        used: 0,
        next: null,
        param_next: null,
        hash_next: null
    };
    if (is_local != 0) {
        o.scope_depth = scope_depth;
        o.next = locals;
        locals = o;
    } else {
        o.next = globals;
        globals = o;
        hash_put_global(o);
    }
    return o;
}

var_view_ty(var: ?*Obj): ?*Type {
    f: ?*NarrowFrame = narrow_top;
    while (f != null) {
        if (f.var == var) { return f.ty; }
        f = f.next;
    }
    if (var != null) { return var.ty; }
    return null;
}

narrow_push(var: ?*Obj, ty: ?*Type) {
    f: *NarrowFrame = new NarrowFrame {
        var: var,
        ty: ty,
        next: narrow_top
    };
    narrow_top = f;
}

narrow_reset(saved: ?*NarrowFrame) { narrow_top = saved; }

opt_local_var(n: ?*Expr) raises Error: ?*Obj {
    if (n != null) {
        match n.kind {
            Var k -> {
                var: ?*Obj = k.var;
                if (var != null) {
                    if (var.is_local == 0) { return null; }
                    t: ?*Type = decay(var.ty);
                    if (t != null && is_opt_pointer(t)) { return var; }
                    return null;
                }
                return null;
            }
            _ -> { return null; }
        }
    }
    return null;
}

null_sides(lhs: *Expr, rhs: *Expr) raises Error: ?*Obj {
    if (is_null_expr(rhs)) { return opt_local_var(lhs); }
    if (is_null_expr(lhs)) { return opt_local_var(rhs); }
    return null;
}

null_check_var(cond: ?*Expr) raises Error: ?*Obj {
    if (cond != null) {
        match cond.kind {
            Binary k -> {
                match k.op {
                    Ne -> { return null_sides(k.lhs, k.rhs); }
                    _ -> { return null; }
                }
            }
            _ -> { return null; }
        }
    }
    return null;
}

null_eq_var(cond: ?*Expr) raises Error: ?*Obj {
    if (cond != null) {
        match cond.kind {
            Binary k -> {
                match k.op {
                    Eq -> { return null_sides(k.lhs, k.rhs); }
                    _ -> { return null; }
                }
            }
            _ -> { return null; }
        }
    }
    return null;
}

narrow_push_ne_nulls(cond: ?*Expr) raises Error {
    if (cond != null) {
        match cond.kind {
            LogAnd k -> {
                narrow_push_ne_nulls(k.lhs);
                narrow_push_ne_nulls(k.rhs);
                return;
            }
            _ -> {
                v: ?*Obj = null_check_var(cond);
                if (v != null) {
                    vt: ?*Type = decay(v.ty);
                    if (vt == null) { error("missing type"); }
                    narrow_push(v, ptr_to(type_base(vt)));
                }
            }
        }
    }
}

narrow_push_eq_nulls(cond: ?*Expr) raises Error {
    if (cond != null) {
        match cond.kind {
            LogOr k -> {
                narrow_push_eq_nulls(k.lhs);
                narrow_push_eq_nulls(k.rhs);
                return;
            }
            _ -> {
                v: ?*Obj = null_eq_var(cond);
                if (v != null) {
                    vt: ?*Type = decay(v.ty);
                    if (vt == null) { error("missing type"); }
                    narrow_push(v, ptr_to(type_base(vt)));
                }
            }
        }
    }
}

decl_spec() raises Error: *Type {
    if (equal(TokKind.Int)) {
        tok = tok.next;
        return ty_int;
    }
    if (equal(TokKind.I8)) {
        tok = tok.next;
        return ty_i8;
    }
    if (equal(TokKind.Bool)) {
        tok = tok.next;
        return ty_bool;
    }
    if (equal(TokKind.Noreturn)) {
        tok = tok.next;
        return ty_noreturn;
    }
    if (equal(TokKind.Ident)) {
        name: *i8 = cur_tokstr();
        ed: ?*EnumDef = find_enum(name);
        if (ed != null) {
            tok = tok.next;
            return enum_type(ed);
        }
        xd: ?*ExnDef = find_exn(name);
        if (xd != null) {
            tok = tok.next;
            return exn_type(xd);
        }
        tok = tok.next;
        sd: *StructDef = get_or_create_struct(name);
        return struct_type(sd);
    }
    error("expected type");
}

parse_type() raises Error: *Type {
    if (equal(TokKind.Question)) {
        tok = tok.next;
        if (!equal(TokKind.Star)) { error("expected * after ? in optional pointer type"); }
        tok = tok.next;
        base: *Type = parse_type();
        if (is_noreturn_ty(base)) { error("noreturn cannot be pointed to"); }
        return opt_ptr_to(base);
    }
    if (equal(TokKind.Star)) {
        tok = tok.next;
        base: *Type = parse_type();
        if (is_noreturn_ty(base)) { error("noreturn cannot be pointed to"); }
        return ptr_to(base);
    }
    return decl_spec();
}

parse_expr() raises Error: *Expr { return parse_assign(); }

parse_field_inits(members: ?*Member) raises Error: *FieldInit {
    skip(TokKind.LBrace);
    head: ?*FieldInit = null;
    cur: ?*FieldInit = null;
    while (!equal(TokKind.RBrace)) {
        if (cur != null) { skip(TokKind.Comma); }
        if (!equal(TokKind.Ident)) { error("expected field name"); }
        fname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TokKind.Colon);
        m: ?*Member = find_field(members, fname);
        if (m == null) { error("unknown field"); }
        mu: *Member = m;
        i: ?*FieldInit = head;
        while (i != null) {
            if (i.member == mu) { error("duplicate field"); }
            i = i.next;
        }
        lhs: ?*Expr = null;
        if (equal(TokKind.Uninitialized)) {
            tok = tok.next;
        } else {
            e: *Expr = parse_expr();
            lhs = e;
        }
        init: *FieldInit = new_field_init(mu, lhs);
        if (cur != null) {
            cur.next = init;
            cur = init;
        } else {
            head = init;
            cur = init;
        }
    }
    m2: ?*Member = members;
    while (m2 != null) {
        found: int = 0;
        i2: ?*FieldInit = head;
        while (i2 != null) {
            if (i2.member == m2) { found = 1; }
            i2 = i2.next;
        }
        if (found == 0) { error("missing field"); }
        m2 = m2.next;
    }
    skip(TokKind.RBrace);
    return expect_field_init(head, "empty list");
}

parse_struct_field_inits(sty: *Type) raises Error: *FieldInit {
    if (!is_struct_ty(sty)) { error("struct literal requires a struct type"); }
    return parse_field_inits(type_struct_def(sty).members);
}

parse_exn_field_inits(ed: *ExnDef) raises Error: *FieldInit {
    if (ed.members == null) { error("unit exception does not take fields"); }
    return parse_field_inits(ed.members);
}

parse_variant_field_inits(v: *Variant) raises Error: *FieldInit { return parse_field_inits(v.fields); }

parse_primary() raises Error: *Expr {
    n: *Expr = uninitialized;
    if (equal(TokKind.New)) {
        tok = tok.next;
        if (is_type_name() && (tok.next).kind == TokKind.Dot) {
            ety: *Type = parse_type();
            if (!is_enum_ty(ety)) { error("new Enum.Variant requires an enum type"); }
            skip(TokKind.Dot);
            if (!equal(TokKind.Ident)) { error("expected variant name after new Enum."); }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            vo: ?*Variant = find_variant(type_enum_def(ety), vname);
            if (vo == null) { error("unknown variant"); }
            v: *Variant = vo;
            args: ?*FieldInit = null;
            if (equal(TokKind.LBrace)) {
                if (v.fields == null) { error("unit variant does not take fields"); }
                args = parse_variant_field_inits(v);
            } else {
                if (v.fields != null) { error("variant requires field initializers"); }
            }
            return new_heap_node(null, v.tag, args, v, ptr_to(ety));
        }
        base: *Type = parse_type();
        if (equal(TokKind.LBrack)) {
            tok = tok.next;
            len: *Expr = parse_expr();
            skip(TokKind.RBrack);
            if (is_pointer(base) || is_opt_pointer(base)) { error("new expects a non-pointer type"); }
            return new_heap_node(len, 1, null, null, ptr_to(base));
        }
        if (is_pointer(base)) { error("new expects a non-pointer type"); }
        if (equal(TokKind.Uninitialized)) {
            tok = tok.next;
            return new_heap_node(null, 1, null, null, ptr_to(base));
        }
        if (!equal(TokKind.LBrace)) {
            error("expected uninitialized, {, [, or .Variant after new");
        }
        if (is_enum_ty(base)) {
            error("use new Enum.Variant { ... } for sum types");
        }
        return new_heap_node(null, 0, parse_struct_field_inits(base), null, ptr_to(base));
    }
    if (equal(TokKind.Sizeof)) {
        tok = tok.next;
        skip(TokKind.LParen);
        if (starts_type()) {
            ty: *Type = parse_type();
            ty = parse_type_suffix(ty);
            skip(TokKind.RParen);
            return new_num(type_size(ty));
        }
        n = parse_expr();
        skip(TokKind.RParen);
        add_type(n);
        return new_num(type_size(expect_type(n.ty, "missing type")));
    }
    if (equal(TokKind.LParen)) {
        tok = tok.next;
        n = parse_expr();
        skip(TokKind.RParen);
        return n;
    }
    if (equal(TokKind.Num)) {
        n = new_num(tok.val);
        tok = tok.next;
        return n;
    }
    if (equal(TokKind.True) || equal(TokKind.False)) {
        bv: int = 0;
        if (equal(TokKind.True)) { bv = 1; }
        n = new_num(bv);
        n.ty = ty_bool;
        tok = tok.next;
        return n;
    }
    if (equal(TokKind.Null)) {
        tok = tok.next;
        return new_null_expr();
    }
    if (equal(TokKind.Char)) {
        n = new_num(tok.val);
        n.ty = ty_i8;
        tok = tok.next;
        return n;
    }
    if (equal(TokKind.Str)) {
        label: int = add_string(tok.str, tok.len);
        tok = tok.next;
        return new_str_num(label + 1);
    }
    if (equal(TokKind.Ident)) {
        name: *i8 = cur_tokstr();
        if (is_type_name() && (tok.next).kind == TokKind.Dot) {
            ety: *Type = parse_type();
            if (!is_enum_ty(ety)) { error("variant construction requires an enum type"); }
            skip(TokKind.Dot);
            if (!equal(TokKind.Ident)) { error("expected variant name"); }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            vo: ?*Variant = find_variant(type_enum_def(ety), vname);
            if (vo == null) { error("unknown variant"); }
            v: *Variant = vo;
            args: ?*FieldInit = null;
            if (equal(TokKind.LBrace)) {
                if (v.fields == null) { error("unit variant does not take fields"); }
                args = parse_variant_field_inits(v);
            } else {
                if (v.fields != null) { error("variant requires field initializers"); }
            }
            return new_variant_lit(v, v.tag, args, ety);
        }
        if (is_type_name() && (tok.next).kind == TokKind.LBrace) {
            sty: *Type = parse_type();
            if (!is_struct_ty(sty)) { error("struct literal requires a struct type"); }
            return new_struct_lit(parse_struct_field_inits(sty), sty);
        }
        tok = tok.next;
        if (equal(TokKind.LParen)) {
            tok = tok.next;
            head: ?*Expr = null;
            cur: ?*Expr = null;
            while (!equal(TokKind.RParen)) {
                if (cur != null) { skip(TokKind.Comma); }
                arg: *Expr = parse_expr();
                if (cur != null) {
                    cur.next = arg;
                    cur = arg;
                } else {
                    head = arg;
                    cur = arg;
                }
            }
            skip(TokKind.RParen);
            return new_funcall(name, head);
        }
        varo: ?*Obj = find_var(name);
        if (varo == null) { error("undefined variable"); }
        var: *Obj = varo;
        return new_var_node(var);
    }
    error("expected expression");
    return new_num(0);
}

parse_postfix() raises Error: *Expr {
    n: *Expr = parse_primary();
    while (true) {
        if (equal(TokKind.LBrack)) {
            tok = tok.next;
            idx: *Expr = parse_expr();
            skip(TokKind.RBrack);
            add_type(n);
            add_type(idx);
            idt: ?*Type = decay(idx.ty);
            if (idt == null) { error("array index must be int"); }
            if (!is_int_ty(idt)) { error("array index must be int"); }
            t: ?*Type = decay(n.ty);
            if (t == null) { error_ty("subscript of non-pointer", t); }
            if (!is_pointer(t)) { error_ty("subscript of non-pointer", t); }
            scaled: *Expr = new_binary(BinOp.Mul, idx, new_num(type_size(type_base(t))));
            n = new_deref(new_binary(BinOp.Add, n, scaled));
            n.ty = type_base(t);
        } else {
            if (equal(TokKind.Dot)) {
                if ((tok.next).kind == TokKind.Star) {
                    tok = tok.next;
                    tok = tok.next;
                    n = new_deref(n);
                } else {
                    tok = tok.next;
                    if (!equal(TokKind.Ident)) { error("expected member name"); }
                    name: *i8 = cur_tokstr();
                    tok = tok.next;
                    add_type(n);
                    t: ?*Type = decay(n.ty);
                    sty: *Type = expect_type(n.ty, "missing type");
                    if (t != null && is_opt_pointer(t)) {
                        error_ty("member access on optional pointer (use if (p != null) / while (p != null) to narrow)", t);
                    }
                    if (t != null && is_pointer(t) && is_struct_ty(type_base(t))) {
                        sty = type_base(t);
                    } else {
                        if (t != null && is_pointer(t) && is_exn_ty(type_base(t))) {
                            sty = type_base(t);
                        } else {
                            if (!is_struct_ty(sty) && !is_exn_ty(sty)) { error_ty("member access on non-struct", n.ty); }
                        }
                    }
                    m: ?*Member = null;
                    if (is_exn_ty(sty)) {
                        m = find_exn_member(type_exn_def(sty), name);
                    } else { m = find_member(type_struct_def(sty), name); }
                    if (m == null) { error("unknown member"); }
                    mu: *Member = m;
                    n = new_member_access(n, mu);
                }
            } else {
                if (equal(TokKind.As) || equal(TokKind.Trunc)) {
                    is_trunc: bool = equal(TokKind.Trunc);
                    tok = tok.next;
                    ty: *Type = parse_type();
                    ty = parse_type_suffix(ty);
                    if (is_trunc) {
                        n = new_trunc(n, ty);
                    } else { n = new_as(n, ty); }
                } else { return n; }
            }
        }
    }
    return n;
}

parse_unary() raises Error: *Expr {
    if (equal(TokKind.Plus)) {
        tok = tok.next;
        return parse_unary();
    }
    if (equal(TokKind.Minus)) {
        tok = tok.next;
        return new_neg(parse_unary());
    }
    if (equal(TokKind.Amp)) {
        tok = tok.next;
        return new_addr(parse_unary());
    }
    if (equal(TokKind.Not)) {
        tok = tok.next;
        return new_not(parse_unary());
    }
    return parse_postfix();
}

add_type(n: ?*Expr) raises Error {
    if (n != null) { add_type_expr(n); }
}

add_type_stmt(s: ?*Stmt) raises Error {
    if (s != null) { add_type_stmt_node(s); }
}

add_type_field_inits(inits: ?*FieldInit) raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        add_type(a.lhs);
        if (a.lhs != null) {
            if (!assignable(decay(a.member.ty), a.lhs)) {
                error_have_expr_want("field initializer type mismatch", a.lhs, decay(a.member.ty));
            }
        }
        a = a.next;
    }
}

type_log(p: *Expr, lhs: *Expr, rhs: *Expr, and_op: int) raises Error {
    add_type(lhs);
    save: ?*NarrowFrame = narrow_top;
    if (and_op != 0) {
        narrow_push_ne_nulls(lhs);
    } else { narrow_push_eq_nulls(lhs); }
    add_type(rhs);
    narrow_reset(save);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) { error_have_and("&& / || require bool operands", lt, rt); }
    if (rt == null) { error_have_and("&& / || require bool operands", lt, rt); }
    if (!is_bool_ty(lt) || !is_bool_ty(rt)) {
        error_have_and("&& / || require bool operands", lt, rt);
    }
    p.ty = ty_bool;
}

type_int_arith(p: *Expr, lhs: *Expr, rhs: *Expr) raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) { error_have_and("arithmetic requires int operands", lt, rt); }
    if (rt == null) { error_have_and("arithmetic requires int operands", lt, rt); }
    if (!is_int_ty(lt) || !is_int_ty(rt)) {
        error_have_and("arithmetic requires int operands", lt, rt);
    }
    p.ty = ty_int;
}

type_eq_cmp(p: *Expr, lhs: *Expr, rhs: *Expr) raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt != null && rt != null) {
        if (types_equal(lt, rt)) {
            p.ty = ty_bool;
            return;
        }
        if (is_any_pointer(lt) && is_any_pointer(rt) && types_equal(type_base(lt), type_base(rt))) {
            p.ty = ty_bool;
            return;
        }
    }
    if (bind_null_to_pointer(lt, rhs) || bind_null_to_pointer(rt, lhs)) {
        p.ty = ty_bool;
        return;
    }
    error_ty_vs("comparison type mismatch", lt, rt);
}

type_ord_cmp(p: *Expr, lhs: *Expr, rhs: *Expr) raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) { error_ty_vs("comparison type mismatch", lt, rt); }
    if (rt == null) { error_ty_vs("comparison type mismatch", lt, rt); }
    if (!types_equal(lt, rt)) {
        error_ty_vs("comparison type mismatch", lt, rt);
    }
    p.ty = ty_bool;
}

type_binary(p: *Expr, op: BinOp, lhs: *Expr, rhs: *Expr) raises Error {
    match op {
        Add -> {
            add_type(lhs);
            add_type(rhs);
            lt: ?*Type = decay(lhs.ty);
            rt: ?*Type = decay(rhs.ty);
            if (lt == null) { error_have_and("arithmetic requires int operands", lt, rt); }
            if (rt == null) { error_have_and("arithmetic requires int operands", lt, rt); }
            if (is_pointer(lt) && is_int_ty(rt)) { p.ty = lt; return; }
            if (is_int_ty(lt) && is_pointer(rt)) { p.ty = rt; return; }
            if (!is_int_ty(lt) || !is_int_ty(rt)) {
                error_have_and("arithmetic requires int operands", lt, rt);
            }
            p.ty = ty_int;
            return;
        }
        Sub -> {
            add_type(lhs);
            add_type(rhs);
            lt: ?*Type = decay(lhs.ty);
            rt: ?*Type = decay(rhs.ty);
            if (lt == null) { error_have_and("arithmetic requires int operands", lt, rt); }
            if (rt == null) { error_have_and("arithmetic requires int operands", lt, rt); }
            if (is_pointer(lt) && is_int_ty(rt)) { p.ty = lt; return; }
            if (is_pointer(lt) && is_pointer(rt)) {
                if (types_equal(lt, rt)) { p.ty = ty_int; return; }
            }
            if (!is_int_ty(lt) || !is_int_ty(rt)) {
                error_have_and("arithmetic requires int operands", lt, rt);
            }
            p.ty = ty_int;
            return;
        }
        Mul -> { type_int_arith(p, lhs, rhs); return; }
        Div -> { type_int_arith(p, lhs, rhs); return; }
        Mod -> { type_int_arith(p, lhs, rhs); return; }
        Eq -> { type_eq_cmp(p, lhs, rhs); return; }
        Ne -> { type_eq_cmp(p, lhs, rhs); return; }
        Lt -> { type_ord_cmp(p, lhs, rhs); return; }
        Le -> { type_ord_cmp(p, lhs, rhs); return; }
        Gt -> { type_ord_cmp(p, lhs, rhs); return; }
        Ge -> { type_ord_cmp(p, lhs, rhs); return; }
    }
}

add_type_expr(p: *Expr) raises Error {
    match p.kind {
        Var q -> {
            p.ty = var_view_ty(q.var);
            return;
        }
        As q -> {
            add_type(q.lhs);
            check_as(q.lhs.ty, p.ty);
            return;
        }
        Trunc q -> {
            add_type(q.lhs);
            check_trunc(q.lhs.ty, p.ty);
            return;
        }
        New k -> {
            lhs: ?*Expr = k.lhs;
            add_type(lhs);
            if (lhs != null) {
                lht: ?*Type = decay(lhs.ty);
                if (lht == null) { error_ty("array length must be int", lht); }
                if (!is_int_ty(lht)) {
                    error_ty("array length must be int", lht);
                }
            }
            add_type_field_inits(k.inits);
            return;
        }
        StructLit k -> {
            add_type_field_inits(k.inits);
            return;
        }
        VariantLit k -> {
            add_type_field_inits(k.inits);
            return;
        }
        MemberAccess q -> {
            add_type(q.lhs);
            t0: ?*Type = decay(q.lhs.ty);
            if (t0 != null && is_opt_pointer(t0)) {
                error_ty("member access on optional pointer (use if (p != null) / while (p != null) to narrow)", t0);
            }
            mem: *Member = q.member;
            p.ty = mem.ty;
            return;
        }
        _ -> {}
    }
    if (p.ty != null) { return; }
    match p.kind {
        LogAnd q -> { type_log(p, q.lhs, q.rhs, 1); return; }
        LogOr q -> { type_log(p, q.lhs, q.rhs, 0); return; }
        Num _p -> {
            p.ty = ty_int;
            return;
        }
        Null -> { return; }
        Binary q -> { type_binary(p, q.op, q.lhs, q.rhs); return; }
        Not q -> {
            add_type(q.lhs);
            nt: ?*Type = decay(q.lhs.ty);
            if (nt == null) { error_ty("! requires bool", nt); }
            if (!is_bool_ty(nt)) { error_ty("! requires bool", nt); }
            p.ty = ty_bool;
            return;
        }
        Neg q -> {
            add_type(q.lhs);
            nt: ?*Type = decay(q.lhs.ty);
            if (nt == null) { error_ty("unary - requires int", nt); }
            if (!is_int_ty(nt)) { error_ty("unary - requires int", nt); }
            p.ty = ty_int;
            return;
        }
        Assign q -> {
            add_type(q.lhs);
            add_type(q.rhs);
            lt: ?*Type = null;
            storage: ?*Type = q.lhs.ty;
            match q.lhs.kind {
                Var vp -> {
                    var: ?*Obj = vp.var;
                    if (var != null) {
                        storage = var.ty;
                        lt = decay(var.ty);
                    } else { lt = decay(q.lhs.ty); }
                }
                _ -> { lt = decay(q.lhs.ty); }
            }
            if (storage != null && is_array(storage)) { error("cannot assign to array"); }
            if (!assignable(lt, q.rhs)) {
                error_have_expr_want("assignment type mismatch", q.rhs, lt);
            }
            p.ty = storage;
            return;
        }
        Addr q -> {
            add_type(q.lhs);
            aty: ?*Type = q.lhs.ty;
            if (aty != null && is_array(aty)) {
                p.ty = ptr_to(type_base(aty));
            } else { p.ty = ptr_to(expect_type(aty, "missing type")); }
            return;
        }
        Deref q -> {
            add_type(q.lhs);
            t: ?*Type = decay(q.lhs.ty);
            if (t == null) { error_ty("dereferencing non-pointer", t); }
            if (is_opt_pointer(t)) {
                error_ty("dereferencing optional pointer (use if (p != null) / while (p != null) to narrow)", t);
            }
            if (is_pointer(t)) {
                p.ty = type_base(t);
            } else { error_ty("dereferencing non-pointer", t); }
            return;
        }
        Funcall q -> {
            a: ?*Expr = q.args;
            while (a != null) {
                add_type(a);
                a = a.next;
            }
            fno: ?*Function = find_function(q.funcname);
            p.kind = ExprKind.Funcall { funcname: q.funcname, args: q.args, fn: fno };
            fo: ?*Obj = find_obj(globals, q.funcname);
            if (fno != null) {
                if (fno.return_ty != null) {
                    p.ty = fno.return_ty;
                } else { p.ty = ty_int; }
            } else {
                if (fo != null) {
                    if (fo.is_func != 0) {
                        if (fo.ty != null) {
                            p.ty = fo.ty;
                        } else { p.ty = ty_int; }
                    } else { p.ty = ty_int; }
                } else {
                    if (streq(q.funcname, "exit")) {
                        p.ty = ty_noreturn;
                    } else { p.ty = ty_int; }
                }
            }
            if (fno != null) {
                a = q.args;
                po: ?*Obj = fno.params;
                while (a != null) {
                    if (po != null) {
                        if (po.ty != null) {
                            pt: ?*Type = decay(po.ty);
                            if (!assignable(pt, a)) {
                                error_have_expr_want("argument type mismatch", a, pt);
                            }
                        }
                        po = po.param_next;
                    }
                    a = a.next;
                }
                er: ?*ExnList = fno.raises_list;
                while (er != null) {
                    check_exn_allowed(er.exn, "call raises");
                    er = er.next;
                }
            }
            return;
        }
        _ -> {}
    }
}

add_type_stmt_node(p: *Stmt) raises Error {
    match p.kind {
        If k -> {
            add_type(k.cond);
            ct: ?*Type = decay(k.cond.ty);
            if (ct == null || !is_bool_ty(ct)) { error_ty("condition must be bool", ct); }
            save: ?*NarrowFrame = narrow_top;
            narrow_push_ne_nulls(k.cond);
            add_type_stmt(k.then);
            narrow_reset(save);
            els: ?*Stmt = k.els;
            if (els != null) {
                narrow_push_eq_nulls(k.cond);
                add_type_stmt(els);
                narrow_reset(save);
            }
            return;
        }
        While k -> {
            add_type(k.cond);
            ct2: ?*Type = decay(k.cond.ty);
            if (ct2 == null || !is_bool_ty(ct2)) { error_ty("condition must be bool", ct2); }
            save2: ?*NarrowFrame = narrow_top;
            narrow_push_ne_nulls(k.cond);
            add_type_stmt(k.body);
            narrow_reset(save2);
            return;
        }
        Try k -> {
            saved_c: ?*CatchFrame = catch_top;
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                catch_push(arm.exn);
                arm = arm.next;
            }
            add_type_stmt(k.body);
            catch_reset(saved_c);
            arm = k.arms;
            while (arm != null) {
                add_type_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Raise k -> {
            check_exn_allowed(k.exn, "raise");
            add_type_field_inits(k.inits);
            return;
        }
        Block q -> {
            a: ?*Stmt = q.body;
            while (a != null) {
                add_type_stmt(a);
                match a.kind {
                    If k -> {
                        if (k.els == null) {
                            if (stmt_always_diverges(k.then)) {
                                narrow_push_eq_nulls(k.cond);
                            }
                        }
                    }
                    _ -> {}
                }
                a = a.next;
            }
            return;
        }
        Return k -> {
            crt: ?*Type = current_return_ty;
            if (crt != null && is_noreturn_ty(crt)) {
                error("noreturn function cannot return");
            }
            lhs: ?*Expr = k.lhs;
            add_type(lhs);
            if (lhs != null) {
                if (current_return_ty == null) { error("return with a value in a non-returning function"); }
                rt: ?*Type = decay(current_return_ty);
                if (!assignable(rt, lhs)) {
                    error_have_expr_want("return type mismatch", lhs, rt);
                }
            } else {
                if (current_return_ty != null) {
                    error_ty("return missing a value", current_return_ty);
                }
            }
            return;
        }
        ExprStmt k -> {
            add_type(k.lhs);
            return;
        }
        Match k -> {
            add_type(k.cond);
            a5: ?*MatchArm = k.arms;
            while (a5 != null) {
                add_type_stmt(a5.body);
                a5 = a5.next;
            }
            return;
        }
        _ -> {}
    }
}

parse_mul() raises Error: *Expr {
    n: *Expr = parse_unary();
    while (true) {
        if (equal(TokKind.Star)) {
            tok = tok.next;
            n = new_binary(BinOp.Mul, n, parse_unary());
        } else if (equal(TokKind.Slash)) {
            tok = tok.next;
            n = new_binary(BinOp.Div, n, parse_unary());
        } else if (equal(TokKind.Percent)) {
            tok = tok.next;
            n = new_binary(BinOp.Mod, n, parse_unary());
        } else { return n; }
    }
    return n;
}

parse_add() raises Error: *Expr {
    n: *Expr = parse_mul();
    while (true) {
        if (equal(TokKind.Plus)) {
            tok = tok.next;
            n = new_binary(BinOp.Add, n, parse_mul());
        } else if (equal(TokKind.Minus)) {
            tok = tok.next;
            n = new_binary(BinOp.Sub, n, parse_mul());
        } else { return n; }
    }
    return n;
}

parse_relational() raises Error: *Expr {
    n: *Expr = parse_add();
    while (true) {
        if (equal(TokKind.Lt)) {
            tok = tok.next;
            n = new_binary(BinOp.Lt, n, parse_add());
        } else if (equal(TokKind.Gt)) {
            tok = tok.next;
            n = new_binary(BinOp.Gt, n, parse_add());
        } else if (equal(TokKind.Le)) {
            tok = tok.next;
            n = new_binary(BinOp.Le, n, parse_add());
        } else if (equal(TokKind.Ge)) {
            tok = tok.next;
            n = new_binary(BinOp.Ge, n, parse_add());
        } else { return n; }
    }
    return n;
}

parse_equality() raises Error: *Expr {
    n: *Expr = parse_relational();
    while (true) {
        if (equal(TokKind.Eq)) {
            tok = tok.next;
            n = new_binary(BinOp.Eq, n, parse_relational());
        } else if (equal(TokKind.Ne)) {
            tok = tok.next;
            n = new_binary(BinOp.Ne, n, parse_relational());
        } else { return n; }
    }
    return n;
}

parse_logand() raises Error: *Expr {
    n: *Expr = parse_equality();
    while (equal(TokKind.And)) {
        tok = tok.next;
        n = new_logand(n, parse_equality());
    }
    return n;
}

parse_logor() raises Error: *Expr {
    n: *Expr = parse_logand();
    while (equal(TokKind.Or)) {
        tok = tok.next;
        n = new_logor(n, parse_logand());
    }
    return n;
}

parse_assign() raises Error: *Expr {
    n: *Expr = parse_logor();
    if (equal(TokKind.Assign)) {
        tok = tok.next;
        return new_assign(n, parse_assign());
    }
    return n;
}

parse_type_suffix(ty: *Type) raises Error: *Type {
    if (equal(TokKind.LBrack)) {
        if (is_noreturn_ty(ty)) { error("noreturn cannot be an array element"); }
        tok = tok.next;
        if (!equal(TokKind.Num)) { error("expected array size"); }
        ty = array_of(ty, tok.val);
        tok = tok.next;
        skip(TokKind.RBrack);
    }
    return ty;
}

parse_decl(is_local: int) raises Error: *Obj {
    if (!equal(TokKind.Ident)) { error("expected identifier"); }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Colon);
    ty: *Type = parse_type();
    ty = parse_type_suffix(ty);
    if (is_noreturn_ty(ty)) { error("noreturn is only valid as a function return type"); }
    o: *Obj = new_obj(name, is_local);
    o.ty = ty;
    return o;
}

parse_compound() raises Error: *Stmt {
    enter_scope();
    skip(TokKind.LBrace);
    head: ?*Stmt = null;
    cur: ?*Stmt = null;
    while (!equal(TokKind.RBrace)) {
        if (equal(TokKind.Eof)) { error("unterminated block"); }
        s: *Stmt = parse_stmt();
        if (cur != null) {
            cur.next = s;
            cur = s;
        } else {
            head = s;
            cur = s;
        }
    }
    skip(TokKind.RBrace);
    leave_scope();
    return new_block(head);
}

parse_stmt() raises Error: *Stmt {
    if (equal(TokKind.Return)) {
        tok = tok.next;
        lhs: ?*Expr = null;
        if (!equal(TokKind.Semi)) { lhs = parse_expr(); }
        skip(TokKind.Semi);
        return new_return(lhs);
    }
    if (equal(TokKind.Raise)) {
        tok = tok.next;
        if (!equal(TokKind.Ident)) { error("expected exception name after raise"); }
        ename: *i8 = cur_tokstr();
        ed: ?*ExnDef = find_exn(ename);
        if (ed == null) { error("unknown exception"); }
        edu: *ExnDef = ed;
        tok = tok.next;
        rargs: ?*FieldInit = null;
        if (equal(TokKind.LBrace)) {
            rargs = parse_exn_field_inits(edu);
        } else {
            if (edu.members != null) { error("exception requires field initializers"); }
        }
        skip(TokKind.Semi);
        return new_raise(edu, rargs);
    }
    if (equal(TokKind.Try)) {
        tok = tok.next;
        tbody: *Stmt = parse_compound();
        arms_h: ?*CatchArm = null;
        arms_c: ?*CatchArm = null;
        if (!equal(TokKind.With)) { error("try requires at least one with arm"); }
        while (equal(TokKind.With)) {
            tok = tok.next;
            if (!equal(TokKind.Ident)) { error("expected exception name in with arm"); }
            cname: *i8 = cur_tokstr();
            ced: ?*ExnDef = find_exn(cname);
            if (ced == null) { error("unknown exception"); }
            cedu: *ExnDef = ced;
            tok = tok.next;
            a: ?*CatchArm = arms_h;
            while (a != null) {
                if (a.exn == cedu) { error("duplicate with arm"); }
                a = a.next;
            }
            enter_scope();
            binder: ?*Obj = null;
            if (equal(TokKind.LParen)) {
                /* Legacy Name(x); prefer Name x. */
                tok = tok.next;
                if (!equal(TokKind.Ident)) { error("expected binder name"); }
                bname: *i8 = cur_tokstr();
                tok = tok.next;
                skip(TokKind.RParen);
                bo: *Obj = new_obj(bname, 1);
                bo.ty = exn_type(cedu);
                binder = bo;
            } else {
                if (equal(TokKind.Ident)) {
                    bname2: *i8 = cur_tokstr();
                    tok = tok.next;
                    bo2: *Obj = new_obj(bname2, 1);
                    bo2.ty = exn_type(cedu);
                    binder = bo2;
                } else {
                    if (cedu.members != null) { error("payload exception requires a binder (Name name)"); }
                }
            }
            skip(TokKind.Arrow);
            abody: *Stmt = parse_compound();
            leave_scope();
            armn: *CatchArm = new_catch_arm(cedu, binder, abody);
            if (arms_c != null) {
                arms_c.next = armn;
                arms_c = armn;
            } else {
                arms_h = armn;
                arms_c = armn;
            }
        }
        buf: *Obj = new_obj(".trybuf", 1);
        buf.ty = array_of(ty_i8, L8_JMP_BUF_SIZE);
        return new_try(tbody, arms_h, buf);
    }
    if (equal(TokKind.If)) {
        tok = tok.next;
        skip(TokKind.LParen);
        cond: *Expr = parse_expr();
        skip(TokKind.RParen);
        save: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(cond);
        then: *Stmt = parse_stmt();
        narrow_reset(save);
        els: ?*Stmt = null;
        if (equal(TokKind.Else)) {
            tok = tok.next;
            narrow_push_eq_nulls(cond);
            els = parse_stmt();
            narrow_reset(save);
        } else {
            /* if (x == null) { return/error/...; } → x is non-null afterward */
            if (stmt_parse_diverges(then)) {
                narrow_push_eq_nulls(cond);
            }
        }
        return new_if(cond, then, els);
    }
    if (equal(TokKind.While)) {
        tok = tok.next;
        skip(TokKind.LParen);
        cond2: *Expr = parse_expr();
        skip(TokKind.RParen);
        save2: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(cond2);
        body: *Stmt = parse_stmt();
        narrow_reset(save2);
        return new_while(cond2, body);
    }
    if (equal(TokKind.Match)) {
        tok = tok.next;
        mcond: *Expr = parse_expr();
        add_type(mcond);
        et: ?*Type = decay(mcond.ty);
        if (et == null) { error_ty("match requires an enum value", et); }
        if (!is_enum_ty(et)) { error_ty("match requires an enum value", et); }
        skip(TokKind.LBrace);
        arms: ?*MatchArm = null;
        acur: ?*MatchArm = null;
        while (!equal(TokKind.RBrace)) {
            if (!equal(TokKind.Ident)) { error("expected variant name in match arm"); }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            is_wild: bool = streq(vname, "_");
            binder_name: ?*i8 = null;
            if (equal(TokKind.LParen)) {
                /* Legacy Variant(name); prefer Variant name. */
                if (is_wild) { error("wildcard match arm cannot bind a payload"); }
                tok = tok.next;
                if (!equal(TokKind.Ident)) { error("expected payload binding name"); }
                binder_name = cur_tokstr();
                tok = tok.next;
                skip(TokKind.RParen);
            } else {
                if (equal(TokKind.Ident)) {
                    if (is_wild) { error("wildcard match arm cannot bind a payload"); }
                    binder_name = cur_tokstr();
                    tok = tok.next;
                } else {
                    if (equal(TokKind.LBrace)) {
                        error("match field destructuring is not supported; use Variant name and field access");
                    }
                }
            }
            skip(TokKind.Arrow);
            enter_scope();
            arm_variant_n: ?*Variant = null;
            arm_binder: ?*Obj = null;
            if (is_wild) {
                chk: ?*MatchArm = arms;
                while (chk != null) {
                    if (chk.variant == null) { error("duplicate wildcard match arm"); }
                    chk = chk.next;
                }
                if (binder_name != null) { error("wildcard match arm cannot bind a payload"); }
            } else {
                vo: ?*Variant = find_variant(type_enum_def(et), vname);
                if (vo == null) { error("unknown variant"); }
                v: *Variant = vo;
                chk2: ?*MatchArm = arms;
                while (chk2 != null) {
                    if (chk2.variant == v) { error("duplicate match arm"); }
                    chk2 = chk2.next;
                }
                arm_variant_n = v;
                if (binder_name != null) {
                    if (v.payload_ty == null) { error("unit variant cannot bind a payload"); }
                    bname: *i8 = binder_name;
                    bo: *Obj = new_obj(bname, 1);
                    bo.ty = v.payload_ty;
                    arm_binder = bo;
                }
            }
            arm_body_n: *Stmt = parse_compound();
            leave_scope();
            arm: *MatchArm = new_match_arm(arm_variant_n, arm_binder, arm_body_n);
            if (acur != null) {
                acur.next = arm;
                acur = arm;
            } else {
                arms = arm;
                acur = arm;
            }
            if (is_wild) {
                if (!equal(TokKind.RBrace)) { error("wildcard `_` must be the last match arm"); }
            }
        }
        has_wild: int = 0;
        walk: ?*MatchArm = arms;
        while (walk != null) {
            if (walk.variant == null) { has_wild = 1; }
            walk = walk.next;
        }
        if (has_wild == 0) {
            vv: ?*Variant = type_enum_def(et).variants;
            while (vv != null) {
                found2: int = 0;
                walk2: ?*MatchArm = arms;
                while (walk2 != null) {
                    if (walk2.variant == vv) { found2 = 1; }
                    walk2 = walk2.next;
                }
                if (found2 == 0) { error("match not exhaustive"); }
                vv = vv.next;
            }
        }
        tok = tok.next;
        return new_match(mcond, arms);
    }
    if (equal(TokKind.LBrace)) { return parse_compound(); }
    if (equal(TokKind.Ident) && (tok.next).kind == TokKind.Colon) {
        o: *Obj = parse_decl(1);
        if (equal(TokKind.Comma)) { error("only one variable per declaration"); }
        skip(TokKind.Assign);
        if (equal(TokKind.Uninitialized)) {
            tok = tok.next;
            skip(TokKind.Semi);
            return new_block(null);
        }
        rhs: *Expr = parse_expr();
        skip(TokKind.Semi);
        return new_expr_stmt(new_assign(new_var_node(o), rhs));
    }
    e: *Expr = parse_expr();
    skip(TokKind.Semi);
    return new_expr_stmt(e);
}

fn_param(fn: *Function, i: int): ?*Obj {
    p: ?*Obj = fn.params;
    n: int = 0;
    while (p != null) {
        if (n == i) { return p; }
        n = n + 1;
        p = p.param_next;
    }
    return null;
}

append_fn_param(fn: *Function, p: *Obj) {
    p.param_next = null;
    if (fn.params == null) {
        fn.params = p;
        return;
    }
    cur: ?*Obj = fn.params;
    while (cur != null) {
        if (cur.param_next == null) {
            cur.param_next = p;
            return;
        }
        cur = cur.param_next;
    }
}

parse_function(name: *i8) raises Error: *Function {
    fn: *Function = new Function {
        name: name,
        nparams: 0,
        params: null,
        locals: null,
        body: null,
        stack_size: 0,
        return_ty: null,
        sret: null,
        raises_list: null,
        used: 0,
        next: null,
        hash_next: null
    };
    locals = null;
    scope_depth = 0;
    narrow_top = null;
    catch_top = null;
    current_fn = fn;
    skip(TokKind.LParen);
    np: int = 0;
    while (!equal(TokKind.RParen)) {
        if (np != 0) { skip(TokKind.Comma); }
        if (np >= 6) { error("too many parameters"); }
        p: *Obj = parse_decl(1);
        append_fn_param(fn, p);
        np = np + 1;
    }
    fn.nparams = np;
    skip(TokKind.RParen);
    if (equal(TokKind.Raises)) {
        tok = tok.next;
        rtail: ?*ExnList = null;
        rdone: int = 0;
        while (rdone == 0) {
            if (!equal(TokKind.Ident)) { error("expected exception type after raises"); }
            ename: *i8 = cur_tokstr();
            ed: ?*ExnDef = find_exn(ename);
            if (ed == null) { error("unknown exception"); }
            edu: *ExnDef = ed;
            if (exn_in_list(fn.raises_list, edu)) { error("duplicate raises"); }
            el: *ExnList = new ExnList { exn: edu, seen: 0, next: null };
            if (rtail != null) {
                rtail.next = el;
                rtail = el;
            } else {
                fn.raises_list = el;
                rtail = el;
            }
            tok = tok.next;
            if (equal(TokKind.Comma)) {
                tok = tok.next;
            } else { rdone = 1; }
        }
    }
    if (equal(TokKind.Colon)) {
        tok = tok.next;
        fn.return_ty = parse_type();
    }
    rt: ?*Type = fn.return_ty;
    if (rt != null && passes_by_ref(rt)) {
        if (fn.nparams >= 6) { error("too many parameters"); }
        sret: *Obj = new_obj(".sret", 1);
        sret.ty = ptr_to(rt);
        fn.sret = sret;
    }
    fn.body = parse_compound();
    fn.locals = locals;
    narrow_top = null;
    catch_top = null;
    current_fn = null;
    return fn;
}

parse_field_list(base_offset: int) raises Error: *Member {
    head: ?*Member = null;
    cur: ?*Member = null;
    offset: int = base_offset;
    while (!equal(TokKind.RBrace)) {
        if (!equal(TokKind.Ident)) { error("expected field name"); }
        mname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TokKind.Colon);
        mty: *Type = parse_type();
        mty = parse_type_suffix(mty);
        if (is_noreturn_ty(mty)) { error("noreturn cannot be a field type"); }
        m: *Member = new Member {
            name: mname,
            offset: offset,
            ty: mty,
            next: null
        };
        sz: int = type_size(mty);
        if (sz <= 0) { sz = 8; }
        offset = offset + ((sz + 7) / 8 * 8);
        if (cur != null) {
            cur.next = m;
            cur = m;
        } else {
            head = m;
            cur = m;
        }
        if (equal(TokKind.Semi) || equal(TokKind.Comma)) {
            tok = tok.next;
        } else {
            if (!equal(TokKind.RBrace)) { error("expected `;`, `,`, or `}` after field"); }
        }
    }
    field_list_size = offset - base_offset;
    tok = tok.next;
    return expect_member(head, "empty members");
}

parse_variant(tag: int, enum_name: *i8) raises Error: *Variant {
    if (!equal(TokKind.Ident)) { error("expected variant name"); }
    v: *Variant = new Variant {
        name: cur_tokstr(),
        tag: tag,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        next: null
    };
    tok = tok.next;
    if (equal(TokKind.LBrace)) {
        tok = tok.next;
        v.fields = parse_field_list(0);
        v.payload_size = field_list_size;
        sd: *StructDef = new StructDef {
            name: variant_payload_name(enum_name, v.name),
            members: v.fields,
            size: field_list_size,
            ty: null,
            next: null,
            hash_next: null
        };
        v.payload_ty = struct_type(sd);
    }
    return v;
}

parse_exception_def() raises Error {
    tok = tok.next;
    if (!equal(TokKind.Ident)) { error("expected exception name"); }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    if (find_exn(name) != null || find_struct(name) != null || find_enum(name) != null) { error("redefinition"); }
    ed: *ExnDef = new ExnDef {
        name: name,
        tag: next_exn_tag,
        members: null,
        size: 0,
        ty: null,
        next: exn_defs,
        hash_next: null
    };
    next_exn_tag = next_exn_tag + 1;
    exn_defs = ed;
    hash_put_exn(ed);
    if (equal(TokKind.LBrace)) {
        tok = tok.next;
        ed.members = parse_field_list(0);
        ed.size = field_list_size;
        skip(TokKind.Semi);
    } else { skip(TokKind.Semi); }
    exn_type(ed);
}

parse_type_def() raises Error {
    tok = tok.next;
    if (!equal(TokKind.Ident)) { error("expected type name"); }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Assign);

    if (equal(TokKind.LBrace)) {
        if (find_enum(name) != null) { error("redefinition of type"); }
        sd: *StructDef = get_or_create_struct(name);
        if (sd.members != null) { error("redefinition of type"); }
        tok = tok.next;
        sd.members = parse_field_list(0);
        sd.size = field_list_size;
        skip(TokKind.Semi);
        return;
    }

    stub: ?*StructDef = find_struct(name);
    if (stub != null) {
        if (stub.members != null) { error("redefinition of type"); }
        remove_struct(name);
    }
    ed: *EnumDef = get_or_create_enum(name);
    if (ed.variants != null) { error("redefinition of type"); }

    if (equal(TokKind.Pipe)) { tok = tok.next; }

    head: ?*Variant = null;
    cur: ?*Variant = null;
    tag: int = 0;
    max_payload: int = 0;
    done: int = 0;
    while (done == 0) {
        v: *Variant = parse_variant(tag, name);
        x: ?*Variant = head;
        while (x != null) {
            if (streq(x.name, v.name)) { error("duplicate variant"); }
            x = x.next;
        }
        if (v.payload_size > max_payload) { max_payload = v.payload_size; }
        if (cur != null) {
            cur.next = v;
            cur = v;
        } else {
            head = v;
            cur = v;
        }
        tag = tag + 1;
        if (equal(TokKind.Pipe)) {
            tok = tok.next;
        } else { done = 1; }
    }
    if (head == null) { error("enum type needs at least one variant"); }
    ed.variants = head;
    ed.size = 8 + max_payload;
    if (stub != null) {
        if (stub.ty != null) { rebind_struct_stub_to_enum(stub, ed); }
    }
    skip(TokKind.Semi);
}

parse_source_file(path: *i8) raises Error {
    if (!mark_imported(path)) { return; }
    saved_source: *i8 = source;
    saved_source_len: int = source_len;
    saved_pos: int = pos;
    saved_tok: *Token = tok;
    saved_path: *i8 = source_path;
    source_path = path;
    source = read_file(path);
    tok = tokenize();
    parse_program_unit();
    source = saved_source;
    source_len = saved_source_len;
    pos = saved_pos;
    tok = saved_tok;
    source_path = saved_path;
}

parse_import() raises Error {
    tok = tok.next;
    if (!equal(TokKind.Str)) { error("expected string path after import"); }
    relative: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Semi);
    path: *i8 = resolve_import_path(source_path, relative);
    parse_source_file(path);
}

append_function(fn: *Function) {
    tail: ?*Function = function_tail;
    if (tail != null) {
        tail.next = fn;
        function_tail = fn;
    } else {
        functions = fn;
        function_tail = fn;
    }
}

parse_program_unit() raises Error {
    while (!equal(TokKind.Eof)) {
        if (equal(TokKind.Import)) {
            parse_import();
        } else if (equal(TokKind.TypeKw) && (tok.next).kind == TokKind.Ident && ((tok.next).next).kind == TokKind.Assign) {
            parse_type_def();
        } else {
            if (equal(TokKind.Exception)) {
                parse_exception_def();
            } else {
            if (!equal(TokKind.Ident)) { error("expected identifier"); }
            name: *i8 = cur_tokstr();
            tok = tok.next;
            if (equal(TokKind.LParen)) {
                fn: *Function = parse_function(name);
                append_function(fn);
                hash_put_fn(fn);
                o: *Obj = new_obj(name, 0);
                o.is_func = 1;
                o.ty = fn.return_ty;
            } else {
                skip(TokKind.Colon);
                ty: *Type = parse_type();
                ty = parse_type_suffix(ty);
                if (is_noreturn_ty(ty)) { error("noreturn is only valid as a function return type"); }
                if (equal(TokKind.Comma)) { error("only one variable per declaration"); }
                o2: *Obj = new_obj(name, 0);
                o2.ty = ty;
                skip(TokKind.Semi);
            }
            }
        }
    }
}

parse_program(entry_path: *i8) raises Error {
    functions = null;
    function_tail = null;
    globals = null;
    struct_defs = null;
    enum_defs = null;
    exn_defs = null;
    imported_files = null;
    next_exn_tag = 1;
    clear_sym_tables();
    parse_source_file(normalize_path(entry_path));
}

/* Assumes n is already typed. True if execution cannot fall through. */
/* Syntactic divergence for parse-time early-exit narrowing (no full typing). */
stmt_parse_diverges(n: *Stmt): bool {
    match n.kind {
        Return _p -> { return true; }
        Raise _p -> { return true; }
        ExprStmt q -> {
            match q.lhs.kind {
                Funcall k -> {
                    if (streq(k.funcname, "exit")) { return true; }
                    fno: ?*Function = find_function(k.funcname);
                    if (fno != null) {
                        frt: ?*Type = fno.return_ty;
                        if (frt != null && is_noreturn_ty(frt)) { return true; }
                    }
                    return false;
                }
                _ -> { return false; }
            }
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_parse_diverges(s)) { return true; }
                s = s.next;
            }
            return false;
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                return stmt_parse_diverges(k.then) && stmt_parse_diverges(els);
            }
            return false;
        }
        Match k -> {
            if (k.arms == null) { return false; }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!stmt_parse_diverges(arm.body)) { return false; }
                arm = arm.next;
            }
            return true;
        }
        Try k -> {
            if (!stmt_parse_diverges(k.body)) { return false; }
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!stmt_parse_diverges(arm2.body)) { return false; }
                arm2 = arm2.next;
            }
            return true;
        }
        _ -> { return false; }
    }
}

stmt_always_diverges(n: *Stmt): bool {
    match n.kind {
        Return _p -> { return true; }
        Raise _p -> { return true; }
        ExprStmt k -> {
            lty: ?*Type = k.lhs.ty;
            return lty != null && is_noreturn_ty(lty);
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_always_diverges(s)) { return true; }
                s = s.next;
            }
            return false;
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                return stmt_always_diverges(k.then) && stmt_always_diverges(els);
            }
            return false;
        }
        Match k -> {
            if (k.arms == null) { return false; }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!stmt_always_diverges(arm.body)) { return false; }
                arm = arm.next;
            }
            return true;
        }
        Try k -> {
            if (!stmt_always_diverges(k.body)) { return false; }
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!stmt_always_diverges(arm2.body)) { return false; }
                arm2 = arm2.next;
            }
            return true;
        }
        _ -> { return false; }
    }
}

stmt_diverges(n: *Stmt): bool {
    return stmt_always_diverges(n);
}

check_noreturn_functions() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        frt: ?*Type = fn.return_ty;
        if (frt != null && is_noreturn_ty(frt)) {
            body: ?*Stmt = fn.body;
            if (body == null || !stmt_diverges(body)) { error("noreturn function may return"); }
        }
        fn = fn.next;
    }
}

mark_calls_field_inits(inits: ?*FieldInit) {
    a: ?*FieldInit = inits;
    while (a != null) {
        mark_calls_expr(a.lhs);
        a = a.next;
    }
}

mark_calls_expr(n: ?*Expr) {
    if (n == null) { return; }
    match n.kind {
        Num _p -> { return; }
        Null -> { return; }
        Var _p -> { return; }
        Binary k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        Assign k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        Addr k -> { mark_calls_expr(k.lhs); return; }
        Deref k -> { mark_calls_expr(k.lhs); return; }
        Not k -> { mark_calls_expr(k.lhs); return; }
        Neg k -> { mark_calls_expr(k.lhs); return; }
        LogAnd k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        LogOr k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        Funcall k -> {
            callee: ?*Function = k.fn;
            if (callee != null) { mark_reachable(callee); }
            a: ?*Expr = k.args;
            while (a != null) {
                mark_calls_expr(a);
                a = a.next;
            }
            return;
        }
        MemberAccess k -> { mark_calls_expr(k.lhs); return; }
        As k -> { mark_calls_expr(k.lhs); return; }
        Trunc k -> { mark_calls_expr(k.lhs); return; }
        New k -> {
            mark_calls_expr(k.lhs);
            mark_calls_field_inits(k.inits);
            return;
        }
        StructLit k -> {
            mark_calls_field_inits(k.inits);
            return;
        }
        VariantLit k -> {
            mark_calls_field_inits(k.inits);
            return;
        }
    }
}

mark_calls_stmt(n: ?*Stmt) {
    if (n == null) { return; }
    match n.kind {
        Return k -> { mark_calls_expr(k.lhs); return; }
        ExprStmt k -> { mark_calls_expr(k.lhs); return; }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                mark_calls_stmt(s);
                s = s.next;
            }
            return;
        }
        If k -> {
            mark_calls_expr(k.cond);
            mark_calls_stmt(k.then);
            mark_calls_stmt(k.els);
            return;
        }
        While k -> {
            mark_calls_expr(k.cond);
            mark_calls_stmt(k.body);
            return;
        }
        Match k -> {
            mark_calls_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                mark_calls_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Raise k -> {
            mark_calls_field_inits(k.inits);
            return;
        }
        Try k -> {
            mark_calls_stmt(k.body);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                mark_calls_stmt(arm2.body);
                arm2 = arm2.next;
            }
            return;
        }
    }
}

mark_reachable(fn: *Function) {
    if (fn.used != 0) { return; }
    fn.used = 1;
    mark_calls_stmt(fn.body);
}

check_unused_functions() {
    fn: ?*Function = functions;
    while (fn != null) {
        fn.used = 0;
        fn = fn.next;
    }
    main_fn: ?*Function = find_function("main");
    if (main_fn == null) { return; }
    mark_reachable(main_fn);
    fn = functions;
    while (fn != null) {
        if (fn.used == 0) { warn_unused_function(fn.name); }
        fn = fn.next;
    }
}

mark_var_use(var: ?*Obj) {
    if (var != null) { var.used = 1; }
}

mark_uses_field_inits(inits: ?*FieldInit) {
    a: ?*FieldInit = inits;
    while (a != null) {
        mark_uses_expr(a.lhs);
        a = a.next;
    }
}

mark_uses_expr(n: ?*Expr) {
    if (n == null) { return; }
    match n.kind {
        Num _p -> { return; }
        Null -> { return; }
        Var k -> { mark_var_use(k.var); return; }
        Binary k -> {
            mark_uses_expr(k.lhs);
            mark_uses_expr(k.rhs);
            return;
        }
        Assign k -> {
            mark_uses_expr(k.rhs);
            match k.lhs.kind {
                Var _p -> { return; }
                _ -> { mark_uses_expr(k.lhs); return; }
            }
        }
        Addr k -> { mark_uses_expr(k.lhs); return; }
        Deref k -> { mark_uses_expr(k.lhs); return; }
        Not k -> { mark_uses_expr(k.lhs); return; }
        Neg k -> { mark_uses_expr(k.lhs); return; }
        LogAnd k -> {
            mark_uses_expr(k.lhs);
            mark_uses_expr(k.rhs);
            return;
        }
        LogOr k -> {
            mark_uses_expr(k.lhs);
            mark_uses_expr(k.rhs);
            return;
        }
        Funcall k -> {
            a: ?*Expr = k.args;
            while (a != null) {
                mark_uses_expr(a);
                a = a.next;
            }
            return;
        }
        MemberAccess k -> { mark_uses_expr(k.lhs); return; }
        As k -> { mark_uses_expr(k.lhs); return; }
        Trunc k -> { mark_uses_expr(k.lhs); return; }
        New k -> {
            mark_uses_expr(k.lhs);
            mark_uses_field_inits(k.inits);
            return;
        }
        StructLit k -> {
            mark_uses_field_inits(k.inits);
            return;
        }
        VariantLit k -> {
            mark_uses_field_inits(k.inits);
            return;
        }
    }
}

mark_uses_stmt(n: ?*Stmt) {
    if (n == null) { return; }
    match n.kind {
        Return k -> { mark_uses_expr(k.lhs); return; }
        ExprStmt k -> { mark_uses_expr(k.lhs); return; }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                mark_uses_stmt(s);
                s = s.next;
            }
            return;
        }
        If k -> {
            mark_uses_expr(k.cond);
            mark_uses_stmt(k.then);
            mark_uses_stmt(k.els);
            return;
        }
        While k -> {
            mark_uses_expr(k.cond);
            mark_uses_stmt(k.body);
            return;
        }
        Match k -> {
            mark_uses_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                mark_uses_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Raise k -> {
            mark_uses_field_inits(k.inits);
            return;
        }
        Try k -> {
            mark_uses_stmt(k.body);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                mark_uses_stmt(arm2.body);
                arm2 = arm2.next;
            }
            return;
        }
    }
}

check_unused_locals() {
    /* Names starting with `_` or `.` are ignored. Bare assignment does not count as a use. */
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.used != 0) {
            o: ?*Obj = fn.locals;
            while (o != null) {
                o.used = 0;
                o = o.next;
            }
            mark_uses_stmt(fn.body);
            o = fn.locals;
            while (o != null) {
                if (o.used == 0 && !ignore_unused_local_name(o.name)) {
                    warn_unused_local(fn.name, o.name);
                }
                o = o.next;
            }
        }
        fn = fn.next;
    }
}

typecheck_program() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        e: ?*ExnList = fn.raises_list;
        while (e != null) {
            e.seen = 0;
            e = e.next;
        }
        current_fn = fn;
        current_return_ty = fn.return_ty;
        catch_top = null;
        narrow_top = null;
        add_type_stmt(fn.body);
        fn = fn.next;
    }
    current_fn = null;
    current_return_ty = null;
    catch_top = null;
    narrow_top = null;
}

check_raises_functions() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.raises_list != null) {
            e: ?*ExnList = fn.raises_list;
            while (e != null) {
                if (e.seen == 0) { error("raises lists an exception that is never raised"); }
                e = e.next;
            }
        }
        fn = fn.next;
    }
}

new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    return l;
}

load_mem(ty: *Type) raises Error {
    if (is_byte_ty(ty)) {
        cg_movzb_mr(0, 0, 0);
    } else { cg_mov_mr(0, 0, 0); }
}

store_mem(ty: *Type) raises Error {
    if (is_byte_ty(ty)) {
        cg_movb_rm(0, 7, 0);
    } else { cg_mov_rm(0, 7, 0); }
}

emit_memcpy(sz: int) {
    if (sz <= 0) { sz = 8; }
    i: int = 0;
    while (i + 8 <= sz) {
        cg_mov_mr(6, i, 0);
        cg_mov_rm(0, 7, i);
        i = i + 8;
    }
    while (i < sz) {
        cg_movzb_mr(6, i, 0);
        cg_movb_rm(0, 7, i);
        i = i + 1;
    }
}

/* Store value in %rax into (%rdi). By-ref aggregates: %rax is a source pointer. */
store_value(ty: *Type) raises Error {
    if (passes_by_ref(ty)) {
        cg_mov_rr(0, 6);
        emit_memcpy(type_size(ty));
    } else { store_mem(ty); }
}

/*
 * Object base in %rbx (absolute). Eval RHS first so a large aggregate stack
 * temp from gen_expr cannot bury a pushed destination address.
 * base_off is added to each field offset (0 for structs, 8 for enum payloads).
 */
gen_field_inits(inits: ?*FieldInit, base_off: int) raises Error {
    init: ?*FieldInit = inits;
    while (init != null) {
        lhs: ?*Expr = init.lhs;
        if (lhs != null) {
            mem: *Member = init.member;
            mty: *Type = mem.ty;
            gen_expr(lhs);
            cg_mov_rr(3, 7);
            off: int = base_off + mem.offset;
            if (off != 0) {
                cg_alu_imm(0, off, 7);
            }
            store_value(mty);
        }
        init = init.next;
    }
}

gen_struct_inits(inits: ?*FieldInit) raises Error { gen_field_inits(inits, 0); }
gen_variant_inits(inits: ?*FieldInit) raises Error { gen_field_inits(inits, 8); }

gen_addr(n: *Expr) raises Error {
    match n.kind {
        Var k -> {
            var: ?*Obj = k.var;
            if (var == null) { error("missing var"); }
            vo: *Obj = var;
            if (vo.is_local != 0) {
                cg_lea_mr(5, vo.offset, 0);
            } else {
                cg_lea_rip(vo.name, 0, 0);
            }
            return;
        }
        Deref k -> {
            gen_expr(k.lhs);
            return;
        }
        MemberAccess k -> {
            t: ?*Type = decay(k.lhs.ty);
            if (t != null && is_pointer(t) && (is_struct_ty(type_base(t)) || is_exn_ty(type_base(t)))) {
                gen_expr(k.lhs);
            } else { gen_addr(k.lhs); }
            mem: *Member = k.member;
            if (mem.offset != 0) {
                cg_alu_imm(0, mem.offset, 0);
            }
            return;
        }
        _ -> { error("not an lvalue"); }
    }
}

/* Scalar load of a variable into %rax without lea+deref. */
emit_load_var(vo: *Obj, ty: *Type) raises Error {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) { cg_movzb_mr(5, vo.offset, 0); }
        else { cg_mov_mr(5, vo.offset, 0); }
    } else {
        cg_mov_rip_r(vo.name, 0, 0);
    }
}

/* Scalar store of %rax into a variable. */
emit_store_var(vo: *Obj, ty: *Type) raises Error {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) { cg_movb_rm(0, 5, vo.offset); }
        else { cg_mov_rm(0, 5, vo.offset); }
    } else {
        cg_mov_r_rip(0, vo.name, 0);
    }
}

fits_imm32(v: int): bool {
    lo: int = 0 - 2147483647;
    lo = lo - 1;
    hi: int = 2147483647;
    if (v < lo) { return false; }
    if (v > hi) { return false; }
    return true;
}

/* Store an immediate into a scalar variable (no %rax round-trip). */
emit_store_imm(vo: *Obj, ty: *Type, v: int) raises Error {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) { cg_movb_imm_m(v, 5, vo.offset); }
        else { cg_movq_imm_m(v, 5, vo.offset); }
    } else {
        if (is_byte_ty(ty)) { cg_movb_imm_rip(v, vo.name); }
        else { cg_movq_imm_rip(v, vo.name); }
    }
}

gen_load(n: *Expr) raises Error {
    ty: *Type = expect_type(n.ty, "missing type");
    if (is_array(ty) || passes_by_ref(ty)) {
        gen_addr(n);
        return;
    }
    match n.kind {
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo != null) {
                emit_load_var(vo, ty);
                return;
            }
        }
        _ -> {}
    }
    gen_addr(n);
    load_mem(ty);
}

gen_binop_setup(lhs: *Expr, rhs: *Expr) raises Error {
    gen_expr(lhs);
    cg_push(0);
    gen_expr(rhs);
    cg_mov_rr(0, 7);
    cg_pop(0);
}

/* Immediate integer operand for codegen (numeric literal or null). */
imm_operand(n: *Expr): int {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) { return 0; }
            return 1;
        }
        Null -> { return 1; }
        _ -> { return 0; }
    }
}

imm_value(n: *Expr): int {
    match n.kind {
        Num k -> { return k.val; }
        Null -> { return 0; }
        _ -> { return 0; }
    }
}

gen_cmp_set(setcc: *i8) {
    cc: int = 4;
    if (cli_streq(setcc, "setne")) { cc = 5; }
    if (cli_streq(setcc, "setl")) { cc = 12; }
    if (cli_streq(setcc, "setge")) { cc = 13; }
    if (cli_streq(setcc, "setle")) { cc = 14; }
    if (cli_streq(setcc, "setg")) { cc = 15; }
    cg_setcc(cc);
    cg_movzb_al_rax();
}

gen_cmp(lhs: *Expr, rhs: *Expr, setcc: *i8) raises Error {
    if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
        gen_expr(lhs);
        cg_alu_imm(7, imm_value(rhs), 0);
        gen_cmp_set(setcc);
        return;
    }
    if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
        gen_expr(rhs);
        cg_mov_rr(0, 7);
        cg_mov_imm(imm_value(lhs), 0);
        cg_alu_rr(57, 7, 0);
        gen_cmp_set(setcc);
        return;
    }
    gen_binop_setup(lhs, rhs);
    cg_alu_rr(57, 7, 0);
    gen_cmp_set(setcc);
}

gen_binary(op: BinOp, lhs: *Expr, rhs: *Expr) raises Error {
    match op {
        Add -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v: int = imm_value(rhs);
                if (v != 0) {
                    cg_alu_imm(0, v, 0);
                }
                return;
            }
            if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                v2: int = imm_value(lhs);
                if (v2 != 0) {
                    cg_alu_imm(0, v2, 0);
                }
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(1, 7, 0);
            return;
        }
        Sub -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v3: int = imm_value(rhs);
                if (v3 != 0) {
                    cg_alu_imm(5, v3, 0);
                }
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(41, 7, 0);
            return;
        }
        Mul -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_imul_imm(imm_value(rhs), 0);
                return;
            }
            if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_imul_imm(imm_value(lhs), 0);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_imul_rr(7, 0);
            return;
        }
        Div -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            return;
        }
        Mod -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                cg_mov_rr(2, 0);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            cg_mov_rr(2, 0);
            return;
        }
        Eq -> { gen_cmp(lhs, rhs, "sete"); return; }
        Ne -> { gen_cmp(lhs, rhs, "setne"); return; }
        Lt -> { gen_cmp(lhs, rhs, "setl"); return; }
        Le -> { gen_cmp(lhs, rhs, "setle"); return; }
        Gt -> { gen_cmp(lhs, rhs, "setg"); return; }
        Ge -> { gen_cmp(lhs, rhs, "setge"); return; }
    }
}

gen_expr(n: *Expr) raises Error {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) {
                cg_lea_rip(cg_name_num(".L.str", k.str_label - 1), 8, 0);
            } else {
                cg_mov_imm(k.val, 0);
            }
            return;
        }
        Null -> { cg_mov_imm(0, 0); return; }
        Var _p -> { gen_load(n); return; }
        MemberAccess _p -> { gen_load(n); return; }
        Addr k -> { gen_addr(k.lhs); return; }
        As k -> { gen_expr(k.lhs); return; }
        Trunc k -> { gen_expr(k.lhs); return; }
        New k -> {
            base: *Type = type_base(expect_type(n.ty, "missing type"));
            esz: int = type_size(base);
            if (esz <= 0) { esz = 8; }
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                gen_expr(lhs);
                if (esz != 1) {
                    cg_imul_imm(esz, 0);
                }
                cg_mov_rr(0, 7);
                cg_call("malloc");
                return;
            }
            cg_mov_imm(esz, 7);
            cg_call("malloc");
            variant: ?*Variant = k.variant;
            if (variant != null) {
                cg_push(3);
                cg_mov_rr(0, 3);
                cg_mov_imm(k.val, 7);
                cg_mov_rm(7, 0, 0);
                gen_variant_inits(k.inits);
                cg_mov_rr(3, 0);
                cg_pop(3);
            } else {
                if (k.val == 0) {
                    cg_push(3);
                    cg_mov_rr(0, 3);
                    gen_struct_inits(k.inits);
                    cg_mov_rr(3, 0);
                    cg_pop(3);
                }
            }
            return;
        }
        StructLit k -> {
            sz: int = type_size(expect_type(n.ty, "missing type"));
            if (sz <= 0) { sz = 8; }
            sz = (sz + 15) / 16 * 16;
            cg_alu_imm(5, sz, 4);
            cg_push(3);
            cg_lea_mr(4, 8, 3);
            gen_struct_inits(k.inits);
            cg_mov_rr(3, 0);
            cg_pop(3);
            return;
        }
        VariantLit k -> {
            sz: int = type_size(expect_type(n.ty, "missing type"));
            if (sz <= 0) { sz = 8; }
            if (sz <= 8) {
                if (k.inits == null) {
                    cg_mov_imm(k.val, 0);
                    return;
                }
                cg_alu_imm(5, 16, 4);
                cg_push(3);
                cg_lea_mr(4, 8, 3);
                cg_mov_imm(k.val, 7);
                cg_mov_rm(7, 3, 0);
                gen_variant_inits(k.inits);
                cg_mov_mr(3, 0, 0);
                cg_pop(3);
                return;
            }
            sz = (sz + 15) / 16 * 16;
            cg_alu_imm(5, sz, 4);
            cg_push(3);
            cg_lea_mr(4, 8, 3);
            cg_mov_imm(k.val, 7);
            cg_mov_rm(7, 3, 0);
            gen_variant_inits(k.inits);
            cg_mov_rr(3, 0);
            cg_pop(3);
            return;
        }
        Deref k -> {
            gen_expr(k.lhs);
            load_mem(expect_type(n.ty, "missing type"));
            return;
        }
        Assign q -> {
            match q.rhs.kind {
                StructLit k -> {
                    lty: ?*Type = q.lhs.ty;
                    if (lty != null && is_struct_ty(lty)) {
                        gen_addr(q.lhs);
                        cg_push(3);
                        cg_mov_rr(0, 3);
                        gen_struct_inits(k.inits);
                        cg_mov_rr(3, 0);
                        cg_pop(3);
                        return;
                    }
                }
                VariantLit k -> {
                    lty2: ?*Type = q.lhs.ty;
                    if (lty2 != null && is_enum_ty(lty2)) {
                        gen_addr(q.lhs);
                        cg_push(3);
                        cg_mov_rr(0, 3);
                        cg_mov_imm(k.val, 7);
                        cg_mov_rm(7, 0, 0);
                        gen_variant_inits(k.inits);
                        cg_mov_rr(3, 0);
                        cg_pop(3);
                        return;
                    }
                }
                _ -> {}
            }
            lhs_ty: *Type = expect_type(q.lhs.ty, "missing lhs type");
            if (!passes_by_ref(lhs_ty) && imm_operand(q.rhs) != 0 && fits_imm32(imm_value(q.rhs))) {
                match q.lhs.kind {
                    Var k -> {
                        vo0: ?*Obj = k.var;
                        if (vo0 != null) {
                            emit_store_imm(vo0, lhs_ty, imm_value(q.rhs));
                            return;
                        }
                    }
                    _ -> {}
                }
            }
            gen_expr(q.rhs);
            if (!passes_by_ref(lhs_ty)) {
                match q.lhs.kind {
                    Var k -> {
                        vo: ?*Obj = k.var;
                        if (vo != null) {
                            emit_store_var(vo, lhs_ty);
                            return;
                        }
                    }
                    _ -> {}
                }
            }
            cg_push(0);
            gen_addr(q.lhs);
            cg_mov_rr(0, 7);
            cg_pop(6);
            if (passes_by_ref(lhs_ty)) {
                emit_memcpy(type_size(lhs_ty));
                cg_mov_rr(7, 0);
            } else {
                cg_mov_rr(6, 0);
                store_mem(lhs_ty);
            }
            return;
        }
        Not k -> {
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_setcc(4);
            cg_movzb_al_rax();
            return;
        }
        Neg k -> { gen_expr(k.lhs); cg_neg(0); return; }
        LogAnd k -> {
            l: int = new_label();
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_jump(4, cg_name_num(".L.false", l));
            gen_expr(k.rhs);
            cg_alu_imm(7, 0, 0);
            cg_jump(4, cg_name_num(".L.false", l));
            cg_mov_imm(1, 0);
            cg_jump(0 - 1, cg_name_num(".L.end", l));
            cg_label(cg_name_num(".L.false", l));
            cg_mov_imm(0, 0);
            cg_label(cg_name_num(".L.end", l));
            return;
        }
        LogOr k -> {
            l2: int = new_label();
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_jump(5, cg_name_num(".L.true", l2));
            gen_expr(k.rhs);
            cg_alu_imm(7, 0, 0);
            cg_jump(4, cg_name_num(".L.false", l2));
            cg_label(cg_name_num(".L.true", l2));
            cg_mov_imm(1, 0);
            cg_jump(0 - 1, cg_name_num(".L.end", l2));
            cg_label(cg_name_num(".L.false", l2));
            cg_mov_imm(0, 0);
            cg_label(cg_name_num(".L.end", l2));
            return;
        }
        Funcall k -> {
            fno: ?*Function = k.fn;
            has_sret: int = 0;
            if (fno != null) {
                if (fno.sret != null) { has_sret = 1; }
            }
            nargs: int = 0;
            a: ?*Expr = k.args;
            while (a != null) {
                nargs = nargs + 1;
                a = a.next;
            }
            nregs: int = nargs + has_sret;
            if (nregs > 6) { error("too many arguments"); }
            if (has_sret != 0) {
                if (fno == null) { error("missing function"); }
                sz: int = type_size(expect_type(fno.return_ty, "missing return type"));
                if (sz <= 0) { sz = 8; }
                sz = (sz + 15) / 16 * 16;
                cg_alu_imm(5, sz, 4);
                cg_mov_rr(4, 0);
                cg_push(0);
            }
            a = k.args;
            while (a != null) {
                gen_expr(a);
                cg_push(0);
                a = a.next;
            }
            i: int = nregs - 1;
            while (i >= 0) {
                cg_pop(cg_arg_reg(i));
                i = i - 1;
            }
            cg_alu_imm(5, 8, 4);
            cg_call(k.funcname);
            cg_alu_imm(0, 8, 4);
            return;
        }
        Binary k -> { gen_binary(k.op, k.lhs, k.rhs); return; }
        _ -> { error("invalid expression"); }
    }
}

gen_stmt(n: *Stmt) raises Error {
    match n.kind {
        Return k -> {
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                gen_expr(lhs);
                sret: ?*Obj = current_sret;
                if (sret != null) {
                    cg_mov_rr(0, 6);
                    cg_mov_mr(5, sret.offset, 7);
                    emit_memcpy(type_size(expect_type(current_return_ty, "missing return type")));
                    cg_mov_rr(7, 0);
                }
            } else { cg_mov_imm(0, 0); }
            fname: ?*i8 = current_fn_name;
            if (fname == null) { error("missing fn name"); }
            cg_jump(0 - 1, cg_name_pair(".L.return.", fname));
            return;
        }
        ExprStmt k -> {
            gen_expr(k.lhs);
            return;
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                gen_stmt(s);
                s = s.next;
            }
            return;
        }
        If k -> {
            l: int = new_label();
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            cg_jump(4, cg_name_num(".L.else", l));
            gen_stmt(k.then);
            cg_jump(0 - 1, cg_name_num(".L.end", l));
            cg_label(cg_name_num(".L.else", l));
            els: ?*Stmt = k.els;
            if (els != null) {
                gen_stmt(els);
            }
            cg_label(cg_name_num(".L.end", l));
            return;
        }
        While k -> {
            l2: int = new_label();
            cg_label(cg_name_num(".L.begin", l2));
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            cg_jump(4, cg_name_num(".L.end", l2));
            gen_stmt(k.body);
            cg_jump(0 - 1, cg_name_num(".L.begin", l2));
            cg_label(cg_name_num(".L.end", l2));
            return;
        }
        Match k -> {
            l3: int = new_label();
            match k.cond.kind {
                Var _p -> { gen_addr(k.cond); }
                MemberAccess _p -> { gen_addr(k.cond); }
                Deref _p -> { gen_addr(k.cond); }
                _ -> { gen_expr(k.cond); }
            }
            cg_push(0);
            cg_mov_mr(0, 0, 0);
            cg_push(0);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                la: int = new_label();
                av: ?*Variant = arm.variant;
                if (av != null) {
                    cg_mov_mr(4, 0, 0);
                    cg_alu_imm(7, av.tag, 0);
                    cg_jump(5, cg_name_num(".L.arm", la));
                }
                bv: ?*Obj = arm.binder;
                if (bv != null) {
                    if (av == null) { error("missing variant"); }
                    psz: int = av.payload_size;
                    cg_mov_mr(4, 8, 6);
                    cg_alu_imm(0, 8, 6);
                    cg_lea_mr(5, bv.offset, 7);
                    emit_memcpy(psz);
                }
                gen_stmt(arm.body);
                cg_jump(0 - 1, cg_name_num(".L.matchend", l3));
                if (av != null) {
                    cg_label(cg_name_num(".L.arm", la));
                }
                arm = arm.next;
            }
            cg_mov_imm(1, 7);
            cg_call("exit");
            cg_label(cg_name_num(".L.matchend", l3));
            cg_alu_imm(0, 16, 4);
            return;
        }
        Raise k -> {
            if (k.exn.members != null) {
                esz: int = k.exn.size;
                if (esz <= 0) { esz = 8; }
                cg_mov_imm(esz, 7);
                cg_call("malloc");
                cg_push(3);
                cg_mov_rr(0, 3);
                gen_struct_inits(k.inits);
                cg_mov_rr(3, 6);
                cg_pop(3);
            } else { cg_mov_imm(0, 6); }
            cg_mov_imm(k.exn.tag, 7);
            cg_call("l8_raise");
            return;
        }
        Try k -> {
            l4: int = new_label();
            cg_lea_mr(5, k.buf.offset, 7);
            cg_call("l8_try_begin");
            cg_alu_imm(7, 0, 0);
            cg_jump(5, cg_name_num(".L.catch", l4));
            gen_stmt(k.body);
            cg_call("l8_try_end");
            cg_jump(0 - 1, cg_name_num(".L.tryend", l4));
            cg_label(cg_name_num(".L.catch", l4));
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                la2: int = new_label();
                ced: *ExnDef = arm2.exn;
                cg_mov_rip_r("l8_exc_tag", 0, 0);
                cg_alu_imm(7, ced.tag, 0);
                cg_jump(5, cg_name_num(".L.arm", la2));
                binder: ?*Obj = arm2.binder;
                if (binder != null) {
                    psz2: int = ced.size;
                    if (psz2 > 0) {
                        cg_mov_rip_r("l8_exc_ptr", 0, 6);
                        cg_lea_mr(5, binder.offset, 7);
                        emit_memcpy(psz2);
                    }
                }
                gen_stmt(arm2.body);
                cg_jump(0 - 1, cg_name_num(".L.tryend", l4));
                cg_label(cg_name_num(".L.arm", la2));
                arm2 = arm2.next;
            }
            cg_mov_rip_r("l8_exc_tag", 0, 7);
            cg_mov_rip_r("l8_exc_ptr", 0, 6);
            cg_call("l8_raise");
            cg_label(cg_name_num(".L.tryend", l4));
            return;
        }
        _ -> { error("invalid statement"); }
    }
}

assign_lvar_offsets(fn: *Function) raises Error {
    off: int = 0;
    v: ?*Obj = fn.locals;
    while (v != null) {
        vty: *Type = expect_type(v.ty, "missing local type");
        sz: int = type_size(vty);
        if (sz <= 0) { sz = 8; }
        if (!is_array(vty)) {
            if (sz < 8) { sz = 8; }
        } else { sz = (sz + 7) / 8 * 8; }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 15) / 16 * 16;
}

emit_data() raises Error {
    g: ?*Obj = globals;
    cg_section(as_SEC_BSS);
    cg_align(8);
    while (g != null) {
        if (g.is_func == 0) {
            sz: int = 8;
            gty: ?*Type = g.ty;
            if (gty != null) { sz = type_size(gty); }
            if (sz <= 0) { sz = 8; }
            cg_label(g.name);
            cg_skip(sz);
        }
        g = g.next;
    }
    cg_section(as_SEC_RODATA);
    cg_align(8);
    i: int = 0;
    while (i < str_count) {
        s: ?*StrLit = str_lits;
        found: ?*StrLit = null;
        while (s != null) {
            if (s.label == i) { found = s; }
            if (found == null) {
                s = s.next;
            } else { s = null; }
        }
        if (found != null) {
            cg_label(cg_name_num(".L.str", i));
            cg_quad(found.len);
            cg_bytes(found.data, found.len);
        }
        i = i + 1;
    }
}

emit_text() raises Error {
    fn: ?*Function = functions;
    cg_section(as_SEC_TEXT);
    while (fn != null) {
        narrow_top = null;
        catch_top = null;
        assign_lvar_offsets(fn);
        current_fn_name = fn.name;
        current_return_ty = fn.return_ty;
        current_sret = fn.sret;
        current_fn = fn;
        cg_global(fn.name);
        cg_label(fn.name);
        cg_push(5);
        cg_mov_rr(4, 5);
        cg_alu_imm(5, fn.stack_size, 4);
        ri: int = 0;
        sret: ?*Obj = fn.sret;
        if (sret != null) {
            cg_mov_rm(cg_arg_reg(ri), 5, sret.offset);
            ri = ri + 1;
        }
        /* Spill all argregs first; by-ref memcpy clobbers %rsi/%rdi/%rax. */
        base_ri: int = ri;
        i: int = 0;
        while (i < fn.nparams) {
            po: ?*Obj = fn_param(fn, i);
            if (po == null) { error("null obj"); }
            p: *Obj = po;
            cg_mov_rm(cg_arg_reg(ri), 5, p.offset);
            ri = ri + 1;
            i = i + 1;
        }
        ri = base_ri;
        i = 0;
        while (i < fn.nparams) {
            po2: ?*Obj = fn_param(fn, i);
            if (po2 == null) { error("null obj"); }
            p2: *Obj = po2;
            pty: ?*Type = p2.ty;
            if (pty == null) { error("missing param type"); }
            if (passes_by_ref(pty)) {
                cg_mov_mr(5, p2.offset, 6);
                cg_lea_mr(5, p2.offset, 7);
                emit_memcpy(type_size(pty));
            }
            ri = ri + 1;
            i = i + 1;
        }
        body: ?*Stmt = fn.body;
        if (body == null) { error("missing body"); }
        gen_stmt(body);
        cg_label(cg_name_pair(".L.return.", fn.name));
        cg_mov_rr(5, 4);
        cg_pop(5);
        cg_ret();
        fn = fn.next;
    }
}

codegen() raises Error {
    emit_data();
    emit_text();
    if (cg_direct_mode == 0) { emit_flush(); }
}

type Timespec = { sec: int; nsec: int; };

mono_ns(): int {
    ts: Timespec = uninitialized;
    syscall(228, 1, &ts, 0, 0, 0);
    return ts.sec * 1000000000 + ts.nsec;
}

profile_print(label: *i8, dt_ns: int) {
    write(2, "profile: ", len("profile: "));
    write(2, label, len(label));
    write(2, " ", len(" "));
    ms: int = dt_ns / 1000000;
    us: int = (dt_ns / 1000) % 1000;
    emit_num_fd(2, ms);
    write(2, ".", len("."));
    if (us < 100) { write(2, "0", len("0")); }
    if (us < 10) { write(2, "0", len("0")); }
    emit_num_fd(2, us);
    write(2, " ms\n", len(" ms\n"));
}

is_profile_flag(s: *i8): bool {
    if (s[0] == '-' && s[1] == 'p' && s[2] == 0 trunc i8) { return true; }
    if (s[0] == '-' && s[1] == '-' && s[2] == 'p' && s[3] == 'r' && s[4] == 'o'
        && s[5] == 'f' && s[6] == 'i' && s[7] == 'l' && s[8] == 'e' && s[9] == 0 trunc i8) {
        return true;
    }
    return false;
}

compiler_build_direct(src_path: *i8): int {
    try {
        do_profile = 0;
        cg_direct_mode = 1;
        as_init();
        init_runtime();
        init_dummies();
        source = "";
        source_len = 0;
        source_path = src_path;
        tok = token_eof;
        parse_program(src_path);
        typecheck_program();
        check_unused_functions();
        check_unused_locals();
        check_raises_functions();
        check_noreturn_functions();
        codegen();
        as_assemble_file_append("runtime.s");
        return 0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        return 1;
    }
}

compiler_main(argc: int, argv: **i8): int {
    try {
        cg_direct_mode = 0;
        do_profile = 0;
        path: ?*i8 = null;
        ai: int = 1;
        while (ai < argc) {
            arg: *i8 = (argv + ai * 8).*;
            if (is_profile_flag(arg)) {
                do_profile = 1;
            } else {
                if (path != null) {
                    write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n", len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
                    return 1;
                }
                path = arg;
            }
            ai = ai + 1;
        }
        if (path == null) {
            write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n", len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
            return 1;
        }
        src_path: *i8 = path;
        t0: int = 0;
        t: int = 0;
        prev: int = 0;
        if (do_profile != 0) {
            t0 = mono_ns();
            prev = t0;
        }
        as_init();
        init_runtime();
        init_dummies();
        if (do_profile != 0) {
            t = mono_ns();
            profile_print("init", t - prev);
            prev = t;
        }
        source = "";
        source_len = 0;
        source_path = src_path;
        tok = token_eof;
        parse_program(src_path);
        if (do_profile != 0) {
            t = mono_ns();
            profile_print("load_parse", t - prev);
            prev = t;
        }
        typecheck_program();
        if (do_profile != 0) {
            t = mono_ns();
            profile_print("typecheck", t - prev);
            prev = t;
        }
        check_unused_functions();
        if (do_profile != 0) {
            t = mono_ns();
            profile_print("unused_fns", t - prev);
            prev = t;
        }
        check_unused_locals();
        if (do_profile != 0) {
            t = mono_ns();
            profile_print("unused_locals", t - prev);
            prev = t;
        }
        check_raises_functions();
        if (do_profile != 0) {
            t = mono_ns();
            profile_print("raises", t - prev);
            prev = t;
        }
        check_noreturn_functions();
        if (do_profile != 0) {
            t = mono_ns();
            profile_print("noreturn", t - prev);
            prev = t;
        }
        codegen();
        if (do_profile != 0) {
            t = mono_ns();
            profile_print("codegen", t - prev);
            profile_print("TOTAL", t - t0);
        }
        return 0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        return 1;
    }
}
