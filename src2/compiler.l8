new_try(body: *Stmt@new, arms: ?*CatchArm@new, buf: *Obj@new): *Stmt@new {
    mk_stmt(StmtKind.Try { body: body, arms: arms, buf: buf });
}

new_region(body: *Stmt@new, mark: *Obj@new): *Stmt@new {
    mk_stmt(StmtKind.Region { body: body, mark: mark });
}

new_catch_arm(
    name: []i8@new,
    exn: ?*ExnDef@new,
    binder: ?*Obj@new,
    binder_name: []i8@new,
    paren: int,
    body: *Stmt@new
): *CatchArm@new {
    new CatchArm {
        name: name,
        exn: exn,
        binder: binder,
        binder_name: binder_name,
        paren: paren,
        body: body,
        next: null,
        lead: null,
        trail: null,
        pos: 0,
        file: 0,
        toklen: 0
    };
}

find_function(name: []i8): ?*Function {
    b: int = sym_bucket(hash_str(name));
    fn: ?*Function = fn_buckets[b].head;
    while (fn != null) {
        if (streq(fn.name, name)) {
            return fn;
        }
        fn = fn.hash_next;
    }
    null;
}

find_global(name: []i8): ?*Obj {
    b: int = sym_bucket(hash_str(name));
    o: ?*Obj = global_buckets[b].head;
    while (o != null) {
        if (streq(o.name, name)) {
            return o;
        }
        o = o.hash_next;
    }
    null;
}

find_local(name: []i8): ?*Obj {
    o: ?*Obj = scope_locals;
    while (o != null) {
        if (streq(o.name, name)) {
            return o;
        }
        o = o.hash_next;
    }
    null;
}

find_var(name: []i8): ?*Obj {
    o: ?*Obj = find_local(name);
    if (o != null) {
        return o;
    }
    find_global(name);
}

enter_scope() {
    scope_depth = scope_depth + 1;
}

leave_scope() raises Error {
    if (scope_depth <= 0) {
        error("internal: leave_scope");
    }
    scope_depth = scope_depth - 1;
    o: ?*Obj = scope_locals;
    while (o != null) {
        if (o.scope_depth <= scope_depth) {
            scope_locals = o;
            return;
        }
        o = o.hash_next;
    }
    scope_locals = null;
}

new_obj(name: []i8@new, is_local: int) noregion: *Obj@new {
    o: *Obj = new Obj {
        name: name,
        is_local: is_local,
        is_func: 0,
        offset: 0,
        scope_depth: 0,
        ty: null,
        used: 0,
        init: null,
        next: null,
        param_next: null,
        hash_next: null,
        escape_walk: 0,
        life: 0,
        storage_life: 0,
        life_bound: "",
        bound_need_imm: 0,
        bound_need_new: 0,
        bound_named: null,
        browse_id: browse_fresh(),
        browse_pos: browse_tok_pos,
        browse_file: browse_tok_file,
        browse_len: browse_tok_len,
        lead: null,
        trail: null
    };
    if (is_local != 0) {
        o.scope_depth = scope_depth;
        if (region_depth == 0) {
            o.storage_life = 1;
        } else {
            o.storage_life = region_depth + 1;
        }
        o.next = locals;
        locals = o;
        o.hash_next = scope_locals;
        scope_locals = o;
    } else {
        o.next = globals;
        globals = o;
        hash_put_global(o);
    }
    o;
}

life_reset_imm() {
    life_n = 3;
    life_parent[0] = 0 - 1;
    life_kind[0] = 0;
    life_parent[1] = 0 - 1;
    life_kind[1] = 2;
    life_parent[2] = 0 - 1;
    life_kind[2] = 1;
    life_heap = LIFE_IMM;
    life_cur = LIFE_SELF;
    life_region_tc = 1;
    life_depth_frames[1] = LIFE_SELF;
    life_edge_n = 0;
}

life_alloc_frame(parent: int, kind: int) raises Error: int {
    if (life_n >= LIFE_MAX) {
        error("too many lifetime frames");
    }
    id: int = life_n;
    life_parent[id] = parent;
    life_kind[id] = kind;
    life_n = life_n + 1;
    id;
}

life_add_edge(longer: int, shorter: int) {
    if (life_edge_n >= LIFE_MAX) {
        return;
    }
    life_edge_long[life_edge_n] = longer;
    life_edge_short[life_edge_n] = shorter;
    life_edge_n = life_edge_n + 1;
}

life_is_param(id: int): bool {
    id >= 3 && life_kind[id] == LIFE_KIND_PARAM;
}

life_is_region(id: int): bool {
    id >= 3 && life_kind[id] == 2;
}

life_parent_reaches(from: int, anc: int): bool {
    x: int = from;
    steps: int = 0;
    while (x >= 0 && steps < 64) {
        if (x == anc) {
            return true;
        }
        x = life_parent[x];
        steps = steps + 1;
    }
    false;
}

life_outlives_lim(a: int, b: int, depth: int): bool {
    if (depth > 32) {
        return false;
    }
    if (a == b) {
        return true;
    }
    if (a == LIFE_IMM) {
        return true;
    }
    if (b == LIFE_IMM) {
        if (a == LIFE_HEAPTOP) {
            fn: ?*Function = current_fn;
            if (fn != null) {
                fu: *Function = fn;
                if (fu.need_imm_heap != 0) {
                    return true;
                }
            }
        }
        return false;
    }
    if (life_parent_reaches(b, a)) {
        return true;
    }
    if (b == LIFE_SELF) {
        if (a == LIFE_HEAPTOP) {
            return true;
        }
        if (life_is_param(a)) {
            return true;
        }
        return false;
    }
    i: int = 0;
    while (i < life_edge_n) {
        if (life_edge_long[i] == a) {
            if (life_outlives_lim(life_edge_short[i], b, depth + 1)) {
                return true;
            }
        }
        i = i + 1;
    }
    if (a == LIFE_HEAPTOP && life_outlives_lim(LIFE_SELF, b, depth + 1)) {
        return true;
    }
    if (life_is_param(a) && life_outlives_lim(LIFE_SELF, b, depth + 1)) {
        return true;
    }
    false;
}

life_outlives(a: int, b: int): bool {
    life_outlives_lim(a, b, 0);
}

obj_storage_life(o: *Obj): int {
    if (o.is_local == 0) {
        return LIFE_IMM;
    }
    d: int = o.storage_life;
    if (d <= 1) {
        return LIFE_SELF;
    }
    if (d < LIFE_MAX) {
        f: int = life_depth_frames[d];
        if (f != 0) {
            return f;
        }
    }
    LIFE_SELF;
}

find_fn_param(fn: *Function, name: []i8): ?*Obj@fn {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (streq(p.name, name)) {
            return p;
        }
        p = p.param_next;
    }
    null;
}

life_bound_immortal(b: []i8): bool {
    streq(b, "immortal");
}

life_is_self_bound(p: *Obj): bool {
    if (life_bound_immortal(p.life_bound)) {
        return false;
    }
    if (streq(p.life_bound, "new")) {
        return false;
    }
    len(p.life_bound) == 0 || streq(p.life_bound, p.name);
}

resolve_fn_bounds(fn: *Function) raises Error {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (type_is_ref(p.ty) || type_has_pointers(p.ty)) {
            p.life = life_alloc_frame(0 - 1, LIFE_KIND_PARAM);
        } else {
            p.life = LIFE_IMM;
        }
        p = p.param_next;
    }
    p = fn.params;
    while (p != null) {
        b: []i8 = p.life_bound;
        if (streq(b, "new")) {
            life_add_edge(p.life, LIFE_HEAPTOP);
        } else if (len(b) != 0 && !life_bound_immortal(b) && !streq(b, p.name)) {
            q: ?*Obj = find_fn_param(fn, b);
            if (q == null) {
                error("unknown lifetime bound");
            }
            qu: *Obj = q;
            life_add_edge(p.life, qu.life);
        }
        p = p.param_next;
    }
    if (len(fn.ret_bound) == 0 || life_bound_immortal(fn.ret_bound)) {
        fn.ret_life = LIFE_IMM;
    } else if (streq(fn.ret_bound, "new")) {
        fn.ret_life = LIFE_HEAPTOP;
    } else {
        r: ?*Obj = find_fn_param(fn, fn.ret_bound);
        if (r == null) {
            error("unknown lifetime bound");
        }
        fn.ret_life = r.life;
    }
}

life_init_fn(fn: *Function) raises Error {
    life_n = 3;
    life_parent[0] = 0 - 1;
    life_kind[0] = 0;
    life_parent[1] = 0 - 1;
    life_kind[1] = 2;
    life_parent[2] = 0 - 1;
    life_kind[2] = 1;
    life_heap = LIFE_HEAPTOP;
    life_cur = LIFE_SELF;
    life_region_tc = 1;
    life_depth_frames[1] = LIFE_SELF;
    life_edge_n = 0;
    resolve_fn_bounds(fn);
}

life_enter_region() raises Error: int {
    f: int = life_alloc_frame(life_cur, 2);
    life_cur = f;
    life_heap = f;
    life_region_tc = life_region_tc + 1;
    if (life_region_tc < LIFE_MAX) {
        life_depth_frames[life_region_tc] = f;
    }
    f;
}

life_leave_region(old_cur: int, old_heap: int) {
    life_cur = old_cur;
    life_heap = old_heap;
    life_region_tc = life_region_tc - 1;
}

var_view_ty(var: ?*Obj): ?*Type@var {
    f: ?*NarrowFrame = narrow_top;
    while (f != null) {
        if (f.var == var) {
            return f.ty;
        }
        f = f.next;
    }
    if (var != null) {
        return var.ty;
    }
    null;
}

narrow_push(var: ?*Obj@new, ty: ?*Type@new) noregion {
    f: *NarrowFrame = new NarrowFrame { var: var, ty: ty, next: narrow_top };
    narrow_top = f;
}

narrow_reset(saved: ?*NarrowFrame@immortal) {
    narrow_top = saved;
}

walk_reset(saved: ?*WalkFrame@immortal) {
    walk_top = saved;
}

walk_fact(str: ?*Obj): ?*WalkFrame {
    f: ?*WalkFrame = walk_top;
    while (f != null) {
        if (f.str == str) {
            return f;
        }
        f = f.next;
    }
    null;
}

walk_hi(str: ?*Obj): int {
    f: ?*WalkFrame = walk_fact(str);
    if (f != null) {
        f.hi;
    } else {
        0;
    }
}

walk_cursor(str: ?*Obj): ?*Obj {
    f: ?*WalkFrame = walk_fact(str);
    if (f != null) {
        f.cursor;
    } else {
        null;
    }
}

walk_push(str: ?*Obj@new, hi: int, cursor: ?*Obj@new) noregion {
    f: *WalkFrame = new WalkFrame {
        str: str,
        hi: hi,
        cursor: cursor,
        next: walk_top
    };
    walk_top = f;
}

is_zero_var(var: ?*Obj): bool {
    if (is_addr_taken(var)) {
        return false;
    }
    f: ?*WalkFrame = zero_top;
    while (f != null) {
        if (f.cursor == var) {
            return f.hi >= 0;
        }
        f = f.next;
    }
    false;
}

kill_var_facts(o: ?*Obj@immortal) noregion {
    if (o == null) {
        return;
    }
    if (o.ty != null) {
        narrow_push(o, o.ty);
    }
    zero_top = new WalkFrame {
        str: null,
        hi: 0 - 1,
        cursor: o,
        next: zero_top
    };
    walk_push(o, 0, null);
    f: ?*WalkFrame = walk_top;
    while (f != null) {
        if (f.cursor == o && f.str != null) {
            if (f.str != o) {
                walk_push(f.str, f.hi, null);
            }
        }
        f = f.next;
    }
}

mark_zero_var(var: ?*Obj@new) noregion {
    if (var == null) {
        return;
    }
    if (is_addr_taken(var)) {
        return;
    }
    f: *WalkFrame = new WalkFrame {
        str: null,
        hi: 0,
        cursor: var,
        next: zero_top
    };
    zero_top = f;
}

is_stack_object(n: *Expr): bool {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) {
                return false;
            }
            v.is_local != 0 && v.is_func == 0;
        }
        MemberAccess k -> {
            lt: ?*Type = k.lhs.ty;
            if (lt != null && (is_pointer(lt) || is_opt_pointer(lt) || is_slice(lt))) {
                return false;
            }
            is_stack_object(k.lhs);
        }
        Index k -> {
            lt2: ?*Type = k.lhs.ty;
            if (lt2 != null && (is_slice(lt2) || is_zptr(lt2))) {
                return false;
            }
            is_stack_object(k.lhs);
        }
        _ -> {
            false;
        }
    }
}

is_stack_addr_stmt(s: ?*Stmt): bool {
    if (s == null) {
        return false;
    }
    match s.kind {
        Return k -> {
            is_stack_addr(k.lhs);
        }
        ExprStmt k -> {
            is_stack_addr(k.lhs);
        }
        Block k -> {
            is_stack_addr_stmt(last_stmt(k.body));
        }
        If k -> {
            is_stack_addr_stmt(k.then) || is_stack_addr_stmt(k.els);
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (is_stack_addr_stmt(arm.body)) {
                    return true;
                }
                arm = arm.next;
            }
            false;
        }
        Try k -> {
            if (is_stack_addr_stmt(k.body)) {
                return true;
            }
            a: ?*CatchArm = k.arms;
            while (a != null) {
                if (is_stack_addr_stmt(a.body)) {
                    return true;
                }
                a = a.next;
            }
            false;
        }
        Region k -> {
            is_stack_addr_stmt(k.body);
        }
        _ -> {
            false;
        }
    }
}

is_stack_addr(n: ?*Expr): bool {
    if (n == null) {
        return false;
    }
    match n.kind {
        Addr k -> {
            is_stack_object(k.lhs);
        }
        As k -> {
            is_stack_addr(k.lhs);
        }
        Trunc k -> {
            is_stack_addr(k.lhs);
        }
        If k -> {
            is_stack_addr(k.then) || is_stack_addr(k.els);
        }
        OrElse k -> {
            is_stack_addr(k.lhs) || is_stack_addr(k.rhs);
        }
        Block k -> {
            is_stack_addr_stmt(last_stmt(k.body));
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (is_stack_addr_stmt(arm.body)) {
                    return true;
                }
                arm = arm.next;
            }
            false;
        }
        _ -> {
            false;
        }
    }
}

is_tainted_obj(o: ?*Obj): bool {
    if (o == null) {
        return false;
    }
    f: ?*InitFrame = taint_top;
    while (f != null) {
        if (f.var == o) {
            return true;
        }
        f = f.next;
    }
    false;
}

mark_tainted(o: *Obj@immortal) noregion {
    if (is_tainted_obj(o)) {
        return;
    }
    taint_top = new InitFrame { var: o, next: taint_top };
}

is_addr_taken(o: ?*Obj): bool {
    if (o == null) {
        return false;
    }
    f: ?*InitFrame = addr_top;
    while (f != null) {
        if (f.var == o) {
            return true;
        }
        f = f.next;
    }
    false;
}

mark_addr_taken(o: *Obj@immortal) noregion {
    if (is_addr_taken(o)) {
        return;
    }
    addr_top = new InitFrame { var: o, next: addr_top };
    kill_var_facts(o);
}

taint_result_ty(n: *Expr): ?*Type@n {
    if (n.ty != null) {
        return n.ty;
    }
    match n.kind {
        MemberAccess k -> {
            mo: ?*Member = k.member;
            if (mo == null) {
                return null;
            }
            mo.ty;
        }
        _ -> {
            null;
        }
    }
}

taint_from_inner(n: *Expr, inner: ?*Expr): bool {
    if (!type_has_pointers(taint_result_ty(n))) {
        return false;
    }
    is_tainted_expr(inner);
}

is_tainted_expr(n: ?*Expr): bool {
    if (n == null) {
        return false;
    }
    if (is_stack_addr(n)) {
        return true;
    }
    match n.kind {
        Var k -> {
            is_tainted_obj(k.var);
        }
        StructLit k -> {
            field_inits_tainted(k.inits);
        }
        New k -> {
            field_inits_tainted(k.inits);
        }
        VariantLit k -> {
            field_inits_tainted(k.inits);
        }
        As k -> {
            is_tainted_expr(k.lhs);
        }
        If k -> {
            is_tainted_expr(k.then) || is_tainted_expr(k.els);
        }
        OrElse k -> {
            is_tainted_expr(k.lhs) || is_tainted_expr(k.rhs);
        }
        Block k -> {
            is_stack_addr_stmt(last_stmt(k.body));
        }
        Match _m -> {
            is_stack_addr(n);
        }
        MemberAccess k -> {
            taint_from_inner(n, k.lhs);
        }
        Deref k -> {
            taint_from_inner(n, k.lhs);
        }
        Index k -> {
            taint_from_inner(n, k.lhs);
        }
        _ -> {
            false;
        }
    }
}

field_inits_tainted(inits: ?*FieldInit): bool {
    a: ?*FieldInit = inits;
    while (a != null) {
        if (is_tainted_expr(a.lhs)) {
            return true;
        }
        a = a.next;
    }
    false;
}

io_allows_stack(name: []i8): bool {
    streq(name, "write") || streq(name, "read");
}

life_meet(a: int, b: int) raises Error: int {
    if (life_outlives(a, b)) {
        return b;
    }
    if (life_outlives(b, a)) {
        return a;
    }
    fn: ?*Function = current_fn;
    if (fn != null) {
        write(2, "incomparable lifetimes in ", len("incomparable lifetimes in "));
        write(2, fn.name, len(fn.name));
        write(2, "\n", 1);
    }
    error("incomparable lifetimes");
    a;
}

object_storage_life(n: *Expr) raises Error: int {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) {
                return LIFE_IMM;
            }
            obj_storage_life(v);
        }
        Deref k -> {
            expr_life(k.lhs);
        }
        Index k -> {
            lt: ?*Type = k.lhs.ty;
            if (lt != null && (is_slice(lt) || is_zptr(lt))) {
                return expr_life(k.lhs);
            }
            object_storage_life(k.lhs);
        }
        MemberAccess k -> {
            lt2: ?*Type = decay(k.lhs.ty);
            if (lt2 != null && (is_pointer(lt2) || is_opt_pointer(lt2) || is_slice(lt2))) {
                return expr_life(k.lhs);
            }
            object_storage_life(k.lhs);
        }
        _ -> {
            LIFE_SELF;
        }
    }
}

field_inits_life(inits: ?*FieldInit) raises Error: int {
    a: ?*FieldInit = inits;
    l: int = LIFE_IMM;
    saw: int = 0;
    while (a != null) {
        if (a.lhs != null) {
            fl: int = expr_life(a.lhs);
            if (saw == 0) {
                l = fl;
            } else if (life_outlives(l, fl)) {
                l = fl;
            } else if (!life_outlives(fl, l)) {
                l = LIFE_SELF;
            }
            saw = 1;
        }
        a = a.next;
    }
    l;
}

stmt_result_life(s: ?*Stmt) raises Error: int {
    if (s == null) {
        return LIFE_IMM;
    }
    match s.kind {
        ExprStmt k -> {
            expr_life(k.lhs);
        }
        Block k -> {
            stmt_result_life(last_stmt(k.body));
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els == null) {
                return stmt_result_life(k.then);
            }
            life_meet(stmt_result_life(k.then), stmt_result_life(els));
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            l: int = LIFE_IMM;
            saw: int = 0;
            while (arm != null) {
                al: int = stmt_result_life(arm.body);
                if (saw == 0) {
                    l = al;
                } else {
                    l = life_meet(l, al);
                }
                saw = 1;
                arm = arm.next;
            }
            l;
        }
        Try k -> {
            l2: int = stmt_result_life(k.body);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                l2 = life_meet(l2, stmt_result_life(a.body));
                a = a.next;
            }
            l2;
        }
        Region k -> {
            stmt_result_life(k.body);
        }
        _ -> {
            LIFE_IMM;
        }
    }
}

instantiate_bound(fn: *Function, bound: []i8, args: ?*Expr) raises Error: int {
    if (len(bound) == 0 || life_bound_immortal(bound)) {
        return LIFE_IMM;
    }
    if (streq(bound, "new")) {
        return life_heap;
    }
    p: ?*Obj = fn.params;
    a: ?*Expr = args;
    while (p != null && a != null) {
        if (streq(p.name, bound)) {
            return expr_life(a);
        }
        p = p.param_next;
        a = a.next;
    }
    error("unknown lifetime bound");
    LIFE_IMM;
}

expr_life(n: ?*Expr) raises Error: int {
    if (n == null) {
        return LIFE_IMM;
    }
    match n.kind {
        Addr k -> {
            object_storage_life(k.lhs);
        }
        New _k -> {
            life_heap;
        }
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) {
                return LIFE_IMM;
            }
            if (v.is_local == 0) {
                return LIFE_IMM;
            }
            v.life;
        }
        Deref k -> {
            expr_life(k.lhs);
        }
        MemberAccess k -> {
            expr_life(k.lhs);
        }
        Index k -> {
            expr_life(k.lhs);
        }
        Assign k -> {
            expr_life(k.rhs);
        }
        As k -> {
            expr_life(k.lhs);
        }
        Trunc k -> {
            expr_life(k.lhs);
        }
        If k -> {
            life_meet(expr_life(k.then), expr_life(k.els));
        }
        OrElse k -> {
            life_meet(expr_life(k.lhs), expr_life(k.rhs));
        }
        Block k -> {
            stmt_result_life(last_stmt(k.body));
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            l: int = LIFE_IMM;
            saw: int = 0;
            while (arm != null) {
                al: int = stmt_result_life(arm.body);
                if (saw == 0) {
                    l = al;
                } else {
                    l = life_meet(l, al);
                }
                saw = 1;
                arm = arm.next;
            }
            l;
        }
        Funcall k -> {
            if (io_allows_stack(k.funcname)) {
                return LIFE_IMM;
            }
            if (streq(k.funcname, "len") || streq(k.funcname, "memcpy")) {
                return LIFE_IMM;
            }
            fno: ?*Function = k.fn;
            if (fno == null) {
                fno = find_function(k.funcname);
            }
            if (fno == null) {
                return LIFE_IMM;
            }
            instantiate_bound(fno, fno.ret_bound, k.args);
        }
        StructLit k -> {
            field_inits_life(k.inits);
        }
        VariantLit k -> {
            field_inits_life(k.inits);
        }
        Null -> {
            LIFE_IMM;
        }
        _ -> {
            LIFE_IMM;
        }
    }
}

dest_life(n: *Expr) raises Error: int {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) {
                return LIFE_IMM;
            }
            obj_storage_life(v);
        }
        Deref k -> {
            expr_life(k.lhs);
        }
        MemberAccess k -> {
            lt: ?*Type = decay(k.lhs.ty);
            if (lt != null && (is_pointer(lt) || is_opt_pointer(lt) || is_slice(lt))) {
                return expr_life(k.lhs);
            }
            dest_life(k.lhs);
        }
        Index k -> {
            lt2: ?*Type = k.lhs.ty;
            if (lt2 != null && (is_slice(lt2) || is_zptr(lt2))) {
                return expr_life(k.lhs);
            }
            dest_life(k.lhs);
        }
        _ -> {
            LIFE_SELF;
        }
    }
}

escape_error(n: ?*Expr) noregion raises Error {
    fn: ?*Function = current_fn;
    if (is_tainted_expr(n) || is_stack_addr(n)) {
        if (fn != null) {
            sb: *StrBuf = sb_new();
            sb_puts(sb, "address of local cannot escape in ");
            sb_puts(sb, fn.name);
            error(sb_finish(sb));
        }
        error("address of local cannot escape");
    }
    if (fn != null) {
        sb2: *StrBuf = sb_new();
        sb_puts(sb2, "region pointer cannot escape in ");
        sb_puts(sb2, fn.name);
        error(sb_finish(sb2));
    }
    error("region pointer cannot escape");
}

note_imm_heap() {
    fn: ?*Function = current_fn;
    if (fn != null) {
        fn.need_imm_heap = 1;
        fn.imm_heap_direct = 1;
    }
}

is_current_param(o: ?*Obj): bool {
    fn: ?*Function = current_fn;
    if (o == null || fn == null) {
        return false;
    }
    p: ?*Obj = fn.params;
    while (p != null) {
        if (p == o) {
            return true;
        }
        p = p.param_next;
    }
    false;
}

find_param_by_life(id: int): ?*Obj {
    fn: ?*Function = current_fn;
    if (fn == null) {
        return null;
    }
    if (!life_is_param(id)) {
        return null;
    }
    p: ?*Obj = fn.params;
    while (p != null) {
        if (p.life == id) {
            return p;
        }
        p = p.param_next;
    }
    null;
}

constrain_param_to_dest(p: *Obj, dest: int) {
    if (dest == LIFE_IMM) {
        p.bound_need_imm = 1;
        return;
    }
    if (dest == LIFE_HEAPTOP) {
        p.bound_need_new = 1;
        return;
    }
    q: ?*Obj = find_param_by_life(dest);
    if (q != null && q != p) {
        if (p.bound_named == null) {
            p.bound_named = q;
        }
    }
}

note_params_in_inits(inits: ?*FieldInit, dest: int) raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        note_params_in_expr(a.lhs, dest);
        a = a.next;
    }
}

note_params_in_stmt(s: ?*Stmt, dest: int) raises Error {
    if (s == null) {
        return;
    }
    match s.kind {
        ExprStmt k -> {
            note_params_in_expr(k.lhs, dest);
        }
        Block k -> {
            note_params_in_stmt(last_stmt(k.body), dest);
        }
        If k -> {
            note_params_in_stmt(k.then, dest);
            note_params_in_stmt(k.els, dest);
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                note_params_in_stmt(arm.body, dest);
                arm = arm.next;
            }
        }
        Try k -> {
            note_params_in_stmt(k.body, dest);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                note_params_in_stmt(a.body, dest);
                a = a.next;
            }
        }
        Region k -> {
            note_params_in_stmt(k.body, dest);
        }
        Return k -> {
            note_params_in_expr(k.lhs, dest);
        }
        _ -> { }
    }
}

note_params_in_expr(n: ?*Expr, dest: int) raises Error {
    if (n == null) {
        return;
    }
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) {
                return;
            }
            if (is_current_param(v)) {
                constrain_param_to_dest(v, dest);
                return;
            }
            q: ?*Obj = find_param_by_life(v.life);
            if (q != null) {
                constrain_param_to_dest(q, dest);
            }
        }
        Addr k -> {
            note_params_in_expr(k.lhs, dest);
        }
        Deref k -> {
            note_params_in_expr(k.lhs, dest);
        }
        MemberAccess k -> {
            note_params_in_expr(k.lhs, dest);
        }
        Index k -> {
            note_params_in_expr(k.lhs, dest);
        }
        As k -> {
            note_params_in_expr(k.lhs, dest);
        }
        Trunc k -> {
            note_params_in_expr(k.lhs, dest);
        }
        Assign k -> {
            note_params_in_expr(k.rhs, dest);
        }
        If k -> {
            note_params_in_expr(k.then, dest);
            note_params_in_expr(k.els, dest);
        }
        OrElse k -> {
            note_params_in_expr(k.lhs, dest);
            note_params_in_expr(k.rhs, dest);
        }
        Block k -> {
            note_params_in_stmt(last_stmt(k.body), dest);
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                note_params_in_stmt(arm.body, dest);
                arm = arm.next;
            }
        }
        StructLit k -> {
            note_params_in_inits(k.inits, dest);
        }
        VariantLit k -> {
            note_params_in_inits(k.inits, dest);
        }
        New k -> {
            note_params_in_inits(k.inits, dest);
        }
        _ -> { }
    }
}

note_bound_call_param(callee_po: *Obj@immortal, p: *Obj@immortal) noregion {
    fn: ?*Function = current_fn;
    if (fn == null) {
        return;
    }
    fn.bound_calls = new BoundCall { caller_param: p, callee_param: callee_po, next: fn.bound_calls };
}

note_bound_calls_in_inits(inits: ?*FieldInit, callee_po: *Obj@immortal) noregion raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        note_bound_calls_in_expr(a.lhs, callee_po);
        a = a.next;
    }
}

note_bound_calls_in_stmt(s: ?*Stmt, callee_po: *Obj@immortal) noregion raises Error {
    if (s == null) {
        return;
    }
    match s.kind {
        ExprStmt k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
        }
        Block k -> {
            note_bound_calls_in_stmt(last_stmt(k.body), callee_po);
        }
        If k -> {
            note_bound_calls_in_stmt(k.then, callee_po);
            note_bound_calls_in_stmt(k.els, callee_po);
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                note_bound_calls_in_stmt(arm.body, callee_po);
                arm = arm.next;
            }
        }
        Try k -> {
            note_bound_calls_in_stmt(k.body, callee_po);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                note_bound_calls_in_stmt(a.body, callee_po);
                a = a.next;
            }
        }
        Region k -> {
            note_bound_calls_in_stmt(k.body, callee_po);
        }
        Return k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
        }
        _ -> { }
    }
}

note_bound_calls_in_expr(n: ?*Expr, callee_po: *Obj@immortal) noregion raises Error {
    if (n == null) {
        return;
    }
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) {
                return;
            }
            if (is_current_param(v)) {
                note_bound_call_param(callee_po, v);
                return;
            }
            q: ?*Obj = find_param_by_life(v.life);
            if (q != null) {
                note_bound_call_param(callee_po, q);
            }
        }
        Addr k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
        }
        Deref k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
        }
        MemberAccess k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
        }
        Index k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
        }
        As k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
        }
        Trunc k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
        }
        Assign k -> {
            note_bound_calls_in_expr(k.rhs, callee_po);
        }
        If k -> {
            note_bound_calls_in_expr(k.then, callee_po);
            note_bound_calls_in_expr(k.els, callee_po);
        }
        OrElse k -> {
            note_bound_calls_in_expr(k.lhs, callee_po);
            note_bound_calls_in_expr(k.rhs, callee_po);
        }
        Block k -> {
            note_bound_calls_in_stmt(last_stmt(k.body), callee_po);
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                note_bound_calls_in_stmt(arm.body, callee_po);
                arm = arm.next;
            }
        }
        StructLit k -> {
            note_bound_calls_in_inits(k.inits, callee_po);
        }
        VariantLit k -> {
            note_bound_calls_in_inits(k.inits, callee_po);
        }
        New k -> {
            note_bound_calls_in_inits(k.inits, callee_po);
        }
        _ -> { }
    }
}

note_sig_store(src: ?*Expr, dest: int) raises Error {
    if (src == null) {
        return;
    }
    if (current_fn == null) {
        return;
    }
    sl: int = expr_life(src);
    if (sl == LIFE_HEAPTOP) {
        dp: ?*Obj = find_param_by_life(dest);
        if (dp != null) {
            dp.bound_need_new = 1;
        }
    }
    note_params_in_expr(src, dest);
}

note_sig_return(src: ?*Expr) raises Error {
    fn: ?*Function = current_fn;
    if (src == null || fn == null) {
        return;
    }
    sl: int = expr_life(src);
    if (sl == LIFE_HEAPTOP) {
        fn.bound_ret_need_new = 1;
    }
    rp: ?*Obj = find_param_by_life(sl);
    if (rp != null) {
        if (fn.bound_ret_param == null) {
            fn.bound_ret_param = rp;
        }
        note_params_in_expr(src, rp.life);
        return;
    }
    if (sl == LIFE_HEAPTOP) {
        note_params_in_expr(src, LIFE_HEAPTOP);
    }
}

check_store(src: ?*Expr, dest: int) noregion raises Error {
    if (src == null) {
        return;
    }
    if (!type_has_pointers(src.ty) && !is_tainted_expr(src) && !is_stack_addr(src)) {
        return;
    }
    sl: int = expr_life(src);
    note_sig_store(src, dest);
    if (life_outlives(sl, dest)) {
        return;
    }
    if (dest == LIFE_IMM && sl == LIFE_HEAPTOP) {
        note_imm_heap();
        return;
    }
    if (sl == LIFE_HEAPTOP && find_param_by_life(dest) != null) {
        return;
    }
    if (life_is_param(sl) && !is_tainted_expr(src) && !is_stack_addr(src)) {
        return;
    }
    escape_error(src);
}

return_needs_new() noregion raises Error {
    fn: ?*Function = current_fn;
    if (fn != null) {
        sb: *StrBuf = sb_new();
        sb_puts(sb, "return of new requires @new on ");
        sb_puts(sb, fn.name);
        error(sb_finish(sb));
    }
    error("return of new requires @new");
}

check_return(src: ?*Expr) noregion raises Error {
    if (src == null) {
        return;
    }
    if (!type_has_pointers(src.ty) && !is_tainted_expr(src) && !is_stack_addr(src)) {
        return;
    }
    sl: int = expr_life(src);
    dest: int = LIFE_IMM;
    cfn: ?*Function = current_fn;
    if (cfn != null) {
        dest = cfn.ret_life;
    }
    note_sig_return(src);
    if (dest == LIFE_IMM && sl == LIFE_HEAPTOP) {
        return_needs_new();
    }
    if (life_outlives(sl, dest)) {
        return;
    }
    if (life_is_param(sl) && !is_tainted_expr(src) && !is_stack_addr(src)) {
        return;
    }
    escape_error(src);
}

check_exc_payload(src: ?*Expr) raises Error {
    if (src == null) {
        return;
    }
    if (!type_has_pointers(src.ty) && !is_tainted_expr(src) && !is_stack_addr(src)) {
        return;
    }
    sl: int = expr_life(src);
    note_sig_store(src, LIFE_IMM);
    if (life_outlives(sl, LIFE_IMM)) {
        return;
    }
    if (sl == LIFE_HEAPTOP) {
        note_imm_heap();
        return;
    }
    if (life_is_param(sl) && !is_tainted_expr(src) && !is_stack_addr(src)) {
        return;
    }
    if (is_tainted_expr(src) || is_stack_addr(src)) {
        error("exception payload cannot hold the address of a local");
    }
    error("exception payload cannot hold a region pointer");
}

check_call_lifetimes(fno: *Function@immortal, args: ?*Expr) noregion raises Error {
    a: ?*Expr = args;
    po: ?*Obj = fno.params;
    cfn: ?*Function = current_fn;
    while (a != null) {
        if (po != null) {
            sl: int = expr_life(a);
            if (cfn != null && fno.is_extern == 0) {
                pou: *Obj = po;
                note_bound_calls_in_expr(a, pou);
            }
            if (!life_is_self_bound(po)) {
                need: int = instantiate_bound(fno, po.life_bound, args);
                if (!life_outlives(sl, need)) {
                    if (sl == LIFE_HEAPTOP && need == LIFE_IMM) {
                        note_imm_heap();
                    } else {
                        qp2: ?*Obj = find_param_by_life(sl);
                        if (qp2 != null && !is_tainted_expr(a) && !is_stack_addr(a)) {
                            constrain_param_to_dest(qp2, need);
                        } else if (!is_tainted_expr(a) && !is_stack_addr(a) && type_has_pointers(a.ty)) {
                            note_params_in_expr(a, need);
                            if (qp2 == null && life_is_region(sl)) {
                                escape_error(a);
                            }
                        } else {
                            escape_error(a);
                        }
                    }
                } else {
                    qp3: ?*Obj = find_param_by_life(sl);
                    if (qp3 != null && sl != LIFE_IMM && need != LIFE_SELF && need != LIFE_IMM && need != LIFE_HEAPTOP) {
                        constrain_param_to_dest(qp3, need);
                    }
                }
            }
            po = po.param_next;
        }
        a = a.next;
    }
}

index_lhs_var(n: *Expr): ?*Obj {
    match n.kind {
        Var k -> {
            k.var;
        }
        _ -> {
            null;
        }
    }
}

index_idx_num(n: *Expr): int {
    match n.kind {
        Num k -> {
            if (k.str_label == 0) {
                k.val;
            } else {
                0 - 1;
            }
        }
        _ -> {
            0 - 1;
        }
    }
}

index_idx_var(n: *Expr): ?*Obj {
    match n.kind {
        Var k -> {
            k.var;
        }
        _ -> {
            null;
        }
    }
}

zindex_ok(str: ?*Obj@new, idx: *Expr) noregion: bool {
    if (is_addr_taken(str)) {
        kn0: int = index_idx_num(idx);
        return kn0 == 0;
    }
    kn: int = index_idx_num(idx);
    if (kn >= 0) {
        if (kn <= walk_hi(str)) {
            return true;
        }
        return false;
    }
    iv: ?*Obj = index_idx_var(idx);
    if (iv == null) {
        return false;
    }
    if (is_addr_taken(iv)) {
        return false;
    }
    if (walk_cursor(str) == iv) {
        return true;
    }
    if (is_zero_var(iv) && walk_hi(str) >= 0) {
        walk_push(str, walk_hi(str), iv);
        return true;
    }
    false;
}

walk_advance_index(lhs: *Expr, idx: *Expr) noregion {
    raw: ?*Type = lhs.ty;
    if (raw == null || !is_zptr(raw)) {
        return;
    }
    sv: ?*Obj = index_lhs_var(lhs);
    if (is_addr_taken(sv)) {
        return;
    }
    kn: int = index_idx_num(idx);
    if (kn >= 0) {
        walk_push(sv, kn + 1, walk_cursor(sv));
        return;
    }
    iv: ?*Obj = index_idx_var(idx);
    if (iv != null) {
        walk_push(sv, walk_hi(sv), iv);
    }
}

is_nonzero_byte_expr(n: *Expr): bool {
    match n.kind {
        Num k -> {
            k.str_label == 0 && k.val != 0;
        }
        _ -> {
            false;
        }
    }
}

expr_is_zero_lit(n: *Expr): bool {
    match n.kind {
        Num k -> {
            k.str_label == 0 && k.val == 0;
        }
        _ -> {
            false;
        }
    }
}

walk_advance_cond(cond: ?*Expr) noregion {
    if (cond == null) {
        return;
    }
    match cond.kind {
        LogAnd k -> {
            walk_advance_cond(k.lhs);
            walk_advance_cond(k.rhs);
            return;
        }
        Binary k -> {
            ix: ?*Expr = null;
            other: ?*Expr = null;
            match k.lhs.kind {
                Index _p -> {
                    ix = k.lhs;
                    other = k.rhs;
                }
                _ -> { }
            }
            if (ix == null) {
                match k.rhs.kind {
                    Index _p2 -> {
                        ix = k.rhs;
                        other = k.lhs;
                    }
                    _ -> { }
                }
            }
            if (ix == null || other == null) {
                return;
            }
            match ix.kind {
                Index q -> {
                    match k.op {
                        Ne -> {
                            if (expr_is_zero_lit(other)) {
                                walk_advance_index(q.lhs, q.idx);
                            }
                        }
                        Eq -> {
                            if (is_nonzero_byte_expr(other)) {
                                walk_advance_index(q.lhs, q.idx);
                            }
                        }
                        _ -> { }
                    }
                }
                _ -> { }
            }
        }
        _ -> { }
    }
}

opt_local_var(n: ?*Expr): ?*Obj {
    if (n != null) {
        match n.kind {
            Var k -> {
                var: ?*Obj = k.var;
                if (var != null) {
                    if (var.is_local == 0) {
                        return null;
                    }
                    if (is_addr_taken(var)) {
                        return null;
                    }
                    t: ?*Type = decay(var.ty);
                    if (t != null && is_opt_pointer(t)) {
                        return var;
                    }
                    return null;
                }
                return null;
            }
            _ -> {
                return null;
            }
        }
    }
    null;
}

null_sides(lhs: *Expr, rhs: *Expr): ?*Obj {
    if (is_null_expr(rhs)) {
        return opt_local_var(lhs);
    }
    if (is_null_expr(lhs)) {
        return opt_local_var(rhs);
    }
    null;
}

null_check_var(cond: ?*Expr): ?*Obj {
    if (cond != null) {
        match cond.kind {
            Binary k -> {
                match k.op {
                    Ne -> {
                        return null_sides(k.lhs, k.rhs);
                    }
                    _ -> {
                        return null;
                    }
                }
            }
            _ -> {
                return null;
            }
        }
    }
    null;
}

null_eq_var(cond: ?*Expr): ?*Obj {
    if (cond != null) {
        match cond.kind {
            Binary k -> {
                match k.op {
                    Eq -> {
                        return null_sides(k.lhs, k.rhs);
                    }
                    _ -> {
                        return null;
                    }
                }
            }
            _ -> {
                return null;
            }
        }
    }
    null;
}

narrow_push_ne_nulls(cond: ?*Expr) noregion raises Error {
    if (parse_resolve == 0) {
        return;
    }
    if (cond != null) {
        match cond.kind {
            LogAnd k -> {
                narrow_push_ne_nulls(k.lhs);
                narrow_push_ne_nulls(k.rhs);
                return;
            }
            _ -> {
                v: ?*Obj = null_check_var(cond);
                if (v != null) {
                    vt: ?*Type = decay(v.ty);
                    if (vt == null) {
                        error("missing type");
                    }
                    narrow_push(v, ptr_to(type_base(vt)));
                }
            }
        }
    }
}

narrow_push_eq_nulls(cond: ?*Expr) noregion raises Error {
    if (parse_resolve == 0) {
        return;
    }
    if (cond != null) {
        match cond.kind {
            LogOr k -> {
                narrow_push_eq_nulls(k.lhs);
                narrow_push_eq_nulls(k.rhs);
                return;
            }
            _ -> {
                v: ?*Obj = null_eq_var(cond);
                if (v != null) {
                    vt: ?*Type = decay(v.ty);
                    if (vt == null) {
                        error("missing type");
                    }
                    narrow_push(v, ptr_to(type_base(vt)));
                }
            }
        }
    }
}

decl_spec() noregion raises Error: *Type@new {
    if (tok.kind == TokKind.Int) {
        tok = tok.next;
        return ty_int;
    }
    if (tok.kind == TokKind.I8) {
        tok = tok.next;
        return ty_i8;
    }
    if (tok.kind == TokKind.Bool) {
        tok = tok.next;
        return ty_bool;
    }
    if (tok.kind == TokKind.Noreturn) {
        tok = tok.next;
        return ty_noreturn;
    }
    if (tok.kind == TokKind.Ident) {
        name: []i8 = cur_tokstr();
        browse_note();
        ed: ?*EnumDef = find_enum(name);
        if (ed != null) {
            tok = tok.next;
            browse_add(browse_tok_file, browse_tok_pos, browse_tok_len, ed.browse_id,
                0, BROWSE_TY, name);
            return enum_type(ed);
        }
        xd: ?*ExnDef = find_exn(name);
        if (xd != null) {
            tok = tok.next;
            browse_add(browse_tok_file, browse_tok_pos, browse_tok_len, xd.browse_id,
                0, BROWSE_TY, name);
            return exn_type(xd);
        }
        tok = tok.next;
        sd: *StructDef = get_or_create_struct(name);
        browse_add(browse_tok_file, browse_tok_pos, browse_tok_len, sd.browse_id,
            0, BROWSE_TY, name);
        return struct_type(sd);
    }
    error("expected type");
}

parse_type() noregion raises Error: *Type@new {
    if (tok.kind == TokKind.LBrack) {
        tok = tok.next;
        if (tok.kind == TokKind.RBrack) {
            tok = tok.next;
            base0: *Type = parse_type();
            if (is_noreturn_ty(base0)) {
                error("noreturn cannot be a slice element");
            }
            return slice_of(base0);
        }
        if (tok.kind == TokKind.Ident && streq(cur_tokstr(), "z")) {
            tok = tok.next;
            skip(TokKind.RBrack);
            base3: *Type = parse_type();
            if (is_noreturn_ty(base3)) {
                error("noreturn cannot be a C-string element");
            }
            return zptr_of(base3);
        }
        error("expected a slice or C-string type");
    }
    if (tok.kind == TokKind.Question) {
        tok = tok.next;
        if (tok.kind != TokKind.Star) {
            error("expected * after ? in optional pointer type");
        }
        tok = tok.next;
        base: *Type = parse_type();
        if (is_noreturn_ty(base)) {
            error("noreturn cannot be pointed to");
        }
        return opt_ptr_to(base);
    }
    if (tok.kind == TokKind.Star) {
        tok = tok.next;
        base: *Type = parse_type();
        if (is_noreturn_ty(base)) {
            error("noreturn cannot be pointed to");
        }
        return ptr_to(base);
    }
    decl_spec();
}

parse_expr() noregion raises Error: *Expr@new {
    parse_assign();
}

parse_field_inits(members: ?*Member@new) noregion raises Error: ?*FieldInit@new {
    skip(TokKind.LBrace);
    head: ?*FieldInit = null;
    cur: ?*FieldInit = null;
    while (tok.kind != TokKind.RBrace) {
        if (cur != null) {
            skip(TokKind.Comma);
        }
        if (tok.kind != TokKind.Ident) {
            error("expected field name");
        }
        fname: []i8 = cur_tokstr();
        browse_note();
        tok = tok.next;
        skip(TokKind.Colon);
        m: ?*Member = find_field(members, fname);
        if (m == null && parse_resolve != 0 && members != null) {
            error("unknown field");
        }
        i: ?*FieldInit = head;
        while (i != null) {
            if (streq(i.name, fname)) {
                error("duplicate field");
            }
            i = i.next;
        }
        e: *Expr = parse_expr();
        lhs: ?*Expr = e;
        init: *FieldInit = new_field_init(fname, m, lhs);
        if (cur != null) {
            cur.next = init;
            cur = init;
        } else {
            head = init;
            cur = init;
        }
    }
    if (parse_resolve != 0) {
        m2: ?*Member = members;
        while (m2 != null) {
            found: int = 0;
            i2: ?*FieldInit = head;
            while (i2 != null) {
                if (i2.member == m2) {
                    found = 1;
                }
                i2 = i2.next;
            }
            if (found == 0) {
                error("missing field");
            }
            m2 = m2.next;
        }
    }
    skip(TokKind.RBrace);
    if (parse_resolve != 0 && head == null) {
        error("empty list");
    }
    head;
}

parse_struct_field_inits(sty: *Type) noregion raises Error: ?*FieldInit@new {
    if (parse_resolve != 0 && !is_struct_ty(sty)) {
        error("struct literal requires a struct type");
    }
    ms: ?*Member = null;
    if (is_struct_ty(sty)) {
        ms = type_struct_def(sty).members;
    }
    parse_field_inits(ms);
}

parse_exn_field_inits(ed: *ExnDef@new) noregion raises Error: ?*FieldInit@new {
    if (ed.members == null) {
        if (parse_resolve != 0) {
            error("unit exception does not take fields");
        }
        if (tok.kind != TokKind.LBrace) {
            return null;
        }
    }
    parse_field_inits(ed.members);
}

parse_variant_field_inits(v: *Variant@new) noregion raises Error: ?*FieldInit@new {
    parse_field_inits(v.fields);
}

parse_primary() noregion raises Error: *Expr@new {
    n: *Expr;
    if (tok.kind == TokKind.New) {
        tok = tok.next;
        if (tok.next.kind == TokKind.Dot && (is_type_name() || parse_resolve == 0)) {
            ety: *Type = syntax_as_enum(parse_type());
            skip(TokKind.Dot);
            if (tok.kind != TokKind.Ident) {
                error("expected variant name after new Enum.");
            }
            vname: []i8 = cur_tokstr();
            browse_note();
            hvpos: int = browse_tok_pos;
            hvlen: int = browse_tok_len;
            hvfile: int = browse_tok_file;
            tok = tok.next;
            vo: ?*Variant = find_variant(type_enum_def(ety), vname);
            if (vo == null && parse_resolve != 0) {
                error("unknown variant");
            }
            args: ?*FieldInit = null;
            tag: int = 0;
            if (vo != null) {
                v: *Variant = vo;
                tag = v.tag;
                if (tok.kind == TokKind.LBrace) {
                    if (v.fields == null) {
                        error("unit variant does not take fields");
                    }
                    args = parse_variant_field_inits(v);
                } else {
                    if (v.fields != null) {
                        error("variant requires field initializers");
                    }
                }
            } else {
                if (tok.kind == TokKind.LBrace) {
                    args = parse_field_inits(null);
                }
            }
            hn: *Expr = new_heap_node(null, tag, args, vo, null, vname, ptr_to(ety));
            hn.pos = hvpos;
            hn.file = hvfile;
            hn.toklen = hvlen;
            return hn;
        }
        base: *Type = parse_type();
        if (tok.kind == TokKind.LBrack) {
            tok = tok.next;
            len: *Expr = parse_expr();
            skip(TokKind.RBrack);
            if (is_noreturn_ty(base)) {
                error("new [n] element type cannot be noreturn");
            }
            if (tok.kind != TokKind.LParen) {
                error("new T[n] requires an initial value (new T[n](v))");
            }
            tok = tok.next;
            fill: *Expr = parse_expr();
            skip(TokKind.RParen);
            return new_heap_node(len, 1, null, null, fill, "", slice_of(base));
        }
        if (is_pointer(base)) {
            error("new expects a non-pointer type");
        }
        if (tok.kind != TokKind.LBrace) {
            error("expected {, [, or .Variant after new");
        }
        if (is_enum_ty(base)) {
            error("use new Enum.Variant { ... } for sum types");
        }
        return new_heap_node(null, 0, parse_struct_field_inits(base), null, null,
            "", ptr_to(base));
    }
    if (tok.kind == TokKind.Sizeof) {
        tok = tok.next;
        skip(TokKind.LParen);
        if (starts_type()) {
            ty: *Type = parse_type();
            skip(TokKind.RParen);
            sn: *Expr = new_sizeof_ty(ty);
            sn.ty = ty_int;
            return sn;
        }
        n = parse_expr();
        skip(TokKind.RParen);
        return new_sizeof_e(n);
    }
    if (tok.kind == TokKind.LParen) {
        tok = tok.next;
        n = parse_expr();
        skip(TokKind.RParen);
        return n;
    }
    if (tok.kind == TokKind.Num) {
        ival: int = tok.val;
        tok = tok.next;
        if (tok.kind == TokKind.I8) {
            if (ival < 0 || ival > 255) {
                error("i8 literal out of range");
            }
            tok = tok.next;
            n = mk_expr(ExprKind.Num { val: ival, str_label: 0, form: LIT_I8 });
            n.ty = ty_i8;
            return n;
        }
        n = new_num(ival);
        return n;
    }
    if (tok.kind == TokKind.True || tok.kind == TokKind.False) {
        bv: int = 0;
        form: int = LIT_FALSE;
        if (tok.kind == TokKind.True) {
            bv = 1;
            form = LIT_TRUE;
        }
        n = mk_expr(ExprKind.Num { val: bv, str_label: 0, form: form });
        n.ty = ty_bool;
        tok = tok.next;
        return n;
    }
    if (tok.kind == TokKind.Null) {
        tok = tok.next;
        return new_null_expr();
    }
    if (tok.kind == TokKind.Char) {
        n = mk_expr(ExprKind.Num { val: tok.val, str_label: 0, form: LIT_CHAR });
        n.ty = ty_i8;
        tok = tok.next;
        return n;
    }
    if (tok.kind == TokKind.Str) {
        label: int = add_string(source, tok.pos, tok.len);
        tok = tok.next;
        return new_str_num(label + 1);
    }
    if (tok.kind == TokKind.Ident) {
        name: []i8 = cur_tokstr();
        browse_note();
        nk: TokKind = tok.next.kind;
        if (nk == TokKind.Dot && (is_named_type(name) || syntax_variant_fields())) {
            ety: *Type = syntax_as_enum(parse_type());
            skip(TokKind.Dot);
            if (tok.kind != TokKind.Ident) {
                error("expected variant name");
            }
            vname: []i8 = cur_tokstr();
            browse_note();
            vpos: int = browse_tok_pos;
            vlen: int = browse_tok_len;
            vfile: int = browse_tok_file;
            tok = tok.next;
            vo: ?*Variant = find_variant(type_enum_def(ety), vname);
            if (vo == null && parse_resolve != 0) {
                error("unknown variant");
            }
            args: ?*FieldInit = null;
            tag: int = 0;
            if (vo != null) {
                v: *Variant = vo;
                tag = v.tag;
                if (tok.kind == TokKind.LBrace) {
                    if (v.fields == null) {
                        error("unit variant does not take fields");
                    }
                    args = parse_variant_field_inits(v);
                } else {
                    if (v.fields != null) {
                        error("variant requires field initializers");
                    }
                }
            } else {
                if (tok.kind == TokKind.LBrace) {
                    args = parse_field_inits(null);
                }
            }
            vl: *Expr = new_variant_lit(name, vname, vo, tag, args, ety);
            vl.pos = vpos;
            vl.file = vfile;
            vl.toklen = vlen;
            return vl;
        }
        if (nk == TokKind.LBrace && (is_named_type(name) || syntax_struct_lit())) {
            sty: *Type = parse_type();
            if (parse_resolve != 0 && !is_struct_ty(sty)) {
                error("struct literal requires a struct type");
            }
            return new_struct_lit(name, parse_struct_field_inits(sty), sty);
        }
        npos: int = browse_tok_pos;
        nlen: int = browse_tok_len;
        nfile: int = browse_tok_file;
        tok = tok.next;
        if (tok.kind == TokKind.LParen) {
            tok = tok.next;
            head: ?*Expr = null;
            cur: ?*Expr = null;
            while (tok.kind != TokKind.RParen) {
                if (cur != null) {
                    skip(TokKind.Comma);
                }
                arg: *Expr = parse_expr();
                if (cur != null) {
                    cur.next = arg;
                    cur = arg;
                } else {
                    head = arg;
                    cur = arg;
                }
            }
            skip(TokKind.RParen);
            fe: *Expr = new_funcall(name, head);
            fe.pos = npos;
            fe.file = nfile;
            fe.toklen = nlen;
            return fe;
        }
        varo: ?*Obj = find_var(name);
        if (varo == null) {
            if (parse_resolve != 0) {
                error("undefined variable");
            }
            ve0: *Expr = mk_expr(ExprKind.Var { var: null, name: name, member: null });
            ve0.pos = npos;
            ve0.file = nfile;
            ve0.toklen = nlen;
            return ve0;
        }
        var: *Obj = varo;
        ve: *Expr = new_var_node(var);
        ve.pos = npos;
        ve.file = nfile;
        ve.toklen = nlen;
        return ve;
    }
    if (tok.kind == TokKind.If) {
        return parse_if_expr();
    }
    if (tok.kind == TokKind.Match) {
        return parse_match_expr();
    }
    if (tok.kind == TokKind.LBrace) {
        return new_block_expr(parse_brace_stmts());
    }
    error("expected expression");
    new_num(0);
}

parse_if_expr() noregion raises Error: *Expr@new {
    skip(TokKind.If);
    skip(TokKind.LParen);
    cond: *Expr = parse_expr();
    skip(TokKind.RParen);
    then: *Expr = parse_expr();
    if (tok.kind != TokKind.Else) {
        error("if expression requires else");
    }
    tok = tok.next;
    els: *Expr = parse_expr();
    new_if_expr(cond, then, els);
}

parse_match_expr() noregion raises Error: *Expr@new {
    skip(TokKind.Match);
    mcond: *Expr = parse_expr();
    new_match_expr(mcond, parse_match_arms(mcond));
}

parse_match_arms(mcond: *Expr@new) noregion raises Error: ?*MatchArm@new {
    add_type(mcond);
    et: ?*Type = decay(mcond.ty);
    if (parse_resolve != 0) {
        if (et == null) {
            error_ty("match requires an enum value", et);
        }
        etu0: *Type = et;
        if (!is_enum_ty(etu0)) {
            error_ty("match requires an enum value", et);
        }
    }
    skip(TokKind.LBrace);
    arms: ?*MatchArm = null;
    acur: ?*MatchArm = null;
    while (tok.kind != TokKind.RBrace) {
        if (tok.kind != TokKind.Ident) {
            error("expected variant name in match arm");
        }
        vname: []i8 = cur_tokstr();
        vpos: int = tok.pos;
        vlen: int = tok.len;
        vfile: int = current_file_id;
        tok = tok.next;
        is_wild: bool = streq(vname, "_");
        binder_name: []i8 = "";
        have_binder: int = 0;
        have_paren: int = 0;
        if (tok.kind == TokKind.LParen) {
            /* Legacy Variant(name); prefer Variant name. */
            if (is_wild) {
                error("wildcard match arm cannot bind a payload");
            }
            tok = tok.next;
            if (tok.kind != TokKind.Ident) {
                error("expected payload binding name");
            }
            binder_name = cur_tokstr();
            browse_note();
            have_binder = 1;
            have_paren = 1;
            tok = tok.next;
            skip(TokKind.RParen);
        } else {
            if (tok.kind == TokKind.Ident) {
                if (is_wild) {
                    error("wildcard match arm cannot bind a payload");
                }
                binder_name = cur_tokstr();
                browse_note();
                have_binder = 1;
                tok = tok.next;
            } else {
                if (tok.kind == TokKind.LBrace) {
                    error("match field destructuring is not supported; use Variant name and field access");
                }
            }
        }
        skip(TokKind.Arrow);
        enter_scope();
        arm_variant_n: ?*Variant = null;
        arm_binder: ?*Obj = null;
        if (is_wild) {
            chk: ?*MatchArm = arms;
            while (chk != null) {
                if (streq(chk.name, "_")) {
                    error("duplicate wildcard match arm");
                }
                chk = chk.next;
            }
            if (have_binder != 0) {
                error("wildcard match arm cannot bind a payload");
            }
        } else {
            if (parse_resolve != 0) {
                etu: *Type = et or error("match requires an enum value");
                vo: ?*Variant = find_variant(type_enum_def(etu), vname);
                if (vo == null) {
                    error("unknown variant");
                }
                v: *Variant = vo;
                chk2: ?*MatchArm = arms;
                while (chk2 != null) {
                    if (chk2.variant == v) {
                        error("duplicate match arm");
                    }
                    chk2 = chk2.next;
                }
                arm_variant_n = v;
                if (have_binder != 0) {
                    if (v.payload_ty == null) {
                        error("unit variant cannot bind a payload");
                    }
                    bo: *Obj = new_obj(binder_name, 1);
                    bo.ty = v.payload_ty;
                    arm_binder = bo;
                }
            } else {
                if (have_binder != 0) {
                    arm_binder = new_obj(binder_name, 1);
                }
            }
        }
        arm_body_n: *Stmt = parse_compound();
        leave_scope();
        arm: *MatchArm = new_match_arm(vname, arm_variant_n, arm_binder, binder_name,
            have_paren, arm_body_n);
        arm.pos = vpos;
        arm.file = vfile;
        arm.toklen = vlen;
        if (acur != null) {
            acur.next = arm;
            acur = arm;
        } else {
            arms = arm;
            acur = arm;
        }
        if (is_wild) {
            if (tok.kind != TokKind.RBrace) {
                error("wildcard `_` must be the last match arm");
            }
        }
    }
    has_wild: int = 0;
    walk: ?*MatchArm = arms;
    while (walk != null) {
        if (streq(walk.name, "_")) {
            has_wild = 1;
        }
        walk = walk.next;
    }
    if (has_wild == 0 && parse_resolve != 0) {
        etu2: *Type = et or error("match requires an enum value");
        vv: ?*Variant = type_enum_def(etu2).variants;
        while (vv != null) {
            found2: int = 0;
            walk2: ?*MatchArm = arms;
            while (walk2 != null) {
                if (walk2.variant == vv) {
                    found2 = 1;
                }
                walk2 = walk2.next;
            }
            if (found2 == 0) {
                error("match not exhaustive");
            }
            vv = vv.next;
        }
    }
    tok = tok.next;
    arms;
}

parse_postfix() noregion raises Error: *Expr@new {
    n: *Expr = parse_primary();
    while (true) {
        if (tok.kind == TokKind.LBrack) {
            tok = tok.next;
            idx: *Expr = parse_expr();
            skip(TokKind.RBrack);
            n = new_index(n, idx);
        } else {
            if (tok.kind == TokKind.Dot) {
                if (tok.next.kind == TokKind.Star) {
                    tok = tok.next;
                    tok = tok.next;
                    n = new_deref(n);
                } else {
                    tok = tok.next;
                    if (tok.kind != TokKind.Ident) {
                        error("expected member name");
                    }
                    name: []i8 = cur_tokstr();
                    browse_note();
                    mpos: int = browse_tok_pos;
                    mlen: int = browse_tok_len;
                    mfile: int = browse_tok_file;
                    tok = tok.next;
                    if (parse_resolve == 0) {
                        n = new_member_access(n, name, null);
                        n.pos = mpos;
                        n.file = mfile;
                        n.toklen = mlen;
                    } else {
                        add_type(n);
                        t: ?*Type = decay(n.ty);
                        sty: *Type = n.ty or error("missing type");
                        if (t != null && is_opt_pointer(t)) {
                            error_ty("member access on optional pointer (use if (p != null) / while (p != null) to narrow)",
                                t);
                        }
                        if (t != null && is_pointer(t) && is_struct_ty(type_base(t))) {
                            sty = type_base(t);
                        } else {
                            if (t != null && is_pointer(t) && is_exn_ty(type_base(t))) {
                                sty = type_base(t);
                            } else {
                                if (!is_struct_ty(sty) && !is_exn_ty(sty)) {
                                    error_ty("member access on non-struct", n.ty);
                                }
                            }
                        }
                        m: ?*Member = null;
                        if (is_exn_ty(sty)) {
                            m = find_exn_member(type_exn_def(sty), name);
                        } else {
                            m = find_member(type_struct_def(sty), name);
                        }
                        if (m == null) {
                            error("unknown member");
                        }
                        mu: *Member = m;
                        n = new_member_access(n, name, mu);
                        n.pos = mpos;
                        n.file = mfile;
                        n.toklen = mlen;
                    }
                }
            } else {
                if (tok.kind == TokKind.As || tok.kind == TokKind.Trunc) {
                    is_trunc: bool = tok.kind == TokKind.Trunc;
                    tok = tok.next;
                    ty: *Type = parse_type();
                    if (is_trunc) {
                        n = new_trunc(n, ty);
                    } else {
                        n = new_as(n, ty);
                    }
                } else {
                    return n;
                }
            }
        }
    }
    n;
}

parse_unary() noregion raises Error: *Expr@new {
    if (tok.kind == TokKind.Plus) {
        tok = tok.next;
        return parse_unary();
    }
    if (tok.kind == TokKind.Minus) {
        tok = tok.next;
        return new_neg(parse_unary());
    }
    if (tok.kind == TokKind.Amp) {
        tok = tok.next;
        return new_addr(parse_unary());
    }
    if (tok.kind == TokKind.Not) {
        tok = tok.next;
        return new_not(parse_unary());
    }
    if (tok.kind == TokKind.Tilde) {
        tok = tok.next;
        return new_bitnot(parse_unary());
    }
    parse_postfix();
}

add_type(n: ?*Expr@new) noregion raises Error {
    if (parse_resolve == 0) {
        return;
    }
    if (n != null) {
        add_type_expr(n);
    }
}

add_type_stmt(s: ?*Stmt) noregion raises Error {
    if (parse_resolve == 0) {
        return;
    }
    if (s != null) {
        add_type_stmt_node(s);
    }
}

add_type_field_inits(inits: ?*FieldInit@new) noregion raises Error {
    add_type_field_inits_opt(inits, 0);
}

add_type_field_inits_heap(inits: ?*FieldInit@new) noregion raises Error {
    add_type_field_inits_opt(inits, 1);
}

add_type_field_inits_opt(inits: ?*FieldInit@new, heap: int) noregion raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        add_type(a.lhs);
        if (a.lhs != null) {
            mem: *Member = a.member or error("internal");
            if (!assignable(decay(mem.ty), a.lhs)) {
                error_have_expr_want("field initializer type mismatch", a.lhs, decay(mem.ty));
            }
            if (heap == 1) {
                check_store(a.lhs, life_heap);
            }
            if (heap == 2) {
                check_exc_payload(a.lhs);
            }
        }
        a = a.next;
    }
}

type_index_expr(p: *Expr, lhs: *Expr@new, idx: *Expr@new) noregion raises Error {
    add_type(lhs);
    add_type(idx);
    idt: ?*Type = decay(idx.ty);
    if (idt == null || !is_int_ty(idt)) {
        error("array index must be int");
    }
    raw: ?*Type = lhs.ty;
    if (raw == null) {
        error_ty("index of untyped expression", raw);
    }
    if (is_opt_pointer(raw)) {
        error_ty("index of optional pointer (use if (p != null) to narrow)", raw);
    }
    if (is_pointer(raw)) {
        error_ty("pointer indexing is not allowed (use []T or [z]T)", raw);
    }
    if (!is_indexable(raw)) {
        error_ty("index of non-array", raw);
    }
    if (is_zptr(raw)) {
        if (!zindex_ok(index_lhs_var(lhs), idx)) {
            error("C-string index not walked");
        }
    }
    p.ty = type_base(raw);
}

type_log(
    p: *Expr,
    lhs: *Expr@new,
    rhs: *Expr@new,
    and_op: int
) noregion raises Error {
    add_type(lhs);
    save: ?*NarrowFrame = narrow_top;
    wsave: ?*WalkFrame = walk_top;
    if (and_op != 0) {
        narrow_push_ne_nulls(lhs);
        walk_advance_cond(lhs);
    } else {
        narrow_push_eq_nulls(lhs);
    }
    add_type(rhs);
    narrow_reset(save);
    walk_reset(wsave);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) {
        error_have_and("&& / || require bool operands", lt, rt);
    }
    if (rt == null) {
        error_have_and("&& / || require bool operands", lt, rt);
    }
    if (!is_bool_ty(lt) || !is_bool_ty(rt)) {
        error_have_and("&& / || require bool operands", lt, rt);
    }
    p.ty = ty_bool;
}

type_or_else(p: *Expr@new, lhs: *Expr@new, rhs: *Expr@new) noregion raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) {
        error_ty("or requires an optional pointer on the left", lt);
    }
    if (!is_opt_pointer(lt)) {
        error_ty("or requires an optional pointer on the left", lt);
    }
    unwrapped: *Type = ptr_to(type_base(lt));
    if (rt != null && is_noreturn_ty(rt)) {
        p.ty = unwrapped;
        return;
    }
    if (rt != null && is_pointer(rt) && types_equal(type_base(rt), type_base(lt))) {
        p.ty = unwrapped;
        return;
    }
    error_have_want("or right-hand side must be *T or noreturn", rt, unwrapped);
}

type_int_arith(p: *Expr, lhs: *Expr@new, rhs: *Expr@new) noregion raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) {
        error_have_and("arithmetic requires int or i8 operands", lt, rt);
    }
    if (rt == null) {
        error_have_and("arithmetic requires int or i8 operands", lt, rt);
    }
    if (is_int_ty(lt) && is_int_ty(rt)) {
        p.ty = ty_int;
        return;
    }
    if (is_i8_ty(lt) && is_i8_ty(rt)) {
        p.ty = ty_i8;
        return;
    }
    error_have_and("arithmetic type mismatch", lt, rt);
}

type_shift(p: *Expr, lhs: *Expr@new, rhs: *Expr@new) noregion raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) {
        error_have_and("shift requires int or i8 left operand", lt, rt);
    }
    if (rt == null) {
        error_have_and("shift count requires int", lt, rt);
    }
    if (!is_int_ty(rt)) {
        error_have_and("shift count requires int", lt, rt);
    }
    if (is_i8_ty(lt)) {
        p.ty = ty_i8;
        return;
    }
    if (is_int_ty(lt)) {
        p.ty = ty_int;
        return;
    }
    error_have_and("shift requires int or i8 left operand", lt, rt);
}

type_eq_cmp(p: *Expr, lhs: *Expr@new, rhs: *Expr@new) noregion raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt != null && rt != null) {
        if (types_equal(lt, rt)) {
            p.ty = ty_bool;
            return;
        }
        if (is_any_pointer(lt) && is_any_pointer(rt) && types_equal(type_base(lt),
            type_base(rt))) {
            p.ty = ty_bool;
            return;
        }
    }
    if (bind_null_to_pointer(lt, rhs) || bind_null_to_pointer(rt, lhs)) {
        p.ty = ty_bool;
        return;
    }
    error_ty_vs("comparison type mismatch", lt, rt);
}

type_ord_cmp(p: *Expr, lhs: *Expr@new, rhs: *Expr@new) noregion raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) {
        error_ty_vs("comparison type mismatch", lt, rt);
    }
    if (rt == null) {
        error_ty_vs("comparison type mismatch", lt, rt);
    }
    if (!types_equal(lt, rt)) {
        error_ty_vs("comparison type mismatch", lt, rt);
    }
    p.ty = ty_bool;
}

type_binary(
    p: *Expr,
    op: BinOp,
    lhs: *Expr@new,
    rhs: *Expr@new
) noregion raises Error {
    match op {
        Add -> {
            add_type(lhs);
            add_type(rhs);
            lt: ?*Type = decay(lhs.ty);
            rt: ?*Type = decay(rhs.ty);
            if (lt == null) {
                error_have_and("arithmetic requires int or i8 operands", lt, rt);
            }
            if (rt == null) {
                error_have_and("arithmetic requires int or i8 operands", lt, rt);
            }
            type_int_arith(p, lhs, rhs);
            return;
        }
        Sub -> {
            add_type(lhs);
            add_type(rhs);
            lt: ?*Type = decay(lhs.ty);
            rt: ?*Type = decay(rhs.ty);
            if (lt == null) {
                error_have_and("arithmetic requires int or i8 operands", lt, rt);
            }
            if (rt == null) {
                error_have_and("arithmetic requires int or i8 operands", lt, rt);
            }
            type_int_arith(p, lhs, rhs);
            return;
        }
        Mul -> {
            type_int_arith(p, lhs, rhs);
            return;
        }
        Div -> {
            type_int_arith(p, lhs, rhs);
            return;
        }
        Mod -> {
            type_int_arith(p, lhs, rhs);
            return;
        }
        And -> {
            type_int_arith(p, lhs, rhs);
            return;
        }
        Or -> {
            type_int_arith(p, lhs, rhs);
            return;
        }
        Xor -> {
            type_int_arith(p, lhs, rhs);
            return;
        }
        Shl -> {
            type_shift(p, lhs, rhs);
            return;
        }
        Shr -> {
            type_shift(p, lhs, rhs);
            return;
        }
        Eq -> {
            type_eq_cmp(p, lhs, rhs);
            return;
        }
        Ne -> {
            type_eq_cmp(p, lhs, rhs);
            return;
        }
        Lt -> {
            type_ord_cmp(p, lhs, rhs);
            return;
        }
        Le -> {
            type_ord_cmp(p, lhs, rhs);
            return;
        }
        Gt -> {
            type_ord_cmp(p, lhs, rhs);
            return;
        }
        Ge -> {
            type_ord_cmp(p, lhs, rhs);
            return;
        }
    }
}

unify_value_ty(a: ?*Type, b: ?*Type) noregion raises Error: ?*Type@b {
    if (a == null && b == null) {
        return null;
    }
    if (a == null) {
        if (b != null && is_noreturn_ty(b)) {
            return null;
        }
        error_ty_vs("branch type mismatch", a, b);
    }
    if (b == null) {
        if (is_noreturn_ty(a)) {
            return null;
        }
        error_ty_vs("branch type mismatch", a, b);
    }
    au: *Type = a;
    bu: *Type = b;
    if (is_noreturn_ty(au)) {
        return bu;
    }
    if (is_noreturn_ty(bu)) {
        return au;
    }
    da: ?*Type = decay(au);
    db: ?*Type = decay(bu);
    if (da != null && db != null && types_equal(da, db)) {
        return da;
    }
    if (da != null && db != null && is_opt_pointer(da) && is_pointer(db) && types_equal(type_base(da),
        type_base(db))) {
        return da;
    }
    if (da != null && db != null && is_opt_pointer(db) && is_pointer(da) && types_equal(type_base(db),
        type_base(da))) {
        return db;
    }
    error_ty_vs("branch type mismatch", da, db);
    null;
}

opt_ptr_of(t: ?*Type) noregion raises Error: *Type@new {
    if (t == null) {
        error("null requires a pointer type");
    }
    d: ?*Type = decay(t);
    if (d == null) {
        error("null requires a pointer type");
    }
    if (is_opt_pointer(d)) {
        return d;
    }
    if (is_pointer(d)) {
        return opt_ptr_to(type_base(d));
    }
    error_ty("null requires a pointer type", d);
    d;
}

unify_value_results(
    a: ?*Type,
    a_null: bool,
    b: ?*Type,
    b_null: bool
) noregion raises Error: ?*Type@new {
    if (a_null && b_null) {
        return null;
    }
    if (a_null) {
        if (b != null && is_noreturn_ty(b)) {
            return null;
        }
        return opt_ptr_of(b);
    }
    if (b_null) {
        if (a != null && is_noreturn_ty(a)) {
            return null;
        }
        return opt_ptr_of(a);
    }
    unify_value_ty(a, b);
}

last_stmt(head: ?*Stmt): ?*Stmt@head {
    s: ?*Stmt = head;
    last: ?*Stmt = null;
    while (s != null) {
        last = s;
        s = s.next;
    }
    last;
}

is_null_value_expr(n: ?*Expr): bool {
    if (n == null) {
        return false;
    }
    match n.kind {
        Null -> {
            true;
        }
        Block q -> {
            stmt_is_null_value(last_stmt(q.body));
        }
        If q -> {
            then_n: bool = is_null_value_expr(q.then);
            els_n: bool = is_null_value_expr(q.els);
            then_d: bool = false;
            tty: ?*Type = q.then.ty;
            if (tty != null && is_noreturn_ty(tty)) {
                then_d = true;
            }
            els_d: bool = false;
            ety: ?*Type = q.els.ty;
            if (ety != null && is_noreturn_ty(ety)) {
                els_d = true;
            }
            if (!then_n && !then_d) {
                return false;
            }
            if (!els_n && !els_d) {
                return false;
            }
            then_n || els_n;
        }
        Match q -> {
            match_arms_null_like(q.arms);
        }
        _ -> {
            false;
        }
    }
}

stmt_is_null_value(s: ?*Stmt): bool {
    if (s == null) {
        return false;
    }
    match s.kind {
        ExprStmt k -> {
            is_null_value_expr(k.lhs);
        }
        Block k -> {
            stmt_is_null_value(last_stmt(k.body));
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els == null) {
                return false;
            }
            then_n: bool = stmt_is_null_value(k.then);
            els_n: bool = stmt_is_null_value(els);
            then_d: bool = stmt_always_diverges(k.then);
            els_d: bool = stmt_always_diverges(els);
            if (!then_n && !then_d) {
                return false;
            }
            if (!els_n && !els_d) {
                return false;
            }
            then_n || els_n;
        }
        Match k -> {
            match_arms_null_like(k.arms);
        }
        Try k -> {
            if (!stmt_is_null_value(k.body) && !stmt_always_diverges(k.body)) {
                return false;
            }
            any_null: bool = stmt_is_null_value(k.body);
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                if (stmt_is_null_value(arm.body)) {
                    any_null = true;
                } else {
                    if (!stmt_always_diverges(arm.body)) {
                        return false;
                    }
                }
                arm = arm.next;
            }
            any_null;
        }
        _ -> {
            false;
        }
    }
}

match_arms_null_like(arms: ?*MatchArm): bool {
    any_null: bool = false;
    arm: ?*MatchArm = arms;
    while (arm != null) {
        if (stmt_is_null_value(arm.body)) {
            any_null = true;
        } else {
            if (!stmt_always_diverges(arm.body)) {
                return false;
            }
        }
        arm = arm.next;
    }
    any_null;
}

match_result_ty(arms: ?*MatchArm) noregion raises Error: ?*Type@new {
    t: ?*Type = ty_noreturn;
    t_null: bool = false;
    saw: int = 0;
    arm: ?*MatchArm = arms;
    while (arm != null) {
        at: ?*Type = stmt_result_ty(arm.body);
        an: bool = stmt_is_null_value(arm.body);
        if (saw == 0) {
            t = at;
            t_null = an;
        } else {
            t = unify_value_results(t, t_null, at, an);
            t_null = false;
            if (t == null) {
                t_null = true;
            }
        }
        saw = 1;
        arm = arm.next;
    }
    t;
}

stmt_result_ty(s: ?*Stmt) noregion raises Error: ?*Type@new {
    if (s == null) {
        return null;
    }
    match s.kind {
        ExprStmt k -> {
            decay(k.lhs.ty);
        }
        Return _p -> {
            ty_noreturn;
        }
        Raise _p -> {
            ty_noreturn;
        }
        Block k -> {
            stmt_result_ty(last_stmt(k.body));
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els == null) {
                return null;
            }
            unify_value_results(stmt_result_ty(k.then), stmt_is_null_value(k.then),
                stmt_result_ty(els), stmt_is_null_value(els));
        }
        Match k -> {
            match_result_ty(k.arms);
        }
        Try k -> {
            t: ?*Type = stmt_result_ty(k.body);
            t_null: bool = stmt_is_null_value(k.body);
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                t = unify_value_results(t, t_null, stmt_result_ty(arm.body), stmt_is_null_value(arm.body));
                t_null = false;
                if (t == null) {
                    t_null = true;
                }
                arm = arm.next;
            }
            t;
        }
        Region k -> {
            stmt_result_ty(k.body);
        }
        _ -> {
            null;
        }
    }
}

check_stmt_result(s: ?*Stmt, want: *Type@immortal) noregion raises Error: bool {
    if (s == null) {
        return false;
    }
    match s.kind {
        Return _p -> {
            true;
        }
        Raise _p -> {
            true;
        }
        ExprStmt k -> {
            lty: ?*Type = k.lhs.ty;
            if (lty != null && is_noreturn_ty(lty)) {
                return true;
            }
            if (assignable(want, k.lhs)) {
                check_return(k.lhs);
                return true;
            }
            error_have_expr_want("return type mismatch", k.lhs, want);
            false;
        }
        Block k -> {
            check_stmt_result(last_stmt(k.body), want);
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els == null) {
                return false;
            }
            if (!check_stmt_result(k.then, want)) {
                return false;
            }
            check_stmt_result(els, want);
        }
        Match k -> {
            if (k.arms == null) {
                return false;
            }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!check_stmt_result(arm.body, want)) {
                    return false;
                }
                arm = arm.next;
            }
            true;
        }
        Try k -> {
            if (!check_stmt_result(k.body, want)) {
                return false;
            }
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!check_stmt_result(arm2.body, want)) {
                    return false;
                }
                arm2 = arm2.next;
            }
            true;
        }
        Region k -> {
            check_stmt_result(k.body, want);
        }
        _ -> {
            false;
        }
    }
}

type_if_expr(
    p: *Expr@new,
    cond: *Expr@new,
    then: *Expr@new,
    els: *Expr@new
) noregion raises Error {
    add_type(cond);
    ct: ?*Type = decay(cond.ty);
    if (ct == null || !is_bool_ty(ct)) {
        error_ty("condition must be bool", ct);
    }
    save: ?*NarrowFrame = narrow_top;
    wsave: ?*WalkFrame = walk_top;
    narrow_push_ne_nulls(cond);
    walk_advance_cond(cond);
    add_type(then);
    narrow_reset(save);
    walk_reset(wsave);
    narrow_push_eq_nulls(cond);
    add_type(els);
    narrow_reset(save);
    walk_reset(wsave);
    tt: ?*Type = decay(then.ty);
    et: ?*Type = decay(els.ty);
    tn: bool = is_null_value_expr(then);
    en: bool = is_null_value_expr(els);
    if (tt == null && !tn && (et == null || !is_noreturn_ty(et))) {
        error("if expression branch must produce a value");
    }
    if (et == null && !en && (tt == null || !is_noreturn_ty(tt))) {
        error("if expression branch must produce a value");
    }
    p.ty = unify_value_results(tt, tn, et, en);
    if (p.ty == null) {
        if (tn || en) {
            return;
        }
        error("if expression branch must produce a value");
    }
    if (tn) {
        bind_null_to_pointer(p.ty, then);
    }
    if (en) {
        bind_null_to_pointer(p.ty, els);
    }
}

type_match_expr(p: *Expr@new, cond: *Expr@new, arms: ?*MatchArm) noregion raises Error {
    add_type(cond);
    arm: ?*MatchArm = arms;
    while (arm != null) {
        add_type_stmt(arm.body);
        arm = arm.next;
    }
    t: ?*Type = match_result_ty(arms);
    if (t == null) {
        if (match_arms_null_like(arms)) {
            p.ty = null;
            return;
        }
        error("match expression arm must produce a value");
    }
    p.ty = t;
}

type_block_expr(p: *Expr@new, body: ?*Stmt) noregion raises Error {
    s: ?*Stmt = body;
    while (s != null) {
        add_type_stmt(s);
        match s.kind {
            If k -> {
                if (k.els == null) {
                    if (stmt_always_diverges(k.then)) {
                        narrow_push_eq_nulls(k.cond);
                    }
                }
            }
            _ -> { }
        }
        s = s.next;
    }
    p.ty = stmt_result_ty(last_stmt(body));
}

add_type_expr(p: *Expr@new) noregion raises Error {
    match p.kind {
        Var q -> {
            if (count_var_use != 0) {
                mark_var_use(q.var);
            }
            p.ty = var_view_ty(q.var);
            return;
        }
        As q -> {
            add_type(q.lhs);
            check_as(q.lhs.ty, p.ty);
            return;
        }
        Trunc q -> {
            add_type(q.lhs);
            check_trunc(q.lhs.ty, p.ty);
            return;
        }
        New k -> {
            lhs: ?*Expr = k.lhs;
            add_type(lhs);
            if (lhs != null) {
                lht: ?*Type = decay(lhs.ty);
                if (lht == null) {
                    error_ty("array length must be int", lht);
                }
                if (!is_int_ty(lht)) {
                    error_ty("array length must be int", lht);
                }
                fill: ?*Expr = k.fill;
                if (fill == null) {
                    error("new T[n] requires an initial value (new T[n](v))");
                }
                add_type(fill);
                elem: *Type = type_base(p.ty or error("missing type"));
                if (!assignable(elem, fill)) {
                    error_have_expr_want("new T[n] fill type mismatch", fill, elem);
                }
                check_store(fill, life_heap);
            }
            add_type_field_inits_heap(k.inits);
            return;
        }
        StructLit k -> {
            add_type_field_inits(k.inits);
            return;
        }
        VariantLit k -> {
            add_type_field_inits(k.inits);
            return;
        }
        MemberAccess q -> {
            add_type(q.lhs);
            t0: ?*Type = decay(q.lhs.ty);
            if (t0 != null && is_opt_pointer(t0)) {
                error_ty("member access on optional pointer (use if (p != null) / while (p != null) to narrow)",
                    t0);
            }
            mem: *Member = q.member or error("internal");
            p.ty = mem.ty;
            return;
        }
        Sizeof k -> {
            add_type(k.e);
            p.ty = ty_int;
            return;
        }
        _ -> { }
    }
    if (p.ty != null) {
        return;
    }
    match p.kind {
        LogAnd q -> {
            type_log(p, q.lhs, q.rhs, 1);
            return;
        }
        LogOr q -> {
            type_log(p, q.lhs, q.rhs, 0);
            return;
        }
        OrElse q -> {
            type_or_else(p, q.lhs, q.rhs);
            return;
        }
        If q -> {
            type_if_expr(p, q.cond, q.then, q.els);
            return;
        }
        Match q -> {
            type_match_expr(p, q.cond, q.arms);
            return;
        }
        Block q -> {
            type_block_expr(p, q.body);
            return;
        }
        Num k -> {
            if (k.str_label != 0) {
                p.ty = slice_of(ty_i8);
                return;
            }
            p.ty = ty_int;
            return;
        }
        Index q -> {
            type_index_expr(p, q.lhs, q.idx);
            return;
        }
        Null -> {
            return;
        }
        Binary q -> {
            type_binary(p, q.op, q.lhs, q.rhs);
            return;
        }
        Not q -> {
            add_type(q.lhs);
            nt: ?*Type = decay(q.lhs.ty);
            if (nt == null) {
                error_ty("! requires bool", nt);
            }
            if (!is_bool_ty(nt)) {
                error_ty("! requires bool", nt);
            }
            p.ty = ty_bool;
            return;
        }
        Neg q -> {
            add_type(q.lhs);
            nt: ?*Type = decay(q.lhs.ty);
            if (nt == null) {
                error_ty("unary - requires int or i8", nt);
            }
            if (is_i8_ty(nt)) {
                p.ty = ty_i8;
                return;
            }
            if (!is_int_ty(nt)) {
                error_ty("unary - requires int or i8", nt);
            }
            p.ty = ty_int;
            return;
        }
        BitNot q -> {
            add_type(q.lhs);
            nt: ?*Type = decay(q.lhs.ty);
            if (nt == null) {
                error_ty("~ requires int or i8", nt);
            }
            if (is_i8_ty(nt)) {
                p.ty = ty_i8;
                return;
            }
            if (!is_int_ty(nt)) {
                error_ty("~ requires int or i8", nt);
            }
            p.ty = ty_int;
            return;
        }
        Assign q -> {
            match q.lhs.kind {
                Var _p -> {
                    saveu: int = count_var_use;
                    count_var_use = 0;
                    add_type(q.lhs);
                    count_var_use = saveu;
                }
                _ -> {
                    add_type(q.lhs);
                }
            }
            add_type(q.rhs);
            lt: ?*Type = null;
            storage: ?*Type = q.lhs.ty;
            match q.lhs.kind {
                Var vp -> {
                    var: ?*Obj = vp.var;
                    if (var != null) {
                        storage = var.ty;
                        lt = decay(var.ty);
                    } else {
                        lt = decay(q.lhs.ty);
                    }
                }
                _ -> {
                    lt = decay(q.lhs.ty);
                }
            }
            if (!assignable(lt, q.rhs)) {
                error_have_expr_want("assignment type mismatch", q.rhs, lt);
            }
            check_store(q.rhs, dest_life(q.lhs));
            if (is_tainted_expr(q.rhs)) {
                match q.lhs.kind {
                    Var vp -> {
                        dest: ?*Obj = vp.var;
                        if (dest == null) {
                            error("address of local cannot escape");
                        }
                        if (dest.is_local == 0) {
                            error("address of local cannot escape");
                        }
                        mark_tainted(dest);
                    }
                    _ -> { }
                }
            }
            match q.lhs.kind {
                Var vp2 -> {
                    vo: ?*Obj = vp2.var;
                    if (vo != null) {
                        vu: *Obj = vo;
                        if (vu.is_local != 0 && !is_current_param(vu)) {
                            if (type_has_pointers(vu.ty) || is_tainted_expr(q.rhs)) {
                                vu.life = life_meet(vu.life, expr_life(q.rhs));
                            }
                        }
                    }
                }
                _ -> { }
            }
            match q.lhs.kind {
                Var vp -> {
                    kill_var_facts(vp.var);
                    if (expr_is_zero_lit(q.rhs)) {
                        mark_zero_var(vp.var);
                    }
                }
                Index ik -> {
                    ilt: ?*Type = ik.lhs.ty;
                    if (ilt != null && is_zptr(ilt)) {
                        error("cannot assign through C-string index");
                    }
                }
                _ -> { }
            }
            p.ty = storage;
            return;
        }
        Addr q -> {
            add_type(q.lhs);
            match q.lhs.kind {
                Var vk -> {
                    vo: ?*Obj = vk.var;
                    if (vo != null) {
                        mark_addr_taken(vo);
                    }
                }
                Index ik -> {
                    ilt: ?*Type = ik.lhs.ty;
                    if (ilt != null && is_zptr(ilt)) {
                        p.ty = ilt;
                        return;
                    }
                    if (ilt != null && is_indexable(ilt)) {
                        p.ty = ptr_to(type_base(ilt));
                        return;
                    }
                }
                _ -> { }
            }
            aty: ?*Type = q.lhs.ty;
            p.ty = ptr_to(aty or error("missing type"));
            return;
        }
        Deref q -> {
            add_type(q.lhs);
            t: ?*Type = decay(q.lhs.ty);
            if (t == null) {
                error_ty("dereferencing non-pointer", t);
            }
            if (is_opt_pointer(t)) {
                error_ty("dereferencing optional pointer (use if (p != null) / while (p != null) to narrow)",
                    t);
            }
            if (is_pointer(t)) {
                p.ty = type_base(t);
            } else {
                error_ty("dereferencing non-pointer", t);
            }
            return;
        }
        Funcall q -> {
            a: ?*Expr = q.args;
            while (a != null) {
                add_type(a);
                a = a.next;
            }
            lenarg: ?*Expr = q.args;
            if (streq(q.funcname, "len")) {
                if (lenarg == null) {
                    error("len takes one argument");
                }
                if (lenarg.next != null) {
                    error("len takes one argument");
                }
                at: ?*Type = lenarg.ty;
                if (at != null && is_slice(at)) {
                    p.kind = ExprKind.Funcall { funcname: q.funcname, args: q.args, fn: null };
                    p.ty = ty_int;
                    return;
                }
                error_ty("len requires []T", at);
            }
            if (streq(q.funcname, "memcpy")) {
                check_memcpy_args(q.args);
                p.kind = ExprKind.Funcall { funcname: q.funcname, args: q.args, fn: null };
                p.ty = ty_int;
                return;
            }
            if (streq(q.funcname, "write") || streq(q.funcname, "read")) {
                check_io_args(q.funcname, q.args);
                p.kind = ExprKind.Funcall { funcname: q.funcname, args: q.args, fn: null };
                p.ty = ty_int;
                return;
            }
            fno: ?*Function = find_function(q.funcname);
            if (fno == null) {
                sb: *StrBuf = sb_new();
                sb_puts(sb, "unknown function ");
                sb_puts(sb, q.funcname);
                error(sb_finish(sb));
            }
            fnu: *Function = fno;
            check_call_lifetimes(fnu, q.args);
            p.kind = ExprKind.Funcall { funcname: q.funcname, args: q.args, fn: fnu };
            add_callee(fnu);
            if (fnu.return_ty != null) {
                p.ty = fnu.return_ty;
            } else {
                p.ty = ty_int;
            }
            na: int = 0;
            a = q.args;
            while (a != null) {
                na = na + 1;
                a = a.next;
            }
            if (na != fnu.nparams) {
                error("wrong number of arguments");
            }
            a = q.args;
            po: ?*Obj = fnu.params;
            while (a != null) {
                if (po != null) {
                    if (po.ty != null) {
                        pt: ?*Type = decay(po.ty);
                        if (!assignable(pt, a)) {
                            error_have_expr_want("argument type mismatch", a, pt);
                        }
                    }
                    po = po.param_next;
                }
                a = a.next;
            }
            er: ?*ExnList = fnu.raises_list;
            while (er != null) {
                check_exn_allowed(er.exn, "call raises");
                er = er.next;
            }
            return;
        }
        _ -> { }
    }
}

add_type_stmt_node(p: *Stmt) noregion raises Error {
    match p.kind {
        If k -> {
            add_type(k.cond);
            ct: ?*Type = decay(k.cond.ty);
            if (ct == null || !is_bool_ty(ct)) {
                error_ty("condition must be bool", ct);
            }
            save: ?*NarrowFrame = narrow_top;
            wsave: ?*WalkFrame = walk_top;
            narrow_push_ne_nulls(k.cond);
            walk_advance_cond(k.cond);
            add_type_stmt(k.then);
            narrow_reset(save);
            walk_reset(wsave);
            els: ?*Stmt = k.els;
            if (els != null) {
                narrow_push_eq_nulls(k.cond);
                add_type_stmt(els);
                narrow_reset(save);
                walk_reset(wsave);
            }
            return;
        }
        While k -> {
            add_type(k.cond);
            ct2: ?*Type = decay(k.cond.ty);
            if (ct2 == null || !is_bool_ty(ct2)) {
                error_ty("condition must be bool", ct2);
            }
            save2: ?*NarrowFrame = narrow_top;
            wsave2: ?*WalkFrame = walk_top;
            narrow_push_ne_nulls(k.cond);
            walk_advance_cond(k.cond);
            add_type_stmt(k.body);
            narrow_reset(save2);
            walk_reset(wsave2);
            return;
        }
        For k -> {
            add_type(k.iter);
            hk: ?*Expr = k.hi;
            if (hk != null) {
                add_type(hk);
                lt: ?*Type = decay(k.iter.ty);
                rt: ?*Type = decay(hk.ty);
                if (lt == null || !is_int_ty(lt)) {
                    error_ty("range start must be int", lt);
                }
                if (rt == null || !is_int_ty(rt)) {
                    error_ty("range end must be int", rt);
                }
                k.item.ty = ty_int;
                hu: *Expr = hk;
                add_type_stmt(k.body);
                add_type_stmt(new_expr_stmt(new_assign(new_var_node(k.item), k.iter)));
                add_type_stmt(new_expr_stmt(new_assign(new_var_node(k.n), hu)));
                return;
            }
            it: ?*Type = decay(k.iter.ty);
            if (it == null || !is_slice(it)) {
                error_ty("for requires a counted array ([]T) or int range (a..b)",
                    it);
            }
            itu: *Type = it;
            co: ?*Obj = k.coll;
            ix: ?*Obj = k.idx;
            if (co == null || ix == null) {
                error("internal: for array missing temps");
            }
            cu: *Obj = co;
            iu: *Obj = ix;
            cu.ty = itu;
            k.item.ty = type_base(itu);
            add_type_stmt(k.body);
            add_type_stmt(new_expr_stmt(new_assign(new_var_node(cu), k.iter)));
            add_type_stmt(new_expr_stmt(new_assign(new_var_node(k.n), new_funcall("len",
                new_var_node(cu)))));
            add_type_stmt(new_expr_stmt(new_assign(new_var_node(k.item), new_index(new_var_node(cu),
                new_var_node(iu)))));
            return;
        }
        Try k -> {
            saved_c: ?*CatchFrame = catch_top;
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                catch_push(arm.exn or error("internal"));
                arm = arm.next;
            }
            add_type_stmt(k.body);
            catch_reset(saved_c);
            arm = k.arms;
            while (arm != null) {
                add_type_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Raise k -> {
            check_exn_allowed(k.exn or error("internal"), "raise");
            add_type_field_inits_opt(k.inits, 2);
            return;
        }
        Block q -> {
            a: ?*Stmt = q.body;
            while (a != null) {
                add_type_stmt(a);
                match a.kind {
                    If k -> {
                        if (k.els == null) {
                            if (stmt_always_diverges(k.then)) {
                                narrow_push_eq_nulls(k.cond);
                            }
                        }
                    }
                    _ -> { }
                }
                a = a.next;
            }
            return;
        }
        Return k -> {
            crt: ?*Type = current_return_ty;
            if (crt != null && is_noreturn_ty(crt)) {
                error("noreturn function cannot return");
            }
            lhs: ?*Expr = k.lhs;
            add_type(lhs);
            if (lhs != null) {
                if (current_return_ty == null) {
                    error("return with a value in a non-returning function");
                }
                rt: ?*Type = decay(current_return_ty);
                if (!assignable(rt, lhs)) {
                    error_have_expr_want("return type mismatch", lhs, rt);
                }
                check_return(lhs);
            } else {
                if (current_return_ty != null) {
                    error_ty("return missing a value", current_return_ty);
                }
            }
            return;
        }
        ExprStmt k -> {
            add_type(k.lhs);
            return;
        }
        Match k -> {
            add_type(k.cond);
            a5: ?*MatchArm = k.arms;
            while (a5 != null) {
                add_type_stmt(a5.body);
                a5 = a5.next;
            }
            return;
        }
        Region k -> {
            old_cur: int = life_cur;
            old_heap: int = life_heap;
            _rf: int = life_enter_region();
            add_type_stmt(k.body);
            life_leave_region(old_cur, old_heap);
            return;
        }
        Decl k -> {
            vo: ?*Obj = k.var;
            init: ?*Expr = k.init;
            if (init != null && vo != null) {
                add_type(new_assign(new_var_node(vo), init));
            }
            return;
        }
        _ -> { }
    }
}

parse_mul() noregion raises Error: *Expr@new {
    n: *Expr = parse_unary();
    while (true) {
        if (tok.kind == TokKind.Star) {
            tok = tok.next;
            n = new_binary(BinOp.Mul, n, parse_unary());
        } else if (tok.kind == TokKind.Slash) {
            tok = tok.next;
            n = new_binary(BinOp.Div, n, parse_unary());
        } else if (tok.kind == TokKind.Percent) {
            tok = tok.next;
            n = new_binary(BinOp.Mod, n, parse_unary());
        } else {
            return n;
        }
    }
    n;
}

parse_add() noregion raises Error: *Expr@new {
    n: *Expr = parse_mul();
    while (true) {
        if (tok.kind == TokKind.Plus) {
            tok = tok.next;
            n = new_binary(BinOp.Add, n, parse_mul());
        } else if (tok.kind == TokKind.Minus) {
            tok = tok.next;
            n = new_binary(BinOp.Sub, n, parse_mul());
        } else {
            return n;
        }
    }
    n;
}

parse_shift() noregion raises Error: *Expr@new {
    n: *Expr = parse_add();
    while (true) {
        if (tok.kind == TokKind.Shl) {
            tok = tok.next;
            n = new_binary(BinOp.Shl, n, parse_add());
        } else if (tok.kind == TokKind.Shr) {
            tok = tok.next;
            n = new_binary(BinOp.Shr, n, parse_add());
        } else {
            return n;
        }
    }
    n;
}

parse_relational() noregion raises Error: *Expr@new {
    n: *Expr = parse_shift();
    while (true) {
        if (tok.kind == TokKind.Lt) {
            tok = tok.next;
            n = new_binary(BinOp.Lt, n, parse_shift());
        } else if (tok.kind == TokKind.Gt) {
            tok = tok.next;
            n = new_binary(BinOp.Gt, n, parse_shift());
        } else if (tok.kind == TokKind.Le) {
            tok = tok.next;
            n = new_binary(BinOp.Le, n, parse_shift());
        } else if (tok.kind == TokKind.Ge) {
            tok = tok.next;
            n = new_binary(BinOp.Ge, n, parse_shift());
        } else {
            return n;
        }
    }
    n;
}

parse_equality() noregion raises Error: *Expr@new {
    n: *Expr = parse_relational();
    while (true) {
        if (tok.kind == TokKind.Eq) {
            tok = tok.next;
            n = new_binary(BinOp.Eq, n, parse_relational());
        } else if (tok.kind == TokKind.Ne) {
            tok = tok.next;
            n = new_binary(BinOp.Ne, n, parse_relational());
        } else {
            return n;
        }
    }
    n;
}

parse_bitand() noregion raises Error: *Expr@new {
    n: *Expr = parse_equality();
    while (tok.kind == TokKind.Amp) {
        tok = tok.next;
        n = new_binary(BinOp.And, n, parse_equality());
    }
    n;
}

parse_bitxor() noregion raises Error: *Expr@new {
    n: *Expr = parse_bitand();
    while (tok.kind == TokKind.Caret) {
        tok = tok.next;
        n = new_binary(BinOp.Xor, n, parse_bitand());
    }
    n;
}

parse_bitor() noregion raises Error: *Expr@new {
    n: *Expr = parse_bitxor();
    while (tok.kind == TokKind.Pipe) {
        tok = tok.next;
        n = new_binary(BinOp.Or, n, parse_bitxor());
    }
    n;
}

parse_logand() noregion raises Error: *Expr@new {
    n: *Expr = parse_bitor();
    while (tok.kind == TokKind.And) {
        tok = tok.next;
        n = new_logand(n, parse_bitor());
    }
    n;
}

parse_logor() noregion raises Error: *Expr@new {
    n: *Expr = parse_logand();
    while (tok.kind == TokKind.Or) {
        tok = tok.next;
        n = new_logor(n, parse_logand());
    }
    n;
}

parse_or_else() noregion raises Error: *Expr@new {
    n: *Expr = parse_logor();
    if (tok.kind == TokKind.OrKw) {
        tok = tok.next;
        return new_or_else(n, parse_or_else());
    }
    n;
}

parse_assign() noregion raises Error: *Expr@new {
    n: *Expr = parse_or_else();
    if (tok.kind == TokKind.Assign) {
        tok = tok.next;
        return new_assign(n, parse_assign());
    }
    n;
}

parse_at_bound() noregion raises Error: []i8@new {
    skip(TokKind.At);
    if (tok.kind == TokKind.New) {
        tok = tok.next;
        return "new";
    }
    if (tok.kind == TokKind.Ident) {
        if (streq(cur_tokstr(), "immortal")) {
            tok = tok.next;
            return "immortal";
        }
        s: []i8 = cur_tokstr();
        tok = tok.next;
        return s;
    }
    error("expected lifetime bound after @");
    "";
}

parse_decl(is_local: int, allow_at: int) noregion raises Error: *Obj@new {
    if (tok.kind != TokKind.Ident) {
        error("expected identifier");
    }
    name: []i8 = cur_tokstr();
    browse_note();
    tok = tok.next;
    skip(TokKind.Colon);
    ty: *Type = parse_type();
    if (is_noreturn_ty(ty)) {
        error("noreturn is only valid as a function return type");
    }
    bound: []i8 = "";
    if (tok.kind == TokKind.At) {
        if (allow_at == 0) {
            error("@ is only valid on parameters and returns");
        }
        tok = tok.next;
        if (tok.kind == TokKind.New) {
            tok = tok.next;
            bound = "new";
        } else if (tok.kind == TokKind.Ident) {
            bound = cur_tokstr();
            tok = tok.next;
        } else {
            bound = name;
        }
    }
    o: *Obj = new_obj(name, is_local);
    o.ty = ty;
    o.life_bound = bound;
    o;
}

parse_compound() noregion raises Error: *Stmt@new {
    s: *Stmt = new_block(parse_brace_stmts());
    s.end = last_close_pos;
    s;
}

parse_brace_stmts() noregion raises Error: ?*Stmt@new {
    enter_scope();
    skip(TokKind.LBrace);
    head: ?*Stmt = null;
    cur: ?*Stmt = null;
    while (tok.kind != TokKind.RBrace) {
        if (tok.kind == TokKind.Eof) {
            error("unterminated block");
        }
        s: *Stmt = parse_stmt();
        if (cur != null) {
            cur.next = s;
            cur = s;
        } else {
            head = s;
            cur = s;
        }
    }
    last_close_pos = tok.pos;
    skip(TokKind.RBrace);
    leave_scope();
    head;
}

parse_stmt() noregion raises Error: *Stmt@new {
    spos: int = tok.pos;
    s: *Stmt = parse_stmt_body();
    s.pos = spos;
    s;
}

parse_stmt_body() noregion raises Error: *Stmt@new {
    if (tok.kind == TokKind.Return) {
        tok = tok.next;
        lhs: ?*Expr = null;
        if (tok.kind != TokKind.Semi) {
            lhs = parse_expr();
        }
        skip(TokKind.Semi);
        return new_return(lhs);
    }
    if (tok.kind == TokKind.Raise) {
        tok = tok.next;
        if (tok.kind != TokKind.Ident) {
            error("expected exception name after raise");
        }
        ename: []i8 = cur_tokstr();
        browse_note();
        ed: ?*ExnDef = find_exn(ename);
        if (ed == null) {
            if (parse_resolve != 0) {
                error("unknown exception");
            }
            ed = exn_stub(ename);
        }
        edu: *ExnDef = ed or error("unknown exception");
        browse_add(browse_tok_file, browse_tok_pos, browse_tok_len, edu.browse_id,
            0, BROWSE_TY, ename);
        tok = tok.next;
        rargs: ?*FieldInit = null;
        rhas: int = 0;
        if (tok.kind == TokKind.LBrace) {
            rargs = parse_exn_field_inits(edu);
            rhas = 1;
        } else {
            if (edu.members != null) {
                error("exception requires field initializers");
            }
        }
        skip(TokKind.Semi);
        return new_raise(ename, edu, rargs, rhas);
    }
    if (tok.kind == TokKind.Try) {
        tok = tok.next;
        tbody: *Stmt = parse_compound();
        arms_h: ?*CatchArm = null;
        arms_c: ?*CatchArm = null;
        if (tok.kind != TokKind.With) {
            error("try requires at least one with arm");
        }
        while (tok.kind == TokKind.With) {
            tok = tok.next;
            if (tok.kind != TokKind.Ident) {
                error("expected exception name in with arm");
            }
            cname: []i8 = cur_tokstr();
            browse_note();
            ced: ?*ExnDef = find_exn(cname);
            if (ced == null) {
                if (parse_resolve != 0) {
                    error("unknown exception");
                }
                ced = exn_stub(cname);
            }
            cedu: *ExnDef = ced or error("unknown exception");
            cpos: int = browse_tok_pos;
            clen: int = browse_tok_len;
            cfile: int = browse_tok_file;
            browse_add(cfile, cpos, clen, cedu.browse_id, 0, BROWSE_TY, cname);
            tok = tok.next;
            a: ?*CatchArm = arms_h;
            while (a != null) {
                if (a.exn == cedu) {
                    error("duplicate with arm");
                }
                a = a.next;
            }
            enter_scope();
            cparen: int = 0;
            binder: ?*Obj = null;
            if (tok.kind == TokKind.LParen) {
                /* Legacy Name(x); prefer Name x. */
                tok = tok.next;
                if (tok.kind != TokKind.Ident) {
                    error("expected binder name");
                }
                bname: []i8 = cur_tokstr();
                browse_note();
                tok = tok.next;
                skip(TokKind.RParen);
                bo: *Obj = new_obj(bname, 1);
                bo.ty = exn_type(cedu);
                binder = bo;
                cparen = 1;
            } else {
                if (tok.kind == TokKind.Ident) {
                    bname2: []i8 = cur_tokstr();
                    browse_note();
                    tok = tok.next;
                    bo2: *Obj = new_obj(bname2, 1);
                    bo2.ty = exn_type(cedu);
                    binder = bo2;
                } else {
                    if (cedu.members != null) {
                        error("payload exception requires a binder (Name name)");
                    }
                }
            }
            skip(TokKind.Arrow);
            abody: *Stmt = parse_compound();
            leave_scope();
            bnm: []i8 = "";
            if (binder != null) {
                bnm = binder.name;
            }
            armn: *CatchArm = new_catch_arm(cname, cedu, binder, bnm, cparen, abody);
            armn.pos = cpos;
            armn.file = cfile;
            armn.toklen = clen;
            if (arms_c != null) {
                arms_c.next = armn;
                arms_c = armn;
            } else {
                arms_h = armn;
                arms_c = armn;
            }
        }
        buf: *Obj = new_obj(".trybuf", 1);
        buf.ty = ty_jmpbuf;
        return new_try(tbody, arms_h, buf);
    }
    if (tok.kind == TokKind.Region) {
        tok = tok.next;
        mark: *Obj = new_obj(".hmark", 1);
        mark.ty = ty_int;
        region_depth = region_depth + 1;
        rbody: *Stmt = parse_compound();
        region_depth = region_depth - 1;
        return new_region(rbody, mark);
    }
    if (tok.kind == TokKind.If) {
        tok = tok.next;
        skip(TokKind.LParen);
        cond: *Expr = parse_expr();
        skip(TokKind.RParen);
        save: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(cond);
        then: *Stmt = parse_stmt();
        narrow_reset(save);
        els: ?*Stmt = null;
        if (tok.kind == TokKind.Else) {
            tok = tok.next;
            narrow_push_eq_nulls(cond);
            els = parse_stmt();
            narrow_reset(save);
        } else {
            /* if (x == null) { return/error/...; } → x is non-null afterward */
            if (stmt_parse_diverges(then)) {
                narrow_push_eq_nulls(cond);
            }
        }
        return new_if(cond, then, els);
    }
    if (tok.kind == TokKind.While) {
        tok = tok.next;
        skip(TokKind.LParen);
        cond2: *Expr = parse_expr();
        skip(TokKind.RParen);
        save2: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(cond2);
        body: *Stmt = parse_stmt();
        narrow_reset(save2);
        return new_while(cond2, body);
    }
    if (tok.kind == TokKind.For) {
        tok = tok.next;
        if (tok.kind != TokKind.Ident) {
            error("expected name after for");
        }
        iname: []i8 = cur_tokstr();
        ipos: int = tok.pos;
        ilen: int = tok.len;
        ifile: int = current_file_id;
        tok = tok.next;
        if (tok.kind != TokKind.In) {
            error("expected in");
        }
        tok = tok.next;
        fiter: *Expr = parse_expr();
        fhi: ?*Expr = null;
        if (tok.kind == TokKind.DotDot) {
            tok = tok.next;
            fhi = parse_expr();
        }
        enter_scope();
        fcoll: ?*Obj = null;
        fidx: ?*Obj = null;
        fn: *Obj = new_obj(".forn", 1);
        fn.ty = ty_int;
        if (fhi == null) {
            fcoll = new_obj(".forxs", 1);
            ix0: *Obj = new_obj(".fori", 1);
            ix0.ty = ty_int;
            fidx = ix0;
        }
        fitem: *Obj = new_obj(iname, 1);
        fitem.browse_pos = ipos;
        fitem.browse_file = ifile;
        fitem.browse_len = ilen;
        if (fhi != null) {
            fitem.ty = ty_int;
        }
        fbody: *Stmt = parse_stmt();
        leave_scope();
        return new_for(fitem, fcoll, fidx, fn, fiter, fhi, fbody);
    }
    if (tok.kind == TokKind.Match) {
        tok = tok.next;
        mcond: *Expr = parse_expr();
        return new_match(mcond, parse_match_arms(mcond));
    }
    if (tok.kind == TokKind.LBrace) {
        return parse_compound();
    }
    if (tok.kind == TokKind.Ident && tok.next.kind == TokKind.Colon) {
        o: *Obj = parse_decl(1, 0);
        if (tok.kind == TokKind.Comma) {
            error("only one variable per declaration");
        }
        dty: *Type = o.ty or error("missing type");
        if (tok.kind == TokKind.Assign) {
            tok = tok.next;
            rhs: *Expr = parse_expr();
            skip(TokKind.Semi);
            return new_decl(o.name, dty, rhs, o);
        }
        skip(TokKind.Semi);
        return new_decl(o.name, dty, null, o);
    }
    e: *Expr = parse_expr();
    skip(TokKind.Semi);
    new_expr_stmt(e);
}

fn_param(fn: *Function, i: int): ?*Obj@fn {
    p: ?*Obj = fn.params;
    n: int = 0;
    while (p != null) {
        if (n == i) {
            return p;
        }
        n = n + 1;
        p = p.param_next;
    }
    null;
}

append_fn_param(fn: *Function, p: *Obj@fn) {
    p.param_next = null;
    if (fn.params == null) {
        fn.params = p;
        return;
    }
    cur: ?*Obj = fn.params;
    while (cur != null) {
        if (cur.param_next == null) {
            cur.param_next = p;
            return;
        }
        cur = cur.param_next;
    }
}

parse_function(name: []i8@new, is_extern: int) noregion raises Error: *Function@new {
    fn: *Function = new Function {
        name: name,
        nparams: 0,
        params: null,
        locals: null,
        body: null,
        stack_size: 0,
        return_ty: null,
        sret: null,
        raises_list: null,
        used: 0,
        is_extern: 0,
        next: null,
        hash_next: null,
        ret_bound: "",
        ret_life: 0,
        need_imm_heap: 0,
        imm_heap_direct: 0,
        decl_imm_heap: 0,
        bound_ret_need_new: 0,
        bound_ret_param: null,
        bound_calls: null,
        callees: null,
        browse_id: browse_fresh(),
        browse_pos: browse_tok_pos,
        browse_file: browse_tok_file,
        browse_len: browse_tok_len,
        lead: null,
        trail: null
    };
    locals = null;
    scope_locals = null;
    scope_depth = 0;
    region_depth = 0;
    narrow_top = null;
    catch_top = null;
    current_fn = fn;
    skip(TokKind.LParen);
    np: int = 0;
    while (tok.kind != TokKind.RParen) {
        if (np != 0) {
            skip(TokKind.Comma);
        }
        p: *Obj = parse_decl(1, 1);
        append_fn_param(fn, p);
        np = np + 1;
    }
    fn.nparams = np;
    skip(TokKind.RParen);
    if (tok.kind == TokKind.Ident && streq(cur_tokstr(), "noregion")) {
        tok = tok.next;
        fn.decl_imm_heap = 1;
    } else if (tok.kind == TokKind.At) {
        error("function mark is noregion");
    }
    if (tok.kind == TokKind.Raises) {
        if (is_extern != 0) {
            error("extern function cannot raise");
        }
        tok = tok.next;
        rtail: ?*ExnList = null;
        rdone: int = 0;
        while (rdone == 0) {
            if (tok.kind != TokKind.Ident) {
                error("expected exception type after raises");
            }
            ename: []i8 = cur_tokstr();
            browse_note();
            ed: ?*ExnDef = find_exn(ename);
            if (ed == null) {
                if (parse_resolve != 0) {
                    error("unknown exception");
                }
                ed = exn_stub(ename);
            }
            edu: *ExnDef = ed or error("unknown exception");
            browse_add(browse_tok_file, browse_tok_pos, browse_tok_len, edu.browse_id,
                0, BROWSE_TY, ename);
            if (exn_in_list(fn.raises_list, edu)) {
                error("duplicate raises");
            }
            el: *ExnList = new ExnList { exn: edu, seen: 0, next: null };
            if (rtail != null) {
                rtail.next = el;
                rtail = el;
            } else {
                fn.raises_list = el;
                rtail = el;
            }
            tok = tok.next;
            if (tok.kind == TokKind.Comma) {
                tok = tok.next;
            } else {
                rdone = 1;
            }
        }
    }
    if (tok.kind == TokKind.Colon) {
        tok = tok.next;
        fn.return_ty = parse_type();
        if (tok.kind == TokKind.At) {
            fn.ret_bound = parse_at_bound();
        }
    }
    rt: ?*Type = fn.return_ty;
    if (is_extern != 0) {
        fn.is_extern = 1;
        if (fn.return_ty == null) {
            error("extern function requires a return type");
        }
        if (rt != null && passes_by_ref(rt)) {
            error("extern function cannot return a large aggregate");
        }
        if (tok.kind == TokKind.LBrace) {
            error("extern function cannot have a body");
        }
        skip(TokKind.Semi);
        fn.locals = locals;
        narrow_top = null;
        catch_top = null;
        current_fn = null;
        return fn;
    }
    if (rt != null && passes_by_ref(rt)) {
        sret: *Obj = new_obj(".sret", 1);
        sret.ty = ptr_to(rt);
        fn.sret = sret;
    }
    fn.body = parse_compound();
    fn.locals = locals;
    narrow_top = null;
    catch_top = null;
    current_fn = null;
    fn;
}

parse_field_list(base_offset: int) noregion raises Error: *Member {
    head: ?*Member = null;
    cur: ?*Member = null;
    offset: int = base_offset;
    while (tok.kind != TokKind.RBrace) {
        if (tok.kind != TokKind.Ident) {
            error("expected field name");
        }
        mname: []i8 = cur_tokstr();
        browse_note();
        tok = tok.next;
        skip(TokKind.Colon);
        mty: *Type = parse_type();
        if (is_noreturn_ty(mty)) {
            error("noreturn cannot be a field type");
        }
        m: *Member = new Member {
            name: mname,
            offset: offset,
            ty: mty,
            next: null,
            lead: null,
            trail: null,
            browse_id: browse_fresh(),
            browse_pos: browse_tok_pos,
            browse_file: browse_tok_file,
            browse_len: browse_tok_len
        };
        sz: int = type_size(mty);
        if (sz <= 0) {
            sz = 8;
        }
        offset = offset + (sz + 7 & 0 - 8);
        if (cur != null) {
            cur.next = m;
            cur = m;
        } else {
            head = m;
            cur = m;
        }
        if (tok.kind == TokKind.Semi || tok.kind == TokKind.Comma) {
            tok = tok.next;
        } else {
            if (tok.kind != TokKind.RBrace) {
                error("expected `;`, `,`, or `}` after field");
            }
        }
    }
    field_list_size = offset - base_offset;
    tok = tok.next;
    head or error("empty members");
}

parse_variant(tag: int, enum_name: []i8) noregion raises Error: *Variant@new {
    if (tok.kind != TokKind.Ident) {
        error("expected variant name");
    }
    v: *Variant = new Variant {
        name: cur_tokstr(),
        tag: tag,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        next: null,
        lead: null,
        trail: null,
        browse_id: browse_fresh(),
        browse_pos: tok.pos,
        browse_file: current_file_id,
        browse_len: tok.len
    };
    tok = tok.next;
    if (tok.kind == TokKind.LBrace) {
        tok = tok.next;
        v.fields = parse_field_list(0);
        v.payload_size = field_list_size;
        sd: *StructDef = new StructDef {
            name: variant_payload_name(enum_name, v.name),
            members: v.fields,
            size: field_list_size,
            ty: null,
            next: null,
            hash_next: null,
            ptr_walk: 0,
            lead: null,
            trail: null,
            browse_id: 0,
            browse_pos: 0,
            browse_file: 0,
            browse_len: 0
        };
        v.payload_ty = struct_type(sd);
    }
    v;
}

parse_exception_def() noregion raises Error {
    tok = tok.next;
    if (tok.kind != TokKind.Ident) {
        error("expected exception name");
    }
    name: []i8 = cur_tokstr();
    browse_note();
    tok = tok.next;
    if (find_exn(name) != null || find_struct(name) != null || find_enum(name) != null) {
        error("redefinition");
    }
    ed: *ExnDef = new ExnDef {
        name: name,
        tag: next_exn_tag,
        members: null,
        size: 0,
        ty: null,
        next: exn_defs,
        hash_next: null,
        lead: null,
        trail: null,
        browse_id: browse_fresh(),
        browse_pos: browse_tok_pos,
        browse_file: browse_tok_file,
        browse_len: browse_tok_len
    };
    next_exn_tag = next_exn_tag + 1;
    exn_defs = ed;
    hash_put_exn(ed);
    if (tok.kind == TokKind.LBrace) {
        tok = tok.next;
        ed.members = parse_field_list(0);
        ed.size = field_list_size;
        skip_optional_semi();
    } else {
        skip(TokKind.Semi);
    }
    exn_type(ed);
    append_item(new_item(ItemKind.Exn { def: ed }, ed.browse_pos));
}

parse_type_def() noregion raises Error {
    tok = tok.next;
    if (tok.kind != TokKind.Ident) {
        error("expected type name");
    }
    name: []i8 = cur_tokstr();
    browse_note();
    npos: int = browse_tok_pos;
    nlen: int = browse_tok_len;
    nfile: int = browse_tok_file;
    tok = tok.next;
    skip(TokKind.Assign);
    if (tok.kind == TokKind.LBrace) {
        if (find_enum(name) != null) {
            error("redefinition of type");
        }
        sd: *StructDef = get_or_create_struct(name);
        sd.browse_pos = npos;
        sd.browse_file = nfile;
        sd.browse_len = nlen;
        if (sd.members != null) {
            error("redefinition of type");
        }
        tok = tok.next;
        sd.members = parse_field_list(0);
        sd.size = field_list_size;
        skip_optional_semi();
        append_item(new_item(ItemKind.Struct { def: sd }, npos));
        return;
    }
    stub: ?*StructDef = find_struct(name);
    if (stub != null) {
        if (stub.members != null) {
            error("redefinition of type");
        }
        remove_struct(name);
    }
    ed: *EnumDef = get_or_create_enum(name);
    ed.browse_pos = npos;
    ed.browse_file = nfile;
    ed.browse_len = nlen;
    if (ed.variants != null) {
        error("redefinition of type");
    }
    if (tok.kind == TokKind.Pipe) {
        tok = tok.next;
    }
    head: ?*Variant = null;
    cur: ?*Variant = null;
    tag: int = 0;
    max_payload: int = 0;
    done: int = 0;
    while (done == 0) {
        v: *Variant = parse_variant(tag, name);
        x: ?*Variant = head;
        while (x != null) {
            if (streq(x.name, v.name)) {
                error("duplicate variant");
            }
            x = x.next;
        }
        if (v.payload_size > max_payload) {
            max_payload = v.payload_size;
        }
        if (cur != null) {
            cur.next = v;
            cur = v;
        } else {
            head = v;
            cur = v;
        }
        tag = tag + 1;
        if (tok.kind == TokKind.Pipe) {
            tok = tok.next;
        } else {
            done = 1;
        }
    }
    if (head == null) {
        error("enum type needs at least one variant");
    }
    ed.variants = head;
    ed.size = 8 + max_payload;
    if (stub != null) {
        if (stub.ty != null) {
            rebind_struct_stub_to_enum(stub, ed);
        }
    }
    skip(TokKind.Semi);
    append_item(new_item(ItemKind.Enum { def: ed }, npos));
}

parse_source_file(path: []i8@immortal, keep_items: int) noregion raises Error {
    if (!mark_imported(path)) {
        return;
    }
    f: ?*ImportedFile = imported_files;
    saved_source: []i8 = source;
    saved_source_len: int = source_len;
    saved_pos: int = pos;
    saved_tok: *Token = tok;
    saved_path: []i8 = source_path;
    saved_file: int = current_file_id;
    saved_items: ?*Item = file_items;
    saved_items_tail: ?*Item = file_items_tail;
    saved_coms: ?*Com = file_coms;
    saved_coms_tail: ?*Com = file_coms_tail;
    saved_trail: ?*Com = file_trail;
    file_items = null;
    file_items_tail = null;
    source_path = path;
    source = read_file(path);
    if (f != null) {
        f.src = source;
        f.src_len = source_len;
        current_file_id = f.id;
    }
    tok = tokenize();
    parse_program_unit();
    attach_parsed_file();
    kept_items: ?*Item = file_items;
    kept_tail: ?*Item = file_items_tail;
    source = saved_source;
    source_len = saved_source_len;
    pos = saved_pos;
    tok = saved_tok;
    source_path = saved_path;
    current_file_id = saved_file;
    file_coms = saved_coms;
    file_coms_tail = saved_coms_tail;
    if (keep_items != 0) {
        file_items = kept_items;
        file_items_tail = kept_tail;
    } else {
        file_items = saved_items;
        file_items_tail = saved_items_tail;
        file_trail = saved_trail;
    }
}

parse_import() noregion raises Error {
    ipos: int = tok.pos;
    tok = tok.next;
    if (tok.kind != TokKind.Str) {
        error("expected string path after import");
    }
    relative: []i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Semi);
    append_item(new_item(ItemKind.Import { path: relative, tag: 0 }, ipos));
    if (parse_follow_imports != 0) {
        path: []i8 = resolve_import_path(source_path, relative);
        parse_source_file(path, 0);
    }
}

is_builtin_fname(name: []i8): bool {
    streq(name, "len") || streq(name, "memcpy") || streq(name, "write") || streq(name,
        "read");
}

bind_function(name: []i8@new, fn: *Function@immortal) noregion raises Error {
    if (is_builtin_fname(name)) {
        error("cannot declare a builtin as a function");
    }
    if (find_function(name) != null) {
        sb: *StrBuf = sb_new();
        sb_puts(sb, "duplicate function ");
        sb_puts(sb, name);
        error(sb_finish(sb));
    }
    append_function(fn);
    hash_put_fn(fn);
    o: *Obj = new_obj(name, 0);
    o.is_func = 1;
    o.ty = fn.return_ty;
    o.browse_id = fn.browse_id;
    o.browse_pos = fn.browse_pos;
    o.browse_file = fn.browse_file;
    o.browse_len = fn.browse_len;
}

append_function(fn: *Function@immortal) {
    tail: ?*Function = function_tail;
    if (tail != null) {
        tail.next = fn;
        function_tail = fn;
    } else {
        functions = fn;
        function_tail = fn;
    }
}

parse_program_unit() noregion raises Error {
    while (tok.kind != TokKind.Eof) {
        if (tok.kind == TokKind.Import) {
            parse_import();
        } else if (tok.kind == TokKind.TypeKw && tok.next.kind == TokKind.Ident && tok.next.next.kind == TokKind.Assign) {
            parse_type_def();
        } else {
            if (tok.kind == TokKind.Exception) {
                parse_exception_def();
            } else {
                if (tok.kind == TokKind.Extern) {
                    tok = tok.next;
                    if (tok.kind != TokKind.Ident) {
                        error("expected function name after extern");
                    }
                    ename: []i8 = cur_tokstr();
                    browse_note();
                    tok = tok.next;
                    if (tok.kind != TokKind.LParen) {
                        error("expected `(` after extern name");
                    }
                    efn: *Function = parse_function(ename, 1);
                    bind_function(ename, efn);
                    append_item(new_item(ItemKind.Func { fn: efn }, efn.browse_pos));
                } else {
                    if (tok.kind != TokKind.Ident) {
                        error("expected identifier");
                    }
                    name: []i8 = cur_tokstr();
                    browse_note();
                    gpos: int = browse_tok_pos;
                    glen: int = browse_tok_len;
                    gfile: int = browse_tok_file;
                    tok = tok.next;
                    if (tok.kind == TokKind.LParen) {
                        fn: *Function = parse_function(name, 0);
                        bind_function(name, fn);
                        append_item(new_item(ItemKind.Func { fn: fn }, fn.browse_pos));
                    } else {
                        skip(TokKind.Colon);
                        ty: *Type = parse_type();
                        if (is_noreturn_ty(ty)) {
                            error("noreturn is only valid as a function return type");
                        }
                        if (tok.kind == TokKind.Comma) {
                            error("only one variable per declaration");
                        }
                        o2: *Obj = new_obj(name, 0);
                        o2.browse_pos = gpos;
                        o2.browse_file = gfile;
                        o2.browse_len = glen;
                        o2.ty = ty;
                        if (tok.kind != TokKind.Assign) {
                            error("global requires an initializer (name: T = e)");
                        }
                        tok = tok.next;
                        o2.init = parse_expr();
                        skip(TokKind.Semi);
                        append_item(new_item(ItemKind.Global { var: o2 }, gpos));
                    }
                }
            }
        }
    }
}

parse_program(entry_path: []i8) noregion raises Error {
    mark_nerr = 0;
    functions = null;
    function_tail = null;
    globals = null;
    struct_defs = null;
    enum_defs = null;
    exn_defs = null;
    imported_files = null;
    next_exn_tag = 1;
    browse_reset();
    clear_sym_tables();
    file_items = null;
    file_items_tail = null;
    parse_source_file(normalize_path(entry_path), 1);
}

/* Assumes n is already typed. True if execution cannot fall through. */
/* Syntactic divergence for parse-time early-exit narrowing (no full typing). */
stmt_parse_diverges(n: *Stmt): bool {
    match n.kind {
        Return _p -> {
            true;
        }
        Raise _p -> {
            true;
        }
        ExprStmt q -> {
            match q.lhs.kind {
                Funcall k -> {
                    if (streq(k.funcname, "exit")) {
                        return true;
                    }
                    fno: ?*Function = find_function(k.funcname);
                    if (fno != null) {
                        frt: ?*Type = fno.return_ty;
                        if (frt != null && is_noreturn_ty(frt)) {
                            return true;
                        }
                    }
                    false;
                }
                _ -> {
                    false;
                }
            }
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_parse_diverges(s)) {
                    return true;
                }
                s = s.next;
            }
            false;
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                stmt_parse_diverges(k.then) && stmt_parse_diverges(els);
            } else {
                false;
            }
        }
        Match k -> {
            if (k.arms == null) {
                return false;
            }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!stmt_parse_diverges(arm.body)) {
                    return false;
                }
                arm = arm.next;
            }
            true;
        }
        Try k -> {
            if (!stmt_parse_diverges(k.body)) {
                return false;
            }
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!stmt_parse_diverges(arm2.body)) {
                    return false;
                }
                arm2 = arm2.next;
            }
            true;
        }
        _ -> {
            false;
        }
    }
}

stmt_always_diverges(n: *Stmt): bool {
    match n.kind {
        Return _p -> {
            true;
        }
        Raise _p -> {
            true;
        }
        ExprStmt k -> {
            lty: ?*Type = k.lhs.ty;
            lty != null && is_noreturn_ty(lty);
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_always_diverges(s)) {
                    return true;
                }
                s = s.next;
            }
            false;
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                stmt_always_diverges(k.then) && stmt_always_diverges(els);
            } else {
                false;
            }
        }
        Match k -> {
            if (k.arms == null) {
                return false;
            }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!stmt_always_diverges(arm.body)) {
                    return false;
                }
                arm = arm.next;
            }
            true;
        }
        Try k -> {
            if (!stmt_always_diverges(k.body)) {
                return false;
            }
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!stmt_always_diverges(arm2.body)) {
                    return false;
                }
                arm2 = arm2.next;
            }
            true;
        }
        Region k -> {
            stmt_always_diverges(k.body);
        }
        _ -> {
            false;
        }
    }
}

stmt_diverges(n: *Stmt): bool {
    stmt_always_diverges(n);
}

check_noreturn_functions() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        frt: ?*Type = fn.return_ty;
        if (frt != null && is_noreturn_ty(frt) && fn.is_extern == 0) {
            body: ?*Stmt = fn.body;
            if (body == null || !stmt_diverges(body)) {
                error("noreturn function may return");
            }
        }
        fn = fn.next;
    }
}

mark_var_use(var: ?*Obj) {
    if (var != null) {
        var.used = 1;
    }
}

add_callee(callee: *Function@immortal) noregion {
    fn: ?*Function = current_fn;
    if (fn == null) {
        return;
    }
    fu: *Function = fn;
    fu.callees = new CallEdge { callee: callee, next: fu.callees };
}

mark_reachable(fn: *Function) {
    if (fn.used != 0) {
        return;
    }
    fn.used = 1;
    e: ?*CallEdge = fn.callees;
    while (e != null) {
        mark_reachable(e.callee);
        e = e.next;
    }
}

check_unused_functions() {
    fn: ?*Function = functions;
    while (fn != null) {
        fn.used = 0;
        fn = fn.next;
    }
    main_fn: ?*Function = find_function("main");
    if (main_fn == null) {
        return;
    }
    mark_reachable(main_fn);
    fn = functions;
    while (fn != null) {
        if (fn.used == 0 && fn.is_extern == 0) {
            warn_unused_function(fn.name);
        }
        fn = fn.next;
    }
}

check_unused_locals() {
    /* Names starting with `_` or `.` are ignored. Bare assignment does not count as a use. */
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.used != 0 && fn.is_extern == 0) {
            o: ?*Obj = fn.locals;
            while (o != null) {
                if (o.used == 0 && !ignore_unused_local_name(o.name)) {
                    warn_unused_local(fn.name, o.name);
                }
                o = o.next;
            }
        }
        fn = fn.next;
    }
}

expr_is_ignored_value(n: *Expr): bool {
    match n.kind {
        Assign _p -> {
            false;
        }
        Block _p -> {
            false;
        }
        If _p -> {
            false;
        }
        Match _p -> {
            false;
        }
        Funcall k -> {
            fno: ?*Function = k.fn;
            if (fno == null) {
                false;
            } else if (fno.is_extern != 0) {
                false;
            } else {
                rt: ?*Type = fno.return_ty;
                if (rt == null) {
                    false;
                } else if (is_noreturn_ty(rt)) {
                    false;
                } else {
                    true;
                }
            }
        }
        _ -> {
            true;
        }
    }
}

warn_return_style_expr(
    n: ?*Expr,
    tail: int,
    used: int,
    fn: *Function
) {
    if (n == null) {
        return;
    }
    match n.kind {
        Block q -> {
            warn_return_style_list(q.body, tail, used, fn);
            return;
        }
        If q -> {
            warn_return_style_expr(q.then, tail, used, fn);
            warn_return_style_expr(q.els, tail, used, fn);
            return;
        }
        Match q -> {
            arm: ?*MatchArm = q.arms;
            while (arm != null) {
                warn_return_style_list(arm.body, tail, used, fn);
                arm = arm.next;
            }
            return;
        }
        _ -> {
            return;
        }
    }
}

warn_return_style_stmt(
    s: *Stmt,
    tail: int,
    used: int,
    fn: *Function
) {
    match s.kind {
        Return k -> {
            if (tail != 0) {
                if (k.lhs != null) {
                    warn_unnecessary_return(fn.name);
                }
            }
            return;
        }
        ExprStmt k -> {
            warn_return_style_expr(k.lhs, tail, used, fn);
            if (used == 0) {
                rt: ?*Type = fn.return_ty;
                if (rt != null && !is_noreturn_ty(rt)) {
                    if (expr_is_ignored_value(k.lhs)) {
                        warn_ignored_value(fn.name);
                    }
                }
            }
            return;
        }
        Block k -> {
            warn_return_style_list(k.body, tail, used, fn);
            return;
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                warn_return_style_list(k.then, tail, used, fn);
                warn_return_style_list(els, tail, used, fn);
            } else {
                warn_return_style_list(k.then, 0, 0, fn);
            }
            return;
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                warn_return_style_list(arm.body, tail, used, fn);
                arm = arm.next;
            }
            return;
        }
        Try k -> {
            warn_return_style_list(k.body, tail, used, fn);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                warn_return_style_list(arm2.body, tail, used, fn);
                arm2 = arm2.next;
            }
            return;
        }
        While k -> {
            warn_return_style_list(k.body, 0, 0, fn);
            return;
        }
        For k -> {
            warn_return_style_list(k.body, 0, 0, fn);
            return;
        }
        _ -> {
            return;
        }
    }
}

warn_return_style_list(
    head: ?*Stmt,
    tail: int,
    used: int,
    fn: *Function
) {
    s: ?*Stmt = head;
    while (s != null) {
        is_last: int = 0;
        if (s.next == null) {
            is_last = 1;
        }
        st: int = 0;
        su: int = 0;
        if (tail != 0 && is_last != 0) {
            st = 1;
        }
        if (used != 0 && is_last != 0) {
            su = 1;
        }
        warn_return_style_stmt(s, st, su, fn);
        s = s.next;
    }
}

check_return_style() {
    fn: ?*Function = functions;
    while (fn != null) {
        used: int = 0;
        rt: ?*Type = fn.return_ty;
        if (rt != null && !is_noreturn_ty(rt)) {
            used = 1;
        }
        warn_return_style_list(fn.body, 1, used, fn);
        fn = fn.next;
    }
}

is_const_init(n: ?*Expr): bool {
    if (n == null) {
        return false;
    }
    match n.kind {
        Num k -> {
            k.str_label == 0;
        }
        Null -> {
            true;
        }
        Neg q -> {
            is_const_init(q.lhs);
        }
        BitNot q -> {
            is_const_init(q.lhs);
        }
        As q -> {
            is_const_init(q.lhs);
        }
        Trunc q -> {
            is_const_init(q.lhs);
        }
        Not q -> {
            is_const_init(q.lhs);
        }
        Binary q -> {
            is_const_init(q.lhs) && is_const_init(q.rhs);
        }
        _ -> {
            false;
        }
    }
}

wrap_u8(v: int): int {
    while (v < 0) {
        v = v + 256;
    }
    while (v >= 256) {
        v = v - 256;
    }
    v;
}

const_bit(a: int, b: int, kind: int): int {
    if (kind == 0) {
        a & b;
    } else if (kind == 1) {
        a | b;
    } else {
        a ^ b;
    }
}

const_shl(a: int, n: int) raises Error: int {
    if (n < 0) {
        error("negative shift in global initializer");
    }
    if (n >= 64) {
        return 0;
    }
    for _i in 0..n {
        a = a + a;
    }
    a;
}

const_sar1(a: int): int {
    a >> 1;
}

const_sar(a: int, n: int) raises Error: int {
    if (n < 0) {
        error("negative shift in global initializer");
    }
    if (n >= 64) {
        if (a < 0) {
            return 0 - 1;
        }
        return 0;
    }
    for _i in 0..n {
        a = const_sar1(a);
    }
    a;
}

const_value(n: *Expr) raises Error: int {
    match n.kind {
        Num k -> {
            return k.val;
        }
        Null -> {
            return 0;
        }
        Neg q -> {
            return 0 - const_value(q.lhs);
        }
        BitNot q -> {
            v0: int = 0 - 1 - const_value(q.lhs);
            nty0: ?*Type = n.ty;
            if (nty0 != null) {
                if (is_i8_ty(nty0)) {
                    return wrap_u8(v0);
                }
            }
            return v0;
        }
        As q -> {
            return const_value(q.lhs);
        }
        Trunc q -> {
            return wrap_u8(const_value(q.lhs));
        }
        Not q -> {
            if (const_value(q.lhs) == 0) {
                return 1;
            }
            return 0;
        }
        Binary q -> {
            l: int = const_value(q.lhs);
            r: int = const_value(q.rhs);
            v: int = 0;
            match q.op {
                Add -> {
                    v = l + r;
                }
                Sub -> {
                    v = l - r;
                }
                Mul -> {
                    v = l * r;
                }
                Div -> {
                    if (r == 0) {
                        error("division by zero in global initializer");
                    }
                    v = l / r;
                }
                Mod -> {
                    if (r == 0) {
                        error("division by zero in global initializer");
                    }
                    v = l % r;
                }
                And -> {
                    v = const_bit(l, r, 0);
                }
                Or -> {
                    v = const_bit(l, r, 1);
                }
                Xor -> {
                    v = const_bit(l, r, 2);
                }
                Shl -> {
                    v = const_shl(l, r);
                }
                Shr -> {
                    v = const_sar(l, r);
                }
                Eq -> {
                    if (l == r) {
                        v = 1;
                    }
                }
                Ne -> {
                    if (l != r) {
                        v = 1;
                    }
                }
                Lt -> {
                    if (l < r) {
                        v = 1;
                    }
                }
                Le -> {
                    if (l <= r) {
                        v = 1;
                    }
                }
                Gt -> {
                    if (l > r) {
                        v = 1;
                    }
                }
                Ge -> {
                    if (l >= r) {
                        v = 1;
                    }
                }
            }
            nty: ?*Type = n.ty;
            if (nty != null) {
                if (is_i8_ty(nty)) {
                    return wrap_u8(v);
                }
            }
            return v;
        }
        _ -> {
            error("global initializer must be a constant");
        }
    }
    0;
}

typecheck_global_inits() noregion raises Error {
    life_reset_imm();
    g: ?*Obj = globals;
    while (g != null) {
        if (g.is_func == 0) {
            init: ?*Expr = g.init;
            if (init == null) {
                error("global requires an initializer (name: T = e)");
            }
            add_type(init);
            if (!assignable(g.ty, init)) {
                error_have_expr_want("global initializer type mismatch", init, g.ty);
            }
            check_store(init, LIFE_IMM);
        }
        g = g.next;
    }
}

error_uninit(name: []i8) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, "use of uninitialized local ");
    sb_puts(sb, name);
    error(sb_finish(sb));
}

init_has(o: *Obj): bool {
    f: ?*InitFrame = init_top;
    while (f != null) {
        if (f.var == o) {
            return true;
        }
        f = f.next;
    }
    false;
}

init_mark(o: *Obj@immortal) noregion {
    if (init_has(o)) {
        return;
    }
    init_top = new InitFrame { var: o, next: init_top };
}

init_use(o: ?*Obj) noregion raises Error {
    if (o == null) {
        return;
    }
    if (o.is_local == 0) {
        return;
    }
    if (init_has(o)) {
        return;
    }
    error_uninit(o.name);
}

init_has_since(top: ?*InitFrame, save: ?*InitFrame, o: *Obj): bool {
    f: ?*InitFrame = top;
    while (f != null) {
        if (f == save) {
            return false;
        }
        if (f.var == o) {
            return true;
        }
        f = f.next;
    }
    false;
}

init_meet(then_top: ?*InitFrame@immortal, else_top: ?*InitFrame, save: ?*InitFrame@immortal) noregion {
    init_top = save;
    f: ?*InitFrame = then_top;
    while (f != null) {
        if (f == save) {
            return;
        }
        v: *Obj = f.var;
        if (init_has_since(else_top, save, v)) {
            init_mark(v);
        }
        f = f.next;
    }
}

init_mark_fn(fn: *Function@immortal) noregion {
    init_top = null;
    p: ?*Obj = fn.params;
    while (p != null) {
        init_mark(p);
        p = p.param_next;
    }
    o: ?*Obj = fn.locals;
    while (o != null) {
        if (len(o.name) > 0 && o.name[0] == '.') {
            init_mark(o);
        }
        o = o.next;
    }
}

da_field_inits(inits: ?*FieldInit) noregion raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        _e: bool = da_expr(a.lhs);
        a = a.next;
    }
}

da_write(n: *Expr) noregion raises Error {
    match n.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v != null) {
                init_mark(v);
            }
        }
        MemberAccess k -> {
            _e: bool = da_expr(k.lhs);
        }
        Index k -> {
            _a: bool = da_expr(k.lhs);
            _i: bool = da_expr(k.idx);
        }
        Deref k -> {
            _d: bool = da_expr(k.lhs);
        }
        _ -> {
            _n: bool = da_expr(n);
        }
    }
}

da_expr(n: ?*Expr) noregion raises Error: bool {
    if (n == null) {
        return false;
    }
    p: *Expr = n;
    match p.kind {
        Num _k -> {
            false;
        }
        Null -> {
            false;
        }
        Var k -> {
            init_use(k.var);
            false;
        }
        Binary k -> {
            _bl: bool = da_expr(k.lhs);
            _br: bool = da_expr(k.rhs);
            false;
        }
        Assign k -> {
            _ar: bool = da_expr(k.rhs);
            da_write(k.lhs);
            false;
        }
        Addr k -> {
            _ad: bool = da_expr(k.lhs);
            false;
        }
        Deref k -> {
            _dr: bool = da_expr(k.lhs);
            false;
        }
        Index k -> {
            _il: bool = da_expr(k.lhs);
            _ii: bool = da_expr(k.idx);
            false;
        }
        Not k -> {
            da_expr(k.lhs);
        }
        Neg k -> {
            da_expr(k.lhs);
        }
        BitNot k -> {
            da_expr(k.lhs);
        }
        LogAnd k -> {
            _al: bool = da_expr(k.lhs);
            save: ?*InitFrame = init_top;
            _ar2: bool = da_expr(k.rhs);
            init_top = save;
            false;
        }
        LogOr k -> {
            _ol: bool = da_expr(k.lhs);
            save2: ?*InitFrame = init_top;
            _or: bool = da_expr(k.rhs);
            init_top = save2;
            false;
        }
        OrElse k -> {
            _xl: bool = da_expr(k.lhs);
            save3: ?*InitFrame = init_top;
            _xr: bool = da_expr(k.rhs);
            init_top = save3;
            false;
        }
        Funcall k -> {
            a: ?*Expr = k.args;
            while (a != null) {
                _fa: bool = da_expr(a);
                a = a.next;
            }
            rt: ?*Type = p.ty;
            rt != null && is_noreturn_ty(rt);
        }
        MemberAccess k -> {
            _ma: bool = da_expr(k.lhs);
            false;
        }
        As k -> {
            da_expr(k.lhs);
        }
        Trunc k -> {
            da_expr(k.lhs);
        }
        New k -> {
            _nl: bool = da_expr(k.lhs);
            _nf: bool = da_expr(k.fill);
            da_field_inits(k.inits);
            false;
        }
        StructLit k -> {
            da_field_inits(k.inits);
            false;
        }
        VariantLit k -> {
            da_field_inits(k.inits);
            false;
        }
        If k -> {
            _ic: bool = da_expr(k.cond);
            savei: ?*InitFrame = init_top;
            dt: bool = da_expr(k.then);
            then_top: ?*InitFrame = init_top;
            init_top = savei;
            de: bool = da_expr(k.els);
            else_top: ?*InitFrame = init_top;
            if (dt && de) {
                return true;
            }
            if (dt) {
                init_top = else_top;
                return false;
            }
            if (de) {
                init_top = then_top;
                return false;
            }
            init_meet(then_top, else_top, savei);
            false;
        }
        Match k -> {
            _mc: bool = da_expr(k.cond);
            savem: ?*InitFrame = init_top;
            arm: ?*MatchArm = k.arms;
            any: int = 0;
            live: int = 0;
            acc: ?*InitFrame = null;
            while (arm != null) {
                init_top = savem;
                b: ?*Obj = arm.binder;
                if (b != null) {
                    init_mark(b);
                }
                d: bool = da_stmt(arm.body);
                if (!d) {
                    if (live == 0) {
                        acc = init_top;
                    } else {
                        init_meet(acc, init_top, savem);
                        acc = init_top;
                    }
                    live = live + 1;
                }
                any = 1;
                arm = arm.next;
            }
            if (any == 0) {
                return false;
            }
            if (live == 0) {
                return true;
            }
            init_top = acc;
            false;
        }
        Block k -> {
            da_stmt_list(k.body);
        }
        Sizeof k -> {
            da_expr(k.e);
        }
    }
}

da_stmt_list(s: ?*Stmt) noregion raises Error: bool {
    a: ?*Stmt = s;
    d: bool = false;
    while (a != null) {
        if (da_stmt(a)) {
            d = true;
        }
        a = a.next;
    }
    d;
}

da_stmt(s: ?*Stmt) noregion raises Error: bool {
    if (s == null) {
        return false;
    }
    match s.kind {
        Return k -> {
            _re: bool = da_expr(k.lhs);
            true;
        }
        Raise k -> {
            da_field_inits(k.inits);
            true;
        }
        ExprStmt k -> {
            da_expr(k.lhs);
        }
        Block k -> {
            da_stmt_list(k.body);
        }
        If k -> {
            _sc: bool = da_expr(k.cond);
            save: ?*InitFrame = init_top;
            dt: bool = da_stmt(k.then);
            then_top: ?*InitFrame = init_top;
            els: ?*Stmt = k.els;
            if (els == null) {
                init_top = save;
                false;
            } else {
                init_top = save;
                de: bool = da_stmt(els);
                else_top: ?*InitFrame = init_top;
                if (dt && de) {
                    return true;
                }
                if (dt) {
                    init_top = else_top;
                    return false;
                }
                if (de) {
                    init_top = then_top;
                    return false;
                }
                init_meet(then_top, else_top, save);
                false;
            }
        }
        While k -> {
            _wc: bool = da_expr(k.cond);
            savew: ?*InitFrame = init_top;
            _wb: bool = da_stmt(k.body);
            init_top = savew;
            false;
        }
        For k -> {
            _fi: bool = da_expr(k.iter);
            _fh: bool = da_expr(k.hi);
            init_mark(k.item);
            savef: ?*InitFrame = init_top;
            _fb: bool = da_stmt(k.body);
            init_top = savef;
            false;
        }
        Match k -> {
            _sm: bool = da_expr(k.cond);
            savem: ?*InitFrame = init_top;
            arm: ?*MatchArm = k.arms;
            any: int = 0;
            live: int = 0;
            acc: ?*InitFrame = null;
            while (arm != null) {
                init_top = savem;
                b: ?*Obj = arm.binder;
                if (b != null) {
                    init_mark(b);
                }
                d: bool = da_stmt(arm.body);
                if (!d) {
                    if (live == 0) {
                        acc = init_top;
                    } else {
                        init_meet(acc, init_top, savem);
                        acc = init_top;
                    }
                    live = live + 1;
                }
                any = 1;
                arm = arm.next;
            }
            if (any == 0) {
                return false;
            }
            if (live == 0) {
                return true;
            }
            init_top = acc;
            false;
        }
        Try k -> {
            savet: ?*InitFrame = init_top;
            dtry: bool = da_stmt(k.body);
            try_top: ?*InitFrame = init_top;
            live: int = 0;
            acc: ?*InitFrame = null;
            if (!dtry) {
                acc = try_top;
                live = 1;
            }
            arm: ?*CatchArm = k.arms;
            all_div: bool = dtry;
            while (arm != null) {
                init_top = savet;
                b: ?*Obj = arm.binder;
                if (b != null) {
                    init_mark(b);
                }
                dc: bool = da_stmt(arm.body);
                if (!dc) {
                    if (live == 0) {
                        acc = init_top;
                    } else {
                        init_meet(acc, init_top, savet);
                        acc = init_top;
                    }
                    live = live + 1;
                    all_div = false;
                }
                arm = arm.next;
            }
            if (all_div && live == 0) {
                return true;
            }
            init_top = acc;
            false;
        }
        Region k -> {
            da_stmt(k.body);
        }
        Decl k -> {
            _di: bool = da_expr(k.init);
            vo: ?*Obj = k.var;
            if (k.init != null && vo != null) {
                init_mark(vo);
            }
            false;
        }
        Comment _c -> {
            false;
        }
    }
}

check_fn_inited(fn: *Function@immortal) noregion raises Error {
    init_mark_fn(fn);
    _fn: bool = da_stmt(fn.body);
    init_top = null;
}

expr_calls_need_imm(n: ?*Expr): bool {
    if (n == null) {
        return false;
    }
    match n.kind {
        Funcall k -> {
            fno: ?*Function = k.fn;
            if (fno == null) {
                fno = find_function(k.funcname);
            }
            if (fno != null) {
                fu: *Function = fno;
                if (fu.need_imm_heap != 0) {
                    return true;
                }
            }
            a: ?*Expr = k.args;
            while (a != null) {
                if (expr_calls_need_imm(a)) {
                    return true;
                }
                a = a.next;
            }
            false;
        }
        Binary k -> {
            expr_calls_need_imm(k.lhs) || expr_calls_need_imm(k.rhs);
        }
        Assign k -> {
            expr_calls_need_imm(k.lhs) || expr_calls_need_imm(k.rhs);
        }
        Addr k -> {
            expr_calls_need_imm(k.lhs);
        }
        Deref k -> {
            expr_calls_need_imm(k.lhs);
        }
        Index k -> {
            expr_calls_need_imm(k.lhs) || expr_calls_need_imm(k.idx);
        }
        Not k -> {
            expr_calls_need_imm(k.lhs);
        }
        Neg k -> {
            expr_calls_need_imm(k.lhs);
        }
        BitNot k -> {
            expr_calls_need_imm(k.lhs);
        }
        LogAnd k -> {
            expr_calls_need_imm(k.lhs) || expr_calls_need_imm(k.rhs);
        }
        LogOr k -> {
            expr_calls_need_imm(k.lhs) || expr_calls_need_imm(k.rhs);
        }
        OrElse k -> {
            expr_calls_need_imm(k.lhs) || expr_calls_need_imm(k.rhs);
        }
        MemberAccess k -> {
            expr_calls_need_imm(k.lhs);
        }
        As k -> {
            expr_calls_need_imm(k.lhs);
        }
        Trunc k -> {
            expr_calls_need_imm(k.lhs);
        }
        New k -> {
            expr_calls_need_imm(k.lhs) || expr_calls_need_imm(k.fill) || field_inits_calls_need_imm(k.inits);
        }
        StructLit k -> {
            field_inits_calls_need_imm(k.inits);
        }
        VariantLit k -> {
            field_inits_calls_need_imm(k.inits);
        }
        If k -> {
            expr_calls_need_imm(k.cond) || expr_calls_need_imm(k.then) || expr_calls_need_imm(k.els);
        }
        Match k -> {
            if (expr_calls_need_imm(k.cond)) {
                return true;
            }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (stmt_calls_need_imm(arm.body)) {
                    return true;
                }
                arm = arm.next;
            }
            false;
        }
        Block k -> {
            stmt_list_calls_need_imm(k.body);
        }
        Sizeof k -> {
            expr_calls_need_imm(k.e);
        }
        _ -> {
            false;
        }
    }
}

field_inits_calls_need_imm(inits: ?*FieldInit): bool {
    a: ?*FieldInit = inits;
    while (a != null) {
        if (expr_calls_need_imm(a.lhs)) {
            return true;
        }
        a = a.next;
    }
    false;
}

stmt_calls_need_imm(s: ?*Stmt): bool {
    if (s == null) {
        return false;
    }
    match s.kind {
        Return k -> {
            expr_calls_need_imm(k.lhs);
        }
        ExprStmt k -> {
            expr_calls_need_imm(k.lhs);
        }
        Block k -> {
            stmt_list_calls_need_imm(k.body);
        }
        If k -> {
            expr_calls_need_imm(k.cond) || stmt_calls_need_imm(k.then) || stmt_calls_need_imm(k.els);
        }
        While k -> {
            expr_calls_need_imm(k.cond) || stmt_calls_need_imm(k.body);
        }
        For k -> {
            expr_calls_need_imm(k.iter) || expr_calls_need_imm(k.hi) || stmt_calls_need_imm(k.body);
        }
        Match k -> {
            if (expr_calls_need_imm(k.cond)) {
                return true;
            }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (stmt_calls_need_imm(arm.body)) {
                    return true;
                }
                arm = arm.next;
            }
            false;
        }
        Raise k -> {
            field_inits_calls_need_imm(k.inits);
        }
        Try k -> {
            if (stmt_calls_need_imm(k.body)) {
                return true;
            }
            a: ?*CatchArm = k.arms;
            while (a != null) {
                if (stmt_calls_need_imm(a.body)) {
                    return true;
                }
                a = a.next;
            }
            false;
        }
        Region k -> {
            stmt_calls_need_imm(k.body);
        }
        Decl k -> {
            expr_calls_need_imm(k.init);
        }
        _ -> {
            false;
        }
    }
}

stmt_list_calls_need_imm(s: ?*Stmt): bool {
    while (s != null) {
        if (stmt_calls_need_imm(s)) {
            return true;
        }
        s = s.next;
    }
    false;
}

propagate_need_imm_heap() {
    changed: int = 1;
    while (changed != 0) {
        changed = 0;
        fn: ?*Function = functions;
        while (fn != null) {
            if (fn.is_extern == 0 && fn.need_imm_heap == 0) {
                if (stmt_calls_need_imm(fn.body)) {
                    fn.need_imm_heap = 1;
                    changed = 1;
                }
            }
            fn = fn.next;
        }
    }
}

check_region_calls_expr(n: ?*Expr) raises Error {
    if (n == null) {
        return;
    }
    match n.kind {
        Funcall k -> {
            fno: ?*Function = k.fn;
            if (fno == null) {
                fno = find_function(k.funcname);
            }
            if (fno != null) {
                fu: *Function = fno;
                if (fu.need_imm_heap != 0) {
                    if (life_heap != LIFE_HEAPTOP && life_heap != LIFE_IMM) {
                        error("cannot call from a region");
                    }
                }
            }
            a: ?*Expr = k.args;
            while (a != null) {
                check_region_calls_expr(a);
                a = a.next;
            }
            return;
        }
        Binary k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return;
        }
        Assign k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return;
        }
        Addr k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        Deref k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        Index k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.idx);
            return;
        }
        Not k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        Neg k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        BitNot k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        LogAnd k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return;
        }
        LogOr k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return;
        }
        OrElse k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.rhs);
            return;
        }
        MemberAccess k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        As k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        Trunc k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        New k -> {
            check_region_calls_expr(k.lhs);
            check_region_calls_expr(k.fill);
            check_region_calls_inits(k.inits);
            return;
        }
        StructLit k -> {
            check_region_calls_inits(k.inits);
            return;
        }
        VariantLit k -> {
            check_region_calls_inits(k.inits);
            return;
        }
        If k -> {
            check_region_calls_expr(k.cond);
            check_region_calls_expr(k.then);
            check_region_calls_expr(k.els);
            return;
        }
        Match k -> {
            check_region_calls_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                check_region_calls_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Block k -> {
            check_region_calls_stmt_list(k.body);
            return;
        }
        _ -> {
            return;
        }
    }
}

check_region_calls_inits(inits: ?*FieldInit) raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        check_region_calls_expr(a.lhs);
        a = a.next;
    }
}

check_region_calls_stmt(s: ?*Stmt) raises Error {
    if (s == null) {
        return;
    }
    match s.kind {
        Return k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        ExprStmt k -> {
            check_region_calls_expr(k.lhs);
            return;
        }
        Block k -> {
            check_region_calls_stmt_list(k.body);
            return;
        }
        If k -> {
            check_region_calls_expr(k.cond);
            check_region_calls_stmt(k.then);
            check_region_calls_stmt(k.els);
            return;
        }
        While k -> {
            check_region_calls_expr(k.cond);
            check_region_calls_stmt(k.body);
            return;
        }
        For k -> {
            check_region_calls_expr(k.iter);
            check_region_calls_expr(k.hi);
            check_region_calls_stmt(k.body);
            return;
        }
        Match k -> {
            check_region_calls_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                check_region_calls_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Raise k -> {
            check_region_calls_inits(k.inits);
            return;
        }
        Try k -> {
            check_region_calls_stmt(k.body);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                check_region_calls_stmt(a.body);
                a = a.next;
            }
            return;
        }
        Region k -> {
            old_heap: int = life_heap;
            life_heap = 99;
            check_region_calls_stmt(k.body);
            life_heap = old_heap;
            return;
        }
        Decl k -> {
            check_region_calls_expr(k.init);
            return;
        }
        _ -> {
            return;
        }
    }
}

check_region_calls_stmt_list(s: ?*Stmt) raises Error {
    while (s != null) {
        check_region_calls_stmt(s);
        s = s.next;
    }
}

check_region_calls_all() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.is_extern == 0) {
            life_heap = LIFE_HEAPTOP;
            check_region_calls_stmt(fn.body);
        }
        fn = fn.next;
    }
}

typecheck_program() noregion raises Error {
    typecheck_global_inits();
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.is_extern == 0) {
            e: ?*ExnList = fn.raises_list;
            while (e != null) {
                e.seen = 0;
                e = e.next;
            }
            current_fn = fn;
            current_return_ty = fn.return_ty;
            catch_top = null;
            narrow_top = null;
            walk_top = null;
            zero_top = null;
            taint_top = null;
            addr_top = null;
            life_init_fn(fn);
            add_type_stmt(fn.body);
            check_fn_result(fn);
            check_fn_inited(fn);
        }
        fn = fn.next;
    }
    propagate_need_imm_heap();
    propagate_param_bounds();
    check_region_calls_all();
    current_fn = null;
    current_return_ty = null;
    catch_top = null;
    narrow_top = null;
}

check_fn_result(fn: *Function@immortal) noregion raises Error {
    if (fn.is_extern != 0) {
        return;
    }
    rt: ?*Type = fn.return_ty;
    if (rt == null) {
        return;
    }
    if (is_noreturn_ty(rt)) {
        return;
    }
    want: *Type = rt;
    if (check_stmt_result(fn.body, want)) {
        return;
    }
    sb: *StrBuf = sb_new();
    sb_puts(sb, "missing return value in ");
    sb_puts(sb, fn.name);
    error(sb_finish(sb));
}

check_raises_functions() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.raises_list != null) {
            e: ?*ExnList = fn.raises_list;
            while (e != null) {
                if (e.seen == 0) {
                    error("raises lists an exception that is never raised");
                }
                e = e.next;
            }
        }
        fn = fn.next;
    }
}

mark_print_at(file: int, pos: int, msg: []i8) {
    f: ?*ImportedFile = imported_files;
    while (f != null) {
        if (f.id == file) {
            print_error_at(f.path, f.src, f.src_len, pos, msg);
            mark_nerr = mark_nerr + 1;
            return;
        }
        f = f.next;
    }
    print_error_at(source_path, source, source_len, pos, msg);
    mark_nerr = mark_nerr + 1;
}

check_imm_heap_functions() {
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.is_extern == 0) {
            if (fn.need_imm_heap != 0 && fn.decl_imm_heap == 0) {
                sb: *StrBuf = sb_new();
                sb_puts(sb, "missing noregion on ");
                sb_puts(sb, fn.name);
                mark_print_at(fn.browse_file, fn.browse_pos, sb_finish(sb));
            }
            if (fn.need_imm_heap == 0 && fn.decl_imm_heap != 0) {
                sb2: *StrBuf = sb_new();
                sb_puts(sb2, "unnecessary noregion on ");
                sb_puts(sb2, fn.name);
                mark_print_at(fn.browse_file, fn.browse_pos, sb_finish(sb2));
            }
        }
        fn = fn.next;
    }
}

BOUND_OMIT: int = 0;

BOUND_NEW: int = 1;

BOUND_IMM: int = 2;

BOUND_NAMED: int = 0 - 1;

written_param_kind(p: *Obj): int {
    b: []i8 = p.life_bound;
    if (life_bound_immortal(b)) {
        return BOUND_IMM;
    }
    if (streq(b, "new")) {
        return BOUND_NEW;
    }
    if (len(b) == 0 || streq(b, p.name)) {
        return BOUND_OMIT;
    }
    BOUND_NAMED;
}

inferred_param_kind(p: *Obj): int {
    if (p.bound_need_imm != 0) {
        return BOUND_IMM;
    }
    if (p.bound_need_new != 0) {
        return BOUND_NEW;
    }
    if (p.bound_named != null) {
        return BOUND_NAMED;
    }
    BOUND_OMIT;
}

written_ret_kind(fn: *Function): int {
    b: []i8 = fn.ret_bound;
    if (len(b) == 0 || life_bound_immortal(b)) {
        return BOUND_OMIT;
    }
    if (streq(b, "new")) {
        return BOUND_NEW;
    }
    BOUND_NAMED;
}

inferred_ret_kind(fn: *Function): int {
    if (fn.bound_ret_need_new != 0) {
        return BOUND_NEW;
    }
    if (fn.bound_ret_param != null) {
        return BOUND_NAMED;
    }
    BOUND_OMIT;
}

bound_err(msg: []i8, fn: *Function) {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, fn.name);
    mark_print_at(fn.browse_file, fn.browse_pos, sb_finish(sb));
}

bound_err_param(msg: []i8, fn: *Function, p: *Obj) {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, p.name);
    sb_puts(sb, " in ");
    sb_puts(sb, fn.name);
    mark_print_at(p.browse_file, p.browse_pos, sb_finish(sb));
}

bound_use_named(fn: *Function, p: ?*Obj) {
    if (p == null) {
        bound_err("omit bound on ", fn);
        return;
    }
    pu: *Obj = p;
    sb: *StrBuf = sb_new();
    sb_puts(sb, "use @");
    sb_puts(sb, pu.name);
    sb_puts(sb, " on ");
    sb_puts(sb, fn.name);
    mark_print_at(fn.browse_file, fn.browse_pos, sb_finish(sb));
}

bound_use_named_param(fn: *Function, p: *Obj, inf: ?*Obj) {
    if (inf == null) {
        bound_err_param("omit bound on ", fn, p);
        return;
    }
    iu: *Obj = inf;
    sb: *StrBuf = sb_new();
    sb_puts(sb, "use @");
    sb_puts(sb, iu.name);
    sb_puts(sb, " on ");
    sb_puts(sb, p.name);
    sb_puts(sb, " in ");
    sb_puts(sb, fn.name);
    mark_print_at(p.browse_file, p.browse_pos, sb_finish(sb));
}

param_needs_bound(p: *Obj): bool {
    type_is_ref(p.ty) || type_has_pointers(p.ty);
}

check_written_param(fn: *Function, p: *Obj) {
    if (!param_needs_bound(p)) {
        return;
    }
    have: int = written_param_kind(p);
    want: int = inferred_param_kind(p);
    if (have == want) {
        if (have == BOUND_NAMED) {
            inf: ?*Obj = p.bound_named;
            if (inf == null) {
                return;
            }
            if (!streq(p.life_bound, inf.name)) {
                bound_use_named_param(fn, p, inf);
            }
        }
        return;
    }
    if (want == BOUND_IMM) {
        bound_err_param("use @immortal on ", fn, p);
        return;
    }
    if (want == BOUND_NEW) {
        bound_err_param("use @new on ", fn, p);
        return;
    }
    if (want == BOUND_NAMED) {
        bound_use_named_param(fn, p, p.bound_named);
        return;
    }
    bound_err_param("omit bound on ", fn, p);
}

check_written_ret(fn: *Function) {
    if (!type_is_ref(fn.return_ty)) {
        return;
    }
    have: int = written_ret_kind(fn);
    want: int = inferred_ret_kind(fn);
    if (have == want) {
        if (have == BOUND_NAMED) {
            rp: ?*Obj = fn.bound_ret_param;
            if (rp == null) {
                return;
            }
            if (!streq(fn.ret_bound, rp.name)) {
                bound_use_named(fn, rp);
            }
        }
        return;
    }
    if (want == BOUND_NEW) {
        bound_err("return of new requires @new on ", fn);
        return;
    }
    if (have == BOUND_NEW) {
        bound_err("return bound is @new on ", fn);
        return;
    }
    if (want == BOUND_NAMED) {
        bound_use_named(fn, fn.bound_ret_param);
        return;
    }
    bound_err("omit bound on ", fn);
}

propagate_param_bounds() {
    changed: int = 1;
    while (changed != 0) {
        changed = 0;
        fn: ?*Function = functions;
        while (fn != null) {
            c: ?*BoundCall = fn.bound_calls;
            while (c != null) {
                if (c.callee_param.bound_need_imm != 0 && c.caller_param.bound_need_imm == 0) {
                    c.caller_param.bound_need_imm = 1;
                    changed = 1;
                }
                if (c.callee_param.bound_need_new != 0 && c.caller_param.bound_need_new == 0) {
                    c.caller_param.bound_need_new = 1;
                    changed = 1;
                }
                c = c.next;
            }
            fn = fn.next;
        }
    }
}

check_written_bounds() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.is_extern == 0) {
            p: ?*Obj = fn.params;
            while (p != null) {
                check_written_param(fn, p);
                p = p.param_next;
            }
            check_written_ret(fn);
        }
        fn = fn.next;
    }
    if (mark_nerr != 0) {
        error("lifetime marks do not match");
    }
}

new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    l;
}

load_mem(ty: *Type) noregion {
    if (is_byte_ty(ty)) {
        cg_movzb_mr(0, 0, 0);
    } else {
        cg_mov_mr(0, 0, 0);
    }
}

store_mem(ty: *Type) noregion {
    if (is_byte_ty(ty)) {
        cg_movb_rm(0, 7, 0);
    } else {
        cg_mov_rm(0, 7, 0);
    }
}

emit_memcpy(sz: int) noregion {
    if (sz <= 0) {
        sz = 8;
    }
    i: int = 0;
    while (i + 8 <= sz) {
        cg_mov_mr(6, i, 0);
        cg_mov_rm(0, 7, i);
        i = i + 8;
    }
    while (i < sz) {
        cg_movzb_mr(6, i, 0);
        cg_movb_rm(0, 7, i);
        i = i + 1;
    }
}

/* Store value in %rax into (%rdi). By-ref aggregates: %rax is a source pointer. */
store_value(ty: *Type) noregion {
    if (passes_by_ref(ty)) {
        cg_mov_rr(0, 6);
        emit_memcpy(type_size(ty));
    } else {
        store_mem(ty);
    }
}

/* Fill in %r8, dest in %rdi. Struct/enum/exn literals are addresses. */
store_array_fill(fill: *Expr, base: *Type) noregion {
    if (is_struct_ty(base) || is_enum_ty(base) || is_exn_ty(base)) {
        lit: int = 0;
        match fill.kind {
            StructLit _ -> {
                lit = 1;
            }
            VariantLit _ -> {
                lit = 1;
            }
            _ -> { }
        }
        if (lit != 0 || passes_by_ref(base)) {
            cg_mov_rr(8, 6);
            emit_memcpy(type_size(base));
            return;
        }
    }
    cg_mov_rr(8, 0);
    store_mem(base);
}

/*
 * Object base in %rbx (absolute). Eval RHS first so a large aggregate stack
 * temp from gen_expr cannot bury a pushed destination address.
 * base_off is added to each field offset (0 for structs, 8 for enum payloads).
 */
gen_field_inits(inits: ?*FieldInit, base_off: int) noregion raises Error {
    init: ?*FieldInit = inits;
    while (init != null) {
        lhs: ?*Expr = init.lhs;
        if (lhs != null) {
            mem: *Member = init.member or error("internal");
            mty: *Type = mem.ty;
            gen_expr(lhs);
            cg_mov_rr(3, 7);
            off: int = base_off + mem.offset;
            if (off != 0) {
                cg_alu_imm(0, off, 7);
            }
            store_value(mty);
        }
        init = init.next;
    }
}

emit_exit1() noregion {
    cg_mov_imm(1, 7);
    cg_call("exit");
}

/* Heap is 64MiB. n * esz + 8 must not wrap; negative n is huge unsigned. */
emit_check_new_count(nreg: int, esz: int) noregion {
    max_n: int = 67108856 / esz;
    if (max_n <= 0) {
        max_n = 0;
    }
    cg_alu_imm(7, max_n, nreg);
    cg_jump_id(7, oob_lab);
}

emit_malloc() noregion {
    cg_call("malloc");
    cg_alu_imm(7, 0, 0);
    cg_jump_id(4, oob_lab);
}

emit_exc_malloc() noregion {
    cg_call("l8_exc_malloc");
    cg_alu_imm(7, 0, 0);
    cg_jump_id(4, oob_lab);
}

emit_check_idx() noregion {
    cg_alu_rr(57, 2, 1);
    cg_jump_id(3, oob_lab);
}

/* Args already in rdi=dst, rsi=di, rdx=src, rcx=si, r8=n. Check ends, then
 * call runtime memcpy(dst+di, src+si, n). ja: di+n > len is OOB.
 * di/si are also compared to len first so a negative index cannot wrap. */
emit_memcpy_call() noregion {
    cg_mov_mr(7, 0 - 8, 0);
    cg_alu_rr(57, 0, 6);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(6, 10);
    cg_alu_rr(1, 8, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_mov_mr(2, 0 - 8, 0);
    cg_alu_rr(57, 0, 1);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(1, 10);
    cg_alu_rr(1, 8, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_alu_rr(1, 6, 7);
    cg_alu_rr(1, 1, 2);
    cg_mov_rr(2, 6);
    cg_mov_rr(8, 2);
    cg_call("l8_memcpy");
}

/* Args already in registers. []i8 uses the length prefix; *i8 is one byte. */
emit_io_call(name: []i8@immortal, args: ?*Expr) noregion raises Error {
    a0: ?*Expr = args;
    if (a0 == null) {
        error("missing I/O args");
    }
    a1: ?*Expr = a0.next;
    if (a1 == null) {
        error("missing I/O args");
    }
    t1: ?*Type = decay(a1.ty);
    a2: ?*Expr = a1.next;
    if (t1 != null && is_pointer(t1)) {
        cg_mov_imm(1, 2);
        cg_call(name);
        return;
    }
    if (a2 == null) {
        cg_mov_mr(6, 0 - 8, 2);
        cg_call(name);
        return;
    }
    if (a2.next == null) {
        cg_mov_mr(6, 0 - 8, 0);
        cg_alu_rr(57, 0, 2);
        cg_jump_id(7, oob_lab);
        cg_call(name);
        return;
    }
    cg_mov_mr(6, 0 - 8, 0);
    cg_alu_rr(57, 0, 2);
    cg_jump_id(7, oob_lab);
    cg_mov_rr(2, 10);
    cg_alu_rr(1, 1, 10);
    cg_alu_rr(57, 0, 10);
    cg_jump_id(7, oob_lab);
    cg_alu_rr(1, 2, 6);
    cg_mov_rr(1, 2);
    cg_call(name);
}

emit_scale_offset(esz: int) noregion {
    if (esz == 1) {
        cg_alu_rr(1, 1, 6);
        cg_mov_rr(6, 0);
    } else {
        cg_mov_rr(1, 0);
        if (esz != 0) {
            cg_imul_imm(esz, 0);
        }
        cg_alu_rr(1, 6, 0);
    }
}

index_atom(n: *Expr): bool {
    match n.kind {
        Num k -> {
            k.str_label == 0;
        }
        Var _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

index_simple(n: *Expr): bool {
    match n.kind {
        Num k -> {
            k.str_label == 0;
        }
        Var _p -> {
            true;
        }
        Binary k -> {
            match k.op {
                Add -> {
                    index_atom(k.lhs) && index_atom(k.rhs);
                }
                _ -> {
                    false;
                }
            }
        }
        _ -> {
            false;
        }
    }
}

gen_simple_idx(n: *Expr) noregion raises Error {
    match n.kind {
        Num k -> {
            cg_mov_imm(k.val, 0);
            return;
        }
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo == null) {
                error("missing var");
            }
            vu: *Obj = vo;
            emit_load_var(vu, vu.ty or error("missing type"));
            return;
        }
        Binary k -> {
            kn: int = index_idx_num(k.rhs);
            if (kn >= 0) {
                gen_simple_idx(k.lhs);
                if (kn != 0) {
                    cg_alu_imm(0, kn, 0);
                }
                return;
            }
            knl: int = index_idx_num(k.lhs);
            if (knl >= 0) {
                gen_simple_idx(k.rhs);
                if (knl != 0) {
                    cg_alu_imm(0, knl, 0);
                }
                return;
            }
            gen_simple_idx(k.lhs);
            cg_mov_rr(0, 1);
            gen_simple_idx(k.rhs);
            cg_alu_rr(1, 1, 0);
            return;
        }
        _ -> {
            error("internal: gen_simple_idx");
        }
    }
}

gen_index_addr(lhs: *Expr, idx: *Expr) noregion raises Error {
    raw: *Type = lhs.ty or error("missing type");
    esz: int = type_size(type_base(raw));
    lv: ?*Obj = index_lhs_var(lhs);
    if (lv != null && index_simple(idx)) {
        gen_simple_idx(idx);
        cg_mov_rr(0, 1);
        lvo: *Obj = lv;
        lty: *Type = lvo.ty or error("missing type");
        emit_load_var(lvo, lty);
        cg_mov_rr(0, 6);
        if (is_zptr(raw)) {
            emit_scale_offset(esz);
            return;
        }
        if (!is_slice(raw)) {
            error("index requires []T or [z]T");
        }
        cg_mov_mr(6, 0 - 8, 2);
        emit_check_idx();
        emit_scale_offset(esz);
        return;
    }
    cg_push(3);
    if (is_zptr(raw)) {
        gen_expr(lhs);
        cg_mov_rr(0, 6);
        cg_push(6);
        gen_expr(idx);
        cg_mov_rr(0, 1);
        cg_pop(6);
    } else {
        if (!is_slice(raw)) {
            error("index requires []T or [z]T");
        }
        gen_expr(lhs);
        cg_mov_rr(0, 6);
        cg_mov_mr(6, 0 - 8, 2);
        cg_push(6);
        cg_push(2);
        gen_expr(idx);
        cg_mov_rr(0, 1);
        cg_pop(2);
        cg_pop(6);
        emit_check_idx();
    }
    emit_scale_offset(esz);
    cg_pop(3);
}

gen_struct_inits(inits: ?*FieldInit) noregion raises Error {
    gen_field_inits(inits, 0);
}

gen_variant_inits(inits: ?*FieldInit) noregion raises Error {
    gen_field_inits(inits, 8);
}

gen_addr(n: *Expr) noregion raises Error {
    match n.kind {
        Var k -> {
            var: ?*Obj = k.var;
            if (var == null) {
                error("missing var");
            }
            vo: *Obj = var;
            if (vo.is_local != 0) {
                cg_lea_mr(5, vo.offset, 0);
            } else {
                cg_lea_rip(vo.name, 0, 0);
            }
            return;
        }
        Deref k -> {
            gen_expr(k.lhs);
            return;
        }
        Index k -> {
            gen_index_addr(k.lhs, k.idx);
            return;
        }
        MemberAccess k -> {
            t: ?*Type = decay(k.lhs.ty);
            if (t != null && is_pointer(t) && (is_struct_ty(type_base(t)) || is_exn_ty(type_base(t)))) {
                gen_expr(k.lhs);
            } else {
                gen_addr(k.lhs);
            }
            mem: *Member = k.member or error("internal");
            if (mem.offset != 0) {
                cg_alu_imm(0, mem.offset, 0);
            }
            return;
        }
        _ -> {
            error("not an lvalue");
        }
    }
}

/* Scalar load of a variable into %rax without lea+deref. */
emit_load_var(vo: *Obj, ty: *Type) noregion {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) {
            cg_movzb_mr(5, vo.offset, 0);
        } else {
            cg_mov_mr(5, vo.offset, 0);
        }
    } else {
        cg_mov_rip_r(vo.name, 0, 0);
    }
}

/* Scalar store of %rax into a variable. */
emit_store_var(vo: *Obj, ty: *Type) noregion {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) {
            cg_movb_rm(0, 5, vo.offset);
        } else {
            cg_mov_rm(0, 5, vo.offset);
        }
    } else {
        cg_mov_r_rip(0, vo.name, 0);
    }
}

fits_imm32(v: int): bool {
    lo: int = 0 - 2147483647;
    lo = lo - 1;
    hi: int = 2147483647;
    if (v < lo) {
        return false;
    }
    if (v > hi) {
        return false;
    }
    true;
}

/* Store an immediate into a scalar variable (no %rax round-trip). */
emit_store_imm(vo: *Obj, ty: *Type, v: int) noregion {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) {
            cg_movb_imm_m(v, 5, vo.offset);
        } else {
            cg_movq_imm_m(v, 5, vo.offset);
        }
    } else {
        if (is_byte_ty(ty)) {
            cg_movb_imm_rip(v, vo.name);
        } else {
            cg_movq_imm_rip(v, vo.name);
        }
    }
}

gen_load(n: *Expr) noregion raises Error {
    ty: *Type = n.ty or error("missing type");
    if (passes_by_ref(ty)) {
        gen_addr(n);
        return;
    }
    match n.kind {
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo != null) {
                emit_load_var(vo, ty);
                return;
            }
        }
        _ -> { }
    }
    gen_addr(n);
    load_mem(ty);
}

gen_binop_setup(lhs: *Expr, rhs: *Expr) noregion raises Error {
    gen_expr(lhs);
    cg_push(0);
    gen_expr(rhs);
    cg_mov_rr(0, 7);
    cg_pop(0);
}

/* Immediate integer operand for codegen (numeric literal or null). */
imm_operand(n: *Expr): int {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) {
                0;
            } else {
                1;
            }
        }
        Null -> {
            1;
        }
        _ -> {
            0;
        }
    }
}

imm_value(n: *Expr): int {
    match n.kind {
        Num k -> {
            k.val;
        }
        Null -> {
            0;
        }
        _ -> {
            0;
        }
    }
}

gen_cmp_set(setcc: []i8) noregion {
    cc: int = 4;
    if (streq(setcc, "setne")) {
        cc = 5;
    }
    if (streq(setcc, "setl")) {
        cc = 12;
    }
    if (streq(setcc, "setge")) {
        cc = 13;
    }
    if (streq(setcc, "setle")) {
        cc = 14;
    }
    if (streq(setcc, "setg")) {
        cc = 15;
    }
    cg_setcc(cc);
    cg_movzb_al_rax();
}

gen_cmp(lhs: *Expr, rhs: *Expr, setcc: []i8) noregion raises Error {
    if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
        gen_expr(lhs);
        cg_alu_imm(7, imm_value(rhs), 0);
        gen_cmp_set(setcc);
        return;
    }
    if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
        gen_expr(rhs);
        cg_mov_rr(0, 7);
        cg_mov_imm(imm_value(lhs), 0);
        cg_alu_rr(57, 7, 0);
        gen_cmp_set(setcc);
        return;
    }
    gen_binop_setup(lhs, rhs);
    cg_alu_rr(57, 7, 0);
    gen_cmp_set(setcc);
}

gen_binary(op: BinOp, lhs: *Expr, rhs: *Expr) noregion raises Error {
    match op {
        Add -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v: int = imm_value(rhs);
                if (v != 0) {
                    cg_alu_imm(0, v, 0);
                }
                return;
            }
            if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                v2: int = imm_value(lhs);
                if (v2 != 0) {
                    cg_alu_imm(0, v2, 0);
                }
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(1, 7, 0);
            return;
        }
        Sub -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v3: int = imm_value(rhs);
                if (v3 != 0) {
                    cg_alu_imm(5, v3, 0);
                }
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(41, 7, 0);
            return;
        }
        Mul -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                mv: int = imm_value(rhs);
                if (mv == 0) {
                    cg_mov_imm(0, 0);
                    return;
                }
                if (mv == 1) {
                    return;
                }
                if (mv == 2) {
                    cg_alu_rr(1, 0, 0);
                    return;
                }
                cg_imul_imm(mv, 0);
                return;
            }
            if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                mv2: int = imm_value(lhs);
                if (mv2 == 0) {
                    cg_mov_imm(0, 0);
                    return;
                }
                if (mv2 == 1) {
                    return;
                }
                if (mv2 == 2) {
                    cg_alu_rr(1, 0, 0);
                    return;
                }
                cg_imul_imm(mv2, 0);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_imul_rr(7, 0);
            return;
        }
        Div -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            return;
        }
        Mod -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                cg_mov_rr(2, 0);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            cg_mov_rr(2, 0);
            return;
        }
        Eq -> {
            gen_cmp(lhs, rhs, "sete");
            return;
        }
        Ne -> {
            gen_cmp(lhs, rhs, "setne");
            return;
        }
        Lt -> {
            gen_cmp(lhs, rhs, "setl");
            return;
        }
        Le -> {
            gen_cmp(lhs, rhs, "setle");
            return;
        }
        Gt -> {
            gen_cmp(lhs, rhs, "setg");
            return;
        }
        Ge -> {
            gen_cmp(lhs, rhs, "setge");
            return;
        }
        And -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(4, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(4, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(33, 7, 0);
            }
            return;
        }
        Or -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(1, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(1, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(9, 7, 0);
            }
            return;
        }
        Xor -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(6, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(6, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(49, 7, 0);
            }
            return;
        }
        Shl -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_shift_imm(4, imm_value(rhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_mov_rr(7, 1);
                cg_shift_cl(4, 0);
            }
            return;
        }
        Shr -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_shift_imm(7, imm_value(rhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_mov_rr(7, 1);
                cg_shift_cl(7, 0);
            }
            return;
        }
    }
}

gen_expr(n: *Expr) noregion raises Error {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) {
                cg_lea_rip(cg_name_num(".L.str", k.str_label - 1), 8, 0);
            } else {
                cg_mov_imm(k.val, 0);
            }
            return;
        }
        Null -> {
            cg_mov_imm(0, 0);
            return;
        }
        Var _p -> {
            gen_load(n);
            return;
        }
        MemberAccess _p -> {
            gen_load(n);
            return;
        }
        Addr k -> {
            gen_addr(k.lhs);
            return;
        }
        As k -> {
            gen_expr(k.lhs);
            return;
        }
        Trunc k -> {
            gen_expr(k.lhs);
            return;
        }
        New k -> {
            base: *Type = type_base(n.ty or error("missing type"));
            esz: int = type_size(base);
            if (esz <= 0) {
                esz = 8;
            }
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                fill: ?*Expr = k.fill;
                if (fill == null) {
                    error("new T[n] requires an initial value (new T[n](v))");
                }
                gen_expr(lhs);
                cg_push(12);
                cg_mov_rr(0, 12);
                emit_check_new_count(12, esz);
                gen_expr(fill);
                cg_push(13);
                cg_mov_rr(0, 13);
                cg_mov_rr(12, 0);
                if (esz != 1) {
                    cg_imul_imm(esz, 0);
                }
                cg_alu_imm(0, 8, 0);
                cg_mov_rr(0, 7);
                emit_malloc();
                cg_mov_rm(12, 0, 0);
                cg_alu_imm(0, 8, 0);
                cg_push(3);
                cg_mov_rr(0, 3);
                agg: int = 0;
                if (is_struct_ty(base) || is_enum_ty(base) || is_exn_ty(base)) {
                    agg = 1;
                }
                if (esz == 1) {
                    cg_mov_rr(0, 7);
                    cg_mov_rr(12, 1);
                    cg_mov_rr(13, 0);
                    cg_cld();
                    cg_rep_stosb();
                } else {
                    if (esz == 8) {
                        cg_mov_rr(0, 7);
                        cg_mov_rr(12, 1);
                        if (agg != 0) {
                            cg_mov_mr(13, 0, 0);
                        } else {
                            cg_mov_rr(13, 0);
                        }
                        cg_cld();
                        cg_rep_stosq();
                    } else {
                        cg_mov_rr(0, 9);
                        cg_mov_rr(12, 1);
                        cg_mov_rr(13, 8);
                        loop: int = new_label();
                        done: int = new_label();
                        cg_label_id(loop);
                        cg_alu_imm(7, 0, 1);
                        cg_jump_id(4, done);
                        cg_mov_rr(9, 7);
                        store_array_fill(fill, base);
                        cg_alu_imm(0, esz, 9);
                        cg_alu_imm(5, 1, 1);
                        cg_jump_id(0 - 1, loop);
                        cg_label_id(done);
                    }
                }
                cg_mov_rr(3, 0);
                cg_pop(3);
                cg_pop(13);
                cg_pop(12);
                return;
            }
            cg_mov_imm(esz, 7);
            emit_malloc();
            variant: ?*Variant = k.variant;
            if (variant != null) {
                cg_push(3);
                cg_mov_rr(0, 3);
                cg_mov_imm(k.val, 7);
                cg_mov_rm(7, 0, 0);
                gen_variant_inits(k.inits);
                cg_mov_rr(3, 0);
                cg_pop(3);
            } else {
                if (k.val == 0) {
                    cg_push(3);
                    cg_mov_rr(0, 3);
                    gen_struct_inits(k.inits);
                    cg_mov_rr(3, 0);
                    cg_pop(3);
                }
            }
            return;
        }
        StructLit k -> {
            sz: int = type_size(n.ty or error("missing type"));
            if (sz <= 0) {
                sz = 8;
            }
            sz = sz + 15 & 0 - 16;
            cg_alu_imm(5, sz, 4);
            cg_push(3);
            cg_lea_mr(4, 8, 3);
            gen_struct_inits(k.inits);
            cg_mov_rr(3, 0);
            cg_pop(3);
            return;
        }
        VariantLit k -> {
            sz: int = type_size(n.ty or error("missing type"));
            if (sz <= 0) {
                sz = 8;
            }
            if (sz <= 8) {
                if (k.inits == null) {
                    cg_mov_imm(k.val, 0);
                    return;
                }
                cg_alu_imm(5, 16, 4);
                cg_push(3);
                cg_lea_mr(4, 8, 3);
                cg_mov_imm(k.val, 7);
                cg_mov_rm(7, 3, 0);
                gen_variant_inits(k.inits);
                cg_mov_mr(3, 0, 0);
                cg_pop(3);
                return;
            }
            sz = sz + 15 & 0 - 16;
            cg_alu_imm(5, sz, 4);
            cg_push(3);
            cg_lea_mr(4, 8, 3);
            cg_mov_imm(k.val, 7);
            cg_mov_rm(7, 3, 0);
            gen_variant_inits(k.inits);
            cg_mov_rr(3, 0);
            cg_pop(3);
            return;
        }
        Deref k -> {
            gen_expr(k.lhs);
            load_mem(n.ty or error("missing type"));
            return;
        }
        Index _p -> {
            gen_addr(n);
            load_mem(n.ty or error("missing type"));
            return;
        }
        Assign q -> {
            match q.rhs.kind {
                StructLit k -> {
                    lty: ?*Type = q.lhs.ty;
                    if (lty != null && is_struct_ty(lty)) {
                        gen_addr(q.lhs);
                        cg_push(3);
                        cg_mov_rr(0, 3);
                        gen_struct_inits(k.inits);
                        cg_mov_rr(3, 0);
                        cg_pop(3);
                        return;
                    }
                }
                VariantLit k -> {
                    lty2: ?*Type = q.lhs.ty;
                    if (lty2 != null && is_enum_ty(lty2)) {
                        gen_addr(q.lhs);
                        cg_push(3);
                        cg_mov_rr(0, 3);
                        cg_mov_imm(k.val, 7);
                        cg_mov_rm(7, 0, 0);
                        gen_variant_inits(k.inits);
                        cg_mov_rr(3, 0);
                        cg_pop(3);
                        return;
                    }
                }
                _ -> { }
            }
            lhs_ty: *Type = q.lhs.ty or error("missing lhs type");
            if (!passes_by_ref(lhs_ty) && imm_operand(q.rhs) != 0 && fits_imm32(imm_value(q.rhs))) {
                match q.lhs.kind {
                    Var k -> {
                        vo0: ?*Obj = k.var;
                        if (vo0 != null) {
                            emit_store_imm(vo0, lhs_ty, imm_value(q.rhs));
                            return;
                        }
                    }
                    _ -> { }
                }
            }
            gen_expr(q.rhs);
            if (!passes_by_ref(lhs_ty)) {
                match q.lhs.kind {
                    Var k -> {
                        vo: ?*Obj = k.var;
                        if (vo != null) {
                            emit_store_var(vo, lhs_ty);
                            return;
                        }
                    }
                    _ -> { }
                }
            }
            cg_push(0);
            gen_addr(q.lhs);
            cg_mov_rr(0, 7);
            cg_pop(6);
            if (passes_by_ref(lhs_ty)) {
                emit_memcpy(type_size(lhs_ty));
                cg_mov_rr(7, 0);
            } else {
                cg_mov_rr(6, 0);
                store_mem(lhs_ty);
            }
            return;
        }
        Not k -> {
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_setcc(4);
            cg_movzb_al_rax();
            return;
        }
        Neg k -> {
            gen_expr(k.lhs);
            cg_neg(0);
            nty: ?*Type = n.ty;
            if (nty != null) {
                if (is_i8_ty(nty)) {
                    cg_movzb_al_rax();
                }
            }
            return;
        }
        BitNot k -> {
            gen_expr(k.lhs);
            cg_not(0);
            nty2: ?*Type = n.ty;
            if (nty2 != null) {
                if (is_i8_ty(nty2)) {
                    cg_movzb_al_rax();
                }
            }
            return;
        }
        LogAnd k -> {
            lf: int = new_label();
            le: int = new_label();
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, lf);
            gen_expr(k.rhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, lf);
            cg_mov_imm(1, 0);
            cg_jump_id(0 - 1, le);
            cg_label_id(lf);
            cg_mov_imm(0, 0);
            cg_label_id(le);
            return;
        }
        LogOr k -> {
            lt: int = new_label();
            lf2: int = new_label();
            le2: int = new_label();
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(5, lt);
            gen_expr(k.rhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, lf2);
            cg_label_id(lt);
            cg_mov_imm(1, 0);
            cg_jump_id(0 - 1, le2);
            cg_label_id(lf2);
            cg_mov_imm(0, 0);
            cg_label_id(le2);
            return;
        }
        OrElse k -> {
            end: int = new_label();
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(5, end);
            gen_expr(k.rhs);
            cg_label_id(end);
            return;
        }
        Funcall k -> {
            fno: ?*Function = k.fn;
            has_sret: int = 0;
            if (fno != null) {
                if (fno.sret != null) {
                    has_sret = 1;
                }
            }
            nargs: int = 0;
            a: ?*Expr = k.args;
            while (a != null) {
                nargs = nargs + 1;
                a = a.next;
            }
            nregs: int = nargs + has_sret;
            nstack: int = nregs - 6;
            if (nstack < 0) {
                nstack = 0;
            }
            if (has_sret == 0 && nargs <= 1) {
                a = k.args;
                if (a != null) {
                    if (imm_operand(a) != 0 && fits_imm32(imm_value(a))) {
                        cg_mov_imm(imm_value(a), cg_arg_reg(0));
                    } else {
                        gen_expr(a);
                        cg_mov_rr(0, cg_arg_reg(0));
                    }
                }
                cg_call(k.funcname);
                return;
            }
            /* Sret first, then alignment pad, then incoming slots.
             * After the call, stack args sit above the pad, which sits
             * above the sret buffer, so popping nstack then pad leaves
             * the return value in place. */
            if (has_sret != 0) {
                if (fno == null) {
                    error("missing function");
                }
                sz: int = type_size(fno.return_ty or error("missing return type"));
                if (sz <= 0) {
                    sz = 8;
                }
                sz = sz + 15 & 0 - 16;
                cg_alu_imm(5, sz, 4);
                cg_mov_rr(4, 0);
            }
            call_pad: int = 0;
            if (nstack > 0) {
                if ((cg_rsp_off + 8 * nstack) % 16 != 0) {
                    cg_alu_imm(5, 8, 4);
                    call_pad = 8;
                }
            }
            if (has_sret != 0) {
                cg_push(0);
            }
            a = k.args;
            while (a != null) {
                gen_expr(a);
                cg_push(0);
                a = a.next;
            }
            emit_place_call_regs(nregs);
            if (streq(k.funcname, "memcpy")) {
                emit_memcpy_call();
                return;
            }
            if (streq(k.funcname, "write") || streq(k.funcname, "read")) {
                emit_io_call(k.funcname, k.args);
                return;
            }
            cg_call(k.funcname);
            if (nstack > 0) {
                cg_alu_imm(0, 8 * nstack, 4);
            }
            if (call_pad != 0) {
                cg_alu_imm(0, call_pad, 4);
            }
            return;
        }
        Binary k -> {
            gen_binary(k.op, k.lhs, k.rhs);
            bty: ?*Type = n.ty;
            if (bty != null) {
                if (is_i8_ty(bty)) {
                    cg_movzb_al_rax();
                }
            }
            return;
        }
        If k -> {
            le: int = new_label();
            lelse: int = new_label();
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, lelse);
            gen_expr(k.then);
            cg_jump_id(0 - 1, le);
            cg_label_id(lelse);
            gen_expr(k.els);
            cg_label_id(le);
            return;
        }
        Match k -> {
            gen_match(k.cond, k.arms);
            return;
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                gen_stmt(s);
                s = s.next;
            }
            return;
        }
        Sizeof k -> {
            sty: ?*Type = k.ty;
            if (sty == null) {
                se: ?*Expr = k.e;
                if (se == null) {
                    error("sizeof");
                }
                sty = se.ty;
            }
            cg_mov_imm(type_size(sty or error("sizeof")), 0);
            return;
        }
        _ -> {
            error("invalid expression");
        }
    }
}

gen_match(cond: *Expr, arms: ?*MatchArm) noregion raises Error {
    lend: int = new_label();
    match cond.kind {
        Var _p -> {
            gen_addr(cond);
        }
        MemberAccess _p -> {
            gen_addr(cond);
        }
        Deref _p -> {
            gen_addr(cond);
        }
        _ -> {
            gen_expr(cond);
        }
    }
    cg_push(0);
    cg_mov_mr(0, 0, 0);
    cg_push(0);
    arm: ?*MatchArm = arms;
    while (arm != null) {
        la: int = new_label();
        av: ?*Variant = arm.variant;
        if (av != null) {
            cg_mov_mr(4, 0, 0);
            cg_alu_imm(7, av.tag, 0);
            cg_jump_id(5, la);
        }
        bv: ?*Obj = arm.binder;
        if (bv != null) {
            if (av == null) {
                error("missing variant");
            }
            psz: int = av.payload_size;
            cg_mov_mr(4, 8, 6);
            cg_alu_imm(0, 8, 6);
            cg_lea_mr(5, bv.offset, 7);
            emit_memcpy(psz);
        }
        gen_stmt(arm.body);
        cg_jump_id(0 - 1, lend);
        if (av != null) {
            cg_label_id(la);
        }
        arm = arm.next;
    }
    cg_mov_imm(1, 7);
    cg_call("exit");
    cg_label_id(lend);
    cg_alu_imm(0, 16, 4);
}

gen_stmt(n: *Stmt) noregion raises Error {
    match n.kind {
        Return k -> {
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                gen_expr(lhs);
                sret: ?*Obj = current_sret;
                if (sret != null) {
                    cg_mov_rr(0, 6);
                    cg_mov_mr(5, sret.offset, 7);
                    emit_memcpy(type_size(current_return_ty or error("missing return type")));
                    cg_mov_rr(7, 0);
                }
            } else {
                cg_mov_imm(0, 0);
            }
            rd: int = cg_region_depth;
            while (rd > 0) {
                cg_call("l8_region_pop");
                rd = rd - 1;
            }
            cg_jump_id(0 - 1, current_return_lab);
            return;
        }
        ExprStmt k -> {
            gen_expr(k.lhs);
            return;
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                gen_stmt(s);
                s = s.next;
            }
            return;
        }
        If k -> {
            le: int = new_label();
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            els: ?*Stmt = k.els;
            if (els == null) {
                cg_jump_id(4, le);
                gen_stmt(k.then);
                cg_label_id(le);
                return;
            }
            lelse: int = new_label();
            cg_jump_id(4, lelse);
            gen_stmt(k.then);
            cg_jump_id(0 - 1, le);
            cg_label_id(lelse);
            gen_stmt(els);
            cg_label_id(le);
            return;
        }
        While k -> {
            lb: int = new_label();
            le2: int = new_label();
            cg_label_id(lb);
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, le2);
            gen_stmt(k.body);
            cg_jump_id(0 - 1, lb);
            cg_label_id(le2);
            return;
        }
        For k -> {
            lb3: int = new_label();
            le3: int = new_label();
            hu3: ?*Expr = k.hi;
            if (hu3 != null) {
                gen_expr(k.iter);
                emit_store_var(k.item, ty_int);
                gen_expr(hu3);
                emit_store_var(k.n, ty_int);
                cg_label_id(lb3);
                emit_load_var(k.item, ty_int);
                cg_mov_rr(0, 1);
                emit_load_var(k.n, ty_int);
                cg_alu_rr(57, 0, 1);
                cg_jump_id(13, le3);
                gen_stmt(k.body);
                emit_load_var(k.item, ty_int);
                cg_alu_imm(0, 1, 0);
                emit_store_var(k.item, ty_int);
                cg_jump_id(0 - 1, lb3);
                cg_label_id(le3);
                return;
            }
            co2: ?*Obj = k.coll;
            ix2: ?*Obj = k.idx;
            if (co2 == null || ix2 == null) {
                error("internal: for array missing temps");
            }
            cu2: *Obj = co2;
            iu2: *Obj = ix2;
            sty: *Type = cu2.ty or error("missing type");
            ity: *Type = k.item.ty or error("missing type");
            esz: int = type_size(ity);
            gen_expr(k.iter);
            emit_store_var(cu2, sty);
            emit_store_imm(iu2, ty_int, 0);
            emit_load_var(cu2, sty);
            cg_mov_mr(0, 0 - 8, 0);
            emit_store_var(k.n, ty_int);
            cg_label_id(lb3);
            emit_load_var(iu2, ty_int);
            cg_mov_rr(0, 1);
            emit_load_var(k.n, ty_int);
            cg_alu_rr(57, 0, 1);
            cg_jump_id(3, le3);
            emit_load_var(cu2, sty);
            cg_mov_rr(0, 6);
            emit_load_var(iu2, ty_int);
            cg_mov_rr(0, 1);
            emit_scale_offset(esz);
            if (passes_by_ref(ity)) {
                cg_mov_rr(0, 6);
                cg_lea_mr(5, k.item.offset, 7);
                emit_memcpy(esz);
            } else {
                load_mem(ity);
                emit_store_var(k.item, ity);
            }
            gen_stmt(k.body);
            emit_load_var(iu2, ty_int);
            cg_alu_imm(0, 1, 0);
            emit_store_var(iu2, ty_int);
            cg_jump_id(0 - 1, lb3);
            cg_label_id(le3);
            return;
        }
        Match k -> {
            gen_match(k.cond, k.arms);
            return;
        }
        Raise k -> {
            ex: *ExnDef = k.exn or error("internal");
            if (ex.members != null) {
                esz: int = ex.size;
                if (esz <= 0) {
                    esz = 8;
                }
                cg_mov_imm(esz, 7);
                emit_exc_malloc();
                cg_push(3);
                cg_mov_rr(0, 3);
                gen_struct_inits(k.inits);
                cg_mov_rr(3, 6);
                cg_pop(3);
            } else {
                cg_mov_imm(0, 6);
            }
            cg_mov_imm(ex.tag, 7);
            cg_call("l8_raise");
            return;
        }
        Try k -> {
            lcatch: int = new_label();
            ltryend: int = new_label();
            cg_lea_mr(5, k.buf.offset, 7);
            cg_call("l8_try_begin");
            cg_alu_imm(7, 0, 0);
            cg_jump_id(5, lcatch);
            gen_stmt(k.body);
            cg_call("l8_try_end");
            cg_jump_id(0 - 1, ltryend);
            cg_label_id(lcatch);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                la2: int = new_label();
                ced: *ExnDef = arm2.exn or error("internal");
                cg_mov_rip_r("l8_exc_tag", 0, 0);
                cg_alu_imm(7, ced.tag, 0);
                cg_jump_id(5, la2);
                binder: ?*Obj = arm2.binder;
                if (binder != null) {
                    psz2: int = ced.size;
                    if (psz2 > 0) {
                        cg_mov_rip_r("l8_exc_ptr", 0, 6);
                        cg_lea_mr(5, binder.offset, 7);
                        emit_memcpy(psz2);
                    }
                }
                gen_stmt(arm2.body);
                cg_jump_id(0 - 1, ltryend);
                cg_label_id(la2);
                arm2 = arm2.next;
            }
            cg_mov_rip_r("l8_exc_tag", 0, 7);
            cg_mov_rip_r("l8_exc_ptr", 0, 6);
            cg_call("l8_raise");
            cg_label_id(ltryend);
            return;
        }
        Region k -> {
            cg_call("l8_heap_mark");
            emit_store_var(k.mark, ty_int);
            emit_load_var(k.mark, ty_int);
            cg_mov_rr(0, cg_arg_reg(0));
            cg_call("l8_region_push");
            cg_region_depth = cg_region_depth + 1;
            gen_stmt(k.body);
            cg_region_depth = cg_region_depth - 1;
            cg_call("l8_region_pop");
            return;
        }
        Comment _c -> {
            return;
        }
        Decl k -> {
            vo: ?*Obj = k.var;
            init: ?*Expr = k.init;
            if (init != null && vo != null) {
                ae: *Expr = new_assign(new_var_node(vo), init);
                gen_expr(ae);
            }
            return;
        }
        _ -> {
            error("invalid statement");
        }
    }
}

emit_reverse_stack(n: int) noregion {
    if (n <= 1) {
        return;
    }
    l: int = 0;
    r: int = n - 1;
    while (l < r) {
        cg_mov_mr(4, 8 * l, 10);
        cg_mov_mr(4, 8 * r, 0);
        cg_mov_rm(0, 4, 8 * l);
        cg_mov_rm(10, 4, 8 * r);
        l = l + 1;
        r = r - 1;
    }
}

emit_place_call_regs(nslots: int) noregion {
    if (nslots <= 6) {
        i: int = nslots - 1;
        while (i >= 0) {
            cg_pop(cg_arg_reg(i));
            i = i - 1;
        }
        return;
    }
    emit_reverse_stack(nslots);
    i2: int = 0;
    while (i2 < 6) {
        cg_pop(cg_arg_reg(i2));
        i2 = i2 + 1;
    }
}

emit_store_incoming(slot: int, dest_off: int) noregion {
    if (slot < 6) {
        cg_mov_rm(cg_arg_reg(slot), 5, dest_off);
        return;
    }
    cg_mov_mr(5, 16 + 8 * (slot - 6), 0);
    cg_mov_rm(0, 5, dest_off);
}

assign_lvar_offsets(fn: *Function) raises Error {
    off: int = 0;
    v: ?*Obj = fn.locals;
    while (v != null) {
        vty: *Type = v.ty or error("missing local type");
        sz: int = type_size(vty);
        if (sz <= 0) {
            sz = 8;
        }
        if (sz < 8) {
            sz = 8;
        }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 7) / 16 * 16 + 8;
}

emit_global_init(g: *Obj) noregion raises Error {
    init: *Expr = g.init or error("missing global initializer");
    gty: *Type = g.ty or error("missing global type");
    sz: int = type_size(gty);
    if (sz <= 0) {
        sz = 8;
    }
    v: int = const_value(init);
    cg_label(g.name);
    if (sz > 8) {
        error("global initializer must be a scalar constant");
    }
    cg_quad(v);
}

emit_bss_global(g: *Obj) noregion {
    sz: int = 8;
    gty: ?*Type = g.ty;
    if (gty != null) {
        sz = type_size(gty);
    }
    if (sz <= 0) {
        sz = 8;
    }
    if (gty != null && sz < 8) {
        sz = 8;
    }
    cg_label(g.name);
    cg_skip(sz);
}

emit_data() noregion raises Error {
    g: ?*Obj = globals;
    any_data: int = 0;
    while (g != null) {
        if (g.is_func == 0 && is_const_init(g.init)) {
            if (any_data == 0) {
                cg_section(as_SEC_DATA);
                cg_align(8);
                any_data = 1;
            }
            emit_global_init(g);
        }
        g = g.next;
    }
    g = globals;
    any_bss: int = 0;
    while (g != null) {
        if (g.is_func == 0 && !is_const_init(g.init)) {
            if (any_bss == 0) {
                cg_section(as_SEC_BSS);
                cg_align(8);
                any_bss = 1;
            }
            emit_bss_global(g);
        }
        g = g.next;
    }
    if (any_bss == 0) {
        cg_section(as_SEC_BSS);
        cg_align(8);
    }
    cg_global("l8_init_done");
    cg_label("l8_init_done");
    cg_skip(8);
    cg_section(as_SEC_RODATA);
    cg_align(8);
    s: ?*StrLit = str_lits;
    while (s != null) {
        cg_label(cg_name_num(".L.str", s.label));
        cg_quad(s.len);
        cg_bytes(s.data, 0, s.len);
        s = s.next;
    }
}

emit_dyn_global_inits(g: ?*Obj) noregion raises Error {
    if (g == null) {
        return;
    }
    emit_dyn_global_inits(g.next);
    if (g.is_func != 0) {
        return;
    }
    init: ?*Expr = g.init;
    if (is_const_init(init)) {
        return;
    }
    e: *Expr = init or error("missing global initializer");
    ty: *Type = g.ty or error("missing global type");
    gen_expr(e);
    emit_store_var(g, ty);
}

emit_l8_init_globals_fn() noregion raises Error {
    already: int = new_label();
    cg_global("l8_init_globals");
    cg_label("l8_init_globals");
    cg_rsp_off = 0;
    cg_push(5);
    cg_mov_rr(4, 5);
    cg_mov_rip_r("l8_init_done", 0, 0);
    cg_alu_imm(7, 0, 0);
    cg_jump_id(5, already);
    cg_mov_imm(1, 0);
    cg_mov_r_rip(0, "l8_init_done", 0);
    emit_dyn_global_inits(globals);
    cg_label_id(already);
    cg_mov_rr(5, 4);
    cg_pop(5);
    cg_ret();
}

emit_text() noregion raises Error {
    fn: ?*Function = functions;
    cg_section(as_SEC_TEXT);
    oob_lab = new_label();
    emit_l8_init_globals_fn();
    while (fn != null) {
        if (fn.is_extern == 0) {
            narrow_top = null;
            catch_top = null;
            assign_lvar_offsets(fn);
            current_fn_name = fn.name;
            current_return_ty = fn.return_ty;
            current_sret = fn.sret;
            current_fn = fn;
            current_return_lab = new_label();
            cg_region_depth = 0;
            cg_global(fn.name);
            cg_label(fn.name);
            cg_rsp_off = 0;
            cg_push(5);
            cg_mov_rr(4, 5);
            cg_alu_imm(5, fn.stack_size, 4);
            ri: int = 0;
            sret: ?*Obj = fn.sret;
            if (sret != null) {
                emit_store_incoming(ri, sret.offset);
                ri = ri + 1;
            }
            /* Spill incoming args first; by-ref memcpy clobbers %rsi/%rdi/%rax. */
            base_ri: int = ri;
            i: int = 0;
            while (i < fn.nparams) {
                po: ?*Obj = fn_param(fn, i);
                if (po == null) {
                    error("null obj");
                }
                p: *Obj = po;
                emit_store_incoming(ri, p.offset);
                ri = ri + 1;
                i = i + 1;
            }
            ri = base_ri;
            i = 0;
            while (i < fn.nparams) {
                po2: ?*Obj = fn_param(fn, i);
                if (po2 == null) {
                    error("null obj");
                }
                p2: *Obj = po2;
                pty: ?*Type = p2.ty;
                if (pty == null) {
                    error("missing param type");
                }
                if (passes_by_ref(pty)) {
                    cg_mov_mr(5, p2.offset, 6);
                    cg_lea_mr(5, p2.offset, 7);
                    emit_memcpy(type_size(pty));
                }
                ri = ri + 1;
                i = i + 1;
            }
            if (streq(fn.name, "main")) {
                cg_call("l8_init_globals");
            }
            body: ?*Stmt = fn.body;
            if (body == null) {
                error("missing body");
            }
            gen_stmt(body);
            sret2: ?*Obj = current_sret;
            if (sret2 != null) {
                cg_mov_rr(0, 6);
                cg_mov_mr(5, sret2.offset, 7);
                emit_memcpy(type_size(current_return_ty or error("missing return type")));
                cg_mov_rr(7, 0);
            }
            cg_label_id(current_return_lab);
            cg_mov_rr(5, 4);
            cg_pop(5);
            cg_ret();
        }
        fn = fn.next;
    }
    cg_label_id(oob_lab);
    emit_exit1();
}

codegen() noregion raises Error {
    emit_data();
    emit_text();
    if (cg_direct_mode == 0) {
        emit_flush();
    }
}

profile_t0: int = 0;

profile_prev: int = 0;

profile_cyc0: int = 0;

profile_cyc_prev: int = 0;

profile_flt0: int = 0;

profile_flt_prev: int = 0;

profile_rbuf: []i8 = "";

rd_u64(b: []i8, o: int): int {
    (b[o] as int & 255) + ((b[o + 1] as int & 255) << 8) + ((b[o + 2] as int & 255) << 16) + ((b[o + 3] as int & 255) << 24) + ((b[o + 4] as int & 255) << 32) + ((b[o + 5] as int & 255) << 40) + ((b[o + 6] as int & 255) << 48) + ((b[o + 7] as int & 255) << 56);
}

profile_faults(): int {
    getrusage(profile_rbuf);
    rd_u64(profile_rbuf, 64);
}

profile_rss_kb(): int {
    rd_u64(profile_rbuf, 32);
}

profile_print(
    label: []i8,
    dt_ns: int,
    dt_cyc: int,
    dt_flt: int
) {
    write(2, "profile: ", len("profile: "));
    write(2, label, len(label));
    write(2, " ", len(" "));
    ms: int = dt_ns / 1000000;
    us: int = dt_ns / 1000 % 1000;
    emit_num_fd(2, ms);
    write(2, ".", len("."));
    if (us < 100) {
        write(2, "0", len("0"));
    }
    if (us < 10) {
        write(2, "0", len("0"));
    }
    emit_num_fd(2, us);
    write(2, " ms  ", len(" ms  "));
    emit_num_fd(2, dt_cyc);
    write(2, " cyc  ", len(" cyc  "));
    emit_num_fd(2, dt_flt);
    write(2, " flt\n", len(" flt\n"));
}

profile_start() noregion {
    if (do_profile == 0) {
        return;
    }
    profile_rbuf = new i8[256](0i8);
    profile_t0 = mono_ns();
    profile_prev = profile_t0;
    profile_cyc0 = rdtsc();
    profile_cyc_prev = profile_cyc0;
    profile_flt0 = profile_faults();
    profile_flt_prev = profile_flt0;
}

profile_mark(label: []i8) {
    if (do_profile == 0) {
        return;
    }
    t: int = mono_ns();
    c: int = rdtsc();
    profile_print(label, t - profile_prev, c - profile_cyc_prev, 0);
    profile_prev = t;
    profile_cyc_prev = c;
}

profile_end() {
    if (do_profile == 0) {
        return;
    }
    profile_print("TOTAL", profile_prev - profile_t0, profile_cyc_prev - profile_cyc0,
        profile_flt_prev - profile_flt0);
    write(2, "profile: rss ", len("profile: rss "));
    emit_num_fd(2, profile_rss_kb());
    write(2, " kb\n", len(" kb\n"));
}

is_profile_flag(s: [z]i8): bool {
    if (s[0] == '-' && s[1] == 'p' && s[2] == 0i8) {
        return true;
    }
    if (s[0] == '-' && s[1] == '-' && s[2] == 'p' && s[3] == 'r' && s[4] == 'o' && s[5] == 'f' && s[6] == 'i' && s[7] == 'l' && s[8] == 'e' && s[9] == 0i8) {
        return true;
    }
    false;
}

compiler_analyze(src_path: []i8@immortal) noregion raises Error {
    profile_start();
    as_init();
    init_runtime();
    init_dummies();
    profile_mark("init");
    source = "";
    source_len = 0;
    source_path = src_path;
    tok = token_eof;
    parse_program(src_path);
    profile_mark("load_parse");
    typecheck_program();
    profile_mark("typecheck");
    check_unused_functions();
    profile_mark("unused_fns");
    check_unused_locals();
    profile_mark("unused_locals");
    check_return_style();
    check_raises_functions();
    check_imm_heap_functions();
    check_written_bounds();
    profile_mark("raises");
    check_noreturn_functions();
    profile_mark("noreturn");
}

compiler_frontend(src_path: []i8@immortal) noregion raises Error {
    compiler_analyze(src_path);
    codegen();
    profile_mark("codegen");
}

compiler_build_direct(src_path: []i8@immortal) noregion: int {
    try {
        cg_direct_mode = 1;
        compiler_frontend(src_path);
        as_assemble_file_append("runtime.s");
        profile_mark("runtime");
        0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1;
    }
}

compiler_main(argc: int, argv: [][z]i8) noregion: int {
    try {
        cg_direct_mode = 0;
        do_profile = 0;
        have: int = 0;
        if (argc < 1) {
            write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n", len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
            return 1;
        }
        path: [z]i8 = argv[0];
        ai: int = 1;
        while (ai < argc) {
            arg: [z]i8 = argv[ai];
            if (is_profile_flag(arg)) {
                do_profile = 1;
            } else {
                if (have != 0) {
                    write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n",
                        len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
                    return 1;
                }
                path = arg;
                have = 1;
            }
            ai = ai + 1;
        }
        if (have == 0) {
            write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n", len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
            return 1;
        }
        compiler_frontend(zslice(path));
        profile_end();
        0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1;
    }
}
