// L8 self-hosted compiler → x86-64 Linux GAS
// Nominal AST; Type is a sum; Expr/Stmt are typed envelopes.
// Heap ADTs via new; aggregates by sret; *T vs ?*T with flow narrowing; `e or alt` unwraps ?*T.
// Byte literals: 'A' and Ni8 (0..255); i8 arithmetic wraps, no mixed promotion.
// *T is one object: p.* only, no p[i]. []T is a thin pointer with len at -8.
// [z]T is a C-string; s[i] only if walked from 0. &s[i] on [z]T stays [z]T.
// A span of an existing []T is the array plus a start index, not a [n]T view.
// Globals: `name: type = const` writes .data; bare `name: type;` stays BSS.
// Bitwise: `~ & ^ | << >>` on int/i8 (same type; >> is arithmetic; shift count is int).
// `if`/`match`/`{ }` are expressions; a block's last statement is its value (`;` does not discard).
// Function body uses that rule when a return type is declared; last-statement and `return` share assignable.
// `return expr` in tail position and ignored values in returning functions are warnings.
// Semicolon after statements and non-brace decls; not after `}`.
// noreturn return type; checked exceptions (exception/raises/raise/try/with).
// Pipeline: parse → typecheck → unused fn/local + raises/noreturn checks → codegen.
// This compiler reports failures via `exception Error` (caught in main).

type Type =
    | Int
    | I8
    | Bool
    | Noreturn
    | Ptr { base: *Type; }
    | OptPtr { base: *Type; }
    | Array { base: *Type; len: int; }
    | Slice { base: *Type; }
    | ZPtr { base: *Type; }
    | View { base: *Type; bound: *i8; }
    | Record { def: *StructDef; }
    | Enum { def: *EnumDef; }
    | Exn { def: *ExnDef; };

type Member = {
    name: *i8;
    offset: int;
    ty: *Type;
    next: ?*Member;
}

type StructDef = {
    name: *i8;
    members: ?*Member;
    size: int;
    ty: ?*Type;
    next: ?*StructDef;
    hash_next: ?*StructDef;
}

type Variant = {
    name: *i8;
    tag: int;
    fields: ?*Member;
    payload_ty: ?*Type;
    payload_size: int;
    next: ?*Variant;
}

type EnumDef = {
    name: *i8;
    variants: ?*Variant;
    size: int;
    ty: ?*Type;
    next: ?*EnumDef;
    hash_next: ?*EnumDef;
}

type ExnDef = {
    name: *i8;
    tag: int;
    members: ?*Member;
    size: int;
    ty: ?*Type;
    next: ?*ExnDef;
    hash_next: ?*ExnDef;
}

type ExnList = {
    exn: *ExnDef;
    seen: int;
    next: ?*ExnList;
}

type ImportedFile = {
    path: *i8;
    next: ?*ImportedFile;
}

type TokKind =
    | Eof
    | Num
    | Char
    | Str
    | Ident
    | Int
    | I8
    | Bool
    | True
    | False
    | Null
    | Noreturn
    | If
    | Else
    | While
    | Return
    | TypeKw
    | Sizeof
    | Uninitialized
    | As
    | Trunc
    | New
    | Eq
    | Ne
    | Le
    | Ge
    | Shl
    | Shr
    | Caret
    | Tilde
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | Lt
    | Gt
    | Assign
    | Not
    | Amp
    | LParen
    | RParen
    | LBrace
    | RBrace
    | LBrack
    | RBrack
    | Semi
    | Comma
    | Colon
    | And
    | Or
    | OrKw
    | Dot
    | Match
    | Pipe
    | Arrow
    | Question
    | Exception
    | Raises
    | Raise
    | Try
    | With
    | Import;

type Token = {
    kind: TokKind;
    val: int;
    str: *i8;
    len: int;
    pos: int;
    next: *Token;
}

type FieldInit = {
    member: *Member;
    lhs: ?*Expr;
    next: ?*FieldInit;
}

type MatchArm = {
    variant: ?*Variant;
    binder: ?*Obj;
    body: *Stmt;
    next: ?*MatchArm;
}

type CatchArm = {
    exn: *ExnDef;
    binder: ?*Obj;
    body: *Stmt;
    next: ?*CatchArm;
}

type BinOp =
    | Add
    | Sub
    | Mul
    | Div
    | Mod
    | Shl
    | Shr
    | And
    | Xor
    | Or
    | Eq
    | Ne
    | Lt
    | Le
    | Gt
    | Ge;

type ExprKind =
    | Num { val: int; str_label: int; }
    | Null
    | Var { var: ?*Obj; name: ?*i8; member: ?*Member; }
    | Binary { op: BinOp; lhs: *Expr; rhs: *Expr; }
    | Assign { lhs: *Expr; rhs: *Expr; }
    | Addr { lhs: *Expr; }
    | Deref { lhs: *Expr; }
    | Index { lhs: *Expr; idx: *Expr; }
    | Not { lhs: *Expr; }
    | Neg { lhs: *Expr; }
    | BitNot { lhs: *Expr; }
    | LogAnd { lhs: *Expr; rhs: *Expr; }
    | LogOr { lhs: *Expr; rhs: *Expr; }
    | OrElse { lhs: *Expr; rhs: *Expr; }
    | Funcall { funcname: *i8; args: ?*Expr; fn: ?*Function; }
    | MemberAccess { lhs: *Expr; member: *Member; }
    | As { lhs: *Expr; }
    | Trunc { lhs: *Expr; }
    | New { lhs: ?*Expr; val: int; inits: ?*FieldInit; variant: ?*Variant; }
    | StructLit { inits: ?*FieldInit; }
    | VariantLit { variant: *Variant; val: int; inits: ?*FieldInit; }
    | If { cond: *Expr; then: *Expr; els: *Expr; }
    | Match { cond: *Expr; arms: ?*MatchArm; }
    | Block { body: ?*Stmt; };

type Expr = {
    kind: ExprKind;
    next: ?*Expr;
    ty: ?*Type;
}

type StmtKind =
    | Return { lhs: ?*Expr; }
    | If { cond: *Expr; then: *Stmt; els: ?*Stmt; }
    | While { cond: *Expr; body: *Stmt; }
    | Block { body: ?*Stmt; }
    | ExprStmt { lhs: *Expr; }
    | Match { cond: *Expr; arms: ?*MatchArm; }
    | Raise { exn: *ExnDef; inits: ?*FieldInit; }
    | Try { body: *Stmt; arms: ?*CatchArm; buf: *Obj; };

type Stmt = {
    kind: StmtKind;
    next: ?*Stmt;
}

type Obj = {
    name: *i8;
    is_local: int;
    is_func: int;
    offset: int;
    scope_depth: int;
    ty: ?*Type;
    used: int;
    init: ?*Expr;
    next: ?*Obj;
    param_next: ?*Obj;
    hash_next: ?*Obj;
}

type Function = {
    name: *i8;
    nparams: int;
    params: ?*Obj;
    locals: ?*Obj;
    body: ?*Stmt;
    stack_size: int;
    return_ty: ?*Type;
    sret: ?*Obj;
    raises_list: ?*ExnList;
    used: int;
    next: ?*Function;
    hash_next: ?*Function;
}

type FnBucket = { head: ?*Function; }
type ObjBucket = { head: ?*Obj; }
type StructBucket = { head: ?*StructDef; }
type EnumBucket = { head: ?*EnumDef; }
type ExnBucket = { head: ?*ExnDef; }

type StrLit = {
    data: *i8;
    len: int;
    label: int;
    next: ?*StrLit;
}

type InternEnt = { s: *i8; n: int; next: ?*InternEnt; }
type InternBucket = { head: ?*InternEnt; }
type TyEnt = { base: *Type; ty: *Type; next: ?*TyEnt; }

source: []i8; source_len: int; pos: int;
source_path: *i8;
tok: *Token;
globals: ?*Obj;
locals: ?*Obj;
scope_depth: int;
functions: ?*Function;
function_tail: ?*Function;
imported_files: ?*ImportedFile;
struct_defs: ?*StructDef;
enum_defs: ?*EnumDef;
exn_defs: ?*ExnDef;
SYM_SIZE: int = 1024;
fn_buckets: []FnBucket;
global_buckets: []ObjBucket;
struct_buckets: []StructBucket;
enum_buckets: []EnumBucket;
exn_buckets: []ExnBucket;
tok_pool: []Token;
tok_pool_i: int;
tok_pool_n: int;
expr_pool: []Expr;
expr_pool_i: int;
expr_pool_n: int;
stmt_pool: []Stmt;
stmt_pool_i: int;
stmt_pool_n: int;
intern_buckets: []InternBucket;
ptr_cache: ?*TyEnt;
opt_ptr_cache: ?*TyEnt;
slice_cache: ?*TyEnt;
zptr_cache: ?*TyEnt;
type ViewEnt = { base: *Type; bound: *i8; ty: *Type; next: ?*ViewEnt; }
view_cache: ?*ViewEnt;
oob_lab: int;
next_exn_tag: int;
field_list_size: int;
ty_int: *Type;
ty_i8: *Type;
ty_bool: *Type;
ty_noreturn: *Type;
str_lits: ?*StrLit;
str_lit_tail: ?*StrLit;
str_count: int;
label_id: int;
emit_buf: []i8;
emit_len: int;
emit_cap: int = 65536;
do_profile: int;
current_fn_name: ?*i8;
current_return_lab: int;
current_return_ty: ?*Type;
current_sret: ?*Obj;
current_fn: ?*Function;
type NarrowFrame = {
    var: ?*Obj;
    ty: ?*Type;
    next: ?*NarrowFrame;
}

narrow_top: ?*NarrowFrame;

type WalkFrame = {
    str: ?*Obj;
    hi: int;
    cursor: ?*Obj;
    next: ?*WalkFrame;
}

walk_top: ?*WalkFrame;
zero_top: ?*WalkFrame;

type CatchFrame = {
    exn: *ExnDef;
    next: ?*CatchFrame;
}

catch_top: ?*CatchFrame;

L8_JMP_BUF_SIZE: int = 72;

exception Error { msg: *i8; pos: int; path: *i8; src: *i8; src_len: int; }

streq_n(a: []i8, ai: int, b: []i8, bi: int, n: int): bool {
    i: int = 0;
    while (i < n) {
        if (a[ai + i] != b[bi + i]) { return false; }
        i = i + 1;
    }
    true;
}

streq(a: [z]i8, b: [z]i8): bool {
    if (a == b) { return true; }
    i: int = 0;
    while (true) {
        if (a[i] != b[i]) { return false; }
        if (a[i] == 0i8) { return true; }
        i = i + 1;
    }
    false;
}

cstr_len(s: [z]i8): int {
    n: int = 0;
    while (s[n] != 0i8) { n = n + 1; }
    n;
}

name_eq_span(name: *i8, s: []i8, off: int, n: int): bool {
    if (len(name) != n) { false; }
    else { streq_n(name as []i8, 0, s, off, n); }
}

hash_n(s: []i8, off: int, n: int): int {
    h: int = 5381;
    i: int = 0;
    while (i < n) {
        h = h * 33 + (s[off + i] as int);
        i = i + 1;
    }
    h;
}

hash_str(s: *i8): int { hash_n(s as []i8, 0, len(s)); }

sym_bucket(h: int): int {
    if (h < 0) { h = 0 - h; }
    h & (SYM_SIZE - 1);
}

clear_sym_tables() {
    i: int = 0;
    while (i < SYM_SIZE) {
        fn_buckets[i].head = null;
        global_buckets[i].head = null;
        struct_buckets[i].head = null;
        enum_buckets[i].head = null;
        exn_buckets[i].head = null;
        i = i + 1;
    }
}

memcpy(dst: []i8, di: int, src: []i8, si: int, n: int) {
    i: int = 0;
    while (i + 8 <= n) {
        d: *int = (&dst[di + i]) as *int;
        s: *int = (&src[si + i]) as *int;
        d.* = s.*;
        i = i + 8;
    }
    while (i < n) {
        dst[di + i] = src[si + i];
        i = i + 1;
    }
}

strdup_n(s: []i8, off: int, n: int): *i8 {
    raw: []i8 = new i8[n + 16];
    p: *int = raw as *int;
    p.* = n;
    memcpy(raw, 8, s, off, n);
    raw[8 + n] = 0i8;
    &raw[8];
}

emit_flush() {
    if (emit_len > 0) {
        write(1, emit_buf, emit_len);
        emit_len = 0;
    }
}

emit(s: [z]i8) {
    n: int = 0;
    while (s[n] != 0i8) { n = n + 1; }
    if (n <= 0) { return; }
    if (n > emit_cap) {
        emit_flush();
        write(1, s, n);
        return;
    }
    if (emit_len + n > emit_cap) { emit_flush(); }
    i: int = 0;
    while (s[i] != 0i8) {
        emit_buf[emit_len + i] = s[i];
        i = i + 1;
    }
    emit_len = emit_len + n;
}

emit_ch(c: i8) {
    if (emit_len >= emit_cap) { emit_flush(); }
    emit_buf[emit_len] = c;
    emit_len = emit_len + 1;
}

emit_num(n: int) {
    buf: []i8 = new i8[32];
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        emit_ch('0');
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = '0' + (n % 10) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    need: int = i + neg;
    if (emit_len + need > emit_cap) { emit_flush(); }
    if (neg != 0) {
        emit_buf[emit_len] = '-';
        emit_len = emit_len + 1;
    }
    while (i > 0) {
        i = i - 1;
        emit_buf[emit_len] = buf[i];
        emit_len = emit_len + 1;
    }
}

error(msg: *i8) raises Error: noreturn {
    raise Error { msg: msg, pos: tok.pos, path: source_path, src: source, src_len: source_len };
}

error_at(p: int, msg: *i8) raises Error: noreturn {
    raise Error { msg: msg, pos: p, path: source_path, src: source, src_len: source_len };
}

print_error_at(path: *i8, src: []i8, src_len: int, pos: int, msg: *i8) {
    line: int = 1;
    col: int = 1;
    i: int = 0;
    while (i < pos && i < src_len) {
        if (src[i] == '\n') {
            line = line + 1;
            col = 1;
        } else { col = col + 1; }
        i = i + 1;
    }
    write(2, "error: ", len("error: "));
    write(2, path, cstr_len(path));
    write(2, ":", len(":"));
    emit_num_fd(2, line);
    write(2, ":", len(":"));
    emit_num_fd(2, col);
    write(2, ": ", len(": "));
    write(2, msg, len(msg));
    write(2, "\n", len("\n"));
}

warn_unused_function(name: *i8) {
    write(2, "warning: unused function ", len("warning: unused function "));
    write(2, name, len(name));
    write(2, "\n", len("\n"));
}

warn_unused_local(fn_name: *i8, name: *i8) {
    write(2, "warning: unused local ", len("warning: unused local "));
    write(2, name, len(name));
    write(2, " in ", len(" in "));
    write(2, fn_name, len(fn_name));
    write(2, "\n", len("\n"));
}

warn_unnecessary_return(fn_name: *i8) {
    write(2, "warning: unnecessary return in ", len("warning: unnecessary return in "));
    write(2, fn_name, len(fn_name));
    write(2, "\n", len("\n"));
}

warn_ignored_value(fn_name: *i8) {
    write(2, "warning: ignored return value in ", len("warning: ignored return value in "));
    write(2, fn_name, len(fn_name));
    write(2, "\n", len("\n"));
}

ignore_unused_local_name(name: [z]i8): bool {
    c: i8 = name[0];
    c == '.' || c == '_';
}

type StrBuf = {
    data: []i8;
    len: int;
    cap: int;
}

sb_new(): *StrBuf {
    new StrBuf {
        data: new i8[64],
        len: 0,
        cap: 64
    };
}

sb_grow(sb: *StrBuf, need: int) {
    if (sb.len + need <= sb.cap) { return; }
    ncap: int = sb.cap;
    while (ncap < sb.len + need) {
        ncap = ncap * 2;
    }
    nd: []i8 = new i8[ncap];
    memcpy(nd, 0, sb.data, 0, sb.len);
    sb.data = nd;
    sb.cap = ncap;
}

sb_putc(sb: *StrBuf, c: i8) {
    sb_grow(sb, 1);
    sb.data[sb.len] = c;
    sb.len = sb.len + 1;
}

sb_puts(sb: *StrBuf, s: *i8) {
    n: int = len(s);
    sb_grow(sb, n);
    memcpy(sb.data, sb.len, s as []i8, 0, n);
    sb.len = sb.len + n;
}

sb_put_num(sb: *StrBuf, n: int) {
    if (n < 0) {
        sb_putc(sb, '-');
        n = 0 - n;
    }
    if (n == 0) {
        sb_putc(sb, '0');
        return;
    }
    buf: []i8 = new i8[32];
    i: int = 0;
    while (n > 0) {
        buf[i] = '0' + (n % 10) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    while (i > 0) {
        i = i - 1;
        sb_putc(sb, buf[i]);
    }
}

sb_finish(sb: *StrBuf): *i8 { strdup_n(sb.data, 0, sb.len); }

append_type(sb: *StrBuf, t: ?*Type) raises Error {
    if (t == null) {
        sb_puts(sb, "<unknown>");
        return;
    }
    match t.* {
        Int -> { sb_puts(sb, "int"); return; }
        I8 -> { sb_puts(sb, "i8"); return; }
        Bool -> { sb_puts(sb, "bool"); return; }
        Noreturn -> { sb_puts(sb, "noreturn"); return; }
        Ptr k -> {
            sb_putc(sb, '*');
            append_type(sb, k.base);
            return;
        }
        OptPtr k -> {
            sb_puts(sb, "?*");
            append_type(sb, k.base);
            return;
        }
        Array k -> {
            sb_putc(sb, '[');
            sb_put_num(sb, k.len);
            sb_putc(sb, ']');
            append_type(sb, k.base);
            return;
        }
        Slice k -> {
            sb_puts(sb, "[]");
            append_type(sb, k.base);
            return;
        }
        ZPtr k -> {
            sb_puts(sb, "[z]");
            append_type(sb, k.base);
            return;
        }
        View k -> {
            sb_putc(sb, '[');
            sb_puts(sb, k.bound);
            sb_putc(sb, ']');
            append_type(sb, k.base);
            return;
        }
        Record k -> { sb_puts(sb, k.def.name); return; }
        Enum k -> { sb_puts(sb, k.def.name); return; }
        Exn k -> { sb_puts(sb, k.def.name); return; }
    }
}

error_ty(msg: *i8, t: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": ");
    append_type(sb, t);
    error(sb_finish(sb));
}

error_ty_vs(msg: *i8, a: ?*Type, b: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": ");
    append_type(sb, a);
    sb_puts(sb, " vs ");
    append_type(sb, b);
    error(sb_finish(sb));
}

error_have_want(msg: *i8, have: ?*Type, want: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_type(sb, have);
    sb_puts(sb, ", want ");
    append_type(sb, want);
    error(sb_finish(sb));
}

error_have_and(msg: *i8, a: ?*Type, b: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_type(sb, a);
    sb_puts(sb, " and ");
    append_type(sb, b);
    error(sb_finish(sb));
}

append_expr_ty(sb: *StrBuf, e: ?*Expr) raises Error {
    if (e == null) {
        append_type(sb, null);
        return;
    }
    if (e.ty != null) {
        append_type(sb, decay(e.ty));
        return;
    }
    if (is_null_expr(e)) {
        sb_puts(sb, "null");
        return;
    }
    append_type(sb, null);
}

error_have_expr_want(msg: *i8, have: ?*Expr, want: ?*Type) raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_expr_ty(sb, have);
    sb_puts(sb, ", want ");
    append_type(sb, want);
    error(sb_finish(sb));
}

emit_num_fd(fd: int, n: int) {
    buf: []i8 = new i8[32];
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        z: i8 = '0';
        write(fd, &z, 1);
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = '0' + (n % 10) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    if (neg != 0) {
        m: i8 = '-';
        write(fd, &m, 1);
    }
    while (i > 0) {
        i = i - 1;
        ch: i8 = buf[i];
        write(fd, &ch, 1);
    }
}

token_eof: *Token;

init_dummies() {
    token_eof = new Token {
        kind: TokKind.Eof,
        val: 0,
        str: "",
        len: 0,
        pos: 0,
        next: uninitialized
    };
    token_eof.next = token_eof;
}

init_runtime() {
    ty_int = new Type.Int;
    ty_i8 = new Type.I8;
    ty_bool = new Type.Bool;
    ty_noreturn = new Type.Noreturn;
    exn_defs = null;
    next_exn_tag = 1;
    catch_top = null;
    current_fn = null;
    emit_buf = new i8[emit_cap];
    emit_len = 0;
    fn_buckets = new FnBucket[1024];
    global_buckets = new ObjBucket[1024];
    struct_buckets = new StructBucket[1024];
    enum_buckets = new EnumBucket[1024];
    exn_buckets = new ExnBucket[1024];
    intern_buckets = new InternBucket[4096];
    i: int = 0;
    while (i < 4096) {
        intern_buckets[i].head = null;
        i = i + 1;
    }
    ptr_cache = null;
    opt_ptr_cache = null;
    slice_cache = null;
    zptr_cache = null;
    view_cache = null;
    walk_top = null;
    zero_top = null;
    cg_labbuf = new i8[64];
    str_lits = null;
    str_lit_tail = null;
    str_count = 0;
    clear_sym_tables();
}

read_file(path: *i8) raises Error: []i8 {
    fd: int = open(path, 0, 0);
    if (fd < 0) { error("cannot open file"); }
    cap: int = 65536;
    buf: []i8 = new i8[cap];
    n: int = 0;
    while (true) {
        if (n + 65536 > cap) {
            cap = cap * 2;
            tmp: []i8 = new i8[cap];
            memcpy(tmp, 0, buf, 0, n);
            buf = tmp;
        }
        r: int = read(fd, &buf[n], 65536);
        if (r <= 0) {
            buf[n] = 0i8;
            close(fd);
            source_len = n;
            return buf;
        }
        n = n + r;
    }
    buf;
}

normalize_path(path: [z]i8): *i8 {
    p: []i8 = zslice(path);
    n: int = len(p);
    out: []i8 = new i8[n + 2];
    starts: []int = new int[n + 1];
    out_len: int = 0;
    nseg: int = 0;
    absolute: bool = n > 0 && p[0] == '/';
    if (absolute) {
        out[0] = '/';
        out_len = 1;
    }
    i: int = 0;
    while (i < n) {
        while (i < n && p[i] == '/') { i = i + 1; }
        if (i >= n) {
            i = n;
        } else {
            start: int = i;
            while (i < n && p[i] != '/') { i = i + 1; }
            part_len: int = i - start;
            is_dot: bool = part_len == 1 && p[start] == '.';
            is_dotdot: bool = part_len == 2 && p[start] == '.' && p[start + 1] == '.';
            if (is_dot) {
                /* nothing */
            } else if (is_dotdot && nseg > 0) {
                nseg = nseg - 1;
                out_len = starts[nseg];
            } else {
                starts[nseg] = out_len;
                nseg = nseg + 1;
                if (out_len > 0 && out[out_len - 1] != '/') {
                    out[out_len] = '/';
                    out_len = out_len + 1;
                }
                j: int = 0;
                while (j < part_len) {
                    out[out_len] = p[start + j];
                    out_len = out_len + 1;
                    j = j + 1;
                }
            }
        }
    }
    if (out_len == 0) {
        out[0] = '.';
        out_len = 1;
    }
    out[out_len] = 0i8;
    out;
}

resolve_import_path(base: [z]i8, imported: [z]i8): *i8 {
    if (imported[0] == '/') { return normalize_path(imported); }
    b: []i8 = zslice(base);
    base_len: int = len(b);
    slash: int = 0 - 1;
    i: int = 0;
    while (i < base_len) {
        if (b[i] == '/') { slash = i; }
        i = i + 1;
    }
    if (slash < 0) { return normalize_path(imported); }
    in: int = cstr_len(imported);
    joined: []i8 = new i8[slash + 2 + in];
    j: int = 0;
    while (j <= slash) {
        joined[j] = b[j];
        j = j + 1;
    }
    k: int = 0;
    while (imported[k] != 0i8) {
        joined[j] = imported[k];
        j = j + 1;
        k = k + 1;
    }
    joined[j] = 0i8;
    normalize_path(joined);
}

mark_imported(path: *i8): bool {
    f: ?*ImportedFile = imported_files;
    while (f != null) {
        if (streq(f.path, path)) { return false; }
        f = f.next;
    }
    imported_files = new ImportedFile { path: path, next: imported_files };
    true;
}

type_size(t: *Type) raises Error: int {
    match t.* {
        Int -> { 8; }
        I8 -> { 1; }
        Bool -> { 1; }
        Ptr _p -> { 8; }
        OptPtr _p -> { 8; }
        Array k -> { type_size(k.base) * k.len; }
        Slice _p -> { 8; }
        ZPtr _p -> { 8; }
        View _p -> { 8; }
        Record k -> { k.def.size; }
        Enum k -> {
            if (k.def.size <= 0) { 8; } else { k.def.size; }
        }
        Exn k -> { k.def.size; }
        Noreturn -> { 0; }
    }
}

type_base(t: *Type) raises Error: *Type {
    match t.* {
        Ptr k -> { k.base; }
        OptPtr k -> { k.base; }
        Array k -> { k.base; }
        Slice k -> { k.base; }
        ZPtr k -> { k.base; }
        View k -> { k.base; }
        _ -> { error("not a pointer, array, or slice"); }
    }
}

type_array_len(t: *Type) raises Error: int {
    match t.* {
        Array k -> { k.len; }
        _ -> { error("not an array"); }
    }
}

type_struct_def(t: *Type) raises Error: *StructDef {
    match t.* {
        Record k -> { k.def; }
        _ -> { error("not a record type"); }
    }
}

type_enum_def(t: *Type) raises Error: *EnumDef {
    match t.* {
        Enum k -> { k.def; }
        _ -> { error("not an enum type"); }
    }
}

type_exn_def(t: *Type) raises Error: *ExnDef {
    match t.* {
        Exn k -> { k.def; }
        _ -> { error("not an exception type"); }
    }
}

ptr_to(base: *Type): *Type {
    e: ?*TyEnt = ptr_cache;
    while (e != null) {
        if (e.base == base) { return e.ty; }
        e = e.next;
    }
    t: *Type = new Type.Ptr { base: base };
    ptr_cache = new TyEnt { base: base, ty: t, next: ptr_cache };
    t;
}

opt_ptr_to(base: *Type): *Type {
    e: ?*TyEnt = opt_ptr_cache;
    while (e != null) {
        if (e.base == base) { return e.ty; }
        e = e.next;
    }
    t: *Type = new Type.OptPtr { base: base };
    opt_ptr_cache = new TyEnt { base: base, ty: t, next: opt_ptr_cache };
    t;
}

array_of(base: *Type, len: int): *Type {
    new Type.Array { base: base, len: len };
}

slice_of(base: *Type): *Type {
    e: ?*TyEnt = slice_cache;
    while (e != null) {
        if (e.base == base) { return e.ty; }
        e = e.next;
    }
    t: *Type = new Type.Slice { base: base };
    slice_cache = new TyEnt { base: base, ty: t, next: slice_cache };
    t;
}

zptr_of(base: *Type): *Type {
    e: ?*TyEnt = zptr_cache;
    while (e != null) {
        if (e.base == base) { return e.ty; }
        e = e.next;
    }
    t: *Type = new Type.ZPtr { base: base };
    zptr_cache = new TyEnt { base: base, ty: t, next: zptr_cache };
    t;
}

struct_type(sd: *StructDef): *Type {
    existing: ?*Type = sd.ty;
    if (existing != null) { existing; }
    else {
        p: *Type = new Type.Record { def: sd };
        sd.ty = p;
        p;
    }
}

enum_type(ed: *EnumDef): *Type {
    existing: ?*Type = ed.ty;
    if (existing != null) { existing; }
    else {
        p: *Type = new Type.Enum { def: ed };
        ed.ty = p;
        p;
    }
}

exn_type(ed: *ExnDef): *Type {
    existing: ?*Type = ed.ty;
    if (existing != null) { existing; }
    else {
        p: *Type = new Type.Exn { def: ed };
        ed.ty = p;
        p;
    }
}

find_struct_span(s: []i8, off: int, n: int): ?*StructDef {
    b: int = sym_bucket(hash_n(s, off, n));
    sd: ?*StructDef = struct_buckets[b].head;
    while (sd != null) {
        if (name_eq_span(sd.name, s, off, n)) { return sd; }
        sd = sd.hash_next;
    }
    null;
}

find_struct(name: *i8): ?*StructDef { find_struct_span(name as []i8, 0, len(name)); }

find_enum_span(s: []i8, off: int, n: int): ?*EnumDef {
    b: int = sym_bucket(hash_n(s, off, n));
    e: ?*EnumDef = enum_buckets[b].head;
    while (e != null) {
        if (name_eq_span(e.name, s, off, n)) { return e; }
        e = e.hash_next;
    }
    null;
}

find_enum(name: *i8): ?*EnumDef { find_enum_span(name as []i8, 0, len(name)); }

find_exn_span(s: []i8, off: int, n: int): ?*ExnDef {
    b: int = sym_bucket(hash_n(s, off, n));
    e: ?*ExnDef = exn_buckets[b].head;
    while (e != null) {
        if (name_eq_span(e.name, s, off, n)) { return e; }
        e = e.hash_next;
    }
    null;
}

find_exn(name: *i8): ?*ExnDef { find_exn_span(name as []i8, 0, len(name)); }

hash_put_struct(sd: *StructDef) {
    b: int = sym_bucket(hash_str(sd.name));
    sd.hash_next = struct_buckets[b].head;
    struct_buckets[b].head = sd;
}

hash_put_enum(ed: *EnumDef) {
    b: int = sym_bucket(hash_str(ed.name));
    ed.hash_next = enum_buckets[b].head;
    enum_buckets[b].head = ed;
}

hash_put_exn(ed: *ExnDef) {
    b: int = sym_bucket(hash_str(ed.name));
    ed.hash_next = exn_buckets[b].head;
    exn_buckets[b].head = ed;
}

hash_put_fn(fn: *Function) {
    b: int = sym_bucket(hash_str(fn.name));
    fn.hash_next = fn_buckets[b].head;
    fn_buckets[b].head = fn;
}

hash_put_global(o: *Obj) {
    b: int = sym_bucket(hash_str(o.name));
    o.hash_next = global_buckets[b].head;
    global_buckets[b].head = o;
}

hash_remove_struct(name: *i8) {
    b: int = sym_bucket(hash_str(name));
    prev: ?*StructDef = null;
    s: ?*StructDef = struct_buckets[b].head;
    while (s != null) {
        if (streq(s.name, name)) {
            if (prev != null) {
                prev.hash_next = s.hash_next;
            } else { struct_buckets[b].head = s.hash_next; }
            return;
        }
        prev = s;
        s = s.hash_next;
    }
}

remove_struct(name: *i8) {
    hash_remove_struct(name);
    prev: ?*StructDef = null;
    s: ?*StructDef = struct_defs;
    while (s != null) {
        if (streq(s.name, name)) {
            if (prev != null) {
                prev.next = s.next;
            } else { struct_defs = s.next; }
            return;
        }
        prev = s;
        s = s.next;
    }
}

get_or_create_struct(name: *i8): *StructDef {
    sd: ?*StructDef = find_struct(name);
    if (sd != null) { return sd; }
    created: *StructDef = new StructDef {
        name: name, members: null, size: 0, ty: null, next: struct_defs, hash_next: null
    };
    struct_defs = created;
    hash_put_struct(created);
    created;
}

get_or_create_enum(name: *i8): *EnumDef {
    ed: ?*EnumDef = find_enum(name);
    if (ed != null) { return ed; }
    created: *EnumDef = new EnumDef {
        name: name, variants: null, size: 0, ty: null, next: enum_defs, hash_next: null
    };
    enum_defs = created;
    hash_put_enum(created);
    created;
}

rebind_struct_stub_to_enum(sd: *StructDef, ed: *EnumDef) {
    t: ?*Type = sd.ty;
    if (t != null) {
        t.* = Type.Enum { def: ed };
        ed.ty = t;
    }
}

find_variant(ed: *EnumDef, name: *i8): ?*Variant {
    v: ?*Variant = ed.variants;
    while (v != null) {
        if (streq(v.name, name)) { return v; }
        v = v.next;
    }
    null;
}

variant_payload_name(enum_name: [z]i8, var_name: [z]i8): *i8 {
    a: []i8 = zslice(enum_name);
    b: []i8 = zslice(var_name);
    ea: int = len(a);
    va: int = len(b);
    n: int = ea + 1 + va;
    raw: []i8 = new i8[n + 16];
    p: *int = raw as *int;
    p.* = n;
    memcpy(raw, 8, a, 0, ea);
    raw[8 + ea] = '.';
    memcpy(raw, 8 + ea + 1, b, 0, va);
    &raw[8];
}

is_type_name(): bool {
    if (tok.kind != TokKind.Ident) { false; }
    else {
        find_struct_span(source, tok.pos, tok.len) != null || find_enum_span(source, tok.pos, tok.len) != null || find_exn_span(source, tok.pos, tok.len) != null;
    }
}

starts_type(): bool {
    if (tok.kind == TokKind.LBrack) { return true; }
    if (tok.kind == TokKind.Int || tok.kind == TokKind.I8 || tok.kind == TokKind.Bool || is_type_name()) { return true; }
    t: ?*Token = tok;
    done: int = 0;
    while (t != null && done == 0) {
        if (t.kind == TokKind.Question) {
            n1: ?*Token = t.next;
            if (n1 != null) {
                if (n1.kind != TokKind.Star) { return false; }
                t = n1.next;
            } else { return false; }
        } else {
            if (t.kind == TokKind.Star) {
                t = t.next;
            } else { done = 1; }
        }
    }
    if (t != null) {
        if (t != tok) {
            if (t.kind == TokKind.Int || t.kind == TokKind.I8 || t.kind == TokKind.Bool) { return true; }
            if (t.kind == TokKind.Ident) {
                if (find_struct_span(source, t.pos, t.len) != null) { return true; }
                if (find_enum_span(source, t.pos, t.len) != null) { return true; }
                if (find_exn_span(source, t.pos, t.len) != null) { return true; }
            }
        }
    }
    false;
}

find_field(members: ?*Member, name: *i8): ?*Member {
    m: ?*Member = members;
    while (m != null) {
        if (streq(m.name, name)) { return m; }
        m = m.next;
    }
    null;
}

find_member(sd: *StructDef, name: *i8): ?*Member { find_field(sd.members, name); }

find_exn_member(ed: *ExnDef, name: *i8): ?*Member { find_field(ed.members, name); }

exn_in_list(list: ?*ExnList, ed: *ExnDef): bool {
    e: ?*ExnList = list;
    while (e != null) {
        if (e.exn == ed) { return true; }
        e = e.next;
    }
    false;
}

exn_is_caught(ed: *ExnDef): bool {
    f: ?*CatchFrame = catch_top;
    while (f != null) {
        if (f.exn == ed) { return true; }
        f = f.next;
    }
    false;
}

mark_raises_seen(ed: *ExnDef): bool {
    fn: ?*Function = current_fn;
    if (fn != null) {
        e: ?*ExnList = fn.raises_list;
        while (e != null) {
            if (e.exn == ed) {
                e.seen = 1;
                return true;
            }
            e = e.next;
        }
    }
    false;
}

check_exn_allowed(ed: *ExnDef, _what: *i8) raises Error {
    if (exn_is_caught(ed)) { return; }
    if (mark_raises_seen(ed)) { return; }
    error("exception not in raises and not caught");
}

catch_push(ed: *ExnDef) {
    f: *CatchFrame = new CatchFrame { exn: ed, next: catch_top };
    catch_top = f;
}

catch_reset(saved: ?*CatchFrame) { catch_top = saved; }

is_pointer(t: *Type): bool {
    match t.* {
        Ptr _p -> { true; }
        _ -> { false; }
    }
}

is_opt_pointer(t: *Type): bool {
    match t.* {
        OptPtr _p -> { true; }
        _ -> { false; }
    }
}

is_any_pointer(t: *Type): bool { is_pointer(t) || is_opt_pointer(t); }

is_array(t: *Type): bool {
    match t.* {
        Array _p -> { true; }
        _ -> { false; }
    }
}

is_slice(t: *Type): bool {
    match t.* {
        Slice _p -> { true; }
        _ -> { false; }
    }
}

is_zptr(t: *Type): bool {
    match t.* {
        ZPtr _p -> { true; }
        _ -> { false; }
    }
}

is_view(t: *Type): bool {
    match t.* {
        View _p -> { true; }
        _ -> { false; }
    }
}

is_indexable(t: *Type): bool { is_array(t) || is_slice(t) || is_zptr(t) || is_view(t); }

is_struct_ty(t: *Type): bool {
    match t.* {
        Record _p -> { true; }
        _ -> { false; }
    }
}

is_enum_ty(t: *Type): bool {
    match t.* {
        Enum _p -> { true; }
        _ -> { false; }
    }
}

is_exn_ty(t: *Type): bool {
    match t.* {
        Exn _p -> { true; }
        _ -> { false; }
    }
}

passes_by_ref(t: *Type) raises Error: bool { (is_struct_ty(t) || is_enum_ty(t) || is_exn_ty(t)) && type_size(t) > 8; }

is_null_expr(n: ?*Expr): bool {
    if (n != null) {
        match n.kind {
            Null -> { true; }
            _ -> { false; }
        }
    } else { false; }
}

bind_null_to_pointer(pty: ?*Type, null_n: ?*Expr): bool {
    if (pty == null) { false; }
    else if (!is_opt_pointer(pty) || !is_null_value_expr(null_n)) { false; }
    else if (null_n != null) {
        null_n.ty = pty;
        true;
    } else { false; }
}

assignable(to: ?*Type, from_n: ?*Expr) raises Error: bool {
    ft: ?*Type = null;
    if (from_n != null) {
        fty: ?*Type = from_n.ty;
        if (fty != null) { ft = decay(fty); }
    }
    tt: ?*Type = decay(to);
    if (ft != null) {
        from2: ?*Type = decay(ft);
        to2: ?*Type = decay(tt);
        if (from2 != null && to2 != null) {
            if (types_equal(from2, to2)) { return true; }
            if (is_opt_pointer(to2) && (is_pointer(from2) || is_zptr(from2) || is_slice(from2)) && types_equal(type_base(from2), type_base(to2))) { return true; }
            if (is_pointer(to2) && (is_slice(from2) || is_zptr(from2) || is_view(from2) || is_array(from2))) {
                if (types_equal(type_base(from2), type_base(to2))) { return true; }
            }
            if (is_zptr(to2) && (is_slice(from2) || is_zptr(from2) || is_view(from2) || is_pointer(from2))) {
                if (types_equal(type_base(from2), type_base(to2))) { return true; }
            }
            if (is_slice(to2) && is_slice(from2) && types_equal(type_base(from2), type_base(to2))) { return true; }
            if (is_slice(to2) && (is_pointer(from2) || is_zptr(from2))) {
                if (types_equal(type_base(from2), type_base(to2))) { return true; }
            }
            if (is_view(to2) && (is_slice(from2) || is_view(from2) || is_zptr(from2) || is_pointer(from2) || is_array(from2))) {
                if (types_equal(type_base(from2), type_base(to2))) { return true; }
            }
        }
    }
    bind_null_to_pointer(tt, from_n);
}

is_i8_ty(t: *Type): bool {
    match t.* {
        I8 -> { true; }
        _ -> { false; }
    }
}

is_int_ty(t: *Type): bool {
    match t.* {
        Int -> { true; }
        _ -> { false; }
    }
}

is_bool_ty(t: *Type): bool {
    match t.* {
        Bool -> { true; }
        _ -> { false; }
    }
}

is_noreturn_ty(t: *Type): bool {
    match t.* {
        Noreturn -> { true; }
        _ -> { false; }
    }
}

types_equal(a: *Type, b: *Type) raises Error: bool {
    if (a == b) { true; }
    else if (is_int_ty(a) && is_int_ty(b)) { true; }
    else if (is_i8_ty(a) && is_i8_ty(b)) { true; }
    else if (is_bool_ty(a) && is_bool_ty(b)) { true; }
    else if (is_noreturn_ty(a) && is_noreturn_ty(b)) { true; }
    else if (is_pointer(a) && is_pointer(b)) { types_equal(type_base(a), type_base(b)); }
    else if (is_opt_pointer(a) && is_opt_pointer(b)) { types_equal(type_base(a), type_base(b)); }
    else if (is_array(a) && is_array(b)) {
        if (type_array_len(a) != type_array_len(b)) { false; }
        else { types_equal(type_base(a), type_base(b)); }
    }
    else if (is_slice(a) && is_slice(b)) { types_equal(type_base(a), type_base(b)); }
    else if (is_zptr(a) && is_zptr(b)) { types_equal(type_base(a), type_base(b)); }
    else if (is_view(a) && is_view(b)) {
        match a.* {
            View ka -> {
                match b.* {
                    View kb -> { streq(ka.bound, kb.bound) && types_equal(ka.base, kb.base); }
                    _ -> { false; }
                }
            }
            _ -> { false; }
        }
    }
    else if (is_struct_ty(a) && is_struct_ty(b)) { type_struct_def(a) == type_struct_def(b); }
    else if (is_enum_ty(a) && is_enum_ty(b)) { type_enum_def(a) == type_enum_def(b); }
    else if (is_exn_ty(a) && is_exn_ty(b)) { type_exn_def(a) == type_exn_def(b); }
    else { false; }
}

is_numeric_ty(t: *Type): bool {
    is_int_ty(t) || is_i8_ty(t) || is_bool_ty(t);
}

check_as(from: ?*Type, to: ?*Type) raises Error {
    from = decay(from);
    to = decay(to);
    if (from == null) { error("invalid as conversion"); }
    if (to == null) { error("invalid as conversion"); }
    if (types_equal(from, to)) { return; }
    if (is_numeric_ty(from) && is_numeric_ty(to)) {
        if ((is_i8_ty(from) || is_bool_ty(from)) && is_int_ty(to)) { return; }
        if (type_size(from) == 1 && type_size(to) == 1) { return; }
        error_have_want("invalid as conversion (use trunc to narrow int→i8/bool)", from, to);
    }
    if (is_opt_pointer(from) && is_pointer(to)) {
        error_have_want("cannot cast optional pointer to non-optional (bind a local and use if (p != null))", from, to);
    }
    if (is_pointer(from) && is_pointer(to)) { return; }
    if (is_pointer(to) && (is_slice(from) || is_zptr(from) || is_view(from))) { return; }
    if (is_slice(to) && is_pointer(from)) { return; }
    if (is_zptr(to) && (is_slice(from) || is_pointer(from) || is_view(from) || is_zptr(from))) { return; }
    if (is_slice(to) && is_slice(from)) { return; }
    if (is_view(to) && (is_slice(from) || is_view(from) || is_zptr(from) || is_pointer(from) || is_array(from))) { return; }
    error_have_want("invalid as conversion", from, to);
}

check_trunc(from: ?*Type, to: ?*Type) raises Error {
    from = decay(from);
    to = decay(to);
    if (from == null) { error("invalid trunc conversion"); }
    if (to == null) { error("invalid trunc conversion"); }
    if (is_int_ty(from) && (is_i8_ty(to) || is_bool_ty(to))) { return; }
    error_have_want("invalid trunc conversion", from, to);
}

decay(t: ?*Type) raises Error: ?*Type {
    if (t != null && is_array(t)) { ptr_to(type_base(t)); }
    else { t; }
}

is_byte_ty(t: *Type) raises Error: bool { type_size(t) == 1; }

new_token(kind: TokKind, start: *i8, len: int, tokpos: int): *Token {
    if (tok_pool_i >= tok_pool_n) {
        tok_pool_n = 2048;
        tok_pool = new Token[2048];
        tok_pool_i = 0;
    }
    t: *Token = &tok_pool[tok_pool_i];
    tok_pool_i = tok_pool_i + 1;
    t.kind = kind;
    t.val = 0;
    t.str = start;
    t.len = len;
    t.pos = tokpos;
    t.next = token_eof;
    t;
}

ident_kind(s: []i8, off: int, n: int): TokKind {
    if (n == 2) {
        if (s[off + 0] == 'i') {
            if (s[off + 1] == 'f') { return TokKind.If; }
            if (s[off + 1] == '8') { return TokKind.I8; }
        }
        if (s[off + 0] == 'a' && s[off + 1] == 's') { return TokKind.As; }
        if (s[off + 0] == 'o' && s[off + 1] == 'r') { return TokKind.OrKw; }
        return TokKind.Ident;
    }
    if (n == 3) {
        if (s[off + 0] == 'i' && s[off + 1] == 'n' && s[off + 2] == 't') { return TokKind.Int; }
        if (s[off + 0] == 'n' && s[off + 1] == 'e' && s[off + 2] == 'w') { return TokKind.New; }
        if (s[off + 0] == 't' && s[off + 1] == 'r' && s[off + 2] == 'y') { return TokKind.Try; }
        return TokKind.Ident;
    }
    if (n == 4) {
        c0: i8 = s[off + 0];
        if (c0 == 'b' && s[off + 1] == 'o' && s[off + 2] == 'o' && s[off + 3] == 'l') { return TokKind.Bool; }
        if (c0 == 't') {
            if (s[off + 1] == 'r' && s[off + 2] == 'u' && s[off + 3] == 'e') { return TokKind.True; }
            if (s[off + 1] == 'y' && s[off + 2] == 'p' && s[off + 3] == 'e') { return TokKind.TypeKw; }
        }
        if (c0 == 'n' && s[off + 1] == 'u' && s[off + 2] == 'l' && s[off + 3] == 'l') { return TokKind.Null; }
        if (c0 == 'e' && s[off + 1] == 'l' && s[off + 2] == 's' && s[off + 3] == 'e') { return TokKind.Else; }
        if (c0 == 'w' && s[off + 1] == 'i' && s[off + 2] == 't' && s[off + 3] == 'h') { return TokKind.With; }
        return TokKind.Ident;
    }
    if (n == 5) {
        c1: i8 = s[off + 0];
        if (c1 == 'f' && s[off + 1] == 'a' && s[off + 2] == 'l' && s[off + 3] == 's' && s[off + 4] == 'e') { return TokKind.False; }
        if (c1 == 'w' && s[off + 1] == 'h' && s[off + 2] == 'i' && s[off + 3] == 'l' && s[off + 4] == 'e') { return TokKind.While; }
        if (c1 == 't' && s[off + 1] == 'r' && s[off + 2] == 'u' && s[off + 3] == 'n' && s[off + 4] == 'c') { return TokKind.Trunc; }
        if (c1 == 'm' && s[off + 1] == 'a' && s[off + 2] == 't' && s[off + 3] == 'c' && s[off + 4] == 'h') { return TokKind.Match; }
        if (c1 == 'r' && s[off + 1] == 'a' && s[off + 2] == 'i' && s[off + 3] == 's' && s[off + 4] == 'e') { return TokKind.Raise; }
        return TokKind.Ident;
    }
    if (n == 6) {
        c2: i8 = s[off + 0];
        if (c2 == 'r') {
            if (s[off + 1] == 'e' && s[off + 2] == 't' && s[off + 3] == 'u' && s[off + 4] == 'r' && s[off + 5] == 'n') { return TokKind.Return; }
            if (s[off + 1] == 'a' && s[off + 2] == 'i' && s[off + 3] == 's' && s[off + 4] == 'e' && s[off + 5] == 's') { return TokKind.Raises; }
        }
        if (c2 == 's' && s[off + 1] == 'i' && s[off + 2] == 'z' && s[off + 3] == 'e' && s[off + 4] == 'o' && s[off + 5] == 'f') { return TokKind.Sizeof; }
        if (c2 == 'i' && s[off + 1] == 'm' && s[off + 2] == 'p' && s[off + 3] == 'o' && s[off + 4] == 'r' && s[off + 5] == 't') { return TokKind.Import; }
        return TokKind.Ident;
    }
    if (n == 8) {
        if (s[off] == 'n' && streq_n(s, off, "noreturn", 0, 8)) { return TokKind.Noreturn; }
        return TokKind.Ident;
    }
    if (n == 9) {
        if (s[off] == 'e' && streq_n(s, off, "exception", 0, 9)) { return TokKind.Exception; }
        return TokKind.Ident;
    }
    if (n == 13) {
        if (s[off] == 'u' && streq_n(s, off, "uninitialized", 0, 13)) { return TokKind.Uninitialized; }
        return TokKind.Ident;
    }
    TokKind.Ident;
}

skip_line_comment() {
    while (pos < source_len) {
        if (source[pos] == '\n') { return; }
        pos = pos + 1;
    }
}

skip_block_comment() {
    while (pos < source_len) {
        if (source[pos] == '*' && source[pos + 1] == '/') {
            pos = pos + 2;
            return;
        }
        pos = pos + 1;
    }
}

read_number(): int {
    v: int = 0;
    while (pos < source_len) {
        d: i8 = source[pos];
        if (d < '0' || d > '9') { return v; }
        v = v * 10 + ((d - '0') as int);
        pos = pos + 1;
    }
    v;
}

esc_char(c: i8): i8 {
    if (c == 'n') { return '\n'; }
    if (c == 't') { return '\t'; }
    if (c == 'r') { return '\r'; }
    if (c == '0') { return 0i8; }
    if (c == '\\') { return '\\'; }
    if (c == '\'') { return '\''; }
    if (c == '"') { return '"'; }
    c;
}

scan_string_len() raises Error: int {
    start: int = pos;
    while (pos < source_len) {
        if (source[pos] == '"') { return pos - start; }
        if (source[pos] == '\\') { pos = pos + 1; }
        pos = pos + 1;
    }
    error("unterminated string");
}

scan_ident_len(): int {
    start: int = pos;
    while (pos < source_len) {
        d: i8 = source[pos];
        if ((d >= 'a' && d <= 'z') || (d >= 'A' && d <= 'Z') || d == '_' || (d >= '0' && d <= '9')) {
            pos = pos + 1;
        } else { return pos - start; }
    }
    pos - start;
}

punct_kind(c: i8) raises Error: TokKind {
    if (c == '+') { return TokKind.Plus; }
    if (c == '-') { return TokKind.Minus; }
    if (c == '*') { return TokKind.Star; }
    if (c == '%') { return TokKind.Percent; }
    if (c == '&') { return TokKind.Amp; }
    if (c == '.') { return TokKind.Dot; }
    if (c == ':') { return TokKind.Colon; }
    if (c == '(') { return TokKind.LParen; }
    if (c == ')') { return TokKind.RParen; }
    if (c == '{') { return TokKind.LBrace; }
    if (c == '}') { return TokKind.RBrace; }
    if (c == '[') { return TokKind.LBrack; }
    if (c == ']') { return TokKind.RBrack; }
    if (c == ';') { return TokKind.Semi; }
    if (c == ',') { return TokKind.Comma; }
    if (c == '/') { return TokKind.Slash; }
    if (c == '?') { return TokKind.Question; }
    if (c == '^') { return TokKind.Caret; }
    if (c == '~') { return TokKind.Tilde; }
    error_at(pos, "unexpected character");
    TokKind.Eof;
}

tokenize() raises Error: *Token {
    head: *Token = new Token {
        kind: TokKind.Eof,
        val: 0,
        str: "",
        len: 0,
        pos: 0,
        next: token_eof
    };
    cur: *Token = head;
    t: *Token = uninitialized;
    s: *i8 = uninitialized;
    n: int = 0;
    v: int = 0;
    c: i8 = 0i8;
    ch: i8 = 0i8;
    pk: TokKind = TokKind.Eof;
    pos = 0;
    while (pos < source_len) {
        c = source[pos];
        if (c == ' ' || c == '\n' || c == '\t' || c == '\r') {
            pos = pos + 1;
        } else if (c == '/' && source[pos + 1] == '/') {
            pos = pos + 2;
            skip_line_comment();
        } else if (c == '/' && source[pos + 1] == '*') {
            pos = pos + 2;
            skip_block_comment();
        } else if (c >= '0' && c <= '9') {
            s = &source[pos];
            n = pos;
            v = read_number();
            t = new_token(TokKind.Num, s, pos - n, n);
            t.val = v;
            cur.next = t;
            cur = t;
        } else if (c == '"') {
            pos = pos + 1;
            s = &source[pos];
            n = pos;
            t = new_token(TokKind.Str, s, scan_string_len(), n);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        } else if (c == '\'') {
            n = pos;
            pos = pos + 1;
            if (source[pos] == '\\') {
                pos = pos + 1;
                ch = esc_char(source[pos]);
                pos = pos + 1;
            } else {
                ch = source[pos];
                pos = pos + 1;
            }
            if (source[pos] == '\'') { pos = pos + 1; }
            t = new_token(TokKind.Char, &source[pos], 0, n);
            t.val = ch as int;
            cur.next = t;
            cur = t;
        } else if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
            s = &source[pos];
            n = scan_ident_len();
            t = new_token(ident_kind(source, pos - n, n), intern(source, pos - n, n), n, pos - n);
            cur.next = t;
            cur = t;
        } else if (c == '=' && source[pos + 1] == '=') {
            t = new_token(TokKind.Eq, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '!' && source[pos + 1] == '=') {
            t = new_token(TokKind.Ne, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '<' && source[pos + 1] == '<') {
            t = new_token(TokKind.Shl, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '<' && source[pos + 1] == '=') {
            t = new_token(TokKind.Le, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '>' && source[pos + 1] == '>') {
            t = new_token(TokKind.Shr, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '>' && source[pos + 1] == '=') {
            t = new_token(TokKind.Ge, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '&' && source[pos + 1] == '&') {
            t = new_token(TokKind.And, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '|' && source[pos + 1] == '|') {
            t = new_token(TokKind.Or, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '-' && source[pos + 1] == '>') {
            t = new_token(TokKind.Arrow, &source[pos], 2, pos);
            cur.next = t; cur = t; pos = pos + 2;
        } else if (c == '|') {
            t = new_token(TokKind.Pipe, &source[pos], 1, pos);
            cur.next = t; cur = t; pos = pos + 1;
        } else if (c == '<') {
            t = new_token(TokKind.Lt, &source[pos], 1, pos);
            cur.next = t; cur = t; pos = pos + 1;
        } else if (c == '>') {
            t = new_token(TokKind.Gt, &source[pos], 1, pos);
            cur.next = t; cur = t; pos = pos + 1;
        } else if (c == '=') {
            t = new_token(TokKind.Assign, &source[pos], 1, pos);
            cur.next = t; cur = t; pos = pos + 1;
        } else if (c == '!') {
            t = new_token(TokKind.Not, &source[pos], 1, pos);
            cur.next = t; cur = t; pos = pos + 1;
        } else {
            pk = punct_kind(c);
            t = new_token(pk, &source[pos], 1, pos);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        }
    }
    t = new_token(TokKind.Eof, &source[pos], 0, pos);
    t.next = t;
    cur.next = t;
    head.next;
}

skip(kind: TokKind) raises Error {
    if (tok.kind != kind) { error("unexpected token"); }
    tok = tok.next;
}

skip_optional_semi() {
    if (tok.kind == TokKind.Semi) { tok = tok.next; }
}

cur_tokstr(): *i8 {
    if (tok.kind == TokKind.Ident) { tok.str; }
    else { intern(source, tok.pos, tok.len); }
}

intern(s: []i8, off: int, n: int): *i8 {
    b: int = hash_n(s, off, n);
    if (b < 0) { b = 0 - b; }
    b = b & 4095;
    e: ?*InternEnt = intern_buckets[b].head;
    while (e != null) {
        if (e.n == n) {
            if (streq_n(e.s as []i8, 0, s, off, n)) { return e.s; }
        }
        e = e.next;
    }
    d: *i8 = strdup_n(s, off, n);
    ne: *InternEnt = new InternEnt { s: d, n: n, next: intern_buckets[b].head };
    intern_buckets[b].head = ne;
    d;
}

add_string(s: []i8, off: int, n: int): int {
    buf: []i8 = new i8[n + 1];
    i: int = 0;
    j: int = 0;
    while (i < n) {
        if (s[off + i] == '\\' && i + 1 < n) {
            i = i + 1;
            buf[j] = esc_char(s[off + i]);
            j = j + 1;
        } else {
            buf[j] = s[off + i];
            j = j + 1;
        }
        i = i + 1;
    }
    buf[j] = 0i8;
    lit: *StrLit = new StrLit {
        data: buf,
        len: j,
        label: str_count,
        next: null
    };
    str_count = str_count + 1;
    t: ?*StrLit = str_lit_tail;
    if (t != null) {
        t.next = lit;
    } else {
        str_lits = lit;
    }
    str_lit_tail = lit;
    lit.label;
}

mk_expr(k: ExprKind): *Expr {
    if (expr_pool_i >= expr_pool_n) {
        expr_pool_n = 1024;
        expr_pool = new Expr[1024];
        expr_pool_i = 0;
    }
    n: *Expr = &expr_pool[expr_pool_i];
    expr_pool_i = expr_pool_i + 1;
    n.kind = k;
    n.next = null;
    n.ty = null;
    n;
}

mk_stmt(k: StmtKind): *Stmt {
    if (stmt_pool_i >= stmt_pool_n) {
        stmt_pool_n = 512;
        stmt_pool = new Stmt[512];
        stmt_pool_i = 0;
    }
    n: *Stmt = &stmt_pool[stmt_pool_i];
    stmt_pool_i = stmt_pool_i + 1;
    n.kind = k;
    n.next = null;
    n;
}

new_num(v: int): *Expr {
    n: *Expr = mk_expr(ExprKind.Num { val: v, str_label: 0 });
    n.ty = ty_int;
    n;
}

new_str_num(label: int): *Expr {
    n: *Expr = mk_expr(ExprKind.Num { val: 0, str_label: label });
    n.ty = ptr_to(ty_i8);
    n;
}

new_null_expr(): *Expr { mk_expr(ExprKind.Null); }

new_var_node(var: *Obj): *Expr {
    n: *Expr = mk_expr(ExprKind.Var { var: var, name: null, member: null });
    n.ty = var.ty;
    n;
}

new_binary(op: BinOp, lhs: *Expr, rhs: *Expr): *Expr {
    mk_expr(ExprKind.Binary { op: op, lhs: lhs, rhs: rhs });
}
new_assign(lhs: *Expr, rhs: *Expr): *Expr { mk_expr(ExprKind.Assign { lhs: lhs, rhs: rhs }); }
new_logand(lhs: *Expr, rhs: *Expr): *Expr { mk_expr(ExprKind.LogAnd { lhs: lhs, rhs: rhs }); }
new_logor(lhs: *Expr, rhs: *Expr): *Expr { mk_expr(ExprKind.LogOr { lhs: lhs, rhs: rhs }); }
new_or_else(lhs: *Expr, rhs: *Expr): *Expr { mk_expr(ExprKind.OrElse { lhs: lhs, rhs: rhs }); }
new_addr(lhs: *Expr): *Expr { mk_expr(ExprKind.Addr { lhs: lhs }); }
new_deref(lhs: *Expr): *Expr { mk_expr(ExprKind.Deref { lhs: lhs }); }
new_index(lhs: *Expr, idx: *Expr): *Expr { mk_expr(ExprKind.Index { lhs: lhs, idx: idx }); }
new_not(lhs: *Expr): *Expr { mk_expr(ExprKind.Not { lhs: lhs }); }
new_neg(lhs: *Expr): *Expr { mk_expr(ExprKind.Neg { lhs: lhs }); }
new_bitnot(lhs: *Expr): *Expr { mk_expr(ExprKind.BitNot { lhs: lhs }); }
new_as(lhs: *Expr, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.As { lhs: lhs });
    n.ty = ty;
    n;
}
new_trunc(lhs: *Expr, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.Trunc { lhs: lhs });
    n.ty = ty;
    n;
}
new_member_access(lhs: *Expr, m: *Member): *Expr {
    n: *Expr = mk_expr(ExprKind.MemberAccess { lhs: lhs, member: m });
    n.ty = m.ty;
    n;
}
new_funcall(name: *i8, args: ?*Expr): *Expr {
    mk_expr(ExprKind.Funcall { funcname: name, args: args, fn: null });
}
new_return(lhs: ?*Expr): *Stmt { mk_stmt(StmtKind.Return { lhs: lhs }); }
new_if(cond: *Expr, then: *Stmt, els: ?*Stmt): *Stmt { mk_stmt(StmtKind.If { cond: cond, then: then, els: els }); }
new_while(cond: *Expr, body: *Stmt): *Stmt { mk_stmt(StmtKind.While { cond: cond, body: body }); }
new_block(body: ?*Stmt): *Stmt { mk_stmt(StmtKind.Block { body: body }); }
new_expr_stmt(lhs: *Expr): *Stmt { mk_stmt(StmtKind.ExprStmt { lhs: lhs }); }
new_field_init(m: *Member, lhs: ?*Expr): *FieldInit {
    new FieldInit { member: m, lhs: lhs, next: null };
}
new_heap_node(lhs: ?*Expr, val: int, inits: ?*FieldInit, variant: ?*Variant, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.New { lhs: lhs, val: val, inits: inits, variant: variant });
    n.ty = ty;
    n;
}
new_struct_lit(inits: ?*FieldInit, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.StructLit { inits: inits });
    n.ty = ty;
    n;
}
new_variant_lit(v: *Variant, val: int, inits: ?*FieldInit, ty: *Type): *Expr {
    n: *Expr = mk_expr(ExprKind.VariantLit { variant: v, val: val, inits: inits });
    n.ty = ty;
    n;
}
new_if_expr(cond: *Expr, then: *Expr, els: *Expr): *Expr { mk_expr(ExprKind.If { cond: cond, then: then, els: els }); }
new_match_expr(cond: *Expr, arms: ?*MatchArm): *Expr { mk_expr(ExprKind.Match { cond: cond, arms: arms }); }
new_block_expr(body: ?*Stmt): *Expr { mk_expr(ExprKind.Block { body: body }); }
new_match(cond: *Expr, arms: ?*MatchArm): *Stmt { mk_stmt(StmtKind.Match { cond: cond, arms: arms }); }
new_match_arm(variant: ?*Variant, binder: ?*Obj, body: *Stmt): *MatchArm {
    new MatchArm { variant: variant, binder: binder, body: body, next: null };
}
new_raise(exn: *ExnDef, inits: ?*FieldInit): *Stmt { mk_stmt(StmtKind.Raise { exn: exn, inits: inits }); }
new_try(body: *Stmt, arms: ?*CatchArm, buf: *Obj): *Stmt { mk_stmt(StmtKind.Try { body: body, arms: arms, buf: buf }); }
new_catch_arm(exn: *ExnDef, binder: ?*Obj, body: *Stmt): *CatchArm {
    new CatchArm { exn: exn, binder: binder, body: body, next: null };
}

find_function(name: *i8): ?*Function {
    b: int = sym_bucket(hash_str(name));
    fn: ?*Function = fn_buckets[b].head;
    while (fn != null) {
        if (streq(fn.name, name)) { return fn; }
        fn = fn.hash_next;
    }
    null;
}

find_global(name: *i8): ?*Obj {
    b: int = sym_bucket(hash_str(name));
    o: ?*Obj = global_buckets[b].head;
    while (o != null) {
        if (streq(o.name, name)) { return o; }
        o = o.hash_next;
    }
    null;
}

find_obj(list: ?*Obj, name: *i8): ?*Obj {
    if (list == globals) { return find_global(name); }
    o: ?*Obj = list;
    while (o != null) {
        if (streq(o.name, name)) { return o; }
        o = o.next;
    }
    null;
}

find_local(name: *i8): ?*Obj {
    o: ?*Obj = locals;
    while (o != null) {
        if (o.scope_depth <= scope_depth) {
            if (streq(o.name, name)) { return o; }
        }
        o = o.next;
    }
    null;
}

find_var(name: *i8): ?*Obj {
    o: ?*Obj = find_local(name);
    if (o != null) { return o; }
    find_global(name);
}

find_fn_bound(name: *i8): ?*Obj {
    fn: ?*Function = current_fn;
    if (fn == null) { return null; }
    o: ?*Obj = fn.locals;
    while (o != null) {
        if (streq(o.name, name)) { return o; }
        o = o.next;
    }
    p: ?*Obj = fn.params;
    while (p != null) {
        if (streq(p.name, name)) { return p; }
        p = p.param_next;
    }
    null;
}

enter_scope() { scope_depth = scope_depth + 1; }

leave_scope() raises Error {
    if (scope_depth <= 0) { error("internal: leave_scope"); }
    scope_depth = scope_depth - 1;
}

new_obj(name: *i8, is_local: int): *Obj {
    o: *Obj = new Obj {
        name: name,
        is_local: is_local,
        is_func: 0,
        offset: 0,
        scope_depth: 0,
        ty: null,
        used: 0,
        init: null,
        next: null,
        param_next: null,
        hash_next: null
    };
    if (is_local != 0) {
        o.scope_depth = scope_depth;
        o.next = locals;
        locals = o;
    } else {
        o.next = globals;
        globals = o;
        hash_put_global(o);
    }
    o;
}

var_view_ty(var: ?*Obj): ?*Type {
    f: ?*NarrowFrame = narrow_top;
    while (f != null) {
        if (f.var == var) { return f.ty; }
        f = f.next;
    }
    if (var != null) { return var.ty; }
    null;
}

narrow_push(var: ?*Obj, ty: ?*Type) {
    f: *NarrowFrame = new NarrowFrame {
        var: var,
        ty: ty,
        next: narrow_top
    };
    narrow_top = f;
}

narrow_reset(saved: ?*NarrowFrame) { narrow_top = saved; }

walk_reset(saved: ?*WalkFrame) { walk_top = saved; }

walk_fact(str: ?*Obj): ?*WalkFrame {
    f: ?*WalkFrame = walk_top;
    while (f != null) {
        if (f.str == str) { return f; }
        f = f.next;
    }
    null;
}

walk_hi(str: ?*Obj): int {
    f: ?*WalkFrame = walk_fact(str);
    if (f != null) { f.hi; }
    else { 0; }
}

walk_cursor(str: ?*Obj): ?*Obj {
    f: ?*WalkFrame = walk_fact(str);
    if (f != null) { f.cursor; }
    else { null; }
}

walk_push(str: ?*Obj, hi: int, cursor: ?*Obj) {
    f: *WalkFrame = new WalkFrame { str: str, hi: hi, cursor: cursor, next: walk_top };
    walk_top = f;
}

is_zero_var(var: ?*Obj): bool {
    f: ?*WalkFrame = zero_top;
    while (f != null) {
        if (f.cursor == var) { return true; }
        f = f.next;
    }
    false;
}

mark_zero_var(var: ?*Obj) {
    f: *WalkFrame = new WalkFrame { str: null, hi: 0, cursor: var, next: zero_top };
    zero_top = f;
}

index_lhs_var(n: *Expr): ?*Obj {
    match n.kind {
        Var k -> { k.var; }
        _ -> { null; }
    }
}

index_idx_num(n: *Expr): int {
    match n.kind {
        Num k -> { if (k.str_label == 0) { k.val; } else { 0 - 1; } }
        _ -> { 0 - 1; }
    }
}

index_idx_var(n: *Expr): ?*Obj {
    match n.kind {
        Var k -> { k.var; }
        _ -> { null; }
    }
}

zindex_ok(str: ?*Obj, idx: *Expr): bool {
    kn: int = index_idx_num(idx);
    if (kn >= 0) {
        if (kn <= walk_hi(str)) { return true; }
        return false;
    }
    iv: ?*Obj = index_idx_var(idx);
    if (iv == null) { return false; }
    if (walk_cursor(str) == iv) { return true; }
    if (is_zero_var(iv) && walk_hi(str) >= 0) {
        walk_push(str, walk_hi(str), iv);
        return true;
    }
    false;
}

walk_advance_index(lhs: *Expr, idx: *Expr) {
    raw: ?*Type = lhs.ty;
    if (raw == null || !is_zptr(raw)) { return; }
    sv: ?*Obj = index_lhs_var(lhs);
    kn: int = index_idx_num(idx);
    if (kn >= 0) {
        walk_push(sv, kn + 1, walk_cursor(sv));
        return;
    }
    iv: ?*Obj = index_idx_var(idx);
    if (iv != null) {
        walk_push(sv, walk_hi(sv), iv);
    }
}

is_nonzero_byte_expr(n: *Expr): bool {
    match n.kind {
        Num k -> { k.str_label == 0 && k.val != 0; }
        _ -> { false; }
    }
}

expr_is_zero_lit(n: *Expr): bool {
    match n.kind {
        Num k -> { k.str_label == 0 && k.val == 0; }
        _ -> { false; }
    }
}

walk_advance_cond(cond: ?*Expr) {
    if (cond == null) { return; }
    match cond.kind {
        LogAnd k -> {
            walk_advance_cond(k.lhs);
            walk_advance_cond(k.rhs);
            return;
        }
        Binary k -> {
            ix: ?*Expr = null;
            other: ?*Expr = null;
            match k.lhs.kind {
                Index _p -> { ix = k.lhs; other = k.rhs; }
                _ -> {}
            }
            if (ix == null) {
                match k.rhs.kind {
                    Index _p2 -> { ix = k.rhs; other = k.lhs; }
                    _ -> {}
                }
            }
            if (ix == null || other == null) { return; }
            match ix.kind {
                Index q -> {
                    match k.op {
                        Ne -> { if (expr_is_zero_lit(other)) { walk_advance_index(q.lhs, q.idx); } }
                        Eq -> { if (is_nonzero_byte_expr(other)) { walk_advance_index(q.lhs, q.idx); } }
                        _ -> {}
                    }
                }
                _ -> {}
            }
        }
        _ -> {}
    }
}

opt_local_var(n: ?*Expr) raises Error: ?*Obj {
    if (n != null) {
        match n.kind {
            Var k -> {
                var: ?*Obj = k.var;
                if (var != null) {
                    if (var.is_local == 0) { return null; }
                    t: ?*Type = decay(var.ty);
                    if (t != null && is_opt_pointer(t)) { return var; }
                    return null;
                }
                return null;
            }
            _ -> { return null; }
        }
    }
    null;
}

null_sides(lhs: *Expr, rhs: *Expr) raises Error: ?*Obj {
    if (is_null_expr(rhs)) { return opt_local_var(lhs); }
    if (is_null_expr(lhs)) { return opt_local_var(rhs); }
    null;
}

null_check_var(cond: ?*Expr) raises Error: ?*Obj {
    if (cond != null) {
        match cond.kind {
            Binary k -> {
                match k.op {
                    Ne -> { return null_sides(k.lhs, k.rhs); }
                    _ -> { return null; }
                }
            }
            _ -> { return null; }
        }
    }
    null;
}

null_eq_var(cond: ?*Expr) raises Error: ?*Obj {
    if (cond != null) {
        match cond.kind {
            Binary k -> {
                match k.op {
                    Eq -> { return null_sides(k.lhs, k.rhs); }
                    _ -> { return null; }
                }
            }
            _ -> { return null; }
        }
    }
    null;
}

narrow_push_ne_nulls(cond: ?*Expr) raises Error {
    if (cond != null) {
        match cond.kind {
            LogAnd k -> {
                narrow_push_ne_nulls(k.lhs);
                narrow_push_ne_nulls(k.rhs);
                return;
            }
            _ -> {
                v: ?*Obj = null_check_var(cond);
                if (v != null) {
                    vt: ?*Type = decay(v.ty);
                    if (vt == null) { error("missing type"); }
                    narrow_push(v, ptr_to(type_base(vt)));
                }
            }
        }
    }
}

narrow_push_eq_nulls(cond: ?*Expr) raises Error {
    if (cond != null) {
        match cond.kind {
            LogOr k -> {
                narrow_push_eq_nulls(k.lhs);
                narrow_push_eq_nulls(k.rhs);
                return;
            }
            _ -> {
                v: ?*Obj = null_eq_var(cond);
                if (v != null) {
                    vt: ?*Type = decay(v.ty);
                    if (vt == null) { error("missing type"); }
                    narrow_push(v, ptr_to(type_base(vt)));
                }
            }
        }
    }
}

decl_spec() raises Error: *Type {
    if (tok.kind == TokKind.Int) {
        tok = tok.next;
        return ty_int;
    }
    if (tok.kind == TokKind.I8) {
        tok = tok.next;
        return ty_i8;
    }
    if (tok.kind == TokKind.Bool) {
        tok = tok.next;
        return ty_bool;
    }
    if (tok.kind == TokKind.Noreturn) {
        tok = tok.next;
        return ty_noreturn;
    }
    if (tok.kind == TokKind.Ident) {
        name: *i8 = cur_tokstr();
        ed: ?*EnumDef = find_enum(name);
        if (ed != null) {
            tok = tok.next;
            return enum_type(ed);
        }
        xd: ?*ExnDef = find_exn(name);
        if (xd != null) {
            tok = tok.next;
            return exn_type(xd);
        }
        tok = tok.next;
        sd: *StructDef = get_or_create_struct(name);
        return struct_type(sd);
    }
    error("expected type");
}

parse_type() raises Error: *Type {
    if (tok.kind == TokKind.LBrack) {
        tok = tok.next;
        if (tok.kind == TokKind.RBrack) {
            tok = tok.next;
            base0: *Type = parse_type();
            if (is_noreturn_ty(base0)) { error("noreturn cannot be a slice element"); }
            return slice_of(base0);
        }
        if (tok.kind == TokKind.Colon) {
            tok = tok.next;
            if (tok.kind != TokKind.Num || tok.val != 0) { error("expected 0 in [:0] type"); }
            tok = tok.next;
            skip(TokKind.RBrack);
            base1: *Type = parse_type();
            if (is_noreturn_ty(base1)) { error("noreturn cannot be a C-string element"); }
            return zptr_of(base1);
        }
        if (tok.kind == TokKind.Ident && streq(cur_tokstr(), "z")) {
            tok = tok.next;
            skip(TokKind.RBrack);
            base3: *Type = parse_type();
            if (is_noreturn_ty(base3)) { error("noreturn cannot be a C-string element"); }
            return zptr_of(base3);
        }
        error("expected []T or [z]T");
    }
    if (tok.kind == TokKind.Question) {
        tok = tok.next;
        if (tok.kind != TokKind.Star) { error("expected * after ? in optional pointer type"); }
        tok = tok.next;
        base: *Type = parse_type();
        if (is_noreturn_ty(base)) { error("noreturn cannot be pointed to"); }
        return opt_ptr_to(base);
    }
    if (tok.kind == TokKind.Star) {
        tok = tok.next;
        base: *Type = parse_type();
        if (is_noreturn_ty(base)) { error("noreturn cannot be pointed to"); }
        return ptr_to(base);
    }
    decl_spec();
}

parse_expr() raises Error: *Expr { parse_assign(); }

parse_field_inits(members: ?*Member) raises Error: *FieldInit {
    skip(TokKind.LBrace);
    head: ?*FieldInit = null;
    cur: ?*FieldInit = null;
    while (tok.kind != TokKind.RBrace) {
        if (cur != null) { skip(TokKind.Comma); }
        if (tok.kind != TokKind.Ident) { error("expected field name"); }
        fname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TokKind.Colon);
        m: ?*Member = find_field(members, fname);
        if (m == null) { error("unknown field"); }
        mu: *Member = m;
        i: ?*FieldInit = head;
        while (i != null) {
            if (i.member == mu) { error("duplicate field"); }
            i = i.next;
        }
        lhs: ?*Expr = null;
        if (tok.kind == TokKind.Uninitialized) {
            tok = tok.next;
        } else {
            e: *Expr = parse_expr();
            lhs = e;
        }
        init: *FieldInit = new_field_init(mu, lhs);
        if (cur != null) {
            cur.next = init;
            cur = init;
        } else {
            head = init;
            cur = init;
        }
    }
    m2: ?*Member = members;
    while (m2 != null) {
        found: int = 0;
        i2: ?*FieldInit = head;
        while (i2 != null) {
            if (i2.member == m2) { found = 1; }
            i2 = i2.next;
        }
        if (found == 0) { error("missing field"); }
        m2 = m2.next;
    }
    skip(TokKind.RBrace);
    head or error("empty list");
}

parse_struct_field_inits(sty: *Type) raises Error: *FieldInit {
    if (!is_struct_ty(sty)) { error("struct literal requires a struct type"); }
    parse_field_inits(type_struct_def(sty).members);
}

parse_exn_field_inits(ed: *ExnDef) raises Error: *FieldInit {
    if (ed.members == null) { error("unit exception does not take fields"); }
    parse_field_inits(ed.members);
}

parse_variant_field_inits(v: *Variant) raises Error: *FieldInit { parse_field_inits(v.fields); }

parse_primary() raises Error: *Expr {
    n: *Expr = uninitialized;
    if (tok.kind == TokKind.New) {
        tok = tok.next;
        if (is_type_name() && (tok.next).kind == TokKind.Dot) {
            ety: *Type = parse_type();
            if (!is_enum_ty(ety)) { error("new Enum.Variant requires an enum type"); }
            skip(TokKind.Dot);
            if (tok.kind != TokKind.Ident) { error("expected variant name after new Enum."); }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            vo: ?*Variant = find_variant(type_enum_def(ety), vname);
            if (vo == null) { error("unknown variant"); }
            v: *Variant = vo;
            args: ?*FieldInit = null;
            if (tok.kind == TokKind.LBrace) {
                if (v.fields == null) { error("unit variant does not take fields"); }
                args = parse_variant_field_inits(v);
            } else {
                if (v.fields != null) { error("variant requires field initializers"); }
            }
            return new_heap_node(null, v.tag, args, v, ptr_to(ety));
        }
        base: *Type = parse_type();
        if (tok.kind == TokKind.LBrack) {
            tok = tok.next;
            len: *Expr = parse_expr();
            skip(TokKind.RBrack);
            if (is_pointer(base) || is_opt_pointer(base) || is_slice(base) || is_zptr(base) || is_view(base)) {
                error("new expects a non-pointer type");
            }
            return new_heap_node(len, 1, null, null, slice_of(base));
        }
        if (is_pointer(base)) { error("new expects a non-pointer type"); }
        if (tok.kind == TokKind.Uninitialized) {
            tok = tok.next;
            return new_heap_node(null, 1, null, null, ptr_to(base));
        }
        if (tok.kind != TokKind.LBrace) {
            error("expected uninitialized, {, [, or .Variant after new");
        }
        if (is_enum_ty(base)) {
            error("use new Enum.Variant { ... } for sum types");
        }
        return new_heap_node(null, 0, parse_struct_field_inits(base), null, ptr_to(base));
    }
    if (tok.kind == TokKind.Sizeof) {
        tok = tok.next;
        skip(TokKind.LParen);
        if (starts_type()) {
            ty: *Type = parse_type();
            ty = parse_type_suffix(ty);
            skip(TokKind.RParen);
            return new_num(type_size(ty));
        }
        n = parse_expr();
        skip(TokKind.RParen);
        add_type(n);
        return new_num(type_size(n.ty or error("missing type")));
    }
    if (tok.kind == TokKind.LParen) {
        tok = tok.next;
        n = parse_expr();
        skip(TokKind.RParen);
        return n;
    }
    if (tok.kind == TokKind.Num) {
        ival: int = tok.val;
        tok = tok.next;
        if (tok.kind == TokKind.I8) {
            if (ival < 0 || ival > 255) { error("i8 literal out of range"); }
            tok = tok.next;
            n = new_num(ival);
            n.ty = ty_i8;
            return n;
        }
        n = new_num(ival);
        return n;
    }
    if (tok.kind == TokKind.True || tok.kind == TokKind.False) {
        bv: int = 0;
        if (tok.kind == TokKind.True) { bv = 1; }
        n = new_num(bv);
        n.ty = ty_bool;
        tok = tok.next;
        return n;
    }
    if (tok.kind == TokKind.Null) {
        tok = tok.next;
        return new_null_expr();
    }
    if (tok.kind == TokKind.Char) {
        n = new_num(tok.val);
        n.ty = ty_i8;
        tok = tok.next;
        return n;
    }
    if (tok.kind == TokKind.Str) {
        label: int = add_string(source, tok.pos, tok.len);
        tok = tok.next;
        return new_str_num(label + 1);
    }
    if (tok.kind == TokKind.Ident) {
        name: *i8 = cur_tokstr();
        if (is_type_name() && (tok.next).kind == TokKind.Dot) {
            ety: *Type = parse_type();
            if (!is_enum_ty(ety)) { error("variant construction requires an enum type"); }
            skip(TokKind.Dot);
            if (tok.kind != TokKind.Ident) { error("expected variant name"); }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            vo: ?*Variant = find_variant(type_enum_def(ety), vname);
            if (vo == null) { error("unknown variant"); }
            v: *Variant = vo;
            args: ?*FieldInit = null;
            if (tok.kind == TokKind.LBrace) {
                if (v.fields == null) { error("unit variant does not take fields"); }
                args = parse_variant_field_inits(v);
            } else {
                if (v.fields != null) { error("variant requires field initializers"); }
            }
            return new_variant_lit(v, v.tag, args, ety);
        }
        if (is_type_name() && (tok.next).kind == TokKind.LBrace) {
            sty: *Type = parse_type();
            if (!is_struct_ty(sty)) { error("struct literal requires a struct type"); }
            return new_struct_lit(parse_struct_field_inits(sty), sty);
        }
        tok = tok.next;
        if (tok.kind == TokKind.LParen) {
            tok = tok.next;
            head: ?*Expr = null;
            cur: ?*Expr = null;
            while (tok.kind != TokKind.RParen) {
                if (cur != null) { skip(TokKind.Comma); }
                arg: *Expr = parse_expr();
                if (cur != null) {
                    cur.next = arg;
                    cur = arg;
                } else {
                    head = arg;
                    cur = arg;
                }
            }
            skip(TokKind.RParen);
            return new_funcall(name, head);
        }
        varo: ?*Obj = find_var(name);
        if (varo == null) { error("undefined variable"); }
        var: *Obj = varo;
        return new_var_node(var);
    }
    if (tok.kind == TokKind.If) { return parse_if_expr(); }
    if (tok.kind == TokKind.Match) { return parse_match_expr(); }
    if (tok.kind == TokKind.LBrace) { return new_block_expr(parse_brace_stmts()); }
    error("expected expression");
    new_num(0);
}

parse_if_expr() raises Error: *Expr {
    skip(TokKind.If);
    skip(TokKind.LParen);
    cond: *Expr = parse_expr();
    skip(TokKind.RParen);
    then: *Expr = parse_expr();
    if (tok.kind != TokKind.Else) { error("if expression requires else"); }
    tok = tok.next;
    els: *Expr = parse_expr();
    new_if_expr(cond, then, els);
}

parse_match_expr() raises Error: *Expr {
    skip(TokKind.Match);
    mcond: *Expr = parse_expr();
    new_match_expr(mcond, parse_match_arms(mcond));
}

parse_match_arms(mcond: *Expr) raises Error: ?*MatchArm {
    add_type(mcond);
    et: ?*Type = decay(mcond.ty);
    if (et == null) { error_ty("match requires an enum value", et); }
    if (!is_enum_ty(et)) { error_ty("match requires an enum value", et); }
    skip(TokKind.LBrace);
    arms: ?*MatchArm = null;
    acur: ?*MatchArm = null;
    while (tok.kind != TokKind.RBrace) {
        if (tok.kind != TokKind.Ident) { error("expected variant name in match arm"); }
        vname: *i8 = cur_tokstr();
        tok = tok.next;
        is_wild: bool = streq(vname, "_");
        binder_name: ?*i8 = null;
        if (tok.kind == TokKind.LParen) {
            /* Legacy Variant(name); prefer Variant name. */
            if (is_wild) { error("wildcard match arm cannot bind a payload"); }
            tok = tok.next;
            if (tok.kind != TokKind.Ident) { error("expected payload binding name"); }
            binder_name = cur_tokstr();
            tok = tok.next;
            skip(TokKind.RParen);
        } else {
            if (tok.kind == TokKind.Ident) {
                if (is_wild) { error("wildcard match arm cannot bind a payload"); }
                binder_name = cur_tokstr();
                tok = tok.next;
            } else {
                if (tok.kind == TokKind.LBrace) {
                    error("match field destructuring is not supported; use Variant name and field access");
                }
            }
        }
        skip(TokKind.Arrow);
        enter_scope();
        arm_variant_n: ?*Variant = null;
        arm_binder: ?*Obj = null;
        if (is_wild) {
            chk: ?*MatchArm = arms;
            while (chk != null) {
                if (chk.variant == null) { error("duplicate wildcard match arm"); }
                chk = chk.next;
            }
            if (binder_name != null) { error("wildcard match arm cannot bind a payload"); }
        } else {
            vo: ?*Variant = find_variant(type_enum_def(et), vname);
            if (vo == null) { error("unknown variant"); }
            v: *Variant = vo;
            chk2: ?*MatchArm = arms;
            while (chk2 != null) {
                if (chk2.variant == v) { error("duplicate match arm"); }
                chk2 = chk2.next;
            }
            arm_variant_n = v;
            if (binder_name != null) {
                if (v.payload_ty == null) { error("unit variant cannot bind a payload"); }
                bname: *i8 = binder_name;
                bo: *Obj = new_obj(bname, 1);
                bo.ty = v.payload_ty;
                arm_binder = bo;
            }
        }
        arm_body_n: *Stmt = parse_compound();
        leave_scope();
        arm: *MatchArm = new_match_arm(arm_variant_n, arm_binder, arm_body_n);
        if (acur != null) {
            acur.next = arm;
            acur = arm;
        } else {
            arms = arm;
            acur = arm;
        }
        if (is_wild) {
            if (tok.kind != TokKind.RBrace) { error("wildcard `_` must be the last match arm"); }
        }
    }
    has_wild: int = 0;
    walk: ?*MatchArm = arms;
    while (walk != null) {
        if (walk.variant == null) { has_wild = 1; }
        walk = walk.next;
    }
    if (has_wild == 0) {
        vv: ?*Variant = type_enum_def(et).variants;
        while (vv != null) {
            found2: int = 0;
            walk2: ?*MatchArm = arms;
            while (walk2 != null) {
                if (walk2.variant == vv) { found2 = 1; }
                walk2 = walk2.next;
            }
            if (found2 == 0) { error("match not exhaustive"); }
            vv = vv.next;
        }
    }
    tok = tok.next;
    arms;
}

parse_postfix() raises Error: *Expr {
    n: *Expr = parse_primary();
    while (true) {
        if (tok.kind == TokKind.LBrack) {
            tok = tok.next;
            idx: *Expr = parse_expr();
            skip(TokKind.RBrack);
            n = new_index(n, idx);
        } else {
            if (tok.kind == TokKind.Dot) {
                if ((tok.next).kind == TokKind.Star) {
                    tok = tok.next;
                    tok = tok.next;
                    n = new_deref(n);
                } else {
                    tok = tok.next;
                    if (tok.kind != TokKind.Ident) { error("expected member name"); }
                    name: *i8 = cur_tokstr();
                    tok = tok.next;
                    add_type(n);
                    t: ?*Type = decay(n.ty);
                    sty: *Type = n.ty or error("missing type");
                    if (t != null && is_opt_pointer(t)) {
                        error_ty("member access on optional pointer (use if (p != null) / while (p != null) to narrow)", t);
                    }
                    if (t != null && is_pointer(t) && is_struct_ty(type_base(t))) {
                        sty = type_base(t);
                    } else {
                        if (t != null && is_pointer(t) && is_exn_ty(type_base(t))) {
                            sty = type_base(t);
                        } else {
                            if (!is_struct_ty(sty) && !is_exn_ty(sty)) { error_ty("member access on non-struct", n.ty); }
                        }
                    }
                    m: ?*Member = null;
                    if (is_exn_ty(sty)) {
                        m = find_exn_member(type_exn_def(sty), name);
                    } else { m = find_member(type_struct_def(sty), name); }
                    if (m == null) { error("unknown member"); }
                    mu: *Member = m;
                    n = new_member_access(n, mu);
                }
            } else {
                if (tok.kind == TokKind.As || tok.kind == TokKind.Trunc) {
                    is_trunc: bool = tok.kind == TokKind.Trunc;
                    tok = tok.next;
                    ty: *Type = parse_type();
                    ty = parse_type_suffix(ty);
                    if (is_trunc) {
                        n = new_trunc(n, ty);
                    } else { n = new_as(n, ty); }
                } else { return n; }
            }
        }
    }
    n;
}

parse_unary() raises Error: *Expr {
    if (tok.kind == TokKind.Plus) {
        tok = tok.next;
        return parse_unary();
    }
    if (tok.kind == TokKind.Minus) {
        tok = tok.next;
        return new_neg(parse_unary());
    }
    if (tok.kind == TokKind.Amp) {
        tok = tok.next;
        return new_addr(parse_unary());
    }
    if (tok.kind == TokKind.Not) {
        tok = tok.next;
        return new_not(parse_unary());
    }
    if (tok.kind == TokKind.Tilde) {
        tok = tok.next;
        return new_bitnot(parse_unary());
    }
    parse_postfix();
}

add_type(n: ?*Expr) raises Error {
    if (n != null) { add_type_expr(n); }
}

add_type_stmt(s: ?*Stmt) raises Error {
    if (s != null) { add_type_stmt_node(s); }
}

add_type_field_inits(inits: ?*FieldInit) raises Error {
    a: ?*FieldInit = inits;
    while (a != null) {
        add_type(a.lhs);
        if (a.lhs != null) {
            if (!assignable(decay(a.member.ty), a.lhs)) {
                error_have_expr_want("field initializer type mismatch", a.lhs, decay(a.member.ty));
            }
        }
        a = a.next;
    }
}

type_index_expr(p: *Expr, lhs: *Expr, idx: *Expr) raises Error {
    add_type(lhs);
    add_type(idx);
    idt: ?*Type = decay(idx.ty);
    if (idt == null || !is_int_ty(idt)) { error("array index must be int"); }
    raw: ?*Type = lhs.ty;
    if (raw == null) { error_ty("index of untyped expression", raw); }
    if (is_opt_pointer(raw)) {
        error_ty("index of optional pointer (use if (p != null) to narrow)", raw);
    }
    if (is_pointer(raw)) {
        error_ty("pointer indexing is not allowed (use []T or [z]T)", raw);
    }
    if (!is_indexable(raw)) { error_ty("index of non-array", raw); }
    if (is_zptr(raw)) {
        if (!zindex_ok(index_lhs_var(lhs), idx)) {
            error("C-string index not walked");
        }
    }
    p.ty = type_base(raw);
}

type_log(p: *Expr, lhs: *Expr, rhs: *Expr, and_op: int) raises Error {
    add_type(lhs);
    save: ?*NarrowFrame = narrow_top;
    wsave: ?*WalkFrame = walk_top;
    if (and_op != 0) {
        narrow_push_ne_nulls(lhs);
        walk_advance_cond(lhs);
    } else { narrow_push_eq_nulls(lhs); }
    add_type(rhs);
    narrow_reset(save);
    walk_reset(wsave);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) { error_have_and("&& / || require bool operands", lt, rt); }
    if (rt == null) { error_have_and("&& / || require bool operands", lt, rt); }
    if (!is_bool_ty(lt) || !is_bool_ty(rt)) {
        error_have_and("&& / || require bool operands", lt, rt);
    }
    p.ty = ty_bool;
}

type_or_else(p: *Expr, lhs: *Expr, rhs: *Expr) raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) { error_ty("or requires an optional pointer on the left", lt); }
    if (!is_opt_pointer(lt)) { error_ty("or requires an optional pointer on the left", lt); }
    unwrapped: *Type = ptr_to(type_base(lt));
    if (rt != null && is_noreturn_ty(rt)) {
        p.ty = unwrapped;
        return;
    }
    if (rt != null && is_pointer(rt) && types_equal(type_base(rt), type_base(lt))) {
        p.ty = unwrapped;
        return;
    }
    error_have_want("or right-hand side must be *T or noreturn", rt, unwrapped);
}

type_int_arith(p: *Expr, lhs: *Expr, rhs: *Expr) raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) { error_have_and("arithmetic requires int or i8 operands", lt, rt); }
    if (rt == null) { error_have_and("arithmetic requires int or i8 operands", lt, rt); }
    if (is_int_ty(lt) && is_int_ty(rt)) {
        p.ty = ty_int;
        return;
    }
    if (is_i8_ty(lt) && is_i8_ty(rt)) {
        p.ty = ty_i8;
        return;
    }
    error_have_and("arithmetic type mismatch", lt, rt);
}

type_shift(p: *Expr, lhs: *Expr, rhs: *Expr) raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) { error_have_and("shift requires int or i8 left operand", lt, rt); }
    if (rt == null) { error_have_and("shift count requires int", lt, rt); }
    if (!is_int_ty(rt)) { error_have_and("shift count requires int", lt, rt); }
    if (is_i8_ty(lt)) {
        p.ty = ty_i8;
        return;
    }
    if (is_int_ty(lt)) {
        p.ty = ty_int;
        return;
    }
    error_have_and("shift requires int or i8 left operand", lt, rt);
}

type_eq_cmp(p: *Expr, lhs: *Expr, rhs: *Expr) raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt != null && rt != null) {
        if (types_equal(lt, rt)) {
            p.ty = ty_bool;
            return;
        }
        if (is_any_pointer(lt) && is_any_pointer(rt) && types_equal(type_base(lt), type_base(rt))) {
            p.ty = ty_bool;
            return;
        }
    }
    if (bind_null_to_pointer(lt, rhs) || bind_null_to_pointer(rt, lhs)) {
        p.ty = ty_bool;
        return;
    }
    error_ty_vs("comparison type mismatch", lt, rt);
}

type_ord_cmp(p: *Expr, lhs: *Expr, rhs: *Expr) raises Error {
    add_type(lhs);
    add_type(rhs);
    lt: ?*Type = decay(lhs.ty);
    rt: ?*Type = decay(rhs.ty);
    if (lt == null) { error_ty_vs("comparison type mismatch", lt, rt); }
    if (rt == null) { error_ty_vs("comparison type mismatch", lt, rt); }
    if (!types_equal(lt, rt)) {
        error_ty_vs("comparison type mismatch", lt, rt);
    }
    p.ty = ty_bool;
}

type_binary(p: *Expr, op: BinOp, lhs: *Expr, rhs: *Expr) raises Error {
    match op {
        Add -> {
            add_type(lhs);
            add_type(rhs);
            lt: ?*Type = decay(lhs.ty);
            rt: ?*Type = decay(rhs.ty);
            if (lt == null) { error_have_and("arithmetic requires int or i8 operands", lt, rt); }
            if (rt == null) { error_have_and("arithmetic requires int or i8 operands", lt, rt); }
            type_int_arith(p, lhs, rhs);
            return;
        }
        Sub -> {
            add_type(lhs);
            add_type(rhs);
            lt: ?*Type = decay(lhs.ty);
            rt: ?*Type = decay(rhs.ty);
            if (lt == null) { error_have_and("arithmetic requires int or i8 operands", lt, rt); }
            if (rt == null) { error_have_and("arithmetic requires int or i8 operands", lt, rt); }
            type_int_arith(p, lhs, rhs);
            return;
        }
        Mul -> { type_int_arith(p, lhs, rhs); return; }
        Div -> { type_int_arith(p, lhs, rhs); return; }
        Mod -> { type_int_arith(p, lhs, rhs); return; }
        And -> { type_int_arith(p, lhs, rhs); return; }
        Or -> { type_int_arith(p, lhs, rhs); return; }
        Xor -> { type_int_arith(p, lhs, rhs); return; }
        Shl -> { type_shift(p, lhs, rhs); return; }
        Shr -> { type_shift(p, lhs, rhs); return; }
        Eq -> { type_eq_cmp(p, lhs, rhs); return; }
        Ne -> { type_eq_cmp(p, lhs, rhs); return; }
        Lt -> { type_ord_cmp(p, lhs, rhs); return; }
        Le -> { type_ord_cmp(p, lhs, rhs); return; }
        Gt -> { type_ord_cmp(p, lhs, rhs); return; }
        Ge -> { type_ord_cmp(p, lhs, rhs); return; }
    }
}

unify_value_ty(a: ?*Type, b: ?*Type) raises Error: ?*Type {
    if (a == null && b == null) { return null; }
    if (a == null) {
        if (b != null && is_noreturn_ty(b)) { return null; }
        error_ty_vs("branch type mismatch", a, b);
    }
    if (b == null) {
        if (is_noreturn_ty(a)) { return null; }
        error_ty_vs("branch type mismatch", a, b);
    }
    au: *Type = a;
    bu: *Type = b;
    if (is_noreturn_ty(au)) { return bu; }
    if (is_noreturn_ty(bu)) { return au; }
    da: ?*Type = decay(au);
    db: ?*Type = decay(bu);
    if (da != null && db != null && types_equal(da, db)) { return da; }
    if (da != null && db != null && is_opt_pointer(da) && is_pointer(db) && types_equal(type_base(da), type_base(db))) { return da; }
    if (da != null && db != null && is_opt_pointer(db) && is_pointer(da) && types_equal(type_base(db), type_base(da))) { return db; }
    error_ty_vs("branch type mismatch", da, db);
    null;
}

opt_ptr_of(t: ?*Type) raises Error: *Type {
    if (t == null) { error("null requires a pointer type"); }
    d: ?*Type = decay(t);
    if (d == null) { error("null requires a pointer type"); }
    if (is_opt_pointer(d)) { return d; }
    if (is_pointer(d)) { return opt_ptr_to(type_base(d)); }
    error_ty("null requires a pointer type", d);
    d;
}

unify_value_results(a: ?*Type, a_null: bool, b: ?*Type, b_null: bool) raises Error: ?*Type {
    if (a_null && b_null) { return null; }
    if (a_null) {
        if (b != null && is_noreturn_ty(b)) { return null; }
        return opt_ptr_of(b);
    }
    if (b_null) {
        if (a != null && is_noreturn_ty(a)) { return null; }
        return opt_ptr_of(a);
    }
    unify_value_ty(a, b);
}

last_stmt(head: ?*Stmt): ?*Stmt {
    s: ?*Stmt = head;
    last: ?*Stmt = null;
    while (s != null) {
        last = s;
        s = s.next;
    }
    last;
}

is_null_value_expr(n: ?*Expr): bool {
    if (n == null) { return false; }
    match n.kind {
        Null -> { true; }
        Block q -> { stmt_is_null_value(last_stmt(q.body)); }
        If q -> {
            then_n: bool = is_null_value_expr(q.then);
            els_n: bool = is_null_value_expr(q.els);
            then_d: bool = false;
            tty: ?*Type = q.then.ty;
            if (tty != null && is_noreturn_ty(tty)) { then_d = true; }
            els_d: bool = false;
            ety: ?*Type = q.els.ty;
            if (ety != null && is_noreturn_ty(ety)) { els_d = true; }
            if (!then_n && !then_d) { return false; }
            if (!els_n && !els_d) { return false; }
            then_n || els_n;
        }
        Match q -> { match_arms_null_like(q.arms); }
        _ -> { false; }
    }
}

stmt_is_null_value(s: ?*Stmt): bool {
    if (s == null) { return false; }
    match s.kind {
        ExprStmt k -> { is_null_value_expr(k.lhs); }
        Block k -> { stmt_is_null_value(last_stmt(k.body)); }
        If k -> {
            els: ?*Stmt = k.els;
            if (els == null) { return false; }
            then_n: bool = stmt_is_null_value(k.then);
            els_n: bool = stmt_is_null_value(els);
            then_d: bool = stmt_always_diverges(k.then);
            els_d: bool = stmt_always_diverges(els);
            if (!then_n && !then_d) { return false; }
            if (!els_n && !els_d) { return false; }
            then_n || els_n;
        }
        Match k -> { match_arms_null_like(k.arms); }
        Try k -> {
            if (!stmt_is_null_value(k.body) && !stmt_always_diverges(k.body)) { return false; }
            any_null: bool = stmt_is_null_value(k.body);
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                if (stmt_is_null_value(arm.body)) { any_null = true; }
                else {
                    if (!stmt_always_diverges(arm.body)) { return false; }
                }
                arm = arm.next;
            }
            any_null;
        }
        _ -> { false; }
    }
}

match_arms_null_like(arms: ?*MatchArm): bool {
    any_null: bool = false;
    arm: ?*MatchArm = arms;
    while (arm != null) {
        if (stmt_is_null_value(arm.body)) { any_null = true; }
        else {
            if (!stmt_always_diverges(arm.body)) { return false; }
        }
        arm = arm.next;
    }
    any_null;
}

match_result_ty(arms: ?*MatchArm) raises Error: ?*Type {
    t: ?*Type = ty_noreturn;
    t_null: bool = false;
    saw: int = 0;
    arm: ?*MatchArm = arms;
    while (arm != null) {
        at: ?*Type = stmt_result_ty(arm.body);
        an: bool = stmt_is_null_value(arm.body);
        if (saw == 0) {
            t = at;
            t_null = an;
        } else {
            t = unify_value_results(t, t_null, at, an);
            t_null = false;
            if (t == null) { t_null = true; }
        }
        saw = 1;
        arm = arm.next;
    }
    t;
}

stmt_result_ty(s: ?*Stmt) raises Error: ?*Type {
    if (s == null) { return null; }
    match s.kind {
        ExprStmt k -> { decay(k.lhs.ty); }
        Return _p -> { ty_noreturn; }
        Raise _p -> { ty_noreturn; }
        Block k -> { stmt_result_ty(last_stmt(k.body)); }
        If k -> {
            els: ?*Stmt = k.els;
            if (els == null) { return null; }
            unify_value_results(stmt_result_ty(k.then), stmt_is_null_value(k.then), stmt_result_ty(els), stmt_is_null_value(els));
        }
        Match k -> { match_result_ty(k.arms); }
        Try k -> {
            t: ?*Type = stmt_result_ty(k.body);
            t_null: bool = stmt_is_null_value(k.body);
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                t = unify_value_results(t, t_null, stmt_result_ty(arm.body), stmt_is_null_value(arm.body));
                t_null = false;
                if (t == null) { t_null = true; }
                arm = arm.next;
            }
            t;
        }
        _ -> { null; }
    }
}

check_stmt_result(s: ?*Stmt, want: *Type) raises Error: bool {
    if (s == null) { return false; }
    match s.kind {
        Return _p -> { true; }
        Raise _p -> { true; }
        ExprStmt k -> {
            lty: ?*Type = k.lhs.ty;
            if (lty != null && is_noreturn_ty(lty)) { return true; }
            if (assignable(want, k.lhs)) { return true; }
            error_have_expr_want("return type mismatch", k.lhs, want);
            false;
        }
        Block k -> { check_stmt_result(last_stmt(k.body), want); }
        If k -> {
            els: ?*Stmt = k.els;
            if (els == null) { return false; }
            if (!check_stmt_result(k.then, want)) { return false; }
            check_stmt_result(els, want);
        }
        Match k -> {
            if (k.arms == null) { return false; }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!check_stmt_result(arm.body, want)) { return false; }
                arm = arm.next;
            }
            true;
        }
        Try k -> {
            if (!check_stmt_result(k.body, want)) { return false; }
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!check_stmt_result(arm2.body, want)) { return false; }
                arm2 = arm2.next;
            }
            true;
        }
        _ -> { false; }
    }
}

type_if_expr(p: *Expr, cond: *Expr, then: *Expr, els: *Expr) raises Error {
    add_type(cond);
    ct: ?*Type = decay(cond.ty);
    if (ct == null || !is_bool_ty(ct)) { error_ty("condition must be bool", ct); }
    save: ?*NarrowFrame = narrow_top;
    wsave: ?*WalkFrame = walk_top;
    narrow_push_ne_nulls(cond);
    walk_advance_cond(cond);
    add_type(then);
    narrow_reset(save);
    walk_reset(wsave);
    narrow_push_eq_nulls(cond);
    add_type(els);
    narrow_reset(save);
    walk_reset(wsave);
    tt: ?*Type = decay(then.ty);
    et: ?*Type = decay(els.ty);
    tn: bool = is_null_value_expr(then);
    en: bool = is_null_value_expr(els);
    if (tt == null && !tn && (et == null || !is_noreturn_ty(et))) { error("if expression branch must produce a value"); }
    if (et == null && !en && (tt == null || !is_noreturn_ty(tt))) { error("if expression branch must produce a value"); }
    p.ty = unify_value_results(tt, tn, et, en);
    if (p.ty == null) {
        if (tn || en) { return; }
        error("if expression branch must produce a value");
    }
    if (tn) { bind_null_to_pointer(p.ty, then); }
    if (en) { bind_null_to_pointer(p.ty, els); }
}

type_match_expr(p: *Expr, cond: *Expr, arms: ?*MatchArm) raises Error {
    add_type(cond);
    arm: ?*MatchArm = arms;
    while (arm != null) {
        add_type_stmt(arm.body);
        arm = arm.next;
    }
    t: ?*Type = match_result_ty(arms);
    if (t == null) {
        if (match_arms_null_like(arms)) {
            p.ty = null;
            return;
        }
        error("match expression arm must produce a value");
    }
    p.ty = t;
}

type_block_expr(p: *Expr, body: ?*Stmt) raises Error {
    s: ?*Stmt = body;
    while (s != null) {
        add_type_stmt(s);
        match s.kind {
            If k -> {
                if (k.els == null) {
                    if (stmt_always_diverges(k.then)) {
                        narrow_push_eq_nulls(k.cond);
                    }
                }
            }
            _ -> {}
        }
        s = s.next;
    }
    p.ty = stmt_result_ty(last_stmt(body));
}

add_type_expr(p: *Expr) raises Error {
    match p.kind {
        Var q -> {
            p.ty = var_view_ty(q.var);
            return;
        }
        As q -> {
            add_type(q.lhs);
            check_as(q.lhs.ty, p.ty);
            return;
        }
        Trunc q -> {
            add_type(q.lhs);
            check_trunc(q.lhs.ty, p.ty);
            return;
        }
        New k -> {
            lhs: ?*Expr = k.lhs;
            add_type(lhs);
            if (lhs != null) {
                lht: ?*Type = decay(lhs.ty);
                if (lht == null) { error_ty("array length must be int", lht); }
                if (!is_int_ty(lht)) {
                    error_ty("array length must be int", lht);
                }
            }
            add_type_field_inits(k.inits);
            return;
        }
        StructLit k -> {
            add_type_field_inits(k.inits);
            return;
        }
        VariantLit k -> {
            add_type_field_inits(k.inits);
            return;
        }
        MemberAccess q -> {
            add_type(q.lhs);
            t0: ?*Type = decay(q.lhs.ty);
            if (t0 != null && is_opt_pointer(t0)) {
                error_ty("member access on optional pointer (use if (p != null) / while (p != null) to narrow)", t0);
            }
            mem: *Member = q.member;
            p.ty = mem.ty;
            return;
        }
        _ -> {}
    }
    if (p.ty != null) { return; }
    match p.kind {
        LogAnd q -> { type_log(p, q.lhs, q.rhs, 1); return; }
        LogOr q -> { type_log(p, q.lhs, q.rhs, 0); return; }
        OrElse q -> { type_or_else(p, q.lhs, q.rhs); return; }
        If q -> { type_if_expr(p, q.cond, q.then, q.els); return; }
        Match q -> { type_match_expr(p, q.cond, q.arms); return; }
        Block q -> { type_block_expr(p, q.body); return; }
        Num k -> {
            if (k.str_label != 0) { p.ty = slice_of(ty_i8); return; }
            p.ty = ty_int;
            return;
        }
        Index q -> { type_index_expr(p, q.lhs, q.idx); return; }
        Null -> { return; }
        Binary q -> { type_binary(p, q.op, q.lhs, q.rhs); return; }
        Not q -> {
            add_type(q.lhs);
            nt: ?*Type = decay(q.lhs.ty);
            if (nt == null) { error_ty("! requires bool", nt); }
            if (!is_bool_ty(nt)) { error_ty("! requires bool", nt); }
            p.ty = ty_bool;
            return;
        }
        Neg q -> {
            add_type(q.lhs);
            nt: ?*Type = decay(q.lhs.ty);
            if (nt == null) { error_ty("unary - requires int or i8", nt); }
            if (is_i8_ty(nt)) { p.ty = ty_i8; return; }
            if (!is_int_ty(nt)) { error_ty("unary - requires int or i8", nt); }
            p.ty = ty_int;
            return;
        }
        BitNot q -> {
            add_type(q.lhs);
            nt: ?*Type = decay(q.lhs.ty);
            if (nt == null) { error_ty("~ requires int or i8", nt); }
            if (is_i8_ty(nt)) { p.ty = ty_i8; return; }
            if (!is_int_ty(nt)) { error_ty("~ requires int or i8", nt); }
            p.ty = ty_int;
            return;
        }
        Assign q -> {
            add_type(q.lhs);
            add_type(q.rhs);
            lt: ?*Type = null;
            storage: ?*Type = q.lhs.ty;
            match q.lhs.kind {
                Var vp -> {
                    var: ?*Obj = vp.var;
                    if (var != null) {
                        storage = var.ty;
                        lt = decay(var.ty);
                    } else { lt = decay(q.lhs.ty); }
                }
                _ -> { lt = decay(q.lhs.ty); }
            }
            if (storage != null && is_array(storage)) { error("cannot assign to array"); }
            if (!assignable(lt, q.rhs)) {
                error_have_expr_want("assignment type mismatch", q.rhs, lt);
            }
            match q.lhs.kind {
                Var vp -> {
                    if (expr_is_zero_lit(q.rhs)) { mark_zero_var(vp.var); }
                }
                _ -> {}
            }
            p.ty = storage;
            return;
        }
        Addr q -> {
            add_type(q.lhs);
            match q.lhs.kind {
                Index ik -> {
                    ilt: ?*Type = ik.lhs.ty;
                    if (ilt != null && is_zptr(ilt)) {
                        p.ty = ilt;
                        return;
                    }
                    if (ilt != null && is_indexable(ilt)) {
                        p.ty = ptr_to(type_base(ilt));
                        return;
                    }
                }
                _ -> {}
            }
            aty: ?*Type = q.lhs.ty;
            if (aty != null && is_array(aty)) {
                p.ty = ptr_to(type_base(aty));
            } else { p.ty = ptr_to(aty or error("missing type")); }
            return;
        }
        Deref q -> {
            add_type(q.lhs);
            t: ?*Type = decay(q.lhs.ty);
            if (t == null) { error_ty("dereferencing non-pointer", t); }
            if (is_opt_pointer(t)) {
                error_ty("dereferencing optional pointer (use if (p != null) / while (p != null) to narrow)", t);
            }
            if (is_pointer(t)) {
                p.ty = type_base(t);
            } else { error_ty("dereferencing non-pointer", t); }
            return;
        }
        Funcall q -> {
            a: ?*Expr = q.args;
            while (a != null) {
                add_type(a);
                a = a.next;
            }
            lenarg: ?*Expr = q.args;
            if (streq(q.funcname, "len") && lenarg != null) {
              if (lenarg.next == null) {
                at: ?*Type = lenarg.ty;
                if (at != null && is_array(at)) {
                    p.kind = ExprKind.Num { val: type_array_len(at), str_label: 0 };
                    p.ty = ty_int;
                    return;
                }
                if (at != null && is_view(at)) {
                    bn: *i8 = uninitialized;
                    match at.* {
                        View vk -> { bn = vk.bound; }
                        _ -> { error("not a view"); }
                    }
                    bo: ?*Obj = find_var(bn);
                    if (bo == null) { error("view bound is not in scope"); }
                    p.kind = ExprKind.Var { var: bo, name: bn, member: null };
                    p.ty = ty_int;
                    return;
                }
                if (at != null && is_zptr(at)) {
                    error("len is not defined on [z]T (walk with cstr_len)");
                }
              }
            }
            fno: ?*Function = find_function(q.funcname);
            p.kind = ExprKind.Funcall { funcname: q.funcname, args: q.args, fn: fno };
            fo: ?*Obj = find_obj(globals, q.funcname);
            if (fno != null) {
                if (fno.return_ty != null) {
                    p.ty = fno.return_ty;
                } else { p.ty = ty_int; }
            } else {
                if (fo != null) {
                    if (fo.is_func != 0) {
                        if (fo.ty != null) {
                            p.ty = fo.ty;
                        } else { p.ty = ty_int; }
                    } else { p.ty = ty_int; }
                } else {
                    if (streq(q.funcname, "exit")) {
                        p.ty = ty_noreturn;
                    } else { p.ty = ty_int; }
                }
            }
            if (fno != null) {
                a = q.args;
                po: ?*Obj = fno.params;
                while (a != null) {
                    if (po != null) {
                        if (po.ty != null) {
                            pt: ?*Type = decay(po.ty);
                            if (!assignable(pt, a)) {
                                error_have_expr_want("argument type mismatch", a, pt);
                            }
                        }
                        po = po.param_next;
                    }
                    a = a.next;
                }
                er: ?*ExnList = fno.raises_list;
                while (er != null) {
                    check_exn_allowed(er.exn, "call raises");
                    er = er.next;
                }
            }
            return;
        }
        _ -> {}
    }
}

add_type_stmt_node(p: *Stmt) raises Error {
    match p.kind {
        If k -> {
            add_type(k.cond);
            ct: ?*Type = decay(k.cond.ty);
            if (ct == null || !is_bool_ty(ct)) { error_ty("condition must be bool", ct); }
            save: ?*NarrowFrame = narrow_top;
            wsave: ?*WalkFrame = walk_top;
            narrow_push_ne_nulls(k.cond);
            walk_advance_cond(k.cond);
            add_type_stmt(k.then);
            narrow_reset(save);
            walk_reset(wsave);
            els: ?*Stmt = k.els;
            if (els != null) {
                narrow_push_eq_nulls(k.cond);
                add_type_stmt(els);
                narrow_reset(save);
                walk_reset(wsave);
            }
            return;
        }
        While k -> {
            add_type(k.cond);
            ct2: ?*Type = decay(k.cond.ty);
            if (ct2 == null || !is_bool_ty(ct2)) { error_ty("condition must be bool", ct2); }
            save2: ?*NarrowFrame = narrow_top;
            wsave2: ?*WalkFrame = walk_top;
            narrow_push_ne_nulls(k.cond);
            walk_advance_cond(k.cond);
            add_type_stmt(k.body);
            narrow_reset(save2);
            walk_reset(wsave2);
            return;
        }
        Try k -> {
            saved_c: ?*CatchFrame = catch_top;
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                catch_push(arm.exn);
                arm = arm.next;
            }
            add_type_stmt(k.body);
            catch_reset(saved_c);
            arm = k.arms;
            while (arm != null) {
                add_type_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Raise k -> {
            check_exn_allowed(k.exn, "raise");
            add_type_field_inits(k.inits);
            return;
        }
        Block q -> {
            a: ?*Stmt = q.body;
            while (a != null) {
                add_type_stmt(a);
                match a.kind {
                    If k -> {
                        if (k.els == null) {
                            if (stmt_always_diverges(k.then)) {
                                narrow_push_eq_nulls(k.cond);
                            }
                        }
                    }
                    _ -> {}
                }
                a = a.next;
            }
            return;
        }
        Return k -> {
            crt: ?*Type = current_return_ty;
            if (crt != null && is_noreturn_ty(crt)) {
                error("noreturn function cannot return");
            }
            lhs: ?*Expr = k.lhs;
            add_type(lhs);
            if (lhs != null) {
                if (current_return_ty == null) { error("return with a value in a non-returning function"); }
                rt: ?*Type = decay(current_return_ty);
                if (!assignable(rt, lhs)) {
                    error_have_expr_want("return type mismatch", lhs, rt);
                }
            } else {
                if (current_return_ty != null) {
                    error_ty("return missing a value", current_return_ty);
                }
            }
            return;
        }
        ExprStmt k -> {
            add_type(k.lhs);
            return;
        }
        Match k -> {
            add_type(k.cond);
            a5: ?*MatchArm = k.arms;
            while (a5 != null) {
                add_type_stmt(a5.body);
                a5 = a5.next;
            }
            return;
        }
        _ -> {}
    }
}

parse_mul() raises Error: *Expr {
    n: *Expr = parse_unary();
    while (true) {
        if (tok.kind == TokKind.Star) {
            tok = tok.next;
            n = new_binary(BinOp.Mul, n, parse_unary());
        } else if (tok.kind == TokKind.Slash) {
            tok = tok.next;
            n = new_binary(BinOp.Div, n, parse_unary());
        } else if (tok.kind == TokKind.Percent) {
            tok = tok.next;
            n = new_binary(BinOp.Mod, n, parse_unary());
        } else { return n; }
    }
    n;
}

parse_add() raises Error: *Expr {
    n: *Expr = parse_mul();
    while (true) {
        if (tok.kind == TokKind.Plus) {
            tok = tok.next;
            n = new_binary(BinOp.Add, n, parse_mul());
        } else if (tok.kind == TokKind.Minus) {
            tok = tok.next;
            n = new_binary(BinOp.Sub, n, parse_mul());
        } else { return n; }
    }
    n;
}

parse_shift() raises Error: *Expr {
    n: *Expr = parse_add();
    while (true) {
        if (tok.kind == TokKind.Shl) {
            tok = tok.next;
            n = new_binary(BinOp.Shl, n, parse_add());
        } else if (tok.kind == TokKind.Shr) {
            tok = tok.next;
            n = new_binary(BinOp.Shr, n, parse_add());
        } else { return n; }
    }
    n;
}

parse_relational() raises Error: *Expr {
    n: *Expr = parse_shift();
    while (true) {
        if (tok.kind == TokKind.Lt) {
            tok = tok.next;
            n = new_binary(BinOp.Lt, n, parse_shift());
        } else if (tok.kind == TokKind.Gt) {
            tok = tok.next;
            n = new_binary(BinOp.Gt, n, parse_shift());
        } else if (tok.kind == TokKind.Le) {
            tok = tok.next;
            n = new_binary(BinOp.Le, n, parse_shift());
        } else if (tok.kind == TokKind.Ge) {
            tok = tok.next;
            n = new_binary(BinOp.Ge, n, parse_shift());
        } else { return n; }
    }
    n;
}

parse_equality() raises Error: *Expr {
    n: *Expr = parse_relational();
    while (true) {
        if (tok.kind == TokKind.Eq) {
            tok = tok.next;
            n = new_binary(BinOp.Eq, n, parse_relational());
        } else if (tok.kind == TokKind.Ne) {
            tok = tok.next;
            n = new_binary(BinOp.Ne, n, parse_relational());
        } else { return n; }
    }
    n;
}

parse_bitand() raises Error: *Expr {
    n: *Expr = parse_equality();
    while (tok.kind == TokKind.Amp) {
        tok = tok.next;
        n = new_binary(BinOp.And, n, parse_equality());
    }
    n;
}

parse_bitxor() raises Error: *Expr {
    n: *Expr = parse_bitand();
    while (tok.kind == TokKind.Caret) {
        tok = tok.next;
        n = new_binary(BinOp.Xor, n, parse_bitand());
    }
    n;
}

parse_bitor() raises Error: *Expr {
    n: *Expr = parse_bitxor();
    while (tok.kind == TokKind.Pipe) {
        tok = tok.next;
        n = new_binary(BinOp.Or, n, parse_bitxor());
    }
    n;
}

parse_logand() raises Error: *Expr {
    n: *Expr = parse_bitor();
    while (tok.kind == TokKind.And) {
        tok = tok.next;
        n = new_logand(n, parse_bitor());
    }
    n;
}

parse_logor() raises Error: *Expr {
    n: *Expr = parse_logand();
    while (tok.kind == TokKind.Or) {
        tok = tok.next;
        n = new_logor(n, parse_logand());
    }
    n;
}

parse_or_else() raises Error: *Expr {
    n: *Expr = parse_logor();
    if (tok.kind == TokKind.OrKw) {
        tok = tok.next;
        return new_or_else(n, parse_or_else());
    }
    n;
}

parse_assign() raises Error: *Expr {
    n: *Expr = parse_or_else();
    if (tok.kind == TokKind.Assign) {
        tok = tok.next;
        return new_assign(n, parse_assign());
    }
    n;
}

parse_type_suffix(ty: *Type) raises Error: *Type {
    if (tok.kind == TokKind.LBrack) { error("[n]T is not supported (use []T)"); }
    ty;
}

parse_decl(is_local: int) raises Error: *Obj {
    if (tok.kind != TokKind.Ident) { error("expected identifier"); }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Colon);
    ty: *Type = parse_type();
    ty = parse_type_suffix(ty);
    if (is_noreturn_ty(ty)) { error("noreturn is only valid as a function return type"); }
    o: *Obj = new_obj(name, is_local);
    o.ty = ty;
    o;
}

parse_compound() raises Error: *Stmt {
    new_block(parse_brace_stmts());
}

parse_brace_stmts() raises Error: ?*Stmt {
    enter_scope();
    skip(TokKind.LBrace);
    head: ?*Stmt = null;
    cur: ?*Stmt = null;
    while (tok.kind != TokKind.RBrace) {
        if (tok.kind == TokKind.Eof) { error("unterminated block"); }
        s: *Stmt = parse_stmt();
        if (cur != null) {
            cur.next = s;
            cur = s;
        } else {
            head = s;
            cur = s;
        }
    }
    skip(TokKind.RBrace);
    leave_scope();
    head;
}

parse_stmt() raises Error: *Stmt {
    if (tok.kind == TokKind.Return) {
        tok = tok.next;
        lhs: ?*Expr = null;
        if (tok.kind != TokKind.Semi) { lhs = parse_expr(); }
        skip(TokKind.Semi);
        return new_return(lhs);
    }
    if (tok.kind == TokKind.Raise) {
        tok = tok.next;
        if (tok.kind != TokKind.Ident) { error("expected exception name after raise"); }
        ename: *i8 = cur_tokstr();
        ed: ?*ExnDef = find_exn(ename);
        if (ed == null) { error("unknown exception"); }
        edu: *ExnDef = ed;
        tok = tok.next;
        rargs: ?*FieldInit = null;
        if (tok.kind == TokKind.LBrace) {
            rargs = parse_exn_field_inits(edu);
        } else {
            if (edu.members != null) { error("exception requires field initializers"); }
        }
        skip(TokKind.Semi);
        return new_raise(edu, rargs);
    }
    if (tok.kind == TokKind.Try) {
        tok = tok.next;
        tbody: *Stmt = parse_compound();
        arms_h: ?*CatchArm = null;
        arms_c: ?*CatchArm = null;
        if (tok.kind != TokKind.With) { error("try requires at least one with arm"); }
        while (tok.kind == TokKind.With) {
            tok = tok.next;
            if (tok.kind != TokKind.Ident) { error("expected exception name in with arm"); }
            cname: *i8 = cur_tokstr();
            ced: ?*ExnDef = find_exn(cname);
            if (ced == null) { error("unknown exception"); }
            cedu: *ExnDef = ced;
            tok = tok.next;
            a: ?*CatchArm = arms_h;
            while (a != null) {
                if (a.exn == cedu) { error("duplicate with arm"); }
                a = a.next;
            }
            enter_scope();
            binder: ?*Obj = null;
            if (tok.kind == TokKind.LParen) {
                /* Legacy Name(x); prefer Name x. */
                tok = tok.next;
                if (tok.kind != TokKind.Ident) { error("expected binder name"); }
                bname: *i8 = cur_tokstr();
                tok = tok.next;
                skip(TokKind.RParen);
                bo: *Obj = new_obj(bname, 1);
                bo.ty = exn_type(cedu);
                binder = bo;
            } else {
                if (tok.kind == TokKind.Ident) {
                    bname2: *i8 = cur_tokstr();
                    tok = tok.next;
                    bo2: *Obj = new_obj(bname2, 1);
                    bo2.ty = exn_type(cedu);
                    binder = bo2;
                } else {
                    if (cedu.members != null) { error("payload exception requires a binder (Name name)"); }
                }
            }
            skip(TokKind.Arrow);
            abody: *Stmt = parse_compound();
            leave_scope();
            armn: *CatchArm = new_catch_arm(cedu, binder, abody);
            if (arms_c != null) {
                arms_c.next = armn;
                arms_c = armn;
            } else {
                arms_h = armn;
                arms_c = armn;
            }
        }
        buf: *Obj = new_obj(".trybuf", 1);
        buf.ty = array_of(ty_i8, L8_JMP_BUF_SIZE);
        return new_try(tbody, arms_h, buf);
    }
    if (tok.kind == TokKind.If) {
        tok = tok.next;
        skip(TokKind.LParen);
        cond: *Expr = parse_expr();
        skip(TokKind.RParen);
        save: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(cond);
        then: *Stmt = parse_stmt();
        narrow_reset(save);
        els: ?*Stmt = null;
        if (tok.kind == TokKind.Else) {
            tok = tok.next;
            narrow_push_eq_nulls(cond);
            els = parse_stmt();
            narrow_reset(save);
        } else {
            /* if (x == null) { return/error/...; } → x is non-null afterward */
            if (stmt_parse_diverges(then)) {
                narrow_push_eq_nulls(cond);
            }
        }
        return new_if(cond, then, els);
    }
    if (tok.kind == TokKind.While) {
        tok = tok.next;
        skip(TokKind.LParen);
        cond2: *Expr = parse_expr();
        skip(TokKind.RParen);
        save2: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(cond2);
        body: *Stmt = parse_stmt();
        narrow_reset(save2);
        return new_while(cond2, body);
    }
    if (tok.kind == TokKind.Match) {
        tok = tok.next;
        mcond: *Expr = parse_expr();
        return new_match(mcond, parse_match_arms(mcond));
    }
    if (tok.kind == TokKind.LBrace) { return parse_compound(); }
    if (tok.kind == TokKind.Ident && (tok.next).kind == TokKind.Colon) {
        o: *Obj = parse_decl(1);
        if (tok.kind == TokKind.Comma) { error("only one variable per declaration"); }
        skip(TokKind.Assign);
        if (tok.kind == TokKind.Uninitialized) {
            tok = tok.next;
            skip(TokKind.Semi);
            return new_block(null);
        }
        rhs: *Expr = parse_expr();
        skip(TokKind.Semi);
        return new_expr_stmt(new_assign(new_var_node(o), rhs));
    }
    e: *Expr = parse_expr();
    skip(TokKind.Semi);
    new_expr_stmt(e);
}

fn_param(fn: *Function, i: int): ?*Obj {
    p: ?*Obj = fn.params;
    n: int = 0;
    while (p != null) {
        if (n == i) { return p; }
        n = n + 1;
        p = p.param_next;
    }
    null;
}

append_fn_param(fn: *Function, p: *Obj) {
    p.param_next = null;
    if (fn.params == null) {
        fn.params = p;
        return;
    }
    cur: ?*Obj = fn.params;
    while (cur != null) {
        if (cur.param_next == null) {
            cur.param_next = p;
            return;
        }
        cur = cur.param_next;
    }
}

parse_function(name: *i8) raises Error: *Function {
    fn: *Function = new Function {
        name: name,
        nparams: 0,
        params: null,
        locals: null,
        body: null,
        stack_size: 0,
        return_ty: null,
        sret: null,
        raises_list: null,
        used: 0,
        next: null,
        hash_next: null
    };
    locals = null;
    scope_depth = 0;
    narrow_top = null;
    catch_top = null;
    current_fn = fn;
    skip(TokKind.LParen);
    np: int = 0;
    while (tok.kind != TokKind.RParen) {
        if (np != 0) { skip(TokKind.Comma); }
        if (np >= 6) { error("too many parameters"); }
        p: *Obj = parse_decl(1);
        append_fn_param(fn, p);
        np = np + 1;
    }
    fn.nparams = np;
    skip(TokKind.RParen);
    if (tok.kind == TokKind.Raises) {
        tok = tok.next;
        rtail: ?*ExnList = null;
        rdone: int = 0;
        while (rdone == 0) {
            if (tok.kind != TokKind.Ident) { error("expected exception type after raises"); }
            ename: *i8 = cur_tokstr();
            ed: ?*ExnDef = find_exn(ename);
            if (ed == null) { error("unknown exception"); }
            edu: *ExnDef = ed;
            if (exn_in_list(fn.raises_list, edu)) { error("duplicate raises"); }
            el: *ExnList = new ExnList { exn: edu, seen: 0, next: null };
            if (rtail != null) {
                rtail.next = el;
                rtail = el;
            } else {
                fn.raises_list = el;
                rtail = el;
            }
            tok = tok.next;
            if (tok.kind == TokKind.Comma) {
                tok = tok.next;
            } else { rdone = 1; }
        }
    }
    if (tok.kind == TokKind.Colon) {
        tok = tok.next;
        fn.return_ty = parse_type();
    }
    rt: ?*Type = fn.return_ty;
    if (rt != null && passes_by_ref(rt)) {
        if (fn.nparams >= 6) { error("too many parameters"); }
        sret: *Obj = new_obj(".sret", 1);
        sret.ty = ptr_to(rt);
        fn.sret = sret;
    }
    fn.body = parse_compound();
    fn.locals = locals;
    narrow_top = null;
    catch_top = null;
    current_fn = null;
    fn;
}

parse_field_list(base_offset: int) raises Error: *Member {
    head: ?*Member = null;
    cur: ?*Member = null;
    offset: int = base_offset;
    while (tok.kind != TokKind.RBrace) {
        if (tok.kind != TokKind.Ident) { error("expected field name"); }
        mname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TokKind.Colon);
        mty: *Type = parse_type();
        mty = parse_type_suffix(mty);
        if (is_noreturn_ty(mty)) { error("noreturn cannot be a field type"); }
        m: *Member = new Member {
            name: mname,
            offset: offset,
            ty: mty,
            next: null
        };
        sz: int = type_size(mty);
        if (sz <= 0) { sz = 8; }
        offset = offset + ((sz + 7) & (0 - 8));
        if (cur != null) {
            cur.next = m;
            cur = m;
        } else {
            head = m;
            cur = m;
        }
        if (tok.kind == TokKind.Semi || tok.kind == TokKind.Comma) {
            tok = tok.next;
        } else {
            if (tok.kind != TokKind.RBrace) { error("expected `;`, `,`, or `}` after field"); }
        }
    }
    field_list_size = offset - base_offset;
    tok = tok.next;
    head or error("empty members");
}

parse_variant(tag: int, enum_name: *i8) raises Error: *Variant {
    if (tok.kind != TokKind.Ident) { error("expected variant name"); }
    v: *Variant = new Variant {
        name: cur_tokstr(),
        tag: tag,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        next: null
    };
    tok = tok.next;
    if (tok.kind == TokKind.LBrace) {
        tok = tok.next;
        v.fields = parse_field_list(0);
        v.payload_size = field_list_size;
        sd: *StructDef = new StructDef {
            name: variant_payload_name(enum_name, v.name),
            members: v.fields,
            size: field_list_size,
            ty: null,
            next: null,
            hash_next: null
        };
        v.payload_ty = struct_type(sd);
    }
    v;
}

parse_exception_def() raises Error {
    tok = tok.next;
    if (tok.kind != TokKind.Ident) { error("expected exception name"); }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    if (find_exn(name) != null || find_struct(name) != null || find_enum(name) != null) { error("redefinition"); }
    ed: *ExnDef = new ExnDef {
        name: name,
        tag: next_exn_tag,
        members: null,
        size: 0,
        ty: null,
        next: exn_defs,
        hash_next: null
    };
    next_exn_tag = next_exn_tag + 1;
    exn_defs = ed;
    hash_put_exn(ed);
    if (tok.kind == TokKind.LBrace) {
        tok = tok.next;
        ed.members = parse_field_list(0);
        ed.size = field_list_size;
        skip_optional_semi();
    } else { skip(TokKind.Semi); }
    exn_type(ed);
}

parse_type_def() raises Error {
    tok = tok.next;
    if (tok.kind != TokKind.Ident) { error("expected type name"); }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Assign);

    if (tok.kind == TokKind.LBrace) {
        if (find_enum(name) != null) { error("redefinition of type"); }
        sd: *StructDef = get_or_create_struct(name);
        if (sd.members != null) { error("redefinition of type"); }
        tok = tok.next;
        sd.members = parse_field_list(0);
        sd.size = field_list_size;
        skip_optional_semi();
        return;
    }

    stub: ?*StructDef = find_struct(name);
    if (stub != null) {
        if (stub.members != null) { error("redefinition of type"); }
        remove_struct(name);
    }
    ed: *EnumDef = get_or_create_enum(name);
    if (ed.variants != null) { error("redefinition of type"); }

    if (tok.kind == TokKind.Pipe) { tok = tok.next; }

    head: ?*Variant = null;
    cur: ?*Variant = null;
    tag: int = 0;
    max_payload: int = 0;
    done: int = 0;
    while (done == 0) {
        v: *Variant = parse_variant(tag, name);
        x: ?*Variant = head;
        while (x != null) {
            if (streq(x.name, v.name)) { error("duplicate variant"); }
            x = x.next;
        }
        if (v.payload_size > max_payload) { max_payload = v.payload_size; }
        if (cur != null) {
            cur.next = v;
            cur = v;
        } else {
            head = v;
            cur = v;
        }
        tag = tag + 1;
        if (tok.kind == TokKind.Pipe) {
            tok = tok.next;
        } else { done = 1; }
    }
    if (head == null) { error("enum type needs at least one variant"); }
    ed.variants = head;
    ed.size = 8 + max_payload;
    if (stub != null) {
        if (stub.ty != null) { rebind_struct_stub_to_enum(stub, ed); }
    }
    skip(TokKind.Semi);
}

parse_source_file(path: *i8) raises Error {
    if (!mark_imported(path)) { return; }
    saved_source: []i8 = source;
    saved_source_len: int = source_len;
    saved_pos: int = pos;
    saved_tok: *Token = tok;
    saved_path: *i8 = source_path;
    source_path = path;
    source = read_file(path);
    tok = tokenize();
    parse_program_unit();
    source = saved_source;
    source_len = saved_source_len;
    pos = saved_pos;
    tok = saved_tok;
    source_path = saved_path;
}

parse_import() raises Error {
    tok = tok.next;
    if (tok.kind != TokKind.Str) { error("expected string path after import"); }
    relative: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Semi);
    path: *i8 = resolve_import_path(source_path, relative);
    parse_source_file(path);
}

append_function(fn: *Function) {
    tail: ?*Function = function_tail;
    if (tail != null) {
        tail.next = fn;
        function_tail = fn;
    } else {
        functions = fn;
        function_tail = fn;
    }
}

parse_program_unit() raises Error {
    while (tok.kind != TokKind.Eof) {
        if (tok.kind == TokKind.Import) {
            parse_import();
        } else if (tok.kind == TokKind.TypeKw && (tok.next).kind == TokKind.Ident && ((tok.next).next).kind == TokKind.Assign) {
            parse_type_def();
        } else {
            if (tok.kind == TokKind.Exception) {
                parse_exception_def();
            } else {
            if (tok.kind != TokKind.Ident) { error("expected identifier"); }
            name: *i8 = cur_tokstr();
            tok = tok.next;
            if (tok.kind == TokKind.LParen) {
                fn: *Function = parse_function(name);
                append_function(fn);
                hash_put_fn(fn);
                o: *Obj = new_obj(name, 0);
                o.is_func = 1;
                o.ty = fn.return_ty;
            } else {
                skip(TokKind.Colon);
                ty: *Type = parse_type();
                ty = parse_type_suffix(ty);
                if (is_noreturn_ty(ty)) { error("noreturn is only valid as a function return type"); }
                if (tok.kind == TokKind.Comma) { error("only one variable per declaration"); }
                o2: *Obj = new_obj(name, 0);
                o2.ty = ty;
                if (tok.kind == TokKind.Assign) {
                    tok = tok.next;
                    if (tok.kind == TokKind.Uninitialized) {
                        tok = tok.next;
                    } else {
                        o2.init = parse_expr();
                    }
                }
                skip(TokKind.Semi);
            }
            }
        }
    }
}

parse_program(entry_path: *i8) raises Error {
    functions = null;
    function_tail = null;
    globals = null;
    struct_defs = null;
    enum_defs = null;
    exn_defs = null;
    imported_files = null;
    next_exn_tag = 1;
    clear_sym_tables();
    parse_source_file(normalize_path(entry_path));
}

/* Assumes n is already typed. True if execution cannot fall through. */
/* Syntactic divergence for parse-time early-exit narrowing (no full typing). */
stmt_parse_diverges(n: *Stmt): bool {
    match n.kind {
        Return _p -> { true; }
        Raise _p -> { true; }
        ExprStmt q -> {
            match q.lhs.kind {
                Funcall k -> {
                    if (streq(k.funcname, "exit")) { return true; }
                    fno: ?*Function = find_function(k.funcname);
                    if (fno != null) {
                        frt: ?*Type = fno.return_ty;
                        if (frt != null && is_noreturn_ty(frt)) { return true; }
                    }
                    false;
                }
                _ -> { false; }
            }
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_parse_diverges(s)) { return true; }
                s = s.next;
            }
            false;
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                stmt_parse_diverges(k.then) && stmt_parse_diverges(els);
            } else { false; }
        }
        Match k -> {
            if (k.arms == null) { return false; }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!stmt_parse_diverges(arm.body)) { return false; }
                arm = arm.next;
            }
            true;
        }
        Try k -> {
            if (!stmt_parse_diverges(k.body)) { return false; }
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!stmt_parse_diverges(arm2.body)) { return false; }
                arm2 = arm2.next;
            }
            true;
        }
        _ -> { false; }
    }
}

stmt_always_diverges(n: *Stmt): bool {
    match n.kind {
        Return _p -> { true; }
        Raise _p -> { true; }
        ExprStmt k -> {
            lty: ?*Type = k.lhs.ty;
            lty != null && is_noreturn_ty(lty);
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                if (stmt_always_diverges(s)) { return true; }
                s = s.next;
            }
            false;
        }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                stmt_always_diverges(k.then) && stmt_always_diverges(els);
            } else { false; }
        }
        Match k -> {
            if (k.arms == null) { return false; }
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                if (!stmt_always_diverges(arm.body)) { return false; }
                arm = arm.next;
            }
            true;
        }
        Try k -> {
            if (!stmt_always_diverges(k.body)) { return false; }
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                if (!stmt_always_diverges(arm2.body)) { return false; }
                arm2 = arm2.next;
            }
            true;
        }
        _ -> { false; }
    }
}

stmt_diverges(n: *Stmt): bool {
    stmt_always_diverges(n);
}

check_noreturn_functions() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        frt: ?*Type = fn.return_ty;
        if (frt != null && is_noreturn_ty(frt)) {
            body: ?*Stmt = fn.body;
            if (body == null || !stmt_diverges(body)) { error("noreturn function may return"); }
        }
        fn = fn.next;
    }
}

mark_calls_field_inits(inits: ?*FieldInit) {
    a: ?*FieldInit = inits;
    while (a != null) {
        mark_calls_expr(a.lhs);
        a = a.next;
    }
}

mark_calls_expr(n: ?*Expr) {
    if (n == null) { return; }
    match n.kind {
        Num _p -> { return; }
        Null -> { return; }
        Var _p -> { return; }
        Binary k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        Assign k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        Addr k -> { mark_calls_expr(k.lhs); return; }
        Deref k -> { mark_calls_expr(k.lhs); return; }
        Index k -> { mark_calls_expr(k.lhs); mark_calls_expr(k.idx); return; }
        Not k -> { mark_calls_expr(k.lhs); return; }
        Neg k -> { mark_calls_expr(k.lhs); return; }
        BitNot k -> { mark_calls_expr(k.lhs); return; }
        LogAnd k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        LogOr k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        OrElse k -> {
            mark_calls_expr(k.lhs);
            mark_calls_expr(k.rhs);
            return;
        }
        Funcall k -> {
            callee: ?*Function = k.fn;
            if (callee != null) { mark_reachable(callee); }
            a: ?*Expr = k.args;
            while (a != null) {
                mark_calls_expr(a);
                a = a.next;
            }
            return;
        }
        MemberAccess k -> { mark_calls_expr(k.lhs); return; }
        As k -> { mark_calls_expr(k.lhs); return; }
        Trunc k -> { mark_calls_expr(k.lhs); return; }
        New k -> {
            mark_calls_expr(k.lhs);
            mark_calls_field_inits(k.inits);
            return;
        }
        StructLit k -> {
            mark_calls_field_inits(k.inits);
            return;
        }
        VariantLit k -> {
            mark_calls_field_inits(k.inits);
            return;
        }
        If k -> {
            mark_calls_expr(k.cond);
            mark_calls_expr(k.then);
            mark_calls_expr(k.els);
            return;
        }
        Match k -> {
            mark_calls_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                mark_calls_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Block k -> {
            bs: ?*Stmt = k.body;
            while (bs != null) {
                mark_calls_stmt(bs);
                bs = bs.next;
            }
            return;
        }
    }
}

mark_calls_stmt(n: ?*Stmt) {
    if (n == null) { return; }
    match n.kind {
        Return k -> { mark_calls_expr(k.lhs); return; }
        ExprStmt k -> { mark_calls_expr(k.lhs); return; }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                mark_calls_stmt(s);
                s = s.next;
            }
            return;
        }
        If k -> {
            mark_calls_expr(k.cond);
            mark_calls_stmt(k.then);
            mark_calls_stmt(k.els);
            return;
        }
        While k -> {
            mark_calls_expr(k.cond);
            mark_calls_stmt(k.body);
            return;
        }
        Match k -> {
            mark_calls_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                mark_calls_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Raise k -> {
            mark_calls_field_inits(k.inits);
            return;
        }
        Try k -> {
            mark_calls_stmt(k.body);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                mark_calls_stmt(arm2.body);
                arm2 = arm2.next;
            }
            return;
        }
    }
}

mark_reachable(fn: *Function) {
    if (fn.used != 0) { return; }
    fn.used = 1;
    mark_calls_stmt(fn.body);
}

check_unused_functions() {
    fn: ?*Function = functions;
    while (fn != null) {
        fn.used = 0;
        fn = fn.next;
    }
    main_fn: ?*Function = find_function("main");
    if (main_fn == null) { return; }
    mark_reachable(main_fn);
    fn = functions;
    while (fn != null) {
        if (fn.used == 0) { warn_unused_function(fn.name); }
        fn = fn.next;
    }
}

mark_var_use(var: ?*Obj) {
    if (var != null) { var.used = 1; }
}

mark_uses_field_inits(inits: ?*FieldInit) {
    a: ?*FieldInit = inits;
    while (a != null) {
        mark_uses_expr(a.lhs);
        a = a.next;
    }
}

mark_uses_expr(n: ?*Expr) {
    if (n == null) { return; }
    match n.kind {
        Num _p -> { return; }
        Null -> { return; }
        Var k -> { mark_var_use(k.var); return; }
        Binary k -> {
            mark_uses_expr(k.lhs);
            mark_uses_expr(k.rhs);
            return;
        }
        Assign k -> {
            mark_uses_expr(k.rhs);
            match k.lhs.kind {
                Var _p -> { return; }
                _ -> { mark_uses_expr(k.lhs); return; }
            }
        }
        Addr k -> { mark_uses_expr(k.lhs); return; }
        Deref k -> { mark_uses_expr(k.lhs); return; }
        Index k -> { mark_uses_expr(k.lhs); mark_uses_expr(k.idx); return; }
        Not k -> { mark_uses_expr(k.lhs); return; }
        Neg k -> { mark_uses_expr(k.lhs); return; }
        BitNot k -> { mark_uses_expr(k.lhs); return; }
        LogAnd k -> {
            mark_uses_expr(k.lhs);
            mark_uses_expr(k.rhs);
            return;
        }
        LogOr k -> {
            mark_uses_expr(k.lhs);
            mark_uses_expr(k.rhs);
            return;
        }
        OrElse k -> {
            mark_uses_expr(k.lhs);
            mark_uses_expr(k.rhs);
            return;
        }
        Funcall k -> {
            a: ?*Expr = k.args;
            while (a != null) {
                mark_uses_expr(a);
                a = a.next;
            }
            return;
        }
        MemberAccess k -> { mark_uses_expr(k.lhs); return; }
        As k -> { mark_uses_expr(k.lhs); return; }
        Trunc k -> { mark_uses_expr(k.lhs); return; }
        New k -> {
            mark_uses_expr(k.lhs);
            mark_uses_field_inits(k.inits);
            return;
        }
        StructLit k -> {
            mark_uses_field_inits(k.inits);
            return;
        }
        VariantLit k -> {
            mark_uses_field_inits(k.inits);
            return;
        }
        If k -> {
            mark_uses_expr(k.cond);
            mark_uses_expr(k.then);
            mark_uses_expr(k.els);
            return;
        }
        Match k -> {
            mark_uses_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                mark_uses_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Block k -> {
            bs: ?*Stmt = k.body;
            while (bs != null) {
                mark_uses_stmt(bs);
                bs = bs.next;
            }
            return;
        }
    }
}

mark_uses_stmt(n: ?*Stmt) {
    if (n == null) { return; }
    match n.kind {
        Return k -> { mark_uses_expr(k.lhs); return; }
        ExprStmt k -> { mark_uses_expr(k.lhs); return; }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                mark_uses_stmt(s);
                s = s.next;
            }
            return;
        }
        If k -> {
            mark_uses_expr(k.cond);
            mark_uses_stmt(k.then);
            mark_uses_stmt(k.els);
            return;
        }
        While k -> {
            mark_uses_expr(k.cond);
            mark_uses_stmt(k.body);
            return;
        }
        Match k -> {
            mark_uses_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                mark_uses_stmt(arm.body);
                arm = arm.next;
            }
            return;
        }
        Raise k -> {
            mark_uses_field_inits(k.inits);
            return;
        }
        Try k -> {
            mark_uses_stmt(k.body);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                mark_uses_stmt(arm2.body);
                arm2 = arm2.next;
            }
            return;
        }
    }
}

check_unused_locals() {
    /* Names starting with `_` or `.` are ignored. Bare assignment does not count as a use. */
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.used != 0) {
            o: ?*Obj = fn.locals;
            while (o != null) {
                o.used = 0;
                o = o.next;
            }
            mark_uses_stmt(fn.body);
            o = fn.locals;
            while (o != null) {
                if (o.used == 0 && !ignore_unused_local_name(o.name)) {
                    warn_unused_local(fn.name, o.name);
                }
                o = o.next;
            }
        }
        fn = fn.next;
    }
}

expr_is_ignored_value(n: *Expr): bool {
    match n.kind {
        Assign _p -> { false; }
        Block _p -> { false; }
        If _p -> { false; }
        Match _p -> { false; }
        Funcall k -> {
            fno: ?*Function = k.fn;
            if (fno == null) { false; }
            else {
                rt: ?*Type = fno.return_ty;
                if (rt == null) { false; }
                else if (is_noreturn_ty(rt)) { false; }
                else { true; }
            }
        }
        _ -> { true; }
    }
}

warn_return_style_expr(n: ?*Expr, tail: int, used: int, fn: *Function) {
    if (n == null) { return; }
    match n.kind {
        Block q -> { warn_return_style_list(q.body, tail, used, fn); return; }
        If q -> {
            warn_return_style_expr(q.then, tail, used, fn);
            warn_return_style_expr(q.els, tail, used, fn);
            return;
        }
        Match q -> {
            arm: ?*MatchArm = q.arms;
            while (arm != null) {
                warn_return_style_list(arm.body, tail, used, fn);
                arm = arm.next;
            }
            return;
        }
        _ -> { return; }
    }
}

warn_return_style_stmt(s: *Stmt, tail: int, used: int, fn: *Function) {
    match s.kind {
        Return k -> {
            if (tail != 0) {
                if (k.lhs != null) { warn_unnecessary_return(fn.name); }
            }
            return;
        }
        ExprStmt k -> {
            warn_return_style_expr(k.lhs, tail, used, fn);
            if (used == 0) {
                rt: ?*Type = fn.return_ty;
                if (rt != null && !is_noreturn_ty(rt)) {
                    if (expr_is_ignored_value(k.lhs)) { warn_ignored_value(fn.name); }
                }
            }
            return;
        }
        Block k -> { warn_return_style_list(k.body, tail, used, fn); return; }
        If k -> {
            els: ?*Stmt = k.els;
            if (els != null) {
                warn_return_style_list(k.then, tail, used, fn);
                warn_return_style_list(els, tail, used, fn);
            } else { warn_return_style_list(k.then, 0, 0, fn); }
            return;
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                warn_return_style_list(arm.body, tail, used, fn);
                arm = arm.next;
            }
            return;
        }
        Try k -> {
            warn_return_style_list(k.body, tail, used, fn);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                warn_return_style_list(arm2.body, tail, used, fn);
                arm2 = arm2.next;
            }
            return;
        }
        While k -> { warn_return_style_list(k.body, 0, 0, fn); return; }
        _ -> { return; }
    }
}

warn_return_style_list(head: ?*Stmt, tail: int, used: int, fn: *Function) {
    s: ?*Stmt = head;
    while (s != null) {
        is_last: int = 0;
        if (s.next == null) { is_last = 1; }
        st: int = 0;
        su: int = 0;
        if (tail != 0 && is_last != 0) { st = 1; }
        if (used != 0 && is_last != 0) { su = 1; }
        warn_return_style_stmt(s, st, su, fn);
        s = s.next;
    }
}

check_return_style() {
    fn: ?*Function = functions;
    while (fn != null) {
        used: int = 0;
        rt: ?*Type = fn.return_ty;
        if (rt != null && !is_noreturn_ty(rt)) { used = 1; }
        warn_return_style_list(fn.body, 1, used, fn);
        fn = fn.next;
    }
}

is_const_init(n: *Expr): bool {
    match n.kind {
        Num k -> { k.str_label == 0; }
        Null -> { true; }
        Neg q -> { is_const_init(q.lhs); }
        BitNot q -> { is_const_init(q.lhs); }
        As q -> { is_const_init(q.lhs); }
        Trunc q -> { is_const_init(q.lhs); }
        Not q -> { is_const_init(q.lhs); }
        Binary q -> { is_const_init(q.lhs) && is_const_init(q.rhs); }
        _ -> { false; }
    }
}

wrap_u8(v: int): int {
    while (v < 0) { v = v + 256; }
    while (v >= 256) { v = v - 256; }
    v;
}

const_bit(a: int, b: int, kind: int): int {
    if (kind == 0) { a & b; }
    else if (kind == 1) { a | b; }
    else { a ^ b; }
}

const_shl(a: int, n: int) raises Error: int {
    if (n < 0) { error("negative shift in global initializer"); }
    if (n >= 64) { return 0; }
    i: int = 0;
    while (i < n) {
        a = a + a;
        i = i + 1;
    }
    a;
}

const_sar1(a: int): int { a >> 1; }

const_sar(a: int, n: int) raises Error: int {
    if (n < 0) { error("negative shift in global initializer"); }
    if (n >= 64) {
        if (a < 0) { return 0 - 1; }
        return 0;
    }
    i: int = 0;
    while (i < n) {
        a = const_sar1(a);
        i = i + 1;
    }
    a;
}

const_value(n: *Expr) raises Error: int {
    match n.kind {
        Num k -> { return k.val; }
        Null -> { return 0; }
        Neg q -> { return 0 - const_value(q.lhs); }
        BitNot q -> {
            v0: int = 0 - 1 - const_value(q.lhs);
            nty0: ?*Type = n.ty;
            if (nty0 != null) {
                if (is_i8_ty(nty0)) { return wrap_u8(v0); }
            }
            return v0;
        }
        As q -> { return const_value(q.lhs); }
        Trunc q -> { return wrap_u8(const_value(q.lhs)); }
        Not q -> {
            if (const_value(q.lhs) == 0) { return 1; }
            return 0;
        }
        Binary q -> {
            l: int = const_value(q.lhs);
            r: int = const_value(q.rhs);
            v: int = 0;
            match q.op {
                Add -> { v = l + r; }
                Sub -> { v = l - r; }
                Mul -> { v = l * r; }
                Div -> {
                    if (r == 0) { error("division by zero in global initializer"); }
                    v = l / r;
                }
                Mod -> {
                    if (r == 0) { error("division by zero in global initializer"); }
                    v = l % r;
                }
                And -> { v = const_bit(l, r, 0); }
                Or -> { v = const_bit(l, r, 1); }
                Xor -> { v = const_bit(l, r, 2); }
                Shl -> { v = const_shl(l, r); }
                Shr -> { v = const_sar(l, r); }
                Eq -> { if (l == r) { v = 1; } }
                Ne -> { if (l != r) { v = 1; } }
                Lt -> { if (l < r) { v = 1; } }
                Le -> { if (l <= r) { v = 1; } }
                Gt -> { if (l > r) { v = 1; } }
                Ge -> { if (l >= r) { v = 1; } }
            }
            nty: ?*Type = n.ty;
            if (nty != null) {
                if (is_i8_ty(nty)) { return wrap_u8(v); }
            }
            return v;
        }
        _ -> { error("global initializer must be a constant"); }
    }
    0;
}

typecheck_global_inits() raises Error {
    g: ?*Obj = globals;
    while (g != null) {
        if (g.is_func == 0) {
            init: ?*Expr = g.init;
            if (init != null) {
                add_type(init);
                if (!assignable(g.ty, init)) {
                    error_have_expr_want("global initializer type mismatch", init, g.ty);
                }
                if (!is_const_init(init)) { error("global initializer must be a constant"); }
            }
        }
        g = g.next;
    }
}

typecheck_program() raises Error {
    typecheck_global_inits();
    fn: ?*Function = functions;
    while (fn != null) {
        e: ?*ExnList = fn.raises_list;
        while (e != null) {
            e.seen = 0;
            e = e.next;
        }
        current_fn = fn;
        current_return_ty = fn.return_ty;
        catch_top = null;
        narrow_top = null;
        walk_top = null;
        zero_top = null;
        add_type_stmt(fn.body);
        check_fn_result(fn);
        fn = fn.next;
    }
    current_fn = null;
    current_return_ty = null;
    catch_top = null;
    narrow_top = null;
}

check_fn_result(fn: *Function) raises Error {
    rt: ?*Type = fn.return_ty;
    if (rt == null) { return; }
    if (is_noreturn_ty(rt)) { return; }
    want: *Type = rt;
    if (check_stmt_result(fn.body, want)) { return; }
    sb: *StrBuf = sb_new();
    sb_puts(sb, "missing return value in ");
    sb_puts(sb, fn.name);
    error(sb_finish(sb));
}

check_raises_functions() raises Error {
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.raises_list != null) {
            e: ?*ExnList = fn.raises_list;
            while (e != null) {
                if (e.seen == 0) { error("raises lists an exception that is never raised"); }
                e = e.next;
            }
        }
        fn = fn.next;
    }
}

new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    l;
}

load_mem(ty: *Type) raises Error {
    if (is_byte_ty(ty)) {
        cg_movzb_mr(0, 0, 0);
    } else { cg_mov_mr(0, 0, 0); }
}

store_mem(ty: *Type) raises Error {
    if (is_byte_ty(ty)) {
        cg_movb_rm(0, 7, 0);
    } else { cg_mov_rm(0, 7, 0); }
}

emit_memcpy(sz: int) {
    if (sz <= 0) { sz = 8; }
    i: int = 0;
    while (i + 8 <= sz) {
        cg_mov_mr(6, i, 0);
        cg_mov_rm(0, 7, i);
        i = i + 8;
    }
    while (i < sz) {
        cg_movzb_mr(6, i, 0);
        cg_movb_rm(0, 7, i);
        i = i + 1;
    }
}

/* Store value in %rax into (%rdi). By-ref aggregates: %rax is a source pointer. */
store_value(ty: *Type) raises Error {
    if (passes_by_ref(ty)) {
        cg_mov_rr(0, 6);
        emit_memcpy(type_size(ty));
    } else { store_mem(ty); }
}

/*
 * Object base in %rbx (absolute). Eval RHS first so a large aggregate stack
 * temp from gen_expr cannot bury a pushed destination address.
 * base_off is added to each field offset (0 for structs, 8 for enum payloads).
 */
gen_field_inits(inits: ?*FieldInit, base_off: int) raises Error {
    init: ?*FieldInit = inits;
    while (init != null) {
        lhs: ?*Expr = init.lhs;
        if (lhs != null) {
            mem: *Member = init.member;
            mty: *Type = mem.ty;
            gen_expr(lhs);
            cg_mov_rr(3, 7);
            off: int = base_off + mem.offset;
            if (off != 0) {
                cg_alu_imm(0, off, 7);
            }
            store_value(mty);
        }
        init = init.next;
    }
}

emit_exit1() {
    cg_mov_imm(1, 7);
    cg_call("exit");
}

emit_check_idx() {
    cg_alu_rr(57, 2, 1);
    cg_jump_id(3, oob_lab);
}

emit_scale_offset(esz: int) {
    if (esz == 1) {
        cg_alu_rr(1, 1, 6);
        cg_mov_rr(6, 0);
    } else {
        cg_mov_rr(1, 0);
        if (esz != 0) {
            cg_imul_imm(esz, 0);
        }
        cg_alu_rr(1, 6, 0);
    }
}

gen_index_addr(lhs: *Expr, idx: *Expr) raises Error {
    raw: *Type = lhs.ty or error("missing type");
    esz: int = type_size(type_base(raw));
    cg_push(3);
    if (is_array(raw)) {
        gen_addr(lhs);
        cg_mov_rr(0, 6);
        cg_mov_imm(type_array_len(raw), 2);
        cg_push(6);
        cg_push(2);
        gen_expr(idx);
        cg_mov_rr(0, 1);
        cg_pop(2);
        cg_pop(6);
        emit_check_idx();
    } else {
        if (is_zptr(raw)) {
            gen_expr(lhs);
            cg_mov_rr(0, 6);
            cg_push(6);
            gen_expr(idx);
            cg_mov_rr(0, 1);
            cg_pop(6);
        } else {
            gen_expr(lhs);
            cg_mov_rr(0, 6);
            if (is_slice(raw)) {
                cg_mov_mr(6, 0 - 8, 2);
            } else {
                bo: ?*Obj = null;
                match raw.* {
                    View vk -> { bo = find_fn_bound(vk.bound); }
                    _ -> {}
                }
                if (bo == null) { error("view bound is not in scope"); }
                emit_load_var(bo, ty_int);
                cg_mov_rr(0, 2);
            }
            cg_push(6);
            cg_push(2);
            gen_expr(idx);
            cg_mov_rr(0, 1);
            cg_pop(2);
            cg_pop(6);
            emit_check_idx();
        }
    }
    emit_scale_offset(esz);
    cg_pop(3);
}

gen_struct_inits(inits: ?*FieldInit) raises Error { gen_field_inits(inits, 0); }
gen_variant_inits(inits: ?*FieldInit) raises Error { gen_field_inits(inits, 8); }

gen_addr(n: *Expr) raises Error {
    match n.kind {
        Var k -> {
            var: ?*Obj = k.var;
            if (var == null) { error("missing var"); }
            vo: *Obj = var;
            if (vo.is_local != 0) {
                cg_lea_mr(5, vo.offset, 0);
            } else {
                cg_lea_rip(vo.name, 0, 0);
            }
            return;
        }
        Deref k -> {
            gen_expr(k.lhs);
            return;
        }
        Index k -> {
            gen_index_addr(k.lhs, k.idx);
            return;
        }
        MemberAccess k -> {
            t: ?*Type = decay(k.lhs.ty);
            if (t != null && is_pointer(t) && (is_struct_ty(type_base(t)) || is_exn_ty(type_base(t)))) {
                gen_expr(k.lhs);
            } else { gen_addr(k.lhs); }
            mem: *Member = k.member;
            if (mem.offset != 0) {
                cg_alu_imm(0, mem.offset, 0);
            }
            return;
        }
        _ -> { error("not an lvalue"); }
    }
}

/* Scalar load of a variable into %rax without lea+deref. */
emit_load_var(vo: *Obj, ty: *Type) raises Error {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) { cg_movzb_mr(5, vo.offset, 0); }
        else { cg_mov_mr(5, vo.offset, 0); }
    } else {
        cg_mov_rip_r(vo.name, 0, 0);
    }
}

/* Scalar store of %rax into a variable. */
emit_store_var(vo: *Obj, ty: *Type) raises Error {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) { cg_movb_rm(0, 5, vo.offset); }
        else { cg_mov_rm(0, 5, vo.offset); }
    } else {
        cg_mov_r_rip(0, vo.name, 0);
    }
}

fits_imm32(v: int): bool {
    lo: int = 0 - 2147483647;
    lo = lo - 1;
    hi: int = 2147483647;
    if (v < lo) { return false; }
    if (v > hi) { return false; }
    true;
}

/* Store an immediate into a scalar variable (no %rax round-trip). */
emit_store_imm(vo: *Obj, ty: *Type, v: int) raises Error {
    if (vo.is_local != 0) {
        if (is_byte_ty(ty)) { cg_movb_imm_m(v, 5, vo.offset); }
        else { cg_movq_imm_m(v, 5, vo.offset); }
    } else {
        if (is_byte_ty(ty)) { cg_movb_imm_rip(v, vo.name); }
        else { cg_movq_imm_rip(v, vo.name); }
    }
}

gen_load(n: *Expr) raises Error {
    ty: *Type = n.ty or error("missing type");
    if (is_array(ty) || passes_by_ref(ty)) {
        gen_addr(n);
        return;
    }
    match n.kind {
        Var k -> {
            vo: ?*Obj = k.var;
            if (vo != null) {
                emit_load_var(vo, ty);
                return;
            }
        }
        _ -> {}
    }
    gen_addr(n);
    load_mem(ty);
}

gen_binop_setup(lhs: *Expr, rhs: *Expr) raises Error {
    gen_expr(lhs);
    cg_push(0);
    gen_expr(rhs);
    cg_mov_rr(0, 7);
    cg_pop(0);
}

/* Immediate integer operand for codegen (numeric literal or null). */
imm_operand(n: *Expr): int {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) { 0; } else { 1; }
        }
        Null -> { 1; }
        _ -> { 0; }
    }
}

imm_value(n: *Expr): int {
    match n.kind {
        Num k -> { k.val; }
        Null -> { 0; }
        _ -> { 0; }
    }
}

gen_cmp_set(setcc: *i8) {
    cc: int = 4;
    if (cli_streq(setcc, "setne")) { cc = 5; }
    if (cli_streq(setcc, "setl")) { cc = 12; }
    if (cli_streq(setcc, "setge")) { cc = 13; }
    if (cli_streq(setcc, "setle")) { cc = 14; }
    if (cli_streq(setcc, "setg")) { cc = 15; }
    cg_setcc(cc);
    cg_movzb_al_rax();
}

gen_cmp(lhs: *Expr, rhs: *Expr, setcc: *i8) raises Error {
    if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
        gen_expr(lhs);
        cg_alu_imm(7, imm_value(rhs), 0);
        gen_cmp_set(setcc);
        return;
    }
    if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
        gen_expr(rhs);
        cg_mov_rr(0, 7);
        cg_mov_imm(imm_value(lhs), 0);
        cg_alu_rr(57, 7, 0);
        gen_cmp_set(setcc);
        return;
    }
    gen_binop_setup(lhs, rhs);
    cg_alu_rr(57, 7, 0);
    gen_cmp_set(setcc);
}

gen_binary(op: BinOp, lhs: *Expr, rhs: *Expr) raises Error {
    match op {
        Add -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v: int = imm_value(rhs);
                if (v != 0) {
                    cg_alu_imm(0, v, 0);
                }
                return;
            }
            if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                v2: int = imm_value(lhs);
                if (v2 != 0) {
                    cg_alu_imm(0, v2, 0);
                }
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(1, 7, 0);
            return;
        }
        Sub -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                v3: int = imm_value(rhs);
                if (v3 != 0) {
                    cg_alu_imm(5, v3, 0);
                }
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_alu_rr(41, 7, 0);
            return;
        }
        Mul -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                mv: int = imm_value(rhs);
                if (mv == 0) { cg_mov_imm(0, 0); return; }
                if (mv == 1) { return; }
                if (mv == 2) { cg_alu_rr(1, 0, 0); return; }
                cg_imul_imm(mv, 0);
                return;
            }
            if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                mv2: int = imm_value(lhs);
                if (mv2 == 0) { cg_mov_imm(0, 0); return; }
                if (mv2 == 1) { return; }
                if (mv2 == 2) { cg_alu_rr(1, 0, 0); return; }
                cg_imul_imm(mv2, 0);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_imul_rr(7, 0);
            return;
        }
        Div -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            return;
        }
        Mod -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_mov_imm(imm_value(rhs), 7);
                cg_cqo();
                cg_idiv(7);
                cg_mov_rr(2, 0);
                return;
            }
            gen_binop_setup(lhs, rhs);
            cg_cqo();
            cg_idiv(7);
            cg_mov_rr(2, 0);
            return;
        }
        Eq -> { gen_cmp(lhs, rhs, "sete"); return; }
        Ne -> { gen_cmp(lhs, rhs, "setne"); return; }
        Lt -> { gen_cmp(lhs, rhs, "setl"); return; }
        Le -> { gen_cmp(lhs, rhs, "setle"); return; }
        Gt -> { gen_cmp(lhs, rhs, "setg"); return; }
        Ge -> { gen_cmp(lhs, rhs, "setge"); return; }
        And -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(4, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(4, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(33, 7, 0);
            }
            return;
        }
        Or -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(1, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(1, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(9, 7, 0);
            }
            return;
        }
        Xor -> {
            if (imm_operand(rhs) != 0 && fits_imm32(imm_value(rhs))) {
                gen_expr(lhs);
                cg_alu_imm(6, imm_value(rhs), 0);
            } else if (imm_operand(lhs) != 0 && fits_imm32(imm_value(lhs))) {
                gen_expr(rhs);
                cg_alu_imm(6, imm_value(lhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_alu_rr(49, 7, 0);
            }
            return;
        }
        Shl -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_shift_imm(4, imm_value(rhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_mov_rr(7, 1);
                cg_shift_cl(4, 0);
            }
            return;
        }
        Shr -> {
            if (imm_operand(rhs) != 0) {
                gen_expr(lhs);
                cg_shift_imm(7, imm_value(rhs), 0);
            } else {
                gen_binop_setup(lhs, rhs);
                cg_mov_rr(7, 1);
                cg_shift_cl(7, 0);
            }
            return;
        }
    }
}

gen_expr(n: *Expr) raises Error {
    match n.kind {
        Num k -> {
            if (k.str_label != 0) {
                cg_lea_rip(cg_name_num(".L.str", k.str_label - 1), 8, 0);
            } else {
                cg_mov_imm(k.val, 0);
            }
            return;
        }
        Null -> { cg_mov_imm(0, 0); return; }
        Var _p -> { gen_load(n); return; }
        MemberAccess _p -> { gen_load(n); return; }
        Addr k -> { gen_addr(k.lhs); return; }
        As k -> { gen_expr(k.lhs); return; }
        Trunc k -> { gen_expr(k.lhs); return; }
        New k -> {
            base: *Type = type_base(n.ty or error("missing type"));
            esz: int = type_size(base);
            if (esz <= 0) { esz = 8; }
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                gen_expr(lhs);
                cg_push(0);
                if (esz != 1) {
                    cg_imul_imm(esz, 0);
                }
                cg_alu_imm(0, 8, 0);
                cg_mov_rr(0, 7);
                cg_call("malloc");
                cg_pop(1);
                cg_mov_rm(1, 0, 0);
                cg_alu_imm(0, 8, 0);
                return;
            }
            cg_mov_imm(esz, 7);
            cg_call("malloc");
            variant: ?*Variant = k.variant;
            if (variant != null) {
                cg_push(3);
                cg_mov_rr(0, 3);
                cg_mov_imm(k.val, 7);
                cg_mov_rm(7, 0, 0);
                gen_variant_inits(k.inits);
                cg_mov_rr(3, 0);
                cg_pop(3);
            } else {
                if (k.val == 0) {
                    cg_push(3);
                    cg_mov_rr(0, 3);
                    gen_struct_inits(k.inits);
                    cg_mov_rr(3, 0);
                    cg_pop(3);
                }
            }
            return;
        }
        StructLit k -> {
            sz: int = type_size(n.ty or error("missing type"));
            if (sz <= 0) { sz = 8; }
            sz = (sz + 15) & (0 - 16);
            cg_alu_imm(5, sz, 4);
            cg_push(3);
            cg_lea_mr(4, 8, 3);
            gen_struct_inits(k.inits);
            cg_mov_rr(3, 0);
            cg_pop(3);
            return;
        }
        VariantLit k -> {
            sz: int = type_size(n.ty or error("missing type"));
            if (sz <= 0) { sz = 8; }
            if (sz <= 8) {
                if (k.inits == null) {
                    cg_mov_imm(k.val, 0);
                    return;
                }
                cg_alu_imm(5, 16, 4);
                cg_push(3);
                cg_lea_mr(4, 8, 3);
                cg_mov_imm(k.val, 7);
                cg_mov_rm(7, 3, 0);
                gen_variant_inits(k.inits);
                cg_mov_mr(3, 0, 0);
                cg_pop(3);
                return;
            }
            sz = (sz + 15) & (0 - 16);
            cg_alu_imm(5, sz, 4);
            cg_push(3);
            cg_lea_mr(4, 8, 3);
            cg_mov_imm(k.val, 7);
            cg_mov_rm(7, 3, 0);
            gen_variant_inits(k.inits);
            cg_mov_rr(3, 0);
            cg_pop(3);
            return;
        }
        Deref k -> {
            gen_expr(k.lhs);
            load_mem(n.ty or error("missing type"));
            return;
        }
        Index _p -> {
            gen_addr(n);
            load_mem(n.ty or error("missing type"));
            return;
        }
        Assign q -> {
            match q.rhs.kind {
                StructLit k -> {
                    lty: ?*Type = q.lhs.ty;
                    if (lty != null && is_struct_ty(lty)) {
                        gen_addr(q.lhs);
                        cg_push(3);
                        cg_mov_rr(0, 3);
                        gen_struct_inits(k.inits);
                        cg_mov_rr(3, 0);
                        cg_pop(3);
                        return;
                    }
                }
                VariantLit k -> {
                    lty2: ?*Type = q.lhs.ty;
                    if (lty2 != null && is_enum_ty(lty2)) {
                        gen_addr(q.lhs);
                        cg_push(3);
                        cg_mov_rr(0, 3);
                        cg_mov_imm(k.val, 7);
                        cg_mov_rm(7, 0, 0);
                        gen_variant_inits(k.inits);
                        cg_mov_rr(3, 0);
                        cg_pop(3);
                        return;
                    }
                }
                _ -> {}
            }
            lhs_ty: *Type = q.lhs.ty or error("missing lhs type");
            if (!passes_by_ref(lhs_ty) && imm_operand(q.rhs) != 0 && fits_imm32(imm_value(q.rhs))) {
                match q.lhs.kind {
                    Var k -> {
                        vo0: ?*Obj = k.var;
                        if (vo0 != null) {
                            emit_store_imm(vo0, lhs_ty, imm_value(q.rhs));
                            return;
                        }
                    }
                    _ -> {}
                }
            }
            gen_expr(q.rhs);
            if (!passes_by_ref(lhs_ty)) {
                match q.lhs.kind {
                    Var k -> {
                        vo: ?*Obj = k.var;
                        if (vo != null) {
                            emit_store_var(vo, lhs_ty);
                            return;
                        }
                    }
                    _ -> {}
                }
            }
            cg_push(0);
            gen_addr(q.lhs);
            cg_mov_rr(0, 7);
            cg_pop(6);
            if (passes_by_ref(lhs_ty)) {
                emit_memcpy(type_size(lhs_ty));
                cg_mov_rr(7, 0);
            } else {
                cg_mov_rr(6, 0);
                store_mem(lhs_ty);
            }
            return;
        }
        Not k -> {
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_setcc(4);
            cg_movzb_al_rax();
            return;
        }
        Neg k -> {
            gen_expr(k.lhs);
            cg_neg(0);
            nty: ?*Type = n.ty;
            if (nty != null) {
                if (is_i8_ty(nty)) { cg_movzb_al_rax(); }
            }
            return;
        }
        BitNot k -> {
            gen_expr(k.lhs);
            cg_not(0);
            nty2: ?*Type = n.ty;
            if (nty2 != null) {
                if (is_i8_ty(nty2)) { cg_movzb_al_rax(); }
            }
            return;
        }
        LogAnd k -> {
            lf: int = new_label();
            le: int = new_label();
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, lf);
            gen_expr(k.rhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, lf);
            cg_mov_imm(1, 0);
            cg_jump_id(0 - 1, le);
            cg_label_id(lf);
            cg_mov_imm(0, 0);
            cg_label_id(le);
            return;
        }
        LogOr k -> {
            lt: int = new_label();
            lf2: int = new_label();
            le2: int = new_label();
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(5, lt);
            gen_expr(k.rhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, lf2);
            cg_label_id(lt);
            cg_mov_imm(1, 0);
            cg_jump_id(0 - 1, le2);
            cg_label_id(lf2);
            cg_mov_imm(0, 0);
            cg_label_id(le2);
            return;
        }
        OrElse k -> {
            end: int = new_label();
            gen_expr(k.lhs);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(5, end);
            gen_expr(k.rhs);
            cg_label_id(end);
            return;
        }
        Funcall k -> {
            fno: ?*Function = k.fn;
            has_sret: int = 0;
            if (fno != null) {
                if (fno.sret != null) { has_sret = 1; }
            }
            nargs: int = 0;
            a: ?*Expr = k.args;
            while (a != null) {
                nargs = nargs + 1;
                a = a.next;
            }
            nregs: int = nargs + has_sret;
            if (nregs > 6) { error("too many arguments"); }
            if (has_sret == 0 && nargs <= 1) {
                a = k.args;
                if (a != null) {
                    if (imm_operand(a) != 0 && fits_imm32(imm_value(a))) {
                        cg_mov_imm(imm_value(a), cg_arg_reg(0));
                    } else {
                        gen_expr(a);
                        cg_mov_rr(0, cg_arg_reg(0));
                    }
                }
                cg_call(k.funcname);
                return;
            }
            if (has_sret != 0) {
                if (fno == null) { error("missing function"); }
                sz: int = type_size(fno.return_ty or error("missing return type"));
                if (sz <= 0) { sz = 8; }
                sz = (sz + 15) & (0 - 16);
                cg_alu_imm(5, sz, 4);
                cg_mov_rr(4, 0);
                cg_push(0);
            }
            a = k.args;
            while (a != null) {
                gen_expr(a);
                cg_push(0);
                a = a.next;
            }
            i: int = nregs - 1;
            while (i >= 0) {
                cg_pop(cg_arg_reg(i));
                i = i - 1;
            }
            cg_call(k.funcname);
            return;
        }
        Binary k -> {
            gen_binary(k.op, k.lhs, k.rhs);
            bty: ?*Type = n.ty;
            if (bty != null) {
                if (is_i8_ty(bty)) { cg_movzb_al_rax(); }
            }
            return;
        }
        If k -> {
            le: int = new_label();
            lelse: int = new_label();
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, lelse);
            gen_expr(k.then);
            cg_jump_id(0 - 1, le);
            cg_label_id(lelse);
            gen_expr(k.els);
            cg_label_id(le);
            return;
        }
        Match k -> {
            gen_match(k.cond, k.arms);
            return;
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                gen_stmt(s);
                s = s.next;
            }
            return;
        }
        _ -> { error("invalid expression"); }
    }
}

gen_match(cond: *Expr, arms: ?*MatchArm) raises Error {
    lend: int = new_label();
    match cond.kind {
        Var _p -> { gen_addr(cond); }
        MemberAccess _p -> { gen_addr(cond); }
        Deref _p -> { gen_addr(cond); }
        _ -> { gen_expr(cond); }
    }
    cg_push(0);
    cg_mov_mr(0, 0, 0);
    cg_push(0);
    arm: ?*MatchArm = arms;
    while (arm != null) {
        la: int = new_label();
        av: ?*Variant = arm.variant;
        if (av != null) {
            cg_mov_mr(4, 0, 0);
            cg_alu_imm(7, av.tag, 0);
            cg_jump_id(5, la);
        }
        bv: ?*Obj = arm.binder;
        if (bv != null) {
            if (av == null) { error("missing variant"); }
            psz: int = av.payload_size;
            cg_mov_mr(4, 8, 6);
            cg_alu_imm(0, 8, 6);
            cg_lea_mr(5, bv.offset, 7);
            emit_memcpy(psz);
        }
        gen_stmt(arm.body);
        cg_jump_id(0 - 1, lend);
        if (av != null) {
            cg_label_id(la);
        }
        arm = arm.next;
    }
    cg_mov_imm(1, 7);
    cg_call("exit");
    cg_label_id(lend);
    cg_alu_imm(0, 16, 4);
}

gen_stmt(n: *Stmt) raises Error {
    match n.kind {
        Return k -> {
            lhs: ?*Expr = k.lhs;
            if (lhs != null) {
                gen_expr(lhs);
                sret: ?*Obj = current_sret;
                if (sret != null) {
                    cg_mov_rr(0, 6);
                    cg_mov_mr(5, sret.offset, 7);
                    emit_memcpy(type_size(current_return_ty or error("missing return type")));
                    cg_mov_rr(7, 0);
                }
            } else { cg_mov_imm(0, 0); }
            cg_jump_id(0 - 1, current_return_lab);
            return;
        }
        ExprStmt k -> {
            gen_expr(k.lhs);
            return;
        }
        Block k -> {
            s: ?*Stmt = k.body;
            while (s != null) {
                gen_stmt(s);
                s = s.next;
            }
            return;
        }
        If k -> {
            le: int = new_label();
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            els: ?*Stmt = k.els;
            if (els == null) {
                cg_jump_id(4, le);
                gen_stmt(k.then);
                cg_label_id(le);
                return;
            }
            lelse: int = new_label();
            cg_jump_id(4, lelse);
            gen_stmt(k.then);
            cg_jump_id(0 - 1, le);
            cg_label_id(lelse);
            gen_stmt(els);
            cg_label_id(le);
            return;
        }
        While k -> {
            lb: int = new_label();
            le2: int = new_label();
            cg_label_id(lb);
            gen_expr(k.cond);
            cg_alu_imm(7, 0, 0);
            cg_jump_id(4, le2);
            gen_stmt(k.body);
            cg_jump_id(0 - 1, lb);
            cg_label_id(le2);
            return;
        }
        Match k -> {
            gen_match(k.cond, k.arms);
            return;
        }
        Raise k -> {
            if (k.exn.members != null) {
                esz: int = k.exn.size;
                if (esz <= 0) { esz = 8; }
                cg_mov_imm(esz, 7);
                cg_call("malloc");
                cg_push(3);
                cg_mov_rr(0, 3);
                gen_struct_inits(k.inits);
                cg_mov_rr(3, 6);
                cg_pop(3);
            } else { cg_mov_imm(0, 6); }
            cg_mov_imm(k.exn.tag, 7);
            cg_call("l8_raise");
            return;
        }
        Try k -> {
            lcatch: int = new_label();
            ltryend: int = new_label();
            cg_lea_mr(5, k.buf.offset, 7);
            cg_call("l8_try_begin");
            cg_alu_imm(7, 0, 0);
            cg_jump_id(5, lcatch);
            gen_stmt(k.body);
            cg_call("l8_try_end");
            cg_jump_id(0 - 1, ltryend);
            cg_label_id(lcatch);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                la2: int = new_label();
                ced: *ExnDef = arm2.exn;
                cg_mov_rip_r("l8_exc_tag", 0, 0);
                cg_alu_imm(7, ced.tag, 0);
                cg_jump_id(5, la2);
                binder: ?*Obj = arm2.binder;
                if (binder != null) {
                    psz2: int = ced.size;
                    if (psz2 > 0) {
                        cg_mov_rip_r("l8_exc_ptr", 0, 6);
                        cg_lea_mr(5, binder.offset, 7);
                        emit_memcpy(psz2);
                    }
                }
                gen_stmt(arm2.body);
                cg_jump_id(0 - 1, ltryend);
                cg_label_id(la2);
                arm2 = arm2.next;
            }
            cg_mov_rip_r("l8_exc_tag", 0, 7);
            cg_mov_rip_r("l8_exc_ptr", 0, 6);
            cg_call("l8_raise");
            cg_label_id(ltryend);
            return;
        }
        _ -> { error("invalid statement"); }
    }
}

assign_lvar_offsets(fn: *Function) raises Error {
    off: int = 0;
    v: ?*Obj = fn.locals;
    while (v != null) {
        vty: *Type = v.ty or error("missing local type");
        sz: int = type_size(vty);
        if (sz <= 0) { sz = 8; }
        if (!is_array(vty)) {
            if (sz < 8) { sz = 8; }
        } else { sz = (sz + 7) & (0 - 8); }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 7) / 16 * 16 + 8;
}

emit_global_init(g: *Obj) raises Error {
    init: *Expr = g.init or error("missing global initializer");
    gty: *Type = g.ty or error("missing global type");
    sz: int = type_size(gty);
    if (sz <= 0) { sz = 8; }
    v: int = const_value(init);
    cg_label(g.name);
    if (sz > 8) { error("global initializer must be a scalar constant"); }
    cg_quad(v);
}

emit_data() raises Error {
    g: ?*Obj = globals;
    any_data: int = 0;
    while (g != null) {
        if (g.is_func == 0 && g.init != null) {
            if (any_data == 0) {
                cg_section(as_SEC_DATA);
                cg_align(8);
                any_data = 1;
            }
            emit_global_init(g);
        }
        g = g.next;
    }
    g = globals;
    any_bss: int = 0;
    while (g != null) {
        if (g.is_func == 0 && g.init == null) {
            if (any_bss == 0) {
                cg_section(as_SEC_BSS);
                cg_align(8);
                any_bss = 1;
            }
            sz: int = 8;
            gty: ?*Type = g.ty;
            if (gty != null) { sz = type_size(gty); }
            if (sz <= 0) { sz = 8; }
            if (gty != null && !is_array(gty) && sz < 8) { sz = 8; }
            cg_label(g.name);
            cg_skip(sz);
        }
        g = g.next;
    }
    cg_section(as_SEC_RODATA);
    cg_align(8);
    s: ?*StrLit = str_lits;
    while (s != null) {
        cg_label(cg_name_num(".L.str", s.label));
        cg_quad(s.len);
        cg_bytes(s.data, 0, s.len);
        s = s.next;
    }
}

emit_text() raises Error {
    fn: ?*Function = functions;
    cg_section(as_SEC_TEXT);
    oob_lab = new_label();
    while (fn != null) {
        narrow_top = null;
        catch_top = null;
        assign_lvar_offsets(fn);
        current_fn_name = fn.name;
        current_return_ty = fn.return_ty;
        current_sret = fn.sret;
        current_fn = fn;
        current_return_lab = new_label();
        cg_global(fn.name);
        cg_label(fn.name);
        cg_rsp_off = 0;
        cg_push(5);
        cg_mov_rr(4, 5);
        cg_alu_imm(5, fn.stack_size, 4);
        ri: int = 0;
        sret: ?*Obj = fn.sret;
        if (sret != null) {
            cg_mov_rm(cg_arg_reg(ri), 5, sret.offset);
            ri = ri + 1;
        }
        /* Spill all argregs first; by-ref memcpy clobbers %rsi/%rdi/%rax. */
        base_ri: int = ri;
        i: int = 0;
        while (i < fn.nparams) {
            po: ?*Obj = fn_param(fn, i);
            if (po == null) { error("null obj"); }
            p: *Obj = po;
            cg_mov_rm(cg_arg_reg(ri), 5, p.offset);
            ri = ri + 1;
            i = i + 1;
        }
        ri = base_ri;
        i = 0;
        while (i < fn.nparams) {
            po2: ?*Obj = fn_param(fn, i);
            if (po2 == null) { error("null obj"); }
            p2: *Obj = po2;
            pty: ?*Type = p2.ty;
            if (pty == null) { error("missing param type"); }
            if (passes_by_ref(pty)) {
                cg_mov_mr(5, p2.offset, 6);
                cg_lea_mr(5, p2.offset, 7);
                emit_memcpy(type_size(pty));
            }
            ri = ri + 1;
            i = i + 1;
        }
        body: ?*Stmt = fn.body;
        if (body == null) { error("missing body"); }
        gen_stmt(body);
        sret2: ?*Obj = current_sret;
        if (sret2 != null) {
            cg_mov_rr(0, 6);
            cg_mov_mr(5, sret2.offset, 7);
            emit_memcpy(type_size(current_return_ty or error("missing return type")));
            cg_mov_rr(7, 0);
        }
        cg_label_id(current_return_lab);
        cg_mov_rr(5, 4);
        cg_pop(5);
        cg_ret();
        fn = fn.next;
    }
    cg_label_id(oob_lab);
    emit_exit1();
}

codegen() raises Error {
    emit_data();
    emit_text();
    if (cg_direct_mode == 0) { emit_flush(); }
}

type Timespec = { sec: int; nsec: int; }

mono_ns(): int {
    ts: Timespec = uninitialized;
    syscall(228, 1, &ts, 0, 0, 0);
    ts.sec * 1000000000 + ts.nsec;
}

profile_t0: int;
profile_prev: int;
profile_cyc0: int;
profile_cyc_prev: int;
profile_flt0: int;
profile_flt_prev: int;
profile_rbuf: []i8;

profile_faults(): int {
    syscall(98, 0, profile_rbuf, 0, 0, 0);
    p: *int = (&profile_rbuf[64]) as *int;
    p.*;
}

profile_rss_kb(): int {
    p: *int = (&profile_rbuf[32]) as *int;
    p.*;
}

profile_print(label: *i8, dt_ns: int, dt_cyc: int, dt_flt: int) {
    write(2, "profile: ", len("profile: "));
    write(2, label, len(label));
    write(2, " ", len(" "));
    ms: int = dt_ns / 1000000;
    us: int = (dt_ns / 1000) % 1000;
    emit_num_fd(2, ms);
    write(2, ".", len("."));
    if (us < 100) { write(2, "0", len("0")); }
    if (us < 10) { write(2, "0", len("0")); }
    emit_num_fd(2, us);
    write(2, " ms  ", len(" ms  "));
    emit_num_fd(2, dt_cyc);
    write(2, " cyc  ", len(" cyc  "));
    emit_num_fd(2, dt_flt);
    write(2, " flt\n", len(" flt\n"));
}

profile_start() {
    if (do_profile == 0) { return; }
    profile_rbuf = new i8[256];
    profile_t0 = mono_ns();
    profile_prev = profile_t0;
    profile_cyc0 = rdtsc();
    profile_cyc_prev = profile_cyc0;
    profile_flt0 = profile_faults();
    profile_flt_prev = profile_flt0;
}

profile_mark(label: *i8) {
    if (do_profile == 0) { return; }
    t: int = mono_ns();
    c: int = rdtsc();
    f: int = profile_faults();
    profile_print(label, t - profile_prev, c - profile_cyc_prev, f - profile_flt_prev);
    profile_prev = t;
    profile_cyc_prev = c;
    profile_flt_prev = f;
}

profile_end() {
    if (do_profile == 0) { return; }
    profile_print("TOTAL", profile_prev - profile_t0, profile_cyc_prev - profile_cyc0, profile_flt_prev - profile_flt0);
    write(2, "profile: rss ", len("profile: rss "));
    emit_num_fd(2, profile_rss_kb());
    write(2, " kb\n", len(" kb\n"));
}

is_profile_flag(s: [z]i8): bool {
    if (s[0] == '-' && s[1] == 'p' && s[2] == 0i8) { return true; }
    if (s[0] == '-' && s[1] == '-' && s[2] == 'p' && s[3] == 'r' && s[4] == 'o'
        && s[5] == 'f' && s[6] == 'i' && s[7] == 'l' && s[8] == 'e' && s[9] == 0i8) {
        return true;
    }
    false;
}

compiler_frontend(src_path: *i8) raises Error {
    profile_start();
    as_init();
    init_runtime();
    init_dummies();
    profile_mark("init");
    source = "";
    source_len = 0;
    source_path = src_path;
    tok = token_eof;
    parse_program(src_path);
    profile_mark("load_parse");
    typecheck_program();
    profile_mark("typecheck");
    check_unused_functions();
    profile_mark("unused_fns");
    check_unused_locals();
    profile_mark("unused_locals");
    check_return_style();
    check_raises_functions();
    profile_mark("raises");
    check_noreturn_functions();
    profile_mark("noreturn");
    codegen();
    profile_mark("codegen");
}

compiler_build_direct(src_path: *i8): int {
    try {
        cg_direct_mode = 1;
        compiler_frontend(src_path);
        as_assemble_file_append("runtime.s");
        profile_mark("runtime");
        0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1;
    }
}

compiler_main(argc: int, argv: [][z]i8): int {
    try {
        cg_direct_mode = 0;
        do_profile = 0;
        path: ?*i8 = null;
        ai: int = 1;
        while (ai < argc) {
            arg: *i8 = argv[ai];
            if (is_profile_flag(arg)) {
                do_profile = 1;
            } else {
                if (path != null) {
                    write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n", len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
                    return 1;
                }
                path = arg;
            }
            ai = ai + 1;
        }
        if (path == null) {
            write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n", len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
            return 1;
        }
        src_path: *i8 = path;
        compiler_frontend(src_path);
        profile_end();
        0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1;
    }
}
