// Canonical printer: one layout, comments stay on the node they document.
FMT_WIDTH: int = 100;

fmt_out: ?*StrBuf = null;

fmt_indent: int = 0;

fmt_col: int = 0;

fmt_last_blank: int = 1;

fmt_sb() raises Error: *StrBuf {
    fmt_out or error("fmt");
}

fmt_putc(c: i8) raises Error {
    sb_putc(fmt_sb(), c);
    if (c == '\n') {
        if (fmt_col == 0) {
            fmt_last_blank = 1;
        } else {
            fmt_last_blank = 0;
        }
        fmt_col = 0;
    } else {
        fmt_last_blank = 0;
        fmt_col = fmt_col + 1;
    }
}

fmt_puts(s: []i8) raises Error {
    i: int = 0;
    n: int = len(s);
    while (i < n) {
        fmt_putc(s[i]);
        i = i + 1;
    }
}

fmt_pad() raises Error {
    n: int = fmt_indent * 4;
    while (fmt_col < n) {
        fmt_putc(' ');
    }
}

fmt_newline() raises Error {
    fmt_putc('\n');
}

fmt_nl() raises Error {
    fmt_newline();
    fmt_pad();
}

fmt_blank() raises Error {
    if (fmt_col != 0) {
        fmt_newline();
    }
    fmt_nl();
}

fmt_ensure_line() raises Error {
    if (fmt_col == 0) {
        fmt_pad();
    }
}

fmt_space() raises Error {
    if (fmt_col != 0) {
        fmt_putc(' ');
    }
}

fmt_uint(n: int) raises Error {
    if (n >= 10) {
        fmt_uint(n / 10);
    }
    fmt_putc('0' + (n % 10) trunc i8);
}

fmt_int(n: int) raises Error {
    if (n < 0) {
        fmt_putc('-');
        fmt_uint(0 - n);
        return;
    }
    fmt_uint(n);
}

fmt_need_wrap(extra: int): bool {
    fmt_col + extra > FMT_WIDTH;
}

fmt_comma() raises Error {
    fmt_putc(',');
    if (fmt_need_wrap(20)) {
        fmt_newline();
        fmt_indent = fmt_indent + 1;
        fmt_pad();
        fmt_indent = fmt_indent - 1;
    } else {
        fmt_putc(' ');
    }
}

fmt_lead(h: ?*Com) raises Error {
    c: ?*Com = h;
    while (c != null) {
        if (c.nls >= 2) {
            if (fmt_last_blank == 0) {
                fmt_blank();
            }
        } else {
            fmt_ensure_line();
        }
        fmt_puts(c.text);
        fmt_newline();
        c = c.next;
    }
}

fmt_trail(h: ?*Com) raises Error {
    c: ?*Com = h;
    while (c != null) {
        fmt_space();
        fmt_puts(c.text);
        c = c.next;
    }
}

fmt_ty(t: ?*Type) noregion raises Error {
    fmt_puts(browse_type_str(t));
}

fmt_bound_name(name: []i8, bound: []i8) raises Error {
    if (len(bound) == 0) {
        return;
    }
    fmt_putc('@');
    if (!streq(bound, name)) {
        fmt_puts(bound);
    }
}

fmt_param(p: *Obj) noregion raises Error {
    fmt_puts(p.name);
    fmt_puts(": ");
    fmt_ty(p.ty);
    fmt_bound_name(p.name, p.life_bound);
}

fmt_escape_byte(c: i8, squote: int) raises Error {
    if (c == '\\') {
        fmt_puts("\\\\");
        return;
    }
    if (c == '\n') {
        fmt_puts("\\n");
        return;
    }
    if (c == '\t') {
        fmt_puts("\\t");
        return;
    }
    if (c == '\r') {
        fmt_puts("\\r");
        return;
    }
    if (c == 0i8) {
        fmt_puts("\\0");
        return;
    }
    if (squote != 0 && c == '\'') {
        fmt_puts("\\'");
        return;
    }
    if (squote == 0 && c == '"') {
        fmt_puts("\\\"");
        return;
    }
    u: int = c as int;
    if (u >= 32 && u < 127) {
        fmt_putc(c);
        return;
    }
    fmt_puts("\\");
    fmt_putc(c);
}

fmt_char(v: int) raises Error {
    fmt_putc('\'');
    fmt_escape_byte(v trunc i8, 1);
    fmt_putc('\'');
}

fmt_str_data(d: []i8, n: int) raises Error {
    i: int = 0;
    nls: int = 0;
    has_tq: int = 0;
    while (i < n) {
        if (d[i] == '\n') {
            nls = nls + 1;
        }
        if (i + 2 < n && d[i] == '"' && d[i + 1] == '"' && d[i + 2] == '"') {
            has_tq = 1;
        }
        i = i + 1;
    }
    use_ml: int = 0;
    if (nls > 1 && has_tq == 0) {
        use_ml = 1;
    }
    if (nls == 1 && n > 1 && d[n - 1] != '\n' && has_tq == 0) {
        use_ml = 1;
    }
    if (use_ml != 0) {
        fmt_puts("\"\"\"");
        fmt_newline();
        j: int = 0;
        while (j < n) {
            c: i8 = d[j];
            if (c == '\\') {
                fmt_puts("\\\\");
            } else {
                fmt_putc(c);
            }
            j = j + 1;
        }
        fmt_puts("\"\"\"");
        return;
    }
    fmt_putc('"');
    k: int = 0;
    while (k < n) {
        fmt_escape_byte(d[k], 0);
        k = k + 1;
    }
    fmt_putc('"');
}

fmt_str_label(lab: int) raises Error {
    want: int = lab - 1;
    s: ?*StrLit = str_lits;
    while (s != null) {
        if (s.label == want) {
            fmt_str_data(s.data, s.len);
            return;
        }
        s = s.next;
    }
    fmt_puts("\"\"");
}

fmt_prec_bin(op: BinOp): int {
    match op {
        Mul -> {
            12;
        }
        Div -> {
            12;
        }
        Mod -> {
            12;
        }
        Add -> {
            11;
        }
        Sub -> {
            11;
        }
        Shl -> {
            10;
        }
        Shr -> {
            10;
        }
        Lt -> {
            9;
        }
        Gt -> {
            9;
        }
        Le -> {
            9;
        }
        Ge -> {
            9;
        }
        Eq -> {
            8;
        }
        Ne -> {
            8;
        }
        And -> {
            7;
        }
        Xor -> {
            6;
        }
        Or -> {
            5;
        }
    }
}

fmt_op(op: BinOp) raises Error {
    match op {
        Add -> {
            fmt_puts("+");
        }
        Sub -> {
            fmt_puts("-");
        }
        Mul -> {
            fmt_puts("*");
        }
        Div -> {
            fmt_puts("/");
        }
        Mod -> {
            fmt_puts("%");
        }
        Shl -> {
            fmt_puts("<<");
        }
        Shr -> {
            fmt_puts(">>");
        }
        And -> {
            fmt_puts("&");
        }
        Xor -> {
            fmt_puts("^");
        }
        Or -> {
            fmt_puts("|");
        }
        Eq -> {
            fmt_puts("==");
        }
        Ne -> {
            fmt_puts("!=");
        }
        Lt -> {
            fmt_puts("<");
        }
        Le -> {
            fmt_puts("<=");
        }
        Gt -> {
            fmt_puts(">");
        }
        Ge -> {
            fmt_puts(">=");
        }
    }
}

fmt_prec(e: *Expr): int {
    match e.kind {
        Assign _ -> {
            1;
        }
        OrElse _ -> {
            2;
        }
        LogOr _ -> {
            3;
        }
        LogAnd _ -> {
            4;
        }
        Binary k -> {
            fmt_prec_bin(k.op);
        }
        Not _ -> {
            13;
        }
        Neg _ -> {
            13;
        }
        BitNot _ -> {
            13;
        }
        Addr _ -> {
            13;
        }
        If _ -> {
            0;
        }
        Match _ -> {
            0;
        }
        Block _ -> {
            0;
        }
        Sizeof _ -> {
            15;
        }
        _ -> {
            15;
        }
    }
}

fmt_expr(e: *Expr) noregion raises Error {
    fmt_expr_prec(e, 0);
}

fmt_expr_prec(e: *Expr, ctx: int) noregion raises Error {
    p: int = fmt_prec(e);
    wrap: int = 0;
    if (p < ctx) {
        wrap = 1;
    }
    if (wrap != 0) {
        fmt_putc('(');
    }
    match e.kind {
        Num k -> {
            if (k.str_label != 0) {
                fmt_str_label(k.str_label);
            } else if (k.form == LIT_CHAR) {
                fmt_char(k.val);
            } else if (k.form == LIT_TRUE) {
                fmt_puts("true");
            } else if (k.form == LIT_FALSE) {
                fmt_puts("false");
            } else if (k.form == LIT_I8) {
                fmt_int(k.val);
                fmt_puts("i8");
            } else if (k.form == LIT_I32) {
                fmt_int(k.val);
                fmt_puts("i32");
            } else if (k.form == LIT_U32) {
                fmt_int(k.val);
                fmt_puts("u32");
            } else if (k.form == LIT_F32 || k.form == LIT_F64) {
                if (len(k.spell) != 0) {
                    fmt_puts(k.spell);
                } else {
                    fmt_int(k.val);
                }
                if (k.form == LIT_F64) {
                    fmt_puts("f64");
                }
            } else {
                fmt_int(k.val);
            }
        }
        Null -> {
            fmt_puts("null");
        }
        Var k -> {
            fmt_puts(k.name);
        }
        Binary k -> {
            fmt_expr_prec(k.lhs, p);
            fmt_space();
            fmt_op(k.op);
            fmt_space();
            fmt_expr_prec(k.rhs, p + 1);
        }
        Assign k -> {
            fmt_expr_prec(k.lhs, p + 1);
            fmt_puts(" = ");
            fmt_expr_prec(k.rhs, p);
        }
        Addr k -> {
            fmt_putc('&');
            fmt_expr_prec(k.lhs, 13);
        }
        Deref k -> {
            fmt_expr_prec(k.lhs, 14);
            fmt_puts(".*");
        }
        Index k -> {
            fmt_expr_prec(k.lhs, 14);
            fmt_putc('[');
            fmt_expr(k.idx);
            fmt_putc(']');
        }
        Not k -> {
            fmt_putc('!');
            fmt_expr_prec(k.lhs, 13);
        }
        Neg k -> {
            fmt_putc('-');
            fmt_expr_prec(k.lhs, 13);
        }
        BitNot k -> {
            fmt_putc('~');
            fmt_expr_prec(k.lhs, 13);
        }
        LogAnd k -> {
            fmt_expr_prec(k.lhs, 4);
            fmt_puts(" && ");
            fmt_expr_prec(k.rhs, 5);
        }
        LogOr k -> {
            fmt_expr_prec(k.lhs, 3);
            fmt_puts(" || ");
            fmt_expr_prec(k.rhs, 4);
        }
        OrElse k -> {
            fmt_expr_prec(k.lhs, 3);
            fmt_puts(" or ");
            fmt_expr_prec(k.rhs, 2);
        }
        Funcall k -> {
            fmt_puts(k.funcname);
            fmt_putc('(');
            fmt_expr_list(k.args);
            fmt_putc(')');
        }
        MemberAccess k -> {
            fmt_expr_prec(k.lhs, 14);
            fmt_putc('.');
            fmt_puts(k.name);
        }
        As k -> {
            fmt_expr_prec(k.lhs, 14);
            fmt_puts(" as ");
            fmt_ty(e.ty);
        }
        Trunc k -> {
            fmt_expr_prec(k.lhs, 14);
            fmt_puts(" trunc ");
            fmt_ty(e.ty);
        }
        New k -> {
            fmt_new(e, k.lhs, k.inits, k.fill, k.vname);
        }
        StructLit k -> {
            fmt_puts(k.name);
            fmt_space();
            fmt_inits(k.inits, 0);
        }
        VariantLit k -> {
            fmt_puts(k.tyname);
            fmt_putc('.');
            fmt_puts(k.name);
            if (k.inits != null) {
                fmt_space();
                fmt_inits(k.inits, 0);
            }
        }
        If k -> {
            fmt_puts("if (");
            fmt_expr(k.cond);
            fmt_puts(") ");
            fmt_expr(k.then);
            fmt_puts(" else ");
            fmt_expr(k.els);
        }
        Match k -> {
            fmt_puts("match ");
            fmt_expr(k.cond);
            fmt_space();
            fmt_match_arms(k.arms);
        }
        Block k -> {
            fmt_block_stmts(k.body, null, null);
        }
        Sizeof k -> {
            fmt_puts("sizeof(");
            if (k.ty != null) {
                fmt_ty(k.ty);
            } else {
                se: *Expr = k.e or error("sizeof");
                fmt_expr(se);
            }
            fmt_putc(')');
        }
    }
    if (wrap != 0) {
        fmt_putc(')');
    }
}

fmt_expr_list(head: ?*Expr) noregion raises Error {
    e: ?*Expr = head;
    first: int = 1;
    while (e != null) {
        if (first == 0) {
            fmt_comma();
        }
        first = 0;
        eu: *Expr = e;
        fmt_expr(eu);
        e = eu.next;
    }
}

fmt_inits(head: ?*FieldInit, force_multi: int) noregion raises Error {
    n: int = 0;
    c: ?*FieldInit = head;
    while (c != null) {
        n = n + 1;
        if (c.lead != null) {
            force_multi = 1;
        }
        c = c.next;
    }
    fmt_putc('{');
    if (head == null) {
        fmt_putc('}');
        return;
    }
    if (force_multi != 0 || n > 3) {
        fmt_indent = fmt_indent + 1;
        i: ?*FieldInit = head;
        while (i != null) {
            fmt_nl();
            fmt_lead(i.lead);
            fmt_ensure_line();
            fmt_puts(i.name);
            fmt_puts(": ");
            lhs: *Expr = i.lhs or error("field");
            fmt_expr(lhs);
            fmt_trail(i.trail);
            if (i.next != null) {
                fmt_putc(',');
            }
            i = i.next;
        }
        fmt_indent = fmt_indent - 1;
        fmt_nl();
        fmt_putc('}');
        return;
    }
    fmt_putc(' ');
    j: ?*FieldInit = head;
    first: int = 1;
    while (j != null) {
        if (first == 0) {
            fmt_puts(", ");
        }
        first = 0;
        fmt_puts(j.name);
        fmt_puts(": ");
        lhs2: *Expr = j.lhs or error("field");
        fmt_expr(lhs2);
        fmt_trail(j.trail);
        j = j.next;
    }
    fmt_puts(" }");
}

fmt_new(
    e: *Expr,
    lhs: ?*Expr,
    inits: ?*FieldInit,
    fill: ?*Expr,
    vname: []i8
) noregion raises Error {
    fmt_puts("new ");
    ty: *Type = e.ty or error("new");
    if (fill != null) {
        fmt_ty(type_base(ty));
        fmt_putc('[');
        ln: *Expr = lhs or error("new");
        fmt_expr(ln);
        fmt_puts("](");
        fmt_expr(fill);
        fmt_putc(')');
        return;
    }
    if (len(vname) != 0) {
        fmt_ty(type_base(ty));
        fmt_putc('.');
        fmt_puts(vname);
        if (inits != null) {
            fmt_space();
            fmt_inits(inits, 0);
        }
        return;
    }
    fmt_ty(type_base(ty));
    fmt_space();
    fmt_inits(inits, 0);
}

fmt_stmt_is_block(s: *Stmt): bool {
    match s.kind {
        Block _ -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

fmt_block_stmts(body: ?*Stmt, lead: ?*Com, trail: ?*Com) noregion raises Error {
    fmt_putc('{');
    if (body == null && trail == null && lead == null) {
        fmt_puts(" }");
        return;
    }
    fmt_indent = fmt_indent + 1;
    if (lead != null) {
        fmt_nl();
        fmt_lead(lead);
    }
    s: ?*Stmt = body;
    while (s != null) {
        fmt_nl();
        su: *Stmt = s;
        fmt_stmt(su);
        s = su.next;
    }
    if (trail != null) {
        fmt_nl();
        fmt_lead(trail);
    }
    fmt_indent = fmt_indent - 1;
    if (fmt_col == 0) {
        fmt_pad();
    } else {
        fmt_nl();
    }
    fmt_putc('}');
}

fmt_brace_stmt(s: *Stmt) noregion raises Error {
    if (fmt_stmt_is_block(s)) {
        fmt_space();
        fmt_stmt(s);
        return;
    }
    fmt_indent = fmt_indent + 1;
    fmt_nl();
    fmt_stmt(s);
    fmt_indent = fmt_indent - 1;
}

fmt_match_arms(head: ?*MatchArm) noregion raises Error {
    fmt_putc('{');
    fmt_indent = fmt_indent + 1;
    a: ?*MatchArm = head;
    while (a != null) {
        fmt_nl();
        fmt_lead(a.lead);
        fmt_ensure_line();
        fmt_puts(a.name);
        if (len(a.binder_name) != 0) {
            fmt_space();
            fmt_puts(a.binder_name);
        }
        fmt_puts(" ->");
        fmt_brace_stmt(a.body);
        fmt_trail(a.trail);
        a = a.next;
    }
    fmt_indent = fmt_indent - 1;
    fmt_nl();
    fmt_putc('}');
}

fmt_if_stmt(cond: *Expr, then: *Stmt, els: ?*Stmt) noregion raises Error {
    fmt_puts("if (");
    fmt_expr(cond);
    fmt_putc(')');
    fmt_brace_stmt(then);
    if (els == null) {
        return;
    }
    el: *Stmt = els;
    fmt_puts(" else");
    match el.kind {
        If k -> {
            fmt_space();
            fmt_if_stmt(k.cond, k.then, k.els);
        }
        _ -> {
            fmt_brace_stmt(el);
        }
    }
}

fmt_stmt(s: *Stmt) noregion raises Error {
    if (!fmt_stmt_is_block(s)) {
        fmt_lead(s.lead);
        fmt_ensure_line();
    }
    match s.kind {
        Return k -> {
            fmt_puts("return");
            if (k.lhs != null) {
                fmt_space();
                ret_e: *Expr = k.lhs or error("return");
                fmt_expr(ret_e);
            }
            fmt_putc(';');
        }
        If k -> {
            fmt_if_stmt(k.cond, k.then, k.els);
        }
        While k -> {
            fmt_puts("while (");
            fmt_expr(k.cond);
            fmt_putc(')');
            fmt_brace_stmt(k.body);
        }
        For k -> {
            fmt_puts("for ");
            fmt_puts(k.item.name);
            fmt_puts(" in ");
            fmt_expr(k.iter);
            if (k.hi != null) {
                fmt_puts("..");
                hi: *Expr = k.hi or error("for");
                fmt_expr(hi);
            }
            fmt_brace_stmt(k.body);
        }
        Block k -> {
            fmt_block_stmts(k.body, s.lead, s.trail);
        }
        ExprStmt k -> {
            fmt_expr(k.lhs);
            fmt_putc(';');
        }
        Decl k -> {
            fmt_puts(k.name);
            fmt_puts(": ");
            fmt_ty(k.ty);
            if (k.init != null) {
                fmt_puts(" = ");
                init_e: *Expr = k.init or error("decl");
                fmt_expr(init_e);
            }
            fmt_putc(';');
        }
        Match k -> {
            fmt_puts("match ");
            fmt_expr(k.cond);
            fmt_space();
            fmt_match_arms(k.arms);
        }
        Raise k -> {
            fmt_puts("raise ");
            fmt_puts(k.name);
            if (k.has != 0) {
                fmt_space();
                fmt_inits(k.inits, 0);
            }
            fmt_putc(';');
        }
        Try k -> {
            fmt_puts("try");
            fmt_brace_stmt(k.body);
            arm: ?*CatchArm = k.arms;
            while (arm != null) {
                if (arm.lead != null) {
                    fmt_nl();
                    fmt_lead(arm.lead);
                    fmt_ensure_line();
                    fmt_puts("with ");
                } else {
                    fmt_puts(" with ");
                }
                fmt_puts(arm.name);
                if (len(arm.binder_name) != 0) {
                    fmt_space();
                    fmt_puts(arm.binder_name);
                }
                fmt_puts(" ->");
                fmt_brace_stmt(arm.body);
                fmt_trail(arm.trail);
                arm = arm.next;
            }
        }
        Region k -> {
            fmt_puts("region");
            fmt_brace_stmt(k.body);
        }
        Comment k -> {
            fmt_puts(k.text);
        }
    }
    match s.kind {
        Block _ -> { }
        _ -> {
            fmt_trail(s.trail);
        }
    }
}

fmt_members(head: ?*Member, semi: int) noregion raises Error {
    m: ?*Member = head;
    while (m != null) {
        fmt_nl();
        fmt_lead(m.lead);
        fmt_ensure_line();
        fmt_puts(m.name);
        fmt_puts(": ");
        fmt_ty(m.ty);
        if (semi != 0) {
            fmt_putc(';');
        } else {
            if (m.next != null) {
                fmt_putc(',');
            }
        }
        fmt_trail(m.trail);
        m = m.next;
    }
}

enum_has_custom_tags(ed: *EnumDef): bool {
    i: int = 0;
    v: ?*Variant = ed.variants;
    while (v != null) {
        if (v.tag != i) {
            return true;
        }
        i = i + 1;
        v = v.next;
    }
    false;
}

fmt_enum(ed: *EnumDef) noregion raises Error {
    fmt_puts("type ");
    fmt_puts(ed.name);
    show: int = 0;
    tty: ?*Type = ed.tag_ty;
    if (ed.min_size != 0) {
        show = 1;
    }
    if (tty != null && !is_int_ty(tty)) {
        show = 1;
    }
    if (show != 0) {
        fmt_puts(": ");
        if (tty != null) {
            fmt_ty(tty);
        } else {
            fmt_puts("int");
        }
        if (ed.min_size != 0) {
            fmt_puts(", ");
            fmt_uint(ed.min_size);
        }
    }
    fmt_puts(" =");
    nums: bool = enum_has_custom_tags(ed);
    fmt_indent = fmt_indent + 1;
    v: ?*Variant = ed.variants;
    while (v != null) {
        fmt_nl();
        fmt_lead(v.lead);
        fmt_ensure_line();
        fmt_puts("| ");
        if (nums) {
            fmt_int(v.tag);
            fmt_putc(' ');
        }
        fmt_puts(v.name);
        fmt_variant_fields(v.fields);
        fmt_trail(v.trail);
        v = v.next;
    }
    fmt_indent = fmt_indent - 1;
    fmt_putc(';');
}

fmt_variant_fields(head: ?*Member) noregion raises Error {
    if (head == null) {
        return;
    }
    n: int = 0;
    m0: ?*Member = head;
    while (m0 != null) {
        n = n + 1;
        if (m0.lead != null) {
            n = n + 10;
        }
        m0 = m0.next;
    }
    fmt_puts(" {");
    if (n > 3) {
        fmt_indent = fmt_indent + 1;
        fmt_members(head, 0);
        fmt_indent = fmt_indent - 1;
        fmt_nl();
        fmt_putc('}');
        return;
    }
    fmt_putc(' ');
    m: ?*Member = head;
    first: int = 1;
    while (m != null) {
        if (first == 0) {
            fmt_puts(", ");
        }
        first = 0;
        fmt_puts(m.name);
        fmt_puts(": ");
        fmt_ty(m.ty);
        fmt_trail(m.trail);
        m = m.next;
    }
    fmt_puts(" }");
}

fmt_fn(fn: *Function) noregion raises Error {
    if (fn.is_extern != 0) {
        fmt_puts("extern ");
    }
    fmt_puts(fn.name);
    fmt_putc('(');
    p: ?*Obj = fn.params;
    first: int = 1;
    np: int = 0;
    q: ?*Obj = p;
    while (q != null) {
        np = np + 1;
        q = q.param_next;
    }
    wrap: int = 0;
    if (np >= 4) {
        wrap = 1;
    }
    if (wrap != 0) {
        fmt_indent = fmt_indent + 1;
        while (p != null) {
            fmt_nl();
            pu: *Obj = p;
            fmt_lead(pu.lead);
            fmt_ensure_line();
            fmt_param(pu);
            fmt_trail(pu.trail);
            if (pu.param_next != null) {
                fmt_putc(',');
            }
            p = pu.param_next;
        }
        fmt_indent = fmt_indent - 1;
        fmt_nl();
    } else {
        while (p != null) {
            if (first == 0) {
                fmt_comma();
            }
            first = 0;
            pu2: *Obj = p;
            fmt_param(pu2);
            p = pu2.param_next;
        }
    }
    fmt_putc(')');
    if (fn.decl_imm_heap != 0) {
        fmt_puts(" noregion");
    }
    r: ?*ExnList = fn.raises_list;
    if (r != null) {
        fmt_puts(" raises ");
    }
    first = 1;
    while (r != null) {
        ru: *ExnList = r;
        if (first == 0) {
            fmt_puts(", ");
        }
        first = 0;
        fmt_puts(ru.exn.name);
        r = ru.next;
    }
    if (fn.return_ty != null) {
        fmt_puts(": ");
        fmt_ty(fn.return_ty);
        fmt_bound_name("", fn.ret_bound);
    }
    if (fn.is_extern != 0) {
        fmt_putc(';');
        return;
    }
    body: *Stmt = fn.body or error("function body");
    fmt_brace_stmt(body);
}

fmt_item(it: *Item) noregion raises Error {
    fmt_lead(it.lead);
    fmt_ensure_line();
    match it.kind {
        Import k -> {
            fmt_puts("import ");
            fmt_putc('"');
            fmt_puts(k.path);
            fmt_puts("\";");
        }
        Need k -> {
            fmt_puts("need ");
            fmt_putc('"');
            fmt_puts(k.name);
            fmt_puts("\";");
        }
        Struct k -> {
            fmt_puts("type ");
            fmt_puts(k.def.name);
            fmt_puts(" = {");
            fmt_indent = fmt_indent + 1;
            fmt_members(k.def.members, 1);
            fmt_indent = fmt_indent - 1;
            fmt_nl();
            fmt_puts("};");
        }
        Enum k -> {
            fmt_enum(k.def);
        }
        Exn k -> {
            fmt_puts("exception ");
            fmt_puts(k.def.name);
            if (k.def.members != null) {
                fmt_puts(" {");
                fmt_indent = fmt_indent + 1;
                fmt_members(k.def.members, 1);
                fmt_indent = fmt_indent - 1;
                fmt_nl();
                fmt_putc('}');
            }
            fmt_putc(';');
        }
        Func k -> {
            fmt_fn(k.fn);
        }
        Global k -> {
            fmt_puts(k.var.name);
            fmt_puts(": ");
            fmt_ty(k.var.ty);
            fmt_puts(" = ");
            init: *Expr = k.var.init or error("global");
            fmt_expr(init);
            fmt_putc(';');
        }
        Comment k -> {
            fmt_puts(k.text);
        }
    }
    fmt_trail(it.trail);
}

fmt_file() noregion raises Error: []i8@new {
    sb: *StrBuf = sb_new();
    fmt_out = sb;
    fmt_indent = 0;
    fmt_col = 0;
    fmt_last_blank = 1;
    it: ?*Item = file_items;
    first: int = 1;
    while (it != null) {
        if (first == 0) {
            fmt_blank();
        }
        first = 0;
        itu: *Item = it;
        fmt_item(itu);
        it = itu.next;
    }
    if (file_trail != null) {
        fmt_blank();
        fmt_lead(file_trail);
    }
    if (fmt_col != 0) {
        fmt_newline();
    }
    sb_finish(sb);
}

fmt_O_WRONLY: int = 1;

fmt_O_CREAT: int = 64;

fmt_O_TRUNC: int = 512;

fmt_MODE: int = 420;

fmt_write_path(path: []i8, text: []i8) raises Error {
    fd: int = open_path(path, fmt_O_WRONLY + fmt_O_CREAT + fmt_O_TRUNC, fmt_MODE);
    if (fd < 0) {
        error("cannot write formatted file");
    }
    write(fd, text, len(text));
    close(fd);
}

fmt_usage(): int {
    write(2, "error: usage: l8 fmt [-w] <source.l8>\n", len("error: usage: l8 fmt [-w] <source.l8>\n"));
    1;
}

compiler_fmt_main(argc: int, argv: [][z]i8) noregion: int {
    have_s: int = 0;
    write_back: int = 0;
    if (argc < 1) {
        return fmt_usage();
    }
    source: [z]i8 = argv[0];
    ai: int = 0;
    while (ai < argc) {
        arg: [z]i8 = argv[ai];
        if (!cli_streq(arg, "fmt")) {
            if (cli_streq(arg, "-w")) {
                write_back = 1;
            } else {
                if (have_s != 0) {
                    return fmt_usage();
                }
                source = arg;
                have_s = 1;
            }
        }
        ai = ai + 1;
    }
    if (have_s == 0) {
        return fmt_usage();
    }
    try {
        as_init();
        init_runtime();
        init_dummies();
        parse_follow_imports = 0;
        parse_resolve = 0;
        parse_program(zslice(source));
        parse_follow_imports = 1;
        parse_resolve = 1;
        text: []i8 = fmt_file();
        if (write_back != 0) {
            fmt_write_path(zslice(source), text);
        } else {
            write(1, text, len(text));
        }
        0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1;
    }
}
