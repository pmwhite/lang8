tag compiler_internal;

// Contract lowering and call obligations. Requirements are verified at callers.
bounds_param(fn: *Function, obj: *Obj): bool {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (p == obj) return true;
        p = p.param_next
    }
    false
}

bounds_named_param(fn: *Function, name: []i8): ?*Obj@fn {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (streq(p.name, name)) return p;
        p = p.param_next
    }
    null
}

bounds_param_id(fn: *Function, id: int): ?*Obj@fn {
    p: ?*Obj = fn.params;
    while (p != null) {
        if (p.browse_id == id) return p;
        p = p.param_next
    }
    null
}

// A guarded access may need only the lower half of an index contract. Keep
// that obligation separate from array requirements so callers may pass len(a).
bounds_add_nonnegative_requirement(fn: *Function@new, term: *Expr): bool {
    match term.kind {
        Var _ -> { }
        _ -> return false
    }
    variable: ?*Obj = bounds_var(term);
    if (variable == null || !bounds_param(fn, variable)) return false;
    q: ?*BoundsNonnegativeRequirement = fn.bounds_nonnegative_requirements;
    while (q != null) {
        if (q.param == variable) return true;
        q = q.next
    }
    fn.bounds_nonnegative_requirements = new BoundsNonnegativeRequirement { param: variable, next: fn.bounds_nonnegative_requirements };
    bounds_infer_changed = true;
    bounds_input_changed = true;
    true
}

bounds_add_nonnull_requirement(fn: *Function@new, term: *Expr): bool {
    variable: ?*Obj = bounds_var(term);
    if (variable == null || !bounds_param(fn, variable)) return false;
    q: ?*BoundsNonNullRequirement = fn.bounds_nonnull_requirements;
    while (q != null) {
        if (q.param == variable) return true;
        q = q.next
    }
    fn.bounds_nonnull_requirements = new BoundsNonNullRequirement { param: variable, next: fn.bounds_nonnull_requirements };
    bounds_infer_changed = true;
    bounds_input_changed = true;
    true
}

bounds_require_nonnull(
    path: *Expr,
    f: ?*BoundsState,
    file: int,
    pos: int
) raises Error, IndexOutOfBounds {
    if (bounds_nonnull(f, path)) return;
    if (bounds_infer_mode) {
        fn: ?*Function = bounds_current_fn;
        if (fn != null) _added: bool = bounds_add_nonnull_requirement(fn, path);
        return
    }
    error_at_file(file, pos, "pointer use is not proved non-null")
}

bounds_type_invariant_at(e: *Expr@new, placeholder: *Obj, value: *Expr): ?*Expr@new {
    match e.kind {
        Var k -> {
            if (k.var == placeholder) return value;
            v: ?*Obj = k.var;
            if (v != null && v.is_const && v.const_state == 2 && is_int_ty(v.ty)) return new_num(v.const_val);
            null
        }
        MemberAccess k -> {
            lhs: ?*Expr = bounds_type_invariant_at(k.lhs, placeholder, value);
            if (lhs == null) return null;
            mapped: *Expr = mk_expr(ExprKind.MemberAccess { lhs: lhs, name: k.name, member: k.member });
            mapped.ty = e.ty;
            mapped
        }
        Null -> new_null_expr();
        Num k -> new_num(k.val);
        Binary k -> {
            lhs: ?*Expr = bounds_type_invariant_at(k.lhs, placeholder, value);
            rhs: ?*Expr = bounds_type_invariant_at(k.rhs, placeholder, value);
            if (lhs == null || rhs == null) return null;
            new_binary(k.op, lhs, rhs)
        }
        LogAnd k -> {
            lhs: ?*Expr = bounds_type_invariant_at(k.lhs, placeholder, value);
            rhs: ?*Expr = bounds_type_invariant_at(k.rhs, placeholder, value);
            if (lhs == null || rhs == null) return null;
            new_logand(lhs, rhs)
        }
        _ -> null
    }
}

bounds_require_type_invariant(ty: ?*Type, value: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds {
    if (ty == null) return;
    match ty.* {
        Refined k -> {
            bounds_require_type_invariant(k.base, value, f);
            invariant: *TypeInvariant = k.invariant;
            predicate: ?*Expr = bounds_type_invariant_at(invariant.predicate, invariant.value,
                value);
            if (predicate == null) error("internal: unsupported type invariant");
            bounds_require_type_predicate(predicate, f, value.file, value.pos)
        }
        _ -> { }
    }
}

bounds_require_type_predicate(
    e: *Expr,
    f: ?*BoundsState,
    file: int,
    pos: int
) raises Error, IndexOutOfBounds {
    match e.kind {
        LogAnd k -> {
            bounds_require_type_predicate(k.lhs, f, file, pos);
            bounds_require_type_predicate(k.rhs, f, file, pos)
        }
        Binary k -> {
            if (k.op == BinOp.Ne) {
                if (is_null_expr(k.rhs)) {
                    bounds_require_nonnull(k.lhs, f, file, pos);
                    return
                }
                if (is_null_expr(k.lhs)) {
                    bounds_require_nonnull(k.rhs, f, file, pos);
                    return
                }
            }
            if (bounds_pure_condition(e) && bounds_precondition_proved(e, f)) return;
            if (bounds_infer_mode) {
                bounds_infer_precondition(e, f);
                return
            }
            error_at_file(file, pos, "type invariant is not proved")
        }
        _ -> error("internal: unsupported type invariant")
    }
}

bounds_infer_nonnegative_requirement(a: *Expr@new, i: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    fn: ?*Function = bounds_current_fn;
    if (fn == null || bounds_nonnegative_term(f, i)) return false;
    match i.kind {
        Var _ -> { }
        _ -> return false
    }
    if (!bounds_difference_proves(f, i, bounds_length(a), -1)) return false;
    bounds_add_nonnegative_requirement(fn, i)
}

bounds_separation_contains(list: ?*BoundsSeparation, first: int, second: int): bool {
    q: ?*BoundsSeparation = list;
    while (q != null) {
        if (q.first == first && q.second == second || q.first == second && q.second == first) return true;
        q = q.next
    }
    false
}

bounds_separation_same(a: ?*BoundsSeparation, b: ?*BoundsSeparation): bool {
    q: ?*BoundsSeparation = a;
    while (q != null) {
        if (!bounds_separation_contains(b, q.first, q.second)) return false;
        q = q.next
    }
    q2: ?*BoundsSeparation = b;
    while (q2 != null) {
        if (!bounds_separation_contains(a, q2.first, q2.second)) return false;
        q2 = q2.next
    }
    true
}

bounds_add_separation(fn: *Function@new, first: int, second: int): bool {
    if (first == second || bounds_separation_contains(fn.bounds_separations, first,
        second)) return false;
    fn.bounds_separations = new BoundsSeparation { first: first, second: second, next: fn.bounds_separations };
    bounds_infer_changed = true;
    bounds_input_changed = true;
    true
}

bounds_separation_in_facts(f: ?*BoundsState, first: int, second: int): bool {
    q_position: int = bounds_count(f) - 1;
    q: ?*BoundsRow = bounds_row(f, q_position);
    while (q != null) {
        other: ?*Obj = q.array;
        if (q.kind == BoundsKind.Separate && other != null) {
            if (q.index.browse_id == first && other.browse_id == second || q.index.browse_id == second && other.browse_id == first) return true
        }
        q_position = q_position - 1;
        q = bounds_row(f, q_position)
    }
    false
}

bounds_separations_available(list: ?*BoundsSeparation, f: ?*BoundsState): bool {
    if (bounds_infer_mode) return true;
    fn: ?*Function = bounds_current_fn;
    q: ?*BoundsSeparation = list;
    while (q != null) {
        if (!bounds_separation_in_facts(f, q.first, q.second)) {
            if (fn == null) return false;
            if (!bounds_separation_contains(fn.bounds_separations, q.first, q.second)) return false
        }
        q = q.next
    }
    true
}

bounds_note_separations(list: ?*BoundsSeparation, f: ?*BoundsState) {
    fn: ?*Function = bounds_current_fn;
    if (fn == null || !bounds_infer_mode) return;
    q: ?*BoundsSeparation = list;
    while (q != null) {
        if (!bounds_separation_in_facts(f, q.first, q.second)) bounds_add_separation(fn,
            q.first, q.second);
        q = q.next
    }
}

// Infer requirements rooted at a parameter path. An offset index can be
// passed to callers as two integer inequalities, provided its base is also
// a parameter path.
bounds_requirement_root(
    fn: *Function,
    a: *Expr,
    i: *Expr@new,
    allow_end: bool
) raises IndexOutOfBounds: bool {
    root: ?*Obj = null;
    match a.kind {
        Var _ -> root = bounds_term_root(a);
        MemberAccess _ -> root = bounds_term_root(a);
        _ -> return false
    }
    if (root == null || !bounds_param(fn, root)) return false;
    if (bounds_num(i) >= 0 && bounds_num(i) < 536870912) return true;
    offset: ?*BoundsAffine = bounds_affine(i, true);
    if (offset != null) {
        if (allow_end && (offset.offset < 0 || offset.offset > 1)) return false;
        match i.kind {
            Binary _ -> {
                base: *Expr = offset.base;
                match base.kind {
                    Var k -> {
                        v: ?*Obj = k.var;
                        return v != null && bounds_param(fn, v)
                    }
                    MemberAccess k -> {
                        other: ?*Obj = bounds_term_root(base);
                        return other == root && k.member != null
                    }
                    _ -> return false
                }
            }
            _ -> { }
        }
    }
    match i.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return false;
            allow_end && bounds_param(fn, v)
        }
        MemberAccess k -> {
            other: ?*Obj = bounds_term_root(i);
            if (other == root && k.member != null) return true;
            false
        }
        _ -> false
    }
}

bounds_same_requirement_index(a: *Expr@new, b: *Expr@new) raises IndexOutOfBounds: bool {
    x: ?*BoundsAffine = bounds_affine(a, true);
    y: ?*BoundsAffine = bounds_affine(b, true);
    if (x == null || y == null) return false;
    x.offset == y.offset && bounds_same_term(x.base, y.base)
}

bounds_add_requirement(
    fn: *Function@new,
    a: *Expr@new,
    i: *Expr@new,
    allow_end: bool
) raises IndexOutOfBounds: bool {
    if (!bounds_requirement_root(fn, a, i, allow_end)) return false;
    // For a fixed nonnegative index, the largest requirement subsumes the
    // smaller ones. For a cursor offset, keep only the smallest and largest:
    // together they establish both sides of every intermediate access.
    if (!allow_end) {
        number: int = bounds_num(i);
        next_affine: ?*BoundsAffine = bounds_affine(i, true);
        lowest: ?*BoundsRequirement = null;
        highest: ?*BoundsRequirement = null;
        low_offset: int = 536870912;
        high_offset: int = -1;
        scan: ?*BoundsRequirement = fn.bounds_requirements;
        while (scan != null) {
            if (!scan.allow_end && bounds_same_array_expr(scan.array, a)) {
                old_number: int = bounds_num(scan.index);
                if (number >= 0 && old_number >= 0) {
                    if (old_number >= number) return false;
                    scan.index = i;
                    bounds_infer_changed = true;
                    bounds_input_changed = true;
                    return true
                }
                old_affine: ?*BoundsAffine = bounds_affine(scan.index, true);
                if (number < 0 && next_affine != null && old_affine != null) {
                    if (next_affine.offset >= 0 && old_affine.offset >= 0 && bounds_same_term(next_affine.base,
                        old_affine.base)) {
                        if (old_affine.offset < low_offset) {
                            low_offset = old_affine.offset;
                            lowest = scan
                        }
                        if (old_affine.offset > high_offset) {
                            high_offset = old_affine.offset;
                            highest = scan
                        }
                    }
                }
            }
            scan = scan.next
        }
        if (lowest != null && highest != null && next_affine != null) {
            if (next_affine.offset >= low_offset && next_affine.offset <= high_offset) return false;
            if (lowest != highest) {
                if (next_affine.offset < low_offset) lowest.index = i else highest.index = i;
                bounds_infer_changed = true;
                bounds_input_changed = true;
                return true
            }
        }
    }
    q: ?*BoundsRequirement = fn.bounds_requirements;
    while (q != null) {
        if (q.allow_end == allow_end && bounds_same_array_expr(q.array, a) && bounds_same_requirement_index(q.index,
            i)) return false;
        q = q.next
    }
    fn.bounds_requirements = new BoundsRequirement {
        array: a,
        index: i,
        allow_end: allow_end,
        next: fn.bounds_requirements
    };
    bounds_infer_changed = true;
    bounds_input_changed = true;
    true
}

bounds_len_term(a: *Expr@new): *Expr@new {
    // An actual argument may still link to the following call arguments.
    // A synthesized len expression must own a single-argument list.
    arg: *Expr = mk_expr(a.kind);
    arg.ty = a.ty;
    mk_expr(ExprKind.Funcall {
        funcname: "len",
        args: arg,
        fn: null,
        target: null
    })
}

bounds_requirement_facts(f: ?*BoundsState@new, r: *BoundsRequirement@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    match r.index.kind {
        Binary _ -> {
            index: ?*BoundsAffine = bounds_affine(r.index, true);
            if (index == null) return f;
            base: *Expr = index.base;
            length: *Expr = bounds_len_term(r.array);
            root: ?*Obj = bounds_term_root(base);
            if (root == null) root = bounds_term_root(length);
            if (root == null) return f;
            f = bounds_insert(f, root, bounds_term_root(length), BoundsKind.Difference,
                0 - index.offset - (if (r.allow_end) 0 else 1), base, length, null);
            bounds_insert(f, root, root, BoundsKind.Difference, index.offset, new_num(0),
                base, null)
        }
        _ -> {
            if (!r.allow_end && bounds_num(r.index) < 0) f = bounds_add_order(f, new_num(0),
                r.index, false);
            bounds_add_order(f, r.index, bounds_len_term(r.array), !r.allow_end)
        }
    }
}

bounds_clone_path(e: *Expr@new) raises IndexOutOfBounds: ?*Expr@new {
    match e.kind {
        Num k -> {
            copied: *Expr = new_num(k.val);
            copied.kind = e.kind;
            copied.ty = e.ty;
            copied
        }
        Var k -> {
            copied: *Expr = mk_expr(ExprKind.Var { var: k.var, name: k.name, member: k.member });
            copied.ty = e.ty;
            copied
        }
        MemberAccess k -> {
            lhs: ?*Expr = bounds_clone_path(k.lhs);
            if (lhs == null) return null;
            copied: *Expr = mk_expr(ExprKind.MemberAccess { lhs: lhs, name: k.name, member: k.member });
            copied.ty = e.ty;
            copied
        }
        Index k -> {
            lhs: ?*Expr = bounds_clone_path(k.lhs);
            idx: ?*Expr = bounds_clone_path(k.idx);
            if (lhs == null || idx == null) return null;
            copied: *Expr = mk_expr(ExprKind.Index { lhs: lhs, idx: idx });
            copied.ty = e.ty;
            copied
        }
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return null;
            arg: ?*Expr = k.args;
            if (arg == null || arg.next != null) return null;
            copied: ?*Expr = bounds_clone_path(arg);
            if (copied == null) return null;
            bounds_len_term(copied)
        }
        Binary k -> {
            if (k.op != BinOp.Add && k.op != BinOp.Sub) return null;
            c: int = bounds_num(k.rhs);
            if (c < 0 || c >= 536870912) return null;
            lhs: ?*Expr = bounds_clone_path(k.lhs);
            if (lhs == null) return null;
            match lhs.kind {
                Num number -> return new_num(if (k.op == BinOp.Add) number.val + c else number.val - c);
                _ -> { }
            }
            null
        }
        _ -> null
    }
}

bounds_clone_argument(e: *Expr@new) raises IndexOutOfBounds: ?*Expr@new {
    affine: ?*BoundsAffine = bounds_affine(e, true);
    if (affine == null) {
        match e.kind {
            Binary k -> {
                if (k.op != BinOp.Add && k.op != BinOp.Sub && k.op != BinOp.Mul) return null;
                lhs: ?*Expr = bounds_clone_argument(k.lhs);
                rhs: ?*Expr = bounds_clone_argument(k.rhs);
                if (lhs == null || rhs == null) return null;
                copied: *Expr = new_binary(k.op, lhs, rhs);
                copied.ty = e.ty;
                return copied
            }
            _ -> return bounds_clone_path(e)
        }
    }
    base: ?*Expr = bounds_clone_path(affine.base);
    if (base == null) return null;
    if (affine.offset == 0) return base;
    if (affine.offset > 0) return new_binary(BinOp.Add, base, new_num(affine.offset));
    new_binary(BinOp.Sub, base, new_num(0 - affine.offset))
}

bounds_rebind_term(e: *Expr@new, callee: *Function, args: ?*Expr@new) raises IndexOutOfBounds: ?*Expr@new {
    match e.kind {
        Num _ -> bounds_clone_path(e);
        Null -> new_null_expr();
        VariantLit k -> {
            if (k.inits != null) return null;
            copied: *Expr = mk_expr(e.kind);
            copied.ty = e.ty;
            copied
        }
        Binary k -> {
            if (k.op != BinOp.Add && k.op != BinOp.Sub) return null;
            if (k.op == BinOp.Sub) {
                rhs: ?*Expr = bounds_rebind_term(k.rhs, callee, args);
                lhs: ?*Expr = bounds_rebind_term(k.lhs, callee, args);
                if (lhs == null || rhs == null) return null;
                mapped_span: *Expr = new_binary(BinOp.Sub, lhs, rhs);
                mapped_span.ty = e.ty;
                return mapped_span
            }
            c: int = bounds_num(k.rhs);
            if (c < 0 || c >= 536870912) return null;
            lhs: ?*Expr = bounds_rebind_term(k.lhs, callee, args);
            if (lhs == null) return null;
            match lhs.kind {
                Num number -> {
                    if (number.form == LIT_INT && number.val >= 0 && number.val < 536870912) return new_num(if (k.op == BinOp.Add) number.val + c else number.val - c)
                }
                _ -> { }
            }
            mapped: *Expr = new_binary(k.op, lhs, new_num(c));
            mapped.ty = e.ty;
            mapped
        }
        Var k -> {
            v: ?*Obj = k.var;
            if (v != null && v.is_const && v.const_state == 2 && is_int_ty(v.ty)) return new_num(v.const_val);
            if (v == null || !bounds_param(callee, v)) return null;
            actual: ?*Expr = bounds_arg_named(callee, args, v.name);
            if (actual == null || !bounds_pure_condition(actual)) return null;
            bounds_clone_argument(actual)
        }
        MemberAccess k -> {
            copied: ?*Expr = bounds_rebind_term(k.lhs, callee, args);
            if (copied == null) return null;
            mapped: *Expr = mk_expr(ExprKind.MemberAccess { lhs: copied, name: k.name, member: k.member });
            mapped.ty = e.ty;
            mapped
        }
        Index k -> {
            copied: ?*Expr = bounds_rebind_term(k.lhs, callee, args);
            position: ?*Expr = bounds_rebind_term(k.idx, callee, args);
            if (copied == null || position == null) return null;
            mapped: *Expr = mk_expr(ExprKind.Index { lhs: copied, idx: position });
            mapped.ty = e.ty;
            mapped
        }
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return null;
            a: ?*Expr = k.args;
            if (a == null) return null;
            if (a.next != null) return null;
            mapped: ?*Expr = bounds_rebind_term(a, callee, args);
            if (mapped == null) return null;
            bounds_len_term(mapped)
        }
        _ -> null
    }
}

bounds_precondition_path(e: *Expr, fn: *Function): bool {
    match e.kind {
        Var k -> {
            v: ?*Obj = k.var;
            v != null && bounds_param(fn, v)
        }
        MemberAccess k -> bounds_precondition_path(k.lhs, fn);
        Index k -> {
            match k.idx.kind {
                Num _ -> bounds_precondition_path(k.lhs, fn);
                _ -> bounds_precondition_path(k.lhs, fn) && bounds_precondition_path(k.idx,
                    fn)
            }
        }
        _ -> false
    }
}

bounds_precondition_term(e: *Expr, fn: *Function) raises IndexOutOfBounds: bool {
    if (!is_int_ty(e.ty)) return false;
    match e.kind {
        Num _ -> bounds_num(e) >= 0;
        Binary k -> {
            if (k.op != BinOp.Add && k.op != BinOp.Sub) return false;
            if (k.op == BinOp.Sub && bounds_precondition_term(k.rhs, fn)) return bounds_precondition_term(k.lhs,
                fn);
            c: int = bounds_num(k.rhs);
            c >= 0 && c < 536870912 && bounds_precondition_term(k.lhs, fn)
        }
        Var k -> {
            v: ?*Obj = k.var;
            if (v != null && v.is_const && v.const_state == 2) return v.const_val >= 0;
            bounds_precondition_path(e, fn)
        }
        MemberAccess _ -> bounds_precondition_path(e, fn);
        Index _ -> bounds_precondition_path(e, fn);
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            if (a.next != null) return false;
            bounds_precondition_path(a, fn)
        }
        _ -> false
    }
}

bounds_precondition_scalar_term(e: *Expr, fn: *Function) raises IndexOutOfBounds: bool {
    if (!bounds_scalar_term(e)) return false;
    match e.kind {
        Null -> true;
        VariantLit k -> k.inits == null;
        Num _ -> true;
        Var k -> {
            v: ?*Obj = k.var;
            v != null && (bounds_param(fn, v) || v.is_const && v.const_state == 2)
        }
        MemberAccess _ -> bounds_precondition_path(e, fn);
        Index _ -> bounds_precondition_path(e, fn);
        _ -> false
    }
}

// An indexed contract fact is meaningful only on paths where its element
// exists. Check that obligation using the same bounds prover as ordinary code.
bounds_contract_indices_proved(e: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    match e.kind {
        Index k -> bounds_contract_indices_proved(k.lhs, f) && bounds_contract_indices_proved(k.idx,
            f) && bounds_proves(k.lhs, k.idx, f);
        Binary k -> bounds_contract_indices_proved(k.lhs, f) && bounds_contract_indices_proved(k.rhs,
            f);
        LogAnd k -> bounds_contract_indices_proved(k.lhs, f) && bounds_contract_indices_proved(k.rhs,
            f);
        MemberAccess k -> bounds_contract_indices_proved(k.lhs, f);
        Funcall k -> {
            a: ?*Expr = k.args;
            a == null || bounds_contract_indices_proved(a, f)
        }
        _ -> true
    }
}

bounds_precondition_valid(e: *Expr, fn: *Function) raises IndexOutOfBounds: bool {
    bounds_contract_valid(e, fn, false)
}

bounds_rebind_precondition(e: *Expr@new, fn: *Function, args: ?*Expr@new) raises IndexOutOfBounds: ?*Expr@new {
    match e.kind {
        LogAnd k -> {
            lhs: ?*Expr = bounds_rebind_precondition(k.lhs, fn, args);
            rhs: ?*Expr = bounds_rebind_precondition(k.rhs, fn, args);
            if (lhs == null || rhs == null) return null;
            mapped: *Expr = mk_expr(ExprKind.LogAnd { lhs: lhs, rhs: rhs });
            mapped.ty = e.ty;
            mapped
        }
        Binary k -> {
            lhs: ?*Expr = bounds_rebind_term(k.lhs, fn, args);
            rhs: ?*Expr = bounds_rebind_term(k.rhs, fn, args);
            if (lhs == null || rhs == null) return null;
            mapped: *Expr = new_binary(k.op, lhs, rhs);
            mapped.ty = e.ty;
            mapped
        }
        _ -> null
    }
}

bounds_precondition_upper(
    f: ?*BoundsState,
    value: *Expr,
    limit: *Expr,
    strict: bool
) raises Error, IndexOutOfBounds: bool {
    upper: int = bounds_small_upper(value, f);
    upper >= 0 && bounds_difference_proves(f, new_num(upper), limit, if (strict) -1 else 0)
}

// If both pieces of a span have safe numeric maxima, their sum can be
// compared with the destination length without forming a machine sum.
bounds_span_upper_proves(f: ?*BoundsState, count: *Expr, remaining: *Expr) raises Error, IndexOutOfBounds: bool {
    match remaining.kind {
        Binary subtraction -> {
            if (subtraction.op != BinOp.Sub) return false;
            offset_upper: int = bounds_small_upper(subtraction.rhs, f);
            count_upper: int = bounds_small_upper(count, f);
            if (offset_upper < 0 || count_upper < 0 || offset_upper > 536870911 - count_upper) return false;
            bounds_difference_proves(f, new_num(offset_upper + count_upper), subtraction.lhs,
                0)
        }
        _ -> false
    }
}

bounds_contract_constant(e: *Expr): int {
    match e.kind {
        Num k -> {
            if (k.form == LIT_INT && k.str_label == 0 && k.val > -536870912 && k.val < 536870912) return k.val;
            -999999999
        }
        Var k -> {
            v: ?*Obj = k.var;
            if (v != null && v.is_const && v.const_state == 2 && is_int_ty(v.ty) && v.const_val > -536870912 && v.const_val < 536870912) return v.const_val;
            -999999999
        }
        Neg k -> {
            value: int = bounds_contract_constant(k.lhs);
            if (value != -999999999) return 0 - value;
            -999999999
        }
        Binary k -> {
            left: int = bounds_contract_constant(k.lhs);
            right: int = bounds_contract_constant(k.rhs);
            if (left == -999999999 || right == -999999999) return -999999999;
            result: int = -999999999;
            if (k.op == BinOp.Add) result = left + right;
            if (k.op == BinOp.Sub) result = left - right;
            if (result > -536870912 && result < 536870912) return result;
            -999999999
        }
        _ -> -999999999
    }
}

// Compose nonnegative interval bounds for sums and fixed-size table strides.
// Keep every intermediate below the solver's conservative numeric limit.
bounds_arithmetic_upper(e: *Expr, f: ?*BoundsState) raises IndexOutOfBounds: int {
    match e.kind {
        Binary k -> {
            if (k.op == BinOp.Add || k.op == BinOp.Mul) {
                left: int = bounds_arithmetic_upper(k.lhs, f);
                right: int = bounds_arithmetic_upper(k.rhs, f);
                if (left < 0 || right < 0) return -1;
                if (k.op == BinOp.Add && left <= 536870911 - right) return left + right;
                if (k.op == BinOp.Mul && (right == 0 || left <= 536870911 / right)) return left * right
            }
        }
        _ -> { }
    }
    bounds_term_numeric_upper(f, e)
}

bounds_precondition_proved(e: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    match e.kind {
        LogAnd k -> bounds_precondition_proved(k.lhs, f) && bounds_precondition_proved(k.rhs,
            f);
        Binary k -> {
            left_constant: int = bounds_contract_constant(k.lhs);
            right_constant: int = bounds_contract_constant(k.rhs);
            if (left_constant != -999999999 && right_constant != -999999999) {
                if (k.op == BinOp.Lt) return left_constant < right_constant;
                if (k.op == BinOp.Le) return left_constant <= right_constant;
                if (k.op == BinOp.Gt) return left_constant > right_constant;
                if (k.op == BinOp.Ge) return left_constant >= right_constant;
                if (k.op == BinOp.Eq) return left_constant == right_constant;
                if (k.op == BinOp.Ne) return left_constant != right_constant
            }
            if (k.op == BinOp.Lt) {
                upper: int = bounds_arithmetic_upper(k.lhs, f);
                right_number: int = bounds_num(k.rhs);
                if (upper >= 0 && right_number > upper) return true
            }
            if (k.op == BinOp.Lt) return bounds_difference_proves(f, k.lhs, k.rhs,
                -1) || bounds_bounded_sum_le(f, k.lhs, k.rhs, false) || bounds_remaining_span_le(f,
                k.lhs, k.rhs, false) || bounds_precondition_upper(f, k.lhs, k.rhs,
                true);
            if (k.op == BinOp.Le) return bounds_difference_proves(f, k.lhs, k.rhs,
                0) || bounds_num(k.lhs) == 0 && (bounds_nonnegative_term(f, k.rhs) || bounds_small_upper(k.rhs,
                f) >= 0 || bounds_bounded_offset_nonnegative(f, k.rhs)) || bounds_affine_le_proves(f,
                k.lhs, k.rhs) || bounds_bounded_offset_le(f, k.lhs, k.rhs) || bounds_bounded_sum_le(f,
                k.lhs, k.rhs, true) || bounds_remaining_span_le(f, k.lhs, k.rhs, true) || bounds_span_upper_proves(f,
                k.lhs, k.rhs) || bounds_precondition_upper(f, k.lhs, k.rhs, false);
            if (k.op == BinOp.Gt) return bounds_difference_proves(f, k.rhs, k.lhs,
                -1) || bounds_bounded_sum_le(f, k.rhs, k.lhs, false) || bounds_precondition_upper(f,
                k.rhs, k.lhs, true);
            if (k.op == BinOp.Ge) return bounds_difference_proves(f, k.rhs, k.lhs,
                0) || bounds_num(k.rhs) == 0 && (bounds_nonnegative_term(f, k.lhs) || bounds_small_upper(k.lhs,
                f) >= 0) || bounds_bounded_sum_le(f, k.rhs, k.lhs, true);
            if (k.op == BinOp.Eq) return bounds_scalar_proves(f, k.lhs, k.rhs, BoundsKind.Equal) || bounds_difference_proves(f,
                k.lhs, k.rhs, 0) && bounds_difference_proves(f, k.rhs, k.lhs, 0) || bounds_affine_le_proves(f,
                k.lhs, k.rhs) && bounds_affine_le_proves(f, k.rhs, k.lhs);
            if (k.op == BinOp.Ne) return bounds_scalar_proves(f, k.lhs, k.rhs, BoundsKind.NotEqual);
            false
        }
        _ -> false
    }
}

bounds_projected_upper(value: *Expr@new, f: ?*BoundsState) raises Error, IndexOutOfBounds: int {
    direct: int = bounds_term_numeric_upper(f, value);
    if (direct >= 0) return direct;
    best: int = -1;
    for position in 0..bounds_count(f) {
        row: ?*BoundsRow = bounds_row(f, position);
        if (row != null) {
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            candidate: int = bounds_num(left);
            if (candidate >= 0 && candidate < 536870912 && (best < 0 || candidate < best) && bounds_precondition_proved(new_binary(BinOp.Le,
                value, new_num(candidate)), f)) best = candidate;
            candidate = bounds_num(right);
            if (candidate >= 0 && candidate < 536870912 && (best < 0 || candidate < best) && bounds_precondition_proved(new_binary(BinOp.Le,
                value, new_num(candidate)), f)) best = candidate;
            candidate = row.value;
            if (row.kind == BoundsKind.Difference && candidate >= 0 && candidate < 536870912 && (best < 0 || candidate < best) && bounds_precondition_proved(new_binary(BinOp.Le,
                value, new_num(candidate)), f)) best = candidate
        }
    }
    best
}

bounds_add_upper_requirement(fn: *Function@new, term: *Expr, max: int): bool {
    param: ?*Obj = bounds_var(term);
    if (param == null || !bounds_param(fn, param) || param.bounds_written || max < 0 || max >= 536870912) return false;
    old: ?*BoundsUpperRequirement = fn.bounds_upper_requirements;
    found: bool = false;
    while (old != null && !found) {
        if (old.param == param) {
            if (old.max <= max) return true;
            old.max = max;
            found = true
        }
        old = old.next
    }
    if (!found) fn.bounds_upper_requirements = new BoundsUpperRequirement { param: param, max: max, next: fn.bounds_upper_requirements };
    clause: *Expr = new_binary(BinOp.Le, bounds_obj_expr(param), new_num(max));
    existing: ?*Expr = fn.bounds_precondition;
    if (existing != null) clause = new_logand(existing, clause);
    fn.bounds_precondition = clause;
    bounds_infer_changed = true;
    bounds_input_changed = true;
    true
}

bounds_infer_precondition(e: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds {
    match e.kind {
        LogAnd k -> {
            bounds_infer_precondition(k.lhs, f);
            bounds_infer_precondition(k.rhs, f)
        }
        Binary k -> {
            if (k.op == BinOp.Le && bounds_num(k.rhs) >= 0 && !bounds_precondition_proved(e,
                f)) {
                caller_upper: ?*Function = bounds_current_fn;
                if (caller_upper != null) _added_upper: bool = bounds_add_upper_requirement(caller_upper,
                    k.lhs, bounds_num(k.rhs))
            }
            if (k.op == BinOp.Ge) {
                match k.lhs.kind {
                    Funcall length_call -> {
                        if (streq(length_call.funcname, "len") && length_call.target == null) {
                            array: ?*Expr = length_call.args;
                            caller: ?*Function = bounds_current_fn;
                            lower: int = bounds_num(k.rhs);
                            if (array != null && caller != null && lower >= 0 && lower < 536870912) _added_length: bool = bounds_add_requirement(caller,
                                array, new_num(lower), true)
                        }
                    }
                    _ -> { }
                }
            }
            if (k.op == BinOp.Ge && bounds_num(k.rhs) == 0 && !bounds_nonnegative_term(f,
                k.lhs)) {
                caller0: ?*Function = bounds_current_fn;
                if (caller0 != null) _added0: bool = bounds_add_nonnegative_requirement(caller0,
                    k.lhs)
            }
            if (k.op == BinOp.Le && bounds_num(k.lhs) == 0 && !bounds_nonnegative_term(f,
                k.rhs)) {
                caller: ?*Function = bounds_current_fn;
                if (caller != null) _added: bool = bounds_add_nonnegative_requirement(caller,
                    k.rhs)
            }
            if (k.op == BinOp.Le && !bounds_difference_proves(f, k.lhs, k.rhs, 0)) {
                match k.rhs.kind {
                    Funcall length_call -> {
                        if (streq(length_call.funcname, "len") && length_call.target == null) {
                            array: ?*Expr = length_call.args;
                            caller2: ?*Function = bounds_current_fn;
                            if (array != null && caller2 != null) {
                                number: int = bounds_num(k.lhs);
                                if (number > 0) _added2: bool = bounds_add_requirement(caller2,
                                    array, new_num(number - 1), false) else _added3: bool = bounds_add_requirement(caller2,
                                    array, k.lhs, true)
                            }
                        }
                    }
                    Binary remaining -> {
                        if (remaining.op == BinOp.Sub) {
                            match remaining.lhs.kind {
                                Funcall length_call -> {
                                    if (streq(length_call.funcname, "len") && length_call.target == null) {
                                        array_expr: ?*Expr = length_call.args;
                                        caller: ?*Function = bounds_current_fn;
                                        array: ?*Obj = bounds_var(array_expr);
                                        count: ?*Obj = bounds_var(k.lhs);
                                        if (array != null && caller != null) {
                                            inferred: bool = false;
                                            if (count != null) inferred = bounds_add_span_requirement(caller,
                                                array, remaining.rhs, count);
                                            if (!inferred && bounds_num(remaining.rhs) == 0) {
                                                upper: int = bounds_projected_upper(k.lhs,
                                                    f);
                                                if (upper >= 0) _added_upper: bool = bounds_add_requirement(caller,
                                                    bounds_obj_expr(array), new_num(upper),
                                                    true)
                                            }
                                        }
                                    }
                                }
                                _ -> { }
                            }
                        }
                    }
                    _ -> { }
                }
            }
        }
        _ -> { }
    }
}

bounds_infer_requirement(a: *Expr, i: *Expr) {
    fn: ?*Function = bounds_current_fn;
    if (fn == null) return;
    av: ?*Obj = bounds_var(a);
    iv: ?*Obj = bounds_var(i);
    if (av == null || iv == null) return;
    if (!bounds_param(fn, av) || !bounds_param(fn, iv)) return;
    if (len(iv.index_for_name) != 0) return;
    iv.index_for_name = av.name;
    bounds_infer_changed = true;
    bounds_input_changed = true
}

// Cursor provenance records an exact offset from the value at
// function entry (array == the parameter), or from zero (array == null).
bounds_cursor_origin(f: ?*BoundsState, value: *Obj): ?*BoundsRow@f {
    q_position: int = bounds_count(f) - 1;
    q: ?*BoundsRow = bounds_row(f, q_position);
    while (q != null) {
        if (q.kind == BoundsKind.Cursor && q.index == value) return q;
        q_position = q_position - 1;
        q = bounds_row(f, q_position)
    }
    null
}

// Translate a failed requirement on the current cursor back to an entry
// requirement. The caller can then prove the entire sequence's capacity.
bounds_infer_cursor_requirement(a: *Expr@new, i: *Expr@new, f: ?*BoundsState@new) raises IndexOutOfBounds: bool {
    fn: ?*Function = bounds_current_fn;
    if (fn == null) return false;
    affine: ?*BoundsAffine = bounds_affine(i, true);
    if (affine == null) return false;
    v: ?*Obj = bounds_var(affine.base);
    if (v == null) return false;
    origin: ?*BoundsRow = bounds_cursor_origin(f, v);
    if (origin == null) return false;
    total: int = origin.value + affine.offset;
    if (total < 0 || total >= 536870912) return false;
    source: ?*Obj = origin.array;
    if (source == null) {
        if (!bounds_requirement_root(fn, a, new_num(total), false)) return false;
        _added: bool = bounds_add_requirement(fn, a, new_num(total), false);
        return true
    }
    if (!bounds_param(fn, source)) return false;
    if (source == v && origin.value == 0) return false;
    entry: *Expr = new_binary(BinOp.Add, bounds_obj_expr(source), new_num(total));
    if (!bounds_requirement_root(fn, a, entry, false)) return false;
    _added2: bool = bounds_add_requirement(fn, a, entry, false);
    true
}

bounds_infer_loop_requirement(a: *Expr@new, i: *Expr, f: ?*BoundsState@new) raises IndexOutOfBounds {
    item: ?*Obj = bounds_var(i);
    fn: ?*Function = bounds_current_fn;
    if (item == null || fn == null) return;
    position: int = bounds_count(f) - 1;
    while (position >= 0) {
        row: ?*BoundsRow = bounds_row(f, position);
        if (row != null) {
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            if (row.kind == BoundsKind.Difference && left != null && right != null && bounds_var(left) == item && row.separation == null) {
                if (row.value == -1 && bounds_add_requirement(fn, a, right, true)) return;
                if (bounds_num(right) == 0 && row.value >= 0 && row.value < 536870911) {
                    if (bounds_add_requirement(fn, a, new_num(row.value + 1), true)) return
                }
            }
        }
        position = position - 1
    }
}

// Publish a span condition once for each stable parameter triple.
bounds_add_span_requirement(
    fn: *Function@new,
    array: *Obj@new,
    offset_expr: *Expr@new,
    count: *Obj@new
) raises IndexOutOfBounds: bool {
    if (!bounds_param(fn, array) || !bounds_param(fn, count) || array.bounds_written || count.bounds_written) return false;
    offset: ?*Obj = null;
    number: int = -1;
    match offset_expr.kind {
        Var _ -> {
            offset = bounds_var(offset_expr);
            if (offset == null || !bounds_param(fn, offset) || offset.bounds_written) return false
        }
        Num _ -> {
            number = bounds_num(offset_expr);
            if (number < 0 || number >= 536870912) return false
        }
        _ -> return false
    }
    old: ?*BoundsSpanRequirement = fn.bounds_span_requirements;
    while (old != null) {
        if (old.array == array && old.offset == offset && old.offset_number == number && old.count == count) return true;
        old = old.next
    }
    fn.bounds_span_requirements = new BoundsSpanRequirement {
        array: array,
        offset: offset,
        offset_number: number,
        count: count,
        next: fn.bounds_span_requirements
    };
    lower_offset: *Expr = bounds_clone_path(offset_expr) or new_num(number);
    upper_offset: *Expr = bounds_clone_path(offset_expr) or new_num(number);
    room_offset: *Expr = bounds_clone_path(offset_expr) or new_num(number);
    lower: *Expr = new_binary(BinOp.Le, new_num(0), lower_offset);
    offset_end: *Expr = new_binary(BinOp.Le, upper_offset, bounds_len_term(bounds_obj_expr(array)));
    count_lower: *Expr = new_binary(BinOp.Le, new_num(0), bounds_obj_expr(count));
    room: *Expr = new_binary(BinOp.Sub, bounds_len_term(bounds_obj_expr(array)), room_offset);
    count_end: *Expr = new_binary(BinOp.Le, bounds_obj_expr(count), room);
    span: *Expr = new_logand(new_logand(lower, offset_end), new_logand(count_lower,
        count_end));
    existing: ?*Expr = fn.bounds_precondition;
    if (existing != null) span = new_logand(existing, span);
    fn.bounds_precondition = span;
    bounds_infer_changed = true;
    bounds_input_changed = true;
    true
}

// For a stable range item 0 <= item < count, an access at offset + item
// needs a caller-facing span contract rather than a contract mentioning item.
bounds_infer_span_requirement(a: *Expr, i: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    fn: ?*Function = bounds_current_fn;
    if (fn == null) return false;
    array: ?*Obj = bounds_var(a);
    if (array == null || !bounds_param(fn, array) || array.bounds_written) return false;
    offset: ?*Obj = null;
    item: ?*Obj = null;
    match i.kind {
        Binary sum -> {
            if (sum.op != BinOp.Add) return false;
            first: ?*Obj = bounds_var(sum.lhs);
            second: ?*Obj = bounds_var(sum.rhs);
            if (first != null && second != null && bounds_param(fn, first) && !bounds_param(fn,
                second)) {
                offset = first;
                item = second
            } else if (first != null && second != null && bounds_param(fn, second) && !bounds_param(fn,
                first)) {
                offset = second;
                item = first
            }
        }
        _ -> return false
    }
    if (offset == null || item == null || offset.bounds_written || item.bounds_addr_taken) return false;
    if (!bounds_nonnegative_term(f, bounds_obj_expr(item))) return false;
    position: int = bounds_count(f) - 1;
    while (position >= 0) {
        row: ?*BoundsRow = bounds_row(f, position);
        if (row != null && row.kind == BoundsKind.Difference && row.value == -1 && row.separation == null) {
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            if (left != null && right != null && bounds_var(left) == item) {
                count: ?*Obj = bounds_var(right);
                if (count != null && bounds_param(fn, count) && !count.bounds_written) return bounds_add_span_requirement(fn,
                    array, bounds_obj_expr(offset), count)
            }
        }
        position = position - 1
    }
    false
}

bounds_require(
    a: *Expr@new,
    i: *Expr@new,
    f: ?*BoundsState@new,
    file: int,
    pos: int
) raises Error, IndexOutOfBounds {
    if (bounds_proves(a, i, f)) return;
    if (bounds_infer_mode) {
        if (bounds_infer_nonnegative_requirement(a, i, f)) return;
        if (bounds_infer_cursor_requirement(a, i, f)) return;
        if (bounds_infer_span_requirement(a, i, f)) return;
        affine: ?*BoundsAffine = bounds_affine(i, true);
        if (affine != null) {
            current: ?*Obj = bounds_var(affine.base);
            fn0: ?*Function = bounds_current_fn;
            if (current != null && fn0 != null) {
                origin0: ?*BoundsRow = bounds_cursor_origin(f, current);
                entry_value: bool = false;
                if (origin0 != null) entry_value = origin0.array == current && origin0.value == 0;
                if (bounds_param(fn0, current) && current.bounds_written && !entry_value) return
            }
        }
        if (affine != null && affine.offset == -1 && bounds_difference_proves(f, new_num(1),
            affine.base, 0)) {
            fn1: ?*Function = bounds_current_fn;
            if (fn1 != null && bounds_requirement_root(fn1, a, affine.base, true)) {
                // The path to this access already proves base >= 1, so
                // base - 1 cannot wrap or go negative. Only base <= len(a)
                // remains for the caller to establish.
                _added_upper: bool = bounds_add_requirement(fn1, a, affine.base, true);
                return
            }
        }
        bounds_infer_requirement(a, i);
        fn: ?*Function = bounds_current_fn;
        if (fn != null) {
            // A bounded expression need not be expressible in a caller's
            // contract: its largest possible value is enough instead.
            upper: int = bounds_small_upper(i, f);
            if (upper >= 0 && bounds_pure_condition(i) && bounds_requirement_root(fn,
                a, new_num(upper), false)) {
                bounds_add_requirement(fn, a, new_num(upper), false);
                return
            }
            bounds_add_requirement(fn, a, i, false)
        }
        bounds_infer_loop_requirement(a, i, f);
        return
    }
    current: ?*Function = bounds_current_fn;
    entry: ?*Function = find_function("main");
    if (current != null && current == entry) {
        array_param: ?*Obj = bounds_var(a);
        index_param: ?*Obj = bounds_var(i);
        if (array_param != null && bounds_param(current, array_param)) {
            if (index_param != null && bounds_param(current, index_param)) error_at_file(file,
                pos, "main cannot require an index_for argument at entry");
            if (bounds_num(i) >= 0) error_at_file(file, pos, "main cannot require unproved array bounds at entry")
        }
    }
    error_at_file(file, pos, "array index not proved in bounds")
}

bounds_arg_named(fn: *Function, args: ?*Expr, name: []i8): ?*Expr@args {
    p: ?*Obj = fn.params;
    a: ?*Expr = args;
    while (p != null && a != null) {
        if (streq(p.name, name)) return a;
        p = p.param_next;
        a = a.next
    }
    null
}

bounds_separation_proved(a: *Expr, b: *Expr, f: ?*BoundsState) raises IndexOutOfBounds: bool {
    av: ?*Obj = bounds_var(a);
    bv: ?*Obj = bounds_var(b);
    if (av == null || bv == null || av == bv) return false;
    if (bounds_has(f, av, bv, BoundsKind.Separate) || bounds_has(f, bv, av, BoundsKind.Separate)) return true;
    ai: int = bounds_fact_value(f, av, BoundsKind.Fresh);
    bi: int = bounds_fact_value(f, bv, BoundsKind.Fresh);
    ai >= 0 && bi >= 0 && ai != bi
}

bounds_infer_caller_separation(a: *Expr, b: *Expr) {
    fn: ?*Function = bounds_current_fn;
    if (fn == null) return;
    av: ?*Obj = bounds_var(a);
    bv: ?*Obj = bounds_var(b);
    if (av == null || bv == null || av == bv) return;
    if (bounds_param(fn, av) && bounds_param(fn, bv)) bounds_add_separation(fn, av.browse_id,
        bv.browse_id)
}

bounds_check_call(
    fn: *Function@new,
    args: ?*Expr@new,
    f: ?*BoundsState@new,
    file: int,
    pos: int
) noregion raises Error, IndexOutOfBounds {
    required_pointer: ?*BoundsNonNullRequirement = fn.bounds_nonnull_requirements;
    while (required_pointer != null) {
        actual: ?*Expr = bounds_arg_named(fn, args, required_pointer.param.name);
        if (actual == null) error_at_file(file, pos, "non-null requirement refers to missing argument");
        bounds_require_nonnull(actual, f, file, pos);
        required_pointer = required_pointer.next
    }
    nonnegative: ?*BoundsNonnegativeRequirement = fn.bounds_nonnegative_requirements;
    while (nonnegative != null) {
        mapped_term: ?*Expr = bounds_arg_named(fn, args, nonnegative.param.name);
        if (mapped_term == null || !bounds_pure_condition(mapped_term)) error_at_file(file,
            pos, "nonnegative requirement needs a simple, side-effect-free argument");
        nonnegative_proved: bool = bounds_expression_nonnegative(mapped_term, f);
        if (!nonnegative_proved) {
            if (bounds_infer_mode) {
                caller: ?*Function = bounds_current_fn;
                if (caller != null) _added: bool = bounds_add_nonnegative_requirement(caller,
                    mapped_term)
            } else error_at_file(file, pos, "call does not prove inferred nonnegative requirement")
        }
        nonnegative = nonnegative.next
    }
    p: ?*Obj = fn.params;
    a: ?*Expr = args;
    while (p != null && a != null) {
        bounds_require_type_invariant(p.ty, a, f);
        if (len(p.index_for_name) != 0) {
            ar: ?*Expr = bounds_arg_named(fn, args, p.index_for_name);
            if (ar == null) error_at_file(file, pos, "index_for refers to unknown array parameter");
            if (!bounds_pure_condition(ar) || !bounds_pure_condition(a)) error_at_file(file,
                pos, "index_for array and index arguments must be free of side effects (bind them to variables first)");
            bounds_require(ar, a, f, file, pos)
        }
        p = p.param_next;
        a = a.next
    }
    sep: ?*BoundsSeparation = fn.bounds_separations;
    while (sep != null) {
        first_param: ?*Obj = bounds_param_id(fn, sep.first);
        second_param: ?*Obj = bounds_param_id(fn, sep.second);
        if (first_param == null || second_param == null) error_at_file(file, pos,
            "internal: separation requirement refers to missing parameter");
        first_arg: ?*Expr = bounds_arg_named(fn, args, first_param.name);
        second_arg: ?*Expr = bounds_arg_named(fn, args, second_param.name);
        if (first_arg == null || second_arg == null) error_at_file(file, pos, "internal: separation requirement refers to missing argument");
        if (!bounds_separation_proved(first_arg, second_arg, f)) {
            if (bounds_infer_mode) bounds_infer_caller_separation(first_arg, second_arg) else error_at_file(file,
                pos, "call requires distinct record arguments for bounds proof")
        }
        sep = sep.next
    }
    requirement: ?*BoundsRequirement = fn.bounds_requirements;
    while (requirement != null) {
        mapped_array: ?*Expr = bounds_rebind_term(requirement.array, fn, args);
        mapped_index: ?*Expr = bounds_rebind_term(requirement.index, fn, args);
        if (mapped_array == null || mapped_index == null) error_at_file(file, pos,
            "bounds requirement arguments must be simple, side-effect-free paths");
        match mapped_array.kind {
            MemberAccess field -> {
                sd: ?*StructDef = bounds_record_def(field.lhs.ty);
                if (sd != null && bounds_term(field.lhs) && bounds_nonnull(f, field.lhs)) f = bounds_record_invariant_facts(sd,
                    field.lhs, f)
            }
            _ -> { }
        }
        affine_call: bool = false;
        match mapped_index.kind {
            Binary _ -> affine_call = true;
            _ -> { }
        }
        proved: bool = false;
        if (requirement.allow_end) {
            if (bounds_num(mapped_index) == 0) proved = true;
            affine: ?*BoundsAffine = bounds_affine(mapped_index, true);
            if (affine != null) {
                if (affine.offset < 0 && !bounds_affine_safe(affine, f)) affine = null
            }
            if (!proved) {
                if (affine != null) proved = bounds_difference_proves(f, affine.base,
                    bounds_length(mapped_array), 0 - affine.offset) else proved = bounds_count_fits(mapped_array,
                    mapped_index, f)
            }
            if (!proved) proved = bounds_bounded_sum_index(f, mapped_array, mapped_index,
                true);
            if (!proved) proved = bounds_precondition_proved(new_binary(BinOp.Le,
                mapped_index, bounds_len_term(mapped_array)), f)
        } else if (affine_call) proved = bounds_difference_index(f, mapped_array,
            mapped_index) else proved = bounds_proves(mapped_array, mapped_index,
            f);
        if (!proved) {
            if (bounds_infer_mode) {
                caller: ?*Function = bounds_current_fn;
                translated: bool = false;
                if (!requirement.allow_end) translated = bounds_infer_cursor_requirement(mapped_array,
                    mapped_index, f);
                if (!translated && caller != null) {
                    base: ?*BoundsAffine = bounds_affine(mapped_index, true);
                    current: ?*Obj = null;
                    if (base != null) current = bounds_var(base.base);
                    skip: bool = false;
                    if (current != null) {
                        origin0: ?*BoundsRow = bounds_cursor_origin(f, current);
                        entry_value: bool = false;
                        if (origin0 != null) entry_value = origin0.array == current && origin0.value == 0;
                        skip = bounds_param(caller, current) && current.bounds_written && !entry_value
                    }
                    if (!skip) bounds_add_requirement(caller, mapped_array, mapped_index,
                        requirement.allow_end)
                }
            } else bounds_requirement_error(fn, mapped_array, mapped_index, requirement.allow_end,
                file, pos)
        }
        requirement = requirement.next
    }
    precondition: ?*Expr = fn.bounds_precondition;
    if (precondition != null) {
        mapped: ?*Expr = bounds_rebind_precondition(precondition, fn, args);
        if (mapped == null) error_at_file(file, pos, "function precondition requires stable argument paths");
        if (!bounds_infer_mode && !bounds_contract_indices_proved(mapped, f)) error_at_file(file,
            pos, "function precondition has an unproved array access");
        if (bounds_infer_mode) bounds_infer_precondition(mapped, f) else if (!bounds_precondition_proved(mapped,
            f)) error_at_file(file, pos, "call does not prove function precondition")
    }
}

bounds_initial(fn: *Function@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    bounds_initial_in(fn, null)
}

bounds_initial_in(fn: *Function@new, arena: ?*BoundsArena@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    f: ?*BoundsState = if (arena == null) null else bounds_arena_state(arena);
    required_pointer: ?*BoundsNonNullRequirement = fn.bounds_nonnull_requirements;
    while (required_pointer != null) {
        f = bounds_add_nonnull(f, bounds_obj_expr(required_pointer.param));
        required_pointer = required_pointer.next
    }
    nonnegative: ?*BoundsNonnegativeRequirement = fn.bounds_nonnegative_requirements;
    while (nonnegative != null) {
        f = bounds_add_order(f, new_num(0), bounds_obj_expr(nonnegative.param), false);
        nonnegative = nonnegative.next
    }
    requirement: ?*BoundsRequirement = fn.bounds_requirements;
    while (requirement != null) {
        f = bounds_requirement_facts(f, requirement);
        requirement = requirement.next
    }
    sep: ?*BoundsSeparation = fn.bounds_separations;
    while (sep != null) {
        first: ?*Obj = bounds_param_id(fn, sep.first);
        second: ?*Obj = bounds_param_id(fn, sep.second);
        if (first == null || second == null) error("internal: separation requirement refers to missing parameter");
        f = bounds_add(f, first, second, BoundsKind.Separate);
        sep = sep.next
    }
    p: ?*Obj = fn.params;
    while (p != null) {
        entry: ?*Obj = p.bounds_entry;
        if (entry != null) {
            // Keep the caller's value when the parameter is reassigned.
            path: *Expr = bounds_obj_expr(p);
            saved: *Expr = bounds_obj_expr(entry);
            f = bounds_add_scalar_relation(f, path, saved, BoundsKind.Equal);
            if (is_int_ty(p.ty)) {
                f = bounds_add_relation(f, path, saved, 0);
                f = bounds_add_relation(f, saved, path, 0)
            }
        }
        sd: ?*StructDef = bounds_record_def(p.ty);
        if (sd != null) f = bounds_record_invariant_facts(sd, bounds_obj_expr(p),
            f);
        if (bounds_infer_mode && is_int_ty(p.ty)) f = bounds_add_value(f, p, p, BoundsKind.Cursor,
            0);
        if (len(p.index_for_name) != 0) {
            a: ?*Obj = bounds_named_param(fn, p.index_for_name);
            if (a == null) error_at_file(p.browse_file, p.browse_pos, "index_for refers to unknown array parameter");
            ty: ?*Type = a.ty;
            if (ty == null) error_at_file(p.browse_file, p.browse_pos, "index_for requires an array, slice, or string parameter");
            if (!is_indexable(ty)) error_at_file(p.browse_file, p.browse_pos, "index_for requires an array, slice, or string parameter");
            f = bounds_add_order(f, new_num(0), bounds_obj_expr(p), false);
            f = bounds_add_order(f, bounds_obj_expr(p), bounds_len_term(bounds_obj_expr(a)),
                true)
        }
        p = p.param_next
    }
    // The runtime constructs the argv slice with exactly argc elements.
    // A source-level call to main cannot rely on that runtime convention.
    if (streq(fn.name, "main") && !bounds_entry_needs_inference(fn)) {
        count: ?*Obj = fn.params;
        if (count != null && is_int_ty(count.ty)) {
            args: ?*Obj = count.param_next;
            if (args != null && args.param_next == null) {
                arg_ty: ?*Type = args.ty;
                if (arg_ty != null && is_slice(arg_ty) && is_str(type_base(arg_ty))) {
                    count_path: *Expr = bounds_obj_expr(count);
                    length: *Expr = bounds_len_term(bounds_obj_expr(args));
                    f = bounds_add_order(f, count_path, length, false);
                    f = bounds_add_order(f, length, count_path, false)
                }
            }
        }
    }
    precondition: ?*Expr = fn.bounds_precondition;
    if (precondition != null) f = bounds_condition(precondition, true, f);
    f
}
