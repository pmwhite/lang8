tag compiler_internal;

// Typed source gate during the allocation migration. Runtime startup and host
// storage are audited separately (STATIC_ALLOCATION.md).
static_storage_mode: bool = false;

static_source_file: int = 0;

is_static_flag(s: str): bool {
    s == "--static"
}

static_scan_inits(head: ?*FieldInit) raises Error {
    i: ?*FieldInit = head;
    while (i != null) {
        static_scan_expr(i.lhs);
        i = i.next
    }
}

static_scan_expr(e: ?*Expr) raises Error {
    if (e == null) return;
    n: *Expr = e;
    match n.kind {
        Var _ -> { }
        MemberAccess k -> static_scan_expr(k.lhs);
        Assign k -> {
            static_scan_expr(k.lhs);
            static_scan_expr(k.rhs)
        }
        Binary k -> {
            static_scan_expr(k.lhs);
            static_scan_expr(k.rhs)
        }
        Addr k -> static_scan_expr(k.lhs);
        Deref k -> static_scan_expr(k.lhs);
        Index k -> {
            static_scan_expr(k.lhs);
            static_scan_expr(k.idx)
        }
        Not k -> static_scan_expr(k.lhs);
        Neg k -> static_scan_expr(k.lhs);
        BitNot k -> static_scan_expr(k.lhs);
        LogAnd k -> {
            static_scan_expr(k.lhs);
            static_scan_expr(k.rhs)
        }
        LogOr k -> {
            static_scan_expr(k.lhs);
            static_scan_expr(k.rhs)
        }
        OrElse k -> {
            static_scan_expr(k.lhs);
            static_scan_expr(k.rhs)
        }
        Funcall k -> {
            if (streq(k.funcname, "l8_bytes") || streq(k.funcname, "l8_cstr")) error_at_file(n.file,
                n.pos, "static storage: string conversion allocates");
            static_scan_expr(k.target);
            a: ?*Expr = k.args;
            while (a != null) {
                static_scan_expr(a);
                a = a.next
            }
        }
        As k -> static_scan_expr(k.lhs);
        Trunc k -> static_scan_expr(k.lhs);
        New _ -> error_at_file(n.file, n.pos, "static storage: new expression allocates");
        StructLit k -> static_scan_inits(k.inits);
        VariantLit k -> static_scan_inits(k.inits);
        If k -> {
            static_scan_expr(k.cond);
            static_scan_expr(k.then);
            static_scan_expr(k.els)
        }
        Match k -> {
            static_scan_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                static_scan_stmt(arm.body);
                arm = arm.next
            }
        }
        Block k -> static_scan_stmts(k.body);
        // sizeof does not evaluate its operand.
        Sizeof _ -> { }
        ArrayLit k -> {
            ty: ?*Type = n.ty;
            if (ty != null && !is_array(ty) && n.static_data == 0) error_at_file(n.file,
                n.pos, "static storage: slice literal allocates; use a fixed array");
            a2: ?*Expr = k.elems;
            while (a2 != null) {
                static_scan_expr(a2);
                a2 = a2.next
            }
        }
        Num _ -> { }
        Null -> { }
        FuncAddr _ -> { }
    }
}

static_scan_stmt(s: ?*Stmt) raises Error {
    if (s == null) return;
    n: *Stmt = s;
    match n.kind {
        Return k -> static_scan_expr(k.lhs);
        If k -> {
            static_scan_expr(k.cond);
            static_scan_stmt(k.then);
            static_scan_stmt(k.els)
        }
        While k -> {
            static_scan_expr(k.cond);
            static_scan_stmt(k.body)
        }
        For k -> {
            static_scan_expr(k.iter);
            static_scan_expr(k.hi);
            static_scan_stmt(k.body)
        }
        Block k -> static_scan_stmts(k.body);
        ExprStmt k -> static_scan_expr(k.lhs);
        Decl k -> static_scan_expr(k.init);
        Match k -> {
            static_scan_expr(k.cond);
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                static_scan_stmt(arm.body);
                arm = arm.next
            }
        }
        Raise k -> static_scan_inits(k.inits);
        Try k -> {
            static_scan_stmt(k.body);
            arm2: ?*CatchArm = k.arms;
            while (arm2 != null) {
                static_scan_stmt(arm2.body);
                arm2 = arm2.next
            }
        }
        Region _ -> error_at_file(static_source_file, n.pos, "static storage: region requires the legacy heap");
        Expect _ -> { }
    }
}

static_scan_stmts(head: ?*Stmt) raises Error {
    s: ?*Stmt = head;
    while (s != null) {
        static_scan_stmt(s);
        s = s.next
    }
}

// Audited non-allocating runtime boundaries. Unknown foreign code remains a
// migration blocker, including raw syscall access and allocator aliases.
static_extern_safe(name: []i8): bool {
    streq(name, "l8_std_write") || streq(name, "l8_std_write_text_at") || streq(name,
        "l8_heap_used") || streq(name, "exit") || streq(name, "l8_exit") || streq(name,
        "read") || streq(name, "open") || streq(name, "close") || streq(name, "clock_gettime") || streq(name,
        "rdtsc") || streq(name, "getrusage")
}

check_static_storage() raises Error {
    if (!static_storage_mode) return;
    entry: ?*Function = find_function("main");
    if (entry != null && (entry.is_extern || entry.return_ty == null || !is_int_ty(entry.return_ty))) error_at_file(entry.browse_file,
        entry.browse_pos, "static storage: main must return int");
    if (entry != null && entry.nparams != 0) error_at_file(entry.browse_file, entry.browse_pos,
        "static storage: main arguments require bounded startup storage");
    if (g_need != null) error("static storage: shared libraries require an allocation audit");
    if (cg_arm && (cg_arm_darwin || cg_arm_android)) error("static storage: this platform startup is not migrated yet");
    g: ?*Obj = globals;
    while (g != null) {
        static_scan_expr(g.init);
        g = g.next
    }
    fn: ?*Function = functions;
    while (fn != null) {
        if (fn.is_extern && !static_extern_safe(fn.link_name)) error_at_file(fn.browse_file,
            fn.browse_pos, "static storage: foreign function requires an allocation audit");
        if (!fn.is_extern && (fn.test_id < 0 || compile_test_mode)) {
            // Scan the entire import graph, including unused functions. This
            // prevents a later caller from reintroducing a dormant allocation.
            static_source_file = fn.browse_file;
            static_scan_stmt(fn.body)
        }
        fn = fn.next
    }
}
