tag compiler_internal;

// Projection of successful exits onto caller-visible terms.
bounds_return_map(term: *Expr@new, callee: *Function, args: ?*Expr@new): ?*Expr@new {
    mapped: ?*Expr = bounds_rebind_term(term, callee, args);
    if (mapped == null) return null;
    if (!bounds_effect_preserves_term(callee, mapped)) return null;
    mapped
}

bounds_return_self_offset(value: *Obj, call: *Expr): int {
    match call.kind {
        Funcall k -> {
            callee: ?*Function = k.fn;
            if (callee == null || k.target != null) return 1000000000;
            upper: int = 1000000000;
            lower: int = 1000000000;
            q: ?*BoundsReturnFact = callee.bounds_returns;
            while (q != null) {
                mapped: ?*Expr = bounds_return_map(q.term, callee, k.args);
                if (q.projection == null && mapped != null && bounds_var(mapped) == value) {
                    if (q.result_left) upper = q.bound else lower = q.bound
                }
                q = q.next
            }
            if (upper == 1000000000 || lower == 1000000000 || upper != 0 - lower) return 1000000000;
            upper
        }
        _ -> 1000000000
    }
}

bounds_return_apply(destination: *Expr, call: *Expr, f: ?*BoundsState@new): ?*BoundsState@f {
    match call.kind {
        Funcall k -> {
            callee: ?*Function = k.fn;
            if (callee == null || k.target != null) return f;
            q: ?*BoundsReturnFact = callee.bounds_returns;
            while (q != null) {
                mapped: ?*Expr = bounds_return_map(q.term, callee, k.args);
                path: *Expr = bounds_return_destination(destination, q.projection,
                    callee.bounds_result);
                if (mapped != null && bounds_term(mapped) && !bounds_same_term(path,
                    mapped)) {
                    left: *Expr = if (q.result_left) path else mapped;
                    right: *Expr = if (q.result_left) mapped else path;
                    f = bounds_add_relation(f, left, right, q.bound)
                }
                q = q.next
            }
            f
        }
        _ -> f
    }
}

bounds_return_add_candidate(
    head: ?*BoundsReturnFact@new,
    fn: *Function,
    value: *BoundsAffine,
    candidate: *Expr@new,
    f: ?*BoundsState,
    projection: ?*Expr@new
): ?*BoundsReturnFact@head {
    root: ?*Obj = bounds_term_root(candidate);
    if (root != null) {
        if (!bounds_param(fn, root) || root.bounds_written) return head
    }
    if (root == null && bounds_num(candidate) != 0) return head;
    if (!bounds_term(candidate)) return head;
    match candidate.kind {
        Num _ -> { }
        Funcall _ -> { }
        _ -> {
            if (!is_int_ty(candidate.ty)) return head
        }
    }
    q: ?*BoundsReturnFact = head;
    while (q != null) {
        if (bounds_same_term(q.term, candidate) && bounds_projection_same(q.projection,
            projection)) return head;
        q = q.next
    }
    upper: int = bounds_return_bound(f, value.base, candidate);
    lower: int = bounds_return_bound(f, candidate, value.base);
    if (upper != 1000000000) head = new BoundsReturnFact {
        projection: projection,
        term: candidate,
        result_left: true,
        bound: upper + value.offset,
        next: head
    };
    trivial_lower: bool = false;
    if (projection != null) trivial_lower = bounds_length_expr(projection) && bounds_num(candidate) == 0 && lower == 0;
    if (lower != 1000000000 && !trivial_lower) head = new BoundsReturnFact {
        projection: projection,
        term: candidate,
        result_left: false,
        bound: lower - value.offset,
        next: head
    };
    head
}

// A check_index known to be invalid always traps, so its return statement is
// not a successful exit of the surrounding function.
bounds_return_traps(value: ?*Expr, f: ?*BoundsState): bool {
    if (value == null) return false;
    match value.kind {
        Funcall k -> {
            if (!streq(k.funcname, "check_index") || k.target != null) return false;
            array: ?*Expr = k.args;
            if (array == null) return false;
            if (!bounds_pure_condition(array)) return false;
            index: ?*Expr = array.next;
            if (index == null) return false;
            affine: ?*BoundsAffine = bounds_affine(index, true);
            if (affine == null) return false;
            if (affine.offset == 0) return bounds_difference_proves(f, affine.base,
                new_num(0), -1) || bounds_difference_proves(f, bounds_len_term(array),
                affine.base, 0);
            if (affine.offset > 0 && bounds_difference_proves(f, new_num(0), affine.base,
                0)) return bounds_difference_proves(f, bounds_len_term(array), affine.base,
                affine.offset);
            false
        }
        _ -> false
    }
}

bounds_return_visit(value_expr: ?*Expr@new, f: ?*BoundsState@new) noregion raises Error {
    fn: ?*Function = bounds_current_fn;
    if (fn == null || !bounds_infer_mode) return;
    scalar: bool = is_int_ty(fn.return_ty);
    current: ?*BoundsReturnFact = null;
    if (value_expr != null && scalar) {
        value: ?*BoundsAffine = bounds_affine(value_expr, true);
        if (value != null && bounds_affine_safe(value, f)) {
            current = bounds_return_candidates(current, fn, value, null, f);
            cursor: ?*Obj = bounds_var(value.base);
            if (cursor != null) {
                origin: ?*BoundsRow = bounds_cursor_origin(f, cursor);
                if (origin != null) {
                    source: ?*Obj = origin.array;
                    if (source != null && bounds_param(fn, source)) {
                        total: int = origin.value + value.offset;
                        if (total >= 0 && total < 536870912) {
                            entry: *Expr = bounds_obj_expr(source);
                            current = new BoundsReturnFact {
                                projection: null,
                                term: entry,
                                result_left: true,
                                bound: total,
                                next: current
                            };
                            current = new BoundsReturnFact {
                                projection: null,
                                term: entry,
                                result_left: false,
                                bound: 0 - total,
                                next: current
                            }
                        }
                    }
                }
            }
        } else {
            // Forward an exact cursor result from a tail call. The callee's
            // return fact and this function's cursor origin compose without
            // an extra source-level assignment.
            qtail_position: int = bounds_count(f) - 1;
            qtail: ?*BoundsRow = bounds_row(f, qtail_position);
            while (qtail != null) {
                source: ?*Obj = qtail.array;
                if (qtail.kind == BoundsKind.Cursor && source != null && bounds_param(fn,
                    source)) {
                    delta: int = bounds_return_self_offset(qtail.index, value_expr);
                    total: int = qtail.value + delta;
                    if (delta != 1000000000 && total >= 0 && total < 536870912) {
                        entry: *Expr = bounds_obj_expr(source);
                        current = new BoundsReturnFact {
                            projection: null,
                            term: entry,
                            result_left: true,
                            bound: total,
                            next: current
                        };
                        current = new BoundsReturnFact {
                            projection: null,
                            term: entry,
                            result_left: false,
                            bound: 0 - total,
                            next: current
                        }
                    }
                }
                qtail_position = qtail_position - 1;
                qtail = bounds_row(f, qtail_position)
            }
        }
    }
    if (value_expr != null && !scalar) current = bounds_return_properties(fn, value_expr,
        f);
    if (!bounds_return_seen) {
        bounds_return_accum = current;
        bounds_return_seen = true;
        return
    }
    joined: ?*BoundsReturnFact = null;
    old: ?*BoundsReturnFact = bounds_return_accum;
    while (old != null) {
        other: ?*BoundsReturnFact = current;
        matched: bool = false;
        while (other != null && !matched) {
            if (bounds_projection_same(old.projection, other.projection) && old.result_left == other.result_left && bounds_same_term(old.term,
                other.term)) {
                joined = new BoundsReturnFact {
                    projection: old.projection,
                    term: old.term,
                    result_left: old.result_left,
                    bound: if (old.bound > other.bound) old.bound else other.bound,
                    next: joined
                };
                matched = true
            }
            other = other.next
        }
        old = old.next
    }
    bounds_return_accum = joined
}

bounds_return_same(a: ?*BoundsReturnFact, b: ?*BoundsReturnFact): bool {
    p: ?*BoundsReturnFact = a;
    while (p != null) {
        found: bool = false;
        q: ?*BoundsReturnFact = b;
        while (q != null) {
            if (bounds_projection_same(p.projection, q.projection) && p.result_left == q.result_left && p.bound == q.bound && bounds_same_term(p.term,
                q.term)) found = true;
            q = q.next
        }
        if (!found) return false;
        p = p.next
    }
    q2: ?*BoundsReturnFact = b;
    while (q2 != null) {
        found2: bool = false;
        p2: ?*BoundsReturnFact = a;
        while (p2 != null) {
            if (bounds_projection_same(q2.projection, p2.projection) && q2.result_left == p2.result_left && q2.bound == p2.bound && bounds_same_term(q2.term,
                p2.term)) found2 = true;
            p2 = p2.next
        }
        if (!found2) return false;
        q2 = q2.next
    }
    true
}

bounds_finish_returns(fn: *Function, out: ?*BoundsState@new) noregion raises Error {
    body: ?*Stmt = fn.body;
    if (body != null) {
        match body.kind {
            Block block -> {
                last: ?*Stmt = bounds_last_stmt(block.body);
                if (last != null) {
                    match last.kind {
                        ExprStmt item -> bounds_return_visit(item.lhs, out);
                        _ -> { }
                    }
                }
            }
            ExprStmt item -> bounds_return_visit(item.lhs, out);
            _ -> { }
        }
    }
    // A path that falls through without a value cannot justify a summary.
    if (body != null && !stmt_always_diverges(body)) {
        last_value: bool = false;
        match body.kind {
            Block block -> {
                last2: ?*Stmt = bounds_last_stmt(block.body);
                if (last2 != null) {
                    match last2.kind {
                        ExprStmt _ -> last_value = true;
                        _ -> { }
                    }
                }
            }
            ExprStmt _ -> last_value = true;
            _ -> { }
        }
        if (!last_value) bounds_return_accum = null
    }
    next: ?*BoundsReturnFact = if (bounds_return_seen) bounds_return_accum else null;
    if (!bounds_return_same(fn.bounds_returns, next)) bounds_infer_changed = true;
    fn.bounds_returns = next
}

// Scalar values, returned lengths and numeric fields use identical summary
// edges. Only the result-side projection differs.
bounds_projection_same(a: ?*Expr, b: ?*Expr): bool {
    if (a != null && b != null) return bounds_same_term(a, b);
    a == b
}

bounds_projection_depth(path: *Expr): int {
    match path.kind {
        MemberAccess k -> 1 + bounds_projection_depth(k.lhs);
        Funcall k -> {
            arg: ?*Expr = k.args;
            if (arg == null) 100 else bounds_projection_depth(arg)
        }
        Var _ -> 0;
        _ -> 100
    }
}

bounds_return_project(
    head: ?*BoundsReturnFact@new,
    fn: *Function@new,
    path: *Expr@new,
    f: ?*BoundsState@new
): ?*BoundsReturnFact@head {
    visited: ?*BoundsReturnFact = head;
    while (visited != null) {
        if (bounds_projection_same(visited.projection, path)) return head;
        visited = visited.next
    }
    // A finite projection vocabulary also bounds recursive summary growth.
    if (bounds_projection_depth(path) > BOUNDS_SUMMARY_DEPTH) return head;
    if (!bounds_length_expr(path) && !is_int_ty(path.ty)) return head;
    value: *BoundsAffine = new BoundsAffine { base: path, offset: 0 };
    bounds_return_candidates(head, fn, value, path, f)
}

// All result projections use the same caller-visible vocabulary and bounds.
bounds_return_candidates(
    head: ?*BoundsReturnFact@new,
    fn: *Function@new,
    value: *BoundsAffine,
    projection: ?*Expr@new,
    f: ?*BoundsState@new
): ?*BoundsReturnFact@head {
    head = bounds_return_add_candidate(head, fn, value, new_num(0), f, projection);
    param: ?*Obj = fn.params;
    while (param != null) {
        head = bounds_return_add_candidate(head, fn, value, bounds_obj_expr(param),
            f, projection);
        ty: ?*Type = param.ty;
        if (ty != null && is_indexable(ty)) head = bounds_return_add_candidate(head,
            fn, value, bounds_len_term(bounds_obj_expr(param)), f, projection);
        param = param.param_next
    }
    for position in 0..bounds_count(f) {
        row: ?*BoundsRow = bounds_row(f, position);
        if (row != null) {
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            if (left != null) head = bounds_return_add_candidate(head, fn, value,
                left, f, projection);
            if (right != null) head = bounds_return_add_candidate(head, fn, value,
                right, f, projection)
        }
    }
    head
}

bounds_return_properties(fn: *Function@new, expression: *Expr@new, f: ?*BoundsState@new) noregion raises Error: ?*BoundsReturnFact {
    ty: ?*Type = fn.return_ty;
    if (ty == null) return null;
    if (!is_indexable(ty) && bounds_record_def(ty) == null) return null;
    anchor: ?*Obj = fn.bounds_result;
    if (anchor == null) {
        saved_locals: ?*Obj = locals;
        saved_scope: ?*Obj = scope_locals;
        made: *Obj = new_obj("$bounds_result", true);
        locals = saved_locals;
        scope_locals = saved_scope;
        made.ty = fn.return_ty;
        fn.bounds_result = made;
        anchor = made
    }
    path: *Expr = bounds_obj_expr(anchor);
    facts: ?*BoundsState = bounds_value_facts(path, expression, f);
    head: ?*BoundsReturnFact = null;
    if (is_indexable(ty)) head = bounds_return_project(head, fn, bounds_len_term(path),
        facts);
    for position in 0..bounds_count(facts) {
        row: ?*BoundsRow = bounds_row(facts, position);
        if (row != null) {
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            if (left != null && bounds_term_root(left) == anchor) head = bounds_return_project(head,
                fn, left, facts);
            if (right != null && bounds_term_root(right) == anchor) head = bounds_return_project(head,
                fn, right, facts)
        }
    }
    head
}

bounds_return_destination(destination: *Expr, projection: ?*Expr@new, anchor: ?*Obj@new): *Expr@new {
    if (projection != null && anchor != null) return bounds_rebase_path(projection,
        bounds_obj_expr(anchor), destination);
    destination
}
