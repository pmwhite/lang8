tag compiler_internal;

// AST terms and arithmetic lowering. The solver consumes allocation-free views.
bounds_var(e: ?*Expr): ?*Obj {
    if (e == null) return null;
    n: *Expr = e;
    match n.kind {
        Var k -> k.var;
        _ -> null
    }
}

bounds_scalar_type(t: ?*Type): bool {
    if (t == null) return false;
    if (is_int_width_ty(t) || is_bool_ty(t) || is_any_pointer(t)) return true;
    match t.* {
        Enum k -> {
            v: ?*Variant = k.def.variants;
            while (v != null) {
                if (v.payload_size != 0 || v.fields != null) return false;
                v = v.next
            }
            true
        }
        _ -> false
    }
}

bounds_scalar_term(e: ?*Expr) raises IndexOutOfBounds: bool {
    if (e == null) return false;
    match e.kind {
        Null -> true;
        Num k -> k.form != LIT_F32 && k.form != LIT_F64 && bounds_scalar_type(e.ty);
        VariantLit k -> k.variant != null && k.inits == null && bounds_scalar_type(e.ty);
        _ -> {
            variable: ?*Obj = bounds_var(e);
            ty: ?*Type = e.ty;
            if (variable != null) ty = variable.ty;
            bounds_term(e) && bounds_scalar_type(ty)
        }
    }
}

bounds_same_scalar(a: *Expr, b: *Expr) raises IndexOutOfBounds: bool {
    match a.kind {
        Null -> is_null_expr(b);
        Num x -> {
            match b.kind {
                Num y -> x.form == y.form && x.val == y.val;
                _ -> false
            }
        }
        VariantLit x -> {
            match b.kind {
                VariantLit y -> x.variant != null && x.variant == y.variant && x.inits == null && y.inits == null;
                _ -> false
            }
        }
        _ -> bounds_same_term(a, b)
    }
}

bounds_scalar_constant(e: *Expr): bool {
    match e.kind {
        Null -> true;
        Num _ -> true;
        VariantLit k -> k.variant != null && k.inits == null;
        _ -> false
    }
}

bounds_bool_literal(value: bool): *Expr@new {
    result: *Expr = mk_expr(ExprKind.Num {
        val: if (value) 1 else 0,
        str_label: 0,
        form: if (value) LIT_TRUE else LIT_FALSE,
        spell: ""
    });
    result.ty = ty_bool;
    result
}

bounds_scalar_constants_differ(a: *Expr, b: *Expr): bool {
    match a.kind {
        Num x -> {
            match b.kind {
                Num y -> x.val != y.val && bounds_scalar_type(a.ty) && bounds_scalar_type(b.ty);
                _ -> false
            }
        }
        VariantLit x -> {
            match b.kind {
                VariantLit y -> x.variant != null && y.variant != null && x.variant != y.variant && x.inits == null && y.inits == null && bounds_scalar_type(a.ty) && bounds_scalar_type(b.ty);
                _ -> false
            }
        }
        _ -> false
    }
}

bounds_add_scalar_relation(
    f: ?*BoundsState@new,
    left: *Expr,
    right: *Expr,
    kind: BoundsKind
) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_scalar_term(left) || !bounds_scalar_term(right)) return f;
    if (bounds_same_scalar(left, right)) return f;
    first: ?*Obj = bounds_term_root(left);
    second: ?*Obj = bounds_term_root(right);
    if (first == null && second == null) return f;
    if (first == null) {
        first = second;
        second = null
    } else {
        stable_first: *Obj = first;
        if (second != null) {
            if (second.browse_id < stable_first.browse_id) {
                first = second;
                second = stable_first
            }
        }
    }
    if (first == second) second = null;
    if (first == null) return f;
    bounds_insert(f, first, second, kind, 0, left, right, null)
}

// Only reached equality rows can contribute members to this class.
// Keep their indices dense so membership does not rescan unrelated facts.
bounds_scalar_class_has(
    class: *BoundsScalarClass,
    f: *BoundsState,
    seed: *Expr,
    value: *Expr
) raises IndexOutOfBounds: bool {
    if (bounds_same_scalar(seed, value)) return true;
    rows: []*BoundsRow = f.rows_view;
    positions: []int = class.rows;
    count: int = class.count;
    for i in 0..count {
        position: int = positions[i];
        if (0 <= position && position < f.count) {
            row: *BoundsRow = rows[position];
            lhs: ?*Expr = row.left;
            rhs: ?*Expr = row.right;
            if (lhs != null && bounds_same_scalar(lhs, value)) return true;
            if (rhs != null && bounds_same_scalar(rhs, value)) return true
        }
    }
    false
}

bounds_scalar_class_add(class: *BoundsScalarClass@new, position: int) requires (0 <= position && position < len(class.reachable)) {
    while (class.count >= len(class.rows)) {
        old_rows: []int = class.rows;
        old_count: int = class.count;
        capacity: int = len(class.rows) * 2;
        while (capacity <= class.count) capacity = capacity * 2;
        rows: []int = new int[capacity](0);
        i: int = 0;
        while (i < old_count) invariant (0 <= i && i <= old_count && old_count <= len(old_rows) && old_count < len(rows)) {
            rows[i] = old_rows[i];
            i = i + 1
        }
        class.rows = rows
    }
    class.rows[class.count] = position;
    class.count = class.count + 1;
    class.reachable[position] = true
}

bounds_scalar_class(f: *BoundsState, value: *Expr) raises IndexOutOfBounds: *BoundsScalarClass@new {
    extent: int = f.count;
    rows: []*BoundsRow = f.rows_view;
    class: *BoundsScalarClass = new BoundsScalarClass { reachable: new bool[extent](false), rows: new int[4](0), count: 0 };
    reachable: []bool = class.reachable;
    changed: bool = true;
    while (changed) {
        changed = false;
        for position in 0..len(reachable) {
            if (!reachable[position]) {
                row: *BoundsRow = rows[position];
                if (row.kind == BoundsKind.Equal) {
                    left: ?*Expr = row.left;
                    right: ?*Expr = row.right;
                    if (left != null && right != null) {
                        if (bounds_scalar_class_has(class, f, value, left) || bounds_scalar_class_has(class,
                            f, value, right)) {
                            bounds_scalar_class_add(class, position);
                            changed = true
                        }
                    }
                }
            }
        }
    }
    class
}

// Every row reached by equality closure has both endpoints in the class.
// Compare its constants directly instead of rescanning all facts and proving
// membership again for each endpoint.
bounds_scalar_class_differs(class: *BoundsScalarClass, f: *BoundsState, value: *Expr): bool {
    rows: []*BoundsRow = f.rows_view;
    positions: []int = class.rows;
    count: int = class.count;
    for i in 0..count {
        position: int = positions[i];
        if (0 <= position && position < f.count) {
            row: *BoundsRow = rows[position];
            left: ?*Expr = row.left;
            right: ?*Expr = row.right;
            if (left != null && bounds_scalar_constants_differ(left, value)) return true;
            if (right != null && bounds_scalar_constants_differ(right, value)) return true
        }
    }
    false
}

bounds_scalar_proves(
    f: ?*BoundsState,
    left: *Expr,
    right: *Expr,
    kind: BoundsKind
) raises IndexOutOfBounds: bool {
    if (!bounds_reachable(f)) return true;
    if (!bounds_scalar_term(left) || !bounds_scalar_term(right)) return false;
    if (kind == BoundsKind.Equal && bounds_same_scalar(left, right)) return true;
    if (kind == BoundsKind.NotEqual && bounds_scalar_constants_differ(left, right)) return true;
    if (f == null || f.storage == null) return false;
    rows: []*BoundsRow = f.rows_view;
    count: int = f.count;
    has_equal: bool = false;
    for position in 0..count {
        row: *BoundsRow = rows[position];
        if (row.kind == BoundsKind.Equal) has_equal = true;
        if (row.kind == kind) {
            x: ?*Expr = row.left;
            y: ?*Expr = row.right;
            if (x != null && y != null) {
                if (bounds_same_scalar(left, x) && bounds_same_scalar(right, y) || bounds_same_scalar(left,
                    y) && bounds_same_scalar(right, x)) return true
            }
        }
    }
    if (!has_equal) return false;
    a: *BoundsScalarClass = bounds_scalar_class(f, left);
    if (kind == BoundsKind.Equal) return bounds_scalar_class_has(a, f, left, right);
    if (bounds_scalar_class_has(a, f, left, right)) return false;
    if (bounds_scalar_constant(right) && bounds_scalar_class_differs(a, f, right)) return true;
    b: *BoundsScalarClass = bounds_scalar_class(f, right);
    if (bounds_scalar_constant(left) && bounds_scalar_class_differs(b, f, left)) return true;
    for position in 0..count {
        row: *BoundsRow = rows[position];
        if (row.kind == BoundsKind.NotEqual) {
            x: ?*Expr = row.left;
            y: ?*Expr = row.right;
            if (x != null && y != null) {
                if (bounds_scalar_class_has(a, f, left, x) && bounds_scalar_class_has(b,
                    f, right, y) || bounds_scalar_class_has(a, f, left, y) && bounds_scalar_class_has(b,
                    f, right, x)) return true
            }
        }
    }
    false
}

bounds_add_nonnull(f: ?*BoundsState@new, path: *Expr) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_term(path)) return f;
    variable: ?*Obj = bounds_var(path);
    ty: ?*Type = path.ty;
    if (variable != null) ty = variable.ty;
    if (ty == null || !is_opt_pointer(ty)) return f;
    bounds_add_scalar_relation(f, path, new_null_expr(), BoundsKind.NotEqual)
}

bounds_nonnull(f: ?*BoundsState, path: *Expr) raises IndexOutOfBounds: bool {
    if (is_null_expr(path)) return false;
    variable: ?*Obj = bounds_var(path);
    ty: ?*Type = path.ty;
    if (variable != null) ty = variable.ty;
    if (ty != null && is_pointer(ty)) return true;
    // The parser also narrows stable locals after an early null return.
    // Assignment clears that view, and an address-taken local may change
    // through an alias, so only use the view for unaliased locals.
    if (variable != null) {
        narrowed: ?*Type = path.ty;
        if (variable.is_local && !variable.bounds_addr_taken && narrowed != null && is_pointer(narrowed)) return true
    }
    if (ty != null && (is_slice(ty) || is_array(ty))) return true;
    bounds_scalar_proves(f, path, new_null_expr(), BoundsKind.NotEqual)
}

bounds_same_array_expr(a: *Expr, b: *Expr) raises IndexOutOfBounds: bool {
    match a.kind {
        Var x -> {
            match b.kind {
                Var y -> x.var != null && x.var == y.var;
                _ -> false
            }
        }
        MemberAccess x -> {
            match b.kind {
                MemberAccess y -> x.member != null && x.member == y.member && bounds_same_array_expr(x.lhs,
                    y.lhs);
                _ -> false
            }
        }
        Deref x -> {
            match b.kind {
                Deref y -> bounds_same_array_expr(x.lhs, y.lhs);
                _ -> false
            }
        }
        Index x -> {
            match b.kind {
                Index y -> bounds_same_term(x.idx, y.idx) && bounds_same_array_expr(x.lhs,
                    y.lhs);
                _ -> false
            }
        }
        _ -> false
    }
}

// A bounds term is a stable path, a constant-indexed element, or a length.
// Cache only structural classifications, after typing and effect inference.
// New synthesized expressions start uncached; each verification has an epoch.
bounds_classify_epoch: int = 0;

bounds_classify_enabled: bool = false;

bounds_term(e: ?*Expr) raises IndexOutOfBounds: bool {
    if (e == null) return false;
    if (!bounds_classify_enabled) return bounds_term_uncached(e);
    cached: int = e.bounds_term_cache;
    if (cached == bounds_classify_epoch) return false;
    if (cached == bounds_classify_epoch + 1) return true;
    result: bool = bounds_term_uncached(e);
    if (result) e.bounds_term_cache = bounds_classify_epoch + 1 else e.bounds_term_cache = bounds_classify_epoch;
    result
}

bounds_term_uncached(e: ?*Expr) raises IndexOutOfBounds: bool {
    if (e == null) return false;
    n: *Expr = e;
    match n.kind {
        Num k -> k.form == LIT_INT || k.form == LIT_I8 || k.form == LIT_I32 || k.form == LIT_U32;
        Var k -> k.var != null;
        MemberAccess k -> bounds_term(k.lhs);
        Deref k -> bounds_term(k.lhs);
        Index k -> bounds_term(k.lhs) && bounds_term(k.idx) && is_int_ty(k.idx.ty);
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return false;
            a: ?*Expr = k.args;
            if (a == null) return false;
            if (a.next != null) return false;
            bounds_term(a)
        }
        _ -> false
    }
}

bounds_same_term(a: *Expr, b: *Expr) raises IndexOutOfBounds: bool {
    match a.kind {
        Num x -> {
            match b.kind {
                Num y -> x.form == LIT_INT && y.form == LIT_INT && x.val == y.val;
                _ -> false
            }
        }
        Funcall x -> {
            match b.kind {
                Funcall y -> {
                    if (!streq(x.funcname, "len") || !streq(y.funcname, "len")) return false;
                    ax: ?*Expr = x.args;
                    ay: ?*Expr = y.args;
                    if (ax == null || ay == null) return false;
                    bounds_same_array_expr(ax, ay)
                }
                _ -> false
            }
        }
        _ -> bounds_same_array_expr(a, b)
    }
}

bounds_term_root(e: *Expr): ?*Obj {
    match e.kind {
        Var k -> k.var;
        MemberAccess k -> bounds_term_root(k.lhs);
        Deref k -> bounds_term_root(k.lhs);
        Index k -> bounds_term_root(k.lhs);
        Funcall k -> {
            a: ?*Expr = k.args;
            if (a == null) return null;
            bounds_term_root(a)
        }
        _ -> null
    }
}

bounds_first_member(e: *Expr): ?*Member {
    match e.kind {
        MemberAccess k -> {
            inner: ?*Member = bounds_first_member(k.lhs);
            if (inner != null) return inner;
            k.member
        }
        Deref k -> bounds_first_member(k.lhs);
        _ -> null
    }
}

bounds_len_var(e: ?*Expr): ?*Obj {
    if (e == null) return null;
    n: *Expr = e;
    match n.kind {
        Funcall k -> {
            if (!streq(k.funcname, "len")) return null;
            a: ?*Expr = k.args;
            if (a == null) return null;
            if (a.next != null) return null;
            bounds_var(a)
        }
        _ -> null
    }
}

bounds_num(e: ?*Expr): int {
    if (e == null) return -999999999;
    n: *Expr = e;
    match n.kind {
        Num k -> {
            if ((k.form == LIT_INT || k.form == LIT_I8 || k.form == LIT_I32 || k.form == LIT_U32) && k.str_label == 0) return k.val;
            -999999999
        }
        Var k -> {
            v: ?*Obj = k.var;
            if (v != null && v.const_state == 2 && is_int_ty(v.ty)) return v.const_val;
            -999999999
        }
        Binary k -> {
            left: int = bounds_num(k.lhs);
            right: int = bounds_num(k.rhs);
            if (left < 0 || right < 0 || left >= 536870912 || right >= 536870912) return -999999999;
            if (k.op == BinOp.Add && left <= 536870911 - right) return left + right;
            if (k.op == BinOp.Mul && (right == 0 || left <= 536870911 / right)) return left * right;
            -999999999
        }
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return -999999999;
            a: ?*Expr = k.args;
            if (a == null || a.next != null) return -999999999;
            // Literal lengths are constants. Keep fixed-array variables as
            // length terms so the graph can use their implicit length edges.
            source: *Expr = a;
            match source.kind {
                Funcall conversion -> {
                    if (!streq(conversion.funcname, "l8_bytes") || conversion.target != null || conversion.args == null || conversion.args.next != null) return -999999999;
                    source = conversion.args
                }
                _ -> { }
            }
            match source.kind {
                Var local -> {
                    v: ?*Obj = local.var;
                    if (v != null && v.bounds_static_length && bounds_classify_enabled) return v.const_val;
                    return -999999999
                }
                Num literal -> {
                    if (literal.str_label == 0) return -999999999
                }
                _ -> return -999999999
            }
            length: int = bounds_known_len(source);
            if (length >= 0 && length < 536870912) length else -999999999
        }
        _ -> -999999999
    }
}

bounds_known_len(e: ?*Expr): int {
    if (e == null) return -1;
    n: *Expr = e;
    t: ?*Type = n.ty;
    if (t != null && is_array(t)) return array_len(t);
    match n.kind {
        Var local -> {
            v: ?*Obj = local.var;
            if (v != null && v.bounds_static_length && bounds_classify_enabled) return v.const_val;
            -1
        }
        Num k -> {
            if (k.str_label == 0) return -1;
            lit: ?*StrLit = str_lits;
            while (lit != null) {
                if (lit.label == k.str_label - 1) return lit.count;
                lit = lit.next
            }
            -1
        }
        ArrayLit k -> {
            count: int = 0;
            q: ?*Expr = k.elems;
            while (q != null) {
                count = count + 1;
                q = q.next
            }
            count
        }
        Funcall k -> {
            if (!streq(k.funcname, "l8_bytes") || k.target != null) return -1;
            source: ?*Expr = k.args;
            if (source == null || source.next != null) return -1;
            bounds_known_len(source)
        }
        New k -> bounds_num(k.lhs);
        _ -> -1
    }
}

bounds_term_numeric_lower(f: ?*BoundsState, term: *Expr) raises IndexOutOfBounds: int {
    literal: int = bounds_num(term);
    if (literal >= 0) return literal;
    wanted: BoundsNumericView = bounds_numeric_query(new_num(0), term, 0);
    if (!wanted.left.valid || !wanted.right.valid) return -1;
    evidence: BoundsEvidence = bounds_direct_evidence(f, &wanted, true);
    bound: int = evidence.bound;
    if (bound <= 0 && bound > -536870912) {
        bounds_note_separations(evidence.separation, f);
        return 0 - bound
    }
    -1
}

bounds_term_numeric_upper(f: ?*BoundsState, term: *Expr) raises IndexOutOfBounds: int {
    literal: int = bounds_num(term);
    if (literal >= 0) return literal;
    wanted: BoundsNumericView = bounds_numeric_query(term, new_num(0), 536870911);
    if (!wanted.left.valid || !wanted.right.valid) return -1;
    evidence: BoundsEvidence = bounds_direct_evidence(f, &wanted, true);
    bound: int = evidence.bound;
    if (bound >= 0 && bound < 536870912) {
        bounds_note_separations(evidence.separation, f);
        return bound
    }
    -1
}

bounds_obj_expr(v: *Obj@new): *Expr@new {
    e: *Expr = mk_expr(ExprKind.Var { var: v, name: v.name, member: null });
    e.ty = v.ty;
    e
}

bounds_ref_zero(): BoundsTermRef {
    BoundsTermRef {
        path: null,
        obj: null,
        is_len: false,
        is_zero: true,
        valid: true,
        hash: 0u32
    }
}

bounds_ref_obj(obj: *Obj, length: bool): BoundsTermRef {
    BoundsTermRef {
        path: null,
        obj: obj,
        is_len: length,
        is_zero: false,
        valid: true,
        hash: (obj.browse_id * 33 + (if (length) 1 else 2) & 2147483647) trunc u32
    }
}

bounds_ref_expr(e: ?*Expr) raises IndexOutOfBounds: BoundsTermRef {
    if (e != null) {
        match e.kind {
            Var variable -> {
                obj: ?*Obj = variable.var;
                if (obj != null) return BoundsTermRef {
                    path: e,
                    obj: obj,
                    is_len: false,
                    is_zero: false,
                    valid: true,
                    hash: (obj.browse_id * 33 + 2 & 2147483647) trunc u32
                }
            }
            Funcall call -> {
                arg: ?*Expr = call.args;
                if (arg != null) {
                    if (streq(call.funcname, "len") && call.target == null && bounds_term(arg)) return BoundsTermRef {
                        path: arg,
                        obj: bounds_var(arg),
                        is_len: true,
                        is_zero: false,
                        valid: true,
                        hash: (bounds_path_hash(arg) * 33 + 1 & 2147483647) trunc u32
                    }
                }
            }
            _ -> { }
        }
        if (bounds_term(e)) return BoundsTermRef {
            path: e,
            obj: bounds_var(e),
            is_len: false,
            is_zero: false,
            valid: true,
            hash: (bounds_path_hash(e) * 33 + 2 & 2147483647) trunc u32
        }
    }
    BoundsTermRef {
        path: null,
        obj: null,
        is_len: false,
        is_zero: false,
        valid: false,
        hash: 2u32
    }
}

bounds_ref_valid(t: BoundsTermRef): bool {
    t.valid
}

bounds_ref_same(a: BoundsTermRef, b: BoundsTermRef) raises IndexOutOfBounds: bool {
    bounds_ref_same_borrowed(&a, &b)
}

bounds_ref_same_borrowed(a: *BoundsTermRef, b: *BoundsTermRef) raises IndexOutOfBounds: bool {
    if (a.is_zero || b.is_zero) return a.is_zero && b.is_zero;
    if (a.hash != b.hash || a.is_len != b.is_len) return false;
    if (a.obj != null && b.obj != null) return a.obj == b.obj;
    ap: ?*Expr = a.path;
    bp: ?*Expr = b.path;
    if (ap != null && bp != null) return bounds_same_term(ap, bp);
    if (a.obj != null && bp != null) return bounds_var(bp) == a.obj;
    if (b.obj != null && ap != null) return bounds_var(ap) == b.obj;
    false
}

bounds_ref_ast(t: BoundsTermRef@new): ?*Expr@new {
    if (t.is_zero) return new_num(0);
    path: ?*Expr = t.path;
    if (path == null) {
        obj: ?*Obj = t.obj;
        if (obj == null) return null;
        path = bounds_obj_expr(obj)
    }
    if (t.is_len) return bounds_len_term(path);
    path
}

bounds_numeric_query(left_expr: ?*Expr, right_expr: ?*Expr, initial_bound: int) raises IndexOutOfBounds: BoundsNumericView {
    left: BoundsTermRef;
    right: BoundsTermRef;
    bound: int = initial_bound;
    ln: int = bounds_num(left_expr);
    if (ln > -536870912 && ln < 536870912) {
        left = bounds_ref_zero();
        bound = bound - ln
    } else left = bounds_ref_expr(left_expr);
    rn: int = bounds_num(right_expr);
    if (rn > -536870912 && rn < 536870912) {
        right = bounds_ref_zero();
        bound = bound + rn
    } else right = bounds_ref_expr(right_expr);
    BoundsNumericView {
        left: left,
        right: right,
        bound: bound,
        separation: null
    }
}

// Decode the one numeric row kind into the shared query representation.
// Literal endpoints move into the difference bound without constructing AST.
bounds_numeric_view(q: *BoundsRow) raises IndexOutOfBounds: BoundsNumericView {
    if (q.kind != BoundsKind.Difference) return bounds_numeric_query(null, null, 0);
    view: BoundsNumericView = bounds_numeric_query(q.left, q.right, q.value);
    view.separation = q.separation;
    view
}

bounds_numeric_entails(f: ?*BoundsState, target: *BoundsNumericView) raises IndexOutOfBounds: bool {
    if (!bounds_reachable(f)) return true;
    if (!target.left.valid || !target.right.valid) return false;
    if (f == null) return false;
    numeric: []*BoundsNumericView = f.numeric_view;
    link: ?*BoundsLinkNode = bounds_bucket(f, bounds_pair_hash(target));
    while (link != null) {
        position: int = link.position;
        if (position < f.count) {
            edge: *BoundsNumericView = numeric[position];
            if (edge.bound < 1000000000 && edge.bound <= target.bound) {
                // Branch snapshots share immutable descriptors. The same fact
                // carries exactly the same endpoints and alias assumptions.
                if (edge == target) return true;
                if (edge.left.valid && edge.right.valid && bounds_ref_same_borrowed(&target.left,
                    &edge.left) && bounds_ref_same_borrowed(&target.right, &edge.right) && (edge.separation == null || bounds_separation_same(edge.separation,
                    target.separation))) return true
            }
        }
        link = link.next
    }
    false
}

bounds_affine(e: *Expr@new, query: bool) raises IndexOutOfBounds: ?*BoundsAffine@new {
    match e.kind {
        Var k -> {
            v: ?*Obj = k.var;
            if (v != null && v.const_state == 2 && is_int_ty(v.ty)) return new BoundsAffine { base: new_num(v.const_val), offset: 0 }
        }
        _ -> { }
    }
    if (bounds_term(e)) return new BoundsAffine { base: e, offset: 0 };
    match e.kind {
        Neg k -> {
            value: int = bounds_num(k.lhs);
            if (value > 0 && value < 536870912) return new BoundsAffine { base: new_num(0 - value), offset: 0 };
            null
        }
        Binary k -> {
            lhs_number: int = bounds_num(k.lhs);
            rhs_number: int = bounds_num(k.rhs);
            if (k.op == BinOp.Mul && lhs_number >= 0 && rhs_number >= 0 && (rhs_number == 0 || lhs_number <= 536870911 / rhs_number)) return new BoundsAffine { base: new_num(lhs_number * rhs_number), offset: 0 };
            if (lhs_number >= 0 && lhs_number < 536870912 && rhs_number >= 0 && rhs_number < 536870912 && (k.op == BinOp.Add || k.op == BinOp.Sub)) {
                folded: int = if (k.op == BinOp.Add) lhs_number + rhs_number else lhs_number - rhs_number;
                if (folded > -536870912 && folded < 536870912) return new BoundsAffine { base: new_num(folded), offset: 0 }
            }
            c: int = bounds_num(k.rhs);
            base: *Expr = k.lhs;
            if (c < 0 && k.op == BinOp.Add) {
                c = bounds_num(k.lhs);
                base = k.rhs
            }
            if (c < 0 || c >= 536870912 || !bounds_term(base)) return null;
            if (k.op != BinOp.Add && k.op != BinOp.Sub) return null;
            if (!query) {
                if (k.op != BinOp.Sub) return null;
                match base.kind {
                    // len is nonnegative, so subtracting a small positive
                    // constant cannot overflow a signed int.
                    Funcall call -> {
                        if (!streq(call.funcname, "len") || call.target != null) return null
                    }
                    _ -> return null
                }
            }
            new BoundsAffine { base: base, offset: if (k.op == BinOp.Add) c else 0 - c }
        }
        _ -> null
    }
}

// A guard may use a positive offset when a known upper bound on its base
// proves that evaluating the machine-integer addition cannot wrap.
bounds_guard_affine(e: *Expr@new, f: ?*BoundsState) raises Error, IndexOutOfBounds: ?*BoundsAffine@new {
    value: ?*BoundsAffine = bounds_affine(e, true);
    if (value != null && bounds_affine_safe(value, f)) return value;
    null
}

// Difference rows state left - right <= value.
bounds_add_difference(
    f: ?*BoundsState@new,
    left: *Expr@new,
    right: *Expr@new,
    strict: bool
) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    // A guarded remaining length gives a bounded sum without requiring a
    // general linear solver: part <= limit - base implies base + part <= limit.
    match right.kind {
        Binary subtraction -> {
            if (subtraction.op == BinOp.Sub && bounds_term(left) && bounds_term(subtraction.lhs) && bounds_term(subtraction.rhs) && bounds_nonnegative_term(f,
                subtraction.rhs) && bounds_difference_proves(f, subtraction.rhs, subtraction.lhs,
                0)) {
                // The subtraction is nonnegative and cannot wrap. Since its
                // base is nonnegative, any part bounded by the remainder is
                // also bounded by the whole limit.
                f = bounds_add_order(f, left, subtraction.lhs, strict);
                // A nonnegative part fitting strictly in the remainder also
                // leaves the base strictly inside the limit.
                if (strict && bounds_nonnegative_term(f, left)) f = bounds_add_order(f,
                    subtraction.rhs, subtraction.lhs, true);
                // If limit - base is known not to wrap, a constant gap also
                // gives a direct bound on base relative to limit.
                gap: int = bounds_num(left);
                if (gap >= 0 && gap < 536870912) f = bounds_add_relation(f, subtraction.rhs,
                    subtraction.lhs, 0 - gap - (if (strict) 1 else 0));
                base_root: ?*Obj = bounds_term_root(subtraction.rhs);
                part_root: ?*Obj = bounds_term_root(left);
                if (base_root != null && part_root != null) {
                    row: BoundsRow = BoundsRow {
                        index: base_root,
                        array: part_root,
                        kind: BoundsKind.SumUpper,
                        value: if (strict) -1 else 0,
                        left: new_binary(BinOp.Add, subtraction.rhs, left),
                        right: subtraction.lhs,
                        separation: null
                    };
                    f = bounds_push(f, row)
                }
            }
        }
        _ -> { }
    }
    l: ?*BoundsAffine = bounds_guard_affine(left, f);
    r: ?*BoundsAffine = bounds_guard_affine(right, f);
    if (l == null || r == null) return f;
    root: ?*Obj = bounds_term_root(l.base);
    if (root == null) root = bounds_term_root(r.base);
    if (root == null) return f;
    bounds_insert(f, root, bounds_term_root(r.base), BoundsKind.Difference, r.offset - l.offset - (if (strict) 1 else 0),
        l.base, r.base, null)
}

bounds_add_value(
    f: ?*BoundsState@new,
    index: *Obj,
    array: ?*Obj,
    kind: BoundsKind,
    value: int
) raises Error, IndexOutOfBounds: *BoundsState@new {
    bounds_insert(f, index, array, kind, value, null, null, null)
}

// Source comparisons lower to strict or non-strict numeric rows.
bounds_add_order(
    f: ?*BoundsState@new,
    left: *Expr,
    right: *Expr,
    strict: bool
) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    bounds_add_relation(f, left, right, if (strict) -1 else 0)
}

bounds_order(
    f: ?*BoundsState,
    left: *Expr,
    right: *Expr,
    strict: bool
) raises Error, IndexOutOfBounds: bool {
    bounds_difference_proves(f, left, right, if (strict) -1 else 0)
}

bounds_nonnegative_term(f: ?*BoundsState, term: *Expr) raises Error, IndexOutOfBounds: bool {
    if (bounds_difference_proves(f, new_num(0), term, 0)) return true;
    bounds_bounded_sum_safe(f, term)
}

bounds_bounded_sum_safe(f: ?*BoundsState, term: *Expr) raises Error, IndexOutOfBounds: bool {
    if (!bounds_has_sum(f)) return false;
    match term.kind {
        Binary sum -> {
            if (sum.op != BinOp.Add || !bounds_term(sum.lhs) || !bounds_term(sum.rhs)) return false;
            if (!bounds_difference_proves(f, new_num(0), sum.lhs, 0) || !bounds_difference_proves(f,
                new_num(0), sum.rhs, 0)) return false;
            for position in 0..bounds_count(f) {
                row: ?*BoundsRow = bounds_row(f, position);
                if (row != null) {
                    if (row.kind == BoundsKind.SumUpper) {
                        upper_sum: ?*Expr = row.left;
                        if (upper_sum != null) {
                            match upper_sum.kind {
                                Binary upper -> {
                                    if (upper.op == BinOp.Add) {
                                        if (bounds_same_term(sum.lhs, upper.lhs) && bounds_difference_proves(f,
                                            sum.rhs, upper.rhs, 0)) return true;
                                        if (bounds_same_term(sum.rhs, upper.lhs) && bounds_difference_proves(f,
                                            sum.lhs, upper.rhs, 0)) return true
                                    }
                                }
                                _ -> { }
                            }
                        }
                    }
                }
            }
            false
        }
        _ -> false
    }
}

bounds_small_upper(e: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: int {
    match e.kind {
        Num k -> {
            if (k.str_label == 0 && k.form == LIT_INT && k.val >= 0 && k.val < 536870912) return k.val;
            -1
        }
        Binary k -> {
            if (k.op == BinOp.And) {
                left_mask: int = bounds_num(k.lhs);
                right_mask: int = bounds_num(k.rhs);
                if (left_mask >= 0 && left_mask < 536870912) return left_mask;
                if (right_mask >= 0 && right_mask < 536870912) return right_mask;
                return -1
            }
            if (!bounds_pure_condition(e)) return -1;
            if (k.op == BinOp.Xor) {
                x: int = bounds_small_upper(k.lhs, f);
                y: int = bounds_small_upper(k.rhs, f);
                if (x < 0 || y < 0) return -1;
                largest: int = if (x > y) x else y;
                bit_limit: int = 1;
                while (bit_limit <= largest) bit_limit = bit_limit * 2;
                return bit_limit - 1
            }
            if (k.op == BinOp.Sub) {
                left_upper: int = bounds_small_upper(k.lhs, f);
                right_upper: int = bounds_small_upper(k.rhs, f);
                left_lower: int = bounds_term_numeric_lower(f, k.lhs);
                right_lower: int = bounds_term_numeric_lower(f, k.rhs);
                interval_safe: bool = right_upper >= 0 && left_lower >= right_upper;
                relational_safe: bool = false;
                if (!interval_safe && bounds_nonnegative_term(f, k.rhs)) relational_safe = bounds_difference_proves(f,
                    k.rhs, k.lhs, 0);
                if (left_upper < 0 || right_lower < 0 || !interval_safe && !relational_safe) return -1;
                return left_upper - right_lower
            }
            if (k.op == BinOp.Div) {
                divisor: int = bounds_num(k.rhs);
                numerator: int = bounds_small_upper(k.lhs, f);
                if (divisor <= 0 || numerator < 0) return -1;
                return numerator / divisor
            }
            if (k.op == BinOp.Add || k.op == BinOp.Mul) {
                sum_left: int = bounds_small_upper(k.lhs, f);
                sum_right: int = bounds_small_upper(k.rhs, f);
                if (sum_left < 0 || sum_right < 0) return -1;
                if (k.op == BinOp.Add) {
                    if (sum_left > 536870911 - sum_right) return -1;
                    return sum_left + sum_right
                }
                if (sum_right != 0 && sum_left > 536870911 / sum_right) return -1;
                return sum_left * sum_right
            }
            if (k.op == BinOp.Mod) {
                modulus: int = bounds_num(k.rhs);
                if (modulus > 0 && modulus < 536870912 && bounds_expression_nonnegative(k.lhs,
                    f)) return modulus - 1;
                return -1
            }
            if (k.op == BinOp.Shr || k.op == BinOp.Shl) {
                shift: int = bounds_num(k.rhs);
                if (shift < 0 || shift > 62) return -1;
                upper: int = bounds_small_upper(k.lhs, f);
                if (upper < 0) return -1;
                if (k.op == BinOp.Shr) return upper >> shift;
                if (upper > 536870911 >> shift) return -1;
                return upper << shift
            }
            if (k.op == BinOp.Or) {
                left: int = bounds_small_upper(k.lhs, f);
                right: int = bounds_small_upper(k.rhs, f);
                if (left < 0 || right < 0 || left > 536870911 - right) return -1;
                return left + right
            }
            -1
        }
        _ -> {
            constant: int = bounds_num(e);
            if (constant >= 0 && constant < 536870912) return constant;
            if (!bounds_term(e) || !bounds_nonnegative_term(f, e)) return -1;
            upper2: int = bounds_term_numeric_upper(f, e);
            if (f != null) {
                // A loop's own invariant may give a loose direct bound while
                // its guard and a bounded limit give a sharper path to zero.
                query: BoundsNumericView = bounds_numeric_query(e, new_num(0), 0);
                if (query.left.valid && query.right.valid) {
                    distance: int = bounds_solve(f, &query, false);
                    if (distance < 536870912 && distance >= 0) {
                        candidate: int = distance - query.bound;
                        if (upper2 < 0 || candidate < upper2) upper2 = candidate
                    }
                }
            }
            if (upper2 >= 0 && upper2 < 536870912) upper2 else -1
        }
    }
}

bounds_difference_index(f: ?*BoundsState, array: *Expr@new, index: *Expr@new) raises Error, IndexOutOfBounds: bool {
    affine: ?*BoundsAffine = bounds_affine(index, true);
    if (affine == null) return bounds_bounded_sum_index(f, array, index, false);
    // Both mathematical inequalities imply that the computed machine index
    // is representable, so provisional normalization above is justified.
    if (bounds_difference_proves(f, affine.base, bounds_length(array), 0 - affine.offset - 1) && bounds_difference_proves(f,
        new_num(0), affine.base, affine.offset)) return true;
    bounds_bounded_sum_index(f, array, index, false)
}

bounds_bounded_sum_index(
    f: ?*BoundsState,
    array: *Expr@new,
    index: *Expr,
    allow_end: bool
) raises Error, IndexOutOfBounds: bool {
    bounds_bounded_sum_le(f, index, bounds_length(array), allow_end)
}

// A nonnegative, numerically bounded offset can share the remaining room
// reserved for an affine base. The base-to-length relation also proves the
// machine addition cannot wrap.
bounds_bounded_offset_index(f: ?*BoundsState, array: *Expr@new, index: *Expr) raises Error, IndexOutOfBounds: bool {
    match index.kind {
        Binary sum -> {
            if (sum.op != BinOp.Add) return false;
            for side in 0..2 {
                base: *Expr = if (side == 0) sum.lhs else sum.rhs;
                offset: *Expr = if (side == 0) sum.rhs else sum.lhs;
                if (bounds_term(base) && bounds_nonnegative_term(f, base)) {
                    upper: int = bounds_small_upper(offset, f);
                    if (upper >= 0 && bounds_difference_proves(f, base, bounds_length(array),
                        0 - upper - 1)) return true
                }
            }
            false
        }
        _ -> false
    }
}

// A bounded nonnegative offset fits in the room reserved after a base.
// The resulting upper bound also proves that evaluating the addition cannot
// overflow the machine integer range.
bounds_bounded_offset_le(f: ?*BoundsState, value: *Expr, limit: *Expr@new) raises Error, IndexOutOfBounds: bool {
    match value.kind {
        Binary sum -> {
            if (sum.op != BinOp.Add) return false;
            upper_limit: ?*BoundsAffine = bounds_affine(limit, true);
            if (upper_limit == null || !bounds_affine_safe(upper_limit, f)) return false;
            for side in 0..2 {
                base: *Expr = if (side == 0) sum.lhs else sum.rhs;
                offset: *Expr = if (side == 0) sum.rhs else sum.lhs;
                if (bounds_term(base) && bounds_nonnegative_term(f, base)) {
                    upper: int = bounds_small_upper(offset, f);
                    if (upper >= 0 && bounds_difference_proves(f, base, upper_limit.base,
                        upper_limit.offset - upper)) return true
                }
            }
            false
        }
        _ -> false
    }
}

// A bounded displacement cannot wrap a nonnegative base when the base has
// enough headroom. The numeric upper bound also establishes nonnegativity.
bounds_bounded_offset_nonnegative(f: ?*BoundsState, value: *Expr) raises Error, IndexOutOfBounds: bool {
    match value.kind {
        Binary sum -> {
            if (sum.op != BinOp.Add) return false;
            for side in 0..2 {
                base: *Expr = if (side == 0) sum.lhs else sum.rhs;
                offset: *Expr = if (side == 0) sum.rhs else sum.lhs;
                if (bounds_term(base) && bounds_nonnegative_term(f, base)) {
                    upper: int = bounds_small_upper(offset, f);
                    if (upper >= 0 && bounds_affine_safe(new BoundsAffine { base: base, offset: upper },
                        f)) return true
                }
            }
            false
        }
        _ -> false
    }
}

// A remaining-length comparison and its bounded-sum fact are the same
// predicate once the subtraction is known not to wrap.
bounds_remaining_span_le(
    f: ?*BoundsState,
    part: *Expr@new,
    remaining: *Expr,
    allow_end: bool
) raises Error, IndexOutOfBounds: bool {
    match remaining.kind {
        Binary subtraction -> {
            if (subtraction.op != BinOp.Sub || !bounds_term(part) || !bounds_term(subtraction.lhs) || !bounds_term(subtraction.rhs)) return false;
            if (!bounds_nonnegative_term(f, subtraction.rhs) || !bounds_difference_proves(f,
                subtraction.rhs, subtraction.lhs, 0)) return false;
            gap: int = bounds_num(part);
            if (gap >= 0 && gap < 536870912 && bounds_difference_proves(f, subtraction.rhs,
                subtraction.lhs, 0 - gap - (if (allow_end) 0 else 1))) return true;
            sum: *Expr = new_binary(BinOp.Add, subtraction.rhs, part);
            bounds_bounded_sum_le(f, sum, subtraction.lhs, allow_end)
        }
        _ -> false
    }
}

bounds_bounded_sum_le(
    f: ?*BoundsState,
    index: *Expr,
    bound: *Expr,
    allow_end: bool
) raises Error, IndexOutOfBounds: bool {
    if (!bounds_has_sum(f)) return false;
    match index.kind {
        Binary sum -> {
            if (sum.op != BinOp.Add || !bounds_term(sum.lhs) || !bounds_term(sum.rhs)) return false;
            if (!bounds_nonnegative_term(f, sum.lhs) || !bounds_nonnegative_term(f,
                sum.rhs)) return false;
            for position in 0..bounds_count(f) {
                row: ?*BoundsRow = bounds_row(f, position);
                if (row != null) {
                    sum_bound: ?*Expr = row.left;
                    limit: ?*Expr = row.right;
                    if (row.kind == BoundsKind.SumUpper && sum_bound != null) {
                        if (limit != null && bounds_difference_proves(f, limit, bound,
                            0)) {
                            match sum_bound.kind {
                                Binary upper -> {
                                    if (upper.op == BinOp.Add) {
                                        // Both components may be smaller than
                                        // the stored sum. This also admits a
                                        // stable entry snapshot of a parameter.
                                        if (bounds_difference_proves(f, sum.lhs, upper.lhs,
                                            0) && bounds_difference_proves(f, sum.rhs,
                                            upper.rhs, 0 - row.value - (if (allow_end) 0 else 1))) return true;
                                        if (bounds_difference_proves(f, sum.rhs, upper.lhs,
                                            0) && bounds_difference_proves(f, sum.lhs,
                                            upper.rhs, 0 - row.value - (if (allow_end) 0 else 1))) return true
                                    }
                                }
                                _ -> { }
                            }
                        }
                    }
                }
            }
            false
        }
        _ -> false
    }
}

bounds_affine_le_proves(f: ?*BoundsState, left: *Expr@new, right: *Expr@new) raises Error, IndexOutOfBounds: bool {
    l: ?*BoundsAffine = bounds_affine(left, true);
    r: ?*BoundsAffine = bounds_affine(right, true);
    if (l == null || r == null) return false;
    // A positive offset below an integer bound cannot wrap on success.
    if (l.offset > 0 && r.offset == 0 && bounds_difference_proves(f, l.base, r.base,
        0 - l.offset)) return true;
    bounds_affine_safe(l, f) && bounds_affine_safe(r, f) && bounds_difference_proves(f,
        l.base, r.base, r.offset - l.offset)
}

// The range-loop variable is strictly below its stable upper-bound path.
bounds_add_loop_order(f: ?*BoundsState@new, index: *Obj@new, hi: *Expr@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    bounds_add_difference(f, bounds_obj_expr(index), hi, true)
}

bounds_add(
    f: ?*BoundsState@new,
    index: *Obj,
    array: ?*Obj,
    kind: BoundsKind
) raises Error, IndexOutOfBounds: *BoundsState@new {
    bounds_add_value(f, index, array, kind, 0)
}

bounds_has(
    f: ?*BoundsState,
    index: *Obj,
    array: ?*Obj,
    kind: BoundsKind
) raises IndexOutOfBounds: bool {
    wanted: BoundsRow = BoundsRow {
        index: index,
        array: array,
        kind: kind,
        value: 0,
        left: null,
        right: null,
        separation: null
    };
    bounds_has_fact(f, &wanted)
}

bounds_fact_value(f: ?*BoundsState, index: *Obj, kind: BoundsKind): int {
    if (kind == BoundsKind.Fresh && index.bounds_static_fresh && bounds_classify_enabled) return index.browse_id;
    q_position: int = bounds_count(f) - 1;
    q: ?*BoundsRow = bounds_row(f, q_position);
    while (q != null) {
        if (q.index == index && q.kind == kind) return q.value;
        q_position = q_position - 1;
        q = bounds_row(f, q_position)
    }
    -1
}

// Known lengths are constants; dynamic lengths retain their value identity.
bounds_length(array: *Expr@new): *Expr@new {
    known: int = bounds_known_len(array);
    if (known >= 0) return new_num(known);
    bounds_len_term(array)
}

bounds_length_expr(e: *Expr): bool {
    match e.kind {
        Funcall k -> k.target == null && streq(k.funcname, "len");
        _ -> false
    }
}

// All producers enter the numeric domain through this boundary.
bounds_add_relation(
    f: ?*BoundsState@new,
    left: *Expr,
    right: *Expr,
    bound: int
) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    if (!bounds_term(left) || !bounds_term(right)) return f;
    root: ?*Obj = bounds_term_root(left);
    if (root == null) root = bounds_term_root(right);
    if (root == null) return f;
    bounds_insert(f, root, bounds_term_root(right), BoundsKind.Difference, bound,
        left, right, null)
}

// Affine transfer is valid only for mathematical, non-wrapping evaluation.
// Any machine-integer upper bound can certify headroom for a positive offset.
bounds_affine_safe(value: *BoundsAffine@new, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    if (value.offset == 0) return true;
    if (value.offset < 0) return bounds_nonnegative_term(f, value.base);
    if (bounds_has_sum(f) && bounds_bounded_sum_safe(f, new_binary(BinOp.Add, value.base,
        new_num(value.offset)))) return true;
    upper: int = bounds_term_numeric_upper(f, value.base);
    // A saved parameter value can reach a small bound through equality facts.
    if (upper < 0) upper = bounds_small_upper(value.base, f);
    if (upper >= 0 && upper <= 536870911 - value.offset) return true;
    // The base may be bounded above by a negative value (for example the
    // negative branch of a signed remainder). The nonnegative range helper
    // cannot represent that bound, but the difference solver can.
    if (bounds_difference_proves(f, value.base, new_num(536870911 - value.offset),
        0)) return true;
    wanted: BoundsTermRef = bounds_ref_expr(value.base);
    for position in 0..bounds_count(f) {
        row: ?*BoundsRow = bounds_row(f, position);
        if (row != null) {
            edge: BoundsNumericView = bounds_numeric_view(row);
            left: BoundsTermRef = edge.left;
            if (edge.left.valid && edge.right.valid && edge.bound <= 0 - value.offset && bounds_ref_same(left,
                wanted) && bounds_separations_available(edge.separation, f)) {
                bounds_note_separations(edge.separation, f);
                return true
            }
        }
    }
    bounds_below_length(f, value.base, value.offset)
}

// Symbolic ranges lower to the same edges as ordinary comparisons. A result
// may be related to a dynamic divisor/mask without inventing a new fact kind.
bounds_numeric_value(path: *Expr@new, value: *Expr@new, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@f {
    match value.kind {
        As widened -> {
            if (is_i8_ty(widened.lhs.ty) && is_int_ty(value.ty) && bounds_pure_condition(widened.lhs)) {
                f = bounds_add_relation(f, path, widened.lhs, 0);
                f = bounds_add_relation(f, widened.lhs, path, 0);
                f = bounds_add_order(f, new_num(0), path, false);
                upper_byte: int = bounds_small_upper(widened.lhs, f);
                if (upper_byte >= 0) f = bounds_add_order(f, path, new_num(upper_byte),
                    false)
            }
        }
        _ -> { }
    }
    affine: ?*BoundsAffine = bounds_affine(value, true);
    if (affine != null) {
        if (!bounds_same_term(path, affine.base) && bounds_affine_safe(affine, f)) {
            f = bounds_add_relation(f, path, affine.base, affine.offset);
            f = bounds_add_relation(f, affine.base, path, 0 - affine.offset)
        }
    }
    match value.kind {
        Binary k -> {
            if (k.op == BinOp.Add && bounds_term(path)) {
                plus: ?*BoundsAffine = bounds_affine(value, true);
                if (plus != null && plus.offset > 0 && bounds_affine_safe(plus, f)) {
                    original_upper: ?*BoundsState = f;
                    for position in 0..bounds_count(original_upper) {
                        row: ?*BoundsRow = bounds_row(original_upper, position);
                        if (row != null && row.kind == BoundsKind.Difference && row.separation == null) {
                            limit: ?*Expr = row.right;
                            base: ?*Expr = row.left;
                            if (limit != null && base != null && bounds_same_term(base,
                                plus.base) && bounds_affine_le_proves(original_upper,
                                value, limit)) f = bounds_add_order(f, path, limit,
                                false)
                        }
                    }
                }
            }
            if (k.op == BinOp.Add && bounds_term(path) && bounds_bounded_sum_safe(f,
                value)) {
                // Preserve a proved sum bound when the sum is named. The
                // nonnegative, nonwrapping check above makes the machine
                // value of path equal to the mathematical sum.
                base_root: ?*Obj = bounds_term_root(k.lhs);
                part_root: ?*Obj = bounds_term_root(k.rhs);
                path_root: ?*Obj = bounds_term_root(path);
                if (base_root != null && part_root != null && path_root != null && path_root != base_root && path_root != part_root) {
                    relation: BoundsRow = BoundsRow {
                        index: base_root,
                        array: part_root,
                        kind: BoundsKind.SumUpper,
                        value: 0,
                        left: value,
                        right: path,
                        separation: null
                    };
                    f = bounds_push(f, relation)
                }
                original: ?*BoundsState = f;
                for position in 0..bounds_count(original) {
                    row: ?*BoundsRow = bounds_row(original, position);
                    if (row != null && row.kind == BoundsKind.SumUpper) {
                        limit: ?*Expr = row.right;
                        if (limit != null && bounds_bounded_sum_le(original, value,
                            limit, true)) {
                            f = bounds_add_order(f, new_num(0), path, false);
                            f = bounds_add_order(f, path, limit, false);
                            if (bounds_bounded_sum_le(original, value, limit, false)) f = bounds_add_order(f,
                                path, limit, true)
                        }
                    }
                }
            }
            // For nonnegative operands, a proven non-wrapping subtraction
            // retains its relation to the minuend after binding the result.
            if (k.op == BinOp.Sub && !bounds_same_term(path, k.lhs) && !bounds_same_term(path,
                k.rhs) && bounds_nonnegative_term(f, k.rhs) && bounds_difference_proves(f,
                k.rhs, k.lhs, 0)) {
                f = bounds_add_order(f, new_num(0), path, false);
                f = bounds_add_order(f, path, k.lhs, false);
                f = bounds_add_difference(f, path, value, false);
                if (bounds_difference_proves(f, k.rhs, k.lhs, -1)) f = bounds_add_order(f,
                    new_num(0), path, true)
            }
        }
        _ -> { }
    }
    upper: ?*BoundsAffine = bounds_symbolic_upper(value, f);
    if (upper != null) {
        f = bounds_add_order(f, new_num(0), path, false);
        f = bounds_add_relation(f, path, upper.base, upper.offset)
    }
    f
}

bounds_expression_nonnegative(value: *Expr@new, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    match value.kind {
        // Widening an unsigned 32-bit value to int preserves its range.
        As cast -> if ((is_u32_ty(cast.lhs.ty) || is_i8_ty(cast.lhs.ty)) && is_int_ty(value.ty)) return true;
        // A nonnegative mask clears the sign bit even when its value is too
        // large for the small numeric range domain.
        Binary operation -> if (operation.op == BinOp.And && (bounds_num(operation.lhs) >= 0 || bounds_num(operation.rhs) >= 0)) return true;
        _ -> { }
    }
    if (bounds_bounded_sum_safe(f, value)) return true;
    affine: ?*BoundsAffine = bounds_guard_affine(value, f);
    affine != null && bounds_affine_lower(affine, f)
}

bounds_affine_lower(value: *BoundsAffine, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    bounds_difference_proves(f, new_num(0), value.base, value.offset)
}

// A returned upper bound also certifies that the expression is nonnegative.
bounds_symbolic_upper(value: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: ?*BoundsAffine@new {
    if (!bounds_pure_condition(value)) return null;
    match value.kind {
        Binary k -> {
            bound: ?*Expr = null;
            strict: bool = false;
            if (k.op == BinOp.Mod && bounds_expression_nonnegative(k.lhs, f) && bounds_difference_proves(f,
                new_num(0), k.rhs, -1)) {
                bound = k.rhs;
                strict = true
            }
            if (k.op == BinOp.And) {
                if (bounds_expression_nonnegative(k.rhs, f)) bound = k.rhs else if (bounds_expression_nonnegative(k.lhs,
                    f)) bound = k.lhs
            }
            if (bound != null) {
                upper: ?*BoundsAffine = bounds_guard_affine(bound, f);
                if (upper != null) return new BoundsAffine { base: upper.base, offset: upper.offset - (if (strict) 1 else 0) }
            }
            null
        }
        _ -> null
    }
}

// Rebase a stable path after copying a value. This is shared by scalar,
// slice-length and record-field transfers; it never changes the source AST.
bounds_rebase_path(term: *Expr@new, source: *Expr, destination: *Expr) raises IndexOutOfBounds: *Expr@new {
    if (bounds_same_term(term, source)) return destination;
    match term.kind {
        MemberAccess k -> {
            base: *Expr = bounds_rebase_path(k.lhs, source, destination);
            if (base == k.lhs) return term;
            result: *Expr = mk_expr(ExprKind.MemberAccess { lhs: base, name: k.name, member: k.member });
            result.ty = term.ty;
            result
        }
        Deref k -> {
            base: *Expr = bounds_rebase_path(k.lhs, source, destination);
            if (base == k.lhs) return term;
            result: *Expr = mk_expr(ExprKind.Deref { lhs: base });
            result.ty = term.ty;
            result
        }
        Funcall k -> {
            arg: ?*Expr = k.args;
            if (!streq(k.funcname, "len") || k.target != null || arg == null) return term;
            base: *Expr = bounds_rebase_path(arg, source, destination);
            if (base == arg) return term;
            bounds_len_term(base)
        }
        _ -> term
    }
}

bounds_copy_value(f: ?*BoundsState@new, source: *Expr, destination: *Expr) raises Error, IndexOutOfBounds: ?*BoundsState@f {
    if (!bounds_term(source) || bounds_term_root(source) == null || !bounds_term(destination) || bounds_same_term(source,
        destination)) return f;
    root: ?*Obj = bounds_term_root(source);
    // bounds_numeric_value adds an exact equality to the immutable scalar.
    // Copying all its incident numeric edges as well would build a clique
    // when many record fields receive the same value. Keep the existing
    // local-copy behavior: loop widening relies on those direct bounds.
    scalar_source: ?*Obj = bounds_var(source);
    shared_scalar: bool = bounds_var(destination) == null && is_int_ty(destination.ty) && bounds_classify_enabled && scalar_source != null && scalar_source.is_local && is_int_ty(scalar_source.ty) && !scalar_source.bounds_may_write && !scalar_source.bounds_addr_taken;
    original: ?*BoundsState = f;
    for position in 0..bounds_count(original) {
        row: ?*BoundsRow = bounds_row(original, position);
        if (row != null) {
            if (row.index == root || row.array == root) {
                left: ?*Expr = row.left;
                right: ?*Expr = row.right;
                if (!shared_scalar && row.kind == BoundsKind.Difference && row.separation == null && left != null && right != null) {
                    copied_left: *Expr = bounds_rebase_path(left, source, destination);
                    copied_right: *Expr = bounds_rebase_path(right, source, destination);
                    if (copied_left != left || copied_right != right) f = bounds_add_relation(f,
                        copied_left, copied_right, row.value)
                }
                if ((row.kind == BoundsKind.Equal || row.kind == BoundsKind.NotEqual) && left != null && right != null) {
                    copied_left: *Expr = bounds_rebase_path(left, source, destination);
                    copied_right: *Expr = bounds_rebase_path(right, source, destination);
                    if (copied_left != left || copied_right != right) f = bounds_add_scalar_relation(f,
                        copied_left, copied_right, row.kind)
                }
            }
        }
    }
    from: ?*Obj = bounds_var(source);
    to: ?*Obj = bounds_var(destination);
    if (from != null && to != null) {
        ty: ?*Type = from.ty;
        if (ty != null && (is_pointer(ty) || is_indexable(ty))) {
            identity: int = bounds_fact_value(original, from, BoundsKind.Fresh);
            if (identity >= 0) f = bounds_add_value(f, to, null, BoundsKind.Fresh,
                identity)
        }
    }
    f
}
