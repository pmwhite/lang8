tag compiler_internal;

// Difference graph, cached or query-local. Interned term IDs index
// contiguous tables; relaxation touches only integer IDs, weights, and labels.
// No AST nodes or per-edge heap objects are allocated by this module.
bounds_path_hash(path: *Expr): int {
    match path.kind {
        Var k -> {
            obj: ?*Obj = k.var;
            if (obj == null) 0 else obj.browse_id
        }
        MemberAccess k -> {
            member: ?*Member = k.member;
            member_id: int = 0;
            if (member != null) member_id = member.browse_id;
            bounds_path_hash(k.lhs) * 33 + member_id & 2147483647
        }
        Deref k -> bounds_path_hash(k.lhs) * 33 + 7 & 2147483647;
        Num k -> k.val & 2147483647;
        _ -> 0
    }
}

bounds_term_hash(term: BoundsTermRef): int {
    if (term.is_zero) return 0;
    hash: int = 0;
    obj: ?*Obj = term.obj;
    path: ?*Expr = term.path;
    if (obj != null) hash = obj.browse_id else if (path != null) hash = bounds_path_hash(path);
    hash * 33 + (if (term.is_len) 1 else 2) & 2147483647
}

bounds_graph_new(rows: int): *BoundsGraph@new {
    capacity: int = rows * 2 + 4;
    buckets: int = 8;
    while (buckets < capacity * 2) buckets = buckets * 2;
    new BoundsGraph {
        terms: new BoundsTermRef[capacity](bounds_ref_zero()),
        slots: new int[buckets](-1),
        occupied_slots: new int[capacity](0),
        heads: new int[capacity](-1),
        adjacency: new BoundsGraphEdge[rows + capacity * 3](BoundsGraphEdge { target: 0, weight: 0, next: -1 }),
        small_weights: true,
        nodes: 0,
        edges: 0
    }
}

bounds_graph_intern(graph: *BoundsGraph, term: BoundsTermRef@graph) raises IndexOutOfBounds: int {
    slot: int = bounds_term_hash(term) & len(graph.slots) - 1;
    id: int = graph.slots![slot];
    while (id >= 0) {
        existing: BoundsTermRef = graph.terms![id];
        if (bounds_ref_same(existing, term)) return id;
        slot = slot + 1 & len(graph.slots) - 1;
        id = graph.slots[slot]
    }
    id = graph.nodes;
    graph.nodes = id + 1;
    graph.terms![id] = term;
    graph.slots![slot] = id;
    graph.occupied_slots![id] = slot;
    id
}

bounds_graph_edge(
    graph: *BoundsGraph,
    from: int,
    to: int,
    weight: int
) raises IndexOutOfBounds {
    edge: int = graph.edges;
    graph.edges = edge + 1;
    if (weight <= -536870912 || weight >= 536870912) graph.small_weights = false;
    entry: *BoundsGraphEdge = &graph.adjacency![edge];
    entry.target = to;
    entry.weight = weight;
    entry.next = graph.heads![from];
    graph.heads[from] = edge
}

bounds_graph_load(graph: *BoundsGraph, state: ?*BoundsState) raises IndexOutOfBounds {
    // Iterate in insertion order. Edges on the same source form integer
    // adjacency chains; there are no allocations inside this loop.
    for position in 0..bounds_count(state) {
        edge: ?*BoundsNumericView = bounds_numeric_ref(state, position);
        if (edge != null && edge.valid && edge.separation == null) {
            left: BoundsTermRef = bounds_view_left_ref(edge);
            right: BoundsTermRef = bounds_view_right_ref(edge);
            to: int = bounds_graph_intern(graph, left);
            from: int = bounds_graph_intern(graph, right);
            bounds_graph_edge(graph, from, to, edge.bound)
        }
    }
    zero_term: BoundsTermRef = bounds_ref_zero();
    zero: int = bounds_graph_intern(graph, zero_term);
    for id in 0..graph.nodes {
        term: BoundsTermRef = graph.terms![id];
        if (term.is_len) {
            bounds_graph_edge(graph, id, zero, 0);
            path: ?*Expr = term.path;
            if (path != null) {
                known: int = bounds_known_len(path);
                if (known >= 0) {
                    bounds_graph_edge(graph, id, zero, 0 - known);
                    bounds_graph_edge(graph, zero, id, known)
                }
            }
        }
    }
}

// A bounded work queue stops with an under-approximation of known proofs.
// Every finite distance represents a real path. Saturation is deliberately
// avoided: dropping an out-of-range candidate cannot invent an inequality.
bounds_graph_distances(
    graph: *BoundsGraph,
    source: int,
    target: int,
    limit: int,
    early: bool
) raises IndexOutOfBounds: []int@new {
    unknown: int = 1000000000000000000;
    distances: []int = new int[graph.nodes](unknown);
    queued: []bool = new bool[graph.nodes](false);
    queue: []int = new int[graph.nodes + 1](0);
    _complete: bool = bounds_graph_search(graph, source, target, limit, early, distances,
        queued, queue);
    distances
}

// Callers may reuse scratch buffers after resetting distances and queued.
// The queue contents need no reset because each search starts with an empty queue.
// True means the queue drained before the budget ran out. Early exits and
// budget exhaustion produce valid path bounds, but not a complete result.
bounds_graph_search(
    graph: *BoundsGraph,
    source: int,
    target: int,
    limit: int,
    early: bool,
    distances: []int,
    queued: []bool,
    queue: []int
) raises IndexOutOfBounds: bool {
    unknown: int = 1000000000000000000;
    read: int = 0;
    write: int = 0;
    if (source >= 0) {
        distances![source] = 0;
        queued![source] = true;
        queue![0] = source;
        write = 1
    } else {
        // A negative source projects against the common machine upper bound
        // of all lengths. Each zero-distance seed is one possible witness.
        for id in 0..graph.nodes {
            term: BoundsTermRef = graph.terms![id];
            if (term.is_len) {
                distances![id] = 0;
                queued![id] = true;
                queue![write] = id;
                write = write + 1
            }
        }
    }
    budget: int = (graph.nodes + graph.edges + 1) * 64;
    if (budget > 262144) budget = 262144;
    if (source == target && early && limit >= 0) return false;
    while (read != write && budget > 0) {
        from: int = queue![read];
        read = read + 1;
        if (read == len(queue)) read = 0;
        queued![from] = false;
        base: int = distances![from];
        edge: int = graph.heads![from];
        while (edge >= 0 && budget > 0) {
            budget = budget - 1;
            entry: *BoundsGraphEdge = &graph.adjacency![edge];
            to: int = entry.target;
            value: int = base + entry.weight;
            if (value > 0 - unknown && value < distances![to]) {
                distances![to] = value;
                if (to == target && early && value <= limit) return false;
                if (!queued![to]) {
                    queue![write] = to;
                    write = write + 1;
                    if (write == len(queue)) write = 0;
                    queued[to] = true
                }
            }
            edge = entry.next
        }
    }
    read == write && budget > 0
}

bounds_graph_distance(
    graph: *BoundsGraph,
    source: int,
    target: int,
    limit: int,
    early: bool
) raises IndexOutOfBounds: int {
    distances: []int = bounds_graph_distances(graph, source, target, limit, early);
    distances![target]
}

bounds_graph_find(graph: *BoundsGraph, term: BoundsTermRef) raises IndexOutOfBounds: int {
    slot: int = bounds_term_hash(term) & len(graph.slots) - 1;
    id: int = graph.slots![slot];
    while (id >= 0) {
        existing: BoundsTermRef = graph.terms![id];
        if (bounds_ref_same(existing, term)) return id;
        slot = slot + 1 & len(graph.slots) - 1;
        id = graph.slots[slot]
    }
    -1
}

// A scalar source absent from every stored right endpoint has no path in the
// difference graph. Length and zero sources can have implicit edges.
bounds_source_has_edge(state: ?*BoundsState, source: BoundsTermRef) raises IndexOutOfBounds: bool {
    if (source.is_len || source.is_zero) return true;
    for position in 0..bounds_count(state) {
        edge: ?*BoundsNumericView = bounds_numeric_ref(state, position);
        if (edge != null && edge.valid && edge.separation == null) {
            if (bounds_ref_same(bounds_view_right_ref(edge), source)) return true
        }
    }
    false
}

// A scalar target absent from every stored left endpoint cannot be reached.
bounds_target_has_edge(state: ?*BoundsState, target: BoundsTermRef) raises IndexOutOfBounds: bool {
    if (target.is_len || target.is_zero) return true;
    for position in 0..bounds_count(state) {
        edge: ?*BoundsNumericView = bounds_numeric_ref(state, position);
        if (edge != null && edge.valid && edge.separation == null) {
            if (bounds_ref_same(bounds_view_left_ref(edge), target)) return true
        }
    }
    false
}

// Without stored difference edges, only length nonnegativity and known
// constant lengths can connect query endpoints through zero.
bounds_empty_distance(left: BoundsTermRef, right: BoundsTermRef) raises IndexOutOfBounds: int {
    unknown: int = 1000000000000000000;
    if (bounds_ref_same(left, right)) return 0;
    if (!right.is_zero && !right.is_len) return unknown;
    if (!left.is_zero && !left.is_len) return unknown;
    source_to_zero: int = 0;
    if (right.is_len) {
        source_path: ?*Expr = right.path;
        if (source_path != null) {
            source_length: int = bounds_known_len(source_path);
            if (source_length >= 0) source_to_zero = 0 - source_length
        }
    }
    if (left.is_zero) return source_to_zero;
    target_path: ?*Expr = left.path;
    if (target_path == null) return unknown;
    target_length: int = bounds_known_len(target_path);
    if (target_length < 0) return unknown;
    source_to_zero + target_length
}

// Keep two graphs so a join can pin its first predecessor while loading the
// second. Prefix length is part of the key: a buffer may contain later rows.
// Larger states use the ordinary query-local path instead of growing caches.
// A lookup-only request avoids loading graphs for quickly rejected queries.
bounds_cached_graph(state: ?*BoundsState, excluded: ?*BoundsGraph, load: bool) raises IndexOutOfBounds: ?*BoundsGraphCache@state {
    if (state == null || state.count > BOUNDS_GRAPH_CACHE_ROWS) return null;
    arena: ?*BoundsArena = state.arena;
    if (arena == null) return null;
    first: *BoundsGraphCache = arena.first_graph;
    second: *BoundsGraphCache = arena.second_graph;
    cache: *BoundsGraphCache = second;
    if (first.graph != excluded && first.storage == state.storage && first.count == state.count) cache = first else if (second.graph == excluded) cache = first;
    if (!load && (cache.storage != state.storage || cache.count != state.count)) return null;
    if (cache == second) {
        arena.first_graph = second;
        arena.second_graph = first
    }
    if (cache.storage == state.storage && cache.count == state.count) return cache;
    graph: *BoundsGraph = cache.graph;
    for i in 0..graph.nodes {
        graph.slots![graph.occupied_slots![i]] = -1;
        graph.heads![i] = -1
    }
    graph.nodes = 0;
    graph.edges = 0;
    graph.small_weights = true;
    bounds_graph_load(graph, state);
    cache.storage = state.storage;
    cache.count = state.count;
    cache.source = -2;
    cache.complete = false;
    cache
}

// A partial search may answer another proof only with a path already found.
// Exact queries and unproved tighter limits still need a complete/new search.
bounds_cached_distance(
    cache: *BoundsGraphCache,
    source: int,
    target: int,
    limit: int,
    early: bool
) raises IndexOutOfBounds: int {
    if (cache.source == source && (cache.complete || early && cache.distances![target] <= limit)) return cache.distances![target];
    for i in 0..cache.graph.nodes {
        cache.distances![i] = 1000000000000000000;
        cache.queued![i] = false
    }
    cache.source = source;
    cache.complete = bounds_graph_search(cache.graph, source, target, limit, early,
        cache.distances, cache.queued, cache.queue);
    cache.distances![target]
}

// Two explicit, unconditional interval bounds can prove a difference through
// zero without a graph search. Restrict both weights so their sum cannot wrap.
bounds_zero_path(state: ?*BoundsState, query: BoundsNumericView) raises IndexOutOfBounds: int {
    if (query.left_zero || query.right_zero) return 1000000000000000000;
    upper: BoundsNumericView = query;
    upper.right_path = null;
    upper.right_obj = null;
    upper.right_len = false;
    upper.right_zero = true;
    upper.separation = null;
    upper_bound: int = bounds_direct_bound(state, upper);
    if (upper_bound <= -536870912 || upper_bound >= 536870912) return 1000000000000000000;
    lower: BoundsNumericView = query;
    lower.left_path = null;
    lower.left_obj = null;
    lower.left_len = false;
    lower.left_zero = true;
    lower.separation = null;
    lower_bound: int = bounds_direct_bound(state, lower);
    if (lower_bound <= -536870912 || lower_bound >= 536870912) return 1000000000000000000;
    upper_bound + lower_bound
}

bounds_solve(state: ?*BoundsState, query: BoundsNumericView, early: bool) raises IndexOutOfBounds: int {
    if (!query.valid) return 1000000000000000000;
    left: BoundsTermRef = bounds_view_left_ref(&query);
    right: BoundsTermRef = bounds_view_right_ref(&query);
    if (bounds_count(state) == 0) return bounds_empty_distance(left, right);
    if (early) {
        zero_bound: int = bounds_zero_path(state, query);
        if (zero_bound < 1000000000000000000 && zero_bound <= query.bound) return zero_bound
    }
    cached: ?*BoundsGraphCache = bounds_cached_graph(state, null, false);
    if (cached == null) {
        if (!bounds_ref_same(left, right) && (!bounds_source_has_edge(state, right) || !bounds_target_has_edge(state,
            left))) return 1000000000000000000;
        cached = bounds_cached_graph(state, null, true)
    }
    if (cached != null) {
        cached_target: int = bounds_graph_find(cached.graph, left);
        cached_source: int = bounds_graph_find(cached.graph, right);
        // Missing scalar endpoints cannot gain implicit edges. Length endpoints
        // may connect through zero using universal implicit bounds.
        if (!bounds_ref_same(left, right) && (cached_source < 0 && !right.is_len && !right.is_zero || cached_target < 0 && !left.is_len && !left.is_zero)) return 1000000000000000000;
        if (cached_target >= 0 && cached_source >= 0) return bounds_cached_distance(cached,
            cached_source, cached_target, query.bound, early);
        // An absent length has only implicit edges through zero. Translate
        // those endpoints instead of constructing another copy of the graph.
        // Do not retain query-owned AST nodes in the state's graph cache.
        // Small weights keep every budget-limited path far from the sentinel.
        // Partial searches are used only when they already prove this query.
        if (!bounds_ref_same(left, right)) {
            zero_term: BoundsTermRef = bounds_ref_zero();
            zero: int = bounds_graph_find(cached.graph, zero_term);
            shift: int = 0;
            usable: bool = zero >= 0 && cached.graph.small_weights;
            if (cached_source < 0) {
                if (!right.is_len) usable = false else {
                    known: int = bounds_known_len(right.path);
                    if (known >= 0) shift = 0 - known;
                    cached_source = zero
                }
            }
            if (cached_target < 0) {
                if (!left.is_len) usable = false else {
                    known: int = bounds_known_len(left.path);
                    if (known < 0) return 1000000000000000000;
                    if (known >= 536870912 || shift <= -536870912) usable = false else shift = shift + known;
                    cached_target = zero
                }
            }
            if (usable && shift > -536870912 && shift < 536870912 && query.bound > -1000000000000000000 && query.bound < 1000000000000000000) {
                distance: int = bounds_cached_distance(cached, cached_source, cached_target,
                    query.bound - shift, early);
                if (distance >= 1000000000000000000) {
                    if (cached.complete) return 1000000000000000000
                } else {
                    adjusted: int = distance + shift;
                    if (adjusted > -1000000000000000000 && adjusted < 1000000000000000000 && (cached.complete || early && adjusted <= query.bound)) return adjusted
                }
            }
        }
    }
    result: int = 1000000000000000000;
    region {
        graph: *BoundsGraph = bounds_graph_new(bounds_count(state));
        target: int = bounds_graph_intern(graph, left);
        source: int = bounds_graph_intern(graph, right);
        bounds_graph_load(graph, state);
        if (source == target || graph.heads![source] >= 0) result = bounds_graph_distance(graph,
            source, target, query.bound, early)
    }
    result
}

// Pure entailment does not use edges that need additional alias assumptions.
// This is suitable for deciding whether a transfer would add any information.
bounds_difference_entails(
    state: ?*BoundsState,
    left: *Expr,
    right: *Expr,
    limit: int
) raises IndexOutOfBounds: bool {
    if (!bounds_reachable(state)) return true;
    query: BoundsNumericView = bounds_numeric_query(left, right, limit);
    if (!query.valid) return false;
    left_ref: BoundsTermRef = bounds_view_left_ref(&query);
    right_ref: BoundsTermRef = bounds_view_right_ref(&query);
    if (query.bound >= 0 && bounds_ref_same(left_ref, right_ref)) return true;
    if (bounds_numeric_entails(state, query)) return true;
    bounds_solve(state, query, true) <= query.bound
}

bounds_difference_proves(
    state: ?*BoundsState,
    left: *Expr,
    right: *Expr,
    limit: int
) raises IndexOutOfBounds: bool {
    if (!bounds_reachable(state)) return true;
    query: BoundsNumericView = bounds_numeric_query(left, right, limit);
    if (!query.valid) return false;
    left_ref: BoundsTermRef = bounds_view_left_ref(&query);
    right_ref: BoundsTermRef = bounds_view_right_ref(&query);
    if (query.bound >= 0 && bounds_ref_same(left_ref, right_ref)) return true;
    if (bounds_direct_proves(state, query)) return true;
    bounds_solve(state, query, true) <= query.bound
}

bounds_return_bound(state: ?*BoundsState, left: *Expr, right: *Expr) raises IndexOutOfBounds: int {
    fallback: int = 1000000000;
    // Array lengths are nonnegative even when the returned value is a
    // negative sentinel and no explicit relation was recorded on that path.
    if (bounds_length_expr(right)) {
        constant: int = bounds_num(left);
        if (constant >= -536870911 && constant < 0) fallback = constant
    }
    query: BoundsNumericView = bounds_numeric_query(left, right, 0);
    if (!query.valid) {
        if (fallback < -64) return -64;
        return fallback
    }
    left_ref: BoundsTermRef = bounds_view_left_ref(&query);
    right_ref: BoundsTermRef = bounds_view_right_ref(&query);
    distance: int = 1000000000000000000;
    if (bounds_ref_same(left_ref, right_ref)) distance = 0 else {
        direct: int = bounds_direct_bound(state, query);
        reverse: BoundsNumericView = bounds_numeric_query(right, left, 0);
        back: int = bounds_direct_bound(state, reverse);
        // Exact stored relations need no graph search. A stronger path could
        // only contradict the assumptions, so the direct proof suffices.
        if (direct < 1000000000 && back < 1000000000 && direct + back == 0) distance = direct else distance = bounds_solve(state,
            query, false)
    }
    value: int = distance - query.bound;
    if (fallback < value) value = fallback;
    if (value > 64) return 1000000000;
    if (value < -64) -64 else value
}

// Proof queries may discharge alias obligations. Lattice membership used by
// joins/widening remains pure and never strengthens a function's contract.
bounds_direct_proves(state: ?*BoundsState, target: BoundsNumericView) raises IndexOutOfBounds: bool {
    if (!target.valid) return false;
    evidence: BoundsEvidence = bounds_direct_evidence(state, target, true);
    if (evidence.bound >= 1000000000 || evidence.bound > target.bound) return false;
    bounds_note_separations(evidence.separation, state);
    true
}

// Project onto a bounded set of terms shared by both predecessors. Keep
// endpoint positions, not region-owned AST references, across the scratch
// region. Eight source searches per branch suffice for all selected pairs.
bounds_join_project(a: ?*BoundsState, b: ?*BoundsState, result: ?*BoundsState@new) raises IndexOutOfBounds: ?*BoundsState@result {
    positions: []int = new int[BOUNDS_JOIN_TERMS](-1);
    weights: []int = new int[BOUNDS_JOIN_TERMS * BOUNDS_JOIN_TERMS](1000000000000000000);
    count: int = 0;
    region {
        first: *BoundsGraph;
        first_cached: ?*BoundsGraphCache = bounds_cached_graph(a, null, true);
        if (first_cached != null) first = first_cached.graph else {
            first = bounds_graph_new(bounds_count(a));
            bounds_graph_load(first, a)
        }
        second: *BoundsGraph;
        second_cached: ?*BoundsGraphCache = bounds_cached_graph(b, first, true);
        if (second_cached != null) second = second_cached.graph else {
            second = bounds_graph_new(bounds_count(b));
            bounds_graph_load(second, b)
        }
        first_ids: []int = new int[BOUNDS_JOIN_TERMS](-1);
        second_ids: []int = new int[BOUNDS_JOIN_TERMS](-1);
        position: int = 0;
        while (position < bounds_count(a) && count < BOUNDS_JOIN_TERMS) {
            edge: BoundsNumericView = bounds_numeric_at(a, position);
            if (edge.valid) {
                for side in 0..2 {
                    term: BoundsTermRef = if (side == 0) bounds_view_left_ref(&edge) else bounds_view_right_ref(&edge);
                    left_id: int = bounds_graph_find(first, term);
                    right_id: int = bounds_graph_find(second, term);
                    seen: bool = false;
                    for j in 0..count {
                        if (first_ids![j] == left_id) seen = true
                    }
                    if (!seen && left_id >= 0 && right_id >= 0 && count < BOUNDS_JOIN_TERMS) {
                        positions![count] = position * 2 + side;
                        first_ids![count] = left_id;
                        second_ids![count] = right_id;
                        count = count + 1
                    }
                }
            }
            position = position + 1
        }
        // All searches share region-owned workspace. No search result escapes
        // except scalar weights copied into the projection table.
        left_distances: []int = new int[first.nodes](1000000000000000000);
        right_distances: []int = new int[second.nodes](1000000000000000000);
        nodes: int = if (first.nodes > second.nodes) first.nodes else second.nodes;
        queued: []bool = new bool[nodes](false);
        queue: []int = new int[nodes + 1](0);
        for source in 0..count {
            for i in 0..first.nodes {
                left_distances![i] = 1000000000000000000;
                queued![i] = false
            }
            _first_complete: bool = bounds_graph_search(first, first_ids![source],
                0, 0, false, left_distances, queued, queue);
            for i in 0..second.nodes {
                right_distances![i] = 1000000000000000000;
                queued![i] = false
            }
            _second_complete: bool = bounds_graph_search(second, second_ids![source],
                0, 0, false, right_distances, queued, queue);
            for target in 0..count {
                left_distance: int = left_distances![first_ids![target]];
                right_distance: int = right_distances![second_ids![target]];
                weights![source * BOUNDS_JOIN_TERMS + target] = (if (left_distance > right_distance) left_distance else right_distance)
            }
        }
    }
    for source in 0..count {
        source_edge: BoundsNumericView = bounds_numeric_at(a, positions![source] / 2);
        right: BoundsTermRef = if (positions[source] % 2 == 0) bounds_view_left_ref(&source_edge) else bounds_view_right_ref(&source_edge);
        for target in 0..count {
            bound: int = weights![source * BOUNDS_JOIN_TERMS + target];
            if (source != target && bound > -536870912 && bound < 536870912) {
                target_edge: BoundsNumericView = bounds_numeric_at(a, positions![target] / 2);
                left: BoundsTermRef = if (positions[target] % 2 == 0) bounds_view_left_ref(&target_edge) else bounds_view_right_ref(&target_edge);
                query: BoundsNumericView = BoundsNumericView {
                    left_path: left.path,
                    left_obj: left.obj,
                    left_len: left.is_len,
                    left_zero: left.is_zero,
                    right_path: right.path,
                    right_obj: right.obj,
                    right_len: right.is_len,
                    right_zero: right.is_zero,
                    bound: bound,
                    separation: null,
                    valid: true
                };
                // Keep normalized endpoints throughout the membership test.
                // Materialize source syntax only for an actual new fact.
                if (bounds_reachable(result) && !bounds_numeric_entails(result, query) && bounds_solve(result,
                    query, true) > bound) {
                    left_ast: *Expr = bounds_join_endpoint(a, positions[target]);
                    right_ast: *Expr = bounds_join_endpoint(a, positions[source]);
                    result = bounds_add_relation(result, left_ast, right_ast, bound)
                }
            }
        }
    }
    result
}

bounds_join_endpoint(state: ?*BoundsState, position: int) raises IndexOutOfBounds: *Expr@new {
    edge: BoundsNumericView = bounds_numeric_at(state, position / 2);
    term: BoundsTermRef = if (position % 2 == 0) bounds_view_left_ref(&edge) else bounds_view_right_ref(&edge);
    path: ?*Expr = bounds_ref_ast(term);
    if (path == null) new_num(0) else path
}

// Prove base + margin cannot overflow by finding a length-relative upper
// bound. One multi-source search replaces a separate solve for every length.
bounds_below_length(state: ?*BoundsState, base: *Expr, margin: int) raises IndexOutOfBounds: bool {
    result: bool = false;
    region {
        term: BoundsTermRef = bounds_ref_expr(base);
        if (bounds_ref_valid(term)) {
            graph: *BoundsGraph = bounds_graph_new(bounds_count(state));
            target: int = bounds_graph_intern(graph, term);
            bounds_graph_load(graph, state);
            result = bounds_graph_distance(graph, -1, target, 0 - margin, true) <= 0 - margin
        }
    }
    result
}
