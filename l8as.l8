// l8as: minimal x86-64 AT&T assembler → ELF64 ET_REL (elfpack-compatible).
// Usage: l8as -o out.o a.s b.s ...

type Sym = {
    name: *i8,
    val: int,
    sec: int,
    bind: int,
    defined: int,
    hash_next: int
};

type Rel = {
    off: int,
    typ: int,
    sym: int,
    addend: int
};

type LocPatch = {
    off: int,
    next_ip: int,
    digit: int
};

O_RDONLY: int;
O_WRONLY: int;
O_CREAT: int;
O_TRUNC: int;
MODE_755: int;
ET_REL: int;
EM_X86_64: int;
SHN_ABS: int;
SHT_NULL: int;
SHT_PROGBITS: int;
SHT_SYMTAB: int;
SHT_STRTAB: int;
SHT_RELA: int;
SHT_NOBITS: int;
SHF_WRITE: int;
SHF_ALLOC: int;
SHF_EXECINSTR: int;
SHF_INFO_LINK: int;
R_X86_64_PC32: int;
R_X86_64_PLT32: int;
STB_LOCAL: int;
STB_GLOBAL: int;
SEC_UND: int;
SEC_TEXT: int;
SEC_RODATA: int;
SEC_DATA: int;
SEC_BSS: int;
SEC_ABS: int;

text_buf: *i8;
text_len: int;
text_cap: int;
rodata_buf: *i8;
rodata_len: int;
rodata_cap: int;
data_buf: *i8;
data_len: int;
data_cap: int;
bss_size: int;
cur_sec: int;
pass_no: int;

syms: *Sym;
nsyms: int;
syms_cap: int;
sym_buckets: *int;
SYM_BUCKETS: int;
rels: *Rel;
nrels: int;
rels_cap: int;
globls: **i8;
nglobls: int;
globls_cap: int;
globl_buckets: *int;
globl_next: *int;

loc_last_sec: *int;
loc_last_off: *int;
loc_defined: *int;
loc_patches: *LocPatch;
nloc_patches: int;
loc_patches_cap: int;

src: *i8;
src_len: int;
tokbuf: *i8;
do_profile: int;

type Timespec = { sec: int; nsec: int; };

mono_ns(): int {
    ts: Timespec = uninitialized;
    syscall(228, 1, &ts, 0, 0, 0);
    return ts.sec * 1000000000 + ts.nsec;
}

emit_num_fd(fd: int, n: int) {
    if (n == 0) { write(fd, "0", len("0")); return; }
    neg: int = 0;
    if (n < 0) { neg = 1; n = 0 - n; }
    buf: *i8 = new i8[32];
    i: int = 0;
    while (n > 0) {
        buf[i] = (('0' as int) + (n % 10)) trunc i8;
        i = i + 1;
        n = n / 10;
    }
    if (neg != 0) { write(fd, "-", len("-")); }
    while (i > 0) {
        i = i - 1;
        write(fd, buf + i, 1);
    }
}

profile_print(label: *i8, dt_ns: int) {
    write(2, "profile: ", len("profile: "));
    write(2, label, len(label));
    write(2, " ", len(" "));
    ms: int = dt_ns / 1000000;
    us: int = (dt_ns / 1000) % 1000;
    emit_num_fd(2, ms);
    write(2, ".", len("."));
    if (us < 100) { write(2, "0", len("0")); }
    if (us < 10) { write(2, "0", len("0")); }
    emit_num_fd(2, us);
    write(2, " ms\n", len(" ms\n"));
}

is_profile_flag(s: *i8): bool {
    if (s[0] == '-' && s[1] == 'p' && s[2] == 0 trunc i8) { return true; }
    if (s[0] == '-' && s[1] == '-' && s[2] == 'p' && s[3] == 'r' && s[4] == 'o'
        && s[5] == 'f' && s[6] == 'i' && s[7] == 'l' && s[8] == 'e' && s[9] == 0 trunc i8) {
        return true;
    }
    return false;
}


expr_s: *i8;
expr_i: int;
OP_NONE: int;
OP_REG: int;
OP_IMM: int;
OP_MEM: int;
OP_MEMRIP: int;
OP_MEMABS: int;
OP_SYM: int;
OP_LOC: int;
OP_INDREG: int;
op_kind: int;
op_reg: int;
op_is_al: int;
op_imm: int;
op_base: int;
op_disp: int;
op_name: *i8;
op_extra: int;
op_digit: int;
op_fb: int;
op2_kind: int;
op2_reg: int;
op2_is_al: int;
op2_imm: int;
op2_base: int;
op2_disp: int;
op2_name: *i8;
op2_extra: int;
op2_digit: int;
op2_fb: int;
jmp_rel_off: int;
jmp_next_ip: int;
op_a: *i8;
op_b: *i8;
op_a_buf: *i8;
op_b_buf: *i8;
mem_base_buf: *i8;
mem_disp_buf: *i8;
mem_name_buf: *i8;
n_ops: int;
strtab_buf: *i8;
strtab_len: int;
strtab_cap: int;

sh_out: *i8;
sh_base: int;
sh_idx: int;
sh_nm: int;
sh_typ: int;
sh_flags: int;
sh_offset: int;
sh_size: int;
sh_link: int;
sh_info: int;
sh_align: int;
sh_entsize: int;


fail(msg: *i8): noreturn {
    write(2, "l8as: ", len("l8as: "));
    write(2, msg, len(msg));
    write(2, "\n", len("\n"));
    exit(1);
}

memcpy(dst: *i8, src0: *i8, n: int): *i8 {
    i: int = 0;
    while (i + 8 <= n) {
        d: *int = (dst + i) as *int;
        s: *int = (src0 + i) as *int;
        d.* = s.*;
        i = i + 8;
    }
    while (i < n) {
        dst[i] = src0[i];
        i = i + 1;
    }
    return dst;
}

memset0(dst: *i8, n: int) {
    i: int = 0;
    while (i < n) {
        dst[i] = 0 trunc i8;
        i = i + 1;
    }
}

streq(a: *i8, b: *i8): bool {
    i: int = 0;
    while (true) {
        if (a[i] != b[i]) { return false; }
        if (a[i] == 0 trunc i8) { return true; }
        i = i + 1;
    }
    return false;
}

strlen0(s: *i8): int {
    i: int = 0;
    while (s[i] != 0 trunc i8) { i = i + 1; }
    return i;
}

strdup0(s: *i8): *i8 {
    n: int = strlen0(s);
    p: *i8 = new i8[n + 1];
    memcpy(p, s, n);
    p[n] = 0 trunc i8;
    return p;
}

strdup_n(s: *i8, n: int): *i8 {
    p: *i8 = new i8[n + 1];
    memcpy(p, s, n);
    p[n] = 0 trunc i8;
    return p;
}

hash_str(s: *i8): int {
    h: int = 5381;
    i: int = 0;
    while (s[i] != 0 trunc i8) {
        h = h * 33 + (s[i] as int);
        i = i + 1;
    }
    if (h < 0) { h = 0 - h; }
    return h;
}

sym_bucket(h: int): int {
    return h % SYM_BUCKETS;
}

clear_sym_buckets() {
    i: int = 0;
    while (i < SYM_BUCKETS) {
        sym_buckets[i] = 0 - 1;
        globl_buckets[i] = 0 - 1;
        i = i + 1;
    }
}

wr16(b: *i8, o: int, v: int) {
    tmp: int = v;
    p: *int = &tmp;
    memcpy(b + o, p as *i8, 2);
}

wr32(b: *i8, o: int, v: int) {
    tmp: int = v;
    p: *int = &tmp;
    memcpy(b + o, p as *i8, 4);
}

wr64(b: *i8, o: int, v: int) {
    tmp: int = v;
    p: *int = &tmp;
    memcpy(b + o, p as *i8, 8);
}

align_up(x: int, a: int): int {
    return ((x + a - 1) / a) * a;
}

is_digit(c: i8): bool {
    return c >= '0' && c <= '9';
}

is_ident_start(c: i8): bool {
    if (c >= 'a' && c <= 'z') { return true; }
    if (c >= 'A' && c <= 'Z') { return true; }
    if (c == '_' || c == '.') { return true; }
    return false;
}

is_ident(c: i8): bool {
    if (is_ident_start(c)) { return true; }
    return is_digit(c);
}

fits_imm8(v: int): bool {
    return v >= 0 - 128 && v <= 127;
}

u8(v: int): i8 {
    if (v < 0) { v = v + 256; }
    while (v >= 256) { v = v - 256; }
    return v trunc i8;
}

/* ---- growable section buffers ---- */

ensure_cap(which: int, need: int) {
    buf: *i8 = text_buf;
    len0: int = text_len;
    cap: int = text_cap;
    if (which == SEC_RODATA) { buf = rodata_buf; len0 = rodata_len; cap = rodata_cap; }
    if (which == SEC_DATA) { buf = data_buf; len0 = data_len; cap = data_cap; }
    if (len0 + need <= cap) { return; }
    ncap: int = cap;
    if (ncap < 64) { ncap = 64; }
    while (len0 + need > ncap) { ncap = ncap * 2; }
    nbuf: *i8 = new i8[ncap];
    memcpy(nbuf, buf, len0);
    if (which == SEC_TEXT) { text_buf = nbuf; text_cap = ncap; }
    if (which == SEC_RODATA) { rodata_buf = nbuf; rodata_cap = ncap; }
    if (which == SEC_DATA) { data_buf = nbuf; data_cap = ncap; }
}

cur_off(): int {
    if (cur_sec == SEC_BSS) { return bss_size; }
    if (cur_sec == SEC_RODATA) { return rodata_len; }
    if (cur_sec == SEC_DATA) { return data_len; }
    return text_len;
}

emit_b(v: int) {
    if (cur_sec == SEC_BSS) { fail("emit in .bss"); }
    which: int = cur_sec;
    ensure_cap(which, 1);
    if (which == SEC_TEXT) {
        text_buf[text_len] = u8(v);
        text_len = text_len + 1;
    } else {
        if (which == SEC_RODATA) {
            rodata_buf[rodata_len] = u8(v);
            rodata_len = rodata_len + 1;
        } else {
            data_buf[data_len] = u8(v);
            data_len = data_len + 1;
        }
    }
}

emit_i32(v: int) {
    tmp: int = 0;
    p: *i8 = (&tmp) as *i8;
    wr32(p, 0, v);
    emit_b(p[0] as int);
    emit_b(p[1] as int);
    emit_b(p[2] as int);
    emit_b(p[3] as int);
}

emit_u64(v: int) {
    tmp: int = 0;
    p: *i8 = (&tmp) as *i8;
    wr64(p, 0, v);
    i: int = 0;
    while (i < 8) {
        emit_b(p[i] as int);
        i = i + 1;
    }
}

skip_bytes(n: int) {
    if (cur_sec == SEC_BSS) {
        bss_size = bss_size + n;
        return;
    }
    i: int = 0;
    while (i < n) {
        emit_b(0);
        i = i + 1;
    }
}

do_align(n: int) {
    off: int = cur_off();
    pad: int = (n - (off % n)) % n;
    skip_bytes(pad);
}

emit_rex(w: int, r: int, x: int, b: int) {
    emit_b(64 + w * 8 + r * 4 + x * 2 + b);
}

/* ---- symbols / relocs / globl ---- */

is_globl(name: *i8): bool {
    b: int = sym_bucket(hash_str(name));
    i: int = globl_buckets[b];
    while (i >= 0) {
        if (streq(globls[i], name)) { return true; }
        i = globl_next[i];
    }
    return false;
}

add_globl(name: *i8) {
    if (is_globl(name)) { return; }
    if (nglobls + 1 > globls_cap) {
        ncap: int = globls_cap * 2;
        if (ncap < 16) { ncap = 16; }
        raw: *i8 = new i8[ncap * 8];
        ng: **i8 = raw as **i8;
        nn: *int = new int[ncap];
        i: int = 0;
        while (i < nglobls) {
            ng[i] = globls[i];
            nn[i] = globl_next[i];
            i = i + 1;
        }
        globls = ng;
        globl_next = nn;
        globls_cap = ncap;
    }
    globls[nglobls] = strdup0(name);
    b: int = sym_bucket(hash_str(name));
    globl_next[nglobls] = globl_buckets[b];
    globl_buckets[b] = nglobls;
    nglobls = nglobls + 1;
}

find_sym(name: *i8): int {
    b: int = sym_bucket(hash_str(name));
    i: int = sym_buckets[b];
    while (i >= 0) {
        if (streq(syms[i].name, name)) { return i; }
        i = syms[i].hash_next;
    }
    return 0 - 1;
}

ensure_sym(name: *i8): int {
    i: int = find_sym(name);
    if (i >= 0) { return i; }
    if (nsyms + 1 > syms_cap) {
        ncap: int = syms_cap * 2;
        if (ncap < 64) { ncap = 64; }
        ns: *Sym = new Sym[ncap];
        j: int = 0;
        while (j < nsyms) {
            ns[j].name = syms[j].name;
            ns[j].val = syms[j].val;
            ns[j].sec = syms[j].sec;
            ns[j].bind = syms[j].bind;
            ns[j].defined = syms[j].defined;
            ns[j].hash_next = syms[j].hash_next;
            j = j + 1;
        }
        syms = ns;
        syms_cap = ncap;
    }
    bind: int = STB_LOCAL;
    if (is_globl(name)) { bind = STB_GLOBAL; }
    syms[nsyms].name = strdup0(name);
    syms[nsyms].val = 0;
    syms[nsyms].sec = SEC_UND;
    syms[nsyms].bind = bind;
    syms[nsyms].defined = 0;
    b: int = sym_bucket(hash_str(name));
    syms[nsyms].hash_next = sym_buckets[b];
    sym_buckets[b] = nsyms;
    nsyms = nsyms + 1;
    return nsyms - 1;
}

define_sym(name: *i8) {
    i: int = ensure_sym(name);
    syms[i].val = cur_off();
    syms[i].sec = cur_sec;
    syms[i].defined = 1;
    if (is_globl(name)) { syms[i].bind = STB_GLOBAL; }
    if (name[0] == '.' && name[1] == 'L') { syms[i].bind = STB_LOCAL; }
}

add_reloc(off: int, typ: int, name: *i8, addend: int) {
    si: int = ensure_sym(name);
    if (nrels + 1 > rels_cap) {
        ncap: int = rels_cap * 2;
        if (ncap < 64) { ncap = 64; }
        nr: *Rel = new Rel[ncap];
        j: int = 0;
        while (j < nrels) {
            nr[j].off = rels[j].off;
            nr[j].typ = rels[j].typ;
            nr[j].sym = rels[j].sym;
            nr[j].addend = rels[j].addend;
            j = j + 1;
        }
        rels = nr;
        rels_cap = ncap;
    }
    rels[nrels].off = off;
    rels[nrels].typ = typ;
    rels[nrels].sym = si;
    rels[nrels].addend = addend;
    nrels = nrels + 1;
}

patch_i32(off: int, v: int) {
    wr32(text_buf, off, v);
}

/* ---- expression parser on tokbuf-style string ---- */


expr_skip() {
    while (expr_s[expr_i] == ' ' || expr_s[expr_i] == '\t') {
        expr_i = expr_i + 1;
    }
}

parse_expr_prim(): int {
    expr_skip();
    if (expr_s[expr_i] == '(') {
        expr_i = expr_i + 1;
        v: int = parse_expr_add();
        expr_skip();
        if (expr_s[expr_i] != ')') { fail("expr )"); }
        expr_i = expr_i + 1;
        return v;
    }
    neg: int = 0;
    if (expr_s[expr_i] == '-') {
        neg = 1;
        expr_i = expr_i + 1;
    }
    expr_skip();
    if (!is_digit(expr_s[expr_i])) { fail("bad number"); }
    v2: int = 0;
    while (is_digit(expr_s[expr_i])) {
        v2 = v2 * 10 + ((expr_s[expr_i] as int) - ('0' as int));
        expr_i = expr_i + 1;
    }
    if (neg != 0) { v2 = 0 - v2; }
    return v2;
}

parse_expr_mul(): int {
    v: int = parse_expr_prim();
    while (true) {
        expr_skip();
        if (expr_s[expr_i] != '*') { return v; }
        expr_i = expr_i + 1;
        w: int = parse_expr_prim();
        v = v * w;
    }
    return v;
}

parse_expr_add(): int {
    v: int = parse_expr_mul();
    while (true) {
        expr_skip();
        c: i8 = expr_s[expr_i];
        if (c != '+' && c != '-') { return v; }
        expr_i = expr_i + 1;
        w: int = parse_expr_mul();
        if (c == '+') { v = v + w; } else { v = v - w; }
    }
    return v;
}

parse_expr(s: *i8): int {
    expr_s = s;
    expr_i = 0;
    v: int = parse_expr_add();
    expr_skip();
    if (expr_s[expr_i] != 0 trunc i8) { fail("bad expr trail"); }
    return v;
}

/* ---- register / operand parsing ---- */
/* Operand kinds stored in globals after parse_operand */



reg_code(s: *i8): int {
    if (s[0] != '%') { return 0 - 1; }
    if (s[1] == 'r') {
        if (s[2] == 'a' && s[3] == 'x' && s[4] == 0 trunc i8) { return 0; }
        if (s[2] == 'c' && s[3] == 'x' && s[4] == 0 trunc i8) { return 1; }
        if (s[2] == 'd' && s[3] == 'x' && s[4] == 0 trunc i8) { return 2; }
        if (s[2] == 'b' && s[3] == 'x' && s[4] == 0 trunc i8) { return 3; }
        if (s[2] == 's' && s[3] == 'p' && s[4] == 0 trunc i8) { return 4; }
        if (s[2] == 'b' && s[3] == 'p' && s[4] == 0 trunc i8) { return 5; }
        if (s[2] == 's' && s[3] == 'i' && s[4] == 0 trunc i8) { return 6; }
        if (s[2] == 'd' && s[3] == 'i' && s[4] == 0 trunc i8) { return 7; }
        if (s[2] == '8' && s[3] == 0 trunc i8) { return 8; }
        if (s[2] == '9' && s[3] == 0 trunc i8) { return 9; }
        if (s[2] == '1' && s[3] == '0' && s[4] == 0 trunc i8) { return 10; }
        if (s[2] == '1' && s[3] == '1' && s[4] == 0 trunc i8) { return 11; }
        if (s[2] == '1' && s[3] == '2' && s[4] == 0 trunc i8) { return 12; }
        if (s[2] == '1' && s[3] == '3' && s[4] == 0 trunc i8) { return 13; }
        if (s[2] == '1' && s[3] == '4' && s[4] == 0 trunc i8) { return 14; }
        if (s[2] == '1' && s[3] == '5' && s[4] == 0 trunc i8) { return 15; }
        if (s[2] == 'i' && s[3] == 'p' && s[4] == 0 trunc i8) { return 0 - 2; }
        return 0 - 1;
    }
    if (s[1] == 'a' && s[2] == 'l' && s[3] == 0 trunc i8) { return 0; }
    return 0 - 1;
}

save_op1_to_op2() {
    op2_kind = op_kind;
    op2_reg = op_reg;
    op2_is_al = op_is_al;
    op2_imm = op_imm;
    op2_base = op_base;
    op2_disp = op_disp;
    op2_name = op_name;
    op2_extra = op_extra;
    op2_digit = op_digit;
    op2_fb = op_fb;
}

copy_to_buf(dst: *i8, src: *i8, n: int, cap: int) {
    if (n >= cap) { fail("token too long"); }
    memcpy(dst, src, n);
    dst[n] = 0 trunc i8;
}

parse_operand(s: *i8) {
    while (s[0] == ' ' || s[0] == '\t') { s = s + 1; }
    end: int = strlen0(s);
    while (end > 0 && (s[end - 1] == ' ' || s[end - 1] == '\t')) {
        end = end - 1;
    }
    s[end] = 0 trunc i8;
    op_kind = OP_NONE;
    op_is_al = 0;
    op_extra = 0;
    if (s[0] == 0 trunc i8) { return; }
    if (s[0] == '*' && s[1] == '%') {
        r: int = reg_code(s + 1);
        if (r < 0) { fail("bad ind reg"); }
        op_kind = OP_INDREG;
        op_reg = r;
        return;
    }
    if (s[0] == '$') {
        op_kind = OP_IMM;
        op_imm = parse_expr(s + 1);
        return;
    }
    if (s[0] == '%') {
        r2: int = reg_code(s);
        if (r2 < 0) { fail("bad reg"); }
        op_kind = OP_REG;
        op_reg = r2;
        if (s[1] == 'a' && s[2] == 'l' && s[3] == 0 trunc i8) { op_is_al = 1; }
        return;
    }
    /* local Nf / Nb */
    if (is_digit(s[0])) {
        j: int = 0;
        d: int = 0;
        while (is_digit(s[j])) {
            d = d * 10 + ((s[j] as int) - ('0' as int));
            j = j + 1;
        }
        if ((s[j] == 'f' || s[j] == 'b') && s[j + 1] == 0 trunc i8) {
            if (d > 9) { fail("local label >9"); }
            op_kind = OP_LOC;
            op_digit = d;
            if (s[j] == 'f') { op_fb = 1; } else { op_fb = 0; }
            return;
        }
    }
    /* mem: xxx(yyy) */
    paren: int = 0 - 1;
    k: int = 0;
    while (s[k] != 0 trunc i8) {
        if (s[k] == '(') { paren = k; }
        k = k + 1;
    }
    if (paren >= 0 && s[k - 1] == ')') {
        copy_to_buf(mem_base_buf, s + paren + 1, k - paren - 2, 64);
        copy_to_buf(mem_disp_buf, s, paren, 512);
        base_s: *i8 = mem_base_buf;
        disp_s: *i8 = mem_disp_buf;
        if (base_s[0] == '%' && base_s[1] == 'r' && base_s[2] == 'i' && base_s[3] == 'p' && base_s[4] == 0 trunc i8) {
            if (disp_s[0] == 0 trunc i8) { fail("bare (%rip)"); }
            plus: int = 0 - 1;
            t: int = 0;
            while (disp_s[t] != 0 trunc i8) {
                if (disp_s[t] == '+') { plus = t; }
                t = t + 1;
            }
            if (plus >= 0) {
                copy_to_buf(mem_name_buf, disp_s, plus, 512);
                op_name = mem_name_buf;
                op_extra = parse_expr(disp_s + plus + 1);
            } else {
                op_name = disp_s;
                op_extra = 0;
            }
            op_kind = OP_MEMRIP;
            return;
        }
        br: int = reg_code(base_s);
        if (br < 0) { fail("bad mem base"); }
        op_base = br;
        if (disp_s[0] == 0 trunc i8) {
            op_kind = OP_MEM;
            op_disp = 0;
            return;
        }
        ti: int = 0;
        if (disp_s[0] == '-') { ti = 1; }
        allnum: int = 1;
        if (disp_s[ti] == 0 trunc i8) { allnum = 0; }
        while (disp_s[ti] != 0 trunc i8) {
            if (!is_digit(disp_s[ti])) { allnum = 0; }
            ti = ti + 1;
        }
        if (allnum != 0) {
            op_kind = OP_MEM;
            op_disp = parse_expr(disp_s);
            return;
        }
        si: int = find_sym(disp_s);
        if (si >= 0 && syms[si].defined != 0 && syms[si].sec == SEC_ABS) {
            op_kind = OP_MEM;
            op_disp = syms[si].val;
            return;
        }
        op_kind = OP_MEMABS;
        op_name = disp_s;
        return;
    }
    if (is_ident_start(s[0])) {
        op_kind = OP_SYM;
        op_name = s;
        return;
    }
    fail("bad operand");
}

/* ---- ModRM memory emit ---- */

emit_modrm_mem(reg: int, base: int, disp: int, rip: int) {
    if (rip != 0) {
        emit_b(0 + (reg % 8) * 8 + 5);
        emit_i32(disp);
        return;
    }
    need_sib: int = 0;
    if ((base % 8) == 4) { need_sib = 1; }
    mod: int = 0;
    if (disp == 0 && (base % 8) != 5) {
        mod = 0;
    } else {
        if (fits_imm8(disp)) { mod = 1; } else { mod = 2; }
    }
    if ((base % 8) == 5 && disp == 0) { mod = 1; }
    if (need_sib != 0) {
        emit_b(mod * 64 + (reg % 8) * 8 + 4);
        emit_b(0 + 4 * 8 + (base % 8));
    } else {
        emit_b(mod * 64 + (reg % 8) * 8 + (base % 8));
    }
    if (mod == 1) { emit_b(disp); }
    if (mod == 2) { emit_i32(disp); }
}

/* ---- instruction pieces ---- */

emit_push(r: int) {
    if (r >= 8) { emit_b(65); emit_b(80 + (r % 8)); }
    else { emit_b(80 + r); }
}

emit_pop(r: int) {
    if (r >= 8) { emit_b(65); emit_b(88 + (r % 8)); }
    else { emit_b(88 + r); }
}

emit_mov_rr(src: int, dst: int) {
    emit_rex(1, (src / 8) % 2, 0, (dst / 8) % 2);
    emit_b(137);
    emit_b(192 + (src % 8) * 8 + (dst % 8));
}

emit_mov_rm(src: int, base: int, disp: int, rip: int, name: *i8, extra: int) {
    rb: int = 0;
    if (rip == 0) { rb = (base / 8) % 2; }
    emit_rex(1, (src / 8) % 2, 0, rb);
    emit_b(137);
    if (rip != 0) {
        off: int = cur_off() + 1;
        emit_modrm_mem(src, 0, 0, 1);
        add_reloc(off, R_X86_64_PC32, name, extra - 4);
    } else {
        emit_modrm_mem(src, base, disp, 0);
    }
}

emit_mov_mr(dst: int, base: int, disp: int, rip: int, name: *i8, extra: int) {
    rb: int = 0;
    if (rip == 0) { rb = (base / 8) % 2; }
    emit_rex(1, (dst / 8) % 2, 0, rb);
    emit_b(139);
    if (rip != 0) {
        off: int = cur_off() + 1;
        emit_modrm_mem(dst, 0, 0, 1);
        add_reloc(off, R_X86_64_PC32, name, extra - 4);
    } else {
        emit_modrm_mem(dst, base, disp, 0);
    }
}

emit_mov_imm_r(imm: int, dst: int) {
    emit_rex(1, 0, 0, (dst / 8) % 2);
    emit_b(199);
    emit_b(192 + (dst % 8));
    emit_i32(imm);
}

emit_lea(dst: int, base: int, disp: int, rip: int, name: *i8, extra: int) {
    rb: int = 0;
    if (rip == 0) { rb = (base / 8) % 2; }
    emit_rex(1, (dst / 8) % 2, 0, rb);
    emit_b(141);
    if (rip != 0) {
        off: int = cur_off() + 1;
        emit_modrm_mem(dst, 0, 0, 1);
        add_reloc(off, R_X86_64_PC32, name, extra - 4);
    } else {
        emit_modrm_mem(dst, base, disp, 0);
    }
}

emit_alu_imm(op_ext: int, imm: int, dst: int, rax_opc: int) {
    if (fits_imm8(imm)) {
        emit_rex(1, 0, 0, (dst / 8) % 2);
        emit_b(131);
        emit_b(192 + op_ext * 8 + (dst % 8));
        emit_b(imm);
    } else {
        if (dst == 0 && rax_opc >= 0) {
            emit_rex(1, 0, 0, 0);
            emit_b(rax_opc);
            emit_i32(imm);
        } else {
            emit_rex(1, 0, 0, (dst / 8) % 2);
            emit_b(129);
            emit_b(192 + op_ext * 8 + (dst % 8));
            emit_i32(imm);
        }
    }
}

emit_alu_rr(opc: int, src: int, dst: int) {
    emit_rex(1, (src / 8) % 2, 0, (dst / 8) % 2);
    emit_b(opc);
    emit_b(192 + (src % 8) * 8 + (dst % 8));
}

define_loc(digit: int) {
    off: int = cur_off();
    loc_last_sec[digit] = cur_sec;
    loc_last_off[digit] = off;
    loc_defined[digit] = 1;
    i: int = 0;
    while (i < nloc_patches) {
        if (loc_patches[i].digit == digit) {
            if (cur_sec != SEC_TEXT) { fail("loc label not in text"); }
            disp: int = off - loc_patches[i].next_ip;
            patch_i32(loc_patches[i].off, disp);
            loc_patches[i].digit = 0 - 1;
        }
        i = i + 1;
    }
}

/* jump helpers use pending fields */

do_jump_target() {
    if (op_kind == OP_LOC) {
        if (op_fb == 0) {
            if (loc_defined[op_digit] == 0) { fail("no local Nb"); }
            if (loc_last_sec[op_digit] != SEC_TEXT) { fail("loc cross-sec"); }
            disp: int = loc_last_off[op_digit] - jmp_next_ip;
            patch_i32(jmp_rel_off, disp);
            return;
        }
        if (nloc_patches + 1 > loc_patches_cap) {
            ncap: int = loc_patches_cap * 2;
            if (ncap < 16) { ncap = 16; }
            np: *LocPatch = new LocPatch[ncap];
            j: int = 0;
            while (j < nloc_patches) {
                np[j].off = loc_patches[j].off;
                np[j].next_ip = loc_patches[j].next_ip;
                np[j].digit = loc_patches[j].digit;
                j = j + 1;
            }
            loc_patches = np;
            loc_patches_cap = ncap;
        }
        loc_patches[nloc_patches].off = jmp_rel_off;
        loc_patches[nloc_patches].next_ip = jmp_next_ip;
        loc_patches[nloc_patches].digit = op_digit;
        nloc_patches = nloc_patches + 1;
        return;
    }
    if (op_kind != OP_SYM) { fail("bad jump target"); }
    /* Always reloc — enables single-pass assembly. */
    add_reloc(jmp_rel_off, R_X86_64_PLT32, op_name, 0 - 4);
}

emit_call() {
    emit_b(232);
    jmp_rel_off = cur_off();
    emit_i32(0);
    jmp_next_ip = cur_off();
    do_jump_target();
}

emit_jmp_sym() {
    emit_b(233);
    jmp_rel_off = cur_off();
    emit_i32(0);
    jmp_next_ip = cur_off();
    do_jump_target();
}

emit_jcc(cc: int) {
    emit_b(15);
    emit_b(128 + cc);
    jmp_rel_off = cur_off();
    emit_i32(0);
    jmp_next_ip = cur_off();
    do_jump_target();
}

/* ---- split operands by comma ---- */

split_ops(args: *i8) {
    n_ops = 0;
    op_a = op_a_buf;
    op_b = op_b_buf;
    op_a_buf[0] = 0 trunc i8;
    op_b_buf[0] = 0 trunc i8;
    while (args[0] == ' ' || args[0] == '\t') { args = args + 1; }
    if (args[0] == 0 trunc i8) { return; }
    depth: int = 0;
    i: int = 0;
    start: int = 0;
    while (args[i] != 0 trunc i8) {
        if (args[i] == '(') { depth = depth + 1; }
        if (args[i] == ')') { depth = depth - 1; }
        if (args[i] == ',' && depth == 0) {
            copy_to_buf(op_a_buf, args + start, i - start, 512);
            n_ops = 1;
            start = i + 1;
            i = i + 1;
            while (args[i] != 0 trunc i8) { i = i + 1; }
            copy_to_buf(op_b_buf, args + start, i - start, 512);
            n_ops = 2;
            return;
        }
        i = i + 1;
    }
    copy_to_buf(op_a_buf, args, i, 512);
    n_ops = 1;
}

insn(mnem: *i8, args: *i8) {
    split_ops(args);
    if (n_ops >= 1) { parse_operand(op_a); }
    if (n_ops >= 2) {
        save_op1_to_op2();
        parse_operand(op_b);
        /* now op_* is second, op2_* is first — swap naming: AT&T src,dst
           So first operand = op2, second = op */
    }

    if (streq(mnem, "push") && n_ops == 1 && op_kind == OP_REG) {
        emit_push(op_reg); return;
    }
    if (streq(mnem, "pop") && n_ops == 1 && op_kind == OP_REG) {
        emit_pop(op_reg); return;
    }
    if (streq(mnem, "ret")) { emit_b(195); return; }
    if (streq(mnem, "syscall")) { emit_b(15); emit_b(5); return; }
    if (streq(mnem, "cqo")) { emit_b(72); emit_b(153); return; }
    if (streq(mnem, "neg") && op_kind == OP_REG) {
        emit_rex(1, 0, 0, (op_reg / 8) % 2);
        emit_b(247);
        emit_b(216 + (op_reg % 8));
        return;
    }
    if (streq(mnem, "idiv") && op_kind == OP_REG) {
        emit_rex(1, 0, 0, (op_reg / 8) % 2);
        emit_b(247);
        emit_b(248 + (op_reg % 8));
        return;
    }
    if (streq(mnem, "test") && n_ops == 2 && op2_kind == OP_REG && op_kind == OP_REG) {
        emit_rex(1, (op2_reg / 8) % 2, 0, (op_reg / 8) % 2);
        emit_b(133);
        emit_b(192 + (op2_reg % 8) * 8 + (op_reg % 8));
        return;
    }
    if (streq(mnem, "sete")) { emit_b(15); emit_b(148); emit_b(192); return; }
    if (streq(mnem, "setne")) { emit_b(15); emit_b(149); emit_b(192); return; }
    if (streq(mnem, "setl")) { emit_b(15); emit_b(156); emit_b(192); return; }
    if (streq(mnem, "setle")) { emit_b(15); emit_b(158); emit_b(192); return; }
    if (streq(mnem, "setg")) { emit_b(15); emit_b(159); emit_b(192); return; }
    if (streq(mnem, "setge")) { emit_b(15); emit_b(157); emit_b(192); return; }

    if (streq(mnem, "call") && n_ops == 1) {
        /* target in op_* */
        emit_call(); return;
    }
    if (streq(mnem, "jmp") && n_ops == 1) {
        if (op_kind == OP_INDREG) {
            if (op_reg >= 8) {
                emit_b(65); emit_b(255); emit_b(224 + (op_reg % 8));
            } else {
                emit_b(255); emit_b(224 + op_reg);
            }
            return;
        }
        emit_jmp_sym(); return;
    }
    if (streq(mnem, "je") || streq(mnem, "jz")) { emit_jcc(4); return; }
    if (streq(mnem, "jne")) { emit_jcc(5); return; }
    if (streq(mnem, "ja")) { emit_jcc(7); return; }

    if (streq(mnem, "movzb")) {
        /* op2=src, op=dst */
        dst: int = op_reg;
        if (op2_kind == OP_REG) {
            emit_rex(1, (dst / 8) % 2, 0, (op2_reg / 8) % 2);
            emit_b(15); emit_b(182);
            emit_b(192 + (dst % 8) * 8 + (op2_reg % 8));
        } else {
            if (op2_kind == OP_MEM) {
                emit_rex(1, (dst / 8) % 2, 0, (op2_base / 8) % 2);
                emit_b(15); emit_b(182);
                emit_modrm_mem(dst, op2_base, op2_disp, 0);
            } else { fail("movzb"); }
        }
        return;
    }

    if (streq(mnem, "movb")) {
        imm: int = op2_imm;
        if (op_kind == OP_MEM) {
            if ((op_base / 8) % 2 != 0) { emit_b(65); }
            emit_b(198);
            emit_modrm_mem(0, op_base, op_disp, 0);
            emit_b(imm);
        } else { fail("movb"); }
        return;
    }

    if (streq(mnem, "movq")) {
        imm2: int = op2_imm;
        if (op_kind == OP_MEM) {
            emit_rex(1, 0, 0, (op_base / 8) % 2);
            emit_b(199);
            emit_modrm_mem(0, op_base, op_disp, 0);
            emit_i32(imm2);
        } else {
            if (op_kind == OP_MEMRIP) {
                emit_rex(1, 0, 0, 0);
                emit_b(199);
                off: int = cur_off() + 1;
                emit_modrm_mem(0, 0, 0, 1);
                add_reloc(off, R_X86_64_PC32, op_name, op_extra - 8);
                emit_i32(imm2);
            } else { fail("movq"); }
        }
        return;
    }

    if (streq(mnem, "mov")) {
        /* op2=src, op=dst */
        if (op2_kind == OP_IMM && op_kind == OP_REG) {
            emit_mov_imm_r(op2_imm, op_reg); return;
        }
        if (op2_kind == OP_REG && op_kind == OP_REG) {
            emit_mov_rr(op2_reg, op_reg); return;
        }
        if (op2_kind == OP_REG && op2_is_al != 0 && op_kind == OP_MEM) {
            if ((op_base / 8) % 2 != 0) { emit_b(65); }
            emit_b(136);
            emit_modrm_mem(0, op_base, op_disp, 0);
            return;
        }
        if (op2_kind == OP_REG && op_kind == OP_MEM) {
            emit_mov_rm(op2_reg, op_base, op_disp, 0, "", 0); return;
        }
        if (op2_kind == OP_REG && op_kind == OP_MEMRIP) {
            emit_mov_rm(op2_reg, 0, 0, 1, op_name, op_extra); return;
        }
        if (op2_kind == OP_MEM && op_kind == OP_REG) {
            emit_mov_mr(op_reg, op2_base, op2_disp, 0, "", 0); return;
        }
        if (op2_kind == OP_MEMRIP && op_kind == OP_REG) {
            emit_mov_mr(op_reg, 0, 0, 1, op2_name, op2_extra); return;
        }
        fail("mov form");
    }

    if (streq(mnem, "lea")) {
        if (op2_kind == OP_MEM && op_kind == OP_REG) {
            emit_lea(op_reg, op2_base, op2_disp, 0, "", 0); return;
        }
        if (op2_kind == OP_MEMABS && op_kind == OP_REG) {
            si: int = find_sym(op2_name);
            if (si < 0 || syms[si].sec != SEC_ABS) { fail("lea abs"); }
            emit_lea(op_reg, op2_base, syms[si].val, 0, "", 0); return;
        }
        if (op2_kind == OP_MEMRIP && op_kind == OP_REG) {
            emit_lea(op_reg, 0, 0, 1, op2_name, op2_extra); return;
        }
        fail("lea form");
    }

    if (streq(mnem, "add")) {
        if (op2_kind == OP_IMM && op_kind == OP_REG) {
            emit_alu_imm(0, op2_imm, op_reg, 5); return;
        }
        if (op2_kind == OP_REG && op_kind == OP_REG) {
            emit_alu_rr(1, op2_reg, op_reg); return;
        }
        fail("add");
    }
    if (streq(mnem, "sub")) {
        if (op2_kind == OP_IMM && op_kind == OP_REG) {
            emit_alu_imm(5, op2_imm, op_reg, 45); return;
        }
        if (op2_kind == OP_REG && op_kind == OP_REG) {
            emit_alu_rr(41, op2_reg, op_reg); return;
        }
        fail("sub");
    }
    if (streq(mnem, "and")) {
        if (op2_kind == OP_IMM && op_kind == OP_REG) {
            emit_alu_imm(4, op2_imm, op_reg, 37); return;
        }
        fail("and");
    }
    if (streq(mnem, "cmp")) {
        if (op2_kind == OP_IMM && op_kind == OP_REG) {
            emit_alu_imm(7, op2_imm, op_reg, 61); return;
        }
        if (op2_kind == OP_REG && op_kind == OP_REG) {
            emit_alu_rr(57, op2_reg, op_reg); return;
        }
        if (op2_kind == OP_MEMRIP && op_kind == OP_REG) {
            emit_rex(1, (op_reg / 8) % 2, 0, 0);
            emit_b(59);
            off2: int = cur_off() + 1;
            emit_modrm_mem(op_reg, 0, 0, 1);
            add_reloc(off2, R_X86_64_PC32, op2_name, op2_extra - 4);
            return;
        }
        fail("cmp");
    }
    if (streq(mnem, "imul")) {
        if (n_ops == 2 && op2_kind == OP_IMM && op_kind == OP_REG) {
            dst2: int = op_reg;
            imm3: int = op2_imm;
            rb: int = (dst2 / 8) % 2;
            emit_rex(1, rb, 0, rb);
            if (fits_imm8(imm3)) {
                emit_b(107);
                emit_b(192 + (dst2 % 8) * 8 + (dst2 % 8));
                emit_b(imm3);
            } else {
                emit_b(105);
                emit_b(192 + (dst2 % 8) * 8 + (dst2 % 8));
                emit_i32(imm3);
            }
            return;
        }
        if (n_ops == 2 && op2_kind == OP_REG && op_kind == OP_REG) {
            emit_rex(1, (op_reg / 8) % 2, 0, (op2_reg / 8) % 2);
            emit_b(15); emit_b(175);
            emit_b(192 + (op_reg % 8) * 8 + (op2_reg % 8));
            return;
        }
        fail("imul");
    }
    fail("unknown instruction");
}

directive(line: *i8) {
    /* line starts with . */
    i: int = 0;
    while (line[i] != 0 trunc i8 && line[i] != ' ' && line[i] != '\t') {
        i = i + 1;
    }
    copy_to_buf(tokbuf, line, i, 1024);
    dname: *i8 = tokbuf;
    while (line[i] == ' ' || line[i] == '\t') { i = i + 1; }
    arg: *i8 = line + i;
    if (streq(dname, ".section")) {
        j: int = 0;
        while (arg[j] != 0 trunc i8 && arg[j] != ' ' && arg[j] != '\t') { j = j + 1; }
        saved: i8 = arg[j];
        arg[j] = 0 trunc i8;
        if (streq(arg, ".text")) { cur_sec = SEC_TEXT; }
        else {
            if (streq(arg, ".rodata")) { cur_sec = SEC_RODATA; }
            else {
                if (streq(arg, ".data")) { cur_sec = SEC_DATA; }
                else {
                    if (streq(arg, ".bss")) { cur_sec = SEC_BSS; }
                    else { fail("bad section"); }
                }
            }
        }
        arg[j] = saved;
        return;
    }
    if (streq(dname, ".align")) {
        do_align(parse_expr(arg));
        return;
    }
    if (streq(dname, ".globl")) {
        j3: int = 0;
        while (arg[j3] != 0 trunc i8 && arg[j3] != ' ' && arg[j3] != '\t') { j3 = j3 + 1; }
        savedg: i8 = arg[j3];
        arg[j3] = 0 trunc i8;
        add_globl(arg);
        gi: int = find_sym(arg);
        if (gi >= 0) { syms[gi].bind = STB_GLOBAL; }
        arg[j3] = savedg;
        return;
    }
    if (streq(dname, ".equ")) {
        /* NAME, EXPR */
        cpos: int = 0;
        while (arg[cpos] != 0 trunc i8 && arg[cpos] != ',') { cpos = cpos + 1; }
        if (arg[cpos] != ',') { fail(".equ"); }
        nm: *i8 = strdup_n(arg, cpos);
        /* trim name */
        while (nm[0] == ' ') { nm = nm + 1; }
        ne: int = strlen0(nm);
        while (ne > 0 && nm[ne - 1] == ' ') { ne = ne - 1; }
        nm = strdup_n(nm, ne);
        val: int = parse_expr(arg + cpos + 1);
        si: int = ensure_sym(nm);
        syms[si].val = val;
        syms[si].sec = SEC_ABS;
        syms[si].defined = 1;
        return;
    }
    if (streq(dname, ".quad")) {
        emit_u64(parse_expr(arg));
        return;
    }
    if (streq(dname, ".byte")) {
        p: int = 0;
        while (true) {
            while (arg[p] == ' ' || arg[p] == '\t') { p = p + 1; }
            if (arg[p] == 0 trunc i8) { return; }
            start: int = p;
            while (arg[p] != 0 trunc i8 && arg[p] != ',') { p = p + 1; }
            savedb: i8 = arg[p];
            arg[p] = 0 trunc i8;
            emit_b(parse_expr(arg + start));
            arg[p] = savedb;
            if (arg[p] == 0 trunc i8) { return; }
            p = p + 1;
        }
        return;
    }
    if (streq(dname, ".skip")) {
        skip_bytes(parse_expr(arg));
        return;
    }
    fail("unknown directive");
}

handle_line(raw_line: *i8) {
    line: *i8 = raw_line;
    i: int = 0;
    done: int = 0;
    while (done == 0 && line[i] != 0 trunc i8) {
        if (line[i] == 35 trunc i8) {
            line[i] = 0 trunc i8;
            done = 1;
        } else {
            i = i + 1;
        }
    }
    while (line[0] == ' ' || line[0] == '\t') { line = line + 1; }
    if (line[0] == 0 trunc i8) { return; }
    /* labels */
    more_labels: int = 1;
    while (more_labels != 0) {
        took: int = 0;
        if (is_digit(line[0])) {
            j: int = 0;
            d: int = 0;
            while (is_digit(line[j])) {
                d = d * 10 + ((line[j] as int) - ('0' as int));
                j = j + 1;
            }
            if (line[j] == ':') {
                if (d > 9) { fail("local label >9"); }
                define_loc(d);
                line = line + j + 1;
                while (line[0] == ' ' || line[0] == '\t') { line = line + 1; }
                if (line[0] == 0 trunc i8) { return; }
                took = 1;
            }
        }
        if (took == 0 && is_ident_start(line[0])) {
            j2: int = 0;
            while (is_ident(line[j2])) { j2 = j2 + 1; }
            if (line[j2] == ':') {
                saved: i8 = line[j2];
                line[j2] = 0 trunc i8;
                define_sym(line);
                line[j2] = saved;
                line = line + j2 + 1;
                while (line[0] == ' ' || line[0] == '\t') { line = line + 1; }
                if (line[0] == 0 trunc i8) { return; }
                took = 1;
            }
        }
        if (took == 0) { more_labels = 0; }
    }
    if (line[0] == '.') {
        directive(line);
        return;
    }
    m: int = 0;
    while (line[m] != 0 trunc i8 && line[m] != ' ' && line[m] != '\t') { m = m + 1; }
    copy_to_buf(tokbuf, line, m, 1024);
    while (line[m] == ' ' || line[m] == '\t') { m = m + 1; }
    insn(tokbuf, line + m);
}

reset_buffers() {
    text_len = 0;
    rodata_len = 0;
    data_len = 0;
    bss_size = 0;
    cur_sec = SEC_TEXT;
    nloc_patches = 0;
    di: int = 0;
    while (di < 10) {
        loc_defined[di] = 0;
        di = di + 1;
    }
}

assemble_buf(buf: *i8, n: int) {
    pass_no = 1;
    reset_buffers();
    nrels = 0;
    pos: int = 0;
    while (pos < n) {
        start: int = pos;
        while (pos < n && buf[pos] != '\n') { pos = pos + 1; }
        saved: i8 = buf[pos];
        buf[pos] = 0 trunc i8;
        handle_line(buf + start);
        buf[pos] = saved;
        if (pos < n) { pos = pos + 1; }
    }
    pi: int = 0;
    while (pi < nloc_patches) {
        if (loc_patches[pi].digit >= 0) { fail("undefined local label"); }
        pi = pi + 1;
    }
}


is_dash_o(s: *i8): bool {
    return s[0] == '-' && s[1] == 'o' && s[2] == 0 trunc i8;
}





str_add(s: *i8): int {
    n: int = strlen0(s);
    if (strtab_len + n + 1 > strtab_cap) {
        ncap: int = strtab_cap * 2;
        while (strtab_len + n + 1 > ncap) { ncap = ncap * 2; }
        nb: *i8 = new i8[ncap];
        memcpy(nb, strtab_buf, strtab_len);
        strtab_buf = nb;
        strtab_cap = ncap;
    }
    off: int = strtab_len;
    memcpy(strtab_buf + strtab_len, s, n);
    strtab_len = strtab_len + n;
    strtab_buf[strtab_len] = 0 trunc i8;
    strtab_len = strtab_len + 1;
    return off;
}


build_shstr(buf: *i8): int {
    raw: *i8 = new i8[64];
    names: **i8 = raw as **i8;
    names[0] = ".text";
    names[1] = ".rela.text";
    names[2] = ".data";
    names[3] = ".bss";
    names[4] = ".rodata";
    names[5] = ".symtab";
    names[6] = ".strtab";
    names[7] = ".shstrtab";
    buf[0] = 0 trunc i8;
    pos: int = 1;
    i: int = 0;
    while (i < 8) {
        n: int = strlen0(names[i]);
        memcpy(buf + pos, names[i], n);
        pos = pos + n;
        buf[pos] = 0 trunc i8;
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

sh_name_off(shstr: *i8, shstr_len: int, name: *i8): int {
    nlen: int = strlen0(name);
    i: int = 0;
    while (i < shstr_len) {
        if (i == 0 || shstr[i - 1] == 0 trunc i8) {
            j: int = 0;
            ok: int = 1;
            while (j < nlen) {
                if (shstr[i + j] != name[j]) { ok = 0; }
                j = j + 1;
            }
            if (ok != 0 && shstr[i + nlen] == 0 trunc i8) { return i; }
        }
        i = i + 1;
    }
    fail("sh name");
    return 0;
}



write_one_sh() {
    sh: int = sh_base + sh_idx * 64;
    wr32(sh_out, sh + 0, sh_nm);
    wr32(sh_out, sh + 4, sh_typ);
    wr64(sh_out, sh + 8, sh_flags);
    wr64(sh_out, sh + 16, 0);
    wr64(sh_out, sh + 24, sh_offset);
    wr64(sh_out, sh + 32, sh_size);
    wr32(sh_out, sh + 40, sh_link);
    wr32(sh_out, sh + 44, sh_info);
    wr64(sh_out, sh + 48, sh_align);
    wr64(sh_out, sh + 56, sh_entsize);
}

write_object(path: *i8) {
    gi: int = 0;
    while (gi < nglobls) {
        si: int = find_sym(globls[gi]);
        if (si >= 0) { syms[si].bind = STB_GLOBAL; }
        gi = gi + 1;
    }

    strtab_cap = 8192;
    strtab_buf = new i8[strtab_cap];
    strtab_len = 1;
    strtab_buf[0] = 0 trunc i8;

    order: *int = new int[nsyms + 1];
    norder: int = 0;
    first_global: int = 1;
    phase: int = 0;
    while (phase < 3) {
        i: int = 0;
        while (i < nsyms) {
            take: int = 0;
            if (phase == 0 && syms[i].defined != 0 && syms[i].bind == STB_LOCAL) { take = 1; }
            if (phase == 1 && syms[i].defined != 0 && syms[i].bind == STB_GLOBAL) { take = 1; }
            if (phase == 2 && syms[i].defined == 0) { take = 1; }
            if (take != 0) {
                order[norder] = i;
                norder = norder + 1;
            }
            i = i + 1;
        }
        if (phase == 0) { first_global = 1 + norder; }
        phase = phase + 1;
    }

    new_index: *int = new int[nsyms + 1];
    zi: int = 0;
    while (zi < nsyms) { new_index[zi] = 0; zi = zi + 1; }

    symtab_sz: int = (norder + 1) * 24;
    symtab: *i8 = new i8[symtab_sz];
    memset0(symtab, symtab_sz);

    oi: int = 0;
    while (oi < norder) {
        si2: int = order[oi];
        new_index[si2] = oi + 1;
        no: int = str_add(syms[si2].name);
        st_info: int = syms[si2].bind * 16;
        shndx: int = 0;
        val: int = 0;
        if (syms[si2].defined != 0) {
            val = syms[si2].val;
            if (syms[si2].sec == SEC_ABS) { shndx = SHN_ABS; }
            if (syms[si2].sec == SEC_TEXT) { shndx = 1; }
            if (syms[si2].sec == SEC_DATA) { shndx = 3; }
            if (syms[si2].sec == SEC_BSS) { shndx = 4; }
            if (syms[si2].sec == SEC_RODATA) { shndx = 5; }
        }
        so: int = (oi + 1) * 24;
        wr32(symtab, so, no);
        symtab[so + 4] = u8(st_info);
        wr16(symtab, so + 6, shndx);
        wr64(symtab, so + 8, val);
        oi = oi + 1;
    }

    rela_sz: int = nrels * 24;
    rela: *i8 = new i8[rela_sz + 1];
    memset0(rela, rela_sz + 1);
    rj: int = 0;
    while (rj < nrels) {
        ro: int = rj * 24;
        wr64(rela, ro, rels[rj].off);
        si3: int = new_index[rels[rj].sym];
        r_info: int = si3 * 4294967296 + rels[rj].typ;
        wr64(rela, ro + 8, r_info);
        wr64(rela, ro + 16, rels[rj].addend);
        rj = rj + 1;
    }

    shstr: *i8 = new i8[128];
    shstr_len: int = build_shstr(shstr);

    off: int = 64;
    text_off: int = off;
    off = off + text_len;
    off = align_up(off, 8);
    rod_off: int = off;
    off = off + rodata_len;
    dat_off: int = off;
    off = off + data_len;
    bss_off: int = off;
    off = align_up(off, 8);
    sym_off: int = off;
    off = off + symtab_sz;
    str_off: int = off;
    off = off + strtab_len;
    off = align_up(off, 8);
    rela_off: int = off;
    off = off + rela_sz;
    shstr_off: int = off;
    off = off + shstr_len;
    off = align_up(off, 8);
    shoff: int = off;
    shnum: int = 9;
    file_end: int = shoff + shnum * 64;

    out: *i8 = new i8[file_end];
    memset0(out, file_end);

    out[0] = 127 trunc i8;
    out[1] = 'E';
    out[2] = 'L';
    out[3] = 'F';
    out[4] = 2 trunc i8;
    out[5] = 1 trunc i8;
    out[6] = 1 trunc i8;
    wr16(out, 16, ET_REL);
    wr16(out, 18, EM_X86_64);
    wr32(out, 20, 1);
    wr64(out, 40, shoff);
    wr16(out, 52, 64);
    wr16(out, 58, 64);
    wr16(out, 60, shnum);
    wr16(out, 62, 8);

    memcpy(out + text_off, text_buf, text_len);
    if (rodata_len > 0) { memcpy(out + rod_off, rodata_buf, rodata_len); }
    if (data_len > 0) { memcpy(out + dat_off, data_buf, data_len); }
    memcpy(out + sym_off, symtab, symtab_sz);
    memcpy(out + str_off, strtab_buf, strtab_len);
    if (rela_sz > 0) { memcpy(out + rela_off, rela, rela_sz); }
    memcpy(out + shstr_off, shstr, shstr_len);

    sh_out = out;
    sh_base = shoff;

    sh_idx = 0; sh_nm = 0; sh_typ = SHT_NULL; sh_flags = 0; sh_offset = 0; sh_size = 0; sh_link = 0; sh_info = 0; sh_align = 0; sh_entsize = 0;
    write_one_sh();
    sh_idx = 1; sh_nm = sh_name_off(shstr, shstr_len, ".text"); sh_typ = SHT_PROGBITS; sh_flags = SHF_ALLOC + SHF_EXECINSTR; sh_offset = text_off; sh_size = text_len; sh_link = 0; sh_info = 0; sh_align = 1; sh_entsize = 0;
    write_one_sh();
    sh_idx = 2; sh_nm = sh_name_off(shstr, shstr_len, ".rela.text"); sh_typ = SHT_RELA; sh_flags = SHF_INFO_LINK; sh_offset = rela_off; sh_size = rela_sz; sh_link = 6; sh_info = 1; sh_align = 8; sh_entsize = 24;
    write_one_sh();
    sh_idx = 3; sh_nm = sh_name_off(shstr, shstr_len, ".data"); sh_typ = SHT_PROGBITS; sh_flags = SHF_ALLOC + SHF_WRITE; sh_offset = dat_off; sh_size = data_len; sh_link = 0; sh_info = 0; sh_align = 1; sh_entsize = 0;
    write_one_sh();
    sh_idx = 4; sh_nm = sh_name_off(shstr, shstr_len, ".bss"); sh_typ = SHT_NOBITS; sh_flags = SHF_ALLOC + SHF_WRITE; sh_offset = bss_off; sh_size = bss_size; sh_link = 0; sh_info = 0; sh_align = 8; sh_entsize = 0;
    write_one_sh();
    sh_idx = 5; sh_nm = sh_name_off(shstr, shstr_len, ".rodata"); sh_typ = SHT_PROGBITS; sh_flags = SHF_ALLOC; sh_offset = rod_off; sh_size = rodata_len; sh_link = 0; sh_info = 0; sh_align = 8; sh_entsize = 0;
    write_one_sh();
    sh_idx = 6; sh_nm = sh_name_off(shstr, shstr_len, ".symtab"); sh_typ = SHT_SYMTAB; sh_flags = 0; sh_offset = sym_off; sh_size = symtab_sz; sh_link = 7; sh_info = first_global; sh_align = 8; sh_entsize = 24;
    write_one_sh();
    sh_idx = 7; sh_nm = sh_name_off(shstr, shstr_len, ".strtab"); sh_typ = SHT_STRTAB; sh_flags = 0; sh_offset = str_off; sh_size = strtab_len; sh_link = 0; sh_info = 0; sh_align = 1; sh_entsize = 0;
    write_one_sh();
    sh_idx = 8; sh_nm = sh_name_off(shstr, shstr_len, ".shstrtab"); sh_typ = SHT_STRTAB; sh_flags = 0; sh_offset = shstr_off; sh_size = shstr_len; sh_link = 0; sh_info = 0; sh_align = 1; sh_entsize = 0;
    write_one_sh();

    flags: int = O_WRONLY + O_CREAT + O_TRUNC;
    ofd: int = open(path, flags, MODE_755);
    if (ofd < 0) { fail("cannot create output"); }
    w: int = 0;
    while (w < file_end) {
        chunk: int = file_end - w;
        if (chunk > 65536) { chunk = 65536; }
        wn: int = write(ofd, out + w, chunk);
        if (wn <= 0) { fail("write failed"); }
        w = w + wn;
    }
    close(ofd);
}

main(argc: int, argv: **i8): int {
    O_RDONLY = 0;
    O_WRONLY = 1;
    O_CREAT = 64;
    O_TRUNC = 512;
    MODE_755 = 493;
    ET_REL = 1;
    EM_X86_64 = 62;
    SHN_ABS = 65521;
    SHT_NULL = 0;
    SHT_PROGBITS = 1;
    SHT_SYMTAB = 2;
    SHT_STRTAB = 3;
    SHT_RELA = 4;
    SHT_NOBITS = 8;
    SHF_WRITE = 1;
    SHF_ALLOC = 2;
    SHF_EXECINSTR = 4;
    SHF_INFO_LINK = 64;
    R_X86_64_PC32 = 2;
    R_X86_64_PLT32 = 4;
    STB_LOCAL = 0;
    STB_GLOBAL = 1;
    SEC_UND = 0;
    SEC_TEXT = 1;
    SEC_RODATA = 2;
    SEC_DATA = 3;
    SEC_BSS = 4;
    SEC_ABS = 5;
    OP_NONE = 0;
    OP_REG = 1;
    OP_IMM = 2;
    OP_MEM = 3;
    OP_MEMRIP = 4;
    OP_MEMABS = 5;
    OP_SYM = 6;
    OP_LOC = 7;
    OP_INDREG = 8;

    text_cap = 256;
    text_buf = new i8[text_cap];
    text_len = 0;
    rodata_cap = 256;
    rodata_buf = new i8[rodata_cap];
    rodata_len = 0;
    data_cap = 256;
    data_buf = new i8[data_cap];
    data_len = 0;
    bss_size = 0;
    syms_cap = 64;
    syms = new Sym[syms_cap];
    nsyms = 0;
    SYM_BUCKETS = 1024;
    sym_buckets = new int[SYM_BUCKETS];
    globl_buckets = new int[SYM_BUCKETS];
    clear_sym_buckets();
    rels_cap = 64;
    rels = new Rel[rels_cap];
    nrels = 0;
    globls_cap = 16;
    grow: *i8 = new i8[globls_cap * 8];
    globls = grow as **i8;
    globl_next = new int[globls_cap];
    nglobls = 0;
    loc_last_sec = new int[10];
    loc_last_off = new int[10];
    loc_defined = new int[10];
    loc_patches_cap = 16;
    loc_patches = new LocPatch[loc_patches_cap];
    nloc_patches = 0;
    tokbuf = new i8[1024];
    op_a_buf = new i8[512];
    op_b_buf = new i8[512];
    mem_base_buf = new i8[64];
    mem_disp_buf = new i8[512];
    mem_name_buf = new i8[512];
    op_a = op_a_buf;
    op_b = op_b_buf;

    if (argc < 4) { fail("usage: l8as [-p|--profile] -o out.o a.s ..."); }
    do_profile = 0;
    out_p: *i8 = "";
    out_set: int = 0;
    ai: int = 1;
    while (ai < argc) {
        arg: *i8 = (argv + ai * 8).*;
        if (is_profile_flag(arg)) {
            do_profile = 1;
            ai = ai + 1;
        } else {
            if (is_dash_o(arg)) {
                if (ai + 1 >= argc) { fail("usage: l8as [-p|--profile] -o out.o a.s ..."); }
                out_p = (argv + (ai + 1) * 8).*;
                out_set = 1;
                ai = ai + 2;
            } else {
                ai = ai + 1;
            }
        }
    }
    if (out_set == 0) { fail("usage: l8as [-p|--profile] -o out.o a.s ..."); }

    t0: int = 0;
    t1: int = 0;
    if (do_profile != 0) { t0 = mono_ns(); }

    cap: int = 65536;
    buf: *i8 = new i8[cap];
    n: int = 0;
    ai = 1;
    while (ai < argc) {
        arg2: *i8 = (argv + ai * 8).*;
        if (is_profile_flag(arg2)) {
            ai = ai + 1;
        } else {
            if (is_dash_o(arg2)) {
                ai = ai + 2;
            } else {
                fd: int = open(arg2, O_RDONLY, 0);
                if (fd < 0) { fail("cannot open input"); }
                reading: int = 1;
                while (reading != 0) {
                    if (n + 4096 > cap) {
                        cap = cap * 2;
                        tmp: *i8 = new i8[cap];
                        memcpy(tmp, buf, n);
                        buf = tmp;
                    }
                    r: int = read(fd, buf + n, 4096);
                    if (r <= 0) {
                        reading = 0;
                    } else {
                        n = n + r;
                    }
                }
                close(fd);
                if (n + 1 > cap) {
                    cap = cap * 2;
                    tmp2: *i8 = new i8[cap];
                    memcpy(tmp2, buf, n);
                    buf = tmp2;
                }
                buf[n] = '\n';
                n = n + 1;
                ai = ai + 1;
            }
        }
    }
    if (n == 0) { fail("usage: l8as [-p|--profile] -o out.o a.s ..."); }
    if (n + 1 > cap) {
        cap = n + 1;
        tmp3: *i8 = new i8[cap];
        memcpy(tmp3, buf, n);
        buf = tmp3;
    }
    buf[n] = 0 trunc i8;

    if (do_profile != 0) {
        t1 = mono_ns();
        profile_print("load", t1 - t0);
        t0 = t1;
    }

    assemble_buf(buf, n);

    if (do_profile != 0) {
        t1 = mono_ns();
        profile_print("assemble", t1 - t0);
        write(2, "profile: nsyms ", len("profile: nsyms "));
        emit_num_fd(2, nsyms);
        write(2, " nrels ", len(" nrels "));
        emit_num_fd(2, nrels);
        write(2, " text ", len(" text "));
        emit_num_fd(2, text_len);
        write(2, "\n", len("\n"));
        t0 = t1;
    }

    write_object(out_p);

    if (do_profile != 0) {
        t1 = mono_ns();
        profile_print("write_object", t1 - t0);
    }
    return 0;
}
