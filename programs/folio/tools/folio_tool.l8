tag folio_tool;

use_tag std, files, folio;

// Folios made and looked into:
//
//   folio pack RECORDS OUT [KEY=VALUE ...]  records (one a line) into a
//                                            folio, its books and chapters
//                                            its divisions, the pairs its
//                                            metadata
//   folio show FOLIO                         its metadata, sizes and
//                                            divisions
//   folio text FOLIO [KEY]                   its content, or a division's
//   folio keys FOLIO                         its divisions' keys, a line
//                                            each, a title after a tab
import "../folio.l8";

import "../../files/files.l8";

import "../../../stdlib/print.l8";

import "../../../stdlib/write.l8";

main(argc: int, args: []str): int {
    try {
        run(argc, args)
    } with IoError _error -> {
        1
    }
}

usage() raises IoError: int {
    eprint("usage: folio pack RECORDS OUT [KEY=VALUE ...]");
    eprint("       folio show FOLIO");
    eprint("       folio text FOLIO [KEY]");
    eprint("       folio keys FOLIO");
    2
}

run(argc: int, args: []str) raises IoError: int {
    if (argc < 3) return usage();
    command: str = args[1];
    try {
        if (command == "pack" && argc >= 4) return pack(argc, args);
        if (command == "show" && argc == 3) return show(args[2]);
        if (command == "text" && (argc == 3 || argc == 4)) return text(argc, args);
        if (command == "keys" && argc == 3) return keys(args[2]);
        usage()
    } with FileError error -> {
        write(2, "folio: ");
        eprint(file_operation_name(error.operation));
        1
    } with FolioError error -> {
        write(2, "folio: ");
        eprint(folio_failure_name(error.failure));
        1
    }
}

pack(argc: int, args: []str) raises IoError, FileError, FolioError: int {
    records: []i8 = read_file_bytes(args[2]);
    writer: *FolioWriter = folio_writer_new();
    for k in 4..argc {
        pair: []i8 = bytes(args[k]);
        equals: int = 0;
        while (equals < len(pair) && pair[equals] != '=' as i8) equals = equals + 1;
        if (equals == 0 || equals == len(pair)) {
            write(2, "folio: metadata is KEY=VALUE, not ");
            eprint(args[k]);
            return 2
        }
        key: []i8 = new i8[equals](0i8);
        memcpy(key, 0, pair, 0, equals);
        folio_meta_bytes(writer, cstr(key), pair, equals + 1, len(pair))
    }
    folio_append_records(writer, records, 0, len(records));
    file: []i8 = folio_finish(writer);
    replace_file_bytes(args[3], file, len(file));
    0
}

show(path: str) raises IoError, FileError, FolioError: int {
    file: []i8 = read_file_bytes(path);
    folio: *Folio = folio_open(file, len(file));
    for key in ["kind", "name", "title", "language", "versification", "license", "source"] {
        value: []i8 = folio_meta_value(folio, key);
        if (len(value) > 0) {
            write(1, key);
            write(1, ": ");
            write_bytes_n(1, value, len(value));
            print("")
        }
    }
    write_int(1, len(file));
    write(1, " bytes, ");
    write_int(1, folio_content_size(folio));
    write(1, " decoded, in ");
    write_int(1, folio_block_count(folio));
    print(" blocks");
    write_int(1, folio_division_count(folio));
    print(" divisions");
    0
}

text(argc: int, args: []str) raises IoError, FileError, FolioError: int {
    file: []i8 = read_file_bytes(args[2]);
    folio: *Folio = folio_open(file, len(file));
    from: int = 0;
    to: int = folio_content_size(folio);
    if (argc == 4) {
        division: int = folio_find(folio, args[3]);
        if (division < 0) {
            write(2, "folio: no division ");
            eprint(args[3]);
            return 1
        }
        from = folio_division_start(folio, division);
        to = folio_division_end(folio, division)
    }
    content: []i8 = folio_read(folio, file, from, to);
    write_bytes_n(1, content, len(content));
    0
}

keys(path: str) raises IoError, FileError, FolioError: int {
    file: []i8 = read_file_bytes(path);
    folio: *Folio = folio_open(file, len(file));
    for d in 0..folio_division_count(folio) {
        key: []i8 = folio_division_key(folio, d);
        title: []i8 = folio_division_title(folio, d);
        write_bytes_n(1, key, len(key));
        if (len(title) > 0) {
            write(1, "\t");
            write_bytes_n(1, title, len(title))
        }
        print("")
    }
    0
}
