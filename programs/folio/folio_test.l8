tag folio_test;

use_tag std, folio;

// The library's contract by example.
import "folio.l8";

import "../../stdlib/print.l8";

import "../../stdlib/write.l8";

psalms: str = """
BPSA Psalms
C1
Pm
V1
TBlessed is the man
C23
D
TA Psalm of David.
Pm
V1
TThe
ULord
T is my shepherd;
C24
Pm
V1
TThe earth is the
ULord
T’s
BJHN John
C1
Pm
V1
TIn the beginning was the Word
""";

show_bytes(data: []i8) raises IoError {
    write_bytes_n(1, data, len(data));
    print("")
}

test "a Bible's books and chapters are found by their keys" {
    try {
        writer: *FolioWriter = folio_writer_new();
        folio_meta(writer, "kind", "bible");
        folio_meta(writer, "title", "Psalms and John");
        records: []i8 = bytes(psalms);
        folio_append_records(writer, records, 0, len(records));
        file: []i8 = folio_finish(writer);
        folio: *Folio = folio_open(file, len(file));
        show_bytes(folio_meta_value(folio, "title"));
        print_int(len(folio_meta_value(folio, "language")));
        for d in 0..folio_division_count(folio) {
            if (d > 0) write(1, " ");
            write_bytes_n(1, folio_division_key(folio, d), len(folio_division_key(folio,
                d)))
        }
        print("");
        psalm: int = folio_find(folio, "PSA.23");
        write_bytes_n(1, folio_read(folio, file, folio_division_start(folio, psalm),
            folio_division_end(folio, psalm)), folio_division_end(folio, psalm) - folio_division_start(folio,
            psalm));
        print_int(folio_find(folio, "PSA.150"))
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    expect {|
        Psalms and John
        0
        PSA PSA.1 PSA.23 PSA.24 JHN JHN.1
        C23
        D
        TA Psalm of David.
        Pm
        V1
        TThe
        ULord
        T is my shepherd;
        -1
    |}
}

// (Lines numbered from 0, each 20 bytes: many blocks' worth.)
numbered_lines(count: int): []i8@new {
    out: []i8 = new i8[20 * count](32i8);
    for line in 0..count {
        n: int = line;
        for k in 0..12 {
            out[20 * line + 18 - k] = (48 + n % 10) trunc i8;
            n = n / 10
        }
        out[20 * line] = 'T' as i8;
        out[20 * line + 19] = 10i8
    }
    out
}

test "any part of the content is read, across blocks" {
    try {
        content: []i8 = numbered_lines(20000);
        writer: *FolioWriter = folio_writer_new();
        // (Divisions where the caller says, here every 5000 lines.)
        for part in 0..4 {
            key: str = ["first", "second", "third", "fourth"][part];
            folio_division(writer, bytes(key), 0, len(key));
            folio_append(writer, content, 100000 * part, 100000 * (part + 1))
        }
        file: []i8 = folio_finish(writer);
        folio: *Folio = folio_open(file, len(file));
        print_int(folio_content_size(folio));
        print_int(folio_block_count(folio));
        third: int = folio_find(folio, "third");
        from: int = folio_division_start(folio, third);
        to: int = folio_division_end(folio, third);
        part: []i8 = folio_read(folio, file, from, to);
        same: bool = true;
        for k in 0..len(part) {
            if (part[k] != content[from + k]) same = false
        }
        print(if (same) "the third part, as written" else "the third part, changed");
        // (A reader fetching blocks: a line that runs across two.)
        line_from: int = 20 * 3276;
        first: int = folio_block_first(folio, line_from);
        last: int = folio_block_last(folio, line_from + 20);
        print_int(last - first + 1);
        for block in first..last + 1 {
            fetched: []i8 = new i8[folio_block_compressed(folio, block)](0i8);
            memcpy(fetched, 0, file, folio_block_offset(folio, block), len(fetched));
            decoded: []i8 = folio_decode_block(folio, block, fetched, 0);
            start: int = folio_block_start(folio, block);
            take_from: int = if (line_from > start) line_from - start else 0;
            take_to: int = if (line_from + 19 < start + len(decoded)) line_from + 19 - start else len(decoded);
            write_bytes_span(1, decoded, take_from, take_to - take_from)
        }
        print("")
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    expect {|
        400000
        7
        the third part, as written
        2
        T      000000003276
    |}
}

open_or_say(file: []i8, count: int) raises IoError {
    try {
        folio: *Folio = folio_open(file, count);
        _all: []i8 = folio_content(folio, file);
        print("read")
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
}

test "what is not a whole folio is found out" {
    records: []i8 = bytes(psalms);
    writer: *FolioWriter = folio_writer_new();
    try {
        folio_append_records(writer, records, 0, len(records));
        // (A key used twice; a value with a line end.)
        folio_division(writer, bytes("PSA.23"), 0, 6)
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    try {
        folio_meta(writer, "title", """
two
lines""")
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    file: []i8 = folio_finish(writer);
    open_or_say(file, len(file));
    open_or_say(bytes("FOLDER and more bytes than that"), 30);
    open_or_say(file, 30);
    newer: []i8 = new i8[len(file)](0i8);
    memcpy(newer, 0, file, 0, len(file));
    newer[6] = 4i8;
    open_or_say(newer, len(newer));
    // (A byte of the block changed: the block begins after the head,
    // whose size is the number at 8.)
    damaged: []i8 = new i8[len(file)](0i8);
    memcpy(damaged, 0, file, 0, len(file));
    head: int = file[8] as int & 255 | (file[9] as int & 255) << 8 | (file[10] as int & 255) << 16;
    damaged[head + 3] = (damaged[head + 3] as int ^ 255) trunc i8;
    open_or_say(damaged, len(damaged));
    expect {|
        a key or value with a tab or a line end, or a key used twice
        a key or value with a tab or a line end, or a key used twice
        read
        not a folio
        the folio ends too soon
        a later version of the folio format
        a block of the folio is damaged
    |}
}

// Marks shown as verse@offset, the offset in the division.
show_marks(folio: *Folio, key: str) raises IoError {
    d: int = folio_find(folio, key);
    marks: []FolioMark = folio_division_marks(folio, d);
    if (len(marks) == 0) write(1, "none");
    for k in 0..len(marks) {
        if (k > 0) write(1, " ");
        write_int(1, marks[k].verse);
        write(1, "@");
        write_int(1, marks[k].offset - folio_division_start(folio, d))
    }
    print("")
}

test "a commentary's chapter marks where each comment and verse begins" {
    // (Its exposition's verses, then verse 1 again in its notes, as
    // Spurgeon's are; a Bible's chapters have no marks.)
    commentary: str = """
BPSA Psalms
C23
K23:1-23:6
Pm
TThe Lord is my shepherd.
V2
Pm
TGreen pastures.
K23:4-23:4
Pm
TThe valley.
V1
Pm
TVerse 1. Notes again.
""";
    try {
        writer: *FolioWriter = folio_writer_new();
        records: []i8 = bytes(commentary);
        folio_append_records(writer, records, 0, len(records));
        file: []i8 = folio_finish(writer);
        folio: *Folio = folio_open(file, len(file));
        print(if (folio_marked(folio)) "marked" else "not marked");
        show_marks(folio, "PSA.23");
        bible: *FolioWriter = folio_writer_new();
        verses: []i8 = bytes(psalms);
        folio_append_records(bible, verses, 0, len(verses));
        bible_file: []i8 = folio_finish(bible);
        show_marks(folio_open(bible_file, len(bible_file)), "PSA.23")
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    expect {|
        marked
        1@4 2@44 4@67 1@94
        none
    |}
}

test "a division's title is what a list of them shows" {
    try {
        writer: *FolioWriter = folio_writer_new();
        part: str = "1.2";
        title: str = "Of the Pilgrim's Setting Out";
        folio_division_titled(writer, bytes(part), 0, len(part), bytes(title), 0,
            len(title));
        folio_append(writer, bytes("""
Pm
TAs I walked through the wilderness of this world
"""), 0, 52);
        file: []i8 = folio_finish(writer);
        folio: *Folio = folio_open(file, len(file));
        show_bytes(folio_division_title(folio, folio_find(folio, "1.2")))
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    expect {|
        Of the Pilgrim's Setting Out
    |}
}

test "a book's long part is marked at paragraphs, a short one not" {
    // (Three paragraphs of 1,005 bytes each: the third begins 2,010 bytes
    // in, the first more than FOLIO_MARK_SPAN past the part's start.)
    try {
        writer: *FolioWriter = folio_writer_new();
        paragraph: []i8 = new i8[1005](97i8);
        paragraph[0] = 'P' as i8;
        paragraph[1] = 'm' as i8;
        paragraph[2] = 10i8;
        paragraph[3] = 'T' as i8;
        paragraph[1004] = 10i8;
        long: str = "1";
        folio_division_titled(writer, bytes(long), 0, len(long), bytes(long), 0, len(long));
        for _k in 0..3 folio_append_marked(writer, paragraph, 0, len(paragraph));
        short: str = "2";
        folio_division_titled(writer, bytes(short), 0, len(short), bytes(short), 0,
            len(short));
        folio_append_marked(writer, paragraph, 0, len(paragraph));
        file: []i8 = folio_finish(writer);
        folio: *Folio = folio_open(file, len(file));
        show_marks(folio, "1");
        show_marks(folio, "2");
        show_bytes(folio_division_title(folio, folio_find(folio, "1")))
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    expect {|
        0@2010
        none
        1
    |}
}

// Each unit word w is in (whole, or begun by it), by the record that begins
// it, in folio's content.
show_units(
    folio: *Folio,
    file: []i8,
    words: *FolioWords,
    w: str,
    matching: WordMatching
) raises FolioError, IoError {
    content: []i8 = folio_content(folio, file);
    write(1, w);
    write(1, ":");
    for at in folio_words_units(words, bytes(w), 0, len(w), matching) {
        end: int = at;
        while (content[end] != 10i8) end = end + 1;
        record: []i8 = new i8[end - at](0i8);
        memcpy(record, 0, content, at, end - at);
        write(1, " ");
        write_bytes_n(1, record, end - at)
    }
    print("")
}

folio_words_of(folio: *Folio, file: []i8) raises FolioError: *FolioWords@new {
    folio_words_open(file, folio_words_place(folio), folio_words_packed(folio), folio_words_size(folio))
}

test "a folio's word index: a Bible's verses, any word's beginning, folded" {
    try {
        writer: *FolioWriter = folio_writer_new();
        folio_meta(writer, "kind", "bible");
        records: str = """
BJHN John
C1
Pm
V4
TIn Him was life, and that life was the light of men.
V5
TThe Light shines in the darkness,
P1
Tand the darkness has not overcome it.
SThe Witness of John
V6
TThere came a man who was sent from God's presence.
""";
        folio_append_records(writer, bytes(records), 1, len(records));
        file: []i8 = folio_finish(writer);
        folio: *Folio = folio_open(file, len(file));
        words: *FolioWords = folio_words_of(folio, file);
        // (A word in any case; a verse's lines one unit; a heading its own;
        // God's as god; a word's beginning, each unit once.)
        show_units(folio, file, words, "light", WordMatching.Whole);
        show_units(folio, file, words, "overcome", WordMatching.Whole);
        show_units(folio, file, words, "witness", WordMatching.Whole);
        show_units(folio, file, words, "god", WordMatching.Whole);
        show_units(folio, file, words, "li", WordMatching.Beginning);
        show_units(folio, file, words, "lion", WordMatching.Beginning)
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    expect {|
        light: V4 V5
        overcome: V5
        witness: SThe Witness of John
        god: V6
        li: V4 V5
        lion:
    |}
}

test "a Bible's word index says each unit's verse" {
    try {
        writer: *FolioWriter = folio_writer_new();
        folio_meta(writer, "kind", "bible");
        records: str = """
BJHN John
C1
SThe Word
V1
TIn the beginning was the Word,
V2
THe was with God in the beginning.
C2
SA Wedding
V1
TOn the third day a wedding took place.
SAfterward
""";
        folio_append_records(writer, bytes(records), 1, len(records));
        file: []i8 = folio_finish(writer);
        folio: *Folio = folio_open(file, len(file));
        words: *FolioWords = folio_words_of(folio, file);
        content: []i8 = folio_content(folio, file);
        // (A heading's verse is the one it heads; one after the chapter's
        // last verse has none.)
        for w in ["word", "god", "wedding", "afterward"] {
            print(w);
            for at in folio_words_units(words, bytes(w), 0, len(w), WordMatching.Whole) {
                end: int = at;
                while (content[end] != 10i8) end = end + 1;
                record: []i8 = new i8[end - at](0i8);
                memcpy(record, 0, content, at, end - at);
                write(1, "  ");
                write_bytes_n(1, record, end - at);
                write(1, " verse ");
                print_int(folio_unit_verse(words, at))
            }
        }
        print(if (folio_words_have_verses(words)) "verses said" else "no verses")
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    expect {|
        word
          SThe Word verse 1
          V1 verse 1
        god
          V2 verse 2
        wedding
          SA Wedding verse 1
          V1 verse 1
        afterward
          SAfterward verse 0
        verses said
    |}
}

test "a commentary's word index: its paragraphs, its links' words, its notes" {
    try {
        writer: *FolioWriter = folio_writer_new();
        folio_meta(writer, "kind", "commentary");
        records: str = """
BJHN John
C4
K4:10-4:10
Pm
TThe living water is the Spirit.
Pm
TSee also 
Losis:Jer.2.13	Jeremiah's fountain
F of living waters
""";
        folio_append_records(writer, bytes(records), 1, len(records));
        file: []i8 = folio_finish(writer);
        folio: *Folio = folio_open(file, len(file));
        words: *FolioWords = folio_words_of(folio, file);
        show_units(folio, file, words, "living", WordMatching.Whole);
        show_units(folio, file, words, "fountain", WordMatching.Whole);
        show_units(folio, file, words, "osis", WordMatching.Whole)
    } with FolioError error -> {
        print(folio_failure_name(error.failure))
    }
    expect {|
        living: Pm Pm
        fountain: Pm
        osis:
    |}
}
