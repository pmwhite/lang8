tag malton;

use_tag skate;

// The park's solid surfaces, for riding: triangles, each either one he can
// ride (the ground, a ramp's face, a deck, a box's top) or only solid (a
// ramp's sides and back, a wall), filed in a grid of cells over the ground
// so that a query looks only at those near. And the edges he can grind: a
// rail, a coping, a box's edge.
const MAX_TRIS: int = 40000;

tri_a: []V3 = new V3[MAX_TRIS](V3 { x: 0.0, y: 0.0, z: 0.0 });

tri_b: []V3 = new V3[MAX_TRIS](V3 { x: 0.0, y: 0.0, z: 0.0 });

tri_c: []V3 = new V3[MAX_TRIS](V3 { x: 0.0, y: 0.0, z: 0.0 });

tri_n: []V3 = new V3[MAX_TRIS](V3 { x: 0.0, y: 0.0, z: 0.0 });

tri_ride: []bool = new bool[MAX_TRIS](false);

// What each is part of, for what it favors flown off (see judge.l8): a
// feature's kind, or -1 for the plain ground; and what the next get.
tri_item: []int = new int[MAX_TRIS](-1);

surf_item: int = -1;

ntris: int = 0;

// The grid: GRID cells a side, each CELL meters, from GRID_X0, GRID_Z0.
const GRID: int = 100;

const CELL: f32 = 1.0;

const GRID_X0: f32 = -50.0;

const GRID_Z0: f32 = -50.0;

const MAX_ITEMS: int = 400000;

cell_start: []int = new int[GRID * GRID + 1](0);

cell_items: []int = new int[MAX_ITEMS](0);

// Which query last looked at each triangle, so it looks once.
tri_stamp: []int = new int[MAX_TRIS](0);

stamp: int = 0;

// A triangle a, b, c, its front where they go round anticlockwise.
surf_tri(
    a: V3,
    b: V3,
    c: V3,
    ride: bool
) {
    if (ntris >= MAX_TRIS) return;
    n: V3 = v_cross(v_sub(b, a), v_sub(c, a));
    if (v_len(n) < 0.000001) return;
    tri_a[ntris] = a;
    tri_b[ntris] = b;
    tri_c[ntris] = c;
    tri_n[ntris] = v_norm(n);
    tri_ride[ntris] = ride;
    tri_item[ntris] = surf_item;
    ntris = ntris + 1
}

// A quad a, b, c, d, going round anticlockwise seen from its front.
surf_quad(
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    ride: bool
) {
    surf_tri(a, b, c, ride);
    surf_tri(a, c, d, ride)
}

cell_x(x: f32): int {
    clampi(floorf((x - GRID_X0) / CELL) as int, 0, GRID - 1)
}

cell_z(z: f32): int {
    clampi(floorf((z - GRID_Z0) / CELL) as int, 0, GRID - 1)
}

clampi(x: int, lo: int, hi: int): int {
    if (x < lo) return lo;
    if (x > hi) return hi;
    x
}

// File each triangle in the cells its footprint's box covers.
surf_index() {
    counts: []int = new int[GRID * GRID + 1](0);
    for pass in 0..2 {
        for i in 0..ntris {
            a: V3 = tri_a[i];
            b: V3 = tri_b[i];
            c: V3 = tri_c[i];
            i0: int = cell_x(minf(a.x, minf(b.x, c.x)));
            i1: int = cell_x(maxf(a.x, maxf(b.x, c.x)));
            j0: int = cell_z(minf(a.z, minf(b.z, c.z)));
            j1: int = cell_z(maxf(a.z, maxf(b.z, c.z)));
            for j in j0..j1 + 1 {
                for k in i0..i1 + 1 {
                    cell: int = j * GRID + k;
                    if (pass == 0) counts[cell] = counts[cell] + 1 else {
                        at: int = cell_start[cell] + counts[cell];
                        if (at < MAX_ITEMS) cell_items[at] = i;
                        counts[cell] = counts[cell] + 1
                    }
                }
            }
        }
        if (pass == 0) {
            total: int = 0;
            for cell in 0..GRID * GRID {
                cell_start[cell] = total;
                total = total + counts[cell];
                counts[cell] = 0
            }
            cell_start[GRID * GRID] = total
        }
    }
}

// ---- the nearest surface ----
// What the last query found: the point, its triangle's normal, and the
// distance to it.
hit_p: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

hit_n: V3 = V3 { x: 0.0, y: 1.0, z: 0.0 };

hit_d: f32 = 0.0;

hit_t: f32 = 0.0;

// Whether the nearest point is straight out from p's surface (p is over
// it), not on its edge.
hit_inside: bool = false;

// The nearest point to p on any surface within r of it that he can ride,
// facing within the given cosine of up_n: its triangle, or -1. One p is
// over (or under) wins over one whose edge is nearer.
surf_nearest(
    p: V3,
    r: f32,
    up_n: V3,
    cos_max: f32
): int {
    stamp = stamp + 1;
    best: int = -1;
    bd: f32 = r;
    best_inside: bool = false;
    i0: int = cell_x(p.x - r);
    i1: int = cell_x(p.x + r);
    j0: int = cell_z(p.z - r);
    j1: int = cell_z(p.z + r);
    for j in j0..j1 + 1 {
        for k in i0..i1 + 1 {
            cell: int = j * GRID + k;
            for s in cell_start[cell]..cell_start[cell + 1] {
                t: int = cell_items[s];
                if (tri_stamp[t] != stamp) {
                    tri_stamp[t] = stamp;
                    if (tri_ride[t] && v_dot(tri_n[t], up_n) >= cos_max) {
                        q: V3 = closest_on_tri(p, tri_a[t], tri_b[t], tri_c[t]);
                        d: f32 = v_len(v_sub(p, q));
                        sd: f32 = v_dot(v_sub(p, tri_a[t]), tri_n[t]);
                        inside: bool = d - absf(sd) < 0.0005;
                        // Of two surfaces one over the other (a ramp's flat
                        // on the ground), the one he has just come through
                        // from in front: so that he rides up onto it.
                        if (inside && sd > -0.0001) d = d + 0.02;
                        if (d < r && (inside && !best_inside || inside == best_inside && d < bd)) {
                            bd = d;
                            best = t;
                            best_inside = inside;
                            hit_p = q
                        }
                    }
                }
            }
        }
    }
    if (best >= 0) {
        hit_n = tri_n[best];
        hit_d = v_len(v_sub(p, hit_p));
        hit_inside = best_inside
    }
    best
}

// The deepest any solid surface near p has p behind it, within r of the
// surface's face: its triangle, or -1. (hit_p is where to push p out to.)
surf_inside(p: V3, r: f32): int {
    stamp = stamp + 1;
    best: int = -1;
    deepest: f32 = 0.0;
    i0: int = cell_x(p.x - r);
    i1: int = cell_x(p.x + r);
    j0: int = cell_z(p.z - r);
    j1: int = cell_z(p.z + r);
    for j in j0..j1 + 1 {
        for k in i0..i1 + 1 {
            cell: int = j * GRID + k;
            for s in cell_start[cell]..cell_start[cell + 1] {
                t: int = cell_items[s];
                if (tri_stamp[t] != stamp) {
                    tri_stamp[t] = stamp;
                    n: V3 = tri_n[t];
                    depth: f32 = -v_dot(v_sub(p, tri_a[t]), n);
                    if (depth > deepest && depth < r) {
                        q: V3 = closest_on_tri(p, tri_a[t], tri_b[t], tri_c[t]);
                        // Only where p is right behind the face, not off its
                        // edge.
                        if (v_len(v_reject(v_sub(p, q), n)) < 0.01) {
                            deepest = depth;
                            best = t;
                            hit_p = q
                        }
                    }
                }
            }
        }
    }
    if (best >= 0) {
        hit_n = tri_n[best];
        hit_d = deepest
    }
    best
}

// The first surface the segment from p0 to p1 passes into from in front:
// its triangle, or -1. hit_t is how far along, hit_p where.
surf_cross(p0: V3, p1: V3): int {
    stamp = stamp + 1;
    best: int = -1;
    bt: f32 = 2.0;
    dir: V3 = v_sub(p1, p0);
    i0: int = cell_x(minf(p0.x, p1.x));
    i1: int = cell_x(maxf(p0.x, p1.x));
    j0: int = cell_z(minf(p0.z, p1.z));
    j1: int = cell_z(maxf(p0.z, p1.z));
    for j in j0..j1 + 1 {
        for k in i0..i1 + 1 {
            cell: int = j * GRID + k;
            for s in cell_start[cell]..cell_start[cell + 1] {
                t: int = cell_items[s];
                if (tri_stamp[t] != stamp) {
                    tri_stamp[t] = stamp;
                    if (v_dot(dir, tri_n[t]) < 0.0) {
                        u: f32 = seg_tri(p0, dir, tri_a[t], tri_b[t], tri_c[t]);
                        if (u >= 0.0 && u < bt) {
                            bt = u;
                            best = t
                        }
                    }
                }
            }
        }
    }
    if (best >= 0) {
        hit_t = bt;
        hit_p = v_madd(p0, dir, bt);
        hit_n = tri_n[best]
    }
    best
}

// Where along p0 + u dir (u from 0 to 1) it meets triangle a, b, c, or -1.
seg_tri(
    p0: V3,
    dir: V3,
    a: V3,
    b: V3,
    c: V3
): f32 {
    e1: V3 = v_sub(b, a);
    e2: V3 = v_sub(c, a);
    h: V3 = v_cross(dir, e2);
    det: f32 = v_dot(e1, h);
    if (absf(det) < 0.0000001) return -1.0;
    f: f32 = 1.0 / det;
    s: V3 = v_sub(p0, a);
    u: f32 = f * v_dot(s, h);
    if (u < 0.0 || u > 1.0) return -1.0;
    q: V3 = v_cross(s, e1);
    v: f32 = f * v_dot(dir, q);
    if (v < 0.0 || u + v > 1.0) return -1.0;
    t: f32 = f * v_dot(e2, q);
    if (t < 0.0 || t > 1.0) return -1.0;
    t
}

// The point of triangle a, b, c nearest p (Ericson, Real-Time Collision
// Detection, 5.1.5).
closest_on_tri(
    p: V3,
    a: V3,
    b: V3,
    c: V3
): V3 {
    ab: V3 = v_sub(b, a);
    ac: V3 = v_sub(c, a);
    ap: V3 = v_sub(p, a);
    d1: f32 = v_dot(ab, ap);
    d2: f32 = v_dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) return a;
    bp: V3 = v_sub(p, b);
    d3: f32 = v_dot(ab, bp);
    d4: f32 = v_dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) return b;
    vc: f32 = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) return v_madd(a, ab, d1 / (d1 - d3));
    cp: V3 = v_sub(p, c);
    d5: f32 = v_dot(ab, cp);
    d6: f32 = v_dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) return c;
    vb: f32 = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) return v_madd(a, ac, d2 / (d2 - d6));
    va: f32 = d3 * d6 - d5 * d4;
    if (va <= 0.0 && d4 - d3 >= 0.0 && d5 - d6 >= 0.0) return v_madd(b, v_sub(c, b),
        (d4 - d3) / (d4 - d3 + (d5 - d6)));
    den: f32 = 1.0 / (va + vb + vc);
    v: f32 = vb * den;
    w: f32 = vc * den;
    v_add(a, v_add(v_scale(ab, v), v_scale(ac, w)))
}

// ---- grinding ----
// The edges he can grind: from a to b, and how high above the edge his
// board rides on it (a rail's radius).
const MAX_GRINDS: int = 64;

grind_a: []V3 = new V3[MAX_GRINDS](V3 { x: 0.0, y: 0.0, z: 0.0 });

grind_b: []V3 = new V3[MAX_GRINDS](V3 { x: 0.0, y: 0.0, z: 0.0 });

grind_lift: []f32 = new f32[MAX_GRINDS](0.0);

ngrinds: int = 0;

add_grind(a: V3, b: V3, lift: f32) {
    if (ngrinds >= MAX_GRINDS) return;
    grind_a[ngrinds] = a;
    grind_b[ngrinds] = b;
    grind_lift[ngrinds] = lift;
    ngrinds = ngrinds + 1
}
