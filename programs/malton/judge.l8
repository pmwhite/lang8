tag malton;

use_tag skate;

// Judging on the course: taste over mashing. Each trick he lands clean
// scores on its own, and the run scores what they add up to.
//
// - An air is worth what he did (flips, spins, a grab, more for a flip and
//   a spin together), times how long he was up, times how he landed:
//   stomped in the landing's sweet spot, cased short of it, or overshot.
// - What he flew off favors some tricks: a kicker flips, a halfpipe's wall
//   spins, a cliff grabs (and spins), a gap a bit of everything.
// - Anything done riding switch is worth half again, and is a trick of its
//   own.
// - A trick he has already done this run is worth half as much, then a
//   quarter, and so on.
// - Off flat ground or a roller, a trick is worth a quarter.
// - A trick he doesn't finish, or a gap he comes up short of, is sketchy,
//   and worth nothing.
const HIT_AIR: int = 0;

const HIT_FLAT: int = 1;

const HIT_RAIL: int = 2;

const HIT_BOX: int = 3;

// A trick landed sketchy: what he went for, for the report.
const HIT_SKETCH: int = 4;

const LAND_CLEAN: int = 0;

const LAND_STOMPED: int = 1;

const LAND_CASED: int = 2;

const LAND_OVERSHOT: int = 3;

// flips and halves are signed: forward, and to the right.
type Hit = {
    kind: int;
    // The kind of feature an air was off (or -1), and whether he was
    // riding switch.
    item: int;
    sw: bool;
    flips: int;
    halves: int;
    grab: bool;
    landing: int;
    repeat: int;
    points: f32;
    // For the run's report: an air's points before its time up, landing,
    // switch, flat ground, and repeat counted; its time-up factor; and
    // what a grind added over its time.
    base: f32;
    amp: f32;
    extra: f32;
    // The base points, by part: flips, spins, a grab.
    base_flip: f32;
    base_spin: f32;
    base_grab: f32
}

const MAX_HITS: int = 256;

const MAX_KEYS: int = 128;

no_hit(): Hit {
    Hit {
        kind: 0,
        item: -1,
        sw: false,
        flips: 0,
        halves: 0,
        grab: false,
        landing: 0,
        repeat: 0,
        points: 0.0,
        base: 0.0,
        amp: 1.0,
        extra: 0.0,
        base_flip: 0.0,
        base_spin: 0.0,
        base_grab: 0.0
    }
}

type Run = {
    // Every hit this run, in order.
    hits: []Hit;
    n: int;
    points: f32;
    // Each kind of trick done this run, and how many times.
    keys: []int;
    key_count: []int;
    nkeys: int;
    total: int;
    best_run: int;
    // Since the latest hit (or a grind's latest points), for its call.
    call_t: f32
}

run: *Run = new Run {
    hits: new Hit[MAX_HITS](no_hit()),
    n: 0,
    points: 0.0,
    keys: new int[MAX_KEYS](0),
    key_count: new int[MAX_KEYS](0),
    nkeys: 0,
    total: 0,
    best_run: 0,
    call_t: 100.0
};

clear_run() {
    run.n = 0;
    run.points = 0.0;
    run.nkeys = 0;
    run.total = 0;
    run.call_t = 100.0
}

// What makes a trick the same trick.
hit_key(h: Hit): int {
    g: int = 0;
    if (h.grab) g = 1;
    if (h.sw) g = g + 2;
    h.kind * 100000 + (h.flips + 4) * 1000 + (h.halves + 8) * 10 + g
}

// How many times this run he has done it.
times_done(key: int): int {
    for i in 0..run.nkeys {
        if (run.keys[i] == key) return run.key_count[i]
    }
    0
}

count_key(key: int) {
    for i in 0..run.nkeys {
        if (run.keys[i] == key) {
            run.key_count[i] = run.key_count[i] + 1;
            return
        }
    }
    if (run.nkeys < MAX_KEYS) {
        run.keys[run.nkeys] = key;
        run.key_count[run.nkeys] = 1;
        run.nkeys = run.nkeys + 1
    }
}

push_hit(h: Hit) {
    if (run.n < MAX_HITS) {
        run.hits[run.n] = h;
        run.n = run.n + 1
    }
    run.call_t = 0.0
}

add_hit(h: Hit) {
    r: Hit = h;
    key: int = hit_key(h);
    r.repeat = times_done(key);
    r.points = h.points * powf(0.5, r.repeat as f32);
    count_key(key);
    push_hit(r);
    add_points(r.points)
}

add_points(p: f32) {
    run.points = run.points + p;
    run.total = (run.points + 0.5) as int
}

// Points for keeping a grind up, at its repeat rate.
run_add(points: f32) {
    if (run.n == 0) return;
    i: int = run.n - 1;
    k: f32 = powf(0.5, run.hits[i].repeat as f32);
    run.hits[i].points = run.hits[i].points + points * k;
    run.hits[i].extra = run.hits[i].extra + points * k;
    add_points(points * k);
    run.call_t = 0.0
}

// What he flies off, for what it favors: a bank or a kicker (flips), a
// transition or a vert wall (spins); the same kinds as the skate game's
// course.
const FEATURE_KICKER: int = 0;

const FEATURE_PIPE: int = 2;

const FEATURE_CLIFF: int = 3;

const FEATURE_GAP: int = 4;

mini(a: int, b: int): int {
    if (a < b) return a;
    b
}

absi(a: int): int {
    if (a < 0) return -a;
    a
}

// Bigger is worth more, but less and less so: one trick done well where it
// suits beats a bigger one anywhere.
flip_points: []f32 = [0.0, 600.0, 900.0, 1100.0];

spin_points: []f32 = [0.0, 200.0, 350.0, 480.0, 580.0, 660.0, 720.0];

// An air, judged as he lands: kind HIT_AIR off a kicker, else HIT_FLAT;
// what he did, how much of the air he held a grab, how long he was up, and
// how he landed.
// What each kind of feature makes of flips, spins, and grabs.
item_flips(item: int): f32 {
    if (item == FEATURE_KICKER) return 2.0;
    if (item == FEATURE_GAP) return 1.25;
    if (item == FEATURE_PIPE) return 0.5;
    if (item == FEATURE_CLIFF) return 0.75;
    1.0
}

item_spins(item: int): f32 {
    if (item == FEATURE_PIPE) return 2.0;
    if (item == FEATURE_GAP || item == FEATURE_CLIFF) return 1.25;
    if (item == FEATURE_KICKER) return 0.75;
    1.0
}

item_grabs(item: int): f32 {
    if (item == FEATURE_CLIFF) return 2.5;
    if (item == FEATURE_GAP || item == FEATURE_PIPE) return 1.25;
    1.0
}

const SWITCH_BONUS: f32 = 1.5;

// An air's base: its flips', spins', and grab's points (gp), each times
// what the item makes of it, and more for a flip and a spin together; or a
// straight air's.
air_base(
    item: int,
    nf: int,
    nh: int,
    gp: f32
): f32 {
    p: f32 = flip_points[nf] * item_flips(item) + spin_points[nh] * item_spins(item) + gp * item_grabs(item);
    if (p == 0.0) p = 100.0;
    if (nf > 0 && nh > 0) p = p * 1.2;
    p
}

// How much more (or less) an air is worth for how long he was up.
air_amp(air: f32): f32 {
    clampf(air / 1.2, 0.5, 1.6)
}

// What an air scores, before repeats: its base, times how long he was up,
// switch, how he landed, and flat ground.
air_points(
    kind: int,
    item: int,
    nf: int,
    nh: int,
    gp: f32,
    air: f32,
    landing: int,
    sw: bool
): f32 {
    p: f32 = air_base(item, nf, nh, gp) * air_amp(air);
    if (sw) p = p * SWITCH_BONUS;
    if (landing == LAND_STOMPED) p = p * 1.25;
    if (landing == LAND_CASED) p = p * 0.6;
    if (landing == LAND_OVERSHOT) p = p * 0.75;
    if (kind == HIT_FLAT) p = p * 0.25;
    p
}

// How many times this run he has done the trick he aims at (as aim_value
// would score it).
aim_repeats(
    kind: int,
    flips: int,
    halves: int,
    sw: bool
): int {
    h: Hit = no_hit();
    h.kind = kind;
    h.flips = flips;
    h.halves = halves;
    h.sw = sw;
    times_done(hit_key(h))
}

// What the trick he aims at would score, in an air that long, landed clean
// and without a grab; nothing for an ollie.
aim_value(
    kind: int,
    item: int,
    flips: int,
    halves: int,
    air: f32,
    sw: bool
): int {
    nf: int = mini(absi(flips), 3);
    nh: int = mini(absi(halves), 6);
    if (nf == 0 && nh == 0 && (kind != HIT_AIR || air < 0.6)) return 0;
    p: f32 = air_points(kind, item, nf, nh, 0.0, air, LAND_CLEAN, sw) * powf(0.5,
        aim_repeats(kind, flips, halves, sw) as f32);
    (p + 0.5) as int
}

judge_air(
    kind: int,
    item: int,
    flips: int,
    halves: int,
    grab: f32,
    air: f32,
    landing: int,
    sw: bool
) {
    nf: int = mini(absi(flips), 3);
    nh: int = mini(absi(halves), 6);
    grabbed: bool = grab > 0.25;
    if (nf == 0 && nh == 0 && !grabbed) {
        // A straight air off a kicker is a little something; an ollie is
        // nothing.
        if (kind != HIT_AIR || air < 0.6) return
    }
    gp: f32 = 0.0;
    if (grabbed) gp = 300.0 + 200.0 * grab;
    p: f32 = air_points(kind, item, nf, nh, gp, air, landing, sw);
    h: Hit = no_hit();
    h.kind = kind;
    h.item = item;
    h.sw = sw;
    h.flips = flips;
    h.halves = halves;
    h.grab = grabbed;
    h.landing = landing;
    h.points = p;
    h.base = air_base(item, nf, nh, gp);
    h.amp = air_amp(air);
    h.base_flip = flip_points[nf];
    h.base_spin = spin_points[nh];
    h.base_grab = gp;
    add_hit(h)
}

judge_grind(box: bool, sw: bool) {
    h: Hit = no_hit();
    h.kind = HIT_RAIL;
    if (box) h.kind = HIT_BOX;
    h.sw = sw;
    h.points = 300.0;
    if (sw) h.points = h.points * SWITCH_BONUS;
    add_hit(h)
}

// A trick landed sketchy: what he went for, off what, and whether he came
// up short of a gap (cased); worth nothing.
judge_sketch(
    item: int,
    flips: int,
    halves: int,
    cased: bool,
    sw: bool
) {
    h: Hit = no_hit();
    h.kind = HIT_SKETCH;
    h.item = item;
    h.sw = sw;
    h.flips = flips;
    h.halves = halves;
    if (cased) h.landing = LAND_CASED;
    push_hit(h)
}

tick_run(dt: f32) {
    run.call_t = run.call_t + dt
}
