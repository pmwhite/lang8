tag malton;

use_tag skate;

// Norton & Malton Skatepark, North Yorkshire, as it stands: laid out from
// an aerial photograph (Wikimedia Commons, "Norton & Malton Skatepark
// ariel shot in 2026", CC0) and sized from photographs of each ramp
// ("New halfpipe and vert wall", "New Jumpbox", "New L Ramp", "New
// Pyramidal Funbox", "New Volcano Spine", and others, CC BY-SA 4.0). The
// photograph's scale (16.5 mm a pixel) comes from the people, a bike, and
// the railway's gauge in it; heights come from the photographs, by the
// railings (a metre high) and a man standing in front of the halfpipe.
//
// x runs to the photograph's right and z down it; north lies down and to
// the left (see SUN). Each ramp is built twice from the same numbers: its
// look, into the mesh, and its solid surfaces, for riding (see surf.l8).

// A point in the aerial photograph, in its full-size pixels, on the
// ground.
px(x: f32, y: f32): V3 {
    v3((x - 2400.0) * 0.0165, 0.0, (y - 2000.0) * 0.0165)
}

// ---- colors ----
skatelite: V3 = V3 { x: 0.86, y: 0.64, z: 0.36 };

deck_grey: V3 = V3 { x: 0.24, y: 0.23, z: 0.22 };

hdpe_brown: V3 = V3 { x: 0.19, y: 0.12, z: 0.09 };

hdpe_black: V3 = V3 { x: 0.055, y: 0.055, z: 0.06 };

galv: V3 = V3 { x: 0.66, y: 0.68, z: 0.69 };

brick_red: V3 = V3 { x: 0.58, y: 0.27, z: 0.19 };

asphalt_grey: V3 = V3 { x: 0.56, y: 0.56, z: 0.54 };

UP: V3 = V3 { x: 0.0, y: 1.0, z: 0.0 };

const GRASS_Y: f32 = -0.03;

// ---- a quad, seen and solid ----
// A quad a b c d, its front (where they go round anticlockwise) facing n:
// into the mesh, and if solid, into the surfaces (ridden on if ride).
face(
    m: *Mesh,
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    col: V3,
    mat: f32,
    solid: bool,
    ride: bool
) {
    n: V3 = v_cross(v_sub(b, a), v_sub(c, a));
    if (v_len(n) < 0.0000001) n = v_cross(v_sub(c, a), v_sub(d, a));
    n = v_norm(n);
    // Its patterns laid along its first edge, and up it.
    e: V3 = v_sub(b, a);
    if (v_len(e) < 0.0001) e = v_sub(c, b);
    e = v_norm(e);
    uv_plane(a, e, v_cross(n, e));
    put_quad(m, a, b, c, d, n, col, mat);
    if (solid) surf_quad(a, b, c, d, ride)
}

// The same, facing toward out: its corners put in order for that.
face_out(
    m: *Mesh,
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    out: V3,
    col: V3,
    mat: f32,
    solid: bool,
    ride: bool
) {
    n: V3 = v_cross(v_sub(b, a), v_sub(c, a));
    if (v_dot(n, out) < 0.0) face(m, d, c, b, a, col, mat, solid, ride) else face(m,
        a, b, c, d, col, mat, solid, ride)
}

// ---- profiles ----
// A ramp's cross-section along its axis: points (u along the axis, y up),
// u never going back; each segment's look (PROF_FACE riding surface,
// PROF_VERT the black wall above a transition, PROF_DECK the deck on top).
const MAX_PROF: int = 160;

prof_u: []f32 = new f32[MAX_PROF](0.0);

prof_y: []f32 = new f32[MAX_PROF](0.0);

prof_kind: []int = new int[MAX_PROF](0);

prof_s: []f32 = new f32[MAX_PROF](0.0);

nprof: int = 0;

const PROF_FACE: int = 0;

const PROF_VERT: int = 1;

const PROF_DECK: int = 2;

const PROF_FLAT: int = 3;

prof_reset() {
    nprof = 0
}

// A point, the segment to it of the given kind.
prof_to(u: f32, y: f32, kind: int) {
    if (nprof >= MAX_PROF) return;
    prof_u[nprof] = u;
    prof_y[nprof] = y;
    prof_kind[nprof] = kind;
    nprof = nprof + 1
}

// From the last point (at height h), down a transition of radius r to the
// ground; first straight down to r if h is above it (as vert).
const ARC_STEPS: int = 18;

prof_fall(r: f32, kind: int) {
    u0: f32 = prof_u[nprof - 1];
    h: f32 = prof_y[nprof - 1];
    top: f32 = minf(h, r);
    if (h > r + 0.001) prof_to(u0, r, kind);
    a0: f32 = acos_f(1.0 - top / r);
    // Where the arc's top meets the vertical, u0; its foot is r sin a0 on.
    for i in 1..ARC_STEPS + 1 {
        a: f32 = a0 * (1.0 - i as f32 / ARC_STEPS as f32);
        prof_to(u0 + r * sinf(a0) - r * sinf(a), r * (1.0 - cosf(a)), PROF_FACE)
    }
}

// From the last point (on the ground), up a transition of radius r to
// height h; straight up past r (vert, of the given kind).
prof_rise(r: f32, h: f32, vert_kind: int) {
    u0: f32 = prof_u[nprof - 1];
    top: f32 = minf(h, r);
    a1: f32 = acos_f(1.0 - top / r);
    for i in 1..ARC_STEPS + 1 {
        a: f32 = a1 * i as f32 / ARC_STEPS as f32;
        prof_to(u0 + r * sinf(a), r * (1.0 - cosf(a)), PROF_FACE)
    }
    if (h > r + 0.001) prof_to(prof_u[nprof - 1], h, vert_kind)
}

// How far out along the ground a transition of radius r reaches, to h.
arc_reach(r: f32, h: f32): f32 {
    if (h >= r) return r;
    r * sinf(acos_f(1.0 - h / r))
}

prof_color(kind: int, face_col: V3): V3 {
    if (kind == PROF_VERT) return hdpe_black;
    if (kind == PROF_DECK) return deck_grey;
    face_col
}

prof_mat(kind: int): f32 {
    if (kind == PROF_FACE || kind == PROF_FLAT) return MAT_SKATELITE;
    MAT_PAINT
}

// The profile swept across w (half either side of the axis), from o on the
// ground at u = 0, the axis along ax: its faces (smooth), its sides
// (side_col), and its ends, down to the ground.
extrude(
    m: *Mesh,
    o: V3,
    ax: V3,
    w: f32,
    face_col: V3,
    side_col: V3
) {
    r: V3 = v_norm(v_cross(ax, UP));
    hw: f32 = w * 0.5;
    // Arc length along the profile, for the sheets' seams.
    prof_s[0] = 0.0;
    for i in 1..nprof prof_s[i] = prof_s[i - 1] + sqrtf((prof_u[i] - prof_u[i - 1]) * (prof_u[i] - prof_u[i - 1]) + (prof_y[i] - prof_y[i - 1]) * (prof_y[i] - prof_y[i - 1]));
    for i in 0..nprof - 1 {
        du: f32 = prof_u[i + 1] - prof_u[i];
        dy: f32 = prof_y[i + 1] - prof_y[i];
        kind: int = prof_kind[i + 1];
        n: V3 = v_norm(v_add(v_scale(ax, -dy), v_scale(UP, du)));
        // Smooth across the bends of a transition: each end's normal the
        // average of its segments'.
        n0: V3 = n;
        n1: V3 = n;
        if (kind == PROF_FACE) {
            n0 = prof_normal(ax, i);
            n1 = prof_normal(ax, i + 1)
        }
        a: V3 = prof_point(o, ax, r, i, -hw);
        b: V3 = prof_point(o, ax, r, i, hw);
        c: V3 = prof_point(o, ax, r, i + 1, hw);
        d: V3 = prof_point(o, ax, r, i + 1, -hw);
        col: V3 = prof_color(kind, face_col);
        // Its patterns: across it, and along the profile (arc length).
        s0: f32 = prof_s[i];
        s1: f32 = prof_s[i + 1];
        if (v_dot(v_cross(v_sub(b, a), v_sub(c, a)), n) < 0.0) {
            put_st(m, d, n1, hw, s1, col, kind);
            put_st(m, c, n1, -hw, s1, col, kind);
            put_st(m, b, n0, -hw, s0, col, kind);
            put_st(m, d, n1, hw, s1, col, kind);
            put_st(m, b, n0, -hw, s0, col, kind);
            put_st(m, a, n0, hw, s0, col, kind);
            surf_quad(d, c, b, a, true)
        } else {
            put_st(m, a, n0, -hw, s0, col, kind);
            put_st(m, b, n0, hw, s0, col, kind);
            put_st(m, c, n1, hw, s1, col, kind);
            put_st(m, a, n0, -hw, s0, col, kind);
            put_st(m, c, n1, hw, s1, col, kind);
            put_st(m, d, n1, -hw, s1, col, kind);
            surf_quad(a, b, c, d, true)
        }
        // The sides, down to the ground.
        for s in 0..2 {
            sg: f32 = 2.0 * s as f32 - 1.0;
            p0: V3 = prof_point(o, ax, r, i, sg * hw);
            p1: V3 = prof_point(o, ax, r, i + 1, sg * hw);
            g0: V3 = v3(p0.x, 0.0, p0.z);
            g1: V3 = v3(p1.x, 0.0, p1.z);
            // (Low enough to roll over, it is not a wall.)
            if (p0.y > 0.001 || p1.y > 0.001) face_out(m, g0, p0, p1, g1, v_scale(r,
                sg), side_col, MAT_PAINT, maxf(p0.y, p1.y) > 0.05, false)
        }
    }
    // The ends.
    for e in 0..2 {
        i: int = 0;
        if (e == 1) i = nprof - 1;
        if (prof_y[i] > 0.001) {
            out: V3 = v_scale(ax, 2.0 * e as f32 - 1.0);
            p0: V3 = prof_point(o, ax, r, i, -hw);
            p1: V3 = prof_point(o, ax, r, i, hw);
            face_out(m, v3(p0.x, 0.0, p0.z), p0, p1, v3(p1.x, 0.0, p1.z), out, side_col,
                MAT_PAINT, prof_y[i] > 0.05, false)
        }
    }
}

// A vertex of a profile's face, at (s, t) on it.
put_st(
    m: *Mesh,
    p: V3,
    n: V3,
    s: f32,
    t: f32,
    col: V3,
    kind: int
) {
    uv_planar = false;
    uv_u = s;
    uv_v = t;
    put(m, p, n, col, prof_mat(kind));
    uv_planar = true
}

prof_point(
    o: V3,
    ax: V3,
    r: V3,
    i: int,
    v: f32
): V3 {
    v_add(v_add(o, v_scale(ax, prof_u[i])), v_add(v_scale(UP, prof_y[i]), v_scale(r,
        v)))
}

// The surface's normal at point i: its segments' averaged.
prof_normal(ax: V3, i: int): V3 {
    n: V3 = v3(0.0, 0.0, 0.0);
    if (i > 0) n = v_add(n, seg_normal(ax, i - 1));
    if (i < nprof - 1) n = v_add(n, seg_normal(ax, i));
    v_norm(n)
}

seg_normal(ax: V3, i: int): V3 {
    du: f32 = prof_u[i + 1] - prof_u[i];
    dy: f32 = prof_y[i + 1] - prof_y[i];
    v_norm(v_add(v_scale(ax, -dy), v_scale(UP, du)))
}

// ---- small parts ----
// A steel plate on the ground where a ramp meets it, from its foot out by
// PLATE, tapering to nothing: across w, at foot o, out along out.
const PLATE: f32 = 0.3;

const RAMP_LIFT: f32 = 0.012;

put_plate(
    m: *Mesh,
    o: V3,
    out: V3,
    w: f32
) {
    r: V3 = v_norm(v_cross(out, UP));
    hw: f32 = w * 0.5;
    a: V3 = v_madd(o, r, -hw);
    b: V3 = v_madd(o, r, hw);
    c: V3 = v_madd(b, out, PLATE);
    d: V3 = v_madd(a, out, PLATE);
    a.y = RAMP_LIFT;
    b.y = RAMP_LIFT;
    face_out(m, a, b, c, d, UP, galv, MAT_METAL, true, true)
}

// Steel coping along a deck's edge, from a to b; it can be ground.
put_coping(m: *Mesh, a: V3, b: V3) {
    put_tube(m, a, b, 0.03, galv, MAT_METAL);
    add_grind(a, b, 0.03)
}

// A galvanized railing from a to b on top of something (a and b at its
// foot), h high: posts, a top and a bottom rail, and bars between.
put_railing(
    m: *Mesh,
    a: V3,
    b: V3,
    h: f32
) {
    along: V3 = v_sub(b, a);
    len: f32 = v_len(along);
    if (len < 0.05) return;
    f: V3 = v_scale(along, 1.0 / len);
    r: V3 = v_norm(v_cross(f, UP));
    posts: int = maxi((len / 1.4) as int, 1);
    for i in 0..posts + 1 {
        p: V3 = v_madd(a, f, len * i as f32 / posts as f32);
        put_block(m, v_madd(p, UP, h * 0.5), r, UP, f, v3(0.025, h * 0.5, 0.025),
            0.0, galv, MAT_METAL)
    }
    put_tube(m, v_madd(a, UP, h), v_madd(b, UP, h), 0.021, galv, MAT_METAL);
    put_tube(m, v_madd(a, UP, 0.08), v_madd(b, UP, 0.08), 0.016, galv, MAT_METAL);
    bars: int = (len / 0.12) as int;
    for i in 1..bars {
        p: V3 = v_madd(a, f, len * i as f32 / bars as f32);
        put_block(m, v_madd(p, UP, h * 0.5 + 0.04), r, UP, f, v3(0.007, h * 0.5 - 0.04,
            0.007), 0.0, galv, MAT_METAL)
    }
}

maxi(a: int, b: int): int {
    if (a > b) return a;
    b
}

// A box: its middle on the ground at c, its long axis ax, half sizes
// (along, across) hl and hw, h high; its top ridden, its sides solid, steel
// angle along its top edges (ground).
put_box(
    m: *Mesh,
    c: V3,
    ax: V3,
    hl: f32,
    hw: f32,
    h: f32,
    top_col: V3,
    side_col: V3
) {
    r: V3 = v_norm(v_cross(ax, UP));
    corners: []V3 = box_corners;
    sx: []f32 = [-1.0, 1.0, 1.0, -1.0];
    sz: []f32 = [-1.0, -1.0, 1.0, 1.0];
    for k in 0..4 corners[k] = v_add(v_add(c, v_scale(ax, sx[k] * hl)), v_scale(r,
        sz[k] * hw));
    for k in 0..4 {
        n: int = (k + 1) % 4;
        a: V3 = corners[k];
        b: V3 = corners[n];
        out: V3 = v_norm(v_sub(v_scale(v_add(a, b), 0.5), c));
        out.y = 0.0;
        face_out(m, a, b, v_madd(b, UP, h), v_madd(a, UP, h), v_norm(out), side_col,
            MAT_PAINT, true, false)
    }
    t: []V3 = box_top;
    for k in 0..4 t[k] = v_madd(corners[k], UP, h);
    face_out(m, t[0], t[1], t[2], t[3], UP, top_col, MAT_SKATELITE, true, true);
    // Its edges: steel angle, ground along the long sides.
    for k in 0..4 {
        n: int = (k + 1) % 4;
        put_tube(m, t[k], t[n], 0.012, galv, MAT_METAL);
        if (k % 2 == 0) add_grind(t[k], t[n], 0.0)
    }
}

box_corners: []V3 = new V3[4](V3 { x: 0.0, y: 0.0, z: 0.0 });

box_top: []V3 = new V3[4](V3 { x: 0.0, y: 0.0, z: 0.0 });

// A bank: a flat slope from the ground at its foot (middle foot, going up
// along up_dir) to a top edge h high, run along the ground, w wide; its
// sides solid down to the ground, and its back, if back, too.
put_bank(
    m: *Mesh,
    foot: V3,
    up_dir: V3,
    run: f32,
    h: f32,
    w: f32,
    col: V3,
    side_col: V3,
    back: bool
) {
    r: V3 = v_norm(v_cross(up_dir, UP));
    hw: f32 = w * 0.5;
    a: V3 = v_madd(foot, r, -hw);
    b: V3 = v_madd(foot, r, hw);
    c: V3 = v_madd(v_madd(b, up_dir, run), UP, h);
    d: V3 = v_madd(v_madd(a, up_dir, run), UP, h);
    a.y = RAMP_LIFT;
    b.y = RAMP_LIFT;
    face_out(m, a, b, c, d, UP, col, MAT_SKATELITE, true, true);
    // The sides: triangles, as quads with two corners together.
    ga: V3 = v3(d.x, 0.0, d.z);
    gb: V3 = v3(c.x, 0.0, c.z);
    face_out(m, a, ga, d, d, v_scale(r, -1.0), side_col, MAT_PAINT, true, false);
    face_out(m, b, gb, c, c, r, side_col, MAT_PAINT, true, false);
    if (back) face_out(m, ga, gb, c, d, up_dir, side_col, MAT_PAINT, true, false);
    put_plate(m, v_madd(foot, up_dir, 0.0), v_scale(up_dir, -1.0), w)
}

// ---- the ramps ----
// A quarter pipe: its foot's middle at foot, facing out (the way he rides
// down it), w wide; its transition of radius r up to h, then a deck deck
// deep; a coping, and railings on the deck's back and sides if rails.
put_quarter(
    m: *Mesh,
    foot: V3,
    out: V3,
    w: f32,
    r: f32,
    h: f32,
    deck: f32,
    face_col: V3,
    side_col: V3,
    rails: int
) {
    ax: V3 = v_scale(out, -1.0);
    prof_reset();
    prof_to(0.0, RAMP_LIFT, PROF_FACE);
    prof_rise(r, h, PROF_VERT);
    reach: f32 = prof_u[nprof - 1];
    prof_to(reach + deck, h, PROF_DECK);
    extrude(m, foot, ax, w, face_col, side_col);
    put_plate(m, foot, out, w);
    rr: V3 = v_norm(v_cross(ax, UP));
    lip: V3 = v_madd(v_madd(foot, ax, reach), UP, h);
    put_coping(m, v_madd(lip, rr, -w * 0.5), v_madd(lip, rr, w * 0.5));
    if (rails > 0) deck_rails(m, lip, ax, rr, w, deck, h, rails)
}

// Railings round a deck from its front edge's middle lip, deck deep along
// ax: along its back (rails & 1), and its sides (rails & 2 the -r side,
// rails & 4 the +r).
deck_rails(
    m: *Mesh,
    lip: V3,
    ax: V3,
    rr: V3,
    w: f32,
    deck: f32,
    h: f32,
    rails: int
) {
    hw: f32 = w * 0.5 - 0.03;
    back: V3 = v_madd(lip, ax, deck - 0.03);
    front: V3 = v_madd(lip, ax, 0.25);
    if ((rails & 1) != 0) put_railing(m, v_madd(back, rr, -hw), v_madd(back, rr, hw),
        1.0);
    if ((rails & 2) != 0) put_railing(m, v_madd(front, rr, -hw), v_madd(back, rr,
        -hw), 1.0);
    if ((rails & 4) != 0) put_railing(m, v_madd(front, rr, hw), v_madd(back, rr, hw),
        1.0)
}

// The halfpipe, along the path on the park's north side: two vert ramps
// facing each other, decks 2.9 m up. Behind the deck of its end by the
// brick wall (the top of the aerial photograph) stands the vert wall,
// facing out into the park: a tight transition, then straight up, black,
// to a railing ("New halfpipe and vert wall", and a drone's photograph of
// it, "Halfpipe at Norton & Malton Skatepark in 2022").
const HP_H: f32 = 3.0;

const HP_W: f32 = 6.4;

const HP_DECK: f32 = 2.7;

const HP_R: f32 = 2.6;

const WALL_R: f32 = 1.7;

put_halfpipe(m: *Mesh) {
    a: V3 = px(1558.0, 2233.0);
    b: V3 = px(1903.0, 2780.0);
    ax: V3 = v_norm(v_sub(b, a));
    len: f32 = v_len(v_sub(b, a));
    prof_reset();
    // Up the vert wall from its foot, out in the park; across the deck.
    prof_to(-HP_DECK - WALL_R, RAMP_LIFT, PROF_FACE);
    prof_rise(WALL_R, HP_H, PROF_VERT);
    prof_to(0.0, HP_H, PROF_DECK);
    // Down into the halfpipe, across its flat, and up its far end.
    prof_fall(HP_R, PROF_FACE);
    prof_to(len - HP_R, RAMP_LIFT, PROF_FLAT);
    prof_rise(HP_R, HP_H, PROF_FACE);
    prof_to(len + HP_DECK, HP_H, PROF_DECK);
    for i in 0..nprof prof_y[i] = maxf(prof_y[i], RAMP_LIFT);
    extrude(m, a, ax, HP_W, skatelite, hdpe_brown);
    r: V3 = v_norm(v_cross(ax, UP));
    out: V3 = v_scale(ax, -1.0);
    put_plate(m, v_madd(a, ax, -HP_DECK - WALL_R), out, HP_W);
    // The copings into the halfpipe; the vert wall's top is railed.
    for e in 0..2 {
        lip: V3 = v_madd(a, UP, HP_H);
        if (e == 1) lip = v_madd(b, UP, HP_H);
        put_coping(m, v_madd(lip, r, -HP_W * 0.5), v_madd(lip, r, HP_W * 0.5))
    }
    deck_rails(m, v_madd(a, UP, HP_H), out, v_norm(v_cross(out, UP)), HP_W, HP_DECK,
        HP_H, 7);
    deck_rails(m, v_madd(b, UP, HP_H), ax, r, HP_W, HP_DECK, HP_H, 7)
}

// The mini ramp, by the warehouse fence: a little halfpipe, 1.5 m, with a
// lower deck beside its east end.
put_mini(m: *Mesh) {
    a: V3 = px(2885.0, 2107.0);
    b: V3 = px(3177.5, 1915.0);
    ax: V3 = v_norm(v_sub(b, a));
    len: f32 = v_len(v_sub(b, a));
    h: f32 = 1.5;
    r: f32 = 1.83;
    w: f32 = 3.7;
    deck: f32 = 1.2;
    reach: f32 = arc_reach(r, h);
    prof_reset();
    prof_to(-deck, h, PROF_DECK);
    prof_to(0.0, h, PROF_DECK);
    prof_fall(r, PROF_FACE);
    prof_to(len - reach, RAMP_LIFT, PROF_FLAT);
    prof_rise(r, h, PROF_VERT);
    prof_to(len + deck, h, PROF_DECK);
    for i in 0..nprof prof_y[i] = maxf(prof_y[i], RAMP_LIFT);
    extrude(m, a, ax, w, skatelite, hdpe_black);
    rr: V3 = v_norm(v_cross(ax, UP));
    for e in 0..2 {
        lip: V3 = v_madd(a, UP, h);
        dir: V3 = v_scale(ax, -1.0);
        if (e == 1) {
            lip = v_madd(b, UP, h);
            dir = ax
        }
        put_coping(m, v_madd(lip, rr, -w * 0.5), v_madd(lip, rr, w * 0.5));
        deck_rails(m, lip, dir, v_norm(v_cross(dir, UP)), w, deck, h, 7)
    }
    // The lower deck, beside its east end: a small quarter facing back down
    // the ramp, 1 m.
    side: V3 = v_scale(rr, -1.0);
    lw: f32 = 1.6;
    lr: f32 = 1.4;
    lh: f32 = 1.0;
    foot: V3 = v_madd(v_madd(b, ax, -arc_reach(lr, lh)), side, (w + lw) * 0.5);
    put_quarter(m, foot, v_scale(ax, -1.0), lw, lr, lh, deck, skatelite, hdpe_black,
        0)
}

// The pyramid funbox against the east wall: a flat top, banks to three
// sides, a ledge along its fourth, and a hubba rail up its south bank.
put_funbox(m: *Mesh) {
    c: V3 = v3(-11.24, 0.0, -7.44);
    e1: V3 = v_norm(v3(0.56, 0.0, -0.83));
    e2: V3 = v_norm(v_cross(UP, e1));
    hl: f32 = 2.32;
    hw: f32 = 1.96;
    h: f32 = 0.6;
    run: f32 = 1.3;
    // The top, and the banks: toward -e1, +e1, and -e2 (the ledge is
    // toward +e2).
    t00: V3 = v_madd(v_madd(v_madd(c, e1, -(hl - run)), e2, -(hw - run)), UP, h);
    t10: V3 = v_madd(v_madd(v_madd(c, e1, hl - run), e2, -(hw - run)), UP, h);
    t11: V3 = v_madd(v_madd(v_madd(c, e1, hl - run), e2, hw), UP, h);
    t01: V3 = v_madd(v_madd(v_madd(c, e1, -(hl - run)), e2, hw), UP, h);
    g00: V3 = v_madd(v_madd(c, e1, -hl), e2, -hw);
    g10: V3 = v_madd(v_madd(c, e1, hl), e2, -hw);
    g11: V3 = v_madd(v_madd(c, e1, hl), e2, hw);
    g01: V3 = v_madd(v_madd(c, e1, -hl), e2, hw);
    g00.y = RAMP_LIFT;
    g10.y = RAMP_LIFT;
    g11.y = RAMP_LIFT;
    g01.y = RAMP_LIFT;
    face_out(m, t00, t10, t11, t01, UP, skatelite, MAT_SKATELITE, true, true);
    // -e2 bank, and the hips to the end banks.
    face_out(m, g00, g10, t10, t00, UP, skatelite, MAT_SKATELITE, true, true);
    face_out(m, g10, g11, t11, t10, UP, skatelite, MAT_SKATELITE, true, true);
    face_out(m, g01, g00, t00, t01, UP, skatelite, MAT_SKATELITE, true, true);
    // Its back, against the ledge.
    face_out(m, v3(g01.x, 0.0, g01.z), v3(g11.x, 0.0, g11.z), t11, t01, e2, hdpe_black,
        MAT_PAINT, true, false);
    put_plate(m, v_madd(c, e2, -hw), v_scale(e2, -1.0), 2.0 * hl);
    put_plate(m, v_madd(c, e1, hl), e1, 2.0 * hw);
    put_plate(m, v_madd(c, e1, -hl), v_scale(e1, -1.0), 2.0 * hw);
    // The ledge: 5.6 m, black, a wooden top, steel along its edges.
    la: V3 = v3(-15.26, 0.0, -6.32);
    lb: V3 = v3(-11.62, 0.0, -10.53);
    lax: V3 = v_norm(v_sub(lb, la));
    put_box(m, v_scale(v_add(la, lb), 0.5), lax, v_len(v_sub(lb, la)) * 0.5, 0.3,
        0.55, v3(0.62, 0.45, 0.28), hdpe_black);
    // The hubba: from the ground up the -e1 bank to the top, a third of a
    // metre above it, on three posts.
    ra: V3 = v3(-13.48, 0.35, -5.43);
    rb: V3 = v3(-11.55, h + 0.35, -8.73);
    put_rail(m, ra, rb, 3)
}

// A round rail from a to b (its top), on n posts down to whatever is
// below; it can be ground.
put_rail(
    m: *Mesh,
    a: V3,
    b: V3,
    n: int
) {
    put_tube(m, a, b, 0.024, galv, MAT_METAL);
    add_grind(a, b, 0.024);
    for i in 0..n {
        t: f32 = (i as f32 + 0.15) / (n as f32 - 0.7);
        if (n == 1) t = 0.5;
        p: V3 = v_lerp(a, b, minf(t, 0.95));
        g: f32 = ground_at(p);
        put_tube(m, v3(p.x, g, p.z), p, 0.022, galv, MAT_METAL);
        put_block(m, v3(p.x, g + 0.006, p.z), v3(1.0, 0.0, 0.0), UP, v3(0.0, 0.0,
            1.0), v3(0.07, 0.006, 0.07), 0.0, galv, MAT_METAL)
    }
}

// How high the solid surfaces are under p (looking down from just below
// it).
ground_at(p: V3): f32 {
    if (surf_cross(v3(p.x, p.y - 0.05, p.z), v3(p.x, -1.0, p.z)) >= 0) return hit_p.y;
    0.0
}

// The L ramp in the north-east corner: a bank and a quarter pipe up to one
// deck, railed behind.
put_l_ramp(m: *Mesh) {
    c: V3 = v3(-4.48, 0.0, -15.82);
    q: V3 = v_norm(v3(0.54, 0.0, 0.84));
    bk: V3 = v_norm(v3(-0.84, 0.0, 0.54));
    h: f32 = 1.2;
    hs: f32 = 1.1;
    // The deck: a square box, its top level with both ramps' tops.
    put_box(m, c, q, hs, hs, h, deck_grey, hdpe_black);
    r: f32 = 2.4;
    foot: V3 = v_madd(c, q, hs + arc_reach(r, h));
    put_quarter(m, foot, q, 2.2, r, h, 0.0, skatelite, hdpe_black, 0);
    put_bank(m, v_madd(c, bk, hs + 3.1), v_scale(bk, -1.0), 3.1, h, 2.2, skatelite,
        hdpe_black, false);
    rr: V3 = v_norm(v_cross(q, UP));
    // Railings along the deck's two back edges.
    back: V3 = v_madd(v_madd(c, q, -hs + 0.03), UP, h);
    side: V3 = v_madd(v_madd(c, bk, -hs + 0.03), UP, h);
    put_railing(m, v_madd(back, bk, -hs), v_madd(back, bk, hs), 1.0);
    put_railing(m, v_madd(side, q, -hs), v_madd(side, q, hs), 1.0);
    lip: V3 = v_madd(v_madd(c, q, hs), UP, h);
    put_coping(m, v_madd(lip, rr, -1.1), v_madd(lip, rr, 1.1))
}

// The volcano spine: a quarter pipe, its back a black panel, and a bank
// beside it to the south-west.
put_volcano(m: *Mesh) {
    out: V3 = v_norm(v3(0.58, 0.0, 0.81));
    foot: V3 = v3(3.75, 0.0, -8.75);
    put_quarter(m, foot, out, 2.2, 2.2, 1.4, 0.25, skatelite, hdpe_black, 0);
    put_bank(m, v3(2.03, 0.0, -8.21), v3(0.0, 0.0, -1.0), 1.5, 0.8, 2.2, skatelite,
        hdpe_black, true)
}

// The two manual pads in the middle, and the flat rail by the jump box.
put_pads(m: *Mesh) {
    a: V3 = v3(-5.47, 0.0, -6.36);
    b: V3 = v3(0.45, 0.0, -4.81);
    put_box(m, v_scale(v_add(a, b), 0.5), v_norm(v_sub(b, a)), v_len(v_sub(b, a)) * 0.5,
        0.53, 0.4, v3(0.56, 0.38, 0.24), hdpe_black);
    a = v3(-5.06, 0.0, -5.26);
    b = v3(-0.83, 0.0, -4.12);
    put_box(m, v_scale(v_add(a, b), 0.5), v_norm(v_sub(b, a)), v_len(v_sub(b, a)) * 0.5,
        0.46, 0.28, v3(0.56, 0.38, 0.24), hdpe_black);
    put_rail(m, v3(-2.69, 0.33, -1.78), v3(-0.69, 0.33, 0.76), 3)
}

// The jump box: a curved kicker, a table, and a long bank down.
put_jumpbox(m: *Mesh) {
    a: V3 = v3(-6.35, 0.0, -1.11);
    b: V3 = v3(-3.18, 0.0, 2.81);
    ax: V3 = v_norm(v_sub(b, a));
    w: f32 = 2.25;
    h: f32 = 0.7;
    r: f32 = 1.56;
    prof_reset();
    prof_to(0.0, RAMP_LIFT, PROF_FACE);
    prof_rise(r, h, PROF_VERT);
    k: f32 = prof_u[nprof - 1];
    prof_to(k + 1.2, h, PROF_DECK);
    prof_to(v_len(v_sub(b, a)), RAMP_LIFT, PROF_FLAT);
    extrude(m, a, ax, w, skatelite, hdpe_black);
    put_plate(m, a, v_scale(ax, -1.0), w);
    put_plate(m, b, ax, w);
    rr: V3 = v_norm(v_cross(ax, UP));
    lip: V3 = v_madd(v_madd(a, ax, k), UP, h);
    put_coping(m, v_madd(lip, rr, -w * 0.5), v_madd(lip, rr, w * 0.5))
}

// The two quarter pipes by the warehouse fence: a 1.15 m one with a railed
// deck, and a small black one with a wooden fence behind it.
put_fence_quarters(m: *Mesh) {
    put_quarter(m, v3(0.87, 0.0, 7.7), v_norm(v3(-0.81, 0.0, -0.59)), 2.4, 1.4, 1.15,
        1.4, skatelite, hdpe_black, 5);
    out: V3 = v_norm(v3(-0.79, 0.0, -0.61));
    foot: V3 = v3(3.79, 0.0, 6.06);
    put_quarter(m, foot, out, 1.5, 1.84, 0.6, 0.8, v3(0.07, 0.07, 0.075), hdpe_black,
        0);
    // The fence: upright slats on a frame, at the deck's back.
    ax: V3 = v_scale(out, -1.0);
    rr: V3 = v_norm(v_cross(ax, UP));
    back: V3 = v_madd(v_madd(foot, ax, arc_reach(1.84, 0.6) + 0.75), UP, 0.6);
    timber: V3 = v3(0.72, 0.6, 0.42);
    for i in 0..9 {
        p: V3 = v_madd(back, rr, -0.7 + 1.4 * i as f32 / 8.0);
        put_block(m, v_madd(p, UP, 0.6), rr, UP, ax, v3(0.045, 0.6, 0.01), 0.004,
            v_scale(timber, 0.85 + 0.2 * cell_jitter(i, 3)), MAT_WOOD)
    }
    for k in 0..2 put_block(m, v_madd(v_madd(back, UP, 0.12 + 1.0 * k as f32), ax,
        0.03), rr, UP, ax, v3(0.75, 0.04, 0.02), 0.004, timber, MAT_WOOD)
}

// ---- the ground and what is round it ----
// The park's asphalt, its edge going round (in metres).
park_edge: []f32 = [-18.4, -6.3, -7.1, -18.2, 0.5, -17.0, 9.9, -9.9, 21.7, -2.2, -3.3,
    15.4, -10.5, 19.6, -14.6, 17.4, -17.9, -2.2];

put_ground(m: *Mesh) {
    n: int = len(park_edge) / 2;
    cx: f32 = 0.0;
    cz: f32 = 0.0;
    for i in 0..n {
        cx = cx + park_edge[i * 2];
        cz = cz + park_edge[i * 2 + 1]
    }
    mid: V3 = v3(cx / n as f32, 0.0, cz / n as f32);
    // In rings out from the middle, so that its shading has vertices to
    // vary over.
    rings: int = 6;
    for i in 0..n {
        j: int = (i + 1) % n;
        p0: V3 = v3(park_edge[i * 2], 0.0, park_edge[i * 2 + 1]);
        p1: V3 = v3(park_edge[j * 2], 0.0, park_edge[j * 2 + 1]);
        for k in 0..rings {
            t0: f32 = k as f32 / rings as f32;
            t1: f32 = (k + 1) as f32 / rings as f32;
            a: V3 = v_lerp(mid, p0, t0);
            b: V3 = v_lerp(mid, p1, t0);
            c: V3 = v_lerp(mid, p1, t1);
            d: V3 = v_lerp(mid, p0, t1);
            face_out(m, a, b, c, d, UP, asphalt_grey, MAT_ASPHALT, true, true)
        }
    }
    // Round it: grass (a skateboard stops dead on it).
    g: f32 = 400.0;
    put_quad(m, v3(-g, GRASS_Y, -g), v3(-g, GRASS_Y, g), v3(g, GRASS_Y, g), v3(g,
        GRASS_Y, -g), UP, v3(0.3, 0.44, 0.2), MAT_GRASS);
    surf_quad(v3(-60.0, GRASS_Y, -60.0), v3(-60.0, GRASS_Y, 60.0), v3(60.0, GRASS_Y,
        60.0), v3(60.0, GRASS_Y, -60.0), true)
}

// The east wall: red brick, a metre and a third, stone along its top.
put_wall(
    m: *Mesh,
    a: V3,
    b: V3,
    h: f32
) {
    f: V3 = v_norm(v_sub(b, a));
    r: V3 = v_norm(v_cross(f, UP));
    t: f32 = 0.18;
    for s in 0..2 {
        sg: f32 = 2.0 * s as f32 - 1.0;
        p: V3 = v_scale(r, sg * t);
        face_out(m, v_add(a, p), v_add(b, p), v_madd(v_add(b, p), UP, h), v_madd(v_add(a,
            p), UP, h), v_scale(r, sg), brick_red, MAT_BRICK, true, false)
    }
    // Stone coping.
    put_block(m, v_madd(v_scale(v_add(a, b), 0.5), UP, h + 0.06), r, UP, f, v3(t + 0.05,
        0.06, v_len(v_sub(b, a)) * 0.5 + 0.03), 0.02, v3(0.7, 0.68, 0.63), MAT_STONE)
}

// A fence of steel bars, h high, from a to b: solid, not ridden.
put_bar_fence(
    m: *Mesh,
    a: V3,
    b: V3,
    h: f32,
    col: V3
) {
    f: V3 = v_norm(v_sub(b, a));
    r: V3 = v_norm(v_cross(f, UP));
    len: f32 = v_len(v_sub(b, a));
    posts: int = maxi((len / 2.4) as int, 1);
    for i in 0..posts + 1 {
        p: V3 = v_madd(a, f, len * i as f32 / posts as f32);
        put_block(m, v_madd(p, UP, h * 0.5 + 0.05), r, UP, f, v3(0.03, h * 0.5 + 0.05,
            0.03), 0.0, col, MAT_PAINT)
    }
    put_block(m, v_madd(v_scale(v_add(a, b), 0.5), UP, h - 0.04), r, UP, f, v3(0.02,
        0.02, len * 0.5), 0.0, col, MAT_PAINT);
    put_block(m, v_madd(v_scale(v_add(a, b), 0.5), UP, 0.1), r, UP, f, v3(0.02, 0.02,
        len * 0.5), 0.0, col, MAT_PAINT);
    bars: int = (len / 0.13) as int;
    for i in 1..bars {
        p: V3 = v_madd(a, f, len * i as f32 / bars as f32);
        put_block(m, v_madd(p, UP, h * 0.5), r, UP, f, v3(0.008, h * 0.5, 0.008),
            0.0, col, MAT_PAINT)
    }
    // As a wall, for riding.
    surf_quad(a, b, v_madd(b, UP, h), v_madd(a, UP, h), false);
    surf_quad(b, a, v_madd(a, UP, h), v_madd(b, UP, h), false)
}

// The warehouse to the west: corrugated steel, a pale green roof.
put_warehouse(m: *Mesh) {
    a: V3 = v3(-2.6, 0.0, 16.6);
    b: V3 = v3(27.4, 0.0, -0.3);
    f: V3 = v_norm(v_sub(b, a));
    // Back from the fence, away from the park.
    r: V3 = v_norm(v_cross(f, UP));
    if (v_dot(r, v3(0.49, 0.0, 0.87)) < 0.0) r = v_scale(r, -1.0);
    depth: f32 = 24.0;
    eave: f32 = 6.0;
    ridge: f32 = 8.2;
    c: V3 = v_madd(a, r, depth);
    d: V3 = v_madd(b, r, depth);
    wall: V3 = v3(0.52, 0.6, 0.6);
    face_out(m, a, b, v_madd(b, UP, eave), v_madd(a, UP, eave), v_scale(r, -1.0),
        wall, MAT_CLAD, false, false);
    face_out(m, c, d, v_madd(d, UP, eave), v_madd(c, UP, eave), r, wall, MAT_CLAD,
        false, false);
    roof: V3 = v3(0.56, 0.67, 0.66);
    ma: V3 = v_madd(v_madd(a, r, depth * 0.5), UP, ridge);
    mb: V3 = v_madd(v_madd(b, r, depth * 0.5), UP, ridge);
    face_out(m, v_madd(a, UP, eave), v_madd(b, UP, eave), mb, ma, v_norm(v_add(UP,
        v_scale(r, -0.3))), roof, MAT_CLAD, false, false);
    face_out(m, v_madd(c, UP, eave), v_madd(d, UP, eave), mb, ma, v_norm(v_add(UP,
        v_scale(r, 0.3))), roof, MAT_CLAD, false, false);
    for e in 0..2 {
        p: V3 = a;
        q: V3 = c;
        o: V3 = v_scale(f, -1.0);
        if (e == 1) {
            p = b;
            q = d;
            o = f
        }
        face_out(m, p, q, v_madd(q, UP, eave), v_madd(p, UP, eave), o, wall, MAT_CLAD,
            false, false);
        tip: V3 = v_madd(v_madd(p, r, depth * 0.5), UP, ridge);
        face_out(m, v_madd(p, UP, eave), v_madd(q, UP, eave), tip, tip, o, wall, MAT_CLAD,
            false, false)
    }
}

// The low building beyond the warehouse, its roof green.
put_shed2(m: *Mesh) {
    f: V3 = v_norm(v3(30.0, 0.0, -16.9));
    r: V3 = v_norm(v_cross(f, UP));
    if (v_dot(r, v3(0.49, 0.0, 0.87)) < 0.0) r = v_scale(r, -1.0);
    c: V3 = v_madd(v_madd(v3(-2.6, 0.0, 16.6), f, 36.0), r, 18.0);
    put_block(m, v_madd(c, UP, 2.6), r, UP, f, v3(9.0, 2.6, 7.0), 0.02, v3(0.6, 0.55,
        0.47), MAT_STONE);
    a0: V3 = v_madd(v_madd(v_madd(c, r, -9.4), f, -7.4), UP, 5.2);
    a1: V3 = v_madd(v_madd(v_madd(c, r, -9.4), f, 7.4), UP, 5.2);
    b0: V3 = v_madd(v_madd(c, f, -7.4), UP, 7.4);
    b1: V3 = v_madd(v_madd(c, f, 7.4), UP, 7.4);
    c0: V3 = v_madd(v_madd(v_madd(c, r, 9.4), f, -7.4), UP, 5.2);
    c1: V3 = v_madd(v_madd(v_madd(c, r, 9.4), f, 7.4), UP, 5.2);
    green: V3 = v3(0.35, 0.55, 0.36);
    face_out(m, a0, a1, b1, b0, v_norm(v_add(UP, v_scale(r, -1.0))), green, MAT_CLAD,
        false, false);
    face_out(m, c0, c1, b1, b0, v_norm(v_add(UP, r)), green, MAT_CLAD, false, false)
}

// The road to the south, and the railway beyond it.
put_road(m: *Mesh) {
    // Along the road fence's line, out past both ends.
    f: V3 = v_norm(v3(11.83, 0.0, 7.71));
    r: V3 = v_norm(v_cross(f, UP));
    o: V3 = v3(9.9, 0.0, -9.9);
    // r points away from the park (south).
    if (v_dot(r, v3(0.42, 0.0, -0.9)) < 0.0) r = v_scale(r, -1.0);
    strip(m, o, f, r, 0.0, 2.2, 0.02, v3(0.58, 0.57, 0.55), MAT_ROAD);
    strip(m, o, f, r, 2.2, 9.6, 0.0, v3(0.24, 0.24, 0.25), MAT_ROAD);
    // The centre line, dashed.
    for i in -12..12 {
        s: f32 = i as f32 * 9.0;
        p: V3 = v_madd(v_madd(o, f, s), r, 5.9);
        put_quad(m, v_madd(v_madd(p, r, -0.05), UP, 0.012), v_madd(v_madd(v_madd(p,
            r, -0.05), f, 4.0), UP, 0.012), v_madd(v_madd(v_madd(p, r, 0.05), f, 4.0),
            UP, 0.012), v_madd(v_madd(p, r, 0.05), UP, 0.012), UP, v3(0.85, 0.85,
            0.82), MAT_ROAD)
    }
    strip(m, o, f, r, 9.6, 12.0, 0.02, v3(0.58, 0.57, 0.55), MAT_ROAD);
    // Red and white bollards along the near kerb.
    for i in -6..4 {
        p: V3 = v_madd(v_madd(o, f, i as f32 * 3.0 + 1.5), r, 2.4);
        for k in 0..4 {
            col: V3 = v3(0.85, 0.12, 0.1);
            if (k % 2 == 1) col = v3(0.92, 0.92, 0.9);
            put_tube(m, v_madd(p, UP, k as f32 * 0.22), v_madd(p, UP, (k + 1) as f32 * 0.22),
                0.06, col, MAT_PAINT)
        }
    }
    // The railway: ballast, sleepers, and two tracks of rails.
    strip(m, o, f, r, 15.0, 26.0, 0.05, v3(0.48, 0.44, 0.4), MAT_STONE);
    for t in 0..2 {
        mid: f32 = 18.0 + 4.0 * t as f32;
        for i in -40..40 {
            p: V3 = v_madd(v_madd(o, f, i as f32 * 0.65), r, mid);
            put_block(m, v_madd(p, UP, 0.1), f, UP, r, v3(0.12, 0.05, 1.3), 0.0, v3(0.3,
                0.26, 0.22), MAT_WOOD)
        }
        for s in 0..2 {
            off: f32 = mid + (2.0 * s as f32 - 1.0) * 0.7175;
            a: V3 = v_madd(v_madd(v_madd(o, f, -30.0), r, off), UP, 0.2);
            b: V3 = v_madd(v_madd(v_madd(o, f, 30.0), r, off), UP, 0.2);
            put_block(m, v_scale(v_add(a, b), 0.5), r, UP, f, v3(0.035, 0.07, 30.0),
                0.0, v3(0.45, 0.32, 0.24), MAT_METAL)
        }
    }
}

// A strip along the road from s0 to s1 out from it, h high, 60 m long.
strip(
    m: *Mesh,
    o: V3,
    f: V3,
    r: V3,
    s0: f32,
    s1: f32,
    h: f32,
    col: V3,
    mat: f32
) {
    a: V3 = v_madd(v_madd(o, r, s0), f, -40.0);
    b: V3 = v_madd(v_madd(o, r, s0), f, 40.0);
    c: V3 = v_madd(v_madd(o, r, s1), f, 40.0);
    d: V3 = v_madd(v_madd(o, r, s1), f, -40.0);
    a.y = h;
    b.y = h;
    c.y = h;
    d.y = h;
    face_out(m, a, b, c, d, UP, col, mat, false, false)
}

// The bus shelter at the gate.
put_shelter(m: *Mesh) {
    a: V3 = v3(9.24, 0.0, -9.57);
    b: V3 = v3(11.55, 0.0, -6.93);
    c: V3 = v_scale(v_add(a, b), 0.5);
    f: V3 = v_norm(v3(0.84, 0.0, 0.55));
    r: V3 = v_norm(v_cross(f, UP));
    dark: V3 = v3(0.12, 0.13, 0.15);
    for i in 0..4 {
        sx: f32 = 2.0 * (i % 2) as f32 - 1.0;
        sz: f32 = 2.0 * (i / 2) as f32 - 1.0;
        p: V3 = v_madd(v_madd(c, f, sx * 1.2), r, sz * 0.7);
        put_block(m, v_madd(p, UP, 1.1), r, UP, f, v3(0.03, 1.1, 0.03), 0.0, dark,
            MAT_METAL)
    }
    put_block(m, v_madd(c, UP, 2.25), r, UP, f, v3(0.85, 0.05, 1.35), 0.02, dark,
        MAT_PAINT);
    put_block(m, v_madd(v_madd(c, r, 0.4), UP, 0.45), r, UP, f, v3(0.2, 0.03, 1.1),
        0.01, v3(0.8, 0.45, 0.2), MAT_PAINT)
}

// A floodlight on a galvanized pole, h high, its lamp turned toward to.
put_floodlight(
    m: *Mesh,
    x: f32,
    z: f32,
    h: f32,
    to: V3
) {
    put_tube(m, v3(x, 0.0, z), v3(x, h, z), 0.07, galv, MAT_METAL);
    d: V3 = v_norm(v3(to.x - x, 0.0, to.z - z));
    r: V3 = v_norm(v_cross(d, UP));
    c: V3 = v_madd(v3(x, h - 0.1, z), d, 0.25);
    put_block(m, c, r, v_norm(v_add(UP, v_scale(d, 0.6))), v_norm(v_sub(d, v_scale(UP,
        0.6))), v3(0.25, 0.08, 0.18), 0.02, v3(0.25, 0.26, 0.27), MAT_METAL)
}

// A shipping container, twenty feet, ribbed and green.
put_container(m: *Mesh, c: V3, f: V3) {
    r: V3 = v_norm(v_cross(f, UP));
    put_block(m, v_madd(c, UP, 1.295), r, UP, f, v3(1.22, 1.295, 3.03), 0.02, v3(0.12,
        0.3, 0.22), MAT_CLAD)
}

// A house beyond the park: brick, a red tiled roof.
put_house(
    m: *Mesh,
    c: V3,
    f: V3,
    w: f32,
    d: f32,
    h: f32,
    k: int
) {
    r: V3 = v_norm(v_cross(f, UP));
    brick: V3 = v_scale(v3(0.6, 0.33, 0.24), 0.85 + 0.25 * cell_jitter(k, 7));
    put_block(m, v_madd(c, UP, h * 0.5), r, UP, f, v3(w * 0.5, h * 0.5, d * 0.5),
        0.02, brick, MAT_BRICK);
    roof: V3 = v_scale(v3(0.62, 0.27, 0.18), 0.85 + 0.25 * cell_jitter(k, 9));
    e: f32 = h;
    t: f32 = h + w * 0.35;
    hw: f32 = w * 0.5 + 0.2;
    hd: f32 = d * 0.5 + 0.2;
    a0: V3 = v_madd(v_madd(v_madd(c, r, -hw), f, -hd), UP, e);
    a1: V3 = v_madd(v_madd(v_madd(c, r, -hw), f, hd), UP, e);
    b0: V3 = v_madd(v_madd(c, f, -hd), UP, t);
    b1: V3 = v_madd(v_madd(c, f, hd), UP, t);
    c0: V3 = v_madd(v_madd(v_madd(c, r, hw), f, -hd), UP, e);
    c1: V3 = v_madd(v_madd(v_madd(c, r, hw), f, hd), UP, e);
    face_out(m, a0, a1, b1, b0, v_norm(v_add(UP, v_scale(r, -1.0))), roof, MAT_PAINT,
        false, false);
    face_out(m, c0, c1, b1, b0, v_norm(v_add(UP, r)), roof, MAT_PAINT, false, false);
    for s in 0..2 {
        sg: f32 = 2.0 * s as f32 - 1.0;
        g0: V3 = v_madd(v_madd(v_madd(c, r, -w * 0.5), f, sg * d * 0.5), UP, e);
        g1: V3 = v_madd(v_madd(v_madd(c, r, w * 0.5), f, sg * d * 0.5), UP, e);
        tip: V3 = v_madd(v_madd(c, f, sg * d * 0.5), UP, t);
        face_out(m, g0, g1, tip, tip, v_scale(f, sg), brick, MAT_BRICK, false, false)
    }
}

// The town round about: rows of houses up the hills, and a church spire.
put_town(m: *Mesh) {
    rng: int = 913;
    for i in 0..70 {
        rng = (rng * 1103515245 + 12345) % 2147483648;
        a: f32 = (rng % 10000) as f32 / 10000.0 * TAU;
        rng = (rng * 1103515245 + 12345) % 2147483648;
        dist: f32 = 70.0 + (rng % 10000) as f32 / 10000.0 * 110.0;
        c: V3 = v3(cosf(a) * dist, 0.0, sinf(a) * dist);
        // Not on the railway's side, nor where the warehouse stands.
        if (v_dot(c, v3(0.42, 0.0, -0.9)) < 25.0 && v_dot(c, v3(0.49, 0.0, 0.87)) < 40.0) {
            f: V3 = v_norm(v3(-sinf(a), 0.0, cosf(a)));
            put_house(m, c, f, 7.0 + 3.0 * cell_jitter(i, 1), 9.0 + 4.0 * cell_jitter(i,
                2), 5.0 + 1.5 * cell_jitter(i, 3), i)
        }
    }
    // The church, east of the park: a stone tower and its spire.
    sp: V3 = v3(-170.0, 0.0, -60.0);
    stone: V3 = v3(0.66, 0.6, 0.5);
    put_block(m, v_madd(sp, UP, 9.0), v3(1.0, 0.0, 0.0), UP, v3(0.0, 0.0, 1.0), v3(2.8,
        9.0, 2.8), 0.05, stone, MAT_STONE);
    put_cone(m, v_madd(sp, UP, 18.0), v_madd(sp, UP, 34.0), 2.4, 0.05, v3(0.5, 0.48,
        0.44));
    // Trees in hedgerows and copses all round, further out.
    for i in 0..90 {
        rng = (rng * 1103515245 + 12345) % 2147483648;
        a: f32 = (rng % 10000) as f32 / 10000.0 * TAU;
        rng = (rng * 1103515245 + 12345) % 2147483648;
        dist: f32 = 45.0 + (rng % 10000) as f32 / 10000.0 * 150.0;
        c: V3 = v3(cosf(a) * dist, 0.0, sinf(a) * dist);
        if (v_dot(c, v3(0.42, 0.0, -0.9)) < 15.0 || v_dot(c, v3(0.42, 0.0, -0.9)) > 34.0) put_far_tree(m,
            c.x, c.z, -0.05, 2.0 + 1.5 * cell_jitter(i, 5), cell_jitter(i, 6) < 0.15)
    }
}

// A big broadleaf tree: a stout trunk and a wide crown of clumps.
put_big_tree(
    m: *Mesh,
    x: f32,
    z: f32,
    size: f32
) {
    meadow_rng = absi_m((x * 73.0) as int * 977 + (z * 31.0) as int * 131 + 7) + 1;
    base: V3 = v3(x, -0.05, z);
    top: V3 = v3(x + (meadow_rand() - 0.5) * 0.6, 4.0 * size, z + (meadow_rand() - 0.5) * 0.6);
    put_cone(m, base, top, 0.35 * size, 0.2 * size, v3(0.3, 0.26, 0.22));
    shade: f32 = 0.85 + 0.3 * meadow_rand();
    leaf: V3 = v_scale(leaf_color, shade);
    clumps: int = 7;
    for k in 0..clumps {
        a: f32 = TAU * (k as f32 + meadow_rand() * 0.5) / clumps as f32;
        out: f32 = 2.2 * size * (0.6 + 0.5 * meadow_rand());
        c: V3 = v_add(top, v3(cosf(a) * out, (1.2 + 2.0 * meadow_rand()) * size, sinf(a) * out));
        put_cone(m, v_lerp(base, top, 0.85), v_lerp(top, c, 0.6), 0.14 * size, 0.06 * size,
            v3(0.3, 0.26, 0.22));
        r: f32 = (2.0 + 0.8 * meadow_rand()) * size;
        put_clump(m, c, v3(r, r * 0.8, r), leaf, 60)
    }
    put_clump(m, v_add(top, v3(0.0, 4.2 * size, 0.0)), v3(2.6 * size, 2.0 * size,
        2.6 * size), leaf, 60)
}

// Where the trees stand, in the photograph's pixels, and how big.
trees: []f32 = [933.0, 700.0, 1.0, 1367.0, 600.0, 1.0, 1700.0, 733.0, 0.9, 1100.0,
    1167.0, 1.0, 1000.0, 1467.0, 1.0, 867.0, 1900.0, 1.0, 967.0, 2300.0, 0.95, 1000.0,
    2650.0, 0.9, 2133.0, 767.0, 0.95, 2420.0, 867.0, 1.0, 2633.0, 1100.0, 0.9, 2830.0,
    1220.0, 1.0, 1867.0, 3233.0, 0.9, 2133.0, 3330.0, 0.85];

// The whole park and what is round it, into m; its surfaces, for riding.
build_site(m: *Mesh) {
    m.n = 0;
    ntris = 0;
    ngrinds = 0;
    // The ground is plain; transitions favor spins, banks and kickers
    // flips.
    surf_item = -1;
    put_ground(m);
    surf_item = FEATURE_PIPE;
    put_halfpipe(m);
    put_mini(m);
    put_fence_quarters(m);
    surf_item = FEATURE_KICKER;
    put_l_ramp(m);
    put_volcano(m);
    put_jumpbox(m);
    surf_item = -1;
    put_pads(m);
    // The funbox's rail stands on the funbox: after it, so that it finds
    // it.
    surf_index();
    surf_item = FEATURE_KICKER;
    put_funbox(m);
    surf_item = -1;
    put_wall(m, v3(-18.43, 0.0, -6.32), v3(-7.14, 0.0, -18.15), 1.3);
    put_wall(m, v3(-7.14, 0.0, -18.15), v3(0.5, 0.0, -17.3), 1.3);
    put_bar_fence(m, v3(9.9, 0.0, -9.9), v3(21.73, 0.0, -2.19), 1.1, galv);
    put_bar_fence(m, v3(21.73, 0.0, -2.19), v3(-3.3, 0.0, 15.39), 1.2, v3(0.1, 0.12,
        0.1));
    put_bar_fence(m, v3(0.5, 0.0, -17.3), v3(9.9, 0.0, -9.9), 1.2, v3(0.1, 0.12, 0.1));
    put_bar_fence(m, v3(-3.3, 0.0, 15.39), v3(-10.5, 0.0, 19.6), 1.2, v3(0.1, 0.12,
        0.1));
    // The low stone wall along the path to the north.
    put_wall(m, v3(-19.26, 0.0, 11.01), v3(-14.31, 0.0, 21.45), 0.5);
    put_wall(m, v3(-18.4, 0.0, -6.3), v3(-19.26, 0.0, 11.01), 1.0);
    put_bar_fence(m, v3(-14.31, 0.0, 21.45), v3(-10.5, 0.0, 19.6), 0.9, v3(0.1, 0.12,
        0.1));
    put_warehouse(m);
    put_road(m);
    put_shelter(m);
    // Floodlights over the park, by the L ramp and by the road.
    put_floodlight(m, -1.2, -17.8, 8.0, v3(0.0, 0.0, 0.0));
    put_floodlight(m, 7.5, -10.2, 8.0, v3(0.0, 0.0, 0.0));
    put_floodlight(m, 17.0, -2.6, 8.0, v3(5.0, 0.0, 5.0));
    put_floodlight(m, -19.6, 3.0, 8.0, v3(0.0, 0.0, 3.0));
    put_container(m, v3(13.6, 0.0, -10.6), v_norm(v3(11.83, 0.0, 7.71)));
    // The warehouse's neighbour, its roof green.
    put_shed2(m);
    put_town(m);
    for i in 0..len(trees) / 3 {
        p: V3 = px(trees[i * 3], trees[i * 3 + 1]);
        put_big_tree(m, p.x, p.z, 1.15 * trees[i * 3 + 2])
    }
    surf_index()
}

// The angle whose cosine is c.
acos_f(c: f32): f32 {
    k: f32 = clampf(c, -1.0, 1.0);
    atan2f(sqrtf(1.0 - k * k), k)
}
