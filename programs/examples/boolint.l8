tag example;

type Flags = {
    enabled: int;
    count: int;
};

choose(on: int): int {
    result: int = 0;
    if (on != 0) { result = 1; }
    result;
}

main(): int {
    flags: Flags = Flags { enabled: 1, count: 2 };
    active: int = choose(flags.enabled);
    if (active != 0) { write(1, "Y\n", 2); }
    flags.count;
}
