tag example;

consume(x: int) {
    if (x < 0) write(2, "bad", 3)
}

main(): int {
    first: int = 1;
    first = 2;
    consume(first);
    second: int = 1;
    second = 2;
    second = 3;
    consume(second);
    kept: int = 1;
    kept = kept + 1;
    consume(kept);
    conditional: int = 1;
    if (true) conditional = 2;
    consume(conditional);
    pointed: int = 1;
    p: *int = &pointed;
    pointed = 2;
    consume(p.*);
    {
        nested: int = 1;
        nested = 2;
        consume(nested)
    }
    delayed: int;
    consume(10);
    delayed = 11;
    consume(delayed);
    branched: int;
    consume(12);
    if (true) branched = 13 else branched = 14;
    consume(branched);
    matched: int;
    choice: int = 1;
    match choice {
        1 -> matched = 15;
        _ -> matched = 16
    }
    consume(matched);
    conditional_write: int;
    if (false) conditional_write = 17;
    conditional_write = 18;
    consume(conditional_write);
    0
}
