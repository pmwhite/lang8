tag example;

putchar(c: i8) {
    write(1, &c, 1)
}

give(s: []i8): ?[]i8@s {
    s
}

none(): ?[]i8 {
    null
}

main(): int {
    a: ?[]i8 = bytes("Y");
    if (a != null) {
        if (len(a) == 1) putchar(a[0])
    }
    b: ?[]i8 = null;
    if (b == null) putchar('Y');
    c: ?[]i8 = give(bytes("Y"));
    d: []i8 = c or bytes("N");
    putchar(d[0]);
    e: ?[]i8 = none();
    f: []i8 = e or bytes("Y");
    putchar(f[0]);
    g: ?[]i8 = a;
    if (g != null && g == a) putchar('Y');
    putchar('\n');
    0
}

//% test: run
//% stdout: "YYYYY\n"
//% exit: 0
