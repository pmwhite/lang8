tag example;

putchar(c: i8) {
    write(1, &c, 1)
}

main(argc: int, argv: []str): int {
    literal: str = "hi";
    if (len(literal) == 2 && literal[0] == 'h' && literal[1] == 'i') putchar('Y');
    if (literal == "hi") putchar('Y');
    if (literal != "ho") putchar('Y');
    raw: []i8 = new i8[2](0i8);
    raw[0] = 'h';
    raw[1] = 'i';
    made: str = cstr(raw);
    if (made == literal) putchar('Y');
    mutable: []i8 = bytes(made);
    mutable[0] = 'Y';
    if (mutable[0] == 'Y' && made[0] == 'h') putchar('Y');
    maybe: ?str = made;
    if (maybe != null && maybe == "hi") putchar('Y');
    left: ?str = "same";
    right: ?str = "same";
    if (left == right) putchar('Y');
    empty_left: ?str = null;
    empty_right: ?str = null;
    if (empty_left == empty_right) putchar('Y');
    if (left != empty_left) putchar('Y');
    none: ?str = null;
    fallback: str = none or "Y";
    putchar(fallback[0]);
    for c in "Y" putchar(c);
    if (argc > 0 && len(argv[0]) > 0) putchar('Y');
    putchar('\n');
    0
}
