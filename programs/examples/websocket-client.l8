tag websocket_example;

use_tag std;

use_tag websocket;

import "../../stdlib/print.l8";

import "../websocket/websocket.l8";

main(argc: int, argv: []str) raises IoError, InvalidRange: int {
    if (argc < 5) {
        eprint("usage: websocket-client HOST PORT TARGET MESSAGE");
        return 2
    }
    optional: ?*WsConnection = ws_client(argv[1], argv[2], argv[3]);
    if (optional == null) {
        eprint("WebSocket handshake failed");
        return 1
    }
    socket: *WsConnection = optional;
    if (!ws_send_text(socket, argv[4])) {
        ws_connection_close(socket);
        return 1
    }
    message: *WsMessage = ws_read(socket);
    ok: bool = message.error == 0 && message.kind == WS_TEXT;
    if (ok) {
        write_bytes_n(1, message.data, message.size);
        write(1, "\n");
        ws_close(socket, 1000, "");
        ws_read(socket)
    }
    ws_connection_close(socket);
    if (!ok) return 1;
    0
}
