tag example;

range_good(): int {
    i: int = 0;
    total: int = 0;
    end: int = 4;
    while (i < end) {
        total = total + i;
        i = i + 1
    }
    total
}

collection_good(xs: []i8): int {
    i: int = 0;
    total: int = 0;
    while (i < len(xs)) {
        item: i8 = xs[i];
        total = total + item as int;
        i = i + 1
    }
    total
}

bound_changes(): int {
    i: int = 0;
    end: int = 3;
    while (i < end) {
        end = end + 1;
        i = i + 1;
        if (i == 3) return end
    }
    end
}

index_used_after(): int {
    i: int = 0;
    while (i < 2) i = i + 1;
    i
}

wrong_step(): int {
    i: int = 0;
    while (i < 4) i = i + 2;
    0
}

main(): int {
    xs: []i8 = new i8[2](1i8);
    if (range_good() != 6 || collection_good(xs) != 2) return 1;
    if (bound_changes() != 6 || index_used_after() != 2 || wrong_step() != 0) return 2;
    0
}
