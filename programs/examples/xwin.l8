tag xwin;

use_tag x11;

import "../stdlib/print.l8";

// Minimal X11 window (no GL) to check Sway/i3 mapping.
import "../x11/x.l8";

main(): int {
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        std::eprint("XOpenDisplay failed");
        return 1
    }
    dpy: *i8 = d0;
    scr: int = XDefaultScreen(dpy);
    root: int = XRootWindow(dpy, scr);
    black: int = XBlackPixel(dpy, scr);
    white: int = XWhitePixel(dpy, scr);
    win: int = XCreateSimpleWindow(dpy, root, 0, 0, 400, 300, 1, black, white);
    XStoreName(dpy, win, "L8 xwin");
    XSelectInput(dpy, win, 32769);
    XMapRaised(dpy, win);
    XFlush(dpy);
    std::eprint("L8 xwin mapped");
    ev: XEvent = XEvent.Other;
    for n in 0..200000000 {
        while (XPending(dpy) != 0) XNextEvent(dpy, &ev)
    }
    0
}
