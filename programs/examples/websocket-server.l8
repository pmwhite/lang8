tag websocket_example;

use_tag http, websocket;

import "../websocket/websocket.l8";

extern l8_fork(): int;

extern l8_waitpid(pid: i32, status: *i32, options: i32): int;

extern l8_exit(code: int): noreturn;

serve(fd: int) {
    reader: *HttpReader = http_reader(fd, true);
    request: *HttpMessage = http_receive_request(reader);
    optional: ?*WsConnection = ws_accept(reader, request);
    if (optional != null) {
        socket: *WsConnection = optional;
        running: bool = true;
        while (running) {
            region {
                message: *WsMessage = ws_read(socket);
                if (message.error != 0 || message.kind == WS_CLOSE) running = false else {
                    if (!ws_send(socket, message.kind, message.data, message.size)) running = false
                }
            }
        }
        ws_connection_close(socket)
    } else http_close(reader)
}

main(argc: int, argv: []str): int {
    port: str = "8081";
    host: str = "127.0.0.1";
    if (argc > 1) port = argv[1];
    if (argc > 2) host = argv[2];
    listener: int = http_listen(host, port);
    if (listener < 0) {
        write(2, "listen failed\n", 14);
        return 1
    }
    workers: int = 0;
    write(1, "ready\n", 6);
    while (true) {
        status: i32 = 0i32;
        while (workers > 0 && l8_waitpid(-1i32, &status, 1i32) > 0) workers = workers - 1;
        if (workers >= 64 && l8_waitpid(-1i32, &status, 0i32) > 0) workers = workers - 1;
        fd: int = http_accept(listener);
        if (fd < 0) {
            http_close_fd(listener);
            return 1
        }
        pid: int = l8_fork();
        if (pid == 0) {
            http_close_fd(listener);
            serve(fd);
            l8_exit(0)
        }
        if (pid > 0) workers = workers + 1;
        http_close_fd(fd)
    }
    0
}
