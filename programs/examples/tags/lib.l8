// Every definition belongs to both implementation tags.
tag parser_internal, storage_internal;

tag parser, parser_alias
type TagBox = {
    value: int;
};

tag parser
type TagChoice =
    | Empty
    | Value { value: int };

tag parser
exception TagOops {
    code: int;
};

tag parser, parser_alias
tag_count: int = 7;

import "peer.l8";

tag parser
tag_parse(): int {
    tag_helper() + tag_peer();
}

tag parser
tag_raise() raises TagOops {
    raise TagOops { code: 9 };
}

tag ffi
extern rdtsc(): int;

tag_helper(): int {
    10;
}

// File directives apply to preceding declarations as well.
tag late_internal;
