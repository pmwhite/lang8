tag http_example;

use_tag http;

import "../http/http.l8";

main(argc: int, argv: []str): int {
    if (argc < 4) {
        usage: str = "usage: client HOST PORT TARGET [METHOD] [BODY] [expect|chunked]\n";
        write(2, usage, len(usage));
        return 2
    }
    maybe: ?*HttpClient = http_client(argv[1], argv[2]);
    if (maybe == null) return 1;
    c: *HttpClient = maybe;
    method: str = "GET";
    if (argc > 4) method = argv[4];
    authority: *HttpBuffer = http_buffer();
    // Bracket an IPv6 address in Host while passing its unbracketed form to DNS.
    ipv6: bool = false;
    for ch in argv[1] {
        if (ch == ':') ipv6 = true
    }
    if (ipv6) http_text(authority, "[");
    http_text(authority, argv[1]);
    if (ipv6) http_text(authority, "]");
    http_text(authority, ":");
    http_text(authority, argv[2]);
    request: *HttpMessage = http_request(method, argv[3], http_string(authority));
    request.close = true;
    if (argc > 5) http_text(request.body, argv[5]);
    if (argc > 6 && argv[6] == "expect") http_add(request, "Expect", "100-continue");
    if (argc > 6 && argv[6] == "chunked") {
        request.framing = 2;
        http_trailer(request, "X-Complete", "yes")
    }
    response: *HttpMessage = http_exchange(c, request);
    if (response.error != 0) {
        http_client_close(c);
        write(2, "HTTP exchange failed\n", 21);
        return 1
    }
    write(1, response.body.data, response.body.size);
    http_client_close(c);
    if (response.status >= 400) return 22;
    0
}
