tag http_example;

use_tag std;

use_tag http;

import "../../stdlib/print.l8";

import "../http/http.l8";

main(argc: int, argv: []str) raises IoError, InvalidRange: int {
    if (argc < 4) {
        eprint("usage: client HOST PORT TARGET [METHOD] [BODY] [expect|chunked]");
        return 2
    }
    maybe: ?*HttpClient = http_client(argv[check_index(argv, 1)], argv[check_index(argv,
        2)]);
    if (maybe == null) return 1;
    c: *HttpClient = maybe;
    method: str = "GET";
    if (argc > 4) method = argv[check_index(argv, 4)];
    authority: *HttpBuffer = http_buffer();
    // Bracket an IPv6 address in Host while passing its unbracketed form to DNS.
    ipv6: bool = false;
    for ch in argv[check_index(argv, 1)] {
        if (ch == ':') ipv6 = true
    }
    if (ipv6) http_text(authority, "[");
    http_text(authority, argv[check_index(argv, 1)]);
    if (ipv6) http_text(authority, "]");
    http_text(authority, ":");
    http_text(authority, argv[check_index(argv, 2)]);
    request: *HttpMessage = http_request(method, argv[check_index(argv, 3)], http_string(authority));
    request.close = true;
    if (argc > 5) http_text(request.body, argv[check_index(argv, 5)]);
    if (argc > 6 && argv[check_index(argv, 6)] == "expect") http_add(request, "Expect",
        "100-continue");
    if (argc > 6 && argv[check_index(argv, 6)] == "chunked") {
        request.framing = 2;
        http_trailer(request, "X-Complete", "yes")
    }
    response: *HttpMessage = http_exchange(c, request);
    if (response.error != 0) {
        http_client_close(c);
        eprint("HTTP exchange failed");
        return 1
    }
    write_bytes_n(1, response.body.data, response.body.size);
    http_client_close(c);
    if (response.status >= 400) return 22;
    0
}
