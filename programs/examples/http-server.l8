tag http_example;

use_tag http;

import "../http/http.l8";

extern l8_fork(): int;

extern l8_waitpid(pid: i32, status: *i32, options: i32): int;

extern l8_exit(code: int): noreturn;

// Demonstration origin application. Resource policy belongs here, outside the codec.
http_demo(request: *HttpMessage): *HttpMessage@new {
    response: *HttpMessage = http_response(200);
    http_add(response, "Content-Type", "application/octet-stream");
    if (request.method == "OPTIONS") {
        http_add(response, "Allow", "GET, HEAD, POST, PUT, DELETE, OPTIONS");
        response.status = 204;
        response.reason = http_reason(204)
    } else {
        if (request.method == "GET" || request.method == "HEAD") {
            greeting: []i8 = "Hello from L8 HTTP/1.1\n";
            response = http_representation(request, greeting, len(greeting), "text/plain; charset=utf-8",
                "\"l8-hello-v1\"", 784111777)
        } else {
            if (request.method == "POST" || request.method == "PUT") http_bytes(response.body,
                request.body.data, request.body.size) else {
                if (request.method == "DELETE") {
                    response.status = 204;
                    response.reason = http_reason(204)
                } else {
                    response.status = 501;
                    response.reason = http_reason(501)
                }
            }
        }
    }
    if (request.target == "/chunked" && request.minor > 0) {
        response.framing = 2;
        http_trailer(response, "X-Complete", "yes")
    }
    response
}

http_serve_connection(fd: int) {
    r: *HttpReader = http_reader(fd, true);
    running: bool = true;
    served: int = 0;
    while (running && served < 1000) {
        region {
            request: *HttpMessage = http_receive_request(r);
            if (request.error == -1) running = false else {
                response: *HttpMessage = http_response(500);
                if (request.error != 0) {
                    response.status = request.error;
                    response.reason = http_reason(request.error);
                    response.close = true;
                    http_text(response.body, response.reason);
                    http_text(response.body, "\n")
                } else response = http_demo(request);
                served = served + 1;
                if (served == 1000) response.close = true;
                // Parsing failures can still be answered; output gets a fresh write deadline.
                r.deadline = http_now() + HTTP_TIMEOUT_MS;
                if (!http_send_response(r, request, response) || response.close || request.close) running = false
            }
        }
    }
    http_close(r)
}

main(argc: int, argv: []str): int {
    port: str = "8080";
    host: str = "127.0.0.1";
    if (argc > 1) port = argv[1];
    if (argc > 2) host = argv[2];
    if (argc > 3) HTTP_TIMEOUT_MS = parse_decimal(argv[3]);
    if (parse_decimal(port) < 1 || parse_decimal(port) > 65535 || HTTP_TIMEOUT_MS < 1 || HTTP_TIMEOUT_MS > 600000) return 2;
    listener: int = http_listen(host, port);
    if (listener < 0) {
        write(2, "listen failed\n", 14);
        return 1
    }
    workers: int = 0;
    write(1, "ready\n", 6);
    while (true) {
        // Bound process concurrency; each worker has its own region heap and socket deadline.
        status: i32 = 0i32;
        while (workers > 0 && l8_waitpid(-1i32, &status, 1i32) > 0) workers = workers - 1;
        if (workers >= 64) {
            if (l8_waitpid(-1i32, &status, 0i32) > 0) workers = workers - 1
        }
        fd: int = http_accept(listener);
        if (fd < 0) {
            http_close_fd(listener);
            return 1
        }
        pid: int = l8_fork();
        if (pid == 0) {
            http_close_fd(listener);
            http_serve_connection(fd);
            l8_exit(0)
        }
        if (pid > 0) workers = workers + 1;
        http_close_fd(fd)
    }
}

parse_decimal(s: str): int {
    if (len(s) == 0) return -1;
    n: int = 0;
    for c in s {
        if (c < '0' || c > '9') return -1;
        d: int = c as int - 48;
        if (n > (9223372036854775807 - d) / 10) return -1;
        n = n * 10 + d
    }
    n
}
