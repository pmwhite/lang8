tag tempo;

use_tag std, skate;

// Recording an activity. The page watches the phone's location while one
// is being recorded (or got ready to be), and gives each fix it has as how
// far it is east and north of the one before, and how much higher
// (meters), how sure it is (meters), its speed if the phone measured one,
// and when it was; nothing more. The fixes are smoothed into a position
// and a height kept only to measure the next step from, and what is kept
// of them is how far was gone by each second of moving, and how much
// higher or lower than at the start it was then: a fix is forgotten as
// soon as the next has come.
//
// Moving time counts only while moving (it stops by itself, as at a
// light); a pause by the person stops everything but the clock of
// elapsed time.
//
// A recording is kept (as it is, not where it went) in a file of its own,
// written every few seconds, so that a page that is shut and opened again
// takes it up where it was:
//
//   live SPORT START TZ PAUSED MOVING_MS DIST MAX GAIN LOSS HEIGHTS
//   fine D...        decimeters gone in each second of moving
//   finez Z...       decimeters higher than the second before (if HEIGHTS)
const GPS_OFF: int = 0;

const GPS_LOOKING: int = 1;

const GPS_GOOD: int = 2;

const GPS_WEAK: int = 3;

const GPS_DENIED: int = 4;

const GPS_NONE: int = 5;

// (Not over https: a browser gives a page's location only to a secure
// one.)
const GPS_INSECURE: int = 6;

gps_state: int = 0;

gps_acc: f32 = 0.0;

// (When the last fix came, on the clock.)
gps_seen_ms: int = 0;

// Fixes less sure than this (meters) are not used; under the other, the
// signal is good.
const ACC_USE: f32 = 50.0;

const ACC_GOOD: f32 = 25.0;

// ---- the clock ----
// Milliseconds from 1970: the page says what it is now (or, off a page,
// the system's clock), and the monotonic clock goes on from there. In a
// simulation it goes sim_k times as fast.
clock_base_ms: int = 0;

clock_base_t: f32 = 0.0;

// (Minutes the clock is ahead of UTC where the phone is.)
clock_tz: int = 0;

sim_k: f32 = 1.0;

clock_ms(): int {
    clock_base_ms + ((now_t - clock_base_t) * 1000.0 * sim_k) as int
}

clock_set(ms: int, tz: int) {
    clock_base_ms = ms;
    clock_base_t = now_t;
    clock_tz = tz
}

// Today, where the phone is.
today(): int {
    s: int = clock_ms() / 1000 + clock_tz * 60;
    s / 86400
}

// ---- the recording ----
rec_on: bool = false;

rec_paused: bool = false;

rec_sport: int = 0;

rec_start: int = 0;

rec_tz: int = 0;

rec_moving_ms: int = 0;

rec_dist: f32 = 0.0;

rec_max: f32 = 0.0;

// Moving, as far as can be told (not, after some seconds slower than a
// walk), and for how long it has been slow; its speed now (smoothed).
rec_moving: bool = false;

rec_slow_ms: int = 0;

rec_v: f32 = 0.0;

// Decimeters gone by each whole second of moving (from 0 at the start).
const FINE: int = 86400;

fine: []int = new int[FINE](0);

fine_n: int = 1;

// How much higher than at the start it was, by each second of moving
// (decimeters; 0 until a height is known); how much it has climbed and
// descended (meters); and whether any height is known.
fine_z: []int = new int[FINE](0);

rec_gain: f32 = 0.0;

rec_loss: f32 = 0.0;

rec_z_known: bool = false;

// ---- heights ----
// The fix's height as it came (from where the first was: the page gives
// only changes), smoothed (a phone's heights wander); the height the
// recording started at; and the level climbing and descending are
// counted from, which moves only by CLIMB_STEP meters at a time. Heights
// less sure than ZACC_USE meters are not used.
const CLIMB_STEP: f32 = 3.0;

const ZACC_USE: f32 = 20.0;

z_have: bool = false;

z_raw: f32 = 0.0;

z_s: f32 = 0.0;

z_level: f32 = 0.0;

rec_z0: f32 = 0.0;

// (Taken up again after the page was shut: the height then is where it
// was, so the start is worked back from it.)
z_rebase: bool = false;

// A fix's change of height (dz meters), sure to within zacc (less than 0:
// the fix had no height).
height(dz: f32, zacc: f32) {
    if (zacc < 0.0) return;
    z_raw = z_raw + dz;
    if (zacc > ZACC_USE) return;
    if (!z_have) {
        z_have = true;
        z_s = z_raw;
        z_level = z_s
    } else z_s = z_s + (z_raw - z_s) * 0.3;
    if (!rec_on || rec_paused) return;
    if (!rec_z_known || z_rebase) {
        rec_z0 = z_s;
        if (z_rebase) rec_z0 = z_s - fine_z[fine_n - 1] as f32 * 0.1;
        rec_z_known = true;
        z_rebase = false;
        z_level = z_s;
        return
    }
    // (Counted only while moving: standing, a height that wanders is the
    // phone's, and the level follows it without counting.)
    if (z_s - z_level >= CLIMB_STEP) {
        if (rec_moving) rec_gain = rec_gain + z_s - z_level;
        z_level = z_s
    }
    if (z_level - z_s >= CLIMB_STEP) {
        if (rec_moving) rec_loss = rec_loss + z_level - z_s;
        z_level = z_s
    }
}

// How much higher than at the start it is now (decimeters).
rec_z_now(): int {
    if (!rec_z_known || z_rebase) return fine_z[fine_n - 1];
    ((z_s - rec_z0) * 10.0) as int
}

// When the recording was last written to its file (on the clock), and
// whether it is to be now.
live_saved_ms: int = 0;

live_dirty: bool = false;

// ---- the smoothing ----
// The fix as it came (from where the first was), and the smoothed
// position, how unsure it is (meters squared), and when.
f_have: bool = false;

f_zx: f32 = 0.0;

f_zy: f32 = 0.0;

f_px: f32 = 0.0;

f_py: f32 = 0.0;

f_var: f32 = 0.0;

f_t: int = 0;

// When the last fix used came, on the clock.
f_came: int = 0;

f_spd: f32 = -1.0;

f_vpos: f32 = 0.0;

gps_reset() {
    f_have = false;
    f_came = 0;
    f_zx = 0.0;
    f_zy = 0.0;
    f_spd = -1.0;
    f_vpos = 0.0;
    z_have = false;
    z_raw = 0.0
}

// Slower than this (meters a second) is not moving.
move_floor(sport: int): f32 {
    if (sport == S_RIDE) return 1.0;
    0.5
}

// Faster than this a step is taken for a fix gone astray.
move_ceiling(sport: int): f32 {
    if (sport == S_RIDE) return 30.0;
    if (sport == S_RUN) return 11.0;
    6.0
}

// A fix: t on the clock (ms), dx and dy meters east and north of the one
// before, acc how sure (meters), spd its speed (meters a second; less
// than 0 if the phone did not measure one), dz meters higher than the
// one before, sure to within zacc (less than 0: no height).
fix(
    t: int,
    dx: f32,
    dy: f32,
    acc: f32,
    spd: f32,
    dz: f32,
    zacc: f32
) {
    height(dz, zacc);
    f_zx = f_zx + dx;
    f_zy = f_zy + dy;
    gps_acc = acc;
    gps_seen_ms = clock_ms();
    if (acc <= ACC_GOOD) gps_state = GPS_GOOD else gps_state = GPS_WEAK;
    if (acc > ACC_USE) return;
    if (!f_have) {
        f_have = true;
        f_px = f_zx;
        f_py = f_zy;
        f_var = acc * acc;
        f_t = t;
        f_spd = spd;
        return
    }
    dt_ms: int = t - f_t;
    if (dt_ms <= 0) return;
    f_t = t;
    // (No more time between two fixes than passed between their coming: a
    // phone's fixes can say they are farther apart than they were, as the
    // iOS simulator's do.)
    came: int = clock_ms();
    if (f_came > 0) dt_ms = mini(dt_ms, came - f_came + 1000);
    f_came = came;
    dt: f32 = dt_ms as f32 / 1000.0;
    // (How far it may have gone since: from its speed, measured or seen.)
    vq: f32 = f_vpos;
    if (spd >= 0.0) vq = spd;
    f_var = f_var + dt + vq * dt * vq * dt;
    k: f32 = f_var / (f_var + acc * acc);
    ox: f32 = f_px;
    oy: f32 = f_py;
    f_px = f_px + k * (f_zx - f_px);
    f_py = f_py + k * (f_zy - f_py);
    f_var = f_var * (1.0 - k);
    d: f32 = sqrtf((f_px - ox) * (f_px - ox) + (f_py - oy) * (f_py - oy));
    f_vpos = lerpf(f_vpos, d / dt, 0.5);
    // The step: from the measured speed where there is one (it does not
    // wander as positions do), from the positions where not, or over a
    // gap.
    v: f32 = f_vpos;
    if (spd >= 0.0) v = spd;
    ds: f32 = d;
    if (spd >= 0.0 && f_spd >= 0.0 && dt <= 5.0) ds = (spd + f_spd) * 0.5 * dt;
    f_spd = spd;
    went(dt_ms, ds, v, acc <= ACC_GOOD)
}

// dt_ms of the clock, in which ds meters were gone at about v.
went(
    dt_ms: int,
    ds: f32,
    v: f32,
    sure: bool
) {
    if (!rec_on || rec_paused) return;
    dt: f32 = dt_ms as f32 / 1000.0;
    rec_v = rec_v + (v - rec_v) * minf(dt / 3.0, 1.0);
    if (v >= move_floor(rec_sport)) {
        rec_slow_ms = 0;
        rec_moving = true
    } else {
        rec_slow_ms = rec_slow_ms + dt_ms;
        if (rec_slow_ms >= 4000) rec_moving = false
    }
    if (!rec_moving) return;
    // (A step too fast to be gone is a fix astray: the time counts, the
    // distance not.)
    step: f32 = ds;
    if (step > move_ceiling(rec_sport) * dt) step = 0.0;
    go_on(dt_ms, step);
    if (sure && dt <= 5.0) rec_max = maxf(rec_max, minf(rec_v, move_ceiling(rec_sport)))
}

// Moving time and distance on by dt_ms and ds, each second passed noted
// with how far it had gone.
go_on(dt_ms: int, ds: f32) {
    m0: int = rec_moving_ms;
    d0: f32 = rec_dist;
    m1: int = m0 + dt_ms;
    s: int = fine_n;
    while (s * 1000 <= m1 && fine_n < FINE) {
        f: f32 = (s * 1000 - m0) as f32 / dt_ms as f32;
        fine[fine_n] = ((d0 + ds * f) * 10.0) as int;
        fine_z[fine_n] = rec_z_now();
        fine_n = fine_n + 1;
        s = s + 1
    }
    rec_moving_ms = m1;
    rec_dist = d0 + ds;
    live_dirty = true
}

// ---- starting, pausing, finishing ----
rec_begin(sport: int) {
    rec_on = true;
    rec_paused = false;
    rec_sport = sport;
    rec_start = clock_ms() / 1000;
    rec_tz = clock_tz;
    rec_moving_ms = 0;
    rec_dist = 0.0;
    rec_max = 0.0;
    rec_moving = false;
    rec_slow_ms = 0;
    rec_v = 0.0;
    fine[0] = 0;
    fine_z[0] = 0;
    fine_n = 1;
    rec_gain = 0.0;
    rec_loss = 0.0;
    rec_z_known = false;
    z_rebase = false;
    rec_done_s = 0;
    live_dirty = true
}

rec_pause(p: bool) {
    // (Moving time stays as it was shown.)
    if (p && !rec_paused) {
        extra: int = rec_shown_ms() - rec_moving_ms;
        if (extra > 0) go_on(extra, 0.0)
    }
    rec_paused = p;
    rec_moving = false;
    rec_v = 0.0;
    live_dirty = true
}

rec_end() {
    rec_on = false;
    rec_paused = false;
    live_dirty = true
}

// Seconds since it started (pauses and all), up to when it was finished
// (if it has been).
rec_done_s: int = 0;

rec_elapsed(): int {
    to: int = clock_ms() / 1000;
    if (rec_done_s > 0) to = rec_done_s;
    maxi(to - rec_start, 0)
}

// Moving time as shown: as of the last fix, and on since (smoothly, for a
// moment) while it is moving.
rec_shown_ms(): int {
    if (!rec_moving || rec_paused) return rec_moving_ms;
    rec_moving_ms + clampi(clock_ms() - gps_seen_ms, 0, 2500)
}

// Its speed over the last so many seconds of moving (meters a second).
rec_recent_speed(secs: int): f32 {
    n: int = mini(secs, fine_n - 1);
    if (n <= 0) return 0.0;
    (fine[fine_n - 1] - fine[fine_n - 1 - n]) as f32 * 0.1 / n as f32
}

// When (seconds of moving, with its fraction) it had gone dm decimeters.
time_to(dm: f32): f32 {
    lo: int = 0;
    hi: int = fine_n - 1;
    while (lo < hi) {
        mid: int = (lo + hi) / 2;
        if (fine[mid] as f32 >= dm) hi = mid else lo = mid + 1
    }
    if (lo == 0) return 0.0;
    a: f32 = fine[lo - 1] as f32;
    b: f32 = fine[lo] as f32;
    if (b <= a) return lo as f32;
    (lo - 1) as f32 + (dm - a) / (b - a)
}

// The recording, as an activity in the log, named by the bytes from
// `from` up to `to`: its number (-1 if there is no room).
rec_to_log(t: []i8, from: int, to: int): int {
    a: int = new_act(rec_start, rec_tz, rec_sport);
    if (a < 0) return -1;
    secs: int = fine_n - 1;
    act_elapsed[a] = maxi(rec_elapsed(), rec_moving_ms / 1000);
    act_moving[a] = rec_moving_ms / 1000;
    act_dist[a] = (rec_dist * 10.0 + 0.5) as int;
    act_max[a] = (rec_max * 100.0 + 0.5) as int;
    act_name[a] = name_of(t, from, to);
    // Its speed through it, in at most STEPS_MOST steps.
    steps: []int = [5, 10, 15, 20, 30, 45, 60, 90, 120, 180, 300, 600, 1200];
    step: int = 5;
    k: int = 0;
    while (secs / step > STEPS_MOST && k + 1 < len(steps)) {
        k = k + 1;
        step = steps[k]
    }
    act_step[a] = step;
    act_sp0[a] = sp_n;
    for i in 0..secs / step add_sample(a, fine[(i + 1) * step] - fine[i * step]);
    // Its splits: when each whole kilometer and mile was reached.
    for u in 0..2 {
        km: bool = u == 0;
        if (km) act_km0[a] = splits_n else act_mi0[a] = splits_n;
        um: f32 = 1000.0;
        if (!km) um = MILE;
        prev: f32 = 0.0;
        n: int = 1;
        while (n as f32 * um * 10.0 <= fine[fine_n - 1] as f32) {
            at: f32 = time_to(n as f32 * um * 10.0);
            add_split(a, km, (at - prev + 0.5) as int);
            prev = at;
            n = n + 1
        }
    }
    // Its fastest stretches.
    for b in 0..BESTS act_best[a * BESTS + b] = fastest(best_m[rec_sport * BESTS + b] * 10.0);
    // How much it climbed and descended, and its heights along the way.
    act_gain[a] = (rec_gain * 10.0 + 0.5) as int;
    act_loss[a] = (rec_loss * 10.0 + 0.5) as int;
    act_el0[a] = el_n;
    if (rec_z_known) {
        for i in 0..secs / step add_height(a, fine_z[(i + 1) * step])
    }
    sort_log();
    a
}

// The fewest seconds in which dm decimeters were gone (0 if they were
// not).
fastest(dm: f32): int {
    best: int = 0;
    i: int = 0;
    for j in 1..fine_n {
        while (i + 1 < j && (fine[j] - fine[i + 1]) as f32 >= dm) i = i + 1;
        if ((fine[j] - fine[i]) as f32 >= dm && (best == 0 || j - i < best)) best = j - i
    }
    best
}

// ---- keeping the recording ----
write_live() {
    lt_n = 0;
    if (!rec_on) return;
    line_clear();
    line_add("live ");
    line_add(sport_key[rec_sport]);
    line_byte(32);
    line_int(rec_start);
    line_byte(32);
    line_int(rec_tz);
    line_byte(32);
    if (rec_paused) line_byte(49) else line_byte(48);
    line_byte(32);
    line_int(rec_moving_ms);
    line_byte(32);
    line_int((rec_dist * 10.0 + 0.5) as int);
    line_byte(32);
    line_int((rec_max * 100.0 + 0.5) as int);
    line_byte(32);
    line_int((rec_gain * 10.0 + 0.5) as int);
    line_byte(32);
    line_int((rec_loss * 10.0 + 0.5) as int);
    line_byte(32);
    if (rec_z_known) line_byte(49) else line_byte(48);
    lt_line();
    if (rec_z_known) {
        line_clear();
        line_add("finez");
        for i in 1..fine_n {
            line_byte(32);
            line_int(fine_z[i] - fine_z[i - 1]);
            if (line_n > 4000) {
                for c in 0..line_n {
                    if (lt_n < len(lt)) {
                        lt[lt_n] = line[c];
                        lt_n = lt_n + 1
                    }
                }
                line_clear()
            }
        }
        lt_line()
    }
    line_clear();
    line_add("fine");
    for i in 1..fine_n {
        line_byte(32);
        line_int(fine[i] - fine[i - 1]);
        if (line_n > 4000) {
            for c in 0..line_n {
                if (lt_n < len(lt)) {
                    lt[lt_n] = line[c];
                    lt_n = lt_n + 1
                }
            }
            line_clear()
        }
    }
    lt_line()
}

// A recording kept, from its file's n bytes in lg_t: whether there was
// one. It comes back paused (it was not watched while it was shut).
read_live(n: int): bool {
    lg_to = n;
    lg_i = 0;
    found: bool = false;
    while (lg_i < lg_to) {
        read_word();
        if (word_is("live")) {
            read_word();
            sport: int = S_RUN;
            for s in 0..SPORTS {
                if (word_is(sport_key[s])) sport = s
            }
            rec_begin(sport);
            rec_start = read_int();
            rec_tz = read_int();
            // (Paused or not, it comes back paused.)
            read_word();
            rec_paused = true;
            rec_moving_ms = read_int();
            rec_dist = read_int() as f32 * 0.1;
            rec_max = read_int() as f32 * 0.01;
            rec_gain = read_int() as f32 * 0.1;
            rec_loss = read_int() as f32 * 0.1;
            rec_z_known = read_int() == 1;
            z_rebase = rec_z_known;
            found = true
        }
        if (found && word_is("finez")) {
            k: int = 1;
            fine_z[0] = 0;
            while (!at_line_end() && k < FINE) {
                fine_z[k] = fine_z[k - 1] + read_int();
                k = k + 1
            }
        }
        if (found && word_is("fine")) {
            fine_n = 1;
            fine[0] = 0;
            while (!at_line_end() && fine_n < FINE) {
                fine[fine_n] = fine[fine_n - 1] + read_int();
                fine_n = fine_n + 1
            }
        }
        next_line()
    }
    // (The seconds noted are those of the moving time.)
    if (found) fine_n = mini(fine_n, rec_moving_ms / 1000 + 1);
    found
}

// ---- a simulation, to try it without going out ----
// A course of straight legs with a stop at a crossing, over rolling
// hills; fixes once a second (on the clock) with a few meters of error,
// and speeds and heights as a phone measures them.
sim_on: bool = false;

sim_seed: int = 12345;

sim_t: int = 0;

sim_x: f32 = 0.0;

sim_y: f32 = 0.0;

sim_ex: f32 = 0.0;

sim_ey: f32 = 0.0;

sim_head: f32 = 0.0;

// (The height measured before, and its error.)
sim_z: f32 = 0.0;

sim_ez: f32 = 0.0;

sim_rand(): f32 {
    sim_seed = (sim_seed * 1103515245 + 12345) % 2147483648;
    sim_seed as f32 / 2147483648.0
}

// (Roughly normal, from 0 with 1 to either side.)
sim_normal(): f32 {
    sim_rand() + sim_rand() + sim_rand() + sim_rand() - 2.0
}

// The speed it goes at, s seconds in.
sim_speed(sport: int, s: int): f32 {
    base: f32 = 3.1;
    if (sport == S_RIDE) base = 7.5;
    if (sport == S_WALK) base = 1.4;
    // (Stopped at a crossing for a while, now and then.)
    if (s % 600 >= 300 && s % 600 < 320) return 0.0;
    base * (1.0 + 0.12 * sinf(s as f32 / 70.0) + 0.05 * sinf(s as f32 / 13.0))
}

// The fixes due by now, one a second of the clock.
sim_step() {
    if (!sim_on) return;
    now: int = clock_ms();
    if (sim_t == 0) sim_t = now;
    while (sim_t + 1000 <= now) {
        sim_t = sim_t + 1000;
        s: int = sim_t / 1000 % 100000;
        v: f32 = sim_speed(rec_sport, s);
        sim_head = sim_head + 0.02 * sim_normal();
        if (s % 240 == 0) sim_head = sim_head + 1.4;
        nx: f32 = sim_x + v * cosf(sim_head);
        ny: f32 = sim_y + v * sinf(sim_head);
        // (Its error wanders, a few meters.)
        ex: f32 = sim_ex * 0.9 + 0.8 * sim_normal();
        ey: f32 = sim_ey * 0.9 + 0.8 * sim_normal();
        dx: f32 = nx + ex - (sim_x + sim_ex);
        dy: f32 = ny + ey - (sim_y + sim_ey);
        sim_x = nx;
        sim_y = ny;
        sim_ex = ex;
        sim_ey = ey;
        spd: f32 = maxf(v + 0.15 * sim_normal(), 0.0);
        ez: f32 = sim_ez * 0.9 + 0.5 * sim_normal();
        z: f32 = 25.0 * sinf(s as f32 / 180.0) + ez;
        dz: f32 = z - sim_z;
        sim_z = z;
        sim_ez = ez;
        fix(sim_t, dx, dy, 4.0 + 2.0 * sim_rand(), spd, dz, 6.0)
    }
}
