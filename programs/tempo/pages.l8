tag tempo;

use_tag std, skate;

// The pages: Record, Log and Settings, side by side (a finger slides between
// them), with the bar of tabs over them; an activity's page over all of
// it; and over everything, while recording, the recording (dark).
//
// Everything is laid out as it is drawn, each frame.
//
// The column the pages' things are in.
col_x: f32 = 0.0;

col_w: f32 = 360.0;

layout() {
    w: f32 = view_w() - safe_left - safe_right;
    col_w = minf(w - 36.0, 600.0);
    col_x = safe_left + (w - col_w) * 0.5
}

// Room left at a list's end, for the bar over it.
end_room(): f32 {
    safe_bottom + 120.0
}

const C_GOLD: int = 13933361; // #d49b31

// ---- writing ----
// The line, broken to fit w, from its baseline at y, lh apart: how many
// lines it took.
write_wrapped(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    lh: f32,
    rgb: int,
    a: f32
): int {
    wrap(face, size, line, 0, line_n, w);
    for i in 0..wrap_n p_put(face, size, x, y + i as f32 * lh, line, wrap_from[i],
        wrap_to[i], rgb, a);
    wrap_n
}

// The line, made smaller if it must be to fit w.
write_fit(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    rgb: int,
    a: f32
) {
    s: f32 = size;
    tw: f32 = p_text_w(face, s, line, 0, line_n);
    if (tw > w) s = s * w / tw;
    p_put(face, s, x, y, line, 0, line_n, rgb, a)
}

// Written so that it ends at x; or centered on it.
write_right(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    rgb: int,
    a: f32
) {
    tw: f32 = p_text_w(face, size, line, 0, line_n);
    p_text(face, size, x - tw, y, line, 0, line_n, 0.0, rgb, a)
}

write_mid(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    rgb: int,
    a: f32
) {
    tw: f32 = p_text_w(face, size, line, 0, line_n);
    p_text(face, size, x - tw * 0.5, y, line, 0, line_n, 0.0, rgb, a)
}

line_w(face: int, size: f32): f32 {
    p_text_w(face, size, line, 0, line_n)
}

// A page's big title, and its line under (from line): where the page
// goes on.
page_title(x: f32, y: f32, t: str): f32 {
    p_say(1, 34.0, x, y + 34.0, t, C_INK, 1.0);
    if (line_n == 0) return y + 52.0;
    n: int = write_wrapped(0, 16.0, x, y + 61.0, col_w, 22.0, C_MUTED, 1.0);
    y + 61.0 + (n - 1) as f32 * 22.0 + 16.0
}

// The bar at a page's top, once its title has scrolled away.
top_bar(
    ox: f32,
    scroll: f32,
    from: f32,
    t: []i8,
    tn: int
) {
    a: f32 = clampf((scroll - from) / 24.0, 0.0, 1.0);
    if (a <= 0.0) return;
    w: f32 = view_w();
    h: f32 = safe_top + 50.0;
    p_box(ox, 0.0, w, h, 0.0, C_BG, 0.97 * a);
    p_box(ox, h - 1.0, w, 1.0, 0.0, C_LINE, a);
    size: f32 = 17.0;
    tw: f32 = minf(p_text_w(1, size, t, 0, tn), w - 120.0);
    if (p_text_w(1, size, t, 0, tn) > tw) size = size * tw / p_text_w(1, size, t,
        0, tn);
    p_text(1, size, ox + (w - tw) * 0.5, safe_top + 31.0, t, 0, tn, 0.0, C_INK, a)
}

title_bytes: []i8 = new i8[256](0i8);

title_n: int = 0;

title_from_str(t: str) {
    title_n = mini(len(t), len(title_bytes));
    for i in 0..title_n title_bytes[i] = t[i]
}

title_from_line() {
    title_n = mini(line_n, len(title_bytes));
    for i in 0..title_n title_bytes[i] = line[i]
}

// A section's heading, with the line's words at its right.
heading(
    x: f32,
    y: f32,
    w: f32,
    t: str
) {
    p_str(1, 19.0, x, y + 19.0, t, C_INK, 1.0);
    if (line_n > 0) write_right(0, 14.5, x + w, y + 19.0, C_MUTED, 1.0)
}

// A pill with the line's words in it, picked out if on, its left at x:
// how wide it is.
const PICK_H: f32 = 36.0;

pick_w(size: f32): f32 {
    p_text_w(1, size, line, 0, line_n) + 30.0
}

pick(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    on: bool,
    size: f32,
    on_rgb: int
) {
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.05 * pr;
    fill: int = C_SUNK;
    ink: int = C_INK;
    if (on) {
        fill = on_rgb;
        ink = C_WHITE;
        if (on_rgb == C_INK) ink = C_ON_INK
    }
    cx: f32 = x + w * 0.5;
    cy: f32 = y + PICK_H * 0.5;
    p_box(cx - w * k * 0.5, cy - PICK_H * k * 0.5, w * k, PICK_H * k, PICK_H * k * 0.5,
        mix_rgb(fill, C_INK, 0.12 * pr), 1.0);
    tw: f32 = p_text_w(1, size * k, line, 0, line_n);
    p_put(1, size * k, cx - tw * 0.5, cy + size * 0.36 * k, line, 0, line_n, ink,
        1.0);
    add_button(id, x, y, x + w, y + PICK_H)
}

// A number with its label under, its left at x (value from the line).
stat(
    x: f32,
    y: f32,
    size: f32,
    unit: str,
    label: str,
    ink: int,
    muted: int
) {
    end: f32 = p_text(1, size, x, y + size, line, 0, line_n, 0.0, ink, 1.0);
    if (len(unit) > 0) p_str(1, maxf(size * 0.42, 13.0), end + 4.0, y + size, unit,
        muted, 1.0);
    p_str(0, 13.0, x, y + size + 21.0, label, muted, 1.0)
}

// The GPS, in a word, with a dot of its color: at its right end x.
gps_chip(x: f32, y: f32, dark: bool) {
    rgb: int = C_FAINT;
    word: str = "GPS off";
    if (gps_state == GPS_LOOKING) {
        rgb = C_WARN;
        word = "Finding GPS"
    }
    if (gps_state == GPS_GOOD) {
        rgb = C_GOOD;
        word = "GPS ready"
    }
    if (gps_state == GPS_WEAK) {
        rgb = C_WARN;
        word = "GPS weak"
    }
    if (gps_state == GPS_DENIED) {
        rgb = C_TOMATO;
        word = "Location off"
    }
    if (gps_state == GPS_NONE || gps_state == GPS_INSECURE) {
        rgb = C_TOMATO;
        word = "No location"
    }
    fill: int = C_CARD;
    ink: int = C_INK;
    if (dark) {
        fill = D_CARD;
        ink = D_INK
    }
    tw: f32 = p_str_w(1, 13.5, word);
    w: f32 = tw + 38.0;
    p_box(x - w, y, w, 30.0, 15.0, fill, 1.0);
    // (Its bars: as many as it is sure.)
    p_disc(x - w + 16.0, y + 15.0, 4.5, rgb, 1.0);
    p_say(1, 13.5, x - w + 28.0, y + 20.0, word, ink, 1.0)
}

// ---- Record ----
draw_record(ox: f32) {
    v: int = V_RECORD;
    x: f32 = ox + col_x;
    y: f32 = safe_top + 16.0 - sc_pos[v];
    line_clear();
    line_add("Pick what you are doing, and go.");
    gps_chip(x + col_w, y + 8.0, false);
    y = page_title(x, y, "Record");
    // The sports.
    gap: f32 = 10.0;
    cw: f32 = (col_w - 2.0 * gap) / SPORTS as f32;
    ch: f32 = 96.0;
    for s in 0..SPORTS {
        id: int = B_SPORT + s;
        cx: f32 = x + s as f32 * (cw + gap);
        on: bool = s == pick_sport;
        pr: f32 = pressed(id);
        k: f32 = 1.0 - 0.04 * pr;
        fill: int = C_CARD;
        ink: int = C_INK;
        icon: int = sport_rgb[s];
        if (on) {
            fill = sport_rgb[s];
            ink = C_WHITE;
            icon = C_WHITE
        }
        mx: f32 = cx + cw * 0.5;
        my: f32 = y + ch * 0.5;
        if (on) p_shadow(cx, y, cw, ch, 20.0, 6.0, 16.0, 0.18);
        p_box(mx - cw * k * 0.5, my - ch * k * 0.5, cw * k, ch * k, 20.0, mix_rgb(fill,
            C_INK, 0.08 * pr), 1.0);
        draw_icon(sport_icon(s), mx, y + 38.0, 17.0 * k, icon, 1.0);
        p_str_mid(1, 16.0, mx, y + 79.0, sport_title[s], ink, 1.0);
        add_button(id, cx, y, cx + cw, y + ch)
    }
    y = y + ch + 30.0;
    // Start: a big round button in the sport's color.
    r: f32 = 82.0;
    cx2: f32 = ox + view_w() * 0.5;
    cy2: f32 = y + r + 10.0;
    pr2: f32 = pressed(B_START);
    k2: f32 = 1.0 - 0.05 * pr2;
    rgb: int = sport_rgb[pick_sport];
    p_glow(cx2, cy2, r + 16.0, 1.0, sport_soft[pick_sport], 1.0);
    p_shadow(cx2 - r, cy2 - r, 2.0 * r, 2.0 * r, r, 10.0, 24.0, 0.22);
    p_disc(cx2, cy2, r * k2, mix_rgb(rgb, C_SHADOW, 0.15 * pr2), 1.0);
    p_str_mid(1, 30.0 * k2, cx2, cy2 + 11.0 * k2, "Start", C_WHITE, 1.0);
    add_button(B_START, cx2 - r - 10.0, cy2 - r - 10.0, cx2 + r + 10.0, cy2 + r + 10.0);
    y = cy2 + r + 34.0;
    // What the GPS is doing.
    line_clear();
    if (gps_state == GPS_GOOD || gps_state == GPS_WEAK) {
        line_add("Located within ");
        line_int((gps_acc + 0.5) as int);
        line_add(" m");
        if (gps_state == GPS_WEAK) line_add(" (better outdoors, in the open)")
    }
    if (gps_state == GPS_LOOKING || gps_state == GPS_OFF) line_add("Finding where you are...");
    if (gps_state == GPS_NONE) line_add("This device cannot say where it is, so distance cannot be measured.");
    if (gps_state == GPS_INSECURE) line_add("Location is given only to pages opened over https: open Better from its https address.");
    if (gps_state == GPS_DENIED) {
        y = location_help(x, y - 14.0) + 10.0;
        line_clear()
    }
    wrap(0, 15.0, line, 0, line_n, col_w - 20.0);
    for i in 0..wrap_n {
        tw: f32 = p_text_w(0, 15.0, line, wrap_from[i], wrap_to[i]);
        p_put(0, 15.0, ox + (view_w() - tw) * 0.5, y + i as f32 * 21.0, line, wrap_from[i],
            wrap_to[i], C_MUTED, 1.0)
    }
    y = y + wrap_n as f32 * 21.0 + 22.0;
    // This week, of the sport.
    d: int = today();
    add_up(pick_sport, week_of(d), week_of(d) + 7);
    p_box(x, y, col_w, 104.0, 20.0, C_CARD, 1.0);
    p_say(1, 15.0, x + 18.0, y + 30.0, "This week", C_INK, 1.0);
    line_clear();
    line_int(sum_n);
    line_byte(32);
    line_add(sport_word[pick_sport]);
    if (sum_n != 1) line_byte(115);
    write_right(0, 14.0, x + col_w - 18.0, y + 30.0, C_MUTED, 1.0);
    line_clear();
    line_dist(sum_m);
    stat(x + 18.0, y + 44.0, 24.0, unit_word(), "Distance", C_INK, C_MUTED);
    line_clear();
    line_hours(sum_secs);
    stat(x + col_w * 0.5, y + 44.0, 24.0, "", "Moving time", C_INK, C_MUTED);
    y = y + 104.0 + 14.0;
    sc_most[v] = y + sc_pos[v] + end_room() - view_h();
    title_from_str("Record");
    top_bar(ox, sc_pos[v], 40.0, title_bytes, title_n)
}

// Location refused: how to allow it (an iPhone's way, which is the
// usual case: in Safari, or in the app's own settings), and a button to
// ask again (or to open those settings). Where the page goes on.
location_steps: []str = ["Location is off for Better, so it cannot measure distance. On an iPhone:",
    "1. Settings > Privacy & Security > Location Services: on.", "2. There, Safari Websites: While Using the App, with Precise Location on.",
    "3. In Safari, the aA button > Website Settings > Location: Allow (or Ask).",
    "Then tap Try again (or reload the page)."];

location_steps_app: []str = ["Location is off for Better, so it cannot measure distance.",
    "In Settings, Location: While Using the App, with Precise Location on (Better keeps measuring with the screen locked while you record).",
    "Then come back here."];

location_help(x: f32, y: f32): f32 {
    steps: []str = if (sync_native) location_steps_app else location_steps;
    // (Laid out first, to know how tall the card is.)
    h: f32 = 20.0;
    for k in 0..len(steps) {
        line_clear();
        line_add(steps[k]);
        wrap(0, 14.5, line, 0, line_n, col_w - 36.0);
        h = h + wrap_n as f32 * 20.0 + 6.0
    }
    h = h + 62.0;
    p_box(x, y, col_w, h, 18.0, C_TOMATO_SOFT, 0.45);
    ty: f32 = y + 30.0;
    for k in 0..len(steps) {
        line_clear();
        line_add(steps[k]);
        face: int = 0;
        ink: int = C_INK;
        if (k == 0) face = 1;
        if (k == len(steps) - 1) ink = C_MUTED;
        n: int = write_wrapped(face, 14.5, x + 18.0, ty, col_w - 36.0, 20.0, ink,
            1.0);
        ty = ty + n as f32 * 20.0 + 6.0
    }
    if (sync_native) pill(B_GPS_RETRY, x + 18.0, ty, 160.0, 40.0, "Open Settings",
        15.0, C_INK, C_ON_INK, 1.0) else pill(B_GPS_RETRY, x + 18.0, ty, 130.0, 40.0,
        "Try again", 15.0, C_INK, C_ON_INK, 1.0);
    y + h
}

// ---- the recording ----
// Over everything, dark, up from below by oy.
draw_rec(oy: f32) {
    w: f32 = view_w();
    vh: f32 = view_h();
    p_box(0.0, oy, w, vh + 40.0, 0.0, D_BG, 1.0);
    if (finishing) {
        draw_finish(oy);
        return
    }
    x: f32 = col_x;
    s: int = rec_sport;
    rgb: int = sport_rgb[s];
    y: f32 = oy + safe_top + 14.0;
    // The sport, and the GPS.
    draw_icon(sport_icon(s), x + 14.0, y + 15.0, 12.0, rgb, 1.0);
    p_say(1, 18.0, x + 36.0, y + 22.0, sport_title[s], D_INK, 1.0);
    gps_chip(x + col_w, y, true);
    y = y + 52.0;
    // How it is going: recording, paused, or waiting.
    line_clear();
    dot: int = C_GOOD;
    if (rec_paused) {
        line_add("Paused");
        dot = C_WARN
    } else if (gps_state != GPS_GOOD && gps_state != GPS_WEAK) {
        line_add("Waiting for GPS");
        dot = C_WARN
    } else if (!rec_moving) {
        line_add("Auto-paused: not moving");
        dot = C_WARN
    } else line_add("Recording");
    tw: f32 = line_w(1, 14.0);
    mid: f32 = w * 0.5;
    p_box(mid - tw * 0.5 - 22.0, y, tw + 44.0, 30.0, 15.0, D_CARD, 1.0);
    p_disc(mid - tw * 0.5 - 6.0, y + 15.0, 4.5, dot, 1.0);
    p_put(1, 14.0, mid - tw * 0.5 + 6.0, y + 20.0, line, 0, line_n, D_INK, 1.0);
    y = y + 54.0;
    // The time moving, big.
    big: f32 = minf(86.0, col_w * 0.24);
    line_clear();
    line_time(rec_shown_ms() / 1000);
    write_mid(1, big, mid, y + big * 0.78, D_INK, 1.0);
    y = y + big * 0.78 + 26.0;
    line_clear();
    line_add("Moving time");
    line_dot();
    line_time(rec_elapsed());
    line_add(" in all");
    if (rec_z_known) {
        line_dot();
        line_height(rec_gain);
        line_add(" up")
    }
    write_mid(0, 14.0, mid, y, D_MUTED, 1.0);
    y = y + 30.0;
    // Distance, and speed: now and on average.
    p_box(x, y, col_w, 1.0, 0.0, D_LINE, 1.0);
    y = y + 22.0;
    half: f32 = col_w * 0.5;
    vs: f32 = minf(46.0, col_w * 0.12);
    line_clear();
    line_dist(rec_dist);
    stat(x, y, vs, unit_word(), "Distance", D_INK, D_MUTED);
    line_clear();
    // (Now: the last few seconds of moving.)
    now_v: f32 = rec_recent_speed(8);
    if (!rec_moving || rec_paused) now_v = 0.0;
    line_speed(s, now_v);
    stat(x + half + 10.0, y, vs, speed_unit(s), speed_title_now(s), D_INK, D_MUTED);
    y = y + vs + 50.0;
    line_clear();
    avg: f32 = 0.0;
    if (rec_moving_ms > 0) avg = rec_dist / (rec_moving_ms as f32 / 1000.0);
    line_speed(s, avg);
    stat(x, y, vs * 0.7, speed_unit(s), avg_title(s), D_INK, D_MUTED);
    line_clear();
    if (by_pace(s)) {
        // (The last whole unit's time, or the one under way's so far.)
        u: f32 = unit_m();
        n: int = (rec_dist / u) as int;
        if (n > 0) {
            t0: f32 = time_to((n - 1) as f32 * u * 10.0);
            t1: f32 = time_to(n as f32 * u * 10.0);
            line_time((t1 - t0 + 0.5) as int)
        } else line_none();
        stat(x + half + 10.0, y, vs * 0.7, "", "", D_INK, D_MUTED);
        line_clear();
        if (miles) line_add("Mile ") else line_add("Km ");
        line_int(maxi(n, 1));
        p_put(0, 13.0, x + half + 10.0, y + vs * 0.7 + 21.0, line, 0, line_n, D_MUTED,
            1.0)
    } else {
        line_speed(s, rec_max);
        stat(x + half + 10.0, y, vs * 0.7, speed_unit(s), "Top speed", D_INK, D_MUTED)
    }
    y = y + vs * 0.7 + 46.0;
    // The last minutes' speed.
    bottom: f32 = oy + vh - maxf(safe_bottom, 16.0) - 150.0;
    if (bottom - y > 70.0) live_chart(x, y, col_w, minf(bottom - y - 10.0, 150.0),
        s);
    // What can be done: pause; or go on, or finish (held).
    by: f32 = oy + vh - maxf(safe_bottom, 16.0) - 80.0;
    r: f32 = 42.0;
    if (!rec_paused) {
        pr: f32 = pressed(B_PAUSE);
        p_disc(mid, by, r * (1.0 - 0.06 * pr), mix_rgb(D_INK, D_MUTED, pr * 0.3),
            1.0);
        draw_icon(I_PAUSE, mid, by, 14.0, D_BG, 1.0);
        add_button(B_PAUSE, mid - r - 30.0, by - r - 12.0, mid + r + 30.0, by + r + 12.0);
        p_str_mid(0, 13.0, mid, by + r + 24.0, "Pause", D_MUTED, 1.0)
    } else {
        lx: f32 = mid - 78.0;
        rx: f32 = mid + 78.0;
        pr2: f32 = pressed(B_RESUME);
        p_disc(lx, by, r * (1.0 - 0.06 * pr2), mix_rgb(rgb, C_SHADOW, pr2 * 0.2),
            1.0);
        draw_icon(I_PLAY, lx + 2.0, by, 14.0, C_WHITE, 1.0);
        add_button(B_RESUME, lx - r - 12.0, by - r - 12.0, lx + r + 12.0, by + r + 12.0);
        p_str_mid(0, 13.0, lx, by + r + 24.0, "Resume", D_MUTED, 1.0);
        // (Finish fills round as it is held.)
        held: f32 = clampf(hold_t / HOLD_FOR, 0.0, 1.0);
        p_disc(rx, by, r * (1.0 - 0.06 * held), D_CARD, 1.0);
        if (held > 0.0) p_arc(rx, by, r - 3.0, 4.0, -1.5708, held * 6.2832, D_INK,
            1.0);
        draw_icon(I_STOP, rx, by, 12.0, D_INK, 1.0);
        add_button(B_FINISH, rx - r - 12.0, by - r - 12.0, rx + r + 12.0, by + r + 12.0);
        p_str_mid(0, 13.0, rx, by + r + 24.0, "Hold to finish", D_MUTED, 1.0)
    }
}

speed_title_now(s: int): str {
    if (by_pace(s)) return "Pace now";
    "Speed now"
}

avg_title(s: int): str {
    if (by_pace(s)) return "Average pace";
    "Average speed"
}

// The last five minutes of moving, as a speed: a line with a wash under.
live_chart(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    s: int
) {
    secs: int = 300;
    n: int = fine_n - 1;
    from: int = maxi(n - secs, 0);
    rgb: int = sport_rgb[s];
    p_box(x, y, w, h, 18.0, D_CARD, 1.0);
    p_str(0, 12.5, x + 16.0, y + 24.0, "Last 5 minutes", D_MUTED, 1.0);
    if (n - from < 10) {
        p_str_mid(0, 13.0, x + w * 0.5, y + h * 0.5 + 12.0, "Speed shows here once you are moving",
            D_MUTED, 1.0);
        return
    }
    // (In tens of seconds, each its speed.)
    step: int = 5;
    m: int = (n - from) / step;
    top: f32 = 0.5;
    for i in 0..m {
        v: f32 = (fine[from + (i + 1) * step] - fine[from + i * step]) as f32 * 0.1 / step as f32;
        top = maxf(top, v)
    }
    top = top * 1.15;
    gx: f32 = x + 14.0;
    gw: f32 = w - 28.0;
    gy: f32 = y + 36.0;
    gh: f32 = h - 50.0;
    px: f32 = 0.0;
    py: f32 = 0.0;
    for i in 0..m {
        v2: f32 = (fine[from + (i + 1) * step] - fine[from + i * step]) as f32 * 0.1 / step as f32;
        qx: f32 = gx + gw * (i as f32 + 0.5) / (secs / step) as f32;
        qy: f32 = gy + gh * (1.0 - v2 / top);
        // (A wash under each step: blended, not see-through, so that
        // where they meet does not show.)
        cw: f32 = gw / (secs / step) as f32;
        p_box(qx - cw * 0.5, qy, cw + 0.5, gy + gh - qy, 0.0, mix_rgb(D_CARD, rgb,
            0.22), 1.0);
        if (i > 0) p_line(px, py, qx, qy, 2.0, rgb, 1.0);
        px = qx;
        py = qy
    }
    if (m > 0) p_disc(px, py, 4.0, rgb, 1.0)
}

// Being finished: its name, what it came to, and save (or go on, or
// throw it away).
draw_finish(oy: f32) {
    w: f32 = view_w();
    x: f32 = col_x;
    s: int = rec_sport;
    rgb: int = sport_rgb[s];
    y: f32 = oy + safe_top + 24.0;
    t: str = "Nice run";
    if (s == S_RIDE) t = "Nice ride";
    if (s == S_WALK) t = "Nice walk";
    p_say(1, 34.0, x, y + 34.0, t, D_INK, 1.0);
    calendar(today());
    line_clear();
    line_day_long((rec_start + rec_tz * 60) / 86400, cal_year);
    line_dot();
    line_clock((rec_start / 60 + rec_tz) % 1440);
    p_put(0, 15.0, x, y + 62.0, line, 0, line_n, D_MUTED, 1.0);
    y = y + 86.0;
    draw_field(0, x, y, col_w, 54.0, "Name it", B_FIELD, B_CLEAR);
    y = y + 54.0 + 26.0;
    // What it came to.
    p_box(x, y, col_w, 196.0, 20.0, D_CARD, 1.0);
    half: f32 = (col_w - 36.0) * 0.5;
    line_clear();
    line_dist(rec_dist);
    stat(x + 18.0, y + 22.0, 34.0, unit_word(), "Distance", D_INK, D_MUTED);
    line_clear();
    line_time(rec_moving_ms / 1000);
    stat(x + 18.0 + half, y + 22.0, 34.0, "", "Moving time", D_INK, D_MUTED);
    line_clear();
    avg: f32 = 0.0;
    if (rec_moving_ms > 0) avg = rec_dist / (rec_moving_ms as f32 / 1000.0);
    line_speed(s, avg);
    stat(x + 18.0, y + 110.0, 34.0, speed_unit(s), avg_title(s), D_INK, D_MUTED);
    line_clear();
    line_time(rec_elapsed());
    stat(x + 18.0 + half, y + 110.0, 34.0, "", "Elapsed time", D_INK, D_MUTED);
    y = y + 196.0 + 24.0;
    // Save; or go on; or throw it away (asked twice).
    pill(B_SAVE, x, y, col_w, 58.0, "Save", 19.0, rgb, C_WHITE, 1.0);
    y = y + 58.0 + 12.0;
    pill(B_UNFINISH, x, y, col_w, 50.0, "Resume", 16.0, -1, D_INK, 1.0);
    y = y + 50.0 + 18.0;
    word: str = "Throw it away";
    if (now_t - discard_asked_t < 3.0) {
        word = "Tap again to throw it away";
        busy = true
    }
    pr: f32 = pressed(B_DISCARD);
    p_str_mid(1, 15.0, w * 0.5, y + 20.0, word, mix_rgb(C_TOMATO, D_INK, pr * 0.4),
        1.0);
    add_button(B_DISCARD, x + col_w * 0.2, y - 6.0, x + col_w * 0.8, y + 36.0)
}

// ---- Log ----
draw_log(ox: f32) {
    v: int = V_LOG;
    x: f32 = ox + col_x;
    y: f32 = safe_top + 16.0 - sc_pos[v];
    d: int = today();
    calendar(d);
    month0: int = day_from(cal_year, cal_month, 1);
    add_up(-1, month0, d + 1);
    line_clear();
    if (order_n == 0) line_add("What you record shows here.") else {
        line_dist(sum_m);
        line_byte(32);
        line_add(unit_word());
        line_add(" this month");
        line_dot();
        line_int(sum_n);
        if (sum_n == 1) line_add(" activity") else line_add(" activities")
    }
    y = page_title(x, y, "Log");
    // Which sports.
    px: f32 = x;
    for k in 0..SPORTS + 1 {
        line_clear();
        if (k == 0) line_add("All") else line_add(sport_title[k - 1]);
        pw: f32 = pick_w(14.5);
        on_rgb: int = C_INK;
        if (k > 0) on_rgb = sport_rgb[k - 1];
        pick(B_LOG_SPORT + k, px, y, pw, log_sport == k - 1, 14.5, on_rgb);
        px = px + pw + 8.0
    }
    y = y + PICK_H + 16.0;
    y = week_chart(x, y, col_w) + 26.0;
    if (order_n == 0) {
        p_box(x, y, col_w, 112.0, 20.0, C_CARD, 1.0);
        draw_icon(I_LIST, x + 34.0, y + 42.0, 12.0, C_FAINT, 1.0);
        p_str(1, 18.0, x + 62.0, y + 48.0, "Nothing yet", C_INK, 1.0);
        line_clear();
        line_add("Record a run, a ride or a walk, and it comes here.");
        write_wrapped(0, 14.5, x + 22.0, y + 80.0, col_w - 44.0, 20.0, C_MUTED, 1.0);
        y = y + 112.0 + 20.0
    }
    // The activities, by the week.
    week: int = -100000;
    vh: f32 = view_h();
    for k in 0..order_n {
        a: int = order[k];
        if (log_sport < 0 || act_sport[a] == log_sport) {
            wk: int = week_of(act_day(a));
            if (wk != week) {
                week = wk;
                if (y > -60.0 && y < vh) {
                    add_up(log_sport, wk, wk + 7);
                    line_clear();
                    line_dist(sum_m);
                    line_byte(32);
                    line_add(unit_word());
                    line_dot();
                    line_hours(sum_secs);
                    write_right(0, 14.0, x + col_w, y + 19.0, C_MUTED, 1.0);
                    line_clear();
                    line_week(wk, d);
                    p_put(1, 18.0, x, y + 19.0, line, 0, line_n, C_INK, 1.0)
                }
                y = y + 36.0
            }
            if (y > -140.0 && y < vh) act_card(a, x, y);
            y = y + ACT_CARD_H + 12.0
        }
    }
    sc_most[v] = y + sc_pos[v] + end_room() - view_h();
    title_from_str("Log");
    top_bar(ox, sc_pos[v], 40.0, title_bytes, title_n)
}

// A week's name: This week, Last week, or Sep 29 - Oct 5.
line_week(wk: int, d: int) {
    if (wk == week_of(d)) {
        line_add("This week");
        return
    }
    if (wk == week_of(d) - 7) {
        line_add("Last week");
        return
    }
    line_day_short(wk);
    line_add(" - ");
    line_day_short(wk + 6)
}

// The last WEEKS weeks' distance, a column each (the week picked out
// says what it was).
week_chart(x: f32, y: f32, w: f32): f32 {
    h: f32 = 218.0;
    p_box(x, y, w, h, 20.0, C_CARD, 1.0);
    d: int = today();
    this_week: int = week_of(d);
    rgb: int = C_INK;
    if (log_sport >= 0) rgb = sport_rgb[log_sport];
    // (Each week's, and the most.)
    most: f32 = 0.0;
    for i in 0..WEEKS {
        add_up(log_sport, this_week - 7 * i, this_week - 7 * i + 7);
        wk_m[i] = sum_m;
        wk_n[i] = sum_n;
        wk_s[i] = sum_secs;
        most = maxf(most, sum_m)
    }
    // What it says: the week picked, or this one.
    p: int = week_pick;
    if (p < 0) p = 0;
    line_clear();
    if (week_pick < 0) line_add("This week") else line_week(this_week - 7 * p, d);
    p_put(0, 13.5, x + 18.0, y + 26.0, line, 0, line_n, C_MUTED, 1.0);
    line_clear();
    line_dist(wk_m[p]);
    end: f32 = p_text(1, 28.0, x + 18.0, y + 58.0, line, 0, line_n, 0.0, C_INK, 1.0);
    p_say(1, 14.0, end + 4.0, y + 58.0, unit_word(), C_MUTED, 1.0);
    line_clear();
    line_hours(wk_s[p]);
    line_dot();
    line_int(wk_n[p]);
    if (wk_n[p] == 1) line_add(" activity") else line_add(" activities");
    write_right(0, 13.5, x + w - 18.0, y + 58.0, C_MUTED, 1.0);
    // The axis: a nice number at its top.
    top: f32 = nice_above(maxf(most / unit_m(), 1.0));
    gx: f32 = x + 18.0;
    gw: f32 = w - 36.0 - 30.0;
    gy: f32 = y + 82.0;
    gh: f32 = h - 82.0 - 38.0;
    for g in 0..3 {
        ly: f32 = gy + gh * (1.0 - g as f32 * 0.5);
        p_box(gx, ly, gw, 1.0, 0.0, C_LINE, 1.0);
        line_clear();
        line_num(top * g as f32 * 0.5, 1);
        p_put(0, 11.5, gx + gw + 8.0, ly + 4.0, line, 0, line_n, C_FAINT, 1.0)
    }
    slot: f32 = gw / WEEKS as f32;
    bw: f32 = minf(slot - 6.0, 24.0);
    for i in 0..WEEKS {
        // (Oldest at the left.)
        col: int = WEEKS - 1 - i;
        cx: f32 = gx + slot * (col as f32 + 0.5);
        bh: f32 = gh * minf(wk_m[i] / unit_m() / top, 1.0);
        on: bool = i == week_pick || week_pick < 0 && i == 0;
        fill: int = mix_rgb(C_CARD, rgb, 0.3);
        if (on) fill = rgb;
        if (bh > 0.5) {
            // (Round at its end, square on the baseline.)
            p_box(cx - bw * 0.5, gy + gh - bh, bw, bh, minf(4.0, bh * 0.5), fill,
                1.0);
            if (bh > 4.0) p_box(cx - bw * 0.5, gy + gh - bh * 0.5, bw, bh * 0.5, 0.0,
                fill, 1.0)
        } else p_box(cx - bw * 0.5, gy + gh - 2.0, bw, 2.0, 1.0, C_LINE, 1.0);
        add_button(B_WEEK + i, cx - slot * 0.5, gy - 10.0, cx + slot * 0.5, gy + gh + 30.0);
        // (A month's first week says which month.)
        wk: int = this_week - 7 * i;
        calendar(wk + 6);
        if (cal_day <= 7) p_str_mid(0, 11.5, cx, gy + gh + 20.0, month_short[cal_month - 1],
            C_FAINT, 1.0)
    }
    y + h
}

wk_m: []f32 = new f32[WEEKS](0.0);

wk_n: []int = new int[WEEKS](0);

wk_s: []int = new int[WEEKS](0);

// 1, 2 or 5 times a power of ten, at least v.
nice_above(v: f32): f32 {
    p: f32 = 1.0;
    while (p * 10.0 <= v) p = p * 10.0;
    while (p > v * 10.0) p = p * 0.1;
    if (v <= p) return p;
    if (v <= 2.0 * p) return 2.0 * p;
    if (v <= 5.0 * p) return 5.0 * p;
    10.0 * p
}

const ACT_CARD_H: f32 = 124.0;

act_card(a: int, x: f32, y: f32) {
    id: int = B_ACT + a;
    pr: f32 = pressed(id);
    s: int = act_sport[a];
    h: f32 = ACT_CARD_H;
    p_box(x, y, col_w, h, 20.0, mix_rgb(C_CARD, C_SUNK, pr), 1.0);
    p_disc(x + 36.0, y + 36.0, 20.0, sport_soft[s], 1.0);
    draw_icon(sport_icon(s), x + 36.0, y + 36.0, 11.0, sport_rgb[s], 1.0);
    line_clear();
    line_name(act_name[a]);
    write_fit(1, 17.0, x + 68.0, y + 32.0, col_w - 110.0, C_INK, 1.0);
    line_clear();
    calendar(today());
    line_when(a, cal_year);
    p_put(0, 13.5, x + 68.0, y + 52.0, line, 0, line_n, C_MUTED, 1.0);
    // (A record held: a medal.)
    held: bool = false;
    for b in 0..BESTS {
        if (!held && holds_record(a, b)) held = true
    }
    if (held) draw_icon(I_MEDAL, x + col_w - 26.0, y + 30.0, 9.0, C_GOLD, 1.0);
    cw: f32 = (col_w - 36.0) / 3.0;
    sy: f32 = y + 72.0;
    line_clear();
    line_dist(act_meters(a));
    stat(x + 18.0, sy, 20.0, unit_word(), "Distance", C_INK, C_MUTED);
    line_clear();
    line_speed(s, act_speed(a));
    stat(x + 18.0 + cw, sy, 20.0, speed_unit(s), speed_title(s), C_INK, C_MUTED);
    line_clear();
    line_time(act_moving[a]);
    stat(x + 18.0 + 2.0 * cw, sy, 20.0, "", "Time", C_INK, C_MUTED);
    add_button(id, x, y, x + col_w, y + h)
}

// When it was: Tue, Oct 14 at 7:12 AM (Today, Yesterday).
line_when(a: int, this_year: int) {
    d: int = act_day(a);
    if (d == today()) line_add("Today") else if (d == today() - 1) line_add("Yesterday") else {
        calendar(d);
        line_add(weekday_short[weekday(d)]);
        line_add(", ");
        line_day_short(d);
        if (cal_year != this_year) {
            line_add(", ");
            line_int(cal_year)
        }
    }
    line_add(" at ");
    line_clock(act_minute(a))
}

// ---- an activity's page ----
draw_act(ox: f32) {
    v: int = V_ACT;
    a: int = page_a;
    w: f32 = view_w();
    vh: f32 = view_h();
    p_box(ox, 0.0, w + 40.0, vh, 0.0, C_BG, 1.0);
    // (Its edge's shadow, while it slides.)
    p_shadow(ox - 30.0, 0.0, 30.0, vh, 0.0, 0.0, 24.0, 0.25 * clampf((1.0 - page_t) * 6.0,
        0.0, 1.0));
    chart_x0 = -1.0;
    if (a < 0 || a >= act_n) return;
    s: int = act_sport[a];
    rgb: int = sport_rgb[s];
    x: f32 = ox + col_x;
    y: f32 = safe_top + 70.0 - sc_pos[v];
    // Its sport and when, its name, and how far.
    p_disc(x + 14.0, y + 14.0, 14.0, sport_soft[s], 1.0);
    draw_icon(sport_icon(s), x + 14.0, y + 14.0, 8.0, rgb, 1.0);
    line_clear();
    line_add(sport_title[s]);
    line_dot();
    calendar(today());
    line_when(a, cal_year);
    p_put(1, 14.0, x + 36.0, y + 19.0, line, 0, line_n, C_MUTED, 1.0);
    y = y + 40.0;
    line_clear();
    line_name(act_name[a]);
    n: int = write_wrapped(1, 30.0, x, y + 30.0, col_w, 36.0, C_INK, 1.0);
    title_from_line();
    y = y + 30.0 + (n - 1) as f32 * 36.0 + 24.0;
    line_clear();
    line_dist(act_meters(a));
    end: f32 = p_text(1, 60.0, x, y + 56.0, line, 0, line_n, 0.0, C_INK, 1.0);
    p_say(1, 22.0, end + 8.0, y + 56.0, unit_word(), C_MUTED, 1.0);
    y = y + 56.0 + 28.0;
    // The numbers.
    p_box(x, y, col_w, 184.0, 20.0, C_CARD, 1.0);
    half: f32 = (col_w - 36.0) * 0.5;
    line_clear();
    line_time(act_moving[a]);
    stat(x + 18.0, y + 20.0, 28.0, "", "Moving time", C_INK, C_MUTED);
    line_clear();
    line_speed(s, act_speed(a));
    stat(x + 18.0 + half, y + 20.0, 28.0, speed_unit(s), avg_title(s), C_INK, C_MUTED);
    line_clear();
    line_time(act_elapsed[a]);
    stat(x + 18.0, y + 100.0, 28.0, "", "Elapsed time", C_INK, C_MUTED);
    line_clear();
    if (by_pace(s)) {
        // (Its fastest whole split.)
        km: bool = !miles;
        quick: int = 0;
        for i in 0..split_n(a, km) {
            t: int = split_at(a, km, i);
            if (quick == 0 || t < quick) quick = t
        }
        if (quick > 0) line_time(quick) else line_none();
        if (miles) stat(x + 18.0 + half, y + 100.0, 28.0, "", "Fastest mile", C_INK,
            C_MUTED) else stat(x + 18.0 + half, y + 100.0, 28.0, "", "Fastest km",
            C_INK, C_MUTED)
    } else {
        line_speed(s, act_max[a] as f32 * 0.01);
        stat(x + 18.0 + half, y + 100.0, 28.0, speed_unit(s), "Top speed", C_INK,
            C_MUTED)
    }
    y = y + 184.0 + 16.0;
    y = climb_card(a, x, y, col_w);
    y = speed_chart(a, x, y, col_w) + 16.0;
    y = splits_card(a, x, y, col_w) + 16.0;
    y = bests_card(a, x, y, col_w);
    // Taken out (asked twice).
    word: str = "Delete activity";
    if (now_t - delete_asked_t < 3.0) {
        word = "Tap again to delete";
        busy = true
    }
    y = y + 12.0;
    pill(B_DELETE, x, y, col_w, 48.0, word, 15.0, -1, C_TOMATO, 1.0);
    y = y + 48.0 + 20.0;
    sc_most[v] = y + sc_pos[v] + safe_bottom + 30.0 - vh;
    // The bar over it, and the way back.
    top_bar(ox, sc_pos[v], 30.0, title_bytes, title_n);
    bx: f32 = ox + safe_left + 30.0;
    bby: f32 = safe_top + 25.0;
    pr: f32 = pressed(B_BACK);
    p_shadow(bx - 18.0, bby - 18.0, 36.0, 36.0, 18.0, 2.0, 8.0, 0.1);
    p_disc(bx, bby, 18.0, mix_rgb(C_CARD, C_SUNK, pr), 1.0);
    draw_icon(I_BACK, bx - 1.0, bby, 7.0, C_INK, 1.0);
    add_button(B_BACK, bx - 26.0, bby - 26.0, bx + 26.0, bby + 26.0)
}

// Its speed through it, over its moving time: a line with a wash under
// it, the average across, and (under a finger) what it was there.
speed_chart(
    a: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    h: f32 = 236.0;
    s: int = act_sport[a];
    rgb: int = sport_rgb[s];
    m: int = act_spn[a];
    if (m < 2) h = 84.0;
    p_box(x, y, w, h, 20.0, C_CARD, 1.0);
    p_say(1, 17.0, x + 18.0, y + 32.0, speed_title(s), C_INK, 1.0);
    if (m < 2) {
        p_say(0, 14.0, x + 18.0, y + 62.0, "Too short to show", C_MUTED, 1.0);
        return y + 84.0
    }
    step: f32 = act_step[a] as f32;
    // (Smoothed a little: a step's either side.)
    // (From a little under its slowest to a little over its fastest:
    // stops aside.)
    top: f32 = 0.5;
    low: f32 = 100.0;
    for i in 0..m {
        sv: f32 = smooth_at(a, i) / step;
        top = maxf(top, sv);
        if (sv > move_floor(s)) low = minf(low, sv)
    }
    if (low > top) low = 0.0;
    lo: f32 = maxf(low - (top - low) * 0.6, 0.0);
    top = top + (top - lo) * 0.1;
    gx: f32 = x + 18.0;
    gw: f32 = w - 36.0 - 44.0;
    gy: f32 = y + 52.0;
    gh: f32 = h - 52.0 - 36.0;
    // The grid: speeds the sport says nicely.
    grid_lines(s, gx, gy, gw, gh, lo, top);
    avg: f32 = act_speed(a);
    px: f32 = 0.0;
    py: f32 = 0.0;
    cw: f32 = gw / m as f32;
    for i in 0..m {
        v: f32 = smooth_at(a, i) / step;
        qx: f32 = gx + gw * (i as f32 + 0.5) / m as f32;
        qy: f32 = gy + gh * (1.0 - clampf((v - lo) / (top - lo), 0.0, 1.0));
        p_box(qx - cw * 0.5, qy, cw + 0.4, gy + gh - qy, 0.0, mix_rgb(C_CARD, rgb,
            0.12), 1.0);
        if (i > 0) p_line(px, py, qx, qy, 2.0, rgb, 1.0);
        px = qx;
        py = qy
    }
    // (The average, as a hairline, said at its start.)
    ay: f32 = gy + gh * (1.0 - (avg - lo) / (top - lo));
    p_box(gx, ay, gw, 1.0, 0.0, C_INK, 0.45);
    p_box(gx, ay - 17.0, p_str_w(1, 11.0, "avg") + 10.0, 15.0, 7.5, C_CARD, 0.85);
    p_say(1, 11.0, gx + 5.0, ay - 6.0, "avg", C_INK, 0.75);
    // Its time along the foot.
    line_clear();
    line_add("0:00");
    p_put(0, 11.5, gx, gy + gh + 20.0, line, 0, line_n, C_FAINT, 1.0);
    line_clear();
    line_time(act_moving[a]);
    write_right(0, 11.5, gx + gw, gy + gh + 20.0, C_FAINT, 1.0);
    // Where a finger is.
    chart_x0 = gx - 10.0;
    chart_x1 = gx + gw + 10.0;
    chart_y0 = y;
    chart_y1 = y + h;
    if (scrub_show > 0.01) {
        k: int = clampi(((scrub_x - gx) / gw * m as f32) as int, 0, m - 1);
        v2: f32 = smooth_at(a, k) / step;
        qx2: f32 = gx + gw * (k as f32 + 0.5) / m as f32;
        qy2: f32 = gy + gh * (1.0 - clampf((v2 - lo) / (top - lo), 0.0, 1.0));
        al: f32 = scrub_show;
        p_box(qx2 - 0.5, gy - 6.0, 1.0, gh + 6.0, 0.0, C_INK, 0.5 * al);
        p_disc(qx2, qy2, 6.0, C_CARD, al);
        p_disc(qx2, qy2, 4.0, rgb, al);
        // (What it was: when, how far by then, how fast.)
        gone: f32 = 0.0;
        for i in 0..k + 1 gone = gone + sp[act_sp0[a] + i] as f32 * 0.1;
        line_clear();
        line_time((k + 1) * act_step[a]);
        line_dot();
        line_dist(gone);
        line_byte(32);
        line_add(unit_word());
        line_dot();
        line_speed(s, v2);
        line_byte(32);
        line_add(speed_unit(s));
        tw: f32 = line_w(1, 13.0) + 24.0;
        tx: f32 = clampf(qx2 - tw * 0.5, x + 6.0, x + w - 6.0 - tw);
        p_shadow(tx, y + 8.0, tw, 32.0, 16.0, 3.0, 10.0, 0.18 * al);
        p_box(tx, y + 8.0, tw, 32.0, 16.0, C_INK, al);
        p_put(1, 13.0, tx + 12.0, y + 29.0, line, 0, line_n, C_ON_INK, al)
    }
    y + h
}

// How much it climbed and descended, and how much higher or lower than
// where it started it was along the way (against how far it had gone).
// Where the page goes on.
climb_card(
    a: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    n: int = act_eln[a];
    if (n == 0 && act_gain[a] == 0 && act_loss[a] == 0) return y;
    rgb: int = sport_rgb[act_sport[a]];
    h: f32 = 206.0;
    if (n < 2) h = 72.0;
    p_box(x, y, w, h, 20.0, C_CARD, 1.0);
    p_say(1, 17.0, x + 18.0, y + 32.0, "Elevation", C_INK, 1.0);
    line_clear();
    line_add("Climb ");
    line_height(act_gain[a] as f32 * 0.1);
    line_dot();
    line_add("Descent ");
    line_height(act_loss[a] as f32 * 0.1);
    write_right(0, 13.5, x + w - 18.0, y + 32.0, C_MUTED, 1.0);
    if (n < 2) return y + h + 16.0;
    // (From the start's height, 0; at least 20 m tall, so that a flat
    // course looks flat.)
    b: int = act_el0[a];
    lo: f32 = 0.0;
    hi: f32 = 0.0;
    for i in 0..n {
        lo = minf(lo, el[b + i] as f32 * 0.1);
        hi = maxf(hi, el[b + i] as f32 * 0.1)
    }
    if (hi - lo < 20.0) {
        mid: f32 = (hi + lo) * 0.5;
        lo = mid - 10.0;
        hi = mid + 10.0
    }
    gx: f32 = x + 18.0;
    gw: f32 = w - 36.0 - 56.0;
    gy: f32 = y + 54.0;
    gh: f32 = h - 54.0 - 34.0;
    total: f32 = 0.0;
    for i in 0..mini(n, act_spn[a]) total = total + sp[act_sp0[a] + i] as f32 * 0.1;
    total = maxf(total, 1.0);
    // (Its highest and lowest, against the start's.)
    for g in 0..2 {
        ly: f32 = gy + gh * g as f32;
        p_box(gx, ly, gw, 1.0, 0.0, C_LINE, 1.0);
        v: f32 = hi;
        if (g == 1) v = lo;
        line_clear();
        if (v > 0.5) line_byte(43);
        if (v < -0.5) line_byte(45);
        line_height(absf(v));
        p_put(0, 11.5, gx + gw + 8.0, ly + 4.0, line, 0, line_n, C_FAINT, 1.0)
    }
    sy: f32 = gy + gh * hi / (hi - lo);
    p_box(gx, sy, gw, 1.0, 0.0, C_INK, 0.25);
    gone: f32 = 0.0;
    px: f32 = gx;
    py: f32 = sy;
    fill: int = mix_rgb(C_CARD, rgb, 0.12);
    for i in 0..mini(n, act_spn[a]) {
        gone = gone + sp[act_sp0[a] + i] as f32 * 0.1;
        qx: f32 = gx + gw * gone / total;
        qy: f32 = gy + gh * (hi - el[b + i] as f32 * 0.1) / (hi - lo);
        top: f32 = (py + qy) * 0.5;
        p_box(px, top, maxf(qx - px, 0.6), gy + gh - top, 0.0, fill, 1.0);
        p_line(px, py, qx, qy, 2.0, rgb, 1.0);
        px = qx;
        py = qy
    }
    line_clear();
    line_add("0");
    p_put(0, 11.5, gx, gy + gh + 20.0, line, 0, line_n, C_FAINT, 1.0);
    line_clear();
    line_dist(total);
    line_byte(32);
    line_add(unit_word());
    write_right(0, 11.5, gx + gw, gy + gh + 20.0, C_FAINT, 1.0);
    y + h + 16.0
}

// Step i's distance, with a step either side (decimeters, as a step).
smooth_at(a: int, i: int): f32 {
    m: int = act_spn[a];
    b: int = act_sp0[a];
    t: f32 = sp[b + i] as f32 * 2.0;
    k: f32 = 2.0;
    if (i > 0) {
        t = t + sp[b + i - 1] as f32;
        k = k + 1.0
    }
    if (i + 1 < m) {
        t = t + sp[b + i + 1] as f32;
        k = k + 1.0
    }
    t / k * 0.1
}

// Lines across a chart at speeds the sport says nicely: for a pace, whole
// minutes (or every two, or five); for a speed, round numbers.
grid_lines(
    s: int,
    gx: f32,
    gy: f32,
    gw: f32,
    gh: f32,
    lo: f32,
    top: f32
) {
    if (by_pace(s)) {
        // (Pace: lines near even heights, each at a whole minute, or five
        // when slow.)
        last: int = 0;
        for k in 0..3 {
            v: f32 = lo + (top - lo) * (0.85 - 0.3 * k as f32);
            pace: f32 = unit_m() / v;
            every: f32 = 60.0;
            if (pace > 1200.0) every = 300.0;
            p: int = (pace / every + 0.5) as int * every as int;
            if (p > 0 && p != last) {
                last = p;
                ly: f32 = gy + gh * (1.0 - (unit_m() / p as f32 - lo) / (top - lo));
                if (ly >= gy && ly <= gy + gh) {
                    p_box(gx, ly, gw, 1.0, 0.0, C_LINE, 1.0);
                    line_clear();
                    line_time(p);
                    p_put(0, 11.5, gx + gw + 8.0, ly + 4.0, line, 0, line_n, C_FAINT,
                        1.0)
                }
            }
        }
        p_box(gx, gy + gh, gw, 1.0, 0.0, C_LINE, 1.0);
        return
    }
    unit_top: f32 = top * 3600.0 / unit_m();
    unit_lo: f32 = lo * 3600.0 / unit_m();
    g: f32 = nice_above((unit_top - unit_lo) / 4.0);
    k: int = (unit_lo / g) as int + 1;
    while (g * k as f32 < unit_top) {
        ly: f32 = gy + gh * (1.0 - (g * k as f32 - unit_lo) / (unit_top - unit_lo));
        p_box(gx, ly, gw, 1.0, 0.0, C_LINE, 1.0);
        line_clear();
        line_num(g * k as f32, 1);
        p_put(0, 11.5, gx + gw + 8.0, ly + 4.0, line, 0, line_n, C_FAINT, 1.0);
        k = k + 1
    }
    p_box(gx, gy + gh, gw, 1.0, 0.0, C_LINE, 1.0)
}

// Its splits: each whole mile (or kilometer), and the part after.
splits_card(
    a: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    km: bool = !miles;
    s: int = act_sport[a];
    n: int = split_n(a, km);
    rest_m: f32 = act_meters(a) - n as f32 * unit_m();
    rest_t: int = act_moving[a];
    for i in 0..n rest_t = rest_t - split_at(a, km, i);
    rows: int = n;
    if (rest_m > unit_m() * 0.05 && rest_t > 0) rows = n + 1;
    if (rows == 0) return y - 16.0;
    h: f32 = 70.0 + rows as f32 * 36.0;
    p_box(x, y, w, h, 20.0, C_CARD, 1.0);
    p_say(1, 17.0, x + 18.0, y + 32.0, "Splits", C_INK, 1.0);
    line_clear();
    line_add(speed_unit(s));
    write_right(0, 13.5, x + w - 18.0, y + 32.0, C_MUTED, 1.0);
    // (The fastest split's bar is the longest.)
    fast: f32 = 0.1;
    for i in 0..n fast = maxf(fast, unit_m() / maxi(split_at(a, km, i), 1) as f32);
    if (rows > n) fast = maxf(fast, rest_m / rest_t as f32);
    rgb: int = sport_rgb[s];
    ry: f32 = y + 56.0;
    bx: f32 = x + 128.0;
    bw: f32 = w - 128.0 - 18.0;
    for i in 0..rows {
        m: f32 = unit_m();
        t: int = 0;
        if (i < n) t = split_at(a, km, i) else {
            m = rest_m;
            t = rest_t
        }
        v: f32 = m / maxi(t, 1) as f32;
        line_clear();
        if (i < n) line_int(i + 1) else line_num(m / unit_m(), 2);
        p_put(1, 14.0, x + 18.0, ry + 22.0, line, 0, line_n, C_MUTED, 1.0);
        line_clear();
        line_speed(s, v);
        p_put(1, 15.0, x + 66.0, ry + 22.0, line, 0, line_n, C_INK, 1.0);
        bl: f32 = maxf(bw * v / fast, 6.0);
        p_box(bx, ry + 9.0, bl, 16.0, 4.0, rgb, 0.85);
        ry = ry + 36.0
    }
    y + h
}

// Its fastest stretches, with a medal on any that is the sport's record.
bests_card(
    a: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    s: int = act_sport[a];
    rows: int = 0;
    for b in 0..BESTS {
        if (act_best[a * BESTS + b] > 0) rows = rows + 1
    }
    if (rows == 0) return y;
    h: f32 = 66.0 + rows as f32 * 40.0;
    p_box(x, y, w, h, 20.0, C_CARD, 1.0);
    p_say(1, 17.0, x + 18.0, y + 32.0, "Best efforts", C_INK, 1.0);
    ry: f32 = y + 52.0;
    for b in 0..BESTS {
        secs: int = act_best[a * BESTS + b];
        if (secs > 0) {
            p_say(1, 15.0, x + 18.0, ry + 24.0, best_title[s * BESTS + b], C_INK,
                1.0);
            line_clear();
            line_time(secs);
            line_dot();
            line_speed(s, best_m[s * BESTS + b] / secs as f32);
            line_byte(32);
            line_add(speed_unit(s));
            write_right(0, 14.5, x + w - 48.0, ry + 24.0, C_MUTED, 1.0);
            if (holds_record(a, b)) draw_icon(I_MEDAL, x + w - 28.0, ry + 18.0, 9.0,
                C_GOLD, 1.0);
            ry = ry + 40.0
        }
    }
    y + h + 16.0
}

// ---- Settings ----
draw_settings(ox: f32) {
    v: int = V_YOU;
    x: f32 = ox + col_x;
    y: f32 = safe_top + 16.0 - sc_pos[v];
    d: int = today();
    line_clear();
    if (order_n > 0) {
        line_int(order_n);
        if (order_n == 1) line_add(" activity since ") else line_add(" activities since ");
        first: int = order[order_n - 1];
        calendar(act_day(first));
        line_add(month_title[cal_month - 1]);
        line_byte(32);
        line_int(cal_year)
    } else line_add("Totals and records, once you have some.");
    y = page_title(x, y, "Settings");
    // The units.
    p_say(1, 15.0, x, y + 23.0, "Units", C_INK, 1.0);
    line_clear();
    line_add("Kilometers");
    kw: f32 = pick_w(14.5);
    pick(B_KMS, x + col_w - kw, y, kw, !miles, 14.5, C_INK);
    line_clear();
    line_add("Miles");
    mw: f32 = pick_w(14.5);
    pick(B_MILES, x + col_w - kw - 8.0 - mw, y, mw, miles, 14.5, C_INK);
    y = y + PICK_H + 12.0;
    // Light or dark.
    p_say(1, 15.0, x, y + 23.0, "Appearance", C_INK, 1.0);
    tx: f32 = x + col_w;
    k: int = 2;
    while (k >= 0) {
        line_clear();
        if (k == 0) line_add("Auto");
        if (k == 1) line_add("Light");
        if (k == 2) line_add("Dark");
        tw: f32 = pick_w(14.5);
        tx = tx - tw;
        pick(B_THEME + k, tx, y, tw, theme_pick == k, 14.5, C_INK);
        tx = tx - 8.0;
        k = k - 1
    }
    y = y + PICK_H + 22.0;
    // Each sport done: this year, and all.
    calendar(d);
    year0: int = day_from(cal_year, 1, 1);
    for s in 0..SPORTS {
        add_up(s, -1000000, 1000000);
        if (sum_n > 0) {
            all_n: int = sum_n;
            add_up(s, year0, d + 1);
            // (This year's row only if it is not all of them.)
            two: bool = sum_n != all_n;
            add_up(s, -1000000, 1000000);
            h: f32 = 150.0;
            if (two) h = 232.0;
            p_box(x, y, col_w, h, 20.0, C_CARD, 1.0);
            p_disc(x + 34.0, y + 34.0, 18.0, sport_soft[s], 1.0);
            draw_icon(sport_icon(s), x + 34.0, y + 34.0, 10.0, sport_rgb[s], 1.0);
            p_say(1, 18.0, x + 62.0, y + 41.0, sport_title[s], C_INK, 1.0);
            line_clear();
            line_add("Longest ");
            line_dist(sum_longest);
            line_byte(32);
            line_add(unit_word());
            write_right(0, 13.5, x + col_w - 18.0, y + 41.0, C_MUTED, 1.0);
            totals_row(x, y + 74.0, "All time");
            if (two) {
                add_up(s, year0, d + 1);
                calendar(d);
                line_clear();
                line_add("This year");
                totals_row_line(x, y + 156.0)
            }
            y = y + h + 14.0
        }
    }
    // The records.
    for s in 0..SPORTS {
        rows: int = 0;
        for b in 0..BESTS {
            if (record_of(s, b) > 0) rows = rows + 1
        }
        if (rows > 0) {
            y = y + 10.0;
            line_clear();
            p_say(1, 19.0, x, y + 19.0, sport_title[s], C_INK, 1.0);
            p_say(1, 19.0, x + p_str_w(1, 19.0, sport_title[s]) + 6.0, y + 19.0, "records",
                C_INK, 1.0);
            y = y + 34.0;
            h: f32 = rows as f32 * 58.0 + 8.0;
            p_box(x, y, col_w, h, 20.0, C_CARD, 1.0);
            ry: f32 = y + 4.0;
            for b in 0..BESTS {
                secs: int = record_of(s, b);
                if (secs > 0) {
                    a: int = record_act;
                    id: int = B_RECORD_OF + s * BESTS + b;
                    pr: f32 = pressed(id);
                    if (pr > 0.0) p_box(x + 4.0, ry, col_w - 8.0, 54.0, 16.0, C_SUNK,
                        pr);
                    draw_icon(I_MEDAL, x + 26.0, ry + 27.0, 9.0, C_GOLD, 1.0);
                    p_say(1, 15.5, x + 48.0, ry + 24.0, best_title[s * BESTS + b],
                        C_INK, 1.0);
                    line_clear();
                    line_day_short(act_day(a));
                    calendar(act_day(a));
                    line_add(", ");
                    line_int(cal_year);
                    p_put(0, 13.0, x + 48.0, ry + 43.0, line, 0, line_n, C_MUTED,
                        1.0);
                    line_clear();
                    line_time(secs);
                    write_right(1, 17.0, x + col_w - 18.0, ry + 26.0, C_INK, 1.0);
                    line_clear();
                    line_speed(s, best_m[s * BESTS + b] / secs as f32);
                    line_byte(32);
                    line_add(speed_unit(s));
                    write_right(0, 12.5, x + col_w - 18.0, ry + 43.0, C_MUTED, 1.0);
                    add_button(id, x, ry, x + col_w, ry + 54.0);
                    ry = ry + 58.0
                }
            }
            y = y + h + 14.0
        }
    }
    sc_most[v] = y + sc_pos[v] + end_room() - view_h();
    title_from_str("Settings");
    top_bar(ox, sc_pos[v], 40.0, title_bytes, title_n)
}

// A row of totals, its title from the words given (or the line).
totals_row(x: f32, y: f32, t: str) {
    line_clear();
    line_add(t);
    totals_row_line(x, y)
}

totals_row_line(x: f32, y: f32) {
    p_put(1, 12.5, x + 18.0, y + 2.0, line, 0, line_n, C_FAINT, 1.0);
    cw: f32 = (col_w - 36.0) / 3.0;
    line_clear();
    line_count(sum_n);
    stat(x + 18.0, y + 12.0, 20.0, "", "Activities", C_INK, C_MUTED);
    line_clear();
    line_dist(sum_m);
    stat(x + 18.0 + cw, y + 12.0, 20.0, unit_word(), "Distance", C_INK, C_MUTED);
    line_clear();
    line_hours(sum_secs);
    stat(x + 18.0 + 2.0 * cw, y + 12.0, 20.0, "", "Moving time", C_INK, C_MUTED)
}

// ---- the bar of tabs ----
tab_title: []str = ["Record", "Log", "Settings"];

draw_tabbar() {
    w: f32 = view_w();
    vh: f32 = view_h();
    bw: f32 = minf(w - 32.0 - safe_left - safe_right, 360.0);
    bh: f32 = 62.0;
    bx: f32 = (w - bw) * 0.5;
    by: f32 = vh - maxf(safe_bottom, 14.0) - 4.0 - bh + page_t * (bh + safe_bottom + 40.0);
    p_shadow(bx, by, bw, bh, bh * 0.5, 6.0, 20.0, 0.14);
    p_box(bx, by, bw, bh, bh * 0.5, C_CARD, 0.98);
    p_outline(bx, by, bw, bh, bh * 0.5, 1.0, C_LINE, 1.0);
    iw: f32 = (bw - 12.0) / TABS as f32;
    hx: f32 = bx + 6.0 + clampf(tab_x, 0.0, (TABS - 1) as f32) * iw;
    p_box(hx, by + 6.0, iw, bh - 12.0, (bh - 12.0) * 0.5, C_SUNK, 1.0);
    for t in 0..TABS {
        id: int = B_TAB + t;
        on: f32 = clampf(1.0 - absf(tab_x - t as f32), 0.0, 1.0);
        ink: int = mix_rgb(C_MUTED, C_INK, on);
        k: f32 = 1.0 - 0.08 * pressed(id);
        cx: f32 = bx + 6.0 + iw * (t as f32 + 0.5);
        cy: f32 = by + bh * 0.5 - 7.0;
        icon: int = I_RECORD;
        if (t == 1) icon = I_LIST;
        if (t == 2) icon = I_SETTINGS;
        if (t == 0) draw_icon(icon, cx, cy, 9.0 * k, mix_rgb(ink, sport_rgb[pick_sport],
            on), 1.0) else draw_icon(icon, cx, cy, 9.0 * k, ink, 1.0);
        p_str_mid(1, 12.5 * k, cx, by + bh * 0.5 + 19.0, tab_title[t], ink, 1.0);
        add_button(id, bx + 6.0 + iw * t as f32, by, bx + 6.0 + iw * (t + 1) as f32,
            by + bh)
    }
}

// ---- all of it ----
draw_app() {
    btn_n = 0;
    shown_x0 = -1.0;
    layout();
    w: f32 = view_w();
    vh: f32 = view_h();
    p_box(0.0, 0.0, w, vh, 0.0, C_BG, 1.0);
    if (rec_t < 0.999) {
        // The tabs, side by side; pushed aside a little under a page.
        shift: f32 = -w * 0.28 * page_t;
        if (page_t < 0.999) {
            for t in 0..TABS {
                ox: f32 = (t as f32 - tab_x) * w + shift;
                if (ox > -w && ox < w) {
                    p_clip(ox, 0.0, ox + w, vh);
                    if (t == 0) draw_record(ox);
                    if (t == 1) draw_log(ox);
                    if (t == 2) draw_settings(ox);
                    p_noclip()
                }
            }
            draw_tabbar()
        }
        if (page_t > 0.0) {
            p_box(0.0, 0.0, w, vh, 0.0, C_SHADOW, 0.1 * page_t);
            draw_act((1.0 - page_t) * w)
        }
        // (Buttons under the recording as it comes up are not to be had.)
        if (rec_t > 0.0) btn_n = 0
    }
    if (rec_t > 0.0) {
        k: f32 = 1.0 - rec_t;
        draw_rec(k * k * vh)
    }
    bottom: f32 = vh - maxf(safe_bottom, 14.0) - 80.0;
    if (rec_t > 0.5) bottom = vh - maxf(safe_bottom, 16.0) - 190.0;
    draw_toast(bottom)
}
