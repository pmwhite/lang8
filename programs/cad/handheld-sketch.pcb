# The handheld game controller (~/src/handheld): its parts, placed as
# design.ml places them, and its netlist. Copper is yet to be laid.
board 72 128 4 Handheld
rules 0.15 0.25 0.6 0.3
part U1 rp2040 0 8 0 RP2040
part U2 w25q16 12 8 0 W25Q16
part Y1 xtal3225 -12 8 0 12MHz
part C1 c0603 -12 14 0 12p
part C2 c0603 -12 2 0 12p
part R1 r0603 6 16 0 1k
part C3 c0603 -6 14 0 100n
part C4 c0603 6 14 0 100n
part C5 c0603 -6 2 0 100n
part C6 c0603 6 2 0 100n
part C7 c0603 0 16 0 100n
part C8 c0603 0 0 0 100n
part C9 c0603 12 14 0 100n
part C10 c0603 -10 -22 0 100n
part C11 c0603 6 -18 0 100n
part C12 c0603 -8 -2 0 10u
part C13 c0603 20 8 0 10u
part C14 c0603 -4 -22 0 10u
part J3 fpc14 0 42 0 ER-TFT020-3
part R2 r0603 10 36 0 10R
part Q1 sot23 16 36 0 2N7002
part R3 r0603 16 30 0 100k
part J1 usb4105 0 -58 0 USB4105
part U6 sot23-6 0 -48 0 USBLC6-2SC6
part R4 r0603 -8 -48 0 5.1k
part R5 r0603 8 -48 0 5.1k
part U3 mcp73871 -10 -28 0 MCP73871
part R6 r0603 -16 -28 0 2k
part U4 sot23-5 0 -18 0 AP2112K-3.3
part SW1 ss12d00 0 58 0 SS-12D00
part J2 jst-ph2 -26 -48 0 JST-PH
part F1 ptc1206 -18 -40 0 500mA
part SW2 dome6 -24 4 0 UP
part SW3 dome6 -24 -8 0 DOWN
part SW4 dome6 -30 -2 0 LEFT
part SW5 dome6 -18 -2 0 RIGHT
part SW6 dome6 24 4 0 X
part SW7 dome6 24 -8 0 A
part SW8 dome6 18 -2 0 Y
part SW9 dome6 30 -2 0 B
part SW10 dome6 -24 -36 0 BACK
part SW11 dome6 24 -36 0 HOME
net QSPI_SS 0 U1.QSPI_SS U2.CS
net QSPI_SCLK 0 U1.QSPI_SCLK U2.CLK
net QSPI_SD0 0 U1.QSPI_SD0 U2.DI
net QSPI_SD1 0 U1.QSPI_SD1 U2.DO
net QSPI_SD2 0 U1.QSPI_SD2 U2.IO2
net QSPI_SD3 0 U1.QSPI_SD3 U2.IO3
net XIN 0 U1.XIN Y1.XTAL1 C1.1
net XOUT 0 U1.XOUT Y1.XTAL2 C2.1
net RUN 0 U1.RUN R1.2
net LCD_SCK 0 U1.GPIO18 J3.SCK
net LCD_SDA 0 U1.GPIO19 J3.SDA
net LCD_CS 0 U1.GPIO17 J3.CS
net LCD_RS 0 U1.GPIO16 J3.RS
net LCD_RESET 0 U1.GPIO20 J3.RESET
net BL_GATE 0 U1.GPIO21 Q1.G R3.1
net BL_A 0 J3.LED+ R2.2
net BL_K 0 J3.LED- Q1.D
net USB_DP 0 J1.A6 J1.B6 U6.IO1 U6.IO1' U1.USB_DP
net USB_DM 0 J1.A7 J1.B7 U6.IO2 U6.IO2' U1.USB_DM
net CC1 0 J1.CC1 R4.1
net CC2 0 J1.CC2 R5.1
net VBAT 0.4 J2.VBAT F1.1
net VBAT_F 0.4 F1.2 U3.VBAT14 U3.VBAT15 U3.VBAT_SENSE
net VBUS 0.4 J1.A4 J1.A9 J1.B4 J1.B9 U6.VBUS U3.IN18 U3.IN19 U3.VPCC U3.CE U3.PROG2
net VSYS 0.4 U3.OUT1 U3.OUT20 SW1.COM C14.1 C10.1
net VSW 0.4 SW1.1 U4.VIN U4.EN
net DVDD 0.3 U1.VREG_VOUT U1.DVDD23 U1.DVDD50
net PROG1 0 U3.PROG1 R6.1
net 3V3 0.4 U4.VOUT U1.IOVDD1 U1.IOVDD10 U1.IOVDD22 U1.IOVDD33 U1.IOVDD42 U1.IOVDD49 U1.USB_VDD U1.ADC_AVDD U1.VREG_VIN U2.VCC J3.VDD J3.IOVDD R1.1 R2.1 C12.1 C13.1 C3.1 C4.1 C5.1 C6.1 C7.1 C8.1 C9.1 C11.1
net GND 0.4 U1.GND U1.TESTEN U2.GND Y1.GND2 Y1.GND4 C1.2 C2.2 C3.2 C4.2 C5.2 C6.2 C7.2 C8.2 C9.2 C10.2 C11.2 C12.2 C13.2 C14.2 J3.GND2 J3.GND5 J3.GND13 Q1.S R3.2 J1.A1 J1.A12 J1.B1 J1.B12 J1.SH1 J1.SH2 J1.SH3 J1.SH4 U6.GND R4.2 R5.2 U3.VSS10 U3.VSS11 U3.EP U3.SEL U3.TE R6.2 U4.GND J2.GND SW2.GN SW2.GE SW2.GS SW2.GW SW3.GN SW3.GE SW3.GS SW3.GW SW4.GN SW4.GE SW4.GS SW4.GW SW5.GN SW5.GE SW5.GS SW5.GW SW6.GN SW6.GE SW6.GS SW6.GW SW7.GN SW7.GE SW7.GS SW7.GW SW8.GN SW8.GE SW8.GS SW8.GW SW9.GN SW9.GE SW9.GS SW9.GW SW10.GN SW10.GE SW10.GS SW10.GW SW11.GN SW11.GE SW11.GS SW11.GW
net BTN_UP 0 U1.GPIO6 SW2.SIG
net BTN_DOWN 0 U1.GPIO7 SW3.SIG
net BTN_LEFT 0 U1.GPIO8 SW4.SIG
net BTN_RIGHT 0 U1.GPIO9 SW5.SIG
net BTN_X 0 U1.GPIO10 SW6.SIG
net BTN_A 0 U1.GPIO2 SW7.SIG
net BTN_Y 0 U1.GPIO11 SW8.SIG
net BTN_B 0 U1.GPIO3 SW9.SIG
net BTN_HOME 0 U1.GPIO4 SW11.SIG
net BTN_BACK 0 U1.GPIO5 SW10.SIG
track VBAT top 0.4 -26 -48 -19.4 -48
track VBAT top 0.4 -19.4 -48 -19.4 -40
