tag cad;

use_tag std, gl, x11, skate;

// Painting: everything the editor shows, the board and its parts as much
// as the buttons over them, is quads that one program draws (PAINT_FS).
// Each quad is a shape worked out for each of its pixels, so that it has a
// clean edge at any zoom: a box with round corners (a pad, a button) or its
// outline; a character of the writing (Rubik, from programs/skate/font.l8);
// a line with round ends (a track); a triangle; an arc; and the board
// itself, a box with a grid of dots on it. Anything can be soft (a shadow
// is a soft box), and everything is drawn in the order painted.
//
// Colors are written 0xRRGGBB, with how much they show apart.
const P_BOX: f32 = 0.0;

const P_GLYPH: f32 = 1.0;

const P_LINE: f32 = 2.0;

const P_TRI: f32 = 3.0;

const P_ARC: f32 = 5.0;

const P_BOARD: f32 = 8.0;

const P_POUR: f32 = 9.0;

// The window's size, in its own pixels.
scr_w: int = 1280;

scr_h: int = 720;

// Each corner of a quad: where it is in the window and where in its shape;
// the shape's half size, kind and corner radius; how soft, and an
// outline's thickness (0 filled) or a character's extra weight; two numbers
// some shapes use; and the color.
const P_FLOATS: int = 16;

const P_QUADS: int = 24000;

p_verts: []f32 = new f32[P_QUADS * 4 * P_FLOATS](0.0);

p_n: int = 0;

// Runs of quads painted with one clip, and each run's clip.
const P_BATCHES: int = 64;

p_batch_first: []int = new int[P_BATCHES](0);

p_batch_count: []int = new int[P_BATCHES](0);

p_batch_clip: []f32 = new f32[P_BATCHES * 4](0.0);

p_nbatches: int = 0;

p_cx0: f32 = -100000.0;

p_cy0: f32 = -100000.0;

p_cx1: f32 = 100000.0;

p_cy1: f32 = 100000.0;

// How much everything painted shows, from 1 (a layer fading in paints
// with less).
p_alpha: f32 = 1.0;

p_reset() {
    p_n = 0;
    p_nbatches = 0;
    p_alpha = 1.0;
    p_noclip()
}

p_noclip() {
    p_clip(-100000.0, -100000.0, 100000.0, 100000.0)
}

p_clip(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    p_cx0 = x0;
    p_cy0 = y0;
    p_cx1 = x1;
    p_cy1 = y1;
    if (p_nbatches > 0 && p_batch_count[p_nbatches - 1] == 0) p_nbatches = p_nbatches - 1;
    if (p_nbatches >= P_BATCHES) return;
    p_batch_first[p_nbatches] = p_n;
    p_batch_count[p_nbatches] = 0;
    p_batch_clip[p_nbatches * 4] = x0;
    p_batch_clip[p_nbatches * 4 + 1] = y0;
    p_batch_clip[p_nbatches * 4 + 2] = x1;
    p_batch_clip[p_nbatches * 4 + 3] = y1;
    p_nbatches = p_nbatches + 1
}

p_corner(
    k: int,
    x: f32,
    y: f32,
    u: f32,
    v: f32
) {
    p_verts[k] = x;
    p_verts[k + 1] = y;
    p_verts[k + 2] = u;
    p_verts[k + 3] = v
}

// One quad: its box in the window, and in its shape; then the rest.
p_quad(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    hw: f32,
    hh: f32,
    kind: f32,
    radius: f32,
    soft: f32,
    thick: f32,
    e0: f32,
    e1: f32,
    rgb: int,
    a: f32
) {
    if (p_n >= P_QUADS || p_nbatches == 0) return;
    alpha: f32 = a * p_alpha;
    if (alpha <= 0.002) return;
    if (x1 < p_cx0 || x0 > p_cx1 || y1 < p_cy0 || y0 > p_cy1) return;
    if (x1 < -4.0 || y1 < -4.0 || x0 > scr_w as f32 + 4.0 || y0 > scr_h as f32 + 4.0) return;
    k: int = p_n * 4 * P_FLOATS;
    p_corner(k, x0, y0, u0, v0);
    p_corner(k + P_FLOATS, x1, y0, u1, v0);
    p_corner(k + 2 * P_FLOATS, x1, y1, u1, v1);
    p_corner(k + 3 * P_FLOATS, x0, y1, u0, v1);
    red: f32 = (rgb >> 16 & 255) as f32 / 255.0;
    g: f32 = (rgb >> 8 & 255) as f32 / 255.0;
    b: f32 = (rgb & 255) as f32 / 255.0;
    for c in 0..4 {
        j: int = k + c * P_FLOATS + 4;
        p_verts[j] = hw;
        p_verts[j + 1] = hh;
        p_verts[j + 2] = kind;
        p_verts[j + 3] = radius;
        p_verts[j + 4] = soft;
        p_verts[j + 5] = thick;
        p_verts[j + 6] = e0;
        p_verts[j + 7] = e1;
        p_verts[j + 8] = red;
        p_verts[j + 9] = g;
        p_verts[j + 10] = b;
        p_verts[j + 11] = alpha
    }
    p_n = p_n + 1;
    p_batch_count[p_nbatches - 1] = p_batch_count[p_nbatches - 1] + 1
}

// A box with round corners, from its top left (x, y), w by h; soft by so
// many pixels; filled, or (thick) an outline that thick inside its edge.
p_shape(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    radius: f32,
    soft: f32,
    thick: f32,
    rgb: int,
    a: f32
) {
    if (w <= 0.0 || h <= 0.0) return;
    m: f32 = soft + 1.5;
    hw: f32 = w * 0.5;
    hh: f32 = h * 0.5;
    p_quad(x - m, y - m, x + w + m, y + h + m, -hw - m, -hh - m, hw + m, hh + m, hw,
        hh, P_BOX, minf(radius, minf(hw, hh)), soft, thick, 0.0, 0.0, rgb, a)
}

p_box(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    radius: f32,
    rgb: int,
    a: f32
) {
    p_shape(x, y, w, h, radius, 0.0, 0.0, rgb, a)
}

p_outline(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    radius: f32,
    thick: f32,
    rgb: int,
    a: f32
) {
    p_shape(x, y, w, h, radius, 0.0, thick, rgb, a)
}

// A soft shadow under a box, moved down by drop.
p_shadow(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    radius: f32,
    drop: f32,
    soft: f32,
    a: f32
) {
    p_shape(x, y + drop, w, h, radius, soft, 0.0, 5, a)
}

// The same box, from its middle (cx, cy) and half size.
p_box_at(
    cx: f32,
    cy: f32,
    hw: f32,
    hh: f32,
    radius: f32,
    rgb: int,
    a: f32
) {
    p_shape(cx - hw, cy - hh, 2.0 * hw, 2.0 * hh, radius, 0.0, 0.0, rgb, a)
}

p_disc(
    x: f32,
    y: f32,
    r: f32,
    rgb: int,
    a: f32
) {
    p_shape(x - r, y - r, 2.0 * r, 2.0 * r, r, 0.0, 0.0, rgb, a)
}

p_glow(
    x: f32,
    y: f32,
    r: f32,
    soft: f32,
    rgb: int,
    a: f32
) {
    p_shape(x - r, y - r, 2.0 * r, 2.0 * r, r, soft, 0.0, rgb, a)
}

p_ring(
    x: f32,
    y: f32,
    r: f32,
    thick: f32,
    rgb: int,
    a: f32
) {
    p_shape(x - r, y - r, 2.0 * r, 2.0 * r, r, 0.0, thick, rgb, a)
}

// A line from (x0, y0) to (x1, y1), w wide, with round ends.
p_line(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    w: f32,
    rgb: int,
    a: f32
) {
    m: f32 = w * 0.5 + 1.5;
    bx: f32 = minf(x0, x1) - m;
    by: f32 = minf(y0, y1) - m;
    ex: f32 = maxf(x0, x1) + m;
    ey: f32 = maxf(y0, y1) + m;
    p_quad(bx, by, ex, ey, bx - x0, by - y0, ex - x0, ey - y0, x1 - x0, y1 - y0, P_LINE,
        w * 0.5, 0.0, 0.0, 0.0, 0.0, rgb, a)
}

// A triangle pointing right in the box at (x, y), w by h, its corners
// rounded by radius; and one pointing any way: its tip at (x, y), d long
// and w across its base, pointing along (dx, dy).
p_triangle(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    radius: f32,
    rgb: int,
    a: f32
) {
    if (w <= 0.0 || h <= 0.0) return;
    hw: f32 = w * 0.5;
    hh: f32 = h * 0.5;
    p_quad(x - 1.5, y - 1.5, x + w + 1.5, y + h + 1.5, -hw - 1.5, -hh - 1.5, hw + 1.5,
        hh + 1.5, hw, hh, P_TRI, minf(radius, minf(hw, hh)), 0.0, 0.0, 0.0, 0.0, rgb,
        a)
}

// An arc of a ring round (x, y), of radius r and thick, from the angle
// start (0 to the right, a quarter turn down) round by sweep, round ended.
p_arc(
    x: f32,
    y: f32,
    r: f32,
    thick: f32,
    start: f32,
    sweep: f32,
    rgb: int,
    a: f32
) {
    m: f32 = r + thick + 1.5;
    p_quad(x - m, y - m, x + m, y + m, -m, -m, m, m, r, thick * 0.5, P_ARC, start,
        sweep, 0.0, 0.0, 0.0, rgb, a)
}

// The board: a box with round corners from (x0, y0) to (x1, y1) in the
// window, standing for (bx0, by0) to (bx1, by1) on the board (y up), with
// a dot every grid millimetres, and the corners' radius in millimetres.
p_board(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    bx0: f32,
    by0: f32,
    bx1: f32,
    by1: f32,
    radius: f32,
    grid: f32,
    rgb: int,
    a: f32
) {
    // (Room for its edge's last pixel: the same in board units.)
    k: f32 = (bx1 - bx0) / maxf(x1 - x0, 0.001);
    m: f32 = 2.0;
    hw: f32 = (bx1 - bx0) * 0.5;
    hh: f32 = (by1 - by0) * 0.5;
    p_quad(x0 - m, y0 - m, x1 + m, y1 + m, bx0 - m * k, by1 + m * k, bx1 + m * k,
        by0 - m * k, hw, hh, P_BOARD, radius, 0.0, 0.0, grid, 0.0, rgb, a)
}

// ---- writing ----
// Text is bytes (UTF-8), from `from` up to `to`. Face 0 is Rubik Medium,
// 1 ExtraBold; size is pixels to the em.
p_glyph_at: int = 0;

p_glyph_bytes: int = 1;

p_read_glyph(t: []i8, i: int, to: int) {
    c: int = t[i] as int & 255;
    p_glyph_bytes = 1;
    code: int = c;
    if (c >= 192 && i + 1 < to) {
        c1: int = t[i + 1] as int & 63;
        if (c < 224) {
            code = ((c & 31) << 6) + c1;
            p_glyph_bytes = 2
        } else if (i + 2 < to) {
            code = ((c & 15) << 12) + (c1 << 6) + (t[i + 2] as int & 63);
            p_glyph_bytes = 3
        }
    }
    p_glyph_at = 31;
    if (code >= 32 && code < 127) {
        p_glyph_at = code - FONT_FIRST;
        return
    }
    for k in 0..len(font_more) {
        if (font_more[k] == code) p_glyph_at = 127 - FONT_FIRST + k
    }
}

p_kern(face: int, a: int, b: int): f32 {
    key: int = (face * 256 + a) * 256 + b;
    lo: int = 0;
    hi: int = len(font_kern_pairs);
    while (lo < hi) {
        mid: int = (lo + hi) / 2;
        if (font_kern_pairs[mid] < key) lo = mid + 1 else hi = mid
    }
    if (lo < len(font_kern_pairs) && font_kern_pairs[lo] == key) return font_kern_by[lo];
    0.0
}

p_advance(face: int, g: int): f32 {
    font_glyphs[(face * FONT_GLYPHS + g) * GLYPH_FLOATS + 6]
}

p_text_w(
    face: int,
    size: f32,
    t: []i8,
    from: int,
    to: int
): f32 {
    w: f32 = 0.0;
    prev: int = -1;
    i: int = from;
    while (i < to) {
        p_read_glyph(t, i, to);
        g: int = p_glyph_at;
        if (prev >= 0) w = w + p_kern(face, prev, g);
        w = w + p_advance(face, g);
        prev = g;
        i = i + p_glyph_bytes
    }
    w * size / FONT_EM
}

// Write it, its left end at x and its baseline at y; bolder by weight (0.05
// is a little). Where the pen ends.
p_text(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    t: []i8,
    from: int,
    to: int,
    weight: f32,
    rgb: int,
    a: f32
): f32 {
    k: f32 = size / FONT_EM;
    pen: f32 = x;
    prev: int = -1;
    i: int = from;
    while (i < to) {
        p_read_glyph(t, i, to);
        gi: int = p_glyph_at;
        if (prev >= 0) pen = pen + p_kern(face, prev, gi) * k;
        j: int = (face * FONT_GLYPHS + gi) * GLYPH_FLOATS;
        gw: f32 = font_glyphs[j + 2];
        gh: f32 = font_glyphs[j + 3];
        if (gw > 0.0) {
            gx: f32 = pen + font_glyphs[j + 4] * k;
            gy: f32 = y + font_glyphs[j + 5] * k;
            u0: f32 = font_glyphs[j] / FONT_W as f32;
            v0: f32 = font_glyphs[j + 1] / FONT_H as f32;
            u1: f32 = (font_glyphs[j] + gw) / FONT_W as f32;
            v1: f32 = (font_glyphs[j + 1] + gh) / FONT_H as f32;
            p_quad(gx, gy, gx + gw * k, gy + gh * k, u0, v0, u1, v1, 0.0, 0.0, P_GLYPH,
                0.0, 0.0, weight, 0.0, 0.0, rgb, a)
        }
        pen = pen + p_advance(face, gi) * k;
        prev = gi;
        i = i + p_glyph_bytes
    }
    pen
}

// (A string, by way of a buffer kept for it.)
p_scratch: []i8 = new i8[512](0i8);

p_scratch_n: int = 0;

p_scratch_set(t: str) {
    p_scratch_n = mini(len(t), len(p_scratch));
    for i in 0..p_scratch_n p_scratch[i] = t[i]
}

p_str_w(face: int, size: f32, t: str): f32 {
    p_scratch_set(t);
    p_text_w(face, size, p_scratch, 0, p_scratch_n)
}

p_str(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    t: str,
    rgb: int,
    a: f32
): f32 {
    p_scratch_set(t);
    p_text(face, size, x, y, p_scratch, 0, p_scratch_n, 0.0, rgb, a)
}

// Centered on x.
p_str_mid(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    t: str,
    rgb: int,
    a: f32
) {
    p_scratch_set(t);
    w: f32 = p_text_w(face, size, p_scratch, 0, p_scratch_n);
    p_text(face, size, x - w * 0.5, y, p_scratch, 0, p_scratch_n, 0.0, rgb, a)
}

mini(a: int, b: int): int {
    if (a < b) return a;
    b
}

maxi(a: int, b: int): int {
    if (a > b) return a;
    b
}

// ---- the program that draws it ----
PAINT_VS: str = """
#version 120
#ifdef GL_ES
#define HP highp
#else
#define HP
#endif
attribute vec4 pos;
attribute vec4 nrm;
attribute vec4 vcol;
attribute vec4 inst;
uniform HP vec2 screen;
varying HP vec2 vat;
varying HP vec2 vuv;
varying HP vec4 vshape;
varying HP vec4 vsoft;
varying vec4 vcolor;
void main() {
  vat = pos.xy;
  vuv = pos.zw;
  vshape = nrm;
  vsoft = vcol;
  vcolor = inst;
  gl_Position = vec4(pos.x / screen.x * 2.0 - 1.0, 1.0 - pos.y / screen.y * 2.0, 0.0, 1.0);
}
""";

PAINT_FS: str = """
#version 120
#ifdef GL_ES
#define HP highp
#else
#define HP
#endif
uniform sampler2D font;
uniform sampler2D pour0;
uniform sampler2D pour1;
uniform sampler2D pour2;
uniform HP vec4 clip;
varying HP vec2 vat;
varying HP vec2 vuv;
varying HP vec4 vshape;
varying HP vec4 vsoft;
varying vec4 vcolor;
HP float box(HP vec2 p, HP vec2 b, HP float r) {
  HP vec2 q = abs(p) - b + vec2(r);
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
HP float segment(HP vec2 p, HP vec2 b) {
  HP float h = clamp(dot(p, b) / max(dot(b, b), 0.0001), 0.0, 1.0);
  return length(p - b * h);
}
HP float triangle(HP vec2 p, HP vec2 p0, HP vec2 p1, HP vec2 p2) {
  HP vec2 e0 = p1 - p0;
  HP vec2 e1 = p2 - p1;
  HP vec2 e2 = p0 - p2;
  HP vec2 v0 = p - p0;
  HP vec2 v1 = p - p1;
  HP vec2 v2 = p - p2;
  HP vec2 q0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
  HP vec2 q1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
  HP vec2 q2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);
  HP float s = sign(e0.x * e2.y - e0.y * e2.x);
  HP vec2 d = min(min(vec2(dot(q0, q0), s * (v0.x * e0.y - v0.y * e0.x)),
                      vec2(dot(q1, q1), s * (v1.x * e1.y - v1.y * e1.x))),
                      vec2(dot(q2, q2), s * (v2.x * e2.y - v2.y * e2.x)));
  return -sqrt(d.x) * sign(d.y);
}
float edge(HP float d) {
  HP float w = max(fwidth(d), 0.0001);
  return clamp(0.5 - d / w, 0.0, 1.0);
}
void main() {
  float kind = vshape.z;
  vec3 rgb = vcolor.rgb;
  float a = 0.0;
  if (kind < 0.5) {
    HP float d = box(vuv, vshape.xy, vshape.w);
    if (vsoft.y > 0.0) d = abs(d + vsoft.y * 0.5) - vsoft.y * 0.5;
    if (vsoft.x > 0.0) a = 1.0 - smoothstep(-vsoft.x, vsoft.x, d);
    else a = edge(d);
  } else if (kind < 1.5) {
    float d = texture2D(font, vuv).r;
    float e = 0.5 - vsoft.y;
    float w = max(fwidth(d) * 0.7, 0.002);
    a = smoothstep(e - w, e + w, d);
  } else if (kind < 2.5) {
    a = edge(segment(vuv, vshape.xy) - vshape.w);
  } else if (kind < 3.5) {
    HP vec2 b = vshape.xy - vec2(vshape.w);
    a = edge(triangle(vuv, vec2(-b.x, -b.y), vec2(b.x, 0.0), vec2(-b.x, b.y)) - vshape.w);
  } else if (kind < 5.5) {
    HP float ang = atan(vuv.y, vuv.x) - vshape.w;
    ang = mod(ang, 6.2831853);
    HP float d = abs(length(vuv) - vshape.x) - vshape.y;
    if (ang > vsoft.x) {
      HP vec2 p0 = vshape.x * vec2(cos(vshape.w), sin(vshape.w));
      HP vec2 p1 = vshape.x * vec2(cos(vshape.w + vsoft.x), sin(vshape.w + vsoft.x));
      d = min(length(vuv - p0), length(vuv - p1)) - vshape.y;
    }
    a = edge(d);
  } else if (kind > 8.5) {
    // A pour, from its mask (see pour.l8): its edge where the mask, as
    // smoothed between cells, crosses a half.
    float m = vsoft.z < 0.5 ? texture2D(pour0, vuv).r : vsoft.z < 1.5 ? texture2D(pour1, vuv).r : texture2D(pour2, vuv).r;
    float w = max(fwidth(m) * 0.7, 0.002);
    a = smoothstep(0.5 - w, 0.5 + w, m);
  } else {
    // The board: its outline, and a dot at every grid step (in board
    // units), each a pixel and a half across, fading out as they crowd.
    HP float d = box(vuv, vshape.xy, vshape.w);
    a = edge(d);
    HP float px = max(fwidth(vuv.x), 0.00001);
    HP float g = vsoft.z;
    HP vec2 f = abs(fract(vuv / g + 0.5) - 0.5) * g / px;
    HP float steppx = g / px;
    float dot = clamp(1.6 - length(f), 0.0, 1.0) * smoothstep(7.0, 16.0, steppx);
    HP vec2 f5 = abs(fract(vuv / (g * 5.0) + 0.5) - 0.5) * g * 5.0 / px;
    float big = clamp(2.1 - length(f5), 0.0, 1.0) * smoothstep(5.0, 12.0, steppx * 5.0);
    rgb = mix(rgb, vec3(0.55, 0.78, 0.68), max(dot * 0.22, big * 0.32));
  }
  HP float cx = min(vat.x - clip.x, clip.z - vat.x);
  HP float cy = min(vat.y - clip.y, clip.w - vat.y);
  float c = clamp(min(cx, cy) + 0.5, 0.0, 1.0);
  gl_FragColor = vec4(rgb, a * c * vcolor.a);
}
""";

type Painter = {
    prog: int;
    u_screen: int;
    u_font: int;
    u_clip: int;
    font_tex: u32;
    u_pour: []int;
    pour_tex: []u32;
    buf: u32;
    idx: u32
}

p_compile(kind: int, src: []i8) raises IoError: int {
    sh: int = glCreateShader(kind);
    sp: *i8 = src;
    ln: []i32 = new i32[1](len(src) trunc i32);
    glShaderSource(sh, 1, &sp, ln);
    glCompileShader(sh);
    st: []i32 = new i32[1](0i32);
    glGetShaderiv(sh, 35713, st);
    if (st[0] == 0i32) {
        logn: []i32 = new i32[1](0i32);
        glGetShaderiv(sh, 35716, logn);
        n: int = logn[0] as int;
        if (n < 1) n = 1;
        if (n > 4096) n = 4096;
        buf: []i8 = new i8[n](0i8);
        glGetShaderInfoLog(sh, n, null, buf);
        write_bytes_n(2, buf, n);
        write(2, "\n");
        cad_die("shader compile failed")
    }
    sh
}

p_link(vs: []i8, fs: []i8) raises IoError: int {
    prog: int = glCreateProgram();
    glAttachShader(prog, p_compile(35633, vs));
    glAttachShader(prog, p_compile(35632, fs));
    glBindAttribLocation(prog, 0, "pos");
    glBindAttribLocation(prog, 1, "nrm");
    glBindAttribLocation(prog, 2, "vcol");
    glBindAttribLocation(prog, 3, "inst");
    glLinkProgram(prog);
    st: []i32 = new i32[1](0i32);
    glGetProgramiv(prog, 35714, st);
    if (st[0] == 0i32) cad_die("program link failed");
    prog
}

extern exit(code: int): noreturn;

cad_die(msg: str) raises IoError: noreturn {
    eprint(msg);
    exit(1)
}

// The font's picture (see programs/skate/font.l8) as a texture.
p_font_texture(): u32 {
    bits: []i8 = new i8[FONT_W * FONT_H](0i8);
    level: []int = new int[128](0);
    for k in 0..len(FONT_LEVELS) level[FONT_LEVELS[k] as int] = k;
    for y in 0..FONT_H {
        for x in 0..FONT_W bits[y * FONT_W + x] = (level[font_rows[y][x] as int] * 4) trunc i8
    }
    tex: []u32 = new u32[1](0u32);
    glGenTextures(1, tex);
    glBindTexture(3553, tex[0]);
    glPixelStorei(3317, 1);
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 6409, FONT_W, FONT_H, 0, 6409, 5121, bits);
    glPixelStorei(3317, 4);
    tex[0]
}

new_painter() raises IoError: *Painter@new {
    prog: int = p_link(bytes(PAINT_VS), bytes(PAINT_FS));
    va: []u32 = new u32[1](0u32);
    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    for i in 0..4 glEnableVertexAttribArray(i);
    ids: []u32 = new u32[2](0u32);
    glGenBuffers(2, ids);
    // The order each quad's corners are drawn in: two triangles.
    idx: []i32 = new i32[P_QUADS * 6](0i32);
    for q in 0..P_QUADS {
        c: int = q * 4;
        idx[q * 6] = c trunc i32;
        idx[q * 6 + 1] = (c + 1) trunc i32;
        idx[q * 6 + 2] = (c + 2) trunc i32;
        idx[q * 6 + 3] = c trunc i32;
        idx[q * 6 + 4] = (c + 2) trunc i32;
        idx[q * 6 + 5] = (c + 3) trunc i32
    }
    glBindBuffer(34963, ids[1]);
    glNamedBufferData(ids[1], P_QUADS * 24, idx, 35044);
    new Painter {
        prog: prog,
        u_screen: glGetUniformLocation(prog, "screen"),
        u_font: glGetUniformLocation(prog, "font"),
        u_clip: glGetUniformLocation(prog, "clip"),
        u_pour: [glGetUniformLocation(prog, "pour0"), glGetUniformLocation(prog, "pour1"),
            glGetUniformLocation(prog, "pour2")],
        pour_tex: p_pour_textures(),
        font_tex: p_font_texture(),
        buf: ids[0],
        idx: ids[1]
    }
}

p_draw(r: *Painter) {
    if (p_n == 0) return;
    glDisable(2929);
    glEnable(3042);
    glBlendFunc(770, 771);
    glUseProgram(r.prog);
    glUniform2f(r.u_screen, scr_w as f32, scr_h as f32);
    glActiveTexture(33984);
    glBindTexture(3553, r.font_tex);
    glUniform1i(r.u_font, 0);
    for l in 0..3 {
        glActiveTexture(33985 + l);
        glBindTexture(3553, r.pour_tex[l]);
        glUniform1i(r.u_pour[l], 1 + l)
    }
    glActiveTexture(33984);
    glBindBuffer(34962, r.buf);
    glBufferData(34962, p_n * 4 * P_FLOATS * 4, p_verts, 35048);
    glVertexAttribPointer(0, 4, 5126, 0, P_FLOATS * 4, 0);
    glVertexAttribPointer(1, 4, 5126, 0, P_FLOATS * 4, 16);
    glVertexAttribPointer(2, 4, 5126, 0, P_FLOATS * 4, 32);
    glVertexAttribPointer(3, 4, 5126, 0, P_FLOATS * 4, 48);
    glBindBuffer(34963, r.idx);
    for b in 0..p_nbatches {
        if (p_batch_count[b] > 0) {
            glUniform4f(r.u_clip, p_batch_clip[b * 4], p_batch_clip[b * 4 + 1], p_batch_clip[b * 4 + 2],
                p_batch_clip[b * 4 + 3]);
            glDrawElements(4, p_batch_count[b] * 6, 5125, p_batch_first[b] * 24)
        }
    }
    glDisable(3042)
}

// ---- pours ----
// A texture for each layer's pour, and the mask of one (see pour.l8) put
// into its texture: a byte a cell, rows from the board's bottom up. (A
// third holds a layer of the case: see case.l8.)
p_pour_textures(): []u32@new {
    tex: []u32 = new u32[3](0u32);
    glGenTextures(3, tex);
    one: []i8 = new i8[4](0i8);
    for l in 0..3 {
        glBindTexture(3553, tex[l]);
        glTexParameteri(3553, 10241, 9729);
        glTexParameteri(3553, 10240, 9729);
        glTexParameteri(3553, 10242, 33071);
        glTexParameteri(3553, 10243, 33071);
        glPixelStorei(3317, 1);
        glTexImage2D(3553, 0, 6409, 1, 1, 0, 6409, 5121, one);
        glPixelStorei(3317, 4)
    }
    tex
}

p_pour_bytes: []i8 = new i8[GRID_CELLS](0i8);

p_pour_upload(r: *Painter, l: int) {
    n: int = gr_nx * gr_ny;
    for c in 0..n {
        if (pm[c * 2 + l] == 1i8) p_pour_bytes[c] = -1i8 else p_pour_bytes[c] = 0i8
    }
    glBindTexture(3553, r.pour_tex[l]);
    glPixelStorei(3317, 1);
    glTexImage2D(3553, 0, 6409, gr_nx, gr_ny, 0, 6409, 5121, p_pour_bytes);
    glPixelStorei(3317, 4)
}

// The case's layer shown (cm_bytes, see case.l8) into the third texture.
p_case_upload(r: *Painter) {
    glBindTexture(3553, r.pour_tex[2]);
    glPixelStorei(3317, 1);
    glTexImage2D(3553, 0, 6409, cm_nx, cm_ny, 0, 6409, 5121, cm_bytes);
    glPixelStorei(3317, 4)
}
