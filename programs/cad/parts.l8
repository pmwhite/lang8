tag cad;

use_tag std, gl, x11, skate;

// The parts library: each footprint's pads, where they are from its middle
// (in millimetres, y up), their copper's shape, and any hole through the
// board; its body's outline for the silkscreen; and its courtyard, the room
// it needs that no other part may take. The first footprints are those of
// the handheld (~/src/handheld), from the same datasheets and KiCad land
// patterns its OCaml modules cite.
const FOOTPRINTS: int = 64;

const LIB_PADS: int = 1024;

fp_n: int = 0;

// Its key in a board's text, what it is, its package, and the letter a
// new part of it is named with.
fp_key: []int = new int[FOOTPRINTS](0);

fp_title: []int = new int[FOOTPRINTS](0);

fp_pkg: []int = new int[FOOTPRINTS](0);

fp_prefix: []int = new int[FOOTPRINTS](0);

fp_pad0: []int = new int[FOOTPRINTS](0);

fp_npads: []int = new int[FOOTPRINTS](0);

// The body (w by h about the middle, round or not), and the courtyard (a
// box, or for a round part a circle of radius fp_court_r).
fp_bw: []f32 = new f32[FOOTPRINTS](0.0);

fp_bh: []f32 = new f32[FOOTPRINTS](0.0);

fp_round: []bool = new bool[FOOTPRINTS](false);

fp_court_r: []f32 = new f32[FOOTPRINTS](0.0);

fp_cx0: []f32 = new f32[FOOTPRINTS](0.0);

fp_cy0: []f32 = new f32[FOOTPRINTS](0.0);

fp_cx1: []f32 = new f32[FOOTPRINTS](0.0);

fp_cy1: []f32 = new f32[FOOTPRINTS](0.0);

// A box where no copper may be, on either side, whatever its net (a
// module's antenna: copper under it detunes it), about the middle; or none
// (x0 = x1).
fp_kx0: []f32 = new f32[FOOTPRINTS](0.0);

fp_ky0: []f32 = new f32[FOOTPRINTS](0.0);

fp_kx1: []f32 = new f32[FOOTPRINTS](0.0);

fp_ky1: []f32 = new f32[FOOTPRINTS](0.0);

// Pads: name, middle, copper w by h with corners of radius r (a circle is
// a square as round as it can be), and a hole (drill wide, slot tall; or
// 0 for a pad on the top only). An unplated hole has no copper.
lp_name: []int = new int[LIB_PADS](0);

lp_x: []f32 = new f32[LIB_PADS](0.0);

lp_y: []f32 = new f32[LIB_PADS](0.0);

lp_w: []f32 = new f32[LIB_PADS](0.0);

lp_h: []f32 = new f32[LIB_PADS](0.0);

lp_r: []f32 = new f32[LIB_PADS](0.0);

lp_drill: []f32 = new f32[LIB_PADS](0.0);

lp_slot: []f32 = new f32[LIB_PADS](0.0);

lp_plated: []bool = new bool[LIB_PADS](true);

// Pads of a part joined inside it (a flow-through ESD part's two ends of a
// line): those with the same number above 0 need no copper between them.
lp_join: []int = new int[LIB_PADS](0);

lp_n: int = 0;

fp_begin(
    key: str,
    title: str,
    pkg: str,
    prefix: str,
    bw: f32,
    bh: f32
) {
    fp_key[fp_n] = name_str(key);
    fp_title[fp_n] = name_str(title);
    fp_pkg[fp_n] = name_str(pkg);
    fp_prefix[fp_n] = name_str(prefix);
    fp_pad0[fp_n] = lp_n;
    fp_npads[fp_n] = 0;
    fp_bw[fp_n] = bw;
    fp_bh[fp_n] = bh;
    fp_round[fp_n] = false;
    fp_kx0[fp_n] = 0.0;
    fp_kx1[fp_n] = 0.0
}

// The pads given so far for the footprint being made, turned over top to
// bottom: for pads written as KiCad gives them, its y down, to this tool's
// y up. (Left as they were, the part's pins would land mirrored: pin 1
// where pin 3 is, on a SOT-23-5.)
fp_flip_y() {
    for i in fp_pad0[fp_n]..lp_n lp_y[i] = -lp_y[i]
}

// The footprint being made keeps copper out of a box (see fp_kx0).
fp_keepout(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    fp_kx0[fp_n] = x0;
    fp_ky0[fp_n] = y0;
    fp_kx1[fp_n] = x1;
    fp_ky1[fp_n] = y1
}

// The courtyard: round the pads and the body, 0.25 mm out.
fp_end() {
    x0: f32 = -fp_bw[fp_n] * 0.5;
    y0: f32 = -fp_bh[fp_n] * 0.5;
    x1: f32 = fp_bw[fp_n] * 0.5;
    y1: f32 = fp_bh[fp_n] * 0.5;
    for i in fp_pad0[fp_n]..lp_n {
        x0 = minf(x0, lp_x[i] - lp_w[i] * 0.5);
        y0 = minf(y0, lp_y[i] - lp_h[i] * 0.5);
        x1 = maxf(x1, lp_x[i] + lp_w[i] * 0.5);
        y1 = maxf(y1, lp_y[i] + lp_h[i] * 0.5)
    }
    // (A round part's courtyard is round: as far out as its farthest pad.)
    fp_court_r[fp_n] = 0.0;
    if (fp_round[fp_n]) {
        far: f32 = maxf(fp_bw[fp_n], fp_bh[fp_n]) * 0.5;
        for i in fp_pad0[fp_n]..lp_n far = maxf(far, sqrtf(lp_x[i] * lp_x[i] + lp_y[i] * lp_y[i]) + maxf(lp_w[i],
            lp_h[i]) * 0.5);
        fp_court_r[fp_n] = far + 0.25;
        x0 = -far;
        y0 = -far;
        x1 = far;
        y1 = far
    }
    fp_cx0[fp_n] = x0 - 0.25;
    fp_cy0[fp_n] = y0 - 0.25;
    fp_cx1[fp_n] = x1 + 0.25;
    fp_cy1[fp_n] = y1 + 0.25;
    fp_npads[fp_n] = lp_n - fp_pad0[fp_n];
    fp_n = fp_n + 1
}

pad_full(
    name: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    r: f32,
    drill: f32,
    slot: f32,
    plated: bool
) {
    if (lp_n >= LIB_PADS) return;
    lp_name[lp_n] = name;
    lp_x[lp_n] = x;
    lp_y[lp_n] = y;
    lp_w[lp_n] = w;
    lp_h[lp_n] = h;
    lp_r[lp_n] = minf(r, minf(w, h) * 0.5);
    lp_drill[lp_n] = drill;
    lp_slot[lp_n] = slot;
    lp_plated[lp_n] = plated;
    lp_join[lp_n] = 0;
    lp_n = lp_n + 1
}

smd(
    name: str,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    r: f32
) {
    pad_full(name_str(name), x, y, w, h, r, 0.0, 0.0, true)
}

smd_circle(
    name: str,
    x: f32,
    y: f32,
    d: f32
) {
    pad_full(name_str(name), x, y, d, d, d * 0.5, 0.0, 0.0, true)
}

th(
    name: str,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    r: f32,
    drill: f32
) {
    pad_full(name_str(name), x, y, w, h, r, drill, 0.0, true)
}

// A plated slot: a hole drill wide and slot tall.
th_slot(
    name: str,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    drill: f32,
    slot: f32
) {
    pad_full(name_str(name), x, y, w, h, minf(w, h) * 0.5, drill, slot, true)
}

npth(
    name: str,
    x: f32,
    y: f32,
    d: f32
) {
    pad_full(name_str(name), x, y, d, d, d * 0.5, d, 0.0, false)
}

// The pins of a side of a QFN, in order: n of them at pitch, starting at
// (x, y) and stepping (dx, dy) each, w by h with radius r; named from
// `names`, from its k-th on.
qfn_side(
    names: []str,
    k: int,
    n: int,
    x: f32,
    y: f32,
    dx: f32,
    dy: f32,
    w: f32,
    h: f32,
    r: f32
) {
    for i in 0..n smd(names[k + i], x + dx * i as f32, y + dy * i as f32, w, h, r)
}

RP2040_PINS: []str = ["IOVDD1", "GPIO0", "GPIO1", "GPIO2", "GPIO3", "GPIO4", "GPIO5",
    "GPIO6", "GPIO7", "IOVDD10", "GPIO8", "GPIO9", "GPIO10", "GPIO11", "GPIO12", "GPIO13",
    "GPIO14", "GPIO15", "TESTEN", "XIN", "XOUT", "IOVDD22", "DVDD23", "SWCLK", "SWD",
    "RUN", "GPIO16", "GPIO17", "GPIO18", "GPIO19", "GPIO20", "GPIO21", "IOVDD33",
    "GPIO22", "GPIO23", "GPIO24", "GPIO25", "GPIO26", "GPIO27", "GPIO28", "GPIO29",
    "IOVDD42", "ADC_AVDD", "VREG_VIN", "VREG_VOUT", "USB_DM", "USB_DP", "USB_VDD",
    "IOVDD49", "DVDD50", "QSPI_SD3", "QSPI_SCLK", "QSPI_SD0", "QSPI_SD2", "QSPI_SD1",
    "QSPI_SS"];

MCP73871_PINS: []str = ["OUT1", "VPCC", "SEL", "PROG2", "THERM", "PG", "STAT2", "STAT1",
    "TE", "VSS10", "VSS11", "PROG3", "PROG1", "VBAT14", "VBAT15", "VBAT_SENSE", "CE",
    "IN18", "IN19", "OUT20"];

// An LM339's pins, 1 to 14.
LM339_PINS: []str = ["OUT2", "OUT1", "VCC", "IN1-", "IN1+", "IN2-", "IN2+", "IN3-",
    "IN3+", "IN4-", "IN4+", "GND", "OUT4", "OUT3"];

// The ESP32-S3-WROOM-1's pads, down its left, along its bottom, up its
// right.
S3_LEFT: []str = ["GND1", "3V3", "EN", "IO4", "IO5", "IO6", "IO7", "IO15", "IO16",
    "IO17", "IO18", "IO8", "IO19", "IO20"];

S3_BOTTOM: []str = ["IO3", "IO46", "IO9", "IO10", "IO11", "IO12", "IO13", "IO14",
    "IO21", "IO47", "IO48", "IO45"];

S3_RIGHT: []str = ["IO0", "IO35", "IO36", "IO37", "IO38", "IO39", "IO40", "IO41",
    "IO42", "RXD0", "TXD0", "IO2", "IO1", "GND40"];

// (Pins 11 and 12 named for the parallel interface, which the handheld
// uses: in 4-wire SPI they are SCL and DCX.)
FPC40_PINS: []str = ["GND1", "NC2", "NC3", "NC4", "NC5", "SDO", "VDD", "VDDI", "SDA",
    "CSX", "DCX", "WRX", "RDX", "DB0", "DB1", "DB2", "DB3", "DB4", "DB5", "DB6", "DB7",
    "DB8", "DB9", "DB10", "DB11", "DB12", "DB13", "DB14", "DB15", "RES", "IM0", "IM1",
    "IM2", "LEDK1", "LEDK2", "LEDK3", "LEDK4", "LEDA", "GND39", "TE"];

FPC14_PINS: []str = ["NC1", "GND2", "LED-", "LED+", "GND5", "RESET", "RS", "SDA",
    "SCK", "VDD", "IOVDD", "CS", "GND13", "NC14"];

load_library() {
    // RP2040, QFN-56 7 x 7 mm, 0.4 mm pitch; the pad centers of KiCad's
    // generated QFN-56 land pattern (3.4375 mm out), and the exposed pad
    // as ground.
    fp_begin("rp2040", "RP2040", "QFN-56, 7 x 7 mm", "U", 7.0, 7.0);
    c: f32 = 3.438;
    f: f32 = 2.6;
    qfn_side(RP2040_PINS, 0, 14, -c, f, 0.0, -0.4, 0.875, 0.2, 0.05);
    qfn_side(RP2040_PINS, 14, 14, -f, -c, 0.4, 0.0, 0.2, 0.875, 0.05);
    qfn_side(RP2040_PINS, 28, 14, c, -f, 0.0, 0.4, 0.875, 0.2, 0.05);
    qfn_side(RP2040_PINS, 42, 14, f, c, -0.4, 0.0, 0.2, 0.875, 0.05);
    smd("GND", 0.0, 0.0, 3.2, 3.2, 0.0);
    fp_end();
    // W25Q16JVSSIQ: SOIC-8, 208 mil (KiCad SOIC-8_5.23x5.23mm_P1.27mm).
    fp_begin("w25q16", "W25Q16 flash", "SOIC-8, 208 mil", "U", 5.23, 5.23);
    smd("CS", -3.6, 1.905, 1.6, 0.6, 0.15);
    smd("DO", -3.6, 0.635, 1.6, 0.6, 0.15);
    smd("IO2", -3.6, -0.635, 1.6, 0.6, 0.15);
    smd("GND", -3.6, -1.905, 1.6, 0.6, 0.15);
    smd("DI", 3.6, -1.905, 1.6, 0.6, 0.15);
    smd("CLK", 3.6, -0.635, 1.6, 0.6, 0.15);
    smd("IO3", 3.6, 0.635, 1.6, 0.6, 0.15);
    smd("VCC", 3.6, 1.905, 1.6, 0.6, 0.15);
    fp_end();
    // MCP73871: QFN-20 4 x 4 mm, 0.5 mm pitch; Microchip's 2.8 mm center
    // pad.
    fp_begin("mcp73871", "MCP73871 charger", "QFN-20, 4 x 4 mm", "U", 4.0, 4.0);
    q: f32 = 1.938;
    qfn_side(MCP73871_PINS, 0, 5, -q, -1.0, 0.0, 0.5, 0.825, 0.25, 0.063);
    qfn_side(MCP73871_PINS, 5, 5, -1.0, q, 0.5, 0.0, 0.25, 0.825, 0.063);
    qfn_side(MCP73871_PINS, 10, 5, q, 1.0, 0.0, -0.5, 0.825, 0.25, 0.063);
    qfn_side(MCP73871_PINS, 15, 5, 1.0, -q, -0.5, 0.0, 0.25, 0.825, 0.063);
    smd("EP", 0.0, 0.0, 2.8, 2.8, 0.0);
    // (Its pads as KiCad's QFN-20 gives them, y down: turned over.)
    fp_flip_y();
    fp_end();
    // AP2112K-3.3: SOT-23-5.
    // (Diodes' datasheet, SOT25: 1 VIN, 2 GND, 3 EN, 4 NC, 5 VOUT. The
    // first sketch's had EN and NC the other way round, which would have
    // left EN floating.)
    fp_begin("sot23-5", "AP2112K 3.3 V LDO", "SOT-23-5", "U", 1.6, 2.9);
    smd("VIN", -1.138, -0.95, 1.325, 0.6, 0.15);
    smd("GND", -1.138, 0.0, 1.325, 0.6, 0.15);
    smd("EN", -1.138, 0.95, 1.325, 0.6, 0.15);
    smd("NC", 1.138, 0.95, 1.325, 0.6, 0.15);
    smd("VOUT", 1.138, -0.95, 1.325, 0.6, 0.15);
    // (KiCad's SOT-23-5 pads, y down, pin 1 top left: turned over.)
    fp_flip_y();
    fp_end();
    // INA180 current sense amplifier, SOT-23-5 (DBV): 1 OUT, 2 GND, 3 IN+,
    // 4 IN-, 5 VS, on the same pads as the LDO's.
    fp_begin("sot23-5i", "Current sense amplifier", "SOT-23-5", "U", 1.6, 2.9);
    smd("OUT", -1.138, -0.95, 1.325, 0.6, 0.15);
    smd("GND", -1.138, 0.0, 1.325, 0.6, 0.15);
    smd("IN+", -1.138, 0.95, 1.325, 0.6, 0.15);
    smd("IN-", 1.138, 0.95, 1.325, 0.6, 0.15);
    smd("VS", 1.138, -0.95, 1.325, 0.6, 0.15);
    fp_flip_y();
    fp_end();
    // A single op-amp, SOT-23-5 (LMV321): 1 IN+, 2 GND, 3 IN-, 4 OUT, 5 VCC.
    fp_begin("sot23-5o", "Op-amp", "SOT-23-5", "U", 1.6, 2.9);
    smd("IN+", -1.138, -0.95, 1.325, 0.6, 0.15);
    smd("GND", -1.138, 0.0, 1.325, 0.6, 0.15);
    smd("IN-", -1.138, 0.95, 1.325, 0.6, 0.15);
    smd("OUT", 1.138, 0.95, 1.325, 0.6, 0.15);
    smd("VCC", 1.138, -0.95, 1.325, 0.6, 0.15);
    fp_flip_y();
    fp_end();
    // USBLC6-2SC6: SOT-23-6; each I/O channel passes through (1-6, 3-4).
    fp_begin("sot23-6", "USBLC6 USB ESD", "SOT-23-6", "U", 1.6, 2.9);
    smd("IO1", -1.138, -0.95, 1.325, 0.6, 0.15);
    smd("GND", -1.138, 0.0, 1.325, 0.6, 0.15);
    smd("IO2", -1.138, 0.95, 1.325, 0.6, 0.15);
    smd("IO2'", 1.138, 0.95, 1.325, 0.6, 0.15);
    smd("VBUS", 1.138, 0.0, 1.325, 0.6, 0.15);
    smd("IO1'", 1.138, -0.95, 1.325, 0.6, 0.15);
    // (Each line passes through the part: 1 to 6, 3 to 4.)
    lp_join[lp_n - 6] = 1;
    lp_join[lp_n - 1] = 1;
    lp_join[lp_n - 4] = 2;
    lp_join[lp_n - 3] = 2;
    fp_flip_y();
    fp_end();
    // 2N7002: SOT-23.
    // A MOSFET, SOT-23: 1 G, 2 S, 3 D (2N7002, AO3400A, AO3401A).
    fp_begin("sot23", "MOSFET", "SOT-23", "Q", 1.3, 2.9);
    smd("G", -1.0, -0.95, 0.9, 0.8, 0.0);
    smd("S", -1.0, 0.95, 0.9, 0.8, 0.0);
    smd("D", 1.0, 0.0, 0.9, 0.8, 0.0);
    fp_flip_y();
    fp_end();
    // 12 MHz crystal, 3225 four-pad (KiCad Crystal_SMD_3225-4Pin).
    fp_begin("xtal3225", "12 MHz crystal", "3225, 3.2 x 2.5 mm", "Y", 3.2, 2.5);
    smd("XTAL1", -1.1, 0.85, 1.4, 1.2, 0.0);
    smd("GND2", 1.1, 0.85, 1.4, 1.2, 0.0);
    smd("XTAL2", 1.1, -0.85, 1.4, 1.2, 0.0);
    smd("GND4", -1.1, -0.85, 1.4, 1.2, 0.0);
    fp_end();
    // 0603 resistor or capacitor (KiCad R_0603_1608Metric).
    fp_begin("r0603", "Resistor", "0603", "R", 1.6, 0.8);
    smd("1", -0.825, 0.0, 0.8, 0.95, 0.2);
    smd("2", 0.825, 0.0, 0.8, 0.95, 0.2);
    fp_end();
    fp_begin("c0603", "Capacitor", "0603", "C", 1.6, 0.8);
    smd("1", -0.825, 0.0, 0.8, 0.95, 0.2);
    smd("2", 0.825, 0.0, 0.8, 0.95, 0.2);
    fp_end();
    // 1206 resistor (KiCad R_1206_3216Metric): for what dissipates more
    // than an 0603 can (a quarter watt).
    fp_begin("r1206", "Resistor", "1206", "R", 3.2, 1.6);
    smd("1", -1.475, 0.0, 1.15, 1.8, 0.25);
    smd("2", 1.475, 0.0, 1.15, 1.8, 0.25);
    fp_end();
    // 500 mA resettable fuse, 1206 (KiCad Fuse_1206_3216Metric).
    fp_begin("ptc1206", "PTC fuse 500 mA", "1206", "F", 3.2, 1.6);
    smd("1", -1.4, 0.0, 1.25, 1.75, 0.25);
    smd("2", 1.4, 0.0, 1.25, 1.75, 0.25);
    fp_end();
    // GCT USB4105: USB-C receptacle, USB 2.0, 16 contacts and the shell.
    fp_begin("usb4105", "USB-C receptacle", "GCT USB4105", "J", 8.94, 7.3);
    smd("A1", -3.2, -3.68, 0.6, 1.15, 0.15);
    smd("B12", -3.2, -3.68, 0.6, 1.15, 0.15);
    smd("A4", -2.4, -3.68, 0.6, 1.15, 0.15);
    smd("B9", -2.4, -3.68, 0.6, 1.15, 0.15);
    smd("SBU2", -1.75, -3.68, 0.3, 1.15, 0.075);
    smd("CC1", -1.25, -3.68, 0.3, 1.15, 0.075);
    smd("B7", -0.75, -3.68, 0.3, 1.15, 0.075);
    smd("A6", -0.25, -3.68, 0.3, 1.15, 0.075);
    smd("A7", 0.25, -3.68, 0.3, 1.15, 0.075);
    smd("B6", 0.75, -3.68, 0.3, 1.15, 0.075);
    smd("SBU1", 1.25, -3.68, 0.3, 1.15, 0.075);
    smd("CC2", 1.75, -3.68, 0.3, 1.15, 0.075);
    smd("A9", 2.4, -3.68, 0.6, 1.15, 0.15);
    smd("B4", 2.4, -3.68, 0.6, 1.15, 0.15);
    smd("A12", 3.2, -3.68, 0.6, 1.15, 0.15);
    smd("B1", 3.2, -3.68, 0.6, 1.15, 0.15);
    th_slot("SH1", -4.32, -3.105, 1.0, 2.1, 0.6, 1.7);
    th_slot("SH2", -4.32, 1.075, 1.0, 1.8, 0.6, 1.4);
    th_slot("SH3", 4.32, -3.105, 1.0, 2.1, 0.6, 1.7);
    th_slot("SH4", 4.32, 1.075, 1.0, 1.8, 0.6, 1.4);
    npth("MH1", -2.89, -2.605, 0.65);
    npth("MH2", 2.89, -2.605, 0.65);
    fp_end();
    // The display's 14-pin 0.5 mm FPC connector: HDGC 0.5K-HX-14PWB (LCSC
    // C2919495), 1 mm tall, flip lock, contacts on both sides of the flex
    // (its datasheet's land pattern). The flex goes in from -y; its pins
    // are on +y, the ER-TFT020-3's contact 1 at +x (its flex folded back
    // under the screen, contacts up), and its pegs on -y.
    fp_begin("fpc14", "Display FPC", "0.5K-HX-14PWB, 0.5 mm", "J", 9.0, 3.6);
    for i in 0..14 smd(FPC14_PINS[i], 3.25 - 0.5 * i as f32, 1.65, 0.3, 0.8, 0.0);
    smd("MP1", -4.25, -1.65, 0.4, 0.8, 0.0);
    smd("MP2", 4.25, -1.65, 0.4, 0.8, 0.0);
    // (The display's ground pins are one ground on its flex: the board need
    // only reach it through one of them.)
    lp_join[lp_n - 15] = 1;
    lp_join[lp_n - 12] = 1;
    lp_join[lp_n - 4] = 1;
    fp_end();
    // The 2.8 inch screen's 40-pin 0.5 mm FPC connector: XUNPU
    // FPC-05FB-40PH20 (LCSC C2856837), back flip, contacts on both sides of
    // the flex (its datasheet's land pattern: pins 0.3 x 1.2, the pegs'
    // pads 2.0 x 1.8, 3.25 behind them). The flex goes in from -y; its
    // pins are on +y, the NHD-2.8-240320AF-CSXP-F's contact 1 at -x.
    fp_begin("fpc40", "Screen FPC", "FPC-05FB-40PH20, 0.5 mm", "J", 23.5, 5.4);
    for i in 0..40 smd(FPC40_PINS[i], -9.75 + 0.5 * i as f32, 1.625, 0.3, 1.2, 0.0);
    smd("MP1", -11.3, -1.625, 2.0, 1.8, 0.0);
    smd("MP2", 11.3, -1.625, 2.0, 1.8, 0.0);
    // (Its two ground pins are one ground on the flex.)
    lp_join[lp_n - 42] = 1;
    lp_join[lp_n - 4] = 1;
    fp_end();
    // A hole for a bolt through the board (the case's: M2.5), with no
    // copper, and room round it for the bolt's head and nut.
    fp_begin("mh25", "Mounting hole", "M2.5 bolt", "H", 6.0, 6.0);
    fp_round[fp_n] = true;
    npth("1", 0.0, 0.0, 2.7);
    fp_end();
    // A hole for the battery's wire to come up through the board to its
    // socket (the battery lies under the board).
    // A hole for a battery's wire, and the plug on its end (a JST-PH
    // housing, about 4.5 x 6 mm), up through the board: a slot.
    fp_begin("wirehole", "Wire hole", "5.5 x 7.5 mm slot", "H", 5.5, 7.5);
    pad_full(name_str("1"), 0.0, 0.0, 5.5, 7.5, 2.75, 5.5, 7.5, false);
    fp_end();
    // SS-12D00 slide switch, three pins at 2.54 mm (pin 1 at the origin).
    fp_begin("ss12d00", "Slide switch", "SS-12D00", "SW", 8.6, 3.5);
    th("1", 0.0, 0.0, 1.6, 1.6, 0.4, 0.8);
    th("COM", 2.54, 0.0, 1.6, 1.6, 0.4, 0.8);
    th("3", 5.08, 0.0, 1.6, 1.6, 0.4, 0.8);
    fp_bw[fp_n] = 0.0;
    fp_bh[fp_n] = 0.0;
    fp_end();
    // C&K PCM12SMTR slide switch, lying down at the board's edge, its knob
    // out over the edge on +y (1.5 mm past its body, which ends 1.85 mm
    // from the middle, with its front tabs): 0.3 A, enough for the
    // backlight. COM is its middle
    // terminal, 2. Four tabs to hold it and two pegs (its datasheet's land
    // pattern, turned so the knob points +y).
    fp_begin("pcm12", "Slide switch", "PCM12SMTR, side", "SW", 6.7, 3.3);
    smd("1", 2.25, -2.075, 0.7, 1.5, 0.0);
    smd("COM", -0.75, -2.075, 0.7, 1.5, 0.0);
    smd("3", -2.25, -2.075, 0.7, 1.5, 0.0);
    smd("MP1", -3.65, -0.78, 1.0, 0.8, 0.0);
    smd("MP2", 3.65, -0.78, 1.0, 0.8, 0.0);
    smd("MP3", -3.65, 1.43, 1.0, 0.8, 0.0);
    smd("MP4", 3.65, 1.43, 1.0, 0.8, 0.0);
    npth("PEG1", -1.5, 0.33, 0.9);
    npth("PEG2", 1.5, 0.33, 0.9);
    fp_end();
    // Espressif ESP32-S3-WROOM-1 (-N16R8: 16 MB flash, 8 MB PSRAM, which
    // takes IO35-37): Wi-Fi and Bluetooth LE, its antenna in the top 6 mm,
    // where nothing may be under it. Its datasheet's land pattern: 40 pads
    // at 1.27 mm, 1.5 by 0.9, half out past its sides; 1-14 down the left,
    // 15-26 along the bottom, 27-40 up the right; and a ground pad under
    // it, left of the middle.
    fp_begin("esp32s3", "Wi-Fi module", "ESP32-S3-WROOM-1", "U", 18.0, 25.5);
    for i in 0..14 smd(S3_LEFT[i], -8.75, 5.26 - 1.27 * i as f32, 1.5, 0.9, 0.0);
    for i in 0..12 smd(S3_BOTTOM[i], -6.985 + 1.27 * i as f32, -12.5, 0.9, 1.5, 0.0);
    for i in 0..14 smd(S3_RIGHT[i], 8.75, -11.25 + 1.27 * i as f32, 1.5, 0.9, 0.0);
    smd("GND41", -1.5, -2.46, 3.7, 3.7, 0.0);
    fp_keepout(-9.0, 6.75, 9.0, 12.75);
    fp_end();
    // A Schottky diode, SOD-123 (B5819W: 1 A, 40 V). K the cathode.
    fp_begin("sod123", "Diode", "SOD-123", "D", 2.7, 1.6);
    smd("K", -1.65, 0.0, 0.9, 1.2, 0.0);
    smd("A", 1.65, 0.0, 0.9, 1.2, 0.0);
    fp_end();
    // Two holes for a pair of wires soldered in (the wireless charging
    // receiver's), 2.54 mm apart.
    fp_begin("pads2", "Wire pads", "2 x 1 mm holes", "J", 0.0, 0.0);
    th("V", 0.0, 0.0, 1.8, 1.8, 0.9, 1.0);
    th("GND", 2.54, 0.0, 1.8, 1.8, 0.9, 1.0);
    fp_end();
    // JST PH 2-pin vertical (B2B-PH-K), battery + at pin 1.
    fp_begin("jst-ph2", "Battery JST-PH", "B2B-PH-K, 2 mm", "J", 0.0, 0.0);
    th("VBAT", 0.0, 0.0, 1.2, 1.75, 0.25, 0.75);
    th("GND", 2.0, 0.0, 1.2, 1.75, 0.25, 0.75);
    fp_end();
    // A 6 mm rubber dome's contacts: the middle, and four pads of the
    // ground ring round it (Snaptron's single-sided layout).
    fp_begin("dome6", "Button dome", "6 mm dome", "SW", 6.0, 6.0);
    fp_round[fp_n] = true;
    ring: f32 = 2.41;
    smd_circle("SIG", 0.0, 0.0, 2.45);
    smd_circle("GN", 0.0, ring, 0.9);
    smd_circle("GE", ring, 0.0, 0.9);
    smd_circle("GS", 0.0, -ring, 0.9);
    smd_circle("GW", -ring, 0.0, 0.9);
    fp_end();
    // A round test pad (for SWD, BOOTSEL, and the like).
    fp_begin("tp1", "Test pad", "1 mm round", "TP", 0.0, 0.0);
    smd_circle("1", 0.0, 0.0, 1.0);
    fp_end();
    // 0805 resistor or capacitor, and an 0603 LED.
    fp_begin("r0805", "Resistor", "0805", "R", 2.0, 1.25);
    smd("1", -0.9125, 0.0, 1.025, 1.4, 0.25);
    smd("2", 0.9125, 0.0, 1.025, 1.4, 0.25);
    fp_end();
    fp_begin("c0805", "Capacitor", "0805", "C", 2.0, 1.25);
    smd("1", -0.9125, 0.0, 1.025, 1.4, 0.25);
    smd("2", 0.9125, 0.0, 1.025, 1.4, 0.25);
    fp_end();
    // SOIC-14, 3.9 mm body (KiCad SOIC-14_3.9x8.7mm_P1.27mm): pin 1 at the
    // top left, down the left, up the right. Its pins named as an LM339's.
    fp_begin("soic14", "Quad comparator", "SOIC-14", "U", 3.9, 8.7);
    for i in 0..7 smd(LM339_PINS[i], -2.475, 3.81 - 1.27 * i as f32, 1.95, 0.6, 0.15);
    for i in 0..7 smd(LM339_PINS[7 + i], 2.475, -3.81 + 1.27 * i as f32, 1.95, 0.6,
        0.15);
    fp_end();
    // SOT-23 shunt reference (LM4040 in DBZ): the cathode pin 1, the anode
    // 2, and 3 its substrate (left unjoined, as TI allows).
    fp_begin("sot23r", "Voltage reference", "SOT-23", "U", 1.3, 2.9);
    smd("K", -1.0, -0.95, 0.9, 0.8, 0.0);
    smd("A", -1.0, 0.95, 0.9, 0.8, 0.0);
    smd("SUB", 1.0, 0.0, 0.9, 0.8, 0.0);
    fp_flip_y();
    fp_end();
    // A test point to reach from under the board (a pogo pin, through a hole
    // in the case's back): a plated hole.
    fp_begin("tph", "Test point", "1.7 mm, through", "TP", 0.0, 0.0);
    fp_round[fp_n] = true;
    th("1", 0.0, 0.0, 1.7, 1.7, 0.85, 0.9);
    fp_end();
    fp_begin("led0603", "LED", "0603", "D", 1.6, 0.8);
    smd("K", -0.7875, 0.0, 0.875, 0.95, 0.2);
    smd("A", 0.7875, 0.0, 0.875, 0.95, 0.2);
    fp_end()
}

// The footprint whose key is these bytes, or -1.
find_footprint(t: []i8, from: int, to: int): int {
    for f in 0..fp_n {
        if (name_is(fp_key[f], t, from, to)) return f
    }
    -1
}
