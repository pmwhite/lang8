# The handheld game controller (~/src/handheld), laid out again for
# routing: the RP2040 turned so its pins face what they join, GPIOs
# chosen in the order of what they reach (see programs/cad/README.md).
# The first sketch, from design.ml, is handheld-sketch.pcb. Written by
# tools/handheld.py: change that, not this.
board 72 128 4 Handheld
rules 0.15 0.25 0.6 0.3
part U1 rp2040 0 20 180 RP2040
part J3 fpc14 -4.5 38 0 ER-TFT020-3
part C15 c0603 3 37 90 100n
part Q1 sot23 -10.5 33.4 0 2N7002
part R2 r0603 -6.25 32.4 90 10R
part R3 r0603 -13.5 33.4 90 100k
part U2 w25q16 5.4 6.5 270 W25Q16
part C9 c0603 9 3.6 90 100n
part C13 c0603 10.5 3.6 90 10u
part TP5 tp1 9.2 10.6 0 BOOT
part R7 r0603 -1 -45 270 27R
part R8 r0603 1 -45 270 27R
part Y1 xtal3225 6.8 26 180 12MHz
part C1 c0603 10.6 25.15 0 12p
part C2 c0603 2.6 25.5 0 12p
part C5 c0603 2.6 28.4 0 100n
part C18 c0603 2.6 29.9 0 100n
part TP3 tp1 1 32 0 SWCLK
part TP2 tp1 3 32.6 0 SWDIO
part TP1 tp1 5 33.2 0 RUN
part TP4 tp1 7 33.8 0 GND
part R1 r0603 5 35.6 90 1k
part C4 c0603 -7.4 13.2 90 100n
part C7 c0603 6.4 21 0 100n
part C6 c0603 6.4 16.4 0 100n
part C8 c0603 -0.1 11.8 270 100n
part C16 c0603 -2.9 13.2 270 1u
part C12 c0603 -4.4 13.2 270 10u
part C3 c0603 -5.9 13.2 270 100n
part SW1 ss12d00 -22 61 0 SS-12D00
part U4 sot23-5 -18 48 0 AP2112K-3.3
part C11 c0603 -14.5 48 90 1u
part C17 c0603 -21.5 48 90 1u
part J1 usb4105 0 -60.4 180 USB4105
part U6 sot23-6 0 -50.5 90 USBLC6-2SC6
part R4 r0603 5 -54 90 5.1k
part R5 r0603 -5 -54 90 5.1k
part U3 mcp73871 -12 -48 0 MCP73871
part R6 r0603 -7 -44.5 0 2k
part C10 c0603 -16.5 -52.5 0 100n
part C14 c0603 -16.5 -55 0 10u
part F1 ptc1206 -20 -44 0 500mA
part J2 jst-ph2 -27 -44 0 JST-PH
part SW2 dome6 -24 2 0 UP
part SW3 dome6 -24 -10 0 DOWN
part SW4 dome6 -30 -4 0 LEFT
part SW5 dome6 -18 -4 0 RIGHT
part SW6 dome6 27 -1 0 A
part SW7 dome6 19 -7 0 B
part SW8 dome6 -24 -30 0 BACK
part SW9 dome6 24 -30 0 HOME
net QSPI_SS 0 U1.QSPI_SS U2.CS TP5.1
net QSPI_SCLK 0 U1.QSPI_SCLK U2.CLK
net QSPI_SD0 0 U1.QSPI_SD0 U2.DI
net QSPI_SD1 0 U1.QSPI_SD1 U2.DO
net QSPI_SD2 0 U1.QSPI_SD2 U2.IO2
net QSPI_SD3 0 U1.QSPI_SD3 U2.IO3
net XIN 0 U1.XIN Y1.XTAL1 C1.1
net XOUT 0 U1.XOUT Y1.XTAL2 C2.1
net SWCLK 0 U1.SWCLK TP3.1
net SWDIO 0 U1.SWD TP2.1
net RUN 0 U1.RUN R1.2 TP1.1
net LCD_SCK 0 U1.GPIO18 J3.SCK
net LCD_SDA 0 U1.GPIO19 J3.SDA
net LCD_RS 0 U1.GPIO20 J3.RS
net LCD_RESET 0 U1.GPIO21 J3.RESET
net LCD_CS 0 U1.GPIO17 J3.CS
net BL_GATE 0 U1.GPIO23 Q1.G R3.1
net BL_A 0 J3.LED+ R2.2
net BL_K 0 J3.LED- Q1.D
net USB_DP 0 R8.1 U1.USB_DP
net USB_DM 0 R7.1 U1.USB_DM
net USB_DP_C 0 J1.A6 J1.B6 U6.IO1 U6.IO1' R8.2
net USB_DM_C 0 J1.A7 J1.B7 U6.IO2 U6.IO2' R7.2
net CC1 0 J1.CC1 R4.2
net CC2 0 J1.CC2 R5.2
net VBAT 0.4 J2.VBAT F1.1
net VBAT_F 0.4 F1.2 U3.VBAT14 U3.VBAT15 U3.VBAT_SENSE
net VBUS 0.4 J1.A4 J1.A9 J1.B4 J1.B9 U6.VBUS U3.IN18 U3.IN19 U3.VPCC U3.CE U3.PROG2
net VSYS 0.4 U3.OUT1 U3.OUT20 SW1.COM C14.1 C10.1
net VSW 0.4 SW1.1 U4.VIN U4.EN C17.1
net DVDD 0.3 U1.VREG_VOUT U1.DVDD23 U1.DVDD50 C16.1 C18.1
net PROG1 0 U3.PROG1 R6.1
net 3V3 0.4 U4.VOUT C11.1 U1.IOVDD1 U1.IOVDD10 U1.IOVDD22 U1.IOVDD33 U1.IOVDD42 U1.IOVDD49 U1.USB_VDD U1.ADC_AVDD U1.VREG_VIN U2.VCC J3.VDD J3.IOVDD R1.1 R2.1 C3.1 C4.1 C5.1 C6.1 C7.1 C8.1 C9.1 C12.1 C13.1 C15.1
net GND 0.4 U1.GND U1.TESTEN U2.GND Y1.GND2 Y1.GND4 C1.2 C2.2 TP4.1 J3.GND2 J3.GND5 J3.GND13 J3.MP1 J3.MP2 Q1.S R3.2 J1.A1 J1.A12 J1.B1 J1.B12 J1.SH1 J1.SH2 J1.SH3 J1.SH4 U6.GND R4.1 R5.1 U3.VSS10 U3.VSS11 U3.EP U3.SEL U3.TE R6.2 U4.GND J2.GND C3.2 C4.2 C5.2 C6.2 C7.2 C8.2 C9.2 C10.2 C11.2 C12.2 C13.2 C14.2 C15.2 C16.2 C17.2 C18.2 SW2.GN SW2.GE SW2.GS SW2.GW SW3.GN SW3.GE SW3.GS SW3.GW SW4.GN SW4.GE SW4.GS SW4.GW SW5.GN SW5.GE SW5.GS SW5.GW SW6.GN SW6.GE SW6.GS SW6.GW SW7.GN SW7.GE SW7.GS SW7.GW SW8.GN SW8.GE SW8.GS SW8.GW SW9.GN SW9.GE SW9.GS SW9.GW
net BTN_LEFT 0 U1.GPIO24 SW4.SIG
net BTN_UP 0 U1.GPIO25 SW2.SIG
net BTN_DOWN 0 U1.GPIO26 SW3.SIG
net BTN_BACK 0 U1.GPIO27 SW8.SIG
net BTN_RIGHT 0 U1.GPIO28 SW5.SIG
net BTN_HOME 0 U1.GPIO0 SW9.SIG
net BTN_B 0 U1.GPIO1 SW7.SIG
net BTN_A 0 U1.GPIO2 SW6.SIG
