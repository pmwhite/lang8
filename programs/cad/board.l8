tag cad;

use_tag std, gl, x11, skate;

// A board being designed: its outline, its rules, the parts on it and where,
// the nets (which pins are to be joined), and the copper laid so far: tracks
// on the top or bottom, and vias between them. All in millimetres, with y up
// and the board's middle at (0, 0).
//
// It is kept as text, one thing to a line (see FORMAT.md):
//
//   board 72 128 4 Handheld
//   rules 0.15 0.25 0.6 0.3
//   part U1 rp2040 0 8 0
//   part C3 c0603 -6 14 0 100n
//   net QSPI_SS 0 U1.QSPI_SS U2.CS
//   track GND top 0.4 -26 -48 -18 -48
//   via GND 3 4 0.6 0.3
const PARTS: int = 256;

const PINS: int = 4096;

const NETS: int = 1024;

const SEGS: int = 8192;

const VIAS: int = 2048;

const TOP: int = 0;

const BOTTOM: int = 1;

brd_name: int = 0;

brd_w: f32 = 50.0;

brd_h: f32 = 50.0;

brd_r: f32 = 2.0;

// Design rules: the least gap between copper of different nets, the usual
// track's width, and a via's copper and hole.
rule_clear: f32 = 0.15;

rule_track: f32 = 0.25;

rule_via: f32 = 0.6;

rule_drill: f32 = 0.3;

// Parts: name (U1), footprint, where its middle is, and how many quarter
// turns it is turned (counterclockwise); and its value (100n), or -1.
parts_n: int = 0;

part_ref: []int = new int[PARTS](0);

part_fp: []int = new int[PARTS](0);

part_x: []f32 = new f32[PARTS](0.0);

part_y: []f32 = new f32[PARTS](0.0);

part_rot: []int = new int[PARTS](0);

part_value: []int = new int[PARTS](-1);

part_pin0: []int = new int[PARTS](0);

// Pins: each pad of each part, its net (or -1), and where it is on the
// board, turned with its part: its middle, half size, corners, and hole
// (slot as its long side's length, or 0).
pins_n: int = 0;

pin_part: []int = new int[PINS](0);

pin_pad: []int = new int[PINS](0);

pin_net: []int = new int[PINS](-1);

pin_x: []f32 = new f32[PINS](0.0);

pin_y: []f32 = new f32[PINS](0.0);

pin_hw: []f32 = new f32[PINS](0.0);

pin_hh: []f32 = new f32[PINS](0.0);

pin_r: []f32 = new f32[PINS](0.0);

pin_drill: []f32 = new f32[PINS](0.0);

pin_slot_w: []f32 = new f32[PINS](0.0);

pin_slot_h: []f32 = new f32[PINS](0.0);

// Which layers its copper is on: 1 the top, 2 the bottom, 3 both, 0
// neither (a bare hole).
pin_layers: []int = new int[PINS](1);

// Nets: name, and the width its tracks are laid at (0 for the usual).
nets_n: int = 0;

net_name: []int = new int[NETS](0);

net_width: []f32 = new f32[NETS](0.0);

// Tracks, as straight segments: ends, width, layer, and net.
segs_n: int = 0;

sg_x0: []f32 = new f32[SEGS](0.0);

sg_y0: []f32 = new f32[SEGS](0.0);

sg_x1: []f32 = new f32[SEGS](0.0);

sg_y1: []f32 = new f32[SEGS](0.0);

sg_w: []f32 = new f32[SEGS](0.0);

sg_layer: []int = new int[SEGS](0);

sg_net: []int = new int[SEGS](-1);

// Which route laid it (see route.l8), and which leg of the route; or -1 for
// a track laid by hand.
sg_route: []int = new int[SEGS](-1);

sg_leg: []int = new int[SEGS](-1);

vias_n: int = 0;

via_x: []f32 = new f32[VIAS](0.0);

via_y: []f32 = new f32[VIAS](0.0);

via_d: []f32 = new f32[VIAS](0.0);

via_drill: []f32 = new f32[VIAS](0.0);

via_net: []int = new int[VIAS](-1);

// Which route put it there, or -1 (by hand), or VIA_POUR (a pour's
// stitching via, made again with the pour).
via_route: []int = new int[VIAS](-1);

const VIA_POUR: int = -2;

// The names the library made, which a board's own come after.
names_lib: int = 0;

names_lib_used: int = 0;

net_track_width(n: int): f32 {
    if (n >= 0 && net_width[n] > 0.0) return net_width[n];
    rule_track
}

// (x, y) turned by k quarter turns counterclockwise.
turn_x(x: f32, y: f32, k: int): f32 {
    q: int = k & 3;
    if (q == 0) return x;
    if (q == 1) return -y;
    if (q == 2) return -x;
    y
}

turn_y(x: f32, y: f32, k: int): f32 {
    q: int = k & 3;
    if (q == 0) return y;
    if (q == 1) return x;
    if (q == 2) return -y;
    -x
}

// Where part p's pins are, from where it is and how it is turned.
place_pins(p: int) {
    f: int = part_fp[p];
    k: int = part_rot[p];
    odd: bool = (k & 1) == 1;
    for i in 0..fp_npads[f] {
        q: int = part_pin0[p] + i;
        lp: int = fp_pad0[f] + i;
        pin_x[q] = part_x[p] + turn_x(lp_x[lp], lp_y[lp], k);
        pin_y[q] = part_y[p] + turn_y(lp_x[lp], lp_y[lp], k);
        hw: f32 = lp_w[lp] * 0.5;
        hh: f32 = lp_h[lp] * 0.5;
        sw: f32 = lp_drill[lp];
        sh: f32 = lp_slot[lp];
        if (sh <= 0.0) sh = sw;
        if (odd) {
            pin_hw[q] = hh;
            pin_hh[q] = hw;
            pin_slot_w[q] = sh;
            pin_slot_h[q] = sw
        } else {
            pin_hw[q] = hw;
            pin_hh[q] = hh;
            pin_slot_w[q] = sw;
            pin_slot_h[q] = sh
        }
        pin_r[q] = lp_r[lp];
        pin_drill[q] = lp_drill[lp];
        layers: int = 1;
        if (lp_drill[lp] > 0.0) layers = 3;
        if (!lp_plated[lp]) layers = 0;
        pin_layers[q] = layers
    }
}

// A new part, at the end; its pins have no nets. Its number, or -1.
add_part(
    ref: int,
    f: int,
    x: f32,
    y: f32,
    rot: int,
    value: int
): int {
    if (parts_n >= PARTS || pins_n + fp_npads[f] > PINS) return -1;
    p: int = parts_n;
    part_ref[p] = ref;
    part_fp[p] = f;
    part_x[p] = x;
    part_y[p] = y;
    part_rot[p] = rot & 3;
    part_value[p] = value;
    part_pin0[p] = pins_n;
    for i in 0..fp_npads[f] {
        pin_part[pins_n + i] = p;
        pin_pad[pins_n + i] = fp_pad0[f] + i;
        pin_net[pins_n + i] = -1
    }
    pins_n = pins_n + fp_npads[f];
    parts_n = parts_n + 1;
    place_pins(p);
    p
}

// Part p taken off the board, the parts and pins after it moving down.
remove_part(p: int) {
    first: int = part_pin0[p];
    count: int = fp_npads[part_fp[p]];
    // (Routes to its pins go with it; the rest are told where pins moved.)
    routes_drop_pins(first, count);
    for q in first..pins_n - count {
        s: int = q + count;
        pin_part[q] = pin_part[s] - 1;
        pin_pad[q] = pin_pad[s];
        pin_net[q] = pin_net[s];
        pin_x[q] = pin_x[s];
        pin_y[q] = pin_y[s];
        pin_hw[q] = pin_hw[s];
        pin_hh[q] = pin_hh[s];
        pin_r[q] = pin_r[s];
        pin_drill[q] = pin_drill[s];
        pin_slot_w[q] = pin_slot_w[s];
        pin_slot_h[q] = pin_slot_h[s];
        pin_layers[q] = pin_layers[s]
    }
    pins_n = pins_n - count;
    for i in p..parts_n - 1 {
        part_ref[i] = part_ref[i + 1];
        part_fp[i] = part_fp[i + 1];
        part_x[i] = part_x[i + 1];
        part_y[i] = part_y[i + 1];
        part_rot[i] = part_rot[i + 1];
        part_value[i] = part_value[i + 1];
        part_pin0[i] = part_pin0[i + 1] - count
    }
    parts_n = parts_n - 1
}

find_part(t: []i8, from: int, to: int): int {
    for p in 0..parts_n {
        if (name_is(part_ref[p], t, from, to)) return p
    }
    -1
}

find_net(t: []i8, from: int, to: int): int {
    for n in 0..nets_n {
        if (name_is(net_name[n], t, from, to)) return n
    }
    -1
}

add_net(name: int, width: f32): int {
    if (nets_n >= NETS) return -1;
    net_name[nets_n] = name;
    net_width[nets_n] = width;
    nets_n = nets_n + 1;
    nets_n - 1
}

// A net named for what it is not yet: N1, N2, and on.
new_net(): int {
    k: int = 1;
    while (true) {
        line_clear();
        line_add("N");
        line_int(k);
        if (find_net(line, 0, line_n) < 0) return add_net(name_of(line, 0, line_n),
            0.0);
        k = k + 1
    }
    -1
}

// The pin named by REF.PAD, or -1.
find_pin(t: []i8, from: int, to: int): int {
    dot: int = -1;
    for i in from..to {
        if (dot < 0 && t[i] == '.') dot = i
    }
    if (dot < 0) return -1;
    p: int = find_part(t, from, dot);
    if (p < 0) return -1;
    f: int = part_fp[p];
    for i in 0..fp_npads[f] {
        if (name_is(lp_name[fp_pad0[f] + i], t, dot + 1, to)) return part_pin0[p] + i
    }
    -1
}

add_seg(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    w: f32,
    layer: int,
    net: int
): int {
    if (segs_n >= SEGS) return -1;
    sg_x0[segs_n] = x0;
    sg_y0[segs_n] = y0;
    sg_x1[segs_n] = x1;
    sg_y1[segs_n] = y1;
    sg_w[segs_n] = w;
    sg_layer[segs_n] = layer;
    sg_net[segs_n] = net;
    sg_route[segs_n] = -1;
    sg_leg[segs_n] = -1;
    segs_n = segs_n + 1;
    segs_n - 1
}

remove_seg(s: int) {
    last: int = segs_n - 1;
    sg_x0[s] = sg_x0[last];
    sg_y0[s] = sg_y0[last];
    sg_x1[s] = sg_x1[last];
    sg_y1[s] = sg_y1[last];
    sg_w[s] = sg_w[last];
    sg_layer[s] = sg_layer[last];
    sg_net[s] = sg_net[last];
    sg_route[s] = sg_route[last];
    sg_leg[s] = sg_leg[last];
    segs_n = last
}

add_via(x: f32, y: f32, net: int): int {
    if (vias_n >= VIAS) return -1;
    via_x[vias_n] = x;
    via_y[vias_n] = y;
    via_d[vias_n] = rule_via;
    via_drill[vias_n] = rule_drill;
    via_net[vias_n] = net;
    via_route[vias_n] = -1;
    vias_n = vias_n + 1;
    vias_n - 1
}

remove_via(v: int) {
    last: int = vias_n - 1;
    via_x[v] = via_x[last];
    via_y[v] = via_y[last];
    via_d[v] = via_d[last];
    via_drill[v] = via_drill[last];
    via_net[v] = via_net[last];
    via_route[v] = via_route[last];
    vias_n = last
}

// Net b folded into net a: its pins and copper become a's.
merge_nets(a: int, b: int) {
    if (a == b || a < 0 || b < 0) return;
    for q in 0..pins_n {
        if (pin_net[q] == b) pin_net[q] = a
    }
    for s in 0..segs_n {
        if (sg_net[s] == b) sg_net[s] = a
    }
    for v in 0..vias_n {
        if (via_net[v] == b) via_net[v] = a
    }
}

// A name for a new part of footprint f: its letter and the least number
// not yet taken.
new_ref(f: int): int {
    k: int = 1;
    while (true) {
        line_clear();
        line_name(fp_prefix[f]);
        line_int(k);
        if (find_part(line, 0, line_n) < 0) return name_of(line, 0, line_n);
        k = k + 1
    }
    0
}

// ---- reading ----
// The words of the line being read: where each starts and ends.
const WORDS: int = 2048;

word_from: []int = new int[WORDS](0);

word_to: []int = new int[WORDS](0);

words_n: int = 0;

split_words(t: []i8, from: int, to: int) {
    words_n = 0;
    i: int = from;
    while (i < to && words_n < WORDS) {
        while (i < to && (t[i] == ' ' || t[i] == '\t' || t[i] == '\r')) i = i + 1;
        if (i < to) {
            word_from[words_n] = i;
            while (i < to && t[i] != ' ' && t[i] != '\t' && t[i] != '\r') i = i + 1;
            word_to[words_n] = i;
            words_n = words_n + 1
        }
    }
}

word_is(t: []i8, w: int, s: str): bool {
    if (w >= words_n) return false;
    n: int = word_to[w] - word_from[w];
    if (n != len(s)) return false;
    for i in 0..n {
        if (t[word_from[w] + i] != s[i]) return false
    }
    true
}

word_num(t: []i8, w: int): f32 {
    if (w >= words_n) return 0.0;
    v: f32 = 0.0;
    sign: f32 = 1.0;
    frac: f32 = 0.0;
    for i in word_from[w]..word_to[w] {
        c: int = t[i] as int;
        if (c == 45) sign = -1.0 else if (c == 46) frac = 0.1 else if (c >= 48 && c <= 57) {
            if (frac > 0.0) {
                v = v + (c - 48) as f32 * frac;
                frac = frac * 0.1
            } else v = v * 10.0 + (c - 48) as f32
        }
    }
    sign * v
}

word_net(t: []i8, w: int): int {
    if (w >= words_n || word_is(t, w, "-")) return -1;
    n: int = find_net(t, word_from[w], word_to[w]);
    if (n < 0) n = add_net(name_of(t, word_from[w], word_to[w]), 0.0);
    n
}

// The first line that could not be read (or 0), and its number.
read_error: int = 0;

// The board from its text, from scratch.
read_board(t: []i8, n: int) {
    names_n = names_lib;
    name_used = names_lib_used;
    brd_name = name_str("Untitled");
    brd_w = 50.0;
    brd_h = 50.0;
    brd_r = 2.0;
    parts_n = 0;
    pins_n = 0;
    nets_n = 0;
    segs_n = 0;
    vias_n = 0;
    routes_n = 0;
    pour_net[TOP] = -1;
    pour_net[BOTTOM] = -1;
    read_error = 0;
    i: int = 0;
    lineno: int = 0;
    while (i < n) {
        e: int = i;
        while (e < n && t[e] != '\n') e = e + 1;
        lineno = lineno + 1;
        split_words(t, i, e);
        if (words_n > 0 && t[word_from[0]] != '#') {
            if (!read_line(t)) {
                if (read_error == 0) read_error = lineno
            }
        }
        i = e + 1
    }
    // (What follows from it: the routing grid, which legs of each route
    // have copper, and the pours.)
    after_read()
}

read_line(t: []i8): bool {
    if (word_is(t, 0, "board") && words_n >= 4) {
        brd_w = word_num(t, 1);
        brd_h = word_num(t, 2);
        brd_r = word_num(t, 3);
        if (words_n >= 5) brd_name = name_of(t, word_from[4], word_to[words_n - 1]);
        return true
    }
    if (word_is(t, 0, "rules") && words_n >= 5) {
        rule_clear = word_num(t, 1);
        rule_track = word_num(t, 2);
        rule_via = word_num(t, 3);
        rule_drill = word_num(t, 4);
        return true
    }
    if (word_is(t, 0, "part") && words_n >= 6) {
        f: int = find_footprint(t, word_from[2], word_to[2]);
        if (f < 0) return false;
        value: int = -1;
        if (words_n >= 7) value = name_of(t, word_from[6], word_to[6]);
        rot: int = (word_num(t, 5) / 90.0 + 0.5) as int;
        return add_part(name_of(t, word_from[1], word_to[1]), f, word_num(t, 3), word_num(t,
            4), rot, value) >= 0
    }
    if (word_is(t, 0, "net") && words_n >= 3) {
        net: int = word_net(t, 1);
        if (net < 0) return false;
        net_width[net] = word_num(t, 2);
        ok: bool = true;
        for w in 3..words_n {
            q: int = find_pin(t, word_from[w], word_to[w]);
            if (q >= 0) pin_net[q] = net else ok = false
        }
        return ok
    }
    if (word_is(t, 0, "track") && words_n >= 8) {
        layer: int = TOP;
        if (word_is(t, 2, "bottom")) layer = BOTTOM;
        s: int = add_seg(word_num(t, 4), word_num(t, 5), word_num(t, 6), word_num(t,
            7), word_num(t, 3), layer, word_net(t, 1));
        if (s < 0) return false;
        if (words_n >= 10) {
            sg_route[s] = word_num(t, 8) as int;
            sg_leg[s] = word_num(t, 9) as int
        }
        return true
    }
    if (word_is(t, 0, "via") && words_n >= 6) {
        v: int = add_via(word_num(t, 2), word_num(t, 3), word_net(t, 1));
        if (v >= 0) {
            via_d[v] = word_num(t, 4);
            via_drill[v] = word_num(t, 5);
            if (words_n >= 7) via_route[v] = word_num(t, 6) as int
        }
        return true
    }
    if (word_is(t, 0, "route") && words_n >= 7) return read_route(t);
    if (word_is(t, 0, "pour") && words_n >= 3) {
        net: int = word_net(t, 1);
        if (word_is(t, 2, "top")) pour_net[TOP] = net else pour_net[BOTTOM] = net;
        return true
    }
    false
}

// ---- writing ----
// The board as text, into doc (doc_n bytes of it).
doc: []i8 = new i8[1048576](0i8);

doc_n: int = 0;

doc_line() {
    line_byte(10);
    if (doc_n + line_n > len(doc)) return;
    for i in 0..line_n doc[doc_n + i] = line[i];
    doc_n = doc_n + line_n;
    line_clear()
}

doc_net(n: int) {
    if (n < 0) line_add("-") else line_name(net_name[n])
}

write_board() {
    doc_n = 0;
    line_clear();
    line_add("board ");
    line_num(brd_w, 3);
    line_add(" ");
    line_num(brd_h, 3);
    line_add(" ");
    line_num(brd_r, 3);
    line_add(" ");
    line_name(brd_name);
    doc_line();
    line_add("rules ");
    line_num(rule_clear, 3);
    line_add(" ");
    line_num(rule_track, 3);
    line_add(" ");
    line_num(rule_via, 3);
    line_add(" ");
    line_num(rule_drill, 3);
    doc_line();
    for p in 0..parts_n {
        line_add("part ");
        line_name(part_ref[p]);
        line_add(" ");
        line_name(fp_key[part_fp[p]]);
        line_add(" ");
        line_num(part_x[p], 4);
        line_add(" ");
        line_num(part_y[p], 4);
        line_add(" ");
        line_int(part_rot[p] * 90);
        if (part_value[p] >= 0) {
            line_add(" ");
            line_name(part_value[p])
        }
        doc_line()
    }
    for n in 0..nets_n {
        // (A net with no pins left is let go.)
        any: bool = false;
        for q in 0..pins_n {
            if (pin_net[q] == n) any = true
        }
        if (any) {
            line_add("net ");
            line_name(net_name[n]);
            line_add(" ");
            line_num(net_width[n], 3);
            for q in 0..pins_n {
                if (pin_net[q] == n) {
                    // (A long net goes on over several lines.)
                    if (line_n > 3800) {
                        doc_line();
                        line_add("net ");
                        line_name(net_name[n]);
                        line_add(" ");
                        line_num(net_width[n], 3)
                    }
                    line_add(" ");
                    line_name(part_ref[pin_part[q]]);
                    line_add(".");
                    line_name(lp_name[pin_pad[q]])
                }
            }
            doc_line()
        }
    }
    write_routes();
    for l in 0..2 {
        if (pour_net[l] >= 0) {
            line_add("pour ");
            line_name(net_name[pour_net[l]]);
            if (l == TOP) line_add(" top") else line_add(" bottom");
            doc_line()
        }
    }
    for s in 0..segs_n {
        line_add("track ");
        doc_net(sg_net[s]);
        if (sg_layer[s] == TOP) line_add(" top ") else line_add(" bottom ");
        line_num(sg_w[s], 3);
        line_add(" ");
        line_num(sg_x0[s], 4);
        line_add(" ");
        line_num(sg_y0[s], 4);
        line_add(" ");
        line_num(sg_x1[s], 4);
        line_add(" ");
        line_num(sg_y1[s], 4);
        if (sg_route[s] >= 0) {
            line_add(" ");
            line_int(sg_route[s]);
            line_add(" ");
            line_int(sg_leg[s])
        }
        doc_line()
    }
    for v in 0..vias_n {
        // (A pour's vias are made again with it.)
        if (via_route[v] != VIA_POUR) {
            line_add("via ");
            doc_net(via_net[v]);
            line_add(" ");
            line_num(via_x[v], 4);
            line_add(" ");
            line_num(via_y[v], 4);
            line_add(" ");
            line_num(via_d[v], 3);
            line_add(" ");
            line_num(via_drill[v], 3);
            if (via_route[v] >= 0) {
                line_add(" ");
                line_int(via_route[v])
            }
            doc_line()
        }
    }
}
