tag cad;

use_tag std, gl, x11, skate;

// The dock: a box of plywood layers that holds four handhelds lying flat,
// side by side two by two, and charges them without wires. Under each
// pocket a Qi transmitter (Adafruit 2162: 5 V in, its coil a 53 mm
// square) lies with its coil under the handheld's receiver; under them all
// the dock's own board (its board file's board) takes 5 V from USB-C and
// switches each transmitter on and off, as many at once as the charger
// gives power for (see tools/dock.py).
//
// The board file's `dock PLY SLOT_W SLOT_H SLOT_T QI_DY BX BY` line: the
// plywood's thickness; a handheld's size across, up and through (its
// case's); where its receiver's middle is, up from its own; and where the
// dock's board's middle is in the dock (the dock's middle at 0, 0). Its
// shapes are worked out in the dock's own coordinates and moved to the
// board's, as everything in this tool is drawn from the board's middle.
//
// From the bottom:
//   Base       held on by bolts (heads under it, between its wooden feet),
//              so it comes off to reach the boards; the dock's board is
//              bolted to it, and comes off with it
//   Cavity 1   the board, the transmitters' boards, their wires' ways;
//              whole under the coils, which sit on it
//   Cavity 2   the same, and the coils, each joined to its transmitter's
//              pocket (its leads' way, and the air's); the base bolts'
//              nuts in hexes
//   Floor      the pockets' floor, cut where the coils come up through it
//   Walls      round the pockets; the lowest three with dividers between
//              them, the rest only round the outside and the stowage,
//              so the handhelds can be lifted out (each has a finger
//              notch at its end); right of them, the stowage, for the
//              charger and its cable. Disc magnets in the top one's
//              front and back rims
// The lid: a frame (the walls' outline and holes, and magnets over the
// walls') and a top glued on it, hiding them, a grille in it over the
// back pockets' finger notches for the air the transmitters warm (it
// comes in under the base). It
// lifts off (a finger's notch under its front edge), and the magnets hold
// it down; two dowels standing up out of the walls line it up.
dock_on: bool = false;

dk_slot_w: f32 = 84.0;

dk_slot_h: f32 = 93.5;

dk_slot_t: f32 = 22.4;

dk_qi_dy: f32 = -22.0;

dk_bx: f32 = 0.0;

dk_by: f32 = 0.0;

// The rim round the outside (its sides), the dividers between pockets, and
// how much bigger a pocket is than a handheld each side.
const DK_RIM: f32 = 10.0;

// The front's and back's rims, deeper: the finger notches go 10 mm into
// them.
const DK_FRONT: f32 = 14.0;

const DK_BACK: f32 = 13.5;

const DK_DIV: f32 = 6.0;

// Its outline's corners' radius: as the handhelds' are.
const DK_CORNER: f32 = 6.5;

const DK_FIT: f32 = 0.75;

// The finger notches: across, and how deep into the rim.
const DK_NOTCH_W: f32 = 22.0;

const DK_NOTCH_D: f32 = 10.0;

// The lid's magnets: 10 x 2 mm discs, magnetized through (in 10.1 mm
// holes, each glued on its hole's floor, 1.2 mm in from the faces that
// meet: the pairs 2.4 mm apart, a firm hold, not a grip), in the front and back
// rims near their ends, 8 mm in from the stowage's and the pockets' sides.
const DK_MAGNET_D: f32 = 10.1;

const DK_MAGNET_IN: f32 = 8.0;

// How many of the walls have the dividers.
const DK_DIVIDED: int = 3;

// The transmitter (Adafruit 2162): its coil plate and its board.
const TX_COIL: f32 = 53.0;

const TX_COIL_T: f32 = 4.0;

const TX_W: f32 = 55.0;

const TX_H: f32 = 37.0;

const TX_T: f32 = 6.0;

// ---- sizes, in the dock's coordinates ----
dk_pw(): f32 {
    dk_slot_w + 2.0 * DK_FIT
}

dk_ph(): f32 {
    dk_slot_h + 2.0 * DK_FIT
}

// Inside the rim: the pockets and the dividers between.
dk_iw(): f32 {
    2.0 * dk_pw() + DK_DIV
}

dk_ih(): f32 {
    2.0 * dk_ph() + DK_DIV
}

// The stowage, right of the pockets past a wall: for the charger and its
// cable, as deep as the walls and the lid's frame (32 mm on 3.2 mm ply:
// the 28 mm charger lies in it, a metre of cable coiled beside it).
const DK_STOW_W: f32 = 54.0;

// The inside's left and right edges (the pockets about x = 0, the stowage
// to their right).
dk_xl(): f32 {
    -dk_iw() * 0.5
}

dk_xr(): f32 {
    dk_iw() * 0.5 + DK_DIV + DK_STOW_W
}

// The stowage's middle, across.
dk_stow_x(): f32 {
    dk_iw() * 0.5 + DK_DIV + DK_STOW_W * 0.5
}

dk_ow(): f32 {
    dk_xr() - dk_xl() + 2.0 * DK_RIM
}

// The outline's middle, across.
dk_ox(): f32 {
    (dk_xl() + dk_xr()) * 0.5
}

dk_oh(): f32 {
    dk_ih() + DK_BACK + DK_FRONT
}

// The outline's front and back faces (deeper at the front), and middle.
dk_yf(): f32 {
    -dk_ih() * 0.5 - DK_FRONT
}

dk_yb(): f32 {
    dk_ih() * 0.5 + DK_BACK
}

dk_oy(): f32 {
    (dk_yf() + dk_yb()) * 0.5
}

// Pocket k's middle: 0 front left, 1 front right, 2 back left, 3 back
// right.
dk_px(k: int): f32 {
    sx: f32 = -1.0;
    if (k == 1 || k == 3) sx = 1.0;
    sx * (dk_pw() + DK_DIV) * 0.5
}

dk_py(k: int): f32 {
    sy: f32 = -1.0;
    if (k >= 2) sy = 1.0;
    sy * (dk_ph() + DK_DIV) * 0.5
}

// Its coil's middle, under the handheld's receiver; its transmitter's
// board's, in the pocket's other end.
// (A millimetre out from the pocket's middle, clear of the board.)
dk_coil_x(k: int): f32 {
    if (k == 1 || k == 3) return dk_px(k) + 1.0;
    dk_px(k) - 1.0
}

dk_coil_y(k: int): f32 {
    dk_py(k) + dk_qi_dy
}

// (Out toward the dock's side a little, to leave the middle wider for
// the board.)
dk_tx_x(k: int): f32 {
    if (k == 1 || k == 3) return dk_px(k) + 3.0;
    dk_px(k) - 3.0
}

dk_tx_y(k: int): f32 {
    dk_py(k) + dk_ph() * 0.5 - (TX_H + 1.0) * 0.5 - 1.0
}

// How many walls: with the lid's frame over them, as tall as a handheld
// with its buttons' caps standing out of it (a layer), and a millimetre
// to spare at least; and as deep as the charger lying down, and 2 mm.
dk_walls(): int {
    n: int = ((dk_slot_t + cs_ply + 1.0) / cs_ply) as int;
    while ((n + 1) as f32 * cs_ply < CHG_T + 2.0) n = n + 1;
    n
}

// The layers' order.
const D_BASE: int = 0;

const D_CAV1: int = 1;

const D_CAV2: int = 2;

const D_FLOOR: int = 3;

const D_WALL0: int = 4;

// The lid's frame's place in the stack (the layer it would be).
dk_lid_l(): int {
    D_WALL0 + dk_walls()
}

// ---- its bolts: the base's, from under it into nuts in Cavity 2 (so
// they clamp the base to the body, through Cavity 1) ----
const DK_BOLTS: int = 6;

dk_bolt_x(k: int): f32 {
    sx: f32 = -1.0;
    if ((k & 1) == 1) sx = 1.0;
    dk_ox() + sx * (dk_ow() * 0.5 - 5.5)
}

dk_bolt_y(k: int): f32 {
    if (k >= 4) return dk_oy();
    if (k >= 2) return dk_yb() - 5.5;
    dk_yf() + 5.5
}

// ---- making it ----
// Shapes in the dock's coordinates, moved to the board's.
dk_box(
    x: f32,
    y: f32,
    hw: f32,
    hh: f32,
    r: f32
) {
    add_box(x - dk_bx, y - dk_by, hw, hh, r)
}

dk_circle(x: f32, y: f32, d: f32) {
    add_circle(x - dk_bx, y - dk_by, d)
}

dk_hex(x: f32, y: f32, af: f32) {
    add_hex(x - dk_bx, y - dk_by, af)
}

// A box from (x0, y0) to (x1, y1).
dk_span(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    r: f32
) {
    dk_box((x0 + x1) * 0.5, (y0 + y1) * 0.5, absf(x1 - x0) * 0.5, absf(y1 - y0) * 0.5,
        r)
}

dk_layer(l: int, name: str@immortal) {
    begin_piece(name, layer_z(l), 0.0, 0.0, true);
    dk_box(dk_ox(), dk_oy(), dk_ow() * 0.5, dk_oh() * 0.5, DK_CORNER)
}

make_dock() {
    find_tongues();
    hh: f32 = dk_ih() * 0.5;
    xr: f32 = dk_xr();
    yf: f32 = dk_yf();
    // Base: the bolts' holes, and the dock's board's (bolted to it).
    dk_layer(D_BASE, "Base");
    cs_what = "A bolt that holds the base on (its head under it)";
    for k in 0..DK_BOLTS dk_circle(dk_bolt_x(k), dk_bolt_y(k), BOLT_HOLE);
    cs_what = "A bolt that holds the dock's board to the base";
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "mh25")) add_circle(part_x[p], part_y[p], BOLT_HOLE)
    }
    // (Vents beside each transmitter's board, in its pocket's outer end:
    // the air comes in under the box, on its feet, up past the board, into
    // its coil's pocket and up round the coil, and out through the back
    // near the top.)
    cs_what = "A vent: air in, under a transmitter's board";
    for k in 0..4 dk_box(dk_tx_vent_x(k), dk_tx_y(k), 1.5, 14.0, 1.5);
    // (Room under the dock's board for its through-hole parts' joints: the
    // transmitters' wires' pads, the USB socket's shell.)
    cs_what = "Room for the joints under the dock's board";
    for p in 0..parts_n {
        if (!fp_is(part_fp[p], "mh25")) {
            x0: f32 = 1000.0;
            y0: f32 = 1000.0;
            x1: f32 = -1000.0;
            y1: f32 = -1000.0;
            for q in part_pin0[p]..part_pin0[p] + fp_npads[part_fp[p]] {
                if (pin_drill[q] > 0.0 && lp_plated[pin_pad[q]]) {
                    e: f32 = maxf(pin_slot_w[q], pin_slot_h[q]) * 0.5 + 0.8;
                    x0 = minf(x0, pin_x[q] - e);
                    y0 = minf(y0, pin_y[q] - e);
                    x1 = maxf(x1, pin_x[q] + e);
                    y1 = maxf(y1, pin_y[q] + e)
                }
            }
            if (x1 > x0) {
                // (Too near the outside to leave wood: open to it.)
                out: bool = false;
                if (case_y1() - y1 < WALL_MIN) {
                    y1 = case_y1() + 1.0;
                    out = true
                }
                if (y0 - case_y0() < WALL_MIN) {
                    y0 = case_y0() - 1.0;
                    out = true
                }
                add_box((x0 + x1) * 0.5, (y0 + y1) * 0.5, (x1 - x0) * 0.5, (y1 - y0) * 0.5,
                    1.0);
                if (out) open_last()
            }
        }
    }
    // (Loose on the dowels, as the lid is: the base comes off.)
    dk_dowels_d(3.3);
    // Cavities: the boards, the coils (in the second), the wires' ways.
    for c in 0..2 {
        if (c == 0) dk_layer(D_CAV1, "Cavity 1") else dk_layer(D_CAV2, "Cavity 2");
        cs_what = "The dock's board";
        // (The dock's board, and its tongues' notches out to the outside.)
        add_box(0.0, 0.0, brd_w * 0.5 + 0.4, brd_h * 0.5 + 0.4, brd_r + 0.4);
        // (In the second too where the part stands up into it.)
        for t in 0..tg_n {
            if (c == 0 || part_height(tg_part[t]) > layer_z(D_CAV2) + 0.2) edge_notch(t)
        }
        for k in 0..4 {
            cs_what = "A transmitter's board, and room over its vent";
            // (The transmitter's board, and room past its outer end over
            // its vent.)
            dk_tx_pocket(k);
            if (c == 1) {
                cs_what = "A transmitter's coil";
                dk_box(dk_coil_x(k), dk_coil_y(k), (TX_COIL + 1.0) * 0.5, (TX_COIL + 1.0) * 0.5,
                    2.0);
                cs_what = "The coil's leads' way to its board, and the air's";
                // (The coil's pocket and its transmitter's joined: its leads'
                // way, and the air's.)
                dk_span(dk_coil_x(k) - 20.0, dk_coil_y(k), dk_coil_x(k) + 20.0, dk_tx_y(k),
                    1.0)
            }
            cs_what = "A transmitter's wires, from the dock's board";
            dk_wire_way(k)
        }
        cs_what = "A base bolt's nut (in a hex), or the bolt";
        for k in 0..DK_BOLTS {
            if (c == 1) dk_hex(dk_bolt_x(k), dk_bolt_y(k), NUT_AF + 0.15) else dk_circle(dk_bolt_x(k),
                dk_bolt_y(k), BOLT_HOLE)
        }
        // (Cavity 1 comes off with the base: loose on the dowels too.)
        if (c == 0) dk_dowels_d(3.3) else dk_dowels()
    }
    // Floor: the coils come up through it, to be near the handhelds; the
    // base bolts' tips into it.
    dk_layer(D_FLOOR, "Floor");
    cs_what = "A coil, under a pocket, and the air's way up round it";
    // (2.5 mm wider than the coil each side: the air's way up round it.)
    for k in 0..4 dk_box(dk_coil_x(k), dk_coil_y(k), (TX_COIL + 6.0) * 0.5, (TX_COIL + 6.0) * 0.5,
        2.0);
    cs_what = "A base bolt's tip";
    for k in 0..DK_BOLTS dk_circle(dk_bolt_x(k), dk_bolt_y(k), BOLT_HOLE);
    cs_what = "A finger's notch, in under the handheld's end";
    // (Under each pocket's finger notch, 6 mm in under the handheld's end:
    // a fingertip goes under it to lift it.)
    // (The back pockets': the front ones' ends are over their coils, whose
    // holes are there already, under the handhelds' ends.)
    for k in 2..4 dk_span(dk_px(k) - DK_NOTCH_W * 0.5, dk_ih() * 0.5 - 6.0, dk_px(k) + DK_NOTCH_W * 0.5,
        dk_ih() * 0.5 + DK_NOTCH_D, 2.5);
    // (Which way a handheld goes in: its screen's outline engraved on the
    // floor at the screen's end, the coil under its other.)
    for k in 0..4 {
        dk_box(dk_px(k), dk_py(k) + dk_ph() * 0.5 - 18.0, 20.0, 15.1, 1.5);
        engrave_last();
        dk_box(dk_px(k), dk_py(k) + dk_ph() * 0.5 - 18.0, 17.0, 12.8, 1.0);
        engrave_last()
    }
    dk_dowels();
    // Walls.
    n: int = dk_walls();
    for w in 0..n {
        dk_layer(D_WALL0 + w, "Wall");
        cs_what = "A handheld's pocket";
        dk_wall_holes(w < DK_DIVIDED, w < DK_STOW_FIT);
        // (In the lowest, room for the base bolts' tips, should the ply be
        // thinner than it says.)
        cs_what = "A base bolt's tip";
        if (w == 0) {
            for k in 0..DK_BOLTS dk_circle(dk_bolt_x(k), dk_bolt_y(k), BOLT_HOLE)
        }
        cs_what = "A finger's notch, at a pocket's end";
        // (A finger's notch at each pocket's outer end: the front wall's
        // for the front ones, the back's for the back; 22 mm across, 10
        // deep, for a fingertip under the handheld's end.)
        for k in 0..4 {
            if (k >= 2) dk_span(dk_px(k) - DK_NOTCH_W * 0.5, hh - 0.5, dk_px(k) + DK_NOTCH_W * 0.5,
                hh + DK_NOTCH_D, 2.5) else dk_span(dk_px(k) - DK_NOTCH_W * 0.5, -hh - DK_NOTCH_D,
                dk_px(k) + DK_NOTCH_W * 0.5, -hh + 0.5, 2.5)
        }
        cs_what = "A finger's notch beside the charger";
        // (And in the stowage's outer wall beside the charger: a finger
        // down beside it, to lift it out.)
        dk_span(xr - 0.5, dk_chg_y() - 11.0, xr + 7.0, dk_chg_y() + 11.0, 2.5);
        cs_what = "The lid's magnet, or the notch to lift it by";
        // (In the top one, the lid's magnets; and a notch in the front,
        // under the lid's front edge between the front pockets, over the
        // lights: a finger's way to lift it.)
        if (w == n - 1) {
            dk_magnets();
            dk_box(0.0, yf + 2.5, 10.0, 3.5, 2.0);
            open_last()
        }
        dk_dowels()
    }
    layers_n = pieces_count;
    // The lid: its frame, as the walls (but no notches), its magnets, and
    // the dowels' tops; and its top, whole, glued on.
    begin_piece("Lid frame", layer_z(dk_lid_l()), 0.0, 0.0, true);
    dk_box(dk_ox(), dk_oy(), dk_ow() * 0.5, dk_oh() * 0.5, DK_CORNER);
    dk_wall_holes(false, false);
    dk_frame_vents();
    dk_magnets();
    // (Its dowels' holes a little loose, 3.3 mm: the lid lifts off them.)
    dk_dowels_d(3.3);
    // (The notch for a finger under the lid's front edge goes through it
    // too: 6.4 mm, a fingertip's.)
    dk_box(0.0, dk_yf() + 2.5, 10.0, 3.5, 2.0);
    open_last();
    begin_piece("Lid", layer_z(dk_lid_l()) + cs_ply, 0.0, 0.0, true);
    dk_box(dk_ox(), dk_oy(), dk_ow() * 0.5, dk_oh() * 0.5, DK_CORNER);
    dk_exhaust();
    // Feet, under the base, taller than the bolts' heads.
    for k in 0..4 {
        sx: f32 = -1.0;
        if (k == 1 || k == 3) sx = 1.0;
        sy: f32 = -1.0;
        if (k >= 2) sy = 1.0;
        begin_piece("Foot", layer_z(D_BASE) - cs_ply, dk_ox() + sx * (dk_ow() * 0.5 - 14.0) - dk_bx,
            dk_oy() + sy * (dk_oh() * 0.5 - 14.0) - dk_by, false);
        add_circle(0.0, 0.0, 12.0)
    }
}

// A wall's holes: each pocket (divided), or all of them as one; and the
// stowage, its wall all the way up (nothing slides out of it onto the
// screens). In the lowest walls (fitted), the stowage is wood but for a
// pocket the charger's shape, against the outer wall (its finger notch
// beside it), a round well the cable's coil sits in, and a channel for
// the cable between them: neither slides about.
const DK_STOW_FIT: int = 2;

dk_wall_holes(divided: bool, fitted: bool) {
    cs_what = "A handheld's pocket";
    if (divided) {
        // (Its corners round as the handhelds' are, and the gap round them.)
        for k in 0..4 dk_box(dk_px(k), dk_py(k), dk_pw() * 0.5, dk_ph() * 0.5, DK_CORNER + DK_FIT)
    } else dk_box(0.0, 0.0, dk_iw() * 0.5, dk_ih() * 0.5, DK_CORNER + DK_FIT);
    if (fitted) {
        cs_what = "The charger's pocket: it lies in it, its plug folded";
        cx: f32 = dk_chg_x();
        dk_box(cx, dk_chg_y(), (CHG_W + 3.0) * 0.5, (CHG_L + 3.0) * 0.5, 2.0);
        cs_what = "The cable's well: its coil sits in it";
        dk_circle(dk_stow_x(), dk_coil_cable_y(), CABLE_WELL);
        cs_what = "The cable's way from the charger to its coil";
        dk_span(dk_stow_x() - 4.0, dk_coil_cable_y(), dk_stow_x() + 4.0, dk_chg_y(),
            1.0);
        return
    }
    cs_what = "The stowage, for the charger and its cable";
    dk_span(dk_iw() * 0.5 + DK_DIV, -dk_ih() * 0.5, dk_xr(), dk_ih() * 0.5, 1.0)
}

// The lid's magnets' holes, near the ends of the front and back rims.
dk_magnets() {
    cs_what = "A magnet, 10 x 2 mm, for the lid";
    x0: f32 = dk_xl() + DK_MAGNET_IN;
    x1: f32 = dk_xr() - DK_MAGNET_IN;
    y0: f32 = dk_yf() + DK_FRONT * 0.5;
    y1: f32 = dk_yb() - DK_BACK * 0.5;
    dk_circle(x0, y0, DK_MAGNET_D);
    keep_last();
    dk_circle(x1, y0, DK_MAGNET_D);
    keep_last();
    dk_circle(x0, y1, DK_MAGNET_D);
    keep_last();
    dk_circle(x1, y1, DK_MAGNET_D);
    keep_last()
}

// Holes for two dowels (3 mm) through the glued layers, in the side rims at
// opposite ends: to line them up as they are glued; left standing 3 mm out
// of the top wall, into the lid's frame, they line the lid up too.
dk_dowels() {
    dk_dowels_d(3.0)
}

dk_dowels_d(d: f32) {
    cs_what = "A dowel, lining the layers (and the lid) up";
    dk_circle(dk_xl() - DK_RIM * 0.5, -60.0, d);
    keep_last();
    dk_circle(dk_xr() + DK_RIM * 0.5, -60.0, d);
    keep_last()
}

// A grille in the lid's top over each back pocket's finger notch (which
// the lid's frame leaves open too): four slots, 2.5 mm across and 8 long,
// 6 apart: the warm air's way out, up past the handheld's end; and what
// dust falls in falls into the notch, not on a screen.
dk_exhaust() {
    cs_what = "A vent: the warm air out";
    for k in 2..5 {
        for v in 0..4 dk_box(dk_vent_x(k) + (v as f32 - 1.5) * 6.0, dk_ih() * 0.5 + 4.5,
            1.25, 4.0, 1.25)
    }
}

// The grilles' middles: over the back pockets' notches (k 2, 3), and (4)
// over the stowage's back end, which balances the lid and vents the
// charger (2 mm in from its middle, clear of the lid's magnet).
dk_vent_x(k: int): f32 {
    if (k == 4) return dk_stow_x() - 2.0;
    dk_px(k)
}

// The back pockets' finger notches, and the like over the stowage,
// through the lid's frame: the grilles' air's way up.
dk_frame_vents() {
    cs_what = "The air's way up to the lid's grille, over a finger's notch";
    hh: f32 = dk_ih() * 0.5;
    for k in 2..5 dk_span(dk_vent_x(k) - DK_NOTCH_W * 0.5, hh - 0.5, dk_vent_x(k) + DK_NOTCH_W * 0.5,
        hh + DK_NOTCH_D, 2.5)
}

// Transmitter k's pocket in the cavities: its board and 6 mm past its
// outer end, over its vent.
dk_tx_pocket(k: int) {
    x0: f32 = dk_tx_x(k) - (TX_W + 1.0) * 0.5;
    x1: f32 = dk_tx_x(k) + (TX_W + 1.0) * 0.5;
    if (dk_tx_x(k) < 0.0) x0 = x0 - 6.0 else x1 = x1 + 6.0;
    dk_span(x0, dk_tx_y(k) - (TX_H + 1.0) * 0.5, x1, dk_tx_y(k) + (TX_H + 1.0) * 0.5,
        1.0)
}

// Where transmitter k's vent is: past its board's outer end.
dk_tx_vent_x(k: int): f32 {
    if (dk_tx_x(k) < 0.0) return dk_tx_x(k) - (TX_W + 1.0) * 0.5 - 3.0;
    dk_tx_x(k) + (TX_W + 1.0) * 0.5 + 3.0
}

// Transmitter k's wires' way, from its pads on the dock's board straight
// across to its board beside it.
dk_wire_way(k: int) {
    p: int = dk_tx_pads(k);
    if (p < 0) return;
    x: f32 = part_x[p] + dk_bx;
    y: f32 = part_y[p] + dk_by;
    tx: f32 = dk_tx_x(k);
    // (Into the transmitter's pocket a little, so the two are one hole.)
    edge: f32 = tx - (TX_W + 1.0) * 0.5 + 2.0;
    if (tx < 0.0) edge = tx + (TX_W + 1.0) * 0.5 - 2.0;
    dk_span(x, y - 1.5, edge, y + 1.5, 1.0)
}

// The pads on the dock's board for transmitter k's wires (the board's
// pads2 parts, valued TX1 to TX4), or -1.
dk_tx_pads(k: int): int {
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "pads2") && part_value[p] >= 0 && name_is_str(part_value[p],
            TX_NAMES[k])) return p
    }
    -1
}

TX_NAMES: []str = ["TX1", "TX2", "TX3", "TX4"];

// ---- what it says ----
// Each layer's line in the Case card.
dk_layer_says(l: int): str {
    if (l == D_BASE) return "Bolted on; taken off, it opens to the boards";
    if (l == D_CAV1) return "The boards and their wires";
    if (l == D_CAV2) return "The boards, the coils, the wires, and the nuts";
    if (l == D_FLOOR) return "The pockets' floor: the coils come up through it";
    if (l < D_WALL0 + DK_DIVIDED) return "Round each pocket: the handhelds lie in them";
    if (l == D_WALL0 + dk_walls() - 1) return "The top: the lid's magnets in its corners";
    "Round the outside, over the handhelds"
}

// ---- drawn ----
// What lies in the layer shown, under its wood: the transmitters'
// boards and coils, the handhelds in their pockets.
draw_dock_under(z0: f32) {
    s: f32 = cam_s;
    z1: f32 = z0 + cs_ply;
    for k in 0..4 {
        if (z0 < layer_z(D_FLOOR) && z1 > layer_z(D_CAV1)) {
            p_box_at(to_sx(dk_tx_x(k) - dk_bx), to_sy(dk_tx_y(k) - dk_by), TX_W * 0.5 * s,
                TX_H * 0.5 * s, 1.0 * s, 1989178, 0.95);
            p_box_at(to_sx(dk_coil_x(k) - dk_bx), to_sy(dk_coil_y(k) - dk_by), TX_COIL * 0.5 * s,
                TX_COIL * 0.5 * s, 2.0 * s, 12087091, 0.95)
        }
        if (z1 > layer_z(D_WALL0) && z0 < layer_z(D_WALL0) + dk_slot_t) p_box_at(to_sx(dk_px(k) - dk_bx),
            to_sy(dk_py(k) - dk_by), dk_slot_w * 0.5 * s, dk_slot_h * 0.5 * s, 2.0 * s,
            C_WOOD_LIGHT, 0.6)
    }
    // (The charger and its cable, in the stowage.)
    if (z1 > layer_z(D_WALL0) && z0 < layer_z(D_WALL0) + CHG_T) {
        p_box_at(to_sx(dk_chg_x() - dk_bx), to_sy(dk_chg_y() - dk_by), CHG_W * 0.5 * s,
            CHG_L * 0.5 * s, 4.0 * s, C_CHARGER, 0.95);
        p_ring(to_sx(dk_stow_x() - dk_bx), to_sy(dk_coil_cable_y() - dk_by), CABLE_R * s,
            4.0 * s, C_CABLE, 0.95)
    }
}

// What the stowage is drawn holding: the charger (Qualtek's QFWC-18, lying
// down, its plug folded; 48 x 48 x 28 mm, its datasheet's) and its cable,
// coiled.
const CHG_W: f32 = 48.0;

const CHG_L: f32 = 48.0;

const CHG_T: f32 = 28.0;

const CABLE_R: f32 = 18.0;

const C_CHARGER: int = 15132390; // #e6e6e6

const C_CABLE: int = 3355443; // #333333

// The cable's well, across: its coil and a little room.
const CABLE_WELL: f32 = 42.0;

// The charger's middle, across: against the stowage's outer wall.
dk_chg_x(): f32 {
    dk_xr() - (CHG_W + 3.0) * 0.5
}

dk_chg_y(): f32 {
    dk_ih() * 0.5 - CHG_L * 0.5 - 6.0
}

dk_coil_cable_y(): f32 {
    -dk_ih() * 0.5 + CABLE_R + 8.0
}

// In 3D: the transmitters and coils, the handhelds (as their cases'
// boxes, screens up), and the bolts, from under the base.
draw_dock_3d() {
    // (Its transmitters and coils go in with the base, from under it,
    // first: see steps.l8.)
    tz: f32 = layer_z(D_BASE) + cs_ply + lift(slot_battery);
    cz: f32 = layer_z(D_CAV2) + lift(slot_screen);
    hz: f32 = layer_z(D_WALL0) + lift(slot_domes);
    for k in 0..4 {
        x: f32 = dk_px(k) - dk_bx;
        tx: f32 = dk_tx_x(k) - dk_bx;
        ty: f32 = dk_tx_y(k) - dk_by;
        cx: f32 = dk_coil_x(k) - dk_bx;
        cy: f32 = dk_coil_y(k) - dk_by;
        if (steps_shows(G_DBASE)) {
            v3_group(G_DBASE, layer_z(D_CAV2), EXPLODE_GAP * slot_battery as f32);
            box3(tx - TX_W * 0.5, ty - TX_H * 0.5, tz, tx + TX_W * 0.5, ty + TX_H * 0.5,
                tz + TX_T, 1989178);
            v3_group(G_DBASE, layer_z(D_CAV2), EXPLODE_GAP * slot_screen as f32);
            box3(cx - TX_COIL * 0.5, cy - TX_COIL * 0.5, cz, cx + TX_COIL * 0.5, cy + TX_COIL * 0.5,
                cz + TX_COIL_T, 12087091)
        }
        py: f32 = dk_py(k) - dk_by;
        v3_group(G_DHH, hz, EXPLODE_GAP * slot_domes as f32);
        // (On the set, the handheld itself; else its place, as a box.)
        if (!steps_shows(G_DHH)) { } else if (stage_on && st_ok) stage_handheld(x,
            py, hz) else {
            box3(x - dk_slot_w * 0.5, py - dk_slot_h * 0.5, hz, x + dk_slot_w * 0.5,
                py + dk_slot_h * 0.5, hz + dk_slot_t, 13219725);
            box3(x - 30.0, py - 2.0, hz + dk_slot_t, x + 30.0, py + 34.0, hz + dk_slot_t + 0.05,
                C_GLASS)
        }
    }
    // (The handhelds' fronts: their texture's faces, all four at once, and
    // their edges.)
    if (stage_on && st_ok && steps_shows(G_DHH)) {
        v3_group(G_DHH, hz, EXPLODE_GAP * slot_domes as f32);
        for k in 0..4 {
            x: f32 = dk_px(k) - dk_bx;
            py: f32 = dk_py(k) - dk_by;
            z1: f32 = hz + st_t;
            quad_at(x + st_x0, py + st_y0, x + st_x1, py + st_y1, z1 - cs_ply, -1.0,
                C_WOOD);
            quad_at(x + st_x0, py + st_y0, x + st_x1, py + st_y1, z1, 1.0, C_WOOD)
        }
        v3_flush(true, LEVELS - 1);
        for k in 0..4 round_wall(dk_px(k) - dk_bx, dk_py(k) - dk_by, st_w * 0.5, st_h * 0.5,
            st_r, hz + st_t - cs_ply, hz + st_t);
        v3_flush(false, 0)
    }
    // (The charger and its cable in the stowage, with the handhelds.)
    if (steps_shows(G_DHH)) {
        v3_group(G_DHH, hz, EXPLODE_GAP * slot_domes as f32);
        dock_charger_3d(hz)
    }
    // (The bolts: their heads under the base; apart, below it all; and
    // their nuts, in the second cavity.)
    foot: f32 = layer_z(D_BASE) - HEAD_T;
    nz: f32 = layer_z(D_CAV2) + lift(slot_nuts);
    if (steps_shows(G_BOLTS)) {
        v3_group(G_BOLTS, foot, -EXPLODE_GAP * 2.0);
        for b in 0..DK_BOLTS {
            x: f32 = dk_bolt_x(b) - dk_bx;
            y: f32 = dk_bolt_y(b) - dk_by;
            post(x, y, HEAD_D * 0.5, foot, foot + HEAD_T, C_METAL3);
            post(x, y, 1.25, foot + HEAD_T, foot + HEAD_T + DK_BOLT_L, C_METAL3)
        }
    }
    if (steps_shows(G_NUTS)) {
        v3_group(G_NUTS, nz, EXPLODE_GAP * slot_nuts as f32);
        for b in 0..DK_BOLTS post(dk_bolt_x(b) - dk_bx, dk_bolt_y(b) - dk_by, NUT_AF * 0.55,
            nz, nz + NUT_T, 9474192)
    }
}

dock_charger_3d(hz: f32) {
    sx: f32 = dk_stow_x() - dk_bx;
    cx: f32 = dk_chg_x() - dk_bx;
    cy: f32 = dk_chg_y() - dk_by;
    box3(cx - CHG_W * 0.5, cy - CHG_L * 0.5, hz, cx + CHG_W * 0.5, cy + CHG_L * 0.5,
        hz + CHG_T, C_CHARGER);
    ly: f32 = dk_coil_cable_y() - dk_by;
    for t in 0..3 {
        r: f32 = CABLE_R - t as f32 * 2.2;
        for a in 0..48 {
            a0: f32 = a as f32 * 0.1308997;
            post(sx + r * cosf(a0), ly + r * sinf(a0), 1.6, hz + t as f32 * 0.4, hz + 3.2 + t as f32 * 0.4,
                C_CABLE)
        }
    }
}

// A handheld, as taken for the set (see designs.l8), its middle at (x, y),
// its back on z: its sides; inside, under its front, its screen and its
// buttons' caps (its front, with its holes, is drawn over them all
// after).
stage_handheld(x: f32, y: f32, z: f32) {
    top: f32 = z + st_t;
    under: f32 = top - cs_ply;
    round_wall(x, y, st_w * 0.5, st_h * 0.5, st_r, z, under);
    // (Under the front, a dark inside, the screen's glass, its picture.)
    box3(x - st_w * 0.5 + 2.0, y - st_h * 0.5 + 2.0, under - 0.6, x + st_w * 0.5 - 2.0,
        y + st_h * 0.5 - 2.0, under - 0.3, 3815994);
    box3(x + st_scr_x - SCREEN_W * 0.5, y + st_scr_y - SCREEN_H * 0.5, under - 0.3,
        x + st_scr_x + SCREEN_W * 0.5, y + st_scr_y + SCREEN_H * 0.5, under, C_GLASS);
    box3(x + st_va_x - SCREEN_VA_W * 0.5, y + st_va_y - SCREEN_VA_H * 0.5, under,
        x + st_va_x + SCREEN_VA_W * 0.5, y + st_va_y + SCREEN_VA_H * 0.5, under + 0.05,
        C_SCREEN_ON);
    for c in 0..st_caps {
        t: f32 = top;
        if (st_cap_up[c]) t = top + cs_ply;
        cx: f32 = x + st_cap_x[c];
        cy: f32 = y + st_cap_y[c];
        if (st_cap_w[c] > 0.0) {
            l: f32 = st_cap_r[c];
            h: f32 = st_cap_w[c];
            box3(cx - l, cy - h, under, cx + l, cy + h, t, C_WOOD_LIGHT);
            box3(cx - h, cy - l, under, cx + h, cy + l, t, C_WOOD_LIGHT)
        } else post(cx, cy, st_cap_r[c], under, t, C_WOOD_LIGHT)
    }
    // (The window's acrylic, flush: the picture seen through it.)
    box3(x + st_win_x - st_win_hw, y + st_win_y - st_win_hh, under, x + st_win_x + st_win_hw,
        y + st_win_y + st_win_hh, top - 0.2, C_SCREEN_ON)
}

// The base's bolts: through the base and Cavity 1 into the nuts in Cavity
// 2 (their tips into the floor's holes): 12 mm, steel.
const DK_BOLT_L: f32 = 12.0
