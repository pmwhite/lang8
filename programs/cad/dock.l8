tag cad;

use_tag std, gl, x11, skate;

// The dock: a box of plywood layers that holds four handhelds lying flat,
// side by side two by two, and charges them without wires. Under each
// pocket a Qi transmitter (Adafruit 2162: 5 V in, its coil a 53 mm
// square) lies with its coil under the handheld's receiver; under them all
// the dock's own board (its board file's board) takes 5 V from USB-C and
// switches each transmitter on and off, as many at once as the charger
// gives power for (see tools/dock.py).
//
// The board file's `dock PLY SLOT_W SLOT_H SLOT_T QI_DY BX BY` line: the
// plywood's thickness; a handheld's size across, up and through (its
// case's); where its receiver's middle is, up from its own; and where the
// dock's board's middle is in the dock (the dock's middle at 0, 0). Its
// shapes are worked out in the dock's own coordinates and moved to the
// board's, as everything in this tool is drawn from the board's middle.
//
// From the bottom:
//   Base       held on by bolts (heads under it, between its wooden feet),
//              so it comes off to reach the boards
//   Cavity 1   the board, the transmitters' boards, their wires' ways, and
//              the nuts in hexes; whole under the coils, which sit on it
//   Cavity 2   the same, and the coils
//   Floor      the pockets' floor, cut where the coils come up through it
//   Walls      round the pockets; the lowest three with dividers between
//              them, the rest only round the outside and the stowage,
//              so the handhelds can be lifted out (each has a finger
//              notch at its end); right of them, the stowage, for the
//              charger and its cable
//   Channel    the lid slides in it, from the front
//   Lip        over the lid's sides and back, so it cannot lift out; at
//              the front a strip on the lid fills it
// The lid's catch: a tab bolted through the lid's front strip turns into
// a notch in the lip's right side, and the lid cannot slide; turned back,
// over the lid, it slides out.
dock_on: bool = false;

dk_slot_w: f32 = 82.0;

dk_slot_h: f32 = 90.5;

dk_slot_t: f32 = 25.6;

dk_qi_dy: f32 = -22.0;

dk_bx: f32 = 0.0;

dk_by: f32 = 0.0;

// The rim round the outside, the dividers between pockets, how much
// bigger a pocket is than a handheld each side, and how far the lip comes
// over the lid.
const DK_RIM: f32 = 8.0;

const DK_DIV: f32 = 6.0;

const DK_FIT: f32 = 0.3;

const DK_LIP: f32 = 4.0;

// How many of the walls have the dividers.
const DK_DIVIDED: int = 3;

// The transmitter (Adafruit 2162): its coil plate and its board.
const TX_COIL: f32 = 53.0;

const TX_COIL_T: f32 = 4.0;

const TX_W: f32 = 55.0;

const TX_H: f32 = 37.0;

const TX_T: f32 = 6.0;

// The catch: its arm's reach from its pivot, and the circle it sweeps.
const CATCH_ARM: f32 = 6.5;

const CATCH_SWEEP: f32 = 7.3;

// ---- sizes, in the dock's coordinates ----
dk_pw(): f32 {
    dk_slot_w + 2.0 * DK_FIT
}

dk_ph(): f32 {
    dk_slot_h + 2.0 * DK_FIT
}

// Inside the rim: the pockets and the dividers between.
dk_iw(): f32 {
    2.0 * dk_pw() + DK_DIV
}

dk_ih(): f32 {
    2.0 * dk_ph() + DK_DIV
}

// The stowage, right of the pockets past a wall: for the charger and its
// cable, as deep as the pockets (a charger under 28 mm one way lies in it,
// a metre of cable coiled beside it).
const DK_STOW_W: f32 = 48.0;

// The inside's left and right edges (the pockets about x = 0, the stowage
// to their right).
dk_xl(): f32 {
    -dk_iw() * 0.5
}

dk_xr(): f32 {
    dk_iw() * 0.5 + DK_DIV + DK_STOW_W
}

// The stowage's middle, across.
dk_stow_x(): f32 {
    dk_iw() * 0.5 + DK_DIV + DK_STOW_W * 0.5
}

dk_ow(): f32 {
    dk_xr() - dk_xl() + 2.0 * DK_RIM
}

// The outline's middle, across.
dk_ox(): f32 {
    (dk_xl() + dk_xr()) * 0.5
}

dk_oh(): f32 {
    dk_ih() + 2.0 * DK_RIM
}

// Pocket k's middle: 0 front left, 1 front right, 2 back left, 3 back
// right.
dk_px(k: int): f32 {
    sx: f32 = -1.0;
    if (k == 1 || k == 3) sx = 1.0;
    sx * (dk_pw() + DK_DIV) * 0.5
}

dk_py(k: int): f32 {
    sy: f32 = -1.0;
    if (k >= 2) sy = 1.0;
    sy * (dk_ph() + DK_DIV) * 0.5
}

// Its coil's middle, under the handheld's receiver; its transmitter's
// board's, in the pocket's other end.
// (A millimetre out from the pocket's middle, clear of the board.)
dk_coil_x(k: int): f32 {
    if (k == 1 || k == 3) return dk_px(k) + 1.0;
    dk_px(k) - 1.0
}

dk_coil_y(k: int): f32 {
    dk_py(k) + dk_qi_dy
}

// (Out toward the dock's side a little, to leave the middle wider for
// the board.)
dk_tx_x(k: int): f32 {
    if (k == 1 || k == 3) return dk_px(k) + 3.0;
    dk_px(k) - 3.0
}

dk_tx_y(k: int): f32 {
    dk_py(k) + dk_ph() * 0.5 - (TX_H + 1.0) * 0.5 - 1.0
}

// The lid catch's pivot: in the front strip, by its right end.
dk_pivot_x(): f32 {
    dk_xr() - 3.5
}

dk_pivot_y(): f32 {
    -dk_oh() * 0.5 + DK_RIM * 0.5
}

// How many walls: as tall as a handheld, and room over it.
dk_walls(): int {
    ((dk_slot_t + 0.5) / cs_ply) as int + 1
}

// The layers' order.
const D_BASE: int = 0;

const D_CAV1: int = 1;

const D_CAV2: int = 2;

const D_FLOOR: int = 3;

const D_WALL0: int = 4;

dk_channel(): int {
    D_WALL0 + dk_walls()
}

dk_lip(): int {
    dk_channel() + 1
}

// ---- its bolts: the base's, from under it into nuts in Cavity 1 ----
const DK_BOLTS: int = 6;

dk_bolt_x(k: int): f32 {
    sx: f32 = -1.0;
    if ((k & 1) == 1) sx = 1.0;
    dk_ox() + sx * (dk_ow() * 0.5 - 5.0)
}

dk_bolt_y(k: int): f32 {
    if (k >= 4) return 0.0;
    sy: f32 = -1.0;
    if (k >= 2) sy = 1.0;
    sy * (dk_oh() * 0.5 - 5.0)
}

// ---- making it ----
// Shapes in the dock's coordinates, moved to the board's.
dk_box(
    x: f32,
    y: f32,
    hw: f32,
    hh: f32,
    r: f32
) {
    add_box(x - dk_bx, y - dk_by, hw, hh, r)
}

dk_circle(x: f32, y: f32, d: f32) {
    add_circle(x - dk_bx, y - dk_by, d)
}

dk_hex(x: f32, y: f32, af: f32) {
    add_hex(x - dk_bx, y - dk_by, af)
}

// A box from (x0, y0) to (x1, y1).
dk_span(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    r: f32
) {
    dk_box((x0 + x1) * 0.5, (y0 + y1) * 0.5, absf(x1 - x0) * 0.5, absf(y1 - y0) * 0.5,
        r)
}

dk_layer(l: int, name: str@immortal) {
    begin_piece(name, layer_z(l), 0.0, 0.0, true);
    dk_box(dk_ox(), 0.0, dk_ow() * 0.5, dk_oh() * 0.5, 4.0)
}

make_dock() {
    find_tongues();
    hw: f32 = dk_iw() * 0.5;
    hh: f32 = dk_ih() * 0.5;
    xl: f32 = dk_xl();
    xr: f32 = dk_xr();
    oh: f32 = dk_oh() * 0.5;
    // Base: the bolts' holes.
    dk_layer(D_BASE, "Base");
    for k in 0..DK_BOLTS dk_circle(dk_bolt_x(k), dk_bolt_y(k), BOLT_HOLE);
    // Cavities: the boards, the coils (in the second), the wires' ways.
    for c in 0..2 {
        if (c == 0) dk_layer(D_CAV1, "Cavity 1") else dk_layer(D_CAV2, "Cavity 2");
        // (The dock's board, and its tongue's notch out to the outside.)
        add_box(0.0, 0.0, brd_w * 0.5 + 0.4, brd_h * 0.5 + 0.4, brd_r + 0.4);
        for t in 0..tg_n {
            if (c == 0 || part_height(tg_part[t]) > layer_z(D_CAV2) + 0.2) edge_notch(t)
        }
        for k in 0..4 {
            dk_box(dk_tx_x(k), dk_tx_y(k), (TX_W + 1.0) * 0.5, (TX_H + 1.0) * 0.5,
                1.0);
            if (c == 1) dk_box(dk_coil_x(k), dk_coil_y(k), (TX_COIL + 1.0) * 0.5,
                (TX_COIL + 1.0) * 0.5, 2.0);
            dk_wire_way(k)
        }
        for k in 0..DK_BOLTS {
            if (c == 0) dk_hex(dk_bolt_x(k), dk_bolt_y(k), NUT_AF + 0.15) else dk_circle(dk_bolt_x(k),
                dk_bolt_y(k), BOLT_HOLE)
        }
    }
    // Floor: the coils come up through it, to be near the handhelds.
    dk_layer(D_FLOOR, "Floor");
    for k in 0..4 dk_box(dk_coil_x(k), dk_coil_y(k), (TX_COIL + 1.0) * 0.5, (TX_COIL + 1.0) * 0.5,
        2.0);
    // Walls.
    for w in 0..dk_walls() {
        dk_layer(D_WALL0 + w, "Wall");
        if (w < DK_DIVIDED) {
            for k in 0..4 dk_box(dk_px(k), dk_py(k), dk_pw() * 0.5, dk_ph() * 0.5,
                1.0)
        } else dk_box(0.0, 0.0, hw, hh, 1.0);
        // (The stowage, its wall all the way up: nothing slides out of it
        // onto the screens.)
        dk_span(hw + DK_DIV, -hh, xr, hh, 1.0);
        // (A finger's notch at each pocket's outer end: the front wall's
        // for the front ones, the back's for the back.)
        for k in 0..4 {
            sy: f32 = -1.0;
            if (k >= 2) sy = 1.0;
            dk_circle(dk_px(k), sy * hh, 12.0)
        }
    }
    // Channel: the lid's room, open at the front.
    dk_layer(dk_channel(), "Channel");
    dk_span(xl - DK_LIP, -oh - 1.0, xr + DK_LIP, hh + DK_LIP, 0.5);
    // Lip: over the lid's sides and back; and the catch's notch.
    dk_layer(dk_lip(), "Lip");
    dk_span(xl, -oh - 1.0, xr, hh, 0.5);
    dk_circle(dk_pivot_x(), dk_pivot_y(), 2.0 * CATCH_SWEEP);
    // The lid (in the channel), its front strip (in the lip's front), and
    // the catch (in the strip), each its own piece.
    begin_piece("Lid", layer_z(dk_channel()), 0.0, 0.0, true);
    dk_span(xl - DK_LIP + 0.3, -oh, xr + DK_LIP - 0.3, hh + DK_LIP - 0.3, 0.5);
    dk_hex(dk_pivot_x(), dk_pivot_y(), NUT_AF + 0.15);
    begin_piece("Lid's front", layer_z(dk_lip()), 0.0, 0.0, true);
    dk_span(xl + 0.3, -oh, xr - 0.3, -oh + DK_RIM, 0.5);
    dk_circle(dk_pivot_x(), dk_pivot_y(), 2.0 * CATCH_SWEEP);
    begin_piece("Catch", layer_z(dk_lip()), dk_pivot_x() - dk_bx, dk_pivot_y() - dk_by,
        false);
    add_box((CATCH_ARM - 2.5) * 0.5, 0.0, (CATCH_ARM + 2.5) * 0.5, 2.5, 2.5);
    add_circle(0.0, 0.0, BOLT_HOLE);
    // Feet, under the base, taller than the bolts' heads.
    for k in 0..4 {
        sx: f32 = -1.0;
        if (k == 1 || k == 3) sx = 1.0;
        sy: f32 = -1.0;
        if (k >= 2) sy = 1.0;
        begin_piece("Foot", layer_z(D_BASE) - cs_ply, dk_ox() + sx * (dk_ow() * 0.5 - 14.0) - dk_bx,
            sy * (oh - 14.0) - dk_by, false);
        add_circle(0.0, 0.0, 12.0)
    }
    layers_n = dk_lip() + 1
}

// Transmitter k's wires' way, from its pads on the dock's board: the back
// ones straight across to their boards beside it, the front ones down the
// middle and across.
dk_wire_way(k: int) {
    p: int = dk_tx_pads(k);
    if (p < 0) return;
    x: f32 = part_x[p] + dk_bx;
    y: f32 = part_y[p] + dk_by;
    tx: f32 = dk_tx_x(k);
    ty: f32 = dk_tx_y(k);
    // (Into the transmitter's pocket a little, so the two are one hole.)
    edge: f32 = tx - (TX_W + 1.0) * 0.5 + 2.0;
    if (tx < 0.0) edge = tx + (TX_W + 1.0) * 0.5 - 2.0;
    if (k >= 2) {
        dk_span(x, y - 1.5, edge, y + 1.5, 1.0);
        return
    }
    dk_span(x - 1.5, y, x + 1.5, ty, 1.0);
    dk_span(x, ty - 1.5, edge, ty + 1.5, 1.0)
}

// The pads on the dock's board for transmitter k's wires (the board's
// pads2 parts, valued TX1 to TX4), or -1.
dk_tx_pads(k: int): int {
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "pads2") && part_value[p] >= 0 && name_is(part_value[p],
            bytes(TX_NAMES[k]), 0, 3)) return p
    }
    -1
}

TX_NAMES: []str = ["TX1", "TX2", "TX3", "TX4"];

// ---- what it says ----
// Each layer's line in the Case card.
dk_layer_says(l: int): str {
    if (l == D_BASE) return "Bolted on: off, it opens to the boards";
    if (l == D_CAV1) return "The boards, their wires, and the nuts";
    if (l == D_CAV2) return "The boards, the coils, and the wires";
    if (l == D_FLOOR) return "The pockets' floor: the coils come up through it";
    if (l == dk_channel()) return "The lid slides in it, from the front";
    if (l == dk_lip()) return "Over the lid's sides; its catch turns into a notch here";
    if (l < D_WALL0 + DK_DIVIDED) return "Round each pocket: the handhelds lie in them";
    "Round the outside, over the handhelds"
}

// ---- drawn ----
// What lies in the layer shown, under its wood: the transmitters'
// boards and coils, the handhelds in their pockets.
draw_dock_under(z0: f32) {
    s: f32 = cam_s;
    z1: f32 = z0 + cs_ply;
    for k in 0..4 {
        if (z0 < layer_z(D_FLOOR) && z1 > layer_z(D_CAV1)) {
            p_box_at(to_sx(dk_tx_x(k) - dk_bx), to_sy(dk_tx_y(k) - dk_by), TX_W * 0.5 * s,
                TX_H * 0.5 * s, 1.0 * s, 1989178, 0.95);
            p_box_at(to_sx(dk_coil_x(k) - dk_bx), to_sy(dk_coil_y(k) - dk_by), TX_COIL * 0.5 * s,
                TX_COIL * 0.5 * s, 2.0 * s, 12087091, 0.95)
        }
        if (z1 > layer_z(D_WALL0) && z0 < layer_z(D_WALL0) + dk_slot_t) p_box_at(to_sx(dk_px(k) - dk_bx),
            to_sy(dk_py(k) - dk_by), dk_slot_w * 0.5 * s, dk_slot_h * 0.5 * s, 2.0 * s,
            C_WOOD_LIGHT, 0.6)
    }
    // (The charger and its cable, in the stowage.)
    if (z1 > layer_z(D_WALL0) && z0 < layer_z(D_WALL0) + CHG_T) {
        p_box_at(to_sx(dk_stow_x() - dk_bx), to_sy(dk_chg_y() - dk_by), CHG_W * 0.5 * s,
            CHG_L * 0.5 * s, 4.0 * s, C_CHARGER, 0.95);
        p_ring(to_sx(dk_stow_x() - dk_bx), to_sy(dk_coil_cable_y() - dk_by), CABLE_R * s,
            4.0 * s, C_CABLE, 0.95)
    }
}

// What the stowage is drawn holding: the charger (Qualtek's QFWC, lying
// down, its plug folded; about 39 x 53.5 x 26.8 mm) and its cable, coiled.
const CHG_W: f32 = 39.0;

const CHG_L: f32 = 53.5;

const CHG_T: f32 = 26.8;

const CABLE_R: f32 = 18.0;

const C_CHARGER: int = 15132390; // #e6e6e6

const C_CABLE: int = 3355443; // #333333

dk_chg_y(): f32 {
    dk_ih() * 0.5 - CHG_L * 0.5 - 6.0
}

dk_coil_cable_y(): f32 {
    -dk_ih() * 0.5 + CABLE_R + 8.0
}

// In 3D: the transmitters and coils, the handhelds (as their cases'
// boxes, screens up), and the bolts, from under the base.
draw_dock_3d() {
    tz: f32 = layer_z(D_BASE) + cs_ply + lift(slot_battery);
    cz: f32 = layer_z(D_CAV2) + lift(slot_screen);
    hz: f32 = layer_z(D_WALL0) + lift(slot_domes);
    for k in 0..4 {
        x: f32 = dk_px(k) - dk_bx;
        tx: f32 = dk_tx_x(k) - dk_bx;
        ty: f32 = dk_tx_y(k) - dk_by;
        box3(tx - TX_W * 0.5, ty - TX_H * 0.5, tz, tx + TX_W * 0.5, ty + TX_H * 0.5,
            tz + TX_T, 1989178);
        cx: f32 = dk_coil_x(k) - dk_bx;
        cy: f32 = dk_coil_y(k) - dk_by;
        box3(cx - TX_COIL * 0.5, cy - TX_COIL * 0.5, cz, cx + TX_COIL * 0.5, cy + TX_COIL * 0.5,
            cz + TX_COIL_T, 12087091);
        py: f32 = dk_py(k) - dk_by;
        // (On the set, the handheld itself; else its place, as a box.)
        if (stage_on && st_ok) stage_handheld(x, py, hz) else {
            box3(x - dk_slot_w * 0.5, py - dk_slot_h * 0.5, hz, x + dk_slot_w * 0.5,
                py + dk_slot_h * 0.5, hz + dk_slot_t, 13219725);
            box3(x - 30.0, py - 2.0, hz + dk_slot_t, x + 30.0, py + 34.0, hz + dk_slot_t + 0.05,
                C_GLASS)
        }
    }
    // (The handhelds' fronts: their texture's slices, all four at once.)
    if (stage_on && st_ok) {
        v3_flush(false, 0);
        slices: int = 12;
        for k in 0..4 {
            x: f32 = dk_px(k) - dk_bx;
            py: f32 = dk_py(k) - dk_by;
            z1: f32 = hz + st_t;
            for i in 0..slices + 1 {
                z: f32 = z1 - cs_ply + cs_ply * i as f32 / slices as f32;
                rgb: int = C_WALL3;
                if (i == slices) rgb = C_WOOD;
                if (i == 0) quad_at(x + st_x0, py + st_y0, x + st_x1, py + st_y1,
                    z, -1.0, C_WOOD) else quad_at(x + st_x0, py + st_y0, x + st_x1,
                    py + st_y1, z, 1.0, rgb)
            }
        }
        v3_flush(true, LEVELS - 1)
    }
    // (The charger and its cable in the stowage, with the handhelds.)
    sx: f32 = dk_stow_x() - dk_bx;
    cy: f32 = dk_chg_y() - dk_by;
    box3(sx - CHG_W * 0.5, cy - CHG_L * 0.5, hz, sx + CHG_W * 0.5, cy + CHG_L * 0.5,
        hz + CHG_T, C_CHARGER);
    ly: f32 = dk_coil_cable_y() - dk_by;
    for t in 0..3 {
        r: f32 = CABLE_R - t as f32 * 2.2;
        for a in 0..48 {
            a0: f32 = a as f32 * 0.1308997;
            post(sx + r * cosf(a0), ly + r * sinf(a0), 1.6, hz + t as f32 * 0.4, hz + 3.2 + t as f32 * 0.4,
                C_CABLE)
        }
    }
    // (The bolts: their heads under the base; apart, below it all.)
    down: f32 = explode_t * EXPLODE_GAP * 2.0;
    foot: f32 = layer_z(D_BASE) - HEAD_T - down;
    for b in 0..DK_BOLTS {
        x: f32 = dk_bolt_x(b) - dk_bx;
        y: f32 = dk_bolt_y(b) - dk_by;
        post(x, y, HEAD_D * 0.5, foot, foot + HEAD_T, C_METAL3);
        post(x, y, 1.25, foot + HEAD_T, foot + HEAD_T + DK_BOLT_L, C_METAL3);
        nz: f32 = layer_z(D_CAV1) + lift(slot_nuts);
        post(x, y, NUT_AF * 0.55, nz, nz + NUT_T, 9474192)
    }
}

// A handheld, as taken for the set (see designs.l8), its middle at (x, y),
// its back on z: its sides; inside, under its front, its screen, its
// buttons' caps and its bolts' heads (its front, with its holes, is drawn
// over them all after).
stage_handheld(x: f32, y: f32, z: f32) {
    top: f32 = z + st_t;
    under: f32 = top - cs_ply;
    round_wall(x, y, st_w * 0.5, st_h * 0.5, st_r, z, under);
    // (Under the front, a dark inside, the screen's glass, its picture.)
    box3(x - st_w * 0.5 + 2.0, y - st_h * 0.5 + 2.0, under - 0.6, x + st_w * 0.5 - 2.0,
        y + st_h * 0.5 - 2.0, under - 0.3, 3815994);
    box3(x + st_scr_x - SCREEN_W * 0.5, y + st_scr_y - SCREEN_H * 0.5, under - 0.3,
        x + st_scr_x + SCREEN_W * 0.5, y + st_scr_y + SCREEN_H * 0.5, under, C_GLASS);
    box3(x + st_va_x - SCREEN_VA_W * 0.5, y + st_va_y - SCREEN_VA_H * 0.5, under,
        x + st_va_x + SCREEN_VA_W * 0.5, y + st_va_y + SCREEN_VA_H * 0.5, under + 0.05,
        C_SCREEN_ON);
    for c in 0..st_caps post(x + st_cap_x[c], y + st_cap_y[c], st_cap_r[c], under,
        top + cs_ply, C_WOOD_LIGHT);
    for b in 0..st_bolts post(x + st_bolt_x[b], y + st_bolt_y[b], HEAD_D * 0.5, under,
        under + HEAD_T, C_METAL3)
}

// The base's bolts: through the base into the nuts in Cavity 1.
const DK_BOLT_L: f32 = 6.0
