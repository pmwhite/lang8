tag cad;

use_tag std, gl, x11, skate;

// Pours: a layer filled with one net's copper (most often ground on the
// bottom), everywhere that keeps the rules' clearance from other copper and
// from the board's edge. Only what is joined to the net's own copper is
// kept: islands with nothing of the net in them are dropped. A pour on the
// bottom puts a via in each of its net's pads on the top that one fits in,
// to join them to it.
//
// A pour is worked out on the router's grid (see route.l8), after every
// change, as a mask of cells; it joins whatever of its net it touches (see
// check.l8), and is drawn from the mask as a texture.
pour_net: []int = new int[2](-1);

// The mask, per layer (cell * 2 + layer): 1 where the pour is; and which
// piece of it each cell is in (pieces are numbered from 1).
pm: []i8 = new i8[GRID_CELLS * 2](0i8);

pc: []i32 = new i32[GRID_CELLS * 2](0i32);

const POUR_PIECES: int = 4096;

piece_item: []int = new int[POUR_PIECES * 2](-1);

pieces_n: []int = new int[2](0);

// Whether the mask changed since it was last drawn from.
pour_drawn: []bool = new bool[2](false);

pour_queue: []i32 = new i32[GRID_CELLS](0i32);

make_pours() {
    // (The vias of pours that are no longer there go.)
    v: int = vias_n - 1;
    while (v >= 0) {
        if (via_route[v] == VIA_POUR) remove_via(v);
        v = v - 1
    }
    if (pour_net[BOTTOM] >= 0) stitch(pour_net[BOTTOM]);
    for l in 0..2 {
        pieces_n[l] = 0;
        pour_drawn[l] = false;
        if (pour_net[l] >= 0) make_pour(l, pour_net[l])
    }
}

// A via in each pad of net n on the top only, where one fits and keeps
// clear of other copper.
stitch(n: int) {
    load_items();
    t: int = ITEMS - 1;
    h: f32 = rule_via * 0.5;
    for q in 0..pins_n {
        if (pin_net[q] == n && pin_layers[q] == 1 && 2.0 * minf(pin_hw[q], pin_hh[q]) >= rule_via) {
            set_box_item(t, pin_x[q], pin_y[q], h, h, h, 3, n);
            clear: bool = true;
            for i in 0..items_n {
                if (it_net[i] != n && it_x0[i] <= it_x1[t] + rule_clear && it_x0[t] <= it_x1[i] + rule_clear && it_y0[i] <= it_y1[t] + rule_clear && it_y0[t] <= it_y1[i] + rule_clear) {
                    if (item_gap(i, t) < rule_clear) clear = false
                }
            }
            if (clear) {
                k: int = add_via(pin_x[q], pin_y[q], n);
                if (k >= 0) via_route[k] = VIA_POUR
            }
        }
    }
}

make_pour(l: int, n: int) {
    load_items();
    nx: int = gr_nx;
    ex: f32 = brd_w * 0.5 - 0.3;
    ey: f32 = brd_h * 0.5 - 0.3;
    // Everywhere on the board, at first.
    for j in 0..gr_ny {
        cy: f32 = cell_cy(j);
        for i in 0..nx {
            c: int = j * nx + i;
            m: i8 = 1i8;
            if (absf(cell_cx(i)) > ex || absf(cy) > ey) m = 0i8;
            pm[c * 2 + l] = m;
            pc[c * 2 + l] = 0i32
        }
    }
    // Not near other nets' copper on this layer (nor holes).
    infl: f32 = rule_clear + 0.01;
    for it in 0..items_n {
        layers: int = it_layers[it];
        if (layers == 0) layers = 3;
        if ((layers & 1 << l) != 0 && it_net[it] != n) {
            i0: int = cell_i(it_x0[it] - infl);
            i1: int = cell_i(it_x1[it] + infl);
            j0: int = cell_j(it_y0[it] - infl);
            j1: int = cell_j(it_y1[it] + infl);
            for j in j0..j1 + 1 {
                cy: f32 = cell_cy(j);
                // (A track only looks at the cells of each row near it: a long
                // diagonal's box is mostly far from it.)
                a: int = i0;
                b: int = i1;
                if (it_line[it]) {
                    reach: f32 = infl + it_r[it];
                    ay: f32 = it_ay[it];
                    by: f32 = it_by[it];
                    t0: f32 = 0.0;
                    t1: f32 = 1.0;
                    if (absf(by - ay) > 0.0001) {
                        ta: f32 = (cy - reach - ay) / (by - ay);
                        tb: f32 = (cy + reach - ay) / (by - ay);
                        t0 = clampf(minf(ta, tb), 0.0, 1.0);
                        t1 = clampf(maxf(ta, tb), 0.0, 1.0)
                    }
                    xa: f32 = it_ax[it] + (it_bx[it] - it_ax[it]) * t0;
                    xb: f32 = it_ax[it] + (it_bx[it] - it_ax[it]) * t1;
                    a = maxi(a, cell_i(minf(xa, xb) - reach));
                    b = mini(b, cell_i(maxf(xa, xb) + reach))
                }
                for i in a..b + 1 {
                    if (item_point_dist(it, cell_cx(i), cy) < infl) pm[(j * nx + i) * 2 + l] = 0i8
                }
            }
        }
    }
    // The pieces that hold some of the net's copper, from each such cell
    // outward; the rest dropped.
    for it in 0..items_n {
        if ((it_layers[it] & 1 << l) != 0 && it_net[it] == n) {
            c: int = cell_j((it_y0[it] + it_y1[it]) * 0.5) * nx + cell_i((it_x0[it] + it_x1[it]) * 0.5);
            k: int = c * 2 + l;
            if (pm[k] == 1i8 && pc[k] == 0i32 && pieces_n[l] < POUR_PIECES - 1) {
                pieces_n[l] = pieces_n[l] + 1;
                piece_item[l * POUR_PIECES + pieces_n[l]] = -1;
                flood(l, c, pieces_n[l])
            }
        }
    }
    for c in 0..nx * gr_ny {
        if (pc[c * 2 + l] == 0i32) pm[c * 2 + l] = 0i8
    }
}

flood(l: int, start: int, label: int) {
    nx: int = gr_nx;
    head: int = 0;
    tail: int = 0;
    pc[start * 2 + l] = label trunc i32;
    pour_queue[tail] = start trunc i32;
    tail = tail + 1;
    while (head < tail) {
        c: int = pour_queue[head] as int;
        head = head + 1;
        i: int = c % nx;
        j: int = c / nx;
        for d in 0..4 {
            ni: int = i;
            nj: int = j;
            if (d == 0) ni = i + 1;
            if (d == 1) ni = i - 1;
            if (d == 2) nj = j + 1;
            if (d == 3) nj = j - 1;
            if (ni >= 0 && ni < nx && nj >= 0 && nj < gr_ny) {
                k: int = (nj * nx + ni) * 2 + l;
                if (pm[k] == 1i8 && pc[k] == 0i32 && tail < GRID_CELLS) {
                    pc[k] = label trunc i32;
                    pour_queue[tail] = (nj * nx + ni) trunc i32;
                    tail = tail + 1
                }
            }
        }
    }
}

// Joining (see check_board): each item of a pour's net on its layer to the
// piece of pour under it, and so to everything else on that piece.
join_pours() {
    for l in 0..2 {
        n: int = pour_net[l];
        for k in 0..pieces_n[l] + 1 piece_item[l * POUR_PIECES + k] = -1;
        if (n >= 0) {
            for it in 0..items_n {
                if ((it_layers[it] & 1 << l) != 0 && it_net[it] == n) {
                    c: int = cell_j((it_y0[it] + it_y1[it]) * 0.5) * gr_nx + cell_i((it_x0[it] + it_x1[it]) * 0.5);
                    label: int = pc[c * 2 + l] as int;
                    if (label > 0) {
                        k: int = l * POUR_PIECES + label;
                        if (piece_item[k] < 0) piece_item[k] = it else uf_join(piece_item[k],
                            it)
                    }
                }
            }
        }
    }
}

// Pouring net n on layer l, or (if it is already) not.
toggle_pour(n: int, l: int) {
    if (pour_net[l] == n) pour_net[l] = -1 else pour_net[l] = n;
    make_pours()
}
