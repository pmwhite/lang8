tag cad;

use_tag std, gl, x11, skate;

// Editing. Two modes, and only two: Arrange, where a finger on a part
// moves it, and Route, where the copper is made. Anywhere else a finger
// moves the view, in either. A double tap zooms in.
//
// Routing is said, not drawn (see route.l8): a tap on a line of the
// ratsnest routes that connection; a finger on a ratsnest line, or on a
// picked route, pulls a waypoint out of it that the route then goes
// through, found again as the finger moves. A picked route can go on the
// other layer, be locked (the router then never moves it to make room), or
// be taken up. Route all does every connection, shortest first, a few each
// frame; and a stroke drawn from one part to another (the guide) routes the
// connections between them side by side along it.
const MODE_ARRANGE: int = 0;

const MODE_ROUTE: int = 1;

const MODE_CASE: int = 2;

mode: int = 0;

// Whether the board changed and wants writing to its file, and checking.
wants_save: bool = false;

// ---- undo ----
// Each change keeps the board's text from before it (see board.l8); undo
// reads it back. und_pos is the entry standing for the board as it is, or
// und_n when it is not kept yet.
const UNDOS: int = 200;

const UNDO_BYTES: int = 8388608;

und_buf: []i8 = new i8[UNDO_BYTES](0i8);

und_start: []int = new int[UNDOS](0);

und_len: []int = new int[UNDOS](0);

und_n: int = 0;

und_pos: int = 0;

// The board as it is, onto the end of the history (dropping the oldest to
// make room).
und_keep() {
    write_board();
    while (und_n > 0 && (und_n >= UNDOS || und_start[und_n - 1] + und_len[und_n - 1] + doc_n > UNDO_BYTES)) {
        // (The oldest goes, and the rest move down.)
        cut: int = und_start[1];
        if (und_n == 1) cut = und_start[0] + und_len[0];
        end: int = und_start[und_n - 1] + und_len[und_n - 1];
        memcpy(und_buf, 0, und_buf, cut, end - cut);
        for i in 0..und_n - 1 {
            und_start[i] = und_start[i + 1] - cut;
            und_len[i] = und_len[i + 1]
        }
        und_n = und_n - 1;
        if (und_pos > 0) und_pos = und_pos - 1
    }
    if (doc_n > UNDO_BYTES) return;
    at: int = 0;
    if (und_n > 0) at = und_start[und_n - 1] + und_len[und_n - 1];
    memcpy(und_buf, at, doc, 0, doc_n);
    und_start[und_n] = at;
    und_len[und_n] = doc_n;
    und_n = und_n + 1
}

// Before a change: what the board is now, for undoing it.
before_change() {
    und_n = und_pos;
    und_keep();
    und_pos = und_n
}

// After one: checked again, and saved.
changed() {
    // (Pours are made again round the copper as it now is: they keep their
    // clearance from what was laid since. Their vias are made again too, so
    // a via picked by number is let go.)
    if (pour_net[TOP] >= 0 || pour_net[BOTTOM] >= 0) {
        make_pours();
        sel_via = -1
    }
    check_board();
    wants_save = true
}

und_load(k: int) {
    memcpy(doc, 0, und_buf, und_start[k], und_len[k]);
    doc_n = und_len[k];
    read_board(doc, doc_n);
    forget_picks();
    changed()
}

can_undo(): bool {
    und_pos > 0
}

can_redo(): bool {
    und_pos < und_n - 1
}

undo() {
    if (!can_undo()) return;
    if (und_pos == und_n) {
        und_keep();
        und_pos = und_n - 1
    }
    und_pos = und_pos - 1;
    und_load(und_pos);
    toast_str("Undone")
}

redo() {
    if (!can_redo()) return;
    und_pos = und_pos + 1;
    und_load(und_pos);
    toast_str("Redone")
}

// ---- what is picked out ----
forget_picks() {
    sel_part = -1;
    sel_seg = -1;
    sel_via = -1;
    sel_pin = -1;
    sel_route = -1;
    sel_point = -1;
    hl_net = -1;
    pt_drag = false;
    drag_part = -1
}

pick_part(p: int) {
    forget_picks();
    sel_part = p
}

// ---- finding what is where (in board millimetres) ----
pin_at(bx: f32, by: f32, tol: f32): int {
    best: int = -1;
    best_d: f32 = tol;
    for q in 0..pins_n {
        if (pin_layers[q] != 0) {
            r: f32 = pin_r[q];
            d: f32 = box_point(pin_x[q], pin_y[q], pin_hw[q] - r, pin_hh[q] - r, bx,
                by) - r;
            // (Inside two: the nearer middle.)
            if (d <= 0.0) d = -1.0 / (1.0 + absf(bx - pin_x[q]) + absf(by - pin_y[q]));
            if (d < best_d) {
                best_d = d;
                best = q
            }
        }
    }
    best
}

part_at(bx: f32, by: f32): int {
    best: int = -1;
    best_a: f32 = 1.0e30;
    for p in 0..parts_n {
        x0: f32 = court_x0(p);
        x1: f32 = court_x1(p);
        y0: f32 = court_y0(p);
        y1: f32 = court_y1(p);
        if (bx >= x0 && bx <= x1 && by >= y0 && by <= y1) {
            a: f32 = (x1 - x0) * (y1 - y0);
            if (a < best_a) {
                best_a = a;
                best = p
            }
        }
    }
    best
}

seg_at(
    bx: f32,
    by: f32,
    tol: f32,
    layer: int
): int {
    best: int = -1;
    best_d: f32 = tol;
    for s in 0..segs_n {
        if (layer < 0 || sg_layer[s] == layer) {
            d: f32 = seg_point(sg_x0[s], sg_y0[s], sg_x1[s], sg_y1[s], bx, by) - sg_w[s] * 0.5;
            if (d < best_d) {
                best_d = d;
                best = s
            }
        }
    }
    best
}

via_at(bx: f32, by: f32, tol: f32): int {
    best: int = -1;
    best_d: f32 = tol;
    for v in 0..vias_n {
        dx: f32 = bx - via_x[v];
        dy: f32 = by - via_y[v];
        d: f32 = sqrtf(dx * dx + dy * dy) - via_d[v] * 0.5;
        if (d < best_d) {
            best_d = d;
            best = v
        }
    }
    best
}

// The nearest point on track s to (bx, by).
near_x: f32 = 0.0;

near_y: f32 = 0.0;

near_on_seg(s: int, bx: f32, by: f32) {
    dx: f32 = sg_x1[s] - sg_x0[s];
    dy: f32 = sg_y1[s] - sg_y0[s];
    l2: f32 = dx * dx + dy * dy;
    t: f32 = 0.0;
    if (l2 > 0.0) t = clampf(((bx - sg_x0[s]) * dx + (by - sg_y0[s]) * dy) / l2, 0.0,
        1.0);
    near_x = sg_x0[s] + dx * t;
    near_y = sg_y0[s] + dy * t
}

// Pixels as millimetres at this zoom.
px_mm(px: f32): f32 {
    px / cam_s
}

// ---- moving parts ----
drag_part: int = -1;

drag_dx: f32 = 0.0;

drag_dy: f32 = 0.0;

drag_kept: bool = false;

// Where the dragged part is drawn: easing after where it is, so that its
// steps from grid point to grid point are smooth.
drag_show_x: f32 = 0.0;

drag_show_y: f32 = 0.0;

// A part just put down or added: it settles (a little drop).
settle_part: int = -1;

settle_t: f32 = 1.0;

// ---- routing ----
// The picked route, and the picked waypoint of it (or -1).
sel_route: int = -1;

sel_point: int = -1;

// A finger moving a waypoint: of which route, which point, and whether the
// board was kept for undo yet.
pt_drag: bool = false;

pt_route: int = -1;

pt_k: int = -1;

pt_kept: bool = false;

// A flash where a route was made.
flash_x: f32 = 0.0;

flash_y: f32 = 0.0;

flash_t: f32 = 10.0;

// The connection of the ratsnest at window point (x, y), not too near its
// ends (where its pads are): its number in wires, or -1.
wire_at(x: f32, y: f32): int {
    tol: f32 = 10.0;
    if (touch_ui) tol = 16.0;
    best: int = -1;
    best_d: f32 = tol;
    for w in 0..wire_n {
        ax: f32 = to_sx(pin_x[wire_a[w]]);
        ay: f32 = to_sy(pin_y[wire_a[w]]);
        bx: f32 = to_sx(pin_x[wire_b[w]]);
        by: f32 = to_sy(pin_y[wire_b[w]]);
        da: f32 = sqrtf((x - ax) * (x - ax) + (y - ay) * (y - ay));
        db: f32 = sqrtf((x - bx) * (x - bx) + (y - by) * (y - by));
        if (da > tol && db > tol) {
            d: f32 = seg_point(ax, ay, bx, by, x, y);
            if (d < best_d) {
                best_d = d;
                best = w
            }
        }
    }
    best
}

// The route whose copper (or, for a leg with no way, whose straight line
// between its points) is at board point (bx, by): or -1.
route_at(bx: f32, by: f32, tol: f32): int {
    s: int = seg_at(bx, by, tol, -1);
    if (s >= 0 && sg_route[s] >= 0) return sg_route[s];
    for r in 0..routes_n {
        for k in 0..ro_np[r] - 1 {
            if (!rl_ok[r * RPTS + k] || ro_stale[r]) {
                if (seg_point(point_x(r, k), point_y(r, k), point_x(r, k + 1), point_y(r,
                    k + 1), bx, by) < tol) return r
            }
        }
    }
    -1
}

// Route r's leg nearest (bx, by).
leg_near(r: int, bx: f32, by: f32): int {
    best: int = 0;
    best_d: f32 = 1.0e30;
    for s in 0..segs_n {
        if (sg_route[s] == r) {
            d: f32 = seg_point(sg_x0[s], sg_y0[s], sg_x1[s], sg_y1[s], bx, by);
            if (d < best_d) {
                best_d = d;
                best = sg_leg[s]
            }
        }
    }
    for k in 0..ro_np[r] - 1 {
        if (!rl_ok[r * RPTS + k]) {
            d2: f32 = seg_point(point_x(r, k), point_y(r, k), point_x(r, k + 1), point_y(r,
                k + 1), bx, by);
            if (d2 < best_d) {
                best_d = d2;
                best = k
            }
        }
    }
    best
}

// The picked route's waypoint at window point (x, y), or -1.
handle_at(x: f32, y: f32): int {
    r: int = sel_route;
    if (r < 0) return -1;
    reach: f32 = 16.0;
    if (touch_ui) reach = 26.0;
    best: int = -1;
    best_d: f32 = reach * reach;
    for k in 1..ro_np[r] - 1 {
        dx: f32 = to_sx(point_x(r, k)) - x;
        dy: f32 = to_sy(point_y(r, k)) - y;
        if (dx * dx + dy * dy < best_d) {
            best_d = dx * dx + dy * dy;
            best = k
        }
    }
    best
}

// A waypoint goes where the finger is, on the middle of a cell of the
// router's grid (so its copper goes through it exactly).
snap_x(x: f32): f32 {
    cell_cx(cell_i(x))
}

snap_y(y: f32): f32 {
    cell_cy(cell_j(y))
}

pick_route(r: int) {
    forget_picks();
    sel_route = r;
    if (r >= 0) hl_net = ro_net[r]
}

// What the routing did, said: whether r got through, and what it pushed
// aside that found no way again.
say_routed(r: int) {
    line_clear();
    if (ro_net[r] >= 0) line_name(net_name[ro_net[r]]) else line_add("Route");
    if (ro_ok[r]) {
        line_add(" routed");
        if (fails > 0) {
            line_add(", but ");
            line_int(fails);
            if (fails == 1) line_add(" route it moved found no way") else line_add(" routes it moved found no way")
        }
    } else line_add(": no way through. Drag it to show the way, or try the other layer");
    toast_line()
}

// The connection w of the ratsnest, routed.
route_wire(w: int) {
    a: int = wire_a[w];
    b: int = wire_b[w];
    before_change();
    r: int = connect_pins(a, b, layer_on);
    if (r < 0) {
        toast_str("No room for more routes");
        return
    }
    changed();
    pick_route(r);
    flash_x = (pin_x[a] + pin_x[b]) * 0.5;
    flash_y = (pin_y[a] + pin_y[b]) * 0.5;
    flash_t = 0.0;
    say_routed(r)
}

// The routes to part p: taken up while it moves (drawn as lines through
// their points), and routed again when it is put down.
lift_routes(p: int) {
    for r in 0..routes_n {
        if (route_on_part(r, p)) {
            clear_route_copper(r);
            ro_stale[r] = true
        }
    }
}

settle_routes() {
    for r in 0..routes_n {
        if (ro_stale[r]) route_assisted(r)
    }
}

// ---- route all ----
// The connections still to make, shortest first, routed a few each frame:
// the list (pins), how far along, and how many got through.
job_on: bool = false;

job_a: []int = new int[WIRES](0);

job_b: []int = new int[WIRES](0);

job_n: int = 0;

job_at: int = 0;

job_ok: int = 0;

job_checked: int = 0;

start_route_all() {
    if (job_on) return;
    before_change();
    // (Its own failures from before are tried again, not kept beside new
    // tries: free routes with no way are taken up first.)
    r: int = routes_n - 1;
    while (r >= 0) {
        if (!ro_ok[r] && !ro_locked[r]) delete_route(r);
        r = r - 1
    }
    // (A two-layer board's ground is best a pour on the bottom: with none
    // yet, a net called GND is poured there first.)
    poured_first: bool = false;
    if (pour_net[TOP] < 0 && pour_net[BOTTOM] < 0) {
        gnd: int = find_net(bytes("GND"), 0, 3);
        if (gnd >= 0) {
            // (And on the top, where there is room after: it joins what
            // the bottom's tracks cut its pour into.)
            pour_net[TOP] = gnd;
            toggle_pour(gnd, BOTTOM);
            poured_first = true
        }
    }
    avoid_n = 0;
    check_board();
    if (poured_first) toast_str("Ground poured on both sides first");
    // (The board as it is, to start again from: see end_job.)
    write_board();
    rs_start_n = doc_n;
    memcpy(rs_start, 0, doc, 0, doc_n);
    rs_try = 0;
    rs_best_left = 1000000;
    hard_n = 0;
    job_stopped = false;
    route_begin(true)
}

// Route all's routing itself, from the board as it is.
route_begin(say: bool) {
    // (Before the buses: the links that must go under a part's lines, so
    // that their vias are where they fit; see under_link.)
    route_under_links();
    route_buses();
    check_board();
    if (!queue_wires(say)) return;
    forget_picks();
    job_pass = 0;
    job_wires = wire_n;
    job_on = true;
    job_ok = 0
}

// Starting again: Route all, if it ends with connections left, starts
// again from the board as it was before it (twice at most), routing those
// first; and in the end keeps the best of its tries. The board to start
// from, the best so far, the tries, and the connections found hard.
rs_start: []i8 = new i8[1048576](0i8);

rs_start_n: int = 0;

rs_best: []i8 = new i8[1048576](0i8);

rs_best_n: int = 0;

rs_best_left: int = 1000000;

rs_try: int = 0;

restart_tries: int = 2;

const HARD: int = 64;

hard_a: []int = new int[HARD](0);

hard_b: []int = new int[HARD](0);

hard_n: int = 0;

// (Stopped by a person: no starting again.)
job_stopped: bool = false;

is_hard(a: int, b: int): bool {
    for k in 0..hard_n {
        if (hard_a[k] == a && hard_b[k] == b || hard_a[k] == b && hard_b[k] == a) return true
    }
    false
}

add_hard(a: int, b: int) {
    if (hard_n < HARD && !is_hard(a, b)) {
        hard_a[hard_n] = a;
        hard_b[hard_n] = b;
        hard_n = hard_n + 1
    }
}

// The connections still to make, into the job, in the order a person
// would route them: signals first, shortest first; then power (wide, and
// able to go round); then a poured net's drops into its pour. Whether
// there are any.
queue_wires(say: bool): bool {
    job_n = 0;
    for w in 0..wire_n {
        job_a[job_n] = wire_a[w];
        job_b[job_n] = wire_b[w];
        job_n = job_n + 1
    }
    if (job_n == 0) {
        if (say) toast_str("Nothing left to route");
        return false
    }
    // (An insertion sort: the list is short.)
    for i in 1..job_n {
        a: int = job_a[i];
        b: int = job_b[i];
        d: f32 = job_key(a, b);
        k: int = i - 1;
        while (k >= 0 && job_key(job_a[k], job_b[k]) > d) {
            job_a[k + 1] = job_a[k];
            job_b[k + 1] = job_b[k];
            k = k - 1
        }
        job_a[k + 1] = a;
        job_b[k + 1] = b
    }
    job_at = 0;
    job_checked = 0;
    true
}

// Buses: three or more signals between the same two parts (a display's
// lines, a flash's), routed first, side by side. Those that meet the far
// part on one side of it go together, along a straight guide from the
// middle of one end's pins to the middle of the other's; those on the
// side away from the near part first, and then with a guide that goes
// round it (a flash's far row).
route_buses() {
    for pa in 0..parts_n {
        for pb in 0..parts_n {
            all: int = 0;
            if (pa != pb && fp_npads[part_fp[pa]] > fp_npads[part_fp[pb]]) all = bus_wires(pa,
                pb, -1);
            if (all >= 3) {
                // (Each pair once: from the part with more pins.)
                mx: f32 = bw_ax / all as f32;
                my: f32 = bw_ay / all as f32;
                for pass in 0..2 {
                    for sd in 0..4 {
                        // (In runs of pins side by side on the far part:
                        // a pin of another net between two of them is a
                        // way the bus would block.)
                        bus_runs(pa, pb, sd);
                        for run in 0..runs_n {
                            bus_lo = run_lo[run];
                            bus_hi = run_hi[run];
                            m: int = bus_wires(pa, pb, sd);
                            if (m >= 2) {
                                nx: f32 = side_x(sd);
                                ny: f32 = side_y(sd);
                                ax: f32 = bw_ax / m as f32;
                                ay: f32 = bw_ay / m as f32;
                                bx: f32 = bw_bx / m as f32;
                                by: f32 = bw_by / m as f32;
                                facing: bool = nx * (ax - bx) + ny * (ay - by) >= 0.0;
                                if (facing == (pass == 0)) {
                                    gd_n = 0;
                                    guide_add(ax, ay);
                                    if (!facing) {
                                        // (Round the part: by the side these
                                        // leave the near part on, of the bus's
                                        // ends there, so as not to cross the
                                        // rest; clear of it by the lanes' room.)
                                        cx: f32 = (court_x0(pb) + court_x1(pb)) * 0.5;
                                        cy: f32 = (court_y0(pb) + court_y1(pb)) * 0.5;
                                        hx: f32 = (court_x1(pb) - court_x0(pb)) * 0.5;
                                        hy: f32 = (court_y1(pb) - court_y0(pb)) * 0.5;
                                        tx: f32 = -ny;
                                        ty: f32 = nx;
                                        away: f32 = tx * (ax - mx) + ty * (ay - my);
                                        if (absf(away) < 0.05) away = tx * (ax - cx) + ty * (ay - cy);
                                        if (away < 0.0) {
                                            tx = -tx;
                                            ty = -ty
                                        }
                                        mg: f32 = 0.5 + (m - 1) as f32 * 0.3;
                                        ht: f32 = absf(tx) * hx + absf(ty) * hy + mg;
                                        hn: f32 = absf(nx) * hx + absf(ny) * hy + mg;
                                        guide_add(cx + tx * ht - nx * hn, cy + ty * ht - ny * hn);
                                        guide_add(cx + tx * ht + nx * hn, cy + ty * ht + ny * hn)
                                    }
                                    guide_add(bx, by);
                                    bus_side = sd;
                                    gd_auto = true;
                                    route_bus(pa, pb, false);
                                    gd_auto = false;
                                    bus_side = -1;
                                    check_board()
                                }
                            }
                        }
                        bus_lo = -1000000.0;
                        bus_hi = 1000000.0
                    }
                }
            }
        }
    }
}

// The way the side sd of a part faces: 0 right, 1 up, 2 left, 3 down.
side_x(sd: int): f32 {
    if (sd == 0) return 1.0;
    if (sd == 2) return -1.0;
    0.0
}

side_y(sd: int): f32 {
    if (sd == 1) return 1.0;
    if (sd == 3) return -1.0;
    0.0
}

// Which side of its part pin q is on: along its pad's long way, or (a
// square pad) the way it is farther from the part's middle.
pin_side(q: int): int {
    p: int = pin_part[q];
    dx: f32 = pin_x[q] - part_x[p];
    dy: f32 = pin_y[q] - part_y[p];
    across: bool = pin_hw[q] > pin_hh[q] + 0.01 || pin_hw[q] > pin_hh[q] - 0.01 && absf(dx) > absf(dy);
    if (across) {
        if (dx >= 0.0) return 0;
        return 2
    }
    if (dy >= 0.0) return 1;
    3
}

// Bus side: when not -1, the bus is only the connections that meet the
// far part on that side of it (and there, between bus_lo and bus_hi along
// it: see bus_runs).
bus_side: int = -1;

bus_lo: f32 = -1000000.0;

bus_hi: f32 = 1000000.0;

// How far along side sd of its part pin q is (anticlockwise).
side_along(q: int, sd: int): f32 {
    -pin_x[q] * side_y(sd) + pin_y[q] * side_x(sd)
}

// The runs of the signals between parts pa and pb that meet pb on side sd:
// those side by side there, with no pin of another net between.
const RUNS: int = 16;

run_lo: []f32 = new f32[RUNS](0.0);

run_hi: []f32 = new f32[RUNS](0.0);

runs_n: int = 0;

run_at: []f32 = new f32[64](0.0);

bus_runs(pa: int, pb: int, sd: int) {
    runs_n = 0;
    bus_lo = -1000000.0;
    bus_hi = 1000000.0;
    n: int = 0;
    for w in 0..wire_n {
        a: int = wire_a[w];
        b: int = wire_b[w];
        if (pin_part[a] == pb && pin_part[b] == pa) b = wire_a[w];
        if (pin_part[b] == pb && bus_wire(w, pa, pb, sd) && n < len(run_at)) {
            // (In order along the side.)
            v: f32 = side_along(b, sd);
            k: int = n;
            while (k > 0 && run_at[k - 1] > v) {
                run_at[k] = run_at[k - 1];
                k = k - 1
            }
            run_at[k] = v;
            n = n + 1
        }
    }
    if (n == 0) return;
    lo: f32 = run_at[0];
    for i in 1..n + 1 {
        split: bool = i == n;
        if (!split) {
            first: int = part_pin0[pb];
            for q in first..first + fp_npads[part_fp[pb]] {
                v: f32 = side_along(q, sd);
                if (pin_net[q] >= 0 && pin_side(q) == sd && v > run_at[i - 1] + 0.01 && v < run_at[i] - 0.01 && !bus_pin(q,
                    pa, pb, sd)) split = true
            }
        }
        if (split && runs_n < RUNS) {
            run_lo[runs_n] = lo - 0.01;
            run_hi[runs_n] = run_at[i - 1] + 0.01;
            runs_n = runs_n + 1;
            if (i < n) lo = run_at[i]
        }
    }
}

// Whether wire w is a signal between pa and pb that meets pb on side sd.
bus_wire(
    w: int,
    pa: int,
    pb: int,
    sd: int
): bool {
    a: int = wire_a[w];
    b: int = wire_b[w];
    if (pin_part[a] == pb && pin_part[b] == pa) {
        a = wire_b[w];
        b = wire_a[w]
    }
    pin_part[a] == pa && pin_part[b] == pb && net_track_width(pin_net[a]) <= rule_track + 0.001 && pin_side(b) == sd
}

// Whether pin q is the far end of one of those.
bus_pin(
    q: int,
    pa: int,
    pb: int,
    sd: int
): bool {
    for w in 0..wire_n {
        if ((wire_a[w] == q || wire_b[w] == q) && bus_wire(w, pa, pb, sd)) return true
    }
    false
}

// The signals to join between parts pa and pb (meeting pb on side sd,
// unless -1), and the sums of their ends' places.
bw_ax: f32 = 0.0;

bw_ay: f32 = 0.0;

bw_bx: f32 = 0.0;

bw_by: f32 = 0.0;

bus_wires(pa: int, pb: int, sd: int): int {
    n: int = 0;
    bw_ax = 0.0;
    bw_ay = 0.0;
    bw_bx = 0.0;
    bw_by = 0.0;
    for w in 0..wire_n {
        a: int = wire_a[w];
        b: int = wire_b[w];
        if (pin_part[a] == pb && pin_part[b] == pa) {
            a = wire_b[w];
            b = wire_a[w]
        }
        if (pin_part[a] == pa && pin_part[b] == pb && net_track_width(pin_net[a]) <= rule_track + 0.001 && (sd < 0 || pin_side(b) == sd && side_along(b,
            sd) >= bus_lo && side_along(b, sd) <= bus_hi)) {
            n = n + 1;
            bw_ax = bw_ax + pin_x[a];
            bw_ay = bw_ay + pin_y[a];
            bw_bx = bw_bx + pin_x[b];
            bw_by = bw_by + pin_y[b]
        }
    }
    n
}

guide_add(x: f32, y: f32) {
    gd_x[gd_n] = x;
    gd_y[gd_n] = y;
    gd_n = gd_n + 1
}

job_key(a: int, b: int): f32 {
    n: int = pin_net[a];
    // (Those a try before found no way for: first of all.)
    if (is_hard(a, b)) return -300000.0 + wire_len(a, b);
    // (First, the links that must go under a part's other lines; then the
    // lines out of a many-pinned part's crowded sides: see fan_key.)
    if (under_link(a, b)) return -200000.0 + wire_len(a, b);
    // (A connector's crowded row first of all: its pins can be left only
    // the one way, so its lines claim the room by them before a chip's
    // lines go round its ends.)
    // (Unless its other end is a chip's: then the chip's side's order.)
    if (row_pin(a, b) && !fan_pin(b, a)) return -150000.0 + fan_key(a, b);
    if (row_pin(b, a) && !fan_pin(a, b)) return -150000.0 + fan_key(b, a);
    if (fan_pin(b, a) && !fan_pin(a, b)) return -100000.0 + fan_key(b, a);
    if (fan_pin(a, b)) return -100000.0 + fan_key(a, b);
    class: f32 = 0.0;
    // (Power that only goes a step, a chip's pin to its neighbour or its
    // cap, has little choice of way: it goes in with the signals. A cap's
    // step may be longer, up to a centimetre: where it fits by the chip.)
    step: f32 = 6.0;
    if (fp_npads[part_fp[pin_part[a]]] == 2 || fp_npads[part_fp[pin_part[b]]] == 2) step = 12.0;
    if (n >= 0 && net_track_width(n) > rule_track + 0.001 && (wire_len(a, b) > step || pins_between(a,
        b))) class = 1.0;
    if (n >= 0 && pour_net[BOTTOM] == n) class = 2.0;
    class * 100000.0 + wire_len(a, b)
}

// Whether pin a, going to pin b, is one of a crowded row on a side of a
// many-pinned part (a QFN's), and b is beyond it.
fan_pin(a: int, b: int): bool {
    p: int = pin_part[a];
    n: int = pin_net[a];
    ring_part(p) && pin_part[b] != p && n >= 0 && pour_net[BOTTOM] != n && pour_net[TOP] != n && needs_fanout(a,
        rule_track)
}

// Whether pin a, going to pin b, is one of a connector's crowded row (a
// part of many pins, not all round it), and b is beyond it.
row_pin(a: int, b: int): bool {
    p: int = pin_part[a];
    n: int = pin_net[a];
    fp_npads[part_fp[p]] >= 10 && !ring_part(p) && pin_part[b] != p && n >= 0 && pour_net[BOTTOM] != n && pour_net[TOP] != n && needs_fanout(a,
        rule_track)
}

// Whether part p is a chip with its pins all round it (a QFN's): a
// connector's rows are not.
ring_part(p: int): bool {
    f: int = part_fp[p];
    if (fp_npads[f] < 20) return false;
    sides: int = 0;
    first: int = part_pin0[p];
    for q in first..first + fp_npads[f] {
        if (pin_layers[q] != 0) sides = sides | 1 << pin_side(q)
    }
    sides == 15
}

route_under_links() {
    n: int = wire_n;
    for w in 0..n {
        if (w < wire_n && under_link(wire_a[w], wire_b[w])) {
            r: int = connect_pins(wire_a[w], wire_b[w], BOTTOM);
            if (r >= 0 && !ro_ok[r]) delete_route(r)
        }
    }
    check_board()
}

// Whether pins a and b are crowded pins of one many-pinned part (a chip's,
// or a connector's row), on a
// net it joins outside (power: VREG_VOUT to DVDD), with others' pins
// between them: lines that go off elsewhere between them, as a USB pair
// does, leave them no way on the top. Such a link is made first, on the
// bottom, its vias where they fit before anything is beside them.
under_link(a: int, b: int): bool {
    p: int = pin_part[a];
    pin_part[b] == p && (ring_part(p) || fp_npads[part_fp[p]] >= 10) && pin_net[a] >= 0 && pour_net[BOTTOM] != pin_net[a] && needs_fanout(a,
        rule_track) && needs_fanout(b, rule_track) && pins_between(a, b)
}

// The order of the lines out of a side of a part: they leave it side by
// side and each turns, to the right or the left, toward its other end.
// Each fits round the one before only if the one inside the turn goes
// first: those turning right from the rightmost pin in, those turning
// left from the leftmost.
fan_key(a: int, b: int): f32 {
    p: int = pin_part[a];
    sd: int = pin_side(a);
    nx: f32 = side_x(sd);
    ny: f32 = side_y(sd);
    // (Rightward, facing out of the side.)
    tx: f32 = ny;
    ty: f32 = -nx;
    at: f32 = (pin_x[a] - part_x[p]) * tx + (pin_y[a] - part_y[p]) * ty;
    turn: f32 = (pin_x[b] - pin_x[a]) * tx + (pin_y[b] - pin_y[a]) * ty;
    rank: f32 = 0.0;
    if (turn >= 0.0) rank = 25.0 - at else rank = 75.0 + at;
    (p * 4 + sd) as f32 * 100.0 + rank
}

// Whether a pin of another net lies across the straight way from pin a to
// pin b (a power hop over a signal's pins goes after the signals).
pins_between(a: int, b: int): bool {
    n: int = pin_net[a];
    for q in 0..pins_n {
        if (q != a && q != b && pin_net[q] >= 0 && pin_net[q] != n && pin_layers[q] != 0 && seg_point(pin_x[a],
            pin_y[a], pin_x[b], pin_y[b], pin_x[q], pin_y[q]) < 0.3) return true
    }
    false
}

// ---- repair ----
// A connection with no way, after Route all's passes: the free routes near
// it are taken up, it is routed first, and they after it. If fewer
// connections are left unmade than before, that stands; if not, the board
// goes back to just as it was. So it can only get better.
const REPAIR_ROUTES: int = 64;

rep_a: []int = new int[REPAIR_ROUTES](0);

rep_b: []int = new int[REPAIR_ROUTES](0);

rep_doc: []i8 = new i8[1048576](0i8);

// Repairing: which route is next looked at, and how many tries so far (a
// few at most).
rep_on: bool = false;

rep_at: int = 0;

rep_tries: int = 0;

// One try. Whether there may be more.
repair_step(): bool {
    while (rep_at < routes_n && rep_tries < 6) {
        r: int = rep_at;
        a: int = rp_pin[r * RPTS];
        b: int = rp_pin[r * RPTS + ro_np[r] - 1];
        if (!ro_ok[r] && !ro_locked[r] && !ro_drop[r] && a >= 0 && b >= 0) {
            rep_tries = rep_tries + 1;
            if (repair(r)) rep_at = 0 else rep_at = rep_at + 1;
            return true
        }
        rep_at = rep_at + 1
    }
    false
}

// Route f again, its corner of the board first cleared. Whether that left
// fewer connections unmade (and so stands).
repair(f: int): bool {
    a: int = rp_pin[f * RPTS];
    b: int = rp_pin[f * RPTS + ro_np[f] - 1];
    check_board();
    before: int = wire_n;
    // (The board as it is, to go back to.)
    write_board();
    kept: int = doc_n;
    memcpy(rep_doc, 0, doc, 0, doc_n);
    // Its corner: the box round its ends, and a little more.
    x0: f32 = minf(pin_x[a], pin_x[b]) - 3.0;
    x1: f32 = maxf(pin_x[a], pin_x[b]) + 3.0;
    y0: f32 = minf(pin_y[a], pin_y[b]) - 3.0;
    y1: f32 = maxf(pin_y[a], pin_y[b]) + 3.0;
    // The free routes there (from pin to pin, with no waypoints of a
    // person's): taken up, their ends kept to route again.
    n: int = 0;
    r: int = routes_n - 1;
    while (r >= 0) {
        ra: int = rp_pin[r * RPTS];
        rb: int = rp_pin[r * RPTS + ro_np[r] - 1];
        if (r != f && !ro_locked[r] && !ro_drop[r] && ro_np[r] == 2 && ra >= 0 && rb >= 0 && n < REPAIR_ROUTES && route_in_box(r,
            x0, y0, x1, y1)) {
            rep_a[n] = ra;
            rep_b[n] = rb;
            n = n + 1;
            delete_route(r);
            if (f > r) f = f - 1
        }
        r = r - 1
    }
    delete_route(f);
    _first: int = connect_pins(a, b, layer_on);
    // (The rest, shortest first.)
    left: int = n;
    while (left > 0) {
        best: int = -1;
        for k in 0..n {
            if (rep_a[k] >= 0 && (best < 0 || wire_len(rep_a[k], rep_b[k]) < wire_len(rep_a[best],
                rep_b[best]))) best = k
        }
        _next: int = connect_pins(rep_a[best], rep_b[best], layer_on);
        rep_a[best] = -1;
        left = left - 1
    }
    if (pour_net[TOP] >= 0 || pour_net[BOTTOM] >= 0) make_pours();
    check_board();
    if (wire_n < before) return true;
    // (No better: back as it was.)
    memcpy(doc, 0, rep_doc, 0, kept);
    doc_n = kept;
    read_board(doc, doc_n);
    check_board();
    false
}

// Whether route r has copper in the box.
route_in_box(
    r: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): bool {
    for s in 0..segs_n {
        if (sg_route[s] == r && maxf(sg_x0[s], sg_x1[s]) >= x0 && minf(sg_x0[s], sg_x1[s]) <= x1 && maxf(sg_y0[s],
            sg_y1[s]) >= y0 && minf(sg_y0[s], sg_y1[s]) <= y1) return true
    }
    false
}

wire_len(a: int, b: int): f32 {
    absf(pin_x[a] - pin_x[b]) + absf(pin_y[a] - pin_y[b])
}

// A frame's worth: routes until about budget_ns has gone.
step_job(budget_ns: int) {
    if (!job_on) return;
    if (rep_on) {
        if (!repair_step()) end_job();
        return
    }
    t0: int = mono_ns();
    while (job_at < job_n && mono_ns() - t0 < budget_ns) {
        layer: int = layer_on;
        if (under_link(job_a[job_at], job_b[job_at]) || job_key(job_a[job_at], job_b[job_at]) >= 100000.0 && job_key(job_a[job_at],
            job_b[job_at]) < 200000.0) layer = BOTTOM;
        r: int = connect_pins(job_a[job_at], job_b[job_at], layer);
        // (No way, liking that layer: once more, liking the other.)
        if (r >= 0 && !ro_ok[r] && !ro_drop[r]) {
            delete_route(r);
            r = connect_pins(job_a[job_at], job_b[job_at], 1 - layer)
        }
        if (r >= 0 && ro_ok[r]) job_ok = job_ok + 1;
        job_at = job_at + 1
    }
    // (The ratsnest and the check catch up now and then.)
    if (job_at - job_checked >= 12 || job_at >= job_n) {
        check_board();
        job_checked = job_at
    }
    if (job_at >= job_n) finish_job()
}

// Passes of one Route all: when some connections find no way, the
// ratsnest is made again joining those pins some other way (through a part
// that joins them inside, or round by another pin), and they are tried
// again, twice at most.
job_pass: int = 0;

// How many connections were left before this pass (so that a pass that
// gets nowhere is the last).
job_wires: int = 0;

// How many found no way in the pass before.
job_failed: int = 0;

finish_job() {
    job_on = false;
    failed_pairs: int = 0;
    for r in 0..routes_n {
        if (!ro_ok[r] && !ro_locked[r] && !ro_drop[r] && rp_pin[r * RPTS] >= 0 && rp_pin[r * RPTS + ro_np[r] - 1] >= 0) {
            avoid(rp_pin[r * RPTS], rp_pin[r * RPTS + ro_np[r] - 1]);
            failed_pairs = failed_pairs + 1
        }
    }
    // Another go while it is getting somewhere: with its failures taken
    // up, the pours made again round the copper as it now is (which can
    // leave new pieces to join), and the ratsnest made again. A few at
    // most.
    // (Only while each pass leaves fewer that find no way: one that gets
    // nowhere is the last, its failures kept, in red.)
    if (job_pass < 4 && (failed_pairs == 0 || job_pass == 0 || failed_pairs < job_failed)) {
        job_failed = failed_pairs;
        r2: int = routes_n - 1;
        while (r2 >= 0) {
            if (!ro_ok[r2] && !ro_locked[r2]) delete_route(r2);
            r2 = r2 - 1
        }
        if (pour_net[TOP] >= 0 || pour_net[BOTTOM] >= 0) make_pours();
        check_board();
        if (wire_n > 0 && (wire_n < job_wires || failed_pairs > 0) && queue_wires(false)) {
            job_wires = wire_n;
            job_pass = job_pass + 1;
            job_on = true;
            return
        }
    }
    job_pass = 0;
    changed();
    // Then, for each that still finds no way, a try at doing its corner
    // of the board again (see repair), one a frame: if there are only a
    // few. (Many, and the board wants a person's help, or another layout,
    // more than minutes of trying.)
    rep_at = 0;
    rep_tries = 0;
    if (failed_pairs > 6) {
        end_job();
        return
    }
    rep_on = true;
    job_on = true
}

// The end of Route all.
end_job() {
    job_on = false;
    rep_on = false;
    // (A try that found no way, whose ends were joined some other way after
    // all, is not wanted: taken up.)
    r3: int = routes_n - 1;
    gone: int = 0;
    while (r3 >= 0) {
        a3: int = rp_pin[r3 * RPTS];
        b3: int = rp_pin[r3 * RPTS + ro_np[r3] - 1];
        if (!ro_ok[r3] && !ro_locked[r3] && a3 >= 0 && b3 >= 0 && joined(a3, b3)) {
            delete_route(r3);
            gone = gone + 1
        }
        r3 = r3 - 1
    }
    if (gone > 0) changed();
    // Not all joined: the best so far kept, and (twice at most) again from
    // the start, the connections left first. (If only a few are left: many,
    // and the board wants a person's help, as for repair.)
    check_board();
    if (wire_n < rs_best_left) {
        rs_best_left = wire_n;
        write_board();
        rs_best_n = doc_n;
        memcpy(rs_best, 0, doc, 0, doc_n)
    }
    if (wire_n > 0 && wire_n <= 6 && !job_stopped && rs_try < restart_tries) {
        for w in 0..wire_n add_hard(wire_a[w], wire_b[w]);
        for r in 0..routes_n {
            a4: int = rp_pin[r * RPTS];
            b4: int = rp_pin[r * RPTS + ro_np[r] - 1];
            if (!ro_ok[r] && a4 >= 0 && b4 >= 0) add_hard(a4, b4)
        }
        rs_try = rs_try + 1;
        memcpy(doc, 0, rs_start, 0, rs_start_n);
        doc_n = rs_start_n;
        read_board(doc, doc_n);
        avoid_n = 0;
        check_board();
        route_begin(false);
        if (job_on) return
    }
    if (wire_n > rs_best_left) {
        memcpy(doc, 0, rs_best, 0, rs_best_n);
        doc_n = rs_best_n;
        read_board(doc, doc_n);
        check_board();
        changed()
    }
    // What is left, in the end (a route made early may have been pushed
    // aside by a later one and found no way again).
    left: int = 0;
    for r in 0..routes_n {
        if (!ro_ok[r]) left = left + 1
    }
    job_ok = routes_n - left;
    line_clear();
    if (wire_n == 0) line_add("All routed") else {
        line_int(wire_n);
        if (wire_n == 1) line_add(" connection left") else line_add(" connections left");
        if (left > 0) line_add(": the red ones need a hand")
    }
    toast_line()
}

stop_job() {
    job_stopped = true;
    if (rep_on) end_job() else if (job_on) {
        job_n = job_at;
        finish_job();
        if (rep_on) end_job()
    }
}

// ---- the guide ----
// A stroke drawn from one part to another: the connections between them
// are routed along it, side by side, each through waypoints offset from
// the stroke by its place in the row.
guide_on: bool = false;

const GUIDE_PTS: int = 1024;

gd_x: []f32 = new f32[GUIDE_PTS](0.0);

gd_y: []f32 = new f32[GUIDE_PTS](0.0);

gd_n: int = 0;

gd_drawing: bool = false;

// The stroke made simpler (Douglas and Peucker's way): which of its points
// are kept.
gd_keep: []bool = new bool[GUIDE_PTS](false);

simplify(a: int, b: int, tol: f32) {
    best: int = -1;
    best_d: f32 = tol;
    for k in a + 1..b {
        d: f32 = seg_point(gd_x[a], gd_y[a], gd_x[b], gd_y[b], gd_x[k], gd_y[k]);
        if (d > best_d) {
            best_d = d;
            best = k
        }
    }
    if (best >= 0) {
        gd_keep[best] = true;
        simplify(a, best, tol);
        simplify(best, b, tol)
    }
}

// The part a guide's end is on (or nearest, within reach), or -1.
part_near(bx: f32, by: f32): int {
    p: int = part_at(bx, by);
    if (p >= 0) return p;
    q: int = pin_at(bx, by, px_mm(30.0));
    if (q >= 0) return pin_part[q];
    -1
}

const BUS: int = 64;

bus_a: []int = new int[BUS](0);

bus_b: []int = new int[BUS](0);

bus_key: []f32 = new f32[BUS](0.0);

finish_guide() {
    gd_drawing = false;
    guide_on = false;
    if (gd_n < 2) return;
    pa: int = part_near(gd_x[0], gd_y[0]);
    pb: int = part_near(gd_x[gd_n - 1], gd_y[gd_n - 1]);
    guide_a = pa;
    guide_b = pb;
    if (pa < 0 || pb < 0 || pa == pb) {
        toast_str("Draw from one part to another");
        return
    }
    route_bus(pa, pb, true)
}

// The connections between parts pa and pb routed as a bus, along the
// guide in gd_x, gd_y (see finish_guide); by_hand, as a person asked (kept
// for undo, and said).
route_bus(pa: int, pb: int, by_hand: bool) {
    guide_a = pa;
    guide_b = pb;
    // The connections between the two.
    n: int = 0;
    for w in 0..wire_n {
        a: int = wire_a[w];
        b: int = wire_b[w];
        if (pin_part[a] == pb && pin_part[b] == pa) {
            a = wire_b[w];
            b = wire_a[w]
        }
        if (pin_part[a] == pa && pin_part[b] == pb && n < BUS && (bus_side < 0 || pin_side(b) == bus_side && net_track_width(pin_net[a]) <= rule_track + 0.001 && side_along(b,
            bus_side) >= bus_lo && side_along(b, bus_side) <= bus_hi)) {
            bus_a[n] = a;
            bus_b[n] = b;
            n = n + 1
        }
    }
    if (n == 0) {
        line_clear();
        line_add("Nothing to join between ");
        line_name(part_ref[pa]);
        line_add(" and ");
        line_name(part_ref[pb]);
        if (by_hand) toast_line();
        return
    }
    // The stroke's corners.
    for k in 0..gd_n gd_keep[k] = false;
    gd_keep[0] = true;
    gd_keep[gd_n - 1] = true;
    // (A stroke's own corners; Route all's guide is only corners.)
    if (gd_auto) {
        for k in 0..gd_n gd_keep[k] = true
    } else simplify(0, gd_n - 1, maxf(0.8, px_mm(14.0)));
    square_guide();
    // Each connection's place in the row, from the guide's right to its
    // left: lines that leave a part keep, left to right, the order their
    // pins have round it (anticlockwise, from the way behind the bus).
    dx: f32 = oc_x[1] - oc_x[0];
    dy: f32 = oc_y[1] - oc_y[0];
    l0: f32 = maxf(sqrtf(dx * dx + dy * dy), 0.001);
    ahead: f32 = atan2f(dy, dx);
    for i in 0..n {
        t: f32 = atan2f(pin_y[bus_a[i]] - part_y[pa], pin_x[bus_a[i]] - part_x[pa]) - ahead;
        while (t > 3.14159265) t = t - 6.2831853;
        while (t <= -3.14159265) t = t + 6.2831853;
        bus_key[i] = t
    }
    for i in 1..n {
        ka: f32 = bus_key[i];
        a: int = bus_a[i];
        b: int = bus_b[i];
        j: int = i - 1;
        while (j >= 0 && bus_key[j] > ka) {
            bus_key[j + 1] = bus_key[j];
            bus_a[j + 1] = bus_a[j];
            bus_b[j + 1] = bus_b[j];
            j = j - 1
        }
        bus_key[j + 1] = ka;
        bus_a[j + 1] = a;
        bus_b[j + 1] = b
    }
    // How far apart the lanes are: a track and the clearance, rounded up to
    // the router's grid.
    widest: f32 = 0.0;
    for i in 0..n widest = maxf(widest, net_track_width(pin_net[bus_a[i]]));
    // (A grid step more, so that lanes still clear each other where they
    // run at 45 degrees and their points fall to the grid.)
    pitch: f32 = ceilf32((widest + rule_clear + 0.05) / gr_g) * gr_g + gr_g;
    if (by_hand) before_change();
    // (Members of the bus are kept from pushing each other aside: each is
    // held as if locked once it is through, and let go after.)
    first: int = routes_n;
    gd_span = (n - 1) as f32 * 0.5 * pitch;
    for i in 0..n {
        r: int = new_route(pin_net[bus_a[i]], bus_a[i], bus_b[i], layer_on);
        if (r >= 0) guide_points(r, (i as f32 - (n - 1) as f32 * 0.5) * pitch)
    }
    // Routed in the order a person would: the one farthest along the way
    // the bus sets off first, so that each turns onto its lane past the
    // one before rather than across it.
    ux: f32 = dx / l0;
    uy: f32 = dy / l0;
    // (Those that set off level, the one inside the way the bus turns at
    // its end first, so that the next turns outside it.)
    lx: f32 = oc_x[oc_n - 1] - oc_x[oc_n - 2];
    ly: f32 = oc_y[oc_n - 1] - oc_y[oc_n - 2];
    turn: f32 = signf(ux * ly - uy * lx);
    for i in 0..n bus_key[i] = (pin_x[bus_a[i]] - gd_x[0]) * ux + (pin_y[bus_a[i]] - gd_y[0]) * uy + 0.01 * turn * i as f32;
    left: int = n;
    while (left > 0) {
        left = left - 1;
        best: int = -1;
        for i in 0..n {
            if (bus_key[i] > -1.0e20 && (best < 0 || bus_key[i] > bus_key[best])) best = i
        }
        bus_key[best] = -1.0e30;
        r2: int = first + best;
        if (r2 < routes_n && route_assisted(r2)) ro_locked[r2] = true
    }
    made: int = 0;
    for r in first..routes_n {
        if (ro_ok[r]) made = made + 1;
        ro_locked[r] = false
    }
    if (!by_hand) return;
    changed();
    line_clear();
    line_int(made);
    line_add(" of ");
    line_int(n);
    line_add(" routed along the guide");
    toast_line()
}

ceilf32(v: f32): f32 {
    f: f32 = floorf(v);
    if (f < v) return f + 1.0;
    f
}

// Route r's waypoints: the stroke's corners between its ends, each moved
// off to the side (its left) by off, along the corner's mitre; or with no
// corners, its middle.
guide_points(r: int, off: f32) {
    at: int = 1;
    for k in 1..oc_n - 1 {
        if (ro_np[r] < RPTS - 1) {
            // The ways in and out, and the mitre between.
            ix: f32 = oc_x[k] - oc_x[k - 1];
            iy: f32 = oc_y[k] - oc_y[k - 1];
            il: f32 = maxf(sqrtf(ix * ix + iy * iy), 0.001);
            ox: f32 = oc_x[k + 1] - oc_x[k];
            oy: f32 = oc_y[k + 1] - oc_y[k];
            ol: f32 = maxf(sqrtf(ox * ox + oy * oy), 0.001);
            mx: f32 = -iy / il - oy / ol;
            my: f32 = ix / il + ox / ol;
            ml: f32 = maxf(sqrtf(mx * mx + my * my), 0.001);
            mx = mx / ml;
            my = my / ml;
            // (The mitre is longer than the side by 1 / cos of half the turn.)
            c: f32 = maxf(mx * -iy / il + my * ix / il, 0.4);
            wx: f32 = snap_x(oc_x[k] + mx * off / c);
            wy: f32 = snap_y(oc_y[k] + my * off / c);
            // (Not among the pads of the parts it joins: the route finds its
            // own way out of those.)
            // (And all the bus's lanes at a corner, or none.)
            if (!(gd_auto && k < oc_first) && lanes_clear(oc_x[k], oc_y[k], mx / c,
                my / c) && insert_point(r, at, wx, wy)) at = at + 1
        }
    }
    if (at == 1) {
        // (No corner away from the parts, or none at all: a waypoint in
        // the middle of the longest run, if that is away from them.)
        k0: int = 0;
        best: f32 = -1.0;
        for k in 0..oc_n - 1 {
            ex: f32 = oc_x[k + 1] - oc_x[k];
            ey: f32 = oc_y[k + 1] - oc_y[k];
            if (ex * ex + ey * ey > best) {
                best = ex * ex + ey * ey;
                k0 = k
            }
        }
        dx: f32 = oc_x[k0 + 1] - oc_x[k0];
        dy: f32 = oc_y[k0 + 1] - oc_y[k0];
        l: f32 = maxf(sqrtf(dx * dx + dy * dy), 0.001);
        mx: f32 = (oc_x[k0] + oc_x[k0 + 1]) * 0.5;
        my: f32 = (oc_y[k0] + oc_y[k0 + 1]) * 0.5;
        if (lanes_clear(mx, my, -dy / l, dx / l)) insert_point(r, 1, snap_x(mx - dy / l * off),
            snap_y(my + dx / l * off))
    }
}

// The parts the guide joins, and whether a point is within a millimetre of
// one's courtyard (or, Route all's own guide being placed clear of them,
// near it at all).
guide_a: int = -1;

guide_b: int = -1;

near_part(p: int, x: f32, y: f32): bool {
    m: f32 = 1.0;
    if (gd_auto) m = 0.3;
    p >= 0 && x > court_x0(p) - m && x < court_x1(p) + m && y > court_y0(p) - m && y < court_y1(p) + m
}

// How far the outermost lanes are to either side of the guide.
gd_span: f32 = 0.0;

// Whether the outermost lanes at the point (x, y) of the guide, (ux, uy)
// to its left a millimetre, are clear of the parts the guide joins.
lanes_clear(
    x: f32,
    y: f32,
    ux: f32,
    uy: f32
): bool {
    ax: f32 = x + ux * gd_span;
    ay: f32 = y + uy * gd_span;
    bx: f32 = x - ux * gd_span;
    by: f32 = y - uy * gd_span;
    !near_part(guide_a, ax, ay) && !near_part(guide_b, ax, ay) && !near_part(guide_a,
        bx, by) && !near_part(guide_b, bx, by)
}

// The guide squared to the ways tracks run (across, along, and at 45
// degrees): each run between its corners as a straight stretch and then a
// diagonal one, with corners on the grid and none where it goes on
// straight. So the lanes beside it are exactly parallel, and each leg of
// a route along it has one way that is shortest.
oc_x: []f32 = new f32[GUIDE_PTS * 2](0.0);

oc_y: []f32 = new f32[GUIDE_PTS * 2](0.0);

oc_n: int = 0;

// (Where the guide's first run ends, in oc: a guide of Route all's own
// is its corners, and the bend squaring puts in that run is not one.)
oc_first: int = 0;

gd_auto: bool = false;

square_guide() {
    oc_n = 0;
    oc_first = 0;
    oc_add(snap_x(gd_x[0]), snap_y(gd_y[0]));
    for k in 1..gd_n {
        if (gd_keep[k]) {
            px: f32 = oc_x[oc_n - 1];
            py: f32 = oc_y[oc_n - 1];
            tx: f32 = snap_x(gd_x[k]);
            ty: f32 = snap_y(gd_y[k]);
            dx: f32 = tx - px;
            dy: f32 = ty - py;
            sx: f32 = signf(dx);
            sy: f32 = signf(dy);
            if (absf(dx) > absf(dy)) oc_add(px + sx * (absf(dx) - absf(dy)), py) else oc_add(px,
                py + sy * (absf(dy) - absf(dx)));
            if (k == 1) oc_first = oc_n;
            oc_add(tx, ty)
        }
    }
}

// A corner of the squared guide: none where it would be where the last
// is, and the last dropped where the guide goes on straight through it.
oc_add(x: f32, y: f32) {
    if (oc_n > 0 && absf(x - oc_x[oc_n - 1]) + absf(y - oc_y[oc_n - 1]) < 0.001) return;
    if (oc_n >= 2) {
        ax: f32 = oc_x[oc_n - 1] - oc_x[oc_n - 2];
        ay: f32 = oc_y[oc_n - 1] - oc_y[oc_n - 2];
        bx: f32 = x - oc_x[oc_n - 1];
        by: f32 = y - oc_y[oc_n - 1];
        if (absf(ax * by - ay * bx) < 0.0001 && ax * bx + ay * by > 0.0) oc_n = oc_n - 1
    }
    if (oc_n < len(oc_x)) {
        oc_x[oc_n] = x;
        oc_y[oc_n] = y;
        oc_n = oc_n + 1
    }
}

// ---- fingers on the board (see touch.l8) ----
// A finger down on the board: whether it holds something (a part to move,
// a waypoint to pull, a guide to draw).
hold_begin(x: f32, y: f32): bool {
    bx: f32 = to_bx(x);
    by: f32 = to_by(y);
    tol: f32 = px_mm(12.0);
    if (touch_ui) tol = px_mm(18.0);
    if (in_3d()) return false;
    if (mode == MODE_CASE) return case_hold(bx, by);
    if (mode == MODE_ARRANGE) {
        p: int = -1;
        q: int = pin_at(bx, by, tol * 0.5);
        if (q >= 0) p = pin_part[q] else p = part_at(bx, by);
        if (p < 0) return false;
        drag_part = p;
        drag_dx = part_x[p] - bx;
        drag_dy = part_y[p] - by;
        drag_kept = false;
        drag_show_x = part_x[p];
        drag_show_y = part_y[p];
        return true
    }
    if (job_on) return false;
    if (guide_on) {
        gd_n = 1;
        gd_x[0] = bx;
        gd_y[0] = by;
        gd_drawing = true;
        return true
    }
    // A waypoint of the picked route; or its copper, to pull a new one out
    // of; or a line of the ratsnest, to route it through where it is pulled.
    k: int = handle_at(x, y);
    if (k >= 0) {
        pt_drag = true;
        pt_route = sel_route;
        pt_k = k;
        pt_kept = false;
        sel_point = k;
        return true
    }
    if (sel_route >= 0 && route_at(bx, by, tol * 0.7) == sel_route) {
        pt_drag = true;
        pt_route = sel_route;
        pt_k = -1;
        pt_kept = false;
        return true
    }
    w: int = wire_at(x, y);
    if (w >= 0) {
        pt_drag = true;
        pt_route = -1;
        pt_k = w;
        pt_kept = false;
        return true
    }
    false
}

hold_move(x: f32, y: f32) {
    if (case_drag > 0) {
        case_move(to_bx(x), to_by(y));
        return
    }
    if (drag_part >= 0) {
        p: int = drag_part;
        if (!drag_kept) {
            before_change();
            drag_kept = true;
            sel_part = p;
            sel_pin = -1;
            sel_seg = -1;
            sel_via = -1;
            lift_routes(p)
        }
        g: f32 = grid_step();
        part_x[p] = snap(to_bx(x) + drag_dx, g);
        part_y[p] = snap(to_by(y) + drag_dy, g);
        place_pins(p);
        check_board();
        return
    }
    if (gd_drawing) {
        bx: f32 = to_bx(x);
        by: f32 = to_by(y);
        last: int = gd_n - 1;
        if (gd_n < GUIDE_PTS && absf(bx - gd_x[last]) + absf(by - gd_y[last]) > px_mm(4.0)) {
            gd_x[gd_n] = bx;
            gd_y[gd_n] = by;
            gd_n = gd_n + 1
        }
        return
    }
    if (pt_drag) {
        bx2: f32 = snap_x(to_bx(x));
        by2: f32 = snap_y(to_by(y));
        if (!pt_kept) {
            before_change();
            pt_kept = true;
            if (pt_route < 0) {
                // (From a line of the ratsnest: a new route, with the point.)
                w: int = pt_k;
                pt_route = new_route(pin_net[wire_a[w]], wire_a[w], wire_b[w], layer_on);
                if (pt_route < 0) {
                    pt_drag = false;
                    return
                }
                insert_point(pt_route, 1, bx2, by2);
                pt_k = 1
            } else if (pt_k < 0) {
                k: int = leg_near(pt_route, to_bx(x), to_by(y));
                if (!insert_point(pt_route, k + 1, bx2, by2)) {
                    pt_drag = false;
                    return
                }
                pt_k = k + 1
            }
            pick_route(pt_route);
            sel_point = pt_k;
            pt_drag = true
        }
        r: int = pt_route;
        i: int = r * RPTS + pt_k;
        if (rp_x[i] != bx2 || rp_y[i] != by2) {
            rp_x[i] = bx2;
            rp_y[i] = by2;
            // (While it moves, the route keeps to free space: nothing is
            // pushed aside until the finger lets go.)
            route_route(r, false)
        }
    }
}

hold_end() {
    if (case_drag > 0) {
        if (case_kept) changed();
        case_drag = 0;
        return
    }
    if (drag_part >= 0) {
        p: int = drag_part;
        drag_part = -1;
        if (drag_kept) {
            settle_part = p;
            settle_t = 0.0;
            settle_routes();
            changed()
        }
        return
    }
    if (gd_drawing) {
        finish_guide();
        return
    }
    if (pt_drag) {
        pt_drag = false;
        if (pt_kept) {
            r: int = pt_route;
            route_assisted(r);
            changed();
            pick_route(r);
            sel_point = pt_k;
            if (!ro_ok[r] || fails > 0) say_routed(r)
        }
    }
}

hold_cancel() {
    case_drag = 0;
    drag_part = -1;
    gd_drawing = false;
    pt_drag = false
}

// A tap on the board.
tap(x: f32, y: f32) {
    bx: f32 = to_bx(x);
    by: f32 = to_by(y);
    tol: f32 = px_mm(10.0);
    if (touch_ui) tol = px_mm(16.0);
    if (mode == MODE_CASE) {
        forget_picks();
        return
    }
    // Arranging, a tap picks out a part (its own connections lit).
    if (mode == MODE_ARRANGE) {
        p0: int = part_at(bx, by);
        q0: int = pin_at(bx, by, tol * 0.5);
        if (q0 >= 0) p0 = pin_part[q0];
        if (p0 >= 0) pick_part(p0) else forget_picks();
        return
    }
    if (job_on || guide_on) return;
    k: int = handle_at(x, y);
    if (k >= 0) {
        sel_point = k;
        return
    }
    q: int = pin_at(bx, by, tol * 0.6);
    if (q >= 0) {
        forget_picks();
        sel_pin = q;
        hl_net = pin_net[q];
        return
    }
    // Copper under the finger first, then a line of the ratsnest near it,
    // then copper a little farther.
    r0: int = route_at(bx, by, px_mm(5.0));
    if (r0 >= 0) {
        pick_route(r0);
        return
    }
    w: int = wire_at(x, y);
    if (w >= 0) {
        route_wire(w);
        return
    }
    r: int = route_at(bx, by, tol);
    if (r >= 0) {
        pick_route(r);
        return
    }
    v: int = via_at(bx, by, tol);
    if (v >= 0) {
        forget_picks();
        if (via_route[v] >= 0) pick_route(via_route[v]) else {
            sel_via = v;
            hl_net = via_net[v]
        }
        return
    }
    s: int = seg_at(bx, by, tol, -1);
    if (s >= 0) {
        forget_picks();
        sel_seg = s;
        hl_net = sg_net[s];
        return
    }
    forget_picks()
}

double_tap(x: f32, y: f32) {
    // (In 3D: apart, or together again.)
    if (in_3d()) {
        exploded = !exploded;
        explode_fit = true;
        return
    }
    ease_zoom_at(x, y, 2.2)
}

// ---- things done to a route ----
// The picked route on the other layer (its waypoints free to be on either).
flip_route() {
    r: int = sel_route;
    if (r < 0) return;
    before_change();
    ro_layer[r] = 1 - ro_layer[r];
    for k in 0..ro_np[r] rp_layer[r * RPTS + k] = -1;
    route_assisted(r);
    changed();
    if (ro_layer[r] == TOP) toast_str("On the top where it can be") else toast_str("On the bottom where it can be")
}

lock_route() {
    r: int = sel_route;
    if (r < 0) return;
    before_change();
    ro_locked[r] = !ro_locked[r];
    changed();
    if (ro_locked[r]) toast_str("Locked: routing will go round it") else toast_str("Free: routing may move it")
}

delete_route_picked() {
    r: int = sel_route;
    if (r < 0) return;
    before_change();
    if (sel_point >= 1 && sel_point < ro_np[r] - 1) {
        remove_point(r, sel_point);
        route_assisted(r);
        changed();
        pick_route(r);
        toast_str("Point taken out");
        return
    }
    delete_route(r);
    forget_picks();
    changed();
    toast_str("Route taken up")
}

// Starting over, as far as is asked: the free routes (what the router
// made and was not locked); all routes; or all copper (routes, tracks and
// vias laid by hand, and pours), leaving the parts on a bare board. Undo
// brings it back.
const CLEAR_FREE: int = 0;

const CLEAR_ROUTES: int = 1;

const CLEAR_ALL: int = 2;

// How much each would take up.
clear_count(level: int): int {
    n: int = 0;
    for r in 0..routes_n {
        if (level > CLEAR_FREE || !ro_locked[r]) n = n + 1
    }
    if (level == CLEAR_ALL) {
        for s in 0..segs_n {
            if (sg_route[s] < 0) n = n + 1
        }
        for v in 0..vias_n {
            if (via_route[v] == -1) n = n + 1
        }
        for l in 0..2 {
            if (pour_net[l] >= 0) n = n + 1
        }
    }
    n
}

clear_copper(level: int) {
    if (clear_count(level) == 0) {
        toast_str("Nothing to clear");
        return
    }
    before_change();
    stop_job();
    forget_picks();
    routes: int = 0;
    r: int = routes_n - 1;
    while (r >= 0) {
        if (level > CLEAR_FREE || !ro_locked[r]) {
            delete_route(r);
            routes = routes + 1
        }
        r = r - 1
    }
    if (level == CLEAR_ALL) {
        s: int = segs_n - 1;
        while (s >= 0) {
            remove_seg(s);
            s = s - 1
        }
        v: int = vias_n - 1;
        while (v >= 0) {
            remove_via(v);
            v = v - 1
        }
        pour_net[TOP] = -1;
        pour_net[BOTTOM] = -1;
        make_pours()
    }
    changed();
    line_clear();
    if (level == CLEAR_ALL) line_add("All copper taken up") else {
        line_int(routes);
        if (routes == 1) line_add(" route taken up") else line_add(" routes taken up");
        if (level == CLEAR_FREE && routes_n > 0) line_add("; locked ones stay")
    }
    line_add(". Undo brings it back");
    toast_line()
}

// Every connection of net n, routed (as Route all, for one net).
route_net(n: int) {
    if (n < 0) return;
    before_change();
    tried: int = 0;
    ok: int = 0;
    for w in 0..wire_n {
        if (pin_net[wire_a[w]] == n) {
            r: int = connect_pins(wire_a[w], wire_b[w], layer_on);
            tried = tried + 1;
            if (r >= 0 && ro_ok[r]) ok = ok + 1
        }
    }
    changed();
    line_clear();
    line_name(net_name[n]);
    line_add(": ");
    line_int(ok);
    line_add(" of ");
    line_int(tried);
    line_add(" routed");
    toast_line()
}

// A pour of the picked pin's net on the bottom, or not.
pour_picked() {
    if (sel_pin < 0 || pin_net[sel_pin] < 0) return;
    n: int = pin_net[sel_pin];
    before_change();
    toggle_pour(n, BOTTOM);
    changed();
    if (pour_net[BOTTOM] == n) say_net_of("Poured on the bottom: ", n) else say_net_of("Pour taken up: ",
        n)
}

say_net_of(t: str, n: int) {
    line_clear();
    line_add(t);
    if (n >= 0) line_name(net_name[n]) else line_add("no net");
    toast_line()
}

// ---- things done to what is picked ----
rotate_part() {
    p: int = sel_part;
    if (p < 0) return;
    before_change();
    part_rot[p] = part_rot[p] + 1 & 3;
    place_pins(p);
    lift_routes(p);
    settle_routes();
    settle_part = p;
    settle_t = 0.0;
    changed()
}

delete_picked() {
    if (sel_route >= 0) {
        delete_route_picked();
        return
    }
    if (sel_part >= 0) {
        before_change();
        line_clear();
        line_name(part_ref[sel_part]);
        line_add(" deleted");
        toast_line();
        remove_part(sel_part);
        forget_picks();
        changed();
        return
    }
    if (sel_seg >= 0) {
        before_change();
        remove_seg(sel_seg);
        forget_picks();
        changed();
        toast_str("Track deleted");
        return
    }
    if (sel_via >= 0) {
        before_change();
        remove_via(sel_via);
        forget_picks();
        changed();
        toast_str("Via deleted")
    }
}

// A new part of footprint f, in the middle of the view.
add_new_part(f: int) {
    before_change();
    g: f32 = 0.5;
    mid_y: f32 = (view_top + scr_h as f32 - view_bottom) * 0.5;
    x: f32 = snap(to_bx(scr_w as f32 * 0.5), g);
    y: f32 = snap(to_by(mid_y), g);
    p: int = add_part(new_ref(f), f, x, y, 0, -1);
    if (p < 0) {
        toast_str("The board is full");
        return
    }
    set_mode(MODE_ARRANGE);
    pick_part(p);
    settle_part = p;
    settle_t = 0.0;
    changed();
    line_clear();
    line_name(part_ref[p]);
    line_add(" added: drag it into place");
    toast_line()
}

set_mode(m: int) {
    if (mode == m) return;
    mode = m;
    drag_part = -1;
    guide_on = false;
    forget_picks();
    if (m == MODE_ROUTE) toast_str("Route: tap a line to route it, or drag it to steer");
    if (m == MODE_ARRANGE) toast_str("Place: drag parts to move them");
    if (m == MODE_CASE || view_fitted) fit_board();
    if (m == MODE_CASE) {
        if (cs_on) toast_str("Case: step through its layers; drag the screen or battery") else toast_str("No case yet: make one from the board")
    }
}

// The layer new routes would rather be on (the picked route's, if one is
// picked: see flip_route).
switch_layer() {
    if (sel_route >= 0) {
        flip_route();
        return
    }
    layer_on = 1 - layer_on;
    if (layer_on == TOP) toast_str("New routes on the top") else toast_str("New routes on the bottom")
}

toggle_guide() {
    if (mode != MODE_ROUTE) set_mode(MODE_ROUTE);
    guide_on = !guide_on;
    forget_picks();
    if (guide_on) toast_str("Draw from one part to another")
}

// Show the next problem the check found.
prob_next: int = 0;

show_problem() {
    if (prob_n == 0) {
        fit_board();
        return
    }
    k: int = prob_next % prob_n;
    prob_next = k + 1;
    r: f32 = 2.5;
    view_fitted = false;
    ease_to_box(prob_x[k] - r, prob_y[k] - r, prob_x[k] + r, prob_y[k] + r);
    line_clear();
    kind: int = prob_kind[k];
    if (kind == PROB_COURT) {
        line_name(part_ref[prob_a[k]]);
        line_add(" and ");
        line_name(part_ref[prob_b[k]]);
        line_add(" overlap")
    } else if (kind == PROB_WALL) {
        line_add("Wood too thin between cuts in the ");
        line_add(pc_name[prob_a[k]]);
        line_add(" layer");
        if (mode == MODE_CASE) case_step(prob_a[k] - cs_view)
    } else if (kind == PROB_EDGE) line_add("Copper too near the edge") else if (kind == PROB_THIN) line_add("Track too thin to make") else if (kind == PROB_KEEPOUT) {
        item_words(prob_a[k]);
        line_add(" runs under ");
        line_name(part_ref[prob_b[k]])
    } else {
        if (kind == PROB_SHORT) line_add("Short: ") else line_add("Too close: ");
        item_words(prob_a[k]);
        line_add(" and ");
        item_words(prob_b[k])
    }
    toast_line()
}

// What an item is, in a few words.
item_words(i: int) {
    if (i < pins_n) {
        line_name(part_ref[pin_part[i]]);
        line_add(".");
        line_name(lp_name[pin_pad[i]]);
        return
    }
    if (it_net[i] >= 0) line_name(net_name[it_net[i]]) else line_add("copper")
}

// ---- keys ----
key_press(ks: int) {
    if (ks == 49) set_mode(MODE_ARRANGE);
    if (ks == 50) set_mode(MODE_ROUTE);
    if (ks == 51) set_mode(MODE_CASE);
    if (ks == 109) order_pending = B_MAKE;
    if (ks == 116 && mode == MODE_CASE) {
        view3d = !view3d;
        v3_fit()
    }
    if (ks == 101 && mode == MODE_CASE) {
        exploded = !exploded;
        explode_fit = true
    }
    if (ks == 91) case_step(-1);
    if (ks == 93) case_step(1);
    if (ks == 114 || ks == 82) rotate_part();
    if (ks == 65535 || ks == 65288) delete_picked();
    if (ks == 122) undo();
    if (ks == 121 || ks == 90) redo();
    if (ks == 102) fit_board();
    if (ks == 118 || ks == 108) switch_layer();
    if (ks == 107) lock_route();
    if (ks == 103) toggle_guide();
    if (ks == 119) start_route_all();
    if (ks == 99) toggle_clear_menu();
    if (ks == 112) show_problem();
    if (ks == 97) sheet_toggle();
    if (ks == 61 || ks == 43) ease_zoom_at(scr_w as f32 * 0.5, scr_h as f32 * 0.5,
        1.5);
    if (ks == 45) ease_zoom_at(scr_w as f32 * 0.5, scr_h as f32 * 0.5, 1.0 / 1.5);
    // (From the page: 1000000000 + 1000 * what + how much.)
    if (ks >= 1000000000) page_says((ks - 1000000000) / 1000, (ks - 1000000000) % 1000)
}

// Escape: whether it meant something here (rather than quitting).
esc_key(): bool {
    if (order_open) {
        order_open = false;
        return true
    }
    if (clear_menu) {
        clear_menu = false;
        return true
    }
    if (sheet_open) {
        sheet_close();
        return true
    }
    if (job_on) {
        stop_job();
        return true
    }
    if (guide_on) {
        guide_on = false;
        return true
    }
    if (sel_part >= 0 || sel_pin >= 0 || sel_seg >= 0 || sel_via >= 0 || sel_route >= 0 || hl_net >= 0) {
        forget_picks();
        return true
    }
    false
}

// The page's measures: the phone's own edges, in window pixels.
page_says(what: int, v: int) {
    // (6: a link over a button of the making panel was tapped: see
    // order.l8.)
    if (what == 6) {
        link_tapped(v);
        return
    }
    if (what == 1) safe_top = v as f32;
    if (what == 2) safe_bottom = v as f32;
    if (what == 3) safe_left = v as f32;
    if (what == 4) safe_right = v as f32;
    layout_ui();
    if (what == 5 || view_fitted) start_view()
}

// ---- each frame ----
start_view() {
    layout_ui();
    fit_board();
    cam_x = ease_x;
    cam_y = ease_y;
    cam_s = ease_s;
    ease_on = false
}

window_resized(was_w: int, was_h: int) {
    // (The same middle, at a zoom that shows as much.)
    k: f32 = minf(scr_w as f32 / maxf(was_w as f32, 1.0), scr_h as f32 / maxf(was_h as f32,
        1.0));
    cam_s = clampf(cam_s * maxf(k, 0.5), min_scale(), max_scale());
    layout_ui();
    if (view_fitted) start_view()
}

// A frame: whether anything moves.
step_editor(dt: f32): bool {
    step_fingers(dt);
    moving: bool = step_view(dt);
    // (The picked-out net fades in and out.)
    if (hl_net >= 0) {
        if (hl_was != hl_net && hl_show > 0.05) hl_show = maxf(hl_show - dt * 10.0,
            0.0) else {
            hl_was = hl_net;
            hl_show = minf(hl_show + dt * 6.0, 1.0)
        }
    } else {
        hl_show = maxf(hl_show - dt * 5.0, 0.0);
        if (hl_show == 0.0) hl_was = -1
    }
    if (hl_net >= 0 && hl_show < 1.0 || hl_net < 0 && hl_was >= 0) moving = true;
    if (settle_t < 1.0) {
        settle_t = minf(settle_t + dt * 3.0, 1.0);
        moving = true
    }
    if (flash_t < 1.0) {
        flash_t = flash_t + dt;
        moving = true
    }
    if (job_on) {
        step_job(12000000);
        moving = true
    }
    if (prob_n > 0 || sel_route >= 0 || guide_on) moving = true;
    if (step_ui(dt)) moving = true;
    moving || fingers_down() > 0
}

// What editing adds over the board: the picked part, pin, track or via;
// routes that found no way (red, dashed, from point to point) and those
// lifted while a part moves (thin lines); the picked route lit, with its
// waypoints to pull and, on each leg, a mark where a new one may be pulled
// out; the guide being drawn; and a flash where a route was made.
draw_editing() {
    s: f32 = cam_s;
    if (sel_part >= 0) {
        p: int = sel_part;
        grow: f32 = 2.0;
        if (settle_part == p && settle_t < 1.0) grow = 2.0 + 10.0 * (1.0 - settle_t) * (1.0 - settle_t);
        if (drag_part == p) grow = 6.0;
        draw_court(p, grow + 1.0, 0.0, 10.0, C_PICK, 0.28);
        draw_court(p, grow, 2.0, 0.0, C_PICK, 0.95)
    }
    if (sel_pin >= 0) {
        q: int = sel_pin;
        x: f32 = to_sx(pin_x[q]);
        y: f32 = to_sy(pin_y[q]);
        hw: f32 = pin_hw[q] * s + 3.0;
        hh: f32 = pin_hh[q] * s + 3.0;
        p_outline(x - hw, y - hh, hw * 2.0, hh * 2.0, pin_r[q] * s + 3.0, 2.0, C_PICK,
            0.95)
    }
    if (sel_seg >= 0) {
        k: int = sel_seg;
        w: f32 = maxf(sg_w[k] * s, 1.0);
        p_line(to_sx(sg_x0[k]), to_sy(sg_y0[k]), to_sx(sg_x1[k]), to_sy(sg_y1[k]),
            w + 8.0, C_PICK, 0.35);
        p_line(to_sx(sg_x0[k]), to_sy(sg_y0[k]), to_sx(sg_x1[k]), to_sy(sg_y1[k]),
            w, mix_rgb(layer_rgb(sg_layer[k]), 16777215, 0.35), 1.0)
    }
    if (sel_via >= 0) {
        v: int = sel_via;
        p_ring(to_sx(via_x[v]), to_sy(via_y[v]), via_d[v] * 0.5 * s + 4.0, 2.0, C_PICK,
            0.95)
    }
    for r in 0..routes_n {
        for k in 0..ro_np[r] - 1 {
            x0: f32 = to_sx(point_x(r, k));
            y0: f32 = to_sy(point_y(r, k));
            x1: f32 = to_sx(point_x(r, k + 1));
            y1: f32 = to_sy(point_y(r, k + 1));
            if (ro_stale[r]) p_line(x0, y0, x1, y1, 1.5, C_WIRE, 0.6) else if (!rl_ok[r * RPTS + k]) {
                // (Quiet, unless picked or its net is.)
                lit: bool = r == sel_route || hl_was >= 0 && ro_net[r] == hl_was;
                if (lit) dashed(x0, y0, x1, y1, 2.2, C_BAD, 0.95) else dashed(x0,
                    y0, x1, y1, 1.4, C_BAD, 0.5)
            }
        }
    }
    if (sel_route >= 0) draw_picked_route(sel_route);
    if (gd_drawing && gd_n > 1) {
        for k in 1..gd_n {
            x0: f32 = to_sx(gd_x[k - 1]);
            y0: f32 = to_sy(gd_y[k - 1]);
            x1: f32 = to_sx(gd_x[k]);
            y1: f32 = to_sy(gd_y[k]);
            p_line(x0, y0, x1, y1, 14.0, C_PICK, 0.18);
            p_line(x0, y0, x1, y1, 3.0, C_PICK, 0.95)
        }
    }
    if (flash_t < 1.0) {
        k2: f32 = flash_t;
        r2: f32 = 6.0 + 40.0 * k2;
        p_ring(to_sx(flash_x), to_sy(flash_y), r2, 3.0 * (1.0 - k2) + 0.5, C_GOOD,
            1.0 - k2)
    }
}

// A dashed line: dashes of 7 pixels, gaps of 5.
dashed(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    w: f32,
    rgb: int,
    a: f32
) {
    dx: f32 = x1 - x0;
    dy: f32 = y1 - y0;
    l: f32 = sqrtf(dx * dx + dy * dy);
    if (l < 0.5) return;
    ux: f32 = dx / l;
    uy: f32 = dy / l;
    // (The dashes march along, slowly: the line wants something.)
    t: f32 = -(now_t * 10.0 - floorf(now_t * 10.0 / 12.0) * 12.0);
    while (t < l) {
        a0: f32 = maxf(t, 0.0);
        a1: f32 = minf(t + 7.0, l);
        if (a1 > a0) p_line(x0 + ux * a0, y0 + uy * a0, x0 + ux * a1, y0 + uy * a1,
            w, rgb, a);
        t = t + 12.0
    }
}

draw_picked_route(r: int) {
    s: f32 = cam_s;
    for k in 0..segs_n {
        if (sg_route[k] == r) {
            w: f32 = maxf(sg_w[k] * s, 1.0);
            p_line(to_sx(sg_x0[k]), to_sy(sg_y0[k]), to_sx(sg_x1[k]), to_sy(sg_y1[k]),
                w + 9.0, C_PICK, 0.3)
        }
    }
    for k in 0..vias_n {
        if (via_route[k] == r) p_ring(to_sx(via_x[k]), to_sy(via_y[k]), via_d[k] * 0.5 * s + 4.0,
            2.0, C_PICK, 0.8)
    }
    // On each leg's longest run, a mark where a waypoint can be pulled out.
    for leg in 0..ro_np[r] - 1 {
        best: int = -1;
        best_l: f32 = 0.0;
        for k in 0..segs_n {
            if (sg_route[k] == r && sg_leg[k] == leg) {
                l: f32 = absf(sg_x1[k] - sg_x0[k]) + absf(sg_y1[k] - sg_y0[k]);
                if (l > best_l) {
                    best_l = l;
                    best = k
                }
            }
        }
        if (best >= 0 && best_l * s > 40.0) {
            mx: f32 = to_sx((sg_x0[best] + sg_x1[best]) * 0.5);
            my: f32 = to_sy((sg_y0[best] + sg_y1[best]) * 0.5);
            p_disc(mx, my, 5.0, C_PANEL, 0.9);
            p_ring(mx, my, 5.0, 1.5, C_PICK, 0.9);
            p_line(mx - 2.5, my, mx + 2.5, my, 1.3, C_PICK, 1.0);
            p_line(mx, my - 2.5, mx, my + 2.5, 1.3, C_PICK, 1.0)
        }
    }
    // Its ends, and its waypoints.
    for k in 0..ro_np[r] {
        x: f32 = to_sx(point_x(r, k));
        y: f32 = to_sy(point_y(r, k));
        if (k == 0 || k == ro_np[r] - 1) p_ring(x, y, 7.0, 2.0, C_PICK, 0.9) else {
            big: f32 = 0.0;
            if (k == sel_point) big = 3.0;
            p_glow(x, y, 10.0 + big, 6.0, 0, 0.5);
            p_disc(x, y, 7.0 + big, C_INK, 1.0);
            p_disc(x, y, 3.5 + big * 0.5, C_PICK, 1.0);
            if (k == sel_point) p_ring(x, y, 14.0, 2.0, C_PICK, 0.9)
        }
    }
}

// ---- the case (see case.l8) ----
// Make a case for the board: 3.2 mm plywood, a 9 mm rim, the screen near
// the top, the battery under the lower half.
make_case_here() {
    if (cs_on) return;
    before_change();
    cs_on = true;
    cs_ply = 3.2;
    cs_rim = 9.0;
    cs_screen_x = 0.0;
    cs_screen_y = snap(brd_h * 0.5 - SCREEN_H * 0.5 - 2.0, 0.5);
    cs_batt_x = 0.0;
    cs_batt_y = snap(-brd_h * 0.25, 0.5);
    cs_view = L_FRONT;
    changed();
    cm_drawn = false;
    fit_board();
    toast_str("A case of eight layers: step through them")
}

// Show the layer d above (or below) the one shown.
case_step(d: int) {
    if (!cs_on || layers_n == 0) return;
    cs_view = clampi(cs_view + d, 0, layers_n - 1);
    cm_drawn = false
}

// Dragging the screen (1) or the battery (2), in the layers they lie in.
case_drag: int = 0;

case_kept: bool = false;

case_dx: f32 = 0.0;

case_dy: f32 = 0.0;

case_hold(bx: f32, by: f32): bool {
    // (A dock has no screen or battery to move.)
    if (!cs_on || dock_on) return false;
    if (cs_view >= L_SHELF && absf(bx - cs_screen_x) < SCREEN_W * 0.5 && absf(by - cs_screen_y) < SCREEN_H * 0.5) {
        case_drag = 1;
        case_dx = cs_screen_x - bx;
        case_dy = cs_screen_y - by
    } else if (cs_view >= L_BATT1 && cs_view <= L_BATT2 && absf(bx - cs_batt_x) < batt_w() * 0.5 && absf(by - cs_batt_y) < batt_l() * 0.5) {
        case_drag = 2;
        case_dx = cs_batt_x - bx;
        case_dy = cs_batt_y - by
    } else return false;
    case_kept = false;
    true
}

case_move(bx: f32, by: f32) {
    if (!case_kept) {
        before_change();
        case_kept = true
    }
    g: f32 = grid_step();
    if (case_drag == 1) {
        cs_screen_x = snap(bx + case_dx, g);
        cs_screen_y = snap(by + case_dy, g)
    } else {
        cs_batt_x = snap(bx + case_dx, g);
        cs_batt_y = snap(by + case_dy, g)
    }
    make_case();
    cm_drawn = false
}
