tag cad_finish;

use_tag std, cad, skate;

// finish IN OUT: a board as a generator wrote it (its parts and nets,
// placed), routed whole as the editor's Route all routes it (ground poured
// on both sides first), and written to OUT with its copper: so that the
// board files kept in the repository are the whole design, not only what
// it starts from. Its comment lines at the top are kept, and a line saying
// it was routed. Fails (status 1) if anything is left to connect or any
// rule is broken.
//
//   ./l8c3 build programs/cad/tools/finish.l8 -o .build/cad-finish
//   python3 programs/cad/tools/handheld.py /tmp/handheld.pcb
//   .build/cad-finish /tmp/handheld.pcb programs/cad/handheld.pcb
//
// (make cad-boards does all of that, for the handheld and the dock.)
import "../../../stdlib/print.l8";

import "../../gl/gl.l8";

import "../../skate/math.l8";

import "../../skate/font.l8";

import "../names.l8";

import "../paint.l8";

import "../parts.l8";

import "../board.l8";

import "../check.l8";

import "../route.l8";

import "../pour.l8";

import "../view.l8";

import "../draw.l8";

import "../touch.l8";

import "../case.l8";

import "../dock.l8";

import "../designs.l8";

import "../sourcing.l8";

import "../fab.l8";

import "../order.l8";

import "../view3d.l8";

import "../steps.l8";

import "../edit.l8";

import "../ui.l8";

main(argc: int, argv: []str) raises IoError: int {
    if (argc != 3) {
        eprint("usage: finish IN OUT");
        return 2
    }
    load_library();
    names_lib = names_n;
    names_lib_used = name_used;
    if (!read_file(argv[1])) {
        eprint("finish: cannot read the board file");
        return 1
    }
    // (Its comment lines at the top, kept to write first.)
    head: []i8 = buffer(8192, 0i8);
    head_n: int = 0;
    i: int = 0;
    while (i < doc_n && doc[i] == '#') {
        e: int = i;
        while (e < doc_n && doc[e] != '\n') e = e + 1;
        // (Not a note from routing it before: that is written again.)
        routed_note: bool = e - i > 10 && doc[i + 2] == 'R' && doc[i + 3] == 'o' && doc[i + 4] == 'u';
        if (!routed_note && head_n + e + 1 - i < len(head)) {
            for c in i..e + 1 head[head_n + c - i] = doc[c];
            head_n = head_n + e + 1 - i
        }
        i = e + 1
    }
    read_board(doc, doc_n);
    check_board();
    start_route_all();
    while (job_on) step_job(1000000000);
    // (The pours made again, with their stitching, as the board will be
    // when it is read: then checked.)
    make_pours();
    check_board();
    write_board();
    fd: int = open(argv[2], 577, 420);
    if (fd < 0) {
        eprint("finish: cannot write the board file");
        return 1
    }
    write_bytes_n(fd, head, head_n);
    write(fd, "# Routed by tools/finish.l8 (Route all): the copper below is as it laid it.\n");
    write_bytes_n(fd, doc, doc_n);
    close(fd);
    line_clear();
    line_name(brd_name);
    line_add(": nets joined ");
    line_int(nets_done);
    line_add(" of ");
    line_int(nets_wanted);
    line_add(", problems ");
    line_int(prob_n);
    write_bytes_n(1, line, line_n);
    print("");
    // (Each problem: what, and where.)
    for k in 0..prob_n {
        line_clear();
        line_add("  ");
        prob_words(k);
        line_add(" at ");
        line_num(prob_x[k], 2);
        line_add(", ");
        line_num(prob_y[k], 2);
        write_bytes_n(1, line, line_n);
        print("")
    }
    if (nets_done < nets_wanted || prob_n > 0) return 1;
    0
}
