tag cad;

use_tag std, gl, x11, skate;

// Making it: everything to send off so that the thing arrives, from the
// design as it is. A panel lists who makes or sells each part of it, with
// what to send them (files written from the board and the case) and a way
// to their page with that ready: the board, made and its parts put on, at
// JLCPCB (the Gerber, drill and assembly files: see fab.l8); the case's
// plywood, laser cut, at Ponoko (the cut file: see case.l8); the screen,
// bolts, nuts, battery and the rest from DigiKey (a cart filled by its
// FastAdd link); the handheld's wireless receiver from Adafruit;
// Paying is left to a person, at each.
//
// On a page, a tap that opens another site or saves a file has to be the
// page's own: so the panel says where its buttons are (CADLINK lines, in
// window pixels) and the page lays links over them. Off a page, a button
// writes its file beside the board, or says the site's address.
extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

order_open: bool = false;

// A button pressed (its file to write, its site), done once the frame is
// drawn: see main.l8.
order_pending: int = -1;

order_t: f32 = 0.0;

const B_MAKE: int = 44;

const B_ORDER_CLOSE: int = 45;

const B_FAB_FILES: int = 46;

const B_FAB_SITE: int = 47;

const B_CUT_FILE: int = 48;

const B_CUT_SITE: int = 49;

const B_PARTS_CART: int = 50;

const B_ADAFRUIT: int = 51;

JLCPCB_URL: str = "https://cart.jlcpcb.com/quote";

PONOKO_URL: str = "https://www.ponoko.com/laser-cutting";

// The hardware, from DigiKey: what, its DigiKey part number, and how many.
// (Each checked on DigiKey's own page, in stock, on 2026-10-16. The
// bolts are steel: Keystone's M2.5 pan heads, sold at 4, 6, 12 and 16 mm
// (see BOLT_LENGTHS); the nuts steel. The foam squares, 3M's 4026 (25 mm,
// 1.6 mm thick, sticky both sides), cut in strips: hold the battery and
// the receiver still in their pockets (and the board up against its
// posts), and on the spacer under the screen's ends press it up against
// the window's acrylic (squeezed to 0.8 mm). The wireless charging receiver,
// Adafruit's 1901, DigiKey does not carry: it is Adafruit's own row.)
HW_WHAT: []str = ["M2.5 bolt, steel", "M2.5 nut", "Battery, 1200 mAh", "Screen, 2.8 inch",
    "Foam square"];

HW_PN: []str = ["", "36-4707-ND", "1528-1838-ND", "NHD-2.8-240320AF-CSXP-F-ND", "3M155956-ND"];

// A bolt's DigiKey number, by its length (one of BOLT_LENGTHS).
bolt_pn(length: int) {
    if (length <= 4) line_add("36-29300-ND") else if (length <= 6) line_add("36-29301-ND") else if (length <= 12) line_add("36-29304-ND") else line_add("36-29306-ND")
}

// A dock's: the base's six bolts (12 mm, into nuts in Cavity 2), the
// board's three (8 mm, APM Hexseal's), their nine nuts; the four
// transmitters (Adafruit 2162); its charger, Qualtek's QFWC-18-12-USCR
// (18 W, USB-C power delivery, 5 V at 3 A among its voltages, a folding US
// plug, 48 x 48 x 28 mm; a USB-C socket, its cable not with it) and a
// USB-C cable for it (Adafruit's 4199: 1 m, marked for 5 A); the lid's magnets (Eclipse's N826:
// 10 x 2 mm, magnetized through, ten to a bag: eight are used); and foam
// squares for the coils and the transmitters' boards.
DOCK_PN: []str = ["36-29304-ND", "RM2.5X8-2701-ND", "36-4707-ND", "1528-1977-ND",
    "Q1285-ND", "4307-N826-ND", "3M155956-ND", "1528-4199-ND"];

dock_qty(k: int): int {
    if (k == 0) return DK_BOLTS;
    if (k == 1) return dk_board_bolts();
    if (k == 2) return DK_BOLTS + dk_board_bolts();
    if (k == 3) return 4;
    if (k == 6) return 16;
    1
}

// How many bolts hold the dock's board to its base: its holes.
dk_board_bolts(): int {
    n: int = 0;
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "mh25")) n = n + 1
    }
    n
}

hw_qty(k: int): int {
    if (k <= 1) return bolts_n();
    if (k == 4) return 6;
    1
}

// Adafruit's own page for what DigiKey does not carry: the handheld's
// wireless charging receiver.
ADAFRUIT_URL: str = "https://www.adafruit.com/product/1901";

// The files, where they are written: on a page, in its memory, for the
// page to save (named after the board as it does); else beside where the
// editor was started.
// (A cut file of more than one sheet goes as a zip of them.)
fab_path(case_file: bool): str {
    if (on_page) {
        if (case_file && cut_sheets() > 1) return "/case.zip";
        if (case_file) return "/case.svg";
        return "/fab.zip"
    }
    if (case_file && cut_sheets() > 1) return "case.zip";
    if (case_file) return "case.svg";
    "fab.zip"
}

// The cut file's ending, after the board's name.
cut_ending(): str {
    if (cut_sheets() > 1) return "-case.zip";
    "-case.svg"
}

cut_sheets(): int {
    lay_out_sheets();
    sheets_n
}

// Each sheet's file in the zip, named for what it is cut from.
PLY_FILES: []str = ["-ply-1.svg", "-ply-2.svg", "-ply-3.svg", "-ply-4.svg", "-ply-5.svg",
    "-ply-6.svg", "-ply-7.svg", "-ply-8.svg", "-ply-9.svg", "-ply-10.svg"];

ACRYLIC_FILES: []str = ["-acrylic-1.svg", "-acrylic-2.svg", "-acrylic-3.svg"];

// The cut file: one sheet's SVG (in svg), or a zip of them all (in zip).
write_cut() {
    n: int = cut_sheets();
    if (n <= 1) {
        write_case_svg(0);
        return
    }
    zip_begin();
    np: int = 0;
    na: int = 0;
    for k in 0..n {
        write_case_svg(k);
        fo_n = svg_n;
        for i in 0..svg_n fo[i] = svg[i];
        if (sheet_mat[k] == PC_ACRYLIC) {
            if (na < len(ACRYLIC_FILES)) zip_add(ACRYLIC_FILES[na]);
            na = na + 1
        } else {
            if (np < len(PLY_FILES)) zip_add(PLY_FILES[np]);
            np = np + 1
        }
    }
    zip_end()
}

// How many of the sheets are acrylic.
acrylic_sheets(): int {
    n: int = 0;
    for k in 0..cut_sheets() {
        if (sheet_mat[k] == PC_ACRYLIC) n = n + 1
    }
    n
}

write_out(case_file: bool) raises IoError {
    if (case_file) write_cut() else write_fab();
    fd: int = open(fab_path(case_file), 577, 420);
    if (fd < 0) {
        toast_str("Could not write the file");
        return
    }
    if (case_file && cut_sheets() <= 1) write_bytes_n(fd, svg, svg_n) else write_bytes_n(fd,
        zip, zip_n);
    close(fd)
}

// The files are written when the panel opens (and again if the design
// changed since).
order_written: int = -1;

order_toggle() raises IoError {
    order_open = !order_open;
    if (order_open) {
        forget_picks();
        // (On a page, ready to save; else only worked out, for what the
        // panel says, until a button asks for the file.)
        if (on_page) {
            write_out(false);
            write_out(true)
        } else {
            write_cut();
            write_fab()
        }
        order_written = und_pos
    }
}

// ---- the page's links ----
const LINKS: int = 8;

lk_id: []int = static_buffer(LINKS, 0);

lk_x0: []f32 = static_buffer(LINKS, 0.0);

lk_y0: []f32 = static_buffer(LINKS, 0.0);

lk_x1: []f32 = static_buffer(LINKS, 0.0);

lk_y1: []f32 = static_buffer(LINKS, 0.0);

lk_n: int = 0;

// What was last told the page, to say again only when it changes.
told_links: int = -1;

add_link(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    if (lk_n >= LINKS) return;
    lk_id[lk_n] = id;
    lk_x0[lk_n] = x0;
    lk_y0[lk_n] = y0;
    lk_x1[lk_n] = x1;
    lk_y1[lk_n] = y1;
    lk_n = lk_n + 1
}

// Where link id goes, into line: `open URL` or `save PATH NAME`.
link_words(id: int) {
    if (id == B_FAB_SITE) {
        line_add("open ");
        line_add(JLCPCB_URL)
    }
    if (id == B_CUT_SITE) {
        line_add("open ");
        line_add(PONOKO_URL)
    }
    if (id == B_PARTS_CART) {
        line_add("open ");
        cart_url()
    }
    if (id == B_ADAFRUIT) {
        line_add("open ");
        line_add(ADAFRUIT_URL)
    }
    if (id == B_FAB_FILES || id == B_CUT_FILE) {
        line_add("save ");
        line_add(fab_path(id == B_CUT_FILE));
        line_add(" ");
        fab_name();
        if (id == B_CUT_FILE) line_add(cut_ending()) else line_add("-fab.zip")
    }
}

// DigiKey's FastAdd link: a new cart with these parts in it.
cart_url() {
    line_add("https://www.digikey.com/classic/ordering/fastadd.aspx?newcart=true");
    k: int = 0;
    if (dock_on) {
        for h in 0..len(DOCK_PN) {
            k = k + 1;
            line_add("&part");
            line_int(k);
            line_add("=");
            line_add(DOCK_PN[h]);
            line_add("&qty");
            line_int(k);
            line_add("=");
            line_int(dock_qty(h))
        }
        return
    }
    for h in 0..len(HW_PN) {
        {
            k = k + 1;
            line_add("&part");
            line_int(k);
            line_add("=");
            if (h == 0) bolt_pn(bolt_length() as int) else line_add(HW_PN[h]);
            line_add("&qty");
            line_int(k);
            line_add("=");
            line_int(hw_qty(h))
        }
    }
}

// The page says a link was tapped (the button's id): say what it did, as
// the button would off a page.
link_tapped(id: int) {
    line_clear();
    if (id == B_FAB_FILES || id == B_CUT_FILE) {
        line_add("Saving ");
        fab_name();
        if (id == B_CUT_FILE) line_add(cut_ending()) else line_add("-fab.zip")
    } else {
        line_add("Opening ");
        if (id == B_FAB_SITE) line_add("JLCPCB: upload the zip, then the parts and their places");
        if (id == B_CUT_SITE) line_add("Ponoko: upload the cut file, birch ply ");
        if (id == B_CUT_SITE) line_num(cs_ply, 1);
        if (id == B_CUT_SITE) line_add(" mm");
        if (id == B_PARTS_CART) line_add("DigiKey, with the parts in a new cart");
        if (id == B_ADAFRUIT) line_add("Adafruit: the wireless charging receiver")
    }
    toast_line()
}

// Once a frame, after drawing: the links, to the page, if they changed.
tell_links() raises IoError {
    if (!on_page) return;
    sum: int = lk_n;
    for k in 0..lk_n sum = sum * 31 + lk_id[k] + (lk_x0[k] + lk_y0[k] * 7.0 + lk_x1[k] * 13.0 + lk_y1[k] * 17.0) as int;
    if (sum == told_links) return;
    told_links = sum;
    line_clear();
    line_add("CADLINKS ");
    line_int(lk_n);
    write_bytes_n(1, line, line_n);
    print("");
    for k in 0..lk_n {
        line_clear();
        line_add("CADLINK ");
        line_int(lk_id[k]);
        line_add(" ");
        line_int(lk_x0[k] as int);
        line_add(" ");
        line_int(lk_y0[k] as int);
        line_add(" ");
        line_int((lk_x1[k] + 0.5) as int);
        line_add(" ");
        line_int((lk_y1[k] + 0.5) as int);
        line_add(" ");
        link_words(lk_id[k]);
        write_bytes_n(1, line, line_n);
        print("")
    }
}

// A button off a page: the file written beside the board, or the site's
// address said (and printed, to be opened).
order_act(id: int) raises IoError {
    if (id == B_MAKE) order_toggle();
    if (id == B_ORDER_CLOSE) order_open = false;
    if (id == B_FAB_FILES || id == B_CUT_FILE) {
        write_out(id == B_CUT_FILE);
        line_clear();
        line_add(fab_path(id == B_CUT_FILE));
        line_add(" written");
        toast_line()
    }
    if (id == B_FAB_SITE || id == B_CUT_SITE || id == B_PARTS_CART || id == B_ADAFRUIT) {
        line_clear();
        link_words(id);
        write_bytes_n(1, line, line_n);
        print("");
        toast_line()
    }
}

// The loose pieces that are acrylic, not ply (the window): not discs.
acrylic_pieces(): int {
    n: int = 0;
    for p in layers_n..pieces_count {
        if (pc_material[p] != PC_PLY) n = n + 1
    }
    n
}

// ---- the panel ----
// Its rows scroll (a finger, or the wheel), if the window is too short
// for them all: as far as the last frame found they reach.
order_scroll: f32 = 0.0;

order_content_h: f32 = 0.0;

order_view_h: f32 = 0.0;

order_dragging: bool = false;

order_last_y: f32 = 0.0;

order_list_y: f32 = 0.0;

order_head_h: f32 = 72.0;

// The wheel over the panel: whether it was the panel's.
order_wheel(amount: f32): bool {
    if (order_t < 0.5) return false;
    order_scroll_by(amount * 0.5);
    true
}

order_scroll_by(d: f32) {
    order_scroll = clampf(order_scroll + d, 0.0, maxf(order_content_h - order_view_h,
        0.0))
}

draw_order() {
    if (order_t < 0.01) return;
    a: f32 = order_t;
    w: f32 = minf(scr_w as f32 - 20.0 - safe_left - safe_right, 560.0);
    x: f32 = (scr_w as f32 - w) * 0.5;
    top: f32 = safe_top + 10.0;
    h: f32 = scr_h as f32 - safe_bottom - 10.0 - top;
    // (No taller than its words and rows, as the last frame laid them.)
    if (order_content_h > 0.0) h = minf(h, order_head_h + order_content_h + 10.0);
    y: f32 = top + (1.0 - order_t) * 40.0;
    // (A shade over the rest: a tap on it shuts the panel.)
    p_box(0.0, 0.0, scr_w as f32, scr_h as f32, 0.0, 0, 0.45 * a);
    if (a > 0.5) add_button(B_ORDER_CLOSE, 0.0, 0.0, scr_w as f32, scr_h as f32);
    panel(x, y, w, h, 20.0, a);
    line_clear();
    line_add("Make it: ");
    line_name(brd_name);
    fit_text(1, 22.0, x + 18.0, y + 34.0, w - 120.0, C_INK, a);
    pill_button(B_ORDER_CLOSE, x + w - 88.0, y + 12.0, 76.0, 34.0, "Done", false,
        a);
    // Whether the design is ready to send.
    line_clear();
    ok: bool = wire_n == 0 && prob_n == 0;
    if (ok && stage_on) line_add("For the set: this dock, and four of the handheld (its own panel). Nothing is ordered until you pay on each site.") else if (ok) line_add("Ready: each opens with what to send or buy. Nothing is ordered until you pay on each site.") else {
        line_add("Not ready: ");
        if (wire_n > 0) {
            line_int(wire_n);
            line_add(" connections not yet joined");
            if (prob_n > 0) line_add(", ")
        }
        if (prob_n > 0) {
            line_int(prob_n);
            line_add(" problems")
        }
    }
    rgb: int = C_MUTED;
    if (!ok) rgb = C_BAD;
    n: int = wrap_lines(0, 13.0, w - 36.0, 0, line_n);
    wrap_text_n(0, 13.0, x + 18.0, y + 56.0, w - 36.0, 16.0, 0, line_n, rgb, a);
    // The rows, under it, scrolling within the panel.
    list_y: f32 = y + 56.0 + 16.0 * (n - 1) as f32 + 12.0;
    order_view_h = y + h - 10.0 - list_y;
    order_list_y = list_y;
    order_head_h = list_y - y;
    order_scroll_by(0.0);
    p_clip(x, list_y, x + w, y + h - 10.0);
    ry: f32 = list_y - order_scroll;
    // The board.
    line_clear();
    parts: int = 0;
    kinds: int = 0;
    for p in 0..parts_n {
        s: int = source_of(p);
        if (s >= 0) {
            parts = parts + 1;
            first: bool = true;
            for o in 0..p {
                if (source_of(o) == s) first = false
            }
            if (first) kinds = kinds + 1
        }
    }
    line_add("2 layers, ");
    line_num(brd_w, 1);
    line_add(" x ");
    line_num(brd_h, 1);
    line_add(" mm, ");
    line_num(brd_t, 1);
    line_add(" mm thick");
    if (absf(brd_t - 1.6) > 0.01) {
        line_add(" (pick ");
        line_num(brd_t, 1);
        line_add(" in JLCPCB's form: its default is 1.6)")
    }
    line_add("; ");
    line_int(parts);
    line_add(" parts of ");
    line_int(kinds);
    line_add(" kinds put on, from LCSC.");
    ry = order_row(x + 10.0, ry, w - 20.0, "The board, made and put together", "JLCPCB",
        B_FAB_FILES, "Files", B_FAB_SITE, "JLCPCB", a);
    // The case.
    line_clear();
    if (!cs_on) line_add("This board has no case.") else {
        ns: int = cut_sheets();
        line_int(layers_n);
        line_add(" layers and ");
        line_int(pieces_count - layers_n - acrylic_pieces());
        if (dock_on) line_add(" pieces (the lid, its top, feet) of ") else line_add(" discs of ");
        line_num(cs_ply, 1);
        if (ns > 1) {
            na: int = acrylic_sheets();
            line_add(" mm birch ply, on ");
            line_int(ns - na);
            if (ns - na == 1) line_add(" sheet") else line_add(" sheets");
            line_add(" of 790 x 384 mm");
            if (na > 0) line_add("; the window, 3 mm clear acrylic, its own file") else line_add(".")
        } else {
            line_add(" mm birch ply, on a sheet ");
            line_int(sheet_w as int);
            line_add(" x ");
            line_int(sheet_h as int);
            line_add(" mm.")
        }
    }
    ry = order_row(x + 10.0, ry, w - 20.0, "The case, laser cut", "Ponoko", B_CUT_FILE,
        "Cut file", B_CUT_SITE, "Ponoko", a);
    // The hardware.
    line_clear();
    if (dock_on) {
        line_add("Four Qi transmitters (Adafruit 2162), an 18 W USB-C charger and its 1 m cable, steel bolts and nuts, the lid's magnets, foam squares.");
        ry = order_row(x + 10.0, ry, w - 20.0, "Transmitters, charger, bolts, magnets",
            "DigiKey", -1, "", B_PARTS_CART, "Cart", a)
    } else {
        line_add("The 2.8 inch screen (Newhaven), ");
        line_int(bolts_n());
        line_add(" M2.5 x ");
        line_num(bolt_length(), 0);
        line_add(" steel bolts and nuts, a 1200 mAh battery, foam squares.");
        ry = order_row(x + 10.0, ry, w - 20.0, "Screen, battery, bolts, the rest",
            "DigiKey", -1, "", B_PARTS_CART, "Cart", a);
        line_clear();
        line_add("The wireless charging receiver (1901), which DigiKey does not carry (if Adafruit is out of it: Mouser's 485-1901).");
        ry = order_row(x + 10.0, ry, w - 20.0, "Wireless charging receiver", "Adafruit",
            -1, "", B_ADAFRUIT, "Adafruit", a)
    }
    order_content_h = ry + order_scroll - list_y;
    p_noclip();
    // (Scrolled: a fade at the edge it goes on past.)
    if (order_scroll > 1.0) p_box(x + 12.0, list_y, w - 24.0, 1.0, 0.5, C_LINE, a);
    if (order_scroll < order_content_h - order_view_h - 1.0) p_box(x + 12.0, y + h - 11.0,
        w - 24.0, 1.0, 0.5, C_LINE, a)
}

// A row: what, from whom, a line about it (in line, as many lines as it
// takes), and its buttons (a file to save, if file >= 0, and the site)
// under it. Where the next row goes. (A button out of the panel's room is
// drawn, cut off, but not pressable.)
order_row(
    x: f32,
    y: f32,
    w: f32,
    what: str,
    who: str,
    file: int,
    file_t: str,
    site: int,
    site_t: str,
    a: f32
): f32 {
    n: int = wrap_lines(0, 13.0, w - 28.0, 0, line_n);
    bh: f32 = 34.0;
    by: f32 = y + 63.0 + 16.0 * (n - 1) as f32 + 12.0;
    h: f32 = by + bh + 10.0 - y;
    order_row_face(x, y, w, h, what, who, a);
    wrap_text_n(0, 13.0, x + 14.0, y + 63.0, w - 28.0, 16.0, 0, line_n, C_MUTED, a);
    shown: bool = by >= order_list_y && by + bh <= order_list_y + order_view_h;
    bx: f32 = x + w - 10.0;
    sw: f32 = p_str_w(1, 14.0, site_t) + 40.0;
    bx = bx - sw;
    b0: int = btn_n;
    pill_button(site, bx, by, sw, bh, site_t, true, a);
    if (a > 0.9 && shown) add_link(site, bx, by, bx + sw, by + bh);
    if (file >= 0) {
        fw: f32 = p_str_w(1, 14.0, file_t) + 40.0;
        bx = bx - fw - 8.0;
        pill_button(file, bx, by, fw, bh, file_t, false, a);
        if (a > 0.9 && shown) add_link(file, bx, by, bx + fw, by + bh)
    }
    if (!shown) btn_n = b0;
    y + h + 8.0
}

order_row_face(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    what: str,
    who: str,
    a: f32
) {
    p_box(x, y, w, h, 14.0, C_PANEL_HI, 0.6 * a);
    p_str(1, 16.0, x + 14.0, y + 26.0, what, C_INK, a);
    p_str(0, 12.5, x + 14.0, y + 44.0, who, C_PICK, a)
}

// What is in line, at (x, y), made smaller if wider than room.
fit_text(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    room: f32,
    rgb: int,
    a: f32
) {
    s: f32 = size;
    tw: f32 = p_text_w(face, s, line, 0, line_n);
    if (tw > room) s = s * room / tw;
    p_text(face, s, x, y, line, 0, line_n, 0.0, rgb, a)
}

// How many lines (1 or 2) the bytes of line from `from` to `to` take in
// room at size: made smaller if need be, but not below least (readable on
// a phone); past that, two.
wrap_count(
    face: int,
    size: f32,
    least: f32,
    room: f32,
    from: int,
    to: int
): int {
    if (p_text_w(face, size, line, from, to) * least / size <= room) return 1;
    2
}

// Those bytes at (x, y), on one line or two (lh apart, broken at a space).
wrap_text(
    face: int,
    size: f32,
    least: f32,
    x: f32,
    y: f32,
    room: f32,
    lh: f32,
    from: int,
    to: int,
    rgb: int,
    a: f32
) {
    tw: f32 = p_text_w(face, size, line, from, to);
    if (wrap_count(face, size, least, room, from, to) == 1) {
        p_line_text(face, minf(size, size * room / maxf(tw, 1.0)), x, y, from, to,
            rgb, a);
        return
    }
    // (The last space at which the first line still fits.)
    k: int = from;
    for i in from..to {
        if (line[i] == ' ' && p_text_w(face, size, line, from, i) <= room) k = i
    }
    if (k == from) k = (from + to) / 2;
    p_line_text(face, size, x, y, from, k, rgb, a);
    w2: f32 = p_text_w(face, size, line, k + 1, to);
    p_line_text(face, minf(size, size * room / maxf(w2, 1.0)), x, y + lh, k + 1, to,
        rgb, a)
}

// How many lines the bytes of line from `from` to `to` take in room at
// size, broken at spaces.
wrap_lines(
    face: int,
    size: f32,
    room: f32,
    from: int,
    to: int
): int {
    n: int = 1;
    i: int = from;
    while (i < to) {
        k: int = wrap_break(face, size, room, i, to);
        if (k < to) n = n + 1;
        i = k + 1
    }
    n
}

// Where the line starting at `from` breaks: the last space at which it
// still fits (or `to`, if it all does; or, a word too long, after it).
wrap_break(
    face: int,
    size: f32,
    room: f32,
    from: int,
    to: int
): int {
    if (p_text_w(face, size, line, from, to) <= room) return to;
    k: int = -1;
    for i in from..to {
        if (line[i] == ' ' && k < 0 || line[i] == ' ' && p_text_w(face, size, line,
            from, i) <= room) k = i
    }
    if (k < 0) return to;
    k
}

// Those bytes at (x, y), on as many lines as they take, lh apart.
wrap_text_n(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    room: f32,
    lh: f32,
    from: int,
    to: int,
    rgb: int,
    a: f32
) {
    i: int = from;
    ly: f32 = y;
    while (i < to) {
        k: int = wrap_break(face, size, room, i, to);
        tw: f32 = p_text_w(face, size, line, i, k);
        p_line_text(face, minf(size, size * room / maxf(tw, 1.0)), x, ly, i, k, rgb,
            a);
        ly = ly + lh;
        i = k + 1
    }
}

// Those bytes at (x, y) on one line: made smaller if need be, down to
// least, and past that cut short, with "...".
cut_text(
    face: int,
    size: f32,
    least: f32,
    x: f32,
    y: f32,
    room: f32,
    from: int,
    to: int,
    rgb: int,
    a: f32
) {
    if (wrap_count(face, size, least, room, from, to) == 1) {
        wrap_text(face, size, least, x, y, room, 16.0, from, to, rgb, a);
        return
    }
    dots: f32 = p_str_w(face, least, "...");
    k: int = to;
    while (k > from && p_text_w(face, least, line, from, k) + dots > room) k = k - 1;
    p_line_text(face, least, x, y, from, k, rgb, a);
    p_str_at(face, least, x + p_text_w(face, least, line, from, k), y, "...", rgb,
        a)
}

p_str_at(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    t: str,
    rgb: int,
    a: f32
) {
    p_str(face, size, x, y, t, rgb, a)
}

// Bytes of line, drawn.
p_line_text(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    from: int,
    to: int,
    rgb: int,
    a: f32
) {
    p_text(face, size, x, y, line, from, to, 0.0, rgb, a)
}
