// The handheld's board, read and checked, with a window to aim in.
test_load() {
    test_load_file("programs/cad/tests/sketch.pcb")
}

test_load_file(path: str) {
    if (fp_n == 0) {
        load_library();
        names_lib = names_n;
        names_lib_used = name_used
    }
    fd: int = open(path, 0, 0);
    doc_n = 0;
    more: bool = true;
    while (more) {
        r: int = read(fd, doc, doc_n, len(doc) - doc_n);
        if (r <= 0) more = false else doc_n = doc_n + r
    }
    close(fd);
    read_board(doc, doc_n);
    check_board();
    und_n = 0;
    und_pos = 0;
    forget_picks();
    scr_w = 400;
    scr_h = 800;
    cam_x = 6.0;
    cam_y = 3.0;
    cam_s = 40.0
}

pin_named(t: str): int {
    b: []i8 = bytes(t);
    find_pin(b, 0, len(b))
}

say_counts() raises IoError {
    write(1, "parts ");
    write_int(1, parts_n);
    write(1, ", pins ");
    write_int(1, pins_n);
    write(1, ", nets joined ");
    write_int(1, nets_done);
    write(1, " of ");
    write_int(1, nets_wanted);
    write(1, ", to connect ");
    write_int(1, wire_n);
    write(1, ", problems ");
    write_int(1, prob_n);
    print("")
}

say_toast() raises IoError {
    write_bytes_n(1, toast_buf, toast_n);
    print("")
}

test "the handheld's board reads whole, and its one track is a short" {
    test_load();
    say_counts();
    write(1, "unread line ");
    write_int(1, read_error);
    print("");
    k: int = 0;
    write(1, "problem ");
    write_int(1, prob_kind[k]);
    write(1, ": ");
    line_clear();
    item_words(prob_a[k]);
    line_add(" and ");
    item_words(prob_b[k]);
    write_bytes_n(1, line, line_n);
    print("");
    expect {|
        parts 42, pins 239, nets joined 1 of 40, to connect 159, problems 1
        unread line 0
        problem 1: J2.GND and VBAT
    |}
}

test "the board written out reads back the same" {
    test_load();
    write_board();
    first: []i8 = new i8[doc_n](0i8);
    memcpy(first, 0, doc, 0, doc_n);
    n: int = doc_n;
    read_board(first, n);
    write_board();
    same: bool = n == doc_n;
    for i in 0..mini(n, doc_n) {
        if (first[i] != doc[i]) same = false
    }
    print_bool(same);
    expect {|
        true
    |}
}

say_net(t: str) raises IoError {
    b: []i8 = bytes(t);
    n: int = find_net(b, 0, len(b));
    write(1, t);
    write(1, " left ");
    write_int(1, net_left[n]);
    print("")
}

test "a connection from the RP2040 to the flash fans out and routes clear" {
    test_load();
    a: int = pin_named("U1.QSPI_SS");
    b: int = pin_named("U2.CS");
    before_change();
    r: int = connect_pins(a, b, TOP);
    changed();
    print_bool(ro_ok[r]);
    say_net("QSPI_SS");
    write(1, "problems ");
    write_int(1, prob_n);
    print("");
    // (Its first segment is the fan-out: as wide as the pad, 0.2 mm.)
    first: int = -1;
    for k in 0..segs_n {
        if (sg_route[k] == r && first < 0) first = k
    }
    write(1, "fan-out ");
    line_clear();
    line_num(sg_w[first], 2);
    write_bytes_n(1, line, line_n);
    print("");
    undo();
    write(1, "after undo, routes ");
    write_int(1, routes_n);
    write(1, ", segments ");
    write_int(1, segs_n);
    print("");
    expect {|
        true
        QSPI_SS left 0
        problems 1
        fan-out 0.2
        after undo, routes 0, segments 2
    |}
}

test "a waypoint is gone through" {
    test_load();
    a: int = pin_named("C9.1");
    b: int = pin_named("U2.VCC");
    r: int = new_route(pin_net[a], a, b, TOP);
    insert_point(r, 1, snap_x(18.0), snap_y(14.0));
    print_bool(route_route(r, false));
    hit: bool = false;
    for k in 0..segs_n {
        if (sg_route[k] == r && seg_point(sg_x0[k], sg_y0[k], sg_x1[k], sg_y1[k],
            snap_x(18.0), snap_y(14.0)) < 0.001) hit = true
    }
    print_bool(hit);
    expect {|
        true
        true
    |}
}

test "ground poured on the bottom joins most of its pads, through vias in them" {
    test_load();
    say_net("GND");
    gnd: int = find_net(bytes("GND"), 0, 3);
    toggle_pour(gnd, BOTTOM);
    check_board();
    stitched: int = 0;
    for v in 0..vias_n {
        if (via_route[v] == VIA_POUR) stitched = stitched + 1
    }
    write(1, "stitching vias ");
    write_int(1, stitched);
    print("");
    say_net("GND");
    write(1, "problems ");
    write_int(1, prob_n);
    print("");
    expect {|
        GND left 78
        stitching vias 84
        GND left 6
        problems 1
    |}
}

// (A hard board, the first sketch, routed in one pass, with no repairs:
// what is laid breaks no rule. Its whole effort takes most of a minute,
// too near the tests' time; the designs' own tests route them in full.)
test "route all lays copper that breaks no rule" {
    test_load();
    job_passes_most = 0;
    job_repairs = false;
    start_route_all();
    while (job_on) step_job(1000000000);
    say_counts();
    expect {|
        parts 42, pins 239, nets joined 28 of 40, to connect 27, problems 1
    |}
}

// A board as its generator wrote it, from the board as kept: no copper,
// no pours, no routes but the generator's own (locked, not yet laid).
back_to_placed() {
    r: int = routes_n - 1;
    while (r >= 0) {
        if (ro_locked[r]) clear_route_copper(r) else delete_route(r);
        r = r - 1
    }
    s: int = segs_n - 1;
    while (s >= 0) {
        remove_seg(s);
        s = s - 1
    }
    v: int = vias_n - 1;
    while (v >= 0) {
        remove_via(v);
        v = v - 1
    }
    pour_net[TOP] = -1;
    pour_net[BOTTOM] = -1;
    make_pours();
    check_board()
}

// The handheld (programs/cad/handheld.pcb), as kept: routed whole and
// clean (by tools/finish.l8). Then back as its generator placed it, and
// Route all pressed once (it lays the generator's routes, and pours
// ground, first): whole and clean again.
test "the handheld, laid out for routing, routes whole and clean" {
    test_load_file("programs/cad/handheld.pcb");
    say_counts();
    back_to_placed();
    start_route_all();
    while (job_on) step_job(1000000000);
    say_counts();
    expect {|
        parts 90, pins 312, nets joined 65 of 65, to connect 0, problems 0
        parts 90, pins 312, nets joined 65 of 65, to connect 0, problems 0
    |}
}

test "a guide from the display's connector to the RP2040 routes its lines along it" {
    test_load();
    gx: []f32 = [0.0, 5.0, 6.0, 6.0, 3.0];
    gy: []f32 = [41.0, 37.0, 33.0, 20.0, 12.0];
    gd_n = 0;
    for k in 0..5 {
        gd_x[gd_n] = gx[k];
        gd_y[gd_n] = gy[k];
        gd_n = gd_n + 1;
        // (A stroke has many points between its corners.)
        if (k < 4) {
            for t in 1..8 {
                f: f32 = t as f32 / 8.0;
                gd_x[gd_n] = gx[k] + (gx[k + 1] - gx[k]) * f;
                gd_y[gd_n] = gy[k] + (gy[k + 1] - gy[k]) * f;
                gd_n = gd_n + 1
            }
        }
    }
    gd_drawing = true;
    first: int = routes_n;
    finish_guide();
    say_toast();
    for r in first..routes_n {
        line_clear();
        line_name(net_name[ro_net[r]]);
        line_add(" points ");
        line_int(ro_np[r]);
        line_add(" legs ");
        for k in 0..ro_np[r] - 1 {
            if (rl_ok[r * RPTS + k]) line_add("y") else line_add("n")
        }
        for k in 1..ro_np[r] - 1 {
            line_add(" (");
            line_num(rp_x[r * RPTS + k], 2);
            line_add(",");
            line_num(rp_y[r * RPTS + k], 2);
            line_add(")")
        }
        write_bytes_n(1, line, line_n);
        print("")
    }
    expect {|
        4 of 5 routed along the guide
        LCD_RESET points 6 legs yyyyy (3.8,36.5) (3.8,33.5) (4.8,32.5) (4.8,15.5)
        LCD_RS points 6 legs yyyyy (4.4,36.8) (4.4,33.8) (5.4,32.8) (5.4,15.2)
        LCD_SDA points 6 legs nnyyn (5,37) (5,34) (6,33) (6,15)
        LCD_SCK points 6 legs yyyyy (5.6,37.2) (5.6,34.2) (6.6,33.2) (6.6,14.8)
        LCD_CS points 6 legs yyyyy (6.2,37.5) (6.2,34.5) (7.2,33.5) (7.2,14.5)
    |}
}

test "clear, as far as asked: free routes, all routes, all copper; undo brings it back" {
    test_load();
    a: int = connect_pins(pin_named("U1.QSPI_SS"), pin_named("U2.CS"), TOP);
    b: int = connect_pins(pin_named("U1.QSPI_SCLK"), pin_named("U2.CLK"), TOP);
    ro_locked[a] = true;
    print_bool(b >= 0);
    gnd: int = find_net(bytes("GND"), 0, 3);
    toggle_pour(gnd, BOTTOM);
    check_board();
    for k in 0..3 {
        write_int(1, clear_count(k));
        write(1, " ")
    }
    print("");
    clear_copper(CLEAR_FREE);
    say_toast();
    clear_copper(CLEAR_ALL);
    say_toast();
    write(1, "routes ");
    write_int(1, routes_n);
    write(1, ", tracks ");
    write_int(1, segs_n);
    write(1, ", vias ");
    write_int(1, vias_n);
    print("");
    undo();
    undo();
    write(1, "after undoing both, routes ");
    write_int(1, routes_n);
    print("");
    expect "true\n1 2 5 \n1 route taken up; locked ones stay. Undo brings it back\nAll copper taken up. Undo brings it back\nroutes 0, tracks 0, vias 0\nafter undoing both, routes 2\n"
}

test "a pour keeps clear of copper laid after it" {
    test_load_file("programs/cad/handheld.pcb");
    // (From bare: the board as kept has its copper, and its pours.)
    clear_copper(CLEAR_ALL);
    gnd: int = find_net(bytes("GND"), 0, 3);
    toggle_pour(gnd, BOTTOM);
    check_board();
    // A track of another net on the bottom, through where the pour was.
    before_change();
    add_seg(-20.0, -20.0, 20.0, -20.0, 0.25, BOTTOM, find_net(bytes("BTN_A"), 0, 5));
    changed();
    // (No cell of the pour within the clearance of it.)
    near: int = 0;
    for i in cell_i(-20.0)..cell_i(20.0) + 1 {
        c: int = cell_j(-20.0) * gr_nx + i;
        if (pm[c * 2 + BOTTOM] == 1i8) near = near + 1
    }
    write(1, "pour cells on the track's line ");
    write_int(1, near);
    print("");
    expect {|
        pour cells on the track's line 0
    |}
}

// The handheld's case: its layers and the buttons' discs, no wood too thin,
// the bolts it wants, and the cut file's sheet.
test "the handheld's case is seven layers of plywood, with nothing too thin to cut" {
    test_load_file("programs/cad/handheld.pcb");
    walls: int = 0;
    for k in 0..prob_n {
        if (prob_kind[k] == PROB_WALL) walls = walls + 1
    }
    write(1, "layers ");
    write_int(1, layers_n);
    write(1, ", discs ");
    write_int(1, pieces_count - layers_n);
    write(1, ", thin walls ");
    write_int(1, walls);
    write(1, ", bolts M2.5 x ");
    write_int(1, bolt_length() as int);
    print("");
    write_case_svg(0);
    line_clear();
    line_add("sheet ");
    line_num(sheet_w, 1);
    line_add(" x ");
    line_num(sheet_h, 1);
    line_add(" mm");
    write_bytes_n(1, line, line_n);
    print("");
    expect {|
        layers 7, discs 34, thin walls 0, bolts M2.5 x 12
        sheet 785.3 x 113.7 mm
    |}
}

// What goes to the board house: the zip's files, and the lists for
// assembly (a line for each kind of part, and for each part placed).
test "the board house's files: Gerbers, drills, and the parts' lists" {
    test_load_file("programs/cad/handheld.pcb");
    write_fab();
    write(1, "files ");
    write_int(1, zip_files);
    print("");
    write_bom();
    bom: int = 0;
    for i in 0..fo_n {
        if (fo[i] == 10i8) bom = bom + 1
    }
    write_cpl();
    cpl: int = 0;
    for i in 0..fo_n {
        if (fo[i] == 10i8) cpl = cpl + 1
    }
    write(1, "BOM lines ");
    write_int(1, bom - 1);
    write(1, ", CPL lines ");
    write_int(1, cpl - 1);
    print("");
    write_bytes_n(1, fo, 40);
    print("");
    expect {|
        files 11
        BOM lines 35, CPL lines 76
        Designator,Mid X,Mid Y,Layer,Rotation
        U1
    |}
}

// The dock (programs/cad/dock.pcb): its board as kept, then routed again
// from bare.
test "the dock's board routes whole and clean" {
    test_load_file("programs/cad/dock.pcb");
    say_counts();
    back_to_placed();
    start_route_all();
    while (job_on) step_job(1000000000);
    say_counts();
    expect {|
        parts 65, pins 201, nets joined 42 of 42, to connect 0, problems 0
        parts 65, pins 201, nets joined 42 of 42, to connect 0, problems 0
    |}
}

// The dock's box: its layers and loose pieces (the lid's frame and top,
// the feet), no wood too thin, and how many sheets it is cut from.
test "the dock is a box of plywood layers with a lift-off lid, nothing too thin to cut" {
    test_load_file("programs/cad/dock.pcb");
    walls: int = 0;
    for k in 0..prob_n {
        if (prob_kind[k] == PROB_WALL) walls = walls + 1
    }
    write(1, "layers ");
    write_int(1, layers_n);
    write(1, ", pieces ");
    write_int(1, pieces_count - layers_n);
    write(1, ", thin walls ");
    write_int(1, walls);
    print("");
    line_clear();
    line_add("box ");
    line_num(case_w(), 1);
    line_add(" x ");
    line_num(case_h(), 1);
    line_add(" x ");
    line_num(stack_t(), 1);
    line_add(" mm, sheets ");
    line_int(cut_sheets());
    write_bytes_n(1, line, line_n);
    print("");
    expect {|
        layers 13, pieces 6, thin walls 0
        box 257 x 223.5 x 41.6 mm, sheets 5
    |}
}
