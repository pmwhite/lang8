tag cad;

use_tag std, gl, x11, skate;

// Where each part on a board comes from: for a footprint and a value, the
// manufacturer's part number and LCSC's (the number JLCPCB's assembly
// orders by), found in JLCPCB's parts library on 2026-10-15 and in stock
// then. "base" parts are JLCPCB's basic library (no setup fee), the rest
// its extended one. SRC_ROT turns a part from this library's way round to
// JLCPCB's, where they differ (to check in their placement preview).
//
// Parts not listed are not put on by the board house: test pads, holes.
