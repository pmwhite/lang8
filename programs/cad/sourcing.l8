// The line of the table part p comes from, or -1. (A value of "" in the
// table: any value.) Worked out once a board is read (src_known), as it is
// asked for every frame the parts list or the order is shown.
src_of: []int = new int[PARTS](-1);

src_known: bool = false;

source_of(p: int): int {
    if (!src_known) {
        for o in 0..parts_n src_of[o] = source_find(o);
        src_known = true
    }
    src_of[p]
}

source_find(p: int): int {
    for s in 0..len(SRC_FP) {
        if (fp_is(part_fp[p], SRC_FP[s])) {
            if (len(SRC_VALUE[s]) == 0) return s;
            if (part_value[p] >= 0 && name_is_str(part_value[p], SRC_VALUE[s])) return s
        }
    }
    -1
}
