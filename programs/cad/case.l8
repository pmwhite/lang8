tag cad;

use_tag std, gl, x11, skate;

// The case: what the board goes into, a stack of laser-cut plywood layers
// held by bolts through them, their heads sunk in the back, their nuts
// inside it. It is worked out from the board (its outline, where its
// buttons, sockets and tall parts are) and a few numbers in the board file
// (the `case` line): the plywood's thickness, how wide the rim round the
// board is, where the screen sits over the board, and where the battery
// lies under it. Change the board and the case follows.
//
// Heights are in millimetres from the board's top face (its parts stand on
// z = 0; the board itself is z = -brd_t to 0). From the back:
//
//   Back       glued to the next two, the three one piece; the bolts'
//              heads sunk through it and the next, bearing on the second
//              battery layer
//   Battery 1  a pocket for the battery, and the wireless receiver's
//   Battery 2  the pocket, a channel for its wire to the board's hole,
//              room for the pins of through-hole parts under the board
//   Board      the board sits in it, its back on the layer under it: foam
//              on the battery presses it up against its posts
//   Spacer     over the board, the ply less the board's thickness above
//              it (2 mm, the board 1.2): holes where its parts stand taller
//              than that, the buttons' stems (as wide as their flanges),
//              the lights; the screen rests on it, and posts on the board,
//              as tall as the gap, bear on it at the corners
//   Screen     the screen lies in it, and the buttons' flanges; the
//              bolts' nuts glued in hexes in it, under the front, bearing
//              on the spacer: the bolts clamp wood to wood, the board's
//              layer in the clamp, and the front's block is held by the
//              nuts glued in it
//   Front      glued to the one under it: the window onto the screen (a
//              clear acrylic sheet) and the buttons' caps; nothing else
//
// Each button is a stack of discs on a tactile switch (1.7 mm tall, 0.3
// less than the gap under the spacer; the D-pad's 1.5, 0.5 less, for it
// to rock): a stem through the spacer, a flange (wider: it stops the
// button at the front's back face), and a cap through the front and
// standing out of it. The flange's hole goes down through the spacer too,
// so a press goes into the switch.
cs_on: bool = false;

cs_ply: f32 = 3.2;

cs_rim: f32 = 9.0;

// The rim at the bottom edge (the `case` line's ninth word; else cs_rim):
// deeper, for room under the buttons.
cs_rim_bottom: f32 = 9.0;

cs_screen_x: f32 = 0.0;

cs_screen_y: f32 = 38.0;

cs_batt_x: f32 = 0.0;

cs_batt_y: f32 = -20.0;

cs_batt_turned: bool = false;

// A wireless charging receiver (the board file's `qi X Y` line): its coil
// against the back, under the board, its middle at qi_x, qi_y. (Adafruit
// 1901: 5 V at 500 mA from a Qi pad, a 48 x 32 mm panel, 1.8 mm thick
// with its chip.)
qi_on: bool = false;

qi_x: f32 = 0.0;

qi_y: f32 = 0.0;

const QI_W: f32 = 48.0;

const QI_H: f32 = 32.0;

const QI_T: f32 = 1.8;

// The battery's size across and up the board, as it lies.
batt_w(): f32 {
    if (cs_batt_turned) return BATT_L;
    BATT_W
}

batt_l(): f32 {
    if (cs_batt_turned) return BATT_W;
    BATT_L
}

// The screen module (Newhaven NHD-2.8-240320AF-CSXP-F, on its side), from
// its datasheet: its outline, its thickness, the part of it that shows
// (the active area, the window half a millimetre bigger all round), and
// how far that is from the module's middle (toward the end its flex does
// not leave). Its flex leaves the right end (SCREEN_FLEX_SIDE), in the
// middle, 20.5 mm wide, and folds back under it, contacts up, contact 1 at
// the bottom: its end comes about 28 mm in from that edge, to the board's
// connector there.
const SCREEN_W: f32 = 69.2;

const SCREEN_H: f32 = 50.0;

const SCREEN_T: f32 = 2.39;

const SCREEN_VA_W: f32 = 58.6;

const SCREEN_VA_H: f32 = 44.2;

const SCREEN_VA_DX: f32 = -2.75;

const SCREEN_FLEX_SIDE: f32 = 1.0;

const SCREEN_VA_DY: f32 = 0.0;

const SCREEN_FLEX_W: f32 = 20.5;

// (Room for the flex's fold, past the module's end.)
const SCREEN_FOLD: f32 = 1.8;

// The battery (Adafruit 258: a 1200 mAh 1S LiPo pouch, its plug on a short
// wire), upright or (cs_batt_turned) on its side.
const BATT_W: f32 = 34.0;

const BATT_L: f32 = 62.0;

const BATT_T: f32 = 5.0;

// The bolts: M2.5 pan heads (steel), sunk through the back and the first
// battery layer, bearing on the second; hex nuts glued in pockets in the
// screen's layer, the front over them, bearing on the spacer: nothing of
// them shows on the front, and they go in last, from the back.
const BOLT_HOLE: f32 = 2.8;

const NUT_AF: f32 = 5.0;

const NUT_T: f32 = 2.0;

const HEAD_D: f32 = 5.0;

const HEAD_T: f32 = 1.8;

// ---- shapes ----
// Each piece is an outline (its first shape) and the holes cut in it; a
// shape is a box with round corners, a circle, or a hexagon (by the
// distance across its flats, two of them level).
const SH_BOX: int = 0;

const SH_CIRCLE: int = 1;

const SH_HEX: int = 2;

// A cross: two arms, as long as the box (hw = hh, from its middle) and as
// wide as twice r, at right angles.
const SH_CROSS: int = 3;

// A triangle (engraved, as an arrow's mark): half its base hw, half its
// height hh, pointing (r) up 0, right 1, down 2, left 3.
const SH_TRI: int = 4;

const SHAPES: int = 2048;

sh_kind: []int = new int[SHAPES](0);

sh_x: []f32 = new f32[SHAPES](0.0);

sh_y: []f32 = new f32[SHAPES](0.0);

sh_hw: []f32 = new f32[SHAPES](0.0);

sh_hh: []f32 = new f32[SHAPES](0.0);

sh_r: []f32 = new f32[SHAPES](0.0);

sh_n: int = 0;

// Whether a shape is an engraving (marked on the wood's face, not cut
// through), not a hole.
sh_engrave: []bool = new bool[SHAPES](false);

// What each hole is for, said when it is tapped (cs_what as it is made).
sh_what: []str = new str[SHAPES]("");

cs_what: str = "";

// Whether a hole must stand in wood of its own (a bolt's, a dowel's, a
// magnet's): the check takes another hole that runs into it for a fault,
// not one hole with it.
sh_keep: []bool = new bool[SHAPES](false);

// Whether a hole is meant to open through the piece's edge (a tongue's
// notch, a slot out to the side): the check takes any other hole that
// reaches the edge for a wall too thin.
sh_open: []bool = new bool[SHAPES](false);

// Pieces: the layers, then the loose ones (the buttons' discs). Each
// has a name, the height of its back face, where it sits (a layer at 0, 0;
// a disc over its button) and its shapes, in those coordinates.
const PIECES: int = 256;

pc_name: []str = new str[PIECES]("");

pc_z: []f32 = new f32[PIECES](0.0);

pc_x: []f32 = new f32[PIECES](0.0);

pc_y: []f32 = new f32[PIECES](0.0);

pc_first: []int = new int[PIECES](0);

pc_n: []int = new int[PIECES](0);

pc_layer: []bool = new bool[PIECES](false);

// What it is cut from (0 the plywood, PC_ACRYLIC clear acrylic), and
// whether it is laid face down (its engraving on the outside of the back:
// the cut file has it mirrored, so that turned over it fits).
const PC_PLY: int = 0;

const PC_ACRYLIC: int = 1;

pc_material: []int = new int[PIECES](0);

pc_flip: []bool = new bool[PIECES](false);

pieces_count: int = 0;

// How many of the pieces are layers.
layers_n: int = 0;

begin_piece(
    name: str@immortal,
    z: f32,
    x: f32,
    y: f32,
    layer: bool
) {
    if (pieces_count >= PIECES) return;
    pc_name[pieces_count] = name;
    pc_z[pieces_count] = z;
    pc_x[pieces_count] = x;
    pc_y[pieces_count] = y;
    pc_first[pieces_count] = sh_n;
    pc_n[pieces_count] = 0;
    pc_layer[pieces_count] = layer;
    pc_material[pieces_count] = PC_PLY;
    pc_flip[pieces_count] = false;
    pieces_count = pieces_count + 1
}

add_shape(
    kind: int,
    x: f32,
    y: f32,
    hw: f32,
    hh: f32,
    r: f32
) {
    if (sh_n >= SHAPES || pieces_count == 0) return;
    sh_kind[sh_n] = kind;
    sh_x[sh_n] = x;
    sh_y[sh_n] = y;
    sh_hw[sh_n] = hw;
    sh_hh[sh_n] = hh;
    sh_r[sh_n] = minf(r, minf(hw, hh));
    sh_engrave[sh_n] = false;
    sh_what[sh_n] = cs_what;
    sh_keep[sh_n] = false;
    sh_open[sh_n] = false;
    sh_n = sh_n + 1;
    pc_n[pieces_count - 1] = pc_n[pieces_count - 1] + 1
}

add_box(
    x: f32,
    y: f32,
    hw: f32,
    hh: f32,
    r: f32
) {
    add_shape(SH_BOX, x, y, hw, hh, r)
}

// A cross, its arms reaching arm from its middle, half_w either side.
add_cross(
    x: f32,
    y: f32,
    arm: f32,
    half_w: f32
) {
    add_shape(SH_CROSS, x, y, arm, arm, half_w)
}

// The last shape added, an engraving.
engrave_last() {
    if (sh_n > 0) sh_engrave[sh_n - 1] = true
}

// The last shape added, a hole that must stand in wood of its own.
keep_last() {
    if (sh_n > 0) sh_keep[sh_n - 1] = true
}

// The last shape added, a hole open through the piece's edge.
open_last() {
    if (sh_n > 0) sh_open[sh_n - 1] = true
}

add_circle(x: f32, y: f32, d: f32) {
    add_shape(SH_CIRCLE, x, y, d * 0.5, d * 0.5, d * 0.5)
}

add_tri(
    x: f32,
    y: f32,
    hw: f32,
    hh: f32,
    way: int
) {
    add_shape(SH_TRI, x, y, hw, hh, 0.0);
    // (Its way kept as it is: add_shape keeps a radius no bigger than the
    // shape.)
    if (sh_n > 0) sh_r[sh_n - 1] = way as f32
}

// Triangle k's corner i (0 its tip, then its base's two), in its piece's
// coordinates: anticlockwise.
tri_x(k: int, i: int): f32 {
    u: f32 = 0.0;
    v: f32 = sh_hh[k];
    if (i == 1) {
        u = -sh_hw[k];
        v = -sh_hh[k]
    }
    if (i == 2) {
        u = sh_hw[k];
        v = -sh_hh[k]
    }
    w: int = sh_r[k] as int;
    if (w == 1) return sh_x[k] + v;
    if (w == 2) return sh_x[k] - u;
    if (w == 3) return sh_x[k] - v;
    sh_x[k] + u
}

tri_y(k: int, i: int): f32 {
    u: f32 = 0.0;
    v: f32 = sh_hh[k];
    if (i == 1) {
        u = -sh_hw[k];
        v = -sh_hh[k]
    }
    if (i == 2) {
        u = sh_hw[k];
        v = -sh_hh[k]
    }
    w: int = sh_r[k] as int;
    if (w == 1) return sh_y[k] - u;
    if (w == 2) return sh_y[k] - v;
    if (w == 3) return sh_y[k] + u;
    sh_y[k] + v
}

add_hex(x: f32, y: f32, af: f32) {
    // (Across its corners, 2 / sqrt 3 of across its flats.)
    add_shape(SH_HEX, x, y, af * 0.57735, af * 0.5, 0.0)
}

// ---- the case's things ----
// The rim on each edge of the board (0 right, 1 top, 2 left, 3 bottom):
// thin (2 mm, as thin as holds) where a part is reached through the side,
// a socket or a switch, so that the board's tongue under it reaches out
// as little as it can; else cs_rim.
const THIN_RIM: f32 = 2.0;

rim_of(e: int): f32 {
    for p in 0..parts_n {
        if (on_edge(p) && edge_of(p) == e) return THIN_RIM
    }
    if (e == 3) return cs_rim_bottom;
    cs_rim
}

// The case's outline: its edges, size and middle. (A dock's: its own,
// the board somewhere inside it; see dock.l8.)
case_x0(): f32 {
    if (dock_on) return dk_ox() - dk_ow() * 0.5 - dk_bx;
    -brd_w * 0.5 - rim_of(2)
}

case_x1(): f32 {
    if (dock_on) return dk_ox() + dk_ow() * 0.5 - dk_bx;
    brd_w * 0.5 + rim_of(0)
}

case_y0(): f32 {
    if (dock_on) return dk_yf() - dk_by;
    -brd_h * 0.5 - rim_of(3)
}

case_y1(): f32 {
    if (dock_on) return dk_yb() - dk_by;
    brd_h * 0.5 + rim_of(1)
}

case_w(): f32 {
    case_x1() - case_x0()
}

case_h(): f32 {
    case_y1() - case_y0()
}

// Its corners' radius: the board's and the thinnest rim's.
case_r(): f32 {
    if (dock_on) return DK_CORNER;
    brd_r + minf(minf(rim_of(0), rim_of(1)), minf(rim_of(2), rim_of(3)))
}

// The bolts: in the middle of the rim, at the corners (halfway round
// each corner's curve) and halfway up the long sides.
const BOLTS: int = 6;

// Where bolt k goes: through the board's mounting holes, if it has any
// (then the rim can be thin all round); else in the rim.
bolts_n(): int {
    n: int = 0;
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "mh25")) n = n + 1
    }
    if (n > 0) return n;
    BOLTS
}

mount_hole(k: int): int {
    n: int = 0;
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "mh25")) {
            if (n == k) return p;
            n = n + 1
        }
    }
    -1
}

bolt_x(k: int): f32 {
    h: int = mount_hole(k);
    if (h >= 0) return part_x[h];
    rim_bolt_x(k)
}

bolt_y(k: int): f32 {
    h: int = mount_hole(k);
    if (h >= 0) return part_y[h];
    rim_bolt_y(k)
}

// (A corner where the rim across the end is thin has its bolt up the
// side's rim instead, 6 mm in from the board's corner.)
rim_bolt_x(k: int): f32 {
    e: int = 0;
    if (k % 2 == 0) e = 2;
    sx: f32 = 1.0;
    if (e == 2) sx = -1.0;
    side: f32 = sx * (brd_w * 0.5 + rim_of(e) * 0.5);
    if (k == 2 || k == 3 || corner_thin(k)) return side;
    r: f32 = case_r();
    cx: f32 = case_x1() - r;
    if (e == 2) cx = case_x0() + r;
    cx + sx * (r - cs_rim * 0.5) * 0.70710678
}

rim_bolt_y(k: int): f32 {
    if (k == 2 || k == 3) return 0.0;
    sy: f32 = 1.0;
    if (k >= 4) sy = -1.0;
    if (corner_thin(k)) return sy * (brd_h * 0.5 - 6.0);
    r: f32 = case_r();
    cy: f32 = case_y1() - r;
    if (sy < 0.0) cy = case_y0() + r;
    cy + sy * (r - cs_rim * 0.5) * 0.70710678
}

// Whether corner bolt k's end of the case has a thin rim across it.
corner_thin(k: int): bool {
    if (k < 2) return rim_of(1) < cs_rim;
    k >= 4 && rim_of(3) < cs_rim
}

// How tall the parts of a footprint stand off the board, from their
// datasheets (a part not listed: 1 mm).
part_height(p: int): f32 {
    f: int = part_fp[p];
    if (fp_is(f, "usb4105")) return 3.31;
    if (fp_is(f, "ss12d00")) return 7.5;
    if (fp_is(f, "pcm12")) return 1.4;
    if (fp_is(f, "esp32s3")) return 3.1;
    if (fp_is(f, "sod123")) return 1.35;
    if (fp_is(f, "jst-ph2")) return 6.0;
    if (fp_is(f, "fpc14")) return 1.0;
    if (fp_is(f, "fpc40")) return 2.0;
    if (fp_is(f, "w25q16")) return 1.75;
    if (fp_is(f, "tact5")) return 1.5;
    if (fp_is(f, "tact5h")) return 1.7;
    if (fp_is(f, "jst-ph2sm")) return 4.6;
    if (fp_is(f, "post3015")) return 1.5;
    if (fp_is(f, "post4020")) return 2.0;
    if (fp_is(f, "jst-ph2s")) return 4.8;
    if (fp_is(f, "ledside")) return 0.6;
    if (fp_is(f, "led0603")) return 0.8;
    if (fp_is(f, "sot23-5") || fp_is(f, "sot23-5i") || fp_is(f, "sot23-5o") || fp_is(f,
        "sot23-6")) return 1.45;
    if (fp_is(f, "sot23") || fp_is(f, "sot23r")) return 1.1;
    if (fp_is(f, "soic14")) return 1.75;
    if (fp_is(f, "r0603") || fp_is(f, "c0603") || fp_is(f, "r1206")) return 0.9;
    if (fp_is(f, "wirehole") || fp_is(f, "mh25") || fp_is(f, "tph")) return 0.0;
    if (fp_is(f, "tp1")) return 0.1;
    1.0
}

// (Compared in place: this is called thousands of times a frame, and must
// make nothing new each time.)
fp_is(f: int, key: str): bool {
    name_is_str(fp_key[f], key)
}

is_button(p: int): bool {
    fp_is(part_fp[p], "tact5") || fp_is(part_fp[p], "tact5h")
}

// A post: bears on the wood over the board (it gets no hole).
is_post(p: int): bool {
    fp_is(part_fp[p], "post3015") || fp_is(part_fp[p], "post4020")
}

// A button's cap: as wide as its neighbours leave room for, 8 mm at most.
// (The buttons crowded to the least, a D-pad's, as small as a cap may be;
// the rest all one size, so A is not bigger than B: the widest each of
// them has room for.)
cap_d(p: int): f32 {
    // (The flush buttons, power, Home and Back: small, not to be pressed
    // by chance, and not to be taken for the face buttons.)
    if (is_flush(p)) return FLUSH_CAP;
    d: f32 = cap_room(p);
    if (d <= 5.0) return d;
    // (One size within its kind: the arrows all alike, the face buttons
    // all alike.)
    for o in 0..parts_n {
        if (is_button(o) && !in_dpad(o) && !is_flush(o) && is_arrow(o) == is_arrow(p) && cap_room(o) > 5.0) d = minf(d,
            cap_room(o))
    }
    d
}

// (A flush cap's size: 6 mm, the smallest piece Ponoko cuts.)
const FLUSH_CAP: f32 = 6.0;

// Whether button p is one of the four arrows (up, down, left, right).
is_arrow(p: int): bool {
    value_is(p, "UP") || value_is(p, "DOWN") || value_is(p, "LEFT") || value_is(p,
        "RIGHT")
}

// How wide a cap button p has room for (its flange's hole is 2.2 mm
// wider, and the wood between flanges' holes must hold): beside a
// button its size, half of what is between them each; beside a flush
// one, the rest of it.
cap_room(p: int): f32 {
    room: f32 = 8.0;
    for o in 0..parts_n {
        if (o != p && is_button(o)) {
            dx: f32 = part_x[o] - part_x[p];
            dy: f32 = part_y[o] - part_y[p];
            dist: f32 = sqrtf(dx * dx + dy * dy);
            r: f32 = dist - 2.2 - WALL_MIN - 0.1;
            if (is_flush(o)) r = 2.0 * (dist - WALL_MIN - 0.1) - FLUSH_CAP - 4.4;
            room = minf(room, r)
        }
    }
    clampf(room, 5.0, 8.0)
}

// (Big enough not to fall through the laser's bed.)
const STEM_D: f32 = 6.0;

const LED_HOLE: f32 = 1.6;

// The z where the stack's layers begin: the back's back face.
stack_z0(): f32 {
    if (dock_on) return -brd_t - cs_ply;
    -brd_t - 3.0 * cs_ply
}

// The layers' order, from the back.
const L_BACK: int = 0;

const L_BATT1: int = 1;

const L_BATT2: int = 2;

const L_BOARD: int = 3;

const L_SPACER: int = 4;

const L_SCREEN: int = 5;

const L_FRONT: int = 6;

const LAYERS: int = 7;

layer_z(l: int): f32 {
    stack_z0() + l as f32 * cs_ply
}

// The whole stack's height, and the bolt it wants: the shortest of the
// lengths sold (steel, at DigiKey: see order.l8) that goes all through
// its nut, from its head (under the second battery layer) to the nut's top
// (on the spacer), and no farther than the front's back face.
stack_t(): f32 {
    if (dock_on) return layers_n as f32 * cs_ply;
    LAYERS as f32 * cs_ply
}

BOLT_LENGTHS: []f32 = [4.0, 6.0, 12.0, 16.0];

bolt_length(): f32 {
    want: f32 = layer_z(L_SCREEN) + NUT_T - layer_z(L_BATT2);
    most: f32 = layer_z(L_FRONT) - layer_z(L_BATT2);
    for k in 0..len(BOLT_LENGTHS) {
        if (BOLT_LENGTHS[k] >= want && BOLT_LENGTHS[k] <= most) return BOLT_LENGTHS[k]
    }
    want
}

// The layer's outline and its bolt holes: the heads' in the back, the
// nuts' hexes in the spacer; none in the front.
layer_begin(l: int, name: str@immortal) {
    begin_piece(name, layer_z(l), 0.0, 0.0, true);
    add_box((case_x0() + case_x1()) * 0.5, (case_y0() + case_y1()) * 0.5, case_w() * 0.5,
        case_h() * 0.5, case_r());
    if (l == L_FRONT) return;
    cs_what = "A bolt, through the case";
    if (l == L_SCREEN) cs_what = "A bolt's nut, in its hex, the front over it: it bears on the spacer";
    if (l == L_BACK || l == L_BATT1) cs_what = "A bolt's head, sunk through the back and the first battery layer";
    for k in 0..bolts_n() {
        if (l == L_SCREEN) add_hex(bolt_x(k), bolt_y(k), NUT_AF + 0.15) else if (l == L_BACK || l == L_BATT1) add_circle(bolt_x(k),
            bolt_y(k), HEAD_D + 0.6) else add_circle(bolt_x(k), bolt_y(k), BOLT_HOLE);
        // (In wood of its own, but in the board's layer, whose pocket the
        // board, with its holes, fills.)
        if (l != L_BOARD) keep_last()
    }
}

// Whether a part's height reaches into layer l, or within 0.15 mm of it.
reaches(p: int, l: int): bool {
    part_height(p) > layer_z(l) - 0.15 && !is_post(p)
}

// The board's pocket, with 0.2 mm all round.
board_pocket() {
    cs_what = "The board";
    add_box(0.0, 0.0, brd_w * 0.5 + 0.2, brd_h * 0.5 + 0.2, brd_r + 0.2)
}

// Whether part p is reached through the case's side: the USB socket, a
// side switch; a dock's lights.
on_edge(p: int): bool {
    if (fp_is(part_fp[p], "usb4105") || fp_is(part_fp[p], "pcm12")) return true;
    // (A light at a dock's board's edge, showing through the dock's side.)
    dock_on && fp_is(part_fp[p], "ledside") && edge_gap(p) < 2.5
}

// How far part p's middle is from the board's nearest edge.
edge_gap(p: int): f32 {
    minf(brd_w * 0.5 - absf(part_x[p]), brd_h * 0.5 - absf(part_y[p]))
}

// ---- tongues ----
// Under each part reached through the case's side, the board reaches out
// in a tongue across the rim to the case's outside, so that the part sits
// flush with it, held all the way: the wood is cut round the tongue and
// the part. A tongue: its edge (as edge_of), its span along that edge
// (a0 to a1), and how far out it reaches past the board's edge.
const TONGUES: int = 8;

tg_e: []int = new int[TONGUES](0);

tg_a0: []f32 = new f32[TONGUES](0.0);

tg_a1: []f32 = new f32[TONGUES](0.0);

tg_d: []f32 = new f32[TONGUES](0.0);

tg_part: []int = new int[TONGUES](0);

tg_n: int = 0;

// The tongues, worked out again (only while there is a case).
find_tongues() {
    tg_n = 0;
    if (!cs_on) return;
    for p in 0..parts_n {
        if (on_edge(p) && tg_n < TONGUES) {
            e: int = edge_of(p);
            tg_e[tg_n] = e;
            // (Half a millimetre past its courtyard each side: its copper
            // keeps 0.3 mm in from the tongue's sides.)
            if (e == 1 || e == 3) {
                tg_a0[tg_n] = court_x0(p) - 0.5;
                tg_a1[tg_n] = court_x1(p) + 0.5
            } else {
                tg_a0[tg_n] = court_y0(p) - 0.5;
                tg_a1[tg_n] = court_y1(p) + 0.5
            }
            // (Out to the case's outside on that edge.)
            tg_d[tg_n] = case_x1() - brd_w * 0.5;
            if (e == 1) tg_d[tg_n] = case_y1() - brd_h * 0.5;
            if (e == 2) tg_d[tg_n] = -brd_w * 0.5 - case_x0();
            if (e == 3) tg_d[tg_n] = -brd_h * 0.5 - case_y0();
            tg_part[tg_n] = p;
            tg_n = tg_n + 1
        }
    }
}

// Tongue k as a box (in tg_box_*), grown by m all round.
tg_box_x0: f32 = 0.0;

tg_box_y0: f32 = 0.0;

tg_box_x1: f32 = 0.0;

tg_box_y1: f32 = 0.0;

tongue_box(k: int, m: f32) {
    e: int = tg_e[k];
    hw: f32 = brd_w * 0.5;
    hh: f32 = brd_h * 0.5;
    if (e == 1 || e == 3) {
        tg_box_x0 = tg_a0[k] - m;
        tg_box_x1 = tg_a1[k] + m;
        if (e == 1) {
            tg_box_y0 = hh - m;
            tg_box_y1 = hh + tg_d[k] + m
        } else {
            tg_box_y0 = -hh - tg_d[k] - m;
            tg_box_y1 = -hh + m
        }
    } else {
        tg_box_y0 = tg_a0[k] - m;
        tg_box_y1 = tg_a1[k] + m;
        if (e == 0) {
            tg_box_x0 = hw - m;
            tg_box_x1 = hw + tg_d[k] + m
        } else {
            tg_box_x0 = -hw - tg_d[k] - m;
            tg_box_x1 = -hw + m
        }
    }
}

// Whether a box of copper keeps 0.3 mm inside the board, its tongues
// counted.
inside_board(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): bool {
    hx: f32 = brd_w * 0.5 - 0.3;
    hy: f32 = brd_h * 0.5 - 0.3;
    // (How far it may go each way: the board's edge, or a tongue's end
    // where it is all within the tongue's span.)
    lx0: f32 = -hx;
    lx1: f32 = hx;
    ly0: f32 = -hy;
    ly1: f32 = hy;
    for k in 0..tg_n {
        e: int = tg_e[k];
        if ((e == 1 || e == 3) && x0 >= tg_a0[k] + 0.3 && x1 <= tg_a1[k] - 0.3) {
            if (e == 1) ly1 = hy + tg_d[k] else ly0 = -hy - tg_d[k]
        }
        if ((e == 0 || e == 2) && y0 >= tg_a0[k] + 0.3 && y1 <= tg_a1[k] - 0.3) {
            if (e == 0) lx1 = hx + tg_d[k] else lx0 = -hx - tg_d[k]
        }
    }
    x0 >= lx0 && x1 <= lx1 && y0 >= ly0 && y1 <= ly1
}

// Where a part on the board's edge (a socket, a switch) meets it: which
// edge (0 right, 1 top, 2 left, 3 bottom), from the part's middle.
edge_of(p: int): int {
    dx: f32 = brd_w * 0.5 - absf(part_x[p]);
    dy: f32 = brd_h * 0.5 - absf(part_y[p]);
    if (dx < dy) {
        if (part_x[p] > 0.0) return 0;
        return 2
    }
    if (part_y[p] > 0.0) return 1;
    3
}

// A notch through the rim for tongue k (and what is on it), 0.2 mm bigger
// than it each side for the fit, out past the outside.
edge_notch(k: int) {
    cs_what = "A notch out to the side, for a part at the board's edge";
    tongue_box(k, 0.2);
    // (A side switch's: 2.5 mm wider each side, for a fingertip to its
    // knob.)
    if (fp_is(part_fp[tg_part[k]], "pcm12")) {
        if (tg_e[k] == 1 || tg_e[k] == 3) {
            tg_box_x0 = tg_box_x0 - 2.5;
            tg_box_x1 = tg_box_x1 + 2.5
        } else {
            tg_box_y0 = tg_box_y0 - 2.5;
            tg_box_y1 = tg_box_y1 + 2.5
        }
    }
    x0: f32 = tg_box_x0;
    y0: f32 = tg_box_y0;
    x1: f32 = tg_box_x1;
    y1: f32 = tg_box_y1;
    e: int = tg_e[k];
    if (e == 0) x1 = x1 + 1.0;
    if (e == 1) y1 = y1 + 1.0;
    if (e == 2) x0 = x0 - 1.0;
    if (e == 3) y0 = y0 - 1.0;
    add_box((x0 + x1) * 0.5, (y0 + y1) * 0.5, (x1 - x0) * 0.5, (y1 - y0) * 0.5, 0.0);
    open_last()
}

// The test points' extent (tph_n: how many), for the sticker's frame.
tph_x0: f32 = 0.0;

tph_y0: f32 = 0.0;

tph_x1: f32 = 0.0;

tph_y1: f32 = 0.0;

tph_n(): int {
    n: int = 0;
    tph_x0 = 1000.0;
    tph_y0 = 1000.0;
    tph_x1 = -1000.0;
    tph_y1 = -1000.0;
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "tph")) {
            n = n + 1;
            tph_x0 = minf(tph_x0, part_x[p]);
            tph_y0 = minf(tph_y0, part_y[p]);
            tph_x1 = maxf(tph_x1, part_x[p]);
            tph_y1 = maxf(tph_y1, part_y[p])
        }
    }
    n
}

// The window under the board's test points (its "tph" parts): a square
// round each, the squares one hole.
test_window() {
    cs_what = "The test points' window, for a jig's pins (a sticker over it)";
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "tph")) add_box(part_x[p], part_y[p], 1.45, 1.45, 0.5)
    }
}

// The battery's pocket, 1 mm bigger all round; and at the end its lead
// leaves (the end nearer where its wire goes up through the board), a bay
// 4 mm deeper, all across it (the lead may leave anywhere along that end),
// for the lead's bend and its slack: from there
// the wire lies back over the battery to the hole (1.4 mm over it under
// the board; the foam beside it, not on it).
const BATT_BAY: f32 = 4.0;

batt_pocket() {
    cs_what = "The battery";
    add_box(cs_batt_x, cs_batt_y, batt_w() * 0.5 + 1.0, batt_l() * 0.5 + 1.0, 1.5);
    cs_what = "The battery's lead, where it leaves the battery, and its slack";
    h: int = nearest_hole(cs_batt_x, cs_batt_y, -1);
    if (h < 0) return;
    if (cs_batt_turned) {
        sx: f32 = 1.0;
        if (part_x[h] < cs_batt_x) sx = -1.0;
        x: f32 = cs_batt_x + sx * (batt_w() * 0.5 + 1.0 + BATT_BAY * 0.5 - 0.5);
        add_box(x, cs_batt_y, BATT_BAY * 0.5 + 0.5, batt_l() * 0.5 + 1.0, 1.0)
    } else {
        sy: f32 = 1.0;
        if (part_y[h] < cs_batt_y) sy = -1.0;
        y: f32 = cs_batt_y + sy * (batt_l() * 0.5 + 1.0 + BATT_BAY * 0.5 - 0.5);
        add_box(cs_batt_x, y, batt_w() * 0.5 + 1.0, BATT_BAY * 0.5 + 0.5, 1.0)
    }
}

// The battery plug's socket, and where its wire comes up past the board's
// edge (nearest the socket).
plug_part(): int {
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "jst-ph2") || fp_is(part_fp[p], "jst-ph2s") || fp_is(part_fp[p],
            "jst-ph2sm")) return p
    }
    -1
}

wire_x: f32 = 0.0;

wire_y: f32 = 0.0;

// (Or, if the board has a hole for it, up through that.)
wire_through: bool = false;

// The wireless receiver's wires' pads, up through the board, or -1.
qi_hole: int = -1;

// The holes the wireless receiver's wires come up into, from under the
// board: its pads' (soldered from below), nearest it; or -1.
nearest_qi_pads(): int {
    best: int = -1;
    bd: f32 = 0.0;
    for h in 0..parts_n {
        if (fp_is(part_fp[h], "pads2")) {
            d: f32 = (part_x[h] - qi_x) * (part_x[h] - qi_x) + (part_y[h] - qi_y) * (part_y[h] - qi_y);
            if (best < 0 || d < bd) {
                best = h;
                bd = d
            }
        }
    }
    best
}

// The wire hole nearest (x, y), other than part but, or -1.
nearest_hole(x: f32, y: f32, but: int): int {
    best: int = -1;
    bd: f32 = 0.0;
    for h in 0..parts_n {
        if (h != but && fp_is(part_fp[h], "wirehole")) {
            d: f32 = (part_x[h] - x) * (part_x[h] - x) + (part_y[h] - y) * (part_y[h] - y);
            if (best < 0 || d < bd) {
                best = h;
                bd = d
            }
        }
    }
    best
}

find_wire_way() {
    p: int = plug_part();
    wire_x = cs_batt_x;
    wire_y = cs_batt_y;
    wire_through = false;
    // (The hole nearest the battery is its; the one nearest the wireless
    // receiver, the receiver's.)
    h: int = nearest_hole(cs_batt_x, cs_batt_y, -1);
    qi_hole = -1;
    if (qi_on) qi_hole = nearest_qi_pads();
    if (h >= 0) {
        wire_x = part_x[h];
        wire_y = part_y[h];
        wire_through = true;
        return
    }
    if (p < 0) return;
    e: int = edge_of(p);
    wire_x = part_x[p];
    wire_y = part_y[p];
    if (e == 0) wire_x = brd_w * 0.5 + 1.5;
    if (e == 2) wire_x = -brd_w * 0.5 - 1.5;
    if (e == 1) wire_y = brd_h * 0.5 + 1.5;
    if (e == 3) wire_y = -brd_h * 0.5 - 1.5
}

make_case() {
    cm_drawn = false;
    v3_dirty = true;
    sh_n = 0;
    pieces_count = 0;
    if (!cs_on) {
        layers_n = 0;
        return
    }
    if (dock_on) {
        make_dock();
        return
    }
    find_wire_way();
    sx: f32 = cs_screen_x;
    sy: f32 = cs_screen_y;
    // Back: and a window to the test points, for a jig's pogo pins (under a
    // sticker), through the battery layers too.
    layer_begin(L_BACK, "Back");
    test_window();
    // (Engraved where the wireless receiver's coil is, to find it on a
    // charging pad: a ring as wide as the coil, and its middle.)
    if (qi_on) {
        add_box(qi_x, qi_y, 20.0, 14.5, 3.0);
        engrave_last();
        add_circle(qi_x, qi_y, 4.0);
        engrave_last()
    }
    // (And a frame round the test points' window, where its sticker goes.)
    if (tph_n() > 0) {
        add_box((tph_x0 + tph_x1) * 0.5, (tph_y0 + tph_y1) * 0.5, (tph_x1 - tph_x0) * 0.5 + 3.5,
            (tph_y1 - tph_y0) * 0.5 + 3.5, 1.5);
        engrave_last()
    }
    // Battery 1 and 2.
    layer_begin(L_BATT1, "Battery 1");
    batt_pocket();
    test_window();
    // (The wireless receiver lies here, its coil against the back: as near
    // the charging pad under it as the back lets it be.)
    cs_what = "The wireless charging receiver, its coil against the back";
    if (qi_on) add_box(qi_x, qi_y, QI_W * 0.5 + 0.5, QI_H * 0.5 + 0.5, 1.0);
    layer_begin(L_BATT2, "Battery 2");
    batt_pocket();
    test_window();
    cs_what = "The receiver's wires' way up to the board";
    // (Its wires' way up to their hole in the board: from its middle,
    // level, then up.)
    if (qi_on && qi_hole >= 0) {
        hx: f32 = part_x[qi_hole];
        hy: f32 = part_y[qi_hole];
        add_box((qi_x + hx) * 0.5, qi_y, absf(hx - qi_x) * 0.5 + 1.5, 1.5, 1.0);
        add_box(hx, (qi_y + hy) * 0.5, 1.5, absf(hy - qi_y) * 0.5 + 1.5, 1.0);
        // (And a bay on the way, over the receiver, for the wires' slack:
        // soldered with the back block lying beside the board, they are
        // longer than the way.)
        cs_what = "A bay for the receiver's wires' slack";
        add_box((qi_x + hx) * 0.5, qi_y - 1.0, 6.0, 7.0, 2.0)
    }
    cs_what = "The battery's wire's way to its hole in the board";
    // (Its wire's channel: from the pocket, level, then to the edge.)
    add_box((cs_batt_x + wire_x) * 0.5, cs_batt_y, absf(wire_x - cs_batt_x) * 0.5 + 1.5,
        1.5, 1.0);
    add_box(wire_x, (cs_batt_y + wire_y) * 0.5, 1.5, absf(wire_y - cs_batt_y) * 0.5 + 1.5,
        1.0);
    cs_what = "Room for the pins of a part, under the board";
    // (Room for the pins of through-hole parts, under the board: round
    // all of a part's pins at once. Not for unplated holes: a part's pegs
    // stop inside the board, and a wire hole has its own way; nor test
    // points, in their window. And where that would leave too little wood
    // at the outside, open to it.)
    for p in 0..parts_n {
        x0: f32 = 1000.0;
        y0: f32 = 1000.0;
        x1: f32 = -1000.0;
        y1: f32 = -1000.0;
        first: int = part_pin0[p];
        for q in first..first + fp_npads[part_fp[p]] {
            if (pin_drill[q] > 0.0 && lp_plated[pin_pad[q]] && !fp_is(part_fp[p],
                "tph")) {
                e: f32 = maxf(pin_slot_w[q], pin_slot_h[q]) * 0.5 + 0.6;
                x0 = minf(x0, pin_x[q] - e);
                y0 = minf(y0, pin_y[q] - e);
                x1 = maxf(x1, pin_x[q] + e);
                y1 = maxf(y1, pin_y[q] + e)
            }
        }
        if (x1 > x0) {
            out: bool = false;
            if (x0 - case_x0() < WALL_MIN) {
                x0 = case_x0() - 1.0;
                out = true
            }
            if (case_x1() - x1 < WALL_MIN) {
                x1 = case_x1() + 1.0;
                out = true
            }
            if (y0 - case_y0() < WALL_MIN) {
                y0 = case_y0() - 1.0;
                out = true
            }
            if (case_y1() - y1 < WALL_MIN) {
                y1 = case_y1() + 1.0;
                out = true
            }
            add_box((x0 + x1) * 0.5, (y0 + y1) * 0.5, (x1 - x0) * 0.5, (y1 - y0) * 0.5,
                1.0);
            if (out) open_last()
        }
    }
    // Board.
    layer_begin(L_BOARD, "Board");
    board_pocket();
    if (!wire_through) {
        add_box(wire_x, wire_y, 2.0, 2.0, 1.0);
        open_last()
    }
    // (The board's tongues, out to the outside, and the parts on them.)
    find_tongues();
    for k in 0..tg_n edge_notch(k);
    // Spacer: wood over the board, but where its parts stand up into it.
    layer_begin(L_SPACER, "Spacer");
    spacer_holes();
    // Screen.
    layer_begin(L_SCREEN, "Screen");
    cs_what = "The screen";
    add_box(sx, sy, SCREEN_W * 0.5 + 0.2, SCREEN_H * 0.5 + 0.2, 0.5);
    flex_way(0.0);
    button_holes(1.6 + 0.6);
    layer_holes(L_SCREEN, -1.0);
    // Front: the window, a clear acrylic sheet in a hole its size, the
    // picture and a margin round it, inside the glass's edge: the same
    // margin all round, which shows the screen's black border and hides its
    // edges and the room for its flex. The screen's glass is pressed up
    // against the front's wood round the window (by foam under it, on the
    // spacer); the acrylic is glued in flush with the face, its back a
    // little inside the front's (3 mm in 3.2): a press cannot push the
    // screen in, and nothing presses on the acrylic.
    layer_begin(L_FRONT, "Front");
    window_box();
    cs_what = "The window: clear acrylic, glued in flush";
    add_box(win_x, win_y, win_hw, win_hh, 1.0);
    button_holes(0.4);
    layer_holes(L_FRONT, -1.0);
    light_legend();
    // (Power, marked: a ring round its cap, as the full light's; Home, a
    // dot just over it; Back, a short bar: near their caps, apart from the
    // lights' legend.)
    for p in 0..parts_n {
        if (is_button(p) && value_is(p, "POWER")) {
            add_circle(part_x[p], part_y[p], cap_d(p) + 0.4 + 2.4);
            engrave_last()
        }
        if (is_button(p) && value_is(p, "HOME")) {
            add_circle(part_x[p], part_y[p] + cap_d(p) * 0.5 + 1.9, 1.2);
            engrave_last()
        }
        // (Each arrow: a small triangle just past its cap, pointing its
        // way: four round caps read as a D-pad, not as more face buttons.)
        if (is_button(p) && is_arrow(p) && !in_dpad(p)) {
            way: int = 0;
            if (value_is(p, "RIGHT")) way = 1;
            if (value_is(p, "DOWN")) way = 2;
            if (value_is(p, "LEFT")) way = 3;
            d: f32 = cap_d(p) * 0.5 + 0.2 + 1.1 + 0.7;
            tx: f32 = part_x[p];
            ty: f32 = part_y[p];
            if (way == 0) ty = ty + d;
            if (way == 1) tx = tx + d;
            if (way == 2) ty = ty - d;
            if (way == 3) tx = tx - d;
            add_tri(tx, ty, 0.9, 0.7, way);
            engrave_last()
        }
        if (is_button(p) && value_is(p, "BACK")) {
            add_box(part_x[p], part_y[p] + cap_d(p) * 0.5 + 1.4, 1.4, 0.15, 0.0);
            engrave_last()
        }
    }
    layers_n = pieces_count;
    // The back, laid face down: what it says outside (where the wireless
    // receiver's coil is, to set it on a charging pad).
    pc_flip[L_BACK] = true;
    // The window's acrylic (0.1 mm smaller each side than its hole).
    begin_piece("Window", layer_z(L_FRONT), win_x, win_y, false);
    add_box(0.0, 0.0, win_hw - 0.1, win_hh - 0.1, 1.0);
    pc_material[pieces_count - 1] = PC_ACRYLIC;
    // The buttons' discs.
    for p in 0..parts_n {
        if (is_button(p) && !in_dpad(p)) {
            c: f32 = cap_d(p);
            x: f32 = part_x[p];
            y: f32 = part_y[p];
            begin_piece("Stem", layer_z(L_SPACER), x, y, false);
            add_circle(0.0, 0.0, STEM_D);
            pin_hole();
            begin_piece("Flange", layer_z(L_SCREEN), x, y, false);
            add_circle(0.0, 0.0, c + 1.6);
            pin_hole();
            begin_piece("Cap", layer_z(L_FRONT), x, y, false);
            add_circle(0.0, 0.0, c);
            // (A flush button's cap is its top, which shows: no pin hole
            // in it; the pin is cut flush with the flange, the cap glued
            // on, centred by its hole in the front.)
            if (!is_flush(p)) pin_hole();
            // (A flush button, Home, Back or power, has no cap standing
            // out: it is not pressed by a thumb passing over it.)
            if (!is_flush(p)) {
                begin_piece("Cap", layer_z(L_FRONT) + cs_ply, x, y, false);
                add_circle(0.0, 0.0, c)
            }
        }
    }
    // The D-pad: one cross over its four switches, rocking on a stem in
    // its middle (on a post on the board, as tall as the switches): a stem
    // under each arm's end and in the middle, a flange cross, and the cap
    // cross through the front and standing out of it.
    if (dpad_n() == 4) {
        x: f32 = dpad_x();
        y: f32 = dpad_y();
        for z in 0..1 {
            for p in 0..parts_n {
                if (in_dpad(p)) {
                    begin_piece("Stem", layer_z(L_SPACER + z), part_x[p], part_y[p],
                        false);
                    add_circle(0.0, 0.0, STEM_D);
                    pin_hole()
                }
            }
            begin_piece("Stem", layer_z(L_SPACER + z), x, y, false);
            add_circle(0.0, 0.0, STEM_D);
            pin_hole()
        }
        begin_piece("D-pad flange", layer_z(L_SCREEN), x, y, false);
        add_cross(0.0, 0.0, dpad_arm() + 0.8, DPAD_HALF_W + 0.8);
        dpad_pin_holes();
        begin_piece("D-pad", layer_z(L_FRONT), x, y, false);
        add_cross(0.0, 0.0, dpad_arm(), DPAD_HALF_W);
        dpad_pin_holes();
        begin_piece("D-pad", layer_z(L_FRONT) + cs_ply, x, y, false);
        add_cross(0.0, 0.0, dpad_arm(), DPAD_HALF_W)
    }
}

// A disc's middle: a hole for a pin (a round toothpick, 2 mm) through a
// button's discs, to line them up as they are glued; not in a cap's top
// disc, which shows.
const PIN_HOLE: f32 = 2.2;

pin_hole() {
    add_circle(0.0, 0.0, PIN_HOLE)
}

// The D-pad's flange and lower cap: a pin hole over each arm's stem too,
// so the crosses cannot turn on their middle pin as they are glued.
dpad_pin_holes() {
    pin_hole();
    for p in 0..parts_n {
        if (in_dpad(p)) add_circle(part_x[p] - dpad_x(), part_y[p] - dpad_y(), PIN_HOLE)
    }
}

// The spacer's holes: for each part that stands up into it (but the
// posts, which bear on it), the buttons' stems (the D-pad's a cross over
// its four and its middle), the lights' light, the screen's flex from its
// fold down to its connector, the battery's plug from its wire's hole to
// its socket, and the side switch's notch, made deep for a fingertip.
spacer_holes() {
    // (The buttons' stems, in holes as wide as their flanges: a flange,
    // over this layer, goes down into it as its button is pressed.)
    button_holes(1.6 + 0.6);
    layer_holes(L_SPACER, -1.0);
    // (The flex: from the fold to the connector it comes to.)
    cs_what = "The screen's flex, from its fold to its connector";
    fpc: int = -1;
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "fpc40") || fp_is(part_fp[p], "fpc14")) fpc = p
    }
    if (fpc >= 0) {
        x0: f32 = court_x0(fpc);
        x1: f32 = cs_screen_x + SCREEN_FLEX_SIDE * (SCREEN_W * 0.5 + SCREEN_FOLD) + 0.2;
        add_box((x0 + x1) * 0.5, cs_screen_y, absf(x1 - x0) * 0.5, SCREEN_FLEX_W * 0.5 + 1.0,
            0.5)
    }
    // (The plug: from its socket to the wire's hole, as one.)
    cs_what = "The battery's plug, from its wire's hole to its socket";
    j: int = plug_part();
    if (j >= 0 && wire_through) {
        x0: f32 = minf(court_x0(j), wire_x - 3.0);
        x1: f32 = maxf(court_x1(j), wire_x + 3.0);
        y0: f32 = minf(court_y0(j), wire_y - 4.0);
        y1: f32 = maxf(court_y1(j), wire_y + 4.0);
        add_box((x0 + x1) * 0.5, (y0 + y1) * 0.5, (x1 - x0) * 0.5 + 0.3, (y1 - y0) * 0.5 + 0.3,
            1.0)
    }
    find_tongues();
    for k in 0..tg_n {
        if (part_height(tg_part[k]) > layer_z(L_SPACER) + 0.2 || fp_is(part_fp[tg_part[k]],
            "pcm12")) edge_notch(k)
    }
}

// The window's hole in the front, and its acrylic: the screen's picture
// and WINDOW_MARGIN round it.
const WINDOW_MARGIN: f32 = 0.5;

win_x: f32 = 0.0;

win_y: f32 = 0.0;

win_hw: f32 = 0.0;

win_hh: f32 = 0.0;

window_box() {
    win_x = cs_screen_x + SCREEN_VA_DX;
    win_y = cs_screen_y + SCREEN_VA_DY;
    win_hw = SCREEN_VA_W * 0.5 + WINDOW_MARGIN;
    win_hh = SCREEN_VA_H * 0.5 + WINDOW_MARGIN
}

// Each button's hole in a layer above the board, its cap grown by g (a
// flange's 1.6 and room, or the front's 0.4): the D-pad's a cross.
button_holes(g: f32) {
    cs_what = "A button's flange: it goes down into it as it is pressed";
    if (g < 1.0) cs_what = "A button's cap";
    for p in 0..parts_n {
        if (is_button(p) && !in_dpad(p)) add_circle(part_x[p], part_y[p], cap_d(p) + g)
    }
    // (The D-pad's cross in the front a little looser, 0.35 mm each side:
    // pressed, it tilts, and its sides move 0.36 at the face.)
    gd: f32 = g;
    if (g < 1.0) gd = 0.7;
    if (dpad_n() == 4) add_cross(dpad_x(), dpad_y(), dpad_arm() + gd * 0.5, DPAD_HALF_W + gd * 0.5)
}

// ---- the D-pad ----
// Its four buttons (UP, DOWN, LEFT, RIGHT), their middle, and how far its
// cap's arms reach (past the domes, by half a cap).
const DPAD_HALF_W: f32 = 3.5;

// (The four arrows are one cross, rocking, only where the board has a
// post in their middle for it to rock on; else four buttons.)
in_dpad(p: int): bool {
    is_button(p) && is_arrow(p) && dpad_pivot()
}

dpad_pivot(): bool {
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "post3015")) return true
    }
    false
}

value_is(p: int, v: str): bool {
    part_value[p] >= 0 && name_is_str(part_value[p], v)
}

dpad_n(): int {
    n: int = 0;
    for p in 0..parts_n {
        if (in_dpad(p)) n = n + 1
    }
    n
}

dpad_x(): f32 {
    t: f32 = 0.0;
    for p in 0..parts_n {
        if (in_dpad(p)) t = t + part_x[p]
    }
    t * 0.25
}

dpad_y(): f32 {
    t: f32 = 0.0;
    for p in 0..parts_n {
        if (in_dpad(p)) t = t + part_y[p]
    }
    t * 0.25
}

dpad_arm(): f32 {
    t: f32 = 0.0;
    for p in 0..parts_n {
        if (in_dpad(p)) t = t + sqrtf((part_x[p] - dpad_x()) * (part_x[p] - dpad_x()) + (part_y[p] - dpad_y()) * (part_y[p] - dpad_y()))
    }
    t * 0.25 + 3.0
}

// Whether a button's cap is flush with the front (Home, Back, Power).
is_flush(p: int): bool {
    value_is(p, "HOME") || value_is(p, "BACK") || value_is(p, "POWER")
}

// What the charge lights mean, engraved over them: a bar over each of the
// level's, taller step by step, and a ring round the last (full).
light_legend() {
    n: int = 0;
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "led0603")) n = n + 1
    }
    for p in 0..parts_n {
        if (fp_is(part_fp[p], "led0603")) {
            // (Its place, left to right.)
            k: int = 0;
            for o in 0..parts_n {
                if (fp_is(part_fp[o], "led0603") && part_x[o] < part_x[p]) k = k + 1
            }
            if (k == n - 1) {
                add_circle(part_x[p], part_y[p], LED_HOLE + 1.6);
                engrave_last()
            } else {
                h: f32 = 0.5 * (k + 1) as f32;
                // (A line, not a box: a box this small engraves as a blob.)
                add_box(part_x[p], part_y[p] + LED_HOLE * 0.5 + 1.2 + h * 0.5, 0.05,
                    h * 0.5, 0.0);
                engrave_last()
            }
        }
    }
}

// The holes a layer above the board wants for the buttons' stems (d, if
// it is more than 0), for the LEDs' light, and for the parts that reach
// up into it.
layer_holes(l: int, d: f32) {
    for p in 0..parts_n {
        cs_what = "A button's stem";
        if (is_button(p) && d > 0.0) add_circle(part_x[p], part_y[p], d);
        // (An LED's light comes up through a hole in every layer over it.)
        cs_what = "A charge light: its light, up through every layer over it";
        if (fp_is(part_fp[p], "led0603")) add_circle(part_x[p], part_y[p], LED_HOLE);
        // (A part that stands up into the layer: named when tapped, by
        // where it is.)
        cs_what = "PART";
        // (A slide switch's knob, reached from the front through a slot
        // in the layers over it, as long as its travel and a fingernail.)
        if (fp_is(part_fp[p], "ss12d00") && l >= L_SCREEN) add_box((court_x0(p) + court_x1(p)) * 0.5,
            (court_y0(p) + court_y1(p)) * 0.5, 3.5, 2.0, 1.0);
        if (!is_button(p) && reaches(p, l)) {
            x0: f32 = court_x0(p);
            x1: f32 = court_x1(p);
            y0: f32 = court_y0(p);
            y1: f32 = court_y1(p);
            add_box((x0 + x1) * 0.5, (y0 + y1) * 0.5, (x1 - x0) * 0.5 + 0.3, (y1 - y0) * 0.5 + 0.3,
                0.5)
        }
    }
}

// ---- inside a shape ----
// Whether the point (x, y) is inside shape k (in its piece's coordinates).
in_shape(k: int, x: f32, y: f32): bool {
    if (sh_kind[k] == SH_TRI) {
        // (On the same side of each edge as the inside: anticlockwise,
        // its left.)
        for i in 0..3 {
            j: int = (i + 1) % 3;
            ax: f32 = tri_x(k, i);
            ay: f32 = tri_y(k, i);
            if ((tri_x(k, j) - ax) * (y - ay) - (tri_y(k, j) - ay) * (x - ax) < 0.0) return false
        }
        return true
    }
    dx: f32 = absf(x - sh_x[k]);
    dy: f32 = absf(y - sh_y[k]);
    if (sh_kind[k] == SH_CIRCLE) return dx * dx + dy * dy <= sh_hw[k] * sh_hw[k];
    if (sh_kind[k] == SH_HEX) return dy <= sh_hh[k] && 1.7320508 * dx + dy <= 1.7320508 * sh_hw[k];
    if (sh_kind[k] == SH_CROSS) return dx <= sh_hw[k] && dy <= sh_r[k] || dx <= sh_r[k] && dy <= sh_hh[k];
    r: f32 = sh_r[k];
    qx: f32 = dx - (sh_hw[k] - r);
    qy: f32 = dy - (sh_hh[k] - r);
    if (qx <= 0.0 || qy <= 0.0) return dx <= sh_hw[k] && dy <= sh_hh[k];
    qx * qx + qy * qy <= r * r
}

// ---- the layer shown ----
// Which layer the Case mode shows, and its mask: a byte a cell of cm_g
// millimetres over the case, rows from its bottom up, drawn as a texture
// (as the pours are) so that its holes show the board through them.
cs_view: int = L_FRONT;

const CM_G: f32 = 0.15;

cm_bytes: []i8 = new i8[1048576](0i8);

cm_nx: int = 1;

cm_ny: int = 1;

cm_x0: f32 = 0.0;

cm_y0: f32 = 0.0;

cm_x1: f32 = 0.0;

cm_y1: f32 = 0.0;

// Whether the texture has the mask as it now is.
cm_drawn: bool = false;

make_case_mask() {
    cm_drawn = true;
    if (cs_view < 0 || cs_view >= layers_n) return;
    w: f32 = case_w() + 1.0;
    h: f32 = case_h() + 1.0;
    cm_nx = (w / CM_G) as int + 1;
    cm_ny = (h / CM_G) as int + 1;
    while (cm_nx * cm_ny > len(cm_bytes)) {
        cm_nx = cm_nx * 3 / 4;
        cm_ny = cm_ny * 3 / 4
    }
    gx: f32 = w / cm_nx as f32;
    gy: f32 = h / cm_ny as f32;
    cm_x0 = case_x0() - 0.5;
    cm_y0 = case_y0() - 0.5;
    cm_x1 = cm_x0 + w;
    cm_y1 = cm_y0 + h;
    first: int = pc_first[cs_view];
    for j in 0..cm_ny {
        y: f32 = cm_y0 + (j as f32 + 0.5) * gy;
        for i in 0..cm_nx {
            x: f32 = cm_x0 + (i as f32 + 0.5) * gx;
            if (in_shape(first, x, y)) cm_bytes[j * cm_nx + i] = -1i8 else cm_bytes[j * cm_nx + i] = 0i8
        }
    }
    // (Each hole cut, over its own box only.)
    for k in first + 1..first + pc_n[cs_view] {
        if (!sh_engrave[k]) mask_hole(k, gx, gy)
    }
}

// Hole k cut from the mask, over its own box only.
mask_hole(k: int, gx: f32, gy: f32) {
    {
        i0: int = clampi(((sh_x[k] - sh_hw[k] - cm_x0) / gx) as int - 1, 0, cm_nx - 1);
        i1: int = clampi(((sh_x[k] + sh_hw[k] - cm_x0) / gx) as int + 1, 0, cm_nx - 1);
        j0: int = clampi(((sh_y[k] - sh_hh[k] - cm_y0) / gy) as int - 1, 0, cm_ny - 1);
        j1: int = clampi(((sh_y[k] + sh_hh[k] - cm_y0) / gy) as int + 1, 0, cm_ny - 1);
        for j in j0..j1 + 1 {
            y: f32 = cm_y0 + (j as f32 + 0.5) * gy;
            for i in i0..i1 + 1 {
                if (in_shape(k, cm_x0 + (i as f32 + 0.5) * gx, y)) cm_bytes[j * cm_nx + i] = 0i8
            }
        }
    }
}

const C_WOOD: int = 15126435;

const C_WOOD_CUT: int = 9068600;

const C_WOOD_LIGHT: int = 15785400;

const C_GLASS: int = 2830134;

const C_SCREEN_ON: int = 1845828;

const C_STEEL: int = 12174028;

const C_POUCH: int = 6253434;

// The layer shown, over the board: what lies in it (the battery, the
// screen), the wood with its holes, the cut lines, and the buttons' discs
// at its height.
draw_case() {
    if (!cs_on || cs_view < 0 || cs_view >= layers_n) return;
    s: f32 = cam_s;
    l: int = cs_view;
    z0: f32 = pc_z[l];
    z1: f32 = z0 + cs_ply;
    if (dock_on) draw_dock_under(z0);
    // The battery, in the layers it lies in.
    if (!dock_on && z1 > layer_z(L_BATT1) && z0 < layer_z(L_BATT1) + BATT_T) p_box_at(to_sx(cs_batt_x),
        to_sy(cs_batt_y), batt_w() * 0.5 * s, batt_l() * 0.5 * s, 1.5 * s, C_POUCH,
        0.95);
    // The screen, from its own layer up.
    if (!dock_on && l >= L_SCREEN) {
        p_box_at(to_sx(cs_screen_x), to_sy(cs_screen_y), SCREEN_W * 0.5 * s, SCREEN_H * 0.5 * s,
            0.6 * s, C_GLASS, 1.0);
        p_box_at(to_sx(cs_screen_x + SCREEN_VA_DX), to_sy(cs_screen_y + SCREEN_VA_DY),
            SCREEN_VA_W * 0.5 * s, SCREEN_VA_H * 0.5 * s, 0.4 * s, C_SCREEN_ON, 1.0)
    }
    // The wood.
    x0: f32 = to_sx(cm_x0);
    x1: f32 = to_sx(cm_x1);
    y0: f32 = to_sy(cm_y1);
    y1: f32 = to_sy(cm_y0);
    p_quad(x0, y0, x1, y1, 0.0, 1.0, 1.0, 0.0, 0.0, 0.0, P_POUR, 0.0, 0.0, 0.0, 2.0,
        0.0, C_WOOD, 0.96);
    // Its cut lines.
    lw: f32 = clampf(0.08 * s, 1.0, 2.0);
    for k in pc_first[l]..pc_first[l] + pc_n[l] draw_cut(k, 0.0, 0.0, lw, C_WOOD_CUT,
        0.9);
    if (sel_hole >= pc_first[l] && sel_hole < pc_first[l] + pc_n[l]) draw_cut(sel_hole,
        0.0, 0.0, lw + 2.5, C_PICK, 1.0);
    // The bolts' heads sunk in the back, their nuts in the screen's layer.
    nb: int = bolts_n();
    if (dock_on) nb = 0;
    for b in 0..nb {
        bx: f32 = to_sx(bolt_x(b));
        by: f32 = to_sy(bolt_y(b));
        if (l == L_BACK || l == L_BATT1) {
            p_disc(bx, by, HEAD_D * 0.5 * s, C_STEEL, 1.0);
            p_disc(bx, by, 0.9 * s, 6253434, 1.0)
        }
        if (l == L_SCREEN) p_disc(bx, by, NUT_AF * 0.5 * s, C_STEEL, 1.0)
    }
    // The loose pieces at this height (the buttons' discs; a dock's lid
    // and its catch): each its outline, filled, then all its cuts.
    for p in layers_n..pieces_count {
        if (absf(pc_z[p] - z0) < 0.01) {
            f: int = pc_first[p];
            // (Acrylic: only its outline; a cross: its two arms.)
            if (pc_material[p] != PC_PLY) { } else if (sh_kind[f] == SH_CROSS) {
                p_box_at(to_sx(pc_x[p] + sh_x[f]), to_sy(pc_y[p] + sh_y[f]), sh_hw[f] * s,
                    sh_r[f] * s, 0.0, C_WOOD_LIGHT, 1.0);
                p_box_at(to_sx(pc_x[p] + sh_x[f]), to_sy(pc_y[p] + sh_y[f]), sh_r[f] * s,
                    sh_hh[f] * s, 0.0, C_WOOD_LIGHT, 1.0)
            } else if (sh_kind[f] == SH_BOX) p_box_at(to_sx(pc_x[p] + sh_x[f]), to_sy(pc_y[p] + sh_y[f]),
                sh_hw[f] * s, sh_hh[f] * s, sh_r[f] * s, C_WOOD_LIGHT, 1.0) else p_disc(to_sx(pc_x[p] + sh_x[f]),
                to_sy(pc_y[p] + sh_y[f]), sh_hw[f] * s, C_WOOD_LIGHT, 1.0);
            for k in f..f + pc_n[p] draw_cut(k, pc_x[p], pc_y[p], lw, C_WOOD_CUT,
                0.9)
        }
    }
}

// Shape k's cut line, moved by (dx, dy).
draw_cut(
    k: int,
    dx: f32,
    dy: f32,
    w: f32,
    rgb: int,
    a: f32
) {
    s: f32 = cam_s;
    x: f32 = to_sx(sh_x[k] + dx);
    y: f32 = to_sy(sh_y[k] + dy);
    if (sh_kind[k] == SH_TRI) {
        for i in 0..3 {
            j: int = (i + 1) % 3;
            p_line(to_sx(tri_x(k, i) + dx), to_sy(tri_y(k, i) + dy), to_sx(tri_x(k,
                j) + dx), to_sy(tri_y(k, j) + dy), w, rgb, a)
        }
        return
    }
    if (sh_kind[k] == SH_HEX) {
        r: f32 = sh_hw[k] * s;
        for e in 0..6 {
            a0: f32 = e as f32 * 1.0471976;
            a1: f32 = a0 + 1.0471976;
            p_line(x + r * cosf(a0), y + r * sinf(a0), x + r * cosf(a1), y + r * sinf(a1),
                w, rgb, a)
        }
        return
    }
    if (sh_kind[k] == SH_CROSS) {
        l: f32 = sh_hw[k] * s;
        h: f32 = sh_r[k] * s;
        for q in 0..12 {
            ax: f32 = cross_px(q, l, h);
            ay: f32 = cross_py(q, l, h);
            bx: f32 = cross_px((q + 1) % 12, l, h);
            by: f32 = cross_py((q + 1) % 12, l, h);
            p_line(x + ax, y - ay, x + bx, y - by, w, rgb, a)
        }
        return
    }
    hw: f32 = sh_hw[k] * s;
    hh: f32 = sh_hh[k] * s;
    p_outline(x - hw, y - hh, 2.0 * hw, 2.0 * hh, sh_r[k] * s, w, rgb, a)
}

// How round a cross's arms' ends' corners are.
const CROSS_ROUND: f32 = 1.0;

// Whether a cross's corner q is an arm's end's (not between two arms).
cross_convex(q: int): bool {
    CROSS_PX[q] == 1 || CROSS_PX[q] == -1 || CROSS_PY[q] == 1 || CROSS_PY[q] == -1
}

sgnf(v: f32): f32 {
    if (v > 0.0) return 1.0;
    if (v < 0.0) return -1.0;
    0.0
}

// A point (dx, dy from a shape's middle, y up) on the sheet (y down,
// mirrored if the piece is laid face down).
svg_xy(
    x: f32,
    y: f32,
    dx: f32,
    dy: f32
) {
    if (svg_flip) line_num(x - dx, 3) else line_num(x + dx, 3);
    line_add(",");
    line_num(y - dy, 3)
}

// A cross's corners, counterclockwise from its right arm's lower corner:
// each as +-l (its arms' reach) or +-h (half their width), coded 1, -1, 2,
// -2.
CROSS_PX: []int = [1, 1, 2, 2, -2, -2, -1, -1, -2, -2, 2, 2];

CROSS_PY: []int = [-2, 2, 2, 1, 1, 2, 2, -2, -2, -1, -1, -2];

cross_px(q: int, l: f32, h: f32): f32 {
    cross_at(CROSS_PX[q], l, h)
}

cross_py(q: int, l: f32, h: f32): f32 {
    cross_at(CROSS_PY[q], l, h)
}

cross_at(c: int, l: f32, h: f32): f32 {
    if (c == 1) return l;
    if (c == -1) return -l;
    if (c == 2) return h;
    -h
}

// ---- the case's check ----
// Plywood holds together where at least 1.5 mm of it is left: between a
// layer's holes, and between a hole and the layer's edge.
const WALL_MIN: f32 = 1.5;

check_case() {
    // (Every piece of ply: the layers, and the loose ones, a dock's lid
    // among them.)
    for l in 0..pieces_count {
        if (l >= layers_n && pc_material[l] != PC_PLY) { } else {
            f: int = pc_first[l];
            for i in f + 1..f + pc_n[l] {
                if (!sh_engrave[i]) check_hole(l, f, i)
            }
        }
    }
}

// Hole i of layer l (its outline f): wood enough to its edge and to the
// holes after it.
check_hole(l: int, f: int, i: int) {
    {
        {
            // (To the edge: the outline's box, its corners round. A hole
            // meant to open through the edge, as a tongue's notch, is an
            // opening; any other through it has cut the piece open.)
            g0: f32 = gap_of(i, f, true);
            if (g0 < WALL_MIN && !(g0 < 0.0 && sh_open[i])) add_prob(sh_x[i], sh_y[i],
                PROB_WALL, l, -1);
            for j in i + 1..f + pc_n[l] {
                g: f32 = 1000.0;
                if (!sh_engrave[j]) g = gap_of(i, j, false);
                // (Holes that overlap are one hole: no wall there; but not
                // a hole that must stand on its own.)
                if (g > 0.0 && g < WALL_MIN || g <= 0.0 && (sh_keep[i] || sh_keep[j])) add_prob((sh_x[i] + sh_x[j]) * 0.5,
                    (sh_y[i] + sh_y[j]) * 0.5, PROB_WALL, l, -1)
            }
        }
    }
}

// The gap as shape_gap gives it, a cross taken arm by arm (as two boxes,
// in the two spare shapes at the arrays' end).
gap_of(i: int, j: int, inside: bool): f32 {
    if (sh_kind[i] == SH_CROSS) return minf(gap_of(arm_box(i, 0, SHAPES - 2), j, inside),
        gap_of(arm_box(i, 1, SHAPES - 2), j, inside));
    if (sh_kind[j] == SH_CROSS) return minf(gap_of(i, arm_box(j, 0, SHAPES - 1), inside),
        gap_of(i, arm_box(j, 1, SHAPES - 1), inside));
    shape_gap(i, j, inside)
}

// Cross k's arm across (a = 0) or up (1), as a box in shape slot s.
arm_box(k: int, a: int, s: int): int {
    sh_kind[s] = SH_BOX;
    sh_x[s] = sh_x[k];
    sh_y[s] = sh_y[k];
    sh_r[s] = 0.0;
    sh_engrave[s] = false;
    if (a == 0) {
        sh_hw[s] = sh_hw[k];
        sh_hh[s] = sh_r[k]
    } else {
        sh_hw[s] = sh_r[k];
        sh_hh[s] = sh_hh[k]
    }
    s
}

// The gap between shapes i and j (as circles if round, else as boxes; a
// hexagon as the circle round it, but by a box as its own box), or,
// inside, between i and j's edge.
shape_gap(i: int, j: int, inside: bool): f32 {
    if (inside) {
        // (A circle in a corner meets the corner's arc.)
        dx: f32 = absf(sh_x[i] - sh_x[j]);
        dy: f32 = absf(sh_y[i] - sh_y[j]);
        g: f32 = minf(sh_hw[j] - dx - sh_hw[i], sh_hh[j] - dy - sh_hh[i]);
        r: f32 = sh_r[j];
        cx: f32 = dx - (sh_hw[j] - r);
        cy: f32 = dy - (sh_hh[j] - r);
        if (cx > 0.0 && cy > 0.0) g = minf(g, r - sqrtf(cx * cx + cy * cy) - maxf(sh_hw[i],
            sh_hh[i]));
        return g
    }
    if (sh_kind[i] != SH_BOX && sh_kind[j] != SH_BOX) {
        dx: f32 = sh_x[i] - sh_x[j];
        dy: f32 = sh_y[i] - sh_y[j];
        return sqrtf(dx * dx + dy * dy) - sh_hw[i] - sh_hw[j]
    }
    // (A hexagon by a box: as its own box, across its corners one way and
    // its flats the other, which it fills where it is nearest a box.)
    if (sh_kind[i] == SH_CIRCLE) return round_box_gap(sh_x[i], sh_y[i], sh_hw[i],
        j);
    if (sh_kind[j] == SH_CIRCLE) return round_box_gap(sh_x[j], sh_y[j], sh_hw[j],
        i);
    gx: f32 = absf(sh_x[i] - sh_x[j]) - sh_hw[i] - sh_hw[j];
    gy: f32 = absf(sh_y[i] - sh_y[j]) - sh_hh[i] - sh_hh[j];
    if (gx > 0.0 && gy > 0.0) return sqrtf(gx * gx + gy * gy);
    maxf(gx, gy)
}

// The gap between a circle (x, y, r) and box k (its corners round).
round_box_gap(
    x: f32,
    y: f32,
    r: f32,
    k: int
): f32 {
    c: f32 = sh_r[k];
    gx: f32 = absf(x - sh_x[k]) - (sh_hw[k] - c);
    gy: f32 = absf(y - sh_y[k]) - (sh_hh[k] - c);
    if (gx > 0.0 && gy > 0.0) return sqrtf(gx * gx + gy * gy) - c - r;
    maxf(gx, gy) - c - r
}

// ---- the cut file ----
// Every piece laid out on sheets, as SVG for a laser-cutting service
// (Ponoko's rules): millimetres, cuts as blue hairlines, engraving in red.
// The laser burns away KERF of wood along each line, half each side, so
// outlines are drawn that much bigger and holes that much smaller. Each
// layer has as many engraved dots on its top rim as its place in the
// stack, from the back.
const KERF: f32 = 0.2;

const SHEET_GAP: f32 = 4.0;

svg: []i8 = new i8[262144](0i8);

svg_n: int = 0;

// The sheet's size, once laid out.
sheet_w: f32 = 0.0;

sheet_h: f32 = 0.0;

svg_line() {
    line_byte(10);
    if (svg_n + line_n > len(svg)) return;
    for i in 0..line_n svg[svg_n + i] = line[i];
    svg_n = svg_n + line_n;
    line_clear()
}

const SVG_CUT: int = 0;

const SVG_ENGRAVE: int = 1;

svg_style(how: int) {
    if (how == SVG_CUT) line_add(" fill=\"none\" stroke=\"#0000ff\" stroke-width=\"0.01\"/>") else line_add(" fill=\"none\" stroke=\"#ff0000\" stroke-width=\"0.01\"/>")
}

// Whether the piece being written is laid face down: mirrored.
svg_flip: bool = false;

// Shape k, its middle at (ox, oy) on the sheet (y down), grown by g.
svg_shape(
    k: int,
    ox: f32,
    oy: f32,
    g: f32,
    how: int
) {
    x: f32 = ox + sh_x[k];
    if (svg_flip) x = ox - sh_x[k];
    y: f32 = oy - sh_y[k];
    if (sh_kind[k] == SH_CIRCLE) {
        line_add("<circle cx=\"");
        line_num(x, 3);
        line_add("\" cy=\"");
        line_num(y, 3);
        line_add("\" r=\"");
        line_num(sh_hw[k] + g, 3);
        line_add("\"")
    } else if (sh_kind[k] == SH_TRI) {
        line_add("<polygon points=\"");
        for i in 0..3 {
            if (i > 0) line_add(" ");
            tx: f32 = ox + tri_x(k, i);
            if (svg_flip) tx = ox - tri_x(k, i);
            line_num(tx, 3);
            line_add(",");
            line_num(oy - tri_y(k, i), 3)
        }
        line_add("\"")
    } else if (sh_kind[k] == SH_HEX) {
        r: f32 = sh_hw[k] + g * 1.1547;
        line_add("<polygon points=\"");
        for e in 0..6 {
            a: f32 = e as f32 * 1.0471976;
            if (e > 0) line_add(" ");
            line_num(x + r * cosf(a), 3);
            line_add(",");
            line_num(y + r * sinf(a), 3)
        }
        line_add("\"")
    } else if (sh_kind[k] == SH_CROSS) {
        // (Its arms' ends' corners round, 1 mm: as a cap, not to dig into
        // a thumb.)
        l: f32 = sh_hw[k] + g;
        h: f32 = sh_r[k] + g;
        rc: f32 = minf(CROSS_ROUND, h * 0.5);
        line_add("<path d=\"");
        for q in 0..12 {
            cx: f32 = cross_px(q, l, h);
            cy: f32 = cross_py(q, l, h);
            if (cross_convex(q)) {
                // (In from the corner along the side coming to it, then
                // round to along the side leaving it.)
                p: int = (q + 11) % 12;
                n: int = (q + 1) % 12;
                ax: f32 = cx + sgnf(cross_px(p, l, h) - cx) * rc;
                ay: f32 = cy + sgnf(cross_py(p, l, h) - cy) * rc;
                bx: f32 = cx + sgnf(cross_px(n, l, h) - cx) * rc;
                by: f32 = cy + sgnf(cross_py(n, l, h) - cy) * rc;
                if (q == 0) line_add("M ") else line_add(" L ");
                svg_xy(x, y, ax, ay);
                line_add(" A ");
                line_num(rc, 3);
                line_add(" ");
                line_num(rc, 3);
                // (Turning as the outline goes round: clockwise on the
                // sheet, but mirrored.)
                if (svg_flip) line_add(" 0 0 0 ") else line_add(" 0 0 1 ");
                svg_xy(x, y, bx, by)
            } else {
                line_add(" L ");
                svg_xy(x, y, cx, cy)
            }
        }
        line_add(" Z\"")
    } else {
        hw: f32 = sh_hw[k] + g;
        hh: f32 = sh_hh[k] + g;
        line_add("<rect x=\"");
        line_num(x - hw, 3);
        line_add("\" y=\"");
        line_num(y - hh, 3);
        line_add("\" width=\"");
        line_num(2.0 * hw, 3);
        line_add("\" height=\"");
        line_num(2.0 * hh, 3);
        line_add("\" rx=\"");
        line_num(maxf(sh_r[k] + g, 0.0), 3);
        line_add("\"")
    }
    svg_style(how);
    svg_line()
}

// Where each piece goes: which sheet, and where its own (0, 0) is on it
// (y down). Pieces go in rows, layers first, each row as tall as its
// tallest; a row that would be too wide starts the next, and one that
// would run off the sheet starts the next sheet (Ponoko's biggest, 790 by
// 384 mm).
const SHEET_MAX_W: f32 = 790.0;

const SHEET_MAX_H: f32 = 384.0;

pc_sheet: []int = new int[PIECES](0);

pc_ox: []f32 = new f32[PIECES](0.0);

pc_oy: []f32 = new f32[PIECES](0.0);

sheets_n: int = 0;

lay_out_sheets() {
    sheets_n = 0;
    sheet_w = 0.0;
    sheet_h = 0.0;
    // (The plywood's sheets, then the acrylic's: each material its own.)
    for m in 0..2 lay_out_material(m)
}

// The sheets' materials, as laid out.
sheet_mat: []int = new int[16](0);

lay_out_material(m: int) {
    x: f32 = SHEET_GAP;
    y: f32 = SHEET_GAP;
    row_h: f32 = 0.0;
    first: bool = true;
    for p in 0..pieces_count {
        if (pc_material[p] == m) {
            if (first && sheets_n < len(sheet_mat)) {
                sheet_mat[sheets_n] = m;
                sheets_n = sheets_n + 1;
                first = false
            }
            f: int = pc_first[p];
            w: f32 = sh_hw[f] * 2.0;
            h: f32 = sh_hh[f] * 2.0;
            if (x + w + SHEET_GAP > SHEET_MAX_W && x > SHEET_GAP) {
                x = SHEET_GAP;
                y = y + row_h + SHEET_GAP;
                row_h = 0.0
            }
            if (y + h + SHEET_GAP > SHEET_MAX_H && y > SHEET_GAP && sheets_n < len(sheet_mat)) {
                sheet_mat[sheets_n] = m;
                sheets_n = sheets_n + 1;
                x = SHEET_GAP;
                y = SHEET_GAP;
                row_h = 0.0
            }
            pc_sheet[p] = sheets_n - 1;
            // (Its outline's left and top edges where the cursor is; a piece
            // laid face down is mirrored.)
            fx: f32 = sh_x[f];
            if (pc_flip[p]) fx = -fx;
            pc_ox[p] = x + sh_hw[f] - fx;
            pc_oy[p] = y + sh_hh[f] + sh_y[f];
            x = x + w + SHEET_GAP;
            row_h = maxf(row_h, h);
            if (sheets_n == 1) {
                sheet_w = maxf(sheet_w, x);
                sheet_h = maxf(sheet_h, y + row_h + SHEET_GAP)
            }
        }
    }
}

// Sheet k's file into svg.
write_case_svg(k: int) {
    svg_n = 0;
    line_clear();
    if (!cs_on || layers_n == 0) return;
    lay_out_sheets();
    // (Its size: as far as its pieces reach.)
    sw: f32 = 0.0;
    shh: f32 = 0.0;
    for p in 0..pieces_count {
        if (pc_sheet[p] == k) {
            f: int = pc_first[p];
            fx: f32 = sh_x[f];
            if (pc_flip[p]) fx = -fx;
            sw = maxf(sw, pc_ox[p] + fx + sh_hw[f] + SHEET_GAP);
            shh = maxf(shh, pc_oy[p] - sh_y[f] + sh_hh[f] + SHEET_GAP)
        }
    }
    line_add("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"");
    line_num(sw, 2);
    line_add("mm\" height=\"");
    line_num(shh, 2);
    line_add("mm\" viewBox=\"0 0 ");
    line_num(sw, 2);
    line_add(" ");
    line_num(shh, 2);
    line_add("\">");
    svg_line();
    for p in 0..pieces_count {
        if (pc_sheet[p] == k) {
            f: int = pc_first[p];
            ox: f32 = pc_ox[p];
            oy: f32 = pc_oy[p];
            svg_flip = pc_flip[p];
            svg_shape(f, ox, oy, KERF * 0.5, SVG_CUT);
            for j in f + 1..f + pc_n[p] {
                // (Engravings on its face, as drawn: no kerf to allow for.)
                if (sh_engrave[j]) svg_shape(j, ox, oy, 0.0, SVG_ENGRAVE) else svg_shape(j,
                    ox, oy, -KERF * 0.5, SVG_CUT)
            }
            svg_flip = false;
            // (A layer's place in the stack: dots along its bottom rim,
            // right of the middle, on its top face, where the next layer
            // covers them: none on the last, whose top face shows, nor on
            // the back, laid face down.)
            last: bool = p == layers_n - 1;
            if (p < layers_n && !pc_flip[p] && !last) {
                w: f32 = sh_hw[f] * 2.0;
                bottom: f32 = oy - sh_y[f] + sh_hh[f];
                dy: f32 = 1.5;
                if (!dock_on) dy = rim_of(3) * 0.5;
                for d in 0..p + 1 {
                    line_add("<circle cx=\"");
                    line_num(ox + sh_x[f] + w * 0.25 + (d as f32 - p as f32 * 0.5) * 2.5,
                        3);
                    line_add("\" cy=\"");
                    line_num(bottom - dy, 3);
                    line_add("\" r=\"0.6\"");
                    svg_style(SVG_ENGRAVE);
                    svg_line()
                }
            }
        }
    }
    line_add("</svg>");
    svg_line()
}

// The way for the screen's flex round the module's end (the end it
// leaves): past the end by the fold's room, and in under it by `inward`.
flex_way(inward: f32) {
    cs_what = "Room for the screen's flex, folding back under it";
    x: f32 = cs_screen_x + SCREEN_FLEX_SIDE * (SCREEN_W * 0.5 + SCREEN_FOLD * 0.5 - inward * 0.5);
    add_box(x, cs_screen_y, (SCREEN_FOLD + inward) * 0.5 + 0.2, SCREEN_FLEX_W * 0.5 + 1.0,
        0.5)
}
