tag cad;

use_tag std, gl, x11, skate;

// The editor's own things, drawn over the board: the board's name and how
// far along it is, top left, with its problems (a tap goes to each in
// turn) top right; the tools along the bottom (the two modes, the layer,
// undo and redo, fit, and adding a part); over them a card for what is
// picked out, with what can be done to it; a word now and then (a toast);
// and the drawer of parts to add.
//
// Buttons are made as they are drawn, each frame, and pressed against what
// the last frame drew. A button acts when the finger lifts on it.
const B_NONE: int = 0;

const B_ARRANGE: int = 1;

const B_ROUTE: int = 2;

const B_LAYER: int = 3;

const B_UNDO: int = 4;

const B_REDO: int = 5;

const B_FIT: int = 6;

const B_ADD: int = 7;

const B_ROTATE: int = 8;

const B_DELETE: int = 9;

const B_VIA: int = 10;

const B_DONE: int = 11;

const B_PROBS: int = 12;

const B_SHADE: int = 13;

const B_SHEET: int = 14;

const B_CLOSE: int = 15;

const B_FLIP: int = 16;

const B_LOCK: int = 17;

const B_GUIDE: int = 18;

const B_ALL: int = 19;

const B_STOP: int = 20;

const B_POUR: int = 21;

const B_NET: int = 22;

const B_CLEAR: int = 23;

// The rows of the menu Clear opens, one for each of edit.l8's CLEAR_
// levels.
const B_CLEAR_LEVEL: int = 24;

const B_PANEL: int = 30;

const B_PART: int = 100;

const C_PANEL: int = 1382945; // #151a21

const C_PANEL_HI: int = 2304822; // #232b36

const C_LINE: int = 2897218; // #2c3542

const C_INK: int = 15659766; // #eef2f6

const C_MUTED: int = 9279912; // #8d99a8

const BUTTONS: int = 128;

btn_n: int = 0;

btn_id: []int = new int[BUTTONS](0);

btn_x0: []f32 = new f32[BUTTONS](0.0);

btn_y0: []f32 = new f32[BUTTONS](0.0);

btn_x1: []f32 = new f32[BUTTONS](0.0);

btn_y1: []f32 = new f32[BUTTONS](0.0);

// The button a finger is on (and which finger), and how pressed it shows.
press_id: int = 0;

press_finger: int = -1;

press_show: f32 = 0.0;

press_shown_id: int = 0;

add_button(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    if (btn_n >= BUTTONS) return;
    btn_id[btn_n] = id;
    btn_x0[btn_n] = x0;
    btn_y0[btn_n] = y0;
    btn_x1[btn_n] = x1;
    btn_y1[btn_n] = y1;
    btn_n = btn_n + 1
}

// The button at (x, y), the last drawn first (it is on top).
button_at(x: f32, y: f32): int {
    k: int = btn_n - 1;
    while (k >= 0) {
        // (A little room round each, for fingers.)
        if (x >= btn_x0[k] - 3.0 && x <= btn_x1[k] + 3.0 && y >= btn_y0[k] - 3.0 && y <= btn_y1[k] + 3.0) return btn_id[k];
        k = k - 1
    }
    B_NONE
}

// How pressed button id shows (0 to 1).
pressed(id: int): f32 {
    if (press_shown_id == id) return press_show;
    0.0
}

// ---- layout ----
bar_x: f32 = 0.0;

bar_y: f32 = 0.0;

bar_w: f32 = 400.0;

bar_h: f32 = 58.0;

layout_ui() {
    bar_w = minf(scr_w as f32 - 20.0 - safe_left - safe_right, 580.0);
    bar_h = 58.0;
    bar_x = (scr_w as f32 - bar_w) * 0.5;
    bar_y = scr_h as f32 - safe_bottom - 12.0 - bar_h;
    view_top = safe_top + 70.0;
    view_bottom = safe_bottom + bar_h + 24.0
}

// ---- motion ----
// The modes' slider (0 Arrange to 1 Route), the card (how far in, and
// what it shows), the toast, and the drawer.
mode_show: f32 = 0.0;

card_show: f32 = 0.0;

toast_buf: []i8 = new i8[200](0i8);

toast_n: int = 0;

toast_t: f32 = 10.0;

sheet_open: bool = false;

sheet_t: f32 = 0.0;

sheet_scroll: f32 = 0.0;

sheet_scroll_v: f32 = 0.0;

sheet_dragging: bool = false;

sheet_last_y: f32 = 0.0;

sheet_content_h: f32 = 0.0;

toast_line() {
    toast_n = mini(line_n, len(toast_buf));
    for i in 0..toast_n toast_buf[i] = line[i];
    toast_t = 0.0
}

toast_str(t: str) {
    line_clear();
    line_add(t);
    toast_line()
}

sheet_toggle() {
    if (sheet_open) sheet_close() else {
        sheet_open = true;
        sheet_scroll_v = 0.0
    }
}

sheet_close() {
    sheet_open = false;
    sheet_dragging = false
}

// Whether a card shows, for what is picked.
card_wanted(): bool {
    !sheet_open && (sel_part >= 0 || sel_pin >= 0 || sel_seg >= 0 || sel_via >= 0 || sel_route >= 0 || job_on || mode == MODE_ROUTE)
}

step_ui(dt: f32): bool {
    moving: bool = false;
    target: f32 = 0.0;
    if (mode == MODE_ROUTE) target = 1.0;
    k: f32 = 1.0 - expf(-dt * 16.0);
    if (absf(mode_show - target) > 0.001) {
        mode_show = lerpf(mode_show, target, k);
        moving = true
    } else mode_show = target;
    ct: f32 = 0.0;
    if (card_wanted()) ct = 1.0;
    if (absf(card_show - ct) > 0.001) {
        card_show = lerpf(card_show, ct, 1.0 - expf(-dt * 18.0));
        moving = true
    } else card_show = ct;
    st: f32 = 0.0;
    if (sheet_open) st = 1.0;
    if (absf(sheet_t - st) > 0.001) {
        sheet_t = lerpf(sheet_t, st, 1.0 - expf(-dt * 13.0));
        moving = true
    } else sheet_t = st;
    cm: f32 = 0.0;
    if (clear_menu) cm = 1.0;
    if (absf(clear_menu_t - cm) > 0.001) {
        clear_menu_t = lerpf(clear_menu_t, cm, 1.0 - expf(-dt * 20.0));
        moving = true
    } else clear_menu_t = cm;
    if (toast_t < 2.6) {
        toast_t = toast_t + dt;
        moving = true
    }
    // The button pressed: in quickly, out slowly.
    if (press_id != 0) {
        press_shown_id = press_id;
        press_show = minf(press_show + dt * 14.0, 1.0)
    } else press_show = maxf(press_show - dt * 6.0, 0.0);
    if (press_show > 0.0 && press_show < 1.0) moving = true;
    // The drawer's list glides, and comes back within its ends.
    if (!sheet_dragging && sheet_t > 0.0) {
        sheet_scroll = sheet_scroll + sheet_scroll_v * dt;
        sheet_scroll_v = sheet_scroll_v * expf(-dt * 3.5);
        most: f32 = maxf(sheet_content_h - sheet_list_h(), 0.0);
        if (sheet_scroll < 0.0) {
            sheet_scroll = sheet_scroll * expf(-dt * 18.0);
            sheet_scroll_v = 0.0
        }
        if (sheet_scroll > most) {
            sheet_scroll = most + (sheet_scroll - most) * expf(-dt * 18.0);
            sheet_scroll_v = 0.0
        }
        if (absf(sheet_scroll_v) > 2.0) moving = true
    }
    moving
}

// ---- fingers on the editor's things (see touch.l8) ----
ui_press(b: int, x: f32, y: f32): bool {
    id: int = button_at(x, y);
    // (With the drawer open, anywhere on it is the drawer's, and above it,
    // its shade's, which closes it.)
    if (sheet_t > 0.5 && id < B_PART && id != B_CLOSE) {
        id = B_SHADE;
        if (y >= sheet_top()) id = B_SHEET
    }
    // (With Clear's menu open, a press anywhere but on it closes it: on the
    // board, that is all it does.)
    if (clear_menu && id != B_CLEAR && (id < B_CLEAR_LEVEL || id >= B_CLEAR_LEVEL + 3)) {
        clear_menu = false;
        if (id == B_NONE) {
            press_id = B_NONE;
            press_finger = b;
            return true
        }
    }
    if (id == B_NONE) return false;
    press_id = id;
    press_finger = b;
    press_show = 0.0;
    if (id == B_SHEET || id >= B_PART) {
        sheet_dragging = true;
        sheet_last_y = y;
        sheet_scroll_v = 0.0
    }
    true
}

ui_drag(b: int, x: f32, y: f32) {
    if (b != press_finger) return;
    if (sheet_dragging) {
        dy: f32 = y - sheet_last_y;
        sheet_last_y = y;
        // (Past its ends, it goes reluctantly.)
        most: f32 = maxf(sheet_content_h - sheet_list_h(), 0.0);
        k: f32 = 1.0;
        if (sheet_scroll < 0.0 || sheet_scroll > most) k = 0.4;
        sheet_scroll = sheet_scroll - dy * k;
        if (absf(y - f_y0[b]) > slop()) {
            // (A finger that scrolls has not pressed a part.)
            press_id = B_SHEET;
            sheet_scroll_v = lerpf(sheet_scroll_v, -dy * 60.0, 0.5)
        }
        return
    }
    // (Off its button: let go there, and it does nothing.)
    if (button_at(x, y) != press_id) press_id = B_NONE
}

ui_release(b: int) {
    if (b != press_finger) return;
    id: int = press_id;
    press_id = B_NONE;
    press_finger = -1;
    sheet_dragging = false;
    if (id == B_SHEET || id == B_NONE) return;
    act(id)
}

act(id: int) {
    if (id == B_ARRANGE) set_mode(MODE_ARRANGE);
    if (id == B_ROUTE) set_mode(MODE_ROUTE);
    if (id == B_LAYER) switch_layer();
    if (id == B_UNDO) undo();
    if (id == B_REDO) redo();
    if (id == B_FIT) fit_board();
    if (id == B_ADD) sheet_toggle();
    if (id == B_ROTATE) rotate_part();
    if (id == B_DELETE) delete_picked();
    if (id == B_FLIP) flip_route();
    if (id == B_LOCK) lock_route();
    if (id == B_GUIDE) toggle_guide();
    if (id == B_ALL) start_route_all();
    if (id == B_STOP) stop_job();
    if (id == B_POUR) pour_picked();
    if (id == B_NET && sel_pin >= 0) route_net(pin_net[sel_pin]);
    if (id == B_CLEAR) toggle_clear_menu();
    if (id >= B_CLEAR_LEVEL && id < B_CLEAR_LEVEL + 3) {
        clear_menu = false;
        clear_copper(id - B_CLEAR_LEVEL)
    }
    if (id == B_PROBS) show_problem();
    if (id == B_SHADE || id == B_CLOSE) sheet_close();
    if (id >= B_PART && id < B_PART + fp_n) {
        sheet_close();
        add_new_part(id - B_PART)
    }
}

// ---- drawing ----
// A panel: a dark rounded box with a faint edge and a shadow.
panel(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    r: f32,
    a: f32
) {
    // (Pressing its surface does nothing, but is not the board's.)
    if (a > 0.5) add_button(B_PANEL, x, y, x + w, y + h);
    p_shadow(x, y, w, h, r, 4.0, 14.0, 0.45 * a);
    p_box(x, y, w, h, r, C_PANEL, 0.94 * a);
    p_outline(x, y, w, h, r, 1.0, C_LINE, a)
}

draw_ui() {
    btn_n = 0;
    layout_ui();
    draw_title();
    draw_card();
    draw_clear_menu();
    draw_bar();
    if (clear_menu_t < 0.05) draw_toast();
    draw_sheet()
}

// The board's name, and how far along it is.
draw_title() {
    x: f32 = 12.0 + safe_left;
    y: f32 = safe_top + 10.0;
    line_clear();
    line_name(brd_name);
    tw: f32 = p_text_w(1, 18.0, line, 0, line_n);
    name_n: int = line_n;
    // (The second line, after the name in the same buffer.)
    line_int(nets_done);
    line_add(" of ");
    line_int(nets_wanted);
    line_add(" nets joined");
    line_add("   grid ");
    line_num(grid_step(), 2);
    line_add(" mm");
    sw: f32 = p_text_w(0, 12.5, line, name_n, line_n);
    w: f32 = maxf(tw, sw) + 28.0;
    panel(x, y, w, 50.0, 14.0, 1.0);
    p_text(1, 18.0, x + 14.0, y + 23.0, line, 0, name_n, 0.0, C_INK, 1.0);
    p_text(0, 12.5, x + 14.0, y + 40.0, line, name_n, line_n, 0.0, C_MUTED, 1.0);
    // How many of the nets are joined, as a bar under it all.
    if (nets_wanted > 0) {
        f: f32 = nets_done as f32 / nets_wanted as f32;
        p_box(x + 14.0, y + 45.0, w - 28.0, 2.0, 1.0, C_LINE, 1.0);
        p_box(x + 14.0, y + 45.0, (w - 28.0) * f, 2.0, 1.0, C_GOOD, 1.0)
    }
    // The problems, if any, to the right: a tap goes to the next.
    line_clear();
    rgb: int = C_GOOD;
    if (prob_n == 0) line_add("No problems") else {
        line_int(prob_n);
        if (prob_n == 1) line_add(" problem") else line_add(" problems");
        rgb = C_BAD
    }
    pw: f32 = p_text_w(1, 13.0, line, 0, line_n) + 40.0;
    px: f32 = scr_w as f32 - safe_right - 12.0 - pw;
    // (Not over the title: under it, on a narrow window.)
    py: f32 = y + 9.0;
    if (px < x + w + 8.0) {
        py = y + 58.0;
        px = x
    }
    k: f32 = 1.0 - 0.06 * pressed(B_PROBS);
    cx: f32 = px + pw * 0.5;
    cy: f32 = py + 16.0;
    bw: f32 = pw * k;
    bh: f32 = 32.0 * k;
    panel(cx - bw * 0.5, cy - bh * 0.5, bw, bh, bh * 0.5, 1.0);
    p_disc(cx - bw * 0.5 + 16.0, cy, 4.5, rgb, 1.0);
    if (prob_n > 0) p_glow(cx - bw * 0.5 + 16.0, cy, 7.0, 5.0, rgb, 0.35 + 0.25 * sinf(now_t * 5.0));
    p_text(1, 13.0, cx - bw * 0.5 + 28.0, cy + 4.6, line, 0, line_n, 0.0, C_INK, 1.0);
    add_button(B_PROBS, px, py, px + pw, py + 32.0)
}

// The tools along the bottom.
draw_bar() {
    x: f32 = bar_x;
    y: f32 = bar_y;
    w: f32 = bar_w;
    h: f32 = bar_h;
    panel(x, y, w, h, 18.0, 1.0);
    icon_w: f32 = 46.0;
    icons: int = 5;
    seg_w: f32 = minf((w - 16.0 - icon_w * icons as f32 - 6.0) * 0.5, 120.0);
    sx: f32 = x + 8.0;
    sy: f32 = y + 8.0;
    sh: f32 = h - 16.0;
    // The modes: a track with a slider in it.
    p_box(sx, sy, seg_w * 2.0, sh, 12.0, 922135, 1.0);
    hx: f32 = sx + 3.0 + mode_show * seg_w;
    p_box(hx, sy + 3.0, seg_w - 6.0, sh - 6.0, 10.0, C_PANEL_HI, 1.0);
    p_outline(hx, sy + 3.0, seg_w - 6.0, sh - 6.0, 10.0, 1.0, 3818836, 1.0);
    seg_label(sx, sy, seg_w, sh, "Arrange", 1.0 - mode_show, B_ARRANGE);
    seg_label(sx + seg_w, sy, seg_w, sh, "Route", mode_show, B_ROUTE);
    add_button(B_ARRANGE, sx, sy, sx + seg_w, sy + sh);
    add_button(B_ROUTE, sx + seg_w, sy, sx + 2.0 * seg_w, sy + sh);
    // The icons, at the right end.
    ix: f32 = x + w - 8.0 - icon_w * icons as f32;
    for k in 0..icons {
        id: int = B_LAYER + k;
        bx: f32 = ix + icon_w * k as f32;
        enabled: bool = true;
        if (id == B_UNDO) enabled = can_undo();
        if (id == B_REDO) enabled = can_redo();
        icon_button(id, bx, sy, icon_w, sh, enabled)
    }
}

seg_label(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    t: str,
    on: f32,
    id: int
) {
    size: f32 = 15.0;
    tw: f32 = p_str_w(1, size, t);
    ink: int = mix_rgb(C_MUTED, C_INK, on);
    k: f32 = 1.0 - 0.05 * pressed(id);
    // (A dot of the mode's color, then its name.)
    dot: int = C_PICK;
    if (id == B_ROUTE) dot = layer_rgb(layer_on);
    total: f32 = tw + 14.0;
    lx: f32 = x + (w - total * k) * 0.5;
    p_disc(lx + 4.0, y + h * 0.5, 4.0 * k, mix_rgb(4871523, dot, on), 1.0);
    p_str(1, size * k, lx + 14.0 * k, y + h * 0.5 + size * 0.36 * k, t, ink, 1.0)
}

icon_button(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    enabled: bool
) {
    pr: f32 = pressed(id);
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    if (pr > 0.0) p_disc(cx, cy, 19.0, C_PANEL_HI, pr);
    a: f32 = 1.0;
    if (!enabled) a = 0.3;
    ink: int = C_INK;
    k: f32 = 1.0 - 0.08 * pr;
    draw_icon(id, cx, cy, 10.0 * k, ink, a);
    if (enabled) add_button(id, x, y, x + w, y + h)
}

// The icons, drawn in lines about (x, y), r their half size.
draw_icon(
    id: int,
    x: f32,
    y: f32,
    r: f32,
    rgb: int,
    a: f32
) {
    t: f32 = 2.0;
    if (id == B_LAYER) {
        // Two boards, one over the other: the one on top in its color.
        under: int = layer_rgb(1 - layer_on);
        over: int = layer_rgb(layer_on);
        p_box(x - r * 0.95 + 3.0, y - r * 0.95 + 3.0, r * 1.5, r * 1.5, 3.0, mix_rgb(under,
            C_PANEL, 0.2), a);
        p_box(x - r * 0.95 - 1.0, y - r * 0.95 - 1.0, r * 1.5, r * 1.5, 3.0, over,
            a);
        p_outline(x - r * 0.95 - 1.0, y - r * 0.95 - 1.0, r * 1.5, r * 1.5, 3.0, 1.5,
            C_PANEL, a)
    }
    if (id == B_UNDO || id == B_REDO) {
        d: f32 = 1.0;
        if (id == B_REDO) d = -1.0;
        // An arc over the top, and its head at the start.
        p_arc(x, y + r * 0.25, r * 0.75, t, 3.14159, 3.14159, rgb, a);
        hx: f32 = x - d * r * 0.75;
        hy: f32 = y + r * 0.25;
        p_line(hx, hy + 1.0, hx - d * r * 0.42, hy - r * 0.38, t, rgb, a);
        p_line(hx, hy + 1.0, hx + d * r * 0.45, hy - r * 0.32, t, rgb, a)
    }
    if (id == B_FIT) {
        // Four corners.
        c: f32 = r * 0.9;
        l: f32 = r * 0.45;
        p_line(x - c, y - c, x - c + l, y - c, t, rgb, a);
        p_line(x - c, y - c, x - c, y - c + l, t, rgb, a);
        p_line(x + c, y - c, x + c - l, y - c, t, rgb, a);
        p_line(x + c, y - c, x + c, y - c + l, t, rgb, a);
        p_line(x - c, y + c, x - c + l, y + c, t, rgb, a);
        p_line(x - c, y + c, x - c, y + c - l, t, rgb, a);
        p_line(x + c, y + c, x + c - l, y + c, t, rgb, a);
        p_line(x + c, y + c, x + c, y + c - l, t, rgb, a);
        p_box(x - r * 0.3, y - r * 0.3, r * 0.6, r * 0.6, 1.5, rgb, a * 0.8)
    }
    if (id == B_ADD) {
        p_disc(x, y, r * 1.2, C_PICK, a);
        p_line(x - r * 0.55, y, x + r * 0.55, y, t + 0.5, 856085, a);
        p_line(x, y - r * 0.55, x, y + r * 0.55, t + 0.5, 856085, a)
    }
    if (id == B_ROTATE) {
        p_arc(x, y, r * 0.8, t, -1.2, 4.9, rgb, a);
        hx: f32 = x + r * 0.8 * cosf(-1.2);
        hy: f32 = y + r * 0.8 * sinf(-1.2);
        p_line(hx, hy, hx - r * 0.5, hy - r * 0.1, t, rgb, a);
        p_line(hx, hy, hx + r * 0.05, hy + r * 0.5, t, rgb, a)
    }
    if (id == B_DELETE) {
        p_outline(x - r * 0.6, y - r * 0.45, r * 1.2, r * 1.45, 2.0, t, rgb, a);
        p_line(x - r * 0.85, y - r * 0.7, x + r * 0.85, y - r * 0.7, t, rgb, a);
        p_line(x - r * 0.25, y - r * 0.95, x + r * 0.25, y - r * 0.95, t, rgb, a);
        p_line(x - r * 0.18, y - r * 0.15, x - r * 0.18, y + r * 0.7, 1.5, rgb, a);
        p_line(x + r * 0.18, y - r * 0.15, x + r * 0.18, y + r * 0.7, 1.5, rgb, a)
    }
    if (id == B_VIA) {
        p_disc(x, y, r * 0.95, C_PAD, a);
        p_disc(x, y, r * 0.42, C_HOLE, a)
    }
    if (id == B_FLIP) {
        p_outline(x - r * 0.9 + 3.0, y - r * 0.9 + 3.0, r * 1.4, r * 1.4, 2.5, 1.5,
            rgb, a);
        p_box(x - r * 0.9 - 1.0, y - r * 0.9 - 1.0, r * 1.4, r * 1.4, 2.5, rgb, a * 0.8)
    }
    if (id == B_LOCK) {
        p_box(x - r * 0.7, y - r * 0.15, r * 1.4, r * 1.05, 2.0, rgb, a);
        p_arc(x, y - r * 0.2, r * 0.45, t * 0.8, 3.14159, 3.14159, rgb, a);
        p_line(x - r * 0.45, y - r * 0.2, x - r * 0.45, y - r * 0.05, t * 0.8, rgb,
            a);
        p_line(x + r * 0.45, y - r * 0.2, x + r * 0.45, y - r * 0.05, t * 0.8, rgb,
            a)
    }
    if (id == B_GUIDE) {
        p_arc(x - r * 0.35, y + r * 0.1, r * 0.55, t, 3.14159, 3.14159, rgb, a);
        p_arc(x + r * 0.35, y - r * 0.1, r * 0.55, t, 0.0, 3.14159, rgb, a)
    }
    if (id == B_ALL || id == B_NET) {
        p_line(x - r * 0.8, y + r * 0.8, x + r * 0.25, y - r * 0.25, t, rgb, a);
        p_line(x + r * 0.55, y - r * 0.95, x + r * 0.55, y - r * 0.35, 1.5, rgb, a);
        p_line(x + r * 0.25, y - r * 0.65, x + r * 0.85, y - r * 0.65, 1.5, rgb, a)
    }
    if (id == B_CLEAR) {
        p_line(x - r * 0.8, y + r * 0.6, x + r * 0.8, y + r * 0.6, t, rgb, a);
        p_line(x - r * 0.5, y + r * 0.35, x + r * 0.35, y - r * 0.6, t, rgb, a);
        p_line(x + r * 0.35, y - r * 0.6, x + r * 0.75, y - r * 0.25, t, rgb, a)
    }
    if (id == B_STOP) p_box(x - r * 0.55, y - r * 0.55, r * 1.1, r * 1.1, 2.0, rgb,
        a);
    if (id == B_POUR) {
        p_box(x - r * 0.8, y - r * 0.8, r * 1.6, r * 1.6, 3.0, rgb, a * 0.35);
        p_outline(x - r * 0.8, y - r * 0.8, r * 1.6, r * 1.6, 3.0, 1.5, rgb, a)
    }
    if (id == B_DONE) {
        p_line(x - r * 0.75, y + r * 0.05, x - r * 0.2, y + r * 0.6, t + 0.5, rgb,
            a);
        p_line(x - r * 0.2, y + r * 0.6, x + r * 0.8, y - r * 0.55, t + 0.5, rgb,
            a)
    }
    if (id == B_CLOSE) {
        p_line(x - r * 0.6, y - r * 0.6, x + r * 0.6, y + r * 0.6, t, rgb, a);
        p_line(x + r * 0.6, y - r * 0.6, x - r * 0.6, y + r * 0.6, t, rgb, a)
    }
}

// A pill with an icon and a word, on the card.
pill_button(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    t: str,
    strong: bool,
    a: f32
) {
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.05 * pr;
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    bw: f32 = w * k;
    bh: f32 = h * k;
    fill: int = C_PANEL_HI;
    ink: int = C_INK;
    if (strong) {
        fill = C_PICK;
        ink = 856085
    }
    p_box(cx - bw * 0.5, cy - bh * 0.5, bw, bh, bh * 0.5, mix_rgb(fill, 16777215,
        0.12 * pr), a);
    tw: f32 = p_str_w(1, 14.0, t);
    total: f32 = 22.0 + tw;
    lx: f32 = cx - total * 0.5;
    draw_icon(id, lx + 8.0, cy, 7.5, ink, a);
    p_str(1, 14.0, lx + 22.0, cy + 5.0, t, ink, a);
    add_button(id, x, y, x + w, y + h)
}

// ---- Clear's menu ----
// Over the card: how far to clear, each with what it would take up.
clear_menu: bool = false;

clear_menu_t: f32 = 0.0;

toggle_clear_menu() {
    clear_menu = !clear_menu
}

draw_clear_menu() {
    if (clear_menu_t <= 0.01) return;
    a: f32 = clear_menu_t;
    row_h: f32 = 56.0;
    h: f32 = 40.0 + 3.0 * row_h + 8.0;
    x: f32 = bar_x;
    w: f32 = bar_w;
    card_top: f32 = bar_y - 10.0 - 66.0;
    y: f32 = card_top - 8.0 - h + (1.0 - a) * 14.0;
    panel(x, y, w, h, 18.0, a);
    p_str(1, 15.0, x + 16.0, y + 26.0, "Clear how much?", C_INK, a);
    p_str(0, 12.0, x + w - 16.0 - p_str_w(0, 12.0, "Undo brings it back"), y + 26.0,
        "Undo brings it back", C_MUTED, a);
    for k in 0..3 {
        ry: f32 = y + 40.0 + k as f32 * row_h;
        clear_row(k, x + 8.0, ry, w - 16.0, row_h - 4.0, a)
    }
}

clear_row(
    level: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    a: f32
) {
    id: int = B_CLEAR_LEVEL + level;
    n: int = clear_count(level);
    on: bool = n > 0;
    pr: f32 = pressed(id);
    fill: int = mix_rgb(C_PANEL_HI, 16777215, 0.08 * pr);
    p_box(x, y, w, h, 12.0, fill, a);
    k: f32 = 1.0;
    if (!on) k = 0.35;
    ink: int = C_INK;
    if (level == CLEAR_ALL) ink = C_BAD;
    title: str = "Free routes";
    sub: str = "What routing made that is not locked";
    if (level == CLEAR_ROUTES) {
        title = "All routes";
        sub = "Locked ones too"
    }
    if (level == CLEAR_ALL) {
        title = "All copper";
        sub = "Routes, hand-laid tracks and vias, pours: a bare board"
    }
    p_str(1, 15.0, x + 14.0, y + 22.0, title, ink, a * k);
    room: f32 = w - 80.0;
    ss: f32 = 12.0;
    sw: f32 = p_str_w(0, ss, sub);
    if (sw > room) ss = ss * room / sw;
    p_str(0, ss, x + 14.0, y + 40.0, sub, C_MUTED, a * k);
    line_clear();
    line_int(n);
    cw: f32 = p_text_w(1, 15.0, line, 0, line_n);
    p_text(1, 15.0, x + w - 14.0 - cw, y + h * 0.5 + 5.0, line, 0, line_n, 0.0, C_MUTED,
        a * k);
    if (on) add_button(id, x, y, x + w, y + h)
}

// A pill sized to its word, put left of x (the right end of the room
// left): where the room now ends.
pill_right(
    id: int,
    x: f32,
    y: f32,
    h: f32,
    t: str,
    strong: bool,
    a: f32
): f32 {
    w: f32 = p_str_w(1, 14.0, t) + 40.0;
    pill_button(id, x - w, y, w, h, t, strong, a);
    x - w - 6.0
}

// The card for what is picked: what it is, a line about it, and what can
// be done to it.
draw_card() {
    if (card_show <= 0.01) return;
    a: f32 = card_show;
    h: f32 = 66.0;
    x: f32 = bar_x;
    w: f32 = bar_w;
    y: f32 = bar_y - 10.0 - h + (1.0 - card_show) * 24.0;
    panel(x, y, w, h, 18.0, a);
    // The words, into line: a title and, after it, a second line.
    line_clear();
    sub: int = card_words();
    // The actions, from the right.
    bx: f32 = x + w - 10.0;
    bh: f32 = 40.0;
    by: f32 = y + (h - bh) * 0.5;
    if (job_on) bx = pill_right(B_STOP, bx, by, bh, "Stop", true, a) else if (guide_on) bx = pill_right(B_GUIDE,
        bx, by, bh, "Cancel", false, a) else if (sel_route >= 0) {
        r: int = sel_route;
        if (sel_point >= 1 && sel_point < ro_np[r] - 1) bx = pill_right(B_DELETE,
            bx, by, bh, "Take out", false, a) else bx = pill_right(B_DELETE, bx, by,
            bh, "Take up", false, a);
        if (ro_locked[r]) bx = pill_right(B_LOCK, bx, by, bh, "Free", false, a) else bx = pill_right(B_LOCK,
            bx, by, bh, "Lock", false, a);
        if (ro_layer[r] == TOP) bx = pill_right(B_FLIP, bx, by, bh, "Bottom", false,
            a) else bx = pill_right(B_FLIP, bx, by, bh, "Top", false, a)
    } else if (sel_part >= 0) {
        bx = pill_right(B_DELETE, bx, by, bh, "Delete", false, a);
        bx = pill_right(B_ROTATE, bx, by, bh, "Rotate", false, a)
    } else if (sel_seg >= 0 || sel_via >= 0) bx = pill_right(B_DELETE, bx, by, bh,
        "Delete", false, a) else if (sel_pin >= 0 && pin_net[sel_pin] >= 0) {
        n: int = pin_net[sel_pin];
        if (pour_net[BOTTOM] == n) bx = pill_right(B_POUR, bx, by, bh, "Unpour", false,
            a) else bx = pill_right(B_POUR, bx, by, bh, "Pour", false, a);
        if (net_left[n] > 0) bx = pill_right(B_NET, bx, by, bh, "Route", true, a)
    } else if (mode == MODE_ROUTE) {
        bx = pill_right(B_ALL, bx, by, bh, "Route all", true, a);
        bx = pill_right(B_GUIDE, bx, by, bh, "Guide", false, a);
        if (clear_count(CLEAR_ALL) > 0) bx = pill_right(B_CLEAR, bx, by, bh, "Clear",
            clear_menu, a)
    }
    room: f32 = bx - x - 22.0;
    // (Each line made to fit what room the buttons leave.)
    ts: f32 = 17.0;
    tw: f32 = p_text_w(1, ts, line, 0, sub);
    if (tw > room) ts = ts * room / tw;
    p_text(1, ts, x + 16.0, y + 28.0, line, 0, sub, 0.0, C_INK, a);
    ss: f32 = 12.5;
    sw: f32 = p_text_w(0, ss, line, sub, line_n);
    if (sw > room) ss = ss * room / sw;
    p_text(0, ss, x + 16.0, y + 47.0, line, sub, line_n, 0.0, C_MUTED, a)
}

// The card's words, into line: where the second line starts.
card_words(): int {
    if (rep_on) {
        line_add("Routing all");
        sub2: int = line_n;
        line_add("Trying again where it found no way");
        return sub2
    }
    if (job_on) {
        line_add("Routing all");
        sub0: int = line_n;
        line_int(job_at);
        line_add(" of ");
        line_int(job_n);
        line_add(" tried, ");
        line_int(job_ok);
        line_add(" through");
        return sub0
    }
    if (guide_on) {
        line_add("Guide");
        sub1: int = line_n;
        line_add("Draw from one part to another, the way the bus should go");
        return sub1
    }
    if (sel_route >= 0) {
        r: int = sel_route;
        point: bool = sel_point >= 1 && sel_point < ro_np[r] - 1;
        if (point) line_add("Waypoint") else if (ro_net[r] >= 0) line_name(net_name[ro_net[r]]) else line_add("Route");
        if (ro_locked[r]) line_add("  locked");
        sub2: int = line_n;
        if (point && ro_net[r] >= 0) {
            line_name(net_name[ro_net[r]]);
            line_add(": ")
        }
        if (!ro_ok[r]) {
            line_add("No way through: drag it to show the way, or try the other layer");
            return sub2
        }
        l: f32 = 0.0;
        vias: int = 0;
        for k in 0..segs_n {
            if (sg_route[k] == r) {
                dx: f32 = sg_x1[k] - sg_x0[k];
                dy: f32 = sg_y1[k] - sg_y0[k];
                l = l + sqrtf(dx * dx + dy * dy)
            }
        }
        for k in 0..vias_n {
            if (via_route[k] == r) vias = vias + 1
        }
        line_num(l, 1);
        line_add(" mm");
        if (vias > 0) {
            line_add(", ");
            line_int(vias);
            if (vias == 1) line_add(" via") else line_add(" vias")
        }
        line_add(". Drag it to steer it");
        return sub2
    }
    if (sel_part < 0 && sel_pin < 0 && sel_seg < 0 && sel_via < 0 && mode == MODE_ROUTE) {
        line_add("Route");
        sub3: int = line_n;
        line_int(wire_n);
        line_add(" to connect. Tap a line to route it; drag it to steer");
        return sub3
    }
    if (sel_part >= 0) {
        p: int = sel_part;
        f: int = part_fp[p];
        line_name(part_ref[p]);
        line_add("  ");
        if (part_value[p] >= 0) line_name(part_value[p]) else line_name(fp_title[f]);
        sub2: int = line_n;
        line_name(fp_title[f]);
        line_add(", ");
        line_name(fp_pkg[f]);
        line_add(" at ");
        line_num(part_x[p], 2);
        line_add(", ");
        line_num(part_y[p], 2);
        return sub2
    }
    if (sel_pin >= 0) {
        q: int = sel_pin;
        line_name(part_ref[pin_part[q]]);
        line_add(".");
        line_name(lp_name[pin_pad[q]]);
        sub3: int = line_n;
        n: int = pin_net[q];
        if (n < 0) line_add("No net: route from it to give it one") else {
            line_add("Net ");
            line_name(net_name[n]);
            line_add(", ");
            line_int(net_count[n]);
            line_add(" pins, ");
            if (net_left[n] == 0) line_add("all joined") else {
                line_int(net_left[n]);
                line_add(" to join")
            }
        }
        return sub3
    }
    if (sel_seg >= 0) {
        s: int = sel_seg;
        line_add("Track");
        if (sg_net[s] >= 0) {
            line_add(", ");
            line_name(net_name[sg_net[s]])
        }
        sub4: int = line_n;
        line_num(sg_w[s], 2);
        line_add(" mm wide, ");
        dx: f32 = sg_x1[s] - sg_x0[s];
        dy: f32 = sg_y1[s] - sg_y0[s];
        line_num(sqrtf(dx * dx + dy * dy), 2);
        line_add(" mm long, on the ");
        if (sg_layer[s] == TOP) line_add("top") else line_add("bottom");
        return sub4
    }
    if (sel_via >= 0) {
        v: int = sel_via;
        line_add("Via");
        if (via_net[v] >= 0) {
            line_add(", ");
            line_name(net_name[via_net[v]])
        }
        sub5: int = line_n;
        line_num(via_d[v], 2);
        line_add(" mm, ");
        line_num(via_drill[v], 2);
        line_add(" mm hole");
        return sub5
    }
    line_n
}

draw_toast() {
    if (toast_t >= 2.6 || toast_n == 0) return;
    a: f32 = clampf(toast_t * 8.0, 0.0, 1.0) * clampf((2.6 - toast_t) * 3.0, 0.0,
        1.0);
    size: f32 = 14.0;
    tw: f32 = p_text_w(1, size, toast_buf, 0, toast_n);
    w: f32 = minf(tw + 32.0, scr_w as f32 - 24.0);
    if (tw + 32.0 > w) size = size * (w - 32.0) / tw;
    h: f32 = 36.0;
    x: f32 = (scr_w as f32 - w) * 0.5;
    y: f32 = bar_y - 10.0 - h - card_show * 76.0 + (1.0 - a) * 8.0;
    p_shadow(x, y, w, h, h * 0.5, 3.0, 12.0, 0.5 * a);
    p_box(x, y, w, h, h * 0.5, 15659766, 0.96 * a);
    p_text(1, size, x + 16.0, y + h * 0.5 + size * 0.36, toast_buf, 0, toast_n, 0.0,
        1053980, a)
}

// ---- the drawer of parts ----
sheet_top(): f32 {
    full: f32 = minf(scr_h as f32 * 0.66, scr_h as f32 - safe_top - 80.0);
    scr_h as f32 - full * sheet_t
}

sheet_list_h(): f32 {
    scr_h as f32 - sheet_top() - 64.0 - safe_bottom
}

draw_sheet() {
    if (sheet_t <= 0.003) return;
    a: f32 = sheet_t;
    // The shade over everything else.
    p_box(0.0, 0.0, scr_w as f32, scr_h as f32, 0.0, 0, 0.45 * a);
    top: f32 = sheet_top();
    w: f32 = minf(scr_w as f32, 720.0);
    x: f32 = (scr_w as f32 - w) * 0.5;
    p_shadow(x, top, w, scr_h as f32 - top + 40.0, 22.0, -2.0, 18.0, 0.6 * a);
    p_box(x, top, w, scr_h as f32 - top + 40.0, 22.0, C_PANEL, 1.0);
    p_box(x + w * 0.5 - 20.0, top + 8.0, 40.0, 4.0, 2.0, C_LINE, 1.0);
    p_str(1, 19.0, x + 18.0, top + 40.0, "Add a part", C_INK, 1.0);
    p_str(0, 12.5, x + 18.0, top + 57.0, "From the handheld's parts. Tap one to put it on the board.",
        C_MUTED, 1.0);
    icon_button(B_CLOSE, x + w - 56.0, top + 12.0, 46.0, 40.0, true);
    // The list: cards in two columns (three when wide), scrolling.
    list_y: f32 = top + 66.0;
    p_clip(x, list_y, x + w, scr_h as f32);
    cols: int = 2;
    if (w > 560.0) cols = 3;
    gap: f32 = 10.0;
    cw: f32 = (w - 28.0 - gap * (cols - 1) as f32) / cols as f32;
    ch: f32 = 132.0;
    rows: int = (fp_n + cols - 1) / cols;
    sheet_content_h = rows as f32 * (ch + gap) + 20.0 + safe_bottom;
    for f in 0..fp_n {
        col: int = f % cols;
        row: int = f / cols;
        cx: f32 = x + 14.0 + col as f32 * (cw + gap);
        cy: f32 = list_y + 6.0 + row as f32 * (ch + gap) - sheet_scroll;
        if (cy + ch > list_y - 4.0 && cy < scr_h as f32) part_card(f, cx, cy, cw,
            ch)
    }
    p_noclip()
}

// A card for footprint f: its pads drawn small, what it is, its package.
part_card(
    f: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    id: int = B_PART + f;
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.04 * pr;
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    bw: f32 = w * k;
    bh: f32 = h * k;
    bx: f32 = cx - bw * 0.5;
    by: f32 = cy - bh * 0.5;
    p_box(bx, by, bw, bh, 14.0, mix_rgb(1844012, 2765888, pr), 1.0);
    // The picture: its courtyard fitted into the card's top.
    pic_h: f32 = bh - 52.0;
    fw: f32 = fp_cx1[f] - fp_cx0[f];
    fh: f32 = fp_cy1[f] - fp_cy0[f];
    s: f32 = minf((bw - 30.0) / fw, (pic_h - 14.0) / fh);
    s = minf(s, 14.0);
    ox: f32 = cx - (fp_cx0[f] + fp_cx1[f]) * 0.5 * s;
    oy: f32 = by + 8.0 + pic_h * 0.5 + (fp_cy0[f] + fp_cy1[f]) * 0.5 * s;
    p_box(bx + 6.0, by + 6.0, bw - 12.0, pic_h, 10.0, C_MASK, 1.0);
    if (fp_bw[f] > 0.0) {
        if (fp_round[f]) p_ring(ox, oy, fp_bw[f] * 0.5 * s, 1.2, C_SILK, 0.6) else p_outline(ox - fp_bw[f] * 0.5 * s,
            oy - fp_bh[f] * 0.5 * s, fp_bw[f] * s, fp_bh[f] * s, 1.5, 1.2, C_SILK,
            0.6)
    }
    for i in fp_pad0[f]..fp_pad0[f] + fp_npads[f] {
        px: f32 = ox + lp_x[i] * s;
        py: f32 = oy - lp_y[i] * s;
        if (lp_plated[i]) p_box_at(px, py, maxf(lp_w[i] * 0.5 * s, 0.6), maxf(lp_h[i] * 0.5 * s,
            0.6), lp_r[i] * s, C_PAD, 1.0);
        if (lp_drill[i] > 0.0) {
            sh: f32 = lp_slot[i];
            if (sh <= 0.0) sh = lp_drill[i];
            hw: f32 = maxf(lp_drill[i] * 0.5 * s, 0.5);
            hh: f32 = maxf(sh * 0.5 * s, 0.5);
            p_box_at(px, py, hw, hh, minf(hw, hh), C_HOLE, 1.0)
        }
    }
    line_clear();
    line_name(fp_title[f]);
    ts: f32 = 14.0;
    tw: f32 = p_text_w(1, ts, line, 0, line_n);
    if (tw > bw - 20.0) ts = ts * (bw - 20.0) / tw;
    p_text(1, ts, bx + 10.0, by + bh - 26.0, line, 0, line_n, 0.0, C_INK, 1.0);
    line_clear();
    line_name(fp_pkg[f]);
    line_add(", ");
    line_int(fp_npads[f]);
    line_add(" pads");
    ss: f32 = 11.5;
    sw: f32 = p_text_w(0, ss, line, 0, line_n);
    if (sw > bw - 20.0) ss = ss * (bw - 20.0) / sw;
    p_text(0, ss, bx + 10.0, by + bh - 10.0, line, 0, line_n, 0.0, C_MUTED, 1.0);
    add_button(id, x, maxf(y, sheet_top() + 66.0), x + w, y + h)
}
