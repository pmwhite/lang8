tag cad;

use_tag std, gl, x11, skate;

// The viewer's own things, drawn over the board: the design's name and
// size, top left (a tap opens the designs' menu), with its problems (a
// tap goes to each in turn) and Make it top right; along the bottom the
// ways of looking (Parts, Copper, Case), the parts list, the side on top,
// and fit; over them a card for what is picked out, or the layer shown; a
// word now and then (a toast); and the drawer with the parts list.
//
// Buttons are made as they are drawn, each frame, and pressed against what
// the last frame drew. A button acts when the finger lifts on it.
const B_NONE: int = 0;

const B_ARRANGE: int = 1;

const B_ROUTE: int = 2;

const B_LAYER: int = 3;

const B_FIT: int = 6;

const B_ADD: int = 7;

const B_PROBS: int = 12;

const B_SHADE: int = 13;

const B_SHEET: int = 14;

const B_CLOSE: int = 15;

const B_PANEL: int = 30;

const B_CASE: int = 40;

const B_CASE_UP: int = 42;

const B_CASE_DOWN: int = 43;

const B_3D: int = 52;

const B_FLAT: int = 53;

const B_EXPLODE: int = 54;

const B_DESIGNS: int = 55;

const B_DESIGN: int = 56;

const B_SET: int = 64;

const B_LID: int = 65;

const B_STEPS: int = 70;

const B_STEP_NEXT: int = 71;

const B_STEP_BACK: int = 72;

const B_STEP_CLOSE: int = 73;

const B_PART: int = 100;

const C_PANEL: int = 1382945; // #151a21

const C_PANEL_HI: int = 2304822; // #232b36

const C_LINE: int = 2897218; // #2c3542

const C_INK: int = 15659766; // #eef2f6

const C_MUTED: int = 9279912; // #8d99a8

const BUTTONS: int = 128;

btn_n: int = 0;

btn_id: []int = static_buffer(BUTTONS, 0);

btn_x0: []f32 = static_buffer(BUTTONS, 0.0);

btn_y0: []f32 = static_buffer(BUTTONS, 0.0);

btn_x1: []f32 = static_buffer(BUTTONS, 0.0);

btn_y1: []f32 = static_buffer(BUTTONS, 0.0);

// The button a finger is on (and which finger), and how pressed it shows.
press_id: int = 0;

press_finger: int = -1;

press_show: f32 = 0.0;

press_shown_id: int = 0;

add_button(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    if (btn_n >= BUTTONS) return;
    btn_id[btn_n] = id;
    btn_x0[btn_n] = x0;
    btn_y0[btn_n] = y0;
    btn_x1[btn_n] = x1;
    btn_y1[btn_n] = y1;
    btn_n = btn_n + 1
}

// The button at (x, y), the last drawn first (it is on top).
button_at(x: f32, y: f32): int {
    k: int = btn_n - 1;
    while (k >= 0) {
        // (A little room round each, for fingers.)
        if (x >= btn_x0[k] - 3.0 && x <= btn_x1[k] + 3.0 && y >= btn_y0[k] - 3.0 && y <= btn_y1[k] + 3.0) return btn_id[k];
        k = k - 1
    }
    B_NONE
}

// How pressed button id shows (0 to 1).
pressed(id: int): f32 {
    if (press_shown_id == id) return press_show;
    0.0
}

// ---- layout ----
bar_x: f32 = 0.0;

bar_y: f32 = 0.0;

bar_w: f32 = 400.0;

bar_h: f32 = 58.0;

layout_ui() {
    bar_w = minf(scr_w as f32 - 20.0 - safe_left - safe_right, 580.0);
    bar_h = 58.0;
    bar_x = (scr_w as f32 - bar_w) * 0.5;
    bar_y = scr_h as f32 - safe_bottom - 12.0 - bar_h;
    // (Under the title, and the problems and Make it when a narrow window
    // puts them under it: as the last frame drew them.)
    title_geom();
    view_top = maxf(safe_top + 70.0, title_bottom + 10.0);
    view_bottom = safe_bottom + bar_h + 24.0;
    // (And the card over the bar, when there is one: fit shows the board
    // above it.)
    v3_left = 0.0;
    if (card_wanted()) {
        card_shape_now();
        // (The steps' card on a short, wide window: a column at the left,
        // the room right of it the 3D's.)
        if (card_side()) v3_left = steps_card_w() + 24.0 + safe_left else view_bottom = view_bottom + card_h + 10.0
    }
}

// Whether the steps' card is shown, and as a column at the left.
steps_card(): bool {
    sp_on && view3d && mode == MODE_CASE && cs_on && !stage_on
}

steps_side(): bool {
    steps_card() && card_side()
}

// Whether the card is a column at the left: in 3D on a short, wide
// window, where under the model there is no room for it.
card_side(): bool {
    in_3d() && scr_w > scr_h && scr_h < 600
}

steps_card_w(): f32 {
    if (card_side()) return minf(340.0, scr_w as f32 * 0.42);
    bar_w
}

// How far down the title's things reach; how tall the card is, as last
// drawn.
title_bottom: f32 = 0.0;

card_h: f32 = 66.0;

// ---- motion ----
// The modes' slider (0 Arrange to 1 Route), the card (how far in, and
// what it shows), the toast, and the drawer.
mode_show: f32 = 0.0;

card_show: f32 = 0.0;

toast_buf: []i8 = static_buffer([200]i8);

toast_n: int = 0;

toast_t: f32 = 10.0;

sheet_open: bool = false;

sheet_t: f32 = 0.0;

sheet_scroll: f32 = 0.0;

sheet_scroll_v: f32 = 0.0;

sheet_dragging: bool = false;

sheet_last_y: f32 = 0.0;

sheet_content_h: f32 = 0.0;

toast_line() {
    // (The same words again, while they show: they stay, not shown anew.)
    if (toast_t < 2.6 && toast_n == line_n) {
        same: bool = true;
        for i in 0..toast_n {
            if (toast_buf[i] != line[i]) same = false
        }
        if (same) {
            toast_t = minf(toast_t, 0.3);
            return
        }
    }
    toast_n = mini(line_n, len(toast_buf));
    for i in 0..toast_n toast_buf[i] = line[i];
    toast_t = 0.0
}

toast_str(t: str) {
    line_clear();
    line_add(t);
    toast_line()
}

sheet_toggle() {
    if (sheet_open) sheet_close() else {
        sheet_open = true;
        sheet_scroll_v = 0.0
    }
}

sheet_close() {
    sheet_open = false;
    sheet_dragging = false
}

// Whether a card shows, for what is picked.
card_wanted(): bool {
    !sheet_open && !order_open && (sel_part >= 0 || sel_pin >= 0 || sel_seg >= 0 || sel_via >= 0 || sel_route >= 0 || mode == MODE_ROUTE || mode == MODE_CASE)
}

step_ui(dt: f32): bool {
    moving: bool = false;
    target: f32 = mode as f32;
    k: f32 = 1.0 - expf(-dt * 16.0);
    if (absf(mode_show - target) > 0.001) {
        mode_show = lerpf(mode_show, target, k);
        moving = true
    } else mode_show = target;
    ct: f32 = 0.0;
    if (card_wanted()) ct = 1.0;
    if (absf(card_show - ct) > 0.001) {
        card_show = lerpf(card_show, ct, 1.0 - expf(-dt * 18.0));
        moving = true
    } else card_show = ct;
    if (step_3d(dt)) moving = true;
    if (step_stage(dt)) moving = true;
    dm: f32 = 0.0;
    if (design_menu) dm = 1.0;
    if (absf(design_menu_t - dm) > 0.001) {
        design_menu_t = lerpf(design_menu_t, dm, 1.0 - expf(-dt * 20.0));
        moving = true
    } else design_menu_t = dm;
    ot: f32 = 0.0;
    if (order_open) ot = 1.0;
    if (absf(order_t - ot) > 0.001) {
        order_t = lerpf(order_t, ot, 1.0 - expf(-dt * 14.0));
        moving = true
    } else order_t = ot;
    st: f32 = 0.0;
    if (sheet_open) st = 1.0;
    if (absf(sheet_t - st) > 0.001) {
        sheet_t = lerpf(sheet_t, st, 1.0 - expf(-dt * 13.0));
        moving = true
    } else sheet_t = st;
    if (toast_t < 2.6) {
        toast_t = toast_t + dt;
        moving = true
    }
    // The button pressed: in quickly, out slowly.
    if (press_id != 0) {
        press_shown_id = press_id;
        press_show = minf(press_show + dt * 14.0, 1.0)
    } else press_show = maxf(press_show - dt * 6.0, 0.0);
    if (press_show > 0.0 && press_show < 1.0) moving = true;
    // The drawer's list glides, and comes back within its ends.
    if (!sheet_dragging && sheet_t > 0.0) {
        sheet_scroll = sheet_scroll + sheet_scroll_v * dt;
        sheet_scroll_v = sheet_scroll_v * expf(-dt * 3.5);
        most: f32 = maxf(sheet_content_h - sheet_list_h(), 0.0);
        if (sheet_scroll < 0.0) {
            sheet_scroll = sheet_scroll * expf(-dt * 18.0);
            sheet_scroll_v = 0.0
        }
        if (sheet_scroll > most) {
            sheet_scroll = most + (sheet_scroll - most) * expf(-dt * 18.0);
            sheet_scroll_v = 0.0
        }
        if (absf(sheet_scroll_v) > 2.0) moving = true
    }
    moving
}

// ---- fingers on the editor's things (see touch.l8) ----
ui_press(b: int, x: f32, y: f32): bool {
    id: int = button_at(x, y);
    // (With the drawer open, anywhere on it is the drawer's, and above it,
    // its shade's, which closes it.)
    if (sheet_t > 0.5 && id < B_PART && id != B_CLOSE) {
        id = B_SHADE;
        if (y >= sheet_top()) id = B_SHEET
    }
    // (With the designs' menu open, a press on the board shuts it, and is
    // nothing else.)
    if (design_menu && id == B_NONE) {
        design_menu = false;
        press_id = B_NONE;
        press_finger = b;
        return true
    }
    if (id == B_NONE) return false;
    // (The making panel's own face: a finger on it scrolls it.)
    if (order_t > 0.5 && id == B_PANEL) {
        order_dragging = true;
        order_last_y = y
    }
    press_id = id;
    press_finger = b;
    press_show = 0.0;
    if (id == B_SHEET || id >= B_PART) {
        sheet_dragging = true;
        sheet_last_y = y;
        sheet_scroll_v = 0.0
    }
    true
}

ui_drag(b: int, x: f32, y: f32) {
    if (b != press_finger) return;
    if (order_dragging) {
        order_scroll_by(order_last_y - y);
        order_last_y = y;
        return
    }
    if (sheet_dragging) {
        dy: f32 = y - sheet_last_y;
        sheet_last_y = y;
        // (Past its ends, it goes reluctantly.)
        most: f32 = maxf(sheet_content_h - sheet_list_h(), 0.0);
        k: f32 = 1.0;
        if (sheet_scroll < 0.0 || sheet_scroll > most) k = 0.4;
        sheet_scroll = sheet_scroll - dy * k;
        if (absf(y - f_y0[b]) > slop()) {
            // (A finger that scrolls has not pressed a part.)
            press_id = B_SHEET;
            sheet_scroll_v = lerpf(sheet_scroll_v, -dy * 60.0, 0.5)
        }
        return
    }
    // (Off its button: let go there, and it does nothing.)
    if (button_at(x, y) != press_id) press_id = B_NONE
}

ui_release(b: int) {
    if (b != press_finger) return;
    id: int = press_id;
    press_id = B_NONE;
    press_finger = -1;
    sheet_dragging = false;
    order_dragging = false;
    if (id == B_SHEET || id == B_NONE) return;
    act(id)
}

act(id: int) {
    // (The title opens the designs' menu; anything else shuts it.)
    if (id == B_DESIGNS) {
        design_menu = !design_menu;
        return
    }
    design_menu = false;
    if (id >= B_DESIGN && id < B_DESIGN + DESIGNS) {
        design_pending = id - B_DESIGN;
        // (The set's "The dock": the dock in 3D, as the set was.)
        design_keep_3d = stage_on
    }
    if (id == B_SET) design_pending = STAGE;
    if (id == B_LID) stage_lid_off = !stage_lid_off;
    // (Leaving the set's 3D view: back to the design it was opened from.)
    if (stage_on && (id == B_ARRANGE || id == B_ROUTE || id == B_CASE || id == B_FLAT)) design_pending = design_on;
    if (id == B_ARRANGE) set_mode(MODE_ARRANGE);
    if (id == B_ROUTE) set_mode(MODE_ROUTE);
    if (id == B_CASE) set_mode(MODE_CASE);
    if (id >= B_MAKE && id <= B_ADAFRUIT) order_pending = id;
    if (id == B_CASE_UP) case_step(1);
    if (id == B_CASE_DOWN) case_step(-1);
    if (id == B_3D) {
        view3d = true;
        v3_fit()
    }
    if (id == B_FLAT) {
        view3d = false;
        steps_end()
    }
    if (id == B_STEPS) {
        steps_begin();
        v3_fit()
    }
    if (id == B_STEP_NEXT) steps_next();
    if (id == B_STEP_BACK) steps_back();
    if (id == B_STEP_CLOSE) steps_end();
    if (id == B_EXPLODE) {
        exploded = !exploded;
        explode_fit = true
    }
    if (id == B_LAYER) switch_layer();
    if (id == B_FIT && in_3d()) v3_fit() else if (id == B_FIT) fit_board();
    if (id == B_ADD) sheet_toggle();
    if (id == B_PROBS) show_problem();
    if (id == B_SHADE || id == B_CLOSE) sheet_close();
    // (A row of the parts list: its first part, picked and shown.)
    if (id >= B_PART && id < B_PART + bom_n) {
        sheet_close();
        show_part(bom_first[id - B_PART])
    }
}

// ---- drawing ----
// A panel: a dark rounded box with a faint edge and a shadow.
panel(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    r: f32,
    a: f32
) {
    // (Pressing its surface does nothing, but is not the board's.)
    if (a > 0.5) add_button(B_PANEL, x, y, x + w, y + h);
    p_shadow(x, y, w, h, r, 4.0, 14.0, 0.45 * a);
    p_box(x, y, w, h, r, C_PANEL, 0.94 * a);
    p_outline(x, y, w, h, r, 1.0, C_LINE, a)
}

draw_ui() {
    btn_n = 0;
    lk_n = 0;
    layout_ui();
    draw_title();
    draw_card();
    draw_design_menu();
    // (Not under the making panel, where its ends would show.)
    if (order_t < 0.99) draw_bar();
    if (order_t < 0.01) draw_toast();
    draw_sheet();
    draw_order();
    // (Over the making panel, when it is up: what its buttons did.)
    if (order_t >= 0.01) draw_toast()
}

// Where the title's things go: the title's width; the problems' pill and
// Make it's (each x, y, w). Worked out apart from drawing them, so the
// room they leave is known before the first frame; the words measured
// after what is in line, which is left as it was.
tl_w: f32 = 0.0;

tl_px: f32 = 0.0;

tl_py: f32 = 0.0;

tl_pw: f32 = 0.0;

tl_mx: f32 = 0.0;

tl_my: f32 = 0.0;

tl_mw: f32 = 0.0;

title_geom() {
    x: f32 = 12.0 + safe_left;
    y: f32 = safe_top + 10.0;
    m: int = line_n;
    title_words(m);
    tw: f32 = p_text_w(1, 18.0, line, m, title_name_end);
    sw: f32 = p_text_w(0, 12.5, line, title_name_end, line_n);
    w: f32 = maxf(tw, sw) + 28.0;
    if (design_n > 1) w = w + 18.0;
    line_n = m;
    probs_words();
    pw: f32 = p_text_w(1, 13.0, line, m, line_n) + 40.0;
    line_n = m;
    px: f32 = scr_w as f32 - safe_right - 12.0 - pw;
    // (Not over the title: under it, on a narrow window.)
    py: f32 = y + 9.0;
    if (px < x + w + 8.0) {
        py = y + 58.0;
        px = x
    }
    // Make it: under the problems (or beside them, if they went under the
    // title).
    mw: f32 = p_str_w(1, 14.0, "Make it") + 40.0;
    mx: f32 = scr_w as f32 - safe_right - 12.0 - mw;
    my: f32 = py + 40.0;
    if (py > y + 20.0) {
        mx = px + pw + 8.0;
        my = py
    }
    tl_w = w;
    tl_px = px;
    tl_py = py;
    tl_pw = pw;
    tl_mx = mx;
    tl_my = my;
    tl_mw = mw;
    title_bottom = maxf(y + 50.0, my + 32.0)
}

// The title's words, after byte m of line: its name, then (from
// title_name_end) the line under it.
title_name_end: int = 0;

title_words(m: int) {
    line_n = m;
    if (stage_on) {
        line_add("The set");
        title_name_end = line_n;
        line_add("The dock and its four handhelds");
        return
    }
    line_name(brd_name);
    title_name_end = line_n;
    // (Looking at the case: its size, not the board's.)
    if (mode == MODE_CASE && cs_on) {
        if (dock_on) line_add("The box, ") else line_add("The case, ");
        line_num(case_w(), 0);
        line_add(" x ");
        line_num(case_h(), 0);
        line_add(" x ");
        line_num(stack_t(), 1);
        line_add(" mm");
        return
    }
    line_int(nets_done);
    line_add(" of ");
    line_int(nets_wanted);
    line_add(" nets joined, ");
    line_num(brd_w, 0);
    line_add(" x ");
    line_num(brd_h, 0);
    line_add(" mm")
}

probs_words() {
    if (prob_n == 0) line_add("No problems") else {
        line_int(prob_n);
        if (prob_n == 1) line_add(" problem") else line_add(" problems")
    }
}

// The board's name, and how far along it is.
draw_title() {
    title_geom();
    x: f32 = 12.0 + safe_left;
    y: f32 = safe_top + 10.0;
    w: f32 = tl_w;
    title_words(0);
    name_n: int = title_name_end;
    k0: f32 = 1.0 - 0.04 * pressed(B_DESIGNS);
    panel(x + w * (1.0 - k0) * 0.5, y + 25.0 * (1.0 - k0), w * k0, 50.0 * k0, 14.0,
        1.0);
    if (design_n > 1) {
        add_button(B_DESIGNS, x, y, x + w, y + 50.0);
        mx: f32 = x + w - 20.0;
        my: f32 = y + 18.0;
        p_line(mx - 4.0, my - 2.0, mx, my + 2.0, 1.8, C_MUTED, 1.0);
        p_line(mx, my + 2.0, mx + 4.0, my - 2.0, 1.8, C_MUTED, 1.0)
    }
    p_text(1, 18.0, x + 14.0, y + 23.0, line, 0, name_n, 0.0, C_INK, 1.0);
    p_text(0, 12.5, x + 14.0, y + 40.0, line, name_n, line_n, 0.0, C_MUTED, 1.0);
    // How many of the nets are joined, as a bar under it all.
    if (nets_wanted > 0 && !stage_on && !(mode == MODE_CASE && cs_on)) {
        f: f32 = nets_done as f32 / nets_wanted as f32;
        p_box(x + 14.0, y + 45.0, w - 28.0, 2.0, 1.0, C_LINE, 1.0);
        p_box(x + 14.0, y + 45.0, (w - 28.0) * f, 2.0, 1.0, C_GOOD, 1.0)
    }
    // The problems, if any, to the right: a tap goes to the next.
    line_clear();
    probs_words();
    rgb: int = C_GOOD;
    if (prob_n > 0) rgb = C_BAD;
    k: f32 = 1.0 - 0.06 * pressed(B_PROBS);
    cx: f32 = tl_px + tl_pw * 0.5;
    cy: f32 = tl_py + 16.0;
    bw: f32 = tl_pw * k;
    bh: f32 = 32.0 * k;
    panel(cx - bw * 0.5, cy - bh * 0.5, bw, bh, bh * 0.5, 1.0);
    p_disc(cx - bw * 0.5 + 16.0, cy, 4.5, rgb, 1.0);
    if (prob_n > 0) p_glow(cx - bw * 0.5 + 16.0, cy, 7.0, 5.0, rgb, 0.35 + 0.25 * sinf(now_t * 5.0));
    p_text(1, 13.0, cx - bw * 0.5 + 28.0, cy + 4.6, line, 0, line_n, 0.0, C_INK, 1.0);
    add_button(B_PROBS, tl_px, tl_py, tl_px + tl_pw, tl_py + 32.0);
    // Making it: bright once there is nothing left to do.
    pill_button(B_MAKE, tl_mx, tl_my, tl_mw, 32.0, "Make it", wire_n == 0 && prob_n == 0,
        1.0)
}

// The tools along the bottom.
draw_bar() {
    x: f32 = bar_x;
    y: f32 = bar_y;
    w: f32 = bar_w;
    h: f32 = bar_h;
    panel(x, y, w, h, 18.0, 1.0);
    // (Each mode's own icons: four places for them, whichever.)
    icon_w: f32 = 42.0;
    places: int = 2;
    if (mode == MODE_ROUTE) places = 3;
    seg_w: f32 = minf((w - 16.0 - icon_w * places as f32 - 6.0) / 3.0, 110.0);
    sx: f32 = x + 8.0;
    sy: f32 = y + 8.0;
    sh: f32 = h - 16.0;
    // The modes: a track with a slider in it.
    p_box(sx, sy, seg_w * 3.0, sh, 12.0, 922135, 1.0);
    hx: f32 = sx + 3.0 + mode_show * seg_w;
    p_box(hx, sy + 3.0, seg_w - 6.0, sh - 6.0, 10.0, C_PANEL_HI, 1.0);
    p_outline(hx, sy + 3.0, seg_w - 6.0, sh - 6.0, 10.0, 1.0, 3818836, 1.0);
    seg_label(sx, sy, seg_w, sh, "Parts", 1.0 - minf(absf(mode_show), 1.0), B_ARRANGE);
    seg_label(sx + seg_w, sy, seg_w, sh, "Copper", 1.0 - minf(absf(mode_show - 1.0),
        1.0), B_ROUTE);
    seg_label(sx + 2.0 * seg_w, sy, seg_w, sh, "Case", 1.0 - minf(absf(mode_show - 2.0),
        1.0), B_CASE);
    add_button(B_ARRANGE, sx, sy, sx + seg_w, sy + sh);
    add_button(B_ROUTE, sx + seg_w, sy, sx + 2.0 * seg_w, sy + sh);
    add_button(B_CASE, sx + 2.0 * seg_w, sy, sx + 3.0 * seg_w, sy + sh);
    // The icons, at the right end: fit always, and before it, looking at
    // the copper, which side is on top.
    bx: f32 = x + w - 8.0 - icon_w;
    icon_button(B_FIT, bx, sy, icon_w, sh, true);
    bx = bx - icon_w;
    if (mode != MODE_CASE) {
        icon_button(B_ADD, bx, sy, icon_w, sh, true);
        bx = bx - icon_w
    }
    if (mode == MODE_ROUTE) icon_button(B_LAYER, bx, sy, icon_w, sh, true)
}

seg_label(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    t: str,
    on: f32,
    id: int
) {
    size: f32 = 15.0;
    tw: f32 = p_str_w(1, size, t);
    // (Smaller, if the mode's room is narrow.)
    if (tw + 22.0 > w) {
        size = size * (w - 22.0) / tw;
        tw = p_str_w(1, size, t)
    }
    ink: int = mix_rgb(C_MUTED, C_INK, on);
    k: f32 = 1.0 - 0.05 * pressed(id);
    // (A dot of the mode's color, then its name.)
    dot: int = C_PICK;
    if (id == B_ROUTE) dot = layer_rgb(layer_on);
    total: f32 = tw + 14.0;
    lx: f32 = x + (w - total * k) * 0.5;
    p_disc(lx + 4.0, y + h * 0.5, 4.0 * k, mix_rgb(4871523, dot, on), 1.0);
    p_str(1, size * k, lx + 14.0 * k, y + h * 0.5 + size * 0.36 * k, t, ink, 1.0)
}

icon_button(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    enabled: bool
) {
    pr: f32 = pressed(id);
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    if (pr > 0.0) p_disc(cx, cy, 19.0, C_PANEL_HI, pr);
    a: f32 = 1.0;
    if (!enabled) a = 0.3;
    ink: int = C_INK;
    k: f32 = 1.0 - 0.08 * pr;
    draw_icon(id, cx, cy, 10.0 * k, ink, a);
    if (enabled) add_button(id, x, y, x + w, y + h)
}

// The icons, drawn in lines about (x, y), r their half size.
draw_icon(
    id: int,
    x: f32,
    y: f32,
    r: f32,
    rgb: int,
    a: f32
) {
    t: f32 = 2.0;
    if (id == B_LAYER) {
        // Two boards, one over the other: the one on top in its color.
        under: int = layer_rgb(1 - layer_on);
        over: int = layer_rgb(layer_on);
        p_box(x - r * 0.95 + 3.0, y - r * 0.95 + 3.0, r * 1.5, r * 1.5, 3.0, mix_rgb(under,
            C_PANEL, 0.2), a);
        p_box(x - r * 0.95 - 1.0, y - r * 0.95 - 1.0, r * 1.5, r * 1.5, 3.0, over,
            a);
        p_outline(x - r * 0.95 - 1.0, y - r * 0.95 - 1.0, r * 1.5, r * 1.5, 3.0, 1.5,
            C_PANEL, a)
    }
    if (id == B_FIT) {
        // Four corners.
        c: f32 = r * 0.9;
        l: f32 = r * 0.45;
        p_line(x - c, y - c, x - c + l, y - c, t, rgb, a);
        p_line(x - c, y - c, x - c, y - c + l, t, rgb, a);
        p_line(x + c, y - c, x + c - l, y - c, t, rgb, a);
        p_line(x + c, y - c, x + c, y - c + l, t, rgb, a);
        p_line(x - c, y + c, x - c + l, y + c, t, rgb, a);
        p_line(x - c, y + c, x - c, y + c - l, t, rgb, a);
        p_line(x + c, y + c, x + c - l, y + c, t, rgb, a);
        p_line(x + c, y + c, x + c, y + c - l, t, rgb, a);
        p_box(x - r * 0.3, y - r * 0.3, r * 0.6, r * 0.6, 1.5, rgb, a * 0.8)
    }
    if (id == B_ADD) {
        // A list: three lines, a dot before each.
        for k in 0..3 {
            ly: f32 = y + (k - 1) as f32 * r * 0.6;
            p_disc(x - r * 0.7, ly, 1.4, rgb, a);
            p_line(x - r * 0.35, ly, x + r * 0.8, ly, t, rgb, a)
        }
    }
    if (id == B_CLOSE) {
        p_line(x - r * 0.6, y - r * 0.6, x + r * 0.6, y + r * 0.6, t, rgb, a);
        p_line(x + r * 0.6, y - r * 0.6, x - r * 0.6, y + r * 0.6, t, rgb, a)
    }
}

// A pill with a word on it.
pill_button(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    t: str,
    strong: bool,
    a: f32
) {
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.05 * pr;
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    bw: f32 = w * k;
    bh: f32 = h * k;
    fill: int = C_PANEL_HI;
    ink: int = C_INK;
    if (strong) {
        fill = C_PICK;
        ink = 856085
    }
    p_box(cx - bw * 0.5, cy - bh * 0.5, bw, bh, bh * 0.5, mix_rgb(fill, 16777215,
        0.12 * pr), a);
    tw: f32 = p_str_w(1, 14.0, t);
    p_str(1, 14.0 * k, cx - tw * k * 0.5, cy + 5.0 * k, t, ink, a);
    add_button(id, x, y, x + w, y + h)
}

// ---- the designs' menu ----
// Under the title: each design, and the set (the dock with its handhelds
// in it), the one open marked.
design_menu: bool = false;

design_menu_t: f32 = 0.0;

draw_design_menu() {
    if (design_menu_t <= 0.01) return;
    a: f32 = design_menu_t;
    rows: int = design_n;
    if (can_stage()) rows = rows + 1;
    row_h: f32 = 52.0;
    w: f32 = 260.0;
    x: f32 = 12.0 + safe_left;
    y: f32 = safe_top + 66.0 - (1.0 - a) * 10.0;
    h: f32 = 8.0 + rows as f32 * row_h;
    panel(x, y, w, h, 16.0, a);
    for k in 0..rows {
        ry: f32 = y + 4.0 + k as f32 * row_h;
        id: int = B_DESIGN + k;
        on: bool = !stage_on && k == design_on;
        if (k == design_n) {
            id = B_SET;
            on = stage_on
        }
        pr: f32 = pressed(id);
        fill: int = mix_rgb(C_PANEL, 16777215, 0.06 * pr);
        if (on) fill = C_PANEL_HI;
        p_box(x + 4.0, ry, w - 8.0, row_h - 4.0, 12.0, fill, a);
        line_clear();
        if (k == design_n) line_add("The set") else {
            for c in 0..design_name_n[k] line_byte(design_name[k * 32 + c] as int)
        }
        p_text(1, 15.0, x + 18.0, ry + 21.0, line, 0, line_n, 0.0, C_INK, a);
        sub: str = "A board, and its case";
        if (k < design_n && design_dock[k]) sub = "Holds four, and charges them";
        if (k == design_n) sub = "The dock, its handhelds in it";
        p_str(0, 12.0, x + 18.0, ry + 38.0, sub, C_MUTED, a);
        if (on) p_disc(x + w - 22.0, ry + row_h * 0.5 - 2.0, 4.5, C_GOOD, a);
        add_button(id, x + 4.0, ry, x + w - 4.0, ry + row_h - 4.0)
    }
}

// A pill sized to its word, put left of x (the right end of the room
// left): where the room now ends.
pill_right(
    id: int,
    x: f32,
    y: f32,
    h: f32,
    t: str,
    strong: bool,
    a: f32
): f32 {
    w: f32 = p_str_w(1, 14.0, t) + 40.0;
    pill_button(id, x - w, y, w, h, t, strong, a);
    x - w - 6.0
}

// The card for what is picked: what it is, a line about it, and what can
// be done to it.
draw_card() {
    if (card_show <= 0.01) return;
    if (steps_card()) {
        draw_steps_card();
        return
    }
    a: f32 = card_show;
    x: f32 = bar_x;
    w: f32 = bar_w;
    if (card_side()) {
        x = 12.0 + safe_left;
        w = steps_card_w()
    }
    // The words, into line: a title and, after it, a second line.
    line_clear();
    sub: int = card_words();
    card_shape(sub);
    under: bool = card_under;
    aw: f32 = card_actions_w();
    h: f32 = card_h;
    y: f32 = bar_y - 10.0 - h + (1.0 - card_show) * 24.0;
    panel(x, y, w, h, 18.0, a);
    // The actions, from the right (in a column at the left, along its
    // bottom, the title a row of its own over the words).
    side: bool = card_side() && aw > 0.0;
    bx: f32 = x + w - 10.0;
    bh: f32 = 40.0;
    by: f32 = y + 13.0;
    if (side) by = y + h - bh - 12.0;
    // (Only ways of looking: the designs are not changed here.)
    if (sel_route >= 0 || sel_part >= 0 || sel_seg >= 0 || sel_via >= 0 || sel_pin >= 0) { } else if (stage_on) {
        if (stage_lid_off) bx = pill_right(B_LID, bx, by, bh, "Lid on", true, a) else bx = pill_right(B_LID,
            bx, by, bh, "Lid off", true, a);
        for k in 0..design_n {
            if (design_dock[k]) bx = pill_right(B_DESIGN + k, bx, by, bh, "The dock",
                false, a)
        }
    } else if (mode == MODE_CASE) {
        if (!cs_on) { } else if (view3d && sp_on) {
            // (Putting it together: on, back, or out of it.)
            if (sp_k + 1 < steps_n()) bx = pill_right(B_STEP_NEXT, bx, by, bh, "Next",
                true, a) else bx = pill_right(B_STEP_NEXT, bx, by, bh, "Done", true,
                a);
            if (sp_k > 0) bx = pill_right(B_STEP_BACK, bx, by, bh, "Back", false,
                a);
            bx = pill_right(B_STEP_CLOSE, bx, by, bh, "Close", false, a)
        } else if (view3d) {
            bx = pill_right(B_FLAT, bx, by, bh, "Flat", false, a);
            if (exploded) bx = pill_right(B_EXPLODE, bx, by, bh, "Together", true,
                a) else bx = pill_right(B_EXPLODE, bx, by, bh, "Explode", true, a);
            bx = pill_right(B_STEPS, bx, by, bh, "Steps", false, a)
        } else {
            // (Up toward the front, down toward the back: each only where
            // there is a layer to go to.)
            if (cs_view < layers_n - 1) bx = pill_right(B_CASE_UP, bx, by, bh, "Up",
                false, a);
            if (cs_view > 0) bx = pill_right(B_CASE_DOWN, bx, by, bh, "Down", false,
                a);
            bx = pill_right(B_3D, bx, by, bh, "3D", true, a)
        }
    }
    room: f32 = bx - x - 22.0;
    if (side) {
        cut_text(1, 17.0, 13.0, x + 16.0, y + 30.0, w - 32.0, 0, sub, C_INK, a);
        wrap_text_n(0, 12.5, x + 16.0, y + 52.0, w - 32.0, 16.0, sub, line_n, C_MUTED,
            a);
        return
    }
    // (The title made to fit what room the buttons leave.)
    // (Not below 13 px: past that, cut short.)
    cut_text(1, 17.0, 13.0, x + 16.0, y + 28.0, room, 0, sub, C_INK, a);
    if (card_short) cut_text(0, 12.5, 11.5, x + 16.0, y + 47.0, room, sub, line_n,
        C_MUTED, a) else if (under) wrap_text_n(0, 12.5, x + 16.0, y + 66.0, w - 32.0,
        16.0, sub, line_n, C_MUTED, a) else if (aw == 0.0) wrap_text_n(0, 12.5, x + 16.0,
        y + 47.0, w - 32.0, 16.0, sub, line_n, C_MUTED, a) else wrap_text(0, 12.5,
        11.5, x + 16.0, y + 47.0, room, 16.0, sub, line_n, C_MUTED, a)
}

// The card's shape for its words (in line, the second line from sub):
// its words under the title, beside the actions if they fit there,
// readably; else under them, the card taller; as many lines as they take.
// (On a short window, one line however long, cut: the board needs the
// room.)
card_under: bool = false;

card_short: bool = false;

card_shape(sub: int) {
    if (steps_card()) {
        steps_card_shape();
        return
    }
    w: f32 = steps_card_w();
    aw: f32 = card_actions_w();
    // (The steps' words are the point: never cut.)
    card_short = scr_h < 500 && !(view3d && sp_on) && !card_side();
    card_under = !card_short && aw > 0.0 && wrap_count(0, 12.5, 11.5, w - 32.0 - aw,
        sub, line_n) > 1;
    n: int = 1;
    if (!card_short && (card_under || aw == 0.0)) n = wrap_lines(0, 12.5, w - 32.0,
        sub, line_n);
    card_h = 66.0 + 16.0 * (n - 1) as f32;
    if (card_under) card_h = card_h + 32.0;
    // (A column: its title, its words, its buttons, each a row.)
    if (card_side() && aw > 0.0) {
        card_under = false;
        card_h = 40.0 + 16.0 * wrap_lines(0, 12.5, w - 32.0, sub, line_n) as f32 + 62.0
    }
}

// The steps' card: its title on a row of its own, its words under it
// (as many lines as the longest step's, so that it keeps its size and its
// buttons their place from one step to the next), and its buttons along
// its bottom: Close, Back and Next (the last step: Back and Done).
steps_card_shape() {
    w: f32 = steps_card_w() - 32.0;
    n: int = 1;
    for k in 0..steps_n() {
        m: int = line_n;
        line_add("Step 10 of 10. ");
        if (dock_on) line_add(DK_TEXT[k]) else line_add(HH_TEXT[k]);
        n = maxi(n, wrap_lines(0, 12.5, w, m, line_n));
        line_n = m
    }
    card_h = 40.0 + 16.0 * n as f32 + 62.0;
    // (A column: as tall as the room beside the bar lets it be, at least.)
    if (steps_side()) card_h = maxf(card_h, 0.0)
}

draw_steps_card() {
    a: f32 = card_show;
    line_clear();
    sub: int = steps_words();
    steps_card_shape();
    w: f32 = steps_card_w();
    h: f32 = card_h;
    x: f32 = bar_x;
    y: f32 = bar_y - 10.0 - h + (1.0 - card_show) * 24.0;
    if (steps_side()) {
        x = 12.0 + safe_left;
        y = maxf(view_top - 10.0, bar_y - 10.0 - h) + (1.0 - card_show) * 24.0;
        if (bar_x < x + w + 10.0) y = minf(y, bar_y - 10.0 - h)
    }
    panel(x, y, w, h, 18.0, a);
    cut_text(1, 17.0, 13.0, x + 16.0, y + 30.0, w - 32.0, 0, sub, C_INK, a);
    wrap_text_n(0, 12.5, x + 16.0, y + 52.0, w - 32.0, 16.0, sub, line_n, C_MUTED,
        a);
    // (Its buttons, from the right, along its bottom.)
    bh: f32 = 40.0;
    by: f32 = y + h - bh - 12.0;
    bx: f32 = x + w - 10.0;
    last: bool = sp_k + 1 >= steps_n();
    if (last) bx = pill_right(B_STEP_NEXT, bx, by, bh, "Done", true, a) else bx = pill_right(B_STEP_NEXT,
        bx, by, bh, "Next", true, a);
    if (sp_k > 0) bx = pill_right(B_STEP_BACK, bx, by, bh, "Back", false, a);
    if (!last) bx = pill_right(B_STEP_CLOSE, bx, by, bh, "Close", false, a)
}

// The card's shape worked out ahead of drawing it (for the room it
// leaves), what is in line kept.
line_keep: []i8 = static_buffer([4096]i8);

card_shape_now() {
    n: int = line_n;
    for i in 0..n line_keep[i] = line[i];
    line_clear();
    card_shape(card_words());
    for i in 0..n line[i] = line_keep[i];
    line_n = n
}

// How wide the card's actions are, as draw_card lays them out.
card_actions_w(): f32 {
    t: f32 = 0.0;
    if (sel_route >= 0 || sel_part >= 0 || sel_seg >= 0 || sel_via >= 0 || sel_pin >= 0) return 0.0;
    if (stage_on) {
        t = pill_w("Lid off");
        for k in 0..design_n {
            if (design_dock[k]) t = t + pill_w("The dock")
        }
        return t
    }
    if (mode == MODE_CASE && cs_on) {
        if (view3d && sp_on) {
            t = pill_w("Next") + pill_w("Close");
            if (sp_k > 0) t = t + pill_w("Back");
            return t
        }
        if (view3d) return pill_w("Flat") + pill_w("Together") + pill_w("Steps");
        if (cs_view < layers_n - 1) t = t + pill_w("Up");
        if (cs_view > 0) t = t + pill_w("Down");
        return t + pill_w("3D")
    }
    0.0
}

pill_w(t: str): f32 {
    p_str_w(1, 14.0, t) + 46.0
}

// The card's words, into line: where the second line starts.
card_words(): int {
    if (sel_route >= 0) {
        r: int = sel_route;
        point: bool = sel_point >= 1 && sel_point < ro_np[r] - 1;
        if (point) line_add("Waypoint") else if (ro_net[r] >= 0) line_name(net_name[ro_net[r]]) else line_add("Route");
        // (What it joins: its two ends' pins.)
        a0: int = rp_pin[r * RPTS];
        a1: int = rp_pin[r * RPTS + ro_np[r] - 1];
        if (a0 >= 0 && a1 >= 0) {
            line_add("  ");
            line_name(part_ref[pin_part[a0]]);
            line_add(".");
            line_name(lp_name[pin_pad[a0]]);
            line_add(" to ");
            line_name(part_ref[pin_part[a1]]);
            line_add(".");
            line_name(lp_name[pin_pad[a1]])
        }
        sub2: int = line_n;
        if (point && ro_net[r] >= 0) {
            line_name(net_name[ro_net[r]]);
            line_add(": ")
        }
        if (!ro_ok[r]) {
            line_add("Not yet routed");
            return sub2
        }
        l: f32 = 0.0;
        vias: int = 0;
        for k in 0..segs_n {
            if (sg_route[k] == r) {
                dx: f32 = sg_x1[k] - sg_x0[k];
                dy: f32 = sg_y1[k] - sg_y0[k];
                l = l + sqrtf(dx * dx + dy * dy)
            }
        }
        for k in 0..vias_n {
            if (via_route[k] == r) vias = vias + 1
        }
        line_num(l, 1);
        line_add(" mm");
        if (vias > 0) {
            line_add(", ");
            line_int(vias);
            if (vias == 1) line_add(" via") else line_add(" vias")
        }
        if (ro_layer[r] == TOP) line_add(", on the top") else line_add(", on the bottom");
        return sub2
    }
    if (mode == MODE_CASE && sel_part < 0) {
        case_words();
        return case_sub
    }
    if (sel_part < 0 && sel_pin < 0 && sel_seg < 0 && sel_via < 0 && mode == MODE_ROUTE) {
        line_add("Copper");
        sub3: int = line_n;
        line_int(nets_done);
        line_add(" of ");
        line_int(nets_wanted);
        line_add(" nets joined. Tap a track or a pin to see its net");
        return sub3
    }
    if (sel_part >= 0) {
        p: int = sel_part;
        f: int = part_fp[p];
        // (Its name and what it is: its value, or its title if that says
        // the value already, or has none.)
        titled: bool = part_value[p] < 0 || name_has(fp_title[f], part_value[p]);
        line_name(part_ref[p]);
        line_add("  ");
        if (titled) line_name(fp_title[f]) else line_name(part_value[p]);
        sub2: int = line_n;
        // (What it is, unless the title said it; its package, but not
        // the package's name if the part number starts with it.)
        src: int = source_of(p);
        if (!titled) {
            line_name(fp_title[f]);
            line_add(", ")
        }
        hl: int = pkg_head_len(fp_pkg[f]);
        if (src >= 0 && mpn_starts(SRC_MPN[src], fp_pkg[f], hl)) {
            if (hl + 2 < name_len[fp_pkg[f]]) {
                for c in hl + 2..name_len[fp_pkg[f]] line_byte(name_bytes[name_start[fp_pkg[f]] + c] as int);
                line_add(". ")
            }
        } else {
            line_name(fp_pkg[f]);
            line_add(". ")
        }
        // (What it is bought as: the board house's part, made in the
        // board, or fitted by hand.)
        if (src >= 0) {
            line_add(SRC_MPN[src]);
            line_add(", LCSC ");
            line_add(SRC_LCSC[src])
        } else if (in_board(f)) line_add("Made in the board by the board house") else line_add("Not put on by the board house: fitted by hand");
        return sub2
    }
    if (sel_pin >= 0) {
        // (Its net the title: what a tap on a pin asks.)
        q: int = sel_pin;
        n: int = pin_net[q];
        if (n >= 0) line_name(net_name[n]) else {
            line_name(part_ref[pin_part[q]]);
            line_add(" pin ");
            line_name(lp_name[pin_pad[q]])
        }
        sub3: int = line_n;
        if (n < 0) line_add("Joined to nothing") else {
            line_name(part_ref[pin_part[q]]);
            line_add(" pin ");
            line_name(lp_name[pin_pad[q]]);
            line_add(". ");
            line_int(net_count[n]);
            line_add(" pins, ");
            if (net_left[n] == 0) line_add("all joined") else {
                line_int(net_left[n]);
                line_add(" to join")
            }
        }
        return sub3
    }
    if (sel_seg >= 0) {
        s: int = sel_seg;
        line_add("Track");
        if (sg_net[s] >= 0) {
            line_add(", ");
            line_name(net_name[sg_net[s]])
        }
        sub4: int = line_n;
        line_num(sg_w[s], 2);
        line_add(" mm wide, ");
        dx: f32 = sg_x1[s] - sg_x0[s];
        dy: f32 = sg_y1[s] - sg_y0[s];
        line_num(sqrtf(dx * dx + dy * dy), 2);
        line_add(" mm long, on the ");
        if (sg_layer[s] == TOP) line_add("top") else line_add("bottom");
        return sub4
    }
    if (sel_via >= 0) {
        v: int = sel_via;
        line_add("Via");
        if (via_net[v] >= 0) {
            line_add(", ");
            line_name(net_name[via_net[v]])
        }
        sub5: int = line_n;
        line_num(via_d[v], 2);
        line_add(" mm, ");
        line_num(via_drill[v], 2);
        line_add(" mm hole");
        return sub5
    }
    line_n
}

draw_toast() {
    if (toast_t >= 2.6 || toast_n == 0) return;
    a: f32 = clampf(toast_t * 8.0, 0.0, 1.0) * clampf((2.6 - toast_t) * 3.0, 0.0,
        1.0);
    // (Its words, wrapped to the window, as many lines as they take.)
    line_clear();
    for i in 0..toast_n line_byte(toast_buf[i] as int);
    size: f32 = 14.0;
    tw: f32 = p_text_w(1, size, line, 0, line_n);
    room: f32 = minf(scr_w as f32 - 24.0, 520.0) - 32.0;
    n: int = wrap_lines(1, size, room, 0, line_n);
    w: f32 = minf(tw, room) + 32.0;
    h: f32 = 36.0 + 18.0 * (n - 1) as f32;
    x: f32 = (scr_w as f32 - w) * 0.5;
    y: f32 = bar_y - 10.0 - h - card_show * (card_h + 10.0) + (1.0 - a) * 8.0;
    r: f32 = minf(h * 0.5, 18.0);
    p_shadow(x, y, w, h, r, 3.0, 12.0, 0.5 * a);
    p_box(x, y, w, h, r, 15659766, 0.96 * a);
    wrap_text_n(1, size, x + 16.0, y + 18.0 + size * 0.36, room, 18.0, 0, line_n,
        1053980, a)
}

// ---- the parts list ----
// In the drawer: each kind of part on the board (the same part bought for
// several places is one row), what it is and what it is bought as; a tap
// on a row shows its first part on the board.
const BOM_ROWS: int = 128;

bom_first: []int = static_buffer(BOM_ROWS, 0);

bom_n: int = 0;

// Whether parts p and o are the same kind: the same line of the sources'
// table, or (not put on by the board house) the same footprint and value.
same_kind(p: int, o: int): bool {
    s: int = source_of(p);
    if (s >= 0) return source_of(o) == s;
    source_of(o) < 0 && part_fp[o] == part_fp[p] && part_value[o] == part_value[p]
}

bom_build() {
    bom_n = 0;
    for p in 0..parts_n {
        first: bool = true;
        for k in 0..bom_n {
            if (same_kind(bom_first[k], p)) first = false
        }
        if (first && bom_n < BOM_ROWS) {
            bom_first[bom_n] = p;
            bom_n = bom_n + 1
        }
    }
    // (In order: what the board house puts on first, then what is fitted
    // by hand; each by its first part's name, C2 before C10.)
    for k in 1..bom_n {
        j: int = k;
        while (j > 0 && bom_before(bom_first[j], bom_first[j - 1])) {
            t: int = bom_first[j];
            bom_first[j] = bom_first[j - 1];
            bom_first[j - 1] = t;
            j = j - 1
        }
    }
}

// Whether part number t starts with name k (a package's name: then it
// need not be said twice).
mpn_starts(t: str, k: int, n: int): bool {
    if (n == 0 || n > len(t)) return false;
    for i in 0..n {
        if (name_bytes[name_start[k] + i] != t[i]) return false
    }
    true
}

// How long name k's head is: up to its first ", ".
pkg_head_len(k: int): int {
    for i in 0..name_len[k] - 1 {
        if (name_bytes[name_start[k] + i] == ',' && name_bytes[name_start[k] + i + 1] == ' ') return i
    }
    name_len[k]
}

// Whether footprint f is made in the board itself: holes, test pads.
in_board(f: int): bool {
    fp_is(f, "mh25") || fp_is(f, "wirehole") || fp_is(f, "tph") || fp_is(f, "tp1") || fp_is(f,
        "pads2")
}

// Whether name a has name b in it.
name_has(a: int, b: int): bool {
    sa: int = name_start[a];
    sb: int = name_start[b];
    for i in 0..name_len[a] - name_len[b] + 1 {
        same: bool = true;
        for j in 0..name_len[b] {
            if (name_bytes[sa + i + j] != name_bytes[sb + j]) same = false
        }
        if (same) return true
    }
    false
}

// Whether part p's row goes before part o's.
bom_before(p: int, o: int): bool {
    ps: bool = source_of(p) >= 0;
    os: bool = source_of(o) >= 0;
    if (ps != os) return ps;
    ref_before(part_ref[p], part_ref[o])
}

// Whether name a sorts before name b: by their letters, then their number.
ref_before(a: int, b: int): bool {
    la: int = ref_letters(a);
    lb: int = ref_letters(b);
    sa: int = name_start[a];
    sb: int = name_start[b];
    for i in 0..mini(la, lb) {
        ca: i8 = name_bytes[sa + i];
        cb: i8 = name_bytes[sb + i];
        if (ca != cb) return ca < cb
    }
    if (la != lb) return la < lb;
    ref_number(a, la) < ref_number(b, lb)
}

ref_letters(k: int): int {
    n: int = 0;
    while (n < name_len[k] && (name_bytes[name_start[k] + n] < '0' || name_bytes[name_start[k] + n] > '9')) n = n + 1;
    n
}

ref_number(k: int, from: int): int {
    v: int = 0;
    for i in from..name_len[k] {
        c: int = name_bytes[name_start[k] + i] as int;
        if (c >= 48 && c <= 57) v = v * 10 + c - 48
    }
    v
}

// Part p, picked, the board's view eased round it.
show_part(p: int) {
    if (stage_on) design_pending = design_on;
    if (mode == MODE_CASE) set_mode(MODE_ARRANGE);
    view3d = false;
    pick_part(p);
    ease_to_box(court_x0(p) - 6.0, court_y0(p) - 6.0, court_x1(p) + 6.0, court_y1(p) + 6.0)
}

sheet_top(): f32 {
    full: f32 = minf(scr_h as f32 * 0.72, scr_h as f32 - safe_top - 80.0);
    // (A short window: nearly all of it.)
    if (scr_h < 500) full = scr_h as f32 - safe_top - 16.0;
    scr_h as f32 - full * sheet_t
}

sheet_list_h(): f32 {
    scr_h as f32 - sheet_top() - 64.0 - safe_bottom
}

draw_sheet() {
    if (sheet_t <= 0.003) return;
    a: f32 = sheet_t;
    bom_build();
    // The shade over everything else.
    p_box(0.0, 0.0, scr_w as f32, scr_h as f32, 0.0, 0, 0.45 * a);
    top: f32 = sheet_top();
    w: f32 = minf(scr_w as f32, 720.0);
    x: f32 = (scr_w as f32 - w) * 0.5;
    p_shadow(x, top, w, scr_h as f32 - top + 40.0, 22.0, -2.0, 18.0, 0.6 * a);
    p_box(x, top, w, scr_h as f32 - top + 40.0, 22.0, C_PANEL, 1.0);
    p_box(x + w * 0.5 - 20.0, top + 8.0, 40.0, 4.0, 2.0, C_LINE, 1.0);
    p_str(1, 19.0, x + 18.0, top + 40.0, "Parts", C_INK, 1.0);
    line_clear();
    house: int = 0;
    for p in 0..parts_n {
        if (source_of(p) >= 0) house = house + 1
    }
    line_int(parts_n);
    line_add(" parts, ");
    line_int(bom_n);
    line_add(" kinds; ");
    line_int(house);
    line_add(" put on by the board house");
    cut_text(0, 13.0, 12.0, x + 18.0, top + 57.0, w - 90.0, 0, line_n, C_MUTED, 1.0);
    icon_button(B_CLOSE, x + w - 56.0, top + 12.0, 46.0, 40.0, true);
    // The rows, scrolling, each as tall as its words.
    list_y: f32 = top + 66.0;
    p_clip(x, list_y, x + w, scr_h as f32);
    ry: f32 = list_y + 4.0 - sheet_scroll;
    for k in 0..bom_n {
        rh: f32 = bom_row_h(k, w - 20.0);
        if (ry + rh > list_y - 4.0 && ry < scr_h as f32) bom_row(k, x + 10.0, ry,
            w - 20.0, rh - 4.0);
        ry = ry + rh
    }
    sheet_content_h = ry + sheet_scroll - list_y + 16.0 + safe_bottom;
    p_noclip()
}

// Row k's words, into line: how many, what, where; then (from where it
// returns) what it is bought as.
bom_words(k: int): int {
    p: int = bom_first[k];
    f: int = part_fp[p];
    n: int = 0;
    for o in 0..parts_n {
        if (same_kind(p, o)) n = n + 1
    }
    line_clear();
    line_int(n);
    line_add(" x  ");
    // (Its value, unless its title says it already.)
    if (part_value[p] >= 0 && !name_has(fp_title[f], part_value[p])) {
        line_name(part_value[p]);
        line_add("  ")
    }
    line_name(fp_title[f]);
    line_add(", ");
    line_name(fp_pkg[f]);
    line_add(":  ");
    // (Their names in order: each time the least after the last.)
    last: int = -1;
    for m in 0..mini(n, 12) {
        next: int = -1;
        for o in 0..parts_n {
            if (same_kind(p, o) && (last < 0 || ref_before(part_ref[last], part_ref[o])) && (next < 0 || ref_before(part_ref[o],
                part_ref[next]))) next = o
        }
        if (m > 0) line_add(" ");
        if (next >= 0) line_name(part_ref[next]);
        last = next
    }
    if (n > 12) line_add(" ...");
    sub: int = line_n;
    src: int = source_of(p);
    if (src >= 0) {
        line_add(SRC_MPN[src]);
        line_add(", LCSC ");
        line_add(SRC_LCSC[src]);
        line_add(": put on by the board house")
    } else if (in_board(f)) line_add("Made in the board by the board house") else line_add("Not put on by the board house: fitted by hand");
    sub
}

// Row k's height, w wide: its first line and its second, each on one line
// or two.
bom_row_h(k: int, w: f32): f32 {
    sub: int = bom_words(k);
    n1: int = wrap_count(1, 14.0, 12.5, w - 24.0, 0, sub);
    n2: int = wrap_count(0, 12.5, 11.5, w - 24.0, sub, line_n);
    26.0 + 17.0 * n1 as f32 + 15.0 * n2 as f32
}

// Row k of the parts list.
bom_row(
    k: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    id: int = B_PART + k;
    pr: f32 = pressed(id);
    p_box(x, y, w, h, 12.0, mix_rgb(1844012, 2765888, pr), 1.0);
    sub: int = bom_words(k);
    n1: int = wrap_count(1, 14.0, 12.5, w - 24.0, 0, sub);
    wrap_text(1, 14.0, 12.5, x + 12.0, y + 22.0, w - 24.0, 17.0, 0, sub, C_INK, 1.0);
    wrap_text(0, 12.5, 11.5, x + 12.0, y + 24.0 + 17.0 * n1 as f32, w - 24.0, 15.0,
        sub, line_n, C_MUTED, 1.0);
    add_button(id, x, maxf(y, sheet_top() + 66.0), x + w, y + h)
}

// Whether a hole's word says a part is in it (named by where it is).
name_is_part(t: str): bool {
    len(t) == 4 && t[0] == 'P' && t[1] == 'A' && t[2] == 'R' && t[3] == 'T'
}

// The Case card's words: the layer shown, which of how many, and what it
// is; the second line from case_sub.
case_sub: int = 0;

case_words() {
    if (stage_on) {
        line_add("The set");
        case_sub = line_n;
        if (stage_lid_off) line_add("The lid lifted off. Drag to turn it") else line_add("The dock, the lid on, four handhelds in it. Drag to turn it");
        return
    }
    if (!cs_on || layers_n == 0) {
        line_add("Case");
        case_sub = line_n;
        line_add("This board has none");
        return
    }
    if (view3d && sp_on) {
        case_sub = steps_words();
        return
    }
    if (view3d) {
        line_add("In 3D");
        case_sub = line_n;
        if (exploded) line_add("Pulled apart, as it goes together. Drag to turn it") else line_add("Drag to turn it; pinch, or the wheel, to come closer");
        return
    }
    l: int = clampi(cs_view, 0, layers_n - 1);
    // (A hole picked: what it is for, and its size.)
    if (sel_hole >= 0) {
        k: int = sel_hole;
        named: bool = false;
        if (name_is_part(sh_what[k])) {
            for p in 0..parts_n {
                if (!named && court_x0(p) <= sh_x[k] && sh_x[k] <= court_x1(p) && court_y0(p) <= sh_y[k] && sh_y[k] <= court_y1(p)) {
                    line_name(part_ref[p]);
                    line_add(", ");
                    line_name(fp_title[part_fp[p]]);
                    line_add(", standing up into it");
                    named = true
                }
            }
            if (!named) line_add("A part standing up into it");
            case_sub = line_n
        } else {
            // (A button's hole: its button the title, and what of it the
            // hole is for under it. Else its title what comes before a
            // colon, the rest after it, in the line under: titles stay
            // short enough to read.)
            m: int = line_n;
            hole_button(k);
            if (line_n > m) {
                case_sub = line_n;
                line_add(sh_what[k]);
                line_add(". ")
            } else {
                line_add(sh_what[k]);
                if (split_title(0)) {
                    case_sub = title_split;
                    line_add(". ")
                } else case_sub = line_n
            }
        }
        line_add("Cut in ");
        hole_words(k, l);
        return
    }
    line_add(pc_name[l]);
    case_sub = line_n;
    line_add("Layer ");
    line_int(l + 1);
    line_add(" of ");
    line_int(layers_n);
    if (dock_on) line_add(", from the bottom. ") else line_add(", from the back. ");
    line_num(cs_ply, 1);
    line_add(" mm birch ply. ");
    if (dock_on) line_add(dk_layer_says(l)) else line_add(LAYER_SAYS[l])
}

// Splits line from m at its first ": " (else its first ", "), if it has
// one: the title up to it, and from title_split the rest, its first
// letter made capital. Whether it did.
title_split: int = 0;

split_title(m: int): bool {
    if (split_at(m, ':')) return true;
    split_at(m, ',')
}

// The same, at the first c followed by a space.
split_at(m: int, c0: i8): bool {
    for i in m..line_n - 1 {
        if (line[i] == c0 && line[i + 1] == ' ') {
            // (The rest moved back over the colon and its space.)
            for j in i + 2..line_n line[j - 2] = line[j];
            line_n = line_n - 2;
            title_split = i;
            c: int = line[i] as int;
            if (c >= 97 && c <= 122) line[i] = (c - 32) trunc i8;
            return true
        }
    }
    false
}

// The rest of a picked hole's words: which layer, how big.
hole_words(k: int, l: int) {
    line_add(pc_name[l]);
    line_add(", ");
    if (sh_kind[k] == SH_CIRCLE) {
        line_num(sh_hw[k] * 2.0, 1);
        line_add(" mm across")
    } else {
        line_num(sh_hw[k] * 2.0, 1);
        line_add(" x ");
        line_num(sh_hh[k] * 2.0, 1);
        line_add(" mm")
    }
}

// Which button a button's hole is for: the D-pad's cross, or the switch
// it is over, by its name ("UP" said "Up").
hole_button(k: int) {
    t: str = sh_what[k];
    if (len(t) < 10 || t[2] != 'b' || t[3] != 'u' || t[4] != 't') return;
    if (dpad_n() == 4 && absf(sh_x[k] - dpad_x()) < 0.5 && absf(sh_y[k] - dpad_y()) < 0.5) {
        line_add("The D-pad");
        return
    }
    for p in 0..parts_n {
        if (is_button(p) && part_value[p] >= 0 && absf(sh_x[k] - part_x[p]) < 0.5 && absf(sh_y[k] - part_y[p]) < 0.5) {
            if (in_dpad(p)) line_add("The D-pad's ");
            n: int = part_value[p];
            for i in 0..name_len[n] {
                c: int = name_bytes[name_start[n] + i] as int;
                if (i > 0 && c >= 65 && c <= 90) c = c + 32;
                line_byte(c)
            }
            return
        }
    }
}

LAYER_SAYS: []str = ["Glued to the two over it; the bolts' heads, the charging coil's mark",
    "The battery and its lead, the charging receiver; the bolts' heads", "Battery, its wire's way, room under the board's pins",
    "The board sits in it", "Over the board: its tall parts, the stems, the lights; the screen on it",
    "The screen and the buttons' flanges; the bolts' nuts", "The window's acrylic, and the buttons' caps"]
