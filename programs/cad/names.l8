tag cad;

use_tag std, gl, x11, skate;

// Names: of footprints and their pads, of parts, of nets. Each is a run of
// bytes kept in one pool, known by its number.
const NAMES: int = 8192;

const NAME_BYTES: int = 131072;

name_bytes: []i8 = static_buffer(NAME_BYTES, 0i8);

name_start: []int = static_buffer(NAMES, 0);

name_len: []int = static_buffer(NAMES, 0);

names_n: int = 0;

name_used: int = 0;

// A name from bytes (from `from` up to `to`); or from a string.
name_of(t: []i8, from: int, to: int): int {
    n: int = to - from;
    if (names_n >= NAMES || name_used + n > NAME_BYTES) return 0;
    name_start[names_n] = name_used;
    name_len[names_n] = n;
    for i in 0..n name_bytes[name_used + i] = t[from + i];
    name_used = name_used + n;
    names_n = names_n + 1;
    names_n - 1
}

name_str(t: str): int {
    n: int = len(t);
    if (names_n >= NAMES || name_used + n > NAME_BYTES) return 0;
    name_start[names_n] = name_used;
    name_len[names_n] = n;
    for i in 0..n name_bytes[name_used + i] = t[i];
    name_used = name_used + n;
    names_n = names_n + 1;
    names_n - 1
}

// Whether name k is the bytes from `from` up to `to`; or a string.
name_is(
    k: int,
    t: []i8,
    from: int,
    to: int
): bool {
    if (name_len[k] != to - from) return false;
    s: int = name_start[k];
    for i in 0..to - from {
        if (name_bytes[s + i] != t[from + i]) return false
    }
    true
}

name_is_str(k: int, t: str): bool {
    if (name_len[k] != len(t)) return false;
    s: int = name_start[k];
    for i in 0..len(t) {
        if (name_bytes[s + i] != t[i]) return false
    }
    true
}

// ---- a line of text being put together (for the screen or a file) ----
line: []i8 = static_buffer([4096]i8);

line_n: int = 0;

line_clear() {
    line_n = 0
}

line_byte(c: int) {
    if (line_n < len(line)) {
        line[line_n] = c trunc i8;
        line_n = line_n + 1
    }
}

line_add(t: str) {
    for c in t line_byte(c as int)
}

line_name(k: int) {
    s: int = name_start[k];
    for i in 0..name_len[k] line_byte(name_bytes[s + i] as int)
}

line_int(v: int) {
    if (v < 0) {
        line_byte(45);
        line_int(-v);
        return
    }
    if (v >= 10) line_int(v / 10);
    line_byte(48 + v % 10)
}

// A number with up to `places` decimals, without trailing zeros.
line_num(x: f32, places: int) {
    v: f32 = x;
    if (v < 0.0) {
        scale0: int = pow10(places);
        if ((-v * scale0 as f32 + 0.5) as int == 0) {
            line_byte(48);
            return
        }
        line_byte(45);
        v = -v
    }
    scale: int = pow10(places);
    whole: int = (v * scale as f32 + 0.5) as int;
    line_int(whole / scale);
    frac: int = whole % scale;
    if (frac == 0) return;
    line_byte(46);
    digits: int = places;
    while (frac % 10 == 0) {
        frac = frac / 10;
        digits = digits - 1
    }
    d: int = pow10(digits - 1);
    while (d > 0) {
        line_byte(48 + frac / d % 10);
        d = d / 10
    }
}

pow10(n: int): int {
    v: int = 1;
    k: int = n;
    while (k > 0) {
        v = v * 10;
        k = k - 1
    }
    v
}
