tag cad;

use_tag std, gl, x11, skate;

// Putting it together, step by step, in 3D: each step shows what is put
// together by then (and, of what is made apart, only what that step
// makes), its new pieces coming down into place one after another, in
// the order they go; turned face down for the steps done face down. The
// words are the README's "Putting it together", shorter.
//
// What is drawn belongs to a group (see view3d.l8, level_group), and a
// step says, as bits, which groups show and which are new in it.
const G_BACK: int = 0;

const G_FRONT: int = 1;

const G_NUTS: int = 2;

const G_BUTTONS: int = 3;

const G_BOARD: int = 4;

const G_BATT: int = 5;

const G_SCREEN: int = 6;

const G_SPACER: int = 7;

const G_BOARDL: int = 8;

const G_BOLTS: int = 9;

const G_DBODY: int = 10;

const G_DLID: int = 11;

const G_DCAV: int = 12;

const G_DBASE: int = 13;

// (The dock's handhelds and charger, there only when it is done.)
const G_DHH: int = 14;

const G_ALL: int = 32767;

HH_TITLE: []str = ["The back block", "The front block", "The nuts", "The buttons",
    "The board", "Into the front", "The board on", "Closing it", "Done"];

HH_TEXT: []str = ["Lay the wireless receiver in Battery 1's pocket, its coil down against where the back goes, foam over it, its wires up through Battery 2's channel. Glue Battery 1 on the back, its engraving out, and Battery 2 on it, lined up by their edges and the bolts' holes.",
    "Glue the front on the screen's layer. Set the acrylic in the window, its back just inside the front's (proud of the face if it must be: never sanded), and glue it from behind. Seal the five light tubes, then fill them with UV resin from behind, the face taped.",
    "Turn the front block over. Epoxy a nut into each hex in the screen's layer. To set them flush with its back face, lay the waxed spacer, the board's layer and the back block on them, and run the four bolts in as at the end. Leave it while it sets.",
    "Glue each button's discs on toothpicks through their middles, and cut them flush when set; break the standing caps' top edges with fine sandpaper. The small flush buttons' caps wait: they go on in their holes, face down (step 6).",
    "Face up: solder the wireless receiver's two wires (it is in the back block, beside the board) up into their pads. Keep them short: their slack goes in a bay over the receiver when it is closed.",
    "Face down, on a folded towel (the caps stand out of the front): the front block; the buttons into their holes (a flush button's cap first, dropped into its waxed hole, then its flange and stem glued on from behind); the screen face down on the window, foam pads on its corners; the spacer, then the board's layer.",
    "The screen's flex into its connector. Then thread the battery's plug up through the slot into its socket, and turn the board over onto them, into its layer; the battery lies on the board's back, its wire in the bay at its end, foam on it beside its wire.",
    "The receiver's wires' slack into its bay; the back block over it all; the four bolts in from the back, snug (thin washers under them, if the ply is thin).",
    "Turned over: done. Sand the edges round, if you like. Drag to look round it."];

HH_SHOW: []int = [1 << G_BACK, 1 << G_FRONT, 1 << G_FRONT | 1 << G_NUTS, 1 << G_BUTTONS,
    1 << G_BOARD, 1 << G_FRONT | 1 << G_NUTS | 1 << G_BUTTONS | 1 << G_SCREEN | 1 << G_SPACER | 1 << G_BOARDL,
    1 << G_FRONT | 1 << G_NUTS | 1 << G_BUTTONS | 1 << G_SCREEN | 1 << G_SPACER | 1 << G_BOARDL | 1 << G_BOARD | 1 << G_BATT,
    G_ALL, G_ALL];

HH_NEW: []int = [1 << G_BACK, 1 << G_FRONT, 1 << G_NUTS, 1 << G_BUTTONS, 1 << G_BOARD,
    1 << G_BUTTONS | 1 << G_SCREEN | 1 << G_SPACER | 1 << G_BOARDL, 1 << G_BOARD | 1 << G_BATT,
    1 << G_BACK | 1 << G_BOLTS, 0];

HH_FLIP: []bool = [false, false, true, false, false, true, true, true, false];

DK_TITLE: []str = ["The body", "The lid", "The cavities", "The base", "Done"];

DK_TEXT: []str = ["Glue the floor and the walls in order, two dowels (cut to 41 mm) through them to line them up, left standing 3 mm out of the top for the lid and about 9 mm below the floor, for the cavities and the base.",
    "Epoxy the box's four magnets into the top wall's holes, all one way up. Glue the lid's top on its frame; mark each lid magnet's face by its partner, then, the lid upside down away from the box, epoxy each into its hole against the top.",
    "Turn it over onto its lid (whose frame takes the dowels). Glue Cavity 2 under the floor; epoxy the base bolts' nuts into its hexes, flush with its underside, the waxed base on them as a jig, its bolts run in while it sets.",
    "The coils and the transmitters' boards into their pockets from below, on foam; Cavity 1 laid on them, not glued; the dock's board bolted to the base, the transmitters' wires soldered to it with the base lying beside; the base turned onto it like a page, its six bolts in; the feet glued under it.",
    "Turned over: done. Drag to look round it."];

DK_SHOW: []int = [1 << G_DBODY, 1 << G_DBODY | 1 << G_DLID, 1 << G_DBODY | 1 << G_DCAV | 1 << G_NUTS,
    1 << G_DBODY | 1 << G_DCAV | 1 << G_NUTS | 1 << G_DBASE | 1 << G_BOLTS, G_ALL];

DK_NEW: []int = [1 << G_DBODY, 1 << G_DLID, 1 << G_DCAV | 1 << G_NUTS, 1 << G_DBASE | 1 << G_BOLTS,
    0];

DK_FLIP: []bool = [false, false, true, true, false];

// Whether the steps are shown, which, and for how long (seconds, to the
// end of its pieces' coming); and how far turned over it is shown (0 face
// up, 1 face down).
sp_on: bool = false;

sp_k: int = 0;

sp_t: f32 = 0.0;

sp_flip_t: f32 = 0.0;

// (Whether this step turned it over first: its pieces wait for that.)
sp_turned: bool = false;

const SP_END: f32 = 3.2;

const SP_DROP: f32 = 30.0;

steps_n(): int {
    if (dock_on) return len(DK_TITLE);
    len(HH_TITLE)
}

steps_flip_of(k: int): bool {
    if (dock_on) return DK_FLIP[k];
    HH_FLIP[k]
}

steps_begin() {
    sp_on = true;
    sp_k = 0;
    sp_t = 0.0;
    sp_turned = steps_flip_of(0) != sp_flip_t > 0.5;
    exploded = false;
    explode_fit = false;
    stage_lid_off = false
}

steps_end() {
    sp_on = false
}

steps_go(k: int) {
    if (k < 0 || k >= steps_n()) return;
    sp_turned = steps_flip_of(k) != steps_flip_of(sp_k);
    sp_k = k;
    sp_t = 0.0
}

steps_next() {
    if (sp_k + 1 >= steps_n()) steps_end() else steps_go(sp_k + 1)
}

steps_back() {
    steps_go(sp_k - 1)
}

// Whether group g shows.
steps_shows(g: int): bool {
    if (!sp_on) return true;
    show: int = HH_SHOW[sp_k];
    if (dock_on) show = DK_SHOW[sp_k];
    (show >> g & 1) != 0
}

// The heights the step's new pieces go in at, lowest and highest (see
// v3_render, which finds them among its batches).
sp_zlo: f32 = 0.0;

sp_zhi: f32 = 1.0;

// Whether group g is new in the step shown.
steps_new(g: int): bool {
    if (!sp_on) return false;
    fresh: int = HH_NEW[sp_k];
    if (dock_on) fresh = DK_NEW[sp_k];
    (fresh >> g & 1) != 0
}

// When group g's piece at height z starts to come, in the step's time:
// each in its turn among the step's new pieces, from the bottom up, or
// face down from the top down (the back block, last, all at once); and
// none before the turning over is done.
steps_delay(g: int, z: f32): f32 {
    flip: bool = steps_flip_of(sp_k);
    order: f32 = 0.5;
    if (sp_zhi - sp_zlo > 0.5) order = clampf((z - sp_zlo) / (sp_zhi - sp_zlo), 0.0,
        1.0);
    if (flip) order = 1.0 - order;
    if (flip && g == G_BACK) order = 1.0;
    delay: f32 = 0.15 + order * 1.3;
    if (sp_turned) delay = delay + 0.9;
    delay
}

// Whether group g's piece at height z is yet to come (not shown).
steps_waiting(g: int, z: f32): bool {
    steps_new(g) && sp_t < steps_delay(g, z)
}

// How far up group g's piece at height z still is, coming into place
// (down the model's z, turned over: up as it is seen).
steps_dz(g: int, z: f32): f32 {
    if (!steps_new(g)) return 0.0;
    a: f32 = clampf((sp_t - steps_delay(g, z)) / 0.6, 0.0, 1.0);
    e: f32 = 1.0 - (1.0 - a) * (1.0 - a) * (1.0 - a);
    d: f32 = (1.0 - e) * SP_DROP;
    if (steps_flip_of(sp_k)) return -d;
    d
}

// How far turned over it shows, eased.
steps_flip(): f32 {
    t: f32 = sp_flip_t;
    t * t * (3.0 - 2.0 * t)
}

// A frame's worth of the pieces coming and the turning over. Whether it
// moved.
step_steps(dt: f32): bool {
    moving: bool = false;
    target: f32 = 0.0;
    if (sp_on && steps_flip_of(sp_k)) target = 1.0;
    if (sp_flip_t != target) {
        if (sp_flip_t < target) sp_flip_t = minf(sp_flip_t + dt * 1.25, target) else sp_flip_t = maxf(sp_flip_t - dt * 1.25,
            target);
        moving = true
    }
    if (sp_on && sp_t < SP_END) {
        sp_t = minf(sp_t + dt, SP_END);
        moving = true
    }
    moving
}

// The card's words for the step shown, into line: where the second line
// starts.
steps_words(): int {
    if (dock_on) line_add(DK_TITLE[sp_k]) else line_add(HH_TITLE[sp_k]);
    sub: int = line_n;
    line_add("Step ");
    line_int(sp_k + 1);
    line_add(" of ");
    line_int(steps_n());
    line_add(". ");
    if (dock_on) line_add(DK_TEXT[sp_k]) else line_add(HH_TEXT[sp_k]);
    sub
}
