tag cad;

use_tag std, gl, x11, skate;

// The view of the board: which point of it is in the middle of the window
// (cam_x, cam_y, in millimetres) and how many pixels a millimetre takes
// (cam_s). Fingers move it directly; let go mid-swipe and it glides on and
// slows (the fling); and the editor's own moves (fitting the board, a
// double tap's zoom) ease there over a few frames rather than jump.
cam_x: f32 = 0.0;

cam_y: f32 = 0.0;

cam_s: f32 = 6.0;

// The glide: pixels a second.
fling_x: f32 = 0.0;

fling_y: f32 = 0.0;

// An eased move: where to, and (with an anchor) the point of the board that
// stays under the same point of the window all the way.
ease_on: bool = false;

ease_x: f32 = 0.0;

ease_y: f32 = 0.0;

ease_s: f32 = 6.0;

ease_anchored: bool = false;

ease_ax: f32 = 0.0;

ease_ay: f32 = 0.0;

ease_sx: f32 = 0.0;

ease_sy: f32 = 0.0;

// What the editor's own things cover: the title along the top and the
// tools along the bottom, in window pixels (and the phone's own edges).
view_top: f32 = 64.0;

view_bottom: f32 = 96.0;

safe_top: f32 = 0.0;

safe_bottom: f32 = 0.0;

safe_left: f32 = 0.0;

safe_right: f32 = 0.0;

to_sx(x: f32): f32 {
    scr_w as f32 * 0.5 + (x - cam_x) * cam_s
}

to_sy(y: f32): f32 {
    scr_h as f32 * 0.5 - (y - cam_y) * cam_s
}

to_bx(sx: f32): f32 {
    cam_x + (sx - scr_w as f32 * 0.5) / cam_s
}

to_by(sy: f32): f32 {
    cam_y - (sy - scr_h as f32 * 0.5) / cam_s
}

// The least and most zoom: from a board a third of the window to a
// millimetre a third of it.
min_scale(): f32 {
    minf(scr_w as f32 / maxf(brd_w, 1.0), scr_h as f32 / maxf(brd_h, 1.0)) * 0.3
}

max_scale(): f32 {
    minf(scr_w as f32, scr_h as f32) * 0.4
}

// Zoom by k about the window point (sx, sy), at once.
zoom_at(sx: f32, sy: f32, k: f32) {
    bx: f32 = to_bx(sx);
    by: f32 = to_by(sy);
    cam_s = clampf(cam_s * k, min_scale(), max_scale());
    cam_x = bx - (sx - scr_w as f32 * 0.5) / cam_s;
    cam_y = by + (sy - scr_h as f32 * 0.5) / cam_s
}

// Move so that the board point (bx, by) is under the window point (sx, sy).
pin_view(
    bx: f32,
    by: f32,
    sx: f32,
    sy: f32
) {
    cam_x = bx - (sx - scr_w as f32 * 0.5) / cam_s;
    cam_y = by + (sy - scr_h as f32 * 0.5) / cam_s
}

// Ease to show the box (x0, y0)-(x1, y1) of the board, in the room the
// editor's things leave.
ease_to_box(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    // (With the room as it is now: a mode's card may have come or gone.)
    layout_ui();
    margin: f32 = 18.0;
    room_w: f32 = scr_w as f32 - 2.0 * margin - safe_left - safe_right;
    room_h: f32 = scr_h as f32 - view_top - view_bottom - 2.0 * margin;
    s: f32 = clampf(minf(room_w / maxf(x1 - x0, 0.1), room_h / maxf(y1 - y0, 0.1)),
        min_scale(), max_scale());
    mid_y: f32 = (view_top + scr_h as f32 - view_bottom) * 0.5;
    mid_x: f32 = (safe_left + scr_w as f32 - safe_right) * 0.5;
    // (On a wide, short window, the title at the left and the pills at the
    // right leave the top's middle free: if the box fits between them, it
    // may go up into it.)
    if (tl_py < safe_top + 30.0) {
        top: f32 = safe_top + 12.0;
        s2: f32 = clampf(minf(room_w / maxf(x1 - x0, 0.1), (scr_h as f32 - top - view_bottom - 2.0 * margin) / maxf(y1 - y0,
            0.1)), min_scale(), max_scale());
        // (As wide as the gap between them allows.)
        gap: f32 = minf(mid_x - (12.0 + safe_left + tl_w + 8.0), minf(tl_px, tl_mx) - 8.0 - mid_x);
        s2 = minf(s2, 2.0 * gap / maxf(x1 - x0, 0.1));
        if (s2 > s) {
            s = s2;
            mid_y = (top + scr_h as f32 - view_bottom) * 0.5
        }
    }
    ease_s = s;
    ease_x = (x0 + x1) * 0.5 - (mid_x - scr_w as f32 * 0.5) / s;
    ease_y = (y0 + y1) * 0.5 + (mid_y - scr_h as f32 * 0.5) / s;
    ease_anchored = false;
    ease_on = true;
    fling_x = 0.0;
    fling_y = 0.0
}

// Whether the view is the board fitted, untouched since (a new window
// size fits it again).
view_fitted: bool = false;

fit_board() {
    view_fitted = true;
    // (In the Case mode, the case: it is bigger than the board.)
    if (mode == MODE_CASE && cs_on) {
        ease_to_box(case_x0(), case_y0(), case_x1(), case_y1());
        return
    }
    ease_to_box(-brd_w * 0.5, -brd_h * 0.5, brd_w * 0.5, brd_h * 0.5)
}

// Ease to zoom by k about the window point (sx, sy).
ease_zoom_at(sx: f32, sy: f32, k: f32) {
    view_fitted = false;
    ease_ax = to_bx(sx);
    ease_ay = to_by(sy);
    ease_sx = sx;
    ease_sy = sy;
    base: f32 = cam_s;
    if (ease_on) base = ease_s;
    ease_s = clampf(base * k, min_scale(), max_scale());
    ease_anchored = true;
    ease_on = true;
    fling_x = 0.0;
    fling_y = 0.0
}

stop_view() {
    view_fitted = false;
    ease_on = false;
    fling_x = 0.0;
    fling_y = 0.0
}

// A frame's worth of easing and gliding. Whether it moved.
step_view(dt: f32): bool {
    moved: bool = false;
    if (ease_on) {
        k: f32 = 1.0 - expf(-dt * 14.0);
        ls: f32 = lerpf(logf32(cam_s), logf32(ease_s), k);
        cam_s = expf(ls);
        if (ease_anchored) pin_view(ease_ax, ease_ay, ease_sx, ease_sy) else {
            cam_x = lerpf(cam_x, ease_x, k);
            cam_y = lerpf(cam_y, ease_y, k)
        }
        moved = true;
        if (absf(cam_s / ease_s - 1.0) < 0.002 && (ease_anchored || absf(cam_x - ease_x) * cam_s < 0.3 && absf(cam_y - ease_y) * cam_s < 0.3)) {
            cam_s = ease_s;
            if (ease_anchored) pin_view(ease_ax, ease_ay, ease_sx, ease_sy) else {
                cam_x = ease_x;
                cam_y = ease_y
            }
            ease_on = false
        }
    }
    if (fling_x != 0.0 || fling_y != 0.0) {
        cam_x = cam_x - fling_x * dt / cam_s;
        cam_y = cam_y + fling_y * dt / cam_s;
        f: f32 = expf(-dt * 4.0);
        fling_x = fling_x * f;
        fling_y = fling_y * f;
        if (fling_x * fling_x + fling_y * fling_y < 64.0) {
            fling_x = 0.0;
            fling_y = 0.0
        }
        moved = true
    }
    // (The board is never lost: its middle stays within the window.)
    hx: f32 = brd_w * 0.5 + scr_w as f32 * 0.4 / cam_s;
    hy: f32 = brd_h * 0.5 + scr_h as f32 * 0.4 / cam_s;
    cam_x = clampf(cam_x, -hx, hx);
    cam_y = clampf(cam_y, -hy, hy);
    moved
}

// ln x, for x > 0: by its exponent, and the series for what is left.
logf32(x: f32): f32 {
    log64(x as f64) as f32
}

// The step of the grid things snap to at this zoom: the least of 0.05,
// 0.1, 0.25, 0.5, 1, 2.5 and 5 mm that is at least 9 pixels.
GRID_STEPS: []f32 = [0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0];

grid_step(): f32 {
    for k in 0..len(GRID_STEPS) {
        if (GRID_STEPS[k] * cam_s >= 9.0) return GRID_STEPS[k]
    }
    5.0
}

snap(v: f32, g: f32): f32 {
    floorf(v / g + 0.5) * g
}
