tag terminal;

// Bounded storage avoids allocating on output or resize. Each buffer has its own cursor.
type Screen = {
    text: []i8;
    fg: []int;
    bg: []int;
    cols: int;
    rows: int;
    x: int;
    y: int;
    sx: int;
    sy: int;
    top: int;
    bottom: int;
    color: int;
    back: int;
    bold: bool;
    inverse: bool;
    wrap: bool;
    autowrap: bool;
    visible: bool;
    application: bool;
    state: int;
    params: []int;
    count: int;
    private: bool;
};

terminal_screen(cols: int, rows: int): *Screen@new {
    new Screen {
        text: new i8[28800](32i8),
        fg: new int[28800](7),
        bg: new int[28800](0),
        cols: cols,
        rows: rows,
        x: 0,
        y: 0,
        sx: 0,
        sy: 0,
        top: 0,
        bottom: rows - 1,
        color: 7,
        back: 0,
        bold: false,
        inverse: false,
        wrap: false,
        autowrap: true,
        visible: true,
        application: false,
        state: 0,
        params: new int[16](0),
        count: 0,
        private: false
    };
}

terminal_clamp(n: int, lo: int, hi: int): int {
    if (n < lo) {
        return lo;
    }
    if (n > hi) {
        return hi;
    }
    n;
}

terminal_clear(s: *Screen, start: int, end: int) {
    i: int = start;
    while (i < end) {
        s.text[i] = 32i8;
        s.fg[i] = s.color;
        s.bg[i] = s.back;
        i = i + 1;
    }
}

terminal_resize(s: *Screen, cols: int, rows: int) {
    cols = terminal_clamp(cols, 2, 240);
    rows = terminal_clamp(rows, 2, 120);
    y: int = 0;
    while (y < rows) {
        if (y >= s.rows) {
            terminal_clear(s, y * 240, y * 240 + cols);
        } else {
            if (cols > s.cols) {
                terminal_clear(s, y * 240 + s.cols, y * 240 + cols);
            }
        }
        y = y + 1;
    }
    s.cols = cols;
    s.rows = rows;
    s.top = 0;
    s.bottom = rows - 1;
    s.x = terminal_clamp(s.x, 0, cols - 1);
    s.y = terminal_clamp(s.y, 0, rows - 1);
    s.wrap = false;
}

terminal_scroll(
    s: *Screen,
    top: int,
    bottom: int,
    down: bool
) {
    y: int = top;
    while (y < bottom) {
        dst: int = y;
        src: int = y + 1;
        if (down) {
            dst = bottom - y + top;
            src = dst - 1;
        }
        x: int = 0;
        while (x < s.cols) {
            a: int = dst * 240 + x;
            b: int = src * 240 + x;
            s.text[a] = s.text[b];
            s.fg[a] = s.fg[b];
            s.bg[a] = s.bg[b];
            x = x + 1;
        }
        y = y + 1;
    }
    y = bottom;
    if (down) {
        y = top;
    }
    terminal_clear(s, y * 240, y * 240 + s.cols);
}

terminal_lf(s: *Screen) {
    s.wrap = false;
    if (s.y == s.bottom) {
        terminal_scroll(s, s.top, s.bottom, false);
    } else {
        s.y = terminal_clamp(s.y + 1, 0, s.rows - 1);
    }
}

terminal_param(s: *Screen, i: int, fallback: int): int {
    if (i > s.count || s.params[i] == 0) {
        return fallback;
    }
    s.params[i];
}

// Values 0..255 name the xterm palette. Larger values carry an RGB triplet
// after a 256 bias, keeping the common indexed representation compact.
terminal_rgb(red: int, green: int, blue: int): int {
    256 + terminal_clamp(red, 0, 255) * 65536 + terminal_clamp(green, 0, 255) * 256 + terminal_clamp(blue,
        0, 255);
}

// Returns 1/2 to enter/leave the alternate buffer, 3/4 for device/status replies.
terminal_csi(s: *Screen, c: int): int {
    n: int = terminal_clamp(terminal_param(s, 0, 1), 1, 240);
    p: int = s.params[0];
    if (c != 109 && c != 110 && c != 99 && c != 104 && c != 108) {
        s.wrap = false;
    }
    if (s.private) {
        if (c == 104 || c == 108) {
            enabled: bool = c == 104;
            i: int = 0;
            while (i <= s.count) {
                p = s.params[i];
                if (p == 25) {
                    s.visible = enabled;
                }
                if (p == 7) {
                    s.autowrap = enabled;
                }
                if (p == 1) {
                    s.application = enabled;
                }
                if (p == 1049 || p == 47 || p == 1047) {
                    if (enabled) {
                        return 1;
                    } else {
                        return 2;
                    }
                }
                i = i + 1;
            }
        }
        return 0;
    }
    if (c == 65) {
        s.y = s.y - n;
    }
    if (c == 66 || c == 101) {
        s.y = s.y + n;
    }
    if (c == 67 || c == 97) {
        s.x = s.x + n;
    }
    if (c == 68) {
        s.x = s.x - n;
    }
    if (c == 69) {
        s.y = s.y + n;
        s.x = 0;
    }
    if (c == 70) {
        s.y = s.y - n;
        s.x = 0;
    }
    if (c == 71 || c == 96) {
        s.x = n - 1;
    }
    if (c == 100) {
        s.y = n - 1;
    }
    if (c == 72 || c == 102) {
        s.y = n - 1;
        s.x = terminal_param(s, 1, 1) - 1;
    }
    s.x = terminal_clamp(s.x, 0, s.cols - 1);
    s.y = terminal_clamp(s.y, 0, s.rows - 1);
    pos: int = s.y * 240 + s.x;
    if (c == 74) {
        y: int = 0;
        while (y < s.rows) {
            a: int = y * 240;
            b: int = a + s.cols;
            if (p == 0 && y < s.y) {
                a = b;
            }
            if (p == 0 && y == s.y) {
                a = pos;
            }
            if (p == 1 && y > s.y) {
                b = a;
            }
            if (p == 1 && y == s.y) {
                b = pos + 1;
            }
            if (p <= 2) {
                terminal_clear(s, a, b);
            }
            y = y + 1;
        }
    }
    if (c == 75) {
        if (p == 0) {
            terminal_clear(s, pos, s.y * 240 + s.cols);
        }
        if (p == 1) {
            terminal_clear(s, s.y * 240, pos + 1);
        }
        if (p == 2) {
            terminal_clear(s, s.y * 240, s.y * 240 + s.cols);
        }
    }
    if (c == 88) {
        terminal_clear(s, pos, s.y * 240 + terminal_clamp(s.x + n, 0, s.cols));
    }
    if (c == 80 || c == 64) {
        n = terminal_clamp(n, 1, s.cols - s.x);
        i: int = 0;
        while (i < s.cols - s.x - n) {
            a: int = pos + i;
            b: int = a + n;
            if (c == 64) {
                a = s.y * 240 + s.cols - 1 - i;
                b = a - n;
            }
            s.text[a] = s.text[b];
            s.fg[a] = s.fg[b];
            s.bg[a] = s.bg[b];
            i = i + 1;
        }
        if (c == 64) {
            terminal_clear(s, pos, pos + n);
        } else {
            terminal_clear(s, s.y * 240 + s.cols - n, s.y * 240 + s.cols);
        }
    }
    if (c == 76 || c == 77 || c == 83 || c == 84) {
        top: int = s.top;
        if (c == 76 || c == 77) {
            top = s.y;
        }
        if (top >= s.top && top <= s.bottom) {
            n = terminal_clamp(n, 1, s.bottom - top + 1);
            while (n > 0) {
                terminal_scroll(s, top, s.bottom, c == 76 || c == 84);
                n = n - 1;
            }
        }
    }
    if (c == 114) {
        a: int = terminal_param(s, 0, 1) - 1;
        b: int = terminal_param(s, 1, s.rows) - 1;
        if (a >= 0 && a < b && b < s.rows) {
            s.top = a;
            s.bottom = b;
            s.x = 0;
            s.y = 0;
        }
    }
    if (c == 115) {
        s.sx = s.x;
        s.sy = s.y;
    }
    if (c == 117) {
        s.x = terminal_clamp(s.sx, 0, s.cols - 1);
        s.y = terminal_clamp(s.sy, 0, s.rows - 1);
    }
    if (c == 109) {
        i: int = 0;
        while (i <= s.count) {
            p = s.params[i];
            if (p == 0) {
                s.color = 7;
                s.back = 0;
                s.bold = false;
                s.inverse = false;
            }
            if (p == 1) {
                s.bold = true;
            }
            if (p == 22) {
                s.bold = false;
            }
            if (p == 7) {
                s.inverse = true;
            }
            if (p == 27) {
                s.inverse = false;
            }
            if (p == 39) {
                s.color = 7;
            }
            if (p == 49) {
                s.back = 0;
            }
            if (p >= 30 && p <= 37) {
                s.color = p - 30;
            }
            if (p >= 40 && p <= 47) {
                s.back = p - 40;
            }
            if (p >= 90 && p <= 97) {
                s.color = p - 90 + 8;
            }
            if (p >= 100 && p <= 107) {
                s.back = p - 100 + 8;
            }
            if (p == 38 || p == 48) {
                extended: int = -1;
                if (i + 2 <= s.count && s.params[i + 1] == 5) {
                    extended = terminal_clamp(s.params[i + 2], 0, 255);
                    i = i + 2;
                } else {
                    if (i + 4 <= s.count && s.params[i + 1] == 2) {
                        extended = terminal_rgb(s.params[i + 2], s.params[i + 3],
                            s.params[i + 4]);
                        i = i + 4;
                    }
                }
                if (extended >= 0) {
                    if (p == 38) {
                        s.color = extended;
                    } else {
                        s.back = extended;
                    }
                }
            }
            i = i + 1;
        }
    }
    if (c == 110 && p == 6) {
        return 3;
    }
    if (c == 110 && p == 5) {
        return 4;
    }
    0;
}

terminal_byte(s: *Screen, byte: i8): int {
    c: int = byte as int;
    if (c < 0) {
        c = c + 256;
    }
    if (s.state == 3) {
        if (c == 7) {
            s.state = 0;
        }
        if (c == 27) {
            s.state = 4;
        }
        return 0;
    }
    if (s.state == 4) {
        if (c == 92) {
            s.state = 0;
        } else {
            s.state = 3;
        }
        return 0;
    }
    if (c == 27) {
        s.state = 1;
        return 0;
    }
    if (c == 24 || c == 26) {
        s.state = 0;
        return 0;
    }
    if (c == 13) {
        s.x = 0;
        s.wrap = false;
        return 0;
    }
    if (c == 10 || c == 11 || c == 12) {
        terminal_lf(s);
        return 0;
    }
    if (c == 8) {
        s.x = terminal_clamp(s.x - 1, 0, s.cols - 1);
        s.wrap = false;
        return 0;
    }
    if (c == 9) {
        s.x = terminal_clamp((s.x / 8 + 1) * 8, 0, s.cols - 1);
        s.wrap = false;
        return 0;
    }
    if (c < 32 || c == 127) {
        return 0;
    }
    if (s.state == 5) {
        s.state = 0;
        return 0;
    }
    if (s.state == 1) {
        s.state = 0;
        if (c == 91) {
            s.state = 2;
            s.count = 0;
            s.private = false;
            i: int = 0;
            while (i < 16) {
                s.params[i] = 0;
                i = i + 1;
            }
        }
        if (c == 93 || c == 80 || c == 94 || c == 95) {
            s.state = 3;
        }
        if (c == 40 || c == 41) {
            s.state = 5;
        }
        if (c == 55) {
            s.sx = s.x;
            s.sy = s.y;
        }
        if (c == 56) {
            s.x = terminal_clamp(s.sx, 0, s.cols - 1);
            s.y = terminal_clamp(s.sy, 0, s.rows - 1);
            s.wrap = false;
        }
        if (c == 68) {
            terminal_lf(s);
        }
        if (c == 69) {
            s.x = 0;
            terminal_lf(s);
        }
        if (c == 77) {
            if (s.y == s.top) {
                terminal_scroll(s, s.top, s.bottom, true);
            } else {
                s.y = terminal_clamp(s.y - 1, 0, s.rows - 1);
            }
        }
        if (c == 99) {
            s.color = 7;
            s.back = 0;
            s.bold = false;
            s.inverse = false;
            terminal_clear(s, 0, 28800);
            s.x = 0;
            s.y = 0;
            s.top = 0;
            s.bottom = s.rows - 1;
            s.wrap = false;
            s.autowrap = true;
            s.visible = true;
            s.application = false;
        }
        return 0;
    }
    if (s.state == 6) {
        if (c >= 64 && c <= 126) {
            s.state = 0;
        }
        return 0;
    }
    if (s.state == 2) {
        if (c >= 48 && c <= 57) {
            s.params[s.count] = terminal_clamp(s.params[s.count] * 10 + c - 48, 0,
                9999);
            return 0;
        }
        if (c == 59) {
            if (s.count < 15) {
                s.count = s.count + 1;
            } else {
                s.state = 6;
            }
            return 0;
        }
        if (c == 63) {
            s.private = true;
            return 0;
        }
        if (c >= 64 && c <= 126) {
            s.state = 0;
            return terminal_csi(s, c);
        }
        s.state = 6;
        return 0;
    }
    if (s.wrap && s.autowrap) {
        s.x = 0;
        terminal_lf(s);
    }
    pos: int = s.y * 240 + s.x;
    if (c > 126) {
        c = 63;
    }
    s.text[pos] = c trunc i8;
    fg: int = s.color;
    bg: int = s.back;
    if (s.bold && fg < 8) {
        fg = fg + 8;
    }
    if (s.inverse) {
        s.fg[pos] = bg;
        s.bg[pos] = fg;
    } else {
        s.fg[pos] = fg;
        s.bg[pos] = bg;
    }
    if (s.x == s.cols - 1) {
        s.wrap = true;
    } else {
        s.x = s.x + 1;
    }
    0;
}
