tag terminal;

use_tag wayland;

import "screen.l8";

import "pty.l8";

import "render.l8";

// A bounded queue preserves partial writes and keeps window events responsive under PTY backpressure.
type TerminalInput = {
    data: []i8;
    size: int;
};

terminal_queue(q: *TerminalInput, data: [64]i8, size: int) {
    if (q.size + size <= len(q.data)) {
        i: int = 0;
        while (i < size) {
            q.data[q.size] = data[i];
            q.size = q.size + 1;
            i = i + 1;
        }
    }
}

terminal_send(q: *TerminalInput, text: str) {
    if (q.size + len(text) <= len(q.data)) {
        for c in text {
            q.data[q.size] = c;
            q.size = q.size + 1;
        }
    }
}

terminal_escape(q: *TerminalInput, text: str) {
    if (q.size + len(text) + 1 <= len(q.data)) {
        q.data[q.size] = 27i8;
        q.size = q.size + 1;
        terminal_send(q, text);
    }
}

terminal_number(q: *TerminalInput, n: int) {
    if (n >= 10) {
        terminal_number(q, n / 10);
    }
    // Do not mutate string literals.
    if (q.size < len(q.data)) {
        q.data[q.size] = (48 + n % 10) trunc i8;
        q.size = q.size + 1;
    }
}

terminal_key(
    s: *Screen,
    q: *TerminalInput,
    sym: int,
    buf: [64]i8,
    n: int
) {
    if (q.size > len(q.data) - 64) {
        return;
    }
    if (sym >= 65361 && sym <= 65364) {
        if (s.application) {
            terminal_escape(q, "O");
        } else {
            terminal_escape(q, "[");
        }
        if (sym == 65361) {
            terminal_send(q, "D");
        }
        if (sym == 65362) {
            terminal_send(q, "A");
        }
        if (sym == 65363) {
            terminal_send(q, "C");
        }
        if (sym == 65364) {
            terminal_send(q, "B");
        }
    } else {
        if (sym == 65288) {
            q.data[q.size] = 127i8;
            q.size = q.size + 1;
        } else {
            if (sym == 65535) {
                terminal_escape(q, "[3~");
            } else {
                if (sym == 65360) {
                    terminal_escape(q, "[H");
                } else {
                    if (sym == 65367) {
                        terminal_escape(q, "[F");
                    } else {
                        if (sym == 65365) {
                            terminal_escape(q, "[5~");
                        } else {
                            if (sym == 65366) {
                                terminal_escape(q, "[6~");
                            } else {
                                if (sym == 65379) {
                                    terminal_escape(q, "[2~");
                                } else {
                                    if (sym >= 65470 && sym <= 65473) {
                                        terminal_escape(q, "O");
                                        if (q.size < len(q.data)) {
                                            q.data[q.size] = (80 + sym - 65470) trunc i8;
                                            q.size = q.size + 1;
                                        }
                                    } else {
                                        terminal_queue(q, buf, n);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

main(argc: int, argv: []str@new) noregion: int {
    font_path: str = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf";
    font_size: int = 18;
    command: ?str = null;
    arg: int = 1;
    while (arg < argc) {
        if (argv[arg] == "--help") {
            write(1, "Usage: terminal [--font path.ttf] [--font-size 8..32] [shell-command]\n",
                len("Usage: terminal [--font path.ttf] [--font-size 8..32] [shell-command]\n"));
            return 0;
        }
        if (argv[arg] == "--font" || argv[arg] == "--font-size") {
            if (arg + 1 >= argc) {
                return 2;
            }
            if (argv[arg] == "--font") {
                font_path = argv[arg + 1];
            } else {
                font_size = 0;
                for c in argv[arg + 1] {
                    if (c < '0' || c > '9' || font_size > 32) {
                        return 2;
                    }
                    font_size = font_size * 10 + c as int - 48;
                }
                if (font_size < 8 || font_size > 32) {
                    return 2;
                }
            }
            arg = arg + 2;
        } else {
            if (command != null) {
                return 2;
            }
            command = argv[arg];
            arg = arg + 1;
        }
    }
    renderer0: ?*TerminalRenderer = terminal_renderer(font_path, font_size);
    if (renderer0 == null) {
        write(2, "terminal: Wayland/EGL/font setup failed\n", len("terminal: Wayland/EGL/font setup failed\n"));
        return 1;
    }
    renderer: *TerminalRenderer = renderer0;
    window: *WLWindow = renderer.window;
    main_screen: *Screen = terminal_screen(80, 24);
    alt_screen: *Screen = terminal_screen(80, 24);
    s: *Screen = main_screen;
    pty: TerminalPty = terminal_spawn(command, wl_display_get_fd(window.display) as int,
        80, 24);
    if (pty.child < 0) {
        terminal_renderer_close(renderer);
        write(2, "terminal: PTY setup failed\n", len("terminal: PTY setup failed\n"));
        return 1;
    }
    master: int = pty.master;
    child: i32 = pty.child trunc i32;
    q: *TerminalInput = new TerminalInput { data: new i8[65536](0i8), size: 0 };
    buf: []i8 = new i8[32768](0i8);
    polls: []TerminalPoll = new TerminalPoll[2](TerminalPoll { fd: 0i32, events: 0i32 });
    batch: *TerminalOutputBatch = terminal_output_batch();
    running: bool = true;
    dirty: bool = true;
    status: i32 = 0i32;
    reaped: bool = false;
    while (running) {
        if (wl_display_dispatch_pending(window.display) < 0i32) {
            window.closed = true;
        }
        wl_window_repeat(window, wl_mono_ms());
        while (window.key_count > 0) {
            index: int = window.key_head;
            terminal_key(s, q, window.keys[index].sym as int, window.keys[index].text,
                window.keys[index].size);
            window.key_head = (index + 1) % 128;
            window.key_count = window.key_count - 1;
        }
        if (window.changed) {
            dirty = true;
            window.changed = false;
        }
        if (window.closed) {
            running = false;
        }
        if (running) {
            if (dirty) {
                renderer.width = window.width;
                renderer.height = window.height;
                cols: int = terminal_clamp((window.width - 16) / renderer.cw, 2, 240);
                rows: int = terminal_clamp((window.height - 16) / renderer.ch, 2,
                    120);
                if (cols != s.cols || rows != s.rows) {
                    terminal_resize(main_screen, cols, rows);
                    terminal_resize(alt_screen, cols, rows);
                    if (!terminal_pty_size(master, cols, rows)) {
                        running = false;
                    }
                }
            }
            polls[0].fd = master trunc i32;
            polls[0].events = 1i32;
            if (q.size > 0) {
                polls[0].events = 5i32;
            }
            polls[1].fd = wl_display_get_fd(window.display);
            ready_events: int = wl_window_prepare(window);
            if (ready_events < 0) {
                running = false;
                polls[1].fd = -1i32;
            }
            polls[1].events = ready_events trunc i32;
            timeout: i32 = 50i32;
            if (dirty && window.frame_ready) {
                timeout = terminal_output_delay(batch, wl_mono_ms()) trunc i32;
            } else {
                if ((renderer.cursor.cursor_active || renderer.scene.scene_active) && window.frame_ready) {
                    timeout = 16i32;
                }
            }
            if (window.repeat_key != 0u32) {
                until: int = window.repeat_at - wl_mono_ms();
                if (until < 0) {
                    until = 0;
                }
                if (until < timeout as int) {
                    timeout = until trunc i32;
                }
            }
            polled: int = l8_poll(&polls[0], 2, timeout);
            events: int = polls[1].events as int >> 16 & 65535;
            if (polled < 0) {
                events = 0;
            }
            if (ready_events >= 0) {
                wl_window_finish(window, events);
            }
            if (polled < 0 && polled != -4 || window.closed) {
                running = false;
            }
            // Reads and writes are nonblocking, so races with readiness are harmless.
            if (q.size > 0) {
                sent: int = write(master, q.data, q.size);
                if (sent > 0) {
                    i: int = sent;
                    while (i < q.size) {
                        q.data[i - sent] = q.data[i];
                        i = i + 1;
                    }
                    q.size = q.size - sent;
                } else {
                    if (sent != -4 && sent != -11) {
                        running = false;
                    }
                }
            }
            // Coalesce a bounded batch before drawing. Full-screen applications
            // often split one visual update across several PTY reads; exposing a
            // cursor position from the middle of that update bends its animation.
            reads: int = 0;
            draining: bool = true;
            while (running && draining && reads < 8) {
                n: int = read(master, buf, len(buf));
                if (n > 0) {
                    terminal_output_received(batch, wl_mono_ms());
                    dirty = true;
                    reads = reads + 1;
                    i: int = 0;
                    while (i < n) {
                        action: int = terminal_byte(s, buf[i]);
                        cursor_style: int = s.cursor_style;
                        if (action == 1 && s == main_screen) {
                            terminal_clear(alt_screen, 0, 28800);
                            alt_screen.x = 0;
                            alt_screen.y = 0;
                            alt_screen.wrap = false;
                            s = alt_screen;
                        }
                        if (action == 2) {
                            s = main_screen;
                        }
                        if (action == 3 && q.size <= len(q.data) - 16) {
                            terminal_escape(q, "[");
                            terminal_number(q, s.y + 1);
                            terminal_send(q, ";");
                            terminal_number(q, s.x + 1);
                            terminal_send(q, "R");
                        }
                        if (action == 4) {
                            terminal_escape(q, "[0n");
                        }
                        // Cursor style is terminal-wide rather than screen-buffer state.
                        main_screen.cursor_style = cursor_style;
                        alt_screen.cursor_style = cursor_style;
                        i = i + 1;
                    }
                } else {
                    draining = false;
                    if (n == 0 || n < 0 && n != -4 && n != -11) {
                        running = false;
                    }
                }
            }
            now: int = wl_mono_ms();
            if (terminal_cursor_frame(s, renderer, now)) {
                dirty = true;
            }
            if (dirty && window.frame_ready && running && terminal_output_delay(batch,
                now) == 0) {
                terminal_draw(s, renderer, now);
                batch.pending = false;
                dirty = false;
            }
            if (!reaped) {
                if (l8_waitpid(child, &status, 1i32) == child as int) {
                    reaped = true;
                }
            }
        }
    }
    close(master);
    if (!reaped) {
        l8_kill(child as int, 1);
        // Closing the terminal must not hang on a shell which ignores SIGHUP.
        tries: int = 0;
        while (tries < 20 && !reaped) {
            if (l8_waitpid(child, &status, 1i32) == child as int) {
                reaped = true;
            } else {
                polls[0].fd = -1i32;
                polls[0].events = 0i32;
                l8_poll(&polls[0], 1, 10i32);
            }
            tries = tries + 1;
        }
        if (!reaped) {
            l8_kill(child as int, 9);
            l8_waitpid(child, &status, 0i32);
        }
    }
    terminal_renderer_close(renderer);
    0;
}
