tag terminal;

import "screen.l8";

// A clipped fractional row may straddle a pane edge. Two grids cover all visible
// departing cells, including those edge rows; the second half of the storage is
// scratch space so rebuilding ghosts never overwrites the retained snapshot.
TERMINAL_GHOST_CAPACITY: int = 57600;

// Bounds are half-open cell coordinates. Each leaf owns its matching and clip
// rectangle, so neighboring panes never share source cells or departing glyphs.
type TerminalSceneRegion = {
    left: int;
    top: int;
    right: int;
    bottom: int;
    shift: int;
    from_y: f32;
    fixed: bool
}

type TerminalScene = {
    scene_text: []int;
    scene_comb: []int;
    scene_fg: []int;
    scene_bg: []int;
    scene_cols: int;
    scene_rows: int;
    scene_ready: bool;
    scene_from_x: []f32;
    scene_from_y: []f32;
    scene_from_alpha: []f32;
    scene_visual_x: []f32;
    scene_visual_y: []f32;
    scene_visual_alpha: []f32;
    scene_fixed: []int;
    scene_match: []int;
    scene_used: []int;
    scene_diff: []int;
    scene_regions: []TerminalSceneRegion;
    scene_previous: []TerminalSceneRegion;
    scene_region_count: int;
    scene_region: []int;
    zero_columns: []int;
    zero_rows: []int;
    score_columns: []int;
    score_rows: []int;
    score_left: []int;
    score_right: []int;
    score_top: []int;
    score_bottom: []int;
    score_top_shift: []int;
    score_bottom_shift: []int;
    scene_started: int;
    scene_active: bool;
    scene_has_shift: bool;
    ghost_text: []int;
    ghost_comb: []int;
    ghost_fg: []int;
    ghost_from_x: []f32;
    ghost_from_y: []f32;
    ghost_to_x: []f32;
    ghost_to_y: []f32;
    ghost_from_alpha: []f32;
    ghost_fade: []int;
    ghost_clip: []TerminalSceneRegion;
    ghost_count: int
}

terminal_scene(): *TerminalScene@new {
    empty: TerminalSceneRegion = terminal_scene_region(0, 0, 0, 0);
    new TerminalScene {
        scene_text: new int[28800](32),
        scene_comb: new int[28800](0),
        scene_fg: new int[28800](7),
        scene_bg: new int[28800](0),
        scene_cols: 0,
        scene_rows: 0,
        scene_ready: false,
        scene_from_x: new f32[28800](0.0),
        scene_from_y: new f32[28800](0.0),
        scene_from_alpha: new f32[28800](1.0),
        scene_visual_x: new f32[28800](0.0),
        scene_visual_y: new f32[28800](0.0),
        scene_visual_alpha: new f32[28800](1.0),
        scene_fixed: new int[28800](0),
        scene_match: new int[28800](0),
        scene_used: new int[28800](0),
        scene_diff: new int[58081](0),
        scene_regions: new TerminalSceneRegion[256](empty),
        scene_previous: new TerminalSceneRegion[256](empty),
        scene_region_count: 0,
        scene_region: new int[28800](0),
        zero_columns: new int[241](0),
        zero_rows: new int[121](0),
        score_columns: new int[241](0),
        score_rows: new int[121](0),
        score_left: new int[241](0),
        score_right: new int[241](0),
        score_top: new int[121](0),
        score_bottom: new int[121](0),
        score_top_shift: new int[121](0),
        score_bottom_shift: new int[121](0),
        scene_started: 0,
        scene_active: false,
        scene_has_shift: false,
        ghost_text: new int[TERMINAL_GHOST_CAPACITY * 2](32),
        ghost_comb: new int[TERMINAL_GHOST_CAPACITY * 2](0),
        ghost_fg: new int[TERMINAL_GHOST_CAPACITY * 2](7),
        ghost_from_x: new f32[TERMINAL_GHOST_CAPACITY * 2](0.0),
        ghost_from_y: new f32[TERMINAL_GHOST_CAPACITY * 2](0.0),
        ghost_to_x: new f32[TERMINAL_GHOST_CAPACITY * 2](0.0),
        ghost_to_y: new f32[TERMINAL_GHOST_CAPACITY * 2](0.0),
        ghost_from_alpha: new f32[TERMINAL_GHOST_CAPACITY * 2](0.0),
        ghost_fade: new int[TERMINAL_GHOST_CAPACITY * 2](1),
        ghost_clip: new TerminalSceneRegion[TERMINAL_GHOST_CAPACITY * 2](empty),
        ghost_count: 0
    }
}

terminal_scene_equal(
    s: *Screen,
    r: *TerminalScene,
    new_pos: int,
    old_pos: int
): bool {
    s.text[new_pos] == r.scene_text[old_pos] && s.comb[new_pos] == r.scene_comb[old_pos]
}

terminal_scene_ease(r: *TerminalScene, now: int): f32 {
    if (!r.scene_active) return 1.0;
    elapsed: int = now - r.scene_started;
    if (elapsed >= 120) return 1.0;
    t: f32 = elapsed as f32 / 120.0;
    t * t * (3.0 - 2.0 * t)
}

terminal_scene_changed(s: *Screen, r: *TerminalScene): bool {
    if (!r.scene_ready || s.cols != r.scene_cols || s.rows != r.scene_rows) return true;
    y: int = 0;
    while (y < s.rows) {
        x: int = 0;
        while (x < s.cols) {
            pos: int = y * 240 + x;
            if (s.text[pos] != r.scene_text[pos] || s.comb[pos] != r.scene_comb[pos] || s.fg[pos] != r.scene_fg[pos] || s.bg[pos] != r.scene_bg[pos]) return true;
            x = x + 1
        }
        y = y + 1
    }
    false
}

terminal_scene_copy(s: *Screen, r: *TerminalScene) {
    y: int = 0;
    while (y < s.rows) {
        x: int = 0;
        while (x < s.cols) {
            pos: int = y * 240 + x;
            r.scene_text[pos] = s.text[pos];
            r.scene_comb[pos] = s.comb[pos];
            r.scene_fg[pos] = s.fg[pos];
            r.scene_bg[pos] = s.bg[pos];
            x = x + 1
        }
        y = y + 1
    }
    r.scene_cols = s.cols;
    r.scene_rows = s.rows;
    r.scene_ready = true
}

terminal_scene_region(
    left: int,
    top: int,
    right: int,
    bottom: int
): TerminalSceneRegion {
    TerminalSceneRegion {
        left: left,
        top: top,
        right: right,
        bottom: bottom,
        shift: 0,
        from_y: 0.0,
        fixed: false
    }
}

// Chrome often rewrites every numeric field while retaining its styled band.
// Compare that band with its neighbors in BOTH snapshots, rather than requiring
// the displayed line number, percentage, mode, or filename to remain identical.
terminal_scene_row_is_chrome(
    s: *Screen,
    r: *TerminalScene,
    box: TerminalSceneRegion,
    row: int
): bool {
    styles: int = 0;
    above: int = 0;
    below: int = 0;
    styled: int = 0;
    for x in box.left..box.right {
        pos: int = row * 240 + x;
        if (s.fg[pos] == r.scene_fg[pos] && s.bg[pos] == r.scene_bg[pos]) {
            styles = styles + 1;
            if (s.bg[pos] != 0) styled = styled + 1;
            if (row > 0 && (s.bg[pos] != s.bg[pos - 240] || s.fg[pos] != s.fg[pos - 240]) && (r.scene_bg[pos] != r.scene_bg[pos - 240] || r.scene_fg[pos] != r.scene_fg[pos - 240])) above = above + 1;
            if (row + 1 < s.rows && (s.bg[pos] != s.bg[pos + 240] || s.fg[pos] != s.fg[pos + 240]) && (r.scene_bg[pos] != r.scene_bg[pos + 240] || r.scene_fg[pos] != r.scene_fg[pos + 240])) below = below + 1
        }
    }
    width: int = box.right - box.left;
    isolated: bool = above * 4 >= width * 3 && below * 4 >= width * 3;
    if (row == 0 || row + 1 == s.rows) isolated = styled * 4 >= width * 3 && (above * 4 >= width * 3 || below * 4 >= width * 3);
    styles * 4 >= width * 3 && isolated
}

terminal_scene_row_is_border(
    s: *Screen,
    r: *TerminalScene,
    box: TerminalSceneRegion,
    row: int
): bool {
    if (terminal_scene_row_is_chrome(s, r, box, row)) {
        // A cursor-line highlight can also be a stable styled band. If its text
        // demonstrably comes from the scrolling source, keep it in the plane.
        source: int = row - box.shift;
        ink: int = 0;
        moved: int = 0;
        if (source >= box.top && source < box.bottom && source != row) {
            for x in box.left..box.right {
                pos: int = row * 240 + x;
                if (s.text[pos] > 32 || s.comb[pos] != 0) {
                    ink = ink + 1;
                    if (terminal_scene_equal(s, r, pos, source * 240 + x)) moved = moved + 1
                }
            }
        }
        if (ink >= 4 && moved * 4 >= ink * 3) return false;
        return true
    }
    same: int = 0;
    shifted: int = 0;
    same_text: int = 0;
    meaningful: int = 0;
    styled: int = 0;
    counter: bool = false;
    old_y: int = row - box.shift;
    x: int = box.left;
    while (x < box.right) {
        pos: int = row * 240 + x;
        counter = counter || s.text[pos] == 37 || r.scene_text[pos] == 37;
        if (s.text[pos] > 32 || s.comb[pos] != 0 || r.scene_text[pos] > 32 || r.scene_comb[pos] != 0) {
            meaningful = meaningful + 1;
            if (terminal_scene_equal(s, r, pos, pos)) same_text = same_text + 1
        }
        if (s.bg[pos] != 0 && s.bg[pos] == r.scene_bg[pos]) styled = styled + 1;
        if (terminal_scene_equal(s, r, pos, pos) && s.fg[pos] == r.scene_fg[pos] && s.bg[pos] == r.scene_bg[pos]) same = same + 1;
        if (old_y >= box.top && old_y < box.bottom) {
            old_pos: int = old_y * 240 + x;
            if (terminal_scene_equal(s, r, pos, old_pos) && s.fg[pos] == r.scene_fg[old_pos] && s.bg[pos] == r.scene_bg[old_pos]) shifted = shifted + 1
        }
        x = x + 1
    }
    width: int = box.right - box.left;
    preserved: bool = meaningful >= 8 && same_text * 4 >= meaningful * 3 || meaningful == 0 && styled > 0;
    // A short repeated code line at the incoming edge is ambiguous. Blank tails
    // must not make it look like a full-width status bar.
    structure: bool = meaningful * 2 >= width || counter || styled * 4 >= width * 3;
    structure && preserved && same * 4 >= width * 3 && same > shifted + width / 8
}

terminal_scene_column_boundary(
    s: *Screen,
    r: *TerminalScene,
    x: int,
    top: int,
    bottom: int
): bool {
    for y in top..bottom {
        pos: int = y * 240 + x;
        if (s.text[pos] == -1 || r.scene_text[pos] == -1) return false
    }
    true
}

terminal_scene_column_varies(
    s: *Screen,
    r: *TerminalScene,
    box: TerminalSceneRegion,
    x: int
): bool {
    first: int = -1;
    for y in box.top..box.bottom {
        pos: int = y * 240 + x;
        // Cursor-line styling cannot distinguish the motion of a repeated
        // gutter digit. Nor should a status label below the gutter anchor it.
        if (first < 0 || s.text[pos] != s.text[first] || s.comb[pos] != s.comb[first] || r.scene_text[pos] != r.scene_text[first] || r.scene_comb[pos] != r.scene_comb[first]) {
            if (!terminal_scene_row_is_chrome(s, r, box, y)) {
                if (first >= 0) return true;
                first = pos
            }
        }
    }
    false
}

terminal_scene_add_region(r: *TerminalScene, box: TerminalSceneRegion) {
    if (box.left >= box.right || box.top >= box.bottom) return;
    index: int = r.scene_region_count;
    r.scene_regions[index] = box;
    r.scene_region_count = index + 1;
    y: int = box.top;
    while (y < box.bottom) {
        x: int = box.left;
        while (x < box.right) {
            r.scene_region[y * 240 + x] = index;
            x = x + 1
        }
        y = y + 1
    }
}

// Score all displacements once per rectangle. Row/column prefix sums let us
// compare every possible cut without rescanning its cells. Horizontal scores
// exclude matches whose source would cross the proposed cut.
terminal_scene_partition(
    s: *Screen,
    r: *TerminalScene,
    box: TerminalSceneRegion,
    depth: int,
    budget: int,
    trim: bool
) {
    box.fixed = false;
    width: int = box.right - box.left;
    height: int = box.bottom - box.top;
    if (width <= 0 || height <= 0) return;
    left: int = box.right;
    right: int = box.left;
    top: int = box.bottom;
    bottom: int = box.top;
    for y in box.top..box.bottom {
        for x in box.left..box.right {
            pos: int = y * 240 + x;
            if (!terminal_scene_equal(s, r, pos, pos) || s.fg[pos] != r.scene_fg[pos] || s.bg[pos] != r.scene_bg[pos]) {
                if (x < left) left = x;
                if (x + 1 > right) right = x + 1;
                if (y < top) top = y;
                if (y + 1 > bottom) bottom = y + 1
            }
        }
    }
    if (left >= right) {
        terminal_scene_add_bordered_region(s, r, box, budget);
        return
    }
    // A column identical on every content row cannot distinguish scrolling
    // from staying still. Exclude unchanged rows outside the repaint, as well as
    // status bands, when keeping repeated prefixes with neighboring content.
    columns: TerminalSceneRegion = box;
    columns.top = top;
    columns.bottom = bottom;
    while (left > box.left && !terminal_scene_column_varies(s, r, columns, left - 1)) left = left - 1;
    while (right < box.right && !terminal_scene_column_varies(s, r, columns, right)) right = right + 1;
    // Isolate a changed corner before comparing cuts. Otherwise a small moving
    // pane can lose to the stationary majority on BOTH sides of every first cut.
    // Only retain this subdivision if it actually exposes scrolling; ordinary
    // edits still diff the entire row and keep their surrounding text anchors.
    // Reserve three leaves per surrounding band so its status rows stay clipped
    // separately even when the band inherits unfinished vertical motion.
    if (trim && budget >= 13 && (left > box.left || right < box.right || top > box.top || bottom < box.bottom)) {
        // Never place a boundary between the halves of an old or new wide cell.
        while (left > box.left && !terminal_scene_column_boundary(s, r, left, box.top,
            box.bottom)) left = left - 1;
        while (right < box.right && !terminal_scene_column_boundary(s, r, right, box.top,
            box.bottom)) right = right + 1;
        first: int = r.scene_region_count;
        changed_box: TerminalSceneRegion = terminal_scene_region(left, top, right,
            bottom);
        terminal_scene_partition(s, r, changed_box, depth, budget - 12, false);
        moving: bool = false;
        for index in first..r.scene_region_count moving = moving || r.scene_regions[index].shift != 0;
        if (moving) {
            upper: TerminalSceneRegion = terminal_scene_region(box.left, box.top,
                box.right, top);
            lower: TerminalSceneRegion = terminal_scene_region(box.left, bottom, box.right,
                box.bottom);
            before: TerminalSceneRegion = terminal_scene_region(box.left, top, left,
                bottom);
            after: TerminalSceneRegion = terminal_scene_region(right, top, box.right,
                bottom);
            terminal_scene_add_bordered_region(s, r, upper, 3);
            terminal_scene_add_bordered_region(s, r, lower, 3);
            terminal_scene_add_bordered_region(s, r, before, 3);
            terminal_scene_add_bordered_region(s, r, after, 3)
        } else {
            r.scene_region_count = first;
            terminal_scene_add_bordered_region(s, r, box, budget)
        }
        return
    }
    for x in 0..width + 1 {
        r.score_left[x] = 0;
        r.score_right[x] = 0
    }
    for y in 0..height + 1 {
        r.score_top[y] = 0;
        r.score_bottom[y] = 0;
        r.score_top_shift[y] = 0;
        r.score_bottom_shift[y] = 0
    }
    for x in 0..width + 1 r.zero_columns[x] = 0;
    for y in 0..height + 1 r.zero_rows[y] = 0;
    for y in box.top..box.bottom {
        for x in box.left..box.right {
            pos: int = y * 240 + x;
            if ((s.text[pos] > 32 || s.comb[pos] != 0) && terminal_scene_equal(s,
                r, pos, pos)) {
                r.zero_columns[x - box.left + 1] = r.zero_columns[x - box.left + 1] + 1;
                r.zero_rows[y - box.top + 1] = r.zero_rows[y - box.top + 1] + 1
            }
        }
    }
    for x in 1..width + 1 r.zero_columns[x] = r.zero_columns[x] + r.zero_columns[x - 1];
    for y in 1..height + 1 r.zero_rows[y] = r.zero_rows[y] + r.zero_rows[y - 1];
    zero_score: int = r.zero_rows[height];
    best_score: int = zero_score;
    best_shift: int = 0;
    // Visit zero first so ties favor stationary content, then small movements.
    candidate: int = 0;
    while (candidate < height * 2 - 1) {
        shift: int = (candidate + 1) / 2;
        if (candidate % 2 == 1) shift = 0 - shift;
        for x in 0..width + 1 r.score_columns[x] = 0;
        for y in 0..height + 1 r.score_rows[y] = 0;
        y: int = box.top;
        while (y < box.bottom) {
            old_y: int = y - shift;
            if (old_y >= box.top && old_y < box.bottom) {
                x: int = box.left;
                while (x < box.right) {
                    pos: int = y * 240 + x;
                    old_pos: int = old_y * 240 + x;
                    // Compare hypotheses only where the shifted plane has a
                    // surviving source. Incoming rows cannot vote against it.
                    // Repeated prefixes matching BOTH positions are neutral; they
                    // otherwise favor zero just because it overlaps more rows.
                    delta: int = 0;
                    if (s.text[pos] > 32 || s.comb[pos] != 0) {
                        if (s.text[pos] == r.scene_text[old_pos] && s.comb[pos] == r.scene_comb[old_pos]) delta = delta + 1;
                        if (s.text[pos] == r.scene_text[pos] && s.comb[pos] == r.scene_comb[pos]) delta = delta - 1
                    }
                    r.score_columns[x - box.left + 1] = r.score_columns[x - box.left + 1] + delta;
                    r.score_rows[y - box.top + 1] = r.score_rows[y - box.top + 1] + delta;
                    x = x + 1
                }
            }
            y = y + 1
        }
        for x in 1..width + 1 r.score_columns[x] = r.score_columns[x] + r.score_columns[x - 1];
        for row in 1..height + 1 r.score_rows[row] = r.score_rows[row] + r.score_rows[row - 1];
        delta: int = r.score_rows[height];
        score: int = zero_score + delta;
        if (score > best_score) {
            best_score = score;
            best_shift = shift
        }
        for cut in 1..width {
            before: int = r.zero_columns[cut] + r.score_columns[cut];
            after: int = score - before;
            if (before > r.score_left[cut]) r.score_left[cut] = before;
            if (after > r.score_right[cut]) r.score_right[cut] = after
        }
        for cut in 1..height {
            before_end: int = cut;
            after_start: int = cut;
            if (shift < 0) before_end = terminal_clamp(cut + shift, 0, height) else after_start = terminal_clamp(cut + shift,
                0, height);
            before: int = r.zero_rows[cut] + r.score_rows[before_end];
            after: int = zero_score - r.zero_rows[cut] + delta - r.score_rows[after_start];
            if (before > r.score_top[cut]) {
                r.score_top[cut] = before;
                r.score_top_shift[cut] = shift
            }
            if (after > r.score_bottom[cut]) {
                r.score_bottom[cut] = after;
                r.score_bottom_shift[cut] = shift
            }
        }
        candidate = candidate + 1
    }
    // A cut must recover substantial extra evidence. This keeps coincidentally
    // unchanged lines inside a scroll in one rigid plane instead of shredding it.
    gain: int = 8;
    split_x: int = 0;
    split_y: int = 0;
    if (depth < 8 && budget >= 2) {
        for cut in 1..width {
            extra: int = r.score_left[cut] + r.score_right[cut] - best_score;
            if (extra > gain) {
                safe: bool = terminal_scene_column_boundary(s, r, box.left + cut,
                    box.top, box.bottom);
                if (safe) {
                    gain = extra;
                    split_x = cut
                }
            }
        }
        for cut in 1..height {
            extra: int = r.score_top[cut] + r.score_bottom[cut] - best_score;
            if (extra > gain) {
                safe: bool = true;
                moving: TerminalSceneRegion = box;
                moving.shift = best_shift;
                // Entering rows have no surviving source. Repeated words there
                // are not evidence for stopping a plane short of the pane edge.
                if (best_shift < 0 && cut >= height + best_shift && r.score_bottom_shift[cut] == 0) {
                    for y in box.top + cut..box.bottom safe = safe && terminal_scene_row_is_border(s,
                        r, moving, y)
                }
                if (best_shift > 0 && cut <= best_shift && r.score_top_shift[cut] == 0) {
                    for y in box.top..box.top + cut safe = safe && terminal_scene_row_is_border(s,
                        r, moving, y)
                }
                if (safe) {
                    gain = extra;
                    split_x = 0;
                    split_y = cut
                }
            }
        }
    }
    // Several small moving panes can each be outvoted even after cropping the
    // outer unchanged edges. In that case explore an unchanged separating line.
    // Keep the cut only if the children actually find motion.
    explore: bool = false;
    if (best_shift == 0 && split_x == 0 && split_y == 0 && depth < 8 && budget >= 2) {
        distance: int = width;
        for cut in left - box.left + 1..right - box.left {
            stable: bool = terminal_scene_column_boundary(s, r, box.left + cut, box.top,
                box.bottom);
            for y in box.top..box.bottom {
                pos: int = y * 240 + box.left + cut;
                stable = stable && terminal_scene_equal(s, r, pos, pos) && s.fg[pos] == r.scene_fg[pos] && s.bg[pos] == r.scene_bg[pos]
            }
            center: int = cut * 2 - width;
            if (center < 0) center = 0 - center;
            if (stable && center < distance) {
                distance = center;
                split_x = cut
            }
        }
        if (split_x == 0) {
            distance = height;
            for cut in top - box.top + 1..bottom - box.top {
                stable: bool = true;
                for x in box.left..box.right {
                    pos: int = (box.top + cut) * 240 + x;
                    stable = stable && terminal_scene_equal(s, r, pos, pos) && s.fg[pos] == r.scene_fg[pos] && s.bg[pos] == r.scene_bg[pos]
                }
                center: int = cut * 2 - height;
                if (center < 0) center = 0 - center;
                if (stable && center < distance) {
                    distance = center;
                    split_y = cut
                }
            }
        }
        explore = split_x > 0 || split_y > 0
    }
    first: int = r.scene_region_count;
    if (split_x > 0) {
        left: TerminalSceneRegion = terminal_scene_region(box.left, box.top, box.left + split_x,
            box.bottom);
        terminal_scene_partition(s, r, left, depth + 1, budget / 2, trim || explore);
        right: TerminalSceneRegion = terminal_scene_region(box.left + split_x, box.top,
            box.right, box.bottom);
        terminal_scene_partition(s, r, right, depth + 1, budget - budget / 2, trim || explore)
    }
    if (split_y > 0) {
        upper: TerminalSceneRegion = terminal_scene_region(box.left, box.top, box.right,
            box.top + split_y);
        terminal_scene_partition(s, r, upper, depth + 1, budget / 2, trim || explore);
        lower: TerminalSceneRegion = terminal_scene_region(box.left, box.top + split_y,
            box.right, box.bottom);
        terminal_scene_partition(s, r, lower, depth + 1, budget - budget / 2, trim || explore)
    }
    if (split_x > 0 || split_y > 0) {
        if (explore) {
            moving: bool = false;
            for index in first..r.scene_region_count moving = moving || r.scene_regions[index].shift != 0;
            if (!moving) {
                r.scene_region_count = first;
                terminal_scene_add_bordered_region(s, r, box, budget)
            }
        }
        return
    }
    if (best_score >= 8 && best_score >= zero_score + 4) box.shift = best_shift;
    terminal_scene_add_bordered_region(s, r, box, budget)
}

terminal_scene_add_bordered_region(
    s: *Screen,
    r: *TerminalScene,
    box: TerminalSceneRegion,
    budget: int
) {
    if (box.left >= box.right || box.top >= box.bottom) return;
    if (budget >= 3) {
        // Status rows need their own clip even when the neighboring text only
        // repaints while finishing an earlier scroll.
        top: int = box.top;
        bottom: int = box.bottom;
        while (top < bottom && terminal_scene_row_is_border(s, r, box, top)) top = top + 1;
        while (bottom > top && terminal_scene_row_is_border(s, r, box, bottom - 1)) bottom = bottom - 1;
        upper_border: TerminalSceneRegion = terminal_scene_region(box.left, box.top,
            box.right, top);
        upper_border.fixed = true;
        terminal_scene_add_region(r, upper_border);
        lower_border: TerminalSceneRegion = terminal_scene_region(box.left, bottom,
            box.right, box.bottom);
        lower_border.fixed = true;
        terminal_scene_add_region(r, lower_border);
        box.top = top;
        box.bottom = bottom
    }
    terminal_scene_add_region(r, box)
}

terminal_ghost_copy(r: *TerminalScene, to: int, from: int) {
    r.ghost_text[to] = r.ghost_text[from];
    r.ghost_comb[to] = r.ghost_comb[from];
    r.ghost_fg[to] = r.ghost_fg[from];
    r.ghost_from_x[to] = r.ghost_from_x[from];
    r.ghost_from_y[to] = r.ghost_from_y[from];
    r.ghost_to_x[to] = r.ghost_to_x[from];
    r.ghost_to_y[to] = r.ghost_to_y[from];
    r.ghost_from_alpha[to] = r.ghost_from_alpha[from];
    r.ghost_fade[to] = r.ghost_fade[from];
    r.ghost_clip[to] = r.ghost_clip[from]
}

terminal_ghost_visible(r: *TerminalScene, g: int): bool {
    clip: TerminalSceneRegion = r.ghost_clip[g];
    x: f32 = r.ghost_from_x[g];
    y: f32 = r.ghost_from_y[g];
    clip.left < clip.right && clip.top < clip.bottom && x < clip.right as f32 && x + 2.0 > clip.left as f32 && y < clip.bottom as f32 && y + 1.0 > clip.top as f32
}

terminal_scene_prepare(s: *Screen, r: *TerminalScene, now: int) {
    hinted_shift: int = s.scroll_hint_delta;
    hinted_top: int = s.scroll_hint_top;
    hinted_bottom: int = s.scroll_hint_bottom;
    hinted_span: int = hinted_bottom - hinted_top + 1;
    if (hinted_shift != 0) hinted_shift = terminal_clamp(hinted_shift, 0 - hinted_span,
        hinted_span);
    s.scroll_hint_delta = 0;
    if (!terminal_scene_changed(s, r)) {
        if (r.scene_active && terminal_scene_ease(r, now) >= 1.0) {
            r.scene_active = false;
            r.scene_has_shift = false;
            r.ghost_count = 0
        }
        return
    }
    if (!r.scene_ready || s.cols != r.scene_cols || s.rows != r.scene_rows) {
        r.scene_region_count = 0;
        viewport: TerminalSceneRegion = terminal_scene_region(0, 0, s.cols, s.rows);
        terminal_scene_add_region(r, viewport);
        y: int = 0;
        while (y < s.rows) {
            x: int = 0;
            while (x < s.cols) {
                pos: int = y * 240 + x;
                r.scene_from_x[pos] = x as f32;
                r.scene_from_y[pos] = y as f32;
                r.scene_from_alpha[pos] = 1.0;
                x = x + 1
            }
            y = y + 1
        }
        terminal_scene_copy(s, r);
        r.scene_active = false;
        r.scene_has_shift = false;
        r.ghost_count = 0;
        return
    }
    old_ease: f32 = terminal_scene_ease(r, now);
    // Sample departing text before rebuilding the scene. Selecting the first
    // few rows loses the older glyphs that are actually still on screen during
    // key repeat. Keep a separate snapshot, then cull it after pane rebasing.
    carry_count: int = r.ghost_count;
    carry_start: int = TERMINAL_GHOST_CAPACITY;
    carry: int = 0;
    while (carry < carry_count) {
        saved: int = carry_start + carry;
        terminal_ghost_copy(r, saved, carry);
        r.ghost_from_x[saved] = r.ghost_from_x[carry] + (r.ghost_to_x[carry] - r.ghost_from_x[carry]) * old_ease;
        r.ghost_from_y[saved] = r.ghost_from_y[carry] + (r.ghost_to_y[carry] - r.ghost_from_y[carry]) * old_ease;
        if (r.ghost_fade[carry] == 1) r.ghost_from_alpha[saved] = r.ghost_from_alpha[carry] * (1.0 - old_ease) else r.ghost_from_alpha[saved] = 1.0;
        carry = carry + 1
    }
    old_y: int = 0;
    while (old_y < r.scene_rows) {
        old_x: int = 0;
        while (old_x < r.scene_cols) {
            pos: int = old_y * 240 + old_x;
            r.scene_visual_x[pos] = r.scene_from_x[pos] + (old_x as f32 - r.scene_from_x[pos]) * old_ease;
            r.scene_visual_y[pos] = r.scene_from_y[pos] + (old_y as f32 - r.scene_from_y[pos]) * old_ease;
            r.scene_visual_alpha[pos] = r.scene_from_alpha[pos] + (1.0 - r.scene_from_alpha[pos]) * old_ease;
            old_x = old_x + 1
        }
        old_y = old_y + 1
    }
    previous_count: int = r.scene_region_count;
    for index in 0..previous_count r.scene_previous[index] = r.scene_regions[index];
    r.scene_region_count = 0;
    r.scene_has_shift = false;
    if (old_ease < 1.0 && previous_count > 1 && hinted_shift == 0) {
        // An unrelated repaint must retain the bounds of motion still on screen.
        for index in 0..previous_count {
            box: TerminalSceneRegion = r.scene_previous[index];
            box.shift = 0;
            budget: int = (256 - r.scene_region_count) / (previous_count - index);
            terminal_scene_partition(s, r, box, 0, budget, false)
        }
    } else {
        viewport: TerminalSceneRegion = terminal_scene_region(0, 0, s.cols, s.rows);
        terminal_scene_partition(s, r, viewport, 0, 256, true)
    }
    inferred: bool = false;
    for index in 0..r.scene_region_count inferred = inferred || r.scene_regions[index].shift != 0;
    if (!inferred && hinted_shift != 0) {
        // VT line operations may be intermediate steps of a larger repaint, so
        // their last reported margins must not cut a confidently inferred plane.
        // They remain useful when too little text survives to infer movement.
        r.scene_region_count = 0;
        above: TerminalSceneRegion = terminal_scene_region(0, 0, s.cols, hinted_top);
        inside: TerminalSceneRegion = terminal_scene_region(0, hinted_top, s.cols,
            hinted_bottom + 1);
        below: TerminalSceneRegion = terminal_scene_region(0, hinted_bottom + 1, s.cols,
            s.rows);
        terminal_scene_add_region(r, above);
        terminal_scene_partition(s, r, inside, 0, 254, false);
        terminal_scene_add_region(r, below)
    }
    for index in 0..r.scene_region_count {
        box: TerminalSceneRegion = r.scene_regions[index];
        // Protocol hints also describe scrolls with too little surviving text to
        // infer a displacement (for example scrolling a mostly empty shell).
        if (!inferred && hinted_shift != 0 && box.top >= hinted_top && box.bottom <= hinted_bottom + 1 && box.shift == 0) {
            changed: int = 0;
            same: int = 0;
            shifted: int = 0;
            for y in box.top..box.bottom {
                for x in box.left..box.right {
                    pos: int = y * 240 + x;
                    if (!terminal_scene_equal(s, r, pos, pos)) changed = changed + 1;
                    if (s.text[pos] > 32 || s.comb[pos] != 0) {
                        if (terminal_scene_equal(s, r, pos, pos)) same = same + 1;
                        source: int = y - hinted_shift;
                        if (source >= box.top && source < box.bottom && terminal_scene_equal(s,
                            r, pos, source * 240 + x)) shifted = shifted + 1
                    }
                }
            }
            if (changed > 0 && shifted + box.right - box.left >= same) box.shift = hinted_shift
        }
        box.from_y = (0 - box.shift) as f32;
        if (!box.fixed) {
            // A repaint without another scroll still belongs to the plane that
            // is already moving. Give replacement cells that same displacement.
            // Inferred edges can move as gutter digits and blank tails change.
            // One corner may have belonged to a stationary strip in the previous
            // frame, so inherit the displacement of the largest overlapping
            // previous region instead of sampling that single cell.
            overlap: int = 0;
            for previous in 0..previous_count {
                old: TerminalSceneRegion = r.scene_previous[previous];
                left: int = terminal_clamp(old.left, box.left, box.right);
                right: int = terminal_clamp(old.right, box.left, box.right);
                top: int = terminal_clamp(old.top, box.top, box.bottom);
                bottom: int = terminal_clamp(old.bottom, box.top, box.bottom);
                area: int = (right - left) * (bottom - top);
                if (area > overlap) {
                    overlap = area;
                    box.from_y = old.from_y * (1.0 - old_ease) - box.shift as f32
                }
            }
            // Repeated half-pages arrive faster than a 120 ms animation finishes.
            // Bound their accumulated lag to this pane's height. Advance the
            // whole old plane by the excess, including its departing glyphs, so
            // the newest text meets the old text without a hole at their seam.
            limit: f32 = (box.bottom - box.top) as f32;
            if (box.from_y > limit) box.from_y = limit;
            if (box.from_y < 0.0 - limit) box.from_y = 0.0 - limit;
            if (box.shift != 0 || box.from_y != 0.0) {
                for y in box.top..box.bottom {
                    for x in box.left..box.right {
                        pos: int = y * 240 + x;
                        // All retained rows use the same plane, including a
                        // newly absorbed gutter or formerly stationary edge.
                        r.scene_visual_x[pos] = x as f32;
                        r.scene_visual_y[pos] = (y + box.shift) as f32 + box.from_y;
                        r.scene_visual_alpha[pos] = 1.0
                    }
                }
            }
        }
        r.scene_has_shift = r.scene_has_shift || box.shift != 0 || box.from_y != 0.0;
        r.scene_regions[index] = box
    }
    // Retain the visible part of the old snapshot, with the same catch-up as
    // its current plane. Intersect clips so small inferred boundary changes do
    // not discard visible text, while neighboring panes remain isolated.
    carry = 0;
    retained: int = 0;
    while (carry < carry_count) {
        saved: int = carry_start + carry;
        clip: TerminalSceneRegion = r.ghost_clip[saved];
        x: int = terminal_clamp(r.ghost_to_x[saved] as int, clip.left, clip.right - 1);
        y: int = terminal_clamp(r.ghost_to_y[saved] as int, clip.top, clip.bottom - 1);
        box: TerminalSceneRegion = r.scene_regions[r.scene_region[y * 240 + x]];
        r.ghost_to_y[saved] = r.ghost_to_y[saved] + box.shift as f32;
        moving: bool = box.shift != 0 || box.from_y != 0.0;
        if (r.ghost_fade[saved] == 0 || moving) {
            r.ghost_from_x[saved] = r.ghost_to_x[saved];
            r.ghost_from_y[saved] = r.ghost_to_y[saved] + box.from_y
        }
        if (clip.left < box.left) clip.left = box.left;
        if (clip.right > box.right) clip.right = box.right;
        if (clip.top < box.top) clip.top = box.top;
        if (clip.bottom > box.bottom) clip.bottom = box.bottom;
        r.ghost_clip[saved] = clip;
        // A scroll reversal can bring a departing cell's destination back
        // inside the current grid. That cell is now owned by the live plane.
        replaced: bool = (r.ghost_fade[saved] == 0 || moving) && r.ghost_to_y[saved] >= box.top as f32 && r.ghost_to_y[saved] < box.bottom as f32;
        if (!box.fixed && !replaced && r.ghost_from_alpha[saved] > 0.01 && terminal_ghost_visible(r,
            saved)) {
            terminal_ghost_copy(r, carry_start + retained, saved);
            retained = retained + 1
        }
        carry = carry + 1
    }
    carry_count = retained;
    for pos in 0..28800 {
        r.scene_used[pos] = 0;
        r.scene_match[pos] = -1;
        r.scene_fixed[pos] = 0
    }
    for index in 0..r.scene_region_count {
        box: TerminalSceneRegion = r.scene_regions[index];
        y: int = box.top;
        while (y < box.bottom) {
            old_y: int = y - box.shift;
            if (old_y >= box.top && old_y < box.bottom) {
                if (box.fixed || box.shift == 0 && terminal_scene_row_is_chrome(s,
                    r, box, y)) {
                    // Counters and mode labels update in place. Matching digits
                    // with LCS would slide them across the status line or fade.
                    for x in box.left..box.right {
                        pos: int = y * 240 + x;
                        r.scene_fixed[pos] = 1;
                        r.scene_match[pos] = pos;
                        r.scene_used[pos] = 1
                    }
                } else {
                    if (box.shift != 0 || box.from_y != 0.0) {
                        // A surviving source cell is replaced even when its text
                        // changes. Keeping that old glyph as an opaque ghost would
                        // stack it underneath the new one on every key repeat.
                        for x in box.left..box.right {
                            pos: int = y * 240 + x;
                            old_pos: int = old_y * 240 + x;
                            r.scene_used[old_pos] = 1;
                            if (terminal_scene_equal(s, r, pos, old_pos)) r.scene_match[pos] = old_pos
                        }
                    } else {
                        old_end: int = box.right - 1;
                        old_blank: bool = true;
                        while (old_end >= box.left && old_blank) {
                            op: int = old_y * 240 + old_end;
                            if (r.scene_text[op] != 32 || r.scene_comb[op] != 0 || r.scene_bg[op] != 0) old_blank = false else old_end = old_end - 1
                        }
                        new_end: int = box.right - 1;
                        new_blank: bool = true;
                        while (new_end >= box.left && new_blank) {
                            np: int = y * 240 + new_end;
                            if (s.text[np] != 32 || s.comb[np] != 0 || s.bg[np] != 0) new_blank = false else new_end = new_end - 1
                        }
                        prefix: int = box.left;
                        while (prefix <= old_end && prefix <= new_end && terminal_scene_equal(s,
                            r, y * 240 + prefix, old_y * 240 + prefix)) {
                            r.scene_match[y * 240 + prefix] = old_y * 240 + prefix;
                            r.scene_used[old_y * 240 + prefix] = 1;
                            prefix = prefix + 1
                        }
                        old_x: int = old_end;
                        new_x: int = new_end;
                        while (old_x >= prefix && new_x >= prefix && terminal_scene_equal(s,
                            r, y * 240 + new_x, old_y * 240 + old_x)) {
                            r.scene_match[y * 240 + new_x] = old_y * 240 + old_x;
                            r.scene_used[old_y * 240 + old_x] = 1;
                            old_x = old_x - 1;
                            new_x = new_x - 1
                        }
                        old_count: int = old_x - prefix + 1;
                        new_count: int = new_x - prefix + 1;
                        stride: int = old_count + 1;
                        di: int = 0;
                        while (di <= new_count) {
                            r.scene_diff[di * stride] = 0;
                            di = di + 1
                        }
                        dj: int = 0;
                        while (dj <= old_count) {
                            r.scene_diff[dj] = 0;
                            dj = dj + 1
                        }
                        di = 1;
                        while (di <= new_count) {
                            dj = 1;
                            while (dj <= old_count) {
                                cell: int = di * stride + dj;
                                if (terminal_scene_equal(s, r, y * 240 + prefix + di - 1,
                                    old_y * 240 + prefix + dj - 1)) r.scene_diff[cell] = r.scene_diff[cell - stride - 1] + 1 else {
                                    above: int = r.scene_diff[cell - stride];
                                    before: int = r.scene_diff[cell - 1];
                                    if (above > before) r.scene_diff[cell] = above else r.scene_diff[cell] = before
                                }
                                dj = dj + 1
                            }
                            di = di + 1
                        }
                        di = new_count;
                        dj = old_count;
                        while (di > 0 && dj > 0) {
                            new_middle: int = y * 240 + prefix + di - 1;
                            old_middle: int = old_y * 240 + prefix + dj - 1;
                            cell: int = di * stride + dj;
                            if (terminal_scene_equal(s, r, new_middle, old_middle) && r.scene_diff[cell] == r.scene_diff[cell - stride - 1] + 1) {
                                r.scene_match[new_middle] = old_middle;
                                r.scene_used[old_middle] = 1;
                                di = di - 1;
                                dj = dj - 1
                            } else {
                                if (r.scene_diff[cell - stride] >= r.scene_diff[cell - 1]) di = di - 1 else dj = dj - 1
                            }
                        }
                    }
                }
            }
            y = y + 1
        }
    }
    y: int = 0;
    while (y < s.rows) {
        x: int = 0;
        while (x < s.cols) {
            pos: int = y * 240 + x;
            box: TerminalSceneRegion = r.scene_regions[r.scene_region[pos]];
            matched_pos: int = r.scene_match[pos];
            if (r.scene_fixed[pos] == 1) {
                r.scene_from_x[pos] = x as f32;
                r.scene_from_y[pos] = y as f32;
                r.scene_from_alpha[pos] = 1.0
            } else {
                if (box.shift != 0 || box.from_y != 0.0) {
                    r.scene_from_x[pos] = x as f32;
                    r.scene_from_y[pos] = y as f32 + box.from_y;
                    r.scene_from_alpha[pos] = 1.0
                } else {
                    if (matched_pos >= 0) {
                        r.scene_from_x[pos] = r.scene_visual_x[matched_pos];
                        r.scene_from_y[pos] = r.scene_visual_y[matched_pos];
                        r.scene_from_alpha[pos] = r.scene_visual_alpha[matched_pos]
                    } else {
                        r.scene_from_x[pos] = x as f32;
                        r.scene_from_y[pos] = y as f32;
                        r.scene_from_alpha[pos] = 0.0;
                        left: int = x - 1;
                        while (left >= box.left && r.scene_match[y * 240 + left] < 0) left = left - 1;
                        right: int = x + 1;
                        while (right < box.right && r.scene_match[y * 240 + right] < 0) right = right + 1;
                        if (left >= box.left && right < box.right) {
                            left_x: f32 = r.scene_visual_x[r.scene_match[y * 240 + left]];
                            right_x: f32 = r.scene_visual_x[r.scene_match[y * 240 + right]];
                            ratio: f32 = (x - left) as f32 / (right - left) as f32;
                            r.scene_from_x[pos] = left_x + (right_x - left_x) * ratio
                        } else {
                            if (left >= box.left) r.scene_from_x[pos] = r.scene_visual_x[r.scene_match[y * 240 + left]] + (x - left) as f32 * 0.2;
                            if (right < box.right) r.scene_from_x[pos] = r.scene_visual_x[r.scene_match[y * 240 + right]] - (right - x) as f32 * 0.2
                        }
                    }
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    r.ghost_count = 0;
    y = 0;
    while (y < r.scene_rows) {
        x: int = 0;
        while (x < r.scene_cols) {
            pos: int = y * 240 + x;
            meaningful: bool = r.scene_text[pos] > 32 || r.scene_comb[pos] != 0;
            if (meaningful && r.scene_used[pos] == 0 && r.ghost_count < carry_start) {
                box: TerminalSceneRegion = r.scene_regions[r.scene_region[pos]];
                g: int = r.ghost_count;
                r.ghost_clip[g] = box;
                target_x: f32 = x as f32;
                r.ghost_text[g] = r.scene_text[pos];
                r.ghost_comb[g] = r.scene_comb[pos];
                r.ghost_fg[g] = r.scene_fg[pos];
                r.ghost_from_x[g] = r.scene_visual_x[pos];
                r.ghost_from_y[g] = r.scene_visual_y[pos];
                r.ghost_to_x[g] = target_x;
                r.ghost_to_y[g] = (y + box.shift) as f32;
                r.ghost_from_alpha[g] = r.scene_visual_alpha[pos];
                if (box.shift != 0) {
                    r.ghost_from_alpha[g] = 1.0;
                    r.ghost_fade[g] = 0
                } else r.ghost_fade[g] = 1;
                if (box.shift == 0 || terminal_ghost_visible(r, g)) r.ghost_count = g + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    carry = 0;
    while (carry < carry_count && r.ghost_count < TERMINAL_GHOST_CAPACITY) {
        saved: int = carry_start + carry;
        if (r.ghost_from_alpha[saved] > 0.01) {
            terminal_ghost_copy(r, r.ghost_count, saved);
            r.ghost_count = r.ghost_count + 1
        }
        carry = carry + 1
    }
    terminal_scene_copy(s, r);
    r.scene_started = now;
    r.scene_active = true
}
