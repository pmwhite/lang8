test "an unchanged line-number digit scrolls despite cursor-line styling" {
    s: *Screen = terminal_screen(40, 18);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    for y in 0..16 {
        s.text[y * 240] = 49;
        s.text[y * 240 + 1] = 48 + y / 10;
        s.text[y * 240 + 2] = 48 + y % 10;
        s.fg[y * 240] = 8
    }
    s.fg[7 * 240] = 3;
    for x in 0..40 s.bg[16 * 240 + x] = 4;
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 40, 16, -8);
    for y in 0..16 {
        s.text[y * 240] = 49;
        s.text[y * 240 + 1] = 48 + (y + 8) / 10;
        s.text[y * 240 + 2] = 48 + (y + 8) % 10;
        s.fg[y * 240] = 8
    }
    s.fg[7 * 240] = 3;
    s.text[16 * 240 + 20] = 88;
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "text with line numbers", 0, 0, 40, 16);
    scene_test_show_bool("gutter shares the text region", r.scene_region[0] == r.scene_region[3]);
    // Status and command rows do not anchor the gutter.
    scene_test_show_shift(r, "status and command rows", 0, 16, 40, 18);
    expect {|
        text with line numbers: shift -8
        gutter shares the text region: true
        status and command rows: fixed
    |}
}

test "a stable cursor-line highlight does not pin scrolling text" {
    s: *Screen = terminal_screen(40, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    for x in 0..40 s.bg[x] = 4;
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 40, 16, -5);
    for x in 0..40 s.bg[x] = 4;
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "screen", 0, 0, 40, 16);
    expect {|
        screen: shift -5
    |}
}

test "repeated prefixes scroll as one rigid plane" {
    s: *Screen = terminal_screen(40, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    for y in 0..16 {
        for x in 0..12 s.text[y * 240 + x] = 65 + x
    }
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 40, 16, -8);
    for y in 8..16 {
        for x in 0..12 s.text[y * 240 + x] = 65 + x
    }
    terminal_scene_prepare(s, r, 200);
    // The prefixes do not shear into a stationary strip.
    scene_test_show_shift(r, "screen", 0, 0, 40, 16);
    scene_test_show_int("regions", r.scene_region_count);
    expect {|
        screen: shift -8
        regions: 1
    |}
}

test "a status line with changing counters updates in place under scrolling code" {
    s: *Screen = terminal_screen(80, 24);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    scene_test_put_row(s, 21, "            if (extra > gain) {");
    scene_test_put_row(s, 22, "file.l8                   100,1     10%");
    for x in 0..80 {
        s.bg[22 * 240 + x] = 7;
        s.fg[22 * 240 + x] = 0
    }
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 80, 22, -11);
    scene_test_put_row(s, 21, "            if (extra > gain) {");
    scene_test_put_row(s, 22, "file.l8                   111,1     11%");
    terminal_scene_prepare(s, r, 200);
    // The repeated last code row is new incoming text, not another status bar.
    scene_test_show_region(r, "identical incoming code row 21", 21 * 240);
    scene_test_show_pinned(s, r, "status row 22", 22);
    expect {|
        identical incoming code row 21: columns 0..80 rows 0..22 shift -11
        status row 22: pinned
    |}
}

test "numeric status changes stay fixed without moving the content boundary" {
    s: *Screen = terminal_screen(40, 12);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    scene_test_put_row(s, 10, "123,4  10%");
    for x in 0..40 s.bg[10 * 240 + x] = 4;
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 40, 10, -4);
    // Most meaningful characters of the status change.
    scene_test_put_row(s, 10, "987,6  89%");
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "content", 0, 0, 40, 10);
    scene_test_show_shift(r, "status rows", 0, 10, 40, 12);
    expect {|
        content: shift -4
        status rows: fixed
    |}
    // A counter-only repaint during the scroll stays pinned.
    scene_test_put_row(s, 10, "999,9  99%");
    terminal_scene_prepare(s, r, 220);
    scene_test_show_pinned(s, r, "status row 10", 10);
    expect {|
        status row 10: pinned
    |}
}

test "a full-screen half-page scroll is one rigid plane that retires its ghosts" {
    s: *Screen = terminal_screen(40, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 40, 16, -8);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "screen", 0, 0, 40, 16);
    scene_test_show_int("regions", r.scene_region_count);
    expect {|
        screen: shift -8
        regions: 1
    |}
    terminal_scene_prepare(s, r, 321);
    scene_test_show_bool("animating", r.scene_active);
    scene_test_show_int("ghosts", r.ghost_count);
    expect {|
        animating: false
        ghosts: 0
    |}
}

test "a left pane scrolls under a larger stationary pane" {
    s: *Screen = terminal_screen(60, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 20, 15, -7);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "left pane", 0, 0, 20, 15);
    scene_test_show_shift(r, "right pane", 20, 0, 60, 16);
    scene_test_show_shift(r, "left pane status", 0, 15, 20, 16);
    inside: int = 0;
    for g in 0..r.ghost_count {
        clip: TerminalSceneRegion = r.ghost_clip[g];
        if (clip.right <= 20 && clip.bottom <= 15) inside = inside + 1
    }
    scene_test_show_int("departing ghosts", r.ghost_count);
    scene_test_show_int("departing ghosts clipped to the left pane", inside);
    expect {|
        left pane: shift -7
        right pane: fixed
        left pane status: fixed
        departing ghosts: 140
        departing ghosts clipped to the left pane: 140
    |}
}

test "an interrupted pane scroll continues from its displayed position" {
    s: *Screen = terminal_screen(60, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 20, 15, -7);
    terminal_scene_prepare(s, r, 200);
    scene_test_scroll(s, r, 0, 0, 20, 15, -7);
    terminal_scene_prepare(s, r, 260);
    scene_test_show_shift(r, "left pane", 0, 0, 20, 15);
    scene_test_show_shift(r, "right pane", 20, 0, 60, 16);
    write(1, "cell (0,0) starts from row ");
    print_fixed(r.scene_from_y[0] as f64, 4);
    expect {|
        left pane: shift -7
        right pane: fixed
        cell (0,0) starts from row 10.5000
    |}
    // An unrelated edit arrives while the left pane is still moving.
    s.text[5 * 240 + 30] = 90;
    terminal_scene_prepare(s, r, 290);
    scene_test_show_region(r, "cell (0,0)", 0);
    write(1, "cell (0,0) starts from row ");
    print_fixed(r.scene_from_y[0] as f64, 4);
    expect {|
        cell (0,0): columns 0..20 rows 0..15 shift 0
        cell (0,0) starts from row 8.8594
    |}
    // Nor does a neighbor's scroll cancel the motion.
    scene_test_scroll(s, r, 20, 0, 60, 16, 3);
    terminal_scene_prepare(s, r, 320);
    write(1, "cell (0,0) starts from row ");
    print_fixed(r.scene_from_y[0] as f64, 4);
    expect {|
        cell (0,0) starts from row 7.4751
    |}
}

test "a right pane scrolls down beside a stationary pane" {
    s: *Screen = terminal_screen(60, 20);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 40, 0, 60, 20, 6);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "left pane", 0, 0, 40, 20);
    scene_test_show_shift(r, "right pane", 40, 0, 60, 20);
    expect {|
        left pane: fixed
        right pane: shift 6
    |}
}

test "a lower stacked pane scrolls between fixed rows" {
    s: *Screen = terminal_screen(40, 24);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 13, 40, 23, -4);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "upper pane and separator", 0, 0, 40, 13);
    scene_test_show_shift(r, "lower pane", 0, 13, 40, 23);
    scene_test_show_shift(r, "bottom status", 0, 23, 40, 24);
    expect {|
        upper pane and separator: fixed
        lower pane: shift -4
        bottom status: fixed
    |}
}

test "nested panes scroll independently" {
    s: *Screen = terminal_screen(60, 24);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 30, 11, -4);
    scene_test_scroll(s, r, 0, 12, 30, 24, 5);
    scene_test_scroll(s, r, 31, 0, 60, 24, -8);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "top-left pane", 0, 0, 30, 11);
    scene_test_show_shift(r, "bottom-left pane", 0, 12, 30, 24);
    scene_test_show_shift(r, "full-height right pane", 31, 0, 60, 24);
    scene_test_show_shift(r, "horizontal divider", 0, 11, 30, 12);
    scene_test_show_shift(r, "vertical divider", 30, 0, 31, 24);
    expect {|
        top-left pane: shift -4
        bottom-left pane: shift 5
        full-height right pane: shift -8
        horizontal divider: fixed
        vertical divider: fixed
    |}
}

test "blank lines stay in the rigid scroll plane" {
    s: *Screen = terminal_screen(40, 20);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    // Same blank line before and after a two-row scroll is not pane chrome.
    for x in 0..40 {
        s.text[8 * 240 + x] = 32;
        s.text[10 * 240 + x] = 32;
        s.text[19 * 240 + x] = 32;
        s.bg[19 * 240 + x] = 4
    }
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 40, 19, -2);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "text with blank lines", 0, 0, 40, 19);
    scene_test_show_shift(r, "blank styled status row", 0, 19, 40, 20);
    expect {|
        text with blank lines: shift -2
        blank styled status row: fixed
    |}
}

test "pane inference refines a full-width protocol scroll hint" {
    s: *Screen = terminal_screen(40, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 2, 20, 14, -5);
    // A program can use a full-width VT scroll then repaint the other pane.
    s.scroll_hint_top = 2;
    s.scroll_hint_bottom = 13;
    s.scroll_hint_delta = -5;
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "scrolled pane", 0, 2, 20, 14);
    scene_test_show_shift(r, "repainted neighbor", 20, 0, 40, 16);
    scene_test_show_int("hint delta after use", s.scroll_hint_delta);
    expect {|
        scrolled pane: shift -5
        repainted neighbor: fixed
        hint delta after use: 0
    |}
}

test "a sparse protocol scroll still animates" {
    s: *Screen = terminal_screen(20, 10);
    r: *TerminalScene = terminal_scene();
    s.text[8 * 240] = 65;
    terminal_scene_prepare(s, r, 0);
    terminal_scroll(s, 0, 9, false);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_region(r, "row 7", 7 * 240);
    expect {|
        row 7: columns 0..20 rows 0..10 shift -1
    |}
}

test "an ordinary insertion keeps horizontal matching" {
    s: *Screen = terminal_screen(20, 6);
    r: *TerminalScene = terminal_scene();
    for x in 0..8 s.text[x] = 65 + x;
    terminal_scene_prepare(s, r, 0);
    for x in 3..9 s.text[x] = 64 + x;
    s.text[2] = 90;
    terminal_scene_prepare(s, r, 200);
    scene_test_show_bool("vertical shift", r.scene_has_shift);
    scene_test_show_int("cell 3 matches old cell", r.scene_match[3]);
    scene_test_show_int("cell 8 matches old cell", r.scene_match[8]);
    expect {|
        vertical shift: false
        cell 3 matches old cell: 2
        cell 8 matches old cell: 7
    |}
}

test "a resize resets old geometry and ghosts" {
    s: *Screen = terminal_screen(20, 6);
    r: *TerminalScene = terminal_scene();
    for x in 0..8 s.text[x] = 65 + x;
    terminal_scene_prepare(s, r, 0);
    for x in 3..9 s.text[x] = 64 + x;
    s.text[2] = 90;
    terminal_scene_prepare(s, r, 200);
    terminal_resize(s, 10, 3);
    terminal_scene_prepare(s, r, 230);
    scene_test_show_bool("animating", r.scene_active);
    scene_test_show_int("ghosts", r.ghost_count);
    scene_test_show_int("regions", r.scene_region_count);
    expect {|
        animating: false
        ghosts: 0
        regions: 1
    |}
}

test "wide and combining glyphs scroll with their pane" {
    s: *Screen = terminal_screen(40, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    for y in 0..16 {
        s.text[y * 240 + 18] = 30028 + y;
        s.text[y * 240 + 19] = -1;
        s.comb[y * 240 + 2] = 769
    }
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 20, 16, -5);
    for y in 11..16 {
        s.text[y * 240 + 18] = 30100 + y;
        s.text[y * 240 + 19] = -1
    }
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "left pane", 0, 0, 20, 16);
    // The pane edge cannot cut a wide glyph in half.
    scene_test_show_bool("both halves of a wide glyph share a region", r.scene_region[18] == r.scene_region[19]);
    expect {|
        left pane: shift -5
        both halves of a wide glyph share a region: true
    |}
}

test "a small pane scrolls inside a stationary majority" {
    s: *Screen = terminal_screen(80, 24);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 20, 10, -4);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "small pane", 0, 0, 20, 10);
    scene_test_show_shift(r, "right neighbor", 20, 0, 80, 24);
    scene_test_show_shift(r, "lower neighbor", 0, 10, 20, 24);
    expect {|
        small pane: shift -4
        right neighbor: fixed
        lower neighbor: fixed
    |}
}

test "distant small panes scroll in opposite directions" {
    s: *Screen = terminal_screen(80, 40);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 20, 10, -4);
    scene_test_scroll(s, r, 60, 30, 80, 40, 4);
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "top-left pane", 0, 0, 20, 10);
    scene_test_show_shift(r, "bottom-right pane", 60, 30, 80, 40);
    scene_test_show_shift(r, "stationary middle", 20, 0, 60, 40);
    expect {|
        top-left pane: shift -4
        bottom-right pane: shift 4
        stationary middle: fixed
    |}
}

test "a Neovim half-page redraw keeps entering rows in the scrolling plane" {
    // Reduced from an actual Neovim Ctrl-D redraw: short code lines have
    // repeated words and blank tails, and the final VT operation describes
    // only part of the pane. Neither should truncate its entering rows.
    lines: []str = ["tag terminal;", "", "import screen;", "", "// Every pane owns its matching and clipping rectangle.",
        "// Neighbors must not share source cells or departing glyphs.", "type SceneRegion = {",
        "    left: int;", "    top: int;", "    right: int;", "    bottom: int;",
        "    shift: int;", "    from_y: f32;", "};", "", "type Scene = {"];
    s: *Screen = terminal_screen(80, 24);
    r: *TerminalScene = terminal_scene();
    for y in 0..11 scene_test_put_row(s, y, lines[y]);
    for y in 12..22 scene_test_put_row(s, y, lines[y - 12]);
    scene_test_put_row(s, 11, "program.l8                         1,1             Top");
    scene_test_put_row(s, 22, "program.l8                         1,1             Top");
    terminal_scene_prepare(s, r, 0);
    for y in 0..11 scene_test_put_row(s, y, lines[y + 5]);
    scene_test_put_row(s, 11, "program.l8                         6,1              0%");
    s.scroll_hint_top = 7;
    s.scroll_hint_bottom = 10;
    s.scroll_hint_delta = -5;
    terminal_scene_prepare(s, r, 200);
    scene_test_show_shift(r, "upper pane code", 0, 0, 61, 11);
    scene_test_show_shift(r, "status and lower pane", 0, 11, 80, 24);
    expect {|
        upper pane code: shift -5
        status and lower pane: fixed
    |}
}

test "the right edge of a maximum-width grid is not a column boundary" {
    s: *Screen = terminal_screen(240, 120);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    scene_test_show_bool("column 240 is a boundary", terminal_scene_column_boundary(s,
        r, 240, 0, 120));
    expect {|
        column 240 is a boundary: false
    |}
}

test "sixteen borderless panes scroll at maximum grid size" {
    s: *Screen = terminal_screen(240, 120);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    for row in 0..4 {
        for col in 0..4 {
            shift: int = row + col + 3;
            if ((row + col) % 2 == 0) shift = 0 - shift;
            scene_test_scroll(s, r, col * 60, row * 30, col * 60 + 60, row * 30 + 30,
                shift)
        }
    }
    terminal_scene_prepare(s, r, 200);
    for row in 0..4 {
        for col in 0..4 {
            left: int = col * 60;
            top: int = row * 30;
            right: int = left + 60;
            bottom: int = top + 30;
            write(1, "pane ");
            write_int(1, row);
            write(1, ",");
            write_int(1, col);
            scene_test_show_shift(r, "", left, top, right, bottom)
        }
    }
    expect {|
        pane 0,0: shift -3
        pane 0,1: shift 4
        pane 0,2: shift -5
        pane 0,3: shift 6
        pane 1,0: shift 4
        pane 1,1: shift -5
        pane 1,2: shift 6
        pane 1,3: shift -7
        pane 2,0: shift -5
        pane 2,1: shift 6
        pane 2,2: shift -7
        pane 2,3: shift 8
        pane 3,0: shift 6
        pane 3,1: shift -7
        pane 3,2: shift 8
        pane 3,3: shift -9
    |}
}
