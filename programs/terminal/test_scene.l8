tag terminal_scene_tests;

use_tag std;

use_tag terminal;

import "../../stdlib/print.l8";

import "scene.l8";

scene_test_fill(s: *Screen) {
    for y in 0..s.rows {
        for x in 0..s.cols s.text[y * 240 + x] = 256 + y * 240 + x
    }
}

scene_test_scroll(
    s: *Screen,
    r: *TerminalScene,
    left: int,
    top: int,
    right: int,
    bottom: int,
    shift: int
) requires (0 <= left && right <= 240 && 0 <= top && bottom <= 120) {
    for y in top..bottom {
        for x in left..right {
            pos: int = y * 240 + x;
            source: int = y - shift;
            s.text[pos] = 40000 + pos + r.scene_started * 240;
            s.comb[pos] = 0;
            if (source >= top && source < bottom) {
                old_pos: int = source * 240 + x;
                s.text[pos] = r.scene_text[old_pos];
                s.comb[pos] = r.scene_comb[old_pos];
                s.fg[pos] = r.scene_fg[old_pos];
                s.bg[pos] = r.scene_bg[old_pos]
            }
        }
    }
}

scene_test_put_row(s: *Screen, row: int, text: str) requires (0 <= row && row < 120) {
    for x in 0..s.cols s.text[row * 240 + x] = 32;
    width: int = len(text);
    if (width > s.cols) width = s.cols;
    for x in 0..width s.text[row * 240 + x] = text[x] as int
}

scene_test_show_int(label: str, n: int) raises IoError {
    write(1, label);
    write(1, ": ");
    print_int(n)
}

scene_test_show_bool(label: str, value: bool) raises IoError {
    write(1, label);
    write(1, ": ");
    print_bool(value)
}

// Print "label: fixed" or "label: shift N" when every cell of the rectangle
// moves rigidly with the shift of its first cell: a moving cell starts in its
// own column, opaque, matched to the cell N rows away; a fixed cell starts in
// its own row. Otherwise name the first cell that breaks the pattern.
scene_test_show_shift(
    r: *TerminalScene,
    label: str,
    left: int,
    top: int,
    right: int,
    bottom: int
) raises IoError requires (0 <= left && left < right && right <= 240 && 0 <= top && top < bottom && bottom <= 120) {
    first: TerminalSceneRegion = terminal_scene_region_at(r, top * 240 + left);
    shift: int = first.shift;
    bad: int = -1;
    for y in top..bottom {
        for x in left..right {
            pos: int = y * 240 + x;
            box: TerminalSceneRegion = terminal_scene_region_at(r, pos);
            good: bool = box.shift == shift;
            if (shift != 0) {
                good = good && r.scene_from_x[pos] == x as f32 && r.scene_from_alpha[pos] == 1.0;
                source: int = y - shift;
                if (source >= top && source < bottom) good = good && r.scene_match[pos] == source * 240 + x
            } else good = good && r.scene_from_y[pos] == y as f32;
            if (!good && bad < 0) bad = pos
        }
    }
    write(1, label);
    if (bad >= 0) {
        write(1, ": breaks at column ");
        write_int(1, bad % 240);
        write(1, " row ");
        print_int(bad / 240)
    } else if (shift == 0) write(1, ": fixed\n") else {
        write(1, ": shift ");
        print_int(shift)
    }
}

// Print whether every cell of a row redraws in place without animating.
scene_test_show_pinned(
    s: *Screen,
    r: *TerminalScene,
    label: str,
    row: int
) raises IoError requires (0 <= row && row < 120) {
    moving: int = 0;
    for x in 0..s.cols {
        pos: int = row * 240 + x;
        if (!(r.scene_from_x[pos] == x as f32 && r.scene_from_y[pos] == row as f32 && r.scene_from_alpha[pos] == 1.0)) moving = moving + 1
    }
    write(1, label);
    if (moving == 0) write(1, ": pinned\n") else {
        write(1, ": cells animating ");
        print_int(moving)
    }
}

scene_test_show_region(r: *TerminalScene, label: str, pos: int) raises IoError requires (0 <= pos && pos < 28800) {
    box: TerminalSceneRegion = terminal_scene_region_at(r, pos);
    write(1, label);
    write(1, ": columns ");
    write_int(1, box.left);
    write(1, "..");
    write_int(1, box.right);
    write(1, " rows ");
    write_int(1, box.top);
    write(1, "..");
    write_int(1, box.bottom);
    write(1, " shift ");
    print_int(box.shift)
}

// Dense text should cover each cell center exactly once throughout a scroll, using the
// same interpolated positions and clipping rectangles as the renderer.
scene_test_cover(
    covered: []int,
    clip: TerminalSceneRegion,
    x: f32,
    y: f32
) requires (len(covered) >= 28800) {
    col: int = (x + 0.5) as int;
    row: int = (y + 0.5) as int;
    if (col < 0 || col >= 240 || row < 0 || row >= 120) return;
    if (col >= clip.left && col < clip.right && row >= clip.top && row < clip.bottom && x <= col as f32 + 0.5 && x + 1.0 > col as f32 + 0.5 && y <= row as f32 + 0.5 && y + 1.0 > row as f32 + 0.5) {
        pos: int = row * 240 + col;
        covered[pos] = covered[pos] + 1
    }
}

// Count the cells not covered by exactly one opaque glyph at time now.
scene_test_miscovered(s: *Screen, r: *TerminalScene, now: int): int {
    bad: int = 0;
    region {
        covered: []int = new int[28800](0);
        ease: f32 = terminal_scene_ease(r, now);
        for y in 0..s.rows {
            for x in 0..s.cols {
                pos: int = y * 240 + x;
                clip: TerminalSceneRegion = terminal_scene_region_at(r, pos);
                visual_x: f32 = r.scene_from_x[pos] + (x as f32 - r.scene_from_x[pos]) * ease;
                visual_y: f32 = r.scene_from_y[pos] + (y as f32 - r.scene_from_y[pos]) * ease;
                if (s.text[pos] > 32 && r.scene_from_alpha[pos] >= 0.99) scene_test_cover(covered,
                    clip, visual_x, visual_y)
            }
        }
        for g in 0..r.ghost_count {
            visual_x: f32 = r.ghost_from_x[g] + (r.ghost_to_x[g] - r.ghost_from_x[g]) * ease;
            visual_y: f32 = r.ghost_from_y[g] + (r.ghost_to_y[g] - r.ghost_from_y[g]) * ease;
            if (r.ghost_text[g] > 32 && r.ghost_fade[g] == 0 && r.ghost_from_alpha[g] >= 0.99) {
                clip: TerminalSceneRegion = r.ghost_clip[g];
                scene_test_cover(covered, clip, visual_x, visual_y)
            }
        }
        for y in 0..s.rows {
            for x in 0..s.cols {
                if (covered[y * 240 + x] != 1) bad = bad + 1
            }
        }
    }
    bad
}

scene_test_show_coverage(s: *Screen, r: *TerminalScene, now: int) raises IoError {
    bad: int = scene_test_miscovered(s, r, now);
    write(1, "t=");
    write_int(1, now);
    if (bad == 0) write(1, ": every cell covered once\n") else {
        write(1, ": cells covered zero or several times: ");
        print_int(bad)
    }
}

// Hold a scroll key for 16 frames and summarize what was drawn. Returns the
// time of the last frame.
scene_test_hold_scroll(
    s: *Screen,
    r: *TerminalScene,
    left: int,
    top: int,
    right: int,
    bottom: int,
    shift: int,
    interval: int,
    edits: bool
) raises IoError: int requires (0 <= left && left <= right && right <= 240 && 0 <= top && top <= bottom && bottom <= 120 && left + 5 < right && top + 2 < bottom) {
    bad_frames: int = 0;
    bounded: bool = true;
    for frame in 0..16 {
        now: int = 200 + frame * interval;
        scene_test_scroll(s, r, left, top, right, bottom, shift);
        // Unique incoming pages avoid accidentally encoding another displacement
        // in the fixture's generated codepoints.
        for y in top..bottom {
            if (y - shift < top || y - shift >= bottom) {
                for x in left..right s.text[y * 240 + x] = 200000 + frame * 30000 + y * 240 + x
            }
        }
        if (shift <= top - bottom || shift >= bottom - top) {
            s.scroll_hint_top = top;
            s.scroll_hint_bottom = bottom - 1;
            s.scroll_hint_delta = shift
        }
        if (edits) {
            // A repaint can update digits or annotations while the text scrolls.
            for y in top..bottom s.text[y * 240 + left + 2] = 65 + frame % 26
        }
        terminal_scene_prepare(s, r, now);
        for index in 0..r.scene_region_count {
            box: TerminalSceneRegion = r.scene_regions[index];
            span: f32 = (box.bottom - box.top) as f32;
            bounded = bounded && box.from_y <= span && box.from_y >= 0.0 - span
        }
        bad: int = scene_test_miscovered(s, r, now) + scene_test_miscovered(s, r,
            now + interval / 2) + scene_test_miscovered(s, r, now + interval - 1);
        if (edits) {
            // A second write changes text without scrolling again.
            s.text[(top + 2) * 240 + left + 5] = 90 + frame;
            terminal_scene_prepare(s, r, now + interval / 2);
            bad = bad + scene_test_miscovered(s, r, now + interval / 2) + scene_test_miscovered(s,
                r, now + interval - 1)
        }
        if (bad > 0) bad_frames = bad_frames + 1
    }
    scene_test_show_bool("lag within one pane height", bounded);
    scene_test_show_int("frames with a gap or overlap", bad_frames);
    now: int = 200 + 15 * interval;
    if (edits) now = now + interval / 2;
    now
}

// Release a held scroll at time now: it must catch up and settle normally.
scene_test_release_scroll(s: *Screen, r: *TerminalScene, now: int) raises IoError {
    scene_test_show_int("gaps or overlaps while catching up", scene_test_miscovered(s,
        r, now + 60) + scene_test_miscovered(s, r, now + 119));
    terminal_scene_prepare(s, r, now + 120);
    scene_test_show_bool("settled: animating", r.scene_active);
    scene_test_show_int("settled: ghosts", r.ghost_count);
    scene_test_show_int("settled: gaps or overlaps", scene_test_miscovered(s, r, now + 120))
}

test "the region table reports exhaustion and falls back to the whole viewport" {
    s: *Screen = terminal_screen(2, 2);
    r: *TerminalScene = terminal_scene();
    one_cell: TerminalSceneRegion = terminal_scene_region(0, 0, 1, 1);
    for _i in 0..256 terminal_scene_add_region(r, one_cell);
    scene_test_show_int("regions", r.scene_region_count);
    scene_test_show_bool("exhausted", r.scene_exhausted);
    expect {|
        regions: 256
        exhausted: false
    |}
    // One more does not write past the table's capacity.
    terminal_scene_add_region(r, one_cell);
    scene_test_show_int("regions", r.scene_region_count);
    scene_test_show_bool("exhausted", r.scene_exhausted);
    expect {|
        regions: 256
        exhausted: true
    |}
    terminal_scene_fallback_region(s, r);
    scene_test_show_int("regions", r.scene_region_count);
    scene_test_show_bool("exhausted", r.scene_exhausted);
    scene_test_show_int("region of cell (0,0)", r.scene_region[0]);
    scene_test_show_region(r, "cell (0,0)", 0);
    expect {|
        regions: 1
        exhausted: false
        region of cell (0,0): 0
        cell (0,0): columns 0..2 rows 0..2 shift 0
    |}
}

test "an expanding pane edge keeps old and new rows aligned" {
    // An inferred edge expands into a previously stationary column. Its
    // corner no longer represents the displacement of the moving pane.
    s: *Screen = terminal_screen(40, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 1, 0, 40, 16, -8);
    terminal_scene_prepare(s, r, 200);
    scene_test_scroll(s, r, 0, 0, 40, 16, -8);
    terminal_scene_prepare(s, r, 220);
    scene_test_show_coverage(s, r, 220);
    scene_test_show_coverage(s, r, 230);
    scene_test_show_coverage(s, r, 280);
    expect {|
        t=220: every cell covered once
        t=230: every cell covered once
        t=280: every cell covered once
    |}
}

test "a scroll reversal replaces returning ghosts with the current plane" {
    s: *Screen = terminal_screen(40, 16);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 1, 0, 40, 16, -8);
    terminal_scene_prepare(s, r, 200);
    scene_test_scroll(s, r, 0, 0, 40, 16, -8);
    terminal_scene_prepare(s, r, 220);
    scene_test_scroll(s, r, 0, 0, 40, 16, 8);
    terminal_scene_prepare(s, r, 240);
    scene_test_show_coverage(s, r, 240);
    scene_test_show_coverage(s, r, 250);
    scene_test_show_coverage(s, r, 300);
    expect {|
        t=240: every cell covered once
        t=250: every cell covered once
        t=300: every cell covered once
    |}
}

test "a gutter repaint cannot carry moving digits over the fixed status line" {
    // A relative-number gutter stops moving independently of the code,
    // while both still have unfinished animation above a styled status row.
    s: *Screen = terminal_screen(40, 18);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    for x in 0..40 s.bg[16 * 240 + x] = 4;
    terminal_scene_prepare(s, r, 0);
    scene_test_scroll(s, r, 0, 0, 40, 16, -8);
    s.text[16 * 240 + 20] = 88;
    terminal_scene_prepare(s, r, 200);
    scene_test_scroll(s, r, 4, 0, 40, 16, -8);
    s.text[8 * 240 + 2] = 57;
    s.text[16 * 240 + 20] = 89;
    terminal_scene_prepare(s, r, 220);
    scene_test_show_coverage(s, r, 220);
    scene_test_show_coverage(s, r, 240);
    scene_test_show_coverage(s, r, 280);
    expect {|
        t=220: every cell covered once
        t=240: every cell covered once
        t=280: every cell covered once
    |}
}

test "a held full-screen scroll with repaints stays covered" {
    s: *Screen = terminal_screen(80, 24);
    r: *TerminalScene = terminal_scene();
    scene_test_fill(s);
    terminal_scene_prepare(s, r, 0);
    released: int = scene_test_hold_scroll(s, r, 0, 0, 80, 24, -12, 16, true);
    expect {|
        lag within one pane height: true
        frames with a gap or overlap: 0
    |}
    scene_test_release_scroll(s, r, released);
    expect {|
        gaps or overlaps while catching up: 0
        settled: animating: false
        settled: ghosts: 0
        settled: gaps or overlaps: 0
    |}
}

