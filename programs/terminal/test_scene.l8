tag terminal_scene_tests;

use_tag terminal;

import "scene.l8";

failures: int = 0;

check(ok: bool, label: str) {
    if (!ok) {
        failures = failures + 1;
        write(2, label, len(label));
        write(2, "\n", 1);
    }
}

fill(s: *Screen) {
    for y in 0..s.rows {
        for x in 0..s.cols {
            s.text[y * 240 + x] = 256 + y * 240 + x;
        }
    }
}

scroll(
    s: *Screen,
    r: *TerminalScene,
    left: int,
    top: int,
    right: int,
    bottom: int,
    shift: int
) {
    for y in top..bottom {
        for x in left..right {
            pos: int = y * 240 + x;
            source: int = y - shift;
            s.text[pos] = 40000 + pos + r.scene_started * 240;
            s.comb[pos] = 0;
            if (source >= top && source < bottom) {
                old_pos: int = source * 240 + x;
                s.text[pos] = r.scene_text[old_pos];
                s.comb[pos] = r.scene_comb[old_pos];
                s.fg[pos] = r.scene_fg[old_pos];
                s.bg[pos] = r.scene_bg[old_pos];
            }
        }
    }
}

expect_shift(
    r: *TerminalScene,
    left: int,
    top: int,
    right: int,
    bottom: int,
    shift: int,
    label: str
) {
    good: bool = true;
    for y in top..bottom {
        for x in left..right {
            pos: int = y * 240 + x;
            box: TerminalSceneRegion = r.scene_regions[r.scene_region[pos]];
            good = good && box.shift == shift;
            if (shift != 0) {
                good = good && r.scene_from_x[pos] == x as f32 && r.scene_from_alpha[pos] == 1.0;
                source: int = y - shift;
                if (source >= top && source < bottom) {
                    good = good && r.scene_match[pos] == source * 240 + x;
                }
            } else {
                good = good && r.scene_from_y[pos] == y as f32;
            }
        }
    }
    check(good, label);
}

put_row(s: *Screen, row: int, text: str) {
    for x in 0..s.cols {
        s.text[row * 240 + x] = 32;
    }
    for x in 0..len(text) {
        s.text[row * 240 + x] = text[x] as int;
    }
}

main(): int {
    region {
        s: *Screen = terminal_screen(40, 16);
        r: *TerminalScene = terminal_scene();
        fill(s);
        for x in 0..40 {
            s.bg[x] = 4;
        }
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 40, 16, -5);
        for x in 0..40 {
            s.bg[x] = 4;
        }
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 40, 16, -5, "stable cursor-line highlight does not pin surviving scroll text");
    }
    region {
        s: *Screen = terminal_screen(40, 16);
        r: *TerminalScene = terminal_scene();
        fill(s);
        for y in 0..16 {
            for x in 0..12 {
                s.text[y * 240 + x] = 65 + x;
            }
        }
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 40, 16, -8);
        for y in 8..16 {
            for x in 0..12 {
                s.text[y * 240 + x] = 65 + x;
            }
        }
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 40, 16, -8, "repeated prefixes do not shear into a stationary strip");
        check(r.scene_region_count == 1, "incoming repeated prefixes remain one rigid plane");
    }
    region {
        s: *Screen = terminal_screen(80, 24);
        r: *TerminalScene = terminal_scene();
        fill(s);
        put_row(s, 21, "            if (extra > gain) {");
        put_row(s, 22, "file.l8                   100,1     10%");
        for x in 0..80 {
            s.bg[22 * 240 + x] = 7;
            s.fg[22 * 240 + x] = 0;
        }
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 80, 22, -11);
        put_row(s, 21, "            if (extra > gain) {");
        put_row(s, 22, "file.l8                   111,1     11%");
        terminal_scene_prepare(s, r, 200);
        // The repeated last code row is new incoming text, not another status bar.
        check(r.scene_regions[r.scene_region[21 * 240]].shift == -11, "coincidentally identical incoming code line remains in plane");
        for x in 0..80 {
            pos: int = 22 * 240 + x;
            check(r.scene_from_x[pos] == x as f32 && r.scene_from_y[pos] == 22.0 && r.scene_from_alpha[pos] == 1.0,
                "changing status counters update immediately without horizontal or vertical animation");
        }
    }
    region {
        s: *Screen = terminal_screen(40, 12);
        r: *TerminalScene = terminal_scene();
        fill(s);
        put_row(s, 10, "123,4  10%");
        for x in 0..40 {
            s.bg[10 * 240 + x] = 4;
        }
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 40, 10, -4);
        put_row(s, 10, "987,6  89%");
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 40, 10, -4, "numeric status changes do not move neighboring content boundary");
        expect_shift(r, 0, 10, 40, 12, 0, "status remains fixed when most meaningful characters change");
        put_row(s, 10, "999,9  99%");
        terminal_scene_prepare(s, r, 220);
        for x in 0..40 {
            pos: int = 10 * 240 + x;
            check(r.scene_from_x[pos] == x as f32 && r.scene_from_y[pos] == 10.0 && r.scene_from_alpha[pos] == 1.0,
                "counter-only repaint during scroll stays pinned");
        }
    }
    region {
        s: *Screen = terminal_screen(40, 16);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 40, 16, -8);
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 40, 16, -8, "full-screen half-page scroll");
        check(r.scene_region_count == 1, "full-screen remains one rigid plane");
        terminal_scene_prepare(s, r, 321);
        check(!r.scene_active && r.ghost_count == 0, "completed animation retires ghosts");
    }
    region {
        s: *Screen = terminal_screen(60, 16);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 20, 15, -7);
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 20, 15, -7, "left pane scrolls under larger stationary pane");
        expect_shift(r, 20, 0, 60, 16, 0, "right pane stays fixed");
        expect_shift(r, 0, 15, 20, 16, 0, "pane status stays fixed");
        for g in 0..r.ghost_count {
            clip: TerminalSceneRegion = r.ghost_clip[g];
            check(clip.right <= 20 && clip.bottom <= 15, "departing text clips to left pane");
        }
        scroll(s, r, 0, 0, 20, 15, -7);
        terminal_scene_prepare(s, r, 260);
        expect_shift(r, 0, 0, 20, 15, -7, "interrupted left pane remains rigid");
        expect_shift(r, 20, 0, 60, 16, 0, "interrupted scroll leaves neighbor fixed");
        check(r.scene_from_y[0] == 10.5, "interrupted scroll starts at displayed position");
        // An unrelated edit arrives while the left pane is still moving.
        s.text[5 * 240 + 30] = 90;
        terminal_scene_prepare(s, r, 290);
        box: TerminalSceneRegion = r.scene_regions[r.scene_region[0]];
        check(box.right == 20 && box.bottom == 15 && r.scene_from_y[0] > 0.0, "unrelated repaint preserves ongoing motion and clipping");
        scroll(s, r, 20, 0, 60, 16, 3);
        terminal_scene_prepare(s, r, 320);
        check(r.scene_from_y[0] > 0.0, "neighbor scroll does not cancel existing pane motion");
    }
    region {
        s: *Screen = terminal_screen(60, 20);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 40, 0, 60, 20, 6);
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 40, 20, 0, "left stationary pane");
        expect_shift(r, 40, 0, 60, 20, 6, "right pane downward scroll");
    }
    region {
        s: *Screen = terminal_screen(40, 24);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 13, 40, 23, -4);
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 40, 13, 0, "upper pane and separator stay fixed");
        expect_shift(r, 0, 13, 40, 23, -4, "lower stacked pane scrolls");
        expect_shift(r, 0, 23, 40, 24, 0, "bottom status fixed");
    }
    region {
        s: *Screen = terminal_screen(60, 24);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 30, 11, -4);
        scroll(s, r, 0, 12, 30, 24, 5);
        scroll(s, r, 31, 0, 60, 24, -8);
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 30, 11, -4, "nested top-left pane");
        expect_shift(r, 0, 12, 30, 24, 5, "nested bottom-left pane, opposite direction");
        expect_shift(r, 31, 0, 60, 24, -8, "nested full-height right pane");
        expect_shift(r, 0, 11, 30, 12, 0, "nested horizontal divider");
        expect_shift(r, 30, 0, 31, 24, 0, "nested vertical divider");
    }
    region {
        s: *Screen = terminal_screen(40, 20);
        r: *TerminalScene = terminal_scene();
        fill(s);
        // Same blank line before and after a two-row scroll is not pane chrome.
        for x in 0..40 {
            s.text[8 * 240 + x] = 32;
            s.text[10 * 240 + x] = 32;
            s.text[19 * 240 + x] = 32;
            s.bg[19 * 240 + x] = 4;
        }
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 40, 19, -2);
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 40, 19, -2, "blank lines remain in rigid scroll plane");
        expect_shift(r, 0, 19, 40, 20, 0, "blank styled status row stays fixed");
    }
    region {
        s: *Screen = terminal_screen(40, 16);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 2, 20, 14, -5);
        // A program can use a full-width VT scroll then repaint the other pane.
        s.scroll_hint_top = 2;
        s.scroll_hint_bottom = 13;
        s.scroll_hint_delta = -5;
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 2, 20, 14, -5, "pane inference refines protocol scroll hint");
        expect_shift(r, 20, 0, 40, 16, 0, "repainted neighbor overrides full-width hint");
        check(s.scroll_hint_delta == 0, "hint consumed once");
    }
    region {
        s: *Screen = terminal_screen(20, 10);
        r: *TerminalScene = terminal_scene();
        s.text[8 * 240] = 65;
        terminal_scene_prepare(s, r, 0);
        terminal_scroll(s, 0, 9, false);
        terminal_scene_prepare(s, r, 200);
        check(r.scene_regions[r.scene_region[7 * 240]].shift == -1, "sparse protocol scroll still animates");
    }
    region {
        s: *Screen = terminal_screen(20, 6);
        r: *TerminalScene = terminal_scene();
        for x in 0..8 {
            s.text[x] = 65 + x;
        }
        terminal_scene_prepare(s, r, 0);
        for x in 3..9 {
            s.text[x] = 64 + x;
        }
        s.text[2] = 90;
        terminal_scene_prepare(s, r, 200);
        check(!r.scene_has_shift && r.scene_match[3] == 2 && r.scene_match[8] == 7,
            "ordinary insertion retains horizontal LCS animation");
        terminal_resize(s, 10, 3);
        terminal_scene_prepare(s, r, 230);
        check(!r.scene_active && r.ghost_count == 0 && r.scene_region_count == 1,
            "resize resets old geometry and ghosts");
    }
    region {
        s: *Screen = terminal_screen(40, 16);
        r: *TerminalScene = terminal_scene();
        fill(s);
        for y in 0..16 {
            s.text[y * 240 + 18] = 30028 + y;
            s.text[y * 240 + 19] = -1;
            s.comb[y * 240 + 2] = 769;
        }
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 20, 16, -5);
        for y in 11..16 {
            s.text[y * 240 + 18] = 30100 + y;
            s.text[y * 240 + 19] = -1;
        }
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 20, 16, -5, "wide and combining glyphs scroll with pane");
        check(r.scene_region[18] == r.scene_region[19], "pane edge cannot cut a wide glyph in half");
    }
    region {
        s: *Screen = terminal_screen(80, 24);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 20, 10, -4);
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 20, 10, -4, "small nested pane hidden by stationary majority");
        expect_shift(r, 20, 0, 80, 24, 0, "large neighbor of small nested pane");
        expect_shift(r, 0, 10, 20, 24, 0, "lower neighbor of small nested pane");
    }
    region {
        s: *Screen = terminal_screen(80, 40);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        scroll(s, r, 0, 0, 20, 10, -4);
        scroll(s, r, 60, 30, 80, 40, 4);
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 20, 10, -4, "small top-left scroll with distant moving pane");
        expect_shift(r, 60, 30, 80, 40, 4, "small bottom-right scroll with distant moving pane");
        expect_shift(r, 20, 0, 60, 40, 0, "stationary majority between distant scrolling panes");
    }
    region {
        // Reduced from an actual Neovim Ctrl-D redraw: short code lines have
        // repeated words and blank tails, and the final VT operation describes
        // only part of the pane. Neither should truncate its entering rows.
        lines: []str = ["tag terminal;", "", "import screen;", "", "// Every pane owns its matching and clipping rectangle.",
            "// Neighbors must not share source cells or departing glyphs.", "type SceneRegion = {",
            "    left: int;", "    top: int;", "    right: int;", "    bottom: int;",
            "    shift: int;", "    from_y: f32;", "};", "", "type Scene = {"];
        s: *Screen = terminal_screen(80, 24);
        r: *TerminalScene = terminal_scene();
        for y in 0..11 {
            put_row(s, y, lines[y]);
        }
        for y in 12..22 {
            put_row(s, y, lines[y - 12]);
        }
        put_row(s, 11, "program.l8                         1,1             Top");
        put_row(s, 22, "program.l8                         1,1             Top");
        terminal_scene_prepare(s, r, 0);
        for y in 0..11 {
            put_row(s, y, lines[y + 5]);
        }
        put_row(s, 11, "program.l8                         6,1              0%");
        s.scroll_hint_top = 7;
        s.scroll_hint_bottom = 10;
        s.scroll_hint_delta = -5;
        terminal_scene_prepare(s, r, 200);
        expect_shift(r, 0, 0, 61, 11, -5, "Neovim entering code rows remain in scrolling plane");
        expect_shift(r, 0, 11, 80, 24, 0, "Neovim status and lower pane stay fixed");
    }
    region {
        s: *Screen = terminal_screen(240, 120);
        r: *TerminalScene = terminal_scene();
        fill(s);
        terminal_scene_prepare(s, r, 0);
        for row in 0..4 {
            for col in 0..4 {
                shift: int = row + col + 3;
                if ((row + col) % 2 == 0) {
                    shift = 0 - shift;
                }
                scroll(s, r, col * 60, row * 30, col * 60 + 60, row * 30 + 30, shift);
            }
        }
        terminal_scene_prepare(s, r, 200);
        for row in 0..4 {
            for col in 0..4 {
                shift: int = row + col + 3;
                if ((row + col) % 2 == 0) {
                    shift = 0 - shift;
                }
                expect_shift(r, col * 60, row * 30, col * 60 + 60, row * 30 + 30,
                    shift, "sixteen borderless panes at maximum grid size");
            }
        }
    }
    if (failures == 0) {
        write(1, "terminal scene tests passed\n", len("terminal scene tests passed\n"));
    }
    failures;
}
