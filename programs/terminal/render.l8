tag terminal;

use_tag gl, wayland, freetype;

import "../gl/core.l8";

import "../wayland/wayland.l8";

import "../freetype/ft.l8";

import "scene.l8";

import "presentation.l8";

extern glDeleteShader(shader: int): int;

extern glDeleteProgram(program: int): int;

extern glDeleteBuffers(n: int, buffers: *u32): int;

extern glDeleteTextures(n: int, textures: *u32): int;

type TerminalRenderer = {
    window: *WLWindow;
    font: *CachedFont;
    cw: int;
    ch: int;
    ascent: int;
    width: int;
    height: int;
    program: int;
    viewport: int;
    buffer: u32;
    texture: u32;
    vertices: []f32;
    palette: []int;
    cursor: *TerminalCursor;
    scene: *TerminalScene;
};

terminal_shader(kind: int, text: []i8): int {
    shader: int = glCreateShader(kind);
    ptr: *i8 = text;
    size: i32 = len(text) trunc i32;
    glShaderSource(shader, 1, &ptr, &size);
    glCompileShader(shader);
    ok: i32 = 0i32;
    glGetShaderiv(shader, 35713, &ok);
    if (ok == 0i32) {
        log: []i8 = new i8[2048](0i8);
        count: i32 = 0i32;
        glGetShaderInfoLog(shader, len(log), &count, log);
        write(2, log, terminal_clamp(count as int, 0, len(log)));
        glDeleteShader(shader);
        return 0;
    }
    shader;
}

terminal_renderer_close(r: *TerminalRenderer) {
    glDeleteBuffers(1, &r.buffer);
    glDeleteTextures(1, &r.texture);
    glDeleteProgram(r.program);
    wl_window_close(r.window);
    close_cached_font(r.font);
}

terminal_renderer(path: str, px: int) noregion: ?*TerminalRenderer@new {
    font0: ?*CachedFont = load_cached_font(path, "/usr/share/fonts/truetype/ancient-scripts/Symbola_hint.ttf",
        px, 2048, 2048, 4096);
    if (font0 == null) {
        return null;
    }
    font: *CachedFont = font0;
    em: int = cached_font_glyph(font, 77);
    cw: int = font.glyphs[em].adv as int;
    top: int = 0;
    bottom: int = 0;
    for code in FT_FIRST..FT_LAST + 1 {
        index: int = cached_font_glyph(font, code);
        g: Glyph = font.glyphs[index];
        if (g.adv as int != cw || cw < 1) {
            write(2, "terminal: font must contain fixed-width ASCII glyphs\n", len("terminal: font must contain fixed-width ASCII glyphs\n"));
            close_cached_font(font);
            return null;
        }
        if (g.top as int > top) {
            top = g.top as int;
        }
        if ((g.h - g.top) as int > bottom) {
            bottom = (g.h - g.top) as int;
        }
    }
    ch: int = top + bottom + 4;
    window0: ?*WLWindow = wl_window_open(80 * cw + 16, 24 * ch + 16, "L8 Terminal",
        "org.lang8.Terminal");
    if (window0 == null) {
        close_cached_font(font);
        return null;
    }
    window: *WLWindow = window0;
    // Capacity for background/base/mark quads for the current and departing
    // scenes, plus the independently drawn cursor.
    r: *TerminalRenderer = new TerminalRenderer {
        window: window,
        font: font,
        cw: cw,
        ch: ch,
        ascent: top + 2,
        width: 80 * cw + 16,
        height: 24 * ch + 16,
        program: 0,
        viewport: -1,
        buffer: 0u32,
        texture: 0u32,
        vertices: new f32[8294448](0.0),
        palette: new int[256](0),
        cursor: terminal_cursor(),
        scene: terminal_scene()
    };
    base: []int = [1579032, 13391189, 5614165, 13412949, 5601228, 11163050, 5614250,
        13421772, 7829367, 16742263, 7855479, 16768375, 7838207, 14514141, 7855581,
        16777215];
    for color in 0..16 {
        r.palette[color] = base[color];
    }
    for color in 16..232 {
        cube: int = color - 16;
        red: int = cube / 36;
        green: int = cube / 6 % 6;
        blue: int = cube % 6;
        if (red > 0) {
            red = 55 + red * 40;
        }
        if (green > 0) {
            green = 55 + green * 40;
        }
        if (blue > 0) {
            blue = 55 + blue * 40;
        }
        r.palette[color] = red * 65536 + green * 256 + blue;
    }
    for color in 232..256 {
        gray: int = 8 + (color - 232) * 10;
        r.palette[color] = gray * 65536 + gray * 256 + gray;
    }
    vs: []i8 = """
#version 120
attribute vec2 position;
attribute vec2 uv;
attribute vec3 color;
attribute float opacity;
uniform vec2 viewport;
varying vec2 texcoord;
varying vec3 ink;
varying float fade;
void main() {
    gl_Position = vec4(position.x * 2.0 / viewport.x - 1.0,
                       1.0 - position.y * 2.0 / viewport.y, 0.0, 1.0);
    texcoord = uv;
    ink = color;
    fade = opacity;
}
""";
    fs: []i8 = """
#version 120
uniform sampler2D atlas;
varying vec2 texcoord;
varying vec3 ink;
varying float fade;
void main() {
    float coverage = texcoord.x < 0.0 ? 1.0 : texture2D(atlas, texcoord).a;
    gl_FragColor = vec4(ink, coverage * fade);
}
""";
    vsh: int = terminal_shader(35633, vs);
    fsh: int = terminal_shader(35632, fs);
    if (vsh == 0 || fsh == 0) {
        glDeleteShader(vsh);
        glDeleteShader(fsh);
        terminal_renderer_close(r);
        return null;
    }
    r.program = glCreateProgram();
    glAttachShader(r.program, vsh);
    glAttachShader(r.program, fsh);
    glBindAttribLocation(r.program, 0, "position");
    glBindAttribLocation(r.program, 1, "uv");
    glBindAttribLocation(r.program, 2, "color");
    glBindAttribLocation(r.program, 3, "opacity");
    glLinkProgram(r.program);
    glDeleteShader(vsh);
    glDeleteShader(fsh);
    ok: i32 = 0i32;
    glGetProgramiv(r.program, 35714, &ok);
    if (ok == 0i32) {
        terminal_renderer_close(r);
        return null;
    }
    glUseProgram(r.program);
    r.viewport = glGetUniformLocation(r.program, "viewport");
    glUniform1i(glGetUniformLocation(r.program, "atlas"), 0);
    glGenBuffers(1, &r.buffer);
    glBindBuffer(34962, r.buffer);
    glVertexAttribPointer(0, 2, 5126, 0, 32, 0);
    glVertexAttribPointer(1, 2, 5126, 0, 32, 8);
    glVertexAttribPointer(2, 3, 5126, 0, 32, 16);
    glVertexAttribPointer(3, 1, 5126, 0, 32, 28);
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(1);
    glEnableVertexAttribArray(2);
    glEnableVertexAttribArray(3);
    glGenTextures(1, &r.texture);
    glBindTexture(3553, r.texture);
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glPixelStorei(3317, 1);
    glTexImage2D(3553, 0, 6406, font.width, font.height, 0, 6406, 5121, font.atlas);
    font.dirty = false;
    glEnable(3042);
    glBlendFunc(770, 771);
    glClearColor(24.0 / 255.0, 24.0 / 255.0, 24.0 / 255.0, 1.0);
    r;
}

terminal_quad(
    r: *TerminalRenderer,
    offset: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    color: int,
    alpha: f32
): int {
    i: int = offset;
    corner: int = 0;
    rgb: int = color - 256;
    if (color < 256) {
        rgb = r.palette[color];
    }
    red: f32 = (rgb / 65536) as f32 / 255.0;
    green: f32 = (rgb / 256 % 256) as f32 / 255.0;
    blue: f32 = (rgb % 256) as f32 / 255.0;
    while (corner < 6) {
        right: bool = corner == 1 || corner == 3 || corner == 5;
        lower: bool = corner == 2 || corner == 4 || corner == 5;
        r.vertices[i] = x;
        r.vertices[i + 1] = y;
        r.vertices[i + 2] = u0;
        r.vertices[i + 3] = v0;
        if (right) {
            r.vertices[i] = x + w;
            r.vertices[i + 2] = u1;
        }
        if (lower) {
            r.vertices[i + 1] = y + h;
            r.vertices[i + 3] = v1;
        }
        r.vertices[i + 4] = red;
        r.vertices[i + 5] = green;
        r.vertices[i + 6] = blue;
        r.vertices[i + 7] = alpha;
        i = i + 8;
        corner = corner + 1;
    }
    i;
}

terminal_cursor_frame(s: *Screen, r: *TerminalRenderer, now: int): bool {
    if (r.cursor.cursor_active || r.scene.scene_active) {
        return true;
    }
    blinking: bool = s.cursor_style % 2 == 1;
    on: bool = s.visible && (!blinking || now % 1000 < 500);
    on != r.cursor.cursor_on;
}

// Clip geometry and atlas coordinates together. Masking stationary rows cannot
// clip two adjacent moving panes, especially when they scroll in opposite ways.
terminal_clipped_quad(
    r: *TerminalRenderer,
    offset: int,
    clip: TerminalSceneRegion,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
    color: int,
    alpha: f32
): int {
    left: f32 = 8.0 + clip.left as f32 * r.cw as f32;
    top: f32 = 8.0 + clip.top as f32 * r.ch as f32;
    right: f32 = 8.0 + clip.right as f32 * r.cw as f32;
    bottom: f32 = 8.0 + clip.bottom as f32 * r.ch as f32;
    x0: f32 = x;
    y0: f32 = y;
    x1: f32 = x + w;
    y1: f32 = y + h;
    if (x0 < left) {
        x0 = left;
    }
    if (y0 < top) {
        y0 = top;
    }
    if (x1 > right) {
        x1 = right;
    }
    if (y1 > bottom) {
        y1 = bottom;
    }
    if (x0 >= x1 || y0 >= y1) {
        return offset;
    }
    terminal_quad(r, offset, x0, y0, x1 - x0, y1 - y0, u0 + (u1 - u0) * (x0 - x) / w,
        v0 + (v1 - v0) * (y0 - y) / h, u0 + (u1 - u0) * (x1 - x) / w, v0 + (v1 - v0) * (y1 - y) / h,
        color, alpha);
}

terminal_draw(s: *Screen, r: *TerminalRenderer, now: int) {
    terminal_scene_prepare(s, r.scene, now);
    scene_ease: f32 = terminal_scene_ease(r.scene, now);
    terminal_cursor_update(s, r.cursor, now);
    blinking: bool = s.cursor_style % 2 == 1;
    r.cursor.cursor_on = s.visible && (!blinking || now % 1000 < 500);
    glViewport(0, 0, r.width, r.height);
    glUniform2f(r.viewport, r.width as f32, r.height as f32);
    glClear(16384);
    n: int = 0;
    pass: int = 0;
    // Backgrounds first, then glyphs; one upload and draw for the entire screen.
    while (pass < 2) {
        y: int = 0;
        while (y < s.rows) {
            x: int = 0;
            while (x < s.cols) {
                pos: int = y * 240 + x;
                clip: TerminalSceneRegion = r.scene.scene_regions[r.scene.scene_region[pos]];
                fg: int = s.fg[pos];
                bg: int = s.bg[pos];
                visual_x: f32 = r.scene.scene_from_x[pos] + (x as f32 - r.scene.scene_from_x[pos]) * scene_ease;
                visual_y: f32 = r.scene.scene_from_y[pos] + (y as f32 - r.scene.scene_from_y[pos]) * scene_ease;
                alpha: f32 = r.scene.scene_from_alpha[pos] + (1.0 - r.scene.scene_from_alpha[pos]) * scene_ease;
                px: f32 = 8.0 + visual_x * r.cw as f32;
                py: f32 = 8.0 + visual_y * r.ch as f32;
                if (pass == 0 && bg != 0) {
                    // Background colors describe the destination grid. Keeping
                    // them opaque avoids translucent sheets during rapid scrolls.
                    bg_x: f32 = 8.0 + x as f32 * r.cw as f32;
                    bg_y: f32 = 8.0 + y as f32 * r.ch as f32;
                    n = terminal_quad(r, n, bg_x, bg_y, r.cw as f32, r.ch as f32,
                        -1.0, -1.0, -1.0, -1.0, bg, 1.0);
                }
                code: int = s.text[pos];
                if (pass == 1) {
                    if (code > 32) {
                        glyph_index: int = cached_font_glyph(r.font, code);
                        g: Glyph = r.font.glyphs[glyph_index];
                        if (g.w > 0.0 && g.h > 0.0) {
                            n = terminal_clipped_quad(r, n, clip, px + g.left, py + r.ascent as f32 - g.top,
                                g.w, g.h, g.u0, g.v0, g.u1, g.v1, fg, alpha);
                        }
                    }
                    mark: int = s.comb[pos];
                    if (mark > 0) {
                        mark_index: int = cached_font_glyph(r.font, mark);
                        accent: Glyph = r.font.glyphs[mark_index];
                        if (accent.w > 0.0 && accent.h > 0.0) {
                            n = terminal_clipped_quad(r, n, clip, px + accent.left,
                                py + r.ascent as f32 - accent.top, accent.w, accent.h,
                                accent.u0, accent.v0, accent.u1, accent.v1, fg, alpha);
                        }
                    }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        g: int = 0;
        while (g < r.scene.ghost_count) {
            clip: TerminalSceneRegion = r.scene.ghost_clip[g];
            alpha: f32 = r.scene.ghost_from_alpha[g];
            if (r.scene.ghost_fade[g] == 1) {
                alpha = alpha * (1.0 - scene_ease);
            }
            visual_x: f32 = r.scene.ghost_from_x[g] + (r.scene.ghost_to_x[g] - r.scene.ghost_from_x[g]) * scene_ease;
            visual_y: f32 = r.scene.ghost_from_y[g] + (r.scene.ghost_to_y[g] - r.scene.ghost_from_y[g]) * scene_ease;
            px: f32 = 8.0 + visual_x * r.cw as f32;
            py: f32 = 8.0 + visual_y * r.ch as f32;
            if (pass == 1 && r.scene.ghost_text[g] > 32) {
                glyph_index: int = cached_font_glyph(r.font, r.scene.ghost_text[g]);
                glyph: Glyph = r.font.glyphs[glyph_index];
                if (glyph.w > 0.0 && glyph.h > 0.0) {
                    n = terminal_clipped_quad(r, n, clip, px + glyph.left, py + r.ascent as f32 - glyph.top,
                        glyph.w, glyph.h, glyph.u0, glyph.v0, glyph.u1, glyph.v1,
                        r.scene.ghost_fg[g], alpha);
                }
            }
            if (pass == 1) {
                mark: int = r.scene.ghost_comb[g];
                if (mark > 0) {
                    mark_index: int = cached_font_glyph(r.font, mark);
                    accent: Glyph = r.font.glyphs[mark_index];
                    if (accent.w > 0.0 && accent.h > 0.0) {
                        n = terminal_clipped_quad(r, n, clip, px + accent.left, py + r.ascent as f32 - accent.top,
                            accent.w, accent.h, accent.u0, accent.v0, accent.u1, accent.v1,
                            r.scene.ghost_fg[g], alpha);
                    }
                }
            }
            g = g + 1;
        }
        pass = pass + 1;
    }
    content: int = n;
    if (r.cursor.cursor_on) {
        cursor_x: f32 = 8.0 + r.cursor.cursor_x * r.cw as f32;
        cursor_y: f32 = 8.0 + r.cursor.cursor_y * r.ch as f32;
        cursor_w: int = r.cw;
        cursor_h: int = r.ch;
        shape: int = (s.cursor_style - 1) / 2;
        if (shape == 1) {
            cursor_h = r.ch / 8;
            if (cursor_h < 2) {
                cursor_h = 2;
            }
            cursor_y = cursor_y + (r.ch - cursor_h) as f32;
        }
        if (shape == 2) {
            cursor_w = r.cw / 5;
            if (cursor_w < 2) {
                cursor_w = 2;
            }
        }
        n = terminal_quad(r, n, cursor_x, cursor_y, cursor_w as f32, cursor_h as f32,
            -1.0, -1.0, -1.0, -1.0, 7, 1.0);
    }
    if (r.font.dirty) {
        glBindTexture(3553, r.texture);
        glTexSubImage2D(3553, 0, 0, 0, r.font.width, r.font.height, 6406, 5121, r.font.atlas);
        r.font.dirty = false;
    }
    if (n > 0) {
        glBufferData(34962, n * 4, r.vertices, 35040);
        if (content > 0) {
            glDrawArrays(4, 0, content / 8);
        }
        if (n > content) {
            // XOR keeps text legible under every cursor shape, including while moving.
            glDisable(3042);
            glEnable(3058);
            glLogicOp(5386);
            glDrawArrays(4, content / 8, 6);
            glDisable(3058);
            glEnable(3042);
        }
    }
    if (!wl_window_present(r.window)) {
        r.window.closed = true;
    }
}
