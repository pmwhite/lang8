tag wasm;

use_tag std;

// A host that answers a module's imports with native code: each import is
// bound, by its link name, to a native function (one the host registered,
// `proxy_bind`, or one the host's resolver finds: dlsym on an iPhone) and
// called with the module's arguments as the module's `l8imports` section
// says they are (src2/persist.l8): numbers as they are, floats in float
// registers, a pointer into the module's memory made native by the
// memory's address, a function value as the address of a trampoline that
// enters the module's function of that name, so native code can call it
// back, through a reload too. Imports the standard host knows (sys.l8)
// go there unless bound.
import "sys.l8";

extern wasm_native_call(
    fp: int,
    ints: []int,
    nints: int,
    floats: []f64,
    nfloats: int,
    ret_float: int
): int;

extern wasm_native_set_callback(f: fn(k: int, a0: int, a1: int, a2: int, a3: int, a4: int): int): int;

extern wasm_trampoline(k: int): int;

// A native call abandoned from deeper native code (an uncaught exception's
// handler: a host calls wasm_native_abandon there): wasm_native_call
// returns 0 with this set, and the call becomes a trap.
extern wasm_native_abandon(): int;

extern wasm_abandoned(): int;

// A callback abandoned from a signal's handler: back to its native caller
// as if it had returned 0 (wasm_proxy_recover).
extern wasm_callback_abandon(): int;

extern wasm_callback_depth(): int;

extern wasm_native_depth(): int;

extern wasm_callback_native_depth(): int;

// Whether a native call the module made from the callback under way is
// under way (so wasm_native_abandon returns into that callback, not past
// it: main's own call, UIApplicationMain, is a native call too).
wasm_native_call_in_callback(): bool {
    wasm_callback_depth() > 0 && wasm_native_depth() > wasm_callback_native_depth()
}

extern wasm_memory_address(m: []i8): int = l8_as_int;

IK_INT: int = 0;

IK_FLOAT: int = 1;

IK_PTR: int = 2;

IK_FN: int = 3;

IK_COUNTED: int = 4;

extern native_load64(p: int, off: int): int = l8_load64;

extern native_copy(dst: int, src: int, n: int): int = l8_memcpy;

// ---- bindings ----
type ProxySymbol = {
    name: []i8;
    address: int;
    next: ?*ProxySymbol
}

proxy_symbols: ?*ProxySymbol = null;

// A native address for an import name (dlsym), 0 for none.
proxy_resolver: ?fn(name: str): int = null;

// Bind import name to a native function's address (an L8 function's, by
// `l8_as_int` of its value, or a library's).
proxy_bind(name: str, address: int) noregion {
    proxy_symbols = new ProxySymbol { name: bytes(name), address: address, next: proxy_symbols }
}

proxy_set_resolver(r: fn(name: str): int) {
    proxy_resolver = r
}

proxy_find(name: []i8): int {
    s: ?*ProxySymbol = proxy_symbols;
    while (s != null) {
        if (streq(s.name, name)) return s.address;
        s = s.next
    }
    0
}

// ---- the instance's imports ----
// (Room for 4096 imports of 16 parameters, filled in place: binding
// allocates nothing, so a callback may bind a reload's instance.)
PX_MAX: int = 4096;

PX_PARAMS: int = 16;

pi_address: []int = new int[4096](0);

pi_sys: []bool = new bool[4096](false);

pi_result: []int = new int[4096](0);

pi_kinds: []i8 = new i8[4096 * 16](0i8);

proxy_bound: int = 0 - 1;

proxy_base: int = 0;

proxy_max: int = 0;

proxy_ints: []int = new int[32](0);

proxy_floats: []f64 = new f64[16](0.0f64);

// The imports of the module's own runtime (web/README.md, "Host
// interface") that build values in its memory or keep the test protocol:
// never a native function's.
proxy_abi_import(name: []i8): bool {
    streq(name, "l8_argv") || streq(name, "l8_environment") || streq(name, "l8_heap_used") || streq(name,
        "l8_test_index") || streq(name, "l8_test_record") || streq(name, "l8_test_expect")
}

// The l8imports section: the kinds of import i's parameters and result,
// by its index, into the tables.
proxy_kinds(m: *WasmModule@new, i: int, nparams: int) raises WasmFormat {
    for k in 0..PX_PARAMS pi_kinds[i * PX_PARAMS + k] = IK_INT trunc i8;
    pi_result[i] = IK_INT;
    at: int = wasm_custom(m, "l8imports");
    if (at < 0) return;
    r: *WasmReader = new WasmReader { b: m.bytes, at: at, end: wasm_custom_end(m,
        "l8imports") };
    if (wr_uleb(r) != 2) return;
    n: int = wr_uleb(r);
    for _i in 0..n {
        index: int = wr_uleb(r);
        _iname: []i8 = wr_name(r);
        np: int = wr_uleb(r);
        same: bool = index == i && np == nparams;
        for k in 0..np {
            kind: int = wr_byte(r);
            if (same && k < PX_PARAMS) pi_kinds[i * PX_PARAMS + k] = kind trunc i8
        }
        res: int = wr_byte(r);
        if (same) {
            pi_result[i] = res;
            return
        }
    }
}

// Bind inst's imports: before it runs, and again for each instance that
// runs (a reload's). The standard imports are bound too, and callbacks go
// to inst.
wasm_proxy_bind(inst: *WasmInstance@new) raises WasmFormat {
    if (!proxy_callbacks_on) {
        _s: int = wasm_native_set_callback(&proxy_callback);
        proxy_callbacks_on = true
    }
    wasm_sys_bind(inst);
    proxy_current = instance_address(inst);
    m: *WasmModule = inst.m;
    n: int = len(m.imports);
    if (n > PX_MAX) wr_fail("too many imports for the proxy");
    for i in 0..n {
        name: []i8 = m.imports[i].name;
        np: int = len(m.sigs[m.imports[i].sig].params);
        // Registered functions first; the imports that are the module's
        // runtime's (they build values in its memory) go to the standard
        // host; everything else is native, as if the module were (the
        // resolver); what it does not find, the standard host may know.
        pi_address[i] = proxy_find(name);
        pi_sys[i] = false;
        if (pi_address[i] == 0 && proxy_abi_import(name)) pi_sys[i] = true else if (pi_address[i] == 0) {
            resolver: ?fn(name: str): int = proxy_resolver;
            if (resolver != null) {
                // As the native link binds it: the runtime's shim of the
                // name (l8rt_open translates Linux's flags, say) before
                // the platform's own.
                shim: []i8 = new i8[5 + len(name)](0i8);
                memcpy(shim, 0, bytes("l8rt_"), 0, 5);
                memcpy(shim, 5, name, 0, len(name));
                pi_address[i] = resolver(cstr(shim));
                if (pi_address[i] == 0) pi_address[i] = resolver(cstr(name))
            }
            if (pi_address[i] == 0 && wasm_sys_knows(inst, i)) pi_sys[i] = true
        }
        proxy_kinds(m, i, np)
    }
    proxy_base = wasm_memory_address(inst.mem8);
    proxy_max = len(inst.mem8);
    proxy_bound = inst.id
}

// ---- callbacks ----
// Trampoline k enters the function named tramp_names[k] of the instance
// callbacks go to (proxy_current): the same native address through a
// reload, since the name is what is kept.
// (Names in a pool, so no call allocates: a C callback may not.)
tramp_pool: []i8 = new i8[1024 * 128](0i8);

tramp_len: []int = new int[1024](0);

tramp_count: int = 0;

tramp_fidx: []int = new int[1024](0 - 1);

tramp_inst: []int = new int[1024](0 - 1);

tramp_inst_told: []int = new int[1024](0 - 1);

// The instance callbacks enter, as an address (so a callback may set it:
// a pointer in a global would need the allocation marked immortal).
proxy_current: int = 0;

extern instance_address(inst: *WasmInstance): int = l8_as_int;

extern instance_at(p: int): *WasmInstance = l8_as_int;

// The trampoline for the module's function value (a table index).
tramp_name_is(k: int, name: []i8): bool {
    if (tramp_len[k] != len(name)) return false;
    for i in 0..len(name) {
        if (tramp_pool[k * 128 + i] != name[i]) return false
    }
    true
}

proxy_trampoline_for(inst: *WasmInstance, ti: int): int {
    if (ti < 0 || ti >= len(inst.table)) return 0;
    f: int = inst.table[ti];
    name: []i8 = wasm_function_name(inst.m, f);
    for k in 0..tramp_count {
        if (tramp_name_is(k, name)) return wasm_trampoline(k)
    }
    if (tramp_count >= len(tramp_len) || len(name) > 127) {
        hook: ?fn(msg: str): int = wasm_on_trap;
        if (hook != null) _h: int = hook("no trampoline left for a function value");
        return 0
    }
    k2: int = tramp_count;
    for i in 0..len(name) tramp_pool[k2 * 128 + i] = name[i];
    tramp_len[k2] = len(name);
    tramp_count = tramp_count + 1;
    wasm_trampoline(k2)
}

proxy_callback(
    k: int,
    a0: int,
    a1: int,
    a2: int,
    a3: int,
    a4: int
): int {
    if (proxy_current == 0) return 0;
    inst: *WasmInstance = instance_at(proxy_current);
    if (tramp_inst[k] != inst.id) {
        m: *WasmModule = inst.m;
        ni: int = len(m.imports);
        tramp_fidx[k] = 0 - 1;
        for i in 0..len(m.funcs) {
            if (tramp_fidx[k] < 0 && tramp_name_is(k, m.funcs[i].name)) tramp_fidx[k] = ni + i
        }
        tramp_inst[k] = inst.id
    }
    f: int = tramp_fidx[k];
    if (f < 0) return 0;
    // (The first callbacks, told: which the platform calls, in what order,
    // and how long each takes.)
    // (Each callback the first time, and the first 400 calls.)
    telling: bool = proxy_told < 400 || tramp_inst_told[k] != inst.id;
    if (telling) tramp_inst_told[k] = inst.id;
    // The instance as it is at entry, for a recovery.
    d: int = cb_under_way;
    if (d < 64) {
        cb_k[d] = k;
        cb_frames[d] = inst.nframes;
        cb_sp[d] = inst.sp;
        cb_handlers[d] = inst.nhandlers;
        cb_depth[d] = inst.depth
    }
    cb_under_way = d + 1;
    t0: int = 0;
    if (telling) {
        proxy_told = proxy_told + 1;
        t0 = proxy_now();
        proxy_tell("callback ", k, 0)
    }
    // A pointer into the module's memory (an element qsort compares, say)
    // comes back as the module's address.
    args: []int = [proxy_unmap(a0), proxy_unmap(a1), proxy_unmap(a2), proxy_unmap(a3),
        proxy_unmap(a4)];
    np: int = 0;
    r: int = 0;
    try {
        sig: *WasmSig = wasm_sig_of(inst.m, f);
        np = len(sig.params);
        if (np > 5) np = 5;
        r = wasm_call(inst, f, args, np)
    } with WasmFormat _e -> {
        r = 0
    }
    cb_under_way = cb_under_way - 1;
    if (telling) proxy_tell("done in ms ", k, proxy_now() - t0);
    // A trap in a callback was told (wasm_on_trap), and which callback;
    // the next one runs, so that an app keeps going, as far as it can.
    if (inst.trapped) {
        inst.trapped = false;
        hook: ?fn(msg: str): int = wasm_on_trap;
        if (hook != null) {
            name: []i8 = new i8[tramp_len[k]](0i8);
            for i in 0..tramp_len[k] name[i] = tramp_pool[k * 128 + i];
            _h: int = hook(cstr(name))
        }
    }
    r
}

proxy_unmap(v: int): int {
    if (proxy_base != 0 && v >= proxy_base && v < proxy_base + proxy_max) v - proxy_base else v
}

// The callbacks under way: for each, its trampoline and the instance's
// frames, stack, handlers and depth at entry.
cb_under_way: int = 0;

cb_k: []int = new int[64](0);

cb_frames: []int = new int[64](0);

cb_sp: []int = new int[64](0);

cb_handlers: []int = new int[64](0);

cb_depth: []int = new int[64](0);

// From a signal's handler (a fault in the module's callback, or in
// native code it called): tell what and where, put the instance back as
// it was when the callback began, and abandon the callback, which returns
// 0 to its native caller. Does not return when a callback is under way;
// returns false when none is (the fault is the host's or main's).
wasm_proxy_recover(what: str): bool {
    d: int = cb_under_way;
    if (d <= 0 || d > 64 || proxy_current == 0 || wasm_callback_depth() <= 0) return false;
    inst: *WasmInstance = instance_at(proxy_current);
    hook: ?fn(msg: str): int = wasm_on_trap;
    if (hook != null) {
        _w: int = hook(what);
        proxy_tell("in callback ", cb_k[d - 1], 0);
        wasm_tell_frames(inst)
    }
    inst.nframes = cb_frames[d - 1];
    inst.sp = cb_sp[d - 1];
    inst.nhandlers = cb_handlers[d - 1];
    inst.depth = cb_depth[d - 1];
    inst.trapped = false;
    inst.exiting = false;
    cb_under_way = d - 1;
    _a: int = wasm_callback_abandon();
    false
}

proxy_callbacks_on: bool = false;

proxy_told: int = 0;

type ProxyTimespec = {
    sec: int;
    nsec: int
}

extern proxy_clock(clk: int, ts: *ProxyTimespec): int = clock_gettime;

// Milliseconds of the monotonic clock.
proxy_now(): int {
    ts: ProxyTimespec = ProxyTimespec { sec: 0, nsec: 0 };
    _r: int = proxy_clock(1, &ts);
    ts.sec * 1000 + ts.nsec / 1000000
}

// "LABEL NAME" or "LABEL NAME N" through the trap hook (a host's console).
proxy_tell(label: str, k: int, n: int) {
    hook: ?fn(msg: str): int = wasm_on_trap;
    if (hook == null) return;
    digits: []i8 = new i8[24](0i8);
    nd: int = 0;
    v: int = n;
    while (v > 0) {
        digits[nd] = ('0' as int + v % 10) trunc i8;
        v = v / 10;
        nd = nd + 1
    }
    told: []i8 = new i8[len(label) + tramp_len[k] + 1 + nd](0i8);
    p: int = 0;
    for c in label {
        told[p] = c;
        p = p + 1
    }
    for i in 0..tramp_len[k] {
        told[p] = tramp_pool[k * 128 + i];
        p = p + 1
    }
    if (nd > 0) {
        told[p] = ' ';
        p = p + 1;
        for i in 0..nd {
            told[p] = digits[nd - 1 - i];
            p = p + 1
        }
    }
    fit: []i8 = new i8[p](0i8);
    memcpy(fit, 0, told, 0, p);
    _h: int = hook(cstr(fit))
}

// ---- the host function ----
wasm_proxy_host(
    inst: *WasmInstance,
    imp: int,
    args: []int,
    n: int
): int {
    if (proxy_bound != inst.id) {
        wi_trap(inst, "the imports are not bound (wasm_proxy_bind)");
        return 0 - 38
    }
    if (pi_sys[imp]) return wasm_sys_host(inst, imp, args, n);
    address: int = pi_address[imp];
    if (address == 0) {
        wi_trap(inst, "an import no native function answers");
        return 0 - 38
    }
    sig: *WasmSig = inst.m.sigs[inst.m.imports[imp].sig];
    nints: int = 0;
    nfloats: int = 0;
    for i in 0..n {
        kind: int = if (i < PX_PARAMS) pi_kinds[imp * PX_PARAMS + i] as int else IK_INT;
        v: int = args[i];
        if (kind == IK_FLOAT) {
            if (nfloats < 8) proxy_floats[nfloats] = l8_bits_f64(v);
            nfloats = nfloats + 1
        } else {
            if ((kind == IK_PTR || kind == IK_COUNTED) && v > 0 && v < proxy_max) v = proxy_base + v;
            if (kind == IK_FN) v = proxy_trampoline_for(inst, v & M32);
            if (nints < len(proxy_ints)) proxy_ints[nints] = v;
            nints = nints + 1
        }
    }
    ret_float: int = if (pi_result[imp] == IK_FLOAT) 1 else 0;
    r: int = wasm_native_call(address, proxy_ints, nints, proxy_floats, nfloats, ret_float);
    if (wasm_abandoned() != 0) {
        iname: []i8 = inst.m.imports[imp].name;
        told: []i8 = new i8[25 + len(iname)](0i8);
        memcpy(told, 0, bytes("native call abandoned in "), 0, 25);
        memcpy(told, 25, iname, 0, len(iname));
        hook: ?fn(msg: str): int = wasm_on_trap;
        if (hook != null) _h: int = hook(cstr(told));
        wi_trap(inst, "native call abandoned");
        return 0
    }
    if (ret_float == 1 && len(sig.results) > 0 && sig.results[0] as int == WT_F32) r = r & M32;
    // A pointer the native code returns: into the module's memory, the
    // module's address of it; a counted one elsewhere (a mapped file, a
    // string of the platform's), copied in, since the module addresses
    // only its own memory.
    rk: int = pi_result[imp];
    if ((rk == IK_PTR || rk == IK_COUNTED) && r != 0) {
        if (r >= proxy_base && r < proxy_base + proxy_max) r = r - proxy_base else if (rk == IK_COUNTED) {
            cnt: int = native_load64(r, 0 - 8);
            if (cnt >= 0 && cnt < 1073741824) {
                np: int = wasm_alloc(inst, 8 + cnt + 1);
                if (np != 0) {
                    wi_store64(inst, np, cnt);
                    _c: int = native_copy(proxy_base + np + 8, r, cnt);
                    inst.mem8[np + 8 + cnt] = 0i8;
                    r = np + 8
                }
            }
        }
    }
    r
}
