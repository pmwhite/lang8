tag wasm_proxy_test;

use_tag std, wasm;

// The proxy check: proxy_mod.l8 run with its imports bound to the
// functions below, as a native host binds a module's imports to the
// platform's. Its output is proxy.expected.
//   wasm-proxytest proxy_mod.wasm
import "../proxy.l8";

extern addr_ii(f: fn(a: int, b: int): int): int = l8_as_int;

extern addr_fi(f: fn(x: f64, k: int): f64): int = l8_as_int;

extern addr_f32(f: fn(x: f32): f32): int = l8_as_int;

extern addr_s(f: fn(s: int): int): int = l8_as_int;

extern addr_fill(f: fn(b: int, n: int, c: i8): int): int = l8_as_int;

// A module's str or []i8, made native by the proxy, as what it is.
extern as_str(p: int): str = l8_as_int;

extern as_bytes(p: int): []i8 = l8_as_int;

extern addr_apply(f: fn(cb: fn(x: int): int, v: int): int): int = l8_as_int;

extern addr_0(f: fn(): int): int = l8_as_int;

// As an uncaught native exception's handler would: the call abandoned.
px_fail(): int {
    _a: int = wasm_native_abandon();
    99
}

// A fault in native code: a read of address 8.
extern native_load(p: int, off: int): int = l8_load64;

px_crash(): int {
    native_load(8, 0)
}

// SIGSEGV's handler: the callback under way abandoned (Linux: the raw
// rt_sigaction, as a static program has no libc; the kernel's struct is
// the handler, flags, restorer and mask, SA_NODEFER so the signal is not
// blocked after the handler is left).
extern raw_syscall(
    nr: int,
    a: int,
    b: int,
    c: int,
    d: int
): int = syscall;

extern addr_handler(f: fn(sig: int): int): int = l8_as_int;

extern ints_at(a: []int): int = l8_as_int;

on_signal(sig: int): int {
    if (!wasm_proxy_recover("fault: a signal in native code")) {
        try {
            write(1, "fault with no callback to abandon\n")
        } with IoError _e -> { }
    }
    0
}

catch_faults() {
    // (SA_NODEFER | SA_RESTORER: x86-64's kernel delivers no signal without
    // a restorer; it is never returned to.)
    act: []int = [addr_handler(&on_signal), 1073741824 + 67108864, addr_handler(&on_signal),
        0];
    _r: int = raw_syscall(13, 11, ints_at(act), 0, 8)
}

trap_said(msg: str): int {
    try {
        write(1, "trap: ");
        line: []i8 = bytes(msg);
        count: int = len(line);
        // Callback duration depends on scheduling, not the proxy contract.
        prefix: str = "done in ms ";
        duration: bool = count >= len(prefix);
        if (duration) {
            for index in 0..len(prefix) {
                if (line[index] != prefix[index]) duration = false
            }
        }
        if (duration) {
            end: int = count;
            while (end > len(prefix) && line[end - 1] >= '0' && line[end - 1] <= '9') end = end - 1;
            if (end < count && line[end - 1] == ' ') count = end - 1
        }
        write_bytes_n(1, line, count);
        write(1, "\n")
    } with IoError _e -> { }
    0
}

extern addr_many(f: fn(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int): int = l8_as_int;

px_add(a: int, b: int): int {
    a + b
}

px_scale(x: f64, k: int): f64 {
    x * k as f64
}

px_half(x: f32): f32 {
    x / 2.0
}

px_len(s: int): int {
    len(as_str(s))
}

px_fill(bp: int, n: int, c: i8): int {
    b: []i8 = as_bytes(bp);
    k: int = if (n > len(b)) len(b) else n;
    for i in 0..k b[i] = c;
    k
}

extern addr_apply6(f: fn(cb: fn(a: int, b: int, c: int, d: int, e: int, f: int): int): int): int = l8_as_int;

px_apply6(cb: fn(a: int, b: int, c: int, d: int, e: int, f: int): int): int {
    cb(1, 2, 3, 4, 5, 6)
}

px_apply(cb: fn(x: int): int, v: int): int {
    cb(v) + 1
}

px_many(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    a + 10 * b + 100 * c + 1000 * d + 10000 * e + 100000 * f + 1000000 * g + 10000000 * h
}

active: ?owned *WasmInstance = null;

dispatch(index: int, args: []int, native_scope: int): int {
    borrow active {
        return proxy_callback_instance(active, index, args, native_scope)
    }
}

extern proxy_test_arena_live(): int = l8_arena_live;

check_binding_failure(path: str) raises WasmFormat, WasmNoMemory {
    previous: int = proxy_current;
    bound: int = proxy_bound;
    address: int = pi_address[0];
    candidate: owned *WasmInstance = own {
        wasm_instantiate(wasm_decode(wasm_read_file(path)), 64, &wasm_proxy_host)
    };
    borrow candidate {
        at: int = wasm_custom(candidate.m, "l8imports");
        if (at < 0) wr_fail("proxy fixture has no native import metadata");
        candidate.m.bytes[at] = 0i8;
        rejected: bool = false;
        try {
            wasm_proxy_bind(candidate)
        } with WasmFormat _error -> {
            rejected = true
        }
        if (!rejected) wr_fail("invalid native metadata was accepted")
    }
    drop candidate;
    if (proxy_current != previous || proxy_bound != bound || pi_address[0] != address) wr_fail("failed binding replaced the active instance")
}

main(argc: int, argv: []str) noregion raises IoError: int {
    if (argc < 2) {
        eprint("usage: wasm-proxytest proxy_mod.wasm");
        return 2
    }
    proxy_bind("px_add", addr_ii(&px_add));
    proxy_bind("px_scale", addr_fi(&px_scale));
    proxy_bind("px_half", addr_f32(&px_half));
    proxy_bind("px_len", addr_s(&px_len));
    proxy_bind("px_fill", addr_fill(&px_fill));
    proxy_bind("px_apply", addr_apply(&px_apply));
    proxy_bind("px_many", addr_many(&px_many));
    proxy_bind("px_fail", addr_0(&px_fail));
    proxy_bind("px_apply6", addr_apply6(&px_apply6));
    proxy_bind("px_crash", addr_0(&px_crash));
    catch_faults();
    wasm_on_trap = &trap_said;
    args: []str = new str[1]("proxy");
    sys_set_args(args);
    try {
        drop active;
        active = own {
            wasm_instantiate(wasm_decode(wasm_read_file(argv[1])), 64, &wasm_proxy_host)
        };
        proxy_callback_dispatch = &dispatch;
        status: int = 0;
        borrow active {
            wasm_proxy_bind(active);
            check_binding_failure(argv[1]);
            status = wasm_start(active);
            if (wasm_trapped(active)) {
                write(1, "ended by a trap: ");
                write(1, wasm_trap_message(active));
                write(1, "\n");
                status = 0
            }
        }
        drop active;
        if (proxy_test_arena_live() != 0) wr_fail("callback recovery retained an arena");
        status
    } with WasmFormat e -> {
        write(2, "proxytest: ");
        write(2, e.msg);
        write(2, "\n");
        2
    } with WasmNoMemory -> {
        eprint("proxytest: no memory");
        2
    }
}
