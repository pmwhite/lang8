tag proxy_test_module;

use_tag std;

// A module whose imports the proxy host (proxy.l8) answers with native L8
// functions (tests/proxy.l8): numbers, floats of both widths, a string
// and a buffer the native side reads and writes, and a function value the
// native side calls back.
import "../../../stdlib/print.l8";

extern px_add(a: int, b: int): int;

extern px_scale(x: f64, k: int): f64;

extern px_half(x: f32): f32;

extern px_len(s: str): int;

extern px_fill(b: []i8, n: int, c: i8): int;

extern px_apply(cb: fn(x: int): int, v: int): int;

// A callback of six arguments (an Objective-C method of four), called
// twice: each call must leave the interpreter's stack as it found it.
extern px_apply6(cb: fn(a: int, b: int, c: int, d: int, e: int, f: int): int): int;

six(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int
): int {
    a + 10 * b + 100 * c + 1000 * d + 10000 * e + 100000 * f
}

// Native code that fails (an exception the host turns into a trap).
extern px_fail(): int;

// Native code that faults (a signal the host recovers from, by abandoning
// the callback it happens in).
extern px_crash(): int;

crashy(x: int): int {
    px_crash() + x
}

extern px_many(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int
): int;

triple(x: int): int {
    x * 3
}

main() raises IoError: int {
    write(1, "add: ");
    print_int(px_add(40, 2));
    write(1, "scale x100: ");
    print_int((px_scale(1.25f64, 4) * 100.0f64) as int);
    write(1, "half x100: ");
    print_int((px_half(5.0) * 100.0) as int);
    write(1, "len: ");
    print_int(px_len("seventeen letters"));
    // Keep a frame-backed argument live through the following native callbacks.
    b: []i8 = buffer([5]i8, 0i8);
    write(1, "fill: ");
    print_int(px_fill(b, 9, 'z'));
    print(cstr(b));
    write(1, "apply: ");
    print_int(px_apply(&triple, 14));
    write(1, "many: ");
    print_int(px_many(1, 2, 3, 4, 5, 6, 7, 8));
    write(1, "six arguments: ");
    print_int(px_apply6(&six));
    write(1, "six arguments again: ");
    print_int(px_apply6(&six));
    write(1, "crash in a callback: ");
    print_int(px_apply(&crashy, 5));
    write(1, "fail: ");
    print_int(px_fail());
    print("not reached");
    0
}
