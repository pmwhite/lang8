tag wasm;

// Four decoded modules. Byte vectors and decoded instructions have a 64 MiB
// budget per module; records have separate typed slots with layout guards.
type WmByteStorage = {
    count: int;
    data: [67108864]i8
}

wm_bytes: []WmByteStorage = static_buffer([4]WmByteStorage);

wm_byte_used: []int = static_buffer([4]int);

wm_used: []bool = static_buffer([4]bool);

wm_module_objects: []i8 = static_buffer([1024]i8);

type WmEmpty = {
    count: int;
    data: [8]i8
}

wm_empty: WmEmpty = WmEmpty { count: 0, data: zeroed([8]i8) };

extern wm_int_at(p: *i8): *int = l8_as_int;

extern wm_bytes_at(p: *i8): []i8 = l8_as_int;

extern wm_ints_at(p: *i8): []int = l8_as_int;

extern wm_module_at(p: *i8): *WasmModule = l8_as_int;

extern wm_readonly_bytes(s: str): []i8 = l8_as_int;

wm_take(slot: int, bytes: int, count: int) raises WasmFormat: *i8 {
    if (slot < 0 || slot >= 4 || !wm_used[slot] || bytes < 0 || count < 0 || bytes > 67108848) wr_fail("module static storage exhausted");
    if (count == 0) return &wm_empty.data[0];
    span: int = 8 + (bytes + 7) / 8 * 8;
    used: int = wm_byte_used[slot];
    if (span > 67108864 - used) wr_fail("module static storage exhausted");
    wm_byte_used[slot] = used + span;
    wm_int_at(&wm_bytes[slot].data[used]).* = count;
    &wm_bytes[slot].data[used + 8]
}

wm_take_bytes(slot: int, n: int) raises WasmFormat: []i8 {
    wm_bytes_at(wm_take(slot, n, n))
}

wm_take_ints(slot: int, n: int) raises WasmFormat: []int {
    if (n < 0 || n > 8388606) wr_fail("module integer storage exhausted");
    wm_ints_at(wm_take(slot, n * 8, n))
}

wm_sig_objects: []i8 = static_buffer([2097152]i8);

wm_sig_used: []int = static_buffer([4]int);

extern wm_sig_at(p: *i8): *WasmSig = l8_as_int;

extern wm_sig_pointers_at(p: *i8): []*WasmSig = l8_as_int;

wm_sig_pointers(slot: int, n: int) raises WasmFormat: []*WasmSig {
    if (n < 0 || n > 16384) wr_fail("module sig limit exceeded");
    wm_sig_pointers_at(wm_take(slot, n * 8, n))
}

wm_take_sig(slot: int, value: WasmSig) raises WasmFormat: *WasmSig {
    used: int = wm_sig_used[slot];
    if (used >= 16384 || sizeof(WasmSig) > 32) wr_fail("module sig storage exhausted");
    wm_sig_used[slot] = used + 1;
    out: *WasmSig = wm_sig_at(&wm_sig_objects[(slot * 16384 + used) * 32]);
    out.* = value;
    out
}

wm_import_objects: []i8 = static_buffer([524288]i8);

wm_import_used: []int = static_buffer([4]int);

extern wm_import_at(p: *i8): *WasmImport = l8_as_int;

extern wm_import_pointers_at(p: *i8): []*WasmImport = l8_as_int;

wm_import_pointers(slot: int, n: int) raises WasmFormat: []*WasmImport {
    if (n < 0 || n > 4096) wr_fail("module import limit exceeded");
    wm_import_pointers_at(wm_take(slot, n * 8, n))
}

wm_take_import(slot: int, value: WasmImport) raises WasmFormat: *WasmImport {
    used: int = wm_import_used[slot];
    if (used >= 4096 || sizeof(WasmImport) > 32) wr_fail("module import storage exhausted");
    wm_import_used[slot] = used + 1;
    out: *WasmImport = wm_import_at(&wm_import_objects[(slot * 4096 + used) * 32]);
    out.* = value;
    out
}

wm_func_objects: []i8 = static_buffer([2097152]i8);

wm_func_used: []int = static_buffer([4]int);

extern wm_func_at(p: *i8): *WasmFunc = l8_as_int;

extern wm_func_pointers_at(p: *i8): []*WasmFunc = l8_as_int;

wm_func_pointers(slot: int, n: int) raises WasmFormat: []*WasmFunc {
    if (n < 0 || n > 8192) wr_fail("module func limit exceeded");
    wm_func_pointers_at(wm_take(slot, n * 8, n))
}

wm_take_func(slot: int, value: WasmFunc) raises WasmFormat: *WasmFunc {
    used: int = wm_func_used[slot];
    if (used >= 8192 || sizeof(WasmFunc) > 64) wr_fail("module func storage exhausted");
    wm_func_used[slot] = used + 1;
    out: *WasmFunc = wm_func_at(&wm_func_objects[(slot * 8192 + used) * 64]);
    out.* = value;
    out
}

wm_export_objects: []i8 = static_buffer([1048576]i8);

wm_export_used: []int = static_buffer([4]int);

extern wm_export_at(p: *i8): *WasmExport = l8_as_int;

extern wm_export_pointers_at(p: *i8): []*WasmExport = l8_as_int;

wm_export_pointers(slot: int, n: int) raises WasmFormat: []*WasmExport {
    if (n < 0 || n > 8192) wr_fail("module export limit exceeded");
    wm_export_pointers_at(wm_take(slot, n * 8, n))
}

wm_take_export(slot: int, value: WasmExport) raises WasmFormat: *WasmExport {
    used: int = wm_export_used[slot];
    if (used >= 8192 || sizeof(WasmExport) > 32) wr_fail("module export storage exhausted");
    wm_export_used[slot] = used + 1;
    out: *WasmExport = wm_export_at(&wm_export_objects[(slot * 8192 + used) * 32]);
    out.* = value;
    out
}

wm_custom_objects: []i8 = static_buffer([32768]i8);

wm_custom_used: []int = static_buffer([4]int);

extern wm_custom_at(p: *i8): *WasmCustom = l8_as_int;

extern wm_custom_pointers_at(p: *i8): []*WasmCustom = l8_as_int;

wm_custom_pointers(slot: int, n: int) raises WasmFormat: []*WasmCustom {
    if (n < 0 || n > 256) wr_fail("module custom limit exceeded");
    wm_custom_pointers_at(wm_take(slot, n * 8, n))
}

wm_take_custom(slot: int, value: WasmCustom) raises WasmFormat: *WasmCustom {
    used: int = wm_custom_used[slot];
    if (used >= 256 || sizeof(WasmCustom) > 32) wr_fail("module custom storage exhausted");
    wm_custom_used[slot] = used + 1;
    out: *WasmCustom = wm_custom_at(&wm_custom_objects[(slot * 256 + used) * 32]);
    out.* = value;
    out
}

wm_reserve() raises WasmFormat: int {
    slot: int = 0;
    while (slot < 4 && wm_used[slot]) slot = slot + 1;
    if (slot == 4 || sizeof(WasmModule) > 256) wr_fail("module slots exhausted");
    wm_used[slot] = true;
    wm_byte_used[slot] = 0;
    wm_sig_used[slot] = 0;
    wm_import_used[slot] = 0;
    wm_func_used[slot] = 0;
    wm_export_used[slot] = 0;
    wm_custom_used[slot] = 0;
    slot
}

wasm_module_release(m: *WasmModule) raises WasmFormat {
    slot: int = m.storage_slot;
    if (slot < 0 || slot >= 4 || !wm_used[slot] || m.instances != 0) wr_fail("cannot release a module with live instances");
    wm_used[slot] = false;
    m.storage_slot = -1
}
