tag wasm_run;

use_tag std, wasm;

// Run a module from `l8 wasm` natively, in the interpreter:
//   wasmrun module.wasm [args...]
// as `node web/run.mjs` does under Node: the module's arguments are its
// own, its descriptors the process's, so `l8 test --wasm --runner
// .build/wasmrun` runs the tests here. The exit status is the module's.
import "sys.l8";

extern exit(code: int): noreturn;

env_has(name: str): bool {
    for e in l8_environment() {
        if (len(e) > len(name) && e[len(name)] == '=') {
            same: bool = true;
            for i in 0..len(name) {
                if (e[i] != name[i]) same = false
            }
            if (same) return true
        }
    }
    false
}

main(argc: int, argv: []str@new) noregion raises IoError: int {
    if (argc < 2) {
        eprint("usage: wasmrun module.wasm [args...]");
        return 2
    }
    bytes: []i8 = wasm_read_file(argv[1]);
    if (len(bytes) == 0) {
        eprint("wasmrun: cannot read the module");
        return 2
    }
    args: []str = new str[argc - 1]("");
    for i in 1..argc args[i - 1] = argv[i];
    sys_set_args(args);
    wi_trace = env_has("WASMTRACE");
    try {
        m: *WasmModule = wasm_decode(bytes);
        inst: *WasmInstance = wasm_instantiate(m, 1024, &wasm_sys_host);
        status: int = wasm_start(inst);
        if (wasm_trapped(inst)) {
            write(2, "wasmrun: trap: ");
            write(2, wasm_trap_message(inst));
            write(2, "\n");
            return 1
        }
        status
    } with WasmFormat e -> {
        write(2, "wasmrun: ");
        write(2, e.msg);
        write(2, "\n");
        2
    } with WasmNoMemory -> {
        eprint("wasmrun: cannot map the module's memory");
        2
    }
}
