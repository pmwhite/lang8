tag wasm;

// Instance execution arrays have three independent, reusable owners. Module
// metadata and decoded code have a separate lifetime from these call stacks.
type WiInstanceStorage = {
    globals_count: int;
    globals_data: [65536]int;
    table_count: int;
    table_data: [65536]int;
    vals_count: int;
    vals_data: [1048576]int;
    frames_count: int;
    frames_data: [393216]int;
    handlers_count: int;
    handlers_data: [32768]int;
    args_count: int;
    args_data: [64]int
}

wi_instance_storage: []WiInstanceStorage = static_buffer([3]WiInstanceStorage);

wi_instance_objects: []i8 = static_buffer([768]i8);

wi_instance_used: []bool = static_buffer([3]bool);

extern wi_instance_at(p: *i8): *WasmInstance = l8_as_int;

extern wi_counted_ints(p: *int): []int = l8_as_int;

extern wasm_mem_release(mem: []i8, used: int): int;

wi_instance_reserve(): int {
    slot: int = 0;
    while (slot < 3 && wi_instance_used[slot]) slot = slot + 1;
    if (slot == 3 || sizeof(WasmInstance) > 256) return -1;
    wi_instance_used[slot] = true;
    wi_instance_storage[slot].globals_count = 65536;
    for k in 0..65536 wi_instance_storage[slot].globals_data[k] = 0;
    wi_instance_storage[slot].table_count = 65536;
    for k in 0..65536 wi_instance_storage[slot].table_data[k] = 0;
    wi_instance_storage[slot].vals_count = 1048576;
    for k in 0..1048576 wi_instance_storage[slot].vals_data[k] = 0;
    wi_instance_storage[slot].frames_count = 393216;
    for k in 0..393216 wi_instance_storage[slot].frames_data[k] = 0;
    wi_instance_storage[slot].handlers_count = 32768;
    for k in 0..32768 wi_instance_storage[slot].handlers_data[k] = 0;
    wi_instance_storage[slot].args_count = 64;
    for k in 0..64 wi_instance_storage[slot].args_data[k] = 0;
    slot
}

// All calls and host-held views must end before releasing an instance.
// Pointers to the instance and its arrays expire here; module data is retained.
wasm_instance_release(inst: *WasmInstance) raises WasmFormat {
    if (inst.id == 0 || inst.depth != 0) wr_fail("cannot release an active or expired instance");
    _r: int = wasm_mem_release(inst.mem8, inst.pages * 65536);
    wi_instance_used[inst.storage_slot] = false;
    inst.id = 0
}
