tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

const TEST_JOURNAL_STRIDE: int = 9 + 3 * REWIND_MAX + 3;

type TestJournalOrder = {
    action: int;
    base: int;
    previous: ?*TestJournalOrder
} invariant (0 <= action && action < 700 && 0 <= base && base <= 553608)

test_journal_count(offset: int): int requires (0 <= offset && offset < 8192) ensures (1 <= returned && returned <= REWIND_MAX) {
    remainder: int = offset % REWIND_MAX;
    remainder + 1
}

check(ok: bool, message: []i8) raises IoError {
    if (!ok) die(message)
}

// Compare the compressed log with independent full snapshots. A small ring
// forces eviction and physical wrap; pops and cancelled attempts test branches.
test_journal() raises IoError, UndoHistoryExhausted, IndexOutOfBounds {
    home: []int = [0, 0, 1];
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    widths[0] = 2;
    widths[1] = 1;
    u: *UndoTimeline = new_undo_journal(home, 3, widths, 1600);
    blocks: []Block = new Block[3](Block {
        id: 0,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    });
    live: []int = new int[384](0);
    counts: []int = new int[LEVEL_MAX_ROOMS](1);
    cursors: []int = new int[LEVEL_MAX_ROOMS](0);
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    expected: []int = new int[700 * 2 * TEST_JOURNAL_STRIDE](0);
    order: []TestJournalOrder = new TestJournalOrder[700](TestJournalOrder { action: 0, base: 0, previous: null });
    restored: []int = new int[3 * REWIND_MAX](0);
    rc: []int = new int[LEVEL_MAX_ROOMS](0);
    rp: []int = new int[LEVEL_MAX_ROOMS](0);
    rg: []int = new int[LEVEL_MAX_ROOMS](0);
    latest: ?*TestJournalOrder = null;
    stable: int = l8_heap_used();
    wrapped: bool = false;
    evicted: bool = false;
    for action in 0..700 {
        prior: int = u.count;
        for phase in 0..2 {
            steps0: int = test_journal_count(action * 7 + phase);
            steps1: int = test_journal_count(action * 3 + phase);
            counts[0] = steps0;
            counts[1] = steps1;
            cursors[0] = counts[0] - 1;
            cursors[1] = action % counts[1];
            ghost[1] = action % 3;
            check(widths[0] == 2 && widths[1] == 1, "journal fixture widths");
            for s in 0..steps0 {
                for k in 0..2 {
                    slot: int = s * 3 + k;
                    check(slot == rewind_slot(0, s, k, widths, 3), "first journal room layout");
                    live[slot] = pack_pos(action + s, k + phase, action % 8, phase)
                }
            }
            for s in 0..steps1 {
                slot: int = s * 3 + 2;
                check(slot == rewind_slot(1, s, 0, widths, 3), "second journal room layout");
                live[slot] = pack_pos(action + s, 1 + phase, action % 8, phase)
            }
            blocks[0].column = action;
            blocks[2].row = phase;
            undo_save_history(u, phase != 0, 3, widths, live, counts, cursors, ghost,
                blocks, 3, pack_pos(action, -3, 2, 1));
            if (phase == 0) {
                undo_depend(u, 0);
                undo_depend(u, 63)
            }
            base: int = (action * 2 + phase) * TEST_JOURNAL_STRIDE;
            for r in 0..3 {
                expected[base + r * 3] = counts[r];
                expected[base + r * 3 + 1] = cursors[r];
                expected[base + r * 3 + 2] = ghost[r]
            }
            for i in 0..len(live) expected[base + 9 + i] = live[i];
            for i in 0..3 expected[base + 9 + len(live) + i] = pack_pos(blocks[i].column,
                blocks[i].row, blocks[i].layer, blocks[i].mounted)
        }
        order[action] = TestJournalOrder { action: action, base: action * 2 * TEST_JOURNAL_STRIDE, previous: latest };
        latest = &order[action];
        if (u.count < prior + 1) evicted = true;
        if (u.head > len(u.journal)) wrapped = true;
        check(u.count > 0, "newest action must survive byte pressure");
        // Test reversible phase changes and room restoration for the newest
        // action, and periodically pop several retained actions in sequence.
        pops: int = 0;
        if (action % 5 == 4) pops = 2;
        for attempt in 0..pops + 1 {
            if (u.count > 0) {
                if (latest == null) die("journal action has no test snapshot");
                entry: TestJournalOrder = latest.*;
                retained: int = entry.action;
                record: int = undo_latest(u);
                check(undo_read(u, record + 2) == pack_pos(retained, -3, 2, 1), "packed player pose");
                undo_prepare_action(u, LEVEL_MAX_ROOMS, 3);
                check(u.selected[0] == 1 && u.selected[63] == 1 && u.selected[62] == 0,
                    "64-bit room dependency mask");
                for phase in 0..2 {
                    data: []int = undo_load_history(u, record, phase);
                    base: int = entry.base + phase * TEST_JOURNAL_STRIDE;
                    for r in 0..3 {
                        off: int = u.offsets[r];
                        check(u.metas[r].count.* == expected[base + r * 3], "count reconstruction");
                        check(u.metas[r].cursor.* == expected[base + r * 3 + 1], "cursor reconstruction");
                        check(u.metas[r].ghost.* == expected[base + r * 3 + 2], "ghost reconstruction");
                        steps: int = u.metas[r].count.*;
                        if (steps < 0 || steps > REWIND_MAX) die("invalid reconstructed frame count");
                        if (r == 0) {
                            check(off == 0 && widths[r] == 2, "first journal room layout");
                            for s in 0..steps {
                                for k in 0..2 check(data[3 + s * 2 + k] == expected[base + 9 + s * 3 + k],
                                    "branch frame reconstruction")
                            }
                        } else if (r == 1) {
                            check(off == 3 + 2 * REWIND_MAX && widths[r] == 1, "second journal room layout");
                            for s in 0..steps check(data[6 + 2 * REWIND_MAX + s] == expected[base + 9 + s * 3 + 2],
                                "branch frame reconstruction")
                        } else check(widths[r] == 0, "empty journal room layout")
                    }
                    for i in 0..3 check(u.image[u.block_base + i] == expected[base + 9 + len(live) + i],
                        "block pose reconstruction")
                }
                undo_restore_history(u, record, 1, widths, restored, rc, rp, rg);
                base: int = entry.base;
                check(rc[1] == expected[base + 3] && rp[1] == expected[base + 4] && rg[1] == expected[base + 5],
                    "restore metadata");
                restored_seen: int = 0;
                for i in 0..len(restored) {
                    if (i % 3 == 2 && i / 3 < rc[1]) {
                        s: int = i / 3;
                        check(i == rewind_slot(1, s, 0, widths, 3), "restore fixture layout");
                        check(restored[i] == expected[base + 9 + i], "restore room frames");
                        restored_seen = restored_seen + 1
                    }
                }
                check(restored_seen == rc[1], "restore frame count");
                if (attempt < pops) {
                    undo_pop_action(u);
                    latest = entry.previous
                } else u.undoing = false
            }
        }
        if (action % 13 == 12) {
            head: int = u.head;
            tail: int = u.tail;
            count: int = u.count;
            counts[0] = REWIND_MAX;
            counts[1] = REWIND_MAX;
            for i in 0..len(live) live[i] = pack_pos(-1000, action, 0, 0);
            undo_save_history(u, false, 3, widths, live, counts, cursors, ghost, blocks,
                3, 0);
            undo_cancel_action(u);
            check(u.head == head && u.tail == tail && u.count == count, "failed move evicted history under byte pressure")
        }
        check(l8_heap_used() == stable, "journal allocated after startup")
    }
    check(evicted && wrapped, "test did not exercise journal eviction and wrap");
    undo_clear_journal(u);
    check(u.head == 0 && u.tail == 0 && u.count == 0, "clear journal");
    for action in 0..1000 {
        undo_save_history(u, false, 3, widths, live, counts, cursors, ghost, blocks,
            3, action);
        undo_save_history(u, true, 3, widths, live, counts, cursors, ghost, blocks,
            3, action);
        if (action > 0) check(undo_read(u, undo_latest(u)) == UNDO_ACTION_OVERHEAD,
            "unchanged action wrote redundant diffs")
    }
    check(u.count == len(u.journal) / UNDO_ACTION_OVERHEAD, "walking byte-budget capacity");
    check(l8_heap_used() == stable, "unchanged saves allocated")
}

type UndoGame = {
    level: *LevelState;
    u: *UndoTimeline;
    widths: []int;
    ids: *RoomBlockIds;
    live: []int;
    counts: []int;
    cursors: []int;
    ghost: []int;
    hist: []Block;
    hpc: []int;
    hpr: []int;
    hph: []int;
    hpm: []int;
    hms: []int;
    clock: []int;
    pose: []int;
    pend: []int;
    scratch: []int;
    crate_pose: []int;
    crate_ms: []int;
    crate_cursor: *CrateCursor;
    crate_t0: []int;
    solved: []int;
    stream_until: []int;
    stream_tx: []f32;
    stream_tz: []f32;
    sparks: []Spark;
    rng: []int
} invariant (len(pose) == 4 && len(hpc) == 8 && len(hpr) == 8 && len(hph) == 8 && len(hpm) == 8 && len(hms) == 8 && len(clock) == 3 && len(pend) == 2 && len(counts) == LEVEL_MAX_ROOMS && len(cursors) == LEVEL_MAX_ROOMS && len(ghost) == LEVEL_MAX_ROOMS && len(live) == LEVEL_MAX_BLOCKS * REWIND_MAX && len(hist) == 8 * LEVEL_MAX_BLOCKS && len(widths) == LEVEL_MAX_ROOMS && len(scratch) == LEVEL_MAX_BLOCKS && len(crate_pose) == LEVEL_MAX_BLOCKS * CRATE_HIST && len(crate_ms) == LEVEL_MAX_BLOCKS * CRATE_HIST && len(crate_t0) == LEVEL_MAX_BLOCKS && len(rng) == 1 && len(solved) == LEVEL_MAX_ROOMS && len(stream_until) == LEVEL_MAX_ROOMS && len(stream_tx) == LEVEL_MAX_ROOMS && len(stream_tz) == LEVEL_MAX_ROOMS)

new_undo_game() raises IoError, IndexOutOfBounds: *UndoGame@new {
    l: *LevelState = new_level_state();
    level_set_room_count(l, 2);
    l.rooms[0] = Room {
        x0: 0,
        y0: 0,
        x1: 2,
        y1: 2
    };
    l.rooms[1] = Room {
        x0: 10,
        y0: 0,
        x1: 13,
        y1: 3
    };
    level_set_block_count(l, 3);
    l.blocks[0] = Block {
        id: 0,
        column: 1,
        row: 0,
        shape: 1,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    l.blocks[1] = Block {
        id: 1,
        column: 1,
        row: 1,
        shape: 1,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    l.blocks[2] = Block {
        id: 2,
        column: 11,
        row: 1,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    ids: *RoomBlockIds = new_room_block_ids();
    assign_block_homes(l.blocks, l.nblocks, l.rooms, l.nrooms, home, ids, widths);
    g: *UndoGame = new UndoGame {
        level: l,
        u: new_undo_timeline(home, l.nblocks, widths),
        widths: widths,
        ids: ids,
        live: new int[LEVEL_MAX_BLOCKS * REWIND_MAX](0),
        counts: new int[LEVEL_MAX_ROOMS](1),
        cursors: new int[LEVEL_MAX_ROOMS](0),
        ghost: new int[LEVEL_MAX_ROOMS](0),
        hist: new Block[8 * LEVEL_MAX_BLOCKS](l.blocks[0]),
        hpc: new int[8](0),
        hpr: new int[8](0),
        hph: new int[8](0),
        hpm: new int[8](0),
        hms: new int[8](200),
        clock: new int[3](0),
        pose: new int[4](0),
        pend: new int[2](0),
        scratch: new int[LEVEL_MAX_BLOCKS](0),
        crate_pose: new int[LEVEL_MAX_BLOCKS * CRATE_HIST](0),
        crate_ms: new int[LEVEL_MAX_BLOCKS * CRATE_HIST](0),
        crate_cursor: new_crate_cursor(),
        crate_t0: new int[LEVEL_MAX_BLOCKS](0),
        solved: new int[LEVEL_MAX_ROOMS](0),
        stream_until: new int[LEVEL_MAX_ROOMS](0),
        stream_tx: new f32[LEVEL_MAX_ROOMS](0.0),
        stream_tz: new f32[LEVEL_MAX_ROOMS](0.0),
        sparks: new Spark[SPARK_N](Spark {
            x: 0.0,
            y: 0.0,
            z: 0.0,
            vx: 0.0,
            vy: 0.0,
            vz: 0.0,
            life: 0.0,
            kind: 0,
            room: 0,
            blue: 0.0
        }),
        rng: new int[1](1)
    };
    for r in 0..l.nrooms rewind_capture(l.blocks, r, ids, widths, g.live, 0);
    settle_test_game(g);
    g
}

settle_test_game(g: *UndoGame) {
    l: *LevelState = g.level;
    play_snap_pose(l.blocks, l.nblocks, g.hist, g.hpc, g.hpr, g.hph, g.hpm, g.clock,
        g.pose, pack_pos(g.pose[0], g.pose[1], g.pose[2], g.pose[3]));
    crate_boot(l.blocks, l.nblocks, g.crate_pose, g.crate_cursor, g.crate_t0)
}

test_move(g: *UndoGame, dc: int, dr: int) raises UndoHistoryExhausted, IoError, IndexOutOfBounds {
    l: *LevelState = g.level;
    play_try_dir(l.blocks, l.nblocks, l.rooms, l.nrooms, l.bricks, l.nbricks, l.ground,
        l.nground, g.hist, g.hpc, g.hpr, g.hph, g.hpm, g.hms, g.clock, g.pose, dc,
        dr, g.pend, g.ids, g.widths, g.live, g.counts, g.cursors, g.ghost, l.goals,
        l.ngoals, g.solved, g.stream_until, g.stream_tx, g.stream_tz, g.sparks, g.rng,
        g.scratch, g.u);
    settle_test_game(g)
}

test_undo(g: *UndoGame) raises IoError, IndexOutOfBounds: int {
    l: *LevelState = g.level;
    result: int = PLAY_UNDO_WAIT;
    ticks: int = 0;
    while (result == PLAY_UNDO_WAIT && ticks < UNDO_ROUTE_MAX + 4) {
        result = play_undo_step(l.blocks, l.nblocks, l.nrooms, g.hist, g.hpc, g.hpr,
            g.hph, g.hpm, g.hms, g.clock, g.pose, g.pend, g.ids, g.widths, g.live,
            g.counts, g.cursors, g.ghost, g.u, g.crate_pose, g.crate_ms, g.crate_cursor,
            g.crate_t0, ticks * 1000);
        crate_boot(l.blocks, l.nblocks, g.crate_pose, g.crate_cursor, g.crate_t0);
        ticks = ticks + 1
    }
    check(result != PLAY_UNDO_WAIT, "undo catch-up failed to finish");
    settle_test_game(g);
    result
}

test_gameplay() raises UndoHistoryExhausted, IoError, IndexOutOfBounds {
    g: *UndoGame = new_undo_game();
    stable: int = l8_heap_used();
    // More than 128k real walking actions, then undo every one.
    for i in 0..131074 {
        dc: int = 0 - 1;
        if (i % 2 == 1) dc = 1;
        test_move(g, dc, 0)
    }
    check(g.u.count == 131074 && g.pose[0] == 0, "large walking history");
    check(undo_read(g.u, undo_latest(g.u)) == 5, "walking record exceeds 40 bytes");
    for _i in 0..131074 check(test_undo(g) == PLAY_UNDO_DONE, "walking undo");
    check(test_undo(g) == 0 && g.pose[0] == 0, "empty undo boundary");
    check(l8_heap_used() == stable, "walking/undo heap growth");

    // Move a linked shape out of its room, let that room rewind part way, and
    // undo the departure. Catch-up must use the retained post-action branch.
    test_move(g, 1, 0);
    test_move(g, 1, 0);
    test_move(g, 1, 0);
    check(g.pose[0] == 3 && g.level.blocks[0].column == 4 && g.level.blocks[1].column == 4 && g.ghost[0] == REWIND_LEAVE,
        "shape departure");
    for _i in 0..2 check(rewind_try_step(g.level.blocks, 0, g.ids, g.widths, g.live,
        g.counts, g.cursors, g.ghost, 50, 50), "background rewind step");
    settle_test_game(g);
    check(test_undo(g) == PLAY_UNDO_DONE, "undo room departure");
    check(g.pose[0] == 2 && g.level.blocks[0].column == 3 && g.level.blocks[1].column == 3 && g.counts[0] == 3 && g.ghost[0] == 0,
        "shape undo restored wrong room branch");
    // Undo and branch repeatedly, including reuse of the same physical slot.
    for _i in 0..100 {
        test_move(g, 1, 0);
        check(test_undo(g) == PLAY_UNDO_DONE, "repeat push undo")
    }
    check(l8_heap_used() == stable, "push/rewind/undo heap growth");

    // An unrelated room can finish rewinding after a player action. Undo must
    // not roll that independent clock back to the archived global image.
    g.level.blocks[2].column = 12;
    rewind_capture(g.level.blocks, 1, g.ids, g.widths, g.live, 1);
    g.counts[1] = 2;
    g.cursors[1] = 1;
    g.ghost[1] = REWIND_LEAVE;
    test_move(g, 0, -1);
    check(rewind_try_step(g.level.blocks, 1, g.ids, g.widths, g.live, g.counts, g.cursors,
        g.ghost, 50, 50), "independent rewind");
    settle_test_game(g);
    check(test_undo(g) == PLAY_UNDO_DONE, "undo with independent clock");
    check(g.level.blocks[2].column == 11 && g.counts[1] == 1 && g.ghost[1] == 0, "undo changed independent room");

    // Failed attempts must not consume history.
    old_count: int = g.u.count;
    oldest: int = g.u.tail;
    latest: int = g.u.head;
    // A zero direction is a failed action with no history effect.
    for _i in 0..100 test_move(g, 0, 0);
    check(g.u.count == old_count && g.u.tail == oldest && g.u.head == latest, "failed actions evicted undo");
    check(l8_heap_used() == stable, "gameplay allocated after startup")
}

test_branch_route() raises UndoHistoryExhausted, IoError, IndexOutOfBounds {
    g: *UndoGame = new_undo_game();
    stable: int = l8_heap_used();
    undo_save_history(g.u, false, 2, g.widths, g.live, g.counts, g.cursors, g.ghost,
        g.level.blocks, 3, 0);
    for s in 1..3 {
        for k in 0..2 {
            slot: int = s * LEVEL_MAX_BLOCKS + k;
            check(slot == rewind_slot(0, s, k, g.widths, LEVEL_MAX_BLOCKS), "branch fixture width");
            g.live[slot] = pack_pos(s + 1, k, 0, 0)
        }
    }
    g.counts[0] = 3;
    g.cursors[0] = 2;
    undo_save_history(g.u, true, 2, g.widths, g.live, g.counts, g.cursors, g.ghost,
        g.level.blocks, 3, 0);
    for s in 1..3 {
        for k in 0..2 {
            slot: int = s * LEVEL_MAX_BLOCKS + k;
            check(slot == rewind_slot(0, s, k, g.widths, LEVEL_MAX_BLOCKS), "branch fixture width");
            g.live[slot] = pack_pos(s + 3, k, 0, 0)
        }
    }
    g.level.blocks[0].column = 5;
    g.level.blocks[1].column = 5;
    undo_build_route(g.u, undo_latest(g.u), 0, g.level.blocks, g.ids, g.widths, g.live,
        g.cursors);
    check(g.u.route_n[0] == 4, "branch route length");
    // Walk the abandoned branch back to its common ancestor, then forward.
    route: []int = g.u.route;
    seen: int = 0;
    for slot in 0..len(route) {
        if (slot == 0) {
            check(pos_col(route[slot]) == 4, "first branch route pose");
            seen = seen + 1
        }
        if (slot == 2) {
            check(pos_col(route[slot]) == 1, "second branch route pose");
            seen = seen + 1
        }
        if (slot == 4) {
            check(pos_col(route[slot]) == 2, "third branch route pose");
            seen = seen + 1
        }
        if (slot == 6) {
            check(pos_col(route[slot]) == 3, "fourth branch route pose");
            seen = seen + 1
        }
    }
    check(seen == 4, "branch route storage");
    check(l8_heap_used() == stable, "branch route allocated")
}

test_full_action_capacity() raises UndoHistoryExhausted, IoError, IndexOutOfBounds {
    g: *UndoGame = new_undo_game();
    capacity: int = UNDO_JOURNAL_WORDS / UNDO_ACTION_OVERHEAD;
    stable: int = l8_heap_used();
    // Fill the production-size ring, including eviction of its initial image
    // diff, then undo all 524,288 retained actions across the physical seam.
    for i in 0..capacity + 258 {
        dc: int = -1;
        if (i % 2 == 1) dc = 1;
        test_move(g, dc, 0)
    }
    check(g.u.count == capacity && g.u.head > len(g.u.journal), "full walking capacity");
    check(g.u.head - g.u.tail == capacity * 5, "walking capacity byte accounting");
    for i in 0..capacity {
        check(test_undo(g) == PLAY_UNDO_DONE, "full history undo");
        check(g.pose[0] == -1 + i % 2, "full history player position")
    }
    check(test_undo(g) == 0, "oldest retained action boundary");
    check(l8_heap_used() == stable, "full history allocated")
}

test_stacked_and_unowned() raises UndoHistoryExhausted, IoError, IndexOutOfBounds {
    g: *UndoGame = new_undo_game();
    g.level.blocks[2].column = 1;
    g.level.blocks[2].row = 0;
    g.level.blocks[2].layer = 1;
    home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    assign_block_homes(g.level.blocks, 3, g.level.rooms, 2, home, g.ids, g.widths);
    g.u = new_undo_timeline(home, 3, g.widths);
    for r in 0..2 rewind_capture(g.level.blocks, r, g.ids, g.widths, g.live, 0);
    settle_test_game(g);
    stable: int = l8_heap_used();
    test_move(g, 1, 0);
    check(g.level.blocks[0].column == 2 && g.level.blocks[1].column == 2 && g.level.blocks[2].column == 2 && g.level.blocks[2].layer == 1,
        "stacked shape push");
    check(test_undo(g) == PLAY_UNDO_DONE, "stacked shape undo");
    check(g.level.blocks[0].column == 1 && g.level.blocks[1].column == 1 && g.level.blocks[2].column == 1 && g.level.blocks[2].layer == 1,
        "stack restoration");
    check(l8_heap_used() == stable, "stacked shape allocated");

    // A block outside all rooms must be restored by the changed-block flags
    // reconstructed from the action, without selecting unrelated room clocks.
    g.level.blocks[2].column = 20;
    g.level.blocks[2].row = 0;
    g.level.blocks[2].layer = 0;
    home2: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    assign_block_homes(g.level.blocks, 3, g.level.rooms, 2, home2, g.ids, g.widths);
    g.u = new_undo_timeline(home2, 3, g.widths);
    for r in 0..2 rewind_capture(g.level.blocks, r, g.ids, g.widths, g.live, 0);
    g.pose[0] = 19;
    settle_test_game(g);
    stable = l8_heap_used();
    test_move(g, 1, 0);
    check(home2[2] < 0 && g.level.blocks[2].column == 21, "unowned push");
    check(test_undo(g) == PLAY_UNDO_DONE && g.level.blocks[2].column == 20 && g.pose[0] == 19,
        "unowned block undo");
    check(l8_heap_used() == stable, "unowned block allocated")
}

test_maximum_history() raises UndoHistoryExhausted, IoError, IndexOutOfBounds {
    n: int = LEVEL_MAX_BLOCKS;
    home: []int = new int[n](0);
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    widths[0] = n;
    u: *UndoTimeline = new_undo_timeline(home, n, widths);
    blocks: []Block = new Block[n](Block {
        id: 0,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    });
    live: []int = new int[n * REWIND_MAX](0);
    counts: []int = new int[LEVEL_MAX_ROOMS](0);
    cursors: []int = new int[LEVEL_MAX_ROOMS](0);
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    counts[0] = REWIND_MAX;
    cursors[0] = REWIND_MAX - 1;
    stable: int = l8_heap_used();
    // Every cell changes twice per action: deliberately much denser than
    // gameplay, proving overflow preserves the newest complete before/after.
    for action in 0..12 {
        for phase in 0..2 {
            value: int = pack_pos(-4096, 4096 - action, 7, 1);
            if (phase == 1) value = pack_pos(4096, -4096 + action, 0, 0);
            for i in 0..len(live) live[i] = value;
            undo_save_history(u, phase != 0, 1, widths, live, counts, cursors, ghost,
                blocks, n, action)
        }
        check(u.count > 0 && u.head - u.tail <= len(u.journal), "dense journal budget");
        for phase in 0..2 {
            data: []int = undo_load_history(u, undo_latest(u), phase);
            value: int = pack_pos(-4096, 4096 - action, 7, 1);
            if (phase == 1) value = pack_pos(4096, -4096 + action, 0, 0);
            check(len(data) == u.image_capacity, "dense snapshot capacity");
            seen: int = 0;
            image: []int = u.image;
            for i in 0..len(image) {
                if (i >= 3 && i < u.block_base && i < 3 + len(live)) {
                    check(image[i] == value, "dense snapshot reconstruction");
                    seen = seen + 1
                }
            }
            check(seen == len(live), "dense snapshot span")
        }
    }
    check(l8_heap_used() == stable, "maximum histories allocated after startup")
}

test_water_undo() raises UndoHistoryExhausted, IoError, IndexOutOfBounds {
    g: *UndoGame = new_undo_game();
    l: *LevelState = g.level;
    level_set_ground_count(l, paint_ground_cell(l.ground, 0, 2, 1, GROUND_WATER, false));
    prior: int = g.u.count;
    heap: int = l8_heap_used();
    for _attempt in 0..20 {
        test_move(g, 1, 0);
        check(g.pose[0] == 1 && l.blocks[1].column == 2 && l.blocks[1].layer == 0 - 1,
            "linked piece falls into water");
        test_undo(g);
        check(g.pose[0] == 0 && l.blocks[0].column == 1 && l.blocks[1].column == 1 && l.blocks[1].layer == 0,
            "undo restores submerged linked piece to dry land")
    }
    check(g.u.count == prior && l8_heap_used() == heap, "water fall/undo does not allocate");
    level_set_ground_count(l, paint_ground_cell(l.ground, l.nground, 0, 1, GROUND_WATER,
        false));
    level_set_ground_count(l, paint_ground_cell(l.ground, l.nground, 0, 2, GROUND_WATER,
        false));
    for _attempt in 0..20 {
        test_move(g, 0, 1);
        check(g.pose[1] == 1 && g.pose[2] == 0 - 1, "player falls to bottom");
        test_move(g, 0, 1);
        check(g.pose[1] == 2 && g.pose[2] == 0 - 1, "player wades on bottom");
        test_undo(g);
        check(g.pose[1] == 1 && g.pose[2] == 0 - 1, "undo restores submerged player pose");
        test_undo(g);
        check(g.pose[1] == 0 && g.pose[2] == 0, "undo restores player before water entry")
    }
    check(g.u.count == prior && l8_heap_used() == heap, "wading undo does not allocate")
}

test_plant_undo() raises UndoHistoryExhausted, IoError, IndexOutOfBounds {
    g: *UndoGame = new_undo_game();
    l: *LevelState = g.level;
    check(load_level_state("programs/block-game/grove-demo.txt", l) >= 0, "load canopy undo fixture");
    apply_level_gravity(l);
    home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    assign_block_homes(l.blocks, l.nblocks, l.rooms, l.nrooms, home, g.ids, g.widths);
    g.u = new_undo_timeline(home, l.nblocks, g.widths);
    for room in 0..l.nrooms rewind_capture(l.blocks, room, g.ids, g.widths, g.live,
        0);
    g.pose[0] = 3;
    g.pose[1] = 9;
    g.pose[2] = 0;
    g.pose[3] = 0;
    settle_test_game(g);
    heap: int = l8_heap_used();
    for _attempt in 0..20 {
        for _step in 0..7 test_move(g, 1, 0);
        check(g.pose[0] == 10 && g.pose[2] == 3, "climb across canopy tops");
        for _step in 0..7 check(test_undo(g) == PLAY_UNDO_DONE, "undo canopy step");
        check(g.pose[0] == 3 && g.pose[2] == 0, "undo returns player from crown to ground");
        check(plant_at(l.blocks, l.nblocks, 9, 9) >= 0 && g.widths[0] == 3, "trees stay rooted outside room histories")
    }
    check(l8_heap_used() == heap, "canopy climb and undo do not allocate")
}

test_plant_capacity() raises UndoHistoryExhausted, IoError, InvalidRange, IndexOutOfBounds {
    g: *UndoGame = new_undo_game();
    l: *LevelState = g.level;
    level_set_block_count(l, LEVEL_MAX_BLOCKS);
    cells: []Block = l.blocks;
    count: int = l.nblocks;
    for i in 0..count cells[i] = Block {
        id: i,
        column: i % 64 * 4,
        row: i / 64 * 4,
        shape: plant_shape(i % 5, i % 4),
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    assign_block_homes(l.blocks, l.nblocks, l.rooms, l.nrooms, home, g.ids, g.widths);
    g.u = new_undo_timeline(home, l.nblocks, g.widths);
    g.pose[0] = 0 - 2;
    g.pose[1] = 0;
    settle_test_game(g);
    heap: int = l8_heap_used();
    for step in 0..20 {
        dc: int = 0 - 1;
        if (step % 2 == 1) dc = 1;
        test_move(g, dc, 0)
    }
    for _step in 0..20 check(test_undo(g) == PLAY_UNDO_DONE, "full-capacity foliage history");
    check(g.pose[0] == 0 - 2 && l.blocks[LEVEL_MAX_BLOCKS - 1].column == 252, "full-capacity animation keeps objects separate");
    check(g.hist[LEVEL_MAX_BLOCKS * 2 - 1].id == LEVEL_MAX_BLOCKS - 1, "animation snapshot includes final object");
    check(l8_heap_used() == heap, "full-capacity vegetation undo does not allocate");
    l.spawn = Cell { column: 0 - 2, row: 0 };
    level_set_room_count(l, 1);
    l.rooms[0] = Room {
        x0: 0,
        y0: 0,
        x1: 259,
        y1: 131
    };
    check(save_level_state(".build/plants-capacity-demo.txt", l) == 0, "save dense vegetation fixture")
}

main() raises UndoHistoryExhausted, IoError, InvalidRange, IndexOutOfBounds: int {
    test_plant_capacity();
    test_plant_undo();
    test_water_undo();
    test_journal();
    test_gameplay();
    test_full_action_capacity();
    test_stacked_and_unowned();
    test_branch_route();
    test_maximum_history();
    print("undo journal tests passed");
    0
    //% expect: "undo journal tests passed\n"
}
