tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

const UNDOMEM_JOURNAL_STRIDE: int = 9 + 3 * REWIND_MAX + 3;

type UndomemJournalOrder = {
    action: int;
    base: int;
    previous: ?*UndomemJournalOrder
}

undomem_journal_count(offset: int): int {
    remainder: int = offset % REWIND_MAX;
    remainder + 1
}

undomem_show_int(label: str, value: int) raises IoError {
    write(1, label);
    write(1, ": ");
    print_int(value)
}

undomem_show_bool(label: str, value: bool) raises IoError {
    write(1, label);
    write(1, ": ");
    print_bool(value)
}

undomem_result_name(result: int): str {
    if (result == PLAY_UNDO_DONE) return "done";
    if (result == PLAY_UNDO_WAIT) return "still catching up";
    if (result == 0) return "nothing to undo";
    "unknown"
}

undomem_show_result(label: str, result: int) raises IoError {
    write(1, label);
    write(1, ": ");
    print(undomem_result_name(result))
}

undomem_show_block(label: str, b: Block) raises IoError {
    write(1, label);
    write(1, ": col ");
    write_int(1, b.column);
    write(1, " row ");
    write_int(1, b.row);
    write(1, " layer ");
    write_int(1, b.layer);
    write(1, "\n")
}

undomem_show_player(g: *UndomemGame) raises IoError {
    write(1, "player: col ");
    write_int(1, g.pose[0]);
    write(1, " row ");
    write_int(1, g.pose[1]);
    write(1, " layer ");
    write_int(1, g.pose[2]);
    write(1, "\n")
}

// Compare the compressed log with independent full snapshots. A small ring
// forces eviction and physical wrap; pops and cancelled attempts test branches.
// Mismatches are counted instead of printed so the loop does not allocate.
test "journal reconstructs retained actions under byte pressure" {
    home: []int = [0, 0, 1];
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    widths[0] = 2;
    widths[1] = 1;
    live: []int = new int[384](0);
    u: *UndoTimeline = new_undo_journal(home, 3, widths, live, 1600);
    blocks: []Block = new Block[3](Block {
        id: 0,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    });
    counts: []RewindCount = new RewindCount[LEVEL_MAX_ROOMS](RewindCount { value: 1 });
    cursors: []RewindCursor = new RewindCursor[LEVEL_MAX_ROOMS](RewindCursor { value: 0 });
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    expected: []int = new int[700 * 2 * UNDOMEM_JOURNAL_STRIDE](0);
    order: []UndomemJournalOrder = new UndomemJournalOrder[700](UndomemJournalOrder { action: 0, base: 0, previous: null });
    rc: []RewindCount = new RewindCount[LEVEL_MAX_ROOMS](RewindCount { value: 0 });
    rp: []RewindCursor = new RewindCursor[LEVEL_MAX_ROOMS](RewindCursor { value: 0 });
    rg: []int = new int[LEVEL_MAX_ROOMS](0);
    latest: ?*UndomemJournalOrder = null;
    stable: int = l8_heap_used();
    wrapped: bool = false;
    evicted: bool = false;
    layout_bad: int = 0;
    newest_lost: int = 0;
    loads: int = 0;
    pose_bad: int = 0;
    deps_bad: int = 0;
    meta_bad: int = 0;
    typed_bad: int = 0;
    frames_bad: int = 0;
    blocks_bad: int = 0;
    restores: int = 0;
    restore_bad: int = 0;
    cancels: int = 0;
    cancel_bad: int = 0;
    heap_bad: int = 0;
    for action in 0..700 {
        prior: int = u.count;
        for phase in 0..2 {
            steps0: int = undomem_journal_count(action * 7 + phase);
            steps1: int = undomem_journal_count(action * 3 + phase);
            counts[0].value = steps0;
            counts[1].value = steps1;
            cursors[0].value = counts[0].value - 1;
            cursors[1].value = action % counts[1].value;
            ghost[1] = action % 3;
            if (widths[0] != 2 || widths[1] != 1) layout_bad = layout_bad + 1;
            for s in 0..steps0 {
                for k in 0..2 {
                    slot: int = s * 3 + k;
                    if (slot != rewind_slot(0, s, k, widths, 3)) layout_bad = layout_bad + 1;
                    live[slot] = pack_pos(action + s, k + phase, action % 8, phase)
                }
            }
            for s in 0..steps1 {
                slot: int = s * 3 + 2;
                if (slot != rewind_slot(1, s, 0, widths, 3)) layout_bad = layout_bad + 1;
                live[slot] = pack_pos(action + s, 1 + phase, action % 8, phase)
            }
            blocks[0].column = action;
            blocks[2].row = phase;
            undo_save_history(u, phase != 0, 3, counts, cursors, ghost, blocks, 3,
                pack_pos(action, -3, 2, 1));
            if (phase == 0) {
                undo_depend(u, 0);
                undo_depend(u, 63)
            }
            base: int = (action * 2 + phase) * UNDOMEM_JOURNAL_STRIDE;
            for r in 0..3 {
                expected[base + r * 3] = counts[r].value;
                expected[base + r * 3 + 1] = cursors[r].value;
                expected[base + r * 3 + 2] = ghost[r]
            }
            for i in 0..len(live) expected[base + 9 + i] = live[i];
            for i in 0..3 expected[base + 9 + len(live) + i] = pack_pos(blocks[i].column,
                blocks[i].row, blocks[i].layer, blocks[i].mounted)
        }
        order[action] = UndomemJournalOrder { action: action, base: action * 2 * UNDOMEM_JOURNAL_STRIDE, previous: latest };
        latest = &order[action];
        if (u.count < prior + 1) evicted = true;
        if (u.head > len(u.journal)) wrapped = true;
        if (u.count <= 0) newest_lost = newest_lost + 1;
        // Test reversible phase changes and room restoration for the newest
        // action, and periodically pop several retained actions in sequence.
        pops: int = 0;
        if (action % 5 == 4) pops = 2;
        for attempt in 0..pops + 1 {
            if (u.count > 0) {
                if (latest == null) die("journal action has no test snapshot");
                entry: UndomemJournalOrder = latest.*;
                retained: int = entry.action;
                record: int = undo_latest(u);
                player_at: int = (record + 2) trunc u32 as int;
                if (undo_read(u.journal, player_at) != pack_pos(retained, -3, 2, 1)) pose_bad = pose_bad + 1;
                undo_prepare_action(u, LEVEL_MAX_ROOMS, 3);
                if (u.selected[0] != 1 || u.selected[63] != 1 || u.selected[62] != 0) deps_bad = deps_bad + 1;
                for phase in 0..2 {
                    data: []int = undo_load_history(u, record, phase);
                    loads = loads + 1;
                    base: int = entry.base + phase * UNDOMEM_JOURNAL_STRIDE;
                    for r in 0..3 {
                        off: int = u.offsets[r];
                        if (u.metas[r].count.* != expected[base + r * 3] || u.metas[r].cursor.* != expected[base + r * 3 + 1] || u.metas[r].ghost.* != expected[base + r * 3 + 2]) meta_bad = meta_bad + 1;
                        if (u.meta_values[r * 2] as int != expected[base + r * 3] || u.meta_values[r * 2 + 1] as int != expected[base + r * 3 + 1] + 1) typed_bad = typed_bad + 1;
                        steps: int = u.metas[r].count.*;
                        if (steps < 0 || steps > REWIND_MAX) die("invalid reconstructed frame count");
                        if (r == 0) {
                            if (off != 0 || widths[r] != 2) layout_bad = layout_bad + 1;
                            for s in 0..steps {
                                for k in 0..2 {
                                    if (data[3 + s * 2 + k] != expected[base + 9 + s * 3 + k]) frames_bad = frames_bad + 1
                                }
                            }
                        } else if (r == 1) {
                            if (off != 3 + 2 * REWIND_MAX || widths[r] != 1) layout_bad = layout_bad + 1;
                            for s in 0..steps {
                                if (data[6 + 2 * REWIND_MAX + s] != expected[base + 9 + s * 3 + 2]) frames_bad = frames_bad + 1
                            }
                        } else if (widths[r] != 0) layout_bad = layout_bad + 1
                    }
                    for i in 0..3 {
                        if (u.image[u.block_base + i] != expected[base + 9 + len(live) + i]) blocks_bad = blocks_bad + 1
                    }
                }
                undo_restore_history(u, record, 1, rc, rp, rg);
                restores = restores + 1;
                base: int = entry.base;
                if (rc[1].value != expected[base + 3] || rp[1].value != expected[base + 4] || rg[1] != expected[base + 5]) restore_bad = restore_bad + 1;
                restored_seen: int = 0;
                for i in 0..len(live) {
                    if (i % 3 == 2 && i / 3 < rc[1].value) {
                        s: int = i / 3;
                        if (i != rewind_slot(1, s, 0, widths, 3)) layout_bad = layout_bad + 1;
                        if (live[i] != expected[base + 9 + i]) restore_bad = restore_bad + 1;
                        restored_seen = restored_seen + 1
                    }
                }
                if (restored_seen != rc[1].value) restore_bad = restore_bad + 1;
                if (attempt < pops) {
                    undo_pop_action(u);
                    latest = entry.previous
                } else u.undoing = false
            }
        }
        // A cancelled move must not evict history under byte pressure.
        if (action % 13 == 12) {
            head: int = u.head;
            tail: int = u.tail;
            count: int = u.count;
            counts[0].value = REWIND_MAX;
            counts[1].value = REWIND_MAX;
            for i in 0..len(live) live[i] = pack_pos(-1000, action, 0, 0);
            undo_save_history(u, false, 3, counts, cursors, ghost, blocks, 3, 0);
            undo_cancel_action(u);
            cancels = cancels + 1;
            if (u.head != head || u.tail != tail || u.count != count) cancel_bad = cancel_bad + 1
        }
        if (l8_heap_used() != stable) heap_bad = heap_bad + 1
    }
    undomem_show_bool("evicted old actions", evicted);
    undomem_show_bool("wrapped around the ring", wrapped);
    undomem_show_int("actions where the newest was lost", newest_lost);
    undomem_show_int("actions with heap growth", heap_bad);
    expect {|
        evicted old actions: true
        wrapped around the ring: true
        actions where the newest was lost: 0
        actions with heap growth: 0
    |}
    undomem_show_int("phases reconstructed", loads);
    undomem_show_int("room layout mismatches", layout_bad);
    undomem_show_int("player pose mismatches", pose_bad);
    undomem_show_int("room dependency mask mismatches", deps_bad);
    undomem_show_int("count/cursor/ghost mismatches", meta_bad);
    undomem_show_int("typed metadata mismatches", typed_bad);
    undomem_show_int("rewind frame mismatches", frames_bad);
    undomem_show_int("block pose mismatches", blocks_bad);
    expect {|
        phases reconstructed: 1902
        room layout mismatches: 0
        player pose mismatches: 0
        room dependency mask mismatches: 0
        count/cursor/ghost mismatches: 0
        typed metadata mismatches: 0
        rewind frame mismatches: 0
        block pose mismatches: 0
    |}
    undomem_show_int("room restores", restores);
    undomem_show_int("room restore mismatches", restore_bad);
    expect {|
        room restores: 951
        room restore mismatches: 0
    |}
    undomem_show_int("cancelled moves", cancels);
    undomem_show_int("cancelled moves that changed the journal", cancel_bad);
    expect {|
        cancelled moves: 53
        cancelled moves that changed the journal: 0
    |}
}

test "unchanged actions store only the action overhead" {
    home: []int = [0, 0, 1];
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    widths[0] = 2;
    widths[1] = 1;
    live: []int = new int[384](0);
    u: *UndoTimeline = new_undo_journal(home, 3, widths, live, 1600);
    blocks: []Block = new Block[3](Block {
        id: 0,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    });
    counts: []RewindCount = new RewindCount[LEVEL_MAX_ROOMS](RewindCount { value: 1 });
    cursors: []RewindCursor = new RewindCursor[LEVEL_MAX_ROOMS](RewindCursor { value: 0 });
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    for action in 0..10 {
        blocks[0].column = action;
        live[0] = action;
        undo_save_history(u, false, 3, counts, cursors, ghost, blocks, 3, action);
        undo_save_history(u, true, 3, counts, cursors, ghost, blocks, 3, action)
    }
    undomem_show_int("actions before clearing", u.count);
    undo_clear_journal(u);
    undomem_show_int("head after clearing", u.head);
    undomem_show_int("tail after clearing", u.tail);
    undomem_show_int("actions after clearing", u.count);
    expect {|
        actions before clearing: 10
        head after clearing: 0
        tail after clearing: 0
        actions after clearing: 0
    |}
    stable: int = l8_heap_used();
    larger: int = 0;
    for action in 0..1000 {
        undo_save_history(u, false, 3, counts, cursors, ghost, blocks, 3, action);
        undo_save_history(u, true, 3, counts, cursors, ghost, blocks, 3, action);
        if (action > 0) {
            latest_action: int = undo_latest(u);
            if (undo_read(u.journal, latest_action) != UNDO_ACTION_OVERHEAD) larger = larger + 1
        }
    }
    grown: int = l8_heap_used() - stable;
    undomem_show_int("later actions larger than the overhead", larger);
    undomem_show_int("journal words", len(u.journal));
    undomem_show_int("action overhead words", UNDO_ACTION_OVERHEAD);
    undomem_show_int("retained actions", u.count);
    undomem_show_int("heap growth", grown);
    expect {|
        later actions larger than the overhead: 0
        journal words: 1600
        action overhead words: 5
        retained actions: 320
        heap growth: 0
    |}
}

type UndomemGame = {
    level: *LevelState;
    u: *UndoTimeline;
    widths: []int;
    ids: *RoomBlockIds;
    live: []int;
    counts: []RewindCount;
    cursors: []RewindCursor;
    ghost: []int;
    hist: []Block;
    hpc: []int;
    hpr: []int;
    hph: []int;
    hpm: []int;
    hms: []int;
    clock: []int;
    pose: []int;
    pend: []int;
    scratch: []int;
    crate_pose: []int;
    crate_ms: []int;
    crate_cursor: *CrateCursor;
    crate_t0: []int;
    solved: []int;
    stream_until: []int;
    stream_tx: []f32;
    stream_tz: []f32;
    sparks: []Spark;
    rng: []int
}

new_undomem_game() raises IoError: *UndomemGame@new {
    l: *LevelState = new_level_state();
    level_set_room_count(l, 2);
    l.rooms[0] = Room {
        x0: 0,
        y0: 0,
        x1: 2,
        y1: 2
    };
    l.rooms[1] = Room {
        x0: 10,
        y0: 0,
        x1: 13,
        y1: 3
    };
    level_set_block_count(l, 3);
    l.blocks[0] = Block {
        id: 0,
        column: 1,
        row: 0,
        shape: 1,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    l.blocks[1] = Block {
        id: 1,
        column: 1,
        row: 1,
        shape: 1,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    l.blocks[2] = Block {
        id: 2,
        column: 11,
        row: 1,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    ids: *RoomBlockIds = new_room_block_ids();
    assign_block_homes(l.blocks, l.nblocks, l.rooms, l.nrooms, home, ids, widths);
    live: []int = new int[LEVEL_MAX_BLOCKS * REWIND_MAX](0);
    g: *UndomemGame = new UndomemGame {
        level: l,
        u: new_undo_timeline(home, l.nblocks, widths, live),
        widths: widths,
        ids: ids,
        live: live,
        counts: new RewindCount[LEVEL_MAX_ROOMS](RewindCount { value: 1 }),
        cursors: new RewindCursor[LEVEL_MAX_ROOMS](RewindCursor { value: 0 }),
        ghost: new int[LEVEL_MAX_ROOMS](0),
        hist: new Block[8 * LEVEL_MAX_BLOCKS](l.blocks[0]),
        hpc: new int[8](0),
        hpr: new int[8](0),
        hph: new int[8](0),
        hpm: new int[8](0),
        hms: new int[8](200),
        clock: new int[3](0),
        pose: new int[4](0),
        pend: new int[2](0),
        scratch: new int[LEVEL_MAX_BLOCKS](0),
        crate_pose: new int[LEVEL_MAX_BLOCKS * CRATE_HIST](0),
        crate_ms: new int[LEVEL_MAX_BLOCKS * CRATE_HIST](0),
        crate_cursor: new_crate_cursor(),
        crate_t0: new int[LEVEL_MAX_BLOCKS](0),
        solved: new int[LEVEL_MAX_ROOMS](0),
        stream_until: new int[LEVEL_MAX_ROOMS](0),
        stream_tx: new f32[LEVEL_MAX_ROOMS](0.0),
        stream_tz: new f32[LEVEL_MAX_ROOMS](0.0),
        sparks: new Spark[SPARK_N](Spark {
            x: 0.0,
            y: 0.0,
            z: 0.0,
            vx: 0.0,
            vy: 0.0,
            vz: 0.0,
            life: 0.0,
            kind: 0,
            room: 0,
            blue: 0.0
        }),
        rng: new int[1](1)
    };
    for r in 0..l.nrooms rewind_capture(l.blocks, r, ids, g.live, 0);
    undomem_settle(g);
    g
}

undomem_settle(g: *UndomemGame) {
    l: *LevelState = g.level;
    play_snap_pose(l.blocks, l.nblocks, g.hist, g.hpc, g.hpr, g.hph, g.hpm, g.clock,
        g.pose, pack_pos(g.pose[0], g.pose[1], g.pose[2], g.pose[3]));
    crate_boot(l.blocks, l.nblocks, g.crate_pose, g.crate_cursor, g.crate_t0)
}

undomem_move(g: *UndomemGame, dc: int, dr: int) raises UndoHistoryExhausted, IoError {
    l: *LevelState = g.level;
    play_try_dir(l.blocks, l.nblocks, l.rooms, l.nrooms, l.bricks, l.nbricks, l.ground,
        l.nground, g.hist, g.hpc, g.hpr, g.hph, g.hpm, g.hms, g.clock, g.pose, dc,
        dr, g.pend, g.ids, g.live, g.counts, g.cursors, g.ghost, l.goals, l.ngoals,
        g.solved, g.stream_until, g.stream_tx, g.stream_tz, g.sparks, g.rng, g.scratch,
        g.u);
    undomem_settle(g)
}

// Undo one action, ticking until any catch-up animation finishes. Returns
// PLAY_UNDO_WAIT if it never finished.
undomem_undo(g: *UndomemGame) raises IoError: int {
    l: *LevelState = g.level;
    result: int = PLAY_UNDO_WAIT;
    ticks: int = 0;
    while (result == PLAY_UNDO_WAIT && ticks < UNDO_ROUTE_MAX + 4) {
        result = play_undo_step(l.blocks, l.nblocks, l.nrooms, g.hist, g.hpc, g.hpr,
            g.hph, g.hpm, g.hms, g.clock, g.pose, g.pend, g.ids, g.counts, g.cursors,
            g.ghost, g.u, g.crate_pose, g.crate_ms, g.crate_cursor, g.crate_t0, ticks * 1000);
        crate_boot(l.blocks, l.nblocks, g.crate_pose, g.crate_cursor, g.crate_t0);
        ticks = ticks + 1
    }
    undomem_settle(g);
    result
}

// Record the player pose and the first three blocks in out[at..at + 12].
undomem_capture(g: *UndomemGame, out: []int, at: int) {
    blocks: []Block = g.level.blocks;
    if (len(blocks) < 3) return;
    for i in 0..3 undomem_put(out, at + i, g.pose[i]);
    for b in 0..3 {
        undomem_put(out, at + 3 + b * 3, blocks[b].column);
        undomem_put(out, at + 4 + b * 3, blocks[b].row);
        undomem_put(out, at + 5 + b * 3, blocks[b].layer)
    }
}

undomem_put(out: []int, i: int, value: int) {
    if (i >= 0 && i < len(out)) out[i] = value
}

undomem_same_capture(buf: []int, a: int, b: int): bool {
    for i in 0..12 {
        x: int = a + i;
        y: int = b + i;
        if (x < 0 || y < 0 || x >= len(buf) || y >= len(buf)) return false;
        if (buf[x] != buf[y]) return false
    }
    true
}

undomem_show_captured_player(buf: []int, at: int) raises IoError {
    if (at < 0 || at + 12 > len(buf)) return;
    write(1, "player: col ");
    write_int(1, buf[at]);
    write(1, " row ");
    write_int(1, buf[at + 1]);
    write(1, " layer ");
    write_int(1, buf[at + 2]);
    write(1, "\n")
}

undomem_show_captured_block(buf: []int, at: int, b: int) raises IoError {
    write(1, "block ");
    write_int(1, b);
    write(1, ":");
    for k in 0..3 {
        if (k == 0) write(1, " col ");
        if (k == 1) write(1, " row ");
        if (k == 2) write(1, " layer ");
        j: int = at + 3 + b * 3 + k;
        if (j >= 0 && j < len(buf)) write_int(1, buf[j]) else write(1, "?")
    }
    write(1, "\n")
}

test "undoing more than 128k walking actions" {
    g: *UndomemGame = new_undomem_game();
    stable: int = l8_heap_used();
    for i in 0..131074 {
        dc: int = -1;
        if (i % 2 == 1) dc = 1;
        undomem_move(g, dc, 0)
    }
    grown: int = l8_heap_used() - stable;
    u: *UndoTimeline = g.u;
    latest_action: int = undo_latest(u);
    newest: int = undo_read(u.journal, latest_action);
    undomem_show_int("retained actions", g.u.count);
    undomem_show_player(g);
    undomem_show_int("newest action words", newest);
    undomem_show_int("heap growth", grown);
    expect {|
        retained actions: 131074
        player: col 0 row 0 layer 0
        newest action words: 5
        heap growth: 0
    |}
    stable = l8_heap_used();
    failures: int = 0;
    for _i in 0..131074 {
        if (undomem_undo(g) != PLAY_UNDO_DONE) failures = failures + 1
    }
    extra: int = undomem_undo(g);
    grown = l8_heap_used() - stable;
    undomem_show_int("undos that did not finish", failures);
    undomem_show_result("one more undo", extra);
    undomem_show_player(g);
    undomem_show_int("heap growth", grown);
    expect {|
        undos that did not finish: 0
        one more undo: nothing to undo
        player: col 0 row 0 layer 0
        heap growth: 0
    |}
}

// Move a linked shape out of its room, let that room rewind part way, and
// undo the departure. Catch-up must use the retained post-action branch.
test "undoing a shape's departure restores its room's branch" {
    g: *UndomemGame = new_undomem_game();
    heap: int = 0;
    mark: int = l8_heap_used();
    undomem_move(g, 1, 0);
    undomem_move(g, 1, 0);
    undomem_move(g, 1, 0);
    heap = heap + l8_heap_used() - mark;
    undomem_show_player(g);
    undomem_show_block("block 0", g.level.blocks[0]);
    undomem_show_block("block 1", g.level.blocks[1]);
    undomem_show_bool("room 0 ghost is leaving", g.ghost[0] == REWIND_LEAVE);
    expect {|
        player: col 3 row 0 layer 0
        block 0: col 4 row 0 layer 0
        block 1: col 4 row 1 layer 0
        room 0 ghost is leaving: true
    |}
    mark = l8_heap_used();
    first: bool = rewind_try_step(g.level.blocks, 0, g.ids, g.live, g.counts, g.cursors,
        g.ghost, 50, 50);
    second: bool = rewind_try_step(g.level.blocks, 0, g.ids, g.live, g.counts, g.cursors,
        g.ghost, 50, 50);
    undomem_settle(g);
    heap = heap + l8_heap_used() - mark;
    undomem_show_bool("first background rewind step", first);
    undomem_show_bool("second background rewind step", second);
    expect {|
        first background rewind step: true
        second background rewind step: true
    |}
    mark = l8_heap_used();
    result: int = undomem_undo(g);
    heap = heap + l8_heap_used() - mark;
    undomem_show_result("undo", result);
    undomem_show_player(g);
    undomem_show_block("block 0", g.level.blocks[0]);
    undomem_show_block("block 1", g.level.blocks[1]);
    undomem_show_int("room 0 frames", g.counts[0].value);
    undomem_show_int("room 0 ghost", g.ghost[0]);
    expect {|
        undo: done
        player: col 2 row 0 layer 0
        block 0: col 3 row 0 layer 0
        block 1: col 3 row 1 layer 0
        room 0 frames: 3
        room 0 ghost: 0
    |}
    // Undo and branch repeatedly, including reuse of the same physical slot.
    mark = l8_heap_used();
    failures: int = 0;
    for _i in 0..100 {
        undomem_move(g, 1, 0);
        if (undomem_undo(g) != PLAY_UNDO_DONE) failures = failures + 1
    }
    heap = heap + l8_heap_used() - mark;
    undomem_show_int("repeated push undos that did not finish", failures);
    undomem_show_int("heap growth", heap);
    expect {|
        repeated push undos that did not finish: 0
        heap growth: 0
    |}
}

// An unrelated room can finish rewinding after a player action. Undo must
// not roll that independent clock back to the archived global image.
test "undo leaves an independently rewinding room alone" {
    g: *UndomemGame = new_undomem_game();
    g.level.blocks[2].column = 12;
    rewind_capture(g.level.blocks, 1, g.ids, g.live, 1);
    g.counts[1].value = 2;
    g.cursors[1].value = 1;
    g.ghost[1] = REWIND_LEAVE;
    heap: int = 0;
    mark: int = l8_heap_used();
    undomem_move(g, 0, -1);
    stepped: bool = rewind_try_step(g.level.blocks, 1, g.ids, g.live, g.counts, g.cursors,
        g.ghost, 50, 50);
    undomem_settle(g);
    heap = heap + l8_heap_used() - mark;
    undomem_show_bool("room 1 rewind step", stepped);
    undomem_show_block("block 2", g.level.blocks[2]);
    expect {|
        room 1 rewind step: true
        block 2: col 11 row 1 layer 0
    |}
    mark = l8_heap_used();
    result: int = undomem_undo(g);
    heap = heap + l8_heap_used() - mark;
    undomem_show_result("undo", result);
    undomem_show_block("block 2", g.level.blocks[2]);
    undomem_show_int("room 1 frames", g.counts[1].value);
    undomem_show_int("room 1 ghost", g.ghost[1]);
    undomem_show_int("heap growth", heap);
    expect {|
        undo: done
        block 2: col 11 row 1 layer 0
        room 1 frames: 1
        room 1 ghost: 0
        heap growth: 0
    |}
}

test "failed moves do not consume history" {
    g: *UndomemGame = new_undomem_game();
    undomem_move(g, 1, 0);
    count: int = g.u.count;
    oldest: int = g.u.tail;
    latest: int = g.u.head;
    undomem_show_int("retained actions", count);
    expect {|
        retained actions: 1
    |}
    // A zero direction is a failed action with no history effect.
    stable: int = l8_heap_used();
    for _i in 0..100 undomem_move(g, 0, 0);
    grown: int = l8_heap_used() - stable;
    undomem_show_int("retained actions after 100 failed moves", g.u.count);
    undomem_show_bool("oldest action unchanged", g.u.tail == oldest);
    undomem_show_bool("newest action unchanged", g.u.head == latest);
    undomem_show_int("heap growth", grown);
    expect {|
        retained actions after 100 failed moves: 1
        oldest action unchanged: true
        newest action unchanged: true
        heap growth: 0
    |}
}

test "undo route walks an abandoned branch back and forward" {
    g: *UndomemGame = new_undomem_game();
    stable: int = l8_heap_used();
    layout_bad: int = 0;
    undo_save_history(g.u, false, 2, g.counts, g.cursors, g.ghost, g.level.blocks,
        3, 0);
    for s in 1..3 {
        for k in 0..2 {
            slot: int = s * LEVEL_MAX_BLOCKS + k;
            if (slot != rewind_slot(0, s, k, g.widths, LEVEL_MAX_BLOCKS)) layout_bad = layout_bad + 1;
            g.live[slot] = pack_pos(s + 1, k, 0, 0)
        }
    }
    g.counts[0].value = 3;
    g.cursors[0].value = 2;
    undo_save_history(g.u, true, 2, g.counts, g.cursors, g.ghost, g.level.blocks,
        3, 0);
    for s in 1..3 {
        for k in 0..2 {
            slot: int = s * LEVEL_MAX_BLOCKS + k;
            if (slot != rewind_slot(0, s, k, g.widths, LEVEL_MAX_BLOCKS)) layout_bad = layout_bad + 1;
            g.live[slot] = pack_pos(s + 3, k, 0, 0)
        }
    }
    g.level.blocks[0].column = 5;
    g.level.blocks[1].column = 5;
    undo_build_route(g.u, undo_latest(g.u), 0, g.level.blocks, g.ids, g.cursors);
    grown: int = l8_heap_used() - stable;
    undomem_show_int("fixture layout mismatches", layout_bad);
    undomem_show_int("route length", g.u.route_n[0]);
    // Each route pose has two blocks; show the first block's column.
    route: []int = g.u.route;
    write(1, "route columns:");
    for slot in 0..4 {
        write(1, " ");
        i: int = slot * 2;
        if (i < len(route)) write_int(1, pos_col(route[i])) else write(1, "missing")
    }
    write(1, "\n");
    undomem_show_int("heap growth", grown);
    expect {|
        fixture layout mismatches: 0
        route length: 4
        route columns: 4 1 2 3
        heap growth: 0
    |}
}

test "full-size journal undoes every retained action" {
    g: *UndomemGame = new_undomem_game();
    capacity: int = UNDO_JOURNAL_WORDS / UNDO_ACTION_OVERHEAD;
    stable: int = l8_heap_used();
    // Fill the production-size ring, including eviction of its initial image
    // diff, then undo all retained actions across the physical seam.
    for i in 0..capacity + 258 {
        dc: int = -1;
        if (i % 2 == 1) dc = 1;
        undomem_move(g, dc, 0)
    }
    grown: int = l8_heap_used() - stable;
    undomem_show_int("action capacity", capacity);
    undomem_show_int("retained actions", g.u.count);
    undomem_show_int("journal words in use", g.u.head - g.u.tail);
    undomem_show_bool("head is past the physical seam", g.u.head > len(g.u.journal));
    undomem_show_int("heap growth", grown);
    expect {|
        action capacity: 524288
        retained actions: 524288
        journal words in use: 2621440
        head is past the physical seam: true
        heap growth: 0
    |}
    stable = l8_heap_used();
    failures: int = 0;
    misplaced: int = 0;
    for i in 0..capacity {
        if (undomem_undo(g) != PLAY_UNDO_DONE) failures = failures + 1;
        // The player alternates between columns -1 and 0.
        if (g.pose[0] != -1 + i % 2) misplaced = misplaced + 1
    }
    extra: int = undomem_undo(g);
    grown = l8_heap_used() - stable;
    undomem_show_int("undos that did not finish", failures);
    undomem_show_int("undos leaving the player misplaced", misplaced);
    undomem_show_result("one more undo", extra);
    undomem_show_int("heap growth", grown);
    expect {|
        undos that did not finish: 0
        undos leaving the player misplaced: 0
        one more undo: nothing to undo
        heap growth: 0
    |}
}

test "undo restores a block stacked on a pushed shape" {
    g: *UndomemGame = new_undomem_game();
    g.level.blocks[2].column = 1;
    g.level.blocks[2].row = 0;
    g.level.blocks[2].layer = 1;
    home: []int = new int[LEVEL_MAX_BLOCKS](-1);
    assign_block_homes(g.level.blocks, 3, g.level.rooms, 2, home, g.ids, g.widths);
    g.u = new_undo_timeline(home, 3, g.widths, g.live);
    for r in 0..2 rewind_capture(g.level.blocks, r, g.ids, g.live, 0);
    undomem_settle(g);
    heap: int = 0;
    mark: int = l8_heap_used();
    undomem_move(g, 1, 0);
    heap = heap + l8_heap_used() - mark;
    undomem_show_block("block 0", g.level.blocks[0]);
    undomem_show_block("block 1", g.level.blocks[1]);
    undomem_show_block("stacked block", g.level.blocks[2]);
    expect {|
        block 0: col 2 row 0 layer 0
        block 1: col 2 row 1 layer 0
        stacked block: col 2 row 0 layer 1
    |}
    mark = l8_heap_used();
    result: int = undomem_undo(g);
    heap = heap + l8_heap_used() - mark;
    undomem_show_result("undo", result);
    undomem_show_block("block 0", g.level.blocks[0]);
    undomem_show_block("block 1", g.level.blocks[1]);
    undomem_show_block("stacked block", g.level.blocks[2]);
    undomem_show_int("heap growth", heap);
    expect {|
        undo: done
        block 0: col 1 row 0 layer 0
        block 1: col 1 row 1 layer 0
        stacked block: col 1 row 0 layer 1
        heap growth: 0
    |}
}

// A block outside all rooms must be restored by the changed-block flags
// reconstructed from the action, without selecting unrelated room clocks.
test "undo restores a block outside every room" {
    g: *UndomemGame = new_undomem_game();
    g.level.blocks[2].column = 20;
    g.level.blocks[2].row = 0;
    g.level.blocks[2].layer = 0;
    home: []int = new int[LEVEL_MAX_BLOCKS](-1);
    assign_block_homes(g.level.blocks, 3, g.level.rooms, 2, home, g.ids, g.widths);
    g.u = new_undo_timeline(home, 3, g.widths, g.live);
    for r in 0..2 rewind_capture(g.level.blocks, r, g.ids, g.live, 0);
    g.pose[0] = 19;
    undomem_settle(g);
    heap: int = 0;
    mark: int = l8_heap_used();
    undomem_move(g, 1, 0);
    heap = heap + l8_heap_used() - mark;
    undomem_show_int("block 2 home room", home[2]);
    undomem_show_block("pushed block 2", g.level.blocks[2]);
    expect {|
        block 2 home room: -1
        pushed block 2: col 21 row 0 layer 0
    |}
    mark = l8_heap_used();
    result: int = undomem_undo(g);
    heap = heap + l8_heap_used() - mark;
    undomem_show_result("undo", result);
    undomem_show_block("block 2", g.level.blocks[2]);
    undomem_show_player(g);
    undomem_show_int("heap growth", heap);
    expect {|
        undo: done
        block 2: col 20 row 0 layer 0
        player: col 19 row 0 layer 0
        heap growth: 0
    |}
}

// Every cell changes twice per action: deliberately much denser than
// gameplay, proving overflow preserves the newest complete before/after.
test "dense actions keep the newest complete snapshot" {
    n: int = LEVEL_MAX_BLOCKS;
    home: []int = new int[n](0);
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    widths[0] = n;
    live: []int = new int[REWIND_STORAGE_WORDS](0);
    u: *UndoTimeline = new_undo_timeline(home, n, widths, live);
    blocks: []Block = new Block[n](Block {
        id: 0,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    });
    full_span: *RoomBlockSpan = new RoomBlockSpan { start: 0, end: n };
    final_frame: RewindFrameView = rewind_frame_view(live, REWIND_MAX - 1, full_span);
    // Frame REWIND_MAX - 1 of n blocks ends exactly at the end of storage.
    undomem_show_int("final frame start", final_frame.start);
    undomem_show_int("final frame end", final_frame.end);
    undomem_show_int("rewind storage words", len(live));
    expect {|
        final frame start: 260096
        final frame end: 262144
        rewind storage words: 262144
    |}
    counts: []RewindCount = new RewindCount[LEVEL_MAX_ROOMS](RewindCount { value: 0 });
    cursors: []RewindCursor = new RewindCursor[LEVEL_MAX_ROOMS](RewindCursor { value: 0 });
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    counts[0].value = REWIND_MAX;
    cursors[0].value = REWIND_MAX - 1;
    stable: int = l8_heap_used();
    over_budget: int = 0;
    wrong_capacity: int = 0;
    wrong_cells: int = 0;
    wrong_span: int = 0;
    for action in 0..12 {
        for phase in 0..2 {
            value: int = pack_pos(-4096, 4096 - action, 7, 1);
            if (phase == 1) value = pack_pos(4096, -4096 + action, 0, 0);
            for i in 0..len(live) live[i] = value;
            undo_save_history(u, phase != 0, 1, counts, cursors, ghost, blocks, n,
                action)
        }
        if (u.count <= 0 || u.head - u.tail > len(u.journal)) over_budget = over_budget + 1;
        for phase in 0..2 {
            data: []int = undo_load_history(u, undo_latest(u), phase);
            value: int = pack_pos(-4096, 4096 - action, 7, 1);
            if (phase == 1) value = pack_pos(4096, -4096 + action, 0, 0);
            if (len(data) != u.image_capacity) wrong_capacity = wrong_capacity + 1;
            seen: int = 0;
            image: []int = u.image;
            for i in 0..len(image) {
                if (i >= 3 && i < u.block_base && i < 3 + len(live)) {
                    if (image[i] != value) wrong_cells = wrong_cells + 1;
                    seen = seen + 1
                }
            }
            if (seen != len(live)) wrong_span = wrong_span + 1
        }
    }
    grown: int = l8_heap_used() - stable;
    undomem_show_int("actions with nothing retained or over budget", over_budget);
    undomem_show_int("snapshots with the wrong capacity", wrong_capacity);
    undomem_show_int("snapshots not spanning all rewind storage", wrong_span);
    undomem_show_int("wrong snapshot cells", wrong_cells);
    undomem_show_int("heap growth", grown);
    expect {|
        actions with nothing retained or over budget: 0
        snapshots with the wrong capacity: 0
        snapshots not spanning all rewind storage: 0
        wrong snapshot cells: 0
        heap growth: 0
    |}
}

test "undo of a linked piece that fell into water" {
    g: *UndomemGame = new_undomem_game();
    l: *LevelState = g.level;
    level_set_ground_count(l, paint_ground_cell(l.ground, 0, 2, 1, GROUND_WATER, false));
    prior: int = g.u.count;
    // Captures: the first attempt in 0 and 12, later attempts in 24 and 36.
    buf: []int = new int[48](0);
    heap: int = l8_heap_used();
    differing: int = 0;
    failures: int = 0;
    for attempt in 0..20 {
        at: int = 0;
        if (attempt > 0) at = 24;
        undomem_move(g, 1, 0);
        undomem_capture(g, buf, at);
        if (undomem_undo(g) != PLAY_UNDO_DONE) failures = failures + 1;
        undomem_capture(g, buf, at + 12);
        if (attempt > 0 && !(undomem_same_capture(buf, 0, 24) && undomem_same_capture(buf,
            12, 36))) differing = differing + 1
    }
    grown: int = l8_heap_used() - heap;
    // The far member of the linked shape sinks to the bottom.
    undomem_show_captured_player(buf, 0);
    undomem_show_captured_block(buf, 0, 0);
    undomem_show_captured_block(buf, 0, 1);
    expect {|
        player: col 1 row 0 layer 0
        block 0: col 2 row 0 layer 0
        block 1: col 2 row 1 layer -1
    |}
    // Undo puts it back on dry land.
    undomem_show_captured_player(buf, 12);
    undomem_show_captured_block(buf, 12, 0);
    undomem_show_captured_block(buf, 12, 1);
    expect {|
        player: col 0 row 0 layer 0
        block 0: col 1 row 0 layer 0
        block 1: col 1 row 1 layer 0
    |}
    undomem_show_int("attempts differing from the first", differing);
    undomem_show_int("undos that did not finish", failures);
    undomem_show_int("retained actions change", g.u.count - prior);
    undomem_show_int("heap growth", grown);
    expect {|
        attempts differing from the first: 0
        undos that did not finish: 0
        retained actions change: 0
        heap growth: 0
    |}
}

test "undo of wading through a pond" {
    g: *UndomemGame = new_undomem_game();
    l: *LevelState = g.level;
    level_set_ground_count(l, paint_ground_cell(l.ground, 0, 2, 1, GROUND_WATER, false));
    level_set_ground_count(l, paint_ground_cell(l.ground, l.nground, 0, 1, GROUND_WATER,
        false));
    level_set_ground_count(l, paint_ground_cell(l.ground, l.nground, 0, 2, GROUND_WATER,
        false));
    prior: int = g.u.count;
    // Captures: the first attempt in 0 to 47, later attempts in 48 to 95.
    buf: []int = new int[96](0);
    heap: int = l8_heap_used();
    differing: int = 0;
    failures: int = 0;
    for attempt in 0..20 {
        at: int = 0;
        if (attempt > 0) at = 48;
        undomem_move(g, 0, 1);
        undomem_capture(g, buf, at);
        undomem_move(g, 0, 1);
        undomem_capture(g, buf, at + 12);
        if (undomem_undo(g) != PLAY_UNDO_DONE) failures = failures + 1;
        undomem_capture(g, buf, at + 24);
        if (undomem_undo(g) != PLAY_UNDO_DONE) failures = failures + 1;
        undomem_capture(g, buf, at + 36);
        if (attempt > 0) {
            same: bool = true;
            for k in 0..4 {
                if (!undomem_same_capture(buf, k * 12, 48 + k * 12)) same = false
            }
            if (!same) differing = differing + 1
        }
    }
    grown: int = l8_heap_used() - heap;
    // The player falls to the bottom, then wades along it.
    undomem_show_captured_player(buf, 0);
    undomem_show_captured_player(buf, 12);
    expect {|
        player: col 0 row 1 layer -1
        player: col 0 row 2 layer -1
    |}
    // Undo returns it to the bottom, then to the bank.
    undomem_show_captured_player(buf, 24);
    undomem_show_captured_player(buf, 36);
    expect {|
        player: col 0 row 1 layer -1
        player: col 0 row 0 layer 0
    |}
    undomem_show_int("attempts differing from the first", differing);
    undomem_show_int("undos that did not finish", failures);
    undomem_show_int("retained actions change", g.u.count - prior);
    undomem_show_int("heap growth", grown);
    expect {|
        attempts differing from the first: 0
        undos that did not finish: 0
        retained actions change: 0
        heap growth: 0
    |}
}

test "undo of climbing across tree canopies" {
    g: *UndomemGame = new_undomem_game();
    l: *LevelState = g.level;
    undomem_show_int("load grove-demo (blocks)", load_level_state("programs/block-game/grove-demo.txt",
        l));
    expect {|
        load grove-demo (blocks): 17
    |}
    apply_level_gravity(l);
    home: []int = new int[LEVEL_MAX_BLOCKS](-1);
    assign_block_homes(l.blocks, l.nblocks, l.rooms, l.nrooms, home, g.ids, g.widths);
    g.u = new_undo_timeline(home, l.nblocks, g.widths, g.live);
    for room in 0..l.nrooms rewind_capture(l.blocks, room, g.ids, g.live, 0);
    g.pose[0] = 3;
    g.pose[1] = 9;
    g.pose[2] = 0;
    g.pose[3] = 0;
    undomem_settle(g);
    // Captures: the first attempt in 0 and 12, later attempts in 24 and 36.
    buf: []int = new int[48](0);
    heap: int = l8_heap_used();
    differing: int = 0;
    failures: int = 0;
    rooted: int = 0;
    narrow: int = 0;
    for attempt in 0..20 {
        at: int = 0;
        if (attempt > 0) at = 24;
        for _step in 0..7 undomem_move(g, 1, 0);
        undomem_capture(g, buf, at);
        for _step in 0..7 {
            if (undomem_undo(g) != PLAY_UNDO_DONE) failures = failures + 1
        }
        undomem_capture(g, buf, at + 12);
        if (plant_at(l.blocks, l.nblocks, 9, 9) >= 0) rooted = rooted + 1;
        if (g.widths[0] == 3) narrow = narrow + 1;
        if (attempt > 0 && !(undomem_same_capture(buf, 0, 24) && undomem_same_capture(buf,
            12, 36))) differing = differing + 1
    }
    grown: int = l8_heap_used() - heap;
    // Seven steps east climb onto the canopy tops.
    undomem_show_captured_player(buf, 0);
    expect {|
        player: col 10 row 9 layer 3
    |}
    // Seven undos bring the player from the crown back to the ground.
    undomem_show_captured_player(buf, 12);
    expect {|
        player: col 3 row 9 layer 0
    |}
    // Trees stay rooted and outside room histories.
    undomem_show_int("attempts with a tree at (9,9)", rooted);
    undomem_show_int("attempts where room 0 history holds 3 blocks", narrow);
    undomem_show_int("attempts differing from the first", differing);
    undomem_show_int("undos that did not finish", failures);
    undomem_show_int("heap growth", grown);
    expect {|
        attempts with a tree at (9,9): 20
        attempts where room 0 history holds 3 blocks: 20
        attempts differing from the first: 0
        undos that did not finish: 0
        heap growth: 0
    |}
}

test "undo with a level full of plants" {
    g: *UndomemGame = new_undomem_game();
    l: *LevelState = g.level;
    level_set_block_count(l, LEVEL_MAX_BLOCKS);
    cells: []Block = l.blocks;
    count: int = l.nblocks;
    for i in 0..count cells[i] = Block {
        id: i,
        column: i % 64 * 4,
        row: i / 64 * 4,
        shape: plant_shape(i % 5, i % 4),
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    home: []int = new int[LEVEL_MAX_BLOCKS](-1);
    assign_block_homes(l.blocks, l.nblocks, l.rooms, l.nrooms, home, g.ids, g.widths);
    g.u = new_undo_timeline(home, l.nblocks, g.widths, g.live);
    g.pose[0] = -2;
    g.pose[1] = 0;
    undomem_settle(g);
    heap: int = l8_heap_used();
    for step in 0..20 {
        dc: int = -1;
        if (step % 2 == 1) dc = 1;
        undomem_move(g, dc, 0)
    }
    failures: int = 0;
    for _step in 0..20 {
        if (undomem_undo(g) != PLAY_UNDO_DONE) failures = failures + 1
    }
    grown: int = l8_heap_used() - heap;
    undomem_show_int("undos that did not finish", failures);
    undomem_show_player(g);
    undomem_show_block("last plant", l.blocks[LEVEL_MAX_BLOCKS - 1]);
    undomem_show_int("last animation snapshot id", g.hist[LEVEL_MAX_BLOCKS * 2 - 1].id);
    undomem_show_int("heap growth", grown);
    expect {|
        undos that did not finish: 0
        player: col -2 row 0 layer 0
        last plant: col 252 row 124 layer 0
        last animation snapshot id: 2047
        heap growth: 0
    |}
    l.spawn = Cell { column: -2, row: 0 };
    level_set_room_count(l, 1);
    l.rooms[0] = Room {
        x0: 0,
        y0: 0,
        x1: 259,
        y1: 131
    };
    undomem_show_int("save plants-capacity-demo", save_level_state(".build/plants-capacity-demo.txt",
        l));
    expect {|
        save plants-capacity-demo: 0
    |}
}
