tag block_game;
use_tag gl, x11, freetype;

import "../gl/gl.l8";
import "../freetype/ft.l8";
import "level.l8";
import "block-game-undo.l8";
import "block-game-play.l8";
import "block-game-editor.l8";
import "block-game-render.l8";
import "block-game-ui.l8";


extern glGetBufferSubData(target: int, offset: int, size: int, data: *f32): int;

// Run with DISPLAY set; uses an unmapped GLX window for GPU cache checks.
main(): int {
    brush_result: BrushEdit;
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) { return 1; }
    d: *i8 = d0;
    attr: []i32 = [4i32, 0i32];
    v0: ?*XVisualInfo = glXChooseVisual(d, XDefaultScreen(d), attr);
    if (v0 == null) { return 2; }
    v: *XVisualInfo = v0;
    w: int = XCreateSimpleWindow(d, XRootWindow(d, XDefaultScreen(d)), 0, 0, 16, 16, 0, 0, 0);
    c0: ?*i8 = glXCreateContext(d, v, null, 1);
    if (c0 == null) { return 3; }
    c: *i8 = c0;
    if (glXMakeCurrent(d, w, c) == 0) { return 4; }
    cache: *GrassCache = new_grass_cache();
    buf: []u32 = new u32[1](0u32);
    glGenBuffers(1, buf);
    ground: []GroundCell = new GroundCell[3](GroundCell {
        column: 0, row: 0, style: GROUND_GRASS, stone: 0
    });
    vp: []f32 = new f32[16](0.0);
    vp[0] = 0.01; vp[5] = 0.01; vp[10] = 0.01; vp[15] = 1.0;
    ground[1].column = -2;
    ground[1].style = GROUND_TALL_GRASS;
    ground[2].column = 5;
    update_grass_cache(cache, ground, 3);
    prepare_grass_batch(cache, buf[0], vp);
    if (cache.counts[0] != 81 || cache.batch_n < 192) { return 5; }
    tall_offset: int = GRASS_CELL_CAP * GRASS_INSTANCE_FLOATS + 5;
    if (cache.vertices[tall_offset] < 1.0 || cache.vertices[tall_offset] >= 2.0) { return 16; }
    // A sentinel survives an unchanged update, proving no redundant upload.
    sample: []f32 = [123.0, 456.0];
    glBufferSubData(34962, 0, 8, sample);
    update_grass_cache(cache, ground, 3);
    prepare_grass_batch(cache, buf[0], vp);
    glGetBufferSubData(34962, 0, 8, sample);
    if (sample[0] != 123.0 || sample[1] != 456.0) { return 6; }
    // Camera changes that preserve visibility leave the upload intact too.
    vp[12] = 0.01;
    prepare_grass_batch(cache, buf[0], vp);
    glGetBufferSubData(34962, 0, 8, sample);
    if (sample[0] != 123.0) { return 12; }
    vp[12] = 10.0;
    prepare_grass_batch(cache, buf[0], vp);
    if (cache.batch_n != 0) { return 13; }
    vp[12] = 0.0;
    prepare_grass_batch(cache, buf[0], vp);
    glGetBufferSubData(34962, 0, 8, sample);
    if (sample[0] != cache.batch[0] || sample[1] != cache.batch[1] || cache.batch_n == 0) {
        return 14;
    }
    // Removing grass compacts later cells; moving/reordering must refresh data.
    ground[0].style = GROUND_DIRT;
    ground[1].column = -4;
    update_grass_cache(cache, ground, 3);
    prepare_grass_batch(cache, buf[0], vp);
    glGetBufferSubData(34962, 0, 8, sample);
    if (cache.counts[0] != 0 || sample[0] < -4.07 || sample[0] >= -2.93) { return 7; }
    ground[0] = ground[2];
    update_grass_cache(cache, ground, 1);
    prepare_grass_batch(cache, buf[0], vp);
    glGetBufferSubData(34962, 0, 8, sample);
    if (cache.n != 1 || sample[0] < 4.93 || sample[0] >= 6.07) { return 8; }
    update_grass_cache(cache, ground, 0);
    prepare_grass_batch(cache, buf[0], vp);
    update_grass_cache(cache, ground, 3);
    prepare_grass_batch(cache, buf[0], vp);
    if (cache.n != 3 || cache.counts[2] == 0) { return 9; }
    for col in [-4096, -100, -2, -1, 0, 1, 17, 4000, 4095] {
        for row in [-4096, -1, 0, 1, 4095] {
            n: int = fill_grass_cell(cache.vertices, 0, col, row);
            if (n < 64 || n > GRASS_CELL_CAP) { return 10; }
            for i in 0..n {
                x: f32 = cache.vertices[i * GRASS_INSTANCE_FLOATS];
                z: f32 = cache.vertices[i * GRASS_INSTANCE_FLOATS + 1];
                ca: f32 = cache.vertices[i * GRASS_INSTANCE_FLOATS + 2];
                sa: f32 = cache.vertices[i * GRASS_INSTANCE_FLOATS + 3];
                packed: f32 = cache.vertices[i * GRASS_INSTANCE_FLOATS + 4];
                sx: f32 = fract_f32(packed);
                sy: f32 = cache.vertices[i * GRASS_INSTANCE_FLOATS + 5];
                if (x < col as f32 - 0.07 || x >= (col + 1) as f32 + 0.07 ||
                    z < row as f32 - 0.07 || z >= (row + 1) as f32 + 0.07) {
                    return 11;
                }
                unit: f32 = ca * ca + sa * sa;
                if (unit < 0.998 || unit > 1.002 || sx < 0.0 || sx >= 1.0 || sy < 0.0 ||
                    sy >= 1.0 || packed < 0.0 || packed >= 256.0) {
                    return 15;
                }
            }
        }
    }
    tall_n: int = fill_grass_cell_style(cache.vertices, 0, 4, 7, GROUND_TALL_GRASS);
    for i in 0..tall_n {
        sy: f32 = cache.vertices[i * GRASS_INSTANCE_FLOATS + 5];
        if (sy < 1.0 || sy >= 2.0) { return 17; }
    }
    mask: []i8 = new i8[MASK_SIZE * MASK_SIZE](0i8);
    tall_ground: []GroundCell = [GroundCell {
        column: 3, row: 4, style: GROUND_TALL_GRASS, stone: 0
    }];
    fill_ground_mask(mask, tall_ground, 1, 0, 0);
    if (mask[4 * MASK_SIZE + 3] != 110i8) { return 18; }
    if (!brush_slot_on(22, Brush.TallGrass, 0)) { return 19; }
    saved: *LevelState = new_level_state();
    loaded: *LevelState = new_level_state();
    brush_result = apply_level_brush_rect(saved, 3, 4, 3, 4, Brush.TallGrass, 0, false, true);
    if (saved.nground != 1 || saved.ground[0].style != GROUND_TALL_GRASS) { return 22; }
    if (save_level_state(".build/tall-grass-roundtrip.txt", saved) != 0) { return 20; }
    if (load_level_state(".build/tall-grass-roundtrip.txt", loaded) < 0 ||
        loaded.nground != 1 || loaded.ground[0].style != GROUND_TALL_GRASS) { return 21; }
    // Sand is a persistent base terrain, with optional stone and no grass blades.
    brush_result = apply_level_brush_rect(saved, 3, 4, 4, 5, Brush.Sand, 0, false, true);
    if (saved.nground != 4 || !brush_slot_on(23, Brush.Sand, 0)) { return 23; }
    for i in 0..saved.nground { if (saved.ground[i].style != GROUND_SAND) { return 24; } }
    brush_result = apply_level_brush_rect(saved, 3, 4, 3, 4, Brush.Stone, 0, false, true);
    fill_ground_mask(mask, saved.ground, saved.nground, 0, 0);
    if (mask[4*MASK_SIZE+3] != 0i8-56i8 || mask[5*MASK_SIZE+4] != 16i8) { return 25; }
    update_grass_cache(cache, saved.ground, saved.nground);
    for i in 0..saved.nground { if (cache.counts[i] != 0) { return 26; } }
    if (save_level_state(".build/sand-roundtrip.txt", saved) != 0) { return 27; }
    if (load_level_state(".build/sand-roundtrip.txt", loaded) < 0 || loaded.nground != 4) { return 28; }
    stones: int=0;
    for i in 0..loaded.nground {
        if (loaded.ground[i].style != GROUND_SAND) { return 29; }
        stones=stones+loaded.ground[i].stone;
        if (is_water(loaded.ground,loaded.nground,loaded.ground[i].column,loaded.ground[i].row)) { return 30; }
    }
    if (stones != 1) { return 31; }
    brush_result = apply_level_brush_rect(loaded, 4, 5, 4, 5, Brush.Sand, 0, true, true);
    if (brush_result.nground != loaded.nground) { return 34; }
    for i in 0..loaded.nground {
        f: GroundCell=loaded.ground[i];
        if (f.column==4 && f.row==5 && f.style!=GROUND_DIRT) { return 32; }
    }
    fill_icon_mask(mask);
    if (mask[MASK_SIZE+51] != 16i8) { return 33; }
    glXMakeCurrent(d, 0, null);
    glXDestroyContext(d, c);
    XDestroyWindow(d, w);
    XCloseDisplay(d);
    0;
}
