    grass_u[10] = glGetUniformLocation(grass_prog, "wind_origin");
    glUniform1i(grass_u[6], 0);
    glUniform1i(grass_u[7], 1);
    glUniform1i(grass_u[9], 5);
    glUseProgram(grass_cover_prog);
    grass_cover_u: []int = new int[2](0);
    grass_cover_u[0] = glGetUniformLocation(grass_cover_prog, "mask_origin");
    grass_cover_u[1] = glGetUniformLocation(grass_cover_prog, "cover_origin");
    grass_cover_map: int = glGetUniformLocation(grass_cover_prog, "check_map");
    glUniform1i(grass_cover_map, 1);
    glUseProgram(prog);
    u_vp: int = glGetUniformLocation(prog, "vp");
    u_origin: int = glGetUniformLocation(prog, "origin");
    u_scale: int = glGetUniformLocation(prog, "scale");
    u_color: int = glGetUniformLocation(prog, "color");
    u_light: int = glGetUniformLocation(prog, "light");
    u_light_vp: int = glGetUniformLocation(prog, "light_vp");
    u_shadow: int = glGetUniformLocation(prog, "shadow_map");
    glUniform1i(u_shadow, 0);
    u_lag: int = glGetUniformLocation(prog, "lag");
    u_ramp: int = glGetUniformLocation(prog, "ramp_up");
    u_ground: int = glGetUniformLocation(prog, "ground");
    u_cut: int = glGetUniformLocation(prog, "cut");
    u_fade: int = glGetUniformLocation(prog, "fade");
    u_brick: int = glGetUniformLocation(prog, "brick");
    u_check_map: int = glGetUniformLocation(prog, "check_map");
    u_mask_origin: int = glGetUniformLocation(prog, "mask_origin");
    glUniform1f(u_ground, 0.0);
    glUniform1f(u_cut, 0.0);
    glUniform1f(u_fade, 1.0);
    glUniform1f(u_brick, 0.0);
    glUniform1i(u_check_map, 1);
    glUniform2f(u_mask_origin, 0.0, 0.0);
    d_vp: int = glGetUniformLocation(dprog, "vp");
    d_origin: int = glGetUniformLocation(dprog, "origin");
    d_scale: int = glGetUniformLocation(dprog, "scale");
    d_color: int = glGetUniformLocation(dprog, "color");
    d_lag: int = glGetUniformLocation(dprog, "lag");
    d_ramp: int = glGetUniformLocation(dprog, "ramp_up");
    glUseProgram(tprog);
    u_tscreen: int = glGetUniformLocation(tprog, "screen");
    u_tcolor: int = glGetUniformLocation(tprog, "color");
    u_talpha: int = glGetUniformLocation(tprog, "alpha");
    u_ttex: int = glGetUniformLocation(tprog, "tex");
    glUniform1i(u_ttex, 0);
    glUseProgram(gprog);
    u_gscreen: int = glGetUniformLocation(gprog, "screen");
    u_gcolor: int = glGetUniformLocation(gprog, "color");
    u_galpha: int = glGetUniformLocation(gprog, "alpha");
    font: Font = load_default_font();
    hud: Font = load_mono_font();
    tverts: []f32 = new f32[2048](0.0);
    gverts: []f32 = new f32[65536](0.0);
    if (font.ok) {
        write(2, "freetype: DejaVuSans 32px overlay\n", len("freetype: DejaVuSans 32px overlay\n"));
    }
    if (hud.ok) {
        write(2, "freetype: DejaVuSansMono 12px hud\n", len("freetype: DejaVuSansMono 12px hud\n"));
    }
    va: []u32 = new u32[1](0u32);
    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    cube: []f32 = new f32[216](0.0);
    cube_n: int = fill_cube(cube);
    chamfer: []f32 = new f32[2200](0.0);
    chamfer_n: int = fill_chamfer_cube(chamfer);
    ids: []u32 = new u32[5](0u32);
    glGenBuffers(5, ids);
    glBindBuffer(34962, ids[0]);
    glBufferData(34962, cube_n * 4, cube, 35044);
    grass_ids: []u32 = new u32[2](0u32);
    glGenBuffers(2, grass_ids);
    grass_blades: []f32 = new f32[1024](0.0);
    grass_blade_n: int = fill_grass_blades(grass_blades);
    glBindBuffer(34962, grass_ids[0]);
    glBufferData(34962, grass_blade_n * 4, grass_blades, 35044);
    grass_instances: *GrassCache = new_grass_cache();
    glBindBuffer(34962, grass_ids[1]);
    grass_cover_quad: []f32 = [
        0.0 - 1.0, 0.0 - 1.0, 1.0, 0.0 - 1.0, 1.0, 1.0,
        0.0 - 1.0, 0.0 - 1.0, 1.0, 1.0, 0.0 - 1.0, 1.0
    ];
    grass_cover_buf: []u32 = new u32[1](0u32);
    glGenBuffers(1, grass_cover_buf);
    glBindBuffer(34962, grass_cover_buf[0]);
    glBufferData(34962, 48, grass_cover_quad, 35044);
    bubble: []f32 = new f32[36](0.0);
    bubble_n: int = fill_bubble_quad(bubble);
    bbuf: []u32 = new u32[1](0u32);
    glGenBuffers(1, bbuf);
    glBindBuffer(34962, bbuf[0]);
    glBufferData(34962, bubble_n * 4, bubble, 35044);
    glBindBuffer(34962, ids[2]);
    glBufferData(34962, chamfer_n * 4, chamfer, 35044);
    wall_verts: []f32 = new f32[7000000](0.0);
    brick_used: []int = new int[2048](0);
    brick_n: int = upload_brick_mesh(ids[4], wall_verts, chamfer, level.bricks, level.nbricks,
        brick_used);
    icon_bricks: []Brick = new Brick[1](empty_brick);
    icon_brick_used: []int = new int[1](0);
    icon_brick_ids: []u32 = new u32[1](0u32);
    glGenBuffers(1, icon_brick_ids);
    icon_brick_n: int = upload_brick_mesh(icon_brick_ids[0], wall_verts, chamfer,
        icon_bricks, 1, icon_brick_used);
    ramps: []f32 = new f32[8800](0.0);
    rd0: int = 1;
    while (rd0 <= 4) {
        rn0: int = fill_chamfer_ramp(chamfer, rd0);
        rj: int = 0;
        while (rj < rn0) {
            ramps[(rd0 - 1) * chamfer_n + rj] = chamfer[rj];
            rj = rj + 1;
        }
        rd0 = rd0 + 1;
    }
    glBindBuffer(34962, ids[3]);
    glBufferData(34962, chamfer_n * 16, ramps, 35044);
    bind_mesh(ids[0]);
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(1);
    tbuf: []u32 = new u32[1](0u32);
    glGenBuffers(1, tbuf);
    gbuf: []u32 = new u32[1](0u32);
    glGenBuffers(1, gbuf);
    ftex: []u32 = new u32[1](0u32);
    glGenTextures(1, ftex);
    if (font.ok) {
        glBindTexture(3553, ftex[0]);
        glPixelStorei(3317, 1);
        glTexParameteri(3553, 10241, 9729);
        glTexParameteri(3553, 10240, 9729);
        glTexParameteri(3553, 10242, 33071);
        glTexParameteri(3553, 10243, 33071);
        glTexImage2D(3553, 0, 6409, font.w, font.h, 0, 6409, 5121, font.atlas);
    }
    htex: []u32 = new u32[1](0u32);
    glGenTextures(1, htex);
    if (hud.ok) {
        glBindTexture(3553, htex[0]);
        glPixelStorei(3317, 1);
        glTexParameteri(3553, 10241, 9728);
        glTexParameteri(3553, 10240, 9728);
        glTexParameteri(3553, 10242, 33071);
        glTexParameteri(3553, 10243, 33071);
        glTexImage2D(3553, 0, 6409, hud.w, hud.h, 0, 6409, 5121, hud.atlas);
    }
    glEnable(2929);
    stex: []u32 = new u32[1](0u32);
    glGenTextures(1, stex);
    glBindTexture(3553, stex[0]);
    // Hardware bilinear PCF: filter depth comparisons, not depth values.
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 34892, 34894); // COMPARE_R_TO_TEXTURE
    glTexParameteri(3553, 34893, 515); // LEQUAL
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 33190, SHADOW_SIZE, SHADOW_SIZE, 0, 6402, 5125, null);
    ctex: []u32 = new u32[1](0u32);
    cmask: []i8 = new i8[65536](0i8);
    glGenTextures(1, ctex);
    glBindTexture(3553, ctex[0]);
    glTexParameteri(3553, 10241, 9728);
    glTexParameteri(3553, 10240, 9728);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 6409, MASK_SIZE, MASK_SIZE, 0, 6409, 5121, cmask);
    grass_cover_tex: []u32 = new u32[1](0u32);
    glGenTextures(1, grass_cover_tex);
    glBindTexture(3553, grass_cover_tex[0]);
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 32856, GRASS_COVER_SIZE, GRASS_COVER_SIZE, 0, 6408, 5121,
        null);
    imask: []i8 = new i8[65536](0i8);
    fill_icon_mask(imask);
    itex: []u32 = new u32[1](0u32);
    glGenTextures(1, itex);
    glBindTexture(3553, itex[0]);
    glTexParameteri(3553, 10241, 9728);
    glTexParameteri(3553, 10240, 9728);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 6409, MASK_SIZE, MASK_SIZE, 0, 6409, 5121, imask);
    fbos: []u32 = new u32[1](0u32);
    glGenFramebuffers(1, fbos);
    glBindFramebuffer(36160, fbos[0]);
    glFramebufferTexture2D(36160, 36096, 3553, stex[0], 0);
    glDrawBuffer(0);
    glReadBuffer(0);
    if (glCheckFramebufferStatus(36160) != 36053) {
        die("shadow framebuffer incomplete");
    }
    grass_cover_fbo: []u32 = new u32[1](0u32);
    glGenFramebuffers(1, grass_cover_fbo);
    glBindFramebuffer(36160, grass_cover_fbo[0]);
    glFramebufferTexture2D(36160, 36064, 3553, grass_cover_tex[0], 0);
    glDrawBuffer(36064);
    glReadBuffer(36064);
    if (glCheckFramebufferStatus(36160) != 36053) {
        die("grass coverage framebuffer incomplete");
    }
    grass_cover: *GrassCoverage = new GrassCoverage {
        prog: grass_cover_prog,
        u_mask_origin: grass_cover_u[0],
        u_cover_origin: grass_cover_u[1],
        buf: grass_cover_buf[0],
        fbo: grass_cover_fbo[0],
        tex: grass_cover_tex[0]
    };
    glBindFramebuffer(36160, 0u32);
    glViewport(0, 0, 1200, 720);
    glClearColor(0.07, 0.06, 0.055, 1.0);
    glClear(16640);
    glXSwapBuffers(dpy, win);
    lamp_light: *LampLight = new_lamp_light(prog, grass_prog, bprog);
    material_light: *MaterialLight = new_material_light(prog, grass_prog);
    proj: []f32 = new f32[16](0.0);
    view: []f32 = new f32[16](0.0);
    vp: []f32 = new f32[16](0.0);
    mtmp: []f32 = new f32[16](0.0);
    lproj: []f32 = new f32[16](0.0);
    shadow_corners: []f32 = new f32[24](0.0);
    shadow_bounds: []f32 = new f32[4](0.0);
    lview: []f32 = new f32[16](0.0);
    lcam: []f32 = new f32[16](0.0);
    lvp: []f32 = new f32[16](0.0);
    lbias: []f32 = new f32[16](0.0);
    mat_persp(proj, 2.1445, win_w / win_h, 0.4, 80.0);
    mat_bias(lbias);
    active: *LevelState = new_level_state();
    copy_level_state(active, level);
    block_t: []f32 = new f32[2048](0.0);
    shape_verts: []f32 = new f32[2200](0.0);
    lagx: []f32 = new f32[LEVEL_MAX_BLOCKS+1](0.0);
    lagz: []f32 = new f32[LEVEL_MAX_BLOCKS+1](0.0);
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    shift: bool = false;
    help_held: bool = false;
    fps: FpsMeter = FpsMeter {
        on: false,
        i: 0,
        n: 0,
        work0: 0,
        pending_work: 0,
        flo: 0.0,
        fhi: 0.0,
        mlo: 0.0,
        mhi: 0.0,
        f_step: 0.0,
        m_step: 0.0,
        h_step: 0.0,
        x_step: 0.0,
        hlo: 0.0,
        hhi: 0.0
    };
    fps_t: []int = new int[FPS_CAP](0);
    fps_work: []int = new int[FPS_CAP](0);
    fps_frame: []int = new int[FPS_CAP](0);
    fps_rate: []f32 = new f32[FPS_CAP](0.0);
    fps_mem: []int = new int[FPS_CAP](0);
    fps_lab: []i8 = new i8[24](0i8);
    present_us: []int = new int[1](0);
    mask_cache: []int = new int[5](0);
    mask_cache[0] = 0 - 999999;
    mask_cache[3] = 0 - 999999;
    prep_cache: []int = new int[12](0);
    lean_to: []int = new int[2048](0);
    lean_from: []int = new int[2048](0);
    id_to: []int = new int[4096](0);
    id_from: []int = new int[4096](0);
    cell_head: []int = new int[4096](0);
    cell_link: []int = new int[2048](0);
    col_body: []int = new int[9](0);
    col_ramp: []int = new int[9](0);
    if (edit_mode) {
        cc: int = 0;
        cr: int = 0;
        apply_level_gravity(active);
        dirty_level: bool = false;
        dirty_world: bool = false;
        need_mesh: bool = false;
        counts: []int = new int[5](0);
        xy: []int = new int[2](0);
        focus_x: f32 = 0.5;
        focus_z: f32 = 0.5;
        camera_dist: f32 = CAM_BACK;
        camera_want_dist: f32 = CAM_BACK;
        camera_turn: int = 0;
        camera_yaw: f32 = 0.0;
        camera_want_yaw: f32 = 0.0;
        camera_x: f32 = 0.5;
        camera_y: f32 = CAM_BACK * 0.978;
        camera_z: f32 = 0.5 + CAM_BACK;
        camera_ms: int = mono_ms();
        from_x: f32 = 0.5;
        from_z: f32 = 0.5;
        from_y: f32 = 0.02;
        from_lx: f32 = 0.0;
        from_lz: f32 = 0.0;
        vis_y: f32 = 0.02;
        vis_lx: f32 = 0.0;
        vis_lz: f32 = 0.0;
        anim_c: int = 0;
        anim_r: int = 0;
        cursor_started: int = 0;
        cur_pose: CursorPose = CursorPose { lean_x: 0.0, y: 0.02, lean_z: 0.0 };
        arrow_dir: GridStep = GridStep { dc: 0, dr: 0 };
        paint_brush: Brush = Brush.Block;
        brush_shape: int = 0;
        paint_edit: BrushEdit = BrushEdit { nblocks: 0, nbricks: 0, ngoals: 0,
            nground: 0, nrooms: 0, spawn: Cell { column: 0, row: 0 },
            mesh_changed: false, mask_changed: false };
        icon_proj: []f32 = new f32[16](0.0);
        icon_view: []f32 = new f32[16](0.0);
        icon_vp: []f32 = new f32[16](0.0);
        icon_tmp: []f32 = new f32[16](0.0);
        icon_lvp: []f32 = new f32[16](0.0);
        icon_look: []f32 = new f32[2](0.0);
        mat_persp(icon_proj, 1.92, 1.0, 0.2, 24.0);
        mat_zero(icon_lvp);
        paint_anchor: bool = false;
        paint_c: int = 0;
        paint_r: int = 0;
        name_mode: bool = false;
        new_name: []i8 = "";
        name_error: []i8 = "";
        key_text: []i8 = new i8[8](0i8);
        move_mode: int = 0;
        move_sel: int = 0 - 1;
        move_dc: int = 0;
        move_dr: int = 0;
        move_rot: int = 0;
        move_w: int = 1;
        move_h: int = 1;
        move_ok: bool = true;
        move_cursor_c: int = 0;
        move_cursor_r: int = 0;
        move_level: *LevelState = new_level_state();
        move_counts: []int = new int[4](0);
        help1: []i8 = "";
        help2: []i8 = "";
        held_l: bool = false;
        held_r: bool = false;
        held_u: bool = false;
        held_d: bool = false;
        need_step: bool = false;
        step_dc: int = 0;
        step_dr: int = 0;
        arrow_t0: int = 0;
        arrow_last: int = 0;
        while (running) {
            need_step = false;
            step_dc = 0;
            step_dr = 0;
            while (XPending(dpy) != 0) {
                XNextEvent(dpy, &ev);
                match ev {
                    KeyPress -> {
                        ks: int = XLookupKeysym(&ev, 0);
                        if (ks == 65475) {
                            material_light.wind.debug = !material_light.wind.debug;
                        } else if (ks == 65476) {
                            toggle_height_water(material_light.water);
                        } else if (ks == 65477) {
                            request_height_splash(material_light.water);
                        } else if (ks == 47 || ks == 63) {
                            help_held = true;
                        } else if (move_mode != 0) {
                            changed: bool = false;
                            if (ks == 65307) {
                                copy_level_state(active, move_level);
                                cc = move_cursor_c;
                                cr = move_cursor_r;
                                move_mode = 0;
                                prep_cache[7] = 0;
                                mask_cache[0] = 0 - 999999;
                                need_mesh = true;
                            } else if (ks == 65293 || ks == 65421) {
                                if (move_ok) {
                                    copy_level_state(active, move_level);
                                    old_room: Room = move_level.rooms[move_sel];
                                    new_room: Room = Room {
                                        x0: old_room.x0 + move_dc,
                                        y0: old_room.y0 + move_dr,
                                        x1: old_room.x0 + move_dc + move_w - 1,
                                        y1: old_room.y0 + move_dr + move_h - 1
                                    };
                                    if (move_mode == 1) {
                                        new_room = transform_room_rect(old_room, move_dc,
                                            move_dr, move_rot);
                                        clear_room_destination(active.blocks, active.nblocks,
                                            active.goals, active.ngoals, active.bricks,
                                            active.nbricks, active.ground, active.nground,
                                            old_room, new_room, move_counts);
                                        active.nblocks = move_counts[0];
                                        active.ngoals = move_counts[1];
                                        active.nbricks = move_counts[2];
                                        active.nground = move_counts[3];
                                        transform_level_room(active, move_sel, move_dc,
                                            move_dr, move_rot, xy);
                                    } else {
                                        active.rooms[move_sel] = new_room;
                                    }
                                    dirty_world = true;
                                    move_mode = 0;
                                    prep_cache[7] = 0;
                                    mask_cache[0] = 0 - 999999;
                                    need_mesh = true;
                                    clear_sparks(sparks);
                                }
                            } else if (ks == 65361 || ks == 65363 || ks == 65362 || ks == 65364) {
                                arrow_dir = editor_arrow_step(ks, camera_turn);
                                move_dc = move_dc + arrow_dir.dc;
                                move_dr = move_dr + arrow_dir.dr;
                                cc = cc + arrow_dir.dc;
                                cr = cr + arrow_dir.dr;
                                changed = true;
                            } else if ((ks == 111 || ks == 79) && move_mode == 1) {
                                move_rot = (move_rot + 1) % 4;
                                changed = true;
                            } else if (ks == 44) {
                                camera_turn = (camera_turn + 3) % 4;
                                camera_want_yaw = camera_want_yaw - 1.5707964;
                            } else if (ks == 46) {
                                camera_turn = (camera_turn + 1) % 4;
                                camera_want_yaw = camera_want_yaw + 1.5707964;
                            } else if (ks == 45 || ks == 65453) {
                                camera_want_dist = camera_want_dist + 1.5;
                                if (camera_want_dist > 28.0) {
                                    camera_want_dist = 28.0;
                                }
                            } else if (ks == 61 || ks == 65451) {
                                camera_want_dist = camera_want_dist - 1.5;
                                if (camera_want_dist < 6.0) {
                                    camera_want_dist = 6.0;
                                }
                            } else if (move_mode == 2 && ks == 91 && move_w > 1) {
                                move_w = move_w - 1;
                                changed = true;
                            } else if (move_mode == 2 && ks == 93) {
                                move_w = move_w + 1;
                                changed = true;
                            } else if (move_mode == 2 && ks == 59 && move_h > 1) {
                                move_h = move_h - 1;
                                changed = true;
                            } else if (move_mode == 2 && ks == 39) {
                                move_h = move_h + 1;
                                changed = true;
                            }
                            if (changed) {
                                source_room: Room = move_level.rooms[move_sel];
                                candidate: Room = Room {
                                    x0: source_room.x0 + move_dc,
                                    y0: source_room.y0 + move_dr,
                                    x1: source_room.x0 + move_dc + move_w - 1,
                                    y1: source_room.y0 + move_dr + move_h - 1
                                };
                                if (move_mode == 1) {
                                    candidate = transform_room_rect(source_room, move_dc,
                                        move_dr, move_rot);
                                }
                                move_ok = false;
                                if (in_bounds(candidate.x0, candidate.y0) && in_bounds(candidate.x1,
                                    candidate.y1) && !room_overlaps_other(move_level.rooms,
                                    active.nrooms, move_sel, candidate)) {
                                    move_ok = true;
                                }
                                if (move_mode == 1) {
                                    preview_room_transform(move_level, active, move_sel,
                                        move_dc, move_dr, move_rot, xy);
                                } else {
                                    copy_level_state(active, move_level);
                                    active.rooms[move_sel] = candidate;
                                }
                                prep_cache[7] = 0;
                                mask_cache[0] = 0 - 999999;
                                need_mesh = true;
                            }
                        } else if (name_mode) {
                            if (ks == 65307) {
                                name_mode = false;
                                new_name = "";
                                name_error = "";
                            } else if (ks == 65288) {
                                new_name = text_pop(new_name);
                                name_error = "";
                            } else if (ks == 65293 || ks == 65421) {
                                want: Room = Room {
                                    x0: cc,
                                    y0: cr,
                                    x1: cc + 11,
                                    y1: cr + 8
                                };
                                if (active.nrooms >= LEVEL_MAX_ROOMS) {
                                    name_error = "world is full";
                                } else if (!valid_level_name(new_name)) {
                                    name_error = "use lowercase letters, numbers, and -";
                                } else if (name_listed(world.names, active.nrooms,
                                    new_name)) {
                                    name_error = "that level already exists";
                                } else if (!in_bounds(want.x0, want.y0) || !in_bounds(want.x1,
                                    want.y1)) {
                                    name_error = "that boundary is outside the world";
                                } else if (room_overlaps_other(active.rooms, active.nrooms,
                                    0 - 1, want)) {
                                    name_error = "that boundary overlaps another level";
                                } else {
                                    world.names[active.nrooms] = new_name;
                                    world.solved[active.nrooms] = 0;
                                    active.nrooms = add_room(active.rooms, active.titles,
                                        active.nrooms, want.x0, want.y0, want.x1,
                                        want.y1, new_name);
                                    dirty_world = true;
                                    paint_anchor = false;
                                    name_mode = false;
                                    name_error = "";
                                }
                            } else {
                                key_text[0] = 0i8;
                                got: int = XLookupString(&ev, key_text, len(key_text),
                                    null, null);
                                if (got > 0 && len(new_name) < 40) {
                                    ch: i8 = key_text[0];
                                    if (ch >= 'A' && ch <= 'Z') {
                                        ch = ch + 32i8;
                                    }
                                    if (ch >= 'a' && ch <= 'z' || ch >= '0' && ch <= '9' || ch == '-') {
                                        new_name = text_push(new_name, ch);
                                        name_error = "";
                                    }
                                }
                            }
                        } else if (ks == 65505 || ks == 65506) {
                            shift = true;
                        } else if (ks == 49) {
                            paint_brush = Brush.Dirt;
                        } else if (ks == 50) {
                            paint_brush = Brush.Grass;
                        } else if (ks == 122 || ks == 90) {
                            paint_brush = Brush.Sand;
                            if(shift || ks==90) { paint_brush=Brush.LooseSand; }
                        } else if (ks == 103 || ks == 71) {
                            paint_brush = Brush.TallGrass;
                        } else if (ks == 102 || ks == 70) {
                            paint_brush = Brush.Stone;
                        } else if (ks == 97 || ks == 65) {
                            paint_brush = Brush.Water;
                        } else if (ks==104 || ks==72 || ks==116 || ks==84 || ks==121 || ks==89 || ks==107 || ks==75) {
                            paint_brush=Brush.Plant; brush_shape=0;
                            if(ks==116 || ks==84) { brush_shape=1; if(shift || ks==84) { brush_shape=2; } }
                            if(ks==121 || ks==89) { brush_shape=3; }
                            if(ks==107 || ks==75) { brush_shape=4; }
                        } else if (ks == 98 || ks == 66) {
                            paint_brush = Brush.Block;
                            brush_shape = 0;
                        } else if (ks == 51 || ks == 52 || ks == 53 || ks == 54 || ks == 55) {
                            paint_brush = Brush.Block;
                            brush_shape = brush_shape_from_key(ks);
                        } else if (ks == 114 || ks == 82) {
                            if (paint_brush == Brush.Ramp) {
                                brush_shape = brush_shape + 1;
                                if (brush_shape > 4) {
                                    brush_shape = 1;
                                }
                            } else {
                                paint_brush = Brush.Ramp;
                                brush_shape = 1;
                            }
                        } else if (ks == 119 || ks == 87) {
                            paint_brush = Brush.Brick;
                        } else if (ks == 99 || ks == 67) {
                            paint_brush = Brush.Goal;
                        } else if (ks == 112 || ks == 80) {
                            paint_brush = Brush.Start;
                        } else if (ks == 101 || ks == 69) {
                            paint_brush = Brush.RoomStart;
                        } else if (ks == 108 || ks == 76) {
                            paint_brush = Brush.Lamp;
                            brush_shape = 0;
                            if (shift || ks == 76) { brush_shape = 1; }
                        } else if (is_fps_key(ks)) {
                            toggle_fps(&fps);
                        } else if (is_vsync_key(ks)) {
                            vsync = set_vsync(dpy, win, !vsync);
                        } else if (ks == 44) {
                            camera_turn = (camera_turn + 3) % 4;
                            camera_want_yaw = camera_want_yaw - 1.5707964;
                        } else if (ks == 46) {
                            camera_turn = (camera_turn + 1) % 4;
                            camera_want_yaw = camera_want_yaw + 1.5707964;
                        } else if (ks == 45 || ks == 65453) {
                            camera_want_dist = camera_want_dist + 1.5;
                            if (camera_want_dist > 28.0) {
                                camera_want_dist = 28.0;
                            }
                        } else if (ks == 61 || ks == 65451) {
                            camera_want_dist = camera_want_dist - 1.5;
                            if (camera_want_dist < 6.0) {
                                camera_want_dist = 6.0;
                            }
                        } else if (ks == 113 || ks == 81) {
                            running = false;
                        } else if (ks == 65307) {
                            paint_anchor = false;
                        } else if (ks == 32) {
                            if (shift) {
                                paint_anchor = true;
                                paint_c = cc;
                                paint_r = cr;
                            } else {
                                c0: int = cc;
                                r0: int = cr;
                                if (paint_anchor) {
                                    c0 = paint_c;
                                    r0 = paint_r;
                                }
                                paint_edit = apply_level_brush_rect(active, c0, r0, cc, cr,
                                    paint_brush, brush_shape, false, is_world);
                                if (paint_edit.mesh_changed) {
                                    need_mesh = true;
                                }
                                if (paint_edit.mask_changed) {
                                    mask_cache[0] = 0 - 999999;
                                }
                                if (is_world) {
                                    dirty_world = true;
                                } else {
                                    dirty_level = true;
                                }
                                paint_anchor = false;
                            }
                        } else if (ks == 65288 || ks == 120 || ks == 88) {
                            c0e: int = cc;
                            r0e: int = cr;
                            if (paint_anchor) {
                                c0e = paint_c;
                                r0e = paint_r;
                            }
                            paint_edit = apply_level_brush_rect(active, c0e, r0e, cc, cr,
                                paint_brush, brush_shape, true, is_world);
                            if (paint_edit.mesh_changed) {
                                need_mesh = true;
                            }
                            if (paint_edit.mask_changed) {
                                mask_cache[0] = 0 - 999999;
                            }
                            if (is_world) {
                                dirty_world = true;
                            } else {
                                dirty_level = true;
                            }
                            paint_anchor = false;
                        } else if (ks == 65361 || ks == 65362 || ks == 65363 || ks == 65364) {
                            is_rep: bool = false;
                            if (ks == 65361 && held_l) {
                                is_rep = true;
                            }
                            if (ks == 65363 && held_r) {
                                is_rep = true;
                            }
                            if (ks == 65362 && held_u) {
                                is_rep = true;
                            }
                            if (ks == 65364 && held_d) {
                                is_rep = true;
                            }
                            if (ks == 65361) {
                                held_l = true;
                            }
                            if (ks == 65363) {
                                held_r = true;
                            }
                            if (ks == 65362) {
                                held_u = true;
                            }
                            if (ks == 65364) {
                                held_d = true;
                            }
                            if (!is_rep) {
                                need_step = true;
                                arrow_t0 = mono_ms();
                                arrow_last = arrow_t0;
                                arrow_dir = editor_arrow_step(ks, camera_turn);
                                step_dc = arrow_dir.dc;
                                step_dr = arrow_dir.dr;
                            }
                        } else if (is_world) {
                            sel: int = room_at(active.rooms, active.nrooms, cc, cr);
                            if (ks == 109 || ks == 77) {
                                if (sel >= 0 && sel < active.nrooms) {
                                    copy_level_state(move_level, active);
                                    move_sel = sel;
                                    move_cursor_c = cc;
                                    move_cursor_r = cr;
                                    move_dc = 0;
                                    move_dr = 0;
                                    move_rot = 0;
                                    move_w = room_size_w(active.rooms[sel]);
                                    move_h = room_size_h(active.rooms[sel]);
                                    move_ok = true;
                                    move_mode = 1;
                                    if (shift) {
                                        move_mode = 2;
                                    }
                                    paint_anchor = false;
                                }
                            } else if (ks == 110 || ks == 78) {
                                name_mode = true;
                                new_name = "";
                                name_error = "";
                            } else if (ks == 65535) {
                                if (sel >= 0 && sel < active.nrooms) {
                                    world.solved[sel] = world.solved[active.nrooms - 1];
                                    active.nrooms = delete_level_boundary(active.rooms,
                                        active.titles, world.names, active.nrooms,
                                        sel);
                                    dirty_world = true;
                                }
                            } else if (ks == 91 || ks == 93 || ks == 59 || ks == 39) {
                                if (sel >= 0 && sel < active.nrooms) {
                                    want: Room = active.rooms[sel];
                                    if (ks == 91 && want.x1 > want.x0) {
                                        want.x1 = want.x1 - 1;
                                    } else if (ks == 93) {
                                        want.x1 = want.x1 + 1;
                                    } else if (ks == 59 && want.y1 > want.y0) {
                                        want.y1 = want.y1 - 1;
                                    } else if (ks == 39) {
                                        want.y1 = want.y1 + 1;
                                    }
                                    if (in_bounds(want.x0, want.y0) && in_bounds(want.x1,
                                        want.y1) && !room_overlaps_other(active.rooms,
                                        active.nrooms, sel, want)) {
                                        active.rooms[sel] = want;
                                        dirty_world = true;
                                    }
                                }
                            } else if (ks == 115 || ks == 83) {
                                save_failed: int = 0;
                                region {
                                    save_failed = save_world_state(path, world, active);
                                }
                                if (save_failed != 0) {
                                    write(2, "save failed\n", len("save failed\n"));
                                } else {
                                    dirty_world = false;
                                    write(2, "saved ", len("saved "));
                                    write(2, path, len(path));
                                    write(2, "\n", 1);
                                }
                            }
                        } else if (ks == 91 || ks == 93 || ks == 59 || ks == 39) {
                            if (active.nrooms < 1) {
                                active.nrooms = set_room_size(active.rooms, active.titles,
                                    0, 12, 9);
                            }
                            rw: int = room_size_w(active.rooms[0]);
                            rh: int = room_size_h(active.rooms[0]);
                            if (ks == 91 && rw > 1) {
                                rw = rw - 1;
                            }
                            if (ks == 93) {
                                rw = rw + 1;
                            }
                            if (ks == 59 && rh > 1) {
                                rh = rh - 1;
                            }
                            if (ks == 39) {
                                rh = rh + 1;
                            }
                            active.nrooms = set_room_size(active.rooms, active.titles,
                                active.nrooms, rw, rh);
                            dirty_level = true;
                        } else if (ks == 105 || ks == 73) {
                            sand_edit_column(active.sand,cc,false);
                            insert_col(active.blocks, active.nblocks, active.rooms,
                                active.nrooms, active.goals, active.ngoals, active.bricks,
                                active.nbricks, active.ground, active.nground, cc);
                            apply_level_gravity(active);
                            need_mesh = true;
                            dirty_level = true;
                        } else if (ks == 100 || ks == 68) {
                            sand_edit_column(active.sand,cc,true);
                            delete_col(active.blocks, active.nblocks, active.rooms,
                                active.titles, active.nrooms, active.goals, active.ngoals,
                                active.bricks, active.nbricks, active.ground, active.nground,
                                cc, counts);
                            active.nblocks = counts[0];
                            active.nrooms = counts[1];
                            active.ngoals = counts[2];
                            active.nbricks = counts[3];
                            active.nground = counts[4];
                            mask_cache[0] = 0 - 999999;
                            apply_level_gravity(active);
                            need_mesh = true;
                            dirty_level = true;
                        } else if (ks == 115 || ks == 83) {
                            save_failed2: int = 0;
                            region {
                                save_failed2 = save_level_state(path, active);
                            }
                            if (save_failed2 != 0) {
                                write(2, "save failed\n", len("save failed\n"));
                            } else {
                                dirty_level = false;
                                write(2, "saved ", len("saved "));
                                write(2, path, len(path));
                                write(2, "\n", 1);
                            }
                        }
                    }
                    KeyRelease -> {
                        kr: int = XLookupKeysym(&ev, 0);
                        if (kr == 47 || kr == 63) {
                            help_held = false;
                        } else if (kr == 65505 || kr == 65506) {
                            shift = false;
                        } else if (kr == 65361) {
                            held_l = false;
                        } else if (kr == 65363) {
                            held_r = false;
                        } else if (kr == 65362) {
                            held_u = false;
                        } else if (kr == 65364) {
                            held_d = false;
                        }
                    }
                    DestroyNotify -> {
                        running = false;
                        alive = false;
                    }
                    ClientMessage c -> {
                        if (c.l0 == proto[0]) {
                            running = false;
                        }
                    }
                    _ -> { }
                }
            }
            if (!need_step && (held_l || held_r || held_u || held_d)) {
                now_ms: int = mono_ms();
                if (now_ms - arrow_t0 >= 280 && now_ms - arrow_last >= 50) {
                    need_step = true;
                    arrow_last = now_ms;
                    if (held_l) {
                        arrow_dir = editor_arrow_step(65361, camera_turn);
                    } else if (held_r) {
                        arrow_dir = editor_arrow_step(65363, camera_turn);
                    } else if (held_u) {
                        arrow_dir = editor_arrow_step(65362, camera_turn);
                    } else {
                        arrow_dir = editor_arrow_step(65364, camera_turn);
                    }
                    step_dc = arrow_dir.dc;
                    step_dr = arrow_dir.dr;
                }
            }
            if (need_step) {
                tc: int = cc + step_dc;
                tr: int = cr + step_dr;
                if (in_bounds(tc, tr)) {
                    cc = tc;
                    cr = tr;
                }
            }
            if (need_mesh) {
                brick_n = upload_brick_mesh(ids[4], wall_verts, chamfer, active.bricks,
                    active.nbricks, brick_used);
                need_mesh = false;
            }
            if (running) {
                now_cam: int = mono_ms();
                dt_cam: f32 = (now_cam - camera_ms) as f32 * 0.001;
                if (dt_cam > 0.05) {
                    dt_cam = 0.05;
                }
                if (dt_cam < 0.0) {
                    dt_cam = 0.0;
                }
                camera_ms = now_cam;
                cam_k: f32 = dt_cam / 0.34;
                if (cam_k > 1.0) {
                    cam_k = 1.0;
                }
                want_x: f32 = cc as f32 + 0.5;
                want_z: f32 = cr as f32 + 0.5;
                cur_pose = editor_cursor_pose(active.blocks, active.nblocks, cc, cr);
                if (cc != anim_c || cr != anim_r) {
                    from_x = focus_x;
                    from_z = focus_z;
                    from_y = vis_y;
                    from_lx = vis_lx;
                    from_lz = vis_lz;
                    anim_c = cc;
                    anim_r = cr;
                    cursor_started = now_cam;
                }
                ct: f32 = 1.0;
                if (focus_x != want_x || focus_z != want_z) {
                    ct = (now_cam - cursor_started) as f32 / 200.0;
                    if (ct > 1.0) {
                        ct = 1.0;
                    }
                    if (ct < 0.0) {
                        ct = 0.0;
                    }
                }
                focus_x = lerp(from_x, want_x, ct);
                focus_z = lerp(from_z, want_z, ct);
                vis_y = lerp(from_y, cur_pose.y, ct);
                vis_lx = lerp(from_lx, cur_pose.lean_x, ct);
                vis_lz = lerp(from_lz, cur_pose.lean_z, ct);
                camera_yaw = camera_yaw + (camera_want_yaw - camera_yaw) * cam_k;
                camera_dist = camera_dist + (camera_want_dist - camera_dist) * cam_k;
                camera_x = focus_x + sin_f32(camera_yaw) * camera_dist;
                camera_y = camera_dist * 0.978;
                camera_z = focus_z + cos_f32(camera_yaw) * camera_dist;
                mat_look(view, camera_x, camera_y, camera_z, focus_x, 0.0, focus_z,
                    0.0, 1.0, 0.0);
                mat_mul(vp, proj, view, mtmp);
                lx: f32 = focus_x + 4.0;
                ly: f32 = 11.0;
                lz: f32 = focus_z + 3.0;
                mat_look(lview, lx, ly, lz, focus_x, 0.0, focus_z, 0.0, 0.0, -1.0);
                fit_moon_shadow(lproj, view, proj, lview, lx, lz, shadow_corners, shadow_bounds);
                mat_mul(lcam, lproj, lview, mtmp);
                mat_mul(lvp, lbias, lcam, mtmp);
                sc: int = active.spawn.column;
                sr: int = active.spawn.row;
                st_top: int = highest_layer_at(active.blocks, active.nblocks, sc,
                    sr);
                st_y: f32 = 0.55;
                if (st_top >= 0) {
                    st_y = sit_y(active.blocks, 0, active.nblocks, sc, sr, st_top) + 1.0;
                }
                now_e: int = mono_ms();
                dt_e: f32 = spark_dt(spark_last, now_e);
                step_sparks(sparks, spark_rng, spark_acc, active.rooms,
                    0, world.solved, stream_until, stream_tx, stream_tz, focus_x,
                    focus_z, now_e, dt_e, false, 0.0, 0.0, active.goals, active.ngoals,
                    active.bricks, active.nbricks, active.blocks, active.nblocks,
                    finish_acc, 0 - 1);
                draw_frame(prog, dprog, u_vp, u_origin, u_scale, u_color, u_light,
                    u_light_vp, u_lag, d_vp, d_origin, d_scale, d_color, d_lag, ids[0],
                    ids[1], ids[2], ids[3], chamfer_n, ids[4], brick_n, fbos[0], stex[0],
                    ctex[0], cmask, active.ground, active.nground, active.rooms, active.nrooms,
                    focus_x, focus_z, camera_x, camera_y, camera_z, u_mask_origin,
                    vp, lcam, lvp, shadow_bounds, lx, ly, lz, active.blocks, 0, 0, active.nblocks,
                    sc as f32, st_y, sr as f32, 0.0, shape_verts, lagx, lagz, 1, cc,
                    cr, focus_x + vis_lx, vis_y, focus_z + vis_lz, true, paint_brush,
                    brush_shape, move_mode != 0, move_sel, move_ok, paint_c, paint_r, paint_anchor,
                    u_ramp, u_ground, u_cut, u_fade, u_brick, d_ramp, 0.0, 0.0, present_us,
                    mask_cache, lean_to, lean_from, id_to, id_from, cell_head, cell_link,
                    block_t, prep_cache, sparks, bprog, b_u, bbuf[0], bdprog, bd_u,
                    grass_prog, grass_u, grass_cover, grass_ids[0], grass_ids[1], grass_instances,
                    grass_blade_n, lamp_light, active.lamps, active.nlamps,
                    material_light, active.bricks, active.nbricks, active.sand);
                draw_room_start_pads(u_origin, u_scale, u_color, ids[0], active.room_starts,
                    active.nrooms);
                if (name_mode) {
                    help1 = "new level: type a lowercase name, Enter creates it, Escape cancels";
                    help2 = name_error;
                } else if (move_mode != 0) {
                    help1 = "moving level: arrows move  o rotates  Enter confirms  Escape cancels";
                    if (move_mode == 2) {
                        help1 = "editing bounds only: arrows move  [ ] width  ; ' height";
                    }
                    help2 = "clear to place";
                    if (!move_ok) {
                        help2 = "blocked: level boundaries cannot overlap";
                    }
                }
                glDisable(2929);
                glEnable(3042);
                glBlendFunc(770, 771);
                if (len(help1) > 0) {
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 648.0, help1);
                }
                if (len(help2) > 0) {
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 680.0, help2);
                }
                if (help_held) {
                    draw_editor_help_panel(font, hud, tprog, u_tscreen, u_tcolor,
                        u_talpha, ftex[0], htex[0], tbuf[0], tverts, gprog, u_gscreen,
                        u_gcolor, u_galpha, gbuf[0], gverts);
                } else if (!name_mode && move_mode == 0) {
                    draw_title_layer(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex[0],
                        tbuf[0], tverts, 20.0, 698.0, "?  hold for keys", 0.90, 0.86,
                        0.76, 0.72);
                }
                if (is_world) {
                    on2: int = room_at(active.rooms, active.nrooms, cc, cr);
                    if (on2 >= 0 && on2 < active.nrooms && len(active.titles[on2]) > 0) {
                        draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                            tbuf[0], tverts, 20.0, active.titles[on2]);
                    }
                } else if (active.nrooms > 0 && len(active.titles[0]) > 0) {
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 20.0, active.titles[0]);
                }
                if (edit_mode && !help_held) {
                    draw_brush_panel(material_light.plants, hud, tprog, u_tscreen, u_tcolor, u_talpha, htex[0],
                        tbuf[0], tverts, gprog, u_gscreen, u_gcolor, u_galpha, gbuf[0],
                        gverts, prog, u_vp, u_origin, u_scale, u_color, u_light, u_light_vp,
                        u_lag, u_ramp, u_ground, u_cut, u_brick, u_mask_origin, ids[0],
                        ids[2], ids[3], ids[1], icon_brick_ids[0], chamfer_n, icon_brick_n,
                        shape_verts, itex[0], icon_proj, icon_view, icon_vp, icon_tmp,
                        icon_lvp, icon_look, paint_brush, brush_shape);
                }
                if (name_mode) {
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 320.0, "name:");
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 352.0, new_name);
                }
                tick_fps(&fps, present_us[0]);
                draw_fps(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex[0],
                    tbuf[0], tverts, gprog, u_gscreen, u_gcolor, u_galpha, gbuf[0],
                    gverts, &fps, fps_t, fps_work, fps_frame, fps_rate, fps_mem, fps_lab);
                glDisable(3042);
                glEnable(2929);
                glXSwapBuffers(dpy, win);
                fps_after_swap(&fps, fps_t, fps_work, fps_frame, fps_rate, fps_mem);
            }
        }
        if (dirty_level || dirty_world) {
            write(2, "quit without saving\n", len("quit without saving\n"));
        }
    } else {
        hist: []Block = new Block[8*LEVEL_MAX_BLOCKS](empty);
        hpc: []int = new int[8](0);
        hpr: []int = new int[8](0);
        hph: []int = new int[8](0);
        hpm: []int = new int[8](0);
        hms: []int = new int[8](200);
        hn: int = 0;
        hstart: int = 0;
        pc: int = active.spawn.column;
        pr: int = active.spawn.row;
        ph: int = plant_spawn_layer(active.blocks,active.nblocks,active.ground,active.nground,pc,pr);
        pm: int = pose_mounted(active.blocks,active.nblocks,pc,pr,ph,0-1);
        copy_blocks(hist, 0, active.blocks, 0, active.nblocks);
        hpc[0] = pc;
        hpr[0] = pr;
        hph[0] = ph;
        hpm[0] = pm;
        hn = 1;
        home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
        room_ids: []int = new int[LEVEL_MAX_BLOCKS](0);
        room_hn: []int = new int[LEVEL_MAX_ROOMS](0);
        rewind_snap: []int = new int[LEVEL_MAX_BLOCKS * REWIND_MAX](0);
        rewind_n: []int = new int[LEVEL_MAX_ROOMS](0);
        rewind_cur: []int = new int[LEVEL_MAX_ROOMS](0);
        room_ghosting: []int = new int[LEVEL_MAX_ROOMS](0);
        // One scratch copy for an attempted move; retained poses use the journal.
        undo_snap: []int = new int[LEVEL_MAX_BLOCKS](0);
        undo_pending: bool = false;
        crate_pose: []int = new int[2048 * 8](0);
        crate_ms: []int = new int[2048 * 8](0);
        crate_hs: []int = new int[2048](0);
        crate_hn: []int = new int[2048](0);
        crate_t0: []int = new int[2048](0);
        play_clock: []int = new int[3](0);
        play_pose: []int = new int[4](0);
        play_pend: []int = new int[2](0);
        // Buffered directions remain intents until their visible step begins.
        move_queue: []int = new int[6](0);
        move_queue_n: int = 0;
        reset_phase: []int = new int[1](0);
        reset_t0: []int = new int[1](0);
        reset_room: []int = new int[1](0 - 1);
        reset_target: []int = new int[1](0 - 1);
        assign_block_homes(active.blocks, active.nblocks, active.rooms, active.nrooms,
            home, room_ids, room_hn);
        undo_timeline: *UndoTimeline = new_undo_timeline(home, active.nblocks, room_hn);
        ri_w: int = 0;
        while (ri_w < active.nrooms) {
            rewind_capture(active.blocks, ri_w, room_ids, room_hn, rewind_snap, 0);
            rewind_n[ri_w] = 1;
            rewind_cur[ri_w] = 0;
            ri_w = ri_w + 1;
        }
        crate_boot(active.blocks, active.nblocks, crate_pose, crate_hs, crate_hn,
            crate_t0);
        started: int = mono_ms();
        cam: []f32 = new f32[2](0.0);
        cam2: []f32 = new f32[2](0.0);
        camera_focus(pc, pr, active.rooms, active.nrooms, cam);
        focus_x: f32 = cam[0];
        focus_z: f32 = cam[1];
        held_l: bool = false;
        held_r: bool = false;
        held_u: bool = false;
        held_d: bool = false;
        held_pref_dc: int = 0;
        held_pref_dr: int = 0;
        chained_dir: []int = new int[2](0);
        travel_mode: bool = false;
        travel_goal: int = 0 - 1;
        play_camera_dist: f32 = CAM_BACK;
        play_camera_ms: int = started;
        topx: []f32 = new f32[LEVEL_MAX_BLOCKS+1](0.0);
        topz: []f32 = new f32[LEVEL_MAX_BLOCKS+1](0.0);
        velx: []f32 = new f32[LEVEL_MAX_BLOCKS+1](0.0);
        velz: []f32 = new f32[LEVEL_MAX_BLOCKS+1](0.0);
        last_ms: []int = new int[1](0);
        while (running) {
            while (XPending(dpy) != 0) {
                XNextEvent(dpy, &ev);
                match ev {
                    KeyPress -> {
                        ks: int = XLookupKeysym(&ev, 0);
                        if (ks == 65475) {
                            material_light.wind.debug = !material_light.wind.debug;
                        } else if (ks == 65476) {
                            toggle_height_water(material_light.water);
                        } else if (ks == 65477) {
                            request_height_splash(material_light.water);
                        } else if (ks == 65505 || ks == 65506) {
                            shift = true;
                        } else if (is_fps_key(ks)) {
                            toggle_fps(&fps);
                        } else if (is_vsync_key(ks)) {
                            vsync = set_vsync(dpy, win, !vsync);
                        } else if (ks == 113 || ks == 81) {
                            running = false;
                        } else if (ks == 65288 && shift) {
                            if (reset_phase[0] == 0 && !undo_pending) {
                                travel_mode = false;
                                undo_pending = false;
                                move_queue_n = 0;
                                undo_clear_journal(undo_timeline);
                                begin_room_reset(active.rooms, active.nrooms, pc,
                                    pr, rewind_n, room_ghosting, active.room_starts,
                                    reset_phase, reset_t0, reset_room, play_pend,
                                    mono_ms());
                            }
                        } else if (ks == 65288) {
                            if (reset_phase[0] == 0) {
                                travel_mode = false;
                                undo_pending = true;
                                move_queue_n = 0;
                                play_pend[0] = 0;
                                play_pend[1] = 0;
                            }
                        } else if (travel_mode) {
                            if (ks == 65307) {
                                travel_mode = false;
                            } else if (ks == 65293 || ks == 65421) {
                                play_pose[0] = pc;
                                play_pose[1] = pr;
                                play_pose[2] = ph;
                                play_pose[3] = pm;
                                play_clock[0] = hstart;
                                play_clock[1] = hn;
                                play_clock[2] = started;
                                if (play_jump_to_finish(active.blocks, active.nblocks,
                                    active.rooms, active.nrooms, active.bricks, active.nbricks,
                                    active.ground, active.nground,
                                    active.goals, active.ngoals, world.solved, play_pose,
                                    play_pend, reset_phase, reset_t0, reset_room,
                                    reset_target, travel_goal, mono_ms())) {
                                    clear_sparks(sparks);
                                    undo_clear_journal(undo_timeline);
                                    undo_pending = false;
                                }
                                travel_mode = false;
                            } else if (ks == 65361 || ks == 65362 || ks == 65363 || ks == 65364) {
                                tdc: int = 0;
                                tdr: int = 0;
                                if (ks == 65361) {
                                    tdc = 0 - 1;
                                } else if (ks == 65363) {
                                    tdc = 1;
                                } else if (ks == 65362) {
                                    tdr = 0 - 1;
                                } else {
                                    tdr = 1;
                                }
                                next_travel_goal: int = visited_finish_in_direction(active.rooms,
                                    active.nrooms, active.goals, active.ngoals, world.solved,
                                    travel_goal, tdc, tdr);
                                if (next_travel_goal != travel_goal) {
                                    travel_goal = next_travel_goal;
                                }
                            }
                        } else if (ks == 65307) {
                            running = false;
                        } else if ((ks == 106 || ks == 74) && reset_phase[0] == 0 && !undo_pending) {
                            travel_goal = closest_visited_finish(active.rooms, active.nrooms,
                                active.goals, active.ngoals, world.solved, pc, pr);
                            if (travel_goal >= 0) {
                                travel_mode = true;
                                move_queue_n = 0;
                                play_pend[0] = 0;
                                play_pend[1] = 0;
                            }
                        } else if (ks == 65361 || ks == 65362 || ks == 65363 || ks == 65364) {
                            is_rep: bool = false;
                            if (ks == 65361 && held_l) {
                                is_rep = true;
                            }
                            if (ks == 65363 && held_r) {
                                is_rep = true;
                            }
                            if (ks == 65362 && held_u) {
                                is_rep = true;
                            }
                            if (ks == 65364 && held_d) {
                                is_rep = true;
                            }
                            if (ks == 65361) {
                                held_l = true;
                            }
                            if (ks == 65363) {
                                held_r = true;
                            }
                            if (ks == 65362) {
                                held_u = true;
                            }
                            if (ks == 65364) {
                                held_d = true;
                            }
                            if (!shift && reset_phase[0] == 0 && !undo_pending) {
                                dc: int = 0;
                                dr: int = 0;
                                if (ks == 65361) {
                                    dc = 0 - 1;
                                } else if (ks == 65363) {
                                    dc = 1;
                                } else if (ks == 65362) {
                                    dr = 0 - 1;
                                } else {
                                    dr = 1;
                                }
                                held_pref_dc = dc;
                                held_pref_dr = dr;
                                if (hn < 2 && move_queue_n == 0) {
                                    play_pose[0] = pc;
                                    play_pose[1] = pr;
                                    play_pose[2] = ph;
                                    play_pose[3] = pm;
                                    play_clock[0] = hstart;
                                    play_clock[1] = hn;
                                    play_clock[2] = started;
                                    play_try_dir(active.blocks, active.nblocks, active.rooms,
                                        active.nrooms, active.bricks, active.nbricks,
                                        active.ground, active.nground,
                                        hist, hpc, hpr, hph, hpm, hms, play_clock,
                                        play_pose, dc, dr, play_pend, room_ids, room_hn,
                                        rewind_snap, rewind_n, rewind_cur, room_ghosting,
                                        active.goals, active.ngoals, world.solved,
                                        stream_until, stream_tx, stream_tz, sparks,
                                        spark_rng, undo_snap, undo_timeline);
                                    pc = play_pose[0];
                                    pr = play_pose[1];
                                    ph = play_pose[2];
                                    pm = play_pose[3];
                                    hstart = play_clock[0];
                                    hn = play_clock[1];
                                    started = play_clock[2];
                                } else if (!is_rep && move_queue_n < 3) {
                                    move_queue[move_queue_n * 2] = dc;
                                    move_queue[move_queue_n * 2 + 1] = dr;
                                    move_queue_n = move_queue_n + 1;
                                }
                            }
                        }
                    }
                    KeyRelease -> {
                        kr: int = XLookupKeysym(&ev, 0);
                        if (kr == 65505 || kr == 65506) {
                            shift = false;
                        } else if (kr == 65361) {
                            held_l = false;
                        } else if (kr == 65363) {
                            held_r = false;
                        } else if (kr == 65362) {
                            held_u = false;
                        } else if (kr == 65364) {
                            held_d = false;
                        }
                    }
                    DestroyNotify -> {
                        running = false;
                        alive = false;
                    }
                    ClientMessage c -> {
                        if (c.l0 == proto[0]) {
                            running = false;
                        }
                    }
                    _ -> { }
                }
            }
            if (running) {
                now: int = mono_ms();
                dur: int = 200;
                if (hn > 1) {
                    dur = hms[(hstart + 1) % 8];
                    if (dur < 200) {
                        dur = 200;
                    }
                }
                advanced_move: bool = false;
                while (hn > 1 && now - started >= dur) {
                    advanced_move = true;
                    hstart = (hstart + 1) % 8;
                    hn = hn - 1;
                    started = started + dur;
                    dur = 200;
                    if (hn > 1) {
                        dur = hms[(hstart + 1) % 8];
                        if (dur < 200) {
                            dur = 200;
                        }
                    }
                }
                if (undo_pending && hn == 1 && reset_phase[0] == 0) {
                    play_pose[0] = pc;
                    play_pose[1] = pr;
                    play_pose[2] = ph;
                    play_pose[3] = pm;
                    play_clock[0] = hstart;
                    play_clock[1] = hn;
                    play_clock[2] = started;
                    undo_result: int = play_undo_step(active.blocks, active.nblocks,
                        active.nrooms, hist, hpc, hpr, hph, hpm, hms, play_clock,
                        play_pose, play_pend, room_ids, room_hn, rewind_snap, rewind_n,
                        rewind_cur, room_ghosting, undo_timeline, crate_pose,
                        crate_ms, crate_hs, crate_hn, crate_t0, now);
                    prep_cache[7] = 0;
                    if (undo_result == PLAY_UNDO_DONE) {
                        pc = play_pose[0];
                        pr = play_pose[1];
                        ph = play_pose[2];
                        pm = play_pose[3];
                        hstart = play_clock[0];
                        hn = play_clock[1];
                        started = play_clock[2];
                        crate_commit_changed(active.blocks, active.nblocks, now, crate_pose,
                            crate_ms, crate_hs, crate_hn, crate_t0);
                        prep_cache[7] = 0;
                    }
                    if (undo_result != PLAY_UNDO_WAIT) {
                        undo_pending = false;
                    }
                }
                t: f32 = 0.0;
                if (hn > 1) {
                    t = (now - started) as f32 / dur as f32;
                    if (t > 1.0) {
                        t = 1.0;
                    }
                }
                fi: int = 0;
                ti: int = 0;
                if (hn > 1) {
                    ti = 1;
                }
                foff: int = hist_off(hstart, fi);
                toff: int = hist_off(hstart, ti);
                play_pose[0] = pc;
                play_pose[1] = pr;
                play_pose[2] = ph;
                play_pose[3] = pm;
                play_clock[0] = hstart;
                play_clock[1] = hn;
                play_clock[2] = started;
                if (tick_reset_sink(active.blocks, active.nblocks, active.ground, active.nground, hist, hpc, hpr,
                    hph, hpm, play_clock, play_pose, now, active.rooms, active.nrooms,
                    room_ids, room_hn, rewind_snap, rewind_n, rewind_cur, room_ghosting,
                    active.room_starts, reset_phase, reset_t0, reset_room, reset_target)) {
                    crate_boot(active.blocks, active.nblocks, crate_pose, crate_hs,
                        crate_hn, crate_t0);
                    prep_cache[7] = 0;
                    t = 0.0;
                    fi = 0;
                    ti = 0;
                    foff = hist_off(play_clock[0], 0);
                    toff = hist_off(play_clock[0], 0);
                }
                pc = play_pose[0];
                pr = play_pose[1];
                ph = play_pose[2];
                pm = play_pose[3];
                hstart = play_clock[0];
                hn = play_clock[1];
                started = play_clock[2];
                chained_dir[0] = 0;
                chained_dir[1] = 0;
                have_chained_dir: bool = false;
                if (reset_phase[0] == 0 && !undo_pending && hn < 2) {
                    if (move_queue_n > 0) {
                        chained_dir[0] = move_queue[0];
                        chained_dir[1] = move_queue[1];
                        qi: int = 1;
                        while (qi < move_queue_n) {
                            move_queue[(qi - 1) * 2] = move_queue[qi * 2];
                            move_queue[(qi - 1) * 2 + 1] = move_queue[qi * 2 + 1];
                            qi = qi + 1;
                        }
                        move_queue_n = move_queue_n - 1;
                        have_chained_dir = true;
                    } else if (advanced_move) {
                        held_direction: HeldDirection = held_play_direction(held_l, held_r,
                            held_u, held_d, held_pref_dc, held_pref_dr);
                        have_chained_dir = held_direction.active;
                        chained_dir[0] = held_direction.dc;
                        chained_dir[1] = held_direction.dr;
                    }
                }
                if (have_chained_dir) {
                    // Keep the exact prior animation boundary. Using mono_ms()
                    // here inserted up to one frame of stationary endpoint time.
                    chain_started: int = started;
                    play_pose[0] = pc;
                    play_pose[1] = pr;
                    play_pose[2] = ph;
                    play_pose[3] = pm;
                    play_clock[0] = hstart;
                    play_clock[1] = hn;
                    play_clock[2] = started;
                    play_try_dir(active.blocks, active.nblocks, active.rooms, active.nrooms,
                        active.bricks, active.nbricks, active.ground, active.nground, hist, hpc, hpr, hph, hpm, hms,
                        play_clock, play_pose, chained_dir[0], chained_dir[1], play_pend,
                        room_ids, room_hn, rewind_snap, rewind_n, rewind_cur, room_ghosting,
                        active.goals, active.ngoals, world.solved, stream_until, stream_tx,
                        stream_tz, sparks, spark_rng, undo_snap, undo_timeline);
                    pc = play_pose[0];
                    pr = play_pose[1];
                    ph = play_pose[2];
                    pm = play_pose[3];
                    hstart = play_clock[0];
                    hn = play_clock[1];
                    started = play_clock[2];
                    if (hn > 1 && advanced_move) {
                        started = chain_started;
                        play_clock[2] = started;
                    }
                    prep_cache[7] = 0;
                }
                if (rewind_tick(active.blocks, active.nblocks, active.nrooms, room_ids,
                    room_hn, rewind_snap, rewind_n, rewind_cur, room_ghosting,
                    crate_pose, crate_ms, crate_hs, crate_hn, crate_t0,
                    now, pc, pr)) {
                    prep_cache[7] = 0;
                }
                fi = 0;
                ti = 0;
                if (hn > 1) {
                    ti = 1;
                    dur = hms[(hstart + 1) % 8];
                    if (dur < 200) { dur = 200; }
                    t = move_anim_t(now, started, dur);
                } else {
                    t = 0.0;
                }
                foff = hist_off(hstart, 0);
                toff = hist_off(hstart, ti);
                if (hn <= 1 && any_crate_anim(crate_hn, active.nblocks)) {
                    toff = hist_off(hstart, 1);
                    copy_blocks(hist, toff, hist, foff, active.nblocks);
                }
                overlay_crate_anims(hist, foff, toff, active.nblocks, crate_pose,
                    crate_ms, crate_hs, crate_hn, crate_t0, block_t, now);
                fc: int = hpc[(hstart + fi) % 8];
                fr: int = hpr[(hstart + fi) % 8];
                tc2: int = hpc[(hstart + ti) % 8];
                tr2: int = hpr[(hstart + ti) % 8];
                camera_focus(fc, fr, active.rooms, active.nrooms, cam);
                camera_focus(tc2, tr2, active.rooms, active.nrooms, cam2);
                want_fx: f32 = lerp(cam[0], cam2[0], t);
                want_fz: f32 = lerp(cam[1], cam2[1], t);
                if (travel_mode && travel_goal >= 0 && travel_goal < active.ngoals) {
                    travel: Goal = active.goals[travel_goal];
                    camera_focus(travel.column, travel.row, active.rooms, active.nrooms,
                        cam2);
                    want_fx = cam2[0];
                    want_fz = cam2[1];
                } else if (reset_target[0] >= 0) {
                    camera_focus(pos_col(reset_target[0]), pos_row(reset_target[0]),
                        active.rooms, active.nrooms, cam2);
                    want_fx = cam2[0];
                    want_fz = cam2[1];
                }
                camera_dt: f32 = (now - play_camera_ms) as f32 * 0.001;
                if (camera_dt < 0.0) {
                    camera_dt = 0.0;
                }
                if (camera_dt > 0.05) {
                    camera_dt = 0.05;
                }
                play_camera_ms = now;
                camera_smooth: f32 = 0.20;
                camera_want_dist: f32 = CAM_BACK;
                if (travel_mode) {
                    camera_smooth = 0.42;
                    camera_want_dist = TRAVEL_CAM_BACK;
                }
                camera_k: f32 = camera_dt / camera_smooth;
                if (camera_k > 1.0) {
                    camera_k = 1.0;
                }
                focus_x = focus_x + (want_fx - focus_x) * camera_k;
                focus_z = focus_z + (want_fz - focus_z) * camera_k;
                zoom_k: f32 = camera_dt / 0.48;
                if (zoom_k > 1.0) {
                    zoom_k = 1.0;
                }
                play_camera_dist = play_camera_dist + (camera_want_dist - play_camera_dist) * zoom_k;
                play_camera_y: f32 = play_camera_dist * (CAM_EYE_Y / CAM_BACK);
                mat_look(view, focus_x, play_camera_y, focus_z + play_camera_dist,
                    focus_x, 0.0, focus_z, 0.0, 1.0, 0.0);
                mat_mul(vp, proj, view, mtmp);
                lx: f32 = focus_x + 4.0;
                ly: f32 = 11.0;
                lz: f32 = focus_z + 3.0;
                mat_look(lview, lx, ly, lz, focus_x, 0.0, focus_z, 0.0, 0.0, -1.0);
                fit_moon_shadow(lproj, view, proj, lview, lx, lz, shadow_corners, shadow_bounds);
                mat_mul(lcam, lproj, lview, mtmp);
                mat_mul(lvp, lbias, lcam, mtmp);
                px: f32 = lerp(fc as f32, tc2 as f32, t);
                pz: f32 = lerp(fr as f32, tr2 as f32, t);
                fh: int = hph[(hstart + fi) % 8];
                th: int = hph[(hstart + ti) % 8];
                fill_stack_col(hist, foff, active.nblocks, fc, fr, col_body, col_ramp);
                fs: bool = false;
                if (fh >= 0-1 && fh < 8 && col_ramp[fh+1] != 0) {
                    fs = true;
                }
                y0: f32 = fh as f32 + 0.55;
                if (fs) {
                    y0 = fh as f32 + 0.5;
                }
                fx0: f32 = 0.0;
                fz0: f32 = 0.0;
                if (fh >= 0-1 && fh < 8) {
                    fx0 = ramp_face_x(col_ramp[fh+1]);
                    fz0 = ramp_face_z(col_ramp[fh+1]);
                }
                pl0: int = 0;
                if (fh >= 0-1 && fh < 8) {
                    pl0 = stack_lean_col(col_body, col_ramp, fh, fs);
                }
                fill_stack_col(hist, toff, active.nblocks, tc2, tr2, col_body, col_ramp);
                ts: bool = false;
                if (th >= 0-1 && th < 8 && col_ramp[th+1] != 0) {
                    ts = true;
                }
                y1: f32 = th as f32 + 0.55;
                if (ts) {
                    y1 = th as f32 + 0.5;
                }
                fx1: f32 = 0.0;
                fz1: f32 = 0.0;
                if (th >= 0-1 && th < 8) {
                    fx1 = ramp_face_x(col_ramp[th+1]);
                    fz1 = ramp_face_z(col_ramp[th+1]);
                }
                pl1: int = 0;
                if (th >= 0-1 && th < 8) {
                    pl1 = stack_lean_col(col_body, col_ramp, th, ts);
                }
                gt: f32 = fall_t(y0, y1, fs, ts, t);
                py: f32 = anim_y(y0, y1, px, pz, fc, fr, tc2, tr2, fx0, fz0, fx1,
                    fz1, fs, ts, t);
                pru_x: f32 = lerp(ramp_face_x(lean_dir(pl0)), ramp_face_x(lean_dir(pl1)),
                    gt);
                pru_z: f32 = lerp(ramp_face_z(lean_dir(pl0)), ramp_face_z(lean_dir(pl1)),
                    gt);
                pk: f32 = lerp(lean_k(pl0) as f32, lean_k(pl1) as f32, gt);
                px = px + lean_along(pru_x, pru_z, pk, 0);
                py = py + lean_along(pru_x, pru_z, pk, 1);
                pz = pz + lean_along(pru_x, pru_z, pk, 2);
                py = py - reset_sink_k(reset_phase[0], reset_t0[0], now) * 1.6;
                tick_soft(hist, foff, toff, active.nblocks, t, px, pz, focus_x, focus_z,
                    topx, topz, velx, velz, lagx, lagz, now, last_ms, block_t);
                on_g: bool = false;
                gx_f: f32 = pc as f32 + 0.5;
                gz_f: f32 = pr as f32 + 0.5;
                if (is_goal(active.goals, active.ngoals, pc, pr)) {
                    on_g = true;
                }
                dt_p: f32 = spark_dt(spark_last, now);
                selector_goal: int = 0 - 1;
                if (travel_mode) {
                    selector_goal = travel_goal;
                }
                step_sparks(sparks, spark_rng, spark_acc, active.rooms,
                    active.nrooms, world.solved, stream_until, stream_tx, stream_tz,
                    focus_x, focus_z, now, dt_p, on_g, gx_f, gz_f, active.goals, active.ngoals,
                    active.bricks, active.nbricks, active.blocks, active.nblocks,
                    finish_acc, selector_goal);
                draw_frame(prog, dprog, u_vp, u_origin, u_scale, u_color, u_light,
                    u_light_vp, u_lag, d_vp, d_origin, d_scale, d_color, d_lag, ids[0],
                    ids[1], ids[2], ids[3], chamfer_n, ids[4], brick_n, fbos[0], stex[0],
                    ctex[0], cmask, active.ground, active.nground, active.rooms, active.nrooms,
                    focus_x, focus_z, focus_x, play_camera_y, focus_z + play_camera_dist,
                    u_mask_origin, vp, lcam, lvp, shadow_bounds, lx, ly, lz, hist, foff, toff, active.nblocks,
                    px, py, pz, t, shape_verts, lagx, lagz, 1, 0, 0, 0.0, 0.0, 0.0,
                    false, Brush.Dirt, 0, false, 0, true, 0, 0, false, u_ramp, u_ground, u_cut, u_fade,
                    u_brick, d_ramp, pru_x, pru_z, present_us, mask_cache, lean_to,
                    lean_from, id_to, id_from, cell_head, cell_link, block_t, prep_cache,
                    sparks, bprog, b_u, bbuf[0], bdprog, bd_u, grass_prog, grass_u,
                    grass_cover, grass_ids[0], grass_ids[1], grass_instances, grass_blade_n,
                    lamp_light, active.lamps, active.nlamps,
                    material_light, active.bricks, active.nbricks, active.sand);
                fi_t: int = room_at(active.rooms, active.nrooms, fc, fr);
                ti_t: int = room_at(active.rooms, active.nrooms, tc2, tr2);
                from_title: []i8 = "";
                to_title: []i8 = "";
                if (fi_t >= 0) {
                    from_title = active.titles[fi_t];
                }
                if (ti_t >= 0) {
                    to_title = active.titles[ti_t];
                }
                if (travel_mode && travel_goal >= 0 && travel_goal < active.ngoals) {
                    travel_room: int = room_at(active.rooms, active.nrooms, active.goals[travel_goal].column,
                        active.goals[travel_goal].row);
                    if (travel_room >= 0) {
                        from_title = active.titles[travel_room];
                        to_title = from_title;
                    }
                }
                glDisable(2929);
                glEnable(3042);
                glBlendFunc(770, 771);
                if (titles_eq(from_title, to_title)) {
                    draw_title(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 40.0, 676.0, from_title, 1.0);
                } else {
                    draw_title(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 40.0, 676.0, from_title, 1.0 - t);
                    draw_title(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 40.0, 676.0, to_title, t);
                }
                tick_fps(&fps, present_us[0]);
                draw_fps(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex[0],
                    tbuf[0], tverts, gprog, u_gscreen, u_gcolor, u_galpha, gbuf[0],
                    gverts, &fps, fps_t, fps_work, fps_frame, fps_rate, fps_mem, fps_lab);
                glDisable(3042);
                glEnable(2929);
                glXSwapBuffers(dpy, win);
                fps_after_swap(&fps, fps_t, fps_work, fps_frame, fps_rate, fps_mem);
                restore_crate_anims(hist, foff, toff, active.blocks, active.nblocks);
            }
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) {
        XDestroyWindow(dpy, win);
    }
    XCloseDisplay(dpy);
    0;
}
