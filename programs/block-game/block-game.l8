tag block_game;
use_tag gl, x11, freetype;

// Port of blog/block-game.html. One binary, two sub-commands:
//   .build/block-game [play] [path]   play a world or a lone level
//   .build/block-game edit [path]     unified world/level editor
// Default path is programs/block-game/world.txt. Arrows move, j picks a visited finish,
// Backspace undoes, Shift+Backspace restarts the room, and q quits.
import "../gl/gl.l8";

import "level.l8";

import "../freetype/ft.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

main(argc: int, argv: []str): int {
    edit_mode: bool = false;
    path_i: int = 1;
    if (argc >= 2) {
        if (argv[1] == "edit") {
            edit_mode = true;
            path_i = 2;
        } else if (argv[1] == "play") {
            path_i = 2;
        }
    }
    path: []i8 = level_path_at(argc, argv, path_i);
    empty: Block = Block {
        id: 0 - 1,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    empty_brick: Brick = Brick { column: 0, row: 0 };
    level: *LevelState = new_level_state();
    world: *WorldState = new_world_state();
    is_world: bool = false;
    empty_spark: Spark = Spark {
        x: 0.0,
        y: 0.0,
        z: 0.0,
        vx: 0.0,
        vy: 0.0,
        vz: 0.0,
        life: 0.0,
        kind: 0,
        room: 0 - 1,
        blue: 0.0
    };
    sparks: []Spark = new Spark[SPARK_N](empty_spark);
    spark_rng: []int = new int[1](1);
    spark_acc: []f32 = new f32[3](0.0);
    finish_acc: []f32 = new f32[64](0.0);
    spark_last: []int = new int[1](0);
    stream_until: []int = new int[64](0);
    stream_tx: []f32 = new f32[64](0.0);
    stream_tz: []f32 = new f32[64](0.0);
    fd0: int = open_path(path, 0, 0);
    if (fd0 < 0) {
        if (!edit_mode) {
            write(2, "cannot load level ", len("cannot load level "));
            write(2, path, len(path));
            write(2, "\n", 1);
            return 1;
        }
        if (titles_eq(path, LEVEL_DEFAULT_PATH)) {
            is_world = true;
        } else {
            level.nrooms = set_room_size(level.rooms, level.titles, 0, 12, 9);
        }
        write(2, "new ", len("new "));
        write(2, path, len(path));
        write(2, "\n", 1);
    } else {
        close(fd0);
        raw: []i8 = slurp_path(path);
        if (looks_like_world(raw)) {
            is_world = true;
            if (load_world_state(path, world, level) < 0) {
                write(2, "cannot load world ", len("cannot load world "));
                write(2, path, len(path));
                write(2, "\n", 1);
                return 1;
            }
        } else {
            if (load_level_state(path, level) < 0) {
                write(2, "cannot load level ", len("cannot load level "));
                write(2, path, len(path));
                write(2, "\n", 1);
                return 1;
            }
            if (level.nrooms < 1) {
                level.nrooms = set_room_size(level.rooms, level.titles, 0, 12, 9);
            }
        }
        apply_level_gravity(level);
        apply_solved(world.names, level.nrooms, world.dones, world.ndone, world.solved,
            level.nrooms);
    }
    prepare_room_starts(slurp_path(path), level.rooms, level.nrooms, level.bricks,
        level.nbricks, level.ground, level.nground, level.goals, level.ngoals, level.room_starts);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        write(2, "XOpenDisplay failed (need DISPLAY / XWayland)\n", len("XOpenDisplay failed (need DISPLAY / XWayland)\n"));
        return 1;
    }
    dpy: *i8 = d0;
    g_dpy = dpy;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 16i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) {
        die("glXChooseVisual failed");
    }
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163843,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    win_w: f32 = 1200.0;
    win_h: f32 = 720.0;
    win: int = XCreateWindow(dpy, root, 0, 0, 1200, 720, 0, vis.depth as int, 1, vis.visual,
        10248, &wa);
    if (win == 0) {
        die("XCreateWindow failed");
    }
    if (edit_mode) {
        XStoreName(dpy, win, "L8 level editor");
    } else {
        XStoreName(dpy, win, "L8 block game");
    }
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    if (edit_mode) {
        write(2, "L8 editor (keys on screen, q quits)\n", len("L8 editor (keys on screen, q quits)\n"));
    } else {
        write(2, "L8 block game (arrows move, j travels, Backspace undoes, Shift+Backspace restarts, q quits)\n",
            len("L8 block game (arrows move, j travels, Backspace undoes, Shift+Backspace restarts, q quits)\n"));
    }
    write(2, "level: ", len("level: "));
    write(2, path, len(path));
    write(2, "\n", 1);
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) {
        die("glXCreateContext failed");
    }
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) {
        die("glXMakeCurrent failed");
    }
    write(2, "Height-field water: F7 toggles simulation, F8 makes ripples\n",
        len("Height-field water: F7 toggles simulation, F8 makes ripples\n"));
    write(2, "Wind field: F6 toggles the flow overlay\n",
        len("Wind field: F6 toggles the flow overlay\n"));
    vsync: bool = set_vsync(dpy, win, true);
    vs: []i8 = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec3 vcol;
uniform mat4 vp;
uniform vec3 origin;
uniform vec3 scale;
uniform vec2 lag;
uniform vec2 ramp_up;
uniform float water_mesh;
varying vec3 vworld;
varying vec3 vnrm;
varying vec3 vvcol;
varying float vheight;
varying vec4 vclip;
void main() {
  if (water_mesh>0.5) {
    vworld=pos; vnrm=nrm; vvcol=vec3(0.0); vheight=0.0;
    vclip=vp*vec4(pos.x,-0.02,pos.z,1.0);
    gl_Position=vp*vec4(pos,1.0);
    return;
  }
  vec3 lp = pos * scale;
  float sy = max(scale.y, 0.0001);
  float yb = lp.y + 0.5 * sy;
  float t = clamp(yb / sy, 0.0, 1.0);
  float extra = yb - t * sy;
  float L = length(lag);
  vec2 lg = lag * min(1.0, 0.18 / max(L, 0.0001));
  vec2 off = lg * (t * t);
  vec2 slope = lg * (0.7 * t);
  float ytilt = 0.0 - (lp.x * slope.x + lp.z * slope.y) / sy;
  vec3 spine = vec3(2.0 * t * lg.x, sy, 2.0 * t * lg.y);
  vec3 up = spine * inversesqrt(max(dot(spine, spine), 0.00000001));
  vec3 local = vec3(lp.x + off.x, 0.0 - 0.5 * sy + t * sy + ytilt, lp.z + off.y);
  local += up * extra;
  vec3 nn = nrm / scale;
  nn.x = nn.x - nn.y * slope.x / sy;
  nn.z = nn.z - nn.y * slope.y / sy;
  float ru2 = ramp_up.x * ramp_up.x + ramp_up.y * ramp_up.y;
  if (ru2 > 0.0001) {
    float amt = min(1.0, sqrt(ru2));
    vec2 r = ramp_up * inversesqrt(ru2);
    vec3 axis = vec3(0.0 - r.y, 0.0, r.x);
    float ca = cos(0.78539816 * amt);
    float sa = sin(0.78539816 * amt);
    local.y = local.y + 0.5 * sy * amt;
    vec3 v = local;
    local = v * ca + cross(axis, v) * sa + axis * dot(axis, v) * (1.0 - ca);
    vec3 nv = nn;
    nn = nv * ca + cross(axis, nv) * sa + axis * dot(axis, nv) * (1.0 - ca);
  }
  vec3 w = origin + local;
  gl_Position = vp * vec4(w, 1.0);
  vclip = gl_Position;
  vworld = w;
  vnrm = nn;
  vvcol = vcol;
  vheight = pos.y + 0.5;
}
""";
    fs: []i8 = """
#version 120
uniform vec3 color;
uniform vec3 light;
uniform mat4 light_vp;
uniform sampler2DShadow shadow_map;
uniform sampler2D check_map;
uniform sampler2D fluid_mask;
uniform vec2 fluid_origin;
uniform sampler2D lamp_map;
uniform vec2 lamp_origin;
uniform float emission;
uniform vec2 mask_origin;
uniform float ground;
uniform float water_mesh;
uniform float cut;
uniform float brick;
uniform float fade;
uniform vec3 camera;
uniform vec3 spec_lamps[4];
uniform sampler2D contact_map;
uniform vec2 contact_origin;
uniform float material_on;
uniform sampler2D reflection_map;
uniform float reflection_on;
varying vec3 vworld;
varying vec3 vnrm;
varying vec3 vvcol;
varying float vheight;
varying vec4 vclip;
vec2 hash2(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
float sample_ground(vec2 cell) {
  vec2 tc = (cell - mask_origin + 0.5) / 256.0;
  if (tc.x < 0.0 || tc.x > 1.0 || tc.y < 0.0 || tc.y > 1.0) {
    return 0.0;
  }
  return texture2D(check_map, tc).r;
}
float grass_at(vec2 cell) {
  float r = sample_ground(cell);
  return step(0.15, r) * (1.0 - step(0.50, r)) + step(0.80, r);
}
float stone_at(vec2 cell) {
  return step(0.50, sample_ground(cell));
}
float water_at(vec2 cell) {
  float r = sample_ground(cell);
  return step(0.08, r) * (1.0 - step(0.15, r));
}
float bank_wetness(vec2 p) {
  vec2 cell = floor(p);
  float distance_to_water = 1.0;
  for (int z = -1; z <= 1; z++) {
    for (int x = -1; x <= 1; x++) {
      vec2 neighbor = cell + vec2(float(x), float(z));
      if (water_at(neighbor) > 0.5) {
        vec2 delta = max(max(neighbor-p, p-(neighbor+1.0)), vec2(0.0));
        distance_to_water = min(distance_to_water, length(delta));
      }
    }
  }
  // Fall to zero before a water tile leaves the neighborhood, so crossing
  // a land tile boundary never introduces a seam, including near bank corners.
  return 1.0-smoothstep(0.05, 0.80, distance_to_water);
}
float broad_noise(vec2 p) {
  vec2 c = floor(p);
  vec2 t = fract(p);
  t = t*t*(3.0-2.0*t);
  return mix(mix(hash2(c).x, hash2(c+vec2(1.0,0.0)).x, t.x),
             mix(hash2(c+vec2(0.0,1.0)).x, hash2(c+1.0).x, t.x), t.y);
}
vec3 ground_material(vec2 cell) {
  // Decode categorical terrain before blending; interpolating mask codes
  // would invent other terrain types between the painted materials.
  float r = sample_ground(cell);
  float grass = step(0.15, r)*(1.0-step(0.50, r)) + step(0.80, r);
  float sand = step(0.04, r)*(1.0-step(0.08, r)) + step(0.72, r)*(1.0-step(0.80, r));
  float land = 1.0-step(0.08, r)*(1.0-step(0.15, r));
  return vec3(1.0-grass-sand, grass, sand)*land;
}
vec3 ground_weights(vec2 p) {
  // A softly irregular transition, anchored to the world rather than camera.
  vec2 offset = vec2(broad_noise(p*2.1+7.0), broad_noise(p*2.1+31.0))-0.5;
  vec2 grid = p + offset*0.16 - 0.5;
  vec2 cell = floor(grid);
  vec2 t = smoothstep(vec2(0.18), vec2(0.82), fract(grid));
  vec3 weights = mix(mix(ground_material(cell), ground_material(cell+vec2(1.0,0.0)), t.x),
                     mix(ground_material(cell+vec2(0.0,1.0)), ground_material(cell+1.0), t.x), t.y);
  float total = weights.x+weights.y+weights.z;
  // Water contributes no land color; the separate shoreline owns its shape.
  return total>0.001 ? weights/total : ground_material(floor(p));
}
vec3 evening_sky(vec3 r) {
  // A fixed environment: cooler overhead, softer and warmer near the horizon.
  float up = smoothstep(-0.05, 0.9, r.y);
  vec3 sky = mix(vec3(0.48,0.43,0.36), vec3(0.16,0.28,0.46), up);
  float clouds = broad_noise(r.xz * 3.5 / max(r.y + 0.65, 0.3));
  sky = mix(sky, vec3(0.52,0.59,0.64), smoothstep(0.43,0.76,clouds)*0.5);
  return sky;
}
float ground_grain(vec2 p) {
  // Interpolate the grain in world space instead of coloring constant squares.
  // Suppress frequencies smaller than a screen pixel to avoid distant shimmer.
  float footprint = max(length(dFdx(p)), length(dFdy(p)));
  return mix(broad_noise(p), 0.5, smoothstep(0.35, 1.25, footprint));
}
void main() {
  if (reflection_on < -0.5 && vworld.y < -0.02) discard;
  vec3 n = normalize(vnrm);
  vec3 V = normalize(camera - vworld);
  if (material_on < 0.5) V = normalize(vec3(1.0,2.0,2.0));
  vec3 albedo = color;
  float specular = 0.025;
  float gloss = 22.0;
  float water = 0.0;
  float cavity = 1.0;
  if (water_mesh>0.5) {
    // The volume also includes its submerged sides/bottom. Clip only material
    // hidden inside solid land; airborne drops above the bank remain visible.
    if (water_at(floor(vworld.xz))<0.5 && vworld.y<-0.017) discard;
    albedo=vec3(0.055,0.17,0.19);
    water=1.0; specular=0.85; gloss=100.0;
  } else if (ground > 0.5) {
    vec2 p = vworld.xz;
    vec2 cell = floor(p);
    vec2 f = fract(p);
    if (water_at(cell) > 0.5) {
      // Cut a hole in the flat ground so troughs remain visible below its plane.
      vec2 fluid_uv=(cell+0.5-fluid_origin)/32.0;
      bool simulated=material_on>0.5 && fluid_uv.x>0.0 && fluid_uv.y>0.0 &&
          fluid_uv.x<1.0 && fluid_uv.y<1.0 && texture2D(fluid_mask,fluid_uv).r>0.1;
      float shore = 1.0;
      if (water_at(cell + vec2(-1.0, 0.0)) < 0.5) shore = min(shore, f.x);
      if (water_at(cell + vec2(1.0, 0.0)) < 0.5) shore = min(shore, 1.0 - f.x);
      if (water_at(cell + vec2(0.0, -1.0)) < 0.5) shore = min(shore, f.y);
      if (water_at(cell + vec2(0.0, 1.0)) < 0.5) shore = min(shore, 1.0 - f.y);
      // Round the inner shoreline around diagonal land cells as well.
      if (water_at(cell + vec2(-1.0, -1.0)) < 0.5) shore = min(shore, length(f));
      if (water_at(cell + vec2(1.0, -1.0)) < 0.5) shore = min(shore, length(f - vec2(1.0, 0.0)));
      if (water_at(cell + vec2(-1.0, 1.0)) < 0.5) shore = min(shore, length(f - vec2(0.0, 1.0)));
      if (water_at(cell + vec2(1.0, 1.0)) < 0.5) shore = min(shore, length(f - vec2(1.0)));
      float bank = 1.0 - smoothstep(0.015, 0.12, shore);
      // Retain a very narrow bank lip behind the reconstructed water silhouette.
      if (simulated && shore>0.018) discard;
      float shallows = 1.0 - smoothstep(0.05, 0.48, shore);
      albedo = mix(vec3(0.035, 0.13, 0.16), vec3(0.14, 0.27, 0.24), shallows);
      albedo = mix(albedo, vec3(0.25, 0.235, 0.17), bank);
      water = 1.0 - bank;
      specular = mix(0.015, 0.85, water);
      gloss = 100.0;
    } else {
    vec3 materials = ground_weights(p);
    float md = 8.0;
    float md2 = 8.0;
    vec2 mr = vec2(0.0);
    vec2 mc = cell;
    int j;
    int i;
    for (j = -1; j <= 1; j++) {
      for (i = -1; i <= 1; i++) {
        vec2 g = vec2(float(i), float(j));
        vec2 o = hash2(cell + g);
        vec2 r = g + o * 0.62 - f;
        float d = dot(r, r);
        if (d < md) {
          md2 = md;
          md = d;
          mr = r;
          mc = cell + g;
        } else if (d < md2) {
          md2 = d;
        }
      }
    }
    vec2 hv = hash2(mc);
    float edge = sqrt(md2) - sqrt(md);
    float stone_m = smoothstep(0.040, 0.155, edge) * stone_at(mc);
    vec3 stone = mix(vec3(0.38, 0.36, 0.33), vec3(0.48, 0.45, 0.41), hv.x);
    float stone_grain = ground_grain(p * 9.0);
    stone *= 0.94 + 0.06 * stone_grain;
    stone = mix(vec3(0.34, 0.36, 0.28), stone, smoothstep(0.08, 0.22, edge));
    vec2 gh = vec2(0.7 * ground_grain(p * 1.6 + 19.0)
                    + 0.3 * ground_grain(p * 6.0 + 19.0),
                   ground_grain(p * 7.0 + vec2(43.0, 11.0)));
    vec3 grass = mix(vec3(0.26, 0.30, 0.20), vec3(0.32, 0.35, 0.22), gh.x);
    grass *= 0.92 + 0.06 * gh.y;
    grass *= 0.83;
    vec3 dirt = mix(vec3(0.255, 0.205, 0.145), vec3(0.305, 0.250, 0.175), gh.x);
    dirt *= 0.91 + 0.08 * gh.y;
    float sand_m = materials.z;
    vec3 sand = mix(vec3(0.53, 0.445, 0.31), vec3(0.63, 0.545, 0.39), gh.x);
    sand *= 0.94 + 0.06 * gh.y;
    sand *= 0.98 + 0.04 * ground_grain(p * 18.0 + 37.0);
    albedo = dirt*materials.x + grass*materials.y + sand*materials.z;
    albedo = mix(albedo, stone * mix(0.80, 0.86, stone_m), stone_m);
    float patch = 0.5 + 0.5*sin(p.x*0.31 + sin(p.y*0.23))*sin(p.y*0.27+0.8);
    albedo *= mix(0.87, 1.10, patch);
    float wet = 0.0;
    if (reflection_on > 0.5) {
      wet = bank_wetness(p) * (0.5 + 0.5*patch);
    }
    albedo *= 1.0 - mix(0.20, 0.32, sand_m)*wet;
    specular = mix(0.008, mix(0.06,0.14,hv.y), stone_m) + 0.12*wet;
    gloss = mix(12.0, 42.0, stone_m) + 28.0*wet;
    cavity = mix(mix(0.87,1.0,smoothstep(0.015,0.13,edge)), 1.0, sand_m*(1.0-stone_m));
    n = normalize(mix(n, normalize(vec3(-mr.x, 0.78, -mr.y)), stone_m * 0.32));
    }
  } else if (cut > 0.5) {
    vec3 an = abs(n);
    vec2 uv = vworld.xz;
    if (an.x > an.y && an.x > an.z) {
      uv = vworld.zy;
    } else if (an.z > an.y) {
      uv = vworld.xy;
    }
    float side = smoothstep(0.35, 0.70, 1.0 - an.y);
    float layer = hash2(vec2(floor(uv.y * 15.0), 3.7)).x;
    vec2 hp = hash2(floor(vworld.xy * 22.0) + floor(vworld.z * 22.0));
    vec2 hb = hash2(floor(vworld.xz + 0.02) + floor(vworld.y + 0.02) * 3.1);
    float pit = smoothstep(0.93, 0.99, hp.y);
    albedo = color * (0.93 + 0.08 * hb.x);
    albedo *= 0.94 + 0.06 * hp.x + 0.04 * layer * side;
    albedo *= 1.0 - 0.11 * pit;
    float cham = 1.0 - pow(max(an.x, max(an.y, an.z)), 6.0);
    albedo = mix(albedo, albedo * vec3(0.78, 0.90, 0.64), cham * 0.28);
    n = normalize(n + vec3(hp.x - 0.5, hp.y - 0.5, layer - 0.5) * 0.035);
    specular = 0.10;
    gloss = 30.0;
    // A restrained seam at the foot of each block also separates stacked pieces.
    cavity = mix(0.82,1.0,smoothstep(0.0,0.18,vheight));
  } else if (brick > 0.5) {
    vec3 an = abs(n);
    vec3 clay = vvcol;
    clay *= 0.96 + 0.04 * hash2(floor(vworld.xy * 22.0)).x;
    float cham = 1.0 - pow(max(an.x, max(an.y, an.z)), 6.0);
    albedo = mix(clay, clay * vec3(0.86, 0.90, 0.80), cham * 0.16);
    albedo *= 0.78;
    specular = 0.035;
    gloss = 14.0;
  }
  vec3 L = normalize(vec3(4.0, 11.0, 3.0));
  float ndl = max(dot(n, L), 0.0);
  float vis = 1.0;
  vec4 sh = light_vp * vec4(vworld, 1.0);
  vec3 sc = sh.xyz / max(sh.w, 0.0001);
  if (sc.x > 0.01 && sc.x < 0.99 && sc.y > 0.01 && sc.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
    float bias = (0.025 + 0.06 * (1.0 - ndl)) * 0.005;
    // Hardware bilinear PCF interpolates comparisons, never raw depth.
    vis = shadow2D(shadow_map, vec3(sc.xy, sc.z - bias)).r;
  }
  vec2 lamp_uv = (vworld.xz - lamp_origin) / 128.0;
  float warmth = texture2D(lamp_map, clamp(lamp_uv, 0.0, 1.0)).r;
  if (lamp_uv.x < 0.0 || lamp_uv.x > 1.0 || lamp_uv.y < 0.0 || lamp_uv.y > 1.0) warmth = 0.0;
  warmth *= 1.0 - smoothstep(2.0, 6.0, vworld.y);
  float contact = 0.0;
  vec2 contact_uv = (vworld.xz - contact_origin) / 128.0;
  if (material_on > 0.5 && vworld.y < 0.65 &&
      contact_uv.x > 0.0 && contact_uv.x < 1.0 && contact_uv.y > 0.0 && contact_uv.y < 1.0) {
    contact = texture2D(contact_map, contact_uv).r * (1.0-smoothstep(0.0,0.65,vworld.y));
  }
  vec3 ambient = mix(vec3(0.13,0.105,0.075), vec3(0.19,0.245,0.32), n.y*0.5+0.5);
  ambient *= cavity * (1.0-0.48*contact);
  vec3 light_color = ambient + vec3(0.76, 0.86, 1.0) * (0.48 * ndl * vis);
  light_color += vec3(1.60, 0.87, 0.36) * warmth * (0.72 + 0.28 * max(n.y, 0.0));
  vec3 lit = albedo * light_color + albedo * emission;
  if (water > 0.0) {
    vec3 R = reflect(-V,n);
    float fresnel = 0.025 + 0.975*pow(1.0-max(dot(n,V),0.0),5.0);
    vec3 reflected = evening_sky(R);
    if (reflection_on > 0.5 && material_on > 0.5) {
      vec2 uv = vclip.xy / vclip.w * 0.5 + 0.5;
      uv += n.xz * vec2(0.012,0.018);
      vec4 scene = texture2D(reflection_map,clamp(uv,0.001,0.999));
      float edge = smoothstep(0.0,0.025,min(min(uv.x,uv.y),min(1.0-uv.x,1.0-uv.y)));
      // Clear pixels contain the procedural sky; silhouettes are actual scene geometry.
      reflected = mix(reflected,scene.rgb,scene.a*edge);
    }
    // Art-directed reflectance keeps the water readable from the elevated game camera.
    lit = mix(lit, reflected, water*(0.16+0.84*fresnel));
  }
  if (specular > 0.02) {
    vec3 H = normalize(L+V);
    lit += vec3(0.76,0.86,1.0)*specular*pow(max(dot(n,H),0.0),gloss)*vis*ndl;
  }
  if (material_on > 0.5 && specular > 0.02) {
    for (int i=0; i<4; i++) {
      vec3 delta = spec_lamps[i] - vworld;
      float d2 = dot(delta,delta);
      if (spec_lamps[i].y > 0.0 && d2 < 64.0) {
        vec3 LL = delta * inversesqrt(max(d2,0.001));
        vec3 HH = normalize(LL+V);
        float shine = pow(max(dot(n,HH),0.0),gloss);
        lit += vec3(1.0,0.57,0.24)*specular*shine * max(dot(n,LL),0.0)
               * (1.0-smoothstep(36.0,64.0,d2)) / (1.0+0.25*d2);
      }
    }
  }
  if (material_on > 0.5) {
    float haze = smoothstep(24.0,65.0,length(camera.xz-vworld.xz))*0.13;
    lit = mix(lit,vec3(0.095,0.13,0.17),haze);
  }
  lit += vec3(0.006, 0.005, 0.003) * (1.0 - smoothstep(0.0, 0.06, lit));
  lit = lit / (1.0 + max(lit - 1.10, 0.0));
  gl_FragColor = vec4(lit, fade);
}
""";
    dvs: []i8 = """
#version 120
attribute vec3 pos;
uniform mat4 vp;
uniform vec3 origin;
uniform vec3 scale;
uniform vec2 lag;
uniform vec2 ramp_up;
void main() {
  vec3 lp = pos * scale;
  float sy = max(scale.y, 0.0001);
  float yb = lp.y + 0.5 * sy;
  float t = clamp(yb / sy, 0.0, 1.0);
  float extra = yb - t * sy;
  float L = length(lag);
  vec2 lg = lag * min(1.0, 0.18 / max(L, 0.0001));
  vec2 off = lg * (t * t);
  vec2 slope = lg * (0.7 * t);
  float ytilt = 0.0 - (lp.x * slope.x + lp.z * slope.y) / sy;
  vec3 spine = vec3(2.0 * t * lg.x, sy, 2.0 * t * lg.y);
  vec3 up = spine * inversesqrt(max(dot(spine, spine), 0.00000001));
  vec3 local = vec3(lp.x + off.x, 0.0 - 0.5 * sy + t * sy + ytilt, lp.z + off.y);
  local += up * extra;
  float ru2 = ramp_up.x * ramp_up.x + ramp_up.y * ramp_up.y;
  if (ru2 > 0.0001) {
    float amt = min(1.0, sqrt(ru2));
    vec2 r = ramp_up * inversesqrt(ru2);
    vec3 axis = vec3(0.0 - r.y, 0.0, r.x);
    float ca = cos(0.78539816 * amt);
    float sa = sin(0.78539816 * amt);
    local.y = local.y + 0.5 * sy * amt;
    vec3 v = local;
    local = v * ca + cross(axis, v) * sa + axis * dot(axis, v) * (1.0 - ca);
  }
  vec3 w = origin + local;
  gl_Position = vp * vec4(w, 1.0);
}
""";
    dfs: []i8 = """
#version 120
void main() {
}
""";
    tvs: []i8 = """
#version 120
attribute vec2 pos;
attribute vec2 uv;
uniform vec2 screen;
varying vec2 vuv;
void main() {
  gl_Position = vec4(pos.x / screen.x * 2.0 - 1.0, 1.0 - pos.y / screen.y * 2.0, 0.0, 1.0);
  vuv = uv;
}
""";
    tfs: []i8 = """
#version 120
uniform sampler2D tex;
uniform vec3 color;
uniform float alpha;
varying vec2 vuv;
void main() {
  float a = texture2D(tex, vuv).r * alpha;
  if (a <= 0.02) discard;
  gl_FragColor = vec4(color, a);
}
""";
    grass_vs: []i8 = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec4 vcol;
attribute vec2 vaux;
uniform mat4 vp;
uniform vec2 actor;
uniform vec2 motion;
uniform float time;
uniform sampler2D wind_map;
uniform vec2 wind_origin;
varying vec3 vworld;
varying vec3 vnrm;
varying float vroot;
varying float vrand;
varying float vmeadow;
varying float vtall;
void main() {
  vec2 base = vcol.xy;
  float ca = vcol.z;
  float sa = vcol.w;
  vec2 seed = vec2(fract(vaux.x),fract(vaux.y));
  float tall = step(1.0,vaux.y);
  vec2 local_xz = vec2(pos.x * ca - pos.z * sa, pos.x * sa + pos.z * ca) * 1.12;
  float meadow = floor(vaux.x)/255.0*2.0-1.0;
  float short_height = mix(0.24, 0.37, seed.y);
  float tall_height = mix(0.64, 0.88, seed.y);
  float height = mix(short_height,tall_height,tall) * (0.92 + 0.18*meadow);
  float t = clamp(pos.y, 0.0, 1.1);
  vec2 actor_delta = base - actor;
  float actor_dist = length(actor_delta);
  float touch = 1.0 - smoothstep(0.30, 0.80, actor_dist);
  vec2 away = actor_delta / max(actor_dist, 0.001);
  float motion_len = length(motion);
  vec2 motion_dir = motion / max(motion_len, 0.001);
  float moving = smoothstep(0.012, 0.12, motion_len);
  vec2 wind_uv = (base-wind_origin)/64.0;
  vec2 flow = (texture2D(wind_map,wind_uv).rg*2.0-1.0)*2.0;
  float flow_len = length(flow);
  vec2 flow_dir = flow/max(flow_len,0.001);
  vec2 visual_flow = flow*min(1.0,1.35/max(flow_len,0.001));
  float gust_front = sin(time*0.85-dot(base,flow_dir)*0.22);
  float gust = 0.15+1.85*smoothstep(-0.20,0.85,gust_front);
  vec2 side = normalize(vec2(-flow.y,flow.x)+vec2(0.001,0.0));
  float flutter = sin(time*3.1+seed.x*6.0+dot(base,vec2(0.13,0.19)))*0.006;
  vec2 bend = visual_flow*(0.075*gust)+side*flutter*min(flow_len,1.0);
  bend += away * touch * 0.15;
  bend += motion_dir * touch * moving * 0.075;
  bend *= mix(1.0,2.0,tall) * t * t;
  vec3 w = vec3(base.x + local_xz.x + bend.x, -0.017 + pos.y * height,
                base.y + local_xz.y + bend.y);
  vec2 rn = vec2(nrm.x * ca - nrm.z * sa, nrm.x * sa + nrm.z * ca);
  vnrm = normalize(vec3(rn.x - bend.x * 1.5, 0.16, rn.y - bend.y * 1.5));
  vworld = w;
  vroot = t;
  vrand = seed.y;
  vmeadow = meadow;
  vtall = tall;
  gl_Position = vp * vec4(w, 1.0);
}
""";
    grass_cover_vs: []i8 = """
#version 120
attribute vec2 pos;
void main() {
  gl_Position = vec4(pos, 0.0, 1.0);
}
""";
    grass_cover_fs: []i8 = """
#version 120
uniform sampler2D check_map;
uniform vec2 mask_origin;
uniform vec2 cover_origin;
vec2 hash2(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
float sample_ground(vec2 p) {
  vec2 tc = (p - mask_origin) / 256.0;
  if (tc.x < 0.0 || tc.x > 1.0 || tc.y < 0.0 || tc.y > 1.0) {
    return 0.0;
  }
  return texture2D(check_map, tc).r;
}
float grass_at(vec2 p) {
  float r = sample_ground(p);
  return step(0.15, r) * (1.0 - step(0.50, r)) + step(0.80, r);
}
float stone_at(vec2 p) {
  return step(0.50, sample_ground(p));
}
float stone_cover(vec2 p) {
  vec2 cell = floor(p);
  vec2 f = fract(p);
  float md = 8.0;
  float md2 = 8.0;
  vec2 mc = cell;
  int j;
  int i;
  for (j = -1; j <= 1; j++) {
    for (i = -1; i <= 1; i++) {
      vec2 g = vec2(float(i), float(j));
      vec2 o = hash2(cell + g);
      vec2 r = g + o * 0.62 - f;
      float d = dot(r, r);
      if (d < md) {
        md2 = md;
        md = d;
        mc = cell + g;
      } else if (d < md2) {
        md2 = d;
      }
    }
  }
  float edge = sqrt(md2) - sqrt(md);
  return smoothstep(0.040, 0.155, edge) * stone_at(mc + 0.5);
}
void main() {
  vec2 p = cover_origin + gl_FragCoord.xy / 16.0;
  vec2 cell = floor(p);
  vec2 in_cell = fract(p);
  float amount = 0.0;
  if (grass_at(cell + 0.5) > 0.5) {
    float edge_distance = 1.0;
    if (grass_at(cell + vec2(-0.5, 0.5)) < 0.5) {
      edge_distance = min(edge_distance, in_cell.x);
    }
    if (grass_at(cell + vec2(1.5, 0.5)) < 0.5) {
      edge_distance = min(edge_distance, 1.0 - in_cell.x);
    }
    if (grass_at(cell + vec2(0.5, -0.5)) < 0.5) {
      edge_distance = min(edge_distance, in_cell.y);
    }
    if (grass_at(cell + vec2(0.5, 1.5)) < 0.5) {
      edge_distance = min(edge_distance, 1.0 - in_cell.y);
    }
    amount = smoothstep(0.0, 1.0, edge_distance);
    amount *= 1.0 - stone_cover(p);
  }
  gl_FragColor = vec4(amount, amount, amount, 1.0);
}
""";
    grass_fs: []i8 = """
#version 120
uniform vec3 light;
uniform vec3 camera;
uniform sampler2D contact_map;
uniform vec2 contact_origin;
uniform float material_on;
uniform mat4 light_vp;
uniform sampler2DShadow shadow_map;
uniform sampler2D cover_map;
uniform sampler2D lamp_map;
uniform vec2 lamp_origin;
uniform vec2 cover_origin;
varying vec3 vworld;
varying vec3 vnrm;
varying float vroot;
varying float vrand;
varying float vmeadow;
varying float vtall;
void main() {
  vec2 cover_uv = (vworld.xz - cover_origin) / 96.0;
  if (cover_uv.x <= 0.0 || cover_uv.x >= 1.0 || cover_uv.y <= 0.0 || cover_uv.y >= 1.0) {
    discard;
  }
  float grass_amount = texture2D(cover_map, cover_uv).r;
  if (vroot > grass_amount || vrand > grass_amount) {
    discard;
  }
  vec3 root_color = mix(vec3(0.165, 0.190, 0.100),vec3(0.125,0.175,0.070),vtall);
  vec3 tip_color = mix(vec3(0.285, 0.320, 0.175),vec3(0.245,0.310,0.135),vtall);
  vec3 albedo = mix(root_color, tip_color, smoothstep(0.0, 0.82, vroot));
  albedo *= 0.92 + 0.12 * vrand;
  albedo += vec3(0.018, 0.022, 0.006) * smoothstep(0.70, 1.0, vroot);
  float meadow = vmeadow;
  albedo *= mix(vec3(0.88,0.96,0.85),vec3(1.16,1.06,0.91),meadow*0.5+0.5);
  vec3 L = normalize(vec3(4.0, 11.0, 3.0));
  vec3 n = normalize(vnrm);
  float ndl = abs(dot(n, L));
  float back = max(dot(0.0 - n, L), 0.0);
  float vis = 1.0;
  vec4 sh = light_vp * vec4(vworld, 1.0);
  vec3 sc = sh.xyz / max(sh.w, 0.0001);
  if (sc.x > 0.01 && sc.x < 0.99 && sc.y > 0.01 && sc.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
    float bias = 0.00025;
    vis = shadow2D(shadow_map, vec3(sc.xy, sc.z - bias)).r;
  }
  float key = ndl * vis;
  vec3 V = normalize(camera-vworld);
  float transmission = pow(max(dot(-L,V),0.0),3.0) * vis * smoothstep(0.15,0.9,vroot);
  float shade = 0.20 + 0.44 * key;
  shade += (0.10 * back + 0.22*transmission) * smoothstep(0.38, 1.0, vroot);
  vec2 lamp_uv = (vworld.xz - lamp_origin) / 128.0;
  float warmth = texture2D(lamp_map, clamp(lamp_uv, 0.0, 1.0)).r;
  if (lamp_uv.x < 0.0 || lamp_uv.x > 1.0 || lamp_uv.y < 0.0 || lamp_uv.y > 1.0) warmth = 0.0;
  vec3 lit = albedo * (shade * vec3(0.76, 0.86, 1.0) + warmth * vec3(1.50, 0.84, 0.34));
  vec2 contact_uv = (vworld.xz-contact_origin)/128.0;
  if (material_on > 0.5 && contact_uv.x>0.0 && contact_uv.x<1.0 && contact_uv.y>0.0 && contact_uv.y<1.0) {
    lit *= 1.0-0.30*texture2D(contact_map,contact_uv).r*(1.0-smoothstep(0.0,0.8,vroot));
  }
  vec3 H = normalize(L+V);
  lit += vec3(0.035,0.044,0.035)*pow(abs(dot(n,H)),24.0)*vis*smoothstep(0.25,0.9,vroot);
  lit = mix(lit,vec3(0.095,0.13,0.17),smoothstep(24.0,65.0,length(camera.xz-vworld.xz))*0.13);
  lit += vec3(0.006, 0.005, 0.003) * (1.0 - smoothstep(0.0, 0.06, lit));
  gl_FragColor = vec4(lit, 1.0);
}
""";
    prog: int = link_program(vs, fs, "nrm");
    dprog: int = link_program(dvs, dfs, "nrm");
    tprog: int = link_program(tvs, tfs, "uv");
