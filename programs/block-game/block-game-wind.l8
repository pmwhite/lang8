tag block_game;

// A camera-centered horizontal airflow field. Weather supplies the slow global
// forcing; advection and pressure projection turn it into local flow around walls.
const WIND_SIZE: int = 64;

const WIND_HALF: int = WIND_SIZE / 2;

const WIND_CELLS: int = WIND_SIZE * WIND_SIZE;

const WIND_STEP: f32 = 0.05;

const WIND_MAX_SPEED: f32 = 2.0;

const WIND_PRESSURE_STEPS: int = 8;

// A step's pieces: the advection, pairs of pressure relaxations, and the
// projection.
const WIND_PIECES: int = WIND_PRESSURE_STEPS / 2 + 2;

const WIND_FRAME_PIECES: int = 2;

type WeatherState = {
    dir_x: f32;
    dir_z: f32;
    speed: f32;
    gust: f32;
    turbulence: f32;
    target_x: f32;
    target_z: f32;
    target_speed: f32;
    target_gust: f32;
    target_turbulence: f32;
    clock: f32;
    until_change: int;
    rng: int
}

type WindVector = {
    x: f32;
    z: f32
}

type WindField = {
    weather: *WeatherState;
    vx: []f32;
    vz: []f32;
    next_x: []f32;
    next_z: []f32;
    pressure: []f32;
    next_pressure: []f32;
    divergence: []f32;
    solid: []int;
    // Per column and row factors of the forcing's curl term.
    sin_x: []f32;
    cos_x: []f32;
    sin_z: []f32;
    cos_z: []f32;
    // The weather fronts' sines and cosines by column and by row: four of
    // each, for the two fronts (see wind_step_begin).
    fronts_x: []f32;
    fronts_z: []f32;
    pixels: []i8;
    origin_x: int;
    origin_z: int;
    ready: bool;
    dirty: bool;
    debug: bool;
    start_ms: int;
    last_ms: int;
    debt: f32;
    // The next piece of the step in progress; see wind_prepare.
    piece: int;
    tex: u32
} invariant (len(vx) == WIND_CELLS && len(vz) == WIND_CELLS && len(next_x) == WIND_CELLS && len(next_z) == WIND_CELLS && len(pressure) == WIND_CELLS && len(next_pressure) == WIND_CELLS && len(divergence) == WIND_CELLS && len(solid) == WIND_CELLS && len(sin_x) == WIND_SIZE && len(cos_x) == WIND_SIZE && len(sin_z) == WIND_SIZE && len(cos_z) == WIND_SIZE && len(fronts_x) == 4 * WIND_SIZE && len(fronts_z) == 4 * WIND_SIZE && len(pixels) == WIND_CELLS * 4)

wind_clamp(x: f32, lo: f32, hi: f32): f32 {
    if (x < lo) return lo;
    if (x > hi) return hi;
    x
}

weather_random(w: *WeatherState): f32 {
    n: int = (w.rng * 48271 + 17) % 2147483647;
    if (n <= 0) n = n + 2147483646;
    w.rng = n;
    n as f32 / 2147483647.0
}

weather_choose(w: *WeatherState) {
    angle: f32 = weather_random(w) * 6.2831855;
    w.target_x = cos_f32(angle);
    w.target_z = sin_f32(angle);
    w.target_speed = 0.82 + weather_random(w) * 0.58;
    w.target_gust = 0.42 + weather_random(w) * 0.30;
    w.target_turbulence = 0.14 + weather_random(w) * 0.24;
    w.until_change = 600 + (weather_random(w) * 1200.0) as int
}

new_weather(seed: int): *WeatherState@new {
    if (seed <= 0) seed = 1;
    w: *WeatherState = new WeatherState {
        dir_x: 0.915,
        dir_z: 0.403,
        speed: 0.98,
        gust: 0.52,
        turbulence: 0.21,
        target_x: 0.915,
        target_z: 0.403,
        target_speed: 0.98,
        target_gust: 0.52,
        target_turbulence: 0.21,
        clock: 0.0,
        until_change: 1,
        rng: seed
    };
    weather_choose(w);
    w
}

weather_step(w: *WeatherState) {
    w.clock = w.clock + WIND_STEP;
    w.until_change = w.until_change - 1;
    if (w.until_change <= 0) weather_choose(w);
    // Roughly twenty seconds to turn into a new weather regime. Normalize the
    // blended direction so speed does not dip during a large turn.
    k: f32 = 0.0025;
    w.dir_x = w.dir_x + (w.target_x - w.dir_x) * k;
    w.dir_z = w.dir_z + (w.target_z - w.dir_z) * k;
    length: f32 = sqrt_f32(w.dir_x * w.dir_x + w.dir_z * w.dir_z);
    if (length > 0.0001) {
        w.dir_x = w.dir_x / length;
        w.dir_z = w.dir_z / length
    }
    w.speed = w.speed + (w.target_speed - w.speed) * k;
    w.gust = w.gust + (w.target_gust - w.gust) * k;
    w.turbulence = w.turbulence + (w.target_turbulence - w.turbulence) * k
}

new_wind_field(seed: int): *WindField@new {
    new WindField {
        weather: new_weather(seed),
        vx: new f32[WIND_CELLS](0.0),
        vz: new f32[WIND_CELLS](0.0),
        next_x: new f32[WIND_CELLS](0.0),
        next_z: new f32[WIND_CELLS](0.0),
        pressure: new f32[WIND_CELLS](0.0),
        next_pressure: new f32[WIND_CELLS](0.0),
        divergence: new f32[WIND_CELLS](0.0),
        solid: new int[WIND_CELLS](0),
        sin_x: new f32[WIND_SIZE](0.0),
        cos_x: new f32[WIND_SIZE](0.0),
        sin_z: new f32[WIND_SIZE](0.0),
        cos_z: new f32[WIND_SIZE](0.0),
        fronts_x: new f32[4 * WIND_SIZE](0.0),
        fronts_z: new f32[4 * WIND_SIZE](0.0),
        pixels: new i8[WIND_CELLS * 4](128i8),
        origin_x: 0,
        origin_z: 0,
        ready: false,
        dirty: true,
        debug: false,
        start_ms: 0,
        last_ms: 0,
        debt: 0.0,
        piece: 0,
        tex: 0u32
    }
    // Neutral RG values keep shaders still before the first field upload.
}

wind_target(w: *WindField, x: f32, z: f32): WindVector {
    weather: *WeatherState = w.weather;
    ax: f32 = x * 0.083 + weather.clock * 0.11;
    az: f32 = z * 0.097 - weather.clock * 0.085;
    wind_target_at(w, x, z, sin_f32(ax), cos_f32(ax), sin_f32(az), cos_f32(az))
}

// The forcing at (x, z), given the sines and cosines of the curl term's
// angles for x and z.
wind_target_at(
    w: *WindField,
    x: f32,
    z: f32,
    sin_ax: f32,
    cos_ax: f32,
    sin_az: f32,
    cos_az: f32
): WindVector {
    weather: *WeatherState = w.weather;
    along: f32 = x * weather.dir_x + z * weather.dir_z;
    wind_forcing(w, sin_f32(along * 0.105 - weather.clock * 0.72), sin_f32(along * 0.041 - weather.clock * 0.31 + 1.7),
        sin_ax, cos_ax, sin_az, cos_az)
}

// The forcing given the sines of the two weather fronts' phases.
wind_forcing(
    w: *WindField,
    wave: f32,
    wave2: f32,
    sin_ax: f32,
    cos_ax: f32,
    sin_az: f32,
    cos_az: f32
): WindVector {
    weather: *WeatherState = w.weather;
    front: f32 = 0.5 + 0.5 * wave;
    front2: f32 = 0.5 + 0.5 * wave2;
    strength: f32 = weather.speed * (0.58 + weather.gust * (0.72 * front + 0.48 * front2));
    // Curl of a smooth scalar field: this adds eddies without inventing sinks.
    curl_x: f32 = sin_ax * cos_az * 0.097;
    curl_z: f32 = 0.0 - cos_ax * sin_az * 0.083;
    curl_scale: f32 = weather.turbulence * 4.2;
    WindVector { x: weather.dir_x * strength + curl_x * curl_scale, z: weather.dir_z * strength + curl_z * curl_scale }
}

wind_grid_sample(values: []f32, gx: f32, gz: f32): f32 requires (WIND_CELLS <= len(values)) {
    x0: int = floor_i(gx - 0.5);
    z0: int = floor_i(gz - 0.5);
    tx: f32 = gx - 0.5 - x0 as f32;
    tz: f32 = gz - 0.5 - z0 as f32;
    if (x0 < 0) {
        x0 = 0;
        tx = 0.0
    }
    if (z0 < 0) {
        z0 = 0;
        tz = 0.0
    }
    if (x0 >= WIND_SIZE - 1) {
        x0 = WIND_SIZE - 2;
        tx = 1.0
    }
    if (z0 >= WIND_SIZE - 1) {
        z0 = WIND_SIZE - 2;
        tz = 1.0
    }
    a: f32 = values[z0 * WIND_SIZE + x0];
    b: f32 = values[z0 * WIND_SIZE + x0 + 1];
    c: f32 = values[(z0 + 1) * WIND_SIZE + x0];
    d: f32 = values[(z0 + 1) * WIND_SIZE + x0 + 1];
    top: f32 = a + (b - a) * tx;
    bottom: f32 = c + (d - c) * tx;
    top + (bottom - top) * tz
}

wind_recenter(w: *WindField, center_x: f32, center_z: f32) {
    next_origin_x: int = floor_i(center_x) - WIND_HALF;
    next_origin_z: int = floor_i(center_z) - WIND_HALF;
    if (w.ready && next_origin_x == w.origin_x && next_origin_z == w.origin_z) return;
    for z in 0..WIND_SIZE {
        for x in 0..WIND_SIZE {
            at: int = z * WIND_SIZE + x;
            old_x: int = next_origin_x + x - w.origin_x;
            old_z: int = next_origin_z + z - w.origin_z;
            if (w.ready && old_x >= 0 && old_x < WIND_SIZE && old_z >= 0 && old_z < WIND_SIZE) {
                old: int = old_z * WIND_SIZE + old_x;
                w.next_x[at] = w.vx[old];
                w.next_z[at] = w.vz[old]
            } else {
                target: WindVector = wind_target(w, next_origin_x as f32 + x as f32 + 0.5,
                    next_origin_z as f32 + z as f32 + 0.5);
                w.next_x[at] = target.x;
                w.next_z[at] = target.z
            }
        }
    }
    for i in 0..WIND_CELLS {
        w.vx[i] = w.next_x[i];
        w.vz[i] = w.next_z[i]
    }
    w.origin_x = next_origin_x;
    w.origin_z = next_origin_z;
    w.ready = true;
    w.dirty = true
}

wind_obstacles(w: *WindField, bricks: []Brick, nbrick: int) requires (0 <= nbrick && nbrick <= len(bricks)) {
    for i in 0..WIND_CELLS w.solid[i] = 0;
    for i in 0..nbrick {
        b: Brick = bricks[i];
        x: int = b.column - w.origin_x;
        z: int = b.row - w.origin_z;
        if (x >= 0 && x < WIND_SIZE && z >= 0 && z < WIND_SIZE) {
            at: int = z * WIND_SIZE + x;
            w.solid[at] = 1;
            w.vx[at] = 0.0;
            w.vz[at] = 0.0
        }
    }
}

// One Jacobi relaxation of the pressure from `p` into `next`. A neighbor
// outside the window or inside a wall takes the center's pressure, so no flow
// crosses walls or the window's edge.
wind_relax(
    p: []f32,
    next: []f32,
    divergence: []f32,
    solid: []int
) requires (WIND_CELLS <= len(p) && WIND_CELLS <= len(next) && WIND_CELLS <= len(divergence) && WIND_CELLS <= len(solid)) {
    for z in 0..WIND_SIZE {
        for x in 0..WIND_SIZE {
            at: int = z * WIND_SIZE + x;
            if (solid[at] != 0) next[at] = 0.0 else {
                center: f32 = p[at];
                left: f32 = center;
                right: f32 = center;
                down: f32 = center;
                up: f32 = center;
                if (x > 0) {
                    west: int = z * WIND_SIZE + (x - 1);
                    if (solid[west] == 0) left = p[west]
                }
                if (x + 1 < WIND_SIZE) {
                    east: int = z * WIND_SIZE + (x + 1);
                    if (solid[east] == 0) right = p[east]
                }
                if (z > 0) {
                    south: int = (z - 1) * WIND_SIZE + x;
                    if (solid[south] == 0) down = p[south]
                }
                if (z + 1 < WIND_SIZE) {
                    north: int = (z + 1) * WIND_SIZE + x;
                    if (solid[north] == 0) up = p[north]
                }
                next[at] = (left + right + down + up - divergence[at]) * 0.25
            }
        }
    }
}

// The first piece of a step: advection and forcing into next_x and next_z,
// and their divergence.
wind_step_begin(w: *WindField) {
    weather_step(w.weather);
    weather: *WeatherState = w.weather;
    // The curl term's x and z factors depend only on the column and the row.
    for i in 0..WIND_SIZE {
        ax: f32 = (w.origin_x as f32 + i as f32 + 0.5) * 0.083 + weather.clock * 0.11;
        az: f32 = (w.origin_z as f32 + i as f32 + 0.5) * 0.097 - weather.clock * 0.085;
        w.sin_x[i] = sin_f32(ax);
        w.cos_x[i] = cos_f32(ax);
        w.sin_z[i] = sin_f32(az);
        w.cos_z[i] = cos_f32(az);
        // A front's phase is (x dir_x + z dir_z) k - c: a column part and a
        // row part, so sin(a + b) = sin a cos b + cos a sin b replaces two
        // sines a cell with four a column and four a row.
        cx: f32 = (w.origin_x as f32 + i as f32 + 0.5) * weather.dir_x;
        cz: f32 = (w.origin_z as f32 + i as f32 + 0.5) * weather.dir_z;
        w.fronts_x[i * 4] = sin_f32(cx * 0.105);
        w.fronts_x[i * 4 + 1] = cos_f32(cx * 0.105);
        w.fronts_x[i * 4 + 2] = sin_f32(cx * 0.041);
        w.fronts_x[i * 4 + 3] = cos_f32(cx * 0.041);
        w.fronts_z[i * 4] = sin_f32(cz * 0.105 - weather.clock * 0.72);
        w.fronts_z[i * 4 + 1] = cos_f32(cz * 0.105 - weather.clock * 0.72);
        w.fronts_z[i * 4 + 2] = sin_f32(cz * 0.041 - weather.clock * 0.31 + 1.7);
        w.fronts_z[i * 4 + 3] = cos_f32(cz * 0.041 - weather.clock * 0.31 + 1.7)
    }
    // Semi-Lagrangian transport followed by relaxation toward the weather forcing.
    for z in 0..WIND_SIZE {
        for x in 0..WIND_SIZE {
            at: int = z * WIND_SIZE + x;
            if (w.solid[at] != 0) {
                w.next_x[at] = 0.0;
                w.next_z[at] = 0.0
            } else {
                back_x: f32 = x as f32 + 0.5 - w.vx[at] * WIND_STEP;
                back_z: f32 = z as f32 + 0.5 - w.vz[at] * WIND_STEP;
                adv_x: f32 = wind_grid_sample(w.vx, back_x, back_z);
                adv_z: f32 = wind_grid_sample(w.vz, back_x, back_z);
                fx: int = x * 4;
                fz: int = z * 4;
                wave: f32 = w.fronts_x[fx] * w.fronts_z[fz + 1] + w.fronts_x[fx + 1] * w.fronts_z[fz];
                wave2: f32 = w.fronts_x[fx + 2] * w.fronts_z[fz + 3] + w.fronts_x[fx + 3] * w.fronts_z[fz + 2];
                target: WindVector = wind_forcing(w, wave, wave2, w.sin_x[x], w.cos_x[x],
                    w.sin_z[z], w.cos_z[z]);
                w.next_x[at] = adv_x + (target.x - adv_x) * 0.085;
                w.next_z[at] = adv_z + (target.z - adv_z) * 0.085
            }
        }
    }
    for i in 0..WIND_CELLS w.pressure[i] = 0.0;
    for z in 0..WIND_SIZE {
        for x in 0..WIND_SIZE {
            at: int = z * WIND_SIZE + x;
            if (w.solid[at] == 0) {
                left: f32 = w.next_x[at];
                right: f32 = w.next_x[at];
                down: f32 = w.next_z[at];
                up: f32 = w.next_z[at];
                if (x > 0) {
                    west: int = z * WIND_SIZE + (x - 1);
                    if (w.solid[west] == 0) left = w.next_x[west]
                }
                if (x + 1 < WIND_SIZE) {
                    east: int = z * WIND_SIZE + (x + 1);
                    if (w.solid[east] == 0) right = w.next_x[east]
                }
                if (z > 0) {
                    south: int = (z - 1) * WIND_SIZE + x;
                    if (w.solid[south] == 0) down = w.next_z[south]
                }
                if (z + 1 < WIND_SIZE) {
                    north: int = (z + 1) * WIND_SIZE + x;
                    if (w.solid[north] == 0) up = w.next_z[north]
                }
                w.divergence[at] = (right - left + up - down) * 0.5
            } else w.divergence[at] = 0.0
        }
    }
}

// One piece of the pressure solve: two relaxations, back to `pressure`.
wind_step_relax(w: *WindField) {
    wind_relax(w.pressure, w.next_pressure, w.divergence, w.solid);
    wind_relax(w.next_pressure, w.pressure, w.divergence, w.solid)
}

// The last piece: remove the pressure gradient from the advected velocity.
wind_step_finish(w: *WindField) {
    p: []f32 = w.pressure;
    solid: []int = w.solid;
    for z in 0..WIND_SIZE {
        for x in 0..WIND_SIZE {
            at: int = z * WIND_SIZE + x;
            if (solid[at] != 0) {
                w.vx[at] = 0.0;
                w.vz[at] = 0.0
            } else {
                center: f32 = p[at];
                left: f32 = center;
                right: f32 = center;
                down: f32 = center;
                up: f32 = center;
                if (x > 0) {
                    west: int = z * WIND_SIZE + (x - 1);
                    if (solid[west] == 0) left = p[west]
                }
                if (x + 1 < WIND_SIZE) {
                    east: int = z * WIND_SIZE + (x + 1);
                    if (solid[east] == 0) right = p[east]
                }
                if (z > 0) {
                    south: int = (z - 1) * WIND_SIZE + x;
                    if (solid[south] == 0) down = p[south]
                }
                if (z + 1 < WIND_SIZE) {
                    north: int = (z + 1) * WIND_SIZE + x;
                    if (solid[north] == 0) up = p[north]
                }
                vx: f32 = (w.next_x[at] - (right - left) * 0.5) * 0.997;
                vz: f32 = (w.next_z[at] - (up - down) * 0.5) * 0.997;
                // Only a speed over the limit needs its square root.
                speed2: f32 = vx * vx + vz * vz;
                if (speed2 > WIND_MAX_SPEED * WIND_MAX_SPEED) {
                    speed: f32 = sqrt_f32(speed2);
                    if (speed > WIND_MAX_SPEED) {
                        vx = vx * WIND_MAX_SPEED / speed;
                        vz = vz * WIND_MAX_SPEED / speed
                    }
                }
                w.vx[at] = vx;
                w.vz[at] = vz
            }
        }
    }
    w.dirty = true
}

// One whole step. The frame loop runs it in pieces (wind_prepare).
wind_step(w: *WindField) {
    wind_step_begin(w);
    for _iteration in 0..WIND_PRESSURE_STEPS / 2 wind_step_relax(w);
    wind_step_finish(w)
}

wind_prepare(
    w: *WindField,
    center_x: f32,
    center_z: f32,
    bricks: []Brick,
    nbrick: int,
    now: int
) requires (0 <= nbrick && nbrick <= len(bricks)) {
    if (w.start_ms == 0) w.start_ms = now;
    origin_x: int = w.origin_x;
    origin_z: int = w.origin_z;
    wind_recenter(w, center_x, center_z);
    // A step in progress refers to the old window; start it again.
    if (w.origin_x != origin_x || w.origin_z != origin_z) w.piece = 0;
    wind_obstacles(w, bricks, nbrick);
    if (w.last_ms == 0) w.last_ms = now;
    elapsed: f32 = (now - w.last_ms) as f32 * 0.001;
    w.last_ms = now;
    if (elapsed < 0.0) elapsed = 0.0;
    if (elapsed > 0.20) elapsed = 0.20;
    w.debt = w.debt + elapsed;
    // A step is WIND_PIECES pieces of similar cost, run as time passes, so
    // each frame does a share of the work instead of every third frame doing
    // a whole step. A frame runs at most WIND_FRAME_PIECES, what 60 frames a
    // second need, and time it cannot catch up is dropped: the wind is only
    // scenery, and keeping up on a slow device made each slow frame do three
    // times the work, slower still. Below 60 frames a second the airflow
    // just changes more slowly.
    piece_time: f32 = WIND_STEP / WIND_PIECES as f32;
    pieces: int = 0;
    while (w.debt >= piece_time && pieces < WIND_FRAME_PIECES) {
        if (w.piece <= 0) wind_step_begin(w) else if (w.piece >= WIND_PIECES - 1) wind_step_finish(w) else wind_step_relax(w);
        w.piece = w.piece + 1;
        if (w.piece >= WIND_PIECES) w.piece = 0;
        w.debt = w.debt - piece_time;
        pieces = pieces + 1
    }
    if (w.debt > piece_time) w.debt = piece_time
}

wind_visual_time(w: *WindField, now: int): f32 {
    if (w.start_ms == 0) return 0.0;
    (now - w.start_ms) as f32 * 0.001
}

wind_encode(w: *WindField) {
    for i in 0..WIND_CELLS {
        x: f32 = wind_clamp(w.vx[i] / WIND_MAX_SPEED, -1.0, 1.0);
        z: f32 = wind_clamp(w.vz[i] / WIND_MAX_SPEED, -1.0, 1.0);
        qx: int = ((x * 0.5 + 0.5) * 255.0 + 0.5) as int;
        qz: int = ((z * 0.5 + 0.5) * 255.0 + 0.5) as int;
        w.pixels[i * 4] = qx trunc i8;
        w.pixels[i * 4 + 1] = qz trunc i8;
        w.pixels[i * 4 + 2] = 128i8;
        w.pixels[i * 4 + 3] = 255i8
    }
}
