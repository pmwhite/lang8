tag block_game;

use_tag std;

use_tag gl, x11, freetype;

PLAY_UNDO_DONE: int = 1;

PLAY_UNDO_WAIT: int = 2;

UNDO_ROUTE_MAX: int = REWIND_MAX * 2 + 1;

// One 20 MiB circular log, with no separate action-count limit or index.
// Record (64-bit words):
//   total length, pre-change count, packed player pose, room dependency mask,
//   changes from previous action to pre-move state, changes made by the move,
//   total length again.
// Both ends carry the length: oldest eviction and newest undo are O(1).
// A walking action with unchanged world state occupies five words (40 bytes).
UNDO_JOURNAL_WORDS: int = 2621440;

UNDO_ACTION_HEADER: int = 4;

UNDO_ACTION_OVERHEAD: int = 5;

// A change packs a 19-bit image address and a nonnegative 31-bit XOR payload
// into one word. All legal packed poses and room metadata fit in 31 bits.
UNDO_INDEX_BITS: int = 19;

UNDO_INDEX_MASK: int = 524287;

type UndoTimeline = {
    home: []int;
    deps: int;
    changed: []int;
    image: []int;
    block_base: int;
    journal: []int;
    stage: []int;
    stage_n: int;
    head: int;
    tail: int;
    count: int;
    phase: int;
    undoing: bool;
    offsets: []int;
    selected: []int;
    syncing: []int;
    route: []int;
    route_base: []int;
    route_n: []int;
    route_cur: []int;
    route_ms: []int
}

new_undo_timeline(home: []int@new, n: int, room_hn: []int) raises IoError: *UndoTimeline@new {
    new_undo_journal(home, n, room_hn, UNDO_JOURNAL_WORDS)
}

new_undo_journal(
    home: []int@new,
    n: int,
    room_hn: []int,
    words: int
) raises IoError: *UndoTimeline@new {
    owned: int = room_home_base(LEVEL_MAX_ROOMS, room_hn);
    block_base: int = LEVEL_MAX_ROOMS * 3 + owned * REWIND_MAX;
    image_n: int = block_base + n;
    largest: int = image_n * 2 + UNDO_ACTION_OVERHEAD;
    if (words < largest || image_n > UNDO_INDEX_MASK + 1) die("undo journal too small");
    u: *UndoTimeline = new UndoTimeline {
        home: home,
        deps: 0,
        changed: new int[n](0),
        image: new int[image_n](0),
        block_base: block_base,
        journal: new int[words](0),
        stage: new int[largest](0),
        stage_n: 0,
        head: 0,
        tail: 0,
        count: 0,
        phase: 1,
        undoing: false,
        offsets: new int[LEVEL_MAX_ROOMS](0),
        selected: new int[LEVEL_MAX_ROOMS](0),
        syncing: new int[LEVEL_MAX_ROOMS](0),
        route: new int[n * UNDO_ROUTE_MAX](0),
        route_base: new int[LEVEL_MAX_ROOMS](0),
        route_n: new int[LEVEL_MAX_ROOMS](0),
        route_cur: new int[LEVEL_MAX_ROOMS](0),
        route_ms: new int[LEVEL_MAX_ROOMS](0)
    };
    base: int = 0;
    for r in 0..LEVEL_MAX_ROOMS {
        u.route_base[check_index(u.route_base, r)] = base;
        base = base + room_hn[check_index(room_hn, r)] * UNDO_ROUTE_MAX;
        u.offsets[check_index(u.offsets, r)] = r * 3 + room_home_base(r, room_hn) * REWIND_MAX
    }
    u
}

undo_read(u: *UndoTimeline, at: int): int {
    u.journal[check_index(u.journal, at % len(u.journal))]
}

undo_latest(u: *UndoTimeline) raises IoError: int {
    if (u.count < 1) die("empty undo journal");
    u.head - undo_read(u, u.head - 1)
}

undo_apply_change(u: *UndoTimeline, change: int) {
    index: int = change & UNDO_INDEX_MASK;
    u.image[check_index(u.image, index)] = u.image[check_index(u.image, index)] ^ change >> UNDO_INDEX_BITS
}

// Only the newest action is materialized. Switching phases reverses the
// action's post-move changes in the private image, never in live rooms.
undo_set_phase(u: *UndoTimeline, action: int, phase: int) raises IoError {
    if (action != undo_latest(u)) die("undo action is not the latest");
    if (phase != u.phase) {
        first: int = action + UNDO_ACTION_HEADER + undo_read(u, action + 1);
        for p in first..u.head - 1 undo_apply_change(u, undo_read(u, p));
        u.phase = phase
    }
}

undo_load_history(u: *UndoTimeline, action: int, phase: int) raises IoError: []int@u {
    undo_set_phase(u, action, phase);
    u.image
}

undo_cancel_action(u: *UndoTimeline) {
    // Staging is separate from the ring: a bump cannot evict older actions,
    // even when background rooms have changed a large amount since last move.
    for i in UNDO_ACTION_HEADER..u.stage_n undo_apply_change(u, u.stage[check_index(u.stage,
        i)]);
    u.stage_n = 0;
    u.phase = 1
}

undo_clear_journal(u: *UndoTimeline) {
    if (u.stage_n > 0) undo_cancel_action(u);
    u.head = 0;
    u.tail = 0;
    u.count = 0;
    u.phase = 1;
    u.undoing = false
}

undo_pop_action(u: *UndoTimeline) raises IoError {
    action: int = undo_latest(u);
    undo_set_phase(u, action, 0);
    // Restore the previous action's image, including unrelated room changes
    // recorded between actions. Live independent rooms are left untouched.
    end: int = action + UNDO_ACTION_HEADER + undo_read(u, action + 1);
    for p in action + UNDO_ACTION_HEADER..end undo_apply_change(u, undo_read(u, p));
    u.head = action;
    u.count = u.count - 1;
    u.phase = 1;
    u.undoing = false;
    if (u.count == 0) {
        u.head = 0;
        u.tail = 0
    }
}

undo_write_word(u: *UndoTimeline, index: int, value: int) raises IoError {
    delta: int = u.image[check_index(u.image, index)] ^ value;
    if (delta == 0) return;
    if (delta < 0 || delta > 2147483647) die("undo value cannot be packed");
    u.stage[check_index(u.stage, u.stage_n)] = delta << UNDO_INDEX_BITS | index;
    u.stage_n = u.stage_n + 1;
    u.image[check_index(u.image, index)] = value
}

undo_commit_action(u: *UndoTimeline) {
    size: int = u.stage_n + 1;
    u.stage[check_index(u.stage, 0)] = size;
    u.stage[check_index(u.stage, 3)] = u.deps;
    u.stage[check_index(u.stage, u.stage_n)] = size;
    while (u.head - u.tail + size > len(u.journal)) {
        u.tail = u.tail + undo_read(u, u.tail);
        u.count = u.count - 1
    }
    for i in 0..size u.journal[check_index(u.journal, (u.head + i) % len(u.journal))] = u.stage[check_index(u.stage,
        i)];
    u.head = u.head + size;
    u.count = u.count + 1;
    u.stage_n = 0;
    u.phase = 1
}

// A fixed-size staging area holds at most two image diffs. No allocations or
// history eviction happen until the attempted action succeeds.
undo_save_history(
    u: *UndoTimeline,
    phase: bool,
    nroom: int,
    room_hn: []int,
    snap: []int,
    counts: []int,
    cursors: []int,
    ghost: []int,
    blocks: []Block,
    n: int,
    player: int
) raises IoError {
    if (!phase) {
        if (u.count > 0) undo_set_phase(u, undo_latest(u), 1);
        u.stage_n = UNDO_ACTION_HEADER;
        u.stage[check_index(u.stage, 2)] = player;
        u.deps = 0
    }
    for r in 0..nroom {
        off: int = u.offsets[check_index(u.offsets, r)];
        undo_write_word(u, off, counts[check_index(counts, r)]);
        undo_write_word(u, off + 1, cursors[check_index(cursors, r)]);
        undo_write_word(u, off + 2, ghost[check_index(ghost, r)]);
        source: int = room_home_base(r, room_hn) * REWIND_MAX;
        for s in 0..counts[r] {
            for k in 0..room_hn[check_index(room_hn, r)] {
                index: int = s * room_hn[r] + k;
                undo_write_word(u, off + 3 + index, snap[check_index(snap, source + index)])
            }
        }
    }
    for i in 0..n {
        b: Block = blocks[check_index(blocks, i)];
        undo_write_word(u, u.block_base + i, pack_pos(b.column, b.row, b.layer, b.mounted))
    }
    if (!phase) u.stage[check_index(u.stage, 1)] = u.stage_n - UNDO_ACTION_HEADER else undo_commit_action(u)
}

undo_depend(u: *UndoTimeline, room: int) {
    if (room >= 0 && room < LEVEL_MAX_ROOMS) u.deps = u.deps | 1 << room
}

// Reconstruct changed-block flags only for the action currently being undone.
// No per-block flag arrays are retained for older actions.
undo_prepare_action(u: *UndoTimeline, nroom: int, n: int) raises IoError {
    action: int = undo_latest(u);
    undo_set_phase(u, action, 1);
    for i in 0..n u.changed[check_index(u.changed, i)] = u.image[check_index(u.image,
        u.block_base + i)];
    undo_set_phase(u, action, 0);
    for i in 0..n {
        if (u.changed[check_index(u.changed, i)] != u.image[check_index(u.image, u.block_base + i)]) u.changed[check_index(u.changed,
            i)] = 1 else u.changed[check_index(u.changed, i)] = 0
    }
    mask: int = undo_read(u, action + 3);
    for r in 0..nroom {
        u.selected[check_index(u.selected, r)] = mask >> r & 1;
        u.syncing[check_index(u.syncing, r)] = 0
    }
    u.undoing = true
}

// Reading a block as support, a ramp, or an obstacle also couples its clock.
undo_read_cell(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    c: int,
    r: int,
    h: int
) {
    for i in 0..n {
        b: Block = blocks[check_index(blocks, i)];
        if (b.column == c && b.row == r && b.layer >= h - 1 && b.layer <= h + 1) undo_depend(u,
            u.home[check_index(u.home, i)])
    }
}

// Vacating the destination of a pending rewind step is an interaction even
// without touching a block. Use the pre-move archive: the move itself can
// change the live room history, and the obstruction may be gone by undo time.
undo_record_rewind_release(
    u: *UndoTimeline,
    nroom: int,
    room_hn: []int,
    pc: int,
    pr: int,
    nc: int,
    nr: int
) {
    if (pc == nc && pr == nr) return;
    data: []int = u.image;
    for r in 0..nroom {
        off: int = u.offsets[check_index(u.offsets, r)];
        cur: int = data[check_index(data, off + 1)];
        ghost: int = data[check_index(data, off + 2)];
        if ((ghost == REWIND_LEAVE || ghost == REWIND_RESET) && cur > 0) {
            width: int = room_hn[check_index(room_hn, r)];
            from: int = off + 3 + cur * width;
            dest: int = off + 3 + rewind_dest_step(cur) * width;
            if (!rewind_frame_legal(data, from, dest, width, pc, pr) && rewind_frame_legal(data,
                from, dest, width, nc, nr)) undo_depend(u, r)
        }
    }
}

undo_record_action(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    room_hn: []int,
    before: []int,
    pc: int,
    pr: int,
    ph: int,
    nc: int,
    nr: int,
    nh: int
) {
    undo_depend(u, room_at(rooms, nroom, pc, pr));
    undo_depend(u, room_at(rooms, nroom, nc, nr));
    undo_read_cell(u, blocks, n, nc, nr, nh);
    undo_record_rewind_release(u, nroom, room_hn, pc, pr, nc, nr);
    for i in 0..n {
        p: int = before[check_index(before, i)];
        b: Block = blocks[check_index(blocks, i)];
        if (p != pack_pos(b.column, b.row, b.layer, b.mounted)) undo_depend(u, u.home[check_index(u.home,
            i)]);
        if ((pos_col(p) == pc && pos_row(p) == pr || pos_col(p) == nc && pos_row(p) == nr) && pos_layer(p) >= ph - 1 && pos_layer(p) <= ph + 1) undo_depend(u,
            u.home[check_index(u.home, i)])
    }
}

undo_room_frame_equal(
    a: []int,
    ao: int,
    b: []int,
    bo: int,
    width: int
): bool {
    for k in 0..width {
        if (a[check_index(a, ao + k)] != b[check_index(b, bo + k)]) return false
    }
    true
}

undo_route_append(
    u: *UndoTimeline,
    room: int,
    width: int,
    data: []int,
    off: int
) {
    dest: int = u.route_base[check_index(u.route_base, room)] + u.route_n[check_index(u.route_n,
        room)] * width;
    for k in 0..width u.route[check_index(u.route, dest + k)] = data[check_index(data,
        off + k)];
    u.route_n[check_index(u.route_n, room)] = u.route_n[check_index(u.route_n, room)] + 1
}

undo_build_route(
    u: *UndoTimeline,
    action: int,
    room: int,
    blocks: []Block,
    room_ids: []int,
    room_hn: []int,
    live: []int,
    cursors: []int
) raises IoError {
    width: int = room_hn[check_index(room_hn, room)];
    data: []int = undo_load_history(u, action, 1);
    off: int = u.offsets[check_index(u.offsets, room)];
    target: int = data[check_index(data, off + 1)];
    u.route_n[check_index(u.route_n, room)] = 0;
    u.route_cur[check_index(u.route_cur, room)] = 0;
    // Find the current configuration on the retained branch first.
    match_step: int = 0 - 1;
    s: int = target;
    while (s >= 0 && match_step < 0) {
        same: bool = true;
        for k in 0..width {
            slot: int = room_id_slot(room, k, room_hn);
            id: int = room_ids[check_index(room_ids, slot)];
            b: Block = blocks[check_index(blocks, id)];
            if (pack_pos(b.column, b.row, b.layer, b.mounted) != data[check_index(data,
                off + 3 + s * width + k)]) same = false
        }
        if (same) match_step = s;
        s = s - 1
    }
    if (match_step < 0) {
        // A later visit can have created a different branch. Walk back to the
        // shared configuration before traversing the retained branch forward.
        a: int = cursors[check_index(cursors, room)];
        common: int = 0 - 1;
        while (a >= 0 && common < 0) {
            s = target;
            while (s >= 0 && common < 0) {
                if (undo_room_frame_equal(live, rewind_slot(room, a, 0, room_hn),
                    data, off + 3 + s * width, width)) {
                    common = a;
                    match_step = s
                }
                s = s - 1
            }
            a = a - 1
        }
        if (common >= 0) {
            a = cursors[room] - 1;
            while (a >= common) {
                undo_route_append(u, room, width, live, rewind_slot(room, a, 0, room_hn));
                a = a - 1
            }
        }
    }
    s = match_step + 1;
    while (s <= target) {
        undo_route_append(u, room, width, data, off + 3 + s * width);
        s = s + 1
    }
    u.route_ms[check_index(u.route_ms, room)] = rewind_return_step_ms(u.route_n[check_index(u.route_n,
        room)])
}

undo_select_rooms(
    u: *UndoTimeline,
    action: int,
    blocks: []Block,
    n: int,
    pc: int,
    pr: int,
    ph: int
) raises IoError {
    undo_set_phase(u, action, 0);
    // New obstructions/support can appear while an unrelated clock runs.
    for i in 0..n {
        b: Block = blocks[check_index(blocks, i)];
        if (b.column == pc && b.row == pr && b.layer >= ph - 1 && b.layer <= ph + 1) {
            if (u.home[check_index(u.home, i)] >= 0) u.selected[check_index(u.selected,
                u.home[check_index(u.home, i)])] = 1
        }
    }
    grown: bool = true;
    while (grown) {
        grown = false;
        for i in 0..n {
            owner: int = u.home[check_index(u.home, i)];
            restore: bool = owner < 0 && u.changed[check_index(u.changed, i)] != 0;
            if (owner >= 0 && u.selected[check_index(u.selected, owner)] != 0) restore = true;
            if (restore) {
                p: int = u.image[check_index(u.image, u.block_base + i)];
                for j in 0..n {
                    other: int = u.home[check_index(u.home, j)];
                    b: Block = blocks[check_index(blocks, j)];
                    if (other >= 0 && u.selected[check_index(u.selected, other)] == 0) {
                        at_target: bool = b.column == pos_col(p) && b.row == pos_row(p) && b.layer >= pos_layer(p) - 1 && b.layer <= pos_layer(p) + 1;
                        on_moving: bool = b.column == blocks[check_index(blocks, i)].column && b.row == blocks[i].row && b.layer >= blocks[i].layer && b.layer <= blocks[i].layer + 1;
                        if (at_target || on_moving) {
                            u.selected[check_index(u.selected, other)] = 1;
                            grown = true
                        }
                    }
                }
            }
        }
    }
}

undo_sync_tick(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    nroom: int,
    room_ids: []int,
    room_hn: []int,
    crate_pose: []int,
    crate_ms: []int,
    crate_hs: []int,
    crate_hn: []int,
    crate_t0: []int,
    now: int
): bool {
    crate_drain(n, now, crate_ms, crate_hs, crate_hn, crate_t0);
    waiting: bool = false;
    for r in 0..nroom {
        if (u.selected[check_index(u.selected, r)] != 0) {
            if (rewind_room_busy(r, room_ids, room_hn, crate_hn, n)) waiting = true else if (u.route_cur[check_index(u.route_cur,
                r)] < u.route_n[check_index(u.route_n, r)]) {
                width: int = room_hn[check_index(room_hn, r)];
                off: int = u.route_base[check_index(u.route_base, r)] + u.route_cur[check_index(u.route_cur,
                    r)] * width;
                for k in 0..width {
                    slot: int = room_id_slot(r, k, room_hn);
                    i: int = room_ids[check_index(room_ids, slot)];
                    p: int = u.route[check_index(u.route, off + k)];
                    blocks[i] = apply_packed(blocks[check_index(blocks, i)], p);
                    crate_append(i, p, now, crate_pose, crate_ms, crate_hs, crate_hn,
                        crate_t0);
                    if (crate_hn[check_index(crate_hn, i)] > 1) {
                        tail: int = (crate_hs[check_index(crate_hs, i)] + crate_hn[i] - 1) % CRATE_HIST;
                        pos: int = crate_idx(i, tail);
                        crate_ms[check_index(crate_ms, pos)] = u.route_ms[check_index(u.route_ms,
                            r)]
                    }
                }
                u.route_cur[check_index(u.route_cur, r)] = u.route_cur[check_index(u.route_cur,
                    r)] + 1;
                waiting = true
            }
        }
    }
    waiting
}

undo_restore_history(
    u: *UndoTimeline,
    action: int,
    room: int,
    room_hn: []int,
    snap: []int,
    counts: []int,
    cursors: []int,
    ghost: []int
) raises IoError {
    off: int = u.offsets[check_index(u.offsets, room)];
    data: []int = undo_load_history(u, action, 0);
    counts[check_index(counts, room)] = data[check_index(data, off)];
    cursors[check_index(cursors, room)] = data[check_index(data, off + 1)];
    ghost[check_index(ghost, room)] = data[check_index(data, off + 2)];
    for s in 0..counts[room] {
        for k in 0..room_hn[check_index(room_hn, room)] {
            slot: int = rewind_slot(room, s, k, room_hn);
            snap[check_index(snap, slot)] = data[check_index(data, off + 3 + s * room_hn[room] + k)]
        }
    }
}
