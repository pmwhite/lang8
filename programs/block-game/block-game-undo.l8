tag block_game;

use_tag std;

use_tag gl, x11, freetype;

PLAY_UNDO_DONE: int = 1;

PLAY_UNDO_WAIT: int = 2;

const UNDO_ROUTE_MAX: int = REWIND_MAX * 2 + 1;

// One 20 MiB circular log plus a compact phase-boundary index.
// Record (64-bit words):
//   total length, pre-change count, packed player pose, room dependency mask,
//   changes from previous action to pre-move state, changes made by the move,
//   absolute start of this action.
// The first word gives the length for eviction; the last gives the start for undo.
// A walking action with unchanged world state occupies five words (40 bytes).
const UNDO_JOURNAL_WORDS: int = 2621440;

const UNDO_ACTION_HEADER: int = 4;

const UNDO_ACTION_OVERHEAD: int = 5;

// A change packs a 19-bit image address and a nonnegative 31-bit XOR payload
// into one word. All legal packed poses and room metadata fit in 31 bits.
UNDO_INDEX_BITS: int = 19;

const UNDO_INDEX_MASK: int = 524287;

const UNDO_BLOCK_BASE: int = UNDO_INDEX_MASK + 1 - LEVEL_MAX_BLOCKS;

type UndoRoomMeta = {
    count: *int;
    cursor: *int;
    ghost: *int
}

undo_empty_meta: int = 0;

type UndoImageFrame = {
    start: int;
    end: int
} invariant (0 <= start && start <= end && end <= UNDO_INDEX_MASK + 1)

type UndoTimeline = {
    home: []int;
    home_view: []int;
    deps: int;
    changed: []int;
    image: []int;
    snap: []int;
    image_capacity: int;
    block_base: int;
    journal: []int;
    journal_meta_before: []i8;
    journal_meta_after: []i8;
    stage: []int;
    stage_meta_before: []i8;
    stage_meta_after: []i8;
    stage_n: int;
    stage_pre_n: int;
    head: int;
    tail: int;
    count: int;
    phase_ends: []u32;
    action_head: int;
    action_tail: int;
    phase: int;
    undoing: bool;
    offsets: []int;
    image_frames: []UndoImageFrame;
    snap_frames: []RewindFrameView;
    route_frames: []RewindFrameView;
    metas: []UndoRoomMeta;
    meta_values: []i8;
    meta_kind: []i8;
    meta_room: []int;
    selected: []int;
    syncing: []int;
    route: []int;
    route_base: []int;
    route_n: []int;
    route_cur: []int;
    route_ms: []int
} invariant (len(home) == LEVEL_MAX_BLOCKS && len(home_view) == LEVEL_MAX_BLOCKS && len(changed) == LEVEL_MAX_BLOCKS && 0 <= block_base && block_base <= image_capacity - LEVEL_MAX_BLOCKS && block_base == UNDO_BLOCK_BASE && len(image) == image_capacity && image_capacity == UNDO_INDEX_MASK + 1 && len(meta_kind) == image_capacity && len(meta_room) == image_capacity && len(meta_values) == LEVEL_MAX_ROOMS * 2 && len(journal_meta_before) == len(journal) && len(journal_meta_after) == len(journal) && len(stage_meta_before) == len(stage) && len(stage_meta_after) == len(stage) && len(offsets) == LEVEL_MAX_ROOMS && len(image_frames) == LEVEL_MAX_ROOMS * REWIND_MAX && len(snap_frames) == LEVEL_MAX_ROOMS * REWIND_MAX && len(route_frames) == LEVEL_MAX_ROOMS * UNDO_ROUTE_MAX && len(metas) == LEVEL_MAX_ROOMS && len(selected) == LEVEL_MAX_ROOMS && len(syncing) == LEVEL_MAX_ROOMS && len(route_base) == LEVEL_MAX_ROOMS && len(route_n) == LEVEL_MAX_ROOMS && len(route_cur) == LEVEL_MAX_ROOMS && len(route_ms) == LEVEL_MAX_ROOMS && len(stage) >= UNDO_ACTION_OVERHEAD && len(stage) <= len(journal) && len(journal) >= UNDO_ACTION_OVERHEAD && len(journal) <= UNDO_JOURNAL_WORDS && len(phase_ends) > 0 && 0 <= action_tail && 0 <= action_head && 0 <= tail && tail <= head && head <= 1000000000 && UNDO_ACTION_HEADER <= stage_pre_n && stage_pre_n <= stage_n && stage_n < len(stage), forall owner in home (0 - 1 <= owner && owner < LEVEL_MAX_ROOMS), forall off in offsets (0 <= off && off <= UNDO_INDEX_MASK - 2), forall steps in route_n (0 <= steps && steps <= UNDO_ROUTE_MAX), forall cursor in route_cur (0 <= cursor && cursor <= UNDO_ROUTE_MAX), forall value in meta_values (value <= 128i8), forall value in journal_meta_before (value <= 128i8), forall value in journal_meta_after (value <= 128i8), forall value in stage_meta_before (value <= 128i8), forall value in stage_meta_after (value <= 128i8), forall room in meta_room (0 <= room && room < LEVEL_MAX_ROOMS))

new_undo_timeline(
    home: []int,
    n: int,
    room_hn: []int,
    snap: []int@new
) raises IoError: *UndoTimeline@new requires (0 <= n && n <= len(home)) ensures (len(returned.home) >= n) {
    new_undo_journal(home, n, room_hn, snap, UNDO_JOURNAL_WORDS)
}

new_undo_journal(
    home: []int,
    n: int,
    room_hn: []int,
    snap: []int@new,
    words: int
) raises IoError: *UndoTimeline@new requires (0 <= n && n <= len(home) && words <= UNDO_JOURNAL_WORDS) ensures (len(returned.home) >= n) {
    owned: int = room_home_base(LEVEL_MAX_ROOMS, room_hn);
    block_base: int = LEVEL_MAX_ROOMS * 3 + owned * REWIND_MAX;
    image_n: int = block_base + n;
    image_capacity: int = UNDO_INDEX_MASK + 1;
    largest: int = image_n * 2 + UNDO_ACTION_OVERHEAD;
    if (words < largest || n > LEVEL_MAX_BLOCKS || image_capacity > UNDO_INDEX_MASK + 1 || image_capacity < LEVEL_MAX_BLOCKS || largest < UNDO_ACTION_OVERHEAD) die("undo journal too small");
    action_capacity: int = words / UNDO_ACTION_OVERHEAD + 1;
    if (action_capacity <= 0) die("undo journal too small");
    if (len(snap) % REWIND_MAX != 0) die("invalid rewind snapshot layout");
    stride: int = len(snap) / REWIND_MAX;
    empty_meta: *int = &undo_empty_meta;
    metas: []UndoRoomMeta = new UndoRoomMeta[LEVEL_MAX_ROOMS](UndoRoomMeta { count: empty_meta, cursor: empty_meta, ghost: empty_meta });
    route_data: []int = new int[n * UNDO_ROUTE_MAX](0);
    u: *UndoTimeline = new UndoTimeline {
        home: new int[LEVEL_MAX_BLOCKS](-1),
        home_view: new int[LEVEL_MAX_BLOCKS](-1),
        deps: 0,
        changed: new int[LEVEL_MAX_BLOCKS](0),
        image: new int[image_capacity](0),
        snap: snap,
        image_capacity: image_capacity,
        block_base: UNDO_BLOCK_BASE,
        journal: new int[words](0),
        journal_meta_before: new i8[words](0i8),
        journal_meta_after: new i8[words](0i8),
        stage: new int[largest](0),
        stage_meta_before: new i8[largest](0i8),
        stage_meta_after: new i8[largest](0i8),
        stage_n: UNDO_ACTION_HEADER,
        stage_pre_n: UNDO_ACTION_HEADER,
        head: 0,
        tail: 0,
        count: 0,
        phase_ends: new u32[action_capacity](0u32),
        action_head: 0,
        action_tail: 0,
        phase: 1,
        undoing: false,
        offsets: new int[LEVEL_MAX_ROOMS](0),
        image_frames: new UndoImageFrame[LEVEL_MAX_ROOMS * REWIND_MAX](UndoImageFrame { start: 0, end: 0 }),
        snap_frames: new RewindFrameView[LEVEL_MAX_ROOMS * REWIND_MAX](RewindFrameView { cells: snap, start: 0, end: 0 }),
        route_frames: new RewindFrameView[LEVEL_MAX_ROOMS * UNDO_ROUTE_MAX](RewindFrameView { cells: route_data, start: 0, end: 0 }),
        metas: metas,
        meta_values: new i8[LEVEL_MAX_ROOMS * 2](0i8),
        meta_kind: new i8[image_capacity](0i8),
        meta_room: new int[image_capacity](0),
        selected: new int[LEVEL_MAX_ROOMS](0),
        syncing: new int[LEVEL_MAX_ROOMS](0),
        route: route_data,
        route_base: new int[LEVEL_MAX_ROOMS](0),
        route_n: new int[LEVEL_MAX_ROOMS](0),
        route_cur: new int[LEVEL_MAX_ROOMS](0),
        route_ms: new int[LEVEL_MAX_ROOMS](0)
    };
    for i in 0..n {
        owner: int = home[i];
        if (owner < -1 || owner >= LEVEL_MAX_ROOMS) die("invalid block room");
        u.home[i] = owner;
        u.home_view[i] = owner
    }
    base: int = 0;
    for r in 0..LEVEL_MAX_ROOMS {
        u.route_base[r] = base;
        base = base + room_hn[r] * UNDO_ROUTE_MAX;
        off: int = r * 3 + room_home_base(r, room_hn) * REWIND_MAX;
        if (off < 0 || off > len(u.image) - 3) die("invalid undo room layout");
        width: int = room_hn[r];
        start: int = off + 3;
        snap_start: int = room_home_base(r, room_hn);
        if (width < 0 || width > LEVEL_MAX_BLOCKS || start > UNDO_INDEX_MASK + 1 - REWIND_MAX * width) die("invalid undo room layout");
        for route_step in 0..UNDO_ROUTE_MAX {
            route_start: int = u.route_base[r] + route_step * width;
            route_end: int = route_start + width;
            if (route_start < 0 || route_end < route_start || route_end > len(route_data)) die("invalid undo route layout");
            u.route_frames[r * UNDO_ROUTE_MAX + route_step] = RewindFrameView { cells: route_data, start: route_start, end: route_end }
        }
        for s in 0..REWIND_MAX {
            frame_start: int = start + s * width;
            frame_end: int = frame_start + width;
            if (frame_start < 0 || frame_end < frame_start || frame_end > UNDO_INDEX_MASK + 1) die("invalid undo room layout");
            u.image_frames[r * REWIND_MAX + s] = UndoImageFrame { start: frame_start, end: frame_end };
            live_start: int = s * stride + snap_start;
            live_end: int = live_start + width;
            if (live_start < 0 || live_end < live_start || live_end > len(snap)) die("invalid rewind snapshot layout");
            u.snap_frames[r * REWIND_MAX + s] = RewindFrameView { cells: snap, start: live_start, end: live_end }
        }
        u.offsets[r] = off;
        u.meta_values[r * 2 + 1] = 1i8;
        u.meta_kind[off] = 1i8;
        u.meta_kind[off + 1] = 2i8;
        u.meta_room[off] = r;
        u.meta_room[off + 1] = r;
        u.metas[r] = UndoRoomMeta { count: &u.image[off], cursor: &u.image[off + 1], ghost: &u.image[off + 2] }
    }
    u
}

undo_read(journal: []int, at: int): int requires (0 <= at && len(journal) > 0) {
    journal[at % len(journal)]
}

undo_image_frame(u: *UndoTimeline, room: int, step: int): UndoImageFrame requires (0 <= room && room < LEVEL_MAX_ROOMS && 0 <= step && step < REWIND_MAX) {
    u.image_frames[room * REWIND_MAX + step]
}

undo_archived_frame(
    u: *UndoTimeline,
    room: int,
    step: int,
    data: []int
): RewindFrameView requires (0 <= room && room < LEVEL_MAX_ROOMS && 0 <= step && step < REWIND_MAX && len(data) == UNDO_INDEX_MASK + 1) {
    frame: UndoImageFrame = undo_image_frame(u, room, step);
    RewindFrameView { cells: data, start: frame.start, end: frame.end }
}

undo_snap_frame(u: *UndoTimeline, room: int, step: int): RewindFrameView requires (0 <= room && room < LEVEL_MAX_ROOMS && 0 <= step && step < REWIND_MAX) {
    u.snap_frames[room * REWIND_MAX + step]
}

undo_route_frame(u: *UndoTimeline, room: int, step: int): RewindFrameView requires (0 <= room && room < LEVEL_MAX_ROOMS && 0 <= step && step < UNDO_ROUTE_MAX) {
    u.route_frames[room * UNDO_ROUTE_MAX + step]
}

undo_latest_phase_end(u: *UndoTimeline) raises IoError: u32 ensures (u.action_head > 0) {
    if (u.count < 1 || u.action_head < 1) die("empty undo journal");
    slot: int = (u.action_head - 1) % len(u.phase_ends);
    u.phase_ends[slot]
}

undo_latest(u: *UndoTimeline) raises IoError: int ensures (0 <= returned && u.tail <= returned && returned <= u.head - UNDO_ACTION_OVERHEAD && returned < 1000000000 && u.action_head > 0) {
    if (u.count < 1 || u.action_head < 1) die("empty undo journal");
    footer: int = (u.head - 1) trunc u32 as int;
    start: int = undo_read(u.journal, footer);
    if (start < u.tail || start > u.head - UNDO_ACTION_OVERHEAD) die("corrupt undo journal action");
    start
}

undo_change_index(change: int): int ensures (0 <= returned && returned <= UNDO_INDEX_MASK) {
    change & UNDO_INDEX_MASK
}

undo_apply_change(image: []int, change: int) requires (len(image) == UNDO_INDEX_MASK + 1) {
    index: int = undo_change_index(change);
    image[index] = image[index] ^ change >> UNDO_INDEX_BITS
}

undo_apply_staged(u: *UndoTimeline, at: int, forward: bool) requires (0 <= at && at < len(u.stage)) {
    change: int = u.stage[at];
    index: int = undo_change_index(change);
    kind: int = u.meta_kind[index] as int;
    if (kind == 1 || kind == 2) {
        room: int = u.meta_room[index];
        slot: int = room * 2;
        if (kind == 2) slot = slot + 1;
        if (forward) u.meta_values[slot] = u.stage_meta_after[at] else u.meta_values[slot] = u.stage_meta_before[at]
    }
    undo_apply_change(u.image, change)
}

undo_apply_journal(u: *UndoTimeline, at: int, forward: bool) requires (0 <= at) {
    slot: int = at % len(u.journal);
    change: int = u.journal[slot];
    index: int = undo_change_index(change);
    kind: int = u.meta_kind[index] as int;
    if (kind == 1 || kind == 2) {
        room: int = u.meta_room[index];
        meta_slot: int = room * 2;
        if (kind == 2) meta_slot = meta_slot + 1;
        if (forward) u.meta_values[meta_slot] = u.journal_meta_after[slot] else u.meta_values[meta_slot] = u.journal_meta_before[slot]
    }
    undo_apply_change(u.image, change)
}

// Only the newest action is materialized. Switching phases reverses the
// action's post-move changes in the private image, never in live rooms.
undo_set_phase(u: *UndoTimeline, action: int, phase: int) raises IoError: int ensures (u.tail <= returned && returned == action && u.action_head > 0) {
    phase_end: u32 = undo_latest_phase_end(u);
    latest: int = undo_latest(u);
    if (action != latest) die("undo action is not the latest");
    if (phase != u.phase) {
        first: int = phase_end as int;
        if (phase == 0) {
            p: int = u.head - 1;
            while (p > first) {
                p = p - 1;
                undo_apply_journal(u, p, false)
            }
        } else {
            for p in first..u.head - 1 undo_apply_journal(u, p, true)
        }
        u.phase = phase
    }
    action
}

undo_load_history(u: *UndoTimeline, action: int, phase: int) raises IoError: []int@u ensures (len(returned) == u.image_capacity && len(returned) == UNDO_INDEX_MASK + 1) {
    _phase_action: int = undo_set_phase(u, action, phase);
    u.image
}

undo_cancel_action(u: *UndoTimeline) {
    // Staging is separate from the ring: a bump cannot evict older actions,
    // even when background rooms have changed a large amount since last move.
    i: int = u.stage_n;
    while (i > UNDO_ACTION_HEADER) {
        i = i - 1;
        undo_apply_staged(u, i, false)
    }
    u.stage_pre_n = UNDO_ACTION_HEADER;
    u.stage_n = UNDO_ACTION_HEADER;
    u.phase = 1
}

undo_clear_journal(u: *UndoTimeline) {
    if (u.stage_n > 0) undo_cancel_action(u);
    u.tail = 0;
    u.count = 0;
    u.action_tail = 0;
    u.action_head = 0;
    u.head = 0;
    u.phase = 1;
    u.undoing = false
}

undo_pop_action(u: *UndoTimeline) raises IoError {
    action: int = undo_latest(u);
    phase_end: u32 = undo_latest_phase_end(u);
    action = undo_set_phase(u, action, 0);
    // Restore the previous action's image, including unrelated room changes
    // recorded between actions. Live independent rooms are left untouched.
    end: int = phase_end as int;
    first: int = (action + UNDO_ACTION_HEADER) trunc u32 as int;
    p: int = end;
    while (p > first) {
        p = p - 1;
        undo_apply_journal(u, p, false)
    }
    u.count = u.count - 1;
    u.action_head = u.action_head - 1;
    u.head = action;
    u.phase = 1;
    u.undoing = false;
    if (u.count == 0) {
        u.tail = 0;
        u.head = 0
    }
}

undo_write_word(u: *UndoTimeline, index: int, value: int) raises IoError requires (0 <= index && index <= UNDO_INDEX_MASK) {
    delta: int = u.image[index] ^ value;
    if (delta == 0) return;
    if (delta < 0 || delta > 2147483647) die("undo value cannot be packed");
    stage: []int = u.stage;
    next_stage: int = u.stage_n + 1;
    if (next_stage >= len(u.stage)) die("undo stage is full");
    stage[next_stage - 1] = delta << UNDO_INDEX_BITS | index;
    u.stage_n = next_stage;
    u.image[index] = value
}

undo_write_meta(
    u: *UndoTimeline,
    room: int,
    kind: int,
    value: int,
    encoded: int
) raises IoError requires (0 <= room && room < LEVEL_MAX_ROOMS && 0 <= kind && kind < 2 && 0 <= encoded && encoded <= 128) {
    slot: int = room * 2 + kind;
    before: i8 = u.meta_values[slot];
    small: i8 = encoded trunc i8;
    stage_at: int = u.stage_n;
    undo_write_word(u, u.offsets[room] + kind, value);
    if (u.stage_n > stage_at) {
        u.stage_meta_before[stage_at] = before;
        u.stage_meta_after[stage_at] = small
    }
    u.meta_values[slot] = small
}

undo_commit_action(u: *UndoTimeline) raises UndoHistoryExhausted, IndexOutOfBounds {
    size: int = u.stage_n + 1;
    next_head: int = u.head + size;
    if (next_head < u.head || next_head > 1000000000 || u.action_head >= 1000000000) raise UndoHistoryExhausted;
    u.stage[0] = size;
    u.stage[3] = u.deps;
    u.stage[u.stage_n] = u.head;
    while (u.head - u.tail + size > len(u.journal)) {
        old_size: int = undo_read(u.journal, u.tail);
        if (old_size < UNDO_ACTION_OVERHEAD || old_size > u.head - u.tail) raise IndexOutOfBounds;
        if (u.action_tail >= 1000000000) raise UndoHistoryExhausted;
        next_tail: int = u.tail + old_size;
        u.tail = next_tail;
        u.count = u.count - 1;
        u.action_tail = u.action_tail + 1
    }
    ring: []int = u.journal;
    head_slot: int = u.head % len(ring);
    for i in 0..size {
        offset: int = head_slot + i;
        slot: int = offset % len(ring);
        ring[slot] = u.stage[i];
        u.journal_meta_before[slot] = u.stage_meta_before[i];
        u.journal_meta_after[slot] = u.stage_meta_after[i]
    }
    action_slot: int = u.action_head % len(u.phase_ends);
    pre_end: u32 = (u.head + u.stage_pre_n) trunc u32;
    u.phase_ends[action_slot] = pre_end;
    u.action_head = u.action_head + 1;
    u.head = next_head;
    u.count = u.count + 1;
    u.stage_pre_n = UNDO_ACTION_HEADER;
    u.stage_n = UNDO_ACTION_HEADER;
    u.phase = 1
}

// A fixed-size staging area holds at most two image diffs. No allocations or
// history eviction happen until the attempted action succeeds.
undo_save_history(
    u: *UndoTimeline,
    phase: bool,
    nroom: int,
    counts: []RewindCount,
    cursors: []RewindCursor,
    ghost: []int,
    blocks: []Block,
    n: int,
    player: int
) raises IoError, UndoHistoryExhausted, IndexOutOfBounds requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && nroom <= len(counts) && nroom <= len(cursors) && nroom <= len(ghost) && 0 <= n && n <= LEVEL_MAX_BLOCKS && n <= len(blocks)) {
    if (!phase) {
        if (u.count > 0) {
            latest: int = undo_latest(u);
            _phase_action: int = undo_set_phase(u, latest, 1)
        }
        u.stage_pre_n = UNDO_ACTION_HEADER;
        u.stage_n = UNDO_ACTION_HEADER;
        u.stage[2] = player;
        u.deps = 0
    }
    for r in 0..nroom {
        count: int = counts[r].value;
        cursor: int = cursors[r].value;
        off: int = u.offsets[r];
        cursor_code: int = cursor + 1;
        undo_write_meta(u, r, 0, count, count);
        undo_write_meta(u, r, 1, cursor, cursor_code);
        undo_write_word(u, off + 2, ghost[r]);
        for s in 0..count {
            frame: RewindFrameView = undo_snap_frame(u, r, s);
            image_frame: UndoImageFrame = undo_image_frame(u, r, s);
            source_at: int = frame.start;
            dest_at: int = image_frame.start;
            source_end: int = frame.end;
            dest_end: int = image_frame.end;
            frame_cells: []int = frame.cells;
            while (source_at < source_end && dest_at < dest_end) invariant (0 <= source_at && source_at <= source_end && source_end <= len(frame_cells) && 0 <= dest_at && dest_at <= dest_end && dest_end <= UNDO_INDEX_MASK + 1) {
                undo_write_word(u, dest_at, frame_cells[source_at]);
                source_at = source_at + 1;
                dest_at = dest_at + 1
            }
        }
    }
    for i in 0..n {
        b: Block = blocks[i];
        undo_write_word(u, u.block_base + i, pack_pos(b.column, b.row, b.layer, b.mounted))
    }
    if (!phase) {
        u.stage[1] = u.stage_n - UNDO_ACTION_HEADER;
        u.stage_pre_n = u.stage_n
    } else undo_commit_action(u)
}

undo_depend(u: *UndoTimeline, room: int) {
    if (room >= 0 && room < LEVEL_MAX_ROOMS) u.deps = u.deps | 1 << room
}

// Reconstruct changed-block flags only for the action currently being undone.
// No per-block flag arrays are retained for older actions.
undo_prepare_action(u: *UndoTimeline, nroom: int, n: int) raises IoError requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && 0 <= n && n <= LEVEL_MAX_BLOCKS) {
    action: int = undo_latest(u);
    _before_action: int = undo_set_phase(u, action, 1);
    for i in 0..n u.changed[i] = u.image[u.block_base + i];
    _after_action: int = undo_set_phase(u, action, 0);
    for i in 0..n {
        if (u.changed[i] != u.image[u.block_base + i]) u.changed[i] = 1 else u.changed[i] = 0
    }
    mask_at: int = (action + 3) trunc u32 as int;
    mask: int = undo_read(u.journal, mask_at);
    for r in 0..nroom {
        u.selected[r] = mask >> r & 1;
        u.syncing[r] = 0
    }
    u.undoing = true
}

// Reading a block as support, a ramp, or an obstacle also couples its clock.
undo_read_cell(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    c: int,
    r: int,
    h: int
) {
    for i in 0..n {
        b: Block = blocks[i];
        if (b.column == c && b.row == r && b.layer >= h - 1 && b.layer <= h + 1) undo_depend(u,
            u.home[i])
    }
}

// Vacating the destination of a pending rewind step is an interaction even
// without touching a block. Use the pre-move archive: the move itself can
// change the live room history, and the obstruction may be gone by undo time.
undo_record_rewind_release(
    u: *UndoTimeline,
    nroom: int,
    room_hn: []int,
    pc: int,
    pr: int,
    nc: int,
    nr: int
) requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && nroom <= len(room_hn)) {
    if (pc == nc && pr == nr) return;
    for r in 0..nroom {
        cursor_slot: int = r * 2 + 1;
        cursor_code: int = u.meta_values[cursor_slot] as int;
        cur: int = cursor_code - 1;
        ghost: int = u.metas[r].ghost.*;
        if ((ghost == REWIND_LEAVE || ghost == REWIND_RESET) && cur > 0) {
            dest_step: int = cur - 1;
            before_image: UndoImageFrame = undo_image_frame(u, r, cur);
            after_image: UndoImageFrame = undo_image_frame(u, r, dest_step);
            before: RewindFrameView = RewindFrameView { cells: u.image, start: before_image.start, end: before_image.end };
            after: RewindFrameView = RewindFrameView { cells: u.image, start: after_image.start, end: after_image.end };
            if (!rewind_frame_legal(before, after, pc, pr) && rewind_frame_legal(before,
                after, nc, nr)) undo_depend(u, r)
        }
    }
}

undo_record_action(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    room_hn: []int,
    before: []int,
    pc: int,
    pr: int,
    ph: int,
    nc: int,
    nr: int,
    nh: int
) requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && nroom <= len(room_hn)) {
    undo_depend(u, room_at(rooms, nroom, pc, pr));
    undo_depend(u, room_at(rooms, nroom, nc, nr));
    undo_read_cell(u, blocks, n, nc, nr, nh);
    undo_record_rewind_release(u, nroom, room_hn, pc, pr, nc, nr);
    for i in 0..n {
        p: int = before[i];
        b: Block = blocks[i];
        if (p != pack_pos(b.column, b.row, b.layer, b.mounted)) undo_depend(u, u.home[i]);
        if ((pos_col(p) == pc && pos_row(p) == pr || pos_col(p) == nc && pos_row(p) == nr) && pos_layer(p) >= ph - 1 && pos_layer(p) <= ph + 1) undo_depend(u,
            u.home[i])
    }
}

undo_room_frame_equal(a: RewindFrameView, b: RewindFrameView): bool {
    ai: int = a.start;
    bi: int = b.start;
    while (ai < a.end && bi < b.end) invariant (a.start <= ai && ai <= a.end && b.start <= bi && bi <= b.end) {
        if (a.cells[ai] != b.cells[bi]) return false;
        ai = ai + 1;
        bi = bi + 1
    }
    ai == a.end && bi == b.end
}

undo_route_append(
    u: *UndoTimeline,
    room: int,
    count: int,
    source: RewindFrameView
): int requires (0 <= room && room < LEVEL_MAX_ROOMS && 0 <= count && count < UNDO_ROUTE_MAX) ensures (returned == count + 1) {
    frame: RewindFrameView = undo_route_frame(u, room, count);
    dest_at: int = frame.start;
    source_at: int = source.start;
    while (dest_at < frame.end && source_at < source.end) invariant (frame.start <= dest_at && dest_at <= frame.end && source.start <= source_at && source_at <= source.end) {
        frame.cells[dest_at] = source.cells[source_at];
        dest_at = dest_at + 1;
        source_at = source_at + 1
    }
    count + 1
}

undo_build_route(
    u: *UndoTimeline,
    action: int,
    room: int,
    blocks: []Block,
    room_ids: *RoomBlockIds,
    cursors: []RewindCursor
) raises IoError requires (0 <= room && room < LEVEL_MAX_ROOMS && room < len(cursors) && len(blocks) >= LEVEL_MAX_BLOCKS) {
    data: []int = undo_load_history(u, action, 1);
    target_slot: int = room * 2 + 1;
    target_code: int = u.meta_values[target_slot] as int;
    target: int = target_code - 1;
    live_cursor: int = cursors[room].value;
    u.route_n[room] = 0;
    u.route_cur[room] = 0;
    route_count: int = 0;
    // Find the current configuration on the retained branch first.
    match_step: int = 0 - 1;
    s: int = target;
    while (s >= 0 && match_step < 0) invariant (-1 <= s && s < REWIND_MAX && -1 <= match_step && match_step < REWIND_MAX && -1 <= target && target < REWIND_MAX && -1 <= live_cursor && live_cursor < REWIND_MAX) {
        same: bool = true;
        span: RoomBlockSpan = room_ids.spans[room];
        frame: RewindFrameView = undo_archived_frame(u, room, s, data);
        slot: int = span.start;
        at: int = frame.start;
        while (slot < span.end && at < frame.end) invariant (span.start <= slot && slot <= span.end && frame.start <= at && at <= frame.end) {
            id: int = room_ids.indices[slot];
            b: Block = blocks[id];
            if (pack_pos(b.column, b.row, b.layer, b.mounted) != frame.cells[at]) same = false;
            slot = slot + 1;
            at = at + 1
        }
        if (slot != span.end || at != frame.end) same = false;
        if (same) match_step = s;
        s = s - 1
    }
    if (match_step < 0) {
        // A later visit can have created a different branch. Walk back to the
        // shared configuration before traversing the retained branch forward.
        a: int = live_cursor;
        common: int = 0 - 1;
        while (a >= 0 && common < 0) invariant (-1 <= a && a < REWIND_MAX && -1 <= common && common < REWIND_MAX && -1 <= match_step && match_step < REWIND_MAX && -1 <= live_cursor && live_cursor < REWIND_MAX && -1 <= target && target < REWIND_MAX) {
            s = target;
            while (s >= 0 && common < 0) invariant (-1 <= s && s < REWIND_MAX && 0 <= a && a < REWIND_MAX && -1 <= common && common < REWIND_MAX && -1 <= match_step && match_step < REWIND_MAX && -1 <= live_cursor && live_cursor < REWIND_MAX && -1 <= target && target < REWIND_MAX) {
                live_frame: RewindFrameView = undo_snap_frame(u, room, a);
                archived_frame: RewindFrameView = undo_archived_frame(u, room, s,
                    data);
                if (undo_room_frame_equal(live_frame, archived_frame)) {
                    common = a;
                    match_step = s
                }
                s = s - 1
            }
            a = a - 1
        }
        if (common >= 0) {
            a = live_cursor;
            if (a > 0) a = a - 1 else a = -1;
            while (a >= common) invariant (a < REWIND_MAX) {
                live_frame: RewindFrameView = undo_snap_frame(u, room, a);
                route_count = undo_route_append(u, room, route_count, live_frame);
                a = a - 1
            }
        }
    }
    s = match_step + 1;
    while (s <= target) invariant (0 <= s && s <= REWIND_MAX && -1 <= target && target < REWIND_MAX) {
        archived_frame: RewindFrameView = undo_archived_frame(u, room, s, data);
        route_count = undo_route_append(u, room, route_count, archived_frame);
        s = s + 1
    }
    u.route_n[room] = route_count;
    u.route_ms[room] = rewind_return_step_ms(u.route_n[room])
}

undo_select_rooms(
    u: *UndoTimeline,
    action: int,
    blocks: []Block,
    n: int,
    pc: int,
    pr: int,
    ph: int
) raises IoError requires (0 <= n && n <= LEVEL_MAX_BLOCKS) {
    _phase_action: int = undo_set_phase(u, action, 0);
    // New obstructions/support can appear while an unrelated clock runs.
    for i in 0..n {
        b: Block = blocks[i];
        if (b.column == pc && b.row == pr && b.layer >= ph - 1 && b.layer <= ph + 1) {
            if (u.home[i] >= 0) u.selected[u.home[i]] = 1
        }
    }
    grown: bool = true;
    while (grown) {
        grown = false;
        for i in 0..n {
            owner: int = u.home[i];
            restore: bool = owner < 0 && u.changed[i] != 0;
            if (owner >= 0 && u.selected[owner] != 0) restore = true;
            if (restore) {
                p: int = u.image[u.block_base + i];
                for j in 0..n {
                    other: int = u.home[j];
                    b: Block = blocks[j];
                    if (other >= 0 && u.selected[other] == 0) {
                        at_target: bool = b.column == pos_col(p) && b.row == pos_row(p) && b.layer >= pos_layer(p) - 1 && b.layer <= pos_layer(p) + 1;
                        on_moving: bool = b.column == blocks[i].column && b.row == blocks[i].row && b.layer >= blocks[i].layer && b.layer <= blocks[i].layer + 1;
                        if (at_target || on_moving) {
                            u.selected[other] = 1;
                            grown = true
                        }
                    }
                }
            }
        }
    }
}

undo_sync_tick(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    nroom: int,
    room_ids: *RoomBlockIds,
    room_hn: []int,
    crate_pose: []int,
    crate_ms: []int,
    crate_cursor: *CrateCursor,
    crate_t0: []int,
    now: int
): bool requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && nroom <= len(room_hn) && len(blocks) == LEVEL_MAX_BLOCKS && len(blocks) <= len(crate_t0) && len(crate_pose) >= 16384 && len(crate_ms) >= 16384) {
    crate_drain(n, now, crate_ms, crate_cursor, crate_t0);
    waiting: bool = false;
    for r in 0..nroom {
        if (u.selected[r] != 0) {
            step: int = u.route_cur[r];
            steps: int = u.route_n[r];
            if (rewind_room_busy(r, room_ids, crate_cursor, n)) waiting = true else if (step < steps) {
                span: RoomBlockSpan = room_ids.spans[r];
                frame: RewindFrameView = undo_route_frame(u, r, step);
                slot: int = span.start;
                at: int = frame.start;
                frame_end: int = frame.end;
                frame_cells: []int = frame.cells;
                while (slot < span.end && at < frame_end) invariant (span.start <= slot && slot <= span.end && 0 <= at && at <= frame_end && frame_end <= len(frame_cells)) {
                    i: int = room_ids.indices[slot];
                    p: int = frame_cells[at];
                    blocks[i] = apply_packed(blocks[i], p);
                    crate_append(i, p, now, crate_pose, crate_ms, crate_cursor, crate_t0);
                    if (crate_cursor.counts[i] > 1) {
                        start: int = crate_cursor.starts[i];
                        count: int = crate_cursor.counts[i];
                        tail: int = crate_cursor_slot(start, count);
                        pos: int = crate_idx_bounded(i, tail);
                        crate_ms[pos] = u.route_ms[r]
                    }
                    slot = slot + 1;
                    at = at + 1
                }
                u.route_cur[r] = step + 1;
                waiting = true
            }
        }
    }
    waiting
}

undo_restore_history(
    u: *UndoTimeline,
    action: int,
    room: int,
    counts: []RewindCount,
    cursors: []RewindCursor,
    ghost: []int
) raises IoError requires (0 <= room && room < LEVEL_MAX_ROOMS && room < len(counts) && room < len(cursors) && room < len(ghost)) {
    data: []int = undo_load_history(u, action, 0);
    count_slot: int = room * 2;
    cursor_slot: int = count_slot + 1;
    count_code: int = u.meta_values[count_slot] as int;
    cursor_code: int = u.meta_values[cursor_slot] as int;
    counts[room].value = count_code;
    cursors[room].value = cursor_code - 1;
    ghost[room] = u.metas[room].ghost.*;
    for s in 0..count_code {
        source: UndoImageFrame = undo_image_frame(u, room, s);
        dest: RewindFrameView = undo_snap_frame(u, room, s);
        source_at: int = source.start;
        dest_at: int = dest.start;
        while (source_at < source.end && dest_at < dest.end) invariant (source.start <= source_at && source_at <= source.end && dest.start <= dest_at && dest_at <= dest.end) {
            dest.cells[dest_at] = data[source_at];
            source_at = source_at + 1;
            dest_at = dest_at + 1
        }
    }
}
