tag block_game;

use_tag std;

use_tag gl, x11, freetype;

PLAY_UNDO_DONE: int = 1;

PLAY_UNDO_WAIT: int = 2;

UNDO_ROUTE_MAX: int = REWIND_MAX * 2 + 1;

// One 20 MiB circular log, with no separate action-count limit or index.
// Record (64-bit words):
//   total length, pre-change count, packed player pose, room dependency mask,
//   changes from previous action to pre-move state, changes made by the move,
//   absolute start of this action.
// The first word gives the length for eviction; the last gives the start for undo.
// A walking action with unchanged world state occupies five words (40 bytes).
const UNDO_JOURNAL_WORDS: int = 2621440;

const UNDO_ACTION_HEADER: int = 4;

const UNDO_ACTION_OVERHEAD: int = 5;

// A change packs a 19-bit image address and a nonnegative 31-bit XOR payload
// into one word. All legal packed poses and room metadata fit in 31 bits.
UNDO_INDEX_BITS: int = 19;

const UNDO_INDEX_MASK: int = 524287;

const UNDO_BLOCK_BASE: int = UNDO_INDEX_MASK + 1 - LEVEL_MAX_BLOCKS;

type UndoRoomMeta = {
    count: *int;
    cursor: *int;
    ghost: *int
}

undo_empty_meta: int = 0;

type UndoTimeline = {
    home: []int;
    home_view: []int;
    deps: int;
    changed: []int;
    image: []int;
    image_capacity: int;
    block_base: int;
    journal: []int;
    stage: []int;
    stage_n: int;
    head: int;
    tail: int;
    count: int;
    phase: int;
    undoing: bool;
    offsets: []int;
    metas: []UndoRoomMeta;
    selected: []int;
    syncing: []int;
    route: []int;
    route_base: []int;
    route_n: []int;
    route_cur: []int;
    route_ms: []int
} invariant (len(home) == LEVEL_MAX_BLOCKS && len(home_view) == LEVEL_MAX_BLOCKS && len(changed) == LEVEL_MAX_BLOCKS && 0 <= block_base && block_base <= image_capacity - LEVEL_MAX_BLOCKS && block_base == UNDO_BLOCK_BASE && len(image) == image_capacity && image_capacity == UNDO_INDEX_MASK + 1 && len(offsets) == LEVEL_MAX_ROOMS && len(metas) == LEVEL_MAX_ROOMS && len(selected) == LEVEL_MAX_ROOMS && len(syncing) == LEVEL_MAX_ROOMS && len(route_base) == LEVEL_MAX_ROOMS && len(route_n) == LEVEL_MAX_ROOMS && len(route_cur) == LEVEL_MAX_ROOMS && len(route_ms) == LEVEL_MAX_ROOMS && len(stage) >= UNDO_ACTION_OVERHEAD && len(stage) <= len(journal) && len(journal) >= UNDO_ACTION_OVERHEAD && len(journal) <= UNDO_JOURNAL_WORDS && 0 <= tail && tail <= head && 0 <= stage_n && stage_n < len(stage), forall owner in home (0 - 1 <= owner && owner < LEVEL_MAX_ROOMS), forall off in offsets (0 <= off && off <= UNDO_INDEX_MASK - 2))

new_undo_timeline(home: []int, n: int, room_hn: []int) raises IoError: *UndoTimeline@new requires (0 <= n && n <= len(home)) ensures (len(returned.home) >= n) {
    new_undo_journal(home, n, room_hn, UNDO_JOURNAL_WORDS)
}

new_undo_journal(
    home: []int,
    n: int,
    room_hn: []int,
    words: int
) raises IoError: *UndoTimeline@new requires (0 <= n && n <= len(home) && words <= UNDO_JOURNAL_WORDS) ensures (len(returned.home) >= n) {
    owned: int = room_home_base(LEVEL_MAX_ROOMS, room_hn);
    block_base: int = LEVEL_MAX_ROOMS * 3 + owned * REWIND_MAX;
    image_n: int = block_base + n;
    image_capacity: int = UNDO_INDEX_MASK + 1;
    largest: int = image_n * 2 + UNDO_ACTION_OVERHEAD;
    if (words < largest || n > LEVEL_MAX_BLOCKS || image_capacity > UNDO_INDEX_MASK + 1 || image_capacity < LEVEL_MAX_BLOCKS || largest < UNDO_ACTION_OVERHEAD) die("undo journal too small");
    empty_meta: *int = &undo_empty_meta;
    metas: []UndoRoomMeta = new UndoRoomMeta[LEVEL_MAX_ROOMS](UndoRoomMeta { count: empty_meta, cursor: empty_meta, ghost: empty_meta });
    u: *UndoTimeline = new UndoTimeline {
        home: new int[LEVEL_MAX_BLOCKS](-1),
        home_view: new int[LEVEL_MAX_BLOCKS](-1),
        deps: 0,
        changed: new int[LEVEL_MAX_BLOCKS](0),
        image: new int[image_capacity](0),
        image_capacity: image_capacity,
        block_base: UNDO_BLOCK_BASE,
        journal: new int[words](0),
        stage: new int[largest](0),
        stage_n: 0,
        head: 0,
        tail: 0,
        count: 0,
        phase: 1,
        undoing: false,
        offsets: new int[LEVEL_MAX_ROOMS](0),
        metas: metas,
        selected: new int[LEVEL_MAX_ROOMS](0),
        syncing: new int[LEVEL_MAX_ROOMS](0),
        route: new int[n * UNDO_ROUTE_MAX](0),
        route_base: new int[LEVEL_MAX_ROOMS](0),
        route_n: new int[LEVEL_MAX_ROOMS](0),
        route_cur: new int[LEVEL_MAX_ROOMS](0),
        route_ms: new int[LEVEL_MAX_ROOMS](0)
    };
    for i in 0..n {
        owner: int = home[i];
        if (owner < -1 || owner >= LEVEL_MAX_ROOMS) die("invalid block room");
        u.home[i] = owner;
        u.home_view[i] = owner
    }
    base: int = 0;
    for r in 0..LEVEL_MAX_ROOMS {
        u.route_base[r] = base;
        base = base + room_hn[r] * UNDO_ROUTE_MAX;
        off: int = r * 3 + room_home_base(r, room_hn) * REWIND_MAX;
        if (off < 0 || off > len(u.image) - 3) die("invalid undo room layout");
        u.offsets[r] = off;
        u.metas[r] = UndoRoomMeta { count: &u.image[off], cursor: &u.image[off + 1], ghost: &u.image[off + 2] }
    }
    u
}

undo_read(u: *UndoTimeline, at: int) raises IndexOutOfBounds: int {
    if (at < 0) raise IndexOutOfBounds;
    u.journal[at % len(u.journal)]
}

undo_latest(u: *UndoTimeline) raises IoError, IndexOutOfBounds: int ensures (0 <= returned && u.tail <= returned && returned <= u.head) {
    if (u.count < 1) die("empty undo journal");
    start: int = undo_read(u, u.head - 1);
    if (start < u.tail || start > u.head - UNDO_ACTION_OVERHEAD) die("corrupt undo journal action");
    start
}

undo_change_index(change: int): int ensures (0 <= returned && returned <= UNDO_INDEX_MASK) {
    change & UNDO_INDEX_MASK
}

undo_apply_change(u: *UndoTimeline, change: int) {
    index: int = undo_change_index(change);
    u.image[index] = u.image[index] ^ change >> UNDO_INDEX_BITS
}

// Only the newest action is materialized. Switching phases reverses the
// action's post-move changes in the private image, never in live rooms.
undo_set_phase(u: *UndoTimeline, action: int, phase: int) raises IoError, IndexOutOfBounds: int ensures (u.tail <= returned && returned == action) {
    latest: int = undo_latest(u);
    if (action != latest) die("undo action is not the latest");
    if (phase != u.phase) {
        first: int = action + UNDO_ACTION_HEADER + undo_read(u, action + 1);
        for p in first..u.head - 1 undo_apply_change(u, undo_read(u, p));
        u.phase = phase
    }
    action
}

undo_load_history(u: *UndoTimeline, action: int, phase: int) raises IoError, IndexOutOfBounds: []int@u ensures (len(returned) == u.image_capacity && len(returned) == UNDO_INDEX_MASK + 1) {
    _phase_action: int = undo_set_phase(u, action, phase);
    u.image
}

undo_cancel_action(u: *UndoTimeline) {
    // Staging is separate from the ring: a bump cannot evict older actions,
    // even when background rooms have changed a large amount since last move.
    for i in UNDO_ACTION_HEADER..u.stage_n undo_apply_change(u, u.stage[i]);
    u.stage_n = 0;
    u.phase = 1
}

undo_clear_journal(u: *UndoTimeline) {
    if (u.stage_n > 0) undo_cancel_action(u);
    u.tail = 0;
    u.count = 0;
    u.head = 0;
    u.phase = 1;
    u.undoing = false
}

undo_pop_action(u: *UndoTimeline) raises IoError, IndexOutOfBounds {
    action: int = undo_latest(u);
    action = undo_set_phase(u, action, 0);
    // Restore the previous action's image, including unrelated room changes
    // recorded between actions. Live independent rooms are left untouched.
    end: int = action + UNDO_ACTION_HEADER + undo_read(u, action + 1);
    for p in action + UNDO_ACTION_HEADER..end undo_apply_change(u, undo_read(u, p));
    u.head = action;
    u.count = u.count - 1;
    u.phase = 1;
    u.undoing = false;
    if (u.count == 0) {
        u.tail = 0;
        u.head = 0
    }
}

undo_write_word(u: *UndoTimeline, index: int, value: int) raises IoError requires (0 <= index && index <= UNDO_INDEX_MASK) {
    delta: int = u.image[index] ^ value;
    if (delta == 0) return;
    if (delta < 0 || delta > 2147483647) die("undo value cannot be packed");
    stage: []int = u.stage;
    next_stage: int = u.stage_n + 1;
    if (next_stage >= len(u.stage)) die("undo stage is full");
    stage[next_stage - 1] = delta << UNDO_INDEX_BITS | index;
    u.stage_n = next_stage;
    u.image[index] = value
}

undo_commit_action(u: *UndoTimeline) raises UndoHistoryExhausted, IndexOutOfBounds {
    size: int = u.stage_n + 1;
    next_head: int = u.head + size;
    if (next_head < u.head) raise UndoHistoryExhausted;
    u.stage[0] = size;
    u.stage[3] = u.deps;
    u.stage[u.stage_n] = u.head;
    while (u.head - u.tail + size > len(u.journal)) {
        old_size: int = undo_read(u, u.tail);
        if (old_size < UNDO_ACTION_OVERHEAD || old_size > u.head - u.tail) raise IndexOutOfBounds;
        next_tail: int = u.tail + old_size;
        u.tail = next_tail;
        u.count = u.count - 1
    }
    ring: []int = u.journal;
    head_slot: int = u.head % len(ring);
    for i in 0..size {
        offset: int = head_slot + i;
        slot: int = offset % len(ring);
        ring[slot] = u.stage[i]
    }
    u.head = next_head;
    u.count = u.count + 1;
    u.stage_n = 0;
    u.phase = 1
}

// A fixed-size staging area holds at most two image diffs. No allocations or
// history eviction happen until the attempted action succeeds.
undo_save_history(
    u: *UndoTimeline,
    phase: bool,
    nroom: int,
    room_hn: []int,
    snap: []int,
    counts: []int,
    cursors: []int,
    ghost: []int,
    blocks: []Block,
    n: int,
    player: int
) raises IoError, UndoHistoryExhausted, IndexOutOfBounds requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && nroom <= len(counts) && nroom <= len(cursors) && nroom <= len(ghost) && nroom <= len(room_hn) && 0 <= n && n <= LEVEL_MAX_BLOCKS && n <= len(blocks)) {
    if (!phase) {
        if (u.count > 0) {
            latest: int = undo_latest(u);
            _phase_action: int = undo_set_phase(u, latest, 1)
        }
        u.stage_n = UNDO_ACTION_HEADER;
        u.stage[2] = player;
        u.deps = 0
    }
    for r in 0..nroom {
        width: int = room_hn[r];
        if (counts[r] < 0 || counts[r] > REWIND_MAX || width < 0) raise IndexOutOfBounds;
        off: int = u.offsets[r];
        undo_write_word(u, off, counts[r]);
        undo_write_word(u, off + 1, cursors[r]);
        undo_write_word(u, off + 2, ghost[r]);
        source: int = room_home_base(r, room_hn);
        stride: int = len(snap) / REWIND_MAX;
        for s in 0..counts[r] {
            frame: RewindFrameView = undo_frame_view(snap, s * stride + source, width);
            image_frame: RewindFrameView = undo_frame_view(u.image, off + 3 + s * width,
                width);
            source_at: int = frame.start;
            dest_at: int = image_frame.start;
            source_end: int = frame.end;
            dest_end: int = image_frame.end;
            frame_cells: []int = frame.cells;
            while (source_at < source_end && dest_at < dest_end) invariant (0 <= source_at && source_at <= source_end && source_end <= len(frame_cells) && 0 <= dest_at && dest_at <= dest_end && dest_end <= UNDO_INDEX_MASK + 1) {
                undo_write_word(u, dest_at, frame_cells[source_at]);
                source_at = source_at + 1;
                dest_at = dest_at + 1
            }
        }
    }
    for i in 0..n {
        b: Block = blocks[i];
        undo_write_word(u, u.block_base + i, pack_pos(b.column, b.row, b.layer, b.mounted))
    }
    if (!phase) u.stage[1] = u.stage_n - UNDO_ACTION_HEADER else undo_commit_action(u)
}

undo_depend(u: *UndoTimeline, room: int) {
    if (room >= 0 && room < LEVEL_MAX_ROOMS) u.deps = u.deps | 1 << room
}

// Reconstruct changed-block flags only for the action currently being undone.
// No per-block flag arrays are retained for older actions.
undo_prepare_action(u: *UndoTimeline, nroom: int, n: int) raises IoError, IndexOutOfBounds requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && 0 <= n && n <= LEVEL_MAX_BLOCKS) {
    action: int = undo_latest(u);
    _before_action: int = undo_set_phase(u, action, 1);
    for i in 0..n u.changed[i] = u.image[u.block_base + i];
    _after_action: int = undo_set_phase(u, action, 0);
    for i in 0..n {
        if (u.changed[i] != u.image[u.block_base + i]) u.changed[i] = 1 else u.changed[i] = 0
    }
    mask: int = undo_read(u, action + 3);
    for r in 0..nroom {
        u.selected[r] = mask >> r & 1;
        u.syncing[r] = 0
    }
    u.undoing = true
}

// Reading a block as support, a ramp, or an obstacle also couples its clock.
undo_read_cell(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    c: int,
    r: int,
    h: int
) {
    for i in 0..n {
        b: Block = blocks[i];
        if (b.column == c && b.row == r && b.layer >= h - 1 && b.layer <= h + 1) undo_depend(u,
            u.home[i])
    }
}

// Vacating the destination of a pending rewind step is an interaction even
// without touching a block. Use the pre-move archive: the move itself can
// change the live room history, and the obstruction may be gone by undo time.
undo_record_rewind_release(
    u: *UndoTimeline,
    nroom: int,
    room_hn: []int,
    pc: int,
    pr: int,
    nc: int,
    nr: int
) raises IndexOutOfBounds requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && nroom <= len(room_hn)) {
    if (pc == nc && pr == nr) return;
    data: []int = u.image;
    for r in 0..nroom {
        off: int = u.offsets[r];
        cur: int = u.metas[r].cursor.*;
        ghost: int = u.metas[r].ghost.*;
        if ((ghost == REWIND_LEAVE || ghost == REWIND_RESET) && cur > 0) {
            width: int = room_hn[r];
            from: int = off + 3 + cur * width;
            dest: int = off + 3 + rewind_dest_step(cur) * width;
            from_end: int = from + width;
            dest_end: int = dest + width;
            if (cur >= REWIND_MAX || width < 0 || from < 0 || dest < 0 || from_end < from || dest_end < dest || from_end > len(data) || dest_end > len(data)) raise IndexOutOfBounds;
            before: RewindFrameView = RewindFrameView { cells: data, start: from, end: from_end };
            after: RewindFrameView = RewindFrameView { cells: data, start: dest, end: dest_end };
            if (!rewind_frame_legal(before, after, pc, pr) && rewind_frame_legal(before,
                after, nc, nr)) undo_depend(u, r)
        }
    }
}

undo_record_action(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    room_hn: []int,
    before: []int,
    pc: int,
    pr: int,
    ph: int,
    nc: int,
    nr: int,
    nh: int
) raises IndexOutOfBounds requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && nroom <= len(room_hn)) {
    undo_depend(u, room_at(rooms, nroom, pc, pr));
    undo_depend(u, room_at(rooms, nroom, nc, nr));
    undo_read_cell(u, blocks, n, nc, nr, nh);
    undo_record_rewind_release(u, nroom, room_hn, pc, pr, nc, nr);
    for i in 0..n {
        p: int = before[i];
        b: Block = blocks[i];
        if (p != pack_pos(b.column, b.row, b.layer, b.mounted)) undo_depend(u, u.home[i]);
        if ((pos_col(p) == pc && pos_row(p) == pr || pos_col(p) == nc && pos_row(p) == nr) && pos_layer(p) >= ph - 1 && pos_layer(p) <= ph + 1) undo_depend(u,
            u.home[i])
    }
}

undo_frame_view(data: []int, start: int, width: int) raises IndexOutOfBounds: RewindFrameView {
    if (start < 0 || width < 0) raise IndexOutOfBounds;
    end: int = start + width;
    if (end < start || end > len(data)) raise IndexOutOfBounds;
    RewindFrameView { cells: data, start: start, end: end }
}

undo_room_frame_equal(a: RewindFrameView, b: RewindFrameView): bool {
    ai: int = a.start;
    bi: int = b.start;
    while (ai < a.end && bi < b.end) invariant (a.start <= ai && ai <= a.end && b.start <= bi && bi <= b.end) {
        if (a.cells[ai] != b.cells[bi]) return false;
        ai = ai + 1;
        bi = bi + 1
    }
    ai == a.end && bi == b.end
}

undo_route_append(
    u: *UndoTimeline,
    room: int,
    width: int,
    data: []int,
    off: int
) raises IndexOutOfBounds requires (0 <= room && room < LEVEL_MAX_ROOMS) {
    dest: int = u.route_base[room] + u.route_n[room] * width;
    route: []int = u.route;
    if (width < 0 || dest < 0 || off < 0) raise IndexOutOfBounds;
    dest_end: int = dest + width;
    source_end: int = off + width;
    if (dest_end < dest || source_end < off || dest_end > len(route) || source_end > len(data)) raise IndexOutOfBounds;
    dest_at: int = dest;
    source_at: int = off;
    while (dest_at < dest_end && source_at < source_end) invariant (dest <= dest_at && dest_at <= dest_end && dest_end <= len(route) && off <= source_at && source_at <= source_end && source_end <= len(data)) {
        route[dest_at] = data[source_at];
        dest_at = dest_at + 1;
        source_at = source_at + 1
    }
    u.route_n[room] = u.route_n[room] + 1
}

undo_build_route(
    u: *UndoTimeline,
    action: int,
    room: int,
    blocks: []Block,
    room_ids: *RoomBlockIds,
    room_hn: []int,
    live: []int,
    cursors: []int
) raises IoError, IndexOutOfBounds requires (0 <= room && room < LEVEL_MAX_ROOMS && room < len(room_hn) && room < len(cursors) && len(blocks) >= LEVEL_MAX_BLOCKS) {
    width: int = room_hn[room];
    data: []int = undo_load_history(u, action, 1);
    off: int = u.offsets[room];
    target: int = u.metas[room].cursor.*;
    u.route_n[room] = 0;
    u.route_cur[room] = 0;
    // Find the current configuration on the retained branch first.
    match_step: int = 0 - 1;
    s: int = target;
    while (s >= 0 && match_step < 0) {
        same: bool = true;
        span: RoomBlockSpan = room_ids.spans[room];
        frame: RewindFrameView = undo_frame_view(data, off + 3 + s * width, width);
        slot: int = span.start;
        at: int = frame.start;
        while (slot < span.end && at < frame.end) invariant (span.start <= slot && slot <= span.end && frame.start <= at && at <= frame.end) {
            id: int = room_ids.indices[slot];
            b: Block = blocks[id];
            if (pack_pos(b.column, b.row, b.layer, b.mounted) != frame.cells[at]) same = false;
            slot = slot + 1;
            at = at + 1
        }
        if (slot != span.end || at != frame.end) same = false;
        if (same) match_step = s;
        s = s - 1
    }
    if (match_step < 0) {
        // A later visit can have created a different branch. Walk back to the
        // shared configuration before traversing the retained branch forward.
        a: int = cursors[room];
        common: int = 0 - 1;
        while (a >= 0 && common < 0) {
            s = target;
            while (s >= 0 && common < 0) {
                live_frame: RewindFrameView = undo_frame_view(live, rewind_slot(room,
                    a, 0, room_hn, len(live) / REWIND_MAX), width);
                archived_frame: RewindFrameView = undo_frame_view(data, off + 3 + s * width,
                    width);
                if (undo_room_frame_equal(live_frame, archived_frame)) {
                    common = a;
                    match_step = s
                }
                s = s - 1
            }
            a = a - 1
        }
        if (common >= 0) {
            a = cursors[room] - 1;
            while (a >= common) {
                live_frame: int = rewind_slot(room, a, 0, room_hn, len(live) / REWIND_MAX);
                undo_route_append(u, room, width, live, live_frame);
                a = a - 1
            }
        }
    }
    s = match_step + 1;
    while (s <= target) {
        undo_route_append(u, room, width, data, off + 3 + s * width);
        s = s + 1
    }
    u.route_ms[room] = rewind_return_step_ms(u.route_n[room])
}

undo_select_rooms(
    u: *UndoTimeline,
    action: int,
    blocks: []Block,
    n: int,
    pc: int,
    pr: int,
    ph: int
) raises IoError, IndexOutOfBounds requires (0 <= n && n <= LEVEL_MAX_BLOCKS) {
    _phase_action: int = undo_set_phase(u, action, 0);
    // New obstructions/support can appear while an unrelated clock runs.
    for i in 0..n {
        b: Block = blocks[i];
        if (b.column == pc && b.row == pr && b.layer >= ph - 1 && b.layer <= ph + 1) {
            if (u.home[i] >= 0) u.selected[u.home[i]] = 1
        }
    }
    grown: bool = true;
    while (grown) {
        grown = false;
        for i in 0..n {
            owner: int = u.home[i];
            restore: bool = owner < 0 && u.changed[i] != 0;
            if (owner >= 0 && u.selected[owner] != 0) restore = true;
            if (restore) {
                p: int = u.image[u.block_base + i];
                for j in 0..n {
                    other: int = u.home[j];
                    b: Block = blocks[j];
                    if (other >= 0 && u.selected[other] == 0) {
                        at_target: bool = b.column == pos_col(p) && b.row == pos_row(p) && b.layer >= pos_layer(p) - 1 && b.layer <= pos_layer(p) + 1;
                        on_moving: bool = b.column == blocks[i].column && b.row == blocks[i].row && b.layer >= blocks[i].layer && b.layer <= blocks[i].layer + 1;
                        if (at_target || on_moving) {
                            u.selected[other] = 1;
                            grown = true
                        }
                    }
                }
            }
        }
    }
}

undo_sync_tick(
    u: *UndoTimeline,
    blocks: []Block,
    n: int,
    nroom: int,
    room_ids: *RoomBlockIds,
    room_hn: []int,
    crate_pose: []int,
    crate_ms: []int,
    crate_cursor: *CrateCursor,
    crate_t0: []int,
    now: int
) raises IndexOutOfBounds: bool requires (0 <= nroom && nroom <= LEVEL_MAX_ROOMS && nroom <= len(room_hn) && len(blocks) == LEVEL_MAX_BLOCKS && len(blocks) <= len(crate_t0) && len(crate_pose) >= 16384 && len(crate_ms) >= 16384) {
    crate_drain(n, now, crate_ms, crate_cursor, crate_t0);
    waiting: bool = false;
    for r in 0..nroom {
        if (u.selected[r] != 0) {
            if (rewind_room_busy(r, room_ids, crate_cursor, n)) waiting = true else if (u.route_cur[r] < u.route_n[r]) {
                width: int = room_hn[r];
                off: int = u.route_base[r] + u.route_cur[r] * width;
                span: RoomBlockSpan = room_ids.spans[r];
                if (width != span.end - span.start) raise IndexOutOfBounds;
                frame: RewindFrameView = undo_frame_view(u.route, off, width);
                slot: int = span.start;
                at: int = frame.start;
                frame_end: int = frame.end;
                frame_cells: []int = frame.cells;
                while (slot < span.end && at < frame_end) invariant (span.start <= slot && slot <= span.end && 0 <= at && at <= frame_end && frame_end <= len(frame_cells)) {
                    i: int = room_ids.indices[slot];
                    p: int = frame_cells[at];
                    blocks[i] = apply_packed(blocks[i], p);
                    crate_append(i, p, now, crate_pose, crate_ms, crate_cursor, crate_t0);
                    if (crate_cursor.counts[i] > 1) {
                        start: int = crate_cursor.starts[i];
                        count: int = crate_cursor.counts[i];
                        tail: int = crate_cursor_slot(start, count);
                        pos: int = crate_idx_bounded(i, tail);
                        crate_ms[pos] = u.route_ms[r]
                    }
                    slot = slot + 1;
                    at = at + 1
                }
                u.route_cur[r] = u.route_cur[r] + 1;
                waiting = true
            }
        }
    }
    waiting
}

undo_restore_history(
    u: *UndoTimeline,
    action: int,
    room: int,
    room_hn: []int,
    snap: []int,
    counts: []int,
    cursors: []int,
    ghost: []int
) raises IoError, IndexOutOfBounds requires (0 <= room && room < LEVEL_MAX_ROOMS && room < len(room_hn) && room < len(counts) && room < len(cursors) && room < len(ghost)) {
    off: int = u.offsets[room];
    data: []int = undo_load_history(u, action, 0);
    counts[room] = u.metas[room].count.*;
    cursors[room] = u.metas[room].cursor.*;
    ghost[room] = u.metas[room].ghost.*;
    width: int = room_hn[room];
    if (counts[room] < 0 || counts[room] > REWIND_MAX) raise IndexOutOfBounds;
    for s in 0..counts[room] {
        source: RewindFrameView = undo_frame_view(data, off + 3 + s * width, width);
        dest: RewindFrameView = undo_frame_view(snap, rewind_slot(room, s, 0, room_hn,
            len(snap) / REWIND_MAX), width);
        source_at: int = source.start;
        dest_at: int = dest.start;
        while (source_at < source.end && dest_at < dest.end) invariant (source.start <= source_at && source_at <= source.end && dest.start <= dest_at && dest_at <= dest.end) {
            dest.cells[dest_at] = source.cells[source_at];
            source_at = source_at + 1;
            dest_at = dest_at + 1
        }
    }
}
