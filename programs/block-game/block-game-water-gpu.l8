tag block_game;
use_tag gl;
extern glUniform4f(location: int,x: f32,y: f32,z: f32,w: f32): int;
extern glDrawBuffers(count: int,buffers: *i32): int;

type GpuWater = {
    fluid: *GpuFluid;
    main: int; programs: []int; u: []int;
    mask: u32; textures: []u32; fbos: []u32;
    draw_buffers: []i32;
    zeros: []i8; inverse: []f32; matrix_work: []f32;
    disabled: bool; raw: bool; splash_requested: bool; initial_splash: bool; report: bool;
    stress: bool; next_stress: int;
    visible: int; last_us: int; player_x: f32; player_z: f32; player_ready: bool;
    query: []u32; pending: []int; available: []i32; result: []int;
    frame: int; cpu_sum: int; sim_sum: int; render_sum: int; sim_samples: int; render_samples: int;
    label: []i8;
};

new_gpu_water(main_prog: int): *GpuWater@new {
    g: *GpuFluid=new_gpu_fluid();
    mask: []u32=new u32[1](0u32); glGenTextures(1,mask);
    glActiveTexture(33989); glBindTexture(3553,mask[0]);
    glTexParameteri(3553,10241,9728); glTexParameteri(3553,10240,9728);
    glTexParameteri(3553,10242,33071); glTexParameteri(3553,10243,33071);
    glTexImage2D(3553,0,6409,FLUID_TILES,FLUID_TILES,0,6409,5121,g.seed.tiles);
    glUseProgram(main_prog); glUniform1i(glGetUniformLocation(main_prog,"fluid_mask"),5);
    textures: []u32=new u32[3](0u32); fbos: []u32=new u32[2](0u32);
    programs: []int=new int[3](0); u: []int=new int[20](-1);
    queries: []u32=new u32[8](0u32);
    if (g.supported) {
        programs[0]=link_program(gpu_water_splat_vs(),gpu_water_splat_fs(),"nrm");
        programs[1]=link_program(gpu_water_full_vs(),gpu_water_filter_fs(),"nrm");
        programs[2]=link_program(gpu_water_full_vs(),gpu_water_composite_fs(),"nrm");
        glGenTextures(3,textures); glGenFramebuffers(2,fbos);
        depth: []u32=new u32[1](0u32); glGenRenderbuffers(1,depth);
        glBindRenderbuffer(36161,depth[0]); glRenderbufferStorage(36161,33190,1200,720);
        for i in 0..2 {
            glBindTexture(3553,textures[i]);
            glTexParameteri(3553,10241,9729); glTexParameteri(3553,10240,9729);
            glTexParameteri(3553,10242,33071); glTexParameteri(3553,10243,33071);
            glTexImage2D(3553,0,33326,1200,720,0,6403,5126,null);
            glBindFramebuffer(36160,fbos[i]); glFramebufferTexture2D(36160,36064,3553,textures[i],0);
            if (i==0) { glFramebufferRenderbuffer(36160,36096,36161,depth[0]); }
            glDrawBuffer(36064); glReadBuffer(36064);
            if (glCheckFramebufferStatus(36160)!=36053) { die("water depth framebuffer incomplete"); }
        }
        // Motion is a separate byte channel, not duplicated at every filtered
        // depth sample. Keep full 32-bit depth precision for stable normals.
        glActiveTexture(33991); glBindTexture(3553,textures[2]);
        glTexParameteri(3553,10241,9728); glTexParameteri(3553,10240,9728);
        glTexParameteri(3553,10242,33071); glTexParameteri(3553,10243,33071);
        glTexImage2D(3553,0,33321,1200,720,0,6403,5121,null);
        glBindFramebuffer(36160,0u32); glDrawBuffer(1029); glReadBuffer(1029);
        glUseProgram(programs[0]); glUniform1i(glGetUniformLocation(programs[0],"check_map"),1);
        u[0]=glGetUniformLocation(programs[0],"vp"); u[1]=glGetUniformLocation(programs[0],"alpha");
        u[2]=glGetUniformLocation(programs[0],"camera"); u[3]=glGetUniformLocation(programs[0],"mask_origin");
        glUseProgram(programs[1]); glUniform1i(glGetUniformLocation(programs[1],"depths"),6);
        glUniform1i(glGetUniformLocation(programs[1],"motion_map"),7);
        u[4]=glGetUniformLocation(programs[1],"direction");
        u[17]=glGetUniformLocation(programs[1],"ray_y");
        u[18]=glGetUniformLocation(programs[1],"focal_pixels");
        u[19]=glGetUniformLocation(programs[1],"filter_pass");
        glUseProgram(programs[2]);
        glUniform1i(glGetUniformLocation(programs[2],"depths"),6);
        glUniform1i(glGetUniformLocation(programs[2],"reflection_map"),4);
        glUniform1i(glGetUniformLocation(programs[2],"lamp_map"),2);
        glUniform1i(glGetUniformLocation(programs[2],"check_map"),1);
        glUniform1i(glGetUniformLocation(programs[2],"shadow_map"),0);
        u[5]=glGetUniformLocation(programs[2],"vp"); u[6]=glGetUniformLocation(programs[2],"inverse_vp");
        u[7]=glGetUniformLocation(programs[2],"camera"); u[8]=glGetUniformLocation(programs[2],"light_vp");
        u[9]=glGetUniformLocation(programs[2],"mask_origin"); u[10]=glGetUniformLocation(programs[2],"lamp_origin");
        u[11]=glGetUniformLocation(programs[2],"reflection_on");
        u[12]=glGetUniformLocation(programs[2],"spec_lamps[0]"); u[13]=glGetUniformLocation(programs[2],"spec_lamps[1]");
        u[14]=glGetUniformLocation(programs[2],"spec_lamps[2]"); u[15]=glGetUniformLocation(programs[2],"spec_lamps[3]");
        glGenQueries(8,queries);
    } else {
        write(2,"GPU water needs OpenGL 4.3; using static water\n",len("GPU water needs OpenGL 4.3; using static water\n"));
    }
    u[16]=glGetUniformLocation(main_prog,"fluid_origin");
    glUseProgram(main_prog); glActiveTexture(33989); glBindTexture(3553,mask[0]); glActiveTexture(33984);
    new GpuWater { fluid:g,main:main_prog,programs:programs,u:u,mask:mask[0],textures:textures,fbos:fbos,
        draw_buffers:[36064i32,36065i32],
        zeros:new i8[FLUID_TILES*FLUID_TILES](0i8),inverse:new f32[16](0.0),matrix_work:new f32[32](0.0),
        disabled:!g.supported || getenv("L8_WATER_STATIC")!=null,raw:getenv("L8_WATER_RAW")!=null,splash_requested:false,
        initial_splash:getenv("L8_WATER_SPLASH")!=null,report:getenv("L8_WATER_STATS")!=null,
        stress:getenv("L8_WATER_STRESS")!=null,next_stress:0,
        visible:0,last_us:0,player_x:0.0,player_z:0.0,player_ready:false,
        query:queries,pending:new int[8](0),available:new i32[1](0i32),result:new int[1](0),
        frame:0,cpu_sum:0,sim_sum:0,render_sum:0,sim_samples:0,render_samples:0,label:new i8[256](0i8) };
}

toggle_gpu_water(w: *GpuWater) {
    if (!w.fluid.supported) { return; }
    w.disabled=!w.disabled; w.last_us=0; w.fluid.debt=0.0; w.player_ready=false;
    glActiveTexture(33989); glBindTexture(3553,w.mask);
    if (w.disabled) { glTexSubImage2D(3553,0,0,0,FLUID_TILES,FLUID_TILES,6409,5121,w.zeros); }
    else { glTexSubImage2D(3553,0,0,0,FLUID_TILES,FLUID_TILES,6409,5121,w.fluid.seed.tiles); }
    glActiveTexture(33984);
    if (w.disabled) { write(2,"GPU water off\n",len("GPU water off\n")); }
    else { write(2,"GPU water on (F8: splash)\n",len("GPU water on (F8: splash)\n")); }
}

request_gpu_splash(w: *GpuWater) {
    if (w.disabled) { toggle_gpu_water(w); }
    w.splash_requested=true;
}

gpu_pond_visible(g: *GpuFluid,id: int,vp: []f32): bool {
    minx: f32=10000.0; maxx: f32=-10000.0; miny: f32=10000.0; maxy: f32=-10000.0;
    minz: f32=10000.0; maxz: f32=-10000.0; behind: int=0;
    for corner in 0..8 {
        x: f32=(g.seed.x+g.bounds[id*4]) as f32-2.0;
        z: f32=(g.seed.z+g.bounds[id*4+1]) as f32-2.0; y: f32=-0.6;
        if (corner%2!=0) { x=(g.seed.x+g.bounds[id*4+2]) as f32+2.0; }
        if ((corner/2)%2!=0) { z=(g.seed.z+g.bounds[id*4+3]) as f32+2.0; }
        if (corner>=4) { y=2.0; }
        cw: f32=vp[3]*x+vp[7]*y+vp[11]*z+vp[15];
        if (cw<0.01) { behind=behind+1; } else {
        sx: f32=(vp[0]*x+vp[4]*y+vp[8]*z+vp[12])/cw;
        sy: f32=(vp[1]*x+vp[5]*y+vp[9]*z+vp[13])/cw;
        sz: f32=(vp[2]*x+vp[6]*y+vp[10]*z+vp[14])/cw;
        if (sx<minx) { minx=sx; } if (sx>maxx) { maxx=sx; }
        if (sy<miny) { miny=sy; } if (sy>maxy) { maxy=sy; }
        if (sz<minz) { minz=sz; } if (sz>maxz) { maxz=sz; }
        }
    }
    behind<8 && (behind>0 || minx<1.1 && maxx>-1.1 && miny<1.1 && maxy>-1.1 && minz<1.0 && maxz>-1.0);
}

gpu_water_collect(w: *GpuWater) {
    for i in 0..8 {
        if (w.pending[i]!=0) {
            glGetQueryObjectiv(w.query[i],34919,w.available);
            if (w.available[0]!=0i32) {
                glGetQueryObjectui64v(w.query[i],34918,w.result); w.pending[i]=0;
                if (i%2==0) { w.sim_sum=w.sim_sum+w.result[0]/1000; w.sim_samples=w.sim_samples+1; }
                else { w.render_sum=w.render_sum+w.result[0]/1000; w.render_samples=w.render_samples+1; }
            }
        }
    }
}

prepare_gpu_water(w: *GpuWater,ground: []GroundCell,n: int,cx: int,cz: int,
    px: f32,pz: f32,player: int,vp: []f32) {
    now: int=mono_us(); elapsed: f32=0.0;
    if (w.last_us!=0) { elapsed=(now-w.last_us) as f32*0.000001; } w.last_us=now;
    w.visible=0;
    if (w.disabled) { return; }
    g: *GpuFluid=w.fluid; f: *Fluid=g.seed;
    // Retain resident sleeping/offscreen ponds until a different water feature is
    // actually visible outside the resident window. Panning across dry land is free.
    refresh: bool=!f.ready;
    min_c: int=999999; min_r: int=999999; max_c: int=-999999; max_r: int=-999999;
    nearest: int=999999; near_c: int=cx; near_r: int=cz;
    for i in 0..n {
        c: GroundCell=ground[i];
        if (c.style==GROUND_WATER && grass_cell_in_view(vp,c.column,c.row)!=0) {
            if (c.column<f.x+1 || c.column>=f.x+FLUID_TILES-1 || c.row<f.z+1 || c.row>=f.z+FLUID_TILES-1) { refresh=true; }
            if (c.column<min_c) { min_c=c.column; } if (c.column>max_c) { max_c=c.column; }
            if (c.row<min_r) { min_r=c.row; } if (c.row>max_r) { max_r=c.row; }
            dc: int=c.column-cx; dr: int=c.row-cz;
            if (dc<0) { dc=-dc; } if (dr<0) { dr=-dr; }
            if (dc+dr<nearest) { nearest=dc+dr; near_c=c.column; near_r=c.row; }
        }
    }
    sx: int=f.x+FLUID_TILES/2; sz: int=f.z+FLUID_TILES/2;
    if (refresh) {
        sx=near_c; sz=near_r;
        if (min_c<=max_c && max_c-min_c<FLUID_TILES-2 && max_r-min_r<FLUID_TILES-2) {
            sx=(min_c+max_c+1)/2; sz=(min_r+max_r+1)/2;
        }
        if (sx!=f.x+FLUID_TILES/2 || sz!=f.z+FLUID_TILES/2) { f.ready=false; }
    }
    changed: bool=fluid_prepare(f,ground,n,sx,sz);
    if (changed) {
        gpu_fluid_seed(g); elapsed=0.0; w.next_stress=0;
        glActiveTexture(33989); glBindTexture(3553,w.mask);
        glTexSubImage2D(3553,0,0,0,FLUID_TILES,FLUID_TILES,6409,5121,f.tiles); glActiveTexture(33984);
        if (w.initial_splash) { w.splash_requested=true; }
    }
    glUseProgram(w.main); glUniform2f(w.u[16],f.x as f32,f.z as f32);
    for id in 0..g.ponds {
        g.commands[id*4]=0.0;
        if (gpu_pond_visible(g,id,vp)) { g.commands[id*4]=1.0; w.visible=w.visible+1; }
    }
    if (w.visible==0 || f.n==0) { g.debt=0.0; g.paused=g.paused+1; w.player_ready=false; return; }
    if (w.stress && g.steps>=w.next_stress) { w.splash_requested=true; w.next_stress=g.steps+30; }
    if (w.splash_requested) {
        best: int=-1; distance: f32=10000000.0;
        for i in 0..f.n {
            p: *FluidParticle=&f.p[i]; id: int=g.packed[i*16+3] as int;
            dx: f32=p.x-px; dz: f32=p.z-pz; d: f32=dx*dx+dz*dz;
            if (g.commands[id*4]>0.5 && d<distance) { distance=d; best=i; }
        }
        if (best>=0) {
            id: int=g.packed[best*16+3] as int;
            g.commands[id*4+1]=2.4; g.commands[id*4+2]=f.p[best].x; g.commands[id*4+3]=f.p[best].z;
            w.splash_requested=false;
        }
    }
    if (player!=0 && w.player_ready && !changed) {
        dx: f32=px-w.player_x; dz: f32=pz-w.player_z; d2: f32=dx*dx+dz*dz;
        if (d2>0.00001 && d2<0.25) {
            for id in 0..g.ponds {
                nx: f32=px; nz: f32=pz;
                lo: f32=(f.x+g.bounds[id*4]) as f32; hi: f32=(f.x+g.bounds[id*4+2]) as f32;
                if (nx<lo) { nx=lo; } if (nx>hi) { nx=hi; }
                lo=(f.z+g.bounds[id*4+1]) as f32; hi=(f.z+g.bounds[id*4+3]) as f32;
                if (nz<lo) { nz=lo; } if (nz>hi) { nz=hi; }
                if ((px-nx)*(px-nx)+(pz-nz)*(pz-nz)<0.64 && g.commands[id*4+1]<0.01) {
                    g.commands[id*4+1]=sqrtf(d2)*1.5; g.commands[id*4+2]=px; g.commands[id*4+3]=pz;
                }
            }
        }
    }
    w.player_x=px; w.player_z=pz; w.player_ready=player!=0;
    gpu_water_collect(w);
    slot: int=(w.frame%4)*2; timed: bool=w.pending[slot]==0;
    if (timed) { glBeginQuery(35007,w.query[slot]); }
    if (elapsed<0.0) { elapsed=0.0; }
    g.debt=g.debt+elapsed;
    if (g.debt>0.25) { g.dropped_us=g.dropped_us+((g.debt-0.25)*1000000.0) as int; g.debt=0.25; }
    gpu_fluid_commands(g);
    steps: int=0;
    while (g.debt>=FLUID_DT && steps<8) {
        gpu_fluid_step(g); g.debt=g.debt-FLUID_DT; steps=steps+1;
        if (steps==1) {
            for id in 0..g.ponds { g.commands[id*4+1]=0.0; }
            gpu_fluid_commands(g);
        }
    }
    if (timed) { glEndQuery(35007); w.pending[slot]=1; }
    glUseProgram(w.main);
    w.cpu_sum=w.cpu_sum+mono_us()-now;
}

// Invert the current projection/view matrix once, not for every water pixel.
gpu_water_inverse(w: *GpuWater,vp: []f32) {
    a: []f32=w.matrix_work;
    for r in 0..4 { for c in 0..8 {
        value: f32=0.0;
        if (c<4) { value=vp[c*4+r]; } else if (c==r+4) { value=1.0; }
        a[r*8+c]=value;
    } }
    for c in 0..4 {
        pivot: int=c; biggest: f32=0.0;
        for r in c..4 {
            value: f32=a[r*8+c]; if (value<0.0) { value=-value; }
            if (value>biggest) { biggest=value; pivot=r; }
        }
        if (biggest<0.00000001) { die("singular water view matrix"); }
        for k in 0..8 { temp: f32=a[c*8+k]; a[c*8+k]=a[pivot*8+k]; a[pivot*8+k]=temp; }
        scale: f32=a[c*8+c]; for k in 0..8 { a[c*8+k]=a[c*8+k]/scale; }
        for r in 0..4 { if (r!=c) {
            scale=a[r*8+c]; for k in 0..8 { a[r*8+k]=a[r*8+k]-scale*a[c*8+k]; }
        } }
    }
    for r in 0..4 { for c in 0..4 { w.inverse[c*4+r]=a[r*8+c+4]; } }
}

draw_gpu_water(w: *GpuWater,vp: []f32,lvp: []f32,cx: f32,cy: f32,cz: f32,
    mask_x: int,mask_z: int,material: *MaterialLight,light: *LampLight,lamps: []Lamp) {
    if (w.disabled || w.visible==0 || w.fluid.seed.n==0) { return; }
    slot: int=(w.frame%4)*2+1; timed: bool=w.pending[slot]==0;
    if (timed) { glBeginQuery(35007,w.query[slot]); }
    gpu_water_inverse(w,vp); gpu_fluid_bind(w.fluid);
    glBindFramebuffer(36160,w.fbos[0]);
    glFramebufferTexture2D(36160,36065,3553,w.textures[2],0);
    glDrawBuffers(2,w.draw_buffers); glReadBuffer(36064);
    glViewport(0,0,1200,720); glClearColor(0.0,0.0,0.0,0.0); glClear(16640);
    glUseProgram(w.programs[0]); glUniformMatrix4fv(w.u[0],1,0,vp);
    alpha: f32=w.fluid.debt/FLUID_DT; if (alpha>1.0) { alpha=1.0; }
    glUniform1f(w.u[1],alpha); glUniform3f(w.u[2],cx,cy,cz);
    glUniform2f(w.u[3],mask_x as f32,mask_z as f32);
    glDrawArraysInstanced(4,0,6,w.fluid.seed.n);
    glDrawBuffer(36064); glFramebufferTexture2D(36160,36065,3553,0u32,0);
    glActiveTexture(33991); glBindTexture(3553,w.textures[2]);
    glDisable(2929); glDepthMask(0); glUseProgram(w.programs[1]);
    proj_x: f32=sqrtf(vp[0]*vp[0]+vp[4]*vp[4]+vp[8]*vp[8]);
    proj_y: f32=sqrtf(vp[1]*vp[1]+vp[5]*vp[5]+vp[9]*vp[9]);
    glUniform4f(w.u[17],vp[4]/(proj_x*proj_x),vp[5]/(proj_y*proj_y),vp[7],cy);
    glUniform1f(w.u[18],proj_y*360.0);
    passes: int=4; if(w.raw) { passes=0; }
    for pass in 0..passes {
        source: int=pass%2; target: int=1-source;
        glBindFramebuffer(36160,w.fbos[target]); glDrawBuffer(36064);
        glActiveTexture(33990); glBindTexture(3553,w.textures[source]);
        if (source==0) { glUniform2f(w.u[4],1.0/1200.0,0.0); }
        else { glUniform2f(w.u[4],0.0,1.0/720.0); }
        glUniform1f(w.u[19],pass as f32);
        glDrawArrays(4,0,3);
    }
    glBindFramebuffer(36160,0u32); glDrawBuffer(1029); glReadBuffer(1029);
    glEnable(2929); glDepthMask(1);
    glUseProgram(w.programs[2]); glActiveTexture(33990); glBindTexture(3553,w.textures[0]);
    glUniformMatrix4fv(w.u[5],1,0,vp); glUniformMatrix4fv(w.u[6],1,0,w.inverse);
    glUniform3f(w.u[7],cx,cy,cz); glUniformMatrix4fv(w.u[8],1,0,lvp);
    glUniform2f(w.u[9],mask_x as f32,mask_z as f32);
    glUniform2f(w.u[10],light.x as f32,light.z as f32);
    reflecting: f32=0.0; if (material.reflection_ready) { reflecting=1.0; }
    glUniform1f(w.u[11],reflecting);
    for i in 0..4 {
        id: int=material.nearest[i];
        if (id<0) { glUniform3f(w.u[12+i],0.0,-100.0,0.0); }
        else {
            lamp: Lamp=lamps[id]; height: f32=0.38; if (lamp.style==1) { height=1.85; }
            glUniform3f(w.u[12+i],lamp.column as f32+0.5,height,lamp.row as f32+0.5);
        }
    }
    glDrawArrays(4,0,3);
    glActiveTexture(33984); glUseProgram(w.main); glClearColor(0.07,0.06,0.055,1.0);
    if (timed) { glEndQuery(35007); w.pending[slot]=1; }
    w.frame=w.frame+1;
    if (w.report && w.frame%120==0) {
        i: int=put_str(w.label,0,"GPU water: particles="); i=put_int(w.label,i,w.fluid.seed.n);
        i=put_str(w.label,i," visible/resident ponds="); i=put_int(w.label,i,w.visible);
        i=put_str(w.label,i,"/"); i=put_int(w.label,i,w.fluid.ponds);
        i=put_str(w.label,i," avg CPU/sim/render us="); i=put_int(w.label,i,w.cpu_sum/120);
        i=put_str(w.label,i,"/"); if (w.sim_samples>0) { i=put_int(w.label,i,w.sim_sum/w.sim_samples); }
        i=put_str(w.label,i,"/"); if (w.render_samples>0) { i=put_int(w.label,i,w.render_sum/w.render_samples); }
        i=put_str(w.label,i," steps="); i=put_int(w.label,i,w.fluid.steps);
        i=put_str(w.label,i," debt/dropped us="); i=put_int(w.label,i,(w.fluid.debt*1000000.0) as int);
        i=put_str(w.label,i,"/"); i=put_int(w.label,i,w.fluid.dropped_us);
        i=put_str(w.label,i,"\n"); write(2,w.label,i);
        w.cpu_sum=0; w.sim_sum=0; w.render_sum=0; w.sim_samples=0; w.render_samples=0;
    }
}
