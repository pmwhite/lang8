tag block_game;

use_tag gl;

// A 3D density field and marching tetrahedra surface reconstructed from particles.
// Overhangs and detached drops are possible; this is not a height-field renderer.
WATER_NX: int = FLUID_TILES * 6 + 1;

WATER_NY: int = 17;

WATER_NODES: int = WATER_NX * WATER_NX * WATER_NY;

WATER_VERTICES: int = 262140;

extern getenv(name: str): ?*i8;

extern glBufferSubData(
    target: int,
    offset: int,
    size: int,
    data: *f32
): int;

extern glGenQueries(n: int, ids: *u32): int;

extern glBeginQuery(target: int, id: u32): int;

extern glEndQuery(target: int): int;

extern glGetQueryObjectiv(id: u32, pname: int, result: *i32): int;

extern glGetQueryObjectui64v(id: u32, pname: int, result: *int): int;

type WaterSurface = {
    fluid: *Fluid;
    mesh: u32;
    mask: u32;
    field: []f32;
    gradient: []f32;
    vertices: []f32;
    touched: []int;
    touched_count: int;
    cube: []int;
    inside: []int;
    outside: []int;
    count: int;
    clipped: int;
    enabled: int;
    origin: int;
    last_us: int;
    frames: int;
    sum_sim: int;
    sum_mesh: int;
    sum_gpu: int;
    gpu_samples: int;
    query: []u32;
    pending: []int;
    query_index: int;
    available: []i32;
    result: []int;
    report: bool;
    disabled: bool;
    splash: bool;
    splash_requested: bool;
    label: []i8;
    player_x: f32;
    player_z: f32;
    player_ready: bool;
};

new_water_surface(prog: int): *WaterSurface@new {
    buffers: []u32 = new u32[1](0u32);
    glGenBuffers(1, buffers);
    textures: []u32 = new u32[1](0u32);
    glGenTextures(1, textures);
    f: *Fluid = new_fluid();
    glActiveTexture(33989);
    glBindTexture(3553, textures[0]);
    glTexParameteri(3553, 10241, 9728);
    glTexParameteri(3553, 10240, 9728);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 6409, FLUID_TILES, FLUID_TILES, 0, 6409, 5121, f.tiles);
    glUseProgram(prog);
    glUniform1i(glGetUniformLocation(prog, "fluid_mask"), 5);
    glActiveTexture(33984);
    queries: []u32 = new u32[4](0u32);
    glGenQueries(4, queries);
    vertices: []f32 = new f32[WATER_VERTICES * 6](0.0);
    glBindBuffer(34962, buffers[0]);
    glBufferData(34962, WATER_VERTICES * 24, vertices, 35048);
    new WaterSurface {
        fluid: f,
        mesh: buffers[0],
        mask: textures[0],
        field: new f32[WATER_NODES](0.0),
        gradient: new f32[WATER_NODES * 3](0.0),
        touched: new int[WATER_NODES](0),
        touched_count: 0,
        vertices: vertices,
        cube: new int[8](0),
        inside: new int[4](0),
        outside: new int[4](0),
        count: 0,
        clipped: 0,
        enabled: glGetUniformLocation(prog, "water_mesh"),
        origin: glGetUniformLocation(prog, "fluid_origin"),
        last_us: 0,
        frames: 0,
        sum_sim: 0,
        sum_mesh: 0,
        sum_gpu: 0,
        gpu_samples: 0,
        query: queries,
        pending: new int[4](0),
        query_index: 0,
        available: new i32[1](0i32),
        result: new int[1](0),
        report: getenv("L8_WATER_STATS") != null,
        disabled: getenv("L8_WATER_STATIC") != null,
        splash: getenv("L8_WATER_SPLASH") != null,
        splash_requested: false,
        label: new i8[256](0i8),
        player_x: 0.0,
        player_z: 0.0,
        player_ready: false
    };
}

water_node(x: int, y: int, z: int): int {
    (y * WATER_NX + z) * WATER_NX + x;
}

toggle_water_volume(w: *WaterSurface) {
    w.disabled = !w.disabled;
    w.fluid.ready = false;
    w.count = 0;
    w.last_us = 0;
    w.player_ready = false;
    // Clear holes immediately; the next enabled frame repopulates this mask.
    for i in 0..len(w.fluid.tiles) w.fluid.tiles[i] = 0i8;
    glActiveTexture(33989);
    glBindTexture(3553, w.mask);
    glTexSubImage2D(3553, 0, 0, 0, FLUID_TILES, FLUID_TILES, 6409, 5121, w.fluid.tiles);
    glActiveTexture(33984);
    if (w.disabled) write(2, "volumetric water off\n", len("volumetric water off\n")); else write(2,
        "volumetric water on (F8: splash)\n", len("volumetric water on (F8: splash)\n"));
}

request_water_splash(w: *WaterSurface) {
    if (w.disabled) toggle_water_volume(w);
    w.splash_requested = true;
    write(2, "water splash\n", len("water splash\n"));
}

water_density(w: *WaterSurface, alpha: f32) {
    // Clear just nodes touched last frame, including drops which moved away.
    for i in 0..w.touched_count {
        at: int = w.touched[i];
        w.field[at] = 0.0;
        w.gradient[at * 3] = 0.0;
        w.gradient[at * 3 + 1] = 0.0;
        w.gradient[at * 3 + 2] = 0.0;
    }
    w.touched_count = 0;
    f: *Fluid = w.fluid;
    for i in 0..f.n {
        p: FluidParticle = f.p[i];
        px: f32 = p.ox + (p.x - p.ox) * alpha - f.x as f32;
        py: f32 = p.oy + (p.y - p.oy) * alpha;
        pz: f32 = p.oz + (p.z - p.oz) * alpha - f.z as f32;
        cx: int = floor_i(px * 6.0);
        cy: int = floor_i((py + 0.6666667) * 6.0);
        cz: int = floor_i(pz * 6.0);
        for y in -1..3 {
            for z in -1..3 {
                for x in -1..3 {
                    xx: int = cx + x;
                    yy: int = cy + y;
                    zz: int = cz + z;
                    if (xx >= 0 && yy >= 0 && zz >= 0 && xx < WATER_NX && yy < WATER_NY && zz < WATER_NX) {
                        dx: f32 = xx as f32 / 6.0 - px;
                        dy: f32 = yy as f32 / 6.0 - 0.6666667 - py;
                        dz: f32 = zz as f32 / 6.0 - pz;
                        q: f32 = 1.0 - (dx * dx + dy * dy + dz * dz) / 0.060025;
                        if (q > 0.0) {
                            at: int = water_node(xx, yy, zz);
                            if (w.field[at] == 0.0) {
                                w.touched[w.touched_count] = at;
                                w.touched_count = w.touched_count + 1;
                            }
                            w.field[at] = w.field[at] + q * q * q;
                            g: f32 = 6.0 * q * q / 0.060025;
                            w.gradient[at * 3] = w.gradient[at * 3] + dx * g;
                            w.gradient[at * 3 + 1] = w.gradient[at * 3 + 1] + dy * g;
                            w.gradient[at * 3 + 2] = w.gradient[at * 3 + 2] + dz * g;
                        }
                    }
                }
            }
        }
    }
}

water_vertex(w: *WaterSurface, a: int, b: int) {
    t: f32 = (0.55 - w.field[a]) / (w.field[b] - w.field[a]);
    ax: f32 = (a % WATER_NX) as f32 / 6.0;
    az: f32 = (a / WATER_NX % WATER_NX) as f32 / 6.0;
    ay: f32 = (a / (WATER_NX * WATER_NX)) as f32 / 6.0 - 0.6666667;
    bx: f32 = (b % WATER_NX) as f32 / 6.0;
    bz: f32 = (b / WATER_NX % WATER_NX) as f32 / 6.0;
    by: f32 = (b / (WATER_NX * WATER_NX)) as f32 / 6.0 - 0.6666667;
    at: int = w.count * 6;
    w.vertices[at] = w.fluid.x as f32 + ax + (bx - ax) * t;
    w.vertices[at + 1] = ay + (by - ay) * t;
    w.vertices[at + 2] = w.fluid.z as f32 + az + (bz - az) * t;
    for k in 0..3 w.vertices[at + 3 + k] = w.gradient[a * 3 + k] + (w.gradient[b * 3 + k] - w.gradient[a * 3 + k]) * t;
    w.count = w.count + 1;
}

water_tetra(
    w: *WaterSurface,
    a: int,
    b: int,
    c: int,
    d: int
) {
    ni: int = 0;
    no: int = 0;
    for k in 0..4 {
        at: int = a;
        if (k == 1) at = b;
        if (k == 2) at = c;
        if (k == 3) at = d;
        if (w.field[at] >= 0.55) {
            w.inside[ni] = at;
            ni = ni + 1;
        } else {
            w.outside[no] = at;
            no = no + 1;
        }
    }
    if (ni == 0 || ni == 4) return;
    if (w.count + 6 > WATER_VERTICES) {
        w.clipped = w.clipped + 1;
        return;
    }
    if (ni == 1) {
        for k in 0..3 water_vertex(w, w.inside[0], w.outside[k]);
    } else if (ni == 3) {
        for k in 0..3 water_vertex(w, w.outside[0], w.inside[k]);
    } else {
        water_vertex(w, w.inside[0], w.outside[0]);
        water_vertex(w, w.inside[0], w.outside[1]);
        water_vertex(w, w.inside[1], w.outside[1]);
        water_vertex(w, w.inside[0], w.outside[0]);
        water_vertex(w, w.inside[1], w.outside[1]);
        water_vertex(w, w.inside[1], w.outside[0]);
    }
}

water_build_mesh(w: *WaterSurface, alpha: f32) {
    w.count = 0;
    w.clipped = 0;
    water_density(w, alpha);
    // March only the occupied volume, not the entire mostly-empty camera window.
    x0: int = WATER_NX;
    y0: int = WATER_NY;
    z0: int = WATER_NX;
    x1: int = 0;
    y1: int = 0;
    z1: int = 0;
    f: *Fluid = w.fluid;
    for i in 0..f.n {
        p: *FluidParticle = &f.p[i];
        x: int = floor_i((p.ox + (p.x - p.ox) * alpha - f.x as f32) * 6.0);
        y: int = floor_i((p.oy + (p.y - p.oy) * alpha + 0.6666667) * 6.0);
        z: int = floor_i((p.oz + (p.z - p.oz) * alpha - f.z as f32) * 6.0);
        if (x - 2 < x0) x0 = x - 2;
        if (x + 3 > x1) x1 = x + 3;
        if (y - 2 < y0) y0 = y - 2;
        if (y + 3 > y1) y1 = y + 3;
        if (z - 2 < z0) z0 = z - 2;
        if (z + 3 > z1) z1 = z + 3;
    }
    if (x0 < 0) x0 = 0;
    if (y0 < 0) y0 = 0;
    if (z0 < 0) z0 = 0;
    if (x1 >= WATER_NX) x1 = WATER_NX - 1;
    if (y1 >= WATER_NY) y1 = WATER_NY - 1;
    if (z1 >= WATER_NX) z1 = WATER_NX - 1;
    for y in y0..y1 {
        for z in z0..z1 {
            for x in x0..x1 {
                at: int = water_node(x, y, z);
                w.cube[0] = at;
                w.cube[1] = at + 1;
                w.cube[2] = at + WATER_NX * WATER_NX;
                w.cube[3] = at + WATER_NX * WATER_NX + 1;
                w.cube[4] = at + WATER_NX;
                w.cube[5] = at + WATER_NX + 1;
                w.cube[6] = at + WATER_NX * WATER_NX + WATER_NX;
                w.cube[7] = at + WATER_NX * WATER_NX + WATER_NX + 1;
                inside: int = 0;
                for k in 0..8 {
                    if (w.field[w.cube[k]] >= 0.55) inside = inside + 1;
                }
                if (inside > 0 && inside < 8) {
                    water_tetra(w, w.cube[0], w.cube[1], w.cube[3], w.cube[7]);
                    water_tetra(w, w.cube[0], w.cube[3], w.cube[2], w.cube[7]);
                    water_tetra(w, w.cube[0], w.cube[2], w.cube[6], w.cube[7]);
                    water_tetra(w, w.cube[0], w.cube[6], w.cube[4], w.cube[7]);
                    water_tetra(w, w.cube[0], w.cube[4], w.cube[5], w.cube[7]);
                    water_tetra(w, w.cube[0], w.cube[5], w.cube[1], w.cube[7]);
                }
            }
        }
    }
}

prepare_water_surface(
    w: *WaterSurface,
    ground: []GroundCell,
    n: int,
    cx: int,
    cz: int,
    px: f32,
    pz: f32,
    player: bool,
    vp: []f32
) {
    now: int = mono_us();
    elapsed: f32 = 0.0;
    if (w.last_us != 0) elapsed = (now - w.last_us) as f32 * 0.000001;
    w.last_us = now;
    if (w.disabled) return;
    f: *Fluid = w.fluid;
    changed: bool = fluid_prepare(f, ground, n, cx, cz);
    if (changed) {
        glActiveTexture(33989);
        glBindTexture(3553, w.mask);
        glTexSubImage2D(3553, 0, 0, 0, FLUID_TILES, FLUID_TILES, 6409, 5121, f.tiles);
        glActiveTexture(33984);
        elapsed = 0.0;
    }
    glUniform2f(w.origin, f.x as f32, f.z as f32);
    visible: bool = false;
    for z in 0..FLUID_TILES {
        for x in 0..FLUID_TILES {
            if (f.tiles[z * FLUID_TILES + x] != 0i8 && grass_cell_in_view(vp, f.x + x,
                f.z + z) != 0) visible = true;
        }
    }
    if (!visible || f.n == 0) {
        w.count = 0;
        f.accumulator = 0.0;
        return;
    }
    if (player && w.player_ready && !changed) {
        dx: f32 = px - w.player_x;
        dz: f32 = pz - w.player_z;
        d2: f32 = dx * dx + dz * dz;
        if (d2 > 0.00001 && d2 < 0.25) fluid_impulse(f, px, pz, sqrtf(d2) * 1.5);
    }
    w.player_x = px;
    w.player_z = pz;
    w.player_ready = player;
    if ((changed && w.splash || w.splash_requested) && f.n > 0) {
        best: int = 0;
        distance: f32 = 1000000.0;
        for i in 0..f.n {
            p: *FluidParticle = &f.p[i];
            dx: f32 = p.x - px;
            dz: f32 = p.z - pz;
            if (dx * dx + dz * dz < distance) {
                distance = dx * dx + dz * dz;
                best = i;
            }
        }
        fluid_impulse(f, f.p[best].x, f.p[best].z, 2.4);
        w.splash_requested = false;
    }
    start: int = mono_us();
    fluid_advance(f, elapsed);
    f.sim_us = mono_us() - start;
    start = mono_us();
    water_build_mesh(w, f.accumulator / FLUID_DT);
    glBindBuffer(34962, w.mesh);
    glBufferSubData(34962, 0, w.count * 24, w.vertices);
    f.mesh_us = mono_us() - start;
    w.frames = w.frames + 1;
    w.sum_sim = w.sum_sim + f.sim_us;
    w.sum_mesh = w.sum_mesh + f.mesh_us;
    if (w.report && w.frames % 120 == 0) {
        i: int = put_str(w.label, 0, "water: particles=");
        i = put_int(w.label, i, f.n);
        i = put_str(w.label, i, " triangles=");
        i = put_int(w.label, i, w.count / 3);
        i = put_str(w.label, i, " avg sim/mesh/draw us=");
        i = put_int(w.label, i, w.sum_sim / 120);
        i = put_str(w.label, i, "/");
        i = put_int(w.label, i, w.sum_mesh / 120);
        i = put_str(w.label, i, "/");
        if (w.gpu_samples > 0) i = put_int(w.label, i, w.sum_gpu / w.gpu_samples);
        i = put_str(w.label, i, " dropped_us=");
        i = put_int(w.label, i, f.dropped_us);
        i = put_str(w.label, i, " neighbor/mesh overflow=");
        i = put_int(w.label, i, f.overflow);
        i = put_str(w.label, i, "/");
        i = put_int(w.label, i, w.clipped);
        i = put_str(w.label, i, "\n");
        write(2, w.label, i);
        w.sum_sim = 0;
        w.sum_mesh = 0;
        w.sum_gpu = 0;
        w.gpu_samples = 0;
    }
}

draw_water_surface(w: *WaterSurface) {
    if (w.count == 0 || w.disabled) return;
    slot: int = w.query_index;
    if (w.pending[slot] != 0) {
        glGetQueryObjectiv(w.query[slot], 34919, w.available);
        if (w.available[0] != 0i32) {
            glGetQueryObjectui64v(w.query[slot], 34918, w.result);
            w.sum_gpu = w.sum_gpu + w.result[0] / 1000;
            w.gpu_samples = w.gpu_samples + 1;
            w.pending[slot] = 0;
        }
    }
    timed: bool = w.pending[slot] == 0;
    if (timed) glBeginQuery(35007, w.query[slot]);
    glUniform1f(w.enabled, 1.0);
    bind_mesh(w.mesh);
    glDrawArrays(4, 0, w.count);
    glUniform1f(w.enabled, 0.0);
    if (timed) {
        glEndQuery(35007);
        w.pending[slot] = 1;
    }
    w.query_index = (slot + 1) % 4;
}
