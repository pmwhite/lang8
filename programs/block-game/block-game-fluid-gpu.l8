tag block_game;
use_tag gl;

extern glBindBufferBase(target: int,index: int,buffer: u32): int;
extern glDispatchCompute(x: int,y: int,z: int): int;
extern glMemoryBarrier(bits: int): int;
extern glGetIntegerv(name: int,value: *i32): int;

// std430: four vec4s per particle; all production state stays GPU-resident.
// Stages are separate dispatches (Jacobi), with explicit SSBO visibility barriers.
gpu_fluid_shader(): []i8 {
    """
#version 430
layout(local_size_x=128) in;
struct Particle { vec4 pos; vec4 old; vec4 vel; vec4 delta; };
layout(std430,binding=0) buffer Particles { Particle p[]; };
layout(std430,binding=1) buffer Neighbors {
  // Neighbor-major layout coalesces reads by adjacent particle invocations.
  int head[65536]; int nextId[27648]; int count[27648]; int neighbor[2654208];
};
layout(std430,binding=2) buffer Lambdas { float lambda[27648]; };
layout(std430,binding=3) buffer Ponds { uvec4 pond[256]; }; // awake, quiet steps, peak speed, overflow
layout(std430,binding=4) readonly buffer Commands { vec4 command[256]; }; // visible, impulse, x, z
layout(std430,binding=5) readonly buffer Tiles { float tile[1024]; }; // abs=pond ID+1; negative=all eight neighbors wet
uniform int stage;
uniform int number;
uniform int ponds;
uniform vec2 origin;
const float dt=1.0/60.0;
int hashCell(ivec3 c) { return int((uint(c.x)*73856093u+uint(c.y)*19349663u+uint(c.z)*83492791u)&65535u); }
bool wet(ivec2 c) {
  c-=ivec2(origin);
  return all(greaterThanEqual(c,ivec2(0))) && all(lessThan(c,ivec2(32))) && abs(tile[c.y*32+c.x])>0.5;
}
vec3 collide(vec3 v,vec3 old) {
  v.y=clamp(v.y,-0.437,1.65);
  ivec2 c=ivec2(floor(v.xz));
  ivec2 local=c-ivec2(origin);
  // Interior cells have no nearby bank boxes. The same floor/ceiling/rim still
  // apply, but nine bank projections per collision pass are unnecessary.
  if(all(greaterThanEqual(local,ivec2(0))) && all(lessThan(local,ivec2(32))) && tile[local.y*32+local.x]<-0.5) {
    v.xz=clamp(v.xz,origin+1.08,origin+30.92);
    return v;
  }
  for(int z=-1;z<=1;z++) for(int x=-1;x<=1;x++) {
    ivec2 cell=c+ivec2(x,z); vec2 lo=vec2(cell), hi=lo+1.0;
    if(v.y<0.05 && all(greaterThan(v.xz,lo-0.07)) && all(lessThan(v.xz,hi+0.07)) && !wet(cell)) {
      vec3 closest=vec3(clamp(v.x,lo.x,hi.x),min(v.y,-0.02),clamp(v.z,lo.y,hi.y));
      vec3 d=v-closest; float d2=dot(d,d);
      if(d2>0.0000001 && d2<0.0049) v+=d*(0.07*inversesqrt(d2)-1.0);
      else if(d2<=0.0000001) { v.xz=old.xz; if(!wet(ivec2(floor(v.xz)))) v.y=0.05; }
    }
  }
  v.xz=clamp(v.xz,origin+1.08,origin+30.92);
  return v;
}
void main() {
  uint i=gl_GlobalInvocationID.x;
  if(stage==11) { if(i<256u) pond[i]=uvec4(1u,0u,0u,0u); return; }
  if(stage==0) {
    if(i<65536u) head[i]=-1;
    if(i<uint(ponds)) {
      if(command[i].y>0.0) { pond[i].x=1u; pond[i].y=0u; }
      pond[i].z=0u;
    }
    return;
  }
  if(stage==10) {
    if(i<uint(ponds) && command[i].x>0.5 && pond[i].x!=0u) {
      if(uintBitsToFloat(pond[i].z)<0.0016) pond[i].y++; else pond[i].y=0u;
      if(pond[i].y>=120u) pond[i].x=0u;
    }
    return;
  }
  if(i>=uint(number)) return;
  uint id=uint(p[i].pos.w);
  if(command[id].x<0.5 || pond[id].x==0u) return;
  if(stage==1) {
    vec3 v=p[i].vel.xyz;
    vec2 d=p[i].pos.xz-command[id].zw;
    float q=max(0.0,1.0-dot(d,d)/0.64)*command[id].y;
    v+=vec3(d.x*q,q,d.y*q);
    v.y-=5.0*dt;
    p[i].old=p[i].pos;
    p[i].pos.xyz=collide(p[i].pos.xyz+v*dt,p[i].old.xyz);
    p[i].vel.xyz=v;
    int h=hashCell(ivec3(floor(p[i].pos.xyz*3.0)));
    nextId[i]=atomicExchange(head[h],int(i));
  } else if(stage==2) {
    ivec3 c=ivec3(floor(p[i].pos.xyz*3.0)); int n=0;
    for(int z=-1;z<=1;z++) for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) {
      int j=head[hashCell(c+ivec3(x,y,z))];
      while(j>=0) {
        vec3 d=p[i].pos.xyz-p[j].pos.xyz;
        if(uint(j)!=i && uint(p[j].pos.w)==id && dot(d,d)<0.11111112) {
          if(n<96) neighbor[uint(n++)*27648u+i]=j;
          else atomicAdd(pond[id].w,1u);
        }
        j=nextId[j];
      }
    }
    count[i]=n;
    p[i].delta.w=float(n); // rendering confidence: dense surface versus sparse spray
  } else if(stage==3) {
    float rho=1.0,denom=0.0; vec3 sum=vec3(0.0);
    for(int k=0;k<count[i];k++) {
      int j=neighbor[uint(k)*27648u+i]; vec3 d=p[i].pos.xyz-p[j].pos.xyz;
      float q=max(0.0,1.0-dot(d,d)*9.0);
      rho+=q*q*q; vec3 g=d*(-54.0*q*q/5.15); sum+=g; denom+=dot(g,g);
    }
    lambda[i]=-max(0.0,rho/5.15-1.0)/(denom+dot(sum,sum)+0.1);
  } else if(stage==4) {
    vec3 change=vec3(0.0);
    for(int k=0;k<count[i];k++) {
      int j=neighbor[uint(k)*27648u+i]; vec3 d=p[i].pos.xyz-p[j].pos.xyz;
      float q=max(0.0,1.0-dot(d,d)*9.0);
      change+=d*((lambda[i]+lambda[j])*(-54.0*q*q/5.15));
    }
    float l=length(change); if(l>0.04) change*=0.04/l;
    p[i].delta.xyz=change;
  } else if(stage==5) {
    p[i].pos.xyz=collide(p[i].pos.xyz+p[i].delta.xyz,p[i].old.xyz);
  } else if(stage==6) {
    vec3 v=(p[i].pos.xyz-p[i].old.xyz)/dt;
    float l=length(v); if(l>4.0) v*=4.0/l;
    p[i].vel.xyz=v;
  } else if(stage==7) {
    vec3 change=vec3(0.0);
    for(int k=0;k<count[i];k++) {
      int j=neighbor[uint(k)*27648u+i]; vec3 d=p[i].pos.xyz-p[j].pos.xyz;
      float q=max(0.0,1.0-dot(d,d)*9.0);
      change+=(p[j].vel.xyz-p[i].vel.xyz)*(0.012*q*q*q);
    }
    p[i].delta.xyz=change;
  } else if(stage==8) {
    vec3 v=(p[i].vel.xyz+p[i].delta.xyz)*0.999;
    p[i].vel.xyz=v;
    atomicMax(pond[id].z,floatBitsToUint(dot(v,v)));
  }
}
""";
}

type GpuFluid = {
    seed: *Fluid;
    buffers: []u32;
    packed: []f32;
    ids: []int; queue: []int; tiles: []f32; commands: []f32;
    bounds: []int; ponds: int;
    prog: int; u_stage: int; u_number: int; u_ponds: int; u_origin: int;
    supported: bool; steps: int; paused: int; debt: f32; dropped_us: int;
};

new_gpu_fluid(): *GpuFluid@new {
    version: []i32=new i32[2](0i32);
    glGetIntegerv(33307,version); glGetIntegerv(33308,&version[1]);
    supported: bool=version[0]>4i32 || version[0]==4i32 && version[1]>=3i32;
    if (supported) {
        glGetIntegerv(37078,version); // GL_MAX_VERTEX_SHADER_STORAGE_BLOCKS
        supported=version[0]>=3i32;
    }
    prog: int=0;
    if (supported) {
        shader: int=compile_shader(37305,gpu_fluid_shader());
        prog=glCreateProgram(); glAttachShader(prog,shader); glLinkProgram(prog);
        ok: []i32=new i32[1](0i32); glGetProgramiv(prog,35714,ok);
        if (ok[0]==0i32) { die("fluid compute link failed"); }
    }
    buffers: []u32=new u32[6](0u32); glGenBuffers(6,buffers);
    packed: []f32=new f32[FLUID_CAP*16](0.0);
    if (supported) {
        // All buffers are allocated once; only tiny commands change every frame.
        region {
            scratch: []f32=new f32[FLUID_HASH+FLUID_CAP*98](0.0);
            for i in 0..6 {
                size: int=len(scratch);
                if (i==0) { size=FLUID_CAP*16; }
                if (i==2) { size=FLUID_CAP; }
                if (i>=3) { size=1024; }
                glBindBuffer(37074,buffers[i]); glBufferData(37074,size*4,scratch,35048);
            }
        }
    }
    seed: *Fluid=new_fluid_seed();
    stage: int=-1; number: int=-1; ponds: int=-1; origin: int=-1;
    if (supported) {
        stage=glGetUniformLocation(prog,"stage"); number=glGetUniformLocation(prog,"number");
        ponds=glGetUniformLocation(prog,"ponds"); origin=glGetUniformLocation(prog,"origin");
    }
    new GpuFluid { seed:seed,buffers:buffers,packed:packed,
        ids:new int[FLUID_TILES*FLUID_TILES](-1),queue:new int[FLUID_TILES*FLUID_TILES](0),tiles:new f32[FLUID_TILES*FLUID_TILES](0.0),
        commands:new f32[FLUID_TILE_CAP*4](0.0),bounds:new int[FLUID_TILE_CAP*4](0),ponds:0,prog:prog,
        u_stage:stage,u_number:number,u_ponds:ponds,u_origin:origin,
        supported:supported,steps:0,paused:0,debt:0.0,dropped_us:0 };
}

gpu_fluid_bind(g: *GpuFluid) {
    for i in 0..6 { glBindBufferBase(37074,i,g.buffers[i]); }
}

// Flood-fill connected components once on topology changes. Sleeping and visibility
// belong to ponds, never to individual particles on opposite sides of one wave.
gpu_fluid_seed(g: *GpuFluid) {
    f: *Fluid=g.seed; g.ponds=0; g.steps=0; g.debt=0.0;
    for i in 0..len(g.commands) { g.commands[i]=0.0; }
    for i in 0..len(g.tiles) { g.ids[i]=-1; g.tiles[i]=0.0; }
    for cell in 0..len(g.tiles) {
        if (f.tiles[cell]!=0i8 && g.ids[cell]<0) {
            id: int=g.ponds; g.ponds=id+1;
            first: int=0; count: int=1; g.queue[0]=cell; g.ids[cell]=id;
            g.bounds[id*4]=FLUID_TILES-1; g.bounds[id*4+1]=FLUID_TILES-1; g.bounds[id*4+2]=0; g.bounds[id*4+3]=0;
            while (first<count) {
                c: int=g.queue[first]; first=first+1; x: int=c%FLUID_TILES; z: int=c/FLUID_TILES;
                if (x<g.bounds[id*4]) { g.bounds[id*4]=x; }
                if (z<g.bounds[id*4+1]) { g.bounds[id*4+1]=z; }
                if (x+1>g.bounds[id*4+2]) { g.bounds[id*4+2]=x+1; }
                if (z+1>g.bounds[id*4+3]) { g.bounds[id*4+3]=z+1; }
                for dir in 0..4 {
                    xx: int=x; zz: int=z;
                    if (dir==0) { xx=x-1; } if (dir==1) { xx=x+1; }
                    if (dir==2) { zz=z-1; } if (dir==3) { zz=z+1; }
                    if (xx>=0 && zz>=0 && xx<FLUID_TILES && zz<FLUID_TILES) {
                        k: int=zz*FLUID_TILES+xx;
                        if (f.tiles[k]!=0i8 && g.ids[k]<0) { g.ids[k]=id; g.queue[count]=k; count=count+1; }
                    }
                }
            }
        }
    }
    for i in 0..len(g.tiles) { g.tiles[i]=(g.ids[i]+1) as f32; }
    for z in 1..FLUID_TILES-1 { for x in 1..FLUID_TILES-1 {
        at: int=z*FLUID_TILES+x; interior: bool=g.ids[at]>=0;
        for dz in -1..2 { for dx in -1..2 {
            if(g.ids[(z+dz)*FLUID_TILES+x+dx]<0) { interior=false; }
        } }
        if(interior) { g.tiles[at]=0.0-g.tiles[at]; }
    } }
    for i in 0..f.n {
        p: *FluidParticle=&f.p[i]; at: int=i*16;
        for k in 0..16 { g.packed[at+k]=0.0; }
        g.packed[at]=p.x; g.packed[at+1]=p.y; g.packed[at+2]=p.z;
        id: int=g.ids[(floor_i(p.z)-f.z)*FLUID_TILES+floor_i(p.x)-f.x];
        g.packed[at+3]=id as f32;
        for k in 0..4 { g.packed[at+4+k]=g.packed[at+k]; }
    }
    if (g.supported) {
        glBindBuffer(37074,g.buffers[0]); glBufferSubData(37074,0,f.n*64,g.packed);
        glBindBuffer(37074,g.buffers[5]); glBufferSubData(37074,0,len(g.tiles)*4,g.tiles);
        gpu_fluid_bind(g); glUseProgram(g.prog); gpu_fluid_pass(g,11,(FLUID_TILE_CAP+127)/128);
    }
}

gpu_fluid_pass(g: *GpuFluid,stage: int,groups: int) {
    glUniform1i(g.u_stage,stage); glDispatchCompute(groups,1,1); glMemoryBarrier(8192);
}

gpu_fluid_step(g: *GpuFluid) {
    if (!g.supported || g.seed.n==0) { return; }
    gpu_fluid_bind(g); glUseProgram(g.prog);
    glUniform1i(g.u_number,g.seed.n); glUniform1i(g.u_ponds,g.ponds);
    glUniform2f(g.u_origin,g.seed.x as f32,g.seed.z as f32);
    groups: int=(g.seed.n+127)/128;
    gpu_fluid_pass(g,0,512); gpu_fluid_pass(g,1,groups); gpu_fluid_pass(g,2,groups);
    for iteration in 0..2 { gpu_fluid_pass(g,3,groups); gpu_fluid_pass(g,4,groups); gpu_fluid_pass(g,5,groups); }
    gpu_fluid_pass(g,6,groups); gpu_fluid_pass(g,7,groups); gpu_fluid_pass(g,8,groups);
    gpu_fluid_pass(g,10,(g.ponds+127)/128); g.steps=g.steps+1;
}

gpu_fluid_commands(g: *GpuFluid) {
    glBindBuffer(37074,g.buffers[4]); glBufferSubData(37074,0,len(g.commands)*4,g.commands);
}
