tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

// The world's solved names, after applying them to its rooms.
progress_show(label: str, world: *WorldState, nroom: int) raises IoError {
    apply_solved(world.names, nroom, world.dones, world.ndone, world.solved, nroom);
    write(1, label);
    write(1, ":");
    for r in 0..nroom {
        if (r < len(world.solved) && r < len(world.names) && world.solved[r] != 0) {
            write(1, " ");
            write_bytes(1, world.names[r])
        }
    }
    write(1, "\n")
}

test "progress is saved beside the world and loaded with it" {
    path: []i8 = ".build/progress-world.txt";
    fd: int = open_path(path, LEVEL_O_WRONLY + LEVEL_O_CREAT + LEVEL_O_TRUNC, LEVEL_MODE);
    text: []i8 = """
world
level first 0 0 4 4 First
level second 6 0 10 4 Second
level third 12 0 16 4 Third
done first
g 2 2
g 8 2
g 14 2
""";
    write_some(fd, text, 0, len(text));
    close(fd);
    // A progress file from an earlier game would be stale; start without one.
    world: *WorldState = new_world_state();
    state: *LevelState = new_level_state();
    write_int(1, load_world_state(path, world, state));
    write(1, "\n");
    none: []int = new int[3](0);
    print_int(save_progress(path, world.names, none, 3));
    load_progress(path, world);
    progress_show("loaded", world, state.nrooms);
    // Solving the third level saves it alongside the first.
    world.solved[2] = 1;
    print_int(save_progress(path, world.names, world.solved, state.nrooms));
    again: *WorldState = new_world_state();
    again_state: *LevelState = new_level_state();
    write_int(1, load_world_state(path, again, again_state));
    write(1, "\n");
    load_progress(path, again);
    progress_show("reloaded", again, state.nrooms);
    expect {|
        0
        0
        loaded: first
        0
        0
        reloaded: first third
    |}
}
