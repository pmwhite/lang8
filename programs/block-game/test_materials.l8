tag block_game;
use_tag gl, x11, freetype;
import "../gl/gl.l8";
import "../freetype/ft.l8";
import "level.l8";
import "block-game-undo.l8";
import "block-game-play.l8";
import "block-game-editor.l8";
import "block-game-render.l8";
import "block-game-ui.l8";

extern glGetError(): int;
extern glGetTexImage(target: int, level: int, format: int, typ: int, pixels: *i8): int;
check(ok: bool, message: []i8) { if (!ok) { die(message); } }

main(): int {
    a: []i8 = new i8[CONTACT_SIZE*CONTACT_SIZE](0i8);
    b: []i8 = new i8[CONTACT_SIZE*CONTACT_SIZE](0i8);
    heap: int = l8_heap_used();
    contact_stamp(a,-64,-64,-2.5,3.5,0.38,0.85);
    contact_stamp(b,-63,-64,-2.5,3.5,0.38,0.85);
    for z in 0..CONTACT_SIZE {
        for x in 4..CONTACT_SIZE {
            check(a[z*CONTACT_SIZE+x] == b[z*CONTACT_SIZE+x-4], "contacts are world anchored across cache movement");
        }
    }
    memcpy(b,0,a,0,len(a));
    contact_stamp(a,-64,-64,-2.5,3.5,0.38,0.85);
    contact_stamp(a,-64,-64,5000.0,5000.0,0.38,1.0);
    for i in 0..len(a) { check(a[i]==b[i], "overlap and offscreen contacts must not darken or wrap"); }
    check(l8_heap_used()==heap,"contact rasterizer allocates");
    vp: []f32 = new f32[16](0.0);
    rp: []f32 = new f32[16](0.0);
    vp[0]=1.0; vp[5]=1.0; vp[10]=1.0; vp[15]=1.0;
    water_reflection_matrix(rp,vp);
    check(rp[5]==-1.0 && rp[13]<-0.0399 && rp[13]>-0.0401,"reflection plane matrix");
    y: f32 = rp[5]*(-0.02)+rp[13];
    check(y>-0.0201 && y<-0.0199,"water surface remains fixed by reflection");
    ground: []GroundCell = [GroundCell { column: 0, row: 0, style: GROUND_WATER, stone: 0 }];
    check(water_in_view(ground,1,vp),"visible pond enables reflection");
    ground[0].column=100;
    check(!water_in_view(ground,1,vp),"offscreen pond skips reflection");
    ground[0].column=0; ground[0].style=GROUND_GRASS;
    check(!water_in_view(ground,1,vp),"dry view skips reflection");

    d0: ?*i8 = XOpenDisplay(null);
    check(d0!=null,"material GPU tests need DISPLAY");
    if (d0==null) { return 1; }
    d: *i8 = d0;
    attr: []i32 = [4i32,0i32];
    v0: ?*XVisualInfo = glXChooseVisual(d,XDefaultScreen(d),attr);
    if (v0==null) { return 2; }
    v: *XVisualInfo = v0;
    w: int = XCreateSimpleWindow(d,XRootWindow(d,XDefaultScreen(d)),0,0,16,16,0,0,0);
    c0: ?*i8 = glXCreateContext(d,v,null,1);
    if (c0==null) { return 3; }
    c: *i8 = c0;
    check(glXMakeCurrent(d,w,c)!=0,"material GPU context");
    prog: int = link_program("#version 120\nattribute vec3 pos; void main(){gl_Position=vec4(pos,1.0);}",
        "#version 120\nvoid main(){gl_FragColor=vec4(1.0);}","nrm");
    cache: *MaterialLight = new_material_light(prog,prog);
    light: *LampLight = new_lamp_light(prog,prog,prog);
    light.x=-64; light.z=-64;
    bricks: []Brick = [Brick { column: 0, row: 0 }];
    lamps: []Lamp = [Lamp { column: 8, row: 8, style: 0 }];
    hist: []Block = new Block[2](Block { id: 0, column: 2, row: 2, shape: 0, layer: 0, ramp: 0, mounted: 0 });
    hist[1].column=4;
    bt: []f32 = [0.5];
    ids: []int = new int[ID_CAP](-1); ids[0]=0;
    visible: []int = [0];
    lagx: []f32 = new f32[1024](0.0);
    lagz: []f32 = new f32[1024](0.0);
    heap=l8_heap_used();
    update_material_light(cache,light,bricks,1,lamps,1,hist,0,1,1,0.5,bt,ids,visible,1,
        3.0,0.55,4.0,1,0.0,13.0,13.0,0.0,0.0);
    check(cache.stamps[0]==224 && cache.count==2,"contact follows interpolated blocks and player");
    glActiveTexture(33987);
    glGetTexImage(3553,0,6409,5121,a);
    for i in 0..len(a) { check(a[i]==cache.pixels[i],"GPU contacts match CPU field"); }
    // An unchanged frame must not clear/rebuild the field.
    cache.pixels[0]=47i8;
    update_material_light(cache,light,bricks,1,lamps,1,hist,0,1,1,0.5,bt,ids,visible,1,
        3.0,0.55,4.0,1,0.1,13.0,13.0,0.1,0.0);
    check(cache.pixels[0]==47i8,"camera movement rebuilt unchanged contacts");
    // Removing all casters must clear stale shadows, including the player.
    update_material_light(cache,light,bricks,0,lamps,0,hist,0,1,1,0.5,bt,ids,visible,0,
        3.0,0.55,4.0,0,0.0,13.0,13.0,0.0,0.0);
    for i in 0..len(a) { check(cache.pixels[i]==0i8,"removed objects leave no contact shadow"); }
    check(l8_heap_used()==heap,"material updates allocate after startup");
    check(reflection_changed(cache,vp,hist,0,1,1,bt,lagx,lagz,3.0,0.55,4.0,1,0.0,0.0),"first reflection draws");
    check(!reflection_changed(cache,vp,hist,0,1,1,bt,lagx,lagz,3.0,0.55,4.0,1,0.0,0.0),"static reflection is cached");
    vp[12]=0.01;
    check(reflection_changed(cache,vp,hist,0,1,1,bt,lagx,lagz,3.0,0.55,4.0,1,0.0,0.0),"subcell camera motion refreshes reflection");
    bt[0]=0.6;
    check(reflection_changed(cache,vp,hist,0,1,1,bt,lagx,lagz,3.0,0.55,4.0,1,0.0,0.0),"animation refreshes reflection");
    lagx[0]=0.08;
    check(reflection_changed(cache,vp,hist,0,1,1,bt,lagx,lagz,3.0,0.55,4.0,1,0.0,0.0),"block sway refreshes reflection");
    hist[1].layer=3;
    check(reflection_changed(cache,vp,hist,0,1,1,bt,lagx,lagz,3.0,0.55,4.0,1,0.0,0.0),"elevated stack changes refresh reflection");
    check(l8_heap_used()==heap,"reflection cache allocates after startup");
    check(glGetError()==0,"material setup/update GL error");
    glXMakeCurrent(d,0,null);
    glXDestroyContext(d,c);
    XDestroyWindow(d,w);
    XCloseDisplay(d);
    write(1,"material tests passed\n",len("material tests passed\n"));
    0;
}
