tag block_game;
use_tag gl, x11, freetype;
import "../gl/gl.l8";
import "../freetype/ft.l8";
import "level.l8";
import "block-game-undo.l8";
import "block-game-play.l8";
import "block-game-editor.l8";
import "block-game-render.l8";
import "block-game-ui.l8";

check(ok: bool, message: []i8) { if (!ok) { die(message); } }

main(): int {
    s: *LevelState = new_level_state();
    loaded: *LevelState = new_level_state();
    world: *WorldState = new_world_state();
    out: []int = new int[7](0);
    cell: []int = new int[7](0);
    xy: []int = new int[2](0);
    mask: []i8 = new i8[MASK_SIZE * MASK_SIZE](0i8);
    s.nrooms = set_room_size(s.rooms, s.titles, 0, 12, 9);
    world.names[0] = "pond";
    s.nground = paint_ground_cell(s.ground, 0, 2, 3, GROUND_GRASS, 0);
    s.nground = paint_ground_cell(s.ground, s.nground, 2, 3, GROUND_STONE, 0);
    apply_level_brush_rect(s, 2, 3, 2, 3, BRUSH_WATER, 0, 0, 1, out, cell);
    check(s.nground == 1 && s.ground[0].stone == 0 && is_water(s.ground, s.nground, 2, 3), "water replaces grass and stone");
    check(save_world_state(".build/water-roundtrip-world.txt", world, s) == 0, "save world water");
    check(load_world_state(".build/water-roundtrip-world.txt", world, loaded) >= 0, "load world water");
    check(is_water(loaded.ground, loaded.nground, 2, 3), "world water preserved");
    check(save_level_state(".build/water-roundtrip-level.txt", s) == 0, "save level water");
    check(load_level_state(".build/water-roundtrip-level.txt", loaded) >= 0, "load level water");
    check(is_water(loaded.ground, loaded.nground, 2, 3), "level water preserved");
    preview_room_transform(s, loaded, 0, 10, 20, 1, xy);
    check(is_water(loaded.ground, loaded.nground, 13, 29) && is_water(s.ground, s.nground, 2, 3), "rotate water without changing source");
    apply_level_brush_rect(s, 2, 3, 2, 3, BRUSH_STONE, 0, 0, 1, out, cell);
    check(!is_water(s.ground, s.nground, 2, 3) && s.ground[0].stone == 1, "stone replaces water");
    apply_level_brush_rect(s, 2, 3, 2, 3, BRUSH_WATER, 0, 1, 1, out, cell);
    check(s.ground[0].stone == 1, "water eraser preserves other terrain");
    apply_level_brush_rect(s, 3, 3, 1, 1, BRUSH_WATER, 0, 0, 1, out, cell);
    check(s.nground == 9, "reversed water rectangle");
    apply_level_brush_rect(s, 1, 1, 3, 3, BRUSH_WATER, 0, 1, 1, out, cell);
    check(s.nground == 0, "erase water rectangle");
    s.nground = paint_ground_cell(s.ground, 0, -2, -3, GROUND_WATER, 0);
    fill_ground_mask(mask, s.ground, s.nground, -10, -10);
    check(mask[7 * MASK_SIZE + 8] == 32i8 && mask[0] == 0i8, "water mask at negative coordinates");
    check(brush_slot_on(16, BRUSH_WATER, 0) && !brush_slot_on(16, BRUSH_LAMP, 0), "water palette selection");

    home: []int = new int[LEVEL_MAX_BLOCKS](0);
    ids: []int = new int[LEVEL_MAX_BLOCKS](0);
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    snap: []int = new int[LEVEL_MAX_BLOCKS * REWIND_MAX](0);
    counts: []int = new int[LEVEL_MAX_ROOMS](1);
    cursors: []int = new int[LEVEL_MAX_ROOMS](0);
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    s.nground = paint_ground_cell(s.ground, 0, 1, 0, GROUND_WATER, 0);
    for layer in 0..3 {
        p: int = move_player(s.blocks, 0, home, 1, s.bricks, 0, s.ground, s.nground,
            0, 0, layer, 1, 0, ids, widths, snap, counts, cursors, ghost);
        check(pos_col(p) == 0 && pos_layer(p) == layer, "water blocks player at all heights");
    }
    // Only the remote, elevated member of a linked shape would enter water.
    s.blocks[0] = Block { id: 0, column: 1, row: 0, shape: 3, layer: 0, ramp: 0, mounted: 0 };
    s.blocks[1] = Block { id: 1, column: 1, row: 1, shape: 3, layer: 1, ramp: 0, mounted: 0 };
    s.blocks[2] = Block { id: 2, column: 1, row: 0, shape: 0, layer: 1, ramp: 0, mounted: 0 };
    s.nblocks = 3;
    s.nground = paint_ground_cell(s.ground, 0, 2, 1, GROUND_WATER, 0);
    assign_block_homes(s.blocks, 3, s.rooms, 1, home, ids, widths);
    p2: int = move_player(s.blocks, 3, home, 1, s.bricks, 0, s.ground, s.nground,
        0, 0, 0, 1, 0, ids, widths, snap, counts, cursors, ghost);
    check(pos_col(p2) == 0 && s.blocks[0].column == 1 && s.blocks[1].column == 1 && s.blocks[2].column == 1, "blocked linked/stacked push is atomic");
    s.nground = paint_ground_cell(s.ground, 0, 0, 0, GROUND_WATER, 0);
    prepare_room_starts("", s.rooms, 1, s.bricks, 0, s.ground, s.nground, s.goals, 0, s.room_starts);
    check(!is_water(s.ground, s.nground, s.room_starts[0].column, s.room_starts[0].row), "automatic reset avoids water");
    // Generate a small visual fixture without touching the user's world.
    s.nblocks = 0;
    s.nground = 0;
    s.spawn = Cell { column: 3, row: 4 };
    apply_level_brush_rect(s, 0, 0, 11, 8, BRUSH_GRASS, 0, 0, 1, out, cell);
    apply_level_brush_rect(s, 5, 2, 8, 6, BRUSH_WATER, 0, 0, 1, out, cell);
    apply_level_brush_rect(s, 6, 1, 7, 7, BRUSH_WATER, 0, 0, 1, out, cell);
    s.nlamps = set_lamp(s.lamps, 0, 4, 3, 0, true);
    s.nlamps = set_lamp(s.lamps, s.nlamps, 9, 6, 1, true);
    s.nlamps = set_lamp(s.lamps, s.nlamps, 7, 0, 1, true);
    s.nblocks = add_block_at(s.blocks, 0, 6, 0, 0, 0, 0);
    s.nblocks = add_block_at(s.blocks, s.nblocks, 6, 0, 1, 0, 0);
    apply_level_brush_rect(s, 2, 2, 3, 6, BRUSH_STONE, 0, 0, 1, out, cell);
    check(save_level_state(".build/water-demo.txt", s) == 0, "save visual fixture");
    write(1, "water tests passed\n", len("water tests passed\n"));
    0;
}
