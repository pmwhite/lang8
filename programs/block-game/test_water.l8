tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

type WaterMoves = {
    home: []int;
    ids: *RoomBlockIds;
    widths: []int;
    snap: []int;
    counts: []RewindCount;
    cursors: []RewindCursor;
    ghost: []int
}

// A level with one 12-by-9 room and no terrain.
water_new_level(): *LevelState@new {
    s: *LevelState = new_level_state();
    level_set_room_count(s, set_room_size(s.rooms, s.titles, 0, 12, 9));
    s
}

water_new_moves(): *WaterMoves@new {
    new WaterMoves {
        home: new int[LEVEL_MAX_BLOCKS](0),
        ids: new_room_block_ids(),
        widths: new int[LEVEL_MAX_ROOMS](0),
        snap: new int[LEVEL_MAX_BLOCKS * REWIND_MAX](0),
        counts: new RewindCount[LEVEL_MAX_ROOMS](RewindCount { value: 1 }),
        cursors: new RewindCursor[LEVEL_MAX_ROOMS](RewindCursor { value: 0 }),
        ghost: new int[LEVEL_MAX_ROOMS](0)
    }
}

water_assign_homes(s: *LevelState, m: *WaterMoves) {
    n: int = s.nblocks;
    if (n < 0 || n > LEVEL_MAX_BLOCKS || n > len(s.blocks)) return;
    assign_block_homes(s.blocks, n, s.rooms, 1, m.home, m.ids, m.widths)
}

// Move the player at (pc, pr, ph) by (dc, dr) among the first n blocks and
// nbricks bricks of s, in a single room.
water_move(
    s: *LevelState,
    m: *WaterMoves,
    n: int,
    nbricks: int,
    pc: int,
    pr: int,
    ph: int,
    dc: int,
    dr: int
): int {
    move_player(s.blocks, n, m.home, 1, s.bricks, nbricks, s.ground, s.nground, pc,
        pr, ph, dc, dr, m.ids, m.snap, m.counts, m.cursors, m.ghost)
}

// Apply a brush and show the resulting number of ground cells. Also reports
// when the counts returned by the brush disagree with the level state.
water_brush(
    label: str,
    s: *LevelState,
    c0: int,
    r0: int,
    c1: int,
    r1: int,
    brush: Brush,
    erase: bool
) raises IoError {
    result: BrushEdit = apply_level_brush_rect(s, c0, r0, c1, r1, brush, 0, erase,
        true);
    write(1, label);
    write(1, ": ground cells ");
    write_int(1, s.nground);
    if (result.nground != s.nground) {
        write(1, " (brush reported ");
        write_int(1, result.nground);
        write(1, ")")
    }
    if (result.nblocks != s.nblocks) {
        write(1, " (brush reported blocks ");
        write_int(1, result.nblocks);
        write(1, ", level has ");
        write_int(1, s.nblocks);
        write(1, ")")
    }
    write(1, "\n")
}

water_show_bool(label: str, value: bool) raises IoError {
    write(1, label);
    write(1, ": ");
    print_bool(value)
}

water_show_int(label: str, value: int) raises IoError {
    write(1, label);
    write(1, ": ");
    print_int(value)
}

water_show_pose(label: str, p: int) raises IoError {
    write(1, label);
    write(1, ": col ");
    write_int(1, pos_col(p));
    write(1, " row ");
    write_int(1, pos_row(p));
    write(1, " layer ");
    write_int(1, pos_layer(p));
    if (pos_mounted(p) != 0) write(1, " mounted");
    write(1, "\n")
}

water_show_block(label: str, b: Block) raises IoError {
    write(1, label);
    write(1, ": col ");
    write_int(1, b.column);
    write(1, " row ");
    write_int(1, b.row);
    write(1, " layer ");
    write_int(1, b.layer);
    write(1, "\n")
}

water_show_cell(s: *LevelState) raises IoError {
    write(1, "(2,3): water ");
    if (is_water(s.ground, s.nground, 2, 3)) write(1, "yes") else write(1, "no");
    write(1, ", stone ");
    if (s.nground > 0) write_int(1, s.ground[0].stone) else write(1, "-");
    write(1, "\n")
}

test "water brush replaces grass and stone" {
    s: *LevelState = water_new_level();
    level_set_ground_count(s, paint_ground_cell(s.ground, 0, 2, 3, GROUND_GRASS, false));
    level_set_ground_count(s, paint_ground_cell(s.ground, s.nground, 2, 3, GROUND_STONE,
        false));
    water_brush("water over grass and stone", s, 2, 3, 2, 3, Brush.Water, false);
    water_show_cell(s);
    expect {|
        water over grass and stone: ground cells 1
        (2,3): water yes, stone 0
    |}
    water_brush("stone over water", s, 2, 3, 2, 3, Brush.Stone, false);
    water_show_cell(s);
    expect {|
        stone over water: ground cells 1
        (2,3): water no, stone 1
    |}
    water_brush("water eraser", s, 2, 3, 2, 3, Brush.Water, true);
    water_show_cell(s);
    expect {|
        water eraser: ground cells 1
        (2,3): water no, stone 1
    |}
}

test "water rectangles paint from any corner and erase" {
    s: *LevelState = water_new_level();
    water_brush("stone", s, 2, 3, 2, 3, Brush.Stone, false);
    expect {|
        stone: ground cells 1
    |}
    water_brush("water from (3,3) to (1,1)", s, 3, 3, 1, 1, Brush.Water, false);
    expect {|
        water from (3,3) to (1,1): ground cells 9
    |}
    water_brush("erase water from (1,1) to (3,3)", s, 1, 1, 3, 3, Brush.Water, true);
    expect {|
        erase water from (1,1) to (3,3): ground cells 0
    |}
}

test "water survives saving, loading and room rotation" {
    s: *LevelState = water_new_level();
    loaded: *LevelState = new_level_state();
    world: *WorldState = new_world_state();
    xy: []int = new int[2](0);
    world.names[0] = "pond";
    water_brush("water", s, 2, 3, 2, 3, Brush.Water, false);
    expect {|
        water: ground cells 1
    |}
    water_show_int("save world", save_world_state(".build/water-roundtrip-world.txt",
        world, s));
    water_show_int("load world (blocks)", load_world_state(".build/water-roundtrip-world.txt",
        world, loaded));
    water_show_bool("world keeps water at (2,3)", is_water(loaded.ground, loaded.nground,
        2, 3));
    expect {|
        save world: 0
        load world (blocks): 0
        world keeps water at (2,3): true
    |}
    water_show_int("save level", save_level_state(".build/water-roundtrip-level.txt",
        s));
    water_show_int("load level (blocks)", load_level_state(".build/water-roundtrip-level.txt",
        loaded));
    water_show_bool("level keeps water at (2,3)", is_water(loaded.ground, loaded.nground,
        2, 3));
    expect {|
        save level: 0
        load level (blocks): 0
        level keeps water at (2,3): true
    |}
    // Move room 0 by (10, 20) and rotate it once into the preview.
    preview_room_transform(s, loaded, 0, 10, 20, 1, xy);
    water_show_bool("preview has water at (13,29)", is_water(loaded.ground, loaded.nground,
        13, 29));
    water_show_bool("source keeps water at (2,3)", is_water(s.ground, s.nground, 2,
        3));
    expect {|
        preview has water at (13,29): true
        source keeps water at (2,3): true
    |}
}

test "water mask at negative coordinates" {
    s: *LevelState = water_new_level();
    mask: []i8 = new i8[MASK_SIZE * MASK_SIZE](0i8);
    level_set_ground_count(s, paint_ground_cell(s.ground, 0, -2, -3, GROUND_WATER,
        false));
    // The mask origin is (-10, -10), so (-2, -3) is mask cell (8, 7).
    fill_ground_mask(mask, s.ground, s.nground, -10, -10);
    water_show_int("mask at water cell", mask[7 * MASK_SIZE + 8] as int);
    water_show_int("mask at origin", mask[0] as int);
    expect {|
        mask at water cell: 32
        mask at origin: 0
    |}
}

test "water palette slot" {
    water_show_bool("slot 16 on for water", brush_slot_on(16, Brush.Water, 0));
    water_show_bool("slot 16 on for lamp", brush_slot_on(16, Brush.Lamp, 0));
    expect {|
        slot 16 on for water: true
        slot 16 on for lamp: false
    |}
}

test "player wades in ponds" {
    s: *LevelState = water_new_level();
    m: *WaterMoves = water_new_moves();
    s.bricks[0] = Brick { column: 1, row: 0 };
    // Walk from layer 1 onto a brick wall, with no water anywhere.
    water_show_pose("onto brick wall", water_move(s, m, 0, 1, 0, 0, 1, 1, 0));
    expect {|
        onto brick wall: col 1 row 0 layer 1
    |}
    // Without the brick, (1, 0) is a pond. Whatever layer the player walks
    // in from, it falls to the bottom and cannot climb back out.
    level_set_ground_count(s, paint_ground_cell(s.ground, 0, 1, 0, GROUND_WATER, false));
    for layer in 0..3 {
        water_show_pose("into pond", water_move(s, m, 0, 0, 0, 0, layer, 1, 0));
        water_show_pose("back to bank", water_move(s, m, 0, 0, 1, 0, -1, -1, 0));
        expect {|
            into pond: col 1 row 0 layer -1
            back to bank: col 1 row 0 layer -1
        |}
    }
}

test "pushing a linked shape over water" {
    s: *LevelState = water_new_level();
    m: *WaterMoves = water_new_moves();
    // Only the remote, elevated member of a linked shape would enter water.
    s.blocks[0] = Block {
        id: 0,
        column: 1,
        row: 0,
        shape: 3,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    s.blocks[1] = Block {
        id: 1,
        column: 1,
        row: 1,
        shape: 3,
        layer: 1,
        ramp: 0,
        mounted: 0
    };
    s.blocks[2] = Block {
        id: 2,
        column: 1,
        row: 0,
        shape: 0,
        layer: 1,
        ramp: 0,
        mounted: 0
    };
    if (len(s.blocks) < 3) exit(1);
    s.nblocks = 3;
    level_set_ground_count(s, paint_ground_cell(s.ground, 0, 2, 1, GROUND_WATER, false));
    water_assign_homes(s, m);
    water_show_pose("player pushes", water_move(s, m, 3, 0, 0, 0, 0, 1, 0));
    if (len(s.blocks) < 3) exit(1);
    water_show_block("linked member on land", s.blocks[0]);
    water_show_block("linked member over water", s.blocks[1]);
    water_show_block("stacked block", s.blocks[2]);
    expect {|
        player pushes: col 1 row 0 layer 0
        linked member on land: col 2 row 0 layer 0
        linked member over water: col 2 row 1 layer -1
        stacked block: col 2 row 0 layer 1
    |}
    // The sunken member is a stepping stone at ground level.
    water_show_pose("step onto sunken block", water_move(s, m, 3, 0, 1, 1, 0, 1, 0));
    expect {|
        step onto sunken block: col 2 row 1 layer 0
    |}
}

test "submerged blocks and ramps" {
    s: *LevelState = water_new_level();
    m: *WaterMoves = water_new_moves();
    level_set_block_count(s, 1);
    s.blocks[0] = Block {
        id: 0,
        column: 1,
        row: 0,
        shape: 0,
        layer: -1,
        ramp: 1,
        mounted: 0
    };
    level_set_ground_count(s, paint_ground_cell(s.ground, 0, 1, 0, GROUND_WATER, false));
    water_assign_homes(s, m);
    water_show_pose("climb out on submerged ramp", water_move(s, m, 1, 0, 1, 0, -1,
        1, 0));
    expect {|
        climb out on submerged ramp: col 2 row 0 layer 0
    |}
    level_set_block_count(s, 1);
    s.blocks[0].ramp = 0;
    water_show_pose("walk onto submerged block", water_move(s, m, 1, 0, 0, 0, 0, 1,
        0));
    water_show_block("submerged block", s.blocks[0]);
    expect {|
        walk onto submerged block: col 1 row 0 layer 0
        submerged block: col 1 row 0 layer -1
    |}
}

test "a ramp rides the block it rests on into the pond" {
    s: *LevelState = water_new_level();
    m: *WaterMoves = water_new_moves();
    // A block at (2, 0) carrying a ramp that rises toward +column, and a pond
    // at (4, 0) beside a wall at (5, 0).
    level_set_block_count(s, add_block_at(s.blocks, 0, 2, 0, 0, 0, 0));
    level_set_block_count(s, add_block_at(s.blocks, s.nblocks, 2, 0, 1, 0, 1));
    level_set_ground_count(s, paint_ground_cell(s.ground, 0, 4, 0, GROUND_WATER, false));
    s.bricks[0] = Brick { column: 5, row: 0 };
    water_assign_homes(s, m);
    // Pushing the block uphill with respect to the ramp carries the ramp.
    p: int = water_move(s, m, 2, 1, 1, 0, 0, 1, 0);
    water_show_block("block", s.blocks[0]);
    water_show_block("ramp", s.blocks[1]);
    expect {|
        block: col 3 row 0 layer 0
        ramp: col 3 row 0 layer 1
    |}
    // In the pond the block sinks, and the ramp settles on it at ground level,
    // where the player can climb it onto the wall.
    p = water_move(s, m, 2, 1, pos_col(p), pos_row(p), pos_layer(p), 1, 0);
    water_show_block("block", s.blocks[0]);
    water_show_block("ramp", s.blocks[1]);
    p = water_move(s, m, 2, 1, pos_col(p), pos_row(p), pos_layer(p), 1, 0);
    water_show_pose("on the ramp", p);
    water_show_pose("onto the wall", water_move(s, m, 2, 1, pos_col(p), pos_row(p),
        pos_layer(p), 1, 0));
    expect {|
        block: col 4 row 0 layer -1
        ramp: col 4 row 0 layer 0
        on the ramp: col 4 row 0 layer 0 mounted
        onto the wall: col 5 row 0 layer 1
    |}
}

// Where the water basin goes with the focus at (cx, cz), given its corner
// (x, z), shown as that corner.
water_show_basin(
    label: str,
    s: *LevelState,
    vp: []f32,
    cx: int,
    cz: int,
    x: int,
    z: int,
    ready: bool,
    place: []int
) raises IoError {
    all_box: []int = new int[4](0);
    near_box: []int = new int[4](0);
    height_water_place(s.ground, s.nground, cx, cz, vp, x, z, ready, all_box, near_box,
        place);
    write(1, label);
    write(1, ": ");
    write_int(1, place[0]);
    write(1, ",");
    print_int(place[1])
}

test "the water basin stays put while the focus moves" {
    s: *LevelState = water_new_level();
    // A pond at columns 0 to 14 and another 30 columns east, both in view:
    // together too wide for the 32-cell basin.
    for c in 0..15 {
        for r in 0..5 level_set_ground_count(s, paint_ground_cell(s.ground, s.nground,
            c, r, GROUND_WATER, false))
    }
    for c in 44..48 level_set_ground_count(s, paint_ground_cell(s.ground, s.nground,
        c, 2, GROUND_WATER, false));
    // An overhead view of columns -10 to 60 and rows -10 to 20.
    vp: []f32 = new f32[16](0.0);
    vp[0] = 1.0 / 35.0;
    vp[12] = 0.0 - 25.0 / 35.0;
    vp[9] = 1.0 / 15.0;
    vp[13] = 0.0 - 5.0 / 15.0;
    vp[15] = 1.0;
    place: []int = new int[4](0);
    water_show_basin("first", s, vp, 7, 2, 0, 0, false, place);
    x: int = place[0];
    z: int = place[1];
    // Walking along the pond, its cells stay the nearest water but the basin
    // must not follow: moving it would flatten the waves.
    for cx in 3..13 {
        water_show_basin("step", s, vp, cx, 2, x, z, true, place);
        x = place[0];
        z = place[1]
    }
    // Close to the other pond, the basin moves to cover it.
    water_show_basin("east", s, vp, 40, 2, x, z, true, place);
    expect {|
        first: -9,-14
        step: -9,-14
        step: -9,-14
        step: -9,-14
        step: -9,-14
        step: -9,-14
        step: -9,-14
        step: -9,-14
        step: -9,-14
        step: -9,-14
        step: -9,-14
        east: 30,-14
    |}
}

// Push a ramp rising toward -row east into one rising toward +column, with
// the pushed ramp first in the list or second, and show where both end up.
water_ramp_onto_ramp(label: str, pushed_first: bool) raises IoError {
    s: *LevelState = water_new_level();
    m: *WaterMoves = water_new_moves();
    if (pushed_first) {
        level_set_block_count(s, add_block_at(s.blocks, 0, 2, 1, 0, 0, 4));
        level_set_block_count(s, add_block_at(s.blocks, s.nblocks, 3, 1, 0, 0, 1))
    } else {
        level_set_block_count(s, add_block_at(s.blocks, 0, 3, 1, 0, 0, 1));
        level_set_block_count(s, add_block_at(s.blocks, s.nblocks, 2, 1, 0, 0, 4))
    }
    water_assign_homes(s, m);
    water_move(s, m, 2, 0, 1, 1, 0, 1, 0);
    first: Block = s.blocks[0];
    second: Block = s.blocks[1];
    pushed: Block = if (pushed_first) first else second;
    other: Block = if (pushed_first) second else first;
    write(1, label);
    write(1, ":\n");
    water_show_block("  pushed ramp", pushed);
    water_show_block("  other ramp", other);
    write(1, "  pushed ramp sits on the other: ");
    if (pushed.mounted != 0 && other.mounted == 0) write(1, "yes\n") else write(1,
        "no\n")
}

test "a ramp pushed into another's low side sits on it" {
    water_ramp_onto_ramp("pushed ramp listed first", true);
    water_ramp_onto_ramp("pushed ramp listed second", false);
    expect {|
        pushed ramp listed first:
          pushed ramp: col 3 row 1 layer 0
          other ramp: col 3 row 1 layer 0
          pushed ramp sits on the other: yes
        pushed ramp listed second:
          pushed ramp: col 3 row 1 layer 0
          other ramp: col 3 row 1 layer 0
          pushed ramp sits on the other: yes
    |}
}

test "submerged layers survive saving and loading" {
    s: *LevelState = water_new_level();
    loaded: *LevelState = new_level_state();
    world: *WorldState = new_world_state();
    world.names[0] = "pond";
    level_set_block_count(s, 1);
    s.blocks[0] = Block {
        id: 0,
        column: 1,
        row: 0,
        shape: 0,
        layer: -1,
        ramp: 0,
        mounted: 0
    };
    level_set_ground_count(s, paint_ground_cell(s.ground, 0, 1, 0, GROUND_WATER, false));
    water_show_int("save level", save_level_state(".build/water-sunk-test.txt", s));
    water_show_int("load level (blocks)", load_level_state(".build/water-sunk-test.txt",
        loaded));
    water_show_block("loaded block", loaded.blocks[0]);
    expect {|
        save level: 0
        load level (blocks): 1
        loaded block: col 1 row 0 layer -1
    |}
    water_show_int("save world", save_world_state(".build/water-sunk-world.txt", world,
        s));
    water_show_int("load world (blocks)", load_world_state(".build/water-sunk-world.txt",
        world, loaded));
    water_show_block("loaded block", loaded.blocks[0]);
    expect {|
        save world: 0
        load world (blocks): 1
        loaded block: col 1 row 0 layer -1
    |}
}

test "automatic room start avoids water" {
    s: *LevelState = water_new_level();
    level_set_ground_count(s, paint_ground_cell(s.ground, 0, 0, 0, GROUND_WATER, false));
    prepare_room_starts("", s.rooms, 1, s.bricks, 0, s.ground, s.nground, s.goals,
        0, s.room_starts);
    start: RoomStart = s.room_starts[0];
    write(1, "room start: (");
    write_int(1, start.column);
    write(1, ",");
    write_int(1, start.row);
    write(1, ")\n");
    water_show_bool("start is water", is_water(s.ground, s.nground, start.column,
        start.row));
    expect {|
        room start: (11,0)
        start is water: false
    |}
}

// Generate small visual and benchmark fixtures without touching the user's world.
test "water demo fixtures" {
    s: *LevelState = water_new_level();
    s.spawn = Cell { column: 3, row: 4 };
    water_brush("grass field", s, 0, 0, 11, 8, Brush.Grass, false);
    water_brush("pond", s, 5, 2, 8, 6, Brush.Water, false);
    water_brush("pond inlet", s, 6, 1, 7, 7, Brush.Water, false);
    level_set_lamp_count(s, set_lamp(s.lamps, 0, 4, 3, 0, true));
    level_set_lamp_count(s, set_lamp(s.lamps, s.nlamps, 9, 6, 1, true));
    level_set_lamp_count(s, set_lamp(s.lamps, s.nlamps, 7, 0, 1, true));
    level_set_block_count(s, add_block_at(s.blocks, 0, 6, 0, 0, 0, 0));
    level_set_block_count(s, add_block_at(s.blocks, s.nblocks, 6, 0, 1, 0, 0));
    water_brush("stone path", s, 2, 2, 3, 6, Brush.Stone, false);
    water_show_int("save water-demo", save_level_state(".build/water-demo.txt", s));
    expect {|
        grass field: ground cells 108
        pond: ground cells 108
        pond inlet: ground cells 108
        stone path: ground cells 108
        save water-demo: 0
    |}
    water_brush("fill pond", s, 5, 1, 8, 7, Brush.Grass, false);
    water_brush("small pond", s, 6, 3, 7, 4, Brush.Water, false);
    water_show_int("save water-small-demo", save_level_state(".build/water-small-demo.txt",
        s));
    expect {|
        fill pond: ground cells 108
        small pond: ground cells 108
        save water-small-demo: 0
    |}
    s.spawn = Cell { column: 0, row: 4 };
    s.nblocks = 0;
    s.nlamps = 0;
    water_brush("8x8 pond", s, 3, 0, 10, 7, Brush.Water, false);
    water_show_int("save water-capacity-demo", save_level_state(".build/water-capacity-demo.txt",
        s));
    expect {|
        8x8 pond: ground cells 108
        save water-capacity-demo: 0
    |}
    s.nground = 0;
    water_brush("16x8 pond", s, 3, 0, 18, 7, Brush.Water, false);
    water_show_int("save water-128-demo", save_level_state(".build/water-128-demo.txt",
        s));
    expect {|
        16x8 pond: ground cells 128
        save water-128-demo: 0
    |}
    water_brush("16x16 pond", s, 3, 8, 18, 15, Brush.Water, false);
    water_show_int("save water-256-demo", save_level_state(".build/water-256-demo.txt",
        s));
    expect {|
        16x16 pond: ground cells 256
        save water-256-demo: 0
    |}
}

// An 8-by-8 pond at columns 3 to 10 with a block on the bank at (2, 3) and a
// ramp painted into the pond at (3, 5).
water_interaction_level() raises IoError: *LevelState@new {
    s: *LevelState = water_new_level();
    s.spawn = Cell { column: 1, row: 3 };
    water_brush("pond", s, 3, 0, 10, 7, Brush.Water, false);
    level_set_block_count(s, add_block_at(s.blocks, 0, 2, 3, 0, 0, 0));
    level_set_block_count(s, add_block_at(s.blocks, s.nblocks, 3, 5, 0, 0, 2));
    apply_level_gravity(s);
    s
}

// Move the player at p by (dc, dr) and show where it ends up.
water_step(
    s: *LevelState,
    m: *WaterMoves,
    p: int,
    dc: int,
    dr: int
) raises IoError: int {
    next: int = water_move(s, m, s.nblocks, 0, pos_col(p), pos_row(p), pos_layer(p),
        dc, dr);
    water_show_pose("player", next);
    next
}

test "painted ramp settles onto the pond bottom" {
    s: *LevelState = water_interaction_level();
    expect {|
        pond: ground cells 64
    |}
    water_show_block("block", s.blocks[0]);
    water_show_block("ramp", s.blocks[1]);
    water_show_int("save water-interaction-demo", save_level_state(".build/water-interaction-demo.txt",
        s));
    expect {|
        block: col 2 row 3 layer 0
        ramp: col 3 row 5 layer -1
        save water-interaction-demo: 0
    |}
}

test "crossing the pond with a stepping stone and a ramp" {
    s: *LevelState = water_interaction_level();
    expect {|
        pond: ground cells 64
    |}
    m: *WaterMoves = water_new_moves();
    water_assign_homes(s, m);
    p: int = pack_pos(1, 3, 0, 0);
    // Pushing the block into the pond drops it to the bottom.
    p = water_step(s, m, p, 1, 0);
    water_show_block("pushed block", s.blocks[0]);
    expect {|
        player: col 2 row 3 layer 0
        pushed block: col 3 row 3 layer -1
    |}
    // Cross on the sunken block, then step off it to wade.
    p = water_step(s, m, p, 1, 0);
    expect {|
        player: col 3 row 3 layer 0
    |}
    p = water_step(s, m, p, 1, 0);
    expect {|
        player: col 4 row 3 layer -1
    |}
    // Walk along the bottom.
    p = water_step(s, m, p, 0, 1);
    expect {|
        player: col 4 row 4 layer -1
    |}
    p = water_step(s, m, p, 0, 1);
    expect {|
        player: col 4 row 5 layer -1
    |}
    // Mount the submerged ramp and leave the pond on it.
    p = water_step(s, m, p, -1, 0);
    expect {|
        player: col 3 row 5 layer -1 mounted
    |}
    p = water_step(s, m, p, -1, 0);
    expect {|
        player: col 2 row 5 layer 0
    |}
}

test "filling and repainting a pond moves its contents" {
    s: *LevelState = water_interaction_level();
    expect {|
        pond: ground cells 64
    |}
    m: *WaterMoves = water_new_moves();
    water_assign_homes(s, m);
    water_move(s, m, s.nblocks, 0, 1, 3, 0, 1, 0);
    water_show_block("pushed block", s.blocks[0]);
    expect {|
        pushed block: col 3 row 3 layer -1
    |}
    water_brush("fill under block", s, 3, 3, 3, 3, Brush.Grass, false);
    water_show_block("block", s.blocks[0]);
    expect {|
        fill under block: ground cells 64
        block: col 3 row 3 layer 0
    |}
    water_brush("repaint water", s, 3, 3, 3, 3, Brush.Water, false);
    water_show_block("block", s.blocks[0]);
    expect {|
        repaint water: ground cells 64
        block: col 3 row 3 layer -1
    |}
}
