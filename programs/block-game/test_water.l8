tag block_game;

use_tag gl, x11, freetype;

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

check(ok: bool, message: []i8) {
    if (!ok) die(message);
}

main(): int {
    brush_result: BrushEdit;
    s: *LevelState = new_level_state();
    loaded: *LevelState = new_level_state();
    world: *WorldState = new_world_state();
    xy: []int = new int[2](0);
    mask: []i8 = new i8[MASK_SIZE * MASK_SIZE](0i8);
    s.nrooms = set_room_size(s.rooms, s.titles, 0, 12, 9);
    world.names[0] = "pond";
    s.nground = paint_ground_cell(s.ground, 0, 2, 3, GROUND_GRASS, false);
    s.nground = paint_ground_cell(s.ground, s.nground, 2, 3, GROUND_STONE, false);
    brush_result = apply_level_brush_rect(s, 2, 3, 2, 3, Brush.Water, 0, false, true);
    check(s.nground == 1 && s.ground[0].stone == 0 && is_water(s.ground, s.nground,
        2, 3), "water replaces grass and stone");
    check(save_world_state(".build/water-roundtrip-world.txt", world, s) == 0, "save world water");
    check(load_world_state(".build/water-roundtrip-world.txt", world, loaded) >= 0,
        "load world water");
    check(is_water(loaded.ground, loaded.nground, 2, 3), "world water preserved");
    check(save_level_state(".build/water-roundtrip-level.txt", s) == 0, "save level water");
    check(load_level_state(".build/water-roundtrip-level.txt", loaded) >= 0, "load level water");
    check(is_water(loaded.ground, loaded.nground, 2, 3), "level water preserved");
    preview_room_transform(s, loaded, 0, 10, 20, 1, xy);
    check(is_water(loaded.ground, loaded.nground, 13, 29) && is_water(s.ground, s.nground,
        2, 3), "rotate water without changing source");
    brush_result = apply_level_brush_rect(s, 2, 3, 2, 3, Brush.Stone, 0, false, true);
    check(!is_water(s.ground, s.nground, 2, 3) && s.ground[0].stone == 1, "stone replaces water");
    brush_result = apply_level_brush_rect(s, 2, 3, 2, 3, Brush.Water, 0, true, true);
    check(s.ground[0].stone == 1, "water eraser preserves other terrain");
    brush_result = apply_level_brush_rect(s, 3, 3, 1, 1, Brush.Water, 0, false, true);
    check(s.nground == 9, "reversed water rectangle");
    brush_result = apply_level_brush_rect(s, 1, 1, 3, 3, Brush.Water, 0, true, true);
    check(s.nground == 0, "erase water rectangle");
    s.nground = paint_ground_cell(s.ground, 0, -2, -3, GROUND_WATER, false);
    fill_ground_mask(mask, s.ground, s.nground, -10, -10);
    check(mask[7 * MASK_SIZE + 8] == 32i8 && mask[0] == 0i8, "water mask at negative coordinates");
    check(brush_slot_on(16, Brush.Water, 0) && !brush_slot_on(16, Brush.Lamp, 0),
        "water palette selection");
    home: []int = new int[LEVEL_MAX_BLOCKS](0);
    ids: []int = new int[LEVEL_MAX_BLOCKS](0);
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    snap: []int = new int[LEVEL_MAX_BLOCKS * REWIND_MAX](0);
    counts: []int = new int[LEVEL_MAX_ROOMS](1);
    cursors: []int = new int[LEVEL_MAX_ROOMS](0);
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    s.bricks[0] = Brick { column: 1, row: 0 };
    wall_pose: int = move_player(s.blocks, 0, home, 1, s.bricks, 1, s.ground, 0, 0,
        0, 1, 1, 0, ids, widths, snap, counts, cursors, ghost);
    check(pos_col(wall_pose) == 1 && pos_layer(wall_pose) == 1, "water settlement preserves support atop brick walls");
    s.nground = paint_ground_cell(s.ground, 0, 1, 0, GROUND_WATER, false);
    for layer in 0..3 {
        p: int = move_player(s.blocks, 0, home, 1, s.bricks, 0, s.ground, s.nground,
            0, 0, layer, 1, 0, ids, widths, snap, counts, cursors, ghost);
        check(pos_col(p) == 1 && pos_layer(p) == 0 - 1, "player falls to pond bottom");
        back: int = move_player(s.blocks, 0, home, 1, s.bricks, 0, s.ground, s.nground,
            1, 0, 0 - 1, 0 - 1, 0, ids, widths, snap, counts, cursors, ghost);
        check(pos_col(back) == 1 && pos_layer(back) == 0 - 1, "wading player cannot climb the bank unaided");
    }
    // Only the remote, elevated member of a linked shape would enter water.
    s.blocks[0] = Block {
        id: 0,
        column: 1,
        row: 0,
        shape: 3,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    s.blocks[1] = Block {
        id: 1,
        column: 1,
        row: 1,
        shape: 3,
        layer: 1,
        ramp: 0,
        mounted: 0
    };
    s.blocks[2] = Block {
        id: 2,
        column: 1,
        row: 0,
        shape: 0,
        layer: 1,
        ramp: 0,
        mounted: 0
    };
    s.nblocks = 3;
    s.nground = paint_ground_cell(s.ground, 0, 2, 1, GROUND_WATER, false);
    assign_block_homes(s.blocks, 3, s.rooms, 1, home, ids, widths);
    p2: int = move_player(s.blocks, 3, home, 1, s.bricks, 0, s.ground, s.nground,
        0, 0, 0, 1, 0, ids, widths, snap, counts, cursors, ghost);
    check(pos_col(p2) == 1 && s.blocks[0].column == 2 && s.blocks[1].column == 2 && s.blocks[2].column == 2,
        "linked and stacked pieces can be pushed over water");
    check(s.blocks[1].layer == 0 - 1 && s.blocks[0].layer == 0 && s.blocks[2].layer == 1,
        "only unsupported water members fall to the bottom");
    p2 = move_player(s.blocks, 3, home, 1, s.bricks, 0, s.ground, s.nground, 1, 1,
        0, 1, 0, ids, widths, snap, counts, cursors, ghost);
    check(pos_col(p2) == 2 && pos_layer(p2) == 0, "sunken block is a ground-level stepping stone");
    s.nblocks = 1;
    s.blocks[0] = Block {
        id: 0,
        column: 1,
        row: 0,
        shape: 0,
        layer: 0 - 1,
        ramp: 1,
        mounted: 0
    };
    s.nground = paint_ground_cell(s.ground, 0, 1, 0, GROUND_WATER, false);
    p2 = move_player(s.blocks, 1, home, 1, s.bricks, 0, s.ground, s.nground, 1, 0,
        0 - 1, 1, 0, ids, widths, snap, counts, cursors, ghost);
    check(pos_col(p2) == 2 && pos_layer(p2) == 0, "submerged ramp lets player climb out");
    s.nblocks = 1;
    s.blocks[0].ramp = 0;
    p2 = move_player(s.blocks, 1, home, 1, s.bricks, 0, s.ground, s.nground, 0, 0,
        0, 1, 0, ids, widths, snap, counts, cursors, ghost);
    check(pos_col(p2) == 1 && pos_layer(p2) == 0, "player walks on submerged block without pushing it");
    check(save_level_state(".build/water-sunk-test.txt", s) == 0, "save submerged layer");
    check(load_level_state(".build/water-sunk-test.txt", loaded) >= 0, "load submerged layer");
    check(loaded.blocks[0].layer == 0 - 1, "submerged layer survives level save/load");
    check(save_world_state(".build/water-sunk-world.txt", world, s) == 0, "save submerged world");
    check(load_world_state(".build/water-sunk-world.txt", world, loaded) >= 0, "load submerged world");
    check(loaded.blocks[0].layer == 0 - 1, "submerged layer survives world save/load");
    s.nground = paint_ground_cell(s.ground, 0, 0, 0, GROUND_WATER, false);
    prepare_room_starts("", s.rooms, 1, s.bricks, 0, s.ground, s.nground, s.goals,
        0, s.room_starts);
    check(!is_water(s.ground, s.nground, s.room_starts[0].column, s.room_starts[0].row),
        "automatic reset avoids water");
    // Generate a small visual fixture without touching the user's world.
    s.nblocks = 0;
    s.nground = 0;
    s.spawn = Cell { column: 3, row: 4 };
    brush_result = apply_level_brush_rect(s, 0, 0, 11, 8, Brush.Grass, 0, false, true);
    brush_result = apply_level_brush_rect(s, 5, 2, 8, 6, Brush.Water, 0, false, true);
    brush_result = apply_level_brush_rect(s, 6, 1, 7, 7, Brush.Water, 0, false, true);
    s.nlamps = set_lamp(s.lamps, 0, 4, 3, 0, true);
    s.nlamps = set_lamp(s.lamps, s.nlamps, 9, 6, 1, true);
    s.nlamps = set_lamp(s.lamps, s.nlamps, 7, 0, 1, true);
    s.nblocks = add_block_at(s.blocks, 0, 6, 0, 0, 0, 0);
    s.nblocks = add_block_at(s.blocks, s.nblocks, 6, 0, 1, 0, 0);
    brush_result = apply_level_brush_rect(s, 2, 2, 3, 6, Brush.Stone, 0, false, true);
    check(save_level_state(".build/water-demo.txt", s) == 0, "save visual fixture");
    brush_result = apply_level_brush_rect(s, 5, 1, 8, 7, Brush.Grass, 0, false, true);
    brush_result = apply_level_brush_rect(s, 6, 3, 7, 4, Brush.Water, 0, false, true);
    check(save_level_state(".build/water-small-demo.txt", s) == 0, "save small fluid benchmark fixture");
    s.spawn = Cell { column: 0, row: 4 };
    s.nblocks = 0;
    s.nlamps = 0;
    brush_result = apply_level_brush_rect(s, 3, 0, 10, 7, Brush.Water, 0, false, true);
    check(save_level_state(".build/water-capacity-demo.txt", s) == 0, "save full-capacity fluid benchmark fixture");
    s.nground = 0;
    brush_result = apply_level_brush_rect(s, 3, 0, 18, 7, Brush.Water, 0, false, true);
    check(save_level_state(".build/water-128-demo.txt", s) == 0, "save 128-cell fluid benchmark fixture");
    brush_result = apply_level_brush_rect(s, 3, 8, 18, 15, Brush.Water, 0, false,
        true);
    check(save_level_state(".build/water-256-demo.txt", s) == 0, "save 256-cell fluid benchmark fixture");
    s.nground = 0;
    s.nblocks = 0;
    s.nlamps = 0;
    s.spawn = Cell { column: 1, row: 3 };
    brush_result = apply_level_brush_rect(s, 3, 0, 10, 7, Brush.Water, 0, false, true);
    s.nblocks = add_block_at(s.blocks, 0, 2, 3, 0, 0, 0);
    s.nblocks = add_block_at(s.blocks, s.nblocks, 3, 5, 0, 0, 2);
    apply_level_gravity(s);
    check(s.blocks[1].layer == 0 - 1, "painted ramp settles onto pond bottom");
    check(save_level_state(".build/water-interaction-demo.txt", s) == 0, "save block/player/ramp interaction fixture");
    assign_block_homes(s.blocks, s.nblocks, s.rooms, 1, home, ids, widths);
    p2 = pack_pos(1, 3, 0, 0);
    for step in 0..7 {
        dc: int = 1;
        dr: int = 0;
        if (step == 3 || step == 4) {
            dc = 0;
            dr = 1;
        }
        if (step >= 5) dc = 0 - 1;
        p2 = move_player(s.blocks, s.nblocks, home, 1, s.bricks, 0, s.ground, s.nground,
            pos_col(p2), pos_row(p2), pos_layer(p2), dc, dr, ids, widths, snap, counts,
            cursors, ghost);
        if (step == 0) check(s.blocks[0].column == 3 && s.blocks[0].layer == 0 - 1,
            "push drops block to bottom");
        if (step == 1) check(pos_col(p2) == 3 && pos_layer(p2) == 0, "cross stepping stone");
        if (step == 2) check(pos_col(p2) == 4 && pos_layer(p2) == 0 - 1, "step off stone to wade");
        if (step == 4) check(pos_col(p2) == 4 && pos_row(p2) == 5 && pos_layer(p2) == 0 - 1,
            "normal movement along bottom");
        if (step == 5) check(pos_col(p2) == 3 && pos_layer(p2) == 0 - 1 && pos_mounted(p2) == 1,
            "mount submerged ramp");
        if (step == 6) check(pos_col(p2) == 2 && pos_row(p2) == 5 && pos_layer(p2) == 0,
            "exit pond using ramp");
    }
    // Filling the basin must lift its contents; repainting water settles them again.
    brush_result = apply_level_brush_rect(s, 3, 3, 3, 3, Brush.Grass, 0, false, true);
    check(s.blocks[0].layer == 0, "filling pond raises submerged block onto land");
    brush_result = apply_level_brush_rect(s, 3, 3, 3, 3, Brush.Water, 0, false, true);
    check(brush_result.nblocks == s.nblocks, "brush result matches level state");
    check(s.blocks[0].layer == 0 - 1, "painting water settles existing block");
    write(1, "water tests passed\n", len("water tests passed\n"));
    0;
}
