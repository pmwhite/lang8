tag block_game;
use_tag gl, x11, freetype;

// Title, help, editor controls, and performance HUD rendering.

draw_title_layer(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    x: f32,
    y: f32,
    s: []i8,
    alpha: f32,
    cr: f32,
    cg: f32,
    cb: f32
) {
    if (font.ok == 0 || len(s) == 0 || alpha <= 0.0) {
        return;
    }
    n: int = emit_text(font, verts, 0, x, y, s);
    if (n < 4) {
        return;
    }
    glUseProgram(prog);
    glBindTexture(3553, tex);
    glUniform2f(u_screen, 1200.0, 720.0);
    glUniform3f(u_color, cr, cg, cb);
    glUniform1f(u_alpha, alpha);
    glBindBuffer(34962, vbo);
    glBufferData(34962, n * 4, verts, 35040);
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(1);
    glVertexAttribPointer(0, 2, 5126, 0, 16, 0);
    glVertexAttribPointer(1, 2, 5126, 0, 16, 8);
    glDrawArrays(4, 0, n / 4);
}

draw_title(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    x: f32,
    y: f32,
    s: []i8,
    alpha: f32
) {
    if (alpha > 1.0) {
        alpha = 1.0;
    }
    if (alpha > 0.0) {
        a: f32 = alpha * 0.72;
        draw_title_layer(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts,
            x + 1.5, y + 2.0, s, a * 0.45, 0.08, 0.06, 0.05);
        draw_title_layer(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts,
            x, y, s, a, 0.78, 0.70, 0.58);
    }
}

draw_help(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    y: f32,
    s: []i8
) {
    draw_title_layer(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts, 21.0,
        y + 1.5, s, 0.55, 0.04, 0.03, 0.02);
    draw_title_layer(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts, 20.0,
        y, s, 0.98, 0.92, 0.84, 0.86);
}

measure_text(font: Font, s: []i8): f32 {
    if (font.ok == 0) {
        return 0.0;
    }
    w: f32 = 0.0;
    k: int = 0;
    while (k < len(s)) {
        code: int = s[k] as int;
        if (code >= FT_FIRST && code <= FT_LAST) {
            w = w + font.glyphs[code - FT_FIRST].adv;
        }
        k = k + 1;
    }
    w;
}

draw_dusk_panel(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    n: int = put_quad(verts, 0, 0.0, 0.0, 1200.0, 720.0);
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.06, 0.05, 0.04,
        0.42);
    n = put_quad(verts, 0, x0, y0, x1, y1);
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.16, 0.13, 0.11,
        0.94);
    n = put_quad(verts, 0, x0, y0, x1, y0 + 2.0);
    n = put_quad(verts, n, x0, y1 - 2.0, x1, y1);
    n = put_quad(verts, n, x0, y0, x0 + 2.0, y1);
    n = put_quad(verts, n, x1 - 2.0, y0, x1, y1);
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.72, 0.60, 0.44,
        0.78);
}

draw_help_heading(
    font: Font,
    tprog: int,
    u_tscreen: int,
    u_tcolor: int,
    u_talpha: int,
    tex: u32,
    tvbo: u32,
    tverts: []f32,
    x: f32,
    y: f32,
    s: []i8
): f32 {
    draw_title_layer(font, tprog, u_tscreen, u_tcolor, u_talpha, tex, tvbo, tverts,
        x, y, s, 0.96, 0.86, 0.74, 0.56);
    y + 26.0;
}

draw_help_row(
    font: Font,
    tprog: int,
    u_tscreen: int,
    u_tcolor: int,
    u_talpha: int,
    tex: u32,
    tvbo: u32,
    tverts: []f32,
    gprog: int,
    u_gscreen: int,
    u_gcolor: int,
    u_galpha: int,
    gvbo: u32,
    gverts: []f32,
    x: f32,
    y: f32,
    key: []i8,
    action: []i8
): f32 {
    kw: f32 = measure_text(font, key) + 14.0;
    if (kw < 34.0) {
        kw = 34.0;
    }
    n: int = put_quad(gverts, 0, x, y - 13.0, x + kw, y + 5.0);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.24, 0.19,
        0.15, 0.92);
    draw_title_layer(font, tprog, u_tscreen, u_tcolor, u_talpha, tex, tvbo, tverts,
        x + 7.0, y, key, 0.96, 0.94, 0.84, 0.62);
    draw_title_layer(font, tprog, u_tscreen, u_tcolor, u_talpha, tex, tvbo, tverts,
        x + 148.0, y, action, 0.94, 0.80, 0.74, 0.66);
    y + 22.0;
}

draw_editor_help_panel(
    title_font: Font,
    hud: Font,
    tprog: int,
    u_tscreen: int,
    u_tcolor: int,
    u_talpha: int,
    ftex: u32,
    htex: u32,
    tvbo: u32,
    tverts: []f32,
    gprog: int,
    u_gscreen: int,
    u_gcolor: int,
    u_galpha: int,
    gvbo: u32,
    gverts: []f32
) {
    draw_dusk_panel(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 78.0, 58.0,
        1122.0, 662.0);
    draw_title_layer(title_font, tprog, u_tscreen, u_tcolor, u_talpha, ftex, tvbo,
        tverts, 104.0, 104.0, "Editor keys", 0.96, 0.90, 0.80, 0.64);
    draw_title_layer(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        980.0, 98.0, "hold ?", 0.80, 0.62, 0.54, 0.46);
    y: f32 = 148.0;
    y = draw_help_heading(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        110.0, y, "Camera");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, ",  .", "orbit 90");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "-  =", "zoom");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "arrows", "move cursor");
    y = y + 12.0;
    y = draw_help_heading(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        110.0, y, "Brush");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "1", "dirt");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "2", "grass");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "f", "flagstone");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "b", "block");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "3-7", "block shape");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "r", "ramp (again to turn)");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "w", "brick");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "c", "goal");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "p", "world start");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "e", "level start");
    y = y + 12.0;
    y = draw_help_heading(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        110.0, y, "Paint");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "space", "paint");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "shift+space",
        "paint rectangle");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "backspace",
        "erase brush");
    draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, gprog,
        u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 110.0, y, "esc", "cancel rectangle");
    y = 148.0;
    y = draw_help_heading(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        620.0, y, "Levels");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "n", "new boundary");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "del", "remove boundary");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "m", "move contents");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "shift+m", "edit bounds");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "[  ]", "width");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, ";  '", "height");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "o", "rotate while moving");
    y = y + 12.0;
    y = draw_help_heading(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        620.0, y, "File");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "s", "save");
    y = draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "q", "quit");
    draw_help_row(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, gprog,
        u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "?", "this list");
}

brush_slot_kind(slot: int): Brush {
    if (slot == 1) {
        return BRUSH_GRASS;
    }
    if (slot == 2) {
        return BRUSH_STONE;
    }
    if (slot >= 3 && slot <= 8) {
        return BRUSH_BLOCK;
    }
    if (slot == 9) {
        return BRUSH_RAMP;
    }
    if (slot == 10) {
        return BRUSH_BRICK;
    }
    if (slot == 11) {
        return BRUSH_GOAL;
    }
    if (slot == 12) {
        return BRUSH_START;
    }
    if (slot == 13) {
        return BRUSH_ROOM_START;
    }
    BRUSH_DIRT;
}

brush_slot_shape(slot: int): int {
    if (slot == 4) {
        return 3;
    }
    if (slot == 5) {
        return 4;
    }
    if (slot == 6) {
        return 5;
    }
    if (slot == 7) {
        return 6;
    }
    if (slot == 8) {
        return 15;
    }
    0;
}

brush_slot_key(slot: int): []i8 {
    if (slot == 1) {
        return "2";
    }
    if (slot == 2) {
        return "f";
    }
    if (slot == 3) {
        return "b";
    }
    if (slot == 4) {
        return "3";
    }
    if (slot == 5) {
        return "4";
    }
    if (slot == 6) {
        return "5";
    }
    if (slot == 7) {
        return "6";
    }
    if (slot == 8) {
        return "7";
    }
    if (slot == 9) {
        return "r";
    }
    if (slot == 10) {
        return "w";
    }
    if (slot == 11) {
        return "c";
    }
    if (slot == 12) {
        return "p";
    }
    if (slot == 13) {
        return "e";
    }
    "1";
}

brush_slot_on(slot: int, brush: Brush, shape: int): bool {
    kind: Brush = brush_slot_kind(slot);
    if (brush != kind) {
        return false;
    }
    match kind {
        Block -> {
            brush_slot_shape(slot) == shape;
        }
        _ -> {
            true;
        }
    }
}

fill_icon_mask(cmask: []i8) {
    i: int = 0;
    while (i < MASK_SIZE * MASK_SIZE) {
        cmask[i] = 0i8;
        i = i + 1;
    }
    r: int = 0;
    while (r < 3) {
        c: int = 0;
        while (c < 3) {
            mark_ground_cell(cmask, 0, 0, 10 + c, r, GROUND_GRASS, 0);
            mark_ground_cell(cmask, 0, 0, 20 + c, r, GROUND_GRASS, 1);
            c = c + 1;
        }
        r = r + 1;
    }
}

brush_preview_cell(brush: Brush, out: []f32) {
    match brush {
        Grass -> {
            out[0] = 11.5;
            out[1] = 1.5;
        }
        Stone -> {
            out[0] = 21.5;
            out[1] = 1.5;
        }
        Brick -> {
            out[0] = 0.5;
            out[1] = 0.5;
        }
        _ -> {
            out[0] = 1.5;
            out[1] = 1.5;
        }
    }
}

draw_brush_preview(
    prog: int,
    u_vp: int,
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_light: int,
    u_light_vp: int,
    u_lag: int,
    u_ramp: int,
    u_ground: int,
    u_cut: int,
    u_brick: int,
    u_mask_origin: int,
    cube_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    prism_buf: u32,
    brick_buf: u32,
    chamfer_n: int,
    brick_n: int,
    shape_verts: []f32,
    mask_tex: u32,
    icon_proj: []f32,
    icon_view: []f32,
    icon_vp: []f32,
    icon_tmp: []f32,
    icon_lvp: []f32,
    look: []f32,
    brush: Brush,
    shape: int,
    vx: int,
    vy: int,
    vw: int,
    vh: int
) {
    if (vw < 8 || vh < 8) {
        return;
    }
    side: int = vw;
    if (vh < vw) {
        side = vh;
    }
    vx = vx + (vw - side) / 2;
    vy = vy + (vh - side) / 2;
    glEnable(3089);
    glScissor(vx, vy, side, side);
    glViewport(vx, vy, side, side);
    glClear(256);
    cx: f32 = look[0];
    cz: f32 = look[1];
    mat_look(icon_view, cx + 1.58, 1.78, cz + 1.70, cx, 0.34, cz, 0.0, 1.0, 0.0);
    mat_mul(icon_vp, icon_proj, icon_view, icon_tmp);
    glUseProgram(prog);
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(1);
    glDisableVertexAttribArray(2);
    glActiveTexture(33985);
    glBindTexture(3553, mask_tex);
    glActiveTexture(33984);
    glUniformMatrix4fv(u_vp, 1, 0, icon_vp);
    glUniformMatrix4fv(u_light_vp, 1, 0, icon_lvp);
    glUniform3f(u_light, cx + 0.85, 2.55, cz + 0.15);
    glUniform2f(u_lag, 0.0, 0.0);
    glUniform2f(u_ramp, 0.0, 0.0);
    glUniform1f(u_cut, 0.0);
    glUniform1f(u_brick, 0.0);
    glUniform1f(u_ground, 0.0);
    glUniform2f(u_mask_origin, 0.0, 0.0);
    bind_mesh(cube_buf);
    glUniform1f(u_ground, 1.0);
    draw_box(u_origin, u_scale, u_color, cx, 0.0 - 0.06, cz, 1.18, 0.12, 1.18, 0.22,
        0.20, 0.18, 36);
    glUniform1f(u_ground, 0.0);
    if (brush == BRUSH_GRASS) {
        draw_box(u_origin, u_scale, u_color, cx - 0.22, 0.16, cz + 0.08, 0.045, 0.28,
            0.035, 0.28, 0.40, 0.18, 36);
        draw_box(u_origin, u_scale, u_color, cx + 0.12, 0.20, cz - 0.18, 0.040, 0.36,
            0.032, 0.30, 0.42, 0.20, 36);
        draw_box(u_origin, u_scale, u_color, cx + 0.26, 0.14, cz + 0.20, 0.038, 0.24,
            0.030, 0.26, 0.38, 0.17, 36);
        draw_box(u_origin, u_scale, u_color, cx - 0.08, 0.18, cz - 0.28, 0.036, 0.32,
            0.028, 0.32, 0.44, 0.21, 36);
        draw_box(u_origin, u_scale, u_color, cx + 0.02, 0.22, cz + 0.26, 0.034, 0.38,
            0.028, 0.29, 0.41, 0.19, 36);
    } else if (brush == BRUSH_BLOCK) {
        if (shape == 0) {
            bind_mesh(chamfer_buf);
            glUniform1f(u_cut, 1.0);
            draw_box(u_origin, u_scale, u_color, cx, 0.50, cz, 0.92, 1.0, 0.92, 0.56,
                0.54, 0.52, chamfer_n / 6);
            glUniform1f(u_cut, 0.0);
        } else {
            bind_mesh(prism_buf);
            glUniform3f(u_origin, cx, 0.50, cz);
            glUniform3f(u_scale, 1.0, 1.0, 1.0);
            glUniform3f(u_color, 0.988, 0.827, 0.302);
            nf: int = fill_prism(shape_verts, shape);
            if (nf > 0) {
                glBufferData(34962, nf * 4, shape_verts, 35040);
                glDrawArrays(4, 0, nf / 6);
            }
        }
    } else if (brush == BRUSH_RAMP) {
        rd: int = shape;
        if (rd < 1 || rd > 4) {
            rd = 1;
        }
        bind_mesh(ramp_buf);
        glUniform1f(u_cut, 1.0);
        glUniform3f(u_scale, 0.92, 1.0, 0.92);
        glUniform3f(u_color, 0.56, 0.54, 0.52);
        glUniform3f(u_origin, cx, 0.50, cz);
        glDrawArrays(4, (rd - 1) * (chamfer_n / 6), chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_BRICK) {
        bind_brick_mesh(brick_buf);
        glUniform1f(u_brick, 1.0);
        glUniform3f(u_origin, 0.0, 0.0, 0.0);
        glUniform3f(u_scale, 1.0, 1.0, 1.0);
        glUniform3f(u_color, 0.62, 0.32, 0.26);
        glDrawArrays(4, 0, brick_n / 9);
        glUniform1f(u_brick, 0.0);
        glDisableVertexAttribArray(2);
    } else if (brush == BRUSH_GOAL) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, cx, 0.16, cz, 0.62, 0.18, 0.62, 0.90,
            0.74, 0.28, chamfer_n / 6);
        draw_box(u_origin, u_scale, u_color, cx, 0.42, cz, 0.22, 0.22, 0.22, 0.96,
            0.82, 0.32, chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_START) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, cx, 0.55, cz, 0.86, 1.1, 0.86, 0.80,
            0.30, 0.24, chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_ROOM_START) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, cx, 0.42, cz, 0.70, 0.84, 0.70, 0.22,
            0.66, 0.72, chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    }
}

draw_brush_panel(
    hud: Font,
    tprog: int,
    u_tscreen: int,
    u_tcolor: int,
    u_talpha: int,
    htex: u32,
    tvbo: u32,
    tverts: []f32,
    gprog: int,
    u_gscreen: int,
    u_gcolor: int,
    u_galpha: int,
    gvbo: u32,
    gverts: []f32,
    prog: int,
    u_vp: int,
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_light: int,
    u_light_vp: int,
    u_lag: int,
    u_ramp: int,
    u_ground: int,
    u_cut: int,
    u_brick: int,
    u_mask_origin: int,
    cube_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    prism_buf: u32,
    brick_buf: u32,
    chamfer_n: int,
    brick_n: int,
    shape_verts: []f32,
    mask_tex: u32,
    icon_proj: []f32,
    icon_view: []f32,
    icon_vp: []f32,
    icon_tmp: []f32,
    icon_lvp: []f32,
    look: []f32,
    paint_brush: Brush,
    brush_shape: int
) {
    x0: f32 = 1048.0;
    y0: f32 = 112.0;
    tw: f32 = 62.0;
    th: f32 = 70.0;
    gap: f32 = 6.0;
    pad: f32 = 10.0;
    cols: int = 2;
    rows: int = 7;
    x1: f32 = x0 + pad + cols as f32 * tw + (cols - 1) as f32 * gap + pad;
    y1: f32 = y0 + pad + 18.0 + rows as f32 * th + (rows - 1) as f32 * gap + pad;
    n: int = put_quad(gverts, 0, x0, y0, x1, y1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.14, 0.11,
        0.10, 0.90);
    n = put_quad(gverts, 0, x0, y0, x1, y0 + 2.0);
    n = put_quad(gverts, n, x0, y1 - 2.0, x1, y1);
    n = put_quad(gverts, n, x0, y0, x0 + 2.0, y1);
    n = put_quad(gverts, n, x1 - 2.0, y0, x1, y1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.72, 0.60,
        0.44, 0.74);
    draw_title_layer(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        x0 + 12.0, y0 + 20.0, "Brush", 0.96, 0.86, 0.74, 0.56);
    slot: int = 0;
    while (slot < BRUSH_SLOT_N) {
        col: int = slot % cols;
        row: int = slot / cols;
        tx: f32 = x0 + pad + col as f32 * (tw + gap);
        ty: f32 = y0 + pad + 24.0 + row as f32 * (th + gap);
        on: bool = brush_slot_on(slot, paint_brush, brush_shape);
        n = put_quad(gverts, 0, tx, ty, tx + tw, ty + th);
        if (on) {
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.28,
                0.22, 0.16, 0.96);
        } else {
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.10,
                0.09, 0.08, 0.94);
        }
        slot = slot + 1;
    }
    glDisable(3042);
    glEnable(2929);
    glDepthMask(1);
    slot = 0;
    while (slot < BRUSH_SLOT_N) {
        col2: int = slot % cols;
        row2: int = slot / cols;
        tx2: f32 = x0 + pad + col2 as f32 * (tw + gap);
        ty2: f32 = y0 + pad + 24.0 + row2 as f32 * (th + gap);
        ix0: f32 = tx2 + 5.0;
        iy0: f32 = ty2 + 3.0;
        ix1: f32 = tx2 + tw - 5.0;
        iy1: f32 = ty2 + th - 18.0;
        kind: Brush = brush_slot_kind(slot);
        pshape: int = brush_slot_shape(slot);
        if (kind == BRUSH_RAMP) {
            pshape = 1;
            if (paint_brush == BRUSH_RAMP && brush_shape >= 1 && brush_shape <= 4) {
                pshape = brush_shape;
            }
        }
        brush_preview_cell(kind, look);
        draw_brush_preview(prog, u_vp, u_origin, u_scale, u_color, u_light, u_light_vp,
            u_lag, u_ramp, u_ground, u_cut, u_brick, u_mask_origin, cube_buf, chamfer_buf,
            ramp_buf, prism_buf, brick_buf, chamfer_n, brick_n, shape_verts, mask_tex,
            icon_proj, icon_view, icon_vp, icon_tmp, icon_lvp, look, kind, pshape,
            ix0 as int, 720 - iy1 as int, (ix1 - ix0) as int, (iy1 - iy0) as int);
        slot = slot + 1;
    }
    glViewport(0, 0, 1200, 720);
    glDisable(3089);
    glDisable(2929);
    glEnable(3042);
    glBlendFunc(770, 771);
    slot = 0;
    while (slot < BRUSH_SLOT_N) {
        col3: int = slot % cols;
        row3: int = slot / cols;
        tx3: f32 = x0 + pad + col3 as f32 * (tw + gap);
        ty3: f32 = y0 + pad + 24.0 + row3 as f32 * (th + gap);
        on2: bool = brush_slot_on(slot, paint_brush, brush_shape);
        if (on2) {
            n = put_quad(gverts, 0, tx3, ty3, tx3 + tw, ty3 + 3.0);
            n = put_quad(gverts, n, tx3, ty3 + th - 3.0, tx3 + tw, ty3 + th);
            n = put_quad(gverts, n, tx3, ty3, tx3 + 3.0, ty3 + th);
            n = put_quad(gverts, n, tx3 + tw - 3.0, ty3, tx3 + tw, ty3 + th);
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.94,
                0.78, 0.42, 0.92);
        } else {
            n = put_quad(gverts, 0, tx3, ty3, tx3 + tw, ty3 + 1.0);
            n = put_quad(gverts, n, tx3, ty3 + th - 1.0, tx3 + tw, ty3 + th);
            n = put_quad(gverts, n, tx3, ty3, tx3 + 1.0, ty3 + th);
            n = put_quad(gverts, n, tx3 + tw - 1.0, ty3, tx3 + tw, ty3 + th);
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.42,
                0.34, 0.26, 0.55);
        }
        key: []i8 = brush_slot_key(slot);
        kw: f32 = measure_text(hud, key) + 10.0;
        if (kw < 16.0) {
            kw = 16.0;
        }
        kx: f32 = tx3 + (tw - kw) * 0.5;
        ky: f32 = ty3 + th - 5.0;
        n = put_quad(gverts, 0, kx, ky - 11.0, kx + kw, ky + 3.0);
        if (on2) {
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.34,
                0.26, 0.16, 0.94);
            draw_title_layer(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo,
                tverts, kx + 5.0, ky, key, 0.98, 0.96, 0.84, 0.72);
        } else {
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.20,
                0.16, 0.13, 0.88);
            draw_title_layer(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo,
                tverts, kx + 5.0, ky, key, 0.90, 0.78, 0.66, 0.52);
        }
        slot = slot + 1;
    }
}

type FpsMeter = {
    on: bool;
    i: int;
    n: int;
    work0: int;
    flo: f32;
    fhi: f32;
    mlo: f32;
    mhi: f32;
    f_step: f32;
    m_step: f32;
    h_step: f32;
    x_step: f32;
    hlo: f32;
    hhi: f32;
};

is_fps_key(ks: int): bool {
    if (ks == 65472) {
        return true;
    }
    false;
}

is_vsync_key(ks: int): bool {
    if (ks == 118 || ks == 86) {
        return true;
    }
    false;
}

set_vsync(dpy: *i8, win: int, on: bool): bool {
    iv: int = 0;
    if (on) {
        iv = 1;
    }
    glXSwapIntervalEXT(dpy, win, iv);
    on;
}

fps_ring(head: int, n: int, k: int): int {
    (head + FPS_CAP - n + k) % FPS_CAP;
}

tick_fps(
    m: FpsMeter,
    times: []int,
    works: []int,
    rates: []f32,
    heaps: []int,
    stall_us: int
): FpsMeter {
    now: int = mono_us();
    if (m.work0 > 0) {
        work: int = now - m.work0 - stall_us;
        if (work < 0) {
            work = 0;
        }
        slot: int = m.i;
        times[slot] = now;
        works[slot] = work;
        heaps[slot] = l8_heap_used();
        m.i = (m.i + 1) % FPS_CAP;
        if (m.n < FPS_CAP) {
            m.n = m.n + 1;
        }
        rates[slot] = window_fps(times, m.i, m.n, m.n - 1);
    }
    m;
}

toggle_fps(m: FpsMeter): FpsMeter {
    m.on = !m.on;
    m.i = 0;
    m.n = 0;
    m.work0 = 0;
    m.flo = 0.0;
    m.fhi = 0.0;
    m.mlo = 0.0;
    m.mhi = 0.0;
    m.f_step = 0.0;
    m.m_step = 0.0;
    m.h_step = 0.0;
    m.x_step = 0.0;
    m.hlo = 0.0;
    m.hhi = 0.0;
    m;
}

fps_after_swap(m: FpsMeter): FpsMeter {
    m.work0 = mono_us();
    m;
}

ms_of_us(us: int): f32 {
    us as f32 * 0.001;
}

mb_of_bytes(n: int): f32 {
    n as f32 / 1048576.0;
}

plot_y(
    v: f32,
    lo: f32,
    hi: f32,
    y0: f32,
    y1: f32
): f32 {
    span: f32 = hi - lo;
    if (span < 0.001) {
        span = 0.001;
    }
    t: f32 = (v - lo) / span;
    if (t < 0.0) {
        t = 0.0;
    }
    if (t > 1.0) {
        t = 1.0;
    }
    y1 - t * (y1 - y0);
}

follow_lo(cur: f32, want: f32, ready: int): f32 {
    if (ready == 0) {
        return want;
    }
    d: f32 = want - cur;
    if (d < 0.0) {
        return cur + d * 0.34;
    }
    cur + d * 0.05;
}

follow_hi(cur: f32, want: f32, ready: int): f32 {
    if (ready == 0) {
        return want;
    }
    d: f32 = want - cur;
    if (d > 0.0) {
        return cur + d * 0.34;
    }
    cur + d * 0.05;
}

axis_pad(
    lo: f32,
    hi: f32,
    min_span: f32,
    which: int
): f32 {
    if (hi < lo) {
        t: f32 = lo;
        lo = hi;
        hi = t;
    }
    span: f32 = hi - lo;
    mid: f32 = (lo + hi) * 0.5;
    if (span < min_span) {
        lo = mid - min_span * 0.5;
        hi = mid + min_span * 0.5;
        span = min_span;
    }
    pad: f32 = span * 0.14;
    lo = lo - pad;
    hi = hi + pad;
    if (lo < 0.0) {
        lo = 0.0;
    }
    if (hi <= lo) {
        hi = lo + min_span;
    }
    if (which == 0) {
        return lo;
    }
    hi;
}

window_fps(
    times: []int,
    head: int,
    n: int,
    k: int
): f32 {
    if (n < 2 || k < 1) {
        return 0.0;
    }
    i1: int = fps_ring(head, n, k);
    t1: int = times[i1];
    j: int = k;
    while (j > 0 && t1 - times[fps_ring(head, n, j - 1)] <= FPS_RATE_US) {
        j = j - 1;
    }
    span: int = t1 - times[fps_ring(head, n, j)];
    count: int = k - j;
    if (count < 2 || span < 16000) {
        return 0.0;
    }
    if (n < FPS_CAP && span < 750000) {
        return 0.0;
    }
    count as f32 * 1000000.0 / span as f32;
}

put_xy(
    dst: []f32,
    i: int,
    x: f32,
    y: f32
): int {
    if (i + 1 >= len(dst)) {
        return i;
    }
    dst[i] = x;
    dst[i + 1] = y;
    i + 2;
}

put_quad(
    dst: []f32,
    i: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): int {
    i = put_xy(dst, i, x0, y0);
    i = put_xy(dst, i, x1, y0);
    i = put_xy(dst, i, x1, y1);
    i = put_xy(dst, i, x0, y0);
    i = put_xy(dst, i, x1, y1);
    put_xy(dst, i, x0, y1);
}

put_line(
    dst: []f32,
    i: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    w: f32
): int {
    dx: f32 = x1 - x0;
    dy: f32 = y1 - y0;
    ln: f32 = sqrt_f32(dx * dx + dy * dy);
    if (ln < 0.001) {
        return i;
    }
    nx: f32 = 0.0 - dy / ln * w * 0.5;
    ny: f32 = dx / ln * w * 0.5;
    i = put_xy(dst, i, x0 + nx, y0 + ny);
    i = put_xy(dst, i, x1 + nx, y1 + ny);
    i = put_xy(dst, i, x1 - nx, y1 - ny);
    i = put_xy(dst, i, x0 + nx, y0 + ny);
    i = put_xy(dst, i, x1 - nx, y1 - ny);
    put_xy(dst, i, x0 - nx, y0 - ny);
}

draw_solid(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    n: int,
    cr: f32,
    cg: f32,
    cb: f32,
    a: f32
) {
    if (n < 6) {
        return;
    }
    glUseProgram(prog);
    glUniform2f(u_screen, 1200.0, 720.0);
    glUniform3f(u_color, cr, cg, cb);
    glUniform1f(u_alpha, a);
    glBindBuffer(34962, vbo);
    glBufferData(34962, n * 4, verts, 35040);
    glDisableVertexAttribArray(1);
    glVertexAttribPointer(0, 2, 5126, 0, 8, 0);
    glDrawArrays(4, 0, n / 2);
}

clear_label(dst: []i8) {
    k: int = 0;
    while (k < len(dst)) {
        dst[k] = 0i8;
        k = k + 1;
    }
}

put_tenths(dst: []i8, i: int, v: f32): int {
    t: int = (v * 10.0 + 0.5) as int;
    i = put_int(dst, i, t / 10);
    i = put_ch(dst, i, '.');
    put_int(dst, i, t % 10);
}

draw_crt_panel(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    n: int = put_quad(verts, 0, x0, y0, x1, y1);
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.01, 0.06, 0.02,
        0.72);
    n = 0;
    y: f32 = y0 + 2.0;
    while (y < y1) {
        n = put_quad(verts, n, x0, y, x1, y + 1.0);
        y = y + 4.0;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.04, 0.16, 0.06,
        0.18);
    n = put_quad(verts, 0, x0, y0, x1, y0 + 1.0);
    n = put_quad(verts, n, x0, y1 - 1.0, x1, y1);
    n = put_quad(verts, n, x0, y0, x0 + 1.0, y1);
    n = put_quad(verts, n, x1 - 1.0, y0, x1, y1);
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.20, 0.70, 0.32,
        0.45);
}

draw_hud_text(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    x: f32,
    y: f32,
    s: []i8,
    alpha: f32
) {
    draw_title_layer(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts, x + 1.0,
        y + 1.0, s, alpha * 0.35, 0.0, 0.06, 0.02);
    draw_title_layer(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts, x, y,
        s, alpha, 0.38, 0.98, 0.48);
}

first_tick(lo: f32, unit: f32): int {
    if (unit < 0.0001) {
        return 0;
    }
    k: int = (lo / unit) as int;
    if (k < 0) {
        k = 0;
    }
    while (k as f32 * unit < lo - 0.0005) {
        k = k + 1;
    }
    k;
}

tick_major(k: int, unit: f32, major: f32): int {
    if (unit < 0.001 || major < 0.001) {
        return 0;
    }
    step: int = (major / unit + 0.5) as int;
    if (step < 1) {
        step = 1;
    }
    if (k % step == 0) {
        return 1;
    }
    0;
}

tick_count(lo: f32, hi: f32, unit: f32): int {
    n: int = 0;
    k: int = first_tick(lo, unit);
    while (k as f32 * unit <= hi + 0.001) {
        n = n + 1;
        k = k + 1;
    }
    n;
}

nice_step(span: f32): f32 {
    if (span < 0.001) {
        span = 0.001;
    }
    target: f32 = span / 3.0;
    if (target <= 0.1) {
        return 0.1;
    }
    base: f32 = 0.1;
    n: int = 0;
    while (n < 8) {
        if (base >= target) {
            return base;
        }
        if (base * 2.0 >= target) {
            return base * 2.0;
        }
        if (base * 5.0 >= target) {
            return base * 5.0;
        }
        base = base * 10.0;
        n = n + 1;
    }
    base;
}

hold_step(cur: f32, span: f32): f32 {
    want: f32 = nice_step(span);
    if (cur < 0.05) {
        return want;
    }
    n: f32 = span / cur;
    if (n >= 2.0 && n <= 3.0) {
        return cur;
    }
    want;
}

tick_major_span(unit: f32): f32 {
    if (unit <= 0.11) {
        return 0.5;
    }
    if (unit <= 0.21) {
        return 1.0;
    }
    if (unit <= 0.51) {
        return 2.0;
    }
    if (unit <= 1.1) {
        return 5.0;
    }
    unit * 2.0;
}

draw_unit_lines(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    lo: f32,
    hi: f32,
    unit: f32,
    major: f32
) {
    n: int = 0;
    k: int = first_tick(lo, unit);
    drawn: int = 0;
    while (k as f32 * unit <= hi + 0.001 && drawn < 4) {
        if (tick_major(k, unit, major) == 0) {
            y: f32 = plot_y(k as f32 * unit, lo, hi, y0, y1);
            n = put_quad(verts, n, x0, y - 0.45, x0 + 6.0, y + 0.45);
            n = put_quad(verts, n, x1 - 6.0, y - 0.45, x1, y + 0.45);
        }
        k = k + 1;
        drawn = drawn + 1;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.18, 0.55, 0.26,
        0.42);
    n = 0;
    k = first_tick(lo, unit);
    drawn = 0;
    while (k as f32 * unit <= hi + 0.001 && drawn < 4) {
        if (tick_major(k, unit, major) != 0) {
            y2: f32 = plot_y(k as f32 * unit, lo, hi, y0, y1);
            n = put_quad(verts, n, x0, y2 - 0.55, x0 + 8.0, y2 + 0.55);
            n = put_quad(verts, n, x1 - 8.0, y2 - 0.55, x1, y2 + 0.55);
        }
        k = k + 1;
        drawn = drawn + 1;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.22, 0.70, 0.34,
        0.55);
}

draw_unit_labels(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    lab: []i8,
    x: f32,
    y0: f32,
    y1: f32,
    lo: f32,
    hi: f32,
    unit: f32,
    major: f32,
    tenths: int
) {
    shown: int = tick_count(lo, hi, unit);
    k: int = first_tick(lo, unit);
    labeled: int = 0;
    while (k as f32 * unit <= hi + 0.001 && labeled < 4) {
        is_maj: int = tick_major(k, unit, major);
        if (is_maj != 0 || shown <= 4) {
            v: f32 = k as f32 * unit;
            clear_label(lab);
            if (tenths != 0) {
                put_tenths(lab, 0, v);
            } else {
                put_int(lab, 0, (v + 0.5) as int);
            }
            a: f32 = 0.72;
            if (is_maj != 0) {
                a = 0.95;
            }
            draw_hud_text(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts,
                x, plot_y(v, lo, hi, y0, y1) + 4.0, lab, a);
        }
        k = k + 1;
        labeled = labeled + 1;
    }
}

plot_x_at(
    t: int,
    t0: int,
    t1: int,
    x0: f32,
    x1: f32
): f32 {
    span: int = t1 - t0;
    if (span < 1) {
        span = 1;
    }
    x0 + (t - t0) as f32 / span as f32 * (x1 - x0);
}

align_up(t: int, step: int): int {
    if (step < 1) {
        step = 1;
    }
    r: int = t % step;
    if (r == 0) {
        return t;
    }
    t + (step - r);
}

x_step_us(unit: f32): int {
    us: int = (unit * 1000000.0 + 0.5) as int;
    if (us < 100000) {
        us = 100000;
    }
    us;
}

x_tick_major(t: int, step: int): int {
    if (step >= 1000000) {
        return 1;
    }
    if (t % 1000000 == 0) {
        return 1;
    }
    0;
}

put_pad2(dst: []i8, i: int, n: int): int {
    if (n < 10) {
        i = put_ch(dst, i, '0');
    }
    put_int(dst, i, n);
}

fill_clock(dst: []i8, wall: int, tenths: int) {
    clear_label(dst);
    if (wall < 0) {
        wall = 0;
    }
    s: int = wall / 1000000;
    i: int = put_int(dst, 0, s / 60 % 60);
    i = put_ch(dst, i, ':');
    i = put_pad2(dst, i, s % 60);
    if (tenths != 0) {
        i = put_ch(dst, i, '.');
        put_int(dst, i, wall / 100000 % 10);
    }
}

draw_x_lines(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    x0: f32,
    y1: f32,
    x1: f32,
    t0: int,
    t1: int,
    step: int
) {
    n: int = 0;
    t: int = align_up(t0, step) - step;
    c: int = 0;
    while (t <= t1 + step && c < 8) {
        x: f32 = plot_x_at(t, t0, t1, x0, x1);
        if (x_tick_major(t, step) == 0 && x > x0 - 8.0 && x < x1 + 8.0) {
            n = put_quad(verts, n, x - 0.45, y1 - 6.0, x + 0.45, y1);
        }
        t = t + step;
        c = c + 1;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.18, 0.55, 0.26,
        0.42);
    n = 0;
    t = align_up(t0, step) - step;
    c = 0;
    while (t <= t1 + step && c < 8) {
        x2: f32 = plot_x_at(t, t0, t1, x0, x1);
        if (x_tick_major(t, step) != 0 && x2 > x0 - 8.0 && x2 < x1 + 8.0) {
            n = put_quad(verts, n, x2 - 0.55, y1 - 8.0, x2 + 0.55, y1);
        }
        t = t + step;
        c = c + 1;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.22, 0.70, 0.34,
        0.55);
}

hud_scissor(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    w: int = (x1 - x0) as int;
    h: int = (y1 - y0) as int;
    if (w < 1 || h < 1) {
        return;
    }
    glEnable(3089);
    glScissor(x0 as int, 720 - y1 as int, w, h);
}

hud_unscissor() {
    glDisable(3089);
}

draw_x_labels(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    lab: []i8,
    x0: f32,
    x1: f32,
    y: f32,
    t0: int,
    t1: int,
    step: int,
    wall_off: int
) {
    tenths: int = 0;
    if (step < 950000) {
        tenths = 1;
    }
    clip_x: int = x0 as int;
    clip_w: int = (x1 - x0) as int;
    if (clip_w < 1) {
        return;
    }
    glEnable(3089);
    glScissor(clip_x, 0, clip_w, 720);
    t: int = align_up(t0, step) - step;
    c: int = 0;
    while (t <= t1 + step && c < 8) {
        x: f32 = plot_x_at(t, t0, t1, x0, x1);
        if (x > x0 - 28.0 && x < x1 + 28.0) {
            fill_clock(lab, t + wall_off, tenths);
            a: f32 = 0.7;
            if (x_tick_major(t, step) != 0) {
                a = 0.9;
            }
            draw_hud_text(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts,
                x - 16.0, y, lab, a);
        }
        t = t + step;
        c = c + 1;
    }
    glDisable(3089);
}

draw_fps(
    hud: Font,
    tprog: int,
    u_tscreen: int,
    u_tcolor: int,
    u_talpha: int,
    htex: u32,
    tvbo: u32,
    tverts: []f32,
    gprog: int,
    u_gscreen: int,
    u_gcolor: int,
    u_galpha: int,
    gvbo: u32,
    gverts: []f32,
    m: FpsMeter,
    times: []int,
    works: []int,
    rates: []f32,
    heaps: []int,
    lab: []i8
): FpsMeter {
    if (!m.on || m.n < 1) {
        return m;
    }
    py0: f32 = 28.0;
    py1: f32 = 100.0;
    fx0: f32 = 46.0;
    fx1: f32 = 386.0;
    mx0: f32 = 440.0;
    mx1: f32 = 780.0;
    hx0: f32 = 834.0;
    hx1: f32 = 1182.0;
    last: int = fps_ring(m.i, m.n, m.n - 1);
    t1: int = times[last];
    t0: int = t1 - FPS_SPAN_US;
    span: int = FPS_SPAN_US;
    flo: f32 = 0.0;
    fhi: f32 = 0.0;
    have_f: int = 0;
    last_ms: f32 = ms_of_us(works[last]);
    last_fps: f32 = rates[last];
    last_mb: f32 = mb_of_bytes(heaps[last]);
    mlo: f32 = last_ms;
    mhi: f32 = last_ms;
    hlo: f32 = last_mb;
    hhi: f32 = last_mb;
    k: int = 0;
    while (k < m.n) {
        ms: f32 = ms_of_us(works[fps_ring(m.i, m.n, k)]);
        if (ms < mlo) {
            mlo = ms;
        }
        if (ms > mhi) {
            mhi = ms;
        }
        hb: f32 = mb_of_bytes(heaps[fps_ring(m.i, m.n, k)]);
        if (hb < hlo) {
            hlo = hb;
        }
        if (hb > hhi) {
            hhi = hb;
        }
        fpsv: f32 = rates[fps_ring(m.i, m.n, k)];
        if (fpsv > 0.001) {
            if (have_f == 0) {
                flo = fpsv;
                fhi = fpsv;
                have_f = 1;
            }
            if (fpsv < flo) {
                flo = fpsv;
            }
            if (fpsv > fhi) {
                fhi = fpsv;
            }
        }
        k = k + 1;
    }
    if (have_f == 0) {
        flo = 0.0;
        fhi = 120.0;
    }
    raw_flo: f32 = flo;
    raw_fhi: f32 = fhi;
    flo = axis_pad(raw_flo, raw_fhi, 0.8, 0);
    fhi = axis_pad(raw_flo, raw_fhi, 0.8, 1);
    raw_mlo: f32 = mlo;
    raw_mhi: f32 = mhi;
    mlo = axis_pad(raw_mlo, raw_mhi, 0.2, 0);
    mhi = axis_pad(raw_mlo, raw_mhi, 0.2, 1);
    raw_hlo: f32 = hlo;
    raw_hhi: f32 = hhi;
    hlo = axis_pad(raw_hlo, raw_hhi, 0.05, 0);
    hhi = axis_pad(raw_hlo, raw_hhi, 0.05, 1);
    ready: int = 0;
    if (m.fhi > m.flo + 0.001 && m.mhi > m.mlo + 0.001 && m.hhi > m.hlo + 0.001) {
        ready = 1;
    }
    flo = follow_lo(m.flo, flo, ready);
    fhi = follow_hi(m.fhi, fhi, ready);
    mlo = follow_lo(m.mlo, mlo, ready);
    mhi = follow_hi(m.mhi, mhi, ready);
    hlo = follow_lo(m.hlo, hlo, ready);
    hhi = follow_hi(m.hhi, hhi, ready);
    if (fhi <= flo) {
        fhi = flo + 0.8;
    }
    if (mhi <= mlo) {
        mhi = mlo + 0.2;
    }
    if (hhi <= hlo) {
        hhi = hlo + 0.05;
    }
    fps_unit: f32 = hold_step(m.f_step, fhi - flo);
    ms_unit: f32 = hold_step(m.m_step, mhi - mlo);
    heap_unit: f32 = hold_step(m.h_step, hhi - hlo);
    x_span: f32 = span as f32 / 1000000.0;
    x_unit: f32 = hold_step(m.x_step, x_span);
    m.flo = flo;
    m.fhi = fhi;
    m.mlo = mlo;
    m.mhi = mhi;
    m.hlo = hlo;
    m.hhi = hhi;
    m.f_step = fps_unit;
    m.m_step = ms_unit;
    m.h_step = heap_unit;
    m.x_step = x_unit;
    fps_major: f32 = tick_major_span(fps_unit);
    ms_major: f32 = tick_major_span(ms_unit);
    heap_major: f32 = tick_major_span(heap_unit);
    x_us: int = x_step_us(x_unit);
    wall_off: int = wall_us() - mono_us();
    draw_crt_panel(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 10.0, 10.0,
        394.0, 118.0);
    draw_crt_panel(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 404.0, 10.0,
        788.0, 118.0);
    draw_crt_panel(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 798.0, 10.0,
        1190.0, 118.0);
    draw_unit_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, fx0, py0,
        fx1, py1, flo, fhi, fps_unit, fps_major);
    draw_unit_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, mx0, py0,
        mx1, py1, mlo, mhi, ms_unit, ms_major);
    draw_unit_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, hx0, py0,
        hx1, py1, hlo, hhi, heap_unit, heap_major);
    draw_x_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, fx0, py1, fx1,
        t0, t1, x_us);
    draw_x_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, mx0, py1, mx1,
        t0, t1, x_us);
    draw_x_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, hx0, py1, hx1,
        t0, t1, x_us);
    n: int = 0;
    k = 0;
    px: f32 = 0.0;
    py: f32 = 0.0;
    have: int = 0;
    while (k < m.n) {
        ix2: int = fps_ring(m.i, m.n, k);
        fpsv2: f32 = rates[ix2];
        if (fpsv2 > 0.001) {
            x2: f32 = fx0 + (times[ix2] - t0) as f32 / span as f32 * (fx1 - fx0);
            y2: f32 = plot_y(fpsv2, flo, fhi, py0, py1);
            if (have != 0) {
                n = put_line(gverts, n, px, py, x2, y2, 1.6);
            }
            px = x2;
            py = y2;
            have = 1;
        }
        k = k + 1;
    }
    hud_scissor(fx0, py0, fx1, py1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.40, 1.0, 0.50,
        0.95);
    n = 0;
    k = 0;
    while (k < m.n) {
        ix: int = fps_ring(m.i, m.n, k);
        x: f32 = mx0 + (times[ix] - t0) as f32 / span as f32 * (mx1 - mx0);
        y: f32 = plot_y(ms_of_us(works[ix]), mlo, mhi, py0, py1);
        n = put_quad(gverts, n, x - 1.3, y - 1.3, x + 1.3, y + 1.3);
        k = k + 1;
    }
    hud_scissor(mx0, py0, mx1, py1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.62, 1.0, 0.42,
        0.92);
    n = 0;
    k = 0;
    px = 0.0;
    py = 0.0;
    have = 0;
    while (k < m.n) {
        ix3: int = fps_ring(m.i, m.n, k);
        x3: f32 = hx0 + (times[ix3] - t0) as f32 / span as f32 * (hx1 - hx0);
        y3: f32 = plot_y(mb_of_bytes(heaps[ix3]), hlo, hhi, py0, py1);
        if (have != 0) {
            n = put_line(gverts, n, px, py, x3, y3, 1.6);
        }
        px = x3;
        py = y3;
        have = 1;
        k = k + 1;
    }
    hud_scissor(hx0, py0, hx1, py1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.95, 0.85,
        0.28, 0.95);
    hud_unscissor();
    glEnableVertexAttribArray(1);
    clear_label(lab);
    i: int = put_str(lab, 0, "FPS ");
    if (last_fps > 0.001) {
        i = put_int(lab, i, (last_fps + 0.5) as int);
    }
    draw_hud_text(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, 18.0,
        22.0, lab, 0.95);
    clear_label(lab);
    i = put_str(lab, 0, "MS ");
    i = put_tenths(lab, i, last_ms);
    draw_hud_text(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, 412.0,
        22.0, lab, 0.95);
    clear_label(lab);
    i = put_str(lab, 0, "MEM ");
    i = put_tenths(lab, i, last_mb);
    i = put_ch(lab, i, 'M');
    draw_hud_text(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, 806.0,
        22.0, lab, 0.95);
    fps_dec: int = 0;
    if (fps_unit < 0.95) {
        fps_dec = 1;
    }
    ms_dec: int = 0;
    if (ms_unit < 0.95) {
        ms_dec = 1;
    }
    heap_dec: int = 0;
    if (heap_unit < 0.95) {
        heap_dec = 1;
    }
    draw_unit_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        lab, 14.0, py0, py1, flo, fhi, fps_unit, fps_major, fps_dec);
    draw_unit_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        lab, 408.0, py0, py1, mlo, mhi, ms_unit, ms_major, ms_dec);
    draw_unit_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts,
        lab, 802.0, py0, py1, hlo, hhi, heap_unit, heap_major, heap_dec);
    draw_x_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab,
        fx0, fx1, 114.0, t0, t1, x_us, wall_off);
    draw_x_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab,
        mx0, mx1, 114.0, t0, t1, x_us, wall_off);
    draw_x_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab,
        hx0, hx1, 114.0, t0, t1, x_us, wall_off);
    m;
}

