tag block_game;

use_tag gl, x11, freetype;

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

check_lean(
    hist: []Block,
    n: int,
    layer: int,
    seated: int,
    expected: int,
    head: []int,
    link: []int,
    body: []int,
    ramp: []int
) {
    if (stack_lean(hist, 0, n, 2, 3, layer, seated) != expected) die("linear stack lean");
    build_cell_index(hist, 0, n, head, link);
    if (stack_lean_ix(hist, 0, head, link, 2, 3, layer, seated) != expected) die("indexed stack lean");
    fill_stack_col(hist, 0, n, 2, 3, body, ramp);
    if (stack_lean_col(body, ramp, layer, seated != 0) != expected) die("column stack lean");
}

main(): int {
    hist: []Block = new Block[3](Block {
        id: 0,
        column: 2,
        row: 3,
        layer: 0,
        shape: 0,
        ramp: 1,
        mounted: 0
    });
    head: []int = new int[CELL_HASH](0 - 1);
    link: []int = new int[3](0 - 1);
    body: []int = new int[9](0);
    ramp: []int = new int[9](0);
    for direction in 1..5 {
        for base in 0..8 {
            layer: int = base - 1;
            hist[0] = Block {
                id: 0,
                column: 2,
                row: 3,
                layer: layer,
                shape: 0,
                ramp: direction,
                mounted: 0
            };
            // The wedge's own geometry supplies its slope. It must not also
            // receive the cargo tilt, on land, pond bottom, or an elevated base.
            check_lean(hist, 1, layer, 0, 0, head, link, body, ramp);
            check_lean(hist, 1, layer, 1, direction, head, link, body, ramp);
            hist[1] = Block {
                id: 1,
                column: 2,
                row: 3,
                layer: layer,
                shape: 0,
                ramp: 0,
                mounted: 1
            };
            hist[2] = Block {
                id: 2,
                column: 2,
                row: 3,
                layer: layer + 1,
                shape: 0,
                ramp: 2,
                mounted: 0
            };
            // Mounted cargo tilts, and transmits its lean to the stack above.
            check_lean(hist, 3, layer + 1, 0, direction + 8, head, link, body, ramp);
            // An ordinary cube is a flat support, including a submerged cube.
            hist[0].ramp = 0;
            hist[1] = hist[2];
            check_lean(hist, 2, layer + 1, 0, 0, head, link, body, ramp);
        }
    }
    write(1, "stack lean tests passed\n", len("stack lean tests passed\n"));
    0;
}
