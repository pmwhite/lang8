tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

check_lean(
    hist: []Block,
    n: int,
    layer: int,
    seated: int,
    expected: int,
    index: *CellIndex,
    body: []int,
    ramp: []int
) raises IoError requires (len(hist) >= LEVEL_MAX_BLOCKS && len(body) >= 9 && len(ramp) >= 9 && 0 <= n && n <= LEVEL_MAX_BLOCKS && 0 - 1 <= layer && layer < 8) {
    if (stack_lean(hist, 0, n, 2, 3, layer, seated) != expected) die("linear stack lean");
    build_cell_index(hist, 0, n, index);
    if (stack_lean_ix(hist, 0, index, 2, 3, layer, seated) != expected) die("indexed stack lean");
    fill_stack_col(hist, 0, n, 2, 3, body, ramp);
    if (stack_lean_col(body, ramp, layer, seated != 0) != expected) die("column stack lean")
}

main() raises IoError: int {
    hist: []Block = new Block[LEVEL_MAX_BLOCKS](Block {
        id: 0,
        column: 2,
        row: 3,
        layer: 0,
        shape: 0,
        ramp: 1,
        mounted: 0
    });
    index: *CellIndex = new CellIndex { head: new int[CELL_HASH](0 - 1), link: new int[LEVEL_MAX_BLOCKS](0 - 1) };
    body: []int = new int[9](0);
    ramp: []int = new int[9](0);
    for direction in 1..5 {
        for base in 0..8 {
            layer: int = base - 1;
            hist[0] = Block {
                id: 0,
                column: 2,
                row: 3,
                layer: layer,
                shape: 0,
                ramp: direction,
                mounted: 0
            };
            // The wedge's own geometry supplies its slope. It must not also
            // receive the cargo tilt, on land, pond bottom, or an elevated base.
            check_lean(hist, 1, layer, 0, 0, index, body, ramp);
            check_lean(hist, 1, layer, 1, direction, index, body, ramp);
            hist[1] = Block {
                id: 1,
                column: 2,
                row: 3,
                layer: layer,
                shape: 0,
                ramp: 0,
                mounted: 1
            };
            hist[2] = Block {
                id: 2,
                column: 2,
                row: 3,
                layer: layer + 1,
                shape: 0,
                ramp: 2,
                mounted: 0
            };
            // Mounted cargo tilts, and transmits its lean to the stack above.
            check_lean(hist, 3, base, 0, direction + 8, index, body, ramp);
            // An ordinary cube is a flat support, including a submerged cube.
            hist[0].ramp = 0;
            hist[1] = hist[2];
            check_lean(hist, 2, base, 0, 0, index, body, ramp)
        }
    }
    print("stack lean tests passed");
    0
    //% expect: "stack lean tests passed\n"
}
