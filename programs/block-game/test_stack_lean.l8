tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

// Print the lean at (2, 3) from the linear, indexed and column versions of
// stack_lean: one value when they agree, or all three when they do not.
stack_test_lean(
    hist: []Block,
    n: int,
    layer: int,
    seated: int,
    index: *CellIndex,
    body: []int,
    ramp: []int
) raises IoError requires (len(hist) >= LEVEL_MAX_BLOCKS && len(body) >= 9 && len(ramp) >= 9 && 0 <= n && n <= LEVEL_MAX_BLOCKS && 0 - 1 <= layer && layer < 8) {
    linear: int = stack_lean(hist, 0, n, 2, 3, layer, seated);
    build_cell_index(hist, 0, n, index);
    indexed: int = stack_lean_ix(hist, 0, index, 2, 3, layer, seated);
    fill_stack_col(hist, 0, n, 2, 3, body, ramp);
    column: int = stack_lean_col(body, ramp, layer, seated != 0);
    write(1, " ");
    write_int(1, linear);
    if (indexed != linear || column != linear) {
        write(1, "/");
        write_int(1, indexed);
        write(1, "/");
        write_int(1, column)
    }
}

stack_test_block(
    id: int,
    layer: int,
    ramp: int,
    mounted: int
): Block {
    Block {
        id: id,
        column: 2,
        row: 3,
        layer: layer,
        shape: 0,
        ramp: ramp,
        mounted: mounted
    }
}

stack_test_hist(): []Block@new ensures (len(returned) == LEVEL_MAX_BLOCKS) {
    new Block[LEVEL_MAX_BLOCKS](stack_test_block(0, 0, 1, 0))
}

stack_test_index(): *CellIndex@new {
    new CellIndex { head: new int[CELL_HASH](0 - 1), link: new int[LEVEL_MAX_BLOCKS](0 - 1) }
}

// In these tables each column puts the base block (the wedge, or the cube) at
// one layer from -1 (a pond bottom) through 6, and each row is a ramp
// direction.
test "a wedge gets no cargo tilt from its own slope" {
    hist: []Block = stack_test_hist();
    index: *CellIndex = stack_test_index();
    body: []int = new int[9](0);
    ramp: []int = new int[9](0);
    for direction in 1..5 {
        write(1, "ramp ");
        write_int(1, direction);
        write(1, ":");
        for base in 0..8 {
            layer: int = base - 1;
            hist[0] = stack_test_block(0, layer, direction, 0);
            stack_test_lean(hist, 1, layer, 0, index, body, ramp)
        }
        write(1, "\n")
    }
    expect {|
        ramp 1: 0 0 0 0 0 0 0 0
        ramp 2: 0 0 0 0 0 0 0 0
        ramp 3: 0 0 0 0 0 0 0 0
        ramp 4: 0 0 0 0 0 0 0 0
    |}
}

test "a body seated on a wedge leans with the slope" {
    hist: []Block = stack_test_hist();
    index: *CellIndex = stack_test_index();
    body: []int = new int[9](0);
    ramp: []int = new int[9](0);
    for direction in 1..5 {
        write(1, "ramp ");
        write_int(1, direction);
        write(1, ":");
        for base in 0..8 {
            layer: int = base - 1;
            hist[0] = stack_test_block(0, layer, direction, 0);
            stack_test_lean(hist, 1, layer, 1, index, body, ramp)
        }
        write(1, "\n")
    }
    expect {|
        ramp 1: 1 1 1 1 1 1 1 1
        ramp 2: 2 2 2 2 2 2 2 2
        ramp 3: 3 3 3 3 3 3 3 3
        ramp 4: 4 4 4 4 4 4 4 4
    |}
}

test "cargo mounted on a wedge passes its lean to the stack above" {
    // A wedge with mounted cargo in its cell and another block on top; the
    // lean of the top block is the direction plus 8 per layer above the cargo.
    hist: []Block = stack_test_hist();
    index: *CellIndex = stack_test_index();
    body: []int = new int[9](0);
    ramp: []int = new int[9](0);
    for direction in 1..5 {
        write(1, "ramp ");
        write_int(1, direction);
        write(1, ":");
        for base in 0..8 {
            layer: int = base - 1;
            hist[0] = stack_test_block(0, layer, direction, 0);
            hist[1] = stack_test_block(1, layer, 0, 1);
            hist[2] = stack_test_block(2, layer + 1, 2, 0);
            stack_test_lean(hist, 3, base, 0, index, body, ramp)
        }
        write(1, "\n")
    }
    expect {|
        ramp 1: 9 9 9 9 9 9 9 9
        ramp 2: 10 10 10 10 10 10 10 10
        ramp 3: 11 11 11 11 11 11 11 11
        ramp 4: 12 12 12 12 12 12 12 12
    |}
}

test "a cube is a flat support, even when submerged" {
    // A block (itself a wedge) resting on a plain cube.
    hist: []Block = stack_test_hist();
    index: *CellIndex = stack_test_index();
    body: []int = new int[9](0);
    ramp: []int = new int[9](0);
    write(1, "cube:");
    for base in 0..8 {
        layer: int = base - 1;
        hist[0] = stack_test_block(0, layer, 0, 0);
        hist[1] = stack_test_block(2, layer + 1, 2, 0);
        stack_test_lean(hist, 2, base, 0, index, body, ramp)
    }
    write(1, "\n");
    expect {|
        cube: 0 0 0 0 0 0 0 0
    |}
}
