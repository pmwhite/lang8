tag block_game;

use_tag gl;

// Twenty reusable meshes, batched by species/variant. Vertices and instance
// storage are allocated once. Wind never moves a walkable top away from its grid.
PLANT_MESH_FLOATS: int = 150000;

type PlantRender = {
    prog: int;
    u: []int;
    mesh: u32;
    instances: u32;
    starts: []int;
    sizes: []int;
    counts: []int;
    offsets: []int;
    data: []f32;
    key: int;
    ready: bool;
    total: int;
    wind_tex: u32;
    wind_x: f32;
    wind_z: f32;
    wind_ready: bool;
    wind_start_ms: int;
};

plant_vs(): []i8 {
    """
#version 120
attribute vec3 pos, nrm;
attribute vec4 vcol, vaux;
uniform mat4 vp;
uniform float time;
uniform int pass;
uniform sampler2D wind_map;
uniform vec2 wind_origin;
uniform float wind_on;
varying vec3 world, normal, color;
varying float material, local_y;
void main() {
  vec3 p=pos;
  float foliage=1.0-step(0.1,abs(vcol.a-1.0));
  float clock=pass==2 ? 0.0 : time;
  vec2 flow=vec2(0.0);
  if(pass!=3 && wind_on>0.5) {
    vec2 wind_uv=(vaux.xz-wind_origin)/64.0;
    flow=(texture2D(wind_map,wind_uv).rg*2.0-1.0)*2.0;
  }
  float height_flex=smoothstep(0.0,2.8,pos.y);
  float wood_flex=height_flex*0.28;
  float leaf_flex=max(height_flex,smoothstep(0.05,0.80,pos.y)*0.55);
  float flex=mix(wood_flex,leaf_flex,foliage);
  float flow_len=length(flow);
  vec2 flow_dir=flow/max(flow_len,0.001);
  vec2 visual_flow=flow*min(1.0,1.35/max(flow_len,0.001));
  vec2 side=normalize(vec2(-flow.y,flow.x)+vec2(0.001,0.0));
  float gust_front=sin(clock*0.85-dot(vaux.xz,flow_dir)*0.22);
  float gust=0.15+1.85*smoothstep(-0.20,0.85,gust_front);
  float flutter=sin(clock*2.6+vaux.w+pos.y*2.3)*0.012*min(flow_len,1.0);
  vec2 bend=(visual_flow*(0.115*gust)+side*flutter)*flex;
  p.xz+=bend;
  world=p+vaux.xyz; normal=nrm; color=vcol.rgb;
  material=vcol.a; local_y=pos.y;
  gl_Position=vp*vec4(world,1.0);
}
""";
}

plant_fs(): []i8 {
    """
#version 120
uniform sampler2DShadow shadow_map;
uniform sampler2D lamp_map;
uniform mat4 light_vp;
uniform vec2 lamp_origin;
uniform vec3 camera, actor;
uniform int pass;
varying vec3 world, normal, color;
varying float material, local_y;
void main() {
  if(pass==1) { gl_FragColor=vec4(1); return; }
  if(pass==2 && world.y< -0.02) discard;
  // Open a small stippled window through a crown obscuring the player. Keep
  // its shadow and reflection solid and all collision geometry unchanged.
  if(pass==0 && actor.y> -900.0) {
    vec3 ray=normalize(camera-actor), delta=world-actor;
    float along=dot(delta,ray);
    if(along>0.4 && along<length(camera-actor) && length(delta-ray*along)<0.72) {
      if(mod(floor(gl_FragCoord.x)+floor(gl_FragCoord.y)*2.0,4.0)>0.5) discard;
    }
  }
  vec3 n=normalize(normal), L=normalize(vec3(4,11,3)), V=normalize(camera-world);
  if(dot(n,V)<0.0) n=-n;
  if(pass==3) {
    vec3 ambient=mix(vec3(0.28,0.25,0.20),vec3(0.44,0.49,0.55),n.y*0.5+0.5);
    gl_FragColor=vec4(color*(ambient+vec3(0.65)*max(dot(n,L),0.0)),1.0);
    return;
  }
  vec4 sh=light_vp*vec4(world,1); vec3 sc=sh.xyz/sh.w;
  float visibility=1.0;
  if(all(greaterThan(sc,vec3(0.01))) && all(lessThan(sc,vec3(0.99))))
    visibility=shadow2D(shadow_map,vec3(sc.xy,sc.z-0.00035)).r;
  vec2 uv=(world.xz-lamp_origin)/128.0;
  float warm=texture2D(lamp_map,clamp(uv,0.0,1.0)).r;
  if(any(lessThan(uv,vec2(0))) || any(greaterThan(uv,vec2(1)))) warm=0.0;
  vec3 albedo=color;
  if(material>1.5) {
    float band=step(0.88,fract(local_y*8.0+sin(world.x*21.0+world.z*17.0)*0.23));
    albedo=mix(albedo,vec3(0.14,0.12,0.11),band*0.78);
  }
  vec3 ambient=mix(vec3(0.17,0.15,0.12),vec3(0.32,0.39,0.48),n.y*0.5+0.5);
  vec3 lighting=ambient+vec3(0.76,0.86,1.0)*0.65*max(dot(n,L),0.0)*visibility;
  lighting+=vec3(1.6,0.87,0.36)*warm;
  if(material>0.5 && material<1.5)
    lighting+=vec3(0.18,0.24,0.10)*pow(max(dot(-L,V),0.0),3.0)*visibility;
  vec3 lit=albedo*lighting;
  lit=mix(lit,vec3(0.16,0.18,0.19),clamp(length(camera-world)*0.0015,0.0,0.13));
  gl_FragColor=vec4(lit,1);
}
""";
}

plant_vertex(
    dst: []f32,
    i: int,
    x: f32,
    y: f32,
    z: f32,
    nx: f32,
    ny: f32,
    nz: f32,
    r: f32,
    g: f32,
    b: f32,
    material: f32
): int {
    if (i + 10 > len(dst)) die("plant vertex capacity");
    dst[i] = x;
    dst[i + 1] = y;
    dst[i + 2] = z;
    dst[i + 3] = nx;
    dst[i + 4] = ny;
    dst[i + 5] = nz;
    dst[i + 6] = r;
    dst[i + 7] = g;
    dst[i + 8] = b;
    dst[i + 9] = material;
    i + 10;
}

// Stable variation is baked into the reusable meshes, not regenerated per frame.
plant_random(seed: int): f32 {
    v: int = (seed * 73 + 19) % 997;
    ((v * v * 17 + v * 131 + 23) % 997) as f32 / 996.0;
}

// A tapered limb between arbitrary points. Visible forks, rather than a post
// hidden under a stack of tiles, establish the tree's structure.
plant_branch(
    dst: []f32,
    i: int,
    x0: f32,
    y0: f32,
    z0: f32,
    x1: f32,
    y1: f32,
    z1: f32,
    r0: f32,
    r1: f32,
    r: f32,
    g: f32,
    b: f32,
    material: f32
): int {
    ax: f32 = x1 - x0;
    ay: f32 = y1 - y0;
    az: f32 = z1 - z0;
    length: f32 = sqrt_f32(ax * ax + ay * ay + az * az);
    if (length < 0.001) return i;
    ax = ax / length;
    ay = ay / length;
    az = az / length;
    horizontal: f32 = sqrt_f32(ax * ax + az * az);
    ux: f32 = 1.0;
    uz: f32 = 0.0;
    if (horizontal > 0.001) {
        ux = az / horizontal;
        uz = (0.0 - ax) / horizontal;
    }
    vx: f32 = ay * uz;
    vy: f32 = az * ux - ax * uz;
    vz: f32 = 0.0 - ay * ux;
    for side in 0..8 {
        for corner in 0..6 {
            s: int = side;
            upper: bool = false;
            if (corner == 1 || corner == 2 || corner == 4) s = side + 1;
            if (corner == 2 || corner == 4 || corner == 5) upper = true;
            a: f32 = s as f32 * 0.78539816;
            nx: f32 = ux * cos_f32(a) + vx * sin_f32(a);
            ny: f32 = vy * sin_f32(a);
            nz: f32 = uz * cos_f32(a) + vz * sin_f32(a);
            x: f32 = x0;
            y: f32 = y0;
            z: f32 = z0;
            radius: f32 = r0;
            if (upper) {
                x = x1;
                y = y1;
                z = z1;
                radius = r1;
            }
            y = y + ny * radius;
            if (y < 0.0) y = 0.0;
            shade: f32 = 0.91 + 0.09 * cos_f32(a * 3.0);
            i = plant_vertex(dst, i, x + nx * radius, y, z + nz * radius, nx, ny,
                nz, r * shade, g * shade, b * shade, material);
        }
    }
    i;
}

plant_leaf_vertex(
    dst: []f32,
    i: int,
    x: f32,
    y: f32,
    z: f32,
    nx: f32,
    ny: f32,
    nz: f32,
    r: f32,
    g: f32,
    b: f32,
    top: f32
): int {
    if (y < 0.02) y = 0.02;
    if (y > top) y = top;
    plant_vertex(dst, i, x, y, z, nx, ny, nz, r, g, b, 1.0);
}

// Overlapping irregular foliage masses carry the volume; individual pointed
// leaves break their outlines. No tile edges, flat caps, alpha cards or textures.
plant_crown(
    dst: []f32,
    i: int,
    cx: f32,
    cy: f32,
    cz: f32,
    rx: f32,
    ry: f32,
    rz: f32,
    r: f32,
    g: f32,
    b: f32,
    top: f32,
    seed: int
): int {
    for band in 0..5 {
        for side in 0..10 {
            for corner in 0..6 {
                ring: int = band;
                s: int = side;
                if (corner == 1 || corner == 2 || corner == 4) s = side + 1;
                if (corner == 2 || corner == 4 || corner == 5) ring = band + 1;
                a: f32 = s as f32 * 0.62831853 + seed as f32 * 0.27;
                ny: f32 = cos_f32(ring as f32 * 0.62831853);
                radial: f32 = sin_f32(ring as f32 * 0.62831853);
                if (ring == 0) {
                    ny = 1.0;
                    radial = 0.0;
                }
                if (ring == 5) {
                    ny = 0.0 - 1.0;
                    radial = 0.0;
                }
                nx: f32 = cos_f32(a) * radial;
                nz: f32 = sin_f32(a) * radial;
                irregular: f32 = 1.0 + 0.11 * sin_f32(a * 3.0 + seed as f32) + 0.06 * cos_f32(a * 5.0 + ring as f32);
                shade: f32 = 0.83 + 0.17 * ny + 0.07 * sin_f32(a * 3.0 + ring as f32 * 2.0);
                i = plant_leaf_vertex(dst, i, cx + nx * rx * irregular * 0.68, cy + ny * ry * 0.68,
                    cz + nz * rz * irregular * 0.68, nx / rx, ny / ry, nz / rz, r * shade,
                    g * shade, b * shade, top);
            }
        }
    }
    for leaf in 0..100 {
        k: int = seed * 41 + leaf * 7;
        a: f32 = plant_random(k) * 6.2831853;
        ny: f32 = plant_random(k + 1) * 2.0 - 1.0;
        radial: f32 = sqrt_f32(1.0 - ny * ny);
        nx: f32 = cos_f32(a) * radial;
        nz: f32 = sin_f32(a) * radial;
        irregular: f32 = 0.83 + plant_random(k + 5) * 0.22 + 0.11 * sin_f32(a * 3.0 + seed as f32);
        x: f32 = cx + nx * rx * irregular;
        y: f32 = cy + ny * ry;
        z: f32 = cz + nz * rz * irregular;
        size: f32 = 0.12 + plant_random(k + 2) * 0.075;
        // Tilt each pointed leaf away from its twig, with a narrow folded tip.
        tx: f32 = cos_f32(a) * size;
        tz: f32 = sin_f32(a) * size;
        wx: f32 = 0.0 - sin_f32(a) * size * 0.55;
        wz: f32 = cos_f32(a) * size * 0.55;
        lift: f32 = (plant_random(k + 3) - 0.35) * size * 1.8;
        shade: f32 = 0.65 + plant_random(k + 4) * 0.55;
        i = plant_leaf_vertex(dst, i, x - tx, y - lift, z - tz, nx, 0.6 + ny, nz,
            r * shade, g * shade, b * shade, top);
        i = plant_leaf_vertex(dst, i, x + wx, y, z + wz, nx, 0.6 + ny, nz, r * shade,
            g * shade, b * shade, top);
        i = plant_leaf_vertex(dst, i, x + tx, y + lift, z + tz, nx, 0.6 + ny, nz,
            r * shade, g * shade, b * shade, top);
        i = plant_leaf_vertex(dst, i, x - tx, y - lift, z - tz, nx, 0.3 + ny, nz,
            r * shade * 0.9, g * shade * 0.9, b * shade * 0.9, top);
        i = plant_leaf_vertex(dst, i, x + tx, y + lift, z + tz, nx, 0.3 + ny, nz,
            r * shade * 0.9, g * shade * 0.9, b * shade * 0.9, top);
        i = plant_leaf_vertex(dst, i, x - wx, y - size * 0.15, z - wz, nx, 0.3 + ny,
            nz, r * shade * 0.9, g * shade * 0.9, b * shade * 0.9, top);
    }
    i;
}

// Ridged, toothed sprays along a pine bough. Several overlapping sprays make
// the needles' broken silhouette without transparent cards or round blobs.
plant_needles(
    dst: []f32,
    i: int,
    cx: f32,
    cy: f32,
    cz: f32,
    a: f32,
    reach: f32,
    width: f32,
    r: f32,
    g: f32,
    b: f32,
    seed: int
): int {
    dx: f32 = cos_f32(a);
    dz: f32 = sin_f32(a);
    for step in 0..10 {
        for side in 0..2 {
            for corner in 0..6 {
                at: int = step;
                edge: bool = false;
                if (corner == 1 || corner == 2 || corner == 4) at = step + 1;
                if (corner == 2 || corner == 4 || corner == 5) edge = true;
                t: f32 = at as f32 / 10.0;
                w: f32 = sin_f32(t * 3.14159265) * width;
                if (at % 2 == 1) w = w * 0.20;
                if (!edge) w = 0.0;
                sign: f32 = 1.0;
                if (side == 1) sign = 0.0 - 1.0;
                shade: f32 = 0.73 + plant_random(seed * 9 + step) * 0.32;
                y: f32 = cy + 0.24 * (1.0 - t) - w * 0.28;
                if (y > 3.0) y = 3.0;
                i = plant_vertex(dst, i, cx + dx * reach * t - dz * w * sign, y, cz + dz * reach * t + dx * w * sign,
                    dx * 0.25 - dz * sign * 0.4, 1.0, dz * 0.25 + dx * sign * 0.4,
                    r * shade, g * shade, b * shade, 1.0);
            }
        }
    }
    i;
}

fill_plant_mesh(dst: []f32, style: int, seed: int): int {
    i: int = 0;
    h: f32 = plant_height(style) as f32;
    turn: f32 = seed as f32 * 1.67;
    red: f32 = 0.29;
    green: f32 = 0.48;
    blue: f32 = 0.13;
    if (style == 0) {
        red = 0.27;
        green = 0.44;
        blue = 0.18;
    }
    if (style == 2) {
        red = 0.26;
        green = 0.43;
        blue = 0.12;
    }
    if (style == 3) {
        red = 0.47;
        green = 0.62;
        blue = 0.22;
    }
    if (style == 4) {
        red = 0.16;
        green = 0.37;
        blue = 0.25;
    }
    green = green + seed as f32 * 0.012;
    wr: f32 = 0.36;
    wg: f32 = 0.25;
    wb: f32 = 0.15;
    bark: f32 = 0.0;
    radius: f32 = 0.17;
    if (style == 2) radius = 0.24;
    if (style == 3) {
        wr = 0.85;
        wg = 0.84;
        wb = 0.74;
        bark = 2.0;
        radius = 0.095;
    }
    if (style == 4) radius = 0.13;
    if (style == 0) {
        for limb in 0..6 {
            a: f32 = limb as f32 * 1.0472 + turn;
            x: f32 = cos_f32(a) * 0.28;
            z: f32 = sin_f32(a) * 0.28;
            i = plant_branch(dst, i, 0.0, 0.02, 0.0, x, 0.65, z, 0.035, 0.012, wr,
                wg, wb, bark);
            i = plant_crown(dst, i, x, 0.58 + plant_random(seed * 9 + limb) * 0.08,
                z, 0.29, 0.30, 0.29, red, green, blue, h, seed * 17 + limb);
        }
        return plant_crown(dst, i, 0.0, 0.74, 0.0, 0.34, 0.26, 0.34, red, green, blue,
            h, seed + 71);
    }
    leanx: f32 = cos_f32(turn) * 0.12;
    leanz: f32 = sin_f32(turn) * 0.12;
    fork: f32 = h * 0.43;
    i = plant_branch(dst, i, 0.0, 0.0, 0.0, leanx, fork * 0.53, leanz, radius, radius * 0.78,
        wr, wg, wb, bark);
    i = plant_branch(dst, i, leanx, fork * 0.53, leanz, leanx * 0.5, fork, leanz * 0.5,
        radius * 0.78, radius * 0.62, wr, wg, wb, bark);
    if (style != 3) {
        for root in 0..5 {
            a: f32 = root as f32 * 1.256637 + turn;
            i = plant_branch(dst, i, cos_f32(a) * 0.43, 0.025, sin_f32(a) * 0.43,
                leanx * 0.2, 0.35, leanz * 0.2, radius * 0.23, radius * 0.55, wr,
                wg, wb, bark);
        }
    }
    if (style == 4) {
        // Retain a tapering pine silhouette without identical radial whorls.
        // All variation is seeded at mesh creation, so it survives save/load
        // and adds neither frame-time work nor new instance/mesh storage.
        tipx: f32 = cos_f32(turn + 0.65) * (0.16 + plant_random(seed + 311) * 0.09);
        tipz: f32 = sin_f32(turn + 0.65) * (0.16 + plant_random(seed + 311) * 0.09);
        midx: f32 = leanx * 0.25 + tipx * 0.35;
        midz: f32 = leanz * 0.25 + tipz * 0.35;
        i = plant_branch(dst, i, leanx * 0.5, fork, leanz * 0.5, midx, 2.12, midz,
            0.09, 0.043, wr, wg, wb, bark);
        i = plant_branch(dst, i, midx, 2.12, midz, tipx, 2.98, tipz, 0.043, 0.008,
            wr, wg, wb, bark);
        for tier in 0..4 {
            base_reach: f32 = 1.40 - tier as f32 * 0.29;
            base_y: f32 = 1.20 + tier as f32 * 0.43;
            count: int = 6 + (seed + tier) % 2;
            rotation: f32 = turn + tier as f32 * 0.37 + plant_random(seed * 43 + tier + 201) * 0.65;
            for limb in 0..count {
                key: int = seed * 137 + tier * 29 + limb * 11 + 401;
                a: f32 = limb as f32 * 6.2831853 / count as f32 + rotation + (plant_random(key) - 0.5) * 0.38;
                reach: f32 = base_reach * (0.74 + plant_random(key + 1) * 0.32);
                // A few shorter boughs create gaps rather than another perfect cone.
                if ((limb + tier + seed) % 5 == 0) reach = reach * 0.73;
                cy: f32 = base_y + (plant_random(key + 2) - 0.5) * 0.25;
                attach_y: f32 = cy + 0.22;
                t: f32 = (attach_y - fork) / (2.12 - fork);
                ox: f32 = leanx * 0.5 + (midx - leanx * 0.5) * t;
                oz: f32 = leanz * 0.5 + (midz - leanz * 0.5) * t;
                if (attach_y > 2.12) {
                    t = (attach_y - 2.12) / (2.98 - 2.12);
                    ox = midx + (tipx - midx) * t;
                    oz = midz + (tipz - midz) * t;
                }
                x: f32 = cos_f32(a) * reach;
                z: f32 = sin_f32(a) * reach;
                i = plant_branch(dst, i, ox, attach_y, oz, ox + x, cy, oz + z, 0.044,
                    0.009, wr, wg, wb, bark);
                for spray in 0..3 {
                    variation: f32 = plant_random(key + spray + 3);
                    offset: f32 = (spray - 1) as f32 * 0.40 + (variation - 0.5) * 0.24;
                    i = plant_needles(dst, i, ox + x * 0.22, cy - 0.06 * variation,
                        oz + z * 0.22, a + offset, reach * (0.69 + variation * 0.16),
                        (0.12 + reach * 0.09) * (0.8 + variation * 0.35), red, green,
                        blue, key + spray);
                }
            }
        }
        for tip in 0..5 {
            a: f32 = tip as f32 * 1.256637 + turn + (plant_random(seed * 17 + tip + 91) - 0.5) * 0.4;
            cy: f32 = 2.76;
            if (tip != 0) cy = cy - plant_random(seed * 11 + tip + 93) * 0.07;
            i = plant_needles(dst, i, tipx, cy, tipz, a, 0.18 + plant_random(seed * 13 + tip + 97) * 0.14,
                0.085, red, green, blue, seed + tip);
        }
        return i;
    }
    if (style == 3) {
        // Slender white forks remain exposed between small, airy leaf sprays.
        for limb in 0..7 {
            a: f32 = limb as f32 * 2.39996 + turn;
            cy: f32 = 1.70 + limb as f32 * 0.145;
            x: f32 = cos_f32(a) * 0.30;
            z: f32 = sin_f32(a) * 0.30;
            i = plant_branch(dst, i, leanx * 0.5, fork, leanz * 0.5, x * 0.6, cy - 0.20,
                z * 0.6, 0.052, 0.022, wr, wg, wb, bark);
            i = plant_branch(dst, i, x * 0.6, cy - 0.20, z * 0.6, x, cy, z, 0.022,
                0.007, wr, wg, wb, bark);
            i = plant_crown(dst, i, x, cy, z, 0.27, 0.25, 0.25, red, green, blue,
                h, seed * 31 + limb);
        }
        return plant_crown(dst, i, leanx * 0.4, 2.76, leanz * 0.4, 0.31, 0.24, 0.29,
            red, green, blue, h, seed + 57);
    }
    // Oaks spread on crooked forks. Crown clusters overlap across the collision
    // grid, with varied sizes and heights; the walkable support stays invisible.
    branches: int = 5;
    reach: f32 = 0.94;
    if (style == 2) {
        branches = 8;
        reach = 1.28;
    }
    for limb in 0..branches {
        a: f32 = limb as f32 * 6.2831853 / branches as f32 + turn;
        distance: f32 = reach * (0.85 + plant_random(seed * 19 + limb) * 0.15);
        x: f32 = cos_f32(a) * distance;
        z: f32 = sin_f32(a) * distance;
        midy: f32 = h - 0.85 + plant_random(seed * 13 + limb) * 0.13;
        cy: f32 = h - 0.42 - plant_random(seed * 11 + limb) * 0.10;
        i = plant_branch(dst, i, leanx * 0.5, fork, leanz * 0.5, x * 0.56, midy, z * 0.56,
            radius * 0.63, 0.062, wr, wg, wb, bark);
        i = plant_branch(dst, i, x * 0.56, midy, z * 0.56, x, cy, z, 0.062, 0.018,
            wr, wg, wb, bark);
        i = plant_branch(dst, i, x * 0.56, midy, z * 0.56, x * 0.86 - z * 0.17, cy - 0.1,
            z * 0.86 + x * 0.17, 0.036, 0.008, wr, wg, wb, bark);
        size: f32 = 0.46 + plant_random(seed * 7 + limb) * 0.13;
        if (style == 2) size = size + 0.10;
        i = plant_crown(dst, i, x, cy, z, size, 0.42, size * 0.93, red, green, blue,
            h, seed * 29 + limb);
    }
    for inner in 0..3 {
        a: f32 = inner as f32 * 2.094395 + turn;
        cy: f32 = h - 0.36 - inner as f32 * 0.035;
        i = plant_crown(dst, i, cos_f32(a) * 0.34, cy, sin_f32(a) * 0.34, 0.59, 0.36,
            0.55, red * 1.03, green * 1.03, blue, h, seed * 37 + inner + 49);
    }
    i;
}

new_plant_render(): *PlantRender@new {
    prog: int = link_program(plant_vs(), plant_fs(), "nrm");
    u: []int = [glGetUniformLocation(prog, "vp"), glGetUniformLocation(prog, "light_vp"),
        glGetUniformLocation(prog, "time"), glGetUniformLocation(prog, "pass"), glGetUniformLocation(prog,
        "lamp_origin"), glGetUniformLocation(prog, "camera"), glGetUniformLocation(prog,
        "actor"), glGetUniformLocation(prog, "wind_map"), glGetUniformLocation(prog,
        "wind_origin"), glGetUniformLocation(prog, "wind_on")];
    glUseProgram(prog);
    glUniform1i(glGetUniformLocation(prog, "shadow_map"), 0);
    glUniform1i(glGetUniformLocation(prog, "lamp_map"), 2);
    glUniform1i(u[7], 5);
    ids: []u32 = new u32[2](0u32);
    glGenBuffers(2, ids);
    starts: []int = new int[20](0);
    sizes: []int = new int[20](0);
    glBindBuffer(34962, ids[0]);
    region {
        storage: []f32 = new f32[20 * PLANT_MESH_FLOATS](0.0);
        glBufferData(34962, 20 * PLANT_MESH_FLOATS * 4, storage, 35044);
        scratch: []f32 = new f32[PLANT_MESH_FLOATS](0.0);
        for mesh in 0..20 {
            count: int = fill_plant_mesh(scratch, mesh / 4, mesh % 4);
            if (count > PLANT_MESH_FLOATS) die("plant mesh capacity");
            starts[mesh] = mesh * PLANT_MESH_FLOATS / 10;
            sizes[mesh] = count / 10;
            glBufferSubData(34962, mesh * PLANT_MESH_FLOATS * 4, count * 4, scratch);
        }
    }
    data: []f32 = new f32[LEVEL_MAX_BLOCKS * 4](0.0);
    glBindBuffer(34962, ids[1]);
    glBufferData(34962, LEVEL_MAX_BLOCKS * 16, data, 35048);
    new PlantRender {
        prog: prog,
        u: u,
        mesh: ids[0],
        instances: ids[1],
        starts: starts,
        sizes: sizes,
        counts: new int[20](0),
        offsets: new int[20](0),
        data: data,
        key: 0,
        ready: false,
        total: 0,
        wind_tex: 0u32,
        wind_x: 0.0,
        wind_z: 0.0,
        wind_ready: false,
        wind_start_ms: 0
    };
}

set_plant_wind(p: *PlantRender, wind: *WindField) {
    p.wind_tex = wind.tex;
    p.wind_x = wind.origin_x as f32;
    p.wind_z = wind.origin_z as f32;
    p.wind_ready = wind.ready;
    p.wind_start_ms = wind.start_ms;
}

prepare_plants(
    p: *PlantRender,
    hist: []Block,
    off: int,
    n: int,
    bounds: []f32
) {
    key: int = 1;
    for i in 0..n {
        b: Block = hist[off + i];
        if (plant_block(b) && shadow_cell(b.column, b.row, bounds, 5.0)) {
            key = key * 31 + b.column;
            key = key * 31 + b.row;
            key = key * 31 + b.shape;
        }
    }
    if (p.ready && key == p.key) return;
    p.key = key;
    p.ready = true;
    p.total = 0;
    for mesh in 0..20 p.counts[mesh] = 0;
    for i in 0..n {
        b: Block = hist[off + i];
        if (plant_block(b) && shadow_cell(b.column, b.row, bounds, 5.0)) {
            mesh: int = plant_style(b) * 4 + plant_seed(b);
            p.counts[mesh] = p.counts[mesh] + 1;
        }
    }
    for mesh in 0..20 {
        p.offsets[mesh] = p.total;
        p.total = p.total + p.counts[mesh];
        p.counts[mesh] = 0;
    }
    for i in 0..n {
        b: Block = hist[off + i];
        if (plant_block(b) && shadow_cell(b.column, b.row, bounds, 5.0)) {
            mesh: int = plant_style(b) * 4 + plant_seed(b);
            at: int = (p.offsets[mesh] + p.counts[mesh]) * 4;
            p.data[at] = b.column as f32 + 0.5;
            p.data[at + 1] = b.layer as f32;
            p.data[at + 2] = b.row as f32 + 0.5;
            p.data[at + 3] = (b.column * 13 + b.row * 7) as f32;
            p.counts[mesh] = p.counts[mesh] + 1;
        }
    }
    if (p.total > 0) {
        glBindBuffer(34962, p.instances);
        glBufferSubData(34962, 0, p.total * 16, p.data);
    }
}

draw_plants(
    p: *PlantRender,
    restore: int,
    vp: []f32,
    lvp: []f32,
    light: *LampLight,
    cx: f32,
    cy: f32,
    cz: f32,
    px: f32,
    py: f32,
    pz: f32,
    pass: int
) {
    if (p.total == 0) return;
    glUseProgram(p.prog);
    glUniformMatrix4fv(p.u[0], 1, 0, vp);
    glUniformMatrix4fv(p.u[1], 1, 0, lvp);
    clock: f32 = 0.0;
    if (p.wind_start_ms != 0) clock = (mono_ms() - p.wind_start_ms) as f32 * 0.001;
    glUniform1f(p.u[2], clock);
    glUniform1i(p.u[3], pass);
    glUniform2f(p.u[4], light.x as f32, light.z as f32);
    glUniform3f(p.u[5], cx, cy, cz);
    glUniform3f(p.u[6], px, py, pz);
    glUniform2f(p.u[8], p.wind_x, p.wind_z);
    if (p.wind_ready) glUniform1f(p.u[9], 1.0); else glUniform1f(p.u[9], 0.0);
    glActiveTexture(33989);
    glBindTexture(3553, p.wind_tex);
    glActiveTexture(33984);
    glBindBuffer(34962, p.mesh);
    glVertexAttribPointer(0, 3, 5126, 0, 40, 0);
    glVertexAttribPointer(1, 3, 5126, 0, 40, 12);
    glVertexAttribPointer(2, 4, 5126, 0, 40, 24);
    for i in 0..4 glEnableVertexAttribArray(i);
    glBindBuffer(34962, p.instances);
    glVertexAttribDivisor(3, 1);
    for mesh in 0..20 {
        if (p.counts[mesh] > 0) {
            glVertexAttribPointer(3, 4, 5126, 0, 16, p.offsets[mesh] * 16);
            glDrawArraysInstanced(4, p.starts[mesh], p.sizes[mesh], p.counts[mesh]);
        }
    }
    glVertexAttribDivisor(3, 0);
    glDisableVertexAttribArray(3);
    glDisableVertexAttribArray(2);
    glUseProgram(restore);
}

extern glVertexAttrib4f(
    index: int,
    x: f32,
    y: f32,
    z: f32,
    w: f32
): void;

// The palette and placement cursor use the same cached meshes as the world.
// A constant instance attribute avoids uploads or allocations for a preview.
draw_plant_icon(
    p: *PlantRender,
    restore: int,
    vp: []f32,
    x: f32,
    z: f32,
    style: int,
    cx: f32,
    cy: f32,
    cz: f32
) {
    glUseProgram(p.prog);
    glUniformMatrix4fv(p.u[0], 1, 0, vp);
    glUniform1f(p.u[2], 0.0);
    glUniform1i(p.u[3], 3);
    glUniform3f(p.u[5], cx, cy, cz);
    glUniform1f(p.u[9], 0.0);
    glBindBuffer(34962, p.mesh);
    glVertexAttribPointer(0, 3, 5126, 0, 40, 0);
    glVertexAttribPointer(1, 3, 5126, 0, 40, 12);
    glVertexAttribPointer(2, 4, 5126, 0, 40, 24);
    for attribute in 0..3 glEnableVertexAttribArray(attribute);
    glDisableVertexAttribArray(3);
    glVertexAttrib4f(3, x, 0.0, z, 0.0);
    glDrawArrays(4, p.starts[style * 4], p.sizes[style * 4]);
    glDisableVertexAttribArray(2);
    glUseProgram(restore);
}
