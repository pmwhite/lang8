tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

extern mkdir(path: str, mode: int): int;

write_fixture(path: []i8, contents: []i8) raises IoError, InvalidRange {
    fd: int = open_path(path, LEVEL_O_WRONLY + LEVEL_O_CREAT + LEVEL_O_TRUNC, LEVEL_MODE);
    if (fd < 0) die("cannot create legacy placement fixture");
    n: int = write_some(fd, contents, 0, len(contents));
    close(fd);
    if (n != len(contents)) die("cannot write legacy placement fixture")
}

main() raises IoError, InvalidRange, IndexOutOfBounds: int {
    mkdir(".build/levels", 493);
    write_fixture(".build/levels/legacy-one.txt", "room 0 0 2 2 One\n");
    write_fixture(".build/levels/legacy-many.txt", """
room 0 0 2 2 One
room 5 0 7 2 Two
""");
    write_fixture(".build/legacy-one-world.txt", """
world
place legacy-one 0 0 0
""");
    write_fixture(".build/legacy-many-world.txt", """
world
place legacy-many 0 0 0
""");
    state: *LevelState = new_level_state();
    world: *WorldState = new_world_state();
    if (load_world_state(".build/legacy-one-world.txt", world, state) < 0) die("one-room legacy placement failed");
    if (load_world_state(".build/legacy-many-world.txt", world, state) >= 0) die("multi-room legacy placement was accepted");
    print("legacy place room boundary passed");
    0
    //% expect: "legacy place room boundary passed\n"
}
