tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

extern mkdir(path: str, mode: int): int;

legacy_write_fixture(path: []i8, contents: []i8) raises IoError {
    fd: int = open_path(path, LEVEL_O_WRONLY + LEVEL_O_CREAT + LEVEL_O_TRUNC, LEVEL_MODE);
    if (fd < 0) die("cannot create legacy placement fixture");
    n: int = write_some(fd, contents, 0, len(contents));
    close(fd);
    if (n != len(contents)) die("cannot write legacy placement fixture")
}

legacy_show_load(label: str, result: int) raises IoError {
    write(1, label);
    if (result >= 0) write(1, ": accepted, result ") else write(1, ": rejected, result ");
    write_int(1, result);
    write(1, "\n")
}

test "legacy place accepts only single-room levels" {
    mkdir(".build/levels", 493);
    legacy_write_fixture(".build/levels/legacy-one.txt", "room 0 0 2 2 One\n");
    legacy_write_fixture(".build/levels/legacy-many.txt", """
room 0 0 2 2 One
room 5 0 7 2 Two
""");
    legacy_write_fixture(".build/legacy-one-world.txt", """
world
place legacy-one 0 0 0
""");
    legacy_write_fixture(".build/legacy-many-world.txt", """
world
place legacy-many 0 0 0
""");
    state: *LevelState = new_level_state();
    world: *WorldState = new_world_state();
    legacy_show_load("place a one-room level", load_world_state(".build/legacy-one-world.txt",
        world, state));
    expect {|
        place a one-room level: accepted, result 0
    |}
    legacy_show_load("place a two-room level", load_world_state(".build/legacy-many-world.txt",
        world, state));
    expect {|
        place a two-room level: rejected, result -1
    |}
}
