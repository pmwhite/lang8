tag block_game;
use_tag gl;

// A 32x32-tile resident basin, sampled at eight cells per block. No particles,
// surface extraction, fullscreen filtering or per-frame allocations.
type HeightWater = {
    supported: bool; disabled: bool; ready: bool; initialize: bool; splash: bool;
    report: bool; stress: bool; initial_splash: bool;
    programs: []int; u: []int; buffers: []u32; textures: []u32; fbo: u32;
    wet: []f32; mask: []i8; tiles: []f32; bodies: []f32; zeros: []f32;
    x: int; z: int; key: int; cells: int; nbodies: int; current: int;
    visible: bool; last_us: int; debt: f32; steps: int; dropped_us: int; frame: int;
    label: []i8; ripple_time: f32;
};

new_height_water(main: int): *HeightWater@new {
    version: []i32=new i32[2](0i32);
    glGetIntegerv(33307,version); glGetIntegerv(33308,&version[1]);
    supported: bool=version[0]>4i32 || version[0]==4i32 && version[1]>=3i32;
    if(supported) { glGetIntegerv(37078,version); supported=version[0]>=4i32; }
    programs: []int=new int[4](0); u: []int=new int[24](-1);
    buffers: []u32=new u32[7](0u32); textures: []u32=new u32[2](0u32);
    fbos: []u32=new u32[1](0u32);
    zeros: []f32=new f32[512*512*4](0.0);
    mask: []i8=new i8[1024](0i8);
    glGenTextures(2,textures); glActiveTexture(33989); glBindTexture(3553,textures[0]);
    glTexParameteri(3553,10241,9728); glTexParameteri(3553,10240,9728);
    glTexParameteri(3553,10242,33071); glTexParameteri(3553,10243,33071);
    glTexImage2D(3553,0,6409,32,32,0,6409,5121,mask);
    if(supported) {
        shader: int=compile_shader(37305,height_water_compute());
        programs[0]=glCreateProgram(); glAttachShader(programs[0],shader); glLinkProgram(programs[0]);
        ok: []i32=new i32[1](0i32); glGetProgramiv(programs[0],35714,ok);
        if(ok[0]==0i32) { die("height water compute link failed"); }
        programs[1]=link_program(height_water_solid_vs(),height_water_solid_fs(),"nrm");
        programs[2]=link_program(height_water_vs(),height_water_fs(),"nrm");
        ripple_shader: int=compile_shader(37305,height_water_ripple_compute());
        programs[3]=glCreateProgram(); glAttachShader(programs[3],ripple_shader); glLinkProgram(programs[3]);
        glGetProgramiv(programs[3],35714,ok);
        if(ok[0]==0i32) { die("water ripple compute link failed"); }
        glUseProgram(programs[3]); glUniform1i(glGetUniformLocation(programs[3],"wind_map"),7);
        u[19]=glGetUniformLocation(programs[3],"stage");
        u[20]=glGetUniformLocation(programs[3],"origin");
        u[21]=glGetUniformLocation(programs[3],"wind_origin");
        u[22]=glGetUniformLocation(programs[3],"wind_time");
        u[23]=glGetUniformLocation(programs[3],"wind_on");
        glGenBuffers(7,buffers);
        for i in 0..7 {
            size: int=256*256*4;
            if(i>=5) { size=512*512*4; }
            if(i==2) { size=1024; } if(i==3) { size=4096; } if(i==4) { size=(LEVEL_MAX_BLOCKS+1)*8; }
            glBindBuffer(37074,buffers[i]); glBufferData(37074,size*4,zeros,35048);
        }
        glActiveTexture(33990); glBindTexture(3553,textures[1]);
        glTexParameteri(3553,10241,9728); glTexParameteri(3553,10240,9728);
        glTexParameteri(3553,10242,33071); glTexParameteri(3553,10243,33071);
        glTexImage2D(3553,0,33326,256,256,0,6403,5126,null);
        glGenFramebuffers(1,fbos); glBindFramebuffer(36160,fbos[0]);
        glFramebufferTexture2D(36160,36064,3553,textures[1],0); glDrawBuffer(36064); glReadBuffer(36064);
        if(glCheckFramebufferStatus(36160)!=36053) { die("height water displacement target incomplete"); }
        glBindFramebuffer(36160,0u32); glDrawBuffer(1029); glReadBuffer(1029);
        glUseProgram(programs[0]); glUniform1i(glGetUniformLocation(programs[0],"solids"),6);
        glUniform1i(glGetUniformLocation(programs[0],"wind_map"),7);
        u[0]=glGetUniformLocation(programs[0],"stage"); u[1]=glGetUniformLocation(programs[0],"origin");
        u[2]=glGetUniformLocation(programs[0],"impulse");
        u[16]=glGetUniformLocation(programs[0],"wind_origin");
        u[17]=glGetUniformLocation(programs[0],"wind_time");
        u[18]=glGetUniformLocation(programs[0],"wind_on");
        u[3]=glGetUniformLocation(programs[1],"origin");
        glUseProgram(programs[2]);
        glUniform1i(glGetUniformLocation(programs[2],"shadow_map"),0);
        glUniform1i(glGetUniformLocation(programs[2],"lamp_map"),2);
        glUniform1i(glGetUniformLocation(programs[2],"reflection_map"),4);
        u[4]=glGetUniformLocation(programs[2],"vp"); u[5]=glGetUniformLocation(programs[2],"origin");
        u[6]=glGetUniformLocation(programs[2],"bed"); u[7]=glGetUniformLocation(programs[2],"camera");
        u[8]=glGetUniformLocation(programs[2],"light_vp"); u[9]=glGetUniformLocation(programs[2],"lamp_origin");
        u[10]=glGetUniformLocation(programs[2],"reflection_on");
        u[11]=glGetUniformLocation(programs[2],"spec_lamps[0]"); u[12]=glGetUniformLocation(programs[2],"spec_lamps[1]");
        u[13]=glGetUniformLocation(programs[2],"spec_lamps[2]"); u[14]=glGetUniformLocation(programs[2],"spec_lamps[3]");
    }
    glUseProgram(main); glUniform1i(glGetUniformLocation(main,"fluid_mask"),5);
    u[15]=glGetUniformLocation(main,"fluid_origin");
    glActiveTexture(33984);
    new HeightWater { supported:supported,disabled:getenv("L8_WATER_STATIC")!=null,ready:false,initialize:true,splash:false,
        report:getenv("L8_WATER_STATS")!=null,stress:getenv("L8_WATER_STRESS")!=null,initial_splash:getenv("L8_WATER_SPLASH")!=null,
        programs:programs,u:u,buffers:buffers,textures:textures,fbo:fbos[0],zeros:zeros,mask:mask,
        wet:new f32[1024](0.0),tiles:new f32[4096](0.0),bodies:new f32[(LEVEL_MAX_BLOCKS+1)*8](0.0),
        x:0,z:0,key:0,cells:0,nbodies:0,current:0,visible:false,last_us:0,debt:0.0,steps:0,dropped_us:0,frame:0,label:new i8[160](0i8),ripple_time:0.0 };
}

toggle_height_water(w: *HeightWater) { w.disabled=!w.disabled; w.last_us=0; w.debt=0.0; }
request_height_splash(w: *HeightWater) { w.disabled=false; w.splash=true; }

height_water_bind(w: *HeightWater) {
    glBindBufferBase(37074,0,w.buffers[w.current]); glBindBufferBase(37074,1,w.buffers[1-w.current]);
    for i in 2..5 { glBindBufferBase(37074,i,w.buffers[i]); }
    glBindBufferBase(37074,5,w.buffers[5]);
}

height_water_terrain(w: *HeightWater,ground: []GroundCell,n: int,cx: int,cz: int,vp: []f32) {
    key: int=0; minx: int=999999; minz: int=999999; maxx: int=0-999999; maxz: int=0-999999;
    nearest: int=999999; nx: int=cx; nz: int=cz; outside: bool=!w.ready; w.visible=false;
    for i in 0..n { c: GroundCell=ground[i]; if(c.style==GROUND_WATER) {
        key=key*31+c.column*719+c.row*131+1;
        if(grass_cell_in_view(vp,c.column,c.row)!=0) {
            w.visible=true;
            if(c.column<w.x || c.column>=w.x+32 || c.row<w.z || c.row>=w.z+32) { outside=true; }
            if(c.column<minx) { minx=c.column; } if(c.column>maxx) { maxx=c.column; }
            if(c.row<minz) { minz=c.row; } if(c.row>maxz) { maxz=c.row; }
            dx: int=c.column-cx; dz: int=c.row-cz; if(dx<0) { dx=0-dx; } if(dz<0) { dz=0-dz; }
            if(dx+dz<nearest) { nearest=dx+dz; nx=c.column; nz=c.row; }
        }
    } }
    x: int=w.x; z: int=w.z;
    if(outside) {
        if(minx<=maxx && maxx-minx<30 && maxz-minz<30) { nx=(minx+maxx+1)/2; nz=(minz+maxz+1)/2; }
        x=nx-16; z=nz-16;
    }
    if(w.ready && key==w.key && x==w.x && z==w.z) { return; }
    w.x=x; w.z=z; w.key=key; w.cells=0; w.current=0; w.debt=0.0; w.last_us=0; w.steps=0; w.initialize=true;
    for i in 0..1024 { w.wet[i]=0.0; w.mask[i]=0i8; }
    for i in 0..n { c: GroundCell=ground[i]; tx: int=c.column-x; tz: int=c.row-z;
        if(c.style==GROUND_WATER && tx>=0 && tx<32 && tz>=0 && tz<32 && w.wet[tz*32+tx]==0.0) {
            w.wet[tz*32+tx]=1.0; w.mask[tz*32+tx]=127i8;
            w.tiles[w.cells*4]=tx as f32; w.tiles[w.cells*4+1]=tz as f32; w.cells=w.cells+1;
        }
    }
    for i in 0..2 { glBindBuffer(37074,w.buffers[i]); glBufferSubData(37074,0,256*256*16,w.zeros); }
    for i in 5..7 { glBindBuffer(37074,w.buffers[i]); glBufferSubData(37074,0,512*512*16,w.zeros); }
    glBindBuffer(37074,w.buffers[2]); glBufferSubData(37074,0,4096,w.wet);
    glBindBuffer(37074,w.buffers[3]); glBufferSubData(37074,0,w.cells*16,w.tiles);
    glActiveTexture(33989); glBindTexture(3553,w.textures[0]); glTexSubImage2D(3553,0,0,0,32,32,6409,5121,w.mask);
    glActiveTexture(33984); w.ready=true;
    if(w.initial_splash) { w.splash=true; }
}

height_water_body(w: *HeightWater,x: f32,y: f32,z: f32,radius: f32,half_height: f32,ramp: int) {
    if(x+radius<w.x as f32 || x-radius>(w.x+32) as f32 || z+radius<w.z as f32 || z-radius>(w.z+32) as f32 || y-half_height>=0.0) { return; }
    at: int=w.nbodies*8;
    w.bodies[at]=x; w.bodies[at+1]=y; w.bodies[at+2]=z; w.bodies[at+3]=radius;
    w.bodies[at+4]=half_height; w.bodies[at+5]=ramp as f32; w.bodies[at+6]=0.0; w.bodies[at+7]=0.0;
    w.nbodies=w.nbodies+1;
}

height_water_displacement(w: *HeightWater) {
    glBindBuffer(37074,w.buffers[4]); glBufferSubData(37074,0,w.nbodies*32,w.bodies); height_water_bind(w);
    glBindFramebuffer(36160,w.fbo); glDrawBuffer(36064); glReadBuffer(36064);
    glViewport(0,0,256,256); glClearColor(0.0,0.0,0.0,0.0); glClear(16384);
    glDisable(2929); glDepthMask(0); glEnable(3042); glBlendFunc(1,1);
    glUseProgram(w.programs[1]); glUniform2f(w.u[3],w.x as f32,w.z as f32);
    glDrawArraysInstanced(4,0,6,w.nbodies);
    glDisable(3042); glEnable(2929); glDepthMask(1);
    glBindFramebuffer(36160,0u32); glDrawBuffer(1029); glReadBuffer(1029); glViewport(0,0,1200,720);
    glClearColor(0.07,0.06,0.055,1.0);
    glActiveTexture(33990); glBindTexture(3553,w.textures[1]); glActiveTexture(33984);
}

height_water_step(w: *HeightWater,ix: f32,iz: f32,strength: f32) {
    glUseProgram(w.programs[0]); glUniform2f(w.u[1],w.x as f32,w.z as f32);
    initial: f32=0.0; if(w.initialize) { initial=1.0; }
    glUniform4f(w.u[2],ix,iz,strength,initial);
    for stage in 0..3 {
        height_water_bind(w); glUniform1i(w.u[0],stage); glDispatchCompute(512,1,1); glMemoryBarrier(8192);
        w.current=1-w.current;
    }
    height_water_ripple_step(w);
    w.initialize=false; w.steps=w.steps+1;
}

height_water_ripple_step(w: *HeightWater) {
    glUseProgram(w.programs[3]);
    glUniform2f(w.u[20],w.x as f32,w.z as f32);
    glUniform1f(w.u[22],w.ripple_time);
    glBindBufferBase(37074,2,w.buffers[2]);
    for stage in 0..2 {
        glBindBufferBase(37074,0,w.buffers[5+stage]);
        glBindBufferBase(37074,1,w.buffers[6-stage]);
        glUniform1i(w.u[19],stage); glDispatchCompute(2048,1,1); glMemoryBarrier(8192);
    }
    w.ripple_time=w.ripple_time+0.008333334;
}

height_water_wind(w: *HeightWater,wind: *WindField,now: int) {
    glUseProgram(w.programs[0]);
    glUniform2f(w.u[16],wind.origin_x as f32,wind.origin_z as f32);
    glUniform1f(w.u[17],wind_visual_time(wind,now));
    glUniform1f(w.u[18],1.0);
    glUseProgram(w.programs[3]);
    glUniform2f(w.u[21],wind.origin_x as f32,wind.origin_z as f32);
    glUniform1f(w.u[23],1.0);
    w.ripple_time=wind_visual_time(wind,now)-w.debt;
    glActiveTexture(33991); glBindTexture(3553,wind.tex); glActiveTexture(33984);
}

prepare_height_water(w: *HeightWater,main: int,wind: *WindField,ground: []GroundCell,nground: int,cx: int,cz: int,
    hist: []Block,foff: int,toff: int,n: int,ids: []int,bt: []f32,t: f32,
    px: f32,py: f32,pz: f32,player: int,vp: []f32) {
    if(!w.supported) { return; }
    height_water_terrain(w,ground,nground,cx,cz,vp);
    now: int=mono_us(); elapsed: f32=0.0;
    if(w.last_us!=0) { elapsed=(now-w.last_us) as f32*0.000001; } w.last_us=now;
    glUseProgram(main); glUniform2f(w.u[15],w.x as f32,w.z as f32);
    if(!w.visible || w.cells==0 || w.disabled) { w.debt=0.0; return; }
    w.nbodies=0;
    for i in 0..n {
        b: Block=hist[toff+i]; x: f32=b.column as f32; y: f32=b.layer as f32+0.5; z: f32=b.row as f32;
        if(!parked_block(b)) {
            old: int=hist_id_at(ids,hist,foff,n,b.id);
            if(foff!=toff && old>=0) {
                a: Block=hist[foff+old]; phase: f32=block_anim_t(bt,i,t);
                x=lerp(a.column as f32,x,phase); z=lerp(a.row as f32,z,phase);
                y=anim_y(a.layer as f32+0.5,y,x,z,a.column,a.row,b.column,b.row,0.0,0.0,0.0,0.0,cargo_sit(a),cargo_sit(b),phase);
            }
            ramp: int=b.ramp; if(b.mounted!=0) { ramp=0; }
            height_water_body(w,x+0.5,y,z+0.5,0.46,0.5,ramp);
        }
    }
    if(player!=0) { height_water_body(w,px,py,pz,0.43,0.55,0); }
    height_water_displacement(w);
    if(elapsed<0.0) { elapsed=0.0; } w.debt=w.debt+elapsed;
    if(w.debt>0.25) { w.dropped_us=w.dropped_us+((w.debt-0.25)*1000000.0) as int; w.debt=0.25; }
    height_water_wind(w,wind,now/1000);
    ix: f32=px; iz: f32=pz;
    if(w.splash || w.stress) {
        best: f32=10000000.0;
        for i in 0..w.cells {
            x: f32=w.x as f32+w.tiles[i*4]+0.5; z: f32=w.z as f32+w.tiles[i*4+1]+0.5;
            distance: f32=(x-px)*(x-px)+(z-pz)*(z-pz);
            if(distance<best) { best=distance; ix=x; iz=z; }
        }
    }
    count: int=0;
    while(w.debt>=0.008333334 && count<16) {
        strength: f32=0.0;
        if(w.splash || w.stress && w.steps%60==0) { strength=1.5; w.splash=false; }
        height_water_step(w,ix,iz,strength); w.debt=w.debt-0.008333334; count=count+1;
    }
    glUseProgram(main); w.frame=w.frame+1;
    if(w.report && w.frame%120==0) {
        i: int=put_str(w.label,0,"Height water: cells="); i=put_int(w.label,i,w.cells);
        i=put_str(w.label,i," bodies="); i=put_int(w.label,i,w.nbodies);
        i=put_str(w.label,i," steps/dropped us="); i=put_int(w.label,i,w.steps);
        i=put_str(w.label,i,"/"); i=put_int(w.label,i,w.dropped_us); i=put_str(w.label,i,"\n"); write(2,w.label,i);
    }
}

draw_height_water(w: *HeightWater,main: int,vp: []f32,lvp: []f32,cx: f32,cy: f32,cz: f32,
    material: *MaterialLight,light: *LampLight,lamps: []Lamp,bed: int) {
    if(!w.supported || !w.visible || w.cells==0) { return; }
    height_water_bind(w); glUseProgram(w.programs[2]); glUniformMatrix4fv(w.u[4],1,0,vp);
    glUniform2f(w.u[5],w.x as f32,w.z as f32);
    mode: int=bed; if(bed==0 && w.disabled) { mode=0-1; }
    glUniform1i(w.u[6],mode); glUniform3f(w.u[7],cx,cy,cz); glUniformMatrix4fv(w.u[8],1,0,lvp);
    glUniform2f(w.u[9],light.x as f32,light.z as f32);
    reflecting: f32=0.0; if(material.reflection_ready) { reflecting=1.0; } glUniform1f(w.u[10],reflecting);
    for i in 0..4 { id: int=material.nearest[i];
        if(id<0) { glUniform3f(w.u[11+i],0.0,0.0-100.0,0.0); }
        else { lamp: Lamp=lamps[id]; height: f32=0.38; if(lamp.style==1) { height=1.85; }
            glUniform3f(w.u[11+i],lamp.column as f32+0.5,height,lamp.row as f32+0.5); }
    }
    if(bed!=0) { glDrawArraysInstanced(4,0,30,w.cells); }
    else {
        glEnable(3042); glBlendFunc(770,771); glDepthMask(0);
        glDrawArraysInstanced(4,0,384,w.cells);
        glDepthMask(1); glDisable(3042);
    }
    glUseProgram(main); glActiveTexture(33984);
}
