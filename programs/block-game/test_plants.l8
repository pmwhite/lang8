tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

plants_show(label: str, value: int) raises IoError {
    write(1, label);
    write(1, ": ");
    write_int(1, value);
    write(1, "\n")
}

plants_show_bool(label: str, value: bool) raises IoError {
    write(1, label);
    if (value) write(1, ": true\n") else write(1, ": false\n")
}

plants_show_pos(label: str, p: int) raises IoError {
    write(1, label);
    write(1, ": column ");
    write_int(1, pos_col(p));
    write(1, ", layer ");
    write_int(1, pos_layer(p));
    write(1, "\n")
}

plants_show_plant(label: str, b: Block) raises IoError {
    write(1, label);
    write(1, ": ");
    if (plant_block(b)) {
        write_bytes(1, plant_name(plant_style(b)));
        write(1, ", seed ");
        write_int(1, plant_seed(b));
        write(1, "\n")
    } else write(1, "not a plant\n")
}

// A 24x18 room with a plant of the given species rooted at (4, 4).
plants_level(style: int): *LevelState@new {
    s: *LevelState = new_level_state();
    level_set_room_count(s, set_room_size(s.rooms, s.titles, 0, 24, 18));
    level_set_block_count(s, plant_edit(s.blocks, 0, s.bricks, 0, s.ground, 0, 4,
        4, style, false));
    s
}

// A broad oak at (4, 4), whose crown spreads over the neighboring cells at
// layer 2, holding a cube dropped onto its crown at (3, 4).
plants_oak_with_cargo(): *LevelState@new {
    s: *LevelState = plants_level(2);
    plants_add_cargo(s);
    s
}

// Drop a cube at (3, 4) from layer 5 and let it fall.
plants_add_cargo(s: *LevelState) {
    level_set_block_count(s, add_block_at(s.blocks, s.nblocks, 3, 4, 5, 0, 0));
    apply_level_gravity(s)
}

// Assign rewind homes for the level, then step the player one cell east.
plants_walk_east(
    s: *LevelState,
    column: int,
    row: int,
    layer: int
): int {
    home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    ids: *RoomBlockIds = new_room_block_ids();
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    counts: []RewindCount = new RewindCount[LEVEL_MAX_ROOMS](RewindCount { value: 1 });
    cursors: []RewindCursor = new RewindCursor[LEVEL_MAX_ROOMS](RewindCursor { value: 0 });
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    snap: []int = new int[LEVEL_MAX_BLOCKS * REWIND_MAX](0);
    assign_block_homes(s.blocks, s.nblocks, s.rooms, s.nrooms, home, ids, widths);
    move_player(s.blocks, s.nblocks, home, s.nrooms, s.bricks, s.nbricks, s.ground,
        s.nground, column, row, layer, 1, 0, ids, widths, snap, counts, cursors, ghost)
}

// Each of these tables plants every species alone at (4, 4).
test "every plant species is solid from its root to its crown" {
    for style in 0..PLANT_STYLES {
        s: *LevelState = plants_level(style);
        height: int = plant_height(style);
        solid: int = 0;
        for y in 0..height {
            if (body_at_layer(s.blocks, s.nblocks, 4, 4, y) == 0) solid = solid + 1
        }
        write_bytes(1, plant_name(style));
        write(1, ": blocks ");
        write_int(1, s.nblocks);
        write(1, ", height ");
        write_int(1, height);
        write(1, ", solid layers ");
        write_int(1, solid);
        if (body_at_layer(s.blocks, s.nblocks, 4, 4, height) < 0) write(1, ", open above\n") else write(1,
            ", blocked above\n")
    }
    expect {|
        Hedge shrub: blocks 1, height 1, solid layers 1, open above
        Young oak: blocks 1, height 2, solid layers 2, open above
        Broad oak: blocks 1, height 3, solid layers 3, open above
        Birch: blocks 1, height 3, solid layers 3, open above
        Pine: blocks 1, height 3, solid layers 3, open above
    |}
}

test "plants have no room rewind home" {
    home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    ids: *RoomBlockIds = new_room_block_ids();
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    for style in 0..PLANT_STYLES {
        s: *LevelState = plants_level(style);
        assign_block_homes(s.blocks, s.nblocks, s.rooms, s.nrooms, home, ids, widths);
        write_bytes(1, plant_name(style));
        write(1, ": home ");
        write_int(1, home[0]);
        write(1, ", room width ");
        write_int(1, widths[0]);
        write(1, "\n")
    }
    expect {|
        Hedge shrub: home -1, room width 0
        Young oak: home -1, room width 0
        Broad oak: home -1, room width 0
        Birch: home -1, room width 0
        Pine: home -1, room width 0
    |}
}

test "plants cannot be pushed" {
    // The player walks east from (3, 4) into the plant.
    for style in 0..PLANT_STYLES {
        s: *LevelState = plants_level(style);
        p: int = plants_walk_east(s, 3, 4, 0);
        write_bytes(1, plant_name(style));
        write(1, ": player at column ");
        write_int(1, pos_col(p));
        write(1, ", plant at column ");
        write_int(1, s.blocks[0].column);
        write(1, "\n")
    }
    expect {|
        Hedge shrub: player at column 3, plant at column 4
        Young oak: player at column 3, plant at column 4
        Broad oak: player at column 3, plant at column 4
        Birch: player at column 3, plant at column 4
        Pine: player at column 3, plant at column 4
    |}
}

test "plants stay rooted under gravity" {
    for style in 0..PLANT_STYLES {
        s: *LevelState = plants_level(style);
        apply_level_gravity(s);
        write_bytes(1, plant_name(style));
        write(1, ": layer ");
        write_int(1, s.blocks[0].layer);
        write(1, "\n")
    }
    expect {|
        Hedge shrub: layer 0
        Young oak: layer 0
        Broad oak: layer 0
        Birch: layer 0
        Pine: layer 0
    |}
}

test "the broad oak canopy has headroom beneath and a walkable crown" {
    s: *LevelState = plants_level(2);
    write(1, "solid body at (3, 4) on layers 0, 1, 2:");
    for y in 0..3 {
        write(1, " ");
        write_int(1, body_at_layer(s.blocks, s.nblocks, 3, 4, y))
    }
    write(1, "\n");
    expect {|
        solid body at (3, 4) on layers 0, 1, 2: -1 -1 0
    |}
    plants_show("spawn layer at the root (4, 4)", plant_spawn_layer(s.blocks, s.nblocks,
        s.ground, 0, 4, 4));
    plants_show("spawn layer under the crown (3, 4)", plant_spawn_layer(s.blocks,
        s.nblocks, s.ground, 0, 3, 4));
    expect {|
        spawn layer at the root (4, 4): 3
        spawn layer under the crown (3, 4): 0
    |}
    plants_show_pos("walk east from (2, 4) on the ground", plants_walk_east(s, 2,
        4, 0));
    expect {|
        walk east from (2, 4) on the ground: column 3, layer 0
    |}
    plants_show_pos("walk east from (2, 4) at layer 3", plants_walk_east(s, 2, 4,
        3));
    expect {|
        walk east from (2, 4) at layer 3: column 3, layer 3
    |}
    plants_add_cargo(s);
    plants_show("cargo dropped at (3, 4) settles on layer", s.blocks[1].layer);
    expect {|
        cargo dropped at (3, 4) settles on layer: 3
    |}
    plants_show_bool("a birch can be planted at (3, 4)", plant_can_place(s.blocks,
        s.nblocks, s.bricks, 0, s.ground, 0, 3, 4, 3, 0 - 1));
    expect {|
        a birch can be planted at (3, 4): false
    |}
}

test "brushes keep a tree's soil and trunk" {
    s: *LevelState = plants_oak_with_cargo();
    result: BrushEdit = apply_level_brush_rect(s, 4, 4, 4, 4, Brush.Water, 0, false,
        true);
    plants_show_bool("water brush: result ground count matches", result.nground == s.nground);
    plants_show_bool("water brush: root cell is water", is_water(s.ground, s.nground,
        4, 4));
    expect {|
        water brush: result ground count matches: true
        water brush: root cell is water: false
    |}
    result = apply_level_brush_rect(s, 4, 4, 4, 4, Brush.Block, 0, true, true);
    plants_show_bool("block eraser: result ground count matches", result.nground == s.nground);
    plants_show("block eraser: plant at (4, 4)", plant_at(s.blocks, s.nblocks, 4,
        4));
    expect {|
        block eraser: result ground count matches: true
        block eraser: plant at (4, 4): 0
    |}
}

test "plant species and seed survive saving, loading and transforms" {
    s: *LevelState = plants_oak_with_cargo();
    world: *WorldState = new_world_state();
    world.names[0] = "grove";
    loaded: *LevelState = new_level_state();
    xy: []int = new int[2](0);
    plants_show_plant("original", s.blocks[0]);
    expect {|
        original: Broad oak, seed 0
    |}
    plants_show("save level", save_level_state(".build/plants-roundtrip.txt", s));
    plants_show("load level", load_level_state(".build/plants-roundtrip.txt", loaded));
    plants_show_bool("same species and seed", loaded.blocks[0].shape == s.blocks[0].shape);
    expect {|
        save level: 0
        load level: 2
        same species and seed: true
    |}
    plants_show("save world", save_world_state(".build/plants-world.txt", world, s));
    plants_show("load world", load_world_state(".build/plants-world.txt", world, loaded));
    plants_show_bool("same species and seed", loaded.blocks[0].shape == s.blocks[0].shape);
    expect {|
        save world: 0
        load world: 2
        same species and seed: true
    |}
    // Rotate a quarter turn and move by (10, 20).
    preview_room_transform(s, loaded, 0, 10, 20, 1, xy);
    plants_show_plant("transformed", loaded.blocks[0]);
    plants_show_bool("same species and seed", loaded.blocks[0].shape == s.blocks[0].shape);
    expect {|
        transformed: Broad oak, seed 0
        same species and seed: true
    |}
}

test "erasing a plant through its crown drops the cargo it held" {
    s: *LevelState = plants_oak_with_cargo();
    plants_show("blocks", s.nblocks);
    plants_show("cargo layer", s.blocks[1].layer);
    expect {|
        blocks: 2
        cargo layer: 3
    |}
    // (3, 3) is a crown cell of the oak rooted at (4, 4).
    result: BrushEdit = apply_level_brush_rect(s, 3, 3, 3, 3, Brush.Plant, 0, true,
        true);
    plants_show_bool("result ground count matches", result.nground == s.nground);
    plants_show_bool("result block count matches", result.nblocks == s.nblocks);
    plants_show("blocks", s.nblocks);
    plants_show_plant("first block", s.blocks[0]);
    plants_show("first block layer", s.blocks[0].layer);
    expect {|
        result ground count matches: true
        result block count matches: true
        blocks: 1
        first block: not a plant
        first block layer: 0
    |}
}

test "the grove fixture is a staircase over the plants" {
    // Ground ramp, then shrub, young oak and broad oak.
    s: *LevelState = new_level_state();
    plants_show("load grove fixture", load_level_state("programs/block-game/grove-demo.txt",
        s));
    expect {|
        load grove fixture: 17
    |}
    apply_level_gravity(s);
    home: []int = new int[LEVEL_MAX_BLOCKS](0 - 1);
    ids: *RoomBlockIds = new_room_block_ids();
    widths: []int = new int[LEVEL_MAX_ROOMS](0);
    counts: []RewindCount = new RewindCount[LEVEL_MAX_ROOMS](RewindCount { value: 1 });
    cursors: []RewindCursor = new RewindCursor[LEVEL_MAX_ROOMS](RewindCursor { value: 0 });
    ghost: []int = new int[LEVEL_MAX_ROOMS](0);
    snap: []int = new int[LEVEL_MAX_BLOCKS * REWIND_MAX](0);
    assign_block_homes(s.blocks, s.nblocks, s.rooms, s.nrooms, home, ids, widths);
    p: int = pack_pos(3, 9, 0, 0);
    plants_show_pos("start at row 9", p);
    expect {|
        start at row 9: column 3, layer 0
    |}
    // Each line is one step east.
    for _step in 0..7 {
        p = move_player(s.blocks, s.nblocks, home, s.nrooms, s.bricks, s.nbricks,
            s.ground, s.nground, pos_col(p), pos_row(p), pos_layer(p), 1, 0, ids,
            widths, snap, counts, cursors, ghost);
        plants_show_pos("walk east", p)
    }
    expect {|
        walk east: column 4, layer 0
        walk east: column 5, layer 1
        walk east: column 6, layer 2
        walk east: column 7, layer 2
        walk east: column 8, layer 3
        walk east: column 9, layer 3
        walk east: column 10, layer 3
    |}
}
