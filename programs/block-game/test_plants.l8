tag block_game;
use_tag gl,x11,freetype;
import "../gl/gl.l8";
import "../freetype/ft.l8";
import "level.l8";
import "block-game-undo.l8";
import "block-game-play.l8";
import "block-game-editor.l8";
import "block-game-render.l8";
import "block-game-ui.l8";
check(ok: bool,msg: []i8) { if(!ok) { die(msg); } }
main(): int {
    s: *LevelState=new_level_state(); loaded: *LevelState=new_level_state(); world: *WorldState=new_world_state();
    s.nrooms=set_room_size(s.rooms,s.titles,0,24,18); world.names[0]="grove";
    home: []int=new int[LEVEL_MAX_BLOCKS](0-1); ids: []int=new int[LEVEL_MAX_BLOCKS](0);
    widths: []int=new int[LEVEL_MAX_ROOMS](0); counts: []int=new int[LEVEL_MAX_ROOMS](1);
    cursors: []int=new int[LEVEL_MAX_ROOMS](0); ghost: []int=new int[LEVEL_MAX_ROOMS](0);
    snap: []int=new int[LEVEL_MAX_BLOCKS*REWIND_MAX](0);
    out: []int=new int[7](0); cell: []int=new int[7](0); xy: []int=new int[2](0);
    for style in 0..PLANT_STYLES {
        s.nblocks=plant_edit(s.blocks,0,s.bricks,0,s.ground,0,4,4,style,0);
        check(s.nblocks==1,"place plant");
        for y in 0..plant_height(style) { check(body_at_layer(s.blocks,1,4,4,y)==0,"trunk and crown block their volume"); }
        check(body_at_layer(s.blocks,1,4,4,plant_height(style))<0,"walkable space above crown");
        assign_block_homes(s.blocks,1,s.rooms,1,home,ids,widths);
        check(home[0]<0 && widths[0]==0,"rooted plants do not enter room rewind");
        p: int=move_player(s.blocks,1,home,1,s.bricks,0,s.ground,0,3,4,0,1,0,ids,widths,snap,counts,cursors,ghost);
        check(pos_col(p)==3 && s.blocks[0].column==4,"plant is immovable");
        apply_level_gravity(s); check(s.blocks[0].layer==0,"plants stay rooted");
    }
    s.nblocks=plant_edit(s.blocks,0,s.bricks,0,s.ground,0,4,4,2,0);
    check(body_at_layer(s.blocks,1,3,4,0)<0 && body_at_layer(s.blocks,1,3,4,1)<0,"broad oak has headroom beneath outer crown");
    check(body_at_layer(s.blocks,1,3,4,2)==0,"broad oak outer crown is solid");
    check(plant_spawn_layer(s.blocks,1,s.ground,0,4,4)==3,"start at tree root resolves to crown");
    check(plant_spawn_layer(s.blocks,1,s.ground,0,3,4)==0,"start below outer crown stays on ground");
    p2: int=move_player(s.blocks,1,home,1,s.bricks,0,s.ground,0,2,4,0,1,0,ids,widths,snap,counts,cursors,ghost);
    check(pos_col(p2)==3 && pos_layer(p2)==0,"walk beneath oak canopy");
    p2=move_player(s.blocks,1,home,1,s.bricks,0,s.ground,0,2,4,3,1,0,ids,widths,snap,counts,cursors,ghost);
    check(pos_col(p2)==3 && pos_layer(p2)==3,"walk onto outer oak crown");
    s.nblocks=add_block_at(s.blocks,1,3,4,5,0,0); apply_level_gravity(s);
    check(s.blocks[1].layer==3,"cargo settles onto virtual canopy support");
    check(!plant_can_place(s.blocks,2,s.bricks,0,s.ground,0,3,4,3,0-1),"placement rejects canopy intersection");
    apply_level_brush_rect(s,4,4,4,4,BRUSH_WATER,0,0,1,out,cell);
    check(!is_water(s.ground,s.nground,4,4),"water painting cannot remove planted soil");
    apply_level_brush_rect(s,4,4,4,4,BRUSH_BLOCK,0,1,1,out,cell);
    check(plant_at(s.blocks,s.nblocks,4,4)>=0,"block eraser preserves tree");
    check(save_level_state(".build/plants-roundtrip.txt",s)==0,"save plants");
    check(load_level_state(".build/plants-roundtrip.txt",loaded)>=0 && loaded.blocks[0].shape==s.blocks[0].shape,"load plant species and seed");
    check(save_world_state(".build/plants-world.txt",world,s)==0,"save world plants");
    check(load_world_state(".build/plants-world.txt",world,loaded)>=0 && loaded.blocks[0].shape==s.blocks[0].shape,"world plant round trip");
    preview_room_transform(s,loaded,0,10,20,1,xy);
    check(plant_block(loaded.blocks[0]) && loaded.blocks[0].shape==s.blocks[0].shape,"room transforms retain species and seed");
    apply_level_brush_rect(s,3,3,3,3,BRUSH_PLANT,0,1,1,out,cell);
    check(s.nblocks==1 && !plant_block(s.blocks[0]) && s.blocks[0].layer==0,"erase whole plant through crown and settle cargo");
    // A playable staircase: ground ramp -> shrub -> young oak -> broad oak.
    check(load_level_state("programs/block-game/grove-demo.txt",s)>=0,"load grove fixture");
    apply_level_gravity(s); assign_block_homes(s.blocks,s.nblocks,s.rooms,s.nrooms,home,ids,widths);
    p2=pack_pos(3,9,0,0);
    for step in 0..7 {
        p2=move_player(s.blocks,s.nblocks,home,s.nrooms,s.bricks,s.nbricks,s.ground,s.nground,
            pos_col(p2),pos_row(p2),pos_layer(p2),1,0,ids,widths,snap,counts,cursors,ghost);
        check(pos_col(p2)==4+step,"ramp route progresses through grove");
        if(step==1) { check(pos_layer(p2)==1,"climb shrub"); }
        if(step==2) { check(pos_layer(p2)==2,"climb young oak"); }
        if(step>=4) { check(pos_layer(p2)==3,"cross broad oak canopy"); }
    }
    write(1,"plant gameplay tests passed\n",len("plant gameplay tests passed\n")); 0;
}
