tag block_game;

use_tag gl, x11, freetype;

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

extern glGetError(): int;

extern glGetTexImage(
    target: int,
    level: int,
    format: int,
    typ: int,
    pixels: *f32
): int;

extern glGetBufferSubData(
    target: int,
    offset: int,
    size: int,
    data: *f32
): int;

check(ok: bool, message: []i8) {
    if (!ok) die(message)
}

main(): int {
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) die("GPU water tests need DISPLAY");
    d: *i8 = d0;
    attrs: []i32 = [4i32, 12i32, 24i32, 0i32];
    v0: ?*XVisualInfo = glXChooseVisual(d, XDefaultScreen(d), attrs);
    if (v0 == null) return 2;
    v: *XVisualInfo = v0;
    win: int = XCreateSimpleWindow(d, XRootWindow(d, XDefaultScreen(d)), 0, 0, 1200,
        720, 0, 0, 0);
    ctx0: ?*i8 = glXCreateContext(d, v, null, 1);
    if (ctx0 == null) return 3;
    ctx: *i8 = ctx0;
    check(glXMakeCurrent(d, win, ctx) != 0, "GPU water context");
    prog: int = link_program("""
#version 120
void main(){gl_Position=vec4(0.0);}""", """
#version 120
void main(){gl_FragColor=vec4(1.0);}""", "nrm");
    material: *MaterialLight = new_material_light(prog, prog);
    light: *LampLight = new_lamp_light(prog, prog, prog);
    w: *GpuWater = new_gpu_water(prog);
    check(w.fluid.supported, "GPU water requires GL 4.3");
    ground: []GroundCell = [GroundCell {
        column: 0,
        row: 0,
        style: GROUND_WATER,
        stone: 0
    }];
    large: []GroundCell = new GroundCell[256](GroundCell {
        column: 0,
        row: 0,
        style: GROUND_WATER,
        stone: 0
    });
    for z in 0..16 {
        for x in 0..16 {
            large[z * 16 + x].column = x + 3;
            large[z * 16 + x].row = z
        }
    }
    lamps: []Lamp = new Lamp[0](Lamp { column: 0, row: 0, style: 0 });
    mask: []i8 = new i8[65536](0i8);
    fill_ground_mask(mask, ground, 1, -128, -128);
    textures: []u32 = new u32[1](0u32);
    glGenTextures(1, textures);
    glActiveTexture(33985);
    glBindTexture(3553, textures[0]);
    glTexParameteri(3553, 10241, 9728);
    glTexParameteri(3553, 10240, 9728);
    glTexImage2D(3553, 0, 6409, 256, 256, 0, 6409, 5121, mask);
    glActiveTexture(33984);
    pixels: []f32 = new f32[1200 * 720](0.0);
    raw_depth: []f32 = new f32[1200 * 720](0.0);
    calm_depth: []f32 = new f32[1200 * 720](0.0);
    report: []i8 = new i8[128](0i8);
    projection: []f32 = new f32[16](0.0);
    view: []f32 = new f32[16](0.0);
    vp: []f32 = new f32[16](0.0);
    tmp: []f32 = new f32[16](0.0);
    lvp: []f32 = new f32[16](0.0);
    mat_persp(projection, 2.1445, 1200.0 / 720.0, 0.4, 80.0);
    mat_look(view, 0.5, 8.0, 8.5, 0.5, 0.0, 0.5, 0.0, 1.0, 0.0);
    mat_mul(vp, projection, view, tmp);
    heap: int = l8_heap_used();
    prepare_gpu_water(w, ground, 1, 0, 0, 0.5, 0.5, false, vp);
    check(w.visible == 1 && w.fluid.seed.n == 108, "visible GPU water initialized");
    gpu_water_inverse(w, vp);
    mat_mul(tmp, vp, w.inverse, lvp);
    for r in 0..4 {
        for c in 0..4 {
            expected: f32 = 0.0;
            if (r == c) expected = 1.0;
            error: f32 = tmp[c * 4 + r] - expected;
            check(error * error < 0.000001, "inverse view projection")
        }
    }
    // An isolated, airborne particle must remain round and separate from the pond.
    w.fluid.packed[0] = 0.5;
    w.fluid.packed[1] = 1.2;
    w.fluid.packed[2] = 0.5;
    w.fluid.packed[4] = 0.5;
    w.fluid.packed[5] = 1.2;
    w.fluid.packed[6] = 0.5;
    glBindBuffer(37074, w.fluid.buffers[0]);
    glBufferSubData(37074, 0, 64, w.fluid.packed);
    glEnable(2929);
    glDepthMask(1);
    for i in 0..16 lvp[i] = 0.0;
    draw_gpu_water(w, vp, lvp, 0.5, 8.0, 8.5, -128, -128, material, light, lamps);
    glActiveTexture(33990);
    glBindTexture(3553, w.textures[0]);
    glGetTexImage(3553, 0, 6403, 5126, pixels);
    wet: int = 0;
    high: int = 0;
    low: int = 0;
    minx: int = 1200;
    maxx: int = 0;
    miny: int = 720;
    maxy: int = 0;
    for y in 0..720 {
        for x in 0..1200 {
            depth: f32 = pixels[y * 1200 + x];
            check(depth == depth && depth >= 0.0 && depth < 100.0, "finite screen-space depth");
            if (depth > 0.0) {
                wet = wet + 1;
                if (y > 390) {
                    high = high + 1;
                    if (x < minx) minx = x;
                    if (x > maxx) maxx = x;
                    if (y < miny) miny = y;
                    if (y > maxy) maxy = y
                } else low = low + 1
            }
        }
    }
    check(wet > 100 && high > 0 && low > 0, "surface and separate spray rendered");
    area: int = (maxx - minx + 1) * (maxy - miny + 1);
    check(high * 100 < area * 89 && high * 100 > area * 55, "drop silhouette is rounded, not a square billboard");
    check(pixels[miny * 1200 + minx] == 0.0 && pixels[maxy * 1200 + maxx] == 0.0,
        "filter preserves dry corners around droplets");
    // Test actual controller dispatch, not just the standalone compute entry point.
    request_gpu_splash(w);
    for step in 0..10 {
        w.last_us = mono_us() - 17000;
        prepare_gpu_water(w, ground, 1, 0, 0, 0.5, 0.5, false, vp)
    }
    glMemoryBarrier(512);
    glBindBuffer(37074, w.fluid.buffers[0]);
    glGetBufferSubData(37074, 0, w.fluid.seed.n * 64, w.fluid.packed);
    raised: int = 0;
    for i in 1..w.fluid.seed.n {
        if (w.fluid.packed[i * 16 + 1] > 0.08) raised = raised + 1
    }
    check(raised > 0, "integrated controller dispatches real GPU splash");
    steps: int = w.fluid.steps;
    mat_look(view, 100.5, 8.0, 108.5, 100.5, 0.0, 100.5, 0.0, 1.0, 0.0);
    mat_mul(vp, projection, view, tmp);
    prepare_gpu_water(w, ground, 1, 100, 100, 100.5, 100.5, false, vp);
    check(w.visible == 0 && w.fluid.steps == steps && w.fluid.seed.n == 108, "dry camera travel pauses and retains resident pond");
    mat_look(view, 0.5, 8.0, -91.5, 0.5, 0.0, -99.5, 0.0, 1.0, 0.0);
    mat_mul(vp, projection, view, tmp);
    check(!gpu_pond_visible(w.fluid, 0, vp), "pond behind the camera is culled");
    mat_look(view, 0.5, 8.0, 200.5, 0.5, 8.0, 190.5, 0.0, 1.0, 0.0);
    mat_mul(vp, projection, view, tmp);
    check(!gpu_pond_visible(w.fluid, 0, vp), "pond beyond the far plane is culled");
    toggle_gpu_water(w);
    check(w.disabled, "GPU toggle off");
    glActiveTexture(33989);
    glBindTexture(3553, w.mask);
    glGetTexImage(3553, 0, 6409, 5126, pixels);
    for i in 0..FLUID_TILES * FLUID_TILES check(pixels[i] == 0.0, "toggle clears ground holes");
    toggle_gpu_water(w);
    check(!w.disabled && w.fluid.steps == steps, "toggle retains GPU state");
    mat_look(view, 3.5, 8.0, 16.5, 3.5, 0.0, 8.5, 0.0, 1.0, 0.0);
    mat_mul(vp, projection, view, tmp);
    prepare_gpu_water(w, large, 256, 3, 8, 0.5, 8.5, false, vp);
    check(w.fluid.seed.n == 27648 && w.fluid.ponds == 1, "controller seeds entire 16-by-16 pond from an edge view");
    request_gpu_splash(w);
    w.last_us = mono_us() - 17000;
    prepare_gpu_water(w, large, 256, 3, 8, 0.5, 8.5, false, vp);
    steps = w.fluid.steps;
    check(steps > 0, "large pond advances");
    mat_look(view, 18.5, 8.0, 16.5, 18.5, 0.0, 8.5, 0.0, 1.0, 0.0);
    mat_mul(vp, projection, view, tmp);
    w.last_us = 0;
    prepare_gpu_water(w, large, 256, 18, 8, 18.5, 8.5, false, vp);
    check(w.fluid.seed.n == 27648 && w.fluid.steps == steps, "panning across large pond preserves every particle");
    // Compare exactly the same particle positions with raw and reconstructed
    // surfaces. Include close and distant views: the footprint is world-scaled.
    fill_ground_mask(mask, large, 256, -128, -128);
    glActiveTexture(33985);
    glBindTexture(3553, textures[0]);
    glTexSubImage2D(3553, 0, 0, 0, 256, 256, 6409, 5121, mask);
    gpu_fluid_seed(w.fluid);
    w.fluid.commands[0] = 1.0;
    gpu_fluid_commands(w.fluid);
    for i in 0..w.fluid.seed.n w.fluid.packed[i * 16 + 15] = 32.0;
    glBindBuffer(37074, w.fluid.buffers[0]);
    glBufferSubData(37074, 0, w.fluid.seed.n * 64, w.fluid.packed);
    for distance in 0..2 {
        cy: f32 = 8.0 + distance as f32 * 8.0;
        cz: f32 = 8.5 + cy;
        mat_look(view, 10.5, cy, cz, 10.5, 0.0, 8.5, 0.0, 1.0, 0.0);
        mat_mul(vp, projection, view, tmp);
        w.raw = true;
        draw_gpu_water(w, vp, lvp, 10.5, cy, cz, -128, -128, material, light, lamps);
        glActiveTexture(33990);
        glBindTexture(3553, w.textures[0]);
        glGetTexImage(3553, 0, 6403, 5126, raw_depth);
        w.raw = false;
        draw_gpu_water(w, vp, lvp, 10.5, cy, cz, -128, -128, material, light, lamps);
        glActiveTexture(33990);
        glBindTexture(3553, w.textures[0]);
        glGetTexImage(3553, 0, 6403, 5126, calm_depth);
        for i in 0..len(pixels) {
            check(calm_depth[i] == calm_depth[i], "reconstruction stays finite");
            if (raw_depth[i] == 0.0) check(calm_depth[i] == 0.0, "reconstruction never fills dry silhouettes")
        }
        before: f32 = 0.0;
        after: f32 = 0.0;
        for y in 300..420 {
            for x in 480..720 {
                at: int = y * 1200 + x;
                check(raw_depth[at] > 0.0 && calm_depth[at] > 0.0, "roughness sample covers pond interior");
                ray: f32 = vp[5] / (2.1445 * 2.1445) * ((y as f32 + 0.5) / 360.0 - 1.0) + vp[7];
                a: f32 = (raw_depth[at] - raw_depth[at + 1]) * ray;
                b: f32 = (calm_depth[at] - calm_depth[at + 1]) * ray;
                before = before + a * a;
                after = after + b * b;
                next_ray: f32 = vp[5] / (2.1445 * 2.1445) * ((y as f32 + 1.5) / 360.0 - 1.0) + vp[7];
                a = raw_depth[at] * ray - raw_depth[at + 1200] * next_ray;
                b = calm_depth[at] * ray - calm_depth[at + 1200] * next_ray;
                before = before + a * a;
                after = after + b * b
            }
        }
        length: int = put_str(report, 0, "calm slope energy remaining per mille: ");
        length = put_int(report, length, (after / before * 1000.0) as int);
        length = put_str(report, length, "\n");
        write(1, report, length);
        check(after < before * 0.05, "calm reconstruction removes at least 95 percent of particle-scale slope energy");
        if (distance == 0) {
            for i in 0..w.fluid.seed.n w.fluid.packed[i * 16 + 8] = 1.5;
            glBindBuffer(37074, w.fluid.buffers[0]);
            glBufferSubData(37074, 0, w.fluid.seed.n * 64, w.fluid.packed);
            draw_gpu_water(w, vp, lvp, 10.5, cy, cz, -128, -128, material, light,
                lamps);
            glActiveTexture(33990);
            glBindTexture(3553, w.textures[0]);
            glGetTexImage(3553, 0, 6403, 5126, pixels);
            moving: f32 = 0.0;
            for y in 300..420 {
                for x in 480..720 {
                    at: int = y * 1200 + x;
                    ray: f32 = vp[5] / (2.1445 * 2.1445) * ((y as f32 + 0.5) / 360.0 - 1.0) + vp[7];
                    next_ray: f32 = vp[5] / (2.1445 * 2.1445) * ((y as f32 + 1.5) / 360.0 - 1.0) + vp[7];
                    a: f32 = (pixels[at] - pixels[at + 1]) * ray;
                    b: f32 = pixels[at] * ray - pixels[at + 1200] * next_ray;
                    moving = moving + a * a + b * b
                }
            }
            check(moving > after * 2.0, "moving water retains finer detail than calm water");
            for i in 0..w.fluid.seed.n w.fluid.packed[i * 16 + 8] = 0.0;
            // A broad physical wave must survive even at zero instantaneous
            // velocity (the crest/trough of an oscillation is momentarily still).
            for i in 0..w.fluid.seed.n {
                at: int = i * 16;
                wave: f32 = 0.10 * sin_f32(w.fluid.packed[at] - 10.5);
                w.fluid.packed[at + 1] = w.fluid.packed[at + 1] + wave;
                w.fluid.packed[at + 5] = w.fluid.packed[at + 5] + wave
            }
            glBindBuffer(37074, w.fluid.buffers[0]);
            glBufferSubData(37074, 0, w.fluid.seed.n * 64, w.fluid.packed);
            draw_gpu_water(w, vp, lvp, 10.5, cy, cz, -128, -128, material, light,
                lamps);
            glActiveTexture(33990);
            glBindTexture(3553, w.textures[0]);
            glGetTexImage(3553, 0, 6403, 5126, pixels);
            error: f32 = 0.0;
            low: f32 = 1.0;
            high: f32 = -1.0;
            for y in 320..400 {
                for x in 480..720 {
                    at: int = y * 1200 + x;
                    ray: f32 = vp[5] / (2.1445 * 2.1445) * ((y as f32 + 0.5) / 360.0 - 1.0) + vp[7];
                    world_x: f32 = 10.5 + ((x as f32 + 0.5) / 600.0 - 1.0) * pixels[at] / vp[0];
                    actual: f32 = (pixels[at] - calm_depth[at]) * ray;
                    difference: f32 = actual - 0.10 * sin_f32(world_x - 10.5);
                    error = error + difference * difference;
                    if (actual < low) low = actual;
                    if (actual > high) high = actual
                }
            }
            check(high - low > 0.15 && error / 19200.0 < 0.0004, "reconstruction preserves a real broad wave at rest");
            // Restore the flat input before testing the distant camera.
            gpu_fluid_seed(w.fluid);
            w.fluid.commands[0] = 1.0;
            gpu_fluid_commands(w.fluid);
            for i in 0..w.fluid.seed.n w.fluid.packed[i * 16 + 15] = 32.0;
            glBindBuffer(37074, w.fluid.buffers[0]);
            glBufferSubData(37074, 0, w.fluid.seed.n * 64, w.fluid.packed)
        }
    }
    check(l8_heap_used() == heap, "GPU controller/renderer allocates after startup");
    check(glGetError() == 0, "GPU water rendering GL error");
    glXMakeCurrent(d, 0, null);
    glXDestroyContext(d, ctx);
    XDestroyWindow(d, win);
    XCloseDisplay(d);
    write(1, "GPU water renderer tests passed\n", len("GPU water renderer tests passed\n"));
    0
}
