tag block_game;

// Rooted scenery shares the object collection, but never joins pushes or room
// rewind. A negative shape encodes species and one of four stable mesh variants.
PLANT_STYLES: int = 5;

PLANT_VARIANTS: int = 4;

plant_block(b: Block): bool {
    b.shape < 0;
}

plant_shape(style: int, seed: int): int {
    0 - 1 - style - seed % PLANT_VARIANTS * 8;
}

plant_style(b: Block): int {
    (0 - 1 - b.shape) % 8;
}

plant_seed(b: Block): int {
    (0 - 1 - b.shape) / 8;
}

plant_height(style: int): int {
    if (style == 0) return 1;
    if (style == 1) return 2;
    3;
}

plant_name(style: int): []i8 {
    if (style == 0) return "Hedge shrub";
    if (style == 1) return "Young oak";
    if (style == 2) return "Broad oak";
    if (style == 3) return "Birch";
    "Pine";
}

plant_solid(
    b: Block,
    c: int,
    r: int,
    layer: int
): bool {
    if (!plant_block(b)) return false;
    x: int = c - b.column;
    z: int = r - b.row;
    y: int = layer - b.layer;
    if (x < 0) x = 0 - x;
    if (z < 0) z = 0 - z;
    style: int = plant_style(b);
    if (y < 0 || y >= plant_height(style)) return false;
    if (x == 0 && z == 0) return true;
    // Young oak: five-cell crown. Broad oak: nine-cell crown with headroom.
    if (style == 1 && y == 1) return x + z <= 1;
    if (style == 2 && y == 2) return x <= 1 && z <= 1;
    // Pine's lower boughs make four accessible ledges beneath its central top.
    if (style == 4 && y == 1) return x + z <= 1;
    false;
}

object_solid(
    b: Block,
    c: int,
    r: int,
    layer: int
): bool {
    if (plant_block(b)) return plant_solid(b, c, r, layer);
    b.column == c && b.row == r && b.layer == layer;
}

plant_at(
    blocks: []Block,
    n: int,
    c: int,
    r: int
): int {
    for i in 0..n {
        if (plant_block(blocks[i])) {
            for y in 0..3 {
                if (plant_solid(blocks[i], c, r, y)) return i;
            }
        }
    }
    0 - 1;
}

plant_can_place(
    blocks: []Block,
    n: int,
    bricks: []Brick,
    nbrick: int,
    ground: []GroundCell,
    nground: int,
    c: int,
    r: int,
    style: int,
    skip: int
): bool {
    if (style < 0 || style >= PLANT_STYLES || is_water(ground, nground, c, r)) return false;
    b: Block = Block {
        id: 0,
        column: c,
        row: r,
        shape: plant_shape(style, 0),
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    for dx in 0..3 {
        for dz in 0..3 {
            for y in 0..3 {
                x: int = c + dx - 1;
                z: int = r + dz - 1;
                if (plant_solid(b, x, z, y)) {
                    if (!in_bounds(x, z) || y == 0 && is_brick(bricks, nbrick, x,
                        z)) return false;
                    for i in 0..n {
                        if (i != skip && object_solid(blocks[i], x, z, y)) return false;
                    }
                }
            }
        }
    }
    true;
}

plant_edit(
    blocks: []Block,
    n: int,
    bricks: []Brick,
    nbrick: int,
    ground: []GroundCell,
    nground: int,
    c: int,
    r: int,
    style: int,
    erase: bool
): int {
    found: int = plant_at(blocks, n, c, r);
    if (erase) {
        if (found >= 0) return delete_at(blocks, n, found);
        return n;
    }
    // Repainting a root changes its species. Clicking a neighboring crown does
    // not silently relocate that tree to the clicked canopy cell.
    if (found >= 0 && (blocks[found].column != c || blocks[found].row != r)) return n;
    if (!plant_can_place(blocks, n, bricks, nbrick, ground, nground, c, r, style,
        found)) return n;
    seed: int = (c * 719 + r * 131) % PLANT_VARIANTS;
    if (seed < 0) seed = 0 - seed;
    id: int = next_block_id(blocks, n);
    if (found >= 0) {
        seed = plant_seed(blocks[found]);
        id = blocks[found].id;
    } else {
        if (n >= LEVEL_MAX_BLOCKS) return n;
        found = n;
        n = n + 1;
    }
    blocks[found] = Block {
        id: id,
        column: c,
        row: r,
        shape: plant_shape(style, seed),
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    n;
}

put_plant(
    dst: []i8,
    i: int,
    b: Block,
    ox: int,
    oz: int
): int {
    i = put_str(dst, i, "v ");
    i = put_int(dst, i, b.column - ox);
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, b.row - oz);
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, plant_style(b));
    i = put_ch(dst, i, ' ');
    put_int(dst, i, plant_seed(b));
}

plant_spawn_layer(
    blocks: []Block,
    n: int,
    ground: []GroundCell,
    nground: int,
    c: int,
    r: int
): int {
    layer: int = 0;
    found: int = plant_at(blocks, n, c, r);
    if (found >= 0 && plant_solid(blocks[found], c, r, 0)) {
        // A start painted on a solid plant uses its top; starts under an outer
        // crown still use the clear ground below it.
        while (layer < LEVEL_MAX_LAYER - 1 && body_at_layer(blocks, n, c, r, layer) >= 0) layer = layer + 1;
    }
    settle_terrain_layer(blocks, n, ground, nground, c, r, layer, 0 - 1);
}
