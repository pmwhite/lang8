tag block_game;

use_tag gl, x11, freetype;

// A world-space diffuse light field keeps the cost independent of the number
// of painted lamps. Four samples per cell are enough for broad, soft pools.
// Rebuilt only after edits or crossing a cache margin; never allocated per frame.
type LampLight = {
    tex: u32;
    pixels: []i8;
    x: int;
    z: int;
    key: int;
    origins: []int;
    programs: []int;
    emission: int;
};

new_lamp_light(prog: int, grass: int, sparks: int): *LampLight@new {
    tex: []u32 = new u32[1](0u32);
    glGenTextures(1, tex);
    glActiveTexture(33986);
    glBindTexture(3553, tex[0]);
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    pixels: []i8 = new i8[512 * 512](0i8);
    glTexImage2D(3553, 0, 6409, 512, 512, 0, 6409, 5121, pixels);
    programs: []int = [prog, grass, sparks];
    origins: []int = new int[3](0);
    for i in 0..3 {
        glUseProgram(programs[i]);
        glUniform1i(glGetUniformLocation(programs[i], "lamp_map"), 2);
        origins[i] = glGetUniformLocation(programs[i], "lamp_origin");
    }
    glActiveTexture(33984);
    new LampLight {
        tex: tex[0],
        pixels: pixels,
        x: -999999,
        z: -999999,
        key: -1,
        origins: origins,
        programs: programs,
        emission: glGetUniformLocation(prog, "emission")
    };
}

lamp_key(lamps: []Lamp, n: int): int {
    key: int = n;
    for i in 0..n {
        p: Lamp = lamps[i];
        key = key * 31 + p.column;
        key = key * 31 + p.row;
        key = key * 31 + p.style;
    }
    key;
}

fill_lamp_light(
    pixels: []i8,
    ox: int,
    oz: int,
    lamps: []Lamp,
    n: int
) {
    for i in 0..len(pixels) pixels[i] = 0i8;
    for i in 0..n {
        p: Lamp = lamps[i];
        radius: int = 6;
        if (p.style == 1) radius = 8;
        cx: int = (p.column - ox) * 4 + 2;
        cz: int = (p.row - oz) * 4 + 2;
        rr: int = radius * 4;
        x0: int = cx - rr;
        x1: int = cx + rr;
        z0: int = cz - rr;
        z1: int = cz + rr;
        if (x0 < 0) x0 = 0;
        if (x1 > 512) x1 = 512;
        if (z0 < 0) z0 = 0;
        if (z1 > 512) z1 = 512;
        for z in z0..z1 {
            for x in x0..x1 {
                dx: f32 = (x - cx) as f32 * 0.25 + 0.125;
                dz: f32 = (z - cz) as f32 * 0.25 + 0.125;
                d2: f32 = dx * dx + dz * dz;
                edge: f32 = 1.0 - d2 / (radius * radius) as f32;
                if (edge > 0.0) {
                    value: int = (180.0 * edge * edge / (1.0 + 0.08 * d2)) as int;
                    at: int = z * 512 + x;
                    previous: int = pixels[at] as int;
                    if (previous < 0) previous = previous + 256;
                    value = value + previous;
                    if (value > 255) value = 255;
                    pixels[at] = value trunc i8;
                }
            }
        }
    }
}

update_lamp_light(
    cache: *LampLight,
    lamps: []Lamp,
    n: int,
    bounds: []f32
) {
    key: int = lamp_key(lamps, n);
    x: int = floor_i((bounds[0] + bounds[1]) * 0.5);
    z: int = floor_i((bounds[2] + bounds[3]) * 0.5);
    glActiveTexture(33986);
    glBindTexture(3553, cache.tex);
    if (key != cache.key || bounds[0] < (cache.x + 1) as f32 || bounds[1] > (cache.x + 127) as f32 || bounds[2] < (cache.z + 1) as f32 || bounds[3] > (cache.z + 127) as f32) {
        cache.x = x - 64;
        cache.z = z - 64;
        cache.key = key;
        fill_lamp_light(cache.pixels, cache.x, cache.z, lamps, n);
        glPixelStorei(3317, 1);
        glTexSubImage2D(3553, 0, 0, 0, 512, 512, 6409, 5121, cache.pixels);
    }
    for i in 0..3 {
        glUseProgram(cache.programs[i]);
        glUniform2f(cache.origins[i], cache.x as f32, cache.z as f32);
    }
    glActiveTexture(33984);
}

draw_lantern(
    u_origin: int,
    u_scale: int,
    u_color: int,
    emission: int,
    x: f32,
    z: f32,
    style: int
) {
    y: f32 = 0.38;
    if (style == 1) {
        y = 1.85;
        draw_box(u_origin, u_scale, u_color, x, 0.82, z, 0.10, 1.64, 0.10, 0.24, 0.18,
            0.12, 36);
    }
    draw_box(u_origin, u_scale, u_color, x, 0.07, z, 0.36, 0.14, 0.36, 0.28, 0.22,
        0.16, 36);
    glUniform1f(emission, 0.20);
    draw_box(u_origin, u_scale, u_color, x, y, z, 0.28, 0.42, 0.28, 0.42, 0.26, 0.12,
        36);
    glUniform1f(emission, 0.0);
    draw_box(u_origin, u_scale, u_color, x, y + 0.25, z, 0.48, 0.12, 0.48, 0.25, 0.18,
        0.11, 36);
    draw_box(u_origin, u_scale, u_color, x, y - 0.24, z, 0.36, 0.07, 0.36, 0.25, 0.18,
        0.11, 36);
}
