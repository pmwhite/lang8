tag block_game;

// Bounded CPU Position Based Fluids prototype (Macklin/Muller, SIGGRAPH 2013).
// A true 3D particle volume, not a height field. All workspace is allocated once.
need "libm.so.6";
extern sqrtf(x: f32): f32;

FLUID_TILES: int = 32;
FLUID_TILE_CAP: int = 256;
FLUID_PER_TILE: int = 108; // 6 x 6 x 3 layers, half a block deep
FLUID_CAP: int = FLUID_TILE_CAP*FLUID_PER_TILE;
FLUID_HASH: int = 65536;
FLUID_NEIGHBORS: int = 96;
FLUID_DT: f32 = 0.016666667;

type FluidParticle = {
    x: f32; y: f32; z: f32;
    ox: f32; oy: f32; oz: f32;
    vx: f32; vy: f32; vz: f32;
    dx: f32; dy: f32; dz: f32;
    lambda: f32;
};
type Fluid = {
    p: []FluidParticle;
    head: []int; next: []int; neighbors: []int; counts: []int;
    tiles: []i8;
    n: int; cells: int; x: int; z: int;
    key: int; ready: bool; steps: int; overflow: int;
    accumulator: f32; dropped_us: int;
    sim_us: int; mesh_us: int;
};

new_fluid(): *Fluid@new {
    new_fluid_storage(true);
}

// GPU initialization needs positions/topology, not duplicate CPU neighbor tables.
new_fluid_seed(): *Fluid@new {
    new_fluid_storage(false);
}

new_fluid_storage(workspace: bool): *Fluid@new {
    hash_count: int=0; particle_count: int=0; neighbor_count: int=0;
    if (workspace) { hash_count=FLUID_HASH; particle_count=FLUID_CAP; neighbor_count=FLUID_CAP*FLUID_NEIGHBORS; }
    new Fluid {
        p: new FluidParticle[FLUID_CAP](FluidParticle {
            x:0.0,y:0.0,z:0.0,ox:0.0,oy:0.0,oz:0.0,vx:0.0,vy:0.0,vz:0.0,
            dx:0.0,dy:0.0,dz:0.0,lambda:0.0 }),
        head:new int[hash_count](-1), next:new int[particle_count](-1),
        neighbors:new int[neighbor_count](0), counts:new int[particle_count](0),
        tiles:new i8[FLUID_TILES*FLUID_TILES](0i8),
        n:0,cells:0,x:0,z:0,key:0,ready:false,steps:0,overflow:0,
        accumulator:0.0,dropped_us:0,sim_us:0,mesh_us:0
    };
}

fluid_tile(f: *Fluid,c: int,r: int): bool {
    x: int=c-f.x; z: int=r-f.z;
    if (x<0 || z<0 || x>=FLUID_TILES || z>=FLUID_TILES) { return false; }
    f.tiles[z*FLUID_TILES+x] != 0i8;
}

// Keep a persistent world-space window; small camera moves do not reset the pond.
// Oversized worlds retain ordinary reflective water outside this prototype budget.
fluid_prepare(f: *Fluid, ground: []GroundCell,n: int, cx: int,cz: int): bool {
    key: int=0;
    for i in 0..n {
        if (ground[i].style==GROUND_WATER) {
            key=key*31+ground[i].column*719+ground[i].row*131+1;
        }
    }
    if (f.ready && key==f.key && cx>=f.x+8 && cx<f.x+24 && cz>=f.z+8 && cz<f.z+24) {
        return false;
    }
    f.x=cx-FLUID_TILES/2; f.z=cz-FLUID_TILES/2; f.n=0; f.cells=0; f.steps=0; f.accumulator=0.0;
    f.key=key; f.ready=true;
    for i in 0..len(f.tiles) { f.tiles[i]=0i8; }
    // Near-to-far Manhattan rings make the cap independent of ground-file ordering.
    for radius in 0..FLUID_TILES+1 {
        for i in 0..n {
            cell: GroundCell=ground[i];
            dx: int=cell.column-cx; dz: int=cell.row-cz;
            if (dx<0) { dx=-dx; } if (dz<0) { dz=-dz; }
            x: int=cell.column-f.x; z: int=cell.row-f.z;
            if (cell.style==GROUND_WATER && dx+dz==radius && x>=1 && z>=1 &&
                x<FLUID_TILES-1 && z<FLUID_TILES-1 && f.cells<FLUID_TILE_CAP &&
                f.tiles[z*FLUID_TILES+x]==0i8) {
                f.tiles[z*FLUID_TILES+x]=127i8;
                f.cells=f.cells+1;
                for y in 0..3 { for b in 0..6 { for a in 0..6 {
                    p: *FluidParticle=&f.p[f.n];
                    p.x=cell.column as f32+(a as f32+0.5)/6.0;
                    p.z=cell.row as f32+(b as f32+0.5)/6.0;
                    p.y=-0.52+(y as f32+0.5)/6.0;
                    p.ox=p.x; p.oy=p.y; p.oz=p.z;
                    p.vx=0.0; p.vy=0.0; p.vz=0.0;
                    f.n=f.n+1;
                } } }
            }
        }
    }
    true;
}

fluid_hash(x: int,y: int,z: int): int {
    h: int=(x*73856093+y*19349663+z*83492791)%FLUID_HASH;
    if (h<0) { h=h+FLUID_HASH; } h;
}

fluid_neighbors(f: *Fluid) {
    for i in 0..FLUID_HASH { f.head[i]=-1; }
    for i in 0..f.n {
        p: *FluidParticle=&f.p[i];
        h: int=fluid_hash(floor_i(p.x*3.0),floor_i(p.y*3.0),floor_i(p.z*3.0));
        f.next[i]=f.head[h]; f.head[h]=i;
    }
    for i in 0..f.n {
        p: *FluidParticle=&f.p[i];
        cx: int=floor_i(p.x*3.0); cy: int=floor_i(p.y*3.0); cz: int=floor_i(p.z*3.0);
        count: int=0;
        for z in -1..2 { for y in -1..2 { for x in -1..2 {
            j: int=f.head[fluid_hash(cx+x,cy+y,cz+z)];
            while (j>=0) {
                b: *FluidParticle=&f.p[j];
                dx: f32=p.x-b.x; dy: f32=p.y-b.y; dz: f32=p.z-b.z;
                if (i!=j && dx*dx+dy*dy+dz*dz<0.11111112) {
                    if (count<FLUID_NEIGHBORS) { f.neighbors[i*FLUID_NEIGHBORS+count]=j; count=count+1; }
                    else { f.overflow=f.overflow+1; }
                }
                j=f.next[j];
            }
        } } }
        f.counts[i]=count;
    }
}

fluid_collide(f: *Fluid,p: *FluidParticle) {
    if (p.y < -0.437) { p.y=-0.437; }
    // Leave reconstruction-kernel padding below the bounded volume's upper edge.
    if (p.y > 1.65) { p.y=1.65; }
    // Solid dry terrain has a top at -0.02. Above it water can spill onto shore.
    // Project spheres out of nearby land boxes, including diagonal corners.
    cx: int=floor_i(p.x); cz: int=floor_i(p.z);
    for z in -1..2 { for x in -1..2 {
        c: int=cx+x; r: int=cz+z;
        if (p.y<0.05 && p.x>c as f32-0.07 && p.x<(c+1) as f32+0.07 &&
            p.z>r as f32-0.07 && p.z<(r+1) as f32+0.07 && !fluid_tile(f,c,r)) {
            nx: f32=p.x; nz: f32=p.z;
            if (nx<c as f32) { nx=c as f32; }
            if (nx>(c+1) as f32) { nx=(c+1) as f32; }
            if (nz<r as f32) { nz=r as f32; }
            if (nz>(r+1) as f32) { nz=(r+1) as f32; }
            ny: f32=p.y; if (ny > -0.02) { ny=-0.02; }
            dx: f32=p.x-nx; dy: f32=p.y-ny; dz: f32=p.z-nz;
            d2: f32=dx*dx+dy*dy+dz*dz;
            if (d2>0.0000001 && d2<0.0049) {
                s: f32=0.07/sqrtf(d2)-1.0;
                p.x=p.x+dx*s; p.y=p.y+dy*s; p.z=p.z+dz*s;
            } else if (d2<=0.0000001) {
                // A large impulse crossed the boundary: return below-bank particles
                // to their last valid position instead of tunnelling through land.
                p.x=p.ox; p.z=p.oz;
                if (!fluid_tile(f,floor_i(p.x),floor_i(p.z))) { p.y=0.05; }
            }
        }
    } }
    // A raised outer rim bounds the experiment without deleting escaped particles.
    if (p.x<(f.x+1) as f32+0.08) { p.x=(f.x+1) as f32+0.08; }
    if (p.x>(f.x+FLUID_TILES-1) as f32-0.08) { p.x=(f.x+FLUID_TILES-1) as f32-0.08; }
    if (p.z<(f.z+1) as f32+0.08) { p.z=(f.z+1) as f32+0.08; }
    if (p.z>(f.z+FLUID_TILES-1) as f32-0.08) { p.z=(f.z+FLUID_TILES-1) as f32-0.08; }
}

// A localized impulse, useful for repeatable splash tests and shoreline interaction.
fluid_impulse(f: *Fluid,x: f32,z: f32,strength: f32) {
    for i in 0..f.n {
        p: *FluidParticle=&f.p[i];
        dx: f32=p.x-x; dz: f32=p.z-z;
        q: f32=1.0-(dx*dx+dz*dz)/0.64;
        if (q>0.0) {
            p.vy=p.vy+strength*q;
            p.vx=p.vx+dx*strength*q; p.vz=p.vz+dz*strength*q;
        }
    }
}

fluid_step(f: *Fluid) {
    // CPU reference for the GPU solver. Disturbances are external impulses, so
    // genuinely quiet water can settle and sleep instead of being forced forever.
    for i in 0..f.n {
        p: *FluidParticle=&f.p[i];
        p.ox=p.x; p.oy=p.y; p.oz=p.z;
        p.vy=p.vy-5.0*FLUID_DT;
        p.x=p.x+p.vx*FLUID_DT; p.y=p.y+p.vy*FLUID_DT; p.z=p.z+p.vz*FLUID_DT;
        fluid_collide(f,p);
    }
    fluid_neighbors(f);
    for iteration in 0..2 {
        for i in 0..f.n {
            p: *FluidParticle=&f.p[i];
            rho: f32=1.0; gx: f32=0.0; gy: f32=0.0; gz: f32=0.0; denom: f32=0.0;
            for k in 0..f.counts[i] {
                b: *FluidParticle=&f.p[f.neighbors[i*FLUID_NEIGHBORS+k]];
                dx: f32=p.x-b.x; dy: f32=p.y-b.y; dz: f32=p.z-b.z;
                q: f32=1.0-(dx*dx+dy*dy+dz*dz)*9.0;
                if (q>0.0) {
                    rho=rho+q*q*q;
                    g: f32=-54.0*q*q/5.15;
                    dx=dx*g; dy=dy*g; dz=dz*g;
                    gx=gx+dx; gy=gy+dy; gz=gz+dz;
                    denom=denom+dx*dx+dy*dy+dz*dz;
                }
            }
            c: f32=rho/5.15-1.0;
            if (c<0.0) { c=0.0; } // free surface: never attract sparse spray into clumps
            p.lambda=-c/(denom+gx*gx+gy*gy+gz*gz+0.1);
        }
        for i in 0..f.n {
            p: *FluidParticle=&f.p[i];
            ax: f32=0.0; ay: f32=0.0; az: f32=0.0;
            for k in 0..f.counts[i] {
                b: *FluidParticle=&f.p[f.neighbors[i*FLUID_NEIGHBORS+k]];
                dx: f32=p.x-b.x; dy: f32=p.y-b.y; dz: f32=p.z-b.z;
                q: f32=1.0-(dx*dx+dy*dy+dz*dz)*9.0;
                if (q>0.0) {
                    g: f32=(p.lambda+b.lambda)*(-54.0*q*q/5.15);
                    ax=ax+dx*g; ay=ay+dy*g; az=az+dz*g;
                }
            }
            d2: f32=ax*ax+ay*ay+az*az;
            if (d2>0.0016) { s: f32=0.04/sqrtf(d2); ax=ax*s; ay=ay*s; az=az*s; }
            p.dx=ax; p.dy=ay; p.dz=az;
        }
        for i in 0..f.n {
            p: *FluidParticle=&f.p[i];
            p.x=p.x+p.dx; p.y=p.y+p.dy; p.z=p.z+p.dz;
            fluid_collide(f,p);
        }
    }
    for i in 0..f.n {
        p: *FluidParticle=&f.p[i];
        p.vx=(p.x-p.ox)/FLUID_DT; p.vy=(p.y-p.oy)/FLUID_DT; p.vz=(p.z-p.oz)/FLUID_DT;
        v2: f32=p.vx*p.vx+p.vy*p.vy+p.vz*p.vz;
        if (v2>16.0) { s: f32=4.0/sqrtf(v2); p.vx=p.vx*s; p.vy=p.vy*s; p.vz=p.vz*s; }
    }
    // XSPH viscosity, Jacobi (read velocities first, then apply all corrections).
    for i in 0..f.n {
        p: *FluidParticle=&f.p[i];
        ax: f32=0.0; ay: f32=0.0; az: f32=0.0;
        for k in 0..f.counts[i] {
            b: *FluidParticle=&f.p[f.neighbors[i*FLUID_NEIGHBORS+k]];
            dx: f32=p.x-b.x; dy: f32=p.y-b.y; dz: f32=p.z-b.z;
            q: f32=1.0-(dx*dx+dy*dy+dz*dz)*9.0;
            if (q>0.0) {
                w: f32=0.012*q*q*q;
                ax=ax+(b.vx-p.vx)*w; ay=ay+(b.vy-p.vy)*w; az=az+(b.vz-p.vz)*w;
            }
        }
        p.dx=ax; p.dy=ay; p.dz=az;
    }
    for i in 0..f.n {
        p: *FluidParticle=&f.p[i];
        p.vx=(p.vx+p.dx)*0.999; p.vy=(p.vy+p.dy)*0.999; p.vz=(p.vz+p.dz)*0.999;
    }
    f.steps=f.steps+1;
}

fluid_advance(f: *Fluid,elapsed: f32): int {
    if (elapsed<0.0) { elapsed=0.0; }
    if (elapsed>FLUID_DT*2.0) {
        f.dropped_us=f.dropped_us+((elapsed-FLUID_DT*2.0)*1000000.0) as int;
        elapsed=FLUID_DT*2.0;
    }
    if (f.n==0) { f.accumulator=0.0; return 0; }
    f.accumulator=f.accumulator+elapsed;
    steps: int=0;
    while (f.accumulator>=FLUID_DT && steps<2) {
        fluid_step(f); f.accumulator=f.accumulator-FLUID_DT; steps=steps+1;
    }
    steps;
}
