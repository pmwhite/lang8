tag block_game;
use_tag gl, x11, freetype;
import "../gl/gl.l8";
import "../freetype/ft.l8";
import "level.l8";
import "block-game-undo.l8";
import "block-game-play.l8";
import "block-game-editor.l8";
import "block-game-render.l8";
import "block-game-ui.l8";

check(ok: bool, message: []i8) { if (!ok) { die(message); } }

main(): int {
    m: FpsMeter = FpsMeter { on: true, i: 0, n: 0, work0: 0, pending_work: 0,
        flo: 0.0, fhi: 0.0, mlo: 0.0, mhi: 0.0, f_step: 0.0, m_step: 0.0,
        h_step: 0.0, x_step: 0.0, hlo: 0.0, hhi: 0.0 };
    times: []int = new int[FPS_CAP](0);
    works: []int = new int[FPS_CAP](0);
    frames: []int = new int[FPS_CAP](0);
    rates: []f32 = new f32[FPS_CAP](0.0);
    heaps: []int = new int[FPS_CAP](0);
    heap: int = l8_heap_used();
    now: int = 1000000;
    fps_finish_at(&m, times, works, frames, rates, heaps, now, heap);
    check(m.n == 0, "first swap must only establish baseline");
    m.pending_work = 3000;
    now = now + 8333;
    fps_finish_at(&m, times, works, frames, rates, heaps, now, heap);
    check(frames[0] == 8333 && works[0] == 3000, "wall frame must include presentation wait");
    m.pending_work = 3000;
    now = now + 120000;
    fps_finish_at(&m, times, works, frames, rates, heaps, now, heap);
    check(frames[1] == 120000 && works[1] == 3000 && times[1] == now,
        "a presentation hitch must stay unsmoothed and aligned with work");
    check(frame_axis_hi(10.0, 140.0, 1) == 140.0, "axis must show full hitch immediately");
    check(frame_axis_hi(140.0, 10.0, 1) > 10.0, "axis should contract smoothly");
    for i in 0..FPS_CAP + 100 {
        now = now + 8333;
        m.pending_work = 2400;
        fps_finish_at(&m, times, works, frames, rates, heaps, now, heap);
    }
    last: int = fps_ring(m.i, m.n, m.n - 1);
    check(m.n == FPS_CAP && times[last] == now && frames[last] == 8333,
        "ring wrap must preserve latest completed frame");
    check(rates[last] > 119.9 && rates[last] < 120.1, "FPS derived from completed frames");
    toggle_fps(&m);
    now = now + 10000000;
    fps_finish_at(&m, times, works, frames, rates, heaps, now, heap);
    check(m.n == 0, "toggle must discard stale timing baseline");
    now = now + 16667;
    m.pending_work = 2000;
    fps_finish_at(&m, times, works, frames, rates, heaps, now, heap);
    check(m.n == 1 && frames[0] == 16667, "restart must not include toggle gap");
    check(l8_heap_used() == heap, "frame sampling must not allocate");
    write(1, "frame timing tests passed\n", 26);
    0;
}
