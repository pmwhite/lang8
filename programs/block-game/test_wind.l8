tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

wind_test_energy(wind: *WindField): f32 {
    total: f32 = 0.0;
    for i in 0..WIND_CELLS total = total + wind.vx[i] * wind.vx[i] + wind.vz[i] * wind.vz[i];
    total
}

// Make a field centered on the origin and step it with the given obstacles.
wind_test_settled(
    seed: int,
    bricks: []Brick,
    nbrick: int,
    steps: int
): *WindField@new requires (0 <= nbrick && nbrick <= len(bricks)) {
    field: *WindField = new_wind_field(seed);
    wind_recenter(field, 0.0, 0.0);
    for _step in 0..steps {
        wind_obstacles(field, bricks, nbrick);
        wind_step(field)
    }
    field
}

wind_test_show(label: str, value: int) raises IoError {
    write(1, label);
    write(1, ": ");
    write_int(1, value);
    write(1, "\n")
}

wind_test_show_fixed(label: str, value: f32, places: int) raises IoError {
    write(1, label);
    write(1, ": ");
    write_fixed(1, value as f64, places);
    write(1, "\n")
}

wind_test_show_bool(label: str, value: bool) raises IoError {
    write(1, label);
    if (value) write(1, ": true\n") else write(1, ": false\n")
}

test "the same seed produces the same bounded wind" {
    empty: []Brick = new Brick[0](Brick { column: 0, row: 0 });
    a: *WindField = wind_test_settled(91, empty, 0, 80);
    b: *WindField = wind_test_settled(91, empty, 0, 80);
    differing: int = 0;
    bounded: int = 0;
    max_speed2: f32 = 0.0;
    for i in 0..WIND_CELLS {
        if (a.vx[i] != b.vx[i] || a.vz[i] != b.vz[i]) differing = differing + 1;
        speed2: f32 = a.vx[i] * a.vx[i] + a.vz[i] * a.vz[i];
        if (speed2 == speed2 && speed2 <= WIND_MAX_SPEED * WIND_MAX_SPEED + 0.001) bounded = bounded + 1;
        if (speed2 > max_speed2) max_speed2 = speed2
    }
    wind_test_show("cells", WIND_CELLS);
    wind_test_show("cells differing between the runs", differing);
    wind_test_show("cells finite and within the speed limit", bounded);
    wind_test_show_fixed("speed limit squared", WIND_MAX_SPEED * WIND_MAX_SPEED, 3);
    wind_test_show_fixed("largest speed squared", max_speed2, 3);
    expect {|
        cells: 4096
        cells differing between the runs: 0
        cells finite and within the speed limit: 4096
        speed limit squared: 4.000
        largest speed squared: 1.487
    |}
}

test "recentering keeps the overlapping world cells" {
    empty: []Brick = new Brick[0](Brick { column: 0, row: 0 });
    a: *WindField = wind_test_settled(91, empty, 0, 80);
    old_x: f32 = a.vx[32 * WIND_SIZE + 32];
    old_z: f32 = a.vz[32 * WIND_SIZE + 32];
    // Move the window one cell along x.
    wind_recenter(a, 1.0, 0.0);
    wind_test_show_bool("cell moved one place left keeps its wind", a.vx[32 * WIND_SIZE + 31] == old_x && a.vz[32 * WIND_SIZE + 31] == old_z);
    expect {|
        cell moved one place left keeps its wind: true
    |}
}

test "walls still the wind inside them and shelter it beside them" {
    empty: []Brick = new Brick[0](Brick { column: 0, row: 0 });
    wall: []Brick = [Brick { column: 0, row: 0 }];
    clear: *WindField = wind_test_settled(41, empty, 0, 60);
    blocked: *WindField = wind_test_settled(41, wall, 1, 60);
    center: int = 32 * WIND_SIZE + 32;
    wind_test_show("wall cell solid", blocked.solid[center]);
    wind_test_show_bool("wall cell velocity is zero", blocked.vx[center] == 0.0 && blocked.vz[center] == 0.0);
    around: f32 = blocked.vx[center - 1] * blocked.vx[center - 1] + blocked.vz[center - 1] * blocked.vz[center - 1] + blocked.vx[center + 1] * blocked.vx[center + 1] + blocked.vz[center + 1] * blocked.vz[center + 1];
    wind_test_show_fixed("speed squared beside the wall", around, 4);
    difference_x: f32 = blocked.vx[center - 1] - clear.vx[center - 1];
    difference_z: f32 = blocked.vz[center - 1] - clear.vz[center - 1];
    if (difference_x < 0.0) difference_x = 0.0 - difference_x;
    if (difference_z < 0.0) difference_z = 0.0 - difference_z;
    wind_test_show_fixed("change beside the wall compared with no wall", difference_x + difference_z,
        4);
    wind_test_show_fixed("total energy with the wall", wind_test_energy(blocked),
        2);
    expect {|
        wall cell solid: 1
        wall cell velocity is zero: true
        speed squared beside the wall: 0.4279
        change beside the wall compared with no wall: 0.4881
        total energy with the wall: 3741.82
    |}
}

test "steady wind updates do not allocate" {
    wall: []Brick = [Brick { column: 0, row: 0 }];
    steady: *WindField = new_wind_field(7);
    wind_prepare(steady, 0.0, 0.0, wall, 1, 1000);
    heap: int = l8_heap_used();
    // Three seconds of 60 Hz frames with the camera drifting along x.
    for frame in 1..180 wind_prepare(steady, frame as f32 * 0.02, 0.0, wall, 1, 1000 + frame * 16);
    heap_delta: int = l8_heap_used() - heap;
    wind_test_show("bytes allocated", heap_delta);
    wind_test_show_fixed("weather direction length squared", steady.weather.dir_x * steady.weather.dir_x + steady.weather.dir_z * steady.weather.dir_z,
        4);
    expect {|
        bytes allocated: 0
        weather direction length squared: 1.0000
    |}
}

test "the visual wind clock keeps frame precision after long uptime" {
    timed: *WindField = new_wind_field(8);
    // About four days of uptime.
    timed.start_ms = 340000000;
    frame_time: f32 = wind_visual_time(timed, 340000016) - wind_visual_time(timed,
        340000000);
    wind_test_show_fixed("seconds for a 16 ms frame", frame_time, 5);
    expect {|
        seconds for a 16 ms frame: 0.01600
    |}
}
