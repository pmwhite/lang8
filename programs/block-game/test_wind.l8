tag block_game;

use_tag gl, x11, freetype;

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

check_wind(ok: bool, message: []i8) {
    if (!ok) die(message)
}

wind_energy(wind: *WindField): f32 {
    total: f32 = 0.0;
    for i in 0..WIND_CELLS total = total + wind.vx[i] * wind.vx[i] + wind.vz[i] * wind.vz[i];
    total
}

main(): int {
    empty: []Brick = new Brick[0](Brick { column: 0, row: 0 });
    wall: []Brick = [Brick { column: 0, row: 0 }];
    a: *WindField = new_wind_field(91);
    b: *WindField = new_wind_field(91);
    wind_recenter(a, 0.0, 0.0);
    wind_recenter(b, 0.0, 0.0);
    for _step in 0..80 {
        wind_obstacles(a, empty, 0);
        wind_obstacles(b, empty, 0);
        wind_step(a);
        wind_step(b)
    }
    for i in 0..WIND_CELLS {
        check_wind(a.vx[i] == b.vx[i] && a.vz[i] == b.vz[i], "same seed must produce the same wind");
        speed2: f32 = a.vx[i] * a.vx[i] + a.vz[i] * a.vz[i];
        check_wind(speed2 == speed2 && speed2 <= WIND_MAX_SPEED * WIND_MAX_SPEED + 0.001,
            "wind must remain finite and bounded")
    }

    // Moving the camera shifts the window while retaining the world-space cells
    // in the overlap exactly.
    old_x: f32 = a.vx[32 * WIND_SIZE + 32];
    old_z: f32 = a.vz[32 * WIND_SIZE + 32];
    wind_recenter(a, 1.0, 0.0);
    check_wind(a.vx[32 * WIND_SIZE + 31] == old_x && a.vz[32 * WIND_SIZE + 31] == old_z,
        "recentering must preserve overlapping world cells");
    clear: *WindField = new_wind_field(41);
    blocked: *WindField = new_wind_field(41);
    wind_recenter(clear, 0.0, 0.0);
    wind_recenter(blocked, 0.0, 0.0);
    for _step in 0..60 {
        wind_obstacles(clear, empty, 0);
        wind_obstacles(blocked, wall, 1);
        wind_step(clear);
        wind_step(blocked)
    }
    center: int = 32 * WIND_SIZE + 32;
    check_wind(blocked.solid[center] != 0 && blocked.vx[center] == 0.0 && blocked.vz[center] == 0.0,
        "walls must stop wind inside their cells");
    around: f32 = blocked.vx[center - 1] * blocked.vx[center - 1] + blocked.vz[center - 1] * blocked.vz[center - 1] + blocked.vx[center + 1] * blocked.vx[center + 1] + blocked.vz[center + 1] * blocked.vz[center + 1];
    check_wind(around > 0.01, "wind must continue around a wall");
    difference_x: f32 = blocked.vx[center - 1] - clear.vx[center - 1];
    difference_z: f32 = blocked.vz[center - 1] - clear.vz[center - 1];
    if (difference_x < 0.0) difference_x = 0.0 - difference_x;
    if (difference_z < 0.0) difference_z = 0.0 - difference_z;
    check_wind(difference_x + difference_z > 0.0001, "a wall must alter nearby airflow");
    check_wind(wind_energy(blocked) > 1.0, "obstacles must not collapse the field");
    steady: *WindField = new_wind_field(7);
    wind_prepare(steady, 0.0, 0.0, wall, 1, 1000);
    heap: int = l8_heap_used();
    for frame in 1..180 wind_prepare(steady, frame as f32 * 0.02, 0.0, wall, 1, 1000 + frame * 16);
    check_wind(l8_heap_used() == heap, "wind updates must not allocate after startup");
    check_wind(steady.weather.dir_x * steady.weather.dir_x + steady.weather.dir_z * steady.weather.dir_z > 0.999,
        "weather direction must stay normalized");
    timed: *WindField = new_wind_field(8);
    timed.start_ms = 340000000;
    frame_time: f32 = wind_visual_time(timed, 340000016) - wind_visual_time(timed,
        340000000);
    check_wind(frame_time > 0.0159 && frame_time < 0.0161, "visual wind clock must retain frame precision after long uptime");
    write(1, "wind solver tests passed\n", len("wind solver tests passed\n"));
    0
    //% expect: "wind solver tests passed\n"
}
