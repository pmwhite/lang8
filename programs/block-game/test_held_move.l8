tag block_game;

use_tag gl, x11, freetype;

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

check(ok: bool, message: []i8) {
    if (!ok) die(message)
}

main(): int {
    direction: HeldDirection = held_play_direction(false, true, false, false, 1, 0);
    check(direction.active && direction.dc == 1, "held direction continues at boundary");
    direction = held_play_direction(true, true, false, false, 1, 0);
    check(direction.active && direction.dc == 1, "last pressed held direction wins");
    direction = held_play_direction(true, false, false, false, 1, 0);
    check(direction.active && direction.dc == -1, "released preferred direction falls back to held key");
    direction = held_play_direction(false, false, false, false, 1, 0);
    check(!direction.active, "released key does not continue movement");
    check(move_anim_t(200, 200, 200) == 0.0, "animation begins at boundary");
    t: f32 = move_anim_t(216, 200, 200);
    check(t > 0.079 && t < 0.081, "next frame advances chained move immediately");
    check(move_anim_t(500, 200, 200) == 1.0, "animation clamps after a hitch");
    write(1, "held movement tests passed\n", 27);
    0
    //% expect: "held movement tests passed\n"
}
