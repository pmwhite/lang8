tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

held_show(label: str, direction: HeldDirection) raises IoError {
    write(1, label);
    write(1, ": ");
    if (direction.active) {
        write(1, "move dc=");
        write_int(1, direction.dc);
        write(1, " dr=");
        write_int(1, direction.dr);
        write(1, "\n")
    } else write(1, "stop\n")
}

held_show_t(label: str, t: f32) raises IoError {
    write(1, label);
    write(1, ": ");
    write_fixed(1, t as f64, 4);
    if (t == 0.0) write(1, " (exactly 0)");
    if (t == 1.0) write(1, " (exactly 1)");
    write(1, "\n")
}

test "held keys choose the next move direction" {
    // Arguments: held left, right, up, down; then the preferred direction.
    held_show("right held, prefer right", held_play_direction(false, true, false,
        false, 1, 0));
    held_show("left and right held, prefer right", held_play_direction(true, true,
        false, false, 1, 0));
    held_show("left held, prefer right", held_play_direction(true, false, false, false,
        1, 0));
    held_show("nothing held, prefer right", held_play_direction(false, false, false,
        false, 1, 0));
    expect {|
        right held, prefer right: move dc=1 dr=0
        left and right held, prefer right: move dc=1 dr=0
        left held, prefer right: move dc=-1 dr=0
        nothing held, prefer right: stop
    |}
}

test "move animation progress" {
    // move_anim_t(now, started, duration) with a 200 ms move started at 200.
    held_show_t("at the boundary", move_anim_t(200, 200, 200));
    held_show_t("one 16 ms frame later", move_anim_t(216, 200, 200));
    held_show_t("after a hitch", move_anim_t(500, 200, 200));
    expect {|
        at the boundary: 0.0000 (exactly 0)
        one 16 ms frame later: 0.0800
        after a hitch: 1.0000 (exactly 1)
    |}
}
