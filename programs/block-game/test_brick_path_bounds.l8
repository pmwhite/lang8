tag block_game;

use_tag std;

use_tag gl, x11, freetype;

import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

main() raises IoError: int {
    path_c: []int = new int[BRICK_PATH_CAP](0);
    path_r: []int = new int[BRICK_PATH_CAP](0);
    for x in 0..65 {
        path_c[x] = x;
        path_r[x] = 0
    }
    for y in 1..65 {
        i: int = 64 + y;
        path_c[i] = 64;
        path_r[i] = y
    }
    for x in 0..64 {
        i: int = 129 + x;
        path_c[i] = 63 - x;
        path_r[i] = 64
    }
    for y in 0..63 {
        i: int = 193 + y;
        path_c[i] = 0;
        path_r[i] = 63 - y
    }
    px: []f32 = new f32[BRICK_PATH_CAP + 1](0.0);
    pz: []f32 = new f32[BRICK_PATH_CAP + 1](0.0);
    bricks: []Brick = new Brick[0](Brick { column: 0, row: 0 });
    used: []int = new int[0](0);
    n: int = chain_to_points(bricks, 0, used, path_c, path_r, BRICK_PATH_CAP, px,
        pz);
    if (n != 5 || px[0] != px[4] || pz[0] != pz[4]) die("closed brick path at capacity");
    print("brick path bounds passed");
    0
    //% expect: "brick path bounds passed\n"
}
