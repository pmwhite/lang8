tag block_game;

use_tag gl, x11, freetype;

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

extern glGetError(): int;

extern glGetBufferSubData(
    target: int,
    offset: int,
    size: int,
    data: *f32
): int;

check(ok: bool, message: []i8) {
    if (!ok) die(message);
}

main(): int {
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) die("GPU fluid tests need DISPLAY");
    d: *i8 = d0;
    attrs: []i32 = [4i32, 0i32];
    v0: ?*XVisualInfo = glXChooseVisual(d, XDefaultScreen(d), attrs);
    if (v0 == null) return 2;
    v: *XVisualInfo = v0;
    win: int = XCreateSimpleWindow(d, XRootWindow(d, XDefaultScreen(d)), 0, 0, 16,
        16, 0, 0, 0);
    ctx0: ?*i8 = glXCreateContext(d, v, null, 1);
    if (ctx0 == null) return 3;
    ctx: *i8 = ctx0;
    check(glXMakeCurrent(d, win, ctx) != 0, "GPU test context");
    g: *GpuFluid = new_gpu_fluid();
    check(g.supported, "GPU tests require GL 4.3");
    ground: []GroundCell = [GroundCell {
        column: -2,
        row: -2,
        style: GROUND_WATER,
        stone: 0
    }, GroundCell {
        column: -1,
        row: -2,
        style: GROUND_WATER,
        stone: 0
    }, GroundCell {
        column: 2,
        row: 2,
        style: GROUND_WATER,
        stone: 0
    }];
    fluid_prepare(g.seed, ground, 3, 0, 0);
    gpu_fluid_seed(g);
    reference: *Fluid = new_fluid();
    fluid_prepare(reference, ground, 3, 0, 0);
    check(g.ponds == 2, "connected cells share a pond; distant cells have independent ponds");
    capacity: []GroundCell = new GroundCell[256](GroundCell {
        column: 0,
        row: 0,
        style: GROUND_WATER,
        stone: 0
    });
    for z in 0..16 {
        for x in 0..16 {
            capacity[z * 16 + x].column = x;
            capacity[z * 16 + x].row = z;
        }
    }
    heap: int = l8_heap_used();
    for i in 0..g.ponds g.commands[i * 4] = 1.0;
    gpu_fluid_commands(g);
    gpu_fluid_step(g);
    fluid_step(reference);
    glMemoryBarrier(512);
    glBindBuffer(37074, g.buffers[0]);
    glGetBufferSubData(37074, 0, g.seed.n * 64, g.packed);
    for i in 0..g.seed.n {
        p: *FluidParticle = &reference.p[i];
        at: int = i * 16;
        dx: f32 = p.x - g.packed[at];
        dy: f32 = p.y - g.packed[at + 1];
        dz: f32 = p.z - g.packed[at + 2];
        check(dx * dx + dy * dy + dz * dz < 0.000001, "GPU step matches CPU reference");
    }
    // Pause one pond. Its particles must remain bit-identical, even during a splash elsewhere.
    id: int = g.packed[3] as int;
    other: int = 1 - id;
    before: f32 = g.packed[1];
    g.commands[id * 4] = 0.0;
    g.commands[other * 4 + 1] = 2.4;
    g.commands[other * 4 + 2] = 2.5;
    g.commands[other * 4 + 3] = 2.5;
    gpu_fluid_commands(g);
    gpu_fluid_step(g);
    g.commands[other * 4 + 1] = 0.0;
    gpu_fluid_commands(g);
    for step in 0..30 gpu_fluid_step(g);
    glMemoryBarrier(512);
    glBindBuffer(37074, g.buffers[0]);
    glGetBufferSubData(37074, 0, g.seed.n * 64, g.packed);
    check(g.packed[1] == before, "offscreen pond does not advance");
    // Reinitialize, settle for several seconds, then inspect GPU-owned sleep flags.
    gpu_fluid_seed(g);
    for id2 in 0..g.ponds g.commands[id2 * 4] = 1.0;
    gpu_fluid_commands(g);
    for step in 0..600 gpu_fluid_step(g);
    glMemoryBarrier(512);
    glBindBuffer(37074, g.buffers[3]);
    glGetBufferSubData(37074, 0, 1024, g.packed);
    check(g.packed[0] == 0.0 && g.packed[4] == 0.0, "settled ponds enter GPU sleep");
    g.commands[1] = 2.4;
    g.commands[2] = -1.5;
    g.commands[3] = -1.5;
    gpu_fluid_commands(g);
    gpu_fluid_step(g);
    glMemoryBarrier(512);
    glBindBuffer(37074, g.buffers[3]);
    glGetBufferSubData(37074, 0, 1024, g.packed);
    check(g.packed[0] != 0.0 && g.packed[4] == 0.0, "impulse wakes only its pond");
    g.commands[1] = 0.0;
    gpu_fluid_commands(g);
    for step in 0..20 gpu_fluid_step(g);
    glMemoryBarrier(512);
    glBindBuffer(37074, g.buffers[0]);
    glGetBufferSubData(37074, 0, g.seed.n * 64, g.packed);
    for i in 0..g.seed.n {
        for k in 0..3 {
            value: f32 = g.packed[i * 16 + k];
            check(value == value && value > -100.0 && value < 100.0, "finite GPU particles");
        }
        check(g.packed[i * 16 + 1] >= -0.4371 && g.packed[i * 16 + 1] <= 1.6501, "GPU collision bounds");
    }
    fluid_prepare(g.seed, capacity, 256, 8, 8);
    gpu_fluid_seed(g);
    check(g.seed.n == FLUID_CAP && g.ponds == 1, "full-capacity GPU pond");
    g.commands[0] = 1.0;
    g.commands[1] = 2.4;
    g.commands[2] = 0.5;
    g.commands[3] = 0.5;
    gpu_fluid_commands(g);
    gpu_fluid_step(g);
    g.commands[1] = 0.0;
    gpu_fluid_commands(g);
    for step in 0..180 {
        if (step % 30 == 0) g.commands[1] = 2.4; else g.commands[1] = 0.0;
        gpu_fluid_commands(g);
        gpu_fluid_step(g);
    }
    glMemoryBarrier(512);
    glBindBuffer(37074, g.buffers[3]);
    glGetBufferSubData(37074, 0, 1024, g.packed);
    check(g.packed[3] == 0.0, "full-capacity neighbors do not overflow");
    glBindBuffer(37074, g.buffers[0]);
    glGetBufferSubData(37074, 0, g.seed.n * 64, g.packed);
    for i in 0..g.seed.n {
        for k in 0..3 {
            value: f32 = g.packed[i * 16 + k];
            check(value == value && value > -100.0 && value < 100.0, "capacity stress stays finite");
        }
        check(g.packed[i * 16 + 1] >= -0.4371 && g.packed[i * 16 + 1] <= 1.6501, "capacity stress respects collision domain");
    }
    // More than one compute workgroup of independent ponds: initialization
    // and commands must cover IDs 128..255 too.
    for i in 0..256 {
        capacity[i].column = i % 15 * 2 + i / 15 % 2;
        capacity[i].row = i / 15;
    }
    fluid_prepare(g.seed, capacity, 256, 15, 9);
    gpu_fluid_seed(g);
    check(g.ponds == 256 && g.seed.n == 27648, "full budget of independent ponds");
    glMemoryBarrier(512);
    glBindBuffer(37074, g.buffers[3]);
    glGetBufferSubData(37074, 0, 4096, g.packed);
    for id2 in 0..g.ponds check(g.packed[id2 * 4] != 0.0, "every independent pond initializes awake");
    // Force sleeping metadata to exercise the last command slot without relying
    // on every translated pond settling on exactly the same frame.
    for i in 0..1024 g.packed[i] = 0.0;
    glBufferSubData(37074, 0, 4096, g.packed);
    for id2 in 0..g.ponds g.commands[id2 * 4] = 1.0;
    g.commands[1021] = 2.4;
    g.commands[1022] = 0.5;
    g.commands[1023] = 17.5;
    gpu_fluid_commands(g);
    gpu_fluid_step(g);
    glMemoryBarrier(512);
    glBindBuffer(37074, g.buffers[3]);
    glGetBufferSubData(37074, 0, 4096, g.packed);
    check(g.packed[1020] != 0.0 && g.packed[0] == 0.0, "last pond command wakes only its target");
    check(l8_heap_used() == heap, "GPU updates allocate after initialization");
    check(glGetError() == 0, "GPU fluid GL error");
    glXMakeCurrent(d, 0, null);
    glXDestroyContext(d, ctx);
    XDestroyWindow(d, win);
    XCloseDisplay(d);
    write(1, "GPU fluid tests passed\n", len("GPU fluid tests passed\n"));
    0;
}
