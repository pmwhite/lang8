tag block_game;

use_tag gl, x11, freetype;

import "../gl/gl.l8";

import "../freetype/ft.l8";

import "level.l8";

import "block-game-undo.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

check(ok: bool, message: []i8) {
    if (!ok) die(message)
}

main(): int {
    f: *Fluid = new_fluid();
    ground: []GroundCell = new GroundCell[256](GroundCell {
        column: 0,
        row: 0,
        style: GROUND_WATER,
        stone: 0
    });
    for z in 0..16 {
        for x in 0..16 {
            ground[z * 16 + x].column = x - 8;
            ground[z * 16 + x].row = z - 8
        }
    }
    check(fluid_prepare(f, ground, 256, 0, 0), "first fluid prepare");
    check(f.n == FLUID_CAP && f.cells == FLUID_TILE_CAP, "particle capacity enforced");
    check(!fluid_prepare(f, ground, 256, 1, 1), "camera movement must preserve fluid");
    ground[0].column = -2;
    ground[0].row = -3;
    ground[1].column = -1;
    ground[1].row = -3;
    ground[2].column = -2;
    ground[2].row = -2;
    ground[3].column = -1;
    ground[3].row = -2;
    check(fluid_prepare(f, ground, 4, -1, -2), "terrain edits reset simulation");
    check(f.n == 432 && fluid_tile(f, -2, -3) && !fluid_tile(f, 1, 1), "negative-coordinate topology");
    heap: int = l8_heap_used();
    fluid_neighbors(f);
    for i in 0..f.n {
        check(f.counts[i] > 0 && f.counts[i] < FLUID_NEIGHBORS, "3D neighborhood populated");
        for a in 0..f.counts[i] {
            for b in 0..a check(f.neighbors[i * FLUID_NEIGHBORS + a] != f.neighbors[i * FLUID_NEIGHBORS + b],
                "duplicate hash neighbor")
        }
    }
    check(fluid_advance(f, FLUID_DT * 0.4) == 0, "fixed timestep accumulates");
    check(fluid_advance(f, FLUID_DT * 0.7) == 1, "fixed timestep advances");
    for step in 0..120 fluid_step(f);
    maxy: f32 = -10.0;
    miny: f32 = 10.0;
    for i in 0..f.n {
        p: FluidParticle = f.p[i];
        check(p.x == p.x && p.y == p.y && p.z == p.z, "finite particles");
        check(p.y >= -0.4371 && p.y < 0.6, "settled volume remains bounded");
        check(fluid_tile(f, floor_i(p.x), floor_i(p.z)) || p.y >= 0.049, "particles cannot leak through dry terrain");
        if (p.y > maxy) maxy = p.y;
        if (p.y < miny) miny = p.y
    }
    check(maxy - miny > 0.2, "fluid retains multiple vertical layers");
    fluid_impulse(f, -1.8, -2.8, 2.4);
    for step in 0..40 fluid_step(f);
    raised: int = 0;
    for i in 0..f.n {
        if (f.p[i].y > 0.06) raised = raised + 1
    }
    check(raised > 0, "impulse creates actual airborne water");
    check(f.n == 432, "splash conserves particle mass");
    check(fluid_advance(f, 10.0) == 2 && f.dropped_us > 0, "hitch catch-up is bounded");
    for step in 0..120 {
        if (step % 12 == 0) fluid_impulse(f, -1.5, -2.5, 4.0);
        fluid_step(f);
        for i in 0..f.n {
            p: FluidParticle = f.p[i];
            check(p.x == p.x && p.y == p.y && p.z == p.z, "repeated splashes stay finite");
            check(p.y >= -0.4371 && p.y <= 1.6501, "repeated splashes stay in reconstruction domain");
            check(fluid_tile(f, floor_i(p.x), floor_i(p.z)) || p.y >= 0.049, "repeated splashes cannot leak into banks")
        }
    }
    check(f.overflow == 0, "no truncated particle neighborhoods");
    check(l8_heap_used() == heap, "simulation allocates after startup");
    check(fluid_prepare(f, ground, 0, -1, -2) && f.n == 0, "erasing water clears particles");
    check(fluid_advance(f, 1.0) == 0, "dry view skips simulation");
    check(fluid_prepare(f, ground, 4, 100, 100) && f.n == 0, "distant camera resets bounded window");
    check(fluid_prepare(f, ground, 4, -1, -2) && f.n == 432, "returning camera restores pond");
    write(1, "fluid solver tests passed\n", len("fluid solver tests passed\n"));
    0
}
