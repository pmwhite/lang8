tag block_game;
use_tag gl, x11, freetype;

// Editor input, world mutations, previews, and room transforms.
text_push(s: []i8, c: i8): []i8@new {
    out: []i8 = new i8[len(s) + 1](0i8);
    if (len(s) > 0) {
        memcpy(out, 0, s, 0, len(s));
    }
    out[len(s)] = c;
    out;
}

text_pop(s: []i8): []i8@new {
    n: int = len(s) - 1;
    if (n < 0) {
        n = 0;
    }
    out: []i8 = new i8[n](0i8);
    if (n > 0) {
        memcpy(out, 0, s, 0, n);
    }
    out;
}

type GridStep = {
    dc: int;
    dr: int;
};

type CursorPose = {
    lean_x: f32;
    y: f32;
    lean_z: f32;
};

editor_arrow_step(ks: int, camera_turn: int): GridStep {
    dc: int = 0;
    dr: int = 0;
    if (ks == 65361) {
        dc = 0 - 1;
    } else if (ks == 65363) {
        dc = 1;
    } else if (ks == 65362) {
        dr = 0 - 1;
    } else if (ks == 65364) {
        dr = 1;
    }
    turn: int = camera_turn % 4;
    if (turn == 1) {
        return GridStep { dc: dr, dr: 0 - dc };
    } else if (turn == 2) {
        return GridStep { dc: 0 - dc, dr: 0 - dr };
    } else if (turn == 3) {
        return GridStep { dc: 0 - dr, dr: dc };
    }
    GridStep { dc: dc, dr: dr };
}

editor_cursor_pose(
    hist: []Block,
    n: int,
    col: int,
    row: int
): CursorPose {
    pose: CursorPose = CursorPose { lean_x: 0.0, y: 0.02, lean_z: 0.0 };
    top: int = highest_layer_at(hist, n, col, row);
    if (top < 0) {
        return pose;
    }
    seated: int = 0;
    hi: int = body_at_layer(hist, n, col, row, top);
    if (hi < 0) {
        hi = block_at_layer(hist, n, col, row, top);
    }
    if (hi >= 0) {
        hb: Block = hist[hi];
        seated = hb.mounted;
    }
    lp: int = stack_lean(hist, 0, n, col, row, top, seated);
    ld: int = lean_dir(lp);
    lk: f32 = lean_k(lp) as f32;
    lx0: f32 = ramp_face_x(ld);
    lz0: f32 = ramp_face_z(ld);
    layer: int = cursor_layer_at(hist, n, col, row);
    pose.lean_x = lean_along(lx0, lz0, lk, 0);
    pose.y = layer as f32 + 1.02 + lean_along(lx0, lz0, lk, 1);
    pose.lean_z = lean_along(lx0, lz0, lk, 2);
    pose;
}

type Brush =
    | Dirt
    | Grass
    | TallGrass
    | Stone
    | Block
    | Ramp
    | Brick
    | Goal
    | Start
    | RoomStart
    | Lamp
    | Water
    | Plant
    | Sand
    | LooseSand;

type BrushEdit = {
    nblocks: int;
    nbricks: int;
    ngoals: int;
    nground: int;
    nrooms: int;
    spawn: Cell;
    mesh_changed: bool;
    mask_changed: bool;
};

BRUSH_SLOT_N: int = 25;

brush_shape_from_key(ks: int): int {
    if (ks == 55) {
        return 15;
    }
    ks - 48;
}

set_brick_at(
    bricks: []Brick,
    nbrick: int,
    column: int,
    row: int,
    want: bool
): int {
    have: bool = is_brick(bricks, nbrick, column, row);
    if (have == want) {
        return nbrick;
    }
    toggle_brick(bricks, nbrick, column, row);
}

set_goal_at(
    goals: []Goal,
    ngoal: int,
    column: int,
    row: int,
    want: bool
): int {
    have: bool = is_goal(goals, ngoal, column, row);
    if (have == want) {
        return ngoal;
    }
    toggle_goal(goals, ngoal, column, row);
}

erase_block_aspect(
    blocks: []Block,
    n: int,
    col: int,
    row: int
): int {
    layer: int = highest_layer_at(blocks, n, col, row);
    while (layer >= 0-1) {
        hit: int = body_at_layer(blocks, n, col, row, layer);
        if (hit < 0) {
            hit = block_at_layer(blocks, n, col, row, layer);
        }
        if (hit >= 0 && blocks[hit].ramp == 0 && !plant_block(blocks[hit])) {
            n = delete_at(blocks, n, hit);
            apply_gravity(blocks, n);
            return n;
        }
        layer = layer - 1;
    }
    n;
}

erase_ramp_aspect(
    blocks: []Block,
    n: int,
    col: int,
    row: int
): int {
    layer: int = highest_layer_at(blocks, n, col, row);
    while (layer >= 0-1) {
        hit: int = block_at_layer(blocks, n, col, row, layer);
        if (hit >= 0 && blocks[hit].ramp != 0) {
            n = delete_at(blocks, n, hit);
            apply_gravity(blocks, n);
            return n;
        }
        layer = layer - 1;
    }
    n;
}

paint_ramp_aspect(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    dir: int
): int {
    if (dir < 1 || dir > 4) {
        dir = 1;
    }
    top: int = highest_layer_at(blocks, n, col, row);
    wl: int = 0;
    if (top >= 0) {
        wl = top + 1;
    }
    wn: int = add_block_at(blocks, n, col, row, wl, 0, dir);
    if (wn != n) {
        n = wn;
        apply_gravity(blocks, n);
    }
    n;
}

apply_editor_brush(
    blocks: []Block,
    n: int,
    bricks: []Brick,
    nbrick: int,
    goals: []Goal,
    ngoal: int,
    ground: []GroundCell,
    nground: int,
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    spawn: Cell,
    col: int,
    row: int,
    brush: Brush,
    shape: int,
    erase: int,
    is_world: int,
    room_starts: []RoomStart
): BrushEdit {
    mesh: int = 0;
    mask: int = 0;
    if (is_world == 0 && (brush == Brush.Block || brush == Brush.Ramp || brush == Brush.Brick || brush == Brush.Goal || brush == Brush.Plant)) {
        nroom = grow_room_to(rooms, titles, nroom, col, row);
    }
    if (brush == Brush.Dirt || brush == Brush.Grass || brush == Brush.Sand || brush == Brush.TallGrass ||
        brush == Brush.Stone || brush == Brush.Water) {
        kind: int = GROUND_DIRT;
        if (brush == Brush.Grass) {
            kind = GROUND_GRASS;
        } else if (brush == Brush.TallGrass) {
            kind = GROUND_TALL_GRASS;
        } else if (brush == Brush.Sand) {
            kind = GROUND_SAND;
        } else if (brush == Brush.Stone) {
            kind = GROUND_STONE;
        } else if (brush == Brush.Water) {
            kind = GROUND_WATER;
        }
        if (erase != 0) {
            if (brush == Brush.Grass || brush == Brush.Sand || brush == Brush.TallGrass || brush == Brush.Water) {
                kind = GROUND_DIRT;
            } else if (brush == Brush.Stone) {
                kind = GROUND_CLEAR_STONE;
            }
        }
        if ((erase == 0 || brush != Brush.Dirt) &&
            (brush != Brush.Water || erase == 0 || is_water(ground, nground, col, row))) {
            allowed: bool=true;
            if(kind==GROUND_WATER) {
                for i in 0..n { if(plant_block(blocks[i]) && blocks[i].column==col && blocks[i].row==row) { allowed=false; } }
            }
            if(is_water(ground,nground,col,row) && kind!=GROUND_WATER && kind!=GROUND_CLEAR_STONE &&
                block_at_layer(blocks,n,col,row,0-1)>=0) {
                // Filling a pond raises its whole occupied column. Refuse an
                // over-height fill rather than overlapping or deleting blocks.
                if(highest_layer_at(blocks,n,col,row)>=LEVEL_MAX_LAYER-1) { allowed=false; }
                else { for i in 0..n { if(blocks[i].column==col && blocks[i].row==row) {
                    b: Block=blocks[i]; b.layer=b.layer+1; blocks[i]=b;
                } } mesh=1; }
            }
            if(allowed) { nground = paint_ground_cell(ground, nground, col, row, kind, 0); mask = 1; }
        }
    } else if (brush == Brush.Plant) {
        n=plant_edit(blocks,n,bricks,nbrick,ground,nground,col,row,shape,erase);
        mesh=1;
    } else if (brush == Brush.Block) {
        if (erase != 0) {
            n = erase_block_aspect(blocks, n, col, row);
        } else {
            wl: int = free_layer_at(blocks, n, col, row, 0);
            wn: int = add_block_at(blocks, n, col, row, wl, shape, 0);
            if (wn != n) {
                n = wn;
                apply_gravity(blocks, n);
            }
        }
    } else if (brush == Brush.Ramp) {
        if (erase != 0) {
            n = erase_ramp_aspect(blocks, n, col, row);
        } else {
            n = paint_ramp_aspect(blocks, n, col, row, shape);
        }
    } else if (brush == Brush.Brick) {
        if (erase != 0) {
            nbrick = set_brick_at(bricks, nbrick, col, row, false);
        } else {
            if(plant_at(blocks,n,col,row)<0 || body_at_layer(blocks,n,col,row,0)<0) {
                nbrick = set_brick_at(bricks, nbrick, col, row, true);
            }
        }
        mesh = 1;
    } else if (brush == Brush.Goal) {
        if (erase != 0) {
            ngoal = set_goal_at(goals, ngoal, col, row, false);
        } else if (is_world == 0 || room_at(rooms, nroom, col, row) >= 0) {
            ngoal = set_goal_at(goals, ngoal, col, row, true);
        }
    } else if (brush == Brush.Start) {
        if (erase == 0) {
            spawn.column = col;
            spawn.row = row;
        }
    } else if (brush == Brush.RoomStart) {
        ri_s: int = room_at(rooms, nroom, col, row);
        if (ri_s >= 0 && ri_s < LEVEL_MAX_ROOMS) {
            if (erase == 0) {
                room_starts[ri_s] = RoomStart { column: col, row: row, present: true };
            } else {
                rs: RoomStart = room_starts[ri_s];
                rs.present = false;
                room_starts[ri_s] = rs;
            }
        }
    }
    BrushEdit {
        nblocks: n,
        nbricks: nbrick,
        ngoals: ngoal,
        nground: nground,
        nrooms: nroom,
        spawn: spawn,
        mesh_changed: mesh != 0,
        mask_changed: mask != 0
    };
}

apply_editor_brush_rect(
    blocks: []Block,
    n: int,
    bricks: []Brick,
    nbrick: int,
    goals: []Goal,
    ngoal: int,
    ground: []GroundCell,
    nground: int,
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    spawn: Cell,
    c0: int,
    r0: int,
    c1: int,
    r1: int,
    brush: Brush,
    shape: int,
    erase: int,
    is_world: int,
    room_starts: []RoomStart
): BrushEdit {
    if (c1 < c0) {
        t: int = c0;
        c0 = c1;
        c1 = t;
    }
    if (r1 < r0) {
        t: int = r0;
        r0 = r1;
        r1 = t;
    }
    mesh: int = 0;
    mask: int = 0;
    r: int = r0;
    while (r <= r1) {
        c: int = c0;
        while (c <= c1) {
            cell: BrushEdit = apply_editor_brush(blocks, n, bricks, nbrick, goals, ngoal,
                ground, nground, rooms, titles, nroom, spawn, c, r, brush, shape, erase,
                is_world, room_starts);
            n = cell.nblocks;
            nbrick = cell.nbricks;
            ngoal = cell.ngoals;
            nground = cell.nground;
            nroom = cell.nrooms;
            spawn = cell.spawn;
            if (cell.mesh_changed) {
                mesh = 1;
            }
            if (cell.mask_changed) {
                mask = 1;
            }
            c = c + 1;
        }
        r = r + 1;
    }
    BrushEdit {
        nblocks: n,
        nbricks: nbrick,
        ngoals: ngoal,
        nground: nground,
        nrooms: nroom,
        spawn: spawn,
        mesh_changed: mesh != 0,
        mask_changed: mask != 0
    };
}

apply_level_brush_rect(
    state: *LevelState,
    c0: int,
    r0: int,
    c1: int,
    r1: int,
    brush: Brush,
    shape: int,
    erase: int,
    is_world: int
): BrushEdit {
    if (brush == Brush.LooseSand) {
        sand_paint(state,c0,r0,c1,r1,erase!=0);
        return BrushEdit { nblocks: state.nblocks, nbricks: state.nbricks,
            ngoals: state.ngoals, nground: state.nground, nrooms: state.nrooms,
            spawn: state.spawn, mesh_changed: false, mask_changed: false };
    }
    if (brush == Brush.Lamp) {
        if (c0 > c1) { t: int = c0; c0 = c1; c1 = t; }
        if (r0 > r1) { t: int = r0; r0 = r1; r1 = t; }
        for r in r0..r1 + 1 {
            for c in c0..c1 + 1 {
                state.nlamps = set_lamp(state.lamps, state.nlamps, c, r, shape, erase == 0);
            }
        }
        return BrushEdit { nblocks: state.nblocks, nbricks: state.nbricks,
            ngoals: state.ngoals, nground: state.nground, nrooms: state.nrooms,
            spawn: state.spawn, mesh_changed: false, mask_changed: false };
    }
    edit: BrushEdit = apply_editor_brush_rect(state.blocks, state.nblocks, state.bricks, state.nbricks,
        state.goals, state.ngoals, state.ground, state.nground, state.rooms, state.titles,
        state.nrooms, state.spawn, c0, r0, c1, r1, brush, shape, erase, is_world,
        state.room_starts);
    state.nblocks = edit.nblocks;
    state.nbricks = edit.nbricks;
    state.ngoals = edit.ngoals;
    state.nground = edit.nground;
    state.nrooms = edit.nrooms;
    state.spawn = edit.spawn;
    if(erase==0 && (brush==Brush.Water || brush==Brush.Brick)) {
        for i in 0..state.sand.n {
            c: int=sand_tile(state.sand.x[i]); r: int=sand_tile(state.sand.z[i]);
            if(is_water(state.ground,state.nground,c,r) || is_brick(state.bricks,state.nbricks,c,r)) {
                sand_set(state.sand,state.sand.x[i],state.sand.z[i],0);
            }
        }
    }
    apply_level_gravity(state);
    // A terrain edit can now move blocks vertically as well as change the mask.
    if (edit.mask_changed) { edit.mesh_changed = true; }
    edit;
}

in_view_cell(
    column: int,
    row: int,
    fx: f32,
    fz: f32,
    pad: f32
): bool {
    wx: f32 = column as f32 + 0.5;
    wz: f32 = row as f32 + 0.5;
    dx: f32 = wx - fx;
    dz: f32 = wz - fz;
    if (dx < 0.0) {
        dx = 0.0 - dx;
    }
    if (dz < 0.0) {
        dz = 0.0 - dz;
    }
    if (dx > 34.0 + pad || dz > 34.0 + pad) {
        return false;
    }
    true;
}

same_hist_slot(
    hist: []Block,
    a: int,
    b: int,
    n: int
): bool {
    i: int = 0;
    while (i < n) {
        x: Block = hist[a + i];
        y: Block = hist[b + i];
        if (x.id != y.id || x.column != y.column || x.row != y.row || x.layer != y.layer || x.ramp != y.ramp || x.mounted != y.mounted) {
            return false;
        }
        i = i + 1;
    }
    true;
}

hist_shifted(
    hist: []Block,
    foff: int,
    toff: int,
    i: int
): bool {
    a: Block = hist[foff + i];
    b: Block = hist[toff + i];
    if (a.column != b.column || a.row != b.row || a.layer != b.layer || a.mounted != b.mounted) {
        return true;
    }
    false;
}

upload_brick_mesh(
    buf: u32,
    verts: []f32,
    chamfer: []f32,
    bricks: []Brick,
    nbrick: int,
    used: []int
): int {
    n: int = 0;
    region {
        sn: int = fill_chamfer_cube(chamfer);
        n = fill_brick_cells(verts, 7000000, chamfer, sn, bricks, nbrick, used);
        glBindBuffer(34962, buf);
        glBufferData(34962, n * 4, verts, 35044);
    }
    n;
}

preview_room_transform(
    src: *LevelState@dst,
    dst: *LevelState,
    sel: int,
    dc: int,
    dr: int,
    rot: int,
    xy: []int
) {
    copy_level_state(dst, src);
    room: Room = src.rooms[sel];
    sand_transform(dst.sand,room,dc,dr,rot,xy);
    for i in 0..dst.nlamps {
        p: Lamp = src.lamps[i];
        if (room_contains(room, p.column, p.row)) {
            xform_local(p.column - room.x0, p.row - room.y0,
                room_size_w(room), room_size_h(room), rot, xy);
            dst.lamps[i] = Lamp { column: room.x0 + dc + xy[0],
                row: room.y0 + dr + xy[1], style: p.style };
        }
    }
    start: []int = [dst.spawn.column, dst.spawn.row];
    transform_room_contents(dst.blocks, dst.nblocks, dst.goals, dst.ngoals, dst.bricks,
        dst.nbricks, dst.ground, dst.nground, dst.rooms, sel, dc, dr, rot, start,
        xy, dst.room_starts);
    dst.spawn = Cell { column: start[0], row: start[1] };
}

paint_stamp_layer(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    brush: Brush
): int {
    if (brush == Brush.Block) {
        return free_layer_at(blocks, n, col, row, 0);
    }
    if (brush == Brush.Ramp) {
        top: int = highest_layer_at(blocks, n, col, row);
        if (top < 0) {
            return 0;
        }
        top + 1;
    } else {
        0;
    }
}

draw_paint_stamp(
    plants: *PlantRender, prog: int, vp: []f32,
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_cut: int,
    cube_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    prism_buf: u32,
    chamfer_n: int,
    shape_verts: []f32,
    px: f32,
    py: f32,
    pz: f32,
    brush: Brush,
    shape: int
) {
    y: f32 = py;
    if (brush == Brush.Dirt) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.06, pz, 0.96, 0.08, 0.96, 0.55,
            0.36, 0.18, 36);
    } else if (brush == Brush.Grass) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.06, pz, 0.96, 0.08, 0.96, 0.34,
            0.58, 0.22, 36);
    } else if (brush == Brush.Sand || brush == Brush.LooseSand) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.06, pz, 0.96, 0.08, 0.96, 0.67,
            0.58, 0.42, 36);
    } else if (brush == Brush.TallGrass) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.11, pz, 0.96, 0.18, 0.96, 0.25,
            0.50, 0.16, 36);
    } else if (brush == Brush.Stone) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.06, pz, 0.96, 0.08, 0.96, 0.58,
            0.58, 0.55, 36);
    } else if (brush == Brush.Water) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.04, pz, 0.98, 0.04, 0.98, 0.12,
            0.40, 0.46, 36);
    } else if (brush == Brush.Plant) {
        draw_plant_icon(plants,prog,vp,px,pz,shape,px+8.0,13.2,pz+13.5);
    } else if (brush == Brush.Block) {
        if (shape == 0) {
            bind_mesh(chamfer_buf);
            glUniform1f(u_cut, 1.0);
            draw_box(u_origin, u_scale, u_color, px, y, pz, 0.92, 1.0, 0.92, 0.18,
                0.62, 0.48, chamfer_n / 6);
            glUniform1f(u_cut, 0.0);
        } else {
            bind_mesh(prism_buf);
            glUniform3f(u_origin, px, y, pz);
            glUniform3f(u_scale, 1.0, 1.0, 1.0);
            glUniform3f(u_color, 0.988, 0.827, 0.302);
            nf: int = fill_prism(shape_verts, shape);
            if (nf > 0) {
                glBufferData(34962, nf * 4, shape_verts, 35040);
                glDrawArrays(4, 0, nf / 6);
            }
        }
    } else if (brush == Brush.Ramp) {
        rd: int = shape;
        if (rd < 1 || rd > 4) {
            rd = 1;
        }
        bind_mesh(ramp_buf);
        glUniform1f(u_cut, 1.0);
        glUniform3f(u_scale, 0.92, 1.0, 0.92);
        glUniform3f(u_color, 0.82, 0.48, 0.22);
        glUniform3f(u_origin, px, y, pz);
        glDrawArrays(4, (rd - 1) * (chamfer_n / 6), chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == Brush.Brick) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.42, pz, 0.22, 0.84, 0.96, 0.62,
            0.32, 0.26, 36);
    } else if (brush == Brush.Goal) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, px, 0.16, pz, 0.62, 0.18, 0.62, 0.90,
            0.74, 0.28, chamfer_n / 6);
        draw_box(u_origin, u_scale, u_color, px, 0.42, pz, 0.22, 0.22, 0.22, 0.96,
            0.82, 0.32, chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == Brush.Start) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, px, 0.55, pz, 0.86, 1.1, 0.86, 0.80,
            0.30, 0.24, chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == Brush.RoomStart) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, px, 0.42, pz, 0.70, 0.84, 0.70, 0.22,
            0.66, 0.72, chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == Brush.Lamp) {
        bind_mesh(cube_buf);
        glUniform1f(u_cut, 0.0);
        draw_lantern(u_origin, u_scale, u_color, -1, px, pz, shape);
    }
}

draw_paint_previews(
    plants: *PlantRender, prog: int, vp: []f32,
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_cut: int,
    u_ramp: int,
    u_lag: int,
    u_brick: int,
    cube_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    prism_buf: u32,
    chamfer_n: int,
    shape_verts: []f32,
    blocks: []Block,
    n: int,
    cur_c: int,
    cur_r: int,
    vis_x: f32,
    vis_y: f32,
    vis_z: f32,
    pend_c: int,
    pend_r: int,
    want_pend: int,
    brush: Brush,
    shape: int
) {
    c0: int = cur_c;
    r0: int = cur_r;
    c1: int = cur_c;
    r1: int = cur_r;
    if (want_pend != 0) {
        c0 = pend_c;
        r0 = pend_r;
    }
    if (c1 < c0) {
        t: int = c0;
        c0 = c1;
        c1 = t;
    }
    if (r1 < r0) {
        t2: int = r0;
        r0 = r1;
        r1 = t2;
    }
    glUniform2f(u_ramp, 0.0, 0.0);
    glUniform2f(u_lag, 0.0, 0.0);
    r: int = r0;
    while (r <= r1) {
        c: int = c0;
        while (c <= c1) {
            px: f32 = c as f32 + 0.5;
            pz: f32 = r as f32 + 0.5;
            if (c == cur_c && r == cur_r) {
                px = vis_x;
                pz = vis_z;
            }
            layer: int = paint_stamp_layer(blocks, n, c, r, brush);
            py: f32 = layer as f32 + 0.5;
            if (c == cur_c && r == cur_r && (brush == Brush.Block || brush == Brush.Ramp)) {
                py = vis_y + 0.48;
            }
            if (layer >= 0 && layer < LEVEL_MAX_LAYER) {
                draw_paint_stamp(plants, prog, vp, u_origin, u_scale, u_color, u_cut, cube_buf, chamfer_buf,
                    ramp_buf, prism_buf, chamfer_n, shape_verts, px, py, pz, brush,
                    shape);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    bind_mesh(cube_buf);
    glUniform1f(u_cut, 0.0);
    glUniform1f(u_brick, 0.0);
}

draw_room_start_pads(
    u_origin: int,
    u_scale: int,
    u_color: int,
    cube_buf: u32,
    room_starts: []RoomStart,
    nroom: int
) {
    bind_mesh(cube_buf);
    i: int = 0;
    while (i < nroom) {
        if (i < LEVEL_MAX_ROOMS && room_starts[i].present) {
            draw_box(u_origin, u_scale, u_color, room_starts[i].column as f32 + 0.5,
                0.08, room_starts[i].row as f32 + 0.5, 0.62, 0.10, 0.62, 0.22, 0.66,
                0.72, 36);
        }
        i = i + 1;
    }
}
