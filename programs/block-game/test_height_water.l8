tag block_game;
use_tag gl,x11,freetype;
import "../gl/gl.l8";
import "../freetype/ft.l8";
import "level.l8";
import "block-game-undo.l8";
import "block-game-play.l8";
import "block-game-editor.l8";
import "block-game-render.l8";
import "block-game-ui.l8";
extern glGetError(): int;
extern glGetBufferSubData(target: int,offset: int,size: int,data: *f32): int;
check(ok: bool,message: []i8) { if(!ok) { die(message); } }
read_water(w: *HeightWater,out: []f32) {
    glMemoryBarrier(512); glBindBuffer(37074,w.buffers[w.current]); glGetBufferSubData(37074,0,len(out)*4,out);
}
main(): int {
    d0: ?*i8=XOpenDisplay(null); if(d0==null) { die("height water tests need DISPLAY"); }
    d: *i8=d0; attrs: []i32=[4i32,12i32,24i32,0i32];
    v0: ?*XVisualInfo=glXChooseVisual(d,XDefaultScreen(d),attrs); if(v0==null) { return 2; }
    v: *XVisualInfo=v0; win: int=XCreateSimpleWindow(d,XRootWindow(d,XDefaultScreen(d)),0,0,1200,720,0,0,0);
    ctx0: ?*i8=glXCreateContext(d,v,null,1); if(ctx0==null) { return 3; }
    ctx: *i8=ctx0; check(glXMakeCurrent(d,win,ctx)!=0,"height water GL context");
    main: int=link_program("#version 120\nvoid main(){gl_Position=vec4(0.0);}","#version 120\nvoid main(){gl_FragColor=vec4(1.0);}","nrm");
    material: *MaterialLight=new_material_light(main,main); w: *HeightWater=material.water;
    light: *LampLight=new_lamp_light(main,main,main); lamps: []Lamp=new Lamp[0](Lamp {column:0,row:0,style:0});
    check(w.supported,"height water tests require compute support");
    ground: []GroundCell=new GroundCell[256](GroundCell {column:0,row:0,style:GROUND_WATER,stone:0});
    for z in 0..16 { for x in 0..16 { ground[z*16+x].column=x-8; ground[z*16+x].row=z-8; } }
    projection: []f32=new f32[16](0.0); view: []f32=new f32[16](0.0); vp: []f32=new f32[16](0.0);
    tmp: []f32=new f32[16](0.0); lvp: []f32=new f32[16](0.0); data: []f32=new f32[256*256*4](0.0);
    mat_persp(projection,2.1445,1200.0/720.0,0.4,80.0);
    mat_look(view,0.5,12.0,12.5,0.5,0.0,0.5,0.0,1.0,0.0); mat_mul(vp,projection,view,tmp);
    heap: int=l8_heap_used();
    height_water_terrain(w,ground,256,0,0,vp); check(w.cells==256,"whole 256-cell basin resident");
    w.nbodies=0; height_water_displacement(w);
    for step in 0..240 { height_water_step(w,0.0,0.0,0.0); }
    read_water(w,data);
    for i in 0..len(data) { check(data[i]==0.0,"unperturbed water remains exactly flat and stationary"); }
    // A block enters gradually, like the actual movement/fall animation.
    for frame in 0..30 {
        w.nbodies=0; height_water_body(w,0.5,0.5-(frame+1) as f32/30.0,0.5,0.46,0.5,0);
        height_water_displacement(w);
        height_water_step(w,0.0,0.0,0.0); height_water_step(w,0.0,0.0,0.0);
    }
    read_water(w,data); volume: f32=0.0; solid: f32=0.0; outside: f32=0.0;
    for i in 0..256*256 {
        h: f32=data[i*4]; check(h==h && h>=0.0-0.9201 && h<=0.7501,"block displacement stays finite and bounded");
        volume=volume+h/64.0; solid=solid+data[i*4+3]/64.0;
        x: f32=w.x as f32+(i%256) as f32/8.0; z: f32=w.z as f32+(i/256) as f32/8.0;
        if(x<0.0 || x>1.0 || z<0.0 || z>1.0) { outside=outside+h*h; }
    }
    check(solid>0.75 && solid<0.81,"rasterized submerged block volume matches its dimensions");
    error: f32=volume-solid; check(error*error<0.0004,"block entry displaces rather than creates or destroys water");
    check(outside>0.001,"displacement propagates beyond the entering block");
    for step in 0..360 { height_water_step(w,0.0,0.0,0.0); }
    // Gradual removal must draw water back into the vacated space.
    for frame in 0..30 {
        w.nbodies=0; height_water_body(w,0.5,0.0-0.5+(frame+1) as f32/30.0,0.5,0.46,0.5,0);
        height_water_displacement(w); height_water_step(w,0.0,0.0,0.0); height_water_step(w,0.0,0.0,0.0);
    }
    read_water(w,data); volume=0.0; solid=0.0;
    for i in 0..256*256 { volume=volume+data[i*4]/64.0; solid=solid+data[i*4+3]/64.0; }
    check(solid==0.0 && volume*volume<0.0004,"removing the block restores original liquid volume");
    // Player-sized body and a wedge have different, geometrically derived volumes.
    w.nbodies=0; height_water_body(w,0.5,0.0-0.45,0.5,0.43,0.55,0); height_water_displacement(w);
    height_water_step(w,0.0,0.0,0.0); read_water(w,data); solid=0.0;
    for i in 0..256*256 { solid=solid+data[i*4+3]/64.0; }
    check(solid>0.65 && solid<0.71,"wading player displaces its own submerged volume");
    w.nbodies=0; height_water_body(w,0.5,0.0-0.5,0.5,0.46,0.5,1); height_water_displacement(w);
    height_water_step(w,0.0,0.0,0.0); read_water(w,data); solid=0.0;
    for i in 0..256*256 { solid=solid+data[i*4+3]/64.0; }
    check(solid>0.38 && solid<0.46,"submerged ramp uses wedge volume rather than full cube");
    draw_height_water(w,main,vp,lvp,0.5,12.0,12.5,material,light,lamps,1);
    draw_height_water(w,main,vp,lvp,0.5,12.0,12.5,material,light,lamps,0);
    steps: int=w.steps; toggle_height_water(w); draw_height_water(w,main,vp,lvp,0.5,12.0,12.5,material,light,lamps,0);
    toggle_height_water(w); check(w.steps==steps,"static toggle preserves solver state");
    check(l8_heap_used()==heap,"height water updates do not allocate"); check(glGetError()==0,"height water GL errors");
    glXMakeCurrent(d,0,null); glXDestroyContext(d,ctx); XDestroyWindow(d,win); XCloseDisplay(d);
    write(1,"height water tests passed\n",len("height water tests passed\n")); 0;
}
