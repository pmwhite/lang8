tag block_game;
use_tag gl, x11, freetype;
import "../gl/gl.l8";
import "../freetype/ft.l8";
import "level.l8";
import "block-game-undo.l8";
import "block-game-play.l8";
import "block-game-editor.l8";
import "block-game-render.l8";
import "block-game-ui.l8";

check(ok: bool, message: []i8) { if (!ok) { die(message); } }

main(): int {
    state: *LevelState = new_level_state();
    copy: *LevelState = new_level_state();
    loaded: *LevelState = new_level_state();
    world: *WorldState = new_world_state();
    out: []int = new int[7](0);
    cell: []int = new int[7](0);
    xy: []int = new int[2](0);
    pixels: []i8 = new i8[512*512](0i8);
    pixels2: []i8 = new i8[512*512](0i8);
    state.nrooms = set_room_size(state.rooms, state.titles, 0, 12, 9);
    world.names[0] = "hearth";
    state.nlamps = parse_lamps("lamp 2 3 0\nlamp 7 6 1\nlamp 2 3 1\nlamp bad\nlamp 0 0 9\n", state.lamps);
    check(state.nlamps == 2 && state.lamps[0].style == 1, "lamp parsing and replacement");
    check(save_world_state(".build/lighting-roundtrip-world.txt", world, state) == 0, "save world lamps");
    check(load_world_state(".build/lighting-roundtrip-world.txt", world, loaded) >= 0, "load world lamps");
    check(loaded.nlamps == 2 && loaded.lamps[1].style == 1, "world lamps preserved");
    check(save_level_state(".build/lighting-roundtrip-level.txt", state) == 0, "save level lamps");
    check(load_level_state(".build/lighting-roundtrip-level.txt", loaded) >= 0, "load level lamps");
    check(loaded.nlamps == 2 && loaded.lamps[0].column == 2, "level lamps preserved");
    copy_level_state(copy, state);
    check(copy.nlamps == 2 && copy.lamps[0].style == 1, "copy lamps");
    preview_room_transform(state, copy, 0, 10, 20, 1, xy);
    check(copy.lamps[0].column == 13 && copy.lamps[0].row == 29, "rotate/translate lamps");
    check(state.lamps[0].column == 2, "preview preserves source lamps");
    state.nlamps = 0;
    apply_level_brush_rect(state, 2, 2, 0, 0, Brush.Lamp, 0, 0, 1, out, cell);
    check(state.nlamps == 9 && state.nblocks == 0 && state.nbricks == 0, "non-blocking rectangular lamp paint");
    apply_level_brush_rect(state, 2, 2, 0, 0, Brush.Lamp, 1, 0, 1, out, cell);
    check(state.nlamps == 9 && state.lamps[0].style == 1, "change lamp style without duplicates");
    apply_level_brush_rect(state, 2, 2, 0, 0, Brush.Lamp, 1, 1, 1, out, cell);
    check(state.nlamps == 0, "erase lamp rectangle");
    state.nlamps = set_lamp(state.lamps, 0, 0, 0, 0, true);
    heap: int = l8_heap_used();
    fill_lamp_light(pixels, -64, -64, state.lamps, state.nlamps);
    fill_lamp_light(pixels2, -63, -64, state.lamps, state.nlamps);
    for z in 0..512 {
        for x in 4..512 {
            check(pixels[z*512+x] == pixels2[z*512+x-4], "lamp pool moves with cache, not camera");
        }
    }
    check(pixels[258*512+258] != 0i8 && pixels[0] == 0i8, "warm pool and zero outside radius");
    state.lamps[0].style = 1;
    fill_lamp_light(pixels2, -64, -64, state.lamps, 1);
    check(pixels2[258*512+278] != pixels[258*512+278], "post pool wider than lantern");
    fill_lamp_light(pixels2, -64, -64, state.lamps, 0);
    check(pixels2[258*512+258] == 0i8, "erased lamp stops lighting");
    check(l8_heap_used() == heap, "lamp light rasterizer allocated");
    write(1, "lighting tests passed\n", 22);
    0;
}
