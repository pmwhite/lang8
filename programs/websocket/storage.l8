tag websocket_internal;

use_tag http, http_internal;

// Eight independently owned connections. Each has a 16 MiB assembly buffer
// and a 16 MiB incoming-frame buffer, so controls never overwrite fragments.
type WsDataStorage = {
    count: int;
    data: [16777216]i8
}

ws_fragments: []WsDataStorage = static_buffer([8]WsDataStorage);

ws_frames: []WsDataStorage = static_buffer([8]WsDataStorage);

ws_connection_used: []bool = static_buffer([8]bool);

ws_connection_objects: []i8 = static_buffer([128]i8);

ws_state_objects: []i8 = static_buffer([1024]i8);

ws_message_objects: []i8 = static_buffer([512]i8);

ws_fragment_objects: []i8 = static_buffer([256]i8);

extern ws_connection_at(p: *i8): *WsConnection = l8_as_int;

extern ws_state_at(p: *i8): *WsState = l8_as_int;

extern ws_message_at(p: *i8): *WsMessage = l8_as_int;

extern ws_fragment_at(p: *i8): *HttpBuffer = l8_as_int;

extern ws_data_at(p: *i8): []i8 = l8_as_int;

ws_reserve_connection(): int {
    slot: int = 0;
    while (slot < 8 && ws_connection_used[slot]) slot = slot + 1;
    if (slot == 8 || sizeof(WsConnection) > 16 || sizeof(WsState) > 128 || sizeof(WsMessage) > 64 || sizeof(HttpBuffer) > 32) http_storage_full();
    ws_connection_used[slot] = true;
    slot
}

ws_fragment_bytes(slot: int): []i8 {
    ws_fragments[slot].count = 16777216;
    ws_data_at(&ws_fragments[slot].data[0])
}

ws_frame_bytes(slot: int, size: int): []i8 {
    if (size < 0 || size > 16777216) http_storage_full();
    ws_frames[slot].count = size;
    ws_data_at(&ws_frames[slot].data[0])
}
