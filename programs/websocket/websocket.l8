tag websocket_internal;

use_tag http;

import "../http/http.l8";

// RFC 6455 WebSocket version 13. Extensions and subprotocol selection are left
// to a future API; this codec rejects extension bits and unsolicited choices.
extern l8_getrandom(buf: *i8, n: int, flags: i32): int;

tag websocket
WS_TEXT: int = 1;

tag websocket
WS_BINARY: int = 2;

tag websocket
WS_CLOSE: int = 8;

const WS_MAX_MESSAGE: int = 16777216;

type WsBuffer = {
    data: []i8;
    size: int
}

ws_buffer(): *WsBuffer@new {
    new WsBuffer { data: new i8[256](0i8), size: 0 }
}

ws_reserve(b: *WsBuffer@new, need: int): []i8@new {
    if (need <= len(b.data)) return b.data;
    cap: int = len(b.data);
    while (cap < need) {
        doubled: int = cap * 2;
        if (doubled <= cap) cap = need else cap = doubled
    }
    next: []i8 = new i8[cap](0i8);
    old_size: int = b.size;
    memcpy(next, 0, b.data, 0, old_size);
    b.* = WsBuffer { data: next, size: old_size };
    next
}

ws_push(b: *WsBuffer@new, byte: int): bool {
    slot: int = b.size;
    if (slot >= 9223372036854775807) return false;
    needed: int = slot + 1;
    data: []i8 = ws_reserve(b, needed);
    data[slot] = byte trunc i8;
    b.* = WsBuffer { data: data, size: needed };
    true
}

ws_append(b: *WsBuffer@new, data: []i8, size: int): bool {
    if (size < 0 || size > len(data) || size > WS_MAX_MESSAGE || b.size > WS_MAX_MESSAGE - size) return false;
    start: int = b.size;
    target: int = start + size;
    buffer: []i8 = ws_reserve(b, target);
    for i in 0..size buffer[start + i] = data[i];
    b.* = WsBuffer { data: buffer, size: target };
    true
}

ws_buffer_string(b: *WsBuffer): str@new {
    count: int = b.size;
    out: []i8 = new i8[count](0i8);
    for i in 0..count out[i] = b.data[i];
    cstr(out)
}

ws_random(out: []i8, size: int): bool {
    if (size < 0 || size > len(out)) return false;
    off: int = 0;
    while (off < size) {
        n: int = l8_getrandom(&out[off], size - off, 0i32);
        if (n == -4) n = 0 else {
            if (n <= 0) return false;
            next: int = off + n;
            if (next < off || next > size) return false;
            off = next
        }
    }
    true
}

ws_b64_value(c: i8): int {
    if (c >= 'A' && c <= 'Z') return c as int - 65;
    if (c >= 'a' && c <= 'z') return c as int - 71;
    if (c >= '0' && c <= '9') return c as int + 4;
    if (c == '+') return 62;
    if (c == '/') return 63;
    -1
}

ws_base64(data: []i8, size: int): str@new {
    out: *WsBuffer = ws_buffer();
    alphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    p: int = 0;
    while (p < size) {
        a: int = data[p] as int & 255;
        p = p + 1;
        b: int = 0;
        c: int = 0;
        have_b: bool = p < size;
        if (have_b) {
            b = data[p] as int & 255;
            p = p + 1
        }
        have_c: bool = p < size;
        if (have_c) {
            c = data[p] as int & 255;
            p = p + 1
        }
        if (!ws_push(out, alphabet[a >> 2] as int) || !ws_push(out, alphabet[(a & 3) << 4 | b >> 4] as int)) return "";
        if (have_b) {
            if (!ws_push(out, alphabet[(b & 15) << 2 | c >> 6] as int)) return ""
        } else {
            if (!ws_push(out, '=' as int)) return ""
        }
        if (have_c) {
            if (!ws_push(out, alphabet[c & 63] as int)) return ""
        } else {
            if (!ws_push(out, '=' as int)) return ""
        }
    }
    ws_buffer_string(out)
}

// A version-13 nonce is exactly 16 bytes encoded canonically as 24 base64 bytes.
ws_valid_key(key: str): bool {
    if (len(key) != 24) return false;
    if (key[22] != '=' || key[23] != '=') return false;
    for i in 0..22 {
        if (ws_b64_value(key[i]) < 0) return false
    }
    (ws_b64_value(key[21]) & 15) == 0
}

ws_rotl(x: u32, n: int): u32 {
    x << n | x >> 32 - n
}

ws_u32_byte(x: u32, shift: int): i8 {
    value: int = (x >> shift) as int;
    value trunc i8
}

type WsSha1State = {
    h0: u32;
    h1: u32;
    h2: u32;
    h3: u32;
    h4: u32
}

ws_sha1_block(state: *WsSha1State, input: []i8) {
    w: []u32 = new u32[80](0u32);
    for i in 0..64 {
        word: int = i / 4;
        w[word] = w[word] << 8 | (input[i] as int & 255) trunc u32
    }
    for i in 16..80 w[i] = ws_rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
    a: u32 = state.h0;
    b: u32 = state.h1;
    c: u32 = state.h2;
    d: u32 = state.h3;
    e: u32 = state.h4;
    for i in 0..80 {
        f: u32 = 0u32;
        k: u32 = 0u32;
        if (i < 20) {
            f = b & c | ~b & d;
            k = 1518500249u32
        } else {
            if (i < 40) {
                f = b ^ c ^ d;
                k = 1859775393u32
            } else {
                if (i < 60) {
                    f = b & c | b & d | c & d;
                    k = 2400959708u32
                } else {
                    f = b ^ c ^ d;
                    k = 3395469782u32
                }
            }
        }
        temp: u32 = ws_rotl(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = ws_rotl(b, 30);
        b = a;
        a = temp
    }
    state.h0 = state.h0 + a;
    state.h1 = state.h1 + b;
    state.h2 = state.h2 + c;
    state.h3 = state.h3 + d;
    state.h4 = state.h4 + e
}

ws_sha1_bytes(data: []i8, size: int): []i8@new {
    state: WsSha1State = WsSha1State {
        h0: 1732584193u32,
        h1: 4023233417u32,
        h2: 2562383102u32,
        h3: 271733878u32,
        h4: 3285377520u32
    };
    cursor: int = 0;
    done: bool = false;
    block: []i8 = new i8[64](0i8);
    digest: []i8 = new i8[20](0i8);
    while (!done) {
        remaining: int = size - cursor;
        if (remaining < 64) {
            if (cursor > 0) {
                for i in 0..64 block[i] = 0i8
            }
            memcpy(block, 0, data, cursor, remaining);
            block[remaining] = 128 trunc i8;
            if (remaining >= 56) {
                ws_sha1_block(&state, block);
                for i in 0..64 block[i] = 0i8
            }
            bits: int = size * 8;
            for i in 0..8 block[63 - i] = (bits >> i * 8) trunc i8;
            ws_sha1_block(&state, block);
            words: []u32 = [state.h0, state.h1, state.h2, state.h3, state.h4];
            for i in 0..len(words) {
                digest[i * 4] = ws_u32_byte(words[i], 24);
                digest[i * 4 + 1] = ws_u32_byte(words[i], 16);
                digest[i * 4 + 2] = ws_u32_byte(words[i], 8);
                digest[i * 4 + 3] = ws_u32_byte(words[i], 0)
            }
            done = true
        } else {
            memcpy(block, 0, data, cursor, 64);
            ws_sha1_block(&state, block);
            cursor = cursor + 64
        }
    }
    digest
}

ws_sha1(text: str): []i8@new {
    data: []i8 = bytes(text);
    ws_sha1_bytes(data, len(data))
}

ws_accept_value(key: str): str@new {
    // The handshake key is 24 bytes, followed by the 36-byte RFC 6455 GUID.
    if (len(key) != 24) return "";
    input: []i8 = new i8[60](0i8);
    for i in 0..24 input[i] = key[i];
    guid: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    for i in 0..36 input[24 + i] = guid[i];
    digest: []i8 = ws_sha1_bytes(input, len(input));
    ws_base64(digest, len(digest))
}

ws_equal_fold(a: str, b: str): bool {
    if (len(a) != len(b)) return false;
    for i in 0..len(a) {
        x: i8 = a[i];
        y: i8 = b[i];
        if (x >= 'A' && x <= 'Z') x = x + 32i8;
        if (y >= 'A' && y <= 'Z') y = y + 32i8;
        if (x != y) return false
    }
    true
}

ws_header_count(m: *HttpMessage, name: str): int {
    count: int = 0;
    for i in 0..m.count {
        if (ws_equal_fold(m.headers[i].name, name)) count = count + 1
    }
    count
}

ws_authority(host: str, port: str): ?str@new {
    ipv6: bool = false;
    for c in host {
        if (c == ':') ipv6 = true
    }
    out: *WsBuffer = ws_buffer();
    if (ipv6 && !ws_push(out, '[' as int)) return null;
    for c in host {
        if (!ws_push(out, c as int)) return null
    }
    if (ipv6 && !ws_push(out, ']' as int)) return null;
    if (!ws_push(out, ':' as int)) return null;
    for c in port {
        if (!ws_push(out, c as int)) return null
    }
    ws_buffer_string(out)
}

type WsState = {
    reader: *HttpReader;
    client: bool;
    open: bool;
    close_sent: bool;
    close_received: bool;
    fragment_opcode: int;
    fragment: *WsBuffer
}

// The state is intentionally behind an internal type so applications use the
// operations below rather than depending on codec bookkeeping.
tag websocket
type WsConnection = {
    state: *WsState
}

tag websocket
type WsMessage = {
    kind: int;
    data: []i8;
    size: int;
    close_code: int;
    error: int
}

ws_connection(reader: *HttpReader@new, client: bool): *WsConnection@new {
    new WsConnection { state: new WsState {
        reader: reader,
        client: client,
        open: true,
        close_sent: false,
        close_received: false,
        fragment_opcode: 0,
        fragment: ws_buffer()
    } }
}

ws_empty_message(): *WsMessage@new {
    new WsMessage {
        kind: 0,
        data: new i8[0](0i8),
        size: 0,
        close_code: 0,
        error: 0
    }
}

tag websocket
ws_client(host: str, port: str, target: str): ?*WsConnection@new {
    nonce: []i8 = new i8[16](0i8);
    if (!ws_random(nonce, len(nonce))) return null;
    key: str = ws_base64(nonce, len(nonce));
    optional: ?*HttpClient = http_client(host, port);
    if (optional == null) return null;
    client: *HttpClient = optional;
    authority: ?str = ws_authority(host, port);
    if (authority == null) {
        http_client_close(client);
        return null
    }
    request: *HttpMessage = http_request("GET", target, authority);
    http_add(request, "Upgrade", "websocket");
    http_add(request, "Sec-WebSocket-Key", key);
    http_add(request, "Sec-WebSocket-Version", "13");
    response: *HttpMessage = http_exchange(client, request);
    valid: bool = response.error == 0 && response.status == 101 && http_option(response,
        "connection", "upgrade") && http_option(response, "upgrade", "websocket") && ws_header_count(response,
        "sec-websocket-accept") == 1 && http_get(response, "sec-websocket-accept") == ws_accept_value(key) && !http_has(response,
        "sec-websocket-extensions") && !http_has(response, "sec-websocket-protocol");
    if (!valid) {
        http_client_close(client);
        return null
    }
    ws_connection(client.reader, true)
}

// The caller may inspect target, Origin, cookies, or authorization before accepting.
tag websocket
ws_accept(reader: *HttpReader@new, request: *HttpMessage): ?*WsConnection@new {
    key: str = http_get(request, "sec-websocket-key");
    valid: bool = request.error == 0 && request.method == "GET" && request.minor == 1 && http_option(request,
        "connection", "upgrade") && http_option(request, "upgrade", "websocket") && ws_header_count(request,
        "sec-websocket-key") == 1 && ws_valid_key(key) && ws_header_count(request,
        "sec-websocket-version") == 1 && http_get(request, "sec-websocket-version") == "13";
    if (!valid) {
        response: *HttpMessage = http_response(400);
        response.close = true;
        http_send_response(reader, request, response);
        return null
    }
    response: *HttpMessage = http_response(101);
    http_add(response, "Upgrade", "websocket");
    http_add(response, "Sec-WebSocket-Accept", ws_accept_value(key));
    reader.deadline = http_now() + HTTP_TIMEOUT_MS;
    if (!http_send_response(reader, request, response)) return null;
    ws_connection(reader, false)
}

ws_valid_utf8(data: []i8, size: int): bool {
    p: int = 0;
    while (p < size) {
        a: int = data[p] as int & 255;
        if (a < 128) p = p + 1 else {
            need: int = 0;
            min: int = 0;
            value: int = 0;
            if (a >= 194 && a <= 223) {
                need = 1;
                min = 128;
                value = a & 31
            } else {
                if (a >= 224 && a <= 239) {
                    need = 2;
                    min = 2048;
                    value = a & 15
                } else {
                    if (a >= 240 && a <= 244) {
                        need = 3;
                        min = 65536;
                        value = a & 7
                    } else return false
                }
            }
            i: int = 0;
            while (i < need) {
                p = p + 1;
                if (p >= size) return false;
                next: int = data[p] as int & 255;
                if (next < 128 || next > 191) return false;
                value = value << 6 | next & 63;
                i = i + 1
            }
            if (value < min || value > 1114111 || value >= 55296 && value <= 57343) return false;
            p = p + 1
        }
    }
    true
}

ws_valid_close_code(code: int): bool {
    if (code >= 3000 && code <= 4999) return true;
    code >= 1000 && code <= 1014 && code != 1004 && code != 1005 && code != 1006
}

ws_write_frame(
    c: *WsConnection,
    opcode: int,
    data: []i8,
    size: int
): bool {
    if (size < 0 || size > len(data) || size > WS_MAX_MESSAGE || !c.state.open && opcode != 8) return false;
    control: bool = opcode >= 8;
    if (control && size > 125) return false;
    head: *WsBuffer = ws_buffer();
    if (!ws_push(head, 128 | opcode)) return false;
    mask: int = 0;
    if (c.state.client) mask = 128;
    if (size < 126) {
        if (!ws_push(head, mask | size)) return false
    } else {
        if (size <= 65535) {
            if (!ws_push(head, mask | 126) || !ws_push(head, size >> 8) || !ws_push(head,
                size)) return false
        } else {
            if (!ws_push(head, mask | 127)) return false;
            for i in 0..8 {
                if (!ws_push(head, size >> (7 - i) * 8)) return false
            }
        }
    }
    c.state.reader.deadline = http_now() + HTTP_TIMEOUT_MS;
    if (c.state.client) {
        key: []i8 = new i8[4](0i8);
        if (!ws_random(key, 4)) return false;
        if (!ws_append(head, key, 4)) return false;
        payload: []i8 = new i8[size](0i8);
        for i in 0..size payload[i] = data[i] ^ key[i % 4];
        return http_send(c.state.reader, head.data, head.size) && http_send(c.state.reader,
            payload, size)
    }
    http_send(c.state.reader, head.data, head.size) && http_send(c.state.reader, data,
        size)
}

tag websocket
ws_send(
    c: *WsConnection,
    kind: int,
    data: []i8,
    size: int
): bool {
    if (size < 0 || size > len(data)) return false;
    if (c.state.close_sent || c.state.close_received || kind != WS_TEXT && kind != WS_BINARY) return false;
    if (kind == WS_TEXT && !ws_valid_utf8(data, size)) return false;
    ws_write_frame(c, kind, data, size)
}

tag websocket
ws_send_text(c: *WsConnection, text: str): bool {
    ws_send(c, WS_TEXT, bytes(text), len(text))
}

tag websocket
ws_send_binary(c: *WsConnection, data: []i8, size: int): bool {
    ws_send(c, WS_BINARY, data, size)
}

ws_close_payload(code: int, reason: str): []i8@new {
    out: []i8 = new i8[2 + len(reason)](0i8);
    out[0] = (code >> 8) trunc i8;
    out[1] = code trunc i8;
    for i in 0..len(reason) out[2 + i] = reason[i];
    out
}

tag websocket
ws_close(c: *WsConnection, code: int, reason: str): bool {
    if (c.state.close_sent) return true;
    if (!ws_valid_close_code(code) || len(reason) > 123 || !ws_valid_utf8(bytes(reason),
        len(reason))) return false;
    payload: []i8 = ws_close_payload(code, reason);
    ok: bool = ws_write_frame(c, 8, payload, len(payload));
    if (ok) c.state.close_sent = true;
    ok
}

ws_fail(c: *WsConnection, code: int): *WsMessage@new {
    result: *WsMessage = ws_empty_message();
    result.error = code;
    if (!c.state.close_sent && c.state.reader.error == 0) ws_close(c, code, "");
    c.state.open = false;
    result
}

ws_read_exact(c: *WsConnection, out: []i8, size: int): bool {
    if (size < 0 || size > len(out)) return false;
    for i in 0..len(out) {
        if (i >= size) return true;
        byte: int = http_read_byte(c.state.reader);
        if (byte < 0) return false;
        out[i] = byte trunc i8
    }
    true
}

tag websocket
ws_read(c: *WsConnection@new): *WsMessage@new {
    if (!c.state.open) {
        result: *WsMessage = ws_empty_message();
        result.error = 1006;
        return result
    }
    c.state.reader.deadline = http_now() + HTTP_TIMEOUT_MS;
    frames: int = 0;
    while (true) {
        frames = frames + 1;
        if (frames > 1024) return ws_fail(c, 1009);
        first: int = http_read_byte(c.state.reader);
        second: int = http_read_byte(c.state.reader);
        if (first < 0 || second < 0) {
            c.state.open = false;
            result: *WsMessage = ws_empty_message();
            result.error = 1006;
            return result
        }
        fin: bool = (first & 128) != 0;
        opcode: int = first & 15;
        masked: bool = (second & 128) != 0;
        size: int = second & 127;
        if ((first & 112) != 0 || masked == c.state.client || opcode != 0 && opcode != 1 && opcode != 2 && opcode != 8 && opcode != 9 && opcode != 10) return ws_fail(c,
            1002);
        control: bool = opcode >= 8;
        if (control && (!fin || size > 125)) return ws_fail(c, 1002);
        if (size == 126) {
            ext: []i8 = new i8[2](0i8);
            if (!ws_read_exact(c, ext, 2)) return ws_fail(c, 1006);
            size = (ext[0] as int & 255) << 8 | ext[1] as int & 255;
            if (size < 126) return ws_fail(c, 1002)
        } else {
            if (size == 127) {
                ext: []i8 = new i8[8](0i8);
                if (!ws_read_exact(c, ext, 8) || (ext[0] as int & 128) != 0) return ws_fail(c,
                    1002);
                size = 0;
                for i in 0..len(ext) {
                    if (size > WS_MAX_MESSAGE / 256) return ws_fail(c, 1009);
                    size = size * 256 + (ext[i] as int & 255)
                }
                if (size <= 65535) return ws_fail(c, 1002)
            }
        }
        if (size > WS_MAX_MESSAGE || !control && c.state.fragment.size > WS_MAX_MESSAGE - size) return ws_fail(c,
            1009);
        key: []i8 = new i8[4](0i8);
        if (masked && !ws_read_exact(c, key, 4)) return ws_fail(c, 1006);
        payload: []i8 = new i8[size](0i8);
        if (!ws_read_exact(c, payload, size)) return ws_fail(c, 1006);
        if (masked) {
            for i in 0..len(payload) payload[i] = payload[i] ^ key[i % 4]
        }
        if (opcode == 9) {
            if (!ws_write_frame(c, 10, payload, size)) return ws_fail(c, 1006)
        } else {
            if (opcode == 10) {
                // Pong is consumed by the protocol layer.
            } else {
                if (opcode == 8) {
                    if (size == 1) return ws_fail(c, 1002);
                    code: int = 1005;
                    if (size >= 2) {
                        code = (payload[0] as int & 255) * 256 + (payload[1] as int & 255);
                        if (!ws_valid_close_code(code)) return ws_fail(c, 1002);
                        // Validate only the reason; the two code bytes are not UTF-8 text.
                        reason: []i8 = new i8[size - 2](0i8);
                        for i in 2..size reason[i - 2] = payload[i];
                        if (!ws_valid_utf8(reason, len(reason))) return ws_fail(c,
                            1007)
                    }
                    if (!c.state.close_sent) {
                        ws_write_frame(c, 8, payload, size);
                        c.state.close_sent = true
                    }
                    c.state.close_received = true;
                    c.state.open = false;
                    result: *WsMessage = ws_empty_message();
                    result.kind = WS_CLOSE;
                    result.data = payload;
                    result.size = size;
                    result.close_code = code;
                    return result
                }
                if (opcode == 0) {
                    if (c.state.fragment_opcode == 0) return ws_fail(c, 1002)
                } else {
                    if (c.state.fragment_opcode != 0) return ws_fail(c, 1002);
                    c.state.fragment_opcode = opcode;
                    c.state.fragment.size = 0
                }
                if (!ws_append(c.state.fragment, payload, size)) return ws_fail(c,
                    1009);
                if (fin) {
                    kind: int = c.state.fragment_opcode;
                    c.state.fragment_opcode = 0;
                    if (kind == WS_TEXT && !ws_valid_utf8(c.state.fragment.data, c.state.fragment.size)) return ws_fail(c,
                        1007);
                    result: *WsMessage = ws_empty_message();
                    result.kind = kind;
                    result.data = c.state.fragment.data;
                    result.size = c.state.fragment.size;
                    return result
                }
            }
        }
    }
}

tag websocket
ws_connection_close(c: *WsConnection) {
    if (c.state.reader.fd >= 0) {
        http_close(c.state.reader);
        c.state.reader.fd = -1
    }
    c.state.open = false
}
