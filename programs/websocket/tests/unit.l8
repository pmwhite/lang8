tag websocket_tests;

use_tag std;

use_tag websocket, websocket_internal;

import "../../../stdlib/print.l8";

import "../websocket.l8";

failures: int = 0;

check(ok: bool, label: str) raises IoError {
    if (!ok) {
        failures = failures + 1;
        eprint(label)
    }
}

main() raises IoError: int {
    key: str = "dGhlIHNhbXBsZSBub25jZQ==";
    check(ws_valid_key(key), "RFC key validation");
    accept: str = ws_accept_value(key);
    write(1, accept);
    //% expect: "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
    one: str = ws_base64(bytes("f"), 1);
    write(1, one);
    //% expect: "Zg=="
    two: str = ws_base64(bytes("fo"), 2);
    write(1, two);
    //% expect: "Zm8="
    full: str = ws_base64(bytes("foo"), 3);
    write(1, full);
    //% expect: "Zm9v"
    abc: []i8 = ws_sha1("abc");
    digest: str = ws_base64(abc, len(abc));
    write(1, digest);
    //% expect: "qZk+NkcGgWq6PiVxeFDCbJzQ2J0="
    long_input: str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    long_digest: []i8 = ws_sha1(long_input);
    check(ws_base64(long_digest, len(long_digest)) == "80wUiDhTRqVXCboFbd0IKA3UxtY=",
        "SHA-1 across three blocks");
    check(!ws_valid_key("dGhlIHNhbXBsZSBub25jZQ=A"), "key padding validation");
    check(ws_valid_utf8(bytes("hello"), 5), "ASCII UTF-8");
    valid: []i8 = [226i8, 130i8, 172i8];
    check(ws_valid_utf8(valid, len(valid)), "multibyte UTF-8");
    overlong: []i8 = [192i8, 128i8];
    check(!ws_valid_utf8(overlong, len(overlong)), "overlong UTF-8 rejected");
    surrogate: []i8 = [237i8, 160i8, 128i8];
    check(!ws_valid_utf8(surrogate, len(surrogate)), "UTF-8 surrogate rejected");
    truncated: []i8 = [226i8, 130i8];
    check(!ws_valid_utf8(truncated, len(truncated)), "truncated UTF-8 rejected");
    check(ws_valid_close_code(1000), "normal close code");
    check(!ws_valid_close_code(1005), "reserved close code");
    if (failures == 0) print("ok");
    failures
    //% expect: "ok\n"
}
