tag websocket_tests;

use_tag std;

use_tag websocket, websocket_internal;

import "../../../stdlib/print.l8";

import "../websocket.l8";

// Write the first size bytes of data as lowercase hex, separated by sep.
ws_tests_hex(data: []i8, size: int, sep: str) raises IoError {
    digits: str = "0123456789abcdef";
    for i in 0..size {
        if (i > 0) write(1, sep);
        value: int = data[i] as int & 255;
        write_byte(1, digits[value / 16]);
        write_byte(1, digits[value % 16])
    }
}

ws_tests_utf8(label: str, data: []i8) raises IoError {
    write(1, label);
    write(1, " [");
    ws_tests_hex(data, len(data), " ");
    write(1, "]: ");
    print_bool(ws_valid_utf8(data, len(data)))
}

ws_tests_sha1(text: str) raises IoError {
    digest: []i8 = ws_sha1(text);
    write(1, "hex: ");
    ws_tests_hex(digest, len(digest), "");
    print("");
    write(1, "base64: ");
    print(ws_base64(digest, len(digest)))
}

test "RFC 6455 handshake accept value" {
    key: str = "dGhlIHNhbXBsZSBub25jZQ==";
    write(1, "key valid: ");
    print_bool(ws_valid_key(key));
    expect {|
        key valid: true
    |}
    print(ws_accept_value(key));
    expect {|
        s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
    |}
}

test "handshake keys need canonical base64 padding" {
    write(1, "nonzero bits before padding valid: ");
    print_bool(ws_valid_key("dGhlIHNhbXBsZSBub25jZQ=A"));
    expect {|
        nonzero bits before padding valid: false
    |}
}

test "base64 pads partial groups" {
    print(ws_base64(bytes("f"), 1));
    expect {|
        Zg==
    |}
    print(ws_base64(bytes("fo"), 2));
    expect {|
        Zm8=
    |}
    print(ws_base64(bytes("foo"), 3));
    expect {|
        Zm9v
    |}
}

test "SHA-1 of a single block" {
    ws_tests_sha1("abc");
    expect {|
        hex: a9993e364706816aba3e25717850c26c9cd0d89d
        base64: qZk+NkcGgWq6PiVxeFDCbJzQ2J0=
    |}
}

test "SHA-1 across three blocks" {
    ws_tests_sha1("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    expect {|
        hex: f34c1488385346a55709ba056ddd08280dd4c6d6
        base64: 80wUiDhTRqVXCboFbd0IKA3UxtY=
    |}
}

test "UTF-8 validation" {
    ws_tests_utf8("ASCII", bytes("hello"));
    expect {|
        ASCII [68 65 6c 6c 6f]: true
    |}
    ws_tests_utf8("euro sign", [226i8, 130i8, 172i8]);
    expect {|
        euro sign [e2 82 ac]: true
    |}
    ws_tests_utf8("overlong NUL", [192i8, 128i8]);
    expect {|
        overlong NUL [c0 80]: false
    |}
    ws_tests_utf8("surrogate", [237i8, 160i8, 128i8]);
    expect {|
        surrogate [ed a0 80]: false
    |}
    ws_tests_utf8("truncated", [226i8, 130i8]);
    expect {|
        truncated [e2 82]: false
    |}
}

test "close codes" {
    write(1, "1000 normal valid: ");
    print_bool(ws_valid_close_code(1000));
    expect {|
        1000 normal valid: true
    |}
    write(1, "1005 reserved valid: ");
    print_bool(ws_valid_close_code(1005));
    expect {|
        1005 reserved valid: false
    |}
}

