tag tumbledown;

use_tag std, skate_math, skate, blockmesh, blockguy, env;

// The stage: him alone on flat ground ruled in a grid (0.25 m, darker
// every metre), under the sky and sun, doing one motion, seen by a fixed
// camera, for looking at how he moves; as skate's stage (see
// programs/skate/stage.l8), with the same variables:
//
//   L8_STAGE=motion    what he does (STAGE_NAMES); the stage is on with it
//   L8_CAM=view        side (his +x), front, back, q45, top, chase, or
//                      game (the game's own camera, following him)
//   L8_CAMD=metres     how far off the camera is (6)
//   L8_FREEZE=seconds  the motion so far in, held still (see main.l8)
//
// The camera is level at his hip's height (0.45 m), with a narrow lens,
// 20 degrees high, and goes along at his speed (as a treadmill does), so
// that a foot that is down is seen to stay on the grid. He runs along -z,
// already at the motion's speed. A plain jump takes off at STAGE_JUMP_AT;
// the flips, spins and drops are off a lip STAGE_LIP_D down the stage
// (see stage_lip_height).
tag tumbledown
stage_on: bool = false;

tag tumbledown
stage_motion: int = 0;

const STAGE_IDLE: int = 0;

const STAGE_WALK: int = 1;

const STAGE_JOG: int = 2;

const STAGE_RUN: int = 3;

const STAGE_SPRINT: int = 4;

const STAGE_GATHER: int = 5;

const STAGE_JUMP: int = 6;

const STAGE_FRONTFLIP: int = 7;

const STAGE_BACKFLIP: int = 8;

const STAGE_SPIN: int = 9;

const STAGE_TUCKFLIP: int = 10;

const STAGE_DROP1: int = 11;

const STAGE_DROP3: int = 12;

const STAGE_STUMBLE: int = 13;

const STAGE_DROP2: int = 14;

// (A turn: running, then a quarter of a circle, at TURN_RATE.)
const STAGE_TURN: int = 15;

// (Running, stopping, turning on the spot, walking off, jogging, and
// stopping again: see stage_stop_start; and a jump from standing.)
const STAGE_STOP_START: int = 16;

const STAGE_STAND_JUMP: int = 17;

STAGE_NAMES: []str = ["idle", "walk", "jog", "run", "sprint", "gather", "jump", "frontflip",
    "backflip", "spin360", "tuckflip", "drop1", "drop3", "stumble", "drop2", "turn",
    "stopstart", "standjump"];

stage_speeds: []f32 = [0.0, 1.0, 2.0, 3.4, 4.5, 3.4, 3.4, 3.4, 3.4, 3.4, 3.4, 3.4,
    3.4, 3.4, 3.4, 3.4, 3.4, STAGE_STILL];

// (A speed for standing still on the stage: as near none as makes him
// stand, but not none, which would be the hill's own.)
const STAGE_STILL: f32 = 0.001;

// The turn's: from STAGE_TURN_AT, turning so fast (rad/s) for so long (a
// quarter of a circle).
const STAGE_TURN_AT: f32 = 1.0;

const STAGE_TURN_RATE: f32 = 1.2;

const STAGE_TURN_FOR: f32 = 1.3;

const CAM_SIDE: int = 0;

const CAM_FRONT: int = 1;

const CAM_BACK: int = 2;

const CAM_Q45: int = 3;

const CAM_TOP: int = 4;

const CAM_CHASE: int = 5;

// The game's own camera's place from him (see Chase, in main.l8), and its
// lens about as wide.
const CAM_GAME: int = 6;

CAM_NAMES: []str = ["side", "front", "back", "q45", "top", "chase", "game"];

stage_cam: int = CAM_SIDE;

stage_camd: f32 = 6.0;

const STAGE_JUMP_AT: f32 = 1.5;

const STAGE_LIP_D: f32 = 8.0;

// The speed he runs at on the stage (or 0, off it: see cruise, in
// runner.l8).
tag tumbledown
stage_speed: f32 = 0.0;

// From the environment: whether the stage is on, and how. An unknown
// motion or view is said, and the stage stays off.
tag tumbledown
stage_begin() raises IoError {
    if (!env_has("L8_STAGE")) return;
    stage_motion = env_choice("L8_STAGE", STAGE_NAMES);
    if (stage_motion < 0) {
        write(2, "L8_STAGE: no such motion; the stage has:");
        for name in STAGE_NAMES {
            write(2, " ");
            write(2, name)
        }
        write(2, "\n");
        return
    }
    if (env_has("L8_CAM")) {
        stage_cam = env_choice("L8_CAM", CAM_NAMES);
        if (stage_cam < 0) {
            write(2, "L8_CAM: no such view; there are side, front, back, q45, top, chase\n");
            return
        }
    }
    stage_camd = env_number("L8_CAMD", 6.0);
    stage_speed = stage_speeds[stage_motion];
    stage_on = true;
    hill_flat = true
}

// The stage's ground: one flat shelf, or (for the drops) a lip down to
// another, 1 m or 3 m lower.
tag tumbledown
stage_lay_out() {
    hill_lay_out_stage(stage_lip_height(), STAGE_LIP_D)
}

// How high the stage's lip is, for the motion (0: no lip). The flips and
// spins are off a 1.5 m lip, so that they fit the air.
stage_lip_height(): f32 {
    m: int = stage_motion;
    if (m == STAGE_DROP1) return 1.0;
    if (m == STAGE_DROP2) return 2.0;
    if (m == STAGE_DROP3) return 3.0;
    if (m == STAGE_FRONTFLIP || m == STAGE_BACKFLIP || m == STAGE_SPIN || m == STAGE_TUCKFLIP || m == STAGE_STUMBLE) return 1.5;
    0.0
}

// The stage's ground, ruled, into the ground mesh (in place of the hill's
// grass, which is built first; see main.l8).
tag tumbledown
stage_build(ground: *Mesh) {
    up: V3 = v3(0.0, 1.0, 0.0);
    lines: int = 32;
    for s in 0..hill.n {
        row: Row = hill.rows[s];
        y: f32 = row.top[0] + 0.01;
        d0: f32 = maxf(row.start, -40.0);
        d1: f32 = minf(row.end, 120.0);
        for k in 0..((d1 - d0) / 0.25) as int + 1 {
            c: f32 = d0 + k as f32 * 0.25;
            w: f32 = 0.006;
            col: V3 = v3(0.18, 0.34, 0.16);
            if (absf(c - floorf(c + 0.5)) < 0.01) {
                w = 0.01;
                col = v3(0.1, 0.2, 0.09)
            }
            put_quad(ground, v3(-4.0, y, -(c - w)), v3(4.0, y, -(c - w)), v3(4.0,
                y, -(c + w)), v3(-4.0, y, -(c + w)), up, col, 1.0)
        }
        for k in -lines / 2..lines / 2 + 1 {
            c: f32 = k as f32 * 0.25;
            w: f32 = 0.006;
            col: V3 = v3(0.18, 0.34, 0.16);
            if (k % 4 == 0) {
                w = 0.01;
                col = v3(0.1, 0.2, 0.09)
            }
            put_quad(ground, v3(c - w, y, -d0), v3(c + w, y, -d0), v3(c + w, y, -d1),
                v3(c - w, y, -d1), up, col, 1.0)
        }
    }
}

// The stage's runner at its start: on its way, at the motion's speed.
tag tumbledown
stage_start(r: *Runner) {
    runner_start(r);
    r.z = 0.0;
    r.y = hill_height(0.0, 0.0);
    r.prev = v3(r.x, r.y, r.z);
    if (stage_speed > 0.0) {
        r.started = true;
        r.speed = stage_speed
    }
}

// The keys of the stage's motion at time t: gathering, and letting go into
// a jump at STAGE_JUMP_AT (with its trick), tucking for a tuck flip.
tag tumbledown
stage_keys(r: *Runner, keys: *Keys, t: f32) {
    m: int = stage_motion;
    // (He goes straight on, at the motion's own speed (see cruise); for
    // idle, nowhere.)
    move_on = stage_speed > 0.0;
    move_dir = r.carve;
    move_amount = 1.0;
    if (m == STAGE_STOP_START) {
        stage_stop_start(t);
        return
    }
    if (m == STAGE_STAND_JUMP) {
        // (Standing; gathering from 1.0 s, and off at 1.4 s.)
        if (t > 1.0 && t < 1.4 && !keys.pad_held) {
            keys.pad_press = true;
            keys.pad_held = true
        }
        if (t >= 1.4 && keys.pad_held) {
            keys.pad_held = false;
            keys.pad_release = true
        }
        return
    }
    if (m == STAGE_TURN) {
        // (The thumb held so that he turns at the rate, then where he
        // heads.)
        turning: bool = t >= STAGE_TURN_AT && t < STAGE_TURN_AT + STAGE_TURN_FOR;
        lead: f32 = 0.0;
        if (turning) lead = STAGE_TURN_RATE / TURN_GAIN;
        move_dir = r.carve + lead;
        return
    }
    if (m == STAGE_GATHER) {
        if (!keys.pad_held) keys.pad_press = true;
        keys.pad_held = true;
        return
    }
    jumps: bool = m == STAGE_JUMP || m == STAGE_FRONTFLIP || m == STAGE_BACKFLIP || m == STAGE_SPIN || m == STAGE_TUCKFLIP || m == STAGE_STUMBLE;
    if (!jumps) return;
    // (Off the lip, if there is one: gathering a little before it, and
    // letting go at it, as a kick-off.)
    to_lip: f32 = STAGE_LIP_D + r.z;
    lip: bool = stage_lip_height() > 0.0;
    gather: bool = t > STAGE_JUMP_AT - 0.4 && t < STAGE_JUMP_AT;
    go: bool = t >= STAGE_JUMP_AT;
    if (lip) {
        gather = to_lip < 1.4 && to_lip > 0.45;
        go = to_lip <= 0.45
    }
    if (gather && !r.air && !keys.pad_held) {
        keys.pad_press = true;
        keys.pad_held = true;
        keys.aim_x = 0.0;
        keys.aim_y = 0.0;
        if (m == STAGE_FRONTFLIP || m == STAGE_TUCKFLIP) keys.aim_y = 1.5;
        if (m == STAGE_BACKFLIP) keys.aim_y = -1.5;
        if (m == STAGE_SPIN) keys.aim_x = 2.5;
        // (Too big a trick for the air: he comes down crooked.)
        if (m == STAGE_STUMBLE) keys.aim_y = 3.5
    }
    if (go && keys.pad_held && !r.air) {
        keys.pad_held = false;
        keys.pad_release = true
    }
    if (m == STAGE_TUCKFLIP && r.air && r.air_time > 0.1 && !keys.pad_held && r.air_time < 0.2) {
        keys.pad_press = true;
        keys.pad_held = true
    }
    if (m == STAGE_TUCKFLIP && r.air && keys.pad_held && r.air_total - r.air_time < 0.25) {
        keys.pad_held = false;
        keys.pad_release = true
    }
}

// The stop-start: running at 3.4 to 1.5 s; stopped to 4.5 s, turning on
// the spot (to his left, as far as the stick goes) from 2.5 to 3.5 s;
// walking off at 1.0 from 4.5 s, jogging at 2.0 from 6.0 s, turning back
// meanwhile; and stopped again from 7.5 s.
stage_stop_start(t: f32) {
    stage_speed = STAGE_STILL;
    if (t < 1.5) stage_speed = 3.4 else if (t >= 4.5 && t < 6.0) stage_speed = 1.0 else if (t >= 6.0 && t < 7.5) stage_speed = 2.0;
    // (Turning on the spot to 1.2 rad from 2.5 s.)
    move_on = true;
    move_amount = 1.0;
    move_dir = 0.0;
    if (t >= 2.5 && t < 6.0) move_dir = 1.2
}

// Whether the camera is the game's own (L8_CAM=game): main.l8 then keeps
// it, following him as in a run.
tag tumbledown
stage_game_camera(): bool {
    stage_cam == CAM_GAME
}

// The camera: level at his hip's height, going along at his speed.
tag tumbledown
stage_view(r: *Runner, t: f32): View {
    along: f32 = -stage_speed * t;
    // (Off a lip, or jumping, it follows him: he may stop as he lands.)
    if (stage_speed <= 0.0 || stage_lip_height() > 0.0 || stage_motion == STAGE_JUMP || stage_motion == STAGE_TURN || stage_motion >= STAGE_STOP_START) along = r.z;
    // (Level with his hip, wherever he is: off a drop, it goes down
    // with him.)
    y: f32 = r.y + 0.45;
    hip: V3 = v3(0.0, y, along);
    // (Turning, it follows him across too.)
    if (stage_motion == STAGE_TURN || stage_motion >= STAGE_STOP_START) hip.x = r.x;
    right: V3 = v3(1.0, 0.0, 0.0);
    front: V3 = v3(0.0, 0.0, -1.0);
    d: f32 = stage_camd;
    eye: V3 = v_madd(hip, right, d);
    if (stage_cam == CAM_FRONT) eye = v_madd(hip, front, d);
    if (stage_cam == CAM_BACK) eye = v_madd(hip, front, -d);
    if (stage_cam == CAM_Q45) eye = v_madd(hip, v_norm(v_add(front, right)), d);
    at: V3 = hip;
    if (stage_cam == CAM_TOP) eye = v_madd(v_madd(hip, v3(0.0, 1.0, 0.0), d), front,
        0.01);
    if (stage_cam == CAM_CHASE) {
        eye = v_madd(v_madd(hip, front, -d), v3(0.0, 1.0, 0.0), d * 0.35);
        at = v_madd(hip, v3(0.0, 1.0, 0.0), 0.2)
    }
    View {
        eye: eye,
        at: at,
        fovy: 20.0 * PI / 180.0,
        shift: 0.0,
        focus: v3(0.0, y - 0.45, along),
        time: t
    }
}
