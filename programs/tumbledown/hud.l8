tag tumbledown;

use_tag skate_math, skate;

// What is written over the game as he runs, in skate's writing (its
// font.l8 and paint.l8), bold, in capitals, each line with a soft dark
// halo: the score in the top right corner; the trick at the top, held
// still there (aimed at, in gold, while he gathers; let go into, white;
// landed, with its points under it, or STUMBLE); and near him only a bar
// under his feet that fills as he turns through a trick. On a touch
// screen, the two thumbs' pads (see skate's touch.l8), drawn here.
//
// The HUD's unit, in window pixels.
hud_px: f32 = 3.0;

// Whether this is a touch screen (L8_TOUCH: see main.l8). Skate's touch.l8
// reads it, so it is skate's too.
tag tumbledown, skate
hud_touch: bool = false;

const HUD_BOLD: int = 1;

// How long the splash is shown alone, after a dive, before the score.
const DIVE_HOLD: f32 = 1.0;

hud_text: []i8 = new i8[256](0i8);

hud_len: int = 0;

hud_size(): f32 {
    8.5 * hud_px
}

say(s: str) {
    for c in s {
        if (hud_len < len(hud_text)) {
            hud_text[hud_len] = c;
            hud_len = hud_len + 1
        }
    }
}

say_int(n: int) {
    if (n < 0) {
        say("-");
        say_int(-n);
        return
    }
    if (n >= 10) say_int(n / 10);
    if (hud_len < len(hud_text)) {
        hud_text[hud_len] = (n % 10 + 48) trunc i8;
        hud_len = hud_len + 1
    }
}

// A length in metres, to a tenth.
say_metres(m: f32) {
    tenths: int = (m * 10.0 + 0.5) as int;
    say_int(tenths / 10);
    say(".");
    say_int(tenths % 10);
    say(" M")
}

// The text said so far at (x, y) (its capitals' top a little below y).
put_said(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32,
    scale: f32
) {
    size: f32 = hud_size() * scale;
    base: f32 = y + 6.6 * hud_px * scale;
    paint_text(HUD_BOLD, size, 0.03, true, x, base + size * 0.05, hud_text, 0, hud_len,
        0.12, 0.2, 0.0, 0.0, 0.03, a * 0.7);
    paint_text(HUD_BOLD, size, 0.03, true, x, base, hud_text, 0, hud_len, 0.0, 0.0,
        r, g, b, a)
}

said_width(scale: f32): f32 {
    text_wide(HUD_BOLD, hud_size() * scale, 0.03, true, hud_text, 0, hud_len)
}

put_said_centered(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32,
    scale: f32
) {
    put_said(floorf(x - said_width(scale) * 0.5), floorf(y), r, g, b, a, scale)
}

flip_names: []str = ["FRONTFLIP", "BACKFLIP", "DOUBLE FRONTFLIP", "DOUBLE BACKFLIP",
    "TRIPLE FRONTFLIP", "TRIPLE BACKFLIP"];

spin_names: []str = ["180", "360", "540", "720", "900", "1080"];

absi_h(a: int): int {
    if (a < 0) return -a;
    a
}

mini_h(a: int, b: int): int {
    if (a < b) return a;
    b
}

// A trick by name: flips forward, half turns to the right, a tuck; or
// `none`.
say_trick(
    flips: int,
    halves: int,
    tuck: bool,
    none: str
) {
    nf: int = absi_h(flips);
    if (nf > 0) {
        id: int = (mini_h(nf, 3) - 1) * 2;
        if (flips < 0) id = id + 1;
        say(flip_names[id])
    }
    nh: int = absi_h(halves);
    if (nh > 0) {
        if (nf > 0) say(" ");
        say(spin_names[mini_h(nh, 6) - 1])
    }
    if (tuck) {
        if (nf + nh > 0) say(" ");
        say("TUCK")
    }
    if (nf == 0 && nh == 0 && !tuck) say(none)
}

// Where a point in the world falls on the screen (proj_x, proj_y), if it
// is in front of the camera.
tag tumbledown
proj_x: f32 = 0.0;

tag tumbledown
proj_y: f32 = 0.0;

tag tumbledown
project(p: V3): bool {
    m: []f32 = vp_m;
    cx: f32 = m[0] * p.x + m[4] * p.y + m[8] * p.z + m[12];
    cy: f32 = m[1] * p.x + m[5] * p.y + m[9] * p.z + m[13];
    cw: f32 = m[3] * p.x + m[7] * p.y + m[11] * p.z + m[15];
    if (cw < 0.5) return false;
    proj_x = (cx / cw * 0.5 + 0.5) * screen_w as f32;
    proj_y = (0.5 - cy / cw * 0.5) * screen_h as f32;
    true
}

// The HUD for this frame: the runner r, standing at `feet` in the world,
// in a window w by h.
tag tumbledown
build_hud(
    r: *Runner,
    feet: V3,
    w: f32,
    h: f32
) {
    hud_px = clampf(minf(w, h) / 260.0, 1.5, 4.0);
    px: f32 = hud_px;
    put_pads();
    // The score.
    hud_len = 0;
    say("SCORE ");
    say_int(score.total);
    put_said(w - said_width(1.0) - 3.0 * px - 10.0, 3.0 * px + 10.0, 1.0, 0.98, 0.92,
        0.9, 1.0);
    top: f32 = 3.0 * px + 10.0;
    mid: f32 = w * 0.5;
    cream: V3 = v3(1.0, 0.98, 0.92);
    if (!r.started) {
        hud_len = 0;
        if (hud_touch) say("MOVE THE STICK TO RUN") else say("ARROWS TO RUN");
        put_said_centered(mid, h * 0.2, cream.x, cream.y, cream.z, 0.9, 1.4);
        return
    }
    if (r.finished) {
        // (After a dive, the splash alone for DIVE_HOLD first.)
        if (r.in_water && r.finish_t < DIVE_HOLD) return;
        hud_len = 0;
        say("FINISH");
        put_said_centered(mid, h * 0.18, cream.x, cream.y, cream.z, 1.0, 1.8);
        hud_len = 0;
        say_int(score.total);
        put_said_centered(mid, h * 0.18 + 22.0 * px, 1.0, 0.83, 0.42, 1.0, 1.4);
        if (r.finish_t > 2.0) {
            hud_len = 0;
            if (hud_touch) say("TAP TO RUN AGAIN") else say("SPACE TO RUN AGAIN");
            put_said_centered(mid, h * 0.18 + 40.0 * px, cream.x, cream.y, cream.z,
                0.7, 1.0)
        }
        return
    }
    if (r.winding) {
        // Aimed at: in gold.
        hud_len = 0;
        say_trick(r.aim_flips, r.aim_halves, false, "JUMP");
        put_said_centered(mid, top + 12.0 * px, 1.0, 0.83, 0.42, 0.95, 1.0)
    } else if (r.air && r.trick_set) {
        // Let go into: white, with a bar under his feet filling as he
        // turns through it.
        flips: int = floorf(r.flip_goal / TAU + 0.5) as int;
        halves: int = -floorf(r.spin_goal / PI + 0.5) as int;
        hud_len = 0;
        say_trick(flips, halves, r.tucking, "");
        if (hud_len > 0) put_said_centered(mid, top + 12.0 * px, cream.x, cream.y,
            cream.z, 0.95, 1.0);
        if ((flips != 0 || halves != 0) && project(v3(feet.x, feet.y - 0.3, feet.z))) {
            bw: f32 = 36.0 * px;
            bh: f32 = 1.8 * px;
            x0: f32 = proj_x - bw * 0.5;
            paint_box(x0, proj_y, bw, bh, bh * 0.5, 0.0, 0.0, 0.03, 0.35);
            paint_box(x0, proj_y, bw * run_trick_turned(r), bh, bh * 0.5, cream.x,
                cream.y, cream.z, 0.9)
        }
    } else if (score.since < 2.5 && r.hits_from < score.n) {
        // Landed: each thing it scored, or STUMBLE; fading at the end.
        a: f32 = 1.0 - smoothstepf(2.0, 2.5, score.since);
        y: f32 = top + 12.0 * px;
        for i in r.hits_from..score.n {
            hit: Hit = score.hits[i];
            hud_len = 0;
            if (hit.kind == HIT_TRICK) say_trick(hit.flips, hit.halves, hit.tuck,
                "AIR");
            if (hit.kind == HIT_DROP) {
                say("DROP ");
                say_metres(hit.height)
            }
            if (hit.kind == HIT_GAP) say("GAP");
            if (hit.kind == HIT_SPLASH) say("SPLASH");
            if (hit.kind == HIT_STUMBLE || hit.kind == HIT_SPLASH) {
                if (hit.kind == HIT_STUMBLE) say("STUMBLE");
                put_said_centered(mid, y, 1.0, 0.6, 0.5, a, 1.0)
            } else {
                say("  +");
                say_int((hit.points + 0.5) as int);
                put_said_centered(mid, y, cream.x, cream.y, cream.z, a, 1.0)
            }
            y = y + 11.0 * px
        }
    }
}

// The thumbs' pads, on a touch screen: the stick on the left, a ring with
// its knob at rest in the middle, the knob out the way the thumb holding
// it has slid (to the ring's edge at the most: see player_move in
// main.l8); the trick pad's ring on the right, and while pressed, rings
// round where it came down at each half turn's reach and a line out to
// where it is now (as skate's).
const STICK_AT_X: f32 = 0.25;

const STICK_AT_Y: f32 = 0.7;

put_pads() {
    if (!hud_touch) return;
    w: f32 = screen_w as f32;
    h: f32 = screen_h as f32;
    p: *Pointers = pointers;
    ms: f32 = minf(w, h);
    cx: f32 = STICK_AT_X * w;
    cy: f32 = STICK_AT_Y * h;
    reach: f32 = STICK_REACH * ms;
    paint_ring(cx, cy, reach, maxf(2.0, hud_px * 0.8), 1.0, 0.98, 0.92, 0.4);
    kx: f32 = 0.0;
    ky: f32 = 0.0;
    if (p.stick >= 0) {
        kx = p.x[p.stick] - p.x0[p.stick];
        ky = p.y[p.stick] - p.y0[p.stick];
        k: f32 = sqrtf(kx * kx + ky * ky);
        if (k > reach) {
            kx = kx * reach / k;
            ky = ky * reach / k
        }
    }
    a: f32 = 0.55;
    if (p.stick >= 0) a = 0.95;
    kr: f32 = reach * 0.42;
    paint_shadow(cx + kx - kr, cy + ky - kr, 2.0 * kr, 2.0 * kr, kr, hud_px * 0.6,
        hud_px * 2.0, 0.3 * a);
    paint_disc(cx + kx, cy + ky, kr, 1.0, 0.98, 0.92, a);
    mid: f32 = steer_middle();
    px0: f32 = w - mid;
    py0: f32 = (PANEL_TOP + (PANEL_BOTTOM - PANEL_TOP) * PAD_AT) * h;
    if (p.trick >= 0) {
        tx: f32 = p.x0[p.trick];
        tyy: f32 = p.y0[p.trick];
        for k in 1..4 paint_ring(tx, tyy, SPIN_STEP * ms * k as f32, maxf(1.5, hud_px * 0.7),
            1.0, 0.98, 0.92, 0.45 - 0.1 * k as f32);
        paint_line(tx, tyy, p.x[p.trick], p.y[p.trick], maxf(6.0, hud_px * 3.0), 1.0,
            0.62, 0.25, 0.95);
        paint_disc(tx, tyy, maxf(12.0, hud_px * 5.0), 0.9, 0.22, 0.18, 0.95);
        put_dot(p.x[p.trick], p.y[p.trick], 1.0)
    } else paint_ring(px0, py0, maxf(22.0, hud_px * 10.0), maxf(2.0, hud_px * 0.8),
        1.0, 0.98, 0.92, 0.4)
}

// A dot where a thumb is.
put_dot(x: f32, y: f32, a: f32) {
    r: f32 = maxf(8.0, hud_px * 4.0);
    paint_shadow(x - r, y - r, 2.0 * r, 2.0 * r, r, hud_px * 0.6, hud_px * 2.0, 0.35 * a);
    paint_disc(x, y, r, 1.0, 0.98, 0.92, a)
}
