tag tumbledown;

use_tag skate_math, skate;

// A run played by itself (L8_AUTO), for looking at the game: it presses
// the keys a player would. It sets off at once, steers off each row where
// its drop suits what it goes for (off a tower, the tower), and at each lip
// goes for the next trick of PILOT_TRICKS: gathering a little before the
// lip and letting go at it, tucking through those that say so; or, for a
// plain drop, runs off without pressing.
type PilotTrick = {
    flips: int;
    halves: int;
    tuck: bool;
    // Running off without the pad: a drop.
    drop: bool
}

pilot_tricks: []PilotTrick = [PilotTrick {
    flips: 1,
    halves: 0,
    tuck: false,
    drop: false
}, PilotTrick {
    flips: 0,
    halves: 0,
    tuck: false,
    drop: true
}, PilotTrick {
    flips: -1,
    halves: 0,
    tuck: false,
    drop: false
}, PilotTrick {
    flips: 0,
    halves: 2,
    tuck: false,
    drop: false
}, PilotTrick {
    flips: 1,
    halves: 0,
    tuck: true,
    drop: false
}, PilotTrick {
    flips: 0,
    halves: 0,
    tuck: false,
    drop: false
}, PilotTrick {
    flips: 0,
    halves: -3,
    tuck: false,
    drop: false
}, PilotTrick {
    flips: -1,
    halves: 0,
    tuck: true,
    drop: false
}];

tag tumbledown
type Pilot = {
    on: bool;
    t: f32;
    // The lip it has gone for, the trick it is, and whether the pad is down
    // for it (and tucking in the air).
    lip: int;
    trick: PilotTrick;
    pressed: bool;
    tucked: bool
}

tag tumbledown
pilot: *Pilot = new Pilot {
    on: false,
    t: 0.0,
    lip: -1,
    trick: PilotTrick {
        flips: 0,
        halves: 0,
        tuck: false,
        drop: true
    },
    pressed: false,
    tucked: false
};

// Where across the hill to go off row k's end, from x `from`: off a
// tower, its tower; else where the drop is nearest `want` (a big drop
// rolls him, and a run of rolls is no fun to watch), keeping off the
// edges; and only where he can get to.
pilot_aim_x(k: int, want: f32, from: f32): f32 {
    row: Row = hill.rows[k];
    // (Onto a tower: from two rows before it already lining up with it,
    // so as to come down on the row before it where it can get across.)
    for ahead in 1..3 {
        if (k + ahead < hill.n && hill.rows[k + ahead].kind == ROW_TOWER) {
            tower: Row = hill.rows[k + ahead];
            x: f32 = (tower.edge[tower.tower] + tower.edge[tower.tower + 1]) * 0.5;
            if (pilot_reaches(row, from, x)) return x;
            // (Else as near it as he can get.)
            near: f32 = from;
            for i in 0..17 {
                y: f32 = lerpf(-HILL_HALF + 1.2, HILL_HALF - 1.2, i as f32 / 16.0);
                if (pilot_reaches(row, from, y) && absf(y - x) < absf(near - x)) near = y
            }
            return near
        }
    }
    // (On a tower, off its middle: not along its edge.)
    if (row.kind == ROW_TOWER && block_at(row, from) == row.tower) return (row.edge[row.tower] + row.edge[row.tower + 1]) * 0.5;
    best: f32 = from;
    off: f32 = 1000.0;
    for i in 0..17 {
        x: f32 = lerpf(-HILL_HALF + 1.2, HILL_HALF - 1.2, i as f32 / 16.0);
        miss: f32 = absf(edge_drop(k, x) - want);
        if (row.kind == ROW_TOWER && block_at(row, x) == row.tower) miss = -1.0;
        // (Only where he can get to: not over a block higher than his.)
        if (!pilot_reaches(row, from, x)) miss = 1000.0;
        if (miss < off) {
            off = miss;
            best = x
        }
    }
    best
}

// Whether he can run across row from x0 to x1 without a block higher
// than the one he is on in the way.
pilot_reaches(row: Row, x0: f32, x1: f32): bool {
    here: f32 = row_top(row, x0);
    for i in 0..9 {
        if (row_top(row, lerpf(x0, x1, i as f32 / 8.0)) > here + 0.3) return false
    }
    true
}

pilot_press(keys: *Keys) {
    if (!keys.pad_held) keys.pad_press = true;
    keys.pad_held = true
}

pilot_release(keys: *Keys) {
    if (keys.pad_held) keys.pad_release = true;
    keys.pad_held = false
}

// The keys for this step.
tag tumbledown
pilot_step(
    p: *Pilot,
    r: *Runner,
    keys: *Keys,
    dt: f32
) {
    p.t = p.t + dt;
    if (p.t < 0.3) return;
    d: f32 = -r.z;
    k: int = row_at(d);
    if (k != p.lip && !r.air && k < hill.n - 1) {
        p.lip = k;
        p.trick = pilot_tricks[k % len(pilot_tricks)];
        p.pressed = false
    }
    // Steering to where it goes for, leading it a little.
    ahead: f32 = maxf(row_end_d(d) - d, 2.0);
    // (Flips off drops of 1 to 1.6 m (and the towers); the rest off small
    // ones; as a player would.)
    drop: f32 = 1.0;
    if (p.trick.flips != 0) drop = 1.4;
    if (p.trick.drop) drop = 0.8;
    want: f32 = clampf(atan2f(pilot_aim_x(p.lip, drop, r.x) - r.x, ahead * 1.5), -0.6,
        0.6);
    move_on = true;
    move_dir = want;
    move_amount = 1.0;
    if (!r.air) {
        p.tucked = false;
        to_lip: f32 = row_end_d(d) - d;
        if (!p.trick.drop && !p.pressed && to_lip < 1.4 && to_lip > 0.5) {
            pilot_press(keys);
            keys.aim_x = p.trick.halves as f32 + 0.5 * signf(p.trick.halves as f32);
            keys.aim_y = p.trick.flips as f32 + 0.5 * signf(p.trick.flips as f32);
            p.pressed = true
        }
        if (keys.pad_held && to_lip < 0.45) pilot_release(keys)
    } else {
        // In the air: a tuck held from a little after takeoff to a little
        // before it would be done.
        if (p.trick.tuck && !p.tucked && r.air_time > 0.1 && r.trick_set) {
            pilot_press(keys);
            p.tucked = true
        }
        if (p.tucked && keys.pad_held && (run_trick_turned(r) > 0.8 || r.air_total - r.air_time < 0.3)) pilot_release(keys)
    }
}
