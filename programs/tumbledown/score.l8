tag tumbledown;

use_tag skate_math;

// Scoring, plainly: each thing he lands clean scores on its own, and the
// run scores what they add up to. No multipliers, no combos.
//
// - A trick (flips, spins, and a tuck held for a good share of the air)
//   is worth its parts' points, more the longer he was up: the numbers
//   are skate's (programs/skate/judge.l8), with the tuck in the grab's
//   place, and the same trick again this run worth half, then a quarter.
// - A drop of a metre or more, landed clean, is worth DROP_POINTS a metre.
// - Clearing a gap onto its island is worth GAP_POINTS.
// - Landing crooked (a trick he didn't finish, or came down off) is a
//   stumble, and worth nothing.
const HIT_TRICK: int = 0;

const HIT_DROP: int = 1;

const HIT_GAP: int = 2;

const HIT_STUMBLE: int = 3;

// Into the sea crooked: the drop scores, the trick does not.
const HIT_SPLASH: int = 4;

// One thing that scored (or a stumble, for what he went for).
tag tumbledown
type Hit = {
    kind: int;
    flips: int;
    halves: int;
    tuck: bool;
    // A drop's height, in metres.
    height: f32;
    points: f32
}

tag tumbledown
no_hit(): Hit {
    Hit {
        kind: HIT_TRICK,
        flips: 0,
        halves: 0,
        tuck: false,
        height: 0.0,
        points: 0.0
    }
}

const MAX_HITS: int = 256;

tag tumbledown
type Score = {
    hits: []Hit;
    n: int;
    points: f32;
    total: int;
    // Each trick done this run (by its key), and how many times.
    done: []int;
    done_count: []int;
    ndone: int;
    // Since the latest hit, for showing it.
    since: f32;
    // Hits past MAX_HITS this run: still scored, but not kept (main.l8
    // says so on the terminal).
    dropped: int
}

tag tumbledown
score: *Score = new Score {
    hits: new Hit[MAX_HITS](no_hit()),
    n: 0,
    points: 0.0,
    total: 0,
    done: new int[MAX_HITS](0),
    done_count: new int[MAX_HITS](0),
    ndone: 0,
    since: 100.0,
    dropped: 0
};

tag tumbledown
score_clear() {
    score.n = 0;
    score.points = 0.0;
    score.total = 0;
    score.ndone = 0;
    score.since = 100.0;
    score.dropped = 0
}

push_hit(h: Hit) {
    if (score.n < MAX_HITS) {
        score.hits[score.n] = h;
        score.n = score.n + 1
    } else score.dropped = score.dropped + 1;
    score.points = score.points + h.points;
    score.total = (score.points + 0.5) as int;
    score.since = 0.0
}

// How many times this run he has done the trick with this key, counting
// this one.
count_done(key: int): int {
    for i in 0..score.ndone {
        if (score.done[i] == key) {
            score.done_count[i] = score.done_count[i] + 1;
            return score.done_count[i]
        }
    }
    if (score.ndone < MAX_HITS) {
        score.done[score.ndone] = key;
        score.done_count[score.ndone] = 1;
        score.ndone = score.ndone + 1
    }
    1
}

flip_points: []f32 = [0.0, 600.0, 900.0, 1100.0];

spin_points: []f32 = [0.0, 200.0, 350.0, 480.0, 580.0, 660.0, 720.0];

const DROP_POINTS: f32 = 60.0;

const GAP_POINTS: f32 = 250.0;

// The least drop that scores.
const DROP_LEAST: f32 = 1.0;

// How much more (or less) an air is worth for how long he was up.
air_amp(air: f32): f32 {
    clampf(air / 1.2, 0.5, 1.6)
}

absi_s(a: int): int {
    if (a < 0) return -a;
    a
}

mini_s(a: int, b: int): int {
    if (a < b) return a;
    b
}

// A trick landed clean: flips forward, half turns to the right, the
// share of the air he held a tuck, and how long he was up. A plain jump
// scores nothing of itself.
tag tumbledown
judge_trick(
    flips: int,
    halves: int,
    tuck_share: f32,
    air: f32
) {
    nf: int = mini_s(absi_s(flips), 3);
    nh: int = mini_s(absi_s(halves), 6);
    tucked: bool = tuck_share > 0.25;
    if (nf == 0 && nh == 0 && !tucked) return;
    tuck_points: f32 = 0.0;
    if (tucked) tuck_points = 300.0 + 200.0 * tuck_share;
    p: f32 = (flip_points[nf] + spin_points[nh] + tuck_points) * air_amp(air);
    key: int = (flips + 4) * 1000 + (halves + 8) * 10;
    if (tucked) key = key + 1;
    p = p * powf(0.5, (count_done(key) - 1) as f32);
    h: Hit = no_hit();
    h.flips = flips;
    h.halves = halves;
    h.tuck = tucked;
    h.points = p;
    push_hit(h)
}

tag tumbledown
judge_drop(height: f32) {
    if (height < DROP_LEAST) return;
    h: Hit = no_hit();
    h.kind = HIT_DROP;
    h.height = height;
    h.points = DROP_POINTS * height;
    push_hit(h)
}

tag tumbledown
judge_gap() {
    h: Hit = no_hit();
    h.kind = HIT_GAP;
    h.points = GAP_POINTS;
    push_hit(h)
}

// A crooked landing: what he went for, for showing.
tag tumbledown
judge_stumble(flips: int, halves: int) {
    h: Hit = no_hit();
    h.kind = HIT_STUMBLE;
    h.flips = flips;
    h.halves = halves;
    push_hit(h)
}

tag tumbledown
judge_splash() {
    h: Hit = no_hit();
    h.kind = HIT_SPLASH;
    push_hit(h)
}

tag tumbledown
tick_score(dt: f32) {
    score.since = score.since + dt
}
