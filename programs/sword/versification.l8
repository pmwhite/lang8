tag sword_internal;

// A versification system: the books a Bible module may hold, in order, and
// the verses of each chapter. It fixes where each verse's entry is in a
// module's index (verse_slot), as SWORD lays them out: for each testament,
// slot 0 the module's heading, 1 the testament's, then each book's heading,
// and for each chapter its heading then its verses. The tables are
// versification_data.l8's (generated from SWORD's).
import "versification_data.l8";

tag sword
type VersificationBook = {
    // Its OSIS name (Gen, 1Cor) and SWORD's name for it (I Corinthians).
    osis: str;
    name: str;
    // 1 the Old Testament (and the books placed with it), 2 the New.
    testament: int;
    // Each chapter's verses, from chapter 1.
    verses: []int;
    // The slot of each chapter's heading in its testament's index; its
    // verse v is that plus v. The book's heading is the first's less one.
    chapter_slots: []int
}

tag sword
type Versification = {
    name: str;
    books: []VersificationBook;
    // Mappings of its verses to the KJVA's (SWORD's mappings_X: extra book
    // names, then rules of 7 numbers, or 8 when the first is past its
    // books), empty where it numbers verses as the KJVA does.
    extra_books: []str;
    rules: []int
}

// Where a verse's entry is: its testament (1, 2) and slot in that
// testament's index.
tag sword
type VerseSlot = {
    testament: int;
    slot: int
}

versification_table_index(name: str): int {
    for i in 0..len(versification_tables) {
        table: str = versification_tables[i];
        if (len(table) > len(name) && table[len(name)] as int == 124) {
            same: bool = true;
            for k in 0..len(name)
                if (table[k] != name[k]) same = false;
            if (same) return i
        }
    }
    -1
}

tag sword
versification_known(name: str): bool {
    versification_table_index(name) >= 0
}

// The field of table text that begins at from (to the next | or the end).
versification_field_end(text: []i8, from: int): int {
    end: int = from;
    while (end < len(text) && text[end] as int != 124) end = end + 1;
    end
}

versification_count_in(
    text: []i8,
    from: int,
    to: int,
    separator: int
): int {
    if (to <= from) return 0;
    n: int = 1;
    for i in from..to
        if (text[i] as int == separator) n = n + 1;
    n
}

// A testament's books (text from up to to: OSIS=Name=verses;...) into
// books from first, each of testament: the book count read.
versification_read_testament(
    books: []VersificationBook@new,
    first: int,
    testament: int,
    text: []i8,
    from: int,
    to: int
): int {
    count: int = 0;
    at: int = from;
    slot: int = 1;
    while (at < to) {
        end: int = at;
        while (end < to && text[end] as int != 59) end = end + 1;
        name_at: int = at;
        while (name_at < end && text[name_at] as int != 61) name_at = name_at + 1;
        verses_at: int = name_at + 1;
        while (verses_at < end && text[verses_at] as int != 61) verses_at = verses_at + 1;
        chapters: int = versification_count_in(text, verses_at + 1, end, 32);
        verses: []int = new int[chapters](0);
        chapter_slots: []int = new int[chapters](0);
        // (Its heading.)
        slot = slot + 1;
        c: int = 0;
        n: int = 0;
        for i in verses_at + 1..end + 1 {
            if (i == end || text[i] as int == 32) {
                slot = slot + 1;
                chapter_slots[c] = slot;
                verses[c] = n;
                slot = slot + n;
                c = c + 1;
                n = 0
            } else n = n * 10 + (text[i] as int - 48)
        }
        books[first + count] = VersificationBook {
            osis: sword_text(text, at, name_at),
            name: sword_text(text, name_at + 1, verses_at),
            testament: testament,
            verses: verses,
            chapter_slots: chapter_slots
        };
        count = count + 1;
        at = end + 1
    }
    count
}

// The versification system named (KJV, NRSV, Synodal, ...).
tag sword
versification_named(name: str) raises SwordError: *Versification@new {
    index: int = versification_table_index(name);
    if (index < 0) raise SwordError { failure: SwordFailure.UnknownVersification };
    text: []i8 = bytes(versification_tables[index]);
    old_from: int = versification_field_end(text, 0) + 1;
    old_to: int = versification_field_end(text, old_from);
    new_from: int = old_to + 1;
    new_to: int = versification_field_end(text, new_from);
    extra_from: int = new_to + 1;
    extra_to: int = versification_field_end(text, extra_from);
    rules_from: int = extra_to + 1;
    rules_to: int = versification_field_end(text, rules_from);
    total: int = versification_count_in(text, old_from, old_to, 59) + versification_count_in(text,
        new_from, new_to, 59);
    books: []VersificationBook = new VersificationBook[total](VersificationBook {
        osis: "",
        name: "",
        testament: 1,
        verses: new int[0](0),
        chapter_slots: new int[0](0)
    });
    old_count: int = versification_read_testament(books, 0, 1, text, old_from, old_to);
    _new_count: int = versification_read_testament(books, old_count, 2, text, new_from,
        new_to);
    extra: []str = new str[versification_count_in(text, extra_from, extra_to, 32)]("");
    k: int = 0;
    from: int = extra_from;
    for i in extra_from..extra_to + 1 {
        if (i == extra_to || text[i] as int == 32) {
            if (i > from) {
                extra[k] = sword_text(text, from, i);
                k = k + 1
            }
            from = i + 1
        }
    }
    rules: []int = new int[versification_count_in(text, rules_from, rules_to, 32)](0);
    k = 0;
    n: int = 0;
    for i in rules_from..rules_to + 1 {
        if (i == rules_to || text[i] as int == 32) {
            if (k < len(rules)) rules[k] = n;
            k = k + 1;
            n = 0
        } else n = n * 10 + (text[i] as int - 48)
    }
    new Versification {
        name: sword_text(text, 0, old_from - 1),
        books: books,
        extra_books: extra,
        rules: rules
    }
}

// The book whose OSIS name is osis (-1: it has none).
tag sword
versification_book(system: *Versification, osis: str): int {
    for b in 0..len(system.books)
        if (system.books[b].osis == osis) return b;
    -1
}

// Where verse v of chapter c of book b is (chapter 0: the book's heading;
// verse 0: the chapter's heading). A slot of -1: there is no such verse.
tag sword
verse_slot(
    system: *Versification,
    book: int,
    chapter: int,
    verse: int
): VerseSlot {
    if (book < 0 || book >= len(system.books)) return VerseSlot { testament: 1, slot: -1 };
    entry: VersificationBook = system.books[book];
    if (chapter < 0 || chapter > len(entry.verses)) return VerseSlot { testament: entry.testament, slot: -1 };
    if (chapter == 0) return VerseSlot { testament: entry.testament, slot: entry.chapter_slots[0] - 1 };
    if (verse < 0 || verse > entry.verses[chapter - 1]) return VerseSlot { testament: entry.testament, slot: -1 };
    VerseSlot { testament: entry.testament, slot: entry.chapter_slots[chapter - 1] + verse }
}
