tag sword_dump;

use_tag std, files, sword;

// What a module package holds, for checking this library against real
// modules: `sword-dump NAME.zip` prints what its conf says and, for a Bible
// or commentary, a few verses' markup; `sword-dump NAME.zip OSIS C V`
// prints that verse's.
import "../sword.l8";

import "../../files/files.l8";

import "../../../stdlib/print.l8";

import "../../../stdlib/write.l8";

show_verse(
    module: *VerseModule,
    osis: str,
    chapter: int,
    verse: int
) raises SwordError, IoError {
    system: *Versification = verse_module_system(module);
    book: int = versification_book(system, osis);
    if (book < 0) {
        print("no such book");
        return
    }
    text: []i8 = verse_module_text_at(module, book, chapter, verse);
    write(1, osis);
    write(1, " ");
    write_int(1, chapter);
    write(1, ":");
    write_int(1, verse);
    write(1, " ");
    write_bytes_n(1, text, len(text));
    print("")
}

show_entry(module: *KeyModule, i: int) raises SwordError, IoError {
    write(1, key_module_key(module, i));
    write(1, ": ");
    text: []i8 = key_module_text(module, i);
    write_bytes_n(1, text, if (len(text) > 300) 300 else len(text));
    print("")
}

// The tree from node, indented by depth: its first few children each.
show_tree(module: *TreeModule, node: int, depth: int) raises SwordError, IoError {
    for _d in 0..depth write(1, "  ");
    write(1, tree_module_name(module, node));
    write(1, " (");
    write_int(1, len(tree_module_text(module, node)));
    print(" bytes)");
    if (depth >= 3) return;
    child: int = tree_module_first_child(module, node);
    shown: int = 0;
    while (child >= 0 && shown < 3) {
        show_tree(module, child, depth + 1);
        child = tree_module_next(module, child);
        shown = shown + 1
    }
}

main(argc: int, args: []str): int {
    try {
        dump(argc, args)
    } with IoError _error -> {
        1
    }
}

dump(argc: int, args: []str) raises IoError: int {
    if (argc != 2 && argc != 3 && argc != 5) {
        eprint("usage: sword-dump PACKAGE.zip [OSIS CHAPTER VERSE | KEY]");
        return 2
    }
    try {
        data: []i8 = read_file_bytes(args[1]);
        package: *ModulePackage = package_open(data, len(data));
        info: ModuleInfo = package.info;
        print(info.name);
        print(info.description);
        print(info.versification);
        match module_support(&package.info) {
            Readable -> print("readable");
            Unreadable _ -> print("unreadable")
        }
        match info.storage {
            ByVerse _ -> {
                module: *VerseModule = verse_module_open(package);
                if (argc == 5) {
                    show_verse(module, args[2], number(args[3]), number(args[4]));
                    return 0
                }
                show_verse(module, "Gen", 1, 1);
                show_verse(module, "Gen", 1, 2);
                show_verse(module, "Ps", 23, 1);
                show_verse(module, "John", 3, 16);
                show_verse(module, "Rev", 22, 21)
            }
            ByKey _ -> {
                module: *KeyModule = key_module_open(package);
                write_int(1, key_module_count(module));
                print(" entries");
                if (argc == 3) {
                    found: int = key_module_find(module, args[2]);
                    if (found < 0) print("no such key") else show_entry(module, found);
                    return 0
                }
                for i in 0..3 show_entry(module, i);
                show_entry(module, key_module_count(module) / 2)
            }
            ByTree -> {
                module: *TreeModule = tree_module_open(package);
                write_int(1, tree_module_count(module));
                print(" nodes");
                show_tree(module, 0, 0)
            }
            _ -> { }
        }
        0
    } with FileError error -> {
        eprint(file_operation_name(error.operation));
        1
    } with SwordError error -> {
        eprint(sword_failure_name(error.failure));
        1
    }
}

number(text: str): int {
    n: int = 0;
    for byte in text n = n * 10 + (byte as int - 48);
    n
}
