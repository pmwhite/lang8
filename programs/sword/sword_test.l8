tag sword_test;

use_tag std, sword;

import "sword.l8";

import "../../stdlib/print.l8";

kind_name(kind: ModuleKind): str {
    match kind {
        Bible -> "Bible";
        Commentary -> "commentary";
        Dictionary -> "dictionary";
        Glossary -> "glossary";
        Devotional -> "devotional";
        Book -> "book";
        Images -> "images";
        Other -> "other"
    }
}

test "a conf describes its module" {
    text: []i8 = bytes("""
[KJV]
# A comment
Description=King James Version (1769)
DataPath=./modules/texts/ztext/kjv/
ModDrv=zText
Encoding=UTF-8
GlobalOptionFilter=OSISFootnotes
GlobalOptionFilter=OSISRedLetterWords
About=The Authorized Version.\\par\\par Strong's numbers \\
from the Bible Foundation.\\par \\qc Public domain
InstallSize=4238960
""");
    conf: *ModuleConf = conf_parse(text, len(text));
    print(conf_name(conf));
    info: ModuleInfo = module_info(conf);
    print(info.description);
    print(kind_name(info.kind));
    print(info.data_path);
    print(info.versification);
    print_int(info.install_size);
    print_bool(info.words_of_christ);
    paragraphs: []str = about_paragraphs(info.about);
    for p in paragraphs print(p);
    expect {|
        KJV
        King James Version (1769)
        Bible
        modules/texts/ztext/kjv/
        KJV
        4238960
        true
        The Authorized Version.
        Strong's numbers from the Bible Foundation.
        Public domain
    |}
}

test "a verse's slot in its testament's index" {
    kjv: *Versification = versification_named("KJV");
    print_int(len(kjv.books));
    genesis: int = versification_book(kjv, "Gen");
    print_int(verse_slot(kjv, genesis, 1, 1).slot);
    print_int(verse_slot(kjv, genesis, 1, 0).slot);
    print_int(verse_slot(kjv, genesis, 0, 0).slot);
    print_int(verse_slot(kjv, genesis, 2, 1).slot);
    matthew: VerseSlot = verse_slot(kjv, versification_book(kjv, "Matt"), 1, 1);
    print_int(matthew.testament);
    print_int(matthew.slot);
    print_int(verse_slot(kjv, versification_book(kjv, "Mal"), 4, 6).slot);
    print_int(verse_slot(kjv, versification_book(kjv, "Rev"), 22, 21).slot);
    print_int(verse_slot(kjv, genesis, 1, 32).slot);
    expect {|
        66
        4
        3
        2
        36
        2
        4
        24114
        8245
        -1
    |}
    try {
        _unknown: *Versification = versification_named("Martian")
    } with SwordError error -> {
        print(sword_failure_name(error.failure))
    }
    expect {|
        its verse numbering is not one SWORD defines
    |}
}

// Rich text as one line: ¶ a paragraph, /N a line of poetry, | a line
// break, [hN ...] a heading, {note ...}, <words|target> a link; styles:
// _italic_ *bold* «jesus» [added] ^divine^ ⁺superscript.
show_rich(rich: *RichText) raises IoError {
    for i in 0..rich.count {
        match rich.pieces[i] {
            Words w -> {
                if (w.style.jesus) write(1, "\�\�");
                if (w.style.added) write(1, "[");
                if (w.style.italic) write(1, "_");
                if (w.style.bold) write(1, "*");
                if (w.style.divine || w.style.small_caps) write(1, "^");
                if (w.style.superscript) write(1, "\�\�\�");
                write_bytes_span(1, rich.text.data, w.from, w.to - w.from);
                if (w.style.superscript) write(1, "\�\�\�");
                if (w.style.divine || w.style.small_caps) write(1, "^");
                if (w.style.bold) write(1, "*");
                if (w.style.italic) write(1, "_");
                if (w.style.added) write(1, "]");
                if (w.style.jesus) write(1, "\�\�")
            }
            Paragraph -> write(1, "\�\�");
            Line l -> {
                write(1, "/");
                write_int(1, l.indent)
            }
            LineBreak -> write(1, "|");
            HeadingStart h -> {
                write(1, "[h");
                write_int(1, h.level);
                write(1, " ")
            }
            HeadingEnd -> write(1, "]");
            NoteStart n -> {
                match n.kind {
                    Footnote -> write(1, "{note ");
                    CrossReference -> write(1, "{xref ");
                    StudyNote -> write(1, "{study ")
                }
            }
            NoteEnd -> write(1, "}");
            LinkStart l -> {
                write(1, "<");
                link_from = l.from;
                link_to = l.to
            }
            LinkEnd -> {
                write(1, "|");
                write_bytes_span(1, rich.text.data, link_from, link_to - link_from);
                write(1, ">")
            }
        }
    }
    print("")
}

// (The link being shown's target.)
link_from: int = 0;

link_to: int = 0;

convert_and_show(markup: Markup, text: str) raises IoError {
    rich: *RichText = rich_new();
    state: MarkupState = markup_state_new();
    source: []i8 = bytes(text);
    markup_convert(rich, &state, markup, source, 0, len(source));
    show_rich(rich)
}

test "OSIS: a Bible's verses" {
    convert_and_show(Markup.Osis, "<w lemma=\"strong:H0776\">And the earth</w> <w lemma=\"strong:H01961\">was</w> <transChange type=\"added\">was</transChange> <w>upon the face</w>.");
    convert_and_show(Markup.Osis, "<title canonical=\"true\" type=\"psalm\"><w>A Psalm</w> <w>of David</w>.</title><w lemma=\"strong:H03068\">The <divineName>Lord</divineName></w> <transChange type=\"added\">is</transChange> my shepherd; I shall not want.");
    convert_and_show(Markup.Osis, "<q marker=\"\" who=\"Jesus\"><milestone marker=\"\�\�\" type=\"x-p\"/><w>For</w> <w>God</w> so loved the world<note type=\"study\"><catchWord>world</catchWord>: or, <rdg type=\"x-literal\">age</rdg></note>, <q who=\"someone\">quoted</q> still red</q> after.");
    convert_and_show(Markup.Osis, "<q who=\"Jesus\" sID=\"q1\"/>Begun in one verse");
    expect {|
        And the earth was [was] upon the face.
        [h3 A Psalm of David.]The ^Lord^ [is] my shepherd; I shall not want.
        ¶«For God so loved the world»{study _world_: or, _age_}«, quoted still red» after.
        «Begun in one verse»
    |}
}

test "OSIS: a commentary's note on a passage" {
    convert_and_show(Markup.Osis, "<div eID=\"gen34\" type=\"x-p\"/> <title type=\"x-s3\">The Creation. (<hi type=\"small-caps\">b. c.</hi> 4004.)</title> <div sID=\"gen35\" type=\"x-p\"/> <hi type=\"super\">3</hi> And God said, <hi type=\"italic\">it was</hi> good; see <reference osisRef=\"Gen.2.1\">ch. 2:1</reference>. &amp; more&#8212;");
    expect {|
        [h3 The Creation. (^b. c.^ 4004.)]¶⁺3⁺ And God said, _it was_ good; see <ch. 2:1|Gen.2.1>. & more—
    |}
}

test "ThML, GBF, TEI and plain text" {
    convert_and_show(Markup.Thml, "<p>1. THE family <b>from</b> which I am derived<note>That is, the priests.</note>; see <scripRef passage=\"Ge 1:1\">Genesis 1</scripRef>.</p><p>Next<br />line</p>");
    convert_and_show(Markup.Gbf, "The grace of our Lord, <FI>be<Fi> with you.<RF>Some read: us.<Rf> <FR>I am<Fr>");
    convert_and_show(Markup.Tei, """
<entryFree n="25"><orth>ἀγαπάω</orth><lb/>
<orth type="writing">ajgapavw</orth> <orth rend="bold" type="trans">agapao</orth> <pron rend="italic">{ag-ap-ah'-o}</pron>
<def> to love:--(be-)love(-ed). Compare <ref target="StrongsGreek:5368">5368</ref>.</def></entryFree>""");
    convert_and_show(Markup.Plain, """
 7225  re'shiyth

 from the same as 7218; the first
 in place, time, order""");
    expect {|
        ¶1. THE family *from* which I am derived{note That is, the priests.}; see <Genesis 1|Ge 1:1>.¶Next|line
        The grace of our Lord, [be] with you.{note Some read: us.} «I am»
        *ἀγαπάω*|*agapao* _{ag-ap-ah'-o}_¶to love:--(be-)love(-ed). Compare <5368|StrongsGreek:5368>.
        7225 re'shiyth¶from the same as 7218; the first in place, time, order
    |}
}

// (One state through two entries, as a book's verses are read.)
convert_both_and_show(markup: Markup, first: str, second: str) raises IoError {
    rich: *RichText = rich_new();
    state: MarkupState = markup_state_new();
    one: []i8 = bytes(first);
    markup_convert(rich, &state, markup, one, 0, len(one));
    two: []i8 = bytes(second);
    markup_convert(rich, &state, markup, two, 0, len(two));
    show_rich(rich)
}

test "a Strong's note's words are hidden, and the words after it are not" {
    convert_both_and_show(Markup.Osis, "In <note type=\"x-strongsMarkup\">H7225</note>the beginning",
        " God created");
    convert_and_show(Markup.Osis, "Shown<note>a <note>within</note>note</note> after");
    expect {|
        In the beginning God created
        Shown{note a note} after
    |}
}

test "a < with no end is words" {
    convert_and_show(Markup.Thml, "if a <b>few</b> < many");
    convert_and_show(Markup.Gbf, "one <FI>two<Fi> < three");
    expect {|
        if a *few* < many
        one [two] < three
    |}
}
