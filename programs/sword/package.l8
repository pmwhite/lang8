tag sword_internal;

// A module as a repository serves it: packages/rawzip/NAME.zip, holding
// mods.d/name.conf and the module's files under its DataPath. Opening one
// reads its conf and takes its files out of the zip; readers then find
// their files by the ending that follows the data path ("ot.bzv", ".idx").
// A file of a module: its path in the package, and its bytes, or (not
// held) only its size: a file read a span at a time (module_text_endings').
tag sword
type ModuleFile = {
    path: str;
    data: []i8;
    held: bool;
    size: int
}

tag sword
type ModulePackage = {
    conf: *ModuleConf;
    info: ModuleInfo;
    files: []ModuleFile
}

// The package in archive's first size bytes (a zip).
tag sword
package_open(archive: []i8@new, size: int) raises SwordError: *ModulePackage@new {
    opening: *PackageOpening = package_begin(archive, size);
    _whole: bool = package_step(opening, PACKAGE_STEP_ALL);
    package_opened(opening)
}

// ---- a package opened a step at a time ----
// Its conf read at once (it is small), then its files taken out of the zip
// in steps of about a budget of bytes each (package_step), so that a
// program can answer its user between them; package_opened is the package
// once they are all out.
tag sword
type PackageOpening = tag sword_internal {
    archive: []i8;
    size: int;
    entries: []archive::ZipEntry;
    conf: *ModuleConf;
    // The conf as it is in the package (kept as it is, by an unpacking).
    conf_bytes: []i8;
    // Each of its files' entry, in order; the files taken out so far, and
    // the one being taken out (at).
    file_entries: []int;
    files: []ModuleFile;
    at: int;
    reading: ?*archive::ZipEntryReading;
    // The files' sizes: all of them, and those already out.
    total: int;
    finished: int
}

// A budget for one step that takes out all of a package at once.
PACKAGE_STEP_ALL: int = 4611686018427387904;

tag sword
package_begin(archive: []i8@new, size: int) raises SwordError: *PackageOpening@new {
    try {
        entries: []archive::ZipEntry = archive::zip_entries(archive, size);
        conf_at: int = -1;
        file_count: int = 0;
        for i in 0..len(entries) {
            entry: archive::ZipEntry = entries[i];
            if (!archive::zip_entry_is_folder(&entries[i])) {
                if (sword_starts_with(entry.name, "mods.d/") && sword_ends_with(entry.name,
                    ".conf")) {
                    if (conf_at >= 0) raise SwordError { failure: SwordFailure.BadConf { line: 0 } };
                    conf_at = i
                } else file_count = file_count + 1
            }
        }
        if (conf_at < 0) raise SwordError { failure: SwordFailure.MissingFile { ending: ".conf" } };
        conf_bytes: []i8 = archive::zip_entry_bytes(archive, size, &entries[conf_at]);
        file_entries: []int = new int[file_count](0);
        total: int = 0;
        k: int = 0;
        for i in 0..len(entries) {
            if (i != conf_at && !archive::zip_entry_is_folder(&entries[i])) {
                file_entries[k] = i;
                total = total + entries[i].size;
                k = k + 1
            }
        }
        new PackageOpening {
            archive: archive,
            size: size,
            entries: entries,
            conf: conf_parse(conf_bytes, len(conf_bytes)),
            file_entries: file_entries,
            files: new ModuleFile[file_count](ModuleFile {
                path: "",
                data: sword_empty,
                held: true,
                size: 0
            }),
            conf_bytes: conf_bytes,
            at: 0,
            reading: null,
            total: total,
            finished: 0
        }
    } with archive::ArchiveError _error -> {
        raise SwordError { failure: SwordFailure.BadPackage }
    }
}

// About budget more bytes of its files taken out; whether all are. (What
// it takes out is allocated where the opening was: call it there.)
tag sword
package_step(opening: *PackageOpening@new, budget: int) raises SwordError: bool {
    left: int = budget;
    try {
        while (opening.at < len(opening.files) && left > 0) {
            entry: *archive::ZipEntry = &opening.entries[opening.file_entries[opening.at]];
            reading: ?*archive::ZipEntryReading = opening.reading;
            if (reading == null) {
                reading = archive::zip_entry_begin(opening.archive, opening.size,
                    entry);
                opening.reading = reading
            }
            if (reading != null) {
                before: int = archive::zip_entry_taken(reading);
                whole: bool = archive::zip_entry_step(reading, left);
                left = left - (archive::zip_entry_taken(reading) - before);
                if (whole) {
                    opening.files[opening.at] = ModuleFile {
                        path: entry.name,
                        data: archive::zip_entry_data(reading),
                        held: true,
                        size: entry.size
                    };
                    opening.finished = opening.finished + entry.size;
                    opening.at = opening.at + 1;
                    opening.reading = null
                } else left = 0
            }
        }
    } with archive::ArchiveError _error -> {
        raise SwordError { failure: SwordFailure.BadPackage }
    }
    opening.at == len(opening.files)
}

// How much of its files is out, in thousandths.
tag sword
package_progress(opening: *PackageOpening): int {
    if (opening.total == 0) return 1000;
    out: int = opening.finished;
    reading: ?*archive::ZipEntryReading = opening.reading;
    if (reading != null) out = out + archive::zip_entry_taken(reading);
    out * 1000 / opening.total
}

// The package's conf, as its bytes.
tag sword
package_conf_bytes(opening: *PackageOpening): []i8@opening {
    opening.conf_bytes
}

// The package's files so far (all of them once package_step has said so).
tag sword
package_files(opening: *PackageOpening): []ModuleFile@opening {
    opening.files
}

// The package, once package_step has said all its files are out.
tag sword
package_opened(opening: *PackageOpening@new): *ModulePackage@new {
    new ModulePackage { conf: opening.conf, info: module_info(opening.conf), files: opening.files }
}

// A package made of a module's conf and files kept apart (unpacked): the
// files named by their endings (package_ending's), those not held only
// their sizes. Their paths are made the package's (the data path, then
// the ending).
tag sword
package_from_files(conf_bytes: []i8, files: []ModuleFile@new) raises SwordError: *ModulePackage@new {
    conf: *ModuleConf = conf_parse(conf_bytes, len(conf_bytes));
    info: ModuleInfo = module_info(conf);
    for k in 0..len(files) {
        ending: str = files[k].path;
        path: []i8 = new i8[len(info.data_path) + len(ending)](0i8);
        memcpy(path, 0, bytes(info.data_path), 0, len(info.data_path));
        memcpy(path, len(info.data_path), bytes(ending), 0, len(ending));
        files[k].path = sword_text(path, 0, len(path))
    }
    new ModulePackage { conf: conf, info: info, files: files }
}

// A file's path after the module's data path (its ending, as the readers
// name their files: "ot.bzz", ".idx"); a file outside it, its whole path.
tag sword
package_ending(info: *ModuleInfo, path: str): str@new {
    data_path: str = info.data_path;
    if (len(path) > len(data_path)) {
        same: bool = true;
        for k in 0..len(data_path)
            if (sword_lower(path[k] as int) != sword_lower(data_path[k] as int)) same = false;
        if (same) return sword_text(bytes(path), len(data_path), len(path))
    }
    sword_copy(path)
}

// The endings of a module's files that are read a span at a time, not
// held whole (its large text: a compressed Bible's or commentary's
// blocks, a compressed dictionary's, a book's text).
tag sword
module_text_endings(info: *ModuleInfo): []str@new {
    match info.storage {
        ByVerse s -> if (s.compressed) ["ot.bzz", "nt.bzz"] else new str[0]("");
        ByKey s -> if (s.compressed) [".zdt"] else new str[0]("");
        ByTree -> [".bdt"];
        _ -> new str[0]("")
    }
}

// Where some of a file's bytes are, for reading them alone: the file (by
// its ending) and the span.
tag sword
type TextSpan = {
    ending: str;
    offset: int;
    count: int
}

sword_starts_with(text: str, start: str): bool {
    if (len(text) < len(start)) return false;
    for i in 0..len(start)
        if (text[i] != start[i]) return false;
    true
}

sword_ends_with(text: str, end: str): bool {
    if (len(text) < len(end)) return false;
    from: int = len(text) - len(end);
    for i in 0..len(end)
        if (text[from + i] != end[i]) return false;
    true
}

// The file at the package's data path followed by ending (none: -1). Paths
// are compared without regard to the case of their letters, since some
// packages' file names differ in case from their DataPath.
tag sword
package_file(package: *ModulePackage, ending: str): int {
    path: str = package.info.data_path;
    for i in 0..len(package.files) {
        name: str = package.files[i].path;
        if (len(name) == len(path) + len(ending)) {
            same: bool = true;
            for k in 0..len(path)
                if (sword_lower(name[k] as int) != sword_lower(path[k] as int)) same = false;
            for k in 0..len(ending)
                if (sword_lower(name[len(path) + k] as int) != sword_lower(ending[k] as int)) same = false;
            if (same) return i
        }
    }
    -1
}

sword_lower(byte: int): int {
    if (byte >= 65 && byte <= 90) byte + 32 else byte
}

// The file's data, which must be there.
package_data(package: *ModulePackage, ending: str@immortal) raises SwordError: []i8@package {
    at: int = package_file(package, ending);
    if (at < 0) raise SwordError { failure: SwordFailure.MissingFile { ending: ending } };
    package.files[at].data
}

package_data_optional(package: *ModulePackage, ending: str): []i8@package {
    at: int = package_file(package, ending);
    if (at < 0) return sword_new_empty(package);
    package.files[at].data
}

sword_new_empty(package: *ModulePackage): []i8@package {
    // (Any empty slice will do: the package's first file has room for none
    // to be read.)
    if (len(package.files) > 0 && len(package.files[0].data) == 0) return package.files[0].data;
    sword_empty
}

sword_empty: []i8 = new i8[0](0i8);

// ---- reading the files' numbers (little-endian) ----
sword_u16(data: []i8, at: int): int {
    data[at] as int & 255 | (data[at + 1] as int & 255) << 8
}

sword_u32(data: []i8, at: int): int {
    data[at] as int & 255 | (data[at + 1] as int & 255) << 8 | (data[at + 2] as int & 255) << 16 | (data[at + 3] as int & 255) << 24
}

// A signed 32-bit number (a tree's links, -1 for none).
sword_s32(data: []i8, at: int): int {
    value: int = sword_u32(data, at);
    if (value >= 2147483648) value - 4294967296 else value
}

// ---- an entry's text ----
// Bytes from up to to of source as UTF-8 (a Latin-1 module's converted),
// NUL bytes and the CR LF or NUL padding at its end left out.
tag sword
entry_utf8(
    utf8: bool,
    source: []i8,
    from: int,
    to: int
): []i8@new {
    room: []i8 = new i8[entry_utf8_size(utf8, source, from, to)](0i8);
    _n: int = entry_utf8_into(utf8, source, from, to, room);
    room
}

entry_end(source: []i8, from: int, to: int): int {
    end: int = to;
    while (end > from && (source[end - 1] as int == 0 || source[end - 1] as int == 10 || source[end - 1] as int == 13)) end = end - 1;
    end
}

entry_utf8_size(
    utf8: bool,
    source: []i8,
    from: int,
    to: int
): int {
    count: int = 0;
    for i in from..entry_end(source, from, to) {
        byte: int = source[i] as int & 255;
        if (byte != 0) count = count + (if (!utf8 && byte >= 128) 2 else 1)
    }
    count
}

// The same into out (room for twice to - from): how many bytes.
entry_utf8_into(
    utf8: bool,
    source: []i8,
    from: int,
    to: int,
    out: []i8
): int {
    n: int = 0;
    for i in from..entry_end(source, from, to) {
        byte: int = source[i] as int & 255;
        if (byte != 0) {
            if (!utf8 && byte >= 128) {
                out[n] = (192 | byte >> 6) trunc i8;
                out[n + 1] = (128 | byte & 63) trunc i8;
                n = n + 2
            } else {
                out[n] = source[i];
                n = n + 1
            }
        }
    }
    n
}
