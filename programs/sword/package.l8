tag sword_internal;

// A module as a repository serves it: packages/rawzip/NAME.zip, holding
// mods.d/name.conf and the module's files under its DataPath. Opening one
// reads its conf and takes its files out of the zip; readers then find
// their files by the ending that follows the data path ("ot.bzv", ".idx").
tag sword
type ModuleFile = {
    path: str;
    data: []i8
}

tag sword
type ModulePackage = {
    conf: *ModuleConf;
    info: ModuleInfo;
    files: []ModuleFile
}

// The package in archive's first size bytes (a zip).
tag sword
package_open(archive: []i8, size: int) raises SwordError: *ModulePackage@new {
    try {
        entries: []archive::ZipEntry = archive::zip_entries(archive, size);
        conf_at: int = -1;
        file_count: int = 0;
        for i in 0..len(entries) {
            entry: archive::ZipEntry = entries[i];
            if (!archive::zip_entry_is_folder(&entries[i])) {
                if (sword_starts_with(entry.name, "mods.d/") && sword_ends_with(entry.name,
                    ".conf")) {
                    if (conf_at >= 0) raise SwordError { failure: SwordFailure.BadConf { line: 0 } };
                    conf_at = i
                } else file_count = file_count + 1
            }
        }
        if (conf_at < 0) raise SwordError { failure: SwordFailure.MissingFile { ending: ".conf" } };
        conf_bytes: []i8 = archive::zip_entry_bytes(archive, size, &entries[conf_at]);
        conf: *ModuleConf = conf_parse(conf_bytes, len(conf_bytes));
        files: []ModuleFile = new ModuleFile[file_count](ModuleFile { path: "", data: new i8[0](0i8) });
        k: int = 0;
        for i in 0..len(entries) {
            if (i != conf_at && !archive::zip_entry_is_folder(&entries[i])) {
                files[k] = ModuleFile { path: entries[i].name, data: archive::zip_entry_bytes(archive,
                    size, &entries[i]) };
                k = k + 1
            }
        }
        new ModulePackage { conf: conf, info: module_info(conf), files: files }
    } with archive::ArchiveError _error -> {
        raise SwordError { failure: SwordFailure.BadPackage }
    }
}

sword_starts_with(text: str, start: str): bool {
    if (len(text) < len(start)) return false;
    for i in 0..len(start)
        if (text[i] != start[i]) return false;
    true
}

sword_ends_with(text: str, end: str): bool {
    if (len(text) < len(end)) return false;
    from: int = len(text) - len(end);
    for i in 0..len(end)
        if (text[from + i] != end[i]) return false;
    true
}

// The file at the package's data path followed by ending (none: -1). Paths
// are compared without regard to the case of their letters, since some
// packages' file names differ in case from their DataPath.
tag sword
package_file(package: *ModulePackage, ending: str): int {
    path: str = package.info.data_path;
    for i in 0..len(package.files) {
        name: str = package.files[i].path;
        if (len(name) == len(path) + len(ending)) {
            same: bool = true;
            for k in 0..len(path)
                if (sword_lower(name[k] as int) != sword_lower(path[k] as int)) same = false;
            for k in 0..len(ending)
                if (sword_lower(name[len(path) + k] as int) != sword_lower(ending[k] as int)) same = false;
            if (same) return i
        }
    }
    -1
}

sword_lower(byte: int): int {
    if (byte >= 65 && byte <= 90) byte + 32 else byte
}

// The file's data, which must be there.
package_data(package: *ModulePackage, ending: str@immortal) raises SwordError: []i8@package {
    at: int = package_file(package, ending);
    if (at < 0) raise SwordError { failure: SwordFailure.MissingFile { ending: ending } };
    package.files[at].data
}

package_data_optional(package: *ModulePackage, ending: str): []i8@package {
    at: int = package_file(package, ending);
    if (at < 0) return sword_new_empty(package);
    package.files[at].data
}

sword_new_empty(package: *ModulePackage): []i8@package {
    // (Any empty slice will do: the package's first file has room for none
    // to be read.)
    if (len(package.files) > 0 && len(package.files[0].data) == 0) return package.files[0].data;
    sword_empty
}

sword_empty: []i8 = new i8[0](0i8);

// ---- reading the files' numbers (little-endian) ----
sword_u16(data: []i8, at: int): int {
    data[at] as int & 255 | (data[at + 1] as int & 255) << 8
}

sword_u32(data: []i8, at: int): int {
    data[at] as int & 255 | (data[at + 1] as int & 255) << 8 | (data[at + 2] as int & 255) << 16 | (data[at + 3] as int & 255) << 24
}

// A signed 32-bit number (a tree's links, -1 for none).
sword_s32(data: []i8, at: int): int {
    value: int = sword_u32(data, at);
    if (value >= 2147483648) value - 4294967296 else value
}

// ---- an entry's text ----
// Bytes from up to to of source as UTF-8 (a Latin-1 module's converted),
// NUL bytes and the CR LF or NUL padding at its end left out.
tag sword
entry_utf8(
    utf8: bool,
    source: []i8,
    from: int,
    to: int
): []i8@new {
    room: []i8 = new i8[entry_utf8_size(utf8, source, from, to)](0i8);
    _n: int = entry_utf8_into(utf8, source, from, to, room);
    room
}

entry_end(source: []i8, from: int, to: int): int {
    end: int = to;
    while (end > from && (source[end - 1] as int == 0 || source[end - 1] as int == 10 || source[end - 1] as int == 13)) end = end - 1;
    end
}

entry_utf8_size(
    utf8: bool,
    source: []i8,
    from: int,
    to: int
): int {
    count: int = 0;
    for i in from..entry_end(source, from, to) {
        byte: int = source[i] as int & 255;
        if (byte != 0) count = count + (if (!utf8 && byte >= 128) 2 else 1)
    }
    count
}

// The same into out (room for twice to - from): how many bytes.
entry_utf8_into(
    utf8: bool,
    source: []i8,
    from: int,
    to: int,
    out: []i8
): int {
    n: int = 0;
    for i in from..entry_end(source, from, to) {
        byte: int = source[i] as int & 255;
        if (byte != 0) {
            if (!utf8 && byte >= 128) {
                out[n] = (192 | byte >> 6) trunc i8;
                out[n + 1] = (128 | byte & 63) trunc i8;
                n = n + 2
            } else {
                out[n] = source[i];
                n = n + 1
            }
        }
    }
    n
}
