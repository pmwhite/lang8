tag sword_internal;

// General books: a tree of headings (a book's parts, chapters and
// sections), each perhaps with text. NAME.idx gives each node's place in
// NAME.dat (4 bytes each); there a node is its parent, next sibling and
// first child (each a place in NAME.idx, 4 bytes, -1 for none), its name
// ended by a 0, and its data's size (2 bytes) and data: for a node with
// text, the text's start and size in NAME.bdt (4+4). Nodes are numbered by
// their place in NAME.idx: the root, which has no name, is 0.
tag sword
type TreeModule = tag sword_internal {
    info: ModuleInfo;
    index: []i8;
    data: []i8;
    text: []i8
}

tag sword
tree_module_open(package: *ModulePackage@new) raises SwordError: *TreeModule@new {
    match package.info.storage {
        ByTree -> { }
        _ -> raise SwordError { failure: SwordFailure.NotSupported }
    }
    match module_support(&package.info) {
        Readable -> { }
        Unreadable _ -> raise SwordError { failure: SwordFailure.NotSupported }
    }
    new TreeModule {
        info: package.info,
        index: package_data(package, ".idx"),
        data: package_data(package, ".dat"),
        text: package_data(package, ".bdt")
    }
}

tag sword
tree_module_info(module: *TreeModule): *ModuleInfo@module {
    &module.info
}

tag sword
tree_module_count(module: *TreeModule): int {
    len(module.index) / 4
}

// Where node's record is in NAME.dat.
tree_module_record(module: *TreeModule, node: int) raises SwordError: int {
    if (node < 0 || node * 4 + 4 > len(module.index)) raise SwordError { failure: SwordFailure.BadIndex { ending: ".idx", at: node * 4 } };
    at: int = sword_u32(module.index, node * 4);
    if (at + 12 > len(module.data)) raise SwordError { failure: SwordFailure.BadIndex { ending: ".dat", at: at } };
    at
}

// A link in node's record (0 its parent, 1 its next sibling, 2 its first
// child) as a node (-1: none).
tree_module_link(module: *TreeModule, node: int, which: int) raises SwordError: int {
    place: int = sword_s32(module.data, tree_module_record(module, node) + which * 4);
    if (place < 0) return -1;
    if (place % 4 != 0 || place + 4 > len(module.index)) raise SwordError { failure: SwordFailure.BadIndex { ending: ".dat", at: place } };
    place / 4
}

tag sword
tree_module_parent(module: *TreeModule, node: int) raises SwordError: int {
    tree_module_link(module, node, 0)
}

tag sword
tree_module_next(module: *TreeModule, node: int) raises SwordError: int {
    tree_module_link(module, node, 1)
}

tag sword
tree_module_first_child(module: *TreeModule, node: int) raises SwordError: int {
    tree_module_link(module, node, 2)
}

// Where node's name ends (its 0) in NAME.dat.
tree_module_name_end(module: *TreeModule, node: int) raises SwordError: int {
    at: int = tree_module_record(module, node) + 12;
    end: int = at;
    while (end < len(module.data) && module.data[end] as int != 0) end = end + 1;
    if (end + 3 > len(module.data)) raise SwordError { failure: SwordFailure.BadIndex { ending: ".dat", at: at } };
    end
}

tag sword
tree_module_name(module: *TreeModule, node: int) raises SwordError: str@new {
    at: int = tree_module_record(module, node) + 12;
    text: []i8 = entry_utf8(module.info.utf8, module.data, at, tree_module_name_end(module,
        node));
    sword_text(text, 0, len(text))
}

// node's text as UTF-8 (empty: it has none).
tag sword
tree_module_text(module: *TreeModule, node: int) raises SwordError: []i8@new {
    end: int = tree_module_name_end(module, node);
    data_size: int = sword_u16(module.data, end + 1);
    if (data_size < 8) return new i8[0](0i8);
    if (end + 3 + 8 > len(module.data)) raise SwordError { failure: SwordFailure.BadIndex { ending: ".dat", at: end } };
    start: int = sword_u32(module.data, end + 3);
    size: int = sword_u32(module.data, end + 7);
    if (start + size > len(module.text)) raise SwordError { failure: SwordFailure.BadIndex { ending: ".bdt", at: start } };
    entry_utf8(module.info.utf8, module.text, start, start + size)
}
