tag sha1_internal;

sha1_rotate_left(x: u32, n: int): u32 {
    x << n | x >> 32 - n
}

sha1_word_byte(x: u32, shift: int): i8 {
    value: int = (x >> shift) as int;
    value trunc i8
}

type Sha1State = {
    h0: u32;
    h1: u32;
    h2: u32;
    h3: u32;
    h4: u32
}

sha1_block(state: *Sha1State, input: []i8) {
    w: []u32 = new u32[80](0u32);
    for i in 0..64 {
        word: int = i / 4;
        w[word] = w[word] << 8 | (input[i] as int & 255) trunc u32
    }
    for i in 16..80 w[i] = sha1_rotate_left(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16],
        1);
    a: u32 = state.h0;
    b: u32 = state.h1;
    c: u32 = state.h2;
    d: u32 = state.h3;
    e: u32 = state.h4;
    for i in 0..80 {
        f: u32 = 0u32;
        k: u32 = 0u32;
        if (i < 20) {
            f = b & c | ~b & d;
            k = 1518500249u32
        } else {
            if (i < 40) {
                f = b ^ c ^ d;
                k = 1859775393u32
            } else {
                if (i < 60) {
                    f = b & c | b & d | c & d;
                    k = 2400959708u32
                } else {
                    f = b ^ c ^ d;
                    k = 3395469782u32
                }
            }
        }
        temp: u32 = sha1_rotate_left(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = sha1_rotate_left(b, 30);
        b = a;
        a = temp
    }
    state.h0 = state.h0 + a;
    state.h1 = state.h1 + b;
    state.h2 = state.h2 + c;
    state.h3 = state.h3 + d;
    state.h4 = state.h4 + e
}

// SHA-1 for protocol compatibility. Returns 20 digest bytes in network order.
tag sha1
sha1_digest(data: []i8): []i8@new {
    size: int = len(data);
    state: Sha1State = Sha1State {
        h0: 1732584193u32,
        h1: 4023233417u32,
        h2: 2562383102u32,
        h3: 271733878u32,
        h4: 3285377520u32
    };
    cursor: int = 0;
    done: bool = false;
    block: []i8 = new i8[64](0i8);
    digest: []i8 = new i8[20](0i8);
    while (!done) {
        remaining: int = size - cursor;
        if (remaining < 64) {
            if (cursor > 0) {
                for i in 0..64 block[i] = 0i8
            }
            memcpy(block, 0, data, cursor, remaining);
            block[remaining] = 128 trunc i8;
            if (remaining >= 56) {
                region {
                    sha1_block(&state, block)
                }
                for i in 0..64 block[i] = 0i8
            }
            bits: int = size * 8;
            for i in 0..8 block[63 - i] = (bits >> i * 8) trunc i8;
            region {
                sha1_block(&state, block)
            }
            words: []u32 = [state.h0, state.h1, state.h2, state.h3, state.h4];
            for i in 0..len(words) {
                digest[i * 4] = sha1_word_byte(words[i], 24);
                digest[i * 4 + 1] = sha1_word_byte(words[i], 16);
                digest[i * 4 + 2] = sha1_word_byte(words[i], 8);
                digest[i * 4 + 3] = sha1_word_byte(words[i], 0)
            }
            done = true
        } else {
            memcpy(block, 0, data, cursor, 64);
            region {
                sha1_block(&state, block)
            }
            cursor = cursor + 64
        }
    }
    digest
}
