tag better;

use_tag std, gl, skate, ios;

// Better as an iPhone app: the same program as main.l8's, natively, built
// with `l8 arm64 --target ios` (see tools/ios/). UIKit runs it: an app
// delegate makes a window whose view is an OpenGL ES layer, a display link
// draws a frame when one is due, and the view takes touches and, for the
// field Better draws, the keyboard. CoreLocation watches where the phone is
// while Better wants it (recording, or ready to), on with the screen locked
// too: each fix is passed on as main.l8's page passes them, only as how far
// it is east and north of the one before, and how much higher; that fix is
// the only position held, and it is dropped when the watching stops.
//
// The log is kept in the app's Documents, with the recording under way.
// L8_DEMO=1 in the environment records a short run by itself, for the
// simulator in CI (see tools/ios/simulate.sh).
import "../../stdlib/print.l8";

import "../gl/core.l8";

import "../ios/objc.l8";

import "../skate/math.l8";

import "../skate/font.l8";

import "paint.l8";

import "text.l8";

import "log.l8";

import "record.l8";

import "pace.l8";

import "ui.l8";

import "touch.l8";

import "app.l8";

import "pages.l8";

import "frame.l8";

import "sync.l8";

extern getenv(name: str): ?*i8;

extern getenv_address(name: str): int = getenv;

extern glGetRenderbufferParameteriv(target: int, pname: int, out: *i32): int;

extern time(t: int): int;

extern localtime_r(t: *int, out: *Tm): int;

extern rename(from: str, to: str): int;

extern dlsym(handle: int, name: str): int;

// C's struct tm: its offset from UTC (seconds) is after nine ints.
type Tm = {
    sec: i32;
    min: i32;
    hour: i32;
    mday: i32;
    mon: i32;
    year: i32;
    wday: i32;
    yday: i32;
    isdst: i32;
    pad: i32;
    gmtoff: int;
    zone: int
}

// ---- what UIKit made ----
ios_app: int = 0;

ios_window: int = 0;

ios_controller: int = 0;

ios_view: int = 0;

ios_ctx: int = 0;

ios_layer: int = 0;

ios_locations: int = 0;

// The framebuffer and its renderbuffer (the layer's pixels), and its size.
ios_fb: []u32 = new u32[1](0u32);

ios_rb: []u32 = new u32[1](0u32);

ios_w: int = 0;

ios_size: []i32 = new i32[2](0i32);

ios_h: int = 0;

// Points to pixels.
ios_scale: f64 = 2.0f64;

ios_painter: ?*Painter = null;

// Where results of four doubles come back (see msg_hfa): kept, as callbacks
// run outside any region and what they make is never freed.
ios_hfa: []f64 = new f64[4](0.0f64);

ios_hfa2: []f64 = new f64[4](0.0f64);

// The clock, for frames; frames drawn with nothing moving (after a few,
// none are until something does); whether the keyboard is up.
ios_start_ns: int = 0;

ios_prev_ns: int = 0;

ios_still: int = 0;

ios_keyboard: bool = false;

// The fix before (degrees, meters), and whether there is one: the one
// position held.
ios_have_prev: bool = false;

ios_prev_lat: f64 = 0.0f64;

ios_prev_lon: f64 = 0.0f64;

ios_have_alt: bool = false;

ios_prev_alt: f64 = 0.0f64;

// Where the phone is is being watched.
ios_watching: bool = false;

// The demo (L8_DEMO): when it started, on the clock (0: no demo).
ios_demo_t: f32 = 0.0;

ios_demo_step: int = 0;

// A note on stderr (the simulator's console): how far starting got.
ios_note(what: str) {
    try {
        eprint(what)
    } with IoError _e -> { }
}

// The line as such a note.
ios_note_line() {
    try {
        write_bytes_n(2, line, line_n);
        eprint("")
    } with IoError _e -> { }
}

extern glGetError(): int;

// Frames drawn, and ticks (the first few say how they went).
ios_frames: int = 0;

ios_ticks: int = 0;

// ---- the platform, for frame.l8 ----
platform_gps(on: bool) {
    ios_watching = on;
    lm: int = ios_locations;
    if (lm == 0) return;
    if (on) {
        msg(lm, sel("requestWhenInUseAuthorization"));
        msg1(lm, sel("setAllowsBackgroundLocationUpdates:"), 1);
        msg1(lm, sel("setShowsBackgroundLocationIndicator:"), 1);
        msg(lm, sel("startUpdatingLocation"))
    } else {
        msg(lm, sel("stopUpdatingLocation"));
        msg1(lm, sel("setAllowsBackgroundLocationUpdates:"), 0);
        ios_have_prev = false;
        ios_have_alt = false
    }
}

// (Refused: the phone does not ask again, so its settings for Better are
// opened, to be allowed there.)
platform_gps_retry() {
    if (gps_state == GPS_DENIED) {
        url: int = msg1(cls("NSURL"), sel("URLWithString:"), nsstring("app-settings:"));
        msg3(ios_app, sel("openURL:options:completionHandler:"), url, msg(cls("NSDictionary"),
            sel("dictionary")), 0);
        return
    }
    if (ios_watching) {
        platform_gps(false);
        platform_gps(true)
    }
}

// The screen stays on while recording; the recording is dark, so the
// status bar is light on it.
platform_wake(on: bool) {
    msg1(ios_app, sel("setIdleTimerDisabled:"), if (on) 1 else 0);
    ios_style()
}

platform_theme(_pick: int, _dark: bool) raises IoError {
    line_clear();
    ios_save_settings();
    ios_style()
}

platform_goals() raises IoError {
    ios_save_settings()
}

// ---- chimes ----
// Each chime (see pace.l8 for when) is made here as a short WAV: soft
// struck notes, a sine with a little of its octave and twelfth that fade
// sooner. Faster: up a fourth, G to C; ease off: down, C to G; back on
// it: one A, quieter. They are played by AVAudioPlayer in a session that
// mixes with what else is playing (music, a podcast) and ducks it for the
// moment, then lets it go.
const CUE_RATE: int = 22050;

cue_wav: []i8 = new i8[44 + 2 * 22050](0i8);

cue_pcm: []f32 = new f32[22050](0.0);

ios_cue_player: int = 0;

// (When the session is to be let go, on the monotonic clock; 0 if it is
// not held.)
ios_cue_until: int = 0;

ios_cue_category: int = 0;

// A note of f Hz, from at seconds in, at loudness a, into cue_pcm.
cue_note(f: f32, at: f32, a: f32) {
    from: int = (at * CUE_RATE as f32) as int;
    n: int = len(cue_pcm);
    p1: f32 = 0.0;
    p2: f32 = 0.0;
    p3: f32 = 0.0;
    d: f32 = TAU * f / CUE_RATE as f32;
    for i in from..n {
        t: f32 = (i - from) as f32 / CUE_RATE as f32;
        env: f32 = minf(t / 0.008, 1.0) * expf(-t / 0.16);
        v: f32 = sinf(p1) + 0.3 * expf(-t / 0.06) * sinf(p2) + 0.1 * expf(-t / 0.04) * sinf(p3);
        cue_pcm[i] = cue_pcm[i] + a * env * v;
        p1 = fmodf(p1 + d, TAU);
        p2 = fmodf(p2 + 2.0 * d, TAU);
        p3 = fmodf(p3 + 3.0 * d, TAU)
    }
}

cue_put(at: int, v: int, bytes: int) {
    for k in 0..bytes cue_wav[at + k] = (v >> 8 * k & 255) trunc i8
}

// The chime k as a WAV in cue_wav: how many bytes.
cue_make(k: int): int {
    for i in 0..len(cue_pcm) cue_pcm[i] = 0.0;
    secs: f32 = 0.75;
    if (k == CUE_FASTER) {
        cue_note(783.99, 0.0, 0.32);
        cue_note(1046.5, 0.15, 0.32)
    }
    if (k == CUE_EASIER) {
        cue_note(1046.5, 0.0, 0.32);
        cue_note(783.99, 0.15, 0.32)
    }
    if (k == CUE_ON) {
        cue_note(880.0, 0.0, 0.22);
        secs = 0.6
    }
    n: int = (secs * CUE_RATE as f32) as int;
    data: int = 2 * n;
    for i in 0..4 cue_wav[i] = "RIFF"[i];
    cue_put(4, 36 + data, 4);
    for i in 0..4 cue_wav[8 + i] = "WAVE"[i];
    for i in 0..4 cue_wav[12 + i] = "fmt "[i];
    cue_put(16, 16, 4);
    cue_put(20, 1, 2);
    cue_put(22, 1, 2);
    cue_put(24, CUE_RATE, 4);
    cue_put(28, CUE_RATE * 2, 4);
    cue_put(32, 2, 2);
    cue_put(34, 16, 2);
    for i in 0..4 cue_wav[36 + i] = "data"[i];
    cue_put(40, data, 4);
    for i in 0..n {
        // (The last 20 ms fade to nothing.)
        fade: f32 = clampf((n - i) as f32 / (0.02 * CUE_RATE as f32), 0.0, 1.0);
        s: int = (clampf(cue_pcm[i] * fade, -1.0, 1.0) * 32767.0) as int;
        cue_put(44 + 2 * i, s & 65535, 2)
    }
    44 + data
}

// What a pointer points at (a word).
word8: []i8 = new i8[8](0i8);

ios_word_at(p: int): int {
    memcpy_from(word8, p, 8);
    v: int = 0;
    for k in 0..8 v = v | (word8[k] as int & 255) << 8 * k;
    v
}

platform_cue(k: int) {
    session: int = msg(cls("AVAudioSession"), sel("sharedInstance"));
    if (ios_cue_category == 0) {
        // (Playback, mixing with others (1) and ducking them (2).)
        at: int = dlsym(-2, "AVAudioSessionCategoryPlayback");
        if (at != 0) ios_cue_category = ios_word_at(at);
        if (ios_cue_category == 0) ios_cue_category = nsstring("AVAudioSessionCategoryPlayback");
        msg3(session, sel("setCategory:withOptions:error:"), ios_cue_category, 3,
            0)
    }
    active: int = msg2(session, sel("setActive:error:"), 1, 0) & 255;
    n: int = cue_make(k);
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(cue_wav),
        n);
    if (ios_cue_player != 0) msg(ios_cue_player, sel("release"));
    ios_cue_player = msg2(msg(cls("AVAudioPlayer"), sel("alloc")), sel("initWithData:error:"),
        data, 0);
    played: int = 0;
    if (ios_cue_player != 0) played = msg(ios_cue_player, sel("play")) & 255;
    ios_cue_until = clock_ns(1) + 1200000000;
    line_clear();
    line_add("better: chime ");
    line_int(k);
    line_add(", session ");
    line_int(active);
    line_add(", played ");
    line_int(played);
    ios_note_line()
}

// The session let go once the chime is over (others come back up).
ios_cue_done() {
    if (ios_cue_until == 0 || clock_ns(1) < ios_cue_until) return;
    ios_cue_until = 0;
    session: int = msg(cls("AVAudioSession"), sel("sharedInstance"));
    msg3(session, sel("setActive:withOptions:error:"), 0, 1, 0)
}

platform_blur() {
    if (ios_keyboard) {
        ios_keyboard = false;
        msg(ios_view, sel("resignFirstResponder"))
    }
}

// The status bar: light on Better's dark (and on the recording), dark on
// its light (asked of the controller, see controller_bar).
ios_bar_light: bool = false;

ios_style() {
    light: bool = theme_target() > 0.5 || rec_on;
    if (light == ios_bar_light) return;
    ios_bar_light = light;
    if (ios_controller != 0) msg(ios_controller, sel("setNeedsStatusBarAppearanceUpdate"))
}

controller_bar(_self: int, _cmd: int): int {
    if (ios_bar_light) return 1;
    3
}

// ---- files ----
// A file in the app's Documents, as a path.
ios_document(name: str): str@new {
    line_clear();
    for c in nsstring_bytes(NSHomeDirectory()) line_byte(c as int);
    line_add("/Documents/");
    line_add(name);
    cstr(text_of_line())
}

text_of_line(): []i8@new {
    out: []i8 = new i8[line_n](0i8);
    for i in 0..line_n out[i] = line[i];
    out
}

settings_path: str = "";

// The settings file: the theme picked, then the personal link's secret,
// the worker's revision the log was last the same as, and whether it has
// changed here since.
ios_save_settings() raises IoError {
    lt_n = 0;
    line_clear();
    line_int(theme_pick);
    lt_line();
    if (sync_linked()) {
        line_clear();
        line_add("me ");
        for i in 0..sync_secret_n line_byte(sync_secret[i] as int);
        lt_line();
        line_clear();
        line_add("rev ");
        line_int(sync_rev);
        lt_line();
        line_clear();
        line_add("dirty ");
        line_int(if (sync_dirty) 1 else 0);
        lt_line()
    }
    line_clear();
    line_add("goals ");
    line_goals();
    lt_line();
    write_file(settings_path)
}

ios_load_settings() {
    n: int = read_file(settings_path);
    if (n > 0 && lg_t[0] as int >= 48 && lg_t[0] as int <= 50) theme_pick = lg_t[0] as int - 48;
    i: int = 0;
    while (i < n) {
        e: int = i;
        while (e < n && lg_t[e] as int != 10) e = e + 1;
        if (merge_starts(lg_t, i, e, "me ")) {
            k: int = 0;
            for j in i + 3..e {
                if (k < len(sync_secret)) {
                    sync_secret[k] = lg_t[j];
                    k = k + 1
                }
            }
            sync_secret_n = k
        }
        if (merge_starts(lg_t, i, e, "rev ")) sync_rev = merge_key(lg_t, i, e);
        if (merge_starts(lg_t, i, e, "dirty ")) sync_dirty = merge_key(lg_t, i, e) == 1;
        if (merge_starts(lg_t, i, e, "goals ")) {
            lg_i = i + 6;
            lg_to = e;
            for s in 0..SPORTS goal_set(s, read_int());
            cues_on = read_int() != 0
        }
        i = e + 1
    }
}

// ---- the log, kept with the personal link ----
// Requests go to the worker one at a time (see sync.l8), through one
// session whose delegate is the app: the answer's bytes gather in
// http_got, and when it is done, sync.l8 is told how it went.
api_url: str = "https://trailingwhite.space/better/api";

ios_session: int = 0;

http_got: []i8 = new i8[8388608](0i8);

http_got_n: int = 0;

platform_http(
    method: str,
    path: str,
    body: []i8,
    n: int
) {
    if (ios_session == 0) {
        sync_answer(0, http_got, 0);
        return
    }
    line_clear();
    line_add(api_url);
    line_add(path);
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), nsstring_of(line, line_n));
    request: int = msg1(cls("NSMutableURLRequest"), sel("requestWithURL:"), url);
    msg1(request, sel("setHTTPMethod:"), nsstring(method));
    msg_set_f(request, sel("setTimeoutInterval:"), 15.0f64);
    line_clear();
    line_add("Bearer ");
    for i in 0..sync_secret_n line_byte(sync_secret[i] as int);
    msg2(request, sel("setValue:forHTTPHeaderField:"), nsstring_of(line, line_n),
        nsstring("Authorization"));
    if (n > 0) {
        msg2(request, sel("setValue:forHTTPHeaderField:"), nsstring("application/json"),
            nsstring("Content-Type"));
        msg1(request, sel("setHTTPBody:"), msg2(cls("NSData"), sel("dataWithBytes:length:"),
            bytes_address(body), n))
    }
    http_got_n = 0;
    msg(msg1(ios_session, sel("dataTaskWithRequest:"), request), sel("resume"));
    line_clear();
    line_add("better: sync ");
    line_add(method);
    line_byte(32);
    line_add(path);
    ios_note_line()
}

http_data(
    _self: int,
    _cmd: int,
    _session: int,
    _task: int,
    data: int
): int {
    n: int = msg(data, sel("length"));
    if (http_got_n + n <= len(http_got)) {
        msg2(data, sel("getBytes:length:"), bytes_address(http_got) + http_got_n,
            n);
        http_got_n = http_got_n + n
    }
    0
}

http_done(
    _self: int,
    _cmd: int,
    _session: int,
    task: int,
    error: int
): int {
    status: int = 0;
    response: int = msg(task, sel("response"));
    if (error == 0 && response != 0) status = msg(response, sel("statusCode"));
    line_clear();
    line_add("better: sync answered ");
    line_int(status);
    line_add(", ");
    line_int(http_got_n);
    line_add(" bytes");
    ios_note_line();
    sync_answer(status, http_got, http_got_n);
    ios_still = 0;
    0
}

// Opened with the personal link (better://link#me=SECRET): the log kept
// with it from now on.
url_buf: []i8 = new i8[1024](0i8);

app_open_url(
    _self: int,
    _cmd: int,
    _application: int,
    url: int,
    _options: int
): int {
    n: int = nsstring_into(msg(url, sel("absoluteString")), url_buf);
    if (!sync_link_from(url_buf, n)) {
        ios_note("better: not a link Better knows");
        return 0
    }
    ios_note("better: linked");
    sync_state = 2;
    line_clear();
    line_add("Your log is now kept with your link");
    toast_line();
    sync_pull();
    ios_still = 0;
    1
}

// Looked at again: what was saved from elsewhere since; put away: what
// changed here, sent.
app_foreground(_self: int, _cmd: int, _application: int): int {
    sync_pull();
    ios_still = 0;
    0
}

app_background(_self: int, _cmd: int, _application: int): int {
    if (sync_dirty) sync_push();
    0
}

// ---- the clock ----
// Now (from 1970) and how far ahead of UTC the phone's clock is.
ios_set_clock() {
    t: int = time(0);
    tm: Tm = Tm {
        sec: 0i32,
        min: 0i32,
        hour: 0i32,
        mday: 0i32,
        mon: 0i32,
        year: 0i32,
        wday: 0i32,
        yday: 0i32,
        isdst: 0i32,
        pad: 0i32,
        gmtoff: 0,
        zone: 0
    };
    localtime_r(&t, &tm);
    clock_set(clock_ns(0) / 1000000, tm.gmtoff / 60)
}

// ---- a frame ----
// The app's state on to now, and what the platform is told, and the files.
ios_step() raises IoError {
    now: int = clock_ns(1);
    dt: f32 = clampf((now - ios_prev_ns) as f32 / 1000000000.0, 0.0, 0.05);
    ios_prev_ns = now;
    better_step(dt, (now - ios_start_ns) as f32 / 1000000000.0);
    ios_demo();
    ios_cue_done();
    saving: bool = wants_save;
    better_after();
    if (saving) sync_saved();
    sync_step();
    if (sync_settings_changed) {
        sync_settings_changed = false;
        ios_save_settings()
    }
}

// The display link's tick: a frame, drawn if one is due.
ios_tick(_self: int, _cmd: int, _link: int): int {
    try {
        ios_ticks = ios_ticks + 1;
        if (ios_ticks <= 2) {
            line_clear();
            line_add("better: tick ");
            line_int(ios_ticks);
            ios_note_line()
        }
        ios_step();
        if (busy || g_finger >= 0) ios_still = 0;
        // The keyboard is up while Better's field is written in.
        if (field_on >= 0 && !ios_keyboard) {
            ios_keyboard = true;
            msg(ios_view, sel("becomeFirstResponder"))
        }
        if (field_on < 0 && ios_keyboard) platform_blur();
        painter: ?*Painter = ios_painter;
        if (ios_still < 3 && painter != null) {
            ios_bind();
            if (better_draw(painter, ios_w, ios_h)) ios_still = 0 else ios_still = ios_still + 1;
            glBindRenderbuffer(36161, ios_rb[0]);
            shown: int = msg1(ios_ctx, sel("presentRenderbuffer:"), 36161) & 255;
            ios_frames = ios_frames + 1;
            if (ios_frames <= 2 || ios_frames == 100) {
                line_clear();
                line_add("better: frame ");
                line_int(ios_frames);
                line_add(" in ");
                line_int(ios_w);
                line_add(" by ");
                line_int(ios_h);
                line_add(", ");
                line_int(p_n);
                line_add(" quads, GL error ");
                line_int(glGetError());
                line_add(", presented ");
                line_int(shown);
                ios_note_line()
            }
        }
    } with IoError _e -> { }
    0
}

ios_bind() {
    msg1(cls("EAGLContext"), sel("setCurrentContext:"), ios_ctx);
    glBindFramebuffer(36160, ios_fb[0])
}

// The layer's pixels, as big as the view now is.
ios_storage() {
    if (ios_ctx == 0) return;
    ios_bind();
    glBindRenderbuffer(36161, ios_rb[0]);
    stored: int = msg2(ios_ctx, sel("renderbufferStorage:fromDrawable:"), 36161, ios_layer) & 255;
    glFramebufferRenderbuffer(36160, 36064, 36161, ios_rb[0]);
    glGetRenderbufferParameteriv(36161, 36162, &ios_size[0]);
    glGetRenderbufferParameteriv(36161, 36163, &ios_size[1]);
    ios_w = ios_size[0] as int;
    ios_h = ios_size[1] as int;
    ios_still = 0;
    line_clear();
    line_add("better: storage ");
    line_int(stored);
    line_add(", ");
    line_int(ios_w);
    line_add(" by ");
    line_int(ios_h);
    line_add(", framebuffer ");
    line_int(glCheckFramebufferStatus(36160));
    line_add(" (36053 complete)");
    ios_note_line()
}

// The view's size, edges and lightness, as they now are.
ios_measure() {
    l8_msg_hfa(ios_hfa2, ios_view, sel("safeAreaInsets"), 0, 0, 0);
    insets: []f64 = ios_hfa2;
    safe_top = insets[0] as f32;
    safe_left = insets[1] as f32;
    safe_bottom = insets[2] as f32;
    safe_right = insets[3] as f32;
    p_ui = ios_scale as f32;
    phone_dark = msg(msg(ios_view, sel("traitCollection")), sel("userInterfaceStyle")) == 2;
    ios_still = 0
}

// ---- the view ----
// Its layer is CAEAGLLayer's (a class method).
view_layer_class(_self: int, _cmd: int): int {
    cls("CAEAGLLayer")
}

view_layout(_self: int, _cmd: int): int {
    ios_storage();
    ios_measure();
    0
}

view_traits(_self: int, _cmd: int, _previous: int): int {
    ios_measure();
    0
}

// Touches: one finger is followed (see touch.l8), in points, which are
// Better's pixels.
ios_touch_at(touches: int): []f64 {
    touch: int = msg(touches, sel("anyObject"));
    l8_msg_hfa(ios_hfa, touch, sel("locationInView:"), ios_view, 0, 0);
    ios_hfa
}

view_began(
    _self: int,
    _cmd: int,
    touches: int,
    _event: int
): int {
    p: []f64 = ios_touch_at(touches);
    finger_down(1, p[0] as f32, p[1] as f32);
    ios_still = 0;
    0
}

view_moved(
    _self: int,
    _cmd: int,
    touches: int,
    _event: int
): int {
    p: []f64 = ios_touch_at(touches);
    finger_move(1 << 8, p[0] as f32, p[1] as f32);
    ios_still = 0;
    0
}

view_ended(
    _self: int,
    _cmd: int,
    touches: int,
    _event: int
): int {
    p: []f64 = ios_touch_at(touches);
    finger_up(1, p[0] as f32, p[1] as f32);
    ios_still = 0;
    0
}

// The keyboard (UIKeyInput): what is typed goes to Better as keys.
view_yes(_self: int, _cmd: int): int {
    1
}

view_insert(_self: int, _cmd: int, text: int): int {
    for c in nsstring_bytes(text) {
        k: int = c as int & 255;
        if (k == 10) key_press(65293) else if (k >= 32 && k < 127) key_press(k)
    }
    ios_still = 0;
    0
}

view_delete(_self: int, _cmd: int): int {
    key_press(65288);
    ios_still = 0;
    0
}

// UITextInputTraits: words begin capitalized, no autocorrection, and the
// return key says Done.
view_capitalize(_self: int, _cmd: int): int {
    1
}

view_no_correction(_self: int, _cmd: int): int {
    1
}

view_done_key(_self: int, _cmd: int): int {
    9
}

// ---- where the phone is ----
// Each fix: as a step from the one before (and how much higher), then on
// through Better as the page's fixes go (see app.l8's read_inbox).
loc_update(
    _self: int,
    _cmd: int,
    _manager: int,
    locations: int
): int {
    n: int = msg(locations, sel("count"));
    for i in 0..n ios_fix(msg1(locations, sel("objectAtIndex:"), i));
    try {
        ios_step()
    } with IoError _e -> { }
    0
}

ios_fix(location: int) {
    acc: f64 = msg_f(location, sel("horizontalAccuracy"));
    if (acc < 0.0f64) return;
    l8_msg_hfa(ios_hfa2, location, sel("coordinate"), 0, 0, 0);
    c: []f64 = ios_hfa2;
    lat: f64 = c[0];
    lon: f64 = c[1];
    dx: f64 = 0.0f64;
    dy: f64 = 0.0f64;
    if (ios_have_prev) {
        rad: f64 = 0.017453292519943295f64;
        earth: f64 = 6371008.8f64;
        dy = (lat - ios_prev_lat) * rad * earth;
        dx = (lon - ios_prev_lon) * rad * earth * cos64((lat + ios_prev_lat) * 0.5f64 * rad)
    }
    ios_have_prev = true;
    ios_prev_lat = lat;
    ios_prev_lon = lon;
    dz: f64 = 0.0f64;
    zacc: f64 = msg_f(location, sel("verticalAccuracy"));
    if (zacc >= 0.0f64) {
        alt: f64 = msg_f(location, sel("altitude"));
        if (ios_have_alt) dz = alt - ios_prev_alt;
        ios_have_alt = true;
        ios_prev_alt = alt
    }
    spd: f64 = msg_f(location, sel("speed"));
    at: f64 = msg_f(msg(location, sel("timestamp")), sel("timeIntervalSince1970"));
    v: f32 = -1.0;
    if (spd >= 0.0f64) v = spd as f32;
    za: f32 = -1.0;
    if (zacc >= 0.0f64) za = zacc as f32;
    fix((at * 1000.0f64) as int, dx as f32, dy as f32, acc as f32, v, dz as f32, za)
}

// cos for degrees' worth of radians, in doubles (latitudes: small arguments).
cos64(x: f64): f64 {
    x2: f64 = x * x;
    1.0f64 - x2 / 2.0f64 + x2 * x2 / 24.0f64 - x2 * x2 * x2 / 720.0f64 + x2 * x2 * x2 * x2 / 40320.0f64
}

// Whether the phone lets Better know where it is.
loc_authorization(_self: int, _cmd: int, manager: int): int {
    status: int = msg(manager, sel("authorizationStatus"));
    if (status == 1 || status == 2) gps_state = GPS_DENIED;
    if ((status == 3 || status == 4) && ios_watching) {
        if (gps_state == GPS_DENIED || gps_state == GPS_OFF) gps_state = GPS_LOOKING;
        msg(manager, sel("startUpdatingLocation"))
    }
    ios_still = 0;
    0
}

loc_failed(
    _self: int,
    _cmd: int,
    _manager: int,
    error: int
): int {
    if (msg(error, sel("code")) == 1) gps_state = GPS_DENIED;
    ios_still = 0;
    0
}

// ---- the app ----
app_launched(
    self: int,
    _cmd: int,
    application: int,
    _options: int
): int {
    ios_note("better: launched");
    ios_app = application;
    screen: int = msg(cls("UIScreen"), sel("mainScreen"));
    l8_msg_hfa(ios_hfa2, screen, sel("bounds"), 0, 0, 0);
    frame: []f64 = ios_hfa2;
    ios_scale = msg_f(screen, sel("nativeScale"));
    ios_window = msg_rect(msg(cls("UIWindow"), sel("alloc")), sel("initWithFrame:"),
        frame[0], frame[1], frame[2], frame[3]);
    controller: int = make("L8BetterController");
    ios_controller = controller;
    ios_view = msg_rect(msg(cls("L8BetterView"), sel("alloc")), sel("initWithFrame:"),
        frame[0], frame[1], frame[2], frame[3]);
    msg_set_f(ios_view, sel("setContentScaleFactor:"), ios_scale);
    msg1(ios_view, sel("setMultipleTouchEnabled:"), 0);
    msg1(controller, sel("setView:"), ios_view);
    msg1(ios_window, sel("setRootViewController:"), controller);
    msg(ios_window, sel("makeKeyAndVisible"));
    ios_layer = msg(ios_view, sel("layer"));
    line_clear();
    line_add("better: layer ");
    for c in nsstring_bytes(msg(msg(ios_layer, sel("class")), sel("description"))) line_byte(c as int);
    ios_note_line();
    msg1(ios_layer, sel("setOpaque:"), 1);
    // (The OpenGL ES context and the painter were made before; the layer's
    // pixels now.)
    ios_storage();
    ios_measure();
    // Where the phone is: asked for when Better wants it.
    ios_locations = make("CLLocationManager");
    msg1(ios_locations, sel("setDelegate:"), self);
    msg_set_f(ios_locations, sel("setDesiredAccuracy:"), -1.0f64);
    msg_set_f(ios_locations, sel("setDistanceFilter:"), -1.0f64);
    msg1(ios_locations, sel("setActivityType:"), 3);
    msg1(ios_locations, sel("setPausesLocationUpdatesAutomatically:"), 0);
    if (ios_watching) platform_gps(true);
    // The log, kept with the personal link: what is there now.
    ios_session = msg3(cls("NSURLSession"), sel("sessionWithConfiguration:delegate:delegateQueue:"),
        msg(cls("NSURLSessionConfiguration"), sel("defaultSessionConfiguration")),
        self, msg(cls("NSOperationQueue"), sel("mainQueue")));
    if (sync_linked()) sync_state = 1;
    sync_pull();
    // A frame each time the screen is ready for one.
    link: int = msg2(cls("CADisplayLink"), sel("displayLinkWithTarget:selector:"),
        self, sel("tick:"));
    msg2(link, sel("addToRunLoop:forMode:"), msg(cls("NSRunLoop"), sel("mainRunLoop")),
        l8_run_loop_common_modes());
    line_clear();
    line_add("better: display link ");
    if (link != 0) line_add("made") else line_add("NOT made");
    line_add(", delegate responds to tick: ");
    line_int(msg1(self, sel("respondsToSelector:"), sel("tick:")) & 255);
    ios_note_line();
    ios_style();
    ios_note("better: window up");
    1
}

// ---- the demo, for the simulator in CI ----
// Ready a while; record a run (where the simulator's route takes it);
// finish, and save; the activity's page.
ios_demo() {
    if (ios_demo_t <= 0.0) return;
    t: f32 = now_t - ios_demo_t;
    // (The chimes, one after another, from 1 s: a check that they play.)
    if (hear_t < 0.0 && t > 1.0 && t < 1.5) hear_t = now_t;
    if (ios_demo_step == 0 && t > 3.0) {
        ios_demo_step = 1;
        start()
    }
    if (ios_demo_step == 1 && t > 22.0) {
        ios_demo_step = 2;
        finish()
    }
    if (ios_demo_step == 2 && t > 28.0) {
        ios_demo_step = 3;
        save()
    }
}

// ---- classes, then UIKit ----
main() noregion: int {
    ios_note("better: starting");
    log_path = ios_document("better-log.txt");
    live_path = ios_document("better-live.txt");
    settings_path = ios_document("better-settings.txt");
    // (Kept under Tempo's names until build 3: moved over, once.)
    rename(ios_document("tempo-log.txt"), log_path);
    rename(ios_document("tempo-live.txt"), live_path);
    rename(ios_document("tempo-settings.txt"), settings_path);
    on_page = false;
    sync_native = true;
    touch_ui = true;
    ios_set_clock();
    ios_load_settings();
    told_goals = goals_sum();
    better_open();
    ios_start_ns = clock_ns(1);
    ios_prev_ns = ios_start_ns;
    if (getenv("L8_DEMO") != null) ios_demo_t = 0.001;
    // (A personal link to start with, for a test: better://link#me=... is
    // asked about first, which a test cannot answer.)
    link: int = getenv_address("L8_LINK");
    if (link != 0) {
        n: int = mini(strlen(link), len(url_buf));
        memcpy_from(url_buf, link, n);
        if (sync_link_from(url_buf, n)) ios_note("better: linked")
    }
    // OpenGL ES 3, and what Better paints with (made here: what a callback
    // makes is not kept).
    ios_ctx = msg1(msg(cls("EAGLContext"), sel("alloc")), sel("initWithAPI:"), 3);
    msg1(cls("EAGLContext"), sel("setCurrentContext:"), ios_ctx);
    glGenFramebuffers(1, &ios_fb[0]);
    glGenRenderbuffers(1, &ios_rb[0]);
    p_gles = true;
    ios_note("better: OpenGL ES");
    try {
        ios_painter = new_painter()
    } with IoError _e -> { }
    ios_note("better: painter made");
    // The view: an OpenGL ES layer that takes touches and the keyboard.
    view: int = objc_allocateClassPair(cls("UIView"), "L8BetterView", 0);
    add_method0(object_getClass(view), sel("layerClass"), &view_layer_class, "#@:");
    add_method0(view, sel("layoutSubviews"), &view_layout, "v@:");
    add_method1(view, sel("traitCollectionDidChange:"), &view_traits, "v@:@");
    add_method2(view, sel("touchesBegan:withEvent:"), &view_began, "v@:@@");
    add_method2(view, sel("touchesMoved:withEvent:"), &view_moved, "v@:@@");
    add_method2(view, sel("touchesEnded:withEvent:"), &view_ended, "v@:@@");
    add_method2(view, sel("touchesCancelled:withEvent:"), &view_ended, "v@:@@");
    add_method0(view, sel("canBecomeFirstResponder"), &view_yes, "B@:");
    add_method0(view, sel("hasText"), &view_yes, "B@:");
    add_method1(view, sel("insertText:"), &view_insert, "v@:@");
    add_method0(view, sel("deleteBackward"), &view_delete, "v@:");
    add_method0(view, sel("autocapitalizationType"), &view_capitalize, "q@:");
    add_method0(view, sel("autocorrectionType"), &view_no_correction, "q@:");
    add_method0(view, sel("returnKeyType"), &view_done_key, "q@:");
    add_protocol(view, "UIKeyInput");
    objc_registerClassPair(view);
    // Its controller, which says which status bar Better wants.
    controller: int = objc_allocateClassPair(cls("UIViewController"), "L8BetterController",
        0);
    add_method0(controller, sel("preferredStatusBarStyle"), &controller_bar, "q@:");
    objc_registerClassPair(controller);
    // The app's delegate: the window, the frames, and where the phone is.
    app: int = objc_allocateClassPair(cls("UIResponder"), "L8BetterApp", 0);
    add_method2(app, sel("application:didFinishLaunchingWithOptions:"), &app_launched,
        "B@:@@");
    add_method1(app, sel("tick:"), &ios_tick, "v@:@");
    add_method2(app, sel("locationManager:didUpdateLocations:"), &loc_update, "v@:@@");
    add_method1(app, sel("locationManagerDidChangeAuthorization:"), &loc_authorization,
        "v@:@");
    add_method2(app, sel("locationManager:didFailWithError:"), &loc_failed, "v@:@@");
    add_method3(app, sel("application:openURL:options:"), &app_open_url, "B@:@@@");
    add_method1(app, sel("applicationWillEnterForeground:"), &app_foreground, "v@:@");
    add_method1(app, sel("applicationDidEnterBackground:"), &app_background, "v@:@");
    add_method3(app, sel("URLSession:dataTask:didReceiveData:"), &http_data, "v@:@@@");
    add_method3(app, sel("URLSession:task:didCompleteWithError:"), &http_done, "v@:@@@");
    add_protocol(app, "UIApplicationDelegate");
    add_protocol(app, "CLLocationManagerDelegate");
    add_protocol(app, "NSURLSessionDataDelegate");
    objc_registerClassPair(app);
    ios_note("better: classes made; UIKit next");
    UIApplicationMain(l8rt_argc(), l8rt_argv(), 0, nsstring("L8BetterApp"))
}
