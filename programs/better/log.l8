tag better;

use_tag std, skate;

// The log: each activity (a run, a ride or a walk) as what was worked out
// from it while it was recorded, and nothing of where it went: when it
// started, how long it took, how far it went, its top speed, how far it
// went in each few seconds of moving (its speed through it), how much it
// climbed and descended (and how much higher or lower than where it
// started it was, along the way), the time of each kilometer and each
// mile, and its fastest stretches of standard lengths. Nothing kept says
// where it was, or how high above the sea.
//
// It is kept in a file of its own, a line to a thing, each activity's
// lines after its own:
//
//   units mi|km
//   act START TZ SPORT ELAPSED MOVING DIST MAX NAME...
//                    START seconds from 1970 (UTC), TZ the minutes its
//                    clock was ahead of UTC, SPORT run|ride|walk, ELAPSED
//                    and MOVING seconds, DIST decimeters, MAX cm a second
//   sp STEP D...     decimeters gone in each STEP seconds of moving
//   up GAIN LOSS     decimeters climbed and descended
//   el Z...          decimeters higher than at the start, at the end of
//                    each step of sp (if the phone measured heights)
//   km S...          seconds each whole kilometer took (moving)
//   mi S...          the same, each mile
//   best S...        seconds of the fastest stretch of each of the
//                    sport's standard lengths (0 if not gone so far)
//   gone START       an activity taken out (so that another device's copy
//                    of the log does not bring it back)
const SPORTS: int = 3;

const S_RUN: int = 0;

const S_RIDE: int = 1;

const S_WALK: int = 2;

sport_key: []str = ["run", "ride", "walk"];

sport_title: []str = ["Run", "Ride", "Walk"];

// (For the middle of a sentence.)
sport_word: []str = ["run", "ride", "walk"];

// The fastest stretches looked for, in meters, and what they are called.
const BESTS: int = 6;

best_m: []f32 = [1000.0, 1609.344, 5000.0, 10000.0, 21097.5, 42195.0, 5000.0, 10000.0,
    20000.0, 40000.0, 80467.2, 160934.4, 1000.0, 1609.344, 5000.0, 10000.0, 21097.5,
    42195.0];

best_title: []str = ["1 km", "1 mile", "5 km", "10 km", "Half marathon", "Marathon",
    "5 km", "10 km", "20 km", "40 km", "50 miles", "100 miles", "1 km", "1 mile",
    "5 km", "10 km", "Half marathon", "Marathon"];

best_short: []str = ["1K", "1 mi", "5K", "10K", "Half", "Full", "5K", "10K", "20K",
    "40K", "50 mi", "100 mi", "1K", "1 mi", "5K", "10K", "Half", "Full"];

const MILE: f32 = 1609.344;

// Miles (or kilometers) shown, and whether the log has said which.
miles: bool = true;

units_said: bool = false;

// ---- the activities ----
const ACTS: int = 3000;

// Speed through an activity: at most so many steps of it are kept.
const STEPS_MOST: int = 360;

const SAMPLES: int = 600000;

const SPLITS: int = 200000;

// (Heights: a step's each, as many as speeds.)
const HEIGHTS: int = 600000;

act_n: int = 0;

act_start: []int = static_buffer(ACTS, 0);

act_tz: []int = static_buffer(ACTS, 0);

act_sport: []int = static_buffer(ACTS, 0);

act_elapsed: []int = static_buffer(ACTS, 0);

act_moving: []int = static_buffer(ACTS, 0);

act_dist: []int = static_buffer(ACTS, 0);

act_max: []int = static_buffer(ACTS, 0);

act_name: []int = static_buffer(ACTS, 0);

act_gone: []bool = static_buffer(ACTS, false);

// Its speed: STEP seconds a sample, the samples' first and count in sp.
act_step: []int = static_buffer(ACTS, 5);

act_sp0: []int = static_buffer(ACTS, 0);

act_spn: []int = static_buffer(ACTS, 0);

sp: []int = static_buffer(SAMPLES, 0);

sp_n: int = 0;

// Its splits (kilometers, then miles) in splits.
act_km0: []int = static_buffer(ACTS, 0);

act_kmn: []int = static_buffer(ACTS, 0);

act_mi0: []int = static_buffer(ACTS, 0);

act_min: []int = static_buffer(ACTS, 0);

splits: []int = static_buffer(SPLITS, 0);

splits_n: int = 0;

act_best: []int = static_buffer(ACTS * BESTS, 0);

// How much it climbed and descended (decimeters), and its heights along
// the way (decimeters from where it started, a step of sp each; none if
// the phone measured no heights) in el.
act_gain: []int = static_buffer(ACTS, 0);

act_loss: []int = static_buffer(ACTS, 0);

act_el0: []int = static_buffer(ACTS, 0);

act_eln: []int = static_buffer(ACTS, 0);

el: []int = static_buffer(HEIGHTS, 0);

el_n: int = 0;

// Activities taken out (by START), as the log has them.
const GONE: int = 4000;

gone_start: []int = static_buffer(GONE, 0);

gone_n: int = 0;

// A new activity, at the end: its number (-1 if there is no room).
new_act(start: int, tz: int, sport: int): int {
    if (act_n >= ACTS) return -1;
    a: int = act_n;
    act_start[a] = start;
    act_tz[a] = tz;
    act_sport[a] = clampi(sport, 0, SPORTS - 1);
    act_elapsed[a] = 0;
    act_moving[a] = 0;
    act_dist[a] = 0;
    act_max[a] = 0;
    act_name[a] = 0;
    act_gone[a] = false;
    act_step[a] = 5;
    act_sp0[a] = sp_n;
    act_spn[a] = 0;
    act_km0[a] = splits_n;
    act_kmn[a] = 0;
    act_mi0[a] = splits_n;
    act_min[a] = 0;
    act_gain[a] = 0;
    act_loss[a] = 0;
    act_el0[a] = el_n;
    act_eln[a] = 0;
    for b in 0..BESTS act_best[a * BESTS + b] = 0;
    act_n = act_n + 1;
    a
}

add_sample(a: int, v: int) {
    if (sp_n >= SAMPLES) return;
    sp[sp_n] = v;
    sp_n = sp_n + 1;
    act_spn[a] = act_spn[a] + 1
}

add_height(a: int, v: int) {
    if (el_n >= HEIGHTS) return;
    el[el_n] = v;
    el_n = el_n + 1;
    act_eln[a] = act_eln[a] + 1
}

add_split(a: int, km: bool, v: int) {
    if (splits_n >= SPLITS) return;
    splits[splits_n] = v;
    splits_n = splits_n + 1;
    if (km) act_kmn[a] = act_kmn[a] + 1 else act_min[a] = act_min[a] + 1
}

// Taken out: kept out of the log, and remembered as gone.
remove_act(a: int) {
    if (a < 0 || a >= act_n || act_gone[a]) return;
    act_gone[a] = true;
    if (gone_n < GONE) {
        gone_start[gone_n] = act_start[a];
        gone_n = gone_n + 1
    }
}

is_gone(start: int): bool {
    for g in 0..gone_n {
        if (gone_start[g] == start) return true
    }
    false
}

// The activity that started at `start` (-1 if none).
act_at(start: int): int {
    for a in 0..act_n {
        if (act_start[a] == start && !act_gone[a]) return a
    }
    -1
}

// Its day (days from 1970 where it was), and its minute of the day.
act_day(a: int): int {
    s: int = act_start[a] + act_tz[a] * 60;
    if (s < 0) return (s - 86399) / 86400;
    s / 86400
}

act_minute(a: int): int {
    s: int = act_start[a] + act_tz[a] * 60;
    (s % 86400 + 86400) % 86400 / 60
}

act_meters(a: int): f32 {
    act_dist[a] as f32 * 0.1
}

// Its average speed while moving, meters a second.
act_speed(a: int): f32 {
    if (act_moving[a] <= 0) return 0.0;
    act_meters(a) / act_moving[a] as f32
}

split_at(a: int, km: bool, i: int): int {
    if (km) return splits[act_km0[a] + i];
    splits[act_mi0[a] + i]
}

split_n(a: int, km: bool): int {
    if (km) return act_kmn[a];
    act_min[a]
}

// ---- the units ----
unit_m(): f32 {
    if (miles) return MILE;
    1000.0
}

unit_word(): str {
    if (miles) return "mi";
    "km"
}

unit_title(): str {
    if (miles) return "Mile";
    "Kilometer"
}

// A distance in the units, as 3.21 (two places under 10, one under 100).
line_dist(m: f32) {
    u: f32 = m / unit_m();
    if (u < 10.0) {
        line_fixed(u, 2);
        return
    }
    if (u < 100.0) {
        line_fixed(u, 1);
        return
    }
    line_count((u + 0.5) as int)
}

// A height (or a change of height) in feet (miles) or meters.
line_height(m: f32) {
    if (miles) {
        line_count((m * 3.28084 + 0.5) as int);
        line_add(" ft");
        return
    }
    line_count((m + 0.5) as int);
    line_add(" m")
}

// x to so many places, trailing zeros and all (3.20).
line_fixed(x: f32, places: int) {
    v: f32 = maxf(x, 0.0);
    scale: int = pow10(places);
    whole: int = (v * scale as f32 + 0.5) as int;
    line_count(whole / scale);
    if (places == 0) return;
    line_byte(46);
    frac: int = whole % scale;
    d: int = scale / 10;
    while (d > 0) {
        line_byte(48 + frac / d % 10);
        d = d / 10
    }
}

// A time: 1:02:03, 12:03, or (short) 1h 02m.
line_time(secs: int) {
    s: int = maxi(secs, 0);
    h: int = s / 3600;
    m: int = s / 60 % 60;
    if (h > 0) {
        line_int(h);
        line_byte(58);
        if (m < 10) line_byte(48)
    }
    line_int(m);
    line_byte(58);
    if (s % 60 < 10) line_byte(48);
    line_int(s % 60)
}

line_hours(secs: int) {
    s: int = maxi(secs, 0);
    h: int = s / 3600;
    m: int = s / 60 % 60;
    if (h > 0) {
        line_int(h);
        line_add("h ");
        if (m < 10) line_byte(48);
        line_int(m);
        line_add("m");
        return
    }
    line_int(m);
    line_add("m")
}

// A dash, for a number not known (yet).
line_none() {
    line_byte(226);
    line_byte(128);
    line_byte(147)
}

// Whether speeds for the sport are said as a pace (time a unit: runs and
// walks) rather than as a speed (rides).
by_pace(sport: int): bool {
    sport != S_RIDE
}

// A speed (meters a second) as the sport says it: 8:12 (a pace) or 17.3
// (a speed); a dash when too slow to say.
line_speed(sport: int, v: f32) {
    if (by_pace(sport)) {
        if (v < 0.3) {
            line_none();
            return
        }
        secs: int = (unit_m() / v + 0.5) as int;
        if (secs >= 6000) {
            line_none();
            return
        }
        line_time(secs);
        return
    }
    line_fixed(v * 3600.0 / unit_m(), 1)
}

// What it is said in: /mi, mph, /km, km/h.
speed_unit(sport: int): str {
    if (by_pace(sport)) {
        if (miles) return "/mi";
        return "/km"
    }
    if (miles) return "mph";
    "km/h"
}

speed_title(sport: int): str {
    if (by_pace(sport)) return "Pace";
    "Speed"
}

// A name for an activity starting at that minute of the day: Morning run.
line_auto_name(sport: int, minute: int) {
    h: int = minute / 60;
    part: str = "Night";
    if (h >= 4 && h < 12) part = "Morning";
    if (h >= 12 && h < 14) part = "Lunch";
    if (h >= 14 && h < 18) part = "Afternoon";
    if (h >= 18 && h < 22) part = "Evening";
    line_add(part);
    line_byte(32);
    line_add(sport_word[sport])
}

// ---- days ----
// Day d's year, month (1 to 12) and day of the month; and of the week (0
// Monday). (From Howard Hinnant's civil_from_days.)
cal_year: int = 1970;

cal_month: int = 1;

cal_day: int = 1;

calendar(d: int) {
    z: int = d + 719468;
    era: int = z / 146097;
    if (z < 0) era = (z - 146096) / 146097;
    doe: int = z - era * 146097;
    yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    y: int = yoe + era * 400;
    doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100);
    mp: int = (5 * doy + 2) / 153;
    cal_day = doy - (153 * mp + 2) / 5 + 1;
    if (mp < 10) cal_month = mp + 3 else cal_month = mp - 9;
    if (cal_month <= 2) y = y + 1;
    cal_year = y
}

// The day (from 1970) of a year, month and day of the month.
day_from(y: int, m: int, d: int): int {
    y2: int = y;
    if (m <= 2) y2 = y - 1;
    era: int = y2 / 400;
    if (y2 < 0) era = (y2 - 399) / 400;
    yoe: int = y2 - era * 400;
    mp: int = m + 9;
    if (m > 2) mp = m - 3;
    doy: int = (153 * mp + 2) / 5 + d - 1;
    doe: int = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

weekday(d: int): int {
    // (1 January 1970 was a Thursday.)
    ((d % 7 + 7) % 7 + 3) % 7
}

// The Monday of day d's week.
week_of(d: int): int {
    d - weekday(d)
}

weekday_title: []str = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday",
    "Sunday"];

weekday_short: []str = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

month_title: []str = ["January", "February", "March", "April", "May", "June", "July",
    "August", "September", "October", "November", "December"];

month_short: []str = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep",
    "Oct", "Nov", "Dec"];

// "Oct 14".
line_day_short(d: int) {
    calendar(d);
    line_add(month_short[cal_month - 1]);
    line_byte(32);
    line_int(cal_day)
}

// "Tuesday, October 14", with the year if it is not this one's.
line_day_long(d: int, this_year: int) {
    calendar(d);
    line_add(weekday_title[weekday(d)]);
    line_add(", ");
    line_add(month_title[cal_month - 1]);
    line_byte(32);
    line_int(cal_day);
    if (cal_year != this_year) {
        line_add(", ");
        line_int(cal_year)
    }
}

// A time of day, as a 12-hour clock says it: 7:05 AM.
line_clock(minute: int) {
    h: int = minute / 60 % 24;
    m: int = minute % 60;
    h12: int = h % 12;
    if (h12 == 0) h12 = 12;
    line_int(h12);
    line_byte(58);
    if (m < 10) line_byte(48);
    line_int(m);
    if (h < 12) line_add(" AM") else line_add(" PM")
}

// ---- adding up ----
// What the activities of a sport (-1 any) in days from d0 up to d1 come
// to: how many, how far (meters), and how long moving (seconds).
sum_n: int = 0;

sum_m: f32 = 0.0;

sum_secs: int = 0;

// (And the longest.)
sum_longest: f32 = 0.0;

add_up(sport: int, d0: int, d1: int) {
    sum_n = 0;
    sum_m = 0.0;
    sum_secs = 0;
    sum_longest = 0.0;
    for a in 0..act_n {
        if (!act_gone[a] && (sport < 0 || act_sport[a] == sport)) {
            d: int = act_day(a);
            if (d >= d0 && d < d1) {
                sum_n = sum_n + 1;
                sum_m = sum_m + act_meters(a);
                sum_secs = sum_secs + act_moving[a];
                sum_longest = maxf(sum_longest, act_meters(a))
            }
        }
    }
}

// The fastest of a sport's stretches b (seconds; 0 if none), and which
// activity it was.
record_act: int = -1;

record_of(sport: int, b: int): int {
    best: int = 0;
    record_act = -1;
    for a in 0..act_n {
        if (!act_gone[a] && act_sport[a] == sport) {
            s: int = act_best[a * BESTS + b];
            if (s > 0 && (best == 0 || s < best)) {
                best = s;
                record_act = a
            }
        }
    }
    best
}

// Whether activity a holds its sport's record for stretch b (or holds it
// with another, as the earlier of them).
holds_record(a: int, b: int): bool {
    s: int = act_best[a * BESTS + b];
    if (s <= 0) return false;
    record_of(act_sport[a], b) == s && record_act == a
}

// The activities, newest first (as they are shown).
order: []int = static_buffer(ACTS, 0);

order_n: int = 0;

sort_log() {
    order_n = 0;
    for a in 0..act_n {
        if (!act_gone[a]) {
            // (Into its place: they mostly come in order already.)
            k: int = order_n;
            while (k > 0 && act_start[order[k - 1]] < act_start[a]) {
                order[k] = order[k - 1];
                k = k - 1
            }
            order[k] = a;
            order_n = order_n + 1
        }
    }
}

// ---- reading the log ----
// (The file is read into lg_t, and read from there.)
lg_t: []i8 = static_buffer([4194304]i8);

lg_to: int = 0;

lg_i: int = 0;

skip_spaces() {
    while (lg_i < lg_to && (lg_t[lg_i] as int == 32 || lg_t[lg_i] as int == 9)) lg_i = lg_i + 1
}

at_line_end(): bool {
    skip_spaces();
    lg_i >= lg_to || lg_t[lg_i] as int == 10 || lg_t[lg_i] as int == 13
}

// The word at the reader, as its start and end.
word_from: int = 0;

word_to: int = 0;

read_word() {
    skip_spaces();
    word_from = lg_i;
    while (lg_i < lg_to && lg_t[lg_i] as int > 32) lg_i = lg_i + 1;
    word_to = lg_i
}

word_is(w: str): bool {
    if (word_to - word_from != len(w)) return false;
    for i in 0..len(w) {
        if (lg_t[word_from + i] != w[i]) return false
    }
    true
}

read_int(): int {
    read_word();
    v: int = 0;
    neg: bool = false;
    for i in word_from..word_to {
        c: int = lg_t[i] as int;
        if (c == 45) neg = true else if (c >= 48 && c <= 57) v = v * 10 + c - 48
    }
    if (neg) return -v;
    v
}

next_line() {
    while (lg_i < lg_to && lg_t[lg_i] as int != 10) lg_i = lg_i + 1;
    if (lg_i < lg_to) lg_i = lg_i + 1
}

clear_log() {
    act_n = 0;
    sp_n = 0;
    el_n = 0;
    splits_n = 0;
    gone_n = 0;
    units_said = false
}

// The log, from its file's n bytes in lg_t.
read_log(n: int) {
    clear_log();
    lg_to = n;
    lg_i = 0;
    a: int = -1;
    while (lg_i < lg_to) {
        read_word();
        if (word_is("units")) {
            read_word();
            miles = !word_is("km");
            units_said = true
        }
        if (word_is("act")) {
            start: int = read_int();
            tz: int = read_int();
            read_word();
            sport: int = S_RUN;
            for s in 0..SPORTS {
                if (word_is(sport_key[s])) sport = s
            }
            a = new_act(start, tz, sport);
            if (a >= 0) {
                act_elapsed[a] = read_int();
                act_moving[a] = read_int();
                act_dist[a] = read_int();
                act_max[a] = read_int();
                skip_spaces();
                e: int = lg_i;
                while (e < lg_to && lg_t[e] as int != 10 && lg_t[e] as int != 13) e = e + 1;
                while (e > lg_i && lg_t[e - 1] as int == 32) e = e - 1;
                act_name[a] = name_of(lg_t, lg_i, e);
                lg_i = e
            }
        }
        if (a >= 0 && word_is("sp")) {
            act_step[a] = maxi(read_int(), 1);
            act_sp0[a] = sp_n;
            act_spn[a] = 0;
            while (!at_line_end()) add_sample(a, read_int())
        }
        if (a >= 0 && word_is("up")) {
            act_gain[a] = read_int();
            act_loss[a] = read_int()
        }
        if (a >= 0 && word_is("el")) {
            act_el0[a] = el_n;
            act_eln[a] = 0;
            while (!at_line_end()) add_height(a, read_int())
        }
        if (a >= 0 && word_is("km")) {
            act_km0[a] = splits_n;
            act_kmn[a] = 0;
            while (!at_line_end()) add_split(a, true, read_int())
        }
        if (a >= 0 && word_is("mi")) {
            act_mi0[a] = splits_n;
            act_min[a] = 0;
            while (!at_line_end()) add_split(a, false, read_int())
        }
        if (a >= 0 && word_is("best")) {
            b: int = 0;
            while (!at_line_end()) {
                v: int = read_int();
                if (b < BESTS) act_best[a * BESTS + b] = v;
                b = b + 1
            }
        }
        if (word_is("gone")) {
            s2: int = read_int();
            if (gone_n < GONE) {
                gone_start[gone_n] = s2;
                gone_n = gone_n + 1
            }
        }
        next_line()
    }
    // (What is gone stays gone, whichever copy it came from.)
    for k in 0..act_n {
        if (is_gone(act_start[k])) act_gone[k] = true
    }
    sort_log()
}

// ---- writing the log ----
// The file, put together in lt.
lt: []i8 = static_buffer([4194304]i8);

lt_n: int = 0;

lt_line() {
    for i in 0..line_n {
        if (lt_n < len(lt)) {
            lt[lt_n] = line[i];
            lt_n = lt_n + 1
        }
    }
    if (lt_n < len(lt)) {
        lt[lt_n] = 10i8;
        lt_n = lt_n + 1
    }
}

write_log() {
    lt_n = 0;
    line_clear();
    line_add("units ");
    line_add(unit_word());
    lt_line();
    for a in 0..act_n {
        if (!act_gone[a]) write_act(a)
    }
    for g in 0..gone_n {
        line_clear();
        line_add("gone ");
        line_int(gone_start[g]);
        lt_line()
    }
}

write_act(a: int) {
    line_clear();
    line_add("act ");
    line_int(act_start[a]);
    line_byte(32);
    line_int(act_tz[a]);
    line_byte(32);
    line_add(sport_key[act_sport[a]]);
    line_byte(32);
    line_int(act_elapsed[a]);
    line_byte(32);
    line_int(act_moving[a]);
    line_byte(32);
    line_int(act_dist[a]);
    line_byte(32);
    line_int(act_max[a]);
    line_byte(32);
    line_name(act_name[a]);
    lt_line();
    line_clear();
    line_add("sp ");
    line_int(act_step[a]);
    for i in 0..act_spn[a] {
        line_byte(32);
        line_int(sp[act_sp0[a] + i]);
        // (A long line goes out in pieces; it is read back the same.)
        if (line_n > 4000) {
            for k in 0..line_n {
                if (lt_n < len(lt)) {
                    lt[lt_n] = line[k];
                    lt_n = lt_n + 1
                }
            }
            line_clear()
        }
    }
    lt_line();
    if (act_gain[a] > 0 || act_loss[a] > 0 || act_eln[a] > 0) {
        line_clear();
        line_add("up ");
        line_int(act_gain[a]);
        line_byte(32);
        line_int(act_loss[a]);
        lt_line()
    }
    if (act_eln[a] > 0) {
        line_clear();
        line_add("el");
        for i in 0..act_eln[a] {
            line_byte(32);
            line_int(el[act_el0[a] + i]);
            if (line_n > 4000) {
                for k in 0..line_n {
                    if (lt_n < len(lt)) {
                        lt[lt_n] = line[k];
                        lt_n = lt_n + 1
                    }
                }
                line_clear()
            }
        }
        lt_line()
    }
    for u in 0..2 {
        km: bool = u == 0;
        line_clear();
        if (km) line_add("km") else line_add("mi");
        for i in 0..split_n(a, km) {
            line_byte(32);
            line_int(split_at(a, km, i))
        }
        lt_line()
    }
    line_clear();
    line_add("best");
    for b in 0..BESTS {
        line_byte(32);
        line_int(act_best[a * BESTS + b])
    }
    lt_line()
}
