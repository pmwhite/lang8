tag better;

use_tag std, gl, x11, skate;

// Better: runs, rides and walks, recorded and kept as a log, drawn the way
// the games here are (the picture is the interface). While recording, the
// phone's location measures how far and how fast; only those are kept,
// never where. See README.md.
//
//   .build/better [LOG [LIVE]]
//
// LOG (the activities) is .build/better-log.txt if none; LIVE (a recording
// under way) .build/better-live.txt. L8_SIM=K records a made-up course K
// times as fast as the clock, to try it without going out.
import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../skate/math.l8";

import "../skate/font.l8";

import "paint.l8";

import "text.l8";

import "log.l8";

import "record.l8";

import "pace.l8";

import "ui.l8";

import "touch.l8";

import "app.l8";

import "pages.l8";

import "frame.l8";

extern getenv(name: str): ?*i8;

// (Lines from the page; see read_inbox.)
inbox_path: str = "/inbox.txt";

say(t: str) raises IoError {
    print(t)
}

// The page is told, a line each (see web/better/better.js).
platform_gps(on: bool) raises IoError {
    if (on) say("L8GPS 1") else say("L8GPS 0")
}

platform_gps_retry() raises IoError {
    say("L8GPSRETRY")
}

platform_wake(on: bool) raises IoError {
    if (on) say("L8WAKE 1") else say("L8WAKE 0")
}

platform_theme(pick: int, dark: bool) raises IoError {
    line_clear();
    line_add("L8THEME ");
    line_int(pick);
    if (dark) line_add(" dark") else line_add(" light");
    write_bytes_n(1, line, line_n);
    print("")
}

platform_blur() raises IoError {
    say("L8BLUR")
}

platform_cue(k: int) raises IoError {
    line_clear();
    line_add("L8CUE ");
    line_int(k);
    write_bytes_n(1, line, line_n);
    print("")
}

// (The page keeps them, and gives them back as L8_GOALS.)
platform_goals() raises IoError {
    line_clear();
    line_add("L8GOALS ");
    line_goals();
    write_bytes_n(1, line, line_n);
    print("")
}

main(argc: int, argv: []str@immortal) raises IoError: int {
    if (argc > 1) log_path = argv[1];
    if (argc > 2) live_path = argv[2];
    on_page = getenv("L8_PAGE") != null;
    touch_ui = getenv("L8_TOUCH") != null;
    // (Light or dark, as picked on this device, and whether the phone is
    // dark: the page says.)
    theme_pick = clampi(env_int("L8_THEME", 0), 0, 2);
    phone_dark = env_int("L8_DARK", 0) == 1;
    // (The goals, as the page keeps them: see line_goals.)
    for s in 0..SPORTS goal_set(s, env_int(goal_env[s], 0));
    cues_on = env_int("L8_CUES", 1) == 1;
    told_goals = goals_sum();
    if (!on_page) clock_set(clock_ns(0) / 1000000, env_int("L8_TZ", 0));
    better_open();
    if (!units_said && getenv("L8_KM") != null) miles = false;
    if (on_page) {
        n0: int = read_file(inbox_path);
        if (n0 > 0) read_inbox(n0)
    }
    // (A tab to start on, for a look at it.)
    tab = clampi(env_int("L8_TAB", 0), 0, 2);
    tab_x = tab as f32;
    sk: int = env_int("L8_SIM", 0);
    if (sk > 0) {
        sim_on = true;
        sim_k = sk as f32;
        clock_set(clock_ms(), clock_tz)
    }
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) app_die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    scr_w = env_int("L8_W", 430);
    scr_h = env_int("L8_H", 860);
    p_ui = env_int("L8_UI", 100) as f32 / 100.0;
    win: int = XCreateWindow(dpy, root, 0, 0, scr_w, scr_h, 0, vis.depth as int, 1,
        vis.visual, 10248, &wa);
    if (win == 0) app_die("XCreateWindow failed");
    XStoreName(dpy, win, "Better");
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) app_die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) app_die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    painter: *Painter = new_painter();
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = clock_ns(1);
    start_ns: int = prev_ns;
    // Frames drawn with nothing changing: after a few, the picture is left
    // as it is until something does.
    still: int = 0;
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            still = 0;
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65307) {
                        if (!esc_key() && !on_page) running = false
                    } else key_press(ks)
                }
                ButtonPress b -> {
                    bn: int = b.button as int;
                    x: f32 = b.x as f32 / p_ui;
                    y: f32 = b.y as f32 / p_ui;
                    if (bn == 4 || bn == 5) {
                        amount: f32 = maxf(b.state as f32, 40.0);
                        if (bn == 4) wheel(-amount) else wheel(amount)
                    } else finger_down(bn, x, y)
                }
                ButtonRelease b -> finger_up(b.button as int, b.x as f32 / p_ui, b.y as f32 / p_ui);
                MotionNotify mo -> finger_move(mo.state as int, mo.x as f32 / p_ui,
                    mo.y as f32 / p_ui);
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        scr_w = c.width as int;
                        scr_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        // (What the page has written for Better: read, and emptied.)
        if (inbox_wanted) {
            inbox_wanted = false;
            n: int = read_file(inbox_path);
            if (n > 0) {
                read_inbox(n);
                lt_n = 0;
                write_file(inbox_path)
            }
            still = 0
        }
        now: int = clock_ns(1);
        dt: f32 = clampf((now - prev_ns) as f32 / 1000000000.0, 0.0, 0.05);
        prev_ns = now;
        better_step(dt, (now - start_ns) as f32 / 1000000000.0);
        if (busy || g_finger >= 0) still = 0;
        if (still < 3 || !on_page) {
            if (better_draw(painter, scr_w, scr_h)) still = 0 else still = still + 1
        }
        tell_field();
        better_after();
        glXSwapBuffers(dpy, win)
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}

extern l8_environment(): []str@new;

goal_env: []str = ["L8_GOAL_RUN", "L8_GOAL_RIDE", "L8_GOAL_WALK"];

// A whole number from the environment (as L8_W=390), or the fallback.
env_int(key: str, fallback: int): int {
    if (getenv(key) == null) return fallback;
    for e in l8_environment() {
        if (len(e) > len(key) + 1 && e[len(key)] == '=') {
            same: bool = true;
            for i in 0..len(key) {
                if (e[i] != key[i]) same = false
            }
            if (same) {
                v: int = 0;
                neg: bool = false;
                for i in len(key) + 1..len(e) {
                    c: int = e[i] as int;
                    if (c == 45) neg = true else if (c >= 48 && c <= 57) v = v * 10 + c - 48
                }
                if (neg) return -v;
                return v
            }
        }
    }
    fallback
}
