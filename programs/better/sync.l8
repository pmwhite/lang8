tag better;

use_tag std, skate;

// Keeping the log with a personal link, where Better does it itself (on an
// iPhone; in a web page, web/better/better.js does): the worker's log
// (web/better-log/worker.js) is fetched and put together with this device's,
// and what changes here is saved back, as the page does. The platform only
// makes a request (platform_http) and says how it went (sync_answer).
//
// Two logs are put together activity by activity: each kept once (this
// device's copy if both have it), less those deleted in either.

// ---- putting two logs together ----
// A log's lines as blocks: an activity's (its act line and those after
// it), a gone line, or the units line; by the activity's start.
const BLOCKS: int = 6000;

mb_text: []int = new int[BLOCKS](0);

mb_kind: []int = new int[BLOCKS](0);

mb_key: []int = new int[BLOCKS](0);

mb_from: []int = new int[BLOCKS](0);

mb_to: []int = new int[BLOCKS](0);

mb_n: int = 0;

const MB_ACT: int = 1;

const MB_GONE: int = 2;

const MB_UNITS: int = 3;

// The two texts: this device's (0) and the worker's (1).
merge_here: []i8 = new i8[4194304](0i8);

merge_here_n: int = 0;

merge_there: []i8 = new i8[4194304](0i8);

merge_there_n: int = 0;

merge_text(which: int): []i8 {
    if (which == 0) return merge_here;
    merge_there
}

merge_len(which: int): int {
    if (which == 0) return merge_here_n;
    merge_there_n
}

// The whole number after the line's first word (an act's or a gone's start).
merge_key(t: []i8, at: int, to: int): int {
    i: int = at;
    while (i < to && t[i] as int != 32) i = i + 1;
    while (i < to && t[i] as int == 32) i = i + 1;
    v: int = 0;
    neg: bool = false;
    if (i < to && t[i] as int == 45) {
        neg = true;
        i = i + 1
    }
    while (i < to && t[i] as int >= 48 && t[i] as int <= 57) {
        v = v * 10 + t[i] as int - 48;
        i = i + 1
    }
    if (neg) return 0 - v;
    v
}

merge_starts(
    t: []i8,
    at: int,
    to: int,
    word: str
): bool {
    if (at + len(word) > to) return false;
    for k in 0..len(word) {
        if (t[at + k] != word[k]) return false
    }
    true
}

// The blocks of one text.
merge_blocks(which: int) {
    t: []i8 = merge_text(which);
    n: int = merge_len(which);
    i: int = 0;
    current: int = -1;
    while (i < n) {
        e: int = i;
        while (e < n && t[e] as int != 10) e = e + 1;
        kind: int = 0;
        if (merge_starts(t, i, e, "act ")) kind = MB_ACT;
        if (merge_starts(t, i, e, "gone ")) kind = MB_GONE;
        if (merge_starts(t, i, e, "units ")) kind = MB_UNITS;
        if (kind != 0 && mb_n < BLOCKS) {
            mb_text[mb_n] = which;
            mb_kind[mb_n] = kind;
            mb_key[mb_n] = merge_key(t, i, e);
            mb_from[mb_n] = i;
            mb_to[mb_n] = e;
            current = (if (kind == MB_ACT) mb_n else -1);
            mb_n = mb_n + 1
        } else if (current >= 0 && e > i) mb_to[current] = e;
        i = e + 1
    }
}

merge_gone(key: int): bool {
    for b in 0..mb_n {
        if (mb_kind[b] == MB_GONE && mb_key[b] == key) return true
    }
    false
}

// Whether this device's text has an activity with that start.
merge_here_has(key: int): bool {
    for b in 0..mb_n {
        if (mb_text[b] == 0 && mb_kind[b] == MB_ACT && mb_key[b] == key) return true
    }
    false
}

merge_put(b: int) {
    t: []i8 = merge_text(mb_text[b]);
    for i in mb_from[b]..mb_to[b] {
        if (lt_n < len(lt)) {
            lt[lt_n] = t[i];
            lt_n = lt_n + 1
        }
    }
    if (lt_n < len(lt)) {
        lt[lt_n] = 10i8;
        lt_n = lt_n + 1
    }
}

// The two texts (merge_here, merge_there) as one, in lt.
merge_logs() {
    mb_n = 0;
    merge_blocks(0);
    merge_blocks(1);
    lt_n = 0;
    // The units: this device's, or the worker's, or miles.
    units: int = -1;
    for b in 0..mb_n {
        if (mb_kind[b] == MB_UNITS && (units < 0 || mb_text[units] == 1 && mb_text[b] == 0)) units = b
    }
    if (units >= 0) merge_put(units) else {
        line_clear();
        line_add("units mi");
        lt_line()
    }
    // The activities, by when they started.
    chosen: []int = merge_chosen;
    nc: int = 0;
    for b2 in 0..mb_n {
        if (mb_kind[b2] == MB_ACT && !merge_gone(mb_key[b2]) && (mb_text[b2] == 0 || !merge_here_has(mb_key[b2])) && nc < len(chosen)) {
            k: int = nc;
            while (k > 0 && mb_key[chosen[k - 1]] > mb_key[b2]) {
                chosen[k] = chosen[k - 1];
                k = k - 1
            }
            chosen[k] = b2;
            nc = nc + 1
        }
    }
    for c in 0..nc merge_put(chosen[c]);
    // The deleted, each once.
    for b3 in 0..mb_n {
        if (mb_kind[b3] == MB_GONE) {
            first: bool = true;
            for b4 in 0..b3 {
                if (mb_kind[b4] == MB_GONE && mb_key[b4] == mb_key[b3]) first = false
            }
            if (first) merge_put(b3)
        }
    }
}

merge_chosen: []int = new int[BLOCKS](0);

// ---- JSON, as much as the worker's answers need ----
// The string after "key": in body, decoded, into out: its length (-1 if
// there is none).
json_string(
    body: []i8,
    n: int,
    key: str,
    out: []i8
): int {
    at: int = json_find(body, n, key);
    if (at < 0) return -1;
    i: int = at;
    while (i < n && body[i] as int == 32) i = i + 1;
    if (i >= n || body[i] as int != 34) return -1;
    i = i + 1;
    o: int = 0;
    while (i < n && body[i] as int != 34) {
        c: int = body[i] as int & 255;
        if (c == 92 && i + 1 < n) {
            i = i + 1;
            e: int = body[i] as int;
            if (e == 110) c = 10 else if (e == 116) c = 9 else if (e == 114) c = 13 else if (e == 98) c = 8 else if (e == 102) c = 12 else if (e == 117 && i + 4 < n) {
                // \uXXXX: as UTF-8 (a surrogate pair as one character).
                u: int = json_hex4(body, i + 1);
                i = i + 4;
                if (u >= 55296 && u < 56320 && i + 6 < n && body[i + 1] as int == 92 && body[i + 2] as int == 117) {
                    low: int = json_hex4(body, i + 3);
                    u = 65536 + (u - 55296) * 1024 + (low - 56320);
                    i = i + 6
                }
                o = json_utf8(out, o, u);
                c = -1
            } else c = e
        }
        if (c >= 0 && o < len(out)) {
            out[o] = c trunc i8;
            o = o + 1
        }
        i = i + 1
    }
    o
}

// The whole number after "key": in body (fallback if there is none).
json_int(
    body: []i8,
    n: int,
    key: str,
    fallback: int
): int {
    at: int = json_find(body, n, key);
    if (at < 0) return fallback;
    i: int = at;
    while (i < n && body[i] as int == 32) i = i + 1;
    v: int = 0;
    neg: bool = false;
    if (i < n && body[i] as int == 45) {
        neg = true;
        i = i + 1
    }
    if (i >= n || body[i] as int < 48 || body[i] as int > 57) return fallback;
    while (i < n && body[i] as int >= 48 && body[i] as int <= 57) {
        v = v * 10 + body[i] as int - 48;
        i = i + 1
    }
    if (neg) return 0 - v;
    v
}

// Where the value of "key" begins (after its colon), or -1.
json_find(body: []i8, n: int, key: str): int {
    for i in 0..n - len(key) - 2 {
        if (body[i] as int == 34 && body[i + len(key) + 1] as int == 34) {
            same: bool = true;
            for k in 0..len(key) {
                if (body[i + 1 + k] != key[k]) same = false
            }
            if (same) {
                j: int = i + len(key) + 2;
                while (j < n && body[j] as int == 32) j = j + 1;
                if (j < n && body[j] as int == 58) return j + 1
            }
        }
    }
    -1
}

json_hex4(t: []i8, at: int): int {
    v: int = 0;
    for k in 0..4 {
        c: int = t[at + k] as int;
        d: int = 0;
        if (c >= 48 && c <= 57) d = c - 48 else if (c >= 97 && c <= 102) d = c - 87 else if (c >= 65 && c <= 70) d = c - 55;
        v = v * 16 + d
    }
    v
}

json_utf8(out: []i8, at: int, u: int): int {
    o: int = at;
    if (u < 128) return json_byte(out, o, u);
    if (u < 2048) {
        o = json_byte(out, o, 192 + (u >> 6));
        return json_byte(out, o, 128 + (u & 63))
    }
    if (u < 65536) {
        o = json_byte(out, o, 224 + (u >> 12));
        o = json_byte(out, o, 128 + (u >> 6 & 63));
        return json_byte(out, o, 128 + (u & 63))
    }
    o = json_byte(out, o, 240 + (u >> 18));
    o = json_byte(out, o, 128 + (u >> 12 & 63));
    o = json_byte(out, o, 128 + (u >> 6 & 63));
    json_byte(out, o, 128 + (u & 63))
}

json_byte(out: []i8, at: int, c: int): int {
    if (at >= len(out)) return at;
    out[at] = c trunc i8;
    at + 1
}

// {"text": TEXT, "base": BASE} for a save, in sync_body.
sync_body: []i8 = new i8[8388608](0i8);

sync_body_n: int = 0;

sync_put(c: int) {
    sync_body_n = json_byte(sync_body, sync_body_n, c)
}

sync_put_str(s: str) {
    for c in s sync_put(c as int)
}

sync_save_body(text: []i8, n: int, base: int) {
    sync_body_n = 0;
    sync_put_str("{\"text\":\"");
    for i in 0..n {
        c: int = text[i] as int & 255;
        if (c == 34) sync_put_str("\\\"") else if (c == 92) sync_put_str("\\\\") else if (c == 10) sync_put_str("\\n") else if (c == 9) sync_put_str("\\t") else if (c < 32) {
            sync_put_str("\\u00");
            sync_put(48 + c / 16);
            d: int = c % 16;
            if (d < 10) sync_put(48 + d) else sync_put(87 + d)
        } else sync_put(c)
    }
    sync_put_str("\",\"base\":");
    line_clear();
    line_int(base);
    for k in 0..line_n sync_put(line[k] as int);
    sync_put(125)
}

// ---- the worker ----
// The link's secret (none: the log is kept on this device only), the
// worker's revision the log here was last the same as, and whether it has
// changed here since.
sync_secret: []i8 = new i8[64](0i8);

sync_secret_n: int = 0;

sync_rev: int = 0;

sync_dirty: bool = false;

// A request on its way (one at a time): its kind, and when to push next.
const SY_NONE: int = 0;

const SY_PULL: int = 1;

const SY_PUSH: int = 2;

sync_busy: int = 0;

sync_push_at: f32 = -1.0;

// What has been pushed: the text, as it was sent (to know whether it has
// changed since).
sync_sent_n: int = 0;

// Saves to the settings (sync_settings_changed is set when they change).
sync_settings_changed: bool = false;

sync_linked(): bool {
    sync_secret_n >= 16
}

// The link, from a URL or as written: the secret after "me=".
sync_link_from(t: []i8, n: int): bool {
    for i in 0..n - 3 {
        if (t[i] as int == 109 && t[i + 1] as int == 101 && t[i + 2] as int == 61) {
            k: int = 0;
            j: int = i + 3;
            while (j < n && k < len(sync_secret) && (t[j] as int >= 97 && t[j] as int <= 122 || t[j] as int >= 48 && t[j] as int <= 57)) {
                sync_secret[k] = t[j];
                k = k + 1;
                j = j + 1
            }
            if (k < 16) return false;
            sync_secret_n = k;
            sync_rev = 0;
            // (What is here goes with the worker's, as a new device's.)
            sync_dirty = true;
            sync_settings_changed = true;
            return true
        }
    }
    false
}

// The worker's log, asked for (on starting, and when looked at again).
sync_pull() {
    if (!sync_native || !sync_linked() || sync_busy != SY_NONE) return;
    if (sync_dirty) {
        sync_push();
        return
    }
    sync_busy = SY_PULL;
    sync_body_n = 0;
    platform_http("GET", "/log", sync_body, 0)
}

// This device's log, sent.
sync_push() {
    if (!sync_native || !sync_linked() || sync_busy != SY_NONE) return;
    n: int = read_file(log_path);
    if (n < 0) n = 0;
    sync_sent_n = n;
    sync_save_body(lg_t, n, sync_rev);
    sync_busy = SY_PUSH;
    sync_state = 2;
    platform_http("POST", "/log", sync_body, sync_body_n)
}

// Better saved its log: sent soon (a second or so after the last change).
sync_saved() {
    if (!sync_native || !sync_linked()) return;
    sync_dirty = true;
    sync_settings_changed = true;
    sync_push_at = now_t + 1.2;
    sync_state = 2
}

// Each frame: a push when it is due.
sync_step() {
    if (sync_push_at >= 0.0 && now_t >= sync_push_at && sync_busy == SY_NONE) {
        sync_push_at = -1.0;
        sync_push()
    }
}

// How a request went: its HTTP status (0: no answer) and the answer's n
// bytes in body.
sync_answer(status: int, body: []i8, n: int) {
    kind: int = sync_busy;
    sync_busy = SY_NONE;
    if (status == 401) {
        sync_state = 4;
        return
    }
    if (status == 0 || status >= 500) {
        sync_state = 3;
        // (Again in a while.)
        if (kind == SY_PUSH || sync_dirty) sync_push_at = now_t + 15.0;
        return
    }
    if (kind == SY_PULL && status == 200) {
        rev: int = json_int(body, n, "rev", sync_rev);
        merge_there_n = maxi(json_string(body, n, "text", merge_there), 0);
        if (rev != sync_rev && sync_dirty) {
            // (Changed here while it was on its way: the two put together,
            // and that sent.)
            sync_rev = rev;
            sync_join();
            sync_settings_changed = true;
            sync_push_at = now_t;
            sync_state = 2;
            return
        }
        if (rev != sync_rev) sync_take(rev);
        sync_state = 1;
        return
    }
    if (kind == SY_PUSH && status == 409) {
        // Saved from elsewhere since: the two put together, and that sent.
        sync_rev = json_int(body, n, "rev", sync_rev);
        merge_there_n = maxi(json_string(body, n, "text", merge_there), 0);
        sync_join();
        sync_settings_changed = true;
        sync_push();
        return
    }
    if (kind == SY_PUSH && status == 200) {
        sync_rev = json_int(body, n, "rev", sync_rev);
        // (Changed again while it was on its way: that goes next.)
        now: int = read_file(log_path);
        if (now == sync_sent_n && sync_push_at < 0.0) sync_dirty = false else sync_push_at = now_t + 1.2;
        sync_settings_changed = true;
        sync_state = 1;
        return
    }
    sync_state = 3
}

// The worker's log (in merge_there), as this device's.
sync_take(rev: int) {
    for i in 0..merge_there_n lt[i] = merge_there[i];
    lt_n = merge_there_n;
    write_file_quiet(log_path);
    sync_rev = rev;
    sync_settings_changed = true;
    reload_wanted = true
}

// This device's log and the worker's (merge_there) as one, here.
sync_join() {
    n: int = read_file(log_path);
    if (n < 0) n = 0;
    for i in 0..n merge_here[i] = lg_t[i];
    merge_here_n = n;
    merge_logs();
    write_file_quiet(log_path);
    reload_wanted = true
}

write_file_quiet(path: str) {
    try {
        write_file(path)
    } with IoError _e -> { }
}
