test "a friends feed read" {
    n: int = put_text(lg_t, """
friend sam00001 1790000000000 Sam Ortiz
act 1792200000 -240 run 1500 1490 50000 400 Morning run
up 120 110
act 1792000000 60 ride 3600 3500 300000 900 Long ride, hills
friend ana00002 1791000000000 Ana
friend jo000003 1791500000000 Jo
act 1792300000 0 walk 900 880 3000 150 Walk
""");
    feed_read(n);
    line_clear();
    line_int(fr_n);
    line_add(" friends, ");
    line_int(fd_n);
    line_add(" activities");
    print_line();
    for f in 0..fr_n {
        line_clear();
        line_friend(f);
        line_add(" (");
        line_friend_first(f);
        line_add(") since ");
        line_int(fr_since[f]);
        print_line()
    }
    for k in 0..fd_n {
        a: int = fd_order[k];
        line_clear();
        line_friend_first(fd_friend[a]);
        line_add(": ");
        line_feed_name(a);
        line_add(", ");
        line_add(sport_key[fd_sport[a]]);
        line_byte(32);
        line_int(fd_start[a]);
        line_byte(32);
        line_int(fd_tz[a]);
        line_add(", moving ");
        line_int(fd_moving[a]);
        line_add(", ");
        line_int(fd_dist[a]);
        line_add(" dm, up ");
        line_int(fd_gain[a]);
        print_line()
    }
    expect {|
        3 friends, 3 activities
        Sam Ortiz (Sam) since 1790000000000
        Ana (Ana) since 1791000000000
        Jo (Jo) since 1791500000000
        Jo: Walk, walk 1792300000 0, moving 880, 3000 dm, up 0
        Sam: Morning run, run 1792200000 -240, moving 1490, 50000 dm, up 120
        Sam: Long ride, hills, ride 1792000000 60, moving 3500, 300000 dm, up 0
    |}
}

