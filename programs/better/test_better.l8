say_signed() raises IoError {
    line_clear();
    if (sync_linked()) line_add("signed in") else line_add("signed out");
    line_add(", ");
    line_int(order_n);
    line_add(" activities, asked ");
    line_int(asked);
    print_line()
}

test "signing out, only once what is here is saved" {
    sync_native = true;
    log_path = "/tmp/better-test-signout.txt";
    n: int = put_text(lg_t, """
units km
act 300 0 run 10 10 5 1 Mine
act 400 0 walk 10 10 5 1 Mine too
""");
    read_log(n);
    put_text(sync_secret, "abcdefghijkmnpqrstuvwxyz");
    sync_secret_n = 24;
    acct_admin = true;
    sync_dirty = true;
    asked = 0;
    // (Not saved yet: the button does nothing.)
    people_act(B_SIGNOUT);
    people_act(B_SIGNOUT);
    people_step();
    say_signed();
    // (Saved: asked twice, then the worker told.)
    sync_dirty = false;
    people_act(B_SIGNOUT);
    people_step();
    say_signed();
    people_act(B_SIGNOUT);
    people_step();
    say_signed();
    sync_answer(200, lg_t, 0);
    say_signed();
    line_clear();
    if (miles) line_add("miles") else line_add("kilometers");
    if (acct_admin) line_add(", admin");
    print_line();
    expect {|
        signed in, 2 activities, asked 0
        signed in, 2 activities, asked 0
        signed in, 2 activities, asked 1
        signed out, 0 activities, asked 1
        kilometers
    |}
}

test "a device with no log yet saves once" {
    sync_native = true;
    demo_on = false;
    log_path = "/tmp/better-test-no-such-log.txt";
    put_text(sync_secret, "abcdefghijkmnpqrstuvwxyz");
    sync_secret_n = 24;
    sync_busy = SY_NONE;
    sync_dirty = true;
    sync_push_at = -1.0;
    asked = 0;
    sync_push();
    sync_answer(200, lg_t, put_text(lg_t, "{\"rev\":1}"));
    sync_step();
    line_clear();
    line_add("asked ");
    line_int(asked);
    if (sync_dirty) line_add(", still to save") else line_add(", saved");
    print_line();
    expect {|
        asked 1, saved
    |}
}
