tag better_tests;

use_tag std, better, skate;

// Better without its window: fixes with a phone's error in them made into
// distance and moving time; splits and fastest stretches; and the log,
// written and read back.
import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../skate/math.l8";

import "../skate/font.l8";

import "paint.l8";

import "text.l8";

import "log.l8";

import "record.l8";

import "ui.l8";

import "touch.l8";

import "app.l8";

import "pages.l8";

import "frame.l8";

import "sync.l8";

import "test_platform.l8";

print_line() raises IoError {
    write_bytes_n(1, line, line_n);
    print("")
}

// A course gone at v (meters a second) for secs seconds, a fix a second
// with a few meters of wandering error; speeds measured too, or not.
// Where it really went is the sum of the steps.
true_m: f32 = 0.0;

walk_t: int = 1000000;

// The course's height, and how much it climbs each second (meters).
walk_z: f32 = 0.0;

climb: f32 = 0.0;

go(secs: int, v: f32, measured: bool) {
    left: int = secs;
    while (left > 0) {
        left = left - 1;
        walk_t = walk_t + 1000;
        sim_head = sim_head + 0.01 * sim_normal();
        nx: f32 = sim_x + v * cosf(sim_head);
        ny: f32 = sim_y + v * sinf(sim_head);
        ex: f32 = sim_ex * 0.9 + 0.8 * sim_normal();
        ey: f32 = sim_ey * 0.9 + 0.8 * sim_normal();
        dx: f32 = nx + ex - (sim_x + sim_ex);
        dy: f32 = ny + ey - (sim_y + sim_ey);
        sim_x = nx;
        sim_y = ny;
        sim_ex = ex;
        sim_ey = ey;
        true_m = true_m + v;
        spd: f32 = -1.0;
        if (measured) spd = maxf(v + 0.15 * sim_normal(), 0.0);
        // (Heights: the course's, with a phone's wandering error.)
        walk_z = walk_z + climb;
        ez: f32 = sim_ez * 0.9 + 0.5 * sim_normal();
        dz: f32 = walk_z + ez - (walk_z - climb + sim_ez);
        sim_ez = ez;
        fix(walk_t, dx, dy, 5.0, spd, dz, 5.0)
    }
}

begin(sport: int) {
    gps_reset();
    rec_begin(sport);
    true_m = 0.0;
    sim_seed = 777;
    // (A first fix, to measure from.)
    go(1, 0.0, true)
}

// How far it made it, against how far it went; and its moving time.
say_went() raises IoError {
    line_clear();
    line_add("went ");
    line_int((true_m + 0.5) as int);
    line_add(" m, measured ");
    line_int((rec_dist + 0.5) as int);
    line_add(" m (");
    e: f32 = 0.0;
    if (true_m > 0.0) e = (rec_dist - true_m) / true_m * 100.0;
    if (e >= 0.0) line_byte(43);
    line_num(e, 1);
    line_add("%), moving ");
    line_time(rec_moving_ms / 1000);
    print_line()
}

test "a run, its speed measured" {
    begin(S_RUN);
    go(1200, 3.2, true);
    say_went();
    expect {|
        went 3840 m, measured 3841 m (+0%), moving 20:00
    |}
}

test "a run, from its positions alone" {
    begin(S_RUN);
    go(1200, 3.2, false);
    say_went();
    expect {|
        went 3840 m, measured 3850 m (+0.3%), moving 20:00
    |}
}

test "standing still goes nowhere" {
    begin(S_RUN);
    go(300, 0.0, true);
    say_went();
    begin(S_RUN);
    go(300, 0.0, false);
    say_went();
    expect {|
        went 0 m, measured 0 m (+0%), moving 0:00
        went 0 m, measured 0 m (+0%), moving 0:00
    |}
}

test "a stop at a light pauses by itself" {
    begin(S_RIDE);
    go(300, 7.0, true);
    go(60, 0.0, true);
    go(300, 7.0, true);
    say_went();
    expect {|
        went 4200 m, measured 4199 m (-0%), moving 10:03
    |}
}

test "a pause stops everything but the clock" {
    begin(S_WALK);
    go(120, 1.4, true);
    rec_pause(true);
    go(120, 1.4, true);
    rec_pause(false);
    go(120, 1.4, true);
    true_m = true_m - 120.0 * 1.4;
    say_went();
    expect {|
        went 336 m, measured 335 m (-0.3%), moving 4:00
    |}
}

// So many seconds of moving at v, each its own step.
seconds_at(secs: int, v: f32) {
    left: int = secs;
    while (left > 0) {
        go_on(1000, v);
        left = left - 1
    }
}

// A recording at a steady speed, made into a log's activity.
steady(sport: int, v: f32, secs: int): int {
    rec_begin(sport);
    seconds_at(secs, v);
    rec_to_log(lg_t, 0, 0)
}

test "splits and fastest stretches" {
    clear_log();
    miles = true;
    // (Ten minutes at 3 m/s, then ten at 4.)
    rec_begin(S_RUN);
    seconds_at(600, 3.0);
    seconds_at(600, 4.0);
    line_clear();
    line_add("Test run");
    a: int = rec_to_log(line, 0, line_n);
    line_clear();
    line_add("km");
    for i in 0..split_n(a, true) {
        line_byte(32);
        line_time(split_at(a, true, i))
    }
    print_line();
    line_clear();
    line_add("mi");
    for i in 0..split_n(a, false) {
        line_byte(32);
        line_time(split_at(a, false, i))
    }
    print_line();
    for b in 0..BESTS {
        line_clear();
        line_add(best_title[b]);
        line_add(": ");
        line_time(act_best[a * BESTS + b]);
        print_line()
    }
    line_clear();
    line_add("steps of ");
    line_int(act_step[a]);
    line_add(" s: ");
    line_int(act_spn[a]);
    line_add(", first ");
    line_int(sp[act_sp0[a]]);
    line_add(" dm, last ");
    line_int(sp[act_sp0[a] + act_spn[a] - 1]);
    line_add(" dm");
    print_line();
    expect {|
        km 5:33 5:17 4:10 4:10
        mi 8:56 6:58
        1 km: 4:10
        1 mile: 6:43
        5 km: 0:00
        10 km: 0:00
        Half marathon: 0:00
        Marathon: 0:00
        steps of 5 s: 240, first 150 dm, last 200 dm
    |}
}

test "a long ride keeps few steps" {
    clear_log();
    a: int = steady(S_RIDE, 8.0, 4 * 3600);
    line_clear();
    line_add("steps of ");
    line_int(act_step[a]);
    line_add(" s: ");
    line_int(act_spn[a]);
    print_line();
    expect {|
        steps of 45 s: 320
    |}
}

test "the log, written and read back" {
    clear_log();
    miles = false;
    a: int = steady(S_RUN, 3.0, 900);
    act_start[a] = 1760000000;
    act_tz[a] = -240;
    b: int = steady(S_RIDE, 7.0, 1800);
    act_start[b] = 1760100000;
    c: int = steady(S_WALK, 1.3, 600);
    act_start[c] = 1760200000;
    remove_act(c);
    write_log();
    first: int = lt_n;
    for i in 0..lt_n lg_t[i] = lt[i];
    read_log(lt_n);
    write_log();
    line_clear();
    line_add("activities ");
    line_int(order_n);
    line_add(", same again: ");
    same: bool = first == lt_n;
    for i in 0..mini(first, lt_n) {
        if (lg_t[i] != lt[i]) same = false
    }
    if (same) line_add("yes") else line_add("no");
    line_add(", units ");
    line_add(unit_word());
    print_line();
    for k in 0..order_n {
        x: int = order[k];
        line_clear();
        line_add(sport_key[act_sport[x]]);
        line_byte(32);
        line_dist(act_meters(x));
        line_add(" km in ");
        line_time(act_moving[x]);
        line_add(", ");
        line_day_short(act_day(x));
        line_add(" at ");
        line_clock(act_minute(x));
        print_line()
    }
    expect {|
        activities 2, same again: yes, units km
        ride 12.6 km in 30:00, Oct 10 at 12:40 PM
        run 2.70 km in 15:00, Oct 9 at 4:53 AM
    |}
}

test "days and weeks" {
    line_clear();
    d: int = day_from(2026, 10, 15);
    line_int(d);
    line_byte(32);
    line_add(weekday_title[weekday(d)]);
    line_add(", week from ");
    line_day_short(week_of(d));
    line_add(", year from ");
    line_int(day_from(2026, 1, 1));
    print_line();
    expect {|
        20741 Thursday, week from Oct 12, year from 20454
    |}
}

// How much it climbed and descended, against what the course did.
say_climb(up: f32, down: f32) raises IoError {
    line_clear();
    line_add("climbed ");
    line_int((up + 0.5) as int);
    line_add(" m, measured ");
    line_num(rec_gain, 1);
    line_add("; descended ");
    line_int((down + 0.5) as int);
    line_add(" m, measured ");
    line_num(rec_loss, 1);
    line_add("; at the end ");
    line_num(fine_z[fine_n - 1] as f32 * 0.1, 1);
    line_add(" m from the start");
    print_line()
}

test "up a hill and down again" {
    begin(S_RUN);
    walk_z = 0.0;
    climb = 0.1;
    go(400, 3.0, true);
    climb = -0.1;
    go(300, 3.0, true);
    climb = 0.0;
    go(100, 3.0, true);
    say_climb(40.0, 30.0);
    expect {|
        climbed 40 m, measured 40.3; descended 30 m, measured 30.7; at the end 10.1 m from the start
    |}
}

test "standing still climbs nothing" {
    begin(S_RIDE);
    climb = 0.0;
    go(600, 0.0, true);
    say_climb(0.0, 0.0);
    expect {|
        climbed 0 m, measured 0; descended 0 m, measured 0; at the end 0 m from the start
    |}
}

test "a ride's heights, in the log" {
    clear_log();
    begin(S_RIDE);
    climb = 0.05;
    go(600, 7.0, true);
    a: int = rec_to_log(lg_t, 0, 0);
    write_log();
    for i in 0..lt_n lg_t[i] = lt[i];
    read_log(lt_n);
    line_clear();
    line_add("climb ");
    line_num(act_gain[a] as f32 * 0.1, 1);
    line_add(" m, ");
    line_int(act_eln[a]);
    line_add(" heights, the last ");
    line_num(el[act_el0[a] + act_eln[a] - 1] as f32 * 0.1, 1);
    line_add(" m up");
    print_line();
    expect {|
        climb 28.2 m, 120 heights, the last 30.3 m up
    |}
}

put_text(out: []i8, s: str): int {
    for i in 0..len(s) out[i] = s[i];
    len(s)
}

print_lt() raises IoError {
    write_bytes_n(1, lt, lt_n)
}

test "two logs put together" {
    merge_here_n = put_text(merge_here, """
units km
act 300 0 run 10 10 5 1 Here
sp 5 1
act 100 0 walk 1 1 1 1 Both, here
gone 200
""");
    merge_there_n = put_text(merge_there, """
units mi
act 100 0 walk 1 1 1 1 Both, there
up 1 1
act 200 0 ride 2 2 2 2 Gone here
act 150 0 ride 3 3 3 3 There
gone 50
""");
    merge_logs();
    print_lt();
    expect {|
        units km
        act 100 0 walk 1 1 1 1 Both, here
        act 150 0 ride 3 3 3 3 There
        act 300 0 run 10 10 5 1 Here
        sp 5 1
        gone 200
        gone 50
    |}
}

test "the worker's answers read" {
    body: []i8 = new i8[200](0i8);
    n: int = put_text(body, "{\"text\": \"units mi\\nact 1 0 run 1 1 1 1 Caf\\u00e9 \\\"5k\\\"\\n\", \"rev\": 42, \"name\":\"P\"}");
    out: []i8 = new i8[100](0i8);
    k: int = json_string(body, n, "text", out);
    write_bytes_n(1, out, k);
    line_clear();
    line_add("rev ");
    line_int(json_int(body, n, "rev", -1));
    line_add(", missing ");
    line_int(json_int(body, n, "base", -1));
    print_line();
    sync_save_body(out, k, 42);
    write_bytes_n(1, sync_body, sync_body_n);
    print("");
    expect {|
        units mi
        act 1 0 run 1 1 1 1 Café "5k"
        rev 42, missing -1
        {"text":"units mi\nact 1 0 run 1 1 1 1 Café \"5k\"\n","base":42}
    |}
}
