tag better;

use_tag std;

// (What the platform is told: nothing, here, but the requests.)
platform_gps(_on: bool) { }

platform_gps_retry() { }

platform_wake(_on: bool) { }

platform_theme(_pick: int, _dark: bool) { }

platform_blur() { }

platform_cue(_k: int) { }

platform_goals() { }

asked: int = 0;

platform_http(
    _method: str,
    _path: str,
    _body: []i8,
    _n: int
) {
    asked = asked + 1
}

platform_account() { }

shared: int = 0;

platform_share() {
    shared = shared + 1
}
