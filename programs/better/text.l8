tag better;

use_tag std, skate;

// Words: the names of activities, each a run of bytes kept in one pool
// and known by its number; a line of text put together for the screen or
// a file; and text broken into lines that fit a width.
const NAMES: int = 4096;

const NAME_BYTES: int = 131072;

name_bytes: []i8 = static_buffer(NAME_BYTES, 0i8);

name_start: []int = static_buffer(NAMES, 0);

name_len: []int = static_buffer(NAMES, 0);

names_n: int = 0;

name_used: int = 0;

// A name from bytes (from `from` up to `to`).
name_of(t: []i8, from: int, to: int): int {
    n: int = to - from;
    if (names_n >= NAMES || name_used + n > NAME_BYTES) return 0;
    name_start[names_n] = name_used;
    name_len[names_n] = n;
    for i in 0..n name_bytes[name_used + i] = t[from + i];
    name_used = name_used + n;
    names_n = names_n + 1;
    names_n - 1
}

// Whether name k is the bytes from `from` up to `to`.
name_is(
    k: int,
    t: []i8,
    from: int,
    to: int
): bool {
    if (name_len[k] != to - from) return false;
    s: int = name_start[k];
    for i in 0..to - from {
        if (name_bytes[s + i] != t[from + i]) return false
    }
    true
}

lower(c: int): int {
    if (c >= 65 && c <= 90) return c + 32;
    c
}

// Whether name k has the bytes from `from` up to `to` in it, big and
// small letters alike.
name_has(
    k: int,
    t: []i8,
    from: int,
    to: int
): bool {
    n: int = to - from;
    if (n == 0) return true;
    s: int = name_start[k];
    for at in 0..name_len[k] - n + 1 {
        same: bool = true;
        i: int = 0;
        while (same && i < n) {
            if (lower(name_bytes[s + at + i] as int) != lower(t[from + i] as int)) same = false;
            i = i + 1
        }
        if (same) return true
    }
    false
}

// ---- a line of text being put together ----
line: []i8 = static_buffer([4096]i8);

line_n: int = 0;

line_clear() {
    line_n = 0
}

line_byte(c: int) {
    if (line_n < len(line)) {
        line[line_n] = c trunc i8;
        line_n = line_n + 1
    }
}

line_add(t: str) {
    for c in t line_byte(c as int)
}

line_name(k: int) {
    s: int = name_start[k];
    for i in 0..name_len[k] line_byte(name_bytes[s + i] as int)
}

// Words, in small letters.
line_add_lower(t: str) {
    for c in t line_byte(lower(c as int))
}

// A dot between two things said in a line.
line_dot() {
    line_add("  ");
    line_byte(194);
    line_byte(183);
    line_add("  ")
}

// "…", where something is still to come.
line_ellipsis() {
    line_byte(226);
    line_byte(128);
    line_byte(166)
}

// Name k, its first letter small (for the middle of a sentence).
line_name_lower(k: int) {
    s: int = name_start[k];
    for i in 0..name_len[k] {
        c: int = name_bytes[s + i] as int;
        if (i == 0 && name_len[k] > 1 && name_bytes[s + 1] as int >= 97) c = lower(c);
        line_byte(c)
    }
}

line_int(v: int) {
    if (v < 0) {
        line_byte(45);
        line_int(-v);
        return
    }
    if (v >= 10) line_int(v / 10);
    line_byte(48 + v % 10)
}

// A whole number with a comma between thousands (1,240).
line_count(v: int) {
    if (v < 0) {
        line_byte(45);
        line_count(-v);
        return
    }
    if (v >= 1000) {
        line_count(v / 1000);
        line_byte(44);
        r: int = v % 1000;
        if (r < 100) line_byte(48);
        if (r < 10) line_byte(48);
        line_int(r);
        return
    }
    line_int(v)
}

// A number with up to `places` decimals, without trailing zeros.
line_num(x: f32, places: int) {
    v: f32 = x;
    if (v < 0.0) {
        line_byte(45);
        v = -v
    }
    scale: int = pow10(places);
    whole: int = (v * scale as f32 + 0.5) as int;
    line_int(whole / scale);
    frac: int = whole % scale;
    if (frac == 0) return;
    line_byte(46);
    digits: int = places;
    while (frac % 10 == 0) {
        frac = frac / 10;
        digits = digits - 1
    }
    d: int = pow10(digits - 1);
    while (d > 0) {
        line_byte(48 + frac / d % 10);
        d = d / 10
    }
}

clampi(v: int, lo: int, hi: int): int {
    if (v < lo) return lo;
    if (v > hi) return hi;
    v
}

pow10(n: int): int {
    v: int = 1;
    k: int = n;
    while (k > 0) {
        v = v * 10;
        k = k - 1
    }
    v
}

// ---- reading numbers ----
// The number at t[i] (digits, a point, a fraction such as 1/2, or both as
// in 1 1/2), and where it ends (num_end); num_end is i if there is none.
num_end: int = 0;

is_digit(c: int): bool {
    c >= 48 && c <= 57
}

read_plain(t: []i8, i: int, to: int): f32 {
    v: f32 = 0.0;
    j: int = i;
    neg: bool = false;
    if (j < to && t[j] as int == 45) {
        neg = true;
        j = j + 1
    }
    while (j < to && is_digit(t[j] as int)) {
        v = v * 10.0 + (t[j] as int - 48) as f32;
        j = j + 1
    }
    if (j < to && t[j] as int == 46) {
        j = j + 1;
        k: f32 = 0.1;
        while (j < to && is_digit(t[j] as int)) {
            v = v + (t[j] as int - 48) as f32 * k;
            k = k * 0.1;
            j = j + 1
        }
    }
    num_end = j;
    if (neg) return -v;
    v
}

// ---- breaking text into lines ----
// Text broken where it must to fit a width: each line's start and end.
const WRAPS: int = 64;

wrap_from: []int = static_buffer(WRAPS, 0);

wrap_to: []int = static_buffer(WRAPS, 0);

wrap_n: int = 0;

wrap(
    face: int,
    size: f32,
    t: []i8,
    from: int,
    to: int,
    width: f32
) {
    wrap_n = 0;
    start: int = from;
    while (start < to && wrap_n < WRAPS) {
        // (As many words as fit; a word too long for a line on its own.)
        end: int = start;
        fits: int = -1;
        while (end < to) {
            e: int = end;
            while (e < to && t[e] as int != 32) e = e + 1;
            if (p_text_w(face, size, t, start, e) <= width || fits < 0) {
                fits = e;
                end = e + 1
            } else end = to + 1
        }
        if (fits < 0) fits = to;
        wrap_from[wrap_n] = start;
        wrap_to[wrap_n] = fits;
        wrap_n = wrap_n + 1;
        start = fits;
        while (start < to && t[start] as int == 32) start = start + 1
    }
}
