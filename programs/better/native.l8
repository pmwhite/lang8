tag better;

use_tag std, skate;

// What the native apps (ios.l8, android.l8) share: their settings file,
// kept beside the log, as a page keeps them in its storage.
settings_path: str = "";

// The settings file: the theme picked, then the personal link's secret,
// the worker's revision the log was last the same as, and whether it has
// changed here since.
native_save_settings() raises IoError {
    lt_n = 0;
    line_clear();
    line_int(theme_pick);
    lt_line();
    if (sync_linked()) {
        line_clear();
        line_add("me ");
        for i in 0..sync_secret_n line_byte(sync_secret[i] as int);
        lt_line();
        line_clear();
        line_add("rev ");
        line_int(sync_rev);
        lt_line();
        line_clear();
        line_add("dirty ");
        line_int(if (sync_dirty) 1 else 0);
        lt_line()
    }
    line_clear();
    line_add("goals ");
    line_goals();
    lt_line();
    write_file(settings_path)
}

native_load_settings() {
    n: int = read_file(settings_path);
    if (n > 0 && lg_t[0] as int >= 48 && lg_t[0] as int <= 50) theme_pick = lg_t[0] as int - 48;
    i: int = 0;
    while (i < n) {
        e: int = i;
        while (e < n && lg_t[e] as int != 10) e = e + 1;
        if (merge_starts(lg_t, i, e, "me ")) {
            k: int = 0;
            for j in i + 3..e {
                if (k < len(sync_secret)) {
                    sync_secret[k] = lg_t[j];
                    k = k + 1
                }
            }
            sync_secret_n = k
        }
        if (merge_starts(lg_t, i, e, "rev ")) sync_rev = merge_key(lg_t, i, e);
        if (merge_starts(lg_t, i, e, "dirty ")) sync_dirty = merge_key(lg_t, i, e) == 1;
        if (merge_starts(lg_t, i, e, "goals ")) {
            lg_i = i + 6;
            lg_to = e;
            for s in 0..SPORTS goal_set(s, read_int());
            cues_on = read_int() != 0
        }
        i = e + 1
    }
}
