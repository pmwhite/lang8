tag better;

use_tag std, skate;

// The account's pages (see people.l8): its row on You; Sign in; the
// account's own page (another device, everyone for an admin, signing
// out); Add someone; Add a friend; and the Friends tab. Each page slides in
// over the tabs as an activity's does, with its own list.

// ---- on You ----
// Account, and a pill: Sign in, or whose it is (opening its page), or Sign
// in again (signed out elsewhere). Where the page goes on.
account_row(x: f32, y: f32): f32 {
    p_say(1, 15.0, x, y + 23.0, "Account", C_INK, 1.0);
    line_clear();
    if (acct_lost()) {
        line_add("Sign in again");
        w: f32 = pick_w(14.5);
        pill(B_ACCOUNT, x + col_w - w, y, w, PICK_H, "Sign in again", 14.5, -1, C_TOMATO,
            1.0)
    } else if (acct_on()) {
        // (Their name, and a chevron: it opens.)
        line_acct_name();
        if (line_n == 0) line_add("Signed in");
        tw: f32 = line_w(1, 14.5);
        w2: f32 = tw + 44.0;
        px: f32 = x + col_w - w2;
        pr: f32 = pressed(B_ACCOUNT);
        k: f32 = 1.0 - 0.05 * pr;
        cy: f32 = y + PICK_H * 0.5;
        p_box(px + w2 * 0.5 - w2 * k * 0.5, cy - PICK_H * k * 0.5, w2 * k, PICK_H * k,
            PICK_H * k * 0.5, mix_rgb(C_SUNK, C_INK, 0.12 * pr), 1.0);
        p_put(1, 14.5, px + 15.0, cy + 5.2, line, 0, line_n, C_INK, 1.0);
        draw_icon(I_NEXT, px + 15.0 + tw + 12.0, cy, 4.5, C_MUTED, 1.0);
        add_button(B_ACCOUNT, px, y, px + w2, y + PICK_H)
    } else {
        line_add("Sign in");
        w3: f32 = pick_w(14.5);
        pill(B_ACCOUNT, x + col_w - w3, y, w3, PICK_H, "Sign in", 14.5, -1, C_INK,
            1.0)
    }
    y + PICK_H + 12.0
}

// ---- writing ----
// The line, centered on cx, its letters gap apart more than they are.
write_spaced_mid(
    face: int,
    size: f32,
    cx: f32,
    y: f32,
    gap: f32,
    rgb: int,
    a: f32
) {
    w: f32 = gap * (line_n - 1) as f32;
    for i in 0..line_n w = w + p_text_w(face, size, line, i, i + 1);
    px: f32 = cx - w * 0.5;
    for i in 0..line_n px = p_text(face, size, px, y, line, i, i + 1, 0.0, rgb, a) + gap
}

// The line, cut to fit w (ending in an ellipsis), never made smaller.
write_cut(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    rgb: int
) {
    if (line_w(face, size) > w) {
        el: f32 = p_str_w(face, size, "...") * 0.8;
        while (line_n > 0 && p_text_w(face, size, line, 0, line_n) + el > w) {
            line_n = line_n - 1;
            // (Not in the middle of a letter.)
            while (line_n > 0 && (line[line_n] as int & 192) == 128) line_n = line_n - 1
        }
        while (line_n > 0 && line[line_n - 1] as int == 32) line_n = line_n - 1;
        line_ellipsis()
    }
    p_put(face, size, x, y, line, 0, line_n, rgb, 1.0)
}

// A code, big, centered on cx (its baseline at y).
write_code(
    code: []i8,
    n: int,
    size: f32,
    cx: f32,
    y: f32,
    rgb: int
) {
    line_clear();
    line_code_shown(code, n);
    write_spaced_mid(1, size, cx, y, 2.0, rgb, 1.0)
}

// What went wrong with field f, under it (10 below): where the page goes on.
field_error_at(
    f: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    if (field_err[f] == 0) return y;
    line_clear();
    line_error(field_err[f]);
    n: int = write_wrapped(0, 13.5, x, y + 10.0 + 13.0, w, 19.0, C_TOMATO, 1.0);
    y + 10.0 + n as f32 * 19.0 + 2.0
}

// Muted words, wrapped (from the line): where the page goes on.
muted_lines(
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    lh: f32
): f32 {
    n: int = write_wrapped(0, size, x, y + size, w, lh, C_MUTED, 1.0);
    y + size + (n - 1) as f32 * lh + lh - size
}

// The same, each line centered on cx.
muted_mid(
    size: f32,
    cx: f32,
    y: f32,
    w: f32,
    lh: f32
): f32 {
    wrap(0, size, line, 0, line_n, w);
    for i in 0..wrap_n {
        tw: f32 = p_text_w(0, size, line, wrap_from[i], wrap_to[i]);
        p_put(0, size, cx - tw * 0.5, y + size + i as f32 * lh, line, wrap_from[i],
            wrap_to[i], C_MUTED, 1.0)
    }
    y + size + (wrap_n - 1) as f32 * lh + lh - size
}

// How many lines the line takes at w.
lines_of(size: f32, w: f32): int {
    wrap(0, size, line, 0, line_n, w);
    wrap_n
}

// A page's title from title_bytes, and the line under it (from the line):
// where the page goes on.
page_title_bytes(x: f32, y: f32): f32 {
    size: f32 = 34.0;
    tw: f32 = p_text_w(1, size, title_bytes, 0, title_n);
    if (tw > col_w) size = size * col_w / tw;
    p_put(1, size, x, y + 34.0, title_bytes, 0, title_n, C_INK, 1.0);
    if (line_n == 0) return y + 52.0;
    n: int = write_wrapped(0, 16.0, x, y + 61.0, col_w, 22.0, C_MUTED, 1.0);
    y + 61.0 + (n - 1) as f32 * 22.0 + 16.0
}

// ---- the pages ----
draw_sheet(kind: int, ox: f32) {
    v: int = page_view(kind);
    x: f32 = ox + col_x;
    y: f32 = safe_top + 70.0 - sc_pos[v];
    if (kind == PG_SIGNIN) y = signin_page(x, y);
    if (kind == PG_ACCOUNT) y = account_page(x, y);
    if (kind == PG_INVITE) y = invite_page(x, y);
    if (kind == PG_ADDFRIEND) y = addfriend_page(x, y);
    sc_most[v] = y + 20.0 + sc_pos[v] + safe_bottom + 30.0 - view_h();
    top_bar(ox, sc_pos[v], 30.0, title_bytes, title_n);
    back_button(ox)
}

// Sign in: a code, from a text or another device.
signin_page(x: f32, y: f32): f32 {
    line_clear();
    if (acct_lost()) line_add("This device was signed out. Sign in again with a code; nothing on it is lost.") else line_add("With a code from a text, or from Better on your other device.");
    title_from_str("Sign in");
    y2: f32 = page_title_bytes(x, y) + 12.0;
    draw_field_light(1, x, y2, col_w, 54.0, "Code", B_FIELD + 1, B_CLEAR + 1);
    y2 = field_error_at(1, x, y2 + 54.0, col_w) + 16.0;
    pill_ask(B_SIGNIN_GO, x, y2, col_w, 52.0, "Sign in", 17.0, C_INK, C_ON_INK, code_in_field(1));
    y2 = y2 + 52.0 + 14.0;
    // (Signed in again: what is here was the account's already.)
    if (acct_lost()) return y2;
    line_clear();
    if (order_n == 1) line_add("The activity on this device goes into your account.") else if (order_n > 0) {
        line_add("The ");
        line_int(order_n);
        line_add(" activities on this device go into your account.")
    } else line_add("No code? Better works without an account; what you record stays on this device.");
    muted_lines(13.5, x, y2, col_w, 19.0)
}

// The account's own page: whose it is, and how its log is kept; a code for
// another device; everyone (an admin's); signing out.
account_page(x: f32, y: f32): f32 {
    line_clear();
    line_acct_name();
    if (line_n == 0) line_add("Account");
    title_from_line();
    line_clear();
    if (sync_state == 1) line_add("Saved") else if (sync_state == 2) {
        line_add("Saving");
        line_ellipsis()
    } else if (sync_state == 3) line_add("Offline. Saved on this device until it's back.") else line_add("Signed in");
    y2: f32 = page_title_bytes(x, y) + 12.0;
    y2 = device_card(x, y2);
    if (acct_admin) y2 = people_card(x, y2 + 10.0);
    // Signing out (asked twice; not with changes here not yet saved).
    y2 = y2 + 26.0;
    line_clear();
    unsaved: bool = log_unsaved();
    if (!unsaved) line_add("This device forgets your activities. They stay in your account.") else if (sync_state == 3) line_add("Some activities here aren't saved yet. Sign out once you're online.") else line_add("Saving your activities. Sign out once that's done.");
    y2 = muted_lines(13.5, x, y2, col_w, 19.0) + 10.0;
    word: str = "Sign out";
    if (now_t - signout_asked_t < 3.0 && !unsaved) {
        word = "Tap again to sign out";
        busy = true
    }
    pill_ask(B_SIGNOUT, x, y2, col_w, 48.0, word, 15.0, -1, C_TOMATO, !unsaved);
    y2 + 48.0
}

// Another device: a code to sign it in with, good for ten minutes.
device_card(x: f32, y: f32): f32 {
    pad: f32 = 18.0;
    cw: f32 = col_w - 2.0 * pad;
    live: bool = dc_n == CODE_LEN && !dc_out;
    shown: bool = dc_n == CODE_LEN;
    // (Laid out first, to know how tall the card is.)
    device_words(shown);
    n: int = lines_of(14.0, cw);
    py: f32 = pad + 26.0 + 14.0 + (n - 1) as f32 * 20.0 + 6.0 + 6.0;
    line_clear();
    line_add("Good for 10 minutes, once.");
    if (shown) py = py + 64.0 + lines_of(13.5, cw) as f32 * 19.0 + 14.0 else py = py + 10.0;
    h: f32 = py + 40.0 + pad;
    device_words(shown);
    p_box(x, y, col_w, h, 20.0, C_CARD, 1.0);
    p_say(1, 18.0, x + pad, y + pad + 18.0, "Another device", C_INK, 1.0);
    ty: f32 = muted_lines(14.0, x + pad, y + pad + 26.0, cw, 20.0) + 6.0;
    if (shown) {
        rgb: int = C_INK;
        if (!live) rgb = C_FAINT;
        write_code(dc_code, dc_n, 40.0, x + col_w * 0.5, ty + 50.0, rgb);
        line_clear();
        if (live) line_add("Good for 10 minutes, once.") else line_add("This code has run out.");
        ty = muted_mid(13.5, x + col_w * 0.5, ty + 64.0, cw, 19.0) + 14.0
    } else ty = ty + 10.0;
    // (Under a code, the pills are centered with it.)
    mid: f32 = x + col_w * 0.5;
    if (live) {
        px: f32 = mid - (110.0 + 12.0 + 140.0) * 0.5;
        pill(B_DEVICE_SEND, px, ty, 110.0, 40.0, "Send", 15.0, -1, C_INK, 1.0);
        pill_ask(B_DEVICE_CODE, px + 122.0, ty, 140.0, 40.0, "New code", 15.0, -1,
            C_INK, true)
    } else if (shown) pill_ask(B_DEVICE_CODE, mid - 70.0, ty, 140.0, 40.0, "Get a code",
        15.0, -1, C_INK, true) else pill_ask(B_DEVICE_CODE, x + pad, ty, 140.0, 40.0,
        "Get a code", 15.0, -1, C_INK, true);
    y + h
}

// What the card says: how, with the code shown, or how to have one.
device_words(shown: bool) {
    line_clear();
    if (shown) line_add("On your other phone or computer, open Better, go to You, then Sign in, and enter this code.") else line_add("Get a code here, then on your other phone or computer open Better, go to You, Sign in, and enter it.")
}

// Everyone (for an admin): each one's state, and a new code for them; and
// someone added. Where the page goes on.
people_card(x: f32, y: f32): f32 {
    p_say(1, 19.0, x, y + 19.0, "People", C_INK, 1.0);
    y2: f32 = y + 34.0;
    rows: int = maxi(ad_n, 1);
    h: f32 = rows as f32 * 58.0 + 8.0;
    p_box(x, y2, col_w, h, 20.0, C_CARD, 1.0);
    ry: f32 = y2 + 4.0;
    if (ad_n == 0) {
        line_clear();
        if (ad_loading) line_ellipsis() else line_add("Can't reach Better right now");
        p_put(0, 14.0, x + 18.0, ry + 33.0, line, 0, line_n, C_MUTED, 1.0)
    }
    now: int = clock_ms();
    for a in 0..ad_n {
        me: bool = ad_is_me(a);
        bw: f32 = 0.0;
        if (!me) {
            line_clear();
            line_add("New code");
            bw = pick_w(13.5);
            pill_ask(B_PERSON_CODE + a, x + col_w - 14.0 - bw, ry + 11.0, bw, 36.0,
                "New code", 13.5, -1, C_INK, true)
        }
        line_clear();
        line_ad_name(a);
        write_cut(1, 15.5, x + 18.0, ry + 24.0, col_w - 50.0 - bw, C_INK);
        line_clear();
        if (me) line_add("You") else if (ad_joined[a]) {
            line_add("Signed in");
            line_dot();
            line_int(ad_acts[a]);
            if (ad_acts[a] == 1) line_add(" activity") else line_add(" activities")
        } else if (ad_until[a] > now) {
            line_add("Invite good until ");
            line_day_short(day_of_ms(ad_until[a]))
        } else line_add("Invite ran out");
        write_cut(0, 13.0, x + 18.0, ry + 43.0, col_w - 50.0 - bw, C_MUTED);
        ry = ry + 58.0
    }
    y2 = y2 + h + 12.0;
    pill(B_ADD_SOMEONE, x, y2, col_w, 48.0, "Add someone", 15.5, C_INK, C_ON_INK,
        1.0);
    y2 + 48.0
}

// Add someone (an admin's): their name, and whether they are your friend;
// then the invite, sent.
invite_page(x: f32, y: f32): f32 {
    if (inv_made) {
        title_n = mini(inv_name_n, len(title_bytes));
        for i in 0..title_n title_bytes[i] = inv_name[i];
        line_clear();
        line_add("Invite made");
        y2: f32 = page_title_bytes(x, y) + 12.0;
        h: f32 = 124.0;
        p_box(x, y2, col_w, h, 20.0, C_CARD, 1.0);
        write_code(inv_code, inv_n, 40.0, x + col_w * 0.5, y2 + 66.0, C_INK);
        line_clear();
        line_add("Good until ");
        line_day_short(day_of_ms(inv_until));
        line_add(", once.");
        y2 = maxf(muted_mid(13.5, x + col_w * 0.5, y2 + 82.0, col_w - 36.0, 19.0),
            y2 + h) + 16.0;
        bw: f32 = (col_w - 12.0) * 0.5;
        pill(B_INVITE_SEND, x, y2, bw, 48.0, "Send", 16.0, C_INK, C_ON_INK, 1.0);
        pill(B_INVITE_DONE, x + bw + 12.0, y2, bw, 48.0, "Done", 16.0, -1, C_INK,
            1.0);
        return y2 + 48.0
    }
    title_from_str("Add someone");
    line_clear();
    line_add("They get a code to sign in with.");
    y3: f32 = page_title_bytes(x, y) + 12.0;
    draw_field_light(2, x, y3, col_w, 54.0, "Their name", B_FIELD + 2, B_CLEAR + 2);
    y3 = field_error_at(2, x, y3 + 54.0, col_w) + 18.0;
    p_say(1, 15.0, x, y3 + 23.0, "Friends with you", C_INK, 1.0);
    line_clear();
    line_add("Off");
    ow: f32 = pick_w(14.5);
    pick(B_INVITE_OFF, x + col_w - ow, y3, ow, !inv_friend, 14.5, C_INK);
    line_clear();
    line_add("On");
    nw: f32 = pick_w(14.5);
    pick(B_INVITE_ON, x + col_w - ow - 8.0 - nw, y3, nw, inv_friend, 14.5, C_INK);
    y3 = y3 + PICK_H + 20.0;
    named: bool = false;
    for i in 0..fq_n[2] {
        if (fq[2 * FIELD_BYTES + i] as int != 32) named = true
    }
    pill_ask(B_INVITE_GO, x, y3, col_w, 52.0, "Make an invite", 17.0, C_INK, C_ON_INK,
        named);
    y3 + 52.0
}

// Add a friend: a code to send, or one to enter.
addfriend_page(x: f32, y: f32): f32 {
    title_from_str("Add a friend");
    line_clear();
    line_add("You each see the other's runs, rides and walks.");
    y2: f32 = page_title_bytes(x, y) + 12.0;
    pad: f32 = 18.0;
    cw: f32 = col_w - 2.0 * pad;
    // Send a code (and once sent, it, to be read out too).
    shown: bool = fc_shown && fc_n == CODE_LEN;
    line_clear();
    line_add("Good for 7 days, for one person. Send another for someone else.");
    n: int = lines_of(13.5, cw);
    h: f32 = pad + 22.0 + 8.0 + 20.0 + 16.0 + 46.0 + pad;
    if (shown) h = h + 44.0 + 12.0 + n as f32 * 19.0 + 14.0;
    p_box(x, y2, col_w, h, 20.0, C_CARD, 1.0);
    p_say(1, 18.0, x + pad, y2 + pad + 18.0, "Send a code", C_INK, 1.0);
    line_clear();
    line_add("They enter it in Better, or open the link.");
    ty: f32 = muted_lines(14.0, x + pad, y2 + pad + 26.0, cw, 20.0) + 12.0;
    if (shown) {
        write_code(fc_code, fc_n, 32.0, x + col_w * 0.5, ty + 36.0, C_INK);
        line_clear();
        line_add("Good for 7 days, for one person. Send another for someone else.");
        ty = muted_mid(13.5, x + col_w * 0.5, ty + 50.0, cw, 19.0) + 16.0
    }
    if (shown) pill_ask(B_FRIEND_SEND, x + col_w * 0.5 - 80.0, ty, 160.0, 46.0, "Send another",
        15.5, C_INK, C_ON_INK, true) else pill_ask(B_FRIEND_SEND, x + pad, ty, 120.0,
        46.0, "Send", 15.5, C_INK, C_ON_INK, true);
    y2 = y2 + h + 14.0;
    // Have a code: entered here.
    h2: f32 = pad + 22.0 + 14.0 + 54.0 + 16.0 + 52.0 + pad;
    line_clear();
    if (field_err[1] != 0) {
        line_error(field_err[1]);
        h2 = h2 + 10.0 + lines_of(13.5, cw) as f32 * 19.0 + 2.0
    }
    p_box(x, y2, col_w, h2, 20.0, C_CARD, 1.0);
    p_say(1, 18.0, x + pad, y2 + pad + 18.0, "Have a code?", C_INK, 1.0);
    fy: f32 = y2 + pad + 36.0;
    draw_field_light(1, x + pad, fy, cw, 54.0, "Code", B_FIELD + 1, B_CLEAR + 1);
    fy = field_error_at(1, x + pad, fy + 54.0, cw) + 16.0;
    pill_ask(B_FRIEND_USE, x + pad, fy, cw, 52.0, "Add friend", 17.0, C_INK, C_ON_INK,
        code_in_field(1));
    y2 + h2
}

// ---- Friends ----
// Friends' last four weeks, by the week, newest first: everyone's, or one
// friend's (picked), who can be removed.
draw_friends(ox: f32) {
    v: int = V_FRIENDS;
    x: f32 = ox + col_x;
    y: f32 = safe_top + 16.0 - sc_pos[v];
    vh: f32 = view_h();
    fetched: bool = feed_t >= 0.0;
    unreachable: bool = !fetched && feed_failed;
    line_clear();
    if (unreachable) line_add("Can't reach Better right now.") else if (fr_n == 0) line_add("Runs, rides and walks of people you're friends with.") else line_add("Their last four weeks");
    y = page_title(x, y, "Friends");
    if (unreachable) {
        line_clear();
        line_add("Try again");
        tw: f32 = pick_w(14.5);
        pill_ask(B_FEED_RETRY, x, y, tw, PICK_H, "Try again", 14.5, -1, C_INK, true);
        y = y + PICK_H + 16.0
    }
    if (fetched && fr_n == 0) {
        // No friends yet: how to have some.
        line_clear();
        line_add("Send someone a code. Once they enter it, you each see the other's runs, rides and walks.");
        n: int = lines_of(14.5, col_w - 44.0);
        h: f32 = maxf(150.0, 80.0 + (n - 1) as f32 * 20.0 + 18.0 + 40.0 + 20.0);
        p_box(x, y, col_w, h, 20.0, C_CARD, 1.0);
        icon_bg = C_CARD;
        draw_icon(I_FRIENDS, x + 36.0, y + 42.0, 12.0, C_FAINT, 1.0);
        p_str(1, 18.0, x + 62.0, y + 48.0, "No friends yet", C_INK, 1.0);
        write_wrapped(0, 14.5, x + 22.0, y + 80.0, col_w - 44.0, 20.0, C_MUTED, 1.0);
        pill(B_FRIEND_ADD, x + 22.0, y + h - 20.0 - 40.0, 160.0, 40.0, "Add a friend",
            15.0, C_INK, C_ON_INK, 1.0);
        y = y + h + 20.0
    }
    if (fr_n > 0) {
        // Who: All, each friend, and + Add (on as many rows as it takes).
        px: f32 = x;
        for k in 0..fr_n + 2 {
            line_clear();
            if (k == 0) line_add("All") else if (k <= fr_n) line_friend_first(k - 1) else line_add("+ Add");
            pw: f32 = pick_w(14.5);
            if (px > x && px + pw > x + col_w) {
                px = x;
                y = y + PICK_H + 8.0
            }
            if (k <= fr_n) pick(B_FRIEND_PICK + k, px, y, pw, fr_pick == k - 1, 14.5,
                C_INK) else pill(B_FRIEND_ADD, px, y, pw, PICK_H, "+ Add", 14.5, -1,
                C_INK, 1.0);
            px = px + pw + 8.0
        }
        y = y + PICK_H + 20.0;
        // Their activities, by the week.
        d: int = today();
        week: int = -100000;
        shown: int = 0;
        for k2 in 0..fd_n {
            a: int = fd_order[k2];
            if (fr_pick < 0 || fd_friend[a] == fr_pick) {
                shown = shown + 1;
                wk: int = week_of(fd_day(a));
                if (wk != week) {
                    week = wk;
                    if (y > -60.0 && y < vh) {
                        c: int = 0;
                        for k3 in 0..fd_n {
                            if ((fr_pick < 0 || fd_friend[k3] == fr_pick) && week_of(fd_day(k3)) == wk) c = c + 1
                        }
                        line_clear();
                        line_int(c);
                        if (c == 1) line_add(" activity") else line_add(" activities");
                        write_right(0, 14.0, x + col_w, y + 19.0, C_MUTED, 1.0);
                        line_clear();
                        line_week(wk, d);
                        p_put(1, 18.0, x, y + 19.0, line, 0, line_n, C_INK, 1.0)
                    }
                    y = y + 36.0
                }
                if (y > -140.0 && y < vh) friend_card(a, x, y);
                y = y + ACT_CARD_H + 12.0
            }
        }
        if (shown == 0) {
            line_clear();
            if (fr_pick < 0) line_add("Nothing in the last four weeks.") else {
                line_add("Nothing from ");
                line_friend_first(fr_pick);
                line_add(" in the last four weeks.")
            }
            p_box(x, y, col_w, 64.0, 20.0, C_CARD, 1.0);
            write_cut(0, 14.5, x + 18.0, y + 38.0, col_w - 36.0, C_MUTED);
            y = y + 64.0 + 12.0
        }
        // The friend picked: since when, and removing them (asked twice).
        if (fr_pick >= 0) {
            y = y + 12.0;
            line_clear();
            line_add("Friends since ");
            calendar(day_of_ms(fr_since[fr_pick]));
            line_add(month_title[cal_month - 1]);
            line_byte(32);
            line_int(cal_year);
            y = muted_lines(13.5, x, y, col_w, 19.0) + 12.0;
            line_clear();
            if (now_t - remove_asked_t < 3.0) {
                line_add("Tap again to remove");
                busy = true
            } else {
                line_add("Remove ");
                line_friend_first(fr_pick)
            }
            remove_pill(x, y);
            y = y + 48.0 + 12.0
        }
    }
    sc_most[v] = y + sc_pos[v] + end_room() - view_h();
    title_from_str("Friends");
    top_bar(ox, sc_pos[v], 40.0, title_bytes, title_n)
}

// Remove (its words in the line), outlined in tomato, the width of the
// column.
remove_pill(x: f32, y: f32) {
    id: int = B_FRIEND_REMOVE;
    h: f32 = 48.0;
    a: f32 = 1.0;
    if (people_waiting(id)) a = 0.5;
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.04 * pr;
    cx: f32 = x + col_w * 0.5;
    cy: f32 = y + h * 0.5;
    p_outline(cx - col_w * k * 0.5, cy - h * k * 0.5, col_w * k, h * k, h * k * 0.5,
        1.5, C_TOMATO, a * (0.45 + 0.3 * pr));
    tw: f32 = line_w(1, 15.0 * k);
    p_put(1, 15.0 * k, cx - tw * 0.5, cy + 15.0 * 0.36 * k, line, 0, line_n, C_TOMATO,
        a);
    if (!people_waiting(id)) add_button(id, x, y, x + col_w, y + h)
}

// A friend's activity: as one of yours in the Log, with whose it is, and
// not to be opened.
friend_card(a: int, x: f32, y: f32) {
    s: int = fd_sport[a];
    h: f32 = ACT_CARD_H;
    p_box(x, y, col_w, h, 20.0, C_CARD, 1.0);
    p_disc(x + 36.0, y + 36.0, 20.0, sport_soft[s], 1.0);
    draw_icon(sport_icon(s), x + 36.0, y + 36.0, 11.0, sport_rgb[s], 1.0);
    line_clear();
    line_feed_name(a);
    write_fit(1, 17.0, x + 68.0, y + 32.0, col_w - 86.0, C_INK, 1.0);
    line_clear();
    line_friend_first(fd_friend[a]);
    line_dot();
    calendar(today());
    line_when_at(fd_day(a), fd_minute(a), cal_year);
    write_fit(0, 13.5, x + 68.0, y + 52.0, col_w - 86.0, C_MUTED, 1.0);
    cw: f32 = (col_w - 36.0) / 3.0;
    sy: f32 = y + 72.0;
    line_clear();
    line_dist(fd_dist[a] as f32 * 0.1);
    stat(x + 18.0, sy, 20.0, unit_word(), "Distance", C_INK, C_MUTED);
    line_clear();
    v: f32 = 0.0;
    if (fd_moving[a] > 0) v = fd_dist[a] as f32 * 0.1 / fd_moving[a] as f32;
    line_speed(s, v);
    stat(x + 18.0 + cw, sy, 20.0, speed_unit(s), speed_title(s), C_INK, C_MUTED);
    line_clear();
    line_time(fd_moving[a]);
    stat(x + 18.0 + 2.0 * cw, sy, 20.0, "", "Time", C_INK, C_MUTED)
}
