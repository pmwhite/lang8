tag better;

use_tag std, skate;

// Better's own things, from which its pages are made: colors; buttons,
// made as they are drawn and pressed against what the last frame drew;
// things that ease to where they are going; lists that scroll and glide;
// the fields (an activity's name, a code, a person's name); the toast; and
// the icons.
// The colors, as the theme has them now: light or dark, or (while it
// changes) between (see set_theme). Each is 0xRRGGBB in decimal.
C_BG: int = 16053489;

C_CARD: int = 16777215;

C_INK: int = 1513500;

C_MUTED: int = 7171960;

C_FAINT: int = 11119539;

C_LINE: int = 14999776;

C_SUNK: int = 15461351;

C_TOMATO: int = 13646395;

C_TOMATO_SOFT: int = 16304857;

C_GOOD: int = 3119715;

// (Words on a box of the ink: white on the light theme's dark ink, ink on
// the dark theme's light one.)
C_ON_INK: int = 16777215;

// Each sport's color: a run coral, a ride blue, a walk green; and the
// same, washed into a card (for what is behind a mark).
sport_rgb: []int = [14702639, 3108822, 3119715];

sport_soft: []int = [16441812, 14280185, 14281696];

// The same in each theme: what is on a sport's color, and shadows.
const C_WARN: int = 14002730; // #d5aa2a

const C_SHADOW: int = 1250067; // #131313

const C_WHITE: int = 16777215; // #ffffff

// The two themes, a color each in the order of theme_colors.
const THEME_COLORS: int = 11;

light_theme: []int = [16053489, 16777215, 1513500, 7171960, 11119539, 14999776, 15461351,
    13646395, 16304857, 3119715, 16777215];

// (#121317 #1d1f25 #f4f4f1 #8d909b #5d606b #2c2e35 #272930 #e5564f
// #4a2427 #3aa86f #17181c)
dark_theme: []int = [1184535, 1908517, 16053489, 9277595, 6119531, 2895413, 2566448,
    15029839, 4858919, 3844207, 1513500];

// The colors as they are now (kept, not made each time they change: on an
// iPhone what a frame makes is never freed).
theme_now: []int = new int[THEME_COLORS](0);

// How dark the colors are: 0 the light theme, 1 the dark, between while
// it changes.
theme_dark: f32 = -1.0;

set_theme(t: f32) {
    if (t == theme_dark) return;
    theme_dark = t;
    c: []int = theme_now;
    for k in 0..THEME_COLORS c[k] = mix_rgb(light_theme[k], dark_theme[k], t);
    C_BG = c[0];
    C_CARD = c[1];
    C_INK = c[2];
    C_MUTED = c[3];
    C_FAINT = c[4];
    C_LINE = c[5];
    C_SUNK = c[6];
    C_TOMATO = c[7];
    C_TOMATO_SOFT = c[8];
    C_GOOD = c[9];
    C_ON_INK = c[10];
    for s in 0..3 sport_soft[s] = mix_rgb(C_CARD, sport_rgb[s], 0.16 + 0.1 * t)
}

// The recording's own, dark (it is looked at in sun, and spares a phone's
// battery).
const D_BG: int = 1184535; // #121317

const D_CARD: int = 1908517; // #1d1f25

const D_INK: int = 16053489; // #f4f4f1

const D_MUTED: int = 9277595; // #8d909b

const D_LINE: int = 2829102; // #2b2b2e

mix_rgb(a: int, b: int, t: f32): int {
    k: f32 = clampf(t, 0.0, 1.0);
    r: int = ((a >> 16 & 255) as f32 * (1.0 - k) + (b >> 16 & 255) as f32 * k + 0.5) as int;
    g: int = ((a >> 8 & 255) as f32 * (1.0 - k) + (b >> 8 & 255) as f32 * k + 0.5) as int;
    bl: int = ((a & 255) as f32 * (1.0 - k) + (b & 255) as f32 * k + 0.5) as int;
    (r << 16) + (g << 8) + bl
}

// ---- time, and things easing ----
now_t: f32 = 0.0;

frame_dt: f32 = 0.016;

// Whether anything drawn this frame is still on its way (so that the
// next frame is drawn too).
busy: bool = false;

ease_to(cur: f32, target: f32, rate: f32): f32 {
    if (absf(target - cur) < 0.0008) return target;
    busy = true;
    cur + (target - cur) * (1.0 - expf(-frame_dt * rate))
}

// The phone's own edges (its notch, its home bar), in the app's pixels.
safe_top: f32 = 0.0;

safe_bottom: f32 = 0.0;

safe_left: f32 = 0.0;

safe_right: f32 = 0.0;

// Whether fingers are a phone's (the page says so), and whether Better
// is on a page at all.
touch_ui: bool = false;

on_page: bool = false;

// ---- buttons ----
const BUTTONS: int = 512;

btn_n: int = 0;

btn_id: []int = new int[BUTTONS](0);

btn_x0: []f32 = new f32[BUTTONS](0.0);

btn_y0: []f32 = new f32[BUTTONS](0.0);

btn_x1: []f32 = new f32[BUTTONS](0.0);

btn_y1: []f32 = new f32[BUTTONS](0.0);

// A button, as much of it as shows within the clip.
add_button(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    if (btn_n >= BUTTONS) return;
    a: f32 = maxf(x0, p_cx0);
    b: f32 = maxf(y0, p_cy0);
    c: f32 = minf(x1, p_cx1);
    d: f32 = minf(y1, p_cy1);
    if (c <= a || d <= b) return;
    btn_id[btn_n] = id;
    btn_x0[btn_n] = a;
    btn_y0[btn_n] = b;
    btn_x1[btn_n] = c;
    btn_y1[btn_n] = d;
    btn_n = btn_n + 1
}

// The button at (x, y), the last drawn first (it is on top); 0 if none.
button_at(x: f32, y: f32): int {
    k: int = btn_n - 1;
    while (k >= 0) {
        if (x >= btn_x0[k] - 2.0 && x <= btn_x1[k] + 2.0 && y >= btn_y0[k] - 2.0 && y <= btn_y1[k] + 2.0) return btn_id[k];
        k = k - 1
    }
    0
}

// The button a finger is on, and how pressed it shows (in quickly, out
// slowly).
press_id: int = 0;

press_show: f32 = 0.0;

press_shown_id: int = 0;

pressed(id: int): f32 {
    if (press_shown_id == id) return press_show;
    0.0
}

step_press() {
    if (press_id != 0) {
        press_shown_id = press_id;
        press_show = minf(press_show + frame_dt * 16.0, 1.0)
    } else press_show = maxf(press_show - frame_dt * 5.0, 0.0);
    if (press_show > 0.0 && press_show < 1.0) busy = true
}

// ---- lists that scroll ----
// Each page's list: how far it has scrolled, how fast it goes on, how far
// it can go, and whether a finger holds it.
const VIEWS: int = 10;

const V_RECORD: int = 0;

const V_LOG: int = 1;

const V_YOU: int = 2;

const V_ACT: int = 3;

const V_REC: int = 4;

const V_FRIENDS: int = 5;

// (The pages of an account: see people_pages.l8.)
const V_SIGNIN: int = 6;

const V_ACCOUNT: int = 7;

const V_INVITE: int = 8;

const V_ADDFRIEND: int = 9;

sc_pos: []f32 = new f32[VIEWS](0.0);

sc_vel: []f32 = new f32[VIEWS](0.0);

sc_most: []f32 = new f32[VIEWS](0.0);

sc_held: []bool = new bool[VIEWS](false);

// (Going back to its top, as when its tab is tapped again.)
sc_home: []bool = new bool[VIEWS](false);

// A list let go glides to a stop, or back within its ends.
step_scroll(v: int) {
    if (sc_held[v]) return;
    if (sc_home[v]) {
        sc_vel[v] = 0.0;
        sc_pos[v] = ease_to(sc_pos[v], 0.0, 9.0);
        if (sc_pos[v] == 0.0) sc_home[v] = false;
        return
    }
    dt: f32 = frame_dt;
    p: f32 = sc_pos[v];
    most: f32 = maxf(sc_most[v], 0.0);
    if (p < 0.0 || p > most) {
        end: f32 = 0.0;
        if (p > most) end = most;
        // (Past an end it slows hard, and comes back.)
        sc_vel[v] = sc_vel[v] * expf(-dt * 22.0);
        p = p + sc_vel[v] * dt;
        p = end + (p - end) * expf(-dt * 11.0);
        if (absf(p - end) < 0.3) p = end;
        sc_pos[v] = p;
        busy = true;
        return
    }
    if (absf(sc_vel[v]) < 8.0) {
        sc_vel[v] = 0.0;
        return
    }
    sc_pos[v] = p + sc_vel[v] * dt;
    sc_vel[v] = sc_vel[v] * expf(-dt * 2.4);
    busy = true
}

// Moved by a finger, dy down the screen: past an end, reluctantly.
scroll_by(v: int, dy: f32) {
    most: f32 = maxf(sc_most[v], 0.0);
    p: f32 = sc_pos[v];
    k: f32 = 1.0;
    if (p < 0.0) k = 0.5 / (1.0 - p / 90.0);
    if (p > most) k = 0.5 / (1.0 + (p - most) / 90.0);
    sc_pos[v] = p - dy * k
}

// ---- fields ----
// An activity's name (0, as it is saved), a code (1), and a person's name
// (2): what is written in each, and which is being written in (-1 none).
const FIELDS: int = 3;

// What a phone's keyboard is to be like for each: as for a name of
// anything (plain), capitals and no suggestions (code), or each word
// capitalized (name).
const FK_PLAIN: int = 0;

const FK_CODE: int = 1;

const FK_NAME: int = 2;

field_kind_word: []str = ["plain", "code", "name"];

const FIELD_BYTES: int = 60;

fq: []i8 = new i8[FIELDS * FIELD_BYTES](0i8);

fq_n: []int = new int[FIELDS](0);

field_on: int = -1;

// When it was last written in (the caret shows steadily for a while).
field_typed_t: f32 = 0.0;

// What is written in field f, alone, for searching with.
fq_buf: []i8 = new i8[FIELD_BYTES](0i8);

field_text(f: int): []i8 {
    for i in 0..fq_n[f] fq_buf[i] = fq[f * FIELD_BYTES + i];
    fq_buf
}

field_type(f: int, c: int) {
    if (fq_n[f] >= FIELD_BYTES) return;
    fq[f * FIELD_BYTES + fq_n[f]] = c trunc i8;
    fq_n[f] = fq_n[f] + 1;
    field_typed_t = now_t;
    field_err[f] = 0;
    field_retell = true
}

field_back(f: int) {
    if (fq_n[f] == 0) return;
    fq_n[f] = fq_n[f] - 1;
    field_typed_t = now_t;
    field_err[f] = 0;
    field_retell = true
}

field_clear(f: int) {
    if (fq_n[f] == 0) return;
    fq_n[f] = 0;
    field_err[f] = 0;
    field_retell = true
}

// The field on the screen, as the page was last told (it puts a phone's
// keyboard up when a finger comes down on it).
told_x0: f32 = -1.0;

told_y0: f32 = -1.0;

told_x1: f32 = -1.0;

told_y1: f32 = -1.0;

shown_x0: f32 = -1.0;

shown_y0: f32 = -1.0;

shown_x1: f32 = -1.0;

shown_y1: f32 = -1.0;

// (Which field it is, and whether what is written in it has changed
// since the page was told.)
shown_f: int = -1;

told_f: int = -1;

told_kind: int = -1;

field_retell: bool = false;

field_shown(
    f: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    // (Of two on the screen, the one being written in.)
    if (shown_x0 >= 0.0 && shown_f == field_on && f != field_on) return;
    shown_f = f;
    shown_x0 = maxf(x0, p_cx0);
    shown_y0 = maxf(y0, p_cy0);
    shown_x1 = minf(x1, p_cx1);
    shown_y1 = minf(y1, p_cy1);
    if (shown_x1 <= shown_x0 || shown_y1 <= shown_y0) shown_x0 = -1.0
}

// Once a frame, after drawing: tell the page where the field is, if that
// has changed.
tell_field() raises IoError {
    if (!on_page) return;
    if (absf(shown_x0 - told_x0) + absf(shown_y0 - told_y0) + absf(shown_x1 - told_x1) + absf(shown_y1 - told_y1) < 0.5 && shown_f == told_f && !field_retell) return;
    field_retell = false;
    // (Its keyboard, if it is another kind of field.)
    if (shown_x0 >= 0.0 && shown_f >= 0 && shown_f != told_kind) {
        told_kind = shown_f;
        line_clear();
        line_add("L8FIELDKIND ");
        line_add(field_kind_word[shown_f]);
        write_bytes_n(1, line, line_n);
        print("")
    }
    told_f = shown_f;
    told_x0 = shown_x0;
    told_y0 = shown_y0;
    told_x1 = shown_x1;
    told_y1 = shown_y1;
    line_clear();
    if (shown_x0 < 0.0) line_add("L8FIELD -") else {
        line_add("L8FIELD ");
        line_int(shown_x0 as int);
        line_byte(32);
        line_int(shown_y0 as int);
        line_byte(32);
        line_int((shown_x1 + 0.5) as int);
        line_byte(32);
        line_int((shown_y1 + 0.5) as int);
        // (And what is written in it.)
        line_byte(32);
        for i in 0..fq_n[shown_f] line_byte(fq[shown_f * FIELD_BYTES + i] as int)
    }
    write_bytes_n(1, line, line_n);
    print("")
}

// No field written in any more: the page puts the keyboard away.
blur_wanted: bool = false;

field_blur() {
    if (field_on >= 0 && on_page) blur_wanted = true;
    field_on = -1
}

// The field: a box, what is written or what to write, the caret, and a
// button to clear it; on the dark of the recording.
draw_field(
    f: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    hint: str,
    id: int,
    clear_id: int
) {
    field_drawn(f, x, y, w, h, hint, id, clear_id, D_CARD, D_INK, D_MUTED, D_LINE,
        sport_rgb[rec_sport], 0.8)
}

// The same on a page of the theme's.
draw_field_light(
    f: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    hint: str,
    id: int,
    clear_id: int
) {
    field_drawn(f, x, y, w, h, hint, id, clear_id, C_SUNK, C_INK, C_MUTED, C_LINE,
        C_INK, 0.5)
}

field_drawn(
    f: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    hint: str,
    id: int,
    clear_id: int,
    box: int,
    ink: int,
    muted: int,
    disc: int,
    edge: int,
    edge_a: f32
) {
    on: bool = field_on == f;
    p_box(x, y, w, h, 14.0, box, 1.0);
    if (on) p_outline(x - 1.0, y - 1.0, w + 2.0, h + 2.0, 15.0, 2.0, edge, edge_a);
    tx: f32 = x + 16.0;
    base: f32 = y + h * 0.5 + 6.5;
    size: f32 = 18.0;
    end: f32 = tx;
    // (A code is shown as K7QM-3XPA, whatever was typed.)
    line_clear();
    if (f == 1) {
        code_norm(fq, FIELD_BYTES, FIELD_BYTES + fq_n[1]);
        line_code_shown(code_buf, code_n)
    } else
        for i in 0..fq_n[f] line_byte(fq[f * FIELD_BYTES + i] as int);
    if (line_n == 0) p_str(0, size, tx, base, hint, muted, 1.0) else end = p_text(1,
        size, tx, base, line, 0, line_n, 0.0, ink, 1.0);
    if (on) {
        // (Steady while written in, then blinking.)
        blink: f32 = 1.0;
        since: f32 = now_t - field_typed_t;
        if (since > 0.6) {
            blink = clampf(1.6 - 2.0 * absf(fmodf(since, 1.1) - 0.55) * 2.0, 0.0,
                1.0);
            busy = true
        }
        p_box(end + 1.0, y + h * 0.5 - 12.0, 2.0, 24.0, 1.0, edge, blink)
    }
    add_button(id, x, y, x + w - 44.0, y + h);
    if (fq_n[f] > 0) {
        cx: f32 = x + w - 24.0;
        cy: f32 = y + h * 0.5;
        p_disc(cx, cy, 11.0, mix_rgb(disc, muted, pressed(clear_id)), 1.0);
        draw_icon(I_CROSS, cx, cy, 4.0, ink, 1.0);
        add_button(clear_id, x + w - 48.0, y, x + w, y + h)
    } else add_button(id, x + w - 44.0, y, x + w, y + h);
    if (fq_n[f] > 0) field_shown(f, x, y, x + w - 48.0, y + h) else field_shown(f,
        x, y, x + w, y + h)
}

fmodf(x: f32, m: f32): f32 {
    x - (x / m) as int as f32 * m
}

// ---- a toast: a word for a moment ----
toast_buf: []i8 = new i8[200](0i8);

toast_n: int = 0;

toast_t: f32 = 10.0;

toast_line() {
    toast_n = mini(line_n, len(toast_buf));
    for i in 0..toast_n toast_buf[i] = line[i];
    toast_t = 0.0
}

draw_toast(bottom: f32) {
    if (toast_t >= 2.4 || toast_n == 0) return;
    toast_t = toast_t + frame_dt;
    busy = true;
    a: f32 = clampf(toast_t * 7.0, 0.0, 1.0) * clampf((2.4 - toast_t) * 4.0, 0.0,
        1.0);
    size: f32 = 16.0;
    tw: f32 = p_text_w(1, size, toast_buf, 0, toast_n);
    w: f32 = minf(tw + 40.0, view_w() - 32.0);
    if (tw + 40.0 > w) size = size * (w - 40.0) / tw;
    h: f32 = 44.0;
    x: f32 = (view_w() - w) * 0.5;
    y: f32 = bottom - h + (1.0 - a) * 14.0;
    p_shadow(x, y, w, h, h * 0.5, 6.0, 18.0, 0.25 * a);
    p_box(x, y, w, h, h * 0.5, C_INK, 0.96 * a);
    p_text(1, size, x + 20.0, y + h * 0.5 + size * 0.36, toast_buf, 0, toast_n, 0.0,
        C_BG, a)
}

// ---- icons, drawn in lines about (x, y), r their half size ----
const I_CROSS: int = 1;

const I_BACK: int = 2;

const I_CHECK: int = 3;

const I_RECORD: int = 4;

const I_LIST: int = 5;

const I_YOU: int = 6;

const I_RUN: int = 7;

const I_RIDE: int = 8;

const I_WALK: int = 9;

const I_PAUSE: int = 10;

const I_PLAY: int = 11;

const I_STOP: int = 12;

const I_MEDAL: int = 13;

const I_SHIELD: int = 14;

const I_NEXT: int = 15;

const I_CLOCK: int = 16;

const I_FRIENDS: int = 17;

// The icon of sport s.
sport_icon(s: int): int {
    if (s == S_RIDE) return I_RIDE;
    if (s == S_WALK) return I_WALK;
    I_RUN
}

draw_icon(
    id: int,
    x: f32,
    y: f32,
    r: f32,
    rgb: int,
    a: f32
) {
    t: f32 = maxf(r * 0.22, 1.6);
    if (id == I_CROSS) {
        p_line(x - r, y - r, x + r, y + r, t * 1.1, rgb, a);
        p_line(x + r, y - r, x - r, y + r, t * 1.1, rgb, a)
    }
    if (id == I_BACK) {
        p_line(x + r * 0.35, y - r * 0.8, x - r * 0.45, y, t, rgb, a);
        p_line(x - r * 0.45, y, x + r * 0.35, y + r * 0.8, t, rgb, a)
    }
    if (id == I_NEXT) {
        p_line(x - r * 0.4, y - r, x + r * 0.5, y, t * 1.2, rgb, a);
        p_line(x + r * 0.5, y, x - r * 0.4, y + r, t * 1.2, rgb, a)
    }
    if (id == I_CHECK) {
        p_line(x - r * 0.8, y + r * 0.05, x - r * 0.25, y + r * 0.6, t, rgb, a);
        p_line(x - r * 0.25, y + r * 0.6, x + r * 0.85, y - r * 0.55, t, rgb, a)
    }
    if (id == I_RECORD) {
        p_ring(x, y, r, t, rgb, a);
        p_disc(x, y, r * 0.45, rgb, a)
    }
    if (id == I_LIST) {
        for k in 0..3 {
            ly: f32 = y + (k - 1) as f32 * r * 0.62;
            p_disc(x - r * 0.8, ly, t * 0.75, rgb, a);
            p_line(x - r * 0.35, ly, x + r * 0.95, ly, t, rgb, a)
        }
    }
    if (id == I_YOU) {
        // A head and shoulders.
        p_ring(x, y - r * 0.35, r * 0.42, t, rgb, a);
        p_arc(x, y + r * 0.95, r * 0.78, t, 3.3, 2.82, rgb, a)
    }
    if (id == I_RUN) {
        // A runner, leaning into a stride.
        p_disc(x + r * 0.3, y - r * 0.78, r * 0.2, rgb, a);
        p_line(x + r * 0.12, y - r * 0.42, x - r * 0.12, y + r * 0.12, t, rgb, a);
        p_line(x + r * 0.08, y - r * 0.34, x + r * 0.45, y - r * 0.12, t, rgb, a);
        p_line(x + r * 0.45, y - r * 0.12, x + r * 0.65, y - r * 0.42, t, rgb, a);
        p_line(x + r * 0.08, y - r * 0.34, x - r * 0.3, y - r * 0.12, t, rgb, a);
        p_line(x - r * 0.3, y - r * 0.12, x - r * 0.5, y + r * 0.1, t, rgb, a);
        p_line(x - r * 0.12, y + r * 0.12, x + r * 0.3, y + r * 0.42, t, rgb, a);
        p_line(x + r * 0.3, y + r * 0.42, x + r * 0.18, y + r * 0.92, t, rgb, a);
        p_line(x - r * 0.12, y + r * 0.12, x - r * 0.35, y + r * 0.55, t, rgb, a);
        p_line(x - r * 0.35, y + r * 0.55, x - r * 0.8, y + r * 0.5, t, rgb, a)
    }
    if (id == I_WALK) {
        // A walker, upright, a short stride.
        p_disc(x + r * 0.08, y - r * 0.8, r * 0.2, rgb, a);
        p_line(x + r * 0.02, y - r * 0.45, x - r * 0.05, y + r * 0.15, t, rgb, a);
        p_line(x + r * 0.0, y - r * 0.36, x + r * 0.28, y - r * 0.02, t, rgb, a);
        p_line(x + r * 0.0, y - r * 0.36, x - r * 0.25, y - r * 0.02, t, rgb, a);
        p_line(x - r * 0.05, y + r * 0.15, x + r * 0.3, y + r * 0.9, t, rgb, a);
        p_line(x - r * 0.05, y + r * 0.15, x - r * 0.28, y + r * 0.55, t, rgb, a);
        p_line(x - r * 0.28, y + r * 0.55, x - r * 0.38, y + r * 0.9, t, rgb, a)
    }
    if (id == I_RIDE) {
        // A bicycle: its wheels, and its frame between them.
        wr: f32 = r * 0.42;
        bx: f32 = x - r * 0.55;
        fx: f32 = x + r * 0.55;
        hy: f32 = y + r * 0.3;
        p_ring(bx, hy, wr, t * 0.85, rgb, a);
        p_ring(fx, hy, wr, t * 0.85, rgb, a);
        cx: f32 = x - r * 0.05;
        sx: f32 = x - r * 0.25;
        sy: f32 = y - r * 0.3;
        hx: f32 = x + r * 0.35;
        p_line(bx, hy, cx, hy, t * 0.85, rgb, a);
        p_line(cx, hy, sx, sy, t * 0.85, rgb, a);
        p_line(sx, sy, bx, hy, t * 0.85, rgb, a);
        p_line(sx, sy, hx, sy, t * 0.85, rgb, a);
        p_line(hx, sy, cx, hy, t * 0.85, rgb, a);
        p_line(hx, sy, fx, hy, t * 0.85, rgb, a);
        p_line(hx, sy, hx - r * 0.08, sy - r * 0.3, t * 0.85, rgb, a);
        p_line(sx - r * 0.15, sy - r * 0.12, sx + r * 0.12, sy - r * 0.12, t, rgb,
            a)
    }
    if (id == I_PAUSE) {
        p_box(x - r * 0.62, y - r * 0.8, r * 0.42, r * 1.6, r * 0.12, rgb, a);
        p_box(x + r * 0.2, y - r * 0.8, r * 0.42, r * 1.6, r * 0.12, rgb, a)
    }
    if (id == I_PLAY) p_triangle(x - r * 0.55, y - r * 0.85, r * 1.5, r * 1.7, r * 0.18,
        rgb, a);
    if (id == I_STOP) p_box(x - r * 0.7, y - r * 0.7, r * 1.4, r * 1.4, r * 0.22,
        rgb, a);
    if (id == I_MEDAL) {
        // A medal on its ribbon.
        p_line(x - r * 0.5, y - r * 0.95, x - r * 0.12, y - r * 0.25, t * 0.8, rgb,
            a * 0.7);
        p_line(x + r * 0.5, y - r * 0.95, x + r * 0.12, y - r * 0.25, t * 0.8, rgb,
            a * 0.7);
        p_disc(x, y + r * 0.3, r * 0.72, rgb, a);
        p_ring(x, y + r * 0.3, r * 0.42, t * 0.6, C_WHITE, a * 0.75)
    }
    if (id == I_SHIELD) {
        // A shield: what is not kept.
        p_line(x - r * 0.75, y - r * 0.6, x, y - r * 0.9, t, rgb, a);
        p_line(x, y - r * 0.9, x + r * 0.75, y - r * 0.6, t, rgb, a);
        p_line(x - r * 0.75, y - r * 0.6, x - r * 0.7, y + r * 0.05, t, rgb, a);
        p_line(x + r * 0.75, y - r * 0.6, x + r * 0.7, y + r * 0.05, t, rgb, a);
        p_line(x - r * 0.7, y + r * 0.05, x, y + r * 0.95, t, rgb, a);
        p_line(x + r * 0.7, y + r * 0.05, x, y + r * 0.95, t, rgb, a)
    }
    if (id == I_FRIENDS) {
        // Two heads and shoulders, the one behind smaller, up and to the
        // right.
        bx: f32 = x + r * 0.42;
        by: f32 = y - r * 0.22;
        p_ring(bx, by - r * 0.3, r * 0.3, t * 0.9, rgb, a);
        p_arc(bx, by + r * 0.72, r * 0.56, t * 0.9, 4.25, 1.87, rgb, a);
        fx: f32 = x - r * 0.22;
        p_ring(fx, y - r * 0.3, r * 0.38, t, rgb, a);
        p_arc(fx, y + r * 0.98, r * 0.72, t, 3.3, 2.82, rgb, a)
    }
    if (id == I_CLOCK) {
        p_ring(x, y, r, t * 0.85, rgb, a);
        p_line(x, y, x, y - r * 0.55, t * 0.85, rgb, a);
        p_line(x, y, x + r * 0.4, y + r * 0.2, t * 0.85, rgb, a)
    }
}

// A pill button with words: a filled one, or (fill < 0) one outlined in
// the ink. Pressed, it gives a little.
pill(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    t: str,
    size: f32,
    fill: int,
    ink: int,
    a: f32
) {
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.04 * pr;
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    if (fill >= 0) p_box(cx - w * k * 0.5, cy - h * k * 0.5, w * k, h * k, h * k * 0.5,
        mix_rgb(fill, C_SHADOW, 0.15 * pr), a) else p_outline(cx - w * k * 0.5, cy - h * k * 0.5,
        w * k, h * k, h * k * 0.5, 1.5, ink, a * (0.45 + 0.3 * pr));
    p_str_mid(1, size * k, cx, cy + size * 0.36 * k, t, ink, a);
    add_button(id, x, y, x + w, y + h)
}

// The same for a request: faint, and not to be tapped, until it can be
// (ready); while its request is out, "…" in place of its words.
pill_ask(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    t: str,
    size: f32,
    fill: int,
    ink: int,
    ready: bool
) {
    if (ready && !people_waiting(id)) {
        pill(id, x, y, w, h, t, size, fill, ink, 1.0);
        return
    }
    a: f32 = 0.35;
    if (people_waiting(id)) a = 0.6;
    cx: f32 = x + w * 0.5;
    if (fill >= 0) p_box(x, y, w, h, h * 0.5, fill, a) else p_outline(x, y, w, h,
        h * 0.5, 1.5, ink, a * 0.45);
    if (people_waiting(id)) {
        line_clear();
        line_ellipsis();
        tw: f32 = line_w(1, size);
        p_put(1, size, cx - tw * 0.5, y + h * 0.5 + size * 0.36, line, 0, line_n,
            ink, a)
    } else p_str_mid(1, size, cx, y + h * 0.5 + size * 0.36, t, ink, a)
}
