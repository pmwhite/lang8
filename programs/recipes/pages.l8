tag recipes;

use_tag std, skate;

// The pages: the kitchen, the recipes, and today, side by side (a finger
// slides between them), with the bar of tabs over them; and a recipe's
// own page over all of it. Each page is a list that scrolls, its title at
// its top; once the title has scrolled away, a bar at the top keeps it.
//
// Everything is laid out as it is drawn, each frame. Things that move
// (the recipes as their order changes, a food's chip as it is tapped)
// ease from where they were drawn last.
//
// The column the pages' things are in.
col_x: f32 = 0.0;

col_w: f32 = 360.0;

layout() {
    w: f32 = view_w() - safe_left - safe_right;
    col_w = minf(w - 36.0, 640.0);
    col_x = safe_left + (w - col_w) * 0.5
}

// Room left at a list's end, for the bar over it.
end_room(): f32 {
    safe_bottom + 120.0
}

// ---- writing ----
// The line, broken to fit w, from its baseline at y, lh apart: how many
// lines it took.
write_wrapped(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    lh: f32,
    rgb: int,
    a: f32
): int {
    wrap(face, size, line, 0, line_n, w);
    for i in 0..wrap_n p_put(face, size, x, y + i as f32 * lh, line, wrap_from[i],
        wrap_to[i], rgb, a);
    wrap_n
}

// The line, made smaller if it must be to fit w.
write_fit(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    rgb: int,
    a: f32
) {
    s: f32 = size;
    tw: f32 = p_text_w(face, s, line, 0, line_n);
    if (tw > w) s = s * w / tw;
    p_put(face, s, x, y, line, 0, line_n, rgb, a)
}

// Written so that it ends at x.
write_right(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    rgb: int,
    a: f32
) {
    tw: f32 = p_text_w(face, size, line, 0, line_n);
    p_text(face, size, x - tw, y, line, 0, line_n, 0.0, rgb, a)
}

// A page's big title, and its line under (from line): where the page
// goes on.
page_title(x: f32, y: f32, t: str): f32 {
    p_say(1, 34.0, x, y + 34.0, t, C_INK, 1.0);
    n: int = write_wrapped(0, 16.5, x, y + 62.0, col_w, 22.0, C_MUTED, 1.0);
    y + 62.0 + (n - 1) as f32 * 22.0 + 14.0
}

// The same, its title the name k.
page_title_name(x: f32, y: f32, k: int): f32 {
    title_from_name(k);
    p_put(1, 34.0, x, y + 34.0, title_bytes, 0, title_n, C_INK, 1.0);
    n: int = write_wrapped(0, 16.5, x, y + 62.0, col_w, 22.0, C_MUTED, 1.0);
    y + 62.0 + (n - 1) as f32 * 22.0 + 14.0
}

// A pill with the line's words in it, picked out if on (dark), its left
// at x: how wide it is.
const PICK_H: f32 = 36.0;

pick_w(size: f32): f32 {
    p_text_w(1, size, line, 0, line_n) + 30.0
}

pick(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    on: bool,
    size: f32
) {
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.05 * pr;
    fill: int = C_SUNK;
    ink: int = C_INK;
    if (on) {
        fill = C_INK;
        ink = C_BG
    }
    cx: f32 = x + w * 0.5;
    cy: f32 = y + PICK_H * 0.5;
    p_box(cx - w * k * 0.5, cy - PICK_H * k * 0.5, w * k, PICK_H * k, PICK_H * k * 0.5,
        mix_rgb(fill, C_INK, 0.12 * pr), 1.0);
    tw: f32 = p_text_w(1, size * k, line, 0, line_n);
    p_put(1, size * k, cx - tw * 0.5, cy + size * 0.36 * k, line, 0, line_n, ink,
        1.0);
    add_button(id, x, y, x + w, y + PICK_H)
}

switch_w(t: str): f32 {
    p_str_w(1, 14.0, t) + 46.0
}

// A switch for how a place's lists go: a pill with a check if on.
switch_pill(
    id: int,
    x: f32,
    y: f32,
    t: str,
    on: bool
): f32 {
    size: f32 = 14.0;
    w: f32 = switch_w(t);
    pr: f32 = pressed(id);
    fill: int = C_BG;
    ink: int = C_MUTED;
    if (on) {
        fill = C_GREEN_SOFT;
        ink = C_GREEN
    }
    p_box(x, y, w, 32.0, 16.0, mix_rgb(fill, C_INK, 0.1 * pr), 1.0);
    if (!on) p_outline(x, y, w, 32.0, 16.0, 1.0, C_LINE, 1.0);
    if (on) draw_icon(I_CHECK, x + 18.0, y + 16.0, 5.5, C_GREEN, 1.0) else p_ring(x + 18.0,
        y + 16.0, 5.0, 1.4, C_FAINT, 1.0);
    p_say(1, size, x + 32.0, y + 21.0, t, ink, 1.0);
    add_button(id, x, y, x + w, y + 32.0);
    w
}

// Where here is: the places (and one to add, and the place's set-up),
// then, as the place's lists go, its meals and the days; then, being set
// up, how its lists go and the meals it has. Where the page goes on.
draw_where(x: f32, y0: f32): f32 {
    y: f32 = y0;
    cx: f32 = x;
    for l in 0..loc_n + 2 {
        line_clear();
        if (l < loc_n) line_name(loc_name[l]);
        if (l == loc_n) line_add("+ Place");
        if (l > loc_n) line_add("Set up");
        w: f32 = pick_w(15.0);
        if (cx + w > x + col_w && cx > x) {
            cx = x;
            y = y + PICK_H + 8.0
        }
        if (l < loc_n) pick(B_PLACE + l, cx, y, w, l == here_loc, 15.0);
        if (l == loc_n) pick(B_ADD_PLACE, cx, y, w, naming, 15.0);
        if (l > loc_n) pick(B_SET_UP, cx, y, w, setting_up, 15.0);
        cx = cx + w + 8.0
    }
    y = y + PICK_H + 10.0;
    if (naming) {
        draw_field(2, x, y, col_w - 86.0, 44.0, "Name it", B_FIELD + 2, B_CLEAR + 2);
        line_clear();
        line_add("Add");
        pick(B_NAME_DONE, x + col_w - 76.0, y + 4.0, 76.0, true, 15.0);
        y = y + 54.0
    }
    l2: int = here_loc;
    if (loc_by_meal[l2]) {
        // (Its meals, each as wide as its word, filling the row.)
        total: f32 = 0.0;
        nm: int = 0;
        for m in 0..MEALS {
            if (has_meal(l2, m)) {
                total = total + p_str_w(1, 14.5, meal_title[m]) + 24.0;
                nm = nm + 1
            }
        }
        extra: f32 = maxf((col_w - 6.0 * (nm - 1) as f32 - total) / maxi(nm, 1) as f32,
            0.0);
        mx: f32 = x;
        for m in 0..MEALS {
            if (has_meal(l2, m)) {
                line_clear();
                line_add(meal_title[m]);
                w2: f32 = p_text_w(1, 14.5, line, 0, line_n) + 24.0 + extra;
                pick(B_HERE_MEAL + m, mx, y, w2, m == here_meal, 14.5);
                mx = mx + w2 + 6.0
            }
        }
        y = y + PICK_H + 8.0
    }
    if (loc_by_day[l2]) {
        dw: f32 = (col_w - 5.0 * (DAYS - 1) as f32) / DAYS as f32;
        for d in 0..DAYS {
            line_clear();
            line_add(day_short[d]);
            dx: f32 = x + d as f32 * (dw + 5.0);
            pick(B_HERE_DAY + d, dx, y, dw, d == here_day, 14.0);
            // (Today's has a dot over it.)
            if (d == weekday(today)) p_disc(dx + dw * 0.5, y - 4.0, 2.5, C_GREEN,
                1.0)
        }
        y = y + PICK_H + 8.0
    }
    if (!setting_up) return y + 14.0;
    y = y + 4.0;
    sx: f32 = x;
    sx = sx + switch_pill(B_SPLIT_MEAL, sx, y, "By meal", loc_by_meal[l2]) + 8.0;
    sx = sx + switch_pill(B_SPLIT_DAY, sx, y, "By day", loc_by_day[l2]) + 8.0;
    if (loc_n > 1) {
        id: int = B_REMOVE_PLACE;
        word: str = "Remove";
        if (now_t - remove_asked_t < 3.0) {
            word = "Remove it?";
            busy = true
        }
        tw: f32 = p_str_w(1, 14.0, word);
        if (sx + tw < x + col_w) {
            p_say(1, 14.0, x + col_w - tw, y + 21.0, word, mix_rgb(C_TOMATO, C_INK,
                pressed(id) * 0.5), 1.0);
            add_button(id, x + col_w - tw - 12.0, y - 4.0, x + col_w + 8.0, y + 36.0)
        }
    }
    y = y + 42.0;
    if (loc_by_meal[l2]) {
        p_say(1, 14.0, x, y + 21.0, "Has", C_MUTED, 1.0);
        hx: f32 = x + 38.0;
        for m in 0..MEALS {
            hw: f32 = switch_w(meal_title[m]);
            if (hx + hw > x + col_w) {
                hx = x + 38.0;
                y = y + 40.0
            }
            hw = switch_pill(B_HAS_MEAL + m, hx, y, meal_title[m], has_meal(l2, m));
            hx = hx + hw + 6.0
        }
        y = y + 42.0
    }
    y + 12.0
}

// The bar at a page's top, once its title has scrolled away.
top_bar(
    ox: f32,
    scroll: f32,
    from: f32,
    t: []i8,
    tn: int
) {
    a: f32 = clampf((scroll - from) / 24.0, 0.0, 1.0);
    if (a <= 0.0) return;
    w: f32 = view_w();
    h: f32 = safe_top + 50.0;
    p_box(ox, 0.0, w, h, 0.0, C_BG, 0.97 * a);
    p_box(ox, h - 1.0, w, 1.0, 0.0, C_LINE, a);
    size: f32 = 17.0;
    tw: f32 = minf(p_text_w(1, size, t, 0, tn), w - 120.0);
    if (p_text_w(1, size, t, 0, tn) > tw) size = size * tw / p_text_w(1, size, t,
        0, tn);
    p_text(1, size, ox + (w - tw) * 0.5, safe_top + 31.0, t, 0, tn, 0.0, C_INK, a)
}

title_bytes: []i8 = new i8[256](0i8);

title_n: int = 0;

title_from_str(t: str) {
    title_n = mini(len(t), len(title_bytes));
    for i in 0..title_n title_bytes[i] = t[i]
}

title_from_name(k: int) {
    title_n = mini(name_len[k], len(title_bytes));
    for i in 0..title_n title_bytes[i] = name_bytes[name_start[k] + i]
}

// A section's heading, with a count at its right (if n >= 0).
heading(
    x: f32,
    y: f32,
    w: f32,
    t: str,
    n: int,
    a: f32
) {
    p_str(1, 19.0, x, y + 19.0, t, C_INK, a);
    if (n >= 0) {
        line_clear();
        line_int(n);
        write_right(1, 15.0, x + w, y + 19.0, C_FAINT, a)
    }
}

// ---- the kitchen ----
chip_w(f: int): f32 {
    line_clear();
    line_name(fd_name[f]);
    p_text_w(0, 16.0, line, 0, line_n) + 50.0
}

const CHIP_H: f32 = 40.0;

draw_chip(f: int, x: f32, y: f32) {
    w: f32 = chip_w(f);
    chip_show[f] = ease_to(chip_show[f], fd_state[f] as f32, 16.0);
    s: f32 = chip_show[f];
    have: f32 = clampf(s, 0.0, 1.0);
    use: f32 = clampf(s - 1.0, 0.0, 1.0);
    pop: f32 = chip_pop[f];
    if (pop > 0.0) {
        chip_pop[f] = maxf(pop - frame_dt * 3.5, 0.0);
        busy = true
    }
    id: int = B_FOOD + f;
    k: f32 = (1.0 + 0.07 * sinf(pop * PI) * pop) * (1.0 - 0.05 * pressed(id));
    cx: f32 = x + w * 0.5;
    cy: f32 = y + CHIP_H * 0.5;
    bw: f32 = w * k;
    bh: f32 = CHIP_H * k;
    bx: f32 = cx - bw * 0.5;
    by: f32 = cy - bh * 0.5;
    on: int = mix_rgb(C_GREEN, C_AMBER, use);
    p_box(bx, by, bw, bh, bh * 0.5, mix_rgb(C_CARD, on, have), 1.0);
    p_outline(bx, by, bw, bh, bh * 0.5, 1.0, C_LINE, 1.0 - have);
    ix: f32 = bx + 20.0 * k;
    p_disc(ix, cy, 5.5 * k, fd_rgb[f], 1.0 - have);
    p_ring(ix, cy, 5.5 * k, 1.0, mix_rgb(fd_rgb[f], C_SHADOW, 0.2), 0.4 * (1.0 - have));
    if (use > 0.5) draw_icon(I_CLOCK, ix, cy, 6.5 * k, C_WHITE, have) else draw_icon(I_CHECK,
        ix, cy, 6.0 * k, C_WHITE, have);
    line_clear();
    line_name(fd_name[f]);
    p_text(0, 16.0 * k, bx + 36.0 * k, cy + 5.8 * k, line, 0, line_n, 0.0, mix_rgb(C_INK,
        C_WHITE, have), 1.0);
    add_button(id, x, y, x + w, y + CHIP_H)
}

draw_kitchen(ox: f32) {
    v: int = V_KITCHEN;
    x: f32 = ox + col_x;
    y: f32 = safe_top + 16.0 - sc_pos[v];
    line_clear();
    line_add("Tap what there is here; tap twice for what to use up soon.");
    y = page_title_name(x, y, loc_name[here_loc]);
    y = draw_where(x, y);
    draw_field(0, x, y, col_w, 48.0, "Find a food", B_FIELD, B_CLEAR);
    y = y + 64.0;
    // What there is, and a way to empty the list.
    line_clear();
    if (kitchen_have == 0) {
        line_add("Nothing noted for ");
        if (loc_by_day[here_loc] || loc_by_meal[here_loc]) {
            line_here();
            line_add(" yet")
        } else {
            line_name(loc_name[here_loc]);
            line_add(" yet")
        }
    } else {
        line_int(kitchen_have);
        line_add(" here");
        if (kitchen_use > 0) {
            line_add(", ");
            line_int(kitchen_use);
            line_add(" to use up")
        }
    }
    write_fit(0, 15.0, x, y + 15.0, col_w - 70.0, C_MUTED, 1.0);
    if (kitchen_have > 0) {
        // (Asked again first.)
        id: int = B_EMPTY_KITCHEN;
        word: str = "Empty";
        if (now_t - empty_asked_t < 3.0) {
            word = "Empty it all?";
            busy = true
        }
        tw: f32 = p_str_w(1, 15.0, word);
        p_str(1, 15.0, x + col_w - tw, y + 15.0, word, mix_rgb(C_TOMATO, C_INK, pressed(id) * 0.5),
            1.0);
        add_button(id, x + col_w - tw - 14.0, y - 10.0, x + col_w + 8.0, y + 26.0)
    }
    y = y + 40.0;
    // An empty list: it can start from another of the place's.
    from: int = -1;
    if (kitchen_have == 0) from = copy_source();
    if (from >= 0) {
        line_clear();
        line_add("Copy ");
        if (slot_day(from) >= 0) {
            line_add(weekday_title[slot_day(from)]);
            if (slot_meal(from) >= 0) line_add("'s ") else line_add("'s list")
        }
        if (slot_meal(from) >= 0) {
            if (slot_day(from) >= 0) line_add_lower(meal_title[slot_meal(from)]) else line_add(meal_title[slot_meal(from)]);
            if (slot_day(from) < 0) line_add("'s list")
        }
        if (slot_day(from) < 0 && slot_meal(from) < 0) line_add("its list");
        w: f32 = pick_w(15.0);
        pick(B_COPY, x, y - 6.0, w, true, 15.0);
        line_clear();
        line_add("to start from");
        p_put(0, 15.0, x + w + 10.0, y + 18.0, line, 0, line_n, C_MUTED, 1.0);
        y = y + 50.0
    }
    q: []i8 = field_text(0);
    qn: int = fq_n[0];
    shown: int = 0;
    for g in 0..GROUPS {
        n: int = 0;
        for f in 0..fd_n {
            if (fd_group[f] == g && name_has(fd_name[f], q, 0, qn)) n = n + 1
        }
        if (n > 0) {
            p_str(1, 15.0, x, y + 15.0, group_title[g], C_MUTED, 1.0);
            y = y + 26.0;
            cx: f32 = x;
            for f in 0..fd_n {
                if (fd_group[f] == g && name_has(fd_name[f], q, 0, qn)) {
                    w: f32 = chip_w(f);
                    if (cx + w > x + col_w + 0.5 && cx > x) {
                        cx = x;
                        y = y + CHIP_H + 8.0
                    }
                    // (Off the screen: only its place counts.)
                    if (y + CHIP_H > -10.0 && y < view_h() + 10.0) draw_chip(f, cx,
                        y) else {
                        chip_show[f] = fd_state[f] as f32;
                        chip_pop[f] = 0.0
                    }
                    cx = cx + w + 8.0
                }
            }
            y = y + CHIP_H + 26.0;
            shown = shown + n
        }
    }
    if (shown == 0) {
        line_clear();
        if (fd_n == 0) line_add("No foods in the book yet: they are added to it as they come up.") else {
            line_add("No food called \"");
            for i in 0..qn line_byte(q[i] as int);
            line_add("\" in the book.")
        }
        n2: int = write_wrapped(0, 16.0, x, y + 16.0, col_w, 22.0, C_MUTED, 1.0);
        y = y + n2 as f32 * 22.0 + 20.0
    }
    // How it is kept.
    y = y + 6.0;
    line_clear();
    dot: int = C_FAINT;
    if (sync_state == 0) line_add("Kept on this device only. Open your personal link to keep it safe.");
    if (sync_state == 1) {
        line_add("Saved to your link");
        dot = C_GREEN
    }
    if (sync_state == 2) {
        line_add("Saving...");
        dot = C_AMBER
    }
    if (sync_state == 3) {
        line_add("Offline: kept here, and saved when it can be");
        dot = C_AMBER
    }
    if (sync_state == 4) {
        line_add("This link is not one the book knows: kept on this device only");
        dot = C_TOMATO
    }
    p_disc(x + 4.0, y + 9.0, 4.0, dot, 1.0);
    nk: int = write_wrapped(0, 14.0, x + 16.0, y + 14.0, col_w - 16.0, 19.0, C_FAINT,
        1.0);
    y = y + nk as f32 * 19.0 + 10.0;
    sc_most[v] = y + sc_pos[v] + end_room() - view_h();
    title_from_name(loc_name[here_loc]);
    top_bar(ox, sc_pos[v], 40.0, title_bytes, title_n)
}

// ---- the recipes ----
// Where each recipe's card is drawn in the list (eased), how much it
// shows, and whether it was in the list the frame before.
rc_y: []f32 = new f32[RECIPES](0.0);

rc_a: []f32 = new f32[RECIPES](0.0);

rc_was: []bool = new bool[RECIPES](false);

rc_in: []bool = new bool[RECIPES](false);

const SECTIONS: int = 4;

sec_y: []f32 = new f32[SECTIONS](0.0);

sec_a: []f32 = new f32[SECTIONS](0.0);

sec_was: []bool = new bool[SECTIONS](false);

sec_in: []bool = new bool[SECTIONS](false);

sec_count: []int = new int[SECTIONS](0);

sec_title: []str = ["Ready to cook", "A thing or two short", "Needs a shop", "All recipes"];

const CARD_PLATE: f32 = 104.0;

// The text's room on a card w wide, and the card's height.
card_text_w(w: f32): f32 {
    w - CARD_PLATE - 48.0
}

card_h(r: int, w: f32): f32 {
    line_clear();
    line_name(rc_name[r]);
    wrap(1, 18.0, line, 0, line_n, card_text_w(w));
    h: f32 = 24.0 + mini(wrap_n, 2) as f32 * 23.0 + 50.0;
    if (rc_uses[r] > 0 && rc_section[r] != SEC_ALL) h = h + 22.0;
    maxf(h, CARD_PLATE + 20.0)
}

// The names of recipe r's foods that are missing from the kitchen (want
// 0), or that are to be used up (want 2), as many as fit in w.
line_foods(
    r: int,
    want: int,
    w: f32,
    size: f32
) {
    start: int = line_n;
    n: int = 0;
    total: int = 0;
    for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
        f: int = ln_food[l];
        hit: bool = false;
        if (want == ST_NONE) hit = ln_kind[l] == LN_USE && fd_state[f] == ST_NONE;
        if (want == ST_USE) hit = f >= 0 && fd_state[f] == ST_USE;
        if (hit) total = total + 1
    }
    for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
        f: int = ln_food[l];
        hit: bool = false;
        if (want == ST_NONE) hit = ln_kind[l] == LN_USE && fd_state[f] == ST_NONE;
        if (want == ST_USE) hit = f >= 0 && fd_state[f] == ST_USE;
        if (hit) {
            back: int = line_n;
            if (n > 0) {
                if (n == total - 1) line_add(" and ") else line_add(", ")
            }
            line_name_lower(fd_name[f]);
            // (What does not fit is counted instead.)
            if (n > 0 && p_text_w(0, size, line, start, line_n) > w - 60.0 && n < total) {
                line_n = back;
                line_add(" and ");
                line_int(total - n);
                line_add(" more");
                return
            }
            n = n + 1
        }
    }
}

draw_card(
    r: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    a: f32
) {
    id: int = B_RECIPE + r;
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.025 * pr;
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    bw: f32 = w * k;
    bh: f32 = h * k;
    bx: f32 = cx - bw * 0.5;
    by: f32 = cy - bh * 0.5;
    p_shadow(bx, by, bw, bh, 20.0, 3.0, 10.0, 0.07 * a);
    p_box(bx, by, bw, bh, 20.0, C_CARD, a);
    draw_plate(r, bx + 14.0 + CARD_PLATE * 0.5, cy, CARD_PLATE * 0.5 * k, a);
    tx: f32 = bx + CARD_PLATE + 28.0;
    tw: f32 = card_text_w(w);
    line_clear();
    line_name(rc_name[r]);
    wrap(1, 18.0, line, 0, line_n, tw);
    n: int = mini(wrap_n, 2);
    ty: f32 = by + 34.0;
    for i in 0..n p_text(1, 18.0 * k, tx, ty + i as f32 * 23.0, line, wrap_from[i],
        wrap_to[i], 0.0, C_INK, a);
    ty = ty + (n - 1) as f32 * 23.0 + 24.0;
    // How long, and what a serving gives.
    line_clear();
    line_int(rc_minutes[r]);
    line_add(" min");
    line_dot();
    line_count((rc_nut[r * NUTS + N_KCAL] + 0.5) as int);
    line_add(" kcal");
    line_dot();
    line_int((rc_nut[r * NUTS + N_PROTEIN] + 0.5) as int);
    line_add(" g protein");
    write_fit(0, 14.5, tx, ty, tw, C_MUTED, a);
    ty = ty + 24.0;
    // What the kitchen has for it.
    size: f32 = 14.5;
    if (rc_section[r] == SEC_ALL) {
        line_clear();
        line_int(rc_needed[r]);
        line_add(" ingredients");
        write_fit(0, size, tx, ty, tw, C_MUTED, a)
    } else if (rc_missing(r) == 0) {
        draw_mark(1.0, tx + 7.0, ty - 5.0, 7.5, a);
        line_clear();
        line_add("You have everything");
        write_fit(1, size, tx + 20.0, ty, tw - 20.0, C_GREEN, a)
    } else {
        p_ring(tx + 7.0, ty - 5.0, 6.5, 1.6, C_TOMATO, a);
        line_clear();
        line_add("Missing ");
        line_foods(r, ST_NONE, tw - 20.0, size);
        write_fit(0, size, tx + 20.0, ty, tw - 20.0, C_TOMATO, a)
    }
    if (rc_uses[r] > 0 && rc_section[r] != SEC_ALL) {
        ty = ty + 22.0;
        draw_icon(I_CLOCK, tx + 7.0, ty - 5.0, 6.5, C_AMBER, a);
        line_clear();
        line_add("Uses up ");
        line_foods(r, ST_USE, tw - 20.0, size);
        write_fit(0, size, tx + 20.0, ty, tw - 20.0, C_AMBER, a)
    }
    add_button(id, x, y, x + w, y + h)
}

// The meals to pick from, as a row of pills.
meal_row(x: f32, y: f32) {
    size: f32 = 15.0;
    total: f32 = 0.0;
    for m in 0..MEALS + 1 total = total + meal_word_w(m, size) + 30.0;
    gap: f32 = 8.0;
    total = total + gap * MEALS as f32;
    if (total > col_w) size = size * (col_w - gap * MEALS as f32) / (total - gap * MEALS as f32);
    cx: f32 = x;
    for m in 0..MEALS + 1 {
        w: f32 = meal_word_w(m, size) + 30.0 * size / 15.0;
        id: int = B_MEAL + m;
        on: bool = meal_pick == m - 1;
        fill: int = C_SUNK;
        ink: int = C_INK;
        if (on) {
            fill = C_INK;
            ink = C_BG
        }
        if (m == 0) pill(id, cx, y, w, 36.0, "All", size, fill, ink, 1.0) else pill(id,
            cx, y, w, 36.0, meal_title[m - 1], size, fill, ink, 1.0);
        cx = cx + w + gap
    }
}

meal_word_w(m: int, size: f32): f32 {
    if (m == 0) return p_str_w(1, size, "All");
    p_str_w(1, size, meal_title[m - 1])
}

draw_recipes(ox: f32) {
    v: int = V_RECIPES;
    x: f32 = ox + col_x;
    y: f32 = safe_top + 16.0 - sc_pos[v];
    line_clear();
    if (kitchen_have == 0) line_add("Say what there is where you are, and these line up by what you can make.") else if (kitchen_use > 0) {
        line_add("Using up ");
        n: int = 0;
        for f in 0..fd_n {
            if (fd_state[f] == ST_USE) {
                if (n > 0) {
                    if (n == kitchen_use - 1) line_add(" and ") else line_add(", ")
                }
                line_name_lower(fd_name[f]);
                n = n + 1
            }
        }
        line_add(" first.")
    } else line_add("Ranked by what there is where you are.");
    y = page_title(x, y, "Recipes");
    // Where that is (a tap goes to it).
    line_clear();
    line_here();
    id: int = B_GO_KITCHEN;
    pw: f32 = minf(p_text_w(1, 15.0, line, 0, line_n) + 58.0, col_w);
    pr: f32 = pressed(id);
    p_box(x, y - 2.0, pw, 38.0, 19.0, mix_rgb(C_GREEN_SOFT, C_GREEN, 0.15 * pr), 1.0);
    draw_icon(I_PIN, x + 19.0, y + 17.0, 7.5, C_GREEN, 1.0);
    write_fit(1, 15.0, x + 34.0, y + 22.5, pw - 58.0, C_GREEN, 1.0);
    draw_icon(I_NEXT, x + pw - 16.0, y + 17.0, 5.0, C_GREEN, 1.0);
    add_button(id, x, y - 2.0, x + pw, y + 36.0);
    y = y + 50.0;
    list_top_scroll = y + sc_pos[v] - safe_top - 12.0;
    draw_field(1, x, y, col_w, 48.0, "Find a recipe or a food", B_FIELD + 1, B_CLEAR + 1);
    y = y + 62.0;
    meal_row(x, y);
    y = y + 56.0;
    // The list: its parts' headings, and the cards, where they go.
    top: f32 = y;
    for s in 0..SECTIONS {
        sec_in[s] = false;
        sec_count[s] = 0
    }
    for i in 0..rank_n sec_count[rc_section[rank[i]]] = sec_count[rc_section[rank[i]]] + 1;
    for r in 0..rc_n rc_in[r] = false;
    ly: f32 = 0.0;
    sec: int = -1;
    for i in 0..rank_n {
        r: int = rank[i];
        if (rc_section[r] != sec) {
            sec = rc_section[r];
            if (i > 0) ly = ly + 14.0;
            sec_in[sec] = true;
            if (!sec_was[sec]) sec_y[sec] = ly;
            sec_y[sec] = ease_to(sec_y[sec], ly, 14.0);
            sec_a[sec] = ease_to(sec_a[sec], 1.0, 10.0);
            ly = ly + 38.0
        }
        h: f32 = card_h(r, col_w);
        rc_in[r] = true;
        if (!rc_was[r]) {
            rc_y[r] = ly;
            rc_a[r] = 0.0
        }
        rc_y[r] = ease_to(rc_y[r], ly, 14.0);
        rc_a[r] = ease_to(rc_a[r], 1.0, 10.0);
        ly = ly + h + 12.0
    }
    // (Drawn: what is leaving fades where it was.)
    for s in 0..SECTIONS {
        if (!sec_in[s]) sec_a[s] = ease_to(sec_a[s], 0.0, 14.0);
        sec_was[s] = sec_in[s];
        if (sec_a[s] > 0.0) heading(x, top + sec_y[s], col_w, sec_title[s], sec_count[s],
            sec_a[s])
    }
    for r in 0..rc_n {
        if (!rc_in[r]) rc_a[r] = ease_to(rc_a[r], 0.0, 14.0);
        rc_was[r] = rc_in[r];
        cy: f32 = top + rc_y[r];
        if (rc_a[r] > 0.0 && cy < view_h() + 10.0) {
            h2: f32 = card_h(r, col_w);
            if (cy + h2 > -10.0) {
                // (Coming in, it rises a little.)
                draw_card(r, x, cy + (1.0 - rc_a[r]) * 16.0, col_w, h2, rc_a[r])
            }
        }
    }
    if (rank_n == 0) {
        line_clear();
        if (rc_n == 0) line_add("No recipes in the book yet: they are added to it as they are asked for.") else line_add("No recipe has that. Try another word, or another meal.");
        n3: int = write_wrapped(0, 16.0, x, y + 18.0, col_w, 22.0, C_MUTED, 1.0);
        ly = n3 as f32 * 22.0 + 20.0
    }
    sc_most[v] = top + ly + sc_pos[v] + end_room() - view_h();
    title_from_str("Recipes");
    top_bar(ox, sc_pos[v], 40.0, title_bytes, title_n)
}

// ---- what is in a serving, or a day ----
// A card: the energy, the share of it from each of protein, carbs and
// fat, and the vitamins and minerals, each against its daily value.
// From nut[at] on; grown in as t goes from 0 to 1. Its height.
nut_t: f32 = 0.0;

nutrition_card(
    nut: []f32,
    at: int,
    x: f32,
    y: f32,
    w: f32,
    t: f32
): f32 {
    h: f32 = 166.0 + (NUTS - N_MICRO) as f32 * 40.0 + 14.0;
    p_shadow(x, y, w, h, 20.0, 3.0, 10.0, 0.06);
    p_box(x, y, w, h, 20.0, C_CARD, 1.0);
    ix: f32 = x + 20.0;
    iw: f32 = w - 40.0;
    kcal: f32 = nut[at + N_KCAL];
    line_clear();
    line_count((kcal * smoothstepf(0.0, 1.0, t) + 0.5) as int);
    end: f32 = p_text(1, 36.0, ix, y + 50.0, line, 0, line_n, 0.0, C_INK, 1.0);
    p_say(0, 16.0, end + 6.0, y + 50.0, "kcal", C_MUTED, 1.0);
    line_clear();
    line_int((kcal / nut_daily[N_KCAL] * 100.0 + 0.5) as int);
    line_add("% of a day");
    write_right(0, 14.5, ix + iw, y + 50.0, C_MUTED, 1.0);
    // The three, as shares of the energy (4 kcal to a gram, 9 for fat).
    p: f32 = nut[at + N_PROTEIN] * 4.0;
    c: f32 = nut[at + N_CARBS] * 4.0;
    f: f32 = nut[at + N_FAT] * 9.0;
    sum: f32 = maxf(p + c + f, 1.0);
    by: f32 = y + 68.0;
    p_box(ix, by, iw, 12.0, 6.0, C_SUNK, 1.0);
    bx: f32 = ix;
    for k in 0..3 {
        share: f32 = p / sum;
        rgb: int = C_PROTEIN;
        if (k == 1) {
            share = c / sum;
            rgb = C_CARBS
        }
        if (k == 2) {
            share = f / sum;
            rgb = C_FATS
        }
        sw: f32 = iw * share * t;
        if (sw > 1.0) p_box(bx, by, maxf(sw - 2.0, 1.0), 12.0, 6.0, rgb, 1.0);
        bx = bx + sw
    }
    // Each in grams, and fiber.
    cw: f32 = iw / 4.0;
    for k in 0..4 {
        n: int = N_PROTEIN;
        rgb2: int = C_PROTEIN;
        if (k == 1) {
            n = N_CARBS;
            rgb2 = C_CARBS
        }
        if (k == 2) {
            n = N_FAT;
            rgb2 = C_FATS
        }
        if (k == 3) {
            n = N_FIBER;
            rgb2 = C_MUTED
        }
        cx: f32 = ix + cw * k as f32;
        p_disc(cx + 5.0, by + 37.0, 4.5, rgb2, 1.0);
        line_clear();
        line_int((nut[at + n] + 0.5) as int);
        line_add(" g");
        p_put(1, 17.0, cx + 16.0, by + 43.0, line, 0, line_n, C_INK, 1.0);
        p_say(0, 13.5, cx + 16.0, by + 62.0, nut_title[n], C_MUTED, 1.0)
    }
    ry: f32 = y + 150.0;
    p_box(ix, ry, iw, 1.0, 0.0, C_LINE, 1.0);
    ry = ry + 16.0;
    for n2 in N_MICRO..NUTS {
        amount: f32 = nut[at + n2];
        pct: f32 = amount / nut_daily[n2];
        // (The rows grow in one after another.)
        rt: f32 = clampf(t * 1.6 - (n2 - N_MICRO) as f32 * 0.05, 0.0, 1.0);
        rt = smoothstepf(0.0, 1.0, rt);
        good: bool = pct >= 0.2;
        p_say(0, 15.0, ix, ry + 16.0, nut_title[n2], C_INK, 1.0);
        line_clear();
        if (amount >= 10.0) line_int((amount + 0.5) as int) else line_num(amount,
            1);
        line_byte(32);
        line_add(nut_unit[n2]);
        p_put(0, 13.5, ix + p_str_w(0, 15.0, nut_title[n2]) + 8.0, ry + 16.0, line,
            0, line_n, C_FAINT, 1.0);
        line_clear();
        line_int((pct * 100.0 + 0.5) as int);
        line_add("%");
        ink: int = C_MUTED;
        if (good) ink = C_GREEN;
        write_right(1, 14.5, ix + iw, ry + 16.0, ink, 1.0);
        p_box(ix, ry + 24.0, iw, 6.0, 3.0, C_SUNK, 1.0);
        fill: int = C_FAINT;
        if (good) fill = C_GREEN;
        fw: f32 = iw * minf(pct, 1.0) * rt;
        if (fw > 0.5) p_box(ix, ry + 24.0, maxf(fw, 6.0), 6.0, 3.0, fill, 1.0);
        ry = ry + 40.0
    }
    h
}

// ---- a recipe's page ----
draw_page(ox: f32) {
    r: int = page_r;
    if (r < 0) return;
    v: int = V_RECIPE;
    s: f32 = sc_pos[v];
    w: f32 = view_w();
    vh: f32 = view_h();
    // (Its left edge throws a shadow over what it slides over.)
    p_shadow(ox, 0.0, w + 40.0, vh, 0.0, 0.0, 24.0, 0.18 * page_t);
    p_box(ox, 0.0, w, vh, 0.0, C_BG, 1.0);
    p_clip(ox, 0.0, ox + w, vh);
    x: f32 = ox + col_x;
    // The picture: a band of the main food's color, its plate on it,
    // moving slower than the page (and bigger as it is pulled down).
    plate_foods(r);
    tint: int = C_SUNK;
    if (pl_n > 0) tint = mix_rgb(C_BG, fd_rgb[ln_food[pl_line[0]]], 0.22);
    band: f32 = safe_top + 250.0;
    p_box(ox, minf(-s, 0.0) - 2.0, w, band - s * 0.5 + maxf(-s, 0.0) * 0.5 + 2.0,
        0.0, tint, 1.0);
    big: f32 = minf(96.0, w * 0.25) * (1.0 + maxf(-s, 0.0) / 500.0);
    draw_plate(r, ox + w * 0.5, safe_top + 128.0 - s * 0.55, big, 1.0);
    y: f32 = band - s + 28.0;
    // Its name, and what it is.
    line_clear();
    line_name(rc_name[r]);
    n: int = write_wrapped(1, 30.0, x, y + 28.0, col_w, 36.0, C_INK, 1.0);
    y = y + 28.0 + (n - 1) as f32 * 36.0 + 12.0;
    if (rc_about[r] >= 0) {
        line_clear();
        line_name(rc_about[r]);
        n2: int = write_wrapped(0, 17.0, x, y + 18.0, col_w, 24.0, C_MUTED, 1.0);
        y = y + 18.0 + n2 as f32 * 24.0
    }
    y = y + 12.0;
    // How long, which meal, and how many servings (a stepper).
    line_clear();
    line_int(rc_minutes[r]);
    line_add(" min");
    tw: f32 = p_text_w(1, 15.0, line, 0, line_n);
    p_box(x, y, tw + 44.0, 36.0, 18.0, C_SUNK, 1.0);
    draw_icon(I_CLOCK, x + 19.0, y + 18.0, 7.0, C_MUTED, 1.0);
    p_text(1, 15.0, x + 32.0, y + 23.5, line, 0, line_n, 0.0, C_INK, 1.0);
    mx: f32 = x + tw + 52.0;
    mw: f32 = p_str_w(1, 15.0, meal_title[rc_meal[r]]) + 28.0;
    p_box(mx, y, mw, 36.0, 18.0, C_SUNK, 1.0);
    p_str(1, 15.0, mx + 14.0, y + 23.5, meal_title[rc_meal[r]], C_INK, 1.0);
    // (Under them, if there is not room beside.)
    if (mx + mw + 10.0 + stepper_w() > x + col_w) {
        y = y + 46.0;
        stepper(x + stepper_w(), y)
    } else stepper(x + col_w, y);
    y = y + 60.0;
    // The ingredients, and how many the kitchen has.
    heading(x, y, col_w, "Ingredients", -1, 1.0);
    line_clear();
    if (kitchen_have > 0) {
        line_int(rc_have[r]);
        line_add(" of ");
        line_int(rc_needed[r]);
        line_add(" in your kitchen")
    }
    write_right(0, 14.5, x + col_w, y + 19.0, C_MUTED, 1.0);
    y = y + 34.0;
    k: f32 = page_serves as f32 / rc_serves[r] as f32;
    y = ingredient_rows(r, LN_USE, x, y, k);
    if (rc_count(r, LN_EXTRA) > 0) {
        y = y + 10.0;
        p_str(1, 15.0, x, y + 15.0, "Good with", C_MUTED, 1.0);
        y = y + 26.0;
        y = ingredient_rows(r, LN_EXTRA, x, y, k)
    }
    y = ingredient_rows(r, LN_STAPLE, x, y, k);
    y = y + 26.0;
    // What a serving gives.
    heading(x, y, col_w, "Nutrition", -1, 1.0);
    line_clear();
    line_add("A serving, without the extras");
    write_right(0, 14.5, x + col_w, y + 19.0, C_MUTED, 1.0);
    y = y + 36.0;
    if (page_t > 0.6) nut_t = ease_to(nut_t, 1.0, 2.6);
    y = y + nutrition_card(rc_nut, r * NUTS, x, y, col_w, nut_t) + 30.0;
    // The method.
    heading(x, y, col_w, "Method", -1, 1.0);
    y = y + 40.0;
    k2: int = 1;
    for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
        if (ln_kind[l] == LN_STEP) {
            p_disc(x + 15.0, y + 12.0, 15.0, C_GREEN_SOFT, 1.0);
            line_clear();
            line_int(k2);
            p_text(1, 15.0, x + 15.0 - p_text_w(1, 15.0, line, 0, line_n) * 0.5, y + 17.5,
                line, 0, line_n, 0.0, C_GREEN, 1.0);
            line_clear();
            line_name(ln_text[l]);
            n4: int = write_wrapped(0, 17.0, x + 44.0, y + 18.0, col_w - 44.0, 25.0,
                C_INK, 1.0);
            y = y + maxf(n4 as f32 * 25.0, 30.0) + 18.0;
            k2 = k2 + 1
        }
    }
    sc_most[v] = y + s + 110.0 + safe_bottom - vh;
    // Kept in place over the list: the way back, the name once the
    // picture has gone, and the button to say a serving was eaten.
    title_from_name(rc_name[r]);
    top_bar(ox, s, band - safe_top - 60.0, title_bytes, title_n);
    back_button(ox + maxf(safe_left + 14.0, col_x - 64.0), safe_top + 6.0);
    ate_bar(ox);
    p_noclip()
}

// The servings, with a button either side, ending at x.
stepper_words() {
    line_clear();
    line_int(page_serves);
    if (page_serves == 1) line_add(" serving") else line_add(" servings")
}

stepper_w(): f32 {
    stepper_words();
    p_text_w(1, 15.0, line, 0, line_n) + 92.0
}

stepper(x: f32, y: f32) {
    w: f32 = stepper_w();
    stepper_words();
    x0: f32 = x - w;
    p_box(x0, y, w, 36.0, 18.0, C_SUNK, 1.0);
    p_text(1, 15.0, x0 + 46.0, y + 23.5, line, 0, line_n, 0.0, C_INK, 1.0);
    for k in 0..2 {
        id: int = B_LESS;
        cx: f32 = x0 + 18.0;
        if (k == 1) {
            id = B_MORE;
            cx = x - 18.0
        }
        enabled: bool = id == B_MORE || page_serves > 1;
        p_disc(cx, y + 18.0, 15.0 - 1.5 * pressed(id), C_CARD, 1.0);
        a: f32 = 1.0;
        if (!enabled) a = 0.3;
        if (id == B_LESS) draw_icon(I_MINUS, cx, y + 18.0, 6.5, C_INK, a) else draw_icon(I_PLUS,
            cx, y + 18.0, 6.5, C_INK, a);
        if (enabled) add_button(id, cx - 22.0, y - 6.0, cx + 22.0, y + 42.0)
    }
}

// The lines of one kind, each with what the kitchen has of its food (a
// tap says whether it is there): where the list goes on.
ingredient_rows(
    r: int,
    kind: int,
    x: f32,
    y: f32,
    k: f32
): f32 {
    yy: f32 = y;
    for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
        if (ln_kind[l] == kind) {
            line_clear();
            line_ingredient(l, k);
            tx: f32 = x + 40.0;
            wrap(0, 17.0, line, 0, line_n, col_w - 40.0);
            h: f32 = maxf(wrap_n as f32 * 24.0 + 20.0, 48.0);
            f: int = ln_food[l];
            if (f >= 0) {
                id: int = B_LINE + l;
                pr: f32 = pressed(id);
                if (pr > 0.0) p_box(x - 10.0, yy, col_w + 20.0, h, 14.0, C_SUNK, pr);
                chip_show[f] = ease_to(chip_show[f], fd_state[f] as f32, 16.0);
                a: f32 = 1.0;
                if (kind == LN_EXTRA) a = 0.75;
                draw_mark(chip_show[f], x + 13.0, yy + h * 0.5, 11.0, a);
                add_button(id, x - 10.0, yy, x + col_w + 10.0, yy + h)
            } else p_disc(x + 13.0, yy + h * 0.5, 3.0, C_FAINT, 1.0);
            ink: int = C_INK;
            if (kind == LN_STAPLE) ink = C_MUTED;
            ty: f32 = yy + h * 0.5 + 6.0 - (wrap_n - 1) as f32 * 12.0;
            for i in 0..wrap_n p_put(0, 17.0, tx, ty + i as f32 * 24.0, line, wrap_from[i],
                wrap_to[i], ink, 1.0);
            yy = yy + h;
            p_box(tx, yy - 0.5, col_w - 40.0, 1.0, 0.0, C_LINE, 0.7)
        }
    }
    yy
}

back_button(x: f32, y: f32) {
    id: int = B_BACK;
    pr: f32 = pressed(id);
    p_shadow(x, y, 40.0, 40.0, 20.0, 2.0, 8.0, 0.12);
    p_disc(x + 20.0, y + 20.0, 20.0 - 1.5 * pr, mix_rgb(C_CARD, C_SUNK, pr), 1.0);
    draw_icon(I_BACK, x + 19.0, y + 20.0, 8.0, C_INK, 1.0);
    add_button(id, x - 8.0, y - 8.0, x + 48.0, y + 48.0)
}

// The bar at the page's foot: a serving eaten (and, for a moment after,
// that it was added).
ate_bar(ox: f32) {
    w: f32 = view_w();
    vh: f32 = view_h();
    h: f32 = 56.0;
    bottom: f32 = vh - maxf(safe_bottom, 14.0) - 6.0;
    y: f32 = bottom - h;
    // (A fade behind it, so that the list goes under softly.)
    p_shape(ox - 40.0, y - 6.0, w + 80.0, vh - y + 40.0, 0.0, 22.0, 0.0, C_BG, 0.95);
    bw: f32 = minf(col_w, 420.0);
    bx: f32 = ox + (w - bw) * 0.5;
    id: int = B_ATE;
    pr: f32 = pressed(id);
    done: f32 = clampf(2.2 - (now_t - ate_t), 0.0, 1.0);
    if (now_t - ate_t < 2.3) busy = true;
    k: f32 = 1.0 - 0.04 * pr;
    cx: f32 = bx + bw * 0.5;
    cy: f32 = y + h * 0.5;
    p_shadow(cx - bw * k * 0.5, cy - h * k * 0.5, bw * k, h * k, h * 0.5, 4.0, 14.0,
        0.2);
    p_box(cx - bw * k * 0.5, cy - h * k * 0.5, bw * k, h * k, h * k * 0.5, mix_rgb(C_INK,
        C_GREEN, done), 1.0);
    if (done > 0.0) {
        tw: f32 = p_str_w(1, 17.0, "Added to today");
        draw_icon(I_CHECK, cx - tw * 0.5 - 8.0, cy, 7.0, C_WHITE, done);
        p_str(1, 17.0, cx - tw * 0.5 + 8.0, cy + 6.0, "Added to today", C_WHITE, done)
    }
    p_str_mid(1, 17.0, cx, cy + 6.0, "I ate a serving", C_BG, 1.0 - done);
    add_button(id, bx, y, bx + bw, y + h)
}

// ---- today ----
draw_today(ox: f32) {
    v: int = V_TODAY;
    x: f32 = ox + col_x;
    y: f32 = safe_top + 16.0 - sc_pos[v];
    line_clear();
    line_date(today);
    y = page_title(x, y, "Today");
    meals: int = add_up_day(today);
    t: f32 = 1.0;
    if (meals == 0) {
        // (Nothing yet: what to do.)
        p_box(x, y, col_w, 120.0, 20.0, C_CARD, 1.0);
        draw_icon(I_DAY, x + 36.0, y + 44.0, 16.0, C_FAINT, 1.0);
        p_str(1, 18.0, x + 66.0, y + 50.0, "Nothing eaten yet", C_INK, 1.0);
        line_clear();
        line_add("On a recipe's page, \"I ate a serving\" adds it here, with what it gave you.");
        n: int = write_wrapped(0, 15.0, x + 22.0, y + 82.0, col_w - 44.0, 20.0, C_MUTED,
            1.0);
        y = y + maxf(120.0, 72.0 + n as f32 * 20.0 + 14.0) + 26.0
    } else {
        y = y + nutrition_card(day_nut, 0, x, y, col_w, t) + 30.0;
        heading(x, y, col_w, "Meals", meals, 1.0);
        y = y + 40.0;
        i: int = lg_n - 1;
        while (i >= 0) {
            if (lg_day[i] == today) {
                y = log_row(i, x, y);
                y = y + 10.0
            }
            i = i - 1
        }
        y = y + 20.0
    }
    // The days before, each in a line.
    earlier: int = 0;
    d: int = today - 1;
    while (d >= today - 30 && earlier < 7) {
        n2: int = add_up_day(d);
        if (n2 > 0) {
            if (earlier == 0) {
                heading(x, y, col_w, "Earlier", -1, 1.0);
                y = y + 40.0
            }
            line_clear();
            line_date(d);
            p_text(1, 16.0, x, y + 16.0, line, 0, line_n, 0.0, C_INK, 1.0);
            line_clear();
            line_int(n2);
            if (n2 == 1) line_add(" meal, ") else line_add(" meals, ");
            line_count((day_nut[N_KCAL] + 0.5) as int);
            line_add(" kcal, ");
            line_int((day_nut[N_PROTEIN] + 0.5) as int);
            line_add(" g protein");
            p_text(0, 14.5, x, y + 36.0, line, 0, line_n, 0.0, C_MUTED, 1.0);
            y = y + 56.0;
            earlier = earlier + 1
        }
        d = d - 1
    }
    sc_most[v] = y + sc_pos[v] + end_room() - view_h();
    title_from_str("Today");
    top_bar(ox, sc_pos[v], 40.0, title_bytes, title_n)
}

// A meal eaten: its plate, its name, what it gave, and a button to take
// it off. Where the list goes on.
log_row(i: int, x: f32, y: f32): f32 {
    r: int = lg_recipe[i];
    h: f32 = 76.0;
    id: int = B_LOG + i;
    pr: f32 = pressed(id);
    p_box(x, y, col_w, h, 18.0, mix_rgb(C_CARD, C_SUNK, pr), 1.0);
    draw_plate(r, x + 40.0, y + h * 0.5, 28.0, 1.0);
    line_clear();
    line_name(rc_name[r]);
    write_fit(1, 16.5, x + 80.0, y + 32.0, col_w - 140.0, C_INK, 1.0);
    line_clear();
    line_num(lg_servings[i], 2);
    if (lg_servings[i] == 1.0) line_add(" serving, ") else line_add(" servings, ");
    line_count((rc_nut[r * NUTS + N_KCAL] * lg_servings[i] + 0.5) as int);
    line_add(" kcal");
    p_put(0, 14.5, x + 80.0, y + 54.0, line, 0, line_n, C_MUTED, 1.0);
    add_button(id, x, y, x + col_w - 56.0, y + h);
    // (Taken off.)
    uid: int = B_UNLOG + i;
    cx: f32 = x + col_w - 30.0;
    cy: f32 = y + h * 0.5;
    p_disc(cx, cy, 16.0, mix_rgb(C_SUNK, C_TOMATO_SOFT, pressed(uid)), 1.0);
    draw_icon(I_CROSS, cx, cy, 5.0, C_MUTED, 1.0);
    add_button(uid, x + col_w - 56.0, y, x + col_w, y + h);
    y + h
}

// ---- the bar of tabs ----
tab_title: []str = ["On hand", "Recipes", "Today"];

draw_tabbar() {
    w: f32 = view_w();
    vh: f32 = view_h();
    bw: f32 = minf(w - 32.0 - safe_left - safe_right, 380.0);
    bh: f32 = 62.0;
    bx: f32 = (w - bw) * 0.5;
    by: f32 = vh - maxf(safe_bottom, 14.0) - 4.0 - bh + page_t * (bh + safe_bottom + 40.0);
    p_shadow(bx, by, bw, bh, bh * 0.5, 6.0, 20.0, 0.16);
    p_box(bx, by, bw, bh, bh * 0.5, C_CARD, 0.98);
    p_outline(bx, by, bw, bh, bh * 0.5, 1.0, C_LINE, 1.0);
    iw: f32 = (bw - 12.0) / TABS as f32;
    hx: f32 = bx + 6.0 + clampf(tab_x, 0.0, (TABS - 1) as f32) * iw;
    p_box(hx, by + 6.0, iw, bh - 12.0, (bh - 12.0) * 0.5, C_SUNK, 1.0);
    for t in 0..TABS {
        id: int = B_TAB + t;
        on: f32 = clampf(1.0 - absf(tab_x - t as f32), 0.0, 1.0);
        ink: int = mix_rgb(C_MUTED, C_INK, on);
        k: f32 = 1.0 - 0.08 * pressed(id);
        cx: f32 = bx + 6.0 + iw * (t as f32 + 0.5);
        cy: f32 = by + bh * 0.5 - 7.0;
        icon: int = I_POT;
        if (t == 1) icon = I_BOOK;
        if (t == 2) icon = I_DAY;
        draw_icon(icon, cx, cy, 9.5 * k, ink, 1.0);
        p_str_mid(1, 12.5 * k, cx, by + bh * 0.5 + 19.0, tab_title[t], ink, 1.0);
        // (On the recipes: how many the kitchen has everything for.)
        if (t == 1 && ready_n > 0) {
            line_clear();
            line_int(ready_n);
            nw: f32 = maxf(p_text_w(1, 11.0, line, 0, line_n) + 10.0, 18.0);
            p_box(cx + 7.0, cy - 17.0, nw, 18.0, 9.0, C_GREEN, 1.0);
            p_outline(cx + 6.0, cy - 18.0, nw + 2.0, 20.0, 10.0, 1.5, C_CARD, 1.0);
            p_text(1, 11.0, cx + 7.0 + (nw - p_text_w(1, 11.0, line, 0, line_n)) * 0.5,
                cy - 4.0, line, 0, line_n, 0.0, C_WHITE, 1.0)
        }
        add_button(id, bx + 6.0 + iw * t as f32, by, bx + 6.0 + iw * (t + 1) as f32,
            by + bh)
    }
}

// ---- all of it ----
draw_book() {
    btn_n = 0;
    shown_x0 = -1.0;
    layout();
    w: f32 = view_w();
    vh: f32 = view_h();
    p_box(0.0, 0.0, w, vh, 0.0, C_BG, 1.0);
    // The tabs, side by side; pushed aside a little under a page.
    shift: f32 = -w * 0.28 * page_t;
    if (page_t < 0.999) {
        for t in 0..TABS {
            ox: f32 = (t as f32 - tab_x) * w + shift;
            if (ox > -w && ox < w) {
                p_clip(ox, 0.0, ox + w, vh);
                if (t == 0) draw_kitchen(ox);
                if (t == 1) draw_recipes(ox);
                if (t == 2) draw_today(ox);
                p_noclip()
            }
        }
        draw_tabbar();
        // (A field slid away, or under a page, is not the page's to type in.)
        if (page_t > 0.0 || absf(tab_x - tab as f32) > 0.05) shown_x0 = -1.0
    }
    if (page_t > 0.0) {
        p_box(0.0, 0.0, w, vh, 0.0, C_SHADOW, 0.1 * page_t);
        draw_page((1.0 - page_t) * w)
    }
    bottom: f32 = vh - maxf(safe_bottom, 14.0) - 80.0;
    draw_toast(bottom)
}
