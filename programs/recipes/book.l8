tag recipes;

use_tag std, skate;

// The book's state, and what each button does. Three tabs: what there is
// to eat here (and where here is), the recipes (ranked by it), and today
// (what has been eaten); and over them, a recipe's own page, which slides
// in from the right.
const TABS: int = 3;

// The buttons.
const B_TAB: int = 10;

const B_FIELD: int = 20;

const B_CLEAR: int = 24;

const B_BACK: int = 30;

const B_LESS: int = 31;

const B_MORE: int = 32;

const B_ATE: int = 33;

const B_EMPTY_KITCHEN: int = 34;

const B_GO_KITCHEN: int = 35;

const B_ADD_PLACE: int = 36;

const B_SPLIT_MEAL: int = 37;

const B_SPLIT_DAY: int = 38;

const B_REMOVE_PLACE: int = 39;

const B_COPY: int = 46;

const B_NAME_DONE: int = 47;

const B_PLACE: int = 50;

const B_HERE_MEAL: int = 60;

const B_HERE_DAY: int = 70;

const B_SET_UP: int = 80;

const B_HAS_MEAL: int = 81;

// (All, then each meal.)
const B_MEAL: int = 40;

const B_FOOD: int = 1000;

const B_RECIPE: int = 2000;

const B_LINE: int = 3000;

const B_LOG: int = 6000;

const B_UNLOG: int = 9000;

// The tab, and where the tabs show (0 the kitchen to 2 today: between
// while they slide).
tab: int = 0;

tab_x: f32 = 0.0;

// The recipe on the page, whether the page is open, and how far in it is.
page_r: int = -1;

page_open: bool = false;

page_t: f32 = 0.0;

// (Held by a finger, sliding it away.)
page_held: bool = false;

// How many servings the page is for, and when one was last eaten.
page_serves: int = 1;

ate_t: f32 = -10.0;

// When emptying the list, or taking a place away, was asked for (each
// is asked again).
empty_asked_t: f32 = -10.0;

remove_asked_t: f32 = -10.0;

// Whether a new place is being named, or the place's set-up shown.
naming: bool = false;

setting_up: bool = false;

// Whether the meal and day here are the clock's (until one is picked).
here_auto: bool = true;

// The hour, where the page is (-1 until it says).
hour_now: int = -1;

// How the kitchen is kept, as the page says: on this device only (0),
// saved to the person's link (1), being saved (2), waiting to be,
// offline (3), or on this device only, the link being unknown (4). And
// whether the page has put a newer kitchen in its file.
sync_state: int = 0;

reload_wanted: bool = false;

// The meal the recipes are of (-1 any).
meal_pick: int = -1;

// When the recipes are to be ranked again, and the kitchen saved.
rank_dirty: bool = true;

wants_save: bool = false;

// How each food's chip shows its state (eased), and how it was last
// tapped (a little bounce).
chip_show: []f32 = static_buffer(FOODS, 0.0);

chip_pop: []f32 = static_buffer(FOODS, 0.0);

set_food(f: int, s: int) {
    set_stock(f, s);
    chip_pop[f] = 1.0;
    rank_dirty = true;
    wants_save = true
}

// A tap on a food in the kitchen: not there, there, to use up, not there.
cycle_food(f: int) {
    set_food(f, (fd_state[f] + 1) % 3)
}

field_changed(f: int) {
    rank_dirty = true;
    if (f == 0) sc_vel[V_KITCHEN] = 0.0;
    if (f == 1) {
        sc_vel[V_RECIPES] = 0.0;
        // (What is found shows from the top.)
        sc_pos[V_RECIPES] = minf(sc_pos[V_RECIPES], list_top_scroll)
    }
}

// How far down the recipes' list starts (so that a search keeps its
// field in sight).
list_top_scroll: f32 = 0.0;

// Here is somewhere else now: its list is shown, and (where its lists go
// by meal) the recipes are of its meal.
set_here(l: int, m: int, d: int) {
    here_loc = l;
    here_meal = meal_at(l, m);
    here_day = d;
    load_here();
    if (loc_by_meal[l]) meal_pick = here_meal;
    rank_dirty = true;
    wants_save = true;
    remove_asked_t = -10.0;
    empty_asked_t = -10.0
}

// The meal and day the clock says (while none has been picked).
here_by_clock() {
    if (!here_auto) return;
    m: int = here_meal;
    if (hour_now >= 0) {
        m = 2;
        if (hour_now < 16) m = 1;
        if (hour_now < 11) m = 0
    }
    d: int = weekday(today);
    m = meal_at(here_loc, m);
    if (m == here_meal && d == here_day) return;
    saving: bool = wants_save;
    set_here(here_loc, m, d);
    wants_save = saving
}

// The name written for a new place: it is made, and is here.
name_done() {
    naming = false;
    field_blur();
    n: int = fq_n[2];
    while (n > 0 && fq[2 * FIELD_BYTES + n - 1] as int == 32) n = n - 1;
    if (n == 0) return;
    l: int = add_place(fq, 2 * FIELD_BYTES, 2 * FIELD_BYTES + n, false, false);
    fq_n[2] = 0;
    if (l < 0) {
        line_clear();
        line_add("No room for another place");
        toast_line();
        return
    }
    set_here(l, here_meal, here_day)
}

// Where here is, in words: "Wednesday lunch at Office", "Home on
// Saturday", or the place alone.
line_here() {
    l: int = here_loc;
    if (loc_by_meal[l]) {
        if (loc_by_day[l]) {
            line_add(weekday_title[here_day]);
            line_byte(32);
            line_add_lower(meal_title[here_meal])
        } else line_add(meal_title[here_meal]);
        line_add(" at ");
        line_name(loc_name[l]);
        return
    }
    line_name(loc_name[l]);
    if (loc_by_day[l]) {
        line_add(" on ");
        line_add(weekday_title[here_day])
    }
}

rerank() {
    if (!rank_dirty) return;
    rank_dirty = false;
    rank_recipes(meal_pick, field_text(1), fq_n[1])
}

go_tab(t: int) {
    if (t == tab && !page_open) {
        // (Its own tab again: back to its top.)
        sc_home[t] = true
    }
    tab = t;
    field_blur();
    if (page_open) close_page()
}

open_page(r: int) {
    if (r != page_r) {
        sc_pos[V_RECIPE] = 0.0;
        sc_vel[V_RECIPE] = 0.0;
        nut_t = 0.0
    }
    page_r = r;
    page_serves = rc_serves[r];
    page_open = true;
    field_blur()
}

close_page() {
    page_open = false
}

ate() {
    if (page_r < 0) return;
    log_meal(page_r, 1.0);
    ate_t = now_t;
    wants_save = true;
    line_clear();
    line_add("Added to today: ");
    line_count((rc_nut[page_r * NUTS + N_KCAL] + 0.5) as int);
    line_add(" kcal");
    toast_line()
}

act(id: int) {
    if (id >= B_TAB && id < B_TAB + TABS) go_tab(id - B_TAB);
    if (id >= B_FIELD && id < B_FIELD + FIELDS) {
        field_on = id - B_FIELD;
        field_typed_t = now_t
    }
    if (id >= B_CLEAR && id < B_CLEAR + FIELDS) field_clear(id - B_CLEAR);
    if (id == B_BACK) close_page();
    if (id == B_LESS && page_serves > 1) page_serves = page_serves - 1;
    if (id == B_MORE && page_serves < 24) page_serves = page_serves + 1;
    if (id == B_ATE) ate();
    if (id == B_GO_KITCHEN) go_tab(0);
    if (id == B_EMPTY_KITCHEN && now_t - empty_asked_t >= 3.0) {
        empty_asked_t = now_t;
        return
    }
    if (id == B_EMPTY_KITCHEN) {
        empty_asked_t = -10.0;
        for f in 0..fd_n {
            if (fd_state[f] != ST_NONE) set_food(f, ST_NONE)
        }
        line_clear();
        line_add("Emptied ");
        line_here();
        toast_line()
    }
    if (id >= B_PLACE && id < B_PLACE + loc_n) {
        // (Another place: its own meal for the hour, if the clock is
        // followed.)
        if (here_auto) {
            here_loc = id - B_PLACE;
            here_meal = -1;
            here_by_clock();
            wants_save = true
        } else set_here(id - B_PLACE, here_meal, here_day)
    }
    if (id == B_SET_UP) setting_up = !setting_up;
    if (id >= B_HAS_MEAL && id < B_HAS_MEAL + MEALS) {
        // (A place has at least one meal.)
        l: int = here_loc;
        bit: int = 1 << id - B_HAS_MEAL;
        if (has_meal(l, id - B_HAS_MEAL)) {
            if (loc_meals[l] != bit) loc_meals[l] = loc_meals[l] - bit
        } else loc_meals[l] = loc_meals[l] + bit;
        wants_save = true;
        set_here(l, here_meal, here_day)
    }
    if (id >= B_HERE_MEAL && id < B_HERE_MEAL + MEALS) {
        here_auto = false;
        set_here(here_loc, id - B_HERE_MEAL, here_day)
    }
    if (id >= B_HERE_DAY && id < B_HERE_DAY + DAYS) {
        here_auto = false;
        set_here(here_loc, here_meal, id - B_HERE_DAY)
    }
    if (id == B_ADD_PLACE) {
        naming = !naming;
        if (naming) {
            fq_n[2] = 0;
            field_on = 2;
            field_typed_t = now_t
        } else field_blur()
    }
    if (id == B_NAME_DONE) name_done();
    if (id == B_SPLIT_MEAL || id == B_SPLIT_DAY) {
        l: int = here_loc;
        bm: bool = loc_by_meal[l];
        bd: bool = loc_by_day[l];
        if (id == B_SPLIT_MEAL) bm = !bm else bd = !bd;
        set_split(l, bm, bd);
        set_here(l, here_meal, here_day)
    }
    if (id == B_REMOVE_PLACE && loc_n > 1) {
        if (now_t - remove_asked_t >= 3.0) remove_asked_t = now_t else {
            remove_asked_t = -10.0;
            line_clear();
            line_add("Took away ");
            line_name(loc_name[here_loc]);
            toast_line();
            remove_place(here_loc);
            set_here(here_loc, here_meal, here_day)
        }
    }
    if (id == B_COPY) {
        from: int = copy_source();
        if (from >= 0) {
            copy_slot(from, here_slot());
            load_here();
            for f in 0..fd_n chip_pop[f] = 0.6;
            rank_dirty = true;
            wants_save = true
        }
    }
    if (id >= B_MEAL && id <= B_MEAL + MEALS) {
        meal_pick = id - B_MEAL - 1;
        rank_dirty = true
    }
    if (id >= B_FOOD && id < B_FOOD + fd_n) cycle_food(id - B_FOOD);
    if (id >= B_RECIPE && id < B_RECIPE + rc_n) open_page(id - B_RECIPE);
    if (id >= B_LINE && id < B_LINE + ln_n) {
        // (On a recipe's page: there or not; to use up stays so.)
        f: int = ln_food[id - B_LINE];
        if (f >= 0) {
            if (fd_state[f] == ST_NONE) set_food(f, ST_HAVE) else set_food(f, ST_NONE)
        }
    }
    if (id >= B_LOG && id < B_LOG + lg_n) open_page(lg_recipe[id - B_LOG]);
    if (id >= B_UNLOG && id < B_UNLOG + lg_n) {
        unlog(id - B_UNLOG);
        wants_save = true
    }
}

// ---- keys ----
key_press(ks: int) {
    // (From the page: 1000000000 + 1000 * what + how much.)
    if (ks >= 1000000000) {
        page_says((ks - 1000000000) / 1000, (ks - 1000000000) % 1000);
        return
    }
    f: int = field_on;
    if (f < 0 && !page_open && tab < 2 && ks >= 33 && ks < 127) {
        f = tab;
        field_on = f
    }
    if (f >= 0) {
        if (ks >= 32 && ks < 127) field_type(f, ks);
        if (ks == 65288) field_back(f);
        if (ks == 65293) {
            if (f == 2) name_done() else field_blur()
        }
        return
    }
    if (ks == 65288 && page_open) close_page();
    if (ks == 65361 && page_open) close_page();
    if (ks == 65289) go_tab((tab + 1) % TABS);
    if (ks == 49) go_tab(0);
    if (ks == 50) go_tab(1);
    if (ks == 51) go_tab(2)
}

// Escape: whether it meant something here (rather than quitting).
esc_key(): bool {
    if (field_on == 2 || naming) {
        naming = false;
        field_blur();
        return true
    }
    if (field_on >= 0) {
        if (fq_n[field_on] > 0) field_clear(field_on) else field_blur();
        return true
    }
    if (page_open) {
        close_page();
        return true
    }
    false
}

// What the page says: the phone's edges (1 to 4), the book's pixels to
// the window's (5, in 500ths), whether its field has the keyboard (6),
// today (7 and 8: thousands, and the rest), the hour (9), that it has put
// a newer kitchen in its file (10), and how the kitchen is kept (11).
day_hi: int = 0;

page_says(what: int, v: int) {
    if (what == 1) safe_top = v as f32;
    if (what == 2) safe_bottom = v as f32;
    if (what == 3) safe_left = v as f32;
    if (what == 4) safe_right = v as f32;
    if (what == 5 && v > 0) p_ui = v as f32 / 500.0;
    if (what == 6) {
        if (v == 1) {
            // (The field the page was last told of.)
            if (told_f >= 0) field_on = told_f;
            field_typed_t = now_t
        } else field_on = -1
    }
    if (what == 7) day_hi = v;
    if (what == 8) {
        today = day_hi * 1000 + v;
        here_by_clock()
    }
    if (what == 9) {
        hour_now = v;
        here_by_clock()
    }
    if (what == 10) reload_wanted = true;
    if (what == 11) sync_state = v
}

// ---- each frame ----
step_book(dt: f32) {
    frame_dt = dt;
    rerank();
    step_fingers(dt);
    if (!tabs_held) tab_x = ease_to(tab_x, tab as f32, 13.0);
    target: f32 = 0.0;
    if (page_open) target = 1.0;
    if (!page_held) page_t = ease_to(page_t, target, 12.0);
    if (!page_open && page_t < 0.002 && !page_held) page_t = 0.0;
    for v in 0..VIEWS step_scroll(v);
    step_press()
}
