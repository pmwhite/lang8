tag recipes;

use_tag std, skate;

// The book's own things, from which its pages are made: colors; buttons,
// made as they are drawn and pressed against what the last frame drew;
// things that ease to where they are going; lists that scroll and glide;
// the search fields; the bar of tabs; the toast; and the icons.
const C_BG: int = 16183783; // #f6f1e7

const C_CARD: int = 16776696; // #fffdf8

const C_INK: int = 2827807; // #2b261f

const C_MUTED: int = 9077108; // #8a8174

const C_FAINT: int = 12169378; // #b9b0a2

const C_LINE: int = 15130318; // #e6dece

const C_SUNK: int = 15591128; // #ede6d8

const C_GREEN: int = 4160846; // #3f7d4e

const C_GREEN_SOFT: int = 14806748; // #e1eedc

const C_AMBER: int = 14518826; // #dd8a2a

const C_AMBER_SOFT: int = 16509392; // #fbe9d0

const C_TOMATO: int = 13784378; // #d2553a

const C_TOMATO_SOFT: int = 16310488; // #f8e0d8

const C_PLATE: int = 16513266; // #fbf8f2

const C_PLATE_RIM: int = 15327699; // #e9e1d3

const C_SHADOW: int = 3812894; // #3a2e1e

const C_PROTEIN: int = 13129021; // #c8553d

const C_CARBS: int = 14852923; // #e2a33b

const C_FATS: int = 8362572; // #7f9a4c

const C_WHITE: int = 16777215; // #ffffff

mix_rgb(a: int, b: int, t: f32): int {
    k: f32 = clampf(t, 0.0, 1.0);
    r: int = ((a >> 16 & 255) as f32 * (1.0 - k) + (b >> 16 & 255) as f32 * k + 0.5) as int;
    g: int = ((a >> 8 & 255) as f32 * (1.0 - k) + (b >> 8 & 255) as f32 * k + 0.5) as int;
    bl: int = ((a & 255) as f32 * (1.0 - k) + (b & 255) as f32 * k + 0.5) as int;
    (r << 16) + (g << 8) + bl
}

// ---- time, and things easing ----
now_t: f32 = 0.0;

frame_dt: f32 = 0.016;

// Whether anything drawn this frame is still on its way (so that the
// next frame is drawn too).
busy: bool = false;

ease_to(cur: f32, target: f32, rate: f32): f32 {
    if (absf(target - cur) < 0.0008) return target;
    busy = true;
    cur + (target - cur) * (1.0 - expf(-frame_dt * rate))
}

// The phone's own edges (its notch, its home bar), in the book's pixels.
safe_top: f32 = 0.0;

safe_bottom: f32 = 0.0;

safe_left: f32 = 0.0;

safe_right: f32 = 0.0;

// Whether fingers are a phone's (the page says so), and whether the book
// is on a page at all.
touch_ui: bool = false;

on_page: bool = false;

// ---- buttons ----
const BUTTONS: int = 512;

btn_n: int = 0;

btn_id: []int = static_buffer(BUTTONS, 0);

btn_x0: []f32 = static_buffer(BUTTONS, 0.0);

btn_y0: []f32 = static_buffer(BUTTONS, 0.0);

btn_x1: []f32 = static_buffer(BUTTONS, 0.0);

btn_y1: []f32 = static_buffer(BUTTONS, 0.0);

// A button, as much of it as shows within the clip.
add_button(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    if (btn_n >= BUTTONS) return;
    a: f32 = maxf(x0, p_cx0);
    b: f32 = maxf(y0, p_cy0);
    c: f32 = minf(x1, p_cx1);
    d: f32 = minf(y1, p_cy1);
    if (c <= a || d <= b) return;
    btn_id[btn_n] = id;
    btn_x0[btn_n] = a;
    btn_y0[btn_n] = b;
    btn_x1[btn_n] = c;
    btn_y1[btn_n] = d;
    btn_n = btn_n + 1
}

// The button at (x, y), the last drawn first (it is on top); 0 if none.
button_at(x: f32, y: f32): int {
    k: int = btn_n - 1;
    while (k >= 0) {
        if (x >= btn_x0[k] - 2.0 && x <= btn_x1[k] + 2.0 && y >= btn_y0[k] - 2.0 && y <= btn_y1[k] + 2.0) return btn_id[k];
        k = k - 1
    }
    0
}

// The button a finger is on, and how pressed it shows (in quickly, out
// slowly).
press_id: int = 0;

press_show: f32 = 0.0;

press_shown_id: int = 0;

pressed(id: int): f32 {
    if (press_shown_id == id) return press_show;
    0.0
}

step_press() {
    if (press_id != 0) {
        press_shown_id = press_id;
        press_show = minf(press_show + frame_dt * 16.0, 1.0)
    } else press_show = maxf(press_show - frame_dt * 5.0, 0.0);
    if (press_show > 0.0 && press_show < 1.0) busy = true
}

// ---- lists that scroll ----
// Each page's list: how far it has scrolled, how fast it goes on, how far
// it can go, and whether a finger holds it.
const VIEWS: int = 4;

const V_KITCHEN: int = 0;

const V_RECIPES: int = 1;

const V_TODAY: int = 2;

const V_RECIPE: int = 3;

sc_pos: []f32 = static_buffer(VIEWS, 0.0);

sc_vel: []f32 = static_buffer(VIEWS, 0.0);

sc_most: []f32 = static_buffer(VIEWS, 0.0);

sc_held: []bool = static_buffer(VIEWS, false);

// (Going back to its top, as when its tab is tapped again.)
sc_home: []bool = static_buffer(VIEWS, false);

// A list let go glides to a stop, or back within its ends.
step_scroll(v: int) {
    if (sc_held[v]) return;
    if (sc_home[v]) {
        sc_vel[v] = 0.0;
        sc_pos[v] = ease_to(sc_pos[v], 0.0, 9.0);
        if (sc_pos[v] == 0.0) sc_home[v] = false;
        return
    }
    dt: f32 = frame_dt;
    p: f32 = sc_pos[v];
    most: f32 = maxf(sc_most[v], 0.0);
    if (p < 0.0 || p > most) {
        end: f32 = 0.0;
        if (p > most) end = most;
        // (Past an end it slows hard, and comes back.)
        sc_vel[v] = sc_vel[v] * expf(-dt * 22.0);
        p = p + sc_vel[v] * dt;
        p = end + (p - end) * expf(-dt * 11.0);
        if (absf(p - end) < 0.3) p = end;
        sc_pos[v] = p;
        busy = true;
        return
    }
    if (absf(sc_vel[v]) < 8.0) {
        sc_vel[v] = 0.0;
        return
    }
    sc_pos[v] = p + sc_vel[v] * dt;
    sc_vel[v] = sc_vel[v] * expf(-dt * 2.4);
    busy = true
}

// Moved by a finger, dy down the screen: past an end, reluctantly.
scroll_by(v: int, dy: f32) {
    most: f32 = maxf(sc_most[v], 0.0);
    p: f32 = sc_pos[v];
    k: f32 = 1.0;
    if (p < 0.0) k = 0.5 / (1.0 - p / 90.0);
    if (p > most) k = 0.5 / (1.0 + (p - most) / 90.0);
    sc_pos[v] = p - dy * k
}

// ---- search fields ----
// One for the foods, one for the recipes, and one for a new place's name:
// what is written, and which one is being written in (-1 none).
const FIELDS: int = 3;

const FIELD_BYTES: int = 48;

fq: []i8 = static_buffer(FIELDS * FIELD_BYTES, 0i8);

fq_n: []int = static_buffer(FIELDS, 0);

field_on: int = -1;

// When it was last written in (the caret shows steadily for a while).
field_typed_t: f32 = 0.0;

// What is written in field f, alone, for searching with.
fq_buf: []i8 = static_buffer(FIELD_BYTES, 0i8);

field_text(f: int): []i8 {
    for i in 0..fq_n[f] fq_buf[i] = fq[f * FIELD_BYTES + i];
    fq_buf
}

field_type(f: int, c: int) {
    if (fq_n[f] >= FIELD_BYTES) return;
    fq[f * FIELD_BYTES + fq_n[f]] = c trunc i8;
    fq_n[f] = fq_n[f] + 1;
    field_typed_t = now_t;
    field_retell = true;
    field_changed(f)
}

field_back(f: int) {
    if (fq_n[f] == 0) return;
    fq_n[f] = fq_n[f] - 1;
    field_typed_t = now_t;
    field_retell = true;
    field_changed(f)
}

field_clear(f: int) {
    if (fq_n[f] == 0) return;
    fq_n[f] = 0;
    field_retell = true;
    field_changed(f)
}

// The field on the screen, as the page was last told (it puts a phone's
// keyboard up when a finger comes down on it).
told_x0: f32 = -1.0;

told_y0: f32 = -1.0;

told_x1: f32 = -1.0;

told_y1: f32 = -1.0;

shown_x0: f32 = -1.0;

shown_y0: f32 = -1.0;

shown_x1: f32 = -1.0;

shown_y1: f32 = -1.0;

// (Which field it is, and whether what is written in it has changed
// since the page was told.)
shown_f: int = -1;

told_f: int = -1;

field_retell: bool = false;

field_shown(
    f: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    // (Of two on the screen, the one being written in.)
    if (shown_x0 >= 0.0 && shown_f == field_on && f != field_on) return;
    shown_f = f;
    shown_x0 = maxf(x0, p_cx0);
    shown_y0 = maxf(y0, p_cy0);
    shown_x1 = minf(x1, p_cx1);
    shown_y1 = minf(y1, p_cy1);
    if (shown_x1 <= shown_x0 || shown_y1 <= shown_y0) shown_x0 = -1.0
}

// Once a frame, after drawing: tell the page where the field is, if that
// has changed.
tell_field() raises IoError {
    if (!on_page) return;
    if (absf(shown_x0 - told_x0) + absf(shown_y0 - told_y0) + absf(shown_x1 - told_x1) + absf(shown_y1 - told_y1) < 0.5 && shown_f == told_f && !field_retell) return;
    field_retell = false;
    told_f = shown_f;
    told_x0 = shown_x0;
    told_y0 = shown_y0;
    told_x1 = shown_x1;
    told_y1 = shown_y1;
    line_clear();
    if (shown_x0 < 0.0) line_add("L8FIELD -") else {
        line_add("L8FIELD ");
        line_int(shown_x0 as int);
        line_byte(32);
        line_int(shown_y0 as int);
        line_byte(32);
        line_int((shown_x1 + 0.5) as int);
        line_byte(32);
        line_int((shown_y1 + 0.5) as int);
        // (And what is written in it.)
        line_byte(32);
        for i in 0..fq_n[shown_f] line_byte(fq[shown_f * FIELD_BYTES + i] as int)
    }
    write_bytes_n(1, line, line_n);
    print("")
}

// No field written in any more: the page puts the keyboard away.
blur_wanted: bool = false;

field_blur() {
    if (field_on >= 0 && on_page) blur_wanted = true;
    field_on = -1
}

// A search field: a box with a glass, what is written or what to write,
// the caret, and a button to clear it.
draw_field(
    f: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    hint: str,
    id: int,
    clear_id: int
) {
    on: bool = field_on == f;
    p_box(x, y, w, h, 14.0, C_SUNK, 1.0);
    if (on) p_outline(x - 1.0, y - 1.0, w + 2.0, h + 2.0, 15.0, 2.0, C_GREEN, 0.55);
    // (A glass on those that search.)
    tx: f32 = x + 16.0;
    if (f < 2) {
        draw_icon(I_SEARCH, x + 22.0, y + h * 0.5, 8.0, C_MUTED, 1.0);
        tx = x + 42.0
    }
    base: f32 = y + h * 0.5 + 6.0;
    size: f32 = 17.0;
    end: f32 = tx;
    if (fq_n[f] == 0) p_str(0, size, tx, base, hint, C_FAINT, 1.0) else end = p_text(0,
        size, tx, base, fq, f * FIELD_BYTES, f * FIELD_BYTES + fq_n[f], 0.0, C_INK,
        1.0);
    if (on) {
        // (Steady while written in, then blinking.)
        blink: f32 = 1.0;
        since: f32 = now_t - field_typed_t;
        if (since > 0.6) {
            blink = clampf(1.6 - 2.0 * absf(fmodf(since, 1.1) - 0.55) * 2.0, 0.0,
                1.0);
            busy = true
        }
        p_box(end + 1.0, y + h * 0.5 - 11.0, 2.0, 22.0, 1.0, C_GREEN, blink)
    }
    add_button(id, x, y, x + w - 40.0, y + h);
    if (fq_n[f] > 0) {
        cx: f32 = x + w - 22.0;
        cy: f32 = y + h * 0.5;
        p_disc(cx, cy, 10.0, mix_rgb(C_FAINT, C_MUTED, pressed(clear_id)), 1.0);
        draw_icon(I_CROSS, cx, cy, 4.0, C_SUNK, 1.0);
        add_button(clear_id, x + w - 44.0, y, x + w, y + h)
    } else add_button(id, x + w - 40.0, y, x + w, y + h);
    // (Not over its button to clear it.)
    if (fq_n[f] > 0) field_shown(f, x, y, x + w - 44.0, y + h) else field_shown(f,
        x, y, x + w, y + h)
}

fmodf(x: f32, m: f32): f32 {
    x - (x / m) as int as f32 * m
}

// ---- a toast: a word for a moment ----
toast_buf: []i8 = static_buffer([200]i8);

toast_n: int = 0;

toast_t: f32 = 10.0;

toast_line() {
    toast_n = mini(line_n, len(toast_buf));
    for i in 0..toast_n toast_buf[i] = line[i];
    toast_t = 0.0
}

draw_toast(bottom: f32) {
    if (toast_t >= 2.4 || toast_n == 0) return;
    toast_t = toast_t + frame_dt;
    busy = true;
    a: f32 = clampf(toast_t * 7.0, 0.0, 1.0) * clampf((2.4 - toast_t) * 4.0, 0.0,
        1.0);
    size: f32 = 16.0;
    tw: f32 = p_text_w(1, size, toast_buf, 0, toast_n);
    w: f32 = minf(tw + 40.0, view_w() - 32.0);
    if (tw + 40.0 > w) size = size * (w - 40.0) / tw;
    h: f32 = 44.0;
    x: f32 = (view_w() - w) * 0.5;
    y: f32 = bottom - h + (1.0 - a) * 14.0;
    p_shadow(x, y, w, h, h * 0.5, 6.0, 18.0, 0.25 * a);
    p_box(x, y, w, h, h * 0.5, C_INK, 0.96 * a);
    p_text(1, size, x + 20.0, y + h * 0.5 + size * 0.36, toast_buf, 0, toast_n, 0.0,
        C_BG, a)
}

// ---- icons, drawn in lines about (x, y), r their half size ----
const I_SEARCH: int = 1;

const I_CROSS: int = 2;

const I_BACK: int = 3;

const I_CHECK: int = 4;

const I_CLOCK: int = 5;

const I_POT: int = 6;

const I_BOOK: int = 7;

const I_DAY: int = 8;

const I_PLUS: int = 9;

const I_MINUS: int = 10;

const I_FLAME: int = 11;

const I_PIN: int = 12;

const I_NEXT: int = 13;

draw_icon(
    id: int,
    x: f32,
    y: f32,
    r: f32,
    rgb: int,
    a: f32
) {
    t: f32 = maxf(r * 0.24, 1.6);
    if (id == I_SEARCH) {
        p_ring(x - r * 0.2, y - r * 0.2, r * 0.72, t, rgb, a);
        p_line(x + r * 0.32, y + r * 0.32, x + r * 0.95, y + r * 0.95, t, rgb, a)
    }
    if (id == I_CROSS) {
        p_line(x - r, y - r, x + r, y + r, t * 1.1, rgb, a);
        p_line(x + r, y - r, x - r, y + r, t * 1.1, rgb, a)
    }
    if (id == I_BACK) {
        p_line(x + r * 0.35, y - r * 0.8, x - r * 0.45, y, t, rgb, a);
        p_line(x - r * 0.45, y, x + r * 0.35, y + r * 0.8, t, rgb, a)
    }
    if (id == I_CHECK) {
        p_line(x - r * 0.8, y + r * 0.05, x - r * 0.25, y + r * 0.6, t, rgb, a);
        p_line(x - r * 0.25, y + r * 0.6, x + r * 0.85, y - r * 0.55, t, rgb, a)
    }
    if (id == I_CLOCK) {
        p_ring(x, y, r, t * 0.85, rgb, a);
        p_line(x, y, x, y - r * 0.55, t * 0.85, rgb, a);
        p_line(x, y, x + r * 0.4, y + r * 0.2, t * 0.85, rgb, a)
    }
    if (id == I_POT) {
        // A pot: its body, its lid, the lid's knob, and two handles.
        p_outline(x - r * 0.8, y - r * 0.2, r * 1.6, r * 1.05, r * 0.3, t, rgb, a);
        p_line(x - r * 0.95, y - r * 0.45, x + r * 0.95, y - r * 0.45, t, rgb, a);
        p_line(x, y - r * 0.75, x, y - r * 0.6, t * 1.3, rgb, a);
        p_line(x - r * 1.15, y + r * 0.05, x - r * 0.85, y + r * 0.05, t, rgb, a);
        p_line(x + r * 0.85, y + r * 0.05, x + r * 1.15, y + r * 0.05, t, rgb, a)
    }
    if (id == I_BOOK) {
        // An open book: two pages meeting at the spine.
        p_line(x, y - r * 0.55, x, y + r * 0.85, t, rgb, a);
        p_line(x, y - r * 0.55, x - r * 0.95, y - r * 0.8, t, rgb, a);
        p_line(x - r * 0.95, y - r * 0.8, x - r * 0.95, y + r * 0.6, t, rgb, a);
        p_line(x - r * 0.95, y + r * 0.6, x, y + r * 0.85, t, rgb, a);
        p_line(x, y - r * 0.55, x + r * 0.95, y - r * 0.8, t, rgb, a);
        p_line(x + r * 0.95, y - r * 0.8, x + r * 0.95, y + r * 0.6, t, rgb, a);
        p_line(x + r * 0.95, y + r * 0.6, x, y + r * 0.85, t, rgb, a)
    }
    if (id == I_DAY) {
        // A ring, mostly full.
        p_ring(x, y, r * 0.9, t, rgb, a * 0.35);
        p_arc(x, y, r * 0.9, t, -1.5708, 4.3, rgb, a)
    }
    if (id == I_PIN) {
        // A map's pin: a ring on a point.
        p_line(x, y + r * 0.95, x - r * 0.55, y + r * 0.05, t, rgb, a);
        p_line(x, y + r * 0.95, x + r * 0.55, y + r * 0.05, t, rgb, a);
        p_ring(x, y - r * 0.25, r * 0.62, t, rgb, a);
        p_disc(x, y - r * 0.25, r * 0.2, rgb, a)
    }
    if (id == I_NEXT) {
        p_line(x - r * 0.4, y - r, x + r * 0.5, y, t * 1.2, rgb, a);
        p_line(x + r * 0.5, y, x - r * 0.4, y + r, t * 1.2, rgb, a)
    }
    if (id == I_PLUS || id == I_MINUS) {
        p_line(x - r * 0.75, y, x + r * 0.75, y, t, rgb, a);
        if (id == I_PLUS) p_line(x, y - r * 0.75, x, y + r * 0.75, t, rgb, a)
    }
}

// A mark for what the kitchen has of a food: a check (there), a clock (to
// use up soon), or an empty ring (missing), in a disc r across.
draw_mark(
    state: f32,
    x: f32,
    y: f32,
    r: f32,
    a: f32
) {
    have: f32 = clampf(state, 0.0, 1.0);
    use: f32 = clampf(state - 1.0, 0.0, 1.0);
    fill: int = mix_rgb(C_GREEN, C_AMBER, use);
    p_ring(x, y, r, 1.6, C_FAINT, a * (1.0 - have));
    p_disc(x, y, r * (0.6 + 0.4 * have), fill, a * have);
    if (use > 0.5) draw_icon(I_CLOCK, x, y, r * 0.55, C_WHITE, a * have) else draw_icon(I_CHECK,
        x, y, r * 0.5, C_WHITE, a * have)
}

// A pill button with a word: a dark one (strong) or a quiet one.
pill(
    id: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    t: str,
    size: f32,
    fill: int,
    ink: int,
    a: f32
) {
    pr: f32 = pressed(id);
    k: f32 = 1.0 - 0.04 * pr;
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    p_box(cx - w * k * 0.5, cy - h * k * 0.5, w * k, h * k, h * k * 0.5, mix_rgb(fill,
        C_INK, 0.12 * pr), a);
    p_str_mid(1, size * k, cx, cy + size * 0.36 * k, t, ink, a);
    add_button(id, x, y, x + w, y + h)
}
