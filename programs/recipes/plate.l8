tag recipes;

use_tag std, skate;

// A recipe's picture: its plate seen from above, with its foods on it in
// their colors, each as much as there is of it. The biggest goes down
// first and nearest the middle; herbs are scattered over, and spices are
// a dusting. Oils do not show. Where each piece lies is the same each time
// (from the recipe and the line).
hash01(a: int, b: int): f32 {
    v: f32 = sinf(a as f32 * 12.9898 + b as f32 * 78.233) * 43758.547;
    v = absf(v);
    v - v as int as f32
}

// The plate's foods, biggest first.
const PLATE_MAX: int = 16;

pl_line: []int = new int[PLATE_MAX](0);

pl_n: int = 0;

plate_foods(r: int) {
    pl_n = 0;
    for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
        if (ln_kind[l] == LN_USE && fd_group[ln_food[l]] != 7 && pl_n < PLATE_MAX) {
            at: int = pl_n;
            while (at > 0 && ln_grams[pl_line[at - 1]] < ln_grams[l]) {
                pl_line[at] = pl_line[at - 1];
                at = at - 1
            }
            pl_line[at] = l;
            pl_n = pl_n + 1
        }
    }
}

draw_plate(
    r: int,
    cx: f32,
    cy: f32,
    big: f32,
    a: f32
) {
    p_shadow(cx - big, cy - big, 2.0 * big, 2.0 * big, big, big * 0.06, big * 0.16,
        0.16 * a);
    p_disc(cx, cy, big, C_PLATE_RIM, a);
    p_disc(cx, cy, big * 0.97, C_PLATE, a);
    p_ring(cx, cy, big * 0.8, maxf(big * 0.012, 0.8), C_PLATE_RIM, a);
    plate_foods(r);
    // (How much of the plate the solid foods share.)
    total: f32 = 0.0;
    for i in 0..pl_n {
        g: int = fd_group[ln_food[pl_line[i]]];
        if (g != 8 && g != 9) total = total + sqrtf(ln_grams[pl_line[i]])
    }
    total = maxf(total, 1.0);
    inner: f32 = big * 0.74;
    k: int = 0;
    for i in 0..pl_n {
        l: int = pl_line[i];
        f: int = ln_food[l];
        g: int = fd_group[f];
        rgb: int = fd_rgb[f];
        if (g == 8) draw_herbs(r, l, cx, cy, inner, rgb, a) else if (g == 9) draw_dust(r,
            l, cx, cy, inner, rgb, a) else {
            share: f32 = sqrtf(ln_grams[l]) / total;
            rad: f32 = clampf(inner * 1.15 * sqrtf(share), inner * 0.2, inner * 0.56);
            // (On a spiral out from the middle.)
            ang: f32 = k as f32 * 2.39996 + hash01(r, 7) * 6.283;
            dist: f32 = (inner - rad) * sqrtf((k as f32 + 0.5) / (pl_n as f32 + 0.5));
            if (k == 0) dist = inner * 0.12;
            draw_piece(r, l, cx + cosf(ang) * dist, cy + sinf(ang) * dist, rad, rgb,
                a);
            k = k + 1
        }
    }
}

// A food as a few pieces about (x, y), within rad.
draw_piece(
    r: int,
    l: int,
    x: f32,
    y: f32,
    rad: f32,
    rgb: int,
    a: f32
) {
    dark: int = mix_rgb(rgb, C_SHADOW, 0.28);
    light: int = mix_rgb(rgb, C_WHITE, 0.3);
    n: int = 3 + (hash01(r, l) * 3.0) as int;
    for j in 0..n {
        h1: f32 = hash01(l * 7 + j, r * 3 + 1);
        h2: f32 = hash01(l * 5 + j * 3, r + 11);
        pr: f32 = rad * (0.5 + 0.25 * h1);
        if (j == 0) pr = rad * 0.72;
        ang: f32 = h2 * 6.283;
        d: f32 = (rad - pr) * (0.3 + 0.7 * h1);
        if (j == 0) d = 0.0;
        px: f32 = x + cosf(ang) * d;
        py: f32 = y + sinf(ang) * d;
        p_disc(px, py + pr * 0.08, pr, dark, a * 0.55);
        p_disc(px, py, pr, rgb, a);
        p_disc(px - pr * 0.25, py - pr * 0.28, pr * 0.42, light, a * 0.45)
    }
}

// Herbs: small leaves scattered over everything.
draw_herbs(
    r: int,
    l: int,
    cx: f32,
    cy: f32,
    inner: f32,
    rgb: int,
    a: f32
) {
    n: int = 9 + mini((ln_grams[l] * 0.4) as int, 12);
    for j in 0..n {
        ang: f32 = hash01(l + j * 13, r) * 6.283;
        d: f32 = inner * 0.85 * sqrtf(hash01(j * 31 + l, r * 7 + 3));
        s: f32 = inner * (0.035 + 0.03 * hash01(j, l));
        x: f32 = cx + cosf(ang) * d;
        y: f32 = cy + sinf(ang) * d;
        p_box_at(x, y, s * 1.4, s * 0.8, s * 0.8, rgb, a * 0.95)
    }
}

// Spices: a fine dusting.
draw_dust(
    r: int,
    l: int,
    cx: f32,
    cy: f32,
    inner: f32,
    rgb: int,
    a: f32
) {
    for j in 0..14 {
        ang: f32 = hash01(l * 3 + j * 17, r + 5) * 6.283;
        d: f32 = inner * 0.8 * sqrtf(hash01(j * 7 + l, r * 13));
        p_disc(cx + cosf(ang) * d, cy + sinf(ang) * d, maxf(inner * 0.018, 0.7), rgb,
            a * 0.7)
    }
}
