tag recipes;

use_tag std, gl, x11, skate;

// A recipe book, drawn the way the games here are: the picture is the
// interface. Say what is in the kitchen, and what to use up, and the
// recipes line up by what can be cooked; each recipe's page says what a
// serving gives, and what was eaten is added up by the day.
//
//   .build/recipes [BOOK [KITCHEN]]
//
// BOOK is programs/recipes/recipes.txt if none; KITCHEN (what is in the
// kitchen, and what was eaten) is .build/recipes-kitchen.txt. See
// README.md for how it is used.
import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../skate/math.l8";

import "../skate/font.l8";

import "paint.l8";

import "text.l8";

import "food.l8";

import "kitchen.l8";

import "ui.l8";

import "plate.l8";

import "touch.l8";

import "book.l8";

import "pages.l8";

extern getenv(name: str): ?*i8;

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int
}

clock_ns(clk: int): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(clk, &ts);
    ts.sec * 1000000000 + ts.nsec
}

book_path: str = "programs/recipes/recipes.txt";

kitchen_path: str = ".build/recipes-kitchen.txt";

file_buf: []i8 = static_buffer([262144]i8);

// A file, into file_buf: how many bytes (-1 if it cannot be read).
read_file(path: str): int {
    fd: int = open(path, 0, 0);
    if (fd < 0) return -1;
    n: int = 0;
    more: bool = true;
    while (more && n < len(file_buf)) {
        r: int = read(fd, file_buf, n, len(file_buf) - n);
        if (r <= 0) more = false else n = n + r
    }
    close(fd);
    n
}

// The kitchen, written back to its file (the page keeps it from there).
save_kitchen() raises IoError {
    write_kitchen();
    fd: int = open(kitchen_path, 577, 420);
    if (fd < 0) return;
    write_bytes_n(fd, kt, kt_n);
    close(fd)
}

main(argc: int, argv: []str@immortal) raises IoError: int {
    if (argc > 1) book_path = argv[1];
    if (argc > 2) kitchen_path = argv[2];
    n: int = read_file(book_path);
    if (n < 0) {
        eprint("recipes: cannot read the book");
        return 1
    }
    read_book(file_buf, n);
    if (book_error >= 0) {
        line_clear();
        line_add("recipes: line ");
        line_int(book_error_line);
        line_add(" of the book has ");
        line_add(book_error_words());
        write_bytes_n(2, line, line_n);
        eprint("");
        return 1
    }
    k: int = read_file(kitchen_path);
    read_kitchen(file_buf, maxi(k, 0));
    for f in 0..fd_n chip_show[f] = fd_state[f] as f32;
    // (Today, where the clock is; the page says where it is.)
    secs: int = clock_ns(0) / 1000000000;
    today = secs / 86400;
    hour_now = secs / 3600 % 24;
    here_by_clock();
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) book_die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    scr_w = env_int("L8_W", 430);
    scr_h = env_int("L8_H", 860);
    p_ui = env_int("L8_UI", 100) as f32 / 100.0;
    win: int = XCreateWindow(dpy, root, 0, 0, scr_w, scr_h, 0, vis.depth as int, 1,
        vis.visual, 10248, &wa);
    if (win == 0) book_die("XCreateWindow failed");
    XStoreName(dpy, win, "Recipes");
    proto: []int = buffer([1]int);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) book_die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) book_die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    painter: Painter = new_painter();
    touch_ui = getenv("L8_TOUCH") != null;
    on_page = getenv("L8_PAGE") != null;
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = clock_ns(1);
    start_ns: int = prev_ns;
    // Frames drawn with nothing changing: after a few, the picture is left
    // as it is until something does.
    still: int = 0;
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            still = 0;
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65307) {
                        if (!esc_key() && !on_page) running = false
                    } else key_press(ks)
                }
                ButtonPress b -> {
                    bn: int = b.button as int;
                    x: f32 = b.x as f32 / p_ui;
                    y: f32 = b.y as f32 / p_ui;
                    if (bn == 4 || bn == 5) {
                        amount: f32 = maxf(b.state as f32, 40.0);
                        if (bn == 4) wheel(-amount) else wheel(amount)
                    } else finger_down(bn, x, y)
                }
                ButtonRelease b -> finger_up(b.button as int, b.x as f32 / p_ui, b.y as f32 / p_ui);
                MotionNotify mo -> finger_move(mo.state as int, mo.x as f32 / p_ui,
                    mo.y as f32 / p_ui);
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        scr_w = c.width as int;
                        scr_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        now: int = clock_ns(1);
        dt: f32 = clampf((now - prev_ns) as f32 / 1000000000.0, 0.0, 0.05);
        prev_ns = now;
        now_t = (now - start_ns) as f32 / 1000000000.0;
        busy = false;
        step_book(dt);
        if (busy || g_finger >= 0) still = 0;
        if (still < 3 || !on_page) {
            glViewport(0, 0, scr_w, scr_h);
            glClearColor(0.965, 0.945, 0.906, 1.0);
            glClear(16640);
            p_reset();
            busy = false;
            draw_book();
            p_draw(&painter);
            if (busy) still = 0 else still = still + 1
        }
        tell_field();
        if (blur_wanted) {
            blur_wanted = false;
            print("L8BLUR")
        }
        // (A newer kitchen, from the page: what was here is put back.)
        if (reload_wanted) {
            reload_wanted = false;
            k2: int = read_file(kitchen_path);
            if (k2 >= 0) {
                read_kitchen(file_buf, k2);
                here_by_clock();
                rank_dirty = true
            }
        }
        if (wants_save) {
            wants_save = false;
            save_kitchen()
        }
        glXSwapBuffers(dpy, win)
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}

extern l8_environment(): []str@new;

// A whole number from the environment (as L8_W=390), or the fallback.
env_int(key: str, fallback: int): int {
    if (getenv(key) == null) return fallback;
    for e in l8_environment() {
        if (len(e) > len(key) + 1 && e[len(key)] == '=') {
            same: bool = true;
            for i in 0..len(key) {
                if (e[i] != key[i]) same = false
            }
            if (same) {
                v: int = 0;
                neg: bool = false;
                for i in len(key) + 1..len(e) {
                    c: int = e[i] as int;
                    if (c == 45) neg = true else if (c >= 48 && c <= 57) v = v * 10 + c - 48
                }
                if (neg) return -v;
                return v
            }
        }
    }
    fallback
}
