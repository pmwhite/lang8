tag recipes;

use_tag std, skate;

// The book: its foods, with what is in each, and its recipes, read from
// recipes.txt (see there for the format). What a serving of a recipe gives
// is worked out from its ingredients.
const FOODS: int = 160;

const RECIPES: int = 96;

const LINES: int = 2400;

// What is in a food (in 100 g of it) or a serving: energy, the three
// macronutrients and fiber, then vitamins and minerals.
const NUTS: int = 17;

const N_KCAL: int = 0;

const N_PROTEIN: int = 1;

const N_FAT: int = 2;

const N_CARBS: int = 3;

const N_FIBER: int = 4;

// (The first of the vitamins and minerals.)
const N_MICRO: int = 5;

nut_title: []str = ["Calories", "Protein", "Fat", "Carbs", "Fiber", "Vitamin A", "Vitamin C",
    "Vitamin D", "Vitamin E", "Vitamin K", "Vitamin B12", "Folate", "Calcium", "Iron",
    "Magnesium", "Potassium", "Zinc"];

nut_unit: []str = ["kcal", "g", "g", "g", "g", "mcg", "mg", "mcg", "mg", "mcg", "mcg",
    "mcg", "mg", "mg", "mg", "mg", "mg"];

// The daily values (the FDA's, for an adult eating 2,000 kcal a day).
nut_daily: []f32 = [2000.0, 50.0, 78.0, 275.0, 28.0, 900.0, 90.0, 20.0, 15.0, 120.0,
    2.4, 400.0, 1300.0, 18.0, 420.0, 4700.0, 11.0];

const GROUPS: int = 11;

group_key: []str = ["veg", "fruit", "protein", "dairy", "grain", "bean", "nut", "fat",
    "herb", "spice", "pantry"];

group_title: []str = ["Vegetables", "Fruit", "Meat, fish and eggs", "Dairy", "Grains",
    "Beans and lentils", "Nuts and seeds", "Oils and fats", "Herbs", "Spices", "Pantry"];

const MEALS: int = 4;

meal_key: []str = ["breakfast", "lunch", "dinner", "snack"];

meal_title: []str = ["Breakfast", "Lunch", "Dinner", "Snack"];

// ---- foods ----
fd_n: int = 0;

fd_key: []int = static_buffer(FOODS, 0);

fd_name: []int = static_buffer(FOODS, 0);

fd_group: []int = static_buffer(FOODS, 0);

fd_rgb: []int = static_buffer(FOODS, 0);

fd_nut: []f32 = static_buffer(FOODS * NUTS, 0.0);

// ---- recipes, and their lines ----
const LN_USE: int = 0;

const LN_EXTRA: int = 1;

const LN_STAPLE: int = 2;

const LN_STEP: int = 3;

rc_n: int = 0;

rc_key: []int = static_buffer(RECIPES, 0);

rc_name: []int = static_buffer(RECIPES, 0);

rc_meal: []int = static_buffer(RECIPES, 0);

rc_serves: []int = static_buffer(RECIPES, 0);

rc_minutes: []int = static_buffer(RECIPES, 0);

rc_about: []int = static_buffer(RECIPES, 0);

rc_line0: []int = static_buffer(RECIPES, 0);

rc_lines: []int = static_buffer(RECIPES, 0);

// What a serving gives (from its ingredients, not its extras).
rc_nut: []f32 = static_buffer(RECIPES * NUTS, 0.0);

ln_n: int = 0;

ln_kind: []int = static_buffer(LINES, 0);

ln_food: []int = static_buffer(LINES, 0);

ln_grams: []f32 = static_buffer(LINES, 0.0);

ln_text: []int = static_buffer(LINES, 0);

// The amount the line starts with (0 if none), and where the words after
// it start in its text.
ln_qty: []f32 = static_buffer(LINES, 0.0);

ln_rest: []int = static_buffer(LINES, 0);

// What went wrong reading the book, if anything.
book_error: int = -1;

book_error_line: int = 0;

// ---- reading ----
// The words of one line: each one's start and end.
const WORDS: int = 40;

wd_from: []int = static_buffer(WORDS, 0);

wd_to: []int = static_buffer(WORDS, 0);

wd_n: int = 0;

split_words(t: []i8, from: int, to: int) {
    wd_n = 0;
    i: int = from;
    while (i < to) {
        while (i < to && (t[i] as int == 32 || t[i] as int == 9)) i = i + 1;
        if (i < to && wd_n < WORDS) {
            wd_from[wd_n] = i;
            while (i < to && t[i] as int != 32 && t[i] as int != 9) i = i + 1;
            wd_to[wd_n] = i;
            wd_n = wd_n + 1
        } else i = to
    }
}

word_is(t: []i8, w: int, s: str): bool {
    if (wd_to[w] - wd_from[w] != len(s)) return false;
    for i in 0..len(s) {
        if (t[wd_from[w] + i] != s[i]) return false
    }
    true
}

word_num(t: []i8, w: int): f32 {
    read_plain(t, wd_from[w], wd_to[w])
}

// Which of the strings word w is, or -1.
word_which(t: []i8, w: int, keys: []str): int {
    for k in 0..len(keys) {
        if (word_is(t, w, keys[k])) return k
    }
    -1
}

// The food whose key is the bytes from `from` up to `to`, or -1.
find_food(t: []i8, from: int, to: int): int {
    for f in 0..fd_n {
        if (name_is(fd_key[f], t, from, to)) return f
    }
    -1
}

find_recipe(t: []i8, from: int, to: int): int {
    for r in 0..rc_n {
        if (name_is(rc_key[r], t, from, to)) return r
    }
    -1
}

hex_digit(c: int): int {
    if (c >= 48 && c <= 57) return c - 48;
    if (c >= 97 && c <= 102) return c - 87;
    if (c >= 65 && c <= 70) return c - 55;
    0
}

// A color written rrggbb.
word_rgb(t: []i8, w: int): int {
    v: int = 0;
    for i in wd_from[w]..wd_to[w] v = v * 16 + hex_digit(t[i] as int);
    v
}

// The rest of the line from word w on, as a name.
rest_name(t: []i8, w: int, to: int): int {
    if (w >= wd_n) return name_of(t, to, to);
    e: int = to;
    while (e > wd_from[w] && (t[e - 1] as int == 32 || t[e - 1] as int == 13)) e = e - 1;
    name_of(t, wd_from[w], e)
}

book_fail(why: int, at: int) {
    if (book_error < 0) {
        book_error = why;
        book_error_line = at
    }
}

// What went wrong, in words.
book_error_words(): str {
    if (book_error == 1) return "a food line with too few numbers";
    if (book_error == 2) return "an unknown food group";
    if (book_error == 3) return "an ingredient that is not a food";
    if (book_error == 4) return "a recipe line before any recipe";
    if (book_error == 5) return "an unknown meal";
    if (book_error == 6) return "an unknown kind of line";
    if (book_error == 7) return "too many foods, recipes or lines";
    "nothing"
}

read_book(t: []i8, n: int) {
    fd_n = 0;
    rc_n = 0;
    ln_n = 0;
    book_error = -1;
    at: int = 1;
    i: int = 0;
    while (i < n) {
        e: int = i;
        while (e < n && t[e] as int != 10) e = e + 1;
        // (Up to a comment.)
        c: int = i;
        while (c < e && t[c] as int != 35) c = c + 1;
        split_words(t, i, c);
        if (wd_n > 0) read_book_line(t, c, at);
        i = e + 1;
        at = at + 1
    }
    for r in 0..rc_n add_up(r)
}

read_book_line(t: []i8, to: int, at: int) {
    if (word_is(t, 0, "food")) {
        if (wd_n < 4 + NUTS + 1) {
            book_fail(1, at);
            return
        }
        g: int = word_which(t, 2, group_key);
        if (g < 0) {
            book_fail(2, at);
            return
        }
        if (fd_n >= FOODS) {
            book_fail(7, at);
            return
        }
        f: int = fd_n;
        fd_key[f] = name_of(t, wd_from[1], wd_to[1]);
        fd_group[f] = g;
        fd_rgb[f] = word_rgb(t, 3);
        for k in 0..NUTS fd_nut[f * NUTS + k] = word_num(t, 4 + k);
        fd_name[f] = rest_name(t, 4 + NUTS, to);
        fd_n = fd_n + 1;
        return
    }
    if (word_is(t, 0, "recipe")) {
        if (rc_n >= RECIPES) {
            book_fail(7, at);
            return
        }
        r: int = rc_n;
        rc_key[r] = name_of(t, wd_from[1], wd_to[1]);
        rc_name[r] = rest_name(t, 2, to);
        rc_meal[r] = 2;
        rc_serves[r] = 1;
        rc_minutes[r] = 0;
        rc_about[r] = -1;
        rc_line0[r] = ln_n;
        rc_lines[r] = 0;
        rc_n = rc_n + 1;
        return
    }
    if (rc_n == 0) {
        book_fail(4, at);
        return
    }
    r: int = rc_n - 1;
    if (word_is(t, 0, "meal")) {
        m: int = word_which(t, 1, meal_key);
        if (m < 0) book_fail(5, at) else rc_meal[r] = m;
        return
    }
    if (word_is(t, 0, "serves")) {
        rc_serves[r] = maxi(word_num(t, 1) as int, 1);
        return
    }
    if (word_is(t, 0, "minutes")) {
        rc_minutes[r] = word_num(t, 1) as int;
        return
    }
    if (word_is(t, 0, "about")) {
        rc_about[r] = rest_name(t, 1, to);
        return
    }
    kind: int = word_which(t, 0, ["use", "extra", "staple", "step"]);
    if (kind < 0) {
        book_fail(6, at);
        return
    }
    if (ln_n >= LINES) {
        book_fail(7, at);
        return
    }
    l: int = ln_n;
    ln_kind[l] = kind;
    ln_food[l] = -1;
    ln_grams[l] = 0.0;
    words: int = 1;
    if (kind == LN_USE || kind == LN_EXTRA) {
        ln_food[l] = find_food(t, wd_from[1], wd_to[1]);
        if (ln_food[l] < 0) {
            book_fail(3, at);
            return
        }
        ln_grams[l] = word_num(t, 2);
        words = 3
    }
    ln_text[l] = rest_name(t, words, to);
    // (The amount it starts with, which the servings scale.)
    ln_qty[l] = 0.0;
    ln_rest[l] = 0;
    if (kind != LN_STEP) {
        s: int = name_start[ln_text[l]];
        q: f32 = read_amount(name_bytes, s, s + name_len[ln_text[l]]);
        if (num_end > s) {
            ln_qty[l] = q;
            ln_rest[l] = num_end - s
        }
    }
    ln_n = ln_n + 1;
    rc_lines[r] = rc_lines[r] + 1
}

// What a serving of recipe r gives.
add_up(r: int) {
    for k in 0..NUTS rc_nut[r * NUTS + k] = 0.0;
    for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
        if (ln_kind[l] == LN_USE) {
            f: int = ln_food[l];
            k2: f32 = ln_grams[l] / 100.0 / rc_serves[r] as f32;
            for k in 0..NUTS rc_nut[r * NUTS + k] = rc_nut[r * NUTS + k] + fd_nut[f * NUTS + k] * k2
        }
    }
}

// A line's words, for so many servings: its amount scaled, then the rest.
line_ingredient(l: int, k: f32) {
    if (ln_qty[l] <= 0.0) {
        line_name(ln_text[l]);
        return
    }
    line_amount(ln_qty[l] * k);
    s: int = name_start[ln_text[l]];
    for i in ln_rest[l]..name_len[ln_text[l]] line_byte(name_bytes[s + i] as int)
}

// How many lines of a kind recipe r has.
rc_count(r: int, kind: int): int {
    n: int = 0;
    for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
        if (ln_kind[l] == kind) n = n + 1
    }
    n
}
