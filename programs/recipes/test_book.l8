tag recipes_tests;

use_tag std, recipes, skate;

// The book without its window: read whole, its servings added up, and its
// recipes ranked by what a kitchen has.
import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../skate/math.l8";

import "../skate/font.l8";

import "paint.l8";

import "text.l8";

import "food.l8";

import "kitchen.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

book_buf: []i8 = new i8[262144](0i8);

test_load() {
    if (rc_n > 0) return;
    fd: int = open("programs/recipes/test-book.txt", 0, 0);
    n: int = 0;
    more: bool = true;
    while (more) {
        r: int = read(fd, book_buf, n, len(book_buf) - n);
        if (r <= 0) more = false else n = n + r
    }
    close(fd);
    read_book(book_buf, n)
}

print_line() raises IoError {
    write_bytes_n(1, line, line_n);
    print("")
}

recipe_named(key: str): int {
    line_clear();
    line_add(key);
    find_recipe(line, 0, line_n)
}

food_named(key: str): int {
    line_clear();
    line_add(key);
    find_food(line, 0, line_n)
}

test "the book reads whole" {
    test_load();
    line_clear();
    line_add("foods ");
    line_int(fd_n);
    line_add(", recipes ");
    line_int(rc_n);
    line_add(", lines ");
    line_int(ln_n);
    line_add(", error ");
    line_add(book_error_words());
    print_line();
    for m in 0..MEALS {
        line_clear();
        line_add(meal_key[m]);
        line_add(":");
        for r in 0..rc_n {
            if (rc_meal[r] == m) {
                line_byte(32);
                line_name(rc_key[r])
            }
        }
        print_line()
    }
    expect {|
        foods 63, recipes 20, lines 271, error nothing
        breakfast: shakshuka overnight_oats omelette sweet_potato_hash pancakes
        lunch: greek_salad tabbouleh tuna_beans squash_soup fried_rice
        dinner: dal chickpea_stew salmon_quinoa roast_chicken beef_broccoli chili minestrone baked_cod meatballs
        snack: hummus
    |}
}

test "a serving of each recipe" {
    test_load();
    for r in 0..rc_n {
        line_clear();
        line_name(rc_key[r]);
        line_add(" ");
        line_int((rc_nut[r * NUTS + N_KCAL] + 0.5) as int);
        line_add(" kcal, P ");
        line_int((rc_nut[r * NUTS + N_PROTEIN] + 0.5) as int);
        line_add(" F ");
        line_int((rc_nut[r * NUTS + N_FAT] + 0.5) as int);
        line_add(" C ");
        line_int((rc_nut[r * NUTS + N_CARBS] + 0.5) as int);
        line_add(" fiber ");
        line_int((rc_nut[r * NUTS + N_FIBER] + 0.5) as int);
        print_line()
    }
    expect {|
        shakshuka 327 kcal, P 18 F 18 C 26 fiber 7
        overnight_oats 538 kcal, P 22 F 25 C 61 fiber 12
        omelette 379 kcal, P 25 F 29 C 4 fiber 1
        sweet_potato_hash 447 kcal, P 17 F 20 C 50 fiber 9
        pancakes 326 kcal, P 12 F 11 C 48 fiber 6
        greek_salad 542 kcal, P 20 F 31 C 50 fiber 13
        tabbouleh 379 kcal, P 10 F 19 C 46 fiber 8
        tuna_beans 387 kcal, P 27 F 16 C 35 fiber 9
        squash_soup 353 kcal, P 6 F 23 C 37 fiber 7
        hummus 259 kcal, P 9 F 14 C 29 fiber 8
        dal 317 kcal, P 18 F 7 C 50 fiber 9
        chickpea_stew 435 kcal, P 19 F 15 C 62 fiber 17
        salmon_quinoa 680 kcal, P 41 F 38 C 47 fiber 9
        roast_chicken 417 kcal, P 37 F 15 C 35 fiber 6
        beef_broccoli 610 kcal, P 40 F 18 C 73 fiber 7
        chili 433 kcal, P 16 F 14 C 65 fiber 19
        minestrone 327 kcal, P 15 F 11 C 46 fiber 10
        baked_cod 464 kcal, P 32 F 19 C 44 fiber 7
        fried_rice 527 kcal, P 20 F 17 C 73 fiber 7
        meatballs 442 kcal, P 42 F 24 C 18 fiber 5
    |}
}

test "amounts scale with the servings" {
    test_load();
    r: int = recipe_named("sweet_potato_hash");
    for l in rc_line0[r]..rc_line0[r] + 4 {
        line_clear();
        line_ingredient(l, 1.0);
        line_add("  /  ");
        line_ingredient(l, 0.5);
        line_add("  /  ");
        line_ingredient(l, 1.5);
        print_line()
    }
    expect {|
        2 sweet potatoes, cubed small  /  1 sweet potatoes, cubed small  /  3 sweet potatoes, cubed small
        1 red pepper, diced  /  1/2 red pepper, diced  /  1 1/2 red pepper, diced
        1 onion, diced  /  1/2 onion, diced  /  1 1/2 onion, diced
        1 1/2 tbsp olive oil  /  3/4 tbsp olive oil  /  2 1/4 tbsp olive oil
    |}
}

test "recipes rank by what the kitchen has, and what is to be used up" {
    test_load();
    for f in 0..fd_n fd_state[f] = ST_NONE;
    for k in ["egg", "onion", "garlic", "red_pepper", "tinned_tomato", "olive_oil",
        "cumin", "paprika", "spinach", "chickpeas", "lemon"] {
        line_clear();
        line_add(k);
        fd_state[find_food(line, 0, line_n)] = ST_HAVE
    }
    fd_state[food_named("spinach")] = ST_USE;
    rank_recipes(-1, line, 0);
    for i in 0..6 {
        r: int = rank[i];
        line_clear();
        line_int(rc_section[r]);
        line_add(" ");
        line_name(rc_key[r]);
        line_add(" missing ");
        line_int(rc_missing(r));
        line_add(" uses ");
        line_int(rc_uses[r]);
        print_line()
    }
    expect {|
        0 chickpea_stew missing 0 uses 1
        0 shakshuka missing 0 uses 0
        1 omelette missing 2 uses 1
        1 sweet_potato_hash missing 1 uses 0
        2 dal missing 4 uses 1
        2 minestrone missing 6 uses 1
    |}
    // Looking for a word: in names, and in foods.
    line_clear();
    line_add("LENTIL");
    rank_recipes(-1, line, line_n);
    line_clear();
    line_int(rank_n);
    line_add(" with lentils: ");
    line_name(rc_key[rank[0]]);
    print_line();
    expect {|
        1 with lentils: dal
    |}
}

test "the kitchen's file reads back the same" {
    test_load();
    read_kitchen(book_buf, 0);
    today = 20740;
    log_meal(recipe_named("dal"), 1.0);
    log_meal(recipe_named("shakshuka"), 0.5);
    // Spinach at home, to use up; eggs at the office for Wednesday's
    // breakfast, and oats for Thursday's.
    here_loc = 0;
    load_here();
    set_stock(food_named("spinach"), ST_USE);
    here_loc = 1;
    here_meal = 0;
    here_day = 2;
    load_here();
    set_stock(food_named("egg"), ST_HAVE);
    here_day = 3;
    load_here();
    set_stock(food_named("oats"), ST_HAVE);
    write_kitchen();
    write_bytes_n(1, kt, kt_n);
    expect {|
        place - Home
        place md/bl Office
        here 1
        use 0 - - spinach
        have 1 breakfast wed egg
        have 1 breakfast thu oats
        ate 20740 dal 1
        ate 20740 shakshuka 0.5
    |}
    for k in 0..kt_n book_buf[k] = kt[k];
    n: int = kt_n;
    read_kitchen(book_buf, n);
    write_kitchen();
    line_clear();
    line_int(n);
    line_add(" bytes, then ");
    line_int(kt_n);
    line_add(", ");
    line_int(lg_n);
    line_add(" meals, ");
    line_int(loc_n);
    line_add(" places");
    print_line();
    add_up_day(20740);
    line_clear();
    line_int((day_nut[N_KCAL] + 0.5) as int);
    line_add(" kcal today, ");
    line_date(20740);
    print_line();
    expect {|
        148 bytes, then 148, 2 meals, 2 places
        481 kcal today, Wednesday 14 October
    |}
}

test "each place, meal and day has its own list" {
    test_load();
    read_kitchen(book_buf, 0);
    // The office on Wednesday at breakfast, then at lunch, then Thursday.
    here_loc = 1;
    here_meal = 0;
    here_day = 2;
    load_here();
    set_stock(food_named("egg"), ST_HAVE);
    here_meal = 1;
    load_here();
    count_kitchen();
    line_clear();
    line_add("Wednesday lunch: ");
    line_int(kitchen_have);
    line_add(", copy from ");
    s: int = copy_source();
    line_int(slot_meal(s));
    line_byte(32);
    line_int(slot_day(s));
    print_line();
    here_meal = 0;
    here_day = 3;
    load_here();
    s = copy_source();
    line_clear();
    line_add("Thursday breakfast: copy from ");
    line_int(slot_meal(s));
    line_byte(32);
    line_int(slot_day(s));
    print_line();
    // The office has no dinner (nor a snack): at those hours, its lunch.
    line_clear();
    line_add("office meal at dinner ");
    line_int(meal_at(1, 2));
    line_add(", at a snack ");
    line_int(meal_at(1, 3));
    line_add(", home at dinner ");
    line_int(meal_at(0, 2));
    print_line();
    // Home has one list, whenever; split by day, each day starts as it was.
    here_loc = 0;
    load_here();
    set_stock(food_named("lemon"), ST_HAVE);
    set_split(0, false, true);
    here_day = 5;
    load_here();
    count_kitchen();
    line_clear();
    line_add("home on Saturday, split by day: ");
    line_int(kitchen_have);
    print_line();
    // An older kitchen's lines are home's.
    line_clear();
    line_add("""
have lemon
use spinach
""");
    for k in 0..line_n book_buf[k] = line[k];
    read_kitchen(book_buf, line_n);
    write_kitchen();
    write_bytes_n(1, kt, kt_n);
    expect {|
        Wednesday lunch: 0, copy from 0 2
        Thursday breakfast: copy from 0 2
        office meal at dinner 1, at a snack 1, home at dinner 2
        home on Saturday, split by day: 1
        place - Home
        place md/bl Office
        here 0
        use 0 - - spinach
        have 0 - - lemon
    |}
}
