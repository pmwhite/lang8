tag recipes;

use_tag std, skate;

// What there is to eat where: the places (home, the office), and at each
// what food there is (each food not there, there, or there and to be used
// up soon); the recipes ranked by what there is here and now; and what
// has been eaten (a serving of a recipe on a day).
//
// A place has one list of what it has, or (as an office's cafeteria) one
// for each meal, or each day of the week, or each meal of each day. Here
// is a place, a meal and a day: the list for them is the one the recipes
// are ranked by, and the one a tap on a food changes.
//
// It is all kept in a file of its own (the kitchen's), a line to a thing:
//
//   place m|d|md|-[/MEALS] NAME...  a place, what its lists go by, and
//                                    the meals it has (as bl: breakfast
//                                    and lunch; all if none are said)
//   have PLACE MEAL DAY KEY          PLACE from 0, as they come; MEAL and
//   use PLACE MEAL DAY KEY           DAY as breakfast, mon, or - for any
//   here PLACE
//   ate DAY RECIPE SERVINGS
const ST_NONE: int = 0;

const ST_HAVE: int = 1;

const ST_USE: int = 2;

// What there is of each food here and now (the list for here, as it is
// shown).
fd_state: []int = static_buffer(FOODS, 0);

// ---- places ----
const PLACES: int = 8;

const DAYS: int = 7;

// A place's lists: for any meal (0) or each (1 on), on any day (0) or
// each (1 on, Monday first).
const SLOTS: int = 40;

loc_n: int = 0;

loc_name: []int = static_buffer(PLACES, 0);

loc_by_meal: []bool = static_buffer(PLACES, false);

loc_by_day: []bool = static_buffer(PLACES, false);

// The meals a place has, a bit each (1 breakfast, 2 lunch, 4 dinner, 8 a
// snack): an office's cafeteria has no dinner.
const ALL_MEALS: int = 15;

loc_meals: []int = static_buffer(PLACES, 15);

meal_letter: []str = ["b", "l", "d", "s"];

has_meal(l: int, m: int): bool {
    (loc_meals[l] >> m & 1) != 0
}

// Meal m, or (if place l has no such meal) the last it has before it, or
// its first.
meal_at(l: int, m: int): int {
    k: int = m;
    while (k >= 0) {
        if (has_meal(l, k)) return k;
        k = k - 1
    }
    for j in 0..MEALS {
        if (has_meal(l, j)) return j
    }
    m
}

stock: []int = static_buffer(PLACES * SLOTS * FOODS, 0);

// Here: the place, the meal (0 breakfast) and the day of the week (0
// Monday).
here_loc: int = 0;

here_meal: int = 2;

here_day: int = 0;

day_short: []str = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

day_key: []str = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];

// Place l's list for a meal and a day (as it goes by them).
slot_of(l: int, meal: int, day: int): int {
    m: int = 0;
    if (loc_by_meal[l]) m = meal + 1;
    d: int = 0;
    if (loc_by_day[l]) d = day + 1;
    l * SLOTS + m * (DAYS + 1) + d
}

here_slot(): int {
    slot_of(here_loc, here_meal, here_day)
}

// The list for here, as shown.
load_here() {
    s: int = here_slot() * FOODS;
    for f in 0..fd_n fd_state[f] = stock[s + f]
}

set_stock(f: int, st: int) {
    stock[here_slot() * FOODS + f] = st;
    fd_state[f] = st
}

slot_count(s: int): int {
    n: int = 0;
    for f in 0..fd_n {
        if (stock[s * FOODS + f] != ST_NONE) n = n + 1
    }
    n
}

copy_slot(from: int, to: int) {
    for f in 0..fd_n stock[to * FOODS + f] = stock[from * FOODS + f]
}

// A new place, named by the bytes from `from` up to `to`: its number, or
// -1 if there is no room.
add_place(
    t: []i8,
    from: int,
    to: int,
    by_meal: bool,
    by_day: bool
): int {
    if (loc_n >= PLACES) return -1;
    l: int = loc_n;
    loc_name[l] = name_of(t, from, to);
    loc_by_meal[l] = by_meal;
    loc_by_day[l] = by_day;
    loc_meals[l] = ALL_MEALS;
    for k in l * SLOTS * FOODS..(l + 1) * SLOTS * FOODS stock[k] = ST_NONE;
    loc_n = loc_n + 1;
    l
}

add_place_str(name: str, by_meal: bool, by_day: bool): int {
    line_clear();
    line_add(name);
    add_place(line, 0, line_n, by_meal, by_day)
}

remove_place(l: int) {
    if (l < 0 || l >= loc_n || loc_n <= 1) return;
    for k in l + 1..loc_n {
        loc_name[k - 1] = loc_name[k];
        loc_by_meal[k - 1] = loc_by_meal[k];
        loc_by_day[k - 1] = loc_by_day[k];
        loc_meals[k - 1] = loc_meals[k];
        for j in 0..SLOTS * FOODS stock[(k - 1) * SLOTS * FOODS + j] = stock[k * SLOTS * FOODS + j]
    }
    loc_n = loc_n - 1;
    if (here_loc > l || here_loc >= loc_n) here_loc = maxi(here_loc - 1, 0);
    load_here()
}

// Whether place l's lists go by meal and by day. A list that was one
// becomes each of those it is split into (where they have nothing yet).
set_split(l: int, by_meal: bool, by_day: bool) {
    was_meal: bool = loc_by_meal[l];
    was_day: bool = loc_by_day[l];
    for m in 0..MEALS {
        for d in 0..DAYS {
            loc_by_meal[l] = was_meal;
            loc_by_day[l] = was_day;
            from: int = slot_of(l, m, d);
            loc_by_meal[l] = by_meal;
            loc_by_day[l] = by_day;
            to: int = slot_of(l, m, d);
            if (to != from && slot_count(to) == 0) copy_slot(from, to)
        }
    }
    loc_by_meal[l] = by_meal;
    loc_by_day[l] = by_day;
    load_here()
}

// A list of this place to start an empty one here from: the same meal
// on the nearest day before, or any list it has; -1 if none.
copy_source(): int {
    here: int = here_slot();
    l: int = here_loc;
    for back in 1..DAYS {
        s: int = slot_of(l, here_meal, (here_day - back + DAYS) % DAYS);
        if (s != here && slot_count(s) > 0) return s
    }
    for s in l * SLOTS..(l + 1) * SLOTS {
        if (s != here && slot_count(s) > 0) return s
    }
    -1
}

// The meal and day of list s (-1 for any).
slot_meal(s: int): int {
    s % SLOTS / (DAYS + 1) - 1
}

slot_day(s: int): int {
    s % (DAYS + 1) - 1
}

// A new book's places: home, with one list, and an office whose cafeteria
// has a list for each meal of each day, breakfast and lunch.
default_places() {
    if (loc_n > 0) return;
    add_place_str("Home", false, false);
    o: int = add_place_str("Office", true, true);
    loc_meals[o] = 3
}

// ---- ranking ----
// For each recipe: how many of its ingredients there are, how many of
// them the kitchen has, and how many of its ingredients and extras are
// ones to use up.
rc_needed: []int = static_buffer(RECIPES, 0);

rc_have: []int = static_buffer(RECIPES, 0);

rc_uses: []int = static_buffer(RECIPES, 0);

// Which part of the list it is in (see SEC_), and the recipes in order.
const SEC_READY: int = 0;

const SEC_NEAR: int = 1;

const SEC_SHOP: int = 2;

// (With nothing in the kitchen, there is one part: all of them.)
const SEC_ALL: int = 3;

rc_section: []int = static_buffer(RECIPES, 0);

rank: []int = static_buffer(RECIPES, 0);

rank_n: int = 0;

kitchen_have: int = 0;

kitchen_use: int = 0;

// How many recipes (of any meal) the kitchen has everything for.
ready_n: int = 0;

rc_missing(r: int): int {
    rc_needed[r] - rc_have[r]
}

count_kitchen() {
    kitchen_have = 0;
    kitchen_use = 0;
    for f in 0..fd_n {
        if (fd_state[f] != ST_NONE) kitchen_have = kitchen_have + 1;
        if (fd_state[f] == ST_USE) kitchen_use = kitchen_use + 1
    }
}

// Whether recipe r is one the list shows: of the meal (or any, -1), and
// with the words looked for in its name, its line about it, or the names
// of its foods.
rc_shown(
    r: int,
    meal: int,
    q: []i8,
    qn: int
): bool {
    if (meal >= 0 && rc_meal[r] != meal) return false;
    if (qn == 0) return true;
    if (name_has(rc_name[r], q, 0, qn)) return true;
    if (rc_about[r] >= 0 && name_has(rc_about[r], q, 0, qn)) return true;
    for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
        if (ln_food[l] >= 0 && name_has(fd_name[ln_food[l]], q, 0, qn)) return true
    }
    false
}

// Before b in the list: a better part; in a part, more to use up; then
// less missing; then the book's order.
ranks_before(a: int, b: int): bool {
    if (rc_section[a] != rc_section[b]) return rc_section[a] < rc_section[b];
    // (With nothing in the kitchen: by meal, as in the book.)
    if (rc_section[a] == SEC_ALL) {
        if (rc_meal[a] != rc_meal[b]) return rc_meal[a] < rc_meal[b];
        return a < b
    }
    if (rc_uses[a] != rc_uses[b]) return rc_uses[a] > rc_uses[b];
    if (rc_missing(a) != rc_missing(b)) return rc_missing(a) < rc_missing(b);
    a < b
}

rank_recipes(meal: int, q: []i8, qn: int) {
    count_kitchen();
    rank_n = 0;
    ready_n = 0;
    for r in 0..rc_n {
        rc_needed[r] = 0;
        rc_have[r] = 0;
        rc_uses[r] = 0;
        for l in rc_line0[r]..rc_line0[r] + rc_lines[r] {
            f: int = ln_food[l];
            if (ln_kind[l] == LN_USE) {
                rc_needed[r] = rc_needed[r] + 1;
                if (fd_state[f] != ST_NONE) rc_have[r] = rc_have[r] + 1
            }
            if (f >= 0 && fd_state[f] == ST_USE) rc_uses[r] = rc_uses[r] + 1
        }
        m: int = rc_missing(r);
        rc_section[r] = SEC_SHOP;
        if (m <= 2) rc_section[r] = SEC_NEAR;
        if (m == 0) {
            rc_section[r] = SEC_READY;
            ready_n = ready_n + 1
        }
        if (kitchen_have == 0) rc_section[r] = SEC_ALL;
        if (rc_shown(r, meal, q, qn)) {
            // (In order as it goes in.)
            at: int = rank_n;
            while (at > 0 && ranks_before(r, rank[at - 1])) {
                rank[at] = rank[at - 1];
                at = at - 1
            }
            rank[at] = r;
            rank_n = rank_n + 1
        }
    }
}

// ---- what was eaten ----
const LOGS: int = 2000;

lg_n: int = 0;

lg_day: []int = static_buffer(LOGS, 0);

lg_recipe: []int = static_buffer(LOGS, 0);

lg_servings: []f32 = static_buffer(LOGS, 0.0);

// Today, as days from 1 January 1970 (the page says which, where it is).
today: int = 0;

log_meal(r: int, servings: f32) {
    if (lg_n >= LOGS) {
        // (The oldest goes.)
        for i in 1..lg_n {
            lg_day[i - 1] = lg_day[i];
            lg_recipe[i - 1] = lg_recipe[i];
            lg_servings[i - 1] = lg_servings[i]
        }
        lg_n = lg_n - 1
    }
    lg_day[lg_n] = today;
    lg_recipe[lg_n] = r;
    lg_servings[lg_n] = servings;
    lg_n = lg_n + 1
}

unlog(i: int) {
    if (i < 0 || i >= lg_n) return;
    for j in i + 1..lg_n {
        lg_day[j - 1] = lg_day[j];
        lg_recipe[j - 1] = lg_recipe[j];
        lg_servings[j - 1] = lg_servings[j]
    }
    lg_n = lg_n - 1
}

// What day d's meals gave, into day_nut; how many meals.
day_nut: []f32 = static_buffer(NUTS, 0.0);

add_up_day(d: int): int {
    for k in 0..NUTS day_nut[k] = 0.0;
    n: int = 0;
    for i in 0..lg_n {
        if (lg_day[i] == d) {
            r: int = lg_recipe[i];
            for k in 0..NUTS day_nut[k] = day_nut[k] + rc_nut[r * NUTS + k] * lg_servings[i];
            n = n + 1
        }
    }
    n
}

// ---- the kitchen's file ----
// A meal or a day as the file has it: its number, or -1 for any (-).
word_meal(t: []i8, w: int): int {
    word_which(t, w, meal_key)
}

word_day(t: []i8, w: int): int {
    word_which(t, w, day_key)
}

read_kitchen(t: []i8, n: int) {
    loc_n = 0;
    here_loc = 0;
    lg_n = 0;
    i: int = 0;
    while (i < n) {
        e: int = i;
        while (e < n && t[e] as int != 10) e = e + 1;
        split_words(t, i, e);
        if (wd_n >= 3 && word_is(t, 0, "place")) {
            by_meal: bool = false;
            by_day: bool = false;
            meals: int = 0;
            after: bool = false;
            for k in wd_from[1]..wd_to[1] {
                c: int = t[k] as int;
                if (c == 47) after = true;
                if (!after && c == 109) by_meal = true;
                if (!after && c == 100) by_day = true;
                if (after) {
                    for m in 0..MEALS {
                        if (c == meal_letter[m][0] as int) meals = meals | 1 << m
                    }
                }
            }
            e2: int = e;
            while (e2 > wd_from[2] && (t[e2 - 1] as int == 32 || t[e2 - 1] as int == 13)) e2 = e2 - 1;
            pl: int = add_place(t, wd_from[2], e2, by_meal, by_day);
            if (pl >= 0 && meals != 0) loc_meals[pl] = meals
        }
        if (wd_n >= 2 && word_is(t, 0, "here")) here_loc = word_num(t, 1) as int;
        if (word_is(t, 0, "have") || word_is(t, 0, "use")) {
            // (An older kitchen's line has only the food: home's, at any time.)
            l: int = 0;
            m: int = -1;
            d: int = -1;
            k: int = 1;
            if (wd_n >= 5) {
                l = word_num(t, 1) as int;
                m = word_meal(t, 2);
                d = word_day(t, 3);
                k = 4
            }
            if (wd_n > k) {
                default_places();
                f: int = find_food(t, wd_from[k], wd_to[k]);
                if (f >= 0 && l >= 0 && l < loc_n) {
                    s: int = l * SLOTS + (m + 1) * (DAYS + 1) + d + 1;
                    if (word_is(t, 0, "use")) stock[s * FOODS + f] = ST_USE else stock[s * FOODS + f] = ST_HAVE
                }
            }
        }
        if (wd_n >= 4 && word_is(t, 0, "ate") && lg_n < LOGS) {
            r: int = find_recipe(t, wd_from[2], wd_to[2]);
            if (r >= 0) {
                lg_day[lg_n] = word_num(t, 1) as int;
                lg_recipe[lg_n] = r;
                lg_servings[lg_n] = word_num(t, 3);
                lg_n = lg_n + 1
            }
        }
        i = e + 1
    }
    default_places();
    here_loc = clampi(here_loc, 0, loc_n - 1);
    load_here()
}

// The kitchen as its file, into kt.
kt: []i8 = static_buffer([262144]i8);

kt_n: int = 0;

kt_line() {
    for i in 0..line_n {
        if (kt_n < len(kt)) {
            kt[kt_n] = line[i];
            kt_n = kt_n + 1
        }
    }
}

write_kitchen() {
    kt_n = 0;
    for l in 0..loc_n {
        line_clear();
        line_add("place ");
        if (!loc_by_meal[l] && !loc_by_day[l]) line_add("-");
        if (loc_by_meal[l]) line_add("m");
        if (loc_by_day[l]) line_add("d");
        if (loc_meals[l] != ALL_MEALS) {
            line_add("/");
            for m in 0..MEALS {
                if (has_meal(l, m)) line_add(meal_letter[m])
            }
        }
        line_byte(32);
        line_name(loc_name[l]);
        line_byte(10);
        kt_line()
    }
    line_clear();
    line_add("here ");
    line_int(here_loc);
    line_byte(10);
    kt_line();
    for s in 0..loc_n * SLOTS {
        m: int = slot_meal(s);
        d: int = slot_day(s);
        for f in 0..fd_n {
            st: int = stock[s * FOODS + f];
            if (st != ST_NONE) {
                line_clear();
                if (st == ST_USE) line_add("use ") else line_add("have ");
                line_int(s / SLOTS);
                line_byte(32);
                if (m < 0) line_add("-") else line_add(meal_key[m]);
                line_byte(32);
                if (d < 0) line_add("-") else line_add(day_key[d]);
                line_byte(32);
                line_name(fd_key[f]);
                line_byte(10);
                kt_line()
            }
        }
    }
    for i in 0..lg_n {
        line_clear();
        line_add("ate ");
        line_int(lg_day[i]);
        line_byte(32);
        line_name(rc_key[lg_recipe[i]]);
        line_byte(32);
        line_num(lg_servings[i], 2);
        line_byte(10);
        kt_line()
    }
}

// ---- days ----
// Day d's year, month (1 to 12) and day of the month; and of the week (0
// Monday). (From Howard Hinnant's civil_from_days.)
cal_year: int = 1970;

cal_month: int = 1;

cal_day: int = 1;

calendar(d: int) {
    z: int = d + 719468;
    era: int = z / 146097;
    if (z < 0) era = (z - 146096) / 146097;
    doe: int = z - era * 146097;
    yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    y: int = yoe + era * 400;
    doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100);
    mp: int = (5 * doy + 2) / 153;
    cal_day = doy - (153 * mp + 2) / 5 + 1;
    if (mp < 10) cal_month = mp + 3 else cal_month = mp - 9;
    if (cal_month <= 2) y = y + 1;
    cal_year = y
}

weekday(d: int): int {
    // (1 January 1970 was a Thursday.)
    ((d % 7 + 7) % 7 + 3) % 7
}

weekday_title: []str = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday",
    "Sunday"];

month_title: []str = ["January", "February", "March", "April", "May", "June", "July",
    "August", "September", "October", "November", "December"];

// "Wednesday 14 October".
line_date(d: int) {
    calendar(d);
    line_add(weekday_title[weekday(d)]);
    line_byte(32);
    line_int(cal_day);
    line_byte(32);
    line_add(month_title[cal_month - 1])
}
