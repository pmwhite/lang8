tag dom;

use_tag std;

// The page from L8, for programs built with `l8 wasm` and run by
// web/dom.js, as programs/ios/objc.l8 is UIKit from L8.
//
// Nodes (and the window, document, location and other host objects) are
// handles here: small ints the host keeps in a table, 0 for none. A handle
// stays until dom_free (or dom_free_tree) lets it go; removing a node from
// the page does not free it. Text goes in as str, or as bytes start to end
// of a []i8 (the _of calls), so text laid out in a buffer needs no copies;
// it comes back into a []i8 the caller owns, the call answering its whole
// length (more than fits means call again with more room). Offsets in text
// are UTF-8 bytes, as L8 counts them.
//
// The host calls back into L8 through function values, fn(data: int), with
// the data given when they were set up. What happened is in the event
// record below (dom_ev, dom_evf, dom_evs), filled before each call; it is
// good until the callback returns, or calls into the page in a way that
// dispatches another event. Callbacks run after main has returned too:
// main sets the page up and returns, and the program lives on in its
// callbacks.
extern dom_setup(ints: []int, floats: []f64, text: []i8): int;

extern dom_log(s: str): int;

extern dom_log_of(b: []i8, start: int, end: int): int;

// ---- the tree ----
// Handles that always exist.
DOM_WINDOW: int = 1;

DOM_DOCUMENT: int = 2;

DOM_BODY: int = 3;

DOM_HEAD: int = 4;

// document.documentElement, location, history.
DOM_ROOT: int = 5;

DOM_LOCATION: int = 6;

DOM_HISTORY: int = 7;

extern dom_create(tag: str): int;

extern dom_create_svg(tag: str): int;

extern dom_text(s: str): int;

extern dom_text_of(b: []i8, start: int, end: int): int;

extern dom_fragment(): int;

extern dom_by_id(id: str): int;

// The first node under h that matches a CSS selector.
extern dom_query(h: int, selector: str): int;

extern dom_parent(h: int): int;

extern dom_append(parent: int, child: int): int;

// child put before before (at the end for 0).
extern dom_insert(parent: int, child: int, before: int): int;

// Taken out of the page (kept, with its handle).
extern dom_remove(h: int): int;

// Every child of h taken out, their handles freed.
extern dom_clear(h: int): int;

extern dom_free(h: int): int;

// h's handle and every handle under it freed.
extern dom_free_tree(h: int): int;

// How many handles are held (for leaks).
extern dom_handles(): int;

// ---- content ----
extern dom_set_text(h: int, s: str): int;

extern dom_set_text_of(
    h: int,
    b: []i8,
    start: int,
    end: int
): int;

// h's text (textContent) into out: its whole length.
extern dom_get_text(h: int, out: []i8): int;

extern dom_set_html(h: int, s: str): int;

extern dom_set_html_of(
    h: int,
    b: []i8,
    start: int,
    end: int
): int;

extern dom_set_attr(h: int, name: str, value: str): int;

extern dom_set_attr_of(
    h: int,
    name: str,
    b: []i8,
    start: int,
    end: int
): int;

extern dom_set_attr_int(h: int, name: str, value: int): int;

extern dom_remove_attr(h: int, name: str): int;

// The attribute's value into out: its whole length, -1 if it has none.
extern dom_get_attr(h: int, name: str, out: []i8): int;

extern dom_set_class(h: int, names: str): int;

extern dom_add_class(h: int, name: str): int;

extern dom_remove_class(h: int, name: str): int;

extern dom_toggle_class(h: int, name: str, on: int): int;

// A style property (or --custom property); "" removes it.
extern dom_set_style(h: int, property: str, value: str): int;

// ---- any property or method of a host object ----
// Numbers and booleans (as 0 and 1); a string property into out (its
// whole length, -1 if it is not one). dom_call calls a method with no
// arguments (play, pause, focus, blur), its number result if it has one;
// a promise it returns is left to settle.
extern dom_set_prop(h: int, name: str, value: f64): int;

extern dom_set_prop_s(h: int, name: str, value: str): int;

extern dom_set_prop_of(
    h: int,
    name: str,
    b: []i8,
    start: int,
    end: int
): int;

extern dom_get_prop(h: int, name: str): f64;

extern dom_get_prop_s(h: int, name: str, out: []i8): int;

extern dom_call(h: int, name: str): f64;

extern dom_call_s(h: int, name: str, arg: str): f64;

// ---- where things are ----
// h's box (getBoundingClientRect) in out: x, y, width, height.
extern dom_rect(h: int, out: []f64): int;

// h's scroll in out: left, top, scrollWidth, scrollHeight, clientWidth,
// clientHeight. For DOM_WINDOW: scrollX, scrollY, the document's size, and
// innerWidth, innerHeight.
extern dom_scroll(h: int, out: []f64): int;

extern dom_scroll_to(
    h: int,
    x: f64,
    y: f64,
    smooth: int
): int;

// block: 0 start, 1 center, 2 end, 3 nearest.
extern dom_scroll_into_view(h: int, block: int, smooth: int): int;

// ---- events ----
// flags: prevent the default always, passive, capture, once.
DOM_PREVENT: int = 1;

DOM_PASSIVE: int = 2;

DOM_CAPTURE: int = 4;

DOM_ONCE: int = 8;

// A listener on h for events of a type (click, keydown, popstate ...): its
// id, which the record's DE_ID has when it calls f.
extern dom_listen(
    h: int,
    kind: str,
    flags: int,
    f: fn(data: int),
    data: int
): int;

extern dom_unlisten(id: int): int;

// For the event being handled.
extern dom_prevent_default(): int;

extern dom_stop_propagation(): int;

// The event record. Ints: the listener, timer or request's id; the target
// (the nearest node to it with a handle) and the node listened on; the
// modifier keys (DOM_SHIFT ...); the button, buttons and detail (the
// clicks' count); the lengths of the type and the key in dom_evs (the type
// first, then the key); a status (a fetch's HTTP status, 0 if it failed; a
// media query's matches) and a size (a fetch's body). Floats: clientX,
// clientY, deltaX, deltaY, the event's time (ms), and a value (a frame's
// time).
dom_ev: []int = new int[16](0);

dom_evf: []f64 = new f64[8](0.0f64);

dom_evs: []i8 = new i8[256](0i8);

DE_ID: int = 0;

DE_TARGET: int = 1;

DE_CURRENT: int = 2;

DE_MODS: int = 3;

DE_BUTTON: int = 4;

DE_BUTTONS: int = 5;

DE_DETAIL: int = 6;

DE_TYPE_LEN: int = 7;

DE_KEY_LEN: int = 8;

DE_STATUS: int = 9;

DE_SIZE: int = 10;

DF_X: int = 0;

DF_Y: int = 1;

DF_DX: int = 2;

DF_DY: int = 3;

DF_TIME: int = 4;

DF_VALUE: int = 5;

DOM_SHIFT: int = 1;

DOM_CTRL: int = 2;

DOM_ALT: int = 4;

DOM_META: int = 8;

// Before any other call.
dom_start() {
    dom_setup(dom_ev, dom_evf, dom_evs)
}

// Whether the event's type (or key) is s.
dom_event_is(s: str): bool {
    dom_evs_is(0, dom_ev[DE_TYPE_LEN], s)
}

dom_key_is(s: str): bool {
    dom_evs_is(dom_ev[DE_TYPE_LEN], dom_ev[DE_KEY_LEN], s)
}

dom_evs_is(at: int, n: int, s: str): bool {
    if (n != len(s)) return false;
    for i in 0..n {
        if (dom_evs[at + i] != s[i]) return false
    }
    true
}

// ---- the selection ----
// The selection in out: its start's node (the nearest with a handle) and
// byte offset in that node's text, then its end's. 0 if there is none, 1 if
// it is a caret, 2 a range.
extern dom_selection(out: []int): int;

// Its text into out: its whole length.
extern dom_selection_text(out: []i8): int;

// Select from byte start of a's text to byte end of b's.
extern dom_select(
    a: int,
    start: int,
    b: int,
    end: int
): int;

extern dom_select_none(): int;

// ---- history and location ----
// pushState and replaceState, of a URL (relative to the page's). popstate
// is a window event (dom_listen(DOM_WINDOW, "popstate", ...)); where the
// page is, DOM_LOCATION's href, pathname, search and hash (dom_get_prop_s).
extern dom_push_state(url: str): int;

extern dom_replace_state(url: str): int;

extern dom_push_state_of(b: []i8, start: int, end: int): int;

extern dom_replace_state_of(b: []i8, start: int, end: int): int;

dom_set_title(s: str) {
    dom_set_prop_s(DOM_DOCUMENT, "title", s)
}

// ---- fetch ----
// A GET of url: its id. f is called when it is done or has failed, with the
// record's DE_STATUS (0 failed) and DE_SIZE. Then dom_fetch_take copies the
// body into out from at (as much as fits: how much), or dom_fetch_body
// gives it as new memory that is never freed (as a file mapped on an
// iPhone is: a callback cannot be noregion, so cannot keep what it makes
// with new); either lets it go. Take a body that way only outside any
// region, as a callback from the page is.
extern dom_fetch(url: str, f: fn(data: int), data: int): int;

extern dom_fetch_take(id: int, out: []i8, at: int): int;

extern dom_fetch_body(id: int): []i8;

// ---- storage (localStorage, text) ----
// A key's value into out: its whole length, -1 if there is none.
extern dom_store_get(key: str, out: []i8): int;

extern dom_store_set(key: str, value: []i8, n: int): int;

extern dom_store_set_s(key: str, value: str): int;

extern dom_store_remove(key: str): int;

extern dom_store_count(): int;

// The i-th key into out: its whole length, -1 past the end.
extern dom_store_key(i: int, out: []i8): int;

// ---- time ----
// Milliseconds, as performance.now and Date.now.
extern dom_now(): f64;

extern dom_date_now(): f64;

// A timer's or frame's id, which dom_cancel cancels; f is called with
// DE_ID its id (a frame's time in DF_VALUE).
extern dom_timeout(ms: f64, f: fn(data: int), data: int): int;

extern dom_interval(ms: f64, f: fn(data: int), data: int): int;

extern dom_frame(f: fn(data: int), data: int): int;

extern dom_cancel(id: int): int;

// ---- media queries ----
// Whether a query matches now; and a listener for its changes (DE_STATUS
// whether it matches), its id for dom_unlisten.
extern dom_media(query: str): int;

extern dom_media_listen(query: str, f: fn(data: int), data: int): int

// Audio is an <audio> element: dom_create("audio"), its src set with
// dom_set_prop_s, played with dom_call(h, "play") and paused with "pause",
// its currentTime, duration and paused read and set as properties, and its
// timeupdate, ended, play, pause, error ... events listened to.
