tag blockguy_internal;

use_tag std, skate_math;

import "../../stdlib/print.l8";

// ---- poses ----
// Angles are in radians; places in his own frame (see shape.l8).
//
// The body, about the pelvis: pitch (+ its top toward +z), roll (+ its top
// toward +x) and yaw (+ turning +z toward +x), applied yaw, then pitch,
// then roll; the pelvis moved down by drop (m, + down) and forward by
// shift. Squash makes the body that much taller (its width and depth
// thinner to keep its volume), and breath that many times as tall, both
// about its base. The limbs hang from it as squashed (a shoulder rides the
// squash) but are never squashed themselves.
tag blockguy
type GuyBody = {
    pitch: f32;
    roll: f32;
    yaw: f32;
    drop: f32;
    shift: f32;
    squash: f32;
    breath: f32
}

// An arm: the shoulder's flex (+ forward and up), abduction (+ out to its
// side and up) and twist (about the arm), the elbow's bend (+ the forearm
// forward; never back), and the forearm's twist (which way the mitt's flat
// face turns). The shoulder turns twist, then abduction, then flex.
tag blockguy
type GuyArm = {
    flex: f32;
    abduct: f32;
    twist: f32;
    elbow: f32;
    forearm_twist: f32
}

// A leg's joints: the hip's flex (+ the knee forward), abduction (+ the
// foot out) and twist, turned as the shoulder's are; the knee's bend (+ the
// heel back; never forward); the ankle's (+ the toe up), and the foot's
// roll about its own length (+ its +x edge up), so that its sole can lie on
// a tipped board. And its squash:
// the thigh and shin each that many times as long along themselves (the
// joints below following, nothing sheared, the foot never squashed), from
// GUY_SQUASH_LEAST up to GUY_STRETCH_MOST; so that a leg can be shorter
// and stay two clean slabs, as a knee bent far could not, or stretch, as a
// toy's does, to reach the ground from his board.
tag blockguy
type GuyLeg = {
    flex: f32;
    abduct: f32;
    twist: f32;
    knee: f32;
    ankle: f32;
    roll: f32;
    squash: f32
}

tag blockguy
const GUY_SQUASH_LEAST: f32 = 0.75;

tag blockguy
const GUY_STRETCH_MOST: f32 = 2.0;

// What a game asks of him: the body; where each ankle is (in his frame),
// how its foot is turned (yaw, as the body's; pitch, + toe up), and how
// squashed the leg is; and the arms by their angles, or reaching a hand
// (the mitt's middle) to a place in his frame, as far as hand_reach (0,
// by the angles, to 1, at the place). Side 0 is -x. guy_solve finds the
// joints.
tag blockguy
type GuyPose = {
    body: GuyBody;
    ankle: [2]V3;
    foot_yaw: [2]f32;
    foot_pitch: [2]f32;
    leg_squash: [2]f32;
    arms: [2]GuyArm;
    hand: [2]V3;
    hand_reach: [2]f32;
    // How much of the body's yaw his hips turn with (see GUY_HIPS_YAW).
    hips_yaw: f32;
    // Each foot's roll about its length (+ its +x edge up).
    foot_roll: [2]f32;
    // How far each foot is held square to its shin (its ankle at 0) in
    // place of turned by foot_yaw and foot_pitch: 0 to 1 (a leg posed by
    // its angles, in the air, say, is 1).
    foot_square: [2]f32;
    // A foot pinned by its toe's tip (the middle of the sole's front edge)
    // to pin_point (in his frame), turned pin_yaw, in place of its ankle
    // and turning: flat if the leg can stand so, else its heel lifted
    // about the toe's edge as little as it must, up to heel_lift_most (see
    // guy_solve).
    pin: [2]bool;
    pin_point: [2]V3;
    pin_yaw: [2]f32;
    heel_lift_most: [2]f32;
    // And at the least (a heel peeling on schedule, as a stride's does).
    heel_lift_least: [2]f32;
    // How far a pinned foot's ankle may bend (toe up) before its heel
    // lifts instead: its range's end unless asked otherwise; less keeps
    // the foot following the shin, its toe pointed; more (up to
    // GUY_ANKLE_GROUNDED) lets a foot flat on the ground bend further, the
    // shin pressing into its top.
    pin_ankle_most: [2]f32
}

// Every joint's angle: a pose solved (see guy_solve), or held; and how
// much of the body's yaw the hips take.
tag blockguy
type GuyJoints = {
    body: GuyBody;
    legs: [2]GuyLeg;
    arms: [2]GuyArm;
    hips_yaw: f32;
    // For a pinned foot (see GuyPose.pin): how far its leg falls short of
    // reaching it, or its ankle of bending far enough to keep it flat on
    // its toe, at the most heel lift (m; 0 if neither), for the caller to
    // lift the foot off; and how far the heel is lifted.
    pin_short: [2]f32;
    heel_lift: [2]f32
}

no_arm(): GuyArm {
    GuyArm {
        flex: 0.0,
        abduct: 0.0,
        twist: 0.0,
        elbow: 0.0,
        forearm_twist: 0.0
    }
}

// Standing: upright, feet under the hips, arms at his sides.
tag blockguy
guy_stand(): GuyPose {
    GuyPose {
        body: GuyBody {
            pitch: 0.0,
            roll: 0.0,
            yaw: 0.0,
            drop: 0.0,
            shift: 0.0,
            squash: 0.0,
            breath: 1.0
        },
        ankle: [v3(-GUY_HIP_X, GUY_ANKLE_UP, GUY_PELVIS_Z), v3(GUY_HIP_X, GUY_ANKLE_UP,
            GUY_PELVIS_Z)],
        foot_yaw: [0.0, 0.0],
        foot_pitch: [0.0, 0.0],
        leg_squash: [1.0, 1.0],
        arms: [no_arm(), no_arm()],
        hand: [v3(0.0, 0.0, 0.0), v3(0.0, 0.0, 0.0)],
        hand_reach: [0.0, 0.0],
        hips_yaw: GUY_HIPS_YAW,
        foot_roll: [0.0, 0.0],
        foot_square: [0.0, 0.0],
        pin: [false, false],
        pin_point: [v3(0.0, 0.0, 0.0), v3(0.0, 0.0, 0.0)],
        pin_yaw: [0.0, 0.0],
        heel_lift_most: [GUY_HEEL_LIFT_MOST, GUY_HEEL_LIFT_MOST],
        heel_lift_least: [0.0, 0.0],
        pin_ankle_most: [GUY_ANKLE_MOST, GUY_ANKLE_MOST]
    }
}

// The way from a to b, t of it.
tag blockguy
guy_mix(a: GuyPose, b: GuyPose, t: f32): GuyPose {
    r: GuyPose = a;
    r.body = GuyBody {
        pitch: lerpf(a.body.pitch, b.body.pitch, t),
        roll: lerpf(a.body.roll, b.body.roll, t),
        yaw: lerpf(a.body.yaw, b.body.yaw, t),
        drop: lerpf(a.body.drop, b.body.drop, t),
        shift: lerpf(a.body.shift, b.body.shift, t),
        squash: lerpf(a.body.squash, b.body.squash, t),
        breath: lerpf(a.body.breath, b.body.breath, t)
    };
    for i in 0..2 {
        r.ankle[i] = v_lerp(a.ankle[i], b.ankle[i], t);
        r.foot_yaw[i] = lerpf(a.foot_yaw[i], b.foot_yaw[i], t);
        r.foot_pitch[i] = lerpf(a.foot_pitch[i], b.foot_pitch[i], t);
        r.leg_squash[i] = lerpf(a.leg_squash[i], b.leg_squash[i], t);
        r.arms[i] = mix_arm(a.arms[i], b.arms[i], t);
        r.hand[i] = v_lerp(a.hand[i], b.hand[i], t);
        r.hand_reach[i] = lerpf(a.hand_reach[i], b.hand_reach[i], t);
        r.foot_roll[i] = lerpf(a.foot_roll[i], b.foot_roll[i], t);
        r.foot_square[i] = lerpf(a.foot_square[i], b.foot_square[i], t);
        r.pin_point[i] = v_lerp(a.pin_point[i], b.pin_point[i], t);
        r.pin_yaw[i] = lerpf(a.pin_yaw[i], b.pin_yaw[i], t);
        r.heel_lift_most[i] = lerpf(a.heel_lift_most[i], b.heel_lift_most[i], t);
        r.heel_lift_least[i] = lerpf(a.heel_lift_least[i], b.heel_lift_least[i], t);
        r.pin_ankle_most[i] = lerpf(a.pin_ankle_most[i], b.pin_ankle_most[i], t);
        // (Pinned if both are; a pin is not half there.)
        r.pin[i] = a.pin[i] && b.pin[i]
    }
    r.hips_yaw = lerpf(a.hips_yaw, b.hips_yaw, t);
    r
}

tag blockguy
mix_arm(a: GuyArm, b: GuyArm, t: f32): GuyArm {
    GuyArm {
        flex: lerpf(a.flex, b.flex, t),
        abduct: lerpf(a.abduct, b.abduct, t),
        twist: lerpf(a.twist, b.twist, t),
        elbow: lerpf(a.elbow, b.elbow, t),
        forearm_twist: lerpf(a.forearm_twist, b.forearm_twist, t)
    }
}

// ---- joints ----
// Each joint by its number: the body's three (the same on both sides),
// then each side's, in GUY_JOINT_TABLE's order.
tag blockguy
const GUY_JOINT_BODY_PITCH: int = 0;

tag blockguy
const GUY_JOINT_BODY_ROLL: int = 1;

tag blockguy
const GUY_JOINT_BODY_YAW: int = 2;

tag blockguy
const GUY_JOINT_HIP_FLEX: int = 3;

tag blockguy
const GUY_JOINT_HIP_ABDUCT: int = 4;

tag blockguy
const GUY_JOINT_HIP_TWIST: int = 5;

tag blockguy
const GUY_JOINT_KNEE: int = 6;

tag blockguy
const GUY_JOINT_ANKLE: int = 7;

tag blockguy
const GUY_JOINT_SHOULDER_FLEX: int = 8;

tag blockguy
const GUY_JOINT_SHOULDER_ABDUCT: int = 9;

tag blockguy
const GUY_JOINT_SHOULDER_TWIST: int = 10;

tag blockguy
const GUY_JOINT_ELBOW: int = 11;

tag blockguy
const GUY_JOINT_FOREARM_TWIST: int = 12;

tag blockguy
const GUY_JOINT_ANKLE_ROLL: int = 13;

tag blockguy
const GUY_JOINTS: int = GUY_JOINT_ANKLE_ROLL + 1;

// A joint's name (as a person might give it, for tools: see
// programs/skate/stage.l8) and its range, in degrees, low and high: as far
// as a person's go, about.
type GuyJointRange = {
    name: str;
    low: f32;
    high: f32
}

// (By number: see the test below, which holds each at its place.)
GUY_JOINT_TABLE: []GuyJointRange = [GuyJointRange { name: "body_pitch", low: -20.0, high: 40.0 },
    GuyJointRange { name: "body_roll", low: -25.0, high: 25.0 }, GuyJointRange { name: "body_yaw", low: -90.0, high: 90.0 },
    GuyJointRange { name: "hip_flex", low: -30.0, high: 110.0 }, GuyJointRange { name: "hip_abduct", low: -10.0, high: 40.0 },
    GuyJointRange { name: "hip_twist", low: -40.0, high: 40.0 }, GuyJointRange { name: "knee", low: 0.0, high: 140.0 },
    GuyJointRange { name: "ankle", low: -30.0, high: 30.0 }, GuyJointRange { name: "shoulder_flex", low: -60.0, high: 170.0 },
    GuyJointRange { name: "shoulder_abduct", low: -10.0, high: 170.0 }, GuyJointRange { name: "shoulder_twist", low: -80.0, high: 80.0 },
    GuyJointRange { name: "elbow", low: 0.0, high: 145.0 }, GuyJointRange { name: "forearm_twist", low: -90.0, high: 90.0 },
    GuyJointRange { name: "ankle_roll", low: -15.0, high: 15.0 }];

tag blockguy
guy_joint_name(joint: int): str {
    GUY_JOINT_TABLE[joint].name
}

// The joint of that name, or -1.
tag blockguy
guy_joint_named(name: str): int {
    for joint in 0..GUY_JOINTS {
        if (GUY_JOINT_TABLE[joint].name == name) return joint
    }
    -1
}

const DEGREE: f32 = 0.017453292;

// A joint's angle by its number, on a side (the body's are the same on
// both); and set.
tag blockguy
guy_joint(j: GuyJoints, joint: int, side: int): f32 {
    leg: GuyLeg = j.legs[side];
    arm: GuyArm = j.arms[side];
    if (joint == GUY_JOINT_BODY_PITCH) return j.body.pitch;
    if (joint == GUY_JOINT_BODY_ROLL) return j.body.roll;
    if (joint == GUY_JOINT_BODY_YAW) return j.body.yaw;
    if (joint == GUY_JOINT_HIP_FLEX) return leg.flex;
    if (joint == GUY_JOINT_HIP_ABDUCT) return leg.abduct;
    if (joint == GUY_JOINT_HIP_TWIST) return leg.twist;
    if (joint == GUY_JOINT_KNEE) return leg.knee;
    if (joint == GUY_JOINT_ANKLE) return leg.ankle;
    if (joint == GUY_JOINT_SHOULDER_FLEX) return arm.flex;
    if (joint == GUY_JOINT_SHOULDER_ABDUCT) return arm.abduct;
    if (joint == GUY_JOINT_SHOULDER_TWIST) return arm.twist;
    if (joint == GUY_JOINT_ELBOW) return arm.elbow;
    if (joint == GUY_JOINT_ANKLE_ROLL) return leg.roll;
    arm.forearm_twist
}

tag blockguy
guy_set_joint(
    j: *GuyJoints,
    joint: int,
    side: int,
    angle: f32
) {
    if (joint == GUY_JOINT_BODY_PITCH) j.body.pitch = angle;
    if (joint == GUY_JOINT_BODY_ROLL) j.body.roll = angle;
    if (joint == GUY_JOINT_BODY_YAW) j.body.yaw = angle;
    if (joint == GUY_JOINT_HIP_FLEX) j.legs[side].flex = angle;
    if (joint == GUY_JOINT_HIP_ABDUCT) j.legs[side].abduct = angle;
    if (joint == GUY_JOINT_HIP_TWIST) j.legs[side].twist = angle;
    if (joint == GUY_JOINT_KNEE) j.legs[side].knee = angle;
    if (joint == GUY_JOINT_ANKLE) j.legs[side].ankle = angle;
    if (joint == GUY_JOINT_SHOULDER_FLEX) j.arms[side].flex = angle;
    if (joint == GUY_JOINT_SHOULDER_ABDUCT) j.arms[side].abduct = angle;
    if (joint == GUY_JOINT_SHOULDER_TWIST) j.arms[side].twist = angle;
    if (joint == GUY_JOINT_ELBOW) j.arms[side].elbow = angle;
    if (joint == GUY_JOINT_FOREARM_TWIST) j.arms[side].forearm_twist = angle;
    if (joint == GUY_JOINT_ANKLE_ROLL) j.legs[side].roll = angle
}

// A joint's range (rad), low and high.
tag blockguy
guy_limit_low_of(joint: int): f32 {
    GUY_JOINT_TABLE[joint].low * DEGREE
}

tag blockguy
guy_limit_high_of(joint: int): f32 {
    GUY_JOINT_TABLE[joint].high * DEGREE
}

// Every joint within its range.
tag blockguy
guy_clamp(j: GuyJoints): GuyJoints {
    r: GuyJoints = j;
    for side in 0..2 r.legs[side].squash = clampf(r.legs[side].squash, GUY_SQUASH_LEAST,
        GUY_STRETCH_MOST);
    for joint in 0..GUY_JOINTS {
        for side in 0..2 guy_set_joint(&r, joint, side, clampf(guy_joint(r, joint,
            side), guy_limit_low_of(joint), guy_limit_high_of(joint)))
    }
    r
}

// How far past its range the joint that is furthest past it is (0 if none
// is), and which joint and side it is.
tag blockguy
type GuyExcess = {
    angle: f32;
    joint: int;
    side: int
}

tag blockguy
guy_excess(j: GuyJoints): GuyExcess {
    worst: GuyExcess = GuyExcess { angle: 0.0, joint: -1, side: 0 };
    for joint in 0..GUY_JOINTS {
        for side in 0..2 {
            a: f32 = guy_joint(j, joint, side);
            past: f32 = maxf(guy_limit_low_of(joint) - a, a - guy_limit_high_of(joint));
            if (past > worst.angle) worst = GuyExcess { angle: past, joint: joint, side: side }
        }
    }
    worst
}

// ---- solving ----
// The pose's joints, as asked, limits or not (see guy_solve): the body
// as asked; each leg reaching its ankle (two-bone IK, its bones squashed
// as asked: the knee in the plane of the hip, the ankle and the way its
// foot points, bent forward that way) and turning its foot as asked as far
// as the ankle goes; each arm by its angles, or reaching its hand (the
// elbow bent down and back) as far as asked.
tag blockguy
guy_solve_unlimited(p: GuyPose): GuyJoints {
    j: GuyJoints = GuyJoints {
        body: p.body,
        legs: [no_leg(), no_leg()],
        arms: p.arms,
        hips_yaw: p.hips_yaw,
        pin_short: [0.0, 0.0],
        heel_lift: [0.0, 0.0]
    };
    mat_identity(solve_root);
    pelvis_frame(p.body, solve_root, solve_pelvis);
    body_frame(p.body, solve_pelvis, solve_body);
    hips_frame(p.body, p.hips_yaw, solve_root, solve_hips);
    for side in 0..2 {
        s: f32 = guy_side_sign(side);
        squash: f32 = clampf(p.leg_squash[side], GUY_SQUASH_LEAST, GUY_STRETCH_MOST);
        hip: V3 = mat_point(solve_hips, v3(s * GUY_HIP_X, 0.0, 0.0));
        fwd: V3 = foot_forward(p.foot_yaw[side], p.foot_pitch[side]);
        reach: TwoBone = two_bone(hip, p.ankle[side], GUY_THIGH * squash, GUY_SHIN * squash,
            fwd);
        // The thigh's frame: down along it, its z the way the knee bends.
        tz: V3 = reach.bend_way;
        ty: V3 = v_scale(reach.upper, -1.0);
        tx: V3 = v_cross(ty, tz);
        leg: GuyLeg = limb_angles(solve_hips, tx, ty, tz, s);
        leg.knee = reach.bend;
        leg.squash = squash;
        leg.roll = p.foot_roll[side];
        j.legs[side] = leg;
        if (p.hand_reach[side] > 0.0) j.arms[side] = mix_arm(p.arms[side], arm_reaching(side,
            p.hand[side]), minf(p.hand_reach[side], 1.0))
    }
    // The ankles, from where the shins are once the hips and knees are
    // within their ranges.
    limited: GuyJoints = guy_clamp(j);
    guy_bones(limited, solve_root, solve_bones, 0);
    for side in 0..2 {
        shin: []f32 = bone_view(solve_bones, guy_shin(side));
        fwd: V3 = foot_forward(p.foot_yaw[side], p.foot_pitch[side]);
        sy: V3 = v_norm(v3(shin[4], shin[5], shin[6]));
        sz: V3 = v_norm(v3(shin[8], shin[9], shin[10]));
        j.legs[side].ankle = atan2f(v_dot(fwd, sy), v_dot(fwd, sz)) * (1.0 - clampf(p.foot_square[side],
            0.0, 1.0))
    }
    j
}

// An arm reaching its mitt's middle to `hand` (in his frame, the body as
// solve_body has it), its elbow bent down and back.
arm_reaching(side: int, hand: V3): GuyArm {
    s: f32 = guy_side_sign(side);
    shoulder: V3 = mat_point(solve_body, v_sub(guy_shoulder(side), guy_pelvis()));
    reach: TwoBone = two_bone(shoulder, hand, GUY_UPPER_ARM, GUY_MITT, v3(0.0, -1.0,
        -1.0));
    // (The forearm comes forward of the elbow: the upper arm's z is away
    // from the way the elbow goes.)
    tz: V3 = v_scale(reach.bend_way, -1.0);
    ty: V3 = v_scale(reach.upper, -1.0);
    tx: V3 = v_cross(ty, tz);
    angles: GuyLeg = limb_angles(solve_pelvis, tx, ty, tz, s);
    GuyArm {
        flex: angles.flex,
        abduct: angles.abduct,
        twist: angles.twist,
        elbow: reach.bend,
        forearm_twist: 0.0
    }
}

// How much further back than asked the pelvis goes, at most, so that his
// ankles need bend no further than their range (see guy_solve).
tag blockguy
const GUY_SHIFT_BACK: f32 = 0.06;

// How far an ankle bends (toe up) before the pelvis goes back instead (see
// guy_solve): the shins are as deep as the legs, and turning one at an
// ankle so near the sole swings its bottom's front edge down through the
// sole, a centimetre for every 5 degrees or so past this.
tag blockguy
const GUY_ANKLE_EASY: f32 = 0.14;

body_within(body: GuyBody): GuyBody {
    b: GuyBody = body;
    b.pitch = clampf(b.pitch, guy_limit_low_of(GUY_JOINT_BODY_PITCH), guy_limit_high_of(GUY_JOINT_BODY_PITCH));
    b.roll = clampf(b.roll, guy_limit_low_of(GUY_JOINT_BODY_ROLL), guy_limit_high_of(GUY_JOINT_BODY_ROLL));
    b.yaw = clampf(b.yaw, guy_limit_low_of(GUY_JOINT_BODY_YAW), guy_limit_high_of(GUY_JOINT_BODY_YAW));
    b
}

// The pose's joints, each within its range. Where an ankle would bend
// past GUY_ANKLE_EASY, the pelvis first goes back (up to GUY_SHIFT_BACK),
// so the shin leans less, as a person squatting sits back; then the ankle
// bends, up to its range.
tag blockguy
guy_solve(p: GuyPose): GuyJoints {
    // (The body within its range first: the legs reach from where it is.)
    asked: GuyPose = p;
    asked.body = body_within(asked.body);
    pinned: bool = false;
    for side in 0..2 {
        if (asked.pin[side]) {
            pin_foot(&asked, side, minf(asked.heel_lift_least[side], asked.heel_lift_most[side]));
            pinned = true
        }
    }
    j: GuyJoints = guy_solve_unlimited(asked);
    // A pinned foot stands flat (or with its heel lifted as little as
    // asked) if its leg can; else its heel lifts about its toe's edge as
    // little more as it must (by halves: 8 steps), up to as far as asked.
    lift: [2]f32 = [0.0, 0.0];
    for side in 0..2 {
        if (asked.pin[side]) lift[side] = minf(asked.heel_lift_least[side], asked.heel_lift_most[side]);
        if (asked.pin[side] && !pin_holds(j, asked, side)) {
            low: f32 = lift[side];
            high: f32 = asked.heel_lift_most[side];
            pin_foot(&asked, side, high);
            j = guy_solve_unlimited(asked);
            if (pin_holds(j, asked, side)) {
                for _step in 0..8 {
                    mid: f32 = (low + high) * 0.5;
                    pin_foot(&asked, side, mid);
                    if (pin_holds(guy_solve_unlimited(asked), asked, side)) high = mid else low = mid
                }
                pin_foot(&asked, side, high);
                j = guy_solve_unlimited(asked)
            }
            lift[side] = high
        }
    }
    // (Pinned, the feet hold the pelvis where it is: they lift their
    // heels in place of its going back.)
    if (pinned) {
        for side in 0..2 {
            j.heel_lift[side] = lift[side];
            // (Short of reach, or of the ankle's range: past it, the toe
            // would be dragged as far as the foot is long times the angle.)
            if (asked.pin[side]) j.pin_short[side] = maxf(maxf(leg_reach_needed(j,
                asked, side) - leg_reach_most(j, side), (j.legs[side].ankle - asked.pin_ankle_most[side]) * GUY_FOOT_FRONT),
                0.0)
        }
        // (A foot on the ground may bend its ankle as far as the pose
        // allows, past the range in the air: the shin pressing into the
        // foot's top.)
        within: GuyJoints = guy_clamp(j);
        for side in 0..2 {
            if (asked.pin[side]) within.legs[side].ankle = clampf(j.legs[side].ankle,
                guy_limit_low_of(GUY_JOINT_ANKLE), maxf(asked.pin_ankle_most[side],
                guy_limit_high_of(GUY_JOINT_ANKLE)))
        }
        return within
    }
    for _round in 0..4 {
        // (By the two ankles' mean, and not so far that a knee goes
        // straight: going back reaches one leg's foot as it eases the
        // other's.)
        past: f32 = 0.0;
        straight: bool = false;
        for side in 0..2 {
            past = past + (j.legs[side].ankle - GUY_ANKLE_EASY) * 0.5;
            straight = straight || j.legs[side].knee < 0.17
        }
        if (past > 0.001 && !straight) {
            // (About as far as a shin as long as his, leaning that much
            // less, comes back at the knee.)
            asked.body.shift = maxf(asked.body.shift - past * GUY_SHIN, p.body.shift - GUY_SHIFT_BACK);
            j = guy_solve_unlimited(asked)
        }
    }
    guy_clamp(j)
}

hip_frame_m: []f32 = new f32[16](0.0);

hip_root_m: []f32 = new f32[16](0.0);

// Where (in his frame) the hip of `side` is, the body as `body` has it and
// the hips turned `hips_yaw` of its yaw (see GuyPose.hips_yaw).
tag blockguy
guy_hip(body: GuyBody, hips_yaw: f32, side: int): V3 {
    mat_identity(hip_root_m);
    hips_frame(body, hips_yaw, hip_root_m, hip_frame_m);
    mat_point(hip_frame_m, v3(guy_side_sign(side) * GUY_HIP_X, 0.0, 0.0))
}

// The ankle's range's end (toe up), for GuyPose.pin_ankle_most; and how
// far a foot pinned on the ground may bend (38 degrees).
tag blockguy
const GUY_ANKLE_MOST: f32 = 0.5236;

tag blockguy
const GUY_ANKLE_GROUNDED: f32 = 0.6632;

// The most heel lift, unless a pose asks otherwise.
tag blockguy
const GUY_HEEL_LIFT_MOST: f32 = 0.21;

// The pose with its pinned foot `side` put by its toe's tip, its heel
// lifted `lift` about the toe's edge.
pin_foot(p: *GuyPose, side: int, lift: f32) {
    yaw: f32 = p.pin_yaw[side];
    across: V3 = v3(cosf(yaw), 0.0, -sinf(yaw));
    fwd: V3 = v_rotate(yaw_dir(yaw), across, lift);
    up: V3 = v_rotate(v3(0.0, 1.0, 0.0), across, lift);
    p.ankle[side] = v_madd(v_madd(p.pin_point[side], up, GUY_ANKLE_UP), fwd, -GUY_FOOT_FRONT);
    p.foot_yaw[side] = yaw;
    p.foot_pitch[side] = -lift
}

// Whether the leg, as solved in j, reaches its pinned foot with its ankle
// within its range.
pin_holds(j: GuyJoints, p: GuyPose, side: int): bool {
    j.legs[side].ankle <= p.pin_ankle_most[side] && leg_reach_needed(j, p, side) <= leg_reach_most(j,
        side) * 0.999
}

// How far the leg's ankle (as the pose puts it) is from its hip (as j's
// body puts it), and the farthest it reaches.
leg_reach_needed(j: GuyJoints, p: GuyPose, side: int): f32 {
    v_len(v_sub(p.ankle[side], guy_hip(j.body, j.hips_yaw, side)))
}

leg_reach_most(j: GuyJoints, side: int): f32 {
    (GUY_THIGH + GUY_SHIN) * j.legs[side].squash
}

leg_bones: []f32 = new f32[GUY_BONES * 16](0.0);

leg_root: []f32 = new f32[16](0.0);

// His joints standing (worked out once).
standing_joints: GuyJoints = guy_solve(guy_stand());

// Where (in his frame) a leg's ankle is with its hip and knee bent so far,
// out so far (abduct), and squashed so much, the body as `body` has it
// (its hips turned the usual share of its yaw: GUY_HIPS_YAW): for poses
// that put the legs by their angles (in the air, say) to give guy_solve
// as ankle places.
tag blockguy
guy_leg_ankle(
    body: GuyBody,
    side: int,
    flex: f32,
    knee: f32,
    abduct: f32,
    squash: f32
): V3 {
    j: GuyJoints = standing_joints;
    j.body = body;
    j.legs[side] = GuyLeg {
        flex: flex,
        abduct: abduct,
        twist: 0.0,
        knee: knee,
        ankle: 0.0,
        roll: 0.0,
        squash: squash
    };
    mat_identity(leg_root);
    guy_bones(j, leg_root, leg_bones, 0);
    guy_bone_point(leg_bones, 0, guy_foot(side), v3(0.0, 0.0, 0.0))
}

// How far from hip to ankle a leg reaches with its knee bent so far and
// squashed so much.
tag blockguy
guy_leg_reach(knee: f32, squash: f32): f32 {
    a: f32 = GUY_THIGH * squash;
    b: f32 = GUY_SHIN * squash;
    sqrtf(a * a + b * b + 2.0 * a * b * cosf(knee))
}

no_leg(): GuyLeg {
    GuyLeg {
        flex: 0.0,
        abduct: 0.0,
        twist: 0.0,
        knee: 0.0,
        ankle: 0.0,
        roll: 0.0,
        squash: 1.0
    }
}

solve_root: []f32 = new f32[16](0.0);

solve_pelvis: []f32 = new f32[16](0.0);

solve_hips: []f32 = new f32[16](0.0);

solve_body: []f32 = new f32[16](0.0);

solve_bones: []f32 = new f32[GUY_BONES * 16](0.0);

bone_scratch: []f32 = new f32[16](0.0);

// A bone's matrix out of a palette (a copy, in scratch).
bone_view(bones: []f32, bone: int): []f32 {
    for k in 0..16 bone_scratch[k] = bones[bone * 16 + k];
    bone_scratch
}

foot_forward(yaw: f32, pitch: f32): V3 {
    v3(sinf(yaw) * cosf(pitch), sinf(pitch), cosf(yaw) * cosf(pitch))
}

// A two-bone limb from `root` reaching `target`, its bones `upper` and
// `lower` long, bent toward `toward`: which way the upper bone points, the
// way the bend goes (square to it, in the limb's plane), and how far the
// bend is from straight. A target out of reach is reached for, straight.
tag blockguy
type TwoBone = {
    upper: V3;
    bend_way: V3;
    bend: f32
}

tag blockguy
two_bone(
    root: V3,
    target: V3,
    upper: f32,
    lower: f32,
    toward: V3
): TwoBone {
    d: V3 = v_sub(target, root);
    dist: f32 = clampf(v_len(d), absf(upper - lower) + 0.001, upper + lower - 0.0001);
    u: V3 = v_norm(d);
    if (v_len(d) < 0.0001) u = v3(0.0, -1.0, 0.0);
    // The way to bend: toward, square to the reach (or forward, if toward
    // is along it).
    f: V3 = v_reject(toward, u);
    if (v_len(f) < 0.0001) f = v_reject(v3(0.0, 0.0, 1.0), u);
    f = v_norm(f);
    // (By the law of cosines: the angle at the root between the reach and
    // the upper bone, and the bend's inner angle.)
    at_root: f32 = acos_clamped((upper * upper + dist * dist - lower * lower) / (2.0 * upper * dist));
    inner: f32 = acos_clamped((upper * upper + lower * lower - dist * dist) / (2.0 * upper * lower));
    up: V3 = v_add(v_scale(u, cosf(at_root)), v_scale(f, sinf(at_root)));
    way: V3 = v_sub(v_scale(f, cosf(at_root)), v_scale(u, sinf(at_root)));
    TwoBone { upper: up, bend_way: way, bend: PI - inner }
}

acos_clamped(c: f32): f32 {
    k: f32 = clampf(c, -1.0, 1.0);
    atan2f(sqrtf(maxf(1.0 - k * k, 0.0)), k)
}

// The angles turning a limb's frame (its axes x, y, z, in its parent's
// frame `parent`) from standing: flex, then abduction, then twist, as
// Rx(-flex) Rz(s abduct) Ry(s twist), s the side's sign.
limb_angles(
    parent: []f32,
    x: V3,
    y: V3,
    z: V3,
    s: f32
): GuyLeg {
    px: V3 = v3(parent[0], parent[1], parent[2]);
    py: V3 = v3(parent[4], parent[5], parent[6]);
    pz: V3 = v3(parent[8], parent[9], parent[10]);
    // (Its axes in the parent's: m_rc is axis c's along the parent's r.)
    m00: f32 = v_dot(px, x);
    m01: f32 = v_dot(px, y);
    m02: f32 = v_dot(px, z);
    m11: f32 = v_dot(py, y);
    m21: f32 = v_dot(pz, y);
    b: f32 = atan2f(-m01, sqrtf(maxf(1.0 - m01 * m01, 0.0)));
    a: f32 = atan2f(m21, m11);
    c: f32 = atan2f(m02, m00);
    GuyLeg {
        flex: -a,
        abduct: s * b,
        twist: s * c,
        knee: 0.0,
        ankle: 0.0,
        roll: 0.0,
        squash: 1.0
    }
}

// ---- bones ----
// The pelvis's frame (from his frame, root): moved and turned as the body
// is.
pelvis_frame(body: GuyBody, root: []f32, out: []f32) {
    mat_copy(out, root);
    mat_translate(out, v3(0.0, GUY_PELVIS_Y - body.drop, GUY_PELVIS_Z + body.shift));
    mat_rotate(out, v3(0.0, 1.0, 0.0), body.yaw);
    mat_rotate(out, v3(1.0, 0.0, 0.0), body.pitch);
    mat_rotate(out, v3(0.0, 0.0, 1.0), -body.roll)
}

// How much of the body's yaw and roll his hips turn with, as a rule: the
// block turns and leans above them, so that a wound or leaning body does
// not stand one leg straight and fold the other. (A pose may turn the hips
// more: see GuyPose.hips_yaw.)
tag blockguy
const GUY_HIPS_YAW: f32 = 0.5;

tag blockguy
const GUY_HIPS_ROLL: f32 = 0.35;

// The hips' frame: as the pelvis's, with yaw_share of the body's yaw and
// GUY_HIPS_ROLL of its roll (and all of its pitch), unsquashed.
hips_frame(
    body: GuyBody,
    yaw_share: f32,
    root: []f32,
    out: []f32
) {
    hips: GuyBody = body;
    hips.yaw = body.yaw * yaw_share;
    hips.roll = body.roll * GUY_HIPS_ROLL;
    pelvis_frame(hips, root, out)
}

bone_hips: []f32 = new f32[16](0.0);

// The body's matrix: the pelvis's, squashed and breathing about its base.
body_frame(body: GuyBody, pelvis: []f32, out: []f32) {
    mat_copy(out, pelvis);
    base: V3 = v3(0.0, GUY_HEM - GUY_PELVIS_Y, 0.0);
    sy: f32 = maxf(1.0 + body.squash, 0.2);
    across: f32 = 1.0 / sqrtf(sy);
    mat_translate(out, base);
    mat_scale(out, v3(across, sy * body.breath, across));
    mat_translate(out, v_scale(base, -1.0))
}

bone_pelvis: []f32 = new f32[16](0.0);

bone_body: []f32 = new f32[16](0.0);

bone_m: []f32 = new f32[16](0.0);

// A joint's frame on the body: the pelvis's axes (not squashed), at a
// place on the body (which is).
joint_on_body(at: V3) {
    mat_copy(bone_m, bone_pelvis);
    p: V3 = mat_point(bone_body, at);
    bone_m[12] = p.x;
    bone_m[13] = p.y;
    bone_m[14] = p.z
}

put_bone(
    out: []f32,
    first: int,
    bone: int,
    m: []f32
) {
    for k in 0..16 out[(first + bone) * 16 + k] = m[k]
}

squash_m: []f32 = new f32[16](0.0);

// A squashed piece's bone: its joint's frame m, squashed along its y
// (before it is turned, so that nothing shears; what hangs below takes m
// itself, not this).
put_bone_squashed(
    out: []f32,
    first: int,
    bone: int,
    m: []f32,
    squash: f32
) {
    mat_copy(squash_m, m);
    mat_scale(squash_m, v3(1.0, squash, 1.0));
    put_bone(out, first, bone, squash_m)
}

// Turn the frame m as a limb's root joint does (see limb_angles).
turn_limb(
    m: []f32,
    flex: f32,
    abduct: f32,
    twist: f32,
    s: f32
) {
    mat_rotate(m, v3(1.0, 0.0, 0.0), -flex);
    mat_rotate(m, v3(0.0, 0.0, 1.0), s * abduct);
    mat_rotate(m, v3(0.0, 1.0, 0.0), s * twist)
}

// Each bone's matrix but the board's (GUY_BOARD's is the game's), into out
// from matrix `first` on: from the frame of each bone's piece as built
// (see guy_build) to where root (his frame, as the game places it) puts it.
tag blockguy
guy_bones(
    j: GuyJoints,
    root: []f32,
    out: []f32,
    first: int
) {
    pelvis_frame(j.body, root, bone_pelvis);
    body_frame(j.body, bone_pelvis, bone_body);
    hips_frame(j.body, j.hips_yaw, root, bone_hips);
    put_bone(out, first, GUY_BODY, bone_body);
    pelvis_place: V3 = guy_pelvis();
    for side in 0..2 {
        s: f32 = guy_side_sign(side);
        leg: GuyLeg = j.legs[side];
        mat_copy(bone_m, bone_hips);
        mat_translate(bone_m, v3(s * GUY_HIP_X, 0.0, 0.0));
        turn_limb(bone_m, leg.flex, leg.abduct, leg.twist, s);
        put_bone(out, first, guy_hip_drum(side), bone_m);
        put_bone_squashed(out, first, guy_thigh(side), bone_m, leg.squash);
        mat_translate(bone_m, v3(0.0, -GUY_THIGH * leg.squash, 0.0));
        put_bone(out, first, guy_knee_drum(side), bone_m);
        mat_rotate(bone_m, v3(1.0, 0.0, 0.0), leg.knee);
        put_bone_squashed(out, first, guy_shin(side), bone_m, leg.squash);
        mat_translate(bone_m, v3(0.0, -GUY_SHIN * leg.squash, 0.0));
        mat_rotate(bone_m, v3(1.0, 0.0, 0.0), -leg.ankle);
        mat_rotate(bone_m, v3(0.0, 0.0, 1.0), leg.roll);
        put_bone(out, first, guy_foot(side), bone_m);
        arm: GuyArm = j.arms[side];
        shoulder: V3 = v_sub(guy_shoulder(side), pelvis_place);
        joint_on_body(shoulder);
        turn_limb(bone_m, arm.flex, arm.abduct, arm.twist, s);
        put_bone(out, first, guy_upper_arm(side), bone_m);
        mat_translate(bone_m, v3(0.0, -GUY_UPPER_ARM, 0.0));
        mat_rotate(bone_m, v3(1.0, 0.0, 0.0), -arm.elbow);
        mat_rotate(bone_m, v3(0.0, 1.0, 0.0), s * arm.forearm_twist);
        put_bone(out, first, guy_forearm(side), bone_m)
    }
}

// ---- measures ----
// A point in a bone's frame, where bones (a palette from guy_bones, from
// matrix `first`) put it.
tag blockguy
guy_bone_point(
    bones: []f32,
    first: int,
    bone: int,
    p: V3
): V3 {
    b: int = (first + bone) * 16;
    v3(bones[b] * p.x + bones[b + 4] * p.y + bones[b + 8] * p.z + bones[b + 12], bones[b + 1] * p.x + bones[b + 5] * p.y + bones[b + 9] * p.z + bones[b + 13],
        bones[b + 2] * p.x + bones[b + 6] * p.y + bones[b + 10] * p.z + bones[b + 14])
}

point_bones: []f32 = new f32[GUY_BONES * 16](0.0);

point_root: []f32 = new f32[16](0.0);

// A point in a bone's frame (as built: see guy_build), where the joints
// put it in his own frame (not the world's: guy_bones with a root does
// that): a hand's place on a shin, say.
tag blockguy
guy_point_on(j: GuyJoints, bone: int, p: V3): V3 {
    mat_identity(point_root);
    guy_bones(j, point_root, point_bones, 0);
    guy_bone_point(point_bones, 0, bone, p)
}

// The middle of the foot's toe edge on the sole (what a pinned foot is
// pinned by), in its foot's frame.
tag blockguy
guy_toe_tip(): V3 {
    v3(0.0, -GUY_ANKLE_UP, GUY_FOOT_FRONT)
}

// How far an arm twists about itself as it rises out to its side, so that
// its broad face stays upright and turns to the front: a quarter turn
// from 40 to 100 degrees out, as far as the shoulder twists (for
// GuyArm.twist).
tag blockguy
guy_flipper_twist(abduct: f32): f32 {
    -GUY_FLIPPER_MOST * smoothstepf(0.698, 1.745, abduct)
}

// (As far as the shoulder's twist goes: 80 degrees.)
const GUY_FLIPPER_MOST: f32 = 1.396;

// The middle of a foot's sole, and of a mitt.
tag blockguy
guy_sole(bones: []f32, first: int, side: int): V3 {
    guy_bone_point(bones, first, guy_foot(side), v3(0.0, -GUY_ANKLE_UP, (GUY_FOOT_FRONT - GUY_FOOT_BACK) * 0.5))
}

// His middle (his centre of mass) where bones put him: each piece's
// middle (see guy_build) weighed by its share of him, as a person's are
// (the body with the head most of him; each leg a sixth; each arm a
// twentieth). Not the board's.
tag blockguy
guy_middle(bones: []f32, first: int): V3 {
    sum: V3 = v_scale(guy_bone_point(bones, first, GUY_BODY, v3(0.0, (GUY_HEM + GUY_H) * 0.5 - GUY_PELVIS_Y,
        -GUY_PELVIS_Z)), MASS_BODY);
    shin: f32 = GUY_SHIN + GUY_ANKLE_UP - SHIN_OFF_SOLE;
    for side in 0..2 {
        sum = v_madd(sum, guy_bone_point(bones, first, guy_thigh(side), v3(0.0, -GUY_THIGH * 0.5,
            0.0)), MASS_THIGH);
        sum = v_madd(sum, guy_bone_point(bones, first, guy_shin(side), v3(0.0, -shin * 0.5,
            0.0)), MASS_SHIN);
        sum = v_madd(sum, guy_bone_point(bones, first, guy_foot(side), v3(0.0, GUY_FOOT_H * 0.5 - GUY_ANKLE_UP,
            (GUY_FOOT_FRONT - GUY_FOOT_BACK) * 0.5)), MASS_FOOT);
        sum = v_madd(sum, guy_bone_point(bones, first, guy_upper_arm(side), v3(0.0,
            -GUY_UPPER_ARM * 0.5, 0.0)), MASS_ARM_PIECE);
        sum = v_madd(sum, guy_bone_point(bones, first, guy_forearm(side), v3(0.0,
            -GUY_FOREARM * 0.5, 0.0)), MASS_ARM_PIECE)
    }
    sum
}

// The pieces' shares of him (all together, 1).
const MASS_BODY: f32 = 0.58;

const MASS_THIGH: f32 = 0.1;

const MASS_SHIN: f32 = 0.045;

const MASS_FOOT: f32 = 0.015;

const MASS_ARM_PIECE: f32 = 0.025;

// How far the shin's lowest point is above the foot's sole (m; below it,
// less than 0): of the rounds of its bottom's front and back edges,
// measured in the foot's frame.
tag blockguy
guy_shin_clearance(bones: []f32, first: int, side: int): f32 {
    half_d: f32 = GUY_COLUMN_DEPTH * 0.5;
    bottom: f32 = -(GUY_SHIN + GUY_ANKLE_UP - SHIN_OFF_SOLE);
    least: f32 = 1.0;
    for way in [-1.0, 1.0] {
        c: V3 = guy_bone_point(bones, first, guy_shin(side), v3(0.0, bottom + GUY_SHIN_ROUND,
            way * (half_d - GUY_SHIN_ROUND)));
        // (The round's middle in the foot's frame: the foot's matrix is
        // rigid, so its transpose takes it back.)
        f: int = (first + guy_foot(side)) * 16;
        rel: V3 = v3(c.x - bones[f + 12], c.y - bones[f + 13], c.z - bones[f + 14]);
        up: V3 = v_norm(v3(bones[f + 4], bones[f + 5], bones[f + 6]));
        least = minf(least, v_dot(rel, up) - GUY_SHIN_ROUND + GUY_ANKLE_UP)
    }
    least
}

tag blockguy
guy_mitt(bones: []f32, first: int, side: int): V3 {
    guy_bone_point(bones, first, guy_forearm(side), v3(0.0, -GUY_MITT, 0.0))
}

bone_axis(bones: []f32, bone: int, column: int): V3 {
    b: int = bone * 16 + column * 4;
    v_norm(v3(bones[b], bones[b + 1], bones[b + 2]))
}

// How square each hinge is (knees, ankles and elbows: the dot of its axis
// as the upper piece and the lower piece have it, 1 if they agree), the
// least of them: for checking that no hinge ever twists.
tag blockguy
guy_hinge_alignment(bones: []f32, first: int, j: GuyJoints): f32 {
    least: f32 = 1.0;
    for side in 0..2 {
        least = minf(least, v_dot(bone_axis(bones, first + guy_thigh(side), 0), bone_axis(bones,
            first + guy_shin(side), 0)));
        // (The foot's own roll comes after its hinge, as the forearm's
        // twist does after the elbow's.)
        r: f32 = j.legs[side].roll;
        ankle_hinge: V3 = v_sub(v_scale(bone_axis(bones, first + guy_foot(side), 0),
            cosf(r)), v_scale(bone_axis(bones, first + guy_foot(side), 1), sinf(r)));
        least = minf(least, v_dot(bone_axis(bones, first + guy_shin(side), 0), ankle_hinge));
        // (The forearm's own twist comes after its hinge: its hinge's axis
        // is its x turned back by the twist.)
        s: f32 = guy_side_sign(side);
        t: f32 = s * j.arms[side].forearm_twist;
        fx: V3 = bone_axis(bones, first + guy_forearm(side), 0);
        fz: V3 = bone_axis(bones, first + guy_forearm(side), 2);
        hinge: V3 = v_add(v_scale(fx, cosf(t)), v_scale(fz, sinf(t)));
        least = minf(least, v_dot(bone_axis(bones, first + guy_upper_arm(side), 0),
            hinge))
    }
    least
}

// ---- the far side ----
// How much darker his far side's leg and arm are drawn, seen from eye: as
// GUY_FAR_SHADE of their color, blended in as the camera comes round from
// straight behind or in front of him (over GUY_FAR_BLEND of the cosine to
// his side),
// so that from the side his two legs read as two, not one red mass, and
// nothing changes all at once. A renderer multiplies the colors of side
// s's leg and arm bones (see guy_bone_side) by shade s.
tag blockguy
type GuyShade = {
    side0: f32;
    side1: f32
}

tag blockguy
const GUY_FAR_SHADE: f32 = 0.78;

tag blockguy
const GUY_FAR_BLEND: f32 = 0.25;

tag blockguy
guy_side_shade(bones: []f32, first: int, eye: V3): GuyShade {
    b: int = (first + GUY_BODY) * 16;
    // (The body's +x, and the pelvis: its frame's origin.)
    right: V3 = v_norm(v3(bones[b], bones[b + 1], bones[b + 2]));
    to_eye: V3 = v_norm(v_sub(eye, v3(bones[b + 12], bones[b + 13], bones[b + 14])));
    k: f32 = v_dot(to_eye, right);
    // (Seen from his +x side, side 0's limbs are the far ones. Square in
    // front or behind, neither is: only the far side is ever darker.)
    GuyShade { side0: lerpf(1.0, GUY_FAR_SHADE, smoothstepf(0.0, GUY_FAR_BLEND, k)), side1: lerpf(1.0,
        GUY_FAR_SHADE, smoothstepf(0.0, GUY_FAR_BLEND, -k)) }
}

// Which side a bone's limb is on (0 or 1), or -1 for the body and what he
// stands on. (Every leg and arm bone of side 0 is odd: see guy_thigh.)
tag blockguy
guy_bone_side(bone: int): int {
    if (bone < 1 || bone > 14) return -1;
    if (bone % 2 == 1) return 0;
    1
}

test "each joint's name and range are at its number" {
    for joint in [GUY_JOINT_BODY_PITCH, GUY_JOINT_BODY_ROLL, GUY_JOINT_BODY_YAW, GUY_JOINT_HIP_FLEX,
        GUY_JOINT_HIP_ABDUCT, GUY_JOINT_HIP_TWIST, GUY_JOINT_KNEE, GUY_JOINT_ANKLE,
        GUY_JOINT_SHOULDER_FLEX, GUY_JOINT_SHOULDER_ABDUCT, GUY_JOINT_SHOULDER_TWIST,
        GUY_JOINT_ELBOW, GUY_JOINT_FOREARM_TWIST, GUY_JOINT_ANKLE_ROLL] {
        write(1, guy_joint_name(joint));
        write(1, " ");
        write_int(1, GUY_JOINT_TABLE[joint].low as int);
        write(1, " ");
        print_int(GUY_JOINT_TABLE[joint].high as int)
    }
    print_int(len(GUY_JOINT_TABLE) - GUY_JOINTS);
    print_int(guy_joint_named("elbow"));
    expect {|
        body_pitch -20 40
        body_roll -25 25
        body_yaw -90 90
        hip_flex -30 110
        hip_abduct -10 40
        hip_twist -40 40
        knee 0 140
        ankle -30 30
        shoulder_flex -60 170
        shoulder_abduct -10 170
        shoulder_twist -80 80
        elbow 0 145
        forearm_twist -90 90
        ankle_roll -15 15
        0
        11
    |}
}
