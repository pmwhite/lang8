tag blockguy_internal;

use_tag skate_math, blockmesh, builder;

// His measures, in metres, standing, in his own frame: its origin on what
// he stands on, under his hips; +y up; +z the way he faces (his cap's brim
// is that way); +x toward his side 1 (side 0 is -x).
//
// The body: a block GUY_W wide, GUY_D deep, from GUY_HEM up to GUY_H.
tag blockguy
const GUY_W: f32 = 0.62;

tag blockguy
const GUY_D: f32 = 0.6;

tag blockguy
const GUY_H: f32 = 0.93;

tag blockguy
const GUY_HEM: f32 = 0.26;

// The pelvis, which the body turns about, and the hips either side of it
// (the hips at +-GUY_HIP_X, at the pelvis's height and depth: forward of
// the body's middle, so that a leg's front is flush with the body's). The
// hips are high inside the block, a quarter of its height above its hem:
// a leg turning there comes out from under the block as a tilted slab, as
// a toy's leg does from its hips, and its hip's round never shows.
tag blockguy
const GUY_PELVIS_Y: f32 = 0.5;

tag blockguy
const GUY_PELVIS_Z: f32 = 0.05;

tag blockguy
guy_pelvis(): V3 {
    v3(0.0, GUY_PELVIS_Y, GUY_PELVIS_Z)
}

// (The same, for tumbledown's main.l8 until it reads GUY_PELVIS_Y and
// GUY_PELVIS_Z: a constant record, which L8 has no way to declare yet. Not
// to be written to; remove once nothing reads it.)
tag blockguy
GUY_PELVIS: V3 = V3 { x: 0.0, y: GUY_PELVIS_Y, z: GUY_PELVIS_Z };

tag blockguy
const GUY_HIP_X: f32 = 0.164;

// From the hip down to the knee, the knee to the ankle, and the ankle to
// the sole: hip to ankle is 0.45 straight (unsquashed: see GuyLeg), most
// of the thigh inside the block.
tag blockguy
const GUY_THIGH: f32 = 0.29;

tag blockguy
const GUY_SHIN: f32 = 0.16;

tag blockguy
const GUY_ANKLE_UP: f32 = 0.05;

// The foot reaches GUY_FOOT_BACK behind the ankle (its heel flush with the
// leg's back) and GUY_FOOT_FRONT ahead of it (its toe flush with the
// body's front); it is GUY_FOOT_H tall.
tag blockguy
const GUY_FOOT_BACK: f32 = 0.22;

tag blockguy
const GUY_FOOT_FRONT: f32 = 0.25;

tag blockguy
const GUY_FOOT_H: f32 = 0.08;

// A shoulder (GUY_SHOULDER_X out to its side, GUY_SHOULDER_Y up, at the
// body's middle front to back); and from it down to the elbow, the elbow
// to the mitt's middle, and to the mitt's tip.
tag blockguy
const GUY_SHOULDER_X: f32 = 0.31;

tag blockguy
const GUY_SHOULDER_Y: f32 = 0.68;

tag blockguy
guy_shoulder(side: int): V3 {
    v3(guy_side_sign(side) * GUY_SHOULDER_X, GUY_SHOULDER_Y, 0.0)
}

tag blockguy
const GUY_UPPER_ARM: f32 = 0.12;

tag blockguy
const GUY_MITT: f32 = 0.12;

tag blockguy
const GUY_FOREARM: f32 = 0.18;

// Half of a leg's width (the two legs are as wide as the body, but for a
// gap between them), and of an arm's thickness and width.
const LEG_HALF_W: f32 = 0.145;

const ARM_HALF_W: f32 = 0.05;

const ARM_HALF_D: f32 = 0.13;

// How round an arm's edges are (crisp: it is a flat paddle), its top's
// round (hidden in the body's side) and its mitt's.
const ARM_ROUND: f32 = 0.025;

const ARM_TOP_ROUND: f32 = 0.05;

const MITT_ROUND: f32 = 0.05;

// How far above the shoulder the arm's top reaches (inside the body).
const ARM_ABOVE: f32 = 0.02;

// How far inside its limb a joint's drum is, front and back and at its
// sides, so that it never shows through the limb, straight. (Its rims are
// rounder than the limb's upright edges by as much, for the same.)
const DRUM_IN: f32 = 0.001;

// How far the lower piece of a hinge reaches up past the hinge's axis
// into the upper: not at all. A piece's flat end reaching past the axis
// turns out through the drum's round as the hinge bends, a bright sliver;
// and where the two ends meet, straight, any crack shows only the drum,
// just behind, in the same color.
const JOINT_LAP: f32 = 0.0;

// How round the pieces' ends at a hinge are: flat (rounded, they leave a
// groove straight that the drum does not fill).
const HINGE_EDGE: f32 = 0.0;

// How round a leg's upright edges are (and the shin's bottom, which turns
// at the ankle, inside the foot), and how far above the sole the shin
// ends: inside the foot, which is taller, and high enough that its bottom
// edge turning with the ankle seldom passes through the sole.
const LEG_ROUND: f32 = 0.07;

const SHIN_OFF_SOLE: f32 = 0.045;

// How round the shin's bottom is (inside the foot): round enough that,
// with the ankle bent as far as a foot on the ground lets it (see
// GUY_ANKLE_GROUNDED), its edge does not come through the sole.
tag blockguy
const GUY_SHIN_ROUND: f32 = 0.14;

const HIP_DRUM_HALF_W: f32 = 0.095;

// ---- bones ----
// Each piece moves with one bone. A vertex's bone is kept in its material
// code: the code plus GUY_BONE_CODE times the bone (material codes are all
// below it), for the vertex shader to take apart.
tag blockguy
const GUY_BONE_CODE: f32 = 16.0;

tag blockguy
const GUY_BODY: int = 0;

tag blockguy
guy_thigh(side: int): int {
    1 + side
}

tag blockguy
guy_shin(side: int): int {
    3 + side
}

tag blockguy
guy_foot(side: int): int {
    5 + side
}

tag blockguy
guy_upper_arm(side: int): int {
    7 + side
}

tag blockguy
guy_forearm(side: int): int {
    9 + side
}

// The drums of the hip and the knee, which turn with the thigh but are
// never squashed with it (see GuyLeg), so that they stay round.
tag blockguy
guy_hip_drum(side: int): int {
    11 + side
}

tag blockguy
guy_knee_drum(side: int): int {
    13 + side
}

// What he stands on (the game's: a board, or nothing), moving with him as
// the game places it.
tag blockguy
const GUY_BOARD: int = 15;

tag blockguy
const GUY_BONES: int = 16;

// What a vertex shader drawing him needs of the above, as GLSL #define
// lines added to `out`, to put after the shader's #version line (each a
// float, as the shader compares a corner's bone as one):
//
//   GUY_BONE_CODE      the material code's share for the bone: a corner's
//                      bone is floor(code / GUY_BONE_CODE)
//   GUY_SKINNED_BONES  how many bones after his body's (bone 0): the
//                      length of an array of their matrices (a whole
//                      number, for the array's length)
//   GUY_BOARD          the board's bone; his limbs' are those between
//                      the body's and it
//   GUY_ARM_FIRST, GUY_ARM_LAST   his arms' bones, the first and last
//   GUY_SIDE0_ODD      1.0 if side 0's limbs' bones are the odd ones (each
//                      limb's bone on side 1 is the next after side 0's),
//                      0.0 if the even ones
tag blockguy
guy_glsl_defines(out: *ByteBuilder@new) {
    glsl_define(out, "GUY_BONE_CODE", GUY_BONE_CODE as int);
    builder_str(out, "#define GUY_SKINNED_BONES ");
    builder_int(out, GUY_BONES - 1);
    builder_byte(out, 10i8);
    glsl_define(out, "GUY_BOARD", GUY_BOARD);
    // (The upper arms' bones, then the forearms'.)
    glsl_define(out, "GUY_ARM_FIRST", guy_upper_arm(0));
    glsl_define(out, "GUY_ARM_LAST", guy_forearm(1));
    glsl_define(out, "GUY_SIDE0_ODD", guy_thigh(0) % 2)
}

// "#define NAME VALUE.0" and a new line.
glsl_define(out: *ByteBuilder@new, name: str, value: int) {
    builder_str(out, "#define ");
    builder_str(out, name);
    builder_byte(out, 32i8);
    builder_int(out, value);
    builder_str(out, ".0\n")
}

// Which way side `side` is along x.
tag blockguy
guy_side_sign(side: int): f32 {
    if (side == 0) return -1.0;
    1.0
}

// How he is built: his colors and the renderer's material codes for them
// (the body's and limbs', and the cap's), and how deep his legs' columns
// are (front to back; their knees' drums are as round).
tag blockguy
type GuyLook = {
    body_color: V3;
    body_material: f32;
    cap_color: V3;
    cap_material: f32;
    column_depth: f32
}

tag blockguy
const GUY_COLUMN_DEPTH: f32 = 0.44;

piece_m: []f32 = new f32[16](0.0);

// The piece's matrix: in the frame of its bone's joint (its origin at the
// joint, standing), offset by `at`.
piece_at(at: V3) {
    mat_identity(piece_m);
    mat_translate(piece_m, at)
}

// Him, into m, every vertex marked with its bone (all but GUY_BOARD's): in
// each bone's frame, its origin at the bone's joint, standing (see
// guy_bones). Returns how many vertices he took.
tag blockguy
guy_build(m: *Mesh, look: GuyLook): int {
    first: int = m.n;
    body: f32 = look.body_material;
    // The body, from the pelvis: down past the hips, so its rounded bottom
    // hides behind the legs.
    to: V3 = v_scale(guy_pelvis(), -1.0);
    code: f32 = GUY_BONE_CODE * GUY_BODY as f32;
    piece_at(v_add(to, v3(0.0, (GUY_HEM + GUY_H) * 0.5, 0.0)));
    put_rounded_box(m, piece_m, v3(GUY_W * 0.5, (GUY_H - GUY_HEM) * 0.5, GUY_D * 0.5),
        0.1, 0.01, 3, look.body_color, body + code);
    // A cap, for fun, and so that the way he faces shows: a low round crown
    // set a little into his top, and a short brim out in front.
    piece_at(v_add(to, v3(0.0, GUY_H + 0.005, 0.0)));
    put_rounded_box(m, piece_m, v3(GUY_W * 0.5 - 0.03, 0.055, GUY_D * 0.5 - 0.03),
        0.05, 0.012, 2, look.cap_color, look.cap_material + code);
    piece_at(v_add(to, v3(0.0, GUY_H - 0.025, GUY_D * 0.5 + 0.05)));
    put_rounded_box(m, piece_m, v3(0.19, 0.034, 0.1), 0.03, 0.0, 1, look.cap_color,
        look.cap_material + code);
    half_d: f32 = look.column_depth * 0.5;
    for side in 0..2 {
        // The thigh: from the hip's axis to the knee's, its top rounded (it
        // swings out under the body as the hip bends). Its knee end is flat,
        // and each joint is a drum round its axis, as deep as the leg, so
        // that the leg is closed at every bend (the pieces' flat ends meet
        // edge to edge on the axis, their edges on the drum's round), and
        // when straight the drums are inside it, which shows no seam. The
        // hip's drum makes a round seat of the thigh's top swinging out
        // under the body.
        code = GUY_BONE_CODE * guy_thigh(side) as f32;
        piece_at(v3(0.0, -GUY_THIGH * 0.5, 0.0));
        put_column(m, piece_m, v3(LEG_HALF_W, GUY_THIGH * 0.5, half_d), LEG_ROUND,
            HINGE_EDGE, LEG_ROUND, look.body_color, body + code);
        // (The hip's drum is narrower than the leg: it rounds the thigh's
        // top where it swings out at the back, and at full width it would
        // show through the body's rounded corners over the hip.)
        piece_at(v3(0.0, 0.0, 0.0));
        put_drum(m, piece_m, half_d - DRUM_IN, HIP_DRUM_HALF_W, LEG_ROUND, 16, look.body_color,
            body + GUY_BONE_CODE * guy_hip_drum(side) as f32);
        put_drum(m, piece_m, half_d - DRUM_IN, LEG_HALF_W - DRUM_IN, LEG_ROUND + DRUM_IN + 0.005,
            16, look.body_color, body + GUY_BONE_CODE * guy_knee_drum(side) as f32);
        // The shin, from the knee's axis down to just over the sole, its
        // bottom rounded.
        code = GUY_BONE_CODE * guy_shin(side) as f32;
        shin: f32 = GUY_SHIN + GUY_ANKLE_UP - SHIN_OFF_SOLE + JOINT_LAP;
        piece_at(v3(0.0, JOINT_LAP - shin * 0.5, 0.0));
        put_column(m, piece_m, v3(LEG_HALF_W, shin * 0.5, half_d), LEG_ROUND, GUY_SHIN_ROUND,
            HINGE_EDGE, look.body_color, body + code);
        // The foot: a sole under the leg, from its heel to the body's
        // front.
        code = GUY_BONE_CODE * guy_foot(side) as f32;
        piece_at(v3(0.0, GUY_FOOT_H * 0.5 - GUY_ANKLE_UP, (GUY_FOOT_FRONT - GUY_FOOT_BACK) * 0.5));
        put_rounded_box(m, piece_m, v3(LEG_HALF_W, GUY_FOOT_H * 0.5, (GUY_FOOT_FRONT + GUY_FOOT_BACK) * 0.5),
            0.035, 0.002, 1, look.body_color, body + code);
        // The arm: a flat paddle, broad front to back, in two pieces. The
        // upper, from a little above the shoulder (in the body's side) to
        // the elbow's axis; the elbow's drum, as deep as the paddle; the
        // forearm and its mitt in one, its end rounded.
        code = GUY_BONE_CODE * guy_upper_arm(side) as f32;
        upper: f32 = GUY_UPPER_ARM + ARM_ABOVE;
        piece_at(v3(0.0, ARM_ABOVE - upper * 0.5, 0.0));
        put_column(m, piece_m, v3(ARM_HALF_W, upper * 0.5, ARM_HALF_D), ARM_ROUND,
            HINGE_EDGE, ARM_TOP_ROUND, look.body_color, body + code);
        piece_at(v3(0.0, -GUY_UPPER_ARM, 0.0));
        put_drum(m, piece_m, ARM_HALF_D - DRUM_IN, ARM_HALF_W - DRUM_IN, ARM_ROUND + DRUM_IN + 0.005,
            16, look.body_color, body + code);
        code = GUY_BONE_CODE * guy_forearm(side) as f32;
        forearm: f32 = GUY_FOREARM + JOINT_LAP;
        piece_at(v3(0.0, JOINT_LAP - forearm * 0.5, 0.0));
        put_column(m, piece_m, v3(ARM_HALF_W, forearm * 0.5, ARM_HALF_D), ARM_ROUND,
            MITT_ROUND, HINGE_EDGE, look.body_color, body + code)
    }
    m.n - first
}

// Mark the vertices from `first` to the mesh's end as moving with bone:
// for what a game builds to go with him (his board: GUY_BOARD).
tag blockguy
guy_mark_bone(m: *Mesh, first: int, bone: int) {
    for i in first..m.n m.data[i * VERTEX_FLOATS + 9] = m.data[i * VERTEX_FLOATS + 9] + GUY_BONE_CODE * bone as f32
}
