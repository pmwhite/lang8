tag deflate_test;

use_tag std, deflate;

// The library's contract by example. Inputs were made by Python's zlib and
// gzip modules, or (the back-reference too far) written out bit by bit.
import "deflate.l8";

import "../../stdlib/print.l8";

hex_digit(c: i8): int {
    k: int = c as int;
    if (k >= 97) k - 87 else k - 48
}

from_hex(text: str): []i8@new {
    out: []i8 = new i8[len(text) / 2](0i8);
    for i in 0..len(out) out[i] = (hex_digit(text[2 * i]) * 16 + hex_digit(text[2 * i + 1])) trunc i8;
    out
}

print_inflated(hex: str) raises IoError {
    source: []i8 = from_hex(hex);
    try {
        print(cstr(inflate(source, 0, len(source), -1)))
    } with DeflateError error -> {
        print(deflate_failure_name(error.failure))
    }
}

test "blocks of each kind" {
    print_inflated("011700e8ff53746f7265642c206e6f7420636f6d707265737365642e");
    expect {|
        Stored, not compressed.
    |}
    print_inflated("f3cc5328c94855484a4dcfcccbcbcc4b5770cf4f51482e4a4d2c494d01cb64a42696a5e62924e641b8a9894525197a0a9e68daf400");
    expect {|
        In the beginning God created the heaven and the earth. In the beginning.
    |}
    // (Psalm 23:1-4, with codes of its own.)
    print_inflated("");
    expect {|
        The LORD is my shepherd; I shall not want. He maketh me to lie down in green pastures: he leadeth me beside the still waters. He restoreth my soul: he leadeth me in the paths of righteousness for his name's sake. Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou art with me; thy rod and thy staff they comfort me.
    |}
}

test "a back-reference reaches into the block before" {
    // (The first block ends after 24 bytes, flushed; the second refers
    // to its words.)
    print_inflated("722f4a4c4e5548cc4b51284805b14af2152af34b751400000000ffff4bc72aae0700");
    expect {|
        Grace and peace to you, grace and peace to you.
    |}
}

test "codes longer than the lookup table" {
    // (2048 letters, A to L, each twice as common as the one before:
    // Huffman codes alone, the rarest 11 bits long.)
    source: []i8 = from_hex("");
    letters: []i8 = inflate(source, 0, len(source), -1);
    print_int(len(letters));
    print_int(crc32(letters, 0, len(letters)));
    expect {|
        2048
        3475625896
    |}
}

test "the expected size is checked" {
    source: []i8 = from_hex("011700e8ff53746f7265642c206e6f7420636f6d707265737365642e");
    print_int(len(inflate(source, 0, len(source), 23)));
    expect {|
        23
    |}
    try {
        _short: []i8 = inflate(source, 0, len(source), 22)
    } with DeflateError error -> {
        print(deflate_failure_name(error.failure))
    }
    expect {|
        output size differs from the expected size
    |}
}

test "damaged streams are reported" {
    // (A literal, then a back-reference two bytes back.)
    print_inflated("4b044200");
    expect {|
        back-reference before the start of the output
    |}
    print_inflated("07");
    expect {|
        reserved block type
    |}
    // (The dynamic block, cut short, and with a bit of its code lengths
    // changed.)
    print_inflated("5d90b14e04310c447f653a9ad37e00d7528084848468287dc4bb892e1baf6cefadf6ef71222a3a3b9a799ec95766bc7f7cbea018d6139679cbace98ab798a95634711cd47cc22b63a53b7bc6ca70412d8c244743695894b96123f35dd99e11d4ca94fec4");
    expect {|
        input ends before the stream
    |}
    print_inflated("");
    expect {|
        invalid Huffman code lengths
    |}
    // (A stored block's length must match its complement; bytes after the
    // stream are not ignored.)
    print_inflated("011700e8fe53746f7265642c206e6f7420636f6d707265737365642e");
    expect {|
        stored block length and complement disagree
    |}
    print_inflated("011700e8ff53746f7265642c206e6f7420636f6d707265737365642e00");
    expect {|
        data after the end of the stream
    |}
}

test "zlib and gzip containers" {
    z: []i8 = from_hex("789c0b284eccc955303206000cba0283");
    print(cstr(zlib_decompress(z, 0, len(z), -1)));
    expect {|
        Psalm 23
    |}
    damaged: []i8 = from_hex("789c0b284eccc955303206000cba0282");
    try {
        _d: []i8 = zlib_decompress(damaged, 0, len(damaged), 8)
    } with DeflateError error -> {
        print(deflate_failure_name(error.failure))
    }
    expect {|
        checksum mismatch
    |}
    // (Padding after the stream: only the leading form reads past it.)
    padded: []i8 = from_hex("789c0b284eccc955303206000cba02830000");
    print(cstr(zlib_decompress_leading(padded, 0, len(padded), 8)));
    try {
        _p: []i8 = zlib_decompress(padded, 0, len(padded), 8)
    } with DeflateError error -> {
        print(deflate_failure_name(error.failure))
    }
    expect {|
        Psalm 23
        data after the end of the stream
    |}
    // (A gzip header with an extra field, a name, a comment and its CRC.)
    g: []i8 = from_hex("1f8b081e0000000002ff0400534200007073616c6d2e747874006120636f6d6d656e740081ff0bc94855f0f10f7251c82c56c8ad5428ce482dc8482d4ad1030016fe531018000000");
    print(cstr(gzip_decompress(g, 0, len(g))));
    expect {|
        The LORD is my shepherd.
    |}
    // (Its trailer claiming 2 GiB: more than its stream could make.)
    claimed: []i8 = from_hex("1f8b081e0000000002ff0400534200007073616c6d2e747874006120636f6d6d656e740081ff0bc94855f0f10f7251c82c56c8ad5428ce482dc8482d4ad1030016fe5310ffffff7f");
    try {
        _c: []i8 = gzip_decompress(claimed, 0, len(claimed))
    } with DeflateError error -> {
        print(deflate_failure_name(error.failure))
    }
    expect {|
        output size differs from the expected size
    |}
    two: []i8 = from_hex("1f8b0800000000000203cbcf4b5500004961ac23040000001f8b08000000000002032b29cf0700668aca1103000000");
    try {
        _t: []i8 = gzip_decompress(two, 0, len(two))
    } with DeflateError error -> {
        print(deflate_failure_name(error.failure))
    }
    expect {|
        data after the end of the stream
    |}
}

test "checksums" {
    words: []i8 = "The quick brown fox jumps over the lazy dog";
    print_int(crc32(words, 0, len(words)));
    print_int(crc32_update(crc32(words, 0, 10), words, 10, len(words) - 10));
    print_int(adler32(words, 0, len(words)));
    expect {|
        1095738169
        1095738169
        1541148634
    |}
}
