tag sword_folio_test;

use_tag std, sword, folio, sword_folio, builder;

// The library's contract by example.
import "sword_folio.l8";

import "../../stdlib/print.l8";

import "../../stdlib/write.l8";

hex_digit(c: i8): int {
    k: int = c as int;
    if (k >= 97) k - 87 else k - 48
}

from_hex(text: str): []i8@new {
    out: []i8 = new i8[len(text) / 2](0i8);
    for i in 0..len(out) out[i] = (hex_digit(text[2 * i]) * 16 + hex_digit(text[2 * i + 1])) trunc i8;
    out
}

// (sword_test.l8's commentary: Genesis 1:1 and 1:2 in one block.)
test_module_hex: str = "";

test "a commentary's chapters made into a folio's records" {
    zip: []i8 = from_hex(test_module_hex);
    try {
        package: *ModulePackage = package_open(zip, len(zip));
        making: *CommentaryImport = commentary_import_new(verse_module_open(package));
        out: *ByteBuilder = builder_new(256);
        more: bool = true;
        while (more) {
            while (!commentary_import_prepare(making, 1048576)) { }
            more = commentary_import_next(making, out)
        }
        write_bytes_n(1, out.data, out.size);
        print_int(commentary_import_progress(making))
    } with SwordError error -> {
        print(sword_failure_name(error.failure))
    }
    expect {|
        BGEN Genesis
        C1
        K1:1-1:1
        Pm
        TIn the beginning God created the heaven and the earth.
        K1:2-1:2
        Pm
        TAnd the earth was without form, and void.
        1000
    |}
}

show_label(text: str) raises IoError {
    data: []i8 = bytes(text);
    write(1, text);
    write(1, ": ");
    print_int(verse_label_at(data, 0, len(data)))
}

test "a paragraph's first words that label a verse" {
    show_label("Verse 4. \"Yea, though I walk\"");
    show_label("Verses 3-5. The shepherd");
    show_label("Ver. 12.");
    show_label("v. 7, the words");
    show_label("Verse 4\â\€\“The valley");
    show_label("Versed in the law");
    show_label("1. An attractive name");
    expect {|
        Verse 4. "Yea, though I walk": 4
        Verses 3-5. The shepherd: 3
        Ver. 12.: 12
        v. 7, the words: 7
        Verse 4â€“The valley: 4
        Versed in the law: 0
        1. An attractive name: 0
    |}
}

show_reference(
    text: str,
    chapter: int,
    system: *Versification,
    osis: str
) raises IoError {
    data: []i8 = bytes(text);
    write(1, text);
    write(1, ": ");
    print_int(reference_label_at(data, 0, len(data), &system.books[versification_book(system,
        osis)], chapter))
}

test "a reference that begins a paragraph, in the comment's own chapter" {
    try {
        kjv: *Versification = versification_named("KJV");
        show_reference("Gen 1:3-5", 1, kjv, "Gen");
        show_reference("{Mt 1:25 linked from Lk 2:21}", 1, kjv, "Matt");
        show_reference("1Ki 2:3", 2, kjv, "1Kgs");
        show_reference("2:1-12", 2, kjv, "Matt");
        show_reference("Gen.1.3-Gen.1.5", 1, kjv, "Gen");
        // (Another book, another chapter: not the comment's.)
        show_reference("Rom 2:5 says", 2, kjv, "Gen");
        show_reference("Gen 3:1", 2, kjv, "Gen")
    } with SwordError error -> {
        print(sword_failure_name(error.failure))
    }
    expect {|
        Gen 1:3-5: 3
        {Mt 1:25 linked from Lk 2:21}: 25
        1Ki 2:3: 3
        2:1-12: 1
        Gen.1.3-Gen.1.5: 3
        Rom 2:5 says: 0
        Gen 3:1: 0
    |}
}

// A commentary on the Psalms whose entries are uncompressed (RawCom): ot
// holds their markup, ot.vss each verse slot's start in it and size (4 and
// 2 bytes, least significant first). Entries are on chapter 30's verses
// from 1.
psalm_30_commentary(entries: []str) raises SwordError: *ModulePackage@new {
    kjv: *Versification = versification_named("KJV");
    psalms: int = versification_book(kjv, "Ps");
    first: VerseSlot = verse_slot(kjv, psalms, 30, 1);
    text: *ByteBuilder = builder_new(256);
    index: []i8 = new i8[(first.slot + len(entries)) * 6](0i8);
    for k in 0..len(entries) {
        at: int = (first.slot + k) * 6;
        for b in 0..4 index[at + b] = (text.size >> 8 * b) trunc i8;
        for b in 0..2 index[at + 4 + b] = (len(entries[k]) >> 8 * b) trunc i8;
        builder_str(text, entries[k])
    }
    files: []ModuleFile = new ModuleFile[2](ModuleFile {
        path: "ot.vss",
        data: index,
        held: true,
        size: len(index)
    });
    files[1] = ModuleFile {
        path: "ot",
        data: builder_slice(text),
        held: true,
        size: text.size
    };
    package_from_files(bytes("""
[Test]
DataPath=./modules/comments/rawcom/test/
ModDrv=RawCom
SourceType=ThML
Description=A test commentary
"""), files)
}

test "notes marked by label: each mark raised, each note a paragraph, a psalm's title's notes on verse 0" {
    try {
        package: *ModulePackage = psalm_30_commentary(["I will extol thee, O LORD; {b} for thou hast lifted me up.<br /> (a) After Absalom had polluted it. (b) He condemns them for great ingratitude.",
            "O LORD my God, I cried unto thee, and thou hast (c) healed me.<br /> (c) Restored from the rebellion of Absalom."]);
        making: *CommentaryImport = commentary_import_new(verse_module_open(package));
        out: *ByteBuilder = builder_new(256);
        more: bool = true;
        while (more) {
            while (!commentary_import_prepare(making, 1048576)) { }
            more = commentary_import_next(making, out)
        }
        write_bytes_n(1, out.data, out.size)
    } with SwordError error -> {
        print(sword_failure_name(error.failure))
    }
    expect "BPSA Psalms\nC30\nK30:0-30:0\nSTitle\nPm\nEa\nTAfter Absalom had polluted it. \nK30:1-30:1\nPm\nTI will extol thee, O LORD; \nEb\nTfor thou hast lifted me up.\nPm\nEb\nTHe condemns them for great ingratitude.\nK30:2-30:2\nPm\nTO LORD my God, I cried unto thee, and thou hast \nEc\nThealed me.\nPm\nEc\nTRestored from the rebellion of Absalom.\n"
}
