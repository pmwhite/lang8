tag wayland;

need "libEGL.so.1";

need "libwayland-egl.so.1";

extern eglGetPlatformDisplay(platform: u32, native: *i8, attributes: ?*int): ?*i8;

extern eglInitialize(display: *i8, major: *i32, minor: *i32): u32;

extern eglBindAPI(api: u32): u32;

extern eglChooseConfig(
    display: *i8,
    attributes: *i32,
    config: *?*i8,
    count: i32,
    found: *i32
): u32;

extern eglCreateContext(
    display: *i8,
    config: *i8,
    shared: ?*i8,
    attributes: *i32
): ?*i8;

extern eglCreateWindowSurface(
    display: *i8,
    config: *i8,
    window: *i8,
    attributes: ?*i32
): ?*i8;

extern eglMakeCurrent(
    display: *i8,
    draw: ?*i8,
    read: ?*i8,
    context: ?*i8
): u32;

extern eglSwapBuffers(display: *i8, surface: *i8): u32;

extern eglSwapInterval(display: *i8, interval: i32): u32;

extern eglDestroySurface(display: *i8, surface: *i8): u32;

extern eglDestroyContext(display: *i8, context: *i8): u32;

extern eglTerminate(display: *i8): u32;

extern wl_egl_window_create(surface: *i8, width: i32, height: i32): ?*i8;

extern wl_egl_window_destroy(window: *i8): int;

extern wl_egl_window_resize(
    window: *i8,
    width: i32,
    height: i32,
    dx: i32,
    dy: i32
): int
