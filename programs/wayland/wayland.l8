        if (wl_display_dispatch_pending(w.display) < 0i32) {
            w.closed = true;
            return -1;
        }
    }
    if (wl_display_flush(w.display) < 0i32) {
        if (wl_errno().* == 11i32) return 5;
        wl_display_cancel_read(w.display);
        w.closed = true;
        return -1;
    }
    1;
}

wl_window_finish(w: *WLWindow, revents: int) {
    if ((revents & 1) != 0) {
        if (wl_display_read_events(w.display) < 0i32) w.closed = true;
    } else wl_display_cancel_read(w.display);
    if ((revents & 56) != 0 || wl_display_dispatch_pending(w.display) < 0i32) w.closed = true;
}
