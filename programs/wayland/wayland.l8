tag wayland;

import "protocol.l8";

import "egl.l8";

import "keyboard.l8";

import "cursor.l8";

// All retained callback data is allocated in the immortal heap by wl_window_open.
// Keyboard text is buffered here; callbacks never enter application code.
type WLKey = {
    sym: u32;
    size: int;
    text: [64]i8;
};

type WLWindow = {
    display: *i8;
    registry: ?*i8;
    compositor: ?*i8;
    shell: ?*i8;
    seat: ?*i8;
    keyboard: ?*i8;
    pointer: ?*i8;
    shm: ?*i8;
    cursor_theme: ?*i8;
    cursor_surface: ?*i8;
    surface: ?*i8;
    shell_surface: ?*i8;
    toplevel: ?*i8;
    frame: ?*i8;
    decoration_manager: ?*i8;
    decoration: ?*i8;
    egl_display: ?*i8;
    egl_context: ?*i8;
    egl_surface: ?*i8;
    egl_window: ?*i8;
    xkb_context: ?*i8;
    xkb_keymap: ?*i8;
    xkb_state: ?*i8;
    compose_table: ?*i8;
    compose_state: ?*i8;
    width: int;
    height: int;
    pending_width: int;
    pending_height: int;
    configured: bool;
    closed: bool;
    changed: bool;
    frame_ready: bool;
    repeat_key: u32;
    repeat_rate: int;
    repeat_delay: int;
    repeat_at: int;
    key_head: int;
    key_count: int;
    keys: []WLKey;
    compositor_name: u32;
    shell_name: u32;
    seat_name: u32;
};

type WLRegistryListener = {
    global: fn(w: *WLWindow, proxy: *i8, name: u32, interface: *i8, version: u32);
    removed: fn(w: *WLWindow, proxy: *i8, name: u32);
};

type WLShellListener = {
    ping: fn(w: *WLWindow, proxy: *i8, serial: u32);
};

type WLSurfaceListener = {
    configure: fn(w: *WLWindow, proxy: *i8, serial: u32);
};

type WLToplevelListener = {
    configure: fn(w: *WLWindow, proxy: *i8, width: i32, height: i32, states: *WLArray);
    close: fn(w: *WLWindow, proxy: *i8);
};

type WLFrameListener = {
    done: fn(w: *WLWindow, proxy: *i8, time: u32);
};

type WLSeatListener = {
    capabilities: fn(w: *WLWindow, proxy: *i8, caps: u32);
    name: fn(w: *WLWindow, proxy: *i8, name: *i8);
};

type WLKeyboardListener = {
    keymap: fn(w: *WLWindow, proxy: *i8, format: u32, fd: i32, size: u32);
    enter: fn(w: *WLWindow, proxy: *i8, serial: u32, surface: *i8, keys: *WLArray);
    leave: fn(w: *WLWindow, proxy: *i8, serial: u32, surface: *i8);
    key: fn(w: *WLWindow, proxy: *i8, serial: u32, time: u32, key: u32, state: u32);
    modifiers: fn(w: *WLWindow, proxy: *i8, serial: u32, depressed: u32, latched: u32, locked: u32, group: u32);
    repeat: fn(w: *WLWindow, proxy: *i8, rate: i32, delay: i32);
};

extern wl_listen_registry(proxy: *i8, listener: *WLRegistryListener@immortal, data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

extern wl_listen_shell(proxy: *i8, listener: *WLShellListener@immortal, data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

extern wl_listen_surface(proxy: *i8, listener: *WLSurfaceListener@immortal, data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

extern wl_listen_toplevel(proxy: *i8, listener: *WLToplevelListener@immortal, data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

extern wl_listen_frame(proxy: *i8, listener: *WLFrameListener@immortal, data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

extern wl_listen_seat(proxy: *i8, listener: *WLSeatListener@immortal, data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

extern wl_listen_keyboard(proxy: *i8, listener: *WLKeyboardListener@immortal, data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

extern wl_string_equal(a: *i8, b: str): i32 = strcmp;

wl_on_ping(_w: *WLWindow, proxy: *i8, serial: u32) {
    xdg_wm_base_pong(proxy, serial as int);
}

wl_on_close(w: *WLWindow, _proxy: *i8) {
    w.closed = true;
}

wl_on_toplevel(
    w: *WLWindow,
    _proxy: *i8,
    width: i32,
    height: i32,
    _states: *WLArray
) {
    if (width > 0i32) w.pending_width = width as int;
    if (height > 0i32) w.pending_height = height as int;
}

wl_on_configure(w: *WLWindow, proxy: *i8, serial: u32) {
    xdg_surface_ack_configure(proxy, serial as int);
    w.width = w.pending_width;
    w.height = w.pending_height;
    native: ?*i8 = w.egl_window;
    if (native != null) wl_egl_window_resize(native, w.width trunc i32, w.height trunc i32,
        0i32, 0i32);
    w.configured = true;
    w.changed = true;
}

wl_on_frame(w: *WLWindow, proxy: *i8, _time: u32) {
    wl_proxy_destroy(proxy);
    w.frame = null;
    w.frame_ready = true;
}

wl_on_keymap(
    w: *WLWindow,
    _proxy: *i8,
    format: u32,
    fd: i32,
    size: u32
) {
    ctx: ?*i8 = w.xkb_context;
    if (format != 1u32 || size == 0u32 || size > 16777216u32 || ctx == null) {
        wl_close_fd(fd);
        return;
    }
    // MAP_PRIVATE is required by wl_keyboard keymap since seat version 7.
    // mmap failure is checked through errno after clearing it, avoiding raw casts.
    wl_errno().* = 0i32;
    mapped: ?*i8 = wl_map(null, size as int, 1i32, 2i32, fd, 0);
    failed: bool = wl_errno().* != 0i32;
    wl_close_fd(fd);
    if (failed || mapped == null) {
        w.closed = true;
        return;
    }
    keymap: ?*i8 = xkb_keymap_new_from_buffer(ctx, mapped, size as int - 1, 1i32,
        0i32);
    wl_unmap(mapped, size as int);
    if (keymap == null) {
        w.closed = true;
        return;
    }
    state: ?*i8 = xkb_state_new(keymap);
    if (state == null) {
        xkb_keymap_unref(keymap);
        w.closed = true;
        return;
    }
    old_state: ?*i8 = w.xkb_state;
    if (old_state != null) xkb_state_unref(old_state);
    old_keymap: ?*i8 = w.xkb_keymap;
    if (old_keymap != null) xkb_keymap_unref(old_keymap);
    w.xkb_keymap = keymap;
    w.xkb_state = state;
    w.repeat_key = 0u32;
}

wl_on_enter(
    _w: *WLWindow,
    _proxy: *i8,
    _serial: u32,
    _surface: *i8,
    _keys: *WLArray
) { }

wl_on_leave(
    w: *WLWindow,
    _proxy: *i8,
    _serial: u32,
    _surface: *i8
) {
    w.repeat_key = 0u32;
    compose: ?*i8 = w.compose_state;
    if (compose != null) xkb_compose_state_reset(compose);
}

wl_emit_key(w: *WLWindow, key: u32, composing: bool) {
    state: ?*i8 = w.xkb_state;
    if (state == null || w.key_count == 128) return;
    index: int = (w.key_head + w.key_count) % 128;
    sym: u32 = xkb_state_key_get_one_sym(state, key);
    n: int = xkb_state_key_get_utf8(state, key, &w.keys[index].text[0], 64) as int;
    compose: ?*i8 = w.compose_state;
    if (compose != null && composing) {
        xkb_compose_state_feed(compose, sym);
        status: i32 = xkb_compose_state_get_status(compose);
        if (status == 1i32) return;
        if (status == 2i32) n = xkb_compose_state_get_utf8(compose, &w.keys[index].text[0],
            64) as int;
        if (status == 2i32 || status == 3i32) xkb_compose_state_reset(compose);
        if (status == 3i32) return;
    }
    if (n < 0 || n >= 64) n = 0;
    w.keys[index].sym = sym;
    w.keys[index].size = n;
    w.key_count = w.key_count + 1;
}

wl_on_key(
    w: *WLWindow,
    _proxy: *i8,
    _serial: u32,
    _time: u32,
    key: u32,
    state: u32
) {
    code: u32 = (key as int + 8) trunc u32;
    if (state == 1u32) {
        wl_emit_key(w, code, true);
        keymap: ?*i8 = w.xkb_keymap;
        if (keymap != null && w.repeat_rate > 0 && xkb_keymap_key_repeats(keymap,
            code) != 0i32) {
            w.repeat_key = code;
            w.repeat_at = wl_mono_ms() + w.repeat_delay;
        }
    } else if (w.repeat_key == code) w.repeat_key = 0u32;
}

wl_on_modifiers(
    w: *WLWindow,
    _proxy: *i8,
    _serial: u32,
    depressed: u32,
    latched: u32,
    locked: u32,
    group: u32
) {
    state: ?*i8 = w.xkb_state;
    if (state != null) xkb_state_update_mask(state, depressed, latched, locked, 0u32,
        0u32, group);
}

wl_on_repeat(
    w: *WLWindow,
    _proxy: *i8,
    rate: i32,
    delay: i32
) {
    w.repeat_rate = rate as int;
    if (w.repeat_rate > 1000) w.repeat_rate = 1000;
    w.repeat_delay = delay as int;
    if (w.repeat_delay < 0) w.repeat_delay = 0;
    if (w.repeat_rate <= 0) w.repeat_key = 0u32;
}

wl_keyboard_listener: WLKeyboardListener = WLKeyboardListener {
    keymap: &wl_on_keymap,
    enter: &wl_on_enter,
    leave: &wl_on_leave,
    key: &wl_on_key,
    modifiers: &wl_on_modifiers,
    repeat: &wl_on_repeat
};

type WLPointerListener = {
    enter: fn(w: *WLWindow, proxy: *i8, serial: u32, surface: *i8, x: i32, y: i32);
    leave: fn(w: *WLWindow, proxy: *i8, serial: u32, surface: *i8);
    motion: fn(w: *WLWindow, proxy: *i8, time: u32, x: i32, y: i32);
    button: fn(w: *WLWindow, proxy: *i8, serial: u32, time: u32, button: u32, state: u32);
    axis: fn(w: *WLWindow, proxy: *i8, time: u32, axis: u32, value: i32);
    frame: fn(w: *WLWindow, proxy: *i8);
    source: fn(w: *WLWindow, proxy: *i8, source: u32);
    stop: fn(w: *WLWindow, proxy: *i8, time: u32, axis: u32);
    discrete: fn(w: *WLWindow, proxy: *i8, axis: u32, discrete: i32);
};

extern wl_listen_pointer(proxy: *i8, listener: *WLPointerListener@immortal, data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

wl_on_pointer_enter(
    w: *WLWindow,
    proxy: *i8,
    serial: u32,
    _surface: *i8,
    _x: i32,
    _y: i32
) {
    theme: ?*i8 = w.cursor_theme;
    surface: ?*i8 = w.cursor_surface;
    if (theme == null || surface == null) return;
    cursor: ?*WLCursor = wl_cursor_theme_get_cursor(theme, "left_ptr");
    if (cursor == null) return;
    if (cursor.count == 0u32) return;
    image: *WLCursorImage = cursor.images.*;
    buffer: ?*i8 = wl_cursor_image_get_buffer(image);
    if (buffer == null) return;
    wl_pointer_set_cursor(proxy, serial as int, surface, image.hotspot_x as int, image.hotspot_y as int);
    wl_surface_attach(surface, buffer, 0, 0);
    wl_surface_damage(surface, 0, 0, image.width as int, image.height as int);
    wl_surface_commit(surface);
}

wl_on_pointer_motion(
    _w: *WLWindow,
    _proxy: *i8,
    _time: u32,
    _x: i32,
    _y: i32
) { }

wl_on_pointer_button(
    _w: *WLWindow,
    _proxy: *i8,
    _serial: u32,
    _time: u32,
    _button: u32,
    _state: u32
) { }

wl_on_pointer_axis(
    _w: *WLWindow,
    _proxy: *i8,
    _time: u32,
    _axis: u32,
    _value: i32
) { }

wl_on_pointer_frame(_w: *WLWindow, _proxy: *i8) { }

wl_on_pointer_source(_w: *WLWindow, _proxy: *i8, _source: u32) { }

wl_on_pointer_stop(
    _w: *WLWindow,
    _proxy: *i8,
    _time: u32,
    _axis: u32
) { }

wl_on_pointer_discrete(
    _w: *WLWindow,
    _proxy: *i8,
    _axis: u32,
    _discrete: i32
) { }

wl_on_pointer_leave(
    _w: *WLWindow,
    _proxy: *i8,
    _serial: u32,
    _surface: *i8
) { }

wl_pointer_listener: WLPointerListener = WLPointerListener {
    enter: &wl_on_pointer_enter,
    leave: &wl_on_pointer_leave,
    motion: &wl_on_pointer_motion,
    button: &wl_on_pointer_button,
    axis: &wl_on_pointer_axis,
    frame: &wl_on_pointer_frame,
    source: &wl_on_pointer_source,
    stop: &wl_on_pointer_stop,
    discrete: &wl_on_pointer_discrete
};

wl_on_capabilities(w: *WLWindow, proxy: *i8, caps: u32) {
    if ((caps as int & 1) != 0 && w.pointer == null) {
        pointer: ?*i8 = wl_seat_get_pointer(proxy);
        w.pointer = pointer;
        owner: *WLWindow = wl_window_data(proxy);
        if (pointer != null && wl_listen_pointer(pointer, &wl_pointer_listener, owner) != 0i32) w.closed = true;
    } else if ((caps as int & 1) == 0) {
        pointer2: ?*i8 = w.pointer;
        if (pointer2 != null) {
            wl_pointer_release(pointer2);
            w.pointer = null;
        }
    }
    if ((caps as int & 2) != 0 && w.keyboard == null) {
        keyboard: ?*i8 = wl_seat_get_keyboard(proxy);
        if (keyboard != null) {
            w.keyboard = keyboard;
            // The window is immortal; retrieved through the proxy's typed userdata.
            owner: *WLWindow = wl_window_data(proxy);
            if (wl_listen_keyboard(keyboard, &wl_keyboard_listener, owner) != 0i32) w.closed = true;
        }
    } else if ((caps as int & 2) == 0) {
        keyboard2: ?*i8 = w.keyboard;
        if (keyboard2 != null) {
            wl_keyboard_release(keyboard2);
            w.keyboard = null;
        }
        w.repeat_key = 0u32;
    }
}

extern wl_window_data(proxy: *i8): *WLWindow = wl_proxy_get_user_data;

wl_on_seat_name(_w: *WLWindow, _proxy: *i8, _name: *i8) { }

wl_seat_listener: WLSeatListener = WLSeatListener { capabilities: &wl_on_capabilities, name: &wl_on_seat_name };

wl_shell_listener: WLShellListener = WLShellListener { ping: &wl_on_ping };

wl_surface_listener: WLSurfaceListener = WLSurfaceListener { configure: &wl_on_configure };

wl_toplevel_listener: WLToplevelListener = WLToplevelListener { configure: &wl_on_toplevel, close: &wl_on_close };

wl_frame_listener: WLFrameListener = WLFrameListener { done: &wl_on_frame };

type WLDecorationListener = {
    configure: fn(w: *WLWindow, proxy: *i8, mode: u32);
};

extern wl_listen_decoration(proxy: *i8, listener: *WLDecorationListener@immortal,
    data: *WLWindow@immortal): i32 = wl_proxy_add_listener;

wl_on_decoration(_w: *WLWindow, _proxy: *i8, _mode: u32) { }

wl_decoration_listener: WLDecorationListener = WLDecorationListener { configure: &wl_on_decoration };

wl_on_global(
    w: *WLWindow,
    registry: *i8,
    name: u32,
    interface: *i8,
    version: u32
) {
    owner: *WLWindow = wl_window_data(registry);
    if (wl_string_equal(interface, "zxdg_decoration_manager_v1") == 0i32 && w.decoration_manager == null) w.decoration_manager = wl_registry_bind(registry,
        name, &zxdg_decoration_manager_v1_interface, 1u32); else if (wl_string_equal(interface,
        "wl_shm") == 0i32 && w.shm == null) w.shm = wl_registry_bind(registry, name,
        &wl_shm_interface, 1u32); else if (wl_string_equal(interface, "wl_compositor") == 0i32 && w.compositor == null) {
        w.compositor = wl_registry_bind(registry, name, &wl_compositor_interface,
            1u32);
        w.compositor_name = name;
    } else if (wl_string_equal(interface, "xdg_wm_base") == 0i32 && w.shell == null) {
        shell: ?*i8 = wl_registry_bind(registry, name, &xdg_wm_base_interface, 1u32);
        w.shell = shell;
        w.shell_name = name;
        if (shell != null && wl_listen_shell(shell, &wl_shell_listener, owner) != 0i32) w.closed = true;
    } else if (wl_string_equal(interface, "wl_seat") == 0i32 && w.seat == null && version >= 5u32) {
        seat: ?*i8 = wl_registry_bind(registry, name, &wl_seat_interface, 5u32);
        w.seat = seat;
        w.seat_name = name;
        if (seat != null && wl_listen_seat(seat, &wl_seat_listener, owner) != 0i32) w.closed = true;
    }
}

wl_on_removed(w: *WLWindow, _registry: *i8, name: u32) {
    if (name == w.compositor_name || name == w.shell_name) w.closed = true;
    if (name == w.seat_name) {
        pointer: ?*i8 = w.pointer;
        if (pointer != null) {
            wl_pointer_release(pointer);
            w.pointer = null;
        }
        keyboard: ?*i8 = w.keyboard;
        if (keyboard != null) {
            wl_keyboard_release(keyboard);
            w.keyboard = null;
        }
        seat: ?*i8 = w.seat;
        if (seat != null) {
            wl_seat_release(seat);
            w.seat = null;
        }
        w.repeat_key = 0u32;
    }
}

wl_registry_listener: WLRegistryListener = WLRegistryListener { global: &wl_on_global, removed: &wl_on_removed };

wl_window_close(w: *WLWindow) {
    ed: ?*i8 = w.egl_display;
    if (ed != null) {
        eglMakeCurrent(ed, null, null, null);
        es: ?*i8 = w.egl_surface;
        if (es != null) eglDestroySurface(ed, es);
        ec: ?*i8 = w.egl_context;
        if (ec != null) eglDestroyContext(ed, ec);
        eglTerminate(ed);
    }
    native: ?*i8 = w.egl_window;
    if (native != null) wl_egl_window_destroy(native);
    frame: ?*i8 = w.frame;
    if (frame != null) wl_proxy_destroy(frame);
    decoration: ?*i8 = w.decoration;
    if (decoration != null) zxdg_toplevel_decoration_v1_destroy(decoration);
    decoration_manager: ?*i8 = w.decoration_manager;
    if (decoration_manager != null) zxdg_decoration_manager_v1_destroy(decoration_manager);
    top: ?*i8 = w.toplevel;
    if (top != null) xdg_toplevel_destroy(top);
    shell_surface: ?*i8 = w.shell_surface;
    if (shell_surface != null) xdg_surface_destroy(shell_surface);
    surface: ?*i8 = w.surface;
    if (surface != null) wl_surface_destroy(surface);
    keyboard: ?*i8 = w.keyboard;
    if (keyboard != null) wl_keyboard_release(keyboard);
    seat: ?*i8 = w.seat;
    if (seat != null) wl_seat_release(seat);
    shell: ?*i8 = w.shell;
    if (shell != null) xdg_wm_base_destroy(shell);
    compositor: ?*i8 = w.compositor;
    if (compositor != null) wl_proxy_destroy(compositor);
    pointer: ?*i8 = w.pointer;
    if (pointer != null) wl_pointer_release(pointer);
    cursor_surface: ?*i8 = w.cursor_surface;
    if (cursor_surface != null) wl_surface_destroy(cursor_surface);
    theme: ?*i8 = w.cursor_theme;
    if (theme != null) wl_cursor_theme_destroy(theme);
    shm: ?*i8 = w.shm;
    if (shm != null) wl_proxy_destroy(shm);
    registry: ?*i8 = w.registry;
    if (registry != null) wl_proxy_destroy(registry);
    wl_display_flush(w.display);
    wl_display_disconnect(w.display);
    compose: ?*i8 = w.compose_state;
    if (compose != null) xkb_compose_state_unref(compose);
    table: ?*i8 = w.compose_table;
    if (table != null) xkb_compose_table_unref(table);
    state: ?*i8 = w.xkb_state;
    if (state != null) xkb_state_unref(state);
    keymap: ?*i8 = w.xkb_keymap;
    if (keymap != null) xkb_keymap_unref(keymap);
    ctx: ?*i8 = w.xkb_context;
    if (ctx != null) xkb_context_unref(ctx);
}

wl_window_open(
    width: int,
    height: int,
    title: str,
    app_id: str
) noregion: ?*WLWindow@new {
    wl_protocol_init();
    display: ?*i8 = wl_display_connect(null);
    if (display == null) return null;
    keys: []WLKey = new WLKey[128](WLKey { sym: 0u32, size: 0, text: [0i8, 0i8, 0i8,
        0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8,
        0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8,
        0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8,
        0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8,
        0i8] });
    w: *WLWindow = new WLWindow {
        display: display,
        registry: null,
        compositor: null,
        shell: null,
        seat: null,
        keyboard: null,
        pointer: null,
        shm: null,
        cursor_theme: null,
        cursor_surface: null,
        surface: null,
        shell_surface: null,
        toplevel: null,
        frame: null,
        decoration_manager: null,
        decoration: null,
        egl_display: null,
        egl_context: null,
        egl_surface: null,
        egl_window: null,
        xkb_context: null,
        xkb_keymap: null,
        xkb_state: null,
        compose_table: null,
        compose_state: null,
        width: width,
        height: height,
        pending_width: width,
        pending_height: height,
        configured: false,
        closed: false,
        changed: true,
        frame_ready: true,
        repeat_key: 0u32,
        repeat_rate: 0,
        repeat_delay: 600,
        repeat_at: 0,
        key_head: 0,
        key_count: 0,
        keys: keys,
        compositor_name: 0u32,
