tag wayland;

need "libwayland-client.so.0";

type WLInterface = {
    name: str;
    version: i32;
    method_count: i32;
    methods: ?*WLMessage;
    event_count: i32;
    events: ?*WLMessage;
};

type WLMessage = {
    name: str;
    signature: str;
    types: ?*?*WLInterface;
};

type WLArray = {
    size: int;
    alloc: int;
    data: ?*i8;
};

extern wl_empty_marshal(
    proxy: *i8,
    opcode: u32,
    iface: ?*WLInterface@immortal,
    version: u32,
    flags: u32,
    args: ?*i8
): ?*i8 = wl_proxy_marshal_array_flags;

extern wl_proxy_get_version(proxy: *i8): u32;

extern wl_proxy_destroy(proxy: *i8): int;

extern wl_display_connect(name: ?str): ?*i8;

extern wl_display_disconnect(display: *i8): int;

extern wl_display_get_fd(display: *i8): i32;

extern wl_display_roundtrip(display: *i8): i32;

extern wl_display_dispatch(display: *i8): i32;

extern wl_display_dispatch_pending(display: *i8): i32;

extern wl_display_prepare_read(display: *i8): i32;

extern wl_display_read_events(display: *i8): i32;

extern wl_display_cancel_read(display: *i8): int;

extern wl_display_flush(display: *i8): i32;

extern wl_display_get_error(display: *i8): i32;
