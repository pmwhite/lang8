tag wayland;

need "libxkbcommon.so.0";

need "libc.so.6";

extern xkb_context_new(flags: i32): ?*i8;

extern xkb_context_unref(context: *i8): int;

extern xkb_keymap_new_from_buffer(
    context: *i8,
    buffer: *i8,
    length: int,
    format: i32,
    flags: i32
): ?*i8;

extern xkb_keymap_unref(keymap: *i8): int;

extern xkb_state_new(keymap: *i8): ?*i8;

extern xkb_state_unref(state: *i8): int;

extern xkb_state_update_mask(
    state: *i8,
    depressed: u32,
    latched: u32,
    locked: u32,
    group_depressed: u32,
    group_latched: u32,
    group_locked: u32
): u32;

extern xkb_state_key_get_one_sym(state: *i8, key: u32): u32;

extern xkb_state_key_get_utf8(
    state: *i8,
    key: u32,
    buffer: *i8,
    size: int
): i32;

extern xkb_keymap_key_repeats(keymap: *i8, key: u32): i32;

extern xkb_compose_table_new_from_locale(context: *i8, locale: *i8, flags: i32): ?*i8;

extern xkb_compose_table_unref(table: *i8): int;

extern xkb_compose_state_new(table: *i8, flags: i32): ?*i8;

extern xkb_compose_state_unref(state: *i8): int;

extern xkb_compose_state_feed(state: *i8, sym: u32): i32;

extern xkb_compose_state_get_status(state: *i8): i32;

extern xkb_compose_state_get_utf8(state: *i8, buffer: *i8, size: int): i32;

extern xkb_compose_state_reset(state: *i8): int;

extern wl_getenv(name: str): ?*i8 = getenv;

extern wl_map(
    addr: ?*i8,
    length: int,
    prot: i32,
    flags: i32,
    fd: i32,
    offset: int
): ?*i8 = mmap;

extern wl_unmap(addr: *i8, length: int): i32 = munmap;

extern wl_close_fd(fd: i32): i32 = close;

extern wl_errno(): *i32 = __errno_location;

type WLTimespec = {
    sec: int;
    nsec: int;
};

extern wl_clock(clock: i32, ts: *WLTimespec): i32 = clock_gettime;

wl_mono_ms(): int {
    ts: WLTimespec = WLTimespec { sec: 0, nsec: 0 };
    wl_clock(1i32, &ts);
    ts.sec * 1000 + ts.nsec / 1000000;
}
