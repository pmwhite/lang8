tag wayland;

need "libwayland-cursor.so.0";

type WLCursorImage = {
    width: u32;
    height: u32;
    hotspot_x: u32;
    hotspot_y: u32;
    delay: u32
}

type WLCursor = {
    count: u32;
    images: **WLCursorImage;
    name: *i8
}

extern wl_cursor_theme_load(name: ?str, size: i32, shm: *i8): ?*i8;

extern wl_cursor_theme_destroy(theme: *i8): int;

extern wl_cursor_theme_get_cursor(theme: *i8, name: str): ?*WLCursor;

extern wl_cursor_image_get_buffer(image: *WLCursorImage): ?*i8
