tag http_internal;

import "write.l8";

tag http
HTTP_INVALID_DATE: int = -9223372036854775807;

tag http
http_date_at(timestamp: int): str@new {
    http_format_date(timestamp)
}

http_date_after(left: []int, right: []int): bool {
    for i in 0..6 {
        if (left[i] != right[i]) return left[i] > right[i]
    }
    false
}

http_date_digits(s: str, at: int, count: int): int {
    if (at < 0 || count < 1 || at + count > len(s)) return -1;
    value: int = 0;
    for i in 0..count {
        c: i8 = s[at + i];
        if (c < '0' || c > '9') return -1;
        value = value * 10 + c as int - 48
    }
    value
}

http_month(s: str, at: int): int {
    if (at < 0 || at + 3 > len(s)) return 0;
    name: str = http_sub(s, at, at + 3);
    months: []str = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep",
        "Oct", "Nov", "Dec"];
    for i in 0..12 {
        if (name == months[i]) return i + 1
    }
    0
}

http_leap(year: int): bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

http_days_in_month(year: int, month: int): int {
    if (month == 2) {
        if (http_leap(year)) return 29;
        return 28
    }
    if (month == 4 || month == 6 || month == 9 || month == 11) return 30;
    31
}

http_timestamp(parts: []int): int {
    year: int = parts[0];
    month: int = parts[1];
    day: int = parts[2];
    hour: int = parts[3];
    minute: int = parts[4];
    second: int = parts[5];
    if (year < 1 || month < 1 || month > 12 || day < 1 || day > http_days_in_month(year,
        month) || hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 60) return HTTP_INVALID_DATE;
    leap_second: bool = second == 60;
    if (leap_second) second = 59;
    y: int = year;
    if (month <= 2) y = y - 1;
    era: int = http_floor_div(y, 400);
    yoe: int = y - era * 400;
    mp: int = month - 3;
    if (mp < 0) mp = mp + 12;
    doy: int = (153 * mp + 2) / 5 + day - 1;
    doe: int = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    result: int = (era * 146097 + doe - 719468) * 86400 + hour * 3600 + minute * 60 + second;
    if (leap_second) result = result + 1;
    result
}

http_parse_clock(s: str, at: int, parts: []int): bool {
    if (at + 8 > len(s) || s[at + 2] != ':' || s[at + 5] != ':') return false;
    parts[3] = http_date_digits(s, at, 2);
    parts[4] = http_date_digits(s, at + 3, 2);
    parts[5] = http_date_digits(s, at + 6, 2);
    parts[3] >= 0 && parts[4] >= 0 && parts[5] >= 0
}

tag http
http_parse_date_at(s: str, now: int): int {
    parts: []int = new int[6](0);
    if (len(s) == 29 && s[3] == ',' && s[4] == ' ' && s[7] == ' ' && s[11] == ' ' && s[16] == ' ' && http_sub(s,
        25, 29) == " GMT") {
        parts[2] = http_date_digits(s, 5, 2);
        parts[1] = http_month(s, 8);
        parts[0] = http_date_digits(s, 12, 4);
        if (!http_parse_clock(s, 17, parts)) return HTTP_INVALID_DATE;
        return http_timestamp(parts)
    }
    comma: int = 0;
    while (comma < len(s) && s[comma] != ',') comma = comma + 1;
    base: int = comma + 2;
    if (comma >= 6 && comma <= 9 && len(s) == base + 22 && s[comma + 1] == ' ' && s[base + 2] == '-' && s[base + 6] == '-' && s[base + 9] == ' ' && s[base + 18] == ' ' && http_sub(s,
        base + 18, len(s)) == " GMT") {
        parts[2] = http_date_digits(s, base, 2);
        parts[1] = http_month(s, base + 3);
        year2: int = http_date_digits(s, base + 7, 2);
        if (!http_parse_clock(s, base + 10, parts) || year2 < 0) return HTTP_INVALID_DATE;
        current: HttpTm = http_calendar(now);
        year: int = (current.year as int + 1900) / 100 * 100 + year2;
        if (year < current.year as int + 1900) year = year + 100;
        parts[0] = year;
        cutoff: []int = [current.year as int + 1950, current.mon as int + 1, current.mday as int,
            current.hour as int, current.min as int, current.sec as int];
        if (http_date_after(parts, cutoff)) parts[0] = parts[0] - 100;
        return http_timestamp(parts)
    }
    if (len(s) == 24 && s[3] == ' ' && s[7] == ' ' && s[10] == ' ' && s[19] == ' ') {
        parts[1] = http_month(s, 4);
        if (s[8] == ' ') parts[2] = http_date_digits(s, 9, 1) else parts[2] = http_date_digits(s,
            8, 2);
        parts[0] = http_date_digits(s, 20, 4);
        if (!http_parse_clock(s, 11, parts)) return HTTP_INVALID_DATE;
        return http_timestamp(parts)
    }
    HTTP_INVALID_DATE
}

tag http
http_parse_date(s: str): int {
    http_parse_date_at(s, l8_time())
}
