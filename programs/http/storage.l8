tag http_internal;

import "../../stdlib/raw_write.l8";

extern http_storage_exit(code: int): noreturn = l8_exit;

http_storage_full(): noreturn {
    raw::raw_write(2, "http: static storage exhausted\n");
    http_storage_exit(1)
}

// Transaction storage is bounded independently from connection input. A
// checkpoint releases everything created since it, after callers consume it.
const HTTP_STORAGE_BYTES: int = 268435456;

http_storage: []i8 = static_buffer([268435456]i8);

http_storage_used: int = 0;

extern http_count_at(p: *i8): *int = l8_as_int;

extern http_bytes_at(p: *i8): []i8 = l8_as_int;

extern http_text_at(p: *i8): str = l8_as_int;

extern http_readonly_bytes(text: str): []i8 = l8_as_int;

extern http_fields_at(p: *i8): []HttpField = l8_as_int;

http_take_counted(n: int, extra: int): *i8 {
    if (n < 0 || n > HTTP_STORAGE_BYTES - 16 || extra < 0 || extra > 1) http_storage_full();
    span: int = 8 + (n + extra + 7) / 8 * 8;
    if (span > HTTP_STORAGE_BYTES - http_storage_used) http_storage_full();
    pos: int = http_storage_used;
    http_storage_used = pos + span;
    http_count_at(&http_storage[pos]).* = n;
    &http_storage[pos + 8]
}

http_take_bytes(n: int): []i8 {
    http_bytes_at(http_take_counted(n, 0))
}

http_take_text(n: int): *i8 {
    p: *i8 = http_take_counted(n, 1);
    // The byte after the text is physically reserved even for empty text.
    http_storage[http_storage_used - (n + 1 + 7) / 8 * 8 + n] = 0i8;
    p
}

http_take_fields(): []HttpField {
    p: *i8 = http_take_counted(100 * sizeof(HttpField), 0);
    // Replace the byte count with the element count before exposing the view.
    pos: int = http_storage_used - (100 * sizeof(HttpField) + 7) / 8 * 8 - 8;
    http_count_at(&http_storage[pos]).* = 100;
    fields: []HttpField = http_fields_at(p);
    for i in 0..100 fields[i] = HttpField { name: "", value: "" };
    fields
}

http_buffer_objects: []i8 = static_buffer([131072]i8);

http_buffer_used: int = 0;

extern http_buffer_at(p: *i8): *HttpBuffer = l8_as_int;

http_take_buffer(value: HttpBuffer): *HttpBuffer {
    slot: int = http_buffer_used;
    if (slot >= 4096 || sizeof(HttpBuffer) > 32) http_storage_full();
    http_buffer_used = slot + 1;
    out: *HttpBuffer = http_buffer_at(&http_buffer_objects[slot * 32]);
    out.* = value;
    out
}

http_message_objects: []i8 = static_buffer([65536]i8);

http_message_used: int = 0;

extern http_message_at(p: *i8): *HttpMessage = l8_as_int;

http_take_message(value: HttpMessage): *HttpMessage {
    slot: int = http_message_used;
    if (slot >= 256 || sizeof(HttpMessage) > 256) http_storage_full();
    http_message_used = slot + 1;
    out: *HttpMessage = http_message_at(&http_message_objects[slot * 256]);
    out.* = value;
    out
}

http_body_objects: []i8 = static_buffer([16384]i8);

http_body_used: int = 0;

extern http_body_at(p: *i8): *HttpBodyReader = l8_as_int;

http_take_body(value: HttpBodyReader): *HttpBodyReader {
    slot: int = http_body_used;
    if (slot >= 128 || sizeof(HttpBodyReader) > 128) http_storage_full();
    http_body_used = slot + 1;
    out: *HttpBodyReader = http_body_at(&http_body_objects[slot * 128]);
    out.* = value;
    out
}

http_upload_objects: []i8 = static_buffer([4096]i8);

http_upload_used: int = 0;

extern http_upload_at(p: *i8): *HttpUpload = l8_as_int;

http_take_upload(value: HttpUpload): *HttpUpload {
    slot: int = http_upload_used;
    if (slot >= 64 || sizeof(HttpUpload) > 64) http_storage_full();
    http_upload_used = slot + 1;
    out: *HttpUpload = http_upload_at(&http_upload_objects[slot * 64]);
    out.* = value;
    out
}

tag http
type HttpCheckpoint = {
    bytes: int;
    buffers: int;
    messages: int;
    bodies: int;
    uploads: int;
    ranges: int
}

tag http
http_checkpoint(): HttpCheckpoint {
    HttpCheckpoint {
        bytes: http_storage_used,
        buffers: http_buffer_used,
        messages: http_message_used,
        bodies: http_body_used,
        uploads: http_upload_used,
        ranges: http_ranges_used
    }
}

tag http
http_rewind(mark: HttpCheckpoint) {
    if (mark.bytes < 0 || mark.bytes > http_storage_used || mark.buffers < 0 || mark.buffers > http_buffer_used || mark.messages < 0 || mark.messages > http_message_used || mark.bodies < 0 || mark.bodies > http_body_used || mark.uploads < 0 || mark.uploads > http_upload_used || mark.ranges < 0 || mark.ranges > http_ranges_used) http_storage_full();
    http_storage_used = mark.bytes;
    http_buffer_used = mark.buffers;
    http_message_used = mark.messages;
    http_body_used = mark.bodies;
    http_upload_used = mark.uploads;
    http_ranges_used = mark.ranges
}

// Connection objects and their 8 KiB input buffers survive transaction rewind.
http_reader_objects: []i8 = static_buffer([8192]i8);

http_reader_used: []bool = static_buffer([32]bool);

http_client_objects: []i8 = static_buffer([1024]i8);

type HttpInputStorage = {
    count: int;
    data: [8192]i8
}

http_inputs: []HttpInputStorage = static_buffer([32]HttpInputStorage);

extern http_reader_at(p: *i8): *HttpReader = l8_as_int;

extern http_client_at(p: *i8): *HttpClient = l8_as_int;

http_reader_slot(): int {
    slot: int = 0;
    while (slot < 32 && http_reader_used[slot]) slot = slot + 1;
    if (slot == 32 || sizeof(HttpReader) > 256 || sizeof(HttpClient) > 32) http_storage_full();
    http_reader_used[slot] = true;
    http_inputs[slot].count = 8192;
    slot
}

extern http_input_at(p: *i8): []i8 = l8_as_int;

http_ranges_objects: []i8 = static_buffer([131072]i8);

http_ranges_used: int = 0;

extern http_ranges_at(p: *i8): *HttpRanges = l8_as_int;

http_take_ranges(value: HttpRanges): *HttpRanges {
    slot: int = http_ranges_used;
    if (slot >= 256 || sizeof(HttpRanges) > 512) http_storage_full();
    http_ranges_used = slot + 1;
    out: *HttpRanges = http_ranges_at(&http_ranges_objects[slot * 512]);
    out.* = value;
    out
}
