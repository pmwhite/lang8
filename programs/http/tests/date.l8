tag http_tests;

use_tag http, http_internal;

import "../semantics.l8";

emit_date(text: str, now: int) {
    value: int = http_parse_date_at(text, now);
    out: *HttpBuffer = http_buffer();
    if (value < 0) {
        http_text(out, "-");
        value = 0 - value
    }
    http_number(out, value);
    http_text(out, "\n");
    write(1, out.data, out.size)
}

main(): int {
    // RFC 850 two-digit years roll back a century only when more than fifty
    // years in the future. The boundary includes the full timestamp.
    now: int = 1789562096;
    emit_date("Tuesday, 15-Sep-76 12:34:56 GMT", now);
    emit_date("Wednesday, 16-Sep-76 11:34:56 GMT", now);
    emit_date("Wednesday, 16-Sep-76 12:33:56 GMT", now);
    emit_date("Wednesday, 16-Sep-76 12:34:55 GMT", now);
    emit_date("Wednesday, 16-Sep-76 12:34:56 GMT", now);
    emit_date("Wednesday, 16-Sep-76 12:34:57 GMT", now);
    emit_date("Wednesday, 16-Sep-76 12:35:56 GMT", now);
    emit_date("Wednesday, 16-Sep-76 13:34:56 GMT", now);
    emit_date("Thursday, 17-Sep-76 12:34:56 GMT", now);
    emit_date("Sunday, 18-Oct-76 12:34:56 GMT", now);
    //% expect: "3367398896\n3367481696\n3367485236\n3367485295\n3367485296\n211725297\n211725356\n211728896\n211811696\n214490096\n"
    emit_date("Saturday, 01-Jan-00 00:00:00 GMT", 946598400);
    emit_date("Monday, 01-Jan-20 00:00:00 GMT", 3786912000);
    emit_date("Wednesday, 01-Jan-70 00:00:00 GMT", 3786912000);
    emit_date("Friday, 01-Jan-00 00:00:00 GMT", 2524608000);
    emit_date("Friday, 01-Jan-00 00:00:01 GMT", 2524608000);
    emit_date("Saturday, 29-Feb-76 00:00:00 GMT", 1772236800);
    emit_date("Saturday, 29-Feb-76 00:00:00 GMT", 1772323200);
    emit_date("Tuesday, 29-Feb-00 00:00:00 GMT", 2524608000);
    //% expect: "946684800\n4733510400\n3155760000\n4102444800\n946684801\n194400000\n3350160000\n951782400\n"
    emit_date("Wed, 16 Sep 2076 12:34:57 GMT", now);
    emit_date("Wed Sep 16 12:34:57 2076", now);
    emit_date("Thursday, 31-Feb-76 12:34:56 GMT", now);
    emit_date("Sunday, 06-Nov-94 08:49:37 GMT", now);
    //% expect: "3367485297\n3367485297\n-9223372036854775807\n784111777\n"
    0
}
