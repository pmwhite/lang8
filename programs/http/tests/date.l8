tag http_tests;

use_tag http, http_internal;

import "../semantics.l8";

main(argc: int, argv: []str): int {
    if (argc != 3) return 2;
    now: int = http_decimal(argv[1]);
    value: int = http_parse_date_at(argv[2], now);
    out: *HttpBuffer = http_buffer();
    if (value < 0) {
        http_text(out, "-");
        value = 0 - value;
    }
    http_number(out, value);
    http_text(out, "\n");
    write(1, out.data, out.size);
    0;
}
