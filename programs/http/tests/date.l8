tag http_tests;

use_tag std;

use_tag http, http_internal;

import "../../../stdlib/print.l8";

import "../semantics.l8";

// Print the timestamp parsed from text at the given current time, and the
// same timestamp in IMF-fixdate form so the chosen century is visible.
date_show(text: str, now: int) raises IoError {
    value: int = http_parse_date_at(text, now);
    write(1, text);
    write(1, " -> ");
    if (value == HTTP_INVALID_DATE) {
        print("invalid");
        return
    }
    write_int(1, value);
    write(1, " (");
    write(1, http_date_at(value));
    print(")")
}

date_now(now: int) raises IoError {
    write(1, "now: ");
    print(http_date_at(now))
}

test "RFC 850 two-digit years more than fifty years ahead roll back a century" {
    // The boundary includes the full timestamp, not just the year.
    now: int = 1789562096;
    date_now(now);
    date_show("Tuesday, 15-Sep-76 12:34:56 GMT", now);
    expect {|
        now: Wed, 16 Sep 2026 12:34:56 GMT
        Tuesday, 15-Sep-76 12:34:56 GMT -> 3367398896 (Tue, 15 Sep 2076 12:34:56 GMT)
    |}
    date_show("Wednesday, 16-Sep-76 11:34:56 GMT", now);
    expect {|
        Wednesday, 16-Sep-76 11:34:56 GMT -> 3367481696 (Wed, 16 Sep 2076 11:34:56 GMT)
    |}
    date_show("Wednesday, 16-Sep-76 12:33:56 GMT", now);
    expect {|
        Wednesday, 16-Sep-76 12:33:56 GMT -> 3367485236 (Wed, 16 Sep 2076 12:33:56 GMT)
    |}
    date_show("Wednesday, 16-Sep-76 12:34:55 GMT", now);
    expect {|
        Wednesday, 16-Sep-76 12:34:55 GMT -> 3367485295 (Wed, 16 Sep 2076 12:34:55 GMT)
    |}
    date_show("Wednesday, 16-Sep-76 12:34:56 GMT", now);
    expect {|
        Wednesday, 16-Sep-76 12:34:56 GMT -> 3367485296 (Wed, 16 Sep 2076 12:34:56 GMT)
    |}
    date_show("Wednesday, 16-Sep-76 12:34:57 GMT", now);
    expect {|
        Wednesday, 16-Sep-76 12:34:57 GMT -> 211725297 (Thu, 16 Sep 1976 12:34:57 GMT)
    |}
    date_show("Wednesday, 16-Sep-76 12:35:56 GMT", now);
    expect {|
        Wednesday, 16-Sep-76 12:35:56 GMT -> 211725356 (Thu, 16 Sep 1976 12:35:56 GMT)
    |}
    date_show("Wednesday, 16-Sep-76 13:34:56 GMT", now);
    expect {|
        Wednesday, 16-Sep-76 13:34:56 GMT -> 211728896 (Thu, 16 Sep 1976 13:34:56 GMT)
    |}
    date_show("Thursday, 17-Sep-76 12:34:56 GMT", now);
    expect {|
        Thursday, 17-Sep-76 12:34:56 GMT -> 211811696 (Fri, 17 Sep 1976 12:34:56 GMT)
    |}
    date_show("Sunday, 18-Oct-76 12:34:56 GMT", now);
    expect {|
        Sunday, 18-Oct-76 12:34:56 GMT -> 214490096 (Mon, 18 Oct 1976 12:34:56 GMT)
    |}
}

test "RFC 850 century choice follows the current time" {
    date_now(946598400);
    date_show("Saturday, 01-Jan-00 00:00:00 GMT", 946598400);
    expect {|
        now: Fri, 31 Dec 1999 00:00:00 GMT
        Saturday, 01-Jan-00 00:00:00 GMT -> 946684800 (Sat, 01 Jan 2000 00:00:00 GMT)
    |}
    date_now(3786912000);
    date_show("Monday, 01-Jan-20 00:00:00 GMT", 3786912000);
    expect {|
        now: Sun, 01 Jan 2090 00:00:00 GMT
        Monday, 01-Jan-20 00:00:00 GMT -> 4733510400 (Mon, 01 Jan 2120 00:00:00 GMT)
    |}
    date_show("Wednesday, 01-Jan-70 00:00:00 GMT", 3786912000);
    expect {|
        Wednesday, 01-Jan-70 00:00:00 GMT -> 3155760000 (Wed, 01 Jan 2070 00:00:00 GMT)
    |}
    date_now(2524608000);
    date_show("Friday, 01-Jan-00 00:00:00 GMT", 2524608000);
    expect {|
        now: Sat, 01 Jan 2050 00:00:00 GMT
        Friday, 01-Jan-00 00:00:00 GMT -> 4102444800 (Fri, 01 Jan 2100 00:00:00 GMT)
    |}
    date_show("Friday, 01-Jan-00 00:00:01 GMT", 2524608000);
    expect {|
        Friday, 01-Jan-00 00:00:01 GMT -> 946684801 (Sat, 01 Jan 2000 00:00:01 GMT)
    |}
}

test "RFC 850 leap days use the chosen century" {
    date_now(1772236800);
    date_show("Saturday, 29-Feb-76 00:00:00 GMT", 1772236800);
    expect {|
        now: Sat, 28 Feb 2026 00:00:00 GMT
        Saturday, 29-Feb-76 00:00:00 GMT -> 194400000 (Sun, 29 Feb 1976 00:00:00 GMT)
    |}
    date_now(1772323200);
    date_show("Saturday, 29-Feb-76 00:00:00 GMT", 1772323200);
    expect {|
        now: Sun, 01 Mar 2026 00:00:00 GMT
        Saturday, 29-Feb-76 00:00:00 GMT -> 3350160000 (Sat, 29 Feb 2076 00:00:00 GMT)
    |}
    date_now(2524608000);
    date_show("Tuesday, 29-Feb-00 00:00:00 GMT", 2524608000);
    expect {|
        now: Sat, 01 Jan 2050 00:00:00 GMT
        Tuesday, 29-Feb-00 00:00:00 GMT -> 951782400 (Tue, 29 Feb 2000 00:00:00 GMT)
    |}
}

test "four-digit years are not windowed and impossible dates are invalid" {
    now: int = 1789562096;
    date_now(now);
    date_show("Wed, 16 Sep 2076 12:34:57 GMT", now);
    expect {|
        now: Wed, 16 Sep 2026 12:34:56 GMT
        Wed, 16 Sep 2076 12:34:57 GMT -> 3367485297 (Wed, 16 Sep 2076 12:34:57 GMT)
    |}
    date_show("Wed Sep 16 12:34:57 2076", now);
    expect {|
        Wed Sep 16 12:34:57 2076 -> 3367485297 (Wed, 16 Sep 2076 12:34:57 GMT)
    |}
    date_show("Thursday, 31-Feb-76 12:34:56 GMT", now);
    expect {|
        Thursday, 31-Feb-76 12:34:56 GMT -> invalid
    |}
    date_show("Sunday, 06-Nov-94 08:49:37 GMT", now);
    expect {|
        Sunday, 06-Nov-94 08:49:37 GMT -> 784111777 (Sun, 06 Nov 1994 08:49:37 GMT)
    |}
}

