tag http_tests;

use_tag http, http_internal;

import "../http.l8";

failures: int = 0;

checks: int = 0;

check(ok: bool, label: str) {
    checks = checks + 1;
    if (!ok) {
        failures = failures + 1;
        write(2, label, len(label));
        write(2, "\n", 1);
    }
}

has_text(text: str, needle: str): bool {
    for i in 0..len(text) - len(needle) + 1 {
        if (http_sub(text, i, i + len(needle)) == needle) return true;
    }
    false;
}

main(): int {
    region {
        r: *HttpReader = http_reader(-1, true);
        check(!http_send(r, bytes("one"), 4), "foreign send bounds");
        check(!http_send(r, bytes("one"), -1), "foreign send negative length");
    }
    for status in [100, 101, 103, 200, 204, 205, 304, 404, 599] {
        region {
            m: *HttpMessage = http_response(status);
            if (status == 101) check(http_add(m, "Upgrade", "test"), "upgrade header");
            if (status != 205) http_text(m.body, "body");
            b: *HttpBuffer = http_write_head(m, true, "GET", 1);
            check(m.error == 0, "serialize status");
            text: str = http_string(b);
            check(has_text(text, "Date: "), "date generated");
            check(has_text(text, "Content-Length: 4\r\n") == (status >= 200 && status != 204 && status != 205),
                "response framing suppression");
        }
    }
    for method in ["HEAD", "CONNECT"] {
        region {
            m: *HttpMessage = http_response(200);
            http_text(m.body, "body");
            text: str = http_string(http_write_head(m, true, method, 1));
            check(http_no_body(200, method), "no body methods");
            check(has_text(text, "Content-Length:") == (method == "HEAD"), "CONNECT framing suppressed");
        }
    }
    for name in ["Content-Length", "Transfer-Encoding", "Connection", "Host", "Trailer"] {
        region {
            m: *HttpMessage = http_request("GET", "/", "example.test");
            check(http_add(m, name, "0"), "add reserved field");
            http_write_head(m, false, "GET", 1);
            check(m.error == 400, "reject user-controlled framing");
        }
    }
    region {
        m: *HttpMessage = http_request("GET", "/", "example.test");
        check(!http_add(m, """
X-Name
Evil""", "value"), "header name injection");
        check(!http_add(m, "X-Name", """
ok
Evil: yes"""), "header value injection");
        check(!http_trailer(m, "Host", "evil"), "trailer routing forbidden");
        check(!http_trailer(m, "Content-Length", "0"), "trailer framing forbidden");
        check(http_trailer(m, "X-Sum", "yes"), "extension trailer");
        http_write_head(m, false, "GET", 1);
        check(m.error == 400, "trailers require chunked");
    }
    region {
        m: *HttpMessage = http_request("POST", "/", "example.test");
        m.framing = 2;
        check(http_trailer(m, "X-Sum", "yes"), "chunk trailer");
        text: str = http_string(http_write_head(m, false, "POST", 1));
        check(m.error == 0, "chunked request head");
        check(has_text(text, "Transfer-Encoding: chunked\r\n"), "chunked framing");
        check(has_text(text, "Trailer: x-sum\r\n"), "trailer declaration");
        check(!has_text(text, "Content-Length:"), "TE excludes CL");
        http_write_head(m, false, "POST", 0);
        check(m.error == 400, "no HTTP/1.0 chunked");
    }
    region {
        m: *HttpMessage = http_request("GET", "/", "example.test");
        check(http_add(m, "TE", "trailers"), "TE trailers");
        text: str = http_string(http_write_head(m, false, "GET", 1));
        check(has_text(text, "Connection: keep-alive, TE\r\n"), "TE connection option");
        check(!has_text(text, "Content-Length:"), "GET without content omits CL");
    }
    for target in ["""
/bad
Injected: yes""", "/bad|path", "/bad[segment]", "/bad%xx", "http://user@host/"] {
        region {
            m: *HttpMessage = http_request("GET", target, "host");
            http_write_head(m, false, "GET", 1);
            check(m.error == 400, "target validation");
        }
    }
    region {
        m: *HttpMessage = http_response(200);
        m.reason = """
OK
Evil: yes""";
        http_write_head(m, true, "GET", 1);
        check(m.error == 400, "reason injection");
    }
    region {
        m: *HttpMessage = http_response(205);
        http_text(m.body, "forbidden");
        http_write_head(m, true, "GET", 1);
        check(m.error == 400, "205 cannot carry content");
    }
    region {
        m: *HttpMessage = http_response(100);
        http_write_head(m, true, "GET", 0);
        check(m.error == 400, "HTTP/1.0 no informational response");
    }
    region {
        m: *HttpMessage = http_request("CONNECT", "example.test:443", "example.test:443");
        http_text(m.body, "untrusted");
        http_write_head(m, false, "CONNECT", 1);
        check(m.error == 400, "RFC9931 CONNECT does not send optimistic content");
    }
    check(http_chunk_size("A ; name = \"a\\\"b\";flag") == 10, "chunk extension BWS");
    check(http_chunk_size("0") == 0, "zero chunk");
    check(http_chunk_size("01") == 1, "leading zero chunk");
    check(http_chunk_size("1 ") == -1, "trailing chunk whitespace");
    check(http_chunk_size(cstr([49i8, 59i8, 120i8, 61i8, 34i8, 1i8, 34i8])) == -1,
        "chunk quoted control");
    check(http_etag_equal("W/\"abc\"", "\"abc\"", true), "weak comparison");
    check(!http_etag_equal("W/\"abc\"", "\"abc\"", false), "strong comparison");
    check(!http_etag_equal("\"ABC\"", "\"abc\"", true), "tag case sensitive");
    check(http_etag_valid("\"\""), "empty opaque tag");
    check(http_etag_list("\"a,b\", \"abc\"", "\"abc\"", true, false), "quoted comma");
    check(!http_etag_list("*", "\"abc\"", false, false), "wildcard missing resource");
    region {
        m: *HttpMessage = http_request("PUT", "/", "host");
        check(http_add(m, "If-None-Match", "*"), "unsafe condition");
        check(http_preconditions(m, "\"abc\"", 0, true) == 412, "unsafe none match 412");
        check(http_preconditions(m, "\"abc\"", 0, false) == 0, "create absent resource");
    }
    check(http_ranges("bytes=0-0", 0).status == 416, "range on empty resource");
    check(http_ranges("bytes=-999", 0).status == 416, "suffix on empty resource");
    check(http_ranges("bytes=0-0, 2-3", 4).count == 2, "range set");
    check(http_address("127.0.0.1", "80") != null, "numeric IPv4 address");
    check(http_address("::1", "80") != null, "numeric IPv6 address");
    check(http_address("localhost", "80") != null, "localhost alias");
    check(http_address("example.com", "80") == null, "DNS stays outside transport");
    check(http_parse_date("Sun, 06 Nov 1994 08:49:37 GMT") == 784111777, "IMF date");
    check(http_parse_date("Sunday, 06-Nov-94 08:49:37 GMT") == 784111777, "RFC850 date");
    check(http_parse_date("Sun Nov  6 08:49:37 1994") == 784111777, "asctime date");
    check(http_parse_date("Thu, 01 Jan 1970 00:00:00 GMT") == 0, "epoch date");
    check(http_parse_date("Wed, 31 Dec 1969 23:59:59 GMT") == -1, "pre-epoch date");
    check(http_parse_date("Sat, 31 Dec 2016 23:59:60 GMT") == 1483228800, "leap second date");
    check(http_parse_date("invalid") == HTTP_INVALID_DATE, "invalid date sentinel");
    check(http_date_at(784111777) == "Sun, 06 Nov 1994 08:49:37 GMT", "emit IMF only");
    b: *HttpBuffer = http_buffer();
    http_number(b, checks);
    http_text(b, " API checks\n");
    write(1, b.data, b.size);
    if (failures > 0) return 1;
    0;
}
