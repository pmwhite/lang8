tag http_tests;

use_tag http, http_internal;

import "../parse.l8";

probe_int(name: str, n: int) {
    b: *HttpBuffer = http_buffer();
    http_text(b, name);
    http_text(b, "=");
    if (n < 0) {
        http_text(b, "-");
        n = 0 - n;
    }
    http_number(b, n);
    http_text(b, "\n");
    write(1, b.data, b.size);
}

probe_hex(data: []i8, n: int) {
    digits: str = "0123456789abcdef";
    b: *HttpBuffer = http_buffer();
    for i in 0..n {
        c: int = data[i] as int;
        http_byte(b, digits[c / 16]);
        http_byte(b, digits[c % 16]);
    }
    write(1, b.data, b.size);
}

probe_str(name: str, s: str) {
    write(1, name, len(name));
    write(1, "=", 1);
    probe_hex(bytes(s), len(s));
    write(1, "\n", 1);
}

main(argc: int, argv: []str): int {
    if (argc < 3) return 2;
    r: *HttpReader = http_reader(0, false);
    m: *HttpMessage = http_read_head(r, argv[1] == "response", argv[2]);
    if (argc > 3) {
        state: *HttpBodyReader = http_body_reader(r, m);
        scratch: []i8 = new i8[http_decimal(argv[3])](0i8);
        running: bool = true;
        while (running) {
            n: int = http_body_read(state, scratch);
            if (n <= 0) running = false; else http_bytes(m.body, scratch, n);
        }
    } else http_read_body(r, m);
    probe_int("error", m.error);
    probe_int("status", m.status);
    probe_int("minor", m.minor);
    probe_int("consumed", r.consumed);
    probe_int("framing", m.framing);
    probe_int("close", if (m.close) {
        1;
    } else {
        0;
    });
    probe_str("method", m.method);
    probe_str("target", m.target);
    probe_str("authority", m.authority);
    probe_str("reason", m.reason);
    write(1, "body=", 5);
    probe_hex(m.body.data, m.body.size);
    write(1, "\n", 1);
    for i in 0..m.count {
        write(1, "header=", 7);
        probe_hex(bytes(m.headers[i].name), len(m.headers[i].name));
        write(1, ":", 1);
        probe_hex(bytes(m.headers[i].value), len(m.headers[i].value));
        write(1, "\n", 1);
    }
    for i in 0..m.trailer_count {
        write(1, "trailer=", 8);
        probe_hex(bytes(m.trailers[i].name), len(m.trailers[i].name));
        write(1, ":", 1);
        probe_hex(bytes(m.trailers[i].value), len(m.trailers[i].value));
        write(1, "\n", 1);
    }
    0;
}
