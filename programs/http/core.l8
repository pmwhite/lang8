tag http_internal;

// HTTP/1.1 octet syntax and bounded storage. See spec/rfc911{0,2}.txt.
tag http
type HttpBuffer = {
    data: []i8;
    size: int
}

tag http
type HttpField = {
    name: str;
    value: str
}

tag http
type HttpMessage = {
    method: str;
    target: str;
    authority: str;
    reason: str;
    minor: int;
    status: int;
    error: int;
    headers: []HttpField;
    count: int;
    trailers: []HttpField;
    trailer_count: int;
    body: *HttpBuffer;
    framing: int;
    length: int;
    close: bool;
    expect: bool
}

// Framing: 0 no body, 1 Content-Length, 2 chunked, 3 EOF, 4 tunnel.
// error: HTTP status describing failure; 0 success. Never use a failed body.
tag http
HTTP_MAX_LINE: int = 8192;

tag http
HTTP_MAX_HEADERS: int = 65536;

tag http
HTTP_MAX_FIELDS: int = 100;

// Bound recovery from accidentally merged list values (RFC 9110 5.6.1.2).
tag http
HTTP_MAX_EMPTY_LIST_ELEMENTS: int = 16;

tag http
HTTP_MAX_BODY: int = 16777216;

tag http
HTTP_TIMEOUT_MS: int = 10000;

tag http
http_buffer(): *HttpBuffer@new {
    new HttpBuffer { data: new i8[256](0i8), size: 0 }
}

http_reserve(b: *HttpBuffer@new, n: int) {
    if (n <= len(b.data)) return;
    cap: int = len(b.data);
    while (cap < n) cap = cap * 2;
    data: []i8 = new i8[cap](0i8);
    for i in 0..b.size data[i] = b.data[i];
    b.data = data
}

http_byte(b: *HttpBuffer@new, c: i8) {
    http_reserve(b, b.size + 1);
    b.data[b.size] = c;
    b.size = b.size + 1
}

tag http
http_text(b: *HttpBuffer@new, s: str) {
    http_reserve(b, b.size + len(s));
    for c in s {
        b.data[b.size] = c;
        b.size = b.size + 1
    }
}

tag http
http_bytes(b: *HttpBuffer@new, data: []i8, n: int) {
    http_reserve(b, b.size + n);
    for i in 0..n {
        b.data[b.size] = data[i];
        b.size = b.size + 1
    }
}

http_number(b: *HttpBuffer@new, n: int) {
    if (n >= 10) http_number(b, n / 10);
    http_byte(b, (48 + n % 10) trunc i8)
}

http_hex_number(b: *HttpBuffer@new, n: int) {
    if (n >= 16) http_hex_number(b, n / 16);
    digits: str = "0123456789abcdef";
    http_byte(b, digits[n % 16])
}

tag http
http_string(b: *HttpBuffer): str@new {
    data: []i8 = new i8[b.size](0i8);
    for i in 0..b.size data[i] = b.data[i];
    cstr(data)
}

http_sub(s: str, start: int, end: int): str@new {
    data: []i8 = new i8[end - start](0i8);
    for i in start..end data[i - start] = s[i];
    cstr(data)
}

http_lower_byte(c: i8): i8 {
    if (c >= 'A' && c <= 'Z') return c + 32i8;
    c
}

http_lower(s: str): str@new {
    data: []i8 = bytes(s);
    for i in 0..len(data) data[i] = http_lower_byte(data[i]);
    cstr(data)
}

http_equal(a: str, b: str): bool {
    if (len(a) != len(b)) return false;
    for i in 0..len(a) {
        if (http_lower_byte(a[i]) != http_lower_byte(b[i])) return false
    }
    true
}

http_prefix(s: str, prefix: str): bool {
    if (len(s) < len(prefix)) return false;
    for i in 0..len(prefix) {
        if (http_lower_byte(s[i]) != http_lower_byte(prefix[i])) return false
    }
    true
}

http_token(c: i8): bool {
    if (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9') return true;
    for x in "!#$%&'*+-.^_`|~" {
        if (x == c) return true
    }
    false
}

http_valid_token(s: str): bool {
    if (len(s) == 0) return false;
    for c in s {
        if (!http_token(c)) return false
    }
    true
}

http_value(s: str): bool {
    for c in s {
        if (c < 32i8 && c != '\t' || c == 127i8) return false
    }
    true
}

http_trim(s: str): str@new {
    a: int = 0;
    b: int = len(s);
    while (a < b && (s[a] == ' ' || s[a] == '\t')) a = a + 1;
    while (b > a && (s[b - 1] == ' ' || s[b - 1] == '\t')) b = b - 1;
    http_sub(s, a, b)
}

http_decimal(s: str): int {
    if (len(s) == 0) return -1;
    n: int = 0;
    for c in s {
        if (c < '0' || c > '9') return -1;
        d: int = c as int - 48;
        if (n > (9223372036854775807 - d) / 10) return -1;
        n = n * 10 + d
    }
    n
}

http_hex(c: i8): int {
    if (c >= '0' && c <= '9') return c as int - 48;
    if (c >= 'a' && c <= 'f') return c as int - 87;
    if (c >= 'A' && c <= 'F') return c as int - 55;
    -1
}

http_message(): *HttpMessage@new {
    empty: HttpField = HttpField { name: "", value: "" };
    new HttpMessage {
        method: "",
        target: "",
        authority: "",
        reason: "",
        minor: 1,
        status: 0,
        error: 0,
        headers: new HttpField[HTTP_MAX_FIELDS](empty),
        count: 0,
        trailers: new HttpField[HTTP_MAX_FIELDS](empty),
        trailer_count: 0,
        body: http_buffer(),
        framing: 0,
        length: 0,
        close: false,
        expect: false
    }
}

tag http
http_add(m: *HttpMessage@new, name: str, value: str): bool {
    if (!http_valid_token(name) || !http_value(value) || m.count >= len(m.headers)) return false;
    m.headers[m.count] = HttpField { name: http_lower(name), value: http_trim(value) };
    m.count = m.count + 1;
    true
}

// First occurrence; callers needing all values iterate headers[0..count].
tag http
http_get(m: *HttpMessage, name: str): str@m {
    for i in 0..m.count {
        if (http_equal(m.headers[i].name, name)) return m.headers[i].value
    }
    ""
}

tag http
http_has(m: *HttpMessage, name: str): bool {
    for i in 0..m.count {
        if (http_equal(m.headers[i].name, name)) return true
    }
    false
}

http_list_has(s: str, token: str): bool {
    p: int = 0;
    while (p < len(s)) {
        end: int = p;
        while (end < len(s) && s[end] != ',') end = end + 1;
        if (http_equal(http_trim(http_sub(s, p, end)), token)) return true;
        p = end + 1
    }
    false
}

tag http
http_option(m: *HttpMessage, name: str, token: str): bool {
    for i in 0..m.count {
        if (http_equal(m.headers[i].name, name) && http_list_has(m.headers[i].value,
            token)) return true
    }
    false
}

http_forbidden_trailer(name: str): bool {
    // Never let trailers change framing, routing, authentication, or representation interpretation.
    for x in ["content-length", "transfer-encoding", "host", "connection", "trailer",
        "te", "upgrade", "expect", "authorization", "proxy-authorization", "proxy-authenticate",
        "www-authenticate", "cookie", "set-cookie", "content-encoding", "content-type",
        "content-range", "range", "cache-control", "max-forwards"] {
        if (http_equal(name, x)) return true
    }
    http_prefix(name, "if-")
}
