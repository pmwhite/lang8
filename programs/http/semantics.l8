tag http_internal;

// Optional origin-resource semantics: validators, preconditions, and byte ranges.
import "write.l8";

import "date.l8";

http_etag_valid(tag: str): bool {
    start: int = 0;
    if (len(tag) >= 2 && tag[0] == 'W' && tag[1] == '/') start = 2;
    if (len(tag) < start + 2) return false;
    if (tag[start] != '"' || tag[len(tag) - 1] != '"') return false;
    for i in start + 1..len(tag) - 1 {
        c: i8 = tag[i];
        if (c == '"' || c < 33i8 || c == 127i8) return false
    }
    true
}

http_etag_equal(a: str, b: str, weak: bool): bool {
    if (len(a) < 2 || len(b) < 2 || !http_etag_valid(a) || !http_etag_valid(b)) return false;
    aw: bool = a[0] == 'W';
    bw: bool = b[0] == 'W';
    if (!weak && (aw || bw)) return false;
    aa: int = 0;
    bb: int = 0;
    if (aw) aa = 2;
    if (bw) bb = 2;
    a_limit: int = len(a);
    b_limit: int = len(b);
    http_sub(a, aa, a_limit) == http_sub(b, bb, b_limit)
}

http_etag_list(
    s: str,
    current: str,
    exists: bool,
    weak: bool
): bool {
    if (http_trim(s) == "*") return exists;
    p: int = 0;
    matched: bool = false;
    while (p < len(s)) invariant (0 <= p && p <= len(s)) {
        while (p < len(s) && (s[p] == ' ' || s[p] == '\t' || s[p] == ',')) invariant (0 <= p && p <= len(s)) p = p + 1;
        if (p < len(s)) {
            start: int = p;
            next: int = p + 1;
            if (next >= 0 && next < len(s) && s[p] == 'W' && s[next] == '/') p = next + 1;
            if (p >= len(s) || s[p] != '"') return false;
            p = p + 1;
            while (p < len(s) && s[p] != '"') invariant (start <= p && p <= len(s)) p = p + 1;
            if (p >= len(s)) return false;
            p = p + 1;
            tag: str = http_sub(s, start, p);
            if (!http_etag_valid(tag)) return false;
            if (exists && http_etag_equal(tag, current, weak)) matched = true;
            while (p < len(s) && (s[p] == ' ' || s[p] == '\t')) invariant (0 <= p && p <= len(s)) p = p + 1;
            if (p < len(s) && s[p] != ',') return false
        }
    }
    matched
}

http_validator_matches(
    m: *HttpMessage,
    name: str,
    tag: str,
    exists: bool,
    weak: bool
): bool {
    headers: []HttpField = m.headers;
    count: int = m.count;
    for i in 0..count {
        if (headers[i].name == name && http_etag_list(headers[i].value, tag, exists,
            weak)) return true
    }
    false
}

// 0 = proceed, 304 = not modified, 412 = failed precondition. Evaluate before Range.
tag http
http_preconditions(
    m: *HttpMessage,
    tag: str,
    modified: int,
    exists: bool
) raises IndexOutOfBounds: int {
    if (http_has(m, "if-match")) {
        if (!http_validator_matches(m, "if-match", tag, exists, false)) return 412
    } else {
        if (http_has(m, "if-unmodified-since") && exists && modified >= 0) {
            value: str = http_get(m, "if-unmodified-since");
            date: int = http_parse_date(value);
            if (date != HTTP_INVALID_DATE && modified > date) return 412
        }
    }
    if (http_has(m, "if-none-match")) {
        if (http_validator_matches(m, "if-none-match", tag, exists, true)) {
            if (m.method == "GET" || m.method == "HEAD") return 304;
            return 412
        }
    } else {
        if ((m.method == "GET" || m.method == "HEAD") && exists && modified >= 0 && http_has(m,
            "if-modified-since")) {
            value: str = http_get(m, "if-modified-since");
            date: int = http_parse_date(value);
            if (date != HTTP_INVALID_DATE && modified <= date) return 304
        }
    }
    0
}

http_if_range(m: *HttpMessage, tag: str, modified: int) raises IndexOutOfBounds: bool {
    if (!http_has(m, "if-range")) return true;
    value: str = http_get(m, "if-range");
    if (http_etag_valid(value)) return http_etag_equal(value, tag, false);
    date: int = http_parse_date(value);
    date != HTTP_INVALID_DATE && modified >= 0 && date == modified
}

type HttpRange = {
    first: int;
    last: int
} invariant (0 <= first && first <= last)

type HttpRanges = {
    status: int;
    count: int;
    items: []HttpRange
} invariant (0 <= count && count <= len(items))

http_range_number(s: str): int {
    if (len(s) == 0) return -1;
    n: int = 0;
    for c in s {
        if (c < '0' || c > '9') return -1;
        d: int = c as int - 48;
        if (n <= (9223372036854775807 - d) / 10) n = n * 10 + d else n = 9223372036854775807
    }
    n
}

http_ranges(value: str, size: int): *HttpRanges@new {
    r: *HttpRanges = new HttpRanges { status: 0, count: 0, items: new HttpRange[16](HttpRange { first: 0, last: 0 }) };
    // Invalid/unknown/too many ranges are ignored; a valid wholly unsatisfiable set yields 416.
    if (!http_prefix(value, "bytes=") || size < 0) return r;
    if (len(value) < 6) return r;
    p: int = 6;
    seen: int = 0;
    while (p < len(value)) invariant (0 <= p && p <= len(value)) {
        end: int = p;
        while (end < len(value) && value[end] != ',') invariant (p <= end && end <= len(value)) end = end + 1;
        raw: str = http_sub(value, p, end);
        part: str = http_trim(raw);
        part_limit: int = len(part);
        dash: int = 0;
        while (dash < part_limit && part[dash] != '-') invariant (0 <= dash && dash <= part_limit) dash = dash + 1;
        if (dash >= part_limit || part_limit == 1) return r;
        first: int = 0;
        last: int = size - 1;
        if (dash == 0) {
            suffix_text: str = http_sub(part, 1, part_limit);
            suffix: int = http_range_number(suffix_text);
            if (suffix < 0) return r;
            first = size - suffix;
            if (first < 0) first = 0
        } else {
            first = http_range_number(http_sub(part, 0, dash));
            if (first < 0) return r;
            after_dash: int = dash + 1;
            if (after_dash < part_limit) {
                last_text: str = http_sub(part, after_dash, part_limit);
                last = http_range_number(last_text);
                if (last < first) return r;
                if (last >= size) last = size - 1
            }
        }
        seen = seen + 1;
        if (seen > 16) return r;
        if (first >= 0 && first <= last && first < size) {
            if (r.count >= len(r.items)) return r;
            items: []HttpRange = r.items;
            slot: int = r.count;
            r.count = r.count + 1;
            items[slot] = HttpRange { first: first, last: last }
        }
        if (end < len(value)) {
            next: int = end + 1;
            if (next >= len(value)) return r;
            p = next
        } else p = end
    }
    if (seen == 0) return r;
    r.status = 416;
    if (r.count > 0) r.status = 206;
    r
}

http_content_range(first: int, last: int, size: int): str@new {
    b: *HttpBuffer = http_buffer();
    http_text(b, "bytes ");
    if (first < 0) http_text(b, "*") else {
        http_number(b, first);
        http_text(b, "-");
        http_number(b, last)
    }
    http_text(b, "/");
    http_number(b, size);
    http_string(b)
}

http_copy_range(out: *HttpBuffer@new, data: []i8, item: HttpRange): bool {
    first: int = item.first;
    last: int = item.last;
    if (last >= len(data)) return false;
    i: int = first;
    while (i <= last) invariant (0 <= i && i <= len(data)) {
        http_byte(out, data[i]);
        i = i + 1
    }
    true
}

http_boundary(data: []i8, size: int): str@new requires (0 <= size && size <= len(data)) {
    nonce: int = http_now();
    while (true) {
        b: *HttpBuffer = http_buffer();
        http_text(b, "l8-http-");
        http_number(b, nonce);
        boundary: str = http_string(b);
        found: bool = false;
        for i in 0..size {
            same: bool = true;
            at: int = i;
            j: int = 0;
            while (j < len(boundary) && at < size) invariant (0 <= at && at <= size && 0 <= j && j <= len(boundary)) {
                if (data[at] != boundary[j]) same = false;
                at = at + 1;
                j = j + 1
            }
            if (j < len(boundary)) same = false;
            if (same) found = true
        }
        if (!found) return boundary;
        nonce = nonce + 1
    }
}

// Pure representation helper: no filesystem access or implicit resource mutation.
tag http
http_representation(
    request: *HttpMessage,
    data: []i8,
    size: int,
    content_type: str,
    tag: str,
    modified: int
) raises IndexOutOfBounds: *HttpMessage@new {
    response: *HttpMessage = http_response(200);
    if (size < 0 || size > len(data) || size > HTTP_MAX_BODY || !http_value(content_type) || !http_etag_valid(tag)) {
        response.error = 400;
        return response
    }
    http_add(response, "ETag", tag);
    if (modified >= 0) http_add(response, "Last-Modified", http_date_at(modified));
    http_add(response, "Accept-Ranges", "bytes");
    status: int = http_preconditions(request, tag, modified, true);
    if (status != 0) {
        response.status = status;
        response.reason = http_reason(status);
        // 304 may omit Content-Length; suppress its automatic generation via length=-1.
        if (status == 304) response.length = -1;
        return response
    }
    ranges: *HttpRanges = http_ranges("", size);
    if (request.method == "GET" && http_if_range(request, tag, modified)) ranges = http_ranges(http_get(request,
        "range"), size);
    if (ranges.status == 416) {
        response.status = 416;
        response.reason = http_reason(416);
        http_add(response, "Content-Range", http_content_range(-1, 0, size));
        return response
    }
    if (ranges.status == 206) {
        items: []HttpRange = ranges.items;
        range_count: int = ranges.count;
        total: int = 0;
        for i in 0..range_count total = total + items[i].last - items[i].first + 1 + 512;
        if (total <= HTTP_MAX_BODY) {
            response.status = 206;
            response.reason = http_reason(206);
            if (range_count == 1) {
                item: HttpRange = items[0];
                http_add(response, "Content-Type", content_type);
                http_add(response, "Content-Range", http_content_range(item.first,
                    item.last, size));
                if (!http_copy_range(response.body, data, item)) {
                    response.error = 400;
                    return response
                }
            } else {
                boundary: str = http_boundary(data, size);
                kind: *HttpBuffer = http_buffer();
                http_text(kind, "multipart/byteranges; boundary=");
                http_text(kind, boundary);
                http_add(response, "Content-Type", http_string(kind));
                for i in 0..range_count {
                    item: HttpRange = items[i];
                    http_text(response.body, "--");
                    http_text(response.body, boundary);
                    http_text(response.body, """

Content-Type: """);
                    http_text(response.body, content_type);
                    http_text(response.body, """

Content-Range: """);
                    http_text(response.body, http_content_range(item.first, item.last,
                        size));
                    http_text(response.body, """


""");
                    if (!http_copy_range(response.body, data, item)) {
                        response.error = 400;
                        return response
                    }
                    http_text(response.body, "\r\n")
                }
                http_text(response.body, "--");
                http_text(response.body, boundary);
                http_text(response.body, "--\r\n")
            }
            return response
        }
    }
    http_add(response, "Content-Type", content_type);
    http_bytes(response.body, data, size);
    response
}
