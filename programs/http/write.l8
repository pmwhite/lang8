tag http_internal;

import "parse.l8";

type HttpTm = {
    sec: i32;
    min: i32;
    hour: i32;
    mday: i32;
    mon: i32;
    year: i32;
    wday: i32;
    yday: i32;
    isdst: i32;
    gmtoff: int;
    zone: ?*i8
}

extern l8_time(): int;

http_floor_div(a: int, b: int): int {
    q: int = a / b;
    if (a < 0 && a % b != 0) q = q - 1;
    q
}

http_calendar(timestamp: int): HttpTm {
    days: int = http_floor_div(timestamp, 86400);
    second: int = timestamp - days * 86400;
    z: int = days + 719468;
    era: int = http_floor_div(z, 146097);
    doe: int = z - era * 146097;
    yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    year: int = yoe + era * 400;
    doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100);
    mp: int = (5 * doy + 2) / 153;
    day: int = doy - (153 * mp + 2) / 5 + 1;
    month: int = mp + 3;
    if (month > 12) {
        month = month - 12;
        year = year + 1
    }
    weekday: int = (days + 4) % 7;
    if (weekday < 0) weekday = weekday + 7;
    HttpTm {
        sec: (second % 60) trunc i32,
        min: (second / 60 % 60) trunc i32,
        hour: (second / 3600) trunc i32,
        mday: day trunc i32,
        mon: (month - 1) trunc i32,
        year: (year - 1900) trunc i32,
        wday: weekday trunc i32,
        yday: doy trunc i32,
        isdst: 0i32,
        gmtoff: 0,
        zone: null
    }
}

http_two(b: *HttpBuffer@new, n: int) {
    http_byte(b, (48 + n / 10) trunc i8);
    http_byte(b, (48 + n % 10) trunc i8)
}

http_format_date(timestamp: int): str@new {
    tm: HttpTm = http_calendar(timestamp);
    weekdays: []str = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    months: []str = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep",
        "Oct", "Nov", "Dec"];
    year: int = tm.year as int + 1900;
    b: *HttpBuffer = http_buffer();
    http_text(b, weekdays[tm.wday as int]);
    http_text(b, ", ");
    http_two(b, tm.mday as int);
    http_text(b, " ");
    http_text(b, months[tm.mon as int]);
    http_text(b, " ");
    http_number(b, year);
    http_text(b, " ");
    http_two(b, tm.hour as int);
    http_text(b, ":");
    http_two(b, tm.min as int);
    http_text(b, ":");
    http_two(b, tm.sec as int);
    http_text(b, " GMT");
    http_string(b)
}

http_date(): str@new {
    http_format_date(l8_time())
}

tag http
http_reason(status: int): str {
    if (status == 100) return "Continue";
    if (status == 101) return "Switching Protocols";
    if (status == 200) return "OK";
    if (status == 201) return "Created";
    if (status == 204) return "No Content";
    if (status == 206) return "Partial Content";
    if (status == 304) return "Not Modified";
    if (status == 400) return "Bad Request";
    if (status == 404) return "Not Found";
    if (status == 405) return "Method Not Allowed";
    if (status == 408) return "Request Timeout";
    if (status == 412) return "Precondition Failed";
    if (status == 413) return "Content Too Large";
    if (status == 414) return "URI Too Long";
    if (status == 416) return "Range Not Satisfiable";
    if (status == 417) return "Expectation Failed";
    if (status == 431) return "Request Header Fields Too Large";
    if (status == 500) return "Internal Server Error";
    if (status == 501) return "Not Implemented";
    if (status == 505) return "HTTP Version Not Supported";
    ""
}

tag http
http_request(method: str, target: str, authority: str): *HttpMessage@new {
    m: *HttpMessage = http_message();
    m.method = http_sub(method, 0, len(method));
    m.target = http_sub(target, 0, len(target));
    m.authority = http_sub(authority, 0, len(authority));
    m
}

tag http
http_response(status: int): *HttpMessage@new {
    m: *HttpMessage = http_message();
    m.status = status;
    m.reason = http_reason(status);
    m
}

tag http
http_trailer(m: *HttpMessage@new, name: str, value: str): bool {
    if (m.trailer_count >= HTTP_MAX_FIELDS || !http_valid_token(name) || !http_value(value) || http_forbidden_trailer(name)) return false;
    m.trailers[m.trailer_count] = HttpField { name: http_lower(name), value: http_trim(value) };
    m.trailer_count = m.trailer_count + 1;
    true
}

http_no_body(status: int, method: str): bool {
    method == "HEAD" || status < 200 || status == 204 || status == 205 || status == 304 || method == "CONNECT" && status >= 200 && status < 300
}

// Serializer owns Host, framing, and Connection. User CL/TE are rejected, never trusted.
// HEAD/304 derive their representation length from body.size, without transmitting body.
tag http
http_write_head(
    m: *HttpMessage,
    response: bool,
    method: str,
    minor: int
): *HttpBuffer@new {
    b: *HttpBuffer = http_buffer();
    if (m.error != 0) return b;
    if (m.body.size < 0 || m.body.size > len(m.body.data) || m.body.size > HTTP_MAX_BODY || m.count < 0 || m.count > len(m.headers) || m.trailer_count < 0 || m.trailer_count > len(m.trailers)) {
        m.error = 400;
        return b
    }
    if (response && m.status == 205 && (m.body.size != 0 || m.framing == 2)) {
        m.error = 400;
        return b
    }
    if (response && minor == 0 && m.status < 200) {
        m.error = 400;
        return b
    }
    if (!response && m.method == "CONNECT" && (m.body.size != 0 || m.framing == 2)) {
        m.error = 400;
        return b
    }
    chunked: bool = m.framing == 2;
    if (http_has(m, "upgrade") && minor == 0) {
        m.error = 400;
        return b
    }
    if (chunked && minor == 0) {
        m.error = 400;
        return b
    }
    if (m.trailer_count > 0 && !chunked) {
        m.error = 400;
        return b
    }
    if (response) {
        if (m.status < 100 || m.status > 599 || !http_value(m.reason)) {
            m.error = 400;
            return b
        }
        if (minor == 0) http_text(b, "HTTP/1.0 ") else http_text(b, "HTTP/1.1 ");
        http_number(b, m.status);
        http_text(b, " ");
        http_text(b, m.reason);
        http_text(b, "\r\n")
    } else {
        if (!http_valid_token(m.method) || len(m.target) == 0 || len(m.authority) == 0 || !http_authority(m.authority,
            false)) {
            m.error = 400;
            return b
        }
        check: *HttpMessage = http_request(m.method, m.target, m.authority);
        if (!http_target(check)) {
            m.error = 400;
            return b
        }
        http_text(b, m.method);
        http_text(b, " ");
        http_text(b, m.target);
        if (minor == 0) http_text(b, " HTTP/1.0\r\n") else http_text(b, " HTTP/1.1\r\n");
        http_text(b, "Host: ");
        http_text(b, m.authority);
        http_text(b, "\r\n")
    }
    for i in 0..m.count {
        field: HttpField = m.headers[i];
        if (!http_valid_token(field.name) || !http_value(field.value) || len(field.name) + len(field.value) + 2 > HTTP_MAX_LINE) {
            m.error = 400;
            return b
        }
        if (http_equal(field.name, "content-length") || http_equal(field.name, "transfer-encoding") || http_equal(field.name,
            "connection") || http_equal(field.name, "trailer") || !response && http_equal(field.name,
            "host")) {
            m.error = 400;
            return b
        }
        if (http_equal(field.name, "te") && (!http_equal(field.value, "trailers") || response)) {
            m.error = 400;
            return b
        }
        http_text(b, field.name);
        http_text(b, ": ");
        http_text(b, field.value);
        http_text(b, "\r\n")
    }
    if (response && !http_has(m, "date")) {
        http_text(b, "Date: ");
        http_text(b, http_date());
        http_text(b, "\r\n")
    }
    framed: bool = !response || !(m.status < 200 || m.status == 204 || method == "CONNECT" && m.status >= 200 && m.status < 300);
    if (response && m.status == 304 && m.length == -1) framed = false;
    if (!response && m.body.size == 0 && m.framing == 0 && m.method != "POST" && m.method != "PUT" && m.method != "PATCH") framed = false;
    if (framed) {
        if (chunked) http_text(b, "Transfer-Encoding: chunked\r\n") else {
            http_text(b, "Content-Length: ");
            http_number(b, m.body.size);
            http_text(b, "\r\n")
        }
    }
    if (m.trailer_count > 0) {
        http_text(b, "Trailer: ");
        for i in 0..m.trailer_count {
            field: HttpField = m.trailers[i];
            if (!http_valid_token(field.name) || !http_value(field.value) || http_forbidden_trailer(field.name)) {
                m.error = 400;
                return b
            }
            if (i > 0) http_text(b, ", ");
            http_text(b, field.name)
        }
        http_text(b, "\r\n")
    }
    if (m.status >= 200 || !response) {
        if (m.close) http_text(b, "Connection: close") else http_text(b, "Connection: keep-alive");
        if (http_has(m, "te")) http_text(b, ", TE");
        if (!response && http_has(m, "upgrade")) http_text(b, ", Upgrade");
        http_text(b, "\r\n")
    }
    if (response && m.status == 101) http_text(b, "Connection: Upgrade\r\n");
    http_text(b, "\r\n");
    if (b.size > HTTP_MAX_HEADERS) m.error = 431;
    line_size: int = 0;
    lines: int = 0;
    for i in 0..b.size {
        if (b.data[i] == '\n') {
            if (line_size - 1 > HTTP_MAX_LINE) {
                m.error = 431;
                if (lines == 0) m.error = 414
            }
            line_size = 0;
            lines = lines + 1
        } else line_size = line_size + 1
    }
    if (lines - 2 > HTTP_MAX_FIELDS) m.error = 431;
    trailer_size: int = 2;
    for i in 0..m.trailer_count {
        field: HttpField = m.trailers[i];
        n: int = len(field.name) + len(field.value) + 2;
        if (n > HTTP_MAX_LINE) m.error = 431;
        trailer_size = trailer_size + n + 2
    }
    if (trailer_size > HTTP_MAX_HEADERS) m.error = 431;
    if (response && m.status == 101 && !http_has(m, "upgrade")) m.error = 400;
    b
}

// Chunked streaming output: send a validated chunked head, zero or more chunks, then end_chunks.
tag http
http_send_chunk(r: *HttpReader, data: []i8, n: int): bool {
    if (n < 0 || n > len(data) || n > HTTP_MAX_BODY) {
        r.error = 413;
        return false
    }
    if (n == 0) return true;
    line: *HttpBuffer = http_buffer();
    http_hex_number(line, n);
    http_text(line, "\r\n");
    http_send(r, line.data, line.size) && http_send(r, data, n) && http_send_text(r,
        "\r\n")
}

http_chunk_tail(m: *HttpMessage): *HttpBuffer@new {
    // Validate all trailers before emitting the terminating chunk.
    final: *HttpBuffer = http_buffer();
    http_text(final, "0\r\n");
    if (m.trailer_count < 0 || m.trailer_count > HTTP_MAX_FIELDS || m.trailer_count > len(m.trailers)) {
        m.error = 431;
        return final
    }
    for i in 0..m.trailer_count {
        field: HttpField = m.trailers[i];
        if (!http_valid_token(field.name) || !http_value(field.value) || http_forbidden_trailer(field.name)) {
            m.error = 400;
            return final
        }
        if (len(field.name) + len(field.value) + 2 > HTTP_MAX_LINE) {
            m.error = 431;
            return final
        }
        http_text(final, field.name);
        http_text(final, ": ");
        http_text(final, field.value);
        http_text(final, "\r\n")
    }
    http_text(final, "\r\n");
    if (final.size > HTTP_MAX_HEADERS) {
        m.error = 431;
        return final
    }
    final
}

tag http
http_end_chunks(r: *HttpReader, m: *HttpMessage): bool {
    final: *HttpBuffer = http_chunk_tail(m);
    if (m.error != 0) {
        r.error = m.error;
        return false
    }
    http_send(r, final.data, final.size)
}

http_write_body(r: *HttpReader, m: *HttpMessage): bool {
    if (m.framing != 2) return http_send(r, m.body.data, m.body.size);
    http_send_chunk(r, m.body.data, m.body.size) && http_end_chunks(r, m)
}

tag http
http_send_response(r: *HttpReader, request: *HttpMessage, response: *HttpMessage): bool {
    if (request.close || request.method == "CONNECT" && response.status >= 300) response.close = true;
    head: *HttpBuffer = http_write_head(response, true, request.method, request.minor);
    if (response.error != 0 || !http_send(r, head.data, head.size)) return false;
    if (http_no_body(response.status, request.method)) return true;
    http_write_body(r, response)
}
