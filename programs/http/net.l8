tag http_internal;

import "transport.l8";

// Linux x86-64 socket ABI. Address bytes start at offset zero.
type HttpAddress = {
    storage: [28]i8;
    size: u32;
    family: i32
}

extern l8_socket(family: i32, kind: i32, protocol: i32): int;

extern l8_connect(fd: i32, address: *HttpAddress, size: u32): int;

extern l8_bind(fd: i32, address: *HttpAddress, size: u32): int;

extern l8_listen(fd: i32, backlog: i32): int;

extern l8_accept4(
    fd: i32,
    addr: ?*HttpAddress,
    size: ?*u32,
    flags: i32
): int;

extern l8_setsockopt(
    fd: i32,
    level: i32,
    name: i32,
    value: *i32,
    size: u32
): int;

extern l8_getsockopt(
    fd: i32,
    level: i32,
    name: i32,
    value: *i32,
    size: *u32
): int;

http_address_byte(a: *HttpAddress, at: int, value: int) {
    a.storage[at] = value trunc i8
}

http_ipv4(a: *HttpAddress, host: str): bool {
    p: int = 0;
    for part in 0..4 {
        if (p >= len(host)) return false;
        value: int = 0;
        digits: int = 0;
        while (p < len(host) && host[p] >= '0' && host[p] <= '9') {
            value = value * 10 + host[p] as int - 48;
            digits = digits + 1;
            p = p + 1
        }
        if (digits == 0 || digits > 3 || value > 255) return false;
        http_address_byte(a, 4 + part, value);
        if (part < 3) {
            if (p >= len(host) || host[p] != '.') return false;
            p = p + 1
        }
    }
    p == len(host)
}

http_ipv6(a: *HttpAddress, host: str): bool {
    words: []int = new int[8](0);
    count: int = 0;
    compressed: int = -1;
    p: int = 0;
    if (len(host) >= 2 && host[0] == ':' && host[1] == ':') {
        compressed = 0;
        p = 2
    }
    while (p < len(host)) {
        if (count >= 8) return false;
        value: int = 0;
        digits: int = 0;
        while (p < len(host) && host[p] != ':') {
            h: int = http_hex(host[p]);
            if (h < 0 || digits == 4) return false;
            value = value * 16 + h;
            digits = digits + 1;
            p = p + 1
        }
        if (digits == 0) return false;
        words[count] = value;
        count = count + 1;
        if (p < len(host)) {
            p = p + 1;
            if (p < len(host) && host[p] == ':') {
                if (compressed >= 0) return false;
                compressed = count;
                p = p + 1
            } else {
                if (p == len(host)) return false
            }
        }
    }
    if (compressed < 0) {
        if (count != 8) return false
    } else {
        if (count >= 8) return false;
        tail: int = count - compressed;
        i: int = tail;
        while (i > 0) {
            i = i - 1;
            words[8 - tail + i] = words[compressed + i];
            words[compressed + i] = 0
        }
    }
    for i in 0..8 {
        http_address_byte(a, 8 + i * 2, words[i] / 256);
        http_address_byte(a, 9 + i * 2, words[i] % 256)
    }
    true
}

http_empty_address(): *HttpAddress@new {
    new HttpAddress { storage: [0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8,
        0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8, 0i8,
        0i8, 0i8, 0i8], size: 0u32, family: 0i32 }
}

http_address(host0: str, service: str): ?*HttpAddress@new {
    port: int = http_decimal(service);
    if (port < 1 || port > 65535) return null;
    host: str = host0;
    if (host == "localhost") host = "127.0.0.1";
    a: *HttpAddress = http_empty_address();
    if (http_ipv4(a, host)) {
        a.family = 2i32;
        a.size = 16u32
    } else {
        if (!http_ipv6(a, host)) return null;
        a.family = 10i32;
        a.size = 28u32
    }
    http_address_byte(a, 0, a.family as int);
    http_address_byte(a, 1, 0);
    http_address_byte(a, 2, port / 256);
    http_address_byte(a, 3, port % 256);
    a
}

http_socket_address(address: *HttpAddress, server: bool): int {
    kind: i32 = 524289i32; // SOCK_STREAM | SOCK_CLOEXEC
    if (!server) {
        kind = kind | 2048i32 // SOCK_NONBLOCK
    }
    raw: int = l8_socket(address.family, kind, 6i32);
    if (raw < 0) return -1;
    fd: i32 = raw trunc i32;
    ok: bool = false;
    if (server) {
        yes: i32 = 1i32;
        l8_setsockopt(fd, 1i32, 2i32, &yes, 4u32);
        ok = l8_bind(fd, address, address.size) == 0 && l8_listen(fd, 128i32) == 0
    } else {
        rc: int = l8_connect(fd, address, address.size);
        ok = rc == 0;
        if (!ok && rc == -115 && http_wait(raw, 4, http_now() + HTTP_TIMEOUT_MS)) {
            err: i32 = -1i32;
            size: u32 = 4u32;
            ok = l8_getsockopt(fd, 1i32, 4i32, &err, &size) == 0 && err == 0i32
        }
    }
    if (ok) return raw;
    close(raw);
    -1
}

http_socket(host: str, service: str, server: bool): int {
    optional: ?*HttpAddress = http_address(host, service);
    if (optional == null) return -1;
    http_socket_address(optional, server)
}

tag http
http_connect(host: str, service: str): int {
    http_socket(host, service, false)
}

tag http
http_listen(host: str, service: str): int {
    http_socket(host, service, true)
}

tag http
http_accept(listener: int): int {
    while (true) {
        fd: int = l8_accept4(listener trunc i32, null, null, 526336i32);
        if (fd >= 0) return fd;
        if (fd != -4) return -1
    }
    -1
}

tag http
http_close(r: *HttpReader) {
    l8_shutdown(r.fd trunc i32, 1i32);
    deadline: int = http_now() + 100;
    draining: bool = true;
    remaining: int = 65536;
    while (draining && remaining > 0 && http_wait(r.fd, 1, deadline)) {
        n: int = l8_recv(r.fd trunc i32, r.data, len(r.data), 64i32);
        if (n <= 0) draining = false else remaining = remaining - n
    }
    close(r.fd)
}

tag http
http_close_fd(fd: int) {
    close(fd)
}
