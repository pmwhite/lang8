tag character;

use_tag skate;

// From fields to a mesh. Each layer's field is sampled on a grid in the
// rest pose, only near its surface; a vertex goes in every cell the surface
// crosses and is moved onto it, and cells sharing a crossed edge are joined
// (surface nets). Each vertex then learns, from the shapes that make the
// surface there, the bones it moves with, its color, and its part; and from
// all the layers, how open the space over it is and which layers cover it.
const VERT_FLOATS: int = 20;

const V_NRM: int = 3;

const V_RGB: int = 6;

const V_FINISH: int = 9;

const V_BONES: int = 10;

const V_WEIGHTS: int = 14;

const V_PART: int = 18;

const V_LAYER: int = 19;

// A sticker's vertices have this finish, and in place of a color, where
// they are across the sticker and which it is.
const FINISH_STICKER: f32 = 20.0;

const MAX_VERTS: int = 420000;

const MAX_TRIS: int = 840000;

verts: []f32 = new f32[MAX_VERTS * VERT_FLOATS](0.0);

nverts: int = 0;

// The layers each vertex lies inside, as bits.
vcover: []int = new int[MAX_VERTS](0);

tris: []i32 = new i32[MAX_TRIS * 3](0i32);

ntris: int = 0;

layer_v0: []int = new int[MAX_LAYERS](0);

layer_vn: []int = new int[MAX_LAYERS](0);

layer_t0: []int = new int[MAX_LAYERS](0);

layer_tn: []int = new int[MAX_LAYERS](0);

sticker_t0: []int = new int[MAX_STICKERS](0);

sticker_tn: []int = new int[MAX_STICKERS](0);

// The grid: the field at each corner, and the vertex in each cell.
const MAX_GRID: int = 4600000;

const UNSET: f32 = 2.0e30;

const BLOCK: int = 4;

// A corner known only to be this side of the surface, and far from it.
const ROUGH: f32 = 1.0e20;

gval: []f32 = new f32[MAX_GRID](0.0);

gvert: []i32 = new i32[MAX_GRID](0i32);

live: []int = new int[MAX_GRID / 32](0);

g_o: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

g_h: f32 = 0.01;

g_nx: int = 0;

g_ny: int = 0;

g_nz: int = 0;

g_sy: int = 0;

g_sz: int = 0;

// Every cell is this many times the size the figure asks for.
detail: f32 = 1.0;

// How far the space over a vertex is looked into for what closes it in.
const AO_FAR: f32 = 0.025;

// How deep inside another layer a vertex is before it counts as covered;
// and past which it does not: under cloth it never shows, but deep under
// padding it may come out as he moves.
const COVER_DEPTH: f32 = 0.001;

const COVER_REACH: f32 = 0.012;

// ---- each layer's box ----
box_lo: []f32 = new f32[MAX_LAYERS * 3](0.0);

box_hi: []f32 = new f32[MAX_LAYERS * 3](0.0);

// How far past a block shapes can matter to it.
bake_margin: f32 = 0.06;

layer_boxes() {
    kmax: f32 = 0.0;
    tmax: f32 = 0.0;
    for l in 0..nlayers {
        for a in 0..3 {
            box_lo[l * 3 + a] = FAR;
            box_hi[l * 3 + a] = -FAR
        }
        for o in layer_first[l]..layer_first[l] + layer_nops[l] {
            k: int = op_kind[o];
            kmax = maxf(kmax, op_f[o * OP_FLOATS + F_BLEND]);
            if (k < OP_GROW) {
                if (op_mode[o] == MODE_ADD) {
                    for a in 0..3 {
                        box_lo[l * 3 + a] = minf(box_lo[l * 3 + a], op_ball[o * 4 + a] - op_ball[o * 4 + 3]);
                        box_hi[l * 3 + a] = maxf(box_hi[l * 3 + a], op_ball[o * 4 + a] + op_ball[o * 4 + 3])
                    }
                }
            } else {
                r: int = op_ref[o];
                t: f32 = op_f[o * OP_FLOATS + F_GROW];
                tmax = maxf(tmax, absf(t));
                for a in 0..3 {
                    if (k == OP_GROW && box_lo[r * 3 + a] <= box_hi[r * 3 + a]) {
                        box_lo[l * 3 + a] = minf(box_lo[l * 3 + a], box_lo[r * 3 + a] - t);
                        box_hi[l * 3 + a] = maxf(box_hi[l * 3 + a], box_hi[r * 3 + a] + t)
                    }
                    if (k == OP_CLIP) {
                        box_lo[l * 3 + a] = maxf(box_lo[l * 3 + a], box_lo[r * 3 + a]);
                        box_hi[l * 3 + a] = minf(box_hi[l * 3 + a], box_hi[r * 3 + a])
                    }
                }
            }
        }
    }
    bake_margin = maxf(kmax + 2.0 * tmax + 0.004, 2.0 * AO_FAR)
}

// ---- a layer in two meshes ----
// A layer with a finer zone is meshed twice: outside the zone (and a little
// way into it) at its own cell, and inside at the finer one. Where the two
// lap they lie on the same surface.
const ZONE_NONE: int = 0;

const ZONE_OUTSIDE: int = 1;

const ZONE_INSIDE: int = 2;

zone_mode: int = 0;

zone_layer: int = 0;

zone_lap: f32 = 0.0;

// Set on a vertex of a face made only by that cutting in two: it is inside
// its own layer, and never shows.
const COVER_SELF: int = 1073741824;

// The field being meshed: the layer's, cut to the zone's inside or outside.
cut_field(l: int, p: V3): f32 {
    d: f32 = field_of(l, p, false);
    if (zone_mode == ZONE_NONE) return d;
    z: f32 = field_of(zone_layer, p, false);
    if (zone_mode == ZONE_INSIDE) return maxf(d, z);
    maxf(d, -z - zone_lap)
}

// ---- a vertex ----
edge_a: []int = [0, 2, 4, 6, 0, 1, 4, 5, 0, 1, 2, 3];

edge_b: []int = [1, 3, 5, 7, 2, 3, 6, 7, 4, 5, 6, 7];

corner_v: []f32 = new f32[8](0.0);

bone_w: []f32 = new f32[MAX_BONES](0.0);

grid_at(x: int, y: int, z: int): int {
    x + y * g_sy + z * g_sz
}

corner_pos(x: int, y: int, z: int): V3 {
    v3(g_o.x + x as f32 * g_h, g_o.y + y as f32 * g_h, g_o.z + z as f32 * g_h)
}

// How near the scene comes to p, for a vertex of layer l: the least of the
// fields of the layers that show. A layer bound to one bone (a helmet, a
// ball) is left out for the others: it moves apart from them, or is put
// down.
scene(l: int, p: V3): f32 {
    field_all(p);
    d: f32 = FAR;
    for k in 0..nlayers {
        if (!layer_hidden[k] && (k == l || layer_bind[k] < 0)) d = minf(d, layer_val[k])
    }
    d
}

// What the vertex at p of layer l is made of: its bones and their weights,
// its color and finish, its part.
set_makeup(l: int, p: V3, at: int) {
    ncand = 0;
    gather(l, p, 0.0);
    for b in 0..nbones bone_w[b] = 0.0;
    dmin: f32 = FAR;
    cmin: f32 = FAR;
    for i in 0..ncand {
        if (op_mode[cand_op[i]] == MODE_ADD) dmin = minf(dmin, cand_d[i]);
        cmin = minf(cmin, absf(cand_d[i]))
    }
    soft: f32 = layer_skin[l];
    crisp: f32 = maxf(g_h * 0.25, 0.0006);
    rgb: V3 = v3(0.0, 0.0, 0.0);
    wsum: f32 = 0.0;
    best: f32 = -1.0;
    finish: int = mat_finish[layer_mat[l]];
    part: int = -1;
    for i in 0..ncand {
        o: int = cand_op[i];
        if (op_mode[o] == MODE_ADD) {
            w: f32 = maxf(1.0 - (cand_d[i] - dmin) / soft, 0.0);
            w = w * w;
            if (op_bone2[o] >= 0) {
                t: f32 = cone_along(o, p);
                // (Eased, so the two bones' halves meet smoothly.)
                t = t * t * (3.0 - 2.0 * t);
                bone_w[op_bone[o]] = bone_w[op_bone[o]] + w * (1.0 - t);
                bone_w[op_bone2[o]] = bone_w[op_bone2[o]] + w * t
            } else bone_w[op_bone[o]] = bone_w[op_bone[o]] + w
        }
        c: f32 = maxf(1.0 - (absf(cand_d[i]) - cmin) / crisp, 0.0);
        c = c * c;
        if (c > 0.0) {
            m: int = op_mat[o];
            if (m < 0) m = layer_mat[op_layer[o]];
            // (A layer grown from another takes its own material, not the
            // one it grew from.)
            if (op_layer[o] != l && op_mat[o] < 0) m = layer_mat[l];
            rgb = v_madd(rgb, mat_color(m), c);
            wsum = wsum + c;
            if (c > best) {
                best = c;
                finish = mat_finish[m];
                part = op_part[o]
            }
        }
    }
    if (wsum > 0.0) rgb = v_scale(rgb, 1.0 / wsum) else rgb = mat_color(layer_mat[l]);
    verts[at + V_RGB] = rgb.x;
    verts[at + V_RGB + 1] = rgb.y;
    verts[at + V_RGB + 2] = rgb.z;
    verts[at + V_FINISH] = finish as f32;
    verts[at + V_PART] = part as f32;
    verts[at + V_LAYER] = l as f32;
    if (layer_bind[l] >= 0) {
        for b in 0..nbones bone_w[b] = 0.0;
        bone_w[layer_bind[l]] = 1.0
    }
    // The four bones that pull hardest.
    total: f32 = 0.0;
    for k in 0..4 {
        top: int = 0;
        for b in 1..nbones {
            if (bone_w[b] > bone_w[top]) top = b
        }
        verts[at + V_BONES + k] = top as f32;
        verts[at + V_WEIGHTS + k] = bone_w[top];
        total = total + bone_w[top];
        bone_w[top] = 0.0
    }
    if (total <= 0.0) {
        verts[at + V_WEIGHTS] = 1.0;
        total = 1.0
    }
    for k in 0..4 verts[at + V_WEIGHTS + k] = verts[at + V_WEIGHTS + k] / total
}

// The vertex of the cell at (x, y, z), if layer l's surface crosses it.
cell_vertex(
    l: int,
    x: int,
    y: int,
    z: int,
    e: f32
) {
    base: int = grid_at(x, y, z);
    inside: int = 0;
    for c in 0..8 {
        v: f32 = gval[base + (c & 1) + (c >> 1 & 1) * g_sy + (c >> 2 & 1) * g_sz];
        corner_v[c] = v;
        if (v < 0.0) inside = inside + 1
    }
    if (inside == 0 || inside == 8 || nverts >= MAX_VERTS) return;
    // Midway among where the surface crosses the cell's edges.
    sum: V3 = v3(0.0, 0.0, 0.0);
    n: f32 = 0.0;
    for k in 0..12 {
        a: int = edge_a[k];
        b: int = edge_b[k];
        va: f32 = corner_v[a];
        vb: f32 = corner_v[b];
        if (va < 0.0 != vb < 0.0) {
            t: f32 = va / (va - vb);
            pa: V3 = v3((a & 1) as f32, (a >> 1 & 1) as f32, (a >> 2 & 1) as f32);
            pb: V3 = v3((b & 1) as f32, (b >> 1 & 1) as f32, (b >> 2 & 1) as f32);
            sum = v_add(sum, v_lerp(pa, pb, t));
            n = n + 1.0
        }
    }
    lo: V3 = corner_pos(x, y, z);
    p: V3 = v_madd(lo, sum, g_h / n);
    // Onto the surface, staying in the cell: down the slope the cell's
    // corners show, by how far off the field says it is.
    g: V3 = v3(corner_v[1] + corner_v[3] + corner_v[5] + corner_v[7] - corner_v[0] - corner_v[2] - corner_v[4] - corner_v[6],
        corner_v[2] + corner_v[3] + corner_v[6] + corner_v[7] - corner_v[0] - corner_v[1] - corner_v[4] - corner_v[5],
        corner_v[4] + corner_v[5] + corner_v[6] + corner_v[7] - corner_v[0] - corner_v[1] - corner_v[2] - corner_v[3]);
    gl: f32 = v_len(g);
    if (gl > 0.0000001) {
        p = v_madd(p, g, -clampf(cut_field(l, p), -g_h, g_h) / gl);
        p.x = clampf(p.x, lo.x, lo.x + g_h);
        p.y = clampf(p.y, lo.y, lo.y + g_h);
        p.z = clampf(p.z, lo.z, lo.z + g_h)
    }
    nrm: V3 = v_norm(gradient(l, p, e));
    // Which other layers it is inside; and how closed in it is, by how
    // near the scene's surfaces come to points out along its normal.
    field_all(p);
    cover: int = 0;
    if (zone_mode != ZONE_NONE && layer_val[l] < -maxf(g_h * 0.5, COVER_DEPTH)) cover = COVER_SELF;
    for k in 0..nlayers {
        if (k != l && !layer_hidden[k] && layer_val[k] < -COVER_DEPTH && layer_val[k] > -COVER_REACH) cover = cover | 1 << k
    }
    s1: f32 = scene(l, v_madd(p, nrm, AO_FAR));
    ao: f32 = 1.0 - 0.65 * clampf(1.0 - s1 / AO_FAR, 0.0, 1.0);
    at: int = nverts * VERT_FLOATS;
    verts[at] = p.x;
    verts[at + 1] = p.y;
    verts[at + 2] = p.z;
    verts[at + V_NRM] = nrm.x * ao;
    verts[at + V_NRM + 1] = nrm.y * ao;
    verts[at + V_NRM + 2] = nrm.z * ao;
    set_makeup(l, p, at);
    vcover[nverts] = cover;
    gvert[base] = nverts trunc i32;
    nverts = nverts + 1
}

vert_pos(v: int): V3 {
    v3(verts[v * VERT_FLOATS], verts[v * VERT_FLOATS + 1], verts[v * VERT_FLOATS + 2])
}

put_tri(a: int, b: int, c: int) {
    if (ntris >= MAX_TRIS) return;
    tris[ntris * 3] = a trunc i32;
    tris[ntris * 3 + 1] = b trunc i32;
    tris[ntris * 3 + 2] = c trunc i32;
    ntris = ntris + 1
}

// The four cells around a crossed edge, joined: two triangles, split the
// shorter way.
put_quad(
    a: int,
    b: int,
    c: int,
    d: int,
    flip: bool
) {
    if (a < 0 || b < 0 || c < 0 || d < 0) return;
    if (flip) {
        t: int = b;
        b = d;
        d = t
    }
    if (v_len(v_sub(vert_pos(a), vert_pos(c))) <= v_len(v_sub(vert_pos(b), vert_pos(d)))) {
        put_tri(a, b, c);
        put_tri(a, c, d)
    } else {
        put_tri(a, b, d);
        put_tri(b, c, d)
    }
}

cell_quads(x: int, y: int, z: int) {
    i0: int = grid_at(x, y, z);
    d0: f32 = gval[i0];
    if (y > 0 && z > 0) {
        d1: f32 = gval[i0 + 1];
        if (d0 < 0.0 != d1 < 0.0) put_quad(gvert[i0 - g_sy - g_sz] as int, gvert[i0 - g_sz] as int,
            gvert[i0] as int, gvert[i0 - g_sy] as int, d0 >= 0.0)
    }
    if (x > 0 && z > 0) {
        d1: f32 = gval[i0 + g_sy];
        if (d0 < 0.0 != d1 < 0.0) put_quad(gvert[i0 - g_sz - 1] as int, gvert[i0 - 1] as int,
            gvert[i0] as int, gvert[i0 - g_sz] as int, d0 >= 0.0)
    }
    if (x > 0 && y > 0) {
        d1: f32 = gval[i0 + g_sz];
        if (d0 < 0.0 != d1 < 0.0) put_quad(gvert[i0 - 1 - g_sy] as int, gvert[i0 - g_sy] as int,
            gvert[i0] as int, gvert[i0 - 1] as int, d0 >= 0.0)
    }
}

// Forget every mesh.
bake_begin() {
    prepare_cones();
    bk_layer = -1;
    zone_mode = ZONE_NONE;
    nverts = 0;
    ntris = 0;
    layer_boxes();
    for l in 0..nlayers {
        layer_v0[l] = 0;
        layer_vn[l] = 0;
        layer_t0[l] = 0;
        layer_tn[l] = 0
    }
    for s in 0..MAX_STICKERS {
        sticker_t0[s] = 0;
        sticker_tn[s] = 0
    }
}

up_to(n: f32): int {
    k: int = (n + 0.999) as int;
    (k + BLOCK - 1) / BLOCK * BLOCK
}

extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int
}

mono_ns(): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    ts.sec * 1000000000 + ts.nsec
}

// ---- a layer's mesh, a little at a time ----
// Baking a layer can take a second or more, so it is done in pieces: the
// viewer gives it a few milliseconds of each frame, and goes on drawing and
// listening meanwhile. What it is in the middle of is kept here.
const STAGE_CLEAR: int = 3;

const STAGE_BLOCKS: int = 1;

const STAGE_QUADS: int = 2;

// The layer being baked (-1 for none), which of its two meshes, and what
// that mesh is up to.
bk_layer: int = -1;

bk_second: bool = false;

bk_stage: int = 0;

bk_block: int = 0;

// How much of the grid has been wiped for this mesh.
bk_cleared: int = 0;

bk_blocks: int = 0;

bk_bx_n: int = 0;

bk_by_n: int = 0;

bk_nlive: int = 0;

bk_quad: int = 0;

bk_radius: f32 = 0.0;

bk_reach: f32 = 0.0;

bk_e: f32 = 0.0;

// Whether the wider list of shapes is the one for the block being done.
bk_wide: bool = false;

// Begin one mesh of the layer being baked: the field cut_field gives, in a
// box, at cell h. False if the box is empty.
begin_pass(h: f32, lo: V3, hi: V3): bool {
    if (lo.x >= hi.x || lo.y >= hi.y || lo.z >= hi.z) return false;
    fits: bool = false;
    while (!fits) {
        g_nx = up_to((hi.x - lo.x) / h + 4.0);
        g_ny = up_to((hi.y - lo.y) / h + 4.0);
        g_nz = up_to((hi.z - lo.z) / h + 4.0);
        fits = (g_nx + 1) * (g_ny + 1) * (g_nz + 1) <= MAX_GRID;
        if (!fits) h = h * 1.1
    }
    g_h = h;
    g_o = v3(lo.x - 2.0 * h, lo.y - 2.0 * h, lo.z - 2.0 * h);
    g_sy = g_nx + 1;
    g_sz = (g_nx + 1) * (g_ny + 1);
    bk_cleared = 0;
    bk_radius = h * BLOCK as f32 * 0.867;
    bk_reach = bk_radius + bake_margin;
    bk_e = maxf(h * 0.3, 0.0004);
    bk_bx_n = g_nx / BLOCK;
    bk_by_n = g_ny / BLOCK;
    bk_blocks = bk_bx_n * bk_by_n * (g_nz / BLOCK);
    bk_block = 0;
    bk_nlive = 0;
    bk_quad = 0;
    bk_wide = false;
    bk_stage = STAGE_CLEAR;
    true
}

// The layer's first mesh, or (for a layer with a finer zone) its second.
begin_mesh(second: bool): bool {
    l: int = bk_layer;
    h: f32 = layer_cell[l];
    if (h <= 0.0) h = fig_cell;
    h = h * detail;
    lo: V3 = v3(box_lo[l * 3], box_lo[l * 3 + 1], box_lo[l * 3 + 2]);
    hi: V3 = v3(box_hi[l * 3], box_hi[l * 3 + 1], box_hi[l * 3 + 2]);
    z: int = layer_zone[l];
    bk_second = second;
    zone_mode = ZONE_NONE;
    if (z < 0) return !second && begin_pass(h, lo, hi);
    zone_layer = z;
    zone_lap = 2.0 * h;
    if (!second) {
        zone_mode = ZONE_OUTSIDE;
        return begin_pass(h, lo, hi)
    }
    zone_mode = ZONE_INSIDE;
    lo = v3(maxf(lo.x, box_lo[z * 3]), maxf(lo.y, box_lo[z * 3 + 1]), maxf(lo.z, box_lo[z * 3 + 2]));
    hi = v3(minf(hi.x, box_hi[z * 3]), minf(hi.y, box_hi[z * 3 + 1]), minf(hi.z, box_hi[z * 3 + 2]));
    begin_pass(layer_fine[l] * detail, lo, hi)
}

// Block b of the mesh being baked: its corners' fields and its cells'
// vertices, if the surface comes near it.
bake_block(b: int) {
    l: int = bk_layer;
    h: f32 = g_h;
    bx: int = b % bk_bx_n;
    by: int = b / bk_bx_n % bk_by_n;
    bz: int = b / (bk_bx_n * bk_by_n);
    x0: int = bx * BLOCK;
    y0: int = by * BLOCK;
    z0: int = bz * BLOCK;
    half: f32 = BLOCK as f32 * 0.5;
    c: V3 = v3(g_o.x + (x0 as f32 + half) * h, g_o.y + (y0 as f32 + half) * h, g_o.z + (z0 as f32 + half) * h);
    // (The shapes near are picked from those near the eight blocks this
    // one is among.)
    if (bx % 2 == 0 || !bk_wide) {
        wx: f32 = g_o.x + (bx / 2 * 2 * BLOCK + BLOCK) as f32 * h;
        wy: f32 = g_o.y + (by / 2 * 2 * BLOCK + BLOCK) as f32 * h;
        wz: f32 = g_o.z + (bz / 2 * 2 * BLOCK + BLOCK) as f32 * h;
        set_wide(v3(wx, wy, wz), bk_reach + bk_radius);
        bk_wide = true
    }
    set_active(c, bk_reach);
    if (act_n[l] == 0 || absf(cut_field(l, c)) > bk_radius * 1.5 + 0.002) return;
    // By halves: each eighth of the block the surface comes near gets its
    // corners' fields and its cells' vertices; the others only which side
    // of the surface they are on.
    for s in 0..8 {
        sx: int = x0 + (s & 1) * 2;
        sy: int = y0 + (s >> 1 & 1) * 2;
        sz: int = z0 + (s >> 2 & 1) * 2;
        d: f32 = cut_field(l, corner_pos(sx + 1, sy + 1, sz + 1));
        near: bool = absf(d) <= h * 2.8 + 0.0005;
        for z in sz..sz + 3 {
            for y in sy..sy + 3 {
                for x in sx..sx + 3 {
                    i: int = grid_at(x, y, z);
                    if (absf(gval[i]) > ROUGH * 0.5) {
                        if (near) gval[i] = cut_field(l, corner_pos(x, y, z)) else if (d < 0.0) gval[i] = -ROUGH else gval[i] = ROUGH
                    }
                }
            }
        }
        if (near) {
            for z in sz..sz + 2 {
                for y in sy..sy + 2 {
                    for x in sx..sx + 2 cell_vertex(l, x, y, z, bk_e)
                }
            }
        }
    }
    if (bk_nlive < len(live)) {
        live[bk_nlive] = b;
        bk_nlive = bk_nlive + 1
    }
}

// Begin baking layer l.
begin_layer(l: int) {
    layer_v0[l] = nverts;
    layer_t0[l] = ntris;
    layer_vn[l] = 0;
    layer_tn[l] = 0;
    bk_layer = l;
    bk_stage = 0;
    if (!layer_hidden[l] && !begin_mesh(false)) {
        if (layer_zone[l] >= 0 && !begin_mesh(true)) bk_stage = 0
    }
}

// Go on baking the layer begun, until it is done (true) or the clock
// passes the deadline (0 for none).
work_layer(deadline: int): bool {
    l: int = bk_layer;
    while (bk_stage != 0) {
        if (bk_stage == STAGE_CLEAR) {
            total: int = g_sz * (g_nz + 1);
            while (bk_cleared < total) {
                upto: int = mini(bk_cleared + 200000, total);
                for i in bk_cleared..upto {
                    gval[i] = UNSET;
                    gvert[i] = -1i32
                }
                bk_cleared = upto;
                if (deadline > 0 && mono_ns() > deadline) return false
            }
            bk_stage = STAGE_BLOCKS
        }
        if (bk_stage == STAGE_BLOCKS) {
            while (bk_block < bk_blocks) {
                lived: int = bk_nlive;
                bake_block(bk_block);
                bk_block = bk_block + 1;
                if (deadline > 0 && (bk_block % 8 == 0 || bk_nlive != lived) && mono_ns() > deadline) return false
            }
            bk_stage = STAGE_QUADS
        }
        while (bk_quad < bk_nlive) {
            b: int = live[bk_quad];
            x0: int = b % bk_bx_n * BLOCK;
            y0: int = b / bk_bx_n % bk_by_n * BLOCK;
            z0: int = b / (bk_bx_n * bk_by_n) * BLOCK;
            for z in z0..z0 + BLOCK {
                for y in y0..y0 + BLOCK {
                    for x in x0..x0 + BLOCK cell_quads(x, y, z)
                }
            }
            bk_quad = bk_quad + 1;
            if (deadline > 0 && bk_quad % 64 == 0 && mono_ns() > deadline) return false
        }
        // That mesh is whole: a layer with a finer zone has another.
        bk_stage = 0;
        if (!bk_second && layer_zone[l] >= 0 && !begin_mesh(true)) bk_stage = 0
    }
    zone_mode = ZONE_NONE;
    layer_vn[l] = nverts - layer_v0[l];
    layer_tn[l] = ntris - layer_t0[l];
    bk_layer = -1;
    true
}

// ---- stickers ----
// Every sticker's picture has a tile of one texture.
const TILE: int = 256;

const ATLAS_W: int = 2048;

const ATLAS_H: int = 1024;

atlas: []i8 = new i8[ATLAS_W * ATLAS_H * 4](0i8);

// The new vertex made for each of a layer's, for the sticker being built.
vert_twin: []i32 = new i32[MAX_VERTS](0i32);

sticker_vert(s: int, v: int): int {
    if (vert_twin[v] >= 0i32) return vert_twin[v] as int;
    if (nverts >= MAX_VERTS) return v;
    at: int = nverts * VERT_FLOATS;
    for i in 0..VERT_FLOATS verts[at + i] = verts[v * VERT_FLOATS + i];
    d: V3 = v_sub(vert_pos(v), stv(s, S_O));
    verts[at + V_RGB] = v_dot(d, stv(s, S_RIGHT)) / st_f[s * ST_FLOATS + S_W] + 0.5;
    verts[at + V_RGB + 1] = v_dot(d, stv(s, S_UP)) / st_f[s * ST_FLOATS + S_H] + 0.5;
    verts[at + V_RGB + 2] = s as f32;
    verts[at + V_FINISH] = FINISH_STICKER;
    vcover[nverts] = vcover[v];
    vert_twin[v] = nverts trunc i32;
    nverts = nverts + 1;
    nverts - 1
}

// Whether the layer's vertex v is under sticker s: within its depth and
// turned toward it. Where it is across the sticker goes to su and sv.
su: f32 = 0.0;

sv: f32 = 0.0;

under_sticker(s: int, v: int): bool {
    d: V3 = v_sub(vert_pos(v), stv(s, S_O));
    su = v_dot(d, stv(s, S_RIGHT)) / st_f[s * ST_FLOATS + S_W];
    sv = v_dot(d, stv(s, S_UP)) / st_f[s * ST_FLOATS + S_H];
    if (absf(v_dot(d, stv(s, S_FACING))) > st_f[s * ST_FLOATS + S_DEPTH]) return false;
    i: int = v * VERT_FLOATS + V_NRM;
    v_dot(v_norm(v3(verts[i], verts[i + 1], verts[i + 2])), stv(s, S_FACING)) > 0.05
}

// The triangles of its layer that sticker s lies on, again as its own.
bake_sticker(s: int) {
    sticker_t0[s] = ntris;
    l: int = st_layer[s];
    for v in layer_v0[l]..layer_v0[l] + layer_vn[l] vert_twin[v] = -1i32;
    for t in layer_t0[l]..layer_t0[l] + layer_tn[l] {
        ok: bool = true;
        ulo: f32 = FAR;
        uhi: f32 = -FAR;
        vlo: f32 = FAR;
        vhi: f32 = -FAR;
        for k in 0..3 {
            if (!under_sticker(s, tris[t * 3 + k] as int)) ok = false;
            ulo = minf(ulo, su);
            uhi = maxf(uhi, su);
            vlo = minf(vlo, sv);
            vhi = maxf(vhi, sv)
        }
        if (ok && ulo < 0.5 && uhi > -0.5 && vlo < 0.5 && vhi > -0.5) {
            a: int = sticker_vert(s, tris[t * 3] as int);
            b: int = sticker_vert(s, tris[t * 3 + 1] as int);
            c: int = sticker_vert(s, tris[t * 3 + 2] as int);
            put_tri(a, b, c)
        }
    }
    sticker_tn[s] = ntris - sticker_t0[s]
}

// Seven strokes make each digit: top, upper right, lower right, bottom,
// lower left, upper left, middle; a bit for each.
digit_strokes: []int = [63, 6, 91, 79, 102, 109, 125, 7, 127, 111];

in_rect(
    x: f32,
    y: f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    grow: f32
): bool {
    x >= x0 - grow && x <= x1 + grow && y >= y0 - grow && y <= y1 + grow
}

// Whether (x, y) is in the digits of mark m, grown by grow.
in_digits(
    m: int,
    x: f32,
    y: f32,
    grow: f32
): bool {
    id: int = mk_text[m];
    n: int = name_len[id];
    h: f32 = mk_f[m * MARK_FLOATS + 2];
    w: f32 = h * 0.58;
    gap: f32 = h * 0.16;
    s: f32 = h * 0.19;
    left: f32 = mk_f[m * MARK_FLOATS] - (n as f32 * w + (n - 1) as f32 * gap) * 0.5;
    y0: f32 = mk_f[m * MARK_FLOATS + 1] - h * 0.5;
    y1: f32 = y0 + h;
    ym: f32 = (y0 + y1) * 0.5;
    for i in 0..n {
        d: int = name_pool[name_at[id] + i] as int - 48;
        if (d >= 0 && d <= 9) {
            bits: int = digit_strokes[d];
            x0: f32 = left + i as f32 * (w + gap);
            x1: f32 = x0 + w;
            // (A one stands in the middle of its place.)
            if (d == 1) {
                x0 = x0 + (w - s) * 0.5 - (w - s);
                x1 = x0 + w
            }
            if ((bits & 1) != 0 && in_rect(x, y, x0, y1 - s, x1, y1, grow)) return true;
            if ((bits & 2) != 0 && in_rect(x, y, x1 - s, ym, x1, y1, grow)) return true;
            if ((bits & 4) != 0 && in_rect(x, y, x1 - s, y0, x1, ym, grow)) return true;
            if ((bits & 8) != 0 && in_rect(x, y, x0, y0, x1, y0 + s, grow)) return true;
            if ((bits & 16) != 0 && in_rect(x, y, x0, y0, x0 + s, ym, grow)) return true;
            if ((bits & 32) != 0 && in_rect(x, y, x0, ym, x0 + s, y1, grow)) return true;
            if ((bits & 64) != 0 && in_rect(x, y, x0, ym - s * 0.5, x1, ym + s * 0.5,
                grow)) return true
        }
    }
    false
}

// Whether (x, y), in metres from the sticker's middle, is in mark m.
in_mark(m: int, x: f32, y: f32): bool {
    i: int = m * MARK_FLOATS;
    k: int = mk_kind[m];
    if (k == MARK_DISC) {
        dx: f32 = x - mk_f[i];
        dy: f32 = y - mk_f[i + 1];
        return dx * dx + dy * dy <= mk_f[i + 2] * mk_f[i + 2]
    }
    if (k == MARK_OVAL) {
        dx: f32 = (x - mk_f[i]) / maxf(mk_f[i + 2], 0.00001);
        dy: f32 = (y - mk_f[i + 1]) / maxf(mk_f[i + 3], 0.00001);
        return dx * dx + dy * dy <= 1.0
    }
    if (k == MARK_LINE) {
        ax: f32 = mk_f[i];
        ay: f32 = mk_f[i + 1];
        bx: f32 = mk_f[i + 2] - ax;
        by: f32 = mk_f[i + 3] - ay;
        t: f32 = clampf(((x - ax) * bx + (y - ay) * by) / maxf(bx * bx + by * by,
            0.0000001), 0.0, 1.0);
        dx: f32 = x - ax - bx * t;
        dy: f32 = y - ay - by * t;
        r: f32 = mk_f[i + 4] * 0.5;
        return dx * dx + dy * dy <= r * r
    }
    if (k == MARK_RECT) {
        r: f32 = mk_f[i + 4];
        cx: f32 = (mk_f[i] + mk_f[i + 2]) * 0.5;
        cy: f32 = (mk_f[i + 1] + mk_f[i + 3]) * 0.5;
        ex: f32 = maxf(absf(x - cx) - absf(mk_f[i + 2] - mk_f[i]) * 0.5 + r, 0.0);
        ey: f32 = maxf(absf(y - cy) - absf(mk_f[i + 3] - mk_f[i + 1]) * 0.5 + r, 0.0);
        return ex * ex + ey * ey <= r * r + 0.0000000001
    }
    in_digits(m, x, y, 0.0)
}

// Sticker s's picture into its tile: its marks one over another, each
// texel from four points in it.
paint_sticker(s: int) {
    tx: int = s % (ATLAS_W / TILE) * TILE;
    ty: int = s / (ATLAS_W / TILE) * TILE;
    w: f32 = st_f[s * ST_FLOATS + S_W];
    h: f32 = st_f[s * ST_FLOATS + S_H];
    for py in 0..TILE {
        for px in 0..TILE {
            r: f32 = 0.0;
            g: f32 = 0.0;
            b: f32 = 0.0;
            a: f32 = 0.0;
            for k in 0..4 {
                fx: f32 = (px as f32 + 0.25 + 0.5 * (k & 1) as f32) / TILE as f32;
                fy: f32 = (py as f32 + 0.25 + 0.5 * (k >> 1) as f32) / TILE as f32;
                x: f32 = (fx - 0.5) * w;
                y: f32 = (fy - 0.5) * h;
                hit: int = -1;
                for m in st_first[s]..st_first[s] + st_n[s] {
                    if (mk_kind[m] == MARK_DIGITS && mk_edge[m] >= 0 && in_digits(m,
                        x, y, mk_f[m * MARK_FLOATS + 5])) hit = mk_edge[m];
                    if (in_mark(m, x, y)) hit = mk_mat[m]
                }
                if (hit >= 0) {
                    r = r + mat_rgb[hit * 3];
                    g = g + mat_rgb[hit * 3 + 1];
                    b = b + mat_rgb[hit * 3 + 2];
                    a = a + 1.0
                }
            }
            // (The edge texels stay clear, so nothing bleeds past the tile.)
            if (px == 0 || py == 0 || px == TILE - 1 || py == TILE - 1) a = 0.0;
            i: int = ((ty + py) * ATLAS_W + tx + px) * 4;
            if (a > 0.0) {
                atlas[i] = (r / a * 255.0) as int trunc i8;
                atlas[i + 1] = (g / a * 255.0) as int trunc i8;
                atlas[i + 2] = (b / a * 255.0) as int trunc i8
            } else {
                atlas[i] = 0i8;
                atlas[i + 1] = 0i8;
                atlas[i + 2] = 0i8
            }
            atlas[i + 3] = (a * 63.75) as int trunc i8
        }
    }
}

// ---- standing on the ground ----
// For each bone, the vertices it mostly moves that reach farthest each way:
// the lowest of them all, posed, is where the figure stands.
probe: []f32 = new f32[MAX_BONES * 18](0.0);

probe_set: []bool = new bool[MAX_BONES](false);

find_probes() {
    for b in 0..nbones probe_set[b] = false;
    for v in 0..nverts {
        at: int = v * VERT_FLOATS;
        if (verts[at + V_FINISH] != FINISH_STICKER && verts[at + V_WEIGHTS] > 0.5) {
            b: int = verts[at + V_BONES] as int;
            p: V3 = vert_pos(v);
            for k in 0..6 {
                q: int = b * 18 + k * 3;
                axis: int = k / 2;
                better: bool = !probe_set[b];
                if (!better) {
                    if (k % 2 == 0) better = verts[at + axis] < probe[q + axis] else better = verts[at + axis] > probe[q + axis]
                }
                if (better) {
                    probe[q] = p.x;
                    probe[q + 1] = p.y;
                    probe[q + 2] = p.z
                }
            }
            probe_set[b] = true
        }
    }
}

// ---- what is drawn ----
// The triangles to draw: each layer's that show, leaving out those wholly
// inside another layer that shows.
draw_idx: []i32 = new i32[MAX_TRIS * 3](0i32);

draw_n: int = 0;

layer_d0: []int = new int[MAX_LAYERS](0);

layer_dn: []int = new int[MAX_LAYERS](0);

// (The stickers follow the layers, as one run.)
stickers_d0: int = 0;

stickers_dn: int = 0;

layer_shown: []bool = new bool[MAX_LAYERS](true);

// Layers the pose shown hides, as bits.
pose_hidden: int = 0;

add_draws(t0: int, tn: int, mask: int) {
    for t in t0..t0 + tn {
        a: int = tris[t * 3] as int;
        b: int = tris[t * 3 + 1] as int;
        c: int = tris[t * 3 + 2] as int;
        if ((vcover[a] & mask) == 0 || (vcover[b] & mask) == 0 || (vcover[c] & mask) == 0) {
            draw_idx[draw_n] = tris[t * 3];
            draw_idx[draw_n + 1] = tris[t * 3 + 1];
            draw_idx[draw_n + 2] = tris[t * 3 + 2];
            draw_n = draw_n + 3
        }
    }
}

build_draws() {
    mask: int = COVER_SELF;
    for l in 0..nlayers {
        if (layer_shown[l] && !layer_hidden[l] && (pose_hidden >> l & 1) == 0) mask = mask | 1 << l
    }
    draw_n = 0;
    for l in 0..nlayers {
        layer_d0[l] = draw_n;
        if ((mask >> l & 1) == 1) add_draws(layer_t0[l], layer_tn[l], mask);
        layer_dn[l] = draw_n - layer_d0[l]
    }
    stickers_d0 = draw_n;
    for s in 0..nstickers {
        if ((mask >> st_layer[s] & 1) == 1) add_draws(sticker_t0[s], sticker_tn[s],
            mask)
    }
    stickers_dn = draw_n - stickers_d0
}
