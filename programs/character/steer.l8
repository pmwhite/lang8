tag character;

use_tag skate;

// Steering, step by step: what motion/gen/plan.py and body.py do to make the
// maneuver takes, done as he goes, a step ahead of him.
//
// He is a point over the ground (his hips) and his feet. Each step is a foot
// down for a while, pushing him, then a flight. At each landing the step
// after is decided from the stick: an ordinary step (speeding up, slowing,
// or bending his way as an arc, no harder than his grip holds); or, for a
// sharper change of way, braking steps, a penultimate step on the inside
// foot, and a plant on the outside foot that swings him round, then a push
// off; or, nearly right round, braking to a pivot. Where a foot lands is
// where the run cycle at his speed would put it, moved by whatever more its
// push asks (along the leg, from the foot to his hips), within the leg's
// reach.
//
// The body is the run cycles' (the gait's `cycles`, measured runners), at
// his speed and at the point of the stride his steps are at: the foot down
// held on its spot, rocking heel to ball; the foot in the air carried from
// where it left to where it will land along the cycle's own path; the hips
// as high as the cycle has them, lowered into braking steps and plants and
// as far as a foot down needs to be reached; facing the way he goes, swung
// round ahead of his path through a plant; leaning into an arc, toward a
// cut, and into speeding up.
// ---- the cycles ----
const MAX_CYC: int = 32;

// Gait's cycles, slowest first: the take, its speed, stride time, and the
// share of the stride a foot is down.
cyc_take: []int = new int[MAX_CYC](0);

cyc_v: []f32 = new f32[MAX_CYC](0.0);

cyc_stride: []f32 = new f32[MAX_CYC](0.0);

cyc_duty: []f32 = new f32[MAX_CYC](0.0);

// Each cycle's root height over the stride, on average.
cyc_ym: []f32 = new f32[MAX_CYC](0.0);

ncyc: int = 0;

steer_cycles(g: int) {
    ncyc = 0;
    for m in 0..ncycles {
        if (cycle_gait[m] == g && cycle_take[m] >= 0 && ncyc < MAX_CYC) {
            t: int = cycle_take[m];
            n: int = take_n[t];
            // (Its speed: the ground the root covers over the stride.)
            dz: f32 = tf(t, n - 1, TAKE_ROOT + 2) - tf(t, 0, TAKE_ROOT + 2);
            secs: f32 = n as f32 / take_fps[t];
            down: int = 0;
            for i in 0..n {
                if (tf(t, i, TAKE_DOWN + 1) > 0.5) down = down + 1
            }
            // (Kept slowest first.)
            k: int = ncyc;
            v: f32 = dz * take_fps[t] / maxf((n - 1) as f32, 1.0);
            while (k > 0 && cyc_v[k - 1] > v) {
                cyc_take[k] = cyc_take[k - 1];
                cyc_v[k] = cyc_v[k - 1];
                cyc_stride[k] = cyc_stride[k - 1];
                cyc_duty[k] = cyc_duty[k - 1];
                cyc_ym[k] = cyc_ym[k - 1];
                k = k - 1
            }
            ym: f32 = 0.0;
            for f in 0..n ym = ym + tf(t, f, TAKE_ROOT + 1);
            cyc_ym[k] = ym / n as f32;
            cyc_take[k] = t;
            cyc_v[k] = v;
            cyc_stride[k] = secs;
            cyc_duty[k] = down as f32 / n as f32;
            ncyc = ncyc + 1
        }
    }
}

// The two cycles about speed v, and how far from the first to the second.
cyc_lo: int = 0;

cyc_f: f32 = 0.0;

cycle_pair(v: f32) {
    cyc_lo = 0;
    cyc_f = 0.0;
    if (ncyc < 2) return;
    if (v <= cyc_v[0]) return;
    if (v >= cyc_v[ncyc - 1]) {
        cyc_lo = ncyc - 2;
        cyc_f = 1.0;
        return
    }
    while (cyc_lo < ncyc - 2 && cyc_v[cyc_lo + 1] < v) cyc_lo = cyc_lo + 1;
    cyc_f = (v - cyc_v[cyc_lo]) / maxf(cyc_v[cyc_lo + 1] - cyc_v[cyc_lo], 0.01)
}

// A step's time and its contact, at speed v.
step_time(v: f32): f32 {
    cycle_pair(v);
    lerpf(cyc_stride[cyc_lo], cyc_stride[mini(cyc_lo + 1, ncyc - 1)], cyc_f) * 0.5
}

step_contact(v: f32): f32 {
    cycle_pair(v);
    a: int = cyc_lo;
    b: int = mini(cyc_lo + 1, ncyc - 1);
    lerpf(cyc_stride[a] * cyc_duty[a], cyc_stride[b] * cyc_duty[b], cyc_f)
}

duty_at(v: f32): f32 {
    cycle_pair(v);
    lerpf(cyc_duty[cyc_lo], cyc_duty[mini(cyc_lo + 1, ncyc - 1)], cyc_f)
}

// The cycles at speed v and a point of the stride (0: the right foot lands,
// a half: the left), into cs (16 directions, run frame: x his left, y up, z
// ahead) and cs_y (the root's height).
cs: []f32 = new f32[48](0.0);

cs_y: f32 = 0.0;

// And its height on average over the stride.
cs_ym: f32 = 0.0;

sample_cycles(v: f32, phase: f32) {
    cycle_pair(maxf(v, 1.5));
    for i in 0..48 cs[i] = 0.0;
    cs_y = 0.0;
    for j in 0..2 {
        c: int = mini(cyc_lo + j, ncyc - 1);
        w: f32 = 1.0 - cyc_f;
        if (j == 1) w = cyc_f;
        t: int = cyc_take[c];
        n: int = take_n[t];
        at: f32 = frac(phase) * n as f32;
        i0: int = mini(at as int, n - 1);
        i1: int = (i0 + 1) % n;
        u: f32 = at - i0 as f32;
        for k in 0..48 cs[k] = cs[k] + lerpf(tf(t, i0, k), tf(t, i1, k), u) * w;
        cs_y = cs_y + lerpf(tf(t, i0, TAKE_ROOT + 1), tf(t, i1, TAKE_ROOT + 1), u) * w
    }
    cs_ym = lerpf(cyc_ym[cyc_lo], cyc_ym[mini(cyc_lo + 1, ncyc - 1)], cyc_f);
    for k in 0..16 {
        d: V3 = v_norm(v3(cs[k * 3], cs[k * 3 + 1], cs[k * 3 + 2]));
        cs[k * 3] = d.x;
        cs[k * 3 + 1] = d.y;
        cs[k * 3 + 2] = d.z
    }
}

cdir(k: int): V3 {
    v3(cs[k * 3], cs[k * 3 + 1], cs[k * 3 + 2])
}

// Direction k of the cycles, turned to face yaw.
cdir_at(k: int, yaw: f32): V3 {
    v_rotate(cdir(k), UP, yaw)
}

// ---- key poses ----
// The gait's key poses (see figure.l8's gait_keys), as the sixteen
// directions of the run frame (x his left, y up, z ahead), struck with the
// right foot down; and how far each has his hips below standing.
const KEY_CHOP: int = 0;

const KEY_PLANT: int = 1;

const KEY_DRIVE: int = 2;

const KEY_PIVOT: int = 3;

const KEY_READY: int = 4;

key_d: []f32 = new f32[NKEYS * 48](0.0);

key_dy: []f32 = new f32[NKEYS](0.0);

key_ok: []bool = new bool[NKEYS](false);

put_key(k: int, d: int, v: V3) {
    key_d[k * 48 + d * 3] = v.x;
    key_d[k * 48 + d * 3 + 1] = v.y;
    key_d[k * 48 + d * 3 + 2] = v.z
}

// Direction d of key k, mirrored (for the left foot down) if asked.
key_dir(k: int, d: int, mirror: bool): V3 {
    if (!mirror) return v3(key_d[k * 48 + d * 3], key_d[k * 48 + d * 3 + 1], key_d[k * 48 + d * 3 + 2]);
    // (The other side's limb, mirrored; a left mirrored is a right, so turned
    // back to a left.)
    // (Not the arms: the ball stays in the same arm, and the free arm does
    // what it does on either foot.)
    if (d >= 6 && d <= 9) return v3(key_d[k * 48 + d * 3], key_d[k * 48 + d * 3 + 1],
        key_d[k * 48 + d * 3 + 2]);
    e: int = d;
    if (d >= 10 && d <= 11) e = d + 2 else if (d >= 12 && d <= 13) e = d - 2 else if (d == 14) e = 15 else if (d == 15) e = 14;
    v: V3 = v3(-key_d[k * 48 + e * 3], key_d[k * 48 + e * 3 + 1], key_d[k * 48 + e * 3 + 2]);
    if (d == 0 || d == 2 || d == 4) v = v_scale(v, -1.0);
    v
}

limb_dirs(k: int, d: int, end: int) {
    mid: int = bone_parent[end];
    up: int = bone_parent[mid];
    put_key(k, d, v_norm(v_sub(wp(mid), wp(up))));
    put_key(k, d + 1, v_norm(v_sub(wp(end), wp(mid))))
}

// Gait g's key poses, read from the poses as solved.
read_keys(g: int) {
    for k in 0..NKEYS {
        p: int = gait_keys[g * NKEYS + k];
        key_ok[k] = p >= 0;
        if (p >= 0) {
            place_bones(p);
            root: int = gait_root[g];
            put_key(k, 0, q_turn(wq(root), v3(1.0, 0.0, 0.0)));
            put_key(k, 1, q_turn(wq(root), v3(0.0, 1.0, 0.0)));
            ch: int = gait_spine[g * 2 + 1];
            if (ch < 0) ch = root;
            put_key(k, 2, q_turn(wq(ch), v3(1.0, 0.0, 0.0)));
            put_key(k, 3, q_turn(wq(ch), v3(0.0, 1.0, 0.0)));
            hd: int = gait_head[g];
            if (hd < 0) hd = ch;
            put_key(k, 4, q_turn(wq(hd), v3(1.0, 0.0, 0.0)));
            put_key(k, 5, q_turn(wq(hd), v3(0.0, 0.0, 1.0)));
            hand: int = hand_of(g);
            if (hand >= 0) {
                limb_dirs(k, 6, hand);
                limb_dirs(k, 8, bone_twin[hand])
            }
            foot: int = gait_foot[g];
            limb_dirs(k, 10, foot);
            limb_dirs(k, 12, bone_twin[foot]);
            put_key(k, 14, q_turn(wq(foot), v3(0.0, 0.0, 1.0)));
            put_key(k, 15, q_turn(wq(bone_twin[foot]), v3(0.0, 0.0, 1.0)));
            key_dy[k] = wp(root).y - bone_pos(root).y
        }
    }
}

// The way key k's knee on side sd points from its hip-ankle line.
key_knee(k: int, sd: int): V3 {
    th: V3 = key_dir(k, 10 + 2 * sd, key_m[k]);
    sh: V3 = key_dir(k, 11 + 2 * sd, key_m[k]);
    an: V3 = v_norm(v_add(v_scale(th, leg_upper), v_scale(sh, leg_lower)));
    kn: V3 = v_madd(th, an, -v_dot(th, an));
    if (v_len(kn) < 0.000001) return v3(0.0, 0.0, 1.0);
    v_norm(kn)
}

// Which key, how much, and mirrored or not, this tick (see key_weights).
key_w: []f32 = new f32[NKEYS](0.0);

key_m: []bool = new bool[NKEYS](false);

s_ready_w: f32 = 0.0;

step_key(kind: int): int {
    if (kind == K_BRAKE || kind == K_STOP || kind == K_PEN) return KEY_CHOP;
    if (kind == K_PLANT || kind == K_CROSS) return KEY_PLANT;
    if (kind == K_PUSH) return KEY_DRIVE;
    if (kind == K_PPEN || kind == K_PIVOT) return KEY_PIVOT;
    -1
}

// Each step's key rises from just before it lands to its full weight
// through the middle of its contact, and goes as it leaves and flies.
key_weights() {
    for k in 0..NKEYS key_w[k] = 0.0;
    for o in 0..3 {
        j: int = (s_cur - 1 + o + NST) % NST;
        k: int = step_key(st_kind[j]);
        if (k >= 0 && key_ok[k]) {
            tc: f32 = maxf(st_tc[j], 0.05);
            lead: f32 = 0.08;
            // (Off a plant the knee drives on while the plant foot is still down.)
            if (k == KEY_DRIVE) lead = 0.2;
            up: f32 = smoothstepf(st_t[j] - lead, st_t[j] + 0.3 * tc, s_now);
            down: f32 = 1.0 - smoothstepf(st_t[j] + 0.75 * tc, step_end(j) + 0.08,
                s_now);
            w: f32 = minf(up, down);
            if (w > key_w[k]) {
                key_w[k] = w;
                key_m[k] = st_side[j] == 0
            }
        }
    }
    if (key_ok[KEY_READY]) key_w[KEY_READY] = s_ready_w
}

// ---- his limits (see motion/README.md and motion/gen/solver.py) ----
const GRAV: f32 = 9.81;

// The most the ground pushes along it, as a share of its push up (cleats on
// grass); the hardest push up, per unit mass; the leg's reach from his centre
// of mass to the middle of the foot's push; the shortest contact.
const MU: f32 = 1.0;

const F_MAX: f32 = 44.0;

const REACH: f32 = 1.12;

const TC_MIN: f32 = 0.08;

// What running low costs, seconds for each (metre below his usual height)
// squared, each tenth of a second.
const LOW_COST: f32 = 3.0;

// His speed's top: he speeds up hardest from slow, none at it.
const S_TOP: f32 = 10.4;

s_burst(v: f32): f32 {
    9.5 * maxf(1.0 - v / S_TOP, 0.0)
}

// His centre of mass's usual height, running at speed v.
height_at(v: f32): f32 {
    1.03 - 0.004 * minf(v, 10.0)
}

// The push's shape over a contact, u from 0 to 1: a half sine leaning to the
// start (skew > 0: braking, the leg yielding after the strike) or the end
// (skew < 0: driving).
push_shape(u: f32, skew: f32): f32 {
    sinf(PI * u) * (1.0 + skew * (1.0 - 2.0 * u))
}

// ---- steps ----
const K_RUN: int = 0;

const K_START: int = 1;

const K_BRAKE: int = 2;

const K_PEN: int = 3;

const K_PPEN: int = 4;

const K_PLANT: int = 5;

const K_CROSS: int = 6;

const K_PIVOT: int = 7;

const K_PUSH: int = 8;

const K_STOP: int = 9;

const K_STAND: int = 10;

// The last few steps, by number (step n is at n % NST): the one he is on
// (s_cur) and the one after it, already decided.
const NST: int = 8;

st_kind: []int = new int[NST](0);

st_side: []int = new int[NST](0);

st_t: []f32 = new f32[NST](0.0);

st_tc: []f32 = new f32[NST](0.0);

st_tf: []f32 = new f32[NST](0.0);

// The push: its peak up (per unit mass) and its lean.
st_a: []f32 = new f32[NST](0.0);

st_skew: []f32 = new f32[NST](0.0);

// His velocity and centre of mass as it lands, and his velocity as he leaves
// it (as foreseen when it was decided).
st_vin: []f32 = new f32[NST * 3](0.0);

st_vout: []f32 = new f32[NST * 3](0.0);

st_ptd: []f32 = new f32[NST * 3](0.0);

// Where its push comes from on the ground (the middle of the foot's
// pressure), and where its foot lands (heel or ball) and its heading.
st_foot: []f32 = new f32[NST * 3](0.0);

st_spot: []f32 = new f32[NST * 3](0.0);

st_yaw: []f32 = new f32[NST](0.0);

st_heel: []bool = new bool[NST](false);

st_ball: []bool = new bool[NST](false);

st_turn: []f32 = new f32[NST](0.0);

st_goal: []f32 = new f32[NST](0.0);

st_drop: []f32 = new f32[NST](0.0);

// Where its ankle is as it lands, less where the cycle's path would have it.
st_err: []f32 = new f32[NST * 3](0.0);

s_cur: int = 0;

s_now: f32 = 0.0;

// The stick: the way (flat, unit; zero for none) and the speed it asks for.
s_want: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

s_want_v: f32 = 0.0;

// What it asked when the step after was decided.
k_want: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

k_want_v: f32 = 0.0;

flat_v(v: V3): V3 {
    v3(v.x, 0.0, v.z)
}

heading_or(v: V3, or_h: f32): f32 {
    if (v.x * v.x + v.z * v.z < 0.0025) return or_h;
    atan2f(v.x, v.z)
}

// The signed angle from heading a to heading b, + to his left.
turn_from(a: f32, b: f32): f32 {
    wrap_angle(b - a)
}

step_end(i: int): f32 {
    st_t[i] + st_tc[i] + st_tf[i]
}

// ---- the physics ----
// His centre of mass: over the ground, its height, and how fast each.
s_p: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

s_v: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

s_y: f32 = 1.0;

s_vy: f32 = 0.0;

// A body to run steps on, for looking ahead: its place, velocity, height,
// fall, and how far over his limits it went.
type Body = {
    p: V3;
    v: V3;
    y: f32;
    vy: f32;
    over: f32;
    work: f32
}

sim: *Body = new Body {
    p: v3(0.0, 0.0, 0.0),
    v: v3(0.0, 0.0, 0.0),
    y: 1.0,
    vy: 0.0,
    over: 0.0,
    work: 0.0
};

// One tick of h on a foot at `foot` pushing up a (per unit mass) for the
// moment, or in the air (on: false). The ground pushes along the leg, from the
// foot to him: so it never topples him.
push_tick(
    b: *Body,
    foot: V3,
    a: f32,
    on: bool,
    h: f32
) {
    if (on) {
        d: V3 = v3(b.p.x - foot.x, 0.0, b.p.z - foot.z);
        ht: f32 = maxf(b.y, 0.3);
        ah: V3 = v_scale(d, a / ht);
        // (His limits: the leg's reach, and the ground's grip.)
        dist: f32 = sqrtf(d.x * d.x + d.z * d.z + ht * ht);
        b.over = b.over + maxf(dist - REACH, 0.0) * 4.0 * h;
        b.over = b.over + maxf(v_len(d) / ht - MU, 0.0) * a / GRAV * h;
        b.work = b.work + v_dot(ah, ah) * h + 0.02 * a * a / GRAV * h;
        b.v = v_madd(b.v, ah, h);
        b.vy = b.vy + (a - GRAV) * h
    } else b.vy = b.vy - GRAV * h;
    b.p = v_madd(b.p, b.v, h);
    b.y = b.y + b.vy * h
}

// A whole step on b: the foot down at `foot` for tc, its push peaking at a
// and leaning by skew, then tf in the air.
step_on(
    b: *Body,
    foot: V3,
    tc: f32,
    tf: f32,
    a: f32,
    skew: f32
) {
    n: int = maxi((tc * 120.0 + 0.5) as int, 1);
    h: f32 = tc / n as f32;
    s0: f32 = v_len(b.v);
    for i in 0..n push_tick(b, foot, a * push_shape((i as f32 + 0.5) / n as f32, skew),
        true, h);
    if (a > F_MAX) b.over = b.over + (a - F_MAX) / GRAV;
    // (He adds no more speed in a step than his legs can.)
    b.over = b.over + maxf(v_len(b.v) - s0 - s_burst(s0) * (tc + tf) - 0.05, 0.0);
    // (In the air, he falls.)
    b.p = v_madd(b.p, b.v, tf);
    b.y = b.y + b.vy * tf - GRAV * tf * tf * 0.5;
    b.vy = b.vy - GRAV * tf
}

// The push up (its peak) that carries him through a step and lands him as
// high as he began, falling as he began.
level_push(tc: f32, tf: f32, tf0: f32): f32 {
    GRAV * PI * (tc + 0.5 * (tf + tf0)) / (2.0 * tc)
}

// ---- choosing a step ----
// The solved time to where the stick says (the gait's `steering` values),
// interpolated, from speed s, th off its way, height y and fall vy, the next
// foot the outside (0) or inside (1) of what turn is left.
table_at(a: []f32, n: int, x: f32): f32 {
    if (n < 2 || x <= a[0]) return 0.0;
    if (x >= a[n - 1]) return (n - 1) as f32 - 0.0001;
    k: int = 0;
    while (k < n - 2 && a[k + 1] < x) k = k + 1;
    k as f32 + (x - a[k]) / maxf(a[k + 1] - a[k], 0.0001)
}

value_at(
    tgt: int,
    par: int,
    s: f32,
    th: f32,
    y: f32,
    vy: f32
): f32 {
    si: f32 = table_at(steer_speeds, steer_nspeed, s);
    yi: f32 = table_at(steer_heights, steer_nheight, y);
    wi: f32 = table_at(steer_falls, steer_nfall, vy);
    ti: f32 = clampf(th * 180.0 / PI / steer_dangle, 0.0, (steer_nangle - 1) as f32 - 0.0001);
    tot: f32 = 0.0;
    for c in 0..16 {
        i0: int = si as int + (c & 1);
        i1: int = yi as int + (c >> 1 & 1);
        i2: int = wi as int + (c >> 2 & 1);
        i3: int = ti as int + (c >> 3 & 1);
        w: f32 = 1.0;
        if ((c & 1) == 1) w = w * (si - floorf(si)) else w = w * (1.0 - (si - floorf(si)));
        if ((c >> 1 & 1) == 1) w = w * (yi - floorf(yi)) else w = w * (1.0 - (yi - floorf(yi)));
        if ((c >> 2 & 1) == 1) w = w * (wi - floorf(wi)) else w = w * (1.0 - (wi - floorf(wi)));
        if ((c >> 3 & 1) == 1) w = w * (ti - floorf(ti)) else w = w * (1.0 - (ti - floorf(ti)));
        i0 = mini(i0, steer_nspeed - 1);
        i1 = mini(i1, steer_nheight - 1);
        i2 = mini(i2, steer_nfall - 1);
        i3 = mini(i3, steer_nangle - 1);
        row: int = (((tgt * 2 + par) * steer_nspeed + i0) * steer_nheight + i1) * steer_nfall + i2;
        tot = tot + w * minf(steer_val[row * steer_nangle + i3], 60.0)
    }
    tot
}

// Which of the solved stick speeds is nearest v.
target_of(v: f32): int {
    best: int = 0;
    for i in 0..steer_ntarget {
        if (absf(steer_targets[i] - v) < absf(steer_targets[best] - v)) best = i
    }
    best
}

// A small random number source, the same every run.
s_seed: int = 12345;

rand01(): f32 {
    s_seed = s_seed * 1103515245 + 12345 & 2147483647;
    (s_seed >> 8) as f32 / 8388608.0
}

randn(): f32 {
    a: f32 = maxf(rand01(), 0.000001);
    b: f32 = rand01();
    sqrtf(-2.0 * log64(a as f64) as f32) * cosf(TAU * b)
}

// A step's numbers: the foot ahead and out (to his left) from his centre of
// mass as it lands, in the frame of his heading; contact; flight; push (as a
// share of a level step's); its lean.
const NP: int = 6;

p_lo: []f32 = [-0.6, -0.45, 0.07, 0.0, 0.3, -0.9];

p_hi: []f32 = [0.9, 0.45, 0.5, 0.25, 2.4, 0.9];

const POP: int = 72;

cand: []f32 = new f32[POP * NP](0.0);

cost: []f32 = new f32[POP](0.0);

mu: []f32 = new f32[NP](0.0);

sig: []f32 = new f32[NP](0.0);

best_x: []f32 = new f32[NP](0.0);

// What a candidate step from body b costs: its time and drift off the
// stick's line, and the solved time on from where it leaves him; over his
// limits, landing too high or low, a great deal.
step_cost(
    b: *Body,
    x: []f32,
    at: int,
    h: f32,
    side: int,
    tf0: f32,
    want_h: f32,
    tgt: int
): f32 {
    fwd: f32 = x[at];
    aside: f32 = x[at + 1];
    tc: f32 = x[at + 2];
    tf: f32 = x[at + 3];
    c: f32 = 0.0;
    if (tc + tf < 0.2 || tf0 + tc + tf < 0.3) c = c + 100.0;
    ss: f32 = 1.0;
    if (side == 1) ss = -1.0;
    if (aside * ss < -0.12) c = c + 100.0;
    foot: V3 = v_add(b.p, v_add(v_scale(ahead(h), fwd), v_scale(leftward(h), aside)));
    sim.p = b.p;
    sim.v = b.v;
    sim.y = b.y;
    sim.vy = b.vy;
    sim.over = 0.0;
    sim.work = 0.0;
    sp0: f32 = v_len(b.v);
    step_on(sim, foot, tc, tf, x[at + 4] * level_push(tc, tf, tf0), x[at + 5]);
    if (sim.y < 0.74 || sim.y > 1.08 || sim.vy > 0.2 || sim.vy < -1.2) c = c + 50.0;
    sp: f32 = v_len(sim.v);
    h2: f32 = heading_or(sim.v, want_h);
    left: f32 = turn_from(h2, want_h);
    th0: f32 = absf(turn_from(h, want_h));
    th: f32 = absf(left);
    if (steer_targets[tgt] < 0.5) {
        th0 = 0.0;
        th = 0.0
    }
    // (The next foot: the outside of what turn is left, or the inside.)
    par: int = 1;
    outside: int = 0;
    if (left > 0.0) outside = 1;
    if (1 - side == outside) par = 0;
    dur: f32 = tc + tf;
    drift: f32 = 0.5 * (sp0 * sinf(minf(th0, PI * 0.5)) + sp * sinf(minf(th, PI * 0.5))) * dur;
    back: f32 = 0.5 * (maxf(-sp0 * cosf(th0), 0.0) + maxf(-sp * cosf(th), 0.0)) * dur;
    away: f32 = 0.0;
    if (sp > 0.5) away = maxf(th - th0, 0.0);
    // (Running low is hard work: a crouch costs, as legs bent bear him.)
    low: f32 = maxf(height_at(sp) - sim.y, 0.0);
    c + dur + 0.0005 * sim.work + steer_drift * (drift + back) + 0.6 * away + value_at(tgt,
        par, sp, th, sim.y, sim.vy) + LOW_COST * low * low * dur * 10.0 + 1000.0 * sim.over
}

// Choose the step from body b (landing now), heading h, the foot on side, the
// flight before tf0: by a few rounds of trying candidates about the best so
// far. Into best_x.
choose_step(
    b: *Body,
    h: f32,
    side: int,
    tf0: f32,
    want_h: f32,
    tgt: int
) {
    sp: f32 = v_len(b.v);
    tcr: f32 = step_contact(maxf(sp, 1.5));
    st: f32 = step_time(maxf(sp, 1.5));
    ss: f32 = 1.0;
    if (side == 1) ss = -1.0;
    mu[0] = sp * tcr * 0.5;
    mu[1] = 0.06 * ss;
    mu[2] = tcr;
    mu[3] = st - tcr;
    mu[4] = 1.0;
    mu[5] = 0.0;
    for k in 0..NP sig[k] = (p_hi[k] - p_lo[k]) / 6.0;
    bc: f32 = FAR;
    for _round in 0..7 {
        for c in 0..POP {
            for k in 0..NP {
                x: f32 = mu[k];
                if (c > 0) x = x + randn() * sig[k];
                cand[c * NP + k] = clampf(x, p_lo[k], p_hi[k])
            }
            cost[c] = step_cost(b, cand, c * NP, h, side, tf0, want_h, tgt);
            if (cost[c] < bc) {
                bc = cost[c];
                for k in 0..NP best_x[k] = cand[c * NP + k]
            }
        }
        // (The best eighth: about them, next round.)
        for k in 0..NP {
            m: f32 = 0.0;
            n: int = 0;
            lim: f32 = kth_cost(POP / 8);
            for c in 0..POP {
                if (cost[c] <= lim) {
                    m = m + cand[c * NP + k];
                    n = n + 1
                }
            }
            m = m / maxf(n as f32, 1.0);
            v: f32 = 0.0;
            for c in 0..POP {
                if (cost[c] <= lim) v = v + (cand[c * NP + k] - m) * (cand[c * NP + k] - m)
            }
            mu[k] = m;
            sig[k] = sqrtf(v / maxf(n as f32, 1.0)) + 0.001
        }
    }
}

// The k-th least cost of this round.
kth_cost(k: int): f32 {
    lo: f32 = FAR;
    for c in 0..POP lo = minf(lo, cost[c]);
    lim: f32 = lo;
    for _r in 0..k {
        nxt: f32 = FAR;
        for c in 0..POP {
            if (cost[c] > lim && cost[c] < nxt) nxt = cost[c]
        }
        if (nxt < FAR) lim = nxt
    }
    lim
}

// Decide step n, landing at time t on side, his body then as b, the flight
// before tf0, after a step of kind `last`.
decide(
    n: int,
    t: f32,
    b: *Body,
    side: int,
    last: int,
    tf0: f32
) {
    i: int = n % NST;
    speed: f32 = v_len(b.v);
    want_h: f32 = heading_or(s_want, heading_or(b.v, s_face));
    stop: bool = v_len(s_want) < 0.5 || s_want_v < 0.2;
    tgt: int = target_of(s_want_v);
    if (stop) tgt = target_of(0.0);
    h: f32 = heading_or(b.v, s_face);
    kind: int = K_RUN;
    st_side[i] = side;
    st_t[i] = t;
    putv(st_vin, i, b.v);
    putv(st_ptd, i, b.p);
    st_turn[i] = 0.0;
    st_goal[i] = want_h;
    st_drop[i] = 0.0;
    if (stop && speed < 0.3) {
        // Standing: the foot down where it is, no push but his weight.
        st_kind[i] = K_STAND;
        st_tc[i] = 0.15;
        st_tf[i] = 0.0;
        st_a[i] = GRAV;
        st_skew[i] = 0.0;
        ss: f32 = 1.0;
        if (side == 1) ss = -1.0;
        putv(st_foot, i, v_madd(b.p, leftward(s_face), ss * 0.12));
        putv(st_vout, i, v3(0.0, 0.0, 0.0));
        place_contact(i, false);
        st_yaw[i] = s_face;
        return
    }
    // (From standing, he steps off the way the stick says.)
    if (speed < 0.3) h = want_h;
    choose_step(b, h, side, tf0, want_h, tgt);
    ahead_by: f32 = best_x[0];
    aside: f32 = best_x[1];
    st_tc[i] = best_x[2];
    st_tf[i] = best_x[3];
    st_a[i] = best_x[4] * level_push(best_x[2], best_x[3], tf0);
    st_skew[i] = best_x[5];
    foot: V3 = v_add(b.p, v_add(v_scale(ahead(h), ahead_by), v_scale(leftward(h),
        aside)));
    putv(st_foot, i, foot);
    // What it will do to him.
    sim.p = b.p;
    sim.v = b.v;
    sim.y = b.y;
    sim.vy = b.vy;
    sim.over = 0.0;
    step_on(sim, foot, st_tc[i], st_tf[i], st_a[i], st_skew[i]);
    putv(st_vout, i, sim.v);
    // What kind of step it is, for his poses.
    dv: V3 = v_sub(sim.v, b.v);
    along: f32 = v_dot(dv, ahead(h));
    tn: f32 = turn_from(h, heading_or(sim.v, h));
    deg: f32 = absf(tn) * 180.0 / PI;
    if (speed < 0.3) kind = K_START else if (deg > 100.0 || speed < 2.2 && deg > 50.0) kind = K_PIVOT else if (deg > 25.0) kind = K_PLANT else if (along < -0.6) kind = K_BRAKE else if (along > 0.6 && (last == K_PLANT || last == K_PIVOT)) kind = K_PUSH;
    if (stop && kind == K_BRAKE) kind = K_STOP;
    st_kind[i] = kind;
    if (kind == K_PLANT || kind == K_PIVOT) st_turn[i] = turn_from(h, want_h);
    if (kind == K_BRAKE || kind == K_STOP || kind == K_PLANT || kind == K_PIVOT) st_drop[i] = 0.06;
    place_contact(i, kind == K_START || along > 0.6);
    // Its heading: the way he goes, through a plant the way between.
    ss: f32 = 1.0;
    if (side == 1) ss = -1.0;
    st_yaw[i] = h + 0.5 * tn + ss * 0.07;
    if (kind == K_PIVOT) st_yaw[i] = h + 0.4 * tn
}

// Where step i's foot touches as it lands (its heel, behind the middle of
// its push, or its ball, a little ahead), from where the cycle at his speed
// lands it, heel or ball; braking, the heel.
place_contact(i: int, driving: bool) {
    v: V3 = getv(st_vin, i);
    speed: f32 = v_len(v);
    sd: int = st_side[i];
    sample_cycles(maxf(speed, 1.5), 0.5 * (1 - sd) as f32);
    ft: V3 = cdir(14 + sd);
    up: V3 = foot_up(ft);
    heel: V3 = v_add(v_scale(ft, SOLE_HEEL_A), v_scale(up, SOLE_HEEL_U));
    ball: V3 = v_add(v_scale(ft, SOLE_BALL_A), v_scale(up, SOLE_BALL_U));
    st_heel[i] = heel.y < ball.y;
    st_ball[i] = driving;
    if (driving) st_heel[i] = false;
    k: int = st_kind[i];
    if (k == K_BRAKE || k == K_STOP || k == K_STAND) {
        st_heel[i] = true;
        st_ball[i] = false
    }
    h: f32 = heading_or(v, s_face);
    f: V3 = getv(st_foot, i);
    if (st_heel[i]) f = v_madd(f, ahead(h), -0.08) else f = v_madd(f, ahead(h), 0.02);
    putv(st_spot, i, f)
}

const HIP_OUT: f32 = 0.098;

const HIP_DROP: f32 = 0.05;

// The sole's ends from the ankle, in the foot's frame (along it, up it).
const SOLE_BALL_A: f32 = 0.127;

const SOLE_BALL_U: f32 = -0.063;

const SOLE_HEEL_A: f32 = -0.05;

const SOLE_HEEL_U: f32 = -0.08;

foot_up(ft: V3): V3 {
    up: V3 = v_norm(v_cross(ft, v3(1.0, 0.0, 0.0)));
    if (up.y >= 0.0 || absf(ft.y) > 0.9) return up;
    v_scale(up, -1.0)
}

// His body as step j's foot lands: the physics run on from now, through the
// rest of the step he is on.
ahead_b: *Body = new Body {
    p: v3(0.0, 0.0, 0.0),
    v: v3(0.0, 0.0, 0.0),
    y: 1.0,
    vy: 0.0,
    over: 0.0,
    work: 0.0
};

foresee() {
    i: int = s_cur % NST;
    ahead_b.p = s_p;
    ahead_b.v = s_v;
    ahead_b.y = s_y;
    ahead_b.vy = s_vy;
    foot: V3 = getv(st_foot, i);
    t: f32 = s_now;
    h: f32 = 1.0 / 120.0;
    while (t < st_t[i] + st_tc[i] - 0.0001) {
        u: f32 = (t + h * 0.5 - st_t[i]) / maxf(st_tc[i], 0.001);
        push_tick(ahead_b, foot, st_a[i] * push_shape(clampf(u, 0.0, 1.0), st_skew[i]),
            st_kind[i] != K_STAND, minf(h, st_t[i] + st_tc[i] - t));
        t = t + h
    }
    rest: f32 = maxf(step_end(i) - maxf(t, st_t[i] + st_tc[i]), 0.0);
    ahead_b.p = v_madd(ahead_b.p, ahead_b.v, rest);
    ahead_b.y = ahead_b.y + ahead_b.vy * rest - GRAV * rest * rest * 0.5;
    ahead_b.vy = ahead_b.vy - GRAV * rest
}

// Decide step n (the one after the one he is on), as it will land.
decide_next(n: int) {
    j: int = (n - 1) % NST;
    k_want = s_want;
    k_want_v = s_want_v;
    foresee();
    decide(n, step_end(j), ahead_b, 1 - st_side[j], st_kind[j], st_tf[j]);
    landing_err(n);
    st_h0_set[n % NST] = false
}

// The stick moved enough since the step after was decided, and there is
// time before it lands: decide it again.
redecide() {
    n: int = s_cur + 1;
    j: int = n % NST;
    if (st_t[j] - s_now < 0.08) return;
    moved: bool = absf(s_want_v - k_want_v) > 1.0;
    if (v_len(s_want) < 0.5 != v_len(k_want) < 0.5) moved = true;
    if (v_len(s_want) > 0.5 && v_len(k_want) > 0.5 && v_dot(s_want, k_want) < 0.94) moved = true;
    if (moved) decide_next(n)
}

// ---- going ----
// His facing (eased), the way he goes (unwound: a reversal counted round
// the way he turns), and the way a plant left him facing, kept a while.
s_face: f32 = 0.0;

s_hv: f32 = 0.0;

s_spin: f32 = 1.0;

s_aim: f32 = 0.0;

s_aim_until: f32 = -1.0;

// For each step's plant, the way he was going as its turn began.
st_h0: []f32 = new f32[NST](0.0);

st_h0_set: []bool = new bool[NST](false);

// His push (eased), his velocity a tick ago, his hips' height, his speed and
// where in the stride he is.
s_acc: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

s_vel: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

// (The hips' height the pose starts from, before his centre of mass is put
// where the physics has it.)
s_hy: f32 = 0.95;

s_speed: f32 = 0.0;

s_phase: f32 = 0.0;

// Each foot's ankle, less the cycle's path, as it left the ground.
lift_err: []f32 = new f32[6](0.0);

s_ready: bool = false;

// Where he looks: the way he means to go, eased.
s_look: f32 = 0.0;

// Begin standing at p, facing face.
steer_begin(g: int, p: V3, face: f32) {
    steer_cycles(g);
    measure_legs(g);
    read_keys(g);
    s_ready_w = 1.0;
    s_ready = ncyc >= 2 && steer_nval > 0;
    if (!s_ready) return;
    s_now = 0.0;
    s_face = face;
    s_hv = face;
    s_look = face;
    s_level_t = -1.0;
    s_aim_until = -1.0;
    s_acc = v3(0.0, 0.0, 0.0);
    s_vel = v3(0.0, 0.0, 0.0);
    s_want = v3(0.0, 0.0, 0.0);
    s_want_v = 0.0;
    s_p = v3(p.x, 0.0, p.z);
    s_v = v3(0.0, 0.0, 0.0);
    s_y = height_at(0.0);
    s_vy = 0.0;
    s_seed = 12345;
    for i in 0..NST st_h0_set[i] = false;
    for i in 0..6 lift_err[i] = 0.0;
    // (Standing: a step of each foot, the right's just before.)
    for k in 0..2 {
        st_kind[k] = K_STAND;
        st_side[k] = 1 - k;
        st_t[k] = -0.15 + 0.15 * k as f32;
        st_tc[k] = 0.15;
        st_tf[k] = 0.0;
        st_a[k] = GRAV;
        st_skew[k] = 0.0;
        putv(st_vin, k, v3(0.0, 0.0, 0.0));
        putv(st_vout, k, v3(0.0, 0.0, 0.0));
        putv(st_ptd, k, s_p);
        ss: f32 = 1.0;
        if (k == 0) ss = -1.0;
        putv(st_foot, k, v_madd(s_p, leftward(face), ss * 0.12));
        place_contact(k, false);
        st_turn[k] = 0.0;
        st_yaw[k] = face
    }
    s_cur = 1;
    decide_next(2);
    sample_cycles(1.5, 0.25)
}

// One tick on by h, the stick asking for the way want at want_v.
steer_tick(want: V3, want_v: f32, h: f32) {
    if (!s_ready) return;
    s_want = want;
    s_want_v = want_v;
    // His body, by the physics, on the foot down (or in the air).
    i0: int = s_cur % NST;
    u: f32 = (s_now + h * 0.5 - st_t[i0]) / maxf(st_tc[i0], 0.001);
    ahead_b.p = s_p;
    ahead_b.v = s_v;
    ahead_b.y = s_y;
    ahead_b.vy = s_vy;
    if (st_kind[i0] == K_STAND) {
        ahead_b.v = v3(0.0, 0.0, 0.0);
        ahead_b.vy = 0.0
    } else push_tick(ahead_b, getv(st_foot, i0), st_a[i0] * push_shape(clampf(u, 0.0,
        1.0), st_skew[i0]), u < 1.0, h);
    s_p = ahead_b.p;
    s_v = ahead_b.v;
    s_y = ahead_b.y;
    s_vy = ahead_b.vy;
    s_now = s_now + h;
    // A foot lands: the step after is decided.
    while (s_now >= step_end(s_cur % NST)) {
        s_cur = s_cur + 1;
        decide_next(s_cur + 1)
    }
    redecide();
    i: int = s_cur % NST;
    p: V3 = s_p;
    v: V3 = s_v;
    s_acc = v_lerp(s_acc, v_scale(v_sub(v, s_vel), 1.0 / h), 1.0 - expf(-h / 0.054));
    s_vel = v;
    s_speed = v_len(v);
    // Facing: the way he goes, unwound.
    for k in 0..2 {
        j: int = (s_cur + k) % NST;
        if (st_turn[j] != 0.0 && s_now >= st_t[j] - 0.12) s_spin = signf(st_turn[j])
    }
    if (s_speed > 0.3) {
        d: f32 = turn_from(s_hv, heading_or(v, s_hv));
        if (absf(d) > 2.5 && d * s_spin < 0.0) d = s_spin * (TAU - absf(d));
        s_hv = s_hv + d
    }
    // Through a plant or pivot he faces round as planned: from the flight
    // before, most of it by mid-contact, all by its end.
    held: bool = false;
    for k in 0..2 {
        j: int = (s_cur + k) % NST;
        if (st_turn[j] != 0.0) {
            a: f32 = st_t[j] - 0.12;
            m: f32 = st_t[j] + st_tc[j] * 0.5;
            b: f32 = st_t[j] + st_tc[j];
            if (s_now >= a && s_now <= b) {
                if (!st_h0_set[j]) {
                    st_h0[j] = s_face;
                    st_h0_set[j] = true
                }
                g: f32 = 0.85 + 0.15 * smoothstepf(0.0, 1.0, (s_now - m) / maxf(b - m,
                    0.001));
                if (s_now < m) g = 0.85 * smoothstepf(0.0, 1.0, (s_now - a) / maxf(m - a,
                    0.001));
                s_face = st_h0[j] + st_turn[j] * g;
                held = true;
                s_aim = s_face;
                s_aim_until = s_now + 1.0
            }
        }
    }
    if (held) {
        // (The way he goes counted from where he faces.)
        while (s_hv - s_face > PI) s_hv = s_hv - TAU;
        while (s_face - s_hv > PI) s_hv = s_hv + TAU
    } else {
        to: f32 = s_hv;
        if (s_now < s_aim_until && absf(s_aim - s_hv) > 0.15) to = s_aim;
        s_face = s_face + (to - s_face) * minf(1.0, 12.0 * h)
    }
    // Where in the stride: the right foot lands at 0, the left at a half.
    duty: f32 = duty_at(maxf(s_speed, 1.5));
    base: f32 = 0.0;
    if (st_side[i] == 0) base = 0.5;
    u: f32 = s_now - st_t[i];
    if (st_kind[i] == K_STAND) s_phase = base + duty * 0.5 else if (u < st_tc[i]) s_phase = base + duty * u / maxf(st_tc[i],
        0.001) else s_phase = base + duty + (0.5 - duty) * (u - st_tc[i]) / maxf(st_tf[i],
        0.001);
    s_phase = frac(s_phase);
    // Standing, he settles into his ready stance.
    stand: f32 = 0.0;
    if (st_kind[i] == K_STAND && s_speed < 0.3) stand = 1.0;
    s_ready_w = s_ready_w + (stand - s_ready_w) * minf(1.0, h / 0.25);
    // He looks where he means to go: the cut's or turn's way out, else the
    // stick's (when he is moving), else where he faces.
    to_look: f32 = s_face;
    if (s_speed > 1.0 && v_len(s_want) > 0.5) to_look = heading_or(s_want, s_face);
    s_look = s_look + clampf(turn_from(s_look, to_look), -PI, PI) * minf(1.0, h / 0.12);
    go_p = p;
    go_v = v;
    go_a = s_acc;
    go_face = s_face
}

// Where step j's ankle will be as it lands, less where the cycle's path
// would have it then.
landing_err(n: int) {
    j: int = n % NST;
    v: V3 = getv(st_vin, j);
    sp: f32 = maxf(v_len(v), 1.5);
    yaw: f32 = heading_or(v, s_face) + st_turn[j] * 0.3;
    sd: int = st_side[j];
    sample_cycles(sp, 0.5 * (1 - sd) as f32);
    side: f32 = 1.0 - 2.0 * sd as f32;
    root: V3 = v_add(getv(st_ptd, j), v3(0.0, cs_y, 0.0));
    hip: V3 = v_add(root, v_sub(v_scale(cdir_at(0, yaw), HIP_OUT * side), v_scale(cdir_at(1,
        yaw), HIP_DROP)));
    cyc: V3 = v_add(hip, v_add(v_scale(cdir_at(10 + 2 * sd, yaw), leg_upper), v_scale(cdir_at(11 + 2 * sd,
        yaw), leg_lower)));
    want: V3 = planted(j, st_t[j], cdir(14 + sd));
    putv(st_err, j, v_sub(want, cyc))
}

// His centre of mass, near enough: each segment's middle by its share of
// his weight (de Leva 1996).
body_com(g: int): V3 {
    root: int = gait_root[g];
    head: int = gait_head[g];
    sum: V3 = v_scale(v_lerp(wp(root), wp(head), 0.45), 0.435);
    sum = v_madd(sum, wp(head), 0.069);
    hand: int = hand_of(g);
    for side in 0..2 {
        h: int = hand;
        f: int = gait_foot[g];
        if (side == 1) {
            h = bone_twin[hand];
            f = bone_twin[f]
        }
        el: int = bone_parent[h];
        sh: int = bone_parent[el];
        sum = v_madd(sum, v_lerp(wp(sh), wp(el), 0.5), 0.027);
        sum = v_madd(sum, v_lerp(wp(el), wp(h), 0.5), 0.022);
        kn: int = bone_parent[f];
        hp: int = bone_parent[kn];
        sum = v_madd(sum, v_lerp(wp(hp), wp(kn), 0.45), 0.142);
        sum = v_madd(sum, v_lerp(wp(kn), wp(f), 0.45), 0.043);
        sum = v_madd(sum, wp(f), 0.014)
    }
    sum
}

s_level_t: f32 = -1.0;

// ---- the pose ----
// The step whose foot sd is down now, or -1.
down_step(sd: int): int {
    i: int = s_cur % NST;
    if (st_side[i] == sd && s_now - st_t[i] < maxf(st_tc[i], 0.001)) return i;
    // (Standing, each foot stays where it was last put.)
    if (st_kind[i] == K_STAND) {
        for k in 0..NST - 1 {
            j: int = (s_cur - k + NST * 4) % NST;
            if (st_side[j] == sd) return j
        }
    }
    -1
}

// Its last step that has left the ground, and when.
last_step(sd: int): int {
    for k in 0..NST - 1 {
        j: int = (s_cur - k + NST * 4) % NST;
        if (st_side[j] == sd && st_t[j] + st_tc[j] <= s_now) return j
    }
    -1
}

// The foot of step j, down at time t: heel or ball (whichever the cycle's
// pitch, given as its foot direction ft_c, has lower) held on its spot.
// Its direction is left in planted_ft.
planted_ft: V3 = V3 { x: 0.0, y: 0.0, z: 1.0 };

planted(j: int, t: f32, ft_c: V3): V3 {
    fy: f32 = st_yaw[j];
    if (st_kind[j] == K_PIVOT) fy = fy + st_turn[j] * 0.5 * smoothstepf(0.0, 1.0,
        (t - st_t[j]) / maxf(st_tc[j], 0.001));
    pitch: f32 = atan2f(ft_c.y, sqrtf(ft_c.x * ft_c.x + ft_c.z * ft_c.z));
    ft: V3 = v3(sinf(fy) * cosf(pitch), sinf(pitch), cosf(fy) * cosf(pitch));
    if (st_ball[j] && ft.y > -0.2) ft = v_norm(v3(sinf(fy) * 0.98, -0.2, cosf(fy) * 0.98));
    if (st_kind[j] == K_STAND) ft = v3(sinf(fy), 0.0, cosf(fy));
    planted_ft = ft;
    up: V3 = foot_up(ft);
    ball: V3 = v_add(v_scale(ft, SOLE_BALL_A), v_scale(up, SOLE_BALL_U));
    heel: V3 = v_add(v_scale(ft, SOLE_HEEL_A), v_scale(up, SOLE_HEEL_U));
    way: V3 = ahead(st_yaw[j]);
    s: V3 = getv(st_spot, j);
    spot: V3 = v3(s.x, 0.006, s.z);
    heel_spot: V3 = spot;
    ball_spot: V3 = v_madd(spot, way, FOOT_LEN);
    if (!st_heel[j]) {
        ball_spot = spot;
        heel_spot = v_madd(spot, way, -FOOT_LEN)
    }
    if (heel.y < ball.y) return v_sub(heel_spot, heel);
    lift: f32 = 0.1 * maxf(-ft.y - 0.5, 0.0);
    v_sub(v_add(ball_spot, v3(0.0, lift, 0.0)), ball)
}

const FOOT_LEN: f32 = 0.177;

// planted(), but onto the toes as far as it must be (to 75 degrees) for the
// leg to reach it from hip with the knee still bent 15 degrees.
reached(
    j: int,
    t: f32,
    ft_c: V3,
    hip: V3
): V3 {
    ankle: V3 = planted(j, t, ft_c);
    ft: V3 = planted_ft;
    reach: f32 = sqrtf(leg_upper * leg_upper + leg_lower * leg_lower + 2.0 * leg_upper * leg_lower * cosf(15.0 * PI / 180.0));
    if (v_len(v_sub(ankle, hip)) <= reach) return ankle;
    up: V3 = foot_up(ft);
    ball: V3 = v_add(v_scale(ft, SOLE_BALL_A), v_scale(up, SOLE_BALL_U));
    heel: V3 = v_add(v_scale(ft, SOLE_HEEL_A), v_scale(up, SOLE_HEEL_U));
    if (ball.y > heel.y + 0.000001) return ankle;
    ball_at: V3 = v_add(ankle, ball);
    way: V3 = v_norm(v3(ft.x, 0.0, ft.z));
    p0: f32 = atan2f(ft.y, sqrtf(ft.x * ft.x + ft.z * ft.z));
    best: V3 = ankle;
    k: int = 1;
    done: bool = false;
    while (k <= 20 && !done) {
        pitch: f32 = p0 + (-1.309 - p0) * k as f32 / 20.0;
        if (pitch > p0) done = true else {
            f2: V3 = v_add(v_scale(way, cosf(pitch)), v3(0.0, sinf(pitch), 0.0));
            u2: V3 = foot_up(f2);
            lift: f32 = 0.1 * maxf(-f2.y - 0.5, 0.0) - 0.1 * maxf(-ft.y - 0.5, 0.0);
            best = v_sub(v_add(ball_at, v3(0.0, lift, 0.0)), v_add(v_scale(f2, SOLE_BALL_A),
                v_scale(u2, SOLE_BALL_U)));
            planted_ft = f2;
            if (v_len(v_sub(best, hip)) <= reach) done = true
        }
        k = k + 1
    }
    best
}

// Thigh and shank directions putting the ankle at `ankle` from `hip`, the
// knee toward `pole`: into leg_th and leg_sh.
leg_th: V3 = V3 { x: 0.0, y: -1.0, z: 0.0 };

leg_sh: V3 = V3 { x: 0.0, y: -1.0, z: 0.0 };

leg_ik(hip: V3, ankle: V3, pole: V3) {
    l1: f32 = leg_upper;
    l2: f32 = leg_lower;
    d: V3 = v_sub(ankle, hip);
    dist: f32 = clampf(v_len(d), absf(l1 - l2) + 0.0001, l1 + l2 - 0.0001);
    dn: V3 = v_norm(d);
    k: V3 = v_madd(pole, dn, -v_dot(pole, dn));
    if (v_len(k) < 0.000001) k = v_madd(v3(0.0, 0.0, 1.0), dn, -dn.z);
    k = v_norm(k);
    ca: f32 = (l1 * l1 + dist * dist - l2 * l2) / (2.0 * l1 * dist);
    sa: f32 = sqrtf(maxf(1.0 - ca * ca, 0.0));
    knee: V3 = v_add(hip, v_scale(v_add(v_scale(dn, ca), v_scale(k, sa)), l1));
    leg_th = v_norm(v_sub(knee, hip));
    leg_sh = v_norm(v_sub(v_madd(hip, dn, dist), knee))
}

// The cycle's knee: the way it points from its leg's hip-ankle line.
knee_dir(sd: int): V3 {
    th: V3 = cdir(10 + 2 * sd);
    sh: V3 = cdir(11 + 2 * sd);
    an: V3 = v_norm(v_add(v_scale(th, leg_upper), v_scale(sh, leg_lower)));
    k: V3 = v_madd(th, an, -v_dot(th, an));
    if (v_len(k) < 0.000001) return v3(0.0, 0.0, 1.0);
    v_norm(k)
}

// Each ankle's place and its knee's way, posed this tick.
s_ankle: []f32 = new f32[6](0.0);

s_pole: []f32 = new f32[6](0.0);

// In the air, the foot hangs off the shin just solved (leg_th, leg_sh) as
// the cycle's does, bent at the ankle about the knee's own hinge (so it
// never twists away from the knee), toes the way the knee points.
hung_foot(sd: int, was: V3): V3 {
    cf: V3 = cdir(14 + sd);
    cshin: V3 = v_scale(cdir(11 + 2 * sd), -1.0);
    bendc: f32 = atan2f(v_len(v_cross(cshin, cf)), v_dot(cshin, cf));
    hinge: V3 = v_cross(leg_th, leg_sh);
    if (v_len(hinge) < 0.05) hinge = v_cross(leg_sh, was);
    hinge = v_norm(hinge);
    up_shin: V3 = v_scale(leg_sh, -1.0);
    f1: V3 = v_rotate(up_shin, hinge, bendc);
    f2: V3 = v_rotate(up_shin, hinge, -bendc);
    kneeway: V3 = v_reject(leg_th, v_norm(v_add(v_scale(leg_th, leg_upper), v_scale(leg_sh,
        leg_lower))));
    if (v_len(kneeway) < 0.01) kneeway = was;
    if (v_dot(f2, kneeway) > v_dot(f1, kneeway)) return f2;
    f1
}

// The directions posed this tick (world: the same sixteen as a take's).
sw: []f32 = new f32[48](0.0);

setw(k: int, d: V3) {
    sw[k * 3] = d.x;
    sw[k * 3 + 1] = d.y;
    sw[k * 3 + 2] = d.z
}

getw(k: int): V3 {
    v3(sw[k * 3], sw[k * 3 + 1], sw[k * 3 + 2])
}

steer_pose() {
    if (!s_ready) return;
    g: int = go_gait;
    psi: f32 = s_face;
    i: int = s_cur % NST;
    sample_cycles(maxf(s_speed, 1.5), s_phase);
    for k in 0..16 setw(k, cdir_at(k, psi));
    // Toward the key poses: the trunk, head, and arms here; the hips' height
    // and the legs below.
    key_weights();
    kw: f32 = 0.0;
    for k in 0..NKEYS {
        if (key_w[k] > 0.001) {
            for d in 0..10 setw(d, v_norm(v_lerp(getw(d), v_rotate(key_dir(k, d, key_m[k]),
                UP, psi), key_w[k])));
            kw = maxf(kw, key_w[k])
        }
    }
    // Leans: into an arc, toward a cut (across the way he came in to it),
    // into speeding up.
    fwd: V3 = ahead(psi);
    left: V3 = leftward(psi);
    a_side: f32 = v_dot(s_acc, left);
    a_ahead: f32 = v_dot(s_acc, fwd);
    cut: f32 = 0.0;
    cut_head: f32 = psi;
    for k in 0..3 {
        j: int = (s_cur - 1 + k + NST) % NST;
        if ((st_kind[j] == K_PLANT || st_kind[j] == K_CROSS) && st_turn[j] != 0.0) {
            if (s_now >= st_t[j] - 0.1 && s_now < step_end(j) + 0.15) {
                x: f32 = (s_now - (st_t[j] + st_tc[j] * 0.5)) / (st_tc[j] * 0.7 + 0.05);
                cut = cut + signf(st_turn[j]) * 10.0 * PI / 180.0 * minf(absf(st_turn[j]) / (PI / 3.0),
                    1.3) * expf(-x * x);
                cut_head = heading_or(getv(st_vin, j), psi)
            }
        }
    }
    // (Into a curve the whole body leans, the feet out under him; the trunk
    // most of the way with it.)
    arc: f32 = clampf(0.6 * atan2f(a_side, GRAV), -0.35, 0.35);
    w: f32 = minf(absf(cut) / (8.0 * PI / 180.0), 1.0);
    // (Braking, the trunk comes up and back over the feet.)
    fwd_lean: f32 = atan2f(a_ahead, GRAV) * 0.6;
    if (a_ahead > 0.0) fwd_lean = atan2f(a_ahead, GRAV) * 0.9;
    fwd_lean = fwd_lean * (1.0 - w);
    cut_axis: V3 = ahead(cut_head);
    // The head turns first, to where he means to go, about a step ahead of his
    // body (Sreenivasa et al. 2008: the head leads by some 0.2 s); the chest
    // part of the way with it.
    look: f32 = turn_from(psi, s_look);
    look = clampf(look, -1.1, 1.1);
    for k in 2..6 setw(k, v_rotate(getw(k), UP, look * 0.3));
    for k in 4..6 setw(k, v_rotate(getw(k), UP, look * 0.7));
    for k in 0..10 {
        share: f32 = 1.0;
        if (k == 0 || k == 1 || k == 4 || k == 5) share = 0.5;
        d: V3 = v_rotate(getw(k), fwd, -arc * (1.0 - w) * share * (1.0 - kw));
        d = v_rotate(d, cut_axis, -cut * share * (1.0 - kw));
        setw(k, v_rotate(d, left, fwd_lean * share * (1.0 - kw)))
    }
    // His hips: the cycle's height, lowered into braking steps and plants,
    // and as far as a foot down needs to be reached.
    u: f32 = clampf((s_now - st_t[i]) / maxf(st_tc[i], 0.001), 0.0, 1.0);
    base_y: f32 = cs_y - st_drop[i] * sinf(PI * u);
    if (st_kind[i] == K_STAND) base_y = cs_y;
    for k in 0..NKEYS {
        if (key_w[k] > 0.001) base_y = lerpf(base_y, bone_pos(gait_root[g]).y + key_dy[k],
            key_w[k])
    }
    reach: f32 = sqrtf(leg_upper * leg_upper + leg_lower * leg_lower + 2.0 * leg_upper * leg_lower * cosf(12.0 * PI / 180.0));
    most: f32 = 9.0;
    for sd in 0..2 {
        j: int = down_step(sd);
        if (j >= 0) {
            side: f32 = 1.0 - 2.0 * sd as f32;
            off: V3 = v_sub(v_scale(getw(0), HIP_OUT * side), v_scale(getw(1), HIP_DROP));
            hip0: V3 = v_add(v3(go_p.x, base_y, go_p.z), off);
            ankle: V3 = reached(j, s_now, cdir(14 + sd), hip0);
            hx: f32 = go_p.x + off.x - ankle.x;
            hz: f32 = go_p.z + off.z - ankle.z;
            dh2: f32 = hx * hx + hz * hz;
            m: f32 = ankle.y - off.y;
            if (dh2 < reach * reach) m = m + sqrtf(reach * reach - dh2);
            most = minf(most, m)
        }
    }
    y: f32 = maxf(minf(base_y, most), base_y - 0.15);
    if (y < s_hy) s_hy = s_hy + (y - s_hy) * minf(1.0, 40.0 * TICK) else s_hy = s_hy + (y - s_hy) * minf(1.0,
        15.0 * TICK);
    s_hy = maxf(s_hy, base_y - 0.15);
    root: V3 = v3(go_p.x, s_hy, go_p.z);
    // The legs.
    for sd in 0..2 {
        side: f32 = 1.0 - 2.0 * sd as f32;
        hip: V3 = v_add(root, v_sub(v_scale(getw(0), HIP_OUT * side), v_scale(getw(1),
            HIP_DROP)));
        here: V3 = v_add(hip, v_add(v_scale(cdir_at(10 + 2 * sd, psi), leg_upper),
            v_scale(cdir_at(11 + 2 * sd, psi), leg_lower)));
        j: int = down_step(sd);
        ankle: V3 = here;
        ft: V3 = v3(0.0, 0.0, 1.0);
        pole: V3 = v_rotate(knee_dir(sd), UP, psi);
        if (j >= 0) {
            ankle = reached(j, s_now, cdir(14 + sd), hip);
            ft = planted_ft;
            // (Its knee over its toes: a knee is a hinge, and the shin twists
            // little; the key's knee only a little way from that.)
            toes: V3 = v_norm(v3(ft.x, 0.0, ft.z));
            if (absf(ft.y) > 0.95) toes = ahead(st_yaw[j]);
            // (The knee's hinge square to the foot: bent in the plane through
            // the leg and the foot's length.)
            leg_axis: V3 = v_norm(v_sub(ankle, hip));
            pole = v_cross(leg_axis, v_cross(UP, toes));
            if (v_dot(pole, toes) < 0.0) pole = v_scale(pole, -1.0);
            for kk in 0..NKEYS {
                if (key_w[kk] > 0.001) pole = v_lerp(pole, v_rotate(key_knee(kk, sd),
                    UP, psi), key_w[kk] * 0.25)
            }
            // (Kept, for when it leaves the ground.)
            putv(lift_err, sd, v_sub(ankle, here))
        } else {
            // Carried from where it left to where it lands, on the cycle's path.
            prev: int = last_step(sd);
            nxt: int = (s_cur + 1) % NST;
            t0: f32 = s_now;
            if (prev >= 0) t0 = st_t[prev] + st_tc[prev];
            t1: f32 = t0 + 0.3;
            land: V3 = v3(0.0, 0.0, 0.0);
            yaw1: f32 = psi;
            if (st_side[nxt] == sd && st_t[nxt] > s_now) {
                t1 = st_t[nxt];
                land = getv(st_err, nxt);
                yaw1 = st_yaw[nxt]
            }
            k: f32 = smoothstepf(0.0, 1.0, (s_now - t0) / maxf(t1 - t0, 0.001));
            ankle = v_add(here, v_add(v_scale(getv(lift_err, sd), 1.0 - k), v_scale(land,
                k)));
            // (Toward the key's free leg, driving or crossing; given back in time
            // to land where it must.)
            for kk in 0..NKEYS {
                if (key_w[kk] > 0.001) {
                    wk: f32 = key_w[kk] * (1.0 - smoothstepf(0.55, 0.95, k));
                    there: V3 = v_add(hip, v_rotate(v_add(v_scale(key_dir(kk, 10 + 2 * sd,
                        key_m[kk]), leg_upper), v_scale(key_dir(kk, 11 + 2 * sd, key_m[kk]),
                        leg_lower)), UP, psi));
                    ankle = v_lerp(ankle, there, wk);
                    pole = v_lerp(pole, v_rotate(key_knee(kk, sd), UP, psi), wk)
                }
            }
            yaw0: f32 = psi;
            if (prev >= 0) yaw0 = st_yaw[prev];
            fy: f32 = yaw0 + turn_from(yaw0, yaw1) * k;
            fc: V3 = cdir(14 + sd);
            pitch: f32 = atan2f(fc.y, sqrtf(fc.x * fc.x + fc.z * fc.z));
            ft = v3(sinf(fy) * cosf(pitch), sinf(pitch), cosf(fy) * cosf(pitch))
        }
        leg_ik(hip, ankle, pole);
        if (j < 0) ft = hung_foot(sd, ft);
        setw(10 + 2 * sd, leg_th);
        setw(11 + 2 * sd, leg_sh);
        setw(14 + sd, ft);
        putv(s_ankle, sd, ankle);
        putv(s_pole, sd, pole)
    }
    for k in 0..48 pose_dirs[k] = sw[k];
    rt: int = gait_root[g];
    by: V3 = v3(root.x - bone_rest[rt * 3], root.y - bone_rest[rt * 3 + 1], root.z - bone_rest[rt * 3 + 2]);
    pose_from_dirs(g, gait_base[g], hand_of(g), by);
    // His centre of mass where physics has it: over the ground on the path
    // the steps push him along, in height bouncing as the steps' pushes and
    // gravity make it (not as the poses happen to carry it); his hips put
    // wherever that needs them.
    place_bones(WORK);
    cm: V3 = body_com(g);
    off: V3 = v_sub(cm, wp(rt));
    // (Where the physics has it: over the ground and in height.)
    want_cm: V3 = v3(s_p.x, s_y, s_p.z);
    root = v_sub(want_cm, off);
    by = v3(root.x - bone_rest[rt * 3], root.y - bone_rest[rt * 3 + 1], root.z - bone_rest[rt * 3 + 2]);
    pose_from_dirs(g, gait_base[g], hand_of(g), by);
    // (Again, the legs solved from where the figure's own hips are.)
    place_bones(WORK);
    for sd in 0..2 {
        fb: int = gait_foot[g];
        if (sd == 1) fb = bone_twin[fb];
        leg_ik(wp(bone_parent[bone_parent[fb]]), getv(s_ankle, sd), getv(s_pole, sd));
        setw(10 + 2 * sd, leg_th);
        setw(11 + 2 * sd, leg_sh);
        if (down_step(sd) < 0) setw(14 + sd, hung_foot(sd, getw(14 + sd)))
    }
    for k in 0..48 pose_dirs[k] = sw[k];
    pose_from_dirs(g, gait_base[g], hand_of(g), by);
    for h in 0..nhold {
        if (hold_gait[h] == g && gait_base[g] >= 0) {
            for b in 0..nbones {
                if (is_under(b, hold_bone[h])) set_q(WORK, b, get_q(gait_base[g],
                    b))
            }
        }
    }
    for b in 0..nbones {
        set_q(SHOWN, b, get_q(WORK, b));
        set_t(SHOWN, b, get_t(WORK, b))
    }
}
