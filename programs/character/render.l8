tag character;

use_tag std;

use_tag gl;

use_tag skate;

// Drawing the figure: a studio, a key light with a shadow map, the sky's
// light from all round. Each vertex is carried by up to four bones' matrices
// in the vertex shader. Lighting is in linear color, tone mapped at the end.
const SHADOW_SIZE: int = 2048;

const SHADOW_HALF: f32 = 1.7;

// (One more matrix than there are bones: the last stays the identity, for
// what does not move.)
const BONE_SLOTS: int = 49;

const VIEW_SHADED: int = 0;

const VIEW_PARTS: int = 1;

const VIEW_BONES: int = 2;

const VIEW_FACETS: int = 3;

const VIEW_COUNT: int = 4;

screen_w: int = 1200;

screen_h: int = 720;

extern exit(code: int): noreturn;

die(msg: str) raises IoError: noreturn {
    eprint(msg);
    exit(1)
}

FIGURE_VS: str = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec4 vcol;
attribute vec4 vbone;
attribute vec4 vwt;
attribute vec2 vtag;
uniform mat4 vp;
uniform mat4 light_vp;
uniform mat4 bones[49];
uniform vec2 chosen;
varying vec3 vworld;
varying vec3 vnrm;
varying vec4 vcolor;
varying vec4 vlight;
varying vec3 vbonetint;
varying vec3 vparttint;
varying float vchosen;
vec3 hue(float i) {
  return 0.52 + 0.4 * cos(6.2831 * (i * 0.381966 + vec3(0.0, 0.33, 0.67)));
}
void main() {
  mat4 m = bones[int(vbone.x)] * vwt.x + bones[int(vbone.y)] * vwt.y + bones[int(vbone.z)] * vwt.z + bones[int(vbone.w)] * vwt.w;
  vec4 w = m * vec4(pos, 1.0);
  vworld = w.xyz;
  vnrm = mat3(m[0].xyz, m[1].xyz, m[2].xyz) * nrm;
  vcolor = vcol;
  vlight = light_vp * w;
  vbonetint = hue(vbone.x) * vwt.x + hue(vbone.y) * vwt.y + hue(vbone.z) * vwt.z + hue(vbone.w) * vwt.w;
  vparttint = hue(vtag.x + 1.0 + vtag.y * 0.37);
  float c = 1.0;
  if (chosen.x >= 0.0 && abs(vtag.y - chosen.x) > 0.5) c = 0.0;
  if (chosen.y >= 0.0 && abs(vtag.x - chosen.y) > 0.5) c = 0.0;
  vchosen = c;
  gl_Position = vp * w;
}
""";

FIGURE_FS: str = """
#version 120
uniform sampler2DShadow shadow_map;
uniform sampler2D atlas_map;
uniform vec3 sun_dir;
uniform vec3 cam_pos;
uniform float shadow_texel;
uniform float view_kind;
uniform vec3 backdrop;
uniform vec3 focus;
varying vec3 vworld;
varying vec3 vnrm;
varying vec4 vcolor;
varying vec4 vlight;
varying vec3 vbonetint;
varying vec3 vparttint;
varying float vchosen;

float sun_visibility(float ndl) {
  vec3 sc = vlight.xyz / vlight.w * 0.5 + 0.5;
  if (sc.x < 0.002 || sc.x > 0.998 || sc.y < 0.002 || sc.y > 0.998 || sc.z > 1.0) return 1.0;
  float bias = 0.0015 + 0.004 * (1.0 - clamp(ndl, 0.0, 1.0));
  float t = shadow_texel * 1.3;
  float v = shadow2D(shadow_map, vec3(sc.xy, sc.z - bias)).r * 0.2;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(t, t), sc.z - bias)).r * 0.2;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(-t, t), sc.z - bias)).r * 0.2;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(t, -t), sc.z - bias)).r * 0.2;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(-t, -t), sc.z - bias)).r * 0.2;
  return v;
}

vec3 sky_light(vec3 n) {
  return mix(vec3(0.30, 0.27, 0.25), vec3(0.62, 0.68, 0.80), n.y * 0.5 + 0.5);
}

vec3 tone(vec3 c) {
  c *= 0.62;
  c = (c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14);
  return pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2));
}

void main() {
  vec3 n = normalize(vnrm);
  float ao = clamp(length(vnrm), 0.0, 1.0);
  float finish = vcolor.a;
  vec3 V = normalize(cam_pos - vworld);
  vec3 sun = vec3(2.9, 2.75, 2.5);
  float cover = 1.0;
  vec3 albedo = pow(vcolor.rgb, vec3(2.2));
  if (finish > 29.5 && focus.y > 0.5) {
    // A field to run on, fixed in the world: turf mown in bands, a line
    // across every five yards, a tick for every yard along the hash marks
    // and the sidelines.
    float yd = 0.9144;
    vec2 p = vworld.xz;
    float d = length(p - focus.xz);
    float z5 = p.y / (5.0 * yd);
    vec3 turf = mix(vec3(0.15, 0.33, 0.14), vec3(0.18, 0.38, 0.16), mod(floor(z5), 2.0));
    turf *= 0.95 + 0.05 * sin(p.x * 37.0) * sin(p.y * 41.0) + 0.04 * sin(p.x * 3.3 + p.y * 2.1);
    float aa = 0.01 + d * 0.004;
    float across = 1.0 - smoothstep(0.05, 0.05 + aa, abs(fract(z5 + 0.5) - 0.5) * 5.0 * yd);
    float each = 1.0 - smoothstep(0.04, 0.04 + aa, abs(fract(p.y / yd + 0.5) - 0.5) * yd);
    float rows = min(abs(abs(p.x) - 2.82), abs(abs(p.x) - 24.0));
    float ticks = each * (1.0 - smoothstep(0.3, 0.3 + aa, rows));
    float sides = 1.0 - smoothstep(0.08, 0.08 + aa, abs(abs(p.x) - 24.4));
    float white = max(across * step(abs(p.x), 24.4), max(ticks, sides));
    vec3 paint = pow(mix(turf, vec3(0.92), white * 0.92), vec3(2.2));
    float vis = sun_visibility(1.0);
    vec3 col = paint * (vec3(2.9, 2.75, 2.5) * 0.62 * (0.25 + 0.75 * vis) + vec3(0.5, 0.55, 0.62));
    float fade = smoothstep(28.0, 62.0, d);
    gl_FragColor = vec4(mix(tone(col), backdrop, fade), 1.0);
    return;
  }
  if (finish > 29.5) {
    // The floor: pale, a faint line every half metre, fading into the
    // backdrop, with the figure's shadow.
    vec2 g = abs(fract(vworld.xz * 2.0 + 0.5) - 0.5) * 0.5;
    vec2 g5 = abs(fract(vworld.xz * 0.2 + 0.5) - 0.5) * 5.0;
    float d = length(vworld.xz - focus.xz);
    float line_k = (1.0 - smoothstep(0.0, 0.004 + d * 0.0015, min(g.x, g.y))) * 0.17;
    line_k = max(line_k, (1.0 - smoothstep(0.012, 0.018 + d * 0.002, min(g5.x, g5.y))) * 0.32);
    float vis = sun_visibility(1.0);
    vec3 base = pow(backdrop, vec3(2.2)) * 3.1;
    vec3 col = base * (0.55 + 0.45 * vis) * (1.0 - line_k);
    float fade = smoothstep(2.5, 7.0, d);
    gl_FragColor = vec4(mix(tone(col), backdrop, fade), 1.0);
    return;
  }
  if (finish > 19.5) {
    // A sticker: its picture, lit as cloth.
    vec2 uv = vcolor.rg;
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) discard;
    float tile = floor(vcolor.b + 0.5);
    vec2 at = (vec2(mod(tile, 8.0), floor(tile / 8.0)) + uv) * vec2(0.125, 0.25);
    vec4 t = texture2D(atlas_map, at);
    if (t.a < 0.02) discard;
    albedo = pow(t.rgb, vec3(2.2));
    cover = t.a;
    finish = 2.0;
  }
  if (view_kind > 2.5) {
    n = normalize(cross(dFdx(vworld), dFdy(vworld)));
    if (dot(n, V) < 0.0) n = -n;
    albedo = vec3(0.55, 0.57, 0.6);
    finish = 0.0;
    ao = 1.0;
  } else if (view_kind > 1.5) {
    albedo = pow(vbonetint, vec3(2.2));
    finish = 0.0;
  } else if (view_kind > 0.5) {
    albedo = pow(vparttint, vec3(2.2));
    finish = 0.0;
  }
  float wrap = 0.15;
  float spec = 0.04;
  float gloss = 10.0;
  float mirror = 0.0;
  float sheen = 0.0;
  if (finish > 5.5) {
    spec = 0.10; gloss = 7.0;
  } else if (finish > 4.5) {
    spec = 0.22; gloss = 22.0;
  } else if (finish > 3.5) {
    spec = 0.9; gloss = 50.0; mirror = 0.55; albedo *= 0.55;
  } else if (finish > 2.5) {
    spec = 0.75; gloss = 110.0; mirror = 0.16;
  } else if (finish > 1.5) {
    wrap = 0.3; spec = 0.02; sheen = 0.10;
  } else if (finish > 0.5) {
    wrap = 0.38; spec = 0.13; gloss = 16.0;
  }
  float ndl = dot(n, sun_dir);
  float vis = sun_visibility(ndl);
  float diff = max((ndl + wrap) / (1.0 + wrap), 0.0);
  vec3 col = albedo * (sun * diff * vis * (0.55 + 0.45 * ao) + sky_light(n) * ao * 1.15);
  if (finish > 0.5 && finish < 1.5) {
    // Skin: a little red where light turns to shade.
    float edge = smoothstep(-0.25, 0.15, ndl) * (1.0 - smoothstep(0.15, 0.6, ndl));
    col += albedo * vec3(0.35, 0.09, 0.05) * edge * vis;
  }
  float rim = pow(1.0 - max(dot(n, V), 0.0), 3.0);
  col += (vec3(0.5, 0.56, 0.7) * 0.22 + albedo * sheen * 3.0) * rim * ao;
  vec3 H = normalize(sun_dir + V);
  col += sun * vis * spec * pow(max(dot(n, H), 0.0), gloss) * (gloss + 8.0) / 60.0 * step(0.0, ndl);
  if (mirror > 0.0) {
    vec3 R = reflect(-V, n);
    float f = mirror + (1.0 - mirror) * pow(1.0 - max(dot(n, V), 0.0), 5.0) * 0.6;
    float band = smoothstep(0.1, 0.5, R.y) * 0.8 + smoothstep(0.75, 0.95, R.y) * 1.2;
    col += (sky_light(R) * 0.6 + vec3(band)) * f * ao;
  }
  vec3 shown = tone(col);
  if (vchosen < 0.5) shown = mix(vec3(dot(shown, vec3(0.33))), backdrop, 0.72);
  gl_FragColor = vec4(shown * cover, cover);
}
""";

SHADOW_VS: str = """
#version 120
attribute vec3 pos;
attribute vec4 vbone;
attribute vec4 vwt;
uniform mat4 light_vp;
uniform mat4 bones[49];
void main() {
  mat4 m = bones[int(vbone.x)] * vwt.x + bones[int(vbone.y)] * vwt.y + bones[int(vbone.z)] * vwt.z + bones[int(vbone.w)] * vwt.w;
  gl_Position = light_vp * (m * vec4(pos, 1.0));
}
""";

SHADOW_FS: str = """
#version 120
void main() {
  gl_FragColor = vec4(1.0);
}
""";

// The backdrop: paler toward the floor's far edge.
BACK_VS: str = """
#version 120
attribute vec3 pos;
varying vec2 vscreen;
void main() {
  vscreen = pos.xy;
  gl_Position = vec4(pos.xy, 0.9999, 1.0);
}
""";

BACK_FS: str = """
#version 120
uniform vec3 backdrop;
varying vec2 vscreen;
void main() {
  gl_FragColor = vec4(backdrop + vscreen.y * 0.0, 1.0);
}
""";

// Flat colored shapes: the skeleton, and the words over the picture.
FLAT_VS: str = """
#version 120
attribute vec3 pos;
attribute vec4 vcol;
uniform mat4 vp;
varying vec4 vcolor;
void main() {
  vcolor = vcol;
  gl_Position = vp * vec4(pos, 1.0);
}
""";

FLAT_FS: str = """
#version 120
varying vec4 vcolor;
void main() {
  gl_FragColor = vcolor;
}
""";

compile_shader(kind: int, src: []i8) raises IoError: int {
    sh: int = glCreateShader(kind);
    sp: *i8 = src;
    ln: []i32 = new i32[1](len(src) trunc i32);
    glShaderSource(sh, 1, &sp, ln);
    glCompileShader(sh);
    st: []i32 = new i32[1](0i32);
    glGetShaderiv(sh, 35713, st);
    if (st[0] == 0i32) {
        logn: []i32 = new i32[1](0i32);
        glGetShaderiv(sh, 35716, logn);
        n: int = logn[0] as int;
        if (n < 1) n = 1;
        if (n > 4096) n = 4096;
        buf: []i8 = new i8[n](0i8);
        glGetShaderInfoLog(sh, n, null, buf);
        write_bytes_n(2, buf, n);
        write(2, "\n");
        die("shader compile failed")
    }
    sh
}

link_program(vs: str, fs: str) raises IoError: int {
    prog: int = glCreateProgram();
    glAttachShader(prog, compile_shader(35633, bytes(vs)));
    glAttachShader(prog, compile_shader(35632, bytes(fs)));
    glBindAttribLocation(prog, 0, "pos");
    glBindAttribLocation(prog, 1, "nrm");
    glBindAttribLocation(prog, 2, "vcol");
    glBindAttribLocation(prog, 3, "vbone");
    glBindAttribLocation(prog, 4, "vwt");
    glBindAttribLocation(prog, 5, "vtag");
    glLinkProgram(prog);
    st: []i32 = new i32[1](0i32);
    glGetProgramiv(prog, 35714, st);
    if (st[0] == 0i32) die("program link failed");
    prog
}

type Renderer = {
    figure: int;
    shadow: int;
    back: int;
    flat_prog: int;
    u_vp: int;
    u_light: int;
    u_bones: int;
    u_chosen: int;
    u_shadow_map: int;
    u_atlas: int;
    u_sun: int;
    u_cam: int;
    u_texel: int;
    u_view: int;
    u_backdrop: int;
    u_focus: int;
    u_s_light: int;
    u_s_bones: int;
    u_b_backdrop: int;
    u_f_vp: int;
    vert_buf: u32;
    // The next mesh's vertices wait here until its triangles are ready.
    next_buf: u32;
    idx_buf: u32;
    floor_buf: u32;
    back_buf: u32;
    flat_buf: u32;
    shadow_tex: u32;
    shadow_fbo: u32;
    atlas_tex: u32;
    // What the buffers hold: how many corners the layers have, and the
    // stickers after them.
    layers_n: int;
    stickers_n: int
}

gen_buffer(): u32 {
    ids: []u32 = new u32[1](0u32);
    glGenBuffers(1, ids);
    ids[0]
}

const FLOOR_VERTS: int = 6;

floor_verts: []f32 = new f32[FLOOR_VERTS * VERT_FLOATS](0.0);

back_verts: []f32 = new f32[9](0.0);

put_floor(i: int, x: f32, z: f32) {
    at: int = i * VERT_FLOATS;
    floor_verts[at] = x;
    floor_verts[at + 2] = z;
    floor_verts[at + V_NRM + 1] = 1.0;
    floor_verts[at + V_FINISH] = 30.0;
    floor_verts[at + V_BONES] = (BONE_SLOTS - 1) as f32;
    floor_verts[at + V_BONES + 1] = (BONE_SLOTS - 1) as f32;
    floor_verts[at + V_BONES + 2] = (BONE_SLOTS - 1) as f32;
    floor_verts[at + V_BONES + 3] = (BONE_SLOTS - 1) as f32;
    floor_verts[at + V_WEIGHTS] = 1.0;
    floor_verts[at + V_PART] = -5.0;
    floor_verts[at + V_LAYER] = -5.0
}

new_renderer() raises IoError: *Renderer@new {
    figure: int = link_program(FIGURE_VS, FIGURE_FS);
    shadow: int = link_program(SHADOW_VS, SHADOW_FS);
    back: int = link_program(BACK_VS, BACK_FS);
    flat_prog: int = link_program(FLAT_VS, FLAT_FS);
    va: []u32 = new u32[1](0u32);
    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    r: *Renderer = new Renderer {
        figure: figure,
        shadow: shadow,
        back: back,
        flat_prog: flat_prog,
        u_vp: glGetUniformLocation(figure, "vp"),
        u_light: glGetUniformLocation(figure, "light_vp"),
        u_bones: glGetUniformLocation(figure, "bones"),
        u_chosen: glGetUniformLocation(figure, "chosen"),
        u_shadow_map: glGetUniformLocation(figure, "shadow_map"),
        u_atlas: glGetUniformLocation(figure, "atlas_map"),
        u_sun: glGetUniformLocation(figure, "sun_dir"),
        u_cam: glGetUniformLocation(figure, "cam_pos"),
        u_texel: glGetUniformLocation(figure, "shadow_texel"),
        u_view: glGetUniformLocation(figure, "view_kind"),
        u_backdrop: glGetUniformLocation(figure, "backdrop"),
        u_focus: glGetUniformLocation(figure, "focus"),
        u_s_light: glGetUniformLocation(shadow, "light_vp"),
        u_s_bones: glGetUniformLocation(shadow, "bones"),
        u_b_backdrop: glGetUniformLocation(back, "backdrop"),
        u_f_vp: glGetUniformLocation(flat_prog, "vp"),
        vert_buf: gen_buffer(),
        next_buf: gen_buffer(),
        idx_buf: gen_buffer(),
        floor_buf: gen_buffer(),
        back_buf: gen_buffer(),
        flat_buf: gen_buffer(),
        shadow_tex: 0u32,
        shadow_fbo: 0u32,
        atlas_tex: 0u32,
        layers_n: 0,
        stickers_n: 0
    };
    k: f32 = 70.0;
    put_floor(0, -k, -k);
    put_floor(1, -k, k);
    put_floor(2, k, k);
    put_floor(3, -k, -k);
    put_floor(4, k, k);
    put_floor(5, k, -k);
    glBindBuffer(34962, r.floor_buf);
    glBufferData(34962, FLOOR_VERTS * VERT_FLOATS * 4, floor_verts, 35044);
    back_verts[0] = -1.0;
    back_verts[1] = -1.0;
    back_verts[3] = 3.0;
    back_verts[4] = -1.0;
    back_verts[6] = -1.0;
    back_verts[7] = 3.0;
    glBindBuffer(34962, r.back_buf);
    glBufferData(34962, 36, back_verts, 35044);
    tex: []u32 = new u32[2](0u32);
    glGenTextures(2, tex);
    glBindTexture(3553, tex[0]);
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 34892, 34894);
    glTexParameteri(3553, 34893, 515);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 33190, SHADOW_SIZE, SHADOW_SIZE, 0, 6402, 5125, null);
    fbo: []u32 = new u32[1](0u32);
    glGenFramebuffers(1, fbo);
    glBindFramebuffer(36160, fbo[0]);
    glFramebufferTexture2D(36160, 36096, 3553, tex[0], 0);
    glDrawBuffer(0);
    glReadBuffer(0);
    if (glCheckFramebufferStatus(36160) != 36053) die("shadow framebuffer incomplete");
    glBindFramebuffer(36160, 0u32);
    r.shadow_tex = tex[0];
    r.shadow_fbo = fbo[0];
    glBindTexture(3553, tex[1]);
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    r.atlas_tex = tex[1];
    glEnable(2929);
    r
}

// The baked mesh to the card; and the stickers' pictures.
upload_vertices(r: *Renderer) {
    glBindBuffer(34962, r.next_buf);
    glBufferData(34962, maxi(nverts, 1) * VERT_FLOATS * 4, verts, 35044)
}

// (And the vertices sent before are the ones drawn from now.)
upload_pictures(r: *Renderer) {
    was: u32 = r.vert_buf;
    r.vert_buf = r.next_buf;
    r.next_buf = was;
    glActiveTexture(33985);
    glBindTexture(3553, r.atlas_tex);
    glPixelStorei(3317, 1);
    glTexImage2D(3553, 0, 6408, ATLAS_W, ATLAS_H, 0, 6408, 5121, atlas);
    glActiveTexture(33984)
}

// The triangles that show.
upload_draws(r: *Renderer) {
    glBindBuffer(34963, r.idx_buf);
    glNamedBufferData(r.idx_buf, maxi(draw_n, 3) * 4, draw_idx, 35044);
    r.layers_n = stickers_d0;
    r.stickers_n = stickers_dn
}

bind_figure(buf: u32) {
    glBindBuffer(34962, buf);
    for i in 0..6 glEnableVertexAttribArray(i);
    stride: int = VERT_FLOATS * 4;
    glVertexAttribPointer(0, 3, 5126, 0, stride, 0);
    glVertexAttribPointer(1, 3, 5126, 0, stride, V_NRM * 4);
    glVertexAttribPointer(2, 4, 5126, 0, stride, V_RGB * 4);
    glVertexAttribPointer(3, 4, 5126, 0, stride, V_BONES * 4);
    glVertexAttribPointer(4, 4, 5126, 0, stride, V_WEIGHTS * 4);
    glVertexAttribPointer(5, 2, 5126, 0, stride, V_PART * 4)
}

type View = {
    eye: V3;
    at: V3;
    fovy: f32;
    // How far the picture's middle is moved, in half screens: right, up.
    shift_x: f32;
    shift_y: f32;
    kind: int;
    // Where on the ground the figure is: the floor and the light go with it.
    focus: V3;
    // The layer and the part picked out, or -1.
    layer: int;
    part: int;
    bones: bool
}

view_m: []f32 = new f32[16](0.0);

proj_m: []f32 = new f32[16](0.0);

vp_m: []f32 = new f32[16](0.0);

light_view: []f32 = new f32[16](0.0);

light_proj: []f32 = new f32[16](0.0);

light_vp: []f32 = new f32[16](0.0);

// The bones' matrices as the shaders take them, the identity last.
bone_slots: []f32 = new f32[BONE_SLOTS * 16](0.0);

backdrop: V3 = V3 { x: 0.80, y: 0.82, z: 0.85 };

sun_dir: V3 = V3 { x: 0.42, y: 0.74, z: 0.52 };

set_bones() {
    for i in 0..BONE_SLOTS * 16 bone_slots[i] = 0.0;
    for b in 0..BONE_SLOTS {
        bone_slots[b * 16] = 1.0;
        bone_slots[b * 16 + 5] = 1.0;
        bone_slots[b * 16 + 10] = 1.0;
        bone_slots[b * 16 + 15] = 1.0
    }
    for i in 0..nbones * 16 bone_slots[i] = bone_m[i]
}

// The floor goes with the figure, by whole lengths of its widest lines.
set_floor(focus: V3) {
    at: int = (BONE_SLOTS - 1) * 16;
    bone_slots[at + 12] = floorf(focus.x / 5.0 + 0.5) * 5.0;
    bone_slots[at + 14] = floorf(focus.z / 5.0 + 0.5) * 5.0
}

// The skeleton, as flat shapes: each bone a long diamond from its joint to
// its parent's.
const FLAT_FLOATS: int = 7;

const MAX_FLAT: int = 60000;

flat_verts: []f32 = new f32[MAX_FLAT * FLAT_FLOATS](0.0);

flat_n: int = 0;

put_flat(p: V3, c: V3, a: f32) {
    if (flat_n >= MAX_FLAT) return;
    i: int = flat_n * FLAT_FLOATS;
    flat_verts[i] = p.x;
    flat_verts[i + 1] = p.y;
    flat_verts[i + 2] = p.z;
    flat_verts[i + 3] = c.x;
    flat_verts[i + 4] = c.y;
    flat_verts[i + 5] = c.z;
    flat_verts[i + 6] = a;
    flat_n = flat_n + 1
}

put_bone_shape(a: V3, b: V3, eye: V3) {
    d: V3 = v_sub(b, a);
    l: f32 = v_len(d);
    if (l < 0.0005) return;
    dir: V3 = v_scale(d, 1.0 / l);
    side: V3 = v_norm(v_cross(dir, v_sub(eye, a)));
    w: f32 = minf(0.012, l * 0.2) + 0.002;
    mid: V3 = v_madd(a, dir, l * 0.22);
    l1: V3 = v_madd(mid, side, w);
    l2: V3 = v_madd(mid, side, -w);
    pale: V3 = v3(1.0, 0.86, 0.3);
    deep: V3 = v3(0.95, 0.55, 0.1);
    put_flat(a, deep, 0.95);
    put_flat(l1, pale, 0.95);
    put_flat(l2, pale, 0.95);
    put_flat(l1, pale, 0.95);
    put_flat(b, deep, 0.95);
    put_flat(l2, pale, 0.95)
}

build_skeleton(eye: V3) {
    flat_n = 0;
    for b in 0..nbones {
        par: int = bone_parent[b];
        at: V3 = v_add(wp(b), v3(0.0, lift, 0.0));
        if (par >= 0) put_bone_shape(v_add(wp(par), v3(0.0, lift, 0.0)), at, eye);
        // The joint: a small square facing the eye.
        f: V3 = v_norm(v_sub(eye, at));
        rt: V3 = v_norm(v_cross(v3(0.0, 1.0, 0.0), f));
        up: V3 = v_cross(f, rt);
        s: f32 = 0.006;
        c: V3 = v3(0.2, 0.2, 0.25);
        put_flat(v_add(v_madd(at, rt, -s), v_scale(up, -s)), c, 1.0);
        put_flat(v_add(v_madd(at, rt, s), v_scale(up, -s)), c, 1.0);
        put_flat(v_add(v_madd(at, rt, s), v_scale(up, s)), c, 1.0);
        put_flat(v_add(v_madd(at, rt, -s), v_scale(up, -s)), c, 1.0);
        put_flat(v_add(v_madd(at, rt, s), v_scale(up, s)), c, 1.0);
        put_flat(v_add(v_madd(at, rt, -s), v_scale(up, s)), c, 1.0)
    }
}

draw_flat(r: *Renderer, m: []f32) {
    if (flat_n == 0) return;
    glUseProgram(r.flat_prog);
    glUniformMatrix4fv(r.u_f_vp, 1, 0, m);
    glBindBuffer(34962, r.flat_buf);
    glBufferData(34962, flat_n * FLAT_FLOATS * 4, flat_verts, 35048);
    for i in 0..6 glDisableVertexAttribArray(i);
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(2);
    glVertexAttribPointer(0, 3, 5126, 0, FLAT_FLOATS * 4, 0);
    glVertexAttribPointer(2, 4, 5126, 0, FLAT_FLOATS * 4, 12);
    glDisable(2929);
    glEnable(3042);
    glBlendFunc(770, 771);
    glDrawArrays(4, 0, flat_n);
    glDisable(3042);
    glEnable(2929)
}

draw_scene(r: *Renderer, view: View, ready: bool) {
    set_bones();
    set_floor(view.focus);
    sun: V3 = v_norm(sun_dir);
    mid: V3 = v3(view.focus.x, 0.9, view.focus.z);
    mat_look(light_view, v_madd(mid, sun, 10.0), mid, v3(0.0, 1.0, 0.0));
    mat_ortho(light_proj, -SHADOW_HALF, SHADOW_HALF, -SHADOW_HALF, SHADOW_HALF, 4.0,
        16.0);
    mat_mul(light_vp, light_proj, light_view);
    glBindFramebuffer(36160, r.shadow_fbo);
    glViewport(0, 0, SHADOW_SIZE, SHADOW_SIZE);
    glClear(256);
    glBindBuffer(34963, r.idx_buf);
    if (ready && r.layers_n > 0) {
        glUseProgram(r.shadow);
        glEnable(32823);
        glPolygonOffset(1.5, 2.0);
        glUniformMatrix4fv(r.u_s_light, 1, 0, light_vp);
        glUniformMatrix4fv(r.u_s_bones, BONE_SLOTS, 0, bone_slots);
        bind_figure(r.vert_buf);
        glDrawElements(4, r.layers_n, 5125, 0);
        glDisable(32823)
    }
    glBindFramebuffer(36160, 0u32);
    glViewport(0, 0, screen_w, screen_h);
    glClear(16640);
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    mat_persp(proj_m, view.fovy, aspect, 0.1, 300.0);
    proj_m[8] = -view.shift_x;
    proj_m[9] = -view.shift_y;
    mat_look(view_m, view.eye, view.at, v3(0.0, 1.0, 0.0));
    mat_mul(vp_m, proj_m, view_m);
    glDepthMask(0);
    glDisable(2929);
    glUseProgram(r.back);
    glUniform3f(r.u_b_backdrop, backdrop.x, backdrop.y, backdrop.z);
    glBindBuffer(34962, r.back_buf);
    for i in 1..6 glDisableVertexAttribArray(i);
    glEnableVertexAttribArray(0);
    glVertexAttribPointer(0, 3, 5126, 0, 12, 0);
    glDrawArrays(4, 0, 3);
    glDepthMask(1);
    glEnable(2929);
    glUseProgram(r.figure);
    glUniformMatrix4fv(r.u_vp, 1, 0, vp_m);
    glUniformMatrix4fv(r.u_light, 1, 0, light_vp);
    glUniformMatrix4fv(r.u_bones, BONE_SLOTS, 0, bone_slots);
    glUniform3f(r.u_sun, sun.x, sun.y, sun.z);
    glUniform3f(r.u_cam, view.eye.x, view.eye.y, view.eye.z);
    glUniform3f(r.u_backdrop, backdrop.x, backdrop.y, backdrop.z);
    glUniform3f(r.u_focus, view.focus.x, view.focus.y, view.focus.z);
    glUniform1f(r.u_texel, 1.0 / SHADOW_SIZE as f32);
    glUniform1f(r.u_view, 0.0);
    glUniform2f(r.u_chosen, -1.0, -1.0);
    glActiveTexture(33984);
    glBindTexture(3553, r.shadow_tex);
    glUniform1i(r.u_shadow_map, 0);
    glActiveTexture(33985);
    glBindTexture(3553, r.atlas_tex);
    glUniform1i(r.u_atlas, 1);
    glActiveTexture(33984);
    bind_figure(r.floor_buf);
    glDrawArrays(4, 0, FLOOR_VERTS);
    if (ready && r.layers_n > 0) {
        glUniform1f(r.u_view, view.kind as f32);
        // (Under the skeleton, all of it is dimmed.)
        if (view.bones) glUniform2f(r.u_chosen, 99.0, -1.0) else glUniform2f(r.u_chosen,
            view.layer as f32, view.part as f32);
        bind_figure(r.vert_buf);
        glDrawElements(4, r.layers_n, 5125, 0);
        if (r.stickers_n > 0 && view.kind == VIEW_SHADED) {
            glEnable(3042);
            glBlendFunc(1, 771);
            glDepthMask(0);
            glDepthFunc(515);
            glEnable(32823);
            glPolygonOffset(-1.0, -2.0);
            glDrawElements(4, r.stickers_n, 5125, r.layers_n * 4);
            glDisable(32823);
            glDepthMask(1);
            glDepthFunc(513);
            glDisable(3042)
        }
        if (view.bones) {
            build_skeleton(view.eye);
            draw_flat(r, vp_m)
        }
    }
}
