tag character;

use_tag skate;

// A layer as a field: at any point, how far outside its surface the point
// is (negative inside). Shapes join with a smooth minimum, so they blend
// into one skin; a layer can also be another layer grown, clipped to
// another, or carved by another.
const FAR: f32 = 1000000.0;

// With raw shapes, nothing blends: each shape shows as it is.
raw_shapes: bool = false;

// The smaller of a and b, rounded where they meet over a width k.
smin(a: f32, b: f32, k: f32): f32 {
    if (k <= 0.00001) return minf(a, b);
    h: f32 = maxf(k - absf(a - b), 0.0) / k;
    minf(a, b) - h * h * k * 0.25
}

smax(a: f32, b: f32, k: f32): f32 {
    -smin(-a, -b, k)
}

// How far along a cone's axis p is, 0 at its first end to 1 at its second.
cone_along(o: int, p: V3): f32 {
    a: V3 = opv(o, F_A);
    ba: V3 = v_sub(opv(o, F_B), a);
    l2: f32 = v_dot(ba, ba);
    if (l2 < 0.0000001) return 0.0;
    clampf(v_dot(v_sub(p, a), ba) / l2, 0.0, 1.0)
}

// What a cone's field needs, worked out once: its axis (squashed as it is),
// that axis's length squared, and how much of it the radii leave.
const CONE_FLOATS: int = 6;

cone_k: []f32 = new f32[MAX_OPS * CONE_FLOATS](0.0);

prepare_cones() {
    for o in 0..nops {
        if (op_kind[o] == OP_CONE) {
            i: int = o * OP_FLOATS;
            ba: V3 = v_sub(opv(o, F_B), opv(o, F_A));
            flat: f32 = op_f[i + F_FLAT];
            if (flat != 1.0) {
                u: V3 = opv(o, F_FLAT_AXIS);
                ba = v_madd(ba, u, v_dot(ba, u) * (1.0 / flat - 1.0))
            }
            rr: f32 = op_f[i + F_RA] - op_f[i + F_RB];
            l2: f32 = v_dot(ba, ba);
            c: int = o * CONE_FLOATS;
            cone_k[c] = ba.x;
            cone_k[c + 1] = ba.y;
            cone_k[c + 2] = ba.z;
            cone_k[c + 3] = l2;
            cone_k[c + 4] = l2 - rr * rr;
            cone_k[c + 5] = 1.0 / flat - 1.0
        }
    }
}

// How far p is outside shape o (the arithmetic written out: this is where
// baking spends its time).
shape_dist(o: int, p: V3): f32 {
    i: int = o * OP_FLOATS;
    px: f32 = p.x - op_f[i];
    py: f32 = p.y - op_f[i + 1];
    pz: f32 = p.z - op_f[i + 2];
    if (op_kind[o] == OP_CONE) {
        c: int = o * CONE_FLOATS;
        flat: f32 = op_f[i + F_FLAT];
        if (flat != 1.0) {
            // Squashed along an axis: the cone, in a space stretched back.
            t: f32 = (px * op_f[i + F_FLAT_AXIS] + py * op_f[i + F_FLAT_AXIS + 1] + pz * op_f[i + F_FLAT_AXIS + 2]) * cone_k[c + 5];
            px = px + op_f[i + F_FLAT_AXIS] * t;
            py = py + op_f[i + F_FLAT_AXIS + 1] * t;
            pz = pz + op_f[i + F_FLAT_AXIS + 2] * t
        }
        r1: f32 = op_f[i + F_RA];
        r2: f32 = op_f[i + F_RB];
        bx: f32 = cone_k[c];
        by: f32 = cone_k[c + 1];
        bz: f32 = cone_k[c + 2];
        l2: f32 = cone_k[c + 3];
        a2: f32 = cone_k[c + 4];
        d: f32 = 0.0;
        if (a2 <= 0.0000001) {
            // One end inside the other: a ball.
            if (r1 >= r2) d = sqrtf(px * px + py * py + pz * pz) - r1 else d = sqrtf((px - bx) * (px - bx) + (py - by) * (py - by) + (pz - bz) * (pz - bz)) - r2
        } else {
            rr: f32 = r1 - r2;
            il2: f32 = 1.0 / l2;
            y: f32 = px * bx + py * by + pz * bz;
            z: f32 = y - l2;
            tx: f32 = px * l2 - bx * y;
            ty: f32 = py * l2 - by * y;
            tz: f32 = pz * l2 - bz * y;
            x2: f32 = tx * tx + ty * ty + tz * tz;
            k: f32 = rr * rr * x2;
            if (rr < 0.0) k = -k;
            zs: f32 = z * z * l2 * a2;
            if (z < 0.0) zs = -zs;
            ys: f32 = y * y * l2 * a2;
            if (y < 0.0) ys = -ys;
            if (zs > k) d = sqrtf(x2 + z * z * l2) * il2 - r2 else if (ys < k) d = sqrtf(x2 + y * y * l2) * il2 - r1 else d = (sqrtf(x2 * a2 * il2) + y * rr) * il2 - r1
        }
        if (flat < 1.0) d = d * flat;
        return d
    }
    qx: f32 = px * op_f[i + F_AXES] + py * op_f[i + F_AXES + 1] + pz * op_f[i + F_AXES + 2];
    qy: f32 = px * op_f[i + F_AXES + 3] + py * op_f[i + F_AXES + 4] + pz * op_f[i + F_AXES + 5];
    qz: f32 = px * op_f[i + F_AXES + 6] + py * op_f[i + F_AXES + 7] + pz * op_f[i + F_AXES + 8];
    hx: f32 = op_f[i + F_B];
    hy: f32 = op_f[i + F_B + 1];
    hz: f32 = op_f[i + F_B + 2];
    if (op_kind[o] == OP_EGG) {
        ax: f32 = qx / hx;
        ay: f32 = qy / hy;
        az: f32 = qz / hz;
        k0: f32 = sqrtf(ax * ax + ay * ay + az * az);
        ax = ax / hx;
        ay = ay / hy;
        az = az / hz;
        k1: f32 = sqrtf(ax * ax + ay * ay + az * az);
        if (k1 < 0.000001) return -minf(hx, minf(hy, hz));
        return k0 * (k0 - 1.0) / k1
    }
    // A box, its edges rounded.
    rd: f32 = op_f[i + F_RB];
    ex: f32 = absf(qx) - hx + rd;
    ey: f32 = absf(qy) - hy + rd;
    ez: f32 = absf(qz) - hz + rd;
    inner: f32 = minf(maxf(ex, maxf(ey, ez)), 0.0);
    ex = maxf(ex, 0.0);
    ey = maxf(ey, 0.0);
    ez = maxf(ez, 0.0);
    sqrtf(ex * ex + ey * ey + ez * ez) + inner - rd
}

// ---- the ops that matter near a place ----
// Each layer's ops, in order, leaving out the shapes too far from a place
// to change the field there.
act_ops: []int = new int[MAX_OPS](0);

act_first: []int = new int[MAX_LAYERS](0);

act_n: []int = new int[MAX_LAYERS](0);

// The same for a wider place round it, that the narrower is picked from.
wide_ops: []int = new int[MAX_OPS](0);

wide_first: []int = new int[MAX_LAYERS](0);

wide_n: []int = new int[MAX_LAYERS](0);

op_near(o: int, c: V3, reach: f32): bool {
    if (op_kind[o] >= OP_GROW || op_mode[o] == MODE_KEEP) return true;
    dx: f32 = c.x - op_ball[o * 4];
    dy: f32 = c.y - op_ball[o * 4 + 1];
    dz: f32 = c.z - op_ball[o * 4 + 2];
    r: f32 = reach + op_ball[o * 4 + 3];
    dx * dx + dy * dy + dz * dz < r * r
}

set_wide(c: V3, reach: f32) {
    n: int = 0;
    for l in 0..nlayers {
        wide_first[l] = n;
        for o in layer_first[l]..layer_first[l] + layer_nops[l] {
            if (op_near(o, c, reach)) {
                wide_ops[n] = o;
                n = n + 1
            }
        }
        wide_n[l] = n - wide_first[l]
    }
}

// (Within the place last given to set_wide.)
set_active(c: V3, reach: f32) {
    n: int = 0;
    for l in 0..nlayers {
        act_first[l] = n;
        for i in wide_first[l]..wide_first[l] + wide_n[l] {
            o: int = wide_ops[i];
            if (op_near(o, c, reach)) {
                act_ops[n] = o;
                n = n + 1
            }
        }
        act_n[l] = n - act_first[l]
    }
}

// Each layer's field at the point last given to field_all.
layer_val: []f32 = new f32[MAX_LAYERS](0.0);

// Layer l's field at p. With memo, the layers it is made from are read from
// layer_val instead of worked out again.
field_of(l: int, p: V3, memo: bool): f32 {
    d: f32 = FAR;
    for i in act_first[l]..act_first[l] + act_n[l] {
        o: int = act_ops[i];
        k: int = op_kind[o];
        bl: f32 = op_f[o * OP_FLOATS + F_BLEND];
        if (k < OP_GROW) {
            s: f32 = shape_dist(o, p);
            mode: int = op_mode[o];
            if (mode == MODE_ADD) {
                if (raw_shapes) d = minf(d, s) else d = smin(d, s, bl)
            } else if (mode == MODE_CUT) d = smax(d, -s, bl) else d = smax(d, s, bl)
        } else {
            s: f32 = 0.0;
            if (memo) s = layer_val[op_ref[o]] else s = field_of(op_ref[o], p, false);
            if (k == OP_GROW) d = smin(d, s - op_f[o * OP_FLOATS + F_GROW], bl) else if (k == OP_CLIP) d = smax(d,
                s, bl) else d = smax(d, op_f[o * OP_FLOATS + F_GROW] - s, bl)
        }
    }
    d
}

// Every layer's field at p, into layer_val.
field_all(p: V3) {
    for l in 0..nlayers layer_val[l] = field_of(l, p, true)
}

// The way the field of layer l rises at p, from four points around it.
gradient(l: int, p: V3, e: f32): V3 {
    a: f32 = field_of(l, v3(p.x + e, p.y - e, p.z - e), false);
    b: f32 = field_of(l, v3(p.x - e, p.y - e, p.z + e), false);
    c: f32 = field_of(l, v3(p.x - e, p.y + e, p.z - e), false);
    d: f32 = field_of(l, v3(p.x + e, p.y + e, p.z + e), false);
    v3(a - b - c + d, d + c - a - b, d + b - a - c)
}

// ---- which shapes make the surface at a point ----
// The shapes of a layer (and of those it grows from) near a point, with
// how far outside each the point is, the growing taken off.
const MAX_CAND: int = 512;

cand_op: []int = new int[MAX_CAND](0);

cand_d: []f32 = new f32[MAX_CAND](0.0);

ncand: int = 0;

gather(l: int, p: V3, off: f32) {
    for i in act_first[l]..act_first[l] + act_n[l] {
        o: int = act_ops[i];
        k: int = op_kind[o];
        if (k < OP_GROW) {
            if (ncand < MAX_CAND && (op_mode[o] == MODE_ADD || op_mat[o] >= 0)) {
                cand_op[ncand] = o;
                cand_d[ncand] = shape_dist(o, p) - off;
                ncand = ncand + 1
            }
        } else if (k == OP_GROW) gather(op_ref[o], p, off + op_f[o * OP_FLOATS + F_GROW])
    }
}
