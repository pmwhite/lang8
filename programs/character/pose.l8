tag character;

use_tag skate;

// Posing: each pose, worked out once into a turn and a shift for every
// bone; poses mixed; and from a mix, where every bone is and the matrix
// that carries its vertices there.
type Q = {
    x: f32;
    y: f32;
    z: f32;
    w: f32
}

q_ident(): Q {
    Q {
        x: 0.0,
        y: 0.0,
        z: 0.0,
        w: 1.0
    }
}

// The turn b, then the turn a.
q_mul(a: Q, b: Q): Q {
    Q {
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
    }
}

q_conj(q: Q): Q {
    Q {
        x: -q.x,
        y: -q.y,
        z: -q.z,
        w: q.w
    }
}

q_unit(q: Q): Q {
    l: f32 = sqrtf(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w);
    if (l < 0.000001) return q_ident();
    Q {
        x: q.x / l,
        y: q.y / l,
        z: q.z / l,
        w: q.w / l
    }
}

q_axis(axis: V3, angle: f32): Q {
    s: f32 = sinf(angle * 0.5);
    Q {
        x: axis.x * s,
        y: axis.y * s,
        z: axis.z * s,
        w: cosf(angle * 0.5)
    }
}

q_turn(q: Q, v: V3): V3 {
    u: V3 = v3(q.x, q.y, q.z);
    t: V3 = v_scale(v_cross(u, v), 2.0);
    v_add(v_add(v, v_scale(t, q.w)), v_cross(u, t))
}

// The turn that takes the x, y, z axes to these three.
q_axes(x: V3, y: V3, z: V3): Q {
    tr: f32 = x.x + y.y + z.z;
    if (tr > 0.0) {
        s: f32 = sqrtf(tr + 1.0) * 2.0;
        return q_unit(Q {
            x: (y.z - z.y) / s,
            y: (z.x - x.z) / s,
            z: (x.y - y.x) / s,
            w: 0.25 * s
        })
    }
    if (x.x > y.y && x.x > z.z) {
        s: f32 = sqrtf(1.0 + x.x - y.y - z.z) * 2.0;
        return q_unit(Q {
            x: 0.25 * s,
            y: (y.x + x.y) / s,
            z: (z.x + x.z) / s,
            w: (y.z - z.y) / s
        })
    }
    if (y.y > z.z) {
        s: f32 = sqrtf(1.0 + y.y - x.x - z.z) * 2.0;
        return q_unit(Q {
            x: (y.x + x.y) / s,
            y: 0.25 * s,
            z: (z.y + y.z) / s,
            w: (z.x - x.z) / s
        })
    }
    s: f32 = sqrtf(1.0 + z.z - x.x - y.y) * 2.0;
    q_unit(Q {
        x: (z.x + x.z) / s,
        y: (z.y + y.z) / s,
        z: 0.25 * s,
        w: (x.y - y.x) / s
    })
}

// A turn written as degrees about x, y, and z: made about y first, then z,
// then x.
q_degrees(d: V3): Q {
    k: f32 = PI / 180.0;
    q_mul(q_axis(v3(1.0, 0.0, 0.0), d.x * k), q_mul(q_axis(v3(0.0, 0.0, 1.0), d.z * k),
        q_axis(v3(0.0, 1.0, 0.0), d.y * k)))
}

// The same turn seen in a mirror across x.
q_mirror(q: Q): Q {
    Q {
        x: q.x,
        y: -q.y,
        z: -q.z,
        w: q.w
    }
}

// ---- poses, worked out ----
// For each pose and bone: its turn in its parent's frame, and its shift from
// where it rests. Two more follow the figure's own: the one shown, and the
// one being worked on.
const POSE_SLOTS: int = 34;

const SHOWN: int = 32;

const WORK: int = 33;

pq: []f32 = new f32[POSE_SLOTS * MAX_BONES * 4](0.0);

pt: []f32 = new f32[POSE_SLOTS * MAX_BONES * 3](0.0);

get_q(p: int, b: int): Q {
    i: int = (p * MAX_BONES + b) * 4;
    Q {
        x: pq[i],
        y: pq[i + 1],
        z: pq[i + 2],
        w: pq[i + 3]
    }
}

set_q(p: int, b: int, q: Q) {
    i: int = (p * MAX_BONES + b) * 4;
    pq[i] = q.x;
    pq[i + 1] = q.y;
    pq[i + 2] = q.z;
    pq[i + 3] = q.w
}

get_t(p: int, b: int): V3 {
    i: int = (p * MAX_BONES + b) * 3;
    v3(pt[i], pt[i + 1], pt[i + 2])
}

set_t(p: int, b: int, t: V3) {
    i: int = (p * MAX_BONES + b) * 3;
    pt[i] = t.x;
    pt[i + 1] = t.y;
    pt[i + 2] = t.z
}

// Where each bone is, posed: its turn and its joint's place.
world_q: []f32 = new f32[MAX_BONES * 4](0.0);

world_p: []f32 = new f32[MAX_BONES * 3](0.0);

wq(b: int): Q {
    Q {
        x: world_q[b * 4],
        y: world_q[b * 4 + 1],
        z: world_q[b * 4 + 2],
        w: world_q[b * 4 + 3]
    }
}

wp(b: int): V3 {
    v3(world_p[b * 3], world_p[b * 3 + 1], world_p[b * 3 + 2])
}

// Every bone's place in pose slot p, from the root out.
place_bones(p: int) {
    for b in 0..nbones {
        par: int = bone_parent[b];
        q: Q = get_q(p, b);
        at: V3 = v_add(bone_pos(b), get_t(p, b));
        if (par >= 0) {
            pw: Q = wq(par);
            at = v_add(wp(par), q_turn(pw, v_add(v_sub(bone_pos(b), bone_pos(par)),
                get_t(p, b))));
            q = q_unit(q_mul(pw, q))
        }
        world_q[b * 4] = q.x;
        world_q[b * 4 + 1] = q.y;
        world_q[b * 4 + 2] = q.z;
        world_q[b * 4 + 3] = q.w;
        world_p[b * 3] = at.x;
        world_p[b * 3 + 1] = at.y;
        world_p[b * 3 + 2] = at.z
    }
}

bend_deg: []f32 = new f32[MAX_BONES](0.0);

is_under(b: int, top: int): bool {
    while (b >= 0) {
        if (b == top) return true;
        b = bone_parent[b]
    }
    false
}

// A reach: turn the two bones above e so that e's joint comes to target,
// the middle joint bending toward the pole (or, with none, the way its
// hinge bends).
reach(
    e: int,
    target: V3,
    has_pole: bool,
    pole: V3
) {
    m: int = bone_parent[e];
    if (m < 0) return;
    u: int = bone_parent[m];
    if (u < 0) return;
    place_bones(WORK);
    top: int = bone_parent[u];
    frame: Q = q_ident();
    if (top >= 0) frame = wq(top);
    // At rest: the upper bone's way, the hinge square to it, and the way
    // the lower bone leaves it.
    a: V3 = v_norm(v_sub(bone_pos(m), bone_pos(u)));
    hinge: V3 = v3(bone_hinge[m * 3], bone_hinge[m * 3 + 1], bone_hinge[m * 3 + 2]);
    hinge = v_norm(v_reject(hinge, a));
    b: V3 = v_norm(v_sub(bone_pos(e), bone_pos(m)));
    rest_bend: f32 = atan2f(v_dot(v_cross(a, b), hinge), v_dot(a, b));
    l1: f32 = v_len(v_sub(bone_pos(m), bone_pos(u)));
    l2: f32 = v_len(v_sub(bone_pos(e), bone_pos(m)));
    from: V3 = wp(u);
    to: V3 = v_sub(target, from);
    d: f32 = clampf(v_len(to), absf(l1 - l2) + 0.001, l1 + l2 - 0.001);
    dir: V3 = v_norm(to);
    // The side the middle joint goes to.
    side: V3 = q_turn(frame, v_cross(a, hinge));
    if (has_pole) side = v_sub(pole, from);
    side = v_reject(side, dir);
    if (v_len(side) < 0.0001) side = v_reject(v3(0.0, 0.0, 1.0), dir);
    side = v_norm(side);
    cos_a: f32 = clampf((l1 * l1 + d * d - l2 * l2) / (2.0 * l1 * d), -1.0, 1.0);
    sin_a: f32 = sqrtf(maxf(1.0 - cos_a * cos_a, 0.0));
    a2: V3 = v_add(v_scale(dir, cos_a), v_scale(side, sin_a));
    h2: V3 = v_norm(v_cross(side, a2));
    // The upper bone: its rest frame carried to the new one.
    q_rest: Q = q_axes(a, hinge, v_cross(a, hinge));
    q_new: Q = q_axes(a2, h2, v_cross(a2, h2));
    world_u: Q = q_mul(q_new, q_conj(q_rest));
    set_q(WORK, u, q_unit(q_mul(q_conj(frame), world_u)));
    elbow: V3 = v_madd(from, a2, l1);
    b2: V3 = v_norm(v_sub(v_madd(from, dir, d), elbow));
    bend: f32 = atan2f(v_dot(v_cross(a2, b2), h2), v_dot(a2, b2));
    set_q(WORK, m, q_axis(hinge, bend - rest_bend))
}

// The layers each pose hides, as bits.
pose_hides: []int = new int[MAX_POSES](0);

// Bone b turned level: upright, facing the way its parent faces across the
// ground.
level(b: int) {
    par: int = bone_parent[b];
    if (par < 0) return;
    place_bones(WORK);
    pw: Q = wq(par);
    f: V3 = q_turn(pw, v3(0.0, 0.0, 1.0));
    // (A parent facing straight up or down: by its top instead.)
    if (f.x * f.x + f.z * f.z < 0.04) f = q_turn(pw, v3(0.0, -1.0, 0.0));
    want: Q = q_axis(v3(0.0, 1.0, 0.0), atan2f(f.x, f.z));
    set_q(WORK, b, q_unit(q_mul(q_conj(pw), want)))
}

// Pose p, worked out from its lines.
solve_pose(p: int) {
    for b in 0..nbones {
        set_q(WORK, b, q_ident());
        set_t(WORK, b, v3(0.0, 0.0, 0.0));
        bend_deg[b] = 0.0
    }
    first: int = pose_first[p];
    for e in first..first + pose_n[p] {
        k: int = pe_kind[e];
        b: int = pe_bone[e];
        a: V3 = v3(pe_f[e * 6], pe_f[e * 6 + 1], pe_f[e * 6 + 2]);
        if (k == DO_LIKE) {
            for i in 0..nbones {
                set_q(WORK, i, key_q(b, i, pe_pole[e]));
                set_t(WORK, i, key_shift(b, i, pe_pole[e]));
                bend_deg[i] = 0.0
            }
        } else if (k == DO_MOVE) set_t(WORK, b, v_add(get_t(WORK, b), a)) else if (k == DO_TURN) set_q(WORK,
            b, q_mul(q_degrees(a), get_q(WORK, b))) else if (k == DO_BEND) bend_deg[b] = bend_deg[b] + a.x else if (k == DO_CURL) {
            for i in 0..nbones {
                if (i != b && bone_hinged[i] && is_under(i, b)) bend_deg[i] = bend_deg[i] + a.x * 85.0
            }
        }
    }
    for b in 0..nbones {
        if (bend_deg[b] != 0.0) {
            hinge: V3 = v3(bone_hinge[b * 3], bone_hinge[b * 3 + 1], bone_hinge[b * 3 + 2]);
            set_q(WORK, b, q_mul(get_q(WORK, b), q_axis(hinge, bend_deg[b] * PI / 180.0)))
        }
    }
    for e in first..first + pose_n[p] {
        if (pe_kind[e] == DO_REACH) {
            target: V3 = v3(pe_f[e * 6], pe_f[e * 6 + 1], pe_f[e * 6 + 2]);
            pole: V3 = v3(pe_f[e * 6 + 3], pe_f[e * 6 + 4], pe_f[e * 6 + 5]);
            // Points that ride on a bone: carried from where they rest.
            on: int = pe_on[e];
            if (on >= 0) {
                place_bones(WORK);
                target = v_add(wp(on), q_turn(wq(on), v_sub(target, bone_pos(on))));
                pole = v_add(wp(on), q_turn(wq(on), v_sub(pole, bone_pos(on))))
            }
            reach(pe_bone[e], target, pe_pole[e], pole)
        }
        if (pe_kind[e] == DO_LEVEL) level(pe_bone[e])
    }
    hides: int = 0;
    for e in first..first + pose_n[p] {
        if (pe_kind[e] == DO_LIKE) hides = hides | pose_hides[pe_bone[e]];
        if (pe_kind[e] == DO_HIDE) hides = hides | 1 << pe_bone[e]
    }
    pose_hides[p] = hides;
    for b in 0..nbones {
        set_q(p, b, get_q(WORK, b));
        set_t(p, b, get_t(WORK, b))
    }
}

solve_poses() {
    for p in 0..nposes solve_pose(p);
    for b in 0..nbones {
        set_q(SHOWN, b, q_ident());
        set_t(SHOWN, b, v3(0.0, 0.0, 0.0))
    }
}

// Bone b's turn and shift in pose p, or in its mirror image.
key_q(p: int, b: int, mirror: bool): Q {
    if (mirror) return q_mirror(get_q(p, bone_twin[b]));
    get_q(p, b)
}

key_shift(p: int, b: int, mirror: bool): V3 {
    if (mirror) return flip_x(get_t(p, bone_twin[b]));
    get_t(p, b)
}

// The shown pose moved the share k of the way to pose p.
show_toward(p: int, k: f32) {
    for b in 0..nbones {
        a: Q = get_q(SHOWN, b);
        q: Q = get_q(p, b);
        if (a.x * q.x + a.y * q.y + a.z * q.z + a.w * q.w < 0.0) q = Q {
            x: -q.x,
            y: -q.y,
            z: -q.z,
            w: -q.w
        };
        set_q(SHOWN, b, q_unit(Q {
            x: lerpf(a.x, q.x, k),
            y: lerpf(a.y, q.y, k),
            z: lerpf(a.z, q.z, k),
            w: lerpf(a.w, q.w, k)
        }));
        set_t(SHOWN, b, v_lerp(get_t(SHOWN, b), get_t(p, b), k))
    }
}

curve_w: []f32 = new f32[4](0.0);

// Animation a at the share u of the way through its loop, into the work
// slot: a smooth curve through its keys' poses.
sample_anim(a: int, u: f32) {
    n: int = anim_n[a];
    first: int = anim_first[a];
    if (n == 0) return;
    // The key at or before u, and how far on toward the next.
    i: int = n - 1;
    for k in 0..n {
        if (key_t[first + k] <= u) i = k
    }
    t0: f32 = key_t[first + i];
    t1: f32 = key_t[first + (i + 1) % n];
    if (u < t0) t0 = t0 - 1.0;
    if (t1 <= t0) t1 = t1 + 1.0;
    s: f32 = clampf((u - t0) / maxf(t1 - t0, 0.0001), 0.0, 1.0);
    w: []f32 = curve_w;
    w[0] = (-s * s * s + 2.0 * s * s - s) * 0.5;
    w[1] = (3.0 * s * s * s - 5.0 * s * s + 2.0) * 0.5;
    w[2] = (-3.0 * s * s * s + 4.0 * s * s + s) * 0.5;
    w[3] = (s * s * s - s * s) * 0.5;
    for b in 0..nbones {
        base: Q = key_q(key_pose[first + i], b, key_mirror[first + i]);
        sum: Q = Q {
            x: 0.0,
            y: 0.0,
            z: 0.0,
            w: 0.0
        };
        shift: V3 = v3(0.0, 0.0, 0.0);
        for j in 0..4 {
            k: int = first + (i + j - 1 + n) % n;
            q: Q = key_q(key_pose[k], b, key_mirror[k]);
            f: f32 = w[j];
            if (base.x * q.x + base.y * q.y + base.z * q.z + base.w * q.w < 0.0) f = -f;
            sum = Q {
                x: sum.x + q.x * f,
                y: sum.y + q.y * f,
                z: sum.z + q.z * f,
                w: sum.w + q.w * f
            };
            shift = v_madd(shift, key_shift(key_pose[k], b, key_mirror[k]), w[j])
        }
        set_q(WORK, b, q_unit(sum));
        set_t(WORK, b, shift)
    }
}

// ---- matrices ----
// For each bone, what carries a vertex from where it rests to where the
// shown pose puts it; and how far up the whole figure is moved to stand on
// the ground.
bone_m: []f32 = new f32[MAX_BONES * 16](0.0);

lift: f32 = 0.0;

// Whether the figure is stood on the ground wherever its pose leaves it; or
// (going over the ground in a gait) is where its feet were put.
stood: bool = true;

pose_matrices() {
    place_bones(SHOWN);
    for b in 0..nbones {
        q: Q = wq(b);
        x: V3 = q_turn(q, v3(1.0, 0.0, 0.0));
        y: V3 = q_turn(q, v3(0.0, 1.0, 0.0));
        z: V3 = q_turn(q, v3(0.0, 0.0, 1.0));
        r: V3 = bone_pos(b);
        o: V3 = v_sub(wp(b), v_add(v_add(v_scale(x, r.x), v_scale(y, r.y)), v_scale(z,
            r.z)));
        m: int = b * 16;
        bone_m[m] = x.x;
        bone_m[m + 1] = x.y;
        bone_m[m + 2] = x.z;
        bone_m[m + 3] = 0.0;
        bone_m[m + 4] = y.x;
        bone_m[m + 5] = y.y;
        bone_m[m + 6] = y.z;
        bone_m[m + 7] = 0.0;
        bone_m[m + 8] = z.x;
        bone_m[m + 9] = z.y;
        bone_m[m + 10] = z.z;
        bone_m[m + 11] = 0.0;
        bone_m[m + 12] = o.x;
        bone_m[m + 13] = o.y;
        bone_m[m + 14] = o.z;
        bone_m[m + 15] = 1.0
    }
    // Stand it on the ground: its lowest probe at height 0.
    low: f32 = FAR;
    for b in 0..nbones {
        if (probe_set[b]) {
            m: int = b * 16;
            for k in 0..6 {
                q: int = b * 18 + k * 3;
                y: f32 = bone_m[m + 1] * probe[q] + bone_m[m + 5] * probe[q + 1] + bone_m[m + 9] * probe[q + 2] + bone_m[m + 13];
                low = minf(low, y)
            }
        }
    }
    if (low > FAR * 0.5 || !stood) low = 0.0;
    lift = -low;
    for b in 0..nbones bone_m[b * 16 + 13] = bone_m[b * 16 + 13] + lift
}
