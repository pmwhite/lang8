test "a take sets his limbs the way its frames say" {
    test_say("the text is right", read_running_back());
    solve_poses();
    test_count("takes", ntakes);
    test_count("frames in the first", take_n[0]);
    foot: int = gait_foot[take_gait[0]];
    shin: int = bone_parent[foot];
    thigh: int = bone_parent[shin];
    worst: f32 = 1.0;
    for f in 0..take_n[0] {
        take_pose(0, f as f32 / take_fps[0]);
        place_bones(SHOWN);
        worst = minf(worst, v_dot(v_norm(v_sub(wp(shin), wp(thigh))), take_dir(0,
            f as f32, 10)));
        worst = minf(worst, v_dot(v_norm(v_sub(wp(foot), wp(shin))), take_dir(0, f as f32,
            11)))
    }
    test_say("in every frame his left thigh and shin point within two degrees of where it says",
        worst > 0.9994);
    expect {|
        the text is right: yes
        takes: 34
        frames in the first: 62
        in every frame his left thigh and shin point within two degrees of where it says: yes
    |}
}

// Steer the route `play` by a script for some seconds, and say, for each
// step that is a cut's or turn's, and of every step how far a foot down
// slides: the most its lower end (heel or ball) moves while down.
steer_watch(name: str, seconds: f32) raises IoError {
    go_begin(route("play"));
    g: int = go_gait;
    foot: int = gait_foot[g];
    toe: int = gait_toe[g];
    slide: f32 = 0.0;
    was: []int = new int[2](-1);
    from: []f32 = new f32[6](0.0);
    heel_low: []bool = new bool[2](false);
    seen: int = -1;
    deepest: f32 = 0.0;
    lowest: f32 = 9.0;
    past: f32 = -9.0;
    write(1, name);
    write(1, "\n");
    // (For his balance: where his centre of mass and the middle of his foot
    // down were, the last 13 ticks.)
    hist: []f32 = new f32[13 * 6](0.0);
    hist_down: []bool = new bool[13](false);
    off_sum: f32 = 0.0;
    off_w: f32 = 0.0;
    twist_most: f32 = 0.0;
    off_most: f32 = 0.0;
    turned_at: f32 = -1.0;
    want_way: f32 = 0.0;
    if (script_n > 1) want_way = script_deg[1] * PI / 180.0;
    for tk in 0..(seconds / TICK) as int {
        go_tick();
        go_pose();
        place_bones(SHOWN);
        // The foot turned from the way its knee points (a knee is a hinge: the
        // shin twists only some 30-40 degrees, and only with the knee bent).
        for sd in 0..2 {
            fb: int = foot;
            if (sd == 1) fb = bone_twin[foot];
            kn: int = bone_parent[fb];
            hp: int = bone_parent[kn];
            th: V3 = v_sub(wp(kn), wp(hp));
            sh: V3 = v_sub(wp(fb), wp(kn));
            bend: f32 = atan2f(v_len(v_cross(th, sh)), v_dot(th, sh)) * 180.0 / PI;
            if (bend > 25.0) {
                // (The knee's hinge, and the foot's side to side, both as seen
                // across the shin: the shin's twist.)
                shin: V3 = v_norm(sh);
                hinge: V3 = v_norm(v_reject(v_cross(th, sh), shin));
                side: V3 = v_norm(v_reject(q_turn(wq(fb), v3(1.0, 0.0, 0.0)), shin));
                tw: f32 = atan2f(v_len(v_cross(hinge, side)), absf(v_dot(hinge, side))) * 180.0 / PI;
                twist_most = maxf(twist_most, tw)
            }
        }
        // How long, after the stick changes, until he goes the new way.
        if (script_n > 1 && turned_at < 0.0 && s_now > script_secs[0] && s_speed > 1.0 && absf(turn_from(heading_or(go_v,
            0.0), want_way)) < 10.0 * PI / 180.0) turned_at = s_now - script_secs[0];
        // His balance: while a foot is down, the line from it to his centre of
        // mass must lie along the push he is making, (a, g + a up) (or he would
        // topple); by how many degrees it does not.
        cm: V3 = body_com(g);
        cop: V3 = v3(0.0, 0.0, 0.0);
        nd: int = 0;
        for sd in 0..2 {
            if (down_step(sd) >= 0) {
                fb: int = foot;
                tb: int = toe;
                if (sd == 1) {
                    fb = bone_twin[foot];
                    tb = bone_twin[toe]
                }
                // (Its pressure under the lower of the heel and the ball.)
                a0: V3 = wp(fb);
                ft: V3 = v_norm(v_sub(wp(tb), a0));
                up: V3 = foot_up(ft);
                heel: V3 = v_add(a0, v_add(v_scale(ft, SOLE_HEEL_A), v_scale(up, SOLE_HEEL_U)));
                ball: V3 = wp(tb);
                pt: V3 = ball;
                if (heel.y < ball.y) pt = heel;
                cop = v_add(cop, pt);
                nd = nd + 1
            }
        }
        for k in 0..12 {
            for c in 0..6 hist[k * 6 + c] = hist[(k + 1) * 6 + c];
            hist_down[k] = hist_down[k + 1]
        }
        hist[72] = cm.x;
        hist[73] = cm.y;
        hist[74] = cm.z;
        if (nd > 0) {
            cop = v_scale(cop, 1.0 / nd as f32);
            hist[75] = cop.x;
            hist[76] = cop.y;
            hist[77] = cop.z
        }
        hist_down[12] = nd == 1 && st_kind[s_cur % NST] != K_STAND;
        if (tk > 12 && hist_down[6] && hist_down[0] && hist_down[12]) {
            dt: f32 = 6.0 * TICK;
            a: V3 = v_scale(v3(hist[72] - 2.0 * hist[36] + hist[0], hist[73] - 2.0 * hist[37] + hist[1],
                hist[74] - 2.0 * hist[38] + hist[2]), 1.0 / (dt * dt));
            need: V3 = v_norm(v3(a.x, a.y + 9.81, a.z));
            have: V3 = v_norm(v3(hist[36] - hist[39], hist[37] - hist[40], hist[38] - hist[41]));
            off: f32 = atan2f(v_len(v_cross(need, have)), v_dot(need, have)) * 180.0 / PI;
            // (Weighed by how hard the foot pushes then: a half sine over its
            // time down, so a lean as it lands or leaves, carrying little,
            // counts little.)
            ws: f32 = 0.0;
            for sd in 0..2 {
                j: int = down_step(sd);
                if (j >= 0) ws = sinf(PI * clampf((s_now - 6.0 * TICK - st_t[j]) / maxf(st_tc[j],
                    0.01), 0.0, 1.0))
            }
            off_sum = off_sum + off * ws;
            off_w = off_w + ws;
            if (ws > 0.5) off_most = maxf(off_most, off)
        }
        for sd in 0..2 {
            fb: int = foot;
            tb: int = toe;
            if (sd == 1) {
                fb = bone_twin[foot];
                tb = bone_twin[toe]
            }
            j: int = down_step(sd);
            // (The lower of the heel's bottom and the ball, the sole's ends.)
            a: V3 = wp(fb);
            ft: V3 = v_norm(v_sub(wp(tb), a));
            up: V3 = foot_up(ft);
            heel: V3 = v_add(a, v_add(v_scale(ft, SOLE_HEEL_A), v_scale(up, SOLE_HEEL_U)));
            ball: V3 = wp(tb);
            low: bool = heel.y < ball.y;
            pt: V3 = ball;
            if (low) pt = heel;
            // (Only while that end is on the ground: the ball rises as the toes
            // bend, leaving.)
            on: bool = pt.y < 0.02;
            if (j >= 0 && j == was[sd] && low == heel_low[sd] && on) {
                d: V3 = v_sub(pt, getv(from, sd));
                slide = maxf(slide, sqrtf(d.x * d.x + d.z * d.z))
            } else putv(from, sd, pt);
            heel_low[sd] = low;
            was[sd] = j
        }
        // A cut's or turn's plant: the knee at its deepest, the hips at their
        // lowest, and the way he faces as it ends.
        i: int = s_cur % NST;
        k: int = st_kind[i];
        if (k == K_PLANT || k == K_CROSS || k == K_PIVOT) {
            if (seen != s_cur) {
                seen = s_cur;
                deepest = 0.0;
                lowest = 9.0;
                past = -9.0
            }
            sd: int = st_side[i];
            fb: int = foot;
            if (sd == 1) fb = bone_twin[foot];
            kb: int = bone_parent[fb];
            hb: int = bone_parent[kb];
            th: V3 = v_sub(wp(kb), wp(hb));
            sh: V3 = v_sub(wp(fb), wp(kb));
            deepest = maxf(deepest, atan2f(v_len(v_cross(th, sh)), v_dot(th, sh)) * 180.0 / PI);
            lowest = minf(lowest, wp(gait_root[g]).y);
            // (How far his body carries on past the plant foot, the way he came.)
            h0: f32 = heading_or(getv(st_vin, i), 0.0);
            past = maxf(past, v_dot(v_sub(body_com(g), getv(st_spot, i)), ahead(h0)));
            if (s_now + TICK >= st_t[i] + st_tc[i] && s_now < st_t[i] + st_tc[i]) {
                if (k == K_PLANT) write(1, "  a plant") else if (k == K_CROSS) write(1,
                    "  a crossover") else write(1, "  a pivot");
                write(1, ": in at, tenths of a m/s ");
                write_int(1, (v_len(getv(st_vin, i)) * 10.0 + 0.5) as int);
                write(1, ", out at ");
                write_int(1, (v_len(getv(st_vout, i)) * 10.0 + 0.5) as int);
                write(1, "; knee bent to ");
                write_int(1, (deepest + 0.5) as int);
                write(1, "; hips down to, cm ");
                write_int(1, (lowest * 100.0 + 0.5) as int);
                write(1, "; past the foot, cm ");
                write_int(1, (past * 100.0 + 0.5) as int);
                write(1, "; facing, degrees ");
                write_int(1, (s_face * 180.0 / PI + 0.5) as int);
                write(1, "\n")
            }
        }
    }
    test_count("  a foot down slides at most, in centimetres", (slide * 100.0 + 0.5) as int);
    test_count("  a foot turned from its knee, at most, in degrees", (twist_most + 0.5) as int);
    test_count("  off balance, on average, in degrees", (off_sum / maxf(off_w, 0.001) + 0.5) as int);
    test_count("  and at most, while it pushes hard", (off_most + 0.5) as int);
    if (script_n > 1) test_count("  going the new way, in hundredths of a second after the stick",
        (turned_at * 100.0 + 0.5) as int);
    test_count("  he ends up heading, in degrees", (heading_or(go_v, s_face) * 180.0 / PI + 0.5) as int);
    test_count("  at, in tenths of a m/s", (v_len(go_v) * 10.0 + 0.5) as int)
}

test "steering takes him where the stick says, cutting and turning as he must" {
    test_say("the text is right", read_running_back());
    solve_poses();
    script_n = 0;
    add_script(2.5, 0.0, 9.5);
    add_script(2.5, 30.0, 9.5);
    steer_watch("an arc", 5.0);
    script_n = 0;
    add_script(2.5, 0.0, 7.0);
    add_script(2.5, 45.0, 7.0);
    steer_watch("a cut of 45 degrees", 5.0);
    script_n = 0;
    add_script(2.5, 0.0, 9.5);
    add_script(3.0, 90.0, 9.5);
    steer_watch("a cut of 90 degrees", 5.5);
    script_n = 0;
    add_script(2.5, 0.0, 9.5);
    add_script(3.5, 180.0, 9.5);
    steer_watch("right round", 6.0);
    script_n = 0;
    add_script(2.5, 0.0, 9.5);
    add_script(2.5, 0.0, 0.0);
    steer_watch("a stop", 5.0);
    expect {|
        the text is right: yes
        an arc
          a foot down slides at most, in centimetres: 11
          a foot turned from its knee, at most, in degrees: 56
          off balance, on average, in degrees: 13
          and at most, while it pushes hard: 47
          going the new way, in hundredths of a second after the stick: 127
          he ends up heading, in degrees: 30
          at, in tenths of a m/s: 90
        a cut of 45 degrees
          a foot down slides at most, in centimetres: 8
          a foot turned from its knee, at most, in degrees: 23
          off balance, on average, in degrees: 12
          and at most, while it pushes hard: 57
          going the new way, in hundredths of a second after the stick: 143
          he ends up heading, in degrees: 45
          at, in tenths of a m/s: 60
        a cut of 90 degrees
          a plant: in at, tenths of a m/s 38, out at 33; knee bent to 88; hips down to, cm 61; past the foot, cm -2; facing, degrees 88
          a foot down slides at most, in centimetres: 17
          a foot turned from its knee, at most, in degrees: 40
          off balance, on average, in degrees: 14
          and at most, while it pushes hard: 47
          going the new way, in hundredths of a second after the stick: 163
          he ends up heading, in degrees: 90
          at, in tenths of a m/s: 75
        right round
          a foot down slides at most, in centimetres: 8
          a foot turned from its knee, at most, in degrees: 38
          off balance, on average, in degrees: 14
          and at most, while it pushes hard: 47
          going the new way, in hundredths of a second after the stick: 174
          he ends up heading, in degrees: -179
          at, in tenths of a m/s: 70
        a stop
          a plant: in at, tenths of a m/s 11, out at 1; knee bent to 6; hips down to, cm 87; past the foot, cm -27; facing, degrees 1
          a foot down slides at most, in centimetres: 7
          a foot turned from its knee, at most, in degrees: 20
          off balance, on average, in degrees: 12
          and at most, while it pushes hard: 47
          going the new way, in hundredths of a second after the stick: 0
          he ends up heading, in degrees: 2
          at, in tenths of a m/s: 0
    |}
}
