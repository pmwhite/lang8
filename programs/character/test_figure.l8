tag character_tests;

use_tag std;

use_tag skate, character;

import "../../stdlib/print.l8";

import "../skate/math.l8";

import "figure.l8";

import "field.l8";

import "bake.l8";

import "pose.l8";

import "gait.l8";

import "drive.l8";

import "steer.l8";

import "take.l8";

import "match.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

// Layer l's mesh, all at once.
bake_layer(l: int) {
    begin_layer(l);
    _done: bool = work_layer(0)
}

test_say(label: str, yes: bool) raises IoError {
    write(1, label);
    if (yes) write(1, ": yes\n") else write(1, ": no\n")
}

test_count(label: str, n: int) raises IoError {
    write(1, label);
    write(1, ": ");
    write_int(1, n);
    write(1, "\n")
}

// A trunk, an arm on each side, and a ball of skin with a shirt over it.
SMALL: str = """
figure Small
cell 0.01
material skin 0.8 0.6 0.5 skin
material shirt 0.1 0.2 0.6 cloth
bone trunk - 0 1 0
bone arm.l trunk 0.2 1.4 0
bone fore.l arm.l 0.5 1.4 0 hinge 0 1 0
bone hand.l fore.l 0.8 1.4 0
layer body skin
  part trunk
    ball trunk 0 1 0 0.1
  part arms
    cone arm.l 0.2 1.4 0 0.04  0.5 1.4 0 0.03
    cone fore.l 0.5 1.4 0 0.03  0.8 1.4 0 0.025
layer shirt_zone skin hidden
  box trunk 0 1 0  0.2 0.2 0.2
layer shirt shirt
  grow body 0.005
  clip shirt_zone
pose rest
pose reach_up
  reach hand.l 0.4 1.8 0.2
pose both_up
  reach hand 0.4 1.8 0.2
pose other_way
  like reach_up mirror
""";

read_small() noregion: bool {
    read_figure(bytes(SMALL))
}

test "a figure's text is read" {
    test_say("the text is right", read_small());
    test_count("bones, with the right side's", nbones);
    test_count("layers", nlayers);
    test_count("the body's shapes, with the right arm's", layer_nops[0]);
    test_count("parts", nparts);
    test_count("poses", nposes);
    test_say("the right forearm hangs from the right arm", bone_parent[bone("fore.r")] == bone("arm.r"));
    test_say("and rests across from the left", bone_rest[bone("fore.r") * 3] == -0.5);
    expect {|
        the text is right: yes
        bones, with the right side's: 7
        layers: 3
        the body's shapes, with the right arm's: 5
        parts: 3
        poses: 4
        the right forearm hangs from the right arm: yes
        and rests across from the left: yes
    |}
}

test "what is wrong with a text is said, with its line" {
    ok: bool = read_figure(bytes("""
figure Wrong
material skin 1 1 1
bone root - 0 1 0
layer body skin
  ball elbow 0 1 0 0.1
"""));
    test_say("the text is right", ok);
    test_count(err_msg, err_line);
    expect {|
        the text is right: no
        no such bone: 5
    |}
}

bone(name: str): int {
    find_in(bone_name, nbones, intern(bytes(name), 0, len(name)))
}

near(a: V3, b: V3): bool {
    v_len(v_sub(a, b)) < 0.002
}

test "a reach brings a hand to its point" {
    test_say("the text is right", read_small());
    solve_poses();
    place_bones(1);
    hand: int = bone("hand.l");
    test_say("the left hand is at its point", near(wp(hand), v3(0.4, 1.8, 0.2)));
    test_say("the right hand is where it rests", near(wp(bone_twin[hand]), v3(-0.8,
        1.4, 0.0)));
    test_say("the forearm is as long as it was", absf(v_len(v_sub(wp(hand), wp(bone("fore.l")))) - 0.3) < 0.002);
    place_bones(2);
    test_say("named without a side, both hands reach", near(wp(hand), v3(0.4, 1.8,
        0.2)) && near(wp(bone_twin[hand]), v3(-0.4, 1.8, 0.2)));
    place_bones(3);
    test_say("mirrored, the right hand reaches and the left rests", near(wp(bone_twin[hand]),
        v3(-0.4, 1.8, 0.2)) && near(wp(hand), v3(0.8, 1.4, 0.0)));
    expect {|
        the text is right: yes
        the left hand is at its point: yes
        the right hand is where it rests: yes
        the forearm is as long as it was: yes
        named without a side, both hands reach: yes
        mirrored, the right hand reaches and the left rests: yes
    |}
}

test "shapes bake to a closed mesh on their surface" {
    test_say("the text is right", read_small());
    bake_begin();
    for l in 0..nlayers bake_layer(l);
    test_say("the body has a mesh", layer_vn[0] > 500);
    // (Corners, less edges, plus faces is 2 for a closed surface: so
    // corners less half the triangles is 2 for each, and here are three,
    // the trunk and two arms.)
    test_count("its corners less half its triangles", layer_vn[0] - layer_tn[0] / 2);
    worst: f32 = 0.0;
    covered: int = 0;
    trunk: int = 0;
    for v in layer_v0[0]..layer_v0[0] + layer_vn[0] {
        p: V3 = vert_pos(v);
        if (p.x > -0.09 && p.x < 0.09 && p.y < 1.09) {
            trunk = trunk + 1;
            worst = maxf(worst, absf(v_len(v_sub(p, v3(0.0, 1.0, 0.0))) - 0.1));
            if ((vcover[v] >> 2 & 1) == 1) covered = covered + 1
        }
    }
    test_say("the trunk's are within a tenth of a millimetre of its ball", worst < 0.0001);
    test_say("and all under the shirt", covered == trunk);
    ends: f32 = 1.0;
    elbow: f32 = 1.0;
    for v in layer_v0[0]..layer_v0[0] + layer_vn[0] {
        at: int = v * VERT_FLOATS;
        if (absf(verts[at]) > 0.7) ends = minf(ends, verts[at + V_WEIGHTS]);
        if (absf(verts[at]) > 0.49 && absf(verts[at]) < 0.51) elbow = minf(elbow,
            verts[at + V_WEIGHTS])
    }
    test_say("each forearm's end moves with its one bone", ends == 1.0);
    test_say("and at the elbows two bones share the skin", elbow < 0.6);
    grown: f32 = 0.0;
    for v in layer_v0[2]..layer_v0[2] + layer_vn[2] {
        p: V3 = vert_pos(v);
        r: f32 = v_len(v_sub(p, v3(0.0, 1.0, 0.0)));
        if (p.y < 1.05 && absf(p.x) < 0.05) grown = maxf(grown, absf(r - 0.105))
    }
    test_say("the shirt lies five millimetres over the trunk", layer_vn[2] > 0 && grown < 0.0002);
    expect {|
        the text is right: yes
        the body has a mesh: yes
        its corners less half its triangles: 6
        the trunk's are within a tenth of a millimetre of its ball: yes
        and all under the shirt: yes
        each forearm's end moves with its one bone: yes
        and at the elbows two bones share the skin: yes
        the shirt lies five millimetres over the trunk: yes
    |}
}

test "the running back reads, and every layer of him bakes" {
    ok: bool = read_running_back();
    test_say("the text is right", ok);
    if (!ok) test_count(err_msg, err_line);
    solve_poses();
    // (Coarsely: this is about the text, not the mesh.)
    detail = 3.0;
    bake_begin();
    empty: int = 0;
    for l in 0..nlayers {
        bake_layer(l);
        if (!layer_hidden[l] && layer_tn[l] == 0) empty = empty + 1
    }
    detail = 1.0;
    test_count("layers with no mesh", empty);
    place_bones(find_in(pose_name, nposes, twin_name(intern(bytes("stance"), 0, 6))));
    feet: f32 = absf(wp(find_in(bone_name, nbones, intern(bytes("foot.l"), 0, 6))).y - wp(find_in(bone_name,
        nbones, intern(bytes("foot.r"), 0, 6))).y);
    test_say("in his stance his feet are level with each other", feet < 0.001);
    expect {|
        the text is right: yes
        layers with no mesh: 0
        in his stance his feet are level with each other: yes
    |}
}

// A file's bytes, appended to `into` from `at` (with a line break first);
// how far it then reaches.
append_file(path: str, into: []i8, at: int): int {
    fd: int = open(path, 0, 0);
    if (fd < 0) return at;
    into[at] = '\n';
    n: int = at + 1;
    r: int = 1;
    while (r > 0 && n < len(into)) {
        r = read(fd, into, n, len(into) - n);
        if (r > 0) n = n + r
    }
    close(fd);
    n
}

// The running back, with the motion files it uses (as the viewer reads
// them, after it).
read_running_back() noregion: bool {
    buf: []i8 = new i8[4000000](0i8);
    n: int = append_file("programs/character/running-back.txt", buf, 0);
    n = append_file("programs/character/motion/run-synth.txt", buf, n);
    n = append_file("programs/character/motion/moves.txt", buf, n);
    n = append_file("programs/character/motion/cycles.txt", buf, n);
    n = append_file("programs/character/motion/steering.txt", buf, n);
    text: []i8 = new i8[n](0i8);
    memcpy(text, 0, buf, 0, n);
    read_figure(text)
}

route(name: str): int {
    find_in(route_name, nroutes, intern(bytes(name), 0, len(name)))
}

seen_at: []f32 = new f32[MAX_BONES * 3](0.0);

// Run a route for some seconds, and say what was seen of it.
// The joint (other than the fingers) that moved fastest last, and where.
fastest_bone: int = 0;

// Run a route for some seconds, and say what was seen of it.
watch(name: str, seconds: f32) raises IoError {
    r: int = route(name);
    go_begin(r);
    g: int = go_gait;
    foot: int = gait_foot[g];
    slowest: f32 = 99.0;
    fastest: f32 = 0.0;
    jump: f32 = 0.0;
    slip: f32 = 0.0;
    pinned: int = 0;
    flying: int = 0;
    lowest: f32 = 9.0;
    highest: f32 = 0.0;
    changes: int = 0;
    ankle_least: f32 = 999.0;
    ankle_most: f32 = 0.0;
    over: int = 0;
    width_sum: f32 = 0.0;
    // All planes, measured on the posed figure: knee in from the hip-ankle line (cm, + toward his
    // middle) while a foot is pinned; the hips' turn and tilt across, and the trunk's lean.
    knee_in: f32 = 0.0;
    knee_n: int = 0;
    rot_lo: f32 = 99.0;
    rot_hi: f32 = -99.0;
    obl_lo: f32 = 99.0;
    obl_hi: f32 = -99.0;
    lean_sum: f32 = 0.0;
    lean_n: int = 0;
    thigh_hi: f32 = -99.0;
    fold_hi: f32 = 0.0;
    lands: int = 0;
    widths: int = 0;
    was_locked: []bool = new bool[2](false);
    was_take: int = mm_take;
    for t in 0..(seconds / TICK) as int {
        go_tick();
        go_pose();
        place_bones(SHOWN);
        if (mm_take != was_take) changes = changes + 1;
        was_take = mm_take;
        // (Once he is under way.)
        if (t > 120) {
            slowest = minf(slowest, v_len(go_v));
            fastest = maxf(fastest, v_len(go_v));
            if (!locked[0] && !locked[1]) flying = flying + 1;
            for f in 0..2 {
                fb: int = foot;
                if (f == 1) fb = bone_twin[foot];
                if (locked[f]) {
                    pinned = pinned + 1;
                    slip = maxf(slip, v_len(v_sub(wp(fb), getv(lock_at, f))))
                }
            }
            for f in 0..2 {
                fb: int = foot;
                if (f == 1) fb = bone_twin[foot];
                up_shin: V3 = v_norm(v_sub(wp(bone_parent[fb]), wp(fb)));
                toe: V3 = q_turn(wq(fb), v3(0.0, 0.0, 1.0));
                sole_up: V3 = q_turn(wq(fb), v3(0.0, 1.0, 0.0));
                a: f32 = atan2f(v_len(v_cross(up_shin, toe)), v_dot(up_shin, toe)) * 180.0 / PI;
                ankle_least = minf(ankle_least, a);
                ankle_most = maxf(ankle_most, a);
                // (Turned over on the leg: its top facing down the shin, which no ankle does.)
                if (v_dot(sole_up, up_shin) < -0.2) over = over + 1
            }
            way: V3 = v_norm(v3(go_v.x, 0.0, go_v.z));
            across: V3 = v_cross(v3(0.0, 1.0, 0.0), way);
            hl: V3 = q_turn(wq(gait_root[g]), v3(1.0, 0.0, 0.0));
            turn_deg: f32 = atan2f(-v_dot(hl, way), v_dot(hl, across)) * 180.0 / PI;
            tilt_deg: f32 = asinf_(clampf(hl.y, -1.0, 1.0)) * 180.0 / PI;
            if (t > 360) {
                rot_lo = minf(rot_lo, turn_deg);
                rot_hi = maxf(rot_hi, turn_deg);
                obl_lo = minf(obl_lo, tilt_deg);
                obl_hi = maxf(obl_hi, tilt_deg);
                cu: V3 = q_turn(wq(bone_parent[gait_head[g]]), v3(0.0, 1.0, 0.0));
                lean_sum = lean_sum + atan2f(v_dot(cu, way), cu.y) * 180.0 / PI;
                lean_n = lean_n + 1
            }
            for f in 0..2 {
                fb: int = foot;
                if (f == 1) fb = bone_twin[foot];
                kb: int = bone_parent[fb];
                hb: int = bone_parent[kb];
                th: V3 = v_sub(wp(kb), wp(hb));
                if (t > 360) {
                    thigh_hi = maxf(thigh_hi, atan2f(v_dot(th, way), -th.y) * 180.0 / PI);
                    sh: V3 = v_sub(wp(fb), wp(kb));
                    fold_hi = maxf(fold_hi, atan2f(v_len(v_cross(th, sh)), v_dot(th,
                        sh)) * 180.0 / PI)
                }
                if (locked[f]) {
                    side: f32 = 1.0 - 2.0 * f as f32;
                    a: V3 = wp(hb);
                    b: V3 = wp(fb);
                    u: f32 = (wp(kb).y - a.y) / minf(b.y - a.y, -0.01);
                    line: f32 = v_dot(v_lerp(a, b, u), across);
                    knee_in = knee_in + (line - v_dot(wp(kb), across)) * side;
                    knee_n = knee_n + 1
                }
            }
            for f in 0..2 {
                if (locked[f] && !was_locked[f]) lands = lands + 1;
                if (locked[f] && !was_locked[f]) {
                    side: f32 = 1.0 - 2.0 * f as f32;
                    hips_left: V3 = q_turn(wq(gait_root[g]), v3(1.0, 0.0, 0.0));
                    width_sum = width_sum + v_dot(v_sub(getv(lock_at, f), wp(gait_root[g])),
                        hips_left) * side;
                    widths = widths + 1
                }
                was_locked[f] = locked[f]
            }
            lowest = minf(lowest, wp(gait_root[g]).y);
            highest = maxf(highest, wp(gait_root[g]).y);
            for b in 0..nbones {
                if (!is_finger(b)) {
                    rb: int = gait_root[g];
                    moved: V3 = v_sub(wp(b), v3(seen_at[b * 3], seen_at[b * 3 + 1],
                        seen_at[b * 3 + 2]));
                    hips: V3 = v_sub(wp(rb), v3(seen_at[rb * 3], seen_at[rb * 3 + 1],
                        seen_at[rb * 3 + 2]));
                    d: f32 = v_len(v_sub(moved, hips));
                    if (d > jump) {
                        jump = d;
                        fastest_bone = b
                    }
                }
            }
        }
        for b in 0..nbones {
            seen_at[b * 3] = wp(b).x;
            seen_at[b * 3 + 1] = wp(b).y;
            seen_at[b * 3 + 2] = wp(b).z
        }
    }
    write(1, name);
    write(1, "\n");
    test_count("  slowest, in tenths of a metre a second", (slowest * 10.0 + 0.5) as int);
    test_count("  fastest", (fastest * 10.0 + 0.5) as int);
    test_count("  clips it went over to, a second", (changes as f32 / (seconds - 1.0)) as int);
    test_count("  a pinned foot slips from where it came down, at most, in millimetres",
        (slip * 1000.0 + 0.5) as int);
    test_count("  of a hundred moments, a foot is pinned for", pinned * 50 / maxi((seconds / TICK) as int - 121,
        1));
    test_say("  both feet are off the ground for part of the time", flying > 0);
    test_count("  the fastest a joint moves past his hips, metres a second (a real runner's feet reach about 15)",
        (jump / TICK + 0.5) as int);
    test_count("  the ankle bends between, in degrees from up the shin", (ankle_least + 0.5) as int);
    test_count("  and", (ankle_most + 0.5) as int);
    test_count("  moments a foot is turned over on its shin", over);
    test_count("  feet land, on average, this many centimetres to their side of his middle",
        (width_sum * 100.0 / maxf(widths as f32, 1.0) + 0.5) as int);
    test_count("  steps a second", (lands as f32 / (seconds - 1.0) + 0.5) as int);
    test_count("  his knees are in from the line hip to ankle, in millimetres, while the foot is down",
        (knee_in * 1000.0 / maxf(knee_n as f32, 1.0)) as int);
    test_count("  his hips turn through, in degrees", (rot_hi - rot_lo + 0.5) as int);
    test_count("  and tilt across through", (obl_hi - obl_lo + 0.5) as int);
    test_count("  his trunk leans forward, on average, in degrees", (lean_sum / maxf(lean_n as f32,
        1.0) + 0.5) as int);
    test_count("  his thigh comes up to, in degrees from straight down", (thigh_hi + 0.5) as int);
    test_count("  his knee folds to", (fold_hi + 0.5) as int);
    test_count("  his hips are never lower than, in centimetres", (lowest * 100.0) as int);
    test_count("  nor higher than", (highest * 100.0 + 0.99) as int)
}

asinf_(x: f32): f32 {
    atan2f(x, sqrtf(maxf(1.0 - x * x, 0.0)))
}

// Whether bone b is a finger: below a hand, and not the hand.
is_finger(b: int): bool {
    p: int = bone_parent[b];
    p >= 0 && bone_parent[p] >= 0 && name_len[bone_name[p]] > 0 && (name_starts(p,
        "hand") || name_starts(bone_parent[p], "hand"))
}

name_starts(b: int, s: str): bool {
    id: int = bone_name[b];
    if (name_len[id] < len(s)) return false;
    for i in 0..len(s) {
        if (name_pool[name_at[id] + i] != s[i]) return false
    }
    true
}

