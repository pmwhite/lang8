tag character;

use_tag skate;

// Words over the picture, for the viewer without a page round it: in a
// blocky 5x7 pixel font, each pixel a little square. They are flat shapes
// (see render.l8) in window pixels from the top left.

// Each glyph is 35 bits, 7 rows of 5, the top row highest; by character
// code from 32. Small letters are written as capitals.
font: []int = [0, 0, 0, 0, 0, 27684643443, 0, 0, 2290360450, 8726317192, 156718208,
    139432064, 6280, 1015808, 396, 1109533200, 15623448110, 4701950094, 15603929375,
    33357366830, 2359917634, 33854359086, 6728664622, 33321787656, 15621113390, 15621129292,
    138416256, 0, 0, 32537600, 8726284424, 0, 0, 15621670449, 32801506878, 15620129326,
    32801080894, 33840644639, 33840644624, 15620359727, 18842895921, 15170932878,
    7585466956, 18879369809, 17734058527, 19182306865, 18850958897, 15621211694, 32801505808,
    15621215821, 32801509969, 16660235326, 33424543876, 18842437166, 18842436932,
    18842572458, 18834663985, 18834657412, 33321787935, 0, 0, 0, 0, 31, 0];

hud_px: f32 = 2.0;

text_buf: []i8 = new i8[256](0i8);

text_len: int = 0;

glyph(c: i8): int {
    k: int = c as int;
    if (k >= 97 && k <= 122) k = k - 32;
    if (k < 32 || k > 96) return 0;
    font[k - 32]
}

put_px(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    c: V3,
    a: f32
) {
    put_flat(v3(x, y, 0.0), c, a);
    put_flat(v3(x + w, y, 0.0), c, a);
    put_flat(v3(x + w, y + h, 0.0), c, a);
    put_flat(v3(x, y, 0.0), c, a);
    put_flat(v3(x + w, y + h, 0.0), c, a);
    put_flat(v3(x, y + h, 0.0), c, a)
}

// The text in text_buf at (x, y), its top left, with a dark edge under it.
put_text(
    x: f32,
    y: f32,
    c: V3,
    a: f32
) {
    for pass in 0..2 {
        for i in 0..text_len {
            bits: int = glyph(text_buf[i]);
            for row in 0..7 {
                for col in 0..5 {
                    if ((bits >> (6 - row) * 5 + (4 - col) & 1) == 1) {
                        px: f32 = x + (i * 6 + col) as f32 * hud_px;
                        py: f32 = y + row as f32 * hud_px;
                        if (pass == 0) put_px(px - 1.0, py - 1.0, hud_px + 2.0, hud_px + 2.0,
                            v3(0.08, 0.09, 0.12), a * 0.55) else put_px(px, py, hud_px,
                            hud_px, c, a)
                    }
                }
            }
        }
    }
}

text_width(): f32 {
    (text_len * 6 - 1) as f32 * hud_px
}

say(s: str) {
    for c in s {
        if (text_len < len(text_buf)) {
            text_buf[text_len] = c;
            text_len = text_len + 1
        }
    }
}

say_int(n: int) {
    if (n < 0) {
        say("-");
        n = -n
    }
    if (n >= 10) say_int(n / 10);
    if (text_len < len(text_buf)) {
        text_buf[text_len] = (n % 10 + 48) trunc i8;
        text_len = text_len + 1
    }
}

say_name(id: int) {
    for i in 0..name_len[id] {
        if (text_len < len(text_buf)) {
            text_buf[text_len] = name_pool[name_at[id] + i];
            text_len = text_len + 1
        }
    }
}

// The matrix that takes window pixels to the screen.
hud_m: []f32 = new f32[16](0.0);

hud_matrix() {
    mat_ortho(hud_m, 0.0, screen_w as f32, screen_h as f32, 0.0, -1.0, 1.0)
}
