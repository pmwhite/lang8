tag character;

use_tag skate;

// Steering: a route that is `steered` goes where the viewer's stick says,
// not along points (how he does it is steer.l8's). This is the stick: keys,
// a finger, or a script for tests and pictures.
// ---- the stick ----
// Which way, on the screen (x to the right, y away from the camera), and how
// far over, 0 to 1.
stick_x: f32 = 0.0;

stick_y: f32 = 0.0;

// Keys held: ahead, left, back, right (W A S D, or the arrows while
// steering); and Shift, to jog rather than run flat out.
keys_held: []bool = new bool[4](false);

jog_held: bool = false;

// A finger on the stick: which, and where it went down, in window pixels.
stick_finger: int = -1;

stick_ox: f32 = 0.0;

stick_oy: f32 = 0.0;

// The stick's reach on the screen, in window pixels (the viewer sets it
// from the window's size).
stick_px: f32 = 60.0;

stick_reach(): f32 {
    stick_px
}

// What the stick asks for: a way over the ground, as the camera looks, and
// a speed.
stick_way(cam: f32): V3 {
    x: f32 = stick_x;
    y: f32 = stick_y;
    if (stick_finger < 0) {
        x = 0.0;
        y = 0.0;
        if (keys_held[0]) y = y + 1.0;
        if (keys_held[2]) y = y - 1.0;
        if (keys_held[1]) x = x - 1.0;
        if (keys_held[3]) x = x + 1.0
    }
    l: f32 = sqrtf(x * x + y * y);
    if (l < 0.15) return v3(0.0, 0.0, 0.0);
    x = x / l;
    y = y / l;
    // (Away from the camera is the way it looks over the ground.)
    fwd: V3 = v3(-sinf(cam), 0.0, -cosf(cam));
    rt: V3 = v3(cosf(cam), 0.0, -sinf(cam));
    v_add(v_scale(fwd, y), v_scale(rt, x))
}

stick_speed(): f32 {
    if (stick_finger >= 0) {
        l: f32 = minf(sqrtf(stick_x * stick_x + stick_y * stick_y), 1.0);
        if (l < 0.15) return 0.0;
        // (Half over: a jog; right over: flat out.)
        if (l < 0.6) return 3.5;
        return lerpf(3.5, S_TOP, smoothstepf(0.6, 0.95, l))
    }
    any: bool = keys_held[0] || keys_held[1] || keys_held[2] || keys_held[3];
    if (!any) return 0.0;
    if (jog_held) return 3.5;
    S_TOP
}

// A key, down or up; true if steering took it.
steer_key(ks: int, down: bool): bool {
    k: int = -1;
    if (ks == 119 || ks == 65362) k = 0;
    if (ks == 97 || ks == 65361) k = 1;
    if (ks == 115 || ks == 65364) k = 2;
    if (ks == 100 || ks == 65363) k = 3;
    if (ks == 65505 || ks == 65506) {
        jog_held = down;
        return true
    }
    if (k < 0) return false;
    keys_held[k] = down;
    true
}

steer_finger_down(b: int, x: f32, y: f32) {
    stick_finger = b;
    stick_ox = x;
    stick_oy = y;
    stick_x = 0.0;
    stick_y = 0.0
}

steer_finger_move(x: f32, y: f32) {
    r: f32 = stick_reach();
    dx: f32 = (x - stick_ox) / r;
    dy: f32 = (stick_oy - y) / r;
    l: f32 = sqrtf(dx * dx + dy * dy);
    // (Past its reach, the stick's middle follows the finger.)
    if (l > 1.0) {
        stick_ox = stick_ox + (dx - dx / l) * r;
        stick_oy = stick_oy - (dy - dy / l) * r;
        dx = dx / l;
        dy = dy / l
    }
    stick_x = dx;
    stick_y = dy
}

steer_finger_up() {
    stick_finger = -1;
    stick_x = 0.0;
    stick_y = 0.0
}

// ---- steering a route ----
steering: bool = false;

// The camera's yaw the stick is read against.
steer_cam: f32 = 0.0;

drive_begin() {
    steering = true;
    for k in 0..4 keys_held[k] = false;
    stick_finger = -1;
    stick_x = 0.0;
    stick_y = 0.0;
    script_clock = 0.0;
    steer_begin(go_gait, v3(0.0, 0.0, 0.0), 0.0)
}

// A script for the stick, for tests and pictures (L8_STEER in the viewer):
// for so many seconds, the way over the ground in degrees (0 ahead, 90 to
// his left) and the speed; a speed of 0 is to stop.
const MAX_SCRIPT: int = 32;

script_secs: []f32 = new f32[MAX_SCRIPT](0.0);

script_deg: []f32 = new f32[MAX_SCRIPT](0.0);

script_speed: []f32 = new f32[MAX_SCRIPT](0.0);

script_n: int = 0;

script_clock: f32 = 0.0;

add_script(secs: f32, deg: f32, speed: f32) {
    if (script_n >= MAX_SCRIPT) return;
    script_secs[script_n] = secs;
    script_deg[script_n] = deg;
    script_speed[script_n] = speed;
    script_n = script_n + 1
}

// The script's step at its clock, or -1 once it is over.
script_at(): int {
    t: f32 = script_clock;
    for i in 0..script_n {
        if (t < script_secs[i]) return i;
        t = t - script_secs[i]
    }
    -1
}

// One tick on.
drive_tick(h: f32) {
    want: V3 = stick_way(steer_cam);
    speed: f32 = stick_speed();
    if (script_n > 0) {
        script_clock = script_clock + h;
        i: int = script_at();
        want = v3(0.0, 0.0, 0.0);
        speed = 0.0;
        if (i >= 0) {
            want = ahead(script_deg[i] * PI / 180.0);
            speed = script_speed[i]
        }
    }
    if (v_len(want) < 0.5) speed = 0.0;
    steer_tick(want, speed, h)
}
