tag character;

use_tag std;

use_tag gl, x11;

use_tag skate;

import "../../stdlib/print.l8";

// A viewer for figures written as text (see FORMAT.md and figure.l8): it
// reads one, bakes each layer's shapes into a mesh (a few milliseconds of
// it a frame, so it never stops drawing or listening), and shows it standing
// in any of its poses, moving through its animations, or going over the
// ground along its routes (see gait.l8), with its layers and parts to look
// at one by one.
//
//   .build/character [figure.txt]
//
// Drag turns it; the wheel, or two fingers, bring it nearer. Left and right
// go through the poses and animations. Up and down pick a layer, and H
// hides it; comma and period pick one of its parts. V changes the view
// (shaded, parts, bones, facets), K shows the skeleton, B shows the shapes
// unblended, D changes the mesh's detail, R reads the file again, Escape
// quits. A page round it (web/character) does the same through key codes
// from 1000000000 up, and reads the lines this writes that start `CHR`.
import "../gl/gl.l8";

import "../skate/math.l8";

import "figure.l8";

import "field.l8";

import "bake.l8";

import "pose.l8";

import "gait.l8";

import "drive.l8";

import "steer.l8";

import "take.l8";

import "match.l8";

import "render.l8";

import "hud.l8";

extern getenv(name: str): ?*i8;

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

slurp(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    if (fd < 0) return new i8[0](0i8);
    cap: int = 65536;
    buf: []i8 = new i8[cap](0i8);
    n: int = 0;
    more: bool = true;
    while (more) {
        if (n + 4096 >= cap) {
            cap = cap * 2;
            tmp: []i8 = new i8[cap](0i8);
            memcpy(tmp, 0, buf, 0, n);
            buf = tmp
        }
        r: int = read(fd, buf, n, cap - n);
        if (r <= 0) more = false else n = n + r
    }
    close(fd);
    out: []i8 = new i8[n](0i8);
    memcpy(out, 0, buf, 0, n);
    out
}

// A number from the environment (as L8_YAW=0.5), or the fallback: for
// setting up a view from outside, to take pictures of.
env_num(key: str, fallback: f32): f32 {
    v: ?*i8 = getenv(key);
    if (v == null) return fallback;
    for e in l8_environment() {
        if (len(e) > len(key) + 1 && e[len(key)] == '=') {
            same: bool = true;
            for i in 0..len(key) {
                if (e[i] != key[i]) same = false
            }
            if (same) {
                num: f32 = 0.0;
                sign: f32 = 1.0;
                frac: f32 = 0.0;
                for i in len(key) + 1..len(e) {
                    c: int = e[i] as int;
                    if (c == 45) sign = -1.0 else if (c == 46) frac = 0.1 else if (c >= 48 && c <= 57) {
                        if (frac > 0.0) {
                            num = num + (c - 48) as f32 * frac;
                            frac = frac * 0.1
                        } else num = num * 10.0 + (c - 48) as f32
                    }
                }
                return sign * num
            }
        }
    }
    fallback
}

extern l8_environment(): []str@new;

// L8_STEER: a script for the stick, as `secs:deg:speed,secs:deg:speed...`
// (see drive.l8).
read_steer() {
    key: str = "L8_STEER";
    if (getenv(key) == null) return;
    for e in l8_environment() {
        if (len(e) > len(key) + 1 && e[len(key)] == '=') {
            same: bool = true;
            for i in 0..len(key) {
                if (e[i] != key[i]) same = false
            }
            if (same) {
                vals: []f32 = new f32[3](0.0);
                k: int = 0;
                num: f32 = 0.0;
                sign: f32 = 1.0;
                frac: f32 = 0.0;
                for i in len(key) + 1..len(e) + 1 {
                    c: int = 44;
                    if (i < len(e)) c = e[i] as int;
                    if (c == 45) sign = -1.0 else if (c == 46) frac = 0.1 else if (c >= 48 && c <= 57) {
                        if (frac > 0.0) {
                            num = num + (c - 48) as f32 * frac;
                            frac = frac * 0.1
                        } else num = num * 10.0 + (c - 48) as f32
                    } else if (c == 58 || c == 44) {
                        if (k < 3) vals[k] = sign * num;
                        k = k + 1;
                        num = 0.0;
                        sign = 1.0;
                        frac = 0.0;
                        if (c == 44) {
                            if (k == 3) add_script(vals[0], vals[1], vals[2]);
                            k = 0
                        }
                    }
                }
            }
        }
    }
}

// The figure's text, with the text of each file it names on a `use` line
// (beside it, as `use motion/cmu-run.txt`) put after it.
with_uses(text: []i8): []i8@new {
    out: []i8 = new i8[len(text)](0i8);
    memcpy(out, 0, text, 0, len(text));
    dir: int = 0;
    for i in 0..len(figure_path) {
        if (figure_path[i] == '/') dir = i + 1
    }
    i: int = 0;
    n: int = len(text);
    while (i < n) {
        // (A line's first word.)
        while (i < n && (text[i] == ' ' || text[i] == '\t')) i = i + 1;
        if (i + 4 < n && text[i] == 'u' && text[i + 1] == 's' && text[i + 2] == 'e' && text[i + 3] == ' ') {
            a: int = i + 4;
            while (a < n && text[a] == ' ') a = a + 1;
            b: int = a;
            while (b < n && text[b] != ' ' && text[b] != '\n' && text[b] != '\r' && text[b] != '#') b = b + 1;
            path: []i8 = new i8[dir + b - a](0i8);
            for k in 0..dir path[k] = figure_path[k];
            for k in a..b path[dir + k - a] = text[k];
            more: []i8 = slurp(cstr(path));
            joined: []i8 = new i8[len(out) + 1 + len(more)](0i8);
            memcpy(joined, 0, out, 0, len(out));
            joined[len(out)] = '\n';
            memcpy(joined, len(out) + 1, more, 0, len(more));
            out = joined
        }
        while (i < n && text[i] != '\n') i = i + 1;
        i = i + 1
    }
    out
}

// ---- what is shown ----
// The pose or animation shown: the poses come first, then the animations.
showing: int = 0;

anim_time: f32 = 0.0;

picked_layer: int = -1;

picked_part: int = -1;

view_kind: int = 0;

show_bones: bool = false;

// The layer being baked, or -1 when the mesh is whole.
baking: int = -1;

ready: bool = false;

// Whether the card holds a mesh to draw: the last one baked goes on being
// shown while the next bakes.
drawable: bool = false;

// With a page round the viewer, the page shows the words.
paged: bool = false;

// Keys let go that steering had no use for.
still_keys: int = 0;

// ---- the camera ----
cam_yaw: f32 = 0.45;

cam_pitch: f32 = 0.12;

cam_zoom: f32 = 1.0;

cam_at: V3 = V3 { x: 0.0, y: 0.95, z: 0.0 };

// The camera frames the figure as it is posed: the middle of its joints,
// and half its height and half its breadth, each with room to spare. What
// it looks at is that middle, slid by the hand.
framing: bool = true;

frame_at: V3 = V3 { x: 0.0, y: 0.95, z: 0.0 };

frame_h: f32 = 1.1;

frame_w: f32 = 0.75;

slide: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

frame_figure(k: f32) {
    if (!framing || nbones == 0) return;
    lo: V3 = v3(FAR, FAR, FAR);
    hi: V3 = v3(-FAR, -FAR, -FAR);
    for b in 0..nbones {
        p: V3 = wp(b);
        lo = v3(minf(lo.x, p.x), minf(lo.y, p.y + lift), minf(lo.z, p.z));
        hi = v3(maxf(hi.x, p.x), maxf(hi.y, p.y + lift), maxf(hi.z, p.z))
    }
    // (The joints stop short of the skin: of the crown and the soles most.)
    lo.y = minf(lo.y - 0.09, 0.0);
    hi.y = hi.y + 0.24;
    mid: V3 = v_lerp(lo, hi, 0.5);
    w: f32 = 0.0;
    for b in 0..nbones {
        p: V3 = wp(b);
        w = maxf(w, sqrtf((p.x - mid.x) * (p.x - mid.x) + (p.z - mid.z) * (p.z - mid.z)))
    }
    frame_at = v_lerp(frame_at, mid, k);
    frame_h = lerpf(frame_h, (hi.y - lo.y) * 0.5 + 0.06, k);
    frame_w = lerpf(frame_w, w + 0.2, k);
    cam_at = v_add(frame_at, slide)
}

// Where the picture's middle is moved to, for a page's panels.
shift_x: f32 = 0.0;

shift_y: f32 = 0.0;

// The share of the picture, across and up, that those panels leave free.
free_w: f32 = 1.0;

free_h: f32 = 1.0;

// The lens: narrow, as a camera far off has, unless L8_FOV says.
fovy: f32 = 0.5;

// L8_SLOW: how much slower than life time runs, to set beside slow motion.
slow: f32 = 1.0;

// Framing him as he goes over the ground: the camera goes with him, a
// fixed way off, however his arms and legs fly.
frame_runner(k: f32) {
    if (!framing) return;
    frame_at = v3(go_p.x, lerpf(frame_at.y, 0.98, k), go_p.z);
    frame_h = lerpf(frame_h, 1.12, k);
    frame_w = lerpf(frame_w, 1.0, k);
    cam_at = v_add(frame_at, slide)
}

// The take shown, if it is one that goes over the ground; else -1.
moving_take(): int {
    t: int = showing - nposes - nanims - nroutes;
    if (t >= 0 && t < ntakes && take_moves[t]) return t;
    -1
}

// Where on the ground the figure is; and (in y) whether the ground is a
// field, as it is under a route, so that he is seen to cover it.
ground_focus(): V3 {
    if (going) return v3(go_p.x, 1.0, go_p.z);
    mt: int = moving_take();
    if (mt >= 0) {
        p: V3 = take_root_at(mt, anim_time * take_fps[mt]);
        return v3(p.x, 1.0, p.z)
    }
    v3(0.0, 0.0, 0.0)
}

cam_dist(): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    t: f32 = sinf(fovy * 0.5) / cosf(fovy * 0.5);
    // Far enough to see it whole in what a page's panels leave of the
    // picture.
    maxf(frame_h / (t * free_h), frame_w / (t * aspect * free_w)) * cam_zoom
}

cam_eye(): V3 {
    d: f32 = cam_dist();
    v_add(cam_at, v3(sinf(cam_yaw) * cosf(cam_pitch) * d, sinf(cam_pitch) * d, cosf(cam_yaw) * cosf(cam_pitch) * d))
}

// ---- fingers ----
const MAX_BUTTONS: int = 10;

ptr_down: []bool = new bool[MAX_BUTTONS](false);

ptr_x: []f32 = new f32[MAX_BUTTONS](0.0);

ptr_y: []f32 = new f32[MAX_BUTTONS](0.0);

pointer_button(b: int): bool {
    b >= 1 && b < MAX_BUTTONS && (b < 4 || b > 7)
}

pointers_down(): int {
    n: int = 0;
    for b in 1..MAX_BUTTONS {
        if (ptr_down[b]) n = n + 1
    }
    n
}

// The gap between the two fingers down, and the point midway.
pinch_gap: f32 = 0.0;

pinch_x: f32 = 0.0;

pinch_y: f32 = 0.0;

read_pinch() {
    n: int = 0;
    ax: f32 = 0.0;
    ay: f32 = 0.0;
    for b in 1..MAX_BUTTONS {
        if (ptr_down[b]) {
            if (n == 0) {
                ax = ptr_x[b];
                ay = ptr_y[b]
            } else if (n == 1) {
                dx: f32 = ptr_x[b] - ax;
                dy: f32 = ptr_y[b] - ay;
                pinch_gap = sqrtf(dx * dx + dy * dy);
                pinch_x = (ptr_x[b] + ax) * 0.5;
                pinch_y = (ptr_y[b] + ay) * 0.5
            }
            n = n + 1
        }
    }
}

// Slide what the camera looks at, by window pixels.
pan(dx: f32, dy: f32) {
    k: f32 = cam_dist() * 2.0 * sinf(fovy * 0.5) / cosf(fovy * 0.5) / maxf(screen_h as f32,
        1.0);
    f: V3 = v_norm(v_sub(cam_at, cam_eye()));
    rt: V3 = v_norm(v_cross(f, v3(0.0, 1.0, 0.0)));
    up: V3 = v_cross(rt, f);
    slide = v_add(slide, v_add(v_scale(rt, -dx * k), v_scale(up, dy * k)));
    slide = v3(clampf(slide.x, -1.5, 1.5), clampf(slide.y, -1.5, 1.5), clampf(slide.z,
        -1.5, 1.5));
    cam_at = v_add(frame_at, slide)
}

zoom_by(k: f32) {
    cam_zoom = clampf(cam_zoom * k, 0.12, 2.5)
}

pointer_down(b: int, x: f32, y: f32) {
    if (b == 4) zoom_by(0.9);
    if (b == 5) zoom_by(1.1);
    if (!pointer_button(b)) return;
    // (Steering, a finger down on the left of the picture is the stick.)
    if (steering && going && stick_finger < 0 && x < screen_w as f32 * 0.5 && pointers_down() == 0) {
        steer_finger_down(b, x, y);
        return
    }
    ptr_down[b] = true;
    ptr_x[b] = x;
    ptr_y[b] = y;
    read_pinch()
}

pointer_up(b: int) {
    if (!pointer_button(b)) return;
    if (b == stick_finger) {
        steer_finger_up();
        return
    }
    ptr_down[b] = false;
    read_pinch()
}

pointer_move(state: int, x: f32, y: f32) {
    if (stick_finger >= 0 && (state >> 7 + stick_finger & 1) == 1) steer_finger_move(x,
        y);
    n: int = pointers_down();
    for b in 1..MAX_BUTTONS {
        if (ptr_down[b] && (state >> 7 + b & 1) == 1) {
            dx: f32 = x - ptr_x[b];
            dy: f32 = y - ptr_y[b];
            ptr_x[b] = x;
            ptr_y[b] = y;
            if (n == 1) {
                if (b == 1) {
                    cam_yaw = wrap_angle(cam_yaw - dx * 0.008);
                    cam_pitch = clampf(cam_pitch + dy * 0.006, -0.35, 1.45)
                } else pan(dx, dy)
            } else if (n == 2) {
                gap: f32 = pinch_gap;
                mx: f32 = pinch_x;
                my: f32 = pinch_y;
                read_pinch();
                if (gap > 1.0 && pinch_gap > 1.0) zoom_by(gap / pinch_gap);
                pan(pinch_x - mx, pinch_y - my)
            }
        }
    }
}

// ---- telling the page ----
tell_name(id: int) raises IoError {
    n: int = mini(name_len[id], 255);
    for i in 0..n name_tmp[i] = name_pool[name_at[id] + i];
    write_bytes_n(1, name_tmp, n)
}

// The figure's layers, parts, poses, and animations, each with the line of
// the text it is on.
tell_figure() raises IoError {
    write(1, "CHR figure ");
    write_bytes_n(1, title, title_len);
    write(1, "\n");
    for l in 0..nlayers {
        if (!layer_hidden[l]) {
            write(1, "CHR layer ");
            write_int(1, l);
            write(1, " ");
            write_int(1, layer_line[l]);
            write(1, " ");
            tell_name(layer_name[l]);
            write(1, "\n")
        }
    }
    for p in 0..nparts {
        if (!layer_hidden[part_layer[p]]) {
            write(1, "CHR part ");
            write_int(1, p);
            write(1, " ");
            write_int(1, part_layer[p]);
            write(1, " ");
            write_int(1, part_line[p]);
            write(1, " ");
            tell_name(part_name[p]);
            write(1, "\n")
        }
    }
    for p in 0..nposes {
        write(1, "CHR pose ");
        write_int(1, p);
        write(1, " ");
        write_int(1, pose_line[p]);
        write(1, " ");
        tell_name(pose_name[p]);
        write(1, "\n")
    }
    for a in 0..nanims {
        write(1, "CHR anim ");
        write_int(1, nposes + a);
        write(1, " ");
        write_int(1, anim_line[a]);
        write(1, " ");
        tell_name(anim_name[a]);
        write(1, "\n")
    }
    for i in 0..nroutes {
        write(1, "CHR route ");
        write_int(1, nposes + nanims + i);
        write(1, " ");
        write_int(1, route_line[i]);
        write(1, " ");
        tell_name(route_name[i]);
        write(1, "\n");
        if (route_steered[i]) {
            write(1, "CHR steered ");
            write_int(1, nposes + nanims + i);
            write(1, "\n")
        }
    }
    for i in 0..ntakes {
        // (Only those to watch on their own: not motion a gait matches from.)
        if (!take_moves[i]) {
            write(1, "CHR take ");
            write_int(1, nposes + nanims + nroutes + i);
            write(1, " ");
            write_int(1, take_line[i]);
            write(1, " ");
            tell_name(take_name[i]);
            write(1, "\n")
        }
    }
    write(1, "CHR bones ");
    write_int(1, nbones);
    write(1, "\n")
}

tell_baked(l: int, ms: int) raises IoError {
    write(1, "CHR baked ");
    write_int(1, l);
    write(1, " ");
    write_int(1, layer_vn[l]);
    write(1, " ");
    write_int(1, layer_tn[l]);
    write(1, " ");
    write_int(1, ms);
    write(1, "\n")
}

tell_error() raises IoError {
    write(1, "CHR error ");
    write_int(1, err_line);
    write(1, " ");
    write(1, err_msg);
    write(1, "\n")
}

// ---- reading and baking ----
figure_path: str = "programs/character/running-back.txt";

// Read the figure's text again and start baking it.
load() noregion raises IoError {
    text: []i8 = with_uses(slurp(figure_path));
    mark: int = skeleton_mark();
    ready = false;
    baking = -1;
    if (len(text) == 0) {
        drawable = false;
        line_no = 0;
        err_line = 1;
        err_msg = "the figure's file could not be read";
        tell_error();
        return
    }
    if (!read_figure(text)) {
        drawable = false;
        tell_error();
        return
    }
    if (skeleton_mark() != mark) drawable = false;
    solve_poses();
    for l in 0..MAX_LAYERS layer_shown[l] = true;
    if (showing >= nposes + nanims + nroutes + ntakes) showing = 0;
    show(showing);
    if (picked_layer >= nlayers) picked_layer = -1;
    picked_part = -1;
    tell_figure();
    bake_begin();
    baking = 0
}

rebake() {
    if (err_line != 0 || nlayers == 0) return;
    ready = false;
    bake_begin();
    baking = 0
}

// How long a frame gives to baking: more while there is nothing to show.
const BAKE_SLICE: int = 11000000;

const BAKE_SLICE_BLANK: int = 22000000;

// How long the layer being baked has taken so far.
bake_ns: int = 0;

// A little more of the mesh: of a layer, then of the stickers one by one,
// and at the end what is drawn, sent to the card. A frame's share and no
// more, so that the viewer goes on drawing and listening while it bakes.
bake_step(r: *Renderer) raises IoError {
    if (baking < 0) return;
    deadline: int = mono_ns() + BAKE_SLICE;
    if (!drawable) deadline = mono_ns() + BAKE_SLICE_BLANK;
    while (baking >= 0 && mono_ns() < deadline) {
        if (baking < nlayers) {
            if (bk_layer != baking) {
                if (baking == 0) write(1, "CHR baking\n");
                begin_layer(baking);
                bake_ns = 0
            }
            t0: int = mono_ns();
            done: bool = work_layer(deadline);
            bake_ns = bake_ns + mono_ns() - t0;
            if (done) {
                if (!layer_hidden[baking]) tell_baked(baking, bake_ns / 1000000);
                baking = baking + 1
            }
        } else if (baking < nlayers + nstickers) {
            bake_sticker(baking - nlayers);
            paint_sticker(baking - nlayers);
            baking = baking + 1
        } else if (baking == nlayers + nstickers) {
            // The last of it, a frame for each part: what is drawn worked
            // out; the mesh to the card; the pictures and the triangles.
            find_probes();
            build_draws();
            baking = baking + 1;
            deadline = 0
        } else if (baking == nlayers + nstickers + 1) {
            upload_vertices(r);
            baking = baking + 1;
            deadline = 0
        } else {
            was_drawable: bool = drawable;
            upload_pictures(r);
            upload_draws(r);
            baking = -1;
            ready = true;
            drawable = true;
            // (What plays starts again as the figure first appears.)
            if (!was_drawable && getenv("L8_TIME") == null) anim_time = 0.0;
            write(1, "CHR ready ");
            write_int(1, nverts);
            write(1, " ");
            write_int(1, draw_n / 3);
            write(1, "\n")
        }
    }
}

// A number that changes if the skeleton does: the mesh on the card can go
// on being shown while another bakes only if its bones are the same.
skeleton_mark(): int {
    h: int = nbones;
    for b in 0..nbones {
        h = h * 31 + bone_parent[b] + 7;
        for a in 0..3 h = (h * 31 + (bone_rest[b * 3 + a] * 10000.0) as int) % 1000000007
    }
    h
}

// ---- choosing ----
step_layer(by: int) {
    l: int = picked_layer;
    for _i in 0..nlayers + 1 {
        l = l + by;
        if (l < -1) l = nlayers - 1;
        if (l >= nlayers) l = -1;
        if (l < 0 || !layer_hidden[l]) {
            picked_layer = l;
            picked_part = -1;
            return
        }
    }
}

step_part(by: int) {
    if (picked_layer < 0) return;
    p: int = picked_part;
    for _i in 0..nparts + 1 {
        p = p + by;
        if (p < -1) p = nparts - 1;
        if (p >= nparts) p = -1;
        if (p < 0 || part_layer[p] == picked_layer) {
            picked_part = p;
            return
        }
    }
}

// Show a pose, an animation, or (after those) a route, from its start.
show(i: int) {
    showing = i;
    anim_time = 0.0;
    going = false;
    stood = true;
    if (i >= nposes + nanims && i - nposes - nanims < nroutes) {
        go_begin(i - nposes - nanims);
        stood = !going;
        // (Steering: from above and behind, further off, to see where he
        // can go.)
        if (steering) {
            cam_pitch = env_num("L8_PITCH", 0.42);
            cam_zoom = env_num("L8_ZOOM", 2.2);
            cam_yaw = env_num("L8_YAW", PI)
        }
    }
}

// A page's command: a code and a number.
command(r: *Renderer, code: int, arg: int) noregion raises IoError {
    if (code == 1 && arg < nposes + nanims + nroutes + ntakes) show(arg);
    if (code == 2 && arg < nlayers) {
        layer_shown[arg] = !layer_shown[arg];
        if (ready) {
            build_draws();
            upload_draws(r)
        }
    }
    if (code == 3) {
        picked_layer = -1;
        picked_part = -1;
        if (arg < nlayers) picked_layer = arg
    }
    if (code == 4) {
        picked_part = -1;
        if (arg < nparts) {
            picked_part = arg;
            picked_layer = part_layer[arg]
        }
    }
    if (code == 5 && arg < VIEW_COUNT) view_kind = arg;
    if (code == 6) show_bones = arg == 1;
    if (code == 7) load();
    if (code == 8) {
        raw_shapes = arg == 1;
        rebake()
    }
    if (code == 9) zoom_by(0.8 + 0.004 * arg as f32);
    if (code == 10) {
        detail = clampf(arg as f32 / 100.0, 0.4, 4.0);
        rebake()
    }
    if (code == 11) shift_x = (arg - 500) as f32 / 500.0;
    if (code == 12) shift_y = (arg - 500) as f32 / 500.0;
    if (code == 13) free_w = clampf(arg as f32 / 999.0, 0.2, 1.0);
    if (code == 14) free_h = clampf(arg as f32 / 999.0, 0.2, 1.0)
}

key_press(r: *Renderer, ks: int) noregion raises IoError {
    if (ks >= 1000000000) {
        command(r, (ks - 1000000000) / 1000, (ks - 1000000000) % 1000);
        return
    }
    count: int = maxi(nposes + nanims + nroutes + ntakes, 1);
    if (ks == 65363 || ks == 65366) show((showing + 1) % count);
    if (ks == 65361 || ks == 65365) show((showing + count - 1) % count);
    if (ks == 65364) step_layer(1);
    if (ks == 65362) step_layer(-1);
    if (ks == 46) step_part(1);
    if (ks == 44) step_part(-1);
    if (ks == 104 && picked_layer >= 0) command(r, 2, picked_layer);
    if (ks == 118) view_kind = (view_kind + 1) % VIEW_COUNT;
    if (ks == 107) show_bones = !show_bones;
    if (ks == 114) load();
    if (ks == 98) {
        raw_shapes = !raw_shapes;
        rebake()
    }
    if (ks == 100) {
        if (detail < 0.9) detail = 1.0 else if (detail < 1.2) detail = 1.6 else detail = 0.65;
        rebake()
    }
    if (ks == 61) zoom_by(0.9);
    if (ks == 45) zoom_by(1.1)
}

// ---- the words, without a page ----
view_names: []str = ["SHADED", "PARTS", "BONES", "FACETS"];

draw_words(r: *Renderer) {
    flat_n = 0;
    hud_px = maxf(2.0, floorf(minf(screen_w as f32, screen_h as f32) / 360.0));
    px: f32 = hud_px;
    pale: V3 = v3(1.0, 0.98, 0.94);
    gold: V3 = v3(1.0, 0.82, 0.3);
    x: f32 = 6.0 * px;
    y: f32 = 6.0 * px;
    if (err_line != 0) {
        text_len = 0;
        say("LINE ");
        say_int(err_line);
        say(": ");
        say(err_msg);
        put_text(x, y, v3(1.0, 0.5, 0.42), 1.0)
    } else {
        text_len = 0;
        for i in 0..title_len {
            if (text_len < len(text_buf)) {
                text_buf[text_len] = title[i];
                text_len = text_len + 1
            }
        }
        put_text(x, y, pale, 1.0);
        y = y + 12.0 * px;
        for l in 0..nlayers {
            if (!layer_hidden[l]) {
                text_len = 0;
                if (l == picked_layer) say("> ") else say("  ");
                say_name(layer_name[l]);
                if (!layer_shown[l]) say(" (HIDDEN)");
                if (baking >= 0 && l >= baking) say(" ...");
                c: V3 = pale;
                if (l == picked_layer) c = gold;
                a: f32 = 0.9;
                if (!layer_shown[l]) a = 0.5;
                put_text(x, y, c, a);
                y = y + 9.0 * px;
                if (l == picked_layer) {
                    for p in 0..nparts {
                        if (part_layer[p] == l) {
                            text_len = 0;
                            if (p == picked_part) say("    > ") else say("      ");
                            say_name(part_name[p]);
                            c = pale;
                            if (p == picked_part) c = gold;
                            put_text(x, y, c, 0.8);
                            y = y + 9.0 * px
                        }
                    }
                }
            }
        }
        text_len = 0;
        if (showing < nposes) say_name(pose_name[showing]) else if (showing - nposes < nanims) {
            say_name(anim_name[showing - nposes]);
            say(" (MOVING)")
        } else if (showing - nposes - nanims - nroutes >= 0 && showing - nposes - nanims - nroutes < ntakes) {
            say_name(take_name[showing - nposes - nanims - nroutes]);
            say(" (FROM FOOTAGE)")
        } else if (going) {
            say_name(route_name[go_route]);
            say("  ");
            say_int((v_len(go_v) * 10.0) as int / 10);
            say(".");
            say_int((v_len(go_v) * 10.0) as int % 10);
            say(" M/S")
        }
        put_text((screen_w as f32 - text_width()) * 0.5, screen_h as f32 - 14.0 * px,
            gold, 1.0);
        text_len = 0;
        say(view_names[view_kind]);
        if (show_bones) say(" + SKELETON");
        if (raw_shapes) say(" + RAW SHAPES");
        put_text(screen_w as f32 - text_width() - 6.0 * px, 6.0 * px, pale, 0.85);
        text_len = 0;
        say_int(nverts);
        say(" VERTICES  ");
        say_int(draw_n / 3);
        say(" TRIANGLES  ");
        say_int(nbones);
        say(" BONES");
        put_text(screen_w as f32 - text_width() - 6.0 * px, 16.0 * px, pale, 0.6)
    }
    if (steering && going) put_stick();
    hud_matrix();
    draw_flat(r, hud_m)
}

// The stick, while a finger holds it: a ring where it went down, and a dot
// where it is pushed.
put_stick() {
    if (stick_finger < 0) return;
    r: f32 = stick_reach();
    px: f32 = maxf(2.0, floorf(minf(screen_w as f32, screen_h as f32) / 360.0));
    for i in 0..48 {
        a: f32 = TAU * i as f32 / 48.0;
        put_px(stick_ox + cosf(a) * r - px, stick_oy + sinf(a) * r - px, px * 2.0,
            px * 2.0, v3(1.0, 0.98, 0.94), 0.7)
    }
    put_px(stick_ox + stick_x * r - px * 5.0, stick_oy - stick_y * r - px * 5.0, px * 10.0,
        px * 10.0, v3(1.0, 0.82, 0.3), 0.85)
}

draw_stick(r: *Renderer) {
    flat_n = 0;
    put_stick();
    hud_matrix();
    draw_flat(r, hud_m)
}

main(argc: int, argv: []str@immortal) noregion raises IoError: int {
    if (argc > 1) figure_path = argv[1];
    paged = getenv("L8_PAGE") != null;
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    screen_w = 1280;
    screen_h = 720;
    win: int = XCreateWindow(dpy, root, 0, 0, screen_w, screen_h, 0, vis.depth as int,
        1, vis.visual, 10248, &wa);
    if (win == 0) die("XCreateWindow failed");
    XStoreName(dpy, win, "L8 Character");
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    r: *Renderer = new_renderer();
    cam_yaw = env_num("L8_YAW", cam_yaw);
    cam_pitch = env_num("L8_PITCH", cam_pitch);
    cam_zoom = env_num("L8_ZOOM", cam_zoom);
    if (getenv("L8_AT") != null) {
        framing = false;
        frame_at = v3(0.0, env_num("L8_AT", 0.95), 0.0);
        cam_at = frame_at
    }
    fovy = clampf(env_num("L8_FOV", fovy), 0.03, 1.4);
    slow = clampf(env_num("L8_SLOW", 1.0), 0.02, 4.0);
    showing = env_num("L8_SHOW", 0.0) as int;
    anim_time = env_num("L8_TIME", 0.0);
    view_kind = env_num("L8_VIEW", 0.0) as int % VIEW_COUNT;
    show_bones = env_num("L8_BONES", 0.0) > 0.5;
    raw_shapes = env_num("L8_RAW", 0.0) > 0.5;
    detail = env_num("L8_DETAIL", 1.0);
    picked_layer = env_num("L8_LAYER", -1.0) as int;
    picked_part = env_num("L8_PART", -1.0) as int;
    hide: int = env_num("L8_HIDE", 0.0) as int;
    read_steer();
    frozen: bool = getenv("L8_TIME") != null;
    load();
    for l in 0..MAX_LAYERS {
        if ((hide >> l & 1) == 1) layer_shown[l] = false
    }
    // (L8_TIME, for a route: that many seconds into it, and held there.)
    if (frozen) anim_time = env_num("L8_TIME", 0.0);
    // (L8_SKIP: the same, and then it goes on.)
    if (going && frozen) {
        for _i in 0..(env_num("L8_TIME", 0.0) / TICK) as int go_tick()
    }
    if (going) {
        for _i in 0..(env_num("L8_SKIP", 0.0) / TICK) as int go_tick()
    }
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = mono_ns();
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65307) running = false;
                    if (!(steering && going && steer_key(ks, true))) key_press(r,
                        ks)
                }
                KeyRelease -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (!steer_key(ks, false)) still_keys = still_keys + 1
                }
                ButtonPress b -> pointer_down(b.button as int, b.x as f32, b.y as f32);
                ButtonRelease b -> pointer_up(b.button as int);
                MotionNotify mo -> pointer_move(mo.state as int, mo.x as f32, mo.y as f32);
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        screen_w = c.width as int;
                        screen_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        if (running) {
            now: int = mono_ns();
            dns: int = now - prev_ns;
            prev_ns = now;
            if (dns < 0) dns = 0;
            if (dns > 100000000) dns = 100000000;
            dt: f32 = dns as f32 / 1000000000.0 * slow;
            bake_step(r);
            // A pose may hide layers: the ball, when he has not got it.
            hides: int = 0;
            if (showing < nposes && err_line == 0) hides = pose_hides[showing];
            if (going && gait_base[go_gait] >= 0 && err_line == 0) hides = pose_hides[gait_base[go_gait]];
            shown_take: int = showing - nposes - nanims - nroutes;
            if (shown_take >= 0 && shown_take < ntakes && take_base[shown_take] >= 0 && err_line == 0) hides = pose_hides[take_base[shown_take]];
            if (hides != pose_hidden) {
                pose_hidden = hides;
                if (ready) {
                    build_draws();
                    upload_draws(r)
                }
            }
            if (err_line == 0 && nbones > 0) {
                taking: int = showing - nposes - nanims - nroutes;
                if (taking >= 0 && taking < ntakes && take_n[taking] > 0) {
                    // (A take plays at the footage's own pace, and again.)
                    if (!frozen) anim_time = anim_time + dt;
                    if (anim_time > take_seconds(taking)) anim_time = 0.0;
                    take_pose(taking, anim_time)
                } else if (going) {
                    steer_cam = cam_yaw;
                    stick_px = maxf(40.0, minf(screen_w as f32, screen_h as f32) * 0.12);
                    if (!frozen) go_on(dt);
                    by: V3 = go_recenter();
                    frame_at = v_add(frame_at, by);
                    go_pose()
                } else if (showing < nposes) show_toward(showing, ease(11.0, dt)) else if (showing - nposes < nanims) {
                    a: int = showing - nposes;
                    if (!frozen) anim_time = anim_time + dt / anim_secs[a];
                    anim_time = anim_time - floorf(anim_time);
                    sample_anim(a, anim_time);
                    show_toward(WORK, ease(24.0, dt))
                }
                pose_matrices();
                // (Slowly while he moves, so the camera does not bob with
                // him.)
                if (moving_take() >= 0) {
                    mt: int = moving_take();
                    p: V3 = take_root_at(mt, anim_time * take_fps[mt]);
                    go_p = v3(p.x, 0.0, p.z);
                    frame_runner(ease(6.0, dt))
                } else if (going) frame_runner(ease(6.0, dt)) else if (showing < nposes) frame_figure(ease(4.0,
                    dt)) else frame_figure(ease(0.7, dt))
            }
            v: View = View {
                eye: cam_eye(),
                at: cam_at,
                fovy: fovy,
                shift_x: shift_x,
                shift_y: shift_y,
                kind: view_kind,
                focus: ground_focus(),
                layer: picked_layer,
                part: picked_part,
                bones: show_bones
            };
            draw_scene(r, v, drawable && err_line == 0);
            if (!paged) draw_words(r) else if (steering && going) draw_stick(r);
            glXSwapBuffers(dpy, win)
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}
