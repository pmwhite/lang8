tag character;

use_tag skate;

// Playing a take: a movement followed from footage (see figure.l8 for what
// a frame holds). Each bone is turned to point the way the footage shows,
// so the figure strikes the pose with its own proportions; the legs and
// arms by reaching, with the knee and elbow where they were seen.

// Direction k of take t at time (in frames), between the frames either side.
take_dir(t: int, at: f32, k: int): V3 {
    n: int = take_n[t];
    f: f32 = clampf(at, 0.0, (n - 1) as f32);
    i: int = mini(f as int, maxi(n - 2, 0));
    u: f32 = f - i as f32;
    a: int = (take_first[t] + i) * TAKE_FLOATS + k * 3;
    b: int = a;
    if (n > 1) b = a + TAKE_FLOATS;
    v_norm(v3(lerpf(take_f[a], take_f[b], u), lerpf(take_f[a + 1], take_f[b + 1],
        u), lerpf(take_f[a + 2], take_f[b + 2], u)))
}

// The turn that sets a bone's left and up to these (made square first).
q_left_up(left: V3, up: V3): Q {
    y: V3 = v_norm(v_reject(up, left));
    q_axes(left, y, v_cross(left, y))
}

// A limb, to where the footage has it: from the joint of `upper`, along
// one direction to the middle joint and another to the end.
take_limb(end: int, first: V3, second: V3) {
    mid: int = bone_parent[end];
    upper: int = bone_parent[mid];
    if (upper < 0) return;
    place_bones(WORK);
    from: V3 = wp(upper);
    l1: f32 = v_len(v_sub(bone_pos(mid), bone_pos(upper)));
    l2: f32 = v_len(v_sub(bone_pos(end), bone_pos(mid)));
    joint: V3 = v_madd(from, first, l1);
    reach(end, v_madd(joint, second, l2), true, joint)
}

// The sixteen directions a pose is made from (see figure.l8), filled by a
// take or by matching (match.l8).
pose_dirs: []f32 = new f32[48](0.0);

pdir(k: int): V3 {
    v3(pose_dirs[k * 3], pose_dirs[k * 3 + 1], pose_dirs[k * 3 + 2])
}

// Gait g's bones turned to pose_dirs, from pose `base` (or the rest pose)
// for all else, the root at `at` (from where it rests); into the work pose.
pose_from_dirs(
    g: int,
    base: int,
    hand: int,
    at: V3
) {
    for b in 0..nbones {
        if (base >= 0) {
            set_q(WORK, b, get_q(base, b));
            set_t(WORK, b, get_t(base, b))
        } else {
            set_q(WORK, b, q_ident());
            set_t(WORK, b, v3(0.0, 0.0, 0.0))
        }
    }
    root: int = gait_root[g];
    hips: Q = q_left_up(pdir(0), pdir(1));
    chest: Q = q_left_up(pdir(2), pdir(3));
    set_q(WORK, root, hips);
    set_t(WORK, root, at);
    if (gait_spine[g * 2] >= 0) {
        mid: Q = q_unit(Q {
            x: hips.x + chest.x,
            y: hips.y + chest.y,
            z: hips.z + chest.z,
            w: hips.w + chest.w
        });
        if (hips.x * chest.x + hips.y * chest.y + hips.z * chest.z + hips.w * chest.w < 0.0) mid = chest;
        turn_to(gait_spine[g * 2], mid)
    }
    if (gait_spine[g * 2 + 1] >= 0) turn_to(gait_spine[g * 2 + 1], chest);
    if (gait_head[g] >= 0) {
        left: V3 = pdir(4);
        nose: V3 = v_norm(v_reject(pdir(5), left));
        turn_to(gait_head[g], q_axes(left, v_cross(nose, left), nose))
    }
    if (hand >= 0) {
        take_limb(hand, pdir(6), pdir(7));
        take_limb(bone_twin[hand], pdir(8), pdir(9))
    }
    foot: int = gait_foot[g];
    take_limb(foot, pdir(10), pdir(11));
    take_limb(bone_twin[foot], pdir(12), pdir(13));
    for f in 0..2 {
        fb: int = foot;
        if (f == 1) fb = bone_twin[foot];
        place_bones(WORK);
        set_foot(fb, pdir(14 + f))
    }
}

// Foot bone fb turned to point heel to toe along `ahead`, its sides square
// to the shin it hangs from (so it never turns over, even pointing straight
// down), and bent at the ankle no further than an ankle goes: between 60
// and 150 degrees from the shin, up it.
set_foot(fb: int, ahead: V3) {
    up_shin: V3 = v_norm(v_sub(wp(bone_parent[fb]), wp(fb)));
    a: V3 = v_norm(ahead);
    left: V3 = v_cross(up_shin, a);
    if (v_len(left) < 0.05) left = q_turn(wq(bone_parent[fb]), v3(1.0, 0.0, 0.0));
    left = v_norm(left);
    // (Within the ankle's range, turning about its left.)
    bend: f32 = atan2f(v_dot(v_cross(up_shin, a), left), v_dot(up_shin, a));
    // (Out of range, to whichever end is nearer the way round: a foot
    // pointed far down stays pointed down, not flipped up.)
    if (bend < 0.0) bend = bend + TAU;
    lo: f32 = 60.0 * PI / 180.0;
    hi: f32 = 150.0 * PI / 180.0;
    lim: f32 = bend;
    if (bend > hi) {
        if (bend - hi < lo + TAU - bend) lim = hi else lim = lo
    }
    if (bend < lo) lim = lo;
    a = v_rotate(up_shin, left, lim);
    up: V3 = v_cross(a, left);
    turn_to(fb, q_axes(left, up, a))
}

// Take t at a time in seconds, into the pose shown.
take_pose(t: int, seconds: f32) {
    g: int = take_gait[t];
    base: int = gait_base[g];
    if (take_base[t] >= 0) base = take_base[t];
    at: f32 = seconds * take_fps[t];
    for k in 0..16 {
        d: V3 = take_dir(t, at, k);
        pose_dirs[k * 3] = d.x;
        pose_dirs[k * 3 + 1] = d.y;
        pose_dirs[k * 3 + 2] = d.z
    }
    // (A take that says where the figure was goes there.)
    by: V3 = v3(0.0, 0.0, 0.0);
    if (take_moves[t]) {
        root: int = gait_root[g];
        p: V3 = take_root_at(t, at);
        by = v3(p.x - bone_rest[root * 3], p.y - bone_rest[root * 3 + 1], p.z - bone_rest[root * 3 + 2])
    }
    pose_from_dirs(g, base, take_hand[t], by);
    for b in 0..nbones {
        set_q(SHOWN, b, get_q(WORK, b));
        set_t(SHOWN, b, get_t(WORK, b))
    }
}

take_seconds(t: int): f32 {
    maxf((take_n[t] - 1) as f32 / take_fps[t], 0.01)
}
