tag base64_internal;

// RFC 4648 standard alphabet, with padding and no line breaks.
// The result is a new string; the input is borrowed only during this call.
tag base64
base64_encode(data: []i8): str@new {
    alphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    size: int = len(data);
    out: []i8 = new i8[(size / 3 + (if (size % 3 == 0) 0 else 1)) * 4]('=' as i8);
    source: int = 0;
    destination: int = 0;
    while (source < size) {
        a: int = data[source] as int & 255;
        b: int = 0;
        c: int = 0;
        remaining: int = size - source;
        if (remaining > 1) b = data[source + 1] as int & 255;
        if (remaining > 2) c = data[source + 2] as int & 255;
        out[destination] = alphabet[a >> 2];
        out[destination + 1] = alphabet[(a & 3) << 4 | b >> 4];
        if (remaining > 1) out[destination + 2] = alphabet[(b & 15) << 2 | c >> 6];
        if (remaining > 2) out[destination + 3] = alphabet[c & 63];
        source = source + 3;
        destination = destination + 4
    }
    cstr(out)
}
