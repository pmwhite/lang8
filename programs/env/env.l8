tag env_internal;

use_tag std;

import "../../stdlib/print.l8";

// The process's environment variables, for settings a program takes from
// them (as the games take their L8_ variables). Each is asked for by its
// name; its value is what follows NAME= in its entry. Natively the entries
// are the process's; in Wasm, the host's (see l8_environment, in the
// runtime). The entries are read afresh at each call: for settings read
// once, at the start.
tag env_internal
extern l8_environment(): []str@new;

// Whether the variable is set (even to nothing).
tag env
env_has(name: str): bool {
    entry_at(l8_environment(), name) >= 0
}

// The variable's value, or "" if it is not set.
tag env
env_value(name: str): str@new {
    entry_value(l8_environment(), name)
}

// The variable's value as a number (as env_read_number reads it), or
// `otherwise` if it is not set or empty.
tag env
env_number(name: str, otherwise: f32): f32 {
    value: str = env_value(name);
    if (len(value) == 0) return otherwise;
    env_read_number(value, 0).value
}

// The variable's value as a whole number (an optional minus sign and
// digits, exactly, anything after them left), or `otherwise` if it is not
// set or does not begin with one.
tag env
env_int(name: str, otherwise: int): int {
    whole_number(env_value(name), otherwise)
}

whole_number(text: str, otherwise: int): int {
    i: int = 0;
    sign: int = 1;
    if (i < len(text) && text[i] == 45i8) {
        sign = -1;
        i = i + 1
    }
    if (i >= len(text) || !is_digit(text[i])) return otherwise;
    whole: int = 0;
    while (i < len(text) && is_digit(text[i])) {
        whole = whole * 10 + (text[i] as int - 48);
        i = i + 1
    }
    sign * whole
}

// The variable's numbers, by commas (a,b,c), into out (as many as it has
// room for): how many the value has, which may be more than were kept.
tag env
env_numbers(name: str, out: []f32): int {
    value: str = env_value(name);
    at: int = 0;
    count: int = 0;
    while (at < len(value)) {
        read: EnvNumber = env_read_number(value, at);
        if (count < len(out)) out[count] = read.value;
        count = count + 1;
        at = read.next + 1
    }
    count
}

// Which of `names` the variable's value is (the whole of it), or -1 (not
// set, or none of them).
tag env
env_choice(name: str, names: []str): int {
    value: str = env_value(name);
    for i in 0..len(names) {
        if (len(value) > 0 && value == names[i]) return i
    }
    -1
}

// A number read from text at `at`: an optional minus sign, digits, and
// optionally a point and more digits (anything else ends it); and where it
// ended. With no digits, it is 0.
tag env
type EnvNumber = {
    value: f32;
    next: int
}

tag env
env_read_number(text: str, at: int): EnvNumber {
    i: int = at;
    sign: f32 = 1.0;
    if (i < len(text) && text[i] == 45i8) {
        sign = -1.0;
        i = i + 1
    }
    whole: f32 = 0.0;
    while (i < len(text) && is_digit(text[i])) {
        whole = whole * 10.0 + (text[i] as int - 48) as f32;
        i = i + 1
    }
    if (i < len(text) && text[i] == 46i8) {
        i = i + 1;
        place: f32 = 0.1;
        while (i < len(text) && is_digit(text[i])) {
            whole = whole + (text[i] as int - 48) as f32 * place;
            place = place * 0.1;
            i = i + 1
        }
    }
    EnvNumber { value: sign * whole, next: i }
}

// Whether text begins with prefix.
tag env
starts_with(text: str, prefix: str): bool {
    if (len(text) < len(prefix)) return false;
    for i in 0..len(prefix) {
        if (text[i] != prefix[i]) return false
    }
    true
}

is_digit(c: i8): bool {
    c >= 48i8 && c <= 57i8
}

// The index of name's entry among entries (NAME=value), or -1.
entry_at(entries: []str, name: str): int {
    for i in 0..len(entries) {
        e: str = entries[i];
        // (NAME=, '=' being 61.)
        if (len(e) > len(name) && e[len(name)] == 61i8 && starts_with(e, name)) return i
    }
    -1
}

entry_value(entries: []str, name: str): str@new {
    i: int = entry_at(entries, name);
    if (i < 0) return "";
    e: str = entries[i];
    value: []i8 = new i8[len(e) - len(name) - 1](0i8);
    for k in 0..len(value) value[k] = e[len(name) + 1 + k];
    cstr(value)
}

test "a variable is found by its whole name" {
    entries: []str = ["L8_CAMD=7.5", "L8_CAM=side", "L8_TRACE=", "PATH=/bin"];
    print(entry_value(entries, "L8_CAM"));
    print(entry_value(entries, "L8_CAMD"));
    print_bool(entry_at(entries, "L8_TRACE") >= 0);
    print_bool(entry_at(entries, "L8_CA") >= 0);
    expect {|
        side
        7.5
        true
        false
    |}
}

test "numbers are read where they are, and say where they end" {
    for text in ["4.25", "-0.5", "30,-15", "abc", ""] {
        read: EnvNumber = env_read_number(text, 0);
        print_int((read.value * 100.0) as int);
        print_int(read.next)
    }
    expect {|
        425
        4
        -50
        4
        3000
        2
        0
        0
        0
        0
    |}
}

test "a whole number is read exactly, past where a float would round" {
    for text in ["20261120", "-300000037", "7x", "x7", ""] print_int(whole_number(text,
        -1));
    expect {|
        20261120
        -300000037
        7
        -1
        -1
    |}
}
