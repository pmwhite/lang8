tag std;

native "write.s";

extern std_raw_text(fd: int, data: str, n: int): int = l8_std_write;

extern std_raw_bytes(fd: int, data: []i8, n: int): int = l8_std_write;

extern std_raw_pointer(fd: int, data: *i8, n: int): int = l8_std_write;

extern std_exit(code: int): noreturn = exit;

// These convenience functions issue one write. Use a result form when needed.
write(fd: int, data: str) {
    std_raw_text(fd, data, len(data))
}

write_bytes(fd: int, data: []i8) {
    std_raw_bytes(fd, data, len(data))
}

write_byte(fd: int, data: *i8) {
    std_raw_pointer(fd, data, 1)
}

write_result(fd: int, data: str): int {
    std_raw_text(fd, data, len(data))
}

write_text_n(fd: int, data: str, n: int) {
    write_text_n_result(fd, data, n)
}

write_text_n_result(fd: int, data: str, n: int): int {
    if (n < 0 || n > len(data)) std_exit(1);
    std_raw_text(fd, data, n)
}

write_bytes_n(fd: int, data: []i8, n: int) {
    write_bytes_at_result(fd, data, 0, n)
}

write_bytes_n_result(fd: int, data: []i8, n: int): int {
    write_bytes_at_result(fd, data, 0, n)
}

write_bytes_at(
    fd: int,
    data: []i8,
    off: int,
    n: int
) {
    write_bytes_at_result(fd, data, off, n)
}

write_bytes_at_result(
    fd: int,
    data: []i8,
    off: int,
    n: int
): int {
    if (off < 0 || off > len(data) || n < 0 || n > len(data) - off) std_exit(1);
    if (n == 0) return 0;
    std_raw_pointer(fd, &data[off], n)
}
