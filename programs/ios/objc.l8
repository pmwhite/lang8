tag ios;

use_tag std;

// Objective-C from L8, for apps on iOS (built with `l8 arm64 --target ios`).
//
// Objects are ints here (their addresses), so nil is 0 and needs no
// narrowing. A message is objc_msgSend, declared once for each shape of
// call: msg(receiver, selector, ...) with whole-number (or object) arguments
// and result; msg_f for a double result; msg_set_f for one double argument;
// msg_rect for a CGRect argument; and msg_hfa for a result of up to four
// doubles (a CGRect, a CGPoint, UIEdgeInsets), which the runtime stores in
// an array (L8 receives one float result, not four).
//
// Classes are made at run time (objc_allocateClassPair) and their methods
// are L8 functions passed by address (&name), called as C callbacks: the
// receiver and selector first, then the method's arguments, all ints.
// Methods take at most four arguments besides those two.
extern objc_getClass(name: str): int;

extern sel_registerName(name: str): int;

extern objc_getProtocol(name: str): int;

extern object_getClass(object: int): int;

extern objc_allocateClassPair(superclass: int, name: str, extra: int): int;

extern objc_registerClassPair(cls: int): int;

extern class_addProtocol(cls: int, protocol: int): int;

extern add_method0(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int): int,
    types: str
): int = class_addMethod;

extern add_method1(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int, a: int): int,
    types: str
): int = class_addMethod;

extern add_method2(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int, a: int, b: int): int,
    types: str
): int = class_addMethod;

extern msg(receiver: int, selector: int): int = objc_msgSend;

extern msg1(receiver: int, selector: int, a: int): int = objc_msgSend;

extern msg2(
    receiver: int,
    selector: int,
    a: int,
    b: int
): int = objc_msgSend;

extern msg3(
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int
): int = objc_msgSend;

extern msg4(
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int,
    d: int
): int = objc_msgSend;

extern msg_f(receiver: int, selector: int): f64 = objc_msgSend;

extern msg_set_f(receiver: int, selector: int, value: f64): int = objc_msgSend;

extern msg_rect(
    receiver: int,
    selector: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64
): int = objc_msgSend;

extern l8_msg_hfa(
    out: []f64,
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int
): int;

// C's argc and argv, for UIApplicationMain.
extern l8rt_argc(): int;

extern l8rt_argv(): int;

extern UIApplicationMain(
    argc: int,
    argv: int,
    principal: int,
    delegate: int
): int;

extern NSHomeDirectory(): int;

// Bytes of C memory, and C strings.
extern strlen(p: int): int;

extern memcpy_from(dst: []i8, src: int, n: int): int = memcpy;

extern str_address(s: str): int = l8_as_int;

cls(name: str): int {
    objc_getClass(name)
}

sel(name: str): int {
    sel_registerName(name)
}

// An object of class name, made with alloc and init.
make(name: str): int {
    msg(msg(cls(name), sel("alloc")), sel("init"))
}

// An NSString with the text of s.
nsstring(s: str): int {
    msg1(cls("NSString"), sel("stringWithUTF8String:"), str_address(s))
}

// The bytes of an NSString (UTF-8).
nsstring_bytes(ns: int): []i8@new {
    if (ns == 0) return new i8[0](0i8);
    p: int = msg(ns, sel("UTF8String"));
    if (p == 0) return new i8[0](0i8);
    n: int = strlen(p);
    out: []i8 = new i8[n](0i8);
    if (n > 0) memcpy_from(out, p, n);
    out
}

// A result of up to four doubles: four in a new array.
msg_hfa(receiver: int, selector: int, a: int): []f64@new {
    out: []f64 = new f64[4](0.0f64);
    l8_msg_hfa(out, receiver, selector, a, 0, 0);
    out
}
