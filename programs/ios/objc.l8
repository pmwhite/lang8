tag ios;

use_tag std;

// Objective-C from L8, for apps on iOS (built with `l8 arm64 --target ios`).
//
// Objects are ints here (their addresses), so nil is 0 and needs no
// narrowing. A message is objc_msgSend, declared once for each shape of
// call: msg(receiver, selector, ...) with whole-number (or object) arguments
// and result; msg_f for a double result; msg_set_f for one double argument;
// msg_rect for a CGRect argument; and msg_hfa for a result of up to four
// doubles (a CGRect, a CGPoint, UIEdgeInsets), which the runtime stores in
// an array (L8 receives one float result, not four).
//
// Classes are made at run time (objc_allocateClassPair) and their methods
// are L8 functions passed by address (&name), called as C callbacks: the
// receiver and selector first, then the method's arguments, all ints.
// Methods take at most three arguments besides those two.
extern objc_getClass(name: str): int;

extern sel_registerName(name: str): int;

extern objc_getProtocol(name: str): int;

extern object_getClass(object: int): int;

extern objc_allocateClassPair(superclass: int, name: str, extra: int): int;

extern objc_registerClassPair(cls: int): int;

extern class_addProtocol(cls: int, protocol: int): int;

// A class of the program's, its methods added after (as a class
// registered may be given them): made and registered the first time; on a
// hot reload (RELOAD.md), the one the first build made, whose methods
// enter this build's functions of the same names, a method new to it
// added.
class_make(superclass: int, name: str): int {
    made: int = objc_getClass(name);
    if (made != 0) return made;
    fresh: int = objc_allocateClassPair(superclass, name, 0);
    _r: int = objc_registerClassPair(fresh);
    fresh
}

extern add_method0(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int): int,
    types: str
): int = class_addMethod;

extern add_method1(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int, a: int): int,
    types: str
): int = class_addMethod;

extern add_method2(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int, a: int, b: int): int,
    types: str
): int = class_addMethod;

extern add_method3(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int, a: int, b: int, c: int): int,
    types: str
): int = class_addMethod;

extern msg(receiver: int, selector: int): int = objc_msgSend;

extern msg1(receiver: int, selector: int, a: int): int = objc_msgSend;

extern msg2(
    receiver: int,
    selector: int,
    a: int,
    b: int
): int = objc_msgSend;

extern msg3(
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int
): int = objc_msgSend;

extern msg4(
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int,
    d: int
): int = objc_msgSend;

extern msg_f(receiver: int, selector: int): f64 = objc_msgSend;

extern msg_set_f(receiver: int, selector: int, value: f64): int = objc_msgSend;

extern msg_rect(
    receiver: int,
    selector: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64
): int = objc_msgSend;

extern l8_msg_hfa(
    out: []f64,
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int
): int;

// C's argc and argv, for UIApplicationMain.
extern l8rt_argc(): int;

extern l8rt_argv(): int;

// NSRunLoopCommonModes (a data symbol, which L8 cannot name).
extern l8_run_loop_common_modes(): int;

extern UIApplicationMain(
    argc: int,
    argv: int,
    principal: int,
    delegate: int
): int;

extern NSHomeDirectory(): int;

// Bytes of C memory, and C strings.
extern strlen(p: int): int;

extern memcpy_from(dst: []i8, src: int, n: int): int = memcpy;

extern str_address(s: str): int = l8_as_int;

extern bytes_address(b: []i8): int = l8_as_int;

cls(name: str): int {
    objc_getClass(name)
}

sel(name: str): int {
    sel_registerName(name)
}

// Declare that cls conforms to protocol name, if the runtime has that
// protocol: a protocol exists only once some loaded code has referred to it
// (CoreLocation's delegate protocol may not), and delegates are asked with
// respondsToSelector: anyway.
add_protocol(cls: int, name: str) {
    p: int = objc_getProtocol(name);
    if (p != 0) class_addProtocol(cls, p)
}

// An object of class name, made with alloc and init.
make(name: str): int {
    msg(msg(cls(name), sel("alloc")), sel("init"))
}

// An NSString with the text of s.
nsstring(s: str): int {
    msg1(cls("NSString"), sel("stringWithUTF8String:"), str_address(s))
}

// The bytes of an NSString (UTF-8).
nsstring_bytes(ns: int): []i8@new {
    if (ns == 0) return new i8[0](0i8);
    p: int = msg(ns, sel("UTF8String"));
    if (p == 0) return new i8[0](0i8);
    n: int = strlen(p);
    out: []i8 = new i8[n](0i8);
    if (n > 0) memcpy_from(out, p, n);
    out
}

// An NSString of the first n bytes of b (UTF-8), made without L8 memory.
nsstring_of(b: []i8, n: int): int {
    msg(msg3(msg(cls("NSString"), sel("alloc")), sel("initWithBytes:length:encoding:"),
        bytes_address(b), n, 4), sel("autorelease"))
}

// The bytes of an NSString (UTF-8) into out: how many (as many as fit).
nsstring_into(ns: int, out: []i8): int {
    if (ns == 0) return 0;
    p: int = msg(ns, sel("UTF8String"));
    if (p == 0) return 0;
    n: int = strlen(p);
    if (n > len(out)) n = len(out);
    if (n > 0) memcpy_from(out, p, n);
    n
}

// A result of up to four doubles: four in a new array.
msg_hfa(receiver: int, selector: int, a: int): []f64@new {
    out: []f64 = new f64[4](0.0f64);
    l8_msg_hfa(out, receiver, selector, a, 0, 0);
    out
}

// More shapes of message: two doubles (a CGSize or CGPoint, or a font's size
// and weight), with an int after them (animated:); an int then a double
// (fontWithDescriptor:size:); a double then an int.
extern msg_ff(
    receiver: int,
    selector: int,
    a: f64,
    b: f64
): int = objc_msgSend;

extern msg_ff1(
    receiver: int,
    selector: int,
    a: f64,
    b: f64,
    c: int
): int = objc_msgSend;

extern msg1_f(
    receiver: int,
    selector: int,
    a: int,
    b: f64
): int = objc_msgSend;

extern msg_f1(
    receiver: int,
    selector: int,
    a: f64,
    b: int
): int = objc_msgSend;

extern add_method4(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int, a: int, b: int, c: int, d: int): int,
    types: str
): int = class_addMethod;

// A message to the superclass's method (objc_msgSendSuper): for a method
// that overrides one which must still be called.
type ObjcSuper = {
    receiver: int;
    super_class: int
}

extern msg_super1(sup: *ObjcSuper, selector: int, a: int): int = objc_msgSendSuper;

extern class_getSuperclass(cls: int): int;

// [super selector:a], from a method of cls (the class that defines it).
super1(
    self: int,
    cls: int,
    selector: int,
    a: int
): int {
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(cls) };
    msg_super1(&sup, selector, a)
}

// A framework's constant (NSFontAttributeName, UIFontTextStyleBody), a
// data symbol, which L8 cannot name: looked up by name.
extern dlsym(handle: int, name: str): int;

extern memcpy_ints(dst: []int, src: int, n: int): int = memcpy;

extern ints_address(b: []int): int = l8_as_int;

objc_word: []int = new int[1](0);

objc_const(name: str): int {
    p: int = dlsym(-2, name);
    if (p == 0) return 0;
    memcpy_ints(objc_word, p, 8);
    objc_word[0]
}

// A framework's constant that is a double (UITableViewAutomaticDimension).
extern memcpy_doubles(dst: []f64, src: int, n: int): int = memcpy;

objc_double: []f64 = new f64[1](0.0f64);

objc_const_f(name: str): f64 {
    p: int = dlsym(-2, name);
    if (p == 0) return 0.0f64;
    memcpy_doubles(objc_double, p, 8);
    objc_double[0]
}

// Objects kept by L8 (in globals) past the autorelease pool they came in.
keep(object: int): int {
    msg(object, sel("retain"))
}

// An NSString of n bytes (UTF-8) at address p, autoreleased.
nsstring_at(p: int, n: int): int {
    msg(msg3(msg(cls("NSString"), sel("alloc")), sel("initWithBytes:length:encoding:"),
        p, n, 4), sel("autorelease"))
}

// The n bytes at p as a string, any that are not UTF-8 each read as
// U+FFFD (NSString's UTF-8 is all or nothing: nil for one bad byte).
nsstring_lossy_at(p: int, n: int): int {
    s: int = nsstring_at(p, n);
    if (s != 0 || n == 0) return s;
    region {
        src: []i8 = new i8[n](0i8);
        memcpy_from(src, p, n);
        out: []i8 = new i8[n * 3](0i8);
        m: int = 0;
        i: int = 0;
        while (i < n) {
            k: int = src[i] as int & 255;
            len: int = if (k < 128) 1 else if (k >= 194 && k <= 223) 2 else if (k >= 224 && k <= 239) 3 else if (k >= 240 && k <= 244) 4 else 0;
            good: bool = len > 0 && i + len <= n;
            for x in 1..if (good) len else 1
                if ((src[i + x] as int & 192) != 128) good = false;
            if (good) {
                for x in 0..len out[m + x] = src[i + x];
                m = m + len;
                i = i + len
            } else {
                out[m] = 239 trunc i8;
                out[m + 1] = 191 trunc i8;
                out[m + 2] = 189 trunc i8;
                m = m + 3;
                i = i + 1
            }
        }
        s = keep(nsstring_at(bytes_address(out), m))
    }
    msg(s, sel("autorelease"))
}

// A dictionary of n keys and their values (objects, in arrays).
nsdictionary(keys: []int, values: []int, n: int): int {
    msg3(cls("NSDictionary"), sel("dictionaryWithObjects:forKeys:count:"), ints_address(values),
        ints_address(keys), n)
}

// An array of the first n objects of a.
nsarray(a: []int, n: int): int {
    msg2(cls("NSArray"), sel("arrayWithObjects:count:"), ints_address(a), n)
}

// An NSNumber.
nsnumber_f(x: f64): int {
    msg_set_f(cls("NSNumber"), sel("numberWithDouble:"), x)
}
