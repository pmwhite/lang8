tag ios_check;

use_tag std, ios;

// A check of the arm64 runtime on iOS, without UIKit: run it in the
// simulator (`xcrun simctl spawn DEVICE check`) and it says what works:
// the heap, calls and recursion, floats, exceptions, files, a C function
// calling L8 back (qsort), and Objective-C messages. Each line says ok, or
// what went wrong; it returns 0 when all are ok.
import "../../stdlib/print.l8";

import "objc.l8";

extern qsort(
    base: []int,
    count: int,
    width: int,
    compare: fn(a: *int, b: *int): i32
): int;

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

exception Oops {
    code: int
}

failed: int = 0;

say(what: str, good: bool) raises IoError {
    if (good) {
        print_no_newline(what);
        print(": ok")
    } else {
        print_no_newline(what);
        print(": WRONG");
        failed = failed + 1
    }
}

print_no_newline(s: str) raises IoError {
    write(1, s)
}

fib(n: int): int {
    if (n < 2) return n;
    fib(n - 1) + fib(n - 2)
}

compare(a: *int, b: *int): i32 {
    if (a.* < b.*) return -1i32;
    if (a.* > b.*) return 1i32;
    0i32
}

deep(n: int) raises Oops {
    if (n == 0) raise Oops { code: 42 };
    deep(n - 1)
}

main() raises IoError: int {
    print("check: arm64 on iOS");
    say("calls and recursion", fib(25) == 75025);
    big: []int = new int[100000](7);
    say("the heap", len(big) == 100000 && big[99999] == 7);
    x: f32 = 1.5;
    y: f64 = 2.25f64;
    say("floats", x * 2.0 == 3.0 && (y * 4.0f64) as int == 9);
    caught: int = 0;
    try {
        deep(50)
    } with Oops e -> {
        caught = e.code
    }
    say("exceptions", caught == 42);
    path: str = cstr(nsstring_bytes(NSHomeDirectory()));
    say("the home directory", len(path) > 1);
    sorted: []int = [5, 3, 9, 1, 7];
    qsort(sorted, 5, 8, &compare);
    say("C calling L8 back (qsort)", sorted[0] == 1 && sorted[2] == 5 && sorted[4] == 9);
    s: int = nsstring("Tempo on arm64");
    back: []i8 = nsstring_bytes(s);
    say("Objective-C messages", len(back) == 14 && back[0] == 'T');
    n: int = msg(nsstring("four"), sel("length"));
    say("a message's result", n == 4);
    fd: int = open("/tmp/l8-check.txt", 577, 420);
    if (fd >= 0) {
        write(fd, "hello\n");
        close(fd)
    }
    rd: int = open("/tmp/l8-check.txt", 0, 0);
    buf: []i8 = new i8[16](0i8);
    got: int = 0;
    if (rd >= 0) {
        got = read(rd, buf, 0, 16);
        close(rd)
    }
    say("files (open's flags made Apple's)", got == 6 && buf[0] == 'h');
    if (failed == 0) print("check: all ok") else print("check: some WRONG");
    failed
}
