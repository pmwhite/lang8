tag ios;

use_tag std;

// The one block an app may make (Smooth Bible's DESIGN.md §10.2.3): a
// global block, as the compiler makes for a block that captures nothing,
// built by hand in memory that is never freed. Its invoke is an L8
// function (called through its C-entry stub, so from any thread), which is
// given the block and then the block's own arguments. A global block is
// never copied or freed by the runtime (_Block_copy returns it as it is).
// Nothing else in an app should take this path without a design change.
import "objc.l8";

extern fn_address3(f: fn(block: int, a: int, b: int): int): int = l8_as_int;

extern fn_address1(f: fn(block: int): int): int = l8_as_int;

// The blocks made (four words each: isa; flags and reserved; invoke;
// descriptor), and their descriptor (reserved, size).
block_words: []int = static_buffer([32]int);

block_descriptor: []int = [0, 32];

blocks_made: int = 0;

// BLOCK_IS_GLOBAL.
BLOCK_GLOBAL: int = 268435456;

block_of(invoke: int): int {
    if (blocks_made * 4 >= len(block_words)) return 0;
    i: int = blocks_made * 4;
    blocks_made = blocks_made + 1;
    block_words[i] = dlsym(-2, "_NSConcreteGlobalBlock");
    block_words[i + 1] = BLOCK_GLOBAL;
    block_words[i + 2] = invoke;
    block_words[i + 3] = ints_address(block_descriptor);
    ints_address(block_words) + i * 8
}

// A block of two arguments (void (^)(BOOL, NSError *), say): its address, to
// pass where a block is wanted.
global_block(f: fn(block: int, a: int, b: int): int): int {
    block_of(fn_address3(f))
}

// A block of none (void (^)(void)).
global_block0(f: fn(block: int): int): int {
    block_of(fn_address1(f))
}

// A block given to us (a completion handler), called with no arguments:
// sent -invoke, which every block (an NSBlock) answers, rather than called
// through its invoke pointer, which L8 cannot call as C.
call_block(b: int) {
    if (b != 0) msg(b, sel("invoke"))
}
