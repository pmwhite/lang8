tag race;

import "../../stdlib/raw_write.l8";

extern race_storage_exit(code: int): noreturn = exit;

race_storage_full(): noreturn {
    raw::raw_write(2, "race: static storage exhausted\n");
    race_storage_exit(1)
}

race_car_slots: []i8 = static_buffer([65536]i8);

race_car_used: int = 0;

extern race_car_at(p: *i8): *Car = l8_as_int;

race_take_car(value: Car): *Car {
    i: int = race_car_used;
    if (i >= 64 || sizeof(Car) > 1024) race_storage_full();
    race_car_used = i + 1;
    out: *Car = race_car_at(&race_car_slots[i * 1024]);
    out.* = value;
    out
}

race_bot_slots: []i8 = static_buffer([1792]i8);

race_bot_used: int = 0;

extern race_bot_at(p: *i8): *Bot = l8_as_int;

race_take_bot(value: Bot): *Bot {
    i: int = race_bot_used;
    if (i >= 7 || sizeof(Bot) > 256) race_storage_full();
    race_bot_used = i + 1;
    out: *Bot = race_bot_at(&race_bot_slots[i * 256]);
    out.* = value;
    out
}

race_other_slots: []i8 = static_buffer([8192]i8);

race_other_used: int = 0;

extern race_other_at(p: *i8): *Other = l8_as_int;

race_take_other(value: Other): *Other {
    i: int = race_other_used;
    if (i >= 16 || sizeof(Other) > 512) race_storage_full();
    race_other_used = i + 1;
    out: *Other = race_other_at(&race_other_slots[i * 512]);
    out.* = value;
    out
}

race_renderer_slots: []i8 = static_buffer([4096]i8);

race_renderer_used: int = 0;

extern race_renderer_at(p: *i8): *Renderer = l8_as_int;

race_take_renderer(value: Renderer): *Renderer {
    i: int = race_renderer_used;
    if (i >= 1 || sizeof(Renderer) > 4096) race_storage_full();
    race_renderer_used = i + 1;
    out: *Renderer = race_renderer_at(&race_renderer_slots[i * 4096]);
    out.* = value;
    out
}
