tag race;

use_tag skate;

// What shows in the air, for a moment: the smoke of tyres that slide on the
// road, and the dust they raise off it; the flame at the back of a car that
// has its push; and the air itself, as fine streaks going by, where a car
// drafts another or is pushed. Each is a small flat shape that faces the
// eye, and fades: where it is and how it moves, what color, how big (and
// how fast it grows), how long it has lasted and will, and how much of it
// shows at the most.
const MAX_FX: int = 240;

// Smoke and dust: soft, round, drifting, and swelling.
const FX_SMOKE: int = 0;

// Air: a fine streak, lying along the way it is told, and staying where it
// is.
const FX_STREAK: int = 1;

// Flame: small, bright, and quick.
const FX_FLAME: int = 2;

fx_kind: []int = static_buffer(MAX_FX, 0);

fx_p: []V3 = static_buffer(MAX_FX, V3 { x: 0.0, y: 0.0, z: 0.0 });

fx_v: []V3 = static_buffer(MAX_FX, V3 { x: 0.0, y: 0.0, z: 0.0 });

fx_col: []V3 = static_buffer(MAX_FX, V3 { x: 0.0, y: 0.0, z: 0.0 });

fx_size: []f32 = static_buffer(MAX_FX, 0.0);

fx_grow: []f32 = static_buffer(MAX_FX, 0.0);

fx_age: []f32 = static_buffer(MAX_FX, 1.0);

fx_life: []f32 = static_buffer(MAX_FX, 0.0);

fx_show: []f32 = static_buffer(MAX_FX, 0.0);

// Where the next one goes (the oldest gives way).
fx_next: int = 0;

fx_rng: int = 11;

fx_rand(): f32 {
    fx_rng = (fx_rng * 1103515245 + 12345) % 2147483648;
    (fx_rng / 4096 % 100000) as f32 / 100000.0
}

// A number from -1 to 1.
fx_either(): f32 {
    fx_rand() * 2.0 - 1.0
}

put_fx(
    kind: int,
    p: V3,
    v: V3,
    col: V3,
    size: f32,
    grow: f32,
    life: f32,
    show: f32
) {
    k: int = fx_next;
    fx_next = (fx_next + 1) % MAX_FX;
    fx_kind[k] = kind;
    fx_p[k] = p;
    fx_v[k] = v;
    fx_col[k] = col;
    fx_size[k] = size;
    fx_grow[k] = grow;
    fx_age[k] = 0.0;
    fx_life[k] = life;
    fx_show[k] = show
}

// Carry them on by dt. (Smoke slows, and rises a little; a streak stays.)
tick_fx(dt: f32) {
    for k in 0..MAX_FX {
        if (fx_age[k] < fx_life[k]) {
            fx_age[k] = fx_age[k] + dt;
            fx_size[k] = maxf(fx_size[k] + fx_grow[k] * dt, 0.01);
            if (fx_kind[k] != FX_STREAK) fx_p[k] = v_madd(fx_p[k], fx_v[k], dt);
            if (fx_kind[k] == FX_SMOKE) {
                fx_v[k] = v_scale(fx_v[k], 1.0 - minf(2.5 * dt, 1.0));
                fx_v[k].y = fx_v[k].y + 1.2 * dt
            }
        }
    }
}

// ---- what makes them ----
// Whether something that comes `rate` times a second comes now, in dt.
fx_now(rate: f32, dt: f32): bool {
    fx_rand() < rate * dt
}

smoke_color: V3 = V3 { x: 0.86, y: 0.85, z: 0.83 };

dust_color: V3 = V3 { x: 0.62, y: 0.52, z: 0.38 };

sand_color: V3 = V3 { x: 0.84, y: 0.74, z: 0.54 };

snow_color: V3 = V3 { x: 0.95, y: 0.97, z: 1.0 };

mud_color: V3 = V3 { x: 0.2, y: 0.13, z: 0.08 };

// What a wheel throws up from the ground of a kind (see track.l8).
ground_dust(ground: int): V3 {
    if (ground == SAND && road_kind() != PACK) return sand_color;
    if (ground == SAND || ground == SNOW || ground == PACK) return snow_color;
    if (ground == MUD) return mud_color;
    dust_color
}

// A car's back wheels: smoke where they slide on the road, more the faster
// they slide; and dust wherever they are off it and moving, more if they
// slide.
fx_wheels(c: *Car, dt: f32) {
    slide: f32 = absf(c.skid);
    fast: f32 = v_len(c.v);
    for k in 2..4 {
        rate: f32 = 0.0;
        col: V3 = smoke_color;
        show: f32 = 0.34;
        if (c.on_road[k]) {
            if (slide > 3.0) rate = 22.0 * minf((slide - 3.0) / 6.0, 1.4);
            // (A road that is not tarred throws up what it is made of,
            // and a little of it even from wheels that do not slide.)
            if (road_kind() != ROAD) {
                col = ground_dust(road_kind());
                if (fast > 12.0) rate = rate + 3.0
            }
        } else if (fast > 6.0) {
            rate = 5.0 + 2.5 * slide;
            col = ground_dust(spot_ground(c.spot));
            show = 0.26;
            if (spot_ground(c.spot) == MUD) show = 0.5
        }
        if (rate > 0.0 && fx_now(rate, dt)) {
            w: V3 = wheel_at(c, k);
            w.y = c.wheel_y[k] + 0.18;
            v: V3 = v_scale(c.v, 0.22);
            v = v_add(v, v3(fx_either() * 0.8, 0.5 + 0.6 * fx_rand(), fx_either() * 0.8));
            put_fx(FX_SMOKE, w, v, v_scale(col, 0.92 + 0.12 * fx_rand()), 0.3 + 0.2 * fx_rand(),
                1.5 + fx_rand(), 0.55 + 0.4 * fx_rand(), show)
        }
    }
}

// The back of a car that has its push: flame from under its tail, as long
// as the push lasts, with a blue heart to it; and while a drift has earned
// one that is not yet let go, a spit of flame now and then.
fx_tail(c: *Car, dt: f32) {
    rate: f32 = 0.0;
    big: f32 = 1.0;
    if (c.push > 0.0) rate = 90.0 else if (c.drift && c.held >= PUSH_LEAST) {
        rate = 9.0;
        big = 0.6
    }
    if (rate == 0.0) return;
    f: V3 = yaw_dir(c.yaw);
    r: V3 = right_of(f);
    for _n in 0..3 {
        if (fx_now(rate / 3.0, dt)) {
            p: V3 = v_madd(v_madd(c.p, f, -(car_axle[c.kind] + 0.5)), r, fx_either() * 0.22);
            p.y = car_y(c) + 0.36 + fx_either() * 0.05;
            v: V3 = v_madd(c.v, f, -(2.5 + 4.0 * fx_rand()));
            hot: f32 = fx_rand();
            col: V3 = v3(1.0, 0.5 + 0.35 * hot, 0.12 + 0.2 * hot);
            if (hot > 0.75) col = v3(0.5, 0.72, 1.0);
            put_fx(FX_FLAME, p, v, col, (0.14 + 0.14 * fx_rand()) * big, -0.8, 0.06 + 0.08 * fx_rand(),
                0.9)
        }
    }
}

// The air about a car, shown as far as `much` says (from 0 to 1): fine
// streaks ahead of it and to either side, lying along its way, which it
// passes through.
fx_air(c: *Car, much: f32, dt: f32) {
    fast: f32 = v_len(c.v);
    if (much < 0.08 || fast < 8.0) return;
    way: V3 = v_scale(c.v, 1.0 / fast);
    side: V3 = right_of(way);
    for _n in 0..3 {
        if (fx_now(45.0 * much, dt)) {
            p: V3 = v_madd(v_madd(c.p, way, 1.0 + 15.0 * fx_rand()), side, fx_either() * 2.1);
            p.y = car_y(c) + 0.3 + 1.6 * fx_rand();
            put_fx(FX_STREAK, p, way, v3(1.0, 1.0, 1.0), 1.6 + 1.8 * fx_rand(), 0.0,
                0.22 + 0.14 * fx_rand(), 0.95 * much)
        }
    }
}

// ---- drawing them ----
// Each as two triangles: a corner is its place; where on the shape it is
// (-1 to 1 each way), and how much of the shape shows; its color, and its
// kind. The smoke and the streaks come first, then the flames (which are
// drawn as light added: see draw_fx, in render.l8).
const FX_FLOATS: int = 10;

fx_verts: []f32 = static_buffer(MAX_FX * 6 * FX_FLOATS, 0.0);

fx_soft: int = 0;

fx_bright: int = 0;

fx_corner(
    at: int,
    p: V3,
    u: f32,
    v: f32,
    show: f32,
    k: int
) {
    fx_verts[at] = p.x;
    fx_verts[at + 1] = p.y;
    fx_verts[at + 2] = p.z;
    fx_verts[at + 3] = u;
    fx_verts[at + 4] = v;
    fx_verts[at + 5] = show;
    fx_verts[at + 6] = fx_col[k].x;
    fx_verts[at + 7] = fx_col[k].y;
    fx_verts[at + 8] = fx_col[k].z;
    fx_verts[at + 9] = fx_kind[k] as f32
}

// The shapes as they are now, for an eye at `eye` looking at `at`.
build_fx(eye: V3, at: V3) {
    f: V3 = v_norm(v_sub(at, eye));
    right: V3 = v_norm(v_cross(f, v3(0.0, 1.0, 0.0)));
    up: V3 = v_cross(right, f);
    n: int = 0;
    fx_soft = 0;
    for pass in 0..2 {
        for k in 0..MAX_FX {
            bright: bool = fx_kind[k] == FX_FLAME;
            if (fx_age[k] < fx_life[k] && bright == (pass == 1)) {
                u: f32 = fx_age[k] / fx_life[k];
                // (It comes quickly, and goes slowly.)
                show: f32 = fx_show[k] * minf(u * 8.0, 1.0) * (1.0 - u);
                a: V3 = v_scale(right, fx_size[k]);
                b: V3 = v_scale(up, fx_size[k]);
                if (fx_kind[k] == FX_STREAK) {
                    a = v_scale(fx_v[k], fx_size[k]);
                    b = v_scale(v_norm(v_cross(fx_v[k], v_sub(eye, fx_p[k]))), 0.055)
                }
                p: V3 = fx_p[k];
                o: int = n * FX_FLOATS;
                fx_corner(o, v_sub(v_sub(p, a), b), -1.0, -1.0, show, k);
                fx_corner(o + FX_FLOATS, v_sub(v_add(p, a), b), 1.0, -1.0, show, k);
                fx_corner(o + 2 * FX_FLOATS, v_add(v_add(p, a), b), 1.0, 1.0, show,
                    k);
                fx_corner(o + 3 * FX_FLOATS, v_sub(v_sub(p, a), b), -1.0, -1.0, show,
                    k);
                fx_corner(o + 4 * FX_FLOATS, v_add(v_add(p, a), b), 1.0, 1.0, show,
                    k);
                fx_corner(o + 5 * FX_FLOATS, v_add(v_sub(p, a), b), -1.0, 1.0, show,
                    k);
                n = n + 6
            }
        }
        if (pass == 0) fx_soft = n
    }
    fx_bright = n - fx_soft
}
