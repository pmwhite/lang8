tag race;

use_tag skate;

// Vertex arrays for the world and the car. A vertex is twelve floats:
// position, normal, color, a material code the fragment shader reads (see
// render.l8), and two numbers more for the material's own use (see
// set_extra). A normal's length is how open the sky is over it, for ambient
// occlusion: most are 1.
const VERTEX_FLOATS: int = 12;

// The two numbers the next vertices get.
extra_u: f32 = 0.0;

extra_v: f32 = 0.0;

set_extra(u: f32, v: f32) {
    extra_u = u;
    extra_v = v
}

// The canyon's floor: road, grass, and sand, told apart pixel by pixel.
// Its color is not a color: how deep into sand it is, and how far from the
// wall (in metres); and its two numbers are where it is on the track, d
// and s (see track.l8). It casts no shadow.
const MAT_GROUND: f32 = 0.0;

// The canyon's walls: layered rock that fades into the sky as it rises.
// Its two numbers are the height of its foot, and the height up to which
// it casts a shadow.
const MAT_ROCK: f32 = 2.0;

// Bare metal.
const MAT_METAL: f32 = 4.0;

// The car's paint: soft, with a sheen.
const MAT_SOFT: f32 = 5.0;

// Its windows: dark, and shiny.
const MAT_GLASS: f32 = 6.0;

const MAT_PAINT: f32 = 7.0;

// Tyres: dull.
const MAT_RUBBER: f32 = 8.0;

const MAT_LEAF: f32 = 9.0;

// Glowing: unlit by anything else.
const MAT_GLOW: f32 = 10.0;

type Mesh = {
    data: []f32;
    n: int
}

new_mesh(capacity: int): *Mesh@new {
    new Mesh { data: new f32[capacity * VERTEX_FLOATS](0.0), n: 0 }
}

put(
    m: *Mesh,
    p: V3,
    n: V3,
    c: V3,
    mat: f32
) {
    i: int = m.n * VERTEX_FLOATS;
    if (i + VERTEX_FLOATS > len(m.data)) return;
    m.data[i] = p.x;
    m.data[i + 1] = p.y;
    m.data[i + 2] = p.z;
    m.data[i + 3] = n.x;
    m.data[i + 4] = n.y;
    m.data[i + 5] = n.z;
    m.data[i + 6] = c.x;
    m.data[i + 7] = c.y;
    m.data[i + 8] = c.z;
    m.data[i + 9] = mat;
    m.data[i + 10] = extra_u;
    m.data[i + 11] = extra_v;
    m.n = m.n + 1
}

// A flat quad a b c d (in order around it).
put_quad(
    m: *Mesh,
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    n: V3,
    col: V3,
    mat: f32
) {
    put(m, a, n, col, mat);
    put(m, b, n, col, mat);
    put(m, c, n, col, mat);
    put(m, a, n, col, mat);
    put(m, c, n, col, mat);
    put(m, d, n, col, mat)
}

// A block: a box with its top edges bevelled, as a brick, a plank, or a
// post is, its middle at c, its axes right, up, and fwd (each of unit
// length, square to one another), its half sizes h; without its bottom,
// which sits on something. Its sides darken toward their feet.
put_block(
    m: *Mesh,
    c: V3,
    right: V3,
    up: V3,
    fwd: V3,
    h: V3,
    bevel: f32,
    col: V3,
    mat: f32
) {
    b: f32 = minf(bevel, minf(h.x, minf(h.y, h.z)) * 0.9);
    // Corners of the top (inset by the bevel), of the bevel's foot, and of
    // the foot of the sides; going round from -x -z.
    sx: []f32 = [-1.0, 1.0, 1.0, -1.0];
    sz: []f32 = [-1.0, -1.0, 1.0, 1.0];
    top: []V3 = block_ring;
    mid: []V3 = block_ring2;
    foot: []V3 = block_ring3;
    for k in 0..4 {
        top[k] = v_add(v_add(c, v_scale(up, h.y)), v_add(v_scale(right, sx[k] * (h.x - b)),
            v_scale(fwd, sz[k] * (h.z - b))));
        mid[k] = v_add(v_add(c, v_scale(up, h.y - b)), v_add(v_scale(right, sx[k] * h.x),
            v_scale(fwd, sz[k] * h.z)));
        foot[k] = v_add(v_add(c, v_scale(up, -h.y)), v_add(v_scale(right, sx[k] * h.x),
            v_scale(fwd, sz[k] * h.z)))
    }
    put_quad(m, top[0], top[3], top[2], top[1], up, col, mat);
    for k in 0..4 {
        n: int = (k + 1) % 4;
        // Outward across this edge.
        out: V3 = v_norm(v_add(v_scale(right, sx[k] + sx[n]), v_scale(fwd, sz[k] + sz[n])));
        put_quad(m, top[k], top[n], mid[n], mid[k], v_norm(v_add(up, out)), col, mat);
        put_quad_n(m, mid[k], mid[n], foot[n], foot[k], out, out, v_scale(out, 0.6),
            v_scale(out, 0.6), col, mat)
    }
}

block_ring: []V3 = new V3[4](V3 { x: 0.0, y: 0.0, z: 0.0 });

block_ring2: []V3 = new V3[4](V3 { x: 0.0, y: 0.0, z: 0.0 });

block_ring3: []V3 = new V3[4](V3 { x: 0.0, y: 0.0, z: 0.0 });

// A quad with a normal at each corner.
put_quad_n(
    m: *Mesh,
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    na: V3,
    nb: V3,
    nc: V3,
    nd: V3,
    col: V3,
    mat: f32
) {
    put(m, a, na, col, mat);
    put(m, b, nb, col, mat);
    put(m, c, nc, col, mat);
    put(m, a, na, col, mat);
    put(m, c, nc, col, mat);
    put(m, d, nd, col, mat)
}

// ---- rounded boxes ----
// Samples along one axis of a box's face, in [-1, 1]: bands of `band` steps
// over the rounded edges and a step either side of the middle.
box_samples(
    out: []f32,
    half: f32,
    r: f32,
    band: int
): int {
    c: f32 = (half - r) / half;
    if (c < 0.0) c = 0.0;
    n: int = 0;
    for i in 0..band + 1 {
        out[n] = -1.0 + (1.0 - c) * i as f32 / band as f32;
        n = n + 1
    }
    if (c > 0.0) {
        out[n] = 0.0;
        n = n + 1;
        for i in 0..band + 1 {
            out[n] = c + (1.0 - c) * i as f32 / band as f32;
            n = n + 1
        }
    } else {
        for i in 1..band + 1 {
            out[n] = (1.0 - c) * i as f32 / band as f32;
            n = n + 1
        }
    }
    n
}

box_point(
    q: V3,
    half: V3,
    r: f32,
    bulge: f32,
    out_n: *V3
): V3 {
    p: V3 = v3(q.x * half.x, q.y * half.y, q.z * half.z);
    inner: V3 = v3(clampf(p.x, -(half.x - r), half.x - r), clampf(p.y, -(half.y - r),
        half.y - r), clampf(p.z, -(half.z - r), half.z - r));
    n: V3 = v_norm(v_sub(p, inner));
    // Faces puff out toward their middles.
    puff: f32 = (1.0 - q.x * q.x * absf(q.x)) * (1.0 - q.y * q.y * absf(q.y)) * (1.0 - q.z * q.z * absf(q.z));
    out_n.* = n;
    v_madd(inner, n, r + bulge * puff * 4.0)
}

box_su: []f32 = new f32[64](0.0);

box_sv: []f32 = new f32[64](0.0);

// A rounded box of half sizes `half` and corner radius r, puffed out by
// bulge, placed by the matrix xf.
put_rounded_box(
    m: *Mesh,
    xf: []f32,
    half: V3,
    r: f32,
    bulge: f32,
    band: int,
    col: V3,
    mat: f32
) {
    for axis in 0..3 {
        for side in 0..2 {
            s: f32 = 1.0;
            if (side == 0) s = -1.0;
            // Axes u and v across the face.
            hu: f32 = half.y;
            hv: f32 = half.z;
            if (axis == 1) {
                hu = half.z;
                hv = half.x
            }
            if (axis == 2) {
                hu = half.x;
                hv = half.y
            }
            nu: int = box_samples(box_su, hu, r, band);
            nv: int = box_samples(box_sv, hv, r, band);
            for i in 0..nu - 1 {
                for j in 0..nv - 1 {
                    a: V3 = face_q(axis, s, box_su[i], box_sv[j]);
                    b: V3 = face_q(axis, s, box_su[i + 1], box_sv[j]);
                    c: V3 = face_q(axis, s, box_su[i + 1], box_sv[j + 1]);
                    d: V3 = face_q(axis, s, box_su[i], box_sv[j + 1]);
                    na: V3 = v3(0.0, 1.0, 0.0);
                    nb: V3 = na;
                    nc: V3 = na;
                    nd: V3 = na;
                    pa: V3 = box_point(a, half, r, bulge, &na);
                    pb: V3 = box_point(b, half, r, bulge, &nb);
                    pc: V3 = box_point(c, half, r, bulge, &nc);
                    pd: V3 = box_point(d, half, r, bulge, &nd);
                    put_quad_n(m, mat_point(xf, pa), mat_point(xf, pb), mat_point(xf,
                        pc), mat_point(xf, pd), v_norm(mat_vector(xf, na)), v_norm(mat_vector(xf,
                        nb)), v_norm(mat_vector(xf, nc)), v_norm(mat_vector(xf, nd)),
                        col, mat)
                }
            }
        }
    }
}

face_q(
    axis: int,
    s: f32,
    u: f32,
    v: f32
): V3 {
    if (axis == 0) return v3(s, u, v);
    if (axis == 1) return v3(v, s, u);
    v3(u, v, s)
}

// A tube from a to b.
put_tube(
    m: *Mesh,
    a: V3,
    b: V3,
    radius: f32,
    col: V3,
    mat: f32
) {
    axis: V3 = v_norm(v_sub(b, a));
    p: V3 = v_norm(v_cross(axis, v3(0.0, 1.0, 0.0)));
    if (absf(axis.y) > 0.9) p = v_norm(v_cross(axis, v3(1.0, 0.0, 0.0)));
    q: V3 = v_cross(axis, p);
    sides: int = 10;
    for i in 0..sides {
        a0: f32 = TAU * i as f32 / sides as f32;
        a1: f32 = TAU * (i + 1) as f32 / sides as f32;
        n0: V3 = v_add(v_scale(p, cosf(a0)), v_scale(q, sinf(a0)));
        n1: V3 = v_add(v_scale(p, cosf(a1)), v_scale(q, sinf(a1)));
        put_quad_n(m, v_madd(a, n0, radius), v_madd(a, n1, radius), v_madd(b, n1,
            radius), v_madd(b, n0, radius), n0, n1, n1, n0, col, mat)
    }
}

xf: []f32 = new f32[16](0.0);

// Where the next rounded box goes: its middle.
at(x: f32, y: f32, z: f32) {
    mat_identity(xf);
    xf[12] = x;
    xf[13] = y;
    xf[14] = z
}

leaf_color: V3 = V3 { x: 0.3, y: 0.5, z: 0.16 };

meadow_rng: int = 1;

meadow_rand(): f32 {
    meadow_rng = (meadow_rng * 1103515245 + 12345) % 2147483648;
    (meadow_rng % 100000) as f32 / 100000.0
}

// ---- scenery ----
// Trees: broad oaks and pines, each one a little different. A crown is a
// few clumps of small leaves around darker cores, so its edges break up
// and light comes through; a pine is tiers of drooping needle sprays.
put_tree(
    m: *Mesh,
    x: f32,
    z: f32,
    ground: f32,
    size: f32
) {
    meadow_rng = absi_m((x * 73.0) as int * 977 + (z * 31.0) as int * 131 + 7) + 1;
    pine: bool = meadow_rand() < 0.35;
    if (pine) put_pine(m, x, z, ground - 0.05, size * 1.1) else put_oak(m, x, z, ground - 0.05,
        size)
}

absi_m(a: int): int {
    if (a < 0) return -a;
    a
}

bark: V3 = V3 { x: 0.36, y: 0.27, z: 0.2 };

put_oak(
    m: *Mesh,
    x: f32,
    z: f32,
    y: f32,
    size: f32
) {
    base: V3 = v3(x, y, z);
    lean: V3 = v3((meadow_rand() - 0.5) * 0.4, 0.0, (meadow_rand() - 0.5) * 0.4);
    top: V3 = v_add(v3(x, y + 1.7 * size, z), v_scale(lean, size));
    put_cone(m, base, top, 0.2 * size, 0.11 * size, bark);
    shade: f32 = 0.85 + 0.3 * meadow_rand();
    leaf: V3 = v_scale(leaf_color, shade);
    clumps: int = 3 + (meadow_rand() * 2.0) as int;
    for k in 0..clumps {
        a: f32 = TAU * (k as f32 + meadow_rand() * 0.5) / clumps as f32;
        out: f32 = 0.55 * size * (0.6 + 0.6 * meadow_rand());
        c: V3 = v_add(top, v3(cosf(a) * out, (0.7 + 0.6 * meadow_rand()) * size, sinf(a) * out));
        // A branch out to it.
        put_cone(m, v_lerp(base, top, 0.8), v_lerp(top, c, 0.7), 0.08 * size, 0.04 * size,
            bark);
        r: f32 = (0.75 + 0.35 * meadow_rand()) * size;
        put_clump(m, c, v3(r, r * 0.75, r), leaf, 48)
    }
    // And one on top.
    put_clump(m, v_add(top, v3(0.0, 1.5 * size, 0.0)), v3(0.8 * size, 0.6 * size,
        0.8 * size), leaf, 40)
}

// A clump of leaves round c: a dark core, and leaves scattered over it, lit
// as if the clump were round.
put_clump(
    m: *Mesh,
    c: V3,
    r: V3,
    leaf: V3,
    count: int
) {
    put_ellipsoid(m, c, v_scale(r, 0.82), v_scale(leaf, 0.55), MAT_LEAF);
    for _k in 0..count {
        // A direction, mostly up and out.
        u: f32 = meadow_rand() * 2.0 - 1.0;
        a: f32 = meadow_rand() * TAU;
        sq: f32 = sqrtf(maxf(0.0, 1.0 - u * u));
        d: V3 = v3(sq * cosf(a), u * 0.9 + 0.1, sq * sinf(a));
        d = v_norm(d);
        p: V3 = v3(c.x + d.x * r.x, c.y + d.y * r.y, c.z + d.z * r.z);
        p = v_lerp(c, p, 0.88 + 0.22 * meadow_rand());
        // A leaf: a small triangle at a random tilt.
        t1: V3 = v_norm(v_cross(d, v3(meadow_rand() - 0.5, 1.0, meadow_rand() - 0.5)));
        t2: V3 = v_cross(d, t1);
        sz: f32 = (0.22 + 0.14 * meadow_rand()) * maxf(r.x, 0.6);
        k: f32 = 0.8 + 0.4 * meadow_rand();
        // Leaves on the sunny top are a little yellower.
        col: V3 = v3(leaf.x * k * (1.0 + 0.25 * maxf(d.y, 0.0)), leaf.y * k, leaf.z * k);
        n: V3 = v_norm(v_add(d, v_scale(t2, 0.3)));
        put(m, v_madd(p, t1, sz), n, col, MAT_LEAF);
        put(m, v_madd(v_madd(p, t1, -sz * 0.5), t2, sz * 0.8), n, col, MAT_LEAF);
        put(m, v_madd(v_madd(p, t1, -sz * 0.5), t2, -sz * 0.8), n, col, MAT_LEAF)
    }
}

put_pine(
    m: *Mesh,
    x: f32,
    z: f32,
    y: f32,
    size: f32
) {
    h: f32 = 4.2 * size;
    put_cone(m, v3(x, y, z), v3(x, y + h, z), 0.16 * size, 0.03 * size, bark);
    shade: f32 = 0.85 + 0.3 * meadow_rand();
    needle: V3 = v3(0.13 * shade, 0.3 * shade, 0.17 * shade);
    tiers: int = 6;
    for t in 0..tiers {
        f: f32 = t as f32 / tiers as f32;
        ty: f32 = y + h * (0.22 + 0.72 * f);
        reach: f32 = size * (1.25 - 1.0 * f) * (0.85 + 0.3 * meadow_rand());
        sprays: int = 9;
        turn: f32 = meadow_rand() * TAU;
        // A dark core for the tier.
        put_cone(m, v3(x, ty - 0.45 * size, z), v3(x, ty + 0.35 * size, z), reach * 0.7,
            0.05, v_scale(needle, 0.6));
        for k in 0..sprays {
            a: f32 = turn + TAU * (k as f32 + 0.4 * meadow_rand()) / sprays as f32;
            d: V3 = v3(cosf(a), 0.0, sinf(a));
            side: V3 = v3(-d.z, 0.0, d.x);
            root: V3 = v3(x, ty, z);
            tip: V3 = v3(x + d.x * reach, ty - 0.5 * reach, z + d.z * reach);
            w: f32 = reach * 0.42;
            n: V3 = v_norm(v3(d.x * 0.6, 1.0, d.z * 0.6));
            k2: f32 = 0.85 + 0.3 * meadow_rand();
            col: V3 = v_scale(needle, k2);
            put(m, v_madd(root, side, w), n, col, MAT_LEAF);
            put(m, tip, n, v_scale(col, 1.15), MAT_LEAF);
            put(m, v_madd(root, side, -w), n, col, MAT_LEAF);
            // And its underside, darker.
            put(m, v_madd(v_madd(root, side, w * 0.8), v3(0.0, -0.12 * size, 0.0),
                1.0), v3(0.0, -1.0, 0.0), v_scale(col, 0.55), MAT_LEAF);
            put(m, v_madd(root, side, -w * 0.8), v3(0.0, -1.0, 0.0), v_scale(col,
                0.55), MAT_LEAF);
            put(m, tip, v3(0.0, -1.0, 0.0), v_scale(col, 0.55), MAT_LEAF)
        }
    }
}

// A cone from a (radius ra) to b (radius rb), its sides only.
put_cone(
    m: *Mesh,
    a: V3,
    b: V3,
    ra: f32,
    rb: f32,
    col: V3
) {
    axis: V3 = v_norm(v_sub(b, a));
    p: V3 = v_norm(v_cross(axis, v3(0.0, 1.0, 0.0)));
    if (absf(axis.y) > 0.9) p = v_norm(v_cross(axis, v3(1.0, 0.0, 0.0)));
    q: V3 = v_cross(axis, p);
    sides: int = 8;
    slope: f32 = (ra - rb) / maxf(v_len(v_sub(b, a)), 0.01);
    for i in 0..sides {
        a0: f32 = TAU * i as f32 / sides as f32;
        a1: f32 = TAU * (i + 1) as f32 / sides as f32;
        n0: V3 = v_add(v_scale(p, cosf(a0)), v_scale(q, sinf(a0)));
        n1: V3 = v_add(v_scale(p, cosf(a1)), v_scale(q, sinf(a1)));
        m0: V3 = v_norm(v_madd(n0, axis, slope));
        m1: V3 = v_norm(v_madd(n1, axis, slope));
        put_quad_n(m, v_madd(a, n0, ra), v_madd(a, n1, ra), v_madd(b, n1, rb), v_madd(b,
            n0, rb), m0, m1, m1, m0, col, MAT_PAINT)
    }
}

// An ellipsoid round c with radii r, smooth, coarse.
put_ellipsoid(
    m: *Mesh,
    c: V3,
    r: V3,
    col: V3,
    mat: f32
) {
    us: int = 8;
    vs: int = 5;
    for j in 0..vs {
        for i in 0..us {
            p00: V3 = ell_dir(i, j, us, vs);
            p10: V3 = ell_dir(i + 1, j, us, vs);
            p11: V3 = ell_dir(i + 1, j + 1, us, vs);
            p01: V3 = ell_dir(i, j + 1, us, vs);
            put_quad_n(m, ell_at(c, r, p00), ell_at(c, r, p10), ell_at(c, r, p11),
                ell_at(c, r, p01), p00, p10, p11, p01, col, mat)
        }
    }
}

ell_dir(
    i: int,
    j: int,
    us: int,
    vs: int
): V3 {
    a: f32 = TAU * i as f32 / us as f32;
    b: f32 = PI * j as f32 / vs as f32;
    v3(sinf(b) * cosf(a), cosf(b), sinf(b) * sinf(a))
}

ell_at(c: V3, r: V3, d: V3): V3 {
    v3(c.x + d.x * r.x, c.y + d.y * r.y, c.z + d.z * r.z)
}

// ---- the cars ----
// Chunky toys of cars (see cars.l8 for what each is for), all rounded
// blocks, on four fat wheels that stand out from their sides. Each car has
// two parts, built in their own frames: its body from the ground under its
// middle, its nose toward +z and its left toward +x; and a wheel from its
// own middle, its axle along x. Part kind * CAR_PARTS + PART_BODY is the
// body of the car `kind`.
//
// Every car is made of the same blocks in the same order, each block the
// same number of corners in every car: so that one car can be turned
// smoothly into another, each corner going from where it is in the one to
// where it is in the other (see draw_parts, in render.l8). A block that a
// car has no use for is hidden inside another of its blocks.
const PART_BODY: int = 0;

const PART_WHEEL: int = 1;

const CAR_PARTS: int = 2;

part_first: []int = new int[CARS * CAR_PARTS](0);

part_count: []int = new int[CARS * CAR_PARTS](0);

body_color: V3 = V3 { x: 0.90, y: 0.22, z: 0.18 };

cream: V3 = V3 { x: 0.97, y: 0.95, z: 0.88 };

yellow: V3 = V3 { x: 0.98, y: 0.72, z: 0.28 };

blue: V3 = V3 { x: 0.17, y: 0.43, z: 0.86 };

mint: V3 = V3 { x: 0.33, y: 0.76, z: 0.66 };

glass: V3 = V3 { x: 0.13, y: 0.17, z: 0.24 };

dark: V3 = V3 { x: 0.16, y: 0.16, z: 0.18 };

lamp: V3 = V3 { x: 1.0, y: 0.95, z: 0.72 };

tail: V3 = V3 { x: 0.95, y: 0.12, z: 0.1 };

// A body's blocks, in order: the body, its nose, the glasshouse, the roof,
// the bumpers front and back, two headlamps, two tail lamps, a wing's two
// posts and the wing, two pods along the sides, a bed, the wing's two end
// plates, and four lamps along the roof. Of each: how finely its corners
// are rounded (3 a body, 2 most, 1 a small thing), and what it is made of.
const BLOCKS: int = 22;

block_fine: []int = [3, 3, 2, 2, 2, 2, 1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 1, 1, 1, 1, 1,
    1];

block_mat: []f32 = [5.0, 5.0, 6.0, 5.0, 7.0, 7.0, 10.0, 10.0, 7.0, 7.0, 7.0, 7.0,
    7.0, 5.0, 5.0, 5.0, 7.0, 7.0, 10.0, 10.0, 10.0, 10.0];

// Which of a body's blocks comes next.
block_next: int = 0;

// A rounded box of half sizes h with its middle at c, its corners rounded
// by r (less than its least half size, always: a box rounded right over
// has fewer corners), `fine` steps to a rounding.
put_box(
    m: *Mesh,
    c: V3,
    h: V3,
    r: f32,
    fine: int,
    col: V3,
    mat: f32
) {
    at(c.x, c.y, c.z);
    bulge: f32 = 0.0;
    if (fine >= 3) bulge = 0.005;
    put_rounded_box(m, xf, h, minf(r, 0.9 * minf(h.x, minf(h.y, h.z))), bulge, fine,
        col, mat)
}

// The body's next block.
put_next(
    m: *Mesh,
    c: V3,
    h: V3,
    r: f32,
    col: V3
) {
    if (block_next >= BLOCKS) return;
    put_box(m, c, h, r, block_fine[block_next], col, block_mat[block_next]);
    block_next = block_next + 1
}

// Its next two blocks: one to the left of the car's middle (at c), and
// its like to the right.
put_pair(
    m: *Mesh,
    c: V3,
    h: V3,
    r: f32,
    col: V3
) {
    put_next(m, c, h, r, col);
    put_next(m, v3(-c.x, c.y, c.z), h, r, col)
}

// Its last four: the lamps along a roof, from x0 to its like on the other
// side.
put_four(
    m: *Mesh,
    c: V3,
    h: V3,
    r: f32
) {
    for k in 0..4 put_next(m, v3(c.x * (1.0 - 2.0 * k as f32 / 3.0), c.y, c.z), h,
        r, lamp)
}

build_parts(m: *Mesh) {
    m.n = 0;
    set_extra(0.0, 0.0);
    for kind in 0..CARS {
        part: int = kind * CAR_PARTS;
        part_first[part] = m.n;
        block_next = 0;
        if (kind == BUGGY) put_buggy(m);
        if (kind == DART) put_dart(m);
        if (kind == TRUCK) put_truck(m);
        if (kind == MINI) put_mini(m);
        part_count[part] = m.n - part_first[part];
        part_first[part + 1] = m.n;
        hub: V3 = cream;
        if (kind == BUGGY || kind == MINI) hub = yellow;
        r: f32 = car_wheel_r[kind];
        hw: f32 = car_wheel_half[kind];
        put_wheel(m, r, hw, minf(0.08, hw * 0.5), 20, dark);
        // Its hub: a block through it, so that its turning shows.
        put_box(m, v3(0.0, 0.0, 0.0), v3(hw + 0.015, r * 0.4, r * 0.4), r * 0.13,
            2, hub, MAT_PAINT);
        part_count[part + 1] = m.n - part_first[part + 1]
    }
}

// The Buggy: a slab of a body with a lower nose, a dark glasshouse under
// a roof, and a wing at the back. (Its pods, bed, end plates, and roof
// lamps are inside it.)
put_buggy(m: *Mesh) {
    red: V3 = body_color;
    put_next(m, v3(0.0, 0.52, -0.1), v3(0.62, 0.23, 1.32), 0.17, red);
    put_next(m, v3(0.0, 0.45, 1.12), v3(0.56, 0.16, 0.36), 0.14, red);
    put_next(m, v3(0.0, 0.86, -0.32), v3(0.5, 0.17, 0.6), 0.12, glass);
    put_next(m, v3(0.0, 1.04, -0.34), v3(0.54, 0.06, 0.6), 0.055, red);
    put_next(m, v3(0.0, 0.36, 1.47), v3(0.58, 0.07, 0.07), 0.06, dark);
    put_next(m, v3(0.0, 0.38, -1.42), v3(0.62, 0.07, 0.07), 0.06, dark);
    put_pair(m, v3(0.36, 0.5, 1.46), v3(0.12, 0.07, 0.05), 0.045, lamp);
    put_pair(m, v3(0.42, 0.6, -1.41), v3(0.13, 0.055, 0.04), 0.035, tail);
    put_pair(m, v3(0.4, 0.86, -1.24), v3(0.035, 0.13, 0.07), 0.03, dark);
    put_next(m, v3(0.0, 1.0, -1.26), v3(0.68, 0.035, 0.17), 0.032, yellow);
    put_pair(m, v3(0.4, 0.52, -0.1), v3(0.15, 0.15, 0.6), 0.08, red);
    put_next(m, v3(0.0, 0.55, -0.9), v3(0.45, 0.14, 0.4), 0.08, red);
    put_pair(m, v3(0.3, 0.55, -1.0), v3(0.02, 0.08, 0.15), 0.015, red);
    put_four(m, v3(0.42, 0.9, 0.1), v3(0.06, 0.04, 0.04), 0.03)
}

// The Dart: long, low, and narrow, its nose a point; a bubble for the
// driver with the engine's cover behind it (for a roof), pods along its
// sides with its lamps in their fronts, and wings low at the front (for a
// bumper) and high at the back. (Its bed and roof lamps are inside it.)
put_dart(m: *Mesh) {
    put_next(m, v3(0.0, 0.4, -0.1), v3(0.46, 0.16, 1.62), 0.14, blue);
    put_next(m, v3(0.0, 0.36, 1.62), v3(0.27, 0.11, 0.42), 0.1, blue);
    put_next(m, v3(0.0, 0.62, -0.05), v3(0.29, 0.13, 0.46), 0.12, glass);
    put_next(m, v3(0.0, 0.6, -0.95), v3(0.27, 0.11, 0.5), 0.1, blue);
    put_next(m, v3(0.0, 0.2, 1.98), v3(0.78, 0.03, 0.15), 0.028, cream);
    put_next(m, v3(0.0, 0.3, -1.7), v3(0.4, 0.045, 0.06), 0.04, dark);
    put_pair(m, v3(0.5, 0.4, 0.5), v3(0.1, 0.06, 0.035), 0.03, lamp);
    put_pair(m, v3(0.1, 0.42, -1.72), v3(0.095, 0.05, 0.04), 0.035, tail);
    put_pair(m, v3(0.4, 0.74, -1.56), v3(0.035, 0.2, 0.09), 0.03, dark);
    put_next(m, v3(0.0, 0.96, -1.6), v3(0.86, 0.04, 0.21), 0.035, cream);
    put_pair(m, v3(0.5, 0.37, -0.12), v3(0.2, 0.13, 0.62), 0.1, blue);
    put_next(m, v3(0.0, 0.4, -0.8), v3(0.3, 0.1, 0.4), 0.07, blue);
    put_pair(m, v3(0.86, 0.9, -1.6), v3(0.025, 0.11, 0.22), 0.02, blue);
    put_four(m, v3(0.18, 0.62, -0.05), v3(0.04, 0.04, 0.04), 0.03)
}

// The Truck: tall on big wheels, a raised bonnet (for a nose), a cab with
// lamps along its roof, a bed behind it with a dark floor (for a wing),
// and a bar across its nose. (Its wing's posts and end plates, and its
// pods, are inside it.)
put_truck(m: *Mesh) {
    put_next(m, v3(0.0, 0.76, 0.0), v3(0.68, 0.22, 1.5), 0.15, yellow);
    put_next(m, v3(0.0, 0.9, 0.98), v3(0.56, 0.1, 0.44), 0.08, yellow);
    put_next(m, v3(0.0, 1.17, 0.12), v3(0.58, 0.2, 0.48), 0.1, glass);
    put_next(m, v3(0.0, 1.41, 0.1), v3(0.63, 0.06, 0.52), 0.055, yellow);
    put_next(m, v3(0.0, 0.62, 1.56), v3(0.72, 0.11, 0.08), 0.07, dark);
    put_next(m, v3(0.0, 0.6, -1.52), v3(0.7, 0.09, 0.07), 0.06, dark);
    put_pair(m, v3(0.46, 0.84, 1.5), v3(0.13, 0.08, 0.05), 0.045, lamp);
    put_pair(m, v3(0.5, 0.84, -1.49), v3(0.12, 0.06, 0.04), 0.035, tail);
    put_pair(m, v3(0.4, 1.03, -1.2), v3(0.03, 0.08, 0.06), 0.025, dark);
    put_next(m, v3(0.0, 1.14, -0.95), v3(0.54, 0.025, 0.4), 0.02, dark);
    put_pair(m, v3(0.45, 0.76, 0.0), v3(0.15, 0.14, 0.6), 0.08, yellow);
    put_next(m, v3(0.0, 1.03, -0.95), v3(0.66, 0.12, 0.52), 0.08, yellow);
    put_pair(m, v3(0.5, 1.03, -0.95), v3(0.02, 0.07, 0.2), 0.015, yellow);
    put_four(m, v3(0.42, 1.5, 0.5), v3(0.08, 0.055, 0.055), 0.04)
}

// The Mini: short and round, most of it glasshouse, its roof pale. (All
// else is inside it.)
put_mini(m: *Mesh) {
    put_next(m, v3(0.0, 0.44, 0.0), v3(0.5, 0.21, 0.96), 0.2, mint);
    put_next(m, v3(0.0, 0.42, 0.5), v3(0.36, 0.12, 0.3), 0.1, mint);
    put_next(m, v3(0.0, 0.8, -0.08), v3(0.42, 0.17, 0.5), 0.13, glass);
    put_next(m, v3(0.0, 0.98, -0.08), v3(0.46, 0.055, 0.52), 0.05, cream);
    put_next(m, v3(0.0, 0.29, 0.97), v3(0.44, 0.055, 0.06), 0.05, dark);
    put_next(m, v3(0.0, 0.29, -0.97), v3(0.44, 0.055, 0.06), 0.05, dark);
    put_pair(m, v3(0.29, 0.5, 0.95), v3(0.11, 0.1, 0.05), 0.045, lamp);
    put_pair(m, v3(0.31, 0.5, -0.95), v3(0.1, 0.06, 0.04), 0.035, tail);
    put_pair(m, v3(0.3, 0.45, -0.6), v3(0.03, 0.1, 0.05), 0.025, dark);
    put_next(m, v3(0.0, 0.98, -0.08), v3(0.4, 0.03, 0.4), 0.025, cream);
    put_pair(m, v3(0.3, 0.44, 0.0), v3(0.14, 0.13, 0.5), 0.08, mint);
    put_next(m, v3(0.0, 0.44, -0.5), v3(0.36, 0.13, 0.3), 0.08, mint);
    put_pair(m, v3(0.25, 0.45, -0.6), v3(0.02, 0.08, 0.12), 0.015, mint);
    put_four(m, v3(0.3, 0.8, 0.2), v3(0.05, 0.04, 0.04), 0.03)
}

// A wheel: a fat disc round the x axis, of radius r and half width hw, its
// edges rounded by c.
put_wheel(
    m: *Mesh,
    r: f32,
    hw: f32,
    c: f32,
    sides: int,
    col: V3
) {
    // Its outline from the axle on one side, out and over the tread, back
    // to the axle on the other: (x, radius), and the way each point faces.
    arc: int = 4;
    n: int = 0;
    for side in 0..2 {
        s: f32 = -1.0;
        if (side == 1) s = 1.0;
        for k in 0..arc + 1 {
            // (Round the corner: from facing sideways to facing out, and on
            // the far side back again.)
            t: f32 = PI * 0.5 * k as f32 / arc as f32;
            if (side == 1) t = PI * 0.5 - t;
            wheel_x[n + 1] = s * (hw - c + c * cosf(t));
            wheel_r[n + 1] = r - c + c * sinf(t);
            wheel_nx[n + 1] = s * cosf(t);
            wheel_nr[n + 1] = sinf(t);
            n = n + 1
        }
    }
    wheel_x[0] = -hw;
    wheel_r[0] = 0.0;
    wheel_nx[0] = -1.0;
    wheel_nr[0] = 0.0;
    wheel_x[n + 1] = hw;
    wheel_r[n + 1] = 0.0;
    wheel_nx[n + 1] = 1.0;
    wheel_nr[n + 1] = 0.0;
    n = n + 2;
    for i in 0..sides {
        a0: f32 = TAU * i as f32 / sides as f32;
        a1: f32 = TAU * (i + 1) as f32 / sides as f32;
        for k in 0..n - 1 put_quad_n(m, tyre_point(k, a0), tyre_point(k, a1), tyre_point(k + 1,
            a1), tyre_point(k + 1, a0), tyre_normal(k, a0), tyre_normal(k, a1), tyre_normal(k + 1,
            a1), tyre_normal(k + 1, a0), col, MAT_RUBBER)
    }
}

wheel_x: []f32 = new f32[16](0.0);

wheel_r: []f32 = new f32[16](0.0);

wheel_nx: []f32 = new f32[16](0.0);

wheel_nr: []f32 = new f32[16](0.0);

tyre_point(k: int, a: f32): V3 {
    v3(wheel_x[k], wheel_r[k] * cosf(a), wheel_r[k] * sinf(a))
}

tyre_normal(k: int, a: f32): V3 {
    v3(wheel_nx[k], wheel_nr[k] * cosf(a), wheel_nr[k] * sinf(a))
}
