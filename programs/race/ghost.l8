tag race;

use_tag std;

use_tag skate;

import "../../stdlib/print.l8";

// Ghosts: the best lap driven in each kind of car, kept, and driven again
// by a car that is only seen (and seen through), to race against. When a
// lap is begun at the start line, each ghost leaves the line with it, and
// goes round as it went.
//
// A lap is kept as where the car was, the way it pointed, and how far
// askew it was, every GHOST_STEPS steps of its driving (see STEP_DT, in
// car.l8): x, z, the yaw, and the slip, GHOST_MOST times at the most.
const GHOST_STEPS: int = 8;

const GHOST_MOST: int = 2400;

const GHOST_FLOATS: int = 4;

// Each kind of car's ghost: its samples, and how many (none: there is no
// ghost of it yet).
ghost_data: []f32 = static_buffer(CARS * GHOST_MOST * GHOST_FLOATS, 0.0);

ghost_n: []int = static_buffer(CARS, 0);

// The lap being driven, kept as it goes: its samples and how many, the
// steps driven of it, the kind of car, and whether it is being kept at all
// (a lap is, from the start line; not one the car was put down in the
// middle of).
lap_data: []f32 = static_buffer(GHOST_MOST * GHOST_FLOATS, 0.0);

lap_n: int = 0;

lap_steps: int = 0;

lap_kind: int = 0;

lap_kept: bool = false;

// A kind of car whose ghost is new, and has not been written for the page
// to keep; or -1.
ghost_new: int = -1;

put_sample(data: []f32, at: int, c: *Car) {
    data[at] = c.p.x;
    data[at + 1] = c.p.z;
    data[at + 2] = c.yaw;
    data[at + 3] = c.slip
}

// A step of the car's driving has gone by: keep it, if it is one to keep.
keep_step(c: *Car) {
    if (!lap_kept) return;
    if (lap_steps % GHOST_STEPS == 0 && lap_n < GHOST_MOST) {
        put_sample(lap_data, lap_n * GHOST_FLOATS, c);
        lap_n = lap_n + 1
    }
    lap_steps = lap_steps + 1
}

// The car has crossed the start line, and a lap is begun. If one has just
// been finished, and it was the car's best, it is the car's ghost from now
// on.
keep_lap(c: *Car, best: bool) {
    if (lap_kept && best && lap_kind == c.kind && lap_n > 1 && lap_n < GHOST_MOST) {
        // (Its last sample: where it crossed the line.)
        put_sample(lap_data, lap_n * GHOST_FLOATS, c);
        lap_n = lap_n + 1;
        base: int = c.kind * GHOST_MOST * GHOST_FLOATS;
        for i in 0..lap_n * GHOST_FLOATS ghost_data[base + i] = lap_data[i];
        ghost_n[c.kind] = lap_n;
        ghost_new = c.kind
    }
    lap_n = 0;
    lap_steps = 0;
    lap_kind = c.kind;
    lap_kept = true
}

// There are no ghosts, and no best laps (the course is another: see
// set_course, in track.l8. On a page, the page gives back those it kept of
// this course).
forget_ghosts() {
    for k in 0..CARS {
        ghost_n[k] = 0;
        ghost_out[k] = false;
        car_best[k] = 0.0
    }
    ghost_new = -1;
    lap_kept = false
}

// The car has been put somewhere: the lap it was on is not one to keep.
drop_lap() {
    lap_kept = false
}

// The ghosts' cars, one for each kind (they are posed as any car is).
new_ghosts(): []*Car@new {
    cars: []*Car = race_cars_at(&race_cars_refs.data[0]);
    for k in 0..4 cars[k] = new_car(k, 0.0);
    cars
}

// Whether each ghost is on the track now.
ghost_out: []bool = static_buffer(CARS, false);

// How much of a ghost shows, from 0 to 1. It comes in over the first
// second of its lap (and not all at once); and behind the car, between it
// and where the picture is taken from, where it would fill the picture, it
// goes: all of it GHOST_GONE metres nearer than the car, none of it
// GHOST_SEEN nearer. (A ghost may be where the car is, or just behind it:
// it goes sooner than another car does, which cannot. See pose_near, in
// pose.l8.)
const GHOST_IN: f32 = 1.0;

const GHOST_GONE: f32 = 3.0;

const GHOST_SEEN: f32 = 0.5;

ghost_shows: []f32 = static_buffer(CARS, 0.0);

// Put the ghosts where they were `time` into their laps. None is out
// before a lap is begun, or once its own lap is over; nor in a race at
// all, even once it is finished (a ghost is to race against alone).
tick_ghosts(cars: []*Car, time: f32, dt: f32) {
    for k in 0..CARS {
        g: *Car = cars[k];
        u: f32 = time / (GHOST_STEPS as f32 * STEP_DT);
        i: int = floorf(u) as int;
        ghost_out[k] = laps.crossed > 0 && !race.on && i >= 0 && i < ghost_n[k] - 1;
        ghost_shows[k] = smoothstepf(0.0, GHOST_IN, time);
        if (ghost_out[k]) {
            a: int = (k * GHOST_MOST + i) * GHOST_FLOATS;
            b: int = a + GHOST_FLOATS;
            f: f32 = u - i as f32;
            before: V3 = g.p;
            g.p = v3(lerpf(ghost_data[a], ghost_data[b], f), 0.0, lerpf(ghost_data[a + 1],
                ghost_data[b + 1], f));
            g.yaw = approach_angle(ghost_data[a + 2], ghost_data[b + 2], f);
            g.slip = lerpf(ghost_data[a + 3], ghost_data[b + 3], f);
            g.prev = g.p;
            g.prev_yaw = g.yaw;
            // (Its wheels roll as far as it has come, and its front wheels
            // point the way it goes.)
            if (i == 0) g.spot = locate_anywhere(g.p) else g.spot = locate(g.p, g.spot.i,
                30);
            feel_ground(g);
            if (dt > 0.0 && i > 0) g.rolled = g.rolled + v_dot(v_sub(g.p, before),
                yaw_dir(g.yaw));
            round: f32 = TAU * car_wheel_r[k];
            if (g.rolled > round) g.rolled = g.rolled - round;
            if (g.rolled < 0.0) g.rolled = g.rolled + round;
            g.turned = g.slip * 1.2
        }
    }
}

// The ghosts that are out, posed with the cars already posed, as ghosts;
// the player's car is at `car`.
pose_ghosts(cars: []*Car, car: V3) {
    near: V3 = v_sub(car, pose_eye);
    car_far: f32 = sqrtf(near.x * near.x + near.z * near.z);
    pose_ghost = true;
    pose_pale = true;
    for k in 0..CARS {
        if (ghost_out[k]) {
            g: *Car = cars[k];
            pose_kind(k, k, 0.0);
            at: V3 = g.p;
            at.y = car_y(g);
            off: V3 = v_sub(at, pose_eye);
            pose_shows = ghost_shows[k] * smoothstepf(-GHOST_GONE, -GHOST_SEEN, sqrtf(off.x * off.x + off.z * off.z) - car_far);
            if (pose_shows > 0.0) pose_car(g, at, g.yaw, 0.0)
        }
    }
    pose_ghost = false;
    pose_pale = false;
    pose_shows = 1.0
}

// And on the map (see hud.l8).
map_ghosts(cars: []*Car) {
    for k in 0..CARS {
        if (ghost_out[k]) map_put(cars[k].p, k, DOT_GHOST)
    }
}

// ---- kept by the page ----
// On a page, the ghosts are kept from one visit to the next. The game
// writes a new ghost as a line for the page to keep: the kind of car, the
// lap's time in thousandths of a second, how many samples, and each sample
// in whole numbers (centimetres, and thousandths of a radian).
say_ghost() raises IoError {
    k: int = ghost_new;
    if (k < 0) return;
    ghost_new = -1;
    write(1, "L8GHOST ");
    write_int(1, k);
    write(1, " ");
    write_int(1, (car_best[k] * 1000.0 + 0.5) as int);
    write(1, " ");
    write_int(1, ghost_n[k]);
    base: int = k * GHOST_MOST * GHOST_FLOATS;
    for i in 0..ghost_n[k] {
        a: int = base + i * GHOST_FLOATS;
        write(1, " ");
        write_int(1, floorf(ghost_data[a] * 100.0 + 0.5) as int);
        write(1, " ");
        write_int(1, floorf(ghost_data[a + 1] * 100.0 + 0.5) as int);
        write(1, " ");
        write_int(1, floorf(ghost_data[a + 2] * 1000.0 + 0.5) as int);
        write(1, " ");
        write_int(1, floorf(ghost_data[a + 3] * 1000.0 + 0.5) as int)
    }
    write(1, "\n")
}

// And the page gives the ghosts it has kept back to the game as it starts,
// as key events whose key syms are far past any key's (and past those that
// are word of another car: see net.l8): first one that says a ghost
// begins, of which kind of car, and its lap's time (in thousandths of a
// second); then one for each sample: x and z (centimetres, from 0 at
// -1310.72 m), the way it pointed (4096 to a turn), and how far askew it
// was (hundredths of a radian, from 0 at -0.64).
const GHOST_KEY: int = 1152921504606846976;

ghost_key(ks: int): bool {
    if (ks < GHOST_KEY) return false;
    w: int = ks - GHOST_KEY;
    k: int = w / 144115188075855872 % 4;
    if (w / 576460752303423488 % 2 == 1) {
        ghost_n[k] = 0;
        time: f32 = (w % 16777216) as f32 * 0.001;
        if (car_best[k] == 0.0 || time < car_best[k]) car_best[k] = time;
        return true
    }
    if (ghost_n[k] >= GHOST_MOST) return true;
    a: int = (k * GHOST_MOST + ghost_n[k]) * GHOST_FLOATS;
    ghost_data[a] = (w % 262144 - 131072) as f32 * 0.01;
    ghost_data[a + 1] = (w / 262144 % 262144 - 131072) as f32 * 0.01;
    ghost_data[a + 2] = wrap_angle((w / 68719476736 % 4096) as f32 * TAU / 4096.0);
    ghost_data[a + 3] = (w / 281474976710656 % 128 - 64) as f32 * 0.01;
    ghost_n[k] = ghost_n[k] + 1;
    true
}

type RaceCarRefs = {
    count: int;
    data: [4]int
}

race_cars_refs: RaceCarRefs = RaceCarRefs { count: 4, data: zeroed([4]int) };

extern race_cars_at(p: *int): []*Car = l8_as_int
