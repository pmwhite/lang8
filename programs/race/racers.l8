tag race;

use_tag skate;

// Who is driving: the player, the others on the track (see net.l8), and the
// computer drivers (see bots.l8). Each has a name; and for the list of who
// is ahead, each is put down every picture as a racer (see racer_put), and
// the racers are put in order.
//
// A name is NAME_LONG characters, of those the game's font has (see
// font.l8: a page sends a name by its characters' codes), kept by whose it
// is: a seat's (0 to MAX_OTHERS - 1), the player's (NAME_ME), or a
// computer driver's (NAME_BOT and on).
const NAME_LONG: int = 12;

const NAME_ME: int = 16;

const NAME_BOT: int = 17;

const NAMES: int = 24;

names: []i8 = new i8[NAMES * NAME_LONG](32i8);

bot_names: []str = ["Vera", "Otto", "Mab", "Finn", "Ines", "Tobe", "Zuri"];

// Whose name `who` is, is the text s (as much of it as fits).
name_is(who: int, s: str) {
    for i in 0..NAME_LONG {
        names[who * NAME_LONG + i] = 32i8;
        if (i < len(s)) names[who * NAME_LONG + i] = s[i]
    }
}

// How long a name is, without the spaces after it.
name_len(who: int): int {
    n: int = NAME_LONG;
    while (n > 0 && names[who * NAME_LONG + n - 1] == 32i8) n = n - 1;
    n
}

// The names nobody has given: the player is You, a seat is Driver and its
// number, and the computer drivers have their own.
init_names() {
    for seat in 0..NAME_ME {
        name_is(seat, "Driver   ");
        names[seat * NAME_LONG + 7] = (48 + (seat + 1) / 10) trunc i8;
        names[seat * NAME_LONG + 8] = (48 + (seat + 1) % 10) trunc i8
    }
    name_is(NAME_ME, "You");
    for k in 0..len(bot_names) name_is(NAME_BOT + k, bot_names[k])
}

// ---- what a race is to be ----
// As the player chose in the menu (and a page keeps, from one visit to the
// next): how many laps, and against computer drivers, how many of them and
// how good (see bots.l8).
set_laps: int = 3;

set_drivers: int = 5;

set_skill: int = 3;

// ---- the racers ----
// Each: whose name it has, its kind of car, how far it has come from the
// start line, whether it has finished, and in what time; and whether it is
// the player.
const MAX_RACERS: int = 24;

racer_who: []int = new int[MAX_RACERS](0);

racer_kind: []int = new int[MAX_RACERS](0);

racer_far: []f32 = new f32[MAX_RACERS](0.0);

racer_done: []bool = new bool[MAX_RACERS](false);

racer_time: []f32 = new f32[MAX_RACERS](0.0);

nracers: int = 0;

racers_none() {
    nracers = 0
}

racer_put(
    who: int,
    kind: int,
    far: f32,
    done: bool,
    time: f32
) {
    if (nracers >= MAX_RACERS) return;
    racer_who[nracers] = who;
    racer_kind[nracers] = kind;
    racer_far[nracers] = far;
    racer_done[nracers] = done;
    racer_time[nracers] = time;
    nracers = nracers + 1
}

// Whether racer a is ahead of racer b: in a race, one that has finished is
// ahead of one that has not, and of two that have, the one with the better
// time; of two that have not, the one that has come farther. Out of a
// race, they are in the order of their names' places (the player last).
racer_ahead(a: int, b: int, racing: bool): bool {
    if (!racing) return racer_who[a] < racer_who[b];
    if (racer_done[a] && racer_done[b]) return racer_time[a] < racer_time[b];
    if (racer_done[a] != racer_done[b]) return racer_done[a];
    racer_far[a] > racer_far[b]
}

// The racers in order: racer_order[0] is the first of them. And the
// player's place among them (1: first).
racer_order: []int = new int[MAX_RACERS](0);

racers_sort(racing: bool): int {
    for k in 0..nracers racer_order[k] = k;
    for i in 1..nracers {
        j: int = i;
        while (j > 0 && racer_ahead(racer_order[j], racer_order[j - 1], racing)) {
            t: int = racer_order[j];
            racer_order[j] = racer_order[j - 1];
            racer_order[j - 1] = t;
            j = j - 1
        }
    }
    place: int = 1;
    for k in 0..nracers {
        if (racer_who[racer_order[k]] == NAME_ME) place = k + 1
    }
    place
}
