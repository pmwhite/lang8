// The canyon as the game builds it.
test_build() {
    set_course(0);
    build_track();
    build_world(new_mesh(640000))
}

test_say(label: str, yes: bool) raises IoError {
    write(1, label);
    if (yes) write(1, ": yes\n") else write(1, ": no\n")
}

// Drive for `time` seconds with the wheel and pedals held as given.
test_hold(c: *Car, inp: Input, time: f32) {
    t: f32 = 0.0;
    while (t < time) {
        step_car(c, inp, STEP_DT);
        tick_laps(c, STEP_DT);
        t = t + STEP_DT
    }
}

// Drive flat out for `time` seconds along the line d out from the road's
// middle; the speed it ends at.
test_along(
    c: *Car,
    s: f32,
    d: f32,
    time: f32
): f32 {
    place_car(c, s);
    c.p = spot_point(spot_at(s, d));
    t: f32 = 0.0;
    while (t < time) {
        way: V3 = way_at(c.spot.i, c.spot.f);
        steer: f32 = (d - c.spot.d) * 0.2 + wrap_angle(c.yaw - dir_yaw(way)) * 2.0;
        step_car(c, Input {
            steer: steer,
            gas: 1.0,
            brake: 0.0,
            tidy: false,
            veer: false
        }, STEP_DT);
        t = t + STEP_DT
    }
    v_len(c.v)
}

test "the walls stand back from the road, and no two stretches share ground" {
    test_build();
    least: f32 = 1000.0;
    shared: int = 0;
    for i in 0..track_n {
        least = minf(least, minf(wall_l[i], wall_r[i]));
        // The foot of each wall here lies on no other stretch's floor.
        for e in 0..2 {
            wall: f32 = wall_r[i];
            if (e == 0) wall = -wall_l[i];
            sp: Spot = locate_anywhere(v_madd(track_p[i], right_of(track_t[i]), wall));
            arc: int = sp.i - i;
            if (arc < 0) arc = -arc;
            if (arc > track_n - arc) arc = track_n - arc;
            if (arc > 40 && absf(sp.d) < spot_wall(sp)) shared = shared + 1
        }
    }
    test_say("every wall is past the road's edge", least >= ROAD_HALF + MIN_MARGIN - 0.001);
    write(1, "wall feet on another stretch's floor: ");
    write_int(1, shared);
    write(1, "\n");
    expect {|
        every wall is past the road's edge: yes
        wall feet on another stretch's floor: 0
    |}
}

test "the walls keep the car in" {
    test_build();
    c: *Car = new_car(BUGGY, 0.0);
    past: int = 0;
    // Flat out at a wall, from all round the lap, left and right by turns.
    for k in 0..40 {
        place_car(c, track_len * k as f32 / 40.0);
        if (k % 2 == 0) c.yaw = c.yaw - 1.2 else c.yaw = c.yaw + 1.2;
        t: f32 = 0.0;
        while (t < 8.0) {
            step_car(c, Input {
                steer: 0.0,
                gas: 1.0,
                brake: 0.0,
                tidy: false,
                veer: false
            }, STEP_DT);
            if (absf(c.spot.d) > spot_wall(c.spot)) past = past + 1;
            t = t + STEP_DT
        }
    }
    write(1, "steps spent past a wall: ");
    write_int(1, past);
    write(1, "\n");
    expect {|
        steps spent past a wall: 0
    |}
}

test "a lap is all the way round" {
    test_build();
    c: *Car = new_car(BUGGY, -12.0);
    reset_laps();
    gas: Input = Input {
        steer: 0.0,
        gas: 1.0,
        brake: 0.0,
        tidy: false,
        veer: false
    };
    back: Input = Input {
        steer: 0.0,
        gas: 0.0,
        brake: 1.0,
        tidy: false,
        veer: false
    };
    write(1, "before the line: ");
    write_int(1, laps.crossed);
    test_hold(c, gas, 2.5);
    write(1, """

over it: """);
    write_int(1, laps.crossed);
    write(1, "\n");
    expect {|
        before the line: 0
        over it: 1
    |}
    // Back over the line, and forward over it again: nothing.
    test_hold(c, back, 9.0);
    test_say("backed over the line", c.progress < 0.0);
    test_hold(c, gas, 5.0);
    test_say("over it again", c.progress > 0.0);
    write(1, "crossed: ");
    write_int(1, laps.crossed);
    write(1, "\n");
    expect {|
        backed over the line: yes
        over it again: yes
        crossed: 1
    |}
    // Backward all the way round, and over the line from behind: nothing.
    place_car(c, 5.0);
    c.yaw = wrap_angle(c.yaw + PI);
    t: f32 = 0.0;
    while (t < 200.0 && c.progress > 20.0 - track_len) {
        inp: Input = auto_backward(c);
        step_car(c, inp, STEP_DT);
        tick_laps(c, STEP_DT);
        t = t + STEP_DT
    }
    test_say("went round backward", c.progress <= 20.0 - track_len);
    write(1, "crossed: ");
    write_int(1, laps.crossed);
    write(1, "\n");
    expect {|
        went round backward: yes
        crossed: 1
    |}
    // The driver, round the right way: a lap each time round.
    place_car(c, -12.0);
    reset_laps();
    t = 0.0;
    while (t < 300.0 && laps.crossed < 3) {
        step_car(c, auto_input(c), STEP_DT);
        tick_laps(c, STEP_DT);
        t = t + STEP_DT
    }
    write(1, "crossed: ");
    write_int(1, laps.crossed);
    write(1, "\n");
    test_say("the last lap took between half a minute and a minute and a half", laps.last > 30.0 && laps.last < 90.0);
    test_say("the best is the quicker of the two", car_best[BUGGY] <= laps.last && car_best[BUGGY] > 30.0);
    expect {|
        crossed: 3
        the last lap took between half a minute and a minute and a half: yes
        the best is the quicker of the two: yes
    |}
}

// The driver's steering, turned round: for a car that faces the wrong way.
auto_backward(c: *Car): Input {
    behind: Spot = spot_at(c.spot.s - 12.0, 0.0);
    off: f32 = wrap_angle(dir_yaw(v_sub(spot_point(behind), c.p)) - c.yaw);
    gas: f32 = 0.0;
    if (v_len(c.v) < 14.0) gas = 1.0;
    Input {
        steer: clampf(-off * 3.0, -1.0, 1.0),
        gas: gas,
        brake: 0.0,
        tidy: false,
        veer: false
    }
}

test "the road is fast, the grass slower, the sand slowest" {
    test_build();
    c: *Car = new_car(BUGGY, 0.0);
    road: f32 = test_along(c, 20.0, 0.0, 9.0);
    // Two wheels over the road's edge, and all four.
    half: f32 = test_along(c, 20.0, ROAD_HALF, 9.0);
    grass: f32 = test_along(c, 20.0, ROAD_HALF + 5.0, 9.0);
    test_say("on the grass by the straight", spot_ground(c.spot) == GRASS);
    // Along the first sand trap, down its middle.
    sand: f32 = test_along(c, sand_s[0] - sand_hs[0] + 4.0, sand_d[0], 1.5);
    test_say("in the sand", spot_ground(c.spot) == SAND);
    test_say("road faster than two wheels on the grass", road > half + 2.0);
    test_say("two wheels on the grass faster than four", half > grass + 2.0);
    test_say("grass faster than sand", grass > sand + 2.0);
    test_say("sand still moves", sand > 5.0);
    expect {|
        on the grass by the straight: yes
        in the sand: yes
        road faster than two wheels on the grass: yes
        two wheels on the grass faster than four: yes
        grass faster than sand: yes
        sand still moves: yes
    |}
}

// Say which car has the most of `values` (the least, if `least`).
test_best(what: str, values: []f32, least: bool) raises IoError {
    best: int = 0;
    for k in 1..CARS {
        if (least && values[k] < values[best]) best = k;
        if (!least && values[k] > values[best]) best = k
    }
    write(1, what);
    write(1, ": ");
    write(1, car_names[best]);
    write(1, "\n")
}

test "each car is the best at something" {
    test_build();
    road: []f32 = new f32[CARS](0.0);
    grass: []f32 = new f32[CARS](0.0);
    sand: []f32 = new f32[CARS](0.0);
    away: []f32 = new f32[CARS](0.0);
    stop: []f32 = new f32[CARS](0.0);
    turn: []f32 = new f32[CARS](0.0);
    for k in 0..CARS {
        c: *Car = new_car(k, 0.0);
        // Down the straight for a moment, and for longer; and the same
        // over the grass, and along the first sand trap.
        away[k] = test_along(c, 10.0, 0.0, 1.5);
        road[k] = test_along(c, 10.0, 0.0, 5.5);
        grass[k] = test_along(c, 10.0, ROAD_HALF + 5.0, 5.5);
        sand[k] = test_along(c, sand_s[0] - sand_hs[0] + 4.0, sand_d[0], 1.5);
        // From a speed on the straight: how far it takes to stop, and how
        // far round it turns in a second, the wheel hard over.
        place_car(c, 10.0);
        c.v = v_scale(yaw_dir(c.yaw), 25.0);
        test_hold(c, Input {
            steer: 0.0,
            gas: 0.0,
            brake: 1.0,
            tidy: false,
            veer: false
        }, 0.9);
        stop[k] = c.progress;
        place_car(c, 10.0);
        c.v = v_scale(yaw_dir(c.yaw), 25.0);
        yaw: f32 = c.yaw;
        test_hold(c, Input {
            steer: 1.0,
            gas: 0.0,
            brake: 0.0,
            tidy: false,
            veer: false
        }, 1.0);
        turn[k] = absf(wrap_angle(c.yaw - yaw))
    }
    test_best("fastest down the straight", road, false);
    test_best("quickest away", away, false);
    test_best("turns the most", turn, false);
    test_best("stops the soonest", stop, true);
    test_best("fastest over the grass", grass, false);
    test_best("fastest through the sand", sand, false);
    test_best("slowest down the straight", road, true);
    test_best("turns the least", turn, true);
    test_best("slowest over the grass", grass, true);
    expect {|
        fastest down the straight: DART
        quickest away: MINI
        turns the most: MINI
        stops the soonest: MINI
        fastest over the grass: TRUCK
        fastest through the sand: TRUCK
        slowest down the straight: TRUCK
        turns the least: DART
        slowest over the grass: DART
    |}
}

test "every car is made of the same blocks" {
    build_parts(new_mesh(120000));
    same: bool = true;
    for k in 1..CARS {
        for part in 0..CAR_PARTS {
            if (part_count[k * CAR_PARTS + part] != part_count[part]) same = false
        }
    }
    test_say("all the blocks are there", block_next == BLOCKS);
    test_say("each part has as many corners in every car", same);
    expect {|
        all the blocks are there: yes
        each part has as many corners in every car: yes
    |}
}

// A driver's hands: the wheel at `steer` with the gas on, and the veer
// button held, or not.
test_wheel(steer: f32): Input {
    Input {
        steer: steer,
        gas: 1.0,
        brake: 0.0,
        tidy: false,
        veer: true
    }
}

test_let_go(steer: f32): Input {
    Input {
        steer: steer,
        gas: 1.0,
        brake: 0.0,
        tidy: false,
        veer: false
    }
}

// From `speed` down the left of the straight: the wheel over to the right
// by `steer`, with the veer button held (or not), for `time`.
test_turn_in(
    c: *Car,
    speed: f32,
    steer: f32,
    veer: bool,
    tidy: bool,
    time: f32
) {
    place_car(c, 10.0);
    c.p = spot_point(spot_at(10.0, -3.0));
    c.v = v_scale(yaw_dir(c.yaw), speed);
    test_hold(c, Input {
        steer: steer,
        gas: 1.0,
        brake: 0.0,
        tidy: tidy,
        veer: veer
    }, time)
}

test "made to veer, the car drifts, until the button is let go" {
    test_build();
    c: *Car = new_car(BUGGY, 0.0);
    test_turn_in(c, 18.0, 1.0, false, false, 0.65);
    test_say("without the button it drifts", c.drift);
    grip: f32 = absf(c.slip);
    test_turn_in(c, 18.0, 1.0, true, true, 0.65);
    test_say("a tidy driver drifts", c.drift);
    test_turn_in(c, 18.0, 0.0, true, false, 0.65);
    test_say("with the button, and the wheel straight, it drifts", c.drift);
    test_say("but straight on, and not askew", absf(c.askew) < 0.01 && absf(c.spot.d + 3.0) < 0.3);
    test_turn_in(c, 18.0, 1.0, true, false, 0.65);
    test_say("with the button, and the wheel over, it drifts", c.drift);
    askew: f32 = absf(c.slip);
    test_say("well askew, round to the side the wheel is over", c.askew > 0.3 && askew > 5.0 * grip);
    test_say("no more askew than the most", askew <= DRIFT_ANGLE + 0.001);
    // The wheel brought back to the middle, it comes nearly straight, and
    // drifts on; taken over to the other side, it swings across, and
    // drifts the other way.
    test_hold(c, test_wheel(0.0), 0.4);
    test_say("the wheel in the middle, it drifts on", c.drift);
    test_say("nearly straight", absf(c.askew) < 0.15);
    going: f32 = dir_yaw(c.v);
    test_hold(c, test_wheel(-1.0), 0.5);
    test_say("the wheel taken the other way, it drifts on", c.drift);
    test_say("askew the other way", c.askew < -0.3);
    test_say("and going round the other way", wrap_angle(dir_yaw(c.v) - going) > 0.2);
    test_say("and it hit nothing", c.hit == 0.0);
    // Into the turn afresh; and the button let go (the wheel still over),
    // the tyres catch: it goes off the way it pointed, not the way it was
    // going, and the drift is over.
    test_turn_in(c, 18.0, 1.0, true, false, 0.5);
    pointed: f32 = c.yaw;
    going = dir_yaw(c.v);
    t: f32 = 0.0;
    while (c.drift && t < 1.0) {
        step_car(c, test_let_go(0.0), STEP_DT);
        t = t + STEP_DT
    }
    test_say("the button let go, it still drifts", c.drift);
    test_say("it goes the way it pointed", absf(wrap_angle(dir_yaw(c.v) - pointed)) < 0.12);
    test_say("which is not the way it was going", absf(wrap_angle(dir_yaw(c.v) - going)) > 0.2);
    test_say("and it hit nothing", c.hit == 0.0);
    expect {|
        without the button it drifts: no
        a tidy driver drifts: no
        with the button, and the wheel straight, it drifts: yes
        but straight on, and not askew: yes
        with the button, and the wheel over, it drifts: yes
        well askew, round to the side the wheel is over: yes
        no more askew than the most: yes
        the wheel in the middle, it drifts on: yes
        nearly straight: yes
        the wheel taken the other way, it drifts on: yes
        askew the other way: yes
        and going round the other way: yes
        and it hit nothing: yes
        the button let go, it still drifts: no
        it goes the way it pointed: yes
        which is not the way it was going: yes
        and it hit nothing: yes
    |}
}

test "a drift held, and let go, gives a push" {
    test_build();
    c: *Car = new_car(BUGGY, 0.0);
    // A short drift earns none.
    test_turn_in(c, 16.0, 0.5, true, false, 0.35);
    test_hold(c, test_let_go(0.0), 0.5);
    test_say("a short drift, let go, is over", !c.drift);
    test_say("and gave a push", c.push > 0.0);
    // One held longer does: and with it the car gains more speed than
    // its engine alone gives it.
    test_turn_in(c, 16.0, 0.5, true, false, 0.75);
    test_say("a drift held longer has earned one", c.drift && c.held >= PUSH_LEAST);
    t: f32 = 0.0;
    while (c.drift && t < 1.0) {
        step_car(c, test_let_go(0.0), STEP_DT);
        t = t + STEP_DT
    }
    test_say("let go, it is over", !c.drift);
    test_say("and gave a push", c.push > 0.0);
    // (For a moment of the push, and for as long once it is spent.)
    before: f32 = v_len(c.v);
    test_hold(c, test_let_go(0.0), 0.2);
    gained: f32 = v_len(c.v) - before;
    test_hold(c, test_let_go(0.0), c.push + 0.01);
    test_say("the push is spent", c.push == 0.0);
    before = v_len(c.v);
    test_hold(c, test_let_go(0.0), 0.2);
    test_say("it gained more speed with the push than after it", gained > v_len(c.v) - before + 1.0);
    test_say("and hit nothing", c.hit == 0.0);
    expect {|
        a short drift, let go, is over: yes
        and gave a push: no
        a drift held longer has earned one: yes
        let go, it is over: yes
        and gave a push: yes
        the push is spent: yes
        it gained more speed with the push than after it: yes
        and hit nothing: yes
    |}
}

// The two key syms that are word of a car in `seat`, of a kind, at (x, z)
// in centimetres, pointing `yaw` (4096 to a turn), by track sample `at`,
// at `speed` quarters of a metre a second, at the time `stamp` (hundredths
// of a second): as the page packs them (see heard, in web/race/race.js).
test_word_a(
    seat: int,
    kind: int,
    x: int,
    z: int,
    stamp: int
): int {
    NET_A + stamp * 4398046511104 + seat * 274877906944 + kind * 68719476736 + (x + 131072) * 262144 + z + 131072
}

test_word_b(
    seat: int,
    yaw: int,
    at: int,
    speed: int
): int {
    NET_B + seat * 1099511627776 + yaw * 268435456 + at * 65536 + 64 * 512 + speed * 2
}

test "word of another car puts it on the track" {
    test_build();
    others: []*Other = new_others();
    test_say("a key is word of a car", net_key(others, 65363));
    // A Truck in seat 5, 20 m down the straight and 2 m to one side,
    // pointing along it at 10 m/s.
    way: f32 = dir_yaw(track_t[20]);
    turn: int = ((way + TAU) / TAU * 4096.0) as int % 4096;
    p: V3 = v_madd(track_p[20], right_of(track_t[20]), 2.0);
    test_say("the first of the two is", net_key(others, test_word_a(5, TRUCK, (p.x * 100.0) as int,
        (p.z * 100.0) as int, 250)));
    test_say("someone is there yet", others[5].here);
    test_say("the second is", net_key(others, test_word_b(5, turn, 20, 40)));
    test_say("someone is in seat 5", others[5].here);
    test_say("and nobody in seat 4", !others[4].here);
    tick_others(others, 0.016);
    c: *Car = others[5].car;
    test_say("in a Truck", c.kind == TRUCK);
    test_say("where it was said to be", v_len(v_sub(v3(c.p.x, 0.0, c.p.z), v3(p.x,
        0.0, p.z))) < 0.4);
    test_say("pointing along the track", absf(wrap_angle(c.yaw - way)) < 0.01);
    test_say("by the right stretch of it", absf(c.spot.d - 2.0) < 0.3 && c.spot.i >= 19 && c.spot.i <= 21);
    // Word of it again, a tenth of a second on by its clock (which has
    // come round past its end) and a metre on: and from then, it is shown
    // going smoothly from the one place to the other, a little behind the
    // word.
    q: V3 = v_madd(p, track_t[20], 1.0);
    net_key(others, test_word_a(5, TRUCK, (q.x * 100.0) as int, (q.z * 100.0) as int,
        4));
    net_key(others, test_word_b(5, turn, 21, 40));
    least: f32 = 10.0;
    most: f32 = 0.0;
    was: f32 = 0.0;
    for _step in 0..20 {
        tick_others(others, 0.01);
        on: f32 = v_dot(v_sub(c.p, p), track_t[20]);
        least = minf(least, on - was);
        most = maxf(most, on - was);
        was = on
    }
    test_say("it never goes back, or jumps", least >= 0.0 && most < 0.2);
    test_say("it has come about a metre, and on a little", was > 0.9 && was < 1.9);
    // Posed, it is five parts more.
    pose_none();
    pose_others(others, p);
    write(1, "parts posed: ");
    write_int(1, ndraw);
    // Word that it has gone.
    test_say("""

that it has gone is word too""", net_key(others, NET_B + 5 * 1099511627776 + 1));
    test_say("it is still there", others[5].here);
    expect {|
        a key is word of a car: no
        the first of the two is: yes
        someone is there yet: no
        the second is: yes
        someone is in seat 5: yes
        and nobody in seat 4: yes
        in a Truck: yes
        where it was said to be: yes
        pointing along the track: yes
        by the right stretch of it: yes
        it never goes back, or jumps: yes
        it has come about a metre, and on a little: yes
        parts posed: 5
        that it has gone is word too: yes
        it is still there: no
    |}
}

test "a race is called, counted down, and run" {
    test_build();
    others: []*Other = new_others();
    c: *Car = new_car(BUGGY, -12.0);
    test_say("there is a race", race.on);
    // Word of one: the room's fifth, in 2.5 seconds, 3 laps, the third
    // place on the grid.
    test_say("a race called is word from the page", net_key(others, NET_RACE + 5 * 268435456 + 25 * 256 + 3 * 16 + 2));
    test_say("and it is heard", net_race && net_race_laps == 3 && net_race_place == 2 && net_race_id == 5);
    call_race(net_race_wait, net_race_laps);
    race_id = net_race_id;
    // Another in seat 2 is in it, and one in seat 4 is not (its page was
    // hidden as it was called, say): only the one in it is a racer, and
    // only it is run into.
    p2: V3 = track_p[30];
    net_key(others, test_word_a(2, BUGGY, (p2.x * 100.0) as int, (p2.z * 100.0) as int,
        0));
    net_key(others, test_word_b(2, 0, 30, 0) + 5 * 17592186044416);
    p4: V3 = track_p[60];
    net_key(others, test_word_a(4, BUGGY, (p4.x * 100.0) as int, (p4.z * 100.0) as int,
        0));
    net_key(others, test_word_b(4, 0, 60, 0));
    racers_none();
    race_others(others, false);
    test_say("only another in the race is in its list", nracers == 1 && racer_who[0] == 2);
    test_say("one not in it is not run into", with_me(others[2]) && !with_me(others[4]));
    test_say("the others are told the race it is in", race_said() == 5);
    // Another race the room calls, while this one is not finished: it is
    // not taken up, unless it was asked for here.
    test_say("in it, another race called is let go", !race_free());
    race_asked = true;
    test_say("but not one asked for", race_free());
    race_asked = false;
    place_car_at(c, grid_s(net_race_place), grid_d(net_race_place));
    reset_laps();
    test_say("the third place is behind the first", grid_s(2) < grid_s(0) && grid_s(0) < 0.0);
    test_say("and on the road, to one side", absf(c.spot.d) > 1.0 && absf(c.spot.d) < ROAD_HALF - 1.0);
    // The count: it waits.
    t: f32 = 0.0;
    while (t < 2.0) {
        tick_race(c, STEP_DT);
        t = t + STEP_DT
    }
    test_say("two seconds on it still waits", race_waits());
    while (t < 2.6) {
        tick_race(c, STEP_DT);
        t = t + STEP_DT
    }
    test_say("after the count it waits", race_waits());
    // Round three laps (it is put there, not driven): done at the third,
    // not before.
    c.progress = 2.5 * track_len;
    tick_race(c, STEP_DT);
    test_say("two and a half laps round, it has finished", race.done);
    c.progress = 3.0 * track_len + 1.0;
    tick_race(c, 10.0);
    test_say("three laps round, it has", race.done);
    test_say("in the time since the count ended", race.done_time > 10.0 && race.done_time < 10.2);
    test_say("finished, another race called is taken up", race_free());
    tick_race(c, 5.0);
    test_say("and the race's clock goes on after (for the others)", race.time > race.done_time + 4.0);
    test_say("its own time does", race.done_time > 10.2);
    // Away a while (its page hidden), the race's clock goes on by as long.
    was: f32 = race.time;
    race_away(20.0);
    test_say("away twenty seconds, the race's clock goes on by them", absf(race.time - was - 20.0) < 0.01);
    // Out of it (in the menu, say), it is the other way about: the one in
    // the race is faint and not run into, and the one out of it is not.
    race.on = false;
    test_say("out of a race, it says none", race_said() == 0);
    test_say("and one in a race is not with it, but one out of one is", !with_me(others[2]) && with_me(others[4]));
    racers_none();
    race_others(others, true);
    test_say("though the menu says who is here", nracers == 2);
    // In a race of its own, against computer drivers, nobody is with it.
    race.on = true;
    race_id = -1;
    test_say("in a race of its own, nobody is with it", race_said() == RACE_OWN && !with_me(others[2]) && !with_me(others[4]));
    race.on = false;
    // The room holds a race, for seats 2 and 4; and then it does not.
    more_key(NET_CONFIG + 4398046511104 + 256 + 4 + 16);
    test_say("the room holds a race for seats 2 and 4", room_wait == 20);
    more_key(NET_CONFIG + 4398046511104);
    test_say("and then does not", room_wait == -1);
    race_id = 0;
    expect {|
        there is a race: no
        a race called is word from the page: yes
        and it is heard: yes
        only another in the race is in its list: yes
        one not in it is not run into: yes
        the others are told the race it is in: yes
        in it, another race called is let go: yes
        but not one asked for: yes
        the third place is behind the first: yes
        and on the road, to one side: yes
        two seconds on it still waits: yes
        after the count it waits: no
        two and a half laps round, it has finished: no
        three laps round, it has: yes
        in the time since the count ended: yes
        finished, another race called is taken up: yes
        and the race's clock goes on after (for the others): yes
        its own time does: no
        away twenty seconds, the race's clock goes on by them: yes
        out of a race, it says none: yes
        and one in a race is not with it, but one out of one is: yes
        though the menu says who is here: yes
        in a race of its own, nobody is with it: yes
        the room holds a race for seats 2 and 4: yes
        and then does not: yes
    |}
}

// The room's word of what a race is to be: course C, L laps, B computer
// drivers, skill S.
test_room_set(
    c: int,
    l: int,
    b: int,
    s: int
) {
    more_key(NET_CONFIG + c * 512 + l * 32 + b * 4 + s)
}

test "the room's course waits for the menu, and nothing it said is said back" {
    // Here, as in the room: TANGLEWOOD, 2 laps, 5 computer drivers, medium.
    course = 3;
    set_laps = 2;
    set_drivers = 5;
    set_skill = 1;
    said_course = 3;
    said_laps = 2;
    said_bots = 5;
    said_skill = 1;
    room_course = -1;
    // Out on the road (in a race, or on how it came out), the room says
    // ROLLER, as a friend in the menu chose.
    test_room_set(2, 2, 5, 1);
    test_say("out on the road, the course is not gone to", room_config(false, false) < 0 && course == 3);
    test_say("but it waits, and is the one chosen", room_course == 2 && course_chosen(-1) == 2);
    test_say("and nothing is said back", !tell_room(course_chosen(-1), false));
    // And then 4 laps and 3 hard ones: taken up at once, and not said back.
    test_room_set(2, 4, 3, 2);
    room_config(false, false);
    test_say("the laps and the drivers are taken up", set_laps == 4 && set_drivers == 3 && set_skill == 2);
    test_say("and not said back either", !tell_room(course_chosen(-1), false));
    // Back in the menu, the course is gone to; and still nothing is said.
    test_say("in the menu, the course is gone to", room_course_now() == 2 && room_course == -1);
    course = 2;
    test_say("and nothing is said then", !tell_room(course_chosen(-1), false));
    // The player picks CANYON RUN: that is said, once; and the room saying
    // it back is taken up, and not said again.
    test_say("a course picked here is said", tell_room(0, true));
    test_room_set(0, 4, 3, 2);
    test_say("the room says it back: it is gone to", room_config(true, false) == 0);
    test_say("and not said again", !tell_room(0, false));
    // A step on the laps here, in the same moment as the room's word of
    // another thing: the step stays, and is said, with the room's.
    set_laps = 5;
    test_room_set(0, 4, 6, 2);
    room_config(true, false);
    test_say("a step made here stays, with the room's other word", set_laps == 5 && set_drivers == 6);
    test_say("and is said", tell_room(0, false));
    course = 0;
    set_laps = 3;
    set_drivers = 5;
    set_skill = 3;
    expect {|
        out on the road, the course is not gone to: yes
        but it waits, and is the one chosen: yes
        and nothing is said back: yes
        the laps and the drivers are taken up: yes
        and not said back either: yes
        in the menu, the course is gone to: yes
        and nothing is said then: yes
        L8SET 0 4 3 2
        a course picked here is said: yes
        the room says it back: it is gone to: yes
        and not said again: yes
        a step made here stays, with the room's other word: yes
        L8SET 0 5 6 2
        and is said: yes
    |}
}

// Word of a car of a kind standing still on the road's middle, `far` along
// the lap from the start line: in seat 3.
test_stand(others: []*Other, kind: int, far: f32) {
    sp: Spot = spot_at(far, 0.0);
    p: V3 = spot_point(sp);
    way: f32 = dir_yaw(way_at(sp.i, sp.f));
    net_key(others, test_word_a(3, kind, (p.x * 100.0) as int, (p.z * 100.0) as int,
        0));
    net_key(others, test_word_b(3, ((way + TAU) / TAU * 4096.0) as int % 4096, sp.i,
        0));
    tick_others(others, 0.016)
}

// Drive a car of a kind flat out from 10 m along the lap into the car
// standing 40 m along it, for three seconds: how far along it gets.
test_ram(others: []*Other, kind: int): f32 {
    c: *Car = new_car(kind, 10.0);
    t: f32 = 0.0;
    while (t < 3.0) {
        step_car(c, test_wheel(0.0), STEP_DT);
        hit_others(others, c);
        t = t + STEP_DT
    }
    c.progress
}

test "cars run into one another" {
    test_build();
    others: []*Other = new_others();
    // Nobody there: three seconds flat out goes a long way.
    free: f32 = test_ram(others, BUGGY);
    test_say("with nobody there it goes on by", free > 41.0);
    // A Buggy standing in the road: it is not driven through. (The one
    // standing is moved by its own device, not this one: here it stays.)
    test_stand(others, BUGGY, 40.0);
    stopped: f32 = test_ram(others, BUGGY);
    test_say("a car in the road stops it", stopped < 40.0 && stopped > 34.0);
    // A car beside it, overlapping: it is moved out sideways, away.
    c: *Car = new_car(BUGGY, 40.0);
    c.p = spot_point(spot_at(40.0, 1.0));
    hit_others(others, c);
    c.spot = locate(c.p, c.spot.i, 12);
    test_say("one beside it is moved away from it", c.spot.d > 1.2);
    // Run into from behind at speed, it is knocked back, the more the
    // heavier the car it hit.
    place_car(c, 37.0);
    c.v = v_scale(yaw_dir(c.yaw), 15.0);
    hit_others(others, c);
    off_buggy: f32 = v_dot(c.v, yaw_dir(c.yaw));
    test_stand(others, TRUCK, 40.0);
    place_car(c, 37.0);
    c.v = v_scale(yaw_dir(c.yaw), 15.0);
    hit_others(others, c);
    off_truck: f32 = v_dot(c.v, yaw_dir(c.yaw));
    test_say("hitting a Buggy at speed slows it", off_buggy < 12.0);
    test_say("hitting a Truck slows it more", off_truck < off_buggy - 1.0);
    test_say("and it felt the knock", c.hit > 5.0);
    expect {|
        with nobody there it goes on by: yes
        a car in the road stops it: yes
        one beside it is moved away from it: yes
        hitting a Buggy at speed slows it: yes
        hitting a Truck slows it more: yes
        and it felt the knock: yes
    |}
}

test "the best lap is kept, and driven again by a ghost" {
    test_build();
    ghosts: []*Car = new_ghosts();
    c: *Car = new_car(BUGGY, -12.0);
    reset_laps();
    // The driver goes round twice; where it was eight seconds into its
    // second lap is noted.
    t: f32 = 0.0;
    at8: V3 = c.p;
    noted: bool = false;
    while (t < 300.0 && laps.crossed < 3) {
        crossed: int = laps.crossed;
        step_car(c, auto_input(c), STEP_DT);
        tick_laps(c, STEP_DT);
        if (laps.crossed != crossed) keep_lap(c, crossed > 0 && laps.was_best);
        keep_step(c);
        if (laps.crossed == 2 && !noted && laps.time >= 8.0) {
            at8 = c.p;
            noted = true
        }
        if (laps.crossed == 1) test_once("no ghost before a lap is done", ghost_n[BUGGY] == 0);
        t = t + STEP_DT
    }
    test_say("after two laps there is a ghost of the Buggy", ghost_n[BUGGY] > 100);
    test_say("and of no other car", ghost_n[DART] + ghost_n[TRUCK] + ghost_n[MINI] == 0);
    test_say("it is of the best lap", absf(ghost_n[BUGGY] as f32 * 8.0 * STEP_DT - car_best[BUGGY]) < 0.3);
    test_say("which is to be written for the page", ghost_new == BUGGY);
    // On the third lap now: the ghost is out, where the car was at that
    // time on its best lap (the second, unless the first was quicker).
    tick_ghosts(ghosts, 8.0, 0.016);
    test_say("the ghost is out", ghost_out[BUGGY] && !ghost_out[DART]);
    best_was_second: bool = car_best[BUGGY] == laps.last;
    test_say("where the car was then", !best_was_second || v_len(v_sub(v3(ghosts[BUGGY].p.x,
        0.0, ghosts[BUGGY].p.z), v3(at8.x, 0.0, at8.z))) < 0.6);
    tick_ghosts(ghosts, car_best[BUGGY] + 1.0, 0.016);
    test_say("its lap over, it is still out", ghost_out[BUGGY]);
    // Given back by the page (as it is written, and packed: see give, in
    // web/race/race.js), it is the same ghost.
    n: int = ghost_n[BUGGY];
    x: f32 = ghost_data[40 * GHOST_FLOATS];
    yaw: f32 = ghost_data[40 * GHOST_FLOATS + 2];
    test_say("a key is a ghost's", ghost_key(65363));
    ghost_key(GHOST_KEY + 576460752303423488 + 61234);
    test_say("a ghost begun again has no samples", ghost_n[BUGGY] == 0);
    ghost_key(GHOST_KEY + 64 * 281474976710656 + 1024 * 68719476736 + (131072 + 250) * 262144 + 131072 - 300);
    test_say("one sample given, it has one", ghost_n[BUGGY] == 1);
    test_say("where it was said to be", absf(ghost_data[0] + 3.0) < 0.001 && absf(ghost_data[1] - 2.5) < 0.001);
    test_say("pointing as it was said to", absf(ghost_data[2] - TAU / 4.0) < 0.001 && absf(ghost_data[3]) < 0.001);
    test_say("(the lap had many more)", n > 100 && absf(x) + absf(yaw) > 0.0);
    expect {|
        no ghost before a lap is done: yes
        after two laps there is a ghost of the Buggy: yes
        and of no other car: yes
        it is of the best lap: yes
        which is to be written for the page: yes
        the ghost is out: yes
        where the car was then: yes
        its lap over, it is still out: no
        a key is a ghost's: no
        a ghost begun again has no samples: yes
        one sample given, it has one: yes
        where it was said to be: yes
        pointing as it was said to: yes
        (the lap had many more): yes
    |}
}

// Say whether something is so, the first time it is asked only.
test_said: bool = false;

test_once(label: str, yes: bool) raises IoError {
    if (test_said) return;
    test_said = true;
    test_say(label, yes)
}

test "close behind another car, a car drafts it" {
    test_build();
    lead: *Car = new_car(BUGGY, 60.0);
    lead.v = v_scale(yaw_dir(lead.yaw), 25.0);
    c: *Car = new_car(BUGGY, 50.0);
    test_say("ten metres behind, it drafts", draft_behind(c, lead) > 0.5);
    test_say("the nearer, the more", draft_behind(new_car(BUGGY, 54.0), lead) > draft_behind(c,
        lead));
    test_say("far behind, it drafts", draft_behind(new_car(BUGGY, 20.0), lead) > 0.0);
    test_say("ahead, it drafts", draft_behind(new_car(BUGGY, 70.0), lead) > 0.0);
    beside: *Car = new_car(BUGGY, 50.0);
    beside.p = spot_point(spot_at(50.0, 4.0));
    test_say("well to one side, it drafts", draft_behind(beside, lead) > 0.0);
    lead.v = v_scale(yaw_dir(lead.yaw), 5.0);
    test_say("behind a slow car, it drafts", draft_behind(c, lead) > 0.0);
    // Drafting, it goes faster down the straight than it can alone.
    alone: f32 = test_along(c, 10.0, 0.0, 5.5);
    c.draft = 1.0;
    place_car(c, 10.0);
    c.draft = 1.0;
    t: f32 = 0.0;
    while (t < 5.5) {
        step_car(c, Input {
            steer: 0.0,
            gas: 1.0,
            brake: 0.0,
            tidy: false,
            veer: false
        }, STEP_DT);
        t = t + STEP_DT
    }
    test_say("drafting, it is faster down the straight", v_len(c.v) > alone + 1.5);
    expect {|
        ten metres behind, it drafts: yes
        the nearer, the more: yes
        far behind, it drafts: no
        ahead, it drafts: no
        well to one side, it drafts: no
        behind a slow car, it drafts: no
        drafting, it is faster down the straight: yes
    |}
}

test "computer drivers race" {
    test_build();
    bots: []*Bot = new_bots();
    player: *Car = new_car(BUGGY, 0.0);
    call_race(1.0, 3);
    start_bots(bots, 5, SKILL_MEDIUM);
    place_car_at(player, grid_s(5), grid_d(5));
    test_say("five of them are on the grid, ahead of the player", nbots == 5 && bots[4].car.progress > player.progress);
    test_say("the player is last", place_among(bots, player) == 6);
    // Through the count they wait; then they go, for half a minute (the
    // player's car stays on the grid).
    t: f32 = 0.0;
    while (t < 0.9) {
        tick_race(player, STEP_DT);
        step_bots(bots, player, true, STEP_DT);
        t = t + STEP_DT
    }
    test_say("during the count they wait", absf(bots[0].car.progress - grid_s(0)) < 0.5);
    past: int = 0;
    knocks: f32 = 0.0;
    while (t < 31.0) {
        tick_race(player, STEP_DT);
        step_bots(bots, player, true, STEP_DT);
        for k in 0..nbots {
            c: *Car = bots[k].car;
            if (absf(c.spot.d) > spot_wall(c.spot)) past = past + 1;
            if (absf(c.spot.d) > ROAD_HALF + 4.0) knocks = knocks + STEP_DT
        }
        t = t + STEP_DT
    }
    least: f32 = 100000.0;
    for k in 0..nbots least = minf(least, bots[k].car.progress);
    test_say("half a minute on, every one is well round the lap", least > 400.0);
    test_say("the one that started in front is ahead of the one that started last",
        bots[0].car.progress > bots[4].car.progress);
    test_say("none is past a wall", past == 0);
    test_say("they have hardly been off in the grass", knocks < 3.0);
    // The player's car put ahead of them all is first.
    player.progress = 100000.0;
    test_say("ahead of them all, the player is first", place_among(bots, player) == 1);
    expect {|
        five of them are on the grid, ahead of the player: yes
        the player is last: yes
        during the count they wait: yes
        half a minute on, every one is well round the lap: yes
        the one that started in front is ahead of the one that started last: yes
        none is past a wall: yes
        they have hardly been off in the grass: yes
        ahead of them all, the player is first: yes
    |}
}

// A race of `time` seconds against n computer drivers, so good, with the
// player's car (a Mini) driven as a computer driver of skill `pace` would
// (see drive): how far the first on the grid came, and (in test_apart) how
// far from the player the farthest of them was at the end; and (in
// test_astray) how far from its own place in the field (see bot_place),
// and (in test_waits) the same of those whose places are ahead of the
// player.
test_apart: f32 = 0.0;

test_astray: f32 = 0.0;

test_waits: f32 = 0.0;

test_race(
    bots: []*Bot,
    n: int,
    skill: int,
    pace: f32,
    time: f32
): f32 {
    player: *Car = new_car(MINI, 0.0);
    call_race(0.5, 3);
    start_bots(bots, n, skill);
    place_car_at(player, grid_s(n), grid_d(n));
    t: f32 = 0.0;
    while (t < time) {
        tick_race(player, STEP_DT);
        inp: Input = Input {
            steer: 0.0,
            gas: 0.0,
            brake: 0.0,
            tidy: true,
            veer: false
        };
        if (!race_waits()) inp = drive(player, 0.0, pace);
        step_car(player, inp, STEP_DT);
        step_bots(bots, player, true, STEP_DT);
        feel_draft(player, draft_bots(bots, player, STEP_DT), STEP_DT);
        t = t + STEP_DT
    }
    test_apart = 0.0;
    test_astray = 0.0;
    test_waits = 0.0;
    for k in 0..nbots {
        test_apart = maxf(test_apart, absf(bots[k].car.progress - player.progress));
        astray: f32 = absf(bots[k].car.progress - player.progress - bot_place(bots[k]));
        test_astray = maxf(test_astray, astray);
        if (bots[k].gap > 0.0) test_waits = maxf(test_waits, astray)
    }
    bots[0].car.progress
}

test "computer drivers are as good as they are asked to be" {
    test_build();
    bots: []*Bot = new_bots();
    easy: f32 = test_race(bots, 3, SKILL_EASY, 0.5, 40.0);
    medium: f32 = test_race(bots, 3, SKILL_MEDIUM, 0.5, 40.0);
    hard: f32 = test_race(bots, 3, SKILL_HARD, 0.5, 40.0);
    test_say("three are asked for, and three race", nbots == 3);
    test_say("the middle ones go farther than the easy ones", medium > easy + 40.0);
    test_say("and the hard ones farther still", hard > medium + 20.0);
    _far: f32 = test_race(bots, 12, SKILL_MEDIUM, 0.5, 1.0);
    test_say("no more race than there are", nbots == MAX_BOTS);
    // Ones as good as the player makes them: a slow player is not left
    // behind, nor a good one left alone; as either is by the middle ones.
    // (Not left behind, that is, by more than the field is long: each of
    // them keeps to its own place in it, ahead of the player or behind. Or
    // those ahead of a slow player do: one whose place is behind it may
    // not be able to drive as slowly as it does, and pass it.)
    _a: f32 = test_race(bots, 5, SKILL_MEDIUM, 0.0, 100.0);
    test_say("a slow player is left behind by the middle ones", test_apart > 150.0);
    _b: f32 = test_race(bots, 5, SKILL_EASY, 0.8, 100.0);
    test_say("and a good one leaves the easy ones", test_apart > 150.0);
    adapt_all = 0.6;
    seed_bots(1);
    _c: f32 = test_race(bots, 5, SKILL_ADAPTIVE, 0.0, 100.0);
    test_say("with them as good as the player makes them, a slow player is", test_waits > 100.0);
    test_say("and they have come to drive worse", adapt_all < 0.4);
    adapt_all = 0.3;
    seed_bots(1);
    _d: f32 = test_race(bots, 5, SKILL_ADAPTIVE, 0.8, 100.0);
    test_say("nor does a good one leave them", test_astray > 100.0);
    test_say("and they have come to drive better", adapt_all > 0.4);
    skilled: bool = true;
    for k in 0..nbots {
        if (bots[k].skill < 0.0 || bots[k].skill > 1.0) skilled = false
    }
    test_say("none is ever better than the best a driver can be", skilled);
    adapt_all = 0.6;
    expect {|
        three are asked for, and three race: yes
        the middle ones go farther than the easy ones: yes
        and the hard ones farther still: yes
        no more race than there are: yes
        a slow player is left behind by the middle ones: yes
        and a good one leaves the easy ones: yes
        with them as good as the player makes them, a slow player is: no
        and they have come to drive worse: yes
        nor does a good one leave them: no
        and they have come to drive better: yes
        none is ever better than the best a driver can be: yes
    |}
}

// A race of two laps, to its end, against five of them as good as the
// player makes them, with the places dealt by chance from `seed`: whether
// all finish, how far from first to last, and from the player to the
// farthest of them; how many finish ahead of the player, and behind; and
// (in test_order) the order they finish in, as a number, and (in
// test_first) who wins (-1: the player).
test_ahead: int = 0;

test_wide: f32 = 0.0;

test_far: f32 = 0.0;

test_order: int = 0;

test_first: int = 0;

test_field(bots: []*Bot, seed: int): bool {
    adapt_all = 0.6;
    player: *Car = new_car(BUGGY, 0.0);
    call_race(0.5, 2);
    seed_bots(seed);
    start_bots(bots, 5, SKILL_ADAPTIVE);
    place_car_at(player, grid_s(5), grid_d(5));
    t: f32 = 0.0;
    left: bool = true;
    while (t < 400.0 && left) {
        tick_race(player, STEP_DT);
        inp: Input = Input {
            steer: 0.0,
            gas: 0.0,
            brake: 0.0,
            tidy: true,
            veer: false
        };
        if (!race_waits()) inp = drive(player, 0.0, 0.7);
        step_car(player, inp, STEP_DT);
        step_bots(bots, player, true, STEP_DT);
        feel_draft(player, draft_bots(bots, player, STEP_DT), STEP_DT);
        left = !race.done;
        for k in 0..nbots {
            if (!bots[k].done) left = true
        }
        t = t + STEP_DT
    }
    first: f32 = race.done_time;
    last: f32 = race.done_time;
    test_ahead = 0;
    test_order = 0;
    test_first = -1;
    for k in 0..nbots {
        b: *Bot = bots[k];
        first = minf(first, b.done_time);
        last = maxf(last, b.done_time);
        if (b.done_time < race.done_time) test_ahead = test_ahead + 1;
        if (b.done_time == first) test_first = k;
        ahead: int = 0;
        for j in 0..nbots {
            if (bots[j].done_time < b.done_time) ahead = ahead + 1
        }
        test_order = test_order * 6 + ahead
    }
    test_order = test_order * 6 + test_ahead;
    test_wide = last - first;
    test_far = maxf(race.done_time - first, last - race.done_time);
    adapt_all = 0.6;
    !left
}

test "as good as the player makes them, they make a field round the player" {
    test_build();
    bots: []*Bot = new_bots();
    // Three races, each with the places dealt anew.
    all: bool = true;
    wide: bool = true;
    round: bool = true;
    near: bool = true;
    orders: []int = new int[3](0);
    places: []int = new int[3](0);
    winners: []int = new int[3](0);
    for r in 0..3 {
        if (!test_field(bots, r * 7919 + 1)) all = false;
        if (test_wide <= 4.0) wide = false;
        if (test_ahead < 1 || test_ahead > nbots - 1) round = false;
        if (test_far >= 10.0) near = false;
        orders[r] = test_order;
        places[r] = test_ahead;
        winners[r] = test_first
    }
    test_say("all of them finish", all);
    test_say("they do not all finish within a second of one another", wide);
    test_say("some finish ahead of the player, and some behind", round);
    test_say("and none far from the player", near);
    test_say("they do not finish in the same order every race", orders[0] != orders[1] || orders[1] != orders[2]);
    test_say("nor the player in the same place", places[0] != places[1] || places[1] != places[2]);
    test_say("nor does the same one always win", winners[0] != winners[1] || winners[1] != winners[2]);
    expect {|
        all of them finish: yes
        they do not all finish within a second of one another: yes
        some finish ahead of the player, and some behind: yes
        and none far from the player: yes
        they do not finish in the same order every race: yes
        nor the player in the same place: yes
        nor does the same one always win: yes
    |}
}

// A car of a kind alone, driven by a computer driver so good: the time of
// its second lap.
test_lap(bots: []*Bot, kind: int, skill: f32): f32 {
    player: *Car = new_car(MINI, 700.0);
    call_race(0.1, 9);
    start_bots(bots, 1, SKILL_MEDIUM);
    c: *Car = bots[0].car;
    c.kind = kind;
    place_car_at(c, -5.0, 0.0);
    bots[0].home = 0.0;
    t: f32 = 0.0;
    first: f32 = 0.0;
    while (t < 400.0 && c.progress < 2.0 * track_len) {
        tick_race(player, STEP_DT);
        bots[0].skill = skill;
        step_bots(bots, player, false, STEP_DT);
        if (first == 0.0 && c.progress >= track_len) first = t;
        t = t + STEP_DT
    }
    t - first
}

test "driven as well as one another, the cars are as fast as one another" {
    test_build();
    bots: []*Bot = new_bots();
    for level in [0.3, 0.6, 1.0] {
        least: f32 = 1000.0;
        most: f32 = 0.0;
        for kind in 0..CARS {
            lap: f32 = test_lap(bots, kind, level);
            least = minf(least, lap);
            most = maxf(most, lap)
        }
        // (Driven as well as can be, they drift the tight bends; and the
        // Dart, which grips the least, gains the most by it, and the Mini,
        // which grips the most, the least.)
        if (level < 0.5) test_say("driven easily, their laps are within three seconds",
            most - least < 3.0) else if (level < 0.8) test_say("driven well, within two",
            most - least < 2.0) else test_say("driven as well as can be, within three",
            most - least < 3.0);
        if (level > 0.8) test_say("and that is a lap in well under a minute", most < 54.0 && least > 48.0)
    }
    // Each still has what it is good at.
    test_say("the Dart is the fastest down a straight", car_top[DART * GROUNDS] > car_top[BUGGY * GROUNDS] && car_top[BUGGY * GROUNDS] > car_top[TRUCK * GROUNDS] && car_top[TRUCK * GROUNDS] > car_top[MINI * GROUNDS]);
    test_say("the Mini grips the most, the Dart the least", car_grip[MINI * GROUNDS] > car_grip[BUGGY * GROUNDS] && car_grip[TRUCK * GROUNDS] > car_grip[DART * GROUNDS]);
    expect {|
        driven easily, their laps are within three seconds: yes
        driven well, within two: yes
        driven as well as can be, within three: yes
        and that is a lap in well under a minute: yes
        the Dart is the fastest down a straight: yes
        the Mini grips the most, the Dart the least: yes
    |}
}

// A lap of the course built, by a computer driver so good in a Buggy, with
// drifting or without: the time of its second lap; and in it, how many
// drifts it started, how many pushes it had, whether it hit anything, and
// how long it was off the road.
test_drifts: int = 0;

test_pushes: int = 0;

test_knocked: bool = false;

test_off: f32 = 0.0;

test_drift_lap(bots: []*Bot, skill: f32, drift: bool): f32 {
    bots_drift = drift;
    player: *Car = new_car(MINI, 700.0);
    call_race(0.1, 9);
    start_bots(bots, 1, SKILL_MEDIUM);
    c: *Car = bots[0].car;
    c.kind = BUGGY;
    place_car_at(c, -5.0, 0.0);
    bots[0].home = 0.0;
    test_drifts = 0;
    test_pushes = 0;
    test_knocked = false;
    test_off = 0.0;
    was_drift: bool = false;
    was_push: f32 = 0.0;
    t: f32 = 0.0;
    first: f32 = 0.0;
    while (t < 400.0 && c.progress < 2.0 * track_len) {
        tick_race(player, STEP_DT);
        bots[0].skill = skill;
        step_bots(bots, player, false, STEP_DT);
        if (first == 0.0 && c.progress >= track_len) first = t;
        if (first > 0.0) {
            if (c.drift && !was_drift) test_drifts = test_drifts + 1;
            if (c.push > was_push) test_pushes = test_pushes + 1;
            if (c.hit > 1.0) test_knocked = true;
            if (c.off > 2) test_off = test_off + STEP_DT
        }
        was_drift = c.drift;
        was_push = c.push;
        t = t + STEP_DT
    }
    bots_drift = true;
    t - first
}

test "good computer drivers drift the tight bends, and are faster for it" {
    world: *Mesh = new_mesh(640000);
    set_course(0);
    build_track();
    bots: []*Bot = new_bots();
    for k in 0..COURSES {
        set_course(k);
        build_track();
        build_world(world);
        write(1, course_names[k]);
        write(1, "\n");
        // A hard driver drifts most of the bends that are worth it, and
        // has its push from every drift: and hits nothing, and keeps to the
        // road, doing it. (The roller's bends are all wide and fast: none
        // is worth it.)
        without: f32 = test_drift_lap(bots, 0.9, false);
        drifting: f32 = test_drift_lap(bots, 0.9, true);
        if (k == 2) test_say("  none of its bends is worth drifting", test_drifts == 0 && absf(drifting - without) < 0.05) else {
            test_say("  a hard driver drifts the tight bends", test_drifts >= 3);
            test_say("  and has a push from each drift", test_pushes == test_drifts);
            test_say("  hitting nothing, and on the road", !test_knocked && test_off < 0.5);
            test_say("  its lap is faster for it, by a second or more", drifting < without - 1.0)
        }
        // An easy one hardly ever drifts.
        _easy: f32 = test_drift_lap(bots, 0.25, true);
        test_say("  an easy driver hardly ever does", test_drifts <= 1)
    }
    // In a race, among one another, hard ones drift too: and none of them
    // is put past a wall by it, or off for long.
    for k in [1, 3] {
        set_course(k);
        build_track();
        build_world(world);
        player: *Car = new_car(MINI, 0.0);
        call_race(0.5, 3);
        start_bots(bots, 5, SKILL_HARD);
        place_car_at(player, grid_s(5), grid_d(5));
        drifts: int = 0;
        past: int = 0;
        off: f32 = 0.0;
        was: []bool = new bool[MAX_BOTS](false);
        t: f32 = 0.0;
        while (t < 90.0) {
            tick_race(player, STEP_DT);
            step_bots(bots, player, true, STEP_DT);
            for j in 0..nbots {
                c: *Car = bots[j].car;
                if (c.drift && !was[j]) drifts = drifts + 1;
                was[j] = c.drift;
                if (absf(c.spot.d) > spot_wall(c.spot)) past = past + 1;
                if (c.off > 2) off = off + STEP_DT
            }
            t = t + STEP_DT
        }
        write(1, course_names[k]);
        test_say(", hard ones racing drift", drifts > 20);
        test_say("  and stay within the walls, and on the road", past == 0 && off < 1.0)
    }
    expect {|
        CANYON RUN
          a hard driver drifts the tight bends: yes
          and has a push from each drift: yes
          hitting nothing, and on the road: yes
          its lap is faster for it, by a second or more: yes
          an easy driver hardly ever does: yes
        SWITCHBACK
          a hard driver drifts the tight bends: yes
          and has a push from each drift: yes
          hitting nothing, and on the road: yes
          its lap is faster for it, by a second or more: yes
          an easy driver hardly ever does: yes
        ROLLER
          none of its bends is worth drifting: yes
          an easy driver hardly ever does: yes
        TANGLEWOOD
          a hard driver drifts the tight bends: yes
          and has a push from each drift: yes
          hitting nothing, and on the road: yes
          its lap is faster for it, by a second or more: yes
          an easy driver hardly ever does: yes
        SWITCHBACK, hard ones racing drift: yes
          and stay within the walls, and on the road: yes
        TANGLEWOOD, hard ones racing drift: yes
          and stay within the walls, and on the road: yes
    |}
}

test "every course can be built, and driven" {
    world: *Mesh = new_mesh(640000);
    set_course(0);
    build_track();
    bots: []*Bot = new_bots();
    for k in 0..COURSES {
        set_course(k);
        build_track();
        build_world(world);
        write(1, course_names[k]);
        write(1, "\n");
        test_say("  it is the course built", course == k && track_n > 600);
        test_say("  its world fits", world.n > 100000 && world.n < 620000);
        // Its walls stand clear of the road everywhere; and it has hills,
        // none too steep, with the start nearly level.
        clear: bool = true;
        lo: f32 = 1000.0;
        hi: f32 = -1000.0;
        steep: f32 = 0.0;
        for i in 0..track_n {
            if (minf(wall_l[i], wall_r[i]) < ROAD_HALF + MIN_MARGIN) clear = false;
            lo = minf(lo, track_h[i]);
            hi = maxf(hi, track_h[i]);
            steep = maxf(steep, absf(track_h[wrap_i(i + 1)] - track_h[i]) / track_ds)
        }
        test_say("  its walls stand clear of the road", clear);
        test_say("  it has hills", hi - lo > 15.0);
        test_say("  none steeper than one in four", steep < 0.25);
        level: bool = true;
        for i in -70..30 {
            if (absf(track_h[wrap_i(i + 1)] - track_h[wrap_i(i)]) / track_ds > 0.06) level = false
        }
        test_say("  the grid and the start are nearly level", level);
        // A computer driver goes round it, well and as well as can be,
        // and never leaves the road.
        for skill in [0.6, 1.0] {
            player: *Car = new_car(MINI, 700.0);
            call_race(0.1, 9);
            start_bots(bots, 1, SKILL_MEDIUM);
            c: *Car = bots[0].car;
            c.kind = BUGGY;
            place_car_at(c, -5.0, 0.0);
            bots[0].home = 0.0;
            t: f32 = 0.0;
            off: f32 = 0.0;
            past: bool = false;
            while (t < 200.0 && c.progress < track_len) {
                tick_race(player, STEP_DT);
                bots[0].skill = skill;
                step_bots(bots, player, false, STEP_DT);
                if (c.off > 2) off = off + STEP_DT;
                if (absf(c.spot.d) > spot_wall(c.spot)) past = true;
                t = t + STEP_DT
            }
            if (skill < 0.8) test_say("  a good driver laps it on the road", c.progress >= track_len && off < 0.5 && !past) else test_say("  and the best does, at better than twenty metres a second",
                c.progress >= track_len && off < 0.5 && !past && track_len / t > 20.0)
        }
    }
    // What the courses are made of: each has a car that is best on it.
    // (A lap each, by a good driver.)
    for k in 0..COURSES {
        set_course(k);
        build_track();
        best: int = 0;
        worst: int = 0;
        laps: []f32 = new f32[CARS](0.0);
        for kind in 0..CARS {
            laps[kind] = test_lap(bots, kind, 0.8);
            if (laps[kind] < laps[best]) best = kind;
            if (laps[kind] > laps[worst]) worst = kind
        }
        write(1, course_names[k]);
        if (k == 0) test_say(": on its tarred road the cars are within three seconds a lap",
            laps[worst] - laps[best] < 3.0) else {
            write(1, ": the best car on it is the ");
            write(1, car_names[best]);
            write(1, ", the worst the ");
            write(1, car_names[worst]);
            test_say(", by more than two seconds a lap", laps[worst] - laps[best] > 2.0)
        }
    }
    // One course turns into another where it stands: each is at the same
    // start, and round the start (as far as is seen from it) each is the
    // same corners as the course before it; and each of them is known by
    // where it is along the course (see relate, in world.l8), which puts it
    // where it was built.
    set_course(0);
    build_track();
    build_world(world);
    first: V3 = spot_point(spot_at(0.0, 0.0));
    first.y = track_h[0];
    same: bool = true;
    for k in 1..COURSES + 1 {
        keep_world();
        set_course(k % COURSES);
        build_track();
        build_world(world);
        here: V3 = spot_point(spot_at(0.0, 0.0));
        here.y = track_h[0];
        if (v_len(v_sub(here, first)) > 0.02) same = false;
        if (k < COURSES) {
            write(1, course_names[k]);
            test_say(": its start line is where the first course's is", v_len(v_sub(here,
                first)) <= 0.02)
        }
        alike: bool = true;
        placed: bool = true;
        for c in 0..nchunks {
            if (chunk_turns(c)) {
                if (old_chunk(c) < 0) alike = false;
                if (chunk_first[c] + chunk_count[c] > REL_MAX) placed = false else {
                    for i in chunk_first[c]..chunk_first[c] + chunk_count[c] {
                        at: f32 = world_rel[i * 4];
                        a: f32 = frame_lerp(frame_now, at, 3);
                        o: V3 = v3(world_rel[i * 4 + 1], world_rel[i * 4 + 3], world_rel[i * 4 + 2]);
                        p: V3 = v3(frame_lerp(frame_now, at, 0) + o.x * cosf(a) - o.z * sinf(a),
                            frame_lerp(frame_now, at, 2) + o.y, frame_lerp(frame_now,
                            at, 1) + o.x * sinf(a) + o.z * cosf(a));
                        if (at < FRAME_FROM + 1.0 || at > FRAME_FROM + (FRAME_N - 2) as f32 || v_len(v_sub(p,
                            v3(world.data[i * VERTEX_FLOATS], world.data[i * VERTEX_FLOATS + 1],
                            world.data[i * VERTEX_FLOATS + 2]))) > 0.01) placed = false
                    }
                }
            }
        }
        write(1, course_names[k % COURSES]);
        test_say(": the chunks round its start are the same corners as the course's before it",
            alike);
        write(1, course_names[k % COURSES]);
        test_say(": and each of them is put where it was built by where it is along it",
            placed)
    }
    test_say("all of them have the same start line", same);
    // Mud: on the third course, in its dips, half across the road.
    set_course(2);
    build_track();
    test_say("the third course has mud in its dips", nsand >= 2 && spot_ground(spot_at(sand_s[0],
        sand_d[0])) == MUD);
    test_say("and beside it the road is dry", spot_ground(spot_at(sand_s[0], -sand_d[0])) == DIRT);
    muddy: *Car = new_car(BUGGY, sand_s[0] - 8.0);
    muddy.p = spot_point(spot_at(sand_s[0] - 8.0, sand_d[0]));
    muddy.v = v_scale(yaw_dir(muddy.yaw), 24.0);
    test_hold(muddy, Input {
        steer: 0.0,
        gas: 1.0,
        brake: 0.0,
        tidy: true,
        veer: false
    }, 0.8);
    test_say("a car that drives into it is slowed a great deal", v_len(muddy.v) < 16.0);
    // Going uphill a car is slower than on the level, and downhill faster.
    set_course(1);
    build_track();
    up: int = 0;
    for i in 0..track_n {
        if (track_h[wrap_i(i + 30)] - track_h[i] > track_h[wrap_i(up + 30)] - track_h[up]) up = i
    }
    climber: *Car = new_car(BUGGY, up as f32 * track_ds);
    climber.v = v_scale(yaw_dir(climber.yaw), 20.0);
    rise: f32 = car_rise(climber);
    test_say("where the road climbs, the car's nose is up", rise > 0.08);
    set_course(0);
    build_track();
    test_say("and the first course is built again", course == 0);
    expect {|
        CANYON RUN
          it is the course built: yes
          its world fits: yes
          its walls stand clear of the road: yes
          it has hills: yes
          none steeper than one in four: yes
          the grid and the start are nearly level: yes
          a good driver laps it on the road: yes
          and the best does, at better than twenty metres a second: yes
        SWITCHBACK
          it is the course built: yes
          its world fits: yes
          its walls stand clear of the road: yes
          it has hills: yes
          none steeper than one in four: yes
          the grid and the start are nearly level: yes
          a good driver laps it on the road: yes
          and the best does, at better than twenty metres a second: yes
        ROLLER
          it is the course built: yes
          its world fits: yes
          its walls stand clear of the road: yes
          it has hills: yes
          none steeper than one in four: yes
          the grid and the start are nearly level: yes
          a good driver laps it on the road: yes
          and the best does, at better than twenty metres a second: yes
        TANGLEWOOD
          it is the course built: yes
          its world fits: yes
          its walls stand clear of the road: yes
          it has hills: yes
          none steeper than one in four: yes
          the grid and the start are nearly level: yes
          a good driver laps it on the road: yes
          and the best does, at better than twenty metres a second: yes
        CANYON RUN: on its tarred road the cars are within three seconds a lap: yes
        SWITCHBACK: the best car on it is the TRUCK, the worst the DART, by more than two seconds a lap: yes
        ROLLER: the best car on it is the BUGGY, the worst the DART, by more than two seconds a lap: yes
        TANGLEWOOD: the best car on it is the MINI, the worst the DART, by more than two seconds a lap: yes
        SWITCHBACK: its start line is where the first course's is: yes
        SWITCHBACK: the chunks round its start are the same corners as the course's before it: yes
        SWITCHBACK: and each of them is put where it was built by where it is along it: yes
        ROLLER: its start line is where the first course's is: yes
        ROLLER: the chunks round its start are the same corners as the course's before it: yes
        ROLLER: and each of them is put where it was built by where it is along it: yes
        TANGLEWOOD: its start line is where the first course's is: yes
        TANGLEWOOD: the chunks round its start are the same corners as the course's before it: yes
        TANGLEWOOD: and each of them is put where it was built by where it is along it: yes
        CANYON RUN: the chunks round its start are the same corners as the course's before it: yes
        CANYON RUN: and each of them is put where it was built by where it is along it: yes
        all of them have the same start line: yes
        the third course has mud in its dips: yes
        and beside it the road is dry: yes
        a car that drives into it is slowed a great deal: yes
        where the road climbs, the car's nose is up: yes
        and the first course is built again: yes
    |}
}

// Of frames fr (see frame_between, in world.l8), round the start as far as
// is seen from it, every fourth: how near any two come that are more than
// sixty metres apart along the lap; and how far the way turns from one to
// the next, at most.
test_frames_from: int = FRAME_LINE - (CHUNKS_BEHIND + 1) * CHUNK - 10;

test_frames_to: int = FRAME_LINE + CHUNKS_AHEAD * CHUNK + 20;

test_clear(fr: []f32): f32 {
    least: f32 = 100000.0;
    i: int = test_frames_from;
    while (i < test_frames_to) {
        j: int = i + 60;
        while (j < test_frames_to) {
            dx: f32 = fr[j * 4] - fr[i * 4];
            dz: f32 = fr[j * 4 + 1] - fr[i * 4 + 1];
            least = minf(least, sqrtf(dx * dx + dz * dz));
            j = j + 4
        }
        i = i + 4
    }
    least
}

test_bend(fr: []f32): f32 {
    most: f32 = 0.0;
    i: int = test_frames_from;
    while (i + 4 < test_frames_to) {
        most = maxf(most, absf(fr[(i + 4) * 4 + 3] - fr[i * 4 + 3]));
        i = i + 4
    }
    most
}

test "one course turns into another along a course between them" {
    // For each two courses, the one turning into the other: the course
    // between them, a quarter, half and three quarters of the way, starts
    // at the start line, the same way; it bends no tighter than the
    // tighter of the two, and comes no nearer itself than the nearer of
    // them, so that no part of it passes through another. At the first it
    // is the one, and at the last the other.
    for a in 0..COURSES {
        for b in 0..COURSES {
            if (a != b) {
                set_course(a);
                build_track();
                fit_frame();
                keep_world();
                set_course(b);
                build_track();
                fit_frame();
                bend: f32 = maxf(test_bend(frame_was), test_bend(frame_now)) + 0.002;
                near: f32 = minf(test_clear(frame_was), test_clear(frame_now)) - 1.0;
                started: bool = true;
                kept: bool = true;
                ends: f32 = 0.0;
                for e in 0..5 {
                    k: f32 = e as f32 * 0.25;
                    frame_between(k);
                    l: int = FRAME_LINE * 4;
                    if (absf(frame_mid[l] - frame_now[l]) > 0.01 || absf(frame_mid[l + 1] - frame_now[l + 1]) > 0.01 || absf(frame_mid[l + 2] - START_HIGH) > 0.01 || absf(frame_mid[l + 3]) > 0.02) started = false;
                    if (test_bend(frame_mid) > bend || test_clear(frame_mid) < near) kept = false;
                    if (e == 0 || e == 4) {
                        fr: []f32 = frame_now;
                        if (e == 0) fr = frame_was;
                        for i in 0..FRAME_N * 4 ends = maxf(ends, absf(frame_mid[i] - fr[i]))
                    }
                }
                write(1, course_names[a]);
                write(1, " into ");
                write(1, course_names[b]);
                test_say(": the course between starts at the line", started);
                test_say("  and bends no tighter, nor comes nearer itself, than they do",
                    kept);
                test_say("  and is the one at first and the other at last", ends < 0.01)
            }
        }
    }
    expect {|
        CANYON RUN into SWITCHBACK: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        CANYON RUN into ROLLER: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        CANYON RUN into TANGLEWOOD: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        SWITCHBACK into CANYON RUN: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        SWITCHBACK into ROLLER: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        SWITCHBACK into TANGLEWOOD: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        ROLLER into CANYON RUN: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        ROLLER into SWITCHBACK: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        ROLLER into TANGLEWOOD: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        TANGLEWOOD into CANYON RUN: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        TANGLEWOOD into SWITCHBACK: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
        TANGLEWOOD into ROLLER: the course between starts at the line: yes
          and bends no tighter, nor comes nearer itself, than they do: yes
          and is the one at first and the other at last: yes
    |}
}

// Whether the paints of the cars of the names from..to (and the player's)
// are all different.
test_paints_differ(from: int, to: int): bool {
    yes: bool = true;
    for a in from..to {
        if (paint_of[a] == paint_of[NAME_ME]) yes = false;
        for b in from..to {
            if (a != b && paint_of[a] == paint_of[b]) yes = false
        }
    }
    yes
}

test "every car has a paint of its own" {
    test_build();
    m: *Mesh = new_mesh(200000);
    build_parts(m);
    painted: bool = true;
    for kind in 0..CARS {
        n: int = 0;
        first: int = part_first[kind * CAR_PARTS + PART_BODY];
        for i in first..first + part_count[kind * CAR_PARTS + PART_BODY] {
            if (m.data[i * VERTEX_FLOATS + 10] == 1.0) n = n + 1
        }
        if (n * 3 < part_count[kind * CAR_PARTS + PART_BODY]) painted = false
    }
    test_say("each car's body is painted", painted);
    bots: []*Bot = new_bots();
    others: []*Other = new_others();
    start_bots(bots, 7, SKILL_MEDIUM);
    // The player in a Buggy, against seven.
    paints_none();
    paint_take(NAME_ME, BUGGY, true);
    paint_bots();
    test_say("seven computer drivers each have a paint, none the player's", test_paints_differ(NAME_BOT,
        NAME_BOT + 7) && paint_of[NAME_ME] == BUGGY);
    // In a Dart, which the first of them likes too.
    paints_none();
    paint_take(NAME_ME, DART, true);
    paint_bots();
    test_say("nor in another car", test_paints_differ(NAME_BOT, NAME_BOT + 7) && paint_of[NAME_BOT] != DART);
    // And two others, in Buggies as the player is.
    others[2].here = true;
    others[2].car.kind = BUGGY;
    others[5].here = true;
    others[5].car.kind = BUGGY;
    paints_none();
    paint_take(NAME_ME, BUGGY, true);
    paint_others(others);
    paint_bots();
    yes: bool = test_paints_differ(NAME_BOT, NAME_BOT + 7);
    for k in 0..NAME_BOT + 7 {
        if (k == 2 || k == 5 || k >= NAME_BOT) {
            for j in 0..NAME_BOT + 7 {
                if (j != k && (j == 2 || j == 5 || j >= NAME_BOT || j == NAME_ME) && paint_of[j] == paint_of[k]) yes = false
            }
        }
    }
    test_say("nor with others on the track", yes);
    kept: bool = true;
    for k in 0..7 {
        if (paint_of[NAME_BOT + k] != bot_paints[k]) kept = false
    }
    test_say("and the computer drivers keep theirs", kept);
    // On another's device, the computer drivers it drives are others too,
    // and have the paints they have here.
    others[2].here = false;
    others[5].here = false;
    for k in 0..7 {
        others[HUMAN_SEATS + k].here = true;
        others[HUMAN_SEATS + k].car.kind = bot_kinds[k]
    }
    paints_none();
    paint_take(NAME_ME, BUGGY, true);
    paint_others(others);
    alike: bool = true;
    for k in 0..7 {
        if (paint_of[HUMAN_SEATS + k] != bot_paints[k]) alike = false
    }
    test_say("and the same on another's device", alike);
    expect {|
        each car's body is painted: yes
        seven computer drivers each have a paint, none the player's: yes
        nor in another car: yes
        nor with others on the track: yes
        and the computer drivers keep theirs: yes
        and the same on another's device: yes
    |}
}

test "who is ahead, and what they are called" {
    test_build();
    init_names();
    others: []*Other = new_others();
    // A name comes from a page six characters at a time, by their codes:
    // seat 3 is "Zoe Q", and the player "Bo".
    zoe: int = ((((90 * 128 + 111) * 128 + 101) * 128 + 32) * 128 + 81) * 128 + 32;
    blank: int = ((((32 * 128 + 32) * 128 + 32) * 128 + 32) * 128 + 32) * 128 + 32;
    test_say("a name is word from the page", net_key(others, NET_NAME + 3 * 8796093022208 + zoe));
    _rest: bool = net_key(others, NET_NAME + 3 * 8796093022208 + 4398046511104 + blank);
    text: []i8 = new i8[5](0i8);
    for i in 0..5 text[i] = names[3 * NAME_LONG + i];
    test_say("and it is the seat's", text[0] == 90i8 && text[1] == 111i8 && text[2] == 101i8 && text[3] == 32i8 && text[4] == 81i8 && name_len(3) == 5);
    bo: int = ((((66 * 128 + 111) * 128 + 32) * 128 + 32) * 128 + 32) * 128 + 32;
    _me: bool = net_key(others, NET_NAME + 31 * 8796093022208 + bo);
    test_say("the player's own comes as seat 31's", names[NAME_ME * NAME_LONG] == 66i8 && name_len(NAME_ME) == 2);
    test_say("a computer driver has a name already", names[NAME_BOT * NAME_LONG] == 86i8 && name_len(NAME_BOT) == 4);
    // How far another has come, and that it has finished, come the same
    // way.
    _far: bool = net_key(others, NET_FAR + 3 * 1048576 + 1000 + 250);
    test_say("how far another has come is word from the page", other_far[3] == 250.0);
    _done: bool = net_key(others, NET_DONE + 3 * 268435456 + 61500);
    test_say("and that it has finished, and when", other_done[3] && absf(other_time[3] - 61.5) < 0.01);
    others_begin();
    test_say("a race beginning, nobody has finished it", !other_done[3]);
    // The order: in a race, by how far each has come; one that has
    // finished is ahead of all that have not, and of another that has, by
    // its time.
    racers_none();
    racer_put(NAME_ME, 300.0, false, 0.0);
    racer_put(3, 250.0, false, 0.0);
    racer_put(NAME_BOT, 420.0, false, 0.0);
    racer_put(NAME_BOT + 1, 100.0, true, 70.0);
    racer_put(NAME_BOT + 2, 90.0, true, 65.0);
    place: int = racers_sort(true);
    test_say("the player is fourth of the five", place == 4 && nracers == 5);
    test_say("the two that have finished are first, the quicker before the slower",
        racer_who[racer_order[0]] == NAME_BOT + 2 && racer_who[racer_order[1]] == NAME_BOT + 1);
    test_say("then the one that has come farthest", racer_who[racer_order[2]] == NAME_BOT && racer_who[racer_order[4]] == 3);
    test_say("out of a race, they are in the order of their seats, the player before the computer drivers",
        racers_sort(false) == 2 && racer_who[racer_order[0]] == 3);
    expect {|
        a name is word from the page: yes
        and it is the seat's: yes
        the player's own comes as seat 31's: yes
        a computer driver has a name already: yes
        how far another has come is word from the page: yes
        and that it has finished, and when: yes
        a race beginning, nobody has finished it: yes
        the player is fourth of the five: yes
        the two that have finished are first, the quicker before the slower: yes
        then the one that has come farthest: yes
        out of a race, they are in the order of their seats, the player before the computer drivers: yes
    |}
}

test "the race keeps who was in it" {
    init_names();
    racers_forget();
    // The player, two others (one finished), and a computer driver.
    racers_none();
    racer_put(NAME_ME, 100.0, false, 0.0);
    racer_put(2, 300.0, true, 60.0);
    racer_put(3, 50.0, false, 0.0);
    racer_put(HUMAN_SEATS, 120.0, false, 0.0);
    racers_keep(false);
    test_say("all four are in the list", nracers == 4);
    // Both others leave the race (for the menu, say).
    racers_none();
    racer_put(NAME_ME, 110.0, false, 0.0);
    racer_put(HUMAN_SEATS, 130.0, false, 0.0);
    racers_keep(false);
    test_say("the one who had finished stays, with their time", racer_at(2, nracers) >= 0 && racer_done[racer_at(2,
        nracers)] && racer_time[racer_at(2, nracers)] == 60.0);
    test_say("the one who had not is gone", racer_at(3, nracers) < 0 && nracers == 3);
    // The player finishes; then the computer drivers' device goes, and
    // nobody drives them.
    racers_none();
    racer_put(NAME_ME, 3000.0, true, 70.0);
    racer_put(HUMAN_SEATS, 2950.0, false, 0.0);
    racers_keep(true);
    racers_none();
    racer_put(NAME_ME, 3000.0, true, 70.0);
    racers_keep(true);
    test_say("once the player has finished, nobody is lost from the list", nracers == 3 && racer_at(HUMAN_SEATS,
        nracers) >= 0 && !racer_done[racer_at(HUMAN_SEATS, nracers)]);
    test_say("and the player's place is as it was", racers_sort(true) == 2);
    test_say("the one who left unfinished before does not come back", racer_at(3,
        nracers) < 0);
    racers_forget();
    expect {|
        all four are in the list: yes
        the one who had finished stays, with their time: yes
        the one who had not is gone: yes
        once the player has finished, nobody is lost from the list: yes
        and the player's place is as it was: yes
        the one who left unfinished before does not come back: yes
    |}
}

// Word of a computer driver of race 9 driven on another device (in seat
// HUMAN_SEATS + k), s metres round its second lap, at 20 m/s.
test_bot_word(
    others: []*Other,
    k: int,
    s: f32,
    stamp: int
) {
    sp: Spot = spot_at(s, 0.0);
    p: V3 = spot_point(sp);
    way: f32 = dir_yaw(way_at(sp.i, sp.f));
    seat: int = HUMAN_SEATS + k;
    net_key(others, test_word_a(seat, bot_kinds[k], (p.x * 100.0) as int, (p.z * 100.0) as int,
        stamp));
    net_key(others, test_word_b(seat, ((way + TAU) / TAU * 4096.0) as int % 4096,
        sp.i, 80) + 9 * 17592186044416);
    more_key(NET_FAR + seat * 1048576 + 1000 + (track_len + s) as int)
}

test "the computer drivers outlive the device that drove them" {
    test_build();
    init_names();
    others: []*Other = new_others();
    bots: []*Bot = new_bots();
    player: *Car = new_car(BUGGY, 0.0);
    // Race 9, with three computer drivers, hard ones, driven on another
    // device: the player is a lap and a half round.
    call_race(0.0, 3);
    race_id = 9;
    race_drivers = 3;
    race_drivers_skill = SKILL_HARD;
    bots_who = HUMAN_SEATS;
    others_begin();
    start_bots(bots, 0, SKILL_HARD);
    player.progress = 1.5 * track_len;
    for k in 0..3 test_bot_word(others, k, 200.0 + 30.0 * k as f32, 10);
    more_key(NET_DONE + (HUMAN_SEATS + 2) * 268435456 + 61500);
    more_key(NET_CONFIG + 8796093022208 + 750);
    tick_others(others, 0.016);
    shown: V3 = others[HUMAN_SEATS].car.p;
    // Word from the room that they are this device's to drive now.
    test_say("that they are driven here now is word from the page", net_key(others,
        NET_CONFIG + 17592186044416 + 9 * 2 + 1));
    heed_drive(bots, others, player);
    test_say("they are driven here", nbots == 3 && !others[HUMAN_SEATS].here);
    test_say("each from where it was shown", v_len(v_sub(v3(bots[0].car.p.x, 0.0,
        bots[0].car.p.z), v3(shown.x, 0.0, shown.z))) < 0.01);
    test_say("going as it went", absf(v_len(bots[0].car.v) - 20.0) < 0.5);
    test_say("as far round as it had come", absf(bots[1].car.progress - (track_len + 230.0)) < 2.0);
    test_say("as good as it was said to be", absf(bots[0].skill - 0.75) < 0.001);
    test_say("and if that was not said, as good as asked", absf(bots[1].skill - (skill_level[SKILL_HARD] + bot_own[1])) < 0.001);
    test_say("one that had finished has, in its time, and is not said to again", bots[2].done && absf(bots[2].done_time - 61.5) < 0.01 && bots[2].told);
    racers_none();
    race_bots(bots);
    test_say("they are the same racers as before, in the seats after the people's",
        racer_who[0] == HUMAN_SEATS && name_len(HUMAN_SEATS) == 4);
    // And they drive on.
    was: f32 = bots[0].car.progress;
    for _step in 0..120 {
        tick_race(player, STEP_DT);
        step_bots(bots, player, true, STEP_DT)
    }
    test_say("a second on, they have gone on round", bots[0].car.progress > was + 12.0);
    // Word of another race is not theirs.
    net_key(others, NET_CONFIG + 17592186044416 + 10 * 2);
    heed_drive(bots, others, player);
    test_say("word of another race leaves them", nbots == 3);
    // The device given them before them comes back to the race (its page
    // shown again): they are another's now, and it drives them no more.
    net_key(others, NET_CONFIG + 17592186044416 + 9 * 2);
    heed_drive(bots, others, player);
    test_say("given to another, they are driven here no more", nbots == 0);
    // And what is heard of them next is by that one's clock: the first of
    // it again, but they do not come again, as new ones do.
    test_bot_word(others, 0, 260.0, 200);
    tick_others(others, 0.016);
    others[HUMAN_SEATS].shown = 1.0;
    others_anew(others);
    test_bot_word(others, 0, 260.5, 37);
    test_say("by another clock, it is the first again, and still shown", others[HUMAN_SEATS].kept == 1 && others[HUMAN_SEATS].shown == 1.0);
    race.on = false;
    race_id = 0;
    bots_who = NAME_BOT;
    expect {|
        that they are driven here now is word from the page: yes
        they are driven here: yes
        each from where it was shown: yes
        going as it went: yes
        as far round as it had come: yes
        as good as it was said to be: yes
        and if that was not said, as good as asked: yes
        one that had finished has, in its time, and is not said to again: yes
        they are the same racers as before, in the seats after the people's: yes
        a second on, they have gone on round: yes
        word of another race leaves them: yes
        given to another, they are driven here no more: yes
        by another clock, it is the first again, and still shown: yes
    |}
}

test "after a friend's race, a race of the car's own has its own computer drivers" {
    test_build();
    init_names();
    others: []*Other = new_others();
    bots: []*Bot = new_bots();
    set_laps = 1;
    set_drivers = 6;
    set_skill = SKILL_MEDIUM;
    // A friend in seat 2 calls race 7, with four computer drivers, driven
    // on the friend's device, on ROLLER: the car's place is the fifth.
    p2: V3 = track_p[30];
    net_key(others, test_word_a(2, BUGGY, (p2.x * 100.0) as int, (p2.z * 100.0) as int,
        0));
    net_key(others, test_word_b(2, 0, 30, 0));
    net_key(others, NET_RACE + 7 * 268435456 + 2 * 33554432 + 16777216 + SKILL_MEDIUM * 1048576 + 4 * 65536 + 40 * 256 + 1 * 16 + 4);
    test_say("a friend's race, its computer drivers driven there", net_race && net_race_remote && net_race_bots == 4 && net_race_course == 2);
    take_race(bots, 1);
    test_say("taken up, none of them is driven here", race.on && race_id == 7 && nbots == 0 && !net_race);
    // The friend closes the page: nobody else is here, and RACE is a race
    // of the car's own.
    net_key(others, NET_B + 2 * 1099511627776 + 1);
    test_say("the friend has gone", others_here(others) == 0);
    call_own(5.0);
    test_say("a race of its own is nothing of the friend's", !net_race_remote && net_race_id == -1 && net_race_course == -1);
    take_race(bots, 2);
    test_say("it has as many computer drivers as the menu says, driven here", race_id == -1 && nbots == set_drivers && bots_who == NAME_BOT);
    // Started over (RESTART, or AGAIN), the same.
    nbots = 0;
    call_own(5.0);
    take_race(bots, 3);
    test_say("started over, they are there again", nbots == set_drivers);
    race.on = false;
    race_id = 0;
    nbots = 0;
    set_laps = 3;
    set_drivers = 5;
    set_skill = 3;
    expect {|
        a friend's race, its computer drivers driven there: yes
        taken up, none of them is driven here: yes
        the friend has gone: yes
        a race of its own is nothing of the friend's: yes
        it has as many computer drivers as the menu says, driven here: yes
        started over, they are there again: yes
    |}
}
