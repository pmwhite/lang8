    4.9, -265.0, -169.0, 2.9, -263.0, -135.0, 0.0, -251.0, -101.0, -3.0, -263.0, -67.0,
    -6.0, -261.0, -36.0, -4.7, -250.5, -10.5, -3.6, -225.0, 0.0, -2.4, -190.0, 0.0,
