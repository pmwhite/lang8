tag race;

use_tag skate;

// The cars. Each is good at something and pays for it:
//
// - the Buggy does everything fairly well;
// - the Dart is the fastest down a straight, and the worst round a bend,
//   at stopping, and off the road;
// - the Truck is slow on the road, but the grass and the sand hardly slow
//   it, so it can cut the bends that the others must go round;
// - the Mini is slow down a straight, but quick away, grips the most, and
//   stops the soonest.
//
// What follows is by car, in that order (see car.l8 for what the numbers
// do, and mesh.l8 for how each looks).
const CARS: int = 4;

const BUGGY: int = 0;

const DART: int = 1;

const TRUCK: int = 2;

const MINI: int = 3;

car_names: []str = ["BUGGY", "DART", "TRUCK", "MINI"];

// The engine's pull from rest (it fades toward the top speed), and the
// brakes'.
car_engine: []f32 = [9.4, 9.8, 9.0, 11.9];

car_brakes: []f32 = [22.0, 18.0, 20.0, 27.0];

// How fast the steering wheel goes over: all the way, from straight, in
// one part in this of a second.
car_steer_rate: []f32 = [5.0, 3.8, 4.4, 7.0];

// By the ground too: the top speed on it, its grip, and how fast it slows
// a car that is going faster than its top speed (per second, of the speed
// over). The grounds, in order (see track.l8 for where each lies): the
// road, grass, and sand; then a road of packed snow, and the deep snow
// beside it; then a dirt road, and mud. GROUNDS of them for each car.
//
// (The road's numbers are set so that, driven as well as one another, the
// four go round a lap of it in nearly the same time. The Dart gains down
// the straights what it loses in the bends, and the Mini the other way;
// the Truck is a little the slowest,
// which is the price of its cutting across the grass. The other roads are
// not even, and each car has one that is its own: on snow, where there is
// little grip for anyone, the Truck has the most and the Dart hardly any;
// the Buggy is at home on dirt (and the Truck goes through mud that stops
// the others); and where a tarred road is all bends, the Mini's grip and
// its brakes tell. The Dart wants a straight.)
const GROUNDS: int = 7;

car_top: []f32 = [30.0, 17.0, 9.0, 27.0, 14.0, 29.0, 11.0, 33.4, 15.0, 7.0, 27.5,
    12.0, 27.0, 8.0, 29.3, 25.0, 20.0, 27.0, 22.0, 28.0, 21.0, 28.5, 16.0, 8.0, 27.0,
    13.0, 26.0, 9.0];

car_grip: []f32 = [17.0, 9.0, 8.0, 10.5, 6.0, 15.0, 7.0, 13.0, 7.0, 6.0, 7.5, 5.0,
    9.5, 5.0, 16.0, 13.5, 12.0, 14.5, 9.5, 13.5, 11.0, 20.0, 10.0, 8.0, 11.0, 7.0,
    14.0, 7.0];

car_hold: []f32 = [0.5, 0.9, 1.8, 0.5, 1.0, 0.5, 1.6, 0.5, 1.1, 2.2, 0.5, 1.2, 0.5,
    2.0, 0.5, 0.6, 0.9, 0.5, 0.7, 0.5, 0.9, 0.5, 0.9, 1.8, 0.5, 1.0, 0.5, 1.7];

// Its shape: from its middle to its axles, and to its wheels' middles
// either side; a wheel's radius, and half its width; and how near its
// middle comes to a wall.
car_axle: []f32 = [0.92, 1.2, 1.0, 0.62];

car_wheel_x: []f32 = [0.76, 0.8, 0.88, 0.6];

car_wheel_r: []f32 = [0.37, 0.36, 0.5, 0.28];

car_wheel_half: []f32 = [0.16, 0.2, 0.2, 0.13];

car_half: []f32 = [1.05, 1.15, 1.2, 0.85];

// How heavy it is, beside the Buggy: when two cars meet, the lighter is
// knocked the farther.
car_weight: []f32 = [1.0, 0.9, 1.5, 0.7];

// The paints a car may have (as sRGB). The first CARS are the cars' own,
// in their order (see mesh.l8): the Buggy's red, the Dart's blue, the
// Truck's yellow, and the Mini's mint. Then plum, pink, orange, lime, sky
// and slate, for when another car of the same kind is on the track (see
// paint_take, in racers.l8). Each is soft and bright, as the cars are, and
// stands out from every course's ground, and from the others.
const PAINTS: int = 10;

paint_rgb: []f32 = [0.9, 0.22, 0.18, 0.17, 0.43, 0.86, 0.98, 0.84, 0.24, 0.33, 0.76,
    0.66, 0.6, 0.36, 0.82, 0.97, 0.5, 0.7, 0.98, 0.5, 0.16, 0.6, 0.8, 0.24, 0.45,
    0.77, 0.98, 0.4, 0.43, 0.53];

// Each car's best lap (0 if there is none yet).
car_best: []f32 = static_buffer(CARS, 0.0);

// What a car is like on the course that is built (see course_grounds, in
// track.l8), as four measures, each from a little to 1 (the most of any
// car's): its speed down a straight of the course's road, its pull away,
// its grip in the bends, and how little the course's rough ground slows
// it. (Each is measured from somewhat under the least of any car's: or,
// where the cars are nearly alike, from well under, so that they show
// alike.)
const MARKS: int = 4;

mark_names: []str = ["SPEED", "ACCEL", "GRIP", "OFFROAD"];

mark_value(kind: int, mark: int): f32 {
    g: int = kind * GROUNDS;
    if (mark == 0) return car_top[g + course_grounds[course * 3]];
    if (mark == 1) return car_engine[kind];
    if (mark == 2) return car_grip[g + course_grounds[course * 3]];
    car_top[g + course_grounds[course * 3 + 1]] + car_top[g + course_grounds[course * 3 + 2]]
}

car_mark(kind: int, mark: int): f32 {
    least: f32 = mark_value(0, mark);
    most: f32 = least;
    for k in 1..CARS {
        least = minf(least, mark_value(k, mark));
        most = maxf(most, mark_value(k, mark))
    }
    mark_of(mark_value(kind, mark), minf(least - 0.35 * (most - least), most * 0.8),
        most)
}

// How far v is from lo to hi: no less than a little, no more than 1.
mark_of(v: f32, lo: f32, hi: f32): f32 {
    u: f32 = (v - lo) / (hi - lo);
    if (u < 0.1) return 0.1;
    if (u > 1.0) return 1.0;
    u
}
