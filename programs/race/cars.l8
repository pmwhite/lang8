tag race;

// The cars. Each is good at something and pays for it:
//
// - the Buggy does everything fairly well;
// - the Dart is the fastest down a straight, and the worst round a bend,
//   at stopping, and off the road;
// - the Truck is slow on the road, but the grass and the sand hardly slow
//   it, so it can cut the bends that the others must go round;
// - the Mini is slow down a straight, but quick away, grips the most, and
//   stops the soonest.
//
// What follows is by car, in that order (see car.l8 for what the numbers
// do, and mesh.l8 for how each looks).
const CARS: int = 4;

const BUGGY: int = 0;

const DART: int = 1;

const TRUCK: int = 2;

const MINI: int = 3;

car_names: []str = ["BUGGY", "DART", "TRUCK", "MINI"];

// The engine's pull from rest (it fades toward the top speed), and the
// brakes'.
car_engine: []f32 = [9.4, 9.8, 9.0, 11.9];

car_brakes: []f32 = [22.0, 18.0, 20.0, 27.0];

// How fast the steering wheel goes over: all the way, from straight, in
// one part in this of a second.
car_steer_rate: []f32 = [5.0, 3.8, 4.4, 7.0];

// By the ground too (each car's ROAD, GRASS, SAND): the top speed on it,
// its grip, and how fast it slows a car that is going faster than its top
// speed (per second, of the speed over).
//
// (The road's numbers are set so that, driven as well as one another, the
// four go round the lap in nearly the same time: see the test of it in
// test_drive.l8. The Dart gains down the straights what it loses in the
// bends, and the Mini the other way; the Truck is a little the slowest,
// which is the price of its cutting across the grass.)
car_top: []f32 = [30.0, 17.0, 9.0, 32.5, 15.0, 7.0, 29.3, 25.0, 20.0, 28.5, 16.0,
    8.0];

car_grip: []f32 = [17.0, 9.0, 8.0, 13.0, 7.0, 6.0, 16.0, 13.5, 12.0, 20.0, 10.0, 8.0];

car_hold: []f32 = [0.5, 0.9, 1.8, 0.5, 1.1, 2.2, 0.5, 0.6, 0.9, 0.5, 0.9, 1.8];

// Its shape: from its middle to its axles, and to its wheels' middles
// either side; a wheel's radius, and half its width; and how near its
// middle comes to a wall.
car_axle: []f32 = [0.92, 1.2, 1.0, 0.62];

car_wheel_x: []f32 = [0.76, 0.8, 0.88, 0.6];

car_wheel_r: []f32 = [0.37, 0.36, 0.5, 0.28];

car_wheel_half: []f32 = [0.16, 0.2, 0.2, 0.13];

car_half: []f32 = [1.05, 1.15, 1.2, 0.85];

// How heavy it is, beside the Buggy: when two cars meet, the lighter is
// knocked the farther.
car_weight: []f32 = [1.0, 0.9, 1.5, 0.7];

// Each car's best lap (0 if there is none yet).
car_best: []f32 = new f32[CARS](0.0);

// What a car is like, as four measures, each from a little (the least of
// any car's) to 1 (the most): its speed down a straight, its pull away,
// its grip in the bends, and how little the rough ground slows it.
const MARKS: int = 4;

mark_names: []str = ["SPEED", "PULL", "GRIP", "ROUGH"];

car_mark(kind: int, mark: int): f32 {
    g: int = kind * 3;
    if (mark == 0) return mark_of(car_top[g], 26.0, 33.0);
    if (mark == 1) return mark_of(car_engine[kind], 7.4, 11.9);
    if (mark == 2) return mark_of(car_grip[g], 11.5, 20.0);
    mark_of(car_top[g + 1] + car_top[g + 2], 19.0, 45.0)
}

// How far v is from lo to hi: no less than a little, no more than 1.
mark_of(v: f32, lo: f32, hi: f32): f32 {
    u: f32 = (v - lo) / (hi - lo);
    if (u < 0.1) return 0.1;
    if (u > 1.0) return 1.0;
    u
}
