tag race;

use_tag skate;

// Over the scene: the lap and its time, the last lap's and the car's best,
// and the car's name and speed, in the corners; a small map of the lap,
// with every car on it; before the start, what the car is like; a word in
// the middle when a lap is done or the car is going the wrong way; and on
// a touch screen, the thumbs.
// Written in the game's own font (see font.l8), at a size counted in
// "pixels" of the writing: a capital is nearly seven of them tall, as the
// blocky letters this was first written in were.
const HUD_FLOATS: int = 200000;

// Squares as triangles: x, y for each vertex, in window pixels from the top
// left.
hud_verts: []f32 = new f32[HUD_FLOATS](0.0);

hud_n: int = 0;

// Runs of text to draw, each with its color.
const MAX_RUNS: int = 420;

run_first: []int = new int[MAX_RUNS](0);

run_count: []int = new int[MAX_RUNS](0);

run_rgba: []f32 = new f32[MAX_RUNS * 4](0.0);

// A run that is a plain shape, drawn without the shadow and the dark edge
// that words get.
run_plain: []bool = new bool[MAX_RUNS](false);

nruns: int = 0;

// The size of a font pixel, in window pixels.
hud_px: f32 = 3.0;

text_buf: []i8 = new i8[1024](0i8);

text_len: int = 0;

// What is written: each character a box of the font's picture, as two
// triangles, each corner where it is in the window (x, y) and where in
// the picture (from 0 to 1 each way). A run of them is drawn as writing
// (see run_text).
const TEXT_FLOATS: int = 160000;

text_verts: []f32 = new f32[TEXT_FLOATS](0.0);

text_n: int = 0;

run_text: []bool = new bool[MAX_RUNS](false);

// Whether the figures in text_buf are to be written each in as much room
// as the widest of them (a time is, so that it does not shift as it runs:
// see append_time). It is so for the next writing only.
text_even: bool = false;

// How far the pen goes on for a character (in the font's pixels): its own
// width, or for a figure in even room, the widest figure's.
pen_step(c: i8): f32 {
    if (text_even && c as int >= 48 && c as int <= 57) return FONT_FIGURE;
    font_glyphs[glyph_at(c) + 6]
}

// How many of the window's pixels one of the font's is, at the size the
// writing is now.
text_scale(): f32 {
    6.3 * hud_px / FONT_CAP
}

// Where the font keeps what it has of a character (see font_glyphs): a
// question mark's, for one it has not.
glyph_at(c: i8): int {
    k: int = c as int - FONT_FIRST;
    if (k < 0 || k >= FONT_GLYPHS) k = 63 - FONT_FIRST;
    k * GLYPH_FLOATS
}

text_corner(
    x: f32,
    y: f32,
    u: f32,
    v: f32
) {
    if (text_n + 4 > TEXT_FLOATS) return;
    text_verts[text_n] = x;
    text_verts[text_n + 1] = y;
    text_verts[text_n + 2] = u / FONT_W as f32;
    text_verts[text_n + 3] = v / FONT_H as f32;
    text_n = text_n + 4
}

put_corner(x: f32, y: f32) {
    if (hud_n + 2 > HUD_FLOATS) return;
    hud_verts[hud_n] = x;
    hud_verts[hud_n + 1] = y;
    hud_n = hud_n + 2
}

// The text in text_buf at (x, y), the top left of its capitals' room; a
// run of the given color.
put_text(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (nruns >= MAX_RUNS) return;
    first: int = text_n / 4;
    s: f32 = text_scale();
    pen: f32 = x;
    base: f32 = y + 6.65 * hud_px;
    for i in 0..text_len {
        k: int = glyph_at(text_buf[i]);
        gw: f32 = font_glyphs[k + 2];
        gh: f32 = font_glyphs[k + 3];
        if (gw > 0.0) {
            gx: f32 = font_glyphs[k];
            gy: f32 = font_glyphs[k + 1];
            // (A figure in even room is in the middle of it.)
            x0: f32 = pen + (font_glyphs[k + 4] + (pen_step(text_buf[i]) - font_glyphs[k + 6]) * 0.5) * s;
            y0: f32 = base + font_glyphs[k + 5] * s;
            x1: f32 = x0 + gw * s;
            y1: f32 = y0 + gh * s;
            text_corner(x0, y0, gx, gy);
            text_corner(x1, y0, gx + gw, gy);
            text_corner(x1, y1, gx + gw, gy + gh);
            text_corner(x0, y0, gx, gy);
            text_corner(x1, y1, gx + gw, gy + gh);
            text_corner(x0, y1, gx, gy + gh)
        }
        pen = pen + pen_step(text_buf[i]) * s
    }
    text_even = false;
    run_first[nruns] = first;
    run_count[nruns] = text_n / 4 - first;
    run_rgba[nruns * 4] = r;
    run_rgba[nruns * 4 + 1] = g;
    run_rgba[nruns * 4 + 2] = b;
    run_rgba[nruns * 4 + 3] = a;
    run_plain[nruns] = false;
    run_text[nruns] = true;
    nruns = nruns + 1
}

text_width(): f32 {
    wide: f32 = 0.0;
    for i in 0..text_len wide = wide + pen_step(text_buf[i]);
    wide * text_scale()
}

append(s: str) {
    for c in s {
        if (text_len < len(text_buf)) {
            text_buf[text_len] = c;
            text_len = text_len + 1
        }
    }
}

append_int(n: int) {
    if (n >= 10) append_int(n / 10);
    if (text_len < len(text_buf)) {
        text_buf[text_len] = (n % 10 + 48) trunc i8;
        text_len = text_len + 1
    }
}

put_rect(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (nruns >= MAX_RUNS) return;
    first: int = hud_n / 2;
    put_corner(x0, y0);
    put_corner(x1, y0);
    put_corner(x1, y1);
    put_corner(x0, y0);
    put_corner(x1, y1);
    put_corner(x0, y1);
    end_run(first, r, g, b, a)
}

end_run(
    first: int,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    run_first[nruns] = first;
    run_count[nruns] = hud_n / 2 - first;
    run_rgba[nruns * 4] = r;
    run_rgba[nruns * 4 + 1] = g;
    run_rgba[nruns * 4 + 2] = b;
    run_rgba[nruns * 4 + 3] = a;
    run_plain[nruns] = false;
    run_text[nruns] = false;
    nruns = nruns + 1
}

// A time as minutes, seconds, and hundredths: 1:07.42.
append_time(t: f32) {
    text_even = true;
    cs: int = (t * 100.0 + 0.5) as int;
    append_int(cs / 6000);
    append(":");
    append_two(cs / 100 % 60);
    append(".");
    append_two(cs % 100)
}

append_two(n: int) {
    if (n < 10) append("0");
    append_int(n)
}

// The car's speed, and which car it is, for the corner.
hud_speed: f32 = 0.0;

hud_kind: int = 0;

// Whether the menu is up, and nothing over the driving shows. And, in a race,
// the car's place, and of how many (0: not known).
hud_menu: bool = false;

hud_place: int = 0;

hud_of: int = 0;

// The lap, and the race, as what is over the driving says them: as they
// are, but while that goes, as the menu comes up, when they are kept as
// they were (see main.l8). The car is put back at the start at once, and
// the race is over, but what goes says what it said, not that.
hud_laps: Laps = Laps {
    crossed: 0,
    time: 0.0,
    last: 0.0,
    since: 100.0,
    was_best: false,
    wrong: 0.0
};

hud_race: Race = Race {
    on: false,
    wait: 0.0,
    laps: 3,
    time: 0.0,
    done: false,
    done_time: 0.0,
    told: false
};

// Whether its card is to show before the start (not while it is carried
// there through the air, where the card would be over it).
hud_card: bool = true;

// What the car is like: its name, and under it its measures (see
// car_mark), each a bar. Changing cars, the bars slide to the new car's:
// the bars as they are shown.
card_bars: []f32 = new f32[MARKS](0.0);

tick_card(dt: f32) {
    for k in 0..MARKS card_bars[k] = lerpf(card_bars[k], car_mark(hud_kind, k), ease(8.0,
        dt))
}

// The card, its top at y, in the middle of the left w of the window.
put_card(w: int, y: f32) {
    px: f32 = hud_px;
    text_len = 0;
    append(car_names[hud_kind]);
    put_text_middle(w, y, 1.0, 0.98, 0.92, 1.0);
    // A row: its name, then its bar, the whole of it in the middle.
    long: f32 = 34.0 * px;
    names: f32 = 36.0 * px;
    x: f32 = floorf((w as f32 - names - long) * 0.5);
    for k in 0..MARKS {
        ry: f32 = y + (22.0 + 11.0 * k as f32) * px;
        text_len = 0;
        append(mark_names[k]);
        put_text(x, ry, 1.0, 0.98, 0.92, 0.8);
        bx: f32 = x + names;
        put_rect(bx, ry + px, bx + long, ry + 6.0 * px, 1.0, 0.98, 0.92, 0.3);
        run_plain[nruns - 1] = true;
        put_rect(bx, ry + px, bx + long * card_bars[k], ry + 6.0 * px, 1.0, 0.86,
            0.4, 1.0)
    }
}

// ---- the map ----
// The lap from above, small, in the window's top right corner: the road's
// middle as a line, the start line
// across it, and a dot for each car, where it is: the others' in their
// cars' paints, a ghost's pale, and the player's own, larger and white,
// over them all. (It does not turn with the car: the way the start goes is
// always to the right.) The cars are those pose.l8 was told of: see
// map_put.

// How the ground goes onto the window: a point of it (x, z) is at
// (map_ox + x * map_by, map_oy + z * map_by).
map_ox: f32 = 0.0;

map_oy: f32 = 0.0;

map_by: f32 = 1.0;

// Where the map is, in window pixels: its left, and its bottom (its right
// and its top are the window's corner).
map_left: f32 = 0.0;

map_bottom: f32 = 0.0;

// Where the list of who is ahead goes (see ui_drive_scene, in ui.l8): how
// far down the window it may start, clear of what is over it (see
// build_hud), as a part of the window's height; and whether it is at the
// left, under the lap and its time (in a tall window), or at the right,
// under the map.
hud_list: f32 = 0.16;

hud_list_left: bool = false;

// The map goes in the top right corner of a window w wide, as big as suits
// the window. How wide it is, in window pixels; and map_ox, map_oy and
// map_by are set for it, and map_left and map_bottom.
place_map(w: int): f32 {
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    wide: f32 = clampf(0.4 * minf(wf, hf), 130.0, 280.0);
    // The lap's own size: it is fitted in, a little clear of the edges.
    lo: V3 = track_p[0];
    hi: V3 = track_p[0];
    for i in 0..track_n {
        lo = v3(minf(lo.x, track_p[i].x), 0.0, minf(lo.z, track_p[i].z));
        hi = v3(maxf(hi.x, track_p[i].x), 0.0, maxf(hi.z, track_p[i].z))
    }
    edge: f32 = 7.0;
    across: f32 = maxf(hi.x - lo.x, 1.0);
    down: f32 = maxf(hi.z - lo.z, 1.0);
    // (No taller than most of its width: the list of who is ahead goes
    // under it.)
    map_by = minf((wide - 2.0 * edge) / across, (0.62 * wide - 2.0 * edge) / down);
    wide = across * map_by + 2.0 * edge;
    map_left = wf - safe_r - 8.0 - wide;
    top: f32 = safe_t + 8.0;
    map_bottom = top + down * map_by + 2.0 * edge;
    map_ox = map_left + edge - lo.x * map_by;
    map_oy = top + edge - lo.z * map_by;
    wide
}

// A round dot at (x, y), as a run of the given color.
put_dot(
    x: f32,
    y: f32,
    radius: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (nruns >= MAX_RUNS) return;
    first: int = hud_n / 2;
    for k in 0..12 {
        t0: f32 = TAU * k as f32 / 12.0;
        t1: f32 = TAU * (k + 1) as f32 / 12.0;
        put_corner(x, y);
        put_corner(x + cosf(t0) * radius, y + sinf(t0) * radius);
        put_corner(x + cosf(t1) * radius, y + sinf(t1) * radius)
    }
    end_run(first, r, g, b, a)
}

// The road's middle at sample i, on the map; and the way across it there.
map_point(i: int): V3 {
    p: V3 = track_p[wrap_i(i)];
    v3(map_ox + p.x * map_by, 0.0, map_oy + p.z * map_by)
}

map_across(i: int, step: int): V3 {
    right_of(v_norm(v_sub(map_point(i + step), map_point(i - step))))
}

// The map, where place_map put it, `side` wide; a of it showing.
put_map(side: f32, a: f32) {
    if (a <= 0.003) return;
    if (nruns + 4 >= MAX_RUNS) return;
    // The road: a band along its middle, in pieces that meet.
    half: f32 = clampf(side / 90.0, 1.2, 2.4);
    step: int = 4;
    first: int = hud_n / 2;
    i: int = 0;
    while (i < track_n) {
        a: V3 = map_point(i);
        b: V3 = map_point(i + step);
        na: V3 = v_scale(map_across(i, step), half);
        nb: V3 = v_scale(map_across(i + step, step), half);
        put_corner(a.x - na.x, a.z - na.z);
        put_corner(a.x + na.x, a.z + na.z);
        put_corner(b.x + nb.x, b.z + nb.z);
        put_corner(a.x - na.x, a.z - na.z);
        put_corner(b.x + nb.x, b.z + nb.z);
        put_corner(b.x - nb.x, b.z - nb.z);
        i = i + step
    }
    end_run(first, 1.0, 0.98, 0.92, 0.8 * a);
    // The start line, across it.
    first = hud_n / 2;
    at: V3 = map_point(0);
    over: V3 = v_scale(map_across(0, step), half * 3.2);
    along: V3 = v_scale(v_norm(v_sub(map_point(step), at)), half * 0.7);
    put_corner(at.x - over.x - along.x, at.z - over.z - along.z);
    put_corner(at.x + over.x - along.x, at.z + over.z - along.z);
    put_corner(at.x + over.x + along.x, at.z + over.z + along.z);
    put_corner(at.x - over.x - along.x, at.z - over.z - along.z);
    put_corner(at.x + over.x + along.x, at.z + over.z + along.z);
    put_corner(at.x - over.x + along.x, at.z - over.z + along.z);
    end_run(first, 1.0, 0.98, 0.92, 0.95 * a);
    // The cars: ghosts, then the others, then the player's own.
    radius: f32 = clampf(side / 34.0, 3.0, 6.0);
    for how in 0..3 {
        for k in 0..ndots {
            x: f32 = map_ox + dot_x[k] * map_by;
            y: f32 = map_oy + dot_z[k] * map_by;
            c: int = dot_paint[k] % PAINTS * 3;
            if (dot_how[k] == how) {
                if (how == DOT_GHOST) {
                    put_dot(x, y, radius * 0.8, 1.0, 1.0, 1.0, 0.45 * a);
                    if (nruns > 0) run_plain[nruns - 1] = true
                } else if (how == DOT_OTHER) put_dot(x, y, radius, paint_rgb[c], paint_rgb[c + 1],
                    paint_rgb[c + 2], a) else put_dot(x, y, radius * 1.45, 1.0, 1.0,
                    1.0, a)
            }
        }
    }
}

// The text in text_buf with its right end at x.
put_text_right(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    put_text(x - text_width(), y, r, g, b, a)
}

// The text in text_buf, twice the size, across the middle at height y.
put_text_middle(
    w: int,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    px: f32 = hud_px;
    hud_px = px * 2.0;
    put_text(floorf((w as f32 - text_width()) * 0.5), y, r, g, b, a);
    hud_px = px
}

// Where the start's board was in the picture while the count went (see
// see_board, in main.l8): its top and its foot, down from the window's
// top, in window heights. (The top -1: it was not seen.)
hud_board_top: f32 = -1.0;

hud_board_foot: f32 = 0.0;

// Where the foot of the player's car is in the picture, as the chase
// camera has it (see see_car, in main.l8), down from the window's top, in
// window heights. (0: the camera is not behind the car.) A sheet keeps
// under it.
hud_car_foot: f32 = 0.0;

// A race's words, across the middle: the count before it starts, the word
// to go, and at its end, that it is finished, and in what time. Whether
// there were any (they take the place of the rest). They come and go with
// the rest of what is over the driving; and under the pause they go
// before the sheet comes, and come back after it goes, as what is under
// it does (see show_side): in a tall window the sheet is just under the
// car, where the count is, and the count would show over its top.
put_race(w: int, y: f32): bool {
    if (!hud_race.on) return false;
    px: f32 = hud_px;
    seen: f32 = show_drive * show_side;
    text_len = 0;
    if (hud_race.wait > 3.0) {
        if (!hud_card) return true;
        append("GET READY");
        put_text_middle(w, y, 1.0, 0.98, 0.92, seen);
        return true
    }
    if (hud_race.wait > 0.0) {
        // (Each number shrinks away as its second goes.)
        left: f32 = hud_race.wait - floorf(hud_race.wait);
        append_int(floorf(hud_race.wait) as int + 1);
        hud_px = px * (2.0 + left);
        put_text(floorf((w as f32 - text_width()) * 0.5), y, 1.0, 0.86, 0.4, (0.4 + 0.6 * left) * seen);
        hud_px = px;
        return true
    }
    if (hud_race.time < 1.2 && !hud_race.done) {
        append("GO");
        hud_px = px * 3.0;
        put_text(floorf((w as f32 - text_width()) * 0.5), y, 0.5, 1.0, 0.6, (1.0 - smoothstepf(0.7,
            1.2, hud_race.time)) * seen);
        hud_px = px;
        return true
    }
    false
}

// The text in text_buf on a faint dark row, its top at y and its left at
// x: as wide as a row of the list of who is ahead in a tall window, or
// wider if the text needs it.
put_time_row(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    px: f32 = hud_px;
    wide: f32 = maxf(68.0 * px, text_width() + 6.0 * px);
    put_round(x, y, x + wide, y + 10.0 * px, 3.5 * px, 0.16, 0.11, 0.07, 0.34 * a);
    put_text(x + 3.0 * px, y + 1.5 * px, r, g, b, a)
}

// How wide the widest of the words across the middle is (see put_race,
// and WRONG WAY), at twice the size of the rest, with px to a pixel of the
// writing.
middle_wide(px: f32): f32 {
    hud_px = px * 2.0;
    wide: f32 = 0.0;
    text_len = 0;
    append("GET READY");
    wide = maxf(wide, text_width());
    text_len = 0;
    append("WRONG WAY");
    wide = maxf(wide, text_width());
    hud_px = px;
    text_len = 0;
    wide
}

// How wide the speed is, at its widest; and the lap and its time, at the
// top left.
speed_wide(): f32 {
    text_len = 0;
    append("000 KM/H");
    wide: f32 = text_width();
    text_len = 0;
    wide
}

times_wide(): f32 {
    text_len = 0;
    append("LAP 10/10");
    wide: f32 = text_width();
    text_len = 0;
    append("00:00.00");
    wide = maxf(wide, text_width());
    text_len = 0;
    wide
}

build_hud(w: int) {
    hud_n = 0;
    text_n = 0;
    nruns = 0;
    // (How big the writing is goes by the window: see ui_unit, in ui.l8.
    // And nothing is put where a phone's edges are in the way: see
    // safe_t, there.)
    px: f32 = ui_unit(w);
    hud_px = px;
    left: f32 = safe_l + 4.0 * px;
    right: f32 = w as f32 - safe_r - 4.0 * px;
    y: f32 = safe_t + 5.0 * px;
    // (The lap and its time are beside the pause's button, which is in
    // the corner: see ui_drive_scene.)
    beside: f32 = left + (PAUSE_SIDE + 4.0) * px;
    // With the menu up: the menu, and nothing else (see ui.l8).
    if (hud_menu) {
        build_ui(w);
        return
    }
    // How much shows of what is over the driving, under a sheet: none of
    // it under how a race came out (which says all of it); and in a wide
    // window, where a sheet is at the right, none of what is there under
    // the pause either.
    hide: f32 = show_result;
    if (w > screen_h) hide = maxf(hide, 1.0 - show_side);
    // (And all of it comes and goes with the rest of what is over the
    // driving: see tick_ui.)
    seen: f32 = show_drive;
    // The lap, and its time: faint, the first at nothing, till the line is
    // first crossed. In a race, the time is the race's, from the word to
    // go (each lap's own is said as it is done): faint till then, and at
    // the race's end, as it was at the line, the time how it came out
    // says, going as that comes.
    lap: int = hud_laps.crossed;
    time: f32 = hud_laps.time;
    lit: f32 = 0.9;
    if (hud_laps.crossed == 0) {
        lap = 1;
        lit = 0.45
    }
    if (hud_race.on) {
        time = hud_race.time;
        if (!(hud_race.on && hud_race.wait > 0.0)) lit = 0.9
    }
    if (hud_race.on && hud_race.done) {
        lap = hud_race.laps;
        time = hud_race.done_time;
        lit = 0.9 * (1.0 - show_result)
    }
    text_len = 0;
    append("LAP ");
    append_int(lap);
    // (In a race: of how many.)
    if (hud_race.on) {
        append("/");
        append_int(hud_race.laps)
    }
    put_text(beside, y, 1.0, 0.98, 0.92, lit * seen);
    text_len = 0;
    append_time(time);
    put_text(beside, y + 10.0 * px, 1.0, 0.98, 0.92, lit * seen);
    // Alone against the clock: the last lap's time, and the best (only the
    // best, while the last is the best). Each on a faint dark row, as the
    // list of who is ahead has (see put_racer_row, in ui.l8), so that they
    // read over snow and bright rock; and as strong as the lap and its
    // time, told apart by their colors. The rows start where the list
    // would, and the list goes under them.
    column: f32 = y + 22.0 * px;
    if (hud_laps.last > 0.0 && !hud_race.on) {
        best: f32 = car_best[hud_kind];
        if (absf(hud_laps.last - best) > 0.004) {
            text_len = 0;
            append("LAST ");
            append_time(hud_laps.last);
            put_time_row(left, column, 1.0, 0.98, 0.92, seen);
            column = column + 11.0 * px
        }
        text_len = 0;
        append("BEST ");
        append_time(best);
        put_time_row(left, column, 1.0, 0.86, 0.4, seen);
        column = column + 11.0 * px
    }
    // The map, in the top right corner; and by it the car's speed: beside
    // it in a wide window, and under it in a tall one (where the menu's
    // button is in the way). The list of who is ahead goes under the map
    // in a wide window; in a tall one, the map and the speed are as far
    // down as the road ahead is not, and the list goes at the left, under
    // the times.
    // (In a wide window, the words across the middle are in the top row,
    // between the lap's time and the map, and clear of the speed: where
    // they would come to the speed, it goes under the map; and where they
    // would come to the map, or the time, as in a window nearly square,
    // all is as in a tall one, and they go lower down.)
    map_l: f32 = right;
    side: f32 = 0.0;
    if (track_n >= 8) {
        side = place_map(w);
        map_l = map_left
    }
    middle: f32 = w as f32 * 0.5;
    words_half: f32 = 0.5 * middle_wide(px) + 4.0 * px;
    words_high: bool = middle - words_half > beside + times_wide() && middle + words_half < map_l;
    wide: bool = w > screen_h && words_high;
    speed_x: f32 = right;
    speed_y: f32 = y;
    hud_list_left = !wide;
    if (hud_list_left) hud_list = column / screen_h as f32;
    if (track_n >= 8) {
        put_map(side, (1.0 - hide) * seen);
        if (wide && middle + words_half < map_l - 4.0 * px - speed_wide()) {
            speed_x = map_l - 4.0 * px;
            hud_list = (map_bottom + 8.0) / screen_h as f32
        } else {
            speed_y = map_bottom + 3.0 * px;
            if (wide) hud_list = (speed_y + 14.0 * px) / screen_h as f32
        }
    }
    text_len = 0;
    append_int((hud_speed * 3.6 + 0.5) as int);
    append(" KM/H");
    put_text_right(speed_x, speed_y, 1.0, 0.98, 0.92, 0.9 * (1.0 - hide) * seen);
    // Before the start: what the car is like. A lap done: its time, for a
    // moment; gold if it is the best yet. In a wide window, high in the
    // middle, in the sky, over the start's gantry wherever on the grid the
    // car is; in a tall one (or one too nearly square for them up there),
    // where the list of who is ahead and the road ahead are high, on the
    // road between the car and the thumbs' panels.
    mid: f32 = y + 3.0 * px;
    if (w < screen_h || !words_high) mid = floorf(screen_h as f32 * 0.42);
    // (And the count: over the start's board, if there is room for it
    // there; if not, as near as the car is to the start, under it.)
    count_y: f32 = mid;
    hf: f32 = screen_h as f32;
    if (w >= screen_h && hud_board_top > -1.0 && mid + 21.0 * px > hud_board_top * hf - 2.0 * px) count_y = floorf(hud_board_foot * hf + 4.0 * px);
    if (put_race(w, count_y)) {
        build_ui(w);
        return
    }
    // (Not at a race's end: how it came out says.)
    if (hud_laps.crossed > 0 && hud_laps.since < 3.5 && !(hud_race.on && hud_race.done)) {
        a: f32 = (1.0 - smoothstepf(2.7, 3.5, hud_laps.since)) * seen;
        text_len = 0;
        append_time(hud_laps.last);
        if (hud_laps.was_best) put_text_middle(w, mid, 1.0, 0.86, 0.4, a) else put_text_middle(w,
            mid, 1.0, 0.98, 0.92, a);
        if (hud_laps.was_best) {
            text_len = 0;
            append("BEST LAP");
            put_text(floorf((w as f32 - text_width()) * 0.5), mid + 18.0 * px, 1.0,
                0.86, 0.4, a)
        }
    } else if (hud_laps.wrong > 1.5) {
        text_len = 0;
        append("WRONG WAY");
        put_text_middle(w, mid, 1.0, 0.45, 0.38, seen)
    }
    build_ui(w)
}
