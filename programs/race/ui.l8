tag race;

use_tag skate;

// The game's menus, drawn by the game over its own picture (with the rest
// of what is written there: see hud.l8), and worked by a finger, a mouse,
// or the keys.
//
// - The menu, over the car at the start: the car's card, with an arrow
//   either side of its name to choose another (or a swipe across the car);
//   the courses, a card each; how many laps a race is, and against
//   computer drivers, how many and how good; and RACE, and TIME TRIAL.
// - Driving: a button for the pause; the list of who is ahead; and, for
//   thumbs, the panels they drive by (see touch.l8), which light as they
//   are used.
// - The pause, and how a race came out: a sheet each, over the picture
//   gone dim (under the car, or beside it in a wide window: see
//   sheet_left).
//
// Each comes and goes smoothly. What is chosen is asked of the game as an
// act (see ui_act), which the game takes up (see main.l8).
const ACT_NONE: int = 0;

const ACT_RACE: int = 1;

const ACT_TRIAL: int = 2;

const ACT_MENU: int = 3;

const ACT_AGAIN: int = 4;

// (With ui_arg: the car after, 1, or before, -1.)
const ACT_CAR: int = 5;

// (With ui_arg: which course.)
const ACT_COURSE: int = 6;

const ACT_PAUSE: int = 7;

const ACT_RESUME: int = 8;

const ACT_NAME: int = 9;

ui_act: int = 0;

ui_arg: int = 0;

ask(act: int, arg: int) {
    ui_act = act;
    ui_arg = arg
}

// What the game tells the menus: whether the menu is up, whether there is
// a page (and so others, perhaps, and a name to change), whether thumbs
// drive, whether the pause is on, and how many others are on the track.
// And the course chosen: the one built, or the one asked for after it
// (the world may still be turning into it: see main.l8).
ui_menu: bool = true;

ui_online: bool = false;

ui_touch: bool = false;

ui_paused: bool = false;

ui_others: int = 0;

ui_course: int = 0;

// How much of each shows, from 0 to 1 (see tick_ui): the menu, what is
// over the driving, the pause, and the race's result; and how long the
// car has been driven since the menu.
show_menu: f32 = 1.0;

show_drive: f32 = 0.0;

show_pause: f32 = 0.0;

show_result: f32 = 0.0;

// (And how much shows of what a sheet, the pause's or how the race came
// out, would be over: in a wide window, where the sheet is at the right,
// the map, the speed, the list of who is ahead and the thumbs' panels; in
// a tall one, the thumbs' panels. See tick_ui.)
show_side: f32 = 1.0;

drive_time: f32 = 0.0;

// How long thumbs have driven, in all (see put_pads): the panels are plain
// to see for the first PADS_PLAIN seconds of it.
const PADS_PLAIN: f32 = 9.0;

pads_driven: f32 = 0.0;

// How long the game has gone, for what blinks.
ui_clock: f32 = 0.0;

// How fast a thing that is pressed, or pointed at, comes to show it.
ui_quick: f32 = 0.3;

// The game comes up out of black as it starts: how much of the black is
// left, from 1 to 0; and how long it waits, black, first (the first
// pictures can be slow, as all is made ready).
ui_dark: f32 = 1.0;

ui_dark_wait: f32 = 0.2;

// Starting over, the picture goes dark for a moment (see main.l8): how
// dark, from 0 to 1.
ui_blink: f32 = 0.0;

// (And whether it is going dark for that, now.)
ui_again: bool = false;

// A race called that the room holds till those still racing have finished
// (see room_wait, in net.l8): how much RACE and AGAIN show that it waits,
// from 0 to 1 (and RESTART, if it was asked for there); and the seats it
// waits on, as it last did. See put_wait.
show_wait: f32 = 0.0;

wait_seats: int = 0;

// And how much the button it was asked for by here (see race_asked, in
// net.l8) shows that it is held down: pressed in, darker, and with a gold
// line round it, as the course chosen has. (Pressed again, it is asked
// for no more, and comes up: see main.l8.)
show_asked: f32 = 0.0;

// (How much the button being drawn shows each: see ui_button_at.)
button_wait: f32 = 0.0;

button_held: f32 = 0.0;

tick_ui(dt: f32) {
    if (ui_dark_wait > 0.0) ui_dark_wait = ui_dark_wait - dt else ui_dark = maxf(ui_dark - dt / 0.9,
        0.0);
    slow: f32 = ease(9.0, dt);
    // The menu, and what is over the driving (and a sheet over that), are
    // not seen both at once, the one over the other: the one that is going
    // goes first, quickly, and then the other comes.
    quick: f32 = ease(22.0, dt);
    // So too a sheet, the pause's or how the race came out, and what is
    // under it (see show_side): that goes first, and the sheet comes once
    // it has gone; and it comes back once the sheet has gone. (Starting
    // over from a sheet, it waits under the dark, and comes back with the
    // picture: see main.l8. Going back to the menu, it does not come back
    // at all.) In a tall window with no thumbs' panels, nothing is under.
    under: bool = screen_w > screen_h || ui_touch;
    to: f32 = 0.0;
    if (!ui_menu && race.on && race.done && laps.since > 1.4) to = 1.0;
    if (ui_paused || to > 0.0) {
        show_side = lerpf(show_side, 0.0, quick);
        if (show_side < 0.02) show_side = 0.0
    } else if (ui_menu) {
        if (show_drive == 0.0) show_side = 1.0
    } else if (!ui_again && show_pause < 0.02 && show_result < 0.02) show_side = lerpf(show_side,
        1.0, slow);
    if (ui_menu || !ui_paused) {
        show_pause = lerpf(show_pause, 0.0, quick);
        if (show_pause < 0.02) show_pause = 0.0
    } else if (!under || show_side == 0.0) show_pause = lerpf(show_pause, 1.0, ease(14.0,
        dt));
    // (How the race came out waits till what is under it has gone.)
    if (to > 0.0 && under && show_side > 0.0) to = show_result;
    if (ui_menu) show_result = lerpf(show_result, 0.0, quick) else show_result = lerpf(show_result,
        to, slow);
    if (ui_menu) {
        show_drive = lerpf(show_drive, 0.0, quick);
        if (show_drive < 0.02) show_drive = 0.0;
        // (Under how a race came out, none of what is over the driving
        // shows: it is gone at once, and does not come back through the
        // sheet as that goes.)
        if (show_result > 0.5) show_drive = 0.0;
        if (show_drive == 0.0 && show_pause < 0.02 && show_result < 0.02) show_menu = lerpf(show_menu,
            1.0, slow)
    } else {
        show_menu = lerpf(show_menu, 0.0, quick);
        if (show_menu < 0.02) show_menu = 0.0;
        if (show_menu == 0.0) show_drive = lerpf(show_drive, 1.0, slow)
    }
    // (Going back to the menu, what is over the driving goes as it was:
    // the time is kept till it has gone, so that what shows for a while
    // after the start does not come back as it goes.)
    if (!ui_menu) drive_time = drive_time + dt else if (show_drive == 0.0) drive_time = 0.0;
    if (ui_touch && !ui_menu && !ui_paused) pads_driven = pads_driven + dt;
    if (room_wait >= 0) {
        wait_seats = room_wait;
        show_wait = lerpf(show_wait, 1.0, slow)
    } else show_wait = lerpf(show_wait, 0.0, slow);
    asked: f32 = 0.0;
    if (race_asked && room_wait >= 0) asked = 1.0;
    show_asked = lerpf(show_asked, asked, slow);
    ui_quick = ease(22.0, dt);
    ui_clock = ui_clock + dt;
    for k in 0..NAMES row_age[k] = row_age[k] + dt
}

// ---- the pointer ----
// A finger or the mouse on the menus: where it is; whether it is down, and
// which button it is (see touch.l8: each finger is one); whether it went
// down, or came up, since the menus were last drawn, and where it went
// down; and the thing it went down on (see ui_tap), or -1.
ui_x: f32 = -1000.0;

ui_y: f32 = -1000.0;

ui_held: bool = false;

ui_button: int = -1;

ui_went_down: bool = false;

ui_went_up: bool = false;

ui_down_x: f32 = 0.0;

ui_down_y: f32 = 0.0;

ui_hot: int = -1;

// Where the things that can be pressed were, when the menus were last
// drawn: a press on one of them is the menus', and any other is the
// driving's (but while a sheet is up, or the menu, when every press is
// the menus').
const MAX_ZONES: int = 48;

zone_box: []f32 = new f32[MAX_ZONES * 4](0.0);

nzones: int = 0;

ui_modal: bool = true;

// Whether the keys have been used on the menus since the pointer was: the
// thing they are on is then marked.
ui_keys: bool = false;

in_box(
    x: f32,
    y: f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): bool {
    x >= x0 && x < x1 && y >= y0 && y < y1
}

// A button went down at (x, y). Whether it is the menus'. (A press on
// them while another is held takes them over from it: so that a finger
// whose lifting was never heard of, as can happen when a phone takes the
// page away from under it, cannot keep them from being pressed again.)
ui_press(b: int, x: f32, y: f32): bool {
    if (!pointer_button(b)) return false;
    mine: bool = ui_modal;
    for k in 0..nzones {
        if (in_box(x, y, zone_box[k * 4], zone_box[k * 4 + 1], zone_box[k * 4 + 2],
            zone_box[k * 4 + 3])) mine = true
    }
    if (!mine) return false;
    ui_button = b;
    ui_held = true;
    ui_went_down = true;
    ui_x = x;
    ui_y = y;
    ui_down_x = x;
    ui_down_y = y;
    ui_hot = -1;
    ui_keys = false;
    true
}

// A button came up. Whether it was the menus'.
ui_release(b: int, x: f32, y: f32): bool {
    if (b != ui_button) return false;
    ui_button = -1;
    ui_held = false;
    ui_went_up = true;
    ui_x = x;
    ui_y = y;
    true
}

ui_motion(state: int, x: f32, y: f32) {
    // (The menus' finger; or a mouse with no button down, pointing.)
    if (ui_button >= 0) {
        if ((state >> 7 + ui_button & 1) == 1) {
            ui_x = x;
            ui_y = y
        }
    } else if (state / 256 % 32 == 0) {
        ui_x = x;
        ui_y = y
    }
}

// ---- drawing ----
// The colors: what is written, and the edges; the dark of a panel; the
// red of the button that matters most; and gold, for what is chosen.
const INK_R: f32 = 1.0;

const INK_G: f32 = 0.97;

const INK_B: f32 = 0.92;

// A run of plain shapes is begun (it is as many corners as are put before
// it is ended), and ended, with its color.
run_begin(): int {
    hud_n / 2
}

run_end(
    first: int,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (nruns >= MAX_RUNS || hud_n / 2 == first) return;
    end_run(first, r, g, b, a);
    run_plain[nruns - 1] = true
}

// A rounded box's outline, as points round it: UI_ARC steps to a corner.
const UI_ARC: int = 4;

const ROUND_POINTS: int = 20;

round_x: []f32 = new f32[ROUND_POINTS](0.0);

round_y: []f32 = new f32[ROUND_POINTS](0.0);

inner_x: []f32 = new f32[ROUND_POINTS](0.0);

inner_y: []f32 = new f32[ROUND_POINTS](0.0);

round_points(
    xs: []f32,
    ys: []f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    radius: f32
) {
    r: f32 = maxf(minf(radius, minf(x1 - x0, y1 - y0) * 0.5), 0.0);
    n: int = 0;
    for corner in 0..4 {
        cx: f32 = x1 - r;
        cy: f32 = y1 - r;
        if (corner == 1 || corner == 2) cx = x0 + r;
        if (corner >= 2) cy = y0 + r;
        for k in 0..UI_ARC + 1 {
            t: f32 = (corner as f32 + k as f32 / UI_ARC as f32) * PI * 0.5;
            xs[n] = cx + cosf(t) * r;
            ys[n] = cy + sinf(t) * r;
            n = n + 1
        }
    }
}

// A rounded box, filled.
put_round(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    radius: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (a <= 0.003 || x1 <= x0 || y1 <= y0) return;
    round_points(round_x, round_y, x0, y0, x1, y1, radius);
    first: int = run_begin();
    mx: f32 = (x0 + x1) * 0.5;
    my: f32 = (y0 + y1) * 0.5;
    for k in 0..ROUND_POINTS {
        j: int = (k + 1) % ROUND_POINTS;
        put_corner(mx, my);
        put_corner(round_x[k], round_y[k]);
        put_corner(round_x[j], round_y[j])
    }
    run_end(first, r, g, b, a)
}

// A rounded box's edge, so thick, inside it.
put_ring(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    radius: f32,
    thick: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (a <= 0.003 || x1 <= x0 || y1 <= y0) return;
    round_points(round_x, round_y, x0, y0, x1, y1, radius);
    round_points(inner_x, inner_y, x0 + thick, y0 + thick, x1 - thick, y1 - thick,
        radius - thick);
    first: int = run_begin();
    for k in 0..ROUND_POINTS {
        j: int = (k + 1) % ROUND_POINTS;
        put_corner(round_x[k], round_y[k]);
        put_corner(round_x[j], round_y[j]);
        put_corner(inner_x[j], inner_y[j]);
        put_corner(round_x[k], round_y[k]);
        put_corner(inner_x[j], inner_y[j]);
        put_corner(inner_x[k], inner_y[k])
    }
    run_end(first, r, g, b, a)
}

// A straight stroke from one point to another, so thick: six corners, into
// the run that is begun.
put_stroke(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    thick: f32
) {
    dx: f32 = x1 - x0;
    dy: f32 = y1 - y0;
    long: f32 = maxf(sqrtf(dx * dx + dy * dy), 0.001);
    nx: f32 = -dy / long * thick * 0.5;
    ny: f32 = dx / long * thick * 0.5;
    put_corner(x0 - nx, y0 - ny);
    put_corner(x0 + nx, y0 + ny);
    put_corner(x1 + nx, y1 + ny);
    put_corner(x0 - nx, y0 - ny);
    put_corner(x1 + nx, y1 + ny);
    put_corner(x1 - nx, y1 - ny)
}

// An arrow's head, pointing left (way -1) or right, about (cx, cy), so
// big.
put_arrow(
    cx: f32,
    cy: f32,
    size: f32,
    way: f32,
    a: f32
) {
    first: int = hud_n / 2;
    put_stroke(cx - way * size * 0.45, cy - size, cx + way * size * 0.5, cy + size * 0.08,
        size * 0.5);
    put_stroke(cx - way * size * 0.45, cy + size, cx + way * size * 0.5, cy - size * 0.08,
        size * 0.5);
    if (nruns < MAX_RUNS) end_run(first, INK_R, INK_G, INK_B, a)
}

// The text in text_buf, so many times the usual size, with its middle at
// cx and its top at y.
put_words(
    cx: f32,
    y: f32,
    size: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (a <= 0.003) return;
    px: f32 = hud_px;
    hud_px = px * size;
    put_text(floorf(cx - text_width() * 0.5), floorf(y), r, g, b, a);
    hud_px = px
}

// The same, from x on.
put_words_at(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (a <= 0.003) return;
    put_text(floorf(x), floorf(y), r, g, b, a)
}

say(s: str) {
    text_len = 0;
    append(s)
}

// Whose name it is, into text_buf (alone): all of it, if that is no wider
// than `wide`; and if not, as much of the start of it as goes, with a stop
// after it, to say that it is cut. (Not a letter here and there, as goes:
// "Driver 52" is not to be "Driver 2", which is someone else.)
name_to_fit(who: int, wide: f32) {
    text_len = 0;
    append_name(who, NAME_LONG);
    keep: int = text_len;
    fits: bool = text_width() <= wide;
    while (!fits && keep > 1) {
        keep = keep - 1;
        text_len = keep;
        // (No space before the stop.)
        while (text_len > 1 && text_buf[text_len - 1] as int == 32) text_len = text_len - 1;
        append(".");
        fits = text_width() <= wide
    }
}

// Whose name it is, into text_buf, after what is there: no more than
// `most` characters of it.
append_name(who: int, most: int) {
    n: int = name_len(who);
    if (n > most) n = most;
    for i in 0..n {
        if (text_len < len(text_buf)) {
            text_buf[text_len] = names[who * NAME_LONG + i];
            text_len = text_len + 1
        }
    }
}

// ---- things to press ----
// Each has a number of its own, by which it is known from one picture to
// the next: how much it shows that it is pressed, from 0 to 1.
const MAX_THINGS: int = 64;

thing_down: []f32 = new f32[MAX_THINGS](0.0);

// Whether what is being drawn can be pressed at all: not while it is on
// its way out.
ui_live: bool = true;

// The thing `id`, in this box, can be pressed. Whether it was: the pointer
// went down on it, and has come up on it.
ui_tap(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): bool {
    if (!ui_live) {
        thing_down[id] = lerpf(thing_down[id], 0.0, ui_quick);
        return false
    }
    // (A thing is pressed a little way outside what is drawn of it, too:
    // half the room there is between two of them.)
    slop: f32 = 1.5 * hud_px;
    x0 = x0 - slop;
    y0 = y0 - slop;
    x1 = x1 + slop;
    y1 = y1 + slop;
    if (nzones < MAX_ZONES) {
        zone_box[nzones * 4] = x0;
        zone_box[nzones * 4 + 1] = y0;
        zone_box[nzones * 4 + 2] = x1;
        zone_box[nzones * 4 + 3] = y1;
        nzones = nzones + 1
    }
    on: bool = in_box(ui_x, ui_y, x0, y0, x1, y1);
    if (ui_went_down && in_box(ui_down_x, ui_down_y, x0, y0, x1, y1)) ui_hot = id;
    to: f32 = 0.0;
    if (ui_hot == id && ui_held && on) to = 1.0;
    thing_down[id] = lerpf(thing_down[id], to, ui_quick);
    ui_went_up && ui_hot == id && on
}

// How much each shows that the pointer is over it (a mouse's: a finger is
// only ever down).
thing_over: []f32 = new f32[MAX_THINGS](0.0);

// The numbers of the things.
const T_CAR_PREV: int = 1;

const T_CAR_NEXT: int = 2;

const T_COURSE: int = 3;

const T_LAPS: int = 10;

const T_DRIVERS: int = 12;

const T_SKILL: int = 14;

const T_RACE: int = 20;

const T_TRIAL: int = 21;

const T_NAME: int = 22;

const T_PAUSE: int = 23;

const T_RESUME: int = 24;

const T_RESTART: int = 25;

const T_LEAVE: int = 26;

const T_AGAIN: int = 27;

const T_DONE_MENU: int = 28;

// The edges of the window that are not to be drawn at (a phone's notch,
// and the bar at its foot), in the window's pixels: a page says (as a key
// sym: PAGE_SAFE and, ten bits each, the top, the right, the bottom and
// the left).
safe_t: f32 = 0.0;

safe_r: f32 = 0.0;

safe_b: f32 = 0.0;

safe_l: f32 = 0.0;

const PAGE_SAFE: int = 288230376151711744;

ui_page_key(ks: int): bool {
    if (ks < PAGE_SAFE || ks >= PAGE_SAFE * 2) return false;
    w: int = ks - PAGE_SAFE;
    safe_l = (w % 1024) as f32;
    safe_b = (w / 1024 % 1024) as f32;
    safe_r = (w / 1048576 % 1024) as f32;
    safe_t = (w / 1073741824 % 1024) as f32;
    true
}

// A thing in a box: whether it was pressed; and it comes to show whether
// the pointer is on it.
ui_thing(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): bool {
    hit: bool = ui_tap(id, x0, y0, x1, y1);
    to: f32 = 0.0;
    if (ui_live && !ui_touch && !ui_held && in_box(ui_x, ui_y, x0, y0, x1, y1)) to = 1.0;
    thing_over[id] = lerpf(thing_over[id], to, ui_quick);
    hit
}

// The mark that the keys are on something: a gold line round it.
put_focus(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    a: f32
) {
    u: f32 = hud_px;
    if (ui_keys) put_ring(x0 - 1.5 * u, y0 - 1.5 * u, x1 + 1.5 * u, y1 + 1.5 * u,
        7.0 * u, 0.8 * u, 1.0, 0.85, 0.4, a)
}

// The mark that a mouse is over something (`over`, from 0 to 1, as
// thing_over says): a soft line round it.
put_over(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    radius: f32,
    over: f32,
    a: f32
) {
    if (over > 0.01) put_ring(x0, y0, x1, y1, radius, 0.7 * hud_px, INK_R, INK_G,
        INK_B, 0.35 * over * a)
}

// A button, with its word: the one that matters most red, and its word
// large; another brown. `mark`: the keys are on it. Whether it was pressed.
ui_button_at(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    word: str,
    red: bool,
    mark: bool,
    a: f32
): bool {
    hit: bool = ui_thing(id, x0, y0, x1, y1);
    u: f32 = hud_px;
    // (Held down, as it is while a race asked for by it waits, it is as
    // if pressed, and darker still, with a gold line round it.)
    held: f32 = smoothstepf(0.0, 1.0, button_held);
    down: f32 = maxf(thing_down[id], held);
    lift: f32 = 0.12 * thing_over[id] - 0.1 * down - 0.04 * held;
    inset: f32 = down * u * 0.8;
    if (red) put_round(x0 + inset, y0 + inset, x1 - inset, y1 - inset, 6.0 * u, 0.84 + lift,
        0.24 + lift, 0.17 + lift, 0.95 * a) else put_round(x0 + inset, y0 + inset,
        x1 - inset, y1 - inset, 6.0 * u, 0.29 + lift, 0.2 + lift, 0.13 + lift, 0.68 * a);
    put_ring(x0 + inset, y0 + inset, x1 - inset, y1 - inset, 6.0 * u, (0.7 + 0.3 * held) * u,
        INK_R, lerpf(INK_G, 0.85, held), lerpf(INK_B, 0.4, held), 0.95 * a);
    if (mark) put_focus(x0, y0, x1, y1, a);
    say(word);
    // (The word that matters most is large, where there is room; and any
    // word is made smaller to fit. While it waits, it is higher, over the
    // dots that say so; and a large one smaller, but never smaller than
    // the others' words.)
    size: f32 = 1.0;
    if (red) size = clampf((y1 - y0) / (13.0 * u), 1.0, 1.7);
    if (text_width() * size > x1 - x0 - 6.0 * u) size = (x1 - x0 - 6.0 * u) / text_width();
    bw: f32 = smoothstepf(0.0, 1.0, button_wait);
    size = maxf(size * (1.0 - 0.35 * bw), minf(size, 1.0));
    put_words((x0 + x1) * 0.5, (y0 + y1) * 0.5 - 3.5 * u * size - 4.0 * u * bw, size,
        INK_R, INK_G, INK_B, a);
    if (bw > 0.01) put_wait((x0 + x1) * 0.5, y1 - inset - 5.5 * u, a * bw);
    hit
}

// How the dot of a seat the race held waits on breathes (see put_wait),
// from 0 to 1; or -1, if it does not wait on that seat.
wait_breath(seat: int): f32 {
    i: int = 0;
    bit: int = 1;
    for k in 0..seat {
        if (wait_seats / bit % 2 == 1) i = i + 1;
        bit = bit * 2
    }
    if (wait_seats / bit % 2 == 0) return -1.0;
    0.5 + 0.5 * sinf(ui_clock * 4.0 - i as f32 * 1.2)
}

// That a race waits (see show_wait): a dot for each of those still racing,
// in their paint, breathing one after another; or, with none left, as it
// is about to start, three plain ones. Centred at (x, y).
put_wait(x: f32, y: f32, a: f32) {
    u: f32 = hud_px;
    n: int = 0;
    bit: int = 1;
    for k in 0..HUMAN_SEATS {
        if (wait_seats / bit % 2 == 1) n = n + 1;
        bit = bit * 2
    }
    plain: bool = n == 0;
    if (plain) n = 3;
    step: f32 = 9.5 * u;
    at: f32 = x - (n - 1) as f32 * step * 0.5;
    i: int = 0;
    bit = 1;
    for k in 0..HUMAN_SEATS {
        if (plain && k < 3 || !plain && wait_seats / bit % 2 == 1) {
            breath: f32 = 0.5 + 0.5 * sinf(ui_clock * 4.0 - i as f32 * 1.2);
            radius: f32 = (2.8 + 0.5 * breath) * u;
            put_dot(at, y, radius + 0.7 * u, INK_R, INK_G, INK_B, a * (0.55 + 0.45 * breath));
            if (!plain) {
                c: int = paint_of[k] % PAINTS * 3;
                put_dot(at, y, radius, paint_rgb[c], paint_rgb[c + 1], paint_rgb[c + 2],
                    a)
            }
            at = at + step;
            i = i + 1
        }
        bit = bit * 2
    }
}

// One end of a row's value: a square button with an arrow on it, which
// makes the value less (way -1) or more. Faint, and no use, if it cannot.
// Whether it was pressed.
ui_arrow(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    way: f32,
    can: bool,
    a: f32
): bool {
    u: f32 = hud_px;
    hit: bool = ui_thing(id, x0, y0, x1, y1) && can;
    down: f32 = thing_down[id];
    lift: f32 = 0.08 * thing_over[id] + 0.14 * down;
    dim: f32 = 1.0;
    if (!can) dim = 0.28;
    put_round(x0 + 2.0 * u, y0 + 2.0 * u, x1 - 2.0 * u, y1 - 2.0 * u, 4.5 * u, 0.42 + lift,
        0.3 + lift, 0.2 + lift, 0.8 * a * dim);
    put_arrow((x0 + x1) * 0.5 + way * down * u, (y0 + y1) * 0.5, 3.4 * u, way, a * dim);
    hit
}

// A row whose value is made less by a press on its left half, and more by
// one on its right, with an arrow at either end to say so (faint, where
// it cannot be). What was pressed: -1, 0, or 1. The value is written in
// the middle of it (see value_x and value_y: its middle, and its top).
value_x: f32 = 0.0;

value_y: f32 = 0.0;

ui_stepper(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    less: bool,
    more: bool,
    mark: bool,
    a: f32
): int {
    u: f32 = hud_px;
    put_round(x0, y0, x1, y1, 6.0 * u, 0.2, 0.14, 0.09, 0.62 * a);
    if (mark) put_focus(x0, y0, x1, y1, a);
    side: f32 = 13.0 * u;
    mx: f32 = (x0 + x1) * 0.5;
    by: int = 0;
    if (ui_thing(id, x0, y0, mx, y1) && less) by = -1;
    if (ui_thing(id + 1, mx, y0, x1, y1) && more) by = 1;
    for end in 0..2 {
        way: f32 = -1.0;
        bx: f32 = x0;
        can: bool = less;
        if (end == 1) {
            way = 1.0;
            bx = x1 - side;
            can = more
        }
        down: f32 = thing_down[id + end];
        over: f32 = thing_over[id + end];
        if (!can) over = 0.0;
        lift: f32 = 0.14 * over + 0.14 * down;
        dim: f32 = 1.0;
        if (!can) dim = 0.28;
        put_round(bx + 2.0 * u, y0 + 2.0 * u, bx + side - 2.0 * u, y1 - 2.0 * u, 4.0 * u,
            0.42 + lift, 0.3 + lift, 0.2 + lift, 0.8 * a * dim);
        put_over(bx + 2.0 * u, y0 + 2.0 * u, bx + side - 2.0 * u, y1 - 2.0 * u, 4.0 * u,
            over, a);
        put_arrow(bx + side * 0.5 + way * down * u, (y0 + y1) * 0.5, 2.8 * u, way,
            a * dim)
    }
    value_x = mx;
    value_y = (y0 + y1) * 0.5 - 3.5 * u;
    by
}

// ---- the keys ----
// Which of the menu's rows the keys are on: the car, the courses, the
// laps, the drivers, their skill, RACE, and TIME TRIAL; and on a sheet,
// which of its buttons.
const ROW_CAR: int = 0;

const ROW_COURSE: int = 1;

const ROW_LAPS: int = 2;

const ROW_DRIVERS: int = 3;

const ROW_SKILL: int = 4;

const ROW_RACE: int = 5;

const ROW_TRIAL: int = 6;

ui_row: int = 5;

sheet_row: int = 0;

const SKILLS: int = 4;

skill_names: []str = ["EASY", "MEDIUM", "HARD", "ADAPTIVE"];

// A row's value is made less (by -1) or more.
row_step(row: int, by: int) {
    if (row == ROW_CAR) ask(ACT_CAR, by);
    if (row == ROW_COURSE) ask(ACT_COURSE, ((ui_course + by) % COURSES + COURSES) % COURSES);
    if (row == ROW_LAPS) set_laps = clampf((set_laps + by) as f32, 1.0, 9.0) as int;
    if (row == ROW_DRIVERS) set_drivers = clampf((set_drivers + by) as f32, 0.0, MAX_BOTS as f32) as int;
    if (row == ROW_SKILL) set_skill = ((set_skill + by) % SKILLS + SKILLS) % SKILLS
}

// A key went down. Whether it was the menus' (and so nothing else's).
ui_key(ks: int): bool {
    left: bool = ks == 65361 || ks == 97;
    right: bool = ks == 65363 || ks == 100;
    up: bool = ks == 65362 || ks == 119;
    down: bool = ks == 65364 || ks == 115;
    enter: bool = ks == 65293 || ks == 32;
    escape: bool = ks == 65307;
    if (!(left || right || up || down || enter || escape)) return false;
    if (ui_paused) {
        ui_keys = true;
        if (up) sheet_row = (sheet_row + 2) % 3;
        if (down) sheet_row = (sheet_row + 1) % 3;
        if (escape) ask(ACT_RESUME, 0);
        if (enter) {
            if (sheet_row == 0) ask(ACT_RESUME, 0);
            if (sheet_row == 1) ask(ACT_AGAIN, 0);
            if (sheet_row == 2) ask(ACT_MENU, 0)
        }
        return true
    }
    if (show_result > 0.5) {
        ui_keys = true;
        if (up || down || left || right) sheet_row = 1 - sheet_row % 2;
        if (escape) ask(ACT_MENU, 0);
        if (enter) {
            if (sheet_row % 2 == 0) ask(ACT_AGAIN, 0) else ask(ACT_MENU, 0)
        }
        return true
    }
    if (ui_menu) {
        if (escape) return false;
        ui_keys = true;
        rows: int = 7;
        if (up) ui_row = (ui_row + rows - 1) % rows;
        if (down) ui_row = (ui_row + 1) % rows;
        if (left || right) {
            by: int = 1;
            if (left) by = -1;
            if (ui_row >= ROW_RACE) ui_row = ROW_RACE + ROW_TRIAL - ui_row else row_step(ui_row,
                by)
        }
        if (enter) {
            if (ui_row == ROW_TRIAL) ask(ACT_TRIAL, 0) else ask(ACT_RACE, 0)
        }
        return true
    }
    // Driving: only Escape is the menus'.
    if (escape) {
        sheet_row = 0;
        ask(ACT_PAUSE, 0);
        return true
    }
    false
}

// ---- the menu ----
// A course's card: its shape, the road's middle as a line (see keep_track,
// in track.l8), fitted into the box.
put_course(
    k: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    a: f32
) {
    if (!kept[k] || nruns >= MAX_RUNS) return;
    o: int = k * MAX_TRACK;
    n: int = kept_n[k];
    lo: V3 = kept_p[o];
    hi: V3 = kept_p[o];
    for i in 0..n {
        lo = v3(minf(lo.x, kept_p[o + i].x), 0.0, minf(lo.z, kept_p[o + i].z));
        hi = v3(maxf(hi.x, kept_p[o + i].x), 0.0, maxf(hi.z, kept_p[o + i].z))
    }
    by: f32 = minf((x1 - x0) / maxf(hi.x - lo.x, 1.0), (y1 - y0) / maxf(hi.z - lo.z,
        1.0));
    ox: f32 = (x0 + x1) * 0.5 - (lo.x + hi.x) * 0.5 * by;
    oy: f32 = (y0 + y1) * 0.5 - (lo.z + hi.z) * 0.5 * by;
    first: int = hud_n / 2;
    step: int = 10;
    i: int = 0;
    while (i < n) {
        p: V3 = kept_p[o + i];
        q: V3 = kept_p[o + (i + step) % n];
        put_stroke(ox + p.x * by, oy + p.z * by, ox + q.x * by, oy + q.z * by, hud_px * 1.1);
        i = i + step
    }
    end_run(first, INK_R, INK_G, INK_B, a);
    // (And its start.)
    put_dot(ox + kept_p[o].x * by, oy + kept_p[o].z * by, hud_px * 1.5, 1.0, 0.85,
        0.4, a)
}

// A swipe across the car chooses another: how far the pointer must go.
const SWIPE: f32 = 40.0;

// The menu leaves the car the window. All there is to choose is in a dock
// along the window's foot: in a window wide enough, one strip (the
// courses, what a race is to be, and the buttons, side by side); in a
// narrow one, as a phone held upright, the same stacked. The car's card is
// small, at the top; and an arrow stands either side of the car itself.
//
// Whether the window is one for the stacked dock.
menu_tall(): bool {
    !(screen_w >= 680 && screen_w * 13 >= screen_h * 10)
}

// The size of a pixel of the writing (see hud_px), for a window w wide: by
// the window's shorter side, but no bigger than lets the strip fit across.
STRIP_LEAST: f32 = 329.0;

ui_unit(w: int): f32 {
    short: f32 = minf(w as f32, screen_h as f32);
    u: f32 = clampf(short / 175.0, 2.4, 3.2);
    if (!menu_tall()) u = minf(u, w as f32 / STRIP_LEAST);
    u
}

// How tall the dock is, and the car's card (where it takes room above the
// car: in the stacked window), in pixels of the writing.
const STRIP_HIGH: f32 = 39.0;

const STACK_HIGH: f32 = 96.0;

const CARD_HIGH: f32 = 40.0;

// Where the car is to be in the window, up and down: the middle of the
// room the menu leaves it.
menu_car_y(): f32 {
    u: f32 = hud_px;
    top: f32 = safe_t + 6.0 * u;
    foot: f32 = screen_h as f32 - safe_b - 6.0 * u - STRIP_HIGH * u;
    if (menu_tall()) {
        top = top + CARD_HIGH * u;
        foot = screen_h as f32 - safe_b - 6.0 * u - STACK_HIGH * u
    }
    (top + foot) * 0.5 + 4.0 * u
}

// How far up the picture is moved for that (see View's shift, in
// render.l8).
menu_shift(): f32 {
    1.0 - 2.0 * menu_car_y() / maxf(screen_h as f32, 1.0)
}

// The car's card is in columns: in each, a measure's name, and its bar,
// so long (in pixels of the writing), a little way after it. How wide the
// names in a column are (as wide as the widest of them there); how far
// apart the columns are (clearly farther than a name is from its bar, so
// that each bar is seen to be its own name's); and how wide the card is,
// in so many columns.
const CARD_BAR: f32 = 26.0;

const CARD_GAP: f32 = 5.0;

const CARD_APART: f32 = 15.0;

card_label(col: int, cols: int): f32 {
    wide: f32 = 0.0;
    for k in 0..MARKS {
        if (k % cols == col) {
            say(mark_names[k]);
            wide = maxf(wide, text_width())
        }
    }
    wide
}

card_wide(cols: int): f32 {
    u: f32 = hud_px;
    wide: f32 = (cols - 1) as f32 * CARD_APART * u;
    for col in 0..cols wide = wide + card_label(col, cols) + (CARD_GAP + CARD_BAR) * u;
    wide
}

// The car's card: its name, and its four measures (see car_mark), each a
// bar; in so many columns. Its middle at cx, its top at y.
put_car_card(
    cx: f32,
    y: f32,
    cols: int,
    a: f32
) {
    u: f32 = hud_px;
    say(car_names[hud_kind]);
    put_words(cx, y, 1.6, INK_R, INK_G, INK_B, a);
    long: f32 = CARD_BAR * u;
    x: f32 = cx - card_wide(cols) * 0.5;
    for col in 0..cols {
        label: f32 = card_label(col, cols);
        for k in 0..MARKS {
            if (k % cols == col) {
                ry: f32 = y + (15.0 + 10.0 * (k / cols) as f32) * u;
                say(mark_names[k]);
                put_words_at(x, ry, INK_R, INK_G, INK_B, a);
                // (Each bar in a dark track, the length of the most: seen
                // as so much of the most on the palest ground, as snow.)
                bx: f32 = x + label + CARD_GAP * u;
                put_round(bx, ry + 1.5 * u, bx + long, ry + 5.5 * u, 2.0 * u, 0.2,
                    0.14, 0.09, 0.55 * a);
                put_round(bx, ry + 1.5 * u, bx + maxf(long * card_bars[k], 4.0 * u),
                    ry + 5.5 * u, 2.0 * u, 1.0, 0.86, 0.4, a)
            }
        }
        x = x + label + (CARD_GAP + CARD_BAR + CARD_APART) * u
    }
}

// What a race is to be, in a grid two across from (x, y), each cell so
// wide: how many laps; with nobody else here, how many computer drivers
// and how good; with others, who they are; and the player's name, to press
// to change (the page asks for another).
ui_setup(
    x: f32,
    y: f32,
    cell: f32,
    row_h: f32,
    a: f32
) {
    u: f32 = hud_px;
    gap: f32 = 3.0 * u;
    x2: f32 = x + cell + gap;
    y2: f32 = y + row_h + gap;
    by_laps: int = ui_stepper(T_LAPS, x, y, x + cell, y + row_h, set_laps > 1, set_laps < 9,
        ui_row == ROW_LAPS, a);
    text_len = 0;
    append_int(set_laps);
    if (set_laps == 1) append(" LAP") else append(" LAPS");
    put_words(value_x, value_y, 1.0, INK_R, INK_G, INK_B, a);
    if (by_laps != 0) row_step(ROW_LAPS, by_laps);
    // How many computer drivers race (with the others here, if there are
    // any: one of their devices drives them), and how good.
    by_drivers: int = ui_stepper(T_DRIVERS, x2, y, x2 + cell, y + row_h, set_drivers > 0,
        set_drivers < MAX_BOTS, ui_row == ROW_DRIVERS, a);
    text_len = 0;
    if (set_drivers == 0) append("NO BOTS") else {
        append_int(set_drivers);
        if (set_drivers == 1) append(" BOT") else append(" BOTS")
    }
    put_words(value_x, value_y, 1.0, INK_R, INK_G, INK_B, a);
    if (by_drivers != 0) row_step(ROW_DRIVERS, by_drivers);
    // (Under the drivers, how good they are: by a dot, as a driver is
    // shown in the list of who is ahead. With none, nothing.)
    bots: bool = set_drivers > 0;
    by_skill: int = ui_stepper(T_SKILL, x2, y2, x2 + cell, y2 + row_h, bots, bots,
        ui_row == ROW_SKILL, a);
    if (bots) {
        say(skill_names[set_skill % SKILLS]);
        sw: f32 = text_width();
        put_dot(value_x - sw * 0.5 - 1.0 * u, value_y + 3.5 * u, 1.9 * u, paint_rgb[3],
            paint_rgb[4], paint_rgb[5], a);
        put_words(value_x + 3.0 * u, value_y, 1.0, INK_R, INK_G, INK_B, a)
    }
    if (by_skill != 0) row_step(ROW_SKILL, by_skill);
    // The name: written as something to be written on, with a line under
    // it. (Pressed, the page puts a box to write in over it, which writes
    // nothing itself: what is written in it is written here as it is
    // typed, and the line under it is lit; see name_editing.)
    name_box_on = false;
    if (ui_online) {
        nx: f32 = x;
        ny: f32 = y2;
        if (ui_thing(T_NAME, nx, ny, nx + cell, ny + row_h)) ask(ACT_NAME, 0);
        if (ui_live) {
            slop: f32 = 1.5 * u;
            name_box_on = true;
            name_box[0] = nx - slop;
            name_box[1] = ny - slop;
            name_box[2] = nx + cell + slop;
            name_box[3] = ny + row_h + slop
        }
        writing: f32 = 0.0;
        if (name_editing) writing = 1.0;
        glow: f32 = 0.1 * thing_down[T_NAME] + 0.12 * thing_over[T_NAME] + 0.06 * writing;
        put_round(nx, ny, nx + cell, ny + row_h, 6.0 * u, 0.2 + glow, 0.14 + glow,
            0.09 + glow, 0.62 * a);
        put_over(nx, ny, nx + cell, ny + row_h, 6.0 * u, thing_over[T_NAME] * (1.0 - writing),
            a);
        if (name_editing) put_ring(nx, ny, nx + cell, ny + row_h, 6.0 * u, 0.8 * u,
            1.0, 0.85, 0.4, a);
        name_to_fit(NAME_ME, cell - 8.0 * u);
        nw: f32 = text_width();
        mx: f32 = nx + cell * 0.5;
        ty: f32 = ny + row_h * 0.5 - 4.0 * u;
        // (All of it chosen, to be written over: on gold.)
        if (name_editing && name_chosen && nw > 0.0) put_round(mx - nw * 0.5 - 1.0 * u,
            ty - 0.5 * u, mx + nw * 0.5 + 1.0 * u, ty + 8.5 * u, 1.5 * u, 1.0, 0.85,
            0.4, 0.45 * a);
        put_words(mx, ty, 1.0, INK_R, INK_G, INK_B, 0.9 * a);
        line_w: f32 = maxf(nw, 10.0 * u);
        if (name_editing) put_rect(mx - line_w * 0.5, ny + row_h * 0.5 + 4.5 * u,
            mx + line_w * 0.5, ny + row_h * 0.5 + 5.3 * u, 1.0, 0.85, 0.4, a) else put_rect(mx - nw * 0.5,
            ny + row_h * 0.5 + 4.5 * u, mx + nw * 0.5, ny + row_h * 0.5 + 5.1 * u,
            INK_R, INK_G, INK_B, 0.5 * a);
        run_plain[nruns - 1] = true;
        // (Where the next letter goes, blinking.)
        if (name_editing && !name_chosen && ui_clock - floorf(ui_clock) < 0.6) {
            cx: f32 = floorf(mx + nw * 0.5) + 0.8 * u;
            put_rect(cx, ty - 0.5 * u, cx + 0.8 * u, ty + 8.0 * u, INK_R, INK_G, INK_B,
                a);
            run_plain[nruns - 1] = true
        }
    }
}

// Where the name is to be written, when it shows (see ui_setup): the box
// a press on it is in, in the window's pixels (its left, top, right and
// foot). The page is told (see main.l8), to put its box to write in there.
name_box_on: bool = false;

name_box: []f32 = new f32[4](0.0);

// The courses, a card each, across from x to x1, so tall; and under them
// the chosen one's name, and what its road is.
ui_courses(
    x: f32,
    y: f32,
    x1: f32,
    high: f32,
    a: f32
) {
    u: f32 = hud_px;
    gap: f32 = 3.0 * u;
    each: f32 = (x1 - x - 2.0 * gap) / COURSES as f32;
    for k in 0..COURSES {
        x0: f32 = x + k as f32 * (each + gap);
        id: int = T_COURSE + k;
        if (ui_thing(id, x0, y, x0 + each, y + high) && k != ui_course) ask(ACT_COURSE,
            k);
        inset: f32 = thing_down[id] * u * 0.8;
        over: f32 = thing_over[id];
        if (k == ui_course) over = 0.0;
        lift: f32 = 0.13 * over;
        if (k == ui_course) {
            put_round(x0 + inset, y + inset, x0 + each - inset, y + high - inset,
                5.0 * u, 0.52, 0.36, 0.15, 0.85 * a);
            put_ring(x0 + inset, y + inset, x0 + each - inset, y + high - inset, 5.0 * u,
                0.9 * u, 1.0, 0.85, 0.4, a)
        } else {
            put_round(x0 + inset, y + inset, x0 + each - inset, y + high - inset,
                5.0 * u, 0.2 + lift, 0.14 + lift, 0.09 + lift, 0.62 * a);
            put_over(x0 + inset, y + inset, x0 + each - inset, y + high - inset, 5.0 * u,
                over, a)
        }
        put_course(k, x0 + 5.0 * u, y + 4.0 * u, x0 + each - 5.0 * u, y + high - 4.0 * u,
            a)
    }
    if (ui_row == ROW_COURSE) put_focus(x, y, x1, y + high, a);
    // (Only its name, where both do not fit.)
    say(course_names[ui_course]);
    name_w: f32 = text_width() * 0.9;
    road: int = course_grounds[ui_course * 3];
    text_len = 0;
    if (road == PACK) append("SNOW") else if (road == DIRT) append("DIRT") else append("TARMAC");
    road_w: f32 = text_width() * 0.9;
    both: bool = name_w + road_w + 5.0 * u <= x1 - x;
    if (!both) road_w = -5.0 * u;
    tx: f32 = (x + x1) * 0.5 - (name_w + road_w + 5.0 * u) * 0.5;
    ty: f32 = y + high + 2.5 * u;
    // (On a slim plate, as all else is: on snow it is not to be read
    // without.)
    put_round(tx - 3.5 * u, ty - 1.5 * u, tx + name_w + 5.0 * u + road_w + 3.5 * u,
        ty + 7.8 * u, 4.0 * u, 0.2, 0.14, 0.09, 0.5 * a);
    if (both) put_words(tx + name_w + 5.0 * u + road_w * 0.5, ty, 0.9, INK_R, INK_G,
        INK_B, 0.7 * a);
    say(course_names[ui_course]);
    put_words(tx + name_w * 0.5, ty, 0.9, 1.0, 0.85, 0.4, a)
}

// Who else is here, in a line: WITH, and each of them, by name, after a
// dot of their car's paint (as in the list of who is ahead), so that a dot
// under RACE is seen to be theirs: one the race held waits on has their dot
// breathe with that one (see put_wait). As many as go in 30 characters,
// and how many more. So big, at the height y; its middle at x (`middle`),
// or its right end.
const WITH_MOST: int = 8;

with_who: []int = new int[WITH_MOST](0);

put_with(
    x: f32,
    y: f32,
    size: f32,
    middle: bool,
    a: f32
) {
    px: f32 = hud_px;
    hud_px = px * size;
    u: f32 = hud_px;
    n: int = 0;
    more: int = 0;
    long: int = 5;
    for k in 0..nracers {
        who: int = racer_who[k];
        if (who < HUMAN_SEATS) {
            if (n < WITH_MOST && long + name_len(who) + 2 <= 30) {
                with_who[n] = who;
                n = n + 1;
                long = long + name_len(who) + 2
            } else more = more + 1
        }
    }
    // How wide it all is: the word, and each name after its dot.
    dot: f32 = 7.5 * u;
    gap: f32 = 5.0 * u;
    say("WITH");
    wide: f32 = text_width();
    for i in 0..n {
        text_len = 0;
        append_name(with_who[i], NAME_LONG);
        wide = wide + gap + dot + text_width()
    }
    if (more > 0) {
        text_len = 0;
        append("+");
        append_int(more);
        wide = wide + gap + text_width()
    }
    at: f32 = x - wide;
    if (middle) at = x - wide * 0.5;
    at = floorf(at);
    say("WITH");
    put_words_at(at, y, 1.0, 0.85, 0.4, a);
    at = at + text_width() + gap;
    sw: f32 = smoothstepf(0.0, 1.0, show_wait);
    for i in 0..n {
        who: int = with_who[i];
        c: int = paint_of[who] % PAINTS * 3;
        radius: f32 = 2.2 * u;
        breath: f32 = wait_breath(who);
        if (breath >= 0.0) radius = radius + 0.8 * u * breath * sw;
        put_dot(at + 3.0 * u, y + 3.5 * u, radius + 0.6 * u, INK_R, INK_G, INK_B,
            0.8 * a);
        put_dot(at + 3.0 * u, y + 3.5 * u, radius, paint_rgb[c], paint_rgb[c + 1],
            paint_rgb[c + 2], a);
        at = at + dot;
        text_len = 0;
        append_name(who, NAME_LONG);
        put_words_at(at, y, 1.0, 0.85, 0.4, a);
        at = at + text_width() + gap
    }
    if (more > 0) {
        text_len = 0;
        append("+");
        append_int(more);
        put_words_at(at, y, 1.0, 0.85, 0.4, a)
    }
    hud_px = px
}

ui_menu_scene(w: int) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    a: f32 = show_menu;
    tall: bool = menu_tall();
    away: f32 = (1.0 - a) * 30.0 * u;
    l: f32 = safe_l + 6.0 * u;
    r: f32 = wf - safe_r - 6.0 * u;
    t: f32 = safe_t + 6.0 * u;
    b: f32 = hf - safe_b - 6.0 * u + away;
    gap: f32 = 3.0 * u;
    row_h: f32 = 17.0 * u;
    if (tall) {
        // Stacked: the courses; what a race is to be; and the buttons,
        // side by side, lowest, in a thumb's reach.
        wide: f32 = minf(r - l, 176.0 * u);
        x: f32 = (wf - wide) * 0.5;
        y: f32 = b - STACK_HIGH * u;
        ui_courses(x, y, x + wide, 20.0 * u, a);
        y = y + 33.0 * u;
        ui_setup(x, y, (wide - gap) * 0.5, row_h, a);
        y = y + 2.0 * row_h + gap + 4.0 * u;
        split: f32 = x + wide * 0.6;
        button_wait = show_wait;
        button_held = show_asked;
        if (ui_button_at(T_RACE, x, y, split - gap * 0.5, b, "RACE", true, ui_row == ROW_RACE,
            a)) ask(ACT_RACE, 0);
        button_wait = 0.0;
        button_held = 0.0;
        if (ui_button_at(T_TRIAL, split + gap * 0.5, y, x + wide, b, "TIME TRIAL",
            false, ui_row == ROW_TRIAL, a)) ask(ACT_TRIAL, 0);
        put_car_card(wf * 0.5, t - away, 2, a)
    } else {
        // One strip: the courses at the left, what a race is to be in the
        // middle, and the buttons at the right.
        room: f32 = r - l;
        go_w: f32 = clampf(room * 0.2, 56.0 * u, 84.0 * u);
        cell: f32 = clampf((room - go_w - 96.0 * u - 13.0 * u) * 0.5, 76.0 * u, 88.0 * u);
        grid_w: f32 = 2.0 * cell + gap;
        cards_w: f32 = clampf(room - grid_w - go_w - 10.0 * u, 96.0 * u, 150.0 * u);
        x: f32 = (wf - (cards_w + grid_w + go_w + 10.0 * u)) * 0.5;
        y: f32 = b - STRIP_HIGH * u;
        ui_courses(x, y, x + cards_w, 27.0 * u, a);
        x = x + cards_w + 5.0 * u;
        ui_setup(x, y, cell, 18.0 * u, a);
        x = x + grid_w + 5.0 * u;
        button_wait = show_wait;
        button_held = show_asked;
        if (ui_button_at(T_RACE, x, y, x + go_w, y + 21.0 * u, "RACE", true, ui_row == ROW_RACE,
            a)) ask(ACT_RACE, 0);
        button_wait = 0.0;
        button_held = 0.0;
        if (ui_button_at(T_TRIAL, x, y + 24.0 * u, x + go_w, b, "TIME TRIAL", false,
            ui_row == ROW_TRIAL, a)) ask(ACT_TRIAL, 0);
        put_car_card(l + card_wide(1) * 0.5, t - away, 1, a)
    }
    // Who else is here (a race is with them): a line under the car's card,
    // or beside it.
    if (ui_others > 0) {
        if (tall) put_with(wf * 0.5, t + CARD_HIGH * u - 1.0 * u - away, 0.9, true,
            a) else put_with(r, t - away, 1.0, false, a)
    }
    // An arrow either side of the car: the car before, and the next.
    cy: f32 = menu_car_y() - 4.0 * u;
    out: f32 = minf(wf * 0.5 - safe_l - 14.0 * u, 104.0 * u);
    if (tall) cy = cy + 6.0 * u;
    for end in 0..2 {
        way: f32 = -1.0;
        if (end == 1) way = 1.0;
        id: int = T_CAR_PREV + end;
        ax: f32 = wf * 0.5 + way * (out + (1.0 - a) * 20.0 * u);
        if (ui_thing(id, ax - 11.0 * u, cy - 20.0 * u, ax + 11.0 * u, cy + 20.0 * u)) ask(ACT_CAR,
            way as int);
        lift: f32 = 0.14 * thing_over[id] + 0.14 * thing_down[id];
        put_round(ax - 8.0 * u, cy - 8.0 * u, ax + 8.0 * u, cy + 8.0 * u, 8.0 * u,
            0.2 + lift, 0.14 + lift, 0.09 + lift, 0.5 * a);
        put_over(ax - 8.0 * u, cy - 8.0 * u, ax + 8.0 * u, cy + 8.0 * u, 8.0 * u,
            thing_over[id], a);
        put_arrow(ax + way * thing_down[id] * u, cy, 3.4 * u, way, a);
        if (ui_row == ROW_CAR) put_focus(ax - 8.0 * u, cy - 8.0 * u, ax + 8.0 * u,
            cy + 8.0 * u, a)
    }
    // A swipe across the car, anywhere nothing else is, is another car.
    if (ui_live && ui_went_up && ui_hot < 0 && absf(ui_x - ui_down_x) > maxf(SWIPE,
        14.0 * u) && absf(ui_y - ui_down_y) < absf(ui_x - ui_down_x)) {
        if (ui_x < ui_down_x) ask(ACT_CAR, 1) else ask(ACT_CAR, -1)
    }
}

// ---- driving ----
// The list of who is ahead: a row each, which slides to its place when the
// order changes. Where each one's row is (by whose name it has), and how
// long since it was last in the list.
row_y: []f32 = new f32[NAMES](0.0);

row_age: []f32 = new f32[NAMES](100.0);

// (And whether the rows drawn now show who a race held waits on: see
// put_racer_row.)
rows_wait: bool = false;

// A racer's row: its place (if it has one), a dot of its car's paint (as
// on the map), its name, and (`times`) its time, if it has finished. Whose
// name it has, its car's paint, whether it has finished, and its time; and
// how high the row is (10 pixels of the writing, or a little less where
// there is not room).
put_racer_row(
    who: int,
    paint: int,
    done: bool,
    time: f32,
    place: int,
    x0: f32,
    y: f32,
    x1: f32,
    high: f32,
    times: bool,
    a: f32
) {
    u: f32 = hud_px;
    me: bool = who == NAME_ME;
    if (me) put_round(x0, y, x1, y + high, 3.5 * u, 1.0, 0.97, 0.92, 0.3 * a) else put_round(x0,
        y, x1, y + high, 3.5 * u, 0.16, 0.11, 0.07, 0.34 * a);
    // (The words are in the row's middle, up and down.)
    ty: f32 = y + 1.5 * u + (high - 10.0 * u) * 0.5;
    x: f32 = x0 + 3.0 * u;
    if (place > 0) {
        text_len = 0;
        append_int(place);
        put_text_right(x + 11.0 * u, ty, INK_R, INK_G, INK_B, a);
        x = x + 14.0 * u
    }
    c: int = paint % PAINTS * 3;
    // (While the player waits on a race held, the dot of one it waits on
    // breathes, as under the button: see put_wait.)
    radius: f32 = 2.6 * u;
    breath: f32 = -1.0;
    if (rows_wait && who < HUMAN_SEATS) breath = wait_breath(who);
    if (breath >= 0.0) {
        sw: f32 = smoothstepf(0.0, 1.0, show_wait);
        radius = radius + 0.8 * u * breath * sw;
        put_dot(x + 3.0 * u, y + high * 0.5, radius + 0.6 * u, INK_R, INK_G, INK_B,
            0.8 * a * sw)
    }
    put_dot(x + 3.0 * u, y + high * 0.5, radius, paint_rgb[c], paint_rgb[c + 1], paint_rgb[c + 2],
        a);
    room: f32 = x1 - 3.0 * u - (x + 8.0 * u);
    if (times) room = room - 40.0 * u;
    name_to_fit(who, room);
    if (done && !times) put_words_at(x + 8.0 * u, ty, 1.0, 0.85, 0.4, a) else put_words_at(x + 8.0 * u,
        ty, INK_R, INK_G, INK_B, a);
    if (times && done) {
        text_len = 0;
        append_time(time);
        put_text_right(x1 - 3.0 * u, ty, INK_R, INK_G, INK_B, 0.9 * a)
    }
}

// The thumbs' panels (see touch.l8): each an outline, lit while it is
// used, its word at its top; and the steering one's track, with a mark
// where the thumb is. At first they are plain to see, to be found; once
// thumbs have driven a while, they are faint (but while one is held), and
// only the track, the mark, and small words for the veer button and the
// brake are left of them.
put_pads(w: int, a: f32) {
    if (a <= 0.003) return;
    u: f32 = hud_px;
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    p: *Pointers = pointers;
    place_pads();
    y0: f32 = pad_top * hf;
    y1: f32 = pad_foot * hf;
    steer: bool = p.stick >= 0;
    brake: bool = p.pedal >= 0 && p.y[maxf(p.pedal as f32, 0.0) as int] >= brake_top * hf;
    veer: bool = p.pedal >= 0 && !brake;
    // (How far they have gone faint, from 0 to 1.)
    known: f32 = smoothstepf(PADS_PLAIN, PADS_PLAIN + 2.5, pads_driven);
    edge: f32 = lerpf(0.85, 0.2, known);
    fill: f32 = lerpf(0.16, 0.04, known);
    sx0: f32 = pad_steer_l * wf;
    sx1: f32 = pad_steer_r * wf;
    if (steer) {
        put_round(sx0, y0, sx1, y1, 7.0 * u, 0.29, 0.2, 0.13, 0.38 * a);
        put_ring(sx0, y0, sx1, y1, 7.0 * u, 0.7 * u, INK_R, INK_G, INK_B, 0.85 * a)
    } else {
        put_round(sx0, y0, sx1, y1, 7.0 * u, 0.29, 0.2, 0.13, fill * a);
        put_ring(sx0, y0, sx1, y1, 7.0 * u, 0.7 * u, INK_R, INK_G, INK_B, edge * a)
    }
    say("STEER");
    put_words((sx0 + sx1) * 0.5, y0 + 5.0 * u, 1.0, INK_R, INK_G, INK_B, 0.8 * a * (1.0 - known));
    my: f32 = (y0 + y1) * 0.5 + 4.0 * u;
    tx0: f32 = lerpf(sx0, sx1, 0.1);
    tx1: f32 = lerpf(sx0, sx1, 0.9);
    put_rect(tx0, my - 0.6 * u, tx1, my + 0.6 * u, INK_R, INK_G, INK_B, 0.55 * a);
    run_plain[nruns - 1] = true;
    tx: f32 = steer_middle();
    if (steer) tx = clampf(p.x[maxf(p.stick as f32, 0.0) as int], tx0, tx1);
    high: f32 = 6.0 * u;
    if (steer) high = 9.0 * u;
    put_round(tx - 1.3 * u, my - high, tx + 1.3 * u, my + high, 1.3 * u, INK_R, INK_G,
        INK_B, a);
    // The veer button: gold while it is held.
    vx0: f32 = pad_veer_l * wf;
    vx1: f32 = pad_veer_r * wf;
    vy1: f32 = pad_veer_foot * hf;
    if (veer) {
        put_round(vx0, y0, vx1, vy1, 7.0 * u, 1.0, 0.85, 0.4, 0.32 * a);
        put_ring(vx0, y0, vx1, vy1, 7.0 * u, 0.7 * u, INK_R, INK_G, INK_B, 0.85 * a)
    } else {
        put_round(vx0, y0, vx1, vy1, 7.0 * u, 0.29, 0.2, 0.13, fill * a);
        put_ring(vx0, y0, vx1, vy1, 7.0 * u, 0.7 * u, INK_R, INK_G, INK_B, edge * a)
    }
    say("VEER");
    put_words((vx0 + vx1) * 0.5, y0 + 5.0 * u, lerpf(1.0, 0.85, known), INK_R, INK_G,
        INK_B, lerpf(0.8, 0.6, known) * a);
    // The brake: small, and faint.
    bx0: f32 = brake_l * wf;
    bx1: f32 = brake_r * wf;
    by0: f32 = brake_top * hf;
    by1: f32 = brake_foot * hf;
    if (brake) put_round(bx0, by0, bx1, by1, 5.0 * u, 0.84, 0.24, 0.17, 0.5 * a) else put_round(bx0,
        by0, bx1, by1, 5.0 * u, 0.29, 0.2, 0.13, 0.12 * a * (1.0 - known));
    put_ring(bx0, by0, bx1, by1, 5.0 * u, 0.5 * u, INK_R, INK_G, INK_B, lerpf(0.5,
        0.2, known) * a);
    say("BRAKE");
    put_words((bx0 + bx1) * 0.5, (by0 + by1) * 0.5 - 3.0 * u, lerpf(1.0, 0.85, known),
        INK_R, INK_G, INK_B, lerpf(0.6, 0.45, known) * a)
}

// The pause's button: two bars, in the window's top left corner (the lap
// and its time are beside it: see build_hud).
const PAUSE_SIDE: f32 = 16.0;

ui_drive_scene(w: int) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    a: f32 = show_drive;
    px0: f32 = safe_l + 4.0 * u - (1.0 - a) * 24.0 * u;
    // (Under how a race came out, the pause is no use.)
    pa: f32 = a * (1.0 - show_result);
    py0: f32 = safe_t + 4.0 * u;
    side: f32 = PAUSE_SIDE * u;
    // (A press anywhere in the corner is on it.)
    if (ui_thing(T_PAUSE, 0.0, 0.0, px0 + side + 5.0 * u, py0 + side + 6.0 * u)) {
        sheet_row = 0;
        ask(ACT_PAUSE, 0)
    }
    lift: f32 = 0.08 * thing_over[T_PAUSE] + 0.14 * thing_down[T_PAUSE];
    put_round(px0, py0, px0 + side, py0 + side, 5.0 * u, 0.2 + lift, 0.14 + lift,
        0.09 + lift, 0.62 * pa);
    put_round(px0 + 5.0 * u, py0 + 4.5 * u, px0 + 7.2 * u, py0 + side - 4.5 * u, 0.8 * u,
        INK_R, INK_G, INK_B, 0.95 * pa);
    put_round(px0 + side - 7.2 * u, py0 + 4.5 * u, px0 + side - 5.0 * u, py0 + side - 4.5 * u,
        0.8 * u, INK_R, INK_G, INK_B, 0.95 * pa);
    // (Under a sheet, the thumbs' panels are not wanted, and would show
    // through it: they go before it comes, and come after it goes. See
    // show_side.)
    pads: f32 = a * show_side;
    if (ui_touch) put_pads(w, pads);
    // The list of who is ahead: in a race; or, out of one, of who else is
    // here. In a wide window, under the map, at the right: as many rows as
    // there is room for (above the thumbs' panels, if they are in the
    // way). In a tall one, where the right is over the road ahead, small,
    // under the lap and its time at the left: three rows. If that is not
    // all of them, those about the player. (In a race, not till it starts:
    // before, it is only the order of the grid, and the count is in the
    // middle. It comes in as it starts.)
    racing: bool = hud_race.on;
    if (nracers > 1 && show_result < 0.5) {
        la: f32 = a;
        if (racing) la = a * smoothstepf(0.0, 0.6, hud_race.time);
        if (wf > hf) la = la * show_side;
        // (Under how a race came out, it is not wanted: it goes as that
        // comes, not at a blink.)
        la = la * (1.0 - smoothstepf(0.0, 0.5, show_result));
        long: f32 = 83.0 * u;
        if (!racing) long = 69.0 * u;
        x1: f32 = wf - safe_r - 8.0 + (1.0 - a) * 30.0 * u;
        top: f32 = hud_list * hf;
        foot: f32 = hf - safe_b - 14.0 * u;
        place_pads();
        if (ui_touch && wf > hf) foot = pad_top * hf - 3.0 * u;
        room: int = ((foot - top) / (11.0 * u)) as int;
        if (hud_list_left) {
            // (Wide enough for a name as the game first gives it, as
            // "Driver 52"; a longer one is cut: see name_to_fit.)
            long = 68.0 * u;
            x1 = safe_l + 4.0 * u + long - (1.0 - a) * 30.0 * u;
            room = 3
        }
        if (room < 1) room = 1;
        from: int = 0;
        if (nracers > room) from = clampf((hud_place - 1 - room / 2) as f32, 0.0,
            (nracers - room) as f32) as int;
        // (The list keeps to its own band, from its first row to its last:
        // a row sliding in from outside it, or out, as the places change,
        // goes no more than a little past its edge (not over the race's
        // clock above it, say), and fades as it is farther out.)
        last: f32 = top + (room - 1) as f32 * 11.0 * u;
        rows_wait = race_asked;
        for at in 0..nracers {
            k: int = racer_order[at];
            who: int = racer_who[k];
            to: f32 = top + (at - from) as f32 * 11.0 * u;
            // (One that has just come into the list is in its place at
            // once.)
            if (row_age[who] > 0.5) row_y[who] = to;
            row_age[who] = 0.0;
            row_y[who] = lerpf(row_y[who], to, ui_quick * 0.45);
            place: int = 0;
            if (racing) place = at + 1;
            out: f32 = maxf(top - row_y[who], row_y[who] - last);
            fade: f32 = 1.0 - smoothstepf(0.0, 4.0 * u, out);
            if (fade * la > 0.003) put_racer_row(who, racer_paint[k], racer_done[k],
                racer_time[k], place, x1 - long, clampf(row_y[who], top - 2.5 * u,
                last + 2.5 * u), x1, 10.0 * u, false, la * fade)
        }
        rows_wait = false
    }
    // For the keys, what they are: for a while after the start.
    if (!ui_touch && drive_time < 8.0) {
        say("LEFT AND RIGHT STEER   SPACE VEERS   DOWN BRAKES");
        if (text_width() > wf - 12.0 * u) say("ARROWS STEER   SPACE VEERS");
        put_words(wf * 0.5, hf - 12.0 * u, 1.0, INK_R, INK_G, INK_B, 0.85 * a * (1.0 - smoothstepf(6.5,
            8.0, drive_time)))
    }
}

// ---- the sheets ----
// The picture goes dim under a sheet, and the sheet comes up: in a tall
// window, where the car is high in the picture, into the middle, but
// never over the car; and in a wide one, where the car is in the middle,
// into the right third, so that the car is still seen beside it.
put_dim(w: int, a: f32) {
    put_rect(0.0, 0.0, w as f32, screen_h as f32, 0.05, 0.03, 0.02, 0.45 * a);
    run_plain[nruns - 1] = true
}

put_sheet(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    a: f32
) {
    u: f32 = hud_px;
    put_round(x0, y0, x1, y1, 9.0 * u, 0.16, 0.11, 0.07, 0.88 * a)
}

// Where a sheet so wide goes across a window w wide: its left.
sheet_left(w: int, sw: f32): f32 {
    wf: f32 = w as f32;
    if (wf <= screen_h as f32) return floorf((wf - sw) * 0.5);
    floorf(wf - safe_r - 8.0 * hud_px - sw)
}

// The room a sheet has up and down, in a window w wide: from its top (in a
// tall window, under the car: see hud_car_foot), to its foot.
sheet_from(w: int): f32 {
    hf: f32 = screen_h as f32;
    top: f32 = safe_t + 4.0 * hud_px;
    if (w as f32 <= hf && hud_car_foot > 0.0) top = maxf(top, hud_car_foot * hf + 4.0 * hud_px);
    top
}

sheet_to(): f32 {
    screen_h as f32 - safe_b - 4.0 * hud_px
}

// Where a sheet so high goes, up and down: its top. In the middle, if
// there is room there; if not, as near it as there is; and if the sheet
// is too high for its room, still under the car.
sheet_top(w: int, sh: f32): f32 {
    maxf(minf((screen_h as f32 - sh) * 0.5, sheet_to() - sh), sheet_from(w))
}

// The pause: go on, start over, or back to the menu.
ui_pause_sheet(w: int) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    a: f32 = show_pause;
    put_dim(w, a);
    sw: f32 = minf(126.0 * u, wf - 12.0 * u);
    sh: f32 = 94.0 * u;
    x0: f32 = sheet_left(w, sw);
    y0: f32 = sheet_top(w, sh) + (1.0 - a) * 14.0 * u;
    put_sheet(x0, y0, x0 + sw, y0 + sh, a);
    bx0: f32 = x0 + 8.0 * u;
    bx1: f32 = x0 + sw - 8.0 * u;
    y: f32 = y0 + 8.0 * u;
    if (ui_button_at(T_RESUME, bx0, y, bx1, y + 26.0 * u, "RESUME", true, sheet_row == 0,
        a)) ask(ACT_RESUME, 0);
    y = y + 31.0 * u;
    if (race_asked) button_wait = show_wait;
    button_held = show_asked;
    if (ui_button_at(T_RESTART, bx0, y, bx1, y + 21.0 * u, "RESTART", false, sheet_row == 1,
        a)) ask(ACT_AGAIN, 0);
    button_wait = 0.0;
    button_held = 0.0;
    y = y + 26.0 * u;
    if (ui_button_at(T_LEAVE, bx0, y, bx1, y + 21.0 * u, "MENU", false, sheet_row == 2,
        a)) ask(ACT_MENU, 0)
}

// How a place is said: 1ST, 2ND, 3RD, 4TH.
append_place(place: int) {
    append_int(place);
    if (place % 10 == 1 && place % 100 != 11) append("ST") else if (place % 10 == 2 && place % 100 != 12) append("ND") else if (place % 10 == 3 && place % 100 != 13) append("RD") else append("TH")
}

// How the race came out, as the result's sheet shows it: kept while the
// race is finished, so that while the sheet goes (as the race is started
// again) it still shows the race it was for. The player's place, and the
// racers in order: whose name each has, its paint, and whether it has
// finished, and in what time.
sheet_place: int = 0;

sheet_n: int = 0;

sheet_who: []int = new int[MAX_RACERS](0);

sheet_paint: []int = new int[MAX_RACERS](0);

sheet_done: []bool = new bool[MAX_RACERS](false);

sheet_time: []f32 = new f32[MAX_RACERS](0.0);

// (The place it says, once the sheet has come, is never changed under the
// player's eyes. Nor is anyone lost from the list: see racers_keep.)
keep_result() {
    if (show_result < 0.5) sheet_place = hud_place;
    sheet_n = nracers;
    for at in 0..nracers {
        k: int = racer_order[at];
        sheet_who[at] = racer_who[k];
        sheet_paint[at] = racer_paint[k];
        sheet_done[at] = racer_done[k];
        sheet_time[at] = racer_time[k]
    }
}

// How a race came out: the player's place, large; everyone, in order, with
// their times (the player's among them); and to race again, or go back to
// the menu.
ui_result_sheet(w: int) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    a: f32 = show_result;
    if (race.on && race.done) keep_result();
    put_dim(w, a * 0.6);
    // As many of the racers as there is room for, a row each: closer
    // together if that is not all of them, but not much closer; and the
    // player always (in the last row, if it would not be in one).
    room: f32 = sheet_to() - sheet_from(w) - 66.0 * u;
    step: f32 = clampf(room / maxf(sheet_n as f32, 1.0), 9.5 * u, 11.0 * u);
    most: int = (room / step) as int;
    if (most < 1) most = 1;
    rows: int = sheet_n;
    if (rows > most) rows = most;
    sw: f32 = minf(142.0 * u, wf - 8.0 * u);
    sh: f32 = 66.0 * u + rows as f32 * step;
    x0: f32 = sheet_left(w, sw);
    y0: f32 = sheet_top(w, sh) + (1.0 - a) * 14.0 * u;
    put_sheet(x0, y0, x0 + sw, y0 + sh, a);
    text_len = 0;
    append_place(sheet_place);
    put_words(x0 + sw * 0.5, y0 + 8.0 * u, 2.0, 1.0, 0.85, 0.4, a);
    y: f32 = y0 + 28.0 * u;
    mine: int = 0;
    for at in 0..sheet_n {
        if (sheet_who[at] == NAME_ME) mine = at
    }
    rows_wait = true;
    for at in 0..rows {
        k: int = at;
        place: int = at + 1;
        if (at == rows - 1 && mine >= rows) {
            k = mine;
            place = mine + 1
        }
        // (Each comes in a little after the one above it.)
        late: f32 = clampf(a * 1.6 - at as f32 * 0.06, 0.0, 1.0);
        put_racer_row(sheet_who[k], sheet_paint[k], sheet_done[k], sheet_time[k],
            place, x0 + 6.0 * u, y, x0 + sw - 6.0 * u, step - 1.0 * u, true, late * a);
        y = y + step
    }
    rows_wait = false;
    y = y + 5.0 * u;
    mid: f32 = x0 + sw * 0.42;
    if (ui_button_at(T_DONE_MENU, x0 + 8.0 * u, y + 2.0 * u, mid - 2.0 * u, y + 24.0 * u,
        "MENU", false, sheet_row % 2 == 1, a)) ask(ACT_MENU, 0);
    button_wait = show_wait;
    button_held = show_asked;
    if (ui_button_at(T_AGAIN, mid + 2.0 * u, y, x0 + sw - 8.0 * u, y + 26.0 * u, "AGAIN",
        true, sheet_row % 2 == 0, a)) ask(ACT_AGAIN, 0);
    button_wait = 0.0;
    button_held = 0.0
}

// ---- all of it ----
// The menus as they are now, into the picture's words and shapes (after
// what hud.l8 has put there); and what was pressed is asked of the game.
build_ui(w: int) {
    nzones = 0;
    sheet: bool = show_pause > 0.5 || show_result > 0.5;
    ui_modal = ui_menu || sheet;
    result: bool = !ui_menu && race.on && race.done && laps.since > 1.4;
    ui_live = ui_menu;
    if (show_menu > 0.02) ui_menu_scene(w);
    ui_live = !ui_menu && !ui_paused && !result;
    if (show_drive > 0.02) ui_drive_scene(w);
    ui_live = result && !ui_paused;
    if (show_result > 0.02) ui_result_sheet(w);
    ui_live = ui_paused;
    if (show_pause > 0.02) ui_pause_sheet(w);
    ui_live = true;
    // (And over it all, while the game comes up, the black; and the dark
    // the picture goes for a moment as the car is started over.)
    if (ui_dark > 0.0) {
        put_rect(0.0, 0.0, w as f32, screen_h as f32, 0.0, 0.0, 0.0, smoothstepf(0.0,
            1.0, ui_dark));
        run_plain[nruns - 1] = true
    }
    if (ui_blink > 0.0) {
        put_rect(0.0, 0.0, w as f32, screen_h as f32, 0.04, 0.03, 0.02, smoothstepf(0.0,
            1.0, ui_blink));
        run_plain[nruns - 1] = true
    }
    if (ui_went_up) ui_hot = -1;
    ui_went_down = false;
    ui_went_up = false
}
