tag race;

use_tag skate;

// The game's menus, drawn by the game over its own picture (with the rest
// of what is written there: see hud.l8), and worked by a finger, a mouse,
// or the keys.
//
// - The menu, over the car at the start: the car's card, with an arrow
//   either side of its name to choose another (or a swipe across the car);
//   the courses, a card each; how many laps a race is, and against
//   computer drivers, how many and how good; and RACE, and TIME TRIAL.
// - Driving: a button for the pause; the list of who is ahead; and, for
//   thumbs, the panels they drive by (see touch.l8), which light as they
//   are used.
// - The pause, and how a race came out: a sheet in the middle each, over
//   the picture gone dim.
//
// Each comes and goes smoothly. What is chosen is asked of the game as an
// act (see ui_act), which the game takes up (see main.l8).
const ACT_NONE: int = 0;

const ACT_RACE: int = 1;

const ACT_TRIAL: int = 2;

const ACT_MENU: int = 3;

const ACT_AGAIN: int = 4;

// (With ui_arg: the car after, 1, or before, -1.)
const ACT_CAR: int = 5;

// (With ui_arg: which course.)
const ACT_COURSE: int = 6;

const ACT_PAUSE: int = 7;

const ACT_RESUME: int = 8;

const ACT_NAME: int = 9;

ui_act: int = 0;

ui_arg: int = 0;

ask(act: int, arg: int) {
    ui_act = act;
    ui_arg = arg
}

// What the game tells the menus: whether the menu is up, whether there is
// a page (and so others, perhaps, and a name to change), whether thumbs
// drive, whether the pause is on, and how many others are on the track.
ui_menu: bool = true;

ui_online: bool = false;

ui_touch: bool = false;

ui_paused: bool = false;

ui_others: int = 0;

// How much of each shows, from 0 to 1 (see tick_ui): the menu, what is
// over the driving, the pause, and the race's result; and how long the
// car has been driven since the menu.
show_menu: f32 = 1.0;

show_drive: f32 = 0.0;

show_pause: f32 = 0.0;

show_result: f32 = 0.0;

drive_time: f32 = 0.0;

// How fast a thing that is pressed, or pointed at, comes to show it.
ui_quick: f32 = 0.3;

// The game comes up out of black as it starts: how much of the black is
// left, from 1 to 0; and how long it waits, black, first (the first
// pictures can be slow, as all is made ready).
ui_dark: f32 = 1.0;

ui_dark_wait: f32 = 0.2;

tick_ui(dt: f32) {
    if (ui_dark_wait > 0.0) ui_dark_wait = ui_dark_wait - dt else ui_dark = maxf(ui_dark - dt / 0.9,
        0.0);
    slow: f32 = ease(9.0, dt);
    to: f32 = 0.0;
    if (ui_menu) to = 1.0;
    show_menu = lerpf(show_menu, to, slow);
    show_drive = lerpf(show_drive, 1.0 - to, slow);
    to = 0.0;
    if (ui_paused) to = 1.0;
    show_pause = lerpf(show_pause, to, ease(14.0, dt));
    to = 0.0;
    if (!ui_menu && race.on && race.done && laps.since > 1.4) to = 1.0;
    show_result = lerpf(show_result, to, slow);
    if (ui_menu) drive_time = 0.0 else drive_time = drive_time + dt;
    ui_quick = ease(22.0, dt);
    for k in 0..NAMES row_age[k] = row_age[k] + dt
}

// ---- the pointer ----
// A finger or the mouse on the menus: where it is; whether it is down, and
// which button it is (see touch.l8: each finger is one); whether it went
// down, or came up, since the menus were last drawn, and where it went
// down; and the thing it went down on (see ui_tap), or -1.
ui_x: f32 = -1000.0;

ui_y: f32 = -1000.0;

ui_held: bool = false;

ui_button: int = -1;

ui_went_down: bool = false;

ui_went_up: bool = false;

ui_down_x: f32 = 0.0;

ui_down_y: f32 = 0.0;

ui_hot: int = -1;

// Where the things that can be pressed were, when the menus were last
// drawn: a press on one of them is the menus', and any other is the
// driving's (but while a sheet is up, or the menu, when every press is
// the menus').
const MAX_ZONES: int = 48;

zone_box: []f32 = new f32[MAX_ZONES * 4](0.0);

nzones: int = 0;

ui_modal: bool = true;

// Whether the keys have been used on the menus since the pointer was: the
// thing they are on is then marked.
ui_keys: bool = false;

in_box(
    x: f32,
    y: f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): bool {
    x >= x0 && x < x1 && y >= y0 && y < y1
}

// A button went down at (x, y). Whether it is the menus'.
ui_press(b: int, x: f32, y: f32): bool {
    if (!pointer_button(b) || ui_button >= 0) return false;
    mine: bool = ui_modal;
    for k in 0..nzones {
        if (in_box(x, y, zone_box[k * 4], zone_box[k * 4 + 1], zone_box[k * 4 + 2],
            zone_box[k * 4 + 3])) mine = true
    }
    if (!mine) return false;
    ui_button = b;
    ui_held = true;
    ui_went_down = true;
    ui_x = x;
    ui_y = y;
    ui_down_x = x;
    ui_down_y = y;
    ui_hot = -1;
    ui_keys = false;
    true
}

// A button came up. Whether it was the menus'.
ui_release(b: int, x: f32, y: f32): bool {
    if (b != ui_button) return false;
    ui_button = -1;
    ui_held = false;
    ui_went_up = true;
    ui_x = x;
    ui_y = y;
    true
}

ui_motion(state: int, x: f32, y: f32) {
    // (The menus' finger; or a mouse with no button down, pointing.)
    if (ui_button >= 0) {
        if ((state >> 7 + ui_button & 1) == 1) {
            ui_x = x;
            ui_y = y
        }
    } else if (state / 256 % 32 == 0) {
        ui_x = x;
        ui_y = y
    }
}

// ---- drawing ----
// The colors: what is written, and the edges; the dark of a panel; the
// red of the button that matters most; and gold, for what is chosen.
const INK_R: f32 = 1.0;

const INK_G: f32 = 0.97;

const INK_B: f32 = 0.92;

// A run of plain shapes is begun (it is as many corners as are put before
// it is ended), and ended, with its color.
run_begin(): int {
    hud_n / 2
}

run_end(
    first: int,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (nruns >= MAX_RUNS || hud_n / 2 == first) return;
    end_run(first, r, g, b, a);
    run_plain[nruns - 1] = true
}

// A rounded box's outline, as points round it: UI_ARC steps to a corner.
const UI_ARC: int = 4;

const ROUND_POINTS: int = 20;

round_x: []f32 = new f32[ROUND_POINTS](0.0);

round_y: []f32 = new f32[ROUND_POINTS](0.0);

inner_x: []f32 = new f32[ROUND_POINTS](0.0);

inner_y: []f32 = new f32[ROUND_POINTS](0.0);

round_points(
    xs: []f32,
    ys: []f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    radius: f32
) {
    r: f32 = maxf(minf(radius, minf(x1 - x0, y1 - y0) * 0.5), 0.0);
    n: int = 0;
    for corner in 0..4 {
        cx: f32 = x1 - r;
        cy: f32 = y1 - r;
        if (corner == 1 || corner == 2) cx = x0 + r;
        if (corner >= 2) cy = y0 + r;
        for k in 0..UI_ARC + 1 {
            t: f32 = (corner as f32 + k as f32 / UI_ARC as f32) * PI * 0.5;
            xs[n] = cx + cosf(t) * r;
            ys[n] = cy + sinf(t) * r;
            n = n + 1
        }
    }
}

// A rounded box, filled.
put_round(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    radius: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (a <= 0.003 || x1 <= x0 || y1 <= y0) return;
    round_points(round_x, round_y, x0, y0, x1, y1, radius);
    first: int = run_begin();
    mx: f32 = (x0 + x1) * 0.5;
    my: f32 = (y0 + y1) * 0.5;
    for k in 0..ROUND_POINTS {
        j: int = (k + 1) % ROUND_POINTS;
        put_corner(mx, my);
        put_corner(round_x[k], round_y[k]);
        put_corner(round_x[j], round_y[j])
    }
    run_end(first, r, g, b, a)
}

// A rounded box's edge, so thick, inside it.
put_ring(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    radius: f32,
    thick: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (a <= 0.003 || x1 <= x0 || y1 <= y0) return;
    round_points(round_x, round_y, x0, y0, x1, y1, radius);
    round_points(inner_x, inner_y, x0 + thick, y0 + thick, x1 - thick, y1 - thick,
        radius - thick);
    first: int = run_begin();
    for k in 0..ROUND_POINTS {
        j: int = (k + 1) % ROUND_POINTS;
        put_corner(round_x[k], round_y[k]);
        put_corner(round_x[j], round_y[j]);
        put_corner(inner_x[j], inner_y[j]);
        put_corner(round_x[k], round_y[k]);
        put_corner(inner_x[j], inner_y[j]);
        put_corner(inner_x[k], inner_y[k])
    }
    run_end(first, r, g, b, a)
}

// A straight stroke from one point to another, so thick: six corners, into
// the run that is begun.
put_stroke(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    thick: f32
) {
    dx: f32 = x1 - x0;
    dy: f32 = y1 - y0;
    long: f32 = maxf(sqrtf(dx * dx + dy * dy), 0.001);
    nx: f32 = -dy / long * thick * 0.5;
    ny: f32 = dx / long * thick * 0.5;
    put_corner(x0 - nx, y0 - ny);
    put_corner(x0 + nx, y0 + ny);
    put_corner(x1 + nx, y1 + ny);
    put_corner(x0 - nx, y0 - ny);
    put_corner(x1 + nx, y1 + ny);
    put_corner(x1 - nx, y1 - ny)
}

// An arrow's head, pointing left (way -1) or right, about (cx, cy), so
// big.
put_arrow(
    cx: f32,
    cy: f32,
    size: f32,
    way: f32,
    a: f32
) {
    first: int = hud_n / 2;
    put_stroke(cx - way * size * 0.45, cy - size, cx + way * size * 0.5, cy + size * 0.08,
        size * 0.5);
    put_stroke(cx - way * size * 0.45, cy + size, cx + way * size * 0.5, cy - size * 0.08,
        size * 0.5);
    if (nruns < MAX_RUNS) end_run(first, INK_R, INK_G, INK_B, a)
}

// The text in text_buf, so many times the usual size, with its middle at
// cx and its top at y.
put_words(
    cx: f32,
    y: f32,
    size: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (a <= 0.003) return;
    px: f32 = hud_px;
    hud_px = px * size;
    put_text(floorf(cx - text_width() * 0.5), floorf(y), r, g, b, a);
    hud_px = px
}

// The same, from x on.
put_words_at(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (a <= 0.003) return;
    put_text(floorf(x), floorf(y), r, g, b, a)
}

say(s: str) {
    text_len = 0;
    append(s)
}

// Whose name it is, into text_buf (alone): as much of it as is no wider
// than `wide`.
name_to_fit(who: int, wide: f32) {
    text_len = 0;
    n: int = name_len(who);
    for i in 0..n {
        if (text_len < len(text_buf)) {
            text_buf[text_len] = names[who * NAME_LONG + i];
            text_len = text_len + 1;
            if (text_width() > wide) text_len = text_len - 1
        }
    }
}

// Whose name it is, into text_buf, after what is there: no more than
// `most` characters of it.
append_name(who: int, most: int) {
    n: int = name_len(who);
    if (n > most) n = most;
    for i in 0..n {
        if (text_len < len(text_buf)) {
            text_buf[text_len] = names[who * NAME_LONG + i];
            text_len = text_len + 1
        }
    }
}

// ---- things to press ----
// Each has a number of its own, by which it is known from one picture to
// the next: how much it shows that it is pressed, from 0 to 1.
const MAX_THINGS: int = 64;

thing_down: []f32 = new f32[MAX_THINGS](0.0);

// Whether what is being drawn can be pressed at all: not while it is on
// its way out.
ui_live: bool = true;

// The thing `id`, in this box, can be pressed. Whether it was: the pointer
// went down on it, and has come up on it.
ui_tap(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): bool {
    if (!ui_live) {
        thing_down[id] = lerpf(thing_down[id], 0.0, ui_quick);
        return false
    }
    // (A thing is pressed a little way outside what is drawn of it, too:
    // half the room there is between two of them.)
    slop: f32 = 1.5 * hud_px;
    x0 = x0 - slop;
    y0 = y0 - slop;
    x1 = x1 + slop;
    y1 = y1 + slop;
    if (nzones < MAX_ZONES) {
        zone_box[nzones * 4] = x0;
        zone_box[nzones * 4 + 1] = y0;
        zone_box[nzones * 4 + 2] = x1;
        zone_box[nzones * 4 + 3] = y1;
        nzones = nzones + 1
    }
    on: bool = in_box(ui_x, ui_y, x0, y0, x1, y1);
    if (ui_went_down && in_box(ui_down_x, ui_down_y, x0, y0, x1, y1)) ui_hot = id;
    to: f32 = 0.0;
    if (ui_hot == id && ui_held && on) to = 1.0;
    thing_down[id] = lerpf(thing_down[id], to, ui_quick);
    ui_went_up && ui_hot == id && on
}

// How much each shows that the pointer is over it (a mouse's: a finger is
// only ever down).
thing_over: []f32 = new f32[MAX_THINGS](0.0);

// The numbers of the things.
const T_CAR_PREV: int = 1;

const T_CAR_NEXT: int = 2;

const T_COURSE: int = 3;

const T_LAPS: int = 10;

const T_DRIVERS: int = 12;

const T_SKILL: int = 14;

const T_RACE: int = 20;

const T_TRIAL: int = 21;

const T_NAME: int = 22;

const T_PAUSE: int = 23;

const T_RESUME: int = 24;

const T_RESTART: int = 25;

const T_LEAVE: int = 26;

const T_AGAIN: int = 27;

const T_DONE_MENU: int = 28;

// The edges of the window that are not to be drawn at (a phone's notch,
// and the bar at its foot), in the window's pixels: a page says (as a key
// sym: PAGE_SAFE and, ten bits each, the top, the right, the bottom and
// the left).
safe_t: f32 = 0.0;

safe_r: f32 = 0.0;

safe_b: f32 = 0.0;

safe_l: f32 = 0.0;

const PAGE_SAFE: int = 288230376151711744;

ui_page_key(ks: int): bool {
    if (ks < PAGE_SAFE || ks >= PAGE_SAFE * 2) return false;
    w: int = ks - PAGE_SAFE;
    safe_l = (w % 1024) as f32;
    safe_b = (w / 1024 % 1024) as f32;
    safe_r = (w / 1048576 % 1024) as f32;
    safe_t = (w / 1073741824 % 1024) as f32;
    true
}

// A thing in a box: whether it was pressed; and it comes to show whether
// the pointer is on it.
ui_thing(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
): bool {
    hit: bool = ui_tap(id, x0, y0, x1, y1);
    to: f32 = 0.0;
    if (ui_live && !ui_touch && !ui_held && in_box(ui_x, ui_y, x0, y0, x1, y1)) to = 1.0;
    thing_over[id] = lerpf(thing_over[id], to, ui_quick);
    hit
}

// The mark that the keys are on something: a gold line round it.
put_focus(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    a: f32
) {
    u: f32 = hud_px;
    if (ui_keys) put_ring(x0 - 1.5 * u, y0 - 1.5 * u, x1 + 1.5 * u, y1 + 1.5 * u,
        7.0 * u, 0.8 * u, 1.0, 0.85, 0.4, a)
}

// A button, with its word: the one that matters most red, and its word
// large; another brown. `mark`: the keys are on it. Whether it was pressed.
ui_button_at(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    word: str,
    red: bool,
    mark: bool,
    a: f32
): bool {
    hit: bool = ui_thing(id, x0, y0, x1, y1);
    u: f32 = hud_px;
    down: f32 = thing_down[id];
    lift: f32 = 0.06 * thing_over[id] - 0.1 * down;
    inset: f32 = down * u * 0.8;
    if (red) put_round(x0 + inset, y0 + inset, x1 - inset, y1 - inset, 6.0 * u, 0.84 + lift,
        0.24 + lift, 0.17 + lift, 0.95 * a) else put_round(x0 + inset, y0 + inset,
        x1 - inset, y1 - inset, 6.0 * u, 0.29 + lift, 0.2 + lift, 0.13 + lift, 0.68 * a);
    put_ring(x0 + inset, y0 + inset, x1 - inset, y1 - inset, 6.0 * u, 0.7 * u, INK_R,
        INK_G, INK_B, 0.95 * a);
    if (mark) put_focus(x0, y0, x1, y1, a);
    say(word);
    // (The word that matters most is large, where there is room; and any
    // word is made smaller to fit.)
    size: f32 = 1.0;
    if (red) size = clampf((y1 - y0) / (13.0 * u), 1.0, 1.7);
    if (text_width() * size > x1 - x0 - 6.0 * u) size = (x1 - x0 - 6.0 * u) / text_width();
    put_words((x0 + x1) * 0.5, (y0 + y1) * 0.5 - 3.5 * u * size, size, INK_R, INK_G,
        INK_B, a);
    hit
}

// One end of a row's value: a square button with an arrow on it, which
// makes the value less (way -1) or more. Faint, and no use, if it cannot.
// Whether it was pressed.
ui_arrow(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    way: f32,
    can: bool,
    a: f32
): bool {
    u: f32 = hud_px;
    hit: bool = ui_thing(id, x0, y0, x1, y1) && can;
    down: f32 = thing_down[id];
    lift: f32 = 0.08 * thing_over[id] + 0.14 * down;
    dim: f32 = 1.0;
    if (!can) dim = 0.28;
    put_round(x0 + 2.0 * u, y0 + 2.0 * u, x1 - 2.0 * u, y1 - 2.0 * u, 4.5 * u, 0.42 + lift,
        0.3 + lift, 0.2 + lift, 0.8 * a * dim);
    put_arrow((x0 + x1) * 0.5 + way * down * u, (y0 + y1) * 0.5, 3.4 * u, way, a * dim);
    hit
}

// A row whose value is made less by a press on its left half, and more by
// one on its right, with an arrow at either end to say so (faint, where
// it cannot be). What was pressed: -1, 0, or 1. The value is written in
// the middle of it (see value_x and value_y: its middle, and its top).
value_x: f32 = 0.0;

value_y: f32 = 0.0;

ui_stepper(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    less: bool,
    more: bool,
    mark: bool,
    a: f32
): int {
    u: f32 = hud_px;
    put_round(x0, y0, x1, y1, 6.0 * u, 0.2, 0.14, 0.09, 0.62 * a);
    if (mark) put_focus(x0, y0, x1, y1, a);
    side: f32 = 13.0 * u;
    mx: f32 = (x0 + x1) * 0.5;
    by: int = 0;
    if (ui_thing(id, x0, y0, mx, y1) && less) by = -1;
    if (ui_thing(id + 1, mx, y0, x1, y1) && more) by = 1;
    for end in 0..2 {
        way: f32 = -1.0;
        bx: f32 = x0;
        can: bool = less;
        if (end == 1) {
            way = 1.0;
            bx = x1 - side;
            can = more
        }
        down: f32 = thing_down[id + end];
        lift: f32 = 0.08 * thing_over[id + end] + 0.14 * down;
        dim: f32 = 1.0;
        if (!can) dim = 0.28;
        put_round(bx + 2.0 * u, y0 + 2.0 * u, bx + side - 2.0 * u, y1 - 2.0 * u, 4.0 * u,
            0.42 + lift, 0.3 + lift, 0.2 + lift, 0.8 * a * dim);
        put_arrow(bx + side * 0.5 + way * down * u, (y0 + y1) * 0.5, 2.8 * u, way,
            a * dim)
    }
    value_x = mx;
    value_y = (y0 + y1) * 0.5 - 3.5 * u;
    by
}

// ---- the keys ----
// Which of the menu's rows the keys are on: the car, the courses, the
// laps, the drivers, their skill, RACE, and TIME TRIAL; and on a sheet,
// which of its buttons.
const ROW_CAR: int = 0;

const ROW_COURSE: int = 1;

const ROW_LAPS: int = 2;

const ROW_DRIVERS: int = 3;

const ROW_SKILL: int = 4;

const ROW_RACE: int = 5;

const ROW_TRIAL: int = 6;

ui_row: int = 5;

sheet_row: int = 0;

const SKILLS: int = 4;

skill_names: []str = ["EASY", "MEDIUM", "HARD", "ADAPTIVE"];

// A row's value is made less (by -1) or more.
row_step(row: int, by: int) {
    if (row == ROW_CAR) ask(ACT_CAR, by);
    if (row == ROW_COURSE) ask(ACT_COURSE, ((course + by) % COURSES + COURSES) % COURSES);
    if (row == ROW_LAPS) set_laps = clampf((set_laps + by) as f32, 1.0, 9.0) as int;
    if (row == ROW_DRIVERS) set_drivers = clampf((set_drivers + by) as f32, 1.0, MAX_BOTS as f32) as int;
    if (row == ROW_SKILL) set_skill = ((set_skill + by) % SKILLS + SKILLS) % SKILLS
}

// A key went down. Whether it was the menus' (and so nothing else's).
ui_key(ks: int): bool {
    left: bool = ks == 65361 || ks == 97;
    right: bool = ks == 65363 || ks == 100;
    up: bool = ks == 65362 || ks == 119;
    down: bool = ks == 65364 || ks == 115;
    enter: bool = ks == 65293 || ks == 32;
    escape: bool = ks == 65307;
    if (!(left || right || up || down || enter || escape)) return false;
    if (ui_paused) {
        ui_keys = true;
        if (up) sheet_row = (sheet_row + 2) % 3;
        if (down) sheet_row = (sheet_row + 1) % 3;
        if (escape) ask(ACT_RESUME, 0);
        if (enter) {
            if (sheet_row == 0) ask(ACT_RESUME, 0);
            if (sheet_row == 1) ask(ACT_AGAIN, 0);
            if (sheet_row == 2) ask(ACT_MENU, 0)
        }
        return true
    }
    if (show_result > 0.5) {
        ui_keys = true;
        if (up || down || left || right) sheet_row = 1 - sheet_row % 2;
        if (escape) ask(ACT_MENU, 0);
        if (enter) {
            if (sheet_row % 2 == 0) ask(ACT_AGAIN, 0) else ask(ACT_MENU, 0)
        }
        return true
    }
    if (ui_menu) {
        if (escape) return false;
        ui_keys = true;
        rows: int = 7;
        if (up) ui_row = (ui_row + rows - 1) % rows;
        if (down) ui_row = (ui_row + 1) % rows;
        // (With others here, a race is against them: there are no
        // computer drivers to choose.)
        while (ui_others > 0 && (ui_row == ROW_DRIVERS || ui_row == ROW_SKILL)) {
            if (up) ui_row = ui_row - 1 else ui_row = ui_row + 1
        }
        if (left || right) {
            by: int = 1;
            if (left) by = -1;
            if (ui_row >= ROW_RACE) ui_row = ROW_RACE + ROW_TRIAL - ui_row else row_step(ui_row,
                by)
        }
        if (enter) {
            if (ui_row == ROW_TRIAL) ask(ACT_TRIAL, 0) else ask(ACT_RACE, 0)
        }
        return true
    }
    // Driving: only Escape is the menus'.
    if (escape) {
        sheet_row = 0;
        ask(ACT_PAUSE, 0);
        return true
    }
    false
}

// ---- the menu ----
// A course's card: its shape, the road's middle as a line (see keep_track,
// in track.l8), fitted into the box.
put_course(
    k: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    a: f32
) {
    if (!kept[k] || nruns >= MAX_RUNS) return;
    o: int = k * MAX_TRACK;
    n: int = kept_n[k];
    lo: V3 = kept_p[o];
    hi: V3 = kept_p[o];
    for i in 0..n {
        lo = v3(minf(lo.x, kept_p[o + i].x), 0.0, minf(lo.z, kept_p[o + i].z));
        hi = v3(maxf(hi.x, kept_p[o + i].x), 0.0, maxf(hi.z, kept_p[o + i].z))
    }
    by: f32 = minf((x1 - x0) / maxf(hi.x - lo.x, 1.0), (y1 - y0) / maxf(hi.z - lo.z,
        1.0));
    ox: f32 = (x0 + x1) * 0.5 - (lo.x + hi.x) * 0.5 * by;
    oy: f32 = (y0 + y1) * 0.5 - (lo.z + hi.z) * 0.5 * by;
    first: int = hud_n / 2;
    step: int = 10;
    i: int = 0;
    while (i < n) {
        p: V3 = kept_p[o + i];
        q: V3 = kept_p[o + (i + step) % n];
        put_stroke(ox + p.x * by, oy + p.z * by, ox + q.x * by, oy + q.z * by, hud_px * 1.1);
        i = i + step
    }
    end_run(first, INK_R, INK_G, INK_B, a);
    // (And its start.)
    put_dot(ox + kept_p[o].x * by, oy + kept_p[o].z * by, hud_px * 1.5, 1.0, 0.85,
        0.4, a)
}

// A swipe across the car chooses another: how far the pointer must go.
const SWIPE: f32 = 40.0;

// The menu leaves the car the window. All there is to choose is in a dock
// along the window's foot: in a window wide enough, one strip (the
// courses, what a race is to be, and the buttons, side by side); in a
// narrow one, as a phone held upright, the same stacked. The car's card is
// small, at the top; and an arrow stands either side of the car itself.
//
// Whether the window is one for the stacked dock.
menu_tall(): bool {
    !(screen_w >= 680 && screen_w * 13 >= screen_h * 10)
}

// The size of a pixel of the writing (see hud_px), for a window w wide: by
// the window's shorter side, but no bigger than lets the strip fit across.
STRIP_LEAST: f32 = 329.0;

ui_unit(w: int): f32 {
    short: f32 = minf(w as f32, screen_h as f32);
    u: f32 = clampf(short / 175.0, 2.4, 3.2);
    if (!menu_tall()) u = minf(u, w as f32 / STRIP_LEAST);
    u
}

// How tall the dock is, and the car's card (where it takes room above the
// car: in the stacked window), in pixels of the writing.
const STRIP_HIGH: f32 = 39.0;

const STACK_HIGH: f32 = 96.0;

const CARD_HIGH: f32 = 40.0;

// Where the car is to be in the window, up and down: the middle of the
// room the menu leaves it.
menu_car_y(): f32 {
    u: f32 = hud_px;
    top: f32 = safe_t + 6.0 * u;
    foot: f32 = screen_h as f32 - safe_b - 6.0 * u - STRIP_HIGH * u;
    if (menu_tall()) {
        top = top + CARD_HIGH * u;
        foot = screen_h as f32 - safe_b - 6.0 * u - STACK_HIGH * u
    }
    (top + foot) * 0.5 + 4.0 * u
}

// How far up the picture is moved for that (see View's shift, in
// render.l8).
menu_shift(): f32 {
    1.0 - 2.0 * menu_car_y() / maxf(screen_h as f32, 1.0)
}

// The car's card: its name, and its four measures (see car_mark), each a
// bar; in so many columns. Its middle at cx, its top at y.
put_car_card(
    cx: f32,
    y: f32,
    cols: int,
    a: f32
) {
    u: f32 = hud_px;
    say(car_names[hud_kind]);
    put_words(cx, y, 1.6, INK_R, INK_G, INK_B, a);
    label: f32 = 38.0 * u;
    long: f32 = 26.0 * u;
    cell: f32 = label + long + 8.0 * u;
    x0: f32 = cx - (cols as f32 * cell - 8.0 * u) * 0.5;
    for k in 0..MARKS {
        x: f32 = x0 + (k % cols) as f32 * cell;
        ry: f32 = y + (15.0 + 10.0 * (k / cols) as f32) * u;
        say(mark_names[k]);
        put_words_at(x, ry, INK_R, INK_G, INK_B, 0.75 * a);
        bx: f32 = x + label;
        put_round(bx, ry + 1.5 * u, bx + long, ry + 5.5 * u, 2.0 * u, INK_R, INK_G,
            INK_B, 0.28 * a);
        put_round(bx, ry + 1.5 * u, bx + maxf(long * card_bars[k], 4.0 * u), ry + 5.5 * u,
            2.0 * u, 1.0, 0.86, 0.4, a)
    }
}

// What a race is to be, in a grid two across from (x, y), each cell so
// wide: how many laps; with nobody else here, how many computer drivers
// and how good; with others, who they are; and the player's name, to press
// to change (the page asks for another).
ui_setup(
    x: f32,
    y: f32,
    cell: f32,
    row_h: f32,
    a: f32
) {
    u: f32 = hud_px;
    gap: f32 = 3.0 * u;
    x2: f32 = x + cell + gap;
    y2: f32 = y + row_h + gap;
    by_laps: int = ui_stepper(T_LAPS, x, y, x + cell, y + row_h, set_laps > 1, set_laps < 9,
        ui_row == ROW_LAPS, a);
    text_len = 0;
    append_int(set_laps);
    if (set_laps == 1) append(" LAP") else append(" LAPS");
    put_words(value_x, value_y, 1.0, INK_R, INK_G, INK_B, a);
    if (by_laps != 0) row_step(ROW_LAPS, by_laps);
    // (Where the name goes: the last cell; or, with others here, the one
    // beside the laps, and who they are goes across under both.)
    nx: f32 = x2;
    ny: f32 = y2;
    if (ui_others == 0) {
        by_drivers: int = ui_stepper(T_DRIVERS, x2, y, x2 + cell, y + row_h, set_drivers > 1,
            set_drivers < MAX_BOTS, ui_row == ROW_DRIVERS, a);
        text_len = 0;
        append_int(set_drivers);
        if (set_drivers == 1) append(" DRIVER") else append(" DRIVERS");
        put_words(value_x, value_y, 1.0, INK_R, INK_G, INK_B, a);
        if (by_drivers != 0) row_step(ROW_DRIVERS, by_drivers);
        by_skill: int = ui_stepper(T_SKILL, x, y2, x + cell, y2 + row_h, true, true,
            ui_row == ROW_SKILL, a);
        say(skill_names[set_skill % SKILLS]);
        put_words(value_x, value_y, 1.0, INK_R, INK_G, INK_B, a);
        if (by_skill != 0) row_step(ROW_SKILL, by_skill)
    } else {
        ny = y;
        put_round(x, y2, x2 + cell, y2 + row_h, 6.0 * u, 0.2, 0.14, 0.09, 0.62 * a);
        say("WITH ");
        more: int = 0;
        some: bool = false;
        for k in 0..nracers {
            who: int = racer_who[k];
            if (who < NAME_ME) {
                if (text_len + name_len(who) + 2 <= 24) {
                    if (some) append(", ");
                    append_name(who, NAME_LONG);
                    some = true
                } else more = more + 1
            }
        }
        if (more > 0) {
            append(" +");
            append_int(more)
        }
        put_words(x + cell + gap * 0.5, y2 + row_h * 0.5 - 3.5 * u, 1.0, INK_R, INK_G,
            INK_B, a)
    }
    // The name: written as something to be written on, with a line under
    // it.
    if (ui_online) {
        if (ui_thing(T_NAME, nx, ny, nx + cell, ny + row_h)) ask(ACT_NAME, 0);
        glow: f32 = 0.1 * thing_down[T_NAME] + 0.05 * thing_over[T_NAME];
        put_round(nx, ny, nx + cell, ny + row_h, 6.0 * u, 0.2 + glow, 0.14 + glow,
            0.09 + glow, 0.4 * a);
        name_to_fit(NAME_ME, cell - 8.0 * u);
        nw: f32 = text_width();
        put_words(nx + cell * 0.5, ny + row_h * 0.5 - 4.0 * u, 1.0, INK_R, INK_G,
            INK_B, 0.9 * a);
        put_rect(nx + (cell - nw) * 0.5, ny + row_h * 0.5 + 4.5 * u, nx + (cell + nw) * 0.5,
            ny + row_h * 0.5 + 5.1 * u, INK_R, INK_G, INK_B, 0.5 * a);
        run_plain[nruns - 1] = true
    }
}

// The courses, a card each, across from x to x1, so tall; and under them
// the chosen one's name, and what its road is.
ui_courses(
    x: f32,
    y: f32,
    x1: f32,
    high: f32,
    a: f32
) {
    u: f32 = hud_px;
    gap: f32 = 3.0 * u;
    each: f32 = (x1 - x - 2.0 * gap) / COURSES as f32;
    for k in 0..COURSES {
        x0: f32 = x + k as f32 * (each + gap);
        id: int = T_COURSE + k;
        if (ui_thing(id, x0, y, x0 + each, y + high) && k != course) ask(ACT_COURSE,
            k);
        inset: f32 = thing_down[id] * u * 0.8;
        lift: f32 = 0.06 * thing_over[id];
        if (k == course) {
            put_round(x0 + inset, y + inset, x0 + each - inset, y + high - inset,
                5.0 * u, 0.52, 0.36, 0.15, 0.85 * a);
            put_ring(x0 + inset, y + inset, x0 + each - inset, y + high - inset, 5.0 * u,
                0.9 * u, 1.0, 0.85, 0.4, a)
        } else put_round(x0 + inset, y + inset, x0 + each - inset, y + high - inset,
            5.0 * u, 0.2 + lift, 0.14 + lift, 0.09 + lift, 0.62 * a);
        put_course(k, x0 + 5.0 * u, y + 4.0 * u, x0 + each - 5.0 * u, y + high - 4.0 * u,
            a)
    }
    if (ui_row == ROW_COURSE) put_focus(x, y, x1, y + high, a);
    // (Only its name, where both do not fit.)
    say(course_names[course]);
    name_w: f32 = text_width() * 0.9;
    road: int = course_grounds[course * 3];
    text_len = 0;
    if (road == PACK) append("SNOW") else if (road == DIRT) append("DIRT") else append("TARMAC");
    road_w: f32 = text_width() * 0.9;
    both: bool = name_w + road_w + 5.0 * u <= x1 - x;
    if (!both) road_w = -5.0 * u;
    tx: f32 = (x + x1) * 0.5 - (name_w + road_w + 5.0 * u) * 0.5;
    ty: f32 = y + high + 2.5 * u;
    if (both) put_words(tx + name_w + 5.0 * u + road_w * 0.5, ty, 0.9, INK_R, INK_G,
        INK_B, 0.7 * a);
    say(course_names[course]);
    put_words(tx + name_w * 0.5, ty, 0.9, 1.0, 0.85, 0.4, a)
}

ui_menu_scene(w: int) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    a: f32 = show_menu;
    tall: bool = menu_tall();
    away: f32 = (1.0 - a) * 30.0 * u;
    l: f32 = safe_l + 6.0 * u;
    r: f32 = wf - safe_r - 6.0 * u;
    t: f32 = safe_t + 6.0 * u;
    b: f32 = hf - safe_b - 6.0 * u + away;
    gap: f32 = 3.0 * u;
    row_h: f32 = 17.0 * u;
    if (tall) {
        // Stacked: the courses; what a race is to be; and the buttons,
        // side by side, lowest, in a thumb's reach.
        wide: f32 = minf(r - l, 176.0 * u);
        x: f32 = (wf - wide) * 0.5;
        y: f32 = b - STACK_HIGH * u;
        ui_courses(x, y, x + wide, 20.0 * u, a);
        y = y + 33.0 * u;
        ui_setup(x, y, (wide - gap) * 0.5, row_h, a);
        y = y + 2.0 * row_h + gap + 4.0 * u;
        split: f32 = x + wide * 0.6;
        if (ui_button_at(T_RACE, x, y, split - gap * 0.5, b, "RACE", true, ui_row == ROW_RACE,
            a)) ask(ACT_RACE, 0);
        if (ui_button_at(T_TRIAL, split + gap * 0.5, y, x + wide, b, "TIME TRIAL",
            false, ui_row == ROW_TRIAL, a)) ask(ACT_TRIAL, 0);
        put_car_card(wf * 0.5, t - away, 2, a)
    } else {
        // One strip: the courses at the left, what a race is to be in the
        // middle, and the buttons at the right.
        room: f32 = r - l;
        go_w: f32 = clampf(room * 0.2, 56.0 * u, 84.0 * u);
        cell: f32 = clampf((room - go_w - 96.0 * u - 13.0 * u) * 0.5, 76.0 * u, 88.0 * u);
        grid_w: f32 = 2.0 * cell + gap;
        cards_w: f32 = clampf(room - grid_w - go_w - 10.0 * u, 96.0 * u, 150.0 * u);
        x: f32 = (wf - (cards_w + grid_w + go_w + 10.0 * u)) * 0.5;
        y: f32 = b - STRIP_HIGH * u;
        ui_courses(x, y, x + cards_w, 27.0 * u, a);
        x = x + cards_w + 5.0 * u;
        ui_setup(x, y, cell, 18.0 * u, a);
        x = x + grid_w + 5.0 * u;
        if (ui_button_at(T_RACE, x, y, x + go_w, y + 21.0 * u, "RACE", true, ui_row == ROW_RACE,
            a)) ask(ACT_RACE, 0);
        if (ui_button_at(T_TRIAL, x, y + 24.0 * u, x + go_w, b, "TIME TRIAL", false,
            ui_row == ROW_TRIAL, a)) ask(ACT_TRIAL, 0);
        put_car_card(l + 32.0 * u, t - away, 1, a)
    }
    // An arrow either side of the car: the car before, and the next.
    cy: f32 = menu_car_y() - 4.0 * u;
    out: f32 = minf(wf * 0.5 - safe_l - 14.0 * u, 104.0 * u);
    if (tall) cy = cy + 6.0 * u;
    for end in 0..2 {
        way: f32 = -1.0;
        if (end == 1) way = 1.0;
        id: int = T_CAR_PREV + end;
        ax: f32 = wf * 0.5 + way * (out + (1.0 - a) * 20.0 * u);
        if (ui_thing(id, ax - 11.0 * u, cy - 20.0 * u, ax + 11.0 * u, cy + 20.0 * u)) ask(ACT_CAR,
            way as int);
        lift: f32 = 0.08 * thing_over[id] + 0.14 * thing_down[id];
        put_round(ax - 8.0 * u, cy - 8.0 * u, ax + 8.0 * u, cy + 8.0 * u, 8.0 * u,
            0.2 + lift, 0.14 + lift, 0.09 + lift, 0.5 * a);
        put_arrow(ax + way * thing_down[id] * u, cy, 3.4 * u, way, a);
        if (ui_row == ROW_CAR) put_focus(ax - 8.0 * u, cy - 8.0 * u, ax + 8.0 * u,
            cy + 8.0 * u, a)
    }
    // A swipe across the car, anywhere nothing else is, is another car.
    if (ui_live && ui_went_up && ui_hot < 0 && absf(ui_x - ui_down_x) > maxf(SWIPE,
        14.0 * u) && absf(ui_y - ui_down_y) < absf(ui_x - ui_down_x)) {
        if (ui_x < ui_down_x) ask(ACT_CAR, 1) else ask(ACT_CAR, -1)
    }
}

// ---- driving ----
// The list of who is ahead: a row each, which slides to its place when the
// order changes. Where each one's row is (by whose name it has), and how
// long since it was last in the list.
row_y: []f32 = new f32[NAMES](0.0);

row_age: []f32 = new f32[NAMES](100.0);

// A racer's row: its place (if it has one), a dot of its car's color (as
// on the map), its name, and (`times`) its time, if it has finished.
put_racer_row(
    k: int,
    place: int,
    x0: f32,
    y: f32,
    x1: f32,
    times: bool,
    a: f32
) {
    u: f32 = hud_px;
    who: int = racer_who[k];
    me: bool = who == NAME_ME;
    if (me) put_round(x0, y, x1, y + 10.0 * u, 3.5 * u, 1.0, 0.97, 0.92, 0.3 * a) else put_round(x0,
        y, x1, y + 10.0 * u, 3.5 * u, 0.16, 0.11, 0.07, 0.34 * a);
    x: f32 = x0 + 3.0 * u;
    if (place > 0) {
        text_len = 0;
        append_int(place);
        put_text_right(x + 11.0 * u, y + 1.5 * u, INK_R, INK_G, INK_B, a);
        x = x + 14.0 * u
    }
    c: int = racer_kind[k] % CARS * 3;
    put_dot(x + 3.0 * u, y + 5.0 * u, 2.6 * u, dot_rgb[c], dot_rgb[c + 1], dot_rgb[c + 2],
        a);
    room: f32 = x1 - 3.0 * u - (x + 8.0 * u);
    if (times) room = room - 40.0 * u;
    name_to_fit(who, room);
    if (racer_done[k] && !times) put_words_at(x + 8.0 * u, y + 1.5 * u, 1.0, 0.85,
        0.4, a) else put_words_at(x + 8.0 * u, y + 1.5 * u, INK_R, INK_G, INK_B, a);
    if (times && racer_done[k]) {
        text_len = 0;
        append_time(racer_time[k]);
        put_text_right(x1 - 3.0 * u, y + 1.5 * u, INK_R, INK_G, INK_B, 0.9 * a)
    }
}

// The thumbs' panels (see touch.l8): each an outline, lit while it is
// used; and the steering one's track, with a mark where the thumb is.
put_pads(w: int, a: f32) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    p: *Pointers = pointers;
    y0: f32 = PANEL_TOP * hf;
    y1: f32 = PANEL_BOTTOM * hf;
    steer: bool = p.stick >= 0;
    brake: bool = p.pedal >= 0 && p.y[maxf(p.pedal as f32, 0.0) as int] >= BRAKE_TOP * hf;
    veer: bool = p.pedal >= 0 && !brake;
    lit: f32 = 0.16;
    if (steer) lit = 0.38;
    put_round(STEER_LEFT * wf, y0, STEER_RIGHT * wf, y1, 7.0 * u, 0.29, 0.2, 0.13,
        lit * a);
    put_ring(STEER_LEFT * wf, y0, STEER_RIGHT * wf, y1, 7.0 * u, 0.7 * u, INK_R, INK_G,
        INK_B, 0.85 * a);
    say("STEER");
    put_words((STEER_LEFT + STEER_RIGHT) * 0.5 * wf, y0 + 5.0 * u, 1.0, INK_R, INK_G,
        INK_B, 0.8 * a);
    my: f32 = (y0 + y1) * 0.5 + 4.0 * u;
    tx0: f32 = lerpf(STEER_LEFT, STEER_RIGHT, 0.1) * wf;
    tx1: f32 = lerpf(STEER_LEFT, STEER_RIGHT, 0.9) * wf;
    put_rect(tx0, my - 0.6 * u, tx1, my + 0.6 * u, INK_R, INK_G, INK_B, 0.55 * a);
    run_plain[nruns - 1] = true;
    tx: f32 = steer_middle();
    if (steer) tx = clampf(p.x[maxf(p.stick as f32, 0.0) as int], tx0, tx1);
    high: f32 = 6.0 * u;
    if (steer) high = 9.0 * u;
    put_round(tx - 1.3 * u, my - high, tx + 1.3 * u, my + high, 1.3 * u, INK_R, INK_G,
        INK_B, a);
    // The veer button: gold while it is held.
    vx0: f32 = (1.0 - STEER_RIGHT) * wf;
    vx1: f32 = (1.0 - STEER_LEFT) * wf;
    if (veer) put_round(vx0, y0, vx1, y1, 7.0 * u, 1.0, 0.85, 0.4, 0.32 * a) else put_round(vx0,
        y0, vx1, y1, 7.0 * u, 0.29, 0.2, 0.13, 0.16 * a);
    put_ring(vx0, y0, vx1, y1, 7.0 * u, 0.7 * u, INK_R, INK_G, INK_B, 0.85 * a);
    say("VEER");
    put_words((vx0 + vx1) * 0.5, (y0 + y1) * 0.5 - 3.5 * u, 1.0, INK_R, INK_G, INK_B,
        0.8 * a);
    // The brake: small, and faint.
    bx0: f32 = BRAKE_LEFT * wf;
    bx1: f32 = BRAKE_RIGHT * wf;
    by0: f32 = BRAKE_TOP * hf;
    by1: f32 = BRAKE_BOTTOM * hf;
    if (brake) put_round(bx0, by0, bx1, by1, 5.0 * u, 0.84, 0.24, 0.17, 0.5 * a) else put_round(bx0,
        by0, bx1, by1, 5.0 * u, 0.29, 0.2, 0.13, 0.12 * a);
    put_ring(bx0, by0, bx1, by1, 5.0 * u, 0.5 * u, INK_R, INK_G, INK_B, 0.5 * a);
    say("BRAKE");
    put_words((bx0 + bx1) * 0.5, (by0 + by1) * 0.5 - 3.5 * u, 1.0, INK_R, INK_G, INK_B,
        0.6 * a)
}

// The pause's button: two bars, in the window's top left corner (the lap
// and its time are beside it: see build_hud).
const PAUSE_SIDE: f32 = 16.0;

ui_drive_scene(w: int) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    a: f32 = show_drive;
    px0: f32 = safe_l + 4.0 * u - (1.0 - a) * 24.0 * u;
    py0: f32 = safe_t + 4.0 * u;
    side: f32 = PAUSE_SIDE * u;
    // (A press anywhere in the corner is on it.)
    if (ui_thing(T_PAUSE, 0.0, 0.0, px0 + side + 5.0 * u, py0 + side + 6.0 * u)) {
        sheet_row = 0;
        ask(ACT_PAUSE, 0)
    }
    lift: f32 = 0.08 * thing_over[T_PAUSE] + 0.14 * thing_down[T_PAUSE];
    put_round(px0, py0, px0 + side, py0 + side, 5.0 * u, 0.2 + lift, 0.14 + lift,
        0.09 + lift, 0.62 * a);
    put_round(px0 + 5.0 * u, py0 + 4.5 * u, px0 + 7.2 * u, py0 + side - 4.5 * u, 0.8 * u,
        INK_R, INK_G, INK_B, 0.95 * a);
    put_round(px0 + side - 7.2 * u, py0 + 4.5 * u, px0 + side - 5.0 * u, py0 + side - 4.5 * u,
        0.8 * u, INK_R, INK_G, INK_B, 0.95 * a);
    if (ui_touch) put_pads(w, a * (1.0 - 0.8 * maxf(show_result, show_pause)));
    // The list of who is ahead: in a race; or, out of one, of who else is
    // here. Under the map, at the right: as many rows as there is room for
    // (above the thumbs' panels, if they are in the way), and if that is
    // not all of them, those about the player.
    racing: bool = race.on;
    if (nracers > 1 && show_result < 0.5) {
        long: f32 = 83.0 * u;
        if (!racing) long = 69.0 * u;
        x1: f32 = wf - safe_r - 8.0 + (1.0 - a) * 30.0 * u;
        top: f32 = hud_list * hf;
        foot: f32 = hf - safe_b - 14.0 * u;
        if (ui_touch && wf > hf) foot = PANEL_TOP * hf - 3.0 * u;
        room: int = ((foot - top) / (11.0 * u)) as int;
        // (In a narrow window it is over the road: no more than five.)
        if (wf < hf && room > 5) room = 5;
        if (room < 1) room = 1;
        from: int = 0;
        if (nracers > room) from = clampf((hud_place - 1 - room / 2) as f32, 0.0,
            (nracers - room) as f32) as int;
        for at in 0..nracers {
            k: int = racer_order[at];
            who: int = racer_who[k];
            to: f32 = top + (at - from) as f32 * 11.0 * u;
            // (One that has just come into the list is in its place at
            // once.)
            if (row_age[who] > 0.5) row_y[who] = to;
            row_age[who] = 0.0;
            row_y[who] = lerpf(row_y[who], to, ui_quick * 0.45);
            place: int = 0;
            if (racing) place = at + 1;
            if (at >= from && at < from + room) put_racer_row(k, place, x1 - long,
                row_y[who], x1, false, a)
        }
    }
    // For the keys, what they are: for a while after the start.
    if (!ui_touch && drive_time < 8.0) {
        say("LEFT AND RIGHT STEER   SPACE VEERS   DOWN BRAKES");
        if (text_width() > wf - 12.0 * u) say("ARROWS STEER   SPACE VEERS");
        put_words(wf * 0.5, hf - 12.0 * u, 1.0, INK_R, INK_G, INK_B, 0.85 * a * (1.0 - smoothstepf(6.5,
            8.0, drive_time)))
    }
}

// ---- the sheets ----
// The picture goes dim under a sheet, and the sheet comes up into the
// middle.
put_dim(w: int, a: f32) {
    put_rect(0.0, 0.0, w as f32, screen_h as f32, 0.05, 0.03, 0.02, 0.45 * a);
    run_plain[nruns - 1] = true
}

put_sheet(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    a: f32
) {
    u: f32 = hud_px;
    put_round(x0, y0, x1, y1, 9.0 * u, 0.16, 0.11, 0.07, 0.88 * a)
}

// The pause: go on, start over, or back to the menu.
ui_pause_sheet(w: int) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    a: f32 = show_pause;
    put_dim(w, a);
    sw: f32 = minf(126.0 * u, wf - 12.0 * u);
    sh: f32 = 94.0 * u;
    x0: f32 = (wf - sw) * 0.5;
    y0: f32 = (hf - sh) * 0.5 + (1.0 - a) * 14.0 * u;
    put_sheet(x0, y0, x0 + sw, y0 + sh, a);
    bx0: f32 = x0 + 8.0 * u;
    bx1: f32 = x0 + sw - 8.0 * u;
    y: f32 = y0 + 8.0 * u;
    if (ui_button_at(T_RESUME, bx0, y, bx1, y + 26.0 * u, "RESUME", true, sheet_row == 0,
        a)) ask(ACT_RESUME, 0);
    y = y + 31.0 * u;
    if (ui_button_at(T_RESTART, bx0, y, bx1, y + 21.0 * u, "RESTART", false, sheet_row == 1,
        a)) ask(ACT_AGAIN, 0);
    y = y + 26.0 * u;
    if (ui_button_at(T_LEAVE, bx0, y, bx1, y + 21.0 * u, "MENU", false, sheet_row == 2,
        a)) ask(ACT_MENU, 0)
}

// How a place is said: 1ST, 2ND, 3RD, 4TH.
append_place(place: int) {
    append_int(place);
    if (place % 10 == 1 && place % 100 != 11) append("ST") else if (place % 10 == 2 && place % 100 != 12) append("ND") else if (place % 10 == 3 && place % 100 != 13) append("RD") else append("TH")
}

// How a race came out: the player's place, large, and time; everyone, in
// order, with their times; and to race again, or go back to the menu.
ui_result_sheet(w: int) {
    u: f32 = hud_px;
    wf: f32 = w as f32;
    hf: f32 = screen_h as f32;
    a: f32 = show_result;
    put_dim(w, a * 0.6);
    // As many of the racers as there is room for: and the player always
    // (in the last row, if it would not be in one).
    most: int = ((hf - safe_t - safe_b - 84.0 * u) / (11.0 * u)) as int;
    if (most < 1) most = 1;
    rows: int = nracers;
    if (rows > most) rows = most;
    sw: f32 = minf(142.0 * u, wf - 8.0 * u);
    sh: f32 = 76.0 * u + rows as f32 * 11.0 * u;
    x0: f32 = (wf - sw) * 0.5;
    y0: f32 = (hf - sh) * 0.5 + (1.0 - a) * 14.0 * u;
    put_sheet(x0, y0, x0 + sw, y0 + sh, a);
    text_len = 0;
    append_place(hud_place);
    put_words(wf * 0.5, y0 + 8.0 * u, 2.0, 1.0, 0.85, 0.4, a);
    text_len = 0;
    append_time(race.done_time);
    put_words(wf * 0.5, y0 + 26.0 * u, 1.0, INK_R, INK_G, INK_B, 0.9 * a);
    y: f32 = y0 + 38.0 * u;
    for at in 0..rows {
        k: int = racer_order[at];
        place: int = at + 1;
        if (at == rows - 1 && hud_place > rows) {
            k = racer_order[hud_place - 1];
            place = hud_place
        }
        // (Each comes in a little after the one above it.)
        late: f32 = clampf(a * 1.6 - at as f32 * 0.06, 0.0, 1.0);
        put_racer_row(k, place, x0 + 6.0 * u, y, x0 + sw - 6.0 * u, true, late * a);
        y = y + 11.0 * u
    }
    y = y + 5.0 * u;
    mid: f32 = x0 + sw * 0.42;
    if (ui_button_at(T_DONE_MENU, x0 + 8.0 * u, y + 2.0 * u, mid - 2.0 * u, y + 24.0 * u,
        "MENU", false, sheet_row % 2 == 1, a)) ask(ACT_MENU, 0);
    if (ui_button_at(T_AGAIN, mid + 2.0 * u, y, x0 + sw - 8.0 * u, y + 26.0 * u, "AGAIN",
        true, sheet_row % 2 == 0, a)) ask(ACT_AGAIN, 0)
}

// ---- all of it ----
// The menus as they are now, into the picture's words and shapes (after
// what hud.l8 has put there); and what was pressed is asked of the game.
build_ui(w: int) {
    nzones = 0;
    sheet: bool = show_pause > 0.5 || show_result > 0.5;
    ui_modal = ui_menu || sheet;
    result: bool = !ui_menu && race.on && race.done && laps.since > 1.4;
    ui_live = ui_menu;
    if (show_menu > 0.02) ui_menu_scene(w);
    ui_live = !ui_menu && !ui_paused && !result;
    if (show_drive > 0.02) ui_drive_scene(w);
    ui_live = result && !ui_paused;
    if (show_result > 0.02) ui_result_sheet(w);
    ui_live = ui_paused;
    if (show_pause > 0.02) ui_pause_sheet(w);
    ui_live = true;
    // (And over it all, while the game comes up, the black.)
    if (ui_dark > 0.0) {
        put_rect(0.0, 0.0, w as f32, screen_h as f32, 0.0, 0.0, 0.0, smoothstepf(0.0,
            1.0, ui_dark));
        run_plain[nruns - 1] = true
    }
    if (ui_went_up) ui_hot = -1;
    ui_went_down = false;
    ui_went_up = false
}
