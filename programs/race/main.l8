tag race;

use_tag std;

use_tag gl, x11;

use_tag skate;

import "../../stdlib/print.l8";

// A car to race round a track on the floor of a canyon (see track.l8).
//
//   .build/race
//
// Left and right steer; up is the gas; down is the brake, and from a stop
// goes backward. On a phone the screen's left half steers and its right
// half is the pedals (see touch.l8). The road is fast; the grass beside it
// is slower, and the sand slower still. A lap is timed from the start line
// round to it again. R starts over; C changes the camera; Escape quits.
import "../gl/gl.l8";

import "../skate/math.l8";

import "mesh.l8";

import "track.l8";

import "world.l8";

import "car.l8";

import "pose.l8";

import "touch.l8";

import "hud.l8";

import "render.l8";

extern getenv(name: str): ?*i8;

extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int
}

mono_ns(): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    ts.sec * 1000000000 + ts.nsec
}

// Where the car starts: a little before the start line.
const START_S: f32 = -12.0;

// ---- the camera ----
// It follows behind and above the car, looking past it down the road, and
// turns after the car a little late; it stays inside the canyon's walls.
// Faster, it drops back and sees wider.
type Camera = {
    eye: V3;
    at: V3;
    up: V3;
    fovy: f32;
    // The way it looks across the ground, eased after the car's.
    way: V3
}

update_chase(
    cam: *Camera,
    c: *Car,
    p: V3,
    yaw: f32,
    high: bool,
    dt: f32
) {
    f: V3 = yaw_dir(yaw);
    speed: f32 = v_len(c.v);
    // Mostly the way the car points; sliding, a little the way it goes.
    want: V3 = f;
    if (speed > 4.0 && v_dot(c.v, f) > 0.0) want = v_norm(v_lerp(f, v_scale(c.v, 1.0 / speed),
        0.4));
    cam.way = yaw_dir(approach_angle(dir_yaw(cam.way), dir_yaw(want), ease(5.5, dt)));
    k: f32 = clampf(speed / 40.0, 0.0, 1.0);
    cam.at = v_madd(v_add(p, v3(0.0, 1.0, 0.0)), cam.way, 3.5 + 2.5 * k);
    eye: V3 = v_madd(v_add(p, v3(0.0, 2.9 + 0.3 * k, 0.0)), cam.way, -(6.4 + 1.8 * k));
    if (high) eye = v_madd(v_add(p, v3(0.0, 9.0, 0.0)), cam.way, -(13.0 + 2.0 * k));
    // Inside the walls, and above the ground.
    sp: Spot = locate(eye, c.spot.i, 30);
    room: f32 = spot_wall(sp) - 1.0;
    if (absf(sp.d) > room) {
        eye = v_madd(eye, right_of(way_at(sp.i, sp.f)), signf(sp.d) * (room - absf(sp.d)));
        sp.d = signf(sp.d) * room
    }
    eye.y = maxf(eye.y, spot_y(sp, eye.x, eye.z) + 1.3);
    cam.eye = eye;
    cam.up = v3(0.0, 1.0, 0.0);
    cam.fovy = 0.92 + 0.2 * k
}

// The views: from behind the car; from higher and farther behind it; and
// (L8_VIEW=2) down on the whole track, over the walls.
const VIEW_CHASE: int = 0;

const VIEW_HIGH: int = 1;

const VIEW_MAP: int = 2;

set_map_view(cam: *Camera) {
    lo: V3 = track_p[0];
    hi: V3 = track_p[0];
    for i in 0..track_n {
        lo = v3(minf(lo.x, track_p[i].x), 0.0, minf(lo.z, track_p[i].z));
        hi = v3(maxf(hi.x, track_p[i].x), 0.0, maxf(hi.z, track_p[i].z))
    }
    mid: V3 = v_scale(v_add(lo, hi), 0.5);
    cam.eye = v3(mid.x, 620.0, mid.z);
    cam.at = mid;
    cam.up = v3(0.0, 0.0, 1.0);
    cam.fovy = 0.62
}

// ---- keys ----
type Keys = {
    left: bool;
    right: bool;
    up: bool;
    down: bool
}

key_set(k: *Keys, ks: int, on: bool) {
    if (ks == 65361 || ks == 97) k.left = on;
    if (ks == 65363 || ks == 100) k.right = on;
    if (ks == 65362 || ks == 119) k.up = on;
    if (ks == 65364 || ks == 115) k.down = on
}

read_input(k: *Keys): Input {
    inp: Input = Input { steer: 0.0, gas: 0.0, brake: 0.0 };
    if (k.left) inp.steer = inp.steer - 1.0;
    if (k.right) inp.steer = inp.steer + 1.0;
    if (k.up) inp.gas = 1.0;
    if (k.down) inp.brake = 1.0;
    read_thumbs(&inp);
    inp
}

// In a tall window, as on a phone held upright, the picture moves up, so
// that he rides above the touch panels.
view_shift(): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    clampf((1.0 - aspect) * 0.8, 0.0, 0.45)
}

// The camera's vertical field of view: wide enough across that a tall
// window, as on a phone held upright, still sees to the sides.
view_fovy(base: f32): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    across: f32 = sinf(base * 0.5) / cosf(base * 0.5) * 1.6;
    maxf(base, 2.0 * atan2f(across, aspect))
}

// The numbers after `prefix` in the environment, parted by commas, into
// out: how many there were. (L8_CAM=ex,ey,ez,ax,ay,az,fovy, in degrees,
// is a camera to stand at; L8_START=s starts the car s metres round the
// lap.)
env_numbers(prefix: str, out: []f32): int {
    for e in l8_environment() {
        if (len(e) > len(prefix) && starts_with(e, prefix)) {
            k: int = 0;
            num: f32 = 0.0;
            sign: f32 = 1.0;
            frac: f32 = 0.0;
            for i in len(prefix)..len(e) + 1 {
                c: int = 44;
                if (i < len(e)) c = e[i] as int;
                if (c == 45) sign = -1.0 else if (c == 46) frac = 0.1 else if (c >= 48 && c <= 57) {
                    if (frac > 0.0) {
                        num = num + (c - 48) as f32 * frac;
                        frac = frac * 0.1
                    } else num = num * 10.0 + (c - 48) as f32
                } else if (k < len(out)) {
                    out[k] = sign * num;
                    k = k + 1;
                    num = 0.0;
                    sign = 1.0;
                    frac = 0.0
                }
            }
            return k
        }
    }
    0
}

starts_with(s: str, prefix: str): bool {
    for i in 0..len(prefix) {
        if (s[i] != prefix[i]) return false
    }
    true
}

extern l8_environment(): []str@new;

view_from_env(): int {
    v: ?*i8 = getenv("L8_VIEW");
    if (v == null) return VIEW_CHASE;
    p: *i8 = v;
    (p.* as int - 48) % 3
}

main() raises IoError: int {
    build_track();
    world: *Mesh = new_mesh(520000);
    build_world(world);
    parts: *Mesh = new_mesh(60000);
    build_parts(parts);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    screen_w = 1280;
    screen_h = 720;
    win: int = XCreateWindow(dpy, root, 0, 0, screen_w, screen_h, 0, vis.depth as int,
        1, vis.visual, 10248, &wa);
    if (win == 0) die("XCreateWindow failed");
    XStoreName(dpy, win, "L8 Race");
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    eprint("L8 Race: left/right steer, up is the gas, down the brake (and backward); R starts over, C changes the camera, Escape quits");
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    r: *Renderer = new_renderer(world, parts);
    env: []f32 = new f32[8](0.0);
    start: f32 = START_S;
    if (env_numbers("L8_START=", env) > 0) start = env[0];
    c: *Car = new_car(start);
    cam: *Camera = new Camera {
        eye: c.p,
        at: c.p,
        up: v3(0.0, 1.0, 0.0),
        fovy: 0.92,
        way: yaw_dir(c.yaw)
    };
    view: int = view_from_env();
    fixed: bool = env_numbers("L8_CAM=", env) >= 7;
    // (L8_AUTO: it drives itself round, to watch. See auto_input.)
    auto: bool = getenv("L8_AUTO") != null;
    keys: Keys = Keys {
        left: false,
        right: false,
        up: false,
        down: false
    };
    shadows: bool = getenv("L8_NO_SHADOWS") == null;
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = mono_ns();
    start_ns: int = prev_ns;
    acc: f32 = 0.0;
    paused: bool = false;
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65307) running = false;
                    if (ks == 65299) paused = true;
                    if (ks == 114) {
                        place_car(c, START_S);
                        reset_laps()
                    }
                    if (ks == 99) view = (view + 1) % 2;
                    key_set(&keys, ks, true)
                }
                KeyRelease -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65299) paused = false;
                    key_set(&keys, ks, false)
                }
                ButtonPress b -> pointer_down(b.button as int, b.x as f32, b.y as f32);
                ButtonRelease b -> pointer_up(b.button as int);
                MotionNotify mo -> pointer_move(mo.state as int, mo.x as f32, mo.y as f32);
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        screen_w = c.width as int;
                        screen_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        if (running) {
            now: int = mono_ns();
            dns: int = now - prev_ns;
            prev_ns = now;
            if (dns < 0) dns = 0;
            if (dns > 100000000) dns = 100000000;
            if (paused) dns = 0;
            dt: f32 = dns as f32 / 1000000000.0;
            acc = acc + dt;
            steps: int = 0;
            inp: Input = read_input(&keys);
            if (auto) inp = auto_input(c);
            while (acc >= STEP_DT && steps < 12) {
                step_car(c, inp, STEP_DT);
                tick_laps(c, STEP_DT);
                acc = acc - STEP_DT;
                steps = steps + 1
            }
            if (acc > STEP_DT) acc = 0.0;
            alpha: f32 = acc / STEP_DT;
            pose_car(c, alpha);
            pos: V3 = car_point(c, alpha);
            yaw: f32 = car_yaw(c, alpha);
            if (fixed) {
                cam.eye = v3(env[0], env[1], env[2]);
                cam.at = v3(env[3], env[4], env[5]);
                cam.up = v3(0.0, 1.0, 0.0);
                cam.fovy = env[6] * PI / 180.0
            } else if (view == VIEW_MAP) set_map_view(cam) else update_chase(cam,
                c, pos, yaw, view == VIEW_HIGH, dt);
            hud_speed = v_len(c.v);
            v: View = View {
                eye: cam.eye,
                at: cam.at,
                up: cam.up,
                fovy: view_fovy(cam.fovy),
                shift: 0.0,
                focus: v_madd(pos, cam.way, 26.0),
                car: pos,
                car_way: yaw_dir(yaw),
                time: (now - start_ns) as f32 / 1000000000.0,
                fade_from: 16.0,
                fade_to: 85.0,
                near: c.spot.i
            };
            if (fixed) {
                v.fovy = cam.fovy;
                v.near = -1
            } else if (view == VIEW_MAP) {
                v.near = -1;
                v.fovy = cam.fovy;
                v.focus = cam.at;
                v.fade_from = 1.0;
                v.fade_to = 5.0
            } else v.shift = view_shift();
            draw_scene(r, v, shadows);
            if (getenv("L8_NO_HUD") == null) draw_hud(r);
            glXSwapBuffers(dpy, win)
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}
