tag race;

use_tag std;

use_tag gl, x11;

use_tag skate;

import "../../stdlib/print.l8";

// A car to race round a track on the floor of a canyon (see track.l8).
//
//   .build/race
//
// Left and right steer, and the car goes by itself (once it has been
// touched); down is the brake, and from a stop goes backward. Space is the
// veer button: held, at speed, with the wheel over, the car drifts, until
// it is let go. On a phone the screen's left half steers and its right half
// is the veer button, with the brake small under it (see touch.l8). The
// road is fast; the grass beside it is slower, and the sand slower still.
// A lap is timed from the start line round to it again. There are four cars
// (see cars.l8): 1 to 4 choose one, and Tab the next. R starts over; C
// changes the camera; Escape quits.
import "../gl/gl.l8";

import "../skate/math.l8";

import "cars.l8";

import "mesh.l8";

import "track.l8";

import "world.l8";

import "car.l8";

import "pose.l8";

import "marks.l8";

import "net.l8";

import "ghost.l8";

import "touch.l8";

import "hud.l8";

import "render.l8";

extern getenv(name: str): ?*i8;

extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int
}

mono_ns(): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    ts.sec * 1000000000 + ts.nsec
}

// Where the car starts: a little before the start line.
const START_S: f32 = -12.0;

// ---- the camera ----
// It follows behind and above the car, looking past it down the road, and
// turns after the car a little late; it stays inside the canyon's walls.
// Faster, it drops back and sees wider.
//
// When the car is put somewhere else (back at the start: see Change), the
// camera does not jump there: it flies, from where it was to where it
// follows from now. If that is far, it goes up and over, and the canyon's
// walls melt out of its way while it does.
type Camera = {
    // Where it follows the car from, and what it looks at.
    eye: V3;
    at: V3;
    up: V3;
    fovy: f32;
    // The way it looks across the ground, eased after the car's.
    way: V3;
    // How much a push has it dropped back and seeing wider, from 0 to 1.
    kick: f32;
    // Where the picture is taken from, and of: the same, but while it
    // flies.
    seen_eye: V3;
    seen_at: V3;
    // A flight: where it began, how much of it is done (1: all, or there
    // is none), how long it takes, and how high it goes on the way (0: not
    // far enough to leave the canyon).
    from_eye: V3;
    from_at: V3;
    fly: f32;
    fly_time: f32;
    lift: f32
}

// The car has been put somewhere else: fly to behind it there.
start_flight(cam: *Camera, c: *Car, high: bool) {
    cam.from_eye = cam.seen_eye;
    cam.from_at = cam.seen_at;
    cam.way = yaw_dir(c.yaw);
    update_chase(cam, c, car_point(c, 1.0), c.yaw, high, 0.0);
    far: f32 = v_len(v_sub(cam.eye, cam.from_eye));
    cam.fly = 0.0;
    cam.fly_time = clampf(0.4 + far / 260.0, 0.4, 1.6);
    cam.lift = 0.0;
    if (far > 30.0) cam.lift = minf(far * 0.3, 70.0)
}

// Carry a flight on by dt, and work out where the picture is taken from.
fly_camera(cam: *Camera, dt: f32) {
    cam.seen_eye = cam.eye;
    cam.seen_at = cam.at;
    if (cam.fly >= 1.0) return;
    cam.fly = minf(cam.fly + dt / cam.fly_time, 1.0);
    k: f32 = smoothstepf(0.0, 1.0, cam.fly);
    cam.seen_eye = v_lerp(cam.from_eye, cam.eye, k);
    cam.seen_eye.y = cam.seen_eye.y + cam.lift * sinf(PI * cam.fly);
    cam.seen_at = v_lerp(cam.from_at, cam.at, k)
}

// How much the walls have melted out of a flight's way, from 0 to 1.
flight_melt(cam: *Camera): f32 {
    if (cam.fly >= 1.0 || cam.lift == 0.0) return 0.0;
    clampf(sinf(PI * cam.fly) * 4.0, 0.0, 1.0)
}

// ---- changing cars, and starting over ----
// Neither is sudden. The car turns into the car asked for: its wheels grow
// or shrink, its body changes its shape, its colors turn, until it is the
// other (see pose.l8). As it does, it is carried from where it was to the
// start: lifted, if that is far, up over the canyon's walls with the
// camera, and set down. It cannot be driven till it is down, and nearly
// the car it is to be.
const MORPH_TIME: f32 = 0.45;

// How high the car is carried, of how high the camera flies.
const CARRY_LIFT: f32 = 0.72;

type Change = {
    // The car asked for, or -1 if none is. (Asked for while the car is
    // still turning into another, it waits, and the turning hurries.)
    to: int;
    // The car it was; how far it has turned into the car it is, from 0 to
    // 1 (1: it is done, or there is none); and where it was shown, and
    // the way it pointed, when it was taken up.
    from: int;
    turn: f32;
    from_p: V3;
    from_yaw: f32;
    // Where the car is to be put: how far along the lap from the start
    // line, and how far out from the road's middle. (Before the line: or,
    // for a race, on the grid.)
    at_s: f32;
    at_d: f32
}

// Whether the car can be driven.
change_done(g: *Change, cam: *Camera): bool {
    g.turn > 0.6 && cam.fly > 0.8
}

update_chase(
    cam: *Camera,
    c: *Car,
    p: V3,
    yaw: f32,
    high: bool,
    dt: f32
) {
    f: V3 = yaw_dir(yaw);
    speed: f32 = v_len(c.v);
    // The way the car points; sliding, more the way it goes (so that a
    // drifting car is seen askew).
    want: V3 = f;
    if (speed > 4.0 && v_dot(c.v, f) > 0.0) want = v_norm(v_lerp(f, v_scale(c.v, 1.0 / speed),
        0.7));
    cam.way = yaw_dir(approach_angle(dir_yaw(cam.way), dir_yaw(want), ease(5.5, dt)));
    k: f32 = clampf(speed / 30.0, 0.0, 1.0);
    // (A push throws it back a little, and it sees wider.)
    pushed: f32 = 0.0;
    if (c.push > 0.0) pushed = 1.0;
    cam.kick = lerpf(cam.kick, pushed, ease(5.0, dt));
    k = k + 0.6 * cam.kick;
    cam.at = v_madd(v_add(p, v3(0.0, 1.0, 0.0)), cam.way, 3.5 + 2.5 * k);
    // (Nearer a short car, farther from a long one.)
    size: f32 = 0.5 + 0.5 * car_axle[c.kind] / car_axle[BUGGY];
    eye: V3 = v_madd(v_add(p, v3(0.0, (2.9 + 0.3 * k) * size, 0.0)), cam.way, -(6.4 + 1.8 * k) * size);
    if (high) eye = v_madd(v_add(p, v3(0.0, 9.0, 0.0)), cam.way, -(13.0 + 2.0 * k));
    // Inside the walls, and above the ground.
    sp: Spot = locate(eye, c.spot.i, 30);
    room: f32 = spot_wall(sp) - 1.0;
    if (absf(sp.d) > room) {
        eye = v_madd(eye, right_of(way_at(sp.i, sp.f)), signf(sp.d) * (room - absf(sp.d)));
        sp.d = signf(sp.d) * room
    }
    eye.y = maxf(eye.y, spot_y(sp, eye.x, eye.z) + 1.3);
    cam.eye = eye;
    cam.up = v3(0.0, 1.0, 0.0);
    cam.fovy = 0.92 + 0.2 * k
}

// The views: from behind the car; from higher and farther behind it; and
// (L8_VIEW=2) down on the whole track, over the walls.
const VIEW_CHASE: int = 0;

const VIEW_HIGH: int = 1;

const VIEW_MAP: int = 2;

set_map_view(cam: *Camera) {
    lo: V3 = track_p[0];
    hi: V3 = track_p[0];
    for i in 0..track_n {
        lo = v3(minf(lo.x, track_p[i].x), 0.0, minf(lo.z, track_p[i].z));
        hi = v3(maxf(hi.x, track_p[i].x), 0.0, maxf(hi.z, track_p[i].z))
    }
    mid: V3 = v_scale(v_add(lo, hi), 0.5);
    cam.eye = v3(mid.x, 620.0, mid.z);
    cam.at = mid;
    cam.up = v3(0.0, 0.0, 1.0);
    cam.fovy = 0.62
}

// ---- keys ----
type Keys = {
    left: bool;
    right: bool;
    up: bool;
    down: bool;
    space: bool
}

key_set(k: *Keys, ks: int, on: bool) {
    if (ks == 65361 || ks == 97) k.left = on;
    if (ks == 65363 || ks == 100) k.right = on;
    if (ks == 65362 || ks == 119) k.up = on;
    if (ks == 65364 || ks == 115) k.down = on;
    if (ks == 32) k.space = on
}

// What the driver asks now. There is no gas to hold: once the driver has
// touched anything (`going`), the car goes by itself, but while the brake
// is on.
read_input(k: *Keys, going: bool): Input {
    inp: Input = Input {
        steer: 0.0,
        gas: 0.0,
        brake: 0.0,
        tidy: false,
        veer: k.space
    };
    if (k.left) inp.steer = inp.steer - 1.0;
    if (k.right) inp.steer = inp.steer + 1.0;
    if (k.down) inp.brake = 1.0;
    read_thumbs(&inp);
    if (going && inp.brake == 0.0) inp.gas = 1.0;
    inp
}

// Whether a key is one the car is driven by.
driving_key(ks: int): bool {
    ks == 32 || ks >= 65361 && ks <= 65364 || ks == 97 || ks == 100 || ks == 115 || ks == 119
}

// In a tall window, as on a phone held upright, the picture moves up, so
// that he rides above the touch panels.
view_shift(): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    clampf((1.0 - aspect) * 0.8, 0.0, 0.45)
}

// The camera's vertical field of view: wide enough across that a tall
// window, as on a phone held upright, still sees to the sides.
view_fovy(base: f32): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    across: f32 = sinf(base * 0.5) / cosf(base * 0.5) * 1.6;
    maxf(base, 2.0 * atan2f(across, aspect))
}

// The numbers after `prefix` in the environment, parted by commas, into
// out: how many there were. (L8_CAM=ex,ey,ez,ax,ay,az,fovy, in degrees,
// is a camera to stand at; L8_START=s starts the car s metres round the
// lap; L8_CAR=k starts in car k.)
env_numbers(prefix: str, out: []f32): int {
    for e in l8_environment() {
        if (len(e) > len(prefix) && starts_with(e, prefix)) {
            k: int = 0;
            num: f32 = 0.0;
            sign: f32 = 1.0;
            frac: f32 = 0.0;
            for i in len(prefix)..len(e) + 1 {
                c: int = 44;
                if (i < len(e)) c = e[i] as int;
                if (c == 45) sign = -1.0 else if (c == 46) frac = 0.1 else if (c >= 48 && c <= 57) {
                    if (frac > 0.0) {
                        num = num + (c - 48) as f32 * frac;
                        frac = frac * 0.1
                    } else num = num * 10.0 + (c - 48) as f32
                } else if (k < len(out)) {
                    out[k] = sign * num;
                    k = k + 1;
                    num = 0.0;
                    sign = 1.0;
                    frac = 0.0
                }
            }
            return k
        }
    }
    0
}

starts_with(s: str, prefix: str): bool {
    for i in 0..len(prefix) {
        if (s[i] != prefix[i]) return false
    }
    true
}

extern l8_environment(): []str@new;

view_from_env(): int {
    v: ?*i8 = getenv("L8_VIEW");
    if (v == null) return VIEW_CHASE;
    p: *i8 = v;
    (p.* as int - 48) % 3
}

main() raises IoError: int {
    build_track();
    world: *Mesh = new_mesh(520000);
    build_world(world);
    parts: *Mesh = new_mesh(120000);
    build_parts(parts);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    screen_w = 1280;
    screen_h = 720;
    win: int = XCreateWindow(dpy, root, 0, 0, screen_w, screen_h, 0, vis.depth as int,
        1, vis.visual, 10248, &wa);
    if (win == 0) die("XCreateWindow failed");
    XStoreName(dpy, win, "L8 Race");
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    eprint("L8 Race: left/right steer, and it goes by itself; down is the brake (and backward); hold Space to veer into a drift; 1-4 or Tab choose a car, R starts over, C changes the camera, Escape quits");
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    r: *Renderer = new_renderer(world, parts);
    env: []f32 = new f32[8](0.0);
    kind: int = BUGGY;
    if (env_numbers("L8_CAR=", env) > 0) kind = (env[0] as int % CARS + CARS) % CARS;
    start: f32 = START_S;
    if (env_numbers("L8_START=", env) > 0) start = env[0];
    c: *Car = new_car(kind, start);
    cam: *Camera = new Camera {
        eye: c.p,
        at: c.p,
        up: v3(0.0, 1.0, 0.0),
        fovy: 0.92,
        way: yaw_dir(c.yaw),
        kick: 0.0,
        seen_eye: c.p,
        seen_at: c.p,
        from_eye: c.p,
        from_at: c.p,
        fly: 1.0,
        fly_time: 1.0,
        lift: 0.0
    };
    change: *Change = new Change {
        to: -1,
        from: kind,
        turn: 1.0,
        from_p: c.p,
        from_yaw: c.yaw,
        at_s: START_S,
        at_d: 0.0
    };
    // Where the car is shown, and the way it points: where it is, but
    // while it is carried.
    shown: V3 = c.p;
    shown_yaw: f32 = c.yaw;
    view: int = view_from_env();
    fixed: bool = env_numbers("L8_CAM=", env) >= 7;
    // (L8_AUTO: it drives itself round, to watch. See auto_input.)
    auto: bool = getenv("L8_AUTO") != null;
    // (L8_NET: there is a page to tell where the car is, for the others.)
    online: bool = getenv("L8_NET") != null;
    others: []*Other = new_others();
    ghosts: []*Car = new_ghosts();
    keys: Keys = Keys {
        left: false,
        right: false,
        up: false,
        down: false,
        space: false
    };
    shadows: bool = getenv("L8_NO_SHADOWS") == null;
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = mono_ns();
    start_ns: int = prev_ns;
    acc: f32 = 0.0;
    paused: bool = false;
    tab: bool = false;
    // Whether the driver has touched anything since the car was put where
    // it is: it waits there till then, and then it goes (see read_input).
    going: bool = false;
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    // (Word of another car, from the page: no key.)
                    if (ghost_key(ks) || net_key(others, ks)) ks = 0;
                    if (ks == 65307) running = false;
                    if (ks == 65299) paused = true;
                    // (1 to 4 choose a car, Tab the next one: it starts
                    // over.)
                    now_kind: int = c.kind;
                    if (change.to >= 0) now_kind = change.to;
                    pick: int = now_kind;
                    if (ks >= 49 && ks < 49 + CARS) pick = ks - 49;
                    // (Held, Tab is the next car once, not over and over.)
                    if (ks == 65289 && !tab) pick = (now_kind + 1) % CARS;
                    if (ks == 65289) tab = true;
                    if (ks == 114 || pick != now_kind) {
                        change.to = pick;
                        change.at_s = START_S;
                        change.at_d = 0.0
                    }
                    if (ks == 99) view = (view + 1) % 2;
                    if (driving_key(ks)) going = true;
                    key_set(&keys, ks, true)
                }
                KeyRelease -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65299) paused = false;
                    if (ks == 65289) tab = false;
                    key_set(&keys, ks, false)
                }
                ButtonPress b -> {
                    going = true;
                    pointer_down(b.button as int, b.x as f32, b.y as f32)
                }
                ButtonRelease b -> pointer_up(b.button as int);
                MotionNotify mo -> pointer_move(mo.state as int, mo.x as f32, mo.y as f32);
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        screen_w = c.width as int;
                        screen_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        if (running) {
            now: int = mono_ns();
            dns: int = now - prev_ns;
            prev_ns = now;
            if (dns < 0) dns = 0;
            if (dns > 100000000) dns = 100000000;
            if (paused) dns = 0;
            dt: f32 = dns as f32 / 1000000000.0;
            acc = acc + dt;
            steps: int = 0;
            high: bool = view == VIEW_HIGH;
            // A race is called: the car goes to its place on the grid.
            if (net_race) {
                net_race = false;
                call_race(net_race_wait, net_race_laps);
                change.to = c.kind;
                change.at_s = grid_s(net_race_place);
                change.at_d = grid_d(net_race_place)
            }
            if (change.to >= 0 && change.turn >= 1.0) {
                // It is taken up from where it is shown; and it is at the
                // start, the car asked for.
                change.from = c.kind;
                change.turn = 0.0;
                change.from_p = shown;
                change.from_yaw = shown_yaw;
                c.kind = change.to;
                change.to = -1;
                place_car_at(c, change.at_s, change.at_d);
                reset_laps();
                break_marks();
                drop_lap();
                going = false;
                start_flight(cam, c, high)
            }
            hurry: f32 = 1.0;
            if (change.to >= 0) hurry = 3.0;
            change.turn = minf(change.turn + hurry * dt / MORPH_TIME, 1.0);
            // (After the count, a race is under way, touched or not.)
            if (race.on && !race_waits() && !race.done) going = true;
            inp: Input = read_input(&keys, going);
            if (auto) inp = auto_input(c);
            // (It cannot be driven while it is changing, or waiting on the
            // grid.)
            if (!change_done(change, cam) || race_waits()) inp = Input {
                steer: 0.0,
                gas: 0.0,
                brake: 0.0,
                tidy: true,
                veer: false
            };
            while (acc >= STEP_DT && steps < 12) {
                step_car(c, inp, STEP_DT);
                // (While it is carried to the start, it runs into nobody.)
                if (change_done(change, cam)) hit_others(others, c);
                crossed: int = laps.crossed;
                tick_laps(c, STEP_DT);
                // (The lap is kept as it is driven, for a ghost: see
                // ghost.l8.)
                if (laps.crossed != crossed) keep_lap(c, crossed > 0 && laps.was_best);
                keep_step(c);
                tick_race(c, STEP_DT);
                acc = acc - STEP_DT;
                steps = steps + 1
            }
            if (acc > STEP_DT) acc = 0.0;
            tick_marks(c);
            alpha: f32 = acc / STEP_DT;
            pos: V3 = car_point(c, alpha);
            yaw: f32 = car_yaw(c, alpha);
            if (fixed) {
                cam.eye = v3(env[0], env[1], env[2]);
                cam.at = v3(env[3], env[4], env[5]);
                cam.up = v3(0.0, 1.0, 0.0);
                cam.fovy = env[6] * PI / 180.0
            } else if (view == VIEW_MAP) set_map_view(cam) else update_chase(cam,
                c, pos, yaw, high, dt);
            // (A flight is only from behind a car to behind a car.)
            if (fixed || view == VIEW_MAP) cam.fly = 1.0;
            fly_camera(cam, dt);
            melt: f32 = flight_melt(cam);
            // The car goes with the camera: from where it was taken up to
            // where it is, not quite as high (the camera looks down on it),
            // and level while it is off the ground.
            shown = pos;
            shown_yaw = yaw;
            held: f32 = 0.0;
            if (cam.fly < 1.0) {
                k: f32 = smoothstepf(0.0, 1.0, cam.fly);
                shown = v_lerp(change.from_p, pos, k);
                shown.y = shown.y + CARRY_LIFT * cam.lift * sinf(PI * cam.fly);
                shown_yaw = change.from_yaw + wrap_angle(yaw - change.from_yaw) * k;
                held = smoothstepf(0.0, 0.15, cam.fly) * (1.0 - smoothstepf(0.8, 1.0,
                    cam.fly))
            }
            pose_none();
            pose_kind(change.from, c.kind, smoothstepf(0.0, 1.0, change.turn));
            if (change.turn >= 1.0) pose_kind(c.kind, c.kind, 0.0);
            pose_car(c, shown, shown_yaw, held);
            blob_size: f32 = 0.55 + 0.45 * pose_shape(car_axle) / car_axle[BUGGY];
            // The others on the track; and word of where this car is, for
            // them.
            tick_others(others, dt);
            pose_others(others, shown);
            tick_ghosts(ghosts, laps.time + acc, dt);
            pose_ghosts(ghosts);
            if (online) {
                say_place(c, (now - start_ns) as f32 / 1000000000.0, dt);
                say_finish();
                say_ghost()
            }
            hud_speed = v_len(c.v);
            hud_kind = c.kind;
            hud_card = cam.fly >= 1.0 || cam.lift == 0.0;
            tick_card(dt);
            v: View = View {
                eye: cam.seen_eye,
                at: cam.seen_at,
                up: cam.up,
                fovy: view_fovy(cam.fovy),
                shift: 0.0,
                focus: v_madd(pos, cam.way, 26.0),
                car: shown,
                car_way: v_scale(yaw_dir(shown_yaw), 1.0 / blob_size),
                time: (now - start_ns) as f32 / 1000000000.0,
                fade_from: lerpf(16.0, 1.0, melt),
                fade_to: lerpf(85.0, 5.0, melt),
                near: c.spot.i
            };
            // (The car's way is made longer for a small car: the dark under
            // it is as small as the car is. And over the walls, all of the
            // track may show, and what is looked at is not near the car.)
            if (cam.fly < 1.0 && cam.lift > 0.0) {
                v.near = -1;
                v.focus = cam.seen_at
            }
            if (fixed) {
                v.fovy = cam.fovy;
                v.near = -1
            } else if (view == VIEW_MAP) {
                v.near = -1;
                v.fovy = cam.fovy;
                v.focus = cam.at;
                v.fade_from = 1.0;
                v.fade_to = 5.0
            } else v.shift = view_shift();
            draw_scene(r, v, shadows);
            if (getenv("L8_NO_HUD") == null) draw_hud(r);
            glXSwapBuffers(dpy, win)
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}
