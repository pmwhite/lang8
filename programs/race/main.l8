tag race;

use_tag std;

use_tag gl, x11;

use_tag skate;

import "../../stdlib/print.l8";

// A car to race round a track on the floor of a canyon (see track.l8).
//
//   .build/race
//
// Left and right steer, and the car goes by itself (once it has been
// touched); down is the brake, and from a stop goes backward. Space is the
// veer button: held, at speed, the car drifts, to whichever side the wheel
// is over, until it is let go. On a phone the screen's left half steers and
// its right half is the veer button, with the brake small under it (see
// touch.l8). The road is fast; the grass beside it is slower, and the sand
// slower still. A lap is timed from the start line round to it again.
//
// The game has its own menus (see ui.l8): which car, which course, and
// whether to drive alone against the clock and one's own ghosts, or to
// race: against whoever else is on the track, or, with nobody else there,
// against computer drivers (see bots.l8). A page it is on (see
// web/race/race.js) carries word to and from the others, and keeps what
// is to be kept. With the menu up, the arrows (or W, A, S, D) go about it
// and Enter is RACE; 1 to 4 choose a car, and Tab the next. Driving,
// Escape is the pause, R starts over (not in a race), and C changes the
// camera.
import "../gl/gl.l8";

import "../skate/math.l8";

import "cars.l8";

import "mesh.l8";

import "track.l8";

import "world.l8";

import "car.l8";

import "pose.l8";

import "marks.l8";

import "racers.l8";

import "net.l8";

import "bots.l8";

import "fx.l8";

import "ghost.l8";

import "touch.l8";

import "font.l8";

import "hud.l8";

import "ui.l8";

import "render.l8";

extern getenv(name: str): ?*i8;

extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int
}

mono_ns(): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    ts.sec * 1000000000 + ts.nsec
}

// ---- the camera ----
// It follows behind and above the car, looking past it down the road, and
// turns after the car a little late; it stays inside the canyon's walls.
// Faster, it drops back and sees wider.
//
// When the car is put somewhere else (back at the start: see Change), the
// camera does not jump there: it flies, from where it was to where it
// follows from now. If that is far, it goes up and over, and the canyon's
// walls melt out of its way while it does. It goes round the car, as the
// car is carried (see Change): from as far out as it was, and the way it
// was from the car, to as far and the way it is to be, by the shorter way
// round. (Not straight there: from the menu's camera, in front of the car,
// that would take it over the roof, close enough to fill the picture.)
type Camera = {
    // Where it follows the car from, and what it looks at.
    eye: V3;
    at: V3;
    up: V3;
    fovy: f32;
    // The way it looks across the ground, eased after the car's.
    way: V3;
    // How much a push has it dropped back and seeing wider, from 0 to 1.
    kick: f32;
    // Where the picture is taken from, and of: the same, but while it
    // flies.
    seen_eye: V3;
    seen_at: V3;
    // A flight: where it began, and where the car was then; how much of it
    // is done (1: all, or there is none), how long it takes, and how high
    // it goes on the way (0: not far enough to leave the canyon).
    from_eye: V3;
    from_at: V3;
    from_car: V3;
    fly: f32;
    fly_time: f32;
    lift: f32
}

// The car has been put somewhere else, from where it was shown at `was`:
// fly to behind it there. (Never quicker than FLY_LEAST, even if it is
// near: the camera may have far to go round the car.)
const FLY_LEAST: f32 = 0.9;

start_flight(
    cam: *Camera,
    c: *Car,
    was: V3,
    high: bool
) {
    cam.from_eye = cam.seen_eye;
    cam.from_at = cam.seen_at;
    cam.from_car = was;
    cam.way = yaw_dir(c.yaw);
    update_chase(cam, c, car_point(c, 1.0), c.yaw, high, 0.0);
    far: f32 = v_len(v_sub(cam.eye, cam.from_eye));
    cam.fly = 0.0;
    cam.fly_time = clampf(0.4 + far / 260.0, FLY_LEAST, 1.6);
    cam.lift = 0.0;
    if (far > 30.0) cam.lift = minf(far * 0.3, 70.0)
}

// Carry a flight on by dt, the car being at `car` now, and work out where
// the picture is taken from.
fly_camera(cam: *Camera, car: V3, dt: f32) {
    cam.seen_eye = cam.eye;
    cam.seen_at = cam.at;
    if (cam.fly >= 1.0) return;
    cam.fly = minf(cam.fly + dt / cam.fly_time, 1.0);
    k: f32 = smoothstepf(0.0, 1.0, cam.fly);
    // Where the car is shown, on its way (see Change); and the camera, from
    // it, then and to be: the way round it, how far out, and how high.
    mid: V3 = v_lerp(cam.from_car, car, k);
    was: V3 = v_sub(cam.from_eye, cam.from_car);
    to: V3 = v_sub(cam.eye, car);
    was_way: f32 = atan2f(was.x, was.z);
    to_way: f32 = atan2f(to.x, to.z);
    way: f32 = was_way + wrap_angle(to_way - was_way) * k;
    out: f32 = lerpf(sqrtf(was.x * was.x + was.z * was.z), sqrtf(to.x * to.x + to.z * to.z),
        k);
    cam.seen_eye = v_add(mid, v3(sinf(way) * out, lerpf(was.y, to.y, k), cosf(way) * out));
    cam.seen_eye.y = cam.seen_eye.y + cam.lift * sinf(PI * cam.fly);
    // What it looks at turns round the car with it.
    look_was: V3 = turn_y(v_sub(cam.from_at, cam.from_car), -was_way);
    look_to: V3 = turn_y(v_sub(cam.at, car), -to_way);
    cam.seen_at = v_add(mid, turn_y(v_lerp(look_was, look_to, k), way))
}

// v turned by a about the up axis: the way the camera's angle round the
// car goes (atan2 of x over z).
turn_y(v: V3, a: f32): V3 {
    c: f32 = cosf(a);
    s: f32 = sinf(a);
    v3(v.x * c + v.z * s, v.y, v.z * c - v.x * s)
}

// How much the walls have melted out of a flight's way, from 0 to 1.
flight_melt(cam: *Camera): f32 {
    if (cam.fly >= 1.0 || cam.lift == 0.0) return 0.0;
    clampf(sinf(PI * cam.fly) * 4.0, 0.0, 1.0)
}

// ---- changing cars, and starting over ----
// Neither is sudden. The car turns into the car asked for: its wheels grow
// or shrink, its body changes its shape, its colors turn, until it is the
// other (see pose.l8). As it does, it is carried from where it was to the
// start: lifted, if that is far, up over the canyon's walls with the
// camera, and set down. It cannot be driven till it is down, and nearly
// the car it is to be.
const MORPH_TIME: f32 = 0.45;

// How high the car is carried, of how high the camera flies.
const CARRY_LIFT: f32 = 0.72;

type Change = {
    // The car asked for, or -1 if none is. (Asked for while the car is
    // still turning into another, it waits, and the turning hurries.)
    to: int;
    // The car it was; how far it has turned into the car it is, from 0 to
    // 1 (1: it is done, or there is none); and where it was shown, and
    // the way it pointed, when it was taken up.
    from: int;
    turn: f32;
    from_p: V3;
    from_yaw: f32;
    // Where the car is to be put: how far along the lap from the start
    // line, and how far out from the road's middle. (Before the line: or,
    // for a race, on the grid.)
    at_s: f32;
    at_d: f32
}

// Whether the car can be driven.
change_done(g: *Change, cam: *Camera): bool {
    g.turn > 0.6 && cam.fly > 0.8
}

update_chase(
    cam: *Camera,
    c: *Car,
    p: V3,
    yaw: f32,
    high: bool,
    dt: f32
) {
    f: V3 = yaw_dir(yaw);
    speed: f32 = v_len(c.v);
    // The way the car points; sliding, more the way it goes (so that a
    // drifting car is seen askew).
    want: V3 = f;
    if (speed > 4.0 && v_dot(c.v, f) > 0.0) want = v_norm(v_lerp(f, v_scale(c.v, 1.0 / speed),
        0.7));
    cam.way = yaw_dir(approach_angle(dir_yaw(cam.way), dir_yaw(want), ease(5.5, dt)));
    k: f32 = clampf(speed / 30.0, 0.0, 1.0);
    // (A push throws it back a little, and it sees wider.)
    pushed: f32 = 0.0;
    if (c.push > 0.0) pushed = 1.0;
    cam.kick = lerpf(cam.kick, pushed, ease(5.0, dt));
    k = k + 0.6 * cam.kick;
    cam.at = v_madd(v_add(p, v3(0.0, 1.0, 0.0)), cam.way, 3.5 + 2.5 * k);
    // (Nearer a short car, farther from a long one.)
    size: f32 = 0.5 + 0.5 * car_axle[c.kind] / car_axle[BUGGY];
    eye: V3 = v_madd(v_add(p, v3(0.0, (2.9 + 0.3 * k) * size, 0.0)), cam.way, -(6.4 + 1.8 * k) * size);
    if (high) eye = v_madd(v_add(p, v3(0.0, 9.0, 0.0)), cam.way, -(13.0 + 2.0 * k));
    // Inside the walls, and above the ground.
    sp: Spot = locate(eye, c.spot.i, 30);
    room: f32 = spot_wall(sp) - 1.0;
    if (absf(sp.d) > room) {
        eye = v_madd(eye, right_of(way_at(sp.i, sp.f)), signf(sp.d) * (room - absf(sp.d)));
        sp.d = signf(sp.d) * room
    }
    eye.y = maxf(eye.y, spot_y(sp, eye.x, eye.z) + 1.3);
    cam.eye = eye;
    cam.up = v3(0.0, 1.0, 0.0);
    cam.fovy = 0.92 + 0.2 * k
}

// ---- another course ----
// Choosing another course does not swap one world for another at a blink:
// the canyon turns into the other where it stands, about the car, which
// is at the same start in both: its road bends into the other's, and its
// walls and trees go with it to where the other's are (see keep_world, in
// world.l8). The camera goes on as it was. How long the turning takes.
const TURN_TIME: f32 = 1.2;

// How long, of each picture's time, the new world may be built for, while
// it is being (see build_more, in world.l8): in thousand-millionths of a
// second. (All at once would stop the picture for a while.)
const BUILD_FOR: int = 5000000;

// The views: from behind the car; from higher and farther behind it; and
// (L8_VIEW=2) down on the whole track, over the walls.
const VIEW_CHASE: int = 0;

const VIEW_HIGH: int = 1;

const VIEW_MAP: int = 2;

set_map_view(cam: *Camera) {
    lo: V3 = track_p[0];
    hi: V3 = track_p[0];
    for i in 0..track_n {
        lo = v3(minf(lo.x, track_p[i].x), 0.0, minf(lo.z, track_p[i].z));
        hi = v3(maxf(hi.x, track_p[i].x), 0.0, maxf(hi.z, track_p[i].z))
    }
    mid: V3 = v_scale(v_add(lo, hi), 0.5);
    cam.eye = v3(mid.x, 620.0, mid.z);
    cam.at = mid;
    cam.up = v3(0.0, 0.0, 1.0);
    cam.fovy = 0.62
}

// ---- keys ----
type Keys = {
    left: bool;
    right: bool;
    up: bool;
    down: bool;
    space: bool
}

key_set(k: *Keys, ks: int, on: bool) {
    if (ks == 65361 || ks == 97) k.left = on;
    if (ks == 65363 || ks == 100) k.right = on;
    if (ks == 65362 || ks == 119) k.up = on;
    if (ks == 65364 || ks == 115) k.down = on;
    if (ks == 32) k.space = on
}

// What the driver asks now. There is no gas to hold: once the driver has
// touched anything (`going`), the car goes by itself, but while the brake
// is on.
read_input(k: *Keys, going: bool): Input {
    inp: Input = Input {
        steer: 0.0,
        gas: 0.0,
        brake: 0.0,
        tidy: false,
        veer: k.space
    };
    if (k.left) inp.steer = inp.steer - 1.0;
    if (k.right) inp.steer = inp.steer + 1.0;
    if (k.down) inp.brake = 1.0;
    read_thumbs(&inp);
    if (going && inp.brake == 0.0) inp.gas = 1.0;
    inp
}

// Whether a key is one the car is driven by.
driving_key(ks: int): bool {
    ks == 32 || ks >= 65361 && ks <= 65364 || ks == 97 || ks == 100 || ks == 115 || ks == 119
}

// In a tall window, as on a phone held upright, the picture moves up, so
// that he rides above the touch panels.
view_shift(): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    clampf((1.0 - aspect) * 0.8, 0.0, 0.45)
}

// Where the start's board, on its gantry, is in the picture: its top and
// its foot, down from the window's top, in window heights (see
// hud_board_top, in hud.l8). (Before the start, the words of the count
// keep off it.)
board_proj: []f32 = static_buffer([16]f32);

board_look: []f32 = static_buffer([16]f32);

see_board(v: View) {
    mat_persp(board_proj, v.fovy, screen_w as f32 / maxf(screen_h as f32, 1.0), 0.2,
        3000.0);
    board_proj[9] = -v.shift;
    mat_look(board_look, v.eye, v.at, v.up);
    mat_mul(board_proj, board_proj, board_look);
    m: []f32 = board_proj;
    p: V3 = spot_point(spot_at(0.0, 0.0));
    hud_board_top = -1.0;
    for e in 0..2 {
        y: f32 = track_h[0] + 5.1;
        if (e == 0) y = track_h[0] + 6.1;
        cy: f32 = m[1] * p.x + m[5] * y + m[9] * p.z + m[13];
        cw: f32 = m[3] * p.x + m[7] * y + m[11] * p.z + m[15];
        // (Behind the camera, it is not seen.)
        if (cw <= 0.01) return;
        at: f32 = 0.5 - 0.5 * cy / cw;
        if (e == 0) hud_board_top = at else hud_board_foot = at
    }
}

// Where the foot of the car is in the picture (see hud_car_foot, in
// hud.l8): the back of it on the ground, and its shadow behind it, as
// the chase camera has it behind the car once the car stands still (see
// update_chase). At speed the camera is farther back and the car higher in
// the picture, so this is the lowest the car comes, and a sheet kept under
// it keeps still as the car slows after the finish.
car_proj: []f32 = static_buffer([16]f32);

car_look: []f32 = static_buffer([16]f32);

see_car(kind: int) {
    size: f32 = 0.5 + 0.5 * car_axle[kind] / car_axle[BUGGY];
    back: f32 = -car_half[kind] - 1.0;
    mat_persp(car_proj, view_fovy(0.92), screen_w as f32 / maxf(screen_h as f32, 1.0),
        0.2, 3000.0);
    car_proj[9] = -view_shift();
    mat_look(car_look, v3(0.0, 2.9 * size, -6.4 * size), v3(0.0, 1.0, 3.5), v3(0.0,
        1.0, 0.0));
    mat_mul(car_proj, car_proj, car_look);
    m: []f32 = car_proj;
    cy: f32 = m[9] * back + m[13];
    cw: f32 = m[11] * back + m[15];
    hud_car_foot = 0.5 - 0.5 * cy / maxf(cw, 0.01)
}

// The camera's vertical field of view: wide enough across that a tall
// window, as on a phone held upright, still sees to the sides.
view_fovy(base: f32): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    across: f32 = sinf(base * 0.5) / cosf(base * 0.5) * 1.6;
    maxf(base, 2.0 * atan2f(across, aspect))
}

// The numbers after `prefix` in the environment, parted by commas, into
// out: how many there were. (L8_CAM=ex,ey,ez,ax,ay,az,fovy, in degrees,
// is a camera to stand at; L8_START=s starts the car s metres round the
// lap; L8_CAR=k starts in car k.)
env_numbers(prefix: str, out: []f32): int {
    for e in l8_environment() {
        if (len(e) > len(prefix) && starts_with(e, prefix)) {
            k: int = 0;
            num: f32 = 0.0;
            sign: f32 = 1.0;
            frac: f32 = 0.0;
            for i in len(prefix)..len(e) + 1 {
                c: int = 44;
                if (i < len(e)) c = e[i] as int;
                if (c == 45) sign = -1.0 else if (c == 46) frac = 0.1 else if (c >= 48 && c <= 57) {
                    if (frac > 0.0) {
                        num = num + (c - 48) as f32 * frac;
                        frac = frac * 0.1
                    } else num = num * 10.0 + (c - 48) as f32
                } else if (k < len(out)) {
                    out[k] = sign * num;
                    k = k + 1;
                    num = 0.0;
                    sign = 1.0;
                    frac = 0.0
                }
            }
            return k
        }
    }
    0
}

starts_with(s: str, prefix: str): bool {
    for i in 0..len(prefix) {
        if (s[i] != prefix[i]) return false
    }
    true
}

extern l8_environment(): []str@new;

view_from_env(): int {
    v: ?*i8 = getenv("L8_VIEW");
    if (v == null) return VIEW_CHASE;
    p: *i8 = v;
    (p.* as int - 48) % 3
}

main() raises IoError: int {
    // The course: the first, or the one L8_COURSE says. (Every course's
    // track is built first: the menu shows the shape of each.)
    courses: []f32 = buffer([1]f32, 0.0);
    if (env_numbers("L8_COURSE=", courses) == 0) courses[0] = 0.0;
    for k in 0..COURSES {
        set_course(k);
        build_track()
    }
    init_names();
    set_course(courses[0] as int);
    build_track();
    world: *Mesh = new_mesh(640000);
    build_world(world);
    parts: *Mesh = new_mesh(120000);
    build_parts(parts);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    screen_w = 1280;
    screen_h = 720;
    win: int = XCreateWindow(dpy, root, 0, 0, screen_w, screen_h, 0, vis.depth as int,
        1, vis.visual, 10248, &wa);
    if (win == 0) die("XCreateWindow failed");
    XStoreName(dpy, win, "L8 Race");
    proto: []int = buffer([1]int, 0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    eprint("L8 Race: in the menu, the arrows go about it and Enter races; driving, left/right steer, and it goes by itself; down is the brake (and backward); hold Space to veer into a drift; Escape is the pause, C changes the camera");
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    r: *Renderer = new_renderer(world, parts);
    env: []f32 = buffer([8]f32, 0.0);
    kind: int = BUGGY;
    if (env_numbers("L8_CAR=", env) > 0) kind = (env[0] as int % CARS + CARS) % CARS;
    start: f32 = WAIT_S;
    if (env_numbers("L8_START=", env) > 0) start = env[0];
    c: *Car = new_car(kind, start);
    cam: *Camera = new Camera {
        eye: c.p,
        at: c.p,
        up: v3(0.0, 1.0, 0.0),
        fovy: 0.92,
        way: yaw_dir(c.yaw),
        kick: 0.0,
        seen_eye: c.p,
        seen_at: c.p,
        from_eye: c.p,
        from_at: c.p,
        from_car: c.p,
        fly: 1.0,
        fly_time: 1.0,
        lift: 0.0
    };
    change: *Change = new Change {
        to: -1,
        from: kind,
        turn: 1.0,
        from_p: c.p,
        from_yaw: c.yaw,
        at_s: WAIT_S,
        at_d: 0.0
    };
    // Where the car is shown, and the way it points: where it is, but
    // while it is carried.
    shown: V3 = c.p;
    shown_yaw: f32 = c.yaw;
    view: int = view_from_env();
    // (Its own numbers: env is used again for others, below.)
    fixed_cam: []f32 = buffer([8]f32, 0.0);
    fixed: bool = env_numbers("L8_CAM=", fixed_cam) >= 7;
    // (L8_AUTO: it drives itself round, to watch. See auto_input.)
    auto: bool = getenv("L8_AUTO") != null;
    // (L8_NET: there is a page to tell where the car is, for the others.)
    online: bool = getenv("L8_NET") != null;
    others: []*Other = new_others();
    bots: []*Bot = new_bots();
    // Whether the menu is up (it is at first, but when the car is put
    // somewhere to be looked at, or drives itself): the car waits at the
    // start, and the camera goes slowly round it. And where the camera is
    // while it does.
    menu: bool = getenv("L8_MENU") != null || !(auto || fixed || getenv("L8_START") != null || getenv("L8_VIEW") != null || getenv("L8_RACE") != null);
    ui_online = online;
    ui_touch = getenv("L8_TOUCH") != null;
    // What a race is to be (see racers.l8): L8_SET=laps,drivers,skill, as
    // a page kept it; L8_RACE=drivers,skill,laps says too, and starts one
    // against computer drivers at once.
    said: int = env_numbers("L8_SET=", env);
    if (said > 0) set_laps = clampf(env[0], 1.0, 9.0) as int;
    if (said > 1) set_drivers = clampf(env[1], 0.0, MAX_BOTS as f32) as int;
    if (said > 2) set_skill = clampf(env[2], 0.0, 3.0) as int;
    if (getenv("L8_RACE") != null) {
        said = env_numbers("L8_RACE=", env);
        if (said > 0) set_drivers = clampf(env[0], 1.0, MAX_BOTS as f32) as int;
        if (said > 1) set_skill = clampf(env[1], 0.0, 3.0) as int;
        if (said > 2) set_laps = clampf(env[2], 1.0, 9.0) as int;
        call_own(4.0)
    }
    // (What a page has been told to keep: the car, the course, and those.)
    kept_car: int = kind;
    kept_course: int = course;
    kept_laps: int = set_laps;
    kept_drivers: int = set_drivers;
    kept_skill: int = set_skill;
    // (And what the room has a race be, till it says: what is here. See
    // room_config, in net.l8.)
    said_course = course;
    said_laps = set_laps;
    said_bots = set_drivers;
    said_skill = set_skill;
    // (The seat the car was put in its place for: when the room says
    // another, with the menu up, it goes to that one's.)
    placed_seat: int = 0;
    menu_eye: V3 = c.p;
    menu_at: V3 = c.p;
    // (Whether the menu's camera, or the camera, has been anywhere yet:
    // at first it is where it goes round the car from, not on its way
    // there.)
    menu_placed: bool = false;
    // (And whether it was going round the car in the last picture: when
    // it comes to the car again, from a flight, it goes on round from
    // where it came down.)
    orbiting: bool = false;
    // (How far the picture is framed for the menu, from 0 to 1: it moves
    // up and down gently, not as quickly as the menu comes and goes.)
    menu_framed: f32 = 1.0;
    // The course asked for, if it is not the one built (or -1).
    course_to: int = -1;
    // (And the one the page was last told is being gone to, for its
    // ghosts, or -1: it is told once, however long the course waits to be
    // gone to.)
    told_to: int = -1;
    // A course turning into another: how long it has been at it (less
    // than 0: none is), and the course it was.
    turn: f32 = -1.0;
    turn_from: int = 0;
    // (L8_SLOW=k: it takes k times as long, to be looked at.)
    turn_time: f32 = TURN_TIME;
    if (env_numbers("L8_SLOW=", env) > 0) turn_time = TURN_TIME * maxf(env[0], 1.0);
    // (And whether the new world is still being built.)
    making: bool = false;
    // How far round the car the menu's camera has gone.
    round: f32 = 0.5;
    // (And where the car was shown, and the way it pointed, in that one:
    // its place before the line is not quite the same in the other.)
    turn_p: V3 = c.p;
    turn_yaw: f32 = c.yaw;
    ghosts: []*Car = new_ghosts();
    keys: Keys = Keys {
        left: false,
        right: false,
        up: false,
        down: false,
        space: false
    };
    shadows: bool = getenv("L8_NO_SHADOWS") == null;
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = mono_ns();
    start_ns: int = prev_ns;
    acc: f32 = 0.0;
    paused: bool = false;
    tab: bool = false;
    // Whether the driver has touched anything since the car was put where
    // it is: it waits there till then, and then it goes (see read_input).
    going: bool = false;
    // Starting over (RESTART, AGAIN, or R) is not a flight: the game stands
    // still while the picture goes dark, for a moment; the car is put back
    // at the start, the camera behind it there; and the picture comes back.
    // Whether it is going dark to start over; and whether the car, when it
    // is next put somewhere, is to be put there at once (and how long the
    // picture has waited dark for that: a race with others is called by the
    // room, which may be slow).
    again_dark: bool = false;
    again_cut: bool = false;
    cut_wait: f32 = 0.0;
    // (And whether it goes dark for a race the room called, to take it up
    // under the dark, out on the road: see below.)
    call_dark: bool = false;
    // How much of the car's shadow there is, from 0 to 1: carried high, it
    // would fall far from the car, a dark car of its own sliding over the
    // ground; so it shrinks away under the car as it is lifted, and grows
    // back in under it as it is set down (see draw_cast, in pose.l8).
    car_cast: f32 = 1.0;
    // (Where the page was last told the name's box is: see name_box, in
    // ui.l8. The left, -1, if it does not show.)
    told_box: []int = [-1, 0, 0, 0];
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    // (Word of another car, from the page: no key.)
                    if (ui_page_key(ks) || ghost_key(ks) || net_key(others, ks)) ks = 0;
                    // (The menus' keys are nothing else's. In a window of
                    // its own, Escape from the menu ends the game.)
                    if (ks != 0 && ui_key(ks)) ks = 0;
                    if (ks == 65307 && !online && menu) running = false;
                    // 1 to 4 choose a car, Tab the next one: with the menu
                    // up. R starts over: not in a race.
                    now_kind: int = c.kind;
                    if (change.to >= 0) now_kind = change.to;
                    pick: int = now_kind;
                    if (menu) {
                        if (ks >= 49 && ks < 49 + CARS) pick = ks - 49;
                        // (Held, Tab is the next car once, not over and
                        // over.)
                        if (ks == 65289 && !tab) pick = (now_kind + 1) % CARS
                    }
                    if (ks == 65289) tab = true;
                    if (ks == 114 && !menu && !ui_paused && !(race.on && !race.done)) ask(ACT_AGAIN,
                        0);
                    if (pick != now_kind) {
                        change.to = pick;
                        change.at_s = wait_s(net_my_seat);
                        change.at_d = wait_d(net_my_seat)
                    }
                    if (ks == 99) view = (view + 1) % 2;
                    if (driving_key(ks)) going = true;
                    key_set(&keys, ks, true)
                }
                KeyRelease -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65289) tab = false;
                    key_set(&keys, ks, false)
                }
                // (A press on the menus is theirs; any other is the
                // driving's.)
                ButtonPress b -> {
                    if (!ui_press(b.button as int, b.x as f32, b.y as f32)) {
                        going = true;
                        pointer_down(b.button as int, b.x as f32, b.y as f32)
                    }
                }
                ButtonRelease b -> {
                    if (!ui_release(b.button as int, b.x as f32, b.y as f32)) pointer_up(b.button as int)
                }
                MotionNotify mo -> {
                    ui_motion(mo.state as int, mo.x as f32, mo.y as f32);
                    pointer_move(mo.state as int, mo.x as f32, mo.y as f32)
                }
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        screen_w = c.width as int;
                        screen_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        if (running) {
            now: int = mono_ns();
            dns: int = now - prev_ns;
            prev_ns = now;
            if (dns < 0) dns = 0;
            // (Away a while, as when the page is hidden and no pictures
            // are asked for: in a race the room called, the others did
            // not wait, and its clock goes on by as long. See race_away.)
            if (dns > 1000000000 && race_id > 0) race_away((dns - 100000000) as f32 / 1000000000.0);
            if (dns > 100000000) dns = 100000000;
            // What the menus ask (see ui.l8).
            act: int = ui_act;
            ui_act = ACT_NONE;
            // (Starting over: first the dark, then the start. See
            // again_dark.)
            ui_dt: f32 = dns as f32 / 1000000000.0;
            // (In a race with others, to start over is to ask the room for
            // another, at once: the picture goes dark as it is called. It
            // may wait for those still racing: see room_wait.)
            room_call: bool = online && others_here(others) > 0;
            if (act == ACT_AGAIN && race.on && room_call) act = ACT_RACE;
            if (act == ACT_AGAIN && !again_dark && !again_cut) {
                again_dark = true;
                ui_paused = false
            }
            if (act == ACT_AGAIN || again_dark && (act == ACT_MENU || act == ACT_PAUSE)) act = ACT_NONE;
            if (again_dark) {
                ui_blink = minf(ui_blink + ui_dt / 0.25, 1.0);
                if (ui_blink >= 1.0) {
                    again_dark = false;
                    again_cut = true;
                    cut_wait = 0.0;
                    if (!call_dark) act = ACT_AGAIN;
                    call_dark = false;
                    // (What was up is gone while it is dark: it does not
                    // come back with the picture, to go again.)
                    show_result = 0.0;
                    show_pause = 0.0;
                    show_side = 1.0
                }
            } else if (again_cut && (cut_wait < 1.5 || net_race)) cut_wait = cut_wait + ui_dt else {
                again_cut = false;
                ui_blink = maxf(ui_blink - ui_dt / 0.35, 0.0)
            }
            if (act == ACT_CAR && menu) {
                was_kind: int = c.kind;
                if (change.to >= 0) was_kind = change.to;
                change.to = ((was_kind + ui_arg) % CARS + CARS) % CARS;
                change.at_s = wait_s(net_my_seat);
                change.at_d = wait_d(net_my_seat)
            }
            // (Another course: the ghosts are of this one, and go at once,
            // and the page gives the other's. The room is told, below.)
            if (act == ACT_COURSE && menu) {
                if (ui_arg != course) course_to = ui_arg else if (course_to >= 0 && course_to != course) {
                    // (Asked for again before the other was begun: the
                    // one built stays, and so do its ghosts.)
                    course_to = -1;
                    told_to = -1;
                    forget_ghosts();
                    if (online) {
                        write(1, "L8ROOM ");
                        write_int(1, course);
                        write(1, "\n")
                    }
                }
            }
            // What the room says a race is to be, which everyone in it
            // shares: taken up as if it had been chosen here (but for the
            // course, while the car is out on the road). See room_config,
            // in net.l8.
            picked: bool = act == ACT_COURSE && menu;
            room_to: int = room_config(menu, picked);
            if (room_to >= 0) course_to = room_to;
            if (menu && net_my_seat != placed_seat && change.to < 0 && change.turn >= 1.0 && !making) {
                placed_seat = net_my_seat;
                place_car_at(c, wait_s(net_my_seat), wait_d(net_my_seat))
            }
            if (act == ACT_MENU) {
                waited: int = room_course_now();
                if (waited >= 0) course_to = waited
            }
            if (course_to >= 0 && course_to != course && course_to != told_to) {
                told_to = course_to;
                forget_ghosts();
                if (online) {
                    write(1, "L8ROOM ");
                    write_int(1, course_to);
                    write(1, "\n")
                }
            }
            // And what the player chose here, the room is told: only that,
            // never what the room said and this device has not taken up.
            chosen: int = course_chosen(course_to);
            ui_course = chosen;
            if (online) tell_room(chosen, picked);
            // To the menu, or to drive alone (or to start that over): no
            // race is on, and the car goes to the start.
            // (A race of its own asked for and not yet begun, as it waits for
            // a course to be built, is let go: the player chose otherwise
            // since. One the room called is not: it takes the car up.)
            if (act == ACT_MENU || act == ACT_TRIAL || act == ACT_AGAIN && !race.on) {
                if (act != ACT_AGAIN) menu = act == ACT_MENU;
                if (net_race && net_race_id < 0) net_race = false;
                ui_paused = false;
                race.on = false;
                nbots = 0;
                change.to = c.kind;
                change.at_s = wait_s(net_my_seat);
                change.at_d = wait_d(net_my_seat)
            }
            // A race: with others here, it is asked of them all (the page
            // asks the room, which calls it: see net_key); with nobody,
            // it is against computer drivers, here and now.
            // (Asked of the room, the pause stays up till the race is
            // called: RESTART shows that it waits, if it does. Asked again
            // while the room holds it, it is asked for no more: the room
            // waits on this car again, if it races, and if nobody else
            // asked for the race, does not call it.)
            if (act == ACT_RACE || act == ACT_AGAIN && race.on) {
                if (room_call && race_asked && room_wait >= 0) {
                    write(1, "L8UNRACE\n");
                    race_asked = false
                } else if (room_call) {
                    write(1, "L8RACE\n");
                    race_asked = true;
                    asked_wait = 2.0
                } else {
                    ui_paused = false;
                    call_own(5.0)
                }
            }
            if (act == ACT_PAUSE && !menu) ui_paused = true;
            // (Going on with the race, the car no longer asks for the next:
            // it is taken up once this one is finished.)
            if (act == ACT_RESUME) {
                ui_paused = false;
                if (race_asked && online) write(1, "L8UNRACE\n");
                race_asked = false
            }
            if (race_asked && room_wait < 0) {
                asked_wait = asked_wait - ui_dt;
                if (asked_wait <= 0.0) race_asked = false
            }
            if (act == ACT_NAME && online) write(1, "L8NAME\n");
            // (The menus go on while the game stands still under the
            // pause: which it does, but in a race with others, who do
            // not wait.)
            paused = (ui_paused || again_dark) && others_racing(others) == 0;
            if (paused) dns = 0;
            dt: f32 = dns as f32 / 1000000000.0;
            acc = acc + dt;
            steps: int = 0;
            high: bool = view == VIEW_HIGH;
            // A course turning into another goes on: once what is seen of
            // the new world is built (see world_near_built, in world.l8).
            // (And with another asked for meanwhile, it hurries.)
            if (turn >= 0.0) {
                hurry_turn: f32 = 1.0;
                if (course_to >= 0 && course_to != course) hurry_turn = 3.0;
                if (!making || world_near_built()) turn = turn + hurry_turn * dt;
                if (turn >= turn_time) turn = -1.0
            }
            // Another course is asked for: it is built in this one's
            // place (this one being kept, to turn into it), and the car
            // is at its start, which is where this one's is, with no race
            // on, and no marks on its road.
            // (With the menu up, it waits till the car is down at the start
            // and the camera has come to it: the world then turns round
            // the car where it stands, as when a course is picked there.
            // Back from the road onto a course the room chose meanwhile,
            // the car would be put at the other's start while the camera
            // was still on its way, and the camera would fly through
            // bare ground and the walls to find it.)
            landing: bool = menu && (change.to >= 0 || cam.fly < 1.0);
            began: int = mono_ns();
            if (turn < 0.0 && !making && !landing) {
                if (course_to >= 0 && course_to != course) {
                    turn_from = course;
                    turn_p = shown;
                    turn_yaw = shown_yaw;
                    keep_world();
                    set_course(course_to);
                    build_track();
                    begin_world(world);
                    upload_world(r, world);
                    making = true;
                    turn = 0.0;
                    race.on = false;
                    nbots = 0;
                    clear_marks();
                    place_car_at(c, wait_s(net_my_seat), wait_d(net_my_seat));
                    reset_laps();
                    going = false;
                    change.to = -1;
                    change.turn = 1.0;
                    // (Out on the road, the camera is behind the car at
                    // once; with the menu up, it goes on round it.)
                    if (!menu) {
                        cam.way = yaw_dir(c.yaw);
                        update_chase(cam, c, car_point(c, 1.0), c.yaw, high, 0.0);
                        cam.fly = 1.0
                    }
                }
                course_to = -1;
                told_to = -1
            }
            // The new world is built a little in each picture's time, what
            // is nearest the car first, each piece sent to be drawn as it
            // is built.
            if (making) {
                more: bool = true;
                while (more && mono_ns() - began < BUILD_FOR) more = build_more(world);
                upload_more(r, world);
                if (!more) making = false
            }
            // A race called: it is to start in so long from when it was
            // heard, and that goes on while it waits to be taken up.
            if (net_race) net_race_wait = maxf(net_race_wait - ui_dt, 0.0);
            // (One the room called, while the car is still in a race it
            // has not finished, is let go: the car goes on with its own,
            // and those in the new one see it faint, as it does them. It
            // joins the next one called, from AGAIN or the menu. And the
            // room holds a race called till those still racing have
            // finished, for a while at most: see web/race-room/worker.js.)
            if (net_race && net_race_id > 0 && !race_free()) {
                net_race = false;
                net_race_course = -1
            }
            // (One called while the car is out on the road, as how a race
            // came out is up, is taken up under the dark, as a start over
            // is. From the menu, the car flies to the grid.)
            if (net_race && net_race_id > 0 && !menu && ui_blink < 1.0 && !again_dark) {
                again_dark = true;
                call_dark = true
            }
            call_ready: bool = menu || ui_blink >= 1.0 || net_race_id <= 0;
            // (A race on another course: that course first.)
            if (net_race && call_ready && net_race_course >= 0 && net_race_course != course && course_to < 0 && !making && turn < 0.0) {
                course_to = net_race_course;
                told_to = course_to;
                forget_ghosts();
                if (online) {
                    write(1, "L8ROOM ");
                    write_int(1, course_to);
                    write(1, "\n")
                }
            }
            if (net_race && call_ready && turn < 0.0 && !making && course_to < 0) {
                menu = false;
                ui_paused = false;
                // (A course the room chose since the race was called waits
                // for the menu, as one chosen during it does.)
                room_course = -1;
                if (online && said_course != course) room_course = said_course;
                take_race(bots, mono_ns() / 1000);
                // (Started over, under the dark, they are there when it
                // lifts; from the menu, they come: see bots_shown. So too
                // the others.)
                others_hide(others);
                if (ui_blink >= 1.0) {
                    bots_shown = 1.0;
                    others_come(others, 1.0)
                }
                change.to = c.kind;
                change.at_s = grid_s(net_race_place);
                change.at_d = grid_d(net_race_place)
            }
            // (The race's computer drivers, given to this device to drive
            // on, or to another: see heed_drive.)
            heed_drive(bots, others, c);
            if (change.to >= 0 && change.turn >= 1.0) {
                // It is taken up from where it is shown; and it is at the
                // start, the car asked for.
                change.from = c.kind;
                change.turn = 0.0;
                // (With the menu up, a car that is already there is only
                // turned into the other: the camera goes on round it as it
                // was.)
                there: bool = menu && v_len(v_sub(spot_point(spot_at(change.at_s,
                    change.at_d)), c.p)) < 0.5;
                if (!there) {
                    change.from_p = shown;
                    change.from_yaw = shown_yaw
                }
                c.kind = change.to;
                change.to = -1;
                place_car_at(c, change.at_s, change.at_d);
                reset_laps();
                break_marks();
                drop_lap();
                going = false;
                // (Started over, the camera is behind it there at once,
                // while the picture is dark.)
                if (again_cut) {
                    again_cut = false;
                    change.from_p = c.p;
                    change.from_yaw = c.yaw;
                    cam.way = yaw_dir(c.yaw);
                    update_chase(cam, c, car_point(c, 1.0), c.yaw, high, 0.0);
                    cam.fly = 1.0;
                    cam.lift = 0.0
                } else if (!there) start_flight(cam, c, change.from_p, high)
            }
            hurry: f32 = 1.0;
            if (change.to >= 0) hurry = 3.0;
            change.turn = minf(change.turn + hurry * dt / MORPH_TIME, 1.0);
            // (After the count, a race is under way, touched or not.)
            if (race.on && !race_waits() && !race.done) going = true;
            inp: Input = read_input(&keys, going);
            if (auto) inp = auto_input(c);
            // (It cannot be driven while it is changing, or waiting on the
            // grid, or with the menu up.)
            if (menu) going = false;
            solid: bool = change_done(change, cam);
            if (!solid || race_waits() || menu) inp = Input {
                steer: 0.0,
                gas: 0.0,
                brake: 0.0,
                tidy: true,
                veer: false
            };
            while (acc >= STEP_DT && steps < 12) {
                step_car(c, inp, STEP_DT);
                // (While it is carried to the start, it runs into nobody;
                // nor while it waits there with the menu up.)
                if (solid && !menu) hit_others(others, c);
                step_bots(bots, c, solid, STEP_DT);
                bots_hit_others(bots, others);
                crossed: int = laps.crossed;
                tick_laps(c, STEP_DT);
                // (The lap is kept as it is driven, for a ghost: see
                // ghost.l8.)
                if (laps.crossed != crossed) keep_lap(c, crossed > 0 && laps.was_best);
                keep_step(c);
                tick_race(c, STEP_DT);
                acc = acc - STEP_DT;
                steps = steps + 1
            }
            if (acc > STEP_DT) acc = 0.0;
            // (With the menu up, the car stays where it was put to wait,
            // whatever goes by.)
            if (menu && solid && change.to < 0 && change.turn >= 1.0 && !making && turn < 0.0 && placed_seat == net_my_seat) {
                park: V3 = spot_point(spot_at(wait_s(net_my_seat), wait_d(net_my_seat)));
                off: V3 = v_sub(c.p, park);
                if (off.x * off.x + off.z * off.z > 0.0025) place_car_at(c, wait_s(net_my_seat),
                    wait_d(net_my_seat))
            }
            // How much it drafts whoever is ahead of it.
            ahead: f32 = maxf(draft_others(others, c), draft_bots(bots, c, dt));
            if (!solid || menu) ahead = 0.0;
            feel_draft(c, ahead, dt);
            tick_marks(c);
            // What shows in the air: about the car's wheels and its tail,
            // the air it drafts in (or is pushed through), and about the
            // wheels of the others near enough to see (and the tails of
            // the computer drivers near it, for the pushes they earn).
            tick_fx(dt);
            if (solid && !menu) {
                fx_wheels(c, dt);
                fx_tail(c, dt);
                pushed: f32 = 0.0;
                if (c.push > 0.0) pushed = 0.7;
                fx_air(c, maxf(c.draft, pushed), dt)
            }
            for k in 0..nbots {
                fx_wheels(bots[k].car, dt);
                if (v_len(v_sub(bots[k].car.p, c.p)) < 60.0) fx_tail(bots[k].car,
                    dt)
            }
            fx_others(others, c.p, dt);
            alpha: f32 = acc / STEP_DT;
            pos: V3 = car_point(c, alpha);
            yaw: f32 = car_yaw(c, alpha);
            if (fixed) {
                cam.eye = v3(fixed_cam[0], fixed_cam[1], fixed_cam[2]);
                cam.at = v3(fixed_cam[3], fixed_cam[4], fixed_cam[5]);
                cam.up = v3(0.0, 1.0, 0.0);
                cam.fovy = fixed_cam[6] * PI / 180.0
            } else if (view == VIEW_MAP) set_map_view(cam) else update_chase(cam,
                c, pos, yaw, high, dt);
            // (A flight is only from behind a car to behind a car.)
            if (fixed || view == VIEW_MAP) cam.fly = 1.0;
            fly_camera(cam, pos, dt);
            melt: f32 = flight_melt(cam);
            // A course turning into another: how far it has, easing in and
            // out; and where the car stands meanwhile: so far from where it
            // stood to where it stands (which, at the start, are much the
            // same).
            turning: f32 = -1.0;
            if (turn >= 0.0) {
                turning = smoothstepf(0.0, 1.0, turn / turn_time);
                set_theme_between(turn_from, course, turning)
            } else set_theme_between(course, course, 0.0);
            stand: V3 = pos;
            stand_yaw: f32 = yaw;
            if (turning >= 0.0 && menu) {
                stand = v_lerp(turn_p, pos, turning);
                stand_yaw = turn_yaw + wrap_angle(yaw - turn_yaw) * turning
            }
            // With the menu up, once it has come to the car, it goes
            // slowly round it. It comes to where it goes round from by
            // going round the car, out or in, and up or down: not straight
            // there, which could take it over the roof, close enough to
            // fill the picture. (Come down behind the car from a flight,
            // it goes round from there.)
            round = round + 0.25 * dt;
            if (menu && cam.fly >= 1.0 && !fixed && view != VIEW_MAP) {
                reach: f32 = 3.4 + 2.0 * car_axle[c.kind];
                near: f32 = ease(3.0, dt);
                off: V3 = v_sub(menu_eye, stand);
                if (!menu_placed) near = 1.0 else if (!orbiting) round = atan2f(off.x,
                    off.z);
                menu_placed = true;
                orbiting = true;
                way: f32 = approach_angle(atan2f(off.x, off.z), round, near);
                out: f32 = lerpf(sqrtf(off.x * off.x + off.z * off.z), reach, near);
                menu_eye = v_add(stand, v3(sinf(way) * out, lerpf(off.y, 1.7, near),
                    cosf(way) * out));
                menu_at = v_lerp(menu_at, v_add(stand, v3(0.0, 0.6, 0.0)), near);
                cam.seen_eye = menu_eye;
                cam.seen_at = menu_at
            } else {
                orbiting = false;
                menu_placed = true;
                menu_eye = cam.seen_eye;
                menu_at = cam.seen_at
            }
            near: int = c.spot.i;
            // The car goes with the camera: from where it was taken up to
            // where it is, not quite as high (the camera looks down on it),
            // and level while it is off the ground.
            shown = pos;
            shown_yaw = yaw;
            held: f32 = 0.0;
            lifted: f32 = 0.0;
            if (cam.fly < 1.0) {
                k: f32 = smoothstepf(0.0, 1.0, cam.fly);
                shown = v_lerp(change.from_p, pos, k);
                lifted = CARRY_LIFT * cam.lift * sinf(PI * cam.fly);
                shown.y = shown.y + lifted;
                shown_yaw = change.from_yaw + wrap_angle(yaw - change.from_yaw) * k;
                held = smoothstepf(0.0, 0.15, cam.fly) * (1.0 - smoothstepf(0.8, 1.0,
                    cam.fly))
            } else {
                shown = stand;
                shown_yaw = stand_yaw
            }
            car_cast = lerpf(car_cast, 1.0 - smoothstepf(0.3, 2.5, lifted), ease(12.0,
                ui_dt));
            pose_none();
            pose_eye = cam.seen_eye;
            pose_mine = shown;
            pose_reach = 0.0;
            if (cam.fly < 1.0) pose_reach = v_len(v_sub(cam.eye, pos));
            pose_kind(change.from, c.kind, smoothstepf(0.0, 1.0, change.turn));
            if (change.turn >= 1.0) pose_kind(c.kind, c.kind, 0.0);
            pose_cast = car_cast;
            pose_under = v3(shown.x, shown.y - lifted, shown.z);
            pose_car(c, shown, shown_yaw, held);
            pose_cast = 1.0;
            blob_size: f32 = 0.55 + 0.45 * pose_shape(car_axle) / car_axle[BUGGY];
            // The others on the track; and word of where this car is, for
            // them.
            // (They come as the computer drivers do, once the menu has
            // gone: see bots_shown. And in the menu, as they turn up.)
            tick_others(others, dt);
            // (Each car in a paint of its own: see paint_take.)
            paints_none();
            paint_take(NAME_ME, c.kind, true);
            paint_others(others);
            paint_bots();
            if (menu || show_menu <= 0.0) others_come(others, ui_dt / BOTS_COME);
            pose_others(others, shown);
            // (The computer drivers come onto the grid once the menu has
            // gone: see bots_shown.)
            if (show_menu <= 0.0) bots_shown = minf(bots_shown + ui_dt / BOTS_COME,
                1.0);
            pose_bots(bots);
            tick_ghosts(ghosts, laps.time + acc, dt);
            pose_ghosts(ghosts, shown);
            // Who is racing, and in what order (see racers.l8): the
            // player, the others, and the computer drivers.
            // (While what is over the driving goes, as the menu comes up,
            // it says what it said, as the car is put back at the start:
            // these, and the lap and the race, are kept as they were. See
            // hud_laps, in hud.l8.)
            if (!menu || show_drive <= 0.0) {
                racers_none();
                racer_put(NAME_ME, c.progress, race.done, race.done_time);
                race_others(others, menu);
                race_bots(bots);
                // (In a race, nobody who finished it is lost from it, nor,
                // once the car has, anyone: see racers_keep.)
                if (race.on && !menu) racers_keep(race.done);
                hud_place = racers_sort(race.on);
                hud_of = nracers;
                // And all of them on the map, with the car itself.
                map_none();
                map_ghosts(ghosts);
                map_others(others);
                map_bots(bots);
                map_put(shown, paint_of[NAME_ME], DOT_ME);
                hud_laps = laps;
                hud_race = race;
                hud_speed = v_len(c.v)
            }
            hud_menu = show_drive <= 0.0;
            framed: f32 = 0.0;
            if (menu) framed = 1.0;
            menu_framed = lerpf(menu_framed, framed, ease(6.0, ui_dt));
            ui_menu = menu;
            ui_again = again_dark;
            ui_others = others_here(others);
            tick_ui(ui_dt);
            if (online) {
                say_place(c, (now - start_ns) as f32 / 1000000000.0, dt);
                if (nbots > 0 && others_here(others) > 0) say_bots_net(bots, (now - start_ns) as f32 / 1000000000.0,
                    dt);
                say_finish();
                say_ghost();
                // (And what is to be kept, when it is another.)
                now_car: int = c.kind;
                if (change.to >= 0) now_car = change.to;
                if (now_car != kept_car) {
                    kept_car = now_car;
                    write(1, "L8SAVE car ");
                    write_int(1, kept_car);
                    write(1, "\n")
                }
                if (course != kept_course) {
                    kept_course = course;
                    write(1, "L8SAVE course ");
                    write_int(1, kept_course);
                    write(1, "\n")
                }
                if (set_laps != kept_laps) {
                    kept_laps = set_laps;
                    write(1, "L8SAVE laps ");
                    write_int(1, kept_laps);
                    write(1, "\n")
                }
                if (set_drivers != kept_drivers) {
                    kept_drivers = set_drivers;
                    write(1, "L8SAVE drivers ");
                    write_int(1, kept_drivers);
                    write(1, "\n")
                }
                if (set_skill != kept_skill) {
                    kept_skill = set_skill;
                    write(1, "L8SAVE skill ");
                    write_int(1, kept_skill);
                    write(1, "\n")
                }
            }
            hud_kind = c.kind;
            hud_card = cam.fly >= 1.0 || cam.lift == 0.0;
            tick_card(dt);
            v: View = View {
                eye: cam.seen_eye,
                at: cam.seen_at,
                up: cam.up,
                fovy: view_fovy(cam.fovy),
                shift: 0.0,
                focus: v_madd(pos, cam.way, 26.0),
                car: shown,
                car_way: v_scale(yaw_dir(shown_yaw), 1.0 / blob_size),
                time: (now - start_ns) as f32 / 1000000000.0,
                fade_from: lerpf(16.0, 1.0, melt),
                fade_to: lerpf(85.0, 5.0, melt),
                near: near,
                turning: turning
            };
            // (The car's way is made longer for a small car: the dark under
            // it is as small as the car is. And over the walls, all of the
            // track may show, and what is looked at is not near the car.)
            if (cam.fly < 1.0 && cam.lift > 0.0) {
                v.near = -1;
                v.focus = cam.seen_at
            }
            if (fixed) {
                v.fovy = cam.fovy;
                v.near = -1
            } else if (view == VIEW_MAP) {
                v.near = -1;
                v.fovy = cam.fovy;
                v.focus = cam.at;
                v.fade_from = 1.0;
                v.fade_to = 5.0
            } else v.shift = view_shift();
            // (With the menu up, the car is shown above the middle, clear
            // of the menu's buttons.)
            if (!fixed && view != VIEW_MAP) v.shift = lerpf(v.shift, menu_shift(),
                smoothstepf(0.0, 1.0, menu_framed));
            // (Where the start's board is seen from where the camera is to
            // be, behind the car on the grid: not from where it is on its
            // way there, so that the count's words keep still.)
            if (race_waits()) {
                board: View = v;
                if (!fixed && view != VIEW_MAP) {
                    board.eye = cam.eye;
                    board.at = cam.at;
                    board.shift = view_shift()
                }
                see_board(board)
            }
            if (!fixed && view == VIEW_CHASE) see_car(c.kind) else hud_car_foot = 0.0;
            draw_scene(r, v, shadows);
            if (getenv("L8_NO_HUD") == null) draw_hud(r);
            // Where the name is to be written, the page is told when that
            // changes (see name_box, in ui.l8): its box, in the window's
            // pixels, and the window's size.
            if (online) {
                box_x: int = -1;
                if (name_box_on) box_x = name_box[0] as int;
                moved: bool = box_x != told_box[0];
                for k in 1..4 {
                    if (name_box_on && name_box[k] as int != told_box[k]) moved = true
                }
                if (moved) {
                    told_box[0] = box_x;
                    if (box_x < 0) write(1, "L8NAMEAT -\n") else {
                        write(1, "L8NAMEAT");
                        for k in 0..4 {
                            told_box[k] = name_box[k] as int;
                            write(1, " ");
                            write_int(1, told_box[k])
                        }
                        write(1, " ");
                        write_int(1, screen_w);
                        write(1, " ");
                        write_int(1, screen_h);
                        write(1, "\n")
                    }
                }
            }
            glXSwapBuffers(dpy, win)
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}
