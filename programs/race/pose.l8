tag race;

use_tag skate;

// The car as it is drawn: its parts (see mesh.l8), each with where it goes.
const MAX_DRAWS: int = 8;

draw_m: []f32 = new f32[MAX_DRAWS * 16](0.0);

draw_part: []int = new int[MAX_DRAWS](0);

ndraw: int = 0;

pose_m: []f32 = new f32[16](0.0);

put_part(part: int) {
    if (ndraw >= MAX_DRAWS) return;
    for k in 0..16 draw_m[ndraw * 16 + k] = pose_m[k];
    draw_part[ndraw] = part;
    ndraw = ndraw + 1
}

// How far the body leans for each m/s2 it is pulled sideways, and along;
// and the most it leans.
const LEAN_SIDE: f32 = 0.0045;

const LEAN_ALONG: f32 = 0.0028;

const LEAN_MOST: f32 = 0.075;

// The way it points across the ground between steps: `alpha` of the way
// from the step before to the last.
car_yaw(c: *Car, alpha: f32): f32 {
    c.prev_yaw + wrap_angle(c.yaw - c.prev_yaw) * alpha
}

// Where its middle is on the ground, the same.
car_point(c: *Car, alpha: f32): V3 {
    p: V3 = v_lerp(c.prev, c.p, alpha);
    p.y = car_y(c);
    p
}

// The car, `alpha` of the way from its step before to its last: its body
// on the ground's slope under its wheels, leaning out of a turn, its nose
// down under the brakes; and each wheel on its own ground, the front two
// turned, all four rolling.
pose_car(c: *Car, alpha: f32) {
    ndraw = 0;
    yaw: f32 = car_yaw(c, alpha);
    p: V3 = car_point(c, alpha);
    f: V3 = yaw_dir(yaw);
    r: V3 = right_of(f);
    // Its own axes on the slope: its nose's way, its left, and up from it.
    nose: V3 = v_norm(v_madd(f, UP, car_rise(c)));
    left: V3 = v_norm(v_madd(v_scale(r, -1.0), UP, -car_tilt(c)));
    up: V3 = v_norm(v_cross(nose, left));
    left = v_cross(up, nose);
    mat_frame(pose_m, left, up, nose, p);
    mat_rotate(pose_m, v3(0.0, 0.0, 1.0), clampf(-c.pull_side * LEAN_SIDE, -LEAN_MOST,
        LEAN_MOST));
    mat_rotate(pose_m, v3(1.0, 0.0, 0.0), clampf(-c.pull_along * LEAN_ALONG, -LEAN_MOST,
        LEAN_MOST));
    put_part(PART_BODY);
    for k in 0..4 {
        along: f32 = AXLE_Z;
        if (k >= 2) along = -AXLE_Z;
        across: f32 = -WHEEL_X;
        if (k % 2 == 1) across = WHEEL_X;
        w: V3 = v_madd(v_madd(p, f, along), r, across);
        w.y = c.wheel_y[k] + WHEEL_R;
        mat_frame(pose_m, left, up, nose, w);
        // (The front wheels are shown turned more than, at speed, they
        // are: it is so little then.)
        if (k < 2) mat_rotate(pose_m, v3(0.0, 1.0, 0.0), -(c.turned * 0.6 + c.steer * 0.16));
        mat_rotate(pose_m, v3(1.0, 0.0, 0.0), c.rolled / WHEEL_R);
        put_part(PART_WHEEL)
    }
}
