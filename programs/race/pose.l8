tag race;

use_tag skate;

// The cars as they are drawn: their parts (see mesh.l8), each with where
// it goes. A car changing from one kind to another is drawn part way
// between them: each part is the part of the car it was turning into the
// same part of the car it is to be (see pose_kind).
const MAX_DRAWS: int = 96;

draw_m: []f32 = new f32[MAX_DRAWS * 16](0.0);

// (Which part of a car each is, its body or a wheel; and of which car,
// turning into which, how far.)
draw_part: []int = new int[MAX_DRAWS](0);

draw_from: []int = new int[MAX_DRAWS](0);

draw_to: []int = new int[MAX_DRAWS](0);

draw_morph: []f32 = new f32[MAX_DRAWS](0.0);

// (And whether it is part of a ghost: drawn seen through, last, and
// casting no shadow.)
draw_ghost: []bool = new bool[MAX_DRAWS](false);

ndraw: int = 0;

// The kind of the car being posed: the car it was, the car it is to be,
// and how far it has turned from the one into the other.
pose_from: int = 0;

pose_to: int = 0;

pose_morph: f32 = 0.0;

// Whether the cars being posed are ghosts (see ghost.l8).
pose_ghost: bool = false;

// Where the picture is taken from: another car that is right up against it
// (one close behind the player's is) is drawn seen through, as a ghost is,
// so that it does not hide the road. And how near that is.
pose_eye: V3 = V3 { x: 0.0, y: 1000.0, z: 0.0 };

const POSE_NEAR: f32 = 4.6;

pose_near(p: V3): bool {
    d: V3 = v_sub(p, pose_eye);
    d.x * d.x + d.z * d.z < POSE_NEAR * POSE_NEAR && absf(d.y) < 8.0
}

pose_kind(from: int, to: int, morph: f32) {
    pose_from = from;
    pose_to = to;
    pose_morph = morph
}

// No car is posed yet.
pose_none() {
    ndraw = 0
}

pose_m: []f32 = new f32[16](0.0);

put_part(part: int) {
    if (ndraw >= MAX_DRAWS) return;
    for k in 0..16 draw_m[ndraw * 16 + k] = pose_m[k];
    draw_part[ndraw] = part;
    draw_from[ndraw] = pose_from;
    draw_to[ndraw] = pose_to;
    draw_morph[ndraw] = pose_morph;
    draw_ghost[ndraw] = pose_ghost;
    ndraw = ndraw + 1
}

// How far the body leans for each m/s2 it is pulled sideways, and along;
// and the most it leans.
const LEAN_SIDE: f32 = 0.0045;

const LEAN_ALONG: f32 = 0.0028;

const LEAN_MOST: f32 = 0.075;

// The way it points across the ground between steps: `alpha` of the way
// from the step before to the last.
car_yaw(c: *Car, alpha: f32): f32 {
    c.prev_yaw + wrap_angle(c.yaw - c.prev_yaw) * alpha
}

// Where its middle is on the ground, the same.
car_point(c: *Car, alpha: f32): V3 {
    p: V3 = v_lerp(c.prev, c.p, alpha);
    p.y = car_y(c);
    p
}

// A number of the car's shape (see cars.l8), part way between the car it
// was and the car it is to be.
pose_shape(of: []f32): f32 {
    lerpf(of[pose_from], of[pose_to], pose_morph)
}

// The car with its middle at p on the ground, pointing the way `yaw`: its
// body on the ground's slope under its wheels, leaning out of a turn, its
// nose down under the brakes; and each wheel on its own ground, the front
// two turned, all four rolling. `held` is how much it is off the ground,
// from 0 to 1 (see Change, in main.l8: it is carried to the start): held,
// it is level, its wheels level with it. It is of the kind pose_kind
// said, and joins the cars already posed.
pose_car(
    c: *Car,
    p: V3,
    yaw: f32,
    held: f32
) {
    f: V3 = yaw_dir(yaw);
    r: V3 = right_of(f);
    down: f32 = 1.0 - held;
    // Its own axes on the slope: its nose's way, its left, and up from it.
    nose: V3 = v_norm(v_madd(f, UP, car_rise(c) * down));
    left: V3 = v_norm(v_madd(v_scale(r, -1.0), UP, -car_tilt(c) * down));
    up: V3 = v_norm(v_cross(nose, left));
    left = v_cross(up, nose);
    mat_frame(pose_m, left, up, nose, p);
    mat_rotate(pose_m, v3(0.0, 0.0, 1.0), clampf(-c.pull_side * LEAN_SIDE, -LEAN_MOST,
        LEAN_MOST));
    mat_rotate(pose_m, v3(1.0, 0.0, 0.0), clampf(-c.pull_along * LEAN_ALONG, -LEAN_MOST,
        LEAN_MOST));
    put_part(PART_BODY);
    radius: f32 = pose_shape(car_wheel_r);
    ground: f32 = car_y(c);
    for k in 0..4 {
        along: f32 = pose_shape(car_axle);
        if (k >= 2) along = -along;
        across: f32 = -pose_shape(car_wheel_x);
        if (k % 2 == 1) across = -across;
        w: V3 = v_madd(v_madd(p, f, along), r, across);
        w.y = p.y + (c.wheel_y[k] - ground) * down + radius;
        mat_frame(pose_m, left, up, nose, w);
        // (The front wheels are shown turned more than, at speed, they
        // are: it is so little then.)
        if (k < 2) mat_rotate(pose_m, v3(0.0, 1.0, 0.0), -(c.turned * 0.6 + c.steer * 0.16));
        mat_rotate(pose_m, v3(1.0, 0.0, 0.0), c.rolled / car_wheel_r[c.kind]);
        put_part(PART_WHEEL)
    }
}

// ---- on the map ----
// The cars as the map shows them (see hud.l8): where each is, its kind, and
// which it is: a ghost, another car, or the player's own.
const MAX_DOTS: int = 32;

const DOT_GHOST: int = 0;

const DOT_OTHER: int = 1;

const DOT_ME: int = 2;

dot_x: []f32 = new f32[MAX_DOTS](0.0);

dot_z: []f32 = new f32[MAX_DOTS](0.0);

dot_kind: []int = new int[MAX_DOTS](0);

dot_how: []int = new int[MAX_DOTS](0);

ndots: int = 0;

// No car is on it yet.
map_none() {
    ndots = 0
}

// A car of a kind is at p.
map_put(p: V3, kind: int, how: int) {
    if (ndots >= MAX_DOTS) return;
    dot_x[ndots] = p.x;
    dot_z[ndots] = p.z;
    dot_kind[ndots] = kind;
    dot_how[ndots] = how;
    ndots = ndots + 1
}
