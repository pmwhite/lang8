tag race;

use_tag std;

use_tag gl;

use_tag skate;

// Drawing: the canyon lit by an afternoon sun, with a shadow map that
// follows the car; the car; and the sky, which the walls fade into as they
// rise. Lighting is done in linear color, tone mapped and gamma corrected
// at the end.
const SHADOW_SIZE: int = 2048;

const SHADOW_HALF: f32 = 64.0;

type Renderer = {
    world: int;
    shadow: int;
    sky: int;
    u_vp: int;
    u_model: int;
    u_light: int;
    u_sun: int;
    u_cam: int;
    u_texel: int;
    u_blob: int;
    u_blob_way: int;
    u_lap: int;
    u_road: int;
    u_fade: int;
    u_ghost: int;
    u_shadow_map: int;
    u_smvp: int;
    u_morph: int;
    u_smorph: int;
    u_cam_f: int;
    u_cam_r: int;
    u_cam_u: int;
    u_tan: int;
    u_shift: int;
    u_sky_sun: int;
    u_world_sky_sun: int;
    u_time: int;
    u_world_time: int;
    u_world_noise: int;
    u_sky_noise: int;
    noise_tex: u32;
    world_buf: u32;
    world_n: int;
    part_buf: u32;
    sky_buf: u32;
    shadow_tex: u32;
    shadow_fbo: u32;
    hud: int;
    u_hud_screen: int;
    u_hud_offset: int;
    u_hud_color: int;
    hud_buf: u32;
    // The tyre marks (see marks.l8).
    mark: int;
    u_mark_vp: int;
    u_mark_cam: int;
    mark_buf: u32;
    // The look's uniforms, LOOK_UNIFORMS for each of the world and sky
    // programs.
    u_look: []int
}

screen_w: int = 1200;

screen_h: int = 720;

die(msg: str) raises IoError: noreturn {
    eprint(msg);
    exit(1)
}

extern exit(code: int): noreturn;

compile_shader(kind: int, src: []i8) raises IoError: int {
    sh: int = glCreateShader(kind);
    sp: *i8 = src;
    ln: []i32 = new i32[1](len(src) trunc i32);
    glShaderSource(sh, 1, &sp, ln);
    glCompileShader(sh);
    st: []i32 = new i32[1](0i32);
    glGetShaderiv(sh, 35713, st);
    if (st[0] == 0i32) {
        logn: []i32 = new i32[1](0i32);
        glGetShaderiv(sh, 35716, logn);
        n: int = logn[0] as int;
        if (n < 1) n = 1;
        if (n > 4096) n = 4096;
        buf: []i8 = new i8[n](0i8);
        glGetShaderInfoLog(sh, n, null, buf);
        write_bytes_n(2, buf, n);
        write(2, "\n");
        die("shader compile failed")
    }
    sh
}

link_program(vs: []i8, fs: []i8) raises IoError: int {
    prog: int = glCreateProgram();
    glAttachShader(prog, compile_shader(35633, vs));
    glAttachShader(prog, compile_shader(35632, fs));
    glBindAttribLocation(prog, 0, "pos");
    glBindAttribLocation(prog, 1, "nrm");
    glBindAttribLocation(prog, 2, "vcol");
    glBindAttribLocation(prog, 3, "vuv");
    glBindAttribLocation(prog, 4, "pos2");
    glBindAttribLocation(prog, 5, "nrm2");
    glBindAttribLocation(prog, 6, "vcol2");
    glLinkProgram(prog);
    st: []i32 = new i32[1](0i32);
    glGetProgramiv(prog, 35714, st);
    if (st[0] == 0i32) die("program link failed");
    prog
}

// What the world's and the sky's shaders share: the sky's color toward d
// (the distance fades to it, and so do the walls, upward), the light, the
// air, and the grade.
SKY_GLSL: str = """
uniform vec3 sky_sun;
uniform float time;
// The look (see Look): the sky overhead, at the horizon away from the sun
// and toward it, and the sun's glow low down; the sun's light, and the
// sky's from above and below; the air (how thick per meter, and at most);
// the grade (exposure by channel, and color after the curve); and the
// sun's disc.
uniform vec3 look_zenith;
uniform vec3 look_away;
uniform vec3 look_toward;
uniform vec3 look_glow;
uniform vec3 look_sun;
uniform vec3 look_sky_up;
uniform vec3 look_sky_down;
uniform vec2 look_haze;
uniform vec4 look_grade;
uniform vec3 look_disc;
// Smooth value noise with one lattice cell per unit, from a tiling texture.
uniform sampler2D noise_map;
float vnoise(vec2 p) { return texture2D(noise_map, p * 0.015625).r; }
// The sky without its clouds or the sun.
vec3 sky_base(vec3 d) {
  float up = clamp(d.y, 0.0, 1.0);
  vec2 flat_d = d.xz + vec2(0.0001, 0.0);
  float toward = dot(normalize(flat_d), normalize(sky_sun.xz)) * 0.5 + 0.5;
  float t2 = toward * toward;
  vec3 horizon = mix(look_away, look_toward, t2);
  vec3 c = mix(horizon, look_zenith, pow(up, 0.45));
  c += look_glow * t2 * t2 * exp(-up * 8.0);
  c = mix(c, horizon * 0.8, clamp(-d.y * 3.0, 0.0, 1.0));
  return c;
}
float clouds(vec2 p) {
  float v = 0.0;
  float a = 0.5;
  for (int i = 0; i < 4; i++) {
    v += a * vnoise(p);
    p = p * 2.03 + vec2(1.7, 9.2);
    a *= 0.5;
  }
  return v;
}
// All of it: the sun and its glow, and soft clouds drifting, lit warm on
// the sun's side, lilac in their shade.
vec3 sky_full(vec3 d) {
  vec3 c = sky_base(d);
  float s = max(dot(d, sky_sun), 0.0);
  float s2 = s * s;
  c += look_disc * (s2 * s2 * s2 * 0.3 + pow(s, 400.0) * 3.0);
  if (d.y > 0.0) {
    vec2 p = d.xz / (d.y + 0.1) * 0.9 + vec2(time * 0.01, time * 0.003);
    float k = smoothstep(0.5, 0.7, clouds(p));
    float shade = clouds(p + sky_sun.xz * 0.12);
    float toward = max(dot(normalize(d.xz + vec2(0.0001, 0.0)), normalize(sky_sun.xz)), 0.0);
    toward *= toward;
    vec3 lit = mix(vec3(1.0, 0.97, 0.98), vec3(1.15, 0.97, 0.84), toward);
    vec3 cloud = mix(lit, vec3(0.76, 0.74, 0.88), smoothstep(0.45, 0.72, shade));
    c = mix(c, cloud, k * smoothstep(0.0, 0.2, d.y) * 0.8);
  }
  return c;
}
#define SUN_LIGHT look_sun
vec3 sky_light(vec3 n) {
  return mix(look_sky_down, look_sky_up, n.y * 0.5 + 0.5);
}
// Farther off, things fade into the sky's color: little near, more far.
vec3 haze(vec3 col, vec3 V, float dist) {
  if (dist <= 30.0) return col;
  float f = 1.0 - exp(-(dist - 30.0) * look_haze.x);
  return mix(col, sky_base(-V) * 0.95, f * look_haze.y);
}
vec3 tone(vec3 c) {
  c *= look_grade.rgb;
  c = (c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14);
  float l = dot(c, vec3(0.3, 0.55, 0.15));
  c = mix(vec3(l), c, look_grade.a);
  return pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2));
}
""";

// (A car changing from one kind to another has each corner twice: as it is
// in the one, and (pos2, nrm2, vcol2) as it is in the other, and is drawn
// `morph` of the way between. Nothing else has the second: its morph is 0.)
WORLD_VS: str = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec4 vcol;
attribute vec2 vuv;
attribute vec3 pos2;
attribute vec3 nrm2;
attribute vec4 vcol2;
uniform mat4 vp;
uniform mat4 model;
uniform mat4 light_vp;
uniform float morph;
varying vec3 vworld;
varying vec3 vnrm;
varying vec4 vcolor;
varying vec4 vlight;
varying vec2 vst;
void main() {
  vec3 p = pos;
  vec3 n = nrm;
  vcolor = vcol;
  if (morph > 0.0) {
    p = mix(pos, pos2, morph);
    n = mix(nrm, nrm2, morph);
    vcolor.rgb = mix(vcol.rgb, vcol2.rgb, morph);
  }
  vec4 w = model * vec4(p, 1.0);
  vworld = w.xyz;
  vnrm = mat3(model[0].xyz, model[1].xyz, model[2].xyz) * n;
  vst = vuv;
  // (Looked up in the shadow map from a little off the surface, so that
  // the surface does not shadow itself.)
  vlight = light_vp * vec4(w.xyz + normalize(vnrm) * 0.1, 1.0);
  gl_Position = vp * w;
}
""";

WORLD_FS: str = """
uniform sampler2DShadow shadow_map;
uniform vec3 sun_dir;
uniform vec3 cam_pos;
uniform float shadow_texel;
// The car: where it is, and the way it points across the ground.
uniform vec3 blob;
uniform vec2 blob_way;
// The lap's length, for the start line.
uniform float lap_len;
// How high the walls start to fade into the sky, and are gone.
uniform vec2 rock_fade;
// How much of a ghost shows (see ghost.l8): 0, for all that is no ghost.
uniform float ghost;
varying vec3 vworld;
varying vec3 vnrm;
varying vec4 vcolor;
varying vec4 vlight;
varying vec2 vst;

float sun_visibility(float ndl) {
  vec3 sc = vlight.xyz / vlight.w * 0.5 + 0.5;
  if (sc.x < 0.002 || sc.x > 0.998 || sc.y < 0.002 || sc.y > 0.998 || sc.z > 1.0) return 1.0;
  float bias = 0.0004 + 0.0012 * (1.0 - clamp(ndl, 0.0, 1.0));
  float t = shadow_texel;
  float v = shadow2D(shadow_map, vec3(sc.xy, sc.z - bias)).r * 0.36;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(t, 0.0), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy - vec2(t, 0.0), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(0.0, t), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy - vec2(0.0, t), sc.z - bias)).r * 0.16;
  // Fade out toward the map's edge.
  vec2 e = abs(sc.xy - 0.5) * 2.0;
  return mix(v, 1.0, smoothstep(0.7, 0.95, max(e.x, e.y)));
}

// A painted line of half width w about x = 0, x changing by px from one
// pixel to the next: its edges smooth, and no brighter far off, where it is
// finer than a pixel, than the paint there is of it.
float line(float x, float w, float px) {
  return (1.0 - smoothstep(w - px, w + px, abs(x))) * min(1.0, 1.4 * w / px);
}

// Half the road's width (ROAD_HALF, in track.l8).
uniform float road_half;
#define ROAD_HALF road_half

void main() {
  vec3 n = normalize(vnrm);
  // Ambient occlusion rides in the normal's length (see mesh.l8).
  float ao = clamp(length(vnrm), 0.0, 1.0);
  float mat = vcolor.a;
  vec3 to_cam = cam_pos - vworld;
  float dist = length(to_cam);
  vec3 V = to_cam / dist;
  vec3 albedo = vec3(0.0);
  float spec = 0.0;
  float gloss = 8.0;
  // Light wraps a little round everything, for a soft look.
  float wrap = 0.25;
  float ground = 0.0;
  float fade = 0.0;
  float mirror = 0.0;
  vec2 xz = vworld.xz;
  float near = 1.0 - smoothstep(30.0, 70.0, dist);
  if (mat < 0.5) {
    // The canyon's floor, by where it is on the track: d out from the
    // road's middle, s along the lap.
    float d = vst.x;
    float s = vst.y;
    float ad = abs(d);
    float pd = max(fwidth(d), 0.0005);
    float ps = max(fwidth(s), 0.0005);
    // Grass: soft, in broad patches a little yellower or deeper, and mown
    // in bands across the way.
    float big = vnoise(xz * 0.07);
    float mid = vnoise(xz * 0.4 + 7.0);
    vec3 grass = vec3(0.078, 0.175, 0.042) * (0.9 + 0.14 * big + 0.06 * mid);
    grass = mix(grass, grass * vec3(1.15, 1.08, 0.75), smoothstep(0.55, 0.8, mid) * 0.4);
    float band = smoothstep(-0.3, 0.3, (abs(fract(s / 12.0) - 0.5) - 0.25) * 12.0);
    grass *= 0.95 + 0.1 * band;
    // Sand: pale, rippled; its edge ragged.
    float edge = vcolor.r + (vnoise(xz * 0.9 + 3.0) - 0.5) * 0.9;
    float sand = smoothstep(-0.12, 0.12, edge);
    float ripple = sin((xz.x * 0.8 + xz.y * 0.6) * 4.0 + vnoise(xz * 0.5) * 9.0);
    vec3 sandc = vec3(0.70, 0.50, 0.21) * (0.95 + 0.08 * vnoise(xz * 1.7)) * (1.0 + 0.035 * ripple * near);
    // (And a darker rim where the grass gives way to it.)
    albedo = mix(grass, sandc, sand) * (1.0 - 0.25 * (1.0 - smoothstep(0.0, 0.5, abs(edge))) * (1.0 - sand));
    // Toward the wall's foot, bare earth and scree.
    float scree = 1.0 - smoothstep(0.6, 3.4, vcolor.g + 2.6 * (vnoise(xz * 0.3 + 31.0) - 0.5));
    vec3 earth = vec3(0.28, 0.155, 0.085) * (0.85 + 0.3 * vnoise(xz * 1.1));
    albedo = mix(albedo, earth, scree);
    wrap = 0.4;
    // The road's shoulder: worn dirt, thinning out.
    float worn = 1.0 - smoothstep(ROAD_HALF + 0.2, ROAD_HALF + 1.0 + 0.9 * vnoise(xz * 0.6), ad);
    albedo = mix(albedo, vec3(0.2, 0.155, 0.09) * (0.9 + 0.2 * mid), worn * 0.75);
    // The road: dark and fine-grained, in broad patches lighter and darker,
    // worn smooth along its middle.
    float road = 1.0 - smoothstep(ROAD_HALF - pd, ROAD_HALF + pd, ad);
    if (road > 0.0) {
      vec3 tar = vec3(0.082, 0.082, 0.092) * (0.9 + 0.2 * vnoise(xz * 0.21));
      float grit = vnoise(xz * 37.0) * 0.6 + vnoise(xz * 83.0 + 3.0) * 0.4;
      tar *= mix(1.0, 0.8 + 0.4 * grit, near);
      tar *= 1.0 + 0.1 * (1.0 - smoothstep(0.5, 3.5, ad));
      // Its lines: one along each edge, dashes down the middle, and the
      // start line's chequers.
      float paint = line(ad - (ROAD_HALF - 0.42), 0.09, pd);
      float dash = 1.0 - smoothstep(1.75 - ps, 1.75 + ps, abs(fract(s / 9.0) - 0.5) * 9.0);
      paint = max(paint, line(d, 0.08, pd) * dash);
      vec3 white = vec3(0.86, 0.85, 0.8);
      float sr = s < lap_len * 0.5 ? s : s - lap_len;
      if (abs(sr) < 1.0 + ps) {
        float on = 1.0 - smoothstep(1.0 - ps, 1.0 + ps, abs(sr));
        float chequer = mod(floor(sr) + floor(d), 2.0);
        tar = mix(tar, mix(vec3(0.03), white, chequer), on);
        paint = 0.0;
      }
      tar = mix(tar, white, paint * 0.9);
      albedo = mix(albedo, tar, road);
      wrap = mix(wrap, 0.25, road);
      spec = 0.04 * road;
      gloss = 12.0;
    }
    ground = 1.0;
  } else if (mat < 2.5) {
    // The walls: rock in layers, each a band of its own color, a little
    // wavy; they fade into the sky as they rise, and have no top.
    float h = vworld.y - vst.x;
    fade = smoothstep(rock_fade.x, rock_fade.y, h);
    if (fade > 0.995) {
      // (Looked down on over the walls, or flown over while they melt,
      // what is behind them shows.)
      if (rock_fade.y < 80.0) discard;
      gl_FragColor = vec4(tone(sky_full(-V)), 1.0);
      return;
    }
    float lay = vworld.y * 0.42 + 2.2 * vnoise(xz * 0.035);
    float broad = vnoise(vec2(lay, 3.7));
    float fine = vnoise(vec2(lay * 3.7, 11.1));
    albedo = mix(vec3(0.47, 0.2, 0.09), vec3(0.72, 0.42, 0.2), smoothstep(0.3, 0.7, broad));
    albedo = mix(albedo, vec3(0.3, 0.1, 0.055), smoothstep(0.62, 0.8, fine) * 0.55);
    albedo *= vcolor.rgb * (0.9 + 0.2 * vnoise(vec2(xz.x + xz.y, vworld.y * 1.3) * 1.1));
    // Darker at its foot.
    albedo *= mix(0.72, 1.0, smoothstep(0.0, 3.5, h));
    wrap = 0.35;
  } else {
    albedo = pow(vcolor.rgb, vec3(2.2));
    if (mat < 4.5) {
      // Metal.
      spec = 0.35;
      gloss = 40.0;
    } else if (mat < 5.5) {
      // The car's paint: soft, with a sheen.
      wrap = 0.35;
      spec = 0.22;
      gloss = 28.0;
    } else if (mat < 6.5) {
      // Glass: dark, and the sky in it.
      spec = 0.9;
      gloss = 90.0;
      mirror = 0.3;
    } else if (mat < 7.5) {
      spec = 0.06;
      gloss = 20.0;
    } else if (mat < 8.5) {
      // Rubber.
      wrap = 0.2;
    } else if (mat < 9.5) {
      // Leaves: lumpy color, light coming through.
      albedo *= 0.85 + 0.3 * vnoise(vworld.xz * 2.3 + vworld.y * 3.0);
      wrap = 0.5;
    }
  }
  float ndl = dot(n, sun_dir);
  float diff = max((ndl + wrap) / (1.0 + wrap), 0.0);
  float soft = (mat > 4.5 && mat < 5.5) ? 1.0 : 0.0;
  // (What faces away from the sun gets none of its light, in shadow or
  // out: but for the car, whose rim the sun lights from behind.)
  float vis = 0.0;
  if (diff > 0.0 || soft > 0.5) vis = sun_visibility(ndl);
  vec3 sky = sky_light(n) * ao;
  // The ground is darker close under the car.
  if (ground > 0.5) {
    vec2 q = vworld.xz - blob.xz;
    if (dot(q, q) < 9.0) {
      vec2 local = vec2(q.x * blob_way.y - q.y * blob_way.x, dot(q, blob_way));
      float under = 1.0 - smoothstep(0.55, 1.2, length(local / vec2(0.95, 1.7)));
      sky *= 1.0 - 0.55 * under * (1.0 - smoothstep(0.0, 1.0, abs(vworld.y - blob.y)));
    }
  }
  vec3 col = albedo * (SUN_LIGHT * diff * vis * (0.6 + 0.4 * ao) + sky);
  if (mat > 9.5) col = albedo * 2.2;
  // Along the car's edges, a rim: of the sun when it is behind it, and of
  // the sky.
  if (soft > 0.5) {
    float rim = pow(1.0 - max(dot(n, V), 0.0), 3.0);
    col += (SUN_LIGHT * 0.4 * max(dot(-V, sun_dir), 0.0) * vis + look_sky_up * 0.5) * rim;
  }
  if (mirror > 0.0) {
    float glance = pow(1.0 - max(dot(n, V), 0.0), 2.0);
    col += sky_base(reflect(-V, n)) * mirror * (0.35 + 0.65 * glance);
  }
  if (spec > 0.0 && vis > 0.0 && ndl >= 0.0) {
    vec3 H = normalize(sun_dir + V);
    col += SUN_LIGHT * vis * spec * pow(max(dot(n, H), 0.0), gloss) * (gloss + 8.0) / 60.0;
  }
  col = haze(col, V, dist);
  if (fade > 0.0) col = mix(col, sky_full(-V), fade);
  // A ghost is pale and cool, and seen through, least at its edges.
  if (ghost > 0.0) {
    float l = dot(col, vec3(0.3, 0.55, 0.15));
    col = mix(vec3(l) * vec3(0.85, 0.97, 1.15) + 0.12, col, 0.35);
    float edge = pow(1.0 - max(dot(n, V), 0.0), 2.0);
    gl_FragColor = vec4(tone(col), ghost * (0.6 + 0.4 * edge));
    return;
  }
  gl_FragColor = vec4(tone(col), 1.0);
}
""";

HUD_VS: str = """
#version 120
attribute vec2 pos;
uniform vec2 screen;
uniform vec2 offset;
void main() {
  vec2 p = pos + offset;
  gl_Position = vec4(p.x / screen.x * 2.0 - 1.0, 1.0 - p.y / screen.y * 2.0, 0.0, 1.0);
}
""";

HUD_FS: str = """
#version 120
uniform vec4 color;
void main() {
  gl_FragColor = color;
}
""";

// Tyre marks (see marks.l8): dark over the road, as dark as each corner
// says, fading out far off.
MARK_VS: str = """
#version 120
attribute vec4 pos;
uniform mat4 vp;
uniform vec3 cam_pos;
varying float vdark;
void main() {
  vdark = pos.w * (1.0 - smoothstep(70.0, 160.0, distance(cam_pos, pos.xyz)));
  gl_Position = vp * vec4(pos.xyz, 1.0);
}
""";

MARK_FS: str = """
#version 120
varying float vdark;
void main() {
  gl_FragColor = vec4(0.03, 0.03, 0.035, vdark);
}
""";

// Into the shadow map: everything but the canyon's floor (which is left
// out of the drawing: see draw_scene), and of the walls, only their feet
// (see WALL_CAST, in world.l8).
SHADOW_VS: str = """
#version 120
attribute vec3 pos;
attribute vec4 vcol;
attribute vec2 vuv;
attribute vec3 pos2;
uniform mat4 mvp;
uniform float morph;
void main() {
  vec3 p = pos;
  if (morph > 0.0) p = mix(pos, pos2, morph);
  if (vcol.a > 1.5 && vcol.a < 2.5) p.y = min(p.y, vuv.y);
  gl_Position = mvp * vec4(p, 1.0);
}
""";

SHADOW_FS: str = """
#version 120
void main() {
  gl_FragColor = vec4(1.0);
}
""";

SKY_VS: str = """
#version 120
attribute vec3 pos;
varying vec2 vscreen;
void main() {
  vscreen = pos.xy;
  // (As far off as anything can be: it is drawn last, where nothing else
  // has been.)
  gl_Position = vec4(pos.xy, 1.0, 1.0);
}
""";

SKY_FS: str = """
uniform vec3 cam_f;
uniform vec3 cam_r;
uniform vec3 cam_u;
uniform vec2 tan_half;
uniform float shift;
varying vec2 vscreen;
void main() {
  vec3 d = normalize(cam_f + vscreen.x * tan_half.x * cam_r + (vscreen.y - shift) * tan_half.y * cam_u);
  gl_FragColor = vec4(tone(sky_full(d)), 1.0);
}
""";

// GLSL source with a shared prelude after its version line.
with_prelude(src: str): []i8@new {
    head: str = "#version 120\n";
    out: []i8 = new i8[len(head) + len(SKY_GLSL) + len(src)](0i8);
    n: int = 0;
    for c in head {
        out[n] = c;
        n = n + 1
    }
    for c in SKY_GLSL {
        out[n] = c;
        n = n + 1
    }
    for c in src {
        out[n] = c;
        n = n + 1
    }
    out
}

gen_buffer(): u32 {
    ids: []u32 = new u32[1](0u32);
    glGenBuffers(1, ids);
    ids[0]
}

upload(buf: u32, m: *Mesh) {
    glBindBuffer(34962, buf);
    glBufferData(34962, m.n * VERTEX_FLOATS * 4, m.data, 35044)
}

bind_vertices(buf: u32) {
    glBindBuffer(34962, buf);
    glVertexAttribPointer(0, 3, 5126, 0, VERTEX_FLOATS * 4, 0);
    glVertexAttribPointer(1, 3, 5126, 0, VERTEX_FLOATS * 4, 12);
    glVertexAttribPointer(2, 4, 5126, 0, VERTEX_FLOATS * 4, 24);
    glVertexAttribPointer(3, 2, 5126, 0, VERTEX_FLOATS * 4, 40)
}

new_renderer(world_mesh: *Mesh, parts: *Mesh) raises IoError: *Renderer@new {
    world: int = link_program(bytes(WORLD_VS), with_prelude(WORLD_FS));
    shadow: int = link_program(bytes(SHADOW_VS), bytes(SHADOW_FS));
    sky: int = link_program(bytes(SKY_VS), with_prelude(SKY_FS));
    hud: int = link_program(bytes(HUD_VS), bytes(HUD_FS));
    mark: int = link_program(bytes(MARK_VS), bytes(MARK_FS));
    va: []u32 = new u32[1](0u32);
    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    for i in 0..4 glEnableVertexAttribArray(i);
    r: *Renderer = new Renderer {
        world: world,
        shadow: shadow,
        sky: sky,
        u_vp: glGetUniformLocation(world, "vp"),
        u_model: glGetUniformLocation(world, "model"),
        u_light: glGetUniformLocation(world, "light_vp"),
        u_sun: glGetUniformLocation(world, "sun_dir"),
        u_cam: glGetUniformLocation(world, "cam_pos"),
        u_texel: glGetUniformLocation(world, "shadow_texel"),
        u_blob: glGetUniformLocation(world, "blob"),
        u_blob_way: glGetUniformLocation(world, "blob_way"),
        u_lap: glGetUniformLocation(world, "lap_len"),
        u_road: glGetUniformLocation(world, "road_half"),
        u_fade: glGetUniformLocation(world, "rock_fade"),
        u_ghost: glGetUniformLocation(world, "ghost"),
        u_shadow_map: glGetUniformLocation(world, "shadow_map"),
        u_smvp: glGetUniformLocation(shadow, "mvp"),
        u_morph: glGetUniformLocation(world, "morph"),
        u_smorph: glGetUniformLocation(shadow, "morph"),
        u_cam_f: glGetUniformLocation(sky, "cam_f"),
        u_cam_r: glGetUniformLocation(sky, "cam_r"),
        u_cam_u: glGetUniformLocation(sky, "cam_u"),
        u_tan: glGetUniformLocation(sky, "tan_half"),
        u_shift: glGetUniformLocation(sky, "shift"),
        u_sky_sun: glGetUniformLocation(sky, "sky_sun"),
        u_world_sky_sun: glGetUniformLocation(world, "sky_sun"),
        u_time: glGetUniformLocation(sky, "time"),
        u_world_time: glGetUniformLocation(world, "time"),
        u_world_noise: glGetUniformLocation(world, "noise_map"),
        u_sky_noise: glGetUniformLocation(sky, "noise_map"),
        noise_tex: make_noise_texture(),
        world_buf: gen_buffer(),
        world_n: world_mesh.n,
        part_buf: gen_buffer(),
        sky_buf: gen_buffer(),
        shadow_tex: 0u32,
        shadow_fbo: 0u32,
        hud: hud,
        u_hud_screen: glGetUniformLocation(hud, "screen"),
        u_hud_offset: glGetUniformLocation(hud, "offset"),
        u_hud_color: glGetUniformLocation(hud, "color"),
        hud_buf: gen_buffer(),
        mark: mark,
        u_mark_vp: glGetUniformLocation(mark, "vp"),
        u_mark_cam: glGetUniformLocation(mark, "cam_pos"),
        mark_buf: gen_buffer(),
        u_look: new int[2 * LOOK_UNIFORMS](0)
    };
    progs: []int = [world, sky];
    for k in 0..2 {
        for u in 0..LOOK_UNIFORMS r.u_look[k * LOOK_UNIFORMS + u] = glGetUniformLocation(progs[k],
            look_names[u])
    }
    upload(r.world_buf, world_mesh);
    glBindBuffer(34962, r.mark_buf);
    glBufferData(34962, MAX_MARKS * MARK_FLOATS * 4, mark_data, 35048);
    upload(r.part_buf, parts);
    tri: []f32 = new f32[3 * VERTEX_FLOATS](0.0);
    tri[0] = -1.0;
    tri[1] = -1.0;
    tri[VERTEX_FLOATS] = 3.0;
    tri[VERTEX_FLOATS + 1] = -1.0;
    tri[2 * VERTEX_FLOATS] = -1.0;
    tri[2 * VERTEX_FLOATS + 1] = 3.0;
    glBindBuffer(34962, r.sky_buf);
    glBufferData(34962, 3 * VERTEX_FLOATS * 4, tri, 35044);
    stex: []u32 = new u32[1](0u32);
    glGenTextures(1, stex);
    glBindTexture(3553, stex[0]);
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 34892, 34894);
    glTexParameteri(3553, 34893, 515);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 33190, SHADOW_SIZE, SHADOW_SIZE, 0, 6402, 5125, null);
    fbo: []u32 = new u32[1](0u32);
    glGenFramebuffers(1, fbo);
    glBindFramebuffer(36160, fbo[0]);
    glFramebufferTexture2D(36160, 36096, 3553, stex[0], 0);
    glDrawBuffer(0);
    glReadBuffer(0);
    if (glCheckFramebufferStatus(36160) != 36053) die("shadow framebuffer incomplete");
    glBindFramebuffer(36160, 0u32);
    r.shadow_tex = stex[0];
    r.shadow_fbo = fbo[0];
    glEnable(2929);
    r
}

// Value noise for the shaders: a 64-cell lattice of random values over 256
// texels, smoothly interpolated, wrapping, with its mipmaps so distant
// detail does not shimmer.
const NOISE_SIZE: int = 256;

const NOISE_CELLS: int = 64;

make_noise_texture(): u32 {
    lattice: []f32 = new f32[NOISE_CELLS * NOISE_CELLS](0.0);
    rng: int = 99991;
    for i in 0..NOISE_CELLS * NOISE_CELLS {
        rng = (rng * 1103515245 + 12345) % 2147483648;
        if (rng < 0) rng = -rng;
        lattice[i] = (rng / 65536 % 32768) as f32 / 32767.0
    }
    level: []i8 = new i8[NOISE_SIZE * NOISE_SIZE](0i8);
    k: int = NOISE_SIZE / NOISE_CELLS;
    for y in 0..NOISE_SIZE {
        for x in 0..NOISE_SIZE {
            cx: int = x / k;
            cy: int = y / k;
            fx: f32 = (x % k) as f32 / k as f32;
            fy: f32 = (y % k) as f32 / k as f32;
            fx = fx * fx * (3.0 - 2.0 * fx);
            fy = fy * fy * (3.0 - 2.0 * fy);
            x1: int = (cx + 1) % NOISE_CELLS;
            y1: int = (cy + 1) % NOISE_CELLS;
            a: f32 = lerpf(lattice[cy * NOISE_CELLS + cx], lattice[cy * NOISE_CELLS + x1],
                fx);
            b: f32 = lerpf(lattice[y1 * NOISE_CELLS + cx], lattice[y1 * NOISE_CELLS + x1],
                fx);
            level[y * NOISE_SIZE + x] = (lerpf(a, b, fy) * 255.0) as int trunc i8
        }
    }
    tex: []u32 = new u32[1](0u32);
    glGenTextures(1, tex);
    glBindTexture(3553, tex[0]);
    glPixelStorei(3317, 1);
    glTexParameteri(3553, 10241, 9987);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 10497);
    glTexParameteri(3553, 10243, 10497);
    size: int = NOISE_SIZE;
    lod: int = 0;
    next: []i8 = new i8[NOISE_SIZE * NOISE_SIZE / 4](0i8);
    while (size >= 1) {
        glTexImage2D(3553, lod, 6409, size, size, 0, 6409, 5121, level);
        if (size > 1) {
            half: int = size / 2;
            for y in 0..half {
                for x in 0..half {
                    sum: int = byte_value(level[2 * y * size + 2 * x]) + byte_value(level[2 * y * size + 2 * x + 1]) + byte_value(level[(2 * y + 1) * size + 2 * x]) + byte_value(level[(2 * y + 1) * size + 2 * x + 1]);
                    next[y * half + x] = (sum / 4) trunc i8
                }
            }
            for i in 0..half * half level[i] = next[i]
        }
        size = size / 2;
        lod = lod + 1
    }
    tex[0]
}

byte_value(b: i8): int {
    v: int = b as int;
    if (v < 0) v = v + 256;
    v
}

// What a frame needs from the game.
type View = {
    eye: V3;
    at: V3;
    up: V3;
    fovy: f32;
    // How far up the picture moves, in screen heights times two (so that
    // what the camera looks at sits above the middle).
    shift: f32;
    // What the picture is of (the shadows are worked out round it); and the
    // car: where it is, and the way it points.
    focus: V3;
    car: V3;
    car_way: V3;
    time: f32;
    // How high the walls start to fade into the sky, and are gone (see
    // MAT_ROCK): low, to look down on the track over them.
    fade_from: f32;
    fade_to: f32;
    // The sample of the track that the car is at, to draw only what is near
    // it along the track; or -1, to draw it all.
    near: int
}

// ---- the light ----
type Look = {
    sun: V3;
    sun_light: V3;
    sky_up: V3;
    sky_down: V3;
    zenith: V3;
    away: V3;
    toward: V3;
    glow: V3;
    haze: f32;
    haze_max: f32;
    grade: V3;
    sat: f32;
    disc: V3
}

const LOOK_UNIFORMS: int = 10;

look_names: []str = ["look_zenith", "look_away", "look_toward", "look_glow", "look_sun",
    "look_sky_up", "look_sky_down", "look_haze", "look_grade", "look_disc"];

// A clear afternoon: the sun well up, warm; a blue sky, paler and warmer
// toward the horizon; the air a little hazy down the canyon.
look: Look = Look {
    sun: v3(0.5, 0.66, -0.56),
    sun_light: v3(2.5, 2.2, 1.78),
    sky_up: v3(0.27, 0.36, 0.58),
    sky_down: v3(0.3, 0.25, 0.2),
    zenith: v3(0.15, 0.33, 0.74),
    away: v3(0.62, 0.74, 0.92),
    toward: v3(1.0, 0.86, 0.74),
    glow: v3(0.3, 0.25, 0.18),
    haze: 0.0018,
    haze_max: 0.6,
    grade: v3(0.64, 0.62, 0.58),
    sat: 1.1,
    disc: v3(1.0, 0.88, 0.68)
};

set3(loc: int, v: V3) {
    glUniform3f(loc, v.x, v.y, v.z)
}

// The look into program k's uniforms (k: 0 the world, 1 the sky).
set_look(r: *Renderer, k: int) {
    u: []int = r.u_look;
    b: int = k * LOOK_UNIFORMS;
    set3(u[b], look.zenith);
    set3(u[b + 1], look.away);
    set3(u[b + 2], look.toward);
    set3(u[b + 3], look.glow);
    set3(u[b + 4], look.sun_light);
    set3(u[b + 5], look.sky_up);
    set3(u[b + 6], look.sky_down);
    glUniform2f(u[b + 7], look.haze, look.haze_max);
    glUniform4f(u[b + 8], look.grade.x, look.grade.y, look.grade.z, look.sat);
    set3(u[b + 9], look.disc)
}

view_m: []f32 = new f32[16](0.0);

proj_m: []f32 = new f32[16](0.0);

vp_m: []f32 = new f32[16](0.0);

light_view: []f32 = new f32[16](0.0);

light_proj: []f32 = new f32[16](0.0);

light_vp: []f32 = new f32[16](0.0);

mvp_m: []f32 = new f32[16](0.0);

ident_m: []f32 = new f32[16](0.0);

part_tmp: []f32 = new f32[16](0.0);

// The sun's view: an orthographic box around the focus, moved in whole
// shadow texels so shadows do not crawl as it follows.
fit_shadow(focus: V3) {
    sun: V3 = v_norm(look.sun);
    mat_look(light_view, v_scale(sun, 200.0), v3(0.0, 0.0, 0.0), v3(0.0, 1.0, 0.0));
    c: V3 = mat_point(light_view, focus);
    texel: f32 = 2.0 * SHADOW_HALF / SHADOW_SIZE as f32;
    cx: f32 = floorf(c.x / texel) * texel;
    cy: f32 = floorf(c.y / texel) * texel;
    mat_ortho(light_proj, cx - SHADOW_HALF, cx + SHADOW_HALF, cy - SHADOW_HALF, cy + SHADOW_HALF,
        -c.z - 160.0, -c.z + 160.0);
    mat_mul(light_vp, light_proj, light_view)
}

// The tyre marks, over the road: first the new ones are sent to join the
// rest.
draw_marks(r: *Renderer, view: View) {
    glBindBuffer(34962, r.mark_buf);
    for k in 0..mark_news glBufferSubData(34962, mark_new[k] * MARK_FLOATS * 4, MARK_FLOATS * 4,
        &mark_data[mark_new[k] * MARK_FLOATS]);
    mark_news = 0;
    if (mark_count == 0) return;
    glUseProgram(r.mark);
    glUniformMatrix4fv(r.u_mark_vp, 1, 0, vp_m);
    glUniform3f(r.u_mark_cam, view.eye.x, view.eye.y, view.eye.z);
    glEnable(3042);
    glBlendFunc(770, 771);
    glDepthMask(0);
    glDisableVertexAttribArray(1);
    glDisableVertexAttribArray(2);
    glDisableVertexAttribArray(3);
    glVertexAttribPointer(0, 4, 5126, 0, 16, 0);
    glDrawArrays(4, 0, mark_count * 6);
    glEnableVertexAttribArray(1);
    glEnableVertexAttribArray(2);
    glEnableVertexAttribArray(3);
    glDepthMask(1);
    glDisable(3042)
}

// The cars' parts are about to be drawn (see pose.l8): each corner is given
// twice, as it is in the kind of car it was and in the kind it is to be.
bind_parts() {
    for i in 4..7 glEnableVertexAttribArray(i)
}

unbind_parts() {
    for i in 4..7 glDisableVertexAttribArray(i)
}

// Draw posed part i: of the car that was, each corner with the same corner
// of that part of the car to be, as far between as u_morph is told.
draw_part_between(r: *Renderer, i: int, u_morph: int) {
    part: int = draw_part[i];
    a: int = part_first[draw_from[i] * CAR_PARTS + part] * VERTEX_FLOATS * 4;
    b: int = part_first[draw_to[i] * CAR_PARTS + part] * VERTEX_FLOATS * 4;
    glUniform1f(u_morph, draw_morph[i]);
    glBindBuffer(34962, r.part_buf);
    glVertexAttribPointer(0, 3, 5126, 0, VERTEX_FLOATS * 4, a);
    glVertexAttribPointer(1, 3, 5126, 0, VERTEX_FLOATS * 4, a + 12);
    glVertexAttribPointer(2, 4, 5126, 0, VERTEX_FLOATS * 4, a + 24);
    glVertexAttribPointer(3, 2, 5126, 0, VERTEX_FLOATS * 4, a + 40);
    glVertexAttribPointer(4, 3, 5126, 0, VERTEX_FLOATS * 4, b);
    glVertexAttribPointer(5, 3, 5126, 0, VERTEX_FLOATS * 4, b + 12);
    glVertexAttribPointer(6, 4, 5126, 0, VERTEX_FLOATS * 4, b + 24);
    glDrawArrays(4, 0, part_count[draw_from[i] * CAR_PARTS + part])
}

// How far the picture reaches along the track from the car, ahead and
// behind, in chunks. (No farther than the canyon runs straight: its walls
// hide the rest.)
const CHUNKS_AHEAD: int = 15;

const CHUNKS_BEHIND: int = 4;

// Whether chunk k is near enough along the track to be in the picture.
chunk_near(k: int, view: View): bool {
    if (view.near < 0) return true;
    ahead: int = ((k - view.near / CHUNK) % nchunks + nchunks) % nchunks;
    ahead <= CHUNKS_AHEAD || ahead >= nchunks - CHUNKS_BEHIND
}

// Whether any of chunk k's box could be in the picture that the matrix m
// makes (the camera's, or the sun's): by its sides and its near end. For
// each, the box's corner furthest in is tried: if that is out, all of it
// is.
chunk_in_view(m: []f32, k: int): bool {
    b: int = k * 6;
    for side in 0..5 {
        // w + x, w - x, w + y, w - y, w + z: rows of the matrix.
        row: int = side / 2;
        sign: f32 = 1.0;
        if (side % 2 == 1) sign = -1.0;
        a: f32 = m[3] + sign * m[row];
        bb: f32 = m[7] + sign * m[4 + row];
        c: f32 = m[11] + sign * m[8 + row];
        d: f32 = m[15] + sign * m[12 + row];
        x: f32 = chunk_box[b];
        if (a > 0.0) x = chunk_box[b + 3];
        y: f32 = chunk_box[b + 1];
        if (bb > 0.0) y = chunk_box[b + 4];
        z: f32 = chunk_box[b + 2];
        if (c > 0.0) z = chunk_box[b + 5];
        if (a * x + bb * y + c * z + d < 0.0) return false
    }
    true
}

draw_scene(r: *Renderer, view: View, shadows: bool) {
    mat_identity(ident_m);
    fit_shadow(view.focus);
    glBindFramebuffer(36160, r.shadow_fbo);
    glViewport(0, 0, SHADOW_SIZE, SHADOW_SIZE);
    glClear(256);
    if (shadows) {
        glUseProgram(r.shadow);
        glEnable(32823);
        glPolygonOffset(1.5, 2.0);
        mat_mul(mvp_m, light_vp, ident_m);
        glUniformMatrix4fv(r.u_smvp, 1, 0, mvp_m);
        glUniform1f(r.u_smorph, 0.0);
        // (Of the world, what is near enough to cast a shadow that shows;
        // and none of its floor.)
        bind_vertices(r.world_buf);
        for k in 0..nchunks {
            if (chunk_near(k, view) && chunk_in_view(light_vp, k)) glDrawArrays(4,
                chunk_first[k] + chunk_floor[k], chunk_count[k] - chunk_floor[k])
        }
        bind_parts();
        for i in 0..ndraw {
            for k in 0..16 part_tmp[k] = draw_m[i * 16 + k];
            mat_mul(mvp_m, light_vp, part_tmp);
            glUniformMatrix4fv(r.u_smvp, 1, 0, mvp_m);
            if (!draw_ghost[i]) draw_part_between(r, i, r.u_smorph)
        }
        unbind_parts();
        glDisable(32823)
    }
    glBindFramebuffer(36160, 0u32);
    glViewport(0, 0, screen_w, screen_h);
    glClear(16640);
    aspect: f32 = screen_w as f32 / screen_h as f32;
    mat_persp(proj_m, view.fovy, aspect, 0.2, 3000.0);
    proj_m[9] = -view.shift;
    mat_look(view_m, view.eye, view.at, view.up);
    mat_mul(vp_m, proj_m, view_m);
    sun: V3 = v_norm(look.sun);
    glActiveTexture(33985);
    glBindTexture(3553, r.noise_tex);
    glUseProgram(r.world);
    set_look(r, 0);
    glUniformMatrix4fv(r.u_vp, 1, 0, vp_m);
    glUniformMatrix4fv(r.u_light, 1, 0, light_vp);
    glUniform3f(r.u_sun, sun.x, sun.y, sun.z);
    glUniform3f(r.u_world_sky_sun, sun.x, sun.y, sun.z);
    glUniform3f(r.u_cam, view.eye.x, view.eye.y, view.eye.z);
    glUniform1f(r.u_texel, 1.0 / SHADOW_SIZE as f32);
    glUniform3f(r.u_blob, view.car.x, view.car.y, view.car.z);
    glUniform2f(r.u_blob_way, view.car_way.x, view.car_way.z);
    glUniform1f(r.u_lap, track_len);
    glUniform1f(r.u_road, ROAD_HALF);
    glUniform2f(r.u_fade, view.fade_from, view.fade_to);
    glUniform1f(r.u_world_time, view.time);
    glActiveTexture(33984);
    glBindTexture(3553, r.shadow_tex);
    glUniform1i(r.u_shadow_map, 0);
    glUniform1i(r.u_world_noise, 1);
    glUniformMatrix4fv(r.u_model, 1, 0, ident_m);
    glUniform1f(r.u_morph, 0.0);
    glUniform1f(r.u_ghost, 0.0);
    bind_vertices(r.world_buf);
    for k in 0..nchunks {
        if (chunk_near(k, view) && chunk_in_view(vp_m, k)) glDrawArrays(4, chunk_first[k],
            chunk_count[k])
    }
    draw_marks(r, view);
    glUseProgram(r.world);
    bind_parts();
    for i in 0..ndraw {
        if (!draw_ghost[i]) {
            glUniformMatrix4fv(r.u_model, 1, 0, &draw_m[i * 16]);
            draw_part_between(r, i, r.u_morph)
        }
    }
    unbind_parts();
    glUniform1f(r.u_morph, 0.0);
    // The sky last, and only where nothing else is: at the far end of the
    // depth, which it passes by being no further.
    glDepthMask(0);
    glDepthFunc(515);
    glUseProgram(r.sky);
    f: V3 = v_norm(v_sub(view.at, view.eye));
    rt: V3 = v_norm(v_cross(f, view.up));
    up: V3 = v_cross(rt, f);
    glUniform3f(r.u_cam_f, f.x, f.y, f.z);
    glUniform3f(r.u_cam_r, rt.x, rt.y, rt.z);
    glUniform3f(r.u_cam_u, up.x, up.y, up.z);
    th: f32 = sinf(view.fovy * 0.5) / cosf(view.fovy * 0.5);
    glUniform2f(r.u_tan, th * aspect, th);
    glUniform1f(r.u_shift, view.shift);
    glUniform3f(r.u_sky_sun, sun.x, sun.y, sun.z);
    glUniform1f(r.u_time, view.time);
    set_look(r, 1);
    glUniform1i(r.u_sky_noise, 1);
    bind_vertices(r.sky_buf);
    glDrawArrays(4, 0, 3);
    glDepthFunc(513);
    glDepthMask(1);
    draw_ghosts(r)
}

// The ghosts' parts (see ghost.l8), over everything else, seen through.
// They are drawn twice: first only to find what of each is nearest (its
// color is left as it was), and then, where it is, its color over what was
// there: so that a ghost's far side does not show through its near side.
const GHOST_SHOWS: f32 = 0.55;

draw_ghosts(r: *Renderer) {
    any: bool = false;
    for i in 0..ndraw {
        if (draw_ghost[i]) any = true
    }
    if (!any) return;
    glUseProgram(r.world);
    glUniform1f(r.u_ghost, GHOST_SHOWS);
    bind_parts();
    glEnable(3042);
    for pass in 0..2 {
        if (pass == 0) glBlendFunc(0, 1) else {
            glBlendFunc(770, 771);
            glDepthFunc(515)
        }
        for i in 0..ndraw {
            if (draw_ghost[i]) {
                glUniformMatrix4fv(r.u_model, 1, 0, &draw_m[i * 16]);
                draw_part_between(r, i, r.u_morph)
            }
        }
    }
    glDepthFunc(513);
    glDisable(3042);
    unbind_parts();
    glUniform1f(r.u_morph, 0.0);
    glUniform1f(r.u_ghost, 0.0)
}

// The words over the scene: each run of text with a soft shadow (but for
// a plain shape: see run_plain).
draw_hud(r: *Renderer) {
    build_hud(screen_w);
    if (hud_n == 0) return;
    glDisable(2929);
    glEnable(3042);
    glBlendFunc(770, 771);
    glUseProgram(r.hud);
    glUniform2f(r.u_hud_screen, screen_w as f32, screen_h as f32);
    glBindBuffer(34962, r.hud_buf);
    glBufferData(34962, hud_n * 4, hud_verts, 35048);
    glDisableVertexAttribArray(1);
    glDisableVertexAttribArray(2);
    glDisableVertexAttribArray(3);
    glVertexAttribPointer(0, 2, 5126, 0, 8, 0);
    for i in 0..nruns {
        a: f32 = run_rgba[i * 4 + 3];
        // A soft shadow below, and a fine dark edge to keep its pixels
        // crisp.
        if (!run_plain[i]) {
            glUniform2f(r.u_hud_offset, hud_px * 0.8, hud_px * 0.8);
            glUniform4f(r.u_hud_color, 0.0, 0.0, 0.02, 0.4 * a);
            glDrawArrays(4, run_first[i], run_count[i]);
            o: f32 = maxf(1.0, hud_px * 0.4);
            glUniform4f(r.u_hud_color, 0.03, 0.03, 0.05, 0.6 * a);
            for k in 0..4 {
                t: f32 = TAU * k as f32 / 4.0;
                glUniform2f(r.u_hud_offset, cosf(t) * o, sinf(t) * o);
                glDrawArrays(4, run_first[i], run_count[i])
            }
        }
        glUniform2f(r.u_hud_offset, 0.0, 0.0);
        glUniform4f(r.u_hud_color, run_rgba[i * 4], run_rgba[i * 4 + 1], run_rgba[i * 4 + 2],
            a);
        glDrawArrays(4, run_first[i], run_count[i])
    }
    glEnableVertexAttribArray(1);
    glEnableVertexAttribArray(2);
    glEnableVertexAttribArray(3);
    glDisable(3042);
    glEnable(2929)
}
