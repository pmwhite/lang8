tag race;

use_tag skate;

// Tyre marks. A back wheel that slides sideways on the road leaves a dark
// mark along it, a short stretch at a time; the marks stay, the oldest
// giving way to new ones when there are too many.
//
// A stretch is a flat strip on the road: two triangles, each corner its
// place and how dark it is there.
const MAX_MARKS: int = 3000;

const MARK_FLOATS: int = 24;

mark_data: []f32 = new f32[MAX_MARKS * MARK_FLOATS](0.0);

// Where the next stretch goes, and how many there are.
mark_next: int = 0;

mark_count: int = 0;

// The stretches made since the picture was last drawn (see draw_marks, in
// render.l8, which sends them to be drawn).
const MAX_NEW_MARKS: int = 16;

mark_new: []int = new int[MAX_NEW_MARKS](0);

mark_news: int = 0;

// For each back wheel: whether it is leaving a mark, where the mark has
// come to, and how dark it was there.
mark_live: []bool = new bool[2](false);

mark_last: []V3 = new V3[2](V3 { x: 0.0, y: 0.0, z: 0.0 });

mark_dark: []f32 = new f32[2](0.0);

// How fast a wheel slides sideways before it marks; how long a stretch is;
// and how far off the road's surface it lies.
const MARK_SKID: f32 = 2.5;

const MARK_LONG: f32 = 0.7;

const MARK_UP: f32 = 0.02;

// The car has been put somewhere else: its marks do not go on from where
// it was.
break_marks() {
    mark_live[0] = false;
    mark_live[1] = false
}

mark_corner(at: int, p: V3, dark: f32) {
    mark_data[at] = p.x;
    mark_data[at + 1] = p.y;
    mark_data[at + 2] = p.z;
    mark_data[at + 3] = dark
}

// A stretch from a to b, `wide` across, as dark at each end as given.
put_mark(
    a: V3,
    b: V3,
    wide: f32,
    dark_a: f32,
    dark_b: f32
) {
    across: V3 = v_scale(v_norm(right_of(v_sub(b, a))), wide * 0.5);
    at: int = mark_next * MARK_FLOATS;
    mark_corner(at, v_sub(a, across), dark_a);
    mark_corner(at + 4, v_add(a, across), dark_a);
    mark_corner(at + 8, v_add(b, across), dark_b);
    mark_corner(at + 12, v_sub(a, across), dark_a);
    mark_corner(at + 16, v_add(b, across), dark_b);
    mark_corner(at + 20, v_sub(b, across), dark_b);
    if (mark_news < MAX_NEW_MARKS) {
        mark_new[mark_news] = mark_next;
        mark_news = mark_news + 1
    }
    mark_next = (mark_next + 1) % MAX_MARKS;
    if (mark_count < MAX_MARKS) mark_count = mark_count + 1
}

// The marks the car makes where it is now: once a picture.
tick_marks(c: *Car) {
    dark: f32 = clampf((absf(c.skid) - MARK_SKID) / 8.0, 0.0, 1.0) * 0.5 + 0.2;
    for w in 0..2 {
        k: int = 2 + w;
        if (absf(c.skid) < MARK_SKID || !c.on_road[k]) mark_live[w] = false else {
            p: V3 = wheel_at(c, k);
            p.y = c.wheel_y[k] + MARK_UP;
            if (!mark_live[w]) {
                mark_live[w] = true;
                mark_last[w] = p;
                mark_dark[w] = 0.0
            } else if (v_len(v_sub(p, mark_last[w])) >= MARK_LONG) {
                put_mark(mark_last[w], p, car_wheel_half[c.kind] * 1.7, mark_dark[w],
                    dark);
                mark_last[w] = p;
                mark_dark[w] = dark
            }
        }
    }
}
