tag lemma_ui;

use_tag std, skate, lemma;

// Terms on the screen, as blocks: each subterm a soft rounded block with
// the blocks of its parts inside it, so what a finger can pick is what it
// can see. A term too wide for its place goes on to more lines after a
// binder's dot (∀ε>0. on one line, what is under it on the next), and is
// made smaller if it still does not fit.
//
// Each block is known from one frame to the next by its term and which of
// that term's places it is (the first a in a · a, or the second), so when
// a move changes the goal, the blocks still in it slide to their new
// places, new ones swell in and gone ones fade: the goal morphs.
//
// ---- laid out ----
const BXS: int = 16384;

// Each block: its term; its path (show.l8); the block it is in; how deep;
// its corners, from the term's top left; and the key it is known by.
bx_term: []int = static_buffer(BXS, 0);

bx_path: []int = static_buffer(BXS, 0);

bx_parent: []int = static_buffer(BXS, -1);

bx_depth: []int = static_buffer(BXS, 0);

bx_x0: []f32 = static_buffer(BXS, 0.0);

bx_y0: []f32 = static_buffer(BXS, 0.0);

bx_x1: []f32 = static_buffer(BXS, 0.0);

bx_y1: []f32 = static_buffer(BXS, 0.0);

bx_key: []int = static_buffer(BXS, 0);

bx_n: int = 0;

// Each piece of writing: its block, where its baseline starts (from the
// term's top left), its text, and how it is written.
const RNS: int = 16384;

rn_box: []int = static_buffer(RNS, 0);

rn_x: []f32 = static_buffer(RNS, 0.0);

rn_y: []f32 = static_buffer(RNS, 0.0);

rn_sym: []int = static_buffer(RNS, 0);

rn_style: []int = static_buffer(RNS, 0);

rn_n: int = 0;

// Each term laid out this frame: its blocks and pieces, its size, the
// size of its writing, and the slot it is shown in (what it is on the
// screen: the goal, a hypothesis, a button).
const EXS: int = 512;

ex_box0: []int = static_buffer(EXS, 0);

ex_boxn: []int = static_buffer(EXS, 0);

ex_run0: []int = static_buffer(EXS, 0);

ex_runn: []int = static_buffer(EXS, 0);

ex_w: []f32 = static_buffer(EXS, 0.0);

ex_h: []f32 = static_buffer(EXS, 0.0);

ex_size: []f32 = static_buffer(EXS, 0.0);

ex_slot: []int = static_buffer(EXS, 0);

// Where its notch is (from its top left), if it has one: the name of the
// statement's outermost binder, given room of its own.
ex_nok: []bool = static_buffer(EXS, false);

ex_nx0: []f32 = static_buffer(EXS, 0.0);

ex_nx1: []f32 = static_buffer(EXS, 0.0);

ex_ny0: []f32 = static_buffer(EXS, 0.0);

ex_ny1: []f32 = static_buffer(EXS, 0.0);

// The statement (its term) whose binder's name is laid out as a notch: a
// gap after the binder, a socket the size of a name's ball (0: none).
lay_notch_t: int = 0;

// How wide and tall a notch is at least.
const NOTCH_W: f32 = 46.0;

const NOTCH_H: f32 = 44.0;

// Where it was drawn (its top left), for finding what a finger is on.
ex_ox: []f32 = static_buffer(EXS, 0.0);

ex_oy: []f32 = static_buffer(EXS, 0.0);

ex_n: int = 0;

// All laid out afresh each frame.
boxes_reset() {
    bx_n = 0;
    rn_n = 0;
    ex_n = 0;
    // (Paths are kept for the whole frame: a block's path is how a move
    // finds its place.)
    path_n = 1
}

// How deep the blocks go before they stop getting their own color.
const TINT_DEPTH: int = 6;

lay_size: f32 = 20.0;

lay_pad(): f32 {
    lay_size * 0.17
}

// Whether the block opened at event i is a subscript (its writing small):
// it takes no room of its own.
sub_block(i: int): bool {
    i + 1 < ev_n && ev_kind[i + 1] == EV_TEXT && ev_b[i + 1] == ST_SUB
}

// Whether the block opened at event i is a name alone (its writing, then
// its end).
atom_block(i: int): bool {
    i + 2 < ev_n && ev_kind[i + 1] == EV_TEXT && ev_kind[i + 2] == EV_CLOSE && !compound(ev_a[i])
}

// The line height, and how far each block's top and bottom come in from
// the line's (so blocks inside blocks show).
lay_line_h(): f32 {
    lay_size * 1.62
}

lay_inset(depth: int): f32 {
    minf(depth as f32, 4.0) * lay_size * 0.075
}

// Lay out the printer's events (ev_ from show.l8) as expression e, with
// line breaks at the first `breaks` of the break marks, starting at
// indent 0. Its width.
lay_pass(e: int, breaks: int) {
    bx_n = ex_box0[e];
    rn_n = ex_run0[e];
    pen: f32 = 0.0;
    line_no: int = 0;
    lh: f32 = lay_line_h();
    pad: f32 = lay_pad();
    // (The blocks open now, innermost last.)
    stack_n: int = 0;
    breaks_seen: int = 0;
    pbreaks_seen: int = 0;
    // (How far the pen went past the writing as blocks closed: a ")" next
    // comes in to the writing, not after a gap.)
    close_pad: f32 = 0.0;
    after_paren: bool = false;
    if (sym_lparen == 0) {
        sym_lparen = sym("(");
        sym_rparen = sym(")")
    }
    widest: f32 = 0.0;
    ex_nok[e] = false;
    notch_b: int = -1;
    notch_texts: int = 0;
    for i in 0..ev_n {
        k: int = ev_kind[i];
        if (k == EV_OPEN) {
            if (bx_n < BXS && stack_n < len(lay_stack)) {
                b: int = bx_n;
                if (lay_notch_t != 0 && ev_a[i] == lay_notch_t && notch_b < 0) {
                    notch_b = b;
                    notch_texts = 0
                }
                bx_term[b] = ev_a[i];
                bx_path[b] = ev_b[i];
                bx_parent[b] = -1;
                if (stack_n > 0) bx_parent[b] = lay_stack[stack_n - 1];
                bx_depth[b] = stack_n;
                bx_x0[b] = pen;
                bx_x1[b] = pen;
                top: f32 = line_no as f32 * lh;
                bx_y0[b] = top + lay_inset(stack_n);
                bx_y1[b] = top + lh - lay_inset(stack_n);
                bx_n = b + 1;
                lay_stack[stack_n] = b;
                stack_n = stack_n + 1;
                if (sub_block(i)) {
                    lay_nopad[stack_n - 1] = true;
                    bx_y0[b] = top + lh * 0.45
                } else if (atom_block(i)) {
                    // (A name by itself takes no room past its writing:
                    // P(a), not P ( a ).)
                    lay_nopad[stack_n - 1] = true
                } else {
                    lay_nopad[stack_n - 1] = false;
                    // (Just after "(", the writing comes close to it, as
                    // ")" does on the other side.)
                    if (after_paren) pen = pen + pad * 0.25 else pen = pen + pad
                }
            }
        } else if (k == EV_CLOSE) {
            if (stack_n > 0) {
                b: int = lay_stack[stack_n - 1];
                stack_n = stack_n - 1;
                if (!lay_nopad[stack_n]) {
                    pen = pen + pad;
                    close_pad = close_pad + pad
                }
                bx_x1[b] = maxf(bx_x1[b], pen);
                bot: f32 = line_no as f32 * lh + lh - lay_inset(bx_depth[b]);
                bx_y1[b] = maxf(bx_y1[b], bot);
                // (A block on more lines than one spans them all.)
                if (stack_n > 0) {
                    p: int = lay_stack[stack_n - 1];
                    bx_x1[p] = maxf(bx_x1[p], bx_x1[b]);
                    bx_x0[p] = minf(bx_x0[p], bx_x0[b] - pad)
                }
            }
        } else if (k == EV_TEXT) {
            s: int = ev_a[i];
            if (close_pad > 0.0 && s == sym_rparen) pen = pen - close_pad * 0.75;
            // (A binary operator: the same room on both sides of it, the
            // larger of what the blocks around it take (aₙ + 1, not aₙ +1).)
            op_extra: f32 = 0.0;
            if (infix_text(s)) {
                right: f32 = pad_ahead(i, pad);
                if (right > close_pad) pen = pen + (right - close_pad) else op_extra = close_pad - right
            }
            after_paren = s == sym_lparen;
            size: f32 = lay_size;
            dy: f32 = 0.0;
            if (ev_b[i] == ST_SUB) {
                size = lay_size * 0.64;
                dy = lay_size * 0.2
            }
            // (The binder's name of a notch: room for the socket, a gap on
            // each side of it, the name in its middle.)
            name_w: f32 = -1.0;
            if (stack_n > 0 && lay_stack[stack_n - 1] == notch_b) {
                notch_texts = notch_texts + 1;
                if (notch_texts == 2) {
                    nw: f32 = p_sym_w(0, size, s);
                    name_w = maxf(nw + size * 0.5, NOTCH_W);
                    pen = pen + size * 0.22;
                    cy: f32 = line_no as f32 * lh + lh * 0.5;
                    ex_nok[e] = true;
                    ex_nx0[e] = pen;
                    ex_nx1[e] = pen + name_w;
                    ex_ny0[e] = cy - maxf(NOTCH_H, lh * 0.9) * 0.5;
                    ex_ny1[e] = cy + maxf(NOTCH_H, lh * 0.9) * 0.5;
                    pen = pen + (name_w - nw) * 0.5
                }
            }
            if (rn_n < RNS && stack_n > 0) {
                r: int = rn_n;
                rn_box[r] = lay_stack[stack_n - 1];
                rn_x[r] = pen;
                rn_y[r] = line_no as f32 * lh + lh * 0.5 + lay_size * 0.36 + dy;
                rn_sym[r] = s;
                rn_style[r] = ev_b[i];
                rn_n = r + 1
            }
            pen = pen + p_sym_w(0, size, s) + op_extra;
            if (name_w >= 0.0) pen = ex_nx1[e] + size * 0.2;
            close_pad = 0.0;
            if (stack_n > 0) {
                b: int = lay_stack[stack_n - 1];
                bx_x1[b] = maxf(bx_x1[b], pen)
            }
        } else if (k == EV_BREAK) {
            if (breaks_seen < breaks && stack_n > 0) {
                // (On to the next line, in from where the block broken
                // started.)
                b: int = lay_stack[stack_n - 1];
                indent: f32 = bx_x0[b] + lay_size * 1.0;
                for j in 0..stack_n {
                    o: int = lay_stack[j];
                    bx_x1[o] = maxf(bx_x1[o], pen)
                }
                widest = maxf(widest, pen);
                line_no = line_no + 1;
                pen = indent
            }
            breaks_seen = breaks_seen + 1
        } else if (k == EV_PBREAK) {
            if (pbreaks_seen < len(lay_pb_pen)) lay_pb_pen[pbreaks_seen] = pen;
            take: bool = pbreaks_seen < len(lay_ptake) && lay_ptake[pbreaks_seen];
            if (take && lay_pbreaks > 0 && stack_n > 0) {
                // (After ⟹: the next premise on a line of its own, at the
                // statement's left edge.)
                for j in 0..stack_n {
                    o: int = lay_stack[j];
                    bx_x1[o] = maxf(bx_x1[o], pen)
                }
                widest = maxf(widest, pen);
                line_no = line_no + 1;
                pen = bx_x0[lay_stack[0]] + pad
            }
            pbreaks_seen = pbreaks_seen + 1
        }
        widest = maxf(widest, pen)
    }
    ex_boxn[e] = bx_n - ex_box0[e];
    ex_runn[e] = rn_n - ex_run0[e];
    ex_w[e] = widest;
    ex_h[e] = (line_no + 1) as f32 * lh;
    lay_breaks_all = breaks_seen;
    lay_pbreaks_all = pbreaks_seen
}

// Whether text s is a binary operator as written (" + ", " = ").
infix_text(s: int): bool {
    n: int = sym_len[s];
    n >= 3 && sym_byte(s, 0) == 32 && sym_byte(s, n - 1) == 32
}

// The room the blocks opened right after event i take before their
// writing.
pad_ahead(i: int, pad: f32): f32 {
    r: f32 = 0.0;
    j: int = i + 1;
    while (j < ev_n && ev_kind[j] == EV_OPEN) {
        if (!sub_block(j) && !atom_block(j)) r = r + pad;
        j = j + 1
    }
    r
}

sym_lparen: int = 0;

sym_rparen: int = 0;

lay_stack: []int = static_buffer([256]int);

lay_nopad: []bool = static_buffer([256]bool);

lay_breaks_all: int = 0;

// How many of the preferred breaks (after ⟹) a pass takes, and how many
// there are.
lay_pbreaks: int = 0;

lay_pbreaks_all: int = 0;

// Which preferred breaks are taken, and where the pen was at each (laid
// out on one line).
lay_ptake: []bool = static_buffer([32]bool);

lay_pb_pen: []f32 = static_buffer([32]f32);

// Whether terms are laid out on one line only (a row of the hand).
lay_one_line: bool = false;

// Term t laid out to fit in width maxw, its writing at most size: a new
// expression (its number), in this slot. Blocks get their keys.
lay_term(
    t: int,
    size: f32,
    maxw: f32,
    slot: int
): int {
    if (ex_n >= EXS) return -1;
    e: int = ex_n;
    ex_n = e + 1;
    ex_box0[e] = bx_n;
    ex_run0[e] = rn_n;
    ex_slot[e] = slot;
    ev_n = 0;
    bn_n = 0;
    show_display = true;
    show(t, 0, 0);
    show_display = false;
    lay_size = size;
    breaks: int = 0;
    lay_pbreaks = 0;
    for j in 0..len(lay_ptake) lay_ptake[j] = false;
    lay_pass(e, 0);
    // (Broken after ⟹ first: each line filled with as many premises as
    // fit, broken only where the next would not.)
    pn: int = mini(lay_pbreaks_all, len(lay_ptake));
    if (!lay_one_line && ex_w[e] > maxw && pn > 0) {
        total: f32 = ex_w[e];
        start: f32 = 0.0;
        for j in 0..pn {
            next: f32 = total;
            if (j + 1 < pn) next = lay_pb_pen[j + 1];
            lay_ptake[j] = next - start + lay_pad() > maxw;
            if (lay_ptake[j]) start = lay_pb_pen[j]
        }
        lay_pbreaks = 1;
        lay_pass(e, 0)
    }
    // (Broken at more of its binders, then smaller, till it fits; on one
    // line, smaller still, if it must be.)
    least: f32 = 0.62;
    if (lay_one_line) least = 0.42;
    while (!lay_one_line && ex_w[e] > maxw && breaks < lay_breaks_all) {
        breaks = breaks + 1;
        lay_pass(e, breaks)
    }
    while (ex_w[e] > maxw && lay_size > size * least) {
        lay_size = lay_size * 0.92;
        lay_pass(e, breaks)
    }
    ex_size[e] = lay_size;
    // (Keys: a block's term, and which of its places it is.)
    for b in ex_box0[e]..bx_n {
        occ: int = 0;
        for c in ex_box0[e]..b {
            if (bx_term[c] == bx_term[b]) occ = occ + 1
        }
        bx_key[b] = bx_term[b] * 16 + mini(occ, 15)
    }
    mkeys_make(e);
    e
}

// The keys blocks are known by as they move (bx_mkey): what they show (the
// writing of the block and all inside it), and which of the blocks showing
// that it is. So P(y) under ∀y. is the P(y) left when ∀y. comes off (the
// bound y and the y taken print the same): it slides, it is not made anew.
bx_mkey: []int = static_buffer(BXS, 0);

mkeys_make(e: int) {
    b0: int = ex_box0[e];
    bn: int = ex_boxn[e];
    for b in b0..b0 + bn bx_mkey[b] = 17;
    for r in ex_run0[e]..ex_run0[e] + ex_runn[e] {
        q: int = rn_box[r];
        while (q >= b0 && q < b0 + bn) {
            bx_mkey[q] = (bx_mkey[q] * 131 + rn_sym[r] + 7) % 33554393;
            q = bx_parent[q]
        }
    }
    for b in b0..b0 + bn {
        // (Counted from the end: a binder's name coming off the front
        // does not change which y the body's y is.)
        occ: int = 0;
        for c in b + 1..b0 + bn {
            if (bx_mkey[c] == bx_mkey[b]) occ = occ + 1
        }
        mk_occ[b - b0] = mini(occ, 15)
    }
    for b in b0..b0 + bn bx_mkey[b] = bx_mkey[b] * 16 + mk_occ[b - b0]
}

mk_occ: []int = static_buffer(BXS, 0);

// Text (a name: a button's words) laid out as one block, unbroken.
lay_words(s: int, size: f32, slot: int): int {
    if (ex_n >= EXS || bx_n >= BXS || rn_n >= RNS) return -1;
    e: int = ex_n;
    ex_n = e + 1;
    ex_box0[e] = bx_n;
    ex_run0[e] = rn_n;
    ex_slot[e] = slot;
    b: int = bx_n;
    w: f32 = p_sym_w(0, size, s);
    lh: f32 = size * 1.62;
    bx_term[b] = 0;
    bx_path[b] = 0;
    bx_parent[b] = -1;
    bx_depth[b] = 0;
    bx_x0[b] = 0.0;
    bx_y0[b] = 0.0;
    bx_x1[b] = w;
    bx_y1[b] = lh;
    bx_key[b] = 1;
    bx_mkey[b] = 1;
    bx_n = b + 1;
    r: int = rn_n;
    rn_box[r] = b;
    rn_x[r] = 0.0;
    rn_y[r] = lh * 0.5 + size * 0.36;
    rn_sym[r] = s;
    rn_style[r] = ST_PLAIN;
    rn_n = r + 1;
    ex_boxn[e] = 1;
    ex_runn[e] = 1;
    ex_w[e] = w;
    ex_h[e] = lh;
    ex_size[e] = size;
    e
}

// ---- where the blocks are shown: eased from frame to frame ----
// Each block shown, by slot and key: where it is now (its corners), how
// much it shows, and the frame it was last laid out in.
const ANS: int = 16384;

an_slot: []int = static_buffer(ANS, 0);

an_key: []int = static_buffer(ANS, 0);

an_x0: []f32 = static_buffer(ANS, 0.0);

an_y0: []f32 = static_buffer(ANS, 0.0);

an_x1: []f32 = static_buffer(ANS, 0.0);

an_y1: []f32 = static_buffer(ANS, 0.0);

an_a: []f32 = static_buffer(ANS, 0.0);

an_seen: []int = static_buffer(ANS, 0);

// How fast each corner is going (blocks go on springs: a little past where
// they go, and back).
an_vx0: []f32 = static_buffer(ANS, 0.0);

an_vy0: []f32 = static_buffer(ANS, 0.0);

an_vx1: []f32 = static_buffer(ANS, 0.0);

an_vy1: []f32 = static_buffer(ANS, 0.0);

an_used: []bool = static_buffer(ANS, false);

frame_no: int = 1;

an_find(slot: int, key: int): int {
    h: int = slot * 40503 + key * 2654435761 & ANS - 1;
    if (h < 0) h = -h & ANS - 1;
    tries: int = 0;
    while (an_used[h] && tries < ANS) {
        if (an_slot[h] == slot && an_key[h] == key) return h;
        h = h + 1 & ANS - 1;
        tries = tries + 1
    }
    -1
}

an_make(slot: int, key: int): int {
    h: int = slot * 40503 + key * 2654435761 & ANS - 1;
    if (h < 0) h = -h & ANS - 1;
    tries: int = 0;
    while (an_used[h] && an_seen[h] >= frame_no - 2 && tries < ANS) {
        h = h + 1 & ANS - 1;
        tries = tries + 1
    }
    an_used[h] = true;
    an_slot[h] = slot;
    an_key[h] = key;
    an_a[h] = 0.0;
    h
}

// How quickly blocks go to their places.
const MORPH_RATE: f32 = 13.0;

const MORPH_STIFF: f32 = 260.0;

const MORPH_DAMP: f32 = 19.0;

// Whether a new block grows out of the block it is in (else it swells in
// at its own place, which reads better when much of a term is new).
morph_from_parent: bool = false;

// Whether blocks go quickly and plainly (just after an undo).
morph_fast: bool = false;

// Whether blocks jump straight to where they go (a page just opened), and
// whether those being drawn move at all (a button's words do not).
an_jump: bool = false;

an_live: bool = true;

// Block b of an expression drawn at (ox, oy): where it shows now.
an_x0_now: f32 = 0.0;

an_y0_now: f32 = 0.0;

an_x1_now: f32 = 0.0;

an_y1_now: f32 = 0.0;

an_a_now: f32 = 0.0;

an_step(slot: int, b: int, born_from: int) {
    // (Kept from the expression's own corner: it moves as a whole with
    // its card, and its blocks move within it.)
    tx0: f32 = bx_x0[b];
    ty0: f32 = bx_y0[b];
    tx1: f32 = bx_x1[b];
    ty1: f32 = bx_y1[b];
    h: int = an_find(slot, bx_mkey[b] + an_salt);
    if (h < 0 || an_seen[h] < frame_no - 2) {
        if (h < 0) h = an_make(slot, bx_mkey[b] + an_salt);
        // (New: it swells out of where the block it is in was, or at its
        // own place.)
        if (born_from >= 0 && !an_jump && morph_from_parent) {
            an_x0[h] = an_x0[born_from];
            an_y0[h] = an_y0[born_from];
            an_x1[h] = an_x1[born_from];
            an_y1[h] = an_y1[born_from]
        } else {
            cx: f32 = (tx0 + tx1) * 0.5;
            cy: f32 = (ty0 + ty1) * 0.5;
            // (In place: its writing fades in where it will be.)
            k: f32 = 1.0;
            an_x0[h] = cx + (tx0 - cx) * k;
            an_x1[h] = cx + (tx1 - cx) * k;
            an_y0[h] = cy + (ty0 - cy) * k;
            an_y1[h] = cy + (ty1 - cy) * k
        }
        an_a[h] = 0.0;
        an_vx0[h] = 0.0;
        an_vy0[h] = 0.0;
        an_vx1[h] = 0.0;
        an_vy1[h] = 0.0;
        if (an_jump) an_a[h] = 1.0
    }
    if (now_t < morph_hold_t && !an_jump && an_live && !an_quick) {
        // (Held while what left fades: then it moves.)
    } else if (an_jump || !an_live) {
        an_x0[h] = tx0;
        an_y0[h] = ty0;
        an_x1[h] = tx1;
        an_y1[h] = ty1;
        an_a[h] = 1.0
    } else {
        // (Springy, so blocks settle with a small wobble; quick and plain
        // just after an undo.)
        if (morph_fast) {
            an_x0[h] = ease_to(an_x0[h], tx0, MORPH_RATE * 2.2);
            an_y0[h] = ease_to(an_y0[h], ty0, MORPH_RATE * 2.2);
            an_x1[h] = ease_to(an_x1[h], tx1, MORPH_RATE * 2.2);
            an_y1[h] = ease_to(an_y1[h], ty1, MORPH_RATE * 2.2);
            an_vx0[h] = 0.0;
            an_vy0[h] = 0.0;
            an_vx1[h] = 0.0;
            an_vy1[h] = 0.0
        } else {
            an_x0[h] = spring(an_x0[h], an_vx0[h], tx0, MORPH_STIFF, MORPH_DAMP);
            an_vx0[h] = spring_v;
            an_y0[h] = spring(an_y0[h], an_vy0[h], ty0, MORPH_STIFF, MORPH_DAMP);
            an_vy0[h] = spring_v;
            an_x1[h] = spring(an_x1[h], an_vx1[h], tx1, MORPH_STIFF, MORPH_DAMP);
            an_vx1[h] = spring_v;
            an_y1[h] = spring(an_y1[h], an_vy1[h], ty1, MORPH_STIFF, MORPH_DAMP);
            an_vy1[h] = spring_v
        }
        an_a[h] = ease_to(an_a[h], 1.0, MORPH_RATE * 0.8);
        if (an_quick) an_a[h] = ease_to(an_a[h], 1.0, MORPH_RATE * 3.0)
    }
    an_seen[h] = frame_no;
    an_x0_now = an_x0[h];
    an_y0_now = an_y0[h];
    an_x1_now = an_x1[h];
    an_y1_now = an_y1[h];
    an_a_now = an_a[h];
    an_last = h
}

an_last: int = 0;

// Added to the keys blocks and writing are known by: a goal whose whole
// shape changes (∀n≥N. comes off, and it goes from two lines at one size
// to one line at another) is known afresh, so the old writing fades where
// it was and the new swells in, rather than its pieces sliding apart.
an_salt: int = 0;

// Added to it by whoever draws (a card's preview is known afresh: its
// writing crossfades rather than flying about), and whether new writing
// comes in at once (quickly, not after what leaves has gone).
an_salt_extra: int = 0;

an_quick: bool = false;

xf_gen: int = 0;

xf_term: int = 0;

xf_size: f32 = 0.0;

xf_lines: f32 = 0.0;

xf_t: f32 = -10.0;

reshape_check(e: int) {
    t: int = bx_term[ex_box0[e]];
    if (t == xf_term) return;
    size: f32 = ex_size[e];
    lines: f32 = ex_h[e] / (size * 1.62);
    if (xf_term != 0 && !an_jump && (absf(size - xf_size) > xf_size * 0.2 || absf(lines - xf_lines) > 0.5)) {
        xf_gen = xf_gen + 1;
        xf_t = now_t
    }
    xf_term = t;
    xf_size = size;
    xf_lines = lines
}

// Each frame, blocks no longer shown are let go.
an_frame() {
    frame_no = frame_no + 1
}

// ---- cards, eased ----
// Where each card (by slot) is shown, sliding to where it goes, and how
// much it shows (a new one fades in).
const CARDS: int = 512;

cd_slot_k: []int = static_buffer(CARDS, 0);

cd_y_now: []f32 = static_buffer(CARDS, 0.0);

cd_a_now: []f32 = static_buffer(CARDS, 0.0);

cd_seen: []int = static_buffer(CARDS, 0);

cd_vy: []f32 = static_buffer(CARDS, 0.0);

cards_n: int = 0;

// The y a card in this slot shows at, going to y; its showing in card_a.
card_a: f32 = 1.0;

card_y(slot: int, y: f32): f32 {
    k: int = -1;
    for i in 0..cards_n {
        if (cd_slot_k[i] == slot) k = i
    }
    if (k < 0 || cd_seen[k] < frame_no - 2) {
        if (k < 0) {
            // (A free place: one not seen lately.)
            for i in 0..cards_n {
                if (k < 0 && cd_seen[i] < frame_no - 2) k = i
            }
            if (k < 0 && cards_n < CARDS) {
                k = cards_n;
                cards_n = cards_n + 1
            }
            if (k < 0) {
                card_a = 1.0;
                return y
            }
        }
        cd_slot_k[k] = slot;
        // (A new card drops in from above, with a bounce.)
        cd_y_now[k] = y - 34.0;
        cd_vy[k] = 0.0;
        cd_a_now[k] = 0.0;
        if (an_jump) {
            cd_y_now[k] = y;
            cd_a_now[k] = 1.0
        }
    }
    cd_seen[k] = frame_no;
    if (an_jump) {
        cd_y_now[k] = y;
        cd_vy[k] = 0.0
    } else {
        cd_y_now[k] = spring(cd_y_now[k], cd_vy[k], y, 240.0, 15.0);
        cd_vy[k] = spring_v
    }
    cd_a_now[k] = ease_to(cd_a_now[k], 1.0, MORPH_RATE);
    card_a = cd_a_now[k];
    cd_y_now[k]
}

// Where the card in this slot is now (-1e9 if none is shown).
card_now(slot: int): f32 {
    for i in 0..cards_n {
        if (cd_slot_k[i] == slot && cd_seen[i] >= frame_no - 2) return cd_y_now[i]
    }
    -1000000000.0
}

// ---- drawing ----
// What is picked (a block, by its expression's slot and key), and the
// block pressed now.
pick_slot: int = 0;

pick_key: int = 0;

// Whether blocks are shown as tinted blocks now (a face held over the
// goal: its parts are places).
blocks_shown: bool = false;

// Draw expression e with its top left at (ox, oy); ink its color, and the
// whole of it shown as much as alpha. Blocks shown as blocks if `blocks`
// and blocks_shown.
draw_expr(
    e: int,
    ox: f32,
    oy: f32,
    ink: int,
    alpha: f32,
    blocks: bool
) {
    if (e < 0) return;
    ex_ox[e] = ox;
    ex_oy[e] = oy;
    slot: int = ex_slot[e];
    size: f32 = ex_size[e];
    b0: int = ex_box0[e];
    an_salt = 0;
    if (slot == SLOT_GOAL && draw_board && an_live) {
        reshape_check(e);
        an_salt = xf_gen * 7919
    }
    an_salt = an_salt + an_salt_extra;
    // (Where each block shows, kept for its writing.)
    for b in b0..b0 + ex_boxn[e] {
        born: int = -1;
        p: int = bx_parent[b];
        if (p >= 0) born = dr_anim[p - b0];
        an_step(slot, b, born);
        if (b - b0 < len(dr_anim)) {
            dr_anim[b - b0] = an_last;
            dr_x[b - b0] = an_x0_now - bx_x0[b];
            dr_y[b - b0] = an_y0_now - bx_y0[b]
        }
        an_x0_now = an_x0_now + ox;
        an_x1_now = an_x1_now + ox;
        an_y0_now = an_y0_now + oy;
        an_y1_now = an_y1_now + oy;
        a: f32 = an_a_now * alpha;
        picked: bool = slot == pick_slot && bx_key[b] == pick_key && pick_slot != 0;
        w: f32 = an_x1_now - an_x0_now;
        h: f32 = an_y1_now - an_y0_now;
        r: f32 = minf(h * 0.42, size * 0.55);
        hl: bool = hl_key != 0 && (bx_key[b] == hl_key || bx_key[b] == hl_key2);
        if (!compound(bx_term[b]) && (picked || hl)) {
            an_x0_now = an_x0_now - size * 0.14;
            w = w + size * 0.28
        }
        if (picked) {
            p_shadow(an_x0_now, an_y0_now, w, h, r, 2.0, 6.0, 0.18 * a);
            p_box(an_x0_now, an_y0_now, w, h, r, C_PICK_SOFT, a);
            p_outline(an_x0_now, an_y0_now, w, h, r, 2.0, C_PICK, a)
        } else if (hl) {
            if (!hl_seen) {
                hl_seen = true;
                hl_seen_x = an_x0_now;
                hl_seen_y = an_y0_now - minf(bx_depth[b] as f32, 4.0) * size * 0.075
            }
            p_box(an_x0_now, an_y0_now, w, h, r, C_PICK_SOFT, a);
            p_outline(an_x0_now, an_y0_now, w, h, r, 1.5, mix_rgb(C_PICK_SOFT, C_PICK,
                0.5), a)
        } else if (blocks && blocks_shown && bx_depth[b] > 0 && compound(bx_term[b])) {
            // (Only while a face is held: the parts it could go onto, faint;
            // a quantifier's block plainer.)
            tint: int = block_tints[(bx_depth[b] - 1) % len(block_tints)];
            k: f32 = 0.3;
            if (is_quantifier(bx_term[b])) k = 0.8;
            p_box(an_x0_now, an_y0_now, w, h, r, tint, k * a)
        }
    }
    // (On the board, each piece of writing moves on its own, so an = or a
    // · slides with the parts beside it; the block a fly is bringing in is
    // not written till it lands.)
    own: bool = draw_board && an_live && !an_jump;
    hide_b: int = -1;
    if (own && hide_term != 0 && slot == hide_slot) {
        for b in b0..b0 + ex_boxn[e] {
            if (hide_b < 0 && bx_term[b] == hide_term) hide_b = b
        }
        if (hide_b == b0 || hide_b >= 0 && bx_y1[hide_b] - bx_y0[hide_b] > size * 1.7) hide_b = -1
    }
    for b in b0..b0 + mini(ex_boxn[e], len(dr_n)) dr_n[b - b0] = 0;
    for r in ex_run0[e]..ex_run0[e] + ex_runn[e] {
        b: int = rn_box[r];
        k: int = b - b0;
        dx: f32 = 0.0;
        dy: f32 = 0.0;
        a: f32 = alpha;
        if (k >= 0 && k < len(dr_anim)) {
            dx = dr_x[k];
            dy = dr_y[k];
            a = an_a[dr_anim[k]] * alpha
        }
        s: f32 = size;
        if (rn_style[r] == ST_SUB) s = size * 0.64;
        col: int = ink;
        if (rn_style[r] == ST_OP) col = mix_rgb(ink, C_BLUE, 0.35);
        px: f32 = ox + rn_x[r] + dx;
        py: f32 = oy + rn_y[r] + dy;
        if (own && k >= 0 && k < len(dr_n)) {
            j: int = dr_n[k];
            dr_n[k] = j + 1;
            // (The whole statement's own writing (its = or ⟶) is kept as
            // the statement changes: keyed by its slot alone.)
            // (Known by what it writes and which of those in the card it
            // is, counted from the end: ∀y. P(y) to P(y), the P, its
            // brackets and its y slide left, and ∀y. alone leaves; b = a
            // to a = b, the a and b change places.)
            occ: int = 0;
            for r2 in r + 1..ex_run0[e] + ex_runn[e] {
                if (rn_sym[r2] == rn_sym[r] && rn_style[r2] == rn_style[r]) occ = occ + 1
            }
            run_step(slot, run_key(1 + rn_style[r], rn_sym[r], occ), -1, rn_x[r],
                rn_y[r]);
            px = ox + an_x0_now;
            py = oy + an_y0_now;
            a = an_a_now * alpha;
            // (Swelling in: from a little smaller.)
            if (an_a_now < 0.98) s = s * (0.7 + 0.3 * an_a_now);
            hidden: bool = false;
            if (hide_b >= 0) {
                q: int = b;
                while (q >= 0 && q != hide_b) q = bx_parent[q];
                hidden = q == hide_b
            }
            if (!hidden) leaver_note(an_last, px, py, rn_sym[r], s, col, a, slot) else a = 0.0
        }
        if (a > 0.0) {
            if (rn_sym[r] == sym_hole()) draw_slot_glyph(px, py, s, a, slot == socket_slot) else p_sym(0,
                s, px, py, rn_sym[r], col, a)
        }
    }
}

// A rule's variable, or a name still to choose, is shown as a grey hollow
// slot (never a letter): □ drawn so. One in slot socket_slot (a socket
// waiting for a name) is ringed orange.
sym_hole_v: int = 0;

sym_hole(): int {
    if (sym_hole_v == 0) sym_hole_v = sym_cp(9633);
    sym_hole_v
}

socket_slot: int = -1;

draw_slot_glyph(
    x: f32,
    base: f32,
    s: f32,
    a: f32,
    socket: bool
) {
    w: f32 = p_sym_w(0, s, sym_hole());
    bw: f32 = maxf(w * 0.86, s * 0.62);
    bh: f32 = s * 0.78;
    bx: f32 = x + (w - bw) * 0.5;
    by: f32 = base - s * 0.74;
    r: f32 = bh * 0.3;
    p_box(bx, by, bw, bh, r, mix_rgb(C_SUNK, C_SHADOW, 0.08), a);
    p_box(bx + 1.0, by + 1.0, bw - 2.0, bh * 0.3, r * 0.8, C_SHADOW, 0.1 * a);
    col: int = mix_rgb(C_MUTED, C_SUNK, 0.35);
    th: f32 = 1.4;
    if (socket) {
        col = C_PICK;
        th = 2.0
    }
    p_outline(bx, by, bw, bh, r, th, col, a)
}

// Pieces of writing per block seen so far (each piece's key).
dr_n: []int = static_buffer(BXS, 0);

// Whether what is drawn now is on the board (its writing morphs piece by
// piece, and what leaves fades where it was).
draw_board: bool = false;

// The term whose block a fly is bringing into slot hide_slot (0: none).
hide_term: int = 0;

hide_slot: int = 0;

// The pieces of writing have their own springs, in slots apart.
const RUN_SLOT: int = 900000000;

// A piece of writing (by its slot and key) going to (tx, ty) from its
// expression's corner: where it shows now (an_x0_now, an_y0_now, an_a_now).
run_key(rk: int, s: int, occ: int): int {
    (rk * 4099 + s) * 16 + mini(occ, 15)
}

run_step(
    slot: int,
    key: int,
    alt: int,
    tx: f32,
    ty: f32
) {
    rs: int = slot + RUN_SLOT;
    h: int = an_find(rs, key + an_salt);
    if (h < 0 || an_seen[h] < frame_no - 2) {
        if (h < 0) h = an_make(rs, key + an_salt);
        an_x0[h] = tx;
        an_y0[h] = ty;
        an_vx0[h] = 0.0;
        an_vy0[h] = 0.0;
        an_a[h] = 0.0;
        // (The same writing just shown in another place of this card,
        // and not here now: it moves over from there, and does not leave.)
        o: int = -1;
        if (alt >= 0) o = an_find(rs, alt + an_salt);
        if (o >= 0 && o != h && an_seen[o] == frame_no - 1 && !an_jump) {
            an_x0[h] = an_x0[o];
            an_y0[h] = an_y0[o];
            an_vx0[h] = an_vx0[o];
            an_vy0[h] = an_vy0[o];
            an_a[h] = an_a[o];
            an_seen[o] = frame_no
        }
    }
    if (now_t < morph_hold_t && !an_quick) { } else if (morph_fast) {
        an_x0[h] = ease_to(an_x0[h], tx, MORPH_RATE * 2.2);
        an_y0[h] = ease_to(an_y0[h], ty, MORPH_RATE * 2.2);
        an_vx0[h] = 0.0;
        an_vy0[h] = 0.0
    } else {
        an_x0[h] = spring(an_x0[h], an_vx0[h], tx, MORPH_STIFF, MORPH_DAMP);
        an_vx0[h] = spring_v;
        an_y0[h] = spring(an_y0[h], an_vy0[h], ty, MORPH_STIFF, MORPH_DAMP);
        an_vy0[h] = spring_v
    }
    if (now_t >= morph_hold_t || an_quick) an_a[h] = ease_to(an_a[h], 1.0, MORPH_RATE * 0.8);
    if (an_quick) an_a[h] = ease_to(an_a[h], 1.0, MORPH_RATE * 3.0);
    an_seen[h] = frame_no;
    an_x0_now = an_x0[h];
    an_y0_now = an_y0[h];
    an_a_now = an_a[h];
    an_last = h
}

// ---- what leaves fades where it was ----
// The board's pieces of writing drawn this frame and last (their spring,
// where, what, how); one drawn last frame and not this one leaves: it
// shrinks and fades in place.
const LVS: int = 2048;

lv_h: []int = static_buffer(LVS * 2, 0);

lv_x: []f32 = static_buffer(LVS * 2, 0.0);

lv_y: []f32 = static_buffer(LVS * 2, 0.0);

lv_sym: []int = static_buffer(LVS * 2, 0);

lv_size: []f32 = static_buffer(LVS * 2, 0.0);

lv_col: []int = static_buffer(LVS * 2, 0);

lv_a: []f32 = static_buffer(LVS * 2, 0.0);

// (The slot of the card it was on, and where that card was: what leaves
// moves on with its card.)
lv_slot: []int = static_buffer(LVS * 2, 0);

lv_cy: []f32 = static_buffer(LVS * 2, 0.0);

// Which half is this frame's, and how many in each.
lv_cur: int = 0;

lv_cn: []int = static_buffer([2]int);

leaver_note(
    h: int,
    x: f32,
    y: f32,
    s: int,
    size: f32,
    col: int,
    a: f32,
    slot: int
) {
    n: int = lv_cn[lv_cur];
    if (n >= LVS) return;
    // (Writing scrolled out of sight does not leave where it was.)
    if (y < p_cy0 || y - size > p_cy1) return;
    i: int = lv_cur * LVS + n;
    lv_h[i] = h;
    lv_x[i] = x;
    lv_y[i] = y;
    lv_sym[i] = s;
    lv_size[i] = size;
    lv_col[i] = col;
    lv_a[i] = a;
    lv_slot[i] = slot;
    lv_cy[i] = card_now(slot);
    lv_cn[lv_cur] = n + 1
}

// Those leaving, fading.
const GONE: int = 256;

gn_x: []f32 = static_buffer(GONE, 0.0);

gn_y: []f32 = static_buffer(GONE, 0.0);

gn_sym: []int = static_buffer(GONE, 0);

gn_size: []f32 = static_buffer(GONE, 0.0);

gn_col: []int = static_buffer(GONE, 0);

gn_a: []f32 = static_buffer(GONE, 0.0);

gn_t: []f32 = static_buffer(GONE, -10.0);

gn_slot: []int = static_buffer(GONE, 0);

gn_cy: []f32 = static_buffer(GONE, 0.0);

gn_next: int = 0;

const GONE_TIME: f32 = 0.13;

const PUFF_TIME: f32 = 0.3;

gn_puff: []bool = static_buffer(GONE, false);

// The slot of a fact card lifted off the board (its place a dent), or -1.
dent_slot: int = -1;

// Until when what stays waits (what left is fading).
morph_hold_t: f32 = -10.0;

// After the board is drawn: what left it is found, and all that is
// leaving drawn.
leavers_step() {
    prev: int = 1 - lv_cur;
    if (!an_jump) {
        for k in 0..lv_cn[prev] {
            i: int = prev * LVS + k;
            // (A goal known afresh just now goes at once: its new writing
            // fades in on a clean card.)
            fresh: bool = lv_slot[i] == SLOT_GOAL && now_t - xf_t < 0.05;
            // (A card being pinched in two carries its own writing.)
            if (lv_slot[i] == SLOT_GOAL && split_on() || lv_slot[i] == pc_slot && now_t - pc_t0 < 0.1) fresh = true;
            // (A card lifted takes its writing with it: none left behind.)
            if (dent_slot >= 0 && lv_slot[i] == dent_slot) fresh = true;
            if (an_seen[lv_h[i]] != frame_no && lv_a[i] > 0.05 && !fresh) {
                g: int = gn_next;
                gn_next = (gn_next + 1) % GONE;
                gn_x[g] = lv_x[i];
                gn_y[g] = lv_y[i];
                gn_sym[g] = lv_sym[i];
                gn_size[g] = lv_size[i];
                gn_col[g] = lv_col[i];
                gn_a[g] = lv_a[i];
                gn_slot[g] = lv_slot[i];
                gn_cy[g] = lv_cy[i];
                gn_t[g] = now_t;
                // (A key just opened: its binder puffs away.)
                gn_puff[g] = now_t - ko_t < 0.06;
                if (!morph_fast) morph_hold_t = now_t + GONE_TIME * 0.8
            }
        }
    } else {
        for g in 0..GONE gn_t[g] = -10.0
    }
    lv_cur = prev;
    lv_cn[lv_cur] = 0;
    for g in 0..GONE {
        t: f32 = (now_t - gn_t[g]) / GONE_TIME;
        if (gn_puff[g]) {
            t = (now_t - gn_t[g]) / PUFF_TIME;
            if (t >= 0.0 && t < 1.0) {
                busy = true;
                sc: f32 = 1.0 + 0.7 * t;
                w: f32 = p_sym_w(0, gn_size[g], gn_sym[g]);
                dy: f32 = 0.0;
                cy: f32 = card_now(gn_slot[g]);
                if (cy > -100000.0 && gn_cy[g] > -100000.0) dy = cy - gn_cy[g];
                p_sym(0, gn_size[g] * sc, gn_x[g] - w * (sc - 1.0) * 0.5, gn_y[g] + dy - 16.0 * t + gn_size[g] * 0.3 * (sc - 1.0),
                    gn_sym[g], gn_col[g], gn_a[g] * (1.0 - t) * (1.0 - t) * 0.8)
            }
            t = 2.0
        }
        if (t >= 0.0 && t < 1.0) {
            busy = true;
            sc: f32 = 1.0 - 0.55 * t;
            w: f32 = p_sym_w(0, gn_size[g], gn_sym[g]);
            // (Its card moved since: it moves with it.)
            dy: f32 = 0.0;
            cy: f32 = card_now(gn_slot[g]);
            if (cy > -100000.0 && gn_cy[g] > -100000.0) dy = cy - gn_cy[g];
            p_sym(0, gn_size[g] * sc, gn_x[g] + w * (1.0 - sc) * 0.5, gn_y[g] + dy - gn_size[g] * 0.35 * (1.0 - sc),
                gn_sym[g], gn_col[g], gn_a[g] * (1.0 - t))
        }
    }
}

// A block shown tinted as changed (by its key; 0 for none), and where it
// was drawn (its block's corner, less its inset).
hl_key: int = 0;

hl_seen: bool = false;

// A second block tinted so (the other side of c = c).
hl_key2: int = -1;

hl_seen_x: f32 = 0.0;

hl_seen_y: f32 = 0.0;

// Whether a term is a for-all or there-is.
is_quantifier(t: int): bool {
    if (tm_kind(t) != TM_APP) return false;
    h: int = tm_fun(t);
    tm_kind(h) == TM_CONST && (tm_name(h) == role_name[ROLE_ALL] || tm_name(h) == role_name[ROLE_EX])
}

dr_anim: []int = static_buffer(BXS, 0);

dr_x: []f32 = static_buffer(BXS, 0.0);

dr_y: []f32 = static_buffer(BXS, 0.0);

// Whether a term is more than a name (and so gets its own block color).
compound(t: int): bool {
    k: int = tm_kind(t);
    k == TM_APP || k == TM_ABS
}

// ---- what a finger is on ----
// The deepest block of expression e at (x, y), or -1.
block_at(e: int, x: f32, y: f32): int {
    if (e < 0) return -1;
    best: int = -1;
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        x0: f32 = ex_ox[e] + bx_x0[b];
        x1: f32 = ex_ox[e] + bx_x1[b];
        y0: f32 = ex_oy[e] + bx_y0[b];
        y1: f32 = ex_oy[e] + bx_y1[b];
        if (x >= x0 - 2.0 && x <= x1 + 2.0 && y >= y0 - 2.0 && y <= y1 + 2.0) {
            if (best < 0 || bx_depth[b] >= bx_depth[best]) best = b
        }
    }
    best
}

// The steps of block b's path (show.l8's paths), into sub_steps.
block_steps(b: int) {
    p: int = bx_path[b];
    n: int = path_depth[p];
    sub_n = n;
    i: int = n - 1;
    while (i >= 0 && p != 0) {
        sub_steps[i] = path_step[p];
        p = path_parent[p];
        i = i - 1
    }
}
