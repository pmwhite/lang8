tag lemma_ui;

use_tag std, skate, lemma;

// The pages, drawn: the map, a level, and a proof written out. Everything
// is laid out afresh each frame, in the game's pixels (on a page, CSS
// pixels); what moves is eased, so a frame with nothing moving is the
// same as the last.
draw_game() {
    boxes_reset();
    an_frame();
    btn_n = 0;
    if (page == PAGE_MAP) draw_map() else if (page == PAGE_LEVEL) draw_level() else if (page == PAGE_RULES) draw_rules_page() else draw_proof_page();
    // (Words for a moment: just under the bar on a level, clear of the
    // board; at the foot of other pages.)
    if (page == PAGE_LEVEL) draw_toast(bar_bottom_y + 4.0, true) else draw_toast(view_h() - safe_bottom - 68.0,
        false);
    an_jump = false
}

// The width the page's column takes (narrow on a phone, at most 560).
col_w(): f32 {
    minf(view_w() - safe_left - safe_right - 24.0, 560.0)
}

col_x(): f32 {
    safe_left + (view_w() - safe_left - safe_right - col_w()) * 0.5
}

// A round button with an icon, (x, y) its middle.
round_button(
    id: int,
    x: f32,
    y: f32,
    icon: int
) {
    r: f32 = 22.0;
    k: f32 = pressed(id);
    p_shadow(x - r, y - r, 2.0 * r, 2.0 * r, r, 2.0, 6.0, 0.12);
    p_disc(x, y, r - k * 1.5, mix_rgb(C_CARD, C_SUNK, k), 1.0);
    p_ring(x, y, r - k * 1.5, 1.0, C_LINE, 1.0);
    draw_icon(icon, x, y, 9.0, C_INK, 1.0);
    add_button(id, x - r, y - r, x + r, y + r)
}

// A pill button with words, its top left (x, y); how wide.
pill_button(
    id: int,
    x: f32,
    y: f32,
    s: int,
    fill: int,
    ink: int
): f32 {
    size: f32 = 17.0;
    w: f32 = p_sym_w(1, size, s) + 36.0;
    h: f32 = 46.0;
    k: f32 = pressed(id);
    dy: f32 = k * 2.0;
    p_shadow(x, y, w, h, h * 0.5, 3.0 - k * 2.0, 8.0, 0.16);
    p_box(x, y + dy, w, h, h * 0.5, fill, 1.0);
    p_sym(1, size, x + 18.0, y + dy + h * 0.5 + size * 0.36, s, ink, 1.0);
    add_button(id, x, y, x + w, y + h);
    w
}

// Words wrapped to width w, the first line's baseline at y: how tall.
draw_wrapped(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    s: int,
    rgb: int,
    a: f32
): f32 {
    from: int = sym_start[s];
    to: int = from + sym_len[s];
    lh: f32 = size * 1.38;
    yy: f32 = y;
    i: int = from;
    while (i < to) {
        // (As many words as fit: up to the last space that does.)
        j: int = i;
        last: int = -1;
        while (j < to && p_text_w(face, size, sym_bytes, i, j + 1) <= w) {
            if (sym_bytes[j] as int == 32) last = j;
            j = j + 1
        }
        end: int = j;
        if (j < to && last > i) end = last;
        if (end <= i) end = i + 1;
        if (a > 0.0) pen_end = p_text(face, size, x, yy, sym_bytes, i, end, 0.0, rgb,
            a);
        i = end;
        while (i < to && sym_bytes[i] as int == 32) i = i + 1;
        yy = yy + lh
    }
    yy - y
}

// ---- the map ----
// Each region a chapter: a cover strip (its picture, title, how much is
// proved), then its levels as round pudgy nodes along a winding path, the
// next to play bobbing.
draw_map() {
    x: f32 = col_x();
    w: f32 = col_w();
    top: f32 = safe_top - sc_pos[V_MAP];
    y: f32 = top + 54.0;
    p_str(1, 40.0, x + 4.0, y, "Lemma", C_INK, 1.0);
    y = y + 30.0;
    y = y + draw_wrapped(0, 17.0, x + 6.0, y, w - 12.0, sym("Prove theorems from the ground up, one move at a time."),
        C_MUTED, 1.0) + 14.0;
    next_found: bool = false;
    for r in 0..rg_n {
        y = draw_cover(r, x, y, w) + 26.0;
        n: int = rg_lvn[r];
        // (The path first, under the nodes: gold where it is walked.)
        for i in 0..n - 1 {
            k: int = rg_lv0[r] + i;
            ax: f32 = node_x(i, x, w);
            ay: f32 = y + i as f32 * NODE_GAP + 30.0;
            bx: f32 = node_x(i + 1, x, w);
            by: f32 = ay + NODE_GAP;
            col: int = C_LINE;
            if (ml_solved[k]) col = mix_rgb(C_GOLD, C_LINE, 0.35);
            d: f32 = sqrtf((bx - ax) * (bx - ax) + (by - ay) * (by - ay));
            steps: int = (d / 13.0) as int;
            for j in 1..steps {
                f: f32 = j as f32 / steps as f32;
                // (A gentle bow in each step of the path.)
                bow: f32 = sinf(f * 3.1416) * 14.0;
                if (bx < ax) bow = -bow;
                p_disc(ax + (bx - ax) * f + bow, ay + (by - ay) * f, 3.2, col, 1.0)
            }
        }
        for i in 0..n {
            k: int = rg_lv0[r] + i;
            next: bool = !ml_solved[k] && !next_found && level_lock(k) == 0;
            if (next) next_found = true;
            draw_node(k, i, node_x(i, x, w), y + i as f32 * NODE_GAP + 30.0, x, w,
                next)
        }
        y = y + n as f32 * NODE_GAP + 24.0
    }
    sc_most[V_MAP] = y + sc_pos[V_MAP] + safe_bottom + 20.0 - view_h()
}

const NODE_GAP: f32 = 92.0;

// Where node i sits across: winding left and right.
node_x(i: int, x: f32, w: f32): f32 {
    s: f32 = sinf(i as f32 * 1.25 + 0.6);
    // (Never in the very middle: a title needs a side.)
    off: f32 = 0.4 + 0.6 * absf(s);
    if (s < 0.0) off = -off;
    x + w * 0.5 + off * w * 0.27
}

// A chapter's cover: a strip with its picture, title and progress. Where
// it ends.
draw_cover(
    r: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    h: f32 = 118.0;
    solved: int = 0;
    for k in rg_lv0[r]..rg_lv0[r] + rg_lvn[r] {
        if (ml_solved[k]) solved = solved + 1
    }
    tint: int = mix_rgb(C_GOLD_SOFT, C_CARD, 0.2);
    if (r == 1) tint = mix_rgb(C_BLUE_SOFT, C_CARD, 0.2);
    if (r == 2) tint = mix_rgb(C_PICK_SOFT, C_CARD, 0.1);
    p_shadow(x, y, w, h, 24.0, 4.0, 14.0, 0.12);
    p_box(x, y, w, h, 24.0, tint, 1.0);
    // (The picture, on the right.)
    px: f32 = x + w - 150.0;
    draw_cover_art(r, px, y + 12.0, 136.0, h - 24.0);
    line_clear();
    line_add("CHAPTER ");
    line_int(r + 1);
    pen_end = p_line_text(1, 12.0, x + 22.0, y + 32.0, C_MUTED, 1.0);
    ts: f32 = 28.0;
    tw: f32 = p_sym_w(1, ts, rg_title[r]);
    if (tw > w - 190.0) ts = ts * (w - 190.0) / tw;
    p_sym(1, ts, x + 22.0, y + 66.0, rg_title[r], C_INK, 1.0);
    // (How much is proved: a bar of pips.)
    n: int = rg_lvn[r];
    bw: f32 = minf(120.0, w - 200.0);
    p_box(x + 22.0, y + 84.0, bw, 10.0, 5.0, mix_rgb(C_LINE, C_SUNK, 0.5), 1.0);
    if (solved > 0) p_box(x + 22.0, y + 84.0, maxf(bw * solved as f32 / maxf(n as f32,
        1.0), 10.0), 10.0, 5.0, C_GOLD, 1.0);
    line_clear();
    line_int(solved);
    line_add(" of ");
    line_int(n);
    pen_end = p_line_text(0, 13.0, x + 30.0 + bw, y + 94.0, C_MUTED, 1.0);
    y + h
}

// A chapter's picture: a knot of arrows (logic), the square's tiles
// (groups), dots settling into a band (limits).
draw_cover_art(
    r: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    pic: int = rg_pic[r];
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    if (pic == sym("sequence")) {
        // (However close you ask, from some point on they stay that close.)
        p_box(x, cy - 12.0, w, 24.0, 8.0, C_PICK_SOFT, 1.0);
        p_line(x, cy, x + w, cy, 1.5, C_FAINT, 1.0);
        gx: f32 = x + w * 0.42;
        p_line(gx, y + 4.0, gx, y + h - 4.0, 2.0, C_PICK, 0.8);
        for i in 0..14 {
            t: f32 = i as f32 / 13.0;
            dx: f32 = x + 6.0 + t * (w - 12.0);
            s: f32 = 1.0;
            if (i % 2 == 1) s = -1.0;
            dy: f32 = cy + s * 34.0 * expf(-t * 3.2);
            col: int = C_INK;
            if (dx < gx) col = C_FAINT;
            p_disc(dx, dy, 3.6, col, 1.0)
        }
        return
    }
    if (pic == sym("square")) {
        // (Tiles of a train: a, a⁻¹ and e, gathering.)
        cols: []int = cover_cols;
        for i in 0..4 {
            tx: f32 = cx - 58.0 + i as f32 * 30.0;
            ty: f32 = cy - 14.0 + sinf(i as f32 * 1.7) * 9.0;
            col: int = cols[i];
            if (i == 2) {
                p_box(tx, ty, 26.0, 28.0, 8.0, C_WHITE, 1.0);
                p_outline(tx, ty, 26.0, 28.0, 8.0, 2.0, cols[0], 1.0)
            } else {
                p_shadow(tx, ty, 26.0, 28.0, 8.0, 2.0, 5.0, 0.15);
                p_box(tx, ty, 26.0, 28.0, 8.0, col, 1.0)
            }
        }
        p_str_mid(1, 14.0, cx, cy + 36.0, "=", C_FAINT, 1.0);
        return
    }
    // (Logic: arrows tied in a knot.)
    for i in 0..3 {
        a0: f32 = i as f32 * 2.094;
        p_arc(cx, cy, 26.0, 3.0, a0, 1.6, C_PICK, 0.8);
        tx: f32 = cx + cosf(a0 + 1.6) * 26.0;
        ty: f32 = cy + sinf(a0 + 1.6) * 26.0;
        p_disc(tx, ty, 5.0, C_PICK, 0.9)
    }
    p_str_mid(1, 18.0, cx - 40.0, cy - 20.0, "P", C_INK, 0.7);
    p_str_mid(1, 18.0, cx + 42.0, cy + 30.0, "Q", C_INK, 0.7)
}

cover_cols: []int = [3824544, 13784378, 3824544, 4160846];

// Level k of the map as a node at (cx, cy): a pudgy round button (its
// number, a check when proved, a lock), its title beside it, its stars
// under it. The next to play bobs.
draw_node(
    k: int,
    i: int,
    cx: f32,
    cy0: f32,
    x: f32,
    w: f32,
    next: bool
) {
    id: int = B_LEVEL + k;
    pk: f32 = pressed(id);
    r: f32 = 27.0 - pk * 2.0;
    bob: f32 = 0.0;
    if (next) {
        bob = sinf(now_t * 3.2) * 3.5;
        busy = true
    }
    cy: f32 = cy0 + bob;
    lock: int = level_lock(k);
    fill: int = C_WHITE;
    ring: int = C_LINE;
    if (ml_solved[k]) {
        fill = C_GOLD;
        ring = mix_rgb(C_GOLD, C_INK, 0.2)
    }
    if (lock != 0) fill = C_SUNK;
    if (next) {
        fill = C_PICK;
        ring = mix_rgb(C_PICK, C_INK, 0.2);
        p_glow(cx, cy, r + 6.0 + sinf(now_t * 3.0) * 2.0, 8.0, C_PICK, 0.3)
    }
    // (Pudgy: a thick base under the face.)
    p_shadow(cx - r, cy - r + 3.0, 2.0 * r, 2.0 * r, r, 4.0 - bob * 0.3, 8.0, 0.2);
    p_disc(cx, cy + 4.0 - pk * 2.0, r, mix_rgb(fill, C_INK, 0.22), 1.0);
    p_disc(cx, cy + pk * 2.0, r, fill, 1.0);
    p_ring(cx, cy + pk * 2.0, r, 2.0, ring, 1.0);
    p_disc(cx - r * 0.35, cy - r * 0.4 + pk * 2.0, r * 0.22, C_WHITE, 0.35);
    num_y: f32 = cy + pk * 2.0;
    if (lock != 0) draw_icon(I_LOCK, cx, num_y + 1.0, 9.0, C_FAINT, 1.0) else if (ml_solved[k]) draw_icon(I_CHECK,
        cx, num_y, 10.0, C_WHITE, 1.0) else {
        line_clear();
        line_int(i + 1);
        col: int = C_INK;
        if (next) col = C_WHITE;
        nw: f32 = p_line_w(1, 20.0);
        p_line_text(1, 20.0, cx - nw * 0.5, num_y + 7.0, col, 1.0)
    }
    // (Stars under it.)
    s: int = stars_for(k);
    if (ml_solved[k]) {
        for j in 0..3 {
            col: int = C_LINE;
            if (j < s) col = C_GOLD;
            draw_icon(I_STAR, cx + (j as f32 - 1.0) * 15.0, cy0 + r + 14.0, 6.0, col,
                1.0)
        }
    }
    // (The title on the side with room.)
    right: bool = cx < x + w * 0.5;
    room: f32 = w * 0.5 + absf(cx - x - w * 0.5) - r - 30.0;
    room = minf(room, w * 0.62);
    ts: f32 = 17.0;
    tw: f32 = p_sym_w(1, ts, ml_title[k]);
    if (tw > room) {
        ts = ts * room / tw;
        tw = room
    }
    tx: f32 = cx + r + 14.0;
    if (!right) tx = cx - r - 14.0 - tw;
    tc: int = C_INK;
    if (lock != 0) tc = C_MUTED;
    p_sym(1, ts, tx, cy0 + 6.0, ml_title[k], tc, 1.0);
    if (lock != 0) {
        line_clear();
        line_add("Prove ");
        line_sym(lock);
        line_add(" first");
        lw: f32 = p_line_w(0, 12.0);
        lx: f32 = tx;
        if (!right) lx = tx + tw - lw;
        p_line_text(0, 12.0, lx, cy0 + 24.0, C_FAINT, 1.0)
    }
    bx0: f32 = minf(cx - r, tx) - 6.0;
    bx1: f32 = maxf(cx + r, tx + tw) + 6.0;
    add_button(id, bx0, cy0 - r - 4.0, bx1, cy0 + r + 6.0)
}

// ---- a level ----
// From the top: the bar (back, the rules, the title, the bulb, undo; under
// the title the par dots and a pip for each goal), the picture, the facts
// (newest at the bottom), the goal (pinned above the hand), and the hand.
// Where things were drawn, kept for what flies between them.
goal_rx: f32 = 0.0;

goal_ry: f32 = 0.0;

goal_rw: f32 = 0.0;

goal_rh: f32 = 0.0;

fact_rx: f32 = 0.0;

fact_ry: f32 = 0.0;

fact_rw: f32 = 0.0;

fact_rh: f32 = 0.0;

fact_seen: bool = false;

row_ry: []f32 = new f32[64](0.0);

row_rh: []f32 = new f32[64](0.0);

pip_x: []f32 = new f32[64](0.0);

pip_y: f32 = 0.0;

// When each pip came (it pops in), how many there were last frame, and
// when each may show filled (a goal closing flies into it first).
pip_born: []f32 = new f32[64](-10.0);

pips_seen: int = 0;

pip_fill_t: []f32 = new f32[64](-10.0);

// The picture's height now (it shrinks to a strip when the facts need
// room), and how many facts there were (a new one scrolls them down).
pic_h_now: f32 = 200.0;

facts_seen_n: int = 0;

draw_level() {
    n: int = play_node();
    // (Done: the last goal worked on stays in sight under the Q.E.D.)
    if (n < 0 && mv_n > 0) n = last_node;
    if (n >= 0 && done_t < 0.0) last_node = n;
    // (A close being staged: the goal as the move left it.)
    stg: bool = staging();
    if (stg) n = stage_node;
    // (The last goal flashing shut: its facts fade and slide down.)
    fading: bool = done_t >= 0.0 && !stg && stage_node >= 0 && now_t < close_t + FACTS_AWAY;
    if (fading) {
        n = stage_node;
        busy = true
    }
    fade_k: f32 = 0.0;
    if (fading) fade_k = clampf((now_t - close_t) / FACTS_AWAY, 0.0, 1.0);
    x: f32 = col_x();
    w: f32 = col_w();
    morph_fast = now_t - undo_t < 0.2;
    if (intro_open && now_t - intro_t0 > 1.55) intro_open = false;
    hy: f32 = safe_top + 30.0;
    top: f32 = draw_level_bar(x, w, hy);
    // (The hand first laid out: how tall it is says where the board ends.)
    hand_h: f32 = hand_layout(w);
    hand_top: f32 = view_h() - safe_bottom - hand_h;
    // (Finished: the board stays where it was.)
    if (done_t >= 0.0) hand_top = hand_top_y;
    board_bot: f32 = hand_top - 14.0;
    level_open();
    deck: int = mini(open_n - 1, 2);
    if (deck < 0) deck = 0;
    g: int = 0;
    if (n >= 0) g = pn_goal[n];
    // (The facts, laid out: how much room they want.)
    // (Finished: the facts are put away under the trophy.)
    fn: int = 0;
    if (n >= 0 && (done_t < 0.0 || stg || fading)) fn = gl_hypn[g];
    if ((stg || fading) && stage_virtual) fn = fn + 1;
    gc: int = 0;
    if (n >= 0) gc = gl_concl[g];
    if (stg) gc = stage_concl;
    fh: f32 = 0.0;
    for i in 0..fn {
        h: int = board_fact(g, i);
        e: int = lay_fact(h, w);
        fact_e[i] = e;
        fh = fh + fact_card_h(h, e) + 8.0
    }
    if (fn > 0) fh = fh + 22.0;
    // (The goal: big when there is room, else its usual size.)
    ge: int = -1;
    gh: f32 = 0.0;
    gh_big: f32 = 0.0;
    gh_small: f32 = 0.0;
    e_big: int = -1;
    e_small: int = -1;
    if (n >= 0) {
        e_big = lay_term(gc, 32.0, w - 40.0, SLOT_GOAL);
        gh_big = ex_h[e_big] + 30.0;
        e_small = lay_term(gc, 23.0, w - 36.0, SLOT_GOAL);
        gh_small = ex_h[e_small] + 24.0
    }
    // (Laid out from the bottom: the hand, the goal pinned just above it,
    // the facts above that; the picture, or in logic the level's words and
    // its tiles, has the room that is left.)
    say_s: int = 0;
    if (region_picture == 0 && cur_level >= 0) say_s = lv_intro[cur_level];
    say_h: f32 = 0.0;
    if (say_s != 0) say_h = draw_wrapped(0, 19.0, 0.0, 0.0, w - 48.0, say_s, C_INK,
        0.0) + 50.0;
    gap: f32 = 0.0;
    if (fn > 0) gap = 14.0;
    deck_h: f32 = 22.0 + deck as f32 * 7.0;
    pic_min: f32 = 0.0;
    pic_good: f32 = say_h + LT_TILE + 40.0;
    if (region_picture != 0) {
        pic_min = 110.0;
        pic_good = minf(w * 0.5, 200.0);
        if (region_picture == sym("square")) pic_good = 150.0
    }
    room: f32 = board_bot - top - 12.0;
    big: bool = fh + gap + deck_h + gh_big + pic_good <= room;
    need: f32 = fh + gap + deck_h + gh_small;
    if (big) need = fh + gap + deck_h + gh_big;
    fit: bool = need + pic_min <= room;
    want: f32 = maxf(room - need, pic_min);
    // (Not taller than it is wide-ish: what is left over then sits half
    // above it and half below.)
    pic_cap: f32 = view_h();
    slack: f32 = maxf(want - pic_cap, 0.0);
    want = want - slack;
    if (done_t >= 0.0) {
        // (Finished: as it was.)
        big = done_big;
        fit = done_fit;
        want = done_want
    } else {
        done_big = big;
        done_fit = fit;
        done_want = want
    }
    ge = e_small;
    gh = gh_small;
    if (big) {
        ge = e_big;
        gh = gh_big
    }
    if (an_jump) pic_h_now = want else pic_h_now = ease_to(pic_h_now, want, 10.0);
    ph: f32 = pic_h_now;
    if (done_t < 0.0) done_slack = slack else slack = done_slack;
    top = top + slack * 0.5;
    area_top: f32 = top;
    pic_bottom_y = 0.0;
    if (region_picture != 0) {
        draw_picture(x, top, w, ph);
        area_top = top + ph + 12.0;
        pic_bottom_y = top + ph
    } else if (ph >= say_h && say_h > 0.0) {
        draw_logic_pic(x, top, w, ph, say_s);
        area_top = top + ph + 12.0;
        pic_bottom_y = top + ph
    }
    goal_y: f32 = board_bot - gh;
    area_bot: f32 = goal_y - deck as f32 * 7.0 - 24.0;
    y0: f32 = 0.0;
    if (fit) {
        y0 = goal_y - deck as f32 * 7.0 - 22.0 - gap - fh;
        sc_pos[V_LEVEL] = 0.0
    } else {
        if (fn != facts_seen_n && fn > facts_seen_n) sc_pos[V_LEVEL] = maxf(0.0, fh - (area_bot - area_top));
        y0 = area_top - sc_pos[V_LEVEL] + maxf(area_bot - area_top - fh, 0.0)
    }
    facts_seen_n = fn;
    focus_s: int = focus_slot();
    if (stg) focus_s = -1;
    if (!fit) p_clip(0.0, area_top, view_w(), area_bot);
    y: f32 = y0;
    fact_seen = false;
    sf_seen = false;
    if (fn > 0) {
        y = y + 22.0;
        for i in 0..fn {
            h: int = board_fact(g, i);
            e: int = fact_e[i];
            eh: f32 = fact_card_h(h, e);
            slot: int = hyp_slot(h);
            cy: f32 = card_y(slot, y) + fade_k * fade_k * 40.0;
            ca: f32 = card_a * (1.0 - fade_k);
            if (i == 0) p_str(1, 12.0, x + 6.0, cy - 9.0, "YOU HAVE", C_MUTED, 1.0 - fade_k);
            // (A new fact flying in from its row: its card waits for it.)
            flying: bool = fly_term == h && fly_fact && now_t - fly_t < FLY_TIME;
            focused: bool = slot == focus_s;
            fill: int = C_BLUE_SOFT;
            if (fact_squeezed(h)) fill = mix_rgb(C_BLUE_SOFT, C_BG, 0.45);
            if (focused) fill = mix_rgb(C_BLUE_SOFT, C_WHITE, 0.5);
            if (flying) ca = 0.0;
            p_box(x, cy, w, eh, minf(16.0, eh * 0.5), fill, ca);
            if (focused) p_outline(x, cy, w, eh, minf(16.0, eh * 0.5), 2.5, C_PICK,
                ca);
            if (slot == focus_s) {
                add_button(B_EXPR_SLOT, x, y, x + w, y + eh);
                set_pick(slot)
            }
            pad: f32 = 6.0;
            if (fact_quiet(h)) pad = 3.0;
            if (fact_squeezed(h)) pad = (eh - ex_h[e]) * 0.5;
            draw_board = true;
            if (!flying) draw_expr(e, x + 16.0, cy + pad, C_INK, ca, true);
            draw_board = false;
            add_button(B_EXPR + e, x, y, x + w, y + eh);
            if (focused) draw_nubs(x, cy, w, eh);
            if (h == side_fact && side_fact != 0) draw_side_tick(x, cy, w, eh, ca);
            if (fly_term == h) {
                fact_rx = x + 16.0;
                fact_ry = cy + pad;
                fact_size = ex_size[e];
                fact_seen = true
            }
            // (A split's part closing with this fact: it pulses as its
            // copy goes.)
            if (split_on()) {
                for si in 0..mini(sp_n, 4) {
                    if (sp_fact[si] == h) {
                        sp_fx[si] = x + 16.0;
                        sp_fy[si] = cy + pad;
                        sp_fs[si] = ex_size[e];
                        sp_fseen[si] = true;
                        st: f32 = now_t - (sp_t[si] - COPY_TIME);
                        if (st > 0.0 && st < COPY_TIME) p_outline(x - 3.0, cy - 3.0,
                            w + 6.0, eh + 6.0, minf(19.0, eh * 0.5 + 3.0), 2.5 + 2.0 * sinf(st / COPY_TIME * 3.1416),
                            C_GOLD, 0.9)
                    }
                }
            }
            if (stg && h == stage_fact) {
                // (The fact that closes the goal: it pulses as its copy goes.)
                sf_x = x + 16.0;
                sf_y = cy + pad;
                sf_size = ex_size[e];
                sf_seen = true;
                ct: f32 = now_t - (close_t - COPY_TIME);
                if (ct > 0.0 && !flying) p_outline(x - 3.0, cy - 3.0, w + 6.0, eh + 6.0,
                    minf(19.0, eh * 0.5 + 3.0), 2.5 + 2.0 * sinf(clampf(ct / COPY_TIME,
                    0.0, 1.0) * 3.1416), C_GOLD, 0.9)
            }
            y = y + eh + 8.0
        }
    }
    if (fit) sc_most[V_LEVEL] = 0.0 else sc_most[V_LEVEL] = y + sc_pos[V_LEVEL] - area_bot + 6.0;
    if (!fit) p_noclip();
    // (The goal; not when it has closed for good.)
    if (split_on()) {
        p_str(1, 12.0, x + 6.0, goal_y - 10.0, "SHOW", C_MUTED, 1.0);
        draw_split(x, goal_y, w, gh);
        goal_ex = -1
    } else if (ge >= 0 && (done_t < 0.0 || stg)) {
        for d0 in 0..deck {
            d: int = deck - d0;
            dy: f32 = d as f32 * 7.0;
            inset: f32 = d as f32 * 10.0;
            p_shadow(x + inset, goal_y - dy, w - 2.0 * inset, gh, 20.0, 2.0, 8.0,
                0.1);
            p_box(x + inset, goal_y - dy, w - 2.0 * inset, gh, 20.0, mix_rgb(C_CARD,
                C_SUNK, 0.4 + 0.2 * d as f32), 1.0);
            p_outline(x + inset, goal_y - dy, w - 2.0 * inset, gh, 20.0, 1.5, C_LINE,
                1.0)
        }
        gy: f32 = card_y(SLOT_GOAL, goal_y);
        p_str(1, 12.0, x + 6.0, gy - deck as f32 * 7.0 - 10.0, "SHOW", C_MUTED, 1.0);
        focused: bool = focus_s == SLOT_GOAL;
        // (A goal closing squashes and flashes gold.)
        sq: f32 = 0.0;
        ct: f32 = now_t - close_t;
        if (ct >= 0.0 && ct < 0.3) {
            sq = sinf(ct / 0.3 * 3.1416) * 0.05;
            busy = true
        }
        gx: f32 = x - w * sq * 0.5;
        gw: f32 = w * (1.0 + sq);
        p_shadow(gx, gy, gw, gh, 20.0, 4.0, 14.0, 0.16);
        p_box(gx, gy, gw, gh, 20.0, C_CARD, 1.0);
        // (Brown, thick: only the focus is orange.)
        bord: int = mix_rgb(C_LINE, C_MUTED, 0.45);
        th: f32 = 3.0;
        if (focused) bord = C_PICK;
        p_outline(gx, gy, gw, gh, 20.0, th, bord, 1.0);
        if (focused) {
            add_button(B_EXPR_SLOT, x, goal_y, x + w, goal_y + gh);
            set_pick(SLOT_GOAL)
        }
        // (A changed part flying in from its row: its block waits.)
        hide_term = 0;
        ft: f32 = (now_t - fly_t) / FLY_TIME;
        if (ft >= 0.0 && ft < 1.0 && fly_hl != 0 && !fly_fact && fly_hl_seen) {
            hide_term = fly_hl;
            hide_slot = SLOT_GOAL
        }
        draw_board = true;
        draw_expr(ge, x + 20.0, gy + (gh - ex_h[ge]) * 0.5, C_INK, 1.0, true);
        draw_board = false;
        hide_term = 0;
        add_button(B_EXPR + ge, x, goal_y, x + w, goal_y + gh);
        if (focused) draw_nubs(x, gy, w, gh);
        goal_ex = ge;
        // (The peeking goals, tapped, come forward.)
        k: int = 0;
        for i in 0..open_n {
            if (open_nodes[i] != n && k < deck) {
                k = k + 1;
                dy: f32 = k as f32 * 7.0;
                add_button(B_DECK + i, x, goal_y - dy - 4.0, x + w, goal_y - dy + 7.0)
            }
        }
        goal_ry = gy
    } else goal_ex = -1;
    if (done_t < 0.0) {
        goal_rx = x;
        goal_rw = w;
        goal_rh = gh;
        if (ge < 0) goal_ry = goal_y
    }
    leavers_step();
    pick_slot = 0;
    hand_top_y = hand_top;
    bar_bottom_y = top;
    if (done_t >= 0.0) {
        // (The last move made: the hand slides down and away.)
        if (hand_leaving()) {
            busy = true;
            draw_hand(x, w, hand_top + hand_away() * (hand_h + 60.0), hand_h);
            p_noclip()
        }
    } else draw_hand(x, w, hand_top, hand_h);
    draw_fly();
    draw_copy();
    draw_close();
    if (now_t - say_t < 3.5 && cur_level >= 0 && lv_intro[cur_level] != 0) draw_say(x,
        w, hy + 46.0);
    if (done_t >= 0.0) draw_done(x, w);
    draw_intro(x, w);
    draw_demo_words(x, w);
    draw_ghost()
}

// A side condition arithmetic closed (0 < ε/2) as the move giving the fact
// on card (x, y, w, h) was made: a small chip at the card's right end that
// pops in, ticks, and goes.
draw_side_tick(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    a0: f32
) {
    t: f32 = now_t - side_t;
    if (t < 0.0) {
        busy = true;
        return
    }
    if (t > 0.9) return;
    busy = true;
    k: f32 = clampf(t / 0.16, 0.0, 1.0);
    s: f32 = (1.0 + 0.25 * sinf(k * 3.1416)) * k;
    a: f32 = a0 * clampf((0.9 - t) / 0.25, 0.0, 1.0);
    an_live = false;
    e: int = lay_term(side_term, 13.0, w * 0.5, 9300000);
    an_live = true;
    if (e < 0) return;
    pw: f32 = ex_w[e] + 40.0;
    ph: f32 = ex_h[e] + 10.0;
    cx: f32 = x + w - 10.0 - pw * 0.5;
    cy: f32 = y + h * 0.5;
    p_shadow(cx - pw * 0.5 * s, cy - ph * 0.5 * s, pw * s, ph * s, ph * 0.5 * s, 2.0,
        6.0, 0.15 * a);
    p_box(cx - pw * 0.5 * s, cy - ph * 0.5 * s, pw * s, ph * s, ph * 0.5 * s, C_GOLD_SOFT,
        a);
    if (s > 0.6) {
        an_live = false;
        draw_expr(e, cx - pw * 0.5 + 8.0, cy - ex_h[e] * 0.5, C_INK, a, false);
        an_live = true;
        tk: f32 = clampf((t - 0.12) / 0.14, 0.0, 1.0);
        ts: f32 = (1.0 + 0.4 * sinf(tk * 3.1416)) * tk;
        tx: f32 = cx + pw * 0.5 - 14.0;
        p_disc(tx, cy, 8.0 * ts, C_GOLD, a);
        draw_icon(I_CHECK, tx, cy, 5.0 * ts, C_WHITE, a)
    }
}

// The board's fact i: goal g's, then (a close staged) the fact the move
// gave that closed the goal at once.
board_fact(g: int, i: int): int {
    if (i >= gl_hypn[g]) return stage_fact;
    goal_hyp(g, i)
}

// How the board was laid out when the level was finished (kept).
done_big: bool = false;

done_fit: bool = true;

done_want: f32 = 0.0;

// The goal's expression drawn this frame (-1 none), and the fact flown
// to: its writing's size.
goal_ex: int = -1;

fact_size: f32 = 18.0;

done_slack: f32 = 0.0;

// Where the picture ends (0: none shown).
pic_bottom_y: f32 = 0.0;

// Where the bar ends (toasts show just under it).
bar_bottom_y: f32 = 80.0;

fact_e: []int = new int[256](0);

last_node: int = 0;

// Where the hand starts (a finger below it scrolls the hand).
hand_top_y: f32 = 10000.0;

// A fact laid out: small, on one line, if it has not been touched lately.
lay_fact(h: int, w: f32): int {
    if (fact_squeezed(h)) {
        lay_one_line = true;
        e: int = lay_term(h, 12.5, w - 28.0, hyp_slot(h));
        lay_one_line = false;
        return e
    }
    if (fact_quiet(h)) {
        lay_one_line = true;
        e: int = lay_term(h, 14.0, w - 28.0, hyp_slot(h));
        lay_one_line = false;
        return e
    }
    lay_term(h, 18.0, w - 32.0, hyp_slot(h))
}

fact_card_h(h: int, e: int): f32 {
    if (fact_squeezed(h)) return maxf(ex_h[e], 22.0);
    if (fact_quiet(h)) return ex_h[e] + 6.0;
    ex_h[e] + 12.0
}

// The cursor's block shown picked (it alone is outlined).
set_pick(slot: int) {
    if (cur_at > 0 && cur_at < pc_n) {
        pick_slot = slot;
        pick_key = pc_key[cur_at]
    } else pick_slot = 0
}

// The ‹ › nubs on the focused card: the cursor steps through its parts.
draw_nubs(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    if (pc_n <= 1 || chip_row >= 0) return;
    cy: f32 = y + h * 0.5;
    for side in 0..2 {
        cx: f32 = x + 2.0;
        id: int = B_CUR_PREV;
        icon: int = I_BACK;
        if (side == 1) {
            cx = x + w - 2.0;
            id = B_CUR_NEXT;
            icon = I_NEXT
        }
        k: f32 = pressed(id);
        r: f32 = 11.0 - k * 1.5;
        p_shadow(cx - r, cy - r, 2.0 * r, 2.0 * r, r, 1.5, 4.0, 0.14);
        p_disc(cx, cy, r, C_PICK, 1.0);
        draw_icon(icon, cx, cy, 5.5, C_WHITE, 1.0);
        add_button(id, cx - 16.0, cy - 18.0, cx + 16.0, cy + 18.0)
    }
}

// The bar: back, the rules, the title (tap: its words again), the bulb,
// undo; under the title, a dot for each move of par and a pip for each
// goal. Where what is under it starts.
draw_level_bar(x: f32, w: f32, hy: f32): f32 {
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    round_button(B_RULES, x + 70.0, hy, I_BOOK);
    // (The bulb breathes when the player has been still a while.)
    idle: bool = now_t - last_input_t > 12.0 && done_t < 0.0 && !watching;
    bx: f32 = x + w - 70.0;
    if (idle) {
        p_glow(bx, hy, 26.0 + sinf(now_t * 2.6) * 3.0, 8.0, C_GOLD, 0.35);
        busy = true
    }
    round_button(B_HINT, bx, hy, I_BULB);
    ux: f32 = x + w - 22.0;
    if (now_t - undo_pulse_t < 2.4) {
        p_glow(ux, hy, 26.0 + sinf((now_t - undo_pulse_t) * 9.0) * 3.0, 6.0, C_PICK,
            0.45);
        busy = true
    }
    round_button(B_UNDO, ux, hy, I_UNDO);
    if (playing >= 0) {
        tsize: f32 = 18.0;
        room: f32 = w - 2.0 * 96.0;
        tw: f32 = p_sym_w(1, tsize, ml_title[playing]);
        if (tw > room) {
            tsize = tsize * room / tw;
            tw = room
        }
        p_sym(1, tsize, x + w * 0.5 - tw * 0.5, hy + 2.0, ml_title[playing], C_INK,
            1.0);
        add_button(B_TITLE, x + w * 0.5 - room * 0.5, hy - 18.0, x + w * 0.5 + room * 0.5,
            hy + 8.0)
    }
    // (Par dots: hollow for each move of par, orange as they are made, grey
    // past par. Then a pip for each goal, gold when closed.)
    par: int = 0;
    if (playing >= 0) par = ml_par[playing];
    over: int = mini(maxi(moves_made - par, 0), 6);
    lf_n = 0;
    if (pn_n > 0) leaves(root);
    nd: int = par + over;
    gap: f32 = 13.0;
    // (The goals' squares sit apart from the dots, on a soft pill of their
    // own, and are bigger.)
    ps: f32 = 13.0;
    pgap: f32 = 19.0;
    np: int = 0;
    for i in 0..lf_n np = np + pips_of(lf_node[i]);
    pill_w: f32 = np as f32 * pgap + 12.0;
    total: f32 = nd as f32 * gap + 22.0 + pill_w;
    dx: f32 = x + w * 0.5 - total * 0.5 + 5.0;
    dy: f32 = hy + 24.0;
    for i in 0..nd {
        cx: f32 = dx + i as f32 * gap;
        if (i < mini(moves_made, par)) p_disc(cx, dy, 4.5, C_PICK, 1.0) else if (i >= par) p_disc(cx,
            dy, 4.5, C_FAINT, 1.0) else p_ring(cx, dy, 4.0, 1.5, C_FAINT, 1.0)
    }
    px0: f32 = dx + nd as f32 * gap + 14.0;
    if (np > 0) p_box(px0, dy - 12.0, pill_w, 24.0, 12.0, mix_rgb(C_GOLD_SOFT, C_BG,
        0.3), 1.0);
    px: f32 = px0 + 6.0 + pgap * 0.5;
    // (A goal new since last frame pops in.)
    if (np > pips_seen && !an_jump) {
        for i in pips_seen..mini(np, 64) pip_born[i] = now_t
    }
    if (np < pips_seen || an_jump) {
        for i in 0..64 pip_born[i] = -10.0
    }
    pips_seen = np;
    // (Closed first, then open: the next to close is the first hollow.)
    k: int = 0;
    pip_y = dy;
    for pass in 0..2 {
        for i in 0..lf_n {
            nd2: int = lf_node[i];
            closed: bool = pn_thm[nd2] != 0;
            if (closed == (pass == 0)) {
                for _j in 0..pips_of(nd2) {
                    cx: f32 = px + k as f32 * pgap;
                    if (k < len(pip_x)) pip_x[k] = cx;
                    // (A pip fills when its goal's card has flown into it.)
                    fill: bool = closed && !(k == close_pip && now_t - close_t < 0.62);
                    if (k < 64 && now_t < pip_fill_t[k]) fill = false;
                    sz: f32 = ps * 0.5;
                    if (k < 64) {
                        bt: f32 = now_t - pip_born[k];
                        if (bt >= 0.0 && bt < 0.45) {
                            // (Swelling in, a little past its size and back.)
                            q: f32 = bt / 0.45;
                            sz = sz * (q * (1.0 + 0.5 * sinf(q * 3.1416)));
                            busy = true
                        }
                    }
                    if (fill) {
                        p_box_at(cx, dy, sz, sz, 3.5, C_GOLD, 1.0);
                        m: int = pn_move[nd2];
                        if (m >= 0 && mv_kind[m] == MV_CALC) p_disc(cx, dy, 2.2, C_WHITE,
                            1.0)
                    } else {
                        p_box_at(cx, dy, sz, sz, 3.5, C_CARD, 1.0);
                        p_outline(cx - sz, dy - sz, 2.0 * sz, 2.0 * sz, 3.5, 2.0,
                            C_GOLD, 1.0)
                    }
                    k = k + 1
                }
            }
        }
    }
    hy + 40.0
}

// ---- the hand ----
// Laid out before the board (its height says where the goal goes): the
// rows' terms, each on one line. Its height.
hand_e: []int = new int[64](0);

hand_e2: []int = new int[64](0);

hand_layout(w: f32): f32 {
    if (done_t >= 0.0 && !hand_leaving()) return 24.0;
    an_live = false;
    hgt: f32 = 22.0;
    if (chip_row >= 0) {
        // (The chips: a row for each term, the term on the left, what it
        // gives on the right.)
        hgt = 58.0;
        for k in 0..mini(chips_shown(), 63) {
            lay_one_line = true;
            e: int = lay_term(wc_term[k], 19.0, w * 0.4, 6000000 + k * 2);
            hand_e[k] = e;
            hand_e2[k] = -1;
            if (ch_ok[k] && ch_res[k] != 0) {
                mw: f32 = w - ex_w[e] - 76.0;
                if (ch_closes[k]) mw = mw - 30.0;
                hand_e2[k] = lay_term(ch_res[k], 17.0, mw, 6000000 + k * 2 + 1)
            }
            lay_one_line = false;
            hgt = hgt + chip_row_h(k) + 8.0
        }
        if (chips_shown() < wc_n) hgt = hgt + 50.0;
        an_live = true;
        return minf(hgt + 16.0, view_h() * 0.56)
    }
    shown: int = hand_shown();
    for q in 0..mini(shown, 63) {
        r: int = hd_order[q];
        hand_e[q] = -1;
        hand_e2[q] = -1;
        lay_one_line = true;
        if (hd_res[r] != 0) {
            mw: f32 = w - 36.0;
            if (hd_res2[r] != 0) mw = (w - 60.0) * 0.6;
            hand_e[q] = lay_term(hd_res[r], 18.0, mw, 5000000 + q * 2);
            s2: f32 = 15.0;
            if (hd_ticks[r]) s2 = 18.0;
            if (hd_res2[r] != 0) hand_e2[q] = lay_term(hd_res2[r], s2, w - 60.0 - ex_w[hand_e[q]],
                5000000 + q * 2 + 1)
        } else if (hd_wit[r] && cd_kind_of_row(r) == C_REWRITE) hand_e[q] = lay_words(hd_label[r],
            18.0, 5000000 + q * 2);
        lay_one_line = false;
        hgt = hgt + row_h(q) + 8.0
    }
    if (hand_has_more()) hgt = hgt + 42.0 + 8.0;
    if (more_open) hgt = hgt + 46.0;
    if (shown == 0) hgt = hgt + 66.0 + 8.0;
    an_live = true;
    minf(hgt + 6.0, view_h() * 0.52)
}

chip_row_h(k: int): f32 {
    eh: f32 = ex_h[hand_e[k]];
    if (hand_e2[k] >= 0) eh = maxf(eh, ex_h[hand_e2[k]]);
    maxf(eh + 22.0, 56.0)
}

// Whether row r's move is a rewrite (its words are a term with holes).
cd_kind_of_row(r: int): int {
    if (hd_whole[r] && hd_verb[r] == hd_label[r]) return C_BACK;
    C_REWRITE
}

row_h(q: int): f32 {
    e: int = hand_e[q];
    eh: f32 = 29.0;
    if (e >= 0) eh = ex_h[e];
    maxf(26.0 + eh + 6.0, 52.0)
}

draw_hand(
    x: f32,
    w: f32,
    top: f32,
    h: f32
) {
    if (done_t >= 0.0 && !hand_leaving()) return;
    // (A sheet, its rows pudgy pills on it.)
    p_shadow(0.0, top, view_w(), h + safe_bottom + 40.0, 26.0, -3.0, 18.0, 0.16);
    p_box(0.0, top, view_w(), h + safe_bottom + 40.0, 26.0, mix_rgb(C_BG, C_SUNK,
        0.6), 1.0);
    an_live = false;
    if (chip_row >= 0) {
        draw_chips(x, w, top);
        an_live = true;
        return
    }
    hy0: f32 = top;
    if (more_open) {
        // (Every move shown: a way back to the few, as the chips have.)
        k0: f32 = pressed(B_MORE_BACK);
        p_disc(x + 20.0, top + 30.0, 17.0 - k0 * 1.5, C_WHITE, 1.0);
        draw_icon(I_BACK, x + 20.0, top + 30.0, 7.5, C_INK, 1.0);
        p_str(1, 13.0, x + 48.0, top + 35.0, "ALL MOVES", C_MUTED, 1.0);
        add_button(B_MORE_BACK, x, top + 8.0, x + 160.0, top + 52.0);
        hy0 = top + 46.0
    }
    p_clip(0.0, hy0 + 6.0, view_w(), view_h());
    y: f32 = hy0 + 14.0 - sc_pos[V_TRAY];
    shown: int = hand_shown();
    for q in 0..mini(shown, 63) {
        r: int = hd_order[q];
        rh: f32 = row_h(q);
        row_ry[q] = y;
        row_rh[q] = rh;
        draw_row(q, r, x, y, w, rh);
        y = y + rh + 8.0
    }
    if (shown == 0) {
        // (Nothing here: one soft row, the cursor's only words.)
        msg: str = "Nothing to tidy here. Swipe to choose a place to put something in.";
        if (cur_at > 0) msg = "Nothing fits this part. Swipe on, or tap it again for the whole.";
        p_box(x, y, w, 66.0, 22.0, mix_rgb(C_SUNK, C_BG, 0.3), 1.0);
        p_outline(x, y, w, 66.0, 22.0, 1.5, C_LINE, 1.0);
        draw_icon(I_BACK, x + 22.0, y + 33.0, 8.0, C_FAINT, 1.0);
        draw_icon(I_NEXT, x + w - 22.0, y + 33.0, 8.0, C_FAINT, 1.0);
        draw_wrapped(0, 15.0, x + 42.0, y + 28.0, w - 84.0, sym(msg), C_MUTED, 1.0);
        y = y + 66.0 + 8.0
    }
    if (hand_has_more()) {
        k: f32 = pressed(B_MORE);
        line_clear();
        line_add("More moves (");
        line_int(hd_n - shown);
        line_add(")");
        p_box(x + w * 0.5 - 90.0, y + k * 2.0, 180.0, 42.0, 21.0, mix_rgb(C_WHITE,
            C_SUNK, k), 1.0);
        p_outline(x + w * 0.5 - 90.0, y + k * 2.0, 180.0, 42.0, 21.0, 1.5, C_LINE,
            1.0);
        lw: f32 = p_line_w(1, 15.0);
        p_line_text(1, 15.0, x + w * 0.5 - lw * 0.5, y + 26.0 + k * 2.0, C_MUTED,
            1.0);
        add_button(B_MORE, x + w * 0.5 - 90.0, y, x + w * 0.5 + 90.0, y + 42.0);
        y = y + 50.0
    }
    sc_most[V_TRAY] = y + sc_pos[V_TRAY] - view_h() + safe_bottom + 10.0;
    p_noclip();
    an_live = true
}

// One row: its verb, what it gives (the changed part tinted), pressed
// squashed a little.
draw_row(
    q: int,
    r: int,
    x0: f32,
    y0: f32,
    w0: f32,
    h0: f32
) {
    id: int = B_ROW + q;
    k: f32 = pressed(id);
    s: f32 = 1.0 - 0.06 * k;
    w: f32 = w0 * s;
    h: f32 = h0 * s;
    x: f32 = x0 + (w0 - w) * 0.5;
    y: f32 = y0 + (h0 - h) * 0.5;
    fill: int = C_WHITE;
    if (hd_fact[r]) fill = mix_rgb(C_BLUE_SOFT, C_WHITE, 0.3);
    if (hd_closes[r]) fill = C_GOLD_SOFT;
    if (hd_back[r]) fill = mix_rgb(C_SUNK, C_BG, 0.3);
    if (hint_row == r) {
        g: f32 = 0.5 + 0.5 * sinf((now_t - hint_t) * 5.0);
        p_shape(x - 4.0, y - 4.0, w + 8.0, h + 8.0, 26.0, 8.0, 0.0, C_GOLD, 0.45 + 0.3 * g);
        busy = true
    }
    p_shadow(x, y, w, h, 22.0, 3.0 - k * 2.0, 8.0 - k * 4.0, 0.16);
    p_box(x, y, w, h, 22.0, fill, 1.0);
    vc: int = C_PICK;
    if (hd_tool[r]) vc = C_GOLD;
    if (hd_closes[r]) vc = mix_rgb(C_GOLD, C_INK, 0.25);
    if (hd_back[r]) vc = C_MUTED;
    p_sym(1, 13.0, x + 18.0, y + 19.0, hd_verb[r], vc, 1.0);
    if (hd_tool[r]) p_str(0, 12.0, pen_end + 8.0, y + 19.0, "your theorem", C_GOLD,
        1.0);
    // (What it gives: closes the goal, or the statement as it will be.)
    if (hd_closes[r]) {
        cx: f32 = x + w - 24.0;
        p_disc(cx, y + 16.0, 9.0, C_GOLD, 1.0);
        draw_icon(I_CHECK, cx, y + 16.0, 5.5, C_WHITE, 1.0);
        word: str = "closes it";
        if (hd_calc[r]) word = "by arithmetic";
        ww: f32 = p_str_w(0, 12.0, word);
        p_str(0, 12.0, cx - 14.0 - ww, y + 20.0, word, C_MUTED, 1.0)
    }
    e: int = hand_e[q];
    if (e < 0 && hd_wit[r]) {
        // (A term to pick: an empty slot for it.)
        p_outline(x + 18.0, y + 27.0, 34.0, 23.0, 7.0, 1.5, C_FAINT, 1.0);
        p_str_mid(1, 15.0, x + 35.0, y + 44.0, "?", C_FAINT, 1.0);
        p_str(0, 14.0, x + 62.0, y + 44.0, "pick a term", C_MUTED, 1.0)
    }
    if (e >= 0) {
        hl_key = 0;
        hl_seen = false;
        if (hd_hl[r] != 0) hl_key = hd_hl[r] * 16;
        if (hd_same[r]) {
            // (It closes: the two sides, the same, gold.)
            side: int = spine_arg(rel_core(hd_res[r]), 2, 0);
            hl_key = side * 16;
            hl_key2 = side * 16 + 1;
            hl_gold = true
        }
        if (hd_wit[r]) {
            draw_expr(e, x + 18.0, y + 24.0, C_INK, 1.0, false);
            // (Where the term goes is the hole; the words say so, top right.)
            ww: f32 = p_str_w(0, 12.0, "pick a term");
            p_outline(x + w - 40.0, y + 7.0, 22.0, 18.0, 6.0, 1.5, C_PICK, 1.0);
            p_str_mid(1, 12.0, x + w - 29.0, y + 20.0, "?", C_PICK, 1.0);
            p_str(0, 12.0, x + w - 48.0 - ww, y + 20.0, "pick a term", C_MUTED, 1.0)
        } else if (hd_back[r]) draw_expr(e, x + 18.0, y + 24.0, C_MUTED, 0.8, true) else draw_expr(e,
            x + 18.0, y + 24.0, C_INK, 1.0, true);
        if (q < 64) {
            row_ex_x[q] = x + 18.0;
            row_ex_y[q] = y + 24.0;
            row_ex_size[q] = ex_size[e];
            row_hl_seen[q] = hl_seen;
            row_hl_x[q] = hl_seen_x;
            row_hl_y[q] = hl_seen_y
        }
        hl_key = 0;
        hl_key2 = -1;
        hl_gold = false;
        e2: int = hand_e2[q];
        if (e2 >= 0) {
            ex: f32 = x + 18.0 + ex_w[e] + 12.0;
            if (hd_ticks[r]) ex = ex + 22.0;
            word: str = "and";
            if (hd_fact2[r]) word = "with";
            p_str(0, 12.0, ex, y + 24.0 + ex_h[e] * 0.5 + 4.0, word, C_MUTED, 1.0);
            ex = ex + p_str_w(0, 12.0, word) + 6.0;
            if (hd_fact2[r]) p_box(ex - 4.0, y + 24.0 + (ex_h[e] - ex_h[e2]) * 0.5,
                ex_w[e2] + 8.0, ex_h[e2], 8.0, C_BLUE_SOFT, 1.0);
            draw_expr(e2, ex, y + 24.0 + (ex_h[e] - ex_h[e2]) * 0.5, C_INK, 1.0, false);
            if (hd_ticks[r]) {
                // (Each part known already: ticked.)
                cy: f32 = y + 24.0 + ex_h[e] * 0.5;
                tx1: f32 = x + 18.0 + ex_w[e] + 8.0;
                tx2: f32 = ex + ex_w[e2] + 12.0;
                for i in 0..2 {
                    tx: f32 = tx1;
                    if (i == 1) tx = tx2;
                    p_disc(tx + 7.0, cy, 7.5, C_GOLD, 1.0);
                    draw_icon(I_CHECK, tx + 7.0, cy, 4.5, C_WHITE, 1.0)
                }
            }
        }
    }
    add_button(id, x0, y0, x0 + w0, y0 + h0)
}

// The chips: the terms a move can take, with the move's words above, each
// a pudgy row: the term, and the statement as it will be with the term
// tinted (gold if it closes the goal).
draw_chips(x: f32, w: f32, top: f32) {
    k0: f32 = pressed(B_CHIP_BACK);
    p_disc(x + 20.0, top + 30.0, 17.0 - k0 * 1.5, C_WHITE, 1.0);
    draw_icon(I_BACK, x + 20.0, top + 30.0, 7.5, C_INK, 1.0);
    add_button(B_CHIP_BACK, x, top + 8.0, x + 44.0, top + 52.0);
    label: int = hd_label[chip_row];
    p_str(1, 13.0, x + 48.0, top + 26.0, "PICK A TERM", C_MUTED, 1.0);
    p_sym(1, 16.0, x + 48.0, top + 45.0, label, C_PICK, 1.0);
    p_clip(0.0, top + 54.0, view_w(), view_h());
    y: f32 = top + 62.0 - sc_pos[V_TRAY];
    for k in 0..mini(chips_shown(), 63) {
        rh: f32 = chip_row_h(k);
        draw_chip_row(k, x, y, w, rh);
        y = y + rh + 8.0
    }
    if (chips_shown() < wc_n) {
        k: f32 = pressed(B_CHIP_MORE);
        line_clear();
        line_add("More terms (");
        line_int(wc_n - chips_shown());
        line_add(")");
        p_box(x + w * 0.5 - 90.0, y + k * 2.0, 180.0, 42.0, 21.0, mix_rgb(C_WHITE,
            C_SUNK, k), 1.0);
        p_outline(x + w * 0.5 - 90.0, y + k * 2.0, 180.0, 42.0, 21.0, 1.5, C_LINE,
            1.0);
        lw: f32 = p_line_w(1, 15.0);
        p_line_text(1, 15.0, x + w * 0.5 - lw * 0.5, y + 26.0 + k * 2.0, C_MUTED,
            1.0);
        add_button(B_CHIP_MORE, x + w * 0.5 - 90.0, y, x + w * 0.5 + 90.0, y + 42.0);
        y = y + 50.0
    }
    sc_most[V_TRAY] = y + sc_pos[V_TRAY] - view_h() + safe_bottom + 10.0;
    p_noclip()
}

// Chip k's row: its term in a soft chip on the left, then what it gives.
draw_chip_row(
    k: int,
    x0: f32,
    y0: f32,
    w0: f32,
    h0: f32
) {
    id: int = B_CHIP + k;
    pk: f32 = pressed(id);
    s: f32 = 1.0 - 0.06 * pk;
    w: f32 = w0 * s;
    h: f32 = h0 * s;
    x: f32 = x0 + (w0 - w) * 0.5;
    y: f32 = y0 + (h0 - h) * 0.5;
    fill: int = C_WHITE;
    if (ch_ok[k] && ch_fact[k]) fill = mix_rgb(C_BLUE_SOFT, C_WHITE, 0.3);
    if (ch_ok[k] && ch_closes[k]) fill = C_GOLD_SOFT;
    if (hint_chip_term() == wc_term[k] && wc_term[k] != 0) {
        g: f32 = 0.5 + 0.5 * sinf(now_t * 5.0);
        p_shape(x - 4.0, y - 4.0, w + 8.0, h + 8.0, 26.0, 8.0, 0.0, C_GOLD, 0.45 + 0.3 * g);
        busy = true
    }
    p_shadow(x, y, w, h, 22.0, 3.0 - pk * 2.0, 8.0 - pk * 4.0, 0.16);
    p_box(x, y, w, h, 22.0, fill, 1.0);
    // (The term, in its chip.)
    e: int = hand_e[k];
    tw: f32 = ex_w[e] + 24.0;
    th: f32 = ex_h[e] + 10.0;
    p_box(x + 10.0, y + (h - th) * 0.5, tw, th, minf(14.0, th * 0.5), C_PICK_SOFT,
        1.0);
    p_outline(x + 10.0, y + (h - th) * 0.5, tw, th, minf(14.0, th * 0.5), 1.5, mix_rgb(C_PICK_SOFT,
        C_PICK, 0.5), 1.0);
    draw_expr(e, x + 22.0, y + (h - ex_h[e]) * 0.5, C_INK, 1.0, false);
    // (What it gives.)
    e2: int = hand_e2[k];
    ex: f32 = x + 10.0 + tw + 16.0;
    if (e2 >= 0) {
        hl_key = ch_hl[k] * 16;
        hl_seen = false;
        if (ch_same[k]) {
            side: int = spine_arg(rel_core(ch_res[k]), 2, 0);
            hl_key = side * 16;
            hl_key2 = side * 16 + 1;
            hl_gold = true
        }
        ey: f32 = y + (h - ex_h[e2]) * 0.5;
        draw_expr(e2, ex, ey, C_INK, 1.0, false);
        if (k < 64) {
            row_ex_x[k] = ex;
            row_ex_y[k] = ey;
            row_ex_size[k] = ex_size[e2];
            row_hl_seen[k] = hl_seen;
            row_hl_x[k] = hl_seen_x;
            row_hl_y[k] = hl_seen_y
        }
        hl_key = 0;
        hl_key2 = -1;
        hl_gold = false
    } else if (k < 64) {
        row_ex_x[k] = x + 22.0;
        row_ex_y[k] = y + (h - ex_h[e]) * 0.5;
        row_ex_size[k] = ex_size[e];
        row_hl_seen[k] = false
    }
    if (ch_ok[k] && ch_closes[k]) {
        cx: f32 = x + w - 22.0;
        p_disc(cx, y + h * 0.5, 10.0, C_GOLD, 1.0);
        draw_icon(I_CHECK, cx, y + h * 0.5, 6.0, C_WHITE, 1.0);
        if (ch_calc[k]) {
            // (Arithmetic closes it: said so small, under the check.)
            ww: f32 = p_str_w(0, 11.0, "by arithmetic");
            p_str(0, 11.0, cx + 10.0 - ww, y + h - 5.0, "by arithmetic", C_MUTED,
                1.0)
        }
    }
    add_button(id, x0, y0, x0 + w0, y0 + h0)
}

// The term the hint wants picked now (or 0).
hint_chip_term(): int {
    if (hint_row < 0 || chip_row != hint_row) return 0;
    if (wit_i < hint_wit_n) return hint_wit_terms[wit_i];
    0
}

// ---- juice ----
// What a row gives flies from it to its place on the board, carrying its
// writing: a new fact to its card (which waits for it), or the changed
// part of a rewritten goal to the block it becomes. Landing where it goes,
// it hands over to the board.
const FLY_TIME: f32 = 0.24;

draw_fly() {
    t: f32 = (now_t - fly_t) / FLY_TIME;
    if (t < 0.0 || t >= 1.0 || fly_term == 0) return;
    busy = true;
    x0: f32 = fly_x0;
    y0: f32 = fly_y0;
    s0: f32 = fly_s0;
    x1: f32 = 0.0;
    y1: f32 = 0.0;
    s1: f32 = 0.0;
    term: int = 0;
    if (fly_fact && fact_seen) {
        term = fly_term;
        x1 = fact_rx;
        y1 = fact_ry;
        s1 = fact_size
    } else if (fly_hl != 0 && goal_ex >= 0 && fly_hl_seen) {
        // (The changed part: from its block in the row to its block in the
        // goal.)
        b: int = -1;
        for k in ex_box0[goal_ex]..ex_box0[goal_ex] + ex_boxn[goal_ex] {
            if (b < 0 && bx_term[k] == fly_hl) b = k
        }
        // (Only a part on one line: a whole statement changed is shown by
        // its morph.)
        if (b < 0 || b == ex_box0[goal_ex] || bx_y1[b] - bx_y0[b] > ex_size[goal_ex] * 1.7) return;
        term = fly_hl;
        x0 = fly_hx0;
        y0 = fly_hy0;
        x1 = ex_ox[goal_ex] + bx_x0[b];
        y1 = ex_oy[goal_ex] + bx_y0[b] - minf(bx_depth[b] as f32, 4.0) * ex_size[goal_ex] * 0.075;
        s1 = ex_size[goal_ex]
    } else return;
    k: f32 = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);
    an_live = false;
    lay_one_line = true;
    e: int = lay_term(term, s0 + (s1 - s0) * k, col_w() - 36.0, 9100000);
    lay_one_line = false;
    if (e < 0) {
        an_live = true;
        return
    }
    xx: f32 = x0 + (x1 - x0) * k;
    yy: f32 = y0 + (y1 - y0) * k - sinf(t * 3.1416) * 22.0;
    // (Its glow fades as it lands.)
    a: f32 = 1.0 - t;
    p_shadow(xx - 6.0, yy - 2.0, ex_w[e] + 12.0, ex_h[e] + 4.0, 12.0, 6.0 * a, 14.0,
        0.25 * a);
    p_box(xx - 6.0, yy - 2.0, ex_w[e] + 12.0, ex_h[e] + 4.0, 12.0, C_PICK_SOFT, a);
    draw_expr(e, xx, yy, C_INK, 1.0, false);
    an_live = true
}

// The fact that closes a goal, copied into it (the close staged): from
// its card to the goal's writing.
sf_x: f32 = 0.0;

sf_y: f32 = 0.0;

sf_size: f32 = 18.0;

sf_seen: bool = false;

draw_copy() {
    if (!staging() || stage_fact == 0 || !sf_seen || goal_ex < 0 || split_on()) return;
    t: f32 = (now_t - (close_t - COPY_TIME)) / COPY_TIME;
    if (t < 0.0 || t >= 1.0) return;
    draw_copy_of(stage_fact, t, sf_x, sf_y, sf_size, ex_ox[goal_ex], ex_oy[goal_ex],
        ex_size[goal_ex])
}

// A copy of fact f flying (t from 0 to 1) from its writing at (x0, y0),
// size s0, to (x1, y1), size s1.
draw_copy_of(
    f: int,
    t: f32,
    x0: f32,
    y0: f32,
    s0: f32,
    x1: f32,
    y1: f32,
    s1: f32
) {
    busy = true;
    k: f32 = t * t * (3.0 - 2.0 * t);
    an_live = false;
    lay_one_line = true;
    e: int = lay_term(f, s0 + (s1 - s0) * k, col_w() - 36.0, 9150000);
    lay_one_line = false;
    an_live = true;
    if (e < 0) return;
    xx: f32 = x0 + (x1 - x0) * k;
    yy: f32 = y0 + (y1 - y0) * k - sinf(t * 3.1416) * 26.0;
    a: f32 = 1.0 - maxf(t - 0.7, 0.0) / 0.3;
    p_shadow(xx - 8.0, yy - 3.0, ex_w[e] + 16.0, ex_h[e] + 6.0, 12.0, 6.0, 14.0, 0.25 * a);
    p_box(xx - 8.0, yy - 3.0, ex_w[e] + 16.0, ex_h[e] + 6.0, 12.0, C_GOLD_SOFT, a);
    p_outline(xx - 8.0, yy - 3.0, ex_w[e] + 16.0, ex_h[e] + 6.0, 12.0, 2.0, C_GOLD,
        a);
    draw_expr(e, xx, yy, C_INK, a, false)
}

// Where the row tapped had its writing, and its changed part (kept when
// tapped: the rows are new after the move).
fly_x0: f32 = 0.0;

fly_y0: f32 = 0.0;

fly_s0: f32 = 18.0;

fly_hx0: f32 = 0.0;

fly_hy0: f32 = 0.0;

fly_hl_seen: bool = false;

fly_keep(q: int) {
    fly_hl_seen = false;
    if (q < 0 || q >= 64) return;
    fly_x0 = row_ex_x[q];
    fly_y0 = row_ex_y[q];
    fly_s0 = row_ex_size[q];
    fly_hx0 = row_hl_x[q];
    fly_hy0 = row_hl_y[q];
    fly_hl_seen = row_hl_seen[q]
}

// Where each row's writing was last drawn (its top left and size), and
// its changed part's block, for what flies from it.
row_ex_x: []f32 = new f32[64](0.0);

row_ex_y: []f32 = new f32[64](0.0);

row_ex_size: []f32 = new f32[64](18.0);

row_hl_x: []f32 = new f32[64](0.0);

row_hl_y: []f32 = new f32[64](0.0);

row_hl_seen: []bool = new bool[64](false);

// A goal closing: its card flashes gold, a check pops out, and the card,
// its writing shrinking with it, flies into its pip at the top.
draw_close() {
    if (split_on()) return;
    draw_close_card(now_t - close_t, goal_rx, goal_ry, goal_rw, goal_rh, close_term,
        close_calc, close_pip)
}

// A goal's card (x, y, w, h) closing, t after its flash: it flashes gold,
// a check pops out, and the card, its writing shrinking with it, flies
// into pip `pip`.
draw_close_card(
    t: f32,
    x0: f32,
    y0: f32,
    w0: f32,
    h0: f32,
    term: int,
    calc: bool,
    pip: int
) {
    if (t < 0.0 || t > 0.75) return;
    busy = true;
    x: f32 = x0;
    y: f32 = y0;
    w: f32 = w0;
    h: f32 = h0;
    sc: f32 = 1.0;
    a: f32 = 1.0;
    if (t > 0.34) {
        // (Into the pip.)
        k: f32 = clampf((t - 0.34) / 0.3, 0.0, 1.0);
        k = k * k;
        tx: f32 = pip_x[mini(pip, 63)];
        sc = 1.0 + (12.0 / maxf(h, 12.0) - 1.0) * k;
        nw: f32 = w * sc;
        nh: f32 = h * sc;
        x = x + (tx - nw * 0.5 - x) * k;
        y = y + (pip_y - nh * 0.5 - y) * k;
        w = nw;
        h = nh;
        a = 1.0 - k * 0.5
    }
    flash: f32 = clampf(1.0 - t * 3.0, 0.0, 1.0);
    r: f32 = minf(20.0 * sc, h * 0.5);
    p_shadow(x, y, w, h, r, 4.0 * sc, 14.0 * sc, 0.2 * a);
    p_box(x, y, w, h, r, mix_rgb(C_GOLD_SOFT, C_GOLD, 0.25 + 0.75 * flash), a);
    p_outline(x, y, w, h, r, 3.0 * sc, C_GOLD, a);
    if (h > 14.0) {
        an_live = false;
        e: int = lay_term(term, 23.0 * sc, maxf(w - 36.0 * sc - 30.0, 10.0), 9200000);
        ta: f32 = a * clampf((h - 14.0) / 20.0, 0.0, 1.0);
        if (e >= 0) draw_expr(e, x + 18.0 * sc, y + (h - ex_h[e]) * 0.5, C_INK, ta,
            false);
        an_live = true
    }
    // (The check, popping on the card and riding into the pip.)
    if (t > 0.06) {
        k: f32 = clampf((t - 0.06) / 0.14, 0.0, 1.0);
        s: f32 = (1.0 + 0.35 * sinf(k * 3.1416)) * k;
        cr: f32 = minf(18.0, h0 * 0.36);
        cx: f32 = x + w - (cr + 16.0) * sc;
        cy: f32 = y + h * 0.5;
        if (t > 0.34) s = s * maxf(sc * 1.6, 0.3);
        p_disc(cx, cy, cr * s, C_GOLD, a);
        draw_icon(I_CHECK, cx, cy, cr * 0.55 * s, C_WHITE, a);
        if (calc && t < 0.62) {
            ww: f32 = p_str_w(1, 12.0, "by arithmetic") + 20.0;
            p_box(cx - ww + 18.0, y + h + 6.0, ww, 24.0, 12.0, C_BLUE, k);
            p_str_mid(1, 12.0, cx - ww * 0.5 + 18.0, y + h + 22.0, "by arithmetic",
                C_WHITE, k)
        }
    }
}

// Whether a split goal's parts are being shown closing in turn.
split_on(): bool {
    sp_n > 0 && now_t < sp_t[sp_n - 1] + 0.8
}

// Where each part's fact was drawn (its copy flies from there).
sp_fx: []f32 = new f32[4](0.0);

sp_fy: []f32 = new f32[4](0.0);

sp_fs: []f32 = new f32[4](18.0);

sp_fseen: []bool = new bool[4](false);

// The goal card (x, y, w, h, its term stage_concl) divided into its parts
// side by side; each waits, its fact's copy flies into it, and it closes.
draw_split(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    busy = true;
    t: f32 = now_t - sp_t0;
    k: f32 = clampf(t / SPLIT_TIME, 0.0, 1.0);
    // (Eased out, a little past and back: a cell dividing.)
    k = 1.0 - (1.0 - k) * (1.0 - k);
    k = k + sinf(k * 3.1416) * 0.12;
    gap: f32 = 12.0;
    pw: f32 = (w - gap * (sp_n - 1) as f32) / sp_n as f32;
    // (The whole goal, fading as it divides.)
    if (t < SPLIT_TIME) {
        a0: f32 = 1.0 - clampf(t / (SPLIT_TIME * 0.6), 0.0, 1.0);
        an_live = false;
        e: int = lay_term(stage_concl, 23.0, w - 40.0, 9250000);
        if (e >= 0) draw_expr(e, x + 20.0, y + (h - ex_h[e]) * 0.5, C_INK, a0, false);
        an_live = true
    }
    for i in 0..sp_n {
        px: f32 = x + i as f32 * (pw + gap) * k;
        cw: f32 = w + (pw - w) * k;
        tc: f32 = now_t - sp_t[i];
        if (tc >= 0.0) draw_close_card(tc, px, y, cw, h, sp_term[i], sp_calc[i], sp_pip[i]) else draw_part(i,
            t, px, y, cw, h)
    }
}

// Part i of a split goal, waiting to close (t since the split).
draw_part(
    i: int,
    t: f32,
    px: f32,
    y: f32,
    cw: f32,
    h: f32
) {
    // (Waiting: the next to close outlined orange.)
    next: bool = i == 0 || now_t >= sp_t[i - 1];
    bord: int = mix_rgb(C_LINE, C_MUTED, 0.45);
    if (next && t > SPLIT_TIME) bord = C_PICK;
    p_shadow(px, y, cw, h, 20.0, 4.0, 14.0, 0.16);
    p_box(px, y, cw, h, 20.0, C_CARD, 1.0);
    p_outline(px, y, cw, h, 20.0, 3.0, bord, 1.0);
    an_live = false;
    e: int = lay_term(sp_term[i], 23.0, maxf(cw - 30.0, 10.0), 9260000 + i);
    ta: f32 = clampf((t - SPLIT_TIME * 0.4) / 0.2, 0.0, 1.0);
    if (e >= 0) draw_expr(e, px + 18.0, y + (h - ex_h[e]) * 0.5, C_INK, ta, false);
    an_live = true;
    // (Its fact's copy flying in.)
    ct: f32 = (now_t - (sp_t[i] - COPY_TIME)) / COPY_TIME;
    if (ct >= 0.0 && ct < 1.0 && sp_fact[i] != 0 && i < 4 && sp_fseen[i] && e >= 0) draw_copy_of(sp_fact[i],
        ct, sp_fx[i], sp_fy[i], sp_fs[i], px + 18.0, y + (h - ex_h[e]) * 0.5, 23.0)
}

// The level's words again, under the bar, for a moment.
draw_say(x: f32, w: f32, y: f32) {
    t: f32 = now_t - say_t;
    a: f32 = clampf(t * 6.0, 0.0, 1.0) * clampf((3.5 - t) * 3.0, 0.0, 1.0);
    busy = true;
    s: int = lv_intro[cur_level];
    ih: f32 = draw_wrapped(0, 16.0, 0.0, 0.0, w - 40.0, s, C_INK, 0.0);
    p_shadow(x, y, w, ih + 22.0, 16.0, 4.0, 14.0, 0.18 * a);
    p_box(x, y, w, ih + 22.0, 16.0, C_GOLD_SOFT, a);
    draw_wrapped(0, 16.0, x + 20.0, y + 26.0, w - 40.0, s, C_INK, a)
}

// A new level: its title and theorem, big, a moment; then the board.
draw_intro(x: f32, w: f32) {
    if (!intro_open || playing < 0 || cur_level < 0) return;
    t: f32 = now_t - intro_t0;
    // (The card's writing goes first; the scrim under it after, so the
    // two never show through each other.)
    sa: f32 = clampf((1.55 - t) / 0.22, 0.0, 1.0);
    if (sa <= 0.0) return;
    a: f32 = clampf((1.3 - t) / 0.2, 0.0, 1.0);
    busy = true;
    rise: f32 = (1.0 - clampf(t * 5.0, 0.0, 1.0)) * 30.0 - (1.0 - a) * 16.0;
    p_box(0.0, 0.0, view_w(), view_h(), 0.0, C_BG, sa);
    if (a <= 0.0) return;
    cy: f32 = view_h() * 0.36 + rise;
    line_clear();
    line_add("LEVEL ");
    line_int(playing - rg_lv0[region_of(playing)] + 1);
    lw: f32 = p_line_w(1, 13.0);
    p_line_text(1, 13.0, x + w * 0.5 - lw * 0.5, cy - 64.0, C_MUTED, a);
    tw: f32 = p_sym_w(1, 28.0, ml_title[playing]);
    ts: f32 = 28.0;
    if (tw > w) {
        ts = ts * w / tw;
        tw = w
    }
    p_sym(1, ts, x + w * 0.5 - tw * 0.5, cy - 26.0, ml_title[playing], C_INK, a);
    an_live = false;
    e: int = lay_term(lv_goal[cur_level], 26.0, w - 40.0, 9300000);
    eh: f32 = ex_h[e] + 30.0;
    ew: f32 = minf(ex_w[e] + 44.0, w);
    p_shadow(x + w * 0.5 - ew * 0.5, cy, ew, eh, 22.0, 5.0, 16.0, 0.16 * a);
    p_box(x + w * 0.5 - ew * 0.5, cy, ew, eh, 22.0, C_CARD, a);
    p_outline(x + w * 0.5 - ew * 0.5, cy, ew, eh, 22.0, 3.0, C_GOLD, a);
    draw_expr(e, x + w * 0.5 - ex_w[e] * 0.5, cy + 15.0, C_INK, a, false);
    an_live = true;
    if (lv_intro[cur_level] != 0) draw_wrapped(0, 17.0, x + 24.0, cy + eh + 40.0,
        w - 48.0, lv_intro[cur_level], C_MUTED, a)
}

// The ghost finger: it shows the player what to press (watching, or a
// hint), easing to the button it points at.
ghost_x: f32 = 0.0;

ghost_y: f32 = 0.0;

draw_ghost() {
    id: int = ghost_id;
    on: bool = watching && ghost_on;
    if (demo_kind != 0 && !watching) {
        if (intro_open || now_t < demo_t0) return;
        if (demo_kind == sym("swipe")) {
            draw_swipe_demo();
            return
        }
        if (demo_kind == sym("pips") && now_t - demo_t0 < 2.6) {
            // (First the squares at the top: one for each goal.)
            ghost_go(pip_x[0] + 4.0, pip_y + 30.0);
            return
        }
    }
    if (!watching && hint_row >= 0 && (now_t - hint_t < 4.0 || demo_kind != 0)) {
        on = true;
        q: int = row_place(hint_row);
        id = B_ROW + q;
        if (chip_row >= 0) {
            id = 0;
            t: int = hint_chip_term();
            for k in 0..wc_n {
                if (wc_term[k] == t) id = B_CHIP + k
            }
        }
    }
    if (!on || id == 0) return;
    found: bool = false;
    tx: f32 = 0.0;
    ty: f32 = 0.0;
    for k in 0..btn_n {
        if (btn_id[k] == id && !found) {
            bw: f32 = btn_x1[k] - btn_x0[k];
            tx = (btn_x0[k] + btn_x1[k]) * 0.5;
            ty = (btn_y0[k] + btn_y1[k]) * 0.5 + 14.0;
            // (A row: the finger under its right end, clear of its words
            // and its term.)
            if (bw > 160.0) {
                tx = btn_x1[k] - 56.0;
                ty = btn_y1[k] + 6.0
            }
            found = true
        }
    }
    if (!found) return;
    ghost_go(tx, ty)
}

// The ghost finger eased toward (tx, ty), tapping.
ghost_go(tx: f32, ty: f32) {
    if (ghost_x == 0.0 && ghost_y == 0.0) {
        ghost_x = tx;
        ghost_y = ty
    }
    ghost_x = ease_to(ghost_x, tx, 9.0);
    ghost_y = ease_to(ghost_y, ty, 9.0);
    tap: f32 = 0.5 + 0.5 * sinf(now_t * 6.0);
    busy = true;
    r: f32 = 17.0 - tap * 2.0;
    p_shadow(ghost_x - r, ghost_y - r + 4.0, 2.0 * r, 2.0 * r, r, 3.0, 10.0, 0.22);
    p_disc(ghost_x, ghost_y, r, C_WHITE, 0.7);
    p_ring(ghost_x, ghost_y, r, 2.5, C_INK, 0.35);
    p_ring(ghost_x, ghost_y, r + 8.0 + tap * 6.0, 2.0, C_GOLD, 0.4 * (1.0 - tap))
}

// The swipe demo: the finger strokes across the goal, left to right,
// over and over, leaving a short trail.
draw_swipe_demo() {
    if (goal_rw <= 0.0) return;
    busy = true;
    t: f32 = now_t - demo_t0;
    cyc: f32 = t - floorf(t / 1.6) * 1.6;
    k: f32 = clampf((cyc - 0.35) / 0.6, 0.0, 1.0);
    k = k * k * (3.0 - 2.0 * k);
    x0: f32 = goal_rx + goal_rw * 0.3;
    x1: f32 = goal_rx + goal_rw * 0.72;
    y: f32 = goal_ry + goal_rh * 0.5 + 18.0;
    fx: f32 = x0 + (x1 - x0) * k;
    a: f32 = clampf(cyc / 0.2, 0.0, 1.0) * clampf((1.6 - cyc) / 0.25, 0.0, 1.0);
    if (k > 0.0 && k < 1.0) {
        for i in 0..6 {
            tx: f32 = fx - i as f32 * 12.0 * k;
            if (tx > x0) p_disc(tx, y, 8.0 - i as f32, C_PICK, 0.3 * a * (1.0 - i as f32 / 6.0))
        }
    }
    r: f32 = 17.0 - (1.0 - k) * 2.0;
    p_shadow(fx - r, y - r + 4.0, 2.0 * r, 2.0 * r, r, 3.0, 10.0, 0.22 * a);
    p_disc(fx, y, r, C_WHITE, 0.7 * a);
    p_ring(fx, y, r, 2.5, C_INK, 0.35 * a)
}

// What a demo says, on a soft pill above the hand.
draw_demo_words(x: f32, w: f32) {
    if (demo_kind == 0 || watching || intro_open || now_t < demo_t0 || done_t >= 0.0) return;
    s: str = "Tap a move to play it.";
    if (demo_kind == sym("pips") && now_t - demo_t0 < 2.6) s = "A square up here for each goal. Fill them all.";
    if (demo_kind == sym("chip")) {
        s = "This move needs a term. Tap it.";
        if (chip_row >= 0) s = "Pick the term to use."
    }
    if (demo_kind == sym("swipe")) s = "Swipe across the goal to step into it.";
    a: f32 = clampf((now_t - demo_t0) * 4.0, 0.0, 1.0);
    busy = true;
    tw: f32 = p_str_w(1, 15.0, s) + 36.0;
    if (tw > w) tw = w;
    bx: f32 = x + w * 0.5 - tw * 0.5;
    // (Over the foot of the picture, clear of the goal and the hand.)
    by: f32 = hand_top_y - 50.0;
    if (pic_bottom_y > 0.0) by = pic_bottom_y - 50.0;
    p_shadow(bx, by, tw, 38.0, 19.0, 3.0, 10.0, 0.16 * a);
    p_box(bx, by, tw, 38.0, 19.0, C_INK, 0.88 * a);
    p_str_mid(1, 15.0, x + w * 0.5, by + 24.5, s, C_WHITE, a)
}

// ---- done: Q.E.D. ----
// The theorem rises to the middle, a stamp slams onto it, and the stars
// come in one at a time.
draw_done(x: f32, w: f32) {
    t: f32 = now_t - done_t;
    if (t < 3.0) busy = true;
    // (The last goal's snap first, and its card into its pip.)
    t = t - 0.62;
    if (t < 0.0) return;
    dim: f32 = clampf(t * 3.0, 0.0, 1.0);
    p_box(0.0, 0.0, view_w(), view_h(), 0.0, C_SHADOW, 0.3 * dim);
    // (The theorem, as a trophy card.)
    an_live = false;
    e: int = lay_term(lv_goal[cur_level], 28.0, w - 48.0, 9400000);
    // (Room under the statement for the stamp, on a line of its own.)
    ch: f32 = ex_h[e] + 124.0;
    rise: f32 = clampf(t / 0.45, 0.0, 1.0);
    rise = 1.0 - (1.0 - rise) * (1.0 - rise) * (1.0 - rise);
    // (The trophy and the card under it, together in the middle of what
    // is left over Next, which is big, in the thumb's reach.)
    h: f32 = 196.0;
    // (A theorem later levels use: it is a new move, and goes in the Book.)
    tool: bool = cur_level >= 0 && level_is_tool(cur_level) && !watching && watch_done_t < 0.0;
    if (tool) h = 250.0;
    if (watching || watch_done_t >= 0.0) h = 0.0;
    next_h: f32 = 64.0;
    next_y: f32 = view_h() - safe_bottom - 28.0 - next_h;
    room_top: f32 = safe_top + 66.0;
    cy: f32 = room_top + maxf(0.0, (next_y - 20.0 - room_top - ch - 18.0 - h) * 0.5);
    y: f32 = goal_ry + (cy - goal_ry) * rise;
    // (The stamp's slam nudges it.)
    st: f32 = t - 0.5;
    nudge: f32 = 0.0;
    if (st > 0.0 && st < 0.3) nudge = sinf(st * 60.0) * 6.0 * (1.0 - st / 0.3);
    y = y + nudge;
    p_shadow(x, y, w, ch, 24.0, 6.0, 22.0, 0.28 * dim);
    p_box(x, y, w, ch, 24.0, C_CARD, 1.0);
    p_outline(x, y, w, ch, 24.0, 3.0, C_GOLD, 1.0);
    line_clear();
    line_add("THEOREM  ");
    line_cp(183);
    line_add("  ");
    if (playing >= 0) line_sym(ml_title[playing]);
    p_line_text(1, 13.0, x + 24.0, y + 30.0, C_MUTED, 1.0);
    draw_expr(e, x + 24.0, y + 44.0, C_INK, 1.0, false);
    an_live = true;
    if (st > 0.0) {
        s: f32 = 1.0 + 0.4 * (1.0 - clampf(st / 0.14, 0.0, 1.0));
        a: f32 = clampf(st / 0.08, 0.0, 1.0);
        size: f32 = 34.0 * s;
        sw: f32 = p_str_w(1, size, "Q.E.D.") + 30.0 * s;
        sh: f32 = 58.0 * s;
        sx: f32 = x + w - 30.0 - sw * 0.5;
        sy: f32 = y + 44.0 + ex_h[e] + 40.0;
        p_box(sx - sw * 0.5, sy - sh * 0.5, sw, sh, 10.0 * s, C_RED, 0.12 * a);
        p_outline(sx - sw * 0.5, sy - sh * 0.5, sw, sh, 10.0 * s, 3.0 * s, C_RED,
            a);
        p_str_mid(1, size, sx, sy + size * 0.36, "Q.E.D.", C_RED, a)
    }
    if (watching || watch_done_t >= 0.0) return;
    // (The card below: stars, moves and par, Next.)
    pt: f32 = clampf((t - 0.75) * 3.0, 0.0, 1.0);
    if (pt <= 0.0) return;
    k: f32 = 1.0 - (1.0 - pt) * (1.0 - pt);
    py: f32 = cy + ch + 18.0 + (1.0 - k) * 160.0;
    p_shadow(x, py, w, h, 26.0, 6.0, 20.0, 0.25 * pt);
    p_box(x, py, w, h, 26.0, C_CARD, 1.0);
    s: int = 0;
    if (playing >= 0) s = stars_of(moves_made, ml_par[playing]);
    for i in 0..3 {
        col: int = C_LINE;
        if (i < s) col = C_GOLD;
        // (Each star thumps in: big, then its size.)
        at: f32 = t - 1.0 - i as f32 * 0.22;
        pop: f32 = clampf(at / 0.16, 0.0, 1.0);
        sz: f32 = 20.0;
        if (i < s) sz = 20.0 * (1.0 + 0.6 * (1.0 - pop));
        if (at > 0.0 || i >= s) draw_icon(I_STAR, x + w * 0.5 + (i as f32 - 1.0) * 62.0,
            py + 46.0, sz, col, maxf(pop, 0.3))
    }
    line_clear();
    line_int(moves_made);
    if (moves_made == 1) line_add(" move") else line_add(" moves");
    if (playing >= 0 && ml_par[playing] > 0) {
        line_add("  ");
        line_cp(183);
        line_add("  par ");
        line_int(ml_par[playing])
    }
    lw: f32 = p_line_w(1, 17.0);
    p_line_text(1, 17.0, x + w * 0.5 - lw * 0.5, py + 92.0, C_INK, 1.0);
    line_clear();
    line_add("Checked by the kernel");
    if (pn_thm[root] != 0 && thm_trusts_oracle(pn_thm[root])) line_add(", with Calculate");
    lw2: f32 = p_line_w(0, 14.0);
    p_line_text(0, 14.0, x + w * 0.5 - lw2 * 0.5, py + 116.0, C_MUTED, 1.0);
    if (tool) draw_new_move(x, w, py + 146.0, t, y);
    // ("Read the proof" on the card, in the middle of its foot.)
    pw: f32 = p_str_w(1, 17.0, "Read the proof") + 36.0;
    bw: f32 = pill_button(B_PROOF, x + w * 0.5 - pw * 0.5, py + h - 62.0, sym("Read the proof"),
        C_WHITE, C_INK);
    last_w = bw;
    // (Next: big, full width, low where the thumb is; it bobs.)
    nk: f32 = clampf((t - 1.2) * 4.0, 0.0, 1.0);
    if (nk <= 0.0) return;
    nk = 1.0 - (1.0 - nk) * (1.0 - nk);
    k: f32 = pressed(B_NEXT);
    bob: f32 = sinf(now_t * 4.0) * 3.0;
    ny: f32 = next_y + bob + (1.0 - nk) * 120.0 + k * 2.0;
    nx: f32 = x + 10.0 + k * 4.0;
    nw: f32 = w - 20.0 - k * 8.0;
    p_shadow(nx, ny, nw, next_h, next_h * 0.5, 5.0 - k * 3.0, 14.0, 0.22);
    p_box(nx, ny, nw, next_h, next_h * 0.5, C_PICK, 1.0);
    lw3: f32 = p_str_w(1, 22.0, "Next");
    p_str(1, 22.0, x + w * 0.5 - lw3 * 0.5 - 10.0, ny + next_h * 0.5 + 8.0, "Next",
        C_WHITE, 1.0);
    draw_icon(I_NEXT, x + w * 0.5 + lw3 * 0.5 + 8.0, ny + next_h * 0.5, 8.0, C_WHITE,
        1.0);
    add_button(B_NEXT, x, next_y, x + w, next_y + next_h)
}

last_w: f32 = 0.0;

// "New move: its title" on the finish card, and a copy of the theorem's
// card flying from the trophy into the Book (which glows as it lands).
draw_new_move(
    x: f32,
    w: f32,
    y: f32,
    t: f32,
    ty: f32
) {
    a: f32 = clampf((t - 1.7) * 4.0, 0.0, 1.0);
    if (a <= 0.0) return;
    line_clear();
    line_add("New move: ");
    if (playing >= 0) line_sym(ml_title[playing]);
    lw: f32 = p_line_w(1, 16.0);
    bw: f32 = lw + 40.0;
    p_box(x + w * 0.5 - bw * 0.5, y - 6.0, bw, 32.0, 16.0, C_GOLD_SOFT, a);
    p_outline(x + w * 0.5 - bw * 0.5, y - 6.0, bw, 32.0, 16.0, 1.5, C_GOLD, a);
    p_line_text(1, 16.0, x + w * 0.5 - lw * 0.5, y + 15.0, mix_rgb(C_GOLD, C_INK,
        0.35), a);
    // (The card's flight: from the trophy up into the Book button.)
    k: f32 = clampf((t - 1.9) / 0.55, 0.0, 1.0);
    bx: f32 = x + 70.0;
    by: f32 = safe_top + 30.0;
    if (k > 0.0 && k < 1.0) {
        busy = true;
        q: f32 = k * k;
        cw: f32 = (w - 40.0) * (1.0 - q) + 30.0 * q;
        ch: f32 = 60.0 * (1.0 - q) + 22.0 * q;
        cx: f32 = x + w * 0.5 + (bx - x - w * 0.5) * q;
        cy: f32 = ty + 60.0 + (by - ty - 60.0) * q - sinf(k * 3.1416) * 40.0;
        p_shadow(cx - cw * 0.5, cy - ch * 0.5, cw, ch, 10.0, 4.0, 12.0, 0.25);
        p_box(cx - cw * 0.5, cy - ch * 0.5, cw, ch, 10.0, C_CARD, 1.0);
        p_outline(cx - cw * 0.5, cy - ch * 0.5, cw, ch, 10.0, 2.0, C_GOLD, 1.0);
        if (q < 0.6 && playing >= 0) {
            ts: f32 = 15.0 * (1.0 - q);
            tw: f32 = p_sym_w(1, ts, ml_title[playing]);
            p_sym(1, ts, cx - tw * 0.5, cy + ts * 0.35, ml_title[playing], mix_rgb(C_GOLD,
                C_INK, 0.35), 1.0 - q / 0.6)
        }
    }
    gt: f32 = t - 2.45;
    if (gt > 0.0 && gt < 0.8) {
        busy = true;
        p_glow(bx, by, 24.0 + gt * 14.0, 8.0, C_GOLD, 0.6 * (1.0 - gt / 0.8))
    }
}

// ---- the proof, written out ----
draw_proof_page() {
    x: f32 = col_x();
    w: f32 = col_w();
    hy: f32 = safe_top + 34.0;
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    p_str(1, 18.0, x + 56.0, hy + 6.0, "The proof", C_INK, 1.0);
    top: f32 = hy + 34.0;
    p_clip(0.0, top, view_w(), view_h());
    y: f32 = top + 10.0 - sc_pos[V_PROOF];
    // (What was shown, then how.)
    if (cur_level >= 0) {
        p_str(1, 13.0, x + 6.0, y + 14.0, "THEOREM", C_MUTED, 1.0);
        y = y + 22.0;
        e: int = lay_term(lv_goal[cur_level], 20.0, w - 36.0, 7000000);
        eh: f32 = ex_h[e] + 20.0;
        p_box(x, y, w, eh, 18.0, C_GOLD_SOFT, 1.0);
        draw_expr(e, x + 18.0, y + 10.0, C_INK, 1.0, false);
        y = y + eh + 22.0
    }
    p_str(1, 13.0, x + 6.0, y, "PROOF", C_MUTED, 1.0);
    y = y + 26.0;
    for i in 0..pr_n {
        ind: f32 = pr_indent[i] as f32 * 22.0;
        if (pr_calc[i]) {
            p_sym(0, 17.0, x + 18.0 + ind, y, pr_text[i], C_BLUE, 1.0);
            y = y + 26.0
        } else {
            th: f32 = draw_wrapped(0, 17.0, x + 6.0 + ind, y, w - 12.0 - ind, pr_text[i],
                C_INK, 1.0);
            y = y + th + 6.0
        }
    }
    sc_most[V_PROOF] = y + 40.0 + sc_pos[V_PROOF] - view_h();
    p_noclip()
}

// ---- the region's rules ----
// What may be used here: the rulebook (assumed of whatever the region is
// about), its definitions, and the lemmas proved so far, each with its
// words and its statement.
draw_rules_page() {
    x: f32 = col_x();
    w: f32 = col_w();
    hy: f32 = safe_top + 34.0;
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    line_clear();
    line_add("The Book of ");
    if (region_title != 0) line_sym(region_title);
    pen_end = p_line_text(1, 18.0, x + 56.0, hy + 6.0, C_INK, 1.0);
    top: f32 = hy + 34.0;
    p_clip(0.0, top, view_w(), view_h());
    y: f32 = top + 10.0 - sc_pos[V_PROOF];
    y = y + draw_wrapped(0, 15.0, x + 6.0, y + 6.0, w - 12.0, sym("The rulebook is all you are given: everything proved holds for whatever obeys it. Each theorem you prove joins it as a new move."),
        C_MUTED, 1.0) + 10.0;
    for pass in 0..3 {
        heading: str = "RULEBOOK";
        if (pass == 1) heading = "DEFINITIONS";
        if (pass == 2) heading = "PROVED";
        shown: bool = false;
        for l in 0..lm_n {
            k: int = lm_kind[l];
            want: bool = pass == 0 && k == LM_ASSUME || pass == 1 && k == LM_DEF || pass == 2 && k == LM_LEVEL && lm_level[l] >= 0 && level_proved_here(lm_level[l]);
            if (want && !lm_hidden[l]) {
                if (!shown) {
                    pen_end = p_str(1, 13.0, x + 6.0, y + 14.0, heading, C_MUTED,
                        1.0);
                    y = y + 24.0;
                    shown = true
                }
                e: int = lay_term(thm_prop(lm_thm[l]), 17.0, w - 32.0, 8000000 + l);
                name: int = lm_words[l];
                if (name == 0) name = lm_name[l];
                eh: f32 = ex_h[e] + 38.0;
                // (A theorem proved: a trophy card, its stars, where it is used.)
                proved: bool = pass == 2;
                used_h: f32 = 0.0;
                if (proved) {
                    line_clear();
                    used_line(lm_level[l]);
                    if (line_n > 0) used_h = 24.0
                }
                p_shadow(x, y, w, eh + used_h, 16.0, 2.0, 8.0, 0.08);
                p_box(x, y, w, eh + used_h, 16.0, C_CARD, 1.0);
                if (proved) {
                    p_outline(x, y, w, eh + used_h, 16.0, 2.0, C_GOLD, 1.0);
                    m: int = map_of_level(lm_level[l]);
                    s: int = 0;
                    if (m >= 0) s = stars_for(m);
                    for i in 0..3 {
                        col: int = C_LINE;
                        if (i < s) col = C_GOLD;
                        draw_icon(I_STAR, x + w - 64.0 + i as f32 * 20.0, y + 17.0,
                            7.0, col, 1.0)
                    }
                }
                nc: int = C_PICK;
                if (proved) nc = mix_rgb(C_GOLD, C_INK, 0.3);
                p_sym(1, 14.0, x + 16.0, y + 22.0, name, nc, 1.0);
                draw_expr(e, x + 16.0, y + 30.0, C_INK, 1.0, false);
                if (used_h > 0.0) {
                    line_clear();
                    used_line(lm_level[l]);
                    p_line_text(0, 13.0, x + 16.0, y + eh + 10.0, C_MUTED, 1.0)
                }
                y = y + eh + used_h + 8.0
            }
        }
        if (shown) y = y + 10.0
    }
    // (Still to prove: each a faint card, its title and statement.)
    first: bool = true;
    for l in 0..lv_n {
        if (!lv_given[l] && !level_proved_here(l)) {
            if (first) {
                p_str(1, 13.0, x + 6.0, y + 14.0, "STILL TO PROVE", C_MUTED, 1.0);
                y = y + 24.0;
                first = false
            }
            e: int = lay_term(lv_goal[l], 15.0, w - 32.0, 8500000 + l);
            eh: f32 = ex_h[e] + 34.0;
            p_box(x, y, w, eh, 16.0, mix_rgb(C_SUNK, C_BG, 0.4), 1.0);
            p_outline(x, y, w, eh, 16.0, 1.5, C_LINE, 1.0);
            if (lv_title[l] != 0) p_sym(1, 13.0, x + 16.0, y + 20.0, lv_title[l],
                C_FAINT, 1.0);
            draw_expr(e, x + 16.0, y + 27.0, C_MUTED, 0.8, false);
            y = y + eh + 8.0
        }
    }
    sc_most[V_PROOF] = y + 40.0 + sc_pos[V_PROOF] - view_h();
    p_noclip()
}

// "Used in A, B" for level l's theorem (the later levels that may use
// it), added to the line; nothing if none.
used_line(l: int) {
    first: bool = true;
    for u in 0..lv_n {
        if (u != l && !lv_given[u] && level_uses(u, l)) {
            if (first) line_add("Used in ") else line_add(", ");
            first = false;
            if (lv_title[u] != 0) line_sym(lv_title[u]) else line_sym(lv_name[u])
        }
    }
}

// Whether level l (its number in the region's file) was proved by the
// player (not only by its written proof, which every level's is).
level_proved_here(l: int): bool {
    for m in 0..ml_n {
        if (ml_index[m] == l && region_of(m) == loaded_region && ml_solved[m]) return true
    }
    false
}
