tag lemma_ui;

use_tag std, skate, lemma;

// The pages, drawn: the map, a level, and a proof written out. Everything
// is laid out afresh each frame, in the game's pixels (on a page, CSS
// pixels); what moves is eased, so a frame with nothing moving is the
// same as the last.
draw_game() {
    boxes_reset();
    an_frame();
    btn_n = 0;
    if (page == PAGE_MAP) draw_map() else if (page == PAGE_LEVEL) draw_level() else if (page == PAGE_RULES) draw_rules_page() else draw_proof_page();
    draw_toast(view_h() - safe_bottom - 24.0);
    an_jump = false
}

// The width the page's column takes (narrow on a phone, at most 560).
col_w(): f32 {
    minf(view_w() - safe_left - safe_right - 24.0, 560.0)
}

col_x(): f32 {
    safe_left + (view_w() - safe_left - safe_right - col_w()) * 0.5
}

// A round button with an icon, (x, y) its middle.
round_button(
    id: int,
    x: f32,
    y: f32,
    icon: int
) {
    r: f32 = 22.0;
    k: f32 = pressed(id);
    p_shadow(x - r, y - r, 2.0 * r, 2.0 * r, r, 2.0, 6.0, 0.12);
    p_disc(x, y, r - k * 1.5, mix_rgb(C_CARD, C_SUNK, k), 1.0);
    p_ring(x, y, r - k * 1.5, 1.0, C_LINE, 1.0);
    draw_icon(icon, x, y, 9.0, C_INK, 1.0);
    add_button(id, x - r, y - r, x + r, y + r)
}

// A pill button with words, its top left (x, y); how wide.
pill_button(
    id: int,
    x: f32,
    y: f32,
    s: int,
    fill: int,
    ink: int
): f32 {
    size: f32 = 17.0;
    w: f32 = p_sym_w(1, size, s) + 36.0;
    h: f32 = 46.0;
    k: f32 = pressed(id);
    dy: f32 = k * 2.0;
    p_shadow(x, y, w, h, h * 0.5, 3.0 - k * 2.0, 8.0, 0.16);
    p_box(x, y + dy, w, h, h * 0.5, fill, 1.0);
    p_sym(1, size, x + 18.0, y + dy + h * 0.5 + size * 0.36, s, ink, 1.0);
    add_button(id, x, y, x + w, y + h);
    w
}

// Words wrapped to width w, the first line's baseline at y: how tall.
draw_wrapped(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    s: int,
    rgb: int,
    a: f32
): f32 {
    from: int = sym_start[s];
    to: int = from + sym_len[s];
    lh: f32 = size * 1.38;
    yy: f32 = y;
    i: int = from;
    while (i < to) {
        // (As many words as fit: up to the last space that does.)
        j: int = i;
        last: int = -1;
        while (j < to && p_text_w(face, size, sym_bytes, i, j + 1) <= w) {
            if (sym_bytes[j] as int == 32) last = j;
            j = j + 1
        }
        end: int = j;
        if (j < to && last > i) end = last;
        if (end <= i) end = i + 1;
        if (a > 0.0) pen_end = p_text(face, size, x, yy, sym_bytes, i, end, 0.0, rgb,
            a);
        i = end;
        while (i < to && sym_bytes[i] as int == 32) i = i + 1;
        yy = yy + lh
    }
    yy - y
}

// ---- the map ----
draw_map() {
    x: f32 = col_x();
    w: f32 = col_w();
    top: f32 = safe_top - sc_pos[V_MAP];
    y: f32 = top + 54.0;
    p_str(1, 40.0, x + 4.0, y, "Lemma", C_INK, 1.0);
    y = y + 30.0;
    y = y + draw_wrapped(0, 17.0, x + 6.0, y, w - 12.0, sym("Prove theorems from the ground up, one move at a time."),
        C_MUTED, 1.0) + 10.0;
    for r in 0..rg_n {
        // (A region: its title, how much of it is proved, its levels.)
        solved: int = 0;
        for k in rg_lv0[r]..rg_lv0[r] + rg_lvn[r] {
            if (ml_solved[k]) solved = solved + 1
        }
        h: f32 = 64.0 + rg_lvn[r] as f32 * 62.0;
        p_shadow(x, y, w, h, 22.0, 4.0, 14.0, 0.12);
        p_box(x, y, w, h, 22.0, C_CARD, 1.0);
        p_sym(1, 24.0, x + 20.0, y + 40.0, rg_title[r], C_INK, 1.0);
        line_clear();
        line_int(solved);
        line_add(" of ");
        line_int(rg_lvn[r]);
        tw: f32 = p_line_w(0, 15.0);
        p_line_text(0, 15.0, x + w - 20.0 - tw, y + 38.0, C_MUTED, 1.0);
        yy: f32 = y + 60.0;
        first_open: bool = true;
        for k in rg_lv0[r]..rg_lv0[r] + rg_lvn[r] {
            draw_level_row(k, x + 12.0, yy, w - 24.0, k - rg_lv0[r] + 1, !ml_solved[k] && first_open);
            if (!ml_solved[k]) first_open = false;
            yy = yy + 62.0
        }
        y = y + h + 18.0
    }
    sc_most[V_MAP] = y + sc_pos[V_MAP] + safe_bottom + 20.0 - view_h()
}

// Level k of the map as a row: its number (or a tick), title, and stars.
draw_level_row(
    k: int,
    x: f32,
    y: f32,
    w: f32,
    num: int,
    next: bool
) {
    id: int = B_LEVEL + k;
    pk: f32 = pressed(id);
    h: f32 = 54.0;
    fill: int = C_CARD;
    if (next) fill = C_PICK_SOFT;
    p_box(x, y + pk, w, h, 18.0, mix_rgb(fill, C_SUNK, pk), 1.0);
    cx: f32 = x + 30.0;
    cy: f32 = y + h * 0.5 + pk;
    if (ml_solved[k]) {
        p_disc(cx, cy, 17.0, C_GOLD, 1.0);
        draw_icon(I_CHECK, cx, cy, 8.0, C_WHITE, 1.0)
    } else {
        ring: int = C_LINE;
        if (next) {
            ring = C_PICK;
            // (The next to play breathes.)
            p_glow(cx, cy, 20.0 + sinf(now_t * 3.0) * 2.0, 6.0, C_PICK, 0.25);
            busy = true
        }
        p_disc(cx, cy, 17.0, C_WHITE, 1.0);
        p_ring(cx, cy, 17.0, 2.0, ring, 1.0);
        line_clear();
        line_int(num);
        nw: f32 = p_line_w(1, 16.0);
        p_line_text(1, 16.0, cx - nw * 0.5, cy + 6.0, C_INK, 1.0)
    }
    p_sym(0, 17.0, x + 60.0, cy + 6.0, ml_title[k], C_INK, 1.0);
    s: int = stars_for(k);
    for i in 0..3 {
        col: int = C_LINE;
        if (i < s) col = C_GOLD;
        draw_icon(I_STAR, x + w - 64.0 + i as f32 * 20.0, cy, 7.5, col, 1.0)
    }
    add_button(id, x, y, x + w, y + h)
}

// ---- a level ----
draw_level() {
    n: int = play_node();
    x: f32 = col_x();
    w: f32 = col_w();
    // (The header: back, the level's title, undo.)
    hy: f32 = safe_top + 34.0;
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    round_button(B_RULES, x + 72.0, hy, I_BOOK);
    if (playing >= 0) {
        // (The title between the buttons: smaller if it must be.)
        tsize: f32 = 18.0;
        room: f32 = w - 2.0 * 104.0;
        tw: f32 = p_sym_w(1, tsize, ml_title[playing]);
        if (tw > room) {
            tsize = tsize * room / tw;
            tw = room
        }
        p_sym(1, tsize, x + w * 0.5 - tw * 0.5, hy + 6.0, ml_title[playing], C_INK,
            1.0)
    }
    if (mv_n > 0 && done_t < 0.0 && !watching) round_button(B_UNDO, x + w - 22.0,
        hy, I_UNDO) else if (done_t < 0.0) {
        // (Before a move: the written proof can be watched.)
        word: int = sym("Watch");
        if (watching) word = sym("Stop");
        ww: f32 = p_sym_w(1, 15.0, word) + 28.0;
        k: f32 = pressed(B_WATCH);
        p_shadow(x + w - ww, hy - 18.0, ww, 36.0, 18.0, 2.0, 6.0, 0.12);
        p_box(x + w - ww, hy - 18.0 + k, ww, 36.0, 18.0, mix_rgb(C_CARD, C_SUNK, k),
            1.0);
        p_sym(1, 15.0, x + w - ww + 14.0, hy + 5.0 + k, word, C_PICK, 1.0);
        add_button(B_WATCH, x + w - ww, hy - 18.0, x + w, hy + 18.0)
    }
    top: f32 = hy + 34.0;
    // (The picture, if the region has one.)
    ph: f32 = 0.0;
    if (region_picture != 0) {
        // (Smaller while the tray is up, to leave room for the goal.)
        ph = minf(w * 0.56, view_h() * 0.27) * (1.0 - 0.55 * tray_t);
        draw_picture(x, top, w, ph);
        ph = ph + 12.0
    }
    // (Below it, what is known and what is to be shown, scrolling.)
    area_top: f32 = top + ph;
    tray_h: f32 = tray_height();
    area_bot: f32 = view_h() - safe_bottom - tray_h * tray_t;
    p_clip(0.0, area_top, view_w(), area_bot);
    y: f32 = area_top + 6.0 - sc_pos[V_LEVEL];
    if (intro_open && !picked && cur_level >= 0 && lv_intro[cur_level] != 0) {
        ih: f32 = draw_wrapped(0, 16.0, 0.0, 0.0, w - 40.0, lv_intro[cur_level], C_INK,
            0.0);
        p_box(x, y, w, ih + 26.0, 16.0, C_GOLD_SOFT, 1.0);
        draw_wrapped(0, 16.0, x + 20.0, y + 26.0, w - 40.0, lv_intro[cur_level], C_INK,
            1.0);
        add_button(B_INTRO, x, y, x + w, y + ih + 26.0);
        y = y + ih + 38.0
    }
    if (n >= 0) {
        g: int = pn_goal[n];
        if (gl_hypn[g] > 0) {
            p_str(1, 13.0, x + 6.0, y + 14.0, "KNOWN", C_MUTED, 1.0);
            y = y + 22.0;
            for i in 0..gl_hypn[g] {
                h: int = goal_hyp(g, i);
                e: int = lay_term(h, 18.0, w - 32.0, hyp_slot(h));
                eh: f32 = ex_h[e] + 12.0;
                cy: f32 = card_y(hyp_slot(h), y);
                ca: f32 = card_a;
                p_box(x, cy, w, eh, 16.0, C_BLUE_SOFT, ca);
                draw_expr(e, x + 16.0, cy + 6.0, C_INK, ca, true);
                add_button(B_EXPR + e, x, y, x + w, y + eh);
                y = y + eh + 8.0
            }
            y = y + 8.0
        }
        // (The goal: what is to be shown, the biggest thing on the page.)
        level_open();
        label: str = "SHOW";
        p_str(1, 13.0, x + 6.0, y + 14.0, label, C_MUTED, 1.0);
        if (open_n > 1) {
            line_clear();
            line_int(open_n);
            line_add(" goals left  ");
            line_cp(8250);
            lw: f32 = p_line_w(1, 13.0);
            p_line_text(1, 13.0, x + w - 6.0 - lw, y + 14.0, C_PICK, 1.0);
            add_button(B_GOAL_NEXT, x + w - lw - 20.0, y - 6.0, x + w, y + 24.0)
        }
        y = y + 22.0;
        e: int = lay_term(gl_concl[g], 23.0, w - 36.0, SLOT_GOAL);
        eh: f32 = ex_h[e] + 24.0;
        // (What is picked kept in sight above the tray.)
        if (picked && pick_hyp < 0 && !sc_held[V_LEVEL]) {
            over: f32 = y + eh + 12.0 - area_bot;
            if (over > 0.0) sc_pos[V_LEVEL] = ease_to(sc_pos[V_LEVEL], sc_pos[V_LEVEL] + over,
                10.0)
        }
        gy: f32 = card_y(SLOT_GOAL, y);
        p_shadow(x, gy, w, eh, 20.0, 4.0, 14.0, 0.14);
        p_box(x, gy, w, eh, 20.0, C_CARD, 1.0);
        p_outline(x, gy, w, eh, 20.0, 2.0, C_LINE, 1.0);
        draw_expr(e, x + 18.0, gy + 12.0, C_INK, 1.0, true);
        add_button(B_EXPR + e, x, y, x + w, y + eh);
        y = y + eh + 16.0;
        if (!picked && moves_made == 0 && done_t < 0.0) y = y + draw_wrapped(0, 15.0,
            x + 6.0, y + 6.0, w - 12.0, sym("Tap the goal, or something known, to see what you can do."),
            C_MUTED, 1.0)
    }
    sc_most[V_LEVEL] = y + sc_pos[V_LEVEL] - area_bot + 20.0;
    p_noclip();
    if (tray_t > 0.01) draw_tray(x, w, tray_h);
    if (done_t >= 0.0) draw_done(x, w)
}

// ---- the tray: the moves for what is picked ----
// The tray as tall as what it holds (as last drawn), up to near half the
// screen.
tray_need: f32 = 200.0;

tray_height(): f32 {
    minf(minf(view_h() * 0.46, 330.0), tray_need) + safe_bottom
}

draw_tray(x: f32, w: f32, h: f32) {
    top: f32 = view_h() - h * tray_t;
    p_shadow(0.0, top, view_w(), h + 40.0, 26.0, -4.0, 22.0, 0.22);
    p_box(0.0, top, view_w(), h + 40.0, 26.0, C_CARD, 1.0);
    p_box(view_w() * 0.5 - 22.0, top + 8.0, 44.0, 5.0, 2.5, C_LINE, 1.0);
    // (Tapping off it closes it: the area above it is its button too.)
    // (Choosing a witness: the move's words say what for.)
    title: int = sym("What to do");
    if (wit_cand >= 0) title = cd_label[wit_cand];
    p_sym(1, 15.0, x + 8.0, top + 36.0, title, C_MUTED, 1.0);
    round_button(B_TRAY_CLOSE, x + w - 22.0, top + 30.0, I_CROSS);
    p_clip(0.0, top + 54.0, view_w(), view_h());
    y: f32 = top + 58.0 - sc_pos[V_TRAY];
    // (A button's words are where the button is: they do not slide.)
    an_live = false;
    bx: f32 = x;
    if (wit_cand < 0) {
        // (Each move a button, its words as math.)
        for k in 0..cd_shown {
            c: int = cd_order[k];
            e: int = lay_words(cd_label[c], 18.0, 5000000 + k);
            bw: f32 = ex_w[e] + 36.0;
            bh: f32 = 50.0;
            if (bx + bw > x + w && bx > x) {
                bx = x;
                y = y + bh + 10.0
            }
            id: int = B_MOVE + k;
            pk: f32 = pressed(id);
            p_shadow(bx, y, bw, bh, bh * 0.5, 3.0 - pk * 2.0, 8.0, 0.18);
            fill: int = C_PICK;
            if (k > 0) fill = C_WHITE;
            p_box(bx, y + pk * 2.0, bw, bh, bh * 0.5, fill, 1.0);
            if (k > 0) p_outline(bx, y + pk * 2.0, bw, bh, bh * 0.5, 2.0, C_PICK,
                1.0);
            ink: int = C_INK;
            if (k == 0) ink = C_WHITE;
            draw_expr(e, bx + 18.0, y + pk * 2.0 + (bh - ex_h[e]) * 0.5, ink, 1.0,
                false);
            add_button(id, bx, y, bx + bw, y + bh);
            bx = bx + bw + 10.0
        }
    } else {
        for k in 0..wc_n {
            e: int = lay_term(wc_term[k], 19.0, w - 40.0, 6000000 + k);
            bw: f32 = ex_w[e] + 32.0;
            bh: f32 = ex_h[e] + 14.0;
            if (bx + bw > x + w && bx > x) {
                bx = x;
                y = y + bh + 10.0
            }
            id: int = B_WITNESS + k;
            pk: f32 = pressed(id);
            p_shadow(bx, y, bw, bh, 16.0, 3.0 - pk * 2.0, 8.0, 0.16);
            p_box(bx, y + pk * 2.0, bw, bh, 16.0, C_BLUE_SOFT, 1.0);
            draw_expr(e, bx + 16.0, y + 7.0 + pk * 2.0, C_INK, 1.0, true);
            add_button(id, bx, y, bx + bw, y + bh);
            bx = bx + bw + 10.0
        }
    }
    sc_most[V_TRAY] = y + 70.0 + sc_pos[V_TRAY] - view_h();
    tray_need = y + sc_pos[V_TRAY] - top + 76.0;
    an_live = true;
    p_noclip()
}

// ---- done ----
draw_done(x: f32, w: f32) {
    t: f32 = clampf((now_t - done_t) * 3.0, 0.0, 1.0);
    if (t < 1.0) busy = true;
    p_box(0.0, 0.0, view_w(), view_h(), 0.0, C_SHADOW, 0.25 * t);
    // (A card that pops up from below, a little past and back.)
    k: f32 = 1.0 - (1.0 - t) * (1.0 - t);
    h: f32 = 250.0;
    y: f32 = view_h() - safe_bottom - h - 24.0 + (1.0 - k) * 120.0;
    p_shadow(x, y, w, h, 26.0, 6.0, 20.0, 0.25 * t);
    p_box(x, y, w, h, 26.0, C_CARD, t);
    p_str(1, 30.0, x + 24.0, y + 52.0, "Proved.", C_INK, t);
    s: int = 0;
    if (playing >= 0) s = stars_for(playing);
    for i in 0..3 {
        col: int = C_LINE;
        if (i < s) col = C_GOLD;
        pop: f32 = clampf((now_t - done_t) * 4.0 - i as f32 * 0.35, 0.0, 1.0);
        draw_icon(I_STAR, x + w - 110.0 + i as f32 * 34.0, y + 42.0, 9.0 + 4.0 * pop,
            col, t)
    }
    line_clear();
    line_int(moves_made);
    line_add(" moves");
    if (playing >= 0 && ml_par[playing] > 0) {
        line_add(", par ");
        line_int(ml_par[playing])
    }
    line_add(". Checked by the kernel");
    if (pn_thm[root] != 0 && thm_trusts_oracle(pn_thm[root])) line_add(", with Calculate's arithmetic");
    line_add(".");
    msg: int = line_sym_now();
    draw_wrapped(0, 16.0, x + 24.0, y + 88.0, w - 48.0, msg, C_MUTED, t);
    by: f32 = y + h - 70.0;
    bw: f32 = pill_button(B_PROOF, x + 20.0, by, sym("Read the proof"), C_WHITE, C_INK);
    nw: f32 = p_str_w(1, 17.0, "Next") + 36.0;
    pill_button(B_NEXT, x + w - 20.0 - nw, by, sym("Next"), C_PICK, C_WHITE);
    last_w = bw
}

last_w: f32 = 0.0;

// ---- the proof, written out ----
draw_proof_page() {
    x: f32 = col_x();
    w: f32 = col_w();
    hy: f32 = safe_top + 34.0;
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    p_str(1, 18.0, x + 56.0, hy + 6.0, "The proof", C_INK, 1.0);
    top: f32 = hy + 34.0;
    p_clip(0.0, top, view_w(), view_h());
    y: f32 = top + 10.0 - sc_pos[V_PROOF];
    // (What was shown, then how.)
    if (cur_level >= 0) {
        p_str(1, 13.0, x + 6.0, y + 14.0, "THEOREM", C_MUTED, 1.0);
        y = y + 22.0;
        e: int = lay_term(lv_goal[cur_level], 20.0, w - 36.0, 7000000);
        eh: f32 = ex_h[e] + 20.0;
        p_box(x, y, w, eh, 18.0, C_GOLD_SOFT, 1.0);
        draw_expr(e, x + 18.0, y + 10.0, C_INK, 1.0, false);
        y = y + eh + 22.0
    }
    p_str(1, 13.0, x + 6.0, y, "PROOF", C_MUTED, 1.0);
    y = y + 26.0;
    for i in 0..pr_n {
        ind: f32 = pr_indent[i] as f32 * 22.0;
        if (pr_calc[i]) {
            p_sym(0, 17.0, x + 18.0 + ind, y, pr_text[i], C_BLUE, 1.0);
            y = y + 26.0
        } else {
            th: f32 = draw_wrapped(0, 17.0, x + 6.0 + ind, y, w - 12.0 - ind, pr_text[i],
                C_INK, 1.0);
            y = y + th + 6.0
        }
    }
    sc_most[V_PROOF] = y + 40.0 + sc_pos[V_PROOF] - view_h();
    p_noclip()
}

// ---- the region's rules ----
// What may be used here: the rulebook (assumed of whatever the region is
// about), its definitions, and the lemmas proved so far, each with its
// words and its statement.
draw_rules_page() {
    x: f32 = col_x();
    w: f32 = col_w();
    hy: f32 = safe_top + 34.0;
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    line_clear();
    line_add("Rules of ");
    if (region_title != 0) line_sym(region_title);
    pen_end = p_line_text(1, 18.0, x + 56.0, hy + 6.0, C_INK, 1.0);
    top: f32 = hy + 34.0;
    p_clip(0.0, top, view_w(), view_h());
    y: f32 = top + 10.0 - sc_pos[V_PROOF];
    y = y + draw_wrapped(0, 15.0, x + 6.0, y + 6.0, w - 12.0, sym("The rulebook is what is assumed here: everything proved holds for whatever obeys it. Lemmas join it as their levels are proved."),
        C_MUTED, 1.0) + 10.0;
    for pass in 0..3 {
        heading: str = "RULEBOOK";
        if (pass == 1) heading = "DEFINITIONS";
        if (pass == 2) heading = "PROVED";
        shown: bool = false;
        for l in 0..lm_n {
            k: int = lm_kind[l];
            want: bool = pass == 0 && k == LM_ASSUME || pass == 1 && k == LM_DEF || pass == 2 && k == LM_LEVEL && lm_level[l] >= 0 && level_proved_here(lm_level[l]);
            if (want && !lm_hidden[l]) {
                if (!shown) {
                    pen_end = p_str(1, 13.0, x + 6.0, y + 14.0, heading, C_MUTED,
                        1.0);
                    y = y + 24.0;
                    shown = true
                }
                e: int = lay_term(thm_prop(lm_thm[l]), 17.0, w - 32.0, 8000000 + l);
                name: int = lm_words[l];
                if (name == 0) name = lm_name[l];
                eh: f32 = ex_h[e] + 38.0;
                p_box(x, y, w, eh, 16.0, C_CARD, 1.0);
                p_sym(1, 14.0, x + 16.0, y + 22.0, name, C_PICK, 1.0);
                draw_expr(e, x + 16.0, y + 30.0, C_INK, 1.0, false);
                y = y + eh + 8.0
            }
        }
        if (shown) y = y + 10.0
    }
    sc_most[V_PROOF] = y + 40.0 + sc_pos[V_PROOF] - view_h();
    p_noclip()
}

// Whether level l (its number in the region's file) was proved by the
// player (not only by its written proof, which every level's is).
level_proved_here(l: int): bool {
    for m in 0..ml_n {
        if (ml_index[m] == l && region_of(m) == loaded_region && ml_solved[m]) return true
    }
    false
}
