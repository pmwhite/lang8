tag lemma_ui;

use_tag std, skate, lemma;

// The pages, drawn: the map, a level, and a proof written out. Everything
// is laid out afresh each frame, in the game's pixels (on a page, CSS
// pixels); what moves is eased, so a frame with nothing moving is the
// same as the last.
draw_game() {
    boxes_reset();
    an_frame();
    btn_n = 0;
    if (page == PAGE_MAP) draw_map() else if (page == PAGE_LEVEL) draw_level() else if (page == PAGE_RULES) draw_rules_page() else draw_proof_page();
    // (Words for a moment: just under the bar on a level, clear of the
    // board; at the foot of other pages.)
    if (page == PAGE_LEVEL) draw_toast(bar_bottom_y + 4.0, true) else draw_toast(view_h() - safe_bottom - 68.0,
        false);
    an_jump = false
}

// The width the page's column takes (narrow on a phone, at most 560).
col_w(): f32 {
    minf(view_w() - safe_left - safe_right - 24.0, 560.0)
}

col_x(): f32 {
    safe_left + (view_w() - safe_left - safe_right - col_w()) * 0.5
}

// A round button with an icon, (x, y) its middle.
round_button(
    id: int,
    x: f32,
    y: f32,
    icon: int
) {
    r: f32 = 22.0;
    k: f32 = pressed(id);
    p_shadow(x - r, y - r, 2.0 * r, 2.0 * r, r, 2.0, 6.0, 0.12);
    p_disc(x, y, r - k * 1.5, mix_rgb(C_CARD, C_SUNK, k), 1.0);
    p_ring(x, y, r - k * 1.5, 1.0, C_LINE, 1.0);
    draw_icon(icon, x, y, 9.0, C_INK, 1.0);
    add_button(id, x - r, y - r, x + r, y + r)
}

// Words wrapped to width w, the first line's baseline at y: how tall.
draw_wrapped(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    w: f32,
    s: int,
    rgb: int,
    a: f32
): f32 {
    from: int = sym_start[s];
    to: int = from + sym_len[s];
    lh: f32 = size * 1.38;
    yy: f32 = y;
    i: int = from;
    while (i < to) {
        // (As many words as fit: up to the last space that does.)
        j: int = i;
        last: int = -1;
        while (j < to && p_text_w(face, size, sym_bytes, i, j + 1) <= w) {
            if (sym_bytes[j] as int == 32) last = j;
            j = j + 1
        }
        end: int = j;
        if (j < to && last > i) end = last;
        if (end <= i) end = i + 1;
        if (a > 0.0) pen_end = p_text(face, size, x, yy, sym_bytes, i, end, 0.0, rgb,
            a);
        i = end;
        while (i < to && sym_bytes[i] as int == 32) i = i + 1;
        yy = yy + lh
    }
    yy - y
}

// ---- the map ----
// Each region a chapter: a cover strip (its picture, title, how much is
// proved), then its levels as round pudgy nodes along a winding path.
draw_map() {
    x: f32 = col_x();
    w: f32 = col_w();
    top: f32 = safe_top - sc_pos[V_MAP];
    y: f32 = top + 54.0;
    p_str(1, 40.0, x + 4.0, y, "Lemma", C_INK, 1.0);
    y = y + 30.0;
    y = y + draw_wrapped(0, 17.0, x + 6.0, y, w - 12.0, sym("Prove theorems from the ground up, one move at a time."),
        C_MUTED, 1.0) + 14.0;
    next_found: bool = false;
    for r in 0..rg_n {
        y = draw_cover(r, x, y, w) + 26.0;
        n: int = rg_lvn[r];
        // (The path first, under the nodes.)
        for i in 0..n - 1 {
            ax: f32 = node_x(i, x, w);
            ay: f32 = y + i as f32 * NODE_GAP + 30.0;
            bx: f32 = node_x(i + 1, x, w);
            by: f32 = ay + NODE_GAP;
            col: int = C_LINE;
            d: f32 = sqrtf((bx - ax) * (bx - ax) + (by - ay) * (by - ay));
            steps: int = (d / 13.0) as int;
            for j in 1..steps {
                f: f32 = j as f32 / steps as f32;
                // (A gentle bow in each step of the path.)
                bow: f32 = sinf(f * 3.1416) * 14.0;
                if (bx < ax) bow = -bow;
                p_disc(ax + (bx - ax) * f + bow, ay + (by - ay) * f, 3.2, col, 1.0)
            }
        }
        for i in 0..n {
            k: int = rg_lv0[r] + i;
            next: bool = !ml_solved[k] && !next_found && level_lock(k) == 0;
            if (next) next_found = true;
            draw_node(k, i, node_x(i, x, w), y + i as f32 * NODE_GAP + 30.0, x, w,
                next)
        }
        y = y + n as f32 * NODE_GAP + 24.0
    }
    sc_most[V_MAP] = y + sc_pos[V_MAP] + safe_bottom + 20.0 - view_h()
}

const NODE_GAP: f32 = 92.0;

// Where node i sits across: winding left and right.
node_x(i: int, x: f32, w: f32): f32 {
    s: f32 = sinf(i as f32 * 1.25 + 0.6);
    // (Never in the very middle: a title needs a side.)
    off: f32 = 0.4 + 0.6 * absf(s);
    if (s < 0.0) off = -off;
    x + w * 0.5 + off * w * 0.27
}

// A chapter's cover: a strip with its picture, title and progress; a tap
// opens its Book. Where it ends.
draw_cover(
    r: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    h: f32 = 118.0;
    solved: int = 0;
    for k in rg_lv0[r]..rg_lv0[r] + rg_lvn[r] {
        if (ml_solved[k]) solved = solved + 1
    }
    tint: int = mix_rgb(C_GOLD_SOFT, C_CARD, 0.2);
    if (r == 1) tint = mix_rgb(C_BLUE_SOFT, C_CARD, 0.2);
    if (r == 2) tint = mix_rgb(C_PICK_SOFT, C_CARD, 0.1);
    p_shadow(x, y, w, h, 24.0, 4.0, 14.0, 0.12);
    p_box(x, y, w, h, 24.0, tint, 1.0);
    // (The picture, on the right.)
    px: f32 = x + w - 150.0;
    draw_cover_art(r, px, y + 12.0, 136.0, h - 24.0);
    line_clear();
    line_add("CHAPTER ");
    line_int(r + 1);
    pen_end = p_line_text(1, 12.0, x + 22.0, y + 32.0, C_MUTED, 1.0);
    ts: f32 = 28.0;
    tw: f32 = p_sym_w(1, ts, rg_title[r]);
    if (tw > w - 190.0) ts = ts * (w - 190.0) / tw;
    p_sym(1, ts, x + 22.0, y + 66.0, rg_title[r], C_INK, 1.0);
    // (How much is proved, in words.)
    line_clear();
    line_int(solved);
    line_add(" of ");
    line_int(rg_lvn[r]);
    line_add(" proved");
    pen_end = p_line_text(0, 13.0, x + 22.0, y + 94.0, C_MUTED, 1.0);
    // (Its Book: a tap on the cover.)
    bx: f32 = pen_end + 18.0;
    draw_icon(I_BOOK, bx + 6.0, y + 89.0, 6.0, C_MUTED, 1.0);
    pen_end = p_str(1, 13.0, bx + 18.0, y + 94.0, "Book", C_MUTED, 1.0);
    add_button(B_COVER + r, x, y, x + w, y + h);
    y + h
}

// A chapter's picture: a knot of arrows (logic), the square's tiles
// (groups), dots settling into a band (limits).
draw_cover_art(
    r: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    pic: int = rg_pic[r];
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    if (pic == sym("sequence")) {
        // (However close you ask, from some point on they stay that close.)
        p_box(x, cy - 12.0, w, 24.0, 8.0, C_PICK_SOFT, 1.0);
        p_line(x, cy, x + w, cy, 1.5, C_FAINT, 1.0);
        gx: f32 = x + w * 0.42;
        p_line(gx, y + 4.0, gx, y + h - 4.0, 2.0, C_PICK, 0.8);
        for i in 0..14 {
            t: f32 = i as f32 / 13.0;
            dx: f32 = x + 6.0 + t * (w - 12.0);
            s: f32 = 1.0;
            if (i % 2 == 1) s = -1.0;
            dy: f32 = cy + s * 34.0 * expf(-t * 3.2);
            col: int = C_INK;
            if (dx < gx) col = C_FAINT;
            p_disc(dx, dy, 3.6, col, 1.0)
        }
        return
    }
    if (pic == sym("square")) {
        // (Tiles of a train: a, a⁻¹ and e, gathering.)
        cols: []int = cover_cols;
        for i in 0..4 {
            tx: f32 = cx - 58.0 + i as f32 * 30.0;
            ty: f32 = cy - 14.0 + sinf(i as f32 * 1.7) * 9.0;
            col: int = cols[i];
            if (i == 2) {
                p_box(tx, ty, 26.0, 28.0, 8.0, C_WHITE, 1.0);
                p_outline(tx, ty, 26.0, 28.0, 8.0, 2.0, cols[0], 1.0)
            } else {
                p_shadow(tx, ty, 26.0, 28.0, 8.0, 2.0, 5.0, 0.15);
                p_box(tx, ty, 26.0, 28.0, 8.0, col, 1.0)
            }
        }
        p_str_mid(1, 14.0, cx, cy + 36.0, "=", C_FAINT, 1.0);
        return
    }
    // (Logic: arrows tied in a knot.)
    for i in 0..3 {
        a0: f32 = i as f32 * 2.094;
        p_arc(cx, cy, 26.0, 3.0, a0, 1.6, C_PICK, 0.8);
        tx: f32 = cx + cosf(a0 + 1.6) * 26.0;
        ty: f32 = cy + sinf(a0 + 1.6) * 26.0;
        p_disc(tx, ty, 5.0, C_PICK, 0.9)
    }
    p_str_mid(1, 18.0, cx - 40.0, cy - 20.0, "P", C_INK, 0.7);
    p_str_mid(1, 18.0, cx + 42.0, cy + 30.0, "Q", C_INK, 0.7)
}

cover_cols: []int = [3824544, 13784378, 3824544, 4160846];

// Level k of the map as a node at (cx, cy): a pudgy round button (its
// number, a quiet check when proved, a lock), its title beside it. The
// next to play has a thin orange ring.
draw_node(
    k: int,
    i: int,
    cx: f32,
    cy0: f32,
    x: f32,
    w: f32,
    next: bool
) {
    id: int = B_LEVEL + k;
    pk: f32 = pressed(id);
    r: f32 = 27.0 - pk * 2.0;
    cy: f32 = cy0;
    lock: int = level_lock(k);
    fill: int = C_WHITE;
    ring: int = C_LINE;
    if (ml_solved[k]) fill = C_CARD;
    if (lock != 0) fill = C_SUNK;
    if (next) ring = C_PICK;
    // (Pudgy: a thick base under the face.)
    p_shadow(cx - r, cy - r + 3.0, 2.0 * r, 2.0 * r, r, 4.0, 8.0, 0.2);
    p_disc(cx, cy + 4.0 - pk * 2.0, r, mix_rgb(fill, C_INK, 0.22), 1.0);
    p_disc(cx, cy + pk * 2.0, r, fill, 1.0);
    p_ring(cx, cy + pk * 2.0, r, 2.0, ring, 1.0);
    p_disc(cx - r * 0.35, cy - r * 0.4 + pk * 2.0, r * 0.22, C_WHITE, 0.35);
    num_y: f32 = cy + pk * 2.0;
    if (lock != 0) draw_icon(I_LOCK, cx, num_y + 1.0, 9.0, C_FAINT, 1.0) else if (ml_solved[k]) draw_icon(I_CHECK,
        cx, num_y, 9.0, C_MUTED, 1.0) else {
        line_clear();
        line_int(i + 1);
        col: int = C_INK;
        nw: f32 = p_line_w(1, 20.0);
        p_line_text(1, 20.0, cx - nw * 0.5, num_y + 7.0, col, 1.0)
    }
    // (The title on the side with room.)
    right: bool = cx < x + w * 0.5;
    room: f32 = w * 0.5 + absf(cx - x - w * 0.5) - r - 30.0;
    room = minf(room, w * 0.62);
    ts: f32 = 17.0;
    tw: f32 = p_sym_w(1, ts, ml_title[k]);
    if (tw > room) {
        ts = ts * room / tw;
        tw = room
    }
    tx: f32 = cx + r + 14.0;
    if (!right) tx = cx - r - 14.0 - tw;
    tc: int = C_INK;
    if (lock != 0) tc = C_MUTED;
    p_sym(1, ts, tx, cy0 + 6.0, ml_title[k], tc, 1.0);
    if (lock != 0) {
        line_clear();
        line_add("Prove ");
        line_sym(lock);
        line_add(" first");
        lw: f32 = p_line_w(0, 12.0);
        lx: f32 = tx;
        if (!right) lx = tx + tw - lw;
        p_line_text(0, 12.0, lx, cy0 + 24.0, C_FAINT, 1.0)
    }
    bx0: f32 = minf(cx - r, tx) - 6.0;
    bx1: f32 = maxf(cx + r, tx + tw) + 6.0;
    add_button(id, bx0, cy0 - r - 4.0, bx1, cy0 + r + 6.0)
}

// ---- a level ----
// From the top: the bar (back, the title, the bulb, undo), the picture, the facts
// (newest at the bottom), the goal (pinned above the shelf), and the
// shelf (the names, the kit, the rules).
// Where things were drawn, kept for what flies between them.
goal_rx: f32 = 0.0;

goal_ry: f32 = 0.0;

goal_rw: f32 = 0.0;

goal_rh: f32 = 0.0;

fact_rx: f32 = 0.0;

fact_ry: f32 = 0.0;

fact_rw: f32 = 0.0;

fact_rh: f32 = 0.0;

fact_seen: bool = false;

// The picture's height now (it shrinks to a strip when the facts need
// room), and how many facts there were (a new one scrolls them down).
pic_h_now: f32 = 200.0;

facts_seen_n: int = 0;

draw_level() {
    n: int = play_node();
    // (Done: the last goal worked on stays in sight as it settles.)
    if (n < 0 && mv_n > 0) n = last_node;
    if (n >= 0 && done_t < 0.0) last_node = n;
    // (A close being staged: the goal as the move left it.)
    stg: bool = staging();
    if (stg) n = stage_node;
    // (The last goal closing: its facts fade and slide down.)
    fading: bool = done_t >= 0.0 && !stg && stage_node >= 0 && now_t < close_t + FACTS_AWAY;
    if (fading) {
        n = stage_node;
        busy = true
    }
    fade_k: f32 = 0.0;
    if (fading) fade_k = clampf((now_t - close_t) / FACTS_AWAY, 0.0, 1.0);
    x: f32 = col_x();
    w: f32 = col_w();
    morph_fast = now_t - undo_t < 0.2;
    // (The chapter's page up: the title card waits under it.)
    if (chapter_open) {
        intro_open = true;
        intro_t0 = now_t
    }
    if (intro_open && now_t - intro_t0 > 1.55) intro_open = false;
    hy: f32 = safe_top + 30.0;
    top: f32 = draw_level_bar(x, w, hy);
    // (The shelf first laid out: how tall it is says where the board ends.)
    if (done_t < 0.0) {
        sn: int = play_node();
        if (sn < 0) sn = n;
        shelf_build(sn, x, w)
    }
    hand_h: f32 = shelf_height();
    hand_top: f32 = view_h() - safe_bottom - hand_h;
    // (Finished: the board stays where it was.)
    if (done_t >= 0.0) hand_top = hand_top_y;
    board_bot: f32 = hand_top - 14.0;
    level_open();
    deck: int = mini(open_n - 1, 2);
    if (deck < 0) deck = 0;
    g: int = 0;
    if (n >= 0) g = pn_goal[n];
    // (The facts, laid out: how much room they want. Finished: they are
    // put away.)
    fn: int = 0;
    if (n >= 0 && (done_t < 0.0 || stg || fading)) fn = gl_hypn[g];
    if ((stg || fading) && stage_virtual) fn = fn + 1;
    gc: int = 0;
    if (n >= 0) gc = gl_concl[g];
    if (stg) gc = stage_concl;
    real_gc: int = gc;
    if (!stg) gc = lang_goal_shown(gc);
    live: bool = !stg && done_t < 0.0;
    fh: f32 = 0.0;
    for i in 0..fn {
        h: int = board_fact(g, i);
        shown: int = h;
        if (lang_previewing(i)) shown = lang_fact_term(i, h);
        if (live) lay_notch_t = notch_term(n, i, shown);
        e: int = lay_fact_of(h, shown, w);
        lay_notch_t = 0;
        fact_e[i] = e;
        fh = fh + fact_card_h(h, e) + 8.0
    }
    if (fn > 0) fh = fh + 22.0;
    // (The goal: big when there is room, else its usual size.)
    ge: int = -1;
    gh: f32 = 0.0;
    gh_big: f32 = 0.0;
    gh_small: f32 = 0.0;
    e_big: int = -1;
    e_small: int = -1;
    if (n >= 0) {
        if (live) lay_notch_t = notch_term(n, -1, gc);
        e_big = lay_term(gc, 32.0, w - 40.0, SLOT_GOAL);
        gh_big = ex_h[e_big] + 30.0;
        e_small = lay_term(gc, 24.0, w - 36.0, SLOT_GOAL);
        gh_small = ex_h[e_small] + 24.0;
        lay_notch_t = 0
    }
    // (Laid out from the bottom: the shelf, the goal pinned just above it,
    // the facts above that; the picture, or in logic the level's words and
    // its tiles, has the room that is left.)
    say_s: int = 0;
    if (region_picture == 0 && cur_level >= 0) say_s = lv_intro[cur_level];
    say_h: f32 = 0.0;
    if (say_s != 0) say_h = draw_wrapped(0, 19.0, 0.0, 0.0, w - 48.0, say_s, C_INK,
        0.0) + 50.0;
    gap: f32 = 0.0;
    if (fn > 0) gap = 14.0;
    deck_h: f32 = 22.0 + deck as f32 * 7.0;
    pic_min: f32 = 0.0;
    pic_good: f32 = say_h + LT_TILE + 40.0;
    if (region_picture != 0) {
        pic_min = 110.0;
        pic_good = minf(w * 0.5, 200.0);
        if (region_picture == sym("square")) pic_good = 150.0
    }
    room: f32 = board_bot - top - 12.0;
    big: bool = fh + gap + deck_h + gh_big + pic_good <= room;
    need: f32 = fh + gap + deck_h + gh_small;
    if (big) need = fh + gap + deck_h + gh_big;
    fit: bool = need + pic_min <= room;
    want: f32 = maxf(room - need, pic_min);
    // (Not taller than it is wide-ish: what is left over then sits half
    // above it and half below.)
    pic_cap: f32 = view_h();
    slack: f32 = maxf(want - pic_cap, 0.0);
    want = want - slack;
    if (done_t >= 0.0) {
        // (Finished: as it was.)
        big = done_big;
        fit = done_fit;
        want = done_want
    } else {
        done_big = big;
        done_fit = fit;
        done_want = want
    }
    ge = e_small;
    gh = gh_small;
    if (big) {
        ge = e_big;
        gh = gh_big
    }
    if (an_jump) pic_h_now = want else pic_h_now = ease_to(pic_h_now, want, 10.0);
    ph: f32 = pic_h_now;
    if (done_t < 0.0) done_slack = slack else slack = done_slack;
    top = top + slack * 0.5;
    area_top: f32 = top;
    pic_bottom_y = 0.0;
    if (region_picture != 0) {
        draw_picture(x, top, w, ph);
        area_top = top + ph + 12.0;
        pic_bottom_y = top + ph
    } else if (ph >= say_h && say_h > 0.0) {
        draw_logic_pic(x, top, w, ph, say_s);
        area_top = top + ph + 12.0;
        pic_bottom_y = top + ph
    }
    goal_y: f32 = board_bot - gh;
    area_bot: f32 = goal_y - deck as f32 * 7.0 - 24.0;
    y0: f32 = 0.0;
    if (fit) {
        y0 = goal_y - deck as f32 * 7.0 - 22.0 - gap - fh;
        sc_pos[V_LEVEL] = 0.0
    } else {
        if (fn != facts_seen_n && fn > facts_seen_n) sc_pos[V_LEVEL] = maxf(0.0, fh - (area_bot - area_top));
        y0 = area_top - sc_pos[V_LEVEL] + maxf(area_bot - area_top - fh, 0.0)
    }
    facts_seen_n = fn;
    bf_n = 0;
    gk_ok = false;
    gn_ok = false;
    if (!fit) p_clip(0.0, area_top, view_w(), area_bot);
    y: f32 = y0;
    fact_seen = false;
    sf_seen = false;
    // (The goal held up toward the facts: a soft place for it.)
    if (dg_on && dg_kind == DG_GOAL && fn > 0) {
        a0: f32 = 0.12;
        if (hv_kind == T_FACTS) a0 = 0.25;
        p_shape(x - 4.0, y0 + 16.0, w + 8.0, fh - 16.0, 20.0, 10.0, 0.0, C_PICK, a0)
    }
    dent_slot = -1;
    if (fn > 0) {
        y = y + 22.0;
        for i in 0..fn {
            h: int = board_fact(g, i);
            e: int = fact_e[i];
            eh: f32 = fact_card_h(h, e);
            slot: int = hyp_slot(h);
            cy: f32 = card_y(slot, y) + fade_k * fade_k * 40.0;
            ca: f32 = card_a * (1.0 - fade_k);
            if (i == 0) p_str(1, 12.0, x + 6.0, cy - 9.0, "YOU HAVE", C_MUTED, 1.0 - fade_k);
            // (A new fact flying in: its card waits for it; a part of a fact
            // being pinched in two: the pinch draws it.)
            flying: bool = fly_term == h && fly_fact && now_t - fly_t < FLY_TIME;
            pp: int = pinch_part(h);
            if (pp >= 0) {
                pc_seen[pp] = true;
                pc_rx[pp] = x;
                pc_ry[pp] = y;
                pc_rw[pp] = w;
                pc_rh[pp] = eh;
                flying = true
            }
            fill: int = C_BLUE_SOFT;
            if (fact_squeezed(h)) fill = mix_rgb(C_BLUE_SOFT, C_BG, 0.45);
            if (flying) ca = 0.0;
            // (A card held is a ghost of itself; one a thing held fits
            // has a soft edge.)
            fx: f32 = x + pull_dx(T_FACT, i, x + w * 0.5);
            if (dg_on && (dg_kind == DG_FACT || dg_kind == DG_FACE) && dg_item < 0 && dg_src == i || rb_on() && (rb_kind == DG_FACT || rb_kind == DG_FACE) && rb_item < 0 && rb_src == i) ca = ca * 0.3;
            // (A whole card lifted: its place is an empty dent till it is
            // back, none of its writing left behind.)
            dent: bool = dg_on && dg_kind == DG_FACT && dg_item < 0 && dg_src == i || rb_on() && rb_kind == DG_FACT && rb_item < 0 && rb_src == i;
            prev: bool = lang_previewing(i);
            tgt: bool = lang_fact_target(i);
            if (prev || tgt) fill = mix_rgb(C_BLUE_SOFT, C_PICK_SOFT, 0.6);
            // (Held by a tap: lifted a little, its edge drawn.)
            held: bool = pk_is(DG_FACT, i) || pk_is_fact_face(i);
            if (held) {
                cy = cy - 3.0;
                p_shadow(fx, cy, w, eh, minf(18.0, eh * 0.5), 5.0, 10.0, 0.16)
            }
            if (dg_on && lf_fit(i) && !prev && !tgt && helping()) p_shape(x - 3.0,
                cy - 3.0, w + 6.0, eh + 6.0, minf(19.0, eh * 0.5 + 3.0), 6.0, 0.0,
                C_PICK, 0.2);
            if (i < BF) {
                bf_term[i] = h;
                bf_x0[i] = x;
                bf_y0[i] = cy;
                bf_x1[i] = x + w;
                bf_y1[i] = cy + eh;
                bf_seam[i] = 0.0;
                bf_n = i + 1;
                bfk_ok[i] = false;
                bfn_ok[i] = false
            }
            if (dent && e >= 0) dent_slot = ex_slot[e];
            if (dent) {
                rr: f32 = minf(18.0, eh * 0.5);
                p_box(x, cy, w, eh, rr, mix_rgb(C_SUNK, C_BG, 0.35), card_a);
                p_box(x + 3.0, cy + 2.0, w - 6.0, minf(eh * 0.3, 14.0), rr * 0.8,
                    C_SHADOW, 0.08 * card_a);
                p_outline(x, cy, w, eh, rr, 1.5, mix_rgb(C_LINE, C_SUNK, 0.3), 0.8 * card_a);
                flying = true;
                ca = 0.0
            }
            p_box(fx, cy, w, eh, minf(18.0, eh * 0.5), fill, ca);
            pad: f32 = 6.0;
            if (fact_quiet(h)) pad = 3.0;
            if (fact_squeezed(h)) pad = (eh - ex_h[e]) * 0.5;
            if (!flying && ca > 0.5 && !stg) lang_under(e, h, i, fx + 16.0, cy + pad);
            draw_board = true;
            an_salt_extra = 0;
            if (prev) {
                an_salt_extra = fact_gen * 104729;
                an_quick = now_t < quick_t
            }
            if (!flying) draw_expr(e, fx + 16.0, cy + pad, C_INK, ca, true);
            an_salt_extra = 0;
            an_quick = false;
            draw_board = false;
            if (!flying && ca > 0.5 && !stg) lang_over(e, h, i);
            // (An equation, or one for every x: a seam between its faces.)
            if (i < BF && !prev && e >= 0 && eq_fact(h)) {
                bf_seam[i] = fx + 16.0 + seam_x(e, -1);
                if (ca > 0.5) draw_seam(bf_seam[i], cy, eh, mix_rgb(C_BLUE_SOFT, C_BLUE,
                    0.35), ca)
            }
            if (held) {
                hx0: f32 = fx;
                hx1: f32 = fx + w;
                if (pk_is_fact_face(i) && bf_seam[i] > 0.0) {
                    if (pk_face == 0) hx1 = bf_seam[i] else hx0 = bf_seam[i]
                }
                p_outline(hx0, cy, hx1 - hx0, eh, minf(18.0, eh * 0.5), 2.0, C_HOLD,
                    0.6)
            }
            if (h == side_fact && side_fact != 0) draw_side_tick(x, cy, w, eh, ca);
            if (fly_term == h) {
                fact_rx = x + 16.0;
                fact_ry = cy + pad;
                fact_size = ex_size[e];
                fact_seen = true
            }
            // (A split's part closing with this fact: its copy goes from
            // here.)
            if (split_on()) {
                for si in 0..mini(sp_n, 4) {
                    if (sp_fact[si] == h) {
                        sp_fx[si] = x + 16.0;
                        sp_fy[si] = cy + pad;
                        sp_fs[si] = ex_size[e];
                        sp_fseen[si] = true
                    }
                }
            }
            if (stg && h == stage_fact) {
                // (The fact that closes the goal: its copy goes from here.)
                sf_x = x + 16.0;
                sf_y = cy + pad;
                sf_size = ex_size[e];
                sf_seen = true
            }
            y = y + eh + 8.0
        }
    }
    if (fit) sc_most[V_LEVEL] = 0.0 else sc_most[V_LEVEL] = y + sc_pos[V_LEVEL] - area_bot + 6.0;
    if (!fit) p_noclip();
    // (The goal; not when it has closed for good.)
    goal_real_e = -1;
    if (split_on()) {
        p_str(1, 12.0, x + 6.0, goal_y - 10.0, "SHOW", C_MUTED, 1.0);
        draw_split(x, goal_y, w, gh);
        goal_ex = -1
    } else if (ge >= 0 && (done_t < 0.0 || stg)) {
        for d0 in 0..deck {
            d: int = deck - d0;
            dy: f32 = d as f32 * 7.0;
            inset: f32 = d as f32 * 10.0;
            p_shadow(x + inset, goal_y - dy, w - 2.0 * inset, gh, 20.0, 2.0, 8.0,
                0.1);
            p_box(x + inset, goal_y - dy, w - 2.0 * inset, gh, 20.0, mix_rgb(C_CARD,
                C_SUNK, 0.4 + 0.2 * d as f32), 1.0);
            p_outline(x + inset, goal_y - dy, w - 2.0 * inset, gh, 20.0, 1.5, C_LINE,
                1.0)
        }
        gy: f32 = card_y(SLOT_GOAL, goal_y);
        p_str(1, 12.0, x + 6.0, gy - deck as f32 * 7.0 - 10.0, "SHOW", C_MUTED, 1.0);
        gx: f32 = x;
        gw: f32 = w;
        gfill: int = C_CARD;
        gx = gx + pull_dx(T_GOAL, -1, x + w * 0.5) + goal_swipe_dx();
        gprev: bool = lang_previewing(-1) || lang_goal_target() && !stg;
        if (gprev) gfill = mix_rgb(C_CARD, C_PICK_SOFT, 0.5);
        if (dg_on && lf_goal && !gprev && helping()) p_shape(gx - 4.0, gy - 4.0, gw + 8.0,
            gh + 8.0, 24.0, 8.0, 0.0, C_PICK, 0.2);
        // (Held up toward the facts: its place is a ghost.)
        ga: f32 = 1.0;
        if (dg_on && dg_kind == DG_GOAL || rb_on() && rb_kind == DG_GOAL) ga = 0.35;
        p_shadow(gx, gy, gw, gh, 20.0, 4.0, 14.0, 0.16 * ga);
        p_box(gx, gy, gw, gh, 20.0, gfill, ga);
        // (A soft brown edge; orange when it shows a preview.)
        bord: int = mix_rgb(C_LINE, C_MUTED, 0.3);
        th: f32 = 2.0;
        if (gprev) bord = mix_rgb(C_PICK, C_LINE, 0.3);
        dead: bool = lang_dead() && !stg;
        if (dead) p_box(gx, gy, gw, gh, 20.0, mix_rgb(C_SUNK, C_CARD, 0.4), 1.0);
        p_outline(gx, gy, gw, gh, 20.0, th, bord, ga);
        // (A changed part flying in: its block waits.)
        hide_term = 0;
        ft: f32 = (now_t - fly_t) / FLY_TIME;
        if (ft >= 0.0 && ft < 1.0 && fly_hl != 0 && !fly_fact && fly_hl_seen) {
            hide_term = fly_hl;
            hide_slot = SLOT_GOAL
        }
        gox: f32 = gx + 20.0;
        goy: f32 = gy + (gh - ex_h[ge]) * 0.5;
        if (!stg) lang_under(ge, gc, -1, gox, goy);
        draw_board = true;
        gink: int = C_INK;
        if (dead) gink = C_MUTED;
        // (A face over a part: the part it changes tinted.)
        hl_key = 0;
        if (hovering() && hv_kind == T_PART) {
            pt: int = raw_at(gc, hv_steps, 0, hv_n);
            if (pt != 0) hl_key = pt * 16
        }
        // (A preview morphs block by block, as a move does: what stays
        // slides, what goes fades before what comes swells in.)
        an_salt_extra = 0;
        an_quick = false;
        if (ps_on) socket_slot = SLOT_GOAL;
        blocks_shown = dg_on && dg_kind == DG_FACE;
        draw_expr(ge, gox, goy, gink, ga, true);
        blocks_shown = false;
        socket_slot = -1;
        an_salt_extra = 0;
        an_quick = false;
        hl_key = 0;
        draw_board = false;
        hide_term = 0;
        if (!stg) lang_over(ge, gc, -1);
        if (dead) draw_dead_goal(gx, gy, gw, gh);
        goal_ex = ge;
        // (The goal as it really is, where it is: the parts a face goes
        // onto are found in it.)
        if (gc == real_gc) goal_real_e = ge else if (!stg) {
            an_live = false;
            lay_notch_t = notch_term(n, -1, real_gc);
            er: int = lay_term(real_gc, if_big(big), w - 40.0, SLOT_GOAL + 1);
            lay_notch_t = 0;
            an_live = true;
            if (er >= 0) {
                ex_ox[er] = gox;
                ex_oy[er] = gy + (gh - ex_h[er]) * 0.5;
                goal_real_e = er
            }
        }
        goal_paths_keep(goal_real_e);
        // (The peeking goals, tapped, come forward.)
        k: int = 0;
        for i in 0..open_n {
            if (open_nodes[i] != n && k < deck) {
                k = k + 1;
                dy: f32 = k as f32 * 7.0;
                add_button(B_DECK + i, x, goal_y - dy - 4.0, x + w, goal_y - dy + 7.0)
            }
        }
        goal_ry = gy
    } else {
        goal_ex = -1;
        if (done_t >= 0.0 && !split_on()) draw_done_goal(x, w)
    }
    if (done_t < 0.0) {
        goal_rx = x;
        goal_rw = w;
        goal_rh = gh;
        if (ge < 0) goal_ry = goal_y
    }
    leavers_step();
    draw_fact_pinch();
    hand_top_y = hand_top;
    bar_bottom_y = top;
    draw_shelf(x, w, hand_top);
    draw_fly();
    draw_copy();
    draw_close();
    if (now_t - say_t < 3.5 && cur_level >= 0 && lv_intro[cur_level] != 0) draw_say(x,
        w, hy + 46.0);
    if (done_t >= 0.0) draw_done(x, w);
    draw_lang_top(x, w);
    draw_intro(x, w);
    draw_chapter(x, w);
    boxes_print()
}

// The goal's writing size, big or not.
if_big(big: bool): f32 {
    if (big) return 32.0;
    24.0
}

// Whether fact h is an equation, or one for every x: it has two faces.
eq_fact(h: int): bool {
    q: int = rel_core(h);
    if (shape_of(q) == SH_ALL && tm_kind(tm_arg(q)) == TM_ABS) q = tm_body(tm_arg(q));
    is_binary(q, role_name[ROLE_EQ])
}

// A side condition arithmetic closed (0 < ε/2) as the move giving the fact
// on card (x, y, w, h) was made: a small plain chip at the card's right
// end that fades in, with a check, and goes.
draw_side_tick(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    a0: f32
) {
    t: f32 = now_t - side_t;
    if (t < 0.0) {
        busy = true;
        return
    }
    if (t > 1.4) return;
    busy = true;
    a: f32 = a0 * clampf(t / 0.2, 0.0, 1.0) * clampf((1.4 - t) / 0.3, 0.0, 1.0);
    an_live = false;
    e: int = lay_term(side_term, 13.0, w * 0.5, 9300000);
    an_live = true;
    if (e < 0) return;
    pw: f32 = ex_w[e] + 36.0;
    ph: f32 = ex_h[e] + 10.0;
    cx: f32 = x + w - 10.0 - pw * 0.5;
    cy: f32 = y + h * 0.5;
    p_box(cx - pw * 0.5, cy - ph * 0.5, pw, ph, ph * 0.5, C_SUNK, a);
    an_live = false;
    draw_expr(e, cx - pw * 0.5 + 8.0, cy - ex_h[e] * 0.5, C_MUTED, a, false);
    an_live = true;
    draw_icon(I_CHECK, cx + pw * 0.5 - 13.0, cy, 4.5, C_MUTED, a)
}

// The board's fact i: goal g's, then (a close staged) the fact the move
// gave that closed the goal at once.
board_fact(g: int, i: int): int {
    if (i >= gl_hypn[g]) return stage_fact;
    goal_hyp(g, i)
}

// How the board was laid out when the level was finished (kept).
done_big: bool = false;

done_fit: bool = true;

done_want: f32 = 0.0;

// The goal's expression drawn this frame (-1 none), and the fact flown
// to: its writing's size.
goal_ex: int = -1;

fact_size: f32 = 18.0;

done_slack: f32 = 0.0;

// Where the picture ends (0: none shown).
pic_bottom_y: f32 = 0.0;

// Where the bar ends (toasts show just under it).
bar_bottom_y: f32 = 80.0;

fact_e: []int = new int[256](0);

last_node: int = 0;

// Where the hand starts (a finger below it scrolls the hand).
hand_top_y: f32 = 10000.0;

// A fact laid out: small, on one line, if it has not been touched lately.
lay_fact(h: int, w: f32): int {
    lay_fact_of(h, h, w)
}

// Fact h laid out showing t (a preview of it, or itself). One with a
// notch is never made so small its notch cannot be reached.
lay_fact_of(h: int, t: int, w: f32): int {
    notch: bool = lay_notch_t != 0;
    if (fact_squeezed(h) && !notch) {
        lay_one_line = true;
        e: int = lay_term(t, 12.5, w - 28.0, hyp_slot(h));
        lay_one_line = false;
        return e
    }
    if (fact_quiet(h) || fact_squeezed(h)) {
        lay_one_line = true;
        sz: f32 = 14.0;
        if (notch) sz = 18.0;
        e: int = lay_term(t, sz, w - 28.0, hyp_slot(h));
        lay_one_line = false;
        return e
    }
    // (Facts big enough to take hold of: as big as the goal in Logic,
    // where the picture needs little room.)
    if (lang_first()) return lay_term(t, 28.0, w - 32.0, hyp_slot(h));
    lay_term(t, 22.0, w - 32.0, hyp_slot(h))
}

fact_card_h(h: int, e: int): f32 {
    if (e >= 0 && ex_nok[e]) return maxf(ex_h[e] + 12.0, 56.0);
    if (fact_squeezed(h)) return maxf(ex_h[e], 22.0);
    if (fact_quiet(h)) return ex_h[e] + 6.0;
    // (Room round a notch or a key: a thumb's height.)
    maxf(ex_h[e] + 12.0, 56.0)
}

// The bar: back, the title (tap: its words again), the bulb, undo.
// Where what is under it starts.
draw_level_bar(x: f32, w: f32, hy: f32): f32 {
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    round_button(B_HINT, x + w - 70.0, hy, I_BULB);
    round_button(B_UNDO, x + w - 22.0, hy, I_UNDO);
    if (playing >= 0) {
        tsize: f32 = 18.0;
        room: f32 = w - 2.0 * 96.0;
        tw: f32 = p_sym_w(1, tsize, ml_title[playing]);
        if (tw > room) {
            tsize = tsize * room / tw;
            tw = room
        }
        p_sym(1, tsize, x + w * 0.5 - tw * 0.5, hy + 6.0, ml_title[playing], C_INK,
            1.0);
        add_button(B_TITLE, x + w * 0.5 - room * 0.5, hy - 18.0, x + w * 0.5 + room * 0.5,
            hy + 18.0)
    }
    hy + 32.0
}

// ---- juice ----
// What a row gives flies from it to its place on the board, carrying its
// writing: a new fact to its card (which waits for it), or the changed
// part of a rewritten goal to the block it becomes. Landing where it goes,
// it hands over to the board.
const FLY_TIME: f32 = 0.24;

draw_fly() {
    t: f32 = (now_t - fly_t) / FLY_TIME;
    if (t < 0.0 || t >= 1.0 || fly_term == 0) return;
    busy = true;
    x0: f32 = fly_x0;
    y0: f32 = fly_y0;
    s0: f32 = fly_s0;
    x1: f32 = 0.0;
    y1: f32 = 0.0;
    s1: f32 = 0.0;
    term: int = 0;
    if (fly_fact && fact_seen) {
        term = fly_term;
        x1 = fact_rx;
        y1 = fact_ry;
        s1 = fact_size
    } else if (fly_hl != 0 && goal_ex >= 0 && fly_hl_seen) {
        // (The changed part: from its block in the row to its block in the
        // goal.)
        b: int = -1;
        for k in ex_box0[goal_ex]..ex_box0[goal_ex] + ex_boxn[goal_ex] {
            if (b < 0 && bx_term[k] == fly_hl) b = k
        }
        // (Only a part on one line: a whole statement changed is shown by
        // its morph.)
        if (b < 0 || b == ex_box0[goal_ex] || bx_y1[b] - bx_y0[b] > ex_size[goal_ex] * 1.7) return;
        term = fly_hl;
        x0 = fly_hx0;
        y0 = fly_hy0;
        x1 = ex_ox[goal_ex] + bx_x0[b];
        y1 = ex_oy[goal_ex] + bx_y0[b] - minf(bx_depth[b] as f32, 4.0) * ex_size[goal_ex] * 0.075;
        s1 = ex_size[goal_ex]
    } else return;
    k: f32 = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);
    an_live = false;
    lay_one_line = true;
    e: int = lay_term(term, s0 + (s1 - s0) * k, col_w() - 36.0, 9100000);
    lay_one_line = false;
    if (e < 0) {
        an_live = true;
        return
    }
    xx: f32 = x0 + (x1 - x0) * k;
    yy: f32 = y0 + (y1 - y0) * k - sinf(t * 3.1416) * 22.0;
    // (Its card fades as it lands.)
    a: f32 = 1.0 - t;
    p_shadow(xx - 6.0, yy - 2.0, ex_w[e] + 12.0, ex_h[e] + 4.0, 12.0, 4.0 * a, 12.0,
        0.15 * a);
    p_box(xx - 6.0, yy - 2.0, ex_w[e] + 12.0, ex_h[e] + 4.0, 12.0, C_CARD, a);
    draw_expr(e, xx, yy, C_INK, 1.0, false);
    an_live = true
}

// The fact that closes a goal, copied into it (the close staged): from
// its card to the goal's writing.
sf_x: f32 = 0.0;

sf_y: f32 = 0.0;

sf_size: f32 = 18.0;

sf_seen: bool = false;

draw_copy() {
    if (!staging() || stage_fact == 0 || !sf_seen || goal_ex < 0 || split_on()) return;
    t: f32 = (now_t - (close_t - COPY_TIME)) / COPY_TIME;
    if (t < 0.0 || t >= 1.0) return;
    draw_copy_of(stage_fact, t, sf_x, sf_y, sf_size, ex_ox[goal_ex], ex_oy[goal_ex],
        ex_size[goal_ex])
}

// A copy of fact f flying (t from 0 to 1) from its writing at (x0, y0),
// size s0, to (x1, y1), size s1.
draw_copy_of(
    f: int,
    t: f32,
    x0: f32,
    y0: f32,
    s0: f32,
    x1: f32,
    y1: f32,
    s1: f32
) {
    busy = true;
    k: f32 = t * t * (3.0 - 2.0 * t);
    an_live = false;
    lay_one_line = true;
    e: int = lay_term(f, s0 + (s1 - s0) * k, col_w() - 36.0, 9150000);
    lay_one_line = false;
    an_live = true;
    if (e < 0) return;
    xx: f32 = x0 + (x1 - x0) * k;
    yy: f32 = y0 + (y1 - y0) * k - sinf(t * 3.1416) * 26.0;
    a: f32 = 1.0 - maxf(t - 0.7, 0.0) / 0.3;
    p_shadow(xx - 8.0, yy - 3.0, ex_w[e] + 16.0, ex_h[e] + 6.0, 12.0, 4.0, 12.0, 0.15 * a);
    p_box(xx - 8.0, yy - 3.0, ex_w[e] + 16.0, ex_h[e] + 6.0, 12.0, C_CARD, a);
    p_outline(xx - 8.0, yy - 3.0, ex_w[e] + 16.0, ex_h[e] + 6.0, 12.0, 1.5, C_LINE,
        a);
    draw_expr(e, xx, yy, C_INK, a, false)
}

// Where the row tapped had its writing, and its changed part (kept when
// tapped: the rows are new after the move).
fly_x0: f32 = 0.0;

fly_y0: f32 = 0.0;

fly_s0: f32 = 18.0;

fly_hx0: f32 = 0.0;

fly_hy0: f32 = 0.0;

fly_hl_seen: bool = false;

// A goal closing: its card shows a small check a moment and fades where
// it is.
draw_close() {
    if (split_on()) return;
    draw_close_card(now_t - close_t, goal_rx, goal_ry, goal_rw, goal_rh, close_term,
        close_calc)
}

// A goal's card (x, y, w, h) closing, t after it closed: a small check,
// "by arithmetic" under it if that closed it, and it fades.
draw_close_card(
    t: f32,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    term: int,
    calc: bool
) {
    if (t < 0.0 || t > 0.6) return;
    busy = true;
    a: f32 = 1.0 - clampf((t - 0.25) / 0.35, 0.0, 1.0);
    r: f32 = minf(20.0, h * 0.5);
    p_box(x, y, w, h, r, C_CARD, a);
    p_outline(x, y, w, h, r, 2.0, mix_rgb(C_LINE, C_MUTED, 0.3), a);
    an_live = false;
    e: int = lay_term(term, if_big(done_big), maxf(w - 66.0, 10.0), 9200000);
    if (e >= 0) draw_expr(e, x + 18.0, y + (h - ex_h[e]) * 0.5, C_INK, a, false);
    an_live = true;
    draw_icon(I_CHECK, x + w - 26.0, y + h * 0.5, 7.0, C_MUTED, a);
    if (calc) {
        tw: f32 = p_str_w(0, 12.0, "by arithmetic");
        p_str(0, 12.0, x + w - 14.0 - tw, y + h + 16.0, "by arithmetic", C_MUTED,
            a)
    }
}

// Whether a split goal's parts are being shown closing in turn.
split_on(): bool {
    sp_n > 0 && now_t < sp_t[sp_n - 1] + 0.8
}

// Where each part's fact was drawn (its copy flies from there).
sp_fx: []f32 = new f32[4](0.0);

sp_fy: []f32 = new f32[4](0.0);

sp_fs: []f32 = new f32[4](18.0);

sp_fseen: []bool = new bool[4](false);

// The goal card (x, y, w, h, its term stage_concl) divided into its parts
// side by side; each waits, its fact's copy flies into it, and it closes.
draw_split(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    busy = true;
    t: f32 = now_t - sp_t0;
    gap: f32 = 12.0;
    pw: f32 = (w - gap * (sp_n - 1) as f32) / sp_n as f32;
    if (t < SPLIT_TIME + PINCH_IN && sp_n == 2) {
        // (Pinched like dough: the card stretches, a waist forms at its
        // ∧, and it parts into two, each half carrying its own writing.)
        pinch_draw(x, y, w, h, stage_concl, if_big(done_big), x + 20.0, t, x, y, pw,
            h, x + pw + gap, y, pw, h, C_CARD, false);
        return
    }
    for i in 0..sp_n {
        px: f32 = x + i as f32 * (pw + gap);
        tc: f32 = now_t - sp_t[i];
        if (tc >= 0.0) draw_close_card(tc, px, y, pw, h, sp_term[i], sp_calc[i]) else draw_part(i,
            t + PINCH_IN, px, y, pw, h)
    }
}

// How long the waist takes to form before the halves part.
const PINCH_IN: f32 = 0.14;

// A statement A ∧ B on a card (x, y, w, h; its writing at size, from ox)
// pinched into two cards, (ax, ay, aw, ah) and (bx, by, bw, bh), t since it
// began: a waist forms at the ∧ (the ∧ puffs), then the halves part, a
// little past their places and back, each with its writing. Facts are
// blue (fact).
pinch_draw(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    t0: int,
    size: f32,
    ox: f32,
    t: f32,
    ax: f32,
    ay: f32,
    aw: f32,
    ah: f32,
    bx: f32,
    by: f32,
    bw: f32,
    bh: f32,
    fill: int,
    fact: bool
) {
    busy = true;
    q: int = rel_core(t0);
    if (spine_len(q) != 2) return;
    pa: int = spine_arg(q, 2, 0);
    pb: int = spine_arg(q, 2, 1);
    an_live = false;
    e: int = lay_term(q, size, w - 40.0, 9250000);
    an_live = true;
    if (e < 0) return;
    ty: f32 = y + (h - ex_h[e]) * 0.5;
    // (Where the ∧ is, and where each part's writing starts.)
    xs: f32 = x + w * 0.5;
    if (key_rect(e, q, ox, ty)) xs = (kr_x0 + kr_x1) * 0.5;
    a_x: f32 = ox;
    b_x: f32 = xs + 20.0;
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        if (bx_term[b] == pb && bx_parent[b] == ex_box0[e]) b_x = ox + bx_x0[b]
    }
    s1: f32 = clampf(t / PINCH_IN, 0.0, 1.0);
    u: f32 = clampf((t - PINCH_IN) / SPLIT_TIME, 0.0, 1.0);
    k: f32 = 1.0 - (1.0 - u) * (1.0 - u) * (1.0 - u) + sinf(u * 3.1416) * 0.1;
    // (Stretching: a little wider while the waist forms.)
    st: f32 = sinf(s1 * 3.1416 * 0.5) * (1.0 - u) * 0.04 * w;
    r: f32 = minf(20.0, h * 0.5);
    // (The halves now.)
    l0: f32 = x - st + (ax - (x - st)) * k;
    l1: f32 = xs - 3.0 * s1 + (ax + aw - (xs - 3.0 * s1)) * k;
    lt: f32 = y + (ay - y) * k;
    lh: f32 = h + (ah - h) * k;
    m0: f32 = xs + 3.0 * s1 + (bx - (xs + 3.0 * s1)) * k;
    m1: f32 = x + w + st + (bx + bw - (x + w + st)) * k;
    mt: f32 = y + (by - y) * k;
    mh: f32 = h + (bh - h) * k;
    edge: int = mix_rgb(C_LINE, C_MUTED, 0.45);
    if (fact) edge = mix_rgb(C_BLUE_SOFT, C_BLUE, 0.3);
    // (The waist: thinner as it forms, gone as they part.)
    if (u < 0.25) {
        nh: f32 = h * (1.0 - 0.85 * s1) * (1.0 - u * 4.0);
        p_box(xs - 14.0, y + h * 0.5 - nh * 0.5, 28.0, nh, minf(nh * 0.5, 14.0), fill,
            1.0)
    }
    sh: f32 = 0.16;
    if (fact) sh = 0.08;
    rl: f32 = minf(r, (l1 - l0) * 0.5);
    rm: f32 = minf(r, (m1 - m0) * 0.5);
    p_shadow(l0, lt, l1 - l0, lh, rl, 4.0, 14.0, sh);
    p_box(l0, lt, l1 - l0, lh, rl, fill, 1.0);
    p_shadow(m0, mt, m1 - m0, mh, rm, 4.0, 14.0, sh);
    p_box(m0, mt, m1 - m0, mh, rm, fill, 1.0);
    if (!fact) {
        p_outline(l0, lt, l1 - l0, lh, rl, 3.0, edge, 1.0);
        p_outline(m0, mt, m1 - m0, mh, rm, 3.0, edge, 1.0)
    }
    // (The ∧ puffs away from the waist.)
    if (u < 0.35) {
        line_clear();
        line_add(" ");
        line_cp(8743);
        line_add(" ");
        g: int = line_sym_now();
        gs: f32 = size * (1.0 + 0.8 * u);
        gw: f32 = p_sym_w(0, gs, g);
        p_sym(0, gs, xs - gw * 0.5, ty + ex_h[e] * 0.5 + gs * 0.36 - 14.0 * u, g,
            C_INK, (1.0 - s1 * 0.4) * (1.0 - u / 0.35))
    }
    // (Each half's writing, carried along.)
    an_live = false;
    ea: int = lay_term(pa, size, maxf(l1 - l0 - 30.0, 30.0), 9251000);
    if (ea >= 0) {
        tx: f32 = a_x + (ax + 18.0 - a_x) * k;
        draw_expr(ea, tx, lt + (lh - ex_h[ea]) * 0.5, C_INK, 1.0, false)
    }
    eb: int = lay_term(pb, size, maxf(m1 - m0 - 30.0, 30.0), 9252000);
    if (eb >= 0) {
        tx: f32 = b_x + (bx + 18.0 - b_x) * k;
        draw_expr(eb, tx, mt + (mh - ex_h[eb]) * 0.5, C_INK, 1.0, false)
    }
    an_live = true
}

// Part i of a split goal, waiting to close (t since the split).
draw_part(
    i: int,
    t: f32,
    px: f32,
    y: f32,
    cw: f32,
    h: f32
) {
    p_shadow(px, y, cw, h, 20.0, 4.0, 14.0, 0.16);
    p_box(px, y, cw, h, 20.0, C_CARD, 1.0);
    p_outline(px, y, cw, h, 20.0, 2.0, mix_rgb(C_LINE, C_MUTED, 0.3), 1.0);
    an_live = false;
    e: int = lay_term(sp_term[i], if_big(done_big), maxf(cw - 30.0, 10.0), 9260000 + i);
    ta: f32 = clampf((t - SPLIT_TIME * 0.4) / 0.2, 0.0, 1.0);
    if (e >= 0) draw_expr(e, px + 18.0, y + (h - ex_h[e]) * 0.5, C_INK, ta, false);
    an_live = true;
    // (Its fact's copy flying in.)
    ct: f32 = (now_t - (sp_t[i] - COPY_TIME)) / COPY_TIME;
    if (ct >= 0.0 && ct < 1.0 && sp_fact[i] != 0 && i < 4 && sp_fseen[i] && e >= 0) draw_copy_of(sp_fact[i],
        ct, sp_fx[i], sp_fy[i], sp_fs[i], px + 18.0, y + (h - ex_h[e]) * 0.5, 23.0)
}

// The level's words again, under the bar, for a moment.
draw_say(x: f32, w: f32, y: f32) {
    t: f32 = now_t - say_t;
    a: f32 = clampf(t * 6.0, 0.0, 1.0) * clampf((3.5 - t) * 3.0, 0.0, 1.0);
    busy = true;
    s: int = lv_intro[cur_level];
    ih: f32 = draw_wrapped(0, 16.0, 0.0, 0.0, w - 40.0, s, C_INK, 0.0);
    p_shadow(x, y, w, ih + 22.0, 16.0, 3.0, 10.0, 0.12 * a);
    p_box(x, y, w, ih + 22.0, 16.0, C_CARD, a);
    draw_wrapped(0, 16.0, x + 20.0, y + 26.0, w - 40.0, s, C_INK, a)
}

// A chapter's first page: CHAPTER k, its title, its picture, its one
// sentence, and its rulebook as tiles (the rules given; or, where they are
// Calculate's, the definitions and Calculate), each fading in; Begin.
// Any tap puts it away.
draw_chapter(x: f32, w: f32) {
    if (!chapter_open || loaded_region < 0) return;
    t: f32 = now_t - chapter_t0;
    busy = true;
    r: int = loaded_region;
    p_box(0.0, 0.0, view_w(), view_h(), 0.0, C_BG, 1.0);
    a: f32 = clampf(t * 5.0, 0.0, 1.0);
    rise: f32 = (1.0 - a) * 24.0;
    y: f32 = safe_top + 58.0 + rise;
    line_clear();
    line_add("CHAPTER ");
    line_int(r + 1);
    lw: f32 = p_line_w(1, 13.0);
    p_line_text(1, 13.0, x + w * 0.5 - lw * 0.5, y, C_MUTED, a);
    tw: f32 = p_sym_w(1, 36.0, rg_title[r]);
    p_sym(1, 36.0, x + w * 0.5 - tw * 0.5, y + 44.0, rg_title[r], C_INK, a);
    y = y + 66.0;
    // (The picture, on a card of the chapter's color.)
    tint: int = mix_rgb(C_GOLD_SOFT, C_CARD, 0.2);
    if (r == 1) tint = mix_rgb(C_BLUE_SOFT, C_CARD, 0.2);
    if (r == 2) tint = mix_rgb(C_PICK_SOFT, C_CARD, 0.1);
    ph: f32 = 120.0;
    p_shadow(x, y, w, ph, 24.0, 4.0, 14.0, 0.12 * a);
    p_box(x, y, w, ph, 24.0, tint, a);
    draw_cover_art(r, x + w * 0.5 - 90.0, y + 10.0, 180.0, ph - 20.0);
    y = y + ph + 34.0;
    // (The sentence.)
    sa: f32 = clampf((t - 0.15) * 5.0, 0.0, 1.0);
    y = y + draw_wrapped(1, 20.0, x + 10.0, y, w - 20.0, region_chapter, C_INK, sa) + 18.0;
    // (The rulebook, as tiles.)
    p_str(1, 12.0, x + 8.0, y, "THE RULEBOOK", C_MUTED, sa);
    y = y + 12.0;
    next_y: f32 = view_h() - safe_bottom - 28.0 - 64.0;
    k: int = 0;
    any_rule: bool = false;
    for l in 0..lm_n {
        if (lm_kind[l] == LM_ASSUME && !lm_hidden[l]) any_rule = true
    }
    for l in 0..lm_n {
        want: bool = lm_kind[l] == LM_ASSUME && !lm_hidden[l] || !any_rule && lm_kind[l] == LM_DEF && !lm_hidden[l];
        if (want) {
            y = chapter_tile(x, y, w, t, k, lm_words[l], thm_prop(lm_thm[l]), 8100000 + l,
                next_y);
            k = k + 1
        }
    }
    if (region_calc) {
        y = chapter_tile(x, y, w, t, k, sym("Calculate"), 0, 0, next_y);
        k = k + 1
    }
    // (Begin: a plain pill, in the thumb's reach.)
    nk: f32 = clampf((t - 0.5) * 4.0, 0.0, 1.0);
    if (nk <= 0.0) return;
    ny: f32 = next_y + 12.0;
    plain_next(x + w * 0.5 - plain_next_w("Begin") * 0.5, ny, "Begin", nk);
    add_button(B_NEXT, 0.0, 0.0, view_w(), view_h())
}

// One tile of the chapter's rulebook: its name and its statement (or, for
// Calculate, what it does), fading in after the k before it. The y after.
chapter_tile(
    x: f32,
    y: f32,
    w: f32,
    t: f32,
    k: int,
    name: int,
    prop: int,
    slot: int,
    room_end: f32
): f32 {
    pk: f32 = clampf((t - 0.3 - k as f32 * 0.06) / 0.25, 0.0, 1.0);
    e: int = -1;
    th: f32 = 54.0;
    if (prop != 0) {
        an_live = false;
        e = lay_term(prop, 16.0, w - 40.0, slot);
        an_live = true;
        th = ex_h[e] + 36.0
    }
    if (y + th > room_end - 12.0) return y;
    if (pk <= 0.0) return y + th + 8.0;
    p_shadow(x, y, w, th, 16.0, 2.0, 8.0, 0.08 * pk);
    p_box(x, y, w, th, 16.0, C_CARD, pk);
    p_outline(x, y, w, th, 16.0, 1.5, C_LINE, pk);
    if (name != 0) p_sym(1, 13.0, x + 16.0, y + 20.0, name, C_MUTED, pk);
    if (e >= 0) {
        an_live = false;
        draw_expr(e, x + 16.0, y + 27.0, C_INK, pk, false);
        an_live = true
    } else pen_end = p_str(0, 15.0, x + 16.0, y + 42.0, "The arithmetic of numbers, done for you.",
        C_INK, pk);
    y + th + 8.0
}

// A new level: its title and theorem, big, a moment; then the board.
draw_intro(x: f32, w: f32) {
    if (!intro_open || playing < 0 || cur_level < 0) return;
    t: f32 = now_t - intro_t0;
    // (The card's writing goes first; the scrim under it after, so the
    // two never show through each other.)
    sa: f32 = clampf((1.55 - t) / 0.22, 0.0, 1.0);
    if (sa <= 0.0) return;
    a: f32 = clampf((1.3 - t) / 0.2, 0.0, 1.0);
    busy = true;
    rise: f32 = (1.0 - clampf(t * 5.0, 0.0, 1.0)) * 30.0 - (1.0 - a) * 16.0;
    p_box(0.0, 0.0, view_w(), view_h(), 0.0, C_BG, sa);
    if (a <= 0.0) return;
    cy: f32 = view_h() * 0.36 + rise;
    line_clear();
    line_add("LEVEL ");
    line_int(playing - rg_lv0[region_of(playing)] + 1);
    lw: f32 = p_line_w(1, 13.0);
    p_line_text(1, 13.0, x + w * 0.5 - lw * 0.5, cy - 64.0, C_MUTED, a);
    tw: f32 = p_sym_w(1, 28.0, ml_title[playing]);
    ts: f32 = 28.0;
    if (tw > w) {
        ts = ts * w / tw;
        tw = w
    }
    p_sym(1, ts, x + w * 0.5 - tw * 0.5, cy - 26.0, ml_title[playing], C_INK, a);
    an_live = false;
    e: int = lay_term(lv_goal[cur_level], 26.0, w - 40.0, 9300000);
    eh: f32 = ex_h[e] + 30.0;
    ew: f32 = minf(ex_w[e] + 44.0, w);
    p_shadow(x + w * 0.5 - ew * 0.5, cy, ew, eh, 22.0, 5.0, 16.0, 0.16 * a);
    p_box(x + w * 0.5 - ew * 0.5, cy, ew, eh, 22.0, C_CARD, a);
    p_outline(x + w * 0.5 - ew * 0.5, cy, ew, eh, 22.0, 2.0, mix_rgb(C_LINE, C_MUTED,
        0.3), a);
    draw_expr(e, x + w * 0.5 - ex_w[e] * 0.5, cy + 15.0, C_INK, a, false);
    an_live = true;
    if (lv_intro[cur_level] != 0) draw_wrapped(0, 17.0, x + 24.0, cy + eh + 40.0,
        w - 48.0, lv_intro[cur_level], C_MUTED, a)
}

// The ghost finger: it shows the player what to press (watching, or a
// hint), easing to the button it points at.
ghost_x: f32 = 0.0;

ghost_y: f32 = 0.0;

// ---- done ----
// The goal settles, where it is, into the theorem proved (its writing
// morphing from the last goal's); over it "Proved.", under it Read the
// proof (a link) and Next.
done_h: f32 = 0.0;

done_card_y: f32 = 0.0;

// The finished goal's card, drawn where the goal was (from the board).
draw_done_goal(x: f32, w: f32) {
    if (cur_level < 0) return;
    e: int = lay_term(lv_goal[cur_level], if_big(done_big), w - 40.0, SLOT_GOAL);
    if (e < 0) return;
    pad: f32 = 24.0;
    if (done_big) pad = 30.0;
    want: f32 = ex_h[e] + pad;
    if (an_jump || done_h <= 0.0) done_h = goal_rh;
    done_h = ease_to(done_h, want, 12.0);
    if (absf(done_h - want) > 0.5) busy = true;
    y: f32 = goal_ry + goal_rh - done_h;
    done_card_y = y;
    p_shadow(x, y, w, done_h, 20.0, 4.0, 14.0, 0.16);
    p_box(x, y, w, done_h, 20.0, C_CARD, 1.0);
    p_outline(x, y, w, done_h, 20.0, 2.0, mix_rgb(C_LINE, C_MUTED, 0.3), 1.0);
    draw_board = true;
    draw_expr(e, x + 20.0, y + (done_h - ex_h[e]) * 0.5, C_INK, 1.0, false);
    draw_board = false;
    // (Its label: what it now is.)
    a: f32 = clampf((now_t - done_t) / 0.3, 0.0, 1.0);
    if (a < 1.0) busy = true;
    p_str(1, 14.0, x + 6.0, y - 10.0, "Proved.", C_MUTED, a);
    tool: bool = level_is_tool(cur_level) && !watching && watch_done_t < 0.0;
    if (tool) p_str(0, 13.0, x + 12.0 + p_str_w(1, 14.0, "Proved."), y - 10.0, "Later levels can use it.",
        C_FAINT, a)
}

// Under the card: Read the proof, and Next.
draw_done(x: f32, w: f32) {
    t: f32 = now_t - done_t;
    if (t < 0.0 || watching || watch_done_t >= 0.0) return;
    a: f32 = clampf((t - 0.3) / 0.3, 0.0, 1.0);
    if (a < 1.0) busy = true;
    if (a <= 0.0) return;
    nw: f32 = plain_next_w("Next");
    ny: f32 = minf(done_card_y + done_h + 22.0, view_h() - safe_bottom - 56.0);
    plain_next(x + w - nw, ny, "Next", a);
    add_button(B_NEXT, x + w - nw, ny, x + w, ny + 44.0);
    lw: f32 = p_str_w(0, 15.0, "Read the proof");
    p_str(0, 15.0, x + 6.0, ny + 27.0, "Read the proof", C_MUTED, a);
    p_line(x + 6.0, ny + 31.0, x + 6.0 + lw, ny + 31.0, 1.0, C_FAINT, a);
    add_button(B_PROOF, x - 4.0, ny, x + 16.0 + lw, ny + 44.0)
}

// How wide a plain pill is with these words.
plain_next_w(s: str): f32 {
    p_str_w(1, 17.0, s) + 58.0
}

// A plain pill with words and an arrow (Next, Begin), its top left (x, y).
plain_next(
    x: f32,
    y: f32,
    s: str,
    a: f32
) {
    w: f32 = plain_next_w(s);
    h: f32 = 44.0;
    dy: f32 = pressed(B_NEXT) * 1.5;
    p_shadow(x, y, w, h, h * 0.5, 2.0, 6.0, 0.1 * a);
    p_box(x, y + dy, w, h, h * 0.5, C_CARD, a);
    p_outline(x, y + dy, w, h, h * 0.5, 1.5, C_LINE, a);
    p_str(1, 17.0, x + 22.0, y + dy + 28.0, s, C_INK, a);
    draw_icon(I_NEXT, x + w - 24.0, y + dy + 22.0, 6.0, C_MUTED, a)
}

// ---- the proof, written out ----
draw_proof_page() {
    x: f32 = col_x();
    w: f32 = col_w();
    hy: f32 = safe_top + 34.0;
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    p_str(1, 18.0, x + 56.0, hy + 6.0, "The proof", C_INK, 1.0);
    top: f32 = hy + 34.0;
    p_clip(0.0, top, view_w(), view_h());
    y: f32 = top + 10.0 - sc_pos[V_PROOF];
    // (What was shown, then how.)
    if (cur_level >= 0) {
        p_str(1, 13.0, x + 6.0, y + 14.0, "THEOREM", C_MUTED, 1.0);
        y = y + 22.0;
        e: int = lay_term(lv_goal[cur_level], 20.0, w - 36.0, 7000000);
        eh: f32 = ex_h[e] + 20.0;
        p_box(x, y, w, eh, 18.0, C_CARD, 1.0);
        p_outline(x, y, w, eh, 18.0, 1.5, C_LINE, 1.0);
        draw_expr(e, x + 18.0, y + 10.0, C_INK, 1.0, false);
        y = y + eh + 22.0
    }
    p_str(1, 13.0, x + 6.0, y, "PROOF", C_MUTED, 1.0);
    y = y + 26.0;
    for i in 0..pr_n {
        ind: f32 = pr_indent[i] as f32 * 22.0;
        if (pr_calc[i]) {
            p_sym(0, 17.0, x + 18.0 + ind, y, pr_text[i], C_BLUE, 1.0);
            y = y + 26.0
        } else {
            th: f32 = draw_wrapped(0, 17.0, x + 6.0 + ind, y, w - 12.0 - ind, pr_text[i],
                C_INK, 1.0);
            y = y + th + 6.0
        }
    }
    sc_most[V_PROOF] = y + 40.0 + sc_pos[V_PROOF] - view_h();
    p_noclip()
}

// ---- the region's rules ----
// What may be used here: the rulebook (assumed of whatever the region is
// about), its definitions, and the lemmas proved so far, each with its
// words and its statement.
draw_rules_page() {
    x: f32 = col_x();
    w: f32 = col_w();
    hy: f32 = safe_top + 34.0;
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    line_clear();
    line_add("The Book of ");
    if (region_title != 0) line_sym(region_title);
    pen_end = p_line_text(1, 18.0, x + 56.0, hy + 6.0, C_INK, 1.0);
    top: f32 = hy + 34.0;
    p_clip(0.0, top, view_w(), view_h());
    y: f32 = top + 10.0 - sc_pos[V_PROOF];
    y = y + draw_wrapped(0, 15.0, x + 6.0, y + 6.0, w - 12.0, sym("The rulebook is all you are given: everything proved holds for whatever obeys it. Each theorem you prove joins it as a new move."),
        C_MUTED, 1.0) + 10.0;
    // (The language first where it is being learned; elsewhere after the
    // rules.)
    if (lang_first()) y = draw_words_section(x, y, w);
    for pass in 0..3 {
        heading: str = "RULEBOOK";
        if (pass == 1) heading = "DEFINITIONS";
        if (pass == 2) heading = "PROVED";
        shown: bool = false;
        for l in 0..lm_n {
            k: int = lm_kind[l];
            want: bool = pass == 0 && k == LM_ASSUME || pass == 1 && k == LM_DEF || pass == 2 && k == LM_LEVEL && lm_level[l] >= 0 && level_proved_here(lm_level[l]);
            if (want && !lm_hidden[l]) {
                if (!shown) {
                    pen_end = p_str(1, 13.0, x + 6.0, y + 14.0, heading, C_MUTED,
                        1.0);
                    y = y + 24.0;
                    shown = true
                }
                e: int = lay_term(thm_prop(lm_thm[l]), 17.0, w - 32.0, 8000000 + l);
                name: int = lm_words[l];
                if (name == 0) name = lm_name[l];
                eh: f32 = ex_h[e] + 38.0;
                // (A theorem proved: where it is used.)
                proved: bool = pass == 2;
                used_h: f32 = 0.0;
                if (proved) {
                    line_clear();
                    used_line(lm_level[l]);
                    if (line_n > 0) used_h = 24.0
                }
                p_shadow(x, y, w, eh + used_h, 16.0, 2.0, 8.0, 0.08);
                p_box(x, y, w, eh + used_h, 16.0, C_CARD, 1.0);
                nc: int = C_PICK;
                if (proved) nc = C_MUTED;
                p_sym(1, 14.0, x + 16.0, y + 22.0, name, nc, 1.0);
                draw_expr(e, x + 16.0, y + 30.0, C_INK, 1.0, false);
                if (used_h > 0.0) {
                    line_clear();
                    used_line(lm_level[l]);
                    p_line_text(0, 13.0, x + 16.0, y + eh + 10.0, C_MUTED, 1.0)
                }
                y = y + eh + used_h + 8.0
            }
        }
        if (shown) y = y + 10.0
    }
    if (!lang_first()) y = draw_words_section(x, y, w);
    // (Still to prove: each a faint card, its title and statement.)
    first: bool = true;
    for l in 0..lv_n {
        if (!lv_given[l] && !level_proved_here(l)) {
            if (first) {
                p_str(1, 13.0, x + 6.0, y + 14.0, "STILL TO PROVE", C_MUTED, 1.0);
                y = y + 24.0;
                first = false
            }
            e: int = lay_term(lv_goal[l], 15.0, w - 32.0, 8500000 + l);
            eh: f32 = ex_h[e] + 34.0;
            p_box(x, y, w, eh, 16.0, mix_rgb(C_SUNK, C_BG, 0.4), 1.0);
            p_outline(x, y, w, eh, 16.0, 1.5, C_LINE, 1.0);
            if (lv_title[l] != 0) p_sym(1, 13.0, x + 16.0, y + 20.0, lv_title[l],
                C_FAINT, 1.0);
            draw_expr(e, x + 16.0, y + 27.0, C_MUTED, 0.8, false);
            y = y + eh + 8.0
        }
    }
    sc_most[V_PROOF] = y + 40.0 + sc_pos[V_PROOF] - view_h();
    p_noclip()
}

word_h: []f32 = new f32[8](200.0);

// The words of the language learned so far, each a page with its gestures
// playing, from y; where it ends.
draw_words_section(x: f32, y0: f32, w: f32): f32 {
    y: f32 = y0;
    shown: bool = false;
    // (The chapter's own words first, then the rest.)
    for i in 0..2 * WORDS {
        k: int = i % WORDS;
        if (word_known(k) && word_here(k) == i < WORDS) {
            if (!shown) {
                pen_end = p_str(1, 13.0, x + 6.0, y + 14.0, "THE LANGUAGE", C_MUTED,
                    1.0);
                y = y + 24.0;
                shown = true
            }
            // (Its card as tall as it was last drawn.)
            p_shadow(x, y, w, word_h[k], 16.0, 2.0, 8.0, 0.08);
            p_box(x, y, w, word_h[k], 16.0, C_CARD, 1.0);
            word_h[k] = draw_word_page(k, x, y, w);
            y = y + word_h[k] + 8.0
        }
    }
    if (shown) y = y + 10.0;
    y
}

// "Used in A, B" for level l's theorem (the later levels that may use
// it), added to the line; nothing if none.
used_line(l: int) {
    first: bool = true;
    for u in 0..lv_n {
        if (u != l && !lv_given[u] && level_uses(u, l)) {
            if (first) line_add("Used in ") else line_add(", ");
            first = false;
            if (lv_title[u] != 0) line_sym(lv_title[u]) else line_sym(lv_name[u])
        }
    }
}

// Whether level l (its number in the region's file) was proved by the
// player (not only by its written proof, which every level's is).
level_proved_here(l: int): bool {
    for m in 0..ml_n {
        if (ml_index[m] == l && region_of(m) == loaded_region && ml_solved[m]) return true
    }
    false
}
