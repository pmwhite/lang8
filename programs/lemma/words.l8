tag lemma_ui;

use_tag std, skate, lemma;

// The words of the language: one for each symbol a player learns (and the
// gestures that are not symbols: the kit, Suppose not). The level that
// brings a word in says so (`word:` in its file): the first time it is
// played, "New word" pops with the symbol, and the Book gains the word's
// page: the symbol on the goal and on a fact, each with its gesture played
// over and over by a little finger, so a player who forgets the language
// has somewhere to look it up.
const WORDS: int = 8;

// The word's name in the files and the progress file (seen word_NAME).
word_name(k: int): str {
    if (k == 0) return "and";
    if (k == 1) return "if";
    if (k == 2) return "all";
    if (k == 3) return "ex";
    if (k == 4) return "eq";
    if (k == 5) return "def";
    if (k == 6) return "kit";
    "not"
}

word_seen_name(k: int): int {
    line_clear();
    line_add("word_");
    line_add(word_name(k));
    line_sym_now()
}

word_title(k: int): str {
    if (k == 0) return "And";
    if (k == 1) return "If";
    if (k == 2) return "Every";
    if (k == 3) return "Some";
    if (k == 4) return "Equals";
    if (k == 5) return "Tends to";
    if (k == 6) return "The kit";
    "Suppose not"
}

// Its symbol (a code point).
word_cp(k: int): int {
    if (k == 0) return 8743;
    if (k == 1) return 10230;
    if (k == 2) return 8704;
    if (k == 3) return 8707;
    if (k == 4) return 61;
    if (k == 5) return 8594;
    if (k == 6) return 9633;
    172
}

// What it says, in a line.
word_line(k: int): str {
    if (k == 0) return "Its key splits it in two, on the goal or a fact.";
    if (k == 1) return "On the goal its key lifts what is supposed into the facts. A fact if-then is dragged onto the goal.";
    if (k == 2) return "On the goal its key gives a name for any one (orange). On a fact it is a notch: drop a name in.";
    if (k == 3) return "On the goal it is a notch: drop the one you choose in. On a fact its key gives a particular one (blue).";
    if (k == 4) return "Grab a face of an equation; drop it on a part like it. Swipe the goal to flip it.";
    if (k == 5) return "The arrow is a key: it opens to what it means.";
    if (k == 6) return "Drop names onto a kit tile to build a new one.";
    "Drag the goal up into the facts: suppose it is not so, and show that cannot be."
}

// The word level l brings in (its index), or -1.
level_word(l: int): int {
    if (l < 0 || lv_word[l] == 0) return -1;
    for k in 0..WORDS {
        if (lv_word[l] == sym(word_name(k))) return k
    }
    -1
}

// Known: seen, or brought in by a level solved (or one before it in its
// chapter), so progress from before the words were kept still has them.
word_known(k: int): bool {
    if (demo_seen(word_seen_name(k))) return true;
    w: int = sym(word_name(k));
    for m in 0..ml_n {
        if (ml_word[m] == w) {
            r: int = region_of(m);
            for m2 in m..rg_lv0[r] + rg_lvn[r] {
                if (ml_solved[m2]) return true
            }
        }
    }
    false
}

// Whether the region loaded brings word k in.
word_here(k: int): bool {
    w: int = sym(word_name(k));
    for l in 0..lv_n {
        if (lv_word[l] == w) return true
    }
    false
}

// ---- New word: the pop ----
nw_word: int = -1;

nw_t0: f32 = -10.0;

const NW_TIME: f32 = 2.6;

// The level begun: if it brings a word in not seen yet, it pops (and is
// in the Book from now on).
word_begin() {
    nw_word = -1;
    if (cur_level < 0 || watching) return;
    k: int = level_word(cur_level);
    if (k < 0 || word_known(k)) return;
    nw_word = k;
    nw_t0 = intro_t0 + 1.4;
    s: int = word_seen_name(k);
    if (seen_n < len(seen_demo)) {
        seen_demo[seen_n] = s;
        seen_n = seen_n + 1
    }
    wants_save = true
}

// Drawn over the board: a pill under the bar, the symbol on a keycap.
draw_new_word(x: f32, w: f32) {
    if (nw_word < 0 || intro_open || chapter_open) return;
    t: f32 = now_t - nw_t0;
    if (t < 0.0) {
        busy = true;
        return
    }
    if (t > NW_TIME) return;
    busy = true;
    // (Pops in, a little past its size and back; fades away whole, rising a
    // little, so it never shows empty.)
    k: f32 = clampf(t / 0.25, 0.0, 1.0);
    s: f32 = k * (1.0 + 0.15 * sinf(k * 3.1416));
    a: f32 = clampf(s * 2.0, 0.0, 1.0);
    rise: f32 = 0.0;
    if (t > NW_TIME - 0.4) {
        q: f32 = (NW_TIME - t) / 0.4;
        a = q * q;
        rise = (1.0 - q) * 10.0
    }
    line_clear();
    line_cp(word_cp(nw_word));
    g: int = line_sym_now();
    tw: f32 = p_str_w(1, 15.0, "New word") + p_str_w(1, 15.0, word_title(nw_word)) + 100.0;
    th: f32 = 54.0;
    cx: f32 = x + w * 0.5;
    // (Low in the picture, over the demo's words.)
    cy: f32 = bar_bottom_y + 120.0;
    if (pic_bottom_y > 0.0) cy = maxf(pic_bottom_y - 96.0, bar_bottom_y + 120.0);
    cy = cy - rise;
    bw: f32 = tw * s;
    bh: f32 = th * s;
    p_shadow(cx - bw * 0.5, cy - bh * 0.5, bw, bh, bh * 0.5, 4.0, 14.0, 0.22 * a);
    p_box(cx - bw * 0.5, cy - bh * 0.5, bw, bh, bh * 0.5, C_INK, 0.92 * a);
    if (s < 0.6) return;
    x0: f32 = cx - tw * 0.5;
    kc: int = mix_rgb(C_PICK_SOFT, C_PICK, 0.35);
    if (a >= 0.99) draw_keycap(x0 + 10.0, cy - 19.0, x0 + 48.0, cy + 17.0, kc, 0.0,
        false) else p_box(x0 + 10.0, cy - 19.0, 38.0, 36.0, 11.0, kc, a);
    gw: f32 = p_sym_w(0, 24.0, g);
    p_sym(0, 24.0, x0 + 29.0 - gw * 0.5, cy + 8.0, g, C_INK, a);
    p_str(1, 15.0, x0 + 60.0, cy + 6.0, "New word", mix_rgb(C_WHITE, C_INK, 0.35),
        a);
    p_str(1, 15.0, x0 + 66.0 + p_str_w(1, 15.0, "New word"), cy + 6.0, word_title(nw_word),
        C_WHITE, a)
}

// ---- the Book's pages: each word, its gestures looping ----
// Writing made from a little markup (string literals are ASCII): %A for
// all, %E there is, %& and, %> if-then, %r tends to, %e epsilon, %n not
// equal, %b a hole, %. times, %f false, %g at least.
wsym(s: str): int {
    line_clear();
    esc: bool = false;
    for c in s {
        ch: int = c as int;
        if (esc) {
            esc = false;
            if (ch == 65) line_cp(8704) else if (ch == 69) line_cp(8707) else if (ch == 38) line_cp(8743) else if (ch == 62) line_cp(10230) else if (ch == 114) line_cp(8594) else if (ch == 101) line_cp(949) else if (ch == 110) line_cp(8800) else if (ch == 98) line_cp(9633) else if (ch == 46) line_cp(183) else if (ch == 102) line_cp(8869) else if (ch == 103) line_cp(8805) else line_byte(ch)
        } else if (ch == 37) esc = true else line_byte(ch)
    }
    line_sym_now()
}

const WS: f32 = 20.0;

// A small card at (x, y), w wide, with writing s; a fact (blue) or the goal.
mini_card(
    x: f32,
    y: f32,
    w: f32,
    fact: bool,
    s: str,
    a: f32
) {
    if (a <= 0.01) return;
    h: f32 = 40.0;
    fill: int = C_CARD;
    if (fact) fill = C_BLUE_SOFT;
    p_shadow(x, y, w, h, 14.0, 2.0, 6.0, 0.1 * a);
    p_box(x, y, w, h, 14.0, fill, a);
    if (!fact) p_outline(x, y, w, h, 14.0, 2.0, mix_rgb(C_LINE, C_MUTED, 0.45), a);
    p_sym(0, WS, x + 14.0, y + 27.0, wsym(s), C_INK, a)
}

// One with a key on part `mid` of its writing pre mid post (pressed k).
mini_key_card(
    x: f32,
    y: f32,
    w: f32,
    fact: bool,
    pre: str,
    mid: str,
    post: str,
    k: f32,
    a: f32
) {
    if (a <= 0.01) return;
    h: f32 = 40.0;
    fill: int = C_CARD;
    if (fact) fill = C_BLUE_SOFT;
    p_shadow(x, y, w, h, 14.0, 2.0, 6.0, 0.1 * a);
    p_box(x, y, w, h, 14.0, fill, a);
    if (!fact) p_outline(x, y, w, h, 14.0, 2.0, mix_rgb(C_LINE, C_MUTED, 0.45), a);
    s0: int = wsym(pre);
    s1: int = wsym(mid);
    s2: int = wsym(post);
    w0: f32 = p_sym_w(0, WS, s0);
    w1: f32 = p_sym_w(0, WS, s1);
    kx: f32 = x + 14.0 + w0;
    col: int = mix_rgb(C_PICK_SOFT, C_PICK, 0.35);
    if (fact) col = mix_rgb(C_BLUE_SOFT, C_BLUE, 0.3);
    if (a > 0.6) draw_keycap(kx - 3.0, y + 5.0, kx + w1 + 3.0, y + 33.0, col, k, false);
    p_sym(0, WS, x + 14.0, y + 27.0, s0, C_INK, a);
    p_sym(0, WS, kx, y + 27.0 + 3.0 * k, s1, C_INK, a);
    p_sym(0, WS, kx + w1, y + 27.0, s2, C_INK, a)
}

// One with a notch for a name between pre and post; where the notch's
// middle is (mn_x, mn_y).
mn_x: f32 = 0.0;

mn_y: f32 = 0.0;

mini_notch_card(
    x: f32,
    y: f32,
    w: f32,
    fact: bool,
    pre: str,
    name: str,
    post: str,
    lit: bool,
    a: f32
) {
    if (a <= 0.01) return;
    h: f32 = 40.0;
    fill: int = C_CARD;
    if (fact) fill = C_BLUE_SOFT;
    p_shadow(x, y, w, h, 14.0, 2.0, 6.0, 0.1 * a);
    p_box(x, y, w, h, 14.0, fill, a);
    if (!fact) p_outline(x, y, w, h, 14.0, 2.0, mix_rgb(C_LINE, C_MUTED, 0.45), a);
    s0: int = wsym(pre);
    w0: f32 = p_sym_w(0, WS, s0);
    p_sym(0, WS, x + 14.0, y + 27.0, s0, C_INK, a);
    nx: f32 = x + 14.0 + w0 + 4.0;
    mn_x = nx + 15.0;
    mn_y = y + 20.0;
    if (a > 0.6) draw_notch(nx, y + 5.0, nx + 30.0, y + 35.0, wsym(name), 16.0, lit);
    p_sym(0, WS, nx + 34.0, y + 27.0, wsym(post), C_INK, a)
}

// The little finger at (x, y), pressing or not.
mini_finger(
    x: f32,
    y: f32,
    a: f32,
    down: bool
) {
    if (a <= 0.01) return;
    r: f32 = 12.0;
    if (down) r = 10.5;
    p_shadow(x - r, y - r + 3.0, 2.0 * r, 2.0 * r, r, 2.0, 8.0, 0.2 * a);
    p_disc(x, y, r, C_WHITE, 0.75 * a);
    p_ring(x, y, r, 2.0, C_INK, 0.4 * a);
    if (down) p_ring(x, y, r + 5.0, 1.5, C_WHITE, 0.5 * a)
}

// A name as a small ball.
mini_token(
    s: str,
    kind: int,
    x: f32,
    y: f32,
    sc: f32,
    a: f32
) {
    if (a <= 0.01 || sc <= 0.01) return;
    t: int = wsym(s);
    r: f32 = 16.0 * sc;
    fill: int = C_CARD;
    ring: int = mix_rgb(C_LINE, C_MUTED, 0.4);
    ink: int = C_INK;
    if (kind == 1) {
        fill = C_WHITE;
        ring = C_PICK;
        ink = mix_rgb(C_PICK, C_INK, 0.35)
    }
    if (kind == 2) {
        fill = C_BLUE;
        ring = mix_rgb(C_BLUE, C_SHADOW, 0.25);
        ink = C_WHITE
    }
    if (kind == 3) {
        fill = C_GOLD_SOFT;
        ring = C_GOLD
    }
    fs: f32 = 15.0 * sc;
    nw: f32 = p_sym_w(0, fs, t);
    hw: f32 = maxf(r, nw * 0.5 + r * 0.55);
    p_shadow(x - hw, y - r, 2.0 * hw, 2.0 * r, r, 2.0, 5.0, 0.18 * a);
    p_box(x - hw, y - r, 2.0 * hw, 2.0 * r, r, fill, a);
    p_outline(x - hw, y - r, 2.0 * hw, 2.0 * r, r, 2.2 * sc, ring, a);
    p_sym(0, fs, x - nw * 0.5, y + fs * 0.34, t, ink, a)
}

// A panel's loop: where in it (0..1 of PANEL_T) it is now, the panels
// out of step with each other.
const PANEL_T: f32 = 3.6;

// The phases: before (still), the finger's gesture (0.17..0.45), the
// change (0.45..0.55), after (to 0.85), back (to 1).
panel_u(i: int): f32 {
    t: f32 = now_t + i as f32 * 0.9;
    t / PANEL_T - floorf(t / PANEL_T)
}

smooth(u: f32, a: f32, b: f32): f32 {
    k: f32 = clampf((u - a) / (b - a), 0.0, 1.0);
    k * k * (3.0 - 2.0 * k)
}

// Word k's page in the Book at (x, y), w wide: its title and symbol, its
// line, and its panels (the goal's gesture, a fact's). Its height.
draw_word_page(
    k: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    busy = true;
    top: f32 = y;
    line_clear();
    line_cp(word_cp(k));
    g: int = line_sym_now();
    draw_keycap(x + 14.0, y + 12.0, x + 52.0, y + 48.0, mix_rgb(C_PICK_SOFT, C_PICK,
        0.35), 0.0, false);
    gw: f32 = p_sym_w(0, 24.0, g);
    p_sym(0, 24.0, x + 33.0 - gw * 0.5, y + 38.0, g, C_INK, 1.0);
    pen_end = p_str(1, 17.0, x + 64.0, y + 36.0, word_title(k), C_INK, 1.0);
    y = y + 56.0;
    y = y + draw_wrapped(0, 14.0, x + 16.0, y + 8.0, w - 32.0, sym(word_line(k)),
        C_MUTED, 1.0) + 14.0;
    pw: f32 = w - 32.0;
    px: f32 = x + 16.0;
    for side in 0..2 {
        h: f32 = word_panel(k, side, px, y, pw, panel_u(k * 2 + side));
        if (h > 0.0) y = y + h + 12.0
    }
    y + 6.0 - top
}

// Panel `side` of word k at (x, y), w wide, u through its loop; its height
// (0 if the word has no such panel).
word_panel(
    k: int,
    side: int,
    x: f32,
    y: f32,
    w: f32,
    u: f32
): f32 {
    lab: str = "ON THE GOAL";
    if (side == 1) lab = "ON A FACT";
    if (k == 4 && side == 1) lab = "SWIPE THE GOAL";
    if (k >= 5 && side == 1) return 0.0;
    if (k == 6) lab = "A NAME ONTO A KIT TILE";
    if (k == 7) lab = "THE GOAL UP INTO THE FACTS";
    pen_end = p_str(1, 11.0, x, y + 12.0, lab, C_MUTED, 1.0);
    y = y + 20.0;
    cw: f32 = minf(w, 300.0);
    // (In, the change, out.)
    // (The old writing gone before the new comes, and back the same way.)
    ch: f32 = smooth(u, 0.5, 0.56) * (1.0 - smooth(u, 0.86, 0.92));
    b: f32 = 1.0 - smooth(u, 0.44, 0.5) + smooth(u, 0.92, 0.98);
    fa: f32 = smooth(u, 0.08, 0.17) * (1.0 - smooth(u, 0.47, 0.55));
    press: bool = u > 0.3 && u < 0.45;
    pk: f32 = 0.0;
    if (press) pk = 1.0;
    if (k == 0) {
        fact: bool = side == 1;
        mini_key_card(x, y, cw, fact, "P", " %& ", "Q", pk, b);
        kx: f32 = x + 14.0 + p_sym_w(0, WS, wsym("P")) + p_sym_w(0, WS, wsym(" %& ")) * 0.5;
        mini_finger(kx + 8.0, y + 32.0, fa, press);
        if (fact) {
            mini_card(x, y - 22.0 * ch + 22.0, cw, true, "P", ch);
            mini_card(x, y + 22.0 + 22.0 * ch, cw, true, "Q", ch);
            return 112.0
        }
        hw: f32 = (cw - 10.0) * 0.5;
        mini_card(x, y, hw, false, "P", ch);
        mini_card(x + (hw + 10.0) * ch + (1.0 - ch) * hw * 0.5, y, hw, false, "Q",
            ch);
        return 62.0
    }
    if (k == 1 && side == 0) {
        mini_key_card(x, y + 46.0, cw, false, "P", " %> ", "Q", pk, b);
        kx: f32 = x + 14.0 + p_sym_w(0, WS, wsym("P")) + p_sym_w(0, WS, wsym(" %> ")) * 0.5;
        mini_finger(kx + 8.0, y + 78.0, fa, press);
        mini_card(x, y + 46.0 - 46.0 * ch, cw, true, "P", ch);
        mini_card(x, y + 46.0, cw, false, "Q", ch);
        return 106.0
    }
    if (k == 1) {
        // (The fact carried onto the goal: the goal becomes what it needs.)
        m: f32 = smooth(u, 0.17, 0.45);
        fy: f32 = y + 46.0 * m;
        if (u < 0.55) mini_card(x + 10.0 * m, fy, cw - 20.0 * m, true, "P %> Q", 1.0 - smooth(u,
            0.45, 0.52));
        if (u >= 0.55) mini_card(x, y, cw, true, "P %> Q", 0.35 + 0.65 * (1.0 - ch));
        mini_card(x, y + 46.0, cw, false, "Q", b);
        mini_card(x, y + 46.0, cw, false, "P", ch);
        mini_finger(x + 60.0 + 10.0 * m, fy + 26.0, fa, u > 0.17 && u < 0.45);
        return 106.0
    }
    if (k == 2 && side == 0) {
        mini_key_card(x, y, cw, false, "", "%Ay.", " P(y)", pk, b);
        mini_finger(x + 36.0, y + 32.0, fa, press);
        mini_card(x, y, cw, false, "P(y)", ch);
        // (y out of the key, onto the shelf.)
        q: f32 = smooth(u, 0.45, 0.6);
        mini_token("y", 1, x + 30.0 + 10.0 * q, y + 20.0 + 42.0 * q - sinf(q * 3.1416) * 30.0,
            0.6 + 0.4 * q, ch);
        return 86.0
    }
    if (k == 2 || k == 3 && side == 0) {
        // (A name carried into the notch.)
        fact: bool = k == 2;
        pre: str = "%E";
        if (fact) pre = "%A";
        m: f32 = smooth(u, 0.17, 0.45);
        mini_notch_card(x, y, cw, fact, pre, "x", ". P(x)", m > 0.8 && u < 0.5, b + if_f(fact) * ch);
        sx: f32 = x + 26.0;
        sy: f32 = y + 66.0;
        tx: f32 = sx + (mn_x - sx) * m;
        ty: f32 = sy + (mn_y - sy) * m - sinf(m * 3.1416) * 18.0;
        mini_token("a", 0, sx, sy, 1.0, 0.3 + 0.7 * (1.0 - fa));
        if (u > 0.12 && u < 0.5) mini_token("a", 0, tx, ty - 10.0 * m, 1.0, 1.0);
        mini_finger(tx + 6.0, ty + 12.0, fa, u > 0.17 && u < 0.45);
        if (fact) {
            // (A new fact under it; the general one stays.)
            mini_card(x + 10.0, y + 46.0 * ch, cw - 20.0, true, "P(a)", ch);
            return 112.0
        }
        mini_card(x, y, cw, false, "P(a)", ch);
        return 90.0
    }
    if (k == 3) {
        mini_key_card(x, y, cw, true, "", "%Ex.", " P(x)", pk, b);
        mini_finger(x + 36.0, y + 32.0, fa, press);
        mini_card(x, y, cw, true, "P(x)", ch);
        q: f32 = smooth(u, 0.45, 0.6);
        mini_token("x", 2, x + 30.0 + 10.0 * q, y + 20.0 + 42.0 * q - sinf(q * 3.1416) * 30.0,
            0.6 + 0.4 * q, ch);
        return 86.0
    }
    if (k == 4 && side == 0) {
        // (The face b of e . b = b, put onto b.)
        tw: f32 = p_sym_w(0, 16.0, wsym("e %. %b = %b")) + 24.0;
        p_box(x, y, tw, 34.0, 12.0, C_CARD, 1.0);
        p_outline(x, y, tw, 34.0, 12.0, 1.5, mix_rgb(C_LINE, C_MUTED, 0.35), 1.0);
        p_sym(0, 16.0, x + 12.0, y + 23.0, wsym("e %. %b = %b"), C_INK, 1.0);
        gy: f32 = y + 46.0;
        mini_card(x, gy, cw, false, "b = c", b);
        mini_card(x, gy, cw, false, "e %. b = c", ch);
        m: f32 = smooth(u, 0.17, 0.45);
        sx: f32 = x + tw - 20.0;
        sy: f32 = y + 17.0;
        tx: f32 = sx + (x + 20.0 - sx) * m;
        ty: f32 = sy + (gy + 20.0 - sy) * m;
        if (u > 0.12 && u < 0.5) {
            p_box(tx - 14.0, ty - 22.0, 28.0, 28.0, 10.0, C_CARD, 1.0);
            p_outline(tx - 14.0, ty - 22.0, 28.0, 28.0, 10.0, 1.5, C_PICK, 1.0);
            p_sym(0, 16.0, tx - 6.0, ty - 3.0, wsym("%b"), C_INK, 1.0)
        }
        mini_finger(tx + 6.0, ty + 10.0, fa, u > 0.17 && u < 0.45);
        return 106.0
    }
    if (k == 4) {
        m: f32 = smooth(u, 0.17, 0.45);
        dx: f32 = sinf(m * 3.1416) * 40.0;
        mini_card(x + dx, y, cw, false, "a = b", b);
        mini_card(x + dx, y, cw, false, "b = a", ch);
        mini_finger(x + 60.0 + 100.0 * m, y + 26.0, fa, u > 0.17 && u < 0.45);
        return 62.0
    }
    if (k == 5) {
        mini_key_card(x, y, cw, false, "a", " %r ", "A", pk, b);
        kx: f32 = x + 14.0 + p_sym_w(0, WS, wsym("a")) + p_sym_w(0, WS, wsym(" %r ")) * 0.5;
        mini_finger(kx + 8.0, y + 32.0, fa, press);
        mini_card(x, y, cw, false, "%A%e>0. %EN. %An%gN. ...", ch);
        return 62.0
    }
    if (k == 6) {
        tw: f32 = p_sym_w(0, 16.0, wsym("%b / 2")) + 24.0;
        p_box(x + 60.0, y, tw, 34.0, 12.0, mix_rgb(C_GOLD_SOFT, C_CARD, 0.3), 1.0);
        p_outline(x + 60.0, y, tw, 34.0, 12.0, 1.5, mix_rgb(C_LINE, C_MUTED, 0.35),
            1.0);
        p_sym(0, 16.0, x + 72.0, y + 23.0, wsym("%b / 2"), C_INK, 1.0);
        m: f32 = smooth(u, 0.17, 0.45);
        sx: f32 = x + 20.0;
        sy: f32 = y + 17.0;
        tx: f32 = sx + (x + 60.0 + tw * 0.4 - sx) * m;
        if (u < 0.5) mini_token("%e", 1, tx, sy - sinf(m * 3.1416) * 16.0, 1.0, 1.0) else mini_token("%e",
            1, sx, sy, 1.0, 1.0);
        mini_finger(tx + 6.0, sy + 12.0, fa, u > 0.17 && u < 0.45);
        q: f32 = smooth(u, 0.48, 0.62);
        mini_token("%e / 2", 3, x + 80.0 + tw + 20.0 * q, sy - sinf(q * 3.1416) * 18.0,
            0.5 + 0.5 * q, ch);
        return 50.0
    }
    // (Suppose not: the goal carried up into the facts.)
    m: f32 = smooth(u, 0.17, 0.45);
    gy: f32 = y + 46.0 - 46.0 * m;
    mini_card(x + 10.0 * m, gy, cw - 20.0 * m, false, "A = B", b);
    mini_card(x, y, cw, true, "A %n B", ch);
    mini_card(x, y + 46.0, cw, false, "False", ch);
    mini_finger(x + 60.0, gy + 26.0, fa, u > 0.17 && u < 0.45);
    106.0
}

if_f(b: bool): f32 {
    if (b) return 1.0;
    0.0
}
