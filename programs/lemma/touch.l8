tag lemma_ui;

use_tag std, skate, lemma;

// Fingers (or the mouse). The game follows one finger at a time. Moved far
// enough to tell, it scrolls the list under it, drags a handle of the
// picture, or (sideways, on a level's board) swipes the cursor along the
// focused statement; come up without having moved, it is a tap: on the
// button it came down on, or on the block of an expression under it. Held
// on the bulb, it plays the written proof.
const G_NONE: int = 0;

const G_WAIT: int = 1;

const G_SCROLL: int = 2;

const G_DRAG: int = 3;

const G_SWIPE: int = 4;

// When the finger came down (a hold is a long one).
g_t0: f32 = 0.0;

g_finger: int = -1;

g_mode: int = 0;

g_view: int = 0;

g_x0: f32 = 0.0;

g_y0: f32 = 0.0;

g_x: f32 = 0.0;

g_y: f32 = 0.0;

g_dy: f32 = 0.0;

g_vy: f32 = 0.0;

g_last_t: f32 = 0.0;

slop(): f32 {
    if (touch_ui) return 9.0;
    4.0
}

// The list under a finger at y.
view_at(y: f32): int {
    if (page == PAGE_MAP) return V_MAP;
    if (page == PAGE_PROOF || page == PAGE_RULES) return V_PROOF;
    if (page == PAGE_LEVEL && y > hand_top_y) return V_TRAY;
    V_LEVEL
}

finger_down(b: int, x: f32, y: f32) {
    if (g_finger >= 0) return;
    // (A finger while the proof is being watched: the player takes over,
    // unless it is on the button that stops it.)
    if (watching && button_at(x, y) != B_WATCH) stop_watch();
    g_t0 = now_t;
    g_finger = b;
    g_mode = G_WAIT;
    g_x0 = x;
    g_y0 = y;
    g_x = x;
    g_y = y;
    g_vy = 0.0;
    g_view = view_at(y);
    gliding: bool = absf(sc_vel[g_view]) > 160.0;
    sc_vel[g_view] = 0.0;
    press_id = 0;
    if (page == PAGE_LEVEL && pic_grab(x, y)) {
        g_mode = G_DRAG;
        return
    }
    if (!gliding) {
        press_id = button_at(x, y);
        // (Blocks press as one: the expression shows its own picking.)
        if (press_id >= B_EXPR) press_id = 0;
        press_show = 0.0
    }
}

finger_move(state: int, x: f32, y: f32) {
    if (g_finger < 0 || (state & 1 << 7 + g_finger) == 0) return;
    dy: f32 = y - g_y;
    g_x = x;
    g_y = y;
    g_dy = g_dy + dy;
    g_last_t = now_t;
    if (g_mode == G_DRAG) {
        pic_drag(x, y);
        return
    }
    if (g_mode == G_SWIPE) return;
    if (g_mode == G_WAIT) {
        if (absf(x - g_x0) + absf(y - g_y0) < slop()) return;
        press_id = 0;
        // (Sideways on a level, above the hand: a swipe of the cursor.)
        if (page == PAGE_LEVEL && g_y0 < hand_top_y && absf(x - g_x0) > absf(y - g_y0) * 1.3) {
            g_mode = G_SWIPE;
            return
        }
        g_mode = G_SCROLL;
        sc_held[g_view] = true;
        return
    }
    if (g_mode == G_SCROLL) scroll_by(g_view, dy)
}

finger_up(b: int, x: f32, y: f32) raises KernelError {
    if (b != g_finger) return;
    g_finger = -1;
    mode: int = g_mode;
    g_mode = G_NONE;
    if (now_t - g_last_t > 0.08) g_vy = 0.0;
    if (mode == G_DRAG) {
        pic_drop();
        return
    }
    if (mode == G_SWIPE) {
        // (Right: on to the next part; left: back.)
        if (x - g_x0 > 30.0) cursor_step(1) else if (x - g_x0 < -30.0) cursor_step(-1);
        return
    }
    if (mode == G_WAIT) {
        press_id = 0;
        id: int = button_at(x, y);
        if (id >= B_EXPR) tap_expr(id - B_EXPR, x, y) else if (id != 0) act(id);
        return
    }
    if (mode == G_SCROLL) {
        sc_held[g_view] = false;
        sc_vel[g_view] = -g_vy
    }
}

// Once a frame: the finger's speed, from how far it went this frame.
step_fingers(dt: f32) raises KernelError {
    // (Held on the bulb: watch the written proof.)
    if (g_finger >= 0 && g_mode == G_WAIT && press_id == B_HINT && now_t - g_t0 > 0.55) {
        g_mode = G_NONE;
        press_id = 0;
        start_watch()
    }
    if (g_finger >= 0 && g_mode == G_WAIT) busy = true;
    if (dt > 0.0 && g_finger >= 0) g_vy = lerpf(g_vy, g_dy / dt, 0.5);
    g_dy = 0.0
}

// The wheel (or two fingers on a trackpad): scrolls the list under it.
wheel(amount: f32, y: f32) {
    v: int = view_at(y);
    sc_pos[v] = clampf(sc_pos[v] + amount, 0.0, maxf(sc_most[v], 0.0));
    sc_vel[v] = 0.0
}
