tag lemma_tests;

use_tag std, lemma;

// Levels played by script, the way a player would.
import "../../stdlib/print.l8";

import "text.l8";

import "kernel.l8";

import "syntax.l8";

import "read.l8";

import "show.l8";

import "theory.l8";

import "files.l8";

import "match.l8";

import "goal.l8";

import "moves.l8";

import "arith.l8";

import "play.l8";

load(path: str) noregion raises IoError {
    t: []i8 = read_whole(path);
    try {
        load_theory(t, whole_n)
    } with TheoryError -> {
        line_clear();
        line_add(path);
        line_add(" line ");
        line_int(theory_line);
        line_add(": ");
        line_add(theory_why);
        line_print()
    }
}

load_region(path: str) noregion raises IoError {
    if (lm_n == 0) {
        load("programs/lemma/hol.txt");
        close_axioms();
        mark_logic()
    }
    reset_to_logic();
    load(path)
}

level_named(name: str): int {
    for l in 0..lv_n {
        if (lv_name[l] == sym(name)) return l
    }
    -1
}

ok(b: bool) raises IoError {
    if (!b) print("(no such move)")
}

test "and, the other way round" {
    load_region("programs/lemma/regions/logic.txt");
    level_start(level_named("and_swap"));
    print_focus();
    cands_goal(focus());
    print_cands();
    ok(tap_goal("Split"));
    print_focus();
    cands_hyp(focus(), 0);
    print_cands();
    ok(tap_hyp(0, "Take the right part"));
    print_focus();
    ok(tap_hyp(0, "Take the left part"));
    print_focus();
    print_bool(level_done());
    expect {|
        P ∧ Q
        ⊢ Q ∧ P
        Split | Suppose not
        P ∧ Q
        ⊢ Q
        Take the left part | Take the right part
        P ∧ Q
        ⊢ P
        done
        true
    |}
}

print_theorem() raises IoError, KernelError {
    th: int = level_theorem();
    show_line(thm_prop(th));
    line_print();
    line_clear();
    line_add("hypotheses: ");
    line_int(thm_hyp_count(th));
    line_add(", oracle: ");
    if (thm_trusts_oracle(th)) line_add("yes") else line_add("no");
    line_add(", is the level's statement: ");
    if (thm_prop(th) == lv_goal[cur_level]) line_add("yes") else line_add("no");
    line_print()
}

test "a chain of ifs" {
    load_region("programs/lemma/regions/logic.txt");
    level_start(level_named("chain"));
    print_focus();
    ok(tap_goal("Assume it"));
    print_focus();
    cands_hyp(focus(), 1);
    print_cands();
    ok(tap_hyp(1, "Apply it"));
    print_focus();
    ok(tap_hyp(0, "Apply it"));
    print_focus();
    print_theorem();
    expect {|
        P ⟶ Q
        Q ⟶ R
        ⊢ P ⟶ R
        P ⟶ Q
        Q ⟶ R
        P
        ⊢ R
        Apply it
        P ⟶ Q
        Q ⟶ R
        P
        ⊢ Q
        done
        P ⟶ Q ⟹ Q ⟶ R ⟹ P ⟶ R
        hypotheses: 0, oracle: no, is the level's statement: yes
    |}
}

test "someone for everyone" {
    load_region("programs/lemma/regions/logic.txt");
    level_start(level_named("swap_quantifiers"));
    print_focus();
    cands_goal(focus());
    print_cands();
    ok(tap_goal("Take any y"));
    print_focus();
    cands_hyp(focus(), 0);
    print_cands();
    ok(tap_hyp(0, "Get x"));
    print_focus();
    cands_goal(focus());
    print_cands();
    ok(tap_goal_with("Choose \�\�\�", "x", ""));
    print_focus();
    ok(tap_hyp(1, "Use with y"));
    print_focus();
    print_theorem();
    expect {|
        ∃x. ∀y. R(x, y)
        ⊢ ∀y. ∃x. R(x, y)
        Take any y | Suppose not
        ∃x. ∀y. R(x, y)
        ⊢ ∃x. R(x, y)
        Get x
        ∃x. ∀y. R(x, y)
        ∀y. R(x, y)
        ⊢ ∃x. R(x, y)
        Choose … | Suppose not
        ∃x. ∀y. R(x, y)
        ∀y. R(x, y)
        ⊢ R(x, y)
        done
        (∃x. ∀y. R(x, y)) ⟹ (∀y. ∃x. R(x, y))
        hypotheses: 0, oracle: no, is the level's statement: yes
    |}
}
