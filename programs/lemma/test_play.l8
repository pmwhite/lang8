tag lemma_tests;

use_tag std, lemma;

// Levels played by script, the way a player would.
import "../../stdlib/print.l8";

import "lemma.l8";

load(path: str) noregion raises IoError {
    t: []i8 = read_whole(path);
    try {
        load_theory(t, whole_n)
    } with TheoryError -> {
        line_clear();
        line_add(path);
        line_add(" line ");
        line_int(theory_line);
        line_add(": ");
        line_add(theory_why);
        line_print()
    }
}

load_region(path: str) noregion raises IoError, KernelError {
    if (lm_n == 0) {
        load("programs/lemma/hol.txt");
        close_axioms();
        if (!prove_given()) report_proof();
        mark_logic()
    }
    reset_to_logic();
    load(path)
}

report_proof() raises IoError {
    line_clear();
    line_add("the proof of ");
    line_sym(lv_name[proof_level]);
    line_add(" fails at move ");
    line_int(proof_step);
    line_add(": ");
    line_add(proof_why);
    line_print()
}

level_named(name: str): int {
    for l in 0..lv_n {
        if (lv_name[l] == sym(name)) return l
    }
    -1
}

ok(b: bool) raises IoError {
    if (!b) print("(no such move)")
}

test "the logic's derived rules are proved by their moves" {
    load_region("programs/lemma/regions/logic.txt");
    for l in 0..lm_n {
        if (lm_kind[l] == LM_GIVEN) {
            show_line(thm_prop(lm_thm[l]));
            line_print()
        }
    }
    expect {|
        s = t ⟹ t = s
        (∀x. P(x) ⟶ Q(x)) ⟹ P(x) ⟹ Q(x)
        P ∧ Q ⟹ (P ⟹ Q ⟹ R) ⟹ R
        (⋀x. P(x) ⟹ Q(x)) ⟹ (∀x. P(x) ⟶ Q(x))
    |}
}

test "and, the other way round" {
    load_region("programs/lemma/regions/logic.txt");
    level_start(level_named("and_swap"));
    print_focus();
    cands_goal(focus());
    print_cands();
    ok(tap_goal("Split"));
    print_focus();
    cands_hyp(focus(), 0);
    print_cands();
    ok(tap_hyp(0, "Take the right part"));
    print_focus();
    ok(tap_hyp(0, "Take the left part"));
    print_focus();
    print_bool(level_done());
    expect {|
        P ∧ Q
        ⊢ Q ∧ P
        Split | Suppose not
        P ∧ Q
        ⊢ Q
        Take both parts | Take the right part | Take the left part
        P ∧ Q
        ⊢ P
        done
        true
    |}
}

print_theorem() raises IoError, KernelError {
    th: int = level_theorem();
    show_line(thm_prop(th));
    line_print();
    line_clear();
    line_add("hypotheses: ");
    line_int(thm_hyp_count(th));
    line_add(", oracle: ");
    if (thm_trusts_oracle(th)) line_add("yes") else line_add("no");
    line_add(", is the level's statement: ");
    if (thm_prop(th) == lv_goal[cur_level]) line_add("yes") else line_add("no");
    line_print()
}

test "a chain of ifs" {
    load_region("programs/lemma/regions/logic.txt");
    level_start(level_named("chain"));
    print_focus();
    ok(tap_goal("Assume it"));
    print_focus();
    cands_hyp(focus(), 1);
    print_cands();
    ok(tap_hyp(1, "Apply it"));
    print_focus();
    ok(tap_hyp(0, "Apply it"));
    print_focus();
    print_theorem();
    expect {|
        P ⟶ Q
        Q ⟶ R
        ⊢ P ⟶ R
        P ⟶ Q
        Q ⟶ R
        P
        ⊢ R
        Apply it
        P ⟶ Q
        P
        ⊢ Q
        done
        P ⟶ Q ⟹ Q ⟶ R ⟹ P ⟶ R
        hypotheses: 0, oracle: no, is the level's statement: yes
    |}
}

test "someone for everyone" {
    load_region("programs/lemma/regions/logic.txt");
    level_start(level_named("swap_quantifiers"));
    print_focus();
    cands_goal(focus());
    print_cands();
    ok(tap_goal("Take any y"));
    print_focus();
    cands_hyp(focus(), 0);
    print_cands();
    ok(tap_hyp(0, "Get x"));
    print_focus();
    cands_goal(focus());
    print_cands();
    ok(tap_goal_with("Choose ...", "x", ""));
    print_focus();
    ok(tap_hyp(0, "Use with y"));
    print_focus();
    print_theorem();
    expect {|
        ∃x. ∀y. R(x, y)
        ⊢ ∀y. ∃x. R(x, y)
        Take any y | Suppose not
        ∃x. ∀y. R(x, y)
        ⊢ ∃x. R(x, y)
        Get x
        ∀y. R(x, y)
        ⊢ ∃x. R(x, y)
        Choose … | Suppose not
        ∀y. R(x, y)
        ⊢ R(x, y)
        done
        (∃x. ∀y. R(x, y)) ⟹ (∀y. ∃x. R(x, y))
        hypotheses: 0, oracle: no, is the level's statement: yes
    |}
}

test "a fact onto the goal, with a name still to drop" {
    load_region("programs/lemma/regions/logic.txt");
    level_start(level_named("for_every"));
    print_int(gs_apply_wn(focus(), 0));
    ok(gs_apply(focus(), 0, witness_term(focus(), "a")));
    print_bool(level_done());
    expect {|
        1
        true
    |}
}

test "gestures, and a goal that cannot be shown" {
    load_region("programs/lemma/regions/logic.txt");
    level_start(level_named("swap_quantifiers"));
    print_int(gs_dead(focus(), 6, 3000));
    ok(gs_key(focus(), -1));
    print_focus();
    ok(gs_notch(focus(), -1, witness_term(focus(), "y")));
    print_focus();
    print_int(gs_dead(focus(), 6, 3000));
    undo();
    ok(gs_key(focus(), 0));
    print_focus();
    print_int(gs_dead(focus(), 6, 3000));
    ok(gs_apply(focus(), 0, 0));
    ok(gs_notch(focus(), -1, witness_term(focus(), "x")));
    print_focus();
    ok(gs_apply(focus(), 0, 0));
    print_bool(level_done());
    expect {|
        0
        ∃x. ∀y. R(x, y)
        ⊢ ∃x. R(x, y)
        ∃x. ∀y. R(x, y)
        ⊢ R(y, y)
        1
        ∀y. R(x, y)
        ⊢ ∃x. R(x, y)
        0
        (no such move)
        ∀y. R(x, y)
        ⊢ R(x, y)
        true
    |}
}
