tag lemma_ui;

use_tag std, skate, lemma;

// The game's own things, from which its pages are made: colors; buttons,
// made as they are drawn and pressed against what the last frame drew;
// things that ease to where they are going; lists that scroll and glide;
// a word for a moment (the toast); and icons. (After programs/recipes.)
const C_BG: int = 16183783; // #f6f1e7

const C_CARD: int = 16776696; // #fffdf8

const C_INK: int = 2827807; // #2b261f

const C_MUTED: int = 9077108; // #8a8174

const C_FAINT: int = 12169378; // #b9b0a2

const C_LINE: int = 15130318; // #e6dece

const C_SUNK: int = 15591128; // #ede6d8

const C_SHADOW: int = 3812894; // #3a2e1e

const C_WHITE: int = 16777215; // #ffffff

// The color of what a finger picked, and of a move's button.
const C_PICK: int = 15238970; // #e8873a

const C_PICK_SOFT: int = 16574416; // #fce7d0

const C_GOLD: int = 14852923; // #e2a33b

const C_GOLD_SOFT: int = 16511963; // #fbf4db

const C_GREEN: int = 4160846; // #3f7d4e

const C_GREEN_SOFT: int = 14806748; // #e1eedc

const C_BLUE: int = 3824544; // #3a5ba0

const C_BLUE_SOFT: int = 15004410; // #e4f2fa

const C_RED: int = 13784378; // #d2553a

// What a tap holds: its edge, quiet.
const C_HOLD: int = 9077108; // #8a8174

// The tints blocks nested in blocks take, by how deep they are.
block_tints: []int = [15722747, 14988266, 16575453, 15069177, 16707540, 15330800];

mix_rgb(a: int, b: int, t: f32): int {
    k: f32 = clampf(t, 0.0, 1.0);
    r: int = ((a >> 16 & 255) as f32 * (1.0 - k) + (b >> 16 & 255) as f32 * k + 0.5) as int;
    g: int = ((a >> 8 & 255) as f32 * (1.0 - k) + (b >> 8 & 255) as f32 * k + 0.5) as int;
    bl: int = ((a & 255) as f32 * (1.0 - k) + (b & 255) as f32 * k + 0.5) as int;
    (r << 16) + (g << 8) + bl
}

// ---- time, and things easing ----
now_t: f32 = 0.0;

frame_dt: f32 = 0.016;

// Whether anything drawn this frame is still on its way (so that the
// next frame is drawn too).
busy: bool = false;

ease_to(cur: f32, target: f32, rate: f32): f32 {
    if (absf(target - cur) < 0.0008) return target;
    busy = true;
    cur + (target - cur) * (1.0 - expf(-frame_dt * rate))
}

// A spring: toward target, a little past, and back (pudgy). The value and
// its speed are kept by the caller.
spring_v: f32 = 0.0;

spring(
    cur: f32,
    vel: f32,
    target: f32,
    stiff: f32,
    damp: f32
): f32 {
    dt: f32 = minf(frame_dt, 0.033);
    a: f32 = (target - cur) * stiff - vel * damp;
    spring_v = vel + a * dt;
    if (absf(target - cur) < 0.05 && absf(spring_v) < 0.5) {
        spring_v = 0.0;
        return target
    }
    busy = true;
    cur + spring_v * dt
}

// The phone's own edges (its notch, its home bar), in the game's pixels.
safe_top: f32 = 0.0;

safe_bottom: f32 = 0.0;

safe_left: f32 = 0.0;

safe_right: f32 = 0.0;

// Whether fingers are a phone's (the page says so), and whether the game
// is on a page at all.
touch_ui: bool = false;

on_page: bool = false;

// ---- buttons ----
const BUTTONS: int = 1024;

btn_n: int = 0;

btn_id: []int = new int[BUTTONS](0);

btn_x0: []f32 = new f32[BUTTONS](0.0);

btn_y0: []f32 = new f32[BUTTONS](0.0);

btn_x1: []f32 = new f32[BUTTONS](0.0);

btn_y1: []f32 = new f32[BUTTONS](0.0);

// A button, as much of it as shows within the clip.
add_button(
    id: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    if (btn_n >= BUTTONS) return;
    a: f32 = maxf(x0, p_cx0);
    b: f32 = maxf(y0, p_cy0);
    c: f32 = minf(x1, p_cx1);
    d: f32 = minf(y1, p_cy1);
    if (c <= a || d <= b) return;
    btn_id[btn_n] = id;
    btn_x0[btn_n] = a;
    btn_y0[btn_n] = b;
    btn_x1[btn_n] = c;
    btn_y1[btn_n] = d;
    btn_n = btn_n + 1
}

// The button at (x, y), the last drawn first (it is on top); 0 if none.
button_at(x: f32, y: f32): int {
    k: int = btn_n - 1;
    while (k >= 0) {
        if (x >= btn_x0[k] - 2.0 && x <= btn_x1[k] + 2.0 && y >= btn_y0[k] - 2.0 && y <= btn_y1[k] + 2.0) return btn_id[k];
        k = k - 1
    }
    0
}

// The button a finger is on, and how pressed it shows (in quickly, out
// slowly).
press_id: int = 0;

press_show: f32 = 0.0;

press_shown_id: int = 0;

pressed(id: int): f32 {
    if (press_shown_id == id) return press_show;
    0.0
}

step_press() {
    if (press_id != 0) {
        press_shown_id = press_id;
        press_show = minf(press_show + frame_dt * 16.0, 1.0)
    } else press_show = maxf(press_show - frame_dt * 5.0, 0.0);
    if (press_show > 0.0 && press_show < 1.0) busy = true
}

// ---- lists that scroll ----
// Each page's list: how far it has scrolled, how fast it goes on, how far
// it can go, and whether a finger holds it.
const VIEWS: int = 4;

const V_MAP: int = 0;

const V_LEVEL: int = 1;

const V_PROOF: int = 2;

const V_TRAY: int = 3;

sc_pos: []f32 = new f32[VIEWS](0.0);

sc_vel: []f32 = new f32[VIEWS](0.0);

sc_most: []f32 = new f32[VIEWS](0.0);

sc_held: []bool = new bool[VIEWS](false);

// A list let go glides to a stop, or back within its ends.
step_scroll(v: int) {
    if (sc_held[v]) return;
    dt: f32 = frame_dt;
    p: f32 = sc_pos[v];
    most: f32 = maxf(sc_most[v], 0.0);
    if (p < 0.0 || p > most) {
        end: f32 = 0.0;
        if (p > most) end = most;
        sc_vel[v] = sc_vel[v] * expf(-dt * 22.0);
        p = p + sc_vel[v] * dt;
        p = end + (p - end) * expf(-dt * 11.0);
        if (absf(p - end) < 0.3) p = end;
        sc_pos[v] = p;
        busy = true;
        return
    }
    if (absf(sc_vel[v]) < 8.0) {
        sc_vel[v] = 0.0;
        return
    }
    sc_pos[v] = p + sc_vel[v] * dt;
    sc_vel[v] = sc_vel[v] * expf(-dt * 2.4);
    busy = true
}

// Moved by a finger, dy down the screen: past an end, reluctantly.
scroll_by(v: int, dy: f32) {
    most: f32 = maxf(sc_most[v], 0.0);
    p: f32 = sc_pos[v];
    k: f32 = 1.0;
    if (p < 0.0) k = 0.5 / (1.0 - p / 90.0);
    if (p > most) k = 0.5 / (1.0 + (p - most) / 90.0);
    sc_pos[v] = p - dy * k
}

// ---- a toast: a word for a moment ----
toast_buf: []i8 = new i8[200](0i8);

toast_n: int = 0;

toast_t: f32 = 10.0;

// Show the line now being made (in line).
toast_line() {
    toast_n = mini(line_n, len(toast_buf));
    for i in 0..toast_n toast_buf[i] = line[i];
    toast_t = 0.0;
    path_toast = false
}

toast(t: str) {
    line_clear();
    line_add(t);
    toast_line()
}

draw_toast(top: f32, from_above: bool) {
    if (toast_t >= 2.4 || toast_n == 0) return;
    toast_t = toast_t + frame_dt;
    busy = true;
    // (A soft pill, its words grey: it fades in and out.)
    a: f32 = clampf(toast_t * 6.0, 0.0, 1.0) * clampf((2.4 - toast_t) * 4.0, 0.0,
        1.0);
    size: f32 = 14.0;
    tw: f32 = p_text_w(0, size, toast_buf, 0, toast_n);
    w: f32 = minf(tw + 32.0, view_w() - 32.0);
    if (tw + 32.0 > w) size = size * (w - 32.0) / tw;
    h: f32 = 34.0;
    x: f32 = (view_w() - w) * 0.5;
    y: f32 = top;
    if (!from_above) y = top + 6.0;
    p_shadow(x, y, w, h, h * 0.5, 2.0, 8.0, 0.1 * a);
    p_box(x, y, w, h, h * 0.5, C_CARD, a);
    p_outline(x, y, w, h, h * 0.5, 1.0, C_LINE, a);
    p_text(0, size, x + 16.0, y + h * 0.5 + size * 0.36, toast_buf, 0, toast_n, 0.0,
        C_MUTED, a)
}

// ---- writing a name (a symbol of text.l8) ----
p_sym_w(face: int, size: f32, s: int): f32 {
    p_text_w(face, size, sym_bytes, sym_start[s], sym_start[s] + sym_len[s])
}

p_sym(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    s: int,
    rgb: int,
    a: f32
) {
    pen_end = p_text(face, size, x, y, sym_bytes, sym_start[s], sym_start[s] + sym_len[s],
        0.0, rgb, a)
}

// Where the pen ended, the last time that was not asked for.
pen_end: f32 = 0.0;

// The line now being made, written.
p_line_text(
    face: int,
    size: f32,
    x: f32,
    y: f32,
    rgb: int,
    a: f32
): f32 {
    p_text(face, size, x, y, line, 0, line_n, 0.0, rgb, a)
}

p_line_w(face: int, size: f32): f32 {
    p_text_w(face, size, line, 0, line_n)
}

// ---- icons, drawn in lines about (x, y), r their half size ----
const I_BACK: int = 1;

const I_UNDO: int = 2;

const I_CHECK: int = 3;

const I_LOCK: int = 5;

const I_NEXT: int = 6;

const I_CROSS: int = 7;

const I_BOOK: int = 8;

const I_BULB: int = 9;

draw_icon(
    id: int,
    x: f32,
    y: f32,
    r: f32,
    rgb: int,
    a: f32
) {
    t: f32 = maxf(r * 0.2, 1.6);
    if (id == I_BACK) {
        p_line(x + r * 0.35, y - r * 0.7, x - r * 0.35, y, t, rgb, a);
        p_line(x - r * 0.35, y, x + r * 0.35, y + r * 0.7, t, rgb, a)
    } else if (id == I_NEXT) {
        p_line(x - r * 0.35, y - r * 0.7, x + r * 0.35, y, t, rgb, a);
        p_line(x + r * 0.35, y, x - r * 0.35, y + r * 0.7, t, rgb, a)
    } else if (id == I_UNDO) {
        // (An arrow curving back: an arc, and its head.)
        p_arc(x + r * 0.1, y + r * 0.1, r * 0.62, t * 0.5, 3.6, 4.2, rgb, a);
        hx: f32 = x - r * 0.52;
        hy: f32 = y - r * 0.32;
        p_line(hx, hy, hx + r * 0.05, hy - r * 0.5, t, rgb, a);
        p_line(hx, hy, hx + r * 0.5, hy + r * 0.05, t, rgb, a)
    } else if (id == I_CHECK) {
        p_line(x - r * 0.6, y, x - r * 0.15, y + r * 0.5, t, rgb, a);
        p_line(x - r * 0.15, y + r * 0.5, x + r * 0.65, y - r * 0.5, t, rgb, a)
    } else if (id == I_CROSS) {
        p_line(x - r * 0.5, y - r * 0.5, x + r * 0.5, y + r * 0.5, t, rgb, a);
        p_line(x + r * 0.5, y - r * 0.5, x - r * 0.5, y + r * 0.5, t, rgb, a)
    } else if (id == I_LOCK) {
        p_box(x - r * 0.6, y - r * 0.1, r * 1.2, r * 0.9, r * 0.2, rgb, a);
        p_arc(x, y - r * 0.15, r * 0.38, t * 0.5, 3.1416, 3.1416, rgb, a)
    } else if (id == I_BULB) {
        // (A bulb: a round top, a neck, and a base.)
        p_ring(x, y - r * 0.2, r * 0.55, t * 0.8, rgb, a);
        p_line(x - r * 0.25, y + r * 0.45, x + r * 0.25, y + r * 0.45, t * 0.8, rgb,
            a);
        p_line(x - r * 0.18, y + r * 0.72, x + r * 0.18, y + r * 0.72, t * 0.8, rgb,
            a);
        p_disc(x, y - r * 0.2, r * 0.18, rgb, a * 0.6)
    } else if (id == I_BOOK) {
        p_outline(x - r * 0.75, y - r * 0.6, r * 1.5, r * 1.2, r * 0.15, t * 0.8,
            rgb, a);
        p_line(x, y - r * 0.6, x, y + r * 0.6, t * 0.8, rgb, a)
    }
}
