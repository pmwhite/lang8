tag lemma;

use_tag std;

// Calculate: the arithmetic the game does itself, so a player spends moves
// on ideas (which ε, which N) and not on algebra.
//
// It decides linear arithmetic over an ordered field: sums, differences,
// multiples by numbers, divisions by numbers, < ≤ = ≠, with |x| and max
// taken apart into their two cases. A goal is proved when, with it denied,
// the hypotheses can have no solution, which Fourier–Motzkin elimination
// (over exact fractions) finds in every case. Anything else (a product of
// two unknowns, a function applied) is an unknown of its own; numerals are
// the names 0, 1, 2, ... The natural numbers' order is decided the same
// way: their facts only ever compare two things, so elimination there is
// just chaining (a ≤ b, b ≤ c, so a ≤ c), which holds in any linear order.
//
// This is the game's one oracle: the kernel does not check what it says,
// but marks every theorem that leans on it. It is sound for any ordered
// field whose |x| is the larger of x and −x: what the region's rulebook says.
//
// ---- which symbols are which (set by the region: calc ROLE NAME) ----
const CR_PLUS: int = 0;

const CR_MINUS: int = 1;

const CR_TIMES: int = 2;

const CR_DIVIDE: int = 3;

const CR_NEG: int = 4;

const CR_ABS: int = 5;

const CR_LT: int = 6;

const CR_LE: int = 7;

const CR_NLE: int = 8;

const CR_NLT: int = 9;

const CR_NMAX: int = 10;

const CR_MAX: int = 11;

const CR_MIN: int = 12;

const CROLES: int = 13;

calc_role: []int = static_buffer(CROLES, 0);

calc_role_names: []str = ["plus", "minus", "times", "divide", "neg", "abs", "lt",
    "le", "nle", "nlt", "nmax", "max", "min"];

calc_set_role(r: int, name: int) {
    for i in 0..CROLES {
        if (sym(calc_role_names[i]) == r) calc_role[i] = name
    }
}

calc_clear_roles() {
    for i in 0..CROLES calc_role[i] = 0
}

// ---- fractions ----
type Q = {
    n: int;
    d: int
}

gcd(a0: int, b0: int): int {
    a: int = a0;
    b: int = b0;
    if (a < 0) a = -a;
    if (b < 0) b = -b;
    while (b != 0) {
        t: int = a % b;
        a = b;
        b = t
    }
    if (a == 0) return 1;
    a
}

// (Fractions are kept small: elimination stops if they grow past this.)
const Q_BIG: int = 1000000000000;

q_overflow: bool = false;

qm(n: int, d: int): Q {
    if (d == 0) {
        q_overflow = true;
        return Q { n: 0, d: 1 }
    }
    g: int = gcd(n, d);
    nn: int = n / g;
    dd: int = d / g;
    if (dd < 0) {
        nn = -nn;
        dd = -dd
    }
    if (nn > Q_BIG || nn < -Q_BIG || dd > Q_BIG) q_overflow = true;
    Q { n: nn, d: dd }
}

q_add(a: Q, b: Q): Q {
    qm(a.n * b.d + b.n * a.d, a.d * b.d)
}

q_sub(a: Q, b: Q): Q {
    qm(a.n * b.d - b.n * a.d, a.d * b.d)
}

q_mul(a: Q, b: Q): Q {
    qm(a.n * b.n, a.d * b.d)
}

q_div(a: Q, b: Q): Q {
    qm(a.n * b.d, a.d * b.n)
}

q_zero(): Q {
    Q { n: 0, d: 1 }
}

// ---- unknowns ----
// Each thing the arithmetic does not look inside: its term; whether it is
// a real or a natural number; and if it is |t| or max(a, b), which.
const UNKNOWNS: int = 40;

const U_PLAIN: int = 0;

const U_ABS: int = 1;

const U_MAX: int = 2;

const U_MIN: int = 3;

un_term: []int = static_buffer(UNKNOWNS, 0);

un_kind: []int = static_buffer(UNKNOWNS, 0);

// |t|: the form of t. max(a, b), min(a, b): the forms of a and b.
un_f1: []int = static_buffer(UNKNOWNS, 0);

un_f2: []int = static_buffer(UNKNOWNS, 0);

un_n: int = 0;

calc_failed: bool = false;

// ---- linear forms: a number times each unknown, plus a number ----
const FORMS: int = 2048;

const FW: int = 41;

fm: []Q = static_buffer(FORMS * FW, Q { n: 0, d: 1 });

fm_n: int = 0;

form_new(): int {
    if (fm_n >= FORMS) {
        calc_failed = true;
        return 0
    }
    f: int = fm_n;
    for i in 0..FW fm[f * FW + i] = q_zero();
    fm_n = f + 1;
    f
}

form_const(f: int): Q {
    fm[f * FW + UNKNOWNS]
}

form_is_const(f: int): bool {
    for i in 0..un_n {
        if (fm[f * FW + i].n != 0) return false
    }
    true
}

// a·f + b·g, a new form.
form_comb(
    a: Q,
    f: int,
    b: Q,
    g: int
): int {
    h: int = form_new();
    for i in 0..FW fm[h * FW + i] = q_add(q_mul(a, fm[f * FW + i]), q_mul(b, fm[g * FW + i]));
    h
}

form_scale(a: Q, f: int): int {
    h: int = form_new();
    for i in 0..FW fm[h * FW + i] = q_mul(a, fm[f * FW + i]);
    h
}

form_unknown(u: int): int {
    f: int = form_new();
    fm[f * FW + u] = qm(1, 1);
    f
}

form_number(v: Q): int {
    f: int = form_new();
    fm[f * FW + UNKNOWNS] = v;
    f
}

form_same(f: int, g: int): bool {
    for i in 0..FW {
        a: Q = fm[f * FW + i];
        b: Q = fm[g * FW + i];
        if (a.n != b.n || a.d != b.d) return false
    }
    true
}

form_negated(f: int, g: int): bool {
    for i in 0..FW {
        a: Q = fm[f * FW + i];
        b: Q = fm[g * FW + i];
        if (a.n != -b.n || a.d != b.d) return false
    }
    true
}

// ---- terms to forms ----
// Whether t is the symbol of role r applied to n arguments.
is_role(t: int, r: int, n: int): bool {
    if (calc_role[r] == 0 || spine_len(t) != n) return false;
    h: int = spine_head(t);
    (tm_kind(h) == TM_FREE || tm_kind(h) == TM_CONST) && tm_name(h) == calc_role[r]
}

// The value of a numeral name (0, 1, 2, ...), or -1.
numeral_value(t: int): int {
    k: int = tm_kind(t);
    if (k != TM_FREE && k != TM_CONST) return -1;
    s: int = tm_name(t);
    if (sym_len[s] == 0 || sym_len[s] > 12) return -1;
    v: int = 0;
    for i in 0..sym_len[s] {
        c: int = sym_byte(s, i);
        if (c < 48 || c > 57) return -1;
        v = v * 10 + c - 48
    }
    v
}

// The unknown for term t (made if new), of kind k.
unknown_of(
    t: int,
    k: int,
    f1: int,
    f2: int
): int {
    for u in 0..un_n {
        if (un_term[u] == t) return u
    }
    // (|t| and |−t| and |s| for any s with the same form are one unknown.)
    if (k == U_ABS) {
        for u in 0..un_n {
            if (un_kind[u] == U_ABS && (form_same(un_f1[u], f1) || form_negated(un_f1[u],
                f1))) return u
        }
    }
    if (un_n >= UNKNOWNS) {
        calc_failed = true;
        return 0
    }
    u: int = un_n;
    un_term[u] = t;
    un_kind[u] = k;
    un_f1[u] = f1;
    un_f2[u] = f2;
    un_n = u + 1;
    u
}

// A term's linear form.
linear(t: int): int {
    v: int = numeral_value(t);
    if (v >= 0) return form_number(qm(v, 1));
    if (is_role(t, CR_PLUS, 2)) return form_comb(qm(1, 1), linear(spine_arg(t, 2,
        0)), qm(1, 1), linear(spine_arg(t, 2, 1)));
    if (is_role(t, CR_MINUS, 2)) return form_comb(qm(1, 1), linear(spine_arg(t, 2,
        0)), qm(-1, 1), linear(spine_arg(t, 2, 1)));
    if (is_role(t, CR_NEG, 1)) return form_scale(qm(-1, 1), linear(tm_arg(t)));
    if (is_role(t, CR_TIMES, 2)) {
        a: int = linear(spine_arg(t, 2, 0));
        b: int = linear(spine_arg(t, 2, 1));
        if (form_is_const(a)) return form_scale(form_const(a), b);
        if (form_is_const(b)) return form_scale(form_const(b), a)
    }
    if (is_role(t, CR_DIVIDE, 2)) {
        b: int = linear(spine_arg(t, 2, 1));
        if (form_is_const(b) && form_const(b).n != 0) return form_scale(q_div(qm(1,
            1), form_const(b)), linear(spine_arg(t, 2, 0)))
    }
    if (is_role(t, CR_ABS, 1)) {
        a: int = linear(tm_arg(t));
        if (form_is_const(a)) {
            c: Q = form_const(a);
            if (c.n < 0) return form_number(qm(-c.n, c.d));
            return form_number(c)
        }
        return form_unknown(unknown_of(t, U_ABS, a, 0))
    }
    if (is_role(t, CR_NMAX, 2) || is_role(t, CR_MAX, 2)) return form_unknown(unknown_of(t,
        U_MAX, linear(spine_arg(t, 2, 0)), linear(spine_arg(t, 2, 1))));
    if (is_role(t, CR_MIN, 2)) return form_unknown(unknown_of(t, U_MIN, linear(spine_arg(t,
        2, 0)), linear(spine_arg(t, 2, 1))));
    form_unknown(unknown_of(t, U_PLAIN, 0, 0))
}

// ---- constraints: form ≤ 0, form < 0, or form = 0 ----
const R_LE: int = 0;

const R_LT: int = 1;

const R_EQ: int = 2;

const CONS: int = 4096;

cs_form: []int = static_buffer(CONS, 0);

cs_rel: []int = static_buffer(CONS, 0);

cs_n: int = 0;

cs_add(f: int, rel: int) {
    if (cs_n >= CONS) {
        calc_failed = true;
        return
    }
    cs_form[cs_n] = f;
    cs_rel[cs_n] = rel;
    cs_n = cs_n + 1
}

// a < b, a ≤ b, a = b: as constraints a − b < 0 and so on.
cs_rel_terms(a: int, b: int, rel: int) {
    cs_add(form_comb(qm(1, 1), linear(a), qm(-1, 1), linear(b)), rel)
}

// Choices to make: pairs of sets of constraints, one of which holds.
const CHOICES: int = 24;

ch_a0: []int = static_buffer(CHOICES, 0);

ch_an: []int = static_buffer(CHOICES, 0);

ch_b0: []int = static_buffer(CHOICES, 0);

ch_bn: []int = static_buffer(CHOICES, 0);

ch_n: int = 0;

// Constraints kept for the choices (forms and relations).
alt_form: []int = static_buffer([256]int);

alt_rel: []int = static_buffer([256]int);

alt_n: int = 0;

alt_add(f: int, rel: int) {
    if (alt_n >= len(alt_form)) {
        calc_failed = true;
        return
    }
    alt_form[alt_n] = f;
    alt_rel[alt_n] = rel;
    alt_n = alt_n + 1
}

choice_begin() {
    if (ch_n >= CHOICES) {
        calc_failed = true;
        return
    }
    ch_a0[ch_n] = alt_n
}

choice_mid() {
    if (ch_n >= CHOICES) return;
    ch_an[ch_n] = alt_n - ch_a0[ch_n];
    ch_b0[ch_n] = alt_n
}

choice_end() {
    if (ch_n >= CHOICES) return;
    ch_bn[ch_n] = alt_n - ch_b0[ch_n];
    ch_n = ch_n + 1
}

// What a statement says, as constraints (true: as it is; false: denied).
// Whether it was arithmetic at all.
say_fact(p: int, holds: bool): bool {
    t: int = rel_core(p);
    if (is_binary(t, role_name[ROLE_CONJ]) && holds) {
        a: bool = say_fact(spine_arg(t, 2, 0), true);
        b: bool = say_fact(spine_arg(t, 2, 1), true);
        return a || b
    }
    if (is_binary(t, role_name[ROLE_DISJ]) && !holds) {
        a: bool = say_fact(spine_arg(t, 2, 0), false);
        b: bool = say_fact(spine_arg(t, 2, 1), false);
        return a || b
    }
    if (spine_len(t) == 1 && tm_kind(spine_head(t)) == TM_CONST && tm_name(spine_head(t)) == role_name[ROLE_NOT]) return say_fact(tm_arg(t),
        !holds);
    if (tm_kind(t) == TM_CONST && tm_name(t) == role_name[ROLE_FALSE]) {
        // (False holding: no solution at all.)
        if (holds) cs_add(form_number(qm(1, 1)), R_LE);
        return true
    }
    if (spine_len(t) != 2) return false;
    a: int = spine_arg(t, 2, 0);
    b: int = spine_arg(t, 2, 1);
    lt: bool = is_role(t, CR_LT, 2) || is_role(t, CR_NLT, 2);
    le: bool = is_role(t, CR_LE, 2) || is_role(t, CR_NLE, 2);
    eq: bool = is_binary(t, role_name[ROLE_EQ]) && arith_type(tm_type(a));
    if (lt) {
        if (holds) cs_rel_terms(a, b, R_LT) else cs_rel_terms(b, a, R_LE);
        return true
    }
    if (le) {
        if (holds) cs_rel_terms(a, b, R_LE) else cs_rel_terms(b, a, R_LT);
        return true
    }
    if (eq) {
        if (holds) cs_rel_terms(a, b, R_EQ) else {
            // (a ≠ b: a < b, or b < a.)
            choice_begin();
            alt_add(form_comb(qm(1, 1), linear(a), qm(-1, 1), linear(b)), R_LT);
            choice_mid();
            alt_add(form_comb(qm(1, 1), linear(b), qm(-1, 1), linear(a)), R_LT);
            choice_end()
        }
        return true
    }
    false
}

// The types the arithmetic knows: those its relations are about.
arith_type(t: int): bool {
    for r in 0..CROLES {
        if (calc_role[r] != 0 && (r == CR_LT || r == CR_LE || r == CR_NLE || r == CR_NLT)) {
            e: int = find_ent(calc_role[r], 1 << E_FIX | 1 << E_CONST);
            if (e >= 0 && ty_kind(ent_ty[e]) == TY_FUN && ty_dom(ent_ty[e]) == t) return true
        }
    }
    false
}

// Each |t|, max and min unknown, as its two cases.
split_unknowns() {
    u: int = 0;
    while (u < un_n) {
        k: int = un_kind[u];
        x: int = form_unknown(u);
        if (k == U_ABS) {
            // (t ≥ 0 and |t| = t, or t < 0 and |t| = −t.)
            t: int = un_f1[u];
            choice_begin();
            alt_add(form_scale(qm(-1, 1), t), R_LE);
            alt_add(form_comb(qm(1, 1), x, qm(-1, 1), t), R_EQ);
            choice_mid();
            alt_add(t, R_LT);
            alt_add(form_comb(qm(1, 1), x, qm(1, 1), t), R_EQ);
            choice_end()
        } else if (k == U_MAX || k == U_MIN) {
            // (a ≥ b and it is a (max) or b (min), or a < b and the other.)
            a: int = un_f1[u];
            b: int = un_f2[u];
            first: int = a;
            second: int = b;
            if (k == U_MIN) {
                first = b;
                second = a
            }
            choice_begin();
            alt_add(form_comb(qm(1, 1), b, qm(-1, 1), a), R_LE);
            alt_add(form_comb(qm(1, 1), x, qm(-1, 1), first), R_EQ);
            choice_mid();
            alt_add(form_comb(qm(1, 1), a, qm(-1, 1), b), R_LT);
            alt_add(form_comb(qm(1, 1), x, qm(-1, 1), second), R_EQ);
            choice_end()
        }
        u = u + 1
    }
}

// ---- elimination ----
// Whether the constraints (cs, from 0 to n, with the choices made so far
// in work) have no solution.
wk_form: []int = static_buffer(CONS, 0);

wk_rel: []int = static_buffer(CONS, 0);

wk_n: int = 0;

wk_add(f: int, rel: int) {
    if (wk_n >= CONS) {
        calc_failed = true;
        return
    }
    wk_form[wk_n] = f;
    wk_rel[wk_n] = rel;
    wk_n = wk_n + 1
}

// Whether a form with no unknowns left breaks its relation.
const_false(f: int, rel: int): bool {
    c: Q = form_const(f);
    if (rel == R_LE) return c.n > 0;
    if (rel == R_LT) return c.n >= 0;
    c.n != 0
}

no_solution(): bool {
    // (Equations first: each solved for an unknown and put into the rest.)
    more: bool = true;
    while (more && !calc_failed) {
        more = false;
        i: int = 0;
        while (i < wk_n && !more) {
            if (wk_rel[i] == R_EQ && !form_is_const(wk_form[i])) {
                e: int = wk_form[i];
                v: int = 0;
                while (fm[e * FW + v].n == 0) v = v + 1;
                cv: Q = fm[e * FW + v];
                for j in 0..wk_n {
                    if (j != i) {
                        cj: Q = fm[wk_form[j] * FW + v];
                        if (cj.n != 0) wk_form[j] = form_comb(qm(1, 1), wk_form[j],
                            q_div(qm(-cj.n, cj.d), cv), e)
                    }
                }
                wk_form[i] = wk_form[wk_n - 1];
                wk_rel[i] = wk_rel[wk_n - 1];
                wk_n = wk_n - 1;
                more = true
            }
            i = i + 1
        }
    }
    for v in 0..un_n {
        if (calc_failed || q_overflow) return false;
        for i in 0..wk_n {
            if (form_is_const(wk_form[i]) && const_false(wk_form[i], wk_rel[i])) return true
        }
        // (Each lower bound on v put with each upper bound.)
        keep: int = 0;
        pos0: int = fm_n;
        start: int = wk_n;
        for i in 0..start {
            c: Q = fm[wk_form[i] * FW + v];
            if (c.n > 0) {
                for j in 0..start {
                    d: Q = fm[wk_form[j] * FW + v];
                    if (d.n < 0) {
                        f: int = form_comb(qm(-d.n, d.d), wk_form[i], qm(c.n, c.d),
                            wk_form[j]);
                        rel: int = R_LE;
                        if (wk_rel[i] == R_LT || wk_rel[j] == R_LT) rel = R_LT;
                        wk_add(f, rel)
                    }
                }
            }
        }
        // (Those without v stay, with the new ones.)
        for i in 0..wk_n {
            if (i >= start || fm[wk_form[i] * FW + v].n == 0) {
                wk_form[keep] = wk_form[i];
                wk_rel[keep] = wk_rel[i];
                keep = keep + 1
            }
        }
        wk_n = keep;
        if (pos0 > FORMS) return false
    }
    for i in 0..wk_n {
        if (const_false(wk_form[i], wk_rel[i])) return true
    }
    false
}

// Whether every way of making the choices (from choice c on) leaves no
// solution, with the constraints chosen so far in chosen.
chosen: []int = static_buffer([64]int);

chosen_n: int = 0;

all_cases(c: int): bool {
    if (calc_failed) return false;
    if (c == ch_n) {
        wk_n = 0;
        for i in 0..cs_n wk_add(cs_form[i], cs_rel[i]);
        for i in 0..chosen_n wk_add(alt_form[chosen[i]], alt_rel[chosen[i]]);
        mark: int = fm_n;
        r: bool = no_solution();
        fm_n = mark;
        return r
    }
    save: int = chosen_n;
    for i in 0..ch_an[c] push_chosen(ch_a0[c] + i);
    a: bool = all_cases(c + 1);
    chosen_n = save;
    if (!a) return false;
    for i in 0..ch_bn[c] push_chosen(ch_b0[c] + i);
    b: bool = all_cases(c + 1);
    chosen_n = save;
    b
}

push_chosen(i: int) {
    if (chosen_n < len(chosen)) {
        chosen[chosen_n] = i;
        chosen_n = chosen_n + 1
    } else calc_failed = true
}

// ---- deciding a goal ----
// Whether Calculate proves goal g: its conclusion from its hypotheses.
calc_decides(g: int): bool {
    if (calc_role[CR_LT] == 0 && calc_role[CR_NLE] == 0) return false;
    c: int = gl_concl[g];
    if (has_vars(c)) return false;
    calc_failed = false;
    q_overflow = false;
    un_n = 0;
    fm_n = 0;
    cs_n = 0;
    ch_n = 0;
    alt_n = 0;
    chosen_n = 0;
    // (The goal denied: it must be arithmetic.)
    if (!say_fact(c, false)) return false;
    for i in 0..gl_hypn[g] last_said = say_fact(goal_hyp(g, i), true);
    split_unknowns();
    if (calc_failed || ch_n > 10) return false;
    all_cases(0) && !calc_failed && !q_overflow
}

last_said: bool = false
