tag lemma;

use_tag std;

// Playing levels from code: for tests, and for the solver. The same moves
// a finger makes, picked by their buttons' words.
//
// The node being played: the first open goal.
focus(): int {
    level_open();
    if (open_n == 0) return -1;
    open_nodes[0]
}

// The candidate whose button says these words, or -1.
cand_named(words: str): int {
    s: int = sym(words);
    for c in 0..cd_n {
        if (cd_label[c] == s) return c
    }
    -1
}

wit_buf: []int = new int[8](0);

last_ent: int = 0;

// Make the move with these words, from candidates already listed, at the
// focus; witnesses read from text. Whether it was there.
play_cand(words: str, w1: str, w2: str) raises KernelError: bool {
    c: int = cand_named(words);
    if (c < 0) return false;
    n: int = focus();
    wn: int = 0;
    if (cd_wn[c] > 0) {
        wit_buf[0] = witness_term(n, w1);
        wn = 1
    }
    if (cd_wn[c] > 1) {
        wit_buf[1] = witness_term(n, w2);
        wn = 2
    }
    last_move = cand_apply(n, c, wit_buf, wn);
    auto_close();
    true
}

// A term read from text, in goal g's names (its fixed names in scope).
wit_text: []i8 = new i8[256](0i8);

witness_term(n: int, t: str) raises KernelError: int {
    g: int = pn_goal[n];
    mark: int = ent_n;
    for i in 0..gl_fixn[g] {
        x: int = goal_fix(g, i);
        last_ent = add_ent(tm_name(x), E_FIX, tm_type(x), x)
    }
    k: int = 0;
    for c in t {
        if (k < len(wit_text)) {
            wit_text[k] = c;
            k = k + 1
        }
    }
    read_from(wit_text, k);
    r: int = 0;
    try {
        r = read_term_only()
    } with ReadError -> {
        r = 0
    }
    ent_n = mark;
    r
}

// Tap the goal, then the button with these words.
tap_goal(words: str) raises KernelError: bool {
    n: int = focus();
    if (n < 0) return false;
    cands_goal(n);
    play_cand(words, "", "")
}

tap_goal_with(words: str, w1: str, w2: str) raises KernelError: bool {
    n: int = focus();
    if (n < 0) return false;
    cands_goal(n);
    play_cand(words, w1, w2)
}

// Tap hypothesis j, then the button.
tap_hyp(j: int, words: str) raises KernelError: bool {
    n: int = focus();
    if (n < 0) return false;
    cands_hyp(n, j);
    play_cand(words, "", "")
}

tap_hyp_with(j: int, words: str, w1: str) raises KernelError: bool {
    n: int = focus();
    if (n < 0) return false;
    cands_hyp(n, j);
    play_cand(words, w1, "")
}

// Tap the part of the conclusion (in < 0) or hypothesis `in` that is the
// term written t (its first place), then the button.
tap_part(in_hyp: int, t: str, words: str) raises KernelError: bool {
    n: int = focus();
    if (n < 0) return false;
    g: int = pn_goal[n];
    s: int = witness_term(n, t);
    target: int = gl_concl[g];
    if (in_hyp >= 0) target = goal_hyp(g, in_hyp);
    if (s == 0 || !find_path(target, s)) return false;
    sub_n = fp_n;
    for i in 0..fp_n sub_steps[i] = fp_steps[i];
    cands_sub(n, in_hyp);
    play_cand(words, "", "")
}

// ---- showing the state ----
// The focus goal, as lines: hypotheses, then ‚ä¢ the conclusion.
print_focus() raises IoError {
    n: int = focus();
    if (n < 0) {
        print("done");
        return
    }
    g: int = pn_goal[n];
    for i in 0..gl_hypn[g] {
        show_line(goal_hyp(g, i));
        line_print()
    }
    show_line(gl_concl[g]);
    // (‚ä¢ in front.)
    k: int = line_n;
    copy: []i8 = line_copy;
    for i in 0..k copy[i] = line[i];
    line_clear();
    line_add("\‚\ä\¢ ");
    for i in 0..k line_byte(copy[i] as int);
    line_print()
}

line_copy: []i8 = new i8[65536](0i8);

// The buttons for the candidates listed.
print_cands() raises IoError {
    line_clear();
    for c in 0..cd_n {
        if (c > 0) line_add(" | ");
        line_sym(cd_label[c])
    }
    line_print()
}
