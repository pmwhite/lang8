tag lemma_ui;

use_tag std, gl, x11, skate, lemma;

// Lemma: a puzzle game made of real proofs. Each level is a theorem, proved
// from the ground up by moves a finger makes, each checked by a small
// kernel; see README.md.
//
//   .build/lemma [PROGRESS]
//
// PROGRESS (what has been proved) is .build/lemma-progress.txt if none.
// Off a page the window is phone shaped; L8_W, L8_H and L8_UI (window
// pixels to the game's, in hundredths) change it.
import "../../stdlib/print.l8";

import "../gl/gl.l8";

import "../skate/math.l8";

import "lemma.l8";

import "font.l8";

import "paint.l8";

import "ui.l8";

import "boxes.l8";

import "app.l8";

import "trial.l8";

import "board.l8";

import "picture.l8";

import "beadboard.l8";

import "pages.l8";

import "words.l8";

import "touch.l8";

extern getenv(name: str): ?*i8;

extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int
}

clock_ns(clk: int): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(clk, &ts);
    ts.sec * 1000000000 + ts.nsec
}

progress_path: str = ".build/lemma-progress.txt";

save_progress() raises IoError {
    write_progress();
    fd: int = open(progress_path, 577, 420);
    if (fd < 0) return;
    write_bytes_n(fd, progress_buf, progress_n);
    close(fd)
}

// The theory files, read whole and kept.
read_files() {
    t: []i8 = read_whole("programs/lemma/hol.txt");
    keep_file(0, t, whole_n);
    for r in 0..len(region_files) {
        t2: []i8 = read_whole(region_files[r]);
        keep_file(r + 1, t2, whole_n)
    }
}

main(argc: int, argv: []str@immortal) raises IoError, KernelError: int {
    if (argc > 1) progress_path = argv[1];
    read_files();
    if (!load_logic_file()) {
        eprint("lemma: the logic would not load");
        return 1
    }
    read_map();
    pt: []i8 = read_whole(progress_path);
    if (whole_n > 0) read_progress(pt, whole_n);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) ui_die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root_win: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root_win, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    scr_w = env_int("L8_W", 430);
    scr_h = env_int("L8_H", 900);
    p_ui = env_int("L8_UI", 100) as f32 / 100.0;
    win: int = XCreateWindow(dpy, root_win, 0, 0, scr_w, scr_h, 0, vis.depth as int,
        1, vis.visual, 10248, &wa);
    if (win == 0) ui_die("XCreateWindow failed");
    XStoreName(dpy, win, "Lemma");
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) ui_die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) ui_die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    painter: *Painter = new_painter();
    touch_ui = getenv("L8_TOUCH") != null;
    on_page = getenv("L8_PAGE") != null;
    // (L8_LEVEL=k starts on map level k: for pictures of a level.)
    start_at: int = env_int("L8_LEVEL", -1);
    if (start_at >= 0 && start_at < ml_n) {
        start_level(start_at);
        // (L8_CHAPTER: its chapter's first page too, as the map opens it.)
        if (getenv("L8_CHAPTER") != null) chapter_maybe();
        watch_pace = env_int("L8_WATCH_PACE", 100) as f32 / 100.0;
        if (getenv("L8_WATCH") != null) start_watch()
    }
    // (L8_BOOK=r opens chapter r's Book, as its cover on the map does.)
    if (getenv("L8_BOOK") != null) act(B_COVER + env_int("L8_BOOK", 0));
    taps_read();
    boxes_on = getenv("L8_BOXES") != null;
    do_read();
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = clock_ns(1);
    start_ns: int = prev_ns;
    still: int = 0;
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            still = 0;
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65307) {
                        if (!esc_key() && !on_page) running = false
                    } else if (ks >= 1000000000) page_says(ks - 1000000000) else key_press(ks)
                }
                ButtonPress b -> {
                    bn: int = b.button as int;
                    x: f32 = b.x as f32 / p_ui;
                    y: f32 = b.y as f32 / p_ui;
                    if (bn == 4 || bn == 5) {
                        amount: f32 = maxf(b.state as f32, 40.0);
                        if (bn == 4) wheel(-amount, y) else wheel(amount, y)
                    } else finger_down(bn, x, y)
                }
                ButtonRelease b -> finger_up(b.button as int, b.x as f32 / p_ui, b.y as f32 / p_ui);
                MotionNotify mo -> finger_move(mo.state as int, mo.x as f32 / p_ui,
                    mo.y as f32 / p_ui);
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        scr_w = c.width as int;
                        scr_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        now: int = clock_ns(1);
        dt: f32 = clampf((now - prev_ns) as f32 / 1000000000.0, 0.0, 0.05);
        prev_ns = now;
        now_t = (now - start_ns) as f32 / 1000000000.0;
        busy = false;
        taps_step();
        step_fingers(dt);
        step_app(dt);
        if (busy || g_finger >= 0) still = 0;
        if (still < 3 || !on_page) {
            glViewport(0, 0, scr_w, scr_h);
            glClearColor(0.965, 0.945, 0.906, 1.0);
            glClear(16640);
            p_reset();
            busy = false;
            draw_game();
            p_draw(painter);
            if (busy) still = 0 else still = still + 1
        }
        if (wants_save) {
            wants_save = false;
            save_progress()
        }
        glXSwapBuffers(dpy, win)
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}

// What the page says (a key 1000000000 + 1000 * what + number): the
// window pixels to one of the page's (5, in 500ths), and the phone's own
// edges (1 top, 2 bottom, 3 left, 4 right).
page_says(v: int) {
    what: int = v / 1000;
    n: int = v % 1000;
    if (what == 5 && n > 0) p_ui = n as f32 / 500.0 else if (what == 1) safe_top = n as f32 else if (what == 2) safe_bottom = n as f32 else if (what == 3) safe_left = n as f32 else if (what == 4) safe_right = n as f32
}

extern l8_environment(): []str@new;

// A whole number from the environment (as L8_W=390), or the fallback.
env_int(key: str, fallback: int): int {
    if (getenv(key) == null) return fallback;
    for e in l8_environment() {
        if (len(e) > len(key) + 1 && e[len(key)] == '=') {
            same: bool = true;
            for i in 0..len(key) {
                if (e[i] != key[i]) same = false
            }
            if (same) {
                v: int = 0;
                neg: bool = false;
                for i in len(key) + 1..len(e) {
                    c: int = e[i] as int;
                    if (c == 45) neg = true else if (c >= 48 && c <= 57) v = v * 10 + c - 48
                }
                if (neg) return -v;
                return v
            }
        }
    }
    fallback
}

// ---- taps and keys from the environment, for pictures of play ----
// L8_TAPS="x,y;x,y;..." taps those places (in the game's pixels), one
// every L8_TAP_GAP hundredths of a second (default 70), from 1.7 s on (the
// level's title card is gone by then). "x,y>x2,y2" swipes from one place
// to the other; "x,y+ms" holds that long (on the bulb: Watch). A tap at
// x = -1 undoes; at x = -2 does nothing (a pause).
//
// L8_KEYS="right;1;a;..." presses keys the same way (after the taps):
// left, right, up, down, enter, esc, back, or one letter or digit.
const TAPS: int = 64;

tap_kind: []int = new int[TAPS](0);

tap_x: []f32 = new f32[TAPS](0.0);

tap_y: []f32 = new f32[TAPS](0.0);

tap_x2: []f32 = new f32[TAPS](0.0);

tap_y2: []f32 = new f32[TAPS](0.0);

tap_ms: []f32 = new f32[TAPS](0.0);

tap_hold: []bool = new bool[TAPS](false);

tap_n: int = 0;

tap_next: int = 0;

key_sym: []int = new int[TAPS](0);

key_n: int = 0;

key_next: int = 0;

// The text of an environment variable, into env_buf (env_len bytes);
// whether it is set.
env_buf: []i8 = new i8[4096](0i8);

env_len: int = 0;

env_text(key: str): bool {
    env_len = 0;
    if (getenv(key) == null) return false;
    for e in l8_environment() {
        if (len(e) > len(key) && e[len(key)] == '=') {
            same: bool = true;
            for i in 0..len(key) {
                if (e[i] != key[i]) same = false
            }
            if (same) {
                for i in len(key) + 1..len(e) {
                    if (env_len < len(env_buf)) {
                        env_buf[env_len] = e[i];
                        env_len = env_len + 1
                    }
                }
                return true
            }
        }
    }
    false
}

// A number in env_buf from env_at (an optional minus first).
env_at: int = 0;

env_num(): f32 {
    neg: bool = false;
    if (env_at < env_len && env_buf[env_at] == '-') {
        neg = true;
        env_at = env_at + 1
    }
    v: f32 = 0.0;
    while (env_at < env_len && env_buf[env_at] as int >= 48 && env_buf[env_at] as int <= 57) {
        v = v * 10.0 + (env_buf[env_at] as int - 48) as f32;
        env_at = env_at + 1
    }
    if (neg) return -v;
    v
}

env_skip(c: int): bool {
    if (env_at < env_len && env_buf[env_at] as int == c) {
        env_at = env_at + 1;
        return true
    }
    false
}

taps_read() {
    tap_n = 0;
    if (env_text("L8_TAPS")) {
        env_at = 0;
        while (env_at < env_len && tap_n < TAPS) {
            k: int = tap_n;
            tap_kind[k] = 0;
            tap_x[k] = env_num();
            env_skip(44);
            tap_y[k] = env_num();
            tap_hold[k] = false;
            if (env_skip(62)) {
                tap_kind[k] = 1;
                // (x,y>>x2,y2+ms: a slow drag, every frame between; ! at
                // the end holds it there.)
                if (env_skip(62)) {
                    tap_kind[k] = 3;
                    tap_ms[k] = 600.0
                }
                tap_x2[k] = env_num();
                env_skip(44);
                tap_y2[k] = env_num();
                if (tap_kind[k] == 3 && env_skip(43)) tap_ms[k] = env_num();
                if (env_skip(33)) tap_hold[k] = true
            } else if (env_skip(43)) {
                tap_kind[k] = 2;
                tap_ms[k] = env_num()
            }
            tap_n = k + 1;
            // (On to the next ;.)
            while (env_at < env_len && env_buf[env_at] as int != 59) env_at = env_at + 1;
            env_skip(59)
        }
    }
    key_n = 0;
    if (env_text("L8_KEYS")) {
        i: int = 0;
        while (i < env_len && key_n < TAPS) {
            j: int = i;
            while (j < env_len && env_buf[j] as int != 59) j = j + 1;
            ks: int = 0;
            if (j - i == 1) ks = env_buf[i] as int else if (env_word(i, j, "left")) ks = 65361 else if (env_word(i,
                j, "right")) ks = 65363 else if (env_word(i, j, "up")) ks = 65362 else if (env_word(i,
                j, "down")) ks = 65364 else if (env_word(i, j, "enter")) ks = 65293 else if (env_word(i,
                j, "esc")) ks = 65307 else if (env_word(i, j, "back")) ks = 65288;
            if (ks != 0) {
                key_sym[key_n] = ks;
                key_n = key_n + 1
            }
            i = j + 1
        }
    }
}

env_word(i: int, j: int, w: str): bool {
    if (j - i != len(w)) return false;
    for k in 0..len(w) {
        if (env_buf[i + k] != w[k]) return false
    }
    true
}

// A gesture being made by script: which, and when it started.
gs_on: bool = false;

gs_k: int = 0;

gs_t: f32 = 0.0;

taps_step() raises KernelError {
    gap: f32 = env_int("L8_TAP_GAP", 70) as f32 / 100.0;
    if (gs_on) {
        k: int = gs_k;
        t: f32 = now_t - gs_t;
        if (tap_kind[k] == 1) {
            f: f32 = clampf(t / 0.18, 0.0, 1.0);
            x: f32 = tap_x[k] + (tap_x2[k] - tap_x[k]) * f;
            y: f32 = tap_y[k] + (tap_y2[k] - tap_y[k]) * f;
            finger_move(256, x, y);
            if (f >= 1.0) {
                finger_up(1, x, y);
                gs_on = false
            }
        } else if (tap_kind[k] == 3) {
            if (job_step(tap_x[k], tap_y[k], tap_x2[k], tap_y2[k], tap_ms[k], tap_hold[k],
                t)) gs_on = false
        } else if (t >= tap_ms[k] / 1000.0) {
            finger_up(1, tap_x[k], tap_y[k]);
            gs_on = false
        }
        return
    }
    if (do_step_go()) return;
    if (tap_next < tap_n) {
        if (now_t < 1.7 + tap_next as f32 * gap) return;
        k: int = tap_next;
        x: f32 = tap_x[k];
        y: f32 = tap_y[k];
        tap_next = k + 1;
        if (x == -1.0) {
            undo_move();
            return
        }
        if (x < 0.0) return;
        finger_down(1, x, y);
        if (tap_kind[k] == 0) finger_up(1, x, y) else {
            gs_on = true;
            gs_k = k;
            gs_t = now_t
        }
        return
    }
    if (key_next < key_n) {
        if (now_t < 1.7 + (tap_n + key_next) as f32 * gap) return;
        if (do_n > 0 && do_next < do_n) return;
        ks: int = key_sym[key_next];
        key_next = key_next + 1;
        if (ks == 65307) esc_key_safe() else key_press(ks)
    }
}

esc_key_safe() {
    if (esc_key()) { }
}

// A slow drag at time t of it: still a moment where it starts (so it is
// picked up), then carried, every frame, to (x1, y1) over ms; let go
// there unless held. Whether it is over.
job_step(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    ms: f32,
    hold: bool,
    t: f32
) raises KernelError: bool {
    busy = true;
    if (t < 0.12) return false;
    f: f32 = clampf((t - 0.12) / maxf(ms / 1000.0, 0.05), 0.0, 1.0);
    k: f32 = f * f * (3.0 - 2.0 * f);
    x: f32 = x0 + (x1 - x0) * k;
    y: f32 = y0 + (y1 - y0) * k;
    finger_move(256, x, y);
    if (f < 1.0) return false;
    if (hold) return false;
    // (A moment over the place, then let go.)
    if (t < 0.12 + ms / 1000.0 + 0.15) return false;
    finger_up(1, x, y);
    true
}

// ---- L8_DO: gestures by what they are, for pictures ----
//   open goal | open fact K                a key tapped
//   token N > goal | > fact K | > kit K    name N carried to the notch (or
//                                            onto the card), or into the
//                                            K-th kit tile; N may be quoted
//   fill N                                 name N into the goal's socket
//   fact K > goal                          fact K carried onto the goal
//   rule K face L > part "T"               the K-th rule tile's face L (0
//   fact K face L > part "T"                 left, 1 right) onto the goal's
//                                            part shown as T
//   lemma K > goal                         the K-th lemma tile onto the goal
//   flip | suppose                         the goal swiped; put into facts
//   tap token N | tap fact K [face L]      a tap: a thing held, or the held
//   tap rule K face L | tap lemma K          one's partner (the move); either
//   tap kit K | tap part "T" | tap goal      first. tap goal is the whole
//   tap notch goal | tap notch fact K        goal (by its edge).
//   undo | hint | enter | wait             as the keys
// Steps are ; apart, each when the last is done (L8_DO_GAP hundredths
// after it, default 90); carries take L8_DO_MS (600). L8_DO_STOP=k holds
// step k (from 1) over its place and does no more.
do_buf: []i8 = new i8[4096](0i8);

do_s0: []int = new int[64](0);

do_s1: []int = new int[64](0);

do_n: int = 0;

do_next: int = 0;

do_free_t: f32 = 1.9;

do_read() {
    do_n = 0;
    if (!env_text("L8_DO")) return;
    for i in 0..env_len do_buf[i] = env_buf[i];
    i: int = 0;
    while (i < env_len && do_n < 64) {
        j: int = i;
        q: bool = false;
        while (j < env_len && (q || do_buf[j] as int != 59)) {
            if (do_buf[j] as int == 34) q = !q;
            j = j + 1
        }
        a: int = i;
        while (a < j && do_buf[a] as int == 32) a = a + 1;
        b: int = j;
        while (b > a && do_buf[b - 1] as int == 32) b = b - 1;
        if (b > a) {
            do_s0[do_n] = a;
            do_s1[do_n] = b;
            do_n = do_n + 1
        }
        i = j + 1
    }
}

// The words of a step, one at a time (a quoted one whole, without its
// quotes).
dw_at: int = 0;

dw_end: int = 0;

dw_a: int = 0;

dw_b: int = 0;

do_word(): bool {
    while (dw_at < dw_end && do_buf[dw_at] as int == 32) dw_at = dw_at + 1;
    if (dw_at >= dw_end) return false;
    if (do_buf[dw_at] as int == 34) {
        dw_a = dw_at + 1;
        dw_at = dw_a;
        while (dw_at < dw_end && do_buf[dw_at] as int != 34) dw_at = dw_at + 1;
        dw_b = dw_at;
        if (dw_at < dw_end) dw_at = dw_at + 1;
        return true
    }
    dw_a = dw_at;
    while (dw_at < dw_end && do_buf[dw_at] as int != 32) dw_at = dw_at + 1;
    dw_b = dw_at;
    true
}

dw_is(w: str): bool {
    if (dw_b - dw_a != len(w)) return false;
    for k in 0..len(w) {
        if (do_buf[dw_a + k] != w[k]) return false
    }
    true
}

dw_num(): int {
    v: int = 0;
    for k in dw_a..dw_b {
        c: int = do_buf[k] as int;
        if (c >= 48 && c <= 57) v = v * 10 + c - 48
    }
    v
}

// The name on the shelf written as the word now (its place), or -1.
dw_token(): int {
    s: int = sym_of(do_buf, dw_a, dw_b);
    for k in 0..shn_n {
        show_line(shn_term[k]);
        if (line_sym_now() == s) return k
    }
    -1
}

// The k-th shelf item of a kind, or -1.
dw_item(kind: int, k: int): int {
    c: int = 0;
    for i in 0..si_n {
        if (si_kind[i] == kind) {
            if (c == k) return i;
            c = c + 1
        }
    }
    -1
}

// The place a thing goes (into ga_x1, ga_y1): goal (its notch if it has
// one), fact K, kit K, part "T" (or goal part "T").
dw_place(): bool {
    if (!do_word()) return false;
    if (dw_is("goal")) {
        save: int = dw_at;
        if (do_word() && dw_is("part")) return dw_part();
        dw_at = save;
        ga_x1 = goal_rx + goal_rw * 0.5;
        ga_y1 = goal_ry + goal_rh * 0.5;
        if (gn_ok && !ps_on) {
            ga_x1 = (gn_x0 + gn_x1) * 0.5;
            ga_y1 = (gn_y0 + gn_y1) * 0.5
        }
        return true
    }
    if (dw_is("part")) return dw_part();
    if (dw_is("kit") && do_word()) {
        k: int = dw_item(SI_KIT, dw_num());
        if (k < 0) return false;
        ga_x1 = (si_x0[k] + si_x1[k]) * 0.5;
        ga_y1 = (si_y0[k] + si_y1[k]) * 0.5;
        return true
    }
    if (dw_is("fact") && do_word()) {
        k: int = dw_num();
        if (k >= bf_n) return false;
        ga_x1 = bf_x0[k] + 60.0;
        ga_y1 = (bf_y0[k] + bf_y1[k]) * 0.5;
        if (bfn_ok[k]) {
            ga_x1 = (bfn_x0[k] + bfn_x1[k]) * 0.5;
            ga_y1 = (bfn_y0[k] + bfn_y1[k]) * 0.5
        }
        return true
    }
    false
}

// The goal's part shown as the next word: its middle.
dw_part(): bool {
    if (!do_word()) return false;
    n: int = play_node();
    if (n < 0) return false;
    if (!find_part_text(gl_concl[pn_goal[n]], sym_of(do_buf, dw_a, dw_b))) {
        line_clear();
        line_add("L8_DO: no such part: ");
        line_sym(sym_of(do_buf, dw_a, dw_b));
        line_add(" in ");
        show_line(gl_concl[pn_goal[n]]);
        line_print_safe();
        return false
    }
    gf_n = fp_n;
    for i in 0..fp_n gf_steps[i] = fp_steps[i];
    if (part_at()) return true;
    do_say("the part is not on the board");
    false
}

// Each frame: the step going on, or the next begun. Whether L8_DO is
// still going.
do_step_go() raises KernelError: bool {
    if (do_n == 0 || do_next > do_n) return false;
    if (pp_on && !wp_on) {
        if (pp_step()) do_free_t = now_t + env_int("L8_DO_GAP", 90) as f32 / 100.0;
        return true
    }
    if (do_next >= do_n) return false;
    if (now_t < do_free_t) return true;
    // (A gesture by script is the player's: a demo playing stops.)
    demo_interrupt();
    if (wp_on) return true;
    stop: int = env_int("L8_DO_STOP", 0);
    k: int = do_next;
    do_next = k + 1;
    if (stop > 0 && k >= stop) {
        do_next = do_n + 1;
        return true
    }
    hold: bool = stop == k + 1;
    dw_at = do_s0[k];
    dw_end = do_s1[k];
    do_free_t = now_t + env_int("L8_DO_GAP", 90) as f32 / 100.0;
    ms: f32 = env_int("L8_DO_MS", 600) as f32;
    if (!do_word()) return true;
    if (dw_is("undo")) {
        demo_interrupt();
        if (ps_on) ps_cancel() else undo_move()
    } else if (dw_is("hint")) key_press(104) else if (dw_is("enter")) key_press(65293) else if (dw_is("wait")) { } else if (dw_is("open")) {
        if (!do_word()) return true;
        x: f32 = -1.0;
        y: f32 = 0.0;
        if (dw_is("goal") && gk_ok) {
            x = (gk_x0 + gk_x1) * 0.5;
            y = (gk_y0 + gk_y1) * 0.5
        } else if (dw_is("fact") && do_word()) {
            j: int = dw_num();
            if (j < bf_n && bfk_ok[j]) {
                x = (bfk_x0[j] + bfk_x1[j]) * 0.5;
                y = (bfk_y0[j] + bfk_y1[j]) * 0.5
            }
        }
        if (x < 0.0) {
            do_say("no such key");
            return true
        }
        do_tap(x, y, hold)
    } else if (dw_is("tap")) {
        if (!do_tap_at()) {
            do_say("tap token N | fact K [face L] | rule K face L | lemma K | kit K | part \"T\" | goal | notch goal | notch fact K");
            return true
        }
        do_tap(ga_x0, ga_y0, hold)
    } else if (dw_is("token") || dw_is("fill")) {
        fill: bool = dw_is("fill");
        if (!do_word()) return true;
        t: int = dw_token();
        if (t < 0) {
            do_say("no such name on the shelf");
            return true
        }
        ga_x0 = shn_x[t];
        ga_y0 = shn_y[t];
        if (fill) {
            ga_x1 = goal_rx + goal_rw * 0.5;
            ga_y1 = goal_ry + goal_rh * 0.5
        } else if (!do_word() || !dw_is(">") || !dw_place()) {
            do_say("token N > goal, > fact K, > kit K");
            return true
        }
        pp_carry(ga_x0, ga_y0, ga_x1, ga_y1, ms, hold, false)
    } else if (dw_is("fact") || dw_is("rule") || dw_is("lemma")) {
        what_fact: bool = dw_is("fact");
        what_rule: bool = dw_is("rule");
        if (!do_word()) return true;
        j: int = dw_num();
        face: int = -1;
        if (!do_word()) return true;
        if (dw_is("face") && do_word()) {
            face = dw_num();
            if (!do_word()) return true
        }
        if (what_fact) {
            if (j >= bf_n) {
                do_say("no such fact");
                return true
            }
            ga_x0 = bf_x0[j] + minf(60.0, (bf_x1[j] - bf_x0[j]) * 0.3);
            ga_y0 = (bf_y0[j] + bf_y1[j]) * 0.5;
            if (face >= 0 && bf_seam[j] > 0.0) {
                ga_x0 = (bf_x0[j] + bf_seam[j]) * 0.5;
                if (face == 1) ga_x0 = (bf_seam[j] + bf_x1[j]) * 0.5
            }
        } else {
            kind: int = SI_LEMMA;
            if (what_rule) kind = SI_RULE;
            it: int = dw_item(kind, j);
            if (it < 0) {
                do_say("no such tile");
                return true
            }
            ga_x0 = (si_x0[it] + si_x1[it]) * 0.5;
            ga_y0 = (si_y0[it] + si_y1[it]) * 0.5;
            if (what_rule) {
                ga_x0 = si_x0[it] + si_seam[it] * 0.5;
                if (face == 1) ga_x0 = (si_x0[it] + si_seam[it] + si_x1[it]) * 0.5
            }
        }
        if (!dw_is(">") || !dw_place()) {
            do_say("fact K > goal; rule K face L > part \"T\"");
            return true
        }
        pp_carry(ga_x0, ga_y0, ga_x1, ga_y1, ms, hold, false)
    } else if (bb_on() && bb_do_step(ms, hold)) { } else if (dw_is("flip") || dw_is("suppose")) {
        kind: int = GS_FLIP;
        if (dw_is("suppose")) kind = GS_SUPPOSE;
        if (gesture_at(kind, -1, 0)) pp_carry(ga_x0, ga_y0, ga_x1, ga_y1, ms, hold,
            false)
    } else do_say("no such step");
    true
}

// The place a tap step names (after "tap"), into (ga_x0, ga_y0).
do_tap_at(): bool {
    if (!do_word()) return false;
    if (bb_on()) return bb_do_tap_at();
    if (dw_is("token")) {
        if (!do_word()) return false;
        t: int = dw_token();
        if (t < 0) return false;
        ga_x0 = shn_x[t];
        ga_y0 = shn_y[t];
        return true
    }
    if (dw_is("goal")) {
        // (Its edge, clear of its parts: the whole goal.)
        ga_x0 = goal_rx + 8.0;
        ga_y0 = goal_ry + goal_rh * 0.5;
        return true
    }
    if (dw_is("part")) {
        if (!dw_part()) return false;
        part_tap_point(ga_b);
        return true
    }
    if (dw_is("notch")) {
        if (!do_word()) return false;
        if (dw_is("goal") && gn_ok) {
            ga_x0 = (gn_x0 + gn_x1) * 0.5;
            ga_y0 = (gn_y0 + gn_y1) * 0.5;
            return true
        }
        if (dw_is("fact") && do_word()) {
            k: int = dw_num();
            if (k >= bf_n || k >= BF || !bfn_ok[k]) return false;
            ga_x0 = (bfn_x0[k] + bfn_x1[k]) * 0.5;
            ga_y0 = (bfn_y0[k] + bfn_y1[k]) * 0.5;
            return true
        }
        return false
    }
    if (dw_is("fact")) {
        if (!do_word()) return false;
        j: int = dw_num();
        if (j >= bf_n) return false;
        ga_x0 = bf_x1[j] - 24.0;
        ga_y0 = (bf_y0[j] + bf_y1[j]) * 0.5;
        save: int = dw_at;
        if (do_word() && dw_is("face") && do_word() && bf_seam[j] > 0.0) {
            ga_x0 = (bf_x0[j] + bf_seam[j]) * 0.5;
            if (dw_num() == 1) ga_x0 = (bf_seam[j] + bf_x1[j]) * 0.5
        } else dw_at = save;
        return true
    }
    kind: int = -1;
    if (dw_is("rule")) kind = SI_RULE;
    if (dw_is("lemma")) kind = SI_LEMMA;
    if (dw_is("kit")) kind = SI_KIT;
    if (kind < 0 || !do_word()) return false;
    it: int = dw_item(kind, dw_num());
    if (it < 0) return false;
    ga_x0 = (si_x0[it] + si_x1[it]) * 0.5;
    ga_y0 = (si_y0[it] + si_y1[it]) * 0.5;
    if (kind == SI_RULE) {
        ga_x0 = si_x0[it] + si_seam[it] * 0.5;
        save: int = dw_at;
        if (do_word() && dw_is("face") && do_word()) {
            if (dw_num() == 1) ga_x0 = (si_x0[it] + si_seam[it] + si_x1[it]) * 0.5
        } else dw_at = save
    }
    true
}

do_tap(x: f32, y: f32, hold: bool) {
    pp_tap(x, y, false);
    if (hold) pp_hold = true
}

do_say(why: str) {
    line_clear();
    line_add("L8_DO: ");
    line_add(why);
    line_print_safe()
}
