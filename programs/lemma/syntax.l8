tag lemma;

use_tag std;

// What the theory files say about how things are written: their tokens,
// the notations that turn tokens into constants, and the names in scope
// (the logic's constants, a subject's fixed symbols, Pure's own). The
// reader (read.l8) and the printer (show.l8) both go by these tables, so a
// subject brings its own notation with it.
//
// ---- notations ----
const N_INFIXL: int = 1;

const N_INFIXR: int = 2;

const N_INFIX: int = 3;

const N_PREFIX: int = 4;

const N_POSTFIX: int = 5;

const N_BINDER: int = 6;

// |x|: written between two tokens.
const N_OUTFIX: int = 7;

// Not written at all (Tr P is shown as P).
const N_HIDDEN: int = 8;

// An infix written with its sides swapped (a > b is b < a).
const N_FLIP: int = 9;

// Written below the line after its argument, as aₙ for a(n).
const N_SUBSCRIPT: int = 10;

const NOTES: int = 512;

nt_tok: []int = new int[NOTES](0);

nt_tok2: []int = new int[NOTES](0);

nt_kind: []int = new int[NOTES](0);

nt_prec: []int = new int[NOTES](0);

// The name of the constant or fixed symbol a notation stands for.
nt_name: []int = new int[NOTES](0);

nt_n: int = 0;

add_notation(
    kind: int,
    prec: int,
    tok: int,
    tok2: int,
    name: int
) {
    if (nt_n >= NOTES) return;
    nt_kind[nt_n] = kind;
    nt_prec[nt_n] = prec;
    nt_tok[nt_n] = tok;
    nt_tok2[nt_n] = tok2;
    nt_name[nt_n] = name;
    nt_n = nt_n + 1;
    if (tok != 0) add_token(tok);
    if (tok2 != 0) add_token(tok2)
}

// The notation a token starts, of these kinds (a mask of 1 << kind), or -1.
note_for_tok(tok: int, kinds: int): int {
    i: int = nt_n - 1;
    while (i >= 0) {
        if (nt_tok[i] == tok && (kinds >> nt_kind[i] & 1) != 0) return i;
        i = i - 1
    }
    -1
}

// The notation for printing a name (not a flipped one), or -1.
note_for_name(name: int): int {
    i: int = nt_n - 1;
    while (i >= 0) {
        if (nt_name[i] == name && nt_kind[i] != N_FLIP) return i;
        i = i - 1
    }
    -1
}

note_flip_for_name(name: int): int {
    i: int = nt_n - 1;
    while (i >= 0) {
        if (nt_name[i] == name && nt_kind[i] == N_FLIP) return i;
        i = i - 1
    }
    -1
}

// ---- tokens that are not names ----
const TOKS: int = 512;

tok_list: []int = new int[TOKS](0);

tok_n: int = 0;

add_token(t: int) {
    for i in 0..tok_n {
        if (tok_list[i] == t) return
    }
    if (tok_n < TOKS) {
        tok_list[tok_n] = t;
        tok_n = tok_n + 1
    }
}

// ---- roles: which constant plays which part in the logic ----
const ROLE_TRUE: int = 0;

const ROLE_IMP: int = 1;

const ROLE_CONJ: int = 2;

const ROLE_DISJ: int = 3;

const ROLE_NOT: int = 4;

const ROLE_ALL: int = 5;

const ROLE_EX: int = 6;

const ROLE_EQ: int = 7;

const ROLE_FALSE: int = 8;

const ROLE_IFF: int = 9;

const ROLES: int = 10;

role_name: []int = new int[ROLES](0);

role_names: []str = ["Trueprop", "imp", "conj", "disj", "not", "all", "ex", "eq",
    "false", "iff"];

// ---- names in scope ----
const E_CONST: int = 1;

// A subject's fixed symbol: a free variable, assumed things about.
const E_FIX: int = 2;

const E_TYPE: int = 3;

// A type variable fixed by a subject.
const E_TFREE: int = 4;

const ENTS: int = 4096;

ent_name: []int = new int[ENTS](0);

ent_kind: []int = new int[ENTS](0);

// Its type (a type scheme, for a constant: its type variables are
// instantiated afresh at each use); a type's type.
ent_ty: []int = new int[ENTS](0);

// A fixed symbol's free variable.
ent_term: []int = new int[ENTS](0);

ent_n: int = 0;

add_ent(
    name: int,
    kind: int,
    ty: int,
    term: int
): int {
    if (ent_n >= ENTS) return -1;
    ent_name[ent_n] = name;
    ent_kind[ent_n] = kind;
    ent_ty[ent_n] = ty;
    ent_term[ent_n] = term;
    ent_n = ent_n + 1;
    ent_n - 1
}

// The latest name in scope of one of these kinds (a mask of 1 << kind), or -1.
find_ent(name: int, kinds: int): int {
    i: int = ent_n - 1;
    while (i >= 0) {
        if (ent_name[i] == name && (kinds >> ent_kind[i] & 1) != 0) return i;
        i = i - 1
    }
    -1
}

// ---- reading text ----
// The text being read, where the reader is in it, and the line.
src: []i8 = new i8[1](0i8);

src_n: int = 0;

src_at: int = 0;

src_line: int = 1;

src_file: str = "";

const K_EOF: int = 0;

const K_NAME: int = 1;

const K_SYM: int = 2;

const K_STRING: int = 3;

// The token looked at: its kind, its name (its text as a symbol), where
// it starts, and whether it begins a line.
tk_kind: int = K_EOF;

tk_sym: int = 0;

tk_from: int = 0;

tk_to: int = 0;

tk_bol: bool = false;

tk_line: int = 1;

// A code point from UTF-8 at i, and how many bytes it takes (in cp_len).
cp_len: int = 1;

cp_at(t: []i8, i: int, n: int): int {
    c: int = t[i] as int;
    cp_len = 1;
    if (c < 128) return c;
    if (c >= 240 && i + 3 < n) {
        cp_len = 4;
        return (c & 7) << 18 | (t[i + 1] as int & 63) << 12 | (t[i + 2] as int & 63) << 6 | t[i + 3] as int & 63
    }
    if (c >= 224 && i + 2 < n) {
        cp_len = 3;
        return (c & 15) << 12 | (t[i + 1] as int & 63) << 6 | t[i + 2] as int & 63
    }
    if (c >= 192 && i + 1 < n) {
        cp_len = 2;
        return (c & 31) << 6 | t[i + 1] as int & 63
    }
    c
}

// Letters a name can start with: ASCII ones, Greek, script and blackboard
// capitals (ℝ, ℕ), and the digits (a numeral is a name too: 0, 1, 2).
name_start_cp(c: int): bool {
    c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c >= 48 && c <= 57 || c >= 880 && c <= 1023 && c != 955 || c == 8477 || c == 8469 || c == 8484 || c == 8474 || c == 8450
}

// And those that go on one: also primes and subscript digits.
name_more_cp(c: int): bool {
    name_start_cp(c) || c == 39 || c >= 8320 && c <= 8329 || c == 8242
}

is_digit_byte(c: int): bool {
    c >= 48 && c <= 57
}

// Whether the source at i starts with name t.
src_has(i: int, t: int): bool {
    n: int = sym_len[t];
    if (i + n > src_n) return false;
    for j in 0..n {
        if (src[i + j] as int != sym_byte(t, j)) return false
    }
    true
}

skip_space() {
    more: bool = true;
    while (more && src_at < src_n) {
        c: int = src[src_at] as int;
        if (c == 10) {
            src_line = src_line + 1;
            src_at = src_at + 1
        } else if (c == 32 || c == 9 || c == 13) src_at = src_at + 1 else if (c == 35) {
            while (src_at < src_n && src[src_at] as int != 10) src_at = src_at + 1
        } else more = false
    }
}

// The next token, into tk_*.
lex() {
    skip_space();
    tk_line = src_line;
    tk_from = src_at;
    tk_bol = src_at == 0 || src[src_at - 1] as int == 10;
    if (src_at >= src_n) {
        tk_kind = K_EOF;
        tk_sym = 0;
        tk_to = src_at;
        return
    }
    c: int = cp_at(src, src_at, src_n);
    if (c == 34) {
        i: int = src_at + 1;
        while (i < src_n && src[i] as int != 34 && src[i] as int != 10) i = i + 1;
        tk_kind = K_STRING;
        tk_sym = sym_of(src, src_at + 1, i);
        if (i < src_n && src[i] as int == 34) i = i + 1;
        src_at = i;
        tk_to = i;
        return
    }
    // (The longest token that is declared, if any is here.)
    best: int = 0;
    for k in 0..tok_n {
        t: int = tok_list[k];
        if (sym_len[t] > sym_len[best] && src_has(src_at, t)) best = t
    }
    if (name_start_cp(c)) {
        i: int = src_at;
        more: bool = true;
        digits: bool = is_digit_byte(c);
        while (more && i < src_n) {
            d: int = cp_at(src, i, src_n);
            if (digits && !is_digit_byte(d) || !digits && !name_more_cp(d)) more = false else i = i + cp_len
        }
        if (i - src_at >= sym_len[best]) {
            tk_kind = K_NAME;
            tk_sym = sym_of(src, src_at, i);
            src_at = i;
            tk_to = i;
            return
        }
    }
    if (best != 0) {
        tk_kind = K_SYM;
        tk_sym = best;
        src_at = src_at + sym_len[best];
        tk_to = src_at;
        return
    }
    // (Any other character is a token by itself.)
    cp_at(src, src_at, src_n);
    tk_kind = K_SYM;
    tk_sym = sym_of(src, src_at, src_at + cp_len);
    src_at = src_at + cp_len;
    tk_to = src_at
}

// Read from t, n bytes of it.
read_from(t: []i8@immortal, n: int) {
    src = t;
    src_n = n;
    src_at = 0;
    src_line = 1;
    lex()
}

// Whether the token is this text.
tk_is(t: str): bool {
    tk_sym == sym(t)
}
