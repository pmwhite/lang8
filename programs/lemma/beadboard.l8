tag lemma_ui;

use_tag std, skate, lemma;

// The Groups chapter's board: beads and a tile (beads.l8 makes the moves).
//
// Beads. The goal is two strings of beads on cords, one above the other;
// the level is won when they are the same string. A bead is a name's
// color with its letter; turned over, the same color, pale, its letter
// seen from behind. The facts are stamps: cards with two short strings
// and a seam between them; X on a stamp is any beads at all. The shelf
// holds each name's bead both ways up. Two taps, either first (or a
// drag), bring things together:
//
//   a bead, then its twin beside it        the pair pops
//   a bead, then the one beside it         the stretch grows (held)
//   a stretch (or a bead), a stamp's face  the stretch becomes the other face
//   a shelf bead, a gap                    it and its twin come out there
//   a stamp's empty face, a gap            its other face comes out there
//                                            (X wanted: a shelf bead then)
//   the strings swiped sideways            both turned round
//
// A bead dragged along its string pinches the beads it passes (a twin pair
// pinched pops); a stamp's face or a shelf bead dragged rides above the
// finger to where it goes. While a partner is pressed, or a thing hovers
// where it fits, a card away from the finger shows what the strings would
// become.
//
// The tile. A square tile with a flag on it, its shadow (where it must
// get to), and a slot for each move the level asks for. Tap the tile: a
// quarter turn; swipe it sideways: flipped over. Above, the map of where
// the tile has been: the places it can be, found as it goes there, the
// roads it took, the shadow's place ringed.

// ---- which board ----
bb_key: int = -1;

bb_m: int = 0;

bb_mode(): int {
    if (cur_level < 0 || loaded_region < 0) return BM_NONE;
    k: int = loaded_region * 1000 + cur_level;
    if (k != bb_key) {
        bb_key = k;
        bb_m = bd_mode_of(cur_level)
    }
    bb_m
}

bb_on(): bool {
    lang_on() && bb_mode() != BM_NONE
}

bb_walk(): bool {
    lang_on() && bb_mode() == BM_WALK
}

// The node the board shows: the goal worked on; finished, the last.
bb_node(): int {
    n: int = play_node();
    if (n >= 0) return n;
    if (pn_n == 0) return -1;
    k: int = root;
    while (pn_move[k] >= 0 && pn_kidn[k] > 0) k = node_kid(k, pn_kidn[k] - 1);
    k
}

// ---- colors ----
bb_color(atom: int): int {
    bb_color_n(tm_name(atom))
}

bb_color_n(s: int): int {
    if (s == sym("a")) return 4157365;
    if (s == sym("b")) return 13654076;
    if (s == sym("c")) return 4098650;
    if (s == sym("f")) return 9067440;
    if (s == sym("d")) return 14260779;
    6197148
}

// ---- a bead ----
// Bead `atom` at (cx, cy), radius r, turned over or not; sx and sy stretch
// it (sx < 0: seen from the other side, as it turns over), a how much it
// shows. A name's letter on it, white; turned over, its color, mirrored.
bb_bead(
    cx: f32,
    cy: f32,
    r: f32,
    atom: int,
    back0: bool,
    sx: f32,
    sy: f32,
    a: f32,
    lift: f32
) {
    bb_bead_n(cx, cy, r, tm_name(atom), back0, sx, sy, a, lift)
}

// The same, for a name (a symbol).
bb_bead_n(
    cx: f32,
    cy: f32,
    r: f32,
    name: int,
    back0: bool,
    sx: f32,
    sy: f32,
    a: f32,
    lift: f32
) {
    if (a <= 0.0) return;
    back: bool = back0;
    if (sx < 0.0) back = !back;
    ax: f32 = absf(sx);
    col: int = bb_color_n(name);
    is_x: bool = name == sym("X");
    p_shadow(cx - r * ax, cy - r * sy, 2.0 * r * ax, 2.0 * r * sy, r, 2.0 + lift * 2.0,
        5.0 + lift * 4.0, (0.16 + lift * 0.06) * a);
    line_clear();
    line_sym(name);
    if (is_x) {
        // (X: any beads at all; a hollow bead.)
        fill: int = C_SUNK;
        if (back) fill = mix_rgb(C_SUNK, C_WHITE, 0.5);
        p_box_xf(cx, cy, 2.0 * r, 2.0 * r, r, 0.0, ax, 0.0, 0.0, sy, fill, a);
        p_box_xf(cx, cy, 2.0 * r, 2.0 * r, r, 2.0, ax, 0.0, 0.0, sy, C_MUTED, a);
        m: f32 = ax;
        if (back) m = -ax;
        p_text_xf(1, r * 1.0, cx, cy, line, 0, line_n, m, 0.0, 0.0, sy, C_MUTED, a);
        return
    }
    if (!back) {
        p_box_xf(cx, cy, 2.0 * r, 2.0 * r, r, 0.0, ax, 0.0, 0.0, sy, col, a);
        // (A shine, up and to its left.)
        p_box_xf(cx - r * 0.34 * ax, cy - r * 0.5 * sy, r * 0.62, r * 0.3, r * 0.15,
            0.0, ax, 0.0, 0.0, sy, C_WHITE, 0.16 * a);
        p_text_xf(1, r * 1.08, cx, cy, line, 0, line_n, ax, 0.0, 0.0, sy, C_WHITE,
            a);
        return
    }
    // (Turned over: its other face, the colors the other way about: pale,
    // a rim and the letter in its color; the shine low on the other side.)
    p_box_xf(cx, cy, 2.0 * r, 2.0 * r, r, 0.0, ax, 0.0, 0.0, sy, mix_rgb(col, C_WHITE,
        0.8), a);
    p_box_xf(cx, cy, 2.0 * r, 2.0 * r, r, r * 0.16, ax, 0.0, 0.0, sy, col, a);
    p_box_xf(cx + r * 0.34 * ax, cy + r * 0.5 * sy, r * 0.62, r * 0.3, r * 0.15, 0.0,
        ax, 0.0, 0.0, sy, col, 0.1 * a);
    p_text_xf(1, r * 1.08, cx, cy, line, 0, line_n, ax, 0.0, 0.0, sy, col, a)
}

// A place for nothing: a small dent (an empty face, an empty string).
bb_dent(
    cx: f32,
    cy: f32,
    r: f32,
    a: f32
) {
    p_box(cx - r * 1.1, cy - r * 0.62, r * 2.2, r * 1.24, r * 0.62, mix_rgb(C_SUNK,
        C_LINE, 0.3), a);
    p_box(cx - r * 1.0, cy - r * 0.56, r * 2.0, r * 0.4, r * 0.3, C_SHADOW, 0.05 * a)
}

// ---- the goal's strings, laid out ----
// Each side's beads (sides 0 the top, 1 the bottom): name, turned over,
// where drawn (gx), and its visible bead (its id); and the gaps.
const GB: int = 48;

gb_atom: []int = new int[2 * GB](0);

gb_flip: []bool = new bool[2 * GB](false);

gb_x: []f32 = new f32[2 * GB](0.0);

gb_n: []int = new int[2](0);

gb_row: []f32 = new f32[2](0.0);

// Bead radius and spacing in the goal now.
gb_r: f32 = 26.0;

gb_sp: f32 = 60.0;

gb_cx: f32 = 0.0;

// The goal card.
gc_x: f32 = 0.0;

gc_y: f32 = 0.0;

gc_w: f32 = 0.0;

gc_h: f32 = 0.0;

// The beads of side `side` of term concl, into gs_.
bb_read_side(concl: int, side: int) {
    bs_n = 0;
    st: int = bd_side_term(concl, side);
    if (st != 0) bd_flatten(st, false);
    k: int = mini(bs_n, GB);
    gb_n[side] = k;
    for i in 0..k {
        gb_atom[side * GB + i] = bs_atom[i];
        gb_flip[side * GB + i] = bs_flip[i]
    }
}

// Where bead i of a string of n is (its middle), spaced sp about cx.
bb_bead_x(
    cx: f32,
    sp: f32,
    n: int,
    i: int
): f32 {
    cx + (i as f32 - (n as f32 - 1.0) * 0.5) * sp
}

// Where gap i is (before bead i; n: after the last).
bb_gap_x(side: int, i: int): f32 {
    n: int = gb_n[side];
    if (n == 0) return gb_cx;
    if (i <= 0) return gb_x[side * GB] - gb_sp * 0.5;
    if (i >= n) return gb_x[side * GB + n - 1] + gb_sp * 0.5;
    (gb_x[side * GB + i - 1] + gb_x[side * GB + i]) * 0.5
}

// ---- the beads drawn: each kept, sliding to its place ----
const VB: int = 128;

vb_used: []bool = new bool[VB](false);

vb_atom: []int = new int[VB](0);

vb_back: []bool = new bool[VB](false);

vb_x: []f32 = new f32[VB](0.0);

vb_vx: []f32 = new f32[VB](0.0);

vb_y: []f32 = new f32[VB](0.0);

vb_vy: []f32 = new f32[VB](0.0);

vb_s: []f32 = new f32[VB](0.0);

vb_vs: []f32 = new f32[VB](0.0);

// When it left (it squishes away), or -1; when it began turning over.
vb_gone: []f32 = new f32[VB](-1.0);

vb_turn: []f32 = new f32[VB](-10.0);

// Each side's beads shown, as ids, and what they were.
sv_id: []int = new int[2 * GB](0);

sv_atom: []int = new int[2 * GB](0);

sv_flip: []bool = new bool[2 * GB](false);

svb_n: []int = new int[2](-1);

vb_new(
    atom: int,
    back: bool,
    x: f32,
    y: f32
): int {
    for i in 0..VB {
        if (!vb_used[i]) {
            vb_used[i] = true;
            vb_atom[i] = atom;
            vb_back[i] = back;
            vb_x[i] = x;
            vb_y[i] = y;
            vb_vx[i] = 0.0;
            vb_vy[i] = 0.0;
            vb_s[i] = 0.0;
            vb_vs[i] = 0.0;
            vb_gone[i] = -1.0;
            vb_turn[i] = -10.0;
            return i
        }
    }
    0
}

bb_clear() {
    for i in 0..VB vb_used[i] = false;
    svb_n[0] = -1;
    svb_n[1] = -1
}

const BEAD_GONE: f32 = 0.24;

const BEAD_TURN: f32 = 0.42;

// The beads of side `side` (as gs_ has them now) against those shown:
// the same ones kept, the ones in between that left squish away, new ones
// swell in; a string turned round is the same beads turning over.
bb_sync(side: int) {
    n: int = gb_n[side];
    o: int = svb_n[side];
    b: int = side * GB;
    if (o < 0 || an_jump) {
        for i in 0..n {
            id: int = vb_new(gb_atom[b + i], gb_flip[b + i], gb_x[b + i], gb_row[side]);
            vb_s[id] = 1.0;
            sv_id[b + i] = id
        }
        bb_sv_keep(side);
        return
    }
    same: bool = o == n;
    turned: bool = o == n && n > 1;
    for i in 0..n {
        if (o == n) {
            if (sv_atom[b + i] != gb_atom[b + i] || sv_flip[b + i] != gb_flip[b + i]) same = false;
            j: int = n - 1 - i;
            if (sv_atom[b + j] != gb_atom[b + i] || sv_flip[b + j] == gb_flip[b + i]) turned = false
        }
    }
    if (same) return;
    if (n == 1 && o == 1 && sv_atom[b] == gb_atom[b]) turned = true;
    if (turned) {
        // (The same beads, mirrored: each to the other end, turning over.)
        for i in 0..n tmp_id[i] = sv_id[b + n - 1 - i];
        for i in 0..n {
            id: int = tmp_id[i];
            sv_id[b + i] = id;
            vb_back[id] = gb_flip[b + i];
            vb_turn[id] = now_t
        }
        bb_sv_keep(side);
        return
    }
    // (What is the same at each end stays; the middle is new.)
    p: int = 0;
    while (p < n && p < o && sv_atom[b + p] == gb_atom[b + p] && sv_flip[b + p] == gb_flip[b + p]) p = p + 1;
    q: int = 0;
    while (q < n - p && q < o - p && sv_atom[b + o - 1 - q] == gb_atom[b + n - 1 - q] && sv_flip[b + o - 1 - q] == gb_flip[b + n - 1 - q]) q = q + 1;
    for i in 0..n {
        if (i < p) tmp_id[i] = sv_id[b + i] else if (i >= n - q) tmp_id[i] = sv_id[b + o - (n - i)] else {
            // (New: swelling in where it goes, out of the gap.)
            id: int = vb_new(gb_atom[b + i], gb_flip[b + i], gb_x[b + i], gb_row[side]);
            tmp_id[i] = id
        }
    }
    for i in p..o - q vb_gone[sv_id[b + i]] = now_t;
    for i in 0..n sv_id[b + i] = tmp_id[i];
    bb_sv_keep(side)
}

tmp_id: []int = new int[GB](0);

bb_sv_keep(side: int) {
    b: int = side * GB;
    svb_n[side] = gb_n[side];
    for i in 0..gb_n[side] {
        sv_atom[b + i] = gb_atom[b + i];
        sv_flip[b + i] = gb_flip[b + i]
    }
}

// Each bead shown, eased to where it goes, and drawn.
bb_draw_vbeads(lift_side: int, lift_i: int, lift_k: int) {
    for side in 0..2 {
        b: int = side * GB;
        for i in 0..gb_n[side] {
            id: int = sv_id[b + i];
            tx: f32 = gb_x[b + i];
            ty: f32 = gb_row[side];
            held: bool = side == lift_side && i >= lift_i && i < lift_i + lift_k;
            if (held) ty = ty - 4.0;
            if (an_jump) {
                vb_x[id] = tx;
                vb_y[id] = ty;
                vb_s[id] = 1.0
            }
            vb_x[id] = spring(vb_x[id], vb_vx[id], tx, 260.0, 19.0);
            vb_vx[id] = spring_v;
            vb_y[id] = spring(vb_y[id], vb_vy[id], ty, 260.0, 19.0);
            vb_vy[id] = spring_v;
            vb_s[id] = spring(vb_s[id], vb_vs[id], 1.0, 240.0, 15.0);
            vb_vs[id] = spring_v;
            vb_atom[id] = gb_atom[b + i]
        }
    }
    for id in 0..VB {
        if (vb_used[id]) {
            sx: f32 = vb_s[id];
            sy: f32 = vb_s[id];
            a: f32 = clampf(vb_s[id] * 1.5, 0.0, 1.0);
            if (vb_gone[id] >= 0.0) {
                // (Popped: a soft squish, wider and lower, and gone.)
                t: f32 = (now_t - vb_gone[id]) / BEAD_GONE;
                if (t >= 1.0) {
                    vb_used[id] = false;
                    a = 0.0
                } else {
                    busy = true;
                    sx = 1.0 + 0.3 * t;
                    sy = 1.0 - 0.55 * t;
                    a = 1.0 - t * t
                }
            }
            tt: f32 = (now_t - vb_turn[id]) / BEAD_TURN;
            back: bool = vb_back[id];
            if (tt >= 0.0 && tt < 1.0) {
                // (Turning over: the old face narrows, the new one widens.)
                busy = true;
                c: f32 = cosf(tt * 3.14159);
                sx = sx * absf(c);
                if (c > 0.0) back = !back
            }
            if (a > 0.0) bb_bead(vb_x[id], vb_y[id], gb_r, vb_atom[id], back, sx,
                sy, a, 0.0)
        }
    }
}

// ---- the stamps ----
// Each fact a stamp: its card, and each face's beads (ss_), laid out.
const SM: int = 8;

st_n2: int = 0;

stp_hyp: []int = new int[SM](0);

st_x0: []f32 = new f32[SM](0.0);

st_y0: []f32 = new f32[SM](0.0);

st_x1: []f32 = new f32[SM](0.0);

st_y1: []f32 = new f32[SM](0.0);

st_seam: []f32 = new f32[SM](0.0);

// Each face's string: from ss0[j * 2 + f], ssn of them, in ss_atom.
ss_atom: []int = new int[256](0);

ss_flip: []bool = new bool[256](false);

ss_x: []f32 = new f32[256](0.0);

ss0: []int = new int[2 * SM](0);

ssn: []int = new int[2 * SM](0);

st_r: f32 = 15.0;

// The stamps of node n, read and laid out from y; how tall they are.
bb_stamps_layout(
    n: int,
    x: f32,
    w: f32,
    y: f32
): f32 {
    st_n2 = 0;
    if (n < 0) return 0.0;
    g: int = pn_goal[n];
    used: int = 0;
    yy: f32 = y;
    r: f32 = st_r;
    sp: f32 = 2.0 * r + 5.0;
    ch: f32 = 2.0 * r + 26.0;
    for j in 0..gl_hypn[g] {
        h: int = goal_hyp(g, j);
        ok: bool = false;
        try {
            ok = bd_is_stamp(h)
        } with KernelError -> {
            ok = false
        }
        if (ok && st_n2 < SM) {
            k: int = st_n2;
            stp_hyp[k] = j;
            fw: []f32 = face_w;
            for f in 0..2 {
                ok2: bool = false;
                try {
                    ok2 = bd_face_string(h, f)
                } with KernelError -> {
                    ok2 = false
                }
                ss0[k * 2 + f] = used;
                ssn[k * 2 + f] = 0;
                if (ok2) {
                    for i in 0..pf_n {
                        if (used < len(ss_atom)) {
                            ss_atom[used] = pf_atom[i];
                            ss_flip[used] = pf_flip[i];
                            used = used + 1
                        }
                    }
                    ssn[k * 2 + f] = used - ss0[k * 2 + f]
                }
                fw[f] = maxf(ssn[k * 2 + f] as f32, 1.0) * sp + 26.0
            }
            cw: f32 = fw[0] + fw[1];
            cx0: f32 = x + w * 0.5 - cw * 0.5;
            st_x0[k] = cx0;
            st_x1[k] = cx0 + cw;
            st_y0[k] = yy;
            st_y1[k] = yy + ch;
            st_seam[k] = cx0 + fw[0];
            for f in 0..2 {
                n2: int = ssn[k * 2 + f];
                fx0: f32 = cx0;
                if (f == 1) fx0 = st_seam[k];
                mid: f32 = fx0 + fw[f] * 0.5;
                for i in 0..n2 ss_x[ss0[k * 2 + f] + i] = bb_bead_x(mid, sp, n2, i)
            }
            st_n2 = k + 1;
            yy = yy + ch + 10.0
        }
    }
    yy - y
}

face_w: []f32 = new f32[2](0.0);

bb_draw_stamps(a: f32) {
    for k in 0..st_n2 {
        x0: f32 = st_x0[k];
        y0: f32 = st_y0[k];
        w: f32 = st_x1[k] - x0;
        h: f32 = st_y1[k] - y0;
        held: int = -1;
        if (bk_kind == BK_FACE && bk_j == stp_hyp[k]) held = bk_face;
        dragged: int = -1;
        if (bdg_on && bdg_kind == BK_FACE && bdg_j == stp_hyp[k]) dragged = bdg_face;
        lift: f32 = 0.0;
        if (held >= 0) lift = 3.0;
        p_shadow(x0, y0 - lift, w, h, 18.0, 2.0 + lift, 8.0, 0.1 * a);
        p_box(x0, y0 - lift, w, h, 18.0, C_BLUE_SOFT, a);
        // (The seam: a crease between the faces, a notch at each edge.)
        sx: f32 = st_seam[k];
        sc: int = mix_rgb(C_BLUE_SOFT, C_BLUE, 0.3);
        p_line(sx, y0 - lift + 9.0, sx, y0 - lift + h - 9.0, 1.5, sc, a);
        p_disc(sx, y0 - lift, 4.0, C_BG, a);
        p_disc(sx, y0 - lift + h, 4.0, C_BG, a);
        cy: f32 = y0 - lift + h * 0.5;
        for f in 0..2 {
            fa: f32 = a;
            if (f == dragged) fa = a * 0.25;
            n2: int = ssn[k * 2 + f];
            if (n2 == 0) {
                fx0: f32 = x0;
                fx1: f32 = sx;
                if (f == 1) {
                    fx0 = sx;
                    fx1 = x0 + w
                }
                bb_dent((fx0 + fx1) * 0.5, cy, st_r, fa)
            }
            for i in 0..n2 {
                q: int = ss0[k * 2 + f] + i;
                bb_bead(ss_x[q], cy, st_r, ss_atom[q], ss_flip[q], 1.0, 1.0, fa, 0.0)
            }
        }
        if (held >= 0) {
            hx0: f32 = x0;
            hx1: f32 = sx;
            if (held == 1) {
                hx0 = sx;
                hx1 = x0 + w
            }
            p_outline(hx0 - 2.0, y0 - lift - 2.0, hx1 - hx0 + 4.0, h + 4.0, 18.0,
                2.0, C_HOLD, 0.6 * a)
        }
    }
}

// ---- the shelf: each name's bead, both ways up ----
const SH: int = 16;

sh_n: int = 0;

sh_atom: []int = new int[SH](0);

sh_flip: []bool = new bool[SH](false);

sh_x: []f32 = new f32[SH](0.0);

sh_y: f32 = 0.0;

const SH_R: f32 = 20.0;

// The names of the level, as it fixes them (first met first).
bb_shelf_names() {
    sh_n = 0;
    if (pn_n == 0) return;
    g: int = pn_goal[root];
    for i in 0..gl_fixn[g] {
        t: int = goal_fix(g, i);
        if (bd_is_atom_type(t) && sh_n + 2 <= SH) {
            sh_atom[sh_n] = t;
            sh_flip[sh_n] = false;
            sh_atom[sh_n + 1] = t;
            sh_flip[sh_n + 1] = true;
            sh_n = sh_n + 2
        }
    }
}

// Whether a name is one of the beads' kind (the group's type).
bd_is_atom_type(t: int): bool {
    tm_type(t) == tm_type(bd_e)
}

bb_shelf_layout(x: f32, w: f32, y: f32) {
    sh_y = y;
    // (Pairs: a bead and its twin close, the pairs apart.)
    pw: f32 = 2.0 * SH_R * 2.0 + 6.0;
    np: int = sh_n / 2;
    tot: f32 = np as f32 * pw + (np as f32 - 1.0) * 26.0;
    x0: f32 = x + w * 0.5 - tot * 0.5;
    for p in 0..np {
        px: f32 = x0 + p as f32 * (pw + 26.0);
        sh_x[2 * p] = px + SH_R;
        sh_x[2 * p + 1] = px + pw - SH_R
    }
}

bb_draw_shelf(
    x: f32,
    w: f32,
    top: f32,
    a: f32
) {
    p_box(x - 12.0, top, w + 24.0, view_h() - top + 40.0, 26.0, mix_rgb(C_SUNK, C_BG,
        0.2), a);
    for i in 0..sh_n {
        held: bool = bk_kind == BK_SHELF && bk_shelf == i;
        dragged: bool = bdg_on && bdg_kind == BK_SHELF && bdg_shelf == i;
        y: f32 = sh_y;
        if (held) y = y - 3.0;
        ia: f32 = a;
        if (dragged) ia = a * 0.25;
        bb_bead(sh_x[i], y, SH_R, sh_atom[i], sh_flip[i], 1.0, 1.0, ia, 0.0);
        if (held) p_ring(sh_x[i], y, SH_R + 5.0, 2.0, C_HOLD, 0.6 * a)
    }
}

// The shelf bead that is term t (a name, or one turned over), or -1.
bb_shelf_of(t: int): int {
    for i in 0..sh_n {
        if (sh_flip[i] && bd_is_inv(t) && tm_arg(t) == sh_atom[i]) return i;
        if (!sh_flip[i] && t == sh_atom[i]) return i
    }
    -1
}

// Shelf bead i as a term.
bb_shelf_term(i: int): int {
    t: int = sh_atom[i];
    if (sh_flip[i]) {
        try {
            t = bd_mk_inv(t)
        } with KernelError -> {
            t = 0
        }
    }
    t
}

// ---- what a tap holds ----
const BK_NONE: int = 0;

const BK_STRETCH: int = 1;

const BK_GAP: int = 2;

const BK_FACE: int = 3;

const BK_SHELF: int = 4;

bk_kind: int = 0;

bk_side: int = 0;

bk_i: int = 0;

bk_k: int = 0;

bk_j: int = -1;

bk_face: int = 0;

bk_shelf: int = -1;

// (The goal it was held on: held things go when the goal changes.)
bk_goal: int = 0;

bk_clear() {
    bk_kind = BK_NONE;
    bpv_on = false
}

bk_set(kind: int) {
    bk_kind = kind;
    bk_goal = bb_goal_now();
    lh_on = false
}

bb_goal_now(): int {
    n: int = play_node();
    if (n < 0) return 0;
    gl_concl[pn_goal[n]]
}

bk_valid(): bool {
    bk_kind != BK_NONE && done_t < 0.0 && bk_goal == bb_goal_now()
}

// ---- a socket: a stamp's x still wanted (a shelf bead fills it) ----
bsk_on: bool = false;

bsk_j: int = -1;

bsk_face: int = 0;

bsk_side: int = 0;

bsk_i: int = 0;

bsk_goal: int = 0;

bsk_valid(): bool {
    bsk_on && done_t < 0.0 && bsk_goal == bb_goal_now()
}

// ---- what is under a finger ----
const BT_NONE: int = 0;

const BT_BEAD: int = 1;

const BT_GAP: int = 2;

const BT_FACE: int = 3;

const BT_SHELF: int = 4;

const BT_TILE: int = 5;

const BT_GOAL: int = 6;

bt_kind: int = 0;

bt_side: int = 0;

bt_i: int = 0;

bt_j: int = -1;

bt_face: int = 0;

bt_shelf: int = -1;

// What is at (x, y), into bt_. On a string: a bead, or the gap nearest
// (want 1: always a gap; 2: always a bead; 0: as near).
bb_target(x: f32, y: f32, want: int): bool {
    bt_kind = BT_NONE;
    if (bb_walk()) {
        if (x >= tl_x - tl_s * 0.5 - 8.0 && x <= tl_x + tl_s * 0.5 + 8.0 && y >= tl_y - tl_s * 0.5 - 8.0 && y <= tl_y + tl_s * 0.5 + 8.0) {
            bt_kind = BT_TILE;
            return true
        }
        if (y >= wv_top && y <= wv_bot) {
            bt_kind = BT_GOAL;
            return true
        }
        return false
    }
    for i in 0..sh_n {
        if (absf(x - sh_x[i]) <= SH_R + 6.0 && absf(y - sh_y) <= SH_R + 8.0) {
            bt_kind = BT_SHELF;
            bt_shelf = i;
            return true
        }
    }
    for k in 0..st_n2 {
        if (x >= st_x0[k] - 4.0 && x <= st_x1[k] + 4.0 && y >= st_y0[k] - 4.0 && y <= st_y1[k] + 4.0) {
            bt_kind = BT_FACE;
            bt_j = stp_hyp[k];
            bt_face = 0;
            if (x > st_seam[k]) bt_face = 1;
            return true
        }
    }
    if (x < gc_x || x > gc_x + gc_w || y < gc_y || y > gc_y + gc_h) return false;
    for side in 0..2 {
        if (absf(y - gb_row[side]) <= gb_r + 16.0) {
            bt_side = side;
            n: int = gb_n[side];
            b: int = side * GB;
            // (The gap: as many beads before it as are left of x.)
            gap: int = 0;
            for i in 0..n {
                if (gb_x[b + i] < x) gap = i + 1
            }
            near: int = -1;
            d: f32 = 100000.0;
            for i in 0..n {
                if (absf(x - gb_x[b + i]) < d) {
                    d = absf(x - gb_x[b + i]);
                    near = i
                }
            }
            if (n == 0 || want == 1 || want == 0 && d > gb_r * 0.78) {
                bt_kind = BT_GAP;
                bt_i = gap;
                return true
            }
            bt_kind = BT_BEAD;
            bt_i = near;
            return true
        }
    }
    bt_kind = BT_GOAL;
    true
}

// What a finger wants of a string, by what is held: a gap for a shelf bead
// or an empty face, a bead for a stretch or a face with beads.
bb_want(): int {
    if (bsk_valid()) return 0;
    if (!bk_valid()) return 0;
    if (bk_kind == BK_SHELF) return 1;
    if (bk_kind == BK_FACE) {
        if (bb_face_n(bk_j, bk_face) == 0) return 1;
        return 2
    }
    0
}

// How many beads face f of fact j shows.
bb_face_n(j: int, f: int): int {
    for k in 0..st_n2 {
        if (stp_hyp[k] == j) return ssn[k * 2 + f]
    }
    -1
}

// Whether beads i and i + 1 of a side are twins.
bb_twins(side: int, i: int): bool {
    b: int = side * GB;
    i >= 0 && i + 1 < gb_n[side] && gb_atom[b + i] == gb_atom[b + i + 1] && gb_flip[b + i] != gb_flip[b + i + 1]
}

// ---- a stamp's face put on the strings ----
// Face f of fact j on the beads of `side`: the stretch it fits that has
// bead i in it (the shortest, the leftmost), into gq_i, gq_k. Whether
// there is one.
bb_stretch_at(
    j: int,
    f: int,
    side: int,
    i: int
): bool {
    n0: int = play_node();
    if (n0 < 0) return false;
    g: int = pn_goal[n0];
    if (j < 0 || j >= gl_hypn[g]) return false;
    ok: bool = false;
    try {
        ok = bd_face_string(goal_hyp(g, j), f)
    } with KernelError -> {
        ok = false
    }
    if (!ok) return false;
    n: int = gb_n[side];
    b: int = side * GB;
    has_x: bool = false;
    for t in 0..pf_n {
        if (pf_atom[t] == bst_x && bst_x != 0) has_x = true
    }
    for k in 1..n + 1 {
        if (has_x || k == pf_n) {
            s: int = maxi(0, i - k + 1);
            while (s <= i && s + k <= n) {
                if (bb_fits(b, s, k, has_x)) {
                    gq_side = side;
                    gq_i = s;
                    gq_k = k;
                    return true
                }
                s = s + 1
            }
        }
    }
    false
}

maxi(a: int, b: int): int {
    if (a > b) return a;
    b
}

// Whether the face in pf_ fits the k beads of gs_ from b + s.
bb_fits(
    b: int,
    s: int,
    k: int,
    has_x: bool
): bool {
    if (has_x) return bd_solve_x(gb_atom, gb_flip, b + s, k);
    if (k != pf_n) return false;
    for t in 0..k {
        if (gb_atom[b + s + t] != pf_atom[t] || gb_flip[b + s + t] != pf_flip[t]) return false
    }
    true
}

// Face f of fact j on exactly the stretch [i, i + k) of `side`.
bb_stretch_is(
    j: int,
    f: int,
    side: int,
    i: int,
    k: int
): bool {
    n0: int = play_node();
    if (n0 < 0) return false;
    g: int = pn_goal[n0];
    if (j < 0 || j >= gl_hypn[g]) return false;
    ok: bool = false;
    try {
        ok = bd_face_string(goal_hyp(g, j), f)
    } with KernelError -> {
        ok = false
    }
    if (!ok) return false;
    has_x: bool = false;
    for t in 0..pf_n {
        if (pf_atom[t] == bst_x && bst_x != 0) has_x = true
    }
    if (!bb_fits(side * GB, i, k, has_x)) return false;
    gq_side = side;
    gq_i = i;
    gq_k = k;
    true
}

// Whether face f of fact j, put on a gap, wants a bead for x (it is for
// every x, and its other face has x).
bb_face_wants(j: int, f: int): bool {
    n0: int = play_node();
    if (n0 < 0) return false;
    g: int = pn_goal[n0];
    if (j < 0 || j >= gl_hypn[g]) return false;
    ok: bool = false;
    try {
        ok = bd_face_string(goal_hyp(g, j), 1 - f)
    } with KernelError -> {
        ok = false
    }
    if (!ok || !bst_all) return false;
    for t in 0..pf_n {
        if (pf_atom[t] == bst_x) return true
    }
    false
}

// ---- moves ----
// The gesture made, its place in gq_ (from (fx, fy)).
bb_move(
    kind: int,
    j: int,
    t: int,
    fx: f32,
    fy: f32
) raises KernelError {
    bk_clear();
    bsk_on = false;
    lang_gesture(kind, j, t, fx, fy)
}

// A face of fact j put on a gap: made, or a socket for x.
bb_face_gap(
    j: int,
    f: int,
    side: int,
    i: int,
    fx: f32,
    fy: f32
) raises KernelError {
    if (bb_face_n(j, f) != 0) {
        refuse(T_GOAL, -1, 1);
        return
    }
    gq_side = side;
    gq_i = i;
    gq_k = 0;
    gq_face = f;
    if (bb_face_wants(j, f)) {
        bk_clear();
        bsk_on = true;
        bsk_j = j;
        bsk_face = f;
        bsk_side = side;
        bsk_i = i;
        bsk_goal = bb_goal_now();
        return
    }
    bb_move(GS_STAMP, j, 0, fx, fy)
}

// A shelf bead into the socket.
bb_fill(t: int, fx: f32, fy: f32) raises KernelError {
    if (!bsk_valid() || t == 0) return;
    gq_side = bsk_side;
    gq_i = bsk_i;
    gq_k = 0;
    gq_face = bsk_face;
    bb_move(GS_STAMP, bsk_j, t, fx, fy)
}

// ---- two taps, either first ----
bb_tap(x: f32, y: f32) raises KernelError: bool {
    bpv_on = false;
    if (!lang_on() || done_t >= 0.0 || intro_open || chapter_open) return false;
    if (!bk_valid()) bk_kind = BK_NONE;
    if (!bb_target(x, y, bb_want())) {
        bk_clear();
        bsk_on = false;
        return false
    }
    if (bb_walk()) {
        if (bt_kind == BT_TILE) bb_move(GS_WALK, -1, bd_turn, x, y);
        return true
    }
    // (A socket waits: a shelf bead fills it; anything else lets it go.)
    if (bsk_valid()) {
        if (bt_kind == BT_SHELF) {
            bb_fill(bb_shelf_term(bt_shelf), sh_x[bt_shelf], sh_y);
            return true
        }
        bsk_on = false
    }
    k: int = bk_kind;
    if (bt_kind == BT_GOAL) {
        bk_clear();
        return true
    }
    if (bt_kind == BT_BEAD) {
        if (k == BK_STRETCH && bk_side == bt_side) {
            if (bt_i >= bk_i && bt_i < bk_i + bk_k) {
                bk_clear();
                return true
            }
            if (bt_i == bk_i - 1 || bt_i == bk_i + bk_k) {
                lo: int = mini(bt_i, bk_i);
                if (bk_k == 1 && bb_twins(bt_side, lo)) {
                    gq_side = bt_side;
                    gq_i = lo;
                    bb_move(GS_POP, -1, 0, x, y);
                    return true
                }
                bk_i = lo;
                bk_k = bk_k + 1;
                return true
            }
        }
        if (k == BK_FACE) {
            gq_face = bk_face;
            if (bb_stretch_at(bk_j, bk_face, bt_side, bt_i)) bb_move(GS_STAMP, bk_j,
                0, x, y) else refuse(T_GOAL, -1, 1);
            return true
        }
        if (k == BK_SHELF) {
            // (Into the gap on the side of the bead the finger is.)
            g0: int = bt_i;
            if (x > gb_x[bt_side * GB + bt_i]) g0 = bt_i + 1;
            gq_side = bt_side;
            gq_i = g0;
            bb_move(GS_PAIR, -1, bb_shelf_term(bk_shelf), sh_x[bk_shelf], sh_y);
            return true
        }
        bk_set(BK_STRETCH);
        bk_side = bt_side;
        bk_i = bt_i;
        bk_k = 1;
        return true
    }
    if (bt_kind == BT_GAP) {
        if (k == BK_SHELF) {
            gq_side = bt_side;
            gq_i = bt_i;
            bb_move(GS_PAIR, -1, bb_shelf_term(bk_shelf), sh_x[bk_shelf], sh_y);
            return true
        }
        if (k == BK_FACE) {
            bb_face_gap(bk_j, bk_face, bt_side, bt_i, x, y);
            return true
        }
        if (k == BK_GAP && bk_side == bt_side && bk_i == bt_i) {
            bk_clear();
            return true
        }
        bk_set(BK_GAP);
        bk_side = bt_side;
        bk_i = bt_i;
        return true
    }
    if (bt_kind == BT_FACE) {
        if (k == BK_STRETCH) {
            gq_face = bt_face;
            if (bb_stretch_is(bt_j, bt_face, bk_side, bk_i, bk_k)) bb_move(GS_STAMP,
                bt_j, 0, x, y) else refuse(T_GOAL, -1, 1);
            return true
        }
        if (k == BK_GAP) {
            bb_face_gap(bt_j, bt_face, bk_side, bk_i, x, y);
            return true
        }
        if (k == BK_FACE && bk_j == bt_j && bk_face == bt_face) {
            bk_clear();
            return true
        }
        bk_set(BK_FACE);
        bk_j = bt_j;
        bk_face = bt_face;
        return true
    }
    if (bt_kind == BT_SHELF) {
        if (k == BK_GAP) {
            gq_side = bk_side;
            gq_i = bk_i;
            bb_move(GS_PAIR, -1, bb_shelf_term(bt_shelf), x, y);
            return true
        }
        if (k == BK_SHELF && bk_shelf == bt_shelf) {
            bk_clear();
            return true
        }
        bk_set(BK_SHELF);
        bk_shelf = bt_shelf;
        return true
    }
    false
}

// ---- what the move would make, while its partner is pressed ----
bpv_on: bool = false;

bpv_y: f32 = 0.0;

// The gesture a tap at (x, y) would make with what is held (into bpk_,
// gq_), without making it. Whether there is one.
bpk_kind: int = 0;

bpk_j: int = -1;

bpk_t: int = 0;

bb_pair_at(x: f32, y: f32): bool {
    if (!bk_valid() || bb_walk()) return false;
    if (!bb_target(x, y, bb_want())) return false;
    k: int = bk_kind;
    bpk_j = -1;
    bpk_t = 0;
    if (bt_kind == BT_BEAD && k == BK_STRETCH && bk_side == bt_side && bk_k == 1 && (bt_i == bk_i - 1 || bt_i == bk_i + 1)) {
        lo: int = mini(bt_i, bk_i);
        if (!bb_twins(bt_side, lo)) return false;
        gq_side = bt_side;
        gq_i = lo;
        bpk_kind = GS_POP;
        return true
    }
    if (bt_kind == BT_BEAD && k == BK_FACE) {
        gq_face = bk_face;
        if (!bb_stretch_at(bk_j, bk_face, bt_side, bt_i)) return false;
        bpk_kind = GS_STAMP;
        bpk_j = bk_j;
        return true
    }
    if ((bt_kind == BT_BEAD || bt_kind == BT_GAP) && k == BK_SHELF) {
        g0: int = bt_i;
        if (bt_kind == BT_BEAD && x > gb_x[bt_side * GB + bt_i]) g0 = bt_i + 1;
        gq_side = bt_side;
        gq_i = g0;
        bpk_kind = GS_PAIR;
        bpk_t = bb_shelf_term(bk_shelf);
        return true
    }
    if (bt_kind == BT_FACE && k == BK_STRETCH) {
        gq_face = bt_face;
        if (!bb_stretch_is(bt_j, bt_face, bk_side, bk_i, bk_k)) return false;
        bpk_kind = GS_STAMP;
        bpk_j = bt_j;
        return true
    }
    if (bt_kind == BT_SHELF && k == BK_GAP) {
        gq_side = bk_side;
        gq_i = bk_i;
        bpk_kind = GS_PAIR;
        bpk_t = bb_shelf_term(bt_shelf);
        return true
    }
    false
}

// A finger come down: the partner of what is held shows what it makes.
bb_press(x: f32, y: f32) {
    bpv_on = false;
    if (!lang_on() || done_t >= 0.0) return;
    if (bb_pair_at(x, y) && bb_would(bpk_kind, bpk_j, bpk_t)) {
        bpv_on = true;
        bpv_y = y
    }
}

// What the gesture would leave (bw_goal; or it closes), by trying it.
bw_goal: int = 0;

bw_closes: bool = false;

bw_key: int = 0;

bb_would(kind: int, j: int, t: int): bool {
    key: int = (((kind * 31 + j) * 31 + t) * 31 + gq_side) * 1009 + gq_i * 61 + gq_k * 7 + gq_face + bb_goal_now() * 7919;
    if (key == bw_key && bw_goal != 0) return true;
    bw_key = 0;
    bw_goal = 0;
    n: int = play_node();
    if (n < 0) return false;
    gs_save();
    ok: bool = false;
    try {
        ok = gs_do(n, kind, j, t)
    } with KernelError -> {
        ok = false
    }
    if (ok) {
        bw_closes = pn_thm[n] != 0;
        k: int = n;
        while (pn_move[k] >= 0 && pn_kidn[k] > 0) k = node_kid(k, pn_kidn[k] - 1);
        bw_goal = gl_concl[pn_goal[k]];
        bw_key = key
    }
    gs_restore(n);
    ok
}

// ---- dragging ----
// A bead dragged along its string pinches the beads it passes; a stamp's
// face or a shelf bead dragged rides above the finger to where it goes.
bdg_on: bool = false;

bdg_kind: int = 0;

bdg_side: int = 0;

bdg_i0: int = 0;

bdg_i1: int = 0;

bdg_j: int = -1;

bdg_face: int = 0;

bdg_shelf: int = -1;

bdg_x: f32 = 0.0;

bdg_y: f32 = 0.0;

// Where it would go, and whether it fits there (a gesture in bpk_, gq_).
bdg_fit: bool = false;

// What the finger came down on (bt_ as it was).
bgr_kind: int = 0;

bgr_side: int = 0;

bgr_i: int = 0;

bgr_j: int = -1;

bgr_face: int = 0;

bgr_shelf: int = -1;

// Whether a finger at (x, y) is on something to drag (gr_kind: DG_TOKEN
// a thing, DG_GOAL the strings or the tile, to swipe).
bb_grab(x: f32, y: f32): bool {
    gr_kind = 0;
    if (!lang_on() || done_t >= 0.0 || intro_open || chapter_open) return false;
    if (!bb_target(x, y, 0)) return false;
    bgr_kind = bt_kind;
    bgr_side = bt_side;
    bgr_i = bt_i;
    bgr_j = bt_j;
    bgr_face = bt_face;
    bgr_shelf = bt_shelf;
    if (bt_kind == BT_TILE || bt_kind == BT_GOAL || bt_kind == BT_GAP) {
        gr_kind = DG_GOAL;
        return true
    }
    gr_kind = DG_TOKEN;
    true
}

bb_lift(x: f32, y: f32) {
    bdg_on = false;
    if (gr_kind != DG_TOKEN) return;
    bdg_on = true;
    bdg_fit = false;
    bdg_x = x;
    bdg_y = y;
    bdg_side = bgr_side;
    bdg_i0 = bgr_i;
    bdg_i1 = bgr_i;
    bdg_j = bgr_j;
    bdg_face = bgr_face;
    bdg_shelf = bgr_shelf;
    if (bgr_kind == BT_BEAD) bdg_kind = BK_STRETCH else if (bgr_kind == BT_FACE) bdg_kind = BK_FACE else bdg_kind = BK_SHELF;
    bk_clear();
    bsk_on = false;
    lh_on = false;
    bb_drag(x, y)
}

bb_drag(x: f32, y: f32) {
    if (!bdg_on) return;
    bdg_x = x;
    bdg_y = y;
    bdg_fit = false;
    if (bdg_kind == BK_STRETCH) {
        // (The beads passed: from the first to the one under the finger.)
        if (bb_target(x, y, 2) && bt_kind == BT_BEAD && bt_side == bdg_side) bdg_i1 = bt_i;
        lo: int = mini(bdg_i0, bdg_i1);
        hi: int = maxi(bdg_i0, bdg_i1);
        if (hi == lo + 1 && bb_twins(bdg_side, lo)) {
            gq_side = bdg_side;
            gq_i = lo;
            bpk_kind = GS_POP;
            bpk_j = -1;
            bpk_t = 0;
            bdg_fit = bb_would(GS_POP, -1, 0)
        }
        return
    }
    // (A thing carried: where it is is above the finger.)
    hy: f32 = y - LIFT_UP;
    want: int = 1;
    if (bdg_kind == BK_FACE && bb_face_n(bdg_j, bdg_face) > 0) want = 2;
    if (!bb_target(x, hy, want)) return;
    if (bdg_kind == BK_SHELF && (bt_kind == BT_GAP || bt_kind == BT_BEAD)) {
        g0: int = bt_i;
        if (bt_kind == BT_BEAD && x > gb_x[bt_side * GB + bt_i]) g0 = bt_i + 1;
        gq_side = bt_side;
        gq_i = g0;
        bpk_kind = GS_PAIR;
        bpk_j = -1;
        bpk_t = bb_shelf_term(bdg_shelf);
        bdg_fit = bb_would(GS_PAIR, -1, bpk_t)
    } else if (bdg_kind == BK_FACE && bt_kind == BT_BEAD) {
        gq_face = bdg_face;
        if (bb_stretch_at(bdg_j, bdg_face, bt_side, bt_i)) {
            bpk_kind = GS_STAMP;
            bpk_j = bdg_j;
            bpk_t = 0;
            bdg_fit = bb_would(GS_STAMP, bdg_j, 0)
        }
    } else if (bdg_kind == BK_FACE && bt_kind == BT_GAP && bb_face_n(bdg_j, bdg_face) == 0) {
        gq_side = bt_side;
        gq_i = bt_i;
        gq_k = 0;
        gq_face = bdg_face;
        bpk_kind = GS_STAMP;
        bpk_j = bdg_j;
        bpk_t = 0;
        // (One that wants x shows no preview: it asks for x when put.)
        if (bb_face_wants(bdg_j, bdg_face)) bdg_fit = true else bdg_fit = bb_would(GS_STAMP,
            bdg_j, 0)
    }
}

bb_drop(x: f32, y: f32) raises KernelError {
    if (!bdg_on) return;
    bb_drag(x, y);
    bdg_on = false;
    if (bdg_kind == BK_STRETCH) {
        lo: int = mini(bdg_i0, bdg_i1);
        hi: int = maxi(bdg_i0, bdg_i1);
        if (bdg_fit) {
            bb_move(GS_POP, -1, 0, x, y);
            return
        }
        // (Pinched: the stretch held, for a stamp.)
        bk_set(BK_STRETCH);
        bk_side = bdg_side;
        bk_i = lo;
        bk_k = hi - lo + 1;
        return
    }
    if (!bdg_fit) {
        refuse(T_GOAL, -1, 1);
        return
    }
    if (bpk_kind == GS_STAMP && gq_k == 0 && bb_face_wants(bpk_j, gq_face)) {
        bb_face_gap(bpk_j, gq_face, gq_side, gq_i, x, y);
        return
    }
    bb_move(bpk_kind, bpk_j, bpk_t, x, y - LIFT_UP)
}

// ---- swiped: the strings turned round, or the tile flipped ----
bb_swipe_end(d: f32) raises KernelError {
    if (absf(d) < 50.0) return;
    if (bb_walk()) {
        bb_move(GS_WALK, -1, bd_flip, tl_x, tl_y);
        return
    }
    bb_move(GS_TURN, -1, 0, gc_x + 20.0, gc_y)
}

// ---- the level, drawn ----
bb_draw_level() {
    n: int = bb_node();
    x: f32 = col_x();
    w: f32 = col_w();
    if (chapter_open) {
        intro_open = true;
        intro_t0 = now_t
    }
    if (intro_open && now_t - intro_t0 > 1.55) intro_open = false;
    hy: f32 = safe_top + 30.0;
    top: f32 = draw_level_bar(x, w, hy);
    bar_bottom_y = top;
    pic_bottom_y = 0.0;
    // (The level's words, quiet, at the top.)
    if (cur_level >= 0 && lv_intro[cur_level] != 0) {
        sa: f32 = 1.0;
        if (done_t >= 0.0) sa = 1.0 - hand_away();
        top = top + draw_wrapped(0, 15.0, x + 14.0, top + 22.0, w - 28.0, lv_intro[cur_level],
            C_MUTED, sa) + 10.0
    }
    if (bb_walk()) bb_draw_walk(n, x, w, top) else bb_draw_beads(n, x, w, top);
    // (A demo's words over the goal's card, or its stamps.)
    pic_bottom_y = gc_y + 8.0;
    if (st_n2 > 0 && !bb_walk()) pic_bottom_y = st_y0[0] + 6.0;
    if (now_t - say_t < 3.5 && cur_level >= 0 && lv_intro[cur_level] != 0) draw_say(x,
        w, hy + 46.0);
    if (done_t >= 0.0) {
        bb_draw_proved(x);
        draw_done(x, w)
    }
    draw_lang_top(x, w);
    bb_draw_top();
    draw_intro(x, w);
    draw_chapter(x, w);
    bb_boxes_print()
}

// "Proved." over the card when the level is done.
bb_draw_proved(x: f32) {
    a: f32 = clampf((now_t - done_t) / 0.3, 0.0, 1.0);
    if (a < 1.0) busy = true;
    done_card_y = gc_y;
    done_h = gc_h;
    p_str(1, 14.0, x + 6.0, gc_y - 10.0, "Proved.", C_MUTED, a)
}

// Whether the level's facts are stamps to use (then the shelf shows).
bb_has_shelf(): bool {
    if (pn_n == 0) return false;
    gl_hypn[pn_goal[root]] > 0
}

const SHELF_H: f32 = 84.0;

bb_draw_beads(
    n: int,
    x: f32,
    w: f32,
    top: f32
) {
    bd_syms();
    if (n < 0) return;
    concl: int = gl_concl[pn_goal[n]];
    bb_read_side(concl, 0);
    bb_read_side(concl, 1);
    // (The shelf at the foot; put away once done.)
    shelf: bool = bb_has_shelf();
    if (shelf) bb_shelf_names() else sh_n = 0;
    sh_k: f32 = 0.0;
    if (shelf) sh_k = 1.0;
    if (done_t >= 0.0) sh_k = 1.0 - hand_away();
    shelf_top: f32 = view_h() - safe_bottom - SHELF_H * sh_k;
    if (done_t >= 0.0) shelf_top = view_h() - safe_bottom - SHELF_H * (1.0 - hand_away());
    // (The stamps, measured: they sit just over the goal's card.)
    sh: f32 = bb_stamps_layout(n, x, w, 0.0);
    sgap: f32 = 0.0;
    if (sh > 0.0) sgap = 18.0;
    // (The goal card: in the room left, a little low, its strings sized to
    // fit.)
    m: int = maxi(maxi(gb_n[0], gb_n[1]), 1);
    if (bsk_valid()) m = maxi(m, gb_n[bsk_side] + 2);
    r: f32 = clampf((w - 56.0) / (m as f32 * 2.3), 13.0, 30.0);
    gb_r = r;
    gb_sp = 2.0 * r * 1.16;
    area0: f32 = top + 14.0;
    area1: f32 = view_h() - safe_bottom - SHELF_H - 22.0;
    if (!shelf) area1 = view_h() - safe_bottom - 40.0;
    ch: f32 = minf(area1 - area0 - sh - sgap, 4.0 * r + 120.0);
    want_y: f32 = area0 + (area1 - area0 - sh - sgap - ch) * 0.58 + sh + sgap;
    if (an_jump || gc_h <= 0.0) {
        gc_h = ch;
        gc_y = want_y
    } else if (done_t < 0.0) {
        gc_h = ease_to(gc_h, ch, 14.0);
        gc_y = ease_to(gc_y, want_y, 14.0)
    }
    sh = bb_stamps_layout(n, x, w, gc_y - sh - sgap);
    gc_x = x;
    gc_w = w;
    sdx: f32 = goal_swipe_dx();
    gb_cx = x + w * 0.5 + sdx;
    gb_row[0] = gc_y + gc_h * 0.5 - r - 18.0;
    gb_row[1] = gc_y + gc_h * 0.5 + r + 18.0;
    // (Done: the two strings, the same, come together.)
    if (pn_thm[root] != 0) gb_row[1] = gb_row[0] + 0.0 * gb_row[1];
    for side in 0..2 {
        b: int = side * GB;
        k: int = gb_n[side];
        sock: bool = bsk_valid() && bsk_side == side;
        for i in 0..k {
            bx: f32 = bb_bead_x(gb_cx, gb_sp, k, i);
            // (A socket: room for x's two beads in its gap.)
            if (sock) {
                if (i < bsk_i) bx = bb_bead_x(gb_cx, gb_sp, k + 2, i) else bx = bb_bead_x(gb_cx,
                    gb_sp, k + 2, i + 2)
            }
            // (A gap held, or a socket's, parts the beads either side.)
            if (bk_valid() && bk_kind == BK_GAP && bk_side == side) {
                if (i < bk_i) bx = bx - 7.0 else bx = bx + 7.0
            }
            // (A stretch pinched: its beads closer.)
            if (bdg_on && bdg_kind == BK_STRETCH && bdg_side == side) {
                lo: int = mini(bdg_i0, bdg_i1);
                hi: int = maxi(bdg_i0, bdg_i1);
                mid: f32 = (lo + hi) as f32 * 0.5;
                if (i >= lo && i <= hi) bx = bx - (i as f32 - mid) * gb_sp * 0.12
            }
            gb_x[b + i] = bx
        }
        bb_sync(side)
    }
    // (The card.)
    dead: bool = lang_dead();
    gfill: int = C_CARD;
    if (bpv_on || bdg_on && bdg_fit) gfill = mix_rgb(C_CARD, C_PICK_SOFT, 0.35);
    gx: f32 = gc_x + sdx * 0.35;
    p_shadow(gx, gc_y, gc_w, gc_h, 24.0, 4.0, 14.0, 0.14);
    p_box(gx, gc_y, gc_w, gc_h, 24.0, gfill, 1.0);
    p_outline(gx, gc_y, gc_w, gc_h, 24.0, 2.0, mix_rgb(C_LINE, C_MUTED, 0.3), 1.0);
    goal_rx = gc_x;
    goal_ry = gc_y;
    goal_rw = gc_w;
    goal_rh = gc_h;
    // (The cords the beads are on.)
    cord: int = mix_rgb(C_LINE, C_MUTED, 0.3);
    for side in 0..2 {
        ry: f32 = gb_row[side];
        if (side == 1 && pn_thm[root] != 0) ry = gb_row[0];
        p_line(gx + 22.0, ry, gx + gc_w - 22.0, ry, 2.0, cord, 1.0);
        p_disc(gx + 22.0, ry, 4.0, cord, 1.0);
        p_disc(gx + gc_w - 22.0, ry, 4.0, cord, 1.0)
    }
    // (What is held: lifted a little, its edge drawn quietly.)
    ls: int = -1;
    li: int = 0;
    lk: int = 0;
    if (bk_valid() && bk_kind == BK_STRETCH) {
        ls = bk_side;
        li = bk_i;
        lk = bk_k
    }
    if (bdg_on && bdg_kind == BK_STRETCH) {
        ls = bdg_side;
        li = mini(bdg_i0, bdg_i1);
        lk = maxi(bdg_i0, bdg_i1) - li + 1
    }
    if (ls >= 0 && lk > 0 && li + lk <= gb_n[ls]) {
        x0: f32 = gb_x[ls * GB + li] - r - 6.0;
        x1: f32 = gb_x[ls * GB + li + lk - 1] + r + 6.0;
        p_box(x0, gb_row[ls] - r - 10.0, x1 - x0, 2.0 * r + 12.0, r + 6.0, C_SHADOW,
            0.04);
        p_outline(x0, gb_row[ls] - r - 10.0, x1 - x0, 2.0 * r + 12.0, r + 6.0, 2.0,
            C_HOLD, 0.6)
    }
    if (bk_valid() && bk_kind == BK_GAP) {
        gx0: f32 = bb_gap_x(bk_side, bk_i);
        p_box(gx0 - 3.0, gb_row[bk_side] - r - 4.0, 6.0, 2.0 * r + 8.0, 3.0, C_HOLD,
            0.55)
    }
    bb_draw_vbeads(ls, li, lk);
    // (A socket: x's beads, hollow, where they will come out.)
    if (bsk_valid()) bb_draw_socket();
    if (dead) p_box(gx, gc_y, gc_w, gc_h, 24.0, C_SUNK, 0.35);
    // (Done: the stamps go, as facts do.)
    sa: f32 = 1.0;
    if (done_t >= 0.0) sa = 1.0 - clampf((now_t - fin_t0) / 0.3, 0.0, 1.0);
    if (sa < 1.0 && sa > 0.0) busy = true;
    bb_draw_stamps(sa);
    if (sh_n > 0) {
        bb_shelf_layout(x, w, shelf_top + SHELF_H * 0.5 - 4.0);
        bb_draw_shelf(x, w, shelf_top, sh_k)
    }
    hand_top_y = shelf_top
}

// The socket's x x, hollow, in its gap.
bb_draw_socket() {
    k: int = gb_n[bsk_side];
    gx: f32 = (bb_bead_x(gb_cx, gb_sp, k + 2, bsk_i) + bb_bead_x(gb_cx, gb_sp, k + 2,
        bsk_i + 1)) * 0.5;
    y: f32 = gb_row[bsk_side];
    t: f32 = now_t;
    a: f32 = 0.55 + 0.1 * sinf(t * 3.0);
    busy = true;
    r: f32 = gb_r * 0.86;
    for i in 0..2 {
        cx: f32 = gx + (i as f32 - 0.5) * gb_sp;
        p_box(cx - r, y - r, 2.0 * r, 2.0 * r, r, C_SUNK, a);
        p_outline(cx - r, y - r, 2.0 * r, 2.0 * r, r, 2.0, C_PICK, a)
    }
}

// Drawn over everything: a thing carried, the card of what a move would
// make, the socket's words.
bb_draw_top() {
    if (!bb_on() || done_t >= 0.0) return;
    if (bdg_on) {
        hx: f32 = bdg_x;
        hy: f32 = bdg_y - LIFT_UP;
        if (bdg_kind == BK_SHELF && bdg_shelf >= 0 && bdg_shelf < sh_n) {
            // (A bead and its twin.)
            at: int = sh_atom[bdg_shelf];
            fl: bool = sh_flip[bdg_shelf];
            bb_bead(hx - SH_R - 2.0, hy, SH_R * 1.05, at, fl, 1.0, 1.0, 1.0, 1.0);
            bb_bead(hx + SH_R + 2.0, hy, SH_R * 1.05, at, !fl, 1.0, 1.0, 1.0, 1.0)
        }
        if (bdg_kind == BK_FACE) bb_draw_face_at(bdg_j, bdg_face, hx, hy)
    }
    if ((bpv_on || bdg_on && bdg_fit) && bw_goal != 0) bb_draw_would();
    if (bsk_valid()) {
        s: str = "Tap a bead below for X";
        tw: f32 = p_str_w(1, 12.5, s) + 24.0;
        x: f32 = gc_x + gc_w - tw - 14.0;
        y: f32 = gc_y - 12.0;
        p_box(x, y, tw, 24.0, 12.0, C_BG, 0.92);
        p_str(0, 12.5, x + 12.0, y + 16.5, s, C_MUTED, 1.0)
    }
}

// Face f of stamp j, carried: its beads on a small card.
bb_draw_face_at(
    j: int,
    f: int,
    cx: f32,
    cy: f32
) {
    k: int = -1;
    for i in 0..st_n2 {
        if (stp_hyp[i] == j) k = i
    }
    if (k < 0) return;
    n2: int = ssn[k * 2 + f];
    r: f32 = st_r * 1.15;
    sp: f32 = 2.0 * r + 5.0;
    w: f32 = maxf(n2 as f32, 1.0) * sp + 18.0;
    p_shadow(cx - w * 0.5, cy - r - 9.0, w, 2.0 * r + 18.0, r + 9.0, 6.0, 14.0, 0.2);
    p_box(cx - w * 0.5, cy - r - 9.0, w, 2.0 * r + 18.0, r + 9.0, C_BLUE_SOFT, 1.0);
    if (n2 == 0) bb_dent(cx, cy, r, 1.0);
    for i in 0..n2 {
        q: int = ss0[k * 2 + f] + i;
        bb_bead(bb_bead_x(cx, sp, n2, i), cy, r, ss_atom[q], ss_flip[q], 1.0, 1.0,
            1.0, 1.0)
    }
}

// What the strings would become, on a card away from the finger: over the
// stamps when the finger is low, over the shelf when it is high.
bb_draw_would() {
    fy: f32 = bpv_y;
    if (bdg_on) fy = bdg_y;
    w: f32 = gc_w;
    x: f32 = gc_x;
    r: f32 = 12.0;
    h: f32 = 4.0 * r + 34.0;
    y: f32 = bar_bottom_y + 6.0;
    if (fy < view_h() * 0.5) y = view_h() - safe_bottom - h - 10.0;
    p_shadow(x, y, w, h, 18.0, 4.0, 12.0, 0.16);
    p_box(x, y, w, h, 18.0, mix_rgb(C_CARD, C_PICK_SOFT, 0.5), 1.0);
    p_outline(x, y, w, h, 18.0, 1.5, mix_rgb(C_PICK, C_LINE, 0.5), 1.0);
    rows: int = 2;
    if (bw_closes) rows = 1;
    for side in 0..rows {
        bs_n = 0;
        st: int = bd_side_term(bw_goal, side);
        if (st != 0) bd_flatten(st, false);
        ry: f32 = y + h * 0.5;
        if (rows == 2) ry = y + h * 0.5 + (side as f32 - 0.5) * (2.0 * r + 8.0);
        sp: f32 = 2.0 * r + 4.0;
        cord: int = mix_rgb(C_LINE, C_MUTED, 0.2);
        p_line(x + 18.0, ry, x + w - 18.0, ry, 1.5, cord, 0.8);
        k: int = bs_n;
        for i in 0..k bb_bead(bb_bead_x(x + w * 0.5, sp, k, i), ry, r, bs_atom[i],
            bs_flip[i], 1.0, 1.0, 1.0, 0.0)
    }
}

// ---- the tile ----
// Where it is drawn (its middle, its size), and the board's room.
tl_x: f32 = 0.0;

tl_y: f32 = 0.0;

tl_s: f32 = 120.0;

wv_top: f32 = 0.0;

wv_bot: f32 = 0.0;

// A pose: quarter turns k (0 to 3, clockwise) after a flip or not; as one
// number, k + 4 if flipped.
pose_turn(p: int): int {
    (p + 1) % 4 + p / 4 * 4
}

pose_flip(p: int): int {
    k: int = p % 4;
    (4 - k) % 4 + (1 - p / 4) * 4
}

// Its matrix: R^k after F (if flipped), R a quarter turn clockwise, F the
// mirror left to right.
pm00: f32 = 1.0;

pm01: f32 = 0.0;

pm10: f32 = 0.0;

pm11: f32 = 1.0;

pose_matrix(p: int) {
    a: f32 = 1.0;
    b: f32 = 0.0;
    c: f32 = 0.0;
    d: f32 = 1.0;
    if (p >= 4) a = -1.0;
    for _ in 0..p % 4 {
        // (R · M: R = (0 -1; 1 0).)
        na: f32 = -c;
        nb: f32 = -d;
        nc: f32 = a;
        nd: f32 = b;
        a = na;
        b = nb;
        c = nc;
        d = nd
    }
    pm00 = a;
    pm01 = b;
    pm10 = c;
    pm11 = d
}

// The level's corners A and B (the fixed names), for reading poses.
wk_a: int = 0;

wk_b: int = 0;

wk_corners() {
    wk_a = 0;
    wk_b = 0;
    if (pn_n == 0) return;
    g: int = pn_goal[root];
    for i in 0..gl_fixn[g] {
        t: int = goal_fix(g, i);
        if (tm_name(t) == sym("A")) wk_a = t;
        if (tm_name(t) == sym("B")) wk_b = t
    }
}

// The pose of a sq(...) term, or -1.
wk_pose(t: int): int {
    if (t == 0 || !bd_pose(t, wk_a, wk_b)) return -1;
    p: int = bd_pose_turns;
    if (bd_pose_flipped) p = p + 4;
    p
}

// Where the tile has been (every walk level starts from the same place,
// so the map grows across them), and the roads it took (from a pose, by a
// turn (0) or a flip (1)).
wk_seen: []bool = new bool[8](false);

wk_road: []bool = new bool[16](false);

// A move about to be made: its road noted.
wk_note(t: int) {
    n: int = play_node();
    if (n < 0) return;
    wk_corners();
    // (Only a move there is room for: it will be made.)
    if (bd_walk_left(gl_concl[pn_goal[n]]) == 0) return;
    p: int = wk_pose(bd_tile_pos(gl_concl[pn_goal[n]]));
    if (p < 0) return;
    m: int = 0;
    if (t == bd_flip) m = 1;
    wk_road[p * 2 + m] = true;
    q: int = pose_turn(p);
    if (m == 1) q = pose_flip(p);
    wk_seen[q] = true
}

// The tile drawn: shown pose, and a move being played out.
wk_shown: int = -1;

wk_anim: int = 0;

wk_t0: f32 = -10.0;

wk_from: int = 0;

const WK_TIME: f32 = 0.36;

bb_draw_walk(
    n: int,
    x: f32,
    w: f32,
    top: f32
) {
    bd_syms();
    wk_corners();
    if (n < 0) return;
    concl: int = gl_concl[pn_goal[n]];
    pos: int = wk_pose(bd_tile_pos(concl));
    tgt: int = wk_pose(bd_tile_target(concl));
    total: int = bd_walk_left(gl_concl[pn_goal[root]]);
    left: int = bd_walk_left(concl);
    wk_seen[0] = true;
    if (pos >= 0) wk_seen[pos] = true;
    // (The board: the goal's card low, in the thumb's reach (the tile, its
    // shadow, the slots); the map in the room above.)
    wv_top = top + 8.0;
    wv_bot = view_h() - safe_bottom - 20.0;
    tl_s = clampf(w * 0.3, 92.0, 136.0);
    gc_h = tl_s + 22.0 + 100.0;
    gc_y = wv_bot - 24.0 - gc_h;
    // (Done: up a little, room under it for Next.)
    if (done_t >= 0.0) {
        k: f32 = clampf((now_t - done_t) / 0.35, 0.0, 1.0);
        if (k < 1.0) busy = true;
        gc_y = gc_y - 64.0 * (1.0 - (1.0 - k) * (1.0 - k))
    }
    gc_x = x;
    gc_w = w;
    ty: f32 = gc_y + 22.0 + tl_s * 0.5;
    tl_y = ty;
    room: f32 = gc_y - 20.0 - wv_top;
    rad: f32 = minf(room * 0.5 - 30.0, w * 0.5 - 40.0);
    bb_draw_map(x + w * 0.5, wv_top + room * 0.5 + 6.0, rad, pos, tgt);
    p_shadow(gc_x, gc_y, gc_w, gc_h, 24.0, 4.0, 14.0, 0.14);
    p_box(gc_x, gc_y, gc_w, gc_h, 24.0, C_CARD, 1.0);
    p_outline(gc_x, gc_y, gc_w, gc_h, 24.0, 2.0, mix_rgb(C_LINE, C_MUTED, 0.3), 1.0);
    sx: f32 = x + w * 0.29;
    tx: f32 = x + w * 0.71;
    // (Done: the tile settles onto its shadow.)
    if (pn_thm[root] != 0) {
        k: f32 = clampf((now_t - close_t) / 0.4, 0.0, 1.0);
        if (k < 1.0) busy = true;
        k = 1.0 - (1.0 - k) * (1.0 - k);
        sx = sx + (tx - sx) * k
    }
    sx = sx + goal_swipe_dx() * 0.4;
    tl_x = sx;
    // (The shadow: where it must get to.)
    if (tgt >= 0) bb_draw_shadow(tx, ty, tl_s, tgt);
    // (The tile, turning or flipping into its pose.)
    if (pos >= 0) {
        if (wk_shown < 0 || an_jump) wk_shown = pos;
        if (pos != wk_shown && now_t - wk_t0 >= WK_TIME) {
            wk_from = wk_shown;
            wk_anim = 0;
            if (pose_turn(wk_shown) == pos) wk_anim = 1 else if (pose_turn(pose_turn(pose_turn(wk_shown))) == pos) wk_anim = 2 else if (pose_flip(wk_shown) == pos) wk_anim = 3;
            wk_t0 = now_t;
            wk_shown = pos
        }
        pose_matrix(wk_from);
        a00: f32 = pm00;
        a01: f32 = pm01;
        a10: f32 = pm10;
        a11: f32 = pm11;
        t: f32 = (now_t - wk_t0) / WK_TIME;
        if (t < 1.0 && wk_anim > 0) {
            busy = true;
            // (Eased, a little past and back: pudgy.)
            e: f32 = 1.0 - (1.0 - t) * (1.0 - t);
            e = e + sinf(t * 3.14159) * 0.08;
            if (wk_anim == 3) {
                c: f32 = 1.0 - 2.0 * minf(e, 1.0);
                a00 = a00 * c;
                a01 = a01 * c
            } else {
                ang: f32 = e * 1.5708;
                if (wk_anim == 2) ang = -ang;
                cs: f32 = cosf(ang);
                sn: f32 = sinf(ang);
                b00: f32 = cs * a00 - sn * a10;
                b01: f32 = cs * a01 - sn * a11;
                b10: f32 = sn * a00 + cs * a10;
                b11: f32 = sn * a01 + cs * a11;
                a00 = b00;
                a01 = b01;
                a10 = b10;
                a11 = b11
            }
        } else {
            pose_matrix(wk_shown);
            a00 = pm00;
            a01 = pm01;
            a10 = pm10;
            a11 = pm11
        }
        dead: bool = lang_dead();
        bb_draw_tile(sx, ty, tl_s, a00, a01, a10, a11, 1.0, dead)
    }
    goal_rx = gc_x;
    goal_ry = gc_y;
    goal_rw = gc_w;
    goal_rh = gc_h;
    // (A slot for each move asked for: filled with the moves made.)
    sy: f32 = ty + tl_s * 0.5 + 48.0;
    bb_draw_slots(x + w * 0.5, sy, total, left);
    if (lang_dead()) bb_draw_walk_dead(gc_x, gc_y, gc_w, gc_h);
    hand_top_y = view_h()
}

// The tile: a cream square with a flag on it, in the frame the matrix
// makes (its pose, or a move between).
bb_draw_tile(
    cx: f32,
    cy: f32,
    s: f32,
    m00: f32,
    m01: f32,
    m10: f32,
    m11: f32,
    a: f32,
    grey: bool
) {
    // (Its shadow turns with it.)
    soft: f32 = 12.0;
    hw: f32 = s * 0.5;
    hq: f32 = hw + soft + 1.5;
    p_quad_xf(cx, cy + 5.0, hq, hq, m00, m01, m10, m11, -hq, -hq, hq, hq, hw, hw,
        P_BOX, s * 0.18, soft, 0.0, 5, 0.18 * a);
    card: int = C_CARD;
    if (grey) card = mix_rgb(C_CARD, C_SUNK, 0.7);
    p_box_xf(cx, cy, s, s, s * 0.18, 0.0, m00, m01, m10, m11, card, a);
    p_box_xf(cx, cy, s, s, s * 0.18, 2.0, m00, m01, m10, m11, mix_rgb(C_LINE, C_MUTED,
        0.3), a);
    flag: int = C_PICK;
    pole: int = 7035462;
    if (grey) {
        flag = mix_rgb(C_PICK, C_SUNK, 0.6);
        pole = C_MUTED
    }
    bb_flag(cx, cy, s, m00, m01, m10, m11, pole, flag, a)
}

// The flag in a frame: a pole up its left, a pennant at its top pointing
// right, a foot.
bb_flag(
    cx: f32,
    cy: f32,
    s: f32,
    m00: f32,
    m01: f32,
    m10: f32,
    m11: f32,
    pole: int,
    flag: int,
    a: f32
) {
    // (Points in the frame, from the middle, as fractions of s.)
    bb_part(cx, cy, s, -0.2, 0.02, 0.075, 0.62, m00, m01, m10, m11, pole, a);
    bb_part(cx, cy, s, -0.2, 0.33, 0.24, 0.07, m00, m01, m10, m11, pole, a);
    lx: f32 = 0.05 * s;
    ly: f32 = -0.16 * s;
    hw: f32 = 0.24 * s;
    hh: f32 = 0.15 * s;
    p_quad_xf(cx + m00 * lx + m01 * ly, cy + m10 * lx + m11 * ly, hw + 1.5, hh + 1.5,
        m00, m01, m10, m11, -hw - 1.5, -hh - 1.5, hw + 1.5, hh + 1.5, hw, hh, P_TRI,
        s * 0.04, 0.0, 0.0, flag, a)
}

bb_part(
    cx: f32,
    cy: f32,
    s: f32,
    fx: f32,
    fy: f32,
    fw: f32,
    fh: f32,
    m00: f32,
    m01: f32,
    m10: f32,
    m11: f32,
    rgb: int,
    a: f32
) {
    lx: f32 = fx * s;
    ly: f32 = fy * s;
    p_box_xf(cx + m00 * lx + m01 * ly, cy + m10 * lx + m11 * ly, fw * s, fh * s, minf(fw,
        fh) * s * 0.5, 0.0, m00, m01, m10, m11, rgb, a)
}

// The shadow: a dent the shape of the tile, its flag faint, in the pose
// it must get to.
bb_draw_shadow(
    cx: f32,
    cy: f32,
    s: f32,
    p: int
) {
    pose_matrix(p);
    p_box(cx - s * 0.5, cy - s * 0.5, s, s, s * 0.18, mix_rgb(C_SUNK, C_LINE, 0.4),
        1.0);
    p_box(cx - s * 0.5 + 4.0, cy - s * 0.5 + 3.0, s - 8.0, s * 0.16, s * 0.12, C_SHADOW,
        0.05);
    bb_flag(cx, cy, s, pm00, pm01, pm10, pm11, mix_rgb(C_FAINT, C_SUNK, 0.2), mix_rgb(C_FAINT,
        C_SUNK, 0.1), 1.0)
}

// The slots: one for each move the level asks for, the moves made in them.
bb_draw_slots(
    cx: f32,
    cy: f32,
    total: int,
    left: int
) {
    if (total <= 0) return;
    sp: f32 = 50.0;
    made: int = total - left;
    // (The moves made, read off the proof: each a name chosen for an ∃.)
    k: int = 0;
    lx: int = find_lemma(sym("exI"));
    for m in 0..mv_n {
        if (mv_lemma[m] == lx && mv_wn[m] > 0 && k < 8) {
            wk_made[k] = gpool[mv_w0[m]];
            k = k + 1
        }
    }
    for i in 0..total {
        x: f32 = bb_bead_x(cx, sp, total, i);
        if (i < made && i < k) {
            p_shadow(x - 19.0, cy - 19.0, 38.0, 38.0, 19.0, 2.0, 5.0, 0.12);
            p_disc(x, cy, 19.0, C_CARD, 1.0);
            p_ring(x, cy, 19.0, 1.5, C_LINE, 1.0);
            bb_move_icon(x, cy, wk_made[i] == bd_flip, C_MUTED, 1.0)
        } else {
            p_disc(x, cy, 17.0, mix_rgb(C_SUNK, C_LINE, 0.4), 1.0);
            p_box(x - 14.0, cy - 15.0, 28.0, 9.0, 4.5, C_SHADOW, 0.05)
        }
    }
}

wk_made: []int = new int[8](0);

// A move's icon: a turn (an arrow round), a flip (a pennant and its
// mirror).
bb_move_icon(
    x: f32,
    y: f32,
    flip: bool,
    rgb: int,
    a: f32
) {
    if (flip) {
        p_line(x, y - 9.0, x, y + 9.0, 1.5, rgb, 0.5 * a);
        p_quad_xf(x + 6.0, y, 5.5, 6.5, 1.0, 0.0, 0.0, 1.0, -5.5, -6.5, 5.5, 6.5,
            4.0, 5.0, P_TRI, 1.0, 0.0, 0.0, rgb, a);
        p_quad_xf(x - 6.0, y, 5.5, 6.5, -1.0, 0.0, 0.0, 1.0, -5.5, -6.5, 5.5, 6.5,
            4.0, 5.0, P_TRI, 1.0, 0.0, 0.0, rgb, 0.45 * a);
        return
    }
    p_arc(x, y, 8.0, 2.4, -2.6, 4.2, rgb, a);
    // (Its head, at the arc's end, pointing on round.)
    e: f32 = -2.6 + 4.2;
    hx: f32 = x + cosf(e) * 8.0;
    hy: f32 = y + sinf(e) * 8.0;
    dx: f32 = -sinf(e);
    dy: f32 = cosf(e);
    p_quad_xf(hx + dx * 2.0, hy + dy * 2.0, 5.0, 5.0, dx, -dy, dy, dx, -5.0, -5.0,
        5.0, 5.0, 3.5, 4.0, P_TRI, 1.0, 0.0, 0.0, rgb, a)
}

// Can't get there: the words, and a way back.
bb_draw_walk_dead(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    t: f32 = clampf((now_t - dead_t) / 0.3, 0.0, 1.0);
    if (t < 1.0) busy = true;
    s: str = "It can't get there in the moves left";
    tw: f32 = p_str_w(0, 13.0, s) + 24.0;
    wx: f32 = x + w - tw - 14.0;
    p_box(wx, y - 12.0, tw, 24.0, 12.0, C_BG, t);
    pen_end = p_str(0, 13.0, wx + 12.0, y + 4.5, s, C_MUTED, t);
    // (Undo k, on the card's corner.)
    line_clear();
    line_add("Undo ");
    line_int(dead_undo_k());
    k: f32 = pressed(B_DEAD_UNDO);
    pw: f32 = p_line_w(1, 15.0) + 46.0;
    ph: f32 = 36.0;
    px: f32 = x + w - pw + 8.0;
    py: f32 = y + h - 16.0 + k * 1.5;
    p_shadow(px, py, pw, ph, 18.0, 2.0, 6.0, 0.1 * t);
    p_box(px, py, pw, ph, 18.0, C_CARD, t);
    p_outline(px, py, pw, ph, 18.0, 1.5, C_LINE, t);
    draw_icon(I_UNDO, px + 18.0, py + 18.0, 6.0, C_MUTED, t);
    p_line_text(1, 15.0, px + 32.0, py + 23.5, C_INK, t);
    add_button(B_DEAD_UNDO, px, py, px + pw, py + ph);
    dead_px = px + pw * 0.55;
    dead_py = py + ph * 0.5 + 6.0
}

// ---- the map of where the tile can be ----
// Each pose a place: unflipped round the outside (a turn goes on round),
// flipped inside (a turn goes round the other way), a flip straight
// across. Places are drawn once the tile has been there; roads once taken.
mp_x: []f32 = new f32[8](0.0);

mp_y: []f32 = new f32[8](0.0);

bb_draw_map(
    cx: f32,
    cy: f32,
    rad: f32,
    pos: int,
    tgt: int
) {
    ro: f32 = rad;
    ri: f32 = rad * 0.46;
    for p in 0..8 {
        k: int = p % 4;
        r: f32 = ro;
        if (p >= 4) {
            k = (4 - k) % 4;
            r = ri
        }
        ang: f32 = -1.5708 + k as f32 * 1.5708;
        mp_x[p] = cx + cosf(ang) * r;
        mp_y[p] = cy + sinf(ang) * r
    }
    // (The long way a level gives, faint.)
    bb_draw_trail();
    // (Roads taken, dotted, as the map of levels draws its path.)
    for p in 0..8 {
        for m in 0..2 {
            if (wk_road[p * 2 + m]) {
                q: int = pose_turn(p);
                if (m == 1) q = pose_flip(p);
                bb_dots(mp_x[p], mp_y[p], mp_x[q], mp_y[q], C_FAINT, 1.0)
            }
        }
    }
    ms: f32 = clampf(rad * 0.34, 24.0, 42.0);
    for p in 0..8 {
        if (wk_seen[p] || p == tgt) {
            a: f32 = 1.0;
            if (!wk_seen[p]) a = 0.0;
            if (p == tgt) p_ring(mp_x[p], mp_y[p], ms * 0.82, 2.0, C_PICK, 0.7);
            if (wk_seen[p]) {
                pose_matrix(p);
                bb_draw_tile(mp_x[p], mp_y[p], ms, pm00, pm01, pm10, pm11, a, false)
            } else {
                pose_matrix(p);
                bb_draw_shadow(mp_x[p], mp_y[p], ms, p)
            }
            if (p == pos) p_disc(mp_x[p] + ms * 0.5, mp_y[p] - ms * 0.5, 5.0, C_INK,
                0.75)
        }
    }
}

// Dots from (x0, y0) to (x1, y1), clear of the places at each end.
bb_dots(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    rgb: int,
    a: f32
) {
    d: f32 = sqrtf((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0));
    if (d < 1.0) return;
    k: int = (d / 8.0) as int;
    for i in 0..k + 1 {
        t: f32 = i as f32 / k as f32;
        e: f32 = t * d;
        if (e > 20.0 && e < d - 20.0) p_disc(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t,
            2.2, rgb, a)
    }
}

// The walk a level's shadow was got by (A short cut): its places and roads,
// faint.
bb_draw_trail() {
    if (cur_level < 0) return;
    q: int = rel_core(lv_goal[cur_level]);
    while (shape_of(q) == SH_EX && tm_kind(tm_arg(q)) == TM_ABS) q = rel_core(tm_body(tm_arg(q)));
    if (!is_binary(q, role_name[ROLE_EQ])) return;
    t: int = spine_arg(q, 2, 1);
    // (Its moves, innermost first.)
    k: int = 0;
    while (tm_kind(t) == TM_APP && spine_len(t) == 2 && tm_name(spine_head(t)) == sym("act") && k < 8) {
        wk_trail[k] = tm_name(spine_arg(t, 2, 0));
        k = k + 1;
        t = spine_arg(t, 2, 1)
    }
    if (k == 0) return;
    p: int = 0;
    i: int = k - 1;
    while (i >= 0) {
        q2: int = pose_turn(p);
        if (wk_trail[i] == sym("flip")) q2 = pose_flip(p);
        bb_dots(mp_x[p], mp_y[p], mp_x[q2], mp_y[q2], mix_rgb(C_PICK, C_BG, 0.45),
            1.0);
        if (!wk_seen[q2]) p_disc(mp_x[q2], mp_y[q2], 4.0, mix_rgb(C_PICK, C_BG, 0.45),
            1.0);
        p = q2;
        i = i - 1
    }
}

wk_trail: []int = new int[8](0);

// ---- a level begun ----
bb_start() {
    bb_clear();
    bk_clear();
    bsk_on = false;
    bdg_on = false;
    wk_shown = -1;
    wk_t0 = -10.0;
    gc_h = 0.0
}

// ---- a gesture as a finger makes it (for the hint, Watch, demos) ----
// Gesture kind (j, t; its place in gq_) on the board now: ga_ as
// gesture_at sets them. Whether it is there.
bb_gesture_at(kind: int, j: int, t: int): bool {
    ga_tap = false;
    ga_swipe = false;
    ga_fill = 0;
    if (kind == GS_WALK) {
        ga_x0 = tl_x;
        ga_y0 = tl_y;
        if (t == bd_flip) {
            ga_swipe = true;
            ga_x0 = tl_x - tl_s * 0.45;
            ga_x1 = tl_x + tl_s * 0.75;
            ga_y1 = tl_y
        } else ga_tap = true;
        return true
    }
    if (kind == GS_TURN) {
        ga_swipe = true;
        ga_x0 = gc_x + gc_w * 0.25;
        ga_y0 = gc_y + gc_h * 0.5;
        ga_x1 = ga_x0 + 160.0;
        ga_y1 = ga_y0;
        return true
    }
    side: int = gq_side;
    if (side < 0 || side > 1) return false;
    b: int = side * GB;
    if (kind == GS_POP) {
        if (gq_i < 0 || gq_i + 1 >= gb_n[side]) return false;
        ga_x0 = gb_x[b + gq_i];
        ga_y0 = gb_row[side];
        ga_x1 = gb_x[b + gq_i + 1];
        ga_y1 = ga_y0;
        return true
    }
    if (kind == GS_PAIR) {
        k: int = bb_shelf_of(t);
        if (k < 0) return false;
        ga_x0 = sh_x[k];
        ga_y0 = sh_y;
        ga_x1 = bb_gap_x(side, gq_i);
        ga_y1 = gb_row[side];
        return true
    }
    if (kind == GS_STAMP) {
        sk: int = -1;
        for i in 0..st_n2 {
            if (stp_hyp[i] == j) sk = i
        }
        if (sk < 0) return false;
        ga_x0 = (st_x0[sk] + st_seam[sk]) * 0.5;
        if (gq_face == 1) ga_x0 = (st_seam[sk] + st_x1[sk]) * 0.5;
        ga_y0 = (st_y0[sk] + st_y1[sk]) * 0.5;
        ga_y1 = gb_row[side];
        ga_fill = t;
        if (gq_k == 0) {
            ga_x1 = bb_gap_x(side, gq_i);
            return true
        }
        // (A bead of the stretch that a tap there finds it by.)
        si: int = gq_i;
        sk2: int = gq_k;
        sf: int = gq_face;
        pick: int = gq_i + (gq_k - 1) / 2;
        found: bool = false;
        for i in si..si + sk2 {
            if (!found && bb_stretch_at(j, sf, side, i) && gq_i == si && gq_k == sk2) {
                pick = i;
                found = true
            }
        }
        gq_side = side;
        gq_i = si;
        gq_k = sk2;
        gq_face = sf;
        if (pick >= gb_n[side]) return false;
        ga_x1 = gb_x[b + pick];
        ga_fill = 0;
        if (t != 0 && bb_face_n(j, sf) == 0) ga_fill = t;
        return true
    }
    false
}

// Shelf bead t: where it is (ga_x0, ga_y0).
bb_shelf_at(t: int): bool {
    k: int = bb_shelf_of(t);
    if (k < 0) return false;
    ga_x0 = sh_x[k];
    ga_y0 = sh_y;
    true
}

// ---- L8_DO, for pictures (main.l8 reads the words) ----
//   tap bead top 1 | tap gap bottom 0 | tap stamp 0 face 1 | tap shelf a
//   tap shelf a' (turned over) | tap tile
// Into (ga_x0, ga_y0). Whether it is there.
bb_do_tap_at(): bool {
    if (dw_is("tile")) {
        ga_x0 = tl_x;
        ga_y0 = tl_y;
        return true
    }
    if (dw_is("bead") || dw_is("gap")) {
        gap: bool = dw_is("gap");
        if (!do_word()) return false;
        side: int = 0;
        if (dw_is("bottom")) side = 1;
        if (!do_word()) return false;
        i: int = dw_num();
        ga_y0 = gb_row[side];
        if (gap) {
            if (i > gb_n[side]) return false;
            ga_x0 = bb_gap_x(side, i);
            return true
        }
        if (i >= gb_n[side]) return false;
        ga_x0 = gb_x[side * GB + i];
        return true
    }
    if (dw_is("stamp")) {
        if (!do_word()) return false;
        j: int = dw_num();
        f: int = 0;
        save: int = dw_at;
        if (do_word() && dw_is("face") && do_word()) f = dw_num() else dw_at = save;
        for k in 0..st_n2 {
            if (stp_hyp[k] == j) {
                ga_x0 = (st_x0[k] + st_seam[k]) * 0.5;
                if (f == 1) ga_x0 = (st_seam[k] + st_x1[k]) * 0.5;
                ga_y0 = (st_y0[k] + st_y1[k]) * 0.5;
                return true
            }
        }
        return false
    }
    if (dw_is("shelf")) {
        if (!do_word()) return false;
        k: int = bb_dw_shelf();
        if (k < 0) return false;
        ga_x0 = sh_x[k];
        ga_y0 = sh_y;
        return true
    }
    false
}

// The shelf bead the word names: a, or a' (or a⁻¹) turned over.
bb_dw_shelf(): int {
    turned: bool = false;
    b: int = dw_b;
    if (b > dw_a && do_buf[b - 1] as int == 39) {
        turned = true;
        b = b - 1
    }
    // (⁻¹ is 5 bytes: ⁻ (3) and ¹ (2).)
    if (b - dw_a > 5 && (do_buf[b - 2] as int & 255) == 194 && (do_buf[b - 1] as int & 255) == 185) {
        turned = true;
        b = b - 5
    }
    s: int = sym_of(do_buf, dw_a, b);
    for i in 0..sh_n {
        if (tm_name(sh_atom[i]) == s && sh_flip[i] == turned) return i
    }
    -1
}

//   pop top 1                  bead 1 dragged onto bead 2 (pinched, pops)
//   pinch top 1 2              beads 1 to 2 pinched (held)
//   shelf a' > top 0           a turned over carried to gap 0
//   stamp 0 face 1 > top 1     face 1 carried to bead 1 (an empty face:
//   stamp 0 face 1 > gap top 4   to a gap)
//   swipe | tile               the strings turned round, or the tile
//                              flipped; the tile tapped
// Whether the step was one of these.
bb_do_step(ms: f32, hold: bool): bool {
    if (dw_is("tile")) {
        do_tap(tl_x, tl_y, hold);
        return true
    }
    if (dw_is("swipe")) {
        x0: f32 = gc_x + gc_w * 0.25;
        y0: f32 = gc_y + gc_h * 0.5;
        if (bb_walk()) {
            x0 = tl_x - tl_s * 0.45;
            y0 = tl_y
        }
        pp_carry(x0, y0, x0 + 170.0, y0, ms, hold, false);
        return true
    }
    if (dw_is("pop") || dw_is("pinch")) {
        pinch: bool = dw_is("pinch");
        if (!do_word()) return true;
        side: int = 0;
        if (dw_is("bottom")) side = 1;
        if (!do_word()) return true;
        i: int = dw_num();
        j: int = i + 1;
        if (pinch && do_word()) j = dw_num();
        if (j >= gb_n[side] || i >= gb_n[side]) {
            do_say("no such bead");
            return true
        }
        b: int = side * GB;
        pp_carry(gb_x[b + i], gb_row[side], gb_x[b + j], gb_row[side], ms, hold, false);
        return true
    }
    if (dw_is("shelf") || dw_is("stamp")) {
        shelf: bool = dw_is("shelf");
        if (!do_word()) return true;
        if (shelf) {
            k: int = bb_dw_shelf();
            if (k < 0) {
                do_say("no such bead on the shelf");
                return true
            }
            ga_x0 = sh_x[k];
            ga_y0 = sh_y
        } else {
            j: int = dw_num();
            f: int = 0;
            if (!do_word()) return true;
            if (dw_is("face") && do_word()) {
                f = dw_num();
                if (!do_word()) return true
            }
            found: bool = false;
            for k in 0..st_n2 {
                if (stp_hyp[k] == j) {
                    ga_x0 = (st_x0[k] + st_seam[k]) * 0.5;
                    if (f == 1) ga_x0 = (st_seam[k] + st_x1[k]) * 0.5;
                    ga_y0 = (st_y0[k] + st_y1[k]) * 0.5;
                    found = true
                }
            }
            if (!found) {
                do_say("no such stamp");
                return true
            }
        }
        if (shelf && !do_word()) return true;
        if (!dw_is(">") || !do_word()) {
            do_say("shelf N > top I; stamp J face F > top I");
            return true
        }
        gap: bool = shelf;
        if (dw_is("gap")) {
            gap = true;
            if (!do_word()) return true
        }
        side: int = 0;
        if (dw_is("bottom")) side = 1;
        if (!do_word()) return true;
        i: int = dw_num();
        if (gap) ga_x1 = bb_gap_x(side, i) else if (i < gb_n[side]) ga_x1 = gb_x[side * GB + i] else {
            do_say("no such bead");
            return true
        }
        // (Carried things ride above the finger: the finger goes under the
        // place.)
        ga_y1 = gb_row[side] + LIFT_UP;
        pp_carry(ga_x0, ga_y0, ga_x1, ga_y1, ms, hold, false);
        return true
    }
    false
}

// ---- for pictures: the board printed (L8_BOXES) ----
bb_boxes_print() {
    if (!boxes_on || boxes_at < 0.0 || now_t < boxes_at || !lang_on()) return;
    boxes_at = -1.0;
    line_clear();
    line_add("-- beads at ");
    line_int((now_t * 100.0) as int);
    line_add(" (moves ");
    line_int(moves_made);
    line_add(", on the book's path ");
    line_int(on_path);
    if (lang_dead()) line_add(", DEAD");
    if (done_t >= 0.0) line_add(", DONE");
    if (bsk_valid()) line_add(", SOCKET");
    line_add(")");
    line_print_safe();
    if (bb_walk()) {
        line_clear();
        line_add("tile ");
        line_int(tl_x as int);
        line_add(",");
        line_int(tl_y as int);
        line_add(" pose ");
        line_int(wk_shown);
        line_print_safe();
        return
    }
    for side in 0..2 {
        line_clear();
        if (side == 0) line_add("top   ") else line_add("bottom");
        line_add(" y ");
        line_int(gb_row[side] as int);
        line_add(":");
        for i in 0..gb_n[side] {
            line_add(" ");
            line_sym(tm_name(gb_atom[side * GB + i]));
            if (gb_flip[side * GB + i]) line_add("'");
            line_add("@");
            line_int(gb_x[side * GB + i] as int)
        }
        line_print_safe()
    }
    for k in 0..st_n2 {
        line_clear();
        line_add("stamp ");
        line_int(stp_hyp[k]);
        line_add(" ");
        line_int(st_x0[k] as int);
        line_add(",");
        line_int(st_y0[k] as int);
        line_add(" ");
        line_int(st_x1[k] as int);
        line_add(",");
        line_int(st_y1[k] as int);
        line_add(" seam ");
        line_int(st_seam[k] as int);
        line_print_safe()
    }
    line_clear();
    line_add("shelf y ");
    line_int(sh_y as int);
    line_add(":");
    for i in 0..sh_n {
        line_add(" ");
        line_sym(tm_name(sh_atom[i]));
        if (sh_flip[i]) line_add("'");
        line_add("@");
        line_int(sh_x[i] as int)
    }
    line_print_safe()
}

// ---- a level's statement as beads (its title card, the Book) ----
// The facts as small stamps, then the two strings (or, for a walk, the
// tile and its shadow), centred on cx from y. How tall.
bb_draw_statement(
    l: int,
    cx: f32,
    y: f32,
    w: f32,
    a: f32
): f32 {
    bd_syms();
    p: int = lv_goal[l];
    r: f32 = 13.0;
    sp: f32 = 2.0 * r + 4.0;
    yy: f32 = y;
    if (bd_mode_of(l) == BM_WALK) {
        q: int = rel_core(p);
        while (shape_of(q) == SH_EX && tm_kind(tm_arg(q)) == TM_ABS) q = rel_core(tm_body(tm_arg(q)));
        s: f32 = 54.0;
        bb_draw_tile(cx - 44.0, y + s * 0.5 + 8.0, s, 1.0, 0.0, 0.0, 1.0, a, false);
        // (The shadow, from the statement's other side, worked out.)
        tgt: int = bb_statement_target(l);
        if (tgt >= 0) bb_draw_shadow(cx + 44.0, y + s * 0.5 + 8.0, s, tgt);
        return s + 16.0
    }
    // (Facts first.)
    q: int = p;
    while (is_imp(q)) {
        h: int = lhs_of(q);
        ok: bool = false;
        try {
            ok = bd_is_stamp(h)
        } with KernelError -> {
            ok = false
        }
        if (ok) yy = yy + bb_draw_mini_stamp(h, cx, yy, r, a) + 10.0;
        q = rhs_of(q)
    }
    // (The two strings.)
    for side in 0..2 {
        bs_n = 0;
        st: int = bd_side_term(q, side);
        if (st != 0) bd_flatten(st, false);
        ry: f32 = yy + r + 6.0;
        p_line(cx - w * 0.5 + 20.0, ry, cx + w * 0.5 - 20.0, ry, 1.5, mix_rgb(C_LINE,
            C_MUTED, 0.25), a);
        k: int = bs_n;
        for i in 0..k {
            ka: int = bs_atom[i];
            kf: bool = bs_flip[i];
            bb_bead(bb_bead_x(cx, sp, k, i), ry, r, ka, kf, 1.0, 1.0, a, 0.0)
        }
        yy = yy + 2.0 * r + 14.0
    }
    yy - y
}

// The pose the shadow of walk level l is in (its goal's right side).
bb_statement_target(l: int): int {
    q: int = rel_core(lv_goal[l]);
    while (shape_of(q) == SH_EX && tm_kind(tm_arg(q)) == TM_ABS) q = rel_core(tm_body(tm_arg(q)));
    if (!is_binary(q, role_name[ROLE_EQ])) return -1;
    bb_pose_walk(spine_arg(q, 2, 1))
}

// The pose a walk written out comes to (act(turn, act(flip, sq(A, B, C,
// D)))), worked out by the two moves (for pictures only), or -1.
bb_pose_walk(t: int): int {
    if (spine_len(t) == 2 && tm_name(spine_head(t)) == sym("act")) {
        p: int = bb_pose_walk(spine_arg(t, 2, 1));
        if (p < 0) return -1;
        if (tm_name(spine_arg(t, 2, 0)) == sym("flip")) return pose_flip(p);
        return pose_turn(p)
    }
    if (spine_len(t) != 4 || tm_name(spine_head(t)) != sym("sq")) return -1;
    ia: int = -1;
    for i in 0..4 {
        if (tm_name(spine_arg(t, 4, i)) == sym("A")) ia = i
    }
    if (ia < 0) return -1;
    if (tm_name(spine_arg(t, 4, (ia + 1) % 4)) == sym("B")) return ia;
    (ia + 3) % 4 + 4
}

// A fact as a small stamp at (cx, y): how tall.
bb_draw_mini_stamp(
    h: int,
    cx: f32,
    y: f32,
    r: f32,
    a: f32
): f32 {
    sp: f32 = 2.0 * r + 4.0;
    n0: int = 0;
    n1: int = 0;
    ok: bool = false;
    try {
        ok = bd_face_string(h, 0)
    } with KernelError -> {
        ok = false
    }
    if (!ok) return 0.0;
    n0 = pf_n;
    for i in 0..pf_n {
        ms_atom[i] = pf_atom[i];
        ms_flip[i] = pf_flip[i]
    }
    try {
        ok = bd_face_string(h, 1)
    } with KernelError -> {
        ok = false
    }
    n1 = pf_n;
    w0: f32 = maxf(n0 as f32, 1.0) * sp + 18.0;
    w1: f32 = maxf(n1 as f32, 1.0) * sp + 18.0;
    x0: f32 = cx - (w0 + w1) * 0.5;
    h2: f32 = 2.0 * r + 16.0;
    p_box(x0, y, w0 + w1, h2, 14.0, C_BLUE_SOFT, a);
    p_line(x0 + w0, y + 6.0, x0 + w0, y + h2 - 6.0, 1.5, mix_rgb(C_BLUE_SOFT, C_BLUE,
        0.3), a);
    cy: f32 = y + h2 * 0.5;
    if (n0 == 0) bb_dent(x0 + w0 * 0.5, cy, r, a);
    for i in 0..n0 bb_bead(bb_bead_x(x0 + w0 * 0.5, sp, n0, i), cy, r, ms_atom[i],
        ms_flip[i], 1.0, 1.0, a, 0.0);
    if (n1 == 0) bb_dent(x0 + w0 + w1 * 0.5, cy, r, a);
    for i in 0..n1 bb_bead(bb_bead_x(x0 + w0 + w1 * 0.5, sp, n1, i), cy, r, pf_atom[i],
        pf_flip[i], 1.0, 1.0, a, 0.0);
    h2
}

ms_atom: []int = new int[64](0);

ms_flip: []bool = new bool[64](false);

// ---- the chapter's pages ----
// Its cover: the tile, and a few beads on a string.
bb_cover(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    cx: f32 = x + w * 0.5;
    cy: f32 = y + h * 0.5;
    s: f32 = minf(h * 0.6, 50.0);
    pose_matrix(1);
    bb_draw_tile(cx - w * 0.27, cy, s, pm00, pm01, pm10, pm11, 1.0, false);
    r: f32 = minf(h * 0.15, 12.0);
    sp: f32 = 2.0 * r + 3.0;
    bx: f32 = cx + w * 0.17;
    p_line(bx - 2.0 * sp, cy, bx + 2.0 * sp, cy, 1.5, mix_rgb(C_LINE, C_MUTED, 0.3),
        1.0);
    bb_bead_n(bx - sp, cy, r, sym("a"), false, 1.0, 1.0, 1.0, 0.0);
    bb_bead_n(bx, cy, r, sym("b"), false, 1.0, 1.0, 1.0, 0.0);
    bb_bead_n(bx + sp, cy, r, sym("b"), true, 1.0, 1.0, 1.0, 0.0)
}

// The chapter's first page, under its sentence: what can be done, each a
// small picture and a few plain words (no rulebook). The y after.
bb_chapter_things(
    x: f32,
    y0: f32,
    w: f32,
    t: f32
): f32 {
    y: f32 = y0 + 6.0;
    for k in 0..3 {
        pk: f32 = clampf((t - 0.3 - k as f32 * 0.08) / 0.25, 0.0, 1.0);
        h: f32 = 70.0;
        if (pk > 0.0) {
            p_shadow(x, y, w, h, 18.0, 2.0, 8.0, 0.08 * pk);
            p_box(x, y, w, h, 18.0, C_CARD, pk);
            p_outline(x, y, w, h, 18.0, 1.5, C_LINE, pk);
            cy: f32 = y + h * 0.5;
            px: f32 = x + 70.0;
            s: str = "";
            if (k == 0) {
                pose_matrix(0);
                bb_draw_tile(px - 22.0, cy, 34.0, pm00, pm01, pm10, pm11, pk, false);
                pose_matrix(1);
                bb_draw_tile(px + 24.0, cy, 34.0, pm00, pm01, pm10, pm11, pk, false);
                s = "A tile turns, and flips over."
            } else if (k == 1) {
                bb_bead_n(px - 18.0, cy, 15.0, sym("a"), false, 1.0, 1.0, pk, 0.0);
                bb_bead_n(px + 15.0, cy, 15.0, sym("a"), true, 1.0, 1.0, pk, 0.0);
                s = "A bead and its turned-over twin pop."
            } else {
                p_box(px - 44.0, cy - 19.0, 88.0, 38.0, 14.0, C_BLUE_SOFT, pk);
                p_line(px, cy - 13.0, px, cy + 13.0, 1.5, mix_rgb(C_BLUE_SOFT, C_BLUE,
                    0.3), pk);
                bb_bead_n(px - 33.0, cy, 10.0, sym("a"), false, 1.0, 1.0, pk, 0.0);
                bb_bead_n(px - 12.0, cy, 10.0, sym("b"), false, 1.0, 1.0, pk, 0.0);
                bb_bead_n(px + 22.0, cy, 10.0, sym("c"), false, 1.0, 1.0, pk, 0.0);
                s = "A card says two strings are the same."
            }
            pen_end = p_str(0, 15.0, x + 138.0, cy + 5.5, s, C_INK, pk)
        }
        y = y + h + 8.0
    }
    y
}

// ---- the Book of the chapter ----
// What the pictures stand for, in the words books use (said after the
// fact: no level needs them); the theorems proved, each as its beads and
// as books write it; those still to prove, faint.
bb_draw_book() {
    x: f32 = col_x();
    w: f32 = col_w();
    hy: f32 = safe_top + 34.0;
    round_button(B_BACK, x + 22.0, hy, I_BACK);
    line_clear();
    line_add("The Book of ");
    if (region_title != 0) line_sym(region_title);
    pen_end = p_line_text(1, 18.0, x + 56.0, hy + 6.0, C_INK, 1.0);
    top: f32 = hy + 34.0;
    p_clip(0.0, top, view_w(), view_h());
    y: f32 = top + 10.0 - sc_pos[V_PROOF];
    bd_syms();
    y = y + draw_wrapped(0, 15.0, x + 6.0, y + 6.0, w - 12.0, sym("Everything here holds in every group: things put together in a row, a thing that changes nothing, and a way to undo each. This is what the pictures stand for, in the words books use."),
        C_MUTED, 1.0) + 14.0;
    p_str(1, 13.0, x + 6.0, y + 14.0, "WHAT THE PICTURES MEAN", C_MUTED, 1.0);
    y = y + 24.0;
    for k in 0..5 y = bb_book_meaning(k, x, y, w) + 8.0;
    y = y + 10.0;
    for pass in 0..2 {
        shown: bool = false;
        for l in 0..lv_n {
            if (!lv_given[l] && level_proved_here(l) == (pass == 0)) {
                if (!shown) {
                    hd: str = "PROVED";
                    if (pass == 1) hd = "STILL TO PROVE";
                    p_str(1, 13.0, x + 6.0, y + 14.0, hd, C_MUTED, 1.0);
                    y = y + 24.0;
                    shown = true
                }
                y = bb_book_level(l, x, y, w, pass == 0) + 8.0
            }
        }
        if (shown) y = y + 10.0
    }
    sc_most[V_PROOF] = y + 40.0 + sc_pos[V_PROOF] - view_h();
    p_noclip()
}

// One meaning: a picture, a plain sentence, and how books write it. The y
// after.
bb_book_meaning(
    k: int,
    x: f32,
    y: f32,
    w: f32
): f32 {
    rule: str = "assoc";
    s: str = "Beads in a row: how they are grouped does not matter, so there are no brackets.";
    if (k == 1) {
        rule = "id_left";
        s = "No bead at all: e, the identity, which changes nothing it is put with."
    }
    if (k == 2) {
        rule = "inv_right";
        s = "A bead turned over is its inverse: with it, it makes nothing."
    }
    if (k == 3) {
        rule = "inv_mul";
        s = "Undoing a whole string: it turned round, every bead turned over."
    }
    if (k == 4) {
        rule = "";
        s = "The tile: the eight ways it can lie are a group too, its symmetries; each way is a string of turns and flips."
    }
    l: int = -1;
    if (rule != "") l = find_lemma(sym(rule));
    e: int = -1;
    eh: f32 = 0.0;
    if (l >= 0) {
        e = lay_term(thm_prop(lm_thm[l]), 15.0, w - 150.0, 8000000 + l);
        eh = ex_h[e] + 8.0
    }
    p_scratch_set(s);
    th: f32 = bb_wrapped_h(s, w - 150.0);
    h: f32 = maxf(th + eh + 26.0, 74.0);
    p_shadow(x, y, w, h, 16.0, 2.0, 8.0, 0.08);
    p_box(x, y, w, h, 16.0, C_CARD, 1.0);
    // (The picture, on the left.)
    cx: f32 = x + 62.0;
    cy: f32 = y + h * 0.5;
    r: f32 = 12.0;
    sp: f32 = 2.0 * r + 3.0;
    if (k == 0) {
        for i in 0..3 bb_bead_n(cx + (i as f32 - 1.0) * sp, cy, r, sym("a") + 0 * i,
            i == 1, 1.0, 1.0, 1.0, 0.0);
        bb_bead_n(cx + sp, cy, r, sym("c"), false, 1.0, 1.0, 1.0, 0.0);
        bb_bead_n(cx - sp, cy, r, sym("a"), false, 1.0, 1.0, 1.0, 0.0);
        bb_bead_n(cx, cy, r, sym("b"), false, 1.0, 1.0, 1.0, 0.0)
    } else if (k == 1) {
        p_line(cx - 40.0, cy, cx + 40.0, cy, 1.5, mix_rgb(C_LINE, C_MUTED, 0.3), 1.0);
        p_disc(cx - 40.0, cy, 3.0, mix_rgb(C_LINE, C_MUTED, 0.3), 1.0);
        p_disc(cx + 40.0, cy, 3.0, mix_rgb(C_LINE, C_MUTED, 0.3), 1.0)
    } else if (k == 2) {
        bb_bead_n(cx - sp * 0.5, cy, r, sym("a"), false, 1.0, 1.0, 1.0, 0.0);
        bb_bead_n(cx + sp * 0.5, cy, r, sym("a"), true, 1.0, 1.0, 1.0, 0.0)
    } else if (k == 3) {
        bb_bead_n(cx - sp * 0.5, cy - 15.0, r * 0.8, sym("a"), false, 1.0, 1.0, 1.0,
            0.0);
        bb_bead_n(cx + sp * 0.5, cy - 15.0, r * 0.8, sym("b"), false, 1.0, 1.0, 1.0,
            0.0);
        bb_bead_n(cx - sp * 0.5, cy + 15.0, r * 0.8, sym("b"), true, 1.0, 1.0, 1.0,
            0.0);
        bb_bead_n(cx + sp * 0.5, cy + 15.0, r * 0.8, sym("a"), true, 1.0, 1.0, 1.0,
            0.0)
    } else {
        pose_matrix(0);
        bb_draw_tile(cx - 20.0, cy, 32.0, pm00, pm01, pm10, pm11, 1.0, false);
        pose_matrix(5);
        bb_draw_tile(cx + 20.0, cy, 32.0, pm00, pm01, pm10, pm11, 1.0, false)
    }
    tx: f32 = x + 128.0;
    pen_end = draw_wrapped(0, 14.0, tx, y + 24.0, w - 150.0, sym(s), C_INK, 1.0);
    if (e >= 0) draw_expr(e, tx, y + 24.0 + th, C_MUTED, 1.0, false);
    y + h
}

// How tall words wrapped to width w are (at the Book's size).
bb_wrapped_h(s: str, w: f32): f32 {
    draw_wrapped(0, 14.0, 0.0, 0.0, w, sym(s), C_INK, 0.0)
}

// One level in the Book: its title, its statement as beads (or the tile),
// and as books write it. The y after.
bb_book_level(
    l: int,
    x: f32,
    y: f32,
    w: f32,
    proved: bool
): f32 {
    sh: f32 = bb_draw_statement(l, x + w * 0.5, y + 10000.0, w - 40.0, 0.0);
    e: int = lay_term(lv_goal[l], 14.0, w - 32.0, 8500000 + l);
    h: f32 = 30.0 + sh + 10.0 + ex_h[e] + 16.0;
    a: f32 = 1.0;
    if (proved) {
        p_shadow(x, y, w, h, 16.0, 2.0, 8.0, 0.08);
        p_box(x, y, w, h, 16.0, C_CARD, 1.0)
    } else {
        a = 0.55;
        p_box(x, y, w, h, 16.0, mix_rgb(C_SUNK, C_BG, 0.4), 1.0);
        p_outline(x, y, w, h, 16.0, 1.5, C_LINE, 1.0)
    }
    if (lv_title[l] != 0) p_sym(1, 14.0, x + 16.0, y + 22.0, lv_title[l], C_MUTED,
        1.0);
    pen_end = bb_draw_statement(l, x + w * 0.5, y + 32.0, w - 40.0, a);
    draw_expr(e, x + 16.0, y + 32.0 + sh + 8.0, C_MUTED, a, false);
    y + h
}
