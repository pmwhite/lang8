tag lemma_ui;

use_tag std, skate, lemma;

// The game's state, and what each tap does.
//
// Pages: the map (the regions, each a row of levels), a level being
// played, a finished proof written out, and the region's rules. On a
// level, the player focuses a statement (a tap on it) and plays a row of
// the hand (hand.l8); a move that needs a term offers chips to pick it
// from. Undo takes back the last move; the bulb gives a hint, or (held)
// plays the written proof.
const PAGE_MAP: int = 0;

const PAGE_LEVEL: int = 1;

const PAGE_PROOF: int = 2;

// The region's rules: its rulebook, definitions, and the lemmas proved.
const PAGE_RULES: int = 3;

page: int = 0;

// The buttons.
const B_LEVEL: int = 1000;

const B_BACK: int = 10;

const B_UNDO: int = 11;

const B_PROOF: int = 12;

const B_NEXT: int = 13;

const B_MAP: int = 14;

const B_AGAIN: int = 15;

const B_WATCH: int = 19;

const B_RULES: int = 20;

// An expression a finger can pick a block of (by its number).
const B_EXPR: int = 10000;

// ---- regions ----
const REGIONS: int = 8;

region_files: []str = ["programs/lemma/regions/logic.txt", "programs/lemma/regions/groups.txt",
    "programs/lemma/regions/analysis.txt"];

const MAP_LEVELS: int = 64;

// What the map shows of each region, read when the game starts: its name,
// title and words, and its levels' names, titles and pars.
rg_n: int = 0;

rg_name: []int = new int[REGIONS](0);

rg_title: []int = new int[REGIONS](0);

rg_lv0: []int = new int[REGIONS](0);

// Each region's picture (its chapter cover shows it), or 0.
rg_pic: []int = new int[REGIONS](0);

rg_lvn: []int = new int[REGIONS](0);

ml_name: []int = new int[MAP_LEVELS](0);

ml_title: []int = new int[MAP_LEVELS](0);

ml_par: []int = new int[MAP_LEVELS](0);

// The level's number in its region's file (its lv_ number when loaded).
ml_index: []int = new int[MAP_LEVELS](0);

ml_n: int = 0;

// The player's progress: each map level solved, and in how few moves.
ml_solved: []bool = new bool[MAP_LEVELS](false);

ml_best: []int = new int[MAP_LEVELS](0);

// The region loaded now (-1 none), and the map level being played.
loaded_region: int = -1;

playing: int = -1;

// Read each region once, for the map.
read_map() raises KernelError {
    rg_n = 0;
    ml_n = 0;
    for r in 0..len(region_files) {
        if (load_region_file(r)) {
            rg_name[rg_n] = region_name;
            rg_title[rg_n] = region_title;
            rg_pic[rg_n] = region_picture;
            rg_lv0[rg_n] = ml_n;
            for l in 0..lv_n {
                if (!lv_given[l] && ml_n < MAP_LEVELS) {
                    ml_name[ml_n] = lv_name[l];
                    ml_title[ml_n] = lv_title[l];
                    ml_par[ml_n] = lv_par[l];
                    ml_index[ml_n] = l;
                    ml_tool[ml_n] = 0;
                    if (lv_tooln[l] > 0) ml_tool[ml_n] = pool[lv_tool0[l]];
                    ml_n = ml_n + 1
                }
            }
            rg_lvn[rg_n] = ml_n - rg_lv0[rg_n];
            rg_n = rg_n + 1
        }
    }
    loaded_region = -1
}

// The texts of the theory files, read once, one after another in files_buf:
// the logic's (0), then each region's (1 on). Where each starts, and how
// long it is (-1 if it could not be read).
const FILES: int = 8;

const FILES_BYTES: int = 1048576;

files_buf: []i8 = new i8[FILES_BYTES](0i8);

files_used: int = 0;

file_at: []int = new int[FILES](0);

file_len: []int = new int[FILES](-1);

// File i's text, from a buffer read (n bytes of it).
keep_file(i: int, t: []i8, n: int) {
    if (n < 0 || files_used + n > FILES_BYTES) return;
    file_at[i] = files_used;
    for k in 0..n files_buf[files_used + k] = t[k];
    file_len[i] = n;
    files_used = files_used + n
}

// The logic read, and its derived rules proved. Whether it was.
load_logic_file() raises KernelError: bool {
    if (file_len[0] < 0) return false;
    try {
        load_theory_at(files_buf, file_at[0], file_at[0] + file_len[0])
    } with TheoryError -> {
        line_clear();
        line_add("lemma: hol.txt line ");
        line_int(theory_line);
        line_add(": ");
        line_add(theory_why);
        toast_line();
        return false
    }
    close_axioms();
    if (!prove_given()) return false;
    mark_logic();
    true
}

// Region r's file loaded (the logic first, once). Whether it was.
load_region_file(r: int) raises KernelError: bool {
    reset_to_logic();
    if (file_len[r + 1] < 0) return false;
    try {
        load_theory_at(files_buf, file_at[r + 1], file_at[r + 1] + file_len[r + 1])
    } with TheoryError -> {
        line_clear();
        line_add("lemma: ");
        line_add(region_files[r]);
        line_add(" line ");
        line_int(theory_line);
        line_add(": ");
        line_add(theory_why);
        toast_line();
        return false
    }
    if (!prove_given()) return false;
    loaded_region = r;
    true
}

// Region r loaded to play in: its levels' lemmas proved again (by their
// written proofs), so a solved level is a tool for the ones after it.
enter_region(r: int) raises KernelError {
    if (loaded_region == r) return;
    if (!load_region_file(r)) return;
    for l in 0..lv_n {
        if (!lv_given[l] && lv_lemma[l] < 0 && run_proof(l)) level_solved(l)
    }
}

// ---- playing a level ----
// Moves made by the player in this level so far.
moves_made: int = 0;

// When the level was finished (or -1).
done_t: f32 = -1.0;

// When the level was opened (its title card shows a moment), and whether
// that card was put away.
intro_t0: f32 = 0.0;

intro_open: bool = true;

// A chapter's first page (the first time one of its levels is opened
// from the map): its picture, its one sentence, its rulebook as tiles.
// The level's title card waits under it.
chapter_open: bool = false;

chapter_t0: f32 = 0.0;

// Level m opened by the player (the map, Next): its chapter's page first,
// the first time.
open_level(m: int) raises KernelError {
    start_level(m);
    chapter_maybe()
}

chapter_maybe() {
    chapter_open = false;
    if (playing < 0 || region_chapter == 0 || demo_seen(region_name)) return;
    chapter_open = true;
    chapter_t0 = now_t
}

// The chapter's page put away (seen for good): the title card now.
chapter_close() {
    if (!chapter_open) return;
    chapter_open = false;
    if (seen_n < len(seen_demo)) {
        seen_demo[seen_n] = region_name;
        seen_n = seen_n + 1
    }
    wants_save = true;
    intro_open = true;
    intro_t0 = now_t;
    demo_t0 = intro_t0 + 1.55
}

// When the level's words were last asked for (a tap on the title).
say_t: f32 = -10.0;

start_level(m: int) raises KernelError {
    r: int = region_of(m);
    enter_region(r);
    if (loaded_region != r) return;
    playing = m;
    chapter_open = false;
    level_start(ml_index[m]);
    parse_proof(ml_index[m]);
    moves_made = 0;
    done_t = -1.0;
    intro_open = true;
    intro_t0 = now_t;
    chosen_node = -1;
    ft_n = 0;
    on_path = 0;
    hint_row = -1;
    hint_chip = -1;
    close_t = -10.0;
    stage_node = -1;
    sp_n = 0;
    sp_node = -1;
    lt_level = -1;
    for i in 0..64 pip_fill_t[i] = -10.0;
    close_lead = 0.0;
    fly_t = -10.0;
    watch_done_t = -1.0;
    page = PAGE_LEVEL;
    sc_pos[V_LEVEL] = 0.0;
    sc_pos[V_TRAY] = 0.0;
    an_jump = true;
    pic_reset();
    focus_start(false);
    // (A level whose proof starts by putting something into the goal
    // starts on the goal, demo or not.)
    if (st_n > 0 && st_kind[0] == 2 && st_hyp[0] < 0 && !fc_goal) {
        focus_on_goal();
        hand_build()
    }
    demo_begin()
}

// ---- first-time demos ----
// The first time a level that brings in a control is played (its demo:),
// a ghost finger shows it once: a row tapped (row), the goals' squares at
// the top (pips, then the row), a term picked (chip: the row, then its
// chip), the cursor swiped (swipe). It goes when the player does it.
demo_kind: int = 0;

// When the demo starts (the title card gone), and its words.
demo_t0: f32 = 0.0;

// The demos seen (kept in the progress file).
seen_demo: []int = new int[32](0);

seen_n: int = 0;

demo_seen(k: int): bool {
    for i in 0..seen_n {
        if (seen_demo[i] == k) return true
    }
    false
}

demo_begin() raises KernelError {
    demo_kind = 0;
    if (cur_level < 0 || watching) return;
    k: int = lv_demo[cur_level];
    if (k == 0 || demo_seen(k)) return;
    demo_kind = k;
    demo_t0 = intro_t0 + 1.55;
    if (k == sym("swipe")) {
        // (The cursor is on the goal: it is the goal it goes into.)
        focus_on_goal();
        hand_build();
        return
    }
    demo_hint()
}

// The written proof's next row, glowing (the demo's finger goes to it).
demo_hint() raises KernelError {
    hint_row = hint_find(moves_made);
    hint_t = now_t
}

// The demo done: seen for good.
demo_end() {
    if (demo_kind == 0) return;
    if (seen_n < len(seen_demo)) {
        seen_demo[seen_n] = demo_kind;
        seen_n = seen_n + 1
    }
    demo_kind = 0;
    wants_save = true
}

region_of(m: int): int {
    for r in 0..rg_n {
        if (m >= rg_lv0[r] && m < rg_lv0[r] + rg_lvn[r]) return r
    }
    0
}

// The node played: the goal the player chose, if still open, or the first.
chosen_node: int = -1;

play_node(): int {
    level_open();
    for i in 0..open_n {
        if (open_nodes[i] == chosen_node) return chosen_node
    }
    if (open_n == 0) return -1;
    open_nodes[0]
}

// The slots: the goal's conclusion, and each hypothesis by its term.
const SLOT_GOAL: int = 1;

const SLOT_HYP: int = 3000000;

hyp_slot(h: int): int {
    SLOT_HYP + h
}

// ---- playing a row ----
// The candidate a term is being picked for (wit_cand), which of its terms
// (wit_i), and those picked so far.
wit_cand: int = -1;

wit_i: int = 0;

wit_chosen: []int = new int[8](0);

// A row of the hand tapped (its place in the order shown): its move made,
// or its terms asked for.
tap_row(k: int) raises KernelError {
    if (k < 0 || k >= hd_n || done_t >= 0.0) return;
    r: int = hd_order[k];
    c: int = row_cands(r);
    if (c < 0) return;
    last_input_t = now_t;
    fly_from_row = k;
    if (cd_wn[c] > 0 && hd_pre[r] == 0) {
        chip_row = r;
        wit_cand = c;
        wit_i = 0;
        witness_list();
        sc_pos[V_TRAY] = 0.0;
        // (The written proof's term glows if this is its move.)
        if (hint_row != r) hint_chip = -1;
        return
    }
    play_row(r, c)
}

witness_list() raises KernelError {
    n: int = play_node();
    ty: int = cand_witness_type(wit_cand, wit_i);
    if (ty == 0) ty = tm_type(cand_witness(wit_cand, wit_i));
    witness_cands(n, ty);
    chips_build()
}

// A chip tapped: the term picked; the move made when it has all it needs.
tap_chip(k: int) raises KernelError {
    if (chip_row < 0 || k < 0 || k >= wc_n) return;
    last_input_t = now_t;
    chip_played = k;
    fly_from_row = k;
    wit_chosen[wit_i] = wc_term[k];
    wit_i = wit_i + 1;
    r: int = chip_row;
    c: int = row_cands(r);
    if (c < 0) {
        chip_back();
        return
    }
    wit_cand = c;
    if (wit_i < cd_wn[c]) {
        witness_list();
        return
    }
    play_row(r, c)
}

chip_back() {
    chip_row = -1;
    wit_cand = -1;
    wit_i = 0
}

// Row r's move (candidate c, listed now) made at the node played.
play_row(r: int, c0: int) raises KernelError {
    n: int = play_node();
    if (n < 0) return;
    // (A close still being staged: on to its flash.)
    if (staging()) close_t = now_t;
    wn: int = 0;
    if (wit_cand == c0 && chip_row == r) wn = wit_i;
    for i in 0..wn move_wits[i] = wit_chosen[i];
    // (A row with its term in already.)
    pre: int = hd_pre[r];
    if (pre != 0) {
        wn = 1;
        move_wits[0] = pre
    }
    // (Whether it is the written proof's next move: what that would give.)
    want: int = 0;
    if (on_path == moves_made) want = script_sig(moves_made, n);
    c: int = row_cands(r);
    if (c < 0) return;
    old_goal: int = pn_goal[n];
    j: int = hd_src[r];
    last_rewrite = j < 0;
    if (j >= 0) use_fact(goal_hyp(old_goal, j));
    leaves_before = leaves_done();
    fly_term = hd_res[r];
    fly_fact = hd_fact[r];
    fly_hl = hd_hl[r];
    if (wn > 0 && pre == 0) {
        // (Its term picked from a chip row: what that row showed flies.)
        fly_term = 0;
        fly_hl = 0;
        k: int = chip_played;
        if (k >= 0 && k < wc_n && ch_ok[k]) {
            fly_term = ch_res[k];
            fly_fact = ch_fact[k];
            fly_hl = ch_hl[k]
        }
    }
    fly_keep(fly_from_row);
    m: int = -1;
    try {
        m = cand_apply(n, c, move_wits, wn)
    } with KernelError -> {
        line_clear();
        line_add("That move does not work: ");
        line_add(kernel_why);
        toast_line();
        chip_back();
        hand_build();
        return
    }
    last_move = m;
    path_toast_end();
    demo_end();
    auto_close();
    trial_read(n, c);
    if (want != 0 && tr_sig == want) on_path = moves_made + 1;
    moves_made = moves_made + 1;
    after_move(n, old_goal)
}

move_wits: []int = new int[8](0);

// The chip row tapped last.
chip_played: int = -1;

// (A demo of a row or a term ends when a move is made.)

// After any move: what closed is shown closing, the focus moves on.
after_move(n: int, old_goal: int) raises KernelError {
    intro_open = false;
    // (The last move: its hand, chips or rows, slides away as it was.)
    fin_chip = chip_row;
    chip_back();
    hint_row = -1;
    hint_chip = -1;
    fly_t = now_t;
    if (fly_term == 0) fly_t = -10.0;
    stage_node = -1;
    stage_fact = 0;
    close_lead = 0.0;
    side_t = -10.0;
    side_note(n);
    // (A goal closed: shown snapping shut, and into its pip.)
    if (leaves_done() > leaves_before) {
        close_t = now_t;
        // (What closed: the first goal under the move that is proved now,
        // the goal itself or a side condition.)
        close_term = gl_concl[old_goal];
        close_calc = calc_under(n);
        lf_n = 0;
        leaves(n);
        for i in 0..lf_n {
            k: int = lf_node[lf_n - 1 - i];
            if (pn_thm[k] != 0 && pn_thm[n] == 0 && !quiet_leaf(k)) {
                close_term = gl_concl[pn_goal[k]];
                m: int = pn_move[k];
                close_calc = m >= 0 && mv_kind[m] == MV_CALC
            }
        }
        close_pip = leaves_before;
        // (What the goal became as it closed, for the picture.)
        pic_close_eq = 0;
        lf_n = 0;
        leaves(n);
        for i in 0..lf_n {
            if (pn_thm[lf_node[i]] != 0 && !quiet_leaf(lf_node[i])) pic_close_eq = gl_concl[pn_goal[lf_node[i]]]
        }
        if (pic_close_eq == 0) pic_close_eq = gl_concl[old_goal];
        sp_n = 0;
        if (pn_thm[n] != 0 && tr_ticks && tr_res != 0 && tr_res2 != 0) split_stage(n,
            old_goal) else if (pn_thm[n] != 0) stage_close(n, old_goal);
        // (A move on the goal itself that closed it made its two sides the
        // same, or matched a rule: shown as the smaller side twice.)
        q: int = rel_core(pic_close_eq);
        if (last_rewrite && is_binary(q, role_name[ROLE_EQ]) && spine_arg(q, 2, 0) != spine_arg(q,
            2, 1)) {
            sl: int = spine_arg(q, 2, 0);
            if (term_size(spine_arg(q, 2, 1)) < term_size(sl)) sl = spine_arg(q, 2,
                1);
            pic_close_eq = mk_app(mk_app(spine_head(q), sl), sl)
        }
        if (stage_node < 0) fly_t = -10.0;
        page_vibrate(20)
    } else page_vibrate(8);
    pic_moved();
    if (level_done()) {
        finish_level();
        fin_t0 = now_t;
        chip_row = fin_chip;
        return
    }
    focus_after(old_goal)
}

// ---- a close, staged ----
// Before a goal flashes shut, the board shows it as the move left it a
// moment (stage_node: the goal the move closed, written stage_concl): a
// rewrite's goal morphs to c = c; a new fact drops in first; and when a
// fact closes it (stage_fact), the fact pulses and a copy of it flies into
// the goal. Then the flash, at close_t (close_lead after the move).
stage_node: int = -1;

stage_concl: int = 0;

stage_fact: int = 0;

close_lead: f32 = 0.0;

// Whether stage_fact is not among the goal's facts (the move used it at
// once): the board shows it all the same.
stage_virtual: bool = false;

// How long the fact's copy takes to fly into the goal.
const COPY_TIME: f32 = 0.34;

staging(): bool {
    stage_node >= 0 && now_t < close_t
}

stage_close(n: int, old_goal: int) raises KernelError {
    stage_concl = closed_shown(n);
    stage_node = closed_leaf;
    close_term = stage_concl;
    g: int = pn_goal[stage_node];
    m: int = pn_move[stage_node];
    if (m >= 0 && mv_kind[m] == MV_HYP) stage_fact = gl_concl[g];
    stage_virtual = false;
    if (stage_fact == 0 && fly_fact && fly_term != 0 && !goal_has_hyp(g, fly_term)) {
        // (A fact the move gave, used at once: shown landing all the same.)
        stage_fact = fly_term;
        stage_virtual = true
    }
    changed: bool = stage_concl != gl_concl[old_goal];
    if (stage_fact != 0 && fly_fact && fly_term == stage_fact) close_lead = FLY_TIME + 0.16 + COPY_TIME else if (stage_fact != 0) {
        close_lead = COPY_TIME + 0.06;
        if (changed) close_lead = close_lead + 0.2
    } else if (changed) close_lead = 0.26 else close_lead = 0.08;
    close_t = now_t + close_lead
}

// ---- a goal split in two, both closing at once ----
// (Both at once: P ∧ Q with P and Q known.) Staged: the goal card divides
// into its parts, a pip comes for the new goal, and the parts close in
// turn, each as one goal closes (its fact pulses and a copy flies in; it
// flashes, and flies into its pip).
const SP_MAX: int = 4;

sp_n: int = 0;

sp_t0: f32 = 0.0;

sp_term: []int = new int[SP_MAX](0);

sp_fact: []int = new int[SP_MAX](0);

sp_calc: []bool = new bool[SP_MAX](false);

sp_pip: []int = new int[SP_MAX](0);

// When each part flashes shut.
sp_t: []f32 = new f32[SP_MAX](0.0);

// How long the card takes to divide.
const SPLIT_TIME: f32 = 0.42;

// The node a split closed (its pips are its parts), and how many.
sp_node: int = -1;

sp_w: int = 1;

// Node n's Split closed both its parts at once (the trial read: tr_res
// and tr_res2): each part staged as its own goal.
split_stage(n: int, old_goal: int) {
    k: int = 2;
    sp_n = k;
    sp_t0 = now_t;
    sp_node = n;
    sp_w = k;
    for i in 0..k {
        sp_term[i] = tr_res;
        if (i == 1) sp_term[i] = tr_res2;
        sp_fact[i] = 0;
        if (goal_has_hyp(old_goal, sp_term[i])) sp_fact[i] = sp_term[i];
        sp_calc[i] = false;
        sp_t[i] = now_t + SPLIT_TIME + 0.35 + i as f32 * 0.85 + COPY_TIME;
        sp_pip[i] = leaves_before + i;
        if (sp_pip[i] < 64) pip_fill_t[sp_pip[i]] = sp_t[i] + 0.62
    }
    stage_node = n;
    stage_concl = gl_concl[old_goal];
    stage_fact = 0;
    stage_virtual = false;
    close_t = sp_t[k - 1];
    close_lead = close_t - now_t;
    close_term = sp_term[k - 1];
    close_pip = sp_pip[k - 1];
    close_calc = false
}

undo_move() raises KernelError {
    if (mv_n == 0 || done_t >= 0.0) return;
    undo();
    if (moves_made > 0) moves_made = moves_made - 1;
    if (on_path > moves_made) on_path = moves_made;
    path_toast_end();
    chip_back();
    hint_row = -1;
    undo_t = now_t;
    if (sp_node >= 0 && (sp_node >= pn_n || pn_thm[sp_node] == 0)) sp_node = -1;
    close_t = -10.0;
    stage_node = -1;
    sp_n = 0;
    for i in 0..64 pip_fill_t[i] = -10.0;
    fly_t = -10.0;
    pic_moved();
    // (The focus kept if it is still there.)
    if (!fc_goal && focus_hyp() < 0) focus_on_goal();
    cur_at = 0;
    hand_build();
    if (!fc_goal || hd_prim == 0) focus_start(false)
}

undo_t: f32 = -10.0;

// The last move: when it was made, and the chips its hand showed (-1 for
// rows). The hand slides down and away, and the facts after it as the
// goal flashes.
fin_t0: f32 = -10.0;

fin_chip: int = -1;

const HAND_AWAY: f32 = 0.22;

const FACTS_AWAY: f32 = 0.24;

hand_leaving(): bool {
    done_t >= 0.0 && now_t - fin_t0 < HAND_AWAY
}

// How far the hand has gone (0 to 1, eased).
hand_away(): f32 {
    k: f32 = clampf((now_t - fin_t0) / HAND_AWAY, 0.0, 1.0);
    k * k
}

// The goals (leaves of the proof) closed so far.
leaves_before: int = 0;

leaves_done(): int {
    lf_n = 0;
    leaves(root);
    k: int = 0;
    for i in 0..lf_n {
        if (pn_thm[lf_node[i]] != 0) k = k + pips_of(lf_node[i])
    }
    k
}

// How many pips a leaf of the proof shows: a split closed at once, one
// for each part.
pips_of(n: int): int {
    if (n == sp_node && pn_thm[n] != 0) return sp_w;
    if (quiet_leaf(n)) return 0;
    1
}

// Whether leaf n is a side condition arithmetic closed as the move that
// made it was made (0 < ε/2, N ≤ n): never an open goal to the player, so
// no pip and no close of its own, only a tick by the new fact. It is one
// when a sibling goal has a new fact (the move's main goal) and it has none.
quiet_leaf(n: int): bool {
    if (pn_thm[n] == 0) return false;
    m: int = pn_move[n];
    if (m < 0 || mv_kind[m] != MV_CALC) return false;
    p: int = pn_parent[n];
    if (p < 0 || pn_kidn[p] < 2) return false;
    pg: int = pn_goal[p];
    if (side_new_fact(pn_goal[n], pg) != 0) return false;
    for i in 0..pn_kidn[p] {
        s: int = node_kid(p, i);
        if (s != n && side_new_fact(pn_goal[s], pg) != 0) return true
    }
    false
}

// A fact goal g has that goal pg has not (0 if none).
side_new_fact(g: int, pg: int): int {
    r: int = 0;
    for j in 0..gl_hypn[g] {
        h: int = goal_hyp(g, j);
        if (!goal_has_hyp(pg, h)) r = h
    }
    r
}

// A side condition closed by arithmetic as a move was made: shown as a
// small chip that ticks by the fact the move gave.
side_t: f32 = -10.0;

side_term: int = 0;

side_fact: int = 0;

// The quiet leaves under node n (made by its move): the last one's
// condition and its sibling's new fact noted for the tick.
side_note(n: int) {
    lf_n = 0;
    leaves(n);
    for i in 0..lf_n {
        k: int = lf_node[i];
        if (quiet_leaf(k)) {
            side_term = gl_concl[pn_goal[k]];
            p: int = pn_parent[k];
            for s0 in 0..pn_kidn[p] {
                s: int = node_kid(p, s0);
                f: int = side_new_fact(pn_goal[s], pn_goal[p]);
                if (s != k && f != 0) side_fact = f
            }
            side_t = now_t + FLY_TIME
        }
    }
}

// The leaves of the proof (the goals, open or closed by one move), in
// order, into lf_node.
lf_node: []int = new int[256](0);

lf_n: int = 0;

leaves(n: int) {
    if (pn_move[n] < 0 || pn_kidn[n] == 0) {
        if (lf_n < len(lf_node)) {
            lf_node[lf_n] = n;
            lf_n = lf_n + 1
        }
        return
    }
    for i in 0..pn_kidn[n] leaves(node_kid(n, i))
}

// ---- juice: what a move looks like ----
// A copy of what the move gives flies from its row to the board.
fly_t: f32 = -10.0;

fly_term: int = 0;

fly_fact: bool = false;

// Whether the last move was made on the goal (not with a fact).
last_rewrite: bool = false;

// The changed part a rewrite's row shows (0 if none).
fly_hl: int = 0;

fly_from_row: int = 0;

// A goal closing: when, what it was, whether by arithmetic, which pip.
close_t: f32 = -10.0;

close_term: int = 0;

close_calc: bool = false;

close_pip: int = 0;

// On a page, a short buzz (the page does it, if the phone can).
page_vibrate(ms: int) {
    if (on_page) {
        line_clear();
        line_add("@vibrate ");
        line_int(ms);
        line_print_safe()
    }
}

// ---- the written proof: hints, and watching it ----
// How many of the player's moves so far are the written proof's first
// moves (equal to moves_made while on its path).
on_path: int = 0;

// The row the hint points at (in hd_ numbers), and the chip (wc_ number).
hint_row: int = -1;

hint_chip: int = -1;

hint_t: f32 = -10.0;

// When the player last did anything (the bulb breathes after a while).
last_input_t: f32 = 0.0;

// The candidate the written proof's step k makes at node n, listed now
// (cands_ tables), with its terms in hint_wits: or -1.
hint_wits: []int = new int[8](0);

hint_wn: int = 0;

script_cand(k: int, n: int) raises KernelError: int {
    if (k < 0 || k >= st_n || st_kind[k] == 3) return -1;
    g: int = pn_goal[n];
    if (st_hyp[k] >= gl_hypn[g]) return -1;
    if (st_kind[k] == 2) {
        target: int = gl_concl[g];
        if (st_hyp[k] >= 0) target = goal_hyp(g, st_hyp[k]);
        if (!find_part_text(target, st_part[k])) return -1;
        sub_n = fp_n;
        for i in 0..fp_n sub_steps[i] = fp_steps[i];
        cands_sub(n, st_hyp[k])
    } else if (st_kind[k] == 1) cands_hyp(n, st_hyp[k]) else cands_goal(n);
    c: int = -1;
    for i in 0..cd_shown {
        if (cd_label[cd_order[i]] == st_label[k]) c = cd_order[i]
    }
    if (c < 0) return -1;
    hint_wn = cd_wn[c];
    for i in 0..hint_wn {
        w: int = st_w1[k];
        if (i == 1) w = st_w2[k];
        hint_wits[i] = witness_sym(n, w, cand_witness_type(c, i))
    }
    c
}

// What the written proof's step k would give at node n (a trial's
// fingerprint), or 0.
script_sig(k: int, n: int) raises KernelError: int {
    if (n != focus_node()) return 0;
    c: int = script_cand(k, n);
    if (c < 0) return 0;
    for i in 0..hint_wn {
        if (hint_wits[i] == 0) return 0
    }
    if (!trial(n, c, hint_wits, hint_wn)) return 0;
    tr_sig
}

// The node the written proof plays: the first open goal.
focus_node(): int {
    level_open();
    if (open_n == 0) return -1;
    open_nodes[0]
}

// The hand's row that is the written proof's step k: the focus moved to
// its statement (and the cursor to its part, if only there), the row
// found (-1 if none). Its term's chip, once shown, in hint_chip.
hint_find(k: int) raises KernelError: int {
    n: int = focus_node();
    if (n < 0) return -1;
    chosen_node = n;
    c: int = script_cand(k, n);
    if (c < 0) return -1;
    label: int = st_label[k];
    sig: int = 0;
    wit: bool = hint_wn > 0;
    for i in 0..hint_wn hint_wit_terms[i] = hint_wits[i];
    hint_wit_n = hint_wn;
    path_n_k: int = 0;
    if (st_kind[k] == 2) {
        path_n_k = sub_n;
        for i in 0..sub_n hint_path[i] = sub_steps[i]
    }
    if (!wit && trial(n, c, hint_wits, 0)) sig = tr_sig;
    g: int = pn_goal[n];
    if (st_hyp[k] >= 0) focus_on_fact(goal_hyp(g, st_hyp[k])) else focus_on_goal();
    for pass in 0..2 {
        if (pass == 1) {
            // (Not among the whole statement's moves: at its part.)
            if (st_kind[k] != 2) return -1;
            cur_at = -1;
            for p in 0..pc_n {
                if (pc_sn[p] == path_n_k) {
                    same: bool = true;
                    for i in 0..path_n_k {
                        if (pc_pool[pc_s0[p] + i] != hint_path[i]) same = false
                    }
                    if (same && cur_at < 0) cur_at = p
                }
            }
            if (cur_at < 0) {
                cur_at = 0;
                return -1
            }
        }
        hand_build();
        for r in 0..hd_n {
            hit: bool = false;
            if (wit) hit = hd_wit[r] && hd_label[r] == label else hit = !hd_wit[r] && hd_sig[r] == sig;
            if (hit) {
                for q in 0..hd_n {
                    if (hd_order[q] == r && q >= hand_shown()) more_open = true
                }
                return r
            }
        }
    }
    -1
}

hint_wit_terms: []int = new int[8](0);

hint_wit_n: int = 0;

hint_path: []int = new int[256](0);

// The bulb tapped: the next step shown, or how far back the path is.
give_hint() raises KernelError {
    if (done_t >= 0.0 || watching) return;
    last_input_t = now_t;
    chip_back();
    demo_end();
    if (on_path < moves_made) {
        line_clear();
        line_add("Undo ");
        line_int(moves_made - on_path);
        line_add(" to get back on the book's path");
        toast_line();
        undo_pulse_t = now_t;
        path_toast = true;
        return
    }
    r: int = hint_find(moves_made);
    if (r < 0) {
        toast("No hint here: try Watch (hold the bulb)");
        hand_build();
        return
    }
    hint_row = r;
    hint_t = now_t
}

undo_pulse_t: f32 = -10.0;

// Whether the toast showing says how far back the path is (it goes, and
// the undo button stops pulsing, as soon as a move or an undo is made).
path_toast: bool = false;

path_toast_end() {
    if (!path_toast) return;
    path_toast = false;
    toast_t = 10.0;
    undo_pulse_t = -10.0
}

// The hand's place (in the order shown) of row r, or -1.
row_place(r: int): int {
    for q in 0..hd_n {
        if (hd_order[q] == r) return q
    }
    -1
}

// ---- watching the written proof ----
// The level's proof played from the start, a move at a time, as a finger
// would: the statement focused, the row pressed, the term picked. Its
// step, and when the step's next part is due.
watching: bool = false;

// How long its pauses are (1 as a person would watch; less for tests).
watch_pace: f32 = 1.0;

watch_step: int = 0;

watch_phase: int = 0;

watch_at: f32 = 0.0;

watch_row: int = -1;

watch_chip: int = -1;

// When watching finished (then: "Your turn", and the level afresh).
watch_done_t: f32 = -1.0;

// The ghost finger: where it is going (a button), and whether it shows.
ghost_id: int = 0;

ghost_on: bool = false;

start_watch() raises KernelError {
    if (playing < 0) return;
    start_level(playing);
    demo_kind = 0;
    hint_row = -1;
    watching = true;
    intro_open = false;
    watch_step = 0;
    watch_phase = 0;
    watch_at = now_t + 0.6 * watch_pace;
    ghost_on = true;
    ghost_id = 0
}

stop_watch() {
    watching = false;
    ghost_on = false;
    press_show = 0.0
}

step_watch() raises KernelError {
    if (watch_done_t >= 0.0) {
        busy = true;
        if (now_t > watch_done_t + 1.6) {
            watch_done_t = -1.0;
            if (playing >= 0) start_level(playing);
            intro_open = false;
            toast("Your turn")
        }
        return
    }
    if (!watching) return;
    busy = true;
    if (now_t < watch_at) return;
    if (done_t >= 0.0 || watch_step >= st_n) {
        stop_watch();
        return
    }
    if (watch_phase == 0) {
        watch_row = hint_find(watch_step);
        if (watch_row < 0) {
            stop_watch();
            toast("The written proof does not fit here");
            return
        }
        ghost_id = B_EXPR_SLOT;
        watch_phase = 1;
        watch_at = now_t + 0.8 * watch_pace;
        return
    }
    k: int = row_place(watch_row);
    if (watch_phase == 1) {
        ghost_id = B_ROW + k;
        press_shown_id = B_ROW + k;
        press_show = 1.0;
        watch_phase = 2;
        watch_at = now_t + 0.5 * watch_pace;
        return
    }
    if (watch_phase == 2) {
        press_show = 0.0;
        tap_row(k);
        if (chip_row < 0) {
            watch_next();
            return
        }
        watch_phase = 3;
        watch_at = now_t + 0.5 * watch_pace;
        return
    }
    if (watch_phase == 3) {
        // (The term: found among the chips, and pressed.)
        t: int = hint_wit_terms[mini(wit_i, 7)];
        watch_chip = -1;
        for i in 0..wc_n {
            if (wc_term[i] == t) watch_chip = i
        }
        if (watch_chip < 0) {
            // (Not among them: picked all the same.)
            if (wc_n < len(wc_term)) watch_chip = chip_append(t)
        }
        if (watch_chip >= chips_shown()) chips_all = true;
        ghost_id = B_CHIP + watch_chip;
        press_shown_id = B_CHIP + watch_chip;
        press_show = 1.0;
        watch_phase = 4;
        watch_at = now_t + 0.45 * watch_pace;
        return
    }
    press_show = 0.0;
    tap_chip(watch_chip);
    if (chip_row >= 0) {
        watch_phase = 3;
        watch_at = now_t + 0.4 * watch_pace;
        return
    }
    watch_next()
}

watch_next() {
    watch_step = watch_step + 1;
    watch_phase = 0;
    watch_at = now_t + 0.9 * watch_pace;
    if (done_t >= 0.0) {
        watching = false;
        watch_done_t = maxf(now_t, done_t) + 1.4
    }
}

// ---- finishing ----
finish_level() raises KernelError {
    // (Done once the last goal's close has been staged.)
    done_t = now_t + close_lead;
    if (playing < 0) return;
    // (Watching the written proof does not solve the level.)
    if (watching) return;
    level_solved(ml_index[playing]);
    if (!ml_solved[playing] || moves_made < ml_best[playing]) ml_best[playing] = moves_made;
    ml_solved[playing] = true;
    wants_save = true
}

// Stars for a finish: 3 at par or better, 2 a little over, 1 otherwise.
stars_for(m: int): int {
    if (!ml_solved[m]) return 0;
    stars_of(ml_best[m], ml_par[m])
}

stars_of(moves: int, par: int): int {
    if (par == 0 || moves <= par) return 3;
    if (moves <= par + 2) return 2;
    1
}

// The lemma a level needs that the player has not proved (its words), or
// 0: the level shows a lock till it is.
level_lock(m: int): int {
    r: int = region_of(m);
    // (Its tools are levels of its region, by name.)
    want: int = ml_tool[m];
    if (want == 0) return 0;
    for k in rg_lv0[r]..rg_lv0[r] + rg_lvn[r] {
        if (ml_name[k] == want && !ml_solved[k]) return ml_title[k]
    }
    0
}

ml_tool: []int = new int[MAP_LEVELS](0);

// ---- theorems as tools ----
// The map level that is level l of the loaded region, or -1.
map_of_level(l: int): int {
    for m in 0..ml_n {
        if (ml_index[m] == l && region_of(m) == loaded_region) return m
    }
    -1
}

// Whether level u of the loaded region may use level l's theorem.
level_uses(u: int, l: int): bool {
    for i in lv_tool0[u]..lv_tool0[u] + lv_tooln[u] {
        if (pool[i] == lv_name[l]) return true
    }
    false
}

// Whether level l's theorem is a tool for a later level.
level_is_tool(l: int): bool {
    for u in 0..lv_n {
        if (u != l && level_uses(u, l)) return true
    }
    false
}

// ---- the player's progress, as a file ----
//   solved NAME MOVES      (a line for each level solved)
const PROGRESS_BYTES: int = 16384;

progress_buf: []i8 = new i8[PROGRESS_BYTES](0i8);

progress_n: int = 0;

wants_save: bool = false;

write_progress() {
    progress_n = 0;
    for m in 0..ml_n {
        if (ml_solved[m]) {
            line_clear();
            line_add("solved ");
            line_sym(ml_name[m]);
            line_add(" ");
            line_int(ml_best[m]);
            line_byte(10);
            progress_line()
        }
    }
    for i in 0..seen_n {
        line_clear();
        line_add("seen ");
        line_sym(seen_demo[i]);
        line_byte(10);
        progress_line()
    }
}

progress_line() {
    for i in 0..line_n {
        if (progress_n < PROGRESS_BYTES) {
            progress_buf[progress_n] = line[i];
            progress_n = progress_n + 1
        }
    }
}

read_progress(t: []i8, n: int) {
    i: int = 0;
    while (i < n) {
        j: int = i;
        while (j < n && t[j] as int != 10) j = j + 1;
        // (seen DEMO)
        if (j - i > 5 && t[i] as int == 115 && t[i + 1] as int == 101 && seen_n < len(seen_demo)) {
            seen_demo[seen_n] = sym_of(t, i + 5, j);
            seen_n = seen_n + 1
        }
        // (solved NAME MOVES)
        if (j - i > 7 && t[i] as int == 115 && t[i + 1] as int == 111) {
            a: int = i + 7;
            b: int = a;
            while (b < j && t[b] as int != 32) b = b + 1;
            name: int = sym_of(t, a, b);
            moves: int = 0;
            for k in b + 1..j {
                c: int = t[k] as int;
                if (c >= 48 && c <= 57) moves = moves * 10 + c - 48
            }
            for m in 0..ml_n {
                if (ml_name[m] == name) {
                    ml_solved[m] = true;
                    ml_best[m] = moves
                }
            }
        }
        i = j + 1
    }
}

// The next level to play after map level m: the next unsolved one after
// it on the map, else the first unsolved, else the next in order.
next_level(m: int): int {
    // (On along the path: the next level not solved after this one; back
    // round to the first not solved only if there is none after.)
    for k in m + 1..ml_n {
        if (!ml_solved[k]) return k
    }
    for k in 0..m {
        if (!ml_solved[k]) return k
    }
    if (m + 1 < ml_n) return m + 1;
    -1
}

// ---- what each button does ----
const B_ROW: int = 2000;

const B_CHIP: int = 3000;

const B_DECK: int = 4000;

const B_MORE: int = 21;

const B_CHIP_BACK: int = 22;

const B_HINT: int = 23;

const B_TITLE: int = 24;

const B_CUR_PREV: int = 25;

const B_CUR_NEXT: int = 26;

// (Where the ghost finger goes to show a statement: the focused card.)
const B_EXPR_SLOT: int = 27;

// (Back from every move to the few.)
const B_MORE_BACK: int = 28;

// (A dead end's way back: the undos to where it went wrong, at once.)
const B_DEAD_UNDO: int = 29;

// (Every term offered shown.)
const B_CHIP_MORE: int = 30;

act(id: int) raises KernelError {
    if (chapter_open && page == PAGE_LEVEL) {
        chapter_close();
        return
    }
    if (id >= B_EXPR) return;
    if (page == PAGE_LEVEL && intro_open && now_t - intro_t0 < 1.2) {
        intro_open = false;
        return
    }
    if (id >= B_DECK) {
        // (Another goal brought forward.)
        level_open();
        k: int = id - B_DECK;
        if (k < open_n) chosen_node = open_nodes[k];
        focus_start(false);
        return
    }
    if (id >= B_CHIP) {
        tap_chip(id - B_CHIP);
        return
    }
    if (id >= B_ROW) {
        tap_row(id - B_ROW);
        return
    }
    if (id >= B_LEVEL) {
        k: int = id - B_LEVEL;
        lock: int = level_lock(k);
        if (lock != 0) {
            line_clear();
            line_add("Prove ");
            line_sym(lock);
            line_add(" first");
            toast_line();
            return
        }
        open_level(k);
        return
    }
    if (id == B_BACK) {
        if (page == PAGE_PROOF || page == PAGE_RULES) page = PAGE_LEVEL else {
            page = PAGE_MAP;
            stop_watch()
        }
        an_jump = true
    } else if (id == B_UNDO) undo_move() else if (id == B_PROOF) {
        write_proof();
        page = PAGE_PROOF;
        sc_pos[V_PROOF] = 0.0
    } else if (id == B_NEXT) {
        k: int = next_level(playing);
        if (k >= 0) open_level(k) else page = PAGE_MAP
    } else if (id == B_MAP) page = PAGE_MAP else if (id == B_AGAIN) {
        if (playing >= 0) start_level(playing)
    } else if (id == B_RULES) {
        page = PAGE_RULES;
        sc_pos[V_PROOF] = 0.0
    } else if (id == B_WATCH) {
        if (watching) stop_watch() else start_watch()
    } else if (id == B_HINT) give_hint() else if (id == B_MORE) {
        more_open = true;
        sc_pos[V_TRAY] = 0.0
    } else if (id == B_MORE_BACK) {
        more_open = false;
        sc_pos[V_TRAY] = 0.0
    } else if (id == B_DEAD_UNDO) {
        k: int = dead_undo_k();
        for _ in 0..k undo_move()
    } else if (id == B_CHIP_BACK) chip_back() else if (id == B_CHIP_MORE) {
        chips_all = true;
        sc_pos[V_TRAY] = 0.0
    } else if (id == B_TITLE) say_t = now_t else if (id == B_CUR_PREV) cursor_step(-1) else if (id == B_CUR_NEXT) cursor_step(1)
}

// A tap on an expression (not on a button): its statement focused, and
// the cursor on the part under the finger (never a menu).
tap_expr(e: int, x: f32, y: f32) raises KernelError {
    if (page != PAGE_LEVEL || done_t >= 0.0) return;
    if (chapter_open) {
        chapter_close();
        return
    }
    if (intro_open && now_t - intro_t0 < 1.2) {
        intro_open = false;
        return
    }
    last_input_t = now_t;
    slot: int = ex_slot[e];
    n: int = play_node();
    if (n < 0) return;
    chip_back();
    hint_row = -1;
    b: int = block_at(e, x, y);
    if (slot == SLOT_GOAL) {
        if (!fc_goal) {
            focus_on_goal();
            hand_build()
        }
    } else if (slot >= SLOT_HYP && slot < SLOT_HYP + 100000000) {
        h: int = slot - SLOT_HYP;
        if (fc_goal || fc_term != h) {
            focus_on_fact(h);
            hand_build()
        }
    } else return;
    // (A part: the cursor there; the same part again: the whole.)
    p: int = 0;
    if (b >= 0 && bx_parent[b] >= 0) p = place_of_key(bx_key[b]);
    if (p < 0) p = 0;
    if (p == cur_at && p != 0) p = 0;
    if (p != cur_at) {
        cur_at = p;
        more_open = false;
        hand_build();
        if (p != 0) cursor_moved()
    }
}

// Keys (on a computer, and L8_KEYS): arrows move the cursor (left, right)
// and the focus (up, down); 1 to 4 play a row (4 is More when it shows);
// while terms are offered, a letter or number picks one; Enter plays the
// first row; u undoes, h asks for a hint, w watches.
key_press(ks: int) raises KernelError {
    last_input_t = now_t;
    if (page != PAGE_LEVEL) return;
    if (chapter_open) {
        chapter_close();
        return
    }
    if (intro_open && now_t - intro_t0 < 1.2) intro_open = false;
    if (done_t >= 0.0) {
        if (ks == 65293 || ks == 110) act(B_NEXT);
        return
    }
    if (chip_row >= 0) {
        // (h: the hint, here its term glows; so h, Enter over and over
        // follows the written proof.)
        if (ks == 104) {
            if (hint_row == chip_row) hint_t = now_t else give_hint()
        } else if (ks == 48) act(B_CHIP_MORE) else if (ks >= 97 && ks <= 122) tap_chip(ks - 97) else if (ks >= 49 && ks <= 57) tap_chip(ks - 49) else if (ks == 65288) chip_back() else if (ks == 65293) {
            // (Enter: the hinted term, or the first.)
            k: int = 0;
            t: int = hint_chip_term();
            found: bool = false;
            for i in 0..wc_n {
                if (t != 0 && wc_term[i] == t) {
                    k = i;
                    found = true
                }
            }
            if (t != 0 && !found && wc_n < len(wc_term)) {
                // (Not among them: picked all the same, as Watch does.)
                k = chip_append(t)
            }
            tap_chip(k)
        }
        return
    }
    if (ks == 65363) cursor_step(1) else if (ks == 65361) cursor_step(-1) else if (ks == 65362) focus_step(-1) else if (ks == 65364) focus_step(1) else if (ks == 117 || ks == 122 || ks == 65288) undo_move() else if (ks == 104) give_hint() else if (ks == 119) act(B_WATCH) else if (ks == 65293) {
        if (hint_row >= 0) tap_row(row_place(hint_row)) else if (dead_shown()) act(B_DEAD_UNDO) else tap_row(0)
    } else if (ks == 48) {
        if (hand_has_more()) act(B_MORE)
    } else if (ks >= 49 && ks <= 57) {
        k: int = ks - 49;
        // (A dead end: its one row is the way back.)
        if (dead_shown()) {
            if (k == 0) act(B_DEAD_UNDO) else if (k == 1 && hand_has_more()) act(B_MORE);
            return
        }
        if (k == hand_shown() && hand_has_more()) act(B_MORE) else if (k < hand_shown()) tap_row(k)
    }
}

// Whether the hand shows a dead end (and the way back from it).
dead_shown(): bool {
    chip_row < 0 && !more_open && hand_shown() == 0 && hd_empty == EMPTY_DEAD
}

// The focus moved to the statement above (-1) or below (1): the facts in
// order, then the goal.
focus_step(d: int) raises KernelError {
    n: int = play_node();
    if (n < 0) return;
    g: int = pn_goal[n];
    k: int = gl_hypn[g];
    at: int = focus_hyp();
    if (at < 0) at = k;
    at = (at + d + k + 1) % (k + 1);
    if (at == k) focus_on_goal() else focus_on_fact(goal_hyp(g, at));
    chip_back();
    hand_build()
}

esc_key(): bool {
    if (chip_row >= 0) {
        chip_back();
        return true
    }
    if (more_open) {
        more_open = false;
        return true
    }
    if (page == PAGE_PROOF || page == PAGE_RULES) {
        page = PAGE_LEVEL;
        return true
    }
    if (page == PAGE_LEVEL) {
        page = PAGE_MAP;
        stop_watch();
        return true
    }
    false
}

step_app(dt: f32) {
    frame_dt = dt;
    step_press();
    for v in 0..VIEWS step_scroll(v);
    if (page == PAGE_LEVEL && intro_open && now_t - intro_t0 < 1.6) busy = true;
    if (page == PAGE_LEVEL && chapter_open) busy = true;
    last_raise = step_watch_safe()
}

last_raise: bool = false;

step_watch_safe(): bool {
    try {
        step_watch()
    } with KernelError -> {
        stop_watch();
        toast("The kernel stopped the written proof");
        return false
    }
    true
}

// A line printed, if it can be (the page reads some as requests).
line_print_safe() {
    try {
        line_print()
    } with IoError _e -> { }
}
