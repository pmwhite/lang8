tag lemma;

use_tag std;

// A finished proof, written out as a book would: the moves made, read back
// as sentences. Each rule says how it reads (says NAME "..." in its file),
// with blanks the move fills:
//
//   {new}    the names the move brought in      "Let {new} be arbitrary."
//   {with}   the terms the player chose         "We choose {with}."
//   {hyp}    the hypothesis it used
//   {fact}   what it added to what is known     "Assume {fact}."
//   {now}    what is left to show
//   {goal}   what was to be shown
//   {rule}   the rule's own words
//
// A run of rewrites of an equation reads as a calculation, one side
// carried to the other: a⁻¹ · (a · b) = (a⁻¹ · a) · b = e · b = b.
// What the game did itself (arithmetic, a goal that was a hypothesis)
// is said in passing.
const PR_LINES: int = 512;

// The proof's lines: each a name (its text), how far in it is, and
// whether it is a step of a calculation (shown lined up on its =).
pr_text: []int = new int[PR_LINES](0);

pr_indent: []int = new int[PR_LINES](0);

pr_calc: []bool = new bool[PR_LINES](false);

pr_n: int = 0;

pr_add(text: int, indent: int, calc: bool) {
    if (pr_n < PR_LINES) {
        pr_text[pr_n] = text;
        pr_indent[pr_n] = indent;
        pr_calc[pr_n] = calc;
        pr_n = pr_n + 1
    }
}

// ---- what a move did ----
// The kid that carries on (the last), and those that were side goals.
main_kid(n: int): int {
    if (pn_kidn[n] == 0) return -1;
    node_kid(n, pn_kidn[n] - 1)
}

// The hypotheses kid k has that node n's goal had not, shown, into
// `line` joined by "and".
line_new_facts(n: int, k: int) {
    g: int = pn_goal[n];
    kg: int = pn_goal[k];
    first: bool = true;
    for i in 0..gl_hypn[kg] {
        h: int = goal_hyp(kg, i);
        if (!goal_has_hyp(g, h)) {
            if (!first) line_add(" and ");
            first = false;
            line_term(h)
        }
    }
}

line_new_names(n: int, k: int) {
    g: int = pn_goal[n];
    kg: int = pn_goal[k];
    first: bool = true;
    for i in gl_fixn[g]..gl_fixn[kg] {
        if (!first) line_add(", ");
        first = false;
        line_sym(tm_name(goal_fix(kg, i)))
    }
}

// A term, shown, added to the line being made (show uses the line itself,
// so the line is kept aside meanwhile).
line_term(t: int) {
    n: int = line_n;
    if (n > len(en_keep)) return;
    for i in 0..n en_keep[i] = line[i];
    show_line(t);
    m: int = line_n;
    for i in 0..m en_term[i] = line[i];
    line_clear();
    for i in 0..n line_byte(en_keep[i] as int);
    for i in 0..m line_byte(en_term[i] as int)
}

en_keep: []i8 = new i8[65536](0i8);

en_term: []i8 = new i8[65536](0i8);

// The template filled for move m at node n, into a new name.
fill(n: int, m: int, tmpl: int): int {
    line_clear();
    i: int = 0;
    k: int = main_kid(n);
    g: int = pn_goal[n];
    while (i < sym_len[tmpl]) {
        c: int = sym_byte(tmpl, i);
        if (c == 123) {
            // ({word}: the blank's name, up to the }.)
            j: int = i + 1;
            while (j < sym_len[tmpl] && sym_byte(tmpl, j) != 125) j = j + 1;
            w: int = sym_of(sym_bytes, sym_start[tmpl] + i + 1, sym_start[tmpl] + j);
            if (w == sym("new") && k >= 0) line_new_names(n, k) else if (w == sym("fact") && k >= 0) line_new_facts(n,
                k) else if (w == sym("with")) {
                for x in 0..mv_wn[m] {
                    if (x > 0) line_add(" and ");
                    line_term(gpool[mv_w0[m] + x])
                }
            } else if (w == sym("hyp") && mv_hyp[m] >= 0) line_term(goal_hyp(g, mv_hyp[m])) else if (w == sym("now") && k >= 0) line_term(gl_concl[pn_goal[k]]) else if (w == sym("goal")) line_term(gl_concl[g]) else if (w == sym("rule") && mv_lemma[m] >= 0) line_rule(mv_lemma[m]);
            i = j + 1
        } else {
            line_byte(c);
            i = i + 1
        }
    }
    line_sym_now()
}

line_rule(l: int) {
    if (lm_words[l] != 0) {
        // (In the middle of a sentence, its first letter small.)
        w: int = lm_words[l];
        for i in 0..sym_len[w] {
            c: int = sym_byte(w, i);
            if (i == 0 && c >= 65 && c <= 90 && sym_len[w] > 1 && sym_byte(w, 1) >= 97) c = c + 32;
            line_byte(c)
        }
    } else line_sym(lm_name[l])
}

// ---- the proof ----
// The whole proof of the level, into pr_.
write_proof() {
    pr_n = 0;
    say_node(root, 0);
    if (level_done()) pr_add(sym_cp(8718), 0, false)
}

say_node(n0: int, depth: int) {
    n: int = n0;
    more: bool = true;
    while (more) {
        more = false;
        m: int = pn_move[n];
        if (m < 0) {
            line_clear();
            line_add("Still to show: ");
            line_term(gl_concl[pn_goal[n]]);
            pr_add(line_sym_now(), depth, false)
        } else if (mv_kind[m] == MV_REWRITE && mv_hyp[m] < 0 && is_equation(gl_concl[pn_goal[n]])) {
            n = say_calc(n, depth);
            more = n >= 0
        } else {
            say_move(n, m, depth);
            // (Side goals the game closed are said in passing; the others,
            // each in turn, before the one that carries on.)
            k: int = main_kid(n);
            for i in 0..pn_kidn[n] - 1 {
                s: int = node_kid(n, i);
                if (!closed_by_game(s)) {
                    line_clear();
                    line_add("For ");
                    line_term(gl_concl[pn_goal[s]]);
                    line_add(":");
                    pr_add(line_sym_now(), depth, false);
                    say_node(s, depth + 1)
                }
            }
            if (k >= 0 && !closed_by_game(k)) {
                n = k;
                more = true
            }
        }
    }
}

// Whether node n was closed by the game itself, by one move.
closed_by_game(n: int): bool {
    m: int = pn_move[n];
    m >= 0 && mv_auto[m]
}

is_equation(p: int): bool {
    is_binary(rel_core(p), role_name[ROLE_EQ])
}

// One move's sentence (and what the game did beside it).
say_move(n: int, m: int, depth: int) {
    k: int = mv_kind[m];
    g: int = pn_goal[n];
    text: int = 0;
    if (k == MV_CALC) {
        line_clear();
        line_add("Then ");
        line_term(gl_concl[g]);
        line_add(" by calculation.");
        text = line_sym_now()
    } else if (k == MV_HYP) {
        line_clear();
        line_add("This is ");
        line_term(gl_concl[g]);
        line_add(", which we have.");
        text = line_sym_now()
    } else {
        l: int = mv_lemma[m];
        t: int = 0;
        if (l >= 0) t = says_for(lm_name[l]);
        if (t == 0) t = default_says(m);
        text = fill(n, m, t)
    }
    // (Side goals closed by calculation, said in brackets.)
    sides: int = 0;
    for i in 0..pn_kidn[n] - 1 {
        s: int = node_kid(n, i);
        if (closed_by_game(s) && mv_kind[pn_move[s]] == MV_CALC) sides = sides + 1
    }
    if (sides > 0) {
        // (Since ε / 2 > 0, by ...: the sentence after, its first letter small.)
        line_clear();
        line_add("Since ");
        first: bool = true;
        for i in 0..pn_kidn[n] - 1 {
            s: int = node_kid(n, i);
            if (closed_by_game(s) && mv_kind[pn_move[s]] == MV_CALC) {
                if (!first) line_add(" and ");
                first = false;
                line_term(gl_concl[pn_goal[s]])
            }
        }
        line_add(", ");
        for i in 0..sym_len[text] {
            c: int = sym_byte(text, i);
            if (i == 0 && c >= 65 && c <= 90) c = c + 32;
            line_byte(c)
        }
        text = line_sym_now()
    }
    pr_add(text, depth, false);
    // (And if what carries on was then closed by the game: said too.)
    km: int = main_kid(n);
    if (km >= 0 && closed_by_game(km) && mv_kind[pn_move[km]] == MV_CALC) {
        line_clear();
        line_add("So ");
        line_term(gl_concl[pn_goal[km]]);
        line_add(", by calculation.");
        pr_add(line_sym_now(), depth, false)
    }
}

default_says(m: int): int {
    k: int = mv_kind[m];
    l: int = mv_lemma[m];
    if (k == MV_REWRITE && l >= 0 && lm_kind[l] == LM_DEF) {
        if (mv_hyp[m] >= 0) return sym("By definition, {fact}.");
        return sym("By definition, we must show {now}.")
    }
    if (k == MV_REWRITE) {
        if (mv_hyp[m] >= 0) return sym("By {rule}, {fact}.");
        return sym("By {rule}, we must show {now}.")
    }
    if (k == MV_FWD) {
        if (mv_hyp[m] >= 0) return sym("From {hyp}, {fact}.");
        return sym("By {rule}, {fact}.")
    }
    if (mv_hyp[m] >= 0) return sym("By {hyp}, it is enough to show {now}.");
    sym("By {rule}, it is enough to show {now}.")
}

// ---- calculations ----
// A run of rewrites of an equation's sides, from node n: the left side
// carried forwards, the right side backwards, until they meet. Returns
// where the proof carries on (or -1 if the run ends it).
cl_left: []int = new int[256](0);

cl_lwhy: []int = new int[256](0);

cl_ln: int = 0;

cl_right: []int = new int[256](0);

cl_rwhy: []int = new int[256](0);

cl_rn: int = 0;

say_calc(n0: int, depth: int): int {
    n: int = n0;
    p: int = rel_core(gl_concl[pn_goal[n]]);
    cl_left[0] = spine_arg(p, 2, 0);
    cl_right[0] = spine_arg(p, 2, 1);
    cl_ln = 1;
    cl_rn = 1;
    going: bool = true;
    next: int = -1;
    while (going) {
        m: int = pn_move[n];
        g: int = pn_goal[n];
        if (m < 0 || mv_kind[m] != MV_REWRITE || mv_hyp[m] >= 0 || !is_equation(gl_concl[g])) {
            going = false;
            next = n;
            // (Ended by the sides being the same: nothing more to say.)
            if (m >= 0 && mv_auto[m]) next = -1
        } else {
            k: int = main_kid(n);
            q: int = rel_core(gl_concl[pn_goal[k]]);
            l2: int = spine_arg(q, 2, 0);
            r2: int = spine_arg(q, 2, 1);
            why: int = calc_reason(m);
            if (l2 != cl_left[cl_ln - 1] && cl_ln < len(cl_left)) {
                cl_left[cl_ln] = l2;
                cl_lwhy[cl_ln] = why;
                cl_ln = cl_ln + 1
            }
            if (r2 != cl_right[cl_rn - 1] && cl_rn < len(cl_right)) {
                cl_right[cl_rn] = r2;
                cl_rwhy[cl_rn] = why;
                cl_rn = cl_rn + 1
            }
            n = k
        }
    }
    // (Left side forwards, then the right side's steps backwards.)
    line_clear();
    line_term(cl_left[0]);
    pr_add(line_sym_now(), depth, true);
    for i in 1..cl_ln calc_step(cl_left[i], cl_lwhy[i], depth);
    j: int = cl_rn - 1;
    while (j >= 1) {
        calc_step(cl_right[j - 1], cl_rwhy[j], depth);
        j = j - 1
    }
    if (cl_left[cl_ln - 1] != cl_right[cl_rn - 1]) {
        // (Not met: the rest of the proof shows the two are equal.)
        line_clear();
        line_add("It remains to show ");
        line_term(gl_concl[pn_goal[n]]);
        line_add(".");
        pr_add(line_sym_now(), depth, false)
    }
    next
}

calc_step(t: int, why: int, depth: int) {
    line_clear();
    line_add("= ");
    line_term(t);
    if (why != 0) {
        line_add("   (");
        line_sym(why);
        line_add(")")
    }
    pr_add(line_sym_now(), depth, true)
}

// Why a rewrite holds: its rule's words, or "by hypothesis".
calc_reason(m: int): int {
    l: int = mv_lemma[m];
    line_clear();
    if (l < 0) {
        line_add("by hypothesis");
        return line_sym_now()
    }
    line_rule(l);
    line_sym_now()
}

// The proof printed, a line to a line (for tests).
print_proof() raises IoError {
    write_proof();
    for i in 0..pr_n {
        line_clear();
        for _ in 0..pr_indent[i] line_add("    ");
        line_sym(pr_text[i]);
        line_print()
    }
}
