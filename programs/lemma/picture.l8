tag lemma_ui;

use_tag std, skate, lemma;

// The picture above a level: the goal, on an example. The proof is about
// every case; the picture shows one, and follows the proof as it goes.
//
// Limits (picture sequence): the sequences of the level, dot by dot, with
// their limits. What a hypothesis or the goal says about a sequence
// (from N on, within r of L: ∀n≥N. |sₙ − L| < r) is drawn as a band r
// wide about L, from a gate at N on. The ε a player takes is the other
// side's choice: it can be dragged, and every N found from it moves.
//
// Groups (picture square): the goal's two sides as rows of tiles, a letter
// train (below), that follow every move.
pic_reset() {
    pic_eps = 0.6;
    pic_n_extra = 2.0
}

pic_moved() { }

// ---- numbers ----
// The value a term has in the example, as a float (sequences are
// functions of the natural numbers; natural numbers are floats too). NaN
// for what cannot be worked out (a for-all over the reals).
const NAN_V: f32 = 1.0e30;

// Values of the fixed names now (by term).
pv_term: []int = new int[64](0);

pv_val: []f32 = new f32[64](0.0);

pv_n: int = 0;

// Bound variables' values, innermost last.
pb_val: []f32 = new f32[64](0.0);

pb_n: int = 0;

pv_of(t: int): f32 {
    for i in 0..pv_n {
        if (pv_term[i] == t) return pv_val[i]
    }
    NAN_V
}

pv_set(t: int, v: f32) {
    for i in 0..pv_n {
        if (pv_term[i] == t) {
            pv_val[i] = v;
            return
        }
    }
    if (pv_n < len(pv_term)) {
        pv_term[pv_n] = t;
        pv_val[pv_n] = v;
        pv_n = pv_n + 1
    }
}

// The example's sequences: by term, each a few numbers (its limit, how
// far it starts from it, how it closes in).
ps_term: []int = new int[16](0);

ps_lim: []f32 = new f32[16](0.0);

ps_amp: []f32 = new f32[16](0.0);

ps_ratio: []f32 = new f32[16](0.0);

ps_n: int = 0;

seq_at(t: int, n: f32): f32 {
    for i in 0..ps_n {
        if (ps_term[i] == t) return ps_lim[i] + ps_amp[i] * powd(ps_ratio[i], n)
    }
    NAN_V
}

powd(r: f32, n: f32): f32 {
    k: int = n as int;
    v: f32 = 1.0;
    for _ in 0..mini(k, 400) v = v * r;
    v
}

absd(x: f32): f32 {
    if (x < 0.0) return -x;
    x
}

maxd(a: f32, b: f32): f32 {
    if (a > b) return a;
    b
}

// The value of t (bound variables in pb_).
num(t: int): f32 {
    k: int = tm_kind(t);
    if (k == TM_BOUND) {
        i: int = pb_n - 1 - tm_bound_index(t);
        if (i >= 0) return pb_val[i];
        return NAN_V
    }
    v: int = numeral_value(t);
    if (v >= 0) return v as f32;
    if (k == TM_FREE) return pv_of(t);
    if (k != TM_APP) return NAN_V;
    if (is_role(t, CR_PLUS, 2)) return bin(t, 0);
    if (is_role(t, CR_MINUS, 2)) return bin(t, 1);
    if (is_role(t, CR_TIMES, 2)) return bin(t, 2);
    if (is_role(t, CR_DIVIDE, 2)) return bin(t, 3);
    if (is_role(t, CR_NMAX, 2)) return bin(t, 4);
    if (is_role(t, CR_NEG, 1)) {
        a: f32 = num(tm_arg(t));
        if (a == NAN_V) return NAN_V;
        return -a
    }
    if (is_role(t, CR_ABS, 1)) {
        a: f32 = num(tm_arg(t));
        if (a == NAN_V) return NAN_V;
        return absd(a)
    }
    // (A sequence at a place, or a λ applied.)
    f: int = tm_fun(t);
    if (tm_kind(f) == TM_FREE) {
        n: f32 = num(tm_arg(t));
        if (n == NAN_V) return NAN_V;
        return seq_at(f, n)
    }
    if (tm_kind(f) == TM_ABS) {
        a: f32 = num(tm_arg(t));
        if (pb_n >= len(pb_val)) return NAN_V;
        pb_val[pb_n] = a;
        pb_n = pb_n + 1;
        r: f32 = num(tm_body(f));
        pb_n = pb_n - 1;
        return r
    }
    NAN_V
}

bin(t: int, op: int): f32 {
    a: f32 = num(spine_arg(t, 2, 0));
    b: f32 = num(spine_arg(t, 2, 1));
    if (a == NAN_V || b == NAN_V) return NAN_V;
    if (op == 0) return a + b;
    if (op == 1) return a - b;
    if (op == 2) return a * b;
    if (op == 3) {
        if (b == 0.0) return NAN_V;
        return a / b
    }
    maxd(a, b)
}

// ---- what the statements say about sequences ----
// A band: sequence term (or λ), its limit's term, its width's term, and
// its gate's (from n on; 0 if none), and whether it is the goal's.
const BANDS: int = 16;

bd_seq: []int = new int[BANDS](0);

bd_lim: []int = new int[BANDS](0);

bd_r: []int = new int[BANDS](0);

bd_gate: []int = new int[BANDS](0);

bd_goal: []bool = new bool[BANDS](false);

// Whether a band is said at one n (|aₙ − A| < ε / 2 for the n taken),
// not from a gate on: it is eased apart from the sequence's gated band.
bd_pt: []bool = new bool[BANDS](false);

// (A band only a thing held would bring: drawn faint.)
bd_prev: []bool = new bool[BANDS](false);

band_prev: bool = false;

bf_point: bool = false;

bd_n: int = 0;

// Whether p is |s n − L| < r, for the bound variable n (or the fixed n),
// recording s, L, r (the sequence being s applied: s is what n is applied
// to, or the λ of the whole). bd_at: the n if fixed.
bf_seq: int = 0;

bf_lim: int = 0;

bf_r: int = 0;

bf_at: int = 0;

band_form(p0: int): bool {
    p: int = rel_core(p0);
    if (!is_role(p, CR_LT, 2)) return false;
    l: int = spine_arg(p, 2, 0);
    bf_r = spine_arg(p, 2, 1);
    if (!is_role(l, CR_ABS, 1)) return false;
    d: int = tm_arg(l);
    if (!is_role(d, CR_MINUS, 2)) return false;
    s: int = spine_arg(d, 2, 0);
    bf_lim = spine_arg(d, 2, 1);
    bf_seq = s;
    bf_at = 0;
    if (tm_kind(s) == TM_APP) {
        bf_at = tm_arg(s);
        bf_seq = tm_fun(s);
        // (A sum like aₙ + bₙ: the whole, as a function of n, at the n
        // in it, if one is fixed.)
        if (tm_kind(bf_seq) != TM_FREE) {
            bf_seq = s;
            bf_at = nat_free_in(s)
        }
    }
    true
}

// A fixed natural number in t (the n of aₙ + bₙ), or 0.
nat_free_in(t: int): int {
    k: int = tm_kind(t);
    if (k == TM_FREE) {
        ty: int = tm_type(t);
        if (!is_real_type(ty) && ty_kind(ty) != TY_FUN) return t;
        return 0
    }
    if (k == TM_APP) {
        a: int = nat_free_in(tm_fun(t));
        if (a != 0) return a;
        return nat_free_in(tm_arg(t))
    }
    if (k == TM_ABS) return nat_free_in(tm_body(t));
    0
}

// What a statement says, as a band, if it says one: ∀n≥K. |sₙ − L| < r
// (gated at K), ∃N. ∀n≥N. ... (to be gated), or |sₙ − L| < r.
band_of(p0: int, goal: bool) {
    p: int = rel_core(p0);
    gate: int = 0;
    under: int = 0;
    if (is_binary(p, role_name[ROLE_EX]) || tm_kind(p) == TM_APP && tm_kind(tm_fun(p)) == TM_CONST && tm_name(tm_fun(p)) == role_name[ROLE_EX] && tm_kind(tm_arg(p)) == TM_ABS) {
        p = tm_body(tm_arg(p));
        under = 1
    }
    if (tm_kind(p) == TM_APP && tm_kind(tm_fun(p)) == TM_CONST && tm_name(tm_fun(p)) == role_name[ROLE_ALL] && tm_kind(tm_arg(p)) == TM_ABS) {
        body: int = tm_body(tm_arg(p));
        if (is_binary(body, role_name[ROLE_IMP])) {
            cond: int = spine_arg(body, 2, 0);
            if (is_role(cond, CR_NLE, 2) && tm_closed(spine_arg(cond, 2, 0))) gate = spine_arg(cond,
                2, 0);
            body = spine_arg(body, 2, 1)
        }
        if (band_form(body) && tm_closed(bf_lim) && tm_closed(bf_r) && under == 0) add_band(gate,
            goal) else if (band_form(body) && under == 1 && tm_closed(bf_lim) && tm_closed(bf_r)) add_band(0,
            goal);
        return
    }
    if (under == 0 && band_form(p) && tm_closed(bf_lim) && tm_closed(bf_r)) {
        bf_point = true;
        add_band(bf_at, goal);
        bf_point = false
    }
}

add_band(gate: int, goal: bool) {
    if (bd_n >= BANDS) return;
    // (A sequence written with n bound: the λ of it is not closed, so the
    // goal's is taken whole from the level's statement instead.)
    s: int = bf_seq;
    if (!tm_closed(s) || tm_kind(s) != TM_FREE && tm_kind(s) != TM_ABS) s = goal_seq;
    if (s == 0) return;
    bd_seq[bd_n] = s;
    bd_lim[bd_n] = bf_lim;
    bd_r[bd_n] = bf_r;
    bd_gate[bd_n] = gate;
    bd_goal[bd_n] = goal;
    bd_pt[bd_n] = bf_point;
    bd_prev[bd_n] = band_prev;
    bd_n = bd_n + 1
}

// The level's own sequence: s in its statement's s → L (or 0).
goal_seq: int = 0;

goal_lim: int = 0;

// ---- the ε handle ----
pic_eps: f32 = 0.6;

pic_n_extra: f32 = 2.0;

// Where the handle is drawn (to be grabbed), and whether it is shown.
handle_x: f32 = 0.0;

handle_y: f32 = 0.0;

handle_on: bool = false;

handle_held: bool = false;

// The picture's frame and scale, for dragging.
pf_y0: f32 = 0.0;

pf_y1: f32 = 0.0;

pf_lo: f32 = 0.0;

pf_hi: f32 = 1.0;

pic_grab(x: f32, y: f32): bool {
    if (!handle_on) return false;
    if (absf(x - handle_x) < 30.0 && absf(y - handle_y) < 30.0) {
        handle_held = true;
        return true
    }
    false
}

// Dragged: ε is how far the handle is above the goal's limit line.
pic_drag(x: f32, y: f32) {
    if (!handle_held || pf_y1 <= pf_y0) return;
    v: f32 = pf_lo + ((pf_y1 - y) / (pf_y1 - pf_y0)) as f32 * (pf_hi - pf_lo);
    lim: f32 = pic_goal_lim_v;
    pic_eps = maxd(absd(v - lim), 0.03);
    if (pic_eps > (pf_hi - pf_lo) * 0.6) pic_eps = (pf_hi - pf_lo) * 0.6;
    busy = true;
    if (x < -1000.0) pic_eps = 0.6
}

pic_drop() {
    handle_held = false
}

pic_goal_lim_v: f32 = 0.0;

// ---- the example ----
// Give the fixed names of goal g values: reals and sequences from the
// level's statement, then each name a move brought in, in order.
pic_values(g: int) {
    pv_n = 0;
    ps_n = 0;
    if (cur_level < 0) return;
    // (The level's statement, with its own names: its sequences, and
    // what they tend to.)
    g0: int = pn_goal[root];
    reals: int = 0;
    for i in 0..gl_fixn[pn_goal[root]] {
        x: int = goal_fix(pn_goal[root], i);
        ty: int = tm_type(x);
        if (ty_kind(ty) == TY_FUN) {
            if (ps_n < len(ps_term)) {
                ps_term[ps_n] = x;
                ps_amp[ps_n] = 1.3 - ps_n as f32 * 0.5;
                if (ps_n % 2 == 1) ps_ratio[ps_n] = -0.9 else ps_ratio[ps_n] = 0.78;
                ps_lim[ps_n] = 0.0;
                ps_n = ps_n + 1
            }
        } else if (is_real_type(ty)) {
            presets: []f32 = real_presets;
            pv_set(x, presets[reals % len(presets)]);
            reals = reals + 1
        }
    }
    // (A sequence tends to what the statement says.)
    for i in 0..ps_n {
        for j in 0..gl_hypn[g0] set_limit_from(goal_hyp(g0, j), ps_term[i]);
        set_limit_from(gl_concl[g0], ps_term[i])
    }
    goal_seq = 0;
    goal_lim = 0;
    find_goal_seq(gl_concl[g0]);
    // (Then what the moves brought in.)
    for i in gl_fixn[pn_goal[root]]..gl_fixn[g] {
        x: int = goal_fix(g, i);
        if (is_real_type(tm_type(x))) pv_set(x, pic_eps) else pv_set(x, nat_value(g,
            x))
    }
}

real_presets: []f32 = [1.0, -0.6, 0.7, 1.6];

is_real_type(t: int): bool {
    e: int = find_ent(calc_role[CR_LT], 1 << E_FIX);
    e >= 0 && ty_dom(ent_ty[e]) == t
}

// In statement p, s → L: s's limit is L's value.
set_limit_from(p: int, s: int) {
    k: int = tm_kind(p);
    if (k == TM_APP) {
        if (spine_len(p) == 2 && tm_kind(spine_head(p)) == TM_FREE && sym_len[tm_name(spine_head(p))] > 0 && spine_arg(p,
            2, 0) == s && is_tendsto(spine_head(p))) {
            v: f32 = num(spine_arg(p, 2, 1));
            for i in 0..ps_n {
                if (ps_term[i] == s && v != NAN_V && ps_lim[i] == 0.0) ps_lim[i] = v
            }
        }
        set_limit_from(tm_fun(p), s);
        set_limit_from(tm_arg(p), s)
    } else if (k == TM_ABS) set_limit_from(tm_body(p), s)
}

is_tendsto(h: int): bool {
    tm_name(h) == sym("tendsto")
}

// The statement's conclusion s → L: the goal's sequence and limit.
find_goal_seq(p: int) {
    q: int = p;
    while (is_imp(q)) q = rhs_of(q);
    c: int = rel_core(q);
    if (spine_len(c) == 2 && is_tendsto(spine_head(c))) {
        goal_seq = spine_arg(c, 2, 0);
        goal_lim = spine_arg(c, 2, 1)
    }
}

// A natural number the moves brought in: the least gate that its band
// holds from (an N from "there is an N"), or a little past its lower
// bound (an n with n ≥ max(N, N₁)), or 0.
nat_value(g: int, x: int): f32 {
    // (An n with a lower bound is past it, whatever is said at it.)
    for i in 0..gl_hypn[g] {
        p: int = rel_core(goal_hyp(g, i));
        if (is_role(p, CR_NLE, 2) && spine_arg(p, 2, 1) == x) {
            lo: f32 = num(spine_arg(p, 2, 0));
            if (lo != NAN_V) return lo + pic_n_extra
        }
    }
    // (An N a band holds from: the least such. A band said at one n
    // (|aₙ − A| < ε / 2) does not place n.)
    for i in 0..gl_hypn[g] {
        bd_n = 0;
        band_of(goal_hyp(g, i), false);
        if (bd_n > 0 && !bd_pt[0] && bd_gate[0] == x) return least_gate(bd_seq[0],
            bd_lim[0], bd_r[0])
    }
    0.0
}

// The least N from which sequence s stays within r of L (as far as 400).
least_gate(s: int, lim: int, r: int): f32 {
    l: f32 = num(lim);
    w: f32 = num(r);
    if (l == NAN_V || w == NAN_V) return 0.0;
    last_out: int = -1;
    for n in 0..400 {
        v: f32 = seq_value(s, n as f32);
        if (v == NAN_V || absd(v - l) >= w) last_out = n
    }
    (last_out + 1) as f32
}

// Sequence s (a name, or a λ) at n.
seq_value(s: int, n: f32): f32 {
    if (tm_kind(s) == TM_FREE) return seq_at(s, n);
    if (tm_kind(s) == TM_ABS) {
        if (pb_n >= len(pb_val)) return NAN_V;
        pb_val[pb_n] = n;
        pb_n = pb_n + 1;
        r: f32 = num(tm_body(s));
        pb_n = pb_n - 1;
        return r
    }
    NAN_V
}

// ---- drawing ----
draw_picture(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    p_shadow(x, y, w, h, 20.0, 3.0, 12.0, 0.12);
    p_box(x, y, w, h, 20.0, C_CARD, 1.0);
    handle_on = false;
    n: int = play_node();
    if (n < 0) n = root;
    g: int = pn_goal[n];
    pic_node = n;
    p_clip(x + 2.0, y + 2.0, x + w - 2.0, y + h - 2.0);
    if (region_picture == sym("sequence")) draw_sequences(x, y, w, h, g) else if (region_picture == sym("square")) draw_train(x,
        y, w, h, g);
    p_noclip()
}

// The colors sequences are drawn in.
seq_colors: []int = [3824544, 2792847, 9067704, 14518826];

draw_sequences(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    g: int
) {
    pic_values(g);
    pb_n = 0;
    // (What is said about the sequences: the goal's band, and the
    // hypotheses'.)
    bd_n = 0;
    // (The goal as a thing held over it would make it: its gate slides to
    // the N dropped in.)
    band_of(lang_goal_term(gl_concl[g]), true);
    // (A goal X ≤ n left by a Use with (N₁ ≤ n, with n taken past N): the
    // picture keeps the goal it was for (its band, n, the red dots), and
    // shows why it fails, if it does: X past n, its gate red.)
    side_lo = 0;
    side_n = 0;
    sc: int = rel_core(gl_concl[g]);
    if (is_role(sc, CR_NLE, 2) && tm_closed(spine_arg(sc, 2, 0)) && tm_kind(spine_arg(sc,
        2, 1)) == TM_FREE && is_little_n(spine_arg(sc, 2, 1))) {
        side_lo = spine_arg(sc, 2, 0);
        side_n = spine_arg(sc, 2, 1);
        // (The goal it is for: the one the Use with was made at, up the
        // proof, closed or not.)
        a: int = pn_parent[pic_node];
        while (a >= 0 && bd_n == 0) {
            band_of(gl_concl[pn_goal[a]], true);
            a = pn_parent[a]
        }
    } else if (bd_n == 0 && pic_node >= 0 && use_with_side(pic_node)) {
        // (Any other side condition a Use with left (A > 0, a dead end):
        // the goal it was made on, as it was.)
        a: int = pn_parent[pic_node];
        while (a >= 0 && bd_n == 0) {
            band_of(gl_concl[pn_goal[a]], true);
            a = pn_parent[a]
        }
    }
    for i in 0..gl_hypn[g] {
        band_of(goal_hyp(g, i), false);
        // (A name held over a fact's notch: the fact it would give, its
        // band coming in faint.)
        if (lang_fact_target(i) && hv_fact != 0) {
            band_prev = true;
            band_of(hv_fact, false);
            band_prev = false
        }
    }
    // (The range: every value shown, and the limits.)
    lo: f32 = 1.0e9;
    hi: f32 = -1.0e9;
    nmax: int = 24;
    for i in 0..ps_n {
        for k in 0..nmax {
            v: f32 = seq_at(ps_term[i], k as f32);
            if (v < lo) lo = v;
            if (v > hi) hi = v
        }
    }
    if (goal_seq != 0) {
        for k in 0..nmax {
            v: f32 = seq_value(goal_seq, k as f32);
            if (v != NAN_V) {
                if (v < lo) lo = v;
                if (v > hi) hi = v
            }
        }
    }
    // (And every limit named, so its line shows.)
    g0n: int = pn_goal[root];
    for i in 0..gl_fixn[g0n] {
        xl: int = goal_fix(g0n, i);
        if (is_real_type(tm_type(xl)) && named_as_limit(g0n, xl)) {
            v: f32 = pv_of(xl);
            if (v != NAN_V) {
                if (v < lo) lo = v;
                if (v > hi) hi = v
            }
        }
    }
    // (The goal's limit too, when it is worked out (A + 1).)
    glv: f32 = NAN_V;
    if (goal_lim != 0 && tm_kind(goal_lim) != TM_FREE) glv = num(goal_lim);
    if (glv != NAN_V) {
        if (glv < lo) lo = glv;
        if (glv > hi) hi = glv
    }
    if (hi < lo) {
        lo = -1.0;
        hi = 1.0
    }
    // (Room for the bands too, but not past a little more than the dots
    // need: a wide ε is just a wide band.)
    if (hi - lo < 1.0) {
        mid: f32 = (hi + lo) * 0.5;
        lo = mid - 0.5;
        hi = mid + 0.5
    }
    for b in 0..bd_n {
        lim: f32 = num(bd_lim[b]);
        r: f32 = num(bd_r[b]);
        if (lim != NAN_V && r != NAN_V) {
            room: f32 = minf(r, (hi - lo) * 0.6);
            if (lim + room > hi) hi = lim + room;
            if (lim - room < lo) lo = lim - room
        }
    }
    span: f32 = hi - lo;
    lo = lo - span * 0.12;
    hi = hi + span * 0.12;
    px0: f32 = x + 34.0;
    px1: f32 = x + w - 16.0;
    py0: f32 = y + 14.0;
    py1: f32 = y + h - 26.0;
    pf_y0 = py0;
    pf_y1 = py1;
    pf_lo = lo;
    pf_hi = hi;
    // (The axis of n.)
    p_line(px0, py1, px1, py1, 1.5, C_LINE, 1.0);
    p_str(0, 12.0, px1 - 8.0, py1 + 18.0, "n", C_MUTED, 1.0);
    // (The bands, under the dots.)
    pe_frame = pe_frame + 1;
    side_n_drawn = false;
    side_red = false;
    if (side_lo != 0) {
        lv: f32 = num(side_lo);
        nv: f32 = num(side_n);
        side_red = lv != NAN_V && nv != NAN_V && nv < lv
    }
    goal_gate_v = -1.0;
    gate_lab_n = 0;
    for b in 0..bd_n {
        lim: f32 = num(bd_lim[b]);
        r: f32 = num(bd_r[b]);
        if (lim != NAN_V && r != NAN_V && r > 0.0) {
            gate: f32 = 0.0;
            if (bd_gate[b] != 0) gate = num(bd_gate[b]);
            if (gate == NAN_V) gate = 0.0;
            gx: f32 = px0 + (px1 - px0) * (gate as f32 / nmax as f32);
            // (Eased, each band by its sequence: a new band narrows from ε
            // to what it was asked for, and the goal's gate slides to where
            // it is chosen.)
            key: int = bd_seq[b] * 4;
            if (bd_goal[b]) key = key + 1;
            if (bd_pt[b] && !bd_goal[b]) key = key + 2;
            k: int = pe_get(key, gx, r);
            if (k >= 0) {
                pe_x[k] = spring(pe_x[k], pe_vx[k], gx, 120.0, 14.0);
                pe_vx[k] = spring_v;
                pe_r[k] = ease_to(pe_r[k], r, 5.0);
                if (handle_held || an_jump) {
                    pe_x[k] = gx;
                    pe_r[k] = r
                }
                pe_seen[k] = pe_frame;
                gx = pe_x[k];
                r = pe_r[k]
            }
            if (bd_goal[b]) goal_gate_v = gate;
            if (!bd_goal[b]) {
                bd_rv[b] = num(bd_r[b]);
                bd_gv[b] = gate
            }
            ya: f32 = pic_y(lim + r, py0, py1, lo, hi);
            yb: f32 = pic_y(lim - r, py0, py1, lo, hi);
            col: int = C_GOLD;
            if (bd_goal[b]) col = C_PICK;
            if (bd_gate[b] == side_n && side_n != 0) side_n_drawn = true;
            // (Only a name's gate, or the goal's chosen one, is drawn and
            // named: not a term a fact was used with (max(N, N₁) at N₁).)
            named: bool = tm_kind(bd_gate[b]) == TM_FREE || bd_goal[b];
            if (gx < px1) {
                ba: f32 = 0.16;
                if (bd_prev[b]) {
                    ba = 0.1;
                    p_outline(gx, ya, px1 - gx, yb - ya, 6.0, 1.5, col, 0.5)
                }
                p_box(gx, ya, px1 - gx, yb - ya, 6.0, col, ba);
                // (A gate two bands share (n, for the goal and for the
                // fact said at n) is drawn once.)
                twice: bool = false;
                for b2 in 0..b {
                    if (bd_gate[b2] == bd_gate[b]) twice = true
                }
                if (bd_gate[b] != 0 && !twice && named) {
                    lc: int = col;
                    if (side_red && bd_gate[b] == side_lo) lc = soft_red();
                    p_line(gx, py0, gx, py1, 2.0, lc, 0.8);
                    // (Gates in one place (max(N, N₁) at N₁): their names
                    // one under another.)
                    ly: f32 = py0 + 12.0;
                    for j in 0..gate_lab_n {
                        if (absf(gate_lab_x[j] - gx) < 24.0) ly = ly + 15.0
                    }
                    if (gate_lab_n < len(gate_lab_x)) {
                        gate_lab_x[gate_lab_n] = gx;
                        gate_lab_n = gate_lab_n + 1
                    }
                    p_sym(1, 12.0, gx + 3.0, ly, gate_name(bd_gate[b]), lc, 1.0)
                }
            }
            // (The goal's ε: a handle on the band's edge.)
            if (bd_goal[b] && is_eps(bd_r[b])) {
                handle_on = true;
                handle_x = px1 - 14.0;
                handle_y = ya;
                pic_goal_lim_v = lim;
                p_disc(handle_x, handle_y, 8.0, C_PICK, 1.0);
                p_sym(1, 13.0, handle_x - 22.0, handle_y - 8.0, sym_cp(949), C_PICK,
                    1.0)
            }
        }
    }
    if (side_n != 0) draw_side_gap(px0, px1, py0, py1, nmax);
    // (Each limit named in the statement, a dashed line with its name.)
    g0: int = pn_goal[root];
    for i in 0..gl_fixn[g0] {
        xl: int = goal_fix(g0, i);
        if (is_real_type(tm_type(xl)) && named_as_limit(g0, xl)) {
            ly: f32 = pic_y(pv_of(xl), py0, py1, lo, hi);
            dashed(px0, ly, px1, C_MUTED);
            p_sym(1, 12.0, px1 - 2.0, ly - 4.0, tm_name(xl), C_MUTED, 1.0)
        }
    }
    if (glv != NAN_V) {
        ly: f32 = pic_y(glv, py0, py1, lo, hi);
        dashed(px0, ly, px1, C_INK);
        gn: int = gate_name(goal_lim);
        p_sym(1, 12.0, px1 - 2.0 - p_sym_w(1, 12.0, gn), ly + 14.0, gn, C_INK, 0.8)
    }
    // (The dots: each sequence, and the goal's if it is made of them.)
    for i in 0..ps_n {
        col: int = seq_colors[i % len(seq_colors)];
        // (Once the goal's gate is chosen: this sequence's band, if a fact
        // gives it one. A dot past the goal's gate outside it is ringed in a
        // soft red: from there on, nothing yet keeps it close.)
        hb: int = -1;
        for b in 0..bd_n {
            if (!bd_goal[b] && !bd_pt[b] && bd_seq[b] == ps_term[i] && bd_gate[b] != 0) hb = b
        }
        for k in 0..nmax {
            v: f32 = seq_at(ps_term[i], k as f32);
            dx: f32 = px0 + (px1 - px0) * (k as f32 / nmax as f32);
            dy: f32 = pic_y(v, py0, py1, lo, hi);
            out: bool = false;
            if (hb >= 0 && goal_gate_v > 0.0 && k as f32 >= goal_gate_v) {
                lim: f32 = num(bd_lim[hb]);
                if (lim != NAN_V && bd_rv[hb] != NAN_V && absd(v - lim) >= bd_rv[hb]) out = true
            }
            if (out) {
                p_disc(dx, dy, 3.6, soft_red(), 1.0);
                p_ring(dx, dy, 6.5, 1.2, soft_red(), 0.5)
            } else p_disc(dx, dy, 2.6, col, 0.75)
        }
        p_sym(1, 13.0, x + 10.0, pic_y(seq_at(ps_term[i], 0.0), py0, py1, lo, hi) + 5.0,
            tm_name(ps_term[i]), col, 1.0)
    }
    if (goal_seq != 0 && tm_kind(goal_seq) == TM_ABS) {
        for k in 0..nmax {
            v: f32 = seq_value(goal_seq, k as f32);
            if (v != NAN_V) p_disc(px0 + (px1 - px0) * (k as f32 / nmax as f32), pic_y(v,
                py0, py1, lo, hi), 3.6, C_INK, 0.9)
        }
    }
    // (The n taken, if any: its dot, ringed.)
    for i in 0..gl_fixn[g] {
        xn: int = goal_fix(g, i);
        if (!is_real_type(tm_type(xn)) && ty_kind(tm_type(xn)) != TY_FUN && is_little_n(xn)) {
            nv: f32 = pv_of(xn);
            if (nv != NAN_V && nv < nmax as f32 && goal_seq != 0) {
                v: f32 = seq_value(goal_seq, nv);
                if (v != NAN_V) {
                    cx: f32 = px0 + (px1 - px0) * (nv as f32 / nmax as f32);
                    p_ring(cx, pic_y(v, py0, py1, lo, hi), 7.0, 2.0, C_PICK, 1.0)
                }
            }
        }
    }
}

// The node the picture is of; the goal X ≤ n it is at, if it is (X, n),
// whether n's gate was drawn, and whether X is past n (it cannot be shown).
pic_node: int = -1;

side_lo: int = 0;

side_n: int = 0;

side_n_drawn: bool = false;

side_red: bool = false;

// The goal X ≤ n: n's gate (if no band drew it), and, when X is past n, a
// red bracket from n to X: n is not far enough.
draw_side_gap(
    px0: f32,
    px1: f32,
    py0: f32,
    py1: f32,
    nmax: int
) {
    nv: f32 = num(side_n);
    if (nv == NAN_V) return;
    nx: f32 = px0 + (px1 - px0) * (nv as f32 / nmax as f32);
    if (!side_n_drawn) {
        p_line(nx, py0, nx, py1, 2.0, C_PICK, 0.8);
        ly: f32 = py0 + 12.0;
        for j in 0..gate_lab_n {
            if (absf(gate_lab_x[j] - nx) < 24.0) ly = ly + 15.0
        }
        p_sym(1, 12.0, nx + 3.0, ly, tm_name(side_n), C_PICK, 1.0)
    }
    if (!side_red) return;
    lx: f32 = px0 + (px1 - px0) * (num(side_lo) as f32 / nmax as f32);
    // (The bracket, near the axis, under the dots.)
    by: f32 = py1 - 12.0;
    p_line(nx, by, lx, by, 2.5, soft_red(), 0.85);
    p_line(nx, by - 7.0, nx, by + 7.0, 2.5, soft_red(), 0.85);
    p_line(lx, by - 7.0, lx, by + 7.0, 2.5, soft_red(), 0.85)
}

// What is not so yet, in a picture: a red softened toward grey.
soft_red(): int {
    mix_rgb(C_RED, C_MUTED, 0.4)
}

// Where gates' names were written this frame.
gate_lab_x: []f32 = new f32[BANDS](0.0);

gate_lab_n: int = 0;

// The bands, eased (by sequence, and whether the goal's): the gate's x,
// how fast it goes, the half width, and the frame last seen.
const PE: int = 32;

pe_key: []int = new int[PE](0);

pe_x: []f32 = new f32[PE](0.0);

pe_vx: []f32 = new f32[PE](0.0);

pe_r: []f32 = new f32[PE](0.0);

pe_seen: []int = new int[PE](-10);

pe_frame: int = 0;

// The goal's gate (its n), once there is one (-1 none); each band's half
// width and gate, as numbers.
goal_gate_v: f32 = -1.0;

bd_rv: []f32 = new f32[BANDS](0.0);

bd_gv: []f32 = new f32[BANDS](0.0);

// The eased band for a key: new ones start at the left edge, as wide as
// the goal's ε (so a band asked for less narrows to it).
pe_get(key: int, x: f32, r: f32): int {
    free: int = -1;
    for i in 0..PE {
        if (pe_key[i] == key && pe_seen[i] >= pe_frame - 2) return i;
        if (free < 0 && pe_seen[i] < pe_frame - 2) free = i
    }
    if (free < 0) return -1;
    pe_key[free] = key;
    pe_x[free] = x;
    pe_vx[free] = 0.0;
    pe_r[free] = maxd(r, pic_eps);
    if (r > pic_eps) pe_r[free] = r;
    pe_seen[free] = pe_frame;
    free
}

pic_y(
    v: f32,
    y0: f32,
    y1: f32,
    lo: f32,
    hi: f32
): f32 {
    y1 - ((v - lo) / (hi - lo)) as f32 * (y1 - y0)
}

dashed(
    x0: f32,
    y: f32,
    x1: f32,
    col: int
) {
    xx: f32 = x0;
    while (xx < x1) {
        p_line(xx, y, minf(xx + 6.0, x1), y, 1.2, col, 0.5);
        xx = xx + 11.0
    }
}

// Whether x is what a sequence is said to tend to (s → x) in goal g.
named_as_limit(g: int, x: int): bool {
    for j in 0..gl_hypn[g] {
        c: int = rel_core(goal_hyp(g, j));
        if (spine_len(c) == 2 && is_tendsto(spine_head(c)) && spine_arg(c, 2, 1) == x) return true
    }
    c: int = rel_core(gl_concl[g]);
    spine_len(c) == 2 && is_tendsto(spine_head(c)) && spine_arg(c, 2, 1) == x
}

// A gate's name, shown (N, N₁, max(N, N₁)).
gate_name(t: int): int {
    show_line(t);
    line_sym_now()
}

is_eps(t: int): bool {
    tm_kind(t) == TM_FREE
}

// Whether a fixed name is a small n (an index, not a gate).
is_little_n(x: int): bool {
    s: int = tm_name(x);
    sym_len[s] > 0 && sym_byte(s, 0) == 110
}

// ---- the letter train (groups) ----
// Each side of the goal's equation as a row of chunky tiles, one a name
// (a⁻¹ the same color as a, hollow), read left to right; how a product is
// grouped is how close its tiles sit, and an inner product has a soft pill
// under it. An e is faint; a pair x⁻¹ · x put side by side glows (the
// inverse rule would squash it to e). Tiles slide when the goal changes,
// new ones swell in, gone ones pop. When the two sides are the same, the
// rows slide together into one: the goal closes.
const TILES: int = 96;

trtk_kind: []int = new int[TILES](0);

trtk_sym: []int = new int[TILES](0);

trtk_side: []int = new int[TILES](0);

trtk_gap: []int = new int[TILES](0);

trtk_key: []int = new int[TILES](0);

trtk_x: []f32 = new f32[TILES](0.0);

trtk_w: []f32 = new f32[TILES](0.0);

trtk_n: int = 0;

// The products of two or more tiles: their first and last tile, how deep,
// and whether they are a pair x⁻¹ · x (or x · x⁻¹).
const TNODES: int = 64;

trtn_first: []int = new int[TNODES](0);

trtn_last: []int = new int[TNODES](0);

trtn_depth: []int = new int[TNODES](0);

trtn_pair: []bool = new bool[TNODES](false);

trtn_n: int = 0;

// The gap the next tile is put after (a product's depth; -1: close up).
tr_pending: int = -1;

tr_side: int = 0;

const TK_NAME: int = 0;

const TK_INV: int = 1;

const TK_E: int = 2;

const TK_OPEN: int = 3;

const TK_CLOSE: int = 4;

tr_mul(t: int): bool {
    spine_len(t) == 2 && tm_kind(spine_head(t)) == TM_FREE && tm_name(spine_head(t)) == sym("mul")
}

tr_inv(t: int): bool {
    tm_kind(t) == TM_APP && tm_kind(tm_fun(t)) == TM_FREE && tm_name(tm_fun(t)) == sym("inv")
}

tr_tile(kind: int, s: int) {
    if (trtk_n >= TILES) return;
    i: int = trtk_n;
    trtk_kind[i] = kind;
    trtk_sym[i] = s;
    trtk_side[i] = tr_side;
    trtk_gap[i] = tr_pending;
    tr_pending = -1;
    // (Known by side, kind, name, and which of its kind it is.)
    occ: int = 0;
    for j in 0..i {
        if (trtk_side[j] == tr_side && trtk_kind[j] == kind && trtk_sym[j] == s) occ = occ + 1
    }
    trtk_key[i] = ((s * 8 + kind) * 16 + mini(occ, 15)) * 2 + tr_side;
    trtk_n = i + 1
}

tr_walk(t: int, depth: int) {
    if (tr_mul(t)) {
        first: int = trtk_n;
        a: int = spine_arg(t, 2, 0);
        b: int = spine_arg(t, 2, 1);
        tr_walk(a, depth + 1);
        tr_pending = depth;
        tr_walk(b, depth + 1);
        if (trtn_n < TNODES) {
            trtn_first[trtn_n] = first;
            trtn_last[trtn_n] = trtk_n - 1;
            trtn_depth[trtn_n] = depth;
            trtn_pair[trtn_n] = tr_inv(a) && tm_arg(a) == b || tr_inv(b) && tm_arg(b) == a;
            trtn_n = trtn_n + 1
        }
        return
    }
    if (tr_inv(t)) {
        x: int = tm_arg(t);
        if (tm_kind(x) == TM_FREE && tm_name(x) != sym("e")) {
            tr_tile(TK_INV, tm_name(x));
            return
        }
        tr_tile(TK_OPEN, sym("("));
        tr_walk(x, depth + 1);
        tr_tile(TK_CLOSE, sym(")"));
        return
    }
    if (tm_kind(t) == TM_FREE && tm_name(t) == sym("e")) {
        tr_tile(TK_E, sym("e"));
        return
    }
    if (tm_kind(t) == TM_FREE) {
        tr_tile(TK_NAME, tm_name(t));
        return
    }
    show_line(t);
    tr_tile(TK_NAME, line_sym_now())
}

// The superscript ⁻¹, made once.
tr_inv_mark: int = 0;

tr_mark(): int {
    if (tr_inv_mark == 0) {
        line_clear();
        line_cp(8315);
        line_cp(185);
        tr_inv_mark = line_sym_now()
    }
    tr_inv_mark
}

// A name's color: by its place among the level's names.
tr_color(s: int): int {
    // (f, a map more than an element: its own purple, not a's blue (a
    // white f on a blue square is a well-known logo).)
    if (s == sym("f")) return train_colors[4];
    g0: int = pn_goal[root];
    for i in 0..gl_fixn[g0] {
        if (tm_name(goal_fix(g0, i)) == s) return train_colors[i % len(train_colors)]
    }
    train_colors[(s & 1023) % len(train_colors)]
}

train_colors: []int = [3824544, 13784378, 4160846, 14852923, 8343691];

// Tiles shown, eased (by key): where, how big, how much they show, and
// when last laid out; a tile gone pops away from where it was.
const TA: int = 128;

ta_key: []int = new int[TA](0);

ta_x: []f32 = new f32[TA](0.0);

ta_vx: []f32 = new f32[TA](0.0);

ta_y: []f32 = new f32[TA](0.0);

ta_vy: []f32 = new f32[TA](0.0);

ta_s: []f32 = new f32[TA](0.0);

ta_vs: []f32 = new f32[TA](0.0);

ta_w: []f32 = new f32[TA](0.0);

ta_kind: []int = new int[TA](0);

ta_sym: []int = new int[TA](0);

ta_seen: []int = new int[TA](0);

ta_gone: []f32 = new f32[TA](-1.0);

ta_used: []bool = new bool[TA](false);

tr_frame: int = 0;

// A tile that came only in a preview (what a thing held would make): faint,
// "would be" and not "is". Whether the train shows one now.
ta_prev: []bool = new bool[TA](false);

tr_previewing: bool = false;

// The tile shown for a key (made if new: it swells in where it goes).
ta_get(key: int, x: f32, y: f32): int {
    free: int = -1;
    for i in 0..TA {
        if (ta_used[i] && ta_key[i] == key && ta_gone[i] < 0.0) return i;
        if (!ta_used[i] && free < 0) free = i
    }
    if (free < 0) return -1;
    ta_used[free] = true;
    ta_key[free] = key;
    ta_x[free] = x;
    ta_y[free] = y;
    ta_vx[free] = 0.0;
    ta_vy[free] = 0.0;
    ta_s[free] = 0.0;
    ta_vs[free] = 0.0;
    ta_gone[free] = -1.0;
    ta_prev[free] = tr_previewing;
    if (an_jump) ta_s[free] = 1.0;
    free
}

// The goal the train was last drawn for, and the equation a closing goal
// became (its two sides the same, or a fact's).
tr_last: int = 0;

pic_close_eq: int = 0;

draw_train(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    g: int
) {
    // (What to draw: a goal closing, the goal now, or, finished, the last
    // goal closed.)
    ct: f32 = now_t - close_t;
    t: int = 0;
    closing: bool = false;
    if ((ct >= 0.0 || staging()) && ct < 1.2 && pic_close_eq != 0) {
        // (Staged: the sides the same, merging as the goal closes.)
        t = pic_close_eq;
        closing = true;
        ct = maxf(ct, 0.0)
    } else if (done_t >= 0.0) {
        t = pic_close_eq;
        closing = true;
        ct = 2.0
    } else t = lang_goal_term(gl_concl[g]);
    tr_previewing = !closing && t != gl_concl[g];
    c: int = rel_core(t);
    if (!is_binary(c, role_name[ROLE_EQ])) {
        p_str_mid(0, 14.0, x + w * 0.5, y + h * 0.5 + 5.0, "Show the two sides are the same.",
            C_MUTED, 1.0);
        return
    }
    l: int = spine_arg(c, 2, 0);
    r: int = spine_arg(c, 2, 1);
    same: bool = l == r;
    // (Laid out: each side's tiles and products.)
    trtk_n = 0;
    trtn_n = 0;
    tr_side = 0;
    tr_pending = -1;
    tr_walk(l, 0);
    tr_side = 1;
    tr_pending = -1;
    tr_walk(r, 0);
    th: f32 = clampf((h - 46.0) / 2.6, 24.0, 92.0);
    fs: f32 = th * 0.52;
    mark: int = tr_mark();
    rw: []f32 = tr_row_w;
    rw[0] = 0.0;
    rw[1] = 0.0;
    for i in 0..trtk_n {
        s: int = trtk_sym[i];
        tw: f32 = p_sym_w(1, fs, s);
        if (trtk_kind[i] == TK_INV || trtk_kind[i] == TK_CLOSE) tw = tw + p_sym_w(1,
            fs * 0.7, mark);
        bw: f32 = maxf(tw + th * 0.55, th * 0.86);
        if (trtk_kind[i] == TK_OPEN || trtk_kind[i] == TK_CLOSE) bw = tw + th * 0.3;
        trtk_w[i] = bw;
        gp: f32 = 0.0;
        if (rw[trtk_side[i]] > 0.0) {
            gp = th * 0.08;
            if (trtk_gap[i] >= 0) gp = maxf(th * 0.1, th * (0.42 - 0.12 * trtk_gap[i] as f32))
        }
        trtk_x[i] = rw[trtk_side[i]] + gp;
        rw[trtk_side[i]] = trtk_x[i] + bw
    }
    // (Too wide: closer and smaller.)
    sc: f32 = minf(1.0, (w - 40.0) / maxf(maxf(rw[0], rw[1]), 1.0));
    // (The rows: apart, or sliding together when the sides are the same.)
    m: f32 = 0.0;
    if (closing && same) {
        m = clampf(ct / 0.32, 0.0, 1.0);
        m = 1.0 - (1.0 - m) * (1.0 - m)
    }
    mid: f32 = y + h * 0.5 + 2.0;
    gapy: f32 = th * 0.62;
    row_y: []f32 = tr_row_y;
    row_y[0] = mid - gapy * 0.5 - th * 0.5;
    row_y[1] = mid + gapy * 0.5 + th * 0.5;
    row_y[0] = row_y[0] + (mid - row_y[0]) * m;
    row_y[1] = row_y[1] + (mid - row_y[1]) * m;
    // (The = between the rows, fading as they meet; a check when merged.)
    if (m < 1.0) p_str_mid(1, 20.0, x + w * 0.5, mid + 7.0, "=", C_FAINT, 1.0 - m);
    tr_frame = tr_frame + 1;
    if (t != tr_last && tr_last != 0 && !an_jump) tr_hold_t = now_t + TILE_GONE * 0.85;
    // (Each tile to its place.)
    for i in 0..trtk_n {
        sd: int = trtk_side[i];
        x0: f32 = x + w * 0.5 - rw[sd] * sc * 0.5;
        tx: f32 = x0 + trtk_x[i] * sc;
        ty: f32 = row_y[sd];
        // (Merging: the right side's tiles go where the left's are.)
        if (m > 0.0 && sd == 1) tx = tx + (x + w * 0.5 - rw[0] * sc * 0.5 + trtk_x[i] * sc - tx) * m;
        k: int = ta_get(trtk_key[i], tx, ty);
        // (Staggered as the writing is: what leaves pops first, then what
        // stays slides, and what is new swells in.)
        hold: bool = now_t < tr_hold_t && !an_jump;
        if (k >= 0 && !hold) {
            ta_x[k] = spring(ta_x[k], ta_vx[k], tx, 300.0, 20.0);
            ta_vx[k] = spring_v;
            ta_y[k] = spring(ta_y[k], ta_vy[k], ty, 300.0, 20.0);
            ta_vy[k] = spring_v
        }
        if (k >= 0 && !(hold && ta_s[k] < 0.05)) {
            ta_s[k] = spring(ta_s[k], ta_vs[k], 1.0, 260.0, 14.0);
            ta_vs[k] = spring_v
        }
        if (k >= 0) {
            if (an_jump) {
                ta_x[k] = tx;
                ta_y[k] = ty;
                ta_s[k] = 1.0
            }
            ta_w[k] = trtk_w[i] * sc;
            ta_kind[k] = trtk_kind[i];
            ta_sym[k] = trtk_sym[i];
            ta_seen[k] = tr_frame;
            if (!tr_previewing) ta_prev[k] = false
        }
    }
    // (Tiles no longer in the goal pop away.)
    for k in 0..TA {
        if (ta_used[k] && ta_seen[k] != tr_frame && ta_gone[k] < 0.0) {
            ta_gone[k] = now_t;
            if (an_jump) ta_used[k] = false else tr_hold_t = now_t + TILE_GONE * 0.85
        }
        if (ta_used[k] && ta_gone[k] >= 0.0 && now_t - ta_gone[k] > TILE_GONE) ta_used[k] = false
    }
    // (The products' pills, under the tiles: a pair to cancel a little
    // warmer.)
    for pass in 0..2 {
        for j in 0..trtn_n {
            f: int = trtn_first[j];
            la: int = trtn_last[j];
            if (trtn_pair[j] == (pass == 1) && (trtn_depth[j] > 0 || trtn_pair[j])) {
                kf: int = tr_find(trtk_key[f]);
                kl: int = tr_find(trtk_key[la]);
                if (kf >= 0 && kl >= 0) {
                    px0: f32 = ta_x[kf] - th * 0.12;
                    px1: f32 = ta_x[kl] + ta_w[kl] + th * 0.12;
                    py: f32 = ta_y[kf] - th * 0.5 - th * 0.12;
                    ph: f32 = th * 1.24;
                    if (trtn_pair[j]) p_box(px0, py, px1 - px0, ph, ph * 0.36, mix_rgb(C_SUNK,
                        C_PICK_SOFT, 0.6), 1.0) else p_box(px0, py, px1 - px0, ph,
                        ph * 0.36, C_SUNK, 0.55 + 0.1 * trtn_depth[j] as f32)
                }
            }
        }
    }
    // (The tiles.)
    for k in 0..TA {
        if (ta_used[k]) {
            s: f32 = ta_s[k];
            a: f32 = clampf(s * 1.4 - 0.2, 0.0, 1.0);
            if (ta_gone[k] >= 0.0) {
                // (Leaving: shrinks and fades where it was.)
                gt: f32 = clampf((now_t - ta_gone[k]) / TILE_GONE, 0.0, 1.0);
                s = 1.0 - 0.45 * gt;
                a = 1.0 - gt;
                busy = true
            }
            if (ta_prev[k] && ta_gone[k] < 0.0) a = a * 0.45;
            tr_draw_tile(k, th, fs, s, a, mark)
        }
    }
    tr_last = t
}

tr_row_w: []f32 = new f32[2](0.0);

// Until when the tiles that stay wait (those that left are going).
tr_hold_t: f32 = -10.0;

const TILE_GONE: f32 = 0.16;

tr_row_y: []f32 = new f32[2](0.0);

tr_find(key: int): int {
    for i in 0..TA {
        if (ta_used[i] && ta_key[i] == key && ta_gone[i] < 0.0) return i
    }
    -1
}

tr_draw_tile(
    k: int,
    th: f32,
    fs: f32,
    s: f32,
    a: f32,
    mark: int
) {
    if (a <= 0.0) return;
    w: f32 = ta_w[k] * s;
    h: f32 = th * s;
    cx: f32 = ta_x[k] + ta_w[k] * 0.5;
    x0: f32 = cx - w * 0.5;
    y0: f32 = ta_y[k] - h * 0.5;
    kind: int = ta_kind[k];
    sy: int = ta_sym[k];
    f: f32 = fs * s;
    if (kind == TK_OPEN || kind == TK_CLOSE) {
        tw: f32 = p_sym_w(1, f, sy);
        if (kind == TK_CLOSE) tw = tw + p_sym_w(1, f * 0.7, mark);
        tx: f32 = cx - tw * 0.5;
        p_sym(1, f * 1.2, tx, ta_y[k] + f * 0.42, sy, C_MUTED, a);
        if (kind == TK_CLOSE) p_sym(1, f * 0.7, tx + p_sym_w(1, f * 1.2, sy), ta_y[k] - f * 0.2,
            mark, C_MUTED, a);
        return
    }
    r: f32 = h * 0.3;
    if (kind == TK_E) {
        // (e: faint, it changes nothing.)
        p_box(x0, y0, w, h, r, C_SUNK, a);
        p_outline(x0, y0, w, h, r, 1.5, C_LINE, a);
        p_str_mid(1, f, cx, ta_y[k] + f * 0.36, "e", C_FAINT, a);
        return
    }
    col: int = tr_color(sy);
    p_shadow(x0, y0, w, h, r, 2.5 * s, 6.0, 0.16 * a);
    if (kind == TK_INV) {
        // (x⁻¹: x's color, hollow.)
        p_box(x0, y0, w, h, r, mix_rgb(col, C_WHITE, 0.82), a);
        p_outline(x0, y0, w, h, r, 2.5, col, a);
        tw: f32 = p_sym_w(1, f, sy) + p_sym_w(1, f * 0.7, mark);
        tx: f32 = cx - tw * 0.5;
        p_sym(1, f, tx, ta_y[k] + f * 0.36, sy, col, a);
        p_sym(1, f * 0.7, tx + p_sym_w(1, f, sy), ta_y[k] - f * 0.12, mark, col, a);
        return
    }
    p_box(x0, y0, w, h, r, col, a);
    p_box(x0 + 2.0, y0 + 2.0, w - 4.0, h * 0.4, r * 0.8, C_WHITE, 0.14 * a);
    tw: f32 = p_sym_w(1, f, sy);
    p_sym(1, f, cx - tw * 0.5, ta_y[k] + f * 0.36, sy, C_WHITE, a)
}

// ---- logic: the statements' letters as tiles ----
// (Logic has no example to draw.) Each letter of the level's theorem (P,
// Q, P(a): a name and what it is applied to) is a tile: lit when it is a
// fact you hold, soft when it is inside one, ringed when the goal wants
// it; all lit when the theorem is proved.
lt_atom: []int = new int[8](0);

lt_n: int = 0;

lt_level: int = -1;

lt_walk(t: int) {
    k: int = tm_kind(t);
    if (k == TM_ABS) {
        lt_walk(tm_body(t));
        return
    }
    h: int = spine_head(t);
    hk: int = tm_kind(h);
    if (hk == TM_FREE) {
        if (!tm_closed(t)) return;
        for i in 0..lt_n {
            if (lt_atom[i] == t) return
        }
        if (lt_n < len(lt_atom)) {
            lt_atom[lt_n] = t;
            lt_n = lt_n + 1
        }
        return
    }
    if (hk == TM_CONST) {
        n: int = spine_len(t);
        for i in 0..n lt_walk(spine_arg(t, n, i))
    }
}

// The tiles of the level played (found again when the level changes).
lt_find() {
    if (cur_level == lt_level) return;
    lt_level = cur_level;
    lt_n = 0;
    if (cur_level < 0 || pn_n == 0) return;
    g0: int = pn_goal[root];
    for i in 0..gl_hypn[g0] lt_walk(goal_hyp(g0, i));
    lt_walk(gl_concl[g0])
}

// How tall the tiles want to be.
const LT_TILE: f32 = 62.0;

// The logic card: the level's words, then its tiles, in (x, y, w, h).
draw_logic_pic(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    say: int
) {
    lt_find();
    p_shadow(x, y, w, h, 22.0, 3.0, 12.0, 0.1);
    p_box(x, y, w, h, 22.0, mix_rgb(C_GOLD_SOFT, C_CARD, 0.35), 1.0);
    sh: f32 = 0.0;
    if (say != 0) sh = draw_wrapped(0, 19.0, x + 24.0, y + 34.0, w - 48.0, say, mix_rgb(C_INK,
        C_MUTED, 0.25), 1.0) + 26.0;
    if (lt_n == 0 && h - sh >= 90.0) {
        relation_grid(x, y + sh, w, h - sh);
        return
    }
    if (h - sh >= 120.0 && folk_row(x, y + sh, w, h - sh)) return;
    if (lt_n == 0 || h - sh < LT_TILE + 24.0) return;
    n: int = play_node();
    if (n < 0) n = last_node;
    g: int = pn_goal[n];
    goal: int = rel_core(gl_concl[g]);
    done: bool = done_t >= 0.0 && now_t - done_t > 0.0;
    gap: f32 = 18.0;
    // (Tiles as big as the room allows; each as wide as its writing needs.)
    tt: f32 = clampf((h - sh) * 0.42, LT_TILE, 104.0);
    fs: f32 = tt * 0.4;
    an_live = false;
    tw: f32 = 0.0;
    for i in 0..lt_n {
        e: int = lay_term(lt_atom[i], fs, w * 0.4, 9400000 + i);
        lt_e[i] = e;
        lt_w[i] = maxf(tt, ex_w[e] + tt * 0.5);
        tw = tw + lt_w[i] + gap
    }
    tw = tw - gap;
    tx: f32 = x + w * 0.5 - tw * 0.5;
    cy: f32 = y + sh + (h - sh) * 0.5;
    for i in 0..lt_n {
        a: int = lt_atom[i];
        held: bool = false;
        inside: bool = false;
        for j in 0..gl_hypn[g] {
            f: int = rel_core(goal_hyp(g, j));
            if (f == a) held = true else if (occurs(a, f)) inside = true
        }
        wanted: bool = goal == a;
        tc: int = seq_colors[i % len(seq_colors)];
        bw: f32 = lt_w[i];
        bh: f32 = tt;
        bx: f32 = tx + lt_w[i] * 0.5 - bw * 0.5;
        by: f32 = cy - bh * 0.5;
        ink: int = C_INK;
        if (wanted && !done) {
            // (The goal wants it: a soft orange ring.)
            r: f32 = 5.0;
            p_outline(bx - r, by - r, bw + 2.0 * r, bh + 2.0 * r, tt * 0.28 + r, 2.0,
                C_PICK, 0.6)
        }
        if (held || done) {
            p_shadow(bx, by, bw, bh, tt * 0.28, 4.0, 10.0, 0.22);
            p_box(bx, by, bw, bh, tt * 0.28, tc, 1.0);
            // (Pudgy: a light top.)
            p_box(bx + 6.0, by + 5.0, bw - 12.0, bh * 0.3, tt * 0.16, C_WHITE, 0.18);
            ink = C_WHITE
        } else if (inside) {
            p_box(bx, by, bw, bh, tt * 0.28, mix_rgb(tc, C_CARD, 0.75), 1.0);
            p_outline(bx, by, bw, bh, tt * 0.28, 2.0, mix_rgb(tc, C_CARD, 0.4), 1.0)
        } else {
            p_box(bx, by, bw, bh, tt * 0.28, C_CARD, 1.0);
            p_outline(bx, by, bw, bh, tt * 0.28, 2.0, C_LINE, 1.0);
            ink = C_MUTED
        }
        e: int = lt_e[i];
        if (e >= 0) draw_expr(e, tx + lt_w[i] * 0.5 - ex_w[e] * 0.5, cy - ex_h[e] * 0.5,
            ink, 1.0, false);
        tx = tx + lt_w[i] + gap
    }
    an_live = true
}

// A level about a relation R x y (no letters to show): R as a grid, a
// row for each x and a column for each y, a dot where R holds. The fact
// one x related to every y is a full row; taking any y rings its column;
// the dot where they meet is the x for that y.
relation_grid(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    n: int = play_node();
    if (n < 0) n = last_node;
    if (n < 0) return;
    g0: int = pn_goal[root];
    rel: bool = false;
    for i in 0..gl_fixn[g0] {
        if (ty_kind(tm_type(goal_fix(g0, i))) == TY_FUN) rel = true
    }
    if (!rel) return;
    g: int = pn_goal[n];
    // (A y taken (any), an x got from the fact (some): the goal has more
    // names than at the start. Until x is got, the fact says only that
    // some row is full: its dots grey, no row lit.)
    took: bool = false;
    got: bool = false;
    some_x: int = 0;
    any_y: int = 0;
    for i in gl_fixn[g0]..gl_fixn[g] {
        v: int = goal_fix(g, i);
        if (token_kind(n, v) == 2) {
            got = true;
            some_x = v
        } else {
            took = true;
            any_y = v
        }
    }
    done: bool = done_t >= 0.0;
    if (done) got = true;
    // (Lit as it is got: the row pops.)
    if (got && !rg_got) rg_got_t = now_t;
    if (an_jump) rg_got_t = -10.0;
    rg_got = got;
    // (Square: the same people down the side (x) and along the top (y),
    // each with their own colour, and a faint diagonal where a person
    // meets themself. The example is chosen so no one is related to
    // themself except on the full row: y's own dot is empty, and what you
    // have gives the full row's dot in y's column, not that one.)
    rows: int = 5;
    cols: int = 5;
    cs: f32 = minf(minf((h - 50.0) / rows as f32, (w - 110.0) / cols as f32), 44.0);
    if (cs < 12.0) return;
    gx: f32 = x + w * 0.5 - cs * cols as f32 * 0.5 + 14.0;
    gy: f32 = y + (h - cs * rows as f32) * 0.5 + 12.0;
    lit_row: int = 1;
    col_y: int = 3;
    hx: f32 = gx - cs * 0.45;
    hy: f32 = gy - cs * 0.5;
    // (No letter over any one person: until a name is taken, only a faint
    // key in the corner, x down the side and y along the top. A taken y is
    // its orange ball over its own column, a got x its blue ball beside
    // its row.)
    if (!took && !done) {
        // ("y" and an arrow along the top row.)
        ax: f32 = hx - cs * 0.2;
        ay: f32 = hy - cs * 0.18;
        p_str_mid(1, 12.0, ax, ay + 4.0, "y", C_MUTED, 0.75);
        rg_arrow(ax + 7.0, ay, ax + 7.0 + cs * 0.32, ay)
    }
    if (!got && !done) {
        // ("x" and an arrow down the side.)
        ax: f32 = hx - cs * 0.5;
        ay: f32 = hy + cs * 0.05;
        p_str_mid(1, 12.0, ax, ay + 4.0, "x", C_MUTED, 0.75);
        rg_arrow(ax, ay + 8.0, ax, ay + 8.0 + cs * 0.32)
    }
    for i in 0..rows {
        rg_person(hx, gy + (i as f32 + 0.5) * cs, cs, rg_folk[i]);
        rg_person(gx + (i as f32 + 0.5) * cs, hy, cs, rg_folk[i])
    }
    // (Where each meets themself.)
    p_line(gx + cs * 0.2, gy + cs * 0.2, gx + cs * (cols as f32 - 0.2), gy + cs * (rows as f32 - 0.2),
        1.5, mix_rgb(C_LINE, C_MUTED, 0.25), 0.8);
    // (The row the fact gives, under its dots, once x is got.)
    rc: int = seq_colors[0];
    if (got) {
        pt: f32 = now_t - rg_got_t;
        s: f32 = 1.0;
        if (pt >= 0.0 && pt < 0.3) {
            q: f32 = pt / 0.3;
            s = 0.6 + 0.4 * (1.0 - (1.0 - q) * (1.0 - q));
            busy = true
        }
        rw: f32 = (cs * cols as f32 - 4.0) * s;
        rh: f32 = (cs - 4.0) * s;
        rx: f32 = gx + cs * cols as f32 * 0.5 - rw * 0.5;
        ry: f32 = gy + (lit_row as f32 + 0.5) * cs - rh * 0.5;
        p_box(rx, ry, rw, rh, rh * 0.5, mix_rgb(rc, C_CARD, 0.7), 1.0);
        // (Its name, the blue x, at its left.)
        if (!done) draw_token(some_x, 2, hx - cs * 0.3 - 18.0, gy + (lit_row as f32 + 0.5) * cs,
            minf(cs / 46.0, 0.6), 1.0)
    }
    if (took && !done) {
        // (Its name, the orange y, over its column.)
        tr: f32 = minf(cs / 46.0, 0.8);
        draw_token(any_y, 1, gx + (col_y as f32 + 0.5) * cs, maxf(hy - cs * 0.3 - 18.0,
            y + TOK_R * tr + 4.0), tr, 1.0);
        r: f32 = 3.0;
        p_outline(gx + col_y as f32 * cs + 2.0 - r, gy + 2.0 - r, cs - 4.0 + 2.0 * r,
            cs * rows as f32 - 4.0 + 2.0 * r, (cs - 4.0) * 0.5 + r, 2.0, C_PICK, 0.6)
    }
    // (The goal R(x, y) on the grid, or the one a thing held would make: its
    // cell ringed. R(y, y), y's own dot on the diagonal, ringed soft red,
    // held over or stuck on; stuck, the dot what you have gives in y's
    // column is shown beside it.)
    shown: int = rel_core(lang_goal_term(gl_concl[g]));
    gq: int = rel_core(gl_concl[g]);
    dead: bool = !done && lang_on() && lang_dead() && spine_len(gq) == 2 && spine_arg(gq,
        2, 0) == spine_arg(gq, 2, 1);
    beside: bool = false;
    if (!done && spine_len(shown) == 2) {
        a0: int = spine_arg(shown, 2, 0);
        a1: int = spine_arg(shown, 2, 1);
        if (a0 != a1 && a0 == some_x && a1 == any_y && some_x != 0) p_ring(gx + (col_y as f32 + 0.5) * cs,
            gy + (lit_row as f32 + 0.5) * cs, cs * 0.42 + 3.0, 2.5, C_PICK, 0.8);
        if (a0 == a1 && a0 == any_y && !dead) p_ring(gx + (col_y as f32 + 0.5) * cs,
            gy + (col_y as f32 + 0.5) * cs, cs * 0.42 + 3.0, 2.5, soft_red(), 0.7)
    }
    if (dead) {
        p_ring(gx + (col_y as f32 + 0.5) * cs, gy + (col_y as f32 + 0.5) * cs, cs * 0.42 + 3.0,
            2.5, soft_red(), 0.8);
        // (Beside it, the one you can get: the full row's dot.)
        beside = true
    }
    for i in 0..rows {
        for j in 0..cols {
            cx: f32 = gx + (j as f32 + 0.5) * cs;
            cy: f32 = gy + (i as f32 + 0.5) * cs;
            if (i == lit_row && (got || beside && j == col_y)) {
                s: f32 = cs * 0.26;
                if (took && j == col_y) s = cs * 0.3;
                p_disc(cx, cy, s, rc, 1.0)
            } else if (i == lit_row) p_disc(cx, cy, cs * 0.2, mix_rgb(C_LINE, C_MUTED,
                0.3), 1.0) else if (rg_dot(i, j)) p_disc(cx, cy, cs * 0.16, C_LINE,
                1.0) else p_ring(cx, cy, cs * 0.12, 1.5, C_LINE, 1.0)
        }
    }
}

// A level about one kind of thing and properties of it (P x, Q x): five
// little people in a row (the same as Someone for everyone's), each with
// a chip for each property under them. A name in scope stands over a
// person (its ball: orange any, blue some, cream the level's own); a
// property a fact gives that person is lit, one inside a fact half lit,
// one the goal wants ringed orange. Proved for any y, every one is lit;
// for some one, theirs is.
folk_pred: []int = new int[3](0);

folk_np: int = 0;

const FOLK_N: int = 5;

folk_order: []int = [2, 1, 3, 0, 4];

folk_row(
    x: f32,
    y: f32,
    w: f32,
    h: f32
): bool {
    n: int = play_node();
    if (n < 0) n = last_node;
    if (n < 0 || pn_n == 0) return false;
    g0: int = pn_goal[root];
    folk_np = 0;
    for i in 0..gl_fixn[g0] {
        ty: int = tm_type(goal_fix(g0, i));
        if (ty == bool_t) return false;
        if (ty_kind(ty) == TY_FUN) {
            if (ty_cod(ty) != bool_t || ty_kind(ty_dom(ty)) == TY_FUN) return false;
            if (folk_np < len(folk_pred)) {
                folk_pred[folk_np] = goal_fix(g0, i);
                folk_np = folk_np + 1
            }
        }
    }
    if (folk_np == 0) return false;
    g: int = pn_goal[n];
    done: bool = done_t >= 0.0;
    all_goal: bool = shape_of(rel_core(gl_concl[g0])) == SH_ALL;
    goal: int = rel_core(lang_goal_term(gl_concl[g]));
    // (A name held over a fact's notch: the fact it would give, faint.)
    extra: int = 0;
    if (dg_on && hv_fit && hv_kind == T_FACT && hv_fact != 0) extra = rel_core(hv_fact);
    cs: f32 = minf(minf(w / 6.4, (h - 40.0) / (2.2 + folk_np as f32 * 0.75)), 64.0);
    if (cs < 24.0) return false;
    x0: f32 = x + w * 0.5 - cs * FOLK_N as f32 * 0.5;
    ch: f32 = cs * 0.56;
    tot: f32 = cs * 1.2 + folk_np as f32 * (ch + 8.0);
    py: f32 = y + h * 0.5 - tot * 0.5 + cs * 0.45;
    // (Who stands for which name: in the order the names came.)
    who: []int = folk_who;
    for i in 0..FOLK_N who[i] = 0;
    k: int = 0;
    for i in 0..gl_fixn[g] {
        v: int = goal_fix(g, i);
        ty: int = tm_type(v);
        if (ty_kind(ty) != TY_FUN && ty != bool_t && k < FOLK_N) {
            who[folk_order[k]] = v;
            k = k + 1
        }
    }
    for p in 0..FOLK_N {
        cx: f32 = x0 + (p as f32 + 0.5) * cs;
        v: int = who[p];
        kd: int = 0;
        if (v != 0) kd = token_kind(n, v);
        // (An any one: ringed soft orange, from its ball to its chips.)
        if (v != 0 && kd == 1 && !done) {
            r: f32 = 3.0;
            p_outline(cx - cs * 0.42 - r, py - cs * 0.62 - r, cs * 0.84 + 2.0 * r,
                tot - cs * 0.1 + 2.0 * r, cs * 0.42 + r, 2.0, C_PICK, 0.55)
        }
        rg_person(cx, py, cs * 1.7, rg_folk[p]);
        if (v != 0 && !(done && kd == 1)) draw_token(v, kd, cx, py - cs * 0.95, minf(cs / 50.0,
            0.8), 1.0);
        for q in 0..folk_np {
            cy: f32 = py + cs * 0.55 + q as f32 * (ch + 8.0);
            held: bool = false;
            inside: bool = false;
            would: bool = false;
            wanted: bool = false;
            if (v != 0) {
                at: int = 0;
                try {
                    at = rel_core(mk_app(folk_pred[q], v))
                } with KernelError -> {
                    at = 0
                }
                if (at != 0) {
                    for j in 0..gl_hypn[g] {
                        f: int = rel_core(goal_hyp(g, j));
                        if (f == at) held = true else if (occurs(at, f)) inside = true
                    }
                    if (extra != 0 && !held && !inside && occurs(at, extra)) would = true;
                    wanted = goal == at
                }
            }
            // (Proved: the properties it says are lit, for every one or for
            // theirs.)
            if (done && occurs(folk_pred[q], gl_concl[g0]) && (all_goal || inside)) held = true;
            tc: int = seq_colors[q % len(seq_colors)];
            bw: f32 = ch;
            bx: f32 = cx - bw * 0.5;
            by: f32 = cy - bw * 0.5 + ch * 0.5;
            rr: f32 = bw * 0.3;
            ink: int = C_FAINT;
            if (wanted && !done) {
                r: f32 = 3.0;
                p_outline(bx - r, by - r, bw + 2.0 * r, bw + 2.0 * r, rr + r, 2.0,
                    C_PICK, 0.6)
            }
            if (held) {
                p_shadow(bx, by, bw, bw, rr, 2.0, 5.0, 0.2);
                p_box(bx, by, bw, bw, rr, tc, 1.0);
                p_box(bx + 3.0, by + 2.5, bw - 6.0, bw * 0.3, rr * 0.6, C_WHITE, 0.18);
                ink = C_WHITE
            } else if (inside || would) {
                al: f32 = 1.0;
                if (would) al = 0.6;
                p_box(bx, by, bw, bw, rr, mix_rgb(tc, C_CARD, 0.72), al);
                p_outline(bx, by, bw, bw, rr, 2.0, mix_rgb(tc, C_CARD, 0.35), al);
                ink = mix_rgb(tc, C_INK, 0.3)
            } else p_outline(bx, by, bw, bw, rr, 1.5, C_LINE, 1.0);
            show_line(folk_pred[q]);
            nm: int = line_sym_now();
            fs: f32 = bw * 0.5;
            p_sym(1, fs, cx - p_sym_w(1, fs, nm) * 0.5, by + bw * 0.5 + fs * 0.36,
                nm, ink, 1.0)
        }
    }
    true
}

folk_who: []int = new int[5](0);

// (The example's other dots: a few, none on the diagonal.)
rg_dot(i: int, j: int): bool {
    if (i == j) return false;
    i == 0 && j == 3 || i == 2 && j == 0 || i == 2 && j == 4 || i == 3 && j == 1 || i == 4 && j == 2
}

rg_folk: []int = [13208427, 8364922, 10127042, 13742170, 7316400];

// A little person: a head on shoulders, in their colour.
rg_person(
    cx: f32,
    cy: f32,
    cs: f32,
    col: int
) {
    r: f32 = cs * 0.13;
    p_box(cx - r * 1.5, cy + cs * 0.02, r * 3.0, r * 1.5, r * 0.75, mix_rgb(col, C_CARD,
        0.2), 1.0);
    p_disc(cx, cy - cs * 0.1, r, col, 1.0)
}

// A little faint arrow from (x0, y0) to (x1, y1), across or down.
rg_arrow(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    c: int = C_MUTED;
    p_line(x0, y0, x1, y1, 1.5, c, 0.7);
    dx: f32 = 1.0;
    dy: f32 = 0.0;
    if (x1 == x0) {
        dx = 0.0;
        dy = 1.0
    }
    // (The head: two short strokes back from the tip.)
    p_line(x1, y1, x1 - 4.0 * dx - 3.5 * dy, y1 - 4.0 * dy - 3.5 * dx, 1.5, c, 0.7);
    p_line(x1, y1, x1 - 4.0 * dx + 3.5 * dy, y1 - 4.0 * dy + 3.5 * dx, 1.5, c, 0.7)
}

rg_got: bool = false;

rg_got_t: f32 = -10.0;

lt_e: []int = new int[8](0);

lt_w: []f32 = new f32[8](0.0)
