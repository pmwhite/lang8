tag lemma_tests;

use_tag std, lemma;

// Every level of every region, played by the proof written with it: each
// must be proved, by a theorem that is its statement, from nothing but the
// region's rulebook, in no more moves than its par.
import "../../stdlib/print.l8";

import "lemma.l8";

load_file(path: str) noregion raises IoError {
    t: []i8 = read_whole(path);
    try {
        load_theory(t, whole_n)
    } with TheoryError -> {
        line_clear();
        line_add(path);
        line_add(" line ");
        line_int(theory_line);
        line_add(": ");
        line_add(theory_why);
        line_print()
    }
}

open_region(path: str) noregion raises IoError, KernelError {
    if (lm_n == 0) {
        load_file("programs/lemma/hol.txt");
        close_axioms();
        if (!prove_given()) report("hol.txt");
        mark_logic()
    }
    reset_to_logic();
    load_file(path);
    if (!prove_given()) report(path)
}

report(where: str) raises IoError {
    line_clear();
    line_add(where);
    line_add(": the proof of ");
    line_sym(lv_name[proof_level]);
    line_add(" fails at move ");
    line_int(proof_step);
    line_add(": ");
    line_add(proof_why);
    line_print()
}

// Each level in order, as a player would meet them (each solved one a tool
// for the next): one line for each.
play_region(path: str) noregion raises IoError, KernelError {
    open_region(path);
    for l in 0..lv_n {
        if (!lv_given[l]) {
            solved: bool = false;
            try {
                solved = run_proof(l)
            } with KernelError -> {
                proof_why = kernel_why
            }
            line_clear();
            line_sym(lv_name[l]);
            line_add(": ");
            if (!solved) {
                line_add("fails at move ");
                line_int(proof_step);
                line_add(" (");
                line_add(proof_why);
                line_add(")");
                line_print();
                print_focus();
                print_cands()
            } else {
                moves: int = player_moves();
                th: int = level_theorem();
                line_int(moves);
                line_add(" moves, par ");
                line_int(lv_par[l]);
                if (moves > lv_par[l]) line_add(" (OVER PAR)");
                if (thm_prop(th) != lv_goal[l]) line_add(", NOT ITS STATEMENT");
                if (!hyps_in_context(th)) line_add(", MORE THAN THE RULEBOOK");
                if (thm_trusts_oracle(th)) line_add(", trusts Calculate");
                line_print();
                level_solved(l)
            }
        }
    }
}

// Moves the player made (not the game's own).
player_moves(): int {
    k: int = 0;
    for m in 0..mv_n {
        if (!mv_auto[m]) k = k + 1
    }
    k
}

hyps_in_context(th: int): bool {
    for i in 0..thm_hyp_count(th) {
        h: int = thm_hyp(th, i);
        found: bool = false;
        for j in 0..ctx_n {
            if (ctx_hyp[j] == h) found = true
        }
        if (!found) return false
    }
    true
}

test "logic" {
    play_region("programs/lemma/regions/logic.txt");
    expect {|
        and_swap: 3 moves, par 3
        chain: 3 moves, par 3
        swap_quantifiers: 4 moves, par 4
    |}
}

test "groups" {
    play_region("programs/lemma/regions/groups.txt");
    expect {|
        cancel: 7 moves, par 7
        id_unique: 2 moves, par 2
        inv_unique: 5 moves, par 5
        inv_mul: 7 moves, par 7
        inv_inv: 3 moves, par 3
    |}
}

test "analysis" {
    play_region("programs/lemma/regions/analysis.txt");
    expect {|
        const_limit: 4 moves, par 4, trusts Calculate
        sum_limit: 12 moves, par 12, trusts Calculate
        limit_unique: 9 moves, par 9, trusts Calculate
    |}
}

// A level played, then its proof written out.
written(path: str, name: str) noregion raises IoError, KernelError {
    open_region(path);
    for l in 0..lv_n {
        if (lv_name[l] == sym(name)) {
            if (run_proof(l)) print_proof() else print("(the proof fails)")
        } else if (!lv_given[l] && run_proof(l)) level_solved(l)
    }
}

test "a proof in groups, written out" {
    written("programs/lemma/regions/groups.txt", "inv_mul");
    expect {|
        Equivalently, b⁻¹ · a⁻¹ = (a · b)⁻¹.
        By only one inverse, it is enough to show (a · b) · (b⁻¹ · a⁻¹) = e.
        (a · b) · (b⁻¹ · a⁻¹)
        = a · (b · (b⁻¹ · a⁻¹))   (regroup)
        = a · ((b · b⁻¹) · a⁻¹)   (regroup)
        = a · (e · a⁻¹)   (inverse on the right)
        = a · a⁻¹   (e on the left)
        = e   (inverse on the right)
        ∎
    |}
}

test "a proof in analysis, written out" {
    written("programs/lemma/regions/analysis.txt", "sum_limit");
    expect {|
        By definition, we must show ∀ε>0. ∃N. ∀n≥N. |a_n + b_n − (A + B)| < ε.
        Let ε > 0.
        By definition, ∀ε>0. ∃N. ∀n≥N. |a_n − A| < ε.
        Since 0 < ε / 2, by ∀ε>0. ∃N. ∀n≥N. |a_n − A| < ε, with ε / 2, ∃N. ∀n≥N. |a_n − A| < ε / 2.
        By ∃N. ∀n≥N. |a_n − A| < ε / 2, there is N with ∀n≥N. |a_n − A| < ε / 2.
        By definition, ∀ε>0. ∃N. ∀n≥N. |b_n − B| < ε.
        Since 0 < ε / 2, by ∀ε>0. ∃N. ∀n≥N. |b_n − B| < ε, with ε / 2, ∃N. ∀n≥N. |b_n − B| < ε / 2.
        By ∃N. ∀n≥N. |b_n − B| < ε / 2, there is N₁ with ∀n≥N₁. |b_n − B| < ε / 2.
        We choose max(N, N₁): we must show ∀n≥max(N, N₁). |a_n + b_n − (A + B)| < ε.
        Let n ≥ max(N, N₁).
        Since N ≤ n, by ∀n≥N. |a_n − A| < ε / 2, with n, |a_n − A| < ε / 2.
        Since N₁ ≤ n, by ∀n≥N₁. |b_n − B| < ε / 2, with n, |b_n − B| < ε / 2.
        So |a_n + b_n − (A + B)| < ε, by calculation.
        ∎
    |}
}

test "a group theorem, exported: for any structure that obeys the rulebook" {
    open_region("programs/lemma/regions/groups.txt");
    for l in 0..lv_n {
        if (!lv_given[l] && run_proof(l)) level_solved(l)
    }
    th: int = export_theorem(lm_thm[find_lemma(sym("inv_mul"))]);
    print_int(thm_hyp_count(th));
    show_line(thm_prop(th));
    line_print();
    expect {|
        0
        ⋀mul. ⋀e. ⋀inv. (⋀a. ⋀b. ⋀c. mul(mul(a, b), c) = mul(a, mul(b, c))) ⟹ (⋀a. mul(e, a) = a) ⟹ (⋀a. mul(a, e) = a) ⟹ (⋀a. mul(inv(a), a) = e) ⟹ (⋀a. mul(a, inv(a)) = e) ⟹ (⋀a. ⋀b. inv(mul(a, b)) = mul(inv(b), inv(a)))
    |}
}
