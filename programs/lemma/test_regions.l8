tag lemma_tests;

use_tag std, lemma;

// Every level of every region, played by the proof written with it: each
// must be proved, by a theorem that is its statement, from nothing but the
// region's rulebook, in no more moves than its par.
import "../../stdlib/print.l8";

import "lemma.l8";

load_file(path: str) noregion raises IoError {
    t: []i8 = read_whole(path);
    try {
        load_theory(t, whole_n)
    } with TheoryError -> {
        line_clear();
        line_add(path);
        line_add(" line ");
        line_int(theory_line);
        line_add(": ");
        line_add(theory_why);
        line_print()
    }
}

open_region(path: str) noregion raises IoError, KernelError {
    if (lm_n == 0) {
        load_file("programs/lemma/hol.txt");
        close_axioms();
        if (!prove_given()) report("hol.txt");
        mark_logic()
    }
    reset_to_logic();
    load_file(path);
    if (!prove_given()) report(path)
}

report(where: str) raises IoError {
    line_clear();
    line_add(where);
    line_add(": the proof of ");
    line_sym(lv_name[proof_level]);
    line_add(" fails at move ");
    line_int(proof_step);
    line_add(": ");
    line_add(proof_why);
    line_print()
}

// Each level in order, as a player would meet them (each solved one a tool
// for the next): one line for each.
play_region(path: str) noregion raises IoError, KernelError {
    open_region(path);
    for l in 0..lv_n {
        if (!lv_given[l]) {
            solved: bool = false;
            try {
                solved = run_proof(l)
            } with KernelError -> {
                proof_why = kernel_why
            }
            line_clear();
            line_sym(lv_name[l]);
            line_add(": ");
            if (!solved) {
                line_add("fails at move ");
                line_int(proof_step);
                line_add(" (");
                line_add(proof_why);
                line_add(")");
                line_print();
                print_focus();
                print_cands()
            } else {
                moves: int = player_moves();
                th: int = level_theorem();
                line_int(moves);
                line_add(" moves, par ");
                line_int(lv_par[l]);
                if (moves > lv_par[l]) line_add(" (OVER PAR)");
                if (thm_prop(th) != lv_goal[l]) line_add(", NOT ITS STATEMENT");
                if (!hyps_in_context(th)) line_add(", MORE THAN THE RULEBOOK");
                if (thm_trusts_oracle(th)) line_add(", trusts Calculate");
                line_print();
                level_solved(l)
            }
        }
    }
}

// Moves the player made (not the game's own).
player_moves(): int {
    k: int = 0;
    for m in 0..mv_n {
        if (!mv_auto[m]) k = k + 1
    }
    k
}

hyps_in_context(th: int): bool {
    for i in 0..thm_hyp_count(th) {
        h: int = thm_hyp(th, i);
        found: bool = false;
        for j in 0..ctx_n {
            if (ctx_hyp[j] == h) found = true
        }
        if (!found) return false
    }
    true
}

test "logic" {
    play_region("programs/lemma/regions/logic.txt");
    expect {|
        take_left: 1 moves, par 1
        both: 1 moves, par 1
        and_swap: 2 moves, par 2
        suppose: 1 moves, par 1
        modus_ponens: 1 moves, par 1
        chain: 3 moves, par 3
        any_one: 3 moves, par 3
        for_every: 2 moves, par 2
        show_one: 1 moves, par 1
        one_of_them: 3 moves, par 3
        swap_quantifiers: 4 moves, par 4
    |}
}

test "groups" {
    play_region("programs/lemma/regions/groups.txt");
    expect {|
        nothing: 2 moves, par 2
        undo: 3 moves, par 3
        id_unique: 2 moves, par 2
        cancel: 7 moves, par 7
        inv_unique: 5 moves, par 5
        inv_inv: 3 moves, par 3
        inv_mul: 7 moves, par 7
        cancel_right: 7 moves, par 7
    |}
}

test "analysis" {
    play_region("programs/lemma/regions/analysis.txt");
    expect {|
        const_limit: 4 moves, par 4, trusts Calculate
        shifted: 8 moves, par 8, trusts Calculate
        doubled: 8 moves, par 8, trusts Calculate
        sum_limit: 12 moves, par 12, trusts Calculate
        limit_unique: 9 moves, par 9, trusts Calculate
    |}
}

// A level played, then its proof written out.
written(path: str, name: str) noregion raises IoError, KernelError {
    open_region(path);
    for l in 0..lv_n {
        if (lv_name[l] == sym(name)) {
            if (run_proof(l)) print_proof() else print("(the proof fails)")
        } else if (!lv_given[l] && run_proof(l)) level_solved(l)
    }
}

test "a proof in groups, written out" {
    written("programs/lemma/regions/groups.txt", "inv_mul");
    expect {|
        Equivalently, b⁻¹ · a⁻¹ = (a · b)⁻¹.
        By only one inverse, it is enough to show (a · b) · (b⁻¹ · a⁻¹) = e.
        (a · b) · (b⁻¹ · a⁻¹)
        = a · (b · (b⁻¹ · a⁻¹))   (regroup)
        = a · ((b · b⁻¹) · a⁻¹)   (regroup)
        = a · (e · a⁻¹)   (inverse on the right)
        = a · a⁻¹   (e on the left)
        = e   (inverse on the right)
        ∎
    |}
}

test "a proof in analysis, written out" {
    written("programs/lemma/regions/analysis.txt", "sum_limit");
    expect {|
        By definition, we must show ∀ε>0. ∃N. ∀n≥N. |a_n + b_n − (A + B)| < ε.
        Let ε > 0.
        By definition, ∀ε>0. ∃N. ∀n≥N. |a_n − A| < ε.
        Since 0 < ε / 2, by ∀ε>0. ∃N. ∀n≥N. |a_n − A| < ε, with ε / 2, ∃N. ∀n≥N. |a_n − A| < ε / 2.
        By ∃N. ∀n≥N. |a_n − A| < ε / 2, there is N with ∀n≥N. |a_n − A| < ε / 2.
        By definition, ∀ε>0. ∃N. ∀n≥N. |b_n − B| < ε.
        Since 0 < ε / 2, by ∀ε>0. ∃N. ∀n≥N. |b_n − B| < ε, with ε / 2, ∃N. ∀n≥N. |b_n − B| < ε / 2.
        By ∃N. ∀n≥N. |b_n − B| < ε / 2, there is N₁ with ∀n≥N₁. |b_n − B| < ε / 2.
        We choose max(N, N₁): we must show ∀n≥max(N, N₁). |a_n + b_n − (A + B)| < ε.
        Let n ≥ max(N, N₁).
        Since N ≤ n, by ∀n≥N. |a_n − A| < ε / 2, with n, |a_n − A| < ε / 2.
        Since N₁ ≤ n, by ∀n≥N₁. |b_n − B| < ε / 2, with n, |b_n − B| < ε / 2.
        So |a_n + b_n − (A + B)| < ε, by calculation.
        ∎
    |}
}

test "a group theorem, exported: for any structure that obeys the rulebook" {
    open_region("programs/lemma/regions/groups.txt");
    for l in 0..lv_n {
        if (!lv_given[l] && run_proof(l)) level_solved(l)
    }
    th: int = export_theorem(lm_thm[find_lemma(sym("inv_mul"))]);
    print_int(thm_hyp_count(th));
    show_line(thm_prop(th));
    line_print();
    expect {|
        0
        ⋀mul. ⋀e. ⋀inv. (⋀a. ⋀b. ⋀c. mul(mul(a, b), c) = mul(a, mul(b, c))) ⟹ (⋀a. mul(e, a) = a) ⟹ (⋀a. mul(a, e) = a) ⟹ (⋀a. mul(inv(a), a) = e) ⟹ (⋀a. mul(a, inv(a)) = e) ⟹ (⋀a. ⋀b. inv(mul(a, b)) = mul(inv(b), inv(a)))
    |}
}

// Each level played by the gestures a player makes (keys, names into
// notches, facts onto the goal, faces onto parts, the goal flipped or put
// into the facts): the book's steps read as gestures, one gesture each.
gesture_region(path: str) noregion raises IoError, KernelError {
    open_region(path);
    for l in 0..lv_n {
        if (!lv_given[l]) {
            level_start(l);
            parse_proof(l);
            k: int = 0;
            ok: bool = true;
            while (ok && k < st_n && !level_done()) {
                n: int = focus();
                ok = n >= 0 && book_gesture(k, n);
                if (ok) {
                    try {
                        ok = gs_do(n, bg_kind, bg_j, bg_t)
                    } with KernelError -> {
                        ok = false
                    }
                }
                k = k + 1
            }
            line_clear();
            line_sym(lv_name[l]);
            line_add(": ");
            line_int(k);
            line_add(" gestures, ");
            if (level_done()) line_add("proved") else line_add("NOT PROVED");
            if (level_done() && player_moves() != k) {
                line_add(", ");
                line_int(player_moves());
                line_add(" moves")
            }
            line_print();
            if (level_done()) level_solved(l)
        }
    }
}

test "every level by gestures" {
    gesture_region("programs/lemma/regions/logic.txt");
    gesture_region("programs/lemma/regions/groups.txt");
    gesture_region("programs/lemma/regions/analysis.txt");
    expect {|
        take_left: 1 gestures, proved
        both: 1 gestures, proved
        and_swap: 2 gestures, proved
        suppose: 1 gestures, proved
        modus_ponens: 1 gestures, proved
        chain: 3 gestures, proved
        any_one: 3 gestures, proved
        for_every: 2 gestures, proved
        show_one: 1 gestures, proved
        one_of_them: 3 gestures, proved
        swap_quantifiers: 4 gestures, proved
        nothing: 2 gestures, proved
        undo: 3 gestures, proved
        id_unique: 2 gestures, proved
        cancel: 7 gestures, proved
        inv_unique: 5 gestures, proved
        inv_inv: 3 gestures, proved
        inv_mul: 7 gestures, proved
        cancel_right: 7 gestures, proved
        const_limit: 4 gestures, proved
        shifted: 8 gestures, proved
        doubled: 8 gestures, proved
        sum_limit: 12 gestures, proved
        limit_unique: 9 gestures, proved
    |}
}

level_called(name: str): int {
    for l in 0..lv_n {
        if (lv_name[l] == sym(name)) return l
    }
    -1
}

// Text written in ASCII as the screen writes it: * is the dot of a product.
dots(s: str): int {
    line_clear();
    for c in s {
        if (c == '*') line_cp(183) else line_byte(c as int)
    }
    line_sym_now()
}

// The path to the first place of the goal shown as s, into gf_steps.
face_at(n: int, s: str): bool {
    if (!find_part_text(gl_concl[pn_goal[n]], dots(s))) return false;
    gf_n = fp_n;
    for i in 0..fp_n gf_steps[i] = fp_steps[i];
    true
}

face_try(
    s: str,
    l: str,
    back: bool,
    t: str
) raises IoError, KernelError {
    n: int = focus();
    gf_l = find_lemma(sym(l));
    gf_j = -1;
    gf_back = back;
    if (!face_at(n, s)) print("no such part") else {
        w: int = gs_face_wn(n);
        made: bool = false;
        if (w >= 0) {
            x: int = 0;
            if (t != "") x = witness_term(n, t);
            made = gs_face(n, x)
        }
        line_clear();
        line_add("wants ");
        line_int(w);
        if (made) line_add(", made");
        line_print()
    }
    print_focus()
}

test "faces: like on like" {
    open_region("programs/lemma/regions/groups.txt");
    // (Cancel on the left: x of e * x = x onto b; e onto e; a face that
    // does not fit.)
    level_start(level_called("cancel"));
    face_try("b", "id_left", true, "");
    face_try("e * b", "inv_left", false, "");
    face_try("e", "inv_left", true, "a");
    // (Only one e: x of x * e = x onto f, then the fact's f * x face onto
    // f * e: it is used with e, and the goal closes.)
    level_start(level_called("id_unique"));
    face_try("f", "id_right", true, "");
    n: int = focus();
    gf_l = -1;
    gf_j = 0;
    gf_back = false;
    if (!face_at(n, "f * e")) print("no such part");
    print_int(gs_face_wn(n));
    print_bool(gs_face(n, 0));
    print_bool(level_done());
    expect {|
        wants 0, made
        a · b = a · c
        ⊢ e · b = c
        wants -1
        a · b = a · c
        ⊢ e · b = c
        wants 1, made
        a · b = a · c
        ⊢ (a⁻¹ · a) · b = c
        wants 0, made
        ∀x. f · x = x
        ⊢ f · e = e
        0
        true
        true
    |}
}
