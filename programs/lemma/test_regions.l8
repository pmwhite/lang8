}

level_called(name: str): int {
    for l in 0..lv_n {
        if (lv_name[l] == sym(name)) return l
    }
    -1
}

// Text written in ASCII as the screen writes it: * is the dot of a product.
dots(s: str): int {
    line_clear();
    for c in s {
        if (c == '*') line_cp(183) else line_byte(c as int)
    }
    line_sym_now()
}

// The path to the first place of the goal shown as s, into gf_steps.
face_at(n: int, s: str): bool {
    if (!find_part_text(gl_concl[pn_goal[n]], dots(s))) return false;
    gf_n = fp_n;
    for i in 0..fp_n gf_steps[i] = fp_steps[i];
    true
}

face_try(
    s: str,
    l: str,
    back: bool,
    t: str
) raises IoError, KernelError {
    n: int = focus();
    gf_l = find_lemma(sym(l));
    gf_j = -1;
    gf_back = back;
    if (!face_at(n, s)) print("no such part") else {
        w: int = gs_face_wn(n);
        made: bool = false;
        if (w >= 0) {
            x: int = 0;
            if (t != "") x = witness_term(n, t);
            made = gs_face(n, x)
        }
        line_clear();
        line_add("wants ");
        line_int(w);
        if (made) line_add(", made");
        line_print()
    }
    print_focus()
}

test "faces: like on like" {
    open_region("programs/lemma/regions/groups.txt");
    // (Cancel on the left: x of e * x = x onto b; e onto e; a face that
    // does not fit.)
    level_start(level_called("out_of_nothing"));
    face_try("b", "id_left", true, "");
    face_try("e * b", "inv_left", false, "");
    face_try("e", "inv_left", true, "a");
    // (Only one e: x of x * e = x onto f, then the fact's f * x face onto
    // f * e: it is used with e, and the goal closes.)
    level_start(level_called("does_nothing"));
    face_try("f", "id_right", true, "");
    n: int = focus();
    gf_l = -1;
    gf_j = 0;
    gf_back = false;
    if (!face_at(n, "f * e")) print("no such part");
    print_int(gs_face_wn(n));
    print_bool(gs_face(n, 0));
    print_bool(level_done());
    expect {|
        wants 0, made
        a · b = a · c
        ⊢ e · b = c
        wants -1
        a · b = a · c
        ⊢ e · b = c
        wants 1, made
        a · b = a · c
        ⊢ (a⁻¹ · a) · b = c
        wants 0, made
        ∀x. f · x = x
        ⊢ f · e = e
        0
        true
        true
    |}
}

// The goal's two strings of beads, a line: each bead its name, ' if it is
// turned over; | between the strings; done when proved.
print_beads() raises IoError {
    n: int = focus();
    if (n < 0) {
        print("done");
        return
    }
    concl: int = gl_concl[pn_goal[n]];
    line_clear();
    for side in 0..2 {
        if (side == 1) line_add(" |");
        bs_n = 0;
        bd_flatten(bd_side_term(concl, side), false);
        for i in 0..bs_n {
            line_add(" ");
            show_line_add(bs_atom[i]);
            if (bs_flip[i]) line_add("'")
        }
    }
    line_print()
}

show_line_add(t: int) {
    line_sym(tm_name(t))
}

bead(
    kind: int,
    j: int,
    side: int,
    i: int,
    k: int,
    face: int,
    w: str
) raises IoError, KernelError {
    gq_side = side;
    gq_i = i;
    gq_k = k;
    gq_face = face;
    n: int = focus();
    t: int = 0;
    if (w != "") t = witness_term(n, w);
    if (!gs_do(n, kind, j, t)) print("(does not fit)") else print_beads()
}

test "beads: what each gesture does to the strings" {
    open_region("programs/lemma/regions/groups.txt");
    level_start(level_called("pop"));
    print_beads();
    // (Not twins; not side by side; then the twins.)
    bead(GS_POP, -1, 0, 0, 0, 0, "");
    bead(GS_POP, -1, 0, 1, 0, 0, "");
    bead(GS_POP, -1, 1, 0, 0, 0, "");
    bead(GS_POP, -1, 0, 0, 0, 0, "");
    // (A pair out of nothing: at the front, in the middle, at the end, in
    // an empty string; a bead turned over first.)
    level_start(level_called("out_of_nothing"));
    print_beads();
    bead(GS_PAIR, -1, 0, 0, 0, 0, "inv(a)");
    bead(GS_PAIR, -1, 0, 3, 0, 0, "c");
    undo();
    bead(GS_PAIR, -1, 1, 1, 0, 0, "inv(b)");
    // (A stamp on a stretch it is not; then on a b.)
    bead(GS_STAMP, 0, 0, 0, 2, 0, "");
    bead(GS_STAMP, 0, 0, 1, 2, 0, "");
    undo();
    undo();
    undo();
    print_beads();
    // (Turned round.)
    level_start(level_called("turned"));
    print_beads();
    bead(GS_TURN, -1, 0, 0, 0, 0, "");
    // (For every x: x from the stretch; x given for a gap.)
    level_start(level_called("twice"));
    bead(GS_STAMP, 0, 0, 0, 0, 1, "inv(b)");
    bead(GS_STAMP, 0, 0, 0, 4, 0, "");
    bead(GS_STAMP, 0, 0, 0, 2, 0, "");
    level_start(level_called("does_nothing"));
    print_beads();
    bead(GS_STAMP, 0, 0, 0, 1, 0, "");
    expect {|
         a b b' a' | c c'
        (does not fit)
         a a' | c c'
         a a' |
        done
         b | c
         a' a b | c
         a' a b c c' | c
         a' a b | c b' b
        (does not fit)
         a' a c | c b' b
         b | c
         a' b' | b' a'
         b a | a b
         b' b' a b | b a
        (does not fit)
         a b | b a
         f |
        done
    |}
}

test "the tile: where it is, and a walk that cannot get there" {
    open_region("programs/lemma/regions/groups.txt");
    level_start(level_called("shortcut"));
    n: int = focus();
    show_line(gl_concl[pn_goal[n]]);
    line_print();
    bd_syms();
    print_bool(bd_walk_dead());
    print_bool(bd_walk(bd_flip));
    show_line(gl_concl[pn_goal[focus()]]);
    line_print();
    print_bool(bd_walk_dead());
    undo();
    print_bool(bd_walk(bd_turn));
    print_bool(bd_walk_dead());
    print_bool(bd_walk(bd_flip));
    print_bool(level_done());
    expect {|
        ∃x. ∃y. act(y, act(x, sq(A, B, C, D))) = sq(A, D, C, B)
        false
        true
        ∃y. act(y, sq(B, A, D, C)) = sq(A, D, C, B)
        true
        true
        false
        true
        true
    |}
}

test "the tile and beads, written out" {
    written("programs/lemma/regions/groups.txt", "over");
    written("programs/lemma/regions/groups.txt", "out_of_nothing");
    expect {|
        We choose flip: we must show ∃y. act(y, act(flip, sq(A, B, C, D))) = sq(C, B, A, D).
        After a flip, we must show ∃y. act(y, sq(B, A, D, C)) = sq(C, B, A, D).
        We choose turn: we must show act(turn, sq(B, A, D, C)) = sq(C, B, A, D).
        act(turn, sq(B, A, D, C))
        = sq(C, B, A, D)   (quarter turn)
        ∎
        b
        = e · b   (e on the left)
        = (a⁻¹ · a) · b   (inverse on the left)
        = a⁻¹ · (a · b)   (regroup)
        = a⁻¹ · (a · c)   (by hypothesis)
        = (a⁻¹ · a) · c   (regroup)
        = e · c   (inverse on the left)
        = c   (e on the left)
        ∎
    |}
}
