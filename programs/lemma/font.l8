tag lemma_ui;

// The game's writing: Rubik Light Medium and Rubik Light ExtraBold, with Noto
// Sans Math for what they have not (all under the SIL Open Font License:
// see tools/fonts), each character as a picture of how far each point
// is from its edge. Made by programs/lemma/tools/font.py: not to be
// changed by hand. See paint.l8 for how it is drawn.
//
// The size the characters are kept at, in pixels to the em; how far from
// an edge the distance is kept (a point that far outside is 0, one that
// far inside is 63, and the edge is between); the line's ascent and
// descent, and how tall a capital and a small letter are, at that size;
// and the picture's size.
const FONT_EM: f32 = 40.0;

const FONT_SPREAD: f32 = 6.0;

const FONT_ASCENT: f32 = 37.400;

const FONT_DESCENT: f32 = 10.000;

const FONT_CAP: f32 = 28.000;

const FONT_X: f32 = 20.800;

const FONT_W: int = 1024;

const FONT_H: int = 620;

// The faces (0 Medium, 1 ExtraBold); the characters of each, the ASCII
// ones from the space on and then those in font_more, by their code
// points (in order, so they can be looked for by halves).
const FONT_FACES: int = 2;

const FONT_FIRST: int = 32;

const FONT_GLYPHS: int = 209;

const GLYPH_FLOATS: int = 7;

