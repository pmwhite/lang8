tag lemma;

use_tag std;

// Names and lines of text. A name (a symbol) is a run of bytes kept once in
// one pool and known by its number, so two names are the same exactly when
// their numbers are. A line is text being put together, for the screen or
// for a test to print.
const SYMS: int = 65536;

const SYM_BYTES: int = 1048576;

const SYM_SLOTS: int = 131072;

sym_bytes: []i8 = static_buffer(SYM_BYTES, 0i8);

sym_start: []int = static_buffer(SYMS, 0);

sym_len: []int = static_buffer(SYMS, 0);

// Open addressing: each slot holds a name's number plus one (0 is empty).
sym_slot: []int = static_buffer(SYM_SLOTS, 0);

// Name 0 is the empty name.
sym_n: int = 1;

sym_used: int = 0;

sym_hash(t: []i8, from: int, to: int): int {
    h: int = -3750763034362895579;
    for i in from..to {
        h = h ^ t[i] as int;
        h = h * 1099511628211
    }
    h ^ h >> 29
}

sym_is(
    k: int,
    t: []i8,
    from: int,
    to: int
): bool {
    if (sym_len[k] != to - from) return false;
    s: int = sym_start[k];
    for i in 0..to - from {
        if (sym_bytes[s + i] != t[from + i]) return false
    }
    true
}

// The name for the bytes from `from` up to `to`, made if new.
sym_of(t: []i8, from: int, to: int): int {
    if (to <= from) return 0;
    at: int = sym_hash(t, from, to) & SYM_SLOTS - 1;
    while (sym_slot[at] != 0) {
        k: int = sym_slot[at] - 1;
        if (sym_is(k, t, from, to)) return k;
        at = at + 1 & SYM_SLOTS - 1
    }
    n: int = to - from;
    if (sym_n >= SYMS || sym_used + n > SYM_BYTES) return 0;
    k: int = sym_n;
    sym_start[k] = sym_used;
    sym_len[k] = n;
    for i in 0..n sym_bytes[sym_used + i] = t[from + i];
    sym_used = sym_used + n;
    sym_n = sym_n + 1;
    sym_slot[at] = k + 1;
    k
}

sym_scratch: []i8 = static_buffer([1024]i8);

sym(s: str): int {
    n: int = 0;
    for c in s {
        if (n < len(sym_scratch)) {
            sym_scratch[n] = c;
            n = n + 1
        }
    }
    sym_of(sym_scratch, 0, n)
}

// The byte at i of name k.
sym_byte(k: int, i: int): int {
    sym_bytes[sym_start[k] + i] as int
}

// ---- a line of text being put together ----
line: []i8 = static_buffer([65536]i8);

line_n: int = 0;

line_clear() {
    line_n = 0
}

line_byte(c: int) {
    if (line_n < len(line)) {
        line[line_n] = c trunc i8;
        line_n = line_n + 1
    }
}

line_add(t: str) {
    for c in t line_byte(c as int)
}

line_sym(k: int) {
    s: int = sym_start[k];
    for i in 0..sym_len[k] line_byte(sym_bytes[s + i] as int)
}

line_int(v: int) {
    if (v < 0) {
        line_byte(45);
        line_int(-v);
        return
    }
    if (v >= 10) line_int(v / 10);
    line_byte(48 + v % 10)
}

// A code point, as UTF-8.
line_cp(c: int) {
    if (c < 128) line_byte(c) else if (c < 2048) {
        line_byte(192 | c >> 6);
        line_byte(128 | c & 63)
    } else if (c < 65536) {
        line_byte(224 | c >> 12);
        line_byte(128 | c >> 6 & 63);
        line_byte(128 | c & 63)
    } else {
        line_byte(240 | c >> 18);
        line_byte(128 | c >> 12 & 63);
        line_byte(128 | c >> 6 & 63);
        line_byte(128 | c & 63)
    }
}

line_print() raises IoError {
    write_bytes_n(1, line, line_n);
    print("");
    line_n = 0
}

// The name that is one code point (λ is sym_cp(955)).
sym_cp(c: int): int {
    line_clear();
    line_cp(c);
    line_sym_now()
}

// The line so far, as a name.
line_sym_now(): int {
    sym_of(line, 0, line_n)
}
