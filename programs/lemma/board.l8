tag lemma_ui;

use_tag std, skate, lemma;

// The board as a language: the formulas are the controls. No list of
// moves anywhere. A statement's outermost symbol is a raised key (tap it:
// it opens, always safely), a sunken notch (drop a name into it: the
// choosing), or flat; a fact is picked up whole and put onto the goal; an
// equation (a rule's tile, a lemma's, a fact) is gripped by one face and
// put onto a part of the goal that looks like it; the goal is swiped to
// flip it, or put up into the facts to suppose it is not so. The names in
// scope, the kit's tiles that build names, and the rules sit on the shelf
// at the bottom. What is in scope is what is on the board (gesture.l8
// makes the moves).
//
// A thing held over a place it fits shows what that place would become;
// let go there, the move is made; let go anywhere else, it springs home
// and the place shakes no (said in words the second time).
lang_on(): bool {
    page == PAGE_LEVEL && loaded_region >= 0
}

lang_logic_sym: int = 0;

// Whether the level is in the first chapter (where help comes at once).
lang_first(): bool {
    if (lang_logic_sym == 0) lang_logic_sym = sym("logic");
    region_name == lang_logic_sym
}

// The keys' buttons: the goal's (B_KEY), fact j's (B_KEY + 1 + j); a
// name on the shelf tapped (B_TOKEN + k).
const B_KEY: int = 6000;

const B_TOKEN: int = 6500;

// ---- where things are on the board (laid out each frame) ----
// The goal's key and notch.
gk_ok: bool = false;

gk_x0: f32 = 0.0;

gk_y0: f32 = 0.0;

gk_x1: f32 = 0.0;

gk_y1: f32 = 0.0;

gn_ok: bool = false;

gn_x0: f32 = 0.0;

gn_y0: f32 = 0.0;

gn_x1: f32 = 0.0;

gn_y1: f32 = 0.0;

// Each fact's card, key and notch (by its number in the goal), and the
// x of its = (an equation's seam; 0 if none).
const BF: int = 64;

bf_n: int = 0;

bf_term: []int = new int[BF](0);

bf_x0: []f32 = new f32[BF](0.0);

bf_y0: []f32 = new f32[BF](0.0);

bf_x1: []f32 = new f32[BF](0.0);

bf_y1: []f32 = new f32[BF](0.0);

bf_seam: []f32 = new f32[BF](0.0);

bfk_ok: []bool = new bool[BF](false);

bfk_x0: []f32 = new f32[BF](0.0);

bfk_y0: []f32 = new f32[BF](0.0);

bfk_x1: []f32 = new f32[BF](0.0);

bfk_y1: []f32 = new f32[BF](0.0);

bfn_ok: []bool = new bool[BF](false);

bfn_x0: []f32 = new f32[BF](0.0);

bfn_y0: []f32 = new f32[BF](0.0);

bfn_x1: []f32 = new f32[BF](0.0);

bfn_y1: []f32 = new f32[BF](0.0);

// The goal as it really is, laid out where it is drawn (when the card
// shows a preview, the parts a face is put onto are found in this).
goal_real_e: int = -1;

const TOK_R: f32 = 23.0;

// ---- the level begun ----
lang_start() {
    dg_on = false;
    rb_t0 = -10.0;
    sk_t0 = -10.0;
    wh_t0 = -10.0;
    ps_on = false;
    lh_on = false;
    nd_t0 = -10.0;
    sw_on = false;
    sw_dx = 0.0;
    dead_node = -1;
    breathe_t = -10.0;
    shn_seen_n = 0;
    hv_kind = T_NONE;
    kf_item = -1;
    kf_n = 0;
    made_n = 0;
    goal_gen = goal_gen + 1;
    pp_cancel();
    boxes_at = now_t + 1.9
}

// ---- keys and notches of a statement laid out as expression e ----
// The block of e that is the statement itself (under Trueprop), or -1.
root_block(e: int, t: int): int {
    c: int = rel_core(t);
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        if (bx_term[b] == c) return b
    }
    -1
}

sym_dot: int = 0;

// The rectangle of the key of statement t laid out as e, drawn at (ox,
// oy): into kr_. Whether it has one. A key is at least a thumb tall.
kr_x0: f32 = 0.0;

kr_y0: f32 = 0.0;

kr_x1: f32 = 0.0;

kr_y1: f32 = 0.0;

const KEY_H: f32 = 44.0;

key_rect(
    e: int,
    t: int,
    ox: f32,
    oy: f32
): bool {
    if (e < 0) return false;
    rb: int = root_block(e, t);
    if (rb < 0) return false;
    binder_rect(e, rb, shape_of(t), ox, oy)
}

// The key over block rb's binder (s: its shape), or its operator.
binder_rect(
    e: int,
    rb: int,
    s: int,
    ox: f32,
    oy: f32
): bool {
    if (sym_dot == 0) sym_dot = sym(". ");
    size: f32 = ex_size[e];
    first: bool = true;
    found: bool = false;
    for r in ex_run0[e]..ex_run0[e] + ex_runn[e] {
        if (rn_box[r] == rb && !found) {
            x: f32 = ox + rn_x[r];
            w: f32 = p_sym_w(0, size, rn_sym[r]);
            by: f32 = oy + rn_y[r];
            if (s == SH_ALL || s == SH_EX) {
                if (first) {
                    kr_x0 = x;
                    kr_y0 = by - size * 0.9;
                    kr_y1 = by + size * 0.3;
                    first = false
                }
                kr_x1 = x + w;
                if (rn_sym[r] == sym_dot) {
                    kr_x1 = x + p_sym_w(0, size, sym("."));
                    found = true
                }
            } else if (infix_text(rn_sym[r])) {
                sp: f32 = p_sym_w(0, size, sym(" "));
                kr_x0 = x + sp;
                kr_x1 = x + w - sp;
                kr_y0 = by - size * 0.9;
                kr_y1 = by + size * 0.3;
                found = true
            }
        }
    }
    if (!found) return false;
    kr_x0 = kr_x0 - size * 0.2;
    kr_x1 = kr_x1 + size * 0.2;
    // (A thumb's height and width at least.)
    cy: f32 = (kr_y0 + kr_y1) * 0.5;
    hh: f32 = maxf(kr_y1 - kr_y0, KEY_H) * 0.5;
    kr_y0 = cy - hh;
    kr_y1 = cy + hh;
    if (kr_x1 - kr_x0 < 40.0) {
        cx: f32 = (kr_x0 + kr_x1) * 0.5;
        kr_x0 = cx - 20.0;
        kr_x1 = cx + 20.0
    }
    true
}

// The notch: the room the layout gave the binder's name (lay_notch_t).
notch_rect(e: int, ox: f32, oy: f32): bool {
    if (e < 0 || !ex_nok[e]) return false;
    kr_x0 = ox + ex_nx0[e];
    kr_x1 = ox + ex_nx1[e];
    kr_y0 = oy + ex_ny0[e];
    kr_y1 = oy + ex_ny1[e];
    true
}

// The name in the notch, faint.
notch_name(e: int): int {
    rb: int = ex_box0[e];
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        if (bx_term[b] == lay_notch_t) rb = b
    }
    k: int = 0;
    for r in ex_run0[e]..ex_run0[e] + ex_runn[e] {
        if (rn_box[r] == rb) {
            if (k == 1) return rn_sym[r];
            k = k + 1
        }
    }
    0
}

// The statement whose binder is a notch, for laying out the goal (j < 0)
// or fact j of node n: its core, or 0.
notch_term(n: int, j: int, t: int): int {
    if (n < 0 || done_t >= 0.0) return 0;
    s: int = shape_of(t);
    if (j < 0 && s == SH_EX || j >= 0 && s == SH_ALL) return rel_core(t);
    0
}

// A raised key, its face (x0..x1, y0..y1) in color col; pressed k.
draw_keycap(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    col: int,
    k: f32,
    breathe: bool
) {
    w: f32 = x1 - x0;
    h: f32 = y1 - y0;
    r: f32 = minf(h * 0.32, 12.0);
    depth: f32 = 5.0 - 4.0 * k;
    if (breathe) {
        g: f32 = 0.5 + 0.5 * sinf(now_t * 3.2);
        p_glow(x0 + w * 0.5, y0 + h * 0.5, maxf(w, h) * 0.75 + 4.0 * g, 10.0, C_GOLD,
            0.3 + 0.25 * g);
        busy = true
    }
    p_shadow(x0, y0 + 3.0 - k * 3.0, w, h, r, depth, 6.0, 0.24);
    p_box(x0, y0 + depth, w, h, r, mix_rgb(col, C_SHADOW, 0.3), 1.0);
    p_box(x0, y0 + 4.0 * k, w, h, r, col, 1.0);
    p_box(x0 + 3.0, y0 + 4.0 * k + 2.0, w - 6.0, h * 0.34, r * 0.7, C_WHITE, 0.4 * (1.0 - k))
}

// A key not yet pressable (a binder inside: it is opened once the ones
// round it are): pressed in, dimmed (drawn over the writing: a rim, and
// the shadow of its top edge).
draw_keycap_inner(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    col: int
) {
    w: f32 = x1 - x0;
    h: f32 = y1 - y0;
    r: f32 = minf(h * 0.32, 12.0);
    p_outline(x0, y0, w, h, r, 1.6, col, 0.75);
    p_box(x0 + 2.0, y0 + 1.5, w - 4.0, 3.0, 1.5, C_SHADOW, 0.12)
}

// A sunken notch, (x0..x1, y0..y1): its name faint in it; glowing if a
// name held fits it.
draw_notch(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    name: int,
    size: f32,
    lit: bool
) {
    w: f32 = x1 - x0;
    h: f32 = y1 - y0;
    r: f32 = minf(h * 0.42, 16.0);
    if (lit) {
        g: f32 = 0.5 + 0.5 * sinf(now_t * 5.0);
        p_glow(x0 + w * 0.5, y0 + h * 0.5, maxf(w, h) * 0.7 + 3.0 * g, 9.0, C_PICK,
            0.3 + 0.25 * g);
        busy = true
    }
    // (A hole: its rim, its floor, the shadow its top edge casts.)
    p_box(x0 - 1.5, y0 - 1.5, w + 3.0, h + 3.0, r + 1.5, C_WHITE, 0.55);
    p_box(x0, y0, w, h, r, mix_rgb(C_SUNK, C_SHADOW, 0.12), 1.0);
    p_box(x0 + 2.0, y0 + 2.0, w - 4.0, h * 0.34, r * 0.8, C_SHADOW, 0.13);
    p_outline(x0, y0, w, h, r, 1.6, mix_rgb(C_MUTED, C_SUNK, 0.2), 1.0);
    if (name != 0) {
        fs: f32 = minf(size, h * 0.62);
        nw: f32 = p_sym_w(0, fs, name);
        p_sym(0, fs, x0 + w * 0.5 - nw * 0.5, y0 + h * 0.5 + fs * 0.34, name, C_FAINT,
            1.0)
    }
}

// Keys under the writing of the goal (j < 0) or fact j, laid out as e and
// to be drawn at (ox, oy): its own (kept, with its button), and those of
// binders inside it, dimmed.
lang_under(
    e: int,
    t: int,
    j: int,
    ox: f32,
    oy: f32
) {
    n: int = play_node();
    live: bool = n >= 0 && done_t < 0.0 && !lang_previewing(j);
    ok: bool = live && gs_has_key(n, j) && key_rect(e, t, ox, oy);
    if (j < 0) {
        gk_ok = ok;
        if (ok) {
            gk_x0 = kr_x0;
            gk_y0 = kr_y0;
            gk_x1 = kr_x1;
            gk_y1 = kr_y1
        }
    } else if (j < BF) {
        bfk_ok[j] = ok;
        if (ok) {
            bfk_x0[j] = kr_x0;
            bfk_y0[j] = kr_y0;
            bfk_x1[j] = kr_x1;
            bfk_y1[j] = kr_y1
        }
    }
    col: int = mix_rgb(C_PICK_SOFT, C_PICK, 0.35);
    if (j >= 0) col = mix_rgb(C_BLUE_SOFT, C_BLUE, 0.3);
    if (!ok) return;
    id: int = B_KEY + 1 + j;
    breathe: bool = now_t - last_input_t > 8.0 && !dg_on;
    // (Just back from a dead end: the keys not opened breathe at once.)
    if (now_t - breathe_t < 5.0) breathe = true;
    // (The hint's key breathes gold.)
    if (lh_on && lh_kind == GS_KEY && lh_j == j) breathe = true;
    draw_keycap(kr_x0, kr_y0, kr_x1, kr_y1, col, pressed(id), breathe);
    add_button(id, kr_x0 - 6.0, kr_y0 - 6.0, kr_x1 + 6.0, kr_y1 + 6.0)
}

// The binders inside statement t (laid out as e) that will be keys once
// the ones round them are opened: on the goal, for-alls; on a fact,
// there-ises.
inner_keys(
    e: int,
    t: int,
    j: int,
    ox: f32,
    oy: f32,
    col: int
) {
    rb: int = root_block(e, t);
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        if (b != rb && is_quantifier(bx_term[b])) {
            s: int = shape_of(bx_term[b]);
            if (j < 0 && s == SH_ALL || j >= 0 && s == SH_EX) {
                if (binder_rect(e, b, s, ox, oy)) draw_keycap_inner(kr_x0, kr_y0 + 6.0,
                    kr_x1, kr_y1 - 6.0, col)
            }
        }
    }
}

// The notch over the writing (drawn after it), and the keys inside not
// yet pressable.
lang_over(e: int, t: int, j: int) {
    if (e < 0) return;
    n: int = play_node();
    if (n >= 0 && done_t < 0.0 && !lang_previewing(j)) {
        col: int = mix_rgb(C_PICK_SOFT, C_PICK, 0.5);
        if (j >= 0) col = mix_rgb(C_BLUE_SOFT, C_BLUE, 0.45);
        inner_keys(e, t, j, ex_ox[e], ex_oy[e], col)
    }
    ok: bool = n >= 0 && done_t < 0.0 && !lang_previewing(j) && gs_has_notch(n, j) && notch_rect(e,
        ex_ox[e], ex_oy[e]);
    if (j < 0) {
        gn_ok = ok;
        if (ok) {
            gn_x0 = kr_x0;
            gn_y0 = kr_y0;
            gn_x1 = kr_x1;
            gn_y1 = kr_y1
        }
    } else if (j < BF) {
        bfn_ok[j] = ok;
        if (ok) {
            bfn_x0[j] = kr_x0;
            bfn_y0[j] = kr_y0;
            bfn_x1[j] = kr_x1;
            bfn_y1[j] = kr_y1
        }
    }
    if (!ok) return;
    lit: bool = dg_on && dg_kind == DG_TOKEN && lf_fit(j) && helping();
    if (lh_on && lh_kind == GS_NOTCH && lh_j == j) lit = true;
    lay_notch_t = rel_core(t);
    nm: int = notch_name(e);
    lay_notch_t = 0;
    draw_notch(kr_x0, kr_y0, kr_x1, kr_y1, nm, ex_size[e], lit)
}

// ---- the shelf ----
// What sits on it: names (the level's own, any, some, made from the kit),
// the kit's tiles, the rules' tiles, the lemmas' tiles.
const SI_TOKEN: int = 1;

const SI_KIT: int = 2;

const SI_RULE: int = 3;

const SI_LEMMA: int = 4;

const SIS: int = 48;

si_n: int = 0;

si_kind: []int = new int[SIS](0);

// (A name's term; a kit's term; a rule's or lemma's number.)
si_term: []int = new int[SIS](0);

// (A name's kind: 0 the level's own, 1 any, 2 some, 3 made.)
si_tk: []int = new int[SIS](0);

si_x0: []f32 = new f32[SIS](0.0);

si_y0: []f32 = new f32[SIS](0.0);

si_x1: []f32 = new f32[SIS](0.0);

si_y1: []f32 = new f32[SIS](0.0);

// (A tile's writing: what is shown, and the x of a rule's = from its left.)
si_show: []int = new int[SIS](0);

si_seam: []f32 = new f32[SIS](0.0);

si_tw: []f32 = new f32[SIS](0.0);

// The names, for the rest of the board (shn_ by number among names).
const BTOKS: int = 32;

shn_n: int = 0;

shn_term: []int = new int[BTOKS](0);

shn_kind: []int = new int[BTOKS](0);

shn_x: []f32 = new f32[BTOKS](0.0);

shn_y: []f32 = new f32[BTOKS](0.0);

shn_item: []int = new int[BTOKS](0);

// When each name came onto the shelf (it bounces in).
shn_born: []f32 = new f32[BTOKS](-10.0);

shn_seen_term: []int = new int[BTOKS](0);

shn_seen_n: int = 0;

// Names made from the kit this level (ε / 2, max(N, N₁)).
made_term: []int = new int[8](0);

made_n: int = 0;

// The kit tile being filled (its item), and the names in it so far.
kf_item: int = -1;

kf_t: []int = new int[2](0);

kf_n: int = 0;

const TILE_SIZE: f32 = 17.0;

const SHELF_PAD: f32 = 14.0;

// The shelf's height, laid out for width w (shelf_build).
shelf_h: f32 = 0.0;

// What is on the shelf at node n, laid out in rows across width w from x.
shelf_build(n: int, x: f32, w: f32) {
    si_n = 0;
    shn_n = 0;
    if (n < 0) {
        shelf_h = 18.0;
        return
    }
    g: int = pn_goal[n];
    // (Names: the level's own and those taken, the region's own (e), the
    // kit's ready ones (0), those made.)
    for i in 0..gl_fixn[g] {
        xx: int = goal_fix(g, i);
        if (token_type(tm_type(xx))) si_token(xx, token_kind(n, xx))
    }
    for k in mark_ent..ent_n {
        if (ent_kind[k] == E_FIX && token_type(ent_ty[k]) && !is_numeral(ent_term[k]) && region_uses(ent_term[k])) si_token(ent_term[k],
            0)
    }
    if (cur_level >= 0) {
        for k in 0..lv_kitn[cur_level] {
            kit: int = pool[lv_kit0[cur_level] + k];
            vars_n = 0;
            collect_vars(kit);
            if (vars_n == 0) si_token(kit, 0)
        }
    }
    for i in 0..made_n {
        if (in_scope(g, made_term[i])) si_token(made_term[i], 3)
    }
    // (The kit's tiles, after the names.)
    if (cur_level >= 0) {
        for k in 0..lv_kitn[cur_level] {
            kit: int = pool[lv_kit0[cur_level] + k];
            vars_n = 0;
            collect_vars(kit);
            if (vars_n > 0 && vars_n <= 2) si_add(SI_KIT, kit, 0)
        }
    }
    tiles0: int = si_n;
    for l in 0..lm_n {
        if (rule_tile(l)) si_add(SI_RULE, l, 0)
    }
    for l in 0..lm_n {
        if (lemma_tile(l)) si_add(SI_LEMMA, l, 0)
    }
    shelf_tiles = si_n > tiles0;
    shelf_layout(x, w);
    // (A name new on the shelf bounces in.)
    for k in 0..shn_n {
        seen: bool = false;
        for i in 0..shn_seen_n {
            if (shn_seen_term[i] == shn_term[k]) seen = true
        }
        if (!seen) {
            shn_born[k] = now_t;
            if (an_jump || intro_open) shn_born[k] = -10.0
        } else if (shn_born[k] > now_t) shn_born[k] = -10.0
    }
    for k in 0..shn_n shn_seen_term[k] = shn_term[k];
    shn_seen_n = shn_n
}

// Whether the shelf has tiles (rules, lemmas) as well as names.
shelf_tiles: bool = false;

// Whether region's own name x is in the level (in its goal or rulebook).
region_uses(x: int): bool {
    for i in 0..ctx_n {
        if (occurs(x, ctx_hyp[i])) return true
    }
    false
}

// Whether every name in t is one goal g has, or the region's.
in_scope(g: int, t: int): bool {
    k: int = tm_kind(t);
    if (k == TM_FREE) {
        for i in 0..gl_fixn[g] {
            if (goal_fix(g, i) == t) return true
        }
        for e in mark_ent..ent_n {
            if (ent_kind[e] == E_FIX && ent_term[e] == t) return true
        }
        return is_numeral(t)
    }
    if (k == TM_APP) return in_scope(g, tm_fun(t)) && in_scope(g, tm_arg(t));
    if (k == TM_ABS) return in_scope(g, tm_body(t));
    true
}

si_token(t: int, kind: int) {
    for i in 0..shn_n {
        if (shn_term[i] == t) return
    }
    if (shn_n >= BTOKS) return;
    k: int = si_add(SI_TOKEN, t, kind);
    if (k < 0) return;
    shn_term[shn_n] = t;
    shn_kind[shn_n] = kind;
    shn_item[shn_n] = k;
    shn_n = shn_n + 1
}

si_add(kind: int, t: int, tk: int): int {
    if (si_n >= SIS) return -1;
    k: int = si_n;
    si_kind[k] = kind;
    si_term[k] = t;
    si_tk[k] = tk;
    si_n = k + 1;
    k
}

// Whether lemma l is a rule's tile: an equation of the region, or a
// lemma proved that is one, with no premises.
rule_tile(l: int): bool {
    if (!lemma_offered(l)) return false;
    k: int = lm_kind[l];
    if (k != LM_ASSUME && k != LM_LEVEL) return false;
    q: int = strip_rule(thm_prop(lm_thm[l]));
    prem_n == 0 && (is_eq(q) || is_binary(rel_core(q), role_name[ROLE_EQ]))
}

// Whether lemma l is a lemma's tile: one proved, used whole on the goal.
lemma_tile(l: int): bool {
    lemma_offered(l) && lm_kind[l] == LM_LEVEL && !rule_tile(l)
}

// A tile's writing: a rule with its variables as slots; a kit with its
// holes (some filled).
tile_term(k: int): int {
    if (si_kind[k] == SI_KIT) {
        t: int = si_term[k];
        if (k == kf_item && kf_n > 0) {
            vars_n = 0;
            collect_vars(t);
            if (vars_n > 0) {
                match_clear();
                if (match_type(tm_type(vars[0]), tm_type(kf_t[0])) && match_bind(vars[0],
                    kf_t[0])) {
                    try {
                        t = match_subst(t)
                    } with KernelError -> { }
                }
            }
        }
        return t
    }
    // (A lemma whole, its premises too; a rule, its equation.)
    if (si_kind[k] == SI_LEMMA) return thm_prop(lm_thm[si_term[k]]);
    rel_core(strip_rule(thm_prop(lm_thm[si_term[k]])))
}

// The shelf's rows: names first (and the kit's tiles), then the tiles of
// rules and lemmas, each row as many as fit.
shelf_layout(x: f32, w: f32) {
    cx: f32 = x + 8.0;
    cy: f32 = SHELF_PAD;
    row_h: f32 = 2.0 * TOK_R + 12.0;
    first_tile: bool = true;
    for k in 0..si_n {
        iw: f32 = 2.0 * TOK_R;
        ih: f32 = 2.0 * TOK_R;
        if (si_kind[k] == SI_TOKEN) iw = 2.0 * token_hw(si_term[k]);
        if (si_kind[k] != SI_TOKEN) {
            an_live = false;
            show_holes = true;
            lay_one_line = true;
            e: int = lay_term(tile_term(k), TILE_SIZE, w - 40.0, 9400000 + k);
            lay_one_line = false;
            show_holes = false;
            an_live = true;
            tw: f32 = 60.0;
            if (e >= 0) tw = ex_w[e];
            si_tw[k] = tw;
            iw = tw + 30.0;
            ih = 44.0;
            si_seam[k] = 0.0;
            if (si_kind[k] == SI_RULE && e >= 0) si_seam[k] = seam_x(e, -1) + 15.0;
            if (si_kind[k] == SI_LEMMA) {
                iw = maxf(iw, p_sym_w(1, 13.0, lm_words[si_term[k]]) + 30.0);
                ih = 62.0
            }
            // (The rules' tiles start a row of their own.)
            if ((si_kind[k] == SI_RULE || si_kind[k] == SI_LEMMA) && first_tile) {
                first_tile = false;
                if (cx > x + 8.0) {
                    cx = x + 8.0;
                    cy = cy + row_h
                }
                row_h = 0.0
            }
        }
        if (cx + iw > x + w - 4.0 && cx > x + 8.0) {
            cx = x + 8.0;
            cy = cy + row_h + 8.0;
            row_h = 0.0
        }
        si_x0[k] = cx;
        si_y0[k] = cy;
        si_x1[k] = cx + iw;
        si_y1[k] = cy + ih;
        row_h = maxf(row_h, ih);
        cx = cx + iw + 12.0
    }
    shelf_h = cy + row_h + SHELF_PAD;
    if (si_n == 0) shelf_h = 18.0
}

// The x of the = in expression e (from its left), or of its middle.
seam_x(e: int, rb: int): f32 {
    eqs: int = sym(" = ");
    for r in ex_run0[e]..ex_run0[e] + ex_runn[e] {
        if (rn_sym[r] == eqs && (rb < 0 || rn_box[r] == rb)) return rn_x[r] + p_sym_w(0,
            ex_size[e], eqs) * 0.5
    }
    ex_w[e] * 0.5
}

// How tall the shelf is (it was laid out this frame).
shelf_height(): f32 {
    shelf_h + 4.0
}

// How node n's name x came into its goal: 0 the level's own, 1 taken
// (any), 2 got from a there-is (some).
token_kind(n: int, x: int): int {
    a: int = n;
    while (pn_parent[a] >= 0) {
        p: int = pn_parent[a];
        gp: int = pn_goal[p];
        ga: int = pn_goal[a];
        for i in gl_fixn[gp]..gl_fixn[ga] {
            if (goal_fix(ga, i) == x) {
                m: int = pn_move[p];
                if (m >= 0 && mv_lemma[m] >= 0 && lm_name[mv_lemma[m]] == sym("exE")) return 2;
                return 1
            }
        }
        a = p
    }
    0
}

// Where the shelf's top is.
shelf_top: f32 = 0.0;

draw_shelf(x: f32, w: f32, top: f32) {
    away: f32 = 0.0;
    if (done_t >= 0.0) {
        if (!hand_leaving()) return;
        away = hand_away() * (shelf_h + 60.0);
        busy = true
    }
    y0: f32 = top + away;
    shelf_top = y0;
    p_shadow(0.0, y0, view_w(), shelf_h + safe_bottom + 40.0, 26.0, -3.0, 18.0, 0.14);
    p_box(0.0, y0, view_w(), shelf_h + safe_bottom + 40.0, 26.0, mix_rgb(C_BG, C_SUNK,
        0.7), 1.0);
    if (si_n == 0) return;
    for k in 0..si_n {
        si_y0[k] = si_y0[k] + y0;
        si_y1[k] = si_y1[k] + y0
    }
    // (A groove the names sit in.)
    if (shn_n > 0) {
        gy: f32 = si_y0[shn_item[0]] - 6.0;
        p_box(x + 2.0, gy, w - 4.0, 2.0 * TOK_R + 12.0, TOK_R + 6.0, mix_rgb(C_SUNK,
            C_SHADOW, 0.05), 1.0);
        p_box(x + 3.0, gy + 1.0, w - 6.0, 10.0, 8.0, C_SHADOW, 0.05)
    }
    for k in 0..si_n {
        if (si_kind[k] == SI_TOKEN) draw_shelf_token(k) else draw_tile(k, 1.0)
    }
}

draw_shelf_token(k: int) {
    i: int = 0;
    for q in 0..shn_n {
        if (shn_item[q] == k) i = q
    }
    tx: f32 = (si_x0[k] + si_x1[k]) * 0.5;
    ty: f32 = (si_y0[k] + si_y1[k]) * 0.5;
    // (Waiting to fill a socket: the names lift and bob.)
    if (ps_on) ty = ty - 4.0 - 3.0 * sinf(now_t * 5.0 + i as f32);
    // (Tapped: it bobs toward where it fits.)
    if (nd_on(DG_TOKEN, i)) {
        tx = tx + nd_dx();
        ty = ty + nd_dy()
    }
    shn_x[i] = tx;
    shn_y[i] = ty;
    held: bool = dg_on && dg_kind == DG_TOKEN && dg_src == i;
    back: bool = rb_on() && rb_kind == DG_TOKEN && rb_src == i;
    a: f32 = 1.0;
    if (held || back) a = 0.25;
    s: f32 = 1.0;
    bt: f32 = now_t - shn_born[i];
    if (bt >= 0.0 && bt < 0.6) {
        // (From where it was made, up and over, and a bounce.)
        q: f32 = bt / 0.6;
        s = q * (1.0 + 0.45 * sinf(q * 3.1416)) + 0.001;
        ty = ty - sinf(q * 3.1416) * 30.0;
        busy = true
    }
    draw_token(shn_term[i], shn_kind[i], tx, ty, s, a);
    if (lh_on && lh_tok == shn_term[i] && lh_kind != GS_KEY) {
        g: f32 = 0.5 + 0.5 * sinf(now_t * 5.0);
        p_ring(tx, ty, TOK_R + 5.0 + 2.0 * g, 2.5, C_GOLD, 0.7);
        busy = true
    }
    add_button(B_TOKEN + i, tx - TOK_R, ty - TOK_R, tx + TOK_R, ty + TOK_R)
}

// A tile on the shelf: a rule (two faces, a seam between), a lemma (its
// title over its statement), a kit (its holes).
draw_tile(k: int, a0: f32) {
    x0: f32 = si_x0[k];
    y0: f32 = si_y0[k];
    w: f32 = si_x1[k] - x0;
    h: f32 = si_y1[k] - y0;
    a: f32 = a0;
    held_face: int = -1;
    if (dg_on && (dg_kind == DG_FACE || dg_kind == DG_LEMMA) && dg_item == k) held_face = dg_face;
    if (rb_on() && (rb_kind == DG_FACE || rb_kind == DG_LEMMA) && rb_item == k) held_face = rb_face;
    fill: int = C_CARD;
    if (si_kind[k] == SI_KIT) fill = mix_rgb(C_GOLD_SOFT, C_CARD, 0.3);
    if (si_kind[k] == SI_LEMMA) fill = mix_rgb(C_GREEN_SOFT, C_CARD, 0.4);
    lit: bool = dg_on && dg_kind == DG_TOKEN && hv_kind == T_KIT && hv_j == k && hv_fit;
    if (lit) fill = C_PICK_SOFT;
    if (dg_on && dg_kind == DG_TOKEN && si_kind[k] == SI_KIT && helping() && !lit) {
        g: f32 = 0.5 + 0.5 * sinf(now_t * 4.0);
        p_shape(x0 - 3.0, y0 - 3.0, w + 6.0, h + 6.0, 16.0, 6.0, 0.0, C_PICK, 0.15 + 0.12 * g);
        busy = true
    }
    dx: f32 = shake_dx(T_KIT, k);
    p_shadow(x0 + dx, y0, w, h, 14.0, 3.0, 8.0, 0.16 * a);
    p_box(x0 + dx, y0, w, h, 14.0, fill, a);
    p_outline(x0 + dx, y0, w, h, 14.0, 1.6, mix_rgb(C_LINE, C_MUTED, 0.35), a);
    an_live = false;
    show_holes = true;
    lay_one_line = true;
    e: int = lay_term(tile_term(k), TILE_SIZE, w - 20.0, 9400000 + k);
    lay_one_line = false;
    show_holes = false;
    if (e >= 0) {
        ty: f32 = y0 + (h - ex_h[e]) * 0.5;
        if (si_kind[k] == SI_LEMMA) {
            p_sym(1, 13.0, x0 + 15.0, y0 + 18.0, lm_words[si_term[k]], mix_rgb(C_GREEN,
                C_INK, 0.3), a);
            ty = y0 + 22.0
        }
        if (si_kind[k] == SI_RULE) {
            // (The seam between its two faces: a notch in each edge.)
            sx: f32 = x0 + dx + si_seam[k];
            draw_seam(sx, y0, h, mix_rgb(C_LINE, C_MUTED, 0.5), a);
            // (A face gripped: it has lifted off; its place is faint.)
            if (held_face >= 0) {
                fx0: f32 = x0 + dx;
                fw: f32 = si_seam[k];
                if (held_face == 1) {
                    fx0 = sx;
                    fw = x0 + dx + w - sx
                }
                p_box(fx0 + 3.0, y0 + 3.0, fw - 6.0, h - 6.0, 11.0, C_SUNK, a)
            }
        }
        draw_expr(e, x0 + dx + 15.0, ty, C_INK, a, false)
    }
    an_live = true
}

// The seam of a tile or card with two faces, at x on (y0, height h): a
// small notch in its top and bottom edges, the = between them.
draw_seam(
    x: f32,
    y0: f32,
    h: f32,
    col: int,
    a: f32
) {
    p_disc(x, y0, 4.5, C_BG, a);
    p_disc(x, y0 + h, 4.5, C_BG, a);
    p_ring(x, y0, 4.5, 1.2, col, a * 0.8);
    p_ring(x, y0 + h, 4.5, 1.2, col, a * 0.8)
}

// A name as a pudgy ball at (cx, cy), scaled s: the level's own cream, an
// any one white ringed orange, a some one blue, a made one gold-ringed.
draw_token(
    t: int,
    kind: int,
    cx: f32,
    cy: f32,
    s: f32,
    a: f32
) {
    r: f32 = TOK_R * s;
    if (r <= 0.5) return;
    fill: int = C_CARD;
    ring: int = mix_rgb(C_LINE, C_MUTED, 0.4);
    ink: int = C_INK;
    if (kind == 1) {
        fill = C_WHITE;
        ring = C_PICK;
        ink = mix_rgb(C_PICK, C_INK, 0.35)
    }
    if (kind == 2) {
        fill = C_BLUE;
        ring = mix_rgb(C_BLUE, C_SHADOW, 0.25);
        ink = C_WHITE
    }
    if (kind == 3) {
        fill = C_GOLD_SOFT;
        ring = C_GOLD
    }
    show_line(t);
    nm: int = line_sym_now();
    fs: f32 = 21.0 * s;
    nw: f32 = p_sym_w(0, fs, nm);
    // (A long name makes a pill, not a smaller ball.)
    hw: f32 = maxf(r, nw * 0.5 + r * 0.55);
    p_shadow(cx - hw, cy - r, 2.0 * hw, 2.0 * r, r, 3.0, 6.0, 0.2 * a);
    p_box(cx - hw, cy - r, 2.0 * hw, 2.0 * r, r, fill, a);
    p_outline(cx - hw, cy - r, 2.0 * hw, 2.0 * r, r, 3.0 * s, ring, a);
    p_box(cx - hw * 0.62, cy - r * 0.78, hw * 1.24, r * 0.5, r * 0.25, C_WHITE, 0.3 * a);
    p_sym(0, fs, cx - nw * 0.5, cy + fs * 0.34, nm, ink, a)
}

// How wide a name's ball is (half), for laying out the shelf.
token_hw(t: int): f32 {
    show_line(t);
    nm: int = line_sym_now();
    maxf(TOK_R, p_sym_w(0, 21.0, nm) * 0.5 + TOK_R * 0.55)
}

// ---- holding a thing ----
const DG_FACT: int = 1;

const DG_TOKEN: int = 2;

// (A face of an equation: a rule's tile, or an equation fact.)
const DG_FACE: int = 3;

// (A lemma's tile, put whole onto the goal.)
const DG_LEMMA: int = 4;

// (The goal itself, put up into the facts.)
const DG_GOAL: int = 5;

dg_on: bool = false;

dg_kind: int = 0;

dg_src: int = 0;

dg_term: int = 0;

// (A tile's item on the shelf, and the face gripped: 0 left, 1 right.)
dg_item: int = -1;

dg_face: int = 0;

dg_x: f32 = 0.0;

dg_y: f32 = 0.0;

dg_vx: f32 = 0.0;

dg_vy: f32 = 0.0;

// (Held where the finger took it, riding above the finger.)
dg_ox: f32 = 0.0;

dg_oy: f32 = 0.0;

dg_w: f32 = 0.0;

dg_h: f32 = 0.0;

dg_t0: f32 = 0.0;

// When the thing held last moved much (help comes when it is still).
dg_still_t: f32 = 0.0;

dg_sx: f32 = 0.0;

dg_sy: f32 = 0.0;

// What the finger came down on that it may pick up (-1 nothing).
gr_kind: int = 0;

gr_src: int = -1;

gr_item: int = -1;

gr_face: int = 0;

// How far above the finger a thing held rides.
const LIFT_UP: f32 = 44.0;

// Whether a finger at (x, y) is on something to pick up.
lang_grab(x: f32, y: f32): bool {
    gr_kind = 0;
    gr_src = -1;
    gr_item = -1;
    if (!lang_on() || done_t >= 0.0 || intro_open || chapter_open) return false;
    for k in 0..shn_n {
        if (absf(x - shn_x[k]) <= token_hw(shn_term[k]) + 6.0 && absf(y - shn_y[k]) <= TOK_R + 6.0) {
            gr_kind = DG_TOKEN;
            gr_src = k;
            return true
        }
    }
    for k in 0..si_n {
        sk: int = si_kind[k];
        if ((sk == SI_RULE || sk == SI_LEMMA) && x >= si_x0[k] && x <= si_x1[k] && y >= si_y0[k] && y <= si_y1[k]) {
            gr_kind = DG_FACE;
            if (sk == SI_LEMMA) gr_kind = DG_LEMMA;
            gr_item = k;
            gr_face = 0;
            if (sk == SI_RULE && x > si_x0[k] + si_seam[k]) gr_face = 1;
            return true
        }
    }
    for i in 0..bf_n {
        if (x >= bf_x0[i] && x <= bf_x1[i] && y >= bf_y0[i] && y <= bf_y1[i]) {
            gr_kind = DG_FACT;
            gr_src = i;
            // (An equation, or one for every x: gripped by a face.)
            if (bf_seam[i] > 0.0) {
                gr_kind = DG_FACE;
                gr_face = 0;
                if (x > bf_seam[i]) gr_face = 1
            }
            return true
        }
    }
    // (The goal: swiped, or put up into the facts.)
    if (x >= goal_rx && x <= goal_rx + goal_rw && y >= goal_ry && y <= goal_ry + goal_rh && !ps_on) {
        gr_kind = DG_GOAL;
        return true
    }
    false
}

// The thing under the finger lifted.
lang_lift(x: f32, y: f32) raises KernelError {
    if (gr_kind == 0) return;
    last_input_t = now_t;
    dg_on = true;
    dg_kind = gr_kind;
    dg_src = gr_src;
    dg_item = gr_item;
    dg_face = gr_face;
    dg_x = x;
    dg_y = y;
    dg_vx = 0.0;
    dg_vy = 0.0;
    dg_t0 = now_t;
    dg_still_t = now_t;
    dg_sx = x;
    dg_sy = y;
    hv_kind = T_NONE;
    hv_j = -1;
    nd_t0 = -10.0;
    dg_term = 0;
    if (dg_kind == DG_TOKEN) {
        dg_term = shn_term[dg_src];
        dg_w = 2.0 * token_hw(dg_term);
        dg_h = 2.0 * TOK_R;
        dg_ox = dg_w * 0.5;
        dg_oy = TOK_R + LIFT_UP
    } else if (dg_kind == DG_FACT) {
        dg_term = bf_term[dg_src];
        show_line(dg_term);
        dg_w = minf(p_sym_w(0, 24.0, line_sym_now()) + 40.0, bf_x1[dg_src] - bf_x0[dg_src]);
        dg_h = minf(bf_y1[dg_src] - bf_y0[dg_src], 60.0);
        dg_ox = dg_w * 0.5;
        dg_oy = dg_h + 18.0
    } else if (dg_kind == DG_FACE || dg_kind == DG_LEMMA) {
        face_setup();
        dg_ox = dg_w * 0.5;
        dg_oy = dg_h + 22.0
    } else if (dg_kind == DG_GOAL) {
        dg_term = gl_concl[pn_goal[play_node()]];
        show_line(dg_term);
        dg_w = minf(p_sym_w(0, 24.0, line_sym_now()) + 44.0, goal_rw);
        dg_h = 56.0;
        dg_ox = dg_w * 0.5;
        dg_oy = dg_h + 18.0
    }
    // (Where it fits, found now: those places breathe while it is held.)
    lift_fits();
    if (lh_on && demo_kind == 0) lh_on = false;
    lang_drag(x, y)
}

// A face gripped: its tile (gf_l, gf_j), which face, and what it shows.
dg_face_t: int = 0;

dg_other_t: int = 0;

face_setup() {
    gf_l = -1;
    gf_j = -1;
    gf_back = dg_face == 1;
    q: int = 0;
    if (dg_kind == DG_LEMMA) {
        gf_l = si_term[dg_item];
        dg_face_t = thm_prop(lm_thm[gf_l]);
        dg_other_t = 0
    } else {
        if (dg_item >= 0) {
            gf_l = si_term[dg_item];
            q = rel_core(strip_rule(thm_prop(lm_thm[gf_l])))
        } else {
            gf_j = dg_src;
            q = rel_core(bf_term[dg_src]);
            // (One for every x: its body, x a slot.)
            if (shape_of(q) == SH_ALL && tm_kind(tm_arg(q)) == TM_ABS) {
                f: int = tm_arg(q);
                try {
                    q = rel_core(open_abs(f, mk_var(tm_abs_hint(f), tm_abs_type(f))))
                } with KernelError -> { }
            }
        }
        dg_face_t = eq_side(q, dg_face);
        dg_other_t = eq_side(q, 1 - dg_face)
    }
    show_holes = true;
    show_line(dg_face_t);
    show_holes = false;
    dg_w = p_sym_w(0, 22.0, line_sym_now()) + 36.0;
    dg_h = 50.0;
    if (dg_kind == DG_LEMMA) {
        dg_w = maxf(dg_w, p_sym_w(1, 13.0, lm_words[gf_l]) + 36.0);
        dg_h = 64.0
    }
    dg_term = dg_face_t
}

// Where the thing held fits: the goal (lf_goal), each fact.
lf_goal: bool = false;

lf_fact: []bool = new bool[BF](false);

lf_facts: bool = false;

lf_fit(j: int): bool {
    if (j < 0) return lf_goal;
    j < BF && lf_fact[j]
}

lift_fits() raises KernelError {
    n: int = play_node();
    lf_goal = false;
    lf_facts = false;
    for i in 0..BF lf_fact[i] = false;
    if (n < 0) return;
    if (dg_kind == DG_TOKEN) {
        if (ps_on) lf_goal = true else if (gs_has_notch(n, -1)) lf_goal = gs_try(n,
            GS_NOTCH, -1, dg_term) != 0;
        for i in 0..mini(bf_n, BF) {
            if (gs_has_notch(n, i)) lf_fact[i] = gs_try(n, GS_NOTCH, i, dg_term) != 0
        }
    } else if (dg_kind == DG_FACT) lf_goal = gs_apply_wn(n, dg_src) >= 0 else if (dg_kind == DG_LEMMA) lf_goal = gs_try(n,
        GS_LEMMA, gf_l, 0) != 0 else if (dg_kind == DG_FACE) lf_goal = face_fits_somewhere(n) else if (dg_kind == DG_GOAL) lf_facts = true
}

// Whether the face held fits some part of the goal.
face_fits_somewhere(n: int) raises KernelError: bool {
    e: int = goal_real_e;
    if (e < 0) return false;
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        if (block_path_to_gf(b) && gs_face_wn(n) >= 0) return true
    }
    false
}

// Block b's path (in the goal as it really is) into gf_steps: from the
// paths kept as the goal was laid out (the printer's own are made afresh
// each time it writes, so they do not last past the frame).
block_path_to_gf(b: int): bool {
    e: int = goal_real_e;
    gf_n = 0;
    if (e < 0) return false;
    k: int = b - ex_box0[e];
    if (k < 0 || k >= gp_kn) return false;
    gf_n = gp_n[k];
    for i in 0..gf_n gf_steps[i] = gp_pool[gp_s0[k] + i];
    gf_n > 0
}

// The paths of the goal's blocks, kept when it is laid out.
gp_s0: []int = new int[1024](0);

gp_n: []int = new int[1024](0);

gp_pool: []int = new int[16384](0);

gp_kn: int = 0;

goal_paths_keep(e: int) {
    gp_kn = 0;
    if (e < 0) return;
    used: int = 0;
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        k: int = b - ex_box0[e];
        if (k < len(gp_n)) {
            block_steps(b);
            if (used + sub_n <= len(gp_pool)) {
                gp_s0[k] = used;
                gp_n[k] = sub_n;
                for i in 0..sub_n gp_pool[used + i] = sub_steps[i];
                used = used + sub_n
            } else gp_n[k] = 0;
            gp_kn = k + 1
        }
    }
}

// Whether help shows while a thing is held: at once in the first chapter,
// later only once it has been held still a while.
helping(): bool {
    lang_first() || now_t - dg_still_t > 1.2
}

// ---- where the thing held is over ----
const T_NONE: int = 0;

const T_GOAL: int = 1;

const T_FACT: int = 2;

// (A part of the goal: a face put onto it; hv_j its block in goal_real_e.)
const T_PART: int = 3;

// (A kit's tile: a name put into its hole; hv_j its item.)
const T_KIT: int = 4;

// (The facts: the goal put up among them.)
const T_FACTS: int = 5;

hv_kind: int = 0;

hv_j: int = -1;

// Whether it fits there, and what the place would become (the goal, a
// new fact; or it closes); whether a name is still wanted.
hv_fit: bool = false;

hv_goal: int = 0;

hv_fact: int = 0;

hv_closes: bool = false;

hv_wants: bool = false;

// (A part: the path the face goes to, kept.)
hv_steps: []int = new int[256](0);

hv_n: int = 0;

lang_drag(x: f32, y: f32) raises KernelError {
    if (!dg_on) return;
    if (frame_dt > 0.0) {
        dg_vx = lerpf(dg_vx, (x - dg_x) / frame_dt, 0.4);
        dg_vy = lerpf(dg_vy, (y - dg_y) / frame_dt, 0.4)
    }
    dg_x = x;
    dg_y = y;
    if (absf(x - dg_sx) + absf(y - dg_sy) > 10.0) {
        dg_sx = x;
        dg_sy = y;
        dg_still_t = now_t
    }
    busy = true;
    k: int = T_NONE;
    j: int = -1;
    ingoal: bool = x >= goal_rx && x <= goal_rx + goal_rw && y >= goal_ry - 6.0 && y <= goal_ry + goal_rh + 6.0;
    if (dg_kind == DG_GOAL) {
        // (Up among the facts, well clear of the goal.)
        if (y < goal_ry - 40.0) k = T_FACTS
    } else if (dg_kind == DG_FACE) {
        if (ingoal) {
            k = T_GOAL;
            b: int = part_under(x, y);
            if (b >= 0) {
                k = T_PART;
                j = b
            }
        }
    } else if (ingoal) k = T_GOAL else {
        for i in 0..bf_n {
            if (x >= bf_x0[i] && x <= bf_x1[i] && y >= bf_y0[i] - 3.0 && y <= bf_y1[i] + 3.0 && !(dg_kind == DG_FACT && i == dg_src)) {
                k = T_FACT;
                j = i
            }
        }
        if (dg_kind == DG_TOKEN) {
            for i in 0..si_n {
                if (si_kind[i] == SI_KIT && x >= si_x0[i] - 4.0 && x <= si_x1[i] + 4.0 && y >= si_y0[i] - 6.0 && y <= si_y1[i] + 6.0) {
                    k = T_KIT;
                    j = i
                }
            }
        }
    }
    if (k == hv_kind && j == hv_j) return;
    was: bool = hv_fit && (hv_kind == T_GOAL || hv_kind == T_PART || hv_kind == T_FACTS);
    hv_kind = k;
    hv_j = j;
    hover_read();
    // (The goal shown afresh: its writing crossfades, not flying about.)
    now_fit: bool = hv_fit && (hv_kind == T_GOAL || hv_kind == T_PART || hv_kind == T_FACTS);
    if (was || now_fit) {
        goal_gen = goal_gen + 1;
        quick_t = now_t + 0.25
    }
    if (hv_fit && hv_kind == T_FACT) {
        fact_gen = fact_gen + 1;
        quick_t = now_t + 0.25
    }
}

// The block of the goal (as it really is) a face held at (x, y) fits:
// the deepest under the finger it fits, else the one round it; -1 none.
part_under(x: f32, y: f32) raises KernelError: int {
    e: int = goal_real_e;
    n: int = play_node();
    if (e < 0 || n < 0) return -1;
    b: int = block_at(e, x, y);
    while (b >= 0) {
        if (block_path_to_gf(b) && gs_face_wn(n) >= 0) return b;
        b = bx_parent[b]
    }
    -1
}

// What the place under the thing held would become.
hover_read() raises KernelError {
    hv_fit = false;
    hv_goal = 0;
    hv_fact = 0;
    hv_closes = false;
    hv_wants = false;
    n: int = play_node();
    if (n < 0 || hv_kind == T_NONE) return;
    sig: int = 0;
    if (dg_kind == DG_TOKEN) {
        if (hv_kind == T_KIT) {
            hv_fit = kit_takes(hv_j, dg_term);
            return
        }
        if (hv_kind == T_GOAL && ps_on) sig = ps_try(n, dg_term) else if (hv_kind == T_GOAL) sig = gs_try(n,
            GS_NOTCH, -1, dg_term) else sig = gs_try(n, GS_NOTCH, hv_j, dg_term)
    } else if (dg_kind == DG_FACT) {
        if (hv_kind != T_GOAL) return;
        wn: int = gs_apply_wn(n, dg_src);
        if (wn == 0) sig = gs_try(n, GS_APPLY, dg_src, 0) else if (wn == 1) {
            hv_fit = true;
            hv_wants = true;
            return
        }
    } else if (dg_kind == DG_LEMMA) {
        if (hv_kind != T_GOAL) return;
        sig = gs_try(n, GS_LEMMA, gf_l, 0)
    } else if (dg_kind == DG_FACE) {
        if (hv_kind != T_PART) return;
        block_path_to_gf(hv_j);
        hv_n = gf_n;
        for i in 0..gf_n hv_steps[i] = gf_steps[i];
        wn: int = gs_face_wn(n);
        t: int = 0;
        if (wn == 1) {
            t = gs_hole(n);
            hv_wants = true
        }
        sig = gs_try(n, GS_FACE, -1, t)
    } else if (dg_kind == DG_GOAL) {
        if (hv_kind != T_FACTS) return;
        sig = gs_try(n, GS_SUPPOSE, -1, 0)
    }
    if (sig == 0) return;
    hv_fit = true;
    hv_closes = gt_closes && !hv_wants;
    hv_goal = gt_goal;
    hv_fact = gt_fact
}

// Whether the goal (j < 0) or fact j shows what it would become now.
lang_previewing(j: int): bool {
    if (!dg_on || !hv_fit) return ps_on && ps_goal != 0 && j < 0;
    if (j < 0) return hv_kind == T_GOAL || hv_kind == T_PART;
    hv_kind == T_FACT && hv_j == j
}

// Whether the goal shows gold, the thing held closing it.
lang_goal_gold(): bool {
    dg_on && hv_fit && hv_closes && hv_kind != T_KIT
}

// The term the goal shows (a preview, or gc).
lang_goal_term(gc: int): int {
    if (dg_on && hv_fit && (hv_kind == T_GOAL || hv_kind == T_PART) && !hv_closes && hv_goal != 0) return hv_goal;
    if (ps_on && ps_goal != 0 && !(dg_on && hv_fit)) return ps_goal;
    gc
}

lang_fact_term(j: int, h: int): int {
    if (lang_previewing(j) && hv_fact != 0) return hv_fact;
    h
}

// The generations of the goal's and facts' writing (a preview is new
// writing, crossfaded in), and until when writing comes in quickly.
goal_gen: int = 0;

fact_gen: int = 0;

quick_t: f32 = -10.0;

// The thing held let go.
lang_drop(x: f32, y: f32) raises KernelError {
    if (!dg_on) return;
    lang_drag(x, y);
    dg_on = false;
    last_input_t = now_t;
    n: int = play_node();
    hx: f32 = x - dg_ox;
    hy: f32 = y - dg_oy;
    if (hv_fit && n >= 0) {
        if (dg_kind == DG_TOKEN) {
            if (hv_kind == T_KIT) {
                kit_put(hv_j, dg_term);
                hv_kind = T_NONE;
                return
            }
            if (hv_kind == T_GOAL && ps_on) {
                ps_fill(dg_term, hx, hy);
                return
            }
            lang_gesture(GS_NOTCH, hv_j, dg_term, hx, hy);
            return
        }
        if (dg_kind == DG_FACT) {
            if (hv_wants) {
                // (It fits, once a name is dropped in: the goal waits for it.)
                ps_begin(GS_APPLY, dg_src, 0);
                return
            }
            lang_gesture(GS_APPLY, dg_src, 0, hx, hy);
            return
        }
        if (dg_kind == DG_LEMMA) {
            lang_gesture(GS_LEMMA, gf_l, 0, hx, hy);
            return
        }
        if (dg_kind == DG_FACE) {
            gf_n = hv_n;
            for i in 0..hv_n gf_steps[i] = hv_steps[i];
            face_setup_keep();
            if (hv_wants) {
                ps_begin(GS_FACE, -1, hv_goal);
                return
            }
            lang_gesture(GS_FACE, -1, 0, hx, hy);
            return
        }
        if (dg_kind == DG_GOAL) {
            lang_gesture(GS_SUPPOSE, -1, 0, hx, hy);
            return
        }
    }
    // (It does not fit: home it goes, and the place shakes no.)
    if (hv_kind != T_NONE) {
        why: int = 1;
        if (dg_kind == DG_FACT && hv_kind == T_FACT && hv_j >= 0 && hv_j < BF && bfn_ok[hv_j]) why = 3;
        if (dg_kind == DG_FACE && hv_kind == T_GOAL) why = 1;
        if (dg_kind == DG_TOKEN && hv_kind == T_KIT) why = 2;
        sk: int = hv_kind;
        if (sk == T_PART) sk = T_GOAL;
        refuse(sk, hv_j, why)
    }
    rb_kind = dg_kind;
    rb_src = dg_src;
    rb_item = dg_item;
    rb_face = dg_face;
    rb_term = dg_term;
    rb_x0 = hx;
    rb_y0 = hy;
    rb_w = dg_w;
    rb_h = dg_h;
    rb_t0 = now_t;
    if (hv_kind != T_NONE) goal_gen = goal_gen + 1;
    hv_kind = T_NONE
}

// (The face's tile as gripped, again: the hover read may have changed gf_.)
face_setup_keep() {
    gf_back = dg_face == 1;
    if (dg_item >= 0) {
        gf_l = si_term[dg_item];
        gf_j = -1
    } else {
        gf_l = -1;
        gf_j = dg_src
    }
}

// ---- a name still wanted: a socket on the goal ----
// (A fact put onto the goal that needs a name; a face that grows, e to
// □⁻¹ · □.) The goal shows what it will be with a pulsing slot; a name
// dropped onto the goal, or tapped on the shelf, fills it.
ps_on: bool = false;

ps_kind: int = 0;

ps_j: int = 0;

ps_t0: f32 = 0.0;

// (What the goal shows meanwhile; a face's tile and part.)
ps_goal: int = 0;

ps_l: int = -1;

ps_fj: int = -1;

ps_back: bool = false;

pe_steps: []int = new int[256](0);

pe_n: int = 0;

ps_begin(kind: int, j: int, goal: int) {
    ps_on = true;
    ps_kind = kind;
    ps_j = j;
    ps_t0 = now_t;
    ps_goal = goal;
    ps_l = gf_l;
    ps_fj = gf_j;
    ps_back = gf_back;
    pe_n = gf_n;
    for i in 0..gf_n pe_steps[i] = gf_steps[i];
    hv_kind = T_NONE;
    page_vibrate(6)
}

ps_restore() {
    gf_l = ps_l;
    gf_j = ps_fj;
    gf_back = ps_back;
    gf_n = pe_n;
    for i in 0..pe_n gf_steps[i] = pe_steps[i]
}

ps_try(n: int, t: int) raises KernelError: int {
    if (ps_kind == GS_FACE) ps_restore();
    gs_try(n, ps_kind, ps_j, t)
}

// The socket filled with name t (from (fx, fy)).
ps_fill(t: int, fx: f32, fy: f32) raises KernelError {
    if (!ps_on) return;
    if (ps_kind == GS_FACE) ps_restore();
    ps_on = false;
    ps_goal = 0;
    lang_gesture(ps_kind, ps_j, t, fx, fy)
}

ps_cancel() {
    if (!ps_on) return;
    ps_on = false;
    ps_goal = 0;
    goal_gen = goal_gen + 1
}

// ---- the kit: names made ----
// Whether name t can go into kit tile k's next hole.
kit_takes(k: int, t: int): bool {
    if (k < 0 || k >= si_n || si_kind[k] != SI_KIT) return false;
    kit: int = si_term[k];
    vars_n = 0;
    collect_vars(kit);
    i: int = 0;
    if (k == kf_item) i = kf_n;
    if (i >= vars_n) return false;
    match_clear();
    // (Its type fits; one taken with a lower bound (n) builds nothing new.)
    match_type(tm_type(vars[i]), tm_type(t))
}

// Name t put into kit tile k: its hole filled; all filled, the name it
// makes pops onto the shelf.
kit_put(k: int, t: int) {
    if (!kit_takes(k, t)) return;
    if (kf_item != k) {
        kf_item = k;
        kf_n = 0
    }
    kf_t[kf_n] = t;
    kf_n = kf_n + 1;
    kit: int = si_term[k];
    vars_n = 0;
    collect_vars(kit);
    page_vibrate(6);
    if (kf_n < vars_n) return;
    made: int = 0;
    v1: int = 0;
    t1: int = 0;
    if (vars_n > 1) {
        v1 = vars[1];
        t1 = kf_t[1]
    }
    try {
        match_clear();
        if (match_type(tm_type(vars[0]), tm_type(kf_t[0])) && (v1 == 0 || match_type(tm_type(v1),
            tm_type(t1)))) made = match_subst_terms(kit, vars[0], kf_t[0], v1, t1)
    } with KernelError -> {
        made = 0
    }
    kf_item = -1;
    kf_n = 0;
    if (made == 0) return;
    for i in 0..made_n {
        if (made_term[i] == made) return
    }
    if (made_n >= len(made_term)) {
        for i in 1..made_n made_term[i - 1] = made_term[i];
        made_n = made_n - 1
    }
    made_term[made_n] = made;
    made_n = made_n + 1
}

// ---- going home, shaking no ----
rb_t0: f32 = -10.0;

rb_kind: int = 0;

rb_src: int = 0;

rb_item: int = -1;

rb_face: int = 0;

rb_term: int = 0;

rb_x0: f32 = 0.0;

rb_y0: f32 = 0.0;

rb_w: f32 = 0.0;

rb_h: f32 = 0.0;

const RB_TIME: f32 = 0.5;

rb_on(): bool {
    now_t - rb_t0 < RB_TIME
}

// The place shaking (T_GOAL, or T_FACT and its number, T_KIT and its
// item), since when.
sk_kind: int = 0;

sk_j: int = 0;

sk_t0: f32 = -10.0;

const SHAKE_TIME: f32 = 0.5;

// The words under it the second time (and why: 1 the shapes differ, 2 not
// a name here, 3 that wants a name, not a statement).
wh_t0: f32 = -10.0;

wh_why: int = 0;

rf_last: int = 0;

rf_count: int = 0;

refuse(kind: int, j: int, why: int) {
    sk_kind = kind;
    sk_j = j;
    sk_t0 = now_t;
    page_vibrate(4);
    page_tone();
    key: int = kind * 100000 + j * 1000 + dg_kind * 100 + dg_src + dg_item * 7;
    if (key == rf_last) rf_count = rf_count + 1 else {
        rf_last = key;
        rf_count = 1
    }
    if (rf_count >= 2) {
        wh_t0 = now_t;
        wh_why = why
    }
}

// On a page, a soft low tone (the page plays it).
page_tone() {
    if (on_page) {
        line_clear();
        line_add("@tone low");
        line_print_safe()
    }
}

// How far the goal, fact j, or kit item j is shaken now: no, three times.
shake_dx(kind: int, j: int): f32 {
    t: f32 = now_t - sk_t0;
    if (t < 0.0 || t > SHAKE_TIME || kind != sk_kind || kind != T_GOAL && j != sk_j) return 0.0;
    busy = true;
    7.0 * sinf(t / SHAKE_TIME * 3.0 * 6.2832) * (1.0 - t / SHAKE_TIME)
}

// How the goal (j < 0) or fact j swells toward the thing held over it.
pull_dx(kind: int, j: int, cx: f32): f32 {
    if (!dg_on || !hv_fit) return 0.0;
    k: int = hv_kind;
    if (k == T_PART) k = T_GOAL;
    if (k != kind || kind == T_FACT && hv_j != j) return 0.0;
    clampf((dg_x - cx) * 0.03, -6.0, 6.0)
}

// ---- a tap on a thing that moves: it shows that it moves ----
// (A card lifts and leans toward where it fits, a name bobs toward it,
// and they settle back. Not a menu: the object showing it moves.)
nd_kind: int = 0;

nd_src: int = -1;

nd_t0: f32 = -10.0;

nd_tx: f32 = 0.0;

nd_ty: f32 = 0.0;

const ND_TIME: f32 = 0.7;

nd_on(kind: int, src: int): bool {
    nd_kind == kind && nd_src == src && now_t - nd_t0 < ND_TIME
}

nd_k(): f32 {
    t: f32 = (now_t - nd_t0) / ND_TIME;
    busy = true;
    // (Out, a little past, and back.)
    sinf(clampf(t, 0.0, 1.0) * 3.1416) * (1.0 + 0.25 * sinf(t * 9.0))
}

nd_dx(): f32 {
    nd_tx * nd_k()
}

nd_dy(): f32 {
    nd_ty * nd_k() - 6.0 * nd_k()
}

// The thing under a tap nudged toward a place it fits.
lang_nudge() raises KernelError {
    if (gr_kind != DG_TOKEN && gr_kind != DG_FACT) return;
    n: int = play_node();
    if (n < 0) return;
    sx: f32 = 0.0;
    sy: f32 = 0.0;
    if (gr_kind == DG_TOKEN) {
        sx = shn_x[gr_src];
        sy = shn_y[gr_src]
    } else {
        sx = (bf_x0[gr_src] + bf_x1[gr_src]) * 0.5;
        sy = (bf_y0[gr_src] + bf_y1[gr_src]) * 0.5
    }
    tx: f32 = sx;
    ty: f32 = sy - 30.0;
    found: bool = false;
    if (gr_kind == DG_TOKEN) {
        t: int = shn_term[gr_src];
        if (gs_has_notch(n, -1) && gs_try(n, GS_NOTCH, -1, t) != 0 && gn_ok) {
            tx = (gn_x0 + gn_x1) * 0.5;
            ty = (gn_y0 + gn_y1) * 0.5;
            found = true
        }
        for i in 0..bf_n {
            if (!found && i < BF && bfn_ok[i] && gs_try(n, GS_NOTCH, i, t) != 0) {
                tx = (bfn_x0[i] + bfn_x1[i]) * 0.5;
                ty = (bfn_y0[i] + bfn_y1[i]) * 0.5;
                found = true
            }
        }
    } else if (gs_apply_wn(n, gr_src) >= 0) {
        tx = goal_rx + goal_rw * 0.5;
        ty = goal_ry + goal_rh * 0.5;
        found = true
    }
    dx: f32 = tx - sx;
    dy: f32 = ty - sy;
    d: f32 = sqrtf(dx * dx + dy * dy);
    reach: f32 = 30.0;
    if (!found) reach = 8.0;
    if (d < 1.0) d = 1.0;
    nd_kind = gr_kind;
    nd_src = gr_src;
    nd_t0 = now_t;
    nd_tx = dx / d * reach;
    nd_ty = dy / d * reach
}

// How far fact i is nudged now.
fact_nudge_x(i: int): f32 {
    if (!nd_on(DG_FACT, i)) return 0.0;
    nd_dx()
}

fact_nudge_y(i: int): f32 {
    if (!nd_on(DG_FACT, i)) return 0.0;
    nd_dy()
}

// ---- the goal swiped sideways: flipped ----
sw_on: bool = false;

sw_x0: f32 = 0.0;

sw_dx: f32 = 0.0;

sw_t0: f32 = -10.0;

lang_swipe_begin(x: f32) {
    sw_on = true;
    sw_x0 = x;
    sw_dx = 0.0
}

lang_swipe_move(x: f32) {
    if (!sw_on) return;
    sw_dx = x - sw_x0;
    busy = true
}

lang_swipe_end(x: f32) raises KernelError {
    if (!sw_on) return;
    sw_on = false;
    d: f32 = x - sw_x0;
    sw_t0 = now_t;
    sw_from = sw_dx;
    sw_dx = 0.0;
    if (absf(d) < 50.0) return;
    last_input_t = now_t;
    n: int = play_node();
    if (n < 0) return;
    if (!is_binary(rel_core(gl_concl[pn_goal[n]]), role_name[ROLE_EQ])) {
        refuse(T_GOAL, -1, 1);
        return
    }
    lang_gesture(GS_FLIP, -1, 0, goal_rx + 20.0, goal_ry)
}

sw_from: f32 = 0.0;

// How far the goal card is moved by a swipe (following the finger, then
// springing back).
goal_swipe_dx(): f32 {
    if (sw_on) return sw_dx * 0.6;
    t: f32 = (now_t - sw_t0) / 0.3;
    if (t >= 1.0) return 0.0;
    busy = true;
    sw_from * 0.6 * (1.0 - t) * (1.0 - t)
}

// ---- making a gesture ----
// A gesture made by the player (the thing came from (fx, fy)).
lang_gesture(
    kind: int,
    j: int,
    t: int,
    fx: f32,
    fy: f32
) raises KernelError {
    n: int = play_node();
    if (n < 0 || done_t >= 0.0) return;
    if (staging()) close_t = now_t;
    // (Whether it is the book's next: what that would give.)
    want: int = 0;
    if (on_path == moves_made) want = book_sig(moves_made, n);
    // (The gesture's own tile and part, kept: the book's may have changed
    // them.)
    if (kind == GS_FACE) face_restore();
    old_goal: int = pn_goal[n];
    if (j >= 0 && j < gl_hypn[old_goal] && kind != GS_LEMMA) use_fact(goal_hyp(old_goal,
        j));
    if (kind == GS_FACE && gf_j >= 0 && gf_j < gl_hypn[old_goal]) use_fact(goal_hyp(old_goal,
        gf_j));
    leaves_before = leaves_done();
    ok: bool = false;
    try {
        ok = gs_do(n, kind, j, t)
    } with KernelError -> {
        ok = false
    }
    if (!ok) {
        refuse(T_GOAL, -1, 1);
        return
    }
    c: int = gs_c;
    last_rewrite = kind == GS_FACE || kind == GS_FLIP;
    fly_term = gs_new_fact(n, old_goal);
    fly_fact = fly_term != 0;
    fly_hl = 0;
    fly_hl_seen = false;
    fly_x0 = fx;
    fly_y0 = fy;
    fly_s0 = 18.0;
    path_toast_end();
    demo_end();
    lh_on = false;
    ps_on = false;
    ps_goal = 0;
    if (c >= 0) trial_read(n, c);
    if (want != 0 && gs_sig(n) == want) on_path = moves_made + 1;
    moves_made = moves_made + 1;
    after_move(n, old_goal);
    lang_settle()
}

// A face gesture's tile and part, kept while the book is read.
fk_l: int = -1;

fk_j: int = -1;

fk_back: bool = false;

fk_steps: []int = new int[256](0);

fk_n: int = 0;

face_keep() {
    fk_l = gf_l;
    fk_j = gf_j;
    fk_back = gf_back;
    fk_n = gf_n;
    for i in 0..gf_n fk_steps[i] = gf_steps[i]
}

face_restore() {
    gf_l = fk_l;
    gf_j = fk_j;
    gf_back = fk_back;
    gf_n = fk_n;
    for i in 0..fk_n gf_steps[i] = fk_steps[i]
}

// What the book's step k would leave at node n (a fingerprint), or 0. The
// gesture's tile and part are kept round it.
book_sig(k: int, n: int) raises KernelError: int {
    face_keep();
    r: int = 0;
    if (book_gesture(k, n)) r = gs_try(n, bg_kind, bg_j, bg_t);
    face_restore();
    r
}

// After a move or an undo: whether the goal now can be shown at all.
dead_node: int = -1;

dead_t: f32 = -10.0;

lang_settle() {
    boxes_at = now_t + 0.9;
    dead_node = -1;
    n: int = play_node();
    if (n < 0 || on_path >= moves_made || done_t >= 0.0) return;
    r: int = -1;
    if (lang_first()) {
        par: int = 4;
        if (playing >= 0) par = ml_par[playing];
        try {
            r = gs_dead(n, par + 3, 3000)
        } with KernelError -> {
            r = -1
        }
    } else if (region_calc) {
        // (Limits: a comparison of whole numbers (N₁ ≤ n), or the side
        // condition a use left (A > 0), that arithmetic did not close.)
        if (goal_dead(n)) r = 1
    }
    if (r == 1) {
        dead_node = n;
        dead_t = now_t;
        undo_pulse_t = now_t
    }
}

lang_dead(): bool {
    dead_node >= 0 && dead_node == play_node() && done_t < 0.0
}

// When the player came back from a dead end (the keys breathe at once).
breathe_t: f32 = -10.0;

lang_undone() {
    if (dead_node >= 0) breathe_t = now_t;
    ps_cancel();
    lh_on = false;
    lang_settle()
}

// A key tapped (the goal's, j < 0, or fact j's).
lang_key(j: int) raises KernelError {
    if (!lang_on() || done_t >= 0.0) return;
    last_input_t = now_t;
    ps_cancel();
    fx: f32 = gk_x0;
    fy: f32 = gk_y0;
    if (j >= 0 && j < BF) {
        fx = bfk_x0[j];
        fy = bfk_y0[j]
    }
    lang_gesture(GS_KEY, j, 0, fx, fy)
}

// A name tapped on the shelf: if a socket waits, it fills it; else it
// bobs toward where it fits.
lang_token_tap(k: int) raises KernelError {
    if (k < 0 || k >= shn_n) return;
    last_input_t = now_t;
    if (!ps_on) {
        gr_kind = DG_TOKEN;
        gr_src = k;
        lang_nudge();
        return
    }
    ps_fill(shn_term[k], shn_x[k], shn_y[k])
}

// ---- the book's next gesture: a hint, Watch, Enter ----
// The hint showing: the gesture the ghost hand makes.
lh_on: bool = false;

lh_t: f32 = -10.0;

lh_kind: int = 0;

lh_j: int = -1;

lh_tok: int = 0;

// (A face's tile and part, for the ghost.)
lh_l: int = -1;

lh_fj: int = -1;

lh_back: bool = false;

lh_steps: []int = new int[256](0);

lh_n: int = 0;

lang_hint() raises KernelError: bool {
    n: int = focus_node();
    if (n < 0) return false;
    chosen_node = n;
    if (!book_gesture(moves_made, n)) return false;
    lh_kind = bg_kind;
    lh_j = bg_j;
    lh_tok = bg_t;
    lh_l = gf_l;
    lh_fj = gf_j;
    lh_back = gf_back;
    lh_n = gf_n;
    for i in 0..gf_n lh_steps[i] = gf_steps[i];
    lh_on = true;
    lh_t = now_t;
    true
}

lh_restore() {
    gf_l = lh_l;
    gf_j = lh_fj;
    gf_back = lh_back;
    gf_n = lh_n;
    for i in 0..lh_n gf_steps[i] = lh_steps[i]
}

// The bulb tapped.
lang_give_hint() raises KernelError {
    if (done_t >= 0.0 || watching) return;
    last_input_t = now_t;
    demo_end();
    if (on_path < moves_made) {
        line_clear();
        line_add("Undo ");
        line_int(moves_made - on_path);
        line_add(" to get back on the book's path");
        toast_line();
        undo_pulse_t = now_t;
        path_toast = true;
        return
    }
    if (!lang_hint()) toast("No hint here")
}

// Enter: the hinted gesture made (the book's next if none is hinted); a
// dead end undone.
lang_enter() raises KernelError {
    if (lang_dead()) {
        act(B_DEAD_UNDO);
        return
    }
    if (on_path < moves_made) {
        lang_give_hint();
        return
    }
    if (!lh_on && !lang_hint()) return;
    lh_on = false;
    lang_book_move()
}

// The book's next gesture made at once (as a hint shows it).
lang_book_move() raises KernelError {
    n: int = focus_node();
    if (n < 0 || !book_gesture(moves_made, n)) return;
    chosen_node = n;
    ps_cancel();
    fx: f32 = goal_rx + 20.0;
    fy: f32 = goal_ry;
    for k in 0..shn_n {
        if (shn_term[k] == bg_t && bg_t != 0) {
            fx = shn_x[k] - TOK_R;
            fy = shn_y[k] - TOK_R
        }
    }
    face_keep();
    lang_gesture(bg_kind, bg_j, bg_t, fx, fy)
}

// ---- the ghost hand: a puppet finger ----
// Watch, the first-time demos and L8_DO make gestures as a finger would:
// the puppet comes down, carries the thing over the board (every frame, so
// the places it passes show what they would become) and lets go; a key is
// pressed and let go. The ghost hand is drawn where the puppet is.
const PP_B: int = 9;

pp_on: bool = false;

pp_drag: bool = false;

pp_x0: f32 = 0.0;

pp_y0: f32 = 0.0;

pp_x1: f32 = 0.0;

pp_y1: f32 = 0.0;

pp_ms: f32 = 600.0;

pp_hold: bool = false;

pp_t0: f32 = 0.0;

pp_x: f32 = 0.0;

pp_y: f32 = 0.0;

// Whether the puppet's finger is making the touch events now.
pp_driving: bool = false;

// Whether the ghost hand is drawn for it.
pp_ghost: bool = false;

pp_tap(x: f32, y: f32, ghost: bool) {
    pp_on = true;
    pp_drag = false;
    pp_x0 = x;
    pp_y0 = y;
    pp_x = x;
    pp_y = y;
    pp_t0 = now_t;
    pp_hold = false;
    pp_ghost = ghost
}

pp_carry(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    ms: f32,
    hold: bool,
    ghost: bool
) {
    pp_on = true;
    pp_drag = true;
    pp_x0 = x0;
    pp_y0 = y0;
    pp_x1 = x1;
    pp_y1 = y1;
    pp_x = x0;
    pp_y = y0;
    pp_ms = ms;
    pp_hold = hold;
    pp_t0 = now_t;
    pp_ghost = ghost;
    pp_down = false
}

pp_down: bool = false;

// Each frame: the puppet's finger moved. Whether it is done.
pp_step() raises KernelError: bool {
    if (!pp_on) return true;
    busy = true;
    t: f32 = now_t - pp_t0;
    pp_driving = true;
    if (!pp_drag) {
        // (Comes down a moment before: the key presses, then lets go.)
        if (t >= 0.25 && !pp_down) {
            finger_down(PP_B, pp_x0, pp_y0);
            pp_down = true
        }
        if (t >= 0.45 && pp_down) {
            finger_up(PP_B, pp_x0, pp_y0);
            pp_down = false;
            pp_on = false
        }
        pp_driving = false;
        return !pp_on
    }
    if (!pp_down) {
        finger_down(PP_B, pp_x0, pp_y0);
        pp_down = true
    }
    if (t < 0.18) {
        pp_driving = false;
        return false
    }
    f: f32 = clampf((t - 0.18) / maxf(pp_ms / 1000.0, 0.05), 0.0, 1.0);
    k: f32 = f * f * (3.0 - 2.0 * f);
    pp_x = pp_x0 + (pp_x1 - pp_x0) * k;
    pp_y = pp_y0 + (pp_y1 - pp_y0) * k - sinf(k * 3.1416) * 18.0;
    finger_move(1 << 7 + PP_B, pp_x, pp_y);
    if (f < 1.0 || pp_hold || t < 0.18 + pp_ms / 1000.0 + 0.2) {
        pp_driving = false;
        return false
    }
    finger_up(PP_B, pp_x, pp_y);
    pp_down = false;
    pp_on = false;
    pp_driving = false;
    true
}

// The puppet let go of at once (the player took over).
pp_cancel() {
    if (pp_down && g_finger == PP_B) {
        g_finger = -1;
        g_mode = G_NONE;
        dg_on = false;
        sw_on = false;
        hv_kind = T_NONE
    }
    pp_on = false;
    pp_down = false;
    pp_driving = false
}

// ---- a gesture as a finger makes it: where from, where to ----
// The places of gesture (kind, j, t; a face's in gf_) on the board now:
// a tap (ga_tap) at (ga_x0, ga_y0), or a carry to (ga_x1, ga_y1). A name
// not on the shelf yet (ε / 2) is first made on the kit: ga_kit is the
// carry that puts the next name into its tile. Whether it can be found.
ga_tap: bool = false;

ga_x0: f32 = 0.0;

ga_y0: f32 = 0.0;

ga_x1: f32 = 0.0;

ga_y1: f32 = 0.0;

// (Its socket filled after: the name, else 0.)
ga_fill: int = 0;

gesture_at(kind: int, j: int, t: int): bool {
    ga_tap = false;
    ga_fill = 0;
    if (kind == GS_KEY) {
        ga_tap = true;
        if (j < 0 && gk_ok) {
            ga_x0 = (gk_x0 + gk_x1) * 0.5;
            ga_y0 = (gk_y0 + gk_y1) * 0.5;
            return true
        }
        if (j >= 0 && j < bf_n && bfk_ok[j]) {
            ga_x0 = (bfk_x0[j] + bfk_x1[j]) * 0.5;
            ga_y0 = (bfk_y0[j] + bfk_y1[j]) * 0.5;
            return true
        }
        return false
    }
    if (kind == GS_NOTCH) {
        if (!token_at(t)) return kit_step_at(t);
        if (j < 0) {
            ga_x1 = goal_rx + goal_rw * 0.5;
            ga_y1 = goal_ry + goal_rh * 0.5;
            if (gn_ok) {
                ga_x1 = (gn_x0 + gn_x1) * 0.5;
                ga_y1 = (gn_y0 + gn_y1) * 0.5
            }
            return true
        }
        if (j >= bf_n) return false;
        ga_x1 = bf_x0[j] + 60.0;
        ga_y1 = (bf_y0[j] + bf_y1[j]) * 0.5;
        if (j < BF && bfn_ok[j]) {
            ga_x1 = (bfn_x0[j] + bfn_x1[j]) * 0.5;
            ga_y1 = (bfn_y0[j] + bfn_y1[j]) * 0.5
        }
        return true
    }
    if (kind == GS_APPLY) {
        if (j < 0 || j >= bf_n) return false;
        ga_x0 = bf_x0[j] + minf(60.0, (bf_x1[j] - bf_x0[j]) * 0.3);
        ga_y0 = (bf_y0[j] + bf_y1[j]) * 0.5;
        ga_x1 = goal_rx + goal_rw * 0.5;
        ga_y1 = goal_ry + goal_rh * 0.5;
        ga_fill = t;
        return true
    }
    if (kind == GS_FACE) {
        // (From the face on its tile, or on its fact.)
        found: bool = false;
        if (gf_l >= 0) {
            for k in 0..si_n {
                if (si_kind[k] == SI_RULE && si_term[k] == gf_l) {
                    ga_x0 = si_x0[k] + si_seam[k] * 0.5;
                    if (gf_back) ga_x0 = (si_x0[k] + si_seam[k] + si_x1[k]) * 0.5;
                    ga_y0 = (si_y0[k] + si_y1[k]) * 0.5;
                    found = true
                }
            }
        } else if (gf_j >= 0 && gf_j < bf_n && bf_seam[gf_j] > 0.0) {
            ga_x0 = (bf_x0[gf_j] + bf_seam[gf_j]) * 0.5;
            if (gf_back) ga_x0 = (bf_seam[gf_j] + bf_x1[gf_j]) * 0.5;
            ga_y0 = (bf_y0[gf_j] + bf_y1[gf_j]) * 0.5;
            found = true
        }
        if (!found || !part_at()) return false;
        ga_fill = t;
        return true
    }
    if (kind == GS_LEMMA) {
        for k in 0..si_n {
            if (si_kind[k] == SI_LEMMA && si_term[k] == j) {
                ga_x0 = (si_x0[k] + si_x1[k]) * 0.5;
                ga_y0 = (si_y0[k] + si_y1[k]) * 0.5;
                ga_x1 = goal_rx + goal_rw * 0.5;
                ga_y1 = goal_ry + goal_rh * 0.5;
                return true
            }
        }
        return false
    }
    if (kind == GS_FLIP) {
        ga_x0 = goal_rx + goal_rw * 0.3;
        ga_y0 = goal_ry + goal_rh * 0.5;
        ga_x1 = ga_x0 + 150.0;
        ga_y1 = ga_y0;
        return true
    }
    if (kind == GS_SUPPOSE) {
        ga_x0 = goal_rx + goal_rw * 0.5;
        ga_y0 = goal_ry + goal_rh * 0.5;
        ga_x1 = ga_x0;
        ga_y1 = maxf(goal_ry - 150.0, bar_bottom_y + 80.0);
        return true
    }
    false
}

// Name t on the shelf: where it starts from (ga_x0, ga_y0).
token_at(t: int): bool {
    for k in 0..shn_n {
        if (shn_term[k] == t) {
            ga_x0 = shn_x[k];
            ga_y0 = shn_y[k];
            return true
        }
    }
    false
}

// Name t, not on the shelf, is made on a kit tile: the next of its holes'
// names carried into the tile.
kit_step_at(t: int): bool {
    for k in 0..si_n {
        if (si_kind[k] == SI_KIT) {
            kit: int = si_term[k];
            match_clear();
            if (match_term(kit, t)) {
                vars_n = 0;
                collect_vars(kit);
                i: int = 0;
                if (kf_item == k) i = kf_n;
                if (i < vars_n) {
                    v: int = match_val(vars[i]);
                    if (v != 0 && token_at(v)) {
                        ga_x1 = (si_x0[k] + si_x1[k]) * 0.5;
                        ga_y1 = (si_y0[k] + si_y1[k]) * 0.5;
                        ga_kit = true;
                        return true
                    }
                }
            }
        }
    }
    false
}

ga_kit: bool = false;

// The part of the goal at gf_steps: its middle (ga_x1, ga_y1).
part_at(): bool {
    e: int = goal_real_e;
    if (e < 0) return false;
    want_n: int = gf_n;
    for i in 0..gf_n want_steps[i] = gf_steps[i];
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        same: bool = block_path_to_gf(b) && gf_n == want_n;
        if (same) {
            for i in 0..want_n {
                if (gf_steps[i] != want_steps[i]) same = false
            }
        }
        gf_n = want_n;
        for i in 0..want_n gf_steps[i] = want_steps[i];
        if (same) {
            ga_x1 = ex_ox[e] + (bx_x0[b] + bx_x1[b]) * 0.5;
            ga_y1 = ex_oy[e] + (bx_y0[b] + bx_y1[b]) * 0.5;
            return true
        }
    }
    false
}

want_steps: []int = new int[256](0);

// The socket's filling, as a carry: name t onto the goal.
fill_at(t: int): bool {
    if (!token_at(t)) return false;
    ga_tap = false;
    ga_x1 = goal_rx + goal_rw * 0.5;
    ga_y1 = goal_ry + goal_rh * 0.5;
    true
}

// ---- Watch and the demos: the book played by the ghost hand ----
// Each step of the book is played as gestures: its names made on the kit
// first, then the gesture, then a socket's name; each found on the board
// when it starts. wp_step: the book's step; wp_stage: 0 the gesture (or a
// kit's part of it), 1 its socket's name.
wp_on: bool = false;

wp_stage: int = 0;

wp_until: int = 0;

wp_wait_t: f32 = 0.0;

wp_fill: int = 0;

// Whether the carry going on is the step's gesture itself (not a kit's
// part of it, nor a socket's name).
wp_main: bool = false;

// (The demo's loops left; the book's steps it plays.)
wp_demo: bool = false;

wp_loops: int = 0;

wp_begin(until: int, demo: bool) {
    wp_on = true;
    wp_stage = 0;
    wp_until = until;
    wp_demo = demo;
    wp_wait_t = now_t + 0.6 * watch_pace;
    wp_fill = 0
}

wp_stop() {
    wp_on = false;
    pp_cancel()
}

// Each frame while it plays. Whether it is still playing.
wp_step() raises KernelError: bool {
    if (!wp_on) return false;
    busy = true;
    if (pp_on) {
        // (Where it goes is found again as it goes: the board settles
        // from the last gesture meanwhile.)
        if (pp_drag && wp_main && !pp_hold) {
            n0: int = focus_node();
            ga_kit = false;
            if (n0 >= 0 && book_gesture(moves_made, n0) && gesture_at(bg_kind, bg_j,
                bg_t) && !ga_tap && !ga_kit) {
                pp_x1 = ga_x1;
                pp_y1 = ga_y1
            }
        }
        if (pp_step()) wp_wait_t = now_t + 0.35 * watch_pace;
        return true
    }
    if (now_t < wp_wait_t) return true;
    // (Settled: a close still being staged plays out first.)
    if (staging()) return true;
    if (done_t >= 0.0 || moves_made >= wp_until || moves_made >= st_n) {
        wp_on = false;
        return false
    }
    n: int = focus_node();
    if (n < 0) {
        wp_on = false;
        return false
    }
    ms: f32 = 900.0 * watch_pace;
    if (wp_stage == 1 && ps_on) {
        if (fill_at(wp_fill)) {
            pp_carry(ga_x0, ga_y0, ga_x1, ga_y1, ms * 0.8, false, true);
            wp_main = false;
            wp_stage = 0;
            return true
        }
        ps_fill(wp_fill, ga_x0, ga_y0);
        wp_stage = 0;
        return true
    }
    wp_stage = 0;
    if (!book_gesture(moves_made, n)) {
        wp_on = false;
        return false
    }
    ga_kit = false;
    if (!gesture_at(bg_kind, bg_j, bg_t)) {
        // (Not to be found on the board: made at once.)
        lang_book_move();
        wp_wait_t = now_t + 0.5 * watch_pace;
        return true
    }
    if (ga_tap) pp_tap(ga_x0, ga_y0, true) else pp_carry(ga_x0, ga_y0, ga_x1, ga_y1,
        ms, false, true);
    wp_main = !ga_kit;
    // (A socket after: its name next.)
    if (!ga_kit && ga_fill != 0 && (bg_kind == GS_APPLY || bg_kind == GS_FACE)) {
        wp_fill = ga_fill;
        wp_stage = 1
    }
    true
}

// Watching: the book's steps played by the ghost hand.
lang_watch_step() raises KernelError {
    if (!wp_on && watch_phase == 0) {
        wp_begin(1000, false);
        watch_phase = 1
    }
    if (!wp_step()) {
        watch_phase = 0;
        watch_step = st_n;
        if (done_t >= 0.0) {
            watching = false;
            watch_done_t = maxf(now_t, done_t) + 1.4
        } else stop_watch()
    }
}

// ---- drawn over the board ----
// The thing held, the thing going home, the words of a refusal, and the
// ghost hand.
draw_lang_top(x: f32, w: f32) {
    if (dg_on) draw_held(dg_kind, dg_term, dg_x - dg_ox, dg_y - dg_oy, dg_w, dg_h,
        1.0, true);
    if (rb_on()) {
        t: f32 = (now_t - rb_t0) / RB_TIME;
        busy = true;
        hx: f32 = rb_x0;
        hy: f32 = rb_y0;
        if (rb_kind == DG_TOKEN && rb_src < shn_n) {
            hx = shn_x[rb_src] - rb_w * 0.5;
            hy = shn_y[rb_src] - TOK_R
        } else if (rb_kind == DG_FACT && rb_src < bf_n) {
            hx = bf_x0[rb_src];
            hy = bf_y0[rb_src]
        } else if (rb_item >= 0 && rb_item < si_n) {
            hx = si_x0[rb_item];
            hy = si_y0[rb_item]
        } else if (rb_kind == DG_FACE && rb_src < bf_n) {
            hx = bf_x0[rb_src];
            hy = bf_y0[rb_src]
        } else if (rb_kind == DG_GOAL) {
            hx = goal_rx + goal_rw * 0.5 - rb_w * 0.5;
            hy = goal_ry
        }
        // (Home, past it a little and back: a damped wobble.)
        k: f32 = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);
        k = k + sinf(t * 3.1416 * 3.0) * 0.1 * (1.0 - t);
        draw_held(rb_kind, rb_term, rb_x0 + (hx - rb_x0) * k, rb_y0 + (hy - rb_y0) * k,
            rb_w, rb_h, 1.0 - t * 0.3, false)
    }
    draw_whisper();
    draw_lang_ghost();
    if (pp_on && pp_ghost) draw_hand_at(pp_x, pp_y, 1.0, pp_down && !pp_drag || pp_down && pp_drag);
    draw_lang_demo_words(x, w);
    draw_pending()
}

// The ghost hand: a soft round fingertip at (x, y), pressed or not.
draw_hand_at(
    x: f32,
    y: f32,
    a: f32,
    down: bool
) {
    r: f32 = 17.0;
    if (down) r = 15.0;
    busy = true;
    p_shadow(x - r, y - r + 4.0, 2.0 * r, 2.0 * r, r, 3.0, 10.0, 0.22 * a);
    p_disc(x, y + 2.0, r, C_WHITE, 0.72 * a);
    p_ring(x, y + 2.0, r, 2.5, C_INK, 0.38 * a);
    if (down) p_ring(x, y + 2.0, r + 7.0, 2.0, C_WHITE, 0.5 * a)
}

// A thing held (or going home) with its top left at (x, y).
draw_held(
    kind: int,
    t: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    a: f32,
    lifted: bool
) {
    // (Lifted: bigger, its shadow deeper, squashed along how it moves.)
    sp: f32 = 0.0;
    if (lifted) sp = clampf(sqrtf(dg_vx * dg_vx + dg_vy * dg_vy) / 2400.0, 0.0, 0.12);
    sx: f32 = 1.0;
    sy: f32 = 1.0;
    if (lifted) {
        sx = 1.08;
        sy = 1.08;
        if (absf(dg_vx) > absf(dg_vy)) {
            sx = sx + sp;
            sy = sy - sp * 0.6
        } else {
            sy = sy + sp;
            sx = sx - sp * 0.6
        }
    }
    if (kind == DG_TOKEN) {
        cx: f32 = x + w * 0.5;
        cy: f32 = y + TOK_R;
        p_shadow(cx - w * 0.5 * sx, cy - TOK_R * sy + 8.0, w * sx, 2.0 * TOK_R * sy,
            TOK_R, 6.0, 12.0, 0.25 * a);
        kd: int = 0;
        for k in 0..shn_n {
            if (shn_term[k] == t) kd = shn_kind[k]
        }
        draw_token(t, kd, cx, cy, (sx + sy) * 0.5, a);
        return
    }
    cw: f32 = w * sx;
    ch: f32 = h * sy;
    cx: f32 = x + w * 0.5 - cw * 0.5;
    cy: f32 = y + h * 0.5 - ch * 0.5;
    fill: int = mix_rgb(C_BLUE_SOFT, C_WHITE, 0.3);
    edge: int = mix_rgb(C_BLUE_SOFT, C_BLUE, 0.4);
    shown: int = t;
    size: f32 = 24.0;
    if (kind == DG_FACE) {
        fill = C_CARD;
        edge = mix_rgb(C_LINE, C_MUTED, 0.5);
        size = 22.0
    }
    if (kind == DG_LEMMA) {
        fill = mix_rgb(C_GREEN_SOFT, C_CARD, 0.4);
        edge = mix_rgb(C_GREEN_SOFT, C_GREEN, 0.4);
        size = 17.0
    }
    if (kind == DG_GOAL) {
        fill = C_CARD;
        edge = mix_rgb(C_LINE, C_MUTED, 0.45);
        // (Over the facts: it shows as what it will be there, its opposite.)
        if (lifted && hv_fit && hv_kind == T_FACTS && hv_fact != 0) {
            shown = hv_fact;
            fill = mix_rgb(C_BLUE_SOFT, C_WHITE, 0.3);
            edge = C_PICK
        }
    }
    p_shadow(cx, cy, cw, ch, minf(16.0, ch * 0.5), 10.0, 18.0, 0.28 * a);
    p_box(cx, cy, cw, ch, minf(16.0, ch * 0.5), fill, a);
    p_outline(cx, cy, cw, ch, minf(16.0, ch * 0.5), 2.0, edge, a);
    an_live = false;
    lay_one_line = true;
    show_holes = kind == DG_FACE || kind == DG_LEMMA;
    e: int = lay_term(shown, size * sy, cw - 28.0, 9500000);
    show_holes = false;
    lay_one_line = false;
    if (e >= 0) {
        ty: f32 = cy + (ch - ex_h[e]) * 0.5;
        if (kind == DG_LEMMA) {
            p_sym(1, 13.0, cx + 14.0, cy + 18.0, lm_words[gf_l], mix_rgb(C_GREEN,
                C_INK, 0.3), a);
            ty = cy + 24.0
        }
        draw_expr(e, cx + 14.0, ty, C_INK, a, false)
    }
    // (A face: the other face trails behind it, faint.)
    if (kind == DG_FACE && lifted && dg_other_t != 0) {
        show_holes = true;
        lay_one_line = true;
        e2: int = lay_term(dg_other_t, 17.0, 200.0, 9510000);
        lay_one_line = false;
        show_holes = false;
        if (e2 >= 0) {
            ew: f32 = ex_w[e2] + 34.0;
            ox: f32 = cx + cw + 6.0;
            if (dg_face == 1) ox = cx - ew - 6.0;
            // (On the screen: the other side if it would not fit.)
            if (ox < 4.0) ox = cx + cw + 6.0;
            if (ox + ew > view_w() - 4.0) ox = cx - ew - 6.0;
            oy: f32 = cy + ch * 0.5 - ex_h[e2] * 0.5;
            p_box(ox, oy - 3.0, ew, ex_h[e2] + 6.0, 12.0, C_CARD, 0.5 * a);
            p_str(0, 17.0, ox + 8.0, cy + ch * 0.5 + 6.0, "=", C_MUTED, 0.6 * a);
            draw_expr(e2, ox + 26.0, oy, C_MUTED, 0.55 * a, false)
        }
    }
    an_live = true
}

// The words of a refusal, grey, under the place, for a moment.
draw_whisper() {
    t: f32 = now_t - wh_t0;
    if (t < 0.0 || t > 2.2) return;
    busy = true;
    a: f32 = clampf(t * 6.0, 0.0, 1.0) * clampf((2.2 - t) * 3.0, 0.0, 1.0);
    s: str = "Doesn't match";
    if (wh_why == 2) s = "Not a name here";
    if (wh_why == 3) s = "That needs a name, not a statement";
    y: f32 = goal_ry + goal_rh + 18.0;
    cx: f32 = goal_rx + goal_rw * 0.5;
    if (sk_kind == T_FACT && sk_j < bf_n) {
        y = bf_y1[sk_j] + 14.0;
        cx = (bf_x0[sk_j] + bf_x1[sk_j]) * 0.5
    }
    if (sk_kind == T_KIT && sk_j < si_n) {
        y = si_y0[sk_j] - 14.0;
        cx = (si_x0[sk_j] + si_x1[sk_j]) * 0.5
    }
    tw: f32 = p_str_w(0, 13.0, s) + 22.0;
    cx = clampf(cx, tw * 0.5 + 6.0, view_w() - tw * 0.5 - 6.0);
    p_box(cx - tw * 0.5, y - 14.0, tw, 22.0, 11.0, C_INK, 0.6 * a);
    p_str_mid(0, 13.0, cx, y + 1.5, s, C_WHITE, a)
}

// A socket waiting on the goal: a few words on its top edge.
draw_pending() {
    if (!ps_on || done_t >= 0.0) return;
    busy = true;
    s: str = "Drop a name into the slot";
    tw: f32 = p_str_w(1, 12.5, s) + 24.0;
    x: f32 = goal_rx + 14.0;
    y: f32 = goal_ry - 12.0;
    g: f32 = 0.5 + 0.5 * sinf((now_t - ps_t0) * 5.0);
    p_box(x, y, tw, 24.0, 12.0, mix_rgb(C_PICK_SOFT, C_PICK, 0.2 + 0.2 * g), 1.0);
    p_str(1, 12.5, x + 12.0, y + 16.5, s, mix_rgb(C_PICK, C_INK, 0.4), 1.0)
}

// The ghost hand of a hint: it presses the key, or carries the thing to
// where it goes, over and over.
draw_lang_ghost() {
    if (!lh_on || done_t >= 0.0 || dg_on || pp_on || wp_on) return;
    if (intro_open || chapter_open) return;
    t: f32 = now_t - lh_t;
    if (demo_kind == 0 && !watching && t > 6.0) {
        lh_on = false;
        return
    }
    busy = true;
    lh_restore();
    ok: bool = false;
    ga_kit = false;
    try {
        ok = gesture_at(lh_kind, lh_j, lh_tok)
    } with KernelError -> {
        ok = false
    }
    if (!ok) return;
    if (ga_tap) {
        c: f32 = t - floorf(t / 1.4) * 1.4;
        down: bool = c > 0.5 && c < 0.75;
        a: f32 = clampf(c / 0.2, 0.0, 1.0) * clampf((1.4 - c) / 0.3, 0.0, 1.0);
        draw_hand_at(ga_x0 + 6.0, ga_y0 + 14.0, a, down);
        return
    }
    cyc: f32 = 2.2;
    c: f32 = t - floorf(t / cyc) * cyc;
    k: f32 = clampf((c - 0.35) / 1.0, 0.0, 1.0);
    k = k * k * (3.0 - 2.0 * k);
    a: f32 = clampf(c / 0.2, 0.0, 1.0) * clampf((cyc - c) / 0.3, 0.0, 1.0);
    gx: f32 = ga_x0 + (ga_x1 - ga_x0) * k;
    gy: f32 = ga_y0 + (ga_y1 - ga_y0) * k - sinf(k * 3.1416) * 30.0;
    // (What it carries, faint, riding above the finger.)
    if (lh_kind == GS_NOTCH || ga_kit) {
        kd: int = 0;
        tk: int = lh_tok;
        if (ga_kit) {
            for i in 0..shn_n {
                if (absf(shn_x[i] - ga_x0) < 1.0 && absf(shn_y[i] - ga_y0) < 1.0) tk = shn_term[i]
            }
        }
        for i in 0..shn_n {
            if (shn_term[i] == tk) kd = shn_kind[i]
        }
        draw_token(tk, kd, gx, gy - LIFT_UP * k, 0.9, 0.55 * a)
    } else {
        // (The card or the face it carries, faint, its writing in it.)
        t: int = 0;
        fill: int = C_CARD;
        if (lh_kind == GS_APPLY && lh_j >= 0 && lh_j < bf_n) {
            t = bf_term[lh_j];
            fill = C_BLUE_SOFT
        } else if (lh_kind == GS_FACE) {
            q: int = 0;
            if (gf_l >= 0) q = rel_core(strip_rule(thm_prop(lm_thm[gf_l]))) else if (gf_j >= 0 && gf_j < bf_n) q = rel_core(bf_term[gf_j]);
            if (q != 0 && is_binary(q, role_name[ROLE_EQ])) {
                t = spine_arg(q, 2, 0);
                if (gf_back) t = spine_arg(q, 2, 1)
            }
        } else if (lh_kind == GS_LEMMA && lh_j >= 0) {
            t = thm_prop(lm_thm[lh_j]);
            fill = mix_rgb(C_GREEN_SOFT, C_CARD, 0.4)
        }
        if (t != 0) {
            an_live = false;
            show_holes = true;
            lay_one_line = true;
            e: int = lay_term(t, 18.0, 260.0, 9520000);
            lay_one_line = false;
            show_holes = false;
            if (e >= 0) {
                bw: f32 = ex_w[e] + 28.0;
                by: f32 = gy - 20.0 - 44.0 * k;
                p_box(gx - bw * 0.5, by, bw, ex_h[e] + 8.0, 14.0, fill, 0.75 * a);
                p_outline(gx - bw * 0.5, by, bw, ex_h[e] + 8.0, 14.0, 2.0, C_PICK,
                    0.4 * a);
                draw_expr(e, gx - bw * 0.5 + 14.0, by + 4.0, C_INK, 0.7 * a, false)
            }
            an_live = true
        }
    }
    draw_hand_at(gx, gy + 10.0, a, k > 0.0 && k < 1.0)
}

// What a demo says, the first time a level brings a word in.
draw_lang_demo_words(x: f32, w: f32) {
    if (demo_kind == 0 || intro_open || now_t < demo_t0 || done_t >= 0.0) return;
    s: str = "Tap the raised key to open it.";
    if (demo_kind == sym("goalkey")) s = "The goal has a key too. Tap it.";
    if (demo_kind == sym("drag")) s = "Drag a fact onto the goal.";
    if (demo_kind == sym("token")) s = "Tap the key: a name pops out. Drop it into a notch.";
    if (demo_kind == sym("notch")) s = "A notch on the goal wants a name. Drop one in.";
    if (demo_kind == sym("some")) s = "A fact's key gives a blue name: a particular one.";
    if (demo_kind == sym("face")) s = "Grab a rule by one face; drop it on a part like it.";
    if (demo_kind == sym("flip")) s = "Swipe the goal to flip it. Drop a lemma onto it.";
    if (demo_kind == sym("def")) s = "The arrow is a key: it opens to what it means.";
    if (demo_kind == sym("kit")) s = "Drop a name onto a kit tile to build a new one.";
    if (demo_kind == sym("suppose")) s = "Drag the goal up into the facts: suppose it is not so.";
    a: f32 = clampf((now_t - demo_t0) * 4.0, 0.0, 1.0);
    busy = true;
    tw: f32 = p_str_w(1, 14.0, s) + 32.0;
    fs: f32 = 14.0;
    if (tw > w) {
        fs = 14.0 * w / tw;
        tw = w
    }
    bx: f32 = x + w * 0.5 - tw * 0.5;
    by: f32 = bar_bottom_y + 6.0;
    if (pic_bottom_y > 0.0) by = pic_bottom_y - 48.0;
    p_shadow(bx, by, tw, 36.0, 18.0, 3.0, 10.0, 0.16 * a);
    p_box(bx, by, tw, 36.0, 18.0, C_INK, 0.88 * a);
    p_str_mid(1, fs, x + w * 0.5, by + 23.0, s, C_WHITE, a)
}

// A goal that cannot be shown: grey, dashed, the words on its top edge, a
// way back on its corner.
draw_dead_goal(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    t: f32 = clampf((now_t - dead_t) / 0.3, 0.0, 1.0);
    if (t < 1.0) busy = true;
    // (Dashes on its edge: centred on it, the corners left round.)
    col: int = mix_rgb(C_RED, C_MUTED, 0.45);
    dl: f32 = 12.0;
    gap: f32 = 8.0;
    th: f32 = 3.0;
    r: f32 = 20.0;
    span: f32 = w - 2.0 * r;
    nd: int = ((span + gap) / (dl + gap)) as int;
    if (nd < 1) nd = 1;
    used: f32 = nd as f32 * dl + (nd - 1) as f32 * gap;
    xx: f32 = x + r + (span - used) * 0.5;
    for _ in 0..nd {
        p_box(xx, y, dl, th, th * 0.5, col, t);
        p_box(xx, y + h - th, dl, th, th * 0.5, col, t);
        xx = xx + dl + gap
    }
    vspan: f32 = h - 2.0 * r;
    nv: int = ((vspan + gap) / (dl + gap)) as int;
    if (nv >= 1) {
        vused: f32 = nv as f32 * dl + (nv - 1) as f32 * gap;
        yy: f32 = y + r + (vspan - vused) * 0.5;
        for _ in 0..nv {
            p_box(x, yy, th, dl, th * 0.5, col, t);
            p_box(x + w - th, yy, th, dl, th * 0.5, col, t);
            yy = yy + dl + gap
        }
    }
    // (The words, on its top edge.)
    s: str = "Can't be shown from what you have";
    tw: f32 = p_str_w(1, 12.5, s) + 24.0;
    p_box(x + 14.0, y - 12.0, tw, 24.0, 12.0, mix_rgb(C_RED, C_BG, 0.86), t);
    p_outline(x + 14.0, y - 12.0, tw, 24.0, 12.0, 1.2, mix_rgb(C_RED, C_BG, 0.55),
        t);
    p_str(1, 12.5, x + 26.0, y + 4.5, s, mix_rgb(C_RED, C_INK, 0.45), t);
    // (Undo k, bobbing on its corner.)
    line_clear();
    line_add("Undo ");
    line_int(dead_undo_k());
    k: f32 = pressed(B_DEAD_UNDO);
    pw: f32 = p_line_w(1, 16.0) + 52.0;
    ph: f32 = 40.0;
    px: f32 = x + w - pw + 8.0;
    py: f32 = y + h - 18.0 + sinf(now_t * 3.5) * 3.0 + k * 2.0;
    busy = true;
    p_shadow(px, py, pw, ph, 20.0, 3.0 - k * 2.0, 8.0, 0.2 * t);
    p_box(px, py, pw, ph, 20.0, C_PICK, t);
    p_disc(px + 20.0, py + 20.0, 11.0, C_WHITE, t);
    draw_icon(I_UNDO, px + 20.0, py + 20.0, 6.0, C_PICK, t);
    p_line_text(1, 16.0, px + 37.0, py + 26.0, C_WHITE, t);
    add_button(B_DEAD_UNDO, px, py, px + pw, py + ph)
}

// ---- for pictures: the board's places, printed (L8_BOXES) ----
boxes_on: bool = false;

boxes_at: f32 = -1.0;

boxes_print() {
    if (!boxes_on || boxes_at < 0.0 || now_t < boxes_at || !lang_on()) return;
    boxes_at = -1.0;
    n: int = play_node();
    line_clear();
    line_add("-- board at ");
    line_int((now_t * 100.0) as int);
    line_add(" (moves ");
    line_int(moves_made);
    line_add(", on the book's path ");
    line_int(on_path);
    if (lang_dead()) line_add(", DEAD");
    if (done_t >= 0.0) line_add(", DONE");
    if (ps_on) line_add(", SOCKET");
    line_add(")");
    line_print_safe();
    if (n >= 0) {
        g: int = pn_goal[n];
        box_line("goal", -1, gl_concl[g], goal_rx, goal_ry, goal_rx + goal_rw, goal_ry + goal_rh);
        if (gk_ok) box_line("  key", -1, 0, gk_x0, gk_y0, gk_x1, gk_y1);
        if (gn_ok) box_line("  notch", -1, 0, gn_x0, gn_y0, gn_x1, gn_y1);
        e: int = goal_real_e;
        if (e >= 0) {
            for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
                if (compound(bx_term[b]) && bx_parent[b] >= 0) box_line("  part",
                    -1, bx_term[b], ex_ox[e] + bx_x0[b], ex_oy[e] + bx_y0[b], ex_ox[e] + bx_x1[b],
                    ex_oy[e] + bx_y1[b])
            }
        }
        for i in 0..bf_n {
            box_line("fact", i, bf_term[i], bf_x0[i], bf_y0[i], bf_x1[i], bf_y1[i]);
            if (bfk_ok[i]) box_line("  key", -1, 0, bfk_x0[i], bfk_y0[i], bfk_x1[i],
                bfk_y1[i]);
            if (bfn_ok[i]) box_line("  notch", -1, 0, bfn_x0[i], bfn_y0[i], bfn_x1[i],
                bfn_y1[i]);
            if (bf_seam[i] > 0.0) box_line("  seam", -1, 0, bf_seam[i], bf_y0[i],
                bf_seam[i], bf_y1[i])
        }
        for k in 0..si_n {
            if (si_kind[k] == SI_TOKEN) {
                for q in 0..shn_n {
                    if (shn_item[q] == k) box_line(token_word(shn_kind[q]), -1, shn_term[q],
                        shn_x[q] - token_hw(shn_term[q]), shn_y[q] - TOK_R, shn_x[q] + token_hw(shn_term[q]),
                        shn_y[q] + TOK_R)
                }
            } else {
                what: str = "kit";
                if (si_kind[k] == SI_RULE) what = "rule";
                if (si_kind[k] == SI_LEMMA) what = "lemma";
                show_holes = true;
                box_line(what, k, tile_term(k), si_x0[k], si_y0[k], si_x1[k], si_y1[k]);
                show_holes = false;
                if (si_kind[k] == SI_RULE) box_line("  seam", -1, 0, si_x0[k] + si_seam[k],
                    si_y0[k], si_x0[k] + si_seam[k], si_y1[k])
            }
        }
    }
}

token_word(kind: int): str {
    if (kind == 1) return "token(any)";
    if (kind == 2) return "token(some)";
    if (kind == 3) return "token(made)";
    "token"
}

box_line(
    what: str,
    i: int,
    t: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    ts: int = 0;
    if (t != 0) {
        show_line(t);
        ts = line_sym_now()
    }
    line_clear();
    line_add(what);
    if (i >= 0) {
        line_add(" ");
        line_int(i)
    }
    line_add(" ");
    line_int(x0 as int);
    line_add(",");
    line_int(y0 as int);
    line_add(" ");
    line_int(x1 as int);
    line_add(",");
    line_int(y1 as int);
    if (ts != 0) {
        line_add("  ");
        line_sym(ts)
    }
    line_print_safe()
}
