tag lemma_ui;

use_tag std, skate, lemma;

// The board as a language (the logic chapter): the formulas are the
// controls. No list of moves anywhere: a statement's outermost symbol is a
// raised key (tap it: it opens, always safely), a sunken notch (drop a name
// into it: the choosing), or flat; a fact is picked up whole and put onto
// the goal; the names in scope sit on the shelf at the bottom. What is in
// scope is what is on the board (gesture.l8 makes the moves).
//
// A thing held over a place it fits shows what that place would become;
// let go there, the move is made; let go anywhere else, it springs home
// and the place shakes no (said in words the second time).
lang_sym: int = 0;

lang_on(): bool {
    if (lang_sym == 0) lang_sym = sym("logic");
    page == PAGE_LEVEL && region_name == lang_sym && loaded_region >= 0
}

// The keys' buttons: the goal's (B_KEY), fact j's (B_KEY + 1 + j); a
// name on the shelf tapped (B_TOKEN + k).
const B_KEY: int = 6000;

const B_TOKEN: int = 6500;

// ---- where things are on the board (laid out each frame) ----
// The goal's key and notch.
gk_ok: bool = false;

gk_x0: f32 = 0.0;

gk_y0: f32 = 0.0;

gk_x1: f32 = 0.0;

gk_y1: f32 = 0.0;

gn_ok: bool = false;

gn_x0: f32 = 0.0;

gn_y0: f32 = 0.0;

gn_x1: f32 = 0.0;

gn_y1: f32 = 0.0;

// Each fact's card, key and notch (by its number in the goal).
const BF: int = 64;

bf_n: int = 0;

bf_term: []int = new int[BF](0);

bf_x0: []f32 = new f32[BF](0.0);

bf_y0: []f32 = new f32[BF](0.0);

bf_x1: []f32 = new f32[BF](0.0);

bf_y1: []f32 = new f32[BF](0.0);

bfk_ok: []bool = new bool[BF](false);

bfk_x0: []f32 = new f32[BF](0.0);

bfk_y0: []f32 = new f32[BF](0.0);

bfk_x1: []f32 = new f32[BF](0.0);

bfk_y1: []f32 = new f32[BF](0.0);

bfn_ok: []bool = new bool[BF](false);

bfn_x0: []f32 = new f32[BF](0.0);

bfn_y0: []f32 = new f32[BF](0.0);

bfn_x1: []f32 = new f32[BF](0.0);

bfn_y1: []f32 = new f32[BF](0.0);

// The names on the shelf: each its term, kind (0 one of the level's, 1
// any (taken), 2 some (got from a there-is)), and where it is.
const BTOKS: int = 32;

shn_n: int = 0;

shn_term: []int = new int[BTOKS](0);

shn_kind: []int = new int[BTOKS](0);

shn_x: []f32 = new f32[BTOKS](0.0);

shn_y: []f32 = new f32[BTOKS](0.0);

// When each name came onto the shelf (it bounces in).
shn_born: []f32 = new f32[BTOKS](-10.0);

shn_seen_term: []int = new int[BTOKS](0);

shn_seen_n: int = 0;

const TOK_R: f32 = 21.0;

const SHELF_H: f32 = 104.0;

// Whether the level has a shelf (it says something of every x or some x,
// or has names).
shelf_wanted: bool = false;

has_quant(t: int): bool {
    k: int = tm_kind(t);
    if (k == TM_CONST) return tm_name(t) == role_name[ROLE_ALL] || tm_name(t) == role_name[ROLE_EX];
    if (k == TM_APP) return has_quant(tm_fun(t)) || has_quant(tm_arg(t));
    if (k == TM_ABS) return has_quant(tm_body(t));
    false
}

// ---- the level begun ----
lang_start() {
    shelf_wanted = false;
    if (cur_level >= 0) shelf_wanted = has_quant(lv_goal[cur_level]);
    dg_on = false;
    rb_t0 = -10.0;
    sk_t0 = -10.0;
    wh_t0 = -10.0;
    ps_on = false;
    lh_on = false;
    dead_node = -1;
    shn_seen_n = 0;
    hv_kind = T_NONE;
    boxes_at = now_t + 1.9
}

// ---- keys and notches of a statement laid out as expression e ----
// The block of e that is the statement itself (under Trueprop), or -1.
root_block(e: int, t: int): int {
    c: int = rel_core(t);
    for b in ex_box0[e]..ex_box0[e] + ex_boxn[e] {
        if (bx_term[b] == c) return b
    }
    -1
}

sym_dot: int = 0;

// The rectangle of the key of statement t (shape s) laid out as e, drawn
// at (ox, oy): into kr_. Whether it has one.
kr_x0: f32 = 0.0;

kr_y0: f32 = 0.0;

kr_x1: f32 = 0.0;

kr_y1: f32 = 0.0;

key_rect(
    e: int,
    t: int,
    ox: f32,
    oy: f32
): bool {
    if (e < 0) return false;
    if (sym_dot == 0) sym_dot = sym(". ");
    rb: int = root_block(e, t);
    if (rb < 0) return false;
    s: int = shape_of(t);
    size: f32 = ex_size[e];
    first: bool = true;
    found: bool = false;
    for r in ex_run0[e]..ex_run0[e] + ex_runn[e] {
        if (rn_box[r] == rb && !found) {
            x: f32 = ox + rn_x[r];
            w: f32 = p_sym_w(0, size, rn_sym[r]);
            by: f32 = oy + rn_y[r];
            if (s == SH_ALL || s == SH_EX) {
                if (first) {
                    kr_x0 = x;
                    kr_y0 = by - size * 0.9;
                    kr_y1 = by + size * 0.3;
                    first = false
                }
                kr_x1 = x + w;
                if (rn_sym[r] == sym_dot) {
                    kr_x1 = x + p_sym_w(0, size, sym("."));
                    found = true
                }
            } else if (infix_text(rn_sym[r])) {
                sp: f32 = p_sym_w(0, size, sym(" "));
                kr_x0 = x + sp;
                kr_x1 = x + w - sp;
                kr_y0 = by - size * 0.9;
                kr_y1 = by + size * 0.3;
                found = true
            }
        }
    }
    if (!found) return false;
    kr_x0 = kr_x0 - size * 0.2;
    kr_x1 = kr_x1 + size * 0.2;
    true
}

// The notch: the binder's name.
notch_rect(
    e: int,
    t: int,
    ox: f32,
    oy: f32
): bool {
    if (e < 0) return false;
    rb: int = root_block(e, t);
    if (rb < 0) return false;
    size: f32 = ex_size[e];
    k: int = 0;
    for r in ex_run0[e]..ex_run0[e] + ex_runn[e] {
        if (rn_box[r] == rb) {
            if (k == 1) {
                x: f32 = ox + rn_x[r];
                w: f32 = p_sym_w(0, size, rn_sym[r]);
                by: f32 = oy + rn_y[r];
                cx: f32 = x + w * 0.5;
                hw: f32 = maxf(w * 0.5 + size * 0.22, size * 0.5);
                kr_x0 = cx - hw;
                kr_x1 = cx + hw;
                kr_y0 = by - size * 0.88;
                kr_y1 = by + size * 0.28;
                notch_sym = rn_sym[r];
                return true
            }
            k = k + 1
        }
    }
    false
}

notch_sym: int = 0;

// A raised key, its face (x0..x1, y0..y1) in color col; pressed k.
draw_keycap(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    col: int,
    k: f32,
    breathe: bool
) {
    w: f32 = x1 - x0;
    h: f32 = y1 - y0;
    r: f32 = minf(h * 0.32, 9.0);
    depth: f32 = 4.0 - 3.0 * k;
    if (breathe) {
        g: f32 = 0.5 + 0.5 * sinf(now_t * 3.2);
        p_glow(x0 + w * 0.5, y0 + h * 0.5, maxf(w, h) * 0.75 + 4.0 * g, 10.0, C_GOLD,
            0.25 + 0.2 * g);
        busy = true
    }
    p_shadow(x0, y0 + 3.0 - k * 3.0, w, h, r, depth, 5.0, 0.22);
    p_box(x0, y0 + depth, w, h, r, mix_rgb(col, C_SHADOW, 0.32), 1.0);
    p_box(x0, y0 + 3.0 * k, w, h, r, col, 1.0);
    p_box(x0 + 3.0, y0 + 3.0 * k + 2.0, w - 6.0, h * 0.36, r * 0.7, C_WHITE, 0.35 * (1.0 - k))
}

// A sunken notch, (x0..x1, y0..y1): its name faint in it; glowing if a
// name held fits it.
draw_notch(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    name: int,
    size: f32,
    lit: bool
) {
    w: f32 = x1 - x0;
    h: f32 = y1 - y0;
    r: f32 = minf(h * 0.38, 10.0);
    if (lit) {
        g: f32 = 0.5 + 0.5 * sinf(now_t * 5.0);
        p_glow(x0 + w * 0.5, y0 + h * 0.5, maxf(w, h) * 0.7 + 3.0 * g, 9.0, C_PICK,
            0.3 + 0.25 * g);
        busy = true
    }
    p_box(x0, y0, w, h, r, mix_rgb(C_SUNK, C_SHADOW, 0.1), 1.0);
    // (Its inner shadow, at the top: it is a hole.)
    p_box(x0 + 1.0, y0 + 1.0, w - 2.0, h * 0.3, r * 0.8, C_SHADOW, 0.1);
    p_outline(x0, y0, w, h, r, 1.6, mix_rgb(C_MUTED, C_SUNK, 0.3), 1.0);
    if (name != 0) {
        nw: f32 = p_sym_w(0, size * 0.9, name);
        p_sym(0, size * 0.9, x0 + w * 0.5 - nw * 0.5, y0 + h * 0.5 + size * 0.3, name,
            C_FAINT, 1.0)
    }
}

// The key under the writing of the goal (j < 0) or fact j, laid out as e
// and to be drawn at (ox, oy); its place kept, and its button.
lang_under(
    e: int,
    t: int,
    j: int,
    ox: f32,
    oy: f32
) {
    n: int = play_node();
    ok: bool = n >= 0 && done_t < 0.0 && !lang_previewing(j) && gs_has_key(n, j) && key_rect(e,
        t, ox, oy);
    if (j < 0) {
        gk_ok = ok;
        if (ok) {
            gk_x0 = kr_x0;
            gk_y0 = kr_y0;
            gk_x1 = kr_x1;
            gk_y1 = kr_y1
        }
    } else if (j < BF) {
        bfk_ok[j] = ok;
        if (ok) {
            bfk_x0[j] = kr_x0;
            bfk_y0[j] = kr_y0;
            bfk_x1[j] = kr_x1;
            bfk_y1[j] = kr_y1
        }
    }
    if (!ok) return;
    id: int = B_KEY + 1 + j;
    col: int = mix_rgb(C_PICK_SOFT, C_PICK, 0.35);
    if (j >= 0) col = mix_rgb(C_BLUE_SOFT, C_BLUE, 0.3);
    breathe: bool = now_t - last_input_t > 8.0 && !dg_on;
    // (The hint's key breathes gold.)
    if (lh_on && lh_kind == GS_KEY && lh_j == j) breathe = true;
    draw_keycap(kr_x0, kr_y0, kr_x1, kr_y1, col, pressed(id), breathe);
    add_button(id, kr_x0 - 6.0, kr_y0 - 6.0, kr_x1 + 6.0, kr_y1 + 6.0)
}

// The notch over the writing (drawn after it).
lang_over(e: int, t: int, j: int) {
    if (e < 0) return;
    n: int = play_node();
    ok: bool = n >= 0 && done_t < 0.0 && !lang_previewing(j) && gs_has_notch(n, j) && notch_rect(e,
        t, ex_ox[e], ex_oy[e]);
    if (j < 0) {
        gn_ok = ok;
        if (ok) {
            gn_x0 = kr_x0;
            gn_y0 = kr_y0;
            gn_x1 = kr_x1;
            gn_y1 = kr_y1
        }
    } else if (j < BF) {
        bfn_ok[j] = ok;
        if (ok) {
            bfn_x0[j] = kr_x0;
            bfn_y0[j] = kr_y0;
            bfn_x1[j] = kr_x1;
            bfn_y1[j] = kr_y1
        }
    }
    if (!ok) return;
    lit: bool = dg_on && dg_kind == DG_TOKEN && lf_fit(j);
    if (lh_on && lh_kind == GS_NOTCH && lh_j == j) lit = true;
    draw_notch(kr_x0, kr_y0, kr_x1, kr_y1, notch_sym, ex_size[e], lit)
}

// ---- the shelf ----
// The names in scope at node n, each with its kind.
tokens_build(n: int) {
    shn_n = 0;
    if (n < 0) return;
    g: int = pn_goal[n];
    for i in 0..gl_fixn[g] {
        x: int = goal_fix(g, i);
        if (token_type(tm_type(x)) && shn_n < BTOKS) {
            shn_term[shn_n] = x;
            shn_kind[shn_n] = token_kind(n, x);
            shn_n = shn_n + 1
        }
    }
    // (A name new on the shelf bounces in.)
    for k in 0..shn_n {
        seen: bool = false;
        for i in 0..shn_seen_n {
            if (shn_seen_term[i] == shn_term[k]) seen = true
        }
        if (!seen) {
            shn_born[k] = now_t;
            if (an_jump || intro_open) shn_born[k] = -10.0
        } else if (shn_born[k] > now_t) shn_born[k] = -10.0
    }
    for k in 0..shn_n shn_seen_term[k] = shn_term[k];
    shn_seen_n = shn_n
}

// How name x came into node n's goal: 0 the level's own, 1 taken (any),
// 2 got from a there-is (some).
token_kind(n: int, x: int): int {
    a: int = n;
    while (pn_parent[a] >= 0) {
        p: int = pn_parent[a];
        gp: int = pn_goal[p];
        ga: int = pn_goal[a];
        for i in gl_fixn[gp]..gl_fixn[ga] {
            if (goal_fix(ga, i) == x) {
                m: int = pn_move[p];
                if (m >= 0 && mv_lemma[m] >= 0 && lm_name[mv_lemma[m]] == sym("exE")) return 2;
                return 1
            }
        }
        a = p
    }
    0
}

shelf_height(): f32 {
    if (!shelf_wanted) return 18.0;
    SHELF_H
}

draw_shelf(x: f32, w: f32, top: f32) {
    if (!shelf_wanted) return;
    n: int = play_node();
    if (n < 0) n = last_node;
    if (done_t < 0.0) tokens_build(n);
    away: f32 = 0.0;
    if (done_t >= 0.0) {
        if (!hand_leaving()) return;
        away = hand_away() * (SHELF_H + 60.0);
        busy = true
    }
    y0: f32 = top + away;
    p_shadow(0.0, y0, view_w(), SHELF_H + safe_bottom + 40.0, 26.0, -3.0, 18.0, 0.14);
    p_box(0.0, y0, view_w(), SHELF_H + safe_bottom + 40.0, 26.0, mix_rgb(C_BG, C_SUNK,
        0.7), 1.0);
    // (A groove the names sit in.)
    p_box(x + 4.0, y0 + 16.0, w - 8.0, 54.0, 27.0, mix_rgb(C_SUNK, C_SHADOW, 0.05),
        1.0);
    p_box(x + 5.0, y0 + 17.0, w - 10.0, 10.0, 8.0, C_SHADOW, 0.05);
    if (shn_n == 0) {
        p_str_mid(0, 14.0, x + w * 0.5, y0 + 48.0, "Names you can use come here",
            C_FAINT, 1.0);
        return
    }
    cx: f32 = x + 34.0;
    cy: f32 = y0 + 43.0;
    for k in 0..shn_n {
        tx: f32 = cx;
        ty: f32 = cy;
        // (Waiting to fill a socket: the names lift and bob.)
        if (ps_on) ty = ty - 4.0 - 3.0 * sinf(now_t * 5.0 + k as f32);
        shn_x[k] = tx;
        shn_y[k] = ty;
        held: bool = dg_on && dg_kind == DG_TOKEN && dg_src == k;
        back: bool = rb_on() && rb_kind == DG_TOKEN && rb_src == k;
        a: f32 = 1.0;
        if (held || back) a = 0.25;
        s: f32 = 1.0;
        bt: f32 = now_t - shn_born[k];
        if (bt >= 0.0 && bt < 0.6) {
            // (From where it was made, up and over, and a bounce.)
            q: f32 = bt / 0.6;
            s = q * (1.0 + 0.45 * sinf(q * 3.1416)) + 0.001;
            ty = ty - sinf(q * 3.1416) * 30.0;
            busy = true
        }
        draw_token(shn_term[k], shn_kind[k], tx, ty, s, a);
        if (lh_on && lh_tok == shn_term[k] && lh_kind != GS_KEY) {
            g: f32 = 0.5 + 0.5 * sinf(now_t * 5.0);
            p_ring(tx, ty, TOK_R + 5.0 + 2.0 * g, 2.5, C_GOLD, 0.7);
            busy = true
        }
        // (Its kind, small, under it.)
        if (shn_kind[k] == 1) p_str_mid(1, 10.5, tx, cy + TOK_R + 14.0, "any", C_PICK,
            a);
        if (shn_kind[k] == 2) p_str_mid(1, 10.5, tx, cy + TOK_R + 14.0, "some", C_BLUE,
            a);
        add_button(B_TOKEN + k, tx - TOK_R, ty - TOK_R, tx + TOK_R, ty + TOK_R);
        cx = cx + TOK_R * 2.0 + 18.0
    }
}

// A name as a pudgy ball at (cx, cy), scaled s.
draw_token(
    t: int,
    kind: int,
    cx: f32,
    cy: f32,
    s: f32,
    a: f32
) {
    r: f32 = TOK_R * s;
    if (r <= 0.5) return;
    fill: int = C_CARD;
    ring: int = mix_rgb(C_LINE, C_MUTED, 0.4);
    ink: int = C_INK;
    if (kind == 1) {
        fill = C_WHITE;
        ring = C_PICK;
        ink = mix_rgb(C_PICK, C_INK, 0.35)
    }
    if (kind == 2) {
        fill = C_BLUE;
        ring = mix_rgb(C_BLUE, C_SHADOW, 0.25);
        ink = C_WHITE
    }
    p_shadow(cx - r, cy - r, 2.0 * r, 2.0 * r, r, 3.0, 6.0, 0.2 * a);
    p_disc(cx, cy, r, fill, a);
    p_ring(cx, cy, r, 3.0 * s, ring, a);
    p_box(cx - r * 0.55, cy - r * 0.78, r * 1.1, r * 0.5, r * 0.25, C_WHITE, 0.3 * a);
    show_line(t);
    nm: int = line_sym_now();
    fs: f32 = 20.0 * s;
    nw: f32 = p_sym_w(0, fs, nm);
    if (nw > r * 1.6) {
        fs = fs * r * 1.6 / nw;
        nw = p_sym_w(0, fs, nm)
    }
    p_sym(0, fs, cx - nw * 0.5, cy + fs * 0.34, nm, ink, a)
}

// ---- holding a thing ----
const DG_FACT: int = 1;

const DG_TOKEN: int = 2;

dg_on: bool = false;

dg_kind: int = 0;

dg_src: int = 0;

dg_term: int = 0;

dg_x: f32 = 0.0;

dg_y: f32 = 0.0;

dg_vx: f32 = 0.0;

dg_vy: f32 = 0.0;

// (A card is held where the finger took it.)
dg_ox: f32 = 0.0;

dg_oy: f32 = 0.0;

dg_w: f32 = 0.0;

dg_h: f32 = 0.0;

dg_t0: f32 = 0.0;

// What the finger came down on that it may pick up (-1 nothing).
gr_kind: int = 0;

gr_src: int = -1;

// Whether a finger at (x, y) is on something to pick up.
lang_grab(x: f32, y: f32): bool {
    gr_kind = 0;
    gr_src = -1;
    if (!lang_on() || done_t >= 0.0 || watching || intro_open || chapter_open) return false;
    for k in 0..shn_n {
        if (absf(x - shn_x[k]) <= TOK_R + 6.0 && absf(y - shn_y[k]) <= TOK_R + 6.0) {
            gr_kind = DG_TOKEN;
            gr_src = k;
            return true
        }
    }
    for i in 0..bf_n {
        if (x >= bf_x0[i] && x <= bf_x1[i] && y >= bf_y0[i] && y <= bf_y1[i]) {
            gr_kind = DG_FACT;
            gr_src = i;
            return true
        }
    }
    false
}

// The thing under the finger lifted.
lang_lift(x: f32, y: f32) raises KernelError {
    if (gr_src < 0) return;
    last_input_t = now_t;
    dg_on = true;
    dg_kind = gr_kind;
    dg_src = gr_src;
    dg_x = x;
    dg_y = y;
    dg_vx = 0.0;
    dg_vy = 0.0;
    dg_t0 = now_t;
    hv_kind = T_NONE;
    if (dg_kind == DG_TOKEN) {
        dg_term = shn_term[dg_src];
        dg_ox = x - shn_x[dg_src];
        dg_oy = y - shn_y[dg_src]
    } else {
        dg_term = bf_term[dg_src];
        // (As wide as its writing, held just above the finger so what is
        // under it shows.)
        show_line(dg_term);
        dg_w = minf(p_sym_w(0, 22.0, line_sym_now()) + 40.0, bf_x1[dg_src] - bf_x0[dg_src]);
        dg_h = minf(bf_y1[dg_src] - bf_y0[dg_src], 52.0);
        dg_ox = dg_w * 0.5;
        dg_oy = dg_h + 16.0
    }
    // (Where it fits, found now: those places breathe while it is held.)
    lift_fits();
    if (lh_on && !(demo_kind != 0)) lh_on = false;
    lang_drag(x, y)
}

// Where the thing held fits: the goal (lf_goal), each fact.
lf_goal: bool = false;

lf_fact: []bool = new bool[BF](false);

lf_fit(j: int): bool {
    if (j < 0) return lf_goal;
    j < BF && lf_fact[j]
}

lift_fits() raises KernelError {
    n: int = play_node();
    lf_goal = false;
    for i in 0..BF lf_fact[i] = false;
    if (n < 0) return;
    if (dg_kind == DG_TOKEN) {
        if (ps_on) lf_goal = gs_try(n, GS_APPLY, ps_j, dg_term) != 0 else if (gs_has_notch(n,
            -1)) lf_goal = gs_try(n, GS_NOTCH, -1, dg_term) != 0;
        for i in 0..mini(bf_n, BF) {
            if (gs_has_notch(n, i)) lf_fact[i] = gs_try(n, GS_NOTCH, i, dg_term) != 0
        }
    } else lf_goal = gs_apply_wn(n, dg_src) >= 0
}

// ---- where the thing held is over ----
const T_NONE: int = 0;

const T_GOAL: int = 1;

const T_FACT: int = 2;

hv_kind: int = 0;

hv_j: int = -1;

// Whether it fits there, and what the place would become (the goal, a
// new fact; or it closes); whether a name is still wanted.
hv_fit: bool = false;

hv_goal: int = 0;

hv_fact: int = 0;

hv_closes: bool = false;

hv_wants: bool = false;

lang_drag(x: f32, y: f32) raises KernelError {
    if (!dg_on) return;
    if (frame_dt > 0.0) {
        dg_vx = lerpf(dg_vx, (x - dg_x) / frame_dt, 0.4);
        dg_vy = lerpf(dg_vy, (y - dg_y) / frame_dt, 0.4)
    }
    dg_x = x;
    dg_y = y;
    busy = true;
    k: int = T_NONE;
    j: int = -1;
    if (x >= goal_rx && x <= goal_rx + goal_rw && y >= goal_ry - 6.0 && y <= goal_ry + goal_rh + 6.0) k = T_GOAL else {
        for i in 0..bf_n {
            if (x >= bf_x0[i] && x <= bf_x1[i] && y >= bf_y0[i] - 3.0 && y <= bf_y1[i] + 3.0 && !(dg_kind == DG_FACT && i == dg_src)) {
                k = T_FACT;
                j = i
            }
        }
    }
    if (k == hv_kind && j == hv_j) return;
    hv_kind = k;
    hv_j = j;
    hover_read()
}

// What the place under the thing held would become.
hover_read() raises KernelError {
    hv_fit = false;
    hv_goal = 0;
    hv_fact = 0;
    hv_closes = false;
    hv_wants = false;
    n: int = play_node();
    if (n < 0 || hv_kind == T_NONE) return;
    sig: int = 0;
    if (dg_kind == DG_TOKEN) {
        if (hv_kind == T_GOAL && ps_on) sig = gs_try(n, GS_APPLY, ps_j, dg_term) else if (hv_kind == T_GOAL) sig = gs_try(n,
            GS_NOTCH, -1, dg_term) else sig = gs_try(n, GS_NOTCH, hv_j, dg_term)
    } else if (hv_kind == T_GOAL) {
        wn: int = gs_apply_wn(n, dg_src);
        if (wn == 0) sig = gs_try(n, GS_APPLY, dg_src, 0) else if (wn == 1) {
            hv_fit = true;
            hv_wants = true;
            return
        }
    }
    if (sig == 0) return;
    hv_fit = true;
    hv_closes = gt_closes;
    hv_goal = gt_goal;
    hv_fact = gt_fact
}

// Whether the goal (j < 0) or fact j shows what it would become now.
lang_previewing(j: int): bool {
    if (!dg_on || !hv_fit) return false;
    if (j < 0) return hv_kind == T_GOAL;
    hv_kind == T_FACT && hv_j == j
}

// The term the goal shows (a preview, or gc).
lang_goal_term(gc: int): int {
    if (lang_previewing(-1) && !hv_closes && hv_goal != 0) return hv_goal;
    gc
}

lang_fact_term(j: int, h: int): int {
    if (lang_previewing(j) && hv_fact != 0) return hv_fact;
    h
}

// The thing held let go.
lang_drop(x: f32, y: f32) raises KernelError {
    if (!dg_on) return;
    lang_drag(x, y);
    dg_on = false;
    last_input_t = now_t;
    n: int = play_node();
    if (hv_fit && n >= 0) {
        if (dg_kind == DG_TOKEN) {
            if (hv_kind == T_GOAL && ps_on) {
                ps_on = false;
                lang_gesture(GS_APPLY, ps_j, dg_term, x - dg_ox, y - dg_oy);
                return
            }
            lang_gesture(GS_NOTCH, hv_j, dg_term, x - dg_ox, y - dg_oy);
            return
        }
        if (hv_wants) {
            // (It fits, once a name is dropped in: the goal waits for it.)
            ps_on = true;
            ps_j = dg_src;
            ps_t0 = now_t;
            hv_kind = T_NONE;
            return
        }
        lang_gesture(GS_APPLY, dg_src, 0, x - dg_ox, y - dg_oy);
        return
    }
    // (It does not fit: home it goes, and the place shakes no.)
    why: int = 0;
    if (hv_kind != T_NONE) {
        why = 1;
        if (dg_kind == DG_FACT && hv_kind == T_FACT && bfn_ok[mini(hv_j, BF - 1)]) why = 3;
        if (dg_kind == DG_TOKEN && hv_kind == T_GOAL && !gn_ok && !ps_on) why = 1;
        refuse(hv_kind, hv_j, why)
    }
    rb_kind = dg_kind;
    rb_src = dg_src;
    rb_term = dg_term;
    rb_x0 = x - dg_ox;
    rb_y0 = y - dg_oy;
    rb_w = dg_w;
    rb_h = dg_h;
    rb_t0 = now_t;
    hv_kind = T_NONE
}

// ---- a name still wanted (a fact put onto the goal needs one) ----
ps_on: bool = false;

ps_j: int = 0;

ps_t0: f32 = 0.0;

// ---- going home, shaking no ----
rb_t0: f32 = -10.0;

rb_kind: int = 0;

rb_src: int = 0;

rb_term: int = 0;

rb_x0: f32 = 0.0;

rb_y0: f32 = 0.0;

rb_w: f32 = 0.0;

rb_h: f32 = 0.0;

const RB_TIME: f32 = 0.42;

rb_on(): bool {
    now_t - rb_t0 < RB_TIME
}

// The place shaking (T_GOAL, or T_FACT and its number), since when.
sk_kind: int = 0;

sk_j: int = 0;

sk_t0: f32 = -10.0;

// The words under it the second time (and why: 1 the shapes differ, 2 not
// a name here, 3 that wants a name, not a statement).
wh_t0: f32 = -10.0;

wh_why: int = 0;

rf_last: int = 0;

rf_count: int = 0;

refuse(kind: int, j: int, why: int) {
    sk_kind = kind;
    sk_j = j;
    sk_t0 = now_t;
    page_vibrate(4);
    key: int = kind * 100000 + j * 1000 + dg_kind * 100 + dg_src;
    if (key == rf_last) rf_count = rf_count + 1 else {
        rf_last = key;
        rf_count = 1
    }
    if (rf_count >= 2) {
        wh_t0 = now_t;
        wh_why = why
    }
}

// How far the goal (j < 0) or fact j is shaken now.
shake_dx(kind: int, j: int): f32 {
    t: f32 = now_t - sk_t0;
    if (t < 0.0 || t > 0.42 || kind != sk_kind || kind == T_FACT && j != sk_j) return 0.0;
    busy = true;
    6.0 * sinf(t / 0.42 * 3.0 * 6.2832) * (1.0 - t / 0.42)
}

// How the goal (j < 0) or fact j swells toward the thing held over it.
pull_dx(kind: int, j: int, cx: f32): f32 {
    if (!dg_on || !hv_fit || hv_kind != kind || kind == T_FACT && hv_j != j) return 0.0;
    clampf((dg_x - cx) * 0.03, -6.0, 6.0)
}

// ---- making a gesture ----
// A gesture made by the player (the thing came from (fx, fy)).
lang_gesture(
    kind: int,
    j: int,
    t: int,
    fx: f32,
    fy: f32
) raises KernelError {
    n: int = play_node();
    if (n < 0 || done_t >= 0.0) return;
    if (staging()) close_t = now_t;
    want: int = 0;
    if (on_path == moves_made) {
        if (book_desc(moves_made, n)) want = gs_try(n, lh_kind_b, lh_j_b, lh_tok_b)
    }
    old_goal: int = pn_goal[n];
    if (j >= 0 && j < gl_hypn[old_goal]) use_fact(goal_hyp(old_goal, j));
    leaves_before = leaves_done();
    ok: bool = false;
    try {
        ok = gs_do(n, kind, j, t)
    } with KernelError -> {
        ok = false
    }
    if (!ok) {
        refuse(T_GOAL, -1, 1);
        return
    }
    c: int = gs_c;
    last_rewrite = false;
    fly_term = gs_new_fact(n, old_goal);
    fly_fact = fly_term != 0;
    fly_hl = 0;
    fly_hl_seen = false;
    fly_x0 = fx;
    fly_y0 = fy;
    fly_s0 = 18.0;
    path_toast_end();
    demo_end();
    lh_on = false;
    ps_on = false;
    if (c >= 0) trial_read(n, c);
    if (want != 0 && gs_sig(n) == want) on_path = moves_made + 1;
    moves_made = moves_made + 1;
    after_move(n, old_goal);
    lang_settle()
}

// After a move or an undo: whether the goal now can be shown at all.
dead_node: int = -1;

dead_t: f32 = -10.0;

lang_settle() {
    boxes_at = now_t + 0.9;
    dead_node = -1;
    n: int = play_node();
    if (n < 0 || on_path >= moves_made || done_t >= 0.0) return;
    par: int = 4;
    if (playing >= 0) par = ml_par[playing];
    r: int = -1;
    try {
        r = gs_dead(n, par + 3, 3000)
    } with KernelError -> {
        r = -1
    }
    if (r == 1) {
        dead_node = n;
        dead_t = now_t;
        undo_pulse_t = now_t
    }
}

lang_dead(): bool {
    dead_node >= 0 && dead_node == play_node() && done_t < 0.0
}

lang_undone() {
    ps_on = false;
    lh_on = false;
    lang_settle()
}

// A key tapped (the goal's, j < 0, or fact j's).
lang_key(j: int) raises KernelError {
    if (!lang_on() || done_t >= 0.0) return;
    last_input_t = now_t;
    ps_on = false;
    fx: f32 = gk_x0;
    fy: f32 = gk_y0;
    if (j >= 0 && j < BF) {
        fx = bfk_x0[j];
        fy = bfk_y0[j]
    }
    lang_gesture(GS_KEY, j, 0, fx, fy)
}

// A name tapped on the shelf: if a socket waits, it fills it.
lang_token_tap(k: int) raises KernelError {
    if (!ps_on || k < 0 || k >= shn_n) return;
    ps_on = false;
    lang_gesture(GS_APPLY, ps_j, shn_term[k], shn_x[k], shn_y[k])
}

// ---- the book's next gesture: a hint, Watch, Enter ----
// The book's step k as a gesture at node n (lh_kind_b, lh_j_b, lh_tok_b).
lh_kind_b: int = 0;

lh_j_b: int = -1;

lh_tok_b: int = 0;

book_desc(k: int, n: int) raises KernelError: bool {
    if (k < 0 || k >= st_n || n < 0) return false;
    s: int = st_kind[k];
    if (s < ST_OPEN) return false;
    lh_kind_b = GS_KEY;
    if (s == ST_DROP) lh_kind_b = GS_NOTCH;
    if (s == ST_APPLY) lh_kind_b = GS_APPLY;
    lh_j_b = st_hyp[k];
    lh_tok_b = 0;
    if (st_w1[k] != 0) lh_tok_b = witness_sym(n, st_w1[k], 0);
    true
}

// The hint showing: the gesture the ghost hand makes.
lh_on: bool = false;

lh_t: f32 = -10.0;

lh_kind: int = 0;

lh_j: int = -1;

lh_tok: int = 0;

lang_hint() raises KernelError: bool {
    n: int = focus_node();
    if (n < 0) return false;
    chosen_node = n;
    if (!book_desc(moves_made, n)) return false;
    lh_kind = lh_kind_b;
    lh_j = lh_j_b;
    lh_tok = lh_tok_b;
    lh_on = true;
    lh_t = now_t;
    true
}

// The bulb tapped.
lang_give_hint() raises KernelError {
    if (done_t >= 0.0 || watching) return;
    last_input_t = now_t;
    demo_end();
    if (on_path < moves_made) {
        line_clear();
        line_add("Undo ");
        line_int(moves_made - on_path);
        line_add(" to get back on the book's path");
        toast_line();
        undo_pulse_t = now_t;
        path_toast = true;
        return
    }
    if (!lang_hint()) toast("No hint here")
}

// Enter: the hinted gesture made (the book's next if none is hinted); a
// dead end undone.
lang_enter() raises KernelError {
    if (lang_dead()) {
        act(B_DEAD_UNDO);
        return
    }
    if (on_path < moves_made) {
        lang_give_hint();
        return
    }
    if (!lh_on && !lang_hint()) return;
    lh_on = false;
    lang_book_move()
}

// The book's next gesture made (as a hint shows it).
lang_book_move() raises KernelError {
    n: int = focus_node();
    if (n < 0 || !book_desc(moves_made, n)) return;
    chosen_node = n;
    fx: f32 = goal_rx + 20.0;
    fy: f32 = goal_ry;
    if (lh_kind_b == GS_NOTCH || lh_tok_b != 0) {
        for k in 0..shn_n {
            if (shn_term[k] == lh_tok_b) {
                fx = shn_x[k] - TOK_R;
                fy = shn_y[k] - TOK_R
            }
        }
    }
    lang_gesture(lh_kind_b, lh_j_b, lh_tok_b, fx, fy)
}

// Watching: each gesture shown by the ghost hand, then made.
lang_watch_step() raises KernelError {
    if (watch_phase == 0) {
        if (!lang_hint()) {
            stop_watch();
            toast("The written proof does not fit here");
            return
        }
        watch_phase = 1;
        // (A carry takes the ghost longer than a press.)
        dt: f32 = 1.0;
        if (lh_kind != GS_KEY) dt = 1.9;
        watch_at = now_t + dt * watch_pace;
        return
    }
    lh_on = false;
    lang_book_move();
    watch_next()
}

// ---- drawn over the board ----
// The thing held, the thing going home, the words of a refusal, and the
// ghost hand of a hint.
draw_lang_top(x: f32, w: f32) {
    if (dg_on) draw_held(dg_kind, dg_term, dg_x - dg_ox, dg_y - dg_oy, dg_w, dg_h,
        1.0, true);
    if (rb_on()) {
        t: f32 = (now_t - rb_t0) / RB_TIME;
        busy = true;
        hx: f32 = rb_x0;
        hy: f32 = rb_y0;
        if (rb_kind == DG_TOKEN && rb_src < shn_n) {
            hx = shn_x[rb_src] - TOK_R;
            hy = shn_y[rb_src] - TOK_R
        } else if (rb_kind == DG_FACT && rb_src < bf_n) {
            hx = bf_x0[rb_src];
            hy = bf_y0[rb_src]
        }
        // (Home, past it a little and back: a damped wobble.)
        k: f32 = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);
        k = k + sinf(t * 3.1416 * 2.0) * 0.08 * (1.0 - t);
        draw_held(rb_kind, rb_term, rb_x0 + (hx - rb_x0) * k, rb_y0 + (hy - rb_y0) * k,
            rb_w, rb_h, 1.0 - t * 0.3, false)
    }
    draw_whisper();
    draw_lang_ghost();
    draw_lang_demo_words(x, w);
    draw_pending()
}

// A thing held (or going home) with its top left at (x, y).
draw_held(
    kind: int,
    t: int,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    a: f32,
    lifted: bool
) {
    // (Lifted: bigger, its shadow deeper, squashed along how it moves.)
    sp: f32 = 0.0;
    if (lifted) sp = clampf(sqrtf(dg_vx * dg_vx + dg_vy * dg_vy) / 2400.0, 0.0, 0.12);
    sx: f32 = 1.0;
    sy: f32 = 1.0;
    if (lifted) {
        sx = 1.08;
        sy = 1.08;
        if (absf(dg_vx) > absf(dg_vy)) {
            sx = sx + sp;
            sy = sy - sp * 0.6
        } else {
            sy = sy + sp;
            sx = sx - sp * 0.6
        }
    }
    if (kind == DG_TOKEN) {
        cx: f32 = x + TOK_R;
        cy: f32 = y + TOK_R;
        p_shadow(cx - TOK_R * sx, cy - TOK_R * sy + 6.0, 2.0 * TOK_R * sx, 2.0 * TOK_R * sy,
            TOK_R, 6.0, 12.0, 0.25 * a);
        kd: int = 0;
        for k in 0..shn_n {
            if (shn_term[k] == t) kd = shn_kind[k]
        }
        draw_token(t, kd, cx, cy, (sx + sy) * 0.5, a);
        return
    }
    cw: f32 = w * sx;
    ch: f32 = h * sy;
    cx: f32 = x + w * 0.5 - cw * 0.5;
    cy: f32 = y + h * 0.5 - ch * 0.5;
    p_shadow(cx, cy, cw, ch, minf(16.0, ch * 0.5), 10.0, 18.0, 0.28 * a);
    p_box(cx, cy, cw, ch, minf(16.0, ch * 0.5), mix_rgb(C_BLUE_SOFT, C_WHITE, 0.3),
        a);
    p_outline(cx, cy, cw, ch, minf(16.0, ch * 0.5), 2.0, mix_rgb(C_BLUE_SOFT, C_BLUE,
        0.4), a);
    an_live = false;
    lay_one_line = true;
    e: int = lay_term(t, 22.0 * sy, cw - 28.0, 9500000);
    lay_one_line = false;
    if (e >= 0) draw_expr(e, cx + 14.0, cy + (ch - ex_h[e]) * 0.5, C_INK, a, false);
    an_live = true
}

// The words of a refusal, grey, under the place, for a moment.
draw_whisper() {
    t: f32 = now_t - wh_t0;
    if (t < 0.0 || t > 2.2) return;
    busy = true;
    a: f32 = clampf(t * 6.0, 0.0, 1.0) * clampf((2.2 - t) * 3.0, 0.0, 1.0);
    s: str = "Doesn't match";
    if (wh_why == 2) s = "Not a name here";
    if (wh_why == 3) s = "That needs a name, not a statement";
    y: f32 = goal_ry + goal_rh + 18.0;
    cx: f32 = goal_rx + goal_rw * 0.5;
    if (sk_kind == T_FACT && sk_j < bf_n) {
        y = bf_y1[sk_j] + 14.0;
        cx = (bf_x0[sk_j] + bf_x1[sk_j]) * 0.5
    }
    tw: f32 = p_str_w(0, 13.0, s) + 22.0;
    p_box(cx - tw * 0.5, y - 14.0, tw, 22.0, 11.0, C_INK, 0.6 * a);
    p_str_mid(0, 13.0, cx, y + 1.5, s, C_WHITE, a)
}

// A fact put onto the goal waits for its name: a socket on the goal.
draw_pending() {
    if (!ps_on || done_t >= 0.0) return;
    busy = true;
    sx: f32 = goal_rx + goal_rw - 58.0;
    sy: f32 = goal_ry - 14.0;
    g: f32 = 0.5 + 0.5 * sinf((now_t - ps_t0) * 5.0);
    p_shadow(sx, sy, 50.0, 30.0, 12.0, 2.0, 6.0, 0.2);
    p_box(sx, sy, 50.0, 30.0, 12.0, C_PICK, 1.0);
    p_box(sx + 10.0, sy + 6.0, 30.0, 18.0, 7.0, mix_rgb(C_SUNK, C_SHADOW, 0.1), 1.0);
    p_outline(sx + 10.0, sy + 6.0, 30.0, 18.0, 7.0, 1.5 + g, C_WHITE, 1.0);
    p_str(1, 12.0, goal_rx + goal_rw - 160.0, goal_ry - 4.0, "a name for it?", C_PICK,
        1.0)
}

// The ghost hand of a hint: it presses the key, or carries the thing to
// where it goes, over and over.
draw_lang_ghost() {
    if (!lh_on || done_t >= 0.0 || dg_on) return;
    if (intro_open || chapter_open) return;
    t: f32 = now_t - lh_t;
    if (demo_kind == 0 && !watching && t > 6.0) {
        lh_on = false;
        return
    }
    busy = true;
    if (lh_kind == GS_KEY) {
        ok: bool = false;
        tx: f32 = 0.0;
        ty: f32 = 0.0;
        if (lh_j < 0 && gk_ok) {
            tx = (gk_x0 + gk_x1) * 0.5 + 10.0;
            ty = gk_y1 + 24.0;
            ok = true
        } else if (lh_j >= 0 && lh_j < BF && bfk_ok[lh_j]) {
            tx = (bfk_x0[lh_j] + bfk_x1[lh_j]) * 0.5 + 10.0;
            ty = bfk_y1[lh_j] + 24.0;
            ok = true
        }
        if (ok) ghost_go(tx, ty);
        return
    }
    // (From the name, or the fact's card, to where it goes.)
    fx: f32 = 0.0;
    fy: f32 = 0.0;
    tx: f32 = goal_rx + goal_rw * 0.5;
    ty: f32 = goal_ry + goal_rh * 0.5;
    carry_tok: bool = lh_kind == GS_NOTCH;
    if (lh_kind == GS_NOTCH) {
        found: bool = false;
        for k in 0..shn_n {
            if (shn_term[k] == lh_tok) {
                fx = shn_x[k];
                fy = shn_y[k];
                found = true
            }
        }
        if (!found) return;
        if (lh_j < 0 && gn_ok) {
            tx = (gn_x0 + gn_x1) * 0.5;
            ty = (gn_y0 + gn_y1) * 0.5
        } else if (lh_j >= 0 && lh_j < BF && bfn_ok[lh_j]) {
            tx = (bfn_x0[lh_j] + bfn_x1[lh_j]) * 0.5;
            ty = (bfn_y0[lh_j] + bfn_y1[lh_j]) * 0.5
        } else return
    } else {
        if (lh_j < 0 || lh_j >= bf_n) return;
        fx = bf_x0[lh_j] + 40.0;
        fy = (bf_y0[lh_j] + bf_y1[lh_j]) * 0.5
    }
    cyc: f32 = 2.0;
    c: f32 = t - floorf(t / cyc) * cyc;
    k: f32 = clampf((c - 0.35) / 0.9, 0.0, 1.0);
    k = k * k * (3.0 - 2.0 * k);
    a: f32 = clampf(c / 0.2, 0.0, 1.0) * clampf((cyc - c) / 0.3, 0.0, 1.0);
    gx: f32 = fx + (tx - fx) * k;
    gy: f32 = fy + (ty - fy) * k - sinf(k * 3.1416) * 30.0;
    if (carry_tok) {
        kd: int = 0;
        for i in 0..shn_n {
            if (shn_term[i] == lh_tok) kd = shn_kind[i]
        }
        draw_token(lh_tok, kd, gx, gy, 0.9, 0.55 * a)
    } else if (lh_j >= 0 && lh_j < bf_n) {
        bw: f32 = minf(bf_x1[lh_j] - bf_x0[lh_j], 180.0);
        p_box(gx - 30.0, gy - 16.0, bw, 32.0, 14.0, C_BLUE_SOFT, 0.6 * a);
        p_outline(gx - 30.0, gy - 16.0, bw, 32.0, 14.0, 2.0, C_BLUE, 0.35 * a)
    }
    r: f32 = 17.0;
    p_shadow(gx - r, gy - r + 18.0, 2.0 * r, 2.0 * r, r, 3.0, 10.0, 0.22 * a);
    p_disc(gx, gy + 14.0, r, C_WHITE, 0.7 * a);
    p_ring(gx, gy + 14.0, r, 2.5, C_INK, 0.35 * a)
}

// What a demo says, the first time a level brings a word in.
draw_lang_demo_words(x: f32, w: f32) {
    if (demo_kind == 0 || watching || intro_open || now_t < demo_t0 || done_t >= 0.0) return;
    s: str = "Tap the raised key to open it.";
    if (demo_kind == sym("goalkey")) s = "The goal has a key too. Tap it.";
    if (demo_kind == sym("drag")) s = "Drag a fact onto the goal.";
    if (demo_kind == sym("token")) s = "Names sit on the shelf. Drag one into a notch.";
    if (demo_kind == sym("notch")) s = "A notch on the goal wants a name. Drop one in.";
    if (demo_kind == sym("some")) s = "Open the fact's key first: a blue name, a particular one.";
    a: f32 = clampf((now_t - demo_t0) * 4.0, 0.0, 1.0);
    busy = true;
    tw: f32 = p_str_w(1, 14.0, s) + 32.0;
    fs: f32 = 14.0;
    if (tw > w) {
        fs = 14.0 * w / tw;
        tw = w
    }
    bx: f32 = x + w * 0.5 - tw * 0.5;
    by: f32 = bar_bottom_y + 6.0;
    if (pic_bottom_y > 0.0) by = pic_bottom_y - 48.0;
    p_shadow(bx, by, tw, 36.0, 18.0, 3.0, 10.0, 0.16 * a);
    p_box(bx, by, tw, 36.0, 18.0, C_INK, 0.88 * a);
    p_str_mid(1, fs, x + w * 0.5, by + 23.0, s, C_WHITE, a)
}

// A goal that cannot be shown: grey, dashed, the words on its top edge, a
// way back on its corner.
draw_dead_goal(
    x: f32,
    y: f32,
    w: f32,
    h: f32
) {
    t: f32 = clampf((now_t - dead_t) / 0.3, 0.0, 1.0);
    if (t < 1.0) busy = true;
    // (Dashes round it.)
    col: int = mix_rgb(C_RED, C_MUTED, 0.45);
    dl: f32 = 12.0;
    gap: f32 = 8.0;
    xx: f32 = x + 18.0;
    while (xx + dl < x + w - 18.0) {
        p_box(xx, y - 1.5, dl, 3.0, 1.5, col, t);
        p_box(xx, y + h - 1.5, dl, 3.0, 1.5, col, t);
        xx = xx + dl + gap
    }
    yy: f32 = y + 18.0;
    while (yy + dl < y + h - 18.0) {
        p_box(x - 1.5, yy, 3.0, dl, 1.5, col, t);
        p_box(x + w - 1.5, yy, 3.0, dl, 1.5, col, t);
        yy = yy + dl + gap
    }
    // (The words, on its top edge.)
    s: str = "Can't be shown from what you have";
    tw: f32 = p_str_w(1, 12.5, s) + 24.0;
    p_box(x + 14.0, y - 12.0, tw, 24.0, 12.0, mix_rgb(C_RED, C_BG, 0.86), t);
    p_outline(x + 14.0, y - 12.0, tw, 24.0, 12.0, 1.2, mix_rgb(C_RED, C_BG, 0.55),
        t);
    p_str(1, 12.5, x + 26.0, y + 4.5, s, mix_rgb(C_RED, C_INK, 0.45), t);
    // (Undo k, bobbing on its corner.)
    line_clear();
    line_add("Undo ");
    line_int(dead_undo_k());
    k: f32 = pressed(B_DEAD_UNDO);
    pw: f32 = p_line_w(1, 16.0) + 52.0;
    ph: f32 = 38.0;
    px: f32 = x + w - pw + 8.0;
    py: f32 = y + h - 18.0 + sinf(now_t * 3.5) * 3.0 + k * 2.0;
    busy = true;
    p_shadow(px, py, pw, ph, 19.0, 3.0 - k * 2.0, 8.0, 0.2 * t);
    p_box(px, py, pw, ph, 19.0, C_PICK, t);
    p_disc(px + 19.0, py + 19.0, 11.0, C_WHITE, t);
    draw_icon(I_UNDO, px + 19.0, py + 19.0, 6.0, C_PICK, t);
    p_line_text(1, 16.0, px + 36.0, py + 25.0, C_WHITE, t);
    add_button(B_DEAD_UNDO, px, py, px + pw, py + ph)
}

// ---- for pictures: the board's places, printed (L8_BOXES) ----
boxes_on: bool = false;

boxes_at: f32 = -1.0;

boxes_print() {
    if (!boxes_on || boxes_at < 0.0 || now_t < boxes_at || !lang_on()) return;
    boxes_at = -1.0;
    n: int = play_node();
    line_clear();
    line_add("-- board at ");
    line_int((now_t * 100.0) as int);
    line_add(" (moves ");
    line_int(moves_made);
    line_add(", on the book's path ");
    line_int(on_path);
    if (lang_dead()) line_add(", DEAD");
    if (done_t >= 0.0) line_add(", DONE");
    line_add(")");
    line_print_safe();
    if (n >= 0) {
        g: int = pn_goal[n];
        box_line("goal", -1, gl_concl[g], goal_rx, goal_ry, goal_rx + goal_rw, goal_ry + goal_rh);
        if (gk_ok) box_line("  key", -1, 0, gk_x0, gk_y0, gk_x1, gk_y1);
        if (gn_ok) box_line("  notch", -1, 0, gn_x0, gn_y0, gn_x1, gn_y1);
        for i in 0..bf_n {
            box_line("fact", i, bf_term[i], bf_x0[i], bf_y0[i], bf_x1[i], bf_y1[i]);
            if (bfk_ok[i]) box_line("  key", -1, 0, bfk_x0[i], bfk_y0[i], bfk_x1[i],
                bfk_y1[i]);
            if (bfn_ok[i]) box_line("  notch", -1, 0, bfn_x0[i], bfn_y0[i], bfn_x1[i],
                bfn_y1[i])
        }
        for k in 0..shn_n box_line(token_word(shn_kind[k]), -1, shn_term[k], shn_x[k] - TOK_R,
            shn_y[k] - TOK_R, shn_x[k] + TOK_R, shn_y[k] + TOK_R)
    }
}

token_word(kind: int): str {
    if (kind == 1) return "token(any)";
    if (kind == 2) return "token(some)";
    "token"
}

box_line(
    what: str,
    i: int,
    t: int,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    ts: int = 0;
    if (t != 0) {
        show_line(t);
        ts = line_sym_now()
    }
    line_clear();
    line_add(what);
    if (i >= 0) {
        line_add(" ");
        line_int(i)
    }
    line_add(" ");
    line_int(x0 as int);
    line_add(",");
    line_int(y0 as int);
    line_add(" ");
    line_int(x1 as int);
    line_add(",");
    line_int(y1 as int);
    if (ts != 0) {
        line_add("  ");
        line_sym(ts)
    }
    line_print_safe()
}
