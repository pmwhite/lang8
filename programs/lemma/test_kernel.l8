tag lemma_tests;

use_tag std, lemma;

// The kernel's rules on small propositions.
import "../../stdlib/print.l8";

import "text.l8";

import "kernel.l8";

test "for all and implies" {
    kernel_init();
    a: int = mk_tcon(sym("a"));
    p: int = mk_free(sym("P"), mk_fun(a, prop_type()));
    x: int = mk_free(sym("x"), a);
    px: int = mk_app(p, x);
    th: int = implies_intro(px, assume(px));
    print_bool(is_imp(thm_prop(th)));
    print_int(thm_hyp_count(th));
    g: int = forall_intro(x, th);
    print_bool(is_all(thm_prop(g)));
    y: int = mk_free(sym("y"), a);
    back: int = forall_elim(y, g);
    print_bool(lhs_of(thm_prop(back)) == mk_app(p, y));
    expect {|
        true
        0
        true
        true
    |}
}

test "a free variable in a hypothesis cannot be generalized" {
    kernel_init();
    a: int = mk_tcon(sym("a"));
    p: int = mk_free(sym("P"), mk_fun(a, prop_type()));
    x: int = mk_free(sym("x"), a);
    try {
        forall_intro(x, assume(mk_app(p, x)));
        print("generalized")
    } with KernelError -> {
        print(kernel_why)
    }
    expect {|
        forall_intro: the variable is in a hypothesis
    |}
}

test "beta and eta" {
    kernel_init();
    a: int = mk_tcon(sym("a"));
    f: int = mk_free(sym("f"), mk_fun(a, a));
    x: int = mk_free(sym("x"), a);
    lam: int = mk_abs(x, mk_app(f, x));
    print_bool(norm(lam) == f);
    y: int = mk_free(sym("y"), a);
    redex: int = mk_app(mk_abs(x, mk_app(f, mk_app(f, x))), y);
    print_bool(norm(redex) == mk_app(f, mk_app(f, y)));
    th: int = combination(reflexive(lam), reflexive(y));
    print_bool(lhs_of(thm_prop(th)) == mk_app(f, y));
    expect {|
        true
        true
        true
    |}
}
