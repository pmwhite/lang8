tag lemma;

use_tag std;

import "../../stdlib/raw_write.l8";

// Read into reusable permanent scratch. keep_file copies retained theory text;
// read_progress consumes its input before another read. Capacity is one MiB.
whole_bytes: []i8 = static_buffer([1048576]i8);

extern lemma_file_exit(code: int): noreturn = exit;

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

// The bytes read by the last read_whole.
whole_n: int = 0;

read_whole(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    whole_n = 0;
    if (fd < 0) {
        whole_n = -1;
        return whole_bytes
    }
    buf: []i8 = whole_bytes;
    more: bool = true;
    while (more) {
        if (whole_n == len(buf)) {
            // Probe one byte so a file exactly at capacity is still accepted.
            probe: []i8 = buffer(1, 0i8);
            extra: int = read(fd, probe, 1);
            if (extra > 0) {
                close(fd);
                raw::raw_write(2, "lemma: file exceeds 1048576 bytes\n");
                lemma_file_exit(1)
            }
            if (extra != -4) {
                if (extra < 0) whole_n = -1;
                more = false
            }
        } else {
            r: int = read(fd, buf, whole_n, len(buf) - whole_n);
            if (r != -4) {
                if (r < 0) whole_n = -1;
                if (r <= 0) more = false else whole_n = whole_n + r
            }
        }
    }
    close(fd);
    buf
}
