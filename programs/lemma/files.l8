tag lemma;

use_tag std;

// Files read whole (each into a buffer of its own, kept).
extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

// The bytes read by the last read_whole.
whole_n: int = 0;

read_whole(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    whole_n = 0;
    if (fd < 0) {
        whole_n = -1;
        return new i8[1](0i8)
    }
    buf: []i8 = new i8[65536](0i8);
    more: bool = true;
    while (more) {
        if (whole_n == len(buf)) {
            bigger: []i8 = new i8[len(buf) * 2](0i8);
            for i in 0..whole_n bigger[i] = buf[i];
            buf = bigger
        }
        r: int = read(fd, buf, whole_n, len(buf) - whole_n);
        if (r <= 0) more = false else whole_n = whole_n + r
    }
    close(fd);
    buf
}
