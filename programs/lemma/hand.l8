tag lemma_ui;

use_tag std, skate, lemma;

// The hand: the moves that can be made now, each a row that shows what it
// gives. The player works on one statement at a time (the focus: the goal,
// or a fact), and the hand holds its moves: when the whole of it is
// focused, its own moves and every rewrite anywhere inside it that does
// not make it bigger; when the cursor is on a part, every rewrite of that
// part, the growing ones too (b to e · b). Every row is a candidate
// moves.l8 found, tried on the proof (and taken back) to see what it gives;
// one the kernel will not have is not shown.
//
// ---- the focus ----
// The statement worked on: the goal, or a fact (by its term).
fc_goal: bool = true;

fc_term: int = 0;

// The cursor: a place in the focused statement (0: the whole of it).
cur_at: int = 0;

// The focused fact's number in the goal played now, or -1 for the goal.
focus_hyp(): int {
    if (fc_goal) return -1;
    n: int = play_node();
    if (n < 0) return -1;
    g: int = pn_goal[n];
    for i in 0..gl_hypn[g] {
        if (goal_hyp(g, i) == fc_term) return i
    }
    -1
}

// The slot the focused statement is shown in.
focus_slot(): int {
    if (focus_hyp() < 0) return SLOT_GOAL;
    hyp_slot(fc_term)
}

focus_on_goal() {
    fc_goal = true;
    fc_term = 0;
    cur_at = 0;
    more_open = false
}

focus_on_fact(h: int) {
    fc_goal = false;
    fc_term = h;
    cur_at = 0;
    more_open = false;
    touch_fact(h)
}

// ---- the places of the focused statement, in reading order ----
// The whole first, then each part from the outside in: each its path
// (steps from pc_s0 in pc_pool) and the key its block has on the board.
const PLACES: int = 256;

pc_s0: []int = new int[PLACES](0);

pc_sn: []int = new int[PLACES](0);

pc_key: []int = new int[PLACES](0);

pc_n: int = 0;

pc_pool: []int = new int[16384](0);

pc_pool_n: int = 0;

places_build(t: int) {
    pc_n = 0;
    pc_pool_n = 0;
    ev_n = 0;
    bn_n = 0;
    path_n = 1;
    show_display = true;
    show(t, 0, 0);
    show_display = false;
    first: bool = true;
    for i in 0..ev_n {
        if (ev_kind[i] == EV_OPEN && pc_n < PLACES) {
            s: int = ev_a[i];
            occ: int = 0;
            for j in 0..i {
                if (ev_kind[j] == EV_OPEN && ev_a[j] == s) occ = occ + 1
            }
            key: int = s * 16 + mini(occ, 15);
            // (Not a bound name, nor a function by itself: no move fits.)
            keep: bool = first || tm_kind(s) != TM_BOUND && ty_kind(tm_type(s)) != TY_FUN;
            if (keep) {
                p: int = ev_b[i];
                d: int = path_depth[p];
                if (pc_pool_n + d <= len(pc_pool)) {
                    pc_s0[pc_n] = pc_pool_n;
                    pc_sn[pc_n] = d;
                    k: int = d - 1;
                    while (k >= 0 && p != 0) {
                        pc_pool[pc_pool_n + k] = path_step[p];
                        p = path_parent[p];
                        k = k - 1
                    }
                    // (Only a place whose path leads to its term: a block
                    // drawn for a part of a binder's condition has none.)
                    if (first || d > 0 && raw_at(t, pc_pool, pc_pool_n, d) == s) {
                        pc_pool_n = pc_pool_n + d;
                        pc_key[pc_n] = key;
                        pc_n = pc_n + 1
                    }
                }
            }
            first = false
        }
    }
}

// Place p's path into sub_steps.
place_steps(p: int) {
    sub_n = pc_sn[p];
    for i in 0..sub_n sub_steps[i] = pc_pool[pc_s0[p] + i]
}

// The place whose block has this key, or -1.
place_of_key(key: int): int {
    for p in 0..pc_n {
        if (pc_key[p] == key) return p
    }
    -1
}

// The cursor stepped on (or back), round the places.
cursor_step(d: int) raises KernelError {
    if (chip_row >= 0 || pc_n == 0) return;
    cur_at = (cur_at + d + pc_n) % pc_n;
    more_open = false;
    hint_row = -1;
    hand_build();
    cursor_moved()
}

// The cursor moved by the player: a swipe demo is done, and the move to
// make there glows.
cursor_moved() raises KernelError {
    if (demo_kind != sym("swipe")) return;
    demo_end();
    demo_hint()
}

// The term at a path (raw: under a binder, its bound names left bound).
raw_at(
    t: int,
    steps: []int,
    from: int,
    n: int
): int {
    s: int = t;
    for i in 0..n {
        st: int = steps[from + i];
        k: int = tm_kind(s);
        if (st == P_FUN && k == TM_APP) s = tm_fun(s) else if (st == P_ARG && k == TM_APP) s = tm_arg(s) else if (st == P_BODY && k == TM_ABS) s = tm_body(s) else return 0
    }
    s
}

// How many nodes a term has (how big it is).
term_size(t: int): int {
    k: int = tm_kind(t);
    if (k == TM_APP) return 1 + term_size(tm_fun(t)) + term_size(tm_arg(t));
    if (k == TM_ABS) return 1 + term_size(tm_body(t));
    1
}

// ---- a move tried, and taken back ----
// What it gave: a fingerprint of the goals it leaves (equal moves give
// equal ones), what to show (the statement as it will be, or the new
// fact; a second goal or fact), its changed part, and whether it closes
// the goal.
tr_sig: int = 0;

tr_res: int = 0;

tr_res2: int = 0;

tr_fact: bool = false;

tr_fact2: bool = false;

tr_hl: int = 0;

tr_closes: bool = false;

// Whether what it gives is parts each closed (shown ticked).
tr_ticks: bool = false;

tr_calc: bool = false;

// Whether a move that closes the goal at once shows the fact it gave (a
// chip's row) rather than the goal closed.
tr_want_fact: bool = false;

// Candidate c tried at node n, with its witnesses: whether the kernel took
// it. The proof is as it was afterwards.
trial(
    n: int,
    c: int,
    wits: []int,
    wn: int
) raises KernelError: bool {
    s_pn: int = pn_n;
    s_gl: int = gl_n;
    s_gp: int = gpool_n;
    s_kp: int = kpool_n;
    s_mv: int = mv_n;
    s_last: int = last_move;
    ok: bool = true;
    try {
        last_move = cand_apply(n, c, wits, wn);
        auto_close()
    } with KernelError -> {
        ok = false
    }
    if (ok) trial_read(n, c);
    reopen(n);
    // (The lists a goal is made from are left as they were: a fresh name
    // is fresh in the goal, not in the goal tried.)
    nf_n = 0;
    nh_n = 0;
    pn_n = s_pn;
    gl_n = s_gl;
    gpool_n = s_gp;
    kpool_n = s_kp;
    mv_n = s_mv;
    last_move = s_last;
    ok
}

// The goals left under node n (open leaves), into tl_.
tl_node: []int = new int[64](0);

tl_n: int = 0;

open_under(n: int) {
    if (pn_thm[n] != 0) return;
    if (pn_move[n] < 0) {
        if (tl_n < len(tl_node)) {
            tl_node[tl_n] = n;
            tl_n = tl_n + 1
        }
        return
    }
    for i in 0..pn_kidn[n] open_under(node_kid(n, i))
}

// Whether a leaf under n was closed by Calculate.
calc_under(n: int): bool {
    m: int = pn_move[n];
    if (m < 0) return false;
    if (mv_kind[m] == MV_CALC) return true;
    for i in 0..pn_kidn[n] {
        if (calc_under(node_kid(n, i))) return true
    }
    false
}

// What node n's move (candidate c) gave, read off the proof; a move that
// closes the goal shows what it closed as: the goal as the move left it
// (c = c, both sides the same; struck through if arithmetic closed it).
trial_read(n: int, c: int) raises KernelError {
    trial_read0(n, c);
    tr_strike = false;
    tr_same = false;
    if (!tr_closes || tr_ticks) return;
    // (A chip: the fact its term gives, though it closes the goal at once.)
    if (tr_want_fact && tr_fact && tr_res != 0) return;
    if (tr_res == 0 && cd_kind[c] == C_BACK && cd_hyp[c] >= 0 && pn_kidn[n] == 0) {
        // (A fact taken apart into just the goal: the goal, as a new fact.)
        tr_res = gl_concl[pn_goal[n]];
        tr_fact = true;
        return
    }
    if (tr_res == 0 || !tr_fact && tr_res == gl_concl[pn_goal[n]]) {
        tr_res = closed_shown(n);
        tr_res2 = 0;
        tr_fact = false;
        tr_fact2 = false
    }
    if (tr_fact) return;
    tr_strike = tr_calc;
    q: int = rel_core(tr_res);
    if (is_binary(q, role_name[ROLE_EQ]) && spine_arg(q, 2, 0) == spine_arg(q, 2,
        1)) {
        tr_same = true;
        tr_hl = 0
    }
}

// The fact a move at node n gave, in a goal under it that still shows
// goal g (its main goal, not a side condition), or 0.
fact_given(n: int, g: int): int {
    if (pn_move[n] < 0 || pn_kidn[n] == 0) {
        kg: int = pn_goal[n];
        if (gl_concl[kg] != gl_concl[g]) return 0;
        r: int = 0;
        for j in 0..gl_hypn[kg] {
            h: int = goal_hyp(kg, j);
            if (!goal_has_hyp(g, h)) r = h
        }
        return r
    }
    for i in 0..pn_kidn[n] {
        r: int = fact_given(node_kid(n, i), g);
        if (r != 0) return r
    }
    0
}

// A side condition the move tried leaves open (another goal than the
// goal), or 0.
tr_need: int = 0;

// Whether the move tried has holes for its terms.
tr_holed: bool = false;

// Whether what a closing move gives is struck through (arithmetic closed
// it), or an equation with its two sides the same (shown gold).
tr_strike: bool = false;

tr_same: bool = false;

// The goal a move at node n closed, as it is shown closing: the last goal
// under n it proved (what a rewrite made it, a fact it matched, or
// arithmetic's), into closed_leaf; a goal a rule matched whole is shown as
// its smaller side twice.
closed_leaf: int = -1;

closed_shown(n: int) raises KernelError: int {
    lf_n = 0;
    leaves(n);
    leaf: int = n;
    for i in 0..lf_n {
        if (pn_thm[lf_node[i]] != 0 && !quiet_leaf(lf_node[i])) leaf = lf_node[i]
    }
    closed_leaf = leaf;
    t: int = gl_concl[pn_goal[leaf]];
    q: int = rel_core(t);
    if (leaf == n && is_binary(q, role_name[ROLE_EQ]) && spine_arg(q, 2, 0) != spine_arg(q,
        2, 1)) {
        sl: int = spine_arg(q, 2, 0);
        if (term_size(spine_arg(q, 2, 1)) < term_size(sl)) sl = spine_arg(q, 2, 1);
        return mk_app(mk_app(spine_head(q), sl), sl)
    }
    t
}

trial_read0(n: int, c: int) raises KernelError {
    g: int = pn_goal[n];
    tr_closes = pn_thm[n] != 0;
    tr_calc = tr_closes && calc_under(n);
    tr_res = 0;
    tr_res2 = 0;
    tr_fact = false;
    tr_fact2 = false;
    tr_hl = 0;
    tl_n = 0;
    open_under(n);
    sig: int = 7;
    for i in 0..tl_n sig = (sig * 1000003 + goal_prop(pn_goal[tl_node[i]])) % 2147483647;
    if (tl_n == 0) sig = 1;
    tr_sig = sig;
    // (A goal left that is not the goal: a side condition still open.)
    tr_need = 0;
    for i in 0..tl_n {
        cg: int = gl_concl[pn_goal[tl_node[i]]];
        if (cg != gl_concl[g] && tr_need == 0) tr_need = cg
    }
    tr_ticks = false;
    if ((tr_holed || tr_want_fact) && cd_kind[c] != C_REWRITE) {
        // (A move tried with a hole for its term, or a term picked: the
        // fact it gives (with the hole); not its side condition, which
        // arithmetic closes once the term is there.)
        tr_res = fact_given(n, g);
        if (tr_res != 0) {
            tr_fact = true;
            return
        }
    }
    sc: int = rel_core(gl_concl[g]);
    if (tl_n == 0 && cd_label[c] == sym("Split") && spine_len(sc) == 2) {
        // (Split, both parts known: each part, ticked.)
        tr_res = spine_arg(sc, 2, 0);
        tr_res2 = spine_arg(sc, 2, 1);
        tr_ticks = true;
        return
    }
    kg: int = 0;
    if (tl_n > 0) kg = pn_goal[tl_node[0]] else if ((cd_kind[c] == C_REWRITE || tr_want_fact) && pn_kidn[n] > 0) kg = pn_goal[node_kid(n,
        0)] else return;
    if (cd_kind[c] == C_REWRITE) {
        steps_n: int = cd_pathn[c];
        if (cd_in[c] >= 0 && cd_in[c] < gl_hypn[kg]) {
            tr_res = goal_hyp(kg, cd_in[c]);
            tr_fact = true
        } else tr_res = gl_concl[kg];
        tr_hl = raw_at(tr_res, cpool, cd_path0[c], steps_n);
        return
    }
    // (A new fact: the last the move brought in.)
    newh: int = 0;
    for i in 0..gl_hypn[kg] {
        h: int = goal_hyp(kg, i);
        if (!goal_has_hyp(g, h)) newh = h
    }
    if (gl_concl[kg] != gl_concl[g]) {
        tr_res = gl_concl[kg];
        tr_res2 = newh;
        tr_fact2 = newh != 0
    } else {
        tr_res = newh;
        tr_fact = true;
        if (newh == 0) tr_res = gl_concl[kg]
    }
    if (tl_n > 1) {
        tr_res2 = gl_concl[pn_goal[tl_node[1]]];
        tr_fact2 = false
    }
}

// ---- the rows ----
const ROWS: int = 128;

// Each row: where its move is found (in the goal, -1, or fact `src`; the
// whole statement, or the part at its path in hd_pool), the candidate's
// number there, its words and verb, what it gives (as tried), and whether
// it needs a term picked, is low (under More), or is a theorem the player
// proved.
hd_src: []int = new int[ROWS](-1);

hd_whole: []bool = new bool[ROWS](true);

hd_p0: []int = new int[ROWS](0);

hd_pn: []int = new int[ROWS](0);

hd_c: []int = new int[ROWS](0);

hd_label: []int = new int[ROWS](0);

hd_verb: []int = new int[ROWS](0);

hd_res: []int = new int[ROWS](0);

hd_res2: []int = new int[ROWS](0);

hd_fact: []bool = new bool[ROWS](false);

hd_fact2: []bool = new bool[ROWS](false);

hd_hl: []int = new int[ROWS](0);

hd_closes: []bool = new bool[ROWS](false);

hd_calc: []bool = new bool[ROWS](false);

hd_wit: []bool = new bool[ROWS](false);

hd_low: []bool = new bool[ROWS](false);

// A row that gives back a state the proof was in (shown soft, as Back).
hd_back: []bool = new bool[ROWS](false);

hd_tool: []bool = new bool[ROWS](false);

// The term a row's move takes already (picked by matching the goal), or 0.
hd_pre: []int = new int[ROWS](0);

hd_ticks: []bool = new bool[ROWS](false);

hd_strike: []bool = new bool[ROWS](false);

hd_same: []bool = new bool[ROWS](false);

hd_sig: []int = new int[ROWS](0);

hd_sort: []int = new int[ROWS](0);

hd_n: int = 0;

hd_pool: []int = new int[16384](0);

hd_pool_n: int = 0;

// The rows in the order shown (primary first), and how many are primary.
hd_order: []int = new int[ROWS](0);

hd_prim: int = 0;

// Whether More is open (every row shown).
more_open: bool = false;

// The row choosing a term now (its chips shown), or -1.
chip_row: int = -1;

// The labels the level's written proof uses (a low move it uses is not
// put under More).
script_uses(label: int): bool {
    for s in 0..st_n {
        if (st_label[s] == label) return true
    }
    false
}

low_label(label: int): bool {
    label == sym("Suppose not") || label == sym("Flip sides")
}

// The rows for the focus now.
hand_build() raises KernelError {
    hd_n = 0;
    hd_pool_n = 0;
    hd_prim = 0;
    chip_row = -1;
    // (The board as a language has no hand.)
    if (lang_on()) return;
    nf_n = 0;
    nh_n = 0;
    n: int = play_node();
    if (n < 0 || done_t >= 0.0) return;
    g: int = pn_goal[n];
    j: int = focus_hyp();
    if (j < 0) fc_goal = true;
    target: int = gl_concl[g];
    if (j >= 0) target = goal_hyp(g, j);
    places_build(target);
    if (cur_at >= pc_n) cur_at = 0;
    // (The states the proof has been in: a move back to one is low.)
    an_sig_n = 0;
    a: int = n;
    while (a >= 0 && an_sig_n < len(an_sig)) {
        an_sig[an_sig_n] = (7 * 1000003 + goal_prop(pn_goal[a])) % 2147483647;
        an_sig_n = an_sig_n + 1;
        a = pn_parent[a]
    }
    if (cur_at == 0) {
        if (j < 0) cands_goal(n) else cands_hyp(n, j);
        rows_from_cands(n, j, -1, target, false);
        if (j < 0) {
            for i in 0..gl_hypn[g] {
                nf_n = 0;
                nh_n = 0;
                cands_hyp(n, i);
                rf_pre = true;
                rows_from_cands(n, i, -1, target, false);
                rf_pre = false
            }
        }
        hd_parts = false;
        for p in 1..pc_n {
            place_steps(p);
            nf_n = 0;
            nh_n = 0;
            cands_sub(n, j);
            if (cd_shown > 0) hd_parts = true;
            rows_from_cands(n, j, p, target, true)
        }
    } else {
        hd_parts = true;
        place_steps(cur_at);
        cands_sub(n, j);
        rows_from_cands(n, j, cur_at, target, false)
    }
    hand_order();
    // (No row shows: what to say instead.)
    hd_empty = EMPTY_SWIPE;
    if (hand_shown() == 0 && cur_at == 0) {
        if (goal_dead(n)) hd_empty = EMPTY_DEAD else if (!hd_parts) hd_empty = EMPTY_ELSEWHERE
    }
}

// What an empty hand says: swipe to a part to put something in (the
// statement has moves at its parts), this goal cannot be shown (Undo k
// back), or work on another statement.
const EMPTY_SWIPE: int = 0;

// Whether some part of the focused statement has moves (the ‹ › nubs
// show only then, or with the cursor on a part already).
hd_parts: bool = false;

const EMPTY_DEAD: int = 1;

const EMPTY_ELSEWHERE: int = 2;

hd_empty: int = 0;

// Whether some part of statement j (-1 the goal; places built) has moves.
cursor_moves(n: int, j: int) raises KernelError: bool {
    for p in 1..pc_n {
        place_steps(p);
        nf_n = 0;
        nh_n = 0;
        cands_sub(n, j);
        if (cd_shown > 0) return true
    }
    false
}

// Whether node n's goal is a dead end the player made: off the written
// proof, a comparison of whole numbers only (N₁ ≤ n) that arithmetic does
// not close from the facts (else it would be closed), with no move of its
// own anywhere in it. Only facts about the indices could help it, and no
// fact in such a region gives one but those it has.
goal_dead(n: int) raises KernelError: bool {
    if (!region_calc || on_path >= moves_made) return false;
    g: int = pn_goal[n];
    c: int = rel_core(gl_concl[g]);
    if (!(is_role(c, CR_LT, 2) || is_role(c, CR_LE, 2) || is_role(c, CR_NLE, 2))) return false;
    // (Or any comparison a Use with left as its side condition: A > 0 for
    // Use with A on a fact for every ε > 0. Arithmetic had its try.)
    if (!index_only(c) && !use_with_side(n)) return false;
    // (Its own moves, whole and at each part.)
    places_build(gl_concl[g]);
    nf_n = 0;
    nh_n = 0;
    cands_goal(n);
    for k in 0..cd_shown {
        // (Suppose not and the like are no way on.)
        if (!low_label(cd_label[cd_order[k]])) {
            places_build_focus(n);
            return false
        }
    }
    r: bool = !cursor_moves(n, -1);
    places_build_focus(n);
    r
}

// Whether node n is the side condition a Use with left (not the goal it
// was made on).
use_with_side(n: int): bool {
    p: int = pn_parent[n];
    if (p < 0) return false;
    m: int = pn_move[p];
    if (m < 0) return false;
    l: int = mv_lemma[m];
    if (l < 0 || lm_words[l] != sym("Use with _")) return false;
    gl_concl[pn_goal[n]] != gl_concl[pn_goal[p]]
}

// The focused statement's places built again (after another's were).
places_build_focus(n: int) {
    g: int = pn_goal[n];
    j: int = focus_hyp();
    if (j >= 0) places_build(goal_hyp(g, j)) else places_build(gl_concl[g])
}

// Whether t's names are all whole numbers (no real, no sequence).
index_only(t: int): bool {
    k: int = tm_kind(t);
    if (k == TM_FREE) {
        ty: int = tm_type(t);
        // (An operation (≤, max) is fixed too: not a sequence.)
        if (ty_kind(ty) == TY_FUN) return !sub_type(ty);
        return !is_real_type(ty)
    }
    if (k == TM_APP) return index_only(tm_fun(t)) && index_only(tm_arg(t));
    if (k == TM_ABS) return false;
    true
}

// How many undos get back to where the proof went wrong: back on the
// written proof's path (1 if it is not known).
dead_undo_k(): int {
    if (on_path < moves_made) return moves_made - on_path;
    1
}

// A row for each candidate listed now (found at place p, -1 the whole);
// only those that do not make it bigger if `tidy`.
rows_from_cands(
    n: int,
    j: int,
    p: int,
    target: int,
    tidy: bool
) raises KernelError {
    before: int = term_size(target);
    for k in 0..cd_shown {
        c: int = cd_order[k];
        wit: bool = cd_wn[c] > 0;
        rw: bool = cd_kind[c] == C_REWRITE;
        def: bool = rw && cd_lemma[c] >= 0 && lm_kind[cd_lemma[c]] == LM_DEF;
        byfact: bool = rw && cd_lemma[c] < 0;
        keep: bool = hd_n < ROWS && !(tidy && wit);
        // (A fact's Use with whose term matching the goal picks, if that
        // closes it: a row of the goal's hand with the term in.)
        pre: int = 0;
        if (rf_pre) {
            keep = false;
            if (hd_n < ROWS && cd_wn[c] == 1 && cd_kind[c] == C_FWD) pre = fact_term_for(c,
                gl_concl[pn_goal[n]]);
            if (pre != 0) {
                pre_w[0] = pre;
                keep = trial(n, c, pre_w, 1) && tr_closes
            }
            wit = false
        }
        if (keep && !wit && pre == 0) keep = trial(n, c, wit_none, 0);
        // (A move that needs a term: tried with a hole □ for each, to show
        // where the term goes.)
        holed: bool = false;
        if (keep && wit) {
            hn: int = mini(cd_wn[c], 8);
            holes: bool = true;
            for i in 0..hn {
                hz: int = hole_term(c, i);
                if (hz == 0) holes = false;
                chip_wits[i] = hz
            }
            tr_holed = true;
            if (holes) holed = trial(n, c, chip_wits, hn);
            tr_holed = false
        }
        if (keep && !wit) {
            for r in 0..hd_n {
                if (!hd_wit[r] && hd_sig[r] == tr_sig) keep = false
            }
        }
        size_after: int = before;
        if (keep && !wit && tr_res != 0 && rw) size_after = term_size(tr_res);
        if (keep && tidy && !def && !byfact && size_after > before) keep = false;
        if (keep) {
            r: int = hd_n;
            hd_n = r + 1;
            hd_src[r] = j;
            hd_whole[r] = p < 0;
            hd_p0[r] = hd_pool_n;
            hd_pn[r] = 0;
            if (p >= 0) {
                for i in 0..pc_sn[p] {
                    if (hd_pool_n < len(hd_pool)) {
                        hd_pool[hd_pool_n] = pc_pool[pc_s0[p] + i];
                        hd_pool_n = hd_pool_n + 1
                    }
                }
                hd_pn[r] = hd_pool_n - hd_p0[r]
            }
            hd_c[r] = c;
            hd_pre[r] = pre;
            hd_label[r] = cd_label[c];
            hd_wit[r] = wit;
            hd_tool[r] = cd_lemma[c] >= 0 && lm_kind[cd_lemma[c]] == LM_LEVEL;
            hd_verb[r] = row_verb(c);
            hd_res[r] = 0;
            hd_res2[r] = 0;
            hd_hl[r] = 0;
            hd_closes[r] = false;
            hd_calc[r] = false;
            hd_fact[r] = false;
            hd_fact2[r] = false;
            hd_sig[r] = 0;
            hd_ticks[r] = false;
            hd_strike[r] = false;
            hd_same[r] = false;
            if (holed) {
                hd_res[r] = tr_res;
                hd_res2[r] = tr_res2;
                hd_fact[r] = tr_fact;
                hd_fact2[r] = tr_fact2;
                hd_hl[r] = tr_hl;
                if (!rw) hd_hl[r] = chip_wits[0]
            }
            if (!wit) {
                hd_strike[r] = tr_strike;
                hd_same[r] = tr_same;
                hd_ticks[r] = tr_ticks;
                hd_res[r] = tr_res;
                hd_res2[r] = tr_res2;
                hd_fact[r] = tr_fact;
                hd_fact2[r] = tr_fact2;
                hd_hl[r] = tr_hl;
                hd_closes[r] = tr_closes;
                hd_calc[r] = tr_calc;
                hd_sig[r] = tr_sig
            }
            if (hd_closes[r] && hd_res[r] == 0) hd_res[r] = gl_concl[pn_goal[n]];
            hd_low[r] = low_label(cd_label[c]) && !script_uses(cd_label[c]);
            // (A move back to where the proof was: in the hand, last, as
            // Back; the way out a player who went wrong is looking for.)
            hd_back[r] = !wit && !hd_low[r] && !hd_closes[r] && goes_back(tr_sig);
            if (hd_back[r]) hd_verb[r] = sym("Back");
            if (pre != 0) {
                show_line(pre);
                ts: int = line_sym_now();
                line_clear();
                line_add("Use the fact with ");
                line_sym(ts);
                hd_verb[r] = line_sym_now()
            }
            // (Order: the statement's own moves, then rewrites by a fact,
            // then those that make it smaller, by rank.)
            s: int = 0;
            if (p >= 0) s = 1000;
            if (byfact || def) s = s - 500;
            if (hd_closes[r]) s = s - 800;
            s = s - cd_rank[c] * 20 + (size_after - before) * 5 + k;
            if (hd_back[r]) s = s + 100000;
            if (pre != 0) s = -100000;
            hd_sort[r] = s
        }
    }
}

wit_none: []int = new int[1](0);

// Whether rows_from_cands is listing a fact's moves for the goal's hand
// (only Use with rows whose term the goal picks), and the term.
rf_pre: bool = false;

pre_w: []int = new int[1](0);

// The term for candidate c's one witness that makes its conclusion the
// goal (matched), or 0.
fact_term_for(c: int, goal: int): int {
    cand_bindings(c);
    q: int = strip_rule(thm_prop(cd_thm[c]));
    w: int = cand_witness(c, 0);
    inst: int = 0;
    try {
        inst = match_subst(q)
    } with KernelError -> {
        return 0
    }
    match_clear();
    if (!match_term(inst, goal)) return 0;
    for i in 0..mt_n {
        if (tm_kind(mt_var[i]) == TM_VAR && tm_name(mt_var[i]) == tm_name(w)) {
            t: int = mt_val[i];
            if (tm_closed(t) && !has_vars(t)) return t
        }
    }
    0
}

an_sig: []int = new int[256](0);

an_sig_n: int = 0;

// Whether a move gives back a state the proof was in (it undoes).
goes_back(sig: int): bool {
    for i in 0..an_sig_n {
        if (an_sig[i] == sig) return true
    }
    false
}

// The small word a row starts with: what kind of move it is.
row_verb(c: int): int {
    l: int = cd_lemma[c];
    if (cd_kind[c] == C_REWRITE) {
        if (l < 0) return sym("Use the fact");
        if (lm_words[l] != 0) return lm_words[l];
        return lm_name[l]
    }
    cd_label[c]
}

hand_order() {
    k: int = 0;
    for pass in 0..2 {
        // (Primary rows, then low ones; each by its sort.)
        used: []bool = hand_used;
        for r in 0..hd_n used[r] = false;
        for _ in 0..hd_n {
            best: int = -1;
            for r in 0..hd_n {
                if (!used[r] && hd_low[r] == (pass == 1)) {
                    if (best < 0 || hd_sort[r] < hd_sort[best]) best = r
                }
            }
            if (best >= 0) {
                used[best] = true;
                hd_order[k] = best;
                k = k + 1
            }
        }
        if (pass == 0) hd_prim = k
    }
}

hand_used: []bool = new bool[ROWS](false);

// How many rows show before More (all of them if few).
hand_shown(): int {
    if (more_open) return hd_n;
    if (hd_prim <= 4 && hd_prim == hd_n) return hd_n;
    mini(hd_prim, 3)
}

hand_has_more(): bool {
    !more_open && hand_shown() < hd_n
}

// Row r's candidates listed again (where it was found): its candidate.
row_cands(r: int) raises KernelError: int {
    n: int = play_node();
    if (n < 0) return -1;
    nf_n = 0;
    nh_n = 0;
    j: int = hd_src[r];
    if (hd_whole[r]) {
        if (j < 0) cands_goal(n) else cands_hyp(n, j)
    } else {
        sub_n = hd_pn[r];
        for i in 0..sub_n sub_steps[i] = hd_pool[hd_p0[r] + i];
        cands_sub(n, j)
    }
    c: int = hd_c[r];
    if (c < cd_n && cd_label[c] == hd_label[r]) return c;
    for k in 0..cd_shown {
        if (cd_label[cd_order[k]] == hd_label[r]) return cd_order[k]
    }
    -1
}

// Whether a statement (the goal, -1, or fact j) has primary moves.
has_moves(j: int) raises KernelError: bool {
    sg: bool = fc_goal;
    st: int = fc_term;
    sc: int = cur_at;
    n: int = play_node();
    if (n < 0) return false;
    if (j < 0) fc_goal = true else {
        fc_goal = false;
        fc_term = goal_hyp(pn_goal[n], j)
    }
    cur_at = 0;
    hand_build();
    // (A fact's Use with offered in the goal's hand does not count: the
    // fact is where that move is learnt.)
    r: bool = false;
    for q in 0..hd_prim {
        if (hd_pre[hd_order[q]] == 0) r = true
    }
    fc_goal = sg;
    fc_term = st;
    cur_at = sc;
    r
}

// The focus at the start of a goal: the goal if it has moves, else the
// first fact that does (the newest if `newest`), else the goal.
focus_start(newest: bool) raises KernelError {
    focus_on_goal();
    if (lang_on()) {
        hd_n = 0;
        return
    }
    n: int = play_node();
    if (n < 0) return;
    if (has_moves(-1)) {
        hand_build();
        return
    }
    g: int = pn_goal[n];
    pick: int = -1;
    for i in 0..gl_hypn[g] {
        if ((pick < 0 || newest) && has_moves(i)) pick = i
    }
    if (pick >= 0) focus_on_fact(goal_hyp(g, pick));
    hand_build()
}

// The focus after a move: what it made (a new fact with moves, or the
// goal if it changed and has moves), else as at the start.
focus_after(old_goal: int) raises KernelError {
    if (lang_on()) {
        focus_on_goal();
        hd_n = 0;
        return
    }
    n: int = play_node();
    if (n < 0) {
        hd_n = 0;
        return
    }
    // (A goal that cannot be shown: focused, so the hand says so.)
    if (goal_dead(n)) {
        focus_on_goal();
        hand_build();
        return
    }
    g: int = pn_goal[n];
    newh: int = -1;
    for i in 0..gl_hypn[g] {
        if (!goal_has_hyp(old_goal, goal_hyp(g, i))) newh = i
    }
    if (newh >= 0 && has_moves(newh)) {
        focus_on_fact(goal_hyp(g, newh));
        hand_build();
        return
    }
    same_goal: bool = gl_concl[g] == gl_concl[old_goal];
    if (!same_goal && has_moves(-1)) {
        focus_on_goal();
        hand_build();
        return
    }
    // (A fact rewritten: still the one worked on.)
    if (!fc_goal && focus_hyp() >= 0 && has_moves(focus_hyp())) {
        cur_at = 0;
        hand_build();
        return
    }
    focus_start(true)
}

// ---- facts not touched lately (shown small) ----
ft_term: []int = new int[256](0);

ft_move: []int = new int[256](0);

ft_used: []bool = new bool[256](false);

ft_n: int = 0;

touch_fact(h: int) {
    for i in 0..ft_n {
        if (ft_term[i] == h) {
            ft_move[i] = moves_made;
            return
        }
    }
    if (ft_n < len(ft_term)) {
        ft_term[ft_n] = h;
        ft_move[ft_n] = moves_made;
        ft_used[ft_n] = false;
        ft_n = ft_n + 1
    }
}

// Fact h used by a move (it is squeezed small once the next move is made).
use_fact(h: int) {
    touch_fact(h);
    for i in 0..ft_n {
        if (ft_term[i] == h) ft_used[i] = true
    }
}

// Whether fact h has been used, and a move made since: one small line.
fact_squeezed(h: int): bool {
    if (!fc_goal && fc_term == h) return false;
    for i in 0..ft_n {
        if (ft_term[i] == h) return ft_used[i] && moves_made - ft_move[i] >= 1
    }
    false
}

// Whether fact h has not been touched for three moves (two with five
// facts or more, one with seven: a crowded board keeps only what is in
// play full size, and the goal in sight).
fact_quiet(h: int): bool {
    if (!fc_goal && fc_term == h) return false;
    quiet: int = 3;
    n: int = play_node();
    if (n >= 0) {
        if (gl_hypn[pn_goal[n]] >= 7) quiet = 1 else if (gl_hypn[pn_goal[n]] >= 5) quiet = 2
    }
    for i in 0..ft_n {
        if (ft_term[i] == h) return moves_made - ft_move[i] >= quiet
    }
    touch_fact(h);
    false
}

// ---- the chips: each term a row, showing what it gives ----
// For each term offered (wc_term), the move tried with it (and, if the
// move needs more terms, a hole □ for each of the rest): what it gives,
// as a hand row shows it. A term the kernel will not take is not offered.
ch_ok: []bool = new bool[WCS](false);

ch_res: []int = new int[WCS](0);

ch_res2: []int = new int[WCS](0);

ch_fact: []bool = new bool[WCS](false);

ch_closes: []bool = new bool[WCS](false);

ch_calc: []bool = new bool[WCS](false);

ch_strike: []bool = new bool[WCS](false);

ch_same: []bool = new bool[WCS](false);

ch_hl: []int = new int[WCS](0);

// What a term needs that arithmetic cannot show from the facts (the side
// condition A > 0 of Use with A, on a fact for every ε > 0), written; or 0.
// Such a term is dimmed, under More terms.
ch_need: []int = new int[WCS](0);

// How well a term fits (chips are shown in this order, then as found): 0
// closes the goal, 2 leaves nothing new open, 4 leaves a side condition
// (one less for the name just taken).
ch_rank: []int = new int[WCS](0);

chip_swap(i: int, j: int) {
    t: int = wc_term[i];
    wc_term[i] = wc_term[j];
    wc_term[j] = t;
    b: bool = ch_ok[i];
    ch_ok[i] = ch_ok[j];
    ch_ok[j] = b;
    t = ch_res[i];
    ch_res[i] = ch_res[j];
    ch_res[j] = t;
    t = ch_res2[i];
    ch_res2[i] = ch_res2[j];
    ch_res2[j] = t;
    b = ch_fact[i];
    ch_fact[i] = ch_fact[j];
    ch_fact[j] = b;
    b = ch_closes[i];
    ch_closes[i] = ch_closes[j];
    ch_closes[j] = b;
    b = ch_calc[i];
    ch_calc[i] = ch_calc[j];
    ch_calc[j] = b;
    b = ch_strike[i];
    ch_strike[i] = ch_strike[j];
    ch_strike[j] = b;
    b = ch_same[i];
    ch_same[i] = ch_same[j];
    ch_same[j] = b;
    t = ch_hl[i];
    ch_hl[i] = ch_hl[j];
    ch_hl[j] = t;
    t = ch_rank[i];
    ch_rank[i] = ch_rank[j];
    ch_rank[j] = t;
    t = ch_need[i];
    ch_need[i] = ch_need[j];
    ch_need[j] = t
}

// Whether every term shows (else three, then More).
chips_all: bool = false;

chip_wits: []int = new int[8](0);

// A hole of the type candidate c's i-th term has (□), or 0.
hole_term(c: int, i: int) raises KernelError: int {
    ty: int = cand_witness_type(c, i);
    if (ty == 0) ty = tm_type(cand_witness(c, i));
    if (ty == 0) return 0;
    r: int = 0;
    try {
        r = mk_free(sym_cp(9633), ty)
    } with KernelError -> {
        r = 0
    }
    r
}

// The terms offered now, each tried (wit_cand at the node played, with
// the terms picked so far).
chips_build() raises KernelError {
    chips_all = false;
    n: int = play_node();
    c: int = wit_cand;
    if (n < 0 || c < 0) return;
    for i in 0..wit_i chip_wits[i] = wit_chosen[i];
    k2: int = 0;
    for k in 0..wc_n {
        t: int = wc_term[k];
        chip_wits[wit_i] = t;
        wn: int = wit_i + 1;
        full: bool = wn >= cd_wn[c];
        holes: bool = true;
        while (wn < cd_wn[c] && wn < 8) {
            hz: int = hole_term(c, wn);
            if (hz == 0) holes = false;
            chip_wits[wn] = hz;
            wn = wn + 1
        }
        ok: bool = false;
        tr_want_fact = true;
        if (holes) ok = trial(n, c, chip_wits, wn);
        tr_want_fact = false;
        rank: int = 4;
        if (ok && tr_closes) rank = 0 else if (ok && tl_n <= 1) rank = 2;
        // (Among equals, the name just taken (the n with n ≥ max(N, N₁))
        // first: a fact about every n from N on is for it.)
        if (lower_bounded(pn_goal[n], t)) rank = rank - 1;
        // (A fact's term whose side condition arithmetic could not close:
        // last, dimmed, with what it needs.)
        need: int = 0;
        if (ok && full && region_calc && cd_kind[c] == C_FWD && tr_need != 0) {
            nt: int = tr_need;
            show_line(nt);
            ts: int = line_sym_now();
            line_clear();
            line_add("needs ");
            line_sym(ts);
            need = line_sym_now();
            rank = 7
        }
        if (ok || !full) {
            wc_term[k2] = t;
            ch_ok[k2] = ok;
            ch_res[k2] = 0;
            ch_res2[k2] = 0;
            ch_hl[k2] = t;
            ch_rank[k2] = rank;
            ch_need[k2] = need;
            if (ok) {
                ch_res[k2] = tr_res;
                ch_res2[k2] = tr_res2;
                ch_fact[k2] = tr_fact;
                ch_closes[k2] = tr_closes;
                ch_calc[k2] = tr_calc;
                ch_strike[k2] = tr_strike;
                ch_same[k2] = tr_same;
                if (tr_closes && tr_res == 0) ch_res[k2] = gl_concl[pn_goal[n]]
            }
            k2 = k2 + 1
        }
    }
    wc_n = k2;
    // (The terms that fit best first; else as found: the kit, then names.)
    for i in 1..wc_n {
        j: int = i;
        while (j > 0 && ch_rank[j - 1] > ch_rank[j]) {
            chip_swap(j - 1, j);
            j = j - 1
        }
    }
    // (The hint's term under More: every term shown.)
    t: int = hint_chip_term();
    for k in 0..wc_n {
        if (wc_term[k] == t && t != 0 && k >= chips_shown()) chips_all = true
    }
}

// A term picked that was not offered (Watch, or the hint's): added, with
// nothing to show. Its place.
chip_append(t: int): int {
    if (wc_n >= len(wc_term)) return 0;
    wc_term[wc_n] = t;
    ch_ok[wc_n] = false;
    ch_need[wc_n] = 0;
    ch_res[wc_n] = 0;
    ch_res2[wc_n] = 0;
    ch_hl[wc_n] = t;
    wc_n = wc_n + 1;
    wc_n - 1
}

// How many chips show before More.
chips_shown(): int {
    if (chips_all) return wc_n;
    // (The name just taken, the one term that fits best: it alone, the
    // rest under More.)
    n: int = play_node();
    if (wc_n > 1 && n >= 0 && lower_bounded(pn_goal[n], wc_term[0]) && ch_rank[1] > ch_rank[0]) return 1;
    // (Terms whose side condition cannot be shown: under More.)
    good: int = 0;
    for k in 0..wc_n {
        if (ch_need[k] == 0) good = good + 1
    }
    if (good > 0 && good < wc_n) return mini(good, 3);
    if (wc_n <= 3) return wc_n;
    3
}
