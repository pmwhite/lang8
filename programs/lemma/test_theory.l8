tag lemma_tests;

use_tag std, lemma;

// Reading the logic and printing what it says.
import "../../stdlib/print.l8";

import "text.l8";

import "kernel.l8";

import "syntax.l8";

import "read.l8";

import "show.l8";

import "theory.l8";

import "files.l8";

load_logic() noregion raises IoError {
    if (lm_n > 0) return;
    t: []i8 = read_whole("programs/lemma/hol.txt");
    try {
        load_theory(t, whole_n);
        close_axioms();
        mark_logic()
    } with TheoryError -> {
        line_clear();
        line_add("hol.txt line ");
        line_int(theory_line);
        line_add(": ");
        line_add(theory_why);
        line_print()
    }
}

test "the logic's axioms read and print back" {
    load_logic();
    for i in 0..lm_n {
        line_clear();
        line_sym(lm_name[i]);
        line_add(": ");
        show_line(thm_prop(lm_thm[i]));
        write(1, "");
        print_line_prefixed(lm_name[i])
    }
    expect {|
        refl: x = x
        subst: s = t ⟹ P(s) ⟹ P(t)
        ext: (⋀x. f(x) = g(x)) ⟹ f = g
        eq_reflection: x = y ⟹ x ≡ y
        iff: (P ⟹ Q) ⟹ (Q ⟹ P) ⟹ P = Q
        impI: (P ⟹ Q) ⟹ P ⟶ Q
        mp: P ⟶ Q ⟹ P ⟹ Q
        conjI: P ⟹ Q ⟹ P ∧ Q
        conjunct1: P ∧ Q ⟹ P
        conjunct2: P ∧ Q ⟹ Q
        disjI1: P ⟹ P ∨ Q
        disjI2: Q ⟹ P ∨ Q
        disjE: P ∨ Q ⟹ (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R
        allI: (⋀x. P(x)) ⟹ (∀x. P(x))
        spec: (∀x. P(x)) ⟹ P(x)
        exI: P(x) ⟹ (∃x. P(x))
        exE: (∃x. P(x)) ⟹ (⋀x. P(x) ⟹ Q) ⟹ Q
        TrueI: True
        FalseE: False ⟹ P
        notI: (P ⟹ False) ⟹ ¬P
        notE: ¬P ⟹ P ⟹ R
        ccontr: (¬P ⟹ False) ⟹ P
    |}
}

print_line_prefixed(name: int) raises IoError {
    // (show_line leaves the term in line; the name is put before it.)
    n: int = line_n;
    copy: []i8 = new i8[n](0i8);
    for i in 0..n copy[i] = line[i];
    line_clear();
    line_sym(name);
    line_add(": ");
    for i in 0..n line_byte(copy[i] as int);
    line_print()
}
