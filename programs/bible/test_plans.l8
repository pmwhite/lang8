tag bible_plans_tests;

use_tag std, bible;

// Reading plans (plans.l8): every plan's chapters once and in order, its
// days balanced, the labels; progress kept in plan.tsv's lines; and the
// verse of the day's dates.
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "plans.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

loaded: bool = false;

load() noregion {
    if (loaded) return;
    loaded = true;
    fd: int = open("programs/bible/data/bsb.txt", 0, 0);
    n: int = 8388608;
    bsb = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, bsb, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    bible_index(got);
    text_load(TEXT_BSB, bsb, got);
    plans_make()
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

// Plan p's chapters, in order, against first to last (inclusive), and
// Proverbs' for the month's.
covers(p: int, first: int, last: int): bool {
    want: int = first;
    pro: int = book_first[book_coded("PRO")];
    pro_next: int = pro;
    for d in 1..plan_lengths[p] + 1 {
        di: int = plan_day(p, d);
        if (pl_rn[di] == 0) return false;
        for r in pl_r0[di]..pl_r0[di] + pl_rn[di] {
            for c in pl_rc0[r]..pl_rc1[r] + 1 {
                if (p == PLAN_PSPR && c >= pro && c < pro + 31) {
                    if (c != pro_next) return false;
                    pro_next = pro_next + 1
                } else {
                    if (c != want) return false;
                    want = want + 1
                }
            }
        }
    }
    want == last + 1 && (p != PLAN_PSPR || pro_next == pro + 31)
}

test "every plan covers its chapters once, in order" {
    load();
    mat: int = book_first[book_coded("MAT")];
    jhn: int = book_coded("JHN");
    psa: int = book_coded("PSA");
    print(if (covers(PLAN_YEAR, 0, chapters - 1)) "year ok" else "year wrong");
    print(if (covers(PLAN_NT90, mat, chapters - 1)) "nt90 ok" else "nt90 wrong");
    print(if (covers(PLAN_PSPR, book_first[psa], book_first[psa] + 149)) "pspr ok" else "pspr wrong");
    print(if (covers(PLAN_GOSPELS, mat, book_first[jhn] + 20)) "gospels ok" else "gospels wrong");
    for p in 0..PLANS {
        write_int(1, plan_lengths[p]);
        write(1, " days, ");
        write_int(1, pl_chapters[p]);
        write(1, " chapters, about ");
        write_int(1, plan_per_day(p));
        print(" a day")
    }
    expect {|
        year ok
        nt90 ok
        pspr ok
        gospels ok
        365 days, 1189 chapters, about 3 a day
        90 days, 260 chapters, about 3 a day
        31 days, 181 chapters, about 6 a day
        30 days, 89 chapters, about 3 a day
    |}
}

test "the year's days" {
    load();
    fbuf_n = 0;
    fput_day(plan_day(PLAN_YEAR, 1));
    show_fbuf();
    print("");
    // (No day longer than 2.2 times the mean.)
    total: int = 0;
    for c in 0..chapters total = total + pl_chars[c];
    most: int = 0;
    for d in 1..366 {
        di: int = plan_day(PLAN_YEAR, d);
        n: int = 0;
        for r in pl_r0[di]..pl_r0[di] + pl_rn[di]
            for c in pl_rc0[r]..pl_rc1[r] + 1 n = n + pl_chars[c];
        if (n > most) most = n
    }
    print(if (most * 365 * 10 <= total * 22) "longest within 2.2 of the mean" else "a day too long");
    expect {|
        Genesis 1–3
        longest within 2.2 of the mean
    |}
}

test "psalm 119 is a day of its own" {
    load();
    psa: int = book_first[book_coded("PSA")];
    found: bool = false;
    for d in 1..32 {
        di: int = plan_day(PLAN_PSPR, d);
        r: int = pl_r0[di];
        if (pl_rc0[r] == psa + 118 && pl_rc1[r] == psa + 118) {
            found = true;
            fbuf_n = 0;
            fput_str("day ");
            fput_int(d);
            fput_str(": ");
            fput_day(di);
            show_fbuf();
            print("")
        }
    }
    if (!found) print("not alone");
    fbuf_n = 0;
    fput_day(plan_day(PLAN_PSPR, 1));
    show_fbuf();
    print("");
    expect {|
        day 26: Psalm 119; Proverbs 26
        Psalms 1–8; Proverbs 1
    |}
}

test "labels" {
    load();
    // (Readings made for the test, after the plans'.)
    at: int = pl_readings;
    gen: int = book_first[book_coded("GEN")];
    deu: int = book_coded("DEU");
    psa: int = book_first[book_coded("PSA")];
    plan_reading(gen + 3, gen + 5);
    plan_reading(psa + 118, psa + 118);
    plan_reading(psa, psa + 5);
    plan_reading(book_first[deu] + 33, book_first[deu] + 33);
    plan_reading(book_first[deu + 1], book_first[deu + 1] + 1);
    plan_reading(book_first[book_coded("OBA")], book_first[book_coded("OBA")]);
    for r in at..at + 6 {
        fbuf_n = 0;
        if (r == at + 4) {
            fput_reading(r - 1, false);
            fput_str("; ")
        }
        fput_reading(r, false);
        if (r != at + 3) {
            show_fbuf();
            print("")
        }
    }
    fbuf_n = 0;
    fput_reading(at, true);
    show_fbuf();
    print("");
    pl_readings = at;
    expect {|
        Genesis 4–6
        Psalm 119
        Psalms 1–6
        Deuteronomy 34; Joshua 1–2
        Obadiah
        Genesis 4 to 6
    |}
}

test "progress, kept and read back" {
    load();
    gen: int = book_first[book_coded("GEN")];
    start: int = days_from_civil(2026, 10, 19);
    plan_begin(PLAN_YEAR, start);
    // Day 1 (Genesis 1–3): one chapter read, then the rest; the second
    // finishes the day.
    write_int(1, plan_today(start));
    print(" today");
    print(if (mark_chapter(gen, 100, start)) "done" else "not yet");
    write_int(1, reading_state(pl_r0[plan_day(PLAN_YEAR, 1)]));
    print(" state");
    print(if (mark_chapter(gen + 1, 101, start)) "done" else "not yet");
    print(if (mark_chapter(gen + 2, 102, start)) "done" else "not yet");
    // (Read again: nothing.)
    print(if (mark_chapter(gen + 2, 103, start)) "done again" else "once");
    // Three days on: today is day 4, days 2 and 3 behind.
    write_int(1, plan_today(start + 3));
    write(1, " today, ");
    write_int(1, plan_behind(start + 3));
    write(1, " behind from day ");
    write_int(1, pl_first_behind);
    print("");
    // (Long after: its last day.)
    write_int(1, plan_today(start + 900));
    print(" at most");
    format_plan();
    show_fbuf();
    // Read back, with bad lines among them.
    fput_str("""
READ	XYZ	1	5
READ	GEN	99	5
nonsense
PLAN	nt90	2026-01-01
""");
    parse_plan();
    write_int(1, lines_skipped);
    write(1, " skipped; ");
    write(1, plan_ids[pl_active]);
    write(1, " from ");
    fbuf_n = 0;
    fput_iso_date(pl_start);
    show_fbuf();
    write(1, ", Genesis 2 ");
    print(if (pl_read[gen + 1]) "read" else "unread");
    // (No PLAN line first: no plan.)
    fbuf_n = 0;
    fput_str("""
READ	GEN	1	5
PLAN	weekly	2026-01-01
""");
    parse_plan();
    write_int(1, pl_active);
    print(" without a plan");
    expect "1 today\nnot yet\n1 state\nnot yet\ndone\nonce\n4 today, 2 behind from day 2\n365 at most\nPLAN\tyear\t2026-10-19\nREAD\tGEN\t1\t100\nREAD\tGEN\t2\t101\nREAD\tGEN\t3\t102\n4 skipped; year from 2026-10-19, Genesis 2 read\n-1 without a plan\n"
}

test "the verse of the day's dates" {
    load();
    // (A date and its line: Feb 29 is always line 60, Mar 1 always 61.)
    for ymd in [[2026, 1, 1], [2026, 2, 28], [2024, 2, 29], [2026, 3, 1], [2024, 3,
        1], [2026, 10, 19], [2026, 12, 31], [2024, 12, 31]] {
        write_int(1, votd_index(ymd[0], ymd[1], ymd[2]) + 1);
        write(1, " ")
    }
    print("");
    expect "1 59 60 61 61 293 366 366 \n"
}

test "the notification's body" {
    load();
    jhn: int = book_first[book_coded("JHN")];
    vd_n = 2;
    vd_c[0] = jhn + 2;
    vd_v[0] = 16;
    vd_ve[0] = 16;
    vd_c[1] = jhn + 2;
    vd_v[1] = 16;
    vd_ve[1] = 18;
    fput_votd_body(0, TEXT_BSB, 178);
    show_fbuf();
    print("");
    write_int(1, fbuf_chars(0));
    print(" characters");
    fput_votd_body(1, TEXT_BSB, 178);
    show_fbuf();
    print("");
    write_int(1, fbuf_chars(0));
    print(" characters");
    expect {|
        “For God so loved the world that He gave His one and only Son, that everyone who believes in Him shall not perish but have eternal life.” — John 3:16
        149 characters
        “For God so loved the world that He gave His one and only Son, that everyone who believes in Him shall not perish but have eternal life. For God did not send His…” — John 3:16–18
        178 characters
    |}
}
