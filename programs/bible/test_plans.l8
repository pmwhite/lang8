        Today’s reading: Psalm 119; Proverbs 26
    |}
}

test "a chapter a day" {
    load();
    plans_clear();
    rom: int = ch("ROM", 3);
    write_int(1, day1_days(rom));
    write(1, " days from Romans 3; Jude ");
    write_int(1, day1_days(ch("JUD", 1)));
    write(1, "; Romans 16 ");
    write_int(1, day1_days(ch("ROM", 16)));
    print("");
    p: int = plan_day1_choose(rom);
    i: int = plan_begin(p, today0(), 3);
    fbuf_n = 0;
    fput_plan_name(p);
    fput_str(" \�\� ");
    fput_plan_blurb(p);
    fput_str(" \�\� day 1 ");
    fput_day(plan_day(p, 1));
    fput_str(", day 14 ");
    fput_day(plan_day(p, 14));
    show_fbuf();
    print("");
    // A second, from another book: a plan of its own, followed beside it.
    q: int = plan_day1_choose(ch("PSA", 23));
    j: int = plan_begin(q, today0(), 4);
    fbuf_n = 0;
    fput_plan_name(q);
    fput_str(" \�\� ");
    fput_plan_blurb(q);
    fput_str(" \�\� ");
    fput_day(plan_day(q, 1));
    show_fbuf();
    write(1, if (q != p && j == 1) ", its own" else ", the same");
    write(1, "; Romans 3 again: ");
    write_int(1, plan_begin(plan_day1_choose(rom), today0(), 5));
    print("");
    // Kept and read back; a bad id skipped like a bad line.
    _m: bool = mark_passage_done(i, 2, pl_r0[plan_day(p, 2)], 5, today0());
    format_plan(i);
    show_fbuf();
    plans_clear();
    k: int = parse_plan(3);
    write_int(1, plan_lengths[fw_plan[k]]);
    write(1, " days, Romans 4 ");
    print(if (day_state(plan_day(fw_plan[k], 2)) == 2) "read" else "unread");
    for id in ["day1-JUD-1", "day1-ROM-99", "day1-XYZ-1", "day1-ROM"] {
        fbuf_n = 0;
        fput_str("PLAN\t");
        fput_str(id);
        fput_str("\t2026-10-19\n");
        write(1, id);
        write(1, ": ");
        write_int(1, parse_plan(6));
        write(1, ", skipped ");
        write_int(1, lines_skipped);
        print("")
    }
    expect "14 days from Romans 3; Jude 0; Romans 16 0\nRomans, a Chapter a Day · Romans 3–16, one chapter a day. · day 1 Romans 3, day 14 Romans 16\nPsalms, a Psalm a Day · Psalms 23–150, one psalm a day. · Psalm 23, its own; Romans 3 again: -1\nPLAN\tday1-ROM-3\t2026-10-19\nDONE\t2\t0\t5\n14 days, Romans 4 read\nday1-JUD-1: -1, skipped 1\nday1-ROM-99: -1, skipped 1\nday1-XYZ-1: -1, skipped 1\nday1-ROM: -1, skipped 1\n"
}

// Out's text from a to b, a line at a time (the opener's and heading's,
// and the start of the words).
show_out(a: int, b: int) raises IoError {
    e: int = if (b < out_n) b else out_n;
    fbuf_n = 0;
    for i in a..e {
        k: int = out[i] as int & 255;
        if (k == 239) fput(126) else if (k == 191 || k == 188) { } else fput(k)
    }
    show_fbuf();
    print("")
}

test "a day laid out" {
    load();
    // A day made for the test: Genesis 12–13 and Hebrews 11:8–19.
    at: int = pl_readings;
    di: int = PL_DAYS - 1;
    heb: int = ch("HEB", 11);
    pl_r0[di] = at;
    plan_reading(ch("GEN", 12), ch("GEN", 13));
    plan_passage(heb, 8, heb, 19);
    pl_rn[di] = 2;
    pl_day0[PLAN_ALL + 1] = di - 31;
    day_rows(PLAN_ALL + 1, 32);
    dy_plan = PLAN_CHRONO;
    write_int(1, dy_n);
    print(" rows");
    for r in 0..dy_n {
        layout_day_row(r);
        write_int(1, r);
        write(1, ": ");
        show_out(0, if (r == 2) 140 else 70);
        // (The first verse's number, and the last's.)
        write(1, "   verses ");
        write_int(1, verse_num[0]);
        write(1, " to ");
        write_int(1, verse_num[verse_count - 1]);
        print("")
    }
    // (Hebrews 11's heading previews 11:8–19.)
    layout_day_row(2);
    xref_unpack2(run_arg[0], run_arg2[0]);
    write_int(1, xr_c);
    write(1, ":");
    write_int(1, xr_v);
    write(1, " to ");
    write_int(1, xr_ce);
    write(1, ":");
    write_int(1, xr_ve);
    print("");
    pl_readings = at;
    pl_rn[di] = 0;
    expect {|
        3 rows
        0: DAY 32
        Chronological
        ~
        Genesis 12–13
        12
        The Call of Abram
        (Genesis
           verses 1 to 20
        1: ~
        GENESIS
        13
        Abram and Lot Part Ways
        So Abram went up out of Egypt i
           verses 1 to 18
        2: Hebrews 11:8–19
        The Faith of Abraham and Sarah
        (Genesis 15–22; Romans 4:1–12)
        8 By faith Abraham, when called to go to a place he wo
           verses 8 to 19
        11:8 to 11:19
    |}
}
