tag bible_plans_tests;

use_tag std, bible;

// Reading plans (plans.l8, DESIGN.md §10.1 and §16.4): every computed plan's
// chapters once and in order, its days balanced; Old and New Together's
// three parts; the listed plans' files (M'Cheyne's Calendar's four columns,
// the Chronological's every verse once), read as the app reads them; the
// labels; progress kept by passage in plan.tsv's lines, 1.0's lines read
// as 1.0 read them; a day's reminder; and a day laid out as the day's
// reader shows it.
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "plans.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

loaded: bool = false;

read_into(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    n: int = 8388608;
    buf: []i8 = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (fd >= 0 && more && got < n) {
        r: int = read(fd, buf, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    if (fd >= 0) close(fd);
    read_n = got;
    buf
}

read_n: int = 0;

load() noregion {
    if (loaded) return;
    loaded = true;
    bsb = read_into("programs/bible/data/bsb.txt");
    bible_index(read_n);
    text_load(TEXT_BSB, bsb, read_n);
    m: []i8 = read_into("programs/bible/data/plans/mcheyne.txt");
    plan_file_set(PLAN_MCHEYNE, m, read_n);
    k: []i8 = read_into("programs/bible/data/plans/chrono.txt");
    plan_file_set(PLAN_CHRONO, k, read_n);
    plans_make()
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

// Plan p's chapters, in order, against first to last (inclusive), and
// Proverbs' for the month's.
covers(p: int, first: int, last: int): bool {
    want: int = first;
    pro: int = book_first[book_coded("PRO")];
    pro_next: int = pro;
    for d in 1..plan_lengths[p] + 1 {
        di: int = plan_day(p, d);
        if (pl_rn[di] == 0) return false;
        for r in pl_r0[di]..pl_r0[di] + pl_rn[di] {
            if (!passage_whole(r)) return false;
            for c in pl_c1[r]..pl_c2[r] + 1 {
                if (p == PLAN_PSPR && c >= pro && c < pro + 31) {
                    if (c != pro_next) return false;
                    pro_next = pro_next + 1
                } else {
                    if (c != want) return false;
                    want = want + 1
                }
            }
        }
    }
    want == last + 1 && (p != PLAN_PSPR || pro_next == pro + 31)
}

test "every computed plan covers its chapters once, in order" {
    load();
    mat: int = book_first[book_coded("MAT")];
    jhn: int = book_coded("JHN");
    psa: int = book_coded("PSA");
    print(if (covers(PLAN_YEAR, 0, chapters - 1)) "year ok" else "year wrong");
    print(if (covers(PLAN_NT90, mat, chapters - 1)) "nt90 ok" else "nt90 wrong");
    print(if (covers(PLAN_PSPR, book_first[psa], book_first[psa] + 149)) "pspr ok" else "pspr wrong");
    print(if (covers(PLAN_GOSPELS, mat, book_first[jhn] + 20)) "gospels ok" else "gospels wrong");
    for i in 0..PLANS {
        p: int = plan_order[i];
        fbuf_n = 0;
        fput_plan_name(p);
        fput_str(": ");
        fput_int(plan_lengths[p]);
        fput_str(" days, about ");
        fput_int(plan_per_day(p));
        fput_str(" a day");
        show_fbuf();
        print("")
    }
    expect {|
        year ok
        nt90 ok
        pspr ok
        gospels ok
        Bible in a Year: 365 days, about 3 a day
        Chronological: 365 days, about 3 a day
        M'Cheyne's Calendar: 365 days, about 4 a day
        Old and New Together: 365 days, about 3 a day
        New Testament in 90 Days: 90 days, about 3 a day
        Psalms and Proverbs in a Month: 31 days, about 6 a day
        The Gospels in 30 Days: 30 days, about 3 a day
    |}
}

// Day di's length (characters of words).
day_chars(di: int): int {
    n: int = 0;
    for k in pl_r0[di]..pl_r0[di] + pl_rn[di] n = n + passage_chars(k);
    n
}

// Passage k's characters of words (its verses' share of its chapters').
passage_chars(k: int): int {
    n: int = 0;
    for c in pl_c1[k]..pl_c2[k] + 1 {
        a: int = if (c == pl_c1[k]) pl_v1[k] else 1;
        b: int = if (c == pl_c2[k]) pl_v2[k] else pl_last[c];
        n = n + (b - a + 1) * pl_chars[c] / pl_last[c]
    }
    n
}

// Whether no day of plan p is longer than 2.2 times its mean.
within(p: int): bool {
    total: int = 0;
    most: int = 0;
    for d in 1..plan_lengths[p] + 1 {
        n: int = day_chars(plan_day(p, d));
        total = total + n;
        if (n > most) most = n
    }
    most * plan_lengths[p] * 10 <= total * 22
}

test "the year's days" {
    load();
    fbuf_n = 0;
    fput_day(plan_day(PLAN_YEAR, 1));
    show_fbuf();
    print("");
    print(if (within(PLAN_YEAR)) "longest within 2.2 of the mean" else "a day too long");
    expect {|
        Genesis 1–3
        longest within 2.2 of the mean
    |}
}

test "psalm 119 is a day of its own" {
    load();
    psa: int = book_first[book_coded("PSA")];
    found: bool = false;
    for d in 1..32 {
        di: int = plan_day(PLAN_PSPR, d);
        r: int = pl_r0[di];
        if (pl_c1[r] == psa + 118 && pl_c2[r] == psa + 118) {
            found = true;
            fbuf_n = 0;
            fput_str("day ");
            fput_int(d);
            fput_str(": ");
            fput_day(di);
            show_fbuf();
            print("")
        }
    }
    if (!found) print("not alone");
    fbuf_n = 0;
    fput_day(plan_day(PLAN_PSPR, 1));
    show_fbuf();
    print("");
    expect {|
        day 26: Psalm 119; Proverbs 26
        Psalms 1–8; Proverbs 1
    |}
}

// ---- every verse counted ----
// Each verse's count (by chapter, from vc_base), and whether the BSB has it.
vc_base: []int = new int[1201](0);

vc_n: []int = new int[34000](0);

vc_has: []bool = new bool[34000](false);

vc_ready: bool = false;

vc_clear() {
    if (!vc_ready) {
        vc_ready = true;
        for c in 0..chapters vc_base[c + 1] = vc_base[c] + pl_last[c] + 1;
        p: int = 0;
        c: int = -1;
        while (p < bsb_n) {
            e: int = line_end(p);
            k: int = bsb[p] as int;
            if (k == 67) c = c + 1;
            if (k == 86 && c >= 0) {
                v: int = key_at(p + 1);
                if (v <= pl_last[c]) vc_has[vc_base[c] + v] = true
            }
            p = e + 1
        }
    }
    for i in 0..len(vc_n) vc_n[i] = 0
}

vc_add(k: int) {
    for c in pl_c1[k]..pl_c2[k] + 1 {
        a: int = if (c == pl_c1[k]) pl_v1[k] else 1;
        b: int = if (c == pl_c2[k]) pl_v2[k] else pl_last[c];
        for v in a..b + 1 vc_n[vc_base[c] + v] = vc_n[vc_base[c] + v] + 1
    }
}

vc_add_plan(p: int) {
    for d in 1..plan_lengths[p] + 1 {
        di: int = plan_day(p, d);
        for k in pl_r0[di]..pl_r0[di] + pl_rn[di] vc_add(k)
    }
}

// The verses of chapters a to b (not) the BSB has: how many are counted
// other than want times (the first such named in vc_first).
vc_wrong(a: int, b: int, want: int): int {
    n: int = 0;
    vc_first = -1;
    for c in a..b {
        for v in 1..pl_last[c] + 1 {
            i: int = vc_base[c] + v;
            if (vc_has[i] && vc_n[i] != want) {
                if (vc_first < 0) vc_first = i;
                n = n + 1
            }
        }
    }
    n
}

vc_first: int = -1;

// How many days of plan p have fewer than lo or more than hi passages.
days_outside(p: int, lo: int, hi: int): int {
    n: int = 0;
    for d in 1..plan_lengths[p] + 1 {
        m: int = pl_rn[plan_day(p, d)];
        if (m < lo || m > hi) n = n + 1
    }
    n
}

test "old and new together" {
    load();
    psa: int = book_coded("PSA");
    mat: int = book_first[book_coded("MAT")];
    vc_clear();
    vc_add_plan(PLAN_BOTH);
    write_int(1, vc_wrong(0, mat, 1));
    write(1, " verses not once; days outside 2 to 3 passages: ");
    write_int(1, days_outside(PLAN_BOTH, 2, 3));
    print("");
    // (Each day the Old Testament, the New, then the Psalms.)
    order: bool = true;
    for d in 1..366 {
        di: int = plan_day(PLAN_BOTH, d);
        k: int = pl_r0[di];
        if (pl_c1[k] >= mat || ch_book[pl_c1[k]] == psa || pl_c1[k + 1] < mat || ch_book[pl_c1[k + 2]] != psa) order = false
    }
    print(if (order) "in order" else "out of order");
    for d in [1, 2, 100, 200, 300, 365] {
        fbuf_n = 0;
        fput_int(d);
        fput_str(": ");
        fput_day(plan_day(PLAN_BOTH, d));
        show_fbuf();
        print("")
    }
    expect {|
        0 verses not once; days outside 2 to 3 passages: 0
        in order
        1: Genesis 1–2; Matthew 1; Psalm 1
        2: Genesis 3–5; Matthew 2:1–18; Psalm 2:1–6
        100: Joshua 1–3; Luke 10:25–11:13; Psalm 45:10–17
        200: 2 Chronicles 1–3; Acts 20:7–16; Psalms 85:10–86:4
        300: Jeremiah 33–34; 2 Timothy 1; Psalm 119:65–72
        365: Malachi 1–4; Revelation 22; Psalm 150
    |}
}

test "m'cheyne's calendar" {
    load();
    p: int = PLAN_MCHEYNE;
    psa: int = book_coded("PSA");
    mat: int = book_first[book_coded("MAT")];
    vc_clear();
    vc_add_plan(p);
    // (Day 220's Secret column is "Jer. 36, 45": two passages.)
    four: int = 0;
    for d in 1..366
        if (pl_rn[plan_day(p, d)] == 4) four = four + 1;
    write_int(1, plan_lengths[p]);
    write(1, " days, ");
    write_int(1, four);
    write(1, " of 4 passages, bad lines ");
    write_int(1, pl_bad_lines[p]);
    print("");
    // The Old Testament once (but the Psalms), the New and the Psalms twice.
    n1: int = vc_wrong(0, book_first[psa], 1) + vc_wrong(book_first[psa] + book_count[psa],
        mat, 1);
    n2: int = vc_wrong(book_first[psa], book_first[psa] + book_count[psa], 2) + vc_wrong(mat,
        chapters, 2);
    write_int(1, n1);
    write(1, " not once, ");
    write_int(1, n2);
    print(" not twice");
    // (The family's first column runs through Genesis to 2 Chronicles in
    // order.)
    next: int = 0;
    order: bool = true;
    for d in 1..366 {
        k: int = pl_r0[plan_day(p, d)];
        if (pl_c1[k] != next && !(pl_v1[k] > 1 && pl_c1[k] == next - 1)) order = false;
        next = pl_c2[k] + 1
    }
    print(if (order && next == book_first[book_coded("2CH")] + 36) "Genesis to 2 Chronicles in order" else "out of order");
    fbuf_n = 0;
    fput_day(plan_day(p, 1));
    fput_str(" | ");
    fput_day(plan_day(p, 220));
    fput_str(" | ");
    fput_plan_blurb(p);
    show_fbuf();
    print("");
    expect {|
        365 days, 364 of 4 passages, bad lines 0
        0 not once, 0 not twice
        Genesis to 2 Chronicles in order
        Genesis 1; Matthew 1; Ezra 1; Acts 1 | Ruth 1; Acts 26; Jeremiah 36; 45; Psalm 9 | Four chapters a day: the Old Testament once and the New Testament and Psalms twice in a year.
    |}
}

test "the chronological plan" {
    load();
    p: int = PLAN_CHRONO;
    vc_clear();
    vc_add_plan(p);
    write_int(1, plan_lengths[p]);
    write(1, " days, bad lines ");
    write_int(1, pl_bad_lines[p]);
    write(1, ", verses not once ");
    write_int(1, vc_wrong(0, chapters, 1));
    write(1, ", days outside 1 to 6 passages ");
    write_int(1, days_outside(p, 1, 6));
    print("");
    print(if (within(p)) "longest within 2.2 of the mean" else "a day too long");
    expect {|
        365 days, bad lines 0, verses not once 0, days outside 1 to 6 passages 0
        longest within 2.2 of the mean
    |}
}

test "a day's labels name a book once" {
    load();
    for d in [3, 109, 122] {
        fbuf_n = 0;
        fput_day(plan_day(PLAN_CHRONO, d));
        fput_str(" / ");
        fput_day_spoken(plan_day(PLAN_CHRONO, d));
        show_fbuf();
        print("")
    }
    // (One-chapter books, and passages across chapters.)
    at: int = pl_readings;
    di: int = PL_DAYS - 2;
    jud: int = ch("JUD", 1);
    mat: int = ch("MAT", 26);
    pl_r0[di] = at;
    plan_passage(jud, 1, jud, 2);
    plan_passage(jud, 3, jud, 7);
    plan_passage(mat, 57, mat + 1, 10);
    plan_passage(mat + 1, 11, mat + 1, 11);
    pl_rn[di] = 4;
    fbuf_n = 0;
    fput_day(di);
    show_fbuf();
    print("");
    pl_readings = at;
    pl_rn[di] = 0;
    expect {|
        Genesis 8–9; 11:1–9; 10 / Genesis 8 to 9; 11:1 to 9; 10
        1 Samuel 23:1–23; Psalm 54; 1 Samuel 23:24–24:22; Psalms 57; 63 / 1 Samuel 23:1 to 23; Psalm 54; 1 Samuel 23:24 to 24:22; Psalms 57; 63
        Psalms 22; 16; 118; 110; 2 Samuel 8; 1 Chronicles 18 / Psalms 22; 16; 118; 110; 2 Samuel 8; 1 Chronicles 18
        Jude 1–2; 3–7; Matthew 26:57–27:10; 27:11
    |}
}

test "labels" {
    load();
    // (Passages made for the test, after the plans'.)
    at: int = pl_readings;
    gen: int = book_first[book_coded("GEN")];
    deu: int = book_coded("DEU");
    psa: int = book_first[book_coded("PSA")];
    heb: int = book_first[book_coded("HEB")];
    mat: int = book_first[book_coded("MAT")];
    jud: int = book_first[book_coded("JUD")];
    plan_reading(gen + 3, gen + 5);
    plan_reading(psa + 118, psa + 118);
    plan_reading(psa, psa + 5);
    plan_reading(book_first[deu] + 33, book_first[deu] + 33);
    plan_reading(book_first[deu + 1], book_first[deu + 1] + 1);
    plan_reading(book_first[book_coded("OBA")], book_first[book_coded("OBA")]);
    plan_passage(heb + 10, 8, heb + 10, 19);
    plan_passage(mat + 25, 57, mat + 26, 10);
    plan_passage(jud, 3, jud, 7);
    plan_passage(psa + 118, 1, psa + 118, 24);
    plan_passage(psa + 116, 1, psa + 117, 4);
    plan_passage(heb + 10, 8, heb + 10, 8);
    for r in at..at + 12 {
        fbuf_n = 0;
        if (r == at + 4) {
            fput_reading(r - 1, false);
            fput_str("; ")
        }
        fput_reading(r, false);
        if (r != at + 3) {
            show_fbuf();
            print("")
        }
    }
    fbuf_n = 0;
    fput_reading(at, true);
    fput_str(", ");
    fput_reading(at + 6, true);
    show_fbuf();
    print("");
    pl_readings = at;
    expect {|
        Genesis 4–6
        Psalm 119
        Psalms 1–6
        Deuteronomy 34; Joshua 1–2
        Obadiah
        Hebrews 11:8–19
        Matthew 26:57–27:10
        Jude 3–7
        Psalm 119:1–24
        Psalms 117:1–118:4
        Hebrews 11:8
        Genesis 4 to 6, Hebrews 11:8 to 19
    |}
}

// Book code's chapter n.
ch(code: str, n: int): int {
    book_first[book_coded(code)] + n - 1
}

today0(): int {
    days_from_civil(2026, 10, 19)
}

// fbuf from i on, as a slice.
slice_buf: []i8 = new i8[4096](0i8);

slice_from(i: int): []i8 {
    for x in i..fbuf_n slice_buf[x - i] = fbuf[x];
    slice_buf
}

// Plan p's day states for days 1 to n, as digits (0 none, 1 some, 2 all).
show_states(p: int, n: int) raises IoError {
    for d in 1..n + 1 write_int(1, day_state(plan_day(p, d)));
    print("")
}

test "progress, kept and read back" {
    load();
    plans_clear();
    start: int = today0();
    i: int = plan_begin(PLAN_MCHEYNE, start, 1);
    d1: int = plan_day(PLAN_MCHEYNE, 1);
    k0: int = pl_r0[d1];
    // Day 1's passages read one at a time: the last finishes today's day.
    write_int(1, plan_today_of(i, start));
    print(" today");
    for k in k0..k0 + pl_rn[d1] {
        done: bool = mark_passage_done(i, 1, k, 100 + k - k0, start);
        if (done) print("done") else print("not yet")
    }
    // (Read again: nothing.)
    print(if (mark_passage_done(i, 1, k0, 200, start)) "done again" else "once");
    // Day 2's first read, then not.
    d2: int = plan_day(PLAN_MCHEYNE, 2);
    mark_passage(pl_r0[d2], true, 300);
    mark_passage(pl_r0[d2], false, 301);
    show_states(PLAN_MCHEYNE, 3);
    // Three days on: today is day 4, days 2 and 3 behind.
    write_int(1, plan_today_of(i, start + 3));
    write(1, " today, ");
    write_int(1, plan_behind_of(i, start + 3));
    write(1, " behind from day ");
    write_int(1, pl_first_behind);
    print("");
    // (Long after: its last day.)
    write_int(1, plan_today_of(i, start + 900));
    print(" at most");
    fw_remind[i] = true;
    fw_doneday[i] = start;
    format_plan(i);
    show_fbuf();
    // Read back, with bad lines among them.
    fput_str("""
DONE	999	0	5
DONE	3	9	5
UNDONE	x	0	5
nonsense
PLAN	nt90	2026-01-01
""");
    plans_clear();
    j: int = parse_plan(7);
    write_int(1, lines_skipped);
    write(1, " skipped; ");
    write(1, plan_ids[fw_plan[j]]);
    write(1, " from ");
    fbuf_n = 0;
    fput_iso_date(fw_start[j]);
    show_fbuf();
    write(1, if (fw_remind[j]) ", reminded" else ", not reminded");
    write(1, if (fw_doneday[j] == start) ", done today" else ", not done today");
    write(1, ", file ");
    write_int(1, fw_num[j]);
    print("");
    show_states(PLAN_MCHEYNE, 3);
    // (No PLAN line first: no plan.)
    fbuf_n = 0;
    fput_str("""
DONE	1	0	5
PLAN	chrono	2026-01-01
""");
    write_int(1, parse_plan(8));
    print(" without a PLAN line first");
    // A plan this build has not, and one followed already: none, and said so.
    fbuf_n = 0;
    fput_str("""
PLAN	weekly	2026-01-01
DONE	1	0	5
""");
    write_int(1, parse_plan(9));
    print(if (pl_unknown) " plan unknown" else " plan known");
    fbuf_n = 0;
    fput_str("PLAN\tmcheyne\t2026-01-01\n");
    write_int(1, parse_plan(10));
    print(if (pl_unknown) " followed already" else " a second");
    write_int(1, fw_n);
    print(" followed");
    expect "1 today\nnot yet\nnot yet\nnot yet\ndone\nonce\n200\n4 today, 2 behind from day 2\n365 at most\nPLAN\tmcheyne\t2026-10-19\nREMIND\t1\nDONEDAY\t2026-10-19\nDONE\t1\t0\t100\nDONE\t1\t1\t101\nDONE\t1\t2\t102\nDONE\t1\t3\t103\nUNDONE\t2\t0\t301\n5 skipped; mcheyne from 2026-10-19, reminded, done today, file 7\n200\n-1 without a PLAN line first\n-1 plan unknown\n-1 followed already\n1 followed\n"
}

test "several plans at once" {
    load();
    plans_clear();
    t0: int = today0();
    // Chronological from day 0, M'Cheyne's from two days on: both read in
    // their own files' order.
    fbuf_n = 0;
    fput_str("""
PLAN	chrono	2026-10-19
REMIND	1
""");
    a: int = parse_plan(1);
    fbuf_n = 0;
    fput_str("""
PLAN	mcheyne	2026-10-21
REMIND	1
DONE	1	0	5
""");
    b: int = parse_plan(2);
    write_int(1, fw_n);
    write(1, " followed: ");
    for i in 0..fw_n {
        fbuf_n = 0;
        fput_plan_name(fw_plan[i]);
        fput_str(" day ");
        fput_int(plan_today_of(i, t0 + 2));
        fput_str("; ");
        show_fbuf()
    }
    print("");
    // Genesis 1 in both on their days 3 and 1: read in M'Cheyne's (its
    // file's DONE), not in the Chronological's.
    fbuf_n = 0;
    fput_day(plan_day(PLAN_CHRONO, 1));
    fput_str(" / ");
    fput_day(plan_day(PLAN_MCHEYNE, 1));
    show_fbuf();
    print("");
    show_states(PLAN_CHRONO, 1);
    show_states(PLAN_MCHEYNE, 1);
    // Also today: from the Chronological's day, M'Cheyne's (its today
    // unread); from M'Cheyne's, the Chronological's.
    also_today(PLAN_CHRONO, t0 + 2);
    write_int(1, al_n);
    write(1, " also today: ");
    write_int(1, fw_plan[al_slot[0]]);
    print("");
    // The Chronological's today read: Day Done due, and its words name it.
    mark_day(plan_day(PLAN_CHRONO, 3), true, 6);
    also_today(PLAN_MCHEYNE, t0 + 2);
    write_int(1, al_n);
    print(" also today from M'Cheyne's");
    print(if (plan_day_done_due(a, t0 + 2)) "due" else "not due");
    fbuf_n = 0;
    fput_day_done(a, t0 + 2);
    show_fbuf();
    print("");
    fw_doneday[a] = t0 + 2;
    print(if (plan_day_done_due(a, t0 + 2)) "due again" else "given once");
    // Each file its own plan's marks.
    format_plan(b);
    show_fbuf();
    // The reminder: two plans, one (the other read), none; then cut.
    for day in [t0 + 3, t0 + 2] {
        n: int = fput_plans_reminder(day, 178);
        for x in 0..fbuf_n
            if (fbuf[x] as int == 10) fbuf[x] = 47i8;
        write_int(1, n);
        write(1, ": ");
        write_bytes_n(1, fbuf, rmp_title);
        write(1, " | ");
        write_bytes_n(1, slice_from(rmp_title), fbuf_n - rmp_title);
        print("")
    }
    mark_day(plan_day(PLAN_MCHEYNE, 1), true, 7);
    write_int(1, fput_plans_reminder(t0 + 2, 178));
    print(" plans on a day both are read");
    n2: int = fput_plans_reminder(t0 + 3, 60);
    for x in 0..fbuf_n
        if (fbuf[x] as int == 10) fbuf[x] = 47i8;
    show_fbuf();
    print("");
    // Stopped: the other stays, its marks with it.
    plan_end(a);
    write_int(1, fw_n);
    write(1, " followed, ");
    write_int(1, fw_plan[0]);
    write(1, ", day 1 ");
    show_states(PLAN_MCHEYNE, 1);
    _n: int = n2;
    expect "2 followed: Chronological day 3; M'Cheyne's Calendar day 1; \nGenesis 1–3 / Genesis 1; Matthew 1; Ezra 1; Acts 1\n0\n1\n1 also today: 5\n0 also today from M'Cheyne's\ndue\nChronological, Day 3 Done\ngiven once\nPLAN\tmcheyne\t2026-10-21\nREMIND\t1\nDONE\t1\t0\t5\n2: Today’s Reading | Chronological: Genesis 11:10–26; Job 1–4/M'Cheyne's Calendar: Genesis 2; Matthew 2; Ezra 2; Acts 2\n1: M'Cheyne's Calendar | Today’s reading: Genesis 1; Matthew 1; Ezra 1; Acts 1\n0 plans on a day both are read\nToday’s ReadingChronological: Genesis 11:10–26; Job 1–4 … and 1 more\n1 followed, 5, day 1 2\n"
}

test "1.0's plan.tsv, as plan-1.tsv" {
    load();
    plans_clear();
    // Bible in a Year, as 1.0 kept it: Genesis 1 (day 1 begun), Genesis 4–7
    // (day 2 read), Genesis 8 (day 3 begun); and day 1's reading unmarked
    // since. Migrated: its reminder's switch was on.
    fbuf_n = 0;
    fput_str("""
PLAN	year	2026-10-19
READ	GEN	1	10
READ	GEN	4	11
READ	GEN	5	12
READ	GEN	6	13
READ	GEN	7	14
READ	GEN	8	15""");
    plan_migrate(true);
    i: int = parse_plan(1);
    fbuf_n = 0;
    fput_day(plan_day(PLAN_YEAR, 2));
    fput_str(", ");
    fput_day(plan_day(PLAN_YEAR, 3));
    show_fbuf();
    print("");
    show_states(PLAN_YEAR, 4);
    format_plan(i);
    show_fbuf();
    // Kept so and read again: the same.
    plans_clear();
    i = parse_plan(1);
    show_states(PLAN_YEAR, 4);
    // 1.0's chapters count for that plan only, not another reading them.
    fbuf_n = 0;
    fput_str("PLAN\tnt90\t2026-10-19\n");
    _j: int = parse_plan(2);
    write(1, "Chronological's day 1 ");
    write_int(1, day_state(plan_day(PLAN_CHRONO, 1)));
    print("");
    // Day 1 finished, day 2 unmarked: DONE and UNDONE, 1.0's lines gone.
    mark_day(plan_day(PLAN_YEAR, 1), true, 20);
    mark_day(plan_day(PLAN_YEAR, 2), false, 21);
    format_plan(i);
    show_fbuf();
    plans_clear();
    _k: int = parse_plan(1);
    show_states(PLAN_YEAR, 4);
    expect "Genesis 4–7, Genesis 8–11\n1210\nPLAN\tyear\t2026-10-19\nREMIND\t1\nREAD\tGEN\t1\t10\nREAD\tGEN\t8\t15\nDONE\t2\t0\t14\n1210\nChronological's day 1 0\nPLAN\tyear\t2026-10-19\nREMIND\t1\nREAD\tGEN\t8\t15\nDONE\t1\t0\t20\nUNDONE\t2\t0\t21\n2010\n"
}

