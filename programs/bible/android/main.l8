tag bible_android;

use_tag std, bible;

// Smooth Bible on Android (SKINS.md): the app (core) on a thread of its
// own, in a shared library the Java side loads (glue.c, Bible.java), built
// with `l8 arm64 --target android` (android/build.sh). Its host is core's
// (core/host.l8), as the web's is; this gives it Android's primitives: a
// data file (the app's files, copied there from the APK's assets by the
// Java side first), a GET (made by the Java side, its answer a file of the
// app's), the app's files for what is kept, and the lines to and from the
// skin.
//
//   files DIR      where the app's files are (the first line, always)
//   ...            the wire (SKINS.md), and the host's got, http, api
//
// To the Java side, besides core's lines: `http_get ID URL` (a GET whose
// body it writes to DIR/http/ID, then says `http ID STATUS SIZE`).
import "../../../stdlib/write.l8";

import "../core/host.l8";

extern and_wait(ms: int): int;

extern and_take(buf: []i8, cap: int): int;

extern and_say_at(text: []i8, at: int, n: int): int;

extern close(fd: int): int;

extern unlink_raw(path: *i8): int = unlink;

extern open_raw(path: *i8, flags: int, mode: int): int = open;

extern lseek(fd: int, offset: int, whence: int): int;

// ---- files ----
files_dir: []i8 = new i8[1024](0i8);

files_n: int = 0;

path: []i8 = new i8[1200](0i8);

path_n: int = 0;

path_begin() {
    path_n = 0;
    for i in 0..files_n path_put(files_dir[i] as int);
    path_put(47)
}

path_put(k: int) {
    if (path_n < len(path) - 1) {
        path[path_n] = k trunc i8;
        path_n = path_n + 1
    }
}

path_end() {
    path[path_n] = 0i8
}

// The path of kept file kp_name (core/kept.l8's) in the app's files.
kp_path() {
    path_begin();
    for i in 0..kp_name_n path_put(kp_name[i] as int);
    path_end()
}

// File path's size (-1: it isn't there).
path_size(): int {
    fd: int = open_raw(&path[0], 0, 0);
    if (fd < 0) return -1;
    n: int = lseek(fd, 0, 2);
    close(fd);
    n
}

// File path read into out (as much as fits), from offset: how much.
path_read(offset: int, out: []i8): int {
    fd: int = open_raw(&path[0], 0, 0);
    if (fd < 0) return 0;
    if (offset > 0 && lseek(fd, offset, 0) != offset) {
        close(fd);
        return 0
    }
    got: int = 0;
    more: bool = true;
    while (more && got < len(out)) {
        k: int = read(fd, out, got, len(out) - got);
        if (k <= 0) more = false else got = got + k
    }
    close(fd);
    got
}

// ---- what is kept (core/kept.l8's), as files of the app's ----
kp_read_file() {
    kp_path();
    fbuf_n = path_read(0, fbuf)
}

kp_write_file() {
    kp_path();
    // (O_WRONLY | O_CREAT | O_TRUNC)
    kp_out(577)
}

kp_append_file() {
    kp_path();
    // (O_WRONLY | O_CREAT | O_APPEND)
    kp_out(1089)
}

kp_out(flags: int) {
    fd: int = open_raw(&path[0], flags, 384);
    if (fd < 0) return;
    try {
        write_bytes_n(fd, fbuf, fbuf_n)
    } with IoError _e -> { }
    close(fd)
}

kp_remove_file() {
    kp_path();
    _u: int = unlink_raw(&path[0])
}

// ---- the data files core's host asks for ----
// Each id's name as asked (a version's, "bsb", is bsb.txt in the files),
// and the asks not yet answered: answered in the loop, `got ID SIZE`.
ASKED_MOST: int = 128;

asked_name: []i8 = new i8[128 * 64](0i8);

asked_len: []int = new int[128](0);

waiting: []int = new int[128](0);

waiting_n: int = 0;

android_ask(id: int, name: str) {
    if (id < 0 || id >= ASKED_MOST) return;
    n: int = 0;
    for c in name {
        if (n < 64) {
            asked_name[id * 64 + n] = c;
            n = n + 1
        }
    }
    asked_len[id] = n;
    if (waiting_n < len(waiting)) {
        waiting[waiting_n] = id;
        waiting_n = waiting_n + 1
    }
}

// Data file id's path (its name, or its name with .txt).
asked_path(id: int, txt: bool) {
    path_begin();
    for i in 0..asked_len[id] path_put(asked_name[id * 64 + i] as int);
    if (txt)
        for c in ".txt" path_put(c as int);
    path_end()
}

// A GET's answer's path: http/ID.
http_path(id: int) {
    path_begin();
    for c in "http/" path_put(c as int);
    d: int = 1;
    while (d * 10 <= id) d = d * 10;
    while (d > 0) {
        path_put(48 + id / d % 10);
        d = d / 10
    }
    path_end()
}

// ---- kept files read back for core (HostIO.read_kept) ----
// Each read asked for: its id, kept name and span, answered in the loop
// (got ID SIZE) and forgotten once its file is taken. Core reads a
// module's file once at a time (the catalog, each module's files as it is
// opened, a span of its text): far fewer than
// KEPT_READS_MOST are ever waiting; past it, a read is answered as a file
// that is not there (-1), which core reports.
KEPT_READS_MOST: int = 32;

// The longest kept name a read can be asked for (a module's package:
// shelf-NAME.zip).
KEPT_READ_NAME_MOST: int = 64;

kept_read_ids: []int = new int[KEPT_READS_MOST](0);

kept_read_names: []i8 = new i8[KEPT_READS_MOST * KEPT_READ_NAME_MOST](0i8);

kept_read_lens: []int = new int[KEPT_READS_MOST](0);

// Each read's span (a whole file's: offset 0, count -1).
kept_read_offsets: []int = new int[KEPT_READS_MOST](0);

kept_read_counts: []int = new int[KEPT_READS_MOST](0);

kept_reads_n: int = 0;

kept_reads_said: int = 0;

android_read_kept(id: int, name: []i8, name_n: int) {
    android_read_kept_range(id, name, name_n, 0, 0 - 1)
}

// count bytes from offset (count -1: to its end) of the kept file named.
android_read_kept_range(
    id: int,
    name: []i8,
    name_n: int,
    offset: int,
    count: int
) {
    if (kept_reads_n >= KEPT_READS_MOST || name_n > KEPT_READ_NAME_MOST) {
        late_line("got ", id, " -1\n");
        return
    }
    kept_read_ids[kept_reads_n] = id;
    for i in 0..name_n kept_read_names[kept_reads_n * KEPT_READ_NAME_MOST + i] = name[i];
    kept_read_lens[kept_reads_n] = name_n;
    kept_read_offsets[kept_reads_n] = offset;
    kept_read_counts[kept_reads_n] = count;
    kept_reads_n = kept_reads_n + 1
}

// The size of a read's span: the bytes there are from its offset, at most
// its count (-1: no such file).
kept_read_size(k: int): int {
    kept_read_path(k);
    size: int = path_size();
    if (size < 0) return size;
    left: int = size - kept_read_offsets[k];
    if (left < 0) left = 0;
    count: int = kept_read_counts[k];
    if (count >= 0 && count < left) count else left
}

// count bytes of data kept as the file named, answered `kept ID OK` (with
// the asks: core's host reads it next).
android_keep(
    id: int,
    name: []i8,
    name_n: int,
    data: []i8,
    count: int
) {
    path_begin();
    for i in 0..name_n path_put(name[i] as int);
    path_end();
    ok: bool = false;
    // (O_WRONLY | O_CREAT | O_TRUNC)
    fd: int = open_raw(&path[0], 577, 384);
    if (fd >= 0) {
        ok = true;
        try {
            write_bytes_n(fd, data, count)
        } with IoError _e -> {
            ok = false
        }
        close(fd)
    }
    late_line("kept ", id, if (ok) " 1\n" else " 0\n")
}

// A line answered with the asks: word, id and the rest. (Not by fbuf,
// which core may be using.)
late_line(word: str, id: int, rest: str) {
    for c in word late_put(c as int);
    d: int = 1;
    while (d * 10 <= id) d = d * 10;
    while (d > 0) {
        late_put(48 + id / d % 10);
        d = d / 10
    }
    for c in rest late_put(c as int)
}

late_put(k: int) {
    if (late_n < len(late)) {
        late[late_n] = k trunc i8;
        late_n = late_n + 1
    }
}

// Lines answered at once (a read that couldn't wait), sent with the asks.
late: []i8 = new i8[4096](0i8);

late_n: int = 0;

kept_read_find(id: int): int {
    for k in 0..kept_reads_n
        if (kept_read_ids[k] == id) return k;
    -1
}

// Kept read k's path.
kept_read_path(k: int) {
    path_begin();
    for i in 0..kept_read_lens[k] path_put(kept_read_names[k * KEPT_READ_NAME_MOST + i] as int);
    path_end()
}

kept_read_forget(k: int) {
    for j in k..kept_reads_n - 1 {
        kept_read_ids[j] = kept_read_ids[j + 1];
        kept_read_lens[j] = kept_read_lens[j + 1];
        kept_read_offsets[j] = kept_read_offsets[j + 1];
        kept_read_counts[j] = kept_read_counts[j + 1];
        for i in 0..KEPT_READ_NAME_MOST kept_read_names[j * KEPT_READ_NAME_MOST + i] = kept_read_names[(j + 1) * KEPT_READ_NAME_MOST + i]
    }
    kept_reads_n = kept_reads_n - 1;
    if (kept_reads_said > k) kept_reads_said = kept_reads_said - 1
}

// File or answer id into out: its length.
android_file(id: int, out: []i8): int {
    k: int = kept_read_find(id);
    if (k >= 0) {
        offset: int = kept_read_offsets[k];
        size: int = kept_read_size(k);
        kept_read_forget(k);
        if (size <= 0) return 0;
        return path_read(offset, out)
    }
    if (id >= ASKED_MOST) http_path(id) else {
        asked_path(id, false);
        if (path_size() < 0) asked_path(id, true)
    }
    path_read(0, out)
}

// The asks answered (and the kept reads): each `got ID SIZE` (-1: not
// there), as lines core's host reads next; whether there were any.
answer_asks(): bool {
    if (waiting_n == 0 && kept_reads_said >= kept_reads_n && late_n == 0) return false;
    n: int = 0;
    for i in 0..late_n {
        hs_inbox[n] = late[i];
        n = n + 1
    }
    late_n = 0;
    while (kept_reads_said < kept_reads_n) {
        fbuf_n = 0;
        fput_str("got ");
        fput_int(kept_read_ids[kept_reads_said]);
        fput(32);
        fput_int(kept_read_size(kept_reads_said));
        fput(10);
        for i in 0..fbuf_n {
            hs_inbox[n] = fbuf[i];
            n = n + 1
        }
        kept_reads_said = kept_reads_said + 1
    }
    for w in 0..waiting_n {
        id: int = waiting[w];
        asked_path(id, false);
        size: int = path_size();
        if (size < 0) {
            asked_path(id, true);
            size = path_size()
        }
        fbuf_n = 0;
        fput_str("got ");
        fput_int(id);
        fput(32);
        fput_int(size);
        fput(10);
        for i in 0..fbuf_n {
            hs_inbox[n] = fbuf[i];
            n = n + 1
        }
    }
    waiting_n = 0;
    hs_lines(n);
    true
}

// ---- the network: a GET, made by the Java side ----
http_line: []i8 = new i8[4096](0i8);

android_http(id: int, b: []i8, n: int) {
    k: int = 0;
    for c in "http_get " {
        http_line[k] = c;
        k = k + 1
    }
    d: int = 1;
    while (d * 10 <= id) d = d * 10;
    while (d > 0) {
        http_line[k] = (48 + id / d % 10) trunc i8;
        k = k + 1;
        d = d / 10
    }
    http_line[k] = 32i8;
    k = k + 1;
    for i in 0..n {
        if (k < len(http_line) - 1) {
            http_line[k] = b[i];
            k = k + 1
        }
    }
    http_line[k] = 10i8;
    _s: int = and_say_at(http_line, 0, k + 1)
}

// A recording fetched into a kept file, by the Java side: fetch_get ID URL
// NAME (core's names and addresses have no spaces).
android_fetch(
    id: int,
    url: []i8,
    url_n: int,
    name: []i8,
    name_n: int
) {
    k: int = 0;
    for c in "fetch_get " {
        http_line[k] = c;
        k = k + 1
    }
    d: int = 1;
    while (d * 10 <= id) d = d * 10;
    while (d > 0) {
        http_line[k] = (48 + id / d % 10) trunc i8;
        k = k + 1;
        d = d / 10
    }
    http_line[k] = 32i8;
    k = k + 1;
    // (It fits: an address is at most 512 bytes (core's au), a kept name
    // at most 64 (kp_name).)
    for i in 0..url_n {
        http_line[k] = url[i];
        k = k + 1
    }
    http_line[k] = 32i8;
    k = k + 1;
    for i in 0..name_n {
        http_line[k] = name[i];
        k = k + 1
    }
    http_line[k] = 10i8;
    _s: int = and_say_at(http_line, 0, k + 1)
}

android_say(b: []i8, start: int, n: int) {
    _s: int = and_say_at(b, start, n)
}

// ---- the lines ----
// The first: where the app's files are (files DIR); taken off the front.
take_files(n: int): int {
    if (n < 6 || !sk_word_is(hs_inbox, 0, n, "files")) return n;
    e: int = 0;
    while (e < n && hs_inbox[e] as int != 10) e = e + 1;
    files_n = 0;
    for k in 6..e {
        if (files_n < len(files_dir)) {
            files_dir[files_n] = hs_inbox[k];
            files_n = files_n + 1
        }
    }
    rest: int = n - e - 1;
    for k in 0..rest hs_inbox[k] = hs_inbox[e + 1 + k];
    rest
}

main() noregion: int {
    kept_store = KeptStore {
        read: &kp_read_file,
        write: &kp_write_file,
        append: &kp_append_file,
        remove: &kp_remove_file
    };
    host_io = HostIO {
        ask: &android_ask,
        http: &android_http,
        file: &android_file,
        fetch: &android_fetch,
        read_kept: &android_read_kept,
        read_kept_range: &android_read_kept_range,
        keep: &android_keep,
        say: &android_say
    };
    begun: bool = false;
    while (true) {
        _w: int = and_wait(1000);
        n: int = and_take(hs_inbox, len(hs_inbox));
        if (n > 0) {
            if (!begun) {
                n = take_files(n);
                if (files_n > 0) {
                    begun = true;
                    hs_start();
                    // (A phone's: its fonts, Android's own faces.)
                    sk_device = "Phone";
                    sk_device_prose = "phone";
                    sk_fonts = ["Serif", "Sans Serif", "Monospace"]
                }
            }
            if (begun) {
                hs_lines(n);
                while (answer_asks()) { }
                hs_after();
                // (What it said made more asks: answered too.)
                while (answer_asks()) hs_after()
            }
        } else if (begun && answer_asks()) hs_after()
    }
    0
}
