tag bible_android;

use_tag std, bible;

// Smooth Bible on Android (SKINS.md): the app (core/skin.l8) on a thread
// of its own, in a shared library the Java side loads (glue.c, Bible.java),
// built with `l8 arm64 --target android` (android/build.sh). It does what
// only a host can: it reads the versions, and keeps the settings and what
// is kept (core's files), in the app's files (the Java side copies the
// versions there from the APK's assets first). Every other line the Java
// side sends is the app's, and what the app answers (ui_out) goes back to
// it as it is.
//
//   files DIR      where the app's files are (first, before anything)
//   ...            the wire (SKINS.md): start, tap, act, want, place, ...
import "../../../stdlib/write.l8";

import "../core/skin.l8";

extern and_wait(ms: int): int;

extern and_take(buf: []i8, cap: int): int;

extern and_say_at(text: []i8, at: int, n: int): int;

extern and_log(text: str, n: int): int;

extern close(fd: int): int;

extern unlink_raw(path: *i8): int = unlink;

extern open_raw(path: *i8, flags: int, mode: int): int = open;

// ---- files ----
files_dir: []i8 = new i8[1024](0i8);

files_n: int = 0;

path: []i8 = new i8[1200](0i8);

// The path of kept file kp_name (core/kept.l8's) in the app's files,
// NUL-ended, in path.
kp_path() {
    n: int = 0;
    for i in 0..files_n {
        path[n] = files_dir[i];
        n = n + 1
    }
    path[n] = 47i8;
    n = n + 1;
    for i in 0..kp_name_n {
        path[n] = kp_name[i];
        n = n + 1
    }
    path[n] = 0i8
}

// The path of name in the app's files, NUL-ended, in path.
file_path(name: str) {
    n: int = 0;
    for i in 0..files_n {
        path[n] = files_dir[i];
        n = n + 1
    }
    path[n] = 47i8;
    n = n + 1;
    for c in name {
        if (n < len(path) - 1) {
            path[n] = c;
            n = n + 1
        }
    }
    path[n] = 0i8
}

got_n: int = 0;

// File name read whole (got_n bytes; none if it is not there).
read_file(name: str, most: int): []i8@new {
    buf: []i8 = new i8[most](0i8);
    got_n = 0;
    file_path(name);
    fd: int = open_raw(&path[0], 0, 0);
    if (fd < 0) return buf;
    more: bool = true;
    while (more) {
        k: int = read(fd, buf, got_n, len(buf) - got_n);
        if (k <= 0) more = false else got_n = got_n + k
    }
    close(fd);
    buf
}

extern lseek(fd: int, offset: int, whence: int): int;

// File name read whole, in a buffer its size (got_n its length; none if it
// is not there).
read_whole(name: str): []i8@new {
    file_path(name);
    fd: int = open_raw(&path[0], 0, 0);
    size: int = if (fd < 0) 0 else lseek(fd, 0, 2);
    if (fd >= 0) _r: int = lseek(fd, 0, 0);
    buf: []i8 = new i8[size + 1](0i8);
    got_n = 0;
    if (fd < 0) return buf;
    more: bool = true;
    while (more && got_n < size) {
        k: int = read(fd, buf, got_n, size - got_n);
        if (k <= 0) more = false else got_n = got_n + k
    }
    close(fd);
    buf
}

// The language data (the Hebrew and Greek, the lexicons, the cross
// references, the commentary), what Learn reads, and the Manual, read
// whole as the iPhone maps them.
load_lang() noregion {
    lw = read_whole("lang/words.bin");
    lw_n = got_n / 12;
    if (got_n == 0) return;
    lv = read_whole("lang/verses.bin");
    lv_n = got_n / 8 - 1;
    lsup = read_whole("lang/supplied.bin");
    lsup_n = got_n / 8;
    lforms = read_whole("lang/forms.txt");
    lforms_len = got_n;
    lmorph = read_whole("lang/morph.txt");
    lmorph_len = got_n;
    lconc = read_whole("lang/conc.bin");
    lconc_len = got_n;
    llex = read_whole("lang/lexicon.txt");
    llex_len = got_n;
    lgram = read_whole("lang/grammar.txt");
    lgram_len = got_n;
    lsen = read_whole("lang/senses.bin");
    lsen_n = got_n;
    lrel = read_whole("lang/related.bin");
    lrel_n = got_n;
    lxi = read_whole("xref_index.bin");
    lxi_n = got_n / 4;
    lxr = read_whole("xrefs.bin");
    lxr_n = got_n;
    lmh = read_whole("mhcc.txt");
    lmh_n = got_n;
    lmean = read_whole("lang/meanings.bin");
    lmean_n = got_n;
    lmeant = read_whole("lang/meanings.txt");
    lmeant_n = got_n;
    mean_index();
    lang_index();
    lvoc = read_whole("lang/vocab.bin");
    lvoc_n = got_n;
    llet = read_whole("lang/letters.txt");
    llet_n = got_n;
    learn_index_files();
    if (lang_ready) learn_index_lang();
    hlp = read_whole("help.txt");
    hlp_n = got_n;
    help_index()
}

// (The host's numbers: the language data, read at the start.)
android_num(what: int, _a: int): int {
    if (what == SK_NUM_LANG || what == SK_NUM_LEARN) return if (lang_ready) 1 else 0;
    // (Read aloud by the device's own voice; no recordings yet.)
    if (what == SK_NUM_AUDIO_SOURCE) return SRC_VOICE;
    if (what == SK_NUM_VOICE_SEEN || what == SK_NUM_BETTER_VOICE) return 1;
    -1
}

version_files: []str = ["bsb.txt", "kjv.txt", "web.txt", "asv.txt", "ylt.txt", "",
    "orig.txt"];

// The Hebrew and Greek's words (its text is counted by them, and its
// glosses read them), the Ketiv, and its accents: once.
orig_loaded: bool = false;

load_orig() noregion: bool {
    if (!orig_loaded) {
        orig_loaded = true;
        og = read_whole("lang/orig-words.bin");
        og_n = got_n / 12;
        lket = read_whole("lang/orig-ketiv.txt");
        lket_n = got_n;
        ket_index();
        og_setting = clamp_index(pref_get("origGlosses"), 4) - 1;
        lay_accents = pref_is("origAccents");
        if (lay_accents) {
            og_acc = read_whole("lang/orig-accents.txt");
            og_acc_n = got_n;
            og_acc_index()
        }
    }
    og_n > 0
}

load_version(t: int) noregion: bool {
    if (t < 0 || t >= len(version_files) || len(version_files[t]) == 0) return false;
    if (t == TEXT_ORIG && !load_orig()) return false;
    buf: []i8 = read_file(version_files[t], 8388608);
    if (got_n == 0) return false;
    text_load(t, buf, got_n);
    true
}

// ---- what is kept (core/kept.l8's), as files of the app's ----
kp_read_file() {
    kp_path();
    fd: int = open_raw(&path[0], 0, 0);
    fbuf_n = 0;
    if (fd < 0) return;
    more: bool = true;
    while (more) {
        r: int = read(fd, fbuf, fbuf_n, len(fbuf) - fbuf_n);
        if (r <= 0) more = false else fbuf_n = fbuf_n + r
    }
    close(fd)
}

kp_write_file() {
    kp_path();
    // (O_WRONLY | O_CREAT | O_TRUNC)
    kp_out(577)
}

kp_append_file() {
    kp_path();
    // (O_WRONLY | O_CREAT | O_APPEND)
    kp_out(1089)
}

kp_out(flags: int) {
    fd: int = open_raw(&path[0], flags, 384);
    if (fd < 0) return;
    try {
        write_bytes_n(fd, fbuf, fbuf_n)
    } with IoError _e -> { }
    close(fd)
}

kp_remove_file() {
    kp_path();
    _u: int = unlink_raw(&path[0])
}

// The plans: M'Cheyne's and the Chronological's days (in the APK), the
// plans made, then those followed (plans.txt's numbers, each its file).
load_plans() noregion {
    m: []i8 = read_whole("plans/mcheyne.txt");
    if (got_n > 0) plan_file_set(PLAN_MCHEYNE, m, got_n);
    k: []i8 = read_whole("plans/chrono.txt");
    if (got_n > 0) plan_file_set(PLAN_CHRONO, k, got_n)
}

// ---- the lines ----
inbox: []i8 = new i8[1048576](0i8);

begun: bool = false;

// What the app said, sent on whole, at most a megabyte at a time (at a
// line's end).
flush() {
    p: int = 0;
    while (p < ui_out_n) {
        e: int = if (ui_out_n - p > 1048576) p + 1048576 else ui_out_n;
        while (e > p + 1 && ui_out[e - 1] as int != 10) e = e - 1;
        _n: int = and_say_at(ui_out, p, e - p);
        p = e
    }
    ui_out_n = 0
}

is_files(b: int, e: int): bool {
    e - b > 6 && inbox[b] as int == 102 && inbox[b + 1] as int == 105 && inbox[b + 2] as int == 108 && inbox[b + 3] as int == 101 && inbox[b + 4] as int == 115 && inbox[b + 5] as int == 32
}

lines(n: int) noregion {
    p: int = 0;
    for i in 0..n {
        if (inbox[i] as int == 10) {
            if (is_files(p, i)) {
                files_n = i - p - 6;
                for k in 0..files_n files_dir[k] = inbox[p + 6 + k];
                if (!begun) {
                    begun = true;
                    if (!load_version(0)) _l: int = and_log("smoothbible: no bsb.txt in the files",
                        36);
                    text_use(0);
                    kept_load_prefs();
                    load_lang();
                    load_plans();
                    kept_load()
                }
            } else sk_line(inbox, p, i);
            p = i + 1
        }
    }
}

main() noregion: int {
    kept_store = KeptStore {
        read: &kp_read_file,
        write: &kp_write_file,
        append: &kp_append_file,
        remove: &kp_remove_file
    };
    sk_host = SkinHost {
        save_prefs: &kept_save_prefs,
        save_kept: &kept_save,
        words: &sk_no_words,
        switch_version: null,
        num: &android_num,
        fill: &sk_no_fill,
        fetch: null
    };
    // (Go To's ribbons and plans: kept here now. No reminders yet.)
    sk_has_ribbons = true;
    // (Listen: the device's voice, core's session.)
    sk_has_listen = true;
    sk_has_keep_on = true;
    while (true) {
        _w: int = and_wait(1000);
        n: int = and_take(inbox, len(inbox));
        if (n > 0) {
            lines(n);
            // (A version core wants, loaded here, then read.)
            t: int = sk_want_text;
            if (t >= 0) {
                sk_want_text = -1;
                if (load_version(t)) sk_use_version(t)
            }
            flush()
        }
    }
    0
}
