tag bible_android;

use_tag std, bible;

// Smooth Bible on Android (SKINS.md): the app (core) on a thread of its
// own, in a shared library the Java side loads (glue.c, Bible.java), built
// with `l8 arm64 --target android` (android/build.sh). Its host is core's
// (core/host.l8), as the web's is; this gives it Android's primitives: a
// data file (the app's files, copied there from the APK's assets by the
// Java side first), a GET (made by the Java side, its answer a file of the
// app's), the app's files for what is kept, and the lines to and from the
// skin.
//
//   files DIR      where the app's files are (the first line, always)
//   ...            the wire (SKINS.md), and the host's got, http, api
//
// To the Java side, besides core's lines: `http_get ID URL` (a GET whose
// body it writes to DIR/http/ID, then says `http ID STATUS SIZE`).
import "../../../stdlib/write.l8";

import "../core/host.l8";

extern and_wait(ms: int): int;

extern and_take(buf: []i8, cap: int): int;

extern and_say_at(text: []i8, at: int, n: int): int;

extern close(fd: int): int;

extern unlink_raw(path: *i8): int = unlink;

extern open_raw(path: *i8, flags: int, mode: int): int = open;

extern lseek(fd: int, offset: int, whence: int): int;

// ---- files ----
files_dir: []i8 = static_buffer([1024]i8);

files_n: int = 0;

path: []i8 = static_buffer([1200]i8);

path_n: int = 0;

path_begin() {
    path_n = 0;
    for i in 0..files_n path_put(files_dir[i] as int);
    path_put(47)
}

path_put(k: int) {
    if (path_n < len(path) - 1) {
        path[path_n] = k trunc i8;
        path_n = path_n + 1
    }
}

path_end() {
    path[path_n] = 0i8
}

// The path of kept file kp_name (core/kept.l8's) in the app's files.
kp_path() {
    path_begin();
    for i in 0..kp_name_n path_put(kp_name[i] as int);
    path_end()
}

// File path's size (-1: it isn't there).
path_size(): int {
    fd: int = open_raw(&path[0], 0, 0);
    if (fd < 0) return -1;
    n: int = lseek(fd, 0, 2);
    close(fd);
    n
}

// File path read into out (as much as fits): how much.
path_read(out: []i8): int {
    fd: int = open_raw(&path[0], 0, 0);
    if (fd < 0) return 0;
    got: int = 0;
    more: bool = true;
    while (more && got < len(out)) {
        k: int = read(fd, out, got, len(out) - got);
        if (k <= 0) more = false else got = got + k
    }
    close(fd);
    got
}

// ---- what is kept (core/kept.l8's), as files of the app's ----
kp_read_file() {
    kp_path();
    fbuf_n = path_read(fbuf)
}

kp_write_file() {
    kp_path();
    // (O_WRONLY | O_CREAT | O_TRUNC)
    kp_out(577)
}

kp_append_file() {
    kp_path();
    // (O_WRONLY | O_CREAT | O_APPEND)
    kp_out(1089)
}

kp_out(flags: int) {
    fd: int = open_raw(&path[0], flags, 384);
    if (fd < 0) return;
    try {
        write_bytes_n(fd, fbuf, fbuf_n)
    } with IoError _e -> { }
    close(fd)
}

kp_remove_file() {
    kp_path();
    _u: int = unlink_raw(&path[0])
}

// ---- the data files core's host asks for ----
// Each id's name as asked (a version's, "bsb", is bsb.txt in the files),
// and the asks not yet answered: answered in the loop, `got ID SIZE`.
ASKED_MOST: int = 128;

asked_name: []i8 = static_buffer(128 * 64, 0i8);

asked_len: []int = static_buffer([128]int);

waiting: []int = static_buffer([128]int);

waiting_n: int = 0;

android_ask(id: int, name: str) {
    if (id < 0 || id >= ASKED_MOST) return;
    n: int = 0;
    for c in name {
        if (n < 64) {
            asked_name[id * 64 + n] = c;
            n = n + 1
        }
    }
    asked_len[id] = n;
    if (waiting_n < len(waiting)) {
        waiting[waiting_n] = id;
        waiting_n = waiting_n + 1
    }
}

// Data file id's path (its name, or its name with .txt).
asked_path(id: int, txt: bool) {
    path_begin();
    for i in 0..asked_len[id] path_put(asked_name[id * 64 + i] as int);
    if (txt)
        for c in ".txt" path_put(c as int);
    path_end()
}

// A GET's answer's path: http/ID.
http_path(id: int) {
    path_begin();
    for c in "http/" path_put(c as int);
    d: int = 1;
    while (d * 10 <= id) d = d * 10;
    while (d > 0) {
        path_put(48 + id / d % 10);
        d = d / 10
    }
    path_end()
}

// File or answer id into out: its length.
android_file(id: int, out: []i8): int {
    if (id >= ASKED_MOST) http_path(id) else {
        asked_path(id, false);
        if (path_size() < 0) asked_path(id, true)
    }
    path_read(out)
}

// The asks answered: each `got ID SIZE` (-1: not there), as lines core's
// host reads next; whether there were any.
answer_asks() noregion: bool {
    if (waiting_n == 0) return false;
    n: int = 0;
    for w in 0..waiting_n {
        id: int = waiting[w];
        asked_path(id, false);
        size: int = path_size();
        if (size < 0) {
            asked_path(id, true);
            size = path_size()
        }
        fbuf_n = 0;
        fput_str("got ");
        fput_int(id);
        fput(32);
        fput_int(size);
        fput(10);
        for i in 0..fbuf_n {
            hs_inbox[n] = fbuf[i];
            n = n + 1
        }
    }
    waiting_n = 0;
    hs_lines(n);
    true
}

// ---- the network: a GET, made by the Java side ----
http_line: []i8 = static_buffer([4096]i8);

android_http(id: int, b: []i8, n: int) {
    k: int = 0;
    for c in "http_get " {
        http_line[k] = c;
        k = k + 1
    }
    d: int = 1;
    while (d * 10 <= id) d = d * 10;
    while (d > 0) {
        http_line[k] = (48 + id / d % 10) trunc i8;
        k = k + 1;
        d = d / 10
    }
    http_line[k] = 32i8;
    k = k + 1;
    for i in 0..n {
        if (k < len(http_line) - 1) {
            http_line[k] = b[i];
            k = k + 1
        }
    }
    http_line[k] = 10i8;
    _s: int = and_say_at(http_line, 0, k + 1)
}

android_say(b: []i8, start: int, n: int) {
    _s: int = and_say_at(b, start, n)
}

// ---- the lines ----
// The first: where the app's files are (files DIR); taken off the front.
take_files(n: int): int {
    if (n < 6 || !sk_word_is(hs_inbox, 0, n, "files")) return n;
    e: int = 0;
    while (e < n && hs_inbox[e] as int != 10) e = e + 1;
    files_n = 0;
    for k in 6..e {
        if (files_n < len(files_dir)) {
            files_dir[files_n] = hs_inbox[k];
            files_n = files_n + 1
        }
    }
    rest: int = n - e - 1;
    for k in 0..rest hs_inbox[k] = hs_inbox[e + 1 + k];
    rest
}

main() noregion: int {
    kept_store = KeptStore {
        read: &kp_read_file,
        write: &kp_write_file,
        append: &kp_append_file,
        remove: &kp_remove_file
    };
    host_io = HostIO {
        ask: &android_ask,
        http: &android_http,
        file: &android_file,
        say: &android_say
    };
    begun: bool = false;
    while (true) {
        _w: int = and_wait(1000);
        n: int = and_take(hs_inbox, len(hs_inbox));
        if (n > 0) {
            if (!begun) {
                n = take_files(n);
                if (files_n > 0) {
                    begun = true;
                    hs_start();
                    // (A phone's: its fonts, Android's own faces.)
                    sk_device = "Phone";
                    sk_device_prose = "phone";
                    sk_fonts = ["Serif", "Sans Serif", "Monospace"]
                }
            }
            if (begun) {
                hs_lines(n);
                while (answer_asks()) { }
                hs_after();
                // (What it said made more asks: answered too.)
                while (answer_asks()) hs_after()
            }
        } else if (begun && answer_asks()) hs_after()
    }
    0
}
