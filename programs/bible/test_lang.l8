test "where G26 and G25 occur" {
    load();
    conc_load(true, 26);
    write_int(1, cc_words);
    write(1, " times in ");
    write_int(1, cc_n);
    print(" verses");
    conc_load(true, 25);
    write_int(1, cc_words);
    write(1, " times in ");
    write_int(1, cc_n);
    print(" verses");
    conc_marks(cc_vi[0]);
    title_of(v_chapter(cc_vi[0]));
    show(out, 0, out_n);
    write(1, ":");
    write_int(1, v_num(cc_vi[0]));
    write(1, " ");
    for i in 0..mk_n {
        show(st, mk_b[i], mk_e[i]);
        write(1, "|")
    }
    print("");
    renderings();
    total: int = rd_none;
    for r in 0..rd_n total = total + rd_count[r];
    for r in 0..4 {
        show(rd_pool, rd_at[r], rd_at[r] + rd_len[r]);
        write(1, " ");
        write_int(1, rd_count[r]);
        print("")
    }
    write_int(1, total);
    write(1, " in all, ");
    write_int(1, rd_none);
    print(" not translated");
    conc_only(1);
    write_int(1, cc_words);
    write(1, " times in ");
    write_int(1, cc_n);
    print(" verses");
    expect {|
        116 times in 106 verses
        143 times in 110 verses
        Matthew 5:43 Love|
        love 36
        loved 17
        loves 17
        you love 5
        143 in all, 2 not translated
        17 times in 16 verses
    |}
}

test "the lexicon's markup" {
    load();
    p: int = lex_first(true, 25);
    write_int(1, lex_count(p));
    print(" entry");
    lex_field(p, 0);
    show(llex, lf_b, lf_e);
    lex_field(p, 1);
    write(1, " ");
    show(llex, lf_b, lf_e);
    lex_field(p, 3);
    write(1, " ");
    show(llex, lf_b, lf_e);
    print("");
    lex_field(p, 4);
    lex_markup(lf_b, lf_e);
    a: int = 0;
    shown: int = 0;
    for r in 0..lx_runs {
        s: int = lx_style[r];
        if (shown < 9 && (s & (LX_BOLD | LX_REF)) != 0) {
            write_int(1, s);
            if (lx_sense[r]) write(1, " sense");
            if ((s & LX_REF) != 0) {
                write(1, " ");
                write_bytes_n(1, slice_bsb(book_line[lx_book[r]] + 1, book_line[lx_book[r]] + 4),
                    3);
                write(1, " ");
                write_int(1, lx_ch[r]);
                write(1, ":");
                write_int(1, lx_verse[r])
            }
            write(1, " ");
            show(lx, a, lx_end[r]);
            print("|");
            shown = shown + 1
        }
        a = lx_end[r]
    }
    p = lex_first(false, 7462);
    write_int(1, lex_count(p));
    print(" entries");
    lex_field(p, 0);
    show(llex, lf_b, lf_e);
    lex_field(p, 1);
    write(1, " ");
    show(llex, lf_b, lf_e);
    lex_field(p, 3);
    write(1, " ");
    show(llex, lf_b, lf_e);
    print("");
    expect {|
        1 entry
        ἀγαπάω agapaō to love
        9 ἀγαπάω|
        1 to love|
        1 sense Of human affection, to men|
        4 sense MAT 5:43 Matt 5:43|
        4 sense JHN 8:42 John 8:42|
        4 sense MAT 22:37 Matt 22:37|
        4 sense LUK 11:43 Luke 11:43|
        4 sense JHN 12:43 John 12:43|
        4 sense EPH 5:25 Eph 5:25|
        4 entries
        רָעָה rā‘āh to pasture
    |}
}

slice_buf: []i8 = new i8[64](0i8);

slice_bsb(p: int, e: int): []i8 {
    for i in p..e slice_buf[i - p] = bsb[i];
    slice_buf
}

// A parsing (of the first word of verse v of chapter c whose code is code).
parsing_of(code: str) raises IoError {
    for m in 0..morph_n {
        morph_of(m);
        if (mc_e - mc_b == len(code)) {
            same: bool = true;
            for i in 0..len(code)
                if (lmorph[mc_b + i] != code[i]) same = false;
            if (same) {
                plain_parsing(m);
                write_bytes_n(1, pl, pl_n);
                print("");
                for t in 0..pt_n {
                    write(1, "  ");
                    write_int(1, pt_part[t]);
                    write(1, " ");
                    show(pt_buf, pt_b[t], pt_e[t]);
                    if (pt_gram[t] >= 0) {
                        gram_parts(pt_gram[t]);
                        write(1, ": ");
                        show(lgram, gx_b, mini(gx_e, gx_b + 40))
                    }
                    print("")
                }
                return
            }
        }
    }
    print("none")
}

mini(a: int, b: int): int {
    if (a < b) a else b
}

test "parsings in plain English" {
    load();
    parsing_of("V-AIA-3S");
    parsing_of("V-Qal-Prtcpl-msc | 1cs");
    parsing_of("Conj-w | N-fs");
    parsing_of("V-PPA-NMS");
    expect "Verb · aorist · indicative · active · 3rd person singular\n  1 verb: A word for an action or a state: what so\n  1 aorist: Presents an action simply as a whole, us\n  1 indicative: States something as a fact or asks a pla\n  1 active: The subject does the action.\n  1 3rd person: Someone or something spoken about: he, s\n  1 singular: One person or thing.\nVerb · Qal · participle · masculine singular construct + suffix 1st person common singular\n  1 verb: A word for an action or a state: what so\n  1 Qal: The plain, simple stem of a Hebrew verb,\n  1 participle: A verb used as a describing word or a no\n  1 masculine: The grammatical gender of words for men \n  1 singular: One person or thing.\n  1 construct: This noun is bound to the one after it, \n  2 1st person: The speaker: I or we.\n  2 common: The form is the same for masculine and f\n  2 singular: One person or thing.\nConjunctive waw + noun · feminine singular\n  0 conjunctive waw: The prefix and (also but, so, then), joi\n  1 noun: A word that names a person, a place, a t\n  1 feminine: The grammatical gender of words for wome\n  1 singular: One person or thing.\nVerb · present · participle · active · nominative · masculine singular\n  1 verb: A word for an action or a state: what so\n  1 present: Shows an action as going on or repeated,\n  1 participle: A verb used as a describing word or a no\n  1 active: The subject does the action.\n  1 nominative: The case of the subject of a sentence: t\n  1 masculine: The grammatical gender of words for men \n  1 singular: One person or thing.\n"
}

