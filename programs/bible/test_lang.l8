tag bible_tests;

use_tag std, bible;

// The original-language data (data/lang/) as the study screens read them:
// words found from the reader's text, tiles of the interlinear, where a
// number occurs and how it is translated, the lexicon's markup, parsings in
// plain English, and references in a note.
import "../../stdlib/print.l8";

import "text.l8";

import "lang.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

// A file, whole, into a new array (and its length in file_n).
file_n: int = 0;

scratch: []i8 = new i8[8388608](0i8);

read_whole(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    got: int = 0;
    more: bool = fd >= 0;
    while (more && got < len(scratch)) {
        r: int = read(fd, scratch, got, len(scratch) - got);
        if (r <= 0) more = false else got = got + r
    }
    if (fd >= 0) close(fd);
    b: []i8 = new i8[got + 1](0i8);
    for i in 0..got b[i] = scratch[i];
    file_n = got;
    b
}

loaded: bool = false;

load() noregion {
    if (loaded) return;
    loaded = true;
    bsb = read_whole("programs/bible/data/bsb.txt");
    bible_index(file_n);
    lw = read_whole("programs/bible/data/lang/words.bin");
    lw_n = file_n / 12;
    lv = read_whole("programs/bible/data/lang/verses.bin");
    lv_n = file_n / 8 - 1;
    lsup = read_whole("programs/bible/data/lang/supplied.bin");
    lsup_n = file_n / 8;
    lforms = read_whole("programs/bible/data/lang/forms.txt");
    lforms_len = file_n;
    lmorph = read_whole("programs/bible/data/lang/morph.txt");
    lmorph_len = file_n;
    lconc = read_whole("programs/bible/data/lang/conc.bin");
    lconc_len = file_n;
    llex = read_whole("programs/bible/data/lang/lexicon.txt");
    llex_len = file_n;
    lgram = read_whole("programs/bible/data/lang/grammar.txt");
    lgram_len = file_n;
    lang_index()
}

pb: []i8 = new i8[65536](0i8);

// Bytes a to b of buffer x.
show(x: []i8, a: int, b: int) raises IoError {
    for i in a..b pb[i - a] = x[i];
    write_bytes_n(1, pb, b - a)
}

key(w: int) raises IoError {
    write(1, if (w_greek(w)) "G" else "H");
    write_int(1, w_strongs(w))
}

// Word w: its number, parsing, form and transliteration, and its English.
show_word(w: int) raises IoError {
    key(w);
    write(1, " ");
    morph_of(w_morph(w));
    show(lmorph, mc_b, mc_e);
    form_of(w);
    write(1, " ");
    show(lforms, wf_b, wf_e);
    write(1, " ");
    show(lforms, wt_b, wt_e);
    chunk_of(w);
    write(1, " \"");
    show(st, ch_b, ch_e);
    write(1, "\"");
    fl: int = w_flags(w);
    if ((fl & 1) != 0) write(1, " untranslated");
    if ((fl & 2) != 0) write(1, if ((fl & 8) != 0) " with previous" else " with next");
    print("")
}

// Where word (the bytes of s) is in verse v of chapter c as laid out, picked.
pick(c: int, v: int, s: str) raises IoError {
    layout_chapter(c);
    i: int = verse_index(v);
    b: int = verse_begin[i];
    found: int = -1;
    // (A psalm's title is before its verse 1.)
    if (v == 1) b = 0;
    for p in b..out_n - len(s) {
        if (found < 0) {
            same: bool = true;
            for k in 0..len(s)
                if (out[p + k] != s[k]) same = false;
            if (same) found = p
        }
    }
    write(1, s);
    write(1, ": ");
    if (found < 0 || !study_pick(c, found, found + len(s))) {
        print("not picked");
        return
    }
    write_int(1, pick_t0);
    write(1, "-");
    write_int(1, pick_t1);
    write(1, " ");
    if (pick_word < 0) print("no word") else show_word(pick_word)
}

john3(): int {
    book_first[42] + 2
}

psalm23(): int {
    book_first[18] + 22
}

test "every verse aligned" {
    load();
    n: int = 0;
    for vi in 0..lv_n
        if (v_aligned(vi)) n = n + 1;
    write_int(1, n);
    write(1, " of ");
    write_int(1, lv_n);
    write(1, " verses, ");
    write_int(1, lw_n);
    print(" words");
    expect {|
        31086 of 31086 verses, 443625 words
    |}
}

test "words picked in the reader" {
    load();
    pick(john3(), 16, "loved");
    pick(john3(), 16, "only");
    pick(0, 1, "created");
    pick(0, 1, "beginning");
    pick(psalm23(), 1, "shepherd");
    pick(psalm23(), 1, "David");
    pick(psalm23(), 1, "LORD is");
    expect {|
        loved: 3-3 G25 V-AIA-3S ἠγάπησεν ēgapēsen "loved"
        only: 12-12 G3439 Adj-AMS μονογενῆ monogenē "one and only"
        created: 4-4 H1254 V-Qal-Perf-3ms בָּרָא bā·rā "created"
        beginning: 2-2 H7225 Prep-b | N-fs בְּרֵאשִׁית bə·rê·šîṯ "In the beginning"
        shepherd: 8-8 H7462 V-Qal-Prtcpl-msc | 1cs רֹעִי rō·‘î "is my shepherd"
        David: 3-3 H1732 Prep-l | N-proper-ms לְדָוִד lə·ḏā·wiḏ "of David"
        LORD is: 5-6 H3068 N-proper-ms יְהוָה Yah·weh "The LORD"
    |}
}

test "Genesis 1:1 in the original order" {
    load();
    interlinear_tiles(lang_verse(0, 1), true);
    for i in 0..tile_n show_word(tile_word[i]);
    expect {|
        H7225 Prep-b | N-fs בְּרֵאשִׁית bə·rê·šîṯ "In the beginning"
        H1254 V-Qal-Perf-3ms בָּרָא bā·rā "created"
        H430 N-mp אֱלֹהִים ’ĕ·lō·hîm "God"
        H853 DirObjM אֵת ’êṯ "" untranslated
        H8064 Art | N-mp הַשָּׁמַיִם haš·šā·ma·yim "the heavens"
        H853 Conj-w | DirObjM וְאֵת wə·’êṯ "and"
        H776 Art | N-fs הָאָֽרֶץ hā·’ā·reṣ "the earth"
    |}
}

test "John 3:16 in English order" {
    load();
    vi: int = lang_verse(john3(), 16);
    interlinear_tiles(vi, false);
    for i in 0..12 {
        if (tile_word[i] < 0) {
            write(1, "supplied \"");
            show(st, tok_b[tile_t0[i]], tok_e[tile_t0[i] + tile_tn[i] - 1]);
            print("\"")
        } else show_word(tile_word[i])
    }
    for t in 0..tok_n
        if (tok_sup[t] != 0) {
            show(st, tok_b[t], tok_e[t]);
            print(" is supplied")
        }
    expect {|
        G1063 Conj γὰρ gar "For"
        G3588 Art-NMS ὁ ho "" untranslated
        G2316 N-NMS Θεὸς Theos "God"
        G3779 Adv Οὕτως Houtōs "so"
        G25 V-AIA-3S ἠγάπησεν ēgapēsen "loved"
        G3588 Art-AMS τὸν ton "the"
        G2889 N-AMS κόσμον kosmon "world"
        G5620 Conj ὥστε hōste "that"
        G1325 V-AIA-3S ἔδωκεν edōken "He gave"
        G3588 Art-AMS τὸν ton "His"
        G3588 Art-AMS τὸν ton "" untranslated
        G3439 Adj-AMS μονογενῆ monogenē "one and only"
        His is supplied
    |}
}

test "tiles in lines" {
    ws: []f64 = [50.0f64, 60.0f64, 70.0f64, 40.0f64, 100.0f64, 30.0f64];
    wrap_tiles(ws, 6, 200.0f64, 6.0f64);
    for i in 0..line_count {
        write_int(1, line_first[i]);
        write(1, " ")
    }
    print("");
    expect "0 3 \n"
}

test "where G26 and G25 occur" {
    load();
    conc_load(true, 26);
    write_int(1, cc_words);
    write(1, " times in ");
    write_int(1, cc_n);
    print(" verses");
    conc_load(true, 25);
    write_int(1, cc_words);
    write(1, " times in ");
    write_int(1, cc_n);
    print(" verses");
    conc_marks(cc_vi[0]);
    title_of(v_chapter(cc_vi[0]));
    show(out, 0, out_n);
    write(1, ":");
    write_int(1, v_num(cc_vi[0]));
    write(1, " ");
    for i in 0..mk_n {
        show(st, mk_b[i], mk_e[i]);
        write(1, "|")
    }
    print("");
    renderings();
    total: int = rd_none;
    for r in 0..rd_n total = total + rd_count[r];
    for r in 0..4 {
        show(rd_pool, rd_at[r], rd_at[r] + rd_len[r]);
        write(1, " ");
        write_int(1, rd_count[r]);
        print("")
    }
    write_int(1, total);
    write(1, " in all, ");
    write_int(1, rd_none);
    print(" not translated");
    conc_only(1);
    write_int(1, cc_words);
    write(1, " times in ");
    write_int(1, cc_n);
    print(" verses");
    expect {|
        116 times in 106 verses
        143 times in 110 verses
        Matthew 5:43 Love|
        love 36
        loved 17
        loves 17
        you love 5
        143 in all, 2 not translated
        17 times in 16 verses
    |}
}

test "the lexicon's markup" {
    load();
    p: int = lex_first(true, 25);
    write_int(1, lex_count(p));
    print(" entry");
    lex_field(p, 0);
    show(llex, lf_b, lf_e);
    lex_field(p, 1);
    write(1, " ");
    show(llex, lf_b, lf_e);
    lex_field(p, 3);
    write(1, " ");
    show(llex, lf_b, lf_e);
    print("");
    lex_field(p, 4);
    lex_markup(lf_b, lf_e);
    a: int = 0;
    shown: int = 0;
    for r in 0..lx_runs {
        s: int = lx_style[r];
        if (shown < 9 && (s & (LX_BOLD | LX_REF)) != 0) {
            write_int(1, s);
            if (lx_sense[r]) write(1, " sense");
            if ((s & LX_REF) != 0) {
                write(1, " ");
                write_bytes_n(1, slice_bsb(book_line[lx_book[r]] + 1, book_line[lx_book[r]] + 4),
                    3);
                write(1, " ");
                write_int(1, lx_ch[r]);
                write(1, ":");
                write_int(1, lx_verse[r])
            }
            write(1, " ");
            show(lx, a, lx_end[r]);
            print("|");
            shown = shown + 1
        }
        a = lx_end[r]
    }
    p = lex_first(false, 7462);
    write_int(1, lex_count(p));
    print(" entries");
    lex_field(p, 0);
    show(llex, lf_b, lf_e);
    lex_field(p, 1);
    write(1, " ");
    show(llex, lf_b, lf_e);
    lex_field(p, 3);
    write(1, " ");
    show(llex, lf_b, lf_e);
    print("");
    expect {|
        1 entry
        ἀγαπάω agapaō to love
        9 ἀγαπάω|
        1 to love|
        1 sense Of human affection, to men|
        4 sense MAT 5:43 Matt 5:43|
        4 sense JHN 8:42 John 8:42|
        4 sense MAT 22:37 Matt 22:37|
        4 sense LUK 11:43 Luke 11:43|
        4 sense JHN 12:43 John 12:43|
        4 sense EPH 5:25 Eph 5:25|
        4 entries
        רָעָה rā‘āh to pasture
    |}
}

slice_buf: []i8 = new i8[64](0i8);

slice_bsb(p: int, e: int): []i8 {
    for i in p..e slice_buf[i - p] = bsb[i];
    slice_buf
}

// A parsing (of the first word of verse v of chapter c whose code is code).
parsing_of(code: str) raises IoError {
    for m in 0..morph_n {
        morph_of(m);
        if (mc_e - mc_b == len(code)) {
            same: bool = true;
            for i in 0..len(code)
                if (lmorph[mc_b + i] != code[i]) same = false;
            if (same) {
                plain_parsing(m);
                write_bytes_n(1, pl, pl_n);
                print("");
                for t in 0..pt_n {
                    write(1, "  ");
                    write_int(1, pt_part[t]);
                    write(1, " ");
                    show(pt_buf, pt_b[t], pt_e[t]);
                    if (pt_gram[t] >= 0) {
                        gram_parts(pt_gram[t]);
                        write(1, ": ");
                        show(lgram, gx_b, mini(gx_e, gx_b + 40))
                    }
                    print("")
                }
                return
            }
        }
    }
    print("none")
}

mini(a: int, b: int): int {
    if (a < b) a else b
}

test "parsings in plain English" {
    load();
    parsing_of("V-AIA-3S");
    parsing_of("V-Qal-Prtcpl-msc | 1cs");
    parsing_of("Conj-w | N-fs");
    parsing_of("V-PPA-NMS");
    expect "Verb · aorist · indicative · active · 3rd person singular\n  1 verb: A word for an action or a state: what so\n  1 aorist: Presents an action simply as a whole, us\n  1 indicative: States something as a fact or asks a pla\n  1 active: The subject does the action.\n  1 3rd person: Someone or something spoken about: he, s\n  1 singular: One person or thing.\nVerb · Qal · participle · masculine singular construct + suffix 1st person common singular\n  1 verb: A word for an action or a state: what so\n  1 Qal: The plain, simple stem of a Hebrew verb,\n  1 participle: A verb used as a describing word or a no\n  1 masculine: The grammatical gender of words for men \n  1 singular: One person or thing.\n  1 construct: This noun is bound to the one after it, \n  2 1st person: The speaker: I or we.\n  2 common: The form is the same for masculine and f\n  2 singular: One person or thing.\nConjunctive waw + noun · feminine singular\n  0 conjunctive waw: The prefix and (also but, so, then), joi\n  1 noun: A word that names a person, a place, a t\n  1 feminine: The grammatical gender of words for wome\n  1 singular: One person or thing.\nVerb · present · participle · active · nominative · masculine singular\n  1 verb: A word for an action or a state: what so\n  1 present: Shows an action as going on or repeated,\n  1 participle: A verb used as a describing word or a no\n  1 active: The subject does the action.\n  1 nominative: The case of the subject of a sentence: t\n  1 masculine: The grammatical gender of words for men \n  1 singular: One person or thing.\n"
}

test "references in a note" {
    load();
    s: []i8 = bytes("Water and Spirit: compare Ezekiel 36:25\�\�\�27. See jn 3:16, Rom 8 and 1 Cor 13. This is 3 times; job 5.");
    note_refs(s, len(s));
    for i in 0..nr_n {
        show(s, nr_b[i], nr_e[i]);
        write(1, " = ");
        write_bytes_n(1, slice_bsb(book_line[nr_book[i]] + 1, book_line[nr_book[i]] + 4),
            3);
        write(1, " ");
        write_int(1, nr_c[i]);
        write(1, ":");
        write_int(1, nr_v[i]);
        print("")
    }
    expect {|
        Ezekiel 36:25–27 = EZK 36:25
        jn 3:16 = JHN 3:16
        Rom 8 = ROM 8:-1
        1 Cor 13 = 1CO 13:-1
    |}
}

// The text of the lexicon's references to book code (in G25's entry and
// others), as shown.
refs_of(greek: bool, num: int) raises IoError {
    p: int = lex_first(greek, num);
    for x in 0..lex_count(p) {
        lex_field(lex_line(p, x), 4);
        lex_markup(lf_b, lf_e);
        a: int = 0;
        for r in 0..lx_runs {
            if ((lx_style[r] & LX_REF) != 0) {
                show(lx, a, lx_end[r]);
                print("|")
            }
            a = lx_end[r]
        }
    }
}

