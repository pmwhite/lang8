// ---- cross references and the commentary (DESIGN.md §9.6, §9.7) ----
// A reference as the app gives it (text.l8's, as a heading's are).
show_xref() raises IoError {
    title_of(chapter_of(xr_book, xr_c));
    print_out_text();
    if (xr_v > 0) {
        write(1, ":");
        write_int(1, xr_v)
    }
    if (xr_ce > 0 && (xr_ce != xr_c || xr_ve != xr_v)) {
        write(1, "-");
        if (xr_ce != xr_c) {
            write_int(1, xr_ce);
            write(1, ":")
        }
        write_int(1, xr_ve)
    }
}

print_out_text() raises IoError {
    for i in 0..out_n pb[i] = out[i];
    write_bytes_n(1, pb, out_n)
}

test "cross references, most votes first" {
    load();
    for cv in [[42, 3, 16], [0, 1, 1]] {
        vi: int = lang_verse(book_first[cv[0]] + cv[1] - 1, cv[2]);
        write_int(1, xref_count(vi));
        write(1, ":");
        for i in 0..5 {
            xref_at(vi, i);
            write(1, " ");
            show_xref()
        }
        print("")
    }
    expect {|
        23: Romans 5:8 1 John 4:9-10 Romans 8:32 John 3:15 John 11:25-26
        61: John 1:1-3 Hebrews 11:3 Isaiah 45:18 Revelation 4:11 Hebrews 1:10
    |}
}

test "the commentary's section on a verse" {
    load();
    // (Psalm 23: one comment, the whole chapter, CCEL's plain paragraphs.)
    for cv in [[42, 3, 16], [0, 1, 1], [0, 1, 4], [18, 23, 1]] {
        c: int = book_first[cv[0]] + cv[1] - 1;
        if (mhcc_section(c, cv[2])) {
            write_int(1, mh_c1);
            write(1, ":");
            write_int(1, mh_v1);
            write(1, "-");
            write_int(1, mh_c2);
            write(1, ":");
            write_int(1, mh_v2);
            print("")
        } else print("none")
    }
    expect {|
        3:1-3:21
        1:1-1:2
        1:3-1:5
        23:1-23:6
    |}
}

test "the commentary's markup" {
    load();
    _f: bool = mhcc_section(book_first[42] + 2, 16);
    // (The section's first paragraph: its runs that are references.)
    e: int = mh_p;
    while (e < lmh_n && lmh[e] as int != 10) e = e + 1;
    mh_markup(mh_p + 1, e);
    n: int = 0;
    p: int = 0;
    for r in 0..mo_runs {
        if (mo_kind[r] == MH_REF && n < 2) {
            for i in p..mo_end[r] pb[i - p] = mo[i];
            write_bytes_n(1, pb, mo_end[r] - p);
            write(1, " = ");
            xref_unpack(mo_ref[r]);
            show_xref();
            print("");
            n = n + 1
        }
        p = mo_end[r]
    }
    expect {|
        1:13 = John 1:13
        11–13 = John 3:11-13
    |}
}

// Bytes lf_b to lf_e of the lexicon, written.
show_field() raises IoError {
    show(llex, lf_b, lf_e)
}

test "exact senses" {
    load();
    // Genesis 1:1's "God": H430's entry whose gloss is God.
    vi: int = lang_verse(0, 1);
    for w in v_first(vi)..v_end(vi) {
        if (!w_greek(w) && w_strongs(w) == 430) {
            k: int = w_sense(w);
            p: int = sense_entry(false, 430, k);
            write_int(1, k);
            write(1, " ");
            lex_code(p);
            show_field();
            write(1, " ");
            lex_field(p, 3);
            show_field();
            print("")
        }
    }
    // Exodus 20:3's "other gods": H430J, made for TAHOT's tag (review r5-1),
    // its Meaning "gods"; and a word of no known sense among differing
    // entries shows no particular one's Meaning (-1).
    vi = lang_verse(book_first[1] + 19, 3);
    for w in v_first(vi)..v_end(vi) {
        if (!w_greek(w) && w_strongs(w) == 430) {
            k: int = w_sense(w);
            p: int = meaning_entry(false, 430, k);
            write_int(1, k);
            write(1, " ");
            lex_code(p);
            show_field();
            write(1, " ");
            lex_field(p, 3);
            show_field();
            print("")
        }
    }
    write_int(1, meaning_entry(false, 430, 0));
    write(1, " ");
    write_int(1, if (meaning_entry(false, 6034, 0) == lex_first(false, 6034)) 1 else 0);
    print("");
    // The definition's preview, paragraphs joined by a dash.
    definition_preview_of(lex_first(false, 430));
    write_bytes_n(1, pv, pv_n);
    print("");
    // Each sense's count, summed, is the number's (H430, G25, H7462).
    for kv in [430, 7462, 25] {
        greek: bool = kv == 25;
        _ok: bool = conc_load(greek, kv);
        all: int = cc_words;
        used: int = senses_in_use();
        sum: int = 0;
        for k in 0..len(sn_count) sum = sum + sn_count[k];
        write_int(1, all);
        write(1, if (sum == all) " = sum, " else " != sum, ");
        write_int(1, used);
        write(1, " in use; sense 1 alone: ");
        conc_sense(1);
        write_int(1, cc_words);
        print("")
    }
    expect {|
        1 H430G God
        4 H430J gods
        -1 1
        This name means "gods" (plural intensive-singular meaning), "God" — Another name of יהוה yhw “LORD” · H3068
        2600 = sum, 4 in use; sense 1 alone: 2383
        175 = sum, 4 in use; sense 1 alone: 167
        143 = sum, 1 in use; sense 1 alone: 143
    |}
}

test "related words" {
    load();
    for kv in [25, 157, 2617] {
        greek: bool = kv == 25;
        related_load(greek, kv);
        write(1, if (greek) "G" else "H");
        write_int(1, kv);
        write(1, ":");
        for i in 0..rl_n {
            write(1, if (rl_greek[i]) " G" else " H");
            write_int(1, rl_num[i])
        }
        print("")
    }
    expect {|
        G25: H2245 G27 G5368 H160 H2836 G866 H159 H1730
        H157: H2245 G25 G5368 H2836 H160 G27 H3033 H1730 H159 H7474
        H2617: H7356 H2587 H2623 G26 H2603 H160 H2616 H7522 G5544 H7355
    |}
}

// ---- the Hebrew and Greek (DESIGN.md §14.11.1) ----
orig_loaded: bool = false;

orig_load() noregion {
    load();
    if (orig_loaded) return;
    orig_loaded = true;
    og = read_whole("programs/bible/data/lang/orig-words.bin");
    og_n = file_n / 12;
    lket = read_whole("programs/bible/data/lang/orig-ketiv.txt");
    lket_n = file_n;
    ket_index();
    t: []i8 = read_whole("programs/bible/data/orig.txt");
    text_load(TEXT_ORIG, t, file_n);
    text_use(TEXT_BSB)
}

// Bytes of the original's text, a to b.
show_orig(a: int, b: int) raises IoError {
    for i in a..b pb[i - a] = bsb[i];
    write_bytes_n(1, pb, b - a)
}

test "the original's words" {
    orig_load();
    text_use(TEXT_ORIG);
    // (Every record of words is its words, their lengths ending at spaces
    // and at its end.)
    bad: int = 0;
    w: int = 0;
    verses: int = 0;
    for c in 0..chapters {
        if (og_ch_first[c] != w) bad = bad + 1;
        p: int = ch_start[c];
        while (p < ch_end[c]) {
            e: int = line_end(p);
            if (bsb[p] as int == 86) verses = verses + 1;
            if (og_words_line(bsb[p] as int)) {
                q: int = p + 1;
                while (q < e) {
                    if (bsb[q] as int == 32) q = q + 1 else {
                        q = q + og_len(w);
                        if (q < e && bsb[q] as int != 32 && (og_flags(w) & OG_MAQAF) == 0) bad = bad + 1;
                        w = w + 1
                    }
                }
                if (q != e) bad = bad + 1
            }
            p = e + 1
        }
    }
    write_int(1, verses);
    write(1, " verses, ");
    write_int(1, w);
    write(1, " words of ");
    write_int(1, og_n);
    write(1, ", ");
    write_int(1, bad);
    print(" out of place");
    text_use(TEXT_BSB);
    expect {|
        31086 verses, 443372 words of 443372, 0 out of place
    |}
}

// Word w of the original: its letters, number, parsing, flags.
show_og(w: int) raises IoError {
    fbuf_n = 0;
    fput_og_form(w);
    write_bytes_n(1, fbuf, fbuf_n);
    write(1, if (og_greek(w)) " G" else " H");
    write_int(1, og_strongs(w));
    write(1, " ");
    morph_of(og_morph(w));
    show(lmorph, mc_b, mc_e);
    if ((og_flags(w) & OG_ARAMAIC) != 0) write(1, " Aramaic");
    if ((og_flags(w) & OG_QERE) != 0) write(1, " Qere");
    if ((og_flags(w) & OG_NAME) != 0) write(1, " name");
    print("")
}

test "John 3:16, Genesis 1:1 and Psalm 23 in the original" {
    orig_load();
    text_use(TEXT_ORIG);
    og_verse(john3(), 16);
    write_int(1, og_ve - og_vb);
    write(1, " words; 3rd: ");
    show_og(og_vb + 2);
    og_verse(0, 1);
    write(1, "Genesis 1:1, 1st: ");
    show_og(og_vb);
    og_verse(psalm23(), 0);
    write(1, "Psalm 23's title: ");
    write_int(1, og_ve - og_vb);
    write(1, " words, Hebrew ");
    write_int(1, og_hn_c);
    write(1, ":");
    write_int(1, og_hn_v);
    write(1, ", in a D record: ");
    p: int = ch_start[psalm23()];
    while (p < ch_end[psalm23()] && bsb[p] as int != 68) p = line_end(p) + 1;
    show_orig(p, line_end(p));
    print("");
    og_verse(psalm23(), 1);
    write(1, "Psalm 23:1, 1st: ");
    show_og(og_vb);
    text_use(TEXT_BSB);
    expect {|
        25 words; 3rd: ἠγάπησεν G25 V-AIA-3S
        Genesis 1:1, 1st: בְּרֵאשִׁית H7225 Prep-b | N-fs
        Psalm 23's title: 2 words, Hebrew 23:1, in a D record: Dמִזְמוֹר לְדָוִד
        Psalm 23:1, 1st: יְהוָה H3068 N-proper-ms name
    |}
}

test "the Hebrew's own numbers, Aramaic and the Qere" {
    orig_load();
    text_use(TEXT_ORIG);
    mal: int = book_first[38] + 3;
    og_verse(mal, 1);
    write(1, "Malachi 4:1: Hebrew ");
    write_int(1, og_hn_c);
    write(1, ":");
    write_int(1, og_hn_v);
    print("");
    og_verse(book_first[26] + 1, 4);
    write(1, "Daniel 2:4: ");
    aram: int = 0;
    for w in og_vb..og_ve
        if ((og_flags(w) & OG_ARAMAIC) != 0) aram = aram + 1;
    write_int(1, aram);
    write(1, " of ");
    write_int(1, og_ve - og_vb);
    write(1, " Aramaic; 5th: ");
    show_og(og_vb + 4);
    // (The first Qere, and its Ketiv.)
    q: int = 0;
    while (q < og_n && (og_flags(q) & OG_QERE) == 0) q = q + 1;
    og_where(q);
    write(1, "Qere ");
    write_int(1, ch_num[og_wc]);
    write(1, ":");
    write_int(1, og_wv);
    write(1, " ");
    show_og(q);
    if (og_ketiv(q)) {
        write(1, "Ketiv ");
        show(lket, kt_b, kt_e);
        print("")
    }
    text_use(TEXT_BSB);
    expect {|
        Malachi 4:1: Hebrew 3:19
        Daniel 2:4: 8 of 12 Aramaic; 5th: מַלְכָּא H4430 N-msd Aramaic
        Qere 8:17 הַיְצֵא H3318 V-Hifil-Imp-ms Qere
        Ketiv הוֹצֵא
    |}
}
