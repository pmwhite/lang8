test "an outline's lines, and the preview of its top senses" {
    load();
    p: int = lex_first(false, 7462);
    lex_field(p, 4);
    lex_markup(lf_b, lf_e);
    a: int = 0;
    for r in 0..lx_runs {
        if (r < 8) {
            write_int(1, lx_level[r]);
            write(1, " ");
            write_int(1, lx_style[r]);
            write(1, " ");
            show(lx, a, lx_end[r]);
            print("|")
        }
        a = lx_end[r]
    }
    definition_preview_of(p);
    write_bytes_n(1, pv, pv_n);
    print("");
    definition_preview_of(lex_first(true, 25));
    write_bytes_n(1, pv, 40);
    print("");
    expect "1 32 1)|\n1 0  to pasture, tend, graze, feed\n|\n2 32 1a)|\n2 0  |\n2 66 (Qal)|\n2 0 \n|\n3 32 1a1)|\n3 0  to tend, pasture\n|\nto pasture, tend, graze, feed · to associate with, be a friend of (meaning probable) · to be a special friend\nἀγαπάω, -ῶ, [in LXX chiefly fo\n"
}
