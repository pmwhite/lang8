tag bible_tests;

use_tag std, bible;

need "libc.so.6";

// The original-language data (data/lang/) as the study screens read them:
// words found from the reader's text, tiles of the interlinear, where a
// number occurs and how it is translated, the lexicon's markup, parsings in
// plain English, and references in a note.
import "../../stdlib/print.l8";

import "text.l8";

import "lang.l8";

import "orig.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

// A file, whole, into a new array (and its length in file_n).
file_n: int = 0;

scratch: []i8 = new i8[8388608](0i8);

read_whole(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    got: int = 0;
    more: bool = fd >= 0;
    while (more && got < len(scratch)) {
        r: int = read(fd, scratch, got, len(scratch) - got);
        if (r <= 0) more = false else got = got + r
    }
    if (fd >= 0) close(fd);
    b: []i8 = new i8[got + 1](0i8);
    for i in 0..got b[i] = scratch[i];
    file_n = got;
    b
}

loaded: bool = false;

load() noregion {
    if (loaded) return;
    loaded = true;
    bsb = read_whole("programs/bible/data/bsb.txt");
    bible_index(file_n);
    lw = read_whole("programs/bible/data/lang/words.bin");
    lw_n = file_n / 12;
    lv = read_whole("programs/bible/data/lang/verses.bin");
    lv_n = file_n / 8 - 1;
    lsup = read_whole("programs/bible/data/lang/supplied.bin");
    lsup_n = file_n / 8;
    lforms = read_whole("programs/bible/data/lang/forms.txt");
    lforms_len = file_n;
    lmorph = read_whole("programs/bible/data/lang/morph.txt");
    lmorph_len = file_n;
    lconc = read_whole("programs/bible/data/lang/conc.bin");
    lconc_len = file_n;
    llex = read_whole("programs/bible/data/lang/lexicon.txt");
    llex_len = file_n;
    lgram = read_whole("programs/bible/data/lang/grammar.txt");
    lgram_len = file_n;
    lsen = read_whole("programs/bible/data/lang/senses.bin");
    lsen_n = file_n;
    lrel = read_whole("programs/bible/data/lang/related.bin");
    lrel_n = file_n;
    lxi = read_whole("programs/bible/data/xref_index.bin");
    lxi_n = file_n / 4;
    lxr = read_whole("programs/bible/data/xrefs.bin");
    lxr_n = file_n;
    lmh = read_whole("programs/bible/data/mhcc.txt");
    lmh_n = file_n;
    lang_index()
}

pb: []i8 = new i8[65536](0i8);

// Bytes a to b of buffer x.
show(x: []i8, a: int, b: int) raises IoError {
    for i in a..b pb[i - a] = x[i];
    write_bytes_n(1, pb, b - a)
}

key(w: int) raises IoError {
    write(1, if (w_greek(w)) "G" else "H");
    write_int(1, w_strongs(w))
}

// Word w: its number, parsing, form and transliteration, and its English.
show_word(w: int) raises IoError {
    key(w);
    write(1, " ");
    morph_of(w_morph(w));
    show(lmorph, mc_b, mc_e);
    form_of(w);
    write(1, " ");
    show(lforms, wf_b, wf_e);
    write(1, " ");
    show(lforms, wt_b, wt_e);
    chunk_of(w);
    write(1, " \"");
    show(st, ch_b, ch_e);
    write(1, "\"");
    fl: int = w_flags(w);
    if ((fl & 1) != 0) write(1, " untranslated");
    if ((fl & 2) != 0) write(1, if ((fl & 8) != 0) " with previous" else " with next");
    print("")
}

// Where word (the bytes of s) is in verse v of chapter c as laid out, picked.
pick(c: int, v: int, s: str) raises IoError {
    layout_chapter(c);
    i: int = verse_index(v);
    b: int = verse_begin[i];
    found: int = -1;
    // (A psalm's title is before its verse 1.)
    if (v == 1) b = 0;
    for p in b..out_n - len(s) {
        if (found < 0) {
            same: bool = true;
            for k in 0..len(s)
                if (out[p + k] != s[k]) same = false;
            if (same) found = p
        }
    }
    write(1, s);
    write(1, ": ");
    if (found < 0 || !study_pick(c, found, found + len(s))) {
        print("not picked");
        return
    }
    write_int(1, pick_t0);
    write(1, "-");
    write_int(1, pick_t1);
    write(1, " ");
    if (pick_word < 0) print("no word") else show_word(pick_word)
}

john3(): int {
    book_first[42] + 2
}

psalm23(): int {
    book_first[18] + 22
}

test "every verse aligned" {
    load();
    n: int = 0;
    for vi in 0..lv_n
        if (v_aligned(vi)) n = n + 1;
    write_int(1, n);
    write(1, " of ");
    write_int(1, lv_n);
    write(1, " verses, ");
    write_int(1, lw_n);
    print(" words");
    expect {|
        31086 of 31086 verses, 443625 words
    |}
}

test "words picked in the reader" {
    load();
    pick(john3(), 16, "loved");
    pick(john3(), 16, "only");
    pick(0, 1, "created");
    pick(0, 1, "beginning");
    pick(psalm23(), 1, "shepherd");
    pick(psalm23(), 1, "David");
    pick(psalm23(), 1, "LORD is");
    expect {|
        loved: 3-3 G25 V-AIA-3S ἠγάπησεν ēgapēsen "loved"
        only: 12-12 G3439 Adj-AMS μονογενῆ monogenē "one and only"
        created: 4-4 H1254 V-Qal-Perf-3ms בָּרָא bā·rā "created"
        beginning: 2-2 H7225 Prep-b | N-fs בְּרֵאשִׁית bə·rê·šîṯ "In the beginning"
        shepherd: 8-8 H7462 V-Qal-Prtcpl-msc | 1cs רֹעִי rō·‘î "is my shepherd"
        David: 3-3 H1732 Prep-l | N-proper-ms לְדָוִד lə·ḏā·wiḏ "of David"
        LORD is: 5-6 H3068 N-proper-ms יְהוָה Yah·weh "The LORD"
    |}
}

test "Genesis 1:1 in the original order" {
    load();
    interlinear_tiles(lang_verse(0, 1), true);
    for i in 0..tile_n show_word(tile_word[i]);
    expect {|
        H7225 Prep-b | N-fs בְּרֵאשִׁית bə·rê·šîṯ "In the beginning"
        H1254 V-Qal-Perf-3ms בָּרָא bā·rā "created"
        H430 N-mp אֱלֹהִים ’ĕ·lō·hîm "God"
        H853 DirObjM אֵת ’êṯ "" untranslated
        H8064 Art | N-mp הַשָּׁמַיִם haš·šā·ma·yim "the heavens"
        H853 Conj-w | DirObjM וְאֵת wə·’êṯ "and"
        H776 Art | N-fs הָאָֽרֶץ hā·’ā·reṣ "the earth"
    |}
}

test "John 3:16 in English order" {
    load();
    vi: int = lang_verse(john3(), 16);
    interlinear_tiles(vi, false);
    for i in 0..12 {
        if (tile_word[i] < 0) {
            write(1, "supplied \"");
            show(st, tok_b[tile_t0[i]], tok_e[tile_t0[i] + tile_tn[i] - 1]);
            print("\"")
        } else show_word(tile_word[i])
    }
    for t in 0..tok_n
        if (tok_sup[t] != 0) {
            show(st, tok_b[t], tok_e[t]);
            print(" is supplied")
        }
    expect {|
        G1063 Conj γὰρ gar "For"
        G3588 Art-NMS ὁ ho "" untranslated
        G2316 N-NMS Θεὸς Theos "God"
        G3779 Adv Οὕτως Houtōs "so"
        G25 V-AIA-3S ἠγάπησεν ēgapēsen "loved"
        G3588 Art-AMS τὸν ton "the"
        G2889 N-AMS κόσμον kosmon "world"
        G5620 Conj ὥστε hōste "that"
        G1325 V-AIA-3S ἔδωκεν edōken "He gave"
        G3588 Art-AMS τὸν ton "His"
        G3588 Art-AMS τὸν ton "" untranslated
        G3439 Adj-AMS μονογενῆ monogenē "one and only"
        His is supplied
    |}
}

