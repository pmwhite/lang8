tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 7 steps (DESIGN.md §12.7): the `listen` group, shots 190
// to 203, with the audio fixture (L8_AUDIO_FIXTURE: tone.mp3, a blip at
// each "verse", and fixture.tim's JHN 3 and 4) and the ESV's: the Listen
// section, Voice and its voice list, a recording followed, Loading…, a
// reader changed mid-listen, Faster, the next chapter, offline (the voice
// standing in), the ESV by chapter, the KJV's voice and its footer,
// Downloads, the acknowledgements, the largest text; and the recording's
// sequence 14. The player plays the fixture in real time; a step that
// waits for it polls its time, and says so if it never moves.
import "../ios/objc.l8";

import "text.l8";

// Waiting for the player: until its time passes demo7_until (centiseconds)
// or the verse demo7_verse is read, then demo7_then; at most demo7_most
// polls of 0.2 s.
demo7_until: int = -1;

demo7_verse: int = -1;

demo7_then: int = 0;

demo7_polls: int = 0;

demo7_most: int = 0;

demo7_wait_time(t: int, then: int) {
    demo7_until = t;
    demo7_verse = -1;
    demo7_then = then;
    demo7_polls = 0;
    demo7_most = 75;
    demo_later_at(0.2f64, 500)
}

demo7_wait_verse(v: int, then: int) {
    demo7_until = -1;
    demo7_verse = v;
    demo7_then = then;
    demo7_polls = 0;
    demo7_most = 75;
    demo_later_at(0.2f64, 500)
}

// Listening from verse v of John 3, stopped first; the speed s.
demo7_listen(v: int, speed: int) {
    listen_stop();
    for i in 0..6 ls_failed_at[i] = 0.0f64;
    set_def_int("listenRate", speed);
    go_place(john3(), v, 100);
    bar_set(0.0f64);
    listen_start(john3(), v)
}

demo7_settings_root() {
    if (settings_nav != 0) msg1(settings_nav, sel("popToRootViewControllerAnimated:"),
        0)
}

demo_do7(t: int) {
    if (t == 320) {
        // 190: the reader at John 3:14 (the BSB); the reading settings.
        demo_dismiss();
        listen_stop();
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB);
        set_def_int("listenRate", 1);
        go_place(john3(), 14, 100);
        bar_set(0.0f64);
        demo_later_do(2)
    }
    if (t == 321) open_voice();
    if (t == 322) open_voice_list();
    if (t == 323) {
        // 193: back, back; Listen; until the fixture is at 18.4 s (verse 17).
        demo7_settings_root();
        listen_button_tapped(0, 0, 0);
        demo7_wait_time(1840, 0)
    }
    if (t == 324) {
        // 194: slow; Listen from John 3:1 (Loading…, the chapter named).
        au_fixture_set_mode("slow");
        demo7_listen(1, 1);
        demo_later_at(1.3f64, 501)
    }
    if (t == 325) {
        // 194b: two seconds on, the recording begun and verse 1 read.
        au_fixture_set_mode("ok");
        demo7_wait_verse(1, 0)
    }
    if (t == 326) {
        // 195: at verse 5, Barry Hays chosen in Voice; the sheet closed.
        demo7_wait_verse(5, 502)
    }
    if (t == 327) {
        // 196: Faster.
        demo7_speed(2);
        demo_later_at(0.6f64, 501)
    }
    if (t == 328) demo_later_at(2.0f64, 501);
    if (t == 329) {
        // 197: from John 3:34 at Normal, five seconds: into John 4.
        set_audio_source(TEXT_BSB, SRC_SOUER);
        demo7_listen(34, 1);
        demo_later_at(6.0f64, 503)
    }
    if (t == 330) {
        // 198: offline; from John 3:16 (the voice stands in).
        au_fixture_set_mode("offline");
        demo7_listen(16, 1);
        demo_later_at(1.5f64, 501)
    }
    if (t == 331) {
        // 199: the ESV (the fixture's), from John 3:16: by chapter, no
        // wash.
        listen_stop();
        au_fixture_set_mode("ok");
        switch_version(TEXT_ESV);
        go_place(john3(), 16, 100);
        demo_later_at(1.5f64, 504)
    }
    if (t == 332) {
        // 200: the KJV, Voice never opened: its footer.
        listen_stop();
        switch_version(1);
        set_def_bool("voiceScreenSeen", false);
        go_place(john3(), 14, 100);
        demo_later_do(2)
    }
    if (t == 333) {
        // 201: the BSB's Downloads, John.
        demo_dismiss();
        switch_version(TEXT_BSB);
        demo_later_at(0.6f64, 505)
    }
    if (t == 334) {
        // 201b: John's chapters in, its checkmark.
        demo_later_at(7.5f64, 501)
    }
    if (t == 335) {
        // 201c: back: Downloaded, John.
        if (settings_nav != 0) msg1(settings_nav, sel("popViewControllerAnimated:"),
            0);
        demo_later_at(0.6f64, 501)
    }
    if (t == 336) {
        // 202: the acknowledgements.
        demo7_settings_root();
        open_acknowledgements()
    }
    if (t == 337) {
        // 202b: down to the ESV's section.
        if (ack_table != 0) {
            path: int = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"),
                0, ACK_ESV);
            msg3(ack_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
                path, 1, 0)
        }
    }
    if (t == 338) {
        // 203: Voice (at the largest text: the script sets it).
        demo7_settings_root();
        open_voice()
    }
    if (t == 339) {
        // Sequence 14's setup: nothing open, John 3:30 at the top.
        demo_dismiss();
        listen_stop();
        set_audio_source(TEXT_BSB, SRC_SOUER);
        go_place(john3(), 28, 0);
        bar_set(0.0f64)
    }
    if (t == 341) demo_sequence5_setup();
    if (t == 342) demo_sequence6_setup();
    if (t == 340) {
        // Sequence 14: Listen from John 3:30 at Faster; into John 4; Barry
        // Hays chosen mid-way; paused.
        demo7_listen(30, 2);
        demo_later_at(8.5f64, 506)
    }
}

demo7_speed(s: int) {
    ls_speed = s;
    set_def_int("listenRate", s);
    if (ls_active && ls_engine == ENGINE_PLAYER) {
        ap_rate();
        now_playing()
    }
    note(if (s == 2) "bible: listen rate 1.25" else if (s == 0) "bible: listen rate 0.85" else "bible: listen rate 1.0")
}

demo_later7(d: int) {
    if (d == 500) {
        // The poll: the time or the verse reached, or given up.
        t: int = ap_time();
        done: bool = demo7_until >= 0 && t >= demo7_until || demo7_verse >= 0 && speak_c == john3() && speak_v >= demo7_verse;
        demo7_polls = demo7_polls + 1;
        if (!done && demo7_polls < demo7_most) {
            demo_later_at(0.2f64, 500);
            return
        }
        if (!done && !ap_demo_moved) note("bible: audio fixture did not advance");
        note_num("bible: demo listen at cs ", t);
        note_num("bible: demo listen verse ", speak_v);
        now_playing();
        if (demo7_then != 0) demo_later_at(0.1f64, demo7_then);
        return
    }
    if (d == 501) {
        now_playing();
        return
    }
    if (d == 502) {
        // Barry Hays, chosen in Voice (as a tap on its row), the sheet put
        // away.
        open_settings();
        demo_later_at(0.8f64, 507);
        return
    }
    if (d == 507) {
        open_voice();
        demo_later_at(0.8f64, 508);
        return
    }
    if (d == 508) {
        voice_picked(0, 1);
        demo_later_at(0.6f64, 509);
        return
    }
    if (d == 509) {
        demo_dismiss();
        demo_later_at(0.8f64, 501);
        return
    }
    if (d == 503) {
        note_num("bible: demo listen chapter ", speak_c);
        now_playing();
        return
    }
    if (d == 504) {
        listen_start(john3(), 16);
        demo_later_at(2.0f64, 501);
        return
    }
    if (d == 505) {
        open_settings();
        demo_later_at(0.8f64, 510);
        return
    }
    if (d == 510) {
        open_voice();
        demo_later_at(0.6f64, 511);
        return
    }
    if (d == 511) {
        open_downloads();
        demo_later_at(0.6f64, 512);
        return
    }
    if (d == 512) {
        open_download_books();
        demo_later_at(0.6f64, 513);
        return
    }
    if (d == 513) {
        // John (the New Testament's fourth), tapped.
        dlb_picked(1, 3);
        if (dlb_table != 0) {
            path: int = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"),
                3, 1);
            msg3(dlb_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
                path, 2, 0)
        }
        demo_later_at(1.0f64, 501);
        return
    }
    if (d == 506) {
        // (Sequence 14, mid-way: Barry Hays, then a pause.)
        set_audio_source(TEXT_BSB, SRC_HAYS);
        listen_reader_changed();
        demo_later_at(2.5f64, 514);
        return
    }
    if (d == 514) {
        listen_pause();
        demo_later_at(1.5f64, 501)
    }
}

add_demo7_methods(_app: int) { }
