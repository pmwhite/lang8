tag bible;

use_tag std;

// Reading plans (DESIGN.md §10.1, as §16.4 revises it), apart from any
// platform: each plan a list of days, a day a list of passages (1 to 6),
// a passage a verse range in one book (BSB-numbered). The computed plans
// (a year, the New Testament in 90 days, Psalms and Proverbs in a month,
// the Gospels in 30 days, Old and New Together, and A Chapter a Day from a
// chosen chapter, §11.1.2b), balanced by the BSB's words; the listed ones
// (M'Cheyne's Calendar, Chronological) read from data/plans/<id>.txt,
// which the platform hands over (plan_file_set) before the plans are made.
// A plan's progress (plan.tsv's lines, read and written in fbuf as
// store.l8's files are), kept by passage; a day's reminder; and a day as
// the reader lays it out, a row a chapter's part (layout_day_row). Days
// are local days, counted from 1 January 1970, given by the platform (its
// today()). test_plans.l8 tests it.
import "text.l8";

import "store.l8";

// ---- the plans ----
// The computed and listed plans; A Chapter a Day (PLAN_DAY1) after them.
PLANS: int = 7;

PLAN_YEAR: int = 0;

PLAN_NT90: int = 1;

PLAN_PSPR: int = 2;

PLAN_GOSPELS: int = 3;

PLAN_BOTH: int = 4;

PLAN_MCHEYNE: int = 5;

PLAN_CHRONO: int = 6;

PLAN_DAY1: int = 7;

plan_ids: []str = ["year", "nt90", "pspr", "gospels", "both", "mcheyne", "chrono"];

plan_names: []str = ["Bible in a Year", "New Testament in 90 Days", "Psalms and Proverbs in a Month",
    "The Gospels in 30 Days", "Old and New Together", "M'Cheyne's Calendar", "Chronological"];

plan_blurbs: []str = ["The whole Bible in order, about fifteen minutes a day.", "The New Testament in three months.",
    "Five psalms and a chapter of Proverbs a day.", "Matthew, Mark, Luke and John in a month.",
    "Each day a reading from the Old Testament and one from the New, with the Psalms through the year.",
    "", ""];

// How Reading Plans lists them (DESIGN.md §16.8, shot 430).
plan_order: []int = [0, 6, 5, 4, 1, 2, 3];

// Each plan's days (a listed one's from its file; 0: not here).
plan_lengths: []int = [365, 90, 31, 30, 365, 0, 0, 0];

plan_listed(p: int): bool {
    p == PLAN_MCHEYNE || p == PLAN_CHRONO
}

// A listed plan's file, as the platform read it (kept: its name and
// description are copied out of it, into pl_words).
pl_file: [][]i8 = new []i8[7](new i8[0](0i8));

pl_file_n: []int = new int[7](0);

plan_file_set(p: int, b: []i8@immortal, n: int) {
    pl_file[p] = b;
    pl_file_n[p] = n
}

// A listed plan's @name and @blurb (bytes in pl_words), and how many of
// its lines could not be read.
pl_words: []i8 = new i8[2048](0i8);

pl_words_n: int = 0;

pl_name_b: []int = new int[7](0);

pl_name_e: []int = new int[7](0);

pl_blurb_b: []int = new int[7](0);

pl_blurb_e: []int = new int[7](0);

pl_bad_lines: []int = new int[7](0);

// A Chapter a Day (DESIGN.md §11.1.2b): its days one chapter each from
// day1_from (through the Bible) to its book's last; -1 none chosen. Its id
// is day1-BOOK-C.
day1_from: int = -1;

// Each plan's days, one after another (pl_day0[p] its first), each its
// passages (pl_r0 its first, pl_rn how many); each passage its first
// chapter and verse and its last (chapters through the Bible, verses as
// the BSB keys them).
pl_ready: bool = false;

pl_day0: []int = new int[9](0);

PL_DAYS: int = 2000;

pl_r0: []int = new int[2000](0);

pl_rn: []int = new int[2000](0);

PL_PASSAGES: int = 9000;

pl_c1: []int = new int[9000](0);

pl_v1: []int = new int[9000](0);

pl_c2: []int = new int[9000](0);

pl_v2: []int = new int[9000](0);

pl_readings: int = 0;

// The passages of the plans but A Chapter a Day (whose come after).
pl_base_readings: int = 0;

// About how many chapters each plan reads (parts of chapters counted as
// parts, in thousandths).
pl_chapters: []int = new int[8](0);

// Each chapter's words (the BSB's T and W text, in characters), and its
// verses (the BSB's last).
pl_chars: []int = new int[1200](0);

pl_last: []int = new int[1200](0);

// The units of the plan being made (chapters, or verses: chapter, verse
// and weight), whether a day may end before each, and where each day ends
// among them.
PL_UNITS: int = 9000;

pu_c: []int = new int[9000](0);

pu_v: []int = new int[9000](0);

pu_w: []int = new int[9000](0);

pu_ok: []bool = new bool[9000](false);

pu_n: int = 0;

pl_cum: []int = new int[9001](0);

pl_ends: []int = new int[366](0);

// Each chapter's characters of words (T and W lines; a UTF-8 character
// counted once) and verses, the BSB's.
plan_weights() {
    was: int = text_cur;
    text_use(TEXT_BSB);
    for c in 0..chapters {
        n: int = 0;
        p: int = ch_start[c];
        while (p < ch_end[c]) {
            e: int = line_end(p);
            k: int = bsb[p] as int;
            if (k == 84 || k == 87) n = n + bsb_chars(p + 1, e);
            p = e + 1
        }
        pl_chars[c] = n;
        pl_last[c] = ch_verses[c]
    }
    text_use(was)
}

bsb_chars(p: int, e: int): int {
    n: int = 0;
    for i in p..e {
        x: int = bsb[i] as int & 255;
        if (x < 128 || x >= 192) n = n + 1
    }
    n
}

// Chapters a (inclusive) to b (not) as the units, each weighed by its words.
plan_seq(a: int, b: int) {
    pu_n = 0;
    for c in a..b {
        pu_c[pu_n] = c;
        pu_v[pu_n] = 0;
        pu_w[pu_n] = pl_chars[c];
        pu_ok[pu_n] = true;
        pu_n = pu_n + 1
    }
}

// The verses of chapters a to b (not) as the units, each weighed by its
// words (or, poetry, as one each); a day may end before a chapter's first
// verse, or a verse a heading comes before (poetry: or a stanza's break,
// or an acrostic's letter).
plan_verse_seq(a: int, b: int, by_count: bool) {
    was: int = text_cur;
    text_use(TEXT_BSB);
    pu_n = 0;
    for c in a..b {
        p: int = ch_start[c];
        mark: bool = true;
        while (p < ch_end[c]) {
            e: int = line_end(p);
            k: int = bsb[p] as int;
            if (k == 86 && pu_n < PL_UNITS) {
                pu_c[pu_n] = c;
                pu_v[pu_n] = key_at(p + 1);
                pu_w[pu_n] = (if (by_count) 1 else 0);
                pu_ok[pu_n] = mark;
                pu_n = pu_n + 1;
                mark = false
            } else if ((k == 84 || k == 87) && pu_n > 0 && !by_count) pu_w[pu_n - 1] = pu_w[pu_n - 1] + bsb_chars(p + 1,
                e) else if (k == 83 || by_count && (k == 95 || k == 65)) mark = true;
            p = e + 1
        }
    }
    text_use(was)
}

// The units into days days, balanced: day d ends at the allowed boundary
// nearest total·d/days, each with a unit at least; with one_book, a day
// that would run into another book ends where its book does (pl_ends).
plan_balance(days: int, one_book: bool) {
    n: int = pu_n;
    pl_cum[0] = 0;
    for i in 0..n pl_cum[i + 1] = pl_cum[i] + pu_w[i];
    total: int = pl_cum[n];
    prev: int = 0;
    for d in 1..days + 1 {
        if (d == days) pl_ends[d - 1] = n else {
            target: int = total * d / days;
            most: int = n - (days - d);
            // (The first boundary allowed after the day's first unit, then on
            // while the next is nearer; the last that leaves each day after a
            // unit is always allowed.)
            b: int = prev + 1;
            while (b < most && !pu_ok[b]) b = b + 1;
            more: bool = b < most;
            while (more) {
                c: int = b + 1;
                while (c < most && !pu_ok[c]) c = c + 1;
                if (c <= most && dist(pl_cum[c], target) <= dist(pl_cum[b], target)) b = c else more = false;
                if (b >= most) more = false
            }
            if (one_book) {
                i: int = prev + 1;
                while (i < b && ch_book[pu_c[i]] == ch_book[pu_c[prev]]) i = i + 1;
                b = i
            }
            pl_ends[d - 1] = b;
            prev = b
        }
    }
}

dist(a: int, b: int): int {
    if (a > b) a - b else b - a
}

// A passage, chapter a verse va to chapter b verse vb, onto the plans'.
plan_passage(
    a: int,
    va: int,
    b: int,
    vb: int
) {
    if (pl_readings >= PL_PASSAGES) return;
    pl_c1[pl_readings] = a;
    pl_v1[pl_readings] = va;
    pl_c2[pl_readings] = b;
    pl_v2[pl_readings] = vb;
    pl_readings = pl_readings + 1
}

// Chapters a to b (inclusive), whole.
plan_reading(a: int, b: int) {
    plan_passage(a, 1, b, pl_last[b])
}

// Units i to j (not j) as passages, a book at a time (chapters, or verses
// run together).
plan_readings_of(i: int, j: int) {
    k: int = i;
    while (k < j) {
        e: int = k;
        while (e + 1 < j && ch_book[pu_c[e + 1]] == ch_book[pu_c[k]] && unit_follows(e)) e = e + 1;
        if (pu_v[k] == 0) plan_reading(pu_c[k], pu_c[e]) else plan_passage(pu_c[k],
            pu_v[k], pu_c[e], pu_v[e]);
        k = e + 1
    }
}

// Whether unit e + 1 comes straight after unit e.
unit_follows(e: int): bool {
    if (pu_v[e] == 0) return pu_c[e + 1] == pu_c[e] + 1;
    pu_c[e + 1] == pu_c[e] || pu_c[e + 1] == pu_c[e] + 1 && pu_v[e + 1] <= 1
}

book_coded(code: str): int {
    for b in 0..books
        if (book_is(b, code)) return b;
    -1
}

// The units' days as plan p's (from day day), after its own (once
// balanced); with add, onto days already begun (Old and New Together's
// three parts).
plan_days_of(day: int, days: int, add: bool) {
    from: int = 0;
    for d in 0..days {
        if (!add) {
            pl_r0[day + d] = pl_readings;
            pl_rn[day + d] = 0
        }
        at: int = pl_readings;
        plan_readings_of(from, pl_ends[d]);
        // (A day's passages one after another: a part added later is put
        // after the day's, the days after moved on.)
        if (add) plan_append(day + d, at);
        pl_rn[day + d] = pl_rn[day + d] + pl_readings - at;
        from = pl_ends[d]
    }
}

// The passages from at (just added, at the end) moved to follow day di's.
plan_append(di: int, at: int) {
    to: int = pl_r0[di] + pl_rn[di];
    n: int = pl_readings - at;
    if (to == at || n <= 0) return;
    for x in 0..n {
        k: int = at + x;
        c1: int = pl_c1[k];
        v1: int = pl_v1[k];
        c2: int = pl_c2[k];
        v2: int = pl_v2[k];
        i: int = k;
        while (i > to + x) {
            pl_c1[i] = pl_c1[i - 1];
            pl_v1[i] = pl_v1[i - 1];
            pl_c2[i] = pl_c2[i - 1];
            pl_v2[i] = pl_v2[i - 1];
            i = i - 1
        }
        pl_c1[to + x] = c1;
        pl_v1[to + x] = v1;
        pl_c2[to + x] = c2;
        pl_v2[to + x] = v2
    }
    // (The later days' first passages moved on by as many.)
    for d in di + 1..PL_DAYS
        if (pl_r0[d] >= to && pl_rn[d] > 0) pl_r0[d] = pl_r0[d] + n
}

// The plans, made (once): the computed ones, then the listed ones from
// their files, then A Chapter a Day if one is chosen.
plans_make() {
    if (pl_ready) return;
    plan_weights();
    pl_readings = 0;
    day: int = 0;
    mat: int = book_first[book_coded("MAT")];
    jhn: int = book_coded("JHN");
    psa: int = book_coded("PSA");
    pro: int = book_coded("PRO");
    for p in 0..PLANS {
        pl_day0[p] = day;
        days: int = plan_lengths[p];
        if (p == PLAN_BOTH) plan_both(day) else if (plan_listed(p)) days = plan_listed_make(p,
            day) else {
            if (p == PLAN_YEAR) plan_seq(0, chapters) else if (p == PLAN_NT90) plan_seq(mat,
                chapters) else if (p == PLAN_GOSPELS) plan_seq(mat, book_first[jhn] + book_count[jhn]) else plan_seq(book_first[psa],
                book_first[psa] + book_count[psa]);
            plan_balance(days, false);
            plan_days_of(day, days, false);
            // (Proverbs d on day d.)
            if (p == PLAN_PSPR) {
                for d in 0..days {
                    if (d < book_count[pro]) {
                        at: int = pl_readings;
                        plan_reading(book_first[pro] + d, book_first[pro] + d);
                        plan_append(day + d, at);
                        pl_rn[day + d] = pl_rn[day + d] + 1
                    }
                }
            }
        }
        plan_lengths[p] = days;
        pl_chapters[p] = plan_count_chapters(day, days);
        day = day + days
    }
    pl_day0[PLANS] = day;
    pl_day0[PLANS + 1] = day;
    pl_base_readings = pl_readings;
    pl_ready = true;
    if (day1_from >= 0) plan_day1_make()
}

// Old and New Together (DESIGN.md §16.4.3): the Old Testament but the
// Psalms in 365 days by its words (a day in one book), the New Testament in
// 365 by its words, and the Psalms in 365 by their verses: three passages
// a day, one of each.
plan_both(day: int) {
    psa: int = book_coded("PSA");
    mat: int = book_first[book_coded("MAT")];
    // (The Old Testament's chapters, the Psalms left out.)
    pu_n = 0;
    for c in 0..mat {
        if (ch_book[c] != psa) {
            pu_c[pu_n] = c;
            pu_v[pu_n] = 0;
            pu_w[pu_n] = pl_chars[c];
            pu_ok[pu_n] = true;
            pu_n = pu_n + 1
        }
    }
    plan_balance(365, true);
    plan_days_of(day, 365, false);
    plan_verse_seq(mat, chapters, false);
    plan_balance(365, true);
    plan_days_of(day, 365, true);
    plan_verse_seq(book_first[psa], book_first[psa] + book_count[psa], true);
    plan_balance(365, false);
    plan_days_of(day, 365, true)
}

// About how many chapters days day to day + days read, in thousandths.
plan_count_chapters(day: int, days: int): int {
    n: int = 0;
    for di in day..day + days
        for k in pl_r0[di]..pl_r0[di] + pl_rn[di] n = n + passage_chapters(k);
    n
}

passage_chapters(k: int): int {
    n: int = 0;
    for c in pl_c1[k]..pl_c2[k] + 1 {
        a: int = if (c == pl_c1[k]) pl_v1[k] else 1;
        b: int = if (c == pl_c2[k]) pl_v2[k] else pl_last[c];
        if (pl_last[c] > 0) n = n + (b - a + 1) * 1000 / pl_last[c]
    }
    n
}

// ---- the listed plans' files (DESIGN.md §16.4.2) ----
// Plan p's days from its file, from day day: how many it has (0 if none
// could be read). Each line a day's number and its passages, tab apart;
// # a comment; @id, @name, @blurb.
plan_listed_make(p: int, day: int): int {
    b: []i8 = pl_file[p];
    n: int = pl_file_n[p];
    pl_bad_lines[p] = 0;
    pl_name_b[p] = 0;
    pl_name_e[p] = 0;
    pl_blurb_b[p] = 0;
    pl_blurb_e[p] = 0;
    days: int = 0;
    i: int = 0;
    while (i < n) {
        e: int = i;
        while (e < n && b[e] as int != 10) e = e + 1;
        if (e > i && b[e - 1] as int == 13) e = e - 1;
        k: int = if (e > i) b[i] as int else 0;
        if (k == 64) {
            if (pf_word(b, i, e, "@name\t")) {
                pl_name_b[p] = pl_words_n;
                pf_copy(b, i + 6, e);
                pl_name_e[p] = pl_words_n
            } else if (pf_word(b, i, e, "@blurb\t")) {
                pl_blurb_b[p] = pl_words_n;
                pf_copy(b, i + 7, e);
                pl_blurb_e[p] = pl_words_n
            }
        } else if (k >= 48 && k <= 57) {
            if (plan_line(b, i, e, day + days, days + 1)) days = days + 1 else pl_bad_lines[p] = pl_bad_lines[p] + 1
        } else if (k != 35 && e > i) pl_bad_lines[p] = pl_bad_lines[p] + 1;
        i = (if (e < n && b[e] as int == 13) e + 1 else e) + 1
    }
    days
}

pf_word(
    b: []i8,
    i: int,
    e: int,
    word: str
): bool {
    if (e - i < len(word)) return false;
    for x in 0..len(word)
        if (b[i + x] != word[x]) return false;
    true
}

pf_copy(b: []i8, i: int, e: int) {
    for x in i..e {
        if (pl_words_n < len(pl_words)) {
            pl_words[pl_words_n] = b[x];
            pl_words_n = pl_words_n + 1
        }
    }
}

// A day's line, i to e of b: its number (it must be want), then 1 to 6
// passages; as day index di. False (and nothing kept) if any is wrong.
plan_line(
    b: []i8@immortal,
    i: int,
    e: int,
    di: int,
    want: int
): bool {
    if (di >= PL_DAYS) return false;
    q: int = i;
    num: int = 0;
    while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
        num = num * 10 + b[q] as int - 48;
        q = q + 1
    }
    if (num != want || q >= e || b[q] as int != 9) return false;
    at: int = pl_readings;
    while (q < e) {
        q = q + 1;
        f: int = q;
        while (q < e && b[q] as int != 9) q = q + 1;
        if (!plan_passage_text(b, f, q)) {
            pl_readings = at;
            return false
        }
    }
    count: int = pl_readings - at;
    if (count < 1 || count > 6) {
        pl_readings = at;
        return false
    }
    pl_r0[di] = at;
    pl_rn[di] = count;
    true
}

// A passage written i to e of b: BOOK C, BOOK C-C2, BOOK C:V, BOOK C:V-V2,
// BOOK C:V-C2:V2; onto the plans' (false if it is not one of the BSB's).
plan_passage_text(b: []i8@immortal, i: int, e: int): bool {
    if (e - i < 5 || b[i + 3] as int != 32) return false;
    bk: int = -1;
    for x in 0..books {
        same: bool = true;
        for y in 0..3
            if (bsb[book_line[x] + 1 + y] != b[i + y]) same = false;
        if (same) bk = x
    }
    if (bk < 0) return false;
    pp_b = b;
    pp_i = i + 4;
    pp_e = e;
    c1: int = pp_num();
    v1: int = 0;
    c2: int = c1;
    v2: int = 0;
    if (pp_is(58)) {
        v1 = pp_num();
        v2 = v1;
        if (pp_is(45)) {
            n: int = pp_num();
            if (pp_is(58)) {
                c2 = n;
                v2 = pp_num()
            } else v2 = n
        }
    } else if (pp_is(45)) c2 = pp_num();
    if (pp_i != pp_e || c1 < 1 || c2 < c1 || c2 > book_count[bk]) return false;
    a: int = book_first[bk] + c1 - 1;
    z: int = book_first[bk] + c2 - 1;
    if (v1 == 0) {
        v1 = 1;
        v2 = pl_last[z]
    }
    if (v1 < 1 || v1 > pl_last[a] || v2 < 1 || v2 > pl_last[z] || a == z && v2 < v1) return false;
    plan_passage(a, v1, z, v2);
    true
}

pp_b: []i8 = new i8[0](0i8);

pp_i: int = 0;

pp_e: int = 0;

pp_num(): int {
    n: int = 0;
    any: bool = false;
    while (pp_i < pp_e && pp_b[pp_i] as int >= 48 && pp_b[pp_i] as int <= 57 && n < 10000) {
        n = n * 10 + pp_b[pp_i] as int - 48;
        pp_i = pp_i + 1;
        any = true
    }
    if (any) n else -1
}

pp_is(k: int): bool {
    if (pp_i < pp_e && pp_b[pp_i] as int == k) {
        pp_i = pp_i + 1;
        return true
    }
    false
}

// ---- A Chapter a Day ----
// How many days A Chapter a Day from chapter c would have (0 if fewer
// than 2: not offered).
day1_days(c: int): int {
    if (c < 0 || c >= chapters) return 0;
    b: int = ch_book[c];
    n: int = book_first[b] + book_count[b] - c;
    if (n < 2) 0 else n
}

// A Chapter a Day from chapter c chosen (false if it is not offered): its
// days made now, if the plans are, else with them.
plan_day1_choose(c: int): bool {
    n: int = day1_days(c);
    if (n == 0) return false;
    day1_from = c;
    plan_lengths[PLAN_DAY1] = n;
    pl_chapters[PLAN_DAY1] = n * 1000;
    if (pl_ready) plan_day1_make();
    true
}

plan_day1_make() {
    pl_readings = pl_base_readings;
    day: int = pl_day0[PLAN_DAY1];
    n: int = plan_lengths[PLAN_DAY1];
    for d in 0..n {
        pl_r0[day + d] = pl_readings;
        plan_reading(day1_from + d, day1_from + d);
        pl_rn[day + d] = 1
    }
    pl_day0[PLAN_DAY1 + 1] = day + n
}

// A plan's name: "Bible in a Year"; a listed one's file's; "Romans, a
// Chapter a Day", "Psalms, a Psalm a Day".
fput_plan_name(p: int) {
    if (plan_listed(p) && pl_name_e[p] > pl_name_b[p]) {
        fput_bytes(pl_words, pl_name_b[p], pl_name_e[p]);
        return
    }
    if (p < PLANS) {
        fput_str(plan_names[p]);
        return
    }
    b: int = ch_book[day1_from];
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    fput_str(if (book_is(b, "PSA")) ", a Psalm a Day" else ", a Chapter a Day")
}

// Its description: "Romans 3–16, one chapter a day."
fput_plan_blurb(p: int) {
    if (plan_listed(p) && pl_blurb_e[p] > pl_blurb_b[p]) {
        fput_bytes(pl_words, pl_blurb_b[p], pl_blurb_e[p]);
        return
    }
    if (p < PLANS) {
        fput_str(plan_blurbs[p]);
        return
    }
    b: int = ch_book[day1_from];
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    fput(32);
    fput_int(ch_num[day1_from]);
    fput_str("\�\�\�");
    fput_int(book_count[b]);
    fput_str(if (book_is(b, "PSA")) ", one psalm a day." else ", one chapter a day.")
}

// Its id, as plan.tsv has it: year, mcheyne, day1-ROM-3.
fput_plan_id(p: int) {
    if (p < PLANS) {
        fput_str(plan_ids[p]);
        return
    }
    fput_str("day1-");
    for i in 0..3 fput(bsb[book_line[ch_book[day1_from]] + 1 + i] as int);
    fput(45);
    fput_int(ch_num[day1_from])
}

// A day1-BOOK-C id at p (plan.tsv's field): its chapter, or -1.
field_day1(p: int): int {
    e: int = field_end(p);
    if (e - p < 10 || !field_prefix(p, "day1-") || fbuf[p + 8] as int != 45) return -1;
    n: int = 0;
    for i in p + 9..e {
        k: int = fbuf[i] as int;
        if (k < 48 || k > 57 || n > 1000) return -1;
        n = n * 10 + k - 48
    }
    for b in 0..books {
        same: bool = true;
        for i in 0..3
            if (bsb[book_line[b] + 1 + i] != fbuf[p + 5 + i]) same = false;
        if (same) {
            if (n < 1 || n > book_count[b]) return -1;
            return book_first[b] + n - 1
        }
    }
    -1
}

field_prefix(p: int, word: str): bool {
    if (p + len(word) > line_e) return false;
    for i in 0..len(word)
        if (fbuf[p + i] != word[i]) return false;
    true
}

// Day d (from 1) of plan p: its index among the plans' days.
plan_day(p: int, d: int): int {
    pl_day0[p] + d - 1
}

// About how many chapters a day (rounded; at least one).
plan_per_day(p: int): int {
    if (plan_lengths[p] <= 0) return 0;
    n: int = (pl_chapters[p] * 2 + plan_lengths[p] * 1000) / (2000 * plan_lengths[p]);
    if (n < 1) 1 else n
}

// ---- labels ----
// Whether passage k is whole chapters.
passage_whole(k: int): bool {
    pl_v1[k] == 1 && pl_v2[k] >= pl_last[pl_c2[k]]
}

// A passage: "Genesis 4–6", "Psalm 119", "Psalms 1–6", "Obadiah",
// "Hebrews 11:8–19", "Matthew 26:57–27:10", "Jude 3–7" (spoken: "Genesis 4
// to 6").
fput_reading(k: int, spoken: bool) {
    a: int = pl_c1[k];
    b: int = pl_c2[k];
    bk: int = ch_book[a];
    dash: str = if (spoken) " to " else "\�\�\�";
    if (passage_whole(k)) {
        if (a == b) {
            fput_title(a);
            return
        }
        fput_bytes(bsb, book_name_start(bk), book_name_end(bk));
        fput(32);
        fput_int(ch_num[a]);
        fput_str(dash);
        fput_int(ch_num[b]);
        return
    }
    if (a == b) {
        fput_ref(a, pl_v1[k], 0);
        if (pl_v2[k] > pl_v1[k]) {
            fput_str(dash);
            fput_int(pl_v2[k])
        }
        return
    }
    if (book_is(bk, "PSA")) fput_str("Psalms") else fput_bytes(bsb, book_name_start(bk),
        book_name_end(bk));
    fput(32);
    fput_int(ch_num[a]);
    fput(58);
    fput_int(pl_v1[k]);
    fput_str(dash);
    fput_int(ch_num[b]);
    fput(58);
    fput_int(pl_v2[k])
}

// A day's passages: "Genesis 12–14; Psalm 105; Hebrews 11:8–19".
fput_day(di: int) {
    for k in pl_r0[di]..pl_r0[di] + pl_rn[di] {
        if (k > pl_r0[di]) fput_str("; ");
        fput_reading(k, false)
    }
}

// The same, as VoiceOver says it ("Genesis 12 to 14; Psalm 105").
fput_day_spoken(di: int) {
    for k in pl_r0[di]..pl_r0[di] + pl_rn[di] {
        if (k > pl_r0[di]) fput_str("; ");
        fput_reading(k, true)
    }
}

// ---- progress (plan.tsv, DESIGN.md §16.5) ----
// The plan followed (-1: none) and the day it began; each passage's state
// (0 as 1.0's lines say, 1 read, 2 not: DONE and UNDONE), and when; 1.0's
// chapters read (READ lines), which count for the passages of a computed
// plan whose every chapter they name.
pl_active: int = -1;

pl_start: int = 0;

pl_pstate: []int = new int[9000](0);

pl_pstate_t: []int = new int[9000](0);

pl_read: []bool = new bool[1200](false);

pl_read_t: []int = new int[1200](0);

// A PLAN line this build had no plan for (its file is kept by the platform
// in plans-done.tsv, and the plan cleared: "plan unknown").
pl_unknown: bool = false;

plan_clear() {
    pl_active = -1;
    pl_start = 0;
    for k in 0..len(pl_pstate) {
        pl_pstate[k] = 0;
        pl_pstate_t[k] = 0
    }
    for c in 0..len(pl_read) {
        pl_read[c] = false;
        pl_read_t[c] = 0
    }
}

// Plan p begun on day start, nothing read.
plan_begin(p: int, start: int) {
    plan_clear();
    pl_active = p;
    pl_start = start
}

// Today's day of the plan followed (from 1, at most its last).
plan_today(today: int): int {
    if (pl_active < 0) return 0;
    n: int = today - pl_start + 1;
    if (n < 1) n = 1;
    if (n > plan_lengths[pl_active]) n = plan_lengths[pl_active];
    n
}

// How much of passage k is read: 0 none, 1 some (1.0's chapters, some of
// its), 2 all.
passage_state(k: int): int {
    s: int = pl_pstate[k];
    if (s == 1) return 2;
    if (s == 2) return 0;
    all: bool = true;
    any: bool = false;
    for c in pl_c1[k]..pl_c2[k] + 1 {
        if (pl_read[c]) any = true else all = false
    }
    if (all) 2 else if (any) 1 else 0
}

// The same for a reading, as Round 5 called it.
reading_state(k: int): int {
    passage_state(k)
}

day_state(di: int): int {
    all: bool = true;
    any: bool = false;
    for k in pl_r0[di]..pl_r0[di] + pl_rn[di] {
        s: int = passage_state(k);
        if (s != 2) all = false;
        if (s != 0) any = true
    }
    if (all) 2 else if (any) 1 else 0
}

// The first passage of day di not read (its first, if all are).
day_first_unread(di: int): int {
    for k in pl_r0[di]..pl_r0[di] + pl_rn[di]
        if (passage_state(k) != 2) return k;
    pl_r0[di]
}

// Passage k read (at time t), or not.
mark_passage(k: int, on: bool, t: int) {
    pl_pstate[k] = (if (on) 1 else 2);
    pl_pstate_t[k] = t
}

mark_day(di: int, on: bool, t: int) {
    for k in pl_r0[di]..pl_r0[di] + pl_rn[di] mark_passage(k, on, t)
}

// Passage k of day d (from 1) of the plan followed read at time t:
// whether that finished today's day (it was today's last unread).
mark_passage_done(
    d: int,
    k: int,
    t: int,
    today: int
): bool {
    if (pl_active < 0 || passage_state(k) == 2) return false;
    mark_passage(k, true, t);
    d == plan_today(today) && day_state(plan_day(pl_active, d)) == 2
}

// The earlier days (before today's) not finished: how many, and the first
// (from 1; 0 if none) in pl_first_behind.
pl_first_behind: int = 0;

plan_behind(today: int): int {
    pl_first_behind = 0;
    if (pl_active < 0) return 0;
    n: int = 0;
    for d in 1..plan_today(today) {
        if (day_state(plan_day(pl_active, d)) != 2) {
            if (pl_first_behind == 0) pl_first_behind = d;
            n = n + 1
        }
    }
    n
}

// The file: PLAN id start; 1.0's READ lines for a passage they leave
// partly read (so its half circle stays: no READ line is ever made); then
// DONE (or UNDONE) DAY PASSAGE TIME, a passage's index in its day from 0.
format_plan() {
    fbuf_n = 0;
    put_plan()
}

// The same, after what is in fbuf.
put_plan() {
    if (pl_active < 0) return;
    fput_str("PLAN\t");
    fput_plan_id(pl_active);
    fput(9);
    fput_iso_date(pl_start);
    fput(10);
    // (1.0's, for the passages no DONE or UNDONE has decided.)
    for d in 1..plan_lengths[pl_active] + 1 {
        di: int = plan_day(pl_active, d);
        for k in pl_r0[di]..pl_r0[di] + pl_rn[di] {
            if (pl_pstate[k] == 0) {
                for c in pl_c1[k]..pl_c2[k] + 1 {
                    if (pl_read[c]) {
                        fput_str("READ\t");
                        fput_book(ch_book[c]);
                        fput_int(ch_num[c]);
                        fput(9);
                        fput_int(pl_read_t[c]);
                        fput(10)
                    }
                }
            }
        }
    }
    for d in 1..plan_lengths[pl_active] + 1 {
        di: int = plan_day(pl_active, d);
        for k in pl_r0[di]..pl_r0[di] + pl_rn[di] {
            s: int = pl_pstate[k];
            if (s != 0) {
                fput_str(if (s == 1) "DONE\t" else "UNDONE\t");
                fput_int(d);
                fput(9);
                fput_int(k - pl_r0[di]);
                fput(9);
                fput_int(pl_pstate_t[k]);
                fput(10)
            }
        }
    }
}

// A date field (YYYY-MM-DD) as a day, or -1.
field_iso_day(p: int): int {
    e: int = field_end(p);
    if (e - p != 10 || fbuf[p + 4] as int != 45 || fbuf[p + 7] as int != 45) return -1;
    y: int = 0;
    m: int = 0;
    d: int = 0;
    for i in 0..10 {
        k: int = fbuf[p + i] as int;
        if (i != 4 && i != 7) {
            if (k < 48 || k > 57) return -1;
            if (i < 4) y = y * 10 + k - 48 else if (i < 7) m = m * 10 + k - 48 else d = d * 10 + k - 48
        }
    }
    if (m < 1 || m > 12 || d < 1 || d > 31) return -1;
    days_from_civil(y, m, d)
}

// A date as a day (counted from 1 January 1970).
days_from_civil(y_in: int, m: int, d: int): int {
    y: int = if (m <= 2) y_in - 1 else y_in;
    era: int = (if (y >= 0) y else y - 399) / 400;
    yoe: int = y - era * 400;
    mp: int = if (m > 2) m - 3 else m + 9;
    doy: int = (153 * mp + 2) / 5 + d - 1;
    doe: int = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

// The plan named at p (plan.tsv's field), or -1.
field_plan(p: int): int {
    for i in 0..PLANS
        if (field_is(p, plan_ids[i]) && plan_lengths[i] > 0) return i;
    -1
}

// plan.tsv's lines (in fbuf): a bad line skipped; no plan if its first
// good line is not a PLAN line; one naming a plan this build has not,
// pl_unknown. Then 1.0's READ lines become DONE for each passage all of
// whose chapters they name (unless DONE or UNDONE said otherwise), and
// stay only for a passage they leave partly read.
parse_plan() {
    plan_clear();
    pl_unknown = false;
    begin_lines();
    lines_read = 0;
    lines_skipped = 0;
    while (next_line()) {
        if (line_e > fpos) {
            lines_read = lines_read + 1;
            f2: int = field_after(fpos);
            if (field_is(fpos, "PLAN") && pl_active < 0 && lines_read == 1) {
                p: int = field_plan(f2);
                // (A Chapter a Day: day1-ROM-3, offered from there.)
                if (p < 0) {
                    c: int = field_day1(f2);
                    if (c >= 0 && day1_days(c) > 0) p = PLAN_DAY1
                }
                day: int = field_iso_day(field_after(f2));
                if (p == PLAN_DAY1 && day >= 0) {
                    if (!plan_day1_choose(field_day1(f2))) p = -1
                }
                if (p >= 0 && day >= 0) {
                    pl_active = p;
                    pl_start = day
                } else {
                    if (p < 0 && day >= 0) pl_unknown = true;
                    skip_line()
                }
            } else if (field_is(fpos, "READ") && pl_active >= 0 && !plan_listed(pl_active)) {
                c: int = field_chapter(f2);
                t: int = field_time(field_after(field_after(f2)));
                if (c >= 0) {
                    pl_read[c] = true;
                    pl_read_t[c] = t
                } else skip_line()
            } else if ((field_is(fpos, "DONE") || field_is(fpos, "UNDONE")) && pl_active >= 0) {
                d: int = field_num(f2, false);
                f3: int = field_after(f2);
                i: int = field_num(f3, false);
                t: int = field_time(field_after(f3));
                if (d >= 1 && d <= plan_lengths[pl_active] && i >= 0 && i < pl_rn[plan_day(pl_active,
                    d)]) {
                    k: int = pl_r0[plan_day(pl_active, d)] + i;
                    pl_pstate[k] = (if (field_is(fpos, "DONE")) 1 else 2);
                    pl_pstate_t[k] = t
                } else skip_line()
            } else skip_line()
        }
    }
    if (pl_active < 0) return;
    // (1.0's chapters, as passages.)
    for d in 1..plan_lengths[pl_active] + 1 {
        di: int = plan_day(pl_active, d);
        for k in pl_r0[di]..pl_r0[di] + pl_rn[di] {
            all: bool = true;
            t: int = 0;
            for c in pl_c1[k]..pl_c2[k] + 1 {
                if (!pl_read[c]) all = false else if (pl_read_t[c] > t) t = pl_read_t[c]
            }
            if (all && pl_pstate[k] == 0) {
                pl_pstate[k] = 1;
                pl_pstate_t[k] = t
            }
        }
    }
    for d in 1..plan_lengths[pl_active] + 1 {
        di: int = plan_day(pl_active, d);
        for k in pl_r0[di]..pl_r0[di] + pl_rn[di]
            if (pl_pstate[k] != 0) {
                for c in pl_c1[k]..pl_c2[k] + 1 {
                    pl_read[c] = false;
                    pl_read_t[c] = 0
                }
            }
    }
}

// ---- the reminder (DESIGN.md §10, owner amendment) ----
// A day's reminder: "Today's reading: John 4–6".
fput_reminder(di: int) {
    fbuf_n = 0;
    fput_str("Today\�\�\�s reading: ");
    fput_day(di)
}

// ---- a day as the reader lays it out (DESIGN.md §16.2.1) ----
// Day di's rows: a row a chapter of a passage, its part (verses v1 to v2;
// 0: to its end), and which passage it is of.
DY_MOST: int = 120;

dy_di: int = -1;

dy_n: int = 0;

dy_k: []int = new int[120](0);

dy_c: []int = new int[120](0);

dy_v1: []int = new int[120](0);

dy_v2: []int = new int[120](0);

// The day's number (from 1) and its plan, for its opener.
dy_day: int = 0;

dy_plan: int = 0;

day_rows(p: int, d: int) {
    dy_plan = p;
    dy_day = d;
    dy_di = plan_day(p, d);
    dy_n = 0;
    for k in pl_r0[dy_di]..pl_r0[dy_di] + pl_rn[dy_di] {
        for c in pl_c1[k]..pl_c2[k] + 1 {
            if (dy_n < DY_MOST) {
                dy_k[dy_n] = k;
                dy_c[dy_n] = c;
                dy_v1[dy_n] = (if (c == pl_c1[k]) pl_v1[k] else 1);
                dy_v2[dy_n] = (if (c == pl_c2[k] && pl_v2[k] < pl_last[c]) pl_v2[k] else 0);
                dy_n = dy_n + 1
            }
        }
    }
}

// The row of the day holding verse v of chapter c (-1 if none).
day_row_of(c: int, v: int): int {
    for r in 0..dy_n
        if (dy_c[r] == c && v >= dy_v1[r] && (dy_v2[r] == 0 || v <= dy_v2[r])) return r;
    -1
}

// The first row of chapter c in the day (-1 if none).
day_row_first(c: int): int {
    for r in 0..dy_n
        if (dy_c[r] == c) return r;
    -1
}

// Whether row r is its passage's first, and its last.
day_row_begins(r: int): bool {
    r == 0 || dy_k[r - 1] != dy_k[r]
}

day_row_ends(r: int): bool {
    r == dy_n - 1 || dy_k[r + 1] != dy_k[r]
}

// Row r as runs in out: on the first row, the day's opener ("DAY 32", the
// plan's name, a rule); on a passage's first, its heading (a reference, to
// preview); then the chapter's part.
dy_label: []i8 = new i8[256](0i8);

layout_day_row(r: int) {
    k: int = dy_k[r];
    c: int = dy_c[r];
    // (The labels made before out is begun: fput_title lays out in out.)
    at: int = fbuf_n;
    if (r == 0) fput_plan_name(dy_plan);
    name_n: int = fbuf_n - at;
    if (day_row_begins(r)) fput_reading(k, false);
    n: int = fbuf_n - at;
    if (n > len(dy_label)) n = len(dy_label);
    for i in 0..n dy_label[i] = fbuf[at + i];
    fbuf_n = at;
    out_n = 0;
    runs = 0;
    verse_count = 0;
    opener_at = 0;
    label_end = 0;
    if (r == 0) {
        lay_begin(STYLE_BOOKLABEL, PARA_CENTER, 0);
        lay_str("DAY ");
        lay_int(dy_day);
        lay_byte(10);
        lay_begin(STYLE_HEAD, PARA_CENTER, 0);
        for i in 0..name_n lay_byte(dy_label[i] as int);
        lay_byte(10);
        lay_begin(STYLE_RULE, PARA_CENTER, 0);
        lay_object();
        lay_byte(10)
    }
    begins: bool = day_row_begins(r);
    if (begins) {
        xr_book = ch_book[pl_c1[k]];
        xr_c = ch_num[pl_c1[k]];
        xr_v = (if (passage_whole(k)) 0 else pl_v1[k]);
        xr_ce = ch_num[pl_c2[k]];
        xr_ve = (if (passage_whole(k)) 0 else pl_v2[k]);
        if (xr_ce == xr_c && xr_ve == xr_v) xr_ce = 0;
        lay_begin(STYLE_PASSAGE, PARA_PROSE, xref_start());
        run_arg2[runs - 1] = xref_end();
        for i in name_n..n lay_byte(dy_label[i] as int);
        lay_byte(10);
        label_end = out_n
    }
    lay_v1 = dy_v1[r];
    lay_v2 = dy_v2[r];
    lay_passage = begins;
    layout_chapter_on(c);
    lay_v1 = 0;
    lay_v2 = 0;
    lay_passage = false
}
