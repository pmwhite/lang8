tag bible_ios;

use_tag std, ios, bible;

// Cards in Practice (DESIGN.md Â§14.5.4, Â§14.10b.2): the same sheet as
// passages, the level row's alpha 0, a card laid out once in a scroll
// view of its own (the word at the hero size, its transliteration, the
// verse window, "What does it mean here?" on a session's first word
// card, the answer in the clear color until Check, so nothing moves: the
// BSB's words for it in this verse, the sense there, the verse, the
// lemma's line and related words known); a new card shown with its answer
// and Next, then once more at the end for a judgement; Not Yet Â· Mostly Â·
// Knew It on Â§13's schedule, none tinted. Practise Reading (Â§14.3.3) is
// the same sheet: common words of letters known to read to yourself,
// Check showing the transliteration, nothing spoken (Â§14.10b.1), no
// judgement, ten at a time. Practice's queue (px_q) holds a passage's id,
// a card as -1 - its index, or a word to read as -1000000 - its index.
import "../ios/objc.l8";

import "text.l8";

import "lang.l8";

import "memory.l8";

import "learn.l8";

// ---- the card's views ----
crd_scroll: int = 0;

crd_new: int = 0;

crd_word: int = 0;

crd_tr: int = 0;

crd_cap: int = 0;

crd_win: int = 0;

crd_ask: int = 0;

crd_gloss: int = 0;

crd_here: int = 0;

crd_verse: int = 0;

crd_meta: int = 0;

crd_rel: int = 0;

// What is shown: the card (or, reading, the word), its verse and the word
// in it; whether its answer is shown; whether this is a new card's first
// showing; the language.
crd_active: bool = false;

crd_k: int = -1;

crd_vi: int = -1;

crd_w: int = -1;

crd_checked: bool = false;

crd_first: bool = false;

crd_lang: int = 0;

crd_width: f64 = 0.0f64;

// Practise Reading: its language (-1: not reading), its round (Again's),
// the word shown.
crd_reading: int = -1;

crd_round: int = 0;

crd_read_w: int = -1;

// The one-time line (learnSeen; Practise Reading's learnReadSeen), on
// this sheet's first card.
crd_hint: bool = false;

// "What does it mean here?": on the session's first word card (crd_ask_at,
// its place in the queue; -1 none yet).
crd_ask_at: int = -1;

READ_CODE: int = 1000000;

// A queue's entry is a card, a word to read, or a passage.
px_entry_card(e: int): int {
    if (e < 0 && -e - 1 < READ_CODE) -e - 1 else -1
}

px_entry_word(e: int): int {
    if (e <= -READ_CODE) -e - READ_CODE else -1
}

px_entry_ok(e: int): bool {
    if (e >= 0) return mem_index(e) >= 0;
    k: int = px_entry_card(e);
    if (k >= 0) return k < cd_n;
    px_entry_word(e) >= 0
}

// The card's view, in the sheet's view (made with the sheet).
crd_make(view: int) {
    sv: int = make("UIScrollView");
    msg1(sv, sel("setBackgroundColor:"), c_bg);
    msg1(sv, sel("setAlwaysBounceVertical:"), 1);
    msg1(sv, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(sv, sel("setHidden:"), 1);
    msg1(view, sel("addSubview:"), sv);
    guide: int = msg(view, sel("safeAreaLayoutGuide"));
    pin_to(sv, "topAnchor", guide, "topAnchor", 0.0f64);
    pin_to(sv, "bottomAnchor", guide, "bottomAnchor", 0.0f64);
    pin_to(sv, "leadingAnchor", view, "leadingAnchor", 0.0f64);
    pin_to(sv, "trailingAnchor", view, "trailingAnchor", 0.0f64);
    crd_scroll = held(crd_scroll, sv);
    release(sv);
    crd_new = crd_label(false);
    crd_word = crd_label(true);
    crd_tr = crd_label(false);
    crd_cap = crd_label(false);
    crd_win = crd_label(false);
    crd_ask = crd_label(false);
    crd_gloss = crd_label(false);
    crd_here = crd_label(false);
    crd_verse = crd_label(false);
    crd_meta = crd_label(false);
    crd_rel = crd_label(false);
    if (LEARN_SPEECH) {
        tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
            app_obj, sel("learnSpeakCard:"));
        msg1(crd_word, sel("addGestureRecognizer:"), tap);
        release(tap)
    }
    crd_width = 0.0f64
}

crd_label(touch: bool): int {
    l: int = make("UILabel");
    msg1(l, sel("setNumberOfLines:"), 0);
    msg1(l, sel("setTextAlignment:"), 1);
    if (touch) msg1(l, sel("setUserInteractionEnabled:"), 1);
    msg1(crd_scroll, sel("addSubview:"), l);
    release(l);
    l
}

// ---- a card begun ----
// The queue's entry e shown: a card (k), or a word to read.
crd_begin(e: int) {
    crd_active = true;
    k: int = px_entry_card(e);
    if (crd_reading >= 0) {
        crd_read_w = px_entry_word(e);
        crd_k = -1;
        crd_lang = crd_reading;
        crd_first = false;
        crd_checked = false;
        crd_vi = -1;
        crd_w = crd_read_w;
        // (Its one-time line, the first word ever read.)
        if (!def_bool("learnReadSeen")) {
            crd_hint = true;
            set_def_bool("learnReadSeen", true)
        }
        px_step = PX_READ;
        msg1(px_vc, sel("setTitle:"), nsstring("Practise Reading"))
    } else {
        crd_k = k;
        crd_lang = cd_lang[k];
        crd_first = cd_state[k] == MS_NEW;
        crd_checked = crd_first;
        // (The one-time line, the first time a new letter or joined word is
        // seen; a word card asks its question instead.)
        if (crd_first && cd_kind[k] != CK_WORD && !def_bool("learnSeen")) {
            crd_hint = true;
            set_def_bool("learnSeen", true)
        }
        learn_shown(k, today());
        if (crd_first && px_qn < len(px_q)) {
            // (Back once more at the end, hidden, for a judgement.)
            px_q[px_qn] = -k - 1;
            px_back[px_qn] = false;
            crd_ret[px_qn] = RET_NEW;
            px_qn = px_qn + 1
        }
        _c: bool = learn_context(k, time(0));
        crd_vi = ctx_vi;
        crd_w = ctx_w;
        if (crd_ask_at < 0 && cd_kind[k] == CK_WORD) crd_ask_at = px_at;
        px_step = (if (crd_first) PX_CARD_NEW else PX_CARD);
        cards_changed();
        msg1(px_vc, sel("setTitle:"), nsstring(crd_title()))
    }
    crd_count();
    // (The level row out, the text view hidden, the card in.)
    if (!reduce_motion()) fade_layer(msg(px_seg, sel("layer")), 0.2f64);
    msg_set_f(px_seg, sel("setAlpha:"), 0.0f64);
    msg1(px_tv, sel("setHidden:"), 1);
    msg1(px_end, sel("setHidden:"), 1);
    msg1(crd_scroll, sel("setHidden:"), 0);
    crd_fill();
    crd_log()
}

// The session's title: "Greek Words" ("Greek Letters" while only letters
// are in it).
crd_title(): str {
    letters: bool = true;
    for x in px_at..px_qn {
        c: int = px_entry_card(px_q[x]);
        if (c >= 0 && c < cd_n && cd_kind[c] != CK_LETTER) letters = false;
        if (px_q[x] > 0) letters = false
    }
    if (crd_lang == 0 && letters) return "Greek Letters";
    if (crd_lang == 0) return "Greek Words";
    if (letters) "Hebrew Letters" else "Hebrew Words"
}

// "3 of 8": the session's items, each once (a card back for its
// judgement, or after Not Yet, is not counted again).
crd_count() {
    n: int = 0;
    at: int = 0;
    for x in 0..px_qn {
        if (!px_back[x] && crd_ret[x] == RET_FIRST) {
            n = n + 1;
            if (x <= px_at) at = n
        }
    }
    // (No count: no button left on the bar, not an empty one.)
    left: int = msg(msg(px_vc, sel("navigationItem")), sel("leftBarButtonItem"));
    if (left != 0 && responds(left, "setHidden:")) msg1(left, sel("setHidden:"), if (n > 1) 0 else 1);
    if (n > 1) {
        fbuf_n = 0;
        fput_int(at);
        fput_str(" of ");
        fput_int(n);
        msg1(px_count, sel("setText:"), fstring());
        fbuf_n = 0;
        fput_str("Card ");
        fput_int(at);
        fput_str(" of ");
        fput_int(n);
        msg1(px_count, sel("setAccessibilityLabel:"), fstring());
        msg(px_count, sel("sizeToFit"))
    } else msg1(px_count, sel("setText:"), 0)
}

// "bible: learn shown G25 new, context PHP 4:6".
crd_log() {
    if (!diag_on) return;
    fbuf_n = 0;
    fput_str("bible: learn shown ");
    if (crd_k >= 0) fput_card_key(crd_k) else {
        form_of(crd_read_w);
        fput_bytes(lforms, wt_b, wt_e)
    }
    fput_str(if (crd_first) " new" else if (crd_reading >= 0) " reading" else " review");
    if (crd_vi >= 0) {
        fput_str(", context ");
        c: int = v_chapter(crd_vi);
        b: int = ch_book[c];
        for x in 0..3 fput(bsb_code_at(b, x));
        fput(32);
        fput_int(ch_num[c]);
        fput(58);
        fput_int(v_num(crd_vi))
    }
    fput_str(if (crd_checked) ", answer shown" else ", answer hidden");
    note_ns(fstring())
}

// ---- the card laid out ----
crd_shown(): int {
    if (crd_checked) c_ink else px_clear_color()
}

px_clear_color(): int {
    if (px_clear == 0) px_clear = keep(msg(cls("UIColor"), sel("clearColor")));
    px_clear
}

// Each label's text, in its colors (the answer's clear until Check), then
// every frame: the layout is the same hidden or shown.
crd_fill() {
    if (crd_scroll == 0) return;
    lang: int = crd_lang;
    greek: bool = lang == 0;
    k: int = crd_k;
    letter: bool = k >= 0 && cd_kind[k] != CK_WORD;
    word: bool = k >= 0 && !letter;
    reading: bool = crd_reading >= 0;
    i: int = if (letter) cd_key[k] else -1;
    clear: int = px_clear_color();
    // 1. "New", and the one-time line.
    // (Its line's space kept on every card, so the word sits in one place;
    // the reading's, only the first time.)
    fbuf_n = 0;
    if (!reading) fput_str("New");
    if (crd_hint && (crd_first || reading)) {
        if (!reading) fput_str("\n");
        if (reading) fput_str("Read it to yourself, then Check.") else fput_str(if (cd_kind[k] == CK_LETTER) "Say its name and sound, then Check." else "Say what it means, then Check.")
    }
    msg1(crd_new, sel("setAttributedText:"), attributed(fstring(), px_scaled(sans(13.0f64,
        0.0f64)), if (crd_first || reading) c_faint else clear));
    // 2. The word: the lemma, the letter, the joined word, or the word to
    // read (its form).
    fbuf_n = 0;
    if (reading) {
        form_of(crd_read_w);
        fput_bytes(lforms, wf_b, wf_e)
    } else if (letter) fput_lt(i, LF_GLYPH) else fput_lemma(lang, cd_key[k], 0);
    hero: int = original_font(greek, 34.0f64, 40.0f64);
    if (letter) hero = original_font(greek, 56.0f64, 56.0f64);
    wa: int = attributed(fstring(), hero, c_ink);
    msg4(wa, sel("addAttribute:value:range:"), k_para, orig_para(lang, 1, if (lang == 1) 1.35f64 else 1.25f64),
        0, msg(wa, sel("length")));
    msg1(crd_word, sel("setAttributedText:"), wa);
    msg1(crd_word, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(crd_word, sel("setMinimumScaleFactor:"), 0.4f64);
    // 3. Its transliteration: clear while the alphabet is known and the
    // card isn't checked (reading: until Check); its space kept.
    fbuf_n = 0;
    if (reading) {
        form_of(crd_read_w);
        fput_bytes(lforms, wt_b, wt_e)
    } else if (!letter) fput_lemma(lang, cd_key[k], 1);
    trc: int = if (reading) crd_shown() else if (kn_alpha[lang] && !crd_checked) clear else c_faint;
    msg1(crd_tr, sel("setAttributedText:"), attributed(fstring(), italic_sans(scaled(17.0f64)),
        trc));
    // 4. The verse window: its reference, then up to 12 words around the
    // form (semibold), the rest at 60%; a letter's example, the letter in
    // accent.
    fbuf_n = 0;
    if (crd_vi >= 0 && !reading) fput_ref(v_chapter(crd_vi), v_num(crd_vi), 0);
    msg1(crd_cap, sel("setAttributedText:"), attributed(fstring(), px_scaled(sans(13.0f64,
        0.4f64)), c_faint));
    if (reading) msg1(crd_win, sel("setAttributedText:"), 0) else if (letter) msg1(crd_win,
        sel("setAttributedText:"), ln_example_text(i, 26.0f64, 30.0f64, 1)) else msg1(crd_win,
        sel("setAttributedText:"), crd_window());
    // 5. The question, on the session's first word card.
    fbuf_n = 0;
    if (word && px_at == crd_ask_at) fput_str("What does it mean here?");
    msg1(crd_ask, sel("setAttributedText:"), attributed(fstring(), px_scaled(sans(15.0f64,
        0.0f64)), c_faint));
    // 6. The answer. A word: the BSB's words for it in this verse, large;
    // the sense there ("Here: God"), when its lemma has several; the verse
    // with those words semibold; the lemma's line, faint; related words
    // known. A letter: its name and sound, its example's verse, the
    // example's meaning. Reading: "transliteration, a guide to the
    // letters", under the transliteration.
    fbuf_n = 0;
    if (letter) {
        fput_lt(i, LF_NAME);
        if (cd_kind[k] == CK_LETTER) {
            fput_str(" \Â\· ");
            fput_lt_sound(i, ln_pron(lang))
        }
    } else if (word && !fput_words_here(crd_vi, crd_w)) {
        fbuf_n = 0;
        crd_put_gloss()
    }
    msg1(crd_gloss, sel("setAttributedText:"), attributed(fstring(), px_scaled(sans(if (word) 24.0f64 else 20.0f64,
        0.4f64)), crd_shown()));
    fbuf_n = 0;
    if (word) _h: bool = fput_sense_here(crd_vi, crd_w);
    msg1(crd_here, sel("setAttributedText:"), attributed(fstring(), px_scaled(sans(17.0f64,
        0.0f64)), crd_shown()));
    if (reading) msg1(crd_verse, sel("setAttributedText:"), 0) else msg1(crd_verse,
        sel("setAttributedText:"), crd_verse_text());
    fbuf_n = 0;
    if (reading) fput_str("transliteration, a guide to the letters") else if (letter && cd_kind[k] == CK_JOINED) fput_str(if (lt_part[i] < 6) "joined to the front of a word" else "joined to the end of a word") else if (letter) {
        // (Its example, transliterated, and its meaning.)
        if (crd_w >= 0) {
            form_of(crd_w);
            for x in wt_b..wt_e fput(lforms[x] as int);
            fput_str(": ")
        }
        fput_lemma(lang, lt_key[i], 3)
    } else fput_card_meta(lang, cd_key[k]);
    msg1(crd_meta, sel("setAttributedText:"), attributed(fstring(), px_scaled(sans(13.0f64,
        0.0f64)), if (crd_checked) c_faint else clear));
    msg1(crd_rel, sel("setAttributedText:"), if (word) crd_related() else 0);
    crd_layout();
    crd_access()
}

// The lemma's gloss (its sense's, in this verse): where the verse has no
// English for it.
crd_put_gloss() {
    k: int = crd_k;
    greek: bool = cd_lang[k] == 0;
    e: int = if (crd_w >= 0) meaning_entry(greek, cd_key[k], w_sense(crd_w)) else -1;
    if (e < 0) e = lex_first(greek, cd_key[k]);
    if (e < 0) return;
    lex_field(e, 3);
    fput_gloss(lf_b, lf_e)
}

// "Related: Ï†Î¹Î»Î­Ï‰ to love, á¼€Î³Î¬Ï€Î· love": up to two words of its family
// known (Â§10.4's list), each lemma in its own type, faint around it;
// clear until Check.
crd_related(): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    lang: int = crd_lang;
    learn_related_known(lang, cd_key[crd_k]);
    if (rk_n == 0) return s;
    shown: bool = crd_checked;
    soft: int = if (shown) c_faint else px_clear_color();
    ink: int = if (shown) c_ink else px_clear_color();
    plain: int = px_scaled(sans(15.0f64, 0.0f64));
    orig: int = original_font(lang == 0, 17.0f64, 19.0f64);
    append(s, nsstring("Related: "), plain, soft);
    for x in 0..rk_n {
        if (x > 0) append(s, nsstring(", "), plain, soft);
        fbuf_n = 0;
        if (lang == 1) fput_rli();
        fput_lemma(lang, rk_num[x], 0);
        if (lang == 1) fput_pdi();
        append(s, fstring(), orig, ink);
        fbuf_n = 0;
        fput(32);
        fput_lemma(lang, rk_num[x], 3);
        append(s, fstring(), plain, soft)
    }
    msg4(s, sel("addAttribute:value:range:"), k_para, orig_para(0, 1, 1.25f64), 0,
        msg(s, sel("length")));
    s
}

// The window: words ow_from to ow_to of the verse in the original order,
// "â€¦" where cut; the form semibold ink, the rest ink at 60% (Hebrew
// right to left).
crd_window(): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    if (crd_vi < 0 || crd_w < 0) return s;
    lang: int = crd_lang;
    greek: bool = lang == 0;
    learn_window(crd_vi, crd_w);
    soft: int = msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.6f64);
    plain: int = original_font(greek, 17.0f64, 19.0f64);
    strong: int = if (greek) crd_serif_bold(scaled(17.0f64)) else sans(scaled(19.0f64),
        0.4f64);
    if (ow_from > 0) append(s, nsstring("\â\€\¦ "), plain, soft);
    for o in ow_from..ow_to {
        w: int = word_at_order(crd_vi, o);
        if (w >= 0) {
            form_of(w);
            if (o > ow_from) append(s, nsstring(" "), plain, soft);
            if (w == crd_w) append(s, ns_of(lforms, wf_b, wf_e), strong, c_ink) else append(s,
                ns_of(lforms, wf_b, wf_e), plain, soft)
        }
    }
    if (ow_to < v_end(crd_vi) - v_first(crd_vi)) append(s, nsstring(" \â\€\¦"), plain,
        soft);
    msg4(s, sel("addAttribute:value:range:"), k_para, orig_para(lang, 1, if (lang == 1) 1.35f64 else 1.25f64),
        0, msg(s, sel("length")));
    s
}

crd_serif_bold(size: f64): int {
    f: int = serif(size);
    d: int = msg1(msg(f, sel("fontDescriptor")), sel("fontDescriptorWithSymbolicTraits:"),
        2);
    if (d == 0) f else msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

// The verse in the BSB (16 points, ink at 80%; clear until Check), the
// word's English semibold ink.
crd_verse_text(): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    if (crd_vi < 0) return s;
    study_load(crd_vi);
    size: f64 = scaled(16.0f64);
    shown: bool = crd_checked;
    soft: int = if (shown) msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64) else px_clear_color();
    a: int = if (st_title > 0) st_title + 1 else 0;
    text: int = ns_of(st, a, st_n);
    append(s, text, body(size), soft);
    if (crd_w >= 0) {
        chunk_of(crd_w);
        if (ch_e > ch_b && ch_b >= a) {
            b: int = st_utf16(a, ch_b);
            n: int = st_utf16(ch_b, ch_e);
            msg4(s, sel("addAttribute:value:range:"), k_font, sans(size, 0.4f64),
                b, n);
            msg4(s, sel("addAttribute:value:range:"), k_color, if (shown) c_ink else px_clear_color(),
                b, n)
        }
    }
    msg4(s, sel("addAttribute:value:range:"), k_para, orig_para(0, 1, 1.25f64), 0,
        msg(s, sel("length")));
    s
}

// The frames: 32 points down, "New"; the word; its transliteration; 28
// points, the window; 24 points, the question; 24 points, the answer;
// centred, 20 points in.
crd_layout() {
    if (crd_scroll == 0) return;
    W: f64 = view_width(crd_scroll);
    if (W <= 0.0f64) W = view_width(window);
    crd_width = W;
    m: f64 = 20.0f64;
    most: f64 = W - 2.0f64 * m;
    if (most > 560.0f64) {
        m = (W - 560.0f64) / 2.0f64;
        most = 560.0f64
    }
    y: f64 = 32.0f64;
    y = crd_place(crd_new, y, m, most, 8.0f64);
    y = crd_place(crd_word, y, m, most, 4.0f64);
    y = crd_place(crd_tr, y, m, most, 28.0f64);
    y = crd_place(crd_cap, y, m, most, 4.0f64);
    y = crd_place(crd_win, y, m, most, 24.0f64);
    y = crd_place(crd_ask, y, m, most, 24.0f64);
    y = crd_place(crd_gloss, y, m, most, 8.0f64);
    y = crd_place(crd_here, y, m, most, 8.0f64);
    y = crd_place(crd_verse, y, m, most, 10.0f64);
    y = crd_place(crd_meta, y, m, most, 8.0f64);
    y = crd_place(crd_rel, y, m, most, 0.0f64);
    msg_ff(crd_scroll, sel("setContentSize:"), W, y + 40.0f64);
    // (At the accessibility sizes, room under it for the stacked judgement.)
    msg_rect(crd_scroll, sel("setContentInset:"), 0.0f64, 0.0f64, if (ax_size()) 240.0f64 else 0.0f64,
        0.0f64)
}

// A label at y (its text's height; an empty one's nothing), and the y
// after it and its gap.
crd_place(
    l: int,
    y: f64,
    m: f64,
    most: f64,
    gap: f64
): f64 {
    t: int = msg(l, sel("attributedText"));
    if (t == 0 || msg(t, sel("length")) == 0) {
        msg_rect(l, sel("setFrame:"), m, y, most, 0.0f64);
        return y
    }
    label_size(l, most);
    h: f64 = hfa[1];
    msg_rect(l, sel("setFrame:"), m, y, most, h);
    y + h + gap
}

// The sheet laid out at a new width: the card again.
crd_laid_out() {
    if (!crd_active || crd_scroll == 0) return;
    if (view_width(crd_scroll) != crd_width) crd_layout()
}

// VoiceOver: before Check, one element ("agapaÅ. Hidden: meaning."), and
// the question if asked; after, the word, the verse window, the meaning
// (the BSB's words, the sense), the verse and related words; Greek and
// Hebrew in their languages. (With LEARN_SPEECH, activating the word
// speaks it.)
crd_access() {
    lang: int = crd_lang;
    code: int = nsstring(if (lang == 0) "el" else "he");
    for l in [crd_new, crd_tr, crd_cap, crd_win, crd_ask, crd_gloss, crd_here, crd_verse,
        crd_meta, crd_rel] msg1(l, sel("setIsAccessibilityElement:"), 0);
    msg1(crd_word, sel("setIsAccessibilityElement:"), 1);
    msg1(crd_word, sel("setAccessibilityTraits:"), if (LEARN_SPEECH) objc_const("UIAccessibilityTraitButton") else objc_const("UIAccessibilityTraitStaticText"));
    msg1(crd_word, sel("setAccessibilityLanguage:"), code);
    fbuf_n = 0;
    if (crd_k >= 0 && cd_kind[crd_k] != CK_WORD) fput_lt(cd_key[crd_k], LF_NAME) else if (crd_k >= 0) fput_lemma(lang,
        cd_key[crd_k], 1) else if (crd_read_w >= 0) {
        form_of(crd_read_w);
        fput_bytes(lforms, wf_b, wf_e)
    }
    if (!crd_checked) fput_str(if (crd_reading >= 0) ". Hidden: transliteration." else ". Hidden: meaning.");
    msg1(crd_word, sel("setAccessibilityLabel:"), fstring());
    if (crd_ask_at == px_at && msg(msg(crd_ask, sel("attributedText")), sel("length")) > 0) msg1(crd_ask,
        sel("setIsAccessibilityElement:"), 1);
    if (crd_checked && crd_reading < 0) {
        msg1(crd_win, sel("setIsAccessibilityElement:"), 1);
        msg1(crd_win, sel("setAccessibilityLanguage:"), code);
        for l in [crd_gloss, crd_here, crd_verse, crd_rel]
            if (msg(msg(l, sel("attributedText")), sel("length")) > 0) msg1(l, sel("setIsAccessibilityElement:"),
                1)
    }
    if (crd_checked && crd_reading >= 0) msg1(crd_tr, sel("setIsAccessibilityElement:"),
        1)
}

// ---- speaking ----
learn_speak_card(_self: int, _cmd: int, _x: int): int {
    crd_speak();
    0
}

// (Only with LEARN_SPEECH: ln_can_speak is false without it.)
crd_speak() {
    if (!crd_active || !ln_can_speak(crd_lang)) return;
    if (crd_k >= 0 && cd_kind[crd_k] != CK_WORD) {
        ln_say_letter(cd_key[crd_k]);
        return
    }
    if (crd_read_w >= 0) {
        form_of(crd_read_w);
        ln_say(crd_lang, lforms, wf_b, wf_e);
        return
    }
    p: int = lex_first(crd_lang == 0, cd_key[crd_k]);
    if (p < 0) return;
    lex_field(p, 0);
    ln_say(crd_lang, llex, lf_b, lf_e)
}

// ---- the toolbar, Check and the judgement ----
crd_toolbar(animated: bool) {
    n: int = 0;
    if (px_step == PX_READ_END) {
        px_items[n] = px_item("Again", "learnReadAgain:", false);
        n = n + 1;
        px_items[n] = px_flex();
        n = n + 1;
        px_items[n] = px_item("Done", "practiceDone:", true);
        n = n + 1;
        msg2(px_vc, sel("setToolbarItems:animated:"), nsarray(px_items, n), if (animated) 1 else 0);
        return
    }
    if (px_step == PX_CARD_DONE) {
        px_judgement(animated);
        return
    }
    if (ln_can_speak(crd_lang)) {
        px_items[n] = px_image_item("speaker.wave.2", "learnSpeakCard:", "Speak");
        n = n + 1
    }
    px_items[n] = px_flex();
    n = n + 1;
    title: str = if (px_step == PX_CARD_NEW || px_step == PX_READ_DONE) "Next" else "Check";
    px_items[n] = px_item(title, "practiceMain:", true);
    n = n + 1;
    msg2(px_vc, sel("setToolbarItems:animated:"), nsarray(px_items, n), if (animated) 1 else 0)
}

// The main button: Next (a new card's first showing, a word read), or
// Check.
crd_main() {
    if (px_step == PX_CARD_NEW || px_step == PX_READ_DONE) {
        crd_next();
        return
    }
    crd_check()
}

// Check: the answer cross-fades into its kept space; then the judgement
// (reading: the transliteration, and Next; nothing said).
crd_check() {
    if (px_step != PX_CARD && px_step != PX_READ) return;
    crd_checked = true;
    if (!reduce_motion()) fade_layer(msg(crd_scroll, sel("layer")), 0.2f64);
    crd_fill();
    if (px_step == PX_READ) {
        px_step = PX_READ_DONE;
        if (LEARN_SPEECH) crd_speak()
    } else px_step = PX_CARD_DONE;
    px_toolbar(true);
    crd_log();
    crd_log_answer()
}

// "bible: learn answer G3004 â€œsaysâ€, here: to say, related G2036 G5346".
crd_log_answer() {
    if (!diag_on || crd_k < 0 || cd_kind[crd_k] != CK_WORD) return;
    fbuf_n = 0;
    fput_str("bible: learn answer ");
    fput_card_key(crd_k);
    fput_str(" \â\€\œ");
    if (!fput_words_here(crd_vi, crd_w)) fput_str("\â\€\”");
    fput_str("\â\€\");
    n0: int = fbuf_n;
    fput_str(", ");
    if (fput_sense_here(crd_vi, crd_w)) {
        // ("Here: x" as "here: x".)
        fbuf[n0 + 2] = 104i8
    } else fbuf_n = n0;
    learn_related_known(crd_lang, cd_key[crd_k]);
    fput_str(", related");
    if (rk_n == 0) fput_str(" none");
    for x in 0..rk_n {
        fput(32);
        fput(if (crd_lang == 0) 71 else 72);
        fput_int(rk_num[x])
    }
    note_ns(fstring())
}

// A judgement: kept, logged; Not Yet's card once more at the end.
crd_grade(g: int) {
    if (px_step != PX_CARD_DONE || crd_k < 0) return;
    k: int = crd_k;
    ret: int = if (px_back[px_at]) RET_RETRY else crd_ret[px_at];
    next: int = learn_judged(k, g, ret, today(), time(0), crd_vi);
    cards_changed();
    haptic_select();
    if (next == RET_RETRY && px_qn < len(px_q)) {
        px_q[px_qn] = -k - 1;
        px_back[px_qn] = true;
        crd_ret[px_qn] = RET_RETRY;
        px_qn = px_qn + 1
    }
    crd_next()
}

// Each queued item's kind of return (RET_FIRST, RET_NEW, RET_RETRY), set
// as it is queued; px_open's queue all first showings.
crd_ret: []int = new int[512](0);

crd_open(n: int) {
    crd_ask_at = -1;
    for x in 0..n
        if (x < len(crd_ret)) crd_ret[x] = RET_FIRST
}

// On: the next item cross-fades in (a passage, a card, a word), or the
// end.
crd_next() {
    msg1(px_line, sel("setText:"), 0);
    crd_hint = false;
    if (crd_reading >= 0 && px_at + 1 >= px_qn) {
        crd_reading_end();
        return
    }
    px_next_passage()
}

// What a grade would do, under the finger.
crd_touch(g: int) {
    if (crd_k < 0) return;
    fbuf_n = 0;
    fput_card_would(crd_k, g, today());
    msg1(px_line, sel("setText:"), fstring());
    if (!reduce_motion()) fade_layer(msg(px_line, sel("layer")), 0.15f64);
    px_line_on = true;
    note_ns(fstring())
}

// The card's views away (a passage shown, or the end).
crd_hide() {
    crd_active = false;
    if (crd_scroll != 0) msg1(crd_scroll, sel("setHidden:"), 1);
    if (px_seg != 0) {
        if (!reduce_motion()) fade_layer(msg(px_seg, sel("layer")), 0.2f64);
        msg_set_f(px_seg, sel("setAlpha:"), 1.0f64)
    }
}

// ---- opening ----
// A language's cards due today (from its page, its Today row, Your Words).
practice_open_cards(lang: int, _all: bool) {
    ensure_learn_lang();
    cd_today(today());
    n: int = 0;
    for x in 0..ct_n {
        k: int = ct[x];
        if (cd_lang[k] == lang && n < len(px_q)) {
            px_q[n] = -k - 1;
            px_back[n] = false;
            n = n + 1
        }
    }
    px_open(n)
}

// Today's cards after today's passages (the Library's Practice).
practice_add_cards(n: int): int {
    if (cd_n == 0) return n;
    ensure_learn_lang();
    cd_today(today());
    m: int = n;
    for x in 0..ct_n {
        if (m < len(px_q)) {
            px_q[m] = -ct[x] - 1;
            px_back[m] = false;
            m = m + 1
        }
    }
    m
}

// Practise Reading: ten words (Â§14.3.3).
practice_open_reading(lang: int) {
    ensure_learn_lang();
    crd_reading = lang;
    crd_round = 0;
    n: int = crd_reading_queue();
    note_num("bible: learn practise reading, words ", n);
    px_open(n)
}

crd_reading_queue(): int {
    learn_reading_words(crd_reading, crd_round * 10, time(0));
    if (pr_n == 0 && crd_round > 0) {
        crd_round = 0;
        learn_reading_words(crd_reading, 0, time(0))
    }
    for x in 0..pr_n {
        px_q[x] = -pr_w[x] - READ_CODE;
        px_back[x] = false;
        crd_ret[x] = RET_FIRST
    }
    pr_n
}

// "That's 10 words. Again?"
crd_reading_end() {
    crd_hide();
    px_step = PX_READ_END;
    msg1(px_tv, sel("setHidden:"), 1);
    msg_set_f(px_seg, sel("setAlpha:"), 0.0f64);
    msg1(px_count, sel("setText:"), 0);
    msg1(px_end, sel("setHidden:"), 0);
    msg1(px_end_top, sel("setFont:"), body(em));
    msg1(px_end_top, sel("setTextColor:"), c_ink);
    fbuf_n = 0;
    fput_str("That\â\€\™s ");
    fput_int(px_qn);
    fput_str(if (px_qn == 1) " word. Again?" else " words. Again?");
    msg1(px_end_top, sel("setText:"), fstring());
    msg1(px_end_bottom, sel("setText:"), 0);
    note_ns(fstring());
    px_toolbar(true)
}

learn_read_again(_self: int, _cmd: int, _b: int): int {
    crd_round = crd_round + 1;
    px_qn = crd_reading_queue();
    px_at = 0;
    if (!reduce_motion()) fade_layer(msg(msg(px_vc, sel("view")), sel("layer")), 0.25f64);
    px_begin();
    px_toolbar(true);
    0
}

// The sheet gone: the reading ended, the views let go.
crd_forget() {
    crd_active = false;
    crd_reading = -1;
    crd_k = -1;
    crd_scroll = held(crd_scroll, 0);
    crd_new = 0;
    crd_word = 0;
    crd_tr = 0;
    crd_cap = 0;
    crd_win = 0;
    crd_ask = 0;
    crd_gloss = 0;
    crd_here = 0;
    crd_verse = 0;
    crd_meta = 0;
    crd_rel = 0
}

style_cards() {
    if (crd_scroll == 0) return;
    msg1(crd_scroll, sel("setBackgroundColor:"), c_bg);
    if (crd_active) crd_fill()
}

make_card_classes() { }

add_card_methods(app: int) {
    add_method1(app, sel("learnSpeakCard:"), &learn_speak_card, "v@:@");
    add_method1(app, sel("learnReadAgain:"), &learn_read_again, "v@:@")
}
