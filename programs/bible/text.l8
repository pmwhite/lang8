tag bible;

use_tag std;

// The Berean Standard Bible as the app reads it: data/bsb.txt (made by
// tools/bsb.py), held whole, indexed by book and chapter, and a chapter laid
// out as runs of text, each in one style, for the platform to draw (on an
// iPhone, ios.l8 makes each run an attributed string).
//
// The text is one record a line, its first letter saying what it is (see
// tools/bsb.py): B a book, C a chapter, S s headings, R the passages a
// heading points to, D a psalm's title, M m a major section and its range,
// A an acrostic letter, P a paragraph (and its kind), _ a break between
// stanzas, V a verse, T words (W the words of Jesus, laid out as T), F a
// footnote (d: a psalm's title going on after a footnote in it).
bsb: []i8 = new i8[1](0i8);

bsb_n: int = 0;

// Books: where each one's B line is, its first chapter (counting through
// the Bible from 0), and how many chapters it has.
books: int = 0;

book_line: []int = new int[66](0);

book_first: []int = new int[66](0);

book_count: []int = new int[66](0);

// Chapters: their records (from after the C line to the next C or B line),
// their book, and their number in it.
chapters: int = 0;

ch_start: []int = new int[1200](0);

ch_end: []int = new int[1200](0);

ch_book: []int = new int[1200](0);

ch_num: []int = new int[1200](0);

// How many verses each chapter has (its last verse's number).
ch_verses: []int = new int[1200](0);

// Where the line at p ends (its newline, or the end).
line_end(p: int): int {
    e: int = p;
    while (e < bsb_n && bsb[e] as int != 10) e = e + 1;
    e
}

// The number at p, up to the line's end.
number_at(p: int): int {
    n: int = 0;
    i: int = p;
    while (i < bsb_n && bsb[i] as int >= 48 && bsb[i] as int <= 57) {
        n = n * 10 + bsb[i] as int - 48;
        i = i + 1
    }
    n
}

// The books and chapters of the first n bytes of bsb.
bible_index(n: int) {
    bsb_n = n;
    books = 0;
    chapters = 0;
    p: int = 0;
    while (p < n) {
        e: int = line_end(p);
        k: int = bsb[p] as int;
        if ((k == 66 || k == 67) && chapters > 0) ch_end[chapters - 1] = p;
        if (k == 66 && books < 66) {
            book_line[books] = p;
            book_first[books] = chapters;
            book_count[books] = 0;
            books = books + 1
        }
        if (k == 67 && books > 0 && chapters < len(ch_start)) {
            ch_start[chapters] = e + 1;
            ch_end[chapters] = n;
            ch_book[chapters] = books - 1;
            ch_num[chapters] = number_at(p + 1);
            ch_verses[chapters] = 0;
            book_count[books - 1] = book_count[books - 1] + 1;
            chapters = chapters + 1
        }
        if (k == 86 && chapters > 0) {
            v: int = number_at(p + 1);
            if (v > ch_verses[chapters - 1]) ch_verses[chapters - 1] = v
        }
        p = e + 1
    }
}

// A book's name: where it starts in bsb, and where it ends.
book_name_start(b: int): int {
    book_line[b] + 5
}

book_name_end(b: int): int {
    line_end(book_line[b])
}

// Whether book b's code (GEN, PSA) is code.
book_is(b: int, code: str): bool {
    p: int = book_line[b] + 1;
    for i in 0..3
        if (bsb[p + i] != code[i]) return false;
    true
}

// ---- a chapter as runs ----
// Each run is text in out, in one style, in a paragraph of one kind.
STYLE_BODY: int = 0;

STYLE_VERSE: int = 1;

// A book's name, heading its first chapter.
STYLE_BOOK: int = 2;

// A chapter's number (but chapter 1's, STYLE_NUMERAL1).
STYLE_NUMERAL: int = 3;

STYLE_HEAD: int = 4;

STYLE_SUBHEAD: int = 5;

STYLE_REF: int = 6;

STYLE_TITLE: int = 7;

STYLE_MAJOR: int = 8;

STYLE_RANGE: int = 9;

STYLE_ACROSTIC: int = 10;

STYLE_NOTE: int = 11;

// The chapter's label over its number: the book's name in capitals (JOHN),
// or PSALM.
STYLE_BOOKLABEL: int = 12;

// The capitals after the first of LORD and GOD (the divine name, in the
// BSB's capitals), set as small capitals.
STYLE_CAPS: int = 13;

// The divider between chapters: one object replacement character (U+FFFC),
// which the platform draws as a short hairline.
STYLE_RULE: int = 14;

// Chapter 1's number, under its book's name (smaller than the others).
STYLE_NUMERAL1: int = 15;

STYLES: int = 16;

// Paragraph kinds: prose, poetry's two indents, a list's two, centered and
// to the right, and a verse on a line of its own; with a stanza's break
// before it, the kind plus KINDS.
PARA_PROSE: int = 0;

PARA_Q1: int = 1;

PARA_Q2: int = 2;

PARA_L1: int = 3;

PARA_L2: int = 4;

PARA_CENTER: int = 5;

PARA_RIGHT: int = 6;

PARA_VERSE: int = 7;

KINDS: int = 8;

out: []i8 = new i8[262144](0i8);

out_n: int = 0;

runs: int = 0;

run_end: []int = new int[8192](0);

run_style: []int = new int[8192](0);

run_para: []int = new int[8192](0);

// For a footnote's mark, where its F line is in bsb.
run_arg: []int = new int[8192](0);

// What the layout shows: verses' numbers, headings (S s R D M m),
// footnotes' marks, and each verse on a line of its own.
lay_verse_numbers: bool = true;

lay_headings: bool = true;

lay_notes: bool = true;

lay_verse_lines: bool = false;

// The verses of the chapter laid out: their numbers, and where each is in
// out, from its number (or its first word, if it has no number shown) to the
// end of its last words or footnote's mark.
verse_count: int = 0;

verse_num: []int = new int[200](0);

verse_begin: []int = new int[200](0);

verse_end: []int = new int[200](0);

// Where the chapter's number is in out (or its book's name, for a book of
// one chapter): the end of its heading.
opener_at: int = 0;

// What a chapter's runs are now being added in.
lay_style: int = 0;

lay_para: int = 0;

// A run begins (or the last goes on, if it is the same).
lay_begin(style: int, para: int, arg: int) {
    if (runs > 0 && run_style[runs - 1] == style && run_para[runs - 1] == para && style != STYLE_NOTE) {
        lay_style = style;
        lay_para = para;
        return
    }
    if (runs >= len(run_end)) return;
    run_end[runs] = out_n;
    run_style[runs] = style;
    run_para[runs] = para;
    run_arg[runs] = arg;
    runs = runs + 1;
    lay_style = style;
    lay_para = para
}

lay_byte(c: int) {
    if (out_n >= len(out) || runs == 0) return;
    out[out_n] = c trunc i8;
    out_n = out_n + 1;
    run_end[runs - 1] = out_n
}

lay_str(s: str) {
    for c in s lay_byte(c as int)
}

// bsb's bytes from p to e.
lay_bytes(p: int, e: int) {
    for i in p..e lay_byte(bsb[i] as int)
}

// bsb's bytes from p to e, in capitals.
lay_upper(p: int, e: int) {
    for i in p..e {
        k: int = bsb[i] as int;
        lay_byte(if (k >= 97 && k <= 122) k - 32 else k)
    }
}

lay_int(n: int) {
    if (n >= 10) lay_int(n / 10);
    lay_byte(48 + n % 10)
}

// Words from bsb's p to e, in a paragraph of kind para: LORD and GOD with
// their capitals after the first as small capitals.
lay_words(p: int, e: int, para: int) {
    lay_begin(STYLE_BODY, para, 0);
    i: int = p;
    while (i < e) {
        n: int = divine_at(i, e);
        if (n > 0) {
            lay_byte(bsb[i] as int);
            lay_begin(STYLE_CAPS, para, 0);
            lay_bytes(i + 1, i + n);
            lay_begin(STYLE_BODY, para, 0);
            i = i + n
        } else {
            lay_byte(bsb[i] as int);
            i = i + 1
        }
    }
}

// How long the divine name at i is (LORD or GOD as a word of its own, or
// before 'S), or 0 if it is not there.
divine_at(i: int, e: int): int {
    if (i > 0 && is_letter(bsb[i - 1] as int)) return 0;
    n: int = 0;
    if (matches_at(i, e, "LORD")) n = 4 else if (matches_at(i, e, "GOD")) n = 3;
    if (n == 0 || i + n < e && is_letter(bsb[i + n] as int)) return 0;
    n
}

matches_at(i: int, e: int, word: str): bool {
    if (i + len(word) > e) return false;
    for k in 0..len(word)
        if (bsb[i + k] != word[k]) return false;
    true
}

is_letter(k: int): bool {
    k >= 65 && k <= 90 || k >= 97 && k <= 122
}

// The byte at b[i], 0 to 255.
ub(b: []i8, i: int): int {
    b[i] as int & 255
}

is_digit(k: int): bool {
    k >= 48 && k <= 57
}

// A narrow space that does not break (U+202F), after a verse's number.
lay_narrow() {
    lay_byte(226);
    lay_byte(128);
    lay_byte(175)
}

// The object replacement character (U+FFFC), for the divider.
lay_object() {
    lay_byte(239);
    lay_byte(191);
    lay_byte(188)
}

// The chapter's name, as the reader is shown it: Genesis 1, Psalm 23, and
// only the book for one of a single chapter.
lay_title(c: int) {
    b: int = ch_book[c];
    if (book_is(b, "PSA")) lay_str("Psalm") else lay_bytes(book_name_start(b), book_name_end(b));
    if (book_count[b] > 1) {
        lay_byte(32);
        lay_int(ch_num[c])
    }
}

// A verse begins (its number v): a row of the verse table.
verse_open(v: int) {
    if (verse_count >= len(verse_num)) return;
    verse_num[verse_count] = v;
    verse_begin[verse_count] = -1;
    verse_end[verse_count] = -1;
    verse_count = verse_count + 1
}

// The verse being laid out begins here, if it has not yet.
verse_here() {
    if (verse_count > 0 && verse_begin[verse_count - 1] < 0) verse_begin[verse_count - 1] = out_n
}

// The verse being laid out goes on to here.
verse_on() {
    if (verse_count > 0) verse_end[verse_count - 1] = out_n
}

is_heading_line(k: int): bool {
    k == 83 || k == 115 || k == 82 || k == 68 || k == 77 || k == 109
}

// Chapter c as runs in out, to read on from the chapter before: a divider
// (but before Genesis 1); its book's name if the book begins here, then its
// number (a book of one chapter has only the name); otherwise its label
// (JOHN, PSALM) over its number; then its headings, paragraphs, verses (each
// numbered but the first, which the chapter's number stands for) and
// footnotes' marks. The verse table says where each verse is.
layout_chapter(c: int) {
    out_n = 0;
    runs = 0;
    verse_count = 0;
    opener_at = 0;
    b: int = ch_book[c];
    first: bool = ch_num[c] == 1;
    single: bool = book_count[b] == 1;
    if (c > 0) {
        lay_begin(STYLE_RULE, PARA_CENTER, 0);
        lay_object();
        lay_byte(10)
    }
    if (first) {
        lay_begin(STYLE_BOOK, PARA_CENTER, 0);
        opener_at = out_n;
        lay_bytes(book_name_start(b), book_name_end(b));
        lay_byte(10)
    }
    // (A major section, as Psalms' BOOK I, comes before the chapter it
    // begins with.)
    p: int = ch_start[c];
    while (p < ch_end[c] && (bsb[p] as int == 77 || bsb[p] as int == 109)) {
        e: int = line_end(p);
        if (lay_headings) {
            lay_begin(if (bsb[p] as int == 77) STYLE_MAJOR else STYLE_RANGE, PARA_CENTER,
                0);
            lay_bytes(p + 1, e);
            lay_byte(10)
        }
        p = e + 1
    }
    if (!first) {
        lay_begin(STYLE_BOOKLABEL, PARA_CENTER, 0);
        if (book_is(b, "PSA")) lay_str("PSALM") else lay_upper(book_name_start(b),
            book_name_end(b));
        lay_byte(10)
    }
    if (!single) {
        lay_begin(if (first) STYLE_NUMERAL1 else STYLE_NUMERAL, PARA_CENTER, 0);
        opener_at = out_n;
        lay_int(ch_num[c]);
        lay_byte(10)
    }
    // In a paragraph (and it has words), of what kind; a stanza's break
    // before the next; just after a heading; footnotes so far.
    open: bool = false;
    words: bool = false;
    kind: int = PARA_PROSE;
    gap: bool = false;
    headed: bool = true;
    notes: int = 0;
    lines: bool = lay_verse_lines;
    // In a psalm's title (which a footnote's mark may be inside).
    in_title: bool = false;
    e_ch: int = ch_end[c];
    while (p < e_ch) {
        e: int = line_end(p);
        k: int = bsb[p] as int;
        if (k == 87) k = 84;
        if (in_title && k != 70 && k != 100) {
            if (lay_headings) lay_byte(10);
            in_title = false
        }
        if (in_title) {
            // A footnote's mark in the title, or the title going on.
            if (k == 70 && lay_notes && lay_headings) {
                lay_begin(STYLE_NOTE, PARA_PROSE, p);
                lay_byte(97 + notes % 26);
                notes = notes + 1
            } else if (k == 100 && lay_headings) {
                lay_begin(STYLE_TITLE, PARA_PROSE, 0);
                lay_bytes(p + 1, e)
            }
        } else if (k == 80) {
            // P: a paragraph (in verses on lines of their own, only poetry's
            // and lists' lines break; prose runs on).
            m: int = bsb[p + 1] as int;
            pk: int = if (m == 49) PARA_Q1 else if (m == 50) PARA_Q2 else if (m == 108) PARA_L1 else if (m == 76) PARA_L2 else if (m == 99) PARA_CENTER else if (m == 114) PARA_RIGHT else PARA_PROSE;
            if (!lines || pk >= PARA_Q1 && pk <= PARA_L2) {
                if (open && words) lay_byte(10);
                open = true;
                words = false;
                kind = pk
            } else if (open && words) {
                lay_begin(STYLE_BODY, kind, 0);
                lay_byte(32)
            }
        } else if (k == 95) {
            // _: a stanza's break (none after a heading, which has its own space).
            if (!headed) gap = true
        } else if (k == 86 || k == 84 || k == 70) {
            if (!open) {
                open = true;
                words = false
            }
            if (k == 86) {
                // V: a verse's number (not the first's, but on a line of its
                // own).
                v: int = number_at(p + 1);
                verse_open(v);
                if (lines) {
                    if (words) lay_byte(10);
                    words = false;
                    kind = PARA_VERSE
                }
                para: int = kind + (if (gap && !words) KINDS else 0);
                if (words) {
                    lay_begin(STYLE_BODY, para, 0);
                    lay_byte(32)
                }
                if (lines) {
                    // (On a line of its own: the number right-aligned in
                    // the margin, between two tabs; the verse begins at its
                    // words.)
                    lay_begin(STYLE_VERSE, para, 0);
                    lay_byte(9);
                    if (lay_verse_numbers) lay_int(v);
                    lay_byte(9)
                } else if (lay_verse_numbers && v != 1) {
                    lay_begin(STYLE_VERSE, para, 0);
                    verse_here();
                    lay_int(v);
                    lay_narrow()
                }
            } else if (k == 84) {
                // T: words.
                para: int = kind + (if (gap && !words) KINDS else 0);
                lay_begin(STYLE_BODY, para, 0);
                verse_here();
                lay_words(p + 1, e, para);
                verse_on();
                words = true;
                gap = false;
                headed = false
            } else if (lay_notes) {
                // F: a footnote's mark (a to z, then again).
                para: int = kind + (if (gap && !words) KINDS else 0);
                lay_begin(STYLE_NOTE, para, p);
                lay_byte(97 + notes % 26);
                notes = notes + 1;
                verse_on()
            }
        } else {
            // A heading of some kind, on a line of its own.
            style: int = if (k == 83) STYLE_HEAD else if (k == 115) STYLE_SUBHEAD else if (k == 82) STYLE_REF else if (k == 68) STYLE_TITLE else if (k == 77) STYLE_MAJOR else if (k == 109) STYLE_RANGE else if (k == 65) STYLE_ACROSTIC else -1;
            if (style >= 0 && (lay_headings || !is_heading_line(k))) {
                if (open && words) lay_byte(10);
                open = false;
                words = false;
                gap = false;
                headed = true;
                lay_begin(style, if (style == STYLE_MAJOR || style == STYLE_RANGE) PARA_CENTER else PARA_PROSE,
                    0);
                lay_bytes(p + 1, e);
                // (A title's line ends after any footnote in it.)
                if (style == STYLE_TITLE) in_title = true else lay_byte(10)
            } else if (style == STYLE_TITLE) in_title = true
        }
        p = e + 1
    }
    if (in_title && lay_headings) lay_byte(10);
    if (open && words) lay_byte(10)
}

// The chapter's name (lay_title) by itself in out, as one run.
title_of(c: int) {
    out_n = 0;
    runs = 0;
    lay_begin(STYLE_BODY, PARA_PROSE, 0);
    lay_title(c)
}

// The chapter of book b numbered n (or its first or last, past either end).
chapter_of(b: int, n: int): int {
    if (n < 1) return book_first[b];
    if (n > book_count[b]) return book_first[b] + book_count[b] - 1;
    book_first[b] + n - 1
}

// The index in the verse table of verse v (or the nearest before it; 0).
verse_index(v: int): int {
    best: int = 0;
    for i in 0..verse_count
        if (verse_num[i] <= v) best = i;
    best
}

// ---- verses as plain text ----
// The verse a record of a chapter is in (its V line before p; 0 before
// the first).
verse_at(c: int, p: int): int {
    v: int = 0;
    q: int = ch_start[c];
    while (q < p && q < ch_end[c]) {
        e: int = line_end(q);
        if (bsb[q] as int == 86) v = number_at(q + 1);
        q = e + 1
    }
    v
}

// A verse's words, without its notes: its lines joined (with a space where
// a line of poetry or a paragraph broke them).
vt: []i8 = new i8[16384](0i8);

vt_n: int = 0;

vt_add(k: int) {
    if (vt_n < len(vt)) {
        vt[vt_n] = k trunc i8;
        vt_n = vt_n + 1
    }
}

// Verse v of chapter c into vt: how long it is.
verse_text(c: int, v: int): int {
    vt_n = 0;
    p: int = ch_start[c];
    e_ch: int = ch_end[c];
    inside: bool = false;
    broke: bool = false;
    while (p < e_ch) {
        e: int = line_end(p);
        k: int = bsb[p] as int;
        if (k == 86) {
            n: int = number_at(p + 1);
            if (inside) {
                // The verse after it: done.
                e = e_ch;
                inside = false
            } else if (n == v) inside = true
        } else if (inside) {
            if (k == 84 || k == 87) {
                vt_words(p + 1, e, broke);
                broke = false
            } else if (k != 70) broke = true
        }
        p = e + 1
    }
    vt_n
}

// A T line's words onto vt (after a space, if a line broke before them).
vt_words(p: int, e: int, broke: bool) {
    if (broke && vt_n > 0 && vt[vt_n - 1] as int != 32 && p < e && bsb[p] as int != 32) vt_add(32);
    for i in p..e vt_add(bsb[i] as int)
}

// ---- references: "jn 3:16" ----
// The books' names and short names: a line each, in the books' order, the
// first its full name (lower case, no spaces), the rest what else it may be
// called.
aliases: str = """
genesis gen gn ge
exodus exo ex exod
leviticus lev lv le
numbers num nm nu nb
deuteronomy deut deu dt de
joshua josh jos js
judges judg jdg jg jgs
ruth rut ru rth
1samuel 1sam 1sa 1sm 1s
2samuel 2sam 2sa 2sm 2s
1kings 1kgs 1ki 1kg 1k
2kings 2kgs 2ki 2kg 2k
1chronicles 1chr 1ch 1chron
2chronicles 2chr 2ch 2chron
ezra ezr
nehemiah neh ne
esther est esth es
job jb
psalms psalm psa ps pss
proverbs prov pro prv pr
ecclesiastes eccl ecc ec qoh
songofsolomon songofsongs song sos sng ss canticles
isaiah isa is
jeremiah jer je jr
lamentations lam la
ezekiel ezek ezk eze
daniel dan da dn
hosea hos ho
joel joe jl jol
amos amo am
obadiah obad oba ob
jonah jon jnh
micah mic mi
nahum nah nam na
habakkuk hab hb
zephaniah zeph zep zp
haggai hag hg
zechariah zech zec zc
malachi mal ml
matthew matt mat mt
mark mrk mk mr
luke luk lk
john jhn jn joh
acts act ac
romans rom ro rm
1corinthians 1cor 1co
2corinthians 2cor 2co
galatians gal ga
ephesians eph ep
philippians phil php pp
colossians col
1thessalonians 1thess 1thes 1th
2thessalonians 2thess 2thes 2th
1timothy 1tim 1ti 1tm
2timothy 2tim 2ti 2tm
titus tit ti
philemon philem phm pm
hebrews heb he
james jas jm
1peter 1pet 1pe 1pt
2peter 2pet 2pe 2pt
1john 1jn 1jo 1jhn 1joh
2john 2jn 2jo 2jhn 2joh
3john 3jn 3jo 3jhn 3joh
jude jd
revelation rev re rv revelations
""";

// Where each book's line of aliases starts (made once).
alias_line: []int = new int[67](0);

alias_ready: bool = false;

alias_index() {
    if (alias_ready) return;
    alias_ready = true;
    b: int = 0;
    alias_line[0] = 0;
    for i in 0..len(aliases) {
        if (aliases[i] as int == 10 && b < 66) {
            b = b + 1;
            alias_line[b] = i + 1
        }
    }
}

// What parse_ref found: the book (an index), chapter, verse and last verse
// (numbers; -1 where not given).
ref_book: int = -1;

ref_chapter: int = -1;

ref_verse: int = -1;

ref_verse_end: int = -1;

// The text being parsed, made plain: lower case, single spaces.
rq: []i8 = new i8[256](0i8);

rq_n: int = 0;

rq_add(k: int) {
    if (rq_n < len(rq)) {
        rq[rq_n] = k trunc i8;
        rq_n = rq_n + 1
    }
}

// The book's name as typed (no spaces).
rname: []i8 = new i8[64](0i8);

rname_n: int = 0;

// s's first n bytes as plain text in rq: lower case; periods as spaces; a
// dash of any length as -; spaces single, and none at either end.
ref_plain(s: []i8, n: int) {
    rq_n = 0;
    i: int = 0;
    while (i < n) {
        k: int = ub(s, i);
        if (k == 226 && i + 2 < n && ub(s, i + 1) == 128 && (ub(s, i + 2) == 147 || ub(s,
            i + 2) == 148)) {
            k = 45;
            i = i + 2
        }
        if (k >= 65 && k <= 90) k = k + 32;
        if (k == 46 || k == 44 || k == 9) k = 32;
        if (k == 32) {
            if (rq_n > 0 && rq[rq_n - 1] as int != 32) rq_add(32)
        } else rq_add(k);
        i = i + 1
    }
    if (rq_n > 0 && rq[rq_n - 1] as int == 32) rq_n = rq_n - 1
}

// Whether rq begins with word (then a space).
rq_starts(word: str): bool {
    if (rq_n <= len(word)) return false;
    for i in 0..len(word)
        if (rq[i] != word[i]) return false;
    rq[len(word)] as int == 32
}

// Whether the alias at aliases[a] (to a space or newline) is rname.
alias_is(a: int): bool {
    for i in 0..rname_n
        if (a + i >= len(aliases) || aliases[a + i] != rname[i]) return false;
    k: int = if (a + rname_n < len(aliases)) aliases[a + rname_n] as int else 10;
    k == 32 || k == 10
}

// Whether rname begins the alias at aliases[a].
alias_begins(a: int): bool {
    for i in 0..rname_n {
        if (a + i >= len(aliases)) return false;
        k: int = aliases[a + i] as int;
        if (k == 32 || k == 10 || k != rname[i] as int) return false
    }
    true
}

// The book rname names: an alias of it exactly, or else the first book whose
// full name begins with it (-1 if none).
book_named(): int {
    alias_index();
    if (rname_n == 0) return -1;
    b: int = 0;
    at_word: bool = true;
    for a in 0..len(aliases) {
        if (at_word && alias_is(a)) return b;
        k: int = aliases[a] as int;
        if (k == 10) b = b + 1;
        at_word = k == 32 || k == 10
    }
    for x in 0..66
        if (alias_begins(alias_line[x])) return x;
    -1
}

// Whether book b's name, or one of its short names, begins with the first n
// bytes of s (case and spaces aside): "1 c" is 1 Chronicles and 1
// Corinthians.
book_begins(b: int, s: []i8, n: int): bool {
    alias_index();
    rname_n = 0;
    for i in 0..n {
        k: int = s[i] as int;
        if (k >= 65 && k <= 90) k = k + 32;
        if (k != 32 && k != 46 && rname_n < len(rname)) {
            rname[rname_n] = k trunc i8;
            rname_n = rname_n + 1
        }
    }
    if (rname_n == 0) return false;
    alias_begins(alias_line[b]) || book_alias_exact(b)
}

// Whether rname (as book_begins left it) is one of book b's short names
// exactly.
book_alias_exact(b: int): bool {
    a: int = alias_line[b];
    e: int = if (b == 65) len(aliases) else alias_line[b + 1];
    at_word: bool = true;
    while (a < e) {
        if (at_word && alias_is(a)) return true;
        k: int = aliases[a] as int;
        at_word = k == 32;
        a = a + 1
    }
    false
}

// A short name for book b, for a narrow place (its first short name of
// six letters or fewer, as "1 Thess", "Song"), into short_name.
short_name: []i8 = new i8[16](0i8);

short_n: int = 0;

book_short(b: int) {
    alias_index();
    a: int = alias_line[b];
    e: int = if (b == 65) len(aliases) else alias_line[b + 1];
    // (Past the full name.)
    while (a < e && aliases[a] as int != 32) a = a + 1;
    short_n = 0;
    while (a < e && short_n == 0) {
        a = a + 1;
        w: int = a;
        while (w < e && aliases[w] as int != 32 && aliases[w] as int != 10) w = w + 1;
        if (w - a <= 6 && w > a) {
            for i in a..w {
                k: int = aliases[i] as int;
                first: bool = i == a || i == a + 1 && is_digit(aliases[a] as int);
                if (i == a + 1 && is_digit(aliases[a] as int)) {
                    short_name[short_n] = 32i8;
                    short_n = short_n + 1
                }
                short_name[short_n] = (if (first && k >= 97) k - 32 else k) trunc i8;
                short_n = short_n + 1
            }
        }
        a = w
    }
}

// A reference typed freely ("jn 3:16", "1 cor 13", "psa23", "gen 1:1-3"),
// the first n bytes of s: ref_book and the rest, and whether it named a
// book. A chapter past the book's end is its last; a verse past the
// chapter's, its last; a book of one chapter takes a lone number as a verse.
parse_ref(s: []i8, n: int): bool {
    ref_book = -1;
    ref_chapter = -1;
    ref_verse = -1;
    ref_verse_end = -1;
    ref_plain(s, n);
    i: int = 0;
    rname_n = 0;
    // "first", "ii" and so on before the book's name.
    lead: int = 0;
    if (rq_starts("first") || rq_starts("1st")) {
        lead = 1;
        i = (if (rq_starts("first")) 6 else 4)
    } else if (rq_starts("second") || rq_starts("2nd")) {
        lead = 2;
        i = (if (rq_starts("second")) 7 else 4)
    } else if (rq_starts("third") || rq_starts("3rd")) {
        lead = 3;
        i = (if (rq_starts("third")) 6 else 4)
    } else if (rq_starts("iii")) {
        lead = 3;
        i = 4
    } else if (rq_starts("ii")) {
        lead = 2;
        i = 3
    } else if (rq_starts("i")) {
        lead = 1;
        i = 2
    } else if (rq_n >= 2 && rq[0] as int >= 49 && rq[0] as int <= 51 && (is_letter(rq[1] as int) || rq_n >= 3 && rq[1] as int == 32 && is_letter(rq[2] as int))) {
        lead = rq[0] as int - 48;
        i = (if (rq[1] as int == 32) 2 else 1)
    }
    if (lead > 0) {
        rname[0] = (48 + lead) trunc i8;
        rname_n = 1
    }
    // The name: letters (and the spaces between its words), to a number.
    while (i < rq_n && (is_letter(rq[i] as int) || rq[i] as int == 32 && i + 1 < rq_n && is_letter(rq[i + 1] as int))) {
        if (rq[i] as int != 32 && rname_n < len(rname)) {
            rname[rname_n] = rq[i];
            rname_n = rname_n + 1
        }
        i = i + 1
    }
    if (rname_n == 0 || rname_n == 1 && lead > 0) return false;
    b: int = book_named();
    if (b < 0) return false;
    ref_book = b;
    // Up to three numbers, and whether a dash came before each.
    nums: int = 0;
    n1: int = -1;
    n2: int = -1;
    n3: int = -1;
    dash2: bool = false;
    dash: bool = false;
    while (i < rq_n) {
        k: int = rq[i] as int;
        if (k == 45) dash = true;
        if (is_digit(k)) {
            v: int = 0;
            while (i < rq_n && is_digit(rq[i] as int)) {
                if (v < 100000) v = v * 10 + rq[i] as int - 48;
                i = i + 1
            }
            if (nums == 0) n1 = v else if (nums == 1) {
                n2 = v;
                dash2 = dash
            } else if (nums == 2) n3 = v;
            nums = nums + 1;
            dash = false
        } else i = i + 1
    }
    single: bool = book_count[b] == 1;
    if (nums == 0) return true;
    if (single && (nums == 1 || dash2)) {
        // A lone number in a book of one chapter is a verse (and a dash
        // after it, a range of verses).
        ref_chapter = 1;
        ref_verse = n1;
        if (dash2) ref_verse_end = n2
    } else {
        ref_chapter = n1;
        if (nums >= 2 && !dash2) {
            ref_verse = n2;
            if (nums >= 3) ref_verse_end = n3
        }
    }
    if (ref_chapter < 1) ref_chapter = 1;
    if (ref_chapter > book_count[b]) ref_chapter = book_count[b];
    if (ref_verse >= 0) {
        last: int = ch_verses[book_first[b] + ref_chapter - 1];
        if (ref_verse < 1) ref_verse = 1;
        if (ref_verse > last) ref_verse = last;
        if (ref_verse_end > last) ref_verse_end = last;
        if (ref_verse_end <= ref_verse) ref_verse_end = -1
    }
    true
}

// ---- search ----
// The words searched for (lower case, ’ as '), each with whether it may be
// the start of a longer word (typed with * after it); and whether they are a
// phrase (typed in quotes), to be found together and in order.
sq: []i8 = new i8[512](0i8);

sq_n: int = 0;

sq_words: int = 0;

sq_start: []int = new int[16](0);

sq_len: []int = new int[16](0);

sq_prefix: []bool = new bool[16](false);

sq_phrase: bool = false;

// The verses found (chapter and verse), as many as fit, and whether there
// were more.
hit_chapter: []int = new int[1000](0);

hit_verse: []int = new int[1000](0);

hit_count: int = 0;

hit_more: bool = false;

// The words of the first n bytes of s, to search for.
search_words(s: []i8, n: int) {
    sq_n = 0;
    sq_words = 0;
    sq_phrase = false;
    i: int = 0;
    in_word: bool = false;
    while (i < n) {
        k: int = ub(s, i);
        step: int = 1;
        if (k == 226 && i + 2 < n && ub(s, i + 1) == 128) {
            m: int = ub(s, i + 2);
            step = 3;
            k = (if (m == 152 || m == 153) 39 else if (m == 156 || m == 157) 34 else 32)
        }
        if (k == 34) sq_phrase = true;
        if (k >= 65 && k <= 90) k = k + 32;
        word: bool = is_letter(k) || is_digit(k) || k == 39 || k >= 128;
        if (word) {
            if (!in_word && sq_words < len(sq_start) && sq_n < len(sq)) {
                sq_start[sq_words] = sq_n;
                sq_len[sq_words] = 0;
                sq_prefix[sq_words] = false;
                sq_words = sq_words + 1;
                in_word = true
            }
            if (in_word && sq_n < len(sq)) {
                sq[sq_n] = k trunc i8;
                sq_n = sq_n + 1;
                sq_len[sq_words - 1] = sq_len[sq_words - 1] + 1
            }
        } else {
            if (k == 42 && in_word) sq_prefix[sq_words - 1] = true;
            in_word = false
        }
        i = i + step
    }
    // (A word of apostrophes alone is none.)
    if (sq_words == 1 && sq_phrase) sq_phrase = false
}

// Whether the byte at vt[i] begins a character of a word (a letter or a
// digit; not punctuation, as ’ and “).
vt_wordy(i: int): bool {
    if (i < 0 || i >= vt_n) return false;
    k: int = ub(vt, i);
    if (k < 128) return is_letter(k) || is_digit(k);
    if (k >= 128 && k < 192) {
        // (Part of a character: the character it is part of.)
        j: int = i;
        while (j > 0 && ub(vt, j) >= 128 && ub(vt, j) < 192) j = j - 1;
        return vt_wordy(j) && j != i
    }
    k != 226
}

// Whether the character before vt[i] is of a word.
vt_wordy_before(i: int): bool {
    if (i <= 0) return false;
    j: int = i - 1;
    while (j > 0 && ub(vt, j) >= 128 && ub(vt, j) < 192) j = j - 1;
    vt_wordy(j)
}

// Search word w at vt[i]: where it ends in vt, or -1 if it is not there (a
// whole word, unless it may begin one).
word_at(w: int, i: int): int {
    if (vt_wordy_before(i)) return -1;
    j: int = i;
    s: int = sq_start[w];
    for x in 0..sq_len[w] {
        q: int = sq[s + x] as int;
        if (j >= vt_n) return -1;
        k: int = ub(vt, j);
        if (q == 39 && k == 226 && j + 2 < vt_n && ub(vt, j + 2) == 153) j = j + 3 else {
            if (k >= 65 && k <= 90) k = k + 32;
            if (k != q) return -1;
            j = j + 1
        }
    }
    if (!sq_prefix[w] && vt_wordy(j)) return -1;
    // (A word typed with * goes on to its end.)
    while (sq_prefix[w] && vt_wordy(j)) j = j + 1;
    j
}

// Past what is not a word, from vt[i]: where the next word begins.
skip_unwordy(i: int): int {
    j: int = i;
    while (j < vt_n && !vt_wordy(j)) j = j + 1;
    j
}

// The phrase at vt[i]: where it ends, or -1.
phrase_at(i: int): int {
    j: int = i;
    for w in 0..sq_words {
        if (w > 0) {
            k: int = skip_unwordy(j);
            if (k == j) return -1;
            j = k
        }
        j = word_at(w, j);
        if (j < 0) return -1
    }
    j
}

// Where the search (one word, or the phrase) is in vt at or after i: its
// start, or -1; and its end, in found_end.
found_end: int = 0;

find_from(w: int, i: int): int {
    for j in i..vt_n {
        e: int = if (sq_phrase) phrase_at(j) else word_at(w, j);
        if (e >= 0) {
            found_end = e;
            return j
        }
    }
    -1
}

// Whether the verse in vt is one the search finds.
vt_found(): bool {
    if (sq_words == 0) return false;
    if (sq_phrase) return find_from(0, 0) >= 0;
    for w in 0..sq_words
        if (find_from(w, 0) < 0) return false;
    true
}

// The verses of books from to last (inclusive) with every word of query (the
// first n bytes of q), in order: hit_chapter and the rest.
search(
    q: []i8,
    n: int,
    from: int,
    last: int
) {
    hit_count = 0;
    hit_more = false;
    search_words(q, n);
    if (sq_words == 0) return;
    c: int = book_first[from];
    e_c: int = book_first[last] + book_count[last];
    while (c < e_c && !hit_more) {
        search_chapter(c);
        c = c + 1
    }
}

// The verses of chapter c the search finds, onto the hits.
search_chapter(c: int) {
    p: int = ch_start[c];
    e_ch: int = ch_end[c];
    v: int = 0;
    broke: bool = false;
    vt_n = 0;
    while (p < e_ch) {
        e: int = line_end(p);
        k: int = bsb[p] as int;
        if (k == 86) {
            if (v > 0) search_verse(c, v);
            v = number_at(p + 1);
            vt_n = 0;
            broke = false
        } else if (k == 84 || k == 87) {
            vt_words(p + 1, e, broke);
            broke = false
        } else if (k != 70) broke = true;
        p = e + 1
    }
    if (v > 0) search_verse(c, v)
}

search_verse(c: int, v: int) {
    if (!vt_found()) return;
    if (hit_count >= len(hit_chapter)) {
        hit_more = true;
        return
    }
    hit_chapter[hit_count] = c;
    hit_verse[hit_count] = v;
    hit_count = hit_count + 1
}

// Where the search is found in verse v of chapter c: its text in vt
// (verse_text), and each place a word (or the phrase) is, in mr_begin and
// mr_end (bytes of vt), in order.
mr_count: int = 0;

mr_begin: []int = new int[64](0);

mr_end: []int = new int[64](0);

match_ranges(c: int, v: int) {
    verse_text(c, v);
    mr_count = 0;
    words: int = if (sq_phrase) 1 else sq_words;
    for w in 0..words {
        i: int = 0;
        while (i >= 0 && i < vt_n) {
            j: int = find_from(w, i);
            if (j >= 0) {
                mr_add(j, found_end);
                i = found_end
            } else i = -1
        }
    }
}

// A place found, kept in order (and not twice).
mr_add(b: int, e: int) {
    if (mr_count >= len(mr_begin)) return;
    at: int = mr_count;
    while (at > 0 && mr_begin[at - 1] > b) at = at - 1;
    if (at > 0 && mr_begin[at - 1] == b) return;
    i: int = mr_count;
    while (i > at) {
        mr_begin[i] = mr_begin[i - 1];
        mr_end[i] = mr_end[i - 1];
        i = i - 1
    }
    mr_begin[at] = b;
    mr_end[at] = e;
    mr_count = mr_count + 1
}
