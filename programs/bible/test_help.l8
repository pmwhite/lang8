tag bible_help_tests;

use_tag std, bible;

// The manual and the quick tips (help.l8, DESIGN.md §15.6, §15.7):
// data/help.txt read and checked (links, anchors, conditions, actions,
// symbols, ids, the house style), a file with every fault the checks find,
// a paragraph's markup, the rule that picks a tip (§15.2.3), the state's
// words, and the Manual's search.
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "help.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

scratch: []i8 = new i8[262144](0i8);

// The real file.
load() noregion {
    fd: int = open("programs/bible/data/help.txt", 0, 0);
    got: int = 0;
    more: bool = fd >= 0;
    while (more && got < len(scratch)) {
        r: int = read(fd, scratch, got, len(scratch) - got);
        if (r <= 0) more = false else got = got + r
    }
    if (fd >= 0) close(fd);
    hlp = new i8[got + 1](0i8);
    for i in 0..got hlp[i] = scratch[i];
    hlp_n = got;
    help_index();
    help_state_clear()
}

// A file of the test's own.
load_own(s: str) noregion {
    hlp = new i8[len(s) + 1](0i8);
    for i in 0..len(s) hlp[i] = s[i];
    hlp_n = len(s);
    help_index();
    help_state_clear()
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

show_bytes(b: int, e: int) raises IoError {
    write_bytes_n_at(b, e)
}

write_bytes_n_at(b: int, e: int) raises IoError {
    fbuf_n = 0;
    fput_bytes(hlp, b, e);
    show_fbuf()
}

problems() raises IoError {
    write_bytes_n(1, hlog, hlog_n);
    if (he_n == 0) print("no problems")
}

// A tip's id, as the log has it.
tip(i: int) raises IoError {
    if (i < 0) {
        write(1, "(none)");
        return
    }
    fbuf_n = 0;
    help_fput_id(i);
    show_fbuf()
}

tip_named(id: str): int {
    for i in 0..len(id) hw[i] = id[i];
    help_tip_named(hw, len(id))
}

// The tip for the day, and its id.
D0: int = 20746;

shown(day: int) raises IoError {
    write(1, "day ");
    write_int(1, day - D0);
    write(1, ": ");
    tip(help_tip_for(day));
    print("")
}

next(day: int) raises IoError {
    write(1, "next: ");
    tip(help_next(day));
    print("")
}

test "help.txt: its pages, parts and tips, and nothing wrong" {
    load();
    problems();
    write(1, "pages ");
    write_int(1, hpg_n);
    write(1, ", parts ");
    write_int(1, hpt_n);
    write(1, ", paragraphs ");
    write_int(1, hpa_n);
    write(1, ", tips ");
    write_int(1, htp_n);
    print("");
    for lv in 1..4 {
        n: int = 0;
        for i in 0..htp_n
            if (htp_level[i] == lv) n = n + 1;
        write(1, "level ");
        write_int(1, lv);
        write(1, ": ");
        write_int(1, n);
        print("")
    }
    for g in 0..hpg_n {
        show_bytes(hpg_title_b[g], hpg_title_e[g]);
        write(1, " (");
        write(1, hsym_names[hpg_sym[g]]);
        write(1, "):");
        for t in hpg_part0[g]..hpg_part0[g] + hpg_parts[g] {
            write(1, " ");
            show_bytes(hpt_id_b[t], hpt_id_e[t])
        }
        print("")
    }
    expect {|
        no problems
        pages 12, parts 55, paragraphs 59, tips 52
        level 1: 10
        level 2: 17
        level 3: 25
        Reading (book): bar footnotes headings place
        Going Places (arrow.right.circle): goto back history previews search
        Selecting Verses (hand.tap): select highlight actions words
        Notes, Highlights and Bookmarks (note.text): notes chapternotes library export versions
        Ribbons (bookmark.fill): about making carry edit
        Reading Plans (calendar): about today mark listen reminder
        Versions and Compare (books.vertical): choose esv compare
        Listening (headphones): listen readers offline speed
        Study (character.book.closed): interlinear wordstudy grammar related references
        Memory (brain): adding practice parts schedule hearing reminder
        Greek and Hebrew (textformat.abc): start alphabet words reading forms
        Reading Settings (textformat.size): text show screen help about
    |}
    // The order: level 1's, then 2's, then 3's, each in the file's order.
    for k in 0..htp_n {
        tip(htp_order[k]);
        write(1, if (k % 8 == 7 || k == htp_n - 1) "\n" else " ")
    }
    expect {|
        goto-type tap-select highlight note back search bar footnote
        library recent ribbon-new ribbon-title ribbon-two plan plan-miss plan-day
        plan-mark listen voice download version compare theme size
        preview bookmark words plan-listen plan-more red screen chapter-note
        note-links export filter share-image study wordstudy study-word concordance
        references commentary addnote memorize practice type echo memory-reminder
        greek hide-known forms tips-off
    |}
    // Each tip's More, and its action.
    for i in 0..htp_n {
        if (htp_action[i] >= 0) {
            tip(i);
            write(1, " \�\�\� ");
            write(1, ha_names[htp_action[i]]);
            write(1, " \"");
            show_bytes(htp_act_b[i], htp_act_e[i]);
            write(1, "\", more ");
            fbuf_n = 0;
            help_fput_anchor(htp_more[i]);
            show_fbuf();
            print("")
        }
    }
    expect {|
        search → search "Open Search", more going#search
        ribbon-new → new-ribbon "New Ribbon…", more ribbons#making
        plan → plans "Reading Plans", more plans#about
        practice → memory "Open Memory", more memory#practice
        greek → greek "Greek", more languages#start
    |}
}

test "the checks: what each finds" {
    load_own("""
# a comment
tip	early	1	-	-	one#a	A tip before its page is fine.
= one	One	book
A paragraph before any part.
== a	A
Fine, with **bold**, a {sym:bookmark} and [[one#b|a link]].
A {sym:nonesuch}, [[one#zz|nowhere]], [[two#a|another page]] and [[one#a]].
**Left open.
== a	Again
The same part again.
== b	Empty
= one	One again	book
= two	Two	sparkles
== c	C
Words.
= three	Three	book
tip	early	1	-	-	one#a	The same id again.
tip	cond	2	nonesuch	-	one#a	An unknown condition.
tip	act	2	-	launch:Launch	one#a	An unknown action.
tip	act2	2	-	search	one#a	An action with no title.
tip	more	2	-	-	one#q	More to nowhere.
tip	more2	2	-	-	nowhere	More with no part.
tip	level	4	-	-	one#a	A level past 3.
tip	two	1	-	-	one#a	One sentence. Then another.
tip	bang	1	-	-	one#a	Exciting!
tip	long	1	-	-	one#a	This tip is far too long to be read at a glance in Go To, so it is cut down, since one sentence of a tip should say one thing only, and briefly.
tip	pro	1	-	-	one#a	Pro tip: tap here.
tip	know	1	-	-	one#a	Did you know there are books here.
tip	easy	1	-	-	one#a	You can easily go anywhere.
tip	simple	1	-	-	one#a	Simply tap the title.
tip	just	1	-	-	one#a	Just tap the title.
tip	justice	1	-	-	one#a	Justice and adjust are words, and so is awesomeness.
tip	short	1	-	-
""");
    problems();
    expect {|
        help.txt:4: a paragraph outside any part
        help.txt:9: two parts a in one page
        help.txt:12: two pages one
        help.txt:13: page two: no symbol, or one not in help.l8's list
        help.txt:17: two tips early
        help.txt:18: tip cond: unknown condition nonesuch
        help.txt:19: tip act: unknown action, or no title: launch:Launch
        help.txt:20: tip act2: unknown action, or no title: search
        help.txt:23: tip level: its level is not 1, 2 or 3
        help.txt:33: a tip needs 7 fields, not 5
        help.txt:0: page one has no part
        help.txt:0: page three has no part
        help.txt:0: part one#b has no paragraph
        help.txt:0: part one#a: a symbol not in help.l8's list: nonesuch
        help.txt:0: part one#a: a link to nowhere: nowhere
        help.txt:0: part one#a: a link to nowhere: another page
        help.txt:0: part one#a: markup not closed: [[one#a]].
        help.txt:0: part one#a: ** or _ not closed
        help.txt:21: tip more: More names no part: one#q
        help.txt:22: tip more2: More names no part: nowhere
        help.txt:24: tip two: more than one sentence
        help.txt:25: tip bang: an exclamation mark
        help.txt:26: tip long: longer than 140 letters
        help.txt:27: tip pro: a word the style forbids
        help.txt:28: tip know: a word the style forbids
        help.txt:29: tip easy: a word the style forbids
        help.txt:30: tip simple: a word the style forbids
        help.txt:31: tip just: a word the style forbids
    |}
}

// A paragraph's runs: k kind, b bold, i italic.
show_runs(a: int) raises IoError {
    help_runs(a);
    for r in 0..hrun_n {
        write(1, if (hrun_kind[r] == HRUN_TEXT) "text" else if (hrun_kind[r] == HRUN_SYM) "symbol" else if (hrun_kind[r] == HRUN_LINK) "link" else "bad");
        if (hrun_bold[r]) write(1, " bold");
        if (hrun_italic[r]) write(1, " italic");
        write(1, " [");
        show_bytes(hrun_b[r], hrun_e[r]);
        write(1, "]");
        if (hrun_kind[r] == HRUN_LINK) {
            write(1, " \�\�\� ");
            fbuf_n = 0;
            help_fput_anchor(hrun_link[r]);
            show_fbuf()
        }
        print("")
    }
}

plain(a: int, spoken: bool) raises IoError {
    help_plain(a, spoken);
    write_bytes_n(1, hx, hx_n);
    print("")
}

test "a paragraph's markup, and its words plain" {
    load_own("""
= p	P	book
== a	A
Tap **Edit**, or _here_; {sym:bookmark} opens the Library ([[p#b|More]]).
== b	B
Words.
""");
    problems();
    show_runs(0);
    plain(0, false);
    plain(0, true);
    expect {|
        no problems
        text [Tap ]
        text bold [Edit]
        text [, or ]
        text italic [here]
        text [; ]
        symbol [bookmark]
        text [ opens the Library (]
        link [More] → p#b
        text [).]
        Tap Edit, or here; opens the Library (More).
        Tap Edit, or here; the bookmark button opens the Library (More).
    |}
    // The real file's: Selecting Verses' actions.
    load();
    t: int = help_anchor_named("tray#actions");
    plain(hpt_para0[t], true);
    expect {|
        Copy the Copy button copies the verses with their reference. Share the Share button sends them on, and Share as Image in the share sheet makes a picture of them. Bookmark the bookmark button keeps the verse in the Library. Note the pencil button writes a note on it. Study the Study button opens the original words (Study). Compare shows the verses in every version (Compare). Memorize the Memorize button adds them to Memory (Memory).
    |}
}

help_anchor_named(s: str): int {
    for i in 0..len(s) hw[i] = s[i];
    // (Into hlp's own bytes' terms: a copy at its end.)
    help_part_of(s)
}

help_part_of(s: str): int {
    for t in 0..hpt_n {
        fbuf_n = 0;
        help_fput_anchor(t);
        if (fbuf_n == len(s)) {
            same: bool = true;
            for i in 0..len(s)
                if (fbuf[i] != s[i]) same = false;
            if (same) return t
        }
    }
    -1
}

test "which tip, and when (§15.2.3)" {
    load();
    // A fresh state: the first; Next: the second; the same day, the same.
    shown(D0);
    next(D0);
    shown(D0);
    expect {|
        day 0: goto-type
        next: tap-select
        day 0: tap-select
    |}
    // The next day: the one after it.
    shown(D0 + 1);
    shown(D0 + 1);
    expect {|
        day 1: highlight
        day 1: highlight
    |}
    // A highlight made: the tips about it skipped, at once (the same day)
    // and after.
    hc_on[help_condition("highlight")] = true;
    shown(D0 + 1);
    shown(D0 + 2);
    expect {|
        day 1: note
        day 2: back
    |}
    // A used flag skips its tip as data does.
    hu_used[help_condition("search")] = true;
    next(D0 + 2);
    next(D0 + 2);
    next(D0 + 2);
    next(D0 + 2);
    next(D0 + 2);
    next(D0 + 2);
    next(D0 + 2);
    next(D0 + 2);
    expect {|
        next: bar
        next: footnote
        next: library
        next: recent
        next: ribbon-new
        next: ribbon-title
        next: ribbon-two
        next: plan
    |}
    next(D0 + 2);
    next(D0 + 2);
    next(D0 + 2);
    next(D0 + 2);
    expect {|
        next: plan-miss
        next: plan-day
        next: plan-mark
        next: listen
    |}
    // (§16's used flags skip their tips; listen, seen, is passed over.)
    hu_used[help_condition("plan-day")] = true;
    hu_used[help_condition("plan-mark")] = true;
    ht_cur = tip_named("plan-miss");
    next(D0 + 2);
    expect {|
        next: voice
    |}
    // Every tip seen: from the one current, the first not skipped after it,
    // wrapping (and never "all done").
    for i in 0..htp_n ht_seen[i] = true;
    ht_cur = tip_named("tips-off");
    shown(D0 + 3);
    shown(D0 + 4);
    expect {|
        day 3: goto-type
        day 4: note
    |}
    // tipSeen and skipped together: of the unseen, the first not skipped
    // after the current; a skipped one unseen is passed over.
    for i in 0..htp_n ht_seen[i] = true;
    ht_seen[tip_named("highlight")] = false;
    ht_seen[tip_named("echo")] = false;
    ht_seen[tip_named("bar")] = false;
    ht_cur = tip_named("type");
    shown(D0 + 5);
    shown(D0 + 6);
    shown(D0 + 7);
    expect {|
        day 5: echo
        day 6: bar
        day 7: footnote
    |}
    // An unknown id (a tip removed in an update) is no tip: from the start.
    help_state_clear();
    gone: str = "gone-tip!";
    for i in 0..9 hw[i] = gone[i];
    ht_cur = help_tip_named(hw, 9);
    ht_day = D0;
    shown(D0);
    expect {|
        day 0: goto-type
    |}
    // Every tip skipped: none.
    for i in 0..htp_n
        if (htp_unless[i] < 0) htp_unless[i] = HC_UNBUILT;
    for c in 0..len(hc_on) hc_on[c] = true;
    shown(D0 + 8);
    expect {|
        day 8: (none)
    |}
}

test "the state's words: tipSeen and helpUsed" {
    load();
    s: str = "note bar nonesuch goto-type";
    b: []i8 = new i8[64](0i8);
    for i in 0..len(s) b[i] = s[i];
    help_read_seen(b, len(s));
    help_fput_seen();
    show_fbuf();
    print("");
    u: str = "search title-menu bogus theme";
    for i in 0..len(u) b[i] = u[i];
    help_read_used(b, len(u));
    help_fput_used();
    show_fbuf();
    print("");
    expect {|
        goto-type note bar
        search title-menu theme
    |}
}

// The Manual's search: each part found, and its snippet (the matches in
// [brackets], "… " where it starts after the paragraph's start).
find(q: str) raises IoError {
    b: []i8 = new i8[256](0i8);
    for i in 0..len(q) b[i] = q[i];
    help_search(b, len(q));
    write(1, q);
    write(1, ": ");
    write_int(1, hm_n);
    print("");
    for m in 0..hm_n {
        t: int = hm_part[m];
        fbuf_n = 0;
        fput_str("  ");
        help_fput_anchor(t);
        fput_str(": ");
        help_snippet(t);
        if (hsn_from > 0) fput_str("\�\�\� ");
        p: int = hsn_from;
        for k in 0..hsn_n {
            fput_bytes(hx, p, hsn_mb[k]);
            fput(91);
            fput_bytes(hx, hsn_mb[k], hsn_me[k]);
            fput(93);
            p = hsn_me[k]
        }
        e: int = if (hx_n - p > 30) p + 30 else hx_n;
        fput_bytes(hx, p, e);
        if (e < hx_n) fput_str("\�\�\�");
        show_fbuf();
        print("")
    }
}

test "the Manual's search (§15.7)" {
    load();
    find("ribbon");
    expect {|
        ribbon: 5
          going#goto: Go To also holds your [ribbons] ([Ribbons]), your reading plan (Reading …
          ribbons#about: A [ribbon] keeps a place you’re reading from, like the [ribbons] in a printed Bible: one for y…
          ribbons#making: In Go To, tap New [Ribbon]…, or touch and hold the title in the bar and choose New [Ribbon] Here…. Give it a name and a…
          ribbons#carry: Tap a [ribbon] in Go To to open it. You’re taken to its place, and the [ribbon] is carried: it moves on as you read, and its glyph shows beside the title. When you jump somewhere else, the [ribbon] stays where you were. Touch and hold the title to leave it at a place, or to move another [ribbon] here.
          ribbons#edit: beside a [ribbon] in Go To renames it, changes …
    |}
    find("born again");
    find("Born AGAIN");
    expect {|
        born again: 1
          going#search: … find a phrase, “[born] [again]”, and end a word with * to …
        Born AGAIN: 1
          going#search: … find a phrase, “[born] [again]”, and end a word with * to …
    |}
    find("you'd");
    find("bless*");
    find("nothing here at all");
    find("");
    expect {|
        you'd: 1
          settings#help: Show Tips shows a tip at the top of Go To. Turn it off if [you’d] rather not see them; this man…
        bless*: 1
          going#search: … beginning with it, “[bless]*”. The buttons under the fi…
        nothing here at all: 0
        : 0
    |}
}
