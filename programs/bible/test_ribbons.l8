tag bible_ribbons_tests;

use_tag std, bible;

// Ribbons (ribbons.l8, DESIGN.md §11.1): made and named, picked up and put
// down, moved only while carried (every rest either way; a read chapter's
// end the next one's top), Leave Here, Move Ribbon Here, rename and
// delete; ribbons.tsv read back; Round 6's readings made ribbons; and what
// a row says. Every time is fixed: T0 is 2026-10-19 08:00 (UTC, the offset
// 0).
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "ribbons.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

loaded: bool = false;

load() noregion {
    if (loaded) return;
    loaded = true;
    fd: int = open("programs/bible/data/bsb.txt", 0, 0);
    n: int = 8388608;
    bsb = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, bsb, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    bible_index(got);
    text_load(TEXT_BSB, bsb, got)
}

T0: int = 1792396800;

H: int = 3600;

fresh() noregion {
    load();
    ribbons_clear();
    rbe_n = 0
}

// Book code's chapter n.
ch(code: str, n: int): int {
    book_first[book_coded(code)] + n - 1
}

book_coded(code: str): int {
    for b in 0..books {
        same: bool = true;
        for i in 0..3
            if (bsb[book_line[b] + 1 + i] != code[i]) same = false;
        if (same) return b
    }
    -1
}

nb: []i8 = new i8[512](0i8);

// A ribbon named name ("" the default) at chapter c, verse v, at t: its id.
mk(
    name: str,
    c: int,
    v: int,
    t: int
): int {
    for i in 0..len(name) nb[i] = name[i];
    ribbon_make(nb, len(name), c, v, 0, t)
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

// What happened, as the log has it.
events() raises IoError {
    write_bytes_n(1, rbe, rbe_n);
    rbe_n = 0
}

// The ribbons in order: id, name, place, last (hours after T0), and * if
// carried.
show() raises IoError {
    if (rb_n == 0) print("(no ribbons)");
    for i in 0..rb_n {
        fbuf_n = 0;
        fput_int(rb_id[i]);
        fput(32);
        fput_ribbon_name(i);
        fput_str(" \�\� ");
        fput_ribbon_place(i);
        fput_str(" \�\� last ");
        fput_int((rb_last[i] - T0) / H);
        if (rb_id[i] == rb_carried) fput_str(" *");
        show_fbuf();
        print("")
    }
}

test "making ribbons, and their names" {
    fresh();
    rom: int = ch("ROM", 8);
    a: int = mk("", rom, 12, T0);
    b: int = mk("", rom + 1, 0, T0);
    c: int = mk("Romans", ch("PSA", 23), 0, T0);
    d: int = mk("""
  Morning	with
Anna  """, ch("MRK", 1), 0, T0);
    // 41 letters: the 41st dropped; and 39 with a two-byte letter and a
    // space after it: the space dropped too.
    e: int = mk("abcdefghijklmnopqrstuvwxyzabcdefghijklmno", ch("JUD", 1), 0, T0);
    f: int = mk("abcdefghijklmnopqrstuvwxyzabcdefghijkl\�\� x", ch("PSA", 1), 0, T0);
    events();
    show();
    // To twelve, then the 13th refused.
    while (rb_n < 12) _x: int = mk("", ch("GEN", 1), 0, T0);
    write(1, "12: ");
    write_int(1, rb_n);
    write(1, ", the 13th's id ");
    write_int(1, mk("", ch("GEN", 1), 0, T0));
    print("");
    // Deleted, the next id is new.
    ribbon_delete(rb_id[11]);
    ribbon_delete(a);
    write(1, "after deleting: ");
    write_int(1, mk("", ch("EXO", 1), 0, T0));
    print("");
    rbe_n = 0;
    _u: int = b + c + d + e + f;
    expect {|
        ribbon made: Romans at ROM 8:12
        ribbon made: Romans (2) at ROM 9
        ribbon made: Romans at PSA 23
        ribbon made: Morning with Anna at MRK 1
        ribbon made: abcdefghijklmnopqrstuvwxyzabcdefghijklmn at JUD 1
        ribbon made: abcdefghijklmnopqrstuvwxyzabcdefghijklé at PSA 1
        1 Romans · Romans 8:12 · last 0
        2 Romans (2) · Romans 9 · last 0
        3 Romans · Psalm 23 · last 0
        4 Morning with Anna · Mark 1 · last 0
        5 abcdefghijklmnopqrstuvwxyzabcdefghijklmn · Jude · last 0
        6 abcdefghijklmnopqrstuvwxyzabcdefghijklé · Psalm 1 · last 0
        12: 12, the 13th's id 0
        after deleting: 13
    |}
}

test "a carried ribbon follows your rests and reading" {
    fresh();
    rom: int = ch("ROM", 8);
    k: int = mk("", rom, 12, T0);
    ribbon_pick_up(k, false);
    // 8:20, back to 8:15, on into 9:4.
    _a: bool = ribbon_rest(rom, 20, 0, false, T0 + H);
    _b: bool = ribbon_rest(rom, 15, 0, false, T0 + 2 * H);
    _c: bool = ribbon_rest(rom + 1, 4, 0, false, T0 + 3 * H);
    show();
    // At Romans 8's end, read: Romans 9; a rest there again (its end in
    // sight) keeps Romans 9; up into 8:30, 8:30.
    _d: bool = ribbon_rest(rom, 38, 0, true, T0 + 4 * H);
    _e: bool = ribbon_read(rom, T0 + 5 * H);
    show();
    _f: bool = ribbon_rest(rom, 38, 0, true, T0 + 6 * H);
    show();
    _g: bool = ribbon_rest(rom, 30, 0, false, T0 + 7 * H);
    show();
    // Romans 16 read: 1 Corinthians 1.
    _h: bool = ribbon_rest(ch("ROM", 16), 20, 0, false, T0 + 8 * H);
    _i: bool = ribbon_read(ch("ROM", 16), T0 + 9 * H);
    show();
    events();
    expect {|
        1 Romans · Romans 9:4 · last 3 *
        1 Romans · Romans 9 · last 5 *
        1 Romans · Romans 9 · last 6 *
        1 Romans · Romans 8:30 · last 7 *
        1 Romans · 1 Corinthians 1 · last 9 *
        ribbon made: Romans at ROM 8:12
        ribbon picked up: Romans
        ribbon moved: Romans to ROM 8:20
        ribbon moved: Romans to ROM 8:15
        ribbon moved: Romans to ROM 9:4
        ribbon moved: Romans to ROM 8:38
        ribbon moved: Romans to ROM 9
        ribbon moved: Romans to ROM 8:30
        ribbon moved: Romans to ROM 16:20
        ribbon moved: Romans to 1CO 1
    |}
}

test "Listen carries it; a cross reference and the capsule back" {
    fresh();
    rom: int = ch("ROM", 8);
    k: int = mk("", rom, 12, T0);
    ribbon_pick_up(k, false);
    // Listen's following: rests verse by verse, then the chapter heard.
    _a: bool = ribbon_rest(rom, 14, 0, false, T0 + H);
    _b: bool = ribbon_rest(rom, 30, 0, false, T0 + H);
    _c: bool = ribbon_read(rom, T0 + 2 * H);
    show();
    // A rest at 9:2; a cross reference to Psalm 23: put down where it was;
    // rests there move nothing.
    _d: bool = ribbon_rest(rom + 1, 2, 0, false, T0 + 3 * H);
    _e: bool = ribbon_jumped(0);
    _f: bool = ribbon_rest(ch("PSA", 23), 4, 0, false, T0 + 4 * H);
    _g: bool = ribbon_read(ch("PSA", 23), T0 + 4 * H);
    show();
    // The capsule back to Romans 9: picked up again; reading on moves it.
    _h: bool = ribbon_jumped(1);
    write(1, "back picks up ");
    write_int(1, ribbon_capsule_back());
    print("");
    _i: bool = ribbon_rest(rom + 1, 7, 0, false, T0 + 5 * H);
    show();
    events();
    expect {|
        1 Romans · Romans 9 · last 2 *
        1 Romans · Romans 9:2 · last 3
        back picks up 1
        1 Romans · Romans 9:7 · last 5 *
        ribbon made: Romans at ROM 8:12
        ribbon picked up: Romans
        ribbon moved: Romans to ROM 8:14
        ribbon moved: Romans to ROM 8:30
        ribbon moved: Romans to ROM 9
        ribbon moved: Romans to ROM 9:2
        ribbon put down: Romans at ROM 9:2
        ribbon picked up: Romans (back)
        ribbon moved: Romans to ROM 9:7
    |}
}

test "not carried, nothing moves; a jump puts it down" {
    fresh();
    rom: int = ch("ROM", 8);
    _k: int = mk("", rom, 0, T0);
    _a: bool = ribbon_rest(rom, 20, 0, false, T0 + H);
    _b: bool = ribbon_read(rom, T0 + H);
    show();
    ribbon_pick_up(rb_id[0], false);
    _c: bool = ribbon_rest(rom, 5, 0, false, T0 + 2 * H);
    _d: bool = ribbon_jumped(0);
    _e: bool = ribbon_rest(rom, 25, 0, false, T0 + 3 * H);
    _f: bool = ribbon_read(rom, T0 + 3 * H);
    show();
    rbe_n = 0;
    expect {|
        1 Romans · Romans 8 · last 0
        1 Romans · Romans 8:5 · last 2
    |}
}

test "opening another; the capsule's memory" {
    fresh();
    a: int = mk("Morning", ch("MRK", 3), 0, T0);
    b: int = mk("", ch("ACT", 10), 9, T0);
    ribbon_pick_up(a, false);
    _r: bool = ribbon_rest(ch("MRK", 3), 7, 0, false, T0 + H);
    // B opened: a jump (A put down at its last rest), then B picked up.
    _j: bool = ribbon_jumped(0);
    ribbon_pick_up(b, false);
    show();
    // The capsule: B put down, A picked up again.
    _k: bool = ribbon_jumped(1);
    write(1, "back picks up ");
    write_int(1, ribbon_capsule_back());
    print("");
    show();
    // And the capsule again (to Acts): B picked up again, A down.
    _l: bool = ribbon_jumped(1);
    write(1, "again ");
    write_int(1, ribbon_capsule_back());
    print("");
    // A second jump (nothing remembered with it): the capsule picks
    // nothing up.
    _m: bool = ribbon_jumped(0);
    _n: bool = ribbon_jumped(0);
    _o: bool = ribbon_jumped(1);
    write(1, "after a second jump ");
    write_int(1, ribbon_capsule_back());
    print("");
    // Deleting it clears the memory.
    ribbon_pick_up(a, false);
    _p: bool = ribbon_jumped(0);
    ribbon_delete(a);
    _q: bool = ribbon_jumped(1);
    write(1, "deleted ");
    write_int(1, ribbon_capsule_back());
    print("");
    // The status bar's jump remembers nothing.
    ribbon_pick_up(b, false);
    _s: bool = ribbon_jumped(2);
    _t: bool = ribbon_jumped(1);
    write(1, "status bar ");
    write_int(1, ribbon_capsule_back());
    print("");
    events();
    expect {|
        1 Morning · Mark 3:7 · last 1
        2 Acts · Acts 10:9 · last 0 *
        back picks up 1
        1 Morning · Mark 3:7 · last 1 *
        2 Acts · Acts 10:9 · last 0
        again 2
        after a second jump 0
        deleted 0
        status bar 0
        ribbon made: Morning at MRK 3
        ribbon made: Acts at ACT 10:9
        ribbon picked up: Morning
        ribbon moved: Morning to MRK 3:7
        ribbon put down: Morning at MRK 3:7
        ribbon picked up: Acts
        ribbon put down: Acts at ACT 10:9
        ribbon picked up: Morning (back)
        ribbon put down: Morning at MRK 3:7
        ribbon picked up: Acts (back)
        ribbon put down: Acts at ACT 10:9
        ribbon picked up: Morning
        ribbon put down: Morning at MRK 3:7
        ribbon deleted: Morning
        ribbon picked up: Acts
        ribbon put down: Acts at ACT 10:9
    |}
}

test "Leave Here, Revelation 22, Move Ribbon Here, rename, delete" {
    fresh();
    acts: int = ch("ACT", 10);
    a: int = mk("", acts, 9, T0);
    ribbon_pick_up(a, false);
    // Acts 10 heard: Acts 11; Leave Here at Acts 10's end (read since the
    // pickup): Acts 11, then nothing moves it.
    _r: bool = ribbon_read(acts, T0 + H);
    _l: bool = ribbon_leave_here(acts, 48, 0, true, T0 + 2 * H);
    _m: bool = ribbon_rest(acts + 1, 5, 0, false, T0 + 3 * H);
    show();
    // Revelation 22 read, and its end seen at a rest: it stays there.
    rev: int = ch("REV", 22);
    z: int = mk("End", rev, 3, T0);
    ribbon_pick_up(z, false);
    _n: bool = ribbon_read(rev, T0 + 4 * H);
    _o: bool = ribbon_rest(rev, 20, 0, true, T0 + 5 * H);
    // Move Ribbon Here: Acts to Romans 8, picked up (End put down).
    ribbon_move_here(a, ch("ROM", 8), 0, 0, T0 + 6 * H);
    show();
    // Renamed: to empty (kept), with spaces (trimmed).
    _p: bool = ribbon_rename(a, nb, 0);
    for i in 0..11 nb[i] = " With Anna "[i];
    _q: bool = ribbon_rename(a, nb, 11);
    // The carried one deleted: none carried.
    ribbon_delete(a);
    write(1, "carried ");
    write_int(1, rb_carried);
    print("");
    show();
    events();
    expect {|
        1 Acts · Acts 11 · last 2
        1 Acts · Romans 8 · last 6 *
        2 End · Revelation 22:20 · last 5
        carried 0
        2 End · Revelation 22:20 · last 5
        ribbon made: Acts at ACT 10:9
        ribbon picked up: Acts
        ribbon moved: Acts to ACT 11
        ribbon put down: Acts at ACT 11
        ribbon made: End at REV 22:3
        ribbon picked up: End
        ribbon moved: End to REV 22:20
        ribbon put down: End at REV 22:20
        ribbon moved here: Acts to ROM 8
        ribbon picked up: Acts
        ribbon renamed: Acts to With Anna
        ribbon deleted: With Anna
    |}
}

test "ribbons.tsv" {
    fresh();
    a: int = mk("Morning", ch("MRK", 2), 5, T0);
    _b: int = mk("", ch("PSA", 41), 0, T0 + H);
    c: int = mk("", ch("JUD", 1), 0, T0 + 2 * H);
    ribbon_delete(c);
    ribbon_pick_up(a, false);
    rb_frac[0] = -40;
    format_ribbons();
    show_fbuf();
    parse_ribbons();
    show();
    write(1, "next ");
    write_int(1, rb_next);
    print("");
    // Bad lines, a second line of one id, a CARRIED naming none; no NEXT
    // (ids from the greatest).
    fbuf_n = 0;
    fput_str("RIBBON\t4\tJohn\tJHN\t15\t0\t0\t10\t20\n");
    fput_str("RIBBON\t4\tJohn again\tJHN\t16\t0\t0\t10\t20\n");
    fput_str("RIBBON\t5\t\tJHN\t15\t0\t0\t10\t20\n");
    fput_str("RIBBON\t6\tBad\tXYZ\t1\t0\t0\t10\t20\n");
    fput_str("RIBBON\t7\tBad\tJHN\t99\t0\t0\t10\t20\n");
    fput_str("RIBBON\t8\tBad\tJHN\t1\t0\t0\t10\n");
    fput_str("RIBBON\t0\tBad\tJHN\t1\t0\t0\t10\t20\n");
    fput_str("CARRIED\t9\n");
    fput_str("OTHER\n");
    parse_ribbons();
    show();
    write(1, "skipped ");
    write_int(1, lines_skipped);
    write(1, ", carried ");
    write_int(1, rb_carried);
    write(1, ", next ");
    write_int(1, rb_next);
    print("");
    rbe_n = 0;
    expect "RIBBON\t1\tMorning\tMRK\t2\t5\t-40\t1792396800\t1792396800\tred\nRIBBON\t2\tPsalms\tPSA\t41\t0\t0\t1792400400\t1792400400\tgold\nCARRIED\t1\nNEXT\t4\n1 Morning · Mark 2:5 · last 0 *\n2 Psalms · Psalm 41 · last 1\nnext 4\n4 John · John 15 · last -497887\nskipped 6, carried 0, next 5\n"
}

test "Round 6's readings made ribbons" {
    fresh();
    D: int = 24 * H;
    // Five read in the last two weeks (two in Acts), one 15 days ago, a bad
    // line and CLEARED.
    fbuf_n = 0;
    fput_str("READING\tROM\t3\t0\t0\t");
    fput_int(T0 - 10 * D);
    fput(9);
    fput_int(T0 - 2 * H);
    fput_str("""

READING	ACT	10	9	40	""");
    fput_int(T0 - 9 * D);
    fput(9);
    fput_int(T0 - 11 * H);
    fput_str("""

READING	ACT	20	0	0	""");
    fput_int(T0 - 9 * D);
    fput(9);
    fput_int(T0 - 12 * H);
    fput_str("""

READING	JHN	15	0	0	""");
    fput_int(T0 - 9 * D);
    fput(9);
    fput_int(T0 - 3 * D);
    fput_str("""

READING	GEN	5	0	0	""");
    fput_int(T0 - 9 * D);
    fput(9);
    fput_int(T0 - 13 * D);
    fput_str("""

READING	PSA	24	0	0	""");
    fput_int(T0 - 30 * D);
    fput(9);
    fput_int(T0 - 15 * D);
    fput_str("""

READING	XYZ	1	0	0	1	1
CLEARED	""");
    fput_int(T0 - D);
    fput(10);
    made: int = migrate_readings(T0);
    write_int(1, made);
    write(1, " of ");
    write_int(1, mg_of);
    write(1, ", carried ");
    write_int(1, rb_carried);
    print("");
    show();
    // One 15 days old only: none; and nothing at all.
    fresh();
    fbuf_n = 0;
    fput_str("READING\tPSA\t24\t0\t0\t1\t");
    fput_int(T0 - 15 * D);
    fput(10);
    write_int(1, migrate_readings(T0));
    fbuf_n = 0;
    write(1, ", ");
    write_int(1, migrate_readings(T0));
    print("");
    // Once only: not with ribbons.tsv there, nor without readings.tsv.
    for f in [0, 1, 2, 3] print(if (ribbons_migrate_due(f % 2 == 1, f >= 2)) "due" else "not");
    events();
    expect {|
        3 of 6, carried 0
        1 Romans · Romans 3 · last -2
        2 Acts · Acts 10:9 · last -11
        3 Acts (2) · Acts 20 · last -12
        0, 0
        not
        due
        not
        not
    |}
}

test "what a row says" {
    fresh();
    _a: int = mk("Morning", ch("ROM", 8), 12, T0 - 30);
    _b: int = mk("", ch("PSA", 41), 0, T0 - 3 * H);
    _c: int = mk("", ch("JUD", 1), 0, T0 - 20 * H);
    _d: int = mk("", ch("1CO", 1), 0, T0 - 4 * 24 * H);
    _e: int = mk("", ch("EXO", 2), 0, T0 - 300 * 24 * H);
    for i in 0..rb_n {
        fbuf_n = 0;
        fput_ribbon_line(i, T0, 0);
        fput_str(" | ");
        fput_ribbon_label(i, T0, 0);
        show_fbuf();
        print("")
    }
    rbe_n = 0;
    expect {|
        Romans 8:12 · Now | Morning. Romans, chapter 8, verse 12. Read just now.
        Psalm 41 · Today | Psalms. Psalm 41. Read today.
        Jude · Yesterday | Jude. Jude. Read yesterday.
        1 Corinthians 1 · Thursday | 1 Corinthians. 1 Corinthians, chapter 1. Read on Thursday.
        Exodus 2 · 23 December 2025 | Exodus. Exodus, chapter 2. Read on 23 December 2025.
    |}
}

// Each ribbon's color, in order: its name.
colors() raises IoError {
    for i in 0..rb_n {
        if (i > 0) write(1, " ");
        write(1, if (rb_color[i] >= 0) rb_color_names[rb_color[i]] else "none")
    }
    print("")
}

test "colors: defaults, a choice, the file" {
    fresh();
    // The palette in order; a gap left by a deletion taken first.
    for k in 0..4 _x: int = mk("", ch("GEN", k + 1), 0, T0);
    colors();
    ribbon_delete(rb_id[1]);
    _y: int = mk("", ch("EXO", 1), 0, T0);
    colors();
    // All seven taken: the one fewest have (the first of those).
    while (rb_n < 9) _z: int = mk("", ch("LEV", rb_n), 0, T0);
    colors();
    // Chosen: Navy for the first; the same again changes nothing.
    rbe_n = 0;
    _a: bool = ribbon_set_color(rb_id[0], 2);
    _b: bool = ribbon_set_color(rb_id[0], 2);
    _c: bool = ribbon_set_color(rb_id[0], 7);
    events();
    // Read back; an older file's lines (no color) and an unknown name given
    // defaults in order; any case read.
    fresh();
    fbuf_n = 0;
    fput_str("RIBBON\t1\tA\tJHN\t1\t0\t0\t1\t2\tGOLD\n");
    fput_str("RIBBON\t2\tB\tJHN\t2\t0\t0\t1\t2\n");
    fput_str("RIBBON\t3\tC\tJHN\t3\t0\t0\t1\t2\tteal\n");
    fput_str("RIBBON\t4\tD\tJHN\t4\t0\t0\t1\t2\tpurple\n");
    parse_ribbons();
    colors();
    write(1, "filled ");
    print(if (rb_colors_filled) "yes" else "no");
    format_ribbons();
    parse_ribbons();
    colors();
    write(1, "filled ");
    print(if (rb_colors_filled) "yes" else "no");
    rbe_n = 0;
    expect {|
        Red Gold Navy Green
        Red Navy Green Gold
        Red Navy Green Gold Purple Brown Slate Red Gold
        ribbon color: Genesis Navy
        Gold Red Navy Purple
        filled yes
        Gold Red Navy Purple
        filled no
    |}
}
