tag bible_web;

use_tag std, bible, dom;

// Smooth Bible on the web (WEB.md): the reader, built with `l8 wasm` and
// started by web/bible/bible.js on a page prerender.l8 made, through the
// page bridge (../web/dom.l8). main finds the page, asks for the version's
// text and returns; when the text comes, the app takes the page's chapter
// as its own (html.l8 wrote it, as it would now), and from then on lives in
// the page's events: the scroll (web_reader.l8), clicks, keys, Reading
// settings, history.
//
// Phase (a) (Â§W3): the reader alone. Settings are attributes on <html>
// (the boot script set them before the first paint from sb.settings,
// which is written here); the place is sb.place and each history entry's
// state.
import "text.l8";

import "html.l8";

import "../web/dom.l8";

import "web_reader.l8";

// ---- settings (Â§W3.7) ----
// The size step (0 to 7), the theme, the font, spacing and margins (as
// their names' indexes), and the switches.
set_step: int = 2;

set_theme: int = 0;

set_font: int = 0;

set_spacing: int = 1;

set_margins: int = 1;

set_vn: bool = true;

set_heads: bool = true;

set_fns: bool = true;

set_lines: bool = false;

set_red: bool = false;

set_wake: bool = false;

set_keys: bool = true;

theme_names: []str = ["auto", "paper", "white", "sepia", "night", "black"];

theme_titles: []str = ["Auto", "Paper", "White", "Sepia", "Night", "Black"];

theme_bgs: []str = ["#FBF8F2", "#FBF8F2", "#FFFFFF", "#F4ECDD", "#1B1A18", "#000000"];

font_names: []str = ["serif", "charter", "georgia", "iowan", "sans"];

font_titles: []str = ["Serif", "Charter", "Georgia", "Iowan", "Sans"];

font_faces: []str = ["var(--serif)", "Charter, 'Charis SIL', var(--serif)", "Georgia, var(--serif)",
    "'Iowan Old Style', var(--serif)", "var(--ui)"];

spacing_names: []str = ["compact", "normal", "relaxed"];

spacing_titles: []str = ["Compact", "Normal", "Relaxed"];

margin_names: []str = ["narrow", "normal", "wide"];

margin_titles: []str = ["Narrow", "Normal", "Wide"];

steps: []str = ["0.82", "0.9", "1", "1.1", "1.2", "1.32", "1.46", "1.62"];

sbuf: []i8 = new i8[512](0i8);

// The index of the name at b's p to e in names, or -1.
name_index(
    names: []str,
    b: []i8,
    p: int,
    e: int
): int {
    for k in 0..len(names) {
        s: str = names[k];
        if (len(s) == e - p) {
            same: bool = true;
            for i in 0..len(s)
                if (b[p + i] != s[i]) same = false;
            if (same) return k
        }
    }
    -1
}

// Whether b's p to e is key.
is_key(
    b: []i8,
    p: int,
    e: int,
    key: str
): bool {
    if (len(key) != e - p) return false;
    for i in 0..len(key)
        if (b[p + i] != key[i]) return false;
    true
}

// One setting from a key and its value (b's ranges).
take_setting(
    b: []i8,
    k0: int,
    k1: int,
    v0: int,
    v1: int
) {
    on: bool = v1 > v0 && b[v0] as int == 49;
    if (is_key(b, k0, k1, "theme")) {
        t: int = name_index(theme_names, b, v0, v1);
        if (t >= 0) set_theme = t
    } else if (is_key(b, k0, k1, "font")) {
        f: int = name_index(font_names, b, v0, v1);
        if (f >= 0) set_font = f
    } else if (is_key(b, k0, k1, "spacing")) {
        x: int = name_index(spacing_names, b, v0, v1);
        if (x >= 0) set_spacing = x
    } else if (is_key(b, k0, k1, "margins")) {
        x: int = name_index(margin_names, b, v0, v1);
        if (x >= 0) set_margins = x
    } else if (is_key(b, k0, k1, "step")) {
        n: int = num_at(b, v0, v1);
        if (n >= 0 && n <= 7) set_step = n
    } else if (is_key(b, k0, k1, "vn")) set_vn = on else if (is_key(b, k0, k1, "heads")) set_heads = on else if (is_key(b,
        k0, k1, "fns")) set_fns = on else if (is_key(b, k0, k1, "lines")) set_lines = on else if (is_key(b,
        k0, k1, "red")) set_red = on else if (is_key(b, k0, k1, "wake")) set_wake = on else if (is_key(b,
        k0, k1, "keys")) set_keys = on
}

// sb.settings read: key=value pairs joined by &.
load_settings() {
    n: int = dom_store_get("sb.settings", sbuf);
    if (n <= 0 || n > len(sbuf)) return;
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && sbuf[e] as int != 38) e = e + 1;
        q: int = p;
        while (q < e && sbuf[q] as int != 61) q = q + 1;
        if (q < e) take_setting(sbuf, p, q, q + 1, e);
        p = e + 1
    }
}

s_pair(key: str, value: str) {
    if (wb_n > 0) w_byte(38);
    w_str(key);
    w_byte(61);
    w_str(value)
}

s_flag(key: str, on: bool) {
    s_pair(key, if (on) "1" else "0")
}

save_settings() {
    wb_n = 0;
    s_pair("theme", theme_names[set_theme]);
    s_pair("font", font_names[set_font]);
    w_str("&step=");
    w_int(set_step);
    s_pair("spacing", spacing_names[set_spacing]);
    s_pair("margins", margin_names[set_margins]);
    s_flag("vn", set_vn);
    s_flag("heads", set_heads);
    s_flag("fns", set_fns);
    s_flag("lines", set_lines);
    s_flag("red", set_red);
    s_flag("wake", set_wake);
    s_flag("keys", set_keys);
    dom_store_set("sb.settings", wb, wb_n)
}

flag(on: bool): str {
    if (on) "1" else "0"
}

// The settings on <html> (as the boot script sets them), and the theme's
// colour for the browser's bars.
apply_settings() {
    dom_set_attr(DOM_ROOT, "data-theme", theme_names[set_theme]);
    dom_set_attr(DOM_ROOT, "data-font", font_names[set_font]);
    dom_set_attr(DOM_ROOT, "data-spacing", spacing_names[set_spacing]);
    dom_set_attr(DOM_ROOT, "data-margins", margin_names[set_margins]);
    dom_set_attr(DOM_ROOT, "data-vn", flag(set_vn));
    dom_set_attr(DOM_ROOT, "data-heads", flag(set_heads));
    dom_set_attr(DOM_ROOT, "data-fns", flag(set_fns));
    dom_set_attr(DOM_ROOT, "data-red", flag(set_red));
    dom_set_style(DOM_ROOT, "--step", steps[set_step]);
    t: int = set_theme;
    if (t == 0 && dom_media("(prefers-color-scheme: dark)") == 1) t = 4;
    meta: int = dom_query(DOM_HEAD, "meta[name=\"theme-color\"]");
    if (meta != 0) {
        dom_set_attr(meta, "content", theme_bgs[t]);
        dom_free(meta)
    }
}

// ---- Reading settings, the sheet ----
settings: int = 0;

icons_n: int = 0;

icons: []i8 = new i8[128](0i8);

// An icon from the sprite.
h_icon(name: str, cls: str) {
    h_str("<svg aria-hidden=\"true\" class=\"");
    h_str(cls);
    h_str("\"><use href=\"");
    for i in 0..icons_n h_byte(icons[i] as int);
    h_byte(35);
    h_str(name);
    h_str("\"></use></svg>")
}

h_radio(group: str, value: str, on: bool) {
    h_str("<input type=\"radio\" name=\"");
    h_str(group);
    h_str("\" value=\"");
    h_str(value);
    h_str("\"");
    if (on) h_str(" checked");
    h_str(">")
}

h_switch(key: str, title: str, on: bool) {
    h_str("<label class=\"row\"><span>");
    h_str(title);
    h_str("</span><input type=\"checkbox\" role=\"switch\" name=\"");
    h_str(key);
    h_str("\"");
    if (on) h_str(" checked");
    h_str("></label>")
}

h_segments(
    key: str,
    title: str,
    names: []str,
    titles: []str,
    at: int
) {
    h_str("<div class=\"row\"><span id=\"seg-");
    h_str(key);
    h_str("\">");
    h_str(title);
    h_str("</span><fieldset class=\"seg\" aria-labelledby=\"seg-");
    h_str(key);
    h_str("\">");
    for k in 0..len(names) {
        h_str("<label>");
        h_radio(key, names[k], k == at);
        h_str("<span>");
        h_str(titles[k]);
        h_str("</span></label>")
    }
    h_str("</fieldset></div>")
}

iowan: bool = false;

// The sheet's HTML into hb.
settings_html() {
    hb_n = 0;
    h_str("<dialog class=\"settings\" aria-labelledby=\"set-h\"><header><h2 id=\"set-h\">Reading</h2><button class=\"done\" type=\"button\" data-act=\"done\">Done</button></header>");
    h_str("<section><div class=\"group\"><div class=\"row size\"><button class=\"ib smaller\" type=\"button\" data-act=\"smaller\" aria-label=\"Smaller Text\">");
    h_icon("a-large-small", "");
    h_str("</button><input type=\"range\" name=\"step\" min=\"0\" max=\"7\" step=\"1\" value=\"");
    h_int(set_step);
    h_str("\" aria-label=\"Text Size\"><button class=\"ib larger\" type=\"button\" data-act=\"larger\" aria-label=\"Larger Text\">");
    h_icon("a-large-small", "");
    h_str("</button></div><p class=\"caption\">Also follows the browser\â\€\™s text size.</p></div></section>");
    h_str("<section><h3 id=\"set-theme\">Theme</h3><fieldset class=\"group themes\" aria-labelledby=\"set-theme\">");
    for k in 0..len(theme_names) {
        h_str("<label>");
        h_radio("theme", theme_names[k], k == set_theme);
        h_str("<span class=\"swatch sw-");
        h_str(theme_names[k]);
        h_str(if (k == 0) "\"><b class=\"a1\">Aa</b><b class=\"a2\" aria-hidden=\"true\">Aa</b></span><span>" else "\"><b>Aa</b></span><span>");
        h_str(theme_titles[k]);
        h_str("</span></label>")
    }
    h_str("</fieldset></section>");
    h_str("<section><h3 id=\"set-font\">Font</h3><fieldset class=\"group fonts\" aria-labelledby=\"set-font\">");
    for k in 0..len(font_names) {
        if (k != 3 || iowan) {
            h_str("<label class=\"row\"><span style=\"font-family: ");
            h_str(font_faces[k]);
            h_str("\">");
            h_str(font_titles[k]);
            h_str("</span>");
            h_radio("font", font_names[k], k == set_font);
            h_icon("check", "check");
            h_str("</label>")
        }
    }
    h_str("</fieldset></section>");
    h_str("<section><h3>Layout</h3><div class=\"group\">");
    h_segments("spacing", "Line Spacing", spacing_names, spacing_titles, set_spacing);
    h_segments("margins", "Margins", margin_names, margin_titles, set_margins);
    h_str("</div></section>");
    h_str("<section><h3>Show</h3><div class=\"group\">");
    h_switch("vn", "Verse Numbers", set_vn);
    h_switch("heads", "Section Headings", set_heads);
    h_switch("fns", "Footnote Marks", set_fns);
    h_switch("lines", "One Verse per Line", set_lines);
    h_switch("red", "Words of Jesus in Red", set_red);
    h_switch("wake", "Keep the Screen On", set_wake);
    h_str("</div></section>");
    h_str("<section><div class=\"group\">");
    h_switch("keys", "Keyboard Shortcuts", set_keys);
    h_str("</div><p class=\"foot\">Single keys such as G for Go To and / for Search. Turn off if they get in the way.</p></section>");
    h_str("<section><p class=\"foot\">");
    h_str(text_names[r_text]);
    h_str(" \Â\· Public Domain</p><p class=\"foot\"><a href=\"/read/about\">About Smooth Bible</a></p></section></dialog>")
}

settings_open(): bool {
    settings != 0 && dom_get_prop(settings, "open") == 1.0f64
}

open_settings() {
    if (settings_open()) {
        close_settings();
        return
    }
    if (settings != 0) {
        dom_remove(settings);
        dom_free_tree(settings)
    }
    settings_html();
    settings = dom_insert_html_of(DOM_BODY, 2, hb, 0, hb_n);
    dom_listen(settings, "input", 0, &on_setting, 0);
    dom_listen(settings, "change", 0, &on_setting, 0);
    dom_listen(settings, "click", 0, &on_settings_click, 0);
    dom_listen(settings, "close", 0, &on_settings_closed, 0);
    expand_bar();
    dom_call(settings, "show");
    // (The first focus on the size: the sheet's purpose, not Done.)
    size: int = dom_query(settings, "input[name=\"step\"]");
    if (size != 0) {
        dom_call(size, "focus");
        dom_free(size)
    }
}

close_settings() {
    if (settings_open()) dom_call(settings, "close")
}

on_settings_closed(_data: int) {
    aa: int = dom_query(r_bar, ".aa");
    if (aa != 0) {
        dom_call(aa, "focus");
        dom_free(aa)
    }
}

on_settings_click(_data: int) {
    n: int = dom_event_attr("data-act", sbuf);
    if (n <= 0) return;
    if (is_key(sbuf, 0, n, "done")) close_settings() else if (is_key(sbuf, 0, n, "smaller") && set_step > 0) change_step(set_step - 1) else if (is_key(sbuf,
        0, n, "larger") && set_step < 7) change_step(set_step + 1)
}

change_step(n: int) {
    place_now();
    set_step = n;
    range: int = dom_query(settings, "input[name=\"step\"]");
    if (range != 0) {
        wb_n = 0;
        w_int(n);
        dom_set_prop_of(range, "value", wb, 0, wb_n);
        dom_free(range)
    }
    settings_changed(true)
}

// A control in the sheet changed: its setting applied at once and kept,
// the place kept (Â§W3.7).
// (The control's value: its own buffer, as the place's measures use abuf.)
vbuf: []i8 = new i8[64](0i8);

on_setting(_data: int) {
    h: int = dom_event_closest("input");
    if (h == 0) return;
    n: int = dom_get_attr(h, "name", sbuf);
    on: bool = dom_get_prop(h, "checked") == 1.0f64;
    vn: int = dom_get_prop_s(h, "value", vbuf);
    dom_free(h);
    if (n <= 0 || n > len(sbuf) || vn < 0 || vn > len(vbuf)) return;
    // (A range sends input as it moves, and change when let go: the first
    // is enough; a radio or a switch sends change.)
    is_range: bool = is_key(sbuf, 0, n, "step");
    if (is_range != dom_event_is("input")) return;
    place_now();
    theme: bool = false;
    relaid: bool = false;
    if (is_range) {
        k: int = num_at(vbuf, 0, vn);
        if (k == set_step || k < 0 || k > 7) return;
        set_step = k
    } else if (is_key(sbuf, 0, n, "theme")) {
        t: int = name_index(theme_names, vbuf, 0, vn);
        if (!on || t < 0 || t == set_theme) return;
        set_theme = t;
        theme = true
    } else if (is_key(sbuf, 0, n, "font")) {
        f: int = name_index(font_names, vbuf, 0, vn);
        if (!on || f < 0) return;
        set_font = f
    } else if (is_key(sbuf, 0, n, "spacing")) {
        x: int = name_index(spacing_names, vbuf, 0, vn);
        if (!on || x < 0) return;
        set_spacing = x
    } else if (is_key(sbuf, 0, n, "margins")) {
        x: int = name_index(margin_names, vbuf, 0, vn);
        if (!on || x < 0) return;
        set_margins = x
    } else if (is_key(sbuf, 0, n, "vn")) set_vn = on else if (is_key(sbuf, 0, n, "heads")) set_heads = on else if (is_key(sbuf,
        0, n, "fns")) set_fns = on else if (is_key(sbuf, 0, n, "red")) set_red = on else if (is_key(sbuf,
        0, n, "lines")) {
        set_lines = on;
        relaid = true
    } else if (is_key(sbuf, 0, n, "wake")) {
        set_wake = on;
        dom_wake_lock(if (on) 1 else 0)
    } else if (is_key(sbuf, 0, n, "keys")) set_keys = on;
    if (theme) fade_theme();
    if (relaid) r_lines = set_lines;
    // (Only what changes a chapter's height lays the page out again.)
    settings_changed(!theme && !is_key(sbuf, 0, n, "red") && !is_key(sbuf, 0, n, "wake") && !is_key(sbuf,
        0, n, "keys"))
}

settings_changed(relay: bool) {
    apply_settings();
    save_settings();
    if (relay) relayout(true)
}

fade_timer: int = 0;

// A theme's change cross-fades the page (none under reduced motion).
fade_theme() {
    if (dom_media("(prefers-reduced-motion: reduce)") == 1) return;
    dom_add_class(DOM_ROOT, "fading");
    dom_cancel(fade_timer);
    fade_timer = dom_timeout(400.0f64, &on_faded, 0)
}

on_faded(_data: int) {
    dom_remove_class(DOM_ROOT, "fading")
}

// Whether Iowan Old Style is on this device: a line in it measures
// otherwise than in the fallback.
find_iowan() {
    a: int = dom_create("span");
    b: int = dom_create("span");
    dom_set_text(a, "mmmmmmmmmmlli QWERTY");
    dom_set_text(b, "mmmmmmmmmmlli QWERTY");
    dom_set_style(a, "font", "40px 'Iowan Old Style', monospace");
    dom_set_style(b, "font", "40px monospace");
    dom_set_style(a, "position", "absolute");
    dom_set_style(b, "position", "absolute");
    dom_set_style(a, "visibility", "hidden");
    dom_set_style(b, "visibility", "hidden");
    dom_append(DOM_BODY, a);
    dom_append(DOM_BODY, b);
    iowan = dom_get_prop(a, "offsetWidth") != dom_get_prop(b, "offsetWidth");
    dom_remove(a);
    dom_remove(b);
    dom_free(a);
    dom_free(b);
    if (!iowan && set_font == 3) set_font = 0
}

// ---- the keys (Â§W10.1) ----
keys_dialog: int = 0;

dialog_open(): bool {
    settings_open() || keys_dialog != 0 && dom_get_prop(keys_dialog, "open") == 1.0f64
}

on_key(_data: int) {
    if (dom_key_is("Escape") && settings_open()) {
        close_settings();
        return
    }
    if (!set_keys || (dom_ev[DE_MODS] & (DOM_CTRL | DOM_ALT | DOM_META)) != 0 || dialog_open()) return;
    field: int = dom_event_closest("input, textarea, select, [contenteditable], dialog");
    if (field != 0) {
        dom_free(field);
        return
    }
    if (r_bible == 0 && !dom_key_is(",") && !dom_key_is("?")) return;
    if (dom_key_is("]")) {
        place_now();
        if (pl_c + 1 < chapters) jump(pl_c + 1, 0);
        dom_prevent_default()
    } else if (dom_key_is("[")) {
        place_now();
        // (The chapter read's start, if it is above; else the one before.)
        measure_sp();
        top: f64 = sp_top + pos[pl_c] + h2_offset(pl_c) - reading_y();
        c: int = if (scroll_y > top + 1.0f64) pl_c else pl_c - 1;
        if (c >= 0) jump(c, 0);
        dom_prevent_default()
    } else if (dom_key_is("Home")) {
        home();
        dom_prevent_default()
    } else if (dom_key_is(",")) {
        open_settings();
        dom_prevent_default()
    } else if (dom_key_is("?")) {
        open_keys();
        dom_prevent_default()
    }
}

open_keys() {
    if (keys_dialog == 0) {
        hb_n = 0;
        h_str("<dialog class=\"keys settings\" aria-labelledby=\"keys-h\"><header><h2 id=\"keys-h\">Keys</h2><button class=\"done\" type=\"button\" data-act=\"done\">Done</button></header><section><div class=\"group\">");
        h_str("<p class=\"row\"><span>Next chapter</span><kbd>]</kbd></p><p class=\"row\"><span>Previous chapter</span><kbd>[</kbd></p>");
        h_str("<p class=\"row\"><span>Top of the chapter</span><kbd>Home</kbd></p><p class=\"row\"><span>Reading settings</span><kbd>,</kbd></p><p class=\"row\"><span>These keys</span><kbd>?</kbd></p>");
        h_str("</div></section></dialog>");
        keys_dialog = dom_insert_html_of(DOM_BODY, 2, hb, 0, hb_n);
        dom_listen(keys_dialog, "click", 0, &on_keys_click, 0)
    }
    dom_call(keys_dialog, "showModal")
}

on_keys_click(_data: int) {
    n: int = dom_event_attr("data-act", sbuf);
    if (n > 0 && is_key(sbuf, 0, n, "done")) dom_call(keys_dialog, "close")
}

// ---- clicks in the text ----
// A footnote's mark opens its note; a plain click on a link to a place in
// the reader goes there in place (with a modifier or another button, the
// browser does what it does).
on_text_click(_data: int) {
    n: int = dom_event_attr("data-act", sbuf);
    if (n <= 0 || n > len(sbuf)) return;
    if (is_key(sbuf, 0, n, "fn")) {
        dom_prevent_default();
        at: int = -1;
        k: int = dom_event_attr("data-f", abuf);
        n_at: int = if (k > 0) num_at(abuf, 0, k) else 0;
        v: int = 0;
        k = dom_event_attr("data-v", abuf);
        if (k > 0) v = num_at(abuf, 0, k);
        c: int = pl_c;
        k = dom_event_attr("data-c", abuf);
        if (k > 0) c = num_at(abuf, 0, k);
        at = note_line(c, n_at);
        fn_open(c, v, at);
        return
    }
    if (is_key(sbuf, 0, n, "ref")) {
        if ((dom_ev[DE_MODS] & (DOM_CTRL | DOM_ALT | DOM_META | DOM_SHIFT)) != 0 || dom_ev[DE_BUTTON] != 0) return;
        k: int = dom_event_attr("href", abuf);
        if (k <= 0 || k > len(abuf) || !place_of_url(abuf, k)) return;
        dom_prevent_default();
        jump(url_c, url_v)
    }
}

// A reader's address (/read/bsb/john/3#16): url_c and url_v.
url_c: int = 0;

url_v: int = 0;

place_of_url(b: []i8, n: int): bool {
    // (After /read/ and the version: the book's slug, /, the number.)
    p: int = 6;
    while (p < n && b[p] as int != 47) p = p + 1;
    p = p + 1;
    e: int = p;
    while (e < n && b[e] as int != 47) e = e + 1;
    if (e >= n) return false;
    book: int = book_of_slug(b, p, e);
    if (book < 0) return false;
    ch: int = num_at(b, e + 1, n);
    url_c = chapter_of(book, ch);
    url_v = 0;
    if (num_end < n && b[num_end] as int == 35) url_v = num_at(b, num_end + 1, n);
    true
}

// ---- history ----
// Back and Forward: the entry's place, exactly (or its address's chapter).
on_pop(_data: int) {
    // (Back from Go To closes it.)
    if (goto_open()) {
        goto_entry = false;
        dom_call(goto_dlg, "close");
        return
    }
    n: int = dom_state(sbuf);
    if (n > 0 && n <= len(sbuf) && read_place(sbuf, n)) {
        restore_place("back");
        title_c = -1;
        set_title(pl_c, false);
        return
    }
    k: int = dom_get_prop_s(DOM_LOCATION, "pathname", abuf);
    if (k > 0 && k <= len(abuf) && place_of_url(abuf, k)) {
        pl_c = url_c;
        pl_v = 0;
        pl_f = 0.0f64;
        restore_place("back");
        title_c = -1;
        set_title(pl_c, false)
    }
}

// ---- the page's other events ----
resize_timer: int = 0;

// The width read at the last resize: only a new width reflows the text.
// (Safari's bars growing and shrinking as the page scrolls change the
// height alone, many times a scroll: putting the place back then jumped
// the page back to the last rest's, as the owner found.)
seen_width: f64 = 0.0f64;

on_resize(_data: int) {
    measure();
    // (Printing lays the page out for paper: not a new width to read at.)
    if (printing || view_w == seen_width || r_bible == 0) return;
    seen_width = view_w;
    stale = true;
    dom_cancel(resize_timer);
    resize_timer = dom_timeout(100.0f64, &on_resized, 0)
}

// Fonts that came in reflow the text: laid out again (held until the
// reader is still), the place the last rest kept (the text has already
// reflowed under the old places, so it cannot be read now).
on_fonts(_data: int) {
    // (Before the first placement, which calibrates with what has come.)
    if (r_bible == 0) return;
    stale = true;
    relayout(false)
}

// After a new width, laid out again, the place the last rest kept (held
// until the reader is still).
on_resized(_data: int) {
    if (printing) return;
    relayout(false)
}

on_hide(_data: int) {
    if (dom_event_is("visibilitychange") && dom_get_prop_s(DOM_DOCUMENT, "visibilityState",
        abuf) != 6) return;
    place_now();
    save_place()
}

// Print the chapter at the reading line alone, back in the page's flow
// (Â§W3.8, Â§W3.3).
printing: bool = false;

on_print(_data: int) {
    if (r_bible == 0) return;
    printing = dom_event_is("beforeprint");
    if (printing) {
        place_now();
        if (art_h[pl_c] != 0) dom_add_class(art_h[pl_c], "printed");
        dom_add_class(DOM_ROOT, "printing")
    } else {
        dom_class_all(r_main, ".printed", "printed", 0);
        dom_remove_class(DOM_ROOT, "printing");
        dom_cancel(resize_timer);
        measure();
        seen_width = view_w;
        last_y = scroll_y;
        restore_place("print")
    }
}

// The bar: Aa opens Reading settings; the small title expands the bar
// (and goes nowhere until it is expanded).
on_bar_click(_data: int) {
    t: int = dom_event_closest(".title");
    if (t != 0) {
        dom_free(t);
        if (r_bible == 0 || (dom_ev[DE_MODS] & (DOM_CTRL | DOM_ALT | DOM_META | DOM_SHIFT)) != 0) return;
        dom_prevent_default();
        if (bar_p > 0.5f64) expand_bar() else open_goto();
        return
    }
    aa: int = dom_event_closest(".aa");
    if (aa != 0) {
        dom_free(aa);
        open_settings()
    }
}

// ---- start (WEB.md Â§W1.8) ----
// Every reader's address is the same shell: the app reads the address,
// takes up the place's book and the version's sizes table (fetched by the
// boot script as the page began), holds the book (text_load_book, the
// whole Bible's chapter numbers), and places the chapter in its first
// frame; the whole version comes after, at low priority.
text_files: []str = ["bsb", "kjv", "web", "asv", "ylt"];

data_dir: []i8 = new i8[128](0i8);

data_n: int = 0;

// The place to start at (the address's chapter and verse), and whether
// Go To opens over it (/read/bsb/).
start_c: int = 0;

start_v: int = 0;

start_goto: bool = false;

// A book by its address's name (genesis, 1-samuel), from the names every
// version shares; -1 if none.
slug_book(b: []i8, p: int, e: int): int {
    for bk in 0..66 {
        name: str = book_names_all[bk];
        if (len(name) == e - p) {
            same: bool = true;
            for i in 0..len(name) {
                k: int = name[i] as int;
                want: int = if (k == 32) 45 else lower(k);
                if (lower(b[p + i] as int) != want) same = false
            }
            if (same) return bk
        }
    }
    -1
}

// The chapter of book bk numbered n, before any text is held.
chapter_number(bk: int, n: int): int {
    c: int = 0;
    for k in 0..bk c = c + book_chapters[k];
    if (n < 1) c else if (n > book_chapters[bk]) c + book_chapters[bk] - 1 else c + n - 1
}

// The book a chapter number is in.
book_of_chapter(c: int): int {
    k: int = 0;
    at: int = 0;
    while (k < 65 && at + book_chapters[k] <= c) {
        at = at + book_chapters[k];
        k = k + 1
    }
    k
}

// A data file's address into wb: the directory, then name.
w_data(name: str) {
    wb_n = 0;
    for i in 0..data_n w_byte(data_dir[i] as int);
    w_byte(47);
    w_str(name)
}

// When each step of the start happened (ms), for the CI's report.
mark(name: str) {
    t: int = dom_prop_handle(DOM_WINDOW, "sbTimes");
    if (t != 0) {
        dom_set_prop(t, name, dom_now());
        dom_free(t)
    }
}

main(): int {
    dom_start();
    mark("main");
    r_main = dom_by_id("text");
    r_bar = dom_query(DOM_DOCUMENT, "header.bar");
    r_title = dom_query(r_bar, ".title");
    load_settings();
    r_lines = set_lines;
    data: int = dom_prop_handle(DOM_WINDOW, "sbData");
    data_n = dom_get_prop_s(data, "data", data_dir);
    icons_n = dom_get_prop_s(data, "icons", icons);
    dom_free(data);
    // (/read/<version>/<book>/<n>, or /read/<version>/ for Go To over the
    // place; else not a reader's page: About.)
    n: int = dom_get_prop_s(DOM_LOCATION, "pathname", sbuf);
    if (n > len(sbuf)) n = len(sbuf);
    t: int = -1;
    if (n >= 10 && is_key(sbuf, 0, 6, "/read/")) t = name_index(text_files, sbuf,
        6, 9);
    if (t < 0 || n > 9 && sbuf[9] as int != 47 || data_n <= 0 || data_n > len(data_dir)) {
        page_only();
        return 0
    }
    r_text = t;
    r_text_t = t;
    p: int = 10;
    e: int = p;
    while (e < n && sbuf[e] as int != 47) e = e + 1;
    bk: int = if (e > p) slug_book(sbuf, p, e) else -1;
    ch: int = if (e + 1 < n) num_at(sbuf, e + 1, n) else 0;
    if (bk >= 0 && ch > 0) start_c = chapter_number(bk, ch) else {
        // (The place kept, if in this version.)
        start_goto = e == p;
        start_c = (if (bk >= 0) chapter_number(bk, 1) else 0);
        k: int = dom_store_get("sb.place", vbuf);
        if (k > 9 && k <= len(vbuf) && is_key(vbuf, 6, 9, text_files[t])) {
            q: int = 10;
            while (q < k && vbuf[q] as int != 47) q = q + 1;
            pb: int = slug_book(vbuf, 10, q);
            if (pb >= 0 && (bk < 0 || pb == bk)) start_c = chapter_number(pb, num_at(vbuf,
                q + 1, k))
        }
    }
    h: int = dom_get_prop_s(DOM_LOCATION, "hash", abuf);
    start_v = (if (h > 1 && h <= len(abuf)) num_at(abuf, 1, h) else 0);
    dom_set_prop_s(DOM_HISTORY, "scrollRestoration", "manual");
    reader_begin();
    // (The two first files, as the boot script began them.)
    w_data(text_files[t]);
    w_str(".sizes.gz");
    dom_fetch_gz_of(wb, 0, wb_n, &on_sizes, 0);
    fetch_book(book_of_chapter(start_c));
    0
}

page_only() {
    find_iowan();
    dom_add_class(DOM_ROOT, "app");
    dom_listen(DOM_WINDOW, "keydown", 0, &on_key, 0);
    dom_listen(r_bar, "click", 0, &on_bar_click, 0);
    dom_media_listen("(prefers-color-scheme: dark)", &on_scheme, 0);
    dom_set_prop(DOM_WINDOW, "sbReady", dom_now())
}

// The page's parts made, and what tells whether a finger or a button is
// down and the page moving, from the start (the first placement waits for
// rest).
reader_begin() {
    find_iowan();
    dom_add_class(DOM_ROOT, "app");
    t: int = dom_query(r_title, ".tt");
    r_t[0] = dom_query(t, ".t");
    r_t[1] = dom_create("span");
    dom_set_class(r_t[1], "t out");
    dom_set_attr(r_t[1], "aria-hidden", "true");
    dom_append(t, r_t[1]);
    dom_free(t);
    fn_make();
    t_box = dom_create("div");
    dom_set_class(t_box, "measure");
    dom_set_attr(t_box, "aria-hidden", "true");
    dom_append(r_main, t_box);
    // (The version's name for the hidden h1, and its line at the foot.)
    h1: int = dom_query(DOM_DOCUMENT, "h1.vh");
    if (h1 != 0) {
        dom_set_text(h1, text_names[r_text]);
        dom_free(h1)
    }
    cv: int = dom_query(DOM_DOCUMENT, ".credit .cv");
    if (cv != 0) {
        wb_n = 0;
        w_str(text_names[r_text]);
        w_str(" \Â\· Public Domain");
        dom_set_text_of(cv, wb, 0, wb_n);
        dom_free(cv)
    }
    dom_set_attr(DOM_ROOT, "data-version", text_files[r_text]);
    has_scrollend = dom_has_prop(DOM_WINDOW, "onscrollend") == 1;
    dom_listen(DOM_WINDOW, "scroll", DOM_PASSIVE, &on_scroll, 0);
    if (has_scrollend) dom_listen(DOM_WINDOW, "scrollend", DOM_PASSIVE, &on_scrollend,
        0);
    dom_listen(DOM_WINDOW, "touchstart", DOM_PASSIVE, &on_touch, 0);
    dom_listen(DOM_WINDOW, "touchmove", DOM_PASSIVE, &on_touch, 0);
    dom_listen(DOM_WINDOW, "touchend", DOM_PASSIVE, &on_touch, 0);
    dom_listen(DOM_WINDOW, "touchcancel", DOM_PASSIVE, &on_touch, 0);
    dom_listen(DOM_WINDOW, "pointerdown", DOM_PASSIVE, &on_pointer, 0);
    dom_listen(DOM_WINDOW, "pointerup", DOM_PASSIVE, &on_pointer, 0);
    dom_listen(DOM_WINDOW, "pointercancel", DOM_PASSIVE, &on_pointer, 0);
    fonts_h = dom_prop_handle(DOM_DOCUMENT, "fonts");
    if (fonts_h != 0) dom_listen(fonts_h, "loadingdone", 0, &on_fonts, 0);
    measure();
    last_y = scroll_y
}

// ---- the texts as they come ----
// The books asked for (once each) and held; the sizes table; the whole.
book_asked: []bool = new bool[66](false);

book_held: bool = false;

sizes_held: bool = false;

whole_held: bool = false;

fetch_book(bk: int) {
    if (book_asked[bk] || whole_held) return;
    book_asked[bk] = true;
    w_data(text_files[r_text]);
    w_byte(47);
    w_str(book_codes[bk]);
    w_str(".gz");
    dom_fetch_gz_of(wb, 0, wb_n, &on_book, bk)
}

on_sizes(_data: int) {
    if (dom_ev[DE_STATUS] != 200) {
        dom_log("smooth bible: the sizes did not load");
        return
    }
    b: []i8 = dom_fetch_body(dom_ev[DE_ID]);
    sizes_read(b, len(b));
    sizes_held = true;
    mark("sizes");
    if (book_held && r_bible == 0) first_paint()
}

on_book(bk: int) {
    if (dom_ev[DE_STATUS] != 200) {
        dom_log("smooth bible: a book did not load");
        return
    }
    if (whole_held) return;
    b: []i8 = dom_fetch_body(dom_ev[DE_ID]);
    room: []i8 = dom_bytes(text_book_room(bk, len(b)));
    text_load_book(r_text, bk, b, len(b), room);
    text_use(r_text);
    if (r_text == TEXT_BSB) bsb = tx_buf[TEXT_BSB];
    book_held = true;
    mark("book");
    if (r_bible == 0) {
        if (sizes_held) first_paint()
    } else {
        // (The chapters of a book that came: their estimates from their
        // text, the window able to write them.)
        refine_estimates();
        ask_frame()
    }
}

// The first placement (Â§W3.3 item 7): the table from the sizes table and
// the book held, the scroller built, the chapter written and placed (the
// address's verse a third of the way down, flashed; or the place the entry
// or storage kept; or the chapter's opener under the bar), all before any
// text is painted.
cal_tries: int = 0;

first_paint() {
    if (finger_down || pointer_down || dom_now() - moved_at < 300.0f64) {
        dom_cancel(relayout_timer);
        relayout_timer = dom_timeout(100.0f64, &on_first, 0);
        return
    }
    measure();
    mark("calibrating");
    calibrate();
    mark("calibrated");
    // (Drawing the calibration makes the browser fetch the faces the text
    // needs, if the device has no font of its own before them: until they
    // are in, a moment more, three seconds at most, so the first text is
    // drawn in its own font and never swapped.)
    cal_tries = cal_tries + 1;
    if (fonts_h != 0 && cal_tries < 30 && dom_get_prop_s(fonts_h, "status", abuf) == 7) {
        dom_cancel(relayout_timer);
        relayout_timer = dom_timeout(100.0f64, &on_first, 0);
        return
    }
    make_key();
    estimate_all(r_lines);
    mark("estimated");
    c: int = start_c;
    choose_range(c);
    pos_from(slack_for(c));
    phs_now = false;
    build_scroller();
    title_c = -1;
    pl_c = c;
    pl_v = 0;
    pl_f = 0.0f64;
    placed: bool = false;
    n: int = dom_state(sbuf);
    if (n > 0 && n <= len(sbuf) && read_place(sbuf, n) && pl_c == c) placed = true;
    if (!placed && start_v == 0) {
        k: int = dom_store_get("sb.place", sbuf);
        sp: int = 0;
        while (sp < k && sbuf[sp] as int != 32) sp = sp + 1;
        if (k > 0 && k <= len(sbuf) && sp < k && read_place_at(sbuf, sp + 1, k) && pl_c == c) placed = true else {
            pl_c = c;
            pl_v = 0;
            pl_f = 0.0f64
        }
    }
    y: f64 = place_y();
    if (!placed && start_v > 0 && verse_box(c, start_v)) y = scroll_y + v_top - reading_y() - (view_h - bar_h) / 3.0f64 else if (!placed) y = y + h2_offset(c);
    scroll_write(y, "start");
    mark("placed");
    if (!placed && start_v > 0) flash(c, start_v);
    fill_now();
    set_title(c, false);
    place_now();
    last_y = scroll_y;
    // (Kept, the address left as it came, #16 and all, till the reader
    // moves.)
    keep_place();
    after_start();
    phs_timer = dom_timeout(50.0f64, &write_placeholders, 0);
    // (The whole version next, at low priority.)
    w_data(text_files[r_text]);
    w_str(".gz");
    dom_fetch_gz_low_of(wb, 0, wb_n, &on_whole, 0);
    if (start_goto) open_goto()
}

on_first(_data: int) {
    first_paint()
}

// The whole version: it replaces the books held (the same chapter
// numbers, nothing redrawn), and the estimates are made from its text.
on_whole(_data: int) {
    if (dom_ev[DE_STATUS] != 200) {
        dom_log("smooth bible: the text did not load");
        return
    }
    buf: []i8 = dom_fetch_body(dom_ev[DE_ID]);
    text_load(r_text, buf, len(buf));
    text_use(r_text);
    if (r_text == TEXT_BSB) bsb = buf;
    whole_held = true;
    refine_estimates();
    ask_frame();
    dom_set_prop(DOM_WINDOW, "sbWhole", dom_now())
}

// The page's events, once the first chapter is placed.
after_start() {
    dom_listen(DOM_WINDOW, "resize", DOM_PASSIVE, &on_resize, 0);
    dom_listen(DOM_WINDOW, "popstate", 0, &on_pop, 0);
    dom_listen(DOM_WINDOW, "keydown", 0, &on_key, 0);
    dom_listen(DOM_WINDOW, "pagehide", 0, &on_hide, 0);
    dom_listen(DOM_DOCUMENT, "visibilitychange", 0, &on_hide, 0);
    dom_listen(DOM_WINDOW, "beforeprint", 0, &on_print, 0);
    dom_listen(DOM_WINDOW, "afterprint", 0, &on_print, 0);
    dom_listen(r_main, "click", 0, &on_text_click, 0);
    dom_listen(r_bar, "click", 0, &on_bar_click, 0);
    dom_listen(r_bar, "focusin", 0, &on_bar_focus, 0);
    dom_listen(r_bar, "focusout", 0, &on_bar_focus, 0);
    measure();
    seen_width = view_w;
    dom_media_listen("(prefers-color-scheme: dark)", &on_scheme, 0);
    if (set_wake) dom_wake_lock(1);
    dom_listen(DOM_WINDOW, "sbcheck", 0, &on_check, 0);
    bg_schedule(300.0f64);
    dom_set_prop(DOM_WINDOW, "sbReady", dom_now())
}

sbuf2: []i8 = new i8[512](0i8);

// A place from b's p on (sb.place's, after its address).
read_place_at(b: []i8, p: int, n: int): bool {
    for i in p..n sbuf2[i - p] = b[i];
    read_place(sbuf2, n - p)
}

on_scheme(_data: int) {
    if (set_theme == 0) apply_settings()
}

// For the CI (Â§W3.3's estimates check): every chapter of this scroller's
// range estimated from its text and measured at the page's width, and
// estimated from the sizes table, published as window.sbCheck ("c
// estimate measured from-sizes;" each, in tenths of a px; the whole text
// must have come).
on_check(_data: int) {
    tb_n = 0;
    for c in sc_first..sc_last + 1 {
        o_int(c);
        o_byte(32);
        o_int((est_chapter(c, r_lines) * 10.0f64) as int);
        o_byte(32);
        o_int((measure_one(c, r_lines) * 10.0f64) as int);
        o_byte(32);
        o_int((est_from_sizes(c) * 10.0f64) as int);
        o_byte(59)
    }
    dom_set_prop_of(DOM_WINDOW, "sbCheck", tb_out, 0, tb_n)
}

// ---- Go To, its first form (WEB.md Â§W1.8, Â§W5.2 without the field,
// Recent or the tip) ----
// The books under Old Testament and New Testament, each a row that opens
// in place to its chapters as links (one book open at a time; a book of one
// chapter is a link itself), the current chapter filled; opened by the
// title and at /read/<version>/. It is a history entry: Back closes it, and
// a chapter chosen replaces the entry with the jump.
goto_dlg: int = 0;

goto_entry: bool = false;

goto_html() {
    hb_n = 0;
    h_str("<dialog class=\"goto sheet\" aria-labelledby=\"goto-h\"><header><h2 id=\"goto-h\">Go To</h2><button class=\"done\" type=\"button\" data-act=\"done\">Done</button></header><div class=\"cols\">");
    cur: int = if (title_c >= 0) title_c else pl_c;
    for testament in 0..2 {
        h_str(if (testament == 0) "<section><h3>Old Testament</h3><div class=\"group\">" else "<section><h3>New Testament</h3><div class=\"group\">");
        for b in if (testament == 0) 0 else 39..if (testament == 0) 39 else 66 {
            if (book_count[b] == 1) {
                h_str("<a class=\"row book\" href=\"");
                h_chapter_url(r_text, book_first[b], 0, 0);
                h_str("\">");
                h_text(bsb, book_name_start(b), book_name_end(b));
                h_str("</a>")
            } else {
                h_str("<details name=\"book\"");
                if (ch_book[cur] == b) h_str(" open");
                h_str("><summary class=\"row\"><span>");
                h_text(bsb, book_name_start(b), book_name_end(b));
                h_str("</span><span class=\"n\">");
                h_int(book_count[b]);
                h_str("</span>");
                h_icon("chevron-down", "chev");
                h_str("</summary><ol class=\"chapters\">");
                for n in 0..book_count[b] {
                    c: int = book_first[b] + n;
                    h_str("<li><a href=\"");
                    h_chapter_url(r_text, c, 0, 0);
                    h_str("\"");
                    if (c == cur) h_str(" aria-current=\"page\"");
                    h_str(">");
                    h_int(n + 1);
                    h_str("</a></li>")
                }
                h_str("</ol></details>")
            }
        }
        h_str("</div></section>")
    }
    h_str("</div></dialog>")
}

goto_open(): bool {
    goto_dlg != 0 && dom_get_prop(goto_dlg, "open") == 1.0f64
}

open_goto() {
    if (goto_open()) return;
    if (goto_dlg != 0) {
        dom_remove(goto_dlg);
        dom_free_tree(goto_dlg)
    }
    goto_html();
    goto_dlg = dom_insert_html_of(DOM_BODY, 2, hb, 0, hb_n);
    dom_listen(goto_dlg, "click", 0, &on_goto_click, 0);
    dom_listen(goto_dlg, "close", 0, &on_goto_closed, 0);
    expand_bar();
    // (Its own entry, so Back closes it.)
    place_now();
    save_place();
    wb_n = 0;
    w_url(if (title_c >= 0) title_c else pl_c, 0);
    gs: []i8 = goto_state;
    dom_push(wb, wb_n, gs, 4);
    goto_entry = true;
    dom_call(goto_dlg, "showModal");
    // (The current book's row in the middle of the list, and the first
    // focus on its chapter: the dialog's purpose, not Done.)
    cur: int = dom_query(goto_dlg, "details[open]");
    if (cur != 0) {
        dom_scroll_into_view(cur, 1, 0);
        dom_free(cur)
    }
    here: int = dom_query(goto_dlg, "[aria-current]");
    if (here != 0) {
        dom_call(here, "focus");
        dom_free(here)
    }
}

goto_state: []i8 = [103i8, 111i8, 116i8, 111i8];

// Closed by Done, Escape or a chapter: its entry goes too (Back), unless a
// jump replaced it or Back closed it.
on_goto_closed(_data: int) {
    if (goto_entry) {
        goto_entry = false;
        dom_call(DOM_HISTORY, "back")
    }
    t: int = dom_query(r_bar, ".title");
    if (t != 0) {
        dom_call(t, "focus");
        dom_free(t)
    }
}

on_goto_click(_data: int) {
    n: int = dom_event_attr("data-act", sbuf);
    if (n > 0 && is_key(sbuf, 0, n, "done")) {
        dom_call(goto_dlg, "close");
        return
    }
    if ((dom_ev[DE_MODS] & (DOM_CTRL | DOM_ALT | DOM_META | DOM_SHIFT)) != 0 || dom_ev[DE_BUTTON] != 0) return;
    k: int = dom_event_attr("href", abuf);
    if (k <= 0 || k > len(abuf) || !place_of_url(abuf, k)) return;
    dom_prevent_default();
    // (The jump takes the dialog's entry.)
    goto_entry = false;
    dom_call(goto_dlg, "close");
    go(url_c, url_v, true)
}
