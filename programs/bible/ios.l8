tag bible_ios;

use_tag std, ios, bible;

// Smooth Bible, the Bible app for an iPhone, built with `l8 arm64 --target
// ios` (see tools/ios/build.sh and programs/bible/ios/): the Berean Standard
// Bible to read, in UIKit's own views, so it reads, scrolls, selects and
// copies as the phone's own apps do.
//
// A navigation controller holds a table of every chapter, one after
// another, read on by scrolling from Genesis 1 to Revelation 22. Each row is
// a text view of one attributed string (text.l8 lays the chapter out as
// runs; each run here is a string in its style, ios_look.l8), with the
// reader's highlights, bookmarks and notes in it (ios_store.l8 keeps them).
// The bar's title is the chapter being read, shown once its opener has
// scrolled up under the bar; it opens the passage picker. The bar's other
// buttons open search, the library and the reading settings (sheets,
// ios_sheets.l8). A tap on a verse selects it, and a tray of what can be
// done with the verses selected comes up (ios_select.l8); a tap elsewhere
// hides or shows the bars, which scrolling on through the text hides too
// and scrolling back shows. Where the reader was is kept, by its verse.
//
// Links (bsb://JHN/3) open a chapter. With L8_DEMO=1 in the environment,
// Darwin notifications take it through a demo, for the simulator in CI (see
// ios_demo.l8 and programs/bible/ios/simulate.sh).
import "../../stdlib/print.l8";

import "../ios/objc.l8";

import "text.l8";

import "ios_look.l8";

import "ios_store.l8";

import "ios_select.l8";

import "ios_sheets.l8";

import "lang.l8";

import "ios_study.l8";

import "ios_bar.l8";

import "ios_preview.l8";

import "ios_listen.l8";

import "ios_history.l8";

import "ios_library.l8";

import "ios_demo.l8";

import "ios_demo3.l8";

import "ios_versions.l8";

import "ios_esv.l8";

import "ios_compare.l8";

import "ios_demo4.l8";

import "ios_study2.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

extern getenv(name: str): ?*i8;

extern msg_super0(sup: *ObjcSuper, selector: int): int = objc_msgSendSuper;

extern msg_f4(
    receiver: int,
    selector: int,
    t: f64,
    a: int,
    b: int,
    c: int,
    d: int
): int = objc_msgSend;

extern msg1_ff(
    receiver: int,
    selector: int,
    a: int,
    x: f64,
    y: f64
): int = objc_msgSend;

// [super selector], from a method of cls (the class that defines it).
super0(self: int, cls: int, selector: int) {
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(cls) };
    msg_super0(&sup, selector)
}

// A line of diagnostics (the console), only with L8_DEMO or L8_TIMING in
// the environment: a build in normal use says nothing.
note(what: str) {
    if (!diag_on) return;
    try {
        eprint(what)
    } with IoError _e -> { }
}

// A number in the log (in the demo, to see what happened).
note_num(label: str, n: int) {
    if (!diag_on) return;
    try {
        write(2, label);
        write_int(2, n);
        write(2, "\n")
    } with IoError _e -> { }
}

// ---- what UIKit made ----
app_obj: int = 0;

window: int = 0;

nav: int = 0;

// The table of chapters (and its controller).
reader: int = 0;

table: int = 0;

// The chapter's name at the top: a button in a view (whose alpha fades it).
title_view: int = 0;

// (The view inside it that fades: the bar sets the title view's own alpha
// as it changes.)
title_fader: int = 0;

title_button: int = 0;

nav_class: int = 0;

reader_class: int = 0;

// The chapter being read (the one at the top), and how far down into it
// (points).
cur: int = 0;

cur_y: f64 = 0.0f64;

// Where the reader was when the app was last shut: its chapter, verse (0
// above the first), and how far into that (thousandths of em).
restore_c: int = 0;

restore_v: int = 0;

restore_frac: int = 0;

restored: bool = false;

bars_hidden: bool = false;

// A drag: the highest and lowest the text has been during it.
drag_top: f64 = 0.0f64;

drag_low: f64 = 0.0f64;

// Results of four doubles (msg_hfa), kept: callbacks run outside any region.
hfa: []f64 = new f64[4](0.0f64);

one: []int = new int[8](0);

timer_class: int = 0;

// The characters cp and then cp2 (if not 0) as an NSString.
ubuf: []i8 = new i8[8](0i8);

ubuf_n: int = 0;

uput(cp: int) {
    if (cp < 128) {
        ubuf[ubuf_n] = cp trunc i8;
        ubuf_n = ubuf_n + 1
    } else if (cp < 2048) {
        ubuf[ubuf_n] = (192 + cp / 64) trunc i8;
        ubuf[ubuf_n + 1] = (128 + cp % 64) trunc i8;
        ubuf_n = ubuf_n + 2
    } else {
        ubuf[ubuf_n] = (224 + cp / 4096) trunc i8;
        ubuf[ubuf_n + 1] = (128 + cp / 64 % 64) trunc i8;
        ubuf[ubuf_n + 2] = (128 + cp % 64) trunc i8;
        ubuf_n = ubuf_n + 3
    }
}

ustr(cp: int, cp2: int): int {
    ubuf_n = 0;
    uput(cp);
    if (cp2 != 0) uput(cp2);
    nsstring_of(ubuf, ubuf_n)
}

// Whether object o answers selector name.
responds(o: int, name: str): bool {
    (msg1(o, sel("respondsToSelector:"), sel(name)) & 255) != 0
}

nsnumber_int(n: int): int {
    msg1(cls("NSNumber"), sel("numberWithLong:"), n)
}

// A timer that sends selector name to the app after t seconds.
after(t: f64, name: str): int {
    msg_f4(cls("NSTimer"), sel("scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:"),
        t, app_obj, sel(name), 0, 0)
}

stop_timer(timer: int): int {
    if (timer != 0) msg(timer, sel("invalidate"));
    0
}

// ---- the chapter as an attributed string ----
// For each byte of out (and its end), how many UTF-16 units come before it.
u16_at: []int = new int[262145](0);

// The verses of the chapter last measured (compute_ranges): their numbers,
// and where each is in its text (UTF-16), from its number to its end, with
// the marks put in.
rv_c: int = -1;

rv_count: int = 0;

rv_num: []int = new int[200](0);

rv_b: []int = new int[200](0);

rv_e: []int = new int[200](0);

// Whether a verse's wash goes on over the space after it (to the next).
rv_joins: []bool = new bool[200](false);

// The marks put in: where (before them), how many units, and what (0 a
// bookmark, 1 a note, 2 the chapter's note, after its label), for which
// verse.
ev_n: int = 0;

ev_pos: []int = new int[400](0);

ev_len: []int = new int[400](0);

ev_kind: []int = new int[400](0);

ev_verse: []int = new int[400](0);

// Where each chapter's opener ends (its numeral, UTF-16), once laid out.
opener16: []int = new int[1200](0);

// Chapter c laid out (text.l8), its verses measured.
compute_ranges(c: int) {
    layout_chapter(c);
    n: int = 0;
    for i in 0..out_n {
        u16_at[i] = n;
        k: int = out[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    u16_at[out_n] = n;
    opener16[c] = u16_at[opener_at];
    rv_c = c;
    rv_count = verse_count;
    ev_n = 0;
    // (The chapter's own note: its mark after the chapter's label.)
    if (note_of(c, 0) >= 0 && label_end > 0) add_event(u16_at[label_end], 2, 2, 0);
    for i in 0..verse_count {
        b: int = verse_begin[i];
        e: int = verse_end[i];
        if (e < 0) e = (if (b >= 0) b else 0);
        if (b < 0) b = e;
        v: int = verse_num[i];
        rv_num[i] = v;
        rv_b[i] = u16_at[b];
        rv_e[i] = u16_at[e];
        rv_joins[i] = e < out_n && out[e] as int == 32;
        if (is_bookmarked(c, v)) add_event(rv_b[i], 2, 0, v);
        if (note_of(c, v) >= 0) add_event(rv_e[i], 2, 1, v)
    }
    // (Each verse's place, past the marks put in before it: a bookmark
    // before its number is not in it, nor its note after its end.)
    shift: int = 0;
    j: int = 0;
    for i in 0..rv_count {
        b: int = rv_b[i];
        while (j < ev_n && ev_pos[j] <= b) {
            shift = shift + ev_len[j];
            j = j + 1
        }
        rv_b[i] = b + shift;
        e: int = rv_e[i];
        while (j < ev_n && ev_pos[j] < e) {
            shift = shift + ev_len[j];
            j = j + 1
        }
        rv_e[i] = e + shift
    }
}

add_event(
    pos: int,
    n: int,
    kind: int,
    v: int
) {
    if (ev_n >= len(ev_pos)) return;
    ev_pos[ev_n] = pos;
    ev_len[ev_n] = n;
    ev_kind[ev_n] = kind;
    ev_verse[ev_n] = v;
    ev_n = ev_n + 1
}

// The verse table's row for verse v (of the chapter measured), or -1.
rv_index(v: int): int {
    for i in 0..rv_count
        if (rv_num[i] == v) return i;
    -1
}

// The verse whose text is at UTF-16 index k (of the chapter measured), or
// -1.
rv_at(k: int): int {
    for i in 0..rv_count
        if (k >= rv_b[i] && k < rv_e[i]) return i;
    -1
}

// An attachment of a symbol's image, h points tall, its foot y above the
// baseline.
symbol_attachment(name: str, h: f64, y: f64): int {
    image: int = symbol(name, h * 1.2f64, 5, c_accent);
    att: int = msg1(cls("NSTextAttachment"), sel("textAttachmentWithImage:"), image);
    l8_msg_hfa(hfa, image, sel("size"), 0, 0, 0);
    w: f64 = if (hfa[1] > 0.0f64) hfa[0] * h / hfa[1] else h;
    msg_rect(att, sel("setBounds:"), 0.0f64, y, w, h);
    att
}

// A mark put into s at an event: an attachment with the attributes of the
// text beside it (and a hair or thin space).
put_event(s: int, j: int) {
    pos: int = ev_pos[j];
    n: int = msg(s, sel("length"));
    at: int = if (ev_kind[j] >= 1) pos - 1 else pos;
    if (at < 0) at = 0;
    if (at >= n) at = n - 1;
    base: int = msg2(s, sel("attributesAtIndex:effectiveRange:"), at, 0);
    att: int = if (ev_kind[j] == 0) symbol_attachment("bookmark.fill", em * 0.55f64,
        em * 0.3f64) else symbol_attachment("note.text", em * 0.62f64, -em * 0.04f64);
    msg1(att, sel("setAccessibilityLabel:"), nsstring(if (ev_kind[j] == 0) "Bookmark" else if (ev_kind[j] == 2) "Chapter Note" else "Note"));
    d: int = msg(base, sel("mutableCopy"));
    msg2(d, sel("setObject:forKey:"), att, k_attachment);
    if (ev_kind[j] == 1) msg2(d, sel("setObject:forKey:"), nsnumber_int(ev_verse[j]),
        nsstring(k_note_mark));
    if (ev_kind[j] == 2) msg2(d, sel("setObject:forKey:"), nsnumber_int(1), nsstring(k_chapter_note));
    glyph: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        ustr(65532, 0), d);
    space: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        ustr(if (ev_kind[j] == 0) 8202 else 8201, 0), base);
    ins: int = make("NSMutableAttributedString");
    if (ev_kind[j] == 0) {
        msg1(ins, sel("appendAttributedString:"), glyph);
        msg1(ins, sel("appendAttributedString:"), space)
    } else {
        msg1(ins, sel("appendAttributedString:"), space);
        msg1(ins, sel("appendAttributedString:"), glyph)
    }
    msg2(s, sel("insertAttributedString:atIndex:"), ins, pos);
    release(ins);
    release(glyph);
    release(space);
    release(d)
}

// The verse flashed after a jump to it (its chapter, or -1).
flash_c: int = -1;

flash_v: int = 0;

// The verse being read aloud (its chapter, or -1): washed as a selection
// is, without the underline.
speak_c: int = -1;

speak_v: int = 0;

// A chapter painted for a preview: its highlights, not the reader's
// selection, flash or reading aloud.
painting_preview: bool = false;

// The washes on chapter c's text s (the chapter measured): highlights,
// the verses selected, and a verse flashed.
paint_marks(s: int, c: int) {
    n: int = msg(s, sel("length"));
    msg3(s, sel("removeAttribute:range:"), k_background, 0, n);
    msg3(s, sel("removeAttribute:range:"), k_underline, 0, n);
    for i in 0..rv_count {
        v: int = rv_num[i];
        color: int = highlight_of(c, v);
        b: int = rv_b[i];
        e: int = rv_e[i];
        if (color >= 0) {
            // (Joined to the next verse's, if it is the same color.)
            to: int = e;
            if (i + 1 < rv_count && rv_joins[i] && highlight_of(c, rv_num[i + 1]) == color) to = rv_b[i + 1];
            if (to > n) to = n;
            if (to > b) msg4(s, sel("addAttribute:value:range:"), k_background, c_hl[color],
                b, to - b)
        }
        if (painting_preview) { } else if (c == sel_c && is_selected(v) && e > b && e <= n) {
            msg4(s, sel("addAttribute:value:range:"), k_background, c_sel, b, e - b);
            msg4(s, sel("addAttribute:value:range:"), k_underline, nsnumber_int(257),
                b, e - b);
            msg4(s, sel("addAttribute:value:range:"), k_underline_color, c_underline,
                b, e - b)
        }
        if (!painting_preview && c == flash_c && v == flash_v && e > b && e <= n) msg4(s,
            sel("addAttribute:value:range:"), k_background, c_flash, b, e - b);
        if (!painting_preview && c == speak_c && v == speak_v && e > b && e <= n) msg4(s,
            sel("addAttribute:value:range:"), k_background, c_sel, b, e - b)
    }
}

// Chapter c as an attributed string (autoreleased).
chapter_text(c: int): int {
    compute_ranges(c);
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    base: int = bytes_address(out);
    p: int = 0;
    for r in 0..runs {
        e: int = run_end[r];
        a: int = 0;
        if (run_style[r] == STYLE_RULE) {
            // The divider: the hairline's attachment, then the line's end.
            d: int = msg(attrs_for(r), sel("mutableCopy"));
            msg2(d, sel("setObject:forKey:"), rule_attachment, k_attachment);
            a = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
                ustr(65532, 10), d);
            release(d)
        } else a = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
            nsstring_at(base + p, e - p), attrs_for(r));
        msg1(s, sel("appendAttributedString:"), a);
        release(a);
        p = e
    }
    // (No empty line after the chapter's last, and no space after it: the
    // space between chapters is the next one's.)
    n: int = msg(s, sel("length"));
    if (n > 1) {
        msg2(s, sel("deleteCharactersInRange:"), n - 1, 1);
        n = n - 1;
        last_nl: int = msg2(msg(s, sel("string")), sel("rangeOfString:options:"),
            nsstring("\n"), 4);
        from: int = if (last_nl >= 0 && last_nl < n) last_nl + 1 else 0;
        if (from < n) {
            ps: int = msg3(s, sel("attribute:atIndex:effectiveRange:"), k_para, n - 1,
                0);
            if (ps != 0) {
                p2: int = msg(ps, sel("mutableCopy"));
                msg_set_f(p2, sel("setParagraphSpacing:"), 0.0f64);
                msg4(s, sel("addAttribute:value:range:"), k_para, p2, from, n - from);
                release(p2)
            }
        }
    }
    j: int = ev_n - 1;
    while (j >= 0) {
        put_event(s, j);
        j = j - 1
    }
    paint_marks(s, c);
    // (The ESV's: its line at the end of a chapter; or, while a chapter is
    // not here, what stands for it.)
    if (text_cur == TEXT_ESV && !painting_preview) {
        if (lay_placeholder) {
            esv_placeholder(s, c);
            compute_ranges(c)
        } else esv_footer(s)
    }
    s
}

// The washes of chapter c, painted again where it is on the screen.
repaint(c: int) {
    tv: int = view_of(c);
    if (tv == 0) return;
    compute_ranges(c);
    storage: int = msg(tv, sel("textStorage"));
    msg(storage, sel("beginEditing"));
    paint_marks(storage, c);
    msg(storage, sel("endEditing"))
}

// Chapter c made again where it is on the screen (its marks changed), the
// place kept.
remake(c: int) {
    tv: int = view_of(c);
    if (tv == 0) return;
    msg1(tv, sel("setAttributedText:"), chapter_text(c));
    msg(table, sel("beginUpdates"));
    msg(table, sel("endUpdates"))
}

// ---- the chapters, one after another ----
// The table's rows: a row a chapter, each a text view (not scrolling by
// itself: the table does) of the chapter, its tag the chapter plus one.
is_reader(t: int): bool {
    t != 0 && t == table
}

chapter_path(c: int): int {
    msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), c, 0)
}

// The text's side margins, for the table's width now.
side_margin(): f64 {
    l8_msg_hfa(hfa, table, sel("bounds"), 0, 0, 0);
    w: f64 = hfa[2];
    m: f64 = margins[set_margins];
    if (w - 2.0f64 * m > 600.0f64) m = (w - 600.0f64) / 2.0f64;
    m
}

chapter_cell(t: int, path: int): int {
    c: int = msg(path, sel("row"));
    cell: int = msg1(t, sel("dequeueReusableCellWithIdentifier:"), nsstring("chapter"));
    if (cell == 0) {
        cell = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
            0, nsstring("chapter")), sel("autorelease"));
        msg1(cell, sel("setSelectionStyle:"), 0);
        content: int = msg(cell, sel("contentView"));
        tv: int = msg_rect(msg(cls("UITextView"), sel("alloc")), sel("initWithFrame:"),
            0.0f64, 0.0f64, 320.0f64, 100.0f64);
        msg1(tv, sel("setScrollEnabled:"), 0);
        msg1(tv, sel("setEditable:"), 0);
        msg1(tv, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
        msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
        msg1(tv, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(tv, sel("setDelegate:"), app_obj);
        tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
            app_obj, sel("tapped:"));
        msg1(tap, sel("setDelegate:"), app_obj);
        msg1(tv, sel("addGestureRecognizer:"), tap);
        release(tap);
        msg1(content, sel("addSubview:"), tv);
        release(tv);
        pin(tv, content, "leadingAnchor");
        pin(tv, content, "trailingAnchor");
        pin(tv, content, "topAnchor");
        pin(tv, content, "bottomAnchor")
    }
    msg1(cell, sel("setBackgroundColor:"), c_bg);
    tv: int = text_of_cell(cell);
    msg1(tv, sel("setTintColor:"), c_accent);
    m: f64 = side_margin();
    msg_rect(tv, sel("setTextContainerInset:"), if (c == 0) top_gap() else em * 2.4f64,
        m, if (c + 1 == chapters) 120.0f64 else 0.0f64, m);
    msg1(tv, sel("setAttributedText:"), chapter_text(c));
    msg1(tv, sel("setTag:"), c + 1);
    esv_dress(tv, c);
    esv_row_shown(c);
    cell
}

// The Bible's first gap: 0.8 em from the bar to the tops of "Genesis"'s
// capitals.
top_gap(): f64 {
    f: int = fonts[STYLE_BOOK];
    g: f64 = em * 0.8f64 - (msg_f(f, sel("ascender")) - msg_f(f, sel("capHeight")));
    if (g < 0.0f64) 0.0f64 else g
}

// Edge name of a and b, the same.
pin(a: int, b: int, edge: str) {
    msg1(msg1(msg(a, sel(edge)), sel("constraintEqualToAnchor:"), msg(b, sel(edge))),
        sel("setActive:"), 1)
}

// Edge name of a, at d points past b's.
pin_by(
    a: int,
    b: int,
    edge: str,
    d: f64
) {
    msg1(msg1_f(msg(a, sel(edge)), sel("constraintEqualToAnchor:constant:"), msg(b,
        sel(edge)), d), sel("setActive:"), 1)
}

// A's edge ea at d points past b's edge eb.
pin_to(
    a: int,
    ea: str,
    b: int,
    eb: str,
    d: f64
) {
    msg1(msg1_f(msg(a, sel(ea)), sel("constraintEqualToAnchor:constant:"), msg(b,
        sel(eb)), d), sel("setActive:"), 1)
}

// A view's width or height, fixed.
pin_size(v: int, dim: str, d: f64) {
    msg1(msg_set_f(msg(v, sel(dim)), sel("constraintEqualToConstant:"), d), sel("setActive:"),
        1)
}

text_of_cell(cell: int): int {
    msg(msg(msg(cell, sel("contentView")), sel("subviews")), sel("lastObject"))
}

chapter_of_view(v: int): int {
    msg(v, sel("tag")) - 1
}

// The text view of chapter c (0 if it is not on the screen).
view_of(c: int): int {
    if (c < 0 || c >= chapters) return 0;
    cell: int = msg1(table, sel("cellForRowAtIndexPath:"), chapter_path(c));
    if (cell == 0) return 0;
    text_of_cell(cell)
}

current_view(): int {
    view_of(cur)
}

// The text's top, where it rests unscrolled (the bars above it).
top_inset(sv: int): f64 {
    l8_msg_hfa(hfa, sv, sel("adjustedContentInset"), 0, 0, 0);
    hfa[0]
}

bottom_inset(sv: int): f64 {
    l8_msg_hfa(hfa, sv, sel("adjustedContentInset"), 0, 0, 0);
    hfa[2]
}

offset_y(sv: int): f64 {
    l8_msg_hfa(hfa, sv, sel("contentOffset"), 0, 0, 0);
    hfa[1]
}

view_height(v: int): f64 {
    l8_msg_hfa(hfa, v, sel("bounds"), 0, 0, 0);
    hfa[3]
}

view_width(v: int): f64 {
    l8_msg_hfa(hfa, v, sel("bounds"), 0, 0, 0);
    hfa[2]
}

row_y(c: int): f64 {
    l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), chapter_path(c), 0, 0);
    hfa[1]
}

// The rect of UTF-16 units k to k + n of text view tv (in its own
// coordinates): hfa.
range_rect(tv: int, k: int, n: int): bool {
    begin: int = msg(tv, sel("beginningOfDocument"));
    a: int = msg2(tv, sel("positionFromPosition:offset:"), begin, k);
    b: int = msg2(tv, sel("positionFromPosition:offset:"), begin, k + n);
    if (a == 0 || b == 0) return false;
    range: int = msg2(tv, sel("textRangeFromPosition:toPosition:"), a, b);
    l8_msg_hfa(hfa, tv, sel("firstRectForRange:"), range, 0, 0);
    if (hfa[3] > 0.0f64 && hfa[1] < 1.0e9f64) return true;
    // (Not laid out yet: laid out, and asked again. Not the layout
    // manager, which would turn the view to the older text system.)
    msg(tv, sel("layoutIfNeeded"));
    l8_msg_hfa(hfa, tv, sel("firstRectForRange:"), range, 0, 0);
    hfa[3] > 0.0f64 && hfa[1] < 1.0e9f64
}

// Which chapter is at the top (under the bars), and how far down into it:
// cur and cur_y. The title follows.
find_place() {
    top: f64 = offset_y(table) + top_inset(table);
    path: int = msg_ff(table, sel("indexPathForRowAtPoint:"), 40.0f64, top + 1.0f64);
    if (path == 0) return;
    c: int = msg(path, sel("row"));
    l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), path, 0, 0);
    cur_y = top - hfa[1];
    last_top = top;
    if (c != cur) {
        cur = c;
        note_num("bible: chapter ", c);
        note_num("bible:   top ", top as int);
        note_num("bible:   row ", hfa[1] as int);
        note_num("bible:   inset ", top_inset(table) as int);
        set_title()
    }
    title_fade()
}

// The top of what is seen (in the table's content), last found.
last_top: f64 = 0.0f64;

// The bars' insets changed (as the bars or the status bar come or go, or
// a sheet goes): the same text kept at the top, unless a finger is moving
// it.
inset_changed(_self: int, _cmd: int, sv: int): int {
    if (!is_reader(sv) || !restored) return 0;
    if ((msg(sv, sel("isTracking")) & 255) != 0 || (msg(sv, sel("isDecelerating")) & 255) != 0) return 0;
    note_num("bible: inset now ", top_inset(sv) as int);
    set_offset(last_top - top_inset(sv));
    find_place();
    0
}

// A view's frame, in the log (in the demo).
note_frame(what: str, v: int) {
    l8_msg_hfa(hfa, v, sel("frame"), 0, 0, 0);
    note_num(what, hfa[1] as int);
    note_num("bible:   x ", hfa[0] as int);
    note_num("bible:   w ", hfa[2] as int);
    note_num("bible:   h ", hfa[3] as int);
    note_num("bible:   hidden ", msg(v, sel("isHidden")) & 255);
    note_num("bible:   in window ", if (msg(v, sel("window")) == window) 1 else 0);
    sv: int = msg(window, sel("subviews"));
    note_num("bible:   index ", msg1(sv, sel("indexOfObject:"), v));
    note_num("bible:   of ", msg(sv, sel("count")))
}

// The title shows the chapter only once its opener (its label, book's name
// and number) has gone up under the bar, fading in over 1.2 em more: the
// chapter's name is not shown twice.
title_fade() {
    // (Unmeasured: shown once the chapter's top is well up under the bar.)
    a: f64 = if (cur_y > em * 8.0f64) 1.0f64 else 0.0f64;
    tv: int = current_view();
    if (tv != 0 && range_rect(tv, opener16[cur], 1)) {
        foot: f64 = hfa[1] + hfa[3];
        foot = foot + row_y(cur);
        // (Measured against the bar's bottom now, as it collapses.)
        a = (offset_y(table) + bar_bottom() - foot) / (em * 1.2f64);
        if (a < 0.0f64) a = 0.0f64;
        if (a > 1.0f64) a = 1.0f64
    }
    bar_f = a;
    msg_set_f(title_fader, sel("setAlpha:"), title_alpha())
}

// The title's fade settled when scrolling stops (0.15 s, should the
// measure have changed under them).
title_settle() {
    was: f64 = msg_f(title_fader, sel("alpha"));
    title_fade();
    now: f64 = msg_f(title_fader, sel("alpha"));
    if (now - was > 0.01f64 || was - now > 0.01f64) animate(msg(title_fader, sel("layer")),
        "opacity", was, now, false, 0.15f64)
}

// Chapter c, at y points down into it.
go(c: int, y: f64) {
    if (c < 0 || c >= chapters) return;
    path: int = chapter_path(c);
    // (Twice: the rows above are only estimated until they have been laid
    // out, and the first jump lays out those around it.)
    msg3(table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), path, 1,
        0);
    msg(table, sel("layoutIfNeeded"));
    msg3(table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), path, 1,
        0);
    msg(table, sel("layoutIfNeeded"));
    if (y != 0.0f64) set_offset(offset_y(table) + y);
    cur = -1;
    find_place()
}

// The table scrolled to y (within its content).
set_offset(y: f64) {
    l8_msg_hfa(hfa, table, sel("contentSize"), 0, 0, 0);
    most: f64 = hfa[1] + bottom_inset(table) - view_height(table);
    to: f64 = y;
    if (to > most) to = most;
    if (to < -top_inset(table)) to = -top_inset(table);
    msg_ff1(table, sel("setContentOffset:animated:"), 0.0f64, to, 0);
    msg(table, sel("layoutIfNeeded"))
}

// Where verse v of chapter c begins, down from the table's top (or its
// chapter's top, for verse 0).
verse_y(c: int, v: int): f64 {
    y: f64 = row_y(c);
    if (v <= 0) return y;
    tv: int = view_of(c);
    if (tv == 0) return y;
    compute_ranges(c);
    i: int = rv_index(v);
    if (i < 0) return y;
    if (!range_rect(tv, rv_b[i], 1)) return y;
    y + hfa[1]
}

// Chapter c at verse v (0: its top), frac thousandths of em down into it.
go_place(c: int, v: int, frac: int) {
    go(c, 0.0f64);
    if (c == 0 && v <= 0 && frac <= 0) {
        // (The Bible's top: the table at rest.)
        set_offset(-top_inset(table));
        cur = -1;
        find_place();
        return
    }
    y: f64 = verse_y(c, v) + frac as f64 * em / 1000.0f64;
    set_offset(y - top_inset(table));
    // (Once more, now the rows around it are laid out.)
    y = verse_y(c, v) + frac as f64 * em / 1000.0f64;
    set_offset(y - top_inset(table));
    cur = -1;
    find_place()
}

// Chapter c from its top: its label (or book's name) one chapter gap
// (0.8 em) below the bar, the divider above it out of sight.
go_top(c: int) {
    go(c, 0.0f64);
    if (c == 0) {
        go_place(0, 0, 0);
        return
    }
    for _i in 0..2 {
        tv: int = view_of(c);
        // (The opener begins after the divider and its line's end.)
        if (tv != 0 && range_rect(tv, 2, 1)) {
            y: f64 = hfa[1] + cap_gap(tv, 2);
            set_offset(row_y(c) + y - em * 0.8f64 - top_inset(table))
        }
    }
    cur = -1;
    find_place()
}

// From the top of the line of character k of tv to its capitals' tops
// (the font's ascender less its cap height).
cap_gap(tv: int, k: int): f64 {
    f: int = msg3(msg(tv, sel("textStorage")), sel("attribute:atIndex:effectiveRange:"),
        k_font, k, 0);
    if (f == 0) return 0.0f64;
    msg_f(f, sel("ascender")) - msg_f(f, sel("capHeight"))
}

// Chapter c at verse v, a third of the way down what can be seen.
go_verse(c: int, v: int) {
    go(c, 0.0f64);
    for _i in 0..2 {
        seen: f64 = view_height(table) - top_inset(table) - bottom_inset(table);
        set_offset(verse_y(c, v) - top_inset(table) - seen / 3.0f64)
    }
    cur = -1;
    find_place()
}

// The place now: the verse at the top (0 above the first), and how far
// into it (thousandths of em): place_v and place_frac (cur is the chapter).
place_v: int = 0;

place_frac: int = 0;

measure_place() {
    find_place();
    place_v = 0;
    place_frac = (cur_y * 1000.0f64 / em) as int;
    tv: int = current_view();
    if (tv == 0) return;
    pos: int = msg_ff(tv, sel("closestPositionToPoint:"), side_margin() + 4.0f64,
        cur_y + 2.0f64);
    if (pos == 0) return;
    k: int = msg2(tv, sel("offsetFromPosition:toPosition:"), msg(tv, sel("beginningOfDocument")),
        pos);
    compute_ranges(cur);
    i: int = -1;
    for x in 0..rv_count
        if (rv_b[x] <= k) i = x;
    if (i < 0) return;
    if (!range_rect(tv, rv_b[i], 1)) return;
    place_v = rv_num[i];
    place_frac = ((cur_y - hfa[1]) * 1000.0f64 / em) as int
}

save_place() {
    if (!restored) return;
    measure_place();
    set_def_int("chapter", cur + 1);
    set_def_int("verse", place_v);
    set_def_int("verseOffset", place_frac);
    msg(defaults(), sel("synchronize"))
}

load_place() {
    c: int = def_int("chapter") - 1;
    if (c >= 0 && c < chapters) {
        restore_c = c;
        restore_v = def_int("verse");
        restore_frac = def_int("verseOffset")
    }
}

// The rows made again (the look changed), at the same verse.
relayout() {
    measure_place();
    c: int = cur;
    v: int = place_v;
    f: int = place_frac;
    msg(table, sel("reloadData"));
    msg(table, sel("layoutIfNeeded"));
    go_place(c, v, f);
    save_place()
}

// ---- the bars ----
// The reader's bar collapsed, or expanded (animated; ios_bar.l8). The
// status bar stays.
show_bars(hidden: bool) {
    bar_animate_to(if (hidden) 1.0f64 else 0.0f64)
}

nav_status_hidden(_self: int, _cmd: int): int {
    0
}

nav_status_child(_self: int, _cmd: int): int {
    0
}

nav_status_animation(_self: int, _cmd: int): int {
    1
}

// Dark text on the light themes, light on the dark.
nav_status_style(_self: int, _cmd: int): int {
    if (is_dark()) 1 else 3
}

// The scroll: the place found, the bar following it (ios_bar.l8), and the
// capsule let go once far from where it came.
scroll_began(_self: int, _cmd: int, sv: int): int {
    if (!is_reader(sv)) return 0;
    drag_top = offset_y(sv);
    drag_low = drag_top;
    bar_drag_began();
    listen_drag_began();
    0
}

scrolled(_self: int, _cmd: int, sv: int): int {
    if (!is_reader(sv)) return 0;
    bar_scrolled(sv);
    find_place();
    back_scrolled(offset_y(sv));
    0
}

scroll_ended(_self: int, _cmd: int, sv: int): int {
    if (is_reader(sv)) {
        bar_settle();
        title_settle();
        save_place();
        reader_rested()
    }
    0
}

// The reader at rest after a scroll: the screen kept on (if asked), the
// chapter perhaps dwelt in, listening's following let wait.
reader_rested() {
    keep_screen_touched();
    dwell_check();
    listen_dragged();
    esv_reader_wants()
}

scroll_dragged(
    _self: int,
    _cmd: int,
    sv: int,
    decelerate: int
): int {
    if (is_reader(sv) && (decelerate & 255) == 0) {
        bar_settle();
        title_settle();
        save_place();
        reader_rested()
    }
    0
}

// ---- taps ----
// A tap: on a footnote's mark, the note; on a note's mark, the note's
// editor; on a verse, the verse selected (or not); elsewhere, the verses
// selected let go, or else the bars shown or hidden.
tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    reader_tap(tv, hfa[0], hfa[1]);
    0
}

reader_tap(tv: int, x: f64, y: f64): int {
    range: int = msg(tv, sel("selectedTextRange"));
    if (range != 0 && (msg(range, sel("isEmpty")) & 255) == 0) return 0;
    keep_screen_touched();
    c: int = chapter_of_view(tv);
    link: int = link_at(tv, x, y, k_link);
    if (link > 0) {
        show_footnote(tv, c, link, x, y);
        return 0
    }
    ref: int = link_at_within(tv, x, y, k_xref, 12.0f64);
    if (ref > 0) {
        open_preview(ref);
        return 0
    }
    mark: int = link_at(tv, x, y, k_note_mark);
    if (mark > 0) {
        open_note(c, mark, mark);
        return 0
    }
    what: int = link_at_within(tv, x, y, k_esv, 12.0f64);
    if (what > 0) {
        esv_tapped(c, what);
        return 0
    }
    if (link_at(tv, x, y, k_chapter_note) > 0) {
        open_note(c, 0, 0);
        return 0
    }
    k: int = char_at(tv, x, y);
    if (k >= 0) {
        compute_ranges(c);
        i: int = rv_at(k);
        if (i >= 0 && near_char(tv, k, x, y, 6.0f64)) {
            toggle_verse(c, rv_num[i]);
            return 0
        }
    }
    if (sel_n > 0) clear_selection() else bar_animate_to(if (bar_p >= 0.5f64) 0.0f64 else 1.0f64);
    0
}

// The UTF-16 index of the character at (x, y) in tv, or -1.
char_at(tv: int, x: f64, y: f64): int {
    pos: int = msg_ff(tv, sel("closestPositionToPoint:"), x, y);
    if (pos == 0) return -1;
    msg2(tv, sel("offsetFromPosition:toPosition:"), msg(tv, sel("beginningOfDocument")),
        pos)
}

// What the attribute key (a link's, a note mark's) at (x, y) in tv says (0
// if none there).
link_at(
    tv: int,
    x: f64,
    y: f64,
    key_name: str
): int {
    link_at_within(tv, x, y, key_name, 16.0f64)
}

link_at_within(
    tv: int,
    x: f64,
    y: f64,
    key_name: str,
    slack: f64
): int {
    i: int = char_at(tv, x, y);
    if (i < 0) return 0;
    storage: int = msg(tv, sel("textStorage"));
    n: int = msg(storage, sel("length"));
    key: int = nsstring(key_name);
    // The character after the place, or before it (a mark is one).
    for k in [i, i - 1] {
        if (k >= 0 && k < n) {
            v: int = msg3(storage, sel("attribute:atIndex:effectiveRange:"), key,
                k, 0);
            if (v != 0 && near_char(tv, k, x, y, slack)) return msg(v, sel("longValue"))
        }
    }
    0
}

// Whether (x, y) is on or near character k of tv (within slack).
near_char(
    tv: int,
    k: int,
    x: f64,
    y: f64,
    slack: f64
): bool {
    if (!range_rect(tv, k, 1)) return false;
    x >= hfa[0] - slack && x <= hfa[0] + hfa[2] + slack && y >= hfa[1] - slack && y <= hfa[1] + hfa[3] + slack
}

// The tap is seen alongside the text view's own gestures.
together(
    _self: int,
    _cmd: int,
    _a: int,
    _b: int
): int {
    1
}

// ---- footnotes ----
// A footnote, in a popover pointing at its mark (over the reader, or over
// a preview): which verse it is on, and its words, in a text view, its
// references to verses (Book C:V) links that preview (DESIGN.md ยง8.1).
fn_c: int = -1;

fn_v: int = 0;

show_footnote(
    tv: int,
    c: int,
    at: int,
    x: f64,
    y: f64
) {
    host: int = top_presented();
    if (host != 0 && !preview_on_top(host)) return;
    if (host == 0) host = nav;
    e: int = line_end(at);
    vc: int = make("UIViewController");
    view: int = msg(vc, sel("view"));
    bg: int = if (theme == 2 || theme == 4) msg(cls("UIColor"), sel("systemBackgroundColor")) else c_cell;
    msg1(view, sel("setBackgroundColor:"), bg);
    header: int = make("UILabel");
    v: int = verse_at(c, at);
    fn_c = c;
    fn_v = v;
    msg1(header, sel("setFont:"), sans(12.0f64, 0.3f64));
    msg1(header, sel("setTextColor:"), c_faint);
    fbuf_n = 0;
    fput_str("Footnote \ย\ท ");
    fput_ref(c, v, 0);
    msg1(header, sel("setText:"), nsstring_of(fbuf, fbuf_n));
    size: f64 = em * 0.88f64;
    if (size < 15.0f64) size = 15.0f64;
    if (size > 22.0f64) size = 22.0f64;
    keys[0] = k_font;
    values[0] = body(size);
    keys[1] = k_color;
    values[1] = c_ink;
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.25f64), sel("autorelease"));
    n: int = e - at - 1;
    if (n > len(note_buf)) n = len(note_buf);
    for i in 0..n note_buf[i] = bsb[at + 1 + i];
    a: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        nsstring_of(note_buf, n), nsdictionary(keys, values, 3)), sel("autorelease"));
    // (Its references with a verse: "Cited in 2 Corinthians 4:6".)
    note_refs(note_buf, n);
    for r in 0..nr_n {
        if (nr_v[r] > 0) {
            xr_book = nr_book[r];
            xr_c = nr_c[r];
            xr_v = nr_v[r];
            xr_ce = (if (nr_ve[r] > 0) nr_c[r] else 0);
            xr_ve = (if (nr_ve[r] > 0) nr_ve[r] else 0);
            u: int = units_of(note_buf, 0, nr_b[r]);
            un: int = units_of(note_buf, nr_b[r], nr_e[r]);
            msg4(a, sel("addAttribute:value:range:"), k_color, c_accent, u, un);
            msg4(a, sel("addAttribute:value:range:"), nsstring(k_xref), nsnumber_int(xref_both()),
                u, un)
        }
    }
    // (Measured as a label would set it; shown in a text view, which can
    // say what is under a finger.)
    label: int = make("UILabel");
    msg1(label, sel("setNumberOfLines:"), 0);
    msg1(label, sel("setAttributedText:"), a);
    msg_set_f(label, sel("setPreferredMaxLayoutWidth:"), 268.0f64);
    l8_msg_hfa(hfa, label, sel("intrinsicContentSize"), 0, 0, 0);
    release(label);
    w: f64 = hfa[0];
    h: f64 = hfa[1] + 2.0f64;
    l8_msg_hfa(hfa, header, sel("intrinsicContentSize"), 0, 0, 0);
    hw: f64 = hfa[0];
    hh: f64 = hfa[1];
    if (hw > w) w = hw;
    if (w > 268.0f64) w = 268.0f64;
    text: int = make("UITextView");
    msg1(text, sel("setEditable:"), 0);
    msg1(text, sel("setSelectable:"), 0);
    msg1(text, sel("setScrollEnabled:"), 0);
    msg1(text, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg_rect(text, sel("setTextContainerInset:"), 0.0f64, 0.0f64, 0.0f64, 0.0f64);
    msg_set_f(msg(text, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
    msg1(text, sel("setAttributedText:"), a);
    msg1(text, sel("setAccessibilityLabel:"), msg(a, sel("string")));
    tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("footnoteTapped:"));
    msg1(text, sel("addGestureRecognizer:"), tap);
    release(tap);
    msg_rect(header, sel("setFrame:"), 16.0f64, 16.0f64, w, hh);
    msg_rect(text, sel("setFrame:"), 16.0f64, 16.0f64 + hh + 6.0f64, w + 2.0f64, h);
    msg1(view, sel("addSubview:"), header);
    msg1(view, sel("addSubview:"), text);
    release(header);
    release(text);
    msg_ff(vc, sel("setPreferredContentSize:"), w + 32.0f64, h + hh + 38.0f64);
    msg1(vc, sel("setModalPresentationStyle:"), 7);
    pop: int = msg(vc, sel("popoverPresentationController"));
    msg1(pop, sel("setSourceView:"), tv);
    msg_rect(pop, sel("setSourceRect:"), x - 4.0f64, y - 10.0f64, 8.0f64, 20.0f64);
    msg1(pop, sel("setPermittedArrowDirections:"), 3);
    msg1(pop, sel("setBackgroundColor:"), bg);
    msg1(pop, sel("setDelegate:"), app_obj);
    if (host == nav) {
        bar_expand();
        keep_screen_release()
    }
    msg3(host, sel("presentViewController:animated:completion:"), vc, 1, 0);
    release(vc)
}

// A reference in a footnote tapped: the popover fades away, and then (0.3 s
// on, so the sheet does not rise through it) the reference's preview.
pending_preview: int = 0;

footnote_tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    footnote_tap_at(tv, hfa[0], hfa[1]);
    0
}

footnote_tap_at(tv: int, x: f64, y: f64) {
    ref: int = link_at_within(tv, x, y, k_xref, 8.0f64);
    if (ref > 0) footnote_follow(ref)
}

footnote_follow(ref: int) {
    pending_preview = ref;
    // (Back to the footnote's verse, from the preview's Open in Reader.)
    origin_c = fn_c;
    origin_v = fn_v;
    pop: int = top_presented();
    if (pop != 0) msg2(msg(pop, sel("presentingViewController")), sel("dismissViewControllerAnimated:completion:"),
        1, 0);
    _t: int = after(0.3f64, "showPendingPreview:")
}

show_pending_preview(_self: int, _cmd: int, _timer: int): int {
    ref: int = pending_preview;
    if (ref <= 0) return 0;
    top: int = top_presented();
    // (The popover not yet gone: a moment more.)
    if (top != 0 && (msg(top, sel("isBeingDismissed")) & 255) != 0) {
        _t: int = after(0.1f64, "showPendingPreview:");
        return 0
    }
    pending_preview = 0;
    if (top != 0 && preview_on_top(top)) push_preview(ref) else if (top == 0) {
        c: int = origin_c;
        v: int = origin_v;
        open_preview(ref);
        origin_c = c;
        origin_v = v
    }
    0
}

// (A popover stays one on a phone, rather than becoming a sheet.)
popover_style(
    _self: int,
    _cmd: int,
    _controller: int,
    _traits: int
): int {
    -1
}

// ---- the chapter's name, at the top ----
title_attrs(): int {
    keys[0] = k_font;
    values[0] = sans(17.0f64, 0.4f64);
    keys[1] = k_color;
    values[1] = c_ink;
    nsdictionary(keys, values, 2)
}

set_title() {
    if (cur < 0) return;
    title_of(cur);
    name: int = nsstring_at(bytes_address(out), out_n);
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    t: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        name, title_attrs());
    msg1(config, sel("setAttributedTitle:"), t);
    msg1(config, sel("setImage:"), symbol("chevron.down", 10.0f64, 7, c_faint));
    msg1(config, sel("setImagePlacement:"), 8);
    msg_set_f(config, sel("setImagePadding:"), 4.0f64);
    msg1(title_button, sel("setConfiguration:"), config);
    msg1(title_button, sel("setAccessibilityLabel:"), name);
    msg1(title_button, sel("setAccessibilityHint:"), nsstring("Choose a book and chapter"));
    set_compact_title(name);
    // (Its size: the title's, the chevron's and the button's insets, or the
    // button's own, if more; never wider than the room between the bar's
    // buttons.)
    l8_msg_hfa(hfa, t, sel("size"), 0, 0, 0);
    w: f64 = hfa[0] + 44.0f64;
    l8_msg_hfa(hfa, title_button, sel("intrinsicContentSize"), 0, 0, 0);
    if (hfa[0] + 4.0f64 > w) w = hfa[0] + 4.0f64;
    room: f64 = view_width(window) - 2.0f64 * 104.0f64;
    if (window != 0 && room > 80.0f64 && w > room) w = room;
    msg_rect(title_view, sel("setBounds:"), 0.0f64, 0.0f64, w, 36.0f64);
    msg_rect(title_fader, sel("setFrame:"), 0.0f64, 0.0f64, w, 36.0f64);
    msg_rect(title_button, sel("setFrame:"), 0.0f64, 0.0f64, w, 36.0f64);
    release(t)
}

// What is shown over the chapters (a sheet, or a footnote), if any.
presented(): int {
    msg(nav, sel("presentedViewController"))
}

// ---- the theme, applied ----
// The page's color behind the bar and the status bar, and below it a short
// fade from the page's color to clear, so the text goes softly under the
// bar in every theme; its height follows the bar's (ios_bar.l8).
backdrop: int = 0;

backdrop_fade: int = 0;

backdrop_gradient: int = 0;

// The theme (and the look made from it) applied everywhere: crossfaded,
// when asked.
apply_theme(fade: bool) {
    resolve_theme();
    make_colors();
    make_look();
    if (fade) {
        t: int = make("CATransition");
        msg1(t, sel("setType:"), objc_const("kCATransitionFade"));
        msg_set_f(t, sel("setDuration:"), 0.25f64);
        msg2(msg(window, sel("layer")), sel("addAnimation:forKey:"), t, 0);
        release(t)
    }
    msg1(window, sel("setOverrideUserInterfaceStyle:"), if (set_theme == 0) 0 else if (is_dark()) 2 else 1);
    msg1(window, sel("setTintColor:"), c_accent);
    msg1(window, sel("setBackgroundColor:"), c_bg);
    msg1(table, sel("setBackgroundColor:"), c_bg);
    msg1(msg(nav, sel("view")), sel("setBackgroundColor:"), c_bg);
    msg1(msg(reader, sel("view")), sel("setBackgroundColor:"), c_bg);
    style_bar();
    set_title();
    msg(nav, sel("setNeedsStatusBarAppearanceUpdate"));
    style_tray();
    style_back();
    style_sheets()
}

// The phone's light or dark mode changed: Auto follows it.
reader_traits(self: int, cmd: int, previous: int): int {
    _r: int = super1(self, reader_class, cmd, previous);
    if (set_theme != 0 || window == 0) return 0;
    was: int = theme;
    resolve_theme();
    if (theme != was) {
        apply_theme(false);
        relayout();
        demo_event()
    }
    0
}

// The reader on the screen: where it was, once its rows can be laid out.
reader_appeared(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, reader_class, cmd, animated);
    if (!restored) {
        restored = true;
        go_place(restore_c, restore_v, restore_frac);
        save_place();
        note("bible: up");
        launch_ms((CFAbsoluteTimeGetCurrent() - launch_t0) * 1000.0f64);
        if (demo_on) {
            demo_listen();
            demo_event()
        }
        if (pending_link != 0) {
            open_link(pending_link);
            release(pending_link);
            pending_link = 0
        }
    }
    set_insets();
    title_fade();
    layout_bar();
    0
}

app_background(_self: int, _cmd: int, _application: int): int {
    save_place();
    keep_screen_release();
    0
}

// The phone's text size changed: the text made again, at the same verse.
text_size_changed(_self: int, _cmd: int, _note: int): int {
    measure_place();
    c: int = cur;
    v: int = place_v;
    f: int = place_frac;
    make_look();
    set_insets();
    msg(table, sel("reloadData"));
    msg(table, sel("layoutIfNeeded"));
    go_place(c, v, f);
    save_place();
    demo_event();
    0
}

// ---- links: bsb://JHN/3 ----
// A link opens a chapter: the book's code (as the text has them: GEN, PSA,
// JHN) and the chapter's number, and perhaps a verse (bsb://JHN/3/16).
link_buf: []i8 = new i8[512](0i8);

// A link that came before the reader could go to it.
pending_link: int = 0;

open_link_text(s: str) {
    open_link(msg1(cls("NSURL"), sel("URLWithString:"), nsstring(s)))
}

open_link(url: int) {
    if (!restored) {
        release(pending_link);
        pending_link = keep(url);
        return
    }
    n: int = nsstring_into(msg(url, sel("absoluteString")), link_buf);
    p: int = 6;
    if (n < p || link_buf[0] as int != 98) return;
    // (After "bsb://": a word, then a number, and perhaps another.)
    w: int = p;
    while (w < n && link_buf[w] as int != 47) w = w + 1;
    num: int = 0;
    verse: int = 0;
    second: bool = false;
    for i in w + 1..n {
        k: int = link_buf[i] as int;
        if (k == 47) second = true;
        if (k >= 48 && k <= 57) {
            if (second) verse = verse * 10 + k - 48 else num = num * 10 + k - 48
        }
    }
    if (w - p != 3) return;
    for b in 0..books {
        q: int = book_line[b] + 1;
        same: bool = true;
        for i in 0..3 {
            k: int = link_buf[p + i] as int;
            if (k >= 97 && k <= 122) k = k - 32;
            if (bsb[q + i] as int != k) same = false
        }
        if (same) {
            jump(chapter_of(b, num), verse);
            return
        }
    }
}

// Links opened while the app runs, and the one it was opened with.
scene_links(
    _self: int,
    _cmd: int,
    _scene: int,
    contexts: int
): int {
    open_links(contexts);
    0
}

open_links(contexts: int) {
    c: int = msg(contexts, sel("anyObject"));
    if (c != 0) open_link(msg(c, sel("URL")))
}

// ---- the app ----
demo_on: bool = false;

// Whether diagnostics are written (L8_DEMO or L8_TIMING).
diag_on: bool = false;

// When main began (to say, at "bible: up", how long the launch took).
launch_t0: f64 = 0.0f64;

launch_ms(ms: f64) {
    if (!diag_on) return;
    try {
        write(2, "bible: launched in ms ");
        write_int(2, ms as int);
        write(2, "\n")
    } with IoError _e -> { }
}

app_launched(
    self: int,
    _cmd: int,
    _application: int,
    _options: int
): int {
    app_obj = self;
    load_settings();
    load_marks();
    load_place();
    msg4(msg(cls("NSNotificationCenter"), sel("defaultCenter")), sel("addObserver:selector:name:object:"),
        self, sel("textSizeChanged:"), objc_const("UIContentSizeCategoryDidChangeNotification"),
        0);
    1
}

// The app's one scene, connected: its window, the chapters in it.
scene_connected(
    _self: int,
    _cmd: int,
    scene: int,
    _session: int,
    options: int
): int {
    if (window != 0) return 0;
    self: int = app_obj;
    window = msg1(msg(cls("UIWindow"), sel("alloc")), sel("initWithWindowScene:"),
        scene);
    resolve_theme();
    make_colors();
    make_look();
    // The chapters, one after another.
    reader = msg1(msg(reader_class, sel("alloc")), sel("initWithStyle:"), 0);
    table = msg(reader, sel("tableView"));
    msg1(table, sel("setDataSource:"), self);
    msg1(table, sel("setDelegate:"), self);
    msg1(table, sel("setSeparatorStyle:"), 0);
    msg1(table, sel("setAllowsSelection:"), 0);
    msg_set_f(table, sel("setRowHeight:"), objc_const_f("UITableViewAutomaticDimension"));
    msg_set_f(table, sel("setEstimatedRowHeight:"), em * 140.0f64);
    // (No space for section headers: the first chapter rests at the top.)
    if (responds(table, "setSectionHeaderTopPadding:")) msg_set_f(table, sel("setSectionHeaderTopPadding:"),
        0.0f64);
    msg_set_f(table, sel("setSectionHeaderHeight:"), 0.0f64);
    msg_set_f(table, sel("setSectionFooterHeight:"), 0.0f64);
    msg_set_f(table, sel("setEstimatedSectionHeaderHeight:"), 0.0f64);
    msg_set_f(table, sel("setEstimatedSectionFooterHeight:"), 0.0f64);
    msg1(table, sel("setContentInsetAdjustmentBehavior:"), 2);
    msg1(reader, sel("setEdgesForExtendedLayout:"), 15);
    // (The text fades softly under the bar, where there is glass.)
    if (responds(table, "topEdgeEffect")) {
        style: int = msg(cls("UIScrollEdgeEffectStyle"), sel("softStyle"));
        if (style != 0) msg1(msg(table, sel("topEdgeEffect")), sel("setStyle:"), style);
        if (demo_on) {
            n: int = nsstring_into(msg(msg(table, sel("topEdgeEffect")), sel("description")),
                link_buf);
            try {
                write(2, "bible: edge effect ");
                write_bytes_n(2, link_buf, n);
                write(2, "\n")
            } with IoError _e -> { }
        }
    }
    // The bar: search; the chapter's name (shown once its opener is under
    // the bar), which opens the passage picker; the library and the reading
    // settings.
    title_button = keep(msg1(cls("UIButton"), sel("buttonWithType:"), 1));
    msg3(title_button, sel("addTarget:action:forControlEvents:"), self, sel("showPicker:"),
        64);
    title_view = keep(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 120.0f64, 32.0f64));
    title_fader = keep(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 120.0f64, 32.0f64));
    msg1(title_view, sel("addSubview:"), title_fader);
    msg1(title_fader, sel("addSubview:"), title_button);
    msg_set_f(title_fader, sel("setAlpha:"), 0.0f64);
    nav = msg1(msg(nav_class, sel("alloc")), sel("initWithRootViewController:"), reader);
    // (Its own bar hidden for good: the reader's is ios_bar.l8's.)
    msg2(nav, sel("setNavigationBarHidden:animated:"), 1, 0);
    make_bar();
    msg1(window, sel("setRootViewController:"), nav);
    msg(window, sel("makeKeyAndVisible"));
    msg(window, sel("layoutIfNeeded"));
    make_tray();
    make_back();
    apply_theme(false);
    set_insets();
    layout_bar();
    links: int = msg(options, sel("URLContexts"));
    if (links != 0) open_links(links);
    0
}

// The app active again (from the background): the ESV's chapters that
// could not come, asked for again.
scene_active(_self: int, _cmd: int, _scene: int): int {
    esv_app_active();
    0
}

scene_window(_self: int, _cmd: int): int {
    window
}

// The text, from the app's bundle.
load_text() noregion {
    bundle: int = msg(cls("NSBundle"), sel("mainBundle"));
    path: int = msg2(bundle, sel("pathForResource:ofType:"), nsstring("bsb"), nsstring("txt"));
    if (path == 0) {
        note("bible: no bsb.txt");
        return
    }
    fd: int = open(cstr(nsstring_bytes(path)), 0, 0);
    if (fd < 0) return;
    bsb = new i8[6291456](0i8);
    n: int = 0;
    more: bool = true;
    while (more && n < len(bsb)) {
        r: int = read(fd, bsb, n, len(bsb) - n);
        if (r <= 0) more = false else n = n + r
    }
    close(fd);
    text_load(TEXT_BSB, bsb, n);
    // The verses past the BSB's that other versions have (a mark there is
    // kept: store.l8).
    refs: int = msg2(bundle, sel("pathForResource:ofType:"), nsstring("refs"), nsstring("txt"));
    data: int = if (refs != 0) msg1(cls("NSData"), sel("dataWithContentsOfFile:"),
        refs) else 0;
    if (data != 0) {
        m: int = msg(data, sel("length"));
        if (m > len(fbuf)) m = len(fbuf);
        if (m > 0) memcpy_from(fbuf, msg(data, sel("bytes")), m);
        refs_read(fbuf, m)
    }
    use_saved_version()
}

main() noregion: int {
    launch_t0 = CFAbsoluteTimeGetCurrent();
    demo_on = getenv("L8_DEMO") != null;
    diag_on = demo_on || getenv("L8_TIMING") != null;
    note("bible: starting");
    load_text();
    // The navigation controller, which hides the status bar with its bar.
    nav_class = objc_allocateClassPair(cls("UINavigationController"), "L8Nav", 0);
    add_method0(nav_class, sel("prefersStatusBarHidden"), &nav_status_hidden, "B@:");
    add_method0(nav_class, sel("childViewControllerForStatusBarHidden"), &nav_status_child,
        "@@:");
    add_method0(nav_class, sel("childViewControllerForStatusBarStyle"), &nav_status_child,
        "@@:");
    add_method0(nav_class, sel("preferredStatusBarUpdateAnimation"), &nav_status_animation,
        "q@:");
    add_method0(nav_class, sel("preferredStatusBarStyle"), &nav_status_style, "q@:");
    objc_registerClassPair(nav_class);
    // The reader's controller: the theme follows the phone's mode; the
    // place is found once it is on the screen; and the edit menu's commands.
    reader_class = objc_allocateClassPair(cls("UITableViewController"), "L8Reader",
        0);
    add_method1(reader_class, sel("traitCollectionDidChange:"), &reader_traits, "v@:@");
    add_method1(reader_class, sel("viewDidAppear:"), &reader_appeared, "v@:B");
    add_method0(reader_class, sel("viewSafeAreaInsetsDidChange"), &reader_safe_area,
        "v@:");
    add_commands(reader_class);
    objc_registerClassPair(reader_class);
    make_sheet_classes();
    make_study_classes();
    make_preview_class();
    make_esv_class();
    make_study2_class();
    // The app's delegate, and every other delegate and data source.
    app: int = objc_allocateClassPair(cls("UIResponder"), "L8BibleApp", 0);
    add_method2(app, sel("application:didFinishLaunchingWithOptions:"), &app_launched,
        "B@:@@");
    add_method1(app, sel("applicationDidEnterBackground:"), &app_background, "v@:@");
    add_method1(app, sel("applicationWillTerminate:"), &app_background, "v@:@");
    add_method1(app, sel("scrollViewWillBeginDragging:"), &scroll_began, "v@:@");
    add_method1(app, sel("scrollViewDidScroll:"), &scrolled, "v@:@");
    add_method1(app, sel("scrollViewDidChangeAdjustedContentInset:"), &inset_changed,
        "v@:@");
    add_method1(app, sel("scrollViewDidEndDecelerating:"), &scroll_ended, "v@:@");
    add_method2(app, sel("scrollViewDidEndDragging:willDecelerate:"), &scroll_dragged,
        "v@:@B");
    add_method1(app, sel("tapped:"), &tapped, "v@:@");
    add_method2(app, sel("gestureRecognizer:shouldRecognizeSimultaneouslyWithGestureRecognizer:"),
        &together, "B@:@@");
    add_method2(app, sel("adaptivePresentationStyleForPresentationController:traitCollection:"),
        &popover_style, "q@:@@");
    add_method1(app, sel("textSizeChanged:"), &text_size_changed, "v@:@");
    add_method1(app, sel("footnoteTapped:"), &footnote_tapped, "v@:@");
    add_method1(app, sel("showPendingPreview:"), &show_pending_preview, "v@:@");
    add_select_methods(app);
    add_bar_methods(app);
    add_commands(app);
    add_sheet_methods(app);
    add_study_methods(app);
    add_preview_methods(app);
    add_listen_methods(app);
    add_history_methods(app);
    add_library_methods(app);
    add_esv_methods(app);
    add_compare_methods(app);
    add_study2_methods(app);
    add_protocol(app, "UIApplicationDelegate");
    add_protocol(app, "UITableViewDataSource");
    add_protocol(app, "UITableViewDelegate");
    add_protocol(app, "UICollectionViewDataSource");
    add_protocol(app, "UICollectionViewDelegate");
    add_protocol(app, "UIGestureRecognizerDelegate");
    add_protocol(app, "UIPopoverPresentationControllerDelegate");
    add_protocol(app, "UITextViewDelegate");
    add_protocol(app, "UISearchResultsUpdating");
    add_protocol(app, "UISearchBarDelegate");
    add_protocol(app, "UIAdaptivePresentationControllerDelegate");
    objc_registerClassPair(app);
    // The scene's delegate (UIKit makes it, from Info.plist's manifest): its
    // window is made with the app delegate's objects.
    scene: int = objc_allocateClassPair(cls("UIResponder"), "L8BibleScene", 0);
    add_method3(scene, sel("scene:willConnectToSession:options:"), &scene_connected,
        "v@:@@@");
    add_method1(scene, sel("sceneDidEnterBackground:"), &app_background, "v@:@");
    add_method2(scene, sel("scene:openURLContexts:"), &scene_links, "v@:@@");
    add_method1(scene, sel("sceneDidBecomeActive:"), &scene_active, "v@:@");
    add_method0(scene, sel("window"), &scene_window, "@@:");
    add_protocol(scene, "UIWindowSceneDelegate");
    objc_registerClassPair(scene);
    note("bible: classes made; UIKit next");
    UIApplicationMain(l8rt_argc(), l8rt_argv(), 0, nsstring("L8BibleApp"))
}
