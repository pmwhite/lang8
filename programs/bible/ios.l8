number_buf: []i8 = new i8[24](0i8);

// A number as an NSString.
nsnumber_text(n: int): int {
    m: int = n;
    digits: int = 1;
    while (m >= 10) {
        m = m / 10;
        digits = digits + 1
    }
    m = n;
    for i in 0..digits {
        number_buf[digits - 1 - i] = (48 + m % 10) trunc i8;
        m = m / 10
    }
    nsstring_at(bytes_address(number_buf), digits)
}

table_cell(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    if (is_reader(t)) return chapter_cell(t, path);
    b: int = book_of(path);
    cell: int = msg1(t, sel("dequeueReusableCellWithIdentifier:"), nsstring("book"));
    if (cell == 0) cell = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        1, nsstring("book")), sel("autorelease"));
    label: int = msg(cell, sel("textLabel"));
    msg1(label, sel("setText:"), nsstring_at(bytes_address(bsb) + book_name_start(b),
        book_name_end(b) - book_name_start(b)));
    here: bool = b == ch_book[cur];
    msg1(label, sel("setTextColor:"), if (here) accent else ink);
    msg1(label, sel("setFont:"), sans(17.0f64, if (here) 0.3f64 else 0.0f64));
    detail: int = msg(cell, sel("detailTextLabel"));
    msg1(detail, sel("setText:"), nsnumber_text(book_count[b]));
    msg1(detail, sel("setTextColor:"), faint);
    msg1(cell, sel("setAccessoryType:"), if (book_count[b] > 1) 1 else 0);
    cell
}

// A book picked: its chapters (or, with only one, the book itself).
table_picked(
    _self: int,
