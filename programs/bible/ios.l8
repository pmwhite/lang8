// ---- links: bsb://JHN/3, and the demo's steps ----
// A link opens a chapter: the book's code (as the text has them: GEN, PSA,
// JHN) and the chapter's number. With L8_DEMO=1 in the environment, the app
// takes the demo's steps when told to (simulate.sh does, for its
// screenshots in CI).
demo_on: bool = false;

link_buf: []i8 = new i8[512](0i8);

open_link(url: int) {
    n: int = nsstring_into(msg(url, sel("absoluteString")), link_buf);
    p: int = 6;
    if (n < p || link_buf[0] as int != 98) return;
    // (After "bsb://": a word, then a number.)
    w: int = p;
    while (w < n && link_buf[w] as int != 47) w = w + 1;
    num: int = 0;
    for i in w + 1..n {
        k: int = link_buf[i] as int;
        if (k >= 48 && k <= 57) num = num * 10 + k - 48
    }
    if (w - p != 3) return;
    for b in 0..books {
        q: int = book_line[b] + 1;
        same: bool = true;
        for i in 0..3 {
            k: int = link_buf[p + i] as int;
            if (k >= 97 && k <= 122) k = k - 32;
            if (bsb[q + i] as int != k) same = false
        }
        if (same) {
            if (presented() != 0) msg2(nav, sel("dismissViewControllerAnimated:completion:"),
                0, 0);
            go(chapter_of(b, num), 0.0f64);
            return
        }
    }
}

// The demo's steps, as the Darwin notifications NAME1 to NAME8 (sent by
// `notifyutil -p` in the simulator: a link would ask first).
demo_name: str = "space.trailingwhite.smoothbible.demo";

demo_listen() {
    center: int = CFNotificationCenterGetDarwinNotifyCenter();
    n: int = len(demo_name);
    for i in 0..n link_buf[i] = demo_name[i];
    for step in 1..9 {
        link_buf[n] = (48 + step) trunc i8;
        CFNotificationCenterAddObserver(center, 0, &demo_note, nsstring_at(bytes_address(link_buf),
            n + 1), 0, 4)
    }
}

demo_note(
    _center: int,
    _observer: int,
    name: int,
    _object: int,
    _info: int
): int {
    n: int = nsstring_into(name, link_buf);
    if (n > 0) demo_do(link_buf[n - 1] as int - 48);
    0
}

// Links opened while the app runs, and the one it was opened with.
scene_links(
    _self: int,
    _cmd: int,
    _scene: int,
    contexts: int
): int {
    open_links(contexts);
    0
}

open_links(contexts: int) {
    c: int = msg(contexts, sel("anyObject"));
    if (c != 0) open_link(msg(c, sel("URL")))
}

// The demo's steps: Genesis 1 (as it starts); the books; Psalms' chapters;
// Psalm 23; a footnote; John 3; read on (the bars hide); the bars back.
demo_do(t: int) {
    if (t == 2) open_books();
    if (t == 3) show_chapters(18);
    if (t == 4) {
        go(book_first[18] + 22, 0.0f64);
        dismiss_picker()
    }
    if (t == 5) {
        // The first footnote's mark, tapped.
        tv: int = current_view();
        layout_chapter(cur);
        at: int = 0;
        p: int = 0;
        for r in 0..runs {
            if (at == 0 && run_style[r] == STYLE_NOTE) at = utf16_count(0, p);
            p = run_end[r]
        }
        if (tv != 0 && at > 0) {
            begin: int = msg(tv, sel("beginningOfDocument"));
            a: int = msg2(tv, sel("positionFromPosition:offset:"), begin, at);
            b: int = msg2(tv, sel("positionFromPosition:offset:"), begin, at + 1);
            l8_msg_hfa(hfa, tv, sel("firstRectForRange:"), msg2(tv, sel("textRangeFromPosition:toPosition:"),
                a, b), 0, 0);
            x: f64 = hfa[0] + hfa[2] * 0.5f64;
            y: f64 = hfa[1] + hfa[3] * 0.5f64;
            link: int = link_at(tv, x, y);
            if (link > 0) show_note(tv, link, x, y)
        }
    }
    if (t == 6) {
        msg2(nav, sel("dismissViewControllerAnimated:completion:"), 0, 0);
        go(book_first[42] + 2, 0.0f64)
    }
    if (t == 7) {
        msg_ff1(table, sel("setContentOffset:animated:"), 0.0f64, offset_y(table) + 700.0f64,
            1);
        show_bars(true)
    }
    if (t == 8) {
        show_bars(false);
        save_place()
    }
}

// How many UTF-16 units out's bytes p to e are.
utf16_count(p: int, e: int): int {
    n: int = 0;
    for i in p..e {
        k: int = out[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    n
}

// ---- the app ----
app_launched(
    self: int,
    _cmd: int,
    _application: int,
    _options: int
): int {
    app_obj = self;
    make_look();
    load_place();
    msg4(msg(cls("NSNotificationCenter"), sel("defaultCenter")), sel("addObserver:selector:name:object:"),
        self, sel("textSizeChanged:"), objc_const("UIContentSizeCategoryDidChangeNotification"),
        0);
    1
}

// The app's one scene, connected: its window, the chapters in it.
scene_connected(
    _self: int,
    _cmd: int,
    scene: int,
    _session: int,
    options: int
): int {
    if (window != 0) return 0;
    self: int = app_obj;
    window = msg1(msg(cls("UIWindow"), sel("alloc")), sel("initWithWindowScene:"),
        scene);
    msg1(window, sel("setTintColor:"), accent);
    msg1(window, sel("setBackgroundColor:"), paper);
    // The chapters, one after another.
    reader = msg1(msg(cls("UITableViewController"), sel("alloc")), sel("initWithStyle:"),
        0);
    table = msg(reader, sel("tableView"));
    msg1(table, sel("setDataSource:"), self);
    msg1(table, sel("setDelegate:"), self);
    msg1(table, sel("setSeparatorStyle:"), 0);
    msg1(table, sel("setAllowsSelection:"), 0);
    msg1(table, sel("setBackgroundColor:"), paper);
    msg_set_f(table, sel("setRowHeight:"), objc_const_f("UITableViewAutomaticDimension"));
    msg_set_f(table, sel("setEstimatedRowHeight:"), em * 140.0f64);
    // The chapter's name at the top (shown once its heading is under the
    // bar), and the books, beside it.
    title_button = keep(msg1(cls("UIButton"), sel("buttonWithType:"), 1));
    msg3(title_button, sel("addTarget:action:forControlEvents:"), self, sel("showPicker:"),
        64);
    item: int = msg(reader, sel("navigationItem"));
    msg1(item, sel("setTitleView:"), title_button);
    image: int = msg1(cls("UIImage"), sel("systemImageNamed:"), nsstring("list.bullet"));
    books_item: int = msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        image, 0, self, sel("showPicker:"));
    msg1(books_item, sel("setAccessibilityLabel:"), nsstring("Books"));
    msg1(item, sel("setRightBarButtonItem:"), books_item);
    release(books_item);
    nav = msg1(msg(nav_class, sel("alloc")), sel("initWithRootViewController:"), reader);
    // The bar: clear over the text's top, frosted once the text is under it.
    bar: int = msg(nav, sel("navigationBar"));
    standard: int = make("UINavigationBarAppearance");
    msg(standard, sel("configureWithDefaultBackground"));
    edge: int = make("UINavigationBarAppearance");
    msg(edge, sel("configureWithTransparentBackground"));
    msg1(bar, sel("setStandardAppearance:"), standard);
    msg1(bar, sel("setCompactAppearance:"), standard);
    msg1(bar, sel("setScrollEdgeAppearance:"), edge);
    msg1(window, sel("setRootViewController:"), nav);
    msg(window, sel("makeKeyAndVisible"));
    msg(window, sel("layoutIfNeeded"));
    // Paper behind the status bar (under the bar), so that text read on
    // with the bars hidden does not run up under the camera.
    l8_msg_hfa(hfa, window, sel("safeAreaInsets"), 0, 0, 0);
    top: f64 = hfa[0];
    l8_msg_hfa(hfa, window, sel("bounds"), 0, 0, 0);
    strip: int = msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, hfa[2], top);
    msg1(strip, sel("setBackgroundColor:"), paper);
    msg1(strip, sel("setAutoresizingMask:"), 2);
    msg1(strip, sel("setUserInteractionEnabled:"), 0);
    msg2(msg(nav, sel("view")), sel("insertSubview:belowSubview:"), strip, bar);
    release(strip);
    set_title();
    go(cur, restore_y as f64);
    note("bible: up");
    if (demo_on) demo_listen();
    links: int = msg(options, sel("URLContexts"));
    if (links != 0) open_links(links);
    0
}

scene_window(_self: int, _cmd: int): int {
    window
}

// The text, from the app's bundle.
load_text() noregion {
    bundle: int = msg(cls("NSBundle"), sel("mainBundle"));
    path: int = msg2(bundle, sel("pathForResource:ofType:"), nsstring("bsb"), nsstring("txt"));
    if (path == 0) {
        note("bible: no bsb.txt");
        return
    }
    fd: int = open(cstr(nsstring_bytes(path)), 0, 0);
    if (fd < 0) return;
    bsb = new i8[6291456](0i8);
    n: int = 0;
    more: bool = true;
    while (more && n < len(bsb)) {
        r: int = read(fd, bsb, n, len(bsb) - n);
        if (r <= 0) more = false else n = n + r
    }
    close(fd);
    bible_index(n)
}

main() noregion: int {
    note("bible: starting");
    load_text();
    demo_on = getenv("L8_DEMO") != null;
    // The navigation controller, which hides the status bar with its bar.
    nav_class = objc_allocateClassPair(cls("UINavigationController"), "L8Nav", 0);
    add_method0(nav_class, sel("prefersStatusBarHidden"), &nav_status_hidden, "B@:");
    add_method0(nav_class, sel("childViewControllerForStatusBarHidden"), &nav_status_child,
        "@@:");
    add_method0(nav_class, sel("preferredStatusBarUpdateAnimation"), &nav_status_animation,
        "q@:");
    objc_registerClassPair(nav_class);
    // The books' list, which starts at the book being read.
    books_class = objc_allocateClassPair(cls("UITableViewController"), "L8Books",
        0);
    add_method0(books_class, sel("viewDidLayoutSubviews"), &books_layout, "v@:");
    objc_registerClassPair(books_class);
    // The app's delegate, and every other delegate and data source.
    app: int = objc_allocateClassPair(cls("UIResponder"), "L8BibleApp", 0);
    add_method2(app, sel("application:didFinishLaunchingWithOptions:"), &app_launched,
        "B@:@@");
    add_method1(app, sel("applicationDidEnterBackground:"), &app_background, "v@:@");
    add_method1(app, sel("scrollViewWillBeginDragging:"), &scroll_began, "v@:@");
    add_method1(app, sel("scrollViewDidScroll:"), &scrolled, "v@:@");
    add_method1(app, sel("scrollViewDidEndDecelerating:"), &scroll_ended, "v@:@");
    add_method2(app, sel("scrollViewDidEndDragging:willDecelerate:"), &scroll_dragged,
        "v@:@B");
    add_method1(app, sel("tapped:"), &tapped, "v@:@");
    add_method2(app, sel("gestureRecognizer:shouldRecognizeSimultaneouslyWithGestureRecognizer:"),
        &together, "B@:@@");
    add_method2(app, sel("adaptivePresentationStyleForPresentationController:traitCollection:"),
        &popover_style, "q@:@@");
    add_method1(app, sel("showPicker:"), &show_picker, "v@:@");
    add_method1(app, sel("closePicker:"), &close_picker, "v@:@");
    add_method1(app, sel("numberOfSectionsInTableView:"), &table_sections, "q@:@");
    add_method2(app, sel("tableView:numberOfRowsInSection:"), &table_rows, "q@:@q");
    add_method2(app, sel("tableView:titleForHeaderInSection:"), &table_header, "@@:@q");
    add_method2(app, sel("tableView:cellForRowAtIndexPath:"), &table_cell, "@@:@@");
    add_method2(app, sel("tableView:didSelectRowAtIndexPath:"), &table_picked, "v@:@@");
    add_method2(app, sel("collectionView:numberOfItemsInSection:"), &grid_items, "q@:@q");
    add_method2(app, sel("collectionView:cellForItemAtIndexPath:"), &grid_cell, "@@:@@");
    add_method2(app, sel("collectionView:didSelectItemAtIndexPath:"), &grid_picked,
        "v@:@@");
    add_method1(app, sel("textSizeChanged:"), &text_size_changed, "v@:@");
    add_protocol(app, "UIApplicationDelegate");
    add_protocol(app, "UITableViewDataSource");
    add_protocol(app, "UITableViewDelegate");
    add_protocol(app, "UICollectionViewDataSource");
    add_protocol(app, "UICollectionViewDelegate");
    add_protocol(app, "UIGestureRecognizerDelegate");
    add_protocol(app, "UIPopoverPresentationControllerDelegate");
    objc_registerClassPair(app);
    // The scene's delegate (UIKit makes it, from Info.plist's manifest): its
    // window is made with the app delegate's objects.
    scene: int = objc_allocateClassPair(cls("UIResponder"), "L8BibleScene", 0);
    add_method3(scene, sel("scene:willConnectToSession:options:"), &scene_connected,
        "v@:@@@");
    add_method1(scene, sel("sceneDidEnterBackground:"), &app_background, "v@:@");
    add_method2(scene, sel("scene:openURLContexts:"), &scene_links, "v@:@@");
    add_method0(scene, sel("window"), &scene_window, "@@:");
    add_protocol(scene, "UIWindowSceneDelegate");
    objc_registerClassPair(scene);
    note("bible: classes made; UIKit next");
    UIApplicationMain(l8rt_argc(), l8rt_argv(), 0, nsstring("L8BibleApp"))
}
