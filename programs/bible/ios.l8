// ---- where the reader is, kept ----
defaults(): int {
    msg(cls("NSUserDefaults"), sel("standardUserDefaults"))
}

save_place() {
    d: int = defaults();
    msg2(d, sel("setInteger:forKey:"), cur + 1, nsstring("chapter"));
    y: int = cur_y as int;
    if (y < 0) y = 0;
    msg2(d, sel("setInteger:forKey:"), y, nsstring("y"))
}

load_place() {
    d: int = defaults();
    c: int = msg1(d, sel("integerForKey:"), nsstring("chapter")) - 1;
    if (c >= 0 && c < chapters) {
        cur = c;
        restore_y = msg1(d, sel("integerForKey:"), nsstring("y"))
    }
}

app_background(_self: int, _cmd: int, _application: int): int {
