    msg1(view, sel("setDelegate:"), app_obj);
    sheet_nav: int = presented();
    if (sheet_nav != 0) msg2(sheet_nav, sel("pushViewController:animated:"), grid,
        1);
    release(grid)
}

grid_items(
    _self: int,
