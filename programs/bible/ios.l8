// The phone's text size changed: the text made again, at about the same
// place (as far down, scaled with the text).
text_size_changed(_self: int, _cmd: int, _note: int): int {
    c: int = cur;
    y: f64 = cur_y / em;
    make_look();
    msg(table, sel("reloadData"));
    go(c, y * em);
    0
