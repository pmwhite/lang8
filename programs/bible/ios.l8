tag bible_ios;

use_tag std, ios, bible;

// Smooth Bible, the Bible app for an iPhone, built with `l8 arm64 --target ios` (see
// tools/ios/build.sh and programs/bible/ios/): the Berean Standard Bible to
// read, in UIKit's own views, so it reads, scrolls, selects and copies as
// the phone's own apps do.
//
// A navigation controller holds a table of every chapter, one after
// another, read on by scrolling from Genesis 1 to Revelation 22. Each row is
// a text view of one attributed string (text.l8 lays the chapter out as
// runs; each run here is a string in its style), its text sized from the
// phone's text size, headed by its book's name where a book begins and its
// number. The bar's title is the chapter being read, shown once its heading
// has scrolled up under the bar; the title, or the books button beside it,
// opens a sheet of the books, and a book its chapters. A tap on a
// footnote's mark shows the note; a tap elsewhere hides or shows the bars,
// which scrolling on through the text hides too. Where the reader was is
// kept.
//
// Links (bsb://JHN/3) open a chapter. With L8_DEMO=1 in the environment,
// Darwin notifications take it through a demo, for the simulator in CI (see
// programs/bible/ios/simulate.sh).
import "../../stdlib/print.l8";

import "../ios/objc.l8";

import "text.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

extern getenv(name: str): ?*i8;

extern msg_f_f(receiver: int, selector: int, x: f64): f64 = objc_msgSend;

extern CFNotificationCenterGetDarwinNotifyCenter(): int;

extern CFNotificationCenterAddObserver(
    center: int,
    observer: int,
    callback: fn(center: int, observer: int, name: int, object: int, info: int): int,
    name: int,
    object: int,
    behavior: int
): int;

extern msg_super0(sup: *ObjcSuper, selector: int): int = objc_msgSendSuper;

// [super selector], from a method of cls (the class that defines it).
super0(self: int, cls: int, selector: int) {
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(cls) };
    msg_super0(&sup, selector)
}

note(what: str) {
    try {
        eprint(what)
    } with IoError _e -> { }
}

// ---- what UIKit made ----
app_obj: int = 0;

window: int = 0;

nav: int = 0;

// The table of chapters (and its controller).
reader: int = 0;

table: int = 0;

title_button: int = 0;

// The book whose chapters the sheet of books shows.
picker_book: int = 0;

books_class: int = 0;

nav_class: int = 0;

// The chapter being read (the one at the top), and how far down into it
// (points); where that was when the app was last shut.
cur: int = 0;

cur_y: f64 = 0.0f64;

restore_y: int = 0;

bars_hidden: bool = false;

// A drag's start (where the text was), to tell which way it went.
drag_from: f64 = 0.0f64;

// Results of four doubles (msg_hfa), kept: callbacks run outside any region.
hfa: []f64 = new f64[4](0.0f64);

// ---- the text's look ----
// The phone's text size, as the body's size in points; the fonts, colors,
// paragraph styles and attributes made from it (kept: made again when the
// text size changes).
em: f64 = 19.0f64;

k_font: int = 0;

k_color: int = 0;

k_para: int = 0;

k_baseline: int = 0;

k_kern: int = 0;

k_link: str = "L8Link";

serif_desc: int = 0;

ink: int = 0;

faint: int = 0;

accent: int = 0;

paper: int = 0;

fonts: []int = new int[STYLES](0);

// For each style and paragraph kind (with a stanza's break or not), its
// paragraph style and attributes.
paras: []int = new int[STYLES * 14](0);

attrs: []int = new int[STYLES * 14](0);

keys: []int = new int[8](0);

one_object: []int = new int[1](0);

values: []int = new int[8](0);

color_named(name: str, otherwise: str): int {
    c: int = msg1(cls("UIColor"), sel("colorNamed:"), nsstring(name));
    if (c == 0) c = msg(cls("UIColor"), sel(otherwise));
    keep(c)
}

serif(size: f64): int {
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), serif_desc, size)
}

serif_italic(size: f64): int {
    d: int = msg1(serif_desc, sel("fontDescriptorWithSymbolicTraits:"), 1);
    if (d == 0) d = serif_desc;
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

// The serif with its capitals as small capitals (the font's own, through
// its feature for them: type 38, kUpperCaseType; selector 1, small caps).
small_caps(size: f64): int {
    keys[0] = objc_const("UIFontFeatureTypeIdentifierKey");
    values[0] = msg1(cls("NSNumber"), sel("numberWithLong:"), 38);
    keys[1] = objc_const("UIFontFeatureSelectorIdentifierKey");
    values[1] = msg1(cls("NSNumber"), sel("numberWithLong:"), 1);
    one: []int = one_object;
    one[0] = nsdictionary(keys, values, 2);
    keys[0] = objc_const("UIFontDescriptorFeatureSettingsAttribute");
    values[0] = nsarray(one, 1);
    d: int = msg1(serif_desc, sel("fontDescriptorByAddingAttributes:"), nsdictionary(keys,
        values, 1));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

sans(size: f64, weight: f64): int {
    msg_ff(cls("UIFont"), sel("systemFontOfSize:weight:"), size, weight)
}

release(object: int) {
    if (object != 0) msg(object, sel("release"))
}

// The fonts and the rest, for the phone's text size now.
make_look() {
    if (k_font == 0) {
        k_font = objc_const("NSFontAttributeName");
        k_color = objc_const("NSForegroundColorAttributeName");
        k_para = objc_const("NSParagraphStyleAttributeName");
        k_baseline = objc_const("NSBaselineOffsetAttributeName");
        k_kern = objc_const("NSKernAttributeName");
        body: int = objc_const("UIFontTextStyleBody");
        d: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
            body);
        s: int = msg1(d, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
        serif_desc = keep(if (s != 0) s else d);
        ink = color_named("Ink", "labelColor");
        faint = color_named("Faint", "secondaryLabelColor");
        accent = color_named("Accent", "tintColor");
        paper = color_named("Paper", "systemBackgroundColor")
    }
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    em = msg_f_f(metrics, sel("scaledValueForValue:"), 19.0f64);
    for i in 0..len(fonts) release(fonts[i]);
    fonts[STYLE_BODY] = keep(serif(em));
    fonts[STYLE_VERSE] = keep(sans(em * 0.56f64, 0.3f64));
    fonts[STYLE_BOOK] = keep(serif(em * 1.75f64));
    fonts[STYLE_NUMERAL] = keep(serif(em * 2.4f64));
    fonts[STYLE_HEAD] = keep(sans(em * 0.9f64, 0.3f64));
    fonts[STYLE_SUBHEAD] = keep(sans(em * 0.8f64, 0.3f64));
    fonts[STYLE_REF] = keep(serif_italic(em * 0.78f64));
    fonts[STYLE_TITLE] = keep(serif_italic(em * 0.94f64));
    fonts[STYLE_MAJOR] = keep(sans(em * 0.66f64, 0.3f64));
    fonts[STYLE_RANGE] = keep(serif_italic(em * 0.8f64));
    fonts[STYLE_ACROSTIC] = keep(sans(em * 0.7f64, 0.3f64));
    fonts[STYLE_NOTE] = keep(sans(em * 0.56f64, 0.4f64));
    fonts[STYLE_LABEL] = keep(sans(em * 0.6f64, 0.3f64));
    fonts[STYLE_CAPS] = keep(small_caps(em));
    for i in 0..len(paras) {
        release(paras[i]);
        release(attrs[i]);
        paras[i] = 0;
        attrs[i] = 0
    }
}

// A paragraph style: its alignment (0 left, 1 centered, 2 right), its
// first line's indent and the rest's, and its space before and after.
para_style(
    align: int,
    first: f64,
    head: f64,
    before: f64,
    after: f64,
    lines: f64
): int {
    p: int = msg(msg(cls("NSMutableParagraphStyle"), sel("alloc")), sel("init"));
    msg1(p, sel("setAlignment:"), align);
    msg_set_f(p, sel("setFirstLineHeadIndent:"), first);
    msg_set_f(p, sel("setHeadIndent:"), head);
    msg_set_f(p, sel("setParagraphSpacingBefore:"), before);
    msg_set_f(p, sel("setParagraphSpacing:"), after);
    msg_set_f(p, sel("setLineHeightMultiple:"), lines);
    p
}

// The paragraph style of a style's runs in a paragraph of kind para.
para_for(style: int, para: int): int {
    at: int = style * 14 + para;
    if (paras[at] != 0) return paras[at];
    kind: int = para % KINDS;
    gap: f64 = if (para >= KINDS) em * 0.8f64 else 0.0f64;
    p: int = 0;
    if (style == STYLE_BOOK) p = para_style(1, 0.0f64, 0.0f64, em * 1.0f64, em * 1.2f64,
        1.0f64) else if (style == STYLE_NUMERAL) p = para_style(1, 0.0f64, 0.0f64,
        0.0f64, em * 0.5f64, 1.0f64) else if (style == STYLE_HEAD) p = para_style(0,
        0.0f64, 0.0f64, em * 1.4f64, em * 0.3f64, 1.1f64) else if (style == STYLE_SUBHEAD) p = para_style(0,
        0.0f64, 0.0f64, em * 1.0f64, em * 0.25f64, 1.1f64) else if (style == STYLE_REF) p = para_style(0,
        0.0f64, 0.0f64, 0.0f64, em * 0.6f64, 1.1f64) else if (style == STYLE_TITLE) p = para_style(0,
        0.0f64, 0.0f64, em * 0.2f64, em * 0.6f64, 1.15f64) else if (style == STYLE_MAJOR) p = para_style(1,
        0.0f64, 0.0f64, em * 1.2f64, em * 0.1f64, 1.0f64) else if (style == STYLE_RANGE) p = para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 0.6f64, 1.0f64) else if (style == STYLE_ACROSTIC) p = para_style(0,
        0.0f64, 0.0f64, em * 1.2f64, em * 0.3f64, 1.0f64) else if (style == STYLE_LABEL) p = para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 0.1f64, 1.0f64) else if (kind == PARA_Q1) p = para_style(0,
        em * 1.0f64, em * 2.6f64, gap, 0.0f64, 1.22f64) else if (kind == PARA_Q2) p = para_style(0,
        em * 2.0f64, em * 2.6f64, gap, 0.0f64, 1.22f64) else if (kind == PARA_L1) p = para_style(0,
        em * 1.0f64, em * 2.0f64, gap, 0.0f64, 1.22f64) else if (kind == PARA_L2) p = para_style(0,
        em * 2.0f64, em * 3.0f64, gap, 0.0f64, 1.22f64) else if (kind == PARA_CENTER) p = para_style(1,
        0.0f64, 0.0f64, gap, 0.0f64, 1.22f64) else if (kind == PARA_RIGHT) p = para_style(2,
        0.0f64, 0.0f64, gap, 0.0f64, 1.22f64) else p = para_style(0, 0.0f64, 0.0f64,
        gap, 0.0f64, 1.22f64);
    paras[at] = p;
    p
}

color_for(style: int): int {
    if (style == STYLE_BODY || style == STYLE_HEAD || style == STYLE_CAPS || style == STYLE_BOOK) return ink;
    if (style == STYLE_NUMERAL || style == STYLE_NOTE || style == STYLE_ACROSTIC) return accent;
    faint
}

// The attributes of run r: its style's, in its paragraph, and for a
// footnote's mark, what a tap on it opens (the note's place in the text).
attrs_for(r: int): int {
    style: int = run_style[r];
    para: int = run_para[r];
    link: bool = style == STYLE_NOTE;
    at: int = style * 14 + para;
    if (!link && attrs[at] != 0) return attrs[at];
    n: int = 0;
    keys[n] = k_font;
    values[n] = fonts[style];
    n = n + 1;
    keys[n] = k_color;
    values[n] = color_for(style);
    n = n + 1;
    keys[n] = k_para;
    values[n] = para_for(style, para);
    n = n + 1;
    if (style == STYLE_VERSE || style == STYLE_NOTE) {
        keys[n] = k_baseline;
        values[n] = nsnumber_f(em * 0.34f64);
        n = n + 1
    }
    if (style == STYLE_LABEL || style == STYLE_MAJOR || style == STYLE_ACROSTIC) {
        keys[n] = k_kern;
        values[n] = nsnumber_f(em * 0.12f64);
        n = n + 1
    }
    if (link) {
        keys[n] = nsstring(k_link);
        values[n] = msg1(cls("NSNumber"), sel("numberWithLong:"), run_arg[r]);
        n = n + 1
    }
    d: int = nsdictionary(keys, values, n);
    if (!link) attrs[at] = keep(d);
    d
}

// Chapter c as an attributed string (autoreleased).
chapter_text(c: int): int {
    layout_chapter(c);
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    base: int = bytes_address(out);
    p: int = 0;
    for r in 0..runs {
        e: int = run_end[r];
        a: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
            nsstring_at(base + p, e - p), attrs_for(r));
        msg1(s, sel("appendAttributedString:"), a);
        release(a);
        p = e
    }
    s
}

// ---- the chapters, one after another ----
// The table's rows: a row a chapter, each a text view (not scrolling by
// itself: the table does) of the chapter, its tag the chapter plus one.
is_reader(t: int): bool {
    t != 0 && t == table
}

chapter_path(c: int): int {
    msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), c, 0)
}

// Space above a chapter, apart from the one before.
chapter_gap(c: int): f64 {
    if (c == 0) em * 0.6f64 else em * 2.6f64
}

chapter_cell(t: int, path: int): int {
    c: int = msg(path, sel("row"));
    cell: int = msg1(t, sel("dequeueReusableCellWithIdentifier:"), nsstring("chapter"));
    if (cell == 0) {
        cell = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
            0, nsstring("chapter")), sel("autorelease"));
        msg1(cell, sel("setBackgroundColor:"), paper);
        msg1(cell, sel("setSelectionStyle:"), 0);
        content: int = msg(cell, sel("contentView"));
        tv: int = msg_rect(msg(cls("UITextView"), sel("alloc")), sel("initWithFrame:"),
            0.0f64, 0.0f64, 320.0f64, 100.0f64);
        msg1(tv, sel("setScrollEnabled:"), 0);
        msg1(tv, sel("setEditable:"), 0);
        msg1(tv, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
        msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
        msg1(tv, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
            app_obj, sel("tapped:"));
        msg1(tap, sel("setDelegate:"), app_obj);
        msg1(tv, sel("addGestureRecognizer:"), tap);
        release(tap);
        msg1(content, sel("addSubview:"), tv);
        release(tv);
        pin(tv, content, "leadingAnchor");
        pin(tv, content, "trailingAnchor");
        pin(tv, content, "topAnchor");
        pin(tv, content, "bottomAnchor")
    }
    tv: int = text_of_cell(cell);
    msg_rect(tv, sel("setTextContainerInset:"), chapter_gap(c), 26.0f64, if (c + 1 == chapters) 96.0f64 else 0.0f64,
        26.0f64);
    msg1(tv, sel("setAttributedText:"), chapter_text(c));
    msg1(tv, sel("setTag:"), c + 1);
    cell
}

// Edge name of a and b, the same.
pin(a: int, b: int, edge: str) {
    msg1(msg1(msg(a, sel(edge)), sel("constraintEqualToAnchor:"), msg(b, sel(edge))),
        sel("setActive:"), 1)
}

text_of_cell(cell: int): int {
    msg(msg(msg(cell, sel("contentView")), sel("subviews")), sel("lastObject"))
}

chapter_of_view(v: int): int {
    msg(v, sel("tag")) - 1
}

// The text view of the chapter being read (0 if it is not on the screen).
current_view(): int {
    cell: int = msg1(table, sel("cellForRowAtIndexPath:"), chapter_path(cur));
    if (cell == 0) return 0;
    text_of_cell(cell)
}

// The text's top, where it rests unscrolled (the bars above it).
top_inset(sv: int): f64 {
    l8_msg_hfa(hfa, sv, sel("adjustedContentInset"), 0, 0, 0);
    hfa[0]
}

offset_y(sv: int): f64 {
    l8_msg_hfa(hfa, sv, sel("contentOffset"), 0, 0, 0);
    hfa[1]
}

// Which chapter is at the top (under the bars), and how far down into it:
// cur and cur_y. The title follows.
find_place() {
    top: f64 = offset_y(table) + top_inset(table);
    path: int = msg_ff(table, sel("indexPathForRowAtPoint:"), 40.0f64, top + 1.0f64);
    if (path == 0) return;
    c: int = msg(path, sel("row"));
    l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), path, 0, 0);
    cur_y = top - hfa[1];
    if (c != cur) {
        cur = c;
        set_title()
    }
    title_fade()
}

// The title shows the chapter once its heading (its book's name, its
// number) has gone up under the bar: it is not shown twice.
title_fade() {
    b: int = ch_book[cur];
    heading: f64 = chapter_gap(cur) + (if (book_count[b] > 1) em * 3.2f64 else 0.0f64) + (if (ch_num[cur] == 1) em * 3.6f64 else 0.0f64) + (if (book_is(b,
        "PSA")) em * 0.9f64 else 0.0f64);
    a: f64 = (cur_y - heading) / (em * 1.2f64);
    if (a < 0.0f64) a = 0.0f64;
    if (a > 1.0f64) a = 1.0f64;
    msg_set_f(title_button, sel("setAlpha:"), a)
}

// Chapter c, at y points down into it.
go(c: int, y: f64) {
    if (c < 0 || c >= chapters) return;
    path: int = chapter_path(c);
    // (Twice: the rows above are only estimated until they have been laid
    // out, and the first jump lays out those around it.)
    msg3(table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), path, 1,
        0);
    msg(table, sel("layoutIfNeeded"));
    msg3(table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), path, 1,
        0);
    if (y > 0.0f64) {
        l8_msg_hfa(hfa, table, sel("contentSize"), 0, 0, 0);
        most: f64 = hfa[1] - 400.0f64;
        to: f64 = offset_y(table) + y;
        if (to > most) to = most;
        msg_ff1(table, sel("setContentOffset:animated:"), 0.0f64, to, 0)
    }
    cur = -1;
    find_place();
    show_bars(false);
    save_place()
}

// ---- the bars ----
show_bars(hidden: bool) {
    if (hidden == bars_hidden) return;
    bars_hidden = hidden;
    msg2(nav, sel("setNavigationBarHidden:animated:"), if (hidden) 1 else 0, 1);
    msg(nav, sel("setNeedsStatusBarAppearanceUpdate"))
}

nav_status_hidden(_self: int, _cmd: int): int {
    if (bars_hidden) 1 else 0
}

nav_status_child(_self: int, _cmd: int): int {
    0
}

nav_status_animation(_self: int, _cmd: int): int {
    1
}

// Scrolling on through the text hides the bars; back to its top shows them.
scroll_began(_self: int, _cmd: int, sv: int): int {
    if (!is_reader(sv)) return 0;
    drag_from = offset_y(sv);
    0
}

scrolled(_self: int, _cmd: int, sv: int): int {
    if (!is_reader(sv)) return 0;
    find_place();
    y: f64 = offset_y(sv);
    if ((msg(sv, sel("isTracking")) & 255) != 0 && y > drag_from + 30.0f64 && y > 0.0f64) show_bars(true);
    if (y + top_inset(sv) < 4.0f64 && bars_hidden && (msg(sv, sel("isDragging")) & 255) != 0) show_bars(false);
    0
}

scroll_ended(_self: int, _cmd: int, sv: int): int {
    if (is_reader(sv)) save_place();
    0
}

scroll_dragged(
    _self: int,
    _cmd: int,
    sv: int,
    decelerate: int
): int {
    if (is_reader(sv) && (decelerate & 255) == 0) save_place();
    0
}

// A tap: on a footnote's mark, the note; elsewhere, the bars shown or hidden (unless text is selected,
// which the tap puts away).
tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    x: f64 = hfa[0];
    y: f64 = hfa[1];
    link: int = link_at(tv, x, y);
    if (link > 0) {
        show_note(tv, link, x, y);
        return 0
    }
    range: int = msg(tv, sel("selectedTextRange"));
    if (range != 0 && (msg(range, sel("isEmpty")) & 255) == 0) return 0;
    show_bars(!bars_hidden);
    0
}

// What a link at (x, y) in tv opens (0 if none there).
link_at(tv: int, x: f64, y: f64): int {
    pos: int = msg_ff(tv, sel("closestPositionToPoint:"), x, y);
    if (pos == 0) return 0;
    i: int = msg2(tv, sel("offsetFromPosition:toPosition:"), msg(tv, sel("beginningOfDocument")),
        pos);
    storage: int = msg(tv, sel("textStorage"));
    n: int = msg(storage, sel("length"));
    key: int = nsstring(k_link);
    // The character after the place, or before it (a mark is one letter).
    for k in [i, i - 1] {
        if (k >= 0 && k < n) {
            v: int = msg3(storage, sel("attribute:atIndex:effectiveRange:"), key,
                k, 0);
            if (v != 0 && near_char(tv, k, x, y)) return msg(v, sel("longValue"))
        }
    }
    0
}

// Whether (x, y) is on or near character k of tv (a finger's width).
near_char(
    tv: int,
    k: int,
    x: f64,
    y: f64
): bool {
    begin: int = msg(tv, sel("beginningOfDocument"));
    a: int = msg2(tv, sel("positionFromPosition:offset:"), begin, k);
    b: int = msg2(tv, sel("positionFromPosition:offset:"), begin, k + 1);
    if (a == 0 || b == 0) return false;
    range: int = msg2(tv, sel("textRangeFromPosition:toPosition:"), a, b);
    l8_msg_hfa(hfa, tv, sel("firstRectForRange:"), range, 0, 0);
    slack: f64 = 16.0f64;
    x >= hfa[0] - slack && x <= hfa[0] + hfa[2] + slack && y >= hfa[1] - slack && y <= hfa[1] + hfa[3] + slack
}

// A footnote, in a popover pointing at its mark.
show_note(
    tv: int,
    at: int,
    x: f64,
    y: f64
) {
    e: int = line_end(at);
    label: int = make("UILabel");
    msg1(label, sel("setNumberOfLines:"), 0);
    msg1(label, sel("setFont:"), serif(em * 0.9f64));
