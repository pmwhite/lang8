tag bible_spoken;

use_tag std, bible;

// What the app says aloud, verse by verse, for the aligner (DESIGN.md
// §12.2.3): `spoken PATH` prints a line a verse of the text at PATH
// (data/bsb.txt, data/web.txt), BOOK, chapter, verse, the words as
// text.l8's speak_text says them, and the words as written (so that
// tools/align.py can tell the LORD from the Lord). A psalm's title is verse
// 0, since the readers read it; headings are left out, since none do.
import "../../../stdlib/print.l8";

import "../core/text.l8";

need "libc.so.6";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

// The text at path read in as version 0 (whatever it is), and made the
// current one: whether it could be.
load_text(path: str@immortal): bool {
    text_path = path;
    fd: int = open(path, 0, 0);
    if (fd < 0) return false;
    size: int = lseek(fd, 0, 2);
    close(fd);
    if (size <= 0) return false;
    text_read(0, 0, size, &text_file_read);
    text_use(0);
    true
}

text_path: str = "";

extern lseek(fd: int, offset: int, whence: int): int;

// The text's file into out (its size long, and a zero after).
text_file_read(_id: int, out: []i8) {
    fd: int = open(text_path, 0, 0);
    if (fd < 0) return;
    got: int = 0;
    more: bool = true;
    while (more && got < len(out) - 1) {
        r: int = read(fd, out, got, len(out) - 1 - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd)
}

// The line being written.
ob: []i8 = new i8[65536](0i8);

ob_n: int = 0;

ob_byte(k: int) {
    if (ob_n < len(ob)) {
        ob[ob_n] = k trunc i8;
        ob_n = ob_n + 1
    }
}

ob_str(s: str) {
    for i in 0..len(s) ob_byte(s[i] as int)
}

ob_int(n: int) {
    if (n >= 10) ob_int(n / 10);
    ob_byte(48 + n % 10)
}

ob_vt() {
    for i in 0..vt_n {
        k: int = ub(vt, i);
        // (A tab or newline would break the line's fields.)
        ob_byte(if (k == 9 || k == 10) 32 else k)
    }
}

// Chapter c's psalm title (its D and d lines, before verse 1) into vt.
title_text(c: int) {
    vt_n = 0;
    borrow texts[text_cur] as text {
        p: int = text.starts[c];
        while (p < text.ends[c]) {
            e: int = record_line_end(text.data, text.size, p);
            k: int = text.data[p] as int;
            if (k == 86) return;
            if (k == 68 || k == 100) {
                if (vt_n > 0 && vt[vt_n - 1] as int != 32 && p + 1 < e && text.data[p + 1] as int != 32) vt_add(32);
                for i in p + 1..e vt_add(text.data[i] as int)
            }
            p = e + 1
        }
    }
}

// Verse v of chapter c (0: its title) into vt, as written.
written(c: int, v: int) {
    if (v == 0) title_text(c) else _n: int = verse_text(c, v)
}

line(c: int, v: int) raises IoError {
    written(c, v);
    if (v == 0 && vt_n == 0) return;
    ob_n = 0;
    for i in 0..3 ob_byte(book_code_byte(ch_book[c], i));
    ob_byte(9);
    ob_int(ch_num[c]);
    ob_byte(9);
    ob_int(v);
    ob_byte(9);
    _m: int = vt_speak();
    ob_vt();
    ob_byte(9);
    written(c, v);
    ob_vt();
    ob_byte(10);
    write_bytes_n(1, ob, ob_n)
}

main(argc: int, argv: []str@immortal) raises IoError: int {
    if (argc != 2) {
        eprint("usage: spoken data/bsb.txt");
        return 2
    }
    if (!load_text(argv[1])) {
        eprint("spoken: cannot open the text");
        return 1
    }
    for c in 0..chapters {
        for v in 0..ch_verses[c] + 1 line(c, v)
    }
    0
}
