tag bible_link_cases;

use_tag std, bible;

// Cases of following (SKINS.md, Panes: Linked), from core/follow.l8's
// rules, for a skin not written in L8 to check its own against: each a
// chapter's link map, both panes' anchors' places (`-` not laid out), the
// leader's reading line, and where the follower goes. A skin's tests read
// them and must match each to within a hundredth of a point:
//
//   .build/link-cases programs/bible/... > cases.txt
//
// Lines:
//   verse PAGE_LEADS LEADER_EM FOLLOWER_EM LINE   a version following
//   map I0 I1 J ...                               the map, three a match
//   page TOP END START...                         the page's chapter
//   panel TOP END START...                        the panel's
//   expect Y | expect none
//   frompage PAGE_I PANEL_J PANEL_LINE            a commentary led by the page
//   frompanel PANEL_J PAGE_I                      the page led by a commentary
//   expect stay | expect go ANCHOR
import "../../../stdlib/print.l8";

import "../core/follow.l8";

// A pseudo-random stream, the same every run.
lc_seed: int = 12345;

lc_next(most: int): int {
    lc_seed = (lc_seed * 1103515245 + 12345) % 2147483648;
    lc_seed / 65536 % most
}

lc_write_shape(word: str, s: *ChapterShape) raises IoError {
    write(1, word);
    lc_write_value(s.top, s.top_known);
    lc_write_value(s.end, s.end_known);
    for k in 0..len(s.starts) lc_write_value(s.starts[k], s.known[k]);
    write(1, "\n")
}

lc_write_value(x: f64, known: bool) raises IoError {
    write(1, " ");
    if (known) write_fixed(1, x, 4) else write(1, "-")
}

lc_write_map(map: *LinkMap) raises IoError {
    write(1, "map");
    for k in 0..len(map.j) {
        write(1, " ");
        write_int(1, map.i0[k]);
        write(1, " ");
        write_int(1, map.i1[k]);
        write(1, " ");
        write_int(1, map.j[k])
    }
    write(1, "\n")
}

// A chapter of n anchors, each line_h * (1 to 6 lines) after the one
// before, from top; those from first_known to last_known laid out.
lc_shape(
    n: int,
    top: f64,
    line_h: f64,
    first_known: int,
    last_known: int
): ChapterShape@new {
    s: ChapterShape = ChapterShape {
        starts: new f64[n](0.0f64),
        known: new bool[n](false),
        top: top,
        top_known: first_known == 0,
        end: 0.0f64,
        end_known: last_known == n - 1,
        em: line_h / 1.4f64
    };
    y: f64 = top + line_h * 2.0f64;
    for k in 0..n {
        s.starts[k] = y;
        s.known[k] = k >= first_known && k <= last_known;
        y = y + line_h * (1 + lc_next(6)) as f64
    }
    s.end = y;
    s
}

// Versions verse by verse: the panel lacking a verse now and then.
lc_verse_map(n: int): LinkMap@new {
    m: LinkMap = LinkMap {
        mode: 0,
        i0: new int[n](0),
        i1: new int[n](0),
        j: new int[n](0)
    };
    count: int = 0;
    j: int = 0;
    for i in 0..n {
        if (lc_next(9) != 0) {
            m.i0[count] = i;
            m.i1[count] = i;
            m.j[count] = j;
            count = count + 1
        }
        j = j + 1
    }
    LinkMap {
        mode: 0,
        i0: lc_cut(m.i0, count),
        i1: lc_cut(m.i1, count),
        j: lc_cut(m.j, count)
    }
}

lc_cut(xs: []int, n: int): []int@new {
    out: []int = new int[n](0);
    for k in 0..n out[k] = xs[k];
    out
}

// A commentary: comments covering runs of the page's verses, one now and
// then going back over the verses again.
lc_comment_map(n: int): LinkMap@new {
    most: int = n + 4;
    m: LinkMap = LinkMap {
        mode: 1,
        i0: new int[most](0),
        i1: new int[most](0),
        j: new int[most](0)
    };
    count: int = 0;
    i: int = 0;
    while (i < n && count < most) {
        to: int = i + lc_next(4);
        if (to >= n) to = n - 1;
        m.i0[count] = i;
        m.i1[count] = to;
        m.j[count] = count;
        count = count + 1;
        i = to + 1
    }
    if (count < most) {
        m.i0[count] = 0;
        m.i1[count] = n / 2;
        m.j[count] = count;
        count = count + 1
    }
    LinkMap {
        mode: 1,
        i0: lc_cut(m.i0, count),
        i1: lc_cut(m.i1, count),
        j: lc_cut(m.j, count)
    }
}

lc_write_step(step: CommentStep) raises IoError {
    match step {
        Stay -> write(1, "expect stay\n");
        GoTo g -> {
            write(1, "expect go ");
            write_int(1, g.anchor);
            write(1, "\n")
        }
    }
}

main() raises IoError: int {
    for case_n in 0..40 {
        region {
            n: int = 12 + lc_next(20);
            map: LinkMap = lc_verse_map(n);
            first: int = if (lc_next(3) == 0) lc_next(n / 2) else 0;
            page: ChapterShape = lc_shape(n, 100.0f64 * (1 + lc_next(5)) as f64, 26.0f64,
                0, n - 1);
            panel: ChapterShape = lc_shape(n, 40.0f64, 20.0f64, first, n - 1);
            page_leads: bool = case_n % 2 == 0;
            leader_top: f64 = if (page_leads) page.top else panel.top;
            leader_end: f64 = if (page_leads) page.end else panel.end;
            leader_em: f64 = if (page_leads) page.em else panel.em;
            follower_em: f64 = if (page_leads) panel.em else page.em;
            pairs: FollowPairs = follow_pairs(&map, &page, &panel, page_leads);
            for _l in 0..6 {
                line: f64 = leader_top + (leader_end - leader_top) * lc_next(1000) as f64 / 1000.0f64;
                write(1, "verse ");
                write_int(1, if (page_leads) 1 else 0);
                write(1, " ");
                write_fixed(1, leader_em, 4);
                write(1, " ");
                write_fixed(1, follower_em, 4);
                write(1, " ");
                write_fixed(1, line, 4);
                write(1, "\n");
                lc_write_map(&map);
                lc_write_shape("page", &page);
                lc_write_shape("panel", &panel);
                at: FollowPlace = follow_by_verse(&pairs, line, leader_em, follower_em);
                if (at.ok) {
                    write(1, "expect ");
                    write_fixed(1, at.y, 4);
                    write(1, "\n")
                } else write(1, "expect none\n")
            }
        }
    }
    for _case in 0..40 {
        region {
            n: int = 10 + lc_next(20);
            map: LinkMap = lc_comment_map(n);
            comments: int = len(map.j);
            panel: ChapterShape = lc_shape(comments, 0.0f64, 22.0f64, lc_next(comments),
                comments - 1);
            for _q in 0..5 {
                page_i: int = lc_next(n + 1) - 1;
                panel_j: int = lc_next(comments + 1) - 1;
                line: f64 = panel.end * lc_next(1000) as f64 / 1000.0f64;
                lc_write_map(&map);
                lc_write_shape("panel", &panel);
                write(1, "frompage ");
                write_int(1, page_i);
                write(1, " ");
                write_int(1, panel_j);
                write(1, " ");
                write_fixed(1, line, 4);
                write(1, "\n");
                lc_write_step(follow_comment_from_page(&map, page_i, panel_j, &panel,
                    line));
                lc_write_map(&map);
                write(1, "frompanel ");
                write_int(1, panel_j);
                write(1, " ");
                write_int(1, page_i);
                write(1, "\n");
                lc_write_step(follow_page_from_comment(&map, panel_j, page_i))
            }
        }
    }
    0
}

// ---- the rules' own tests ----
lc_test_shape(starts: []f64@new, top: f64, end: f64): ChapterShape@new {
    ChapterShape {
        starts: starts,
        known: new bool[len(starts)](true),
        top: top,
        top_known: true,
        end: end,
        end_known: true,
        em: 20.0f64
    }
}

test "each verse's start lands within half a line of the other's" {
    map: LinkMap = LinkMap {
        mode: 0,
        i0: [0, 1, 2],
        i1: [0, 1, 2],
        j: [0, 1, 2]
    };
    page: ChapterShape = lc_test_shape([100.0f64, 200.0f64, 300.0f64], 0.0f64, 400.0f64);
    panel: ChapterShape = lc_test_shape([50.0f64, 150.0f64, 250.0f64], 0.0f64, 350.0f64);
    pairs: FollowPairs = follow_pairs(&map, &page, &panel, true);
    for k in 0..3 {
        y: f64 = follow_by_verse(&pairs, page.starts[k], 20.0f64, 20.0f64).y;
        d: f64 = y - panel.starts[k];
        print_bool(d <= 10.0f64 && d >= -10.0f64)
    }
    expect {|
        true
        true
        true
    |}
}

test "between verses it moves steadily, within half a line of the curve" {
    map: LinkMap = LinkMap {
        mode: 0,
        i0: [0, 1, 2, 3],
        i1: [0, 1, 2, 3],
        j: [0, 1, 2, 3]
    };
    page: ChapterShape = lc_test_shape([100.0f64, 140.0f64, 400.0f64, 440.0f64], 0.0f64,
        500.0f64);
    panel: ChapterShape = lc_test_shape([100.0f64, 200.0f64, 300.0f64, 400.0f64],
        0.0f64, 500.0f64);
    pairs: FollowPairs = follow_pairs(&map, &page, &panel, true);
    print_fixed(follow_by_verse(&pairs, 270.0f64, 20.0f64, 20.0f64).y, 2);
    expect {|
        252.84
    |}
}

test "past what is laid out it can't be told" {
    map: LinkMap = LinkMap {
        mode: 0,
        i0: [0],
        i1: [0],
        j: [0]
    };
    page: ChapterShape = lc_test_shape([100.0f64], 0.0f64, 200.0f64);
    panel: ChapterShape = lc_test_shape([100.0f64], 0.0f64, 200.0f64);
    panel.end_known = false;
    pairs: FollowPairs = follow_pairs(&map, &page, &panel, true);
    print_bool(follow_by_verse(&pairs, 150.0f64, 20.0f64, 20.0f64).ok);
    expect {|
        false
    |}
}

test "a commentary stays while its comment covers the page's verse" {
    // (Comment 0 covers verses 0 to 2, 1 covers 3 to 5, 2 goes back over 1
    // to 4.)
    map: LinkMap = LinkMap {
        mode: 1,
        i0: [0, 3, 1],
        i1: [2, 5, 4],
        j: [0, 1, 2]
    };
    panel: ChapterShape = lc_test_shape([0.0f64, 500.0f64, 900.0f64], 0.0f64, 1200.0f64);
    lc_write_step(follow_comment_from_page(&map, 2, 0, &panel, 0.0f64));
    lc_write_step(follow_comment_from_page(&map, 3, 0, &panel, 0.0f64));
    lc_write_step(follow_comment_from_page(&map, 4, 2, &panel, 900.0f64));
    lc_write_step(follow_comment_from_page(&map, 4, 0, &panel, 0.0f64));
    expect {|
        expect stay
        expect go 1
        expect stay
        expect go 1
    |}
}

test "the page goes to the first verse of the comment leading it" {
    map: LinkMap = LinkMap {
        mode: 1,
        i0: [0, 3, 1],
        i1: [2, 5, 4],
        j: [0, 1, 2]
    };
    lc_write_step(follow_page_from_comment(&map, 1, 0));
    lc_write_step(follow_page_from_comment(&map, 2, 3));
    lc_write_step(follow_page_from_comment(&map, -1, 4));
    expect {|
        expect go 3
        expect stay
        expect go -1
    |}
}
