tag bible_core_cases;

use_tag std, bible;

need "libc.so.6";

// Core's rules for the panes checked without a skin or a phone: core's
// functions called as its lines would call them, and what it writes to
// the skin read back from its output buffer. Run by `make
// bible-follow-test` (link_cases.l8 imports this file).
import "../../../stdlib/print.l8";

import "../core/skin.l8";

// Core's output since cc_begin, lines that begin with word, written one
// to a line (the protocol's tabs as spaces).
cc_begin() {
    ui_out_n = 0;
    chapters = 1189
}

cc_lines(word: str) raises IoError {
    at: int = 0;
    while (at < ui_out_n) {
        end: int = at;
        while (end < ui_out_n && ui_out[end] != 10i8) end = end + 1;
        same: bool = end - at > len(word) && (ui_out[at + len(word)] == 32i8 || ui_out[at + len(word)] == 9i8);
        for k in 0..len(word)
            if (same && ui_out[at + k] != word[k] as i8) same = false;
        if (same) {
            for x in at..end write_byte(1, if (ui_out[x] == 9i8) 32i8 else ui_out[x]);
            write(1, "\n")
        }
        at = end + 1
    }
}

test "a document picked for the panel opens at the page's place, not the old document's" {
    // (The page at John 3; the panel had read a commentary on the Psalms
    // only, left at Psalm 150's run. A new document picked: the reader
    // begun anew; before it can show (a commentary opening its folio), the
    // skin tells the old reader's place, laid out before core's lines
    // reached it; then the new reader shows.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_at(PANE_PANEL, 627, 2, 0);
    pane_panel_shown();
    cc_lines("go");
    expect {|
        go 1 999 -1 0 0
    |}
}

test "once sent to its place, the panel takes the places the skin tells" {
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_panel_shown();
    pane_at(PANE_PANEL, 999, 3, 500);
    write_int(1, pane_places[PANE_PANEL].c);
    write(1, " ");
    write_int(1, pane_places[PANE_PANEL].i);
    write(1, " ");
    write_int(1, pane_places[PANE_PANEL].frac);
    expect {|999 3 500|}
}

test "an unlinked panel's new document opens at the panel's own place, a late place from the skin ignored" {
    // (The page at John 3; the panel unlinked at Romans 8:28 (chapter
    // 1053), its reader begun anew for another document; the skin tells
    // the old reader's place late; core sends the panel where it was
    // (anchors not known here: the chapter's top); the reader then shown
    // stays there.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_at(PANE_PANEL, 627, 2, 0);
    pane_go_verse(PANE_PANEL, 1053, 28, 0, PANE_GO_AT_ONCE);
    pane_panel_shown();
    cc_lines("go");
    expect {|
        go 1 1053 -1 0 0
    |}
}

// The panel's document changed as Go To does it while the panel is
// unlinked (sk_beside_read_in_place's steps, without its screens): the
// reader's place read, the reader begun anew, the old reader's place told
// late by the skin, the place read gone to, the new reader shown.
cc_pick_unlinked() {
    c: int = bb_reader_c;
    v: int = bb_reader_v;
    pane_panel_begun();
    pane_at(PANE_PANEL, c, 2, 400);
    pane_go_verse(PANE_PANEL, c, v, 0, PANE_GO_AT_ONCE);
    pane_panel_shown()
}

test "an unlinked panel moved by a hand: the next document opens where the hand left it" {
    // (The page at John 3; the panel unlinked, sent to Romans 8:28
    // (chapter 1053); Treasury of David picked (its run of chapters
    // shown there); a hand moves the panel to Psalm 23's top (chapter
    // 500); a Bible picked opens at Psalm 23, not Romans 8.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_panel_shown();
    sk_beside_go(1053, 28);
    cc_pick_unlinked();
    pane_moving(PANE_PANEL, 0);
    pane_at(PANE_PANEL, 500, -1, 0);
    cc_begin();
    cc_pick_unlinked();
    cc_lines("go");
    expect {|
        go 1 500 -1 0 0
    |}
}

test "a verse sent before its document can be read is kept: the skin's guessed places are not taken until a hand moves the pane" {
    // (The panel's document can't say its anchors here (none is read): a
    // commentary whose file is still opening, as the first Swap after a
    // launch finds it. Sent to Romans 8:28, the pane shows the chapter's
    // top meanwhile; the place the skin tells there is not taken (the
    // verse kept, gone to once the document is read); a hand's is.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_panel_shown();
    sk_beside_go(1053, 28);
    pane_at(PANE_PANEL, 1053, -1, 0);
    write_int(1, bb_reader_v);
    write(1, " ");
    pane_moving(PANE_PANEL, 0);
    pane_at(PANE_PANEL, 1053, -1, 0);
    write_int(1, bb_reader_v);
    expect {|28 0|}
}

test "a commentary on the page that can't be opened at a launch is given up: a toast, and the page reads the Bible at the place kept" {
    // (The page's place kept for a commentary (slot 4) whose file isn't
    // open, its verse Psalm 119:105 (chapter 596); the commentary not on
    // the Bookshelf any more: the page reads the Bible there, and a toast
    // says the commentary couldn't be opened.)
    cc_begin();
    set_pref("pageSlot", 5);
    sk_c = 596;
    sk_v = 105;
    pane_verse_kept_c[PANE_PAGE] = 596;
    pane_verse_kept_v[PANE_PAGE] = 105;
    pane_verse_kept_i[PANE_PAGE] = -2;
    pane_verse_kept_f[PANE_PAGE] = 0;
    pane_page_wait_check();
    cc_lines("go");
    cc_lines("toast");
    write_int(1, pref_get("pageSlot"));
    expect "go 0 596 -1 0 0\ntoast 4 exclamationmark.triangle Couldn’t open the commentary.\n0"
}

// ---- rows' menus (core/row_menus.l8) ----
// Each row of the screen just made, one to a line: its title, then its
// menu's words (a row's actions, in order) after a colon, then its
// swipe's (its delete action's) in brackets.
cc_menus() raises IoError {
    for i in 0..ui_rows_n {
        row: UiRow = ui_rows[i];
        if (row.actions_n == 0)
            continue;
        write_bytes_span(1, ui_pool, row.title.at, row.title.n);
        write(1, ":");
        for a in 0..row.actions_n {
            action: UiAction = ui_actions[row.actions + a];
            write(1, if (a == 0) " " else " | ");
            write_bytes_span(1, ui_pool, action.title.at, action.title.n);
            if (action.action == row.delete_action) write(1, " [swipe]")
        }
        write(1, "\n")
    }
}

// A History of three visits: John 3:16 and Romans 8 in the Bible, then
// Psalm 119 in a commentary (slot 4).
cc_history() {
    hs_n = 3;
    now: int = time(0);
    visits[0] = Visit {
        document: PlaceDocument.Bible,
        chapter: 999,
        verse: 16,
        frac: 0,
        exact: true,
        time: now - 30
    };
    visits[1] = Visit {
        document: PlaceDocument.Bible,
        chapter: 1053,
        verse: 0,
        frac: 0,
        exact: false,
        time: now - 20
    };
    visits[2] = Visit {
        document: PlaceDocument.Module { slot: 4 },
        chapter: 596,
        verse: 0,
        frac: 0,
        exact: false,
        time: now - 10
    }
}

// The panel open reading the BSB beside the page, linked or not.
cc_panel_open(linked: bool) {
    set_pref_on("besideOpen", true);
    set_pref_on("besideLinked", linked);
    sk_beside_push(SCR_BESIDE_BIBLE, TEXT_BSB * SHELF_PLACE)
}

// History's rows and a verse found (John 3:16 in the version read), their
// menus.
cc_history_and_hit_menus() raises IoError {
    sk_build_history(9001);
    cc_menus();
    ui_begin(9002, SCR_SEARCH, 0, "Search");
    ui_section("", "");
    sk_hit_marked(999, 16, ACT_HIT, text_cur);
    cc_menus()
}

test "a row's menu offers what its tap can't: Open in Panel only while the panel shows a reader, unlinked" {
    // (History: John 3:16, Romans 8, and Psalm 119 read in a commentary;
    // Search's verse found, John 3:16. The panel closed; open and linked
    // (the tap moves both panes: the item would repeat it); open and
    // unlinked: History's Bible places and the verse found offer the
    // panel, the commentary's place not (the panel's Bible can't show a
    // commentary's place).)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    cc_history();
    cc_history_and_hit_menus();
    write(1, "-- the panel open, linked\n");
    cc_panel_open(true);
    cc_history_and_hit_menus();
    write(1, "-- unlinked\n");
    set_pref_on("besideLinked", false);
    cc_history_and_hit_menus();
    expect {|
        Psalm 119: Share | Delete [swipe]
        Romans 8: Share | Delete [swipe]
        John 3:16: Share | Delete [swipe]
        John 3:16: Copy | Share
        -- the panel open, linked
        Psalm 119: Share | Delete [swipe]
        Romans 8: Share | Delete [swipe]
        John 3:16: Share | Delete [swipe]
        John 3:16: Copy | Share
        -- unlinked
        Psalm 119: Share | Delete [swipe]
        Romans 8: Open in Panel | Share | Delete [swipe]
        John 3:16: Open in Panel | Share | Delete [swipe]
        John 3:16: Open in Panel | Copy | Share
    |}
}

test "Go To's rows offer the panel only while Go To is aimed at the page, places only while unlinked, never the document the panel reads" {
    // (The panel open reading the BSB; History gives Recent John 3:16,
    // Romans 8 and Psalm 119 (the page at Psalm 1, chapter 478); a ribbon
    // at Genesis 1. Go To from the page's title, linked, then unlinked;
    // then from the panel's name.)
    cc_begin();
    sk_c = 478;
    sk_v = 0;
    cc_history();
    sk_has_ribbons = true;
    rb_n = 1;
    rb_id[0] = 7;
    rb_c[0] = 0;
    rb_v[0] = 1;
    rb_document[0] = PlaceDocument.Bible;
    for k in 0..len("Morning") rb_name[k] = "Morning"[k] as i8;
    rb_name_n[0] = len("Morning");
    cc_panel_open(true);
    sk_open(SCR_GOTO, GOTO_PAGE, false);
    cc_menus();
    write(1, "-- unlinked\n");
    set_pref_on("besideLinked", false);
    sk_open(SCR_GOTO, GOTO_PAGE, false);
    cc_menus();
    write(1, "-- aimed at the panel\n");
    sk_open(SCR_GOTO, GOTO_PANEL, false);
    cc_menus();
    expect {|
        Morning: Ribbon Details | Delete [swipe]
        Psalm 119: Remove [swipe]
        Romans 8: Remove [swipe]
        John 3:16: Remove [swipe]
        Berean Standard Bible: About
        King James Version: Read in Panel | About
        World English Bible: Read in Panel | About
        American Standard Version: Read in Panel | About
        Young's Literal Translation: Read in Panel | About
        -- unlinked
        Morning: Open in Panel | Ribbon Details | Delete [swipe]
        Psalm 119: Open in Panel | Remove [swipe]
        Romans 8: Open in Panel | Remove [swipe]
        John 3:16: Open in Panel | Remove [swipe]
        Berean Standard Bible: About
        King James Version: Read in Panel | About
        World English Bible: Read in Panel | About
        American Standard Version: Read in Panel | About
        Young's Literal Translation: Read in Panel | About
        -- aimed at the panel
        Morning: Ribbon Details | Delete [swipe]
        Psalm 119: Remove [swipe]
        Romans 8: Remove [swipe]
        John 3:16: Remove [swipe]
        Berean Standard Bible: About
        King James Version: About
        World English Bible: About
        American Standard Version: About
        Young's Literal Translation: About
    |}
}

test "Open in Panel is the tap as Go To aimed at the panel does it: unlinked, the panel alone goes; linked, it isn't there and does nothing" {
    // (The page at Psalm 1 (chapter 478), the panel reading the BSB; Go To
    // from the page's title; Romans 8 (chapter 1053) of Recent opened in
    // the panel: unlinked, only the panel is sent there; linked (offered
    // no more), nothing is sent and the page stays.)
    cc_begin();
    sk_c = 478;
    sk_v = 0;
    cc_history();
    cc_panel_open(false);
    pane_panel_begun();
    pane_panel_shown();
    sk_open(SCR_GOTO, GOTO_PAGE, false);
    goto_id: int = sk_ids[sk_top()];
    ui_out_n = 0;
    sk_act(goto_id, ACT_IN_PANEL + ACT_PLACE, 1053 * 1000, 0);
    cc_lines("go");
    write_int(1, sk_c);
    write(1, """

-- linked
""");
    set_pref_on("besideLinked", true);
    sk_open(SCR_GOTO, GOTO_PAGE, false);
    goto_id = sk_ids[sk_top()];
    ui_out_n = 0;
    sk_act(goto_id, ACT_IN_PANEL + ACT_PLACE, 1053 * 1000, 0);
    cc_lines("go");
    write_int(1, sk_c);
    expect "go 1 1053 -1 0 0\n478\n-- linked\n478"
}

test "Read in Panel on a version: the panel reads it, the page's version stays" {
    // (The panel reading the BSB, linked; Go To from the page's title; the
    // KJV (text 1) read in the panel.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    cc_panel_open(true);
    sk_open(SCR_GOTO, GOTO_PAGE, false);
    goto_id: int = sk_ids[sk_top()];
    page_version: int = text_cur;
    sk_act(goto_id, ACT_IN_PANEL + ACT_VERSION, 1, 0);
    write(1, if (sk_beside_reads_version(1)) "panel reads the KJV" else "panel doesn't read the KJV");
    write(1, if (text_cur == page_version) ", the page's version kept" else ", the page's version CHANGED");
    expect {|panel reads the KJV, the page's version kept|}
}

test "Remove on a recent place takes every visit to its chapter from History, the others kept in order, and its row from Recent" {
    // (History: John 3:16, Romans 8, Psalm 119 and John 3 again; Go To's
    // Recent from it (the page at Psalm 1); John 3 removed.)
    cc_begin();
    sk_c = 478;
    sk_v = 0;
    cc_history();
    visits[3] = visits[0];
    visits[3].verse = 0;
    visits[3].exact = false;
    visits[3].time = time(0) - 5;
    hs_n = 4;
    sk_open(SCR_GOTO, GOTO_PAGE, false);
    goto_id: int = sk_ids[sk_top()];
    sk_act(goto_id, ACT_RECENT_REMOVE, 999 * 1000, 0);
    write(1, "History:");
    for i in 0..hs_n {
        write(1, " ");
        write_int(1, visits[i].chapter)
    }
    write(1, """

Recent:""");
    for j in 0..sk_recent_n {
        write(1, " ");
        write_int(1, sk_recent_c[j])
    }
    expect "History: 1053 596\nRecent: 596 1053"
}

// Text t made of one verse, the verse numbered verse of chapter c, its
// words words (a version's records as text_index reads them: a C line a
// chapter, V and T lines for the verse); text_empty lets it go.
cc_text(
    t: int,
    c: int,
    verse: str,
    words: str
) {
    n: int = 2 * (c + 1) + 1 + len(verse) + 1 + 1 + len(words) + 1;
    next: owned *TextData = own {
        text: *TextData = text_made(t, n);
        at: int = 0;
        for _k in 0..c + 1 {
            text.data[at] = 67i8;
            text.data[at + 1] = 10i8;
            at = at + 2
        }
        text.data[at] = 86i8;
        at = at + 1;
        for x in 0..len(verse) {
            text.data[at] = verse[x] as i8;
            at = at + 1
        }
        text.data[at] = 10i8;
        text.data[at + 1] = 84i8;
        at = at + 2;
        for x in 0..len(words) {
            text.data[at] = words[x] as i8;
            at = at + 1
        }
        text.data[at] = 10i8;
        text_index(text);
        text
    };
    text_replace(t, move next)
}

test "Copy on a verse found in another version quotes that version's words, never the one read" {
    // (The BSB read, the KJV (text 1) and the BSB each with John 3:16; a
    // KJV hit copied gives the KJV's words and name; with the KJV not
    // read, nothing: never the BSB's words under another name.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    cc_text(TEXT_BSB, 999, "16", "For God so loved the world.");
    cc_text(1, 999, "16", "For God so loued the world.");
    sk_open(SCR_SEARCH, 0, false);
    search_id: int = sk_ids[sk_top()];
    ui_out_n = 0;
    sk_act(search_id, ACT_HIT_COPY_IN + 1, 999 * 1000 + 16, 0);
    cc_lines("copy");
    write(1, "-- the KJV not read\n");
    text_replace(1, text_empty(1));
    ui_out_n = 0;
    sk_act(search_id, ACT_HIT_COPY_IN + 1, 999 * 1000 + 16, 0);
    cc_lines("copy");
    text_replace(TEXT_BSB, text_empty(TEXT_BSB));
    expect {|
        copy “For God so loued the world.”\nJohn 3:16 KJV
        -- the KJV not read
    |}
}
