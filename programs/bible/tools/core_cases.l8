tag bible_core_cases;

use_tag std, bible;

need "libc.so.6";

// Core's rules for the panes checked without a skin or a phone: core's
// functions called as its lines would call them, and what it writes to
// the skin read back from its output buffer. Run by `make
// bible-follow-test` (link_cases.l8 imports this file).
import "../../../stdlib/print.l8";

import "../core/skin.l8";

// Core's output since cc_begin, lines that begin with word, written one
// to a line (the protocol's tabs as spaces).
cc_begin() {
    ui_out_n = 0;
    chapters = 1189
}

cc_lines(word: str) raises IoError {
    at: int = 0;
    while (at < ui_out_n) {
        end: int = at;
        while (end < ui_out_n && ui_out[end] != 10i8) end = end + 1;
        same: bool = end - at > len(word) && ui_out[at + len(word)] == 32i8;
        for k in 0..len(word)
            if (same && ui_out[at + k] != word[k] as i8) same = false;
        if (same) {
            for x in at..end write_byte(1, if (ui_out[x] == 9i8) 32i8 else ui_out[x]);
            write(1, "\n")
        }
        at = end + 1
    }
}

test "a document picked for the panel opens at the page's place, not the old document's" {
    // (The page at John 3; the panel had read a commentary on the Psalms
    // only, left at Psalm 150's run. A new document picked: the reader
    // begun anew; before it can show (a commentary opening its folio), the
    // skin tells the old reader's place, laid out before core's lines
    // reached it; then the new reader shows.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_at(PANE_PANEL, 627, 2, 0);
    pane_panel_shown();
    cc_lines("go");
    expect {|
        go 1 999 -1 0 0
    |}
}

test "once sent to its place, the panel takes the places the skin tells" {
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_panel_shown();
    pane_at(PANE_PANEL, 999, 3, 500);
    write_int(1, pane_places[PANE_PANEL].c);
    write(1, " ");
    write_int(1, pane_places[PANE_PANEL].i);
    write(1, " ");
    write_int(1, pane_places[PANE_PANEL].frac);
    expect {|999 3 500|}
}

test "an unlinked panel's new document opens at the panel's own place, a late place from the skin ignored" {
    // (The page at John 3; the panel unlinked at Romans 8:28 (chapter
    // 1053), its reader begun anew for another document; the skin tells
    // the old reader's place late; core sends the panel where it was
    // (anchors not known here: the chapter's top); the reader then shown
    // stays there.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_at(PANE_PANEL, 627, 2, 0);
    pane_go_verse(PANE_PANEL, 1053, 28, 0, PANE_GO_AT_ONCE);
    pane_panel_shown();
    cc_lines("go");
    expect {|
        go 1 1053 -1 0 0
    |}
}

// The panel's document changed as Go To does it while the panel is
// unlinked (sk_beside_read_in_place's steps, without its screens): the
// reader's place read, the reader begun anew, the old reader's place told
// late by the skin, the place read gone to, the new reader shown.
cc_pick_unlinked() {
    c: int = bb_reader_c;
    v: int = bb_reader_v;
    pane_panel_begun();
    pane_at(PANE_PANEL, c, 2, 400);
    pane_go_verse(PANE_PANEL, c, v, 0, PANE_GO_AT_ONCE);
    pane_panel_shown()
}

test "an unlinked panel moved by a hand: the next document opens where the hand left it" {
    // (The page at John 3; the panel unlinked, sent to Romans 8:28
    // (chapter 1053); Treasury of David picked (its run of chapters
    // shown there); a hand moves the panel to Psalm 23's top (chapter
    // 500); a Bible picked opens at Psalm 23, not Romans 8.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_panel_shown();
    sk_beside_go(1053, 28);
    cc_pick_unlinked();
    pane_moving(PANE_PANEL, 0);
    pane_at(PANE_PANEL, 500, -1, 0);
    cc_begin();
    cc_pick_unlinked();
    cc_lines("go");
    expect {|
        go 1 500 -1 0 0
    |}
}

test "a verse sent before its document can be read is kept: the skin's guessed places are not taken until a hand moves the pane" {
    // (The panel's document can't say its anchors here (none is read): a
    // commentary whose file is still opening, as the first Swap after a
    // launch finds it. Sent to Romans 8:28, the pane shows the chapter's
    // top meanwhile; the place the skin tells there is not taken (the
    // verse kept, gone to once the document is read); a hand's is.)
    cc_begin();
    sk_c = 999;
    sk_v = 0;
    pane_panel_begun();
    pane_panel_shown();
    sk_beside_go(1053, 28);
    pane_at(PANE_PANEL, 1053, -1, 0);
    write_int(1, bb_reader_v);
    write(1, " ");
    pane_moving(PANE_PANEL, 0);
    pane_at(PANE_PANEL, 1053, -1, 0);
    write_int(1, bb_reader_v);
    expect {|28 0|}
}

test "a commentary on the page that can't be opened at a launch is given up: a toast, and the page reads the Bible at the place kept" {
    // (The page's place kept for a commentary (slot 4) whose file isn't
    // open, its verse Psalm 119:105 (chapter 596); the commentary not on
    // the Bookshelf any more: the page reads the Bible there, and a toast
    // says the commentary couldn't be opened.)
    cc_begin();
    set_pref("pageSlot", 5);
    sk_c = 596;
    sk_v = 105;
    pane_verse_kept_c[PANE_PAGE] = 596;
    pane_verse_kept_v[PANE_PAGE] = 105;
    pane_verse_kept_i[PANE_PAGE] = -2;
    pane_verse_kept_f[PANE_PAGE] = 0;
    pane_page_wait_check();
    cc_lines("go");
    cc_lines("toast");
    write_int(1, pref_get("pageSlot"));
    expect "go 0 596 -1 0 0\ntoast 4 exclamationmark.triangle Couldn’t open the commentary.\n0"
}
