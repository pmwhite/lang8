tag bible_sizes;

use_tag std, bible;

// The sizes table for the web's first paint (WEB.md §W1.8): `sizes PATH`
// prints a line for each chapter of the text at PATH (data/bsb.txt and the
// others): for each kind of block the chapter has (estimate.l8's kinds, the
// paragraph kinds then the headings; 15 the stanza breaks), "kind blocks
// characters", joined by commas. The web estimates every chapter's height
// from it until the whole text has come (estimate.l8's est_from_sizes).
import "../../../stdlib/print.l8";

import "../core/text.l8";

import "../web/estimate.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

load_text(path: str) noregion: bool {
    fd: int = open(path, 0, 0);
    if (fd < 0) return false;
    n: int = 8388608;
    buf: []i8 = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, buf, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    bsb = buf;
    text_load(0, buf, got);
    true
}

main(argc: int, argv: []str) noregion raises IoError: int {
    if (argc < 2 || !load_text(argv[1])) {
        print("usage: sizes PATH");
        return 2
    }
    for c in 0..chapters {
        count_chapter(c, false);
        first: bool = true;
        for k in 0..16 {
            if (ag_n[k] > 0) {
                if (!first) write(1, ",");
                first = false;
                write_int(1, k);
                write(1, " ");
                write_int(1, ag_n[k]);
                write(1, " ");
                write_int(1, ag_ch[k] as int)
            }
        }
        print("")
    }
    0
}
