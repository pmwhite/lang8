tag bible_text_skin;

use_tag std, bible;

need "libc.so.6";

// The smallest skin (SKINS.md): the wire on a terminal. It reads the
// skin's lines on its input (start 400 800 100, tap goto, act 1 1 42 0,
// want 1000, ...) and writes what the app answers, as they are, on its
// output; settings are kept in the file given. For developing core's
// screens and checking them without a phone:
//
//   printf 'start 400 800 100\ntap goto\n' | .build/skin-text DATA PREFS
import "../../../stdlib/print.l8";

import "../core/skin.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

got_n: int = 0;

read_file(path: []i8, n: int): []i8@new {
    buf: []i8 = new i8[16777216](0i8);
    got_n = 0;
    fd: int = open_bytes(path, n);
    if (fd < 0) return buf;
    more: bool = true;
    while (more) {
        k: int = read(fd, buf, got_n, len(buf) - got_n);
        if (k <= 0) more = false else got_n = got_n + k
    }
    close(fd);
    buf
}

path_buf: []i8 = new i8[4096](0i8);

extern open_raw(path: *i8, flags: int, mode: int): int = open;

open_bytes(path: []i8, n: int): int {
    for i in 0..n path_buf[i] = path[i];
    path_buf[n] = 0i8;
    open_raw(&path_buf[0], 0, 0)
}

data_dir: str = "";

prefs_path: str = "";

version_files: []str = ["bsb.txt", "kjv.txt", "web.txt", "asv.txt", "ylt.txt"];

joined: []i8 = new i8[4096](0i8);

joined_n: int = 0;

join(dir: str, file: str) {
    joined_n = 0;
    for c in dir {
        joined[joined_n] = c;
        joined_n = joined_n + 1
    }
    joined[joined_n] = 47i8;
    joined_n = joined_n + 1;
    for c in file {
        joined[joined_n] = c;
        joined_n = joined_n + 1
    }
}

text_load_from(t: int) noregion: bool {
    if (t < 0 || t >= len(version_files)) return false;
    join(data_dir, version_files[t]);
    buf: []i8 = read_file(joined, joined_n);
    if (got_n == 0) return false;
    text_load(t, buf, got_n);
    true
}

text_skin_save() {
    prefs_format();
    for i in 0..len(prefs_path) path_buf[i] = prefs_path[i];
    path_buf[len(prefs_path)] = 0i8;
    // (O_WRONLY | O_CREAT | O_TRUNC)
    fd: int = open_raw(&path_buf[0], 577, 420);
    if (fd < 0) return;
    try {
        write_bytes_n(fd, fbuf, fbuf_n)
    } with IoError _e -> { }
    close(fd)
}

flush_out() raises IoError {
    if (ui_out_n > 0) write_bytes_n(1, ui_out, ui_out_n);
    ui_out_n = 0
}

input: []i8 = new i8[1048576](0i8);

main(argc: int, argv: []str@immortal) noregion raises IoError: int {
    if (argc < 3) {
        write(2, "usage: skin-text DATA-DIR PREFS-FILE\n");
        return 2
    }
    data_dir = argv[1];
    prefs_path = argv[2];
    if (!text_load_from(0)) {
        write(2, "skin-text: no bsb.txt in the data directory\n");
        return 1
    }
    text_use(0);
    for i in 0..len(prefs_path) joined[i] = prefs_path[i];
    pbuf: []i8 = read_file(joined, len(prefs_path));
    for i in 0..got_n fbuf[i] = pbuf[i];
    fbuf_n = got_n;
    prefs_parse();
    sk_host = SkinHost { save_prefs: &text_skin_save, save_kept: &sk_no_save_kept, switch_version: null };
    // (Lines as they come: those read so far, each whole one passed on.)
    n: int = 0;
    more: bool = true;
    while (more) {
        k: int = read(0, input, n, len(input) - n);
        if (k <= 0) more = false else n = n + k;
        last: int = -1;
        for i in 0..n
            if (input[i] as int == 10) last = i;
        if (last >= 0) {
            // (visit C V TIME: a place in history, made up for a test.)
            p: int = 0;
            for i in 0..last + 1 {
                if (input[i] as int == 10) {
                    if (sk_word_is(input, p, i, "visit")) {
                        c: int = sk_num(input, p + 5, i);
                        v: int = sk_num(input, sk_num_end, i);
                        t: int = sk_num(input, sk_num_end, i);
                        history_add(c, v, 0, v > 0, t)
                    } else sk_line(input, p, i);
                    p = i + 1
                }
            }
            t: int = sk_want_text;
            if (t >= 0) {
                sk_want_text = -1;
                if (text_load_from(t)) sk_use_version(t)
            }
            flush_out();
            rest: int = n - last - 1;
            for i in 0..rest input[i] = input[last + 1 + i];
            n = rest
        }
    }
    0
}
