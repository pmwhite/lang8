tag bible_text_skin;

use_tag std, bible;

need "libc.so.6";

// The smallest skin (SKINS.md): the wire on a terminal. It reads the
// skin's lines on its input (start 400 800 100, tap goto, act 1 1 42 0,
// want 1000, ...) and writes what the app answers, as they are, on its
// output; settings are kept in the file given. For developing core's
// screens and checking them without a phone:
//
//   printf 'start 400 800 100\ntap goto\n' | .build/skin-text DATA PREFS
//
// Lines of its own make up what a test needs: visit C V TIME (a place in
// history), plans, plan P D and follow P DAY (Reading Plans; a plan's
// days at day D; a plan followed from day DAY), open KIND ARG (any of
// core's screens, presented), compare C V N, study C V K, esv C V WORDS
// (a result of the ESV's own search), memorize C V1 V2 (a passage in
// Memory).
import "../../../stdlib/print.l8";

import "../core/skin.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

got_n: int = 0;

read_file(path: []i8, n: int): []i8@new {
    buf: []i8 = new i8[16777216](0i8);
    got_n = 0;
    fd: int = open_bytes(path, n);
    if (fd < 0) return buf;
    more: bool = true;
    while (more) {
        k: int = read(fd, buf, got_n, len(buf) - got_n);
        if (k <= 0) more = false else got_n = got_n + k
    }
    close(fd);
    buf
}

path_buf: []i8 = new i8[4096](0i8);

extern lseek(fd: int, offset: int, whence: int): int;

// A file whole, in a buffer its size (got_n its length).
read_sized(path: []i8, n: int): []i8@new {
    fd: int = open_bytes(path, n);
    size: int = if (fd < 0) 0 else lseek(fd, 0, 2);
    if (fd >= 0) _r: int = lseek(fd, 0, 0);
    buf: []i8 = new i8[size + 1](0i8);
    got_n = 0;
    if (fd < 0) return buf;
    more: bool = true;
    while (more && got_n < size) {
        k: int = read(fd, buf, got_n, size - got_n);
        if (k <= 0) more = false else got_n = got_n + k
    }
    close(fd);
    buf
}

// The language data (the Hebrew and Greek, the lexicons, the cross
// references, the commentary) read whole, as the iPhone maps it.
lang_dir_load(name: str): []i8@new {
    join(data_dir, name);
    read_sized(joined, joined_n)
}

// Language file k's size (hs_lang_files, the host's order; -1: it isn't
// there).
lang_file_size(k: int): int {
    join(data_dir, hs_lang_files[k]);
    fd: int = open_bytes(joined, joined_n);
    if (fd < 0) return -1;
    size: int = lseek(fd, 0, 2);
    close(fd);
    size
}

// Language file k read into out (its size long), as core's host reads a
// file into the language data's arena.
lang_file_read(k: int, out: []i8) {
    join(data_dir, hs_lang_files[k]);
    fd: int = open_bytes(joined, joined_n);
    if (fd < 0) return;
    n: int = 0;
    more: bool = true;
    while (more && n < len(out) - 1) {
        got: int = read(fd, out, n, len(out) - 1 - n);
        if (got <= 0) more = false else n = n + got
    }
    close(fd)
}

text_lang_load() {
    for k in 0..len(hs_lang_files) language_file_read(k, k, lang_file_size(k), &lang_file_read);
    // (And the Manual.)
    manual_came(lang_dir_load("help.txt"), got_n)
}

// (The host's numbers: the language data, read at the start.)
text_num(what: int, _a: int): int {
    if (what == SK_NUM_LANG || what == SK_NUM_LEARN) return if (language_ready()) 1 else 0;
    // (Reminders at 7:00, none turned off, Memory's off.)
    if (what == SK_NUM_REMIND) return if (_a == 0) 420 else 0;
    -1
}

extern open_raw(path: *i8, flags: int, mode: int): int = open;

open_bytes(path: []i8, n: int): int {
    for i in 0..n path_buf[i] = path[i];
    path_buf[n] = 0i8;
    open_raw(&path_buf[0], 0, 0)
}

data_dir: str = "";

prefs_path: str = "";

version_files: []str = ["bsb.txt", "kjv.txt", "web.txt", "asv.txt", "ylt.txt"];

joined: []i8 = new i8[4096](0i8);

joined_n: int = 0;

join(dir: str, file: str) {
    joined_n = 0;
    for c in dir {
        joined[joined_n] = c;
        joined_n = joined_n + 1
    }
    joined[joined_n] = 47i8;
    joined_n = joined_n + 1;
    for c in file {
        joined[joined_n] = c;
        joined_n = joined_n + 1
    }
}

// Version t read from the data directory into a text of its own: whether
// it was there.
text_load_from(t: int): bool {
    if (t < 0 || t >= len(version_files)) return false;
    join(data_dir, version_files[t]);
    fd: int = open_bytes(joined, joined_n);
    if (fd < 0) return false;
    size: int = lseek(fd, 0, 2);
    close(fd);
    if (size <= 0) return false;
    text_read(t, t, size, &version_file_read);
    true
}

// Version t's file read into out (its size long, and a zero after).
version_file_read(t: int, out: []i8) {
    join(data_dir, version_files[t]);
    fd: int = open_bytes(joined, joined_n);
    if (fd < 0) return;
    n: int = 0;
    more: bool = true;
    while (more && n < len(out) - 1) {
        got: int = read(fd, out, n, len(out) - 1 - n);
        if (got <= 0) more = false else n = n + got
    }
    close(fd)
}

text_skin_save() {
    prefs_format();
    for i in 0..len(prefs_path) path_buf[i] = prefs_path[i];
    path_buf[len(prefs_path)] = 0i8;
    // (O_WRONLY | O_CREAT | O_TRUNC)
    fd: int = open_raw(&path_buf[0], 577, 420);
    if (fd < 0) return;
    try {
        write_bytes_n(fd, fbuf, fbuf_n)
    } with IoError _e -> { }
    close(fd)
}

flush_out() raises IoError {
    if (ui_out_n > 0) write_bytes_n(1, ui_out, ui_out_n);
    ui_out_n = 0
}

input: []i8 = new i8[1048576](0i8);

test_vs: []int = new int[64](0);

extern text_skin_exit(code: int): noreturn = exit;

text_stream(data: []i8, start: int, count: int) {
    try {
        write_bytes_span(1, data, start, count)
    } with IoError _error -> {
        raw::raw_write(2, "skin-text: failed to write protocol output\n");
        text_skin_exit(1)
    }
}

main(argc: int, argv: []str@immortal) raises IoError: int {
    ui_sender = &text_stream;
    if (argc < 3) {
        write(2, "usage: skin-text DATA-DIR PREFS-FILE\n");
        return 2
    }
    data_dir = argv[1];
    prefs_path = argv[2];
    if (!text_load_from(0)) {
        write(2, "skin-text: no bsb.txt in the data directory\n");
        return 1
    }
    text_use(0);
    text_lang_load();
    for i in 0..len(prefs_path) joined[i] = prefs_path[i];
    pbuf: []i8 = read_file(joined, len(prefs_path));
    for i in 0..got_n fbuf[i] = pbuf[i];
    fbuf_n = got_n;
    prefs_parse();
    sk_host = SkinHost {
        save_prefs: &text_skin_save,
        save_kept: &sk_no_save_kept,
        words: &sk_no_words,
        switch_version: null,
        num: &text_num,
        fill: &sk_no_fill,
        fetch: null
    };
    // (Go To's ribbons and plans, though none are kept past the run.)
    sk_has_ribbons = true;
    // (Listen: the device's voice, core's session.)
    sk_has_listen = true;
    sk_has_reminders = true;
    // (Lines as they come: those read so far, each whole one passed on.)
    n: int = 0;
    more: bool = true;
    while (more) {
        k: int = read(0, input, n, len(input) - n);
        if (k <= 0) more = false else n = n + k;
        last: int = -1;
        for i in 0..n
            if (input[i] as int == 10) last = i;
        if (last >= 0) {
            // (visit C V TIME: a place in history, made up for a test.)
            p: int = 0;
            for i in 0..last + 1 {
                if (input[i] as int == 10) {
                    if (sk_word_is(input, p, i, "visit")) {
                        c: int = sk_num(input, p + 5, i);
                        v: int = sk_num(input, sk_num_end, i);
                        t: int = sk_num(input, sk_num_end, i);
                        history_add(c, v, 0, v > 0, t)
                    } else if (sk_word_is(input, p, i, "plans")) {
                        // (plans: Reading Plans; plan P D: plan P's days at
                        // day D; follow P DAY: plan P followed from day DAY.)
                        plans_make();
                        sk_open(SCR_PLANS, 0, false)
                    } else if (sk_word_is(input, p, i, "plan")) {
                        plans_make();
                        pp: int = sk_num(input, p + 4, i);
                        sk_open_plan(pp, sk_num(input, sk_num_end, i), false, false)
                    } else if (sk_word_is(input, p, i, "open")) {
                        plans_make();
                        kk: int = sk_num(input, p + 4, i);
                        sk_open(kk, sk_num(input, sk_num_end, i), false)
                    } else if (sk_word_is(input, p, i, "compare")) {
                        // (compare C V N: Compare on N verses from C:V.)
                        cc: int = sk_num(input, p + 7, i);
                        vv: int = sk_num(input, sk_num_end, i);
                        nn: int = sk_num(input, sk_num_end, i);
                        for x in 0..nn
                            if (x < len(test_vs)) test_vs[x] = vv + x;
                        sk_open_compare(cc, test_vs, nn)
                    } else if (sk_word_is(input, p, i, "study")) {
                        // (study C V K: the study of verse C:V's word K.)
                        borrow language_data {
                            vi: int = lang_verse(language_data, sk_num(input, p + 5,
                                i), sk_num(input, sk_num_end, i));
                            if (vi >= 0) {
                                w: int = v_first(language_data, vi) + sk_num(input,
                                    sk_num_end, i);
                                sk_study_open(vi, w, w_greek(language_data, w), w_strongs(language_data,
                                    w), false, false)
                            }
                        }
                    } else if (sk_word_is(input, p, i, "esv")) {
                        // (esv C V WORDS: a result of the ESV's own search,
                        // as its server would give it, for Search open.)
                        cc: int = sk_num(input, p + 3, i);
                        vv: int = sk_num(input, sk_num_end, i);
                        at: int = if (sk_num_end < i) sk_num_end + 1 else i;
                        if (!sk_esv_results) sk_esr_begin(0, 1, 1);
                        sk_esr_total = sk_esr_total + 1;
                        for x in at..i fbuf[x - at] = input[x];
                        sk_esr_add(cc, vv, fbuf, i - at);
                        sk_esv_results = true;
                        sk_update_all()
                    } else if (sk_word_is(input, p, i, "memorize")) {
                        // (memorize C V1 V2: verses C:V1 to V2 added to
                        // Memory, in the BSB.)
                        cc: int = sk_num(input, p + 8, i);
                        v1: int = sk_num(input, sk_num_end, i);
                        _m: int = memory_add(0, cc, v1, cc, sk_num(input, sk_num_end,
                            i), time(0))
                    } else if (sk_word_is(input, p, i, "follow")) {
                        plans_make();
                        pp: int = sk_num(input, p + 6, i);
                        _f: int = plan_begin(pp, sk_num(input, sk_num_end, i), 1)
                    } else sk_line(input, p, i);
                    p = i + 1
                }
            }
            t: int = sk_want_text;
            if (t >= 0) {
                sk_want_text = -1;
                if (text_load_from(t)) sk_use_version(t)
            }
            flush_out();
            rest: int = n - last - 1;
            for i in 0..rest input[i] = input[last + 1 + i];
            n = rest
        }
    }
    0
}
