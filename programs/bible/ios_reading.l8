tag bible_ios;

use_tag std, ios, bible;

// What you are reading (DESIGN.md Â§11): readings.l8's places kept
// (readings.tsv, read.tsv; seeded once from history), moved by the reader's
// rests and the chapters it reads (ios_daily.l8's signal, with a plan or
// without), and never by a jump; a reading's row (in Go To's Continue
// Reading, ios_daily.l8, and in Reading, pushed by Show All), its tap (the
// kept place, exactly, no flash) and its swipe (Remove); Start Reading, one
// screen for both kinds (pushed in Go To, or a sheet from the reader's
// title), with its book and chapter chosen in Go To's own lists; the
// title's long-press menu, Start Reading Here; and the start's toast.
import "../ios/objc.l8";

import "text.l8";

import "readings.l8";

// ---- kept ----
// At launch (after history): the readings, or (the first launch with
// them) seeded from history once; and the chapters read.
load_readings() {
    read_file("readings.tsv");
    had: bool = fbuf_n > 0;
    parse_readings();
    if (!def_bool("readingsSeeded")) {
        if (!had) {
            seed_readings(time(0));
            save_readings();
            note_num("bible: readings seeded ", rg_n)
        }
        set_def_bool("readingsSeeded", true)
    }
    readings_log();
    read_file("read.tsv");
    parse_read_log();
    note_num("bible: readings ", rg_n)
}

save_readings() {
    format_readings();
    write_file("readings.tsv")
}

save_read_log() {
    format_read_log();
    write_file("read.tsv")
}

// What readings.l8 says happened, into the log ("bible: reading started at
// ROM 2").
readings_log() {
    for i in 0..rev_n {
        if (diag_on) {
            fbuf_n = 0;
            fput_str("bible: ");
            fput_event(i);
            note_ns(fstring())
        }
    }
    rev_n = 0
}

// The readings changed: kept, logged, and the title's menu made again.
readings_changed() {
    save_readings();
    readings_log();
    title_menus_refresh()
}

// Chapter c read (Â§10.1.2's signal): onto read.tsv, the readings moved or
// one started (Â§11.1.2, Â§11.1.3), and the plan's, if one is followed.
chapter_read_now(c: int) {
    if (c < 0 || c >= chapters) return;
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: chapter read ");
        fput_code_place(c, 0);
        note_ns(fstring())
    }
    if (pl_active >= 0) daily_ready();
    changed: bool = chapter_read(c, time(0), today());
    save_read_log();
    if (changed) readings_changed() else readings_log();
    if (pl_active >= 0) plan_mark_read(c)
}

// ---- rests (Â§11.1.1) ----
// Whether the finger (or Listen's following; not the status bar's tap) has
// moved the text since the last jump: only then is a rest a scroll's rest.
rd_scrolled: bool = false;

// A jump's arrival (or the capsule's, or a reading's own row): nothing it
// leaves moves a reading.
reading_jumped() {
    rd_scrolled = false;
    rd_dwell_timer = stop_timer(rd_dwell_timer)
}

reading_scrolled() {
    rd_scrolled = true;
    rd_dwell_timer = stop_timer(rd_dwell_timer)
}

// The reader at rest (place_v and place_frac measured): a reading in this
// chapter takes the place (rule 1); one in the chapter before moves here
// once the rest has lasted 20 s (rule 2).
reading_rested() {
    if (!rd_scrolled || !restored || cur < 0) return;
    if (reading_rest(cur, place_v, place_frac, false, time(0))) readings_changed();
    rd_dwell_timer = stop_timer(rd_dwell_timer);
    if (cur > 0 && rg_find(cur) < 0 && rg_find(cur - 1) >= 0) {
        rd_dwell_c = cur;
        rd_dwell_timer = after(if (demo_on && demo_fast_dwell) 1.0f64 else 20.0f64,
            "readingDwelt:")
    }
}

// A rest of the reader's that is not a scroll's end: the app going away, or
// a sheet coming up over it.
reading_rest_now() {
    if (!rd_scrolled || !restored || table == 0) return;
    measure_place();
    reading_rested()
}

rd_dwell_c: int = -1;

rd_dwell_timer: int = 0;

reading_dwelt(_self: int, _cmd: int, _timer: int): int {
    rd_dwell_timer = 0;
    if (!rd_scrolled || presented() != 0 || cur != rd_dwell_c) return 0;
    measure_place();
    if (cur == rd_dwell_c && reading_rest(cur, place_v, place_frac, true, time(0))) readings_changed();
    0
}

// ---- a reading's row (Â§11.2.1) ----
rd_key: []int = new int[1](0);

reading_row_cell(t: int, i: int): int {
    cell: int = list_cell(t, "cr-reading", 2);
    if (i < 0 || i >= rg_n) return cell;
    config: int = list_config(2);
    config_image(config, "book", 17.0f64, c_faint);
    fbuf_n = 0;
    fput_reading_place(i);
    msg1(config, sel("setText:"), fstring());
    now: int = time(0);
    off: int = local_offset();
    fbuf_n = 0;
    fput_reading_line(i, now, off);
    msg1(config, sel("setSecondaryText:"), fstring());
    row_text_style(config);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setIsAccessibilityElement:"), 1);
    fbuf_n = 0;
    fput_reading_label(i, now, off);
    msg1(cell, sel("setAccessibilityLabel:"), fstring());
    msg1(cell, sel("setAccessibilityHint:"), nsstring("Opens where you left off."));
    a: int = custom_action("Remove", "readingRemoveAction:");
    objc_setAssociatedObject(a, ints_address(rd_key), nsnumber_int(rg_c[i]), 1);
    one[0] = a;
    msg1(cell, sel("setAccessibilityCustomActions:"), nsarray(one, 1));
    cell
}

// VoiceOver's Remove on a reading's row.
reading_remove_action(_self: int, _cmd: int, a: int): int {
    n: int = objc_getAssociatedObject(a, ints_address(rd_key));
    if (n == 0) return 0;
    i: int = rg_find(msg(n, sel("longValue")));
    if (i < 0) return 0;
    if (rdl_on_top()) rdl_remove(i + (if (pl_active >= 0) 1 else 0)) else {
        row: int = today_row_of(i);
        if (row >= 0) today_remove(row)
    }
    1
}

// Reading i removed (its line gone, CLEARED now): kept and logged.
reading_removed(i: int) {
    reading_remove(i, time(0));
    readings_changed()
}

// A reading's row tapped: the sheet away, the reader at its kept place
// exactly as launch restores one (no flash: a place, not a reference), the
// place left kept and the capsule back to it; the arrival moves nothing.
rd_go_c: int = 0;

rd_go_v: int = 0;

rd_go_f: int = 0;

rd_settle_timer: int = 0;

reading_go(i: int) {
    if (i < 0 || i >= rg_n) return;
    c: int = rg_c[i];
    v: int = rg_v[i];
    f: int = rg_frac[i];
    // (The chapter already on the screen: there, with no capsule and no
    // history, as Start Reading Here does; review r6-1.)
    here: bool = c == cur;
    if (!here) push_here();
    clear_selection();
    from_sheet: bool = presented() != 0;
    dismiss_sheets();
    show_bars(false);
    stop_moving();
    go_place(c, v, f);
    arrival_y = offset_y(table);
    arrived_v = 0;
    save_place();
    reading_jumped();
    if (!here) {
        history_add(c, v, f, false, time(0));
        save_history()
    }
    rd_go_c = c;
    rd_go_v = v;
    rd_go_f = f;
    // (Made again once the sheet has gone, as a jump is: its insets change
    // as it goes.)
    rd_settle_timer = stop_timer(rd_settle_timer);
    rd_settle_timer = after(0.6f64, "readingSettle:");
    if (here) note("bible: reading opened in the chapter on screen (no capsule)") else if (from_sheet) {
        back_after_sheet = true;
        style_back()
    } else show_back();
    note_num("bible: reading opened at ", c)
}

reading_settle(_self: int, _cmd: int, _timer: int): int {
    rd_settle_timer = 0;
    d: f64 = offset_y(table) - arrival_y;
    if (d < 0.0f64) d = -d;
    if (d > 2.0f64 || (msg(table, sel("isTracking")) & 255) != 0) return 0;
    go_place(rd_go_c, rd_go_v, rd_go_f);
    arrival_y = offset_y(table);
    save_place();
    style_back();
    measure_place();
    note_num("bible: reading settled at ", cur);
    note_num("bible:   verse ", place_v);
    0
}

// ---- Reading (pushed by Show All, Â§11.2.2) ----
rdl_table: int = 0;

rdl_vc: int = 0;

RDL_FOOTER: str = "A reading starts when you choose Start Reading, or read a book\â\€\™s first chapter or two chapters in a row. It keeps your place as you read on, from one book into the next.";

open_reading_list() {
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    vc: int = pushed_list(cls("UITableViewController"), "Reading");
    rdl_vc = held(rdl_vc, vc);
    rdl_table = held(rdl_table, msg(vc, sel("tableView")));
    rdl_empty(false);
    msg2(sheet_nav, sel("pushViewController:animated:"), vc, 1)
}

// Whether Reading is the screen shown (its list, held, outlives its pop).
rdl_on_top(): bool {
    sheet_nav: int = presented();
    rdl_vc != 0 && sheet_nav != 0 && msg(sheet_nav, sel("topViewController")) == rdl_vc
}

rdl_plan(): int {
    if (pl_active >= 0) 1 else 0
}

rdl_rows(): int {
    rdl_plan() + rg_n
}

rdl_cell(t: int, r: int): int {
    if (r < rdl_plan()) {
        cell: int = list_cell(t, "cr-plan", 2);
        plan_row_fill(cell);
        return cell
    }
    reading_row_cell(t, r - rdl_plan())
}

rdl_picked(r: int) {
    if (r < rdl_plan()) {
        daily_ready();
        jump(day_first_unread(plan_day(pl_active, plan_today(today()))), 0)
    } else reading_go(r - rdl_plan())
}

rdl_footer(): int {
    if (rdl_rows() == 0) 0 else nsstring(RDL_FOOTER)
}

// Row r swiped away (Remove): the plan stopped or the reading removed, its
// row gone; the screen stays, and Go To's section is set again as it shows.
rdl_remove(r: int) {
    if (r < rdl_plan()) plan_stop_now() else reading_removed(r - rdl_plan());
    if (rdl_table == 0 || msg(rdl_table, sel("window")) == 0) return;
    one[0] = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), r, 0);
    msg2(rdl_table, sel("deleteRowsAtIndexPaths:withRowAnimation:"), nsarray(one,
        1), 100);
    if (rdl_rows() == 0) {
        msg2(rdl_table, sel("reloadSections:withRowAnimation:"), msg1(cls("NSIndexSet"),
            sel("indexSetWithIndex:"), 0), 0);
        rdl_empty(true)
    }
}

rdl_empty(fade: bool) {
    if (rdl_vc == 0) return;
    if (rdl_rows() > 0) {
        empty_state(rdl_vc, rdl_table, "", 0, "");
        return
    }
    if (fade) fade_layer(msg(msg(rdl_vc, sel("view")), sel("layer")), 0.25f64);
    empty_state(rdl_vc, rdl_table, "book", nsstring("Nothing Being Read"), RDL_FOOTER)
}

// ---- Start Reading (Â§11.2.5) ----
// The screen, its table; where it begins (a chapter, through the Bible);
// the pace chosen (0 At My Own Pace, 1 A Chapter a Day, 2 + p plan p); and
// whether A Chapter a Day's row is shown.
sta_class: int = 0;

sta_vc: int = 0;

sta_table: int = 0;

sta_c: int = 0;

sta_pace: int = 0;

sta_day1_shown: bool = false;

sta_appeared: bool = false;

// The book list it pushes (Book), and its controller.
sta_books_table: int = 0;

sta_books_vc: int = 0;

// Start Reading with Begin At chapter c: pushed in Go To, or a sheet over
// the reader (its title's Start Reading Here).
open_start(c: int, pushed: bool) {
    if (c < 0 || c >= chapters) return;
    if (pushed && presented() == 0) return;
    if (!pushed && presented() != 0) return;
    daily_ready();
    sta_c = c;
    sta_pace = 0;
    sta_day1_shown = day1_days(c) > 0;
    sta_appeared = false;
    vc: int = msg(msg1(msg(sta_class, sel("alloc")), sel("initWithStyle:"), 2), sel("autorelease"));
    msg1(vc, sel("setTitle:"), nsstring("Start Reading"));
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    start: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithTitle:style:target:action:"),
        nsstring("Start"), 2, app_obj, sel("startReading:")), sel("autorelease"));
    msg1(item, sel("setRightBarButtonItem:"), start);
    if (!pushed) msg1(item, sel("setLeftBarButtonItem:"), system_item(1, "closeSheet:"));
    sta_vc = held(sta_vc, vc);
    sta_table = held(sta_table, msg(vc, sel("tableView")));
    msg1(sta_table, sel("setDataSource:"), app_obj);
    msg1(sta_table, sel("setDelegate:"), app_obj);
    style_table(sta_table, true);
    note_num("bible: start reading at ", c);
    if (pushed) msg2(presented(), sel("pushViewController:animated:"), vc, 1) else present(sheet_of(vc,
        1))
}

sta_sections(): int {
    3
}

sta_rows(s: int): int {
    if (s == 0) return 2;
    if (s == 1) return if (sta_day1_shown) 2 else 1;
    PLANS
}

sta_header(s: int): int {
    nsstring(if (s == 0) "Begin At" else if (s == 1) "Pace" else "Plans")
}

// The footer, while a schedule is chosen and a plan is followed: that it
// will stop.
sta_footer_on(pace: int): bool {
    pace >= 1 && pl_active >= 0
}

sta_footer(s: int): int {
    if (s != 2 || !sta_footer_on(sta_pace)) return 0;
    fbuf_n = 0;
    fput_plan_name(pl_active);
    fput_str(" will stop. Your progress in it is kept.");
    fstring()
}

// Whether Begin At is dimmed (a plan that begins where it begins chosen).
sta_dim(): bool {
    sta_pace >= 2
}

sta_cell(t: int, path: int): int {
    s: int = msg(path, sel("section"));
    r: int = msg(path, sel("row"));
    if (s == 0) {
        cell: int = list_cell(t, if (r == 0) "st-book" else "st-chapter", 1);
        sta_begin_fill(cell, r);
        return cell
    }
    cell: int = list_cell(t, "st-pace", 2);
    sta_pace_fill(cell, if (s == 1) r else 2 + r);
    cell
}

// Book or Chapter, the value chosen (dimmed while a whole plan is).
sta_begin_fill(cell: int, r: int) {
    b: int = ch_book[sta_c];
    config: int = list_config(1);
    msg1(config, sel("setText:"), nsstring(if (r == 0) "Book" else "Chapter"));
    msg1(config, sel("setSecondaryText:"), if (r == 0) book_name(b) else nsnumber_text(ch_num[sta_c]));
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(detail_props(config), sel("setColor:"), c_faint);
    msg1(cell, sel("setContentConfiguration:"), config);
    single: bool = r == 1 && book_count[b] == 1;
    msg1(cell, sel("setAccessoryType:"), if (single) 0 else 1);
    off: bool = sta_dim() || single;
    msg_set_f(msg(cell, sel("contentView")), sel("setAlpha:"), if (off) 0.4f64 else 1.0f64);
    msg1(cell, sel("setUserInteractionEnabled:"), if (off) 0 else 1);
    msg1(cell, sel("setAccessibilityTraits:"), if (off) 256 else 1)
}

// A pace's row: its checkmark (leading; clear on the others, so the
// titles line up), title and line; a plan's â“˜ (its preview), or the plan
// followed's day, not to be chosen again.
sta_pace_fill(cell: int, pace: int) {
    config: int = list_config(2);
    chosen: bool = pace == sta_pace;
    config_image(config, "checkmark", 17.0f64, if (chosen) c_accent else msg(cls("UIColor"),
        sel("clearColor")));
    fbuf_n = 0;
    if (pace == 0) fput_str("At My Own Pace") else if (pace == 1) fput_str(if (book_is(ch_book[sta_c],
        "PSA")) "A Psalm a Day" else "A Chapter a Day") else fput_str(plan_names[pace - 2]);
    msg1(config, sel("setText:"), fstring());
    fbuf_n = 0;
    if (pace == 0) fput_str("Keeps your place as you read on, into the next book.") else if (pace == 1) {
        b: int = ch_book[sta_c];
        fput_bytes(bsb, book_name_start(b), book_name_end(b));
        fput(32);
        fput_int(ch_num[sta_c]);
        fput_str("\â\€\“");
        fput_int(book_count[b]);
        fput_str(" \Â\· ");
        fput_int(day1_days(sta_c));
        fput_str(" days")
    } else {
        p: int = pace - 2;
        fput_int(plan_lengths[p]);
        fput_str(" days \Â\· about ");
        fput_int(plan_per_day(p));
        fput_str(if (plan_per_day(p) == 1) " chapter a day" else " chapters a day")
    }
    msg1(config, sel("setSecondaryText:"), fstring());
    row_text_style(config);
    followed: bool = pace >= 2 && pace - 2 == pl_active;
    if (followed) msg1(text_props(config), sel("setColor:"), c_faint);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryType:"), 0);
    msg1(cell, sel("setAccessoryView:"), 0);
    msg1(cell, sel("setSelectionStyle:"), if (followed) 0 else 3);
    msg1(cell, sel("setAccessibilityCustomActions:"), 0);
    if (followed) {
        fbuf_n = 0;
        fput_str("Day ");
        fput_int(plan_today(today()));
        l: int = today_label(msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
            objc_const("UIFontTextStyleBody")), c_accent, 1);
        msg1(l, sel("setText:"), fstring());
        msg(l, sel("sizeToFit"));
        msg1(cell, sel("setAccessoryView:"), l)
    } else if (pace >= 2) {
        msg1(cell, sel("setAccessoryType:"), 4);
        one[0] = custom_action("Plan Details", "startPlanDetails:");
        objc_setAssociatedObject(one[0], ints_address(rd_key), nsnumber_int(pace - 2),
            1);
        msg1(cell, sel("setAccessibilityCustomActions:"), nsarray(one, 1))
    }
    // (Buttons, the chosen one selected; the followed plan's not enabled.)
    msg1(cell, sel("setAccessibilityTraits:"), if (followed) 256 else if (chosen) 9 else 1)
}

sta_picked(s: int, r: int) {
    if (s == 0) {
        if (sta_dim()) return;
        if (r == 0) sta_open_books() else if (book_count[ch_book[sta_c]] > 1) show_chapters_mode(ch_book[sta_c],
            true);
        return
    }
    pace: int = if (s == 1) r else 2 + r;
    if (pace >= 2 && pace - 2 == pl_active) return;
    sta_choose(pace)
}

// A pace chosen: the checkmark moved at once, Begin At dimmed or not (0.2
// s), and the footer faded in or out.
sta_choose(pace: int) {
    if (sta_table == 0 || pace == sta_pace) return;
    old: int = sta_pace;
    was_dim: bool = sta_dim();
    sta_pace = pace;
    for p in [old, pace] {
        cell: int = msg1(sta_table, sel("cellForRowAtIndexPath:"), sta_pace_path(p));
        if (cell != 0) sta_pace_fill(cell, p)
    }
    if (was_dim != sta_dim()) {
        msg2(cls("UIView"), sel("beginAnimations:context:"), 0, 0);
        msg_set_f(cls("UIView"), sel("setAnimationDuration:"), 0.2f64);
        for r in 0..2 {
            cell: int = msg1(sta_table, sel("cellForRowAtIndexPath:"), msg2(cls("NSIndexPath"),
                sel("indexPathForRow:inSection:"), r, 0));
            if (cell != 0) sta_begin_fill(cell, r)
        }
        msg(cls("UIView"), sel("commitAnimations"));
        note_num("bible: begin at dimmed ", if (sta_dim()) 1 else 0)
    }
    if (sta_footer_on(old) != sta_footer_on(pace)) {
        msg(sta_table, sel("beginUpdates"));
        msg2(sta_table, sel("reloadSections:withRowAnimation:"), msg1(cls("NSIndexSet"),
            sel("indexSetWithIndex:"), 2), 0);
        msg(sta_table, sel("endUpdates"));
        note_num("bible: start footer ", if (sta_footer_on(pace)) 1 else 0)
    }
    haptic_select()
}

sta_pace_path(pace: int): int {
    msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), if (pace >= 2) pace - 2 else pace,
        if (pace >= 2) 2 else 1)
}

// Start Reading on the screen again (a book or chapter chosen, popped):
// Begin At's values, and A Chapter a Day's row faded in or out (the pace
// back to At My Own Pace if it went), in one update, as the pop runs.
sta_will_appear(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, sta_class, cmd, animated);
    if (sta_table == 0) return 0;
    if (!sta_appeared) {
        sta_appeared = true;
        return 0
    }
    want: bool = day1_days(sta_c) > 0;
    footer_was: bool = sta_footer_on(sta_pace);
    msg(sta_table, sel("beginUpdates"));
    paths: int = msg(cls("NSMutableArray"), sel("array"));
    for r in 0..2 msg1(paths, sel("addObject:"), msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"),
        r, 0));
    day1: int = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 1, 1);
    one[0] = day1;
    if (want && !sta_day1_shown) msg2(sta_table, sel("insertRowsAtIndexPaths:withRowAnimation:"),
        nsarray(one, 1), 0) else if (!want && sta_day1_shown) {
        msg2(sta_table, sel("deleteRowsAtIndexPaths:withRowAnimation:"), nsarray(one,
            1), 0);
        if (sta_pace == 1) {
            sta_pace = 0;
            msg1(paths, sel("addObject:"), msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"),
                0, 1))
        }
    } else if (want) msg1(paths, sel("addObject:"), day1);
    msg2(sta_table, sel("reloadRowsAtIndexPaths:withRowAnimation:"), paths, 5);
    if (footer_was != sta_footer_on(sta_pace)) msg2(sta_table, sel("reloadSections:withRowAnimation:"),
        msg1(cls("NSIndexSet"), sel("indexSetWithIndex:"), 2), 0);
    note_num("bible: start chapter a day row ", if (want) 1 else 0);
    sta_day1_shown = want;
    msg(sta_table, sel("endUpdates"));
    0
}

// Book: Go To's Old and New Testament rows, the chosen one checked; a tap
// chooses it (at its chapter 1) and pops.
sta_open_books() {
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    vc: int = msg(msg1(msg(cls("UITableViewController"), sel("alloc")), sel("initWithStyle:"),
        2), sel("autorelease"));
    msg1(vc, sel("setTitle:"), nsstring("Book"));
    msg1(msg(vc, sel("navigationItem")), sel("setLargeTitleDisplayMode:"), 2);
    sta_books_vc = held(sta_books_vc, vc);
    sta_books_table = held(sta_books_table, msg(vc, sel("tableView")));
    msg1(sta_books_table, sel("setDataSource:"), app_obj);
    msg1(sta_books_table, sel("setDelegate:"), app_obj);
    style_table(sta_books_table, true);
    // (At the book chosen.)
    b: int = ch_book[sta_c];
    msg(sta_books_table, sel("layoutIfNeeded"));
    msg3(sta_books_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
        msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), if (b < 39) b else b - 39,
        if (b < 39) 0 else 1), 2, 0);
    msg2(sheet_nav, sel("pushViewController:animated:"), vc, 1)
}

sta_books_rows(s: int): int {
    if (s == 0) 39 else books - 39
}

sta_books_cell(t: int, path: int): int {
    s: int = msg(path, sel("section"));
    b: int = msg(path, sel("row")) + (if (s == 0) 0 else 39);
    cell: int = list_cell(t, "st-books", 1);
    config: int = list_config(1);
    msg1(config, sel("setText:"), book_name(b));
    msg1(config, sel("setSecondaryText:"), nsnumber_text(book_count[b]));
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(detail_props(config), sel("setColor:"), c_faint);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryType:"), if (b == ch_book[sta_c]) 3 else 0);
    cell
}

sta_books_picked(s: int, r: int) {
    sta_choose_book(r + (if (s == 0) 0 else 39))
}

sta_choose_book(b: int) {
    sta_c = book_first[b];
    note_num("bible: start book ", b);
    top: int = presented();
    if (top != 0) msg1(top, sel("popViewControllerAnimated:"), 1)
}

// A chapter chosen in the grid (its choosing mode), popped.
sta_choose_chapter(c: int) {
    sta_c = c;
    note_num("bible: start chapter ", c);
    top: int = presented();
    if (top != 0) msg1(top, sel("popViewControllerAnimated:"), 1)
}

// Start: a reading at Begin At (At My Own Pace), or the schedule followed;
// then the sheet away, the reader where it begins (unless it is there),
// and the toast.
start_reading(_self: int, _cmd: int, _b: int): int {
    sta_start();
    0
}

sta_start() {
    c: int = sta_c;
    pace: int = sta_pace;
    target: int = c;
    if (pace == 0) {
        reading_start(c, time(0));
        readings_changed();
        fbuf_n = 0;
        fput_str("Reading from ");
        fput_title(c)
    } else {
        p: int = if (pace == 1) PLAN_DAY1 else pace - 2;
        plan_follow(p, c);
        if (p != PLAN_DAY1) target = pl_rc0[pl_r0[plan_day(p, 1)]];
        fbuf_n = 0;
        fput_str("Started ");
        fput_plan_name(p)
    }
    text: int = fstring();
    msg(text, sel("retain"));
    if (target == cur) dismiss_sheets() else jump(target, 0);
    title_menus_refresh();
    haptic_impact(0);
    toast_symbol(text, "checkmark", if (demo_on) 6.0f64 else 1.6f64);
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: toast ");
        n: int = nsstring_into(text, link_buf);
        for i in 0..n fput(link_buf[i] as int);
        note_ns(fstring())
    }
    release(text);
    note_num("bible: started, the reader in ", cur)
}

// A plan's â“˜ (or VoiceOver's Plan Details) in Start Reading: its days as a
// preview.
sta_accessory(r: int) {
    open_plan(r, 0)
}

start_plan_details(_self: int, _cmd: int, a: int): int {
    n: int = objc_getAssociatedObject(a, ints_address(rd_key));
    if (n != 0) sta_accessory(msg(n, sel("longValue")));
    1
}

// ---- the reader's title: Start Reading Here (Â§11.2.3) ----
// The menu of a title showing chapter c: one command (selector-based),
// "Start Reading Hereâ€¦" with the chapter under it; "Reading Here",
// disabled, when a reading is at it.
title_menu(c: int): int {
    here: bool = rg_find(c) >= 0;
    cmd: int = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
        nsstring(if (here) "Reading Here" else "Start Reading Here\â\€\¦"), symbol("book",
        17.0f64, 4, 0), sel("startReadingHere:"), nsnumber_int(c));
    if (responds(cmd, "setSubtitle:")) msg1(cmd, sel("setSubtitle:"), place_name(c,
        0));
    if (here) msg1(cmd, sel("setAttributes:"), 1);
    one[0] = cmd;
    msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""), nsarray(one,
        1))
}

// The compact band's menu: the chapter it was made for.
compact_menu_c: int = -2;

title_menu_set(b: int, c: int) {
    if (b == 0 || c < 0) return;
    msg1(b, sel("setMenu:"), title_menu(c))
}

// The title's (both its buttons') and the compact band's menus, made again
// (a reading started or gone at the chapter).
title_menus_refresh() {
    for i in 0..2 title_menu_set(title_btn[i], title_btn_c[i]);
    compact_menu_c = -2;
    title_compact_menu()
}

title_compact_menu() {
    if (compact_button == 0 || title_view == 0) return;
    c: int = title_btn_c[title_settled()];
    if (c == compact_menu_c || c < 0) return;
    compact_menu_c = c;
    title_menu_set(compact_button, c)
}

// VoiceOver's "Start Reading Here" on the title.
title_actions(b: int) {
    one[0] = custom_action("Start Reading Here", "startReadingHereAction:");
    msg1(b, sel("setAccessibilityCustomActions:"), nsarray(one, 1))
}

start_reading_here(_self: int, _cmd: int, sender: int): int {
    c: int = cur;
    if (sender != 0 && responds(sender, "propertyList")) {
        n: int = msg(sender, sel("propertyList"));
        if (n != 0 && responds(n, "longValue")) c = msg(n, sel("longValue"))
    }
    note_num("bible: start reading here ", c);
    open_start(c, false);
    0
}

start_reading_here_action(_self: int, _cmd: int, _a: int): int {
    open_start(cur, false);
    1
}

// ---- the grid's toolbar (Â§11.2.6) ----
grid_class: int = 0;

grid_will_appear(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, grid_class, cmd, animated);
    items: int = msg(self, sel("toolbarItems"));
    nav_sheet: int = msg(self, sel("navigationController"));
    if (nav_sheet != 0 && items != 0 && msg(items, sel("count")) > 0) msg2(nav_sheet,
        sel("setToolbarHidden:animated:"), 0, animated & 255);
    0
}

grid_will_go(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, grid_class, cmd, animated);
    items: int = msg(self, sel("toolbarItems"));
    nav_sheet: int = msg(self, sel("navigationController"));
    if (nav_sheet != 0 && items != 0 && msg(items, sel("count")) > 0) msg2(nav_sheet,
        sel("setToolbarHidden:animated:"), 1, animated & 255);
    0
}

// "Start Reading Romansâ€¦", centered.
grid_toolbar(grid: int, b: int) {
    flex: int = msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        5, 0, 0), sel("autorelease"));
    fbuf_n = 0;
    fput_str("Start Reading ");
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    fput_str("\â\€\¦");
    item: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithTitle:style:target:action:"),
        fstring(), 0, app_obj, sel("gridStartReading:")), sel("autorelease"));
    msg1(item, sel("setTag:"), b + 1);
    bar_items[0] = flex;
    bar_items[1] = item;
    bar_items[2] = flex;
    msg2(grid, sel("setToolbarItems:animated:"), nsarray(bar_items, 3), 0)
}

grid_start_reading(_self: int, _cmd: int, item: int): int {
    b: int = msg(item, sel("tag")) - 1;
    if (b >= 0 && b < books) open_start(book_first[b], true);
    0
}

// ---- the sheet gone ----
reading_sheet_gone() {
    rdl_table = held(rdl_table, 0);
    rdl_vc = held(rdl_vc, 0);
    sta_table = held(sta_table, 0);
    sta_vc = held(sta_vc, 0);
    sta_books_table = held(sta_books_table, 0);
    sta_books_vc = held(sta_books_vc, 0)
}

// The theme changed: the lists shown, in it.
style_reading_sheets() {
    for t in [rdl_table, sta_table, sta_books_table] {
        if (t != 0) {
            style_table(t, true);
            msg(t, sel("reloadData"))
        }
    }
}

// ---- classes and methods ----
make_reading_classes() {
    sta_class = objc_allocateClassPair(cls("UITableViewController"), "L8StartReading",
        0);
    add_method1(sta_class, sel("viewWillAppear:"), &sta_will_appear, "v@:B");
    objc_registerClassPair(sta_class);
    grid_class = objc_allocateClassPair(cls("UICollectionViewController"), "L8Grid",
        0);
    add_method1(grid_class, sel("viewWillAppear:"), &grid_will_appear, "v@:B");
    add_method1(grid_class, sel("viewWillDisappear:"), &grid_will_go, "v@:B");
    objc_registerClassPair(grid_class)
}

add_reading_methods(app: int) {
    add_method1(app, sel("readingDwelt:"), &reading_dwelt, "v@:@");
    add_method1(app, sel("readingSettle:"), &reading_settle, "v@:@");
    add_method1(app, sel("readingRemoveAction:"), &reading_remove_action, "B@:@");
    add_method1(app, sel("startReading:"), &start_reading, "v@:@");
    add_method1(app, sel("startPlanDetails:"), &start_plan_details, "B@:@");
    add_method1(app, sel("startReadingHere:"), &start_reading_here, "v@:@");
    add_method1(app, sel("startReadingHereAction:"), &start_reading_here_action, "B@:@");
    add_method1(app, sel("gridStartReading:"), &grid_start_reading, "v@:@")
}
