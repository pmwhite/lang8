tag bible_tui;

use_tag std, bible;

// The terminal (Linux, x86-64): raw keys in, a whole screen out. The
// screen is drawn into a cell grid each frame (tm_*), then only the cells
// that changed are written, with 24-bit colors, so the reader scrolls
// without flicker. Keys, the mouse (SGR reports) and the terminal's answer
// about its background come in through tm_read, decoded into tm_keys.
import "../../../stdlib/write.l8";

// Linux x86-64 adapters in runtime.s return negative errno.
extern l8_ioctl(fd: int, request: int, value: *i32): int;

extern l8_clock_gettime(clock: int, ts: *TmTime): int;

type TmTime = {
    sec: int;
    nsec: int
}

type TmPoll = {
    fd: i32;
    events: i32
}

extern l8_poll(fds: *TmPoll, count: int, timeout: i32): int;

// Milliseconds on a clock that only goes forward.
tm_now(): int {
    t: TmTime = TmTime { sec: 0, nsec: 0 };
    _c: int = l8_clock_gettime(1, &t);
    t.sec * 1000 + t.nsec / 1000000
}

// ---- raw mode ----
// termios as the kernel has it (60 bytes: four flags, the line, the
// control characters), kept to put back on leaving.
tm_saved: []i32 = static_buffer([16]i32);

tm_raw: []i32 = static_buffer([16]i32);

tm_is_raw: bool = false;

tm_enter() {
    // (TCGETS; TCSETS.)
    if (l8_ioctl(0, 21505, &tm_saved[0]) < 0) return;
    for i in 0..16 tm_raw[i] = tm_saved[i];
    // (iflag: no ICRNL, IXON, ISTRIP, INPCK, BRKINT; oflag kept; lflag: no
    // ECHO, ICANON, ISIG, IEXTEN.)
    tm_raw[0] = (tm_raw[0] as int & ~(256 | 1024 | 32 | 16 | 2)) trunc i32;
    tm_raw[3] = (tm_raw[3] as int & ~(8 | 2 | 1 | 32768)) trunc i32;
    // (VMIN 0, VTIME 0: c_cc[5] and c_cc[6] are bytes 22 and 23.)
    tm_raw[5] = (tm_raw[5] as int & 65535) trunc i32;
    _s: int = l8_ioctl(0, 21506, &tm_raw[0]);
    tm_is_raw = true;
    // The other screen, no cursor, the mouse (buttons, wheel, SGR), focus
    // and paste reported; then the background asked for.
    tm_str("`[?1049h`[?25l`[?1000h`[?1006h`[?2004h`]11;?`\\");
    tm_flush()
}

tm_leave() {
    if (!tm_is_raw) return;
    tm_str("`[0m`[?2004l`[?1006l`[?1000l`[?25h`[?1049l");
    tm_flush();
    _s: int = l8_ioctl(0, 21506, &tm_saved[0]);
    tm_is_raw = false
}

// The window's size (TIOCGWINSZ): rows and columns.
tm_rows: int = 24;

tm_cols: int = 80;

tm_size(): bool {
    w: []i32 = tm_winsize;
    if (l8_ioctl(1, 21523, &w[0]) < 0) return false;
    r: int = w[0] as int & 65535;
    c: int = w[0] as int >> 16 & 65535;
    if (r < 4 || c < 20) return false;
    changed: bool = r != tm_rows || c != tm_cols;
    tm_rows = r;
    tm_cols = c;
    changed
}

tm_winsize: []i32 = static_buffer([2]i32);

// ---- output ----
tm_out: []i8 = static_buffer([4194304]i8);

tm_out_n: int = 0;

tm_byte(k: int) {
    if (tm_out_n < len(tm_out)) {
        tm_out[tm_out_n] = k trunc i8;
        tm_out_n = tm_out_n + 1
    }
}

// Control sequences: ` stands for ESC (L8's strings have no escape for it).
tm_str(s: str) {
    for c in s tm_byte(if (c as int == 96) 27 else c as int)
}

tm_int(n: int) {
    if (n < 0) {
        tm_byte(45);
        tm_int(-n);
        return
    }
    if (n >= 10) tm_int(n / 10);
    tm_byte(48 + n % 10)
}

tm_flush() {
    if (tm_out_n == 0) return;
    try {
        write_bytes_n(1, tm_out, tm_out_n)
    } with IoError _e -> { }
    tm_out_n = 0
}

// ---- the cell grid ----
// Each cell: its character (a code point; 0 the right half of a wide one),
// its colors (RGB), and attributes (TA_ bits). The frame drawn (tm_*), and
// the one on the terminal (tm_was_*), compared when flushed.
TA_BOLD: int = 1;

TA_ITALIC: int = 2;

TA_UNDER: int = 4;

TA_REVERSE: int = 8;

// Combining marks on a cell (a pointed Hebrew letter's, accented Greek):
// up to three, after its character.
TM_MOST: int = 65536;

tm_ch: []int = static_buffer([65536]int, 32);

tm_mk: []int = static_buffer(65536 * 3, 0);

tm_fg: []int = static_buffer([65536]int);

tm_bg: []int = static_buffer([65536]int);

tm_at: []int = static_buffer([65536]int);

tm_was_ch: []int = static_buffer([65536]int, -1);

tm_was_mk: []int = static_buffer(65536 * 3, 0);

tm_was_fg: []int = static_buffer([65536]int);

tm_was_bg: []int = static_buffer([65536]int);

tm_was_at: []int = static_buffer([65536]int);

// Everything written again on the next flush (a resize, a redraw).
tm_forget() {
    for i in 0..TM_MOST tm_was_ch[i] = -1
}

tm_clear(bg: int, fg: int) {
    n: int = tm_rows * tm_cols;
    if (n > TM_MOST) n = TM_MOST;
    for i in 0..n {
        tm_ch[i] = 32;
        tm_mk[i * 3] = 0;
        tm_mk[i * 3 + 1] = 0;
        tm_mk[i * 3 + 2] = 0;
        tm_fg[i] = fg;
        tm_bg[i] = bg;
        tm_at[i] = 0
    }
}

tm_cell(r: int, c: int): int {
    if (r < 0 || c < 0 || r >= tm_rows || c >= tm_cols) return -1;
    i: int = r * tm_cols + c;
    if (i >= TM_MOST) -1 else i
}

// A cell's background (a wash over what is there).
tm_paint(r: int, c: int, bg: int) {
    i: int = tm_cell(r, c);
    if (i >= 0) tm_bg[i] = bg
}

// Code point u at row r, column c in colors fg on bg with attributes at:
// the columns it takes (0, 1 or 2). A combining mark joins the cell before.
tm_put(
    r: int,
    c: int,
    u: int,
    fg: int,
    bg: int,
    at: int
): int {
    w: int = tm_width(u);
    if (w == 0) {
        i: int = tm_cell(r, c - 1);
        if (i >= 0) {
            if (tm_mk[i * 3] == 0) tm_mk[i * 3] = u else if (tm_mk[i * 3 + 1] == 0) tm_mk[i * 3 + 1] = u else if (tm_mk[i * 3 + 2] == 0) tm_mk[i * 3 + 2] = u
        }
        return 0
    }
    i: int = tm_cell(r, c);
    if (i < 0) return w;
    if (w == 2 && c + 1 >= tm_cols) return w;
    tm_ch[i] = u;
    tm_mk[i * 3] = 0;
    tm_mk[i * 3 + 1] = 0;
    tm_mk[i * 3 + 2] = 0;
    tm_fg[i] = fg;
    tm_bg[i] = bg;
    tm_at[i] = at;
    if (w == 2) {
        j: int = tm_cell(r, c + 1);
        if (j >= 0) {
            tm_ch[j] = 0;
            tm_fg[j] = fg;
            tm_bg[j] = bg;
            tm_at[j] = at
        }
    }
    w
}

// ASCII words at r, c: the columns taken.
tm_text(
    r: int,
    c: int,
    s: str,
    fg: int,
    bg: int,
    at: int
): int {
    x: int = c;
    p: int = 0;
    n: int = len(s);
    while (p < n) {
        u: int = tm_cp_at_s(s, p, n);
        p = p + tm_cp_len;
        x = x + tm_put(r, x, u, fg, bg, at)
    }
    x - c
}

// Bytes b to e of buf (UTF-8) at r, c, at most room columns: the columns.
tm_bytes(
    r: int,
    c: int,
    buf: []i8,
    b: int,
    e: int,
    room: int,
    fg: int,
    bg: int,
    at: int
): int {
    x: int = c;
    p: int = b;
    while (p < e && x - c < room) {
        u: int = tm_cp_at(buf, p, e);
        p = p + tm_cp_len;
        if (x - c + tm_width(u) <= room) x = x + tm_put(r, x, u, fg, bg, at) else p = e
    }
    x - c
}

// The frame written: each cell that changed, moving only where needed.
tm_show() {
    n: int = tm_rows * tm_cols;
    if (n > TM_MOST) n = TM_MOST;
    cur_fg: int = -1;
    cur_bg: int = -1;
    cur_at: int = -1;
    at_r: int = -1;
    at_c: int = -1;
    for i in 0..n {
        same: bool = tm_was_ch[i] == tm_ch[i] && tm_was_fg[i] == tm_fg[i] && tm_was_bg[i] == tm_bg[i] && tm_was_at[i] == tm_at[i] && tm_was_mk[i * 3] == tm_mk[i * 3] && tm_was_mk[i * 3 + 1] == tm_mk[i * 3 + 1] && tm_was_mk[i * 3 + 2] == tm_mk[i * 3 + 2];
        // (A wide character's right half is written with its left.)
        if (!same && tm_ch[i] != 0) {
            r: int = i / tm_cols;
            c: int = i % tm_cols;
            if (r != at_r || c != at_c) {
                tm_str("`[");
                tm_int(r + 1);
                tm_byte(59);
                tm_int(c + 1);
                tm_byte(72)
            }
            if (tm_at[i] != cur_at) {
                tm_str("`[0");
                if ((tm_at[i] & TA_BOLD) != 0) tm_str(";1");
                if ((tm_at[i] & TA_ITALIC) != 0) tm_str(";3");
                if ((tm_at[i] & TA_UNDER) != 0) tm_str(";4");
                if ((tm_at[i] & TA_REVERSE) != 0) tm_str(";7");
                tm_byte(109);
                cur_at = tm_at[i];
                cur_fg = -1;
                cur_bg = -1
            }
            if (tm_fg[i] != cur_fg) {
                tm_rgb(38, tm_fg[i]);
                cur_fg = tm_fg[i]
            }
            if (tm_bg[i] != cur_bg) {
                tm_rgb(48, tm_bg[i]);
                cur_bg = tm_bg[i]
            }
            tm_utf8(tm_ch[i]);
            for k in 0..3
                if (tm_mk[i * 3 + k] != 0) tm_utf8(tm_mk[i * 3 + k]);
            at_r = r;
            at_c = c + tm_width(tm_ch[i]);
            if (at_c >= tm_cols) at_r = -1
        }
        if (!same) {
            tm_was_ch[i] = tm_ch[i];
            tm_was_fg[i] = tm_fg[i];
            tm_was_bg[i] = tm_bg[i];
            tm_was_at[i] = tm_at[i];
            tm_was_mk[i * 3] = tm_mk[i * 3];
            tm_was_mk[i * 3 + 1] = tm_mk[i * 3 + 1];
            tm_was_mk[i * 3 + 2] = tm_mk[i * 3 + 2]
        }
    }
    tm_flush()
}

tm_rgb(kind: int, rgb: int) {
    tm_str("`[");
    tm_int(kind);
    tm_str(";2;");
    tm_int(rgb >> 16 & 255);
    tm_byte(59);
    tm_int(rgb >> 8 & 255);
    tm_byte(59);
    tm_int(rgb & 255);
    tm_byte(109)
}

tm_utf8(u: int) {
    if (u < 128) tm_byte(u) else if (u < 2048) {
        tm_byte(192 + u / 64);
        tm_byte(128 + u % 64)
    } else if (u < 65536) {
        tm_byte(224 + u / 4096);
        tm_byte(128 + u / 64 % 64);
        tm_byte(128 + u % 64)
    } else {
        tm_byte(240 + u / 262144);
        tm_byte(128 + u / 4096 % 64);
        tm_byte(128 + u / 64 % 64);
        tm_byte(128 + u % 64)
    }
}

// A box: its edges drawn (rounded corners), its inside filled.
tm_box(
    r0: int,
    c0: int,
    h: int,
    w: int,
    edge: int,
    bg: int
) {
    for r in r0..r0 + h {
        for c in c0..c0 + w {
            u: int = if (r == r0 && c == c0) 9581 else if (r == r0 && c == c0 + w - 1) 9582 else if (r == r0 + h - 1 && c == c0) 9584 else if (r == r0 + h - 1 && c == c0 + w - 1) 9583 else if (r == r0 || r == r0 + h - 1) 9472 else if (c == c0 || c == c0 + w - 1) 9474 else 32;
            _p: int = tm_put(r, c, u, edge, bg, 0)
        }
    }
}

// ---- UTF-8 and widths ----
tm_cp_len: int = 1;

// The code point at p (bytes to e), its length in tm_cp_len.
tm_cp_at(b: []i8, p: int, e: int): int {
    k: int = b[p] as int & 255;
    tm_cp_len = 1;
    if (k < 128) return k;
    if (k >= 240 && p + 3 < e) {
        tm_cp_len = 4;
        return (k & 7) * 262144 + (b[p + 1] as int & 63) * 4096 + (b[p + 2] as int & 63) * 64 + (b[p + 3] as int & 63)
    }
    if (k >= 224 && p + 2 < e) {
        tm_cp_len = 3;
        return (k & 15) * 4096 + (b[p + 1] as int & 63) * 64 + (b[p + 2] as int & 63)
    }
    if (k >= 192 && p + 1 < e) {
        tm_cp_len = 2;
        return (k & 31) * 64 + (b[p + 1] as int & 63)
    }
    65533
}

// (The same, of a str.)
tm_cp_at_s(b: str, p: int, e: int): int {
    k: int = b[p] as int & 255;
    tm_cp_len = 1;
    if (k < 128) return k;
    if (k >= 240 && p + 3 < e) {
        tm_cp_len = 4;
        return (k & 7) * 262144 + (b[p + 1] as int & 63) * 4096 + (b[p + 2] as int & 63) * 64 + (b[p + 3] as int & 63)
    }
    if (k >= 224 && p + 2 < e) {
        tm_cp_len = 3;
        return (k & 15) * 4096 + (b[p + 1] as int & 63) * 64 + (b[p + 2] as int & 63)
    }
    if (k >= 192 && p + 1 < e) {
        tm_cp_len = 2;
        return (k & 31) * 64 + (b[p + 1] as int & 63)
    }
    65533
}

// The columns a code point takes: combining marks and zero-width ones 0,
// wide ones (CJK, emoji) 2.
tm_width(u: int): int {
    if (u < 768) return 1;
    if (u <= 879 || u >= 1155 && u <= 1161 || u >= 1425 && u <= 1469 || u == 1471 || u == 1473 || u == 1474 || u == 1476 || u == 1477 || u == 1479) return 0;
    if (u >= 1552 && u <= 1562 || u >= 1611 && u <= 1631 || u >= 8203 && u <= 8207 || u == 8288 || u >= 65024 && u <= 65039 || u == 65279) return 0;
    if (u >= 7616 && u <= 7679 || u >= 8400 && u <= 8432) return 0;
    if (u >= 4352 && u <= 4447 || u >= 11904 && u <= 42191 || u >= 44032 && u <= 55203 || u >= 63744 && u <= 64255 || u >= 65072 && u <= 65103 || u >= 65280 && u <= 65376 || u >= 65504 && u <= 65510) return 2;
    if (u >= 127744 && u <= 129791) return 2;
    1
}

// Columns bytes b to e take.
tm_cols_of(buf: []i8, b: int, e: int): int {
    w: int = 0;
    p: int = b;
    while (p < e) {
        u: int = tm_cp_at(buf, p, e);
        p = p + tm_cp_len;
        w = w + tm_width(u)
    }
    w
}

tm_str_cols(s: str): int {
    w: int = 0;
    p: int = 0;
    while (p < len(s)) {
        u: int = tm_cp_at_s(s, p, len(s));
        p = p + tm_cp_len;
        w = w + tm_width(u)
    }
    w
}

// ---- colors ----
// Color a mixed into b by f (thousandths of a).
tm_mix(a: int, b: int, f: int): int {
    r: int = ((a >> 16 & 255) * f + (b >> 16 & 255) * (1000 - f)) / 1000;
    g: int = ((a >> 8 & 255) * f + (b >> 8 & 255) * (1000 - f)) / 1000;
    bl: int = ((a & 255) * f + (b & 255) * (1000 - f)) / 1000;
    r * 65536 + g * 256 + bl
}

// Six hex digits at p of buf (else -1).
tm_hex(buf: []i8, p: int, e: int): int {
    if (e - p < 6) return -1;
    n: int = 0;
    for i in 0..6 {
        k: int = buf[p + i] as int;
        d: int = if (k >= 48 && k <= 57) k - 48 else if (k >= 97 && k <= 102) k - 87 else if (k >= 65 && k <= 70) k - 55 else -1;
        if (d < 0) return -1;
        n = n * 16 + d
    }
    n
}

// ---- input ----
// What came in, decoded into keys: each a code (a character's code point,
// or a TK_ name), its modifiers (TM_ bits), and for the mouse its row and
// column.
TK_UP: int = -1;

TK_DOWN: int = -2;

TK_LEFT: int = -3;

TK_RIGHT: int = -4;

TK_PGUP: int = -5;

TK_PGDN: int = -6;

TK_HOME: int = -7;

TK_END: int = -8;

TK_ESC: int = -9;

TK_ENTER: int = -10;

TK_TAB: int = -11;

TK_BACKTAB: int = -12;

TK_BACKSPACE: int = -13;

TK_DELETE: int = -14;

TK_CLICK: int = -20;

TK_WHEEL_UP: int = -21;

TK_WHEEL_DOWN: int = -22;

TK_RIGHT_CLICK: int = -23;

TK_PASTE: int = -24;

// The terminal's background answered (rgb in tk_row).
TK_BACKGROUND: int = -30;

TM_SHIFT: int = 1;

TM_ALT: int = 2;

TM_CTRL: int = 4;

tk_code: []int = static_buffer([1024]int);

tk_mods: []int = static_buffer([1024]int);

tk_row: []int = static_buffer([1024]int);

tk_col: []int = static_buffer([1024]int);

tk_count: int = 0;

// (What a paste brought: its bytes, for a field.)
tk_paste: []i8 = static_buffer([4096]i8);

tk_paste_n: int = 0;

tm_in: []i8 = static_buffer([16384]i8);

tm_in_n: int = 0;

// Whether input waits (stdin), at most ms.
tm_wait(ms: int): bool {
    p: TmPoll = TmPoll { fd: 0i32, events: 1i32 };
    l8_poll(&p, 1, (if (ms < 0) 0 else ms) trunc i32) > 0
}

// What waits read and decoded.
tm_read() {
    tk_count = 0;
    k: int = read(0, tm_in, tm_in_n, len(tm_in) - tm_in_n);
    if (k > 0) tm_in_n = tm_in_n + k;
    p: int = 0;
    more: bool = true;
    while (p < tm_in_n && more) {
        q: int = tm_decode(p);
        // (An escape not yet whole: kept for the next read, unless it is
        // alone, Escape.)
        if (q <= p) {
            if (tm_in[p] as int == 27 && tm_in_n - p == 1) {
                tk_add(TK_ESC, 0, 0, 0);
                p = p + 1
            } else more = false
        } else p = q
    }
    rest: int = tm_in_n - p;
    for i in 0..rest tm_in[i] = tm_in[p + i];
    tm_in_n = rest
}

tk_add(
    code: int,
    mods: int,
    row: int,
    col: int
) {
    if (tk_count >= len(tk_code)) return;
    tk_code[tk_count] = code;
    tk_mods[tk_count] = mods;
    tk_row[tk_count] = row;
    tk_col[tk_count] = col;
    tk_count = tk_count + 1
}

// One key from p: where it ends (p: not whole yet).
tm_decode(p: int): int {
    n: int = tm_in_n;
    k: int = tm_in[p] as int & 255;
    if (k == 27) {
        if (p + 1 >= n) return p;
        k2: int = tm_in[p + 1] as int & 255;
        if (k2 == 91) return tm_csi(p);
        if (k2 == 79) {
            if (p + 2 >= n) return p;
            k3: int = tm_in[p + 2] as int;
            tk_add(if (k3 == 65) TK_UP else if (k3 == 66) TK_DOWN else if (k3 == 67) TK_RIGHT else if (k3 == 68) TK_LEFT else if (k3 == 72) TK_HOME else if (k3 == 70) TK_END else 0,
                0, 0, 0);
            return p + 3
        }
        if (k2 == 93) return tm_osc(p);
        if (k2 == 27) {
            tk_add(TK_ESC, 0, 0, 0);
            return p + 1
        }
        // (Alt with a key.)
        u: int = tm_cp_at(tm_in, p + 1, n);
        tk_add(u, TM_ALT, 0, 0);
        return p + 1 + tm_cp_len
    }
    if (k == 13 || k == 10) {
        tk_add(TK_ENTER, 0, 0, 0);
        return p + 1
    }
    if (k == 9) {
        tk_add(TK_TAB, 0, 0, 0);
        return p + 1
    }
    if (k == 127 || k == 8) {
        tk_add(TK_BACKSPACE, 0, 0, 0);
        return p + 1
    }
    if (k < 32) {
        // (Control with a letter: its letter.)
        tk_add(96 + k, TM_CTRL, 0, 0);
        return p + 1
    }
    u: int = tm_cp_at(tm_in, p, n);
    if (tm_cp_len > 1 && p + tm_cp_len > n) return p;
    tk_add(u, 0, 0, 0);
    p + tm_cp_len
}

// ESC [ ...: arrows, pages, the mouse, a paste.
tm_csi(p: int): int {
    n: int = tm_in_n;
    q: int = p + 2;
    // (Its parameters, then its final byte.)
    while (q < n && (tm_in[q] as int < 64 || tm_in[q] as int > 126)) q = q + 1;
    if (q >= n) return p;
    f: int = tm_in[q] as int;
    // The parameters: up to three numbers, split by ;.
    a: int = 0;
    b: int = 0;
    c: int = 0;
    which: int = 0;
    lt: bool = q > p + 2 && tm_in[p + 2] as int == 60;
    for i in p + 2..q {
        d: int = tm_in[i] as int;
        if (d >= 48 && d <= 57) {
            if (which == 0) a = a * 10 + d - 48 else if (which == 1) b = b * 10 + d - 48 else c = c * 10 + d - 48
        } else if (d == 59) which = which + 1
    }
    if (lt && (f == 77 || f == 109)) {
        // (The mouse, SGR: button;col;row, M pressed, m let go.)
        if (f == 77) {
            if (a == 64) tk_add(TK_WHEEL_UP, 0, c - 1, b - 1) else if (a == 65) tk_add(TK_WHEEL_DOWN,
                0, c - 1, b - 1) else if ((a & 3) == 0 && a < 32) tk_add(TK_CLICK,
                0, c - 1, b - 1) else if ((a & 3) == 2 && a < 32) tk_add(TK_RIGHT_CLICK,
                0, c - 1, b - 1)
        }
        return q + 1
    }
    mods: int = if (b > 1) b - 1 else 0;
    m: int = (if ((mods & 1) != 0) TM_SHIFT else 0) | (if ((mods & 2) != 0) TM_ALT else 0) | (if ((mods & 4) != 0) TM_CTRL else 0);
    if (f == 65) tk_add(TK_UP, m, 0, 0) else if (f == 66) tk_add(TK_DOWN, m, 0, 0) else if (f == 67) tk_add(TK_RIGHT,
        m, 0, 0) else if (f == 68) tk_add(TK_LEFT, m, 0, 0) else if (f == 72) tk_add(TK_HOME,
        m, 0, 0) else if (f == 70) tk_add(TK_END, m, 0, 0) else if (f == 90) tk_add(TK_BACKTAB,
        0, 0, 0) else if (f == 126) {
        if (a == 5) tk_add(TK_PGUP, m, 0, 0) else if (a == 6) tk_add(TK_PGDN, m, 0,
            0) else if (a == 3) tk_add(TK_DELETE, m, 0, 0) else if (a == 1 || a == 7) tk_add(TK_HOME,
            m, 0, 0) else if (a == 4 || a == 8) tk_add(TK_END, m, 0, 0) else if (a == 200) return tm_paste(q + 1)
    }
    q + 1
}

// A paste's bytes, to ESC [ 201 ~.
tm_paste(p: int): int {
    n: int = tm_in_n;
    q: int = p;
    found: int = -1;
    while (q + 5 < n && found < 0) {
        if (tm_in[q] as int == 27 && tm_in[q + 1] as int == 91 && tm_in[q + 2] as int == 50 && tm_in[q + 3] as int == 48 && tm_in[q + 4] as int == 49 && tm_in[q + 5] as int == 126) found = q else q = q + 1
    }
    if (found < 0) return p - 6;
    tk_paste_n = 0;
    for i in p..found {
        k: int = tm_in[i] as int;
        if (tk_paste_n < len(tk_paste) && k != 10 && k != 13) {
            tk_paste[tk_paste_n] = tm_in[i];
            tk_paste_n = tk_paste_n + 1
        }
    }
    tk_add(TK_PASTE, 0, 0, 0);
    found + 6
}

// ESC ] 11 ; rgb:RRRR/GGGG/BBBB (BEL or ESC \): the background.
tm_osc(p: int): int {
    n: int = tm_in_n;
    q: int = p + 2;
    e: int = -1;
    while (q < n && e < 0) {
        if (tm_in[q] as int == 7) e = q + 1 else if (tm_in[q] as int == 27 && q + 1 < n && tm_in[q + 1] as int == 92) e = q + 2 else q = q + 1
    }
    if (e < 0) return p;
    // (rgb: four hex digits a color, the first two kept.)
    s: int = p + 2;
    while (s < q && tm_in[s] as int != 58) s = s + 1;
    if (s + 15 <= q) {
        r: int = tm_hex2(s + 1);
        g: int = tm_hex2(s + 6);
        b: int = tm_hex2(s + 11);
        if (r >= 0 && g >= 0 && b >= 0) tk_add(TK_BACKGROUND, 0, r * 65536 + g * 256 + b,
            0)
    }
    e
}

tm_hex2(p: int): int {
    n: int = 0;
    for i in 0..2 {
        k: int = tm_in[p + i] as int;
        d: int = if (k >= 48 && k <= 57) k - 48 else if (k >= 97 && k <= 102) k - 87 else if (k >= 65 && k <= 70) k - 55 else -1;
        if (d < 0) return -1;
        n = n * 16 + d
    }
    n
}
