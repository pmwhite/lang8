tag bible_tui;

use_tag std, bible;

// Smooth Bible in a terminal: the skin (SKINS.md, a skin by the contract).
// It reads core's lines and draws them the terminal's way: the reader as
// the page (chapters one after another, scrolled by line), a bar above it
// (the title, the carried ribbon's mark, the version), a line below it
// (what the keys do; Listen's player; a toast), core's screens in a panel
// beside the reader on a wide terminal or over it on a narrow one, the
// selection's tray above the line below, menus over everything. Every key
// is a line to core (tap, act, key, tapverse, ...); what happens is core's.
import "panel.l8";

import "proc.l8";

// ---- what core said ----
from_core: []i8 = new i8[16777216](0i8);

from_core_n: int = 0;

// (Core's host's say: its lines, kept to be read in the loop.)
tk_heard(b: []i8, start: int, n: int) {
    for i in 0..n {
        if (from_core_n < len(from_core)) {
            from_core[from_core_n] = b[start + i];
            from_core_n = from_core_n + 1
        }
    }
}

// Every whole line read.
tk_lines() {
    p: int = 0;
    for i in 0..from_core_n {
        if (from_core[i] as int == 10) {
            tk_line(from_core, p, i);
            p = i + 1
        }
    }
    rest: int = from_core_n - p;
    for i in 0..rest from_core[i] = from_core[p + i];
    from_core_n = rest
}

// Whether core's host has said ready, and the app begun.
tk_ready: bool = false;

tk_started: bool = false;

tk_dirty: bool = true;

tk_line(buf: []i8, b: int, e: int) {
    if (sc_taking >= 0) {
        if (sc_take(buf, b, e)) tk_screen_done(sc_end_id);
        return
    }
    if (rd_taking >= 0) {
        _d: bool = rd_take(buf, b, e);
        return
    }
    tk_dirty = true;
    if (wl_is(buf, b, e, "screen")) sc_begin(buf, b, e) else if (wl_is(buf, b, e,
        "chapter")) rd_chapter(buf, b, e) else if (wl_is(buf, b, e, "present") || wl_is(buf,
        b, e, "panel")) {
        pn_commit_field();
        pn_present(wl_num(buf, b, e, 1))
    } else if (wl_is(buf, b, e, "push") || wl_is(buf, b, e, "present_over")) {
        pn_commit_field();
        pn_push(wl_num(buf, b, e, 1))
    } else if (wl_is(buf, b, e, "update") || wl_is(buf, b, e, "refill")) pn_update(wl_num(buf,
        b, e, 1)) else if (wl_is(buf, b, e, "reveal")) pn_reveal(wl_num(buf, b, e,
        1)) else if (wl_is(buf, b, e, "retext")) pn_retext(wl_num(buf, b, e, 1)) else if (wl_is(buf,
        b, e, "pop")) pn_pop() else if (wl_is(buf, b, e, "pop_to")) pn_pop_to(wl_num(buf,
        b, e, 1)) else if (wl_is(buf, b, e, "close")) pn_close(wl_num(buf, b, e, 1)) else if (wl_is(buf,
        b, e, "dismiss")) pn_dismiss() else if (wl_is(buf, b, e, "focus")) {
        id: int = wl_num(buf, b, e, 1);
        if (pn_top() == id) pn_open(true)
    } else if (wl_is(buf, b, e, "ready")) tk_ready = true else if (wl_is(buf, b, e,
        "reader")) {
        rd_chapters = wl_num(buf, b, e, 1);
        rd_forget()
    } else if (wl_is(buf, b, e, "look")) tk_look(buf, b, e) else if (wl_is(buf, b,
        e, "title")) {
        tk_title_n = wl_get(buf, b, e, 1);
        for k in 0..tk_title_n tk_title[k] = wl_text[k]
    } else if (wl_is(buf, b, e, "version")) {
        tk_version_n = wl_get(buf, b, e, 1);
        for k in 0..tk_version_n tk_version[k] = wl_text[k]
    } else if (wl_is(buf, b, e, "carried")) tk_carried = (if (wl_word(buf, b, e, 1)) tm_hex(buf,
        wl_b, wl_e) else -1) else if (wl_is(buf, b, e, "jump")) rd_jump_to(wl_num(buf,
        b, e, 1), wl_num(buf, b, e, 2)) else if (wl_is(buf, b, e, "goto")) {
        tc_str("jumped 0");
        tc_end();
        pn_dismiss();
        rd_jump_to(wl_num(buf, b, e, 1), wl_num(buf, b, e, 2))
    } else if (wl_is(buf, b, e, "place")) {
        pn_dismiss();
        rd_jump_to(wl_num(buf, b, e, 1), wl_num(buf, b, e, 2))
    } else if (wl_is(buf, b, e, "relayout")) rd_forget() else if (wl_is(buf, b, e,
        "page")) rd_scroll_by(if (wl_num(buf, b, e, 1) == 1) rd_rows_shown - 3 else 3 - rd_rows_shown) else if (wl_is(buf,
        b, e, "selection")) tk_selection(buf, b, e) else if (wl_is(buf, b, e, "hearing")) {
        heard_c = wl_num(buf, b, e, 1);
        heard_v = wl_num(buf, b, e, 2)
    } else if (wl_is(buf, b, e, "follow")) tk_follow(wl_num(buf, b, e, 1), wl_num(buf,
        b, e, 2)) else if (wl_is(buf, b, e, "back")) {
        // (back MS SCREENS WORDS HINT: shown for MS.)
        tk_back_n = wl_get(buf, b, e, 1);
        for k in 0..tk_back_n tk_back[k] = wl_text[k];
        tk_back_until = tm_now() + wl_num(buf, b, e, 1)
    } else if (wl_is(buf, b, e, "wake")) tk_wake_at = wl_num(buf, b, e, 1) else if (wl_is(buf,
        b, e, "tray")) tk_tray = true else if (wl_is(buf, b, e, "tray_away") || wl_is(buf,
        b, e, "clear_selection")) {
        tk_tray = false;
        if (wl_is(buf, b, e, "clear_selection")) {
            sel_c = -1;
            for v in 0..256 sel_v[v] = false
        }
    } else if (wl_is(buf, b, e, "highlighted") || wl_is(buf, b, e, "marked_verse")) rd_reask(sel_c) else if (wl_is(buf,
        b, e, "bookmarked")) {
        rd_reask(sel_c);
        tk_toast_str(if (wl_num(buf, b, e, 1) == 1) "Bookmarked" else "Bookmark Removed")
    } else if (wl_is(buf, b, e, "toast")) {
        _t: int = wl_get(buf, b, e, 1);
        tk_toast_text()
    } else if (wl_is(buf, b, e, "copy") || wl_is(buf, b, e, "share")) {
        _t: int = wl_get(buf, b, e, 1);
        tk_copy();
        tk_toast_str(if (wl_is(buf, b, e, "copy")) "Copied" else "Copied, to share")
    } else if (wl_is(buf, b, e, "savefile")) tk_savefile(buf, b, e) else if (wl_is(buf,
        b, e, "url")) tk_url(buf, b, e) else if (wl_is(buf, b, e, "study_verse")) {
        tk_tray = false;
        tc_str("versestudy ");
        tc_int(wl_num(buf, b, e, 1));
        tc_byte(32);
        tc_int(wl_num(buf, b, e, 2));
        tc_end()
    } else if (wl_is(buf, b, e, "say")) vo_say(buf, b, e) else if (wl_is(buf, b, e,
        "speech_stop")) vo_stop() else if (wl_is(buf, b, e, "audio_play")) {
        _u: int = wl_get(buf, b, e, 1);
        au_play(wl_num(buf, b, e, 1), wl_num(buf, b, e, 3), wl_num(buf, b, e, 4),
            wl_num(buf, b, e, 5))
    } else if (wl_is(buf, b, e, "audio_stop")) au_stop() else if (wl_is(buf, b, e,
        "listen_pause")) {
        au_pause();
        vo_pause()
    } else if (wl_is(buf, b, e, "listen_resume")) {
        au_resume();
        vo_resume()
    } else if (wl_is(buf, b, e, "listen_stop")) {
        au_stop();
        vo_stop();
        tk_player = false
    } else if (wl_is(buf, b, e, "player")) tk_player_line(buf, b, e) else if (wl_is(buf,
        b, e, "timer")) tk_timer_add(wl_num(buf, b, e, 1), wl_num(buf, b, e, 2)) else if (wl_is(buf,
        b, e, "notify_ask")) {
        // (A terminal shows its reminders while the app is open: allowed.)
        tc_str("notifyok ");
        tc_int(wl_num(buf, b, e, 1));
        tc_str(" 1");
        tc_end()
    } else if (wl_is(buf, b, e, "notify_clear")) rm_n = 0 else if (wl_is(buf, b, e,
        "notify")) rm_add(buf, b, e)
}

// A screen whole: the title's menu (screen 0, asked for), or the tray's
// model, or one shown made again.
tk_menu_wanted: bool = false;

tk_screen_done(id: int) {
    tk_dirty = true;
    if (id == 0 && tk_menu_wanted) {
        tk_menu_wanted = false;
        tk_title_menu();
        return
    }
    if (pn_top() == id) pn_update(id)
}

// ---- the look ----
tk_look(buf: []i8, b: int, e: int) {
    lk_spacing = wl_num(buf, b, e, 2);
    lk_margin = wl_num(buf, b, e, 3);
    lk_dark = wl_num(buf, b, e, 4) != 0;
    lk_red = wl_num(buf, b, e, 5) != 0;
    c: int = 0;
    if (wl_word(buf, b, e, 6)) c = tm_hex(buf, wl_b, wl_e);
    if (c >= 0) lk_bg = c;
    if (wl_word(buf, b, e, 7)) lk_ink = tm_hex(buf, wl_b, wl_e);
    if (wl_word(buf, b, e, 8)) lk_heading = tm_hex(buf, wl_b, wl_e);
    if (wl_word(buf, b, e, 9)) lk_faint = tm_hex(buf, wl_b, wl_e);
    if (wl_word(buf, b, e, 10)) lk_accent = tm_hex(buf, wl_b, wl_e);
    if (wl_word(buf, b, e, 11)) lk_rule = tm_hex(buf, wl_b, wl_e);
    rd_forget();
    pn_dirty = true
}

// ---- the bar and the line below ----
tk_title: []i8 = new i8[1024](0i8);

tk_title_n: int = 0;

tk_version: []i8 = new i8[64](0i8);

tk_version_n: int = 0;

tk_carried: int = -1;

// The way back (core's capsule): its words, shown till then.
tk_back: []i8 = new i8[512](0i8);

tk_back_n: int = 0;

tk_back_until: int = 0;

// A toast: its words, shown till then.
tk_toast: []i8 = new i8[1024](0i8);

tk_toast_n: int = 0;

// A persistence failure stays visible for the session, even if later core
// effects produce a success toast for an in-memory operation.
tk_save_warning: str = "";

tk_toast_until: int = 0;

tk_toast_text() {
    tk_toast_n = (if (wl_text_n > len(tk_toast)) len(tk_toast) else wl_text_n);
    for k in 0..tk_toast_n tk_toast[k] = wl_text[k];
    tk_toast_until = tm_now() + 2600
}

tk_toast_str(s: str) {
    wl_text_n = 0;
    for c in s {
        wl_text[wl_text_n] = c;
        wl_text_n = wl_text_n + 1
    }
    tk_toast_text()
}

// Listen's player: its title, its state, whether it plays.
tk_player: bool = false;

tk_player_playing: bool = false;

tk_player_title: []i8 = new i8[256](0i8);

tk_player_title_n: int = 0;

tk_player_state: []i8 = new i8[256](0i8);

tk_player_state_n: int = 0;

tk_player_line(buf: []i8, b: int, e: int) {
    tk_player = true;
    tk_player_title_n = wl_get(buf, b, e, 1);
    for k in 0..tk_player_title_n tk_player_title[k] = wl_text[k];
    tk_player_state_n = wl_get(buf, b, e, 2);
    for k in 0..tk_player_state_n tk_player_state[k] = wl_text[k];
    tk_player_playing = wl_get(buf, b, e, 3) > 0 && wl_text[0] as int != 48
}

// The tray (core's screen 0, while verses are selected).
tk_tray: bool = false;

tk_selection(buf: []i8, b: int, e: int) {
    for v in 0..256 sel_v[v] = false;
    _f: int = wl_get(buf, b, e, 1);
    // (C V V ...: C -1, none.)
    sel_c = -1;
    p: int = 0;
    first: bool = true;
    while (p < wl_text_n) {
        q: int = p;
        while (q < wl_text_n && wl_text[q] as int != 32) q = q + 1;
        if (q > p) {
            n: int = wl_int(wl_text, p, q);
            if (first) sel_c = n else if (n > 0 && n < 256) sel_v[n] = true;
            first = false
        }
        p = q + 1
    }
    if (sel_c < 0) tk_tray = false
}

// Listen's verse followed: the reader moved to it if it isn't on the
// screen.
tk_follow(c: int, v: int) {
    s: int = rd_slot(c);
    if (s >= 0 && v > 0 && v < 256) {
        if (rs_w[s] != rd_width) rd_lay(s);
        l: int = rs_vline[s][v];
        if (l >= 0 && rd_line_visible(c, l, rd_rows_shown - 2) && !(c == rd_topc && l < rd_l)) return
    }
    rd_jump_to(c, v)
}

// ---- timers ----
// Core's wake (a tick at its time), its timers (TOK at their times).
tk_wake_at: int = 0;

tm_tok: []int = new int[64](0);

tm_due: []int = new int[64](0);

tm_count: int = 0;

tk_timer_add(tok: int, ms: int) {
    if (tm_count < len(tm_tok)) {
        tm_tok[tm_count] = tok;
        tm_due[tm_count] = tm_now() + ms;
        tm_count = tm_count + 1
    }
}

// What is due now: told to core. The time till the next (ms).
tk_timers(): int {
    now: int = tm_now();
    next: int = 250;
    if (tk_wake_at > 0) {
        if (now >= tk_wake_at) {
            tk_wake_at = 0;
            tc_str("tick ");
            tc_int(now);
            tc_end()
        } else if (tk_wake_at - now < next) next = tk_wake_at - now
    }
    k: int = 0;
    while (k < tm_count) {
        if (now >= tm_due[k]) {
            tc_str("timer ");
            tc_int(tm_tok[k]);
            tc_end();
            tm_count = tm_count - 1;
            tm_tok[k] = tm_tok[tm_count];
            tm_due[k] = tm_due[tm_count]
        } else {
            if (tm_due[k] - now < next) next = tm_due[k] - now;
            k = k + 1
        }
    }
    if (next < 10) 10 else next
}

// ---- reminders (shown while the app is open) ----
rm_at: []int = new int[64](0);

rm_plan: []int = new int[64](0);

rm_mem: []int = new int[64](0);

rm_words: []i8 = new i8[65536](0i8);

rm_w_at: []int = new int[64](0);

rm_w_n: []int = new int[64](0);

rm_n: int = 0;

rm_words_n: int = 0;

// The reminder shown (-1 none), opened by R.
rm_shown: int = -1;

rm_add(buf: []i8, b: int, e: int) {
    if (rm_n == 0) rm_words_n = 0;
    if (rm_n >= len(rm_at)) return;
    rm_at[rm_n] = wl_num(buf, b, e, 1);
    rm_plan[rm_n] = wl_num(buf, b, e, 2);
    rm_mem[rm_n] = wl_num(buf, b, e, 3);
    rm_w_at[rm_n] = rm_words_n;
    _t: int = wl_get(buf, b, e, 1);
    for k in 0..wl_text_n rm_put(wl_text[k]);
    rm_put(58i8);
    rm_put(32i8);
    _d: int = wl_get(buf, b, e, 2);
    for k in 0..wl_text_n rm_put(if (wl_text[k] as int == 10) 32i8 else wl_text[k]);
    rm_w_n[rm_n] = rm_words_n - rm_w_at[rm_n];
    rm_n = rm_n + 1
}

rm_put(k: i8) {
    if (rm_words_n < len(rm_words)) {
        rm_words[rm_words_n] = k;
        rm_words_n = rm_words_n + 1
    }
}

// The time now (seconds since 1970), from the clock core uses.
rm_check() {
    now: int = time(0);
    for k in 0..rm_n {
        if (rm_at[k] > 0 && now >= rm_at[k]) {
            rm_at[k] = 0;
            rm_shown = k;
            wl_text_n = 0;
            for x in 0..rm_w_n[k] {
                wl_text[wl_text_n] = rm_words[rm_w_at[k] + x];
                wl_text_n = wl_text_n + 1
            }
            tk_toast_text();
            tk_toast_until = tm_now() + 60000;
            // (The terminal's own notification, where it has one, and its
            // bell.)
            tm_str("`]9;");
            for x in 0..wl_text_n tm_byte(wl_text[x] as int);
            tm_byte(7);
            tm_byte(7);
            tm_flush();
            tk_dirty = true
        }
    }
}

rm_open() {
    k: int = rm_shown;
    if (k < 0) return;
    rm_shown = -1;
    tk_toast_until = 0;
    tc_str("reminded ");
    tc_int(rm_plan[k]);
    tc_byte(32);
    tc_int(rm_mem[k]);
    tc_end()
}

// ---- copying, saving, a page outside ----
// Words (wl_text) to the clipboard: the terminal's (OSC 52), and the
// desktop's (wl-copy, xclip) where there is one.
b64: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

tk_copy() {
    tm_str("`]52;c;");
    i: int = 0;
    n: int = wl_text_n;
    while (i < n) {
        a: int = wl_text[i] as int & 255;
        b2: int = if (i + 1 < n) wl_text[i + 1] as int & 255 else 0;
        c: int = if (i + 2 < n) wl_text[i + 2] as int & 255 else 0;
        tm_byte(b64[a / 4] as int);
        tm_byte(b64[a % 4 * 16 + b2 / 16] as int);
        tm_byte(if (i + 1 < n) b64[b2 % 16 * 4 + c / 64] as int else 61);
        tm_byte(if (i + 2 < n) b64[c % 64] as int else 61);
        i = i + 3
    }
    tm_byte(7);
    tm_flush();
    tk_copy_desktop()
}

// (Through a file: the words, then the program given it as its input.)
tk_copy_desktop() {
    path: str = pr_join(tk_kept_dir, tk_kept_dir_n, "clipboard.txt");
    fd: int = open(path, 577, 384);
    if (fd < 0) return;
    try {
        write_bytes_n(fd, wl_text, wl_text_n)
    } with IoError _e -> { }
    close(fd);
    if (pr_getenv("WAYLAND_DISPLAY") > 0) {
        p: str = pr_find("wl-copy");
        if (len(p) > 0) {
            pr_begin("/bin/sh");
            pr_arg("-c");
            pr_arg(tk_shell_with(p, path));
            pr_spawn_away("/bin/sh", "", "")
        }
    } else if (pr_getenv("DISPLAY") > 0) {
        p: str = pr_find("xclip");
        if (len(p) > 0) {
            pr_begin("/bin/sh");
            pr_arg("-c");
            pr_arg(tk_shell_with2(p, path));
            pr_spawn_away("/bin/sh", "", "")
        }
    }
}

// "PROGRAM < FILE" (wl-copy), "PROGRAM -selection clipboard < FILE".
tk_shell_with(p: str, path: str): str@new {
    tk_cat_n = 0;
    tk_cat_str(p);
    tk_cat_str(" < '");
    tk_cat_str(path);
    tk_cat_str("'");
    cstr(tk_cat_bytes())
}

tk_shell_with2(p: str, path: str): str@new {
    tk_cat_n = 0;
    tk_cat_str(p);
    tk_cat_str(" -selection clipboard < '");
    tk_cat_str(path);
    tk_cat_str("'");
    cstr(tk_cat_bytes())
}

tk_cat: []i8 = new i8[8192](0i8);

tk_cat_n: int = 0;

tk_cat_str(s: str) {
    for c in s {
        if (tk_cat_n < len(tk_cat)) {
            tk_cat[tk_cat_n] = c;
            tk_cat_n = tk_cat_n + 1
        }
    }
}

tk_cat_buf(b: []i8, n: int) {
    for i in 0..n {
        if (tk_cat_n < len(tk_cat)) {
            tk_cat[tk_cat_n] = b[i];
            tk_cat_n = tk_cat_n + 1
        }
    }
}

tk_cat_bytes(): []i8@new {
    out: []i8 = new i8[tk_cat_n](0i8);
    for i in 0..tk_cat_n out[i] = tk_cat[i];
    out
}

// The kept files' folder (the platform's), for the skin's own files.
tk_kept_dir: []i8 = new i8[4096](0i8);

tk_kept_dir_n: int = 0;

// savefile NAME CONTENT: in Downloads (else home); its place told.
tk_savefile(buf: []i8, b: int, e: int) {
    name_n: int = wl_get(buf, b, e, 1);
    name: []i8 = tk_name;
    for k in 0..name_n name[k] = wl_text[k];
    tk_cat_n = 0;
    h: int = pr_getenv("HOME");
    if (h > 0) tk_cat_buf(pr_var, h);
    tk_cat_str("/Downloads");
    dir_n: int = tk_cat_n;
    tk_cat_str("/.");
    probe: str = cstr(tk_cat_bytes());
    tk_cat_n = dir_n;
    if (!pr_exists(probe)) {
        tk_cat_n = 0;
        if (h > 0) tk_cat_buf(pr_var, h)
    }
    tk_cat_str("/");
    tk_cat_buf(name, name_n);
    path: str = cstr(tk_cat_bytes());
    _c: int = wl_get(buf, b, e, 2);
    fd: int = open(path, 577, 420);
    if (fd < 0) {
        tk_toast_str("Not saved");
        return
    }
    try {
        write_bytes_n(fd, wl_text, wl_text_n)
    } with IoError _e -> { }
    close(fd);
    wl_text_n = 0;
    for c in "Saved to " {
        wl_text[wl_text_n] = c;
        wl_text_n = wl_text_n + 1
    }
    for k in 0..len(path) {
        wl_text[wl_text_n] = path[k];
        wl_text_n = wl_text_n + 1
    }
    tk_toast_text()
}

tk_name: []i8 = new i8[1024](0i8);

// A page outside the app: opened by the desktop (xdg-open), its address
// shown.
tk_url(buf: []i8, b: int, e: int) {
    _u: int = wl_get(buf, b, e, 1);
    tk_cat_n = 0;
    tk_cat_buf(wl_text, wl_text_n);
    url: str = cstr(tk_cat_bytes());
    p: str = pr_find("xdg-open");
    if (len(p) > 0 && (pr_getenv("DISPLAY") > 0 || pr_getenv("WAYLAND_DISPLAY") > 0)) {
        pr_begin(p);
        pr_arg(url);
        pr_spawn_away(p, "", "")
    }
    tk_toast_text();
    tk_toast_until = tm_now() + 8000
}

// ---- Listen's recordings (ffplay) ----
// The play now: its token, its process, where it ends (centiseconds; -1
// the end), whether paused, its errors' file (where ffplay says the time).
au_tok: int = 0;

au_pid: int = -1;

au_to: int = -1;

au_paused: bool = false;

au_started: int = 0;

au_said_time: bool = false;

au_ffplay: str = "";

au_log: str = "";

au_play(
    tok: int,
    from: int,
    to: int,
    rate1000: int
) {
    au_stop();
    vo_stop();
    au_tok = tok;
    au_to = to;
    au_paused = false;
    au_said_time = false;
    url_n: int = wl_text_n;
    if (len(au_ffplay) == 0 || url_n == 0) {
        tc_str("audiofailed ");
        tc_int(tok);
        tc_end();
        return
    }
    tk_cat_n = 0;
    // (kept:NAME, a chapter core holds: its kept file's path.)
    kept: str = "kept:";
    held: bool = url_n > len(kept);
    for i in 0..len(kept)
        if (held && wl_text[i] != kept[i]) held = false;
    if (held) {
        tk_cat_buf(tk_kept_dir, tk_kept_dir_n);
        tk_cat_str("/");
        for i in len(kept)..url_n {
            if (tk_cat_n < len(tk_cat)) {
                tk_cat[tk_cat_n] = wl_text[i];
                tk_cat_n = tk_cat_n + 1
            }
        }
    } else tk_cat_buf(wl_text, url_n);
    url: str = cstr(tk_cat_bytes());
    tk_cat_n = 0;
    tk_cat_int(from / 100);
    tk_cat_str(".");
    tk_cat_int(from % 100 / 10);
    tk_cat_int(from % 10);
    start: str = cstr(tk_cat_bytes());
    rate: int = if (rate1000 > 0) rate1000 else 1000;
    tk_cat_n = 0;
    tk_cat_str("atempo=");
    tk_cat_int(rate / 1000);
    tk_cat_str(".");
    tk_cat_int(rate % 1000 / 100);
    tk_cat_int(rate % 100 / 10);
    tk_cat_int(rate % 10);
    filter: str = cstr(tk_cat_bytes());
    pr_begin(au_ffplay);
    pr_arg("-nodisp");
    pr_arg("-autoexit");
    pr_arg("-hide_banner");
    pr_arg("-loglevel");
    pr_arg("error");
    pr_arg("-stats");
    if (from > 0) {
        pr_arg("-ss");
        pr_arg(start)
    }
    if (rate != 1000) {
        pr_arg("-af");
        pr_arg(filter)
    }
    pr_arg(url);
    au_pid = pr_spawn(au_ffplay, "", au_log);
    au_started = tm_now();
    if (au_pid < 0) {
        tc_str("audiofailed ");
        tc_int(tok);
        tc_end()
    }
}

tk_cat_int(n: int) {
    if (n >= 10) tk_cat_int(n / 10);
    if (tk_cat_n < len(tk_cat)) {
        tk_cat[tk_cat_n] = (48 + n % 10) trunc i8;
        tk_cat_n = tk_cat_n + 1
    }
}

au_stop() {
    if (au_pid > 0) pr_stop(au_pid);
    au_pid = -1
}

au_pause() {
    if (au_pid > 0 && !au_paused) {
        pr_pause(au_pid);
        au_paused = true
    }
}

au_resume() {
    if (au_pid > 0 && au_paused) {
        pr_resume(au_pid);
        au_paused = false
    }
}

// Where the play is (ffplay's last time on its errors), told to core;
// whether it ended, or failed.
au_check() {
    if (au_pid <= 0) return;
    if (pr_done(au_pid)) {
        au_pid = -1;
        // (Ended: having played; else it couldn't.)
        tc_str(if (au_said_time) "audioended " else "audiofailed ");
        tc_int(au_tok);
        tc_end();
        return
    }
    if (au_paused) return;
    n: int = pr_read(au_log);
    // (The last time: the number before the last "M-A:" or "A-V:".)
    k: int = n - 4;
    found: int = -1;
    while (k > 0 && found < 0) {
        if (pr_buf[k] as int == 77 && pr_buf[k + 1] as int == 45 && pr_buf[k + 2] as int == 65 && pr_buf[k + 3] as int == 58) found = k else k = k - 1
    }
    if (found < 0) return;
    p: int = found - 1;
    while (p > 0 && pr_buf[p] as int == 32) p = p - 1;
    e: int = p + 1;
    while (p > 0 && (pr_buf[p] as int >= 48 && pr_buf[p] as int <= 57 || pr_buf[p] as int == 46)) p = p - 1;
    s: int = p + 1;
    // (Seconds.hundredths: as centiseconds.)
    whole: int = 0;
    frac: int = 0;
    digits: int = 0;
    dot: bool = false;
    for i in s..e {
        d: int = pr_buf[i] as int;
        if (d == 46) dot = true else if (!dot) whole = whole * 10 + d - 48 else if (digits < 2) {
            frac = frac * 10 + d - 48;
            digits = digits + 1
        }
    }
    if (digits == 1) frac = frac * 10;
    cs: int = whole * 100 + frac;
    if (au_to >= 0 && cs >= au_to) {
        au_stop();
        tc_str("audioended ");
        tc_int(au_tok);
        tc_end();
        return
    }
    au_said_time = true;
    tc_str("audiotime ");
    tc_int(au_tok);
    tc_byte(32);
    tc_int(cs);
    tc_str(" 0");
    tc_end()
}

// ---- the computer's voice (spd-say) ----
// What is to be said, in order (C, V, rate, words, voice), the first
// being said now by vo_pid; paused, it is said again from its start.
vo_c: []int = new int[256](0);

vo_v: []int = new int[256](0);

vo_rate: []int = new int[256](0);

vo_w_at: []int = new int[256](0);

vo_w_n: []int = new int[256](0);

vo_voice: []i8 = new i8[256](0i8);

vo_voice_n: int = 0;

vo_words: []i8 = new i8[262144](0i8);

vo_words_n: int = 0;

vo_n: int = 0;

vo_pid: int = -1;

vo_paused: bool = false;

vo_spd: str = "";

vo_say(buf: []i8, b: int, e: int) {
    if (vo_n == 0) vo_words_n = 0;
    if (vo_n >= len(vo_c)) return;
    vo_c[vo_n] = wl_num(buf, b, e, 1);
    vo_v[vo_n] = wl_num(buf, b, e, 2);
    vo_rate[vo_n] = wl_num(buf, b, e, 3);
    _w: int = wl_get(buf, b, e, 1);
    vo_w_at[vo_n] = vo_words_n;
    for k in 0..wl_text_n {
        if (vo_words_n < len(vo_words)) {
            vo_words[vo_words_n] = wl_text[k];
            vo_words_n = vo_words_n + 1
        }
    }
    vo_w_n[vo_n] = vo_words_n - vo_w_at[vo_n];
    vo_voice_n = wl_get(buf, b, e, 2);
    for k in 0..vo_voice_n vo_voice[k] = wl_text[k];
    vo_n = vo_n + 1;
    if (vo_pid < 0 && !vo_paused) vo_next()
}

// The first in the queue said.
vo_next() {
    if (vo_n == 0) return;
    if (len(vo_spd) == 0) {
        // (No voice here: each said at once, as if it had been.)
        tc_str("spoken ");
        tc_int(vo_c[0]);
        tc_byte(32);
        tc_int(vo_v[0]);
        tc_end();
        vo_shift();
        return
    }
    tk_cat_n = 0;
    tk_cat_buf(vo_words_from(0), vo_w_n[0]);
    words: str = cstr(tk_cat_bytes());
    r: int = if (vo_rate[0] > 0) (vo_rate[0] - 1000) / 10 else 0;
    tk_cat_n = 0;
    if (r < 0) {
        tk_cat_str("-");
        tk_cat_int(-r)
    } else tk_cat_int(r);
    rate: str = cstr(tk_cat_bytes());
    pr_begin(vo_spd);
    pr_arg("-w");
    pr_arg("-r");
    pr_arg(rate);
    if (vo_voice_n > 0) {
        tk_cat_n = 0;
        tk_cat_buf(vo_voice, vo_voice_n);
        pr_arg("-y");
        pr_arg(cstr(tk_cat_bytes()))
    }
    pr_arg("--");
    pr_arg(words);
    vo_pid = pr_spawn(vo_spd, "", "");
    tc_str("spoke ");
    tc_int(vo_c[0]);
    tc_byte(32);
    tc_int(vo_v[0]);
    tc_byte(32);
    tc_int(tm_now());
    tc_end()
}

vo_words_from(k: int): []i8 {
    // (Its words moved to the front of tk_cat's source: a copy.)
    for i in 0..vo_w_n[k] vo_one[i] = vo_words[vo_w_at[k] + i];
    vo_one
}

vo_one: []i8 = new i8[65536](0i8);

vo_shift() {
    for k in 1..vo_n {
        vo_c[k - 1] = vo_c[k];
        vo_v[k - 1] = vo_v[k];
        vo_rate[k - 1] = vo_rate[k];
        vo_w_at[k - 1] = vo_w_at[k];
        vo_w_n[k - 1] = vo_w_n[k]
    }
    if (vo_n > 0) vo_n = vo_n - 1
}

vo_check() {
    if (vo_pid <= 0) return;
    if (!pr_done(vo_pid)) return;
    vo_pid = -1;
    if (vo_paused) return;
    if (vo_n > 0) {
        tc_str("spoken ");
        tc_int(vo_c[0]);
        tc_byte(32);
        tc_int(vo_v[0]);
        tc_end();
        vo_shift()
    }
    vo_next()
}

vo_cancel() {
    if (vo_pid > 0) pr_stop(vo_pid);
    vo_pid = -1;
    if (len(vo_spd) > 0) {
        pr_begin(vo_spd);
        pr_arg("-C");
        pr_spawn_away(vo_spd, "", "")
    }
}

vo_pause() {
    if (vo_paused) return;
    vo_paused = true;
    vo_cancel()
}

vo_resume() {
    if (!vo_paused) return;
    vo_paused = false;
    vo_next()
}

vo_stop() {
    vo_n = 0;
    vo_paused = false;
    if (vo_pid > 0) vo_cancel()
}

// The computer's voices told to core (voices Q:LANG:NAME ...): English
// ones without a variant, from spd-say -L.
vo_tell(n: int) {
    tc_str("voices");
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && pr_buf[e] as int != 10) e = e + 1;
        // NAME LANGUAGE VARIANT, right-aligned columns: the last two words
        // are its language and variant; its name what is before.
        w2e: int = e;
        while (w2e > p && pr_buf[w2e - 1] as int == 32) w2e = w2e - 1;
        w2b: int = w2e;
        while (w2b > p && pr_buf[w2b - 1] as int != 32) w2b = w2b - 1;
        w1e: int = w2b;
        while (w1e > p && pr_buf[w1e - 1] as int == 32) w1e = w1e - 1;
        w1b: int = w1e;
        while (w1b > p && pr_buf[w1b - 1] as int != 32) w1b = w1b - 1;
        ne: int = w1b;
        while (ne > p && pr_buf[ne - 1] as int == 32) ne = ne - 1;
        nb: int = p;
        while (nb < ne && pr_buf[nb] as int == 32) nb = nb + 1;
        none: bool = w2e - w2b == 4 && pr_buf[w2b] as int == 110 && pr_buf[w2b + 1] as int == 111;
        en: bool = w1e - w1b >= 2 && pr_buf[w1b] as int == 101 && pr_buf[w1b + 1] as int == 110;
        if (none && en && ne > nb) {
            tc_str("\t1:");
            for i in w1b..w1e tc_byte(pr_buf[i] as int);
            tc_byte(58);
            for i in nb..ne tc_byte(pr_buf[i] as int)
        }
        p = e + 1
    }
    tc_end()
}

// ---- the title's menu (core's screen 0, asked for: titlemenu) ----
tk_title_menu() {
    s: int = sc_slot(0);
    if (s < 0) return;
    saved_slot: int = pm_slot;
    saved_id: int = pm_id;
    pm_read(0);
    mn_begin("");
    for i in 0..pm_rows {
        a: int = rf_num(i, 2);
        if (a != 0) {
            _t: int = rf(i, 4);
            n: int = wl_text_n;
            if (rf(i, 5) > 0) {
                // (Its detail after it.)
                d: int = wl_text_n;
                for k in 0..d tm_scratch[k] = wl_text[k];
                _t2: int = rf(i, 4);
                wl_text[wl_text_n] = 32i8;
                wl_text[wl_text_n + 1] = 32i8;
                for k in 0..d wl_text[wl_text_n + 2 + k] = tm_scratch[k];
                wl_text_n = wl_text_n + 2 + d
            }
            _n: int = n;
            mn_item_text();
            mn_say("menuact ");
            mn_say_int(a);
            mn_say(" ");
            _g: int = rf(i, 3);
            mn_say_bytes(wl_text, wl_text_n)
        }
    }
    mn_show();
    // (The panel's own screen read again.)
    if (saved_id >= 0 && pn_depth > 0) pm_read(saved_id);
    _s: int = saved_slot
}

tm_scratch: []i8 = new i8[65536](0i8);

// ---- drawing ----
tk_help: bool = false;

tk_draw() {
    _r: bool = tm_size();
    rows: int = tm_rows;
    cols: int = tm_cols;
    tm_clear(lk_bg, lk_ink);
    // The panel: beside the reader (wide), else over it.
    wide: bool = cols >= 110;
    panel: bool = pn_depth > 0;
    reader_w: int = if (panel && wide) cols - 50 else cols;
    tray_rows: int = if (tk_tray && sel_c >= 0) 4 else 0;
    rd_rows_shown = rows - 2 - tray_rows;
    if (!(panel && !wide)) rd_draw(1, rows - 1 - tray_rows, 0, reader_w);
    tk_draw_bar(reader_w);
    if (panel) {
        pn_x = (if (wide) cols - 49 else 0);
        pn_w = (if (wide) 49 else cols);
        pn_r0 = (if (wide) 0 else 0);
        pn_r1 = rows - 1;
        pn_draw()
    }
    if (tray_rows > 0) tk_draw_tray(rows - 1 - tray_rows, reader_w);
    tk_draw_status(rows - 1);
    if (mn_on) tk_draw_menu();
    if (tk_help) tk_draw_help();
    tm_show();
    tk_dirty = false
}

tk_draw_bar(w: int) {
    bg: int = lk_bg;
    x: int = 2;
    if (tk_carried >= 0) {
        x = x + tm_put(0, x, 9614, tk_carried, bg, 0);
        x = x + 1
    }
    x = x + tm_bytes(0, x, tk_title, 0, tk_title_n, w - 20, lk_ink, bg, TA_BOLD);
    // (The version, and the keys' help.)
    vw: int = tm_cols_of(tk_version, 0, tk_version_n);
    vx: int = w - 10 - vw;
    if (vx > x + 2) {
        _v: int = tm_bytes(0, vx, tk_version, 0, tk_version_n, vw, lk_accent, bg,
            TA_BOLD);
        _h: int = tm_text(0, w - 8, "? keys", lk_faint, bg, 0)
    }
    // (A rule under the bar.)
    _r: int = 0
}

tk_draw_status(row: int) {
    bg: int = tm_mix(lk_ink, lk_bg, if (lk_dark) 60 else 40);
    for x in 0..tm_cols _p: int = tm_put(row, x, 32, lk_faint, bg, 0);
    now: int = tm_now();
    x: int = 1;
    if (len(tk_save_warning) > 0) {
        _warning: int = tm_text(row, x, tk_save_warning, lk_ink, bg, TA_BOLD);
        return
    }
    if (now < tk_toast_until && tk_toast_n > 0) {
        x = x + tm_put(row, x, 10022, lk_accent, bg, 0) + 1;
        _t: int = tm_bytes(row, x, tk_toast, 0, tk_toast_n, tm_cols - x - 2, lk_ink,
            bg, TA_BOLD);
        if (rm_shown >= 0) _r: int = tm_text(row, tm_cols - 16, "R open \¬\∑ Esc",
            lk_faint, bg, 0);
        return
    }
    if (tk_player) {
        x = x + tm_put(row, x, if (tk_player_playing) 9654 else 10074, lk_accent,
            bg, 0) + 1;
        x = x + tm_bytes(row, x, tk_player_title, 0, tk_player_title_n, 30, lk_ink,
            bg, TA_BOLD) + 2;
        x = x + tm_bytes(row, x, tk_player_state, 0, tk_player_state_n, 40, lk_faint,
            bg, 0) + 3;
        _k: int = tm_text(row, x, if (tk_player_playing) "p pause \¬\∑ < > chapters \¬\∑ L stop" else "p play \¬\∑ < > chapters \¬\∑ L stop",
            lk_faint, bg, 0);
        return
    }
    if (now < tk_back_until && tk_back_n > 0) {
        x = x + tm_text(row, x, "\‚\å\´ ", lk_accent, bg, 0);
        x = x + tm_bytes(row, x, tk_back, 0, tk_back_n, 40, lk_accent, bg, TA_BOLD) + 3
    }
    hint: str = if (pn_depth > 0) "\‚\Ü\ë\‚\Ü\ì move \¬\∑ Enter choose \¬\∑ \‚\Ü\ê \‚\Ü\í change \¬\∑ Esc back" else "g Go To \¬\∑ / Search \¬\∑ v Version \¬\∑ l Library \¬\∑ a Settings \¬\∑ h History \¬\∑ m Menu \¬\∑ L Listen \¬\∑ q Quit";
    _h: int = tm_text(row, x, hint, lk_faint, bg, 0)
}

// The tray: its reference, its colors (1 to 5, 0 none), its actions with
// their keys.
tk_draw_tray(r0: int, w: int) {
    s: int = sc_slot(0);
    if (s < 0) return;
    saved: int = pm_id;
    pm_read(0);
    bg: int = tm_mix(lk_ink, lk_bg, if (lk_dark) 90 else 50);
    for r in r0..r0 + 4 {
        for x in 0..w _p: int = tm_put(r, x, 32, lk_ink, bg, 0)
    }
    _t: int = wl_get(pm_raw(), pm_screen_b, pm_screen_e, 1);
    x: int = 2;
    x = x + tm_bytes(r0, x, wl_text, 0, wl_text_n, w - 4, lk_ink, bg, TA_BOLD);
    _e: int = tm_text(r0, w - 12, "Esc clear", lk_faint, bg, 0);
    x = 2;
    for i in 0..pm_rows {
        if (rf_num(i, 16) == 6) {
            n: int = pn_option_count(pm_raw(), pm_row_b[i], pm_row_e[i], 10);
            v: int = rf_num(i, 9);
            for k in 0..n {
                pn_option(pm_raw(), pm_row_b[i], pm_row_e[i], 10, k);
                hex: int = tm_hex(wl_text, 0, wl_text_n);
                x = x + tm_put(r0 + 1, x, 49 + k, lk_faint, bg, 0);
                x = x + tm_put(r0 + 1, x, if (hex < 0) 10005 else if (k == v) 9673 else 9679,
                    if (hex >= 0) hex else lk_faint, bg, 0) + 2
            }
        }
    }
    x = 2;
    for i in 0..pm_rows {
        a: int = rf_num(i, 2);
        key: int = tk_tray_key(a);
        if (key > 0) {
            off: bool = rf_flag(i, 100);
            on: bool = rf_flag(i, 116);
            x = x + tm_put(r0 + 2, x, key, if (off) lk_faint else lk_accent, bg, TA_BOLD) + 1;
            _w: int = rf(i, 4);
            x = x + tm_bytes(r0 + 2, x, wl_text, 0, wl_text_n, 20, if (off) lk_faint else if (on) lk_accent else lk_ink,
                bg, 0) + 3
        }
    }
    if (saved >= 0 && pn_depth > 0) pm_read(saved)
}

// The tray's actions' keys (core/tray.l8's ACT_TRAY_).
tk_tray_key(a: int): int {
    if (a == 131) 99 else if (a == 132) 115 else if (a == 133) 98 else if (a == 134) 110 else if (a == 135) 116 else if (a == 136) 111 else if (a == 137) 77 else 0
}

tk_draw_menu() {
    w: int = 10;
    for k in 0..mn_n {
        cw: int = tm_cols_of(mn_words, mn_w_at[k], mn_w_at[k] + mn_w_n[k]) + 6;
        if (cw > w) w = cw
    }
    if (w > tm_cols - 4) w = tm_cols - 4;
    h: int = mn_n + 2;
    x0: int = (tm_cols - w) / 2;
    y0: int = (tm_rows - h) / 2;
    bg: int = tm_mix(lk_ink, lk_bg, if (lk_dark) 140 else 70);
    tm_box(y0, x0, h, w, tm_mix(lk_faint, bg, 700), bg);
    for k in 0..mn_n {
        f: bool = k == mn_focus;
        rbg: int = if (f) lk_accent else bg;
        for x in x0 + 1..x0 + w - 1 _q: int = tm_put(y0 + 1 + k, x, 32, lk_ink, rbg,
            0);
        _w: int = tm_bytes(y0 + 1 + k, x0 + 3, mn_words, mn_w_at[k], mn_w_at[k] + mn_w_n[k],
            w - 6, if (f) lk_bg else lk_ink, rbg, if (f) TA_BOLD else 0)
    }
}

help_lines: []str = ["Reading", "  \‚\Ü\ë \‚\Ü\ì  j k        a line          Space PgDn  a page down",
    "  PgUp  b         a page up        ] [  next, previous chapter", "  \‚\Ü\í \‚\Ü\ê            the verse cursor  Enter x  select the verse",
    "  Tab            links on the screen (Enter opens one)", "  \‚\å\´              back (after a jump)",
    "", "Going", "  g  Go To       /  Search       v  Version      h  History", "  l  Library     a  Settings     m  The title's menu (ribbons)",
    "", "With verses selected", "  1-5  highlight   0  none   c Copy   s Share   b Bookmark",
    "  n Note   t Study   o Compare   M Memorize   Esc  let go", "", "Listening",
    "  L  Listen, or stop   p  pause, play   < >  previous, next chapter", "", "In a screen",
    "  \‚\Ü\ë \‚\Ü\ì  move     Enter  choose     \‚\Ü\ê \‚\Ü\í  change a setting, or a row's menu",
    "  type  into its field     Esc  back", "", "  q  quit     ?  this help"];

tk_draw_help() {
    w: int = 74;
    if (w > tm_cols - 2) w = tm_cols - 2;
    h: int = len(help_lines) + 2;
    if (h > tm_rows - 2) h = tm_rows - 2;
    x0: int = (tm_cols - w) / 2;
    y0: int = (tm_rows - h) / 2;
    bg: int = tm_mix(lk_ink, lk_bg, if (lk_dark) 110 else 60);
    tm_box(y0, x0, h, w, tm_mix(lk_faint, bg, 700), bg);
    for k in 0..h - 2 {
        line: str = help_lines[k];
        heading: bool = len(line) > 0 && line[0] as int != 32;
        _w: int = tm_text(y0 + 1 + k, x0 + 2, line, if (heading) lk_accent else lk_ink,
            bg, if (heading) TA_BOLD else 0)
    }
}

// ---- keys ----
tk_quit: bool = false;

tk_key(
    code: int,
    mods: int,
    row: int,
    col: int
) {
    tk_dirty = true;
    if (code == TK_BACKGROUND) return;
    if (tk_help) {
        tk_help = false;
        return
    }
    if (mn_on) {
        tk_menu_key(code, row, col);
        return
    }
    if (code == 99 && mods == TM_CTRL) {
        tk_quit = true;
        return
    }
    // (A reminder shown: R opens it.)
    if (rm_shown >= 0 && code == 82) {
        rm_open();
        return
    }
    if (code == TK_CLICK || code == TK_WHEEL_UP || code == TK_WHEEL_DOWN || code == TK_RIGHT_CLICK) {
        tk_mouse(code, row, col);
        return
    }
    if (pn_depth > 0) {
        tk_panel_key(code, mods);
        return
    }
    if (tk_tray && sel_c >= 0 && tk_tray_key_do(code)) return;
    tk_reader_key(code, mods)
}

tk_core_key(name: str, mods: int) {
    tc_str("key ");
    tc_str(name);
    tc_byte(32);
    tc_int(mods);
    tc_end()
}

tk_tap(what: str) {
    tc_str("tap ");
    tc_str(what);
    tc_end()
}

tk_reader_key(code: int, mods: int) {
    page: int = rd_rows_shown - 3;
    if (code == 113) tk_quit = true else if (code == 63) tk_help = true else if (code == TK_DOWN || code == 106) rd_scroll_by(1) else if (code == TK_UP || code == 107) rd_scroll_by(-1) else if (code == TK_PGDN || code == 32 || code == 100 && mods == TM_CTRL) rd_scroll_by(page) else if (code == TK_PGUP || code == 98 || code == 117 && mods == TM_CTRL) rd_scroll_by(-page) else if (code == 93) tk_core_key("]",
        1) else if (code == 91) tk_core_key("[", 1) else if (code == 103 || code == 108 && mods == TM_CTRL) tk_core_key("l",
        1) else if (code == 47) tk_core_key("f", 1) else if (code == 118) tk_tap("versions") else if (code == 108) tk_core_key("b",
        3) else if (code == 97 || code == 44) tk_core_key(",", 1) else if (code == 104) tk_tap("history") else if (code == 76) tk_core_key("p",
        3) else if (code == 112) {
        if (tk_player) {
            tc_str(if (tk_player_playing) "listenpause" else "listenplay");
            tc_end()
        }
    } else if (code == 62 && tk_player) {
        tc_str("listennext");
        tc_end()
    } else if (code == 60 && tk_player) {
        tc_str("listenprev");
        tc_end()
    } else if (code == 109) {
        tk_menu_wanted = true;
        tc_str("titlemenu");
        tc_end()
    } else if (code == TK_BACKSPACE) {
        if (tm_now() < tk_back_until) {
            tk_back_until = 0;
            tc_str("back");
            tc_end()
        }
    } else if (code == TK_RIGHT) rd_cursor(1) else if (code == TK_LEFT) rd_cursor(-1) else if (code == TK_TAB) rd_next_link(1) else if (code == TK_BACKTAB) rd_next_link(-1) else if (code == TK_ENTER || code == 120) {
        if (code == TK_ENTER && rd_open_cur_link()) { } else if (cur_c >= 0) {
            tc_str("tapverse ");
            tc_int(cur_c);
            tc_byte(32);
            tc_int(cur_v);
            tc_end()
        }
    } else if (code == TK_ESC) {
        if (rm_shown >= 0) {
            rm_shown = -1;
            tk_toast_until = 0
        } else if (cur_link_c >= 0) {
            cur_link_c = -1;
            cur_link = -1
        } else if (cur_c >= 0) cur_c = -1 else {
            tc_str("tapnone");
            tc_end()
        }
    }
}

// With verses selected: a color, an action.
tk_tray_key_do(code: int): bool {
    if (code >= 49 && code <= 53 || code == 48) {
        tc_str("trayact 130 ");
        tc_int(if (code == 48) 5 else code - 49);
        tc_end();
        return true
    }
    a: int = if (code == 99) 131 else if (code == 115) 132 else if (code == 98) 133 else if (code == 110) 134 else if (code == 116) 135 else if (code == 111) 136 else if (code == 77) 137 else 0;
    if (a != 0) {
        tc_str("trayact ");
        tc_int(a);
        tc_str(" 0");
        tc_end();
        return true
    }
    if (code == TK_ESC) {
        tc_str("tapnone");
        tc_end();
        return true
    }
    false
}

tk_panel_key(code: int, mods: int) {
    typing: bool = pn_typing_id == pm_id && (pn_typing_row >= 0 || pn_has_search());
    if (code == TK_ESC) {
        if (pn_typing_row >= 0) {
            pn_commit_field();
            pn_dirty = true
        } else pn_back();
        return
    }
    if (code == TK_UP) {
        if (!pn_move_grid(-1)) pn_move(-1);
        return
    }
    if (code == TK_DOWN) {
        if (!pn_move_grid(1)) pn_move(1);
        return
    }
    if (code == TK_TAB) {
        pn_move(1);
        return
    }
    if (code == TK_BACKTAB) {
        pn_move(-1);
        return
    }
    if (code == TK_PGDN) {
        pn_move(pn_body_rows() / 2);
        return
    }
    if (code == TK_PGUP) {
        pn_move(-pn_body_rows() / 2);
        return
    }
    f: int = pn_focus;
    fk: int = if (f < fi_n) fi_kind[f] else 0;
    if (code == TK_LEFT || code == TK_RIGHT) {
        d: int = if (code == TK_LEFT) -1 else 1;
        if (fk == FI_CELL || fk == FI_LINK || fk == FI_TOOL || pm_grid && fk == FI_ROW) pn_move(d) else pn_do(f,
            d);
        return
    }
    if (code == TK_ENTER) {
        // (A note's field: Return a new line.)
        if (pn_typing_row >= 0 && pn_typing_row < pm_rows && pn_prose(pn_typing_row)) {
            pn_type(10);
            return
        }
        if (pn_typing_row >= 0 && fk != FI_ROW) {
            pn_commit_field();
            return
        }
        // (Typed in the search field, and not moved since: submitted.)
        if (typing && pn_typing_row < 0 && (fk == FI_FIELD || pn_ftext_n > 0 && !pn_moved)) pn_do(pn_item_of(FI_FIELD),
            0) else pn_do(f, 0);
        return
    }
    if (code == TK_BACKSPACE) {
        if (typing && pn_ftext_n > 0) pn_type(8) else if (!typing) pn_back();
        return
    }
    if (code == TK_PASTE && typing) {
        p: int = 0;
        while (p < tk_paste_n) {
            u: int = tm_cp_at(tk_paste, p, tk_paste_n);
            p = p + tm_cp_len;
            pn_type(u)
        }
        return
    }
    // Practice's typed letters (keys ACTION).
    if (pm_keys > 0 && code > 32 && mods == 0) {
        pn_act(pm_keys, code, 0);
        return
    }
    if (typing && code >= 32 && mods != TM_CTRL) {
        pn_type(code);
        return
    }
    if (code == 113 && !typing) {
        pn_back();
        return
    }
    // (Practice's own keys: Return, the grades: core's key commands.)
    if (code >= 49 && code <= 51 && !typing) {
        tc_str("key ");
        tc_byte(code);
        tc_str(" 1");
        tc_end();
        return
    }
    if (code == 63) tk_help = true
}

tk_menu_key(code: int, row: int, col: int) {
    if (code == TK_UP && mn_focus > 0) mn_focus = mn_focus - 1 else if (code == TK_DOWN && mn_focus + 1 < mn_n) mn_focus = mn_focus + 1 else if (code == TK_ENTER) mn_choose(mn_focus) else if (code == TK_ESC || code == 113) mn_on = false else if (code == TK_CLICK) {
        h: int = mn_n + 2;
        y0: int = (tm_rows - h) / 2;
        k: int = row - y0 - 1;
        if (k >= 0 && k < mn_n) mn_choose(k) else mn_on = false
    }
}

tk_mouse(code: int, row: int, col: int) {
    in_panel: bool = pn_depth > 0 && col >= pn_x && row >= pn_r0 && row < pn_r1;
    if (code == TK_WHEEL_UP || code == TK_WHEEL_DOWN) {
        d: int = if (code == TK_WHEEL_UP) -3 else 3;
        if (in_panel) {
            pn_scroll = pn_scroll + d;
            if (pn_scroll > pv_lines - 2) pn_scroll = pv_lines - 2;
            if (pn_scroll < 0) pn_scroll = 0;
            pn_dirty = false
        } else if (pn_depth == 0 || col < pn_x) rd_scroll_by(d);
        return
    }
    if (in_panel) {
        pn_click(row, col);
        return
    }
    if (row == tm_rows - 1) {
        // (The line below: the way back, else nothing.)
        if (tm_now() < tk_back_until) {
            tk_back_until = 0;
            tc_str("back");
            tc_end()
        }
        return
    }
    if (row == 0) {
        // (The bar: the title Go To, the version Versions.)
        if (col < tm_cols / 2) tk_core_key("l", 1) else tk_tap("versions");
        return
    }
    tray_r0: int = tm_rows - 1 - (if (tk_tray && sel_c >= 0) 4 else 0);
    if (tk_tray && sel_c >= 0 && row >= tray_r0) {
        tk_tray_click(row - tray_r0, col);
        return
    }
    if (pn_depth > 0 && tm_cols < 110) return;
    cur_link_c = -1;
    rd_click(row, col)
}

// A click on the tray: a color, or an action, by where it fell.
tk_tray_click(r: int, col: int) {
    if (r == 1) {
        k: int = (col - 2) / 4;
        if (k >= 0 && k <= 5) {
            tc_str("trayact 130 ");
            tc_int(k);
            tc_end()
        }
        return
    }
    if (r != 2) return;
    s: int = sc_slot(0);
    if (s < 0) return;
    saved: int = pm_id;
    pm_read(0);
    x: int = 2;
    for i in 0..pm_rows {
        a: int = rf_num(i, 2);
        if (tk_tray_key(a) > 0) {
            _w: int = rf(i, 4);
            w: int = 2 + tm_cols_of(wl_text, 0, wl_text_n) + 3;
            if (col >= x && col < x + w - 2) {
                tc_str("trayact ");
                tc_int(a);
                tc_str(" 0");
                tc_end()
            }
            x = x + w
        }
    }
    if (saved >= 0 && pn_depth > 0) pm_read(saved)
}
