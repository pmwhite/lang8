tag bible_tui;

use_tag std, bible;

// A line of core's wire (SKINS.md): its fields split by tabs (each with
// \t, \n and \\ escaped), the first field's words split by spaces. A line
// is bytes b to e of a buffer; a word or field found is wl_b to wl_e of it.
wl_b: int = 0;

wl_e: int = 0;

// Word i of the first field.
wl_word(
    buf: []i8,
    b: int,
    e: int,
    i: int
): bool {
    f: int = b;
    while (f < e && buf[f] as int != 9) f = f + 1;
    p: int = b;
    k: int = 0;
    while (k < i && p < f) {
        while (p < f && buf[p] as int != 32) p = p + 1;
        if (p < f) p = p + 1;
        k = k + 1
    }
    q: int = p;
    while (q < f && buf[q] as int != 32) q = q + 1;
    wl_b = p;
    wl_e = q;
    p < f || i == 0
}

wl_num(
    buf: []i8,
    b: int,
    e: int,
    i: int
): int {
    if (!wl_word(buf, b, e, i)) return 0;
    wl_int(buf, wl_b, wl_e)
}

wl_int(buf: []i8, b: int, e: int): int {
    p: int = b;
    neg: bool = p < e && buf[p] as int == 45;
    if (neg) p = p + 1;
    n: int = 0;
    while (p < e && buf[p] as int >= 48 && buf[p] as int <= 57) {
        n = n * 10 + buf[p] as int - 48;
        p = p + 1
    }
    if (neg) -n else n
}

// Whether word 0 is w.
wl_is(
    buf: []i8,
    b: int,
    e: int,
    w: str
): bool {
    if (e - b < len(w)) return false;
    for i in 0..len(w)
        if (buf[b + i] != w[i]) return false;
    e - b == len(w) || buf[b + len(w)] as int == 32 || buf[b + len(w)] as int == 9
}

// Field i (0: the words), still escaped.
wl_field(
    buf: []i8,
    b: int,
    e: int,
    i: int
): bool {
    p: int = b;
    k: int = 0;
    while (k < i && p < e) {
        while (p < e && buf[p] as int != 9) p = p + 1;
        if (p < e) p = p + 1 else k = i + 1;
        k = k + 1
    }
    if (k > i) {
        wl_b = e;
        wl_e = e;
        return false
    }
    q: int = p;
    while (q < e && buf[q] as int != 9) q = q + 1;
    wl_b = p;
    wl_e = q;
    true
}

wl_field_num(
    buf: []i8,
    b: int,
    e: int,
    i: int
): int {
    if (!wl_field(buf, b, e, i)) return 0;
    wl_int(buf, wl_b, wl_e)
}

// Bytes b to e of buf, their escapes undone, into out from at: the end.
wl_unescape(
    buf: []i8,
    b: int,
    e: int,
    out: []i8,
    at: int
): int {
    n: int = at;
    p: int = b;
    while (p < e) {
        k: int = buf[p] as int;
        if (k == 92 && p + 1 < e) {
            x: int = buf[p + 1] as int;
            k = (if (x == 110) 10 else if (x == 116) 9 else x);
            p = p + 2
        } else p = p + 1;
        if (n < len(out)) {
            out[n] = k trunc i8;
            n = n + 1
        }
    }
    n
}

// A field unescaped into the shared word buffer (wl_text, wl_text_n).
wl_text: []i8 = new i8[262144](0i8);

wl_text_n: int = 0;

wl_get(
    buf: []i8,
    b: int,
    e: int,
    i: int
): int {
    wl_text_n = 0;
    if (wl_field(buf, b, e, i)) wl_text_n = wl_unescape(buf, wl_b, wl_e, wl_text,
        0);
    wl_text_n
}

// ---- lines to core ----
// What the skin says, gathered and given to core's host in the loop.
to_core: []i8 = new i8[1048576](0i8);

to_core_n: int = 0;

tc_byte(k: int) {
    if (to_core_n < len(to_core)) {
        to_core[to_core_n] = k trunc i8;
        to_core_n = to_core_n + 1
    }
}

tc_str(s: str) {
    for c in s tc_byte(c as int)
}

tc_int(n: int) {
    if (n < 0) {
        tc_byte(45);
        tc_int(-n);
        return
    }
    if (n >= 10) tc_int(n / 10);
    tc_byte(48 + n % 10)
}

// Bytes, escaped as a field.
tc_bytes(b: []i8, from: int, to: int) {
    for i in from..to {
        k: int = b[i] as int;
        if (k == 92) tc_str("\\\\") else if (k == 10) tc_str("\\n") else if (k == 9) tc_str("\\t") else tc_byte(k)
    }
}

tc_end() {
    tc_byte(10)
}
