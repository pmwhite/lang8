tag bible_tui;

use_tag std, bible;

// The reader (SKINS.md, "Panes"), made twice: the page (pane 0) and the
// panel's reader (pane 1, drawn in the panel where core's screen says
// `reader`). Each is a ReaderPane: a window of the parts near what it
// shows, as core sent them (`part P C K N` and its lines to `end`), each
// laid out for the pane's column (paragraphs wrapped, poetry indented,
// headings and a chapter's number centered, verse numbers and footnote
// marks raised) and drawn in the theme's colors (on the page: highlights,
// the selection, the verse heard and the keys' cursor washed over their
// verses). It asks for the parts near what it shows (`want`) as it draws.
//
// Its unit is a terminal line. A pane's place is its reading line, the
// row core's `line P THOUSANDTHS` names: the part and line shown there. A
// part coming above it doesn't move it. What crosses to core is in the
// document's terms (SKINS.md, Places): where it is read, `at P C I FRAC`
// (a chapter, an anchor, thousandths through the anchor's span), as the
// anchor there changes and at rest; where core says it goes, `go P C I
// FRAC MODE`, gone to at once (a terminal has no glide) once the part is
// here and laid out. It moves by a key or the mouse (a hand: `moving`)
// or as core says; RP_REST_MS after it last moved it is at rest (`rest`):
// a key held down repeats faster than that.
//
// Linked, the pane a hand last moved leads, and the other follows each of
// its moves by the chapter's link map (core's `link C MODE`), placed by
// core/follow.l8's rules from both panes' anchors as laid out, in rows
// down from each one's reading line.
import "term.l8";

import "wire.l8";

// ---- the look (core's look line) ----
lk_bg: int = 1776152;

lk_ink: int = 15131095;

lk_heading: int = 12432042;

lk_faint: int = 9209210;

lk_accent: int = 14452851;

lk_rule: int = 16777215;

lk_dark: bool = true;

lk_red: bool = false;

lk_font: int = 0;

// The margins (core's points: 20, 28, 40) as the column's width, the line
// spacing (thousandths: relaxed, 1480) as a line between paragraphs.
lk_margin: int = 28;

lk_spacing: int = 1320;

// How many chapters the Bible has (core's `reader N`): each pane's.
rp_chapters: int = 1189;

// ---- a part, as core sent it ----
// Part k of chapter c of a pane's document, of parts (0: not known yet, a
// commentary still opening); for a commentary's run of chapters it says
// nothing on, the run's last (c to gap_to; -1: not one), all shown as this
// one part. Whether it only holds its place until it has been read
// (`coming`: sent again then), and whether it is to be asked for again
// (`forget`: shown until it comes). Its words (UTF-8) and, in UTF-16
// places of them: its spans' styles and paragraph kinds; its anchors (its
// `verse` lines, in order, each with its index among its chapter's
// anchors, -1 if it isn't one); its links; the highlights on its verses
// (marks); and every anchor of its chapter with the part it is in.
type ReaderPart = {
    c: int;
    k: int;
    parts: int;
    gap_to: int;
    coming: bool;
    stale: bool;
    text: []i8;
    span_from: []int;
    span_to: []int;
    span_style: []int;
    span_para: []int;
    verse_number: []int;
    verse_from: []int;
    verse_to: []int;
    verse_anchor: []int;
    link_from: []int;
    link_to: []int;
    link_kind: []int;
    link_arg: []int;
    mark_verse: []int;
    mark_color: []int;
    anchor_verse: []int;
    anchor_part: []int
}

// A link's kinds (core's `link A B KIND ARG`).
LINK_FOOTNOTE: int = 0;

LINK_REFERENCE: int = 1;

LINK_WORD: int = 2;

LINK_ESV: int = 3;

// The lines being gathered (the first, `part` or `link`, first), until
// their `end`: a buffer of its own, made larger when a longer part comes.
type PartLines = {
    bytes: []i8;
    count: int
}

RP_GATHER_ROOM: int = 65536;

rp_part_lines_made(room: int): owned *PartLines {
    own {
        new PartLines { bytes: new i8[room](0i8), count: 0 }
    }
}

rp_gathered: ?owned *PartLines = rp_part_lines_made(RP_GATHER_ROOM);

// What core's lines are until the next `end`: its own (a screen's, read
// by the skin), a part's, or a chapter's link map.
type Gathering =
    | NotGathering
    | GatheringPart
    | GatheringLinks

rp_gathering: Gathering = Gathering.NotGathering;

// Whether core's lines are the reader's until the next `end`.
rp_gathering_lines(): bool {
    match rp_gathering {
        NotGathering -> false;
        _ -> true
    }
}

// `part P C K N` TEXT: a part begun.
rp_part_begin(buf: []i8, b: int, e: int) {
    rp_gather_begin(buf, b, e);
    rp_gathering = Gathering.GatheringPart
}

// `link C MODE`: a chapter's link map begun.
rp_links_begin(buf: []i8, b: int, e: int) {
    rp_gather_begin(buf, b, e);
    rp_gathering = Gathering.GatheringLinks
}

rp_gather_begin(buf: []i8, b: int, e: int) {
    borrow rp_gathered as lines {
        lines.count = 0
    }
    rp_gather_add(buf, b, e)
}

// A line of what is being gathered; at its `end`, the part made and given
// to its pane, or the link map kept.
rp_gathered_line(buf: []i8, b: int, e: int) {
    if (!wl_is(buf, b, e, "end")) {
        rp_gather_add(buf, b, e);
        return
    }
    was: Gathering = rp_gathering;
    rp_gathering = Gathering.NotGathering;
    match was {
        GatheringPart -> {
            p: int = -1;
            borrow rp_gathered as lines {
                p = wl_num(lines.bytes, 0, rp_first_line_end(lines), 1)
            }
            if (p >= 0 && p < PANES) rp_take_part(reader_pane(p), rp_gathered_part())
        }
        GatheringLinks -> rp_take_link_map();
        NotGathering -> { }
    }
}

rp_first_line_end(lines: *PartLines): int {
    e: int = 0;
    while (e < lines.count && lines.bytes[e] as int != 10) e = e + 1;
    e
}

rp_gather_add(buf: []i8, b: int, e: int) {
    need: int = e - b + 1;
    fits: bool = true;
    borrow rp_gathered as lines {
        fits = lines.count + need <= len(lines.bytes)
    }
    if (!fits) {
        grown: owned *PartLines = rp_part_lines_grown(need);
        drop rp_gathered;
        rp_gathered = move grown
    }
    borrow rp_gathered as lines {
        n: int = lines.count;
        for i in b..e lines.bytes[n + i - b] = buf[i];
        lines.bytes[n + e - b] = 10i8;
        lines.count = n + need
    }
}

// A larger buffer, with room for need more, holding what is gathered so
// far.
rp_part_lines_grown(need: int): owned *PartLines {
    own {
        count: int = 0;
        borrow rp_gathered as old {
            count = old.count
        }
        room: int = RP_GATHER_ROOM;
        while (room < count + need) room = room * 2;
        grown: *PartLines = new PartLines { bytes: new i8[room](0i8), count: count };
        borrow rp_gathered as old {
            for i in 0..count grown.bytes[i] = old.bytes[i]
        }
        grown
    }
}

// The part gathered (rp_gathered) as a part of its own.
rp_gathered_part(): owned *ReaderPart {
    own {
        part: *ReaderPart = new ReaderPart {
            c: 0,
            k: 0,
            parts: 0,
            gap_to: -1,
            coming: false,
            stale: false,
            text: new i8[0](0i8),
            span_from: new int[0](0),
            span_to: new int[0](0),
            span_style: new int[0](0),
            span_para: new int[0](0),
            verse_number: new int[0](0),
            verse_from: new int[0](0),
            verse_to: new int[0](0),
            verse_anchor: new int[0](0),
            link_from: new int[0](0),
            link_to: new int[0](0),
            link_kind: new int[0](0),
            link_arg: new int[0](0),
            mark_verse: new int[0](0),
            mark_color: new int[0](0),
            anchor_verse: new int[0](0),
            anchor_part: new int[0](0)
        };
        borrow rp_gathered as lines {
            rp_part_read(part, lines)
        }
        part
    }
}

// A part read from its lines: its `part` line's numbers and words, then
// its other lines (span A B STYLE PARA, verse V A B, link A B KIND ARG,
// mark V HEX BOOKMARK NOTE, anchor V K, gap C0 C1, coming), counted, then
// read into lists made for them.
rp_part_read(part: *ReaderPart@new, lines: *PartLines) {
    raw: []i8 = lines.bytes;
    n: int = lines.count;
    first: int = rp_first_line_end(lines);
    spans: int = 0;
    verses: int = 0;
    links: int = 0;
    marks: int = 0;
    anchors: int = 0;
    p: int = first + 1;
    while (p < n) {
        e: int = p;
        while (e < n && raw[e] as int != 10) e = e + 1;
        if (wl_is(raw, p, e, "span")) spans = spans + 1 else if (wl_is(raw, p, e,
            "verse")) verses = verses + 1 else if (wl_is(raw, p, e, "link")) links = links + 1 else if (wl_is(raw,
            p, e, "mark")) marks = marks + 1 else if (wl_is(raw, p, e, "anchor")) anchors = anchors + 1;
        p = e + 1
    }
    k: int = wl_num(raw, 0, first, 3);
    part.c = wl_num(raw, 0, first, 2);
    part.k = (if (k < 0) 0 else k);
    part.parts = wl_num(raw, 0, first, 4);
    if (wl_field(raw, 0, first, 1)) {
        part.text = new i8[rp_unescaped_length(raw, wl_b, wl_e)](0i8);
        _t: int = wl_unescape(raw, wl_b, wl_e, part.text, 0)
    }
    part.span_from = new int[spans](0);
    part.span_to = new int[spans](0);
    part.span_style = new int[spans](0);
    part.span_para = new int[spans](0);
    part.verse_number = new int[verses](0);
    part.verse_from = new int[verses](0);
    part.verse_to = new int[verses](0);
    part.verse_anchor = new int[verses](-1);
    part.link_from = new int[links](0);
    part.link_to = new int[links](0);
    part.link_kind = new int[links](0);
    part.link_arg = new int[links](0);
    part.mark_verse = new int[marks](0);
    part.mark_color = new int[marks](-1);
    part.anchor_verse = new int[anchors](0);
    part.anchor_part = new int[anchors](0);
    spans = 0;
    verses = 0;
    links = 0;
    marks = 0;
    anchors = 0;
    p = first + 1;
    while (p < n) {
        e: int = p;
        while (e < n && raw[e] as int != 10) e = e + 1;
        if (wl_is(raw, p, e, "span")) {
            part.span_from[spans] = wl_num(raw, p, e, 1);
            part.span_to[spans] = wl_num(raw, p, e, 2);
            part.span_style[spans] = wl_num(raw, p, e, 3);
            part.span_para[spans] = wl_num(raw, p, e, 4);
            spans = spans + 1
        } else if (wl_is(raw, p, e, "verse")) {
            part.verse_number[verses] = wl_num(raw, p, e, 1);
            part.verse_from[verses] = wl_num(raw, p, e, 2);
            part.verse_to[verses] = wl_num(raw, p, e, 3);
            verses = verses + 1
        } else if (wl_is(raw, p, e, "link")) {
            part.link_from[links] = wl_num(raw, p, e, 1);
            part.link_to[links] = wl_num(raw, p, e, 2);
            part.link_kind[links] = wl_num(raw, p, e, 3);
            part.link_arg[links] = wl_num(raw, p, e, 4);
            links = links + 1
        } else if (wl_is(raw, p, e, "mark")) {
            part.mark_verse[marks] = wl_num(raw, p, e, 1);
            if (wl_word(raw, p, e, 2)) part.mark_color[marks] = tm_hex(raw, wl_b,
                wl_e);
            marks = marks + 1
        } else if (wl_is(raw, p, e, "anchor")) {
            part.anchor_verse[anchors] = wl_num(raw, p, e, 1);
            part.anchor_part[anchors] = wl_num(raw, p, e, 2);
            anchors = anchors + 1
        } else if (wl_is(raw, p, e, "gap")) part.gap_to = wl_num(raw, p, e, 2) else if (wl_is(raw,
            p, e, "coming")) part.coming = true;
        p = e + 1
    }
    // (Each verse line's anchor: the chapter's anchors in this part are its
    // verse lines, in order, each of the same verse.)
    next: int = 0;
    for j in 0..verses {
        i: int = next;
        while (i < anchors && (part.anchor_part[i] != part.k || part.anchor_verse[i] != part.verse_number[j])) i = i + 1;
        if (i < anchors) {
            part.verse_anchor[j] = i;
            next = i + 1
        }
    }
}

// How many bytes the escaped field b to e is, its escapes undone.
rp_unescaped_length(buf: []i8, b: int, e: int): int {
    n: int = 0;
    p: int = b;
    while (p < e) {
        p = p + (if (buf[p] as int == 92 && p + 1 < e) 2 else 1);
        n = n + 1
    }
    n
}

// Whether a part is the last of its chapter (or of the run it stands for):
// a chapter's end is after it.
rp_ends_chapter(part: *ReaderPart): bool {
    part.gap_to >= 0 || part.parts <= 0 || part.k + 1 >= part.parts
}

// ---- a part laid out ----
// A part laid out for a column width wide: its cells (a code point each,
// and its attributes: ra), its lines (their cells from to to, at column
// x), each anchor's first line, and how many of its lines are its words
// (a chapter's last part has RP_CHAPTER_GAP blank lines after them); for
// a part still waiting (rp_part_waiting), the rows it is kept as tall as
// (at least 1; 0: not one). Its height is its line count.
type PartLayout = {
    width: int;
    padded_rows: int;
    cell_count: int;
    cell_cp: []int;
    cell_attr: []int;
    line_count: int;
    line_from: []int;
    line_to: []int;
    line_x: []int;
    anchor_line: []int;
    text_lines: int
}

RP_CHAPTER_GAP: int = 2;

// The rule's mark is drawn as this many cells.
RP_RULE_CELLS: int = 9;

// A cell's attributes: its style (core's STYLE_, 0 to 127), its verse, its
// link (plus 1; 0 none).
ra_style(a: int): int {
    a % 128
}

ra_verse(a: int): int {
    a / 128 % 512
}

ra_link(a: int): int {
    a / 65536 - 1
}

ra(style: int, verse: int, link: int): int {
    style + verse * 128 + (link + 1) * 65536
}

// The part in slot s of pane `index`'s window laid out for width, as
// tall as rows if it is waiting.
rp_layout_made(
    index: int,
    s: int,
    width: int,
    rows: int
): owned *PartLayout {
    own {
        lay: *PartLayout = new PartLayout {
            width: width,
            padded_rows: 0,
            cell_count: 0,
            cell_cp: new int[0](0),
            cell_attr: new int[0](0),
            line_count: 0,
            line_from: new int[0](0),
            line_to: new int[0](0),
            line_x: new int[0](0),
            anchor_line: new int[0](0),
            text_lines: 0
        };
        borrow reader_panes[index].parts[s] as part {
            rp_lay_part(part, lay, rows)
        }
        lay
    }
}

// Whether a part is a chapter still to come (the ESV's, a commentary's
// still opening): no verses, no anchors, not a run. It is kept as tall as
// its pane, so that the chapters after it are asked for only as it is
// scrolled past.
rp_part_waiting(part: *ReaderPart): bool {
    len(part.verse_number) == 0 && len(part.anchor_verse) == 0 && part.gap_to < 0
}

// Part laid out into lay (waiting, as tall as rows). Its cells are at most
// its words' code points and a rule's marks; its lines at most a line a
// cell and three a paragraph more, and the chapter's gap, or the rows it
// is kept as tall as: room for all of them is made first.
rp_lay_part(part: *ReaderPart, lay: *PartLayout@new, rows: int) {
    paragraphs: int = 1;
    for i in 0..len(part.text)
        if (part.text[i] as int == 10) paragraphs = paragraphs + 1;
    cell_room: int = len(part.text) + RP_RULE_CELLS * paragraphs;
    if (rp_part_waiting(part)) lay.padded_rows = (if (rows > 0) rows else 1);
    line_room: int = cell_room + 3 * paragraphs + RP_CHAPTER_GAP + lay.padded_rows;
    lay.cell_cp = new int[cell_room](0);
    lay.cell_attr = new int[cell_room](0);
    lay.line_from = new int[line_room](0);
    lay.line_to = new int[line_room](0);
    lay.line_x = new int[line_room](0);
    lay.anchor_line = new int[len(part.verse_number)](0);
    rp_lay_words(part, lay)
}

// The part's words into lay: a code point at a time, each with its span's
// style, its verse and its link, each paragraph wrapped at its end; then
// each anchor's first line.
rp_lay_words(part: *ReaderPart, lay: *PartLayout) {
    t: []i8 = part.text;
    tn: int = len(t);
    anchors: int = len(part.verse_number);
    // (Each anchor's first cell, until its line is known.)
    next_anchor: int = 0;
    u: int = 0;
    si: int = 0;
    vi: int = 0;
    li: int = 0;
    para: int = 0;
    first: int = -1;
    from: int = 0;
    q: int = 0;
    while (q <= tn) {
        if (q == tn || t[q] as int == 10) {
            rp_wrap(lay, from, para, first);
            from = lay.cell_count;
            first = -1;
            para = 0;
            u = u + 1;
            q = q + 1
        } else {
            cp: int = tm_cp_at(t, q, tn);
            q = q + tm_cp_len;
            while (si < len(part.span_to) && part.span_to[si] <= u) si = si + 1;
            while (vi < anchors && part.verse_to[vi] <= u) vi = vi + 1;
            while (li < len(part.link_to) && part.link_to[li] <= u) li = li + 1;
            in_span: bool = si < len(part.span_to) && part.span_from[si] <= u;
            st: int = if (in_span) part.span_style[si] else 0;
            if (first < 0) {
                first = st;
                para = (if (in_span) part.span_para[si] else 0)
            }
            v: int = if (vi < anchors && part.verse_from[vi] <= u) part.verse_number[vi] else 0;
            l: int = if (li < len(part.link_to) && part.link_from[li] <= u) li else -1;
            while (next_anchor < anchors && part.verse_from[next_anchor] <= u) {
                lay.anchor_line[next_anchor] = lay.cell_count;
                next_anchor = next_anchor + 1
            }
            rp_cell(lay, rp_shown_as(cp, st), ra(st, v, l));
            u = u + (if (cp >= 65536) 2 else 1)
        }
    }
    while (next_anchor < anchors) {
        lay.anchor_line[next_anchor] = lay.cell_count;
        next_anchor = next_anchor + 1
    }
    lay.text_lines = lay.line_count;
    while (lay.line_count < lay.padded_rows) rp_line(lay, lay.cell_count, lay.cell_count,
        0);
    if (rp_ends_chapter(part)) {
        for _g in 0..RP_CHAPTER_GAP rp_line(lay, lay.cell_count, lay.cell_count, 0)
    }
    // (An anchor's line: the first with a cell at or after its first.)
    for j in 0..anchors {
        cell: int = lay.anchor_line[j];
        line: int = 0;
        while (line + 1 < lay.text_lines && lay.line_to[line] <= cell) line = line + 1;
        lay.anchor_line[j] = line
    }
}

rp_cell(lay: *PartLayout, cp: int, attr: int) {
    n: int = lay.cell_count;
    if (n < len(lay.cell_cp)) {
        lay.cell_cp[n] = cp;
        lay.cell_attr[n] = attr;
        lay.cell_count = n + 1
    }
}

// A line of lay: its cells from to to, at column x.
rp_line(
    lay: *PartLayout,
    from: int,
    to: int,
    x: int
) {
    k: int = lay.line_count;
    if (k < len(lay.line_from)) {
        lay.line_from[k] = from;
        lay.line_to[k] = to;
        lay.line_x[k] = x;
        lay.line_count = k + 1
    }
}

// What a code point shows as: a verse's number raised, a footnote's letter
// raised, the rule's mark a line.
sup_digits: []int = [8304, 185, 178, 179, 8308, 8309, 8310, 8311, 8312, 8313];

sup_letters: []int = [7491, 7495, 7580, 7496, 7497, 7584, 7501, 688, 8305, 690, 7503,
    737, 7504, 8319, 7506, 7510, 113, 691, 738, 7511, 7512, 7515, 695, 739, 696, 7611];

rp_shown_as(cp: int, st: int): int {
    if (st == 1 && cp >= 48 && cp <= 57) return sup_digits[cp - 48];
    if (st == 1 && cp == 8239) return 32;
    if (st == 11 && cp >= 97 && cp <= 122) return sup_letters[cp - 97];
    if (cp == 8239 || cp == 160) return 160;
    if (cp == 9) return 32;
    cp
}

// The paragraph whose cells are from `from` to lay's last, wrapped into
// its lines: its kind's indent (poetry's 2 and 4, a verse a line's
// hanging), centered (the book, the number, the rule, PARA_CENTER) or at
// the right; a heading with a line before it; an empty paragraph a line of
// its own.
rp_wrap(
    lay: *PartLayout,
    from: int,
    para: int,
    first: int
) {
    w: int = lay.width;
    kind: int = para % 16;
    base: int = if (kind == 1 || kind == 3) 2 else if (kind == 2 || kind == 4) 4 else 0;
    hang: int = if (kind == 7) 2 else if (kind >= 1 && kind <= 4) 2 else 0;
    centered: bool = kind == 5 || first == 2 || first == 3 || first == 15 || first == 12 || first == 14;
    right: bool = kind == 6;
    heading: bool = first == 4 || first == 10 || first == 21 || first == 8 || first == 5;
    if (heading && lay.line_count > 0) rp_line(lay, from, from, 0);
    if (lay.cell_count == from) {
        rp_line(lay, from, from, 0);
        return
    }
    // (The rule's mark: a short line.)
    if (first == 14 && lay.cell_count == from + 1) {
        lay.cell_count = from;
        for _k in 0..RP_RULE_CELLS rp_cell(lay, 9472, ra(14, 0, -1))
    }
    cp: []int = lay.cell_cp;
    start: int = from;
    end: int = lay.cell_count;
    indent: int = base;
    while (start < end) {
        room: int = w - indent;
        if (room < 8) room = 8;
        // The most that fits, broken after a space.
        x: int = 0;
        i: int = start;
        brk: int = -1;
        fits: bool = true;
        while (i < end && fits) {
            cw: int = tm_width(cp[i]);
            if (x + cw > room) fits = false else {
                x = x + cw;
                if (cp[i] == 32 || cp[i] == 8212 || cp[i] == 8211) brk = i + 1;
                i = i + 1
            }
        }
        stop: int = if (fits || brk <= start) i else brk;
        if (stop <= start) stop = start + 1;
        // (Its trailing space left off.)
        e2: int = stop;
        while (e2 > start && cp[e2 - 1] == 32) e2 = e2 - 1;
        lw: int = 0;
        for j in start..e2 lw = lw + tm_width(cp[j]);
        lx: int = if (centered) (w - lw) / 2 else if (right) w - lw else indent;
        rp_line(lay, start, e2, if (lx < 0) 0 else lx);
        start = stop;
        while (start < end && cp[start] == 32) start = start + 1;
        indent = base + hang
    }
    // (Relaxed: a line after each paragraph of prose.)
    if (lk_spacing >= 1400 && kind == 0 && !heading && !centered) rp_line(lay, end,
        end, 0)
}

// ---- a pane ----
// Where a pane's reading line is: nowhere yet, or line `line` of part k of
// chapter c, a part in its window.
type ReadingPlace =
    | Unplaced
    | At { c: int, k: int, line: int }

// Where a pane is to go, until the part is here and laid out: a place
// (core's `go`: anchor i of chapter c, -1 above its first, frac
// thousandths through its span), or the first anchor of a verse (Listen's,
// followed; verse 0, the chapter's top).
type PendingMove =
    | Settled
    | ToPlace { c: int, i: int, frac: int }
    | ToVerse { c: int, v: int }

// A place in a document's terms (SKINS.md, Places): anchor i of chapter c
// (-1: above its first), frac thousandths through its span; or none known
// (the pane not placed, its part not here).
type DocumentPlace =
    | Unknown
    | Anchored { c: int, i: int, frac: int }

// Whether a pane has rested since it last moved (at a time; by a hand:
// `moving` told).
type PaneMotion =
    | Resting
    | Moved { at: int, by_hand: bool }

// What the keys are on in a pane: nothing, a verse (anchor `anchor` of
// part k of chapter c) or a link (of part k of chapter c).
type KeysOn =
    | NoKeys
    | OnVerse { c: int, k: int, anchor: int }
    | OnLink { c: int, k: int, link: int }

// A pane (core's PANE_PAGE or PANE_PANEL) and what it reads:
// - its reading line (thousandths down its rows, core's `line`);
// - its window: the parts near what it shows (RP_WINDOW at most, those
//   used longest ago let go), each with its layout for the pane's column,
//   and when each was last wanted;
// - where it was last drawn: its rows from r0 (0 rows: never drawn), its
//   words' column (text_x, text_width wide), its background; whether it
//   was drawn this frame;
// - its place, where it is to go, whether it rests;
// - its place in the document's terms as it last said it (`at`), or
//   where it was sent once it arrives there; the place that was found
//   from; whether an `at` is owed (it arrived where it was sent);
// - what the keys are on;
// - the parts asked for lately (chapter, part, when), so that one isn't
//   asked for again while core answers;
// - whether it is to be drawn again.
type ReaderPane = {
    index: int;
    reading_line: int;
    parts: []?owned *ReaderPart;
    layouts: []?owned *PartLayout;
    used: []int;
    clock: int;
    r0: int;
    rows: int;
    text_x: int;
    text_width: int;
    background: int;
    shown: bool;
    place: ReadingPlace;
    pending: PendingMove;
    motion: PaneMotion;
    told: DocumentPlace;
    told_from: ReadingPlace;
    at_owed: bool;
    keys: KeysOn;
    asked_c: []int;
    asked_k: []int;
    asked_at: []int;
    asked_next: int;
    dirty: bool
}

RP_WINDOW: int = 48;

// How many parts either way of its place a pane keeps (fewer than its
// window holds, so that those wanted are never let go for each other).
RP_WANT_PARTS: int = 20;

RP_ASKED_MOST: int = 32;

// A part asked for and not come is asked for again after this long (ms).
RP_ASK_AGAIN_MS: int = 5000;

// How long after a pane last moved it is at rest (ms).
RP_REST_MS: int = 250;

rp_pane_made(index: int): ReaderPane@new {
    ReaderPane {
        index: index,
        reading_line: 0,
        parts: new ?owned *ReaderPart[RP_WINDOW](null),
        layouts: new ?owned *PartLayout[RP_WINDOW](null),
        used: new int[RP_WINDOW](0),
        clock: 0,
        r0: 0,
        rows: 0,
        text_x: 0,
        text_width: 0,
        background: lk_bg,
        shown: false,
        place: ReadingPlace.Unplaced,
        pending: PendingMove.Settled,
        motion: PaneMotion.Resting,
        told: DocumentPlace.Unknown,
        told_from: ReadingPlace.Unplaced,
        at_owed: false,
        keys: KeysOn.NoKeys,
        asked_c: new int[RP_ASKED_MOST](-1),
        asked_k: new int[RP_ASKED_MOST](0),
        asked_at: new int[RP_ASKED_MOST](0),
        asked_next: 0,
        dirty: true
    }
}

reader_panes: []ReaderPane = [rp_pane_made(PANE_PAGE), rp_pane_made(PANE_PANEL)];

reader_pane(index: int): *ReaderPane {
    &reader_panes[index]
}

// ---- what a slot holds ----
// A slot's part, as its numbers (c -1: the slot is empty): whether it is
// waiting (a chapter not here yet, the ESV's: no verses, no anchors), and
// whether its chapter ends after it.
type SlotPart = {
    c: int;
    k: int;
    parts: int;
    gap_to: int;
    coming: bool;
    stale: bool;
    waiting: bool;
    ends_chapter: bool
}

rp_slot_part(pane: *ReaderPane, s: int): SlotPart {
    if (s < 0 || pane.parts[s] == null) return SlotPart {
        c: -1,
        k: 0,
        parts: 0,
        gap_to: -1,
        coming: false,
        stale: false,
        waiting: false,
        ends_chapter: false
    };
    borrow pane.parts[s] as part {
        SlotPart {
            c: part.c,
            k: part.k,
            parts: part.parts,
            gap_to: part.gap_to,
            coming: part.coming,
            stale: part.stale,
            waiting: rp_part_waiting(part),
            ends_chapter: rp_ends_chapter(part)
        }
    }
}

// The slot holding part k of chapter c (-1: none).
rp_slot(pane: *ReaderPane, c: int, k: int): int {
    for s in 0..RP_WINDOW {
        info: SlotPart = rp_slot_part(pane, s);
        if (info.c == c && info.k == k) return s
    }
    -1
}

// A slot holding a part of chapter c, or the run it is in (-1: none): if
// fresh, one not to be asked for again; one that has been read, if there
// is one.
rp_slot_holding(pane: *ReaderPane, c: int, fresh: bool): int {
    best: int = -1;
    for s in 0..RP_WINDOW {
        info: SlotPart = rp_slot_part(pane, s);
        holds: bool = info.c == c || info.gap_to >= 0 && info.c <= c && c <= info.gap_to;
        if (holds && (!fresh || !info.stale)) {
            if (best < 0 || !info.coming && rp_slot_part(pane, best).coming) best = s
        }
    }
    best
}

rp_place_slot(pane: *ReaderPane): int {
    match pane.place {
        Unplaced -> -1;
        At p -> rp_slot(pane, p.c, p.k)
    }
}

// Slot s laid out for the pane's column (laid out again if it isn't, and
// measured): its height in lines.
rp_height(pane: *ReaderPane, s: int): int {
    rp_ensure_laid(pane, s);
    borrow pane.layouts[s] as lay {
        lay.line_count
    }
}

rp_text_lines(pane: *ReaderPane, s: int): int {
    rp_ensure_laid(pane, s);
    borrow pane.layouts[s] as lay {
        lay.text_lines
    }
}

rp_ensure_laid(pane: *ReaderPane, s: int) {
    if (pane.layouts[s] != null) {
        laid: bool = false;
        borrow pane.layouts[s] as lay {
            laid = lay.width == pane.text_width && (lay.padded_rows == 0 || lay.padded_rows == pane.rows)
        }
        if (laid) return;
        drop pane.layouts[s]
    }
    pane.layouts[s] = rp_layout_made(pane.index, s, pane.text_width, pane.rows)
}

rp_touch(pane: *ReaderPane, s: int) {
    pane.clock = pane.clock + 1;
    pane.used[s] = pane.clock
}

// ---- parts come and go ----
// A part come: in place of the one it is sent again for, else in an empty
// slot, else in the one used longest ago (not the place's); parts it
// stands in for let go.
rp_take_part(pane: *ReaderPane, part: owned *ReaderPart) {
    c: int = 0;
    k: int = 0;
    coming: bool = false;
    borrow part {
        c = part.c;
        k = part.k;
        coming = part.coming
    }
    s: int = rp_slot(pane, c, k);
    if (s < 0) s = rp_free_slot(pane);
    drop pane.parts[s];
    drop pane.layouts[s];
    pane.parts[s] = move part;
    rp_touch(pane, s);
    rp_asked_clear(pane, c, k);
    if (!coming) rp_drop_superseded(pane, s);
    pane.dirty = true
}

rp_free_slot(pane: *ReaderPane): int {
    keep: int = rp_place_slot(pane);
    oldest: int = -1;
    for s in 0..RP_WINDOW {
        if (pane.parts[s] == null) return s;
        if (s != keep && (oldest < 0 || pane.used[s] < pane.used[oldest])) oldest = s
    }
    oldest
}

// The parts a fresh part in slot s makes wrong (its chapter in fewer parts
// now; chapters its run of chapters stands for, or a run its chapter was
// in): let go, the place in one moved to it.
rp_drop_superseded(pane: *ReaderPane, s: int) {
    came: SlotPart = rp_slot_part(pane, s);
    for t in 0..RP_WINDOW {
        info: SlotPart = rp_slot_part(pane, t);
        if (t != s && info.c >= 0) {
            fewer: bool = info.c == came.c && came.parts > 0 && info.k >= came.parts;
            in_run: bool = came.gap_to >= 0 && info.c >= came.c && info.c <= came.gap_to;
            run_held: bool = info.gap_to >= 0 && came.c >= info.c && came.c <= info.gap_to;
            if (fewer || in_run || run_held) {
                if (rp_place_slot(pane) == t) pane.place = ReadingPlace.At { c: came.c, k: came.k, line: 0 };
                drop pane.parts[t];
                drop pane.layouts[t]
            }
        }
    }
}

// `forget P C`: the pane's parts of chapter c (-1: every chapter) to be
// asked for again, shown until they come.
rp_forget(pane: *ReaderPane, c: int) {
    for s in 0..RP_WINDOW {
        info: SlotPart = rp_slot_part(pane, s);
        if (info.c >= 0 && (c < 0 || info.c == c || info.gap_to >= 0 && info.c <= c && c <= info.gap_to)) {
            borrow pane.parts[s] as part {
                part.stale = true
            }
        }
    }
    pane.dirty = true
}

// `want P C K`, unless it was asked for lately.
rp_want(pane: *ReaderPane, c: int, k: int) {
    if (c < 0 || c >= rp_chapters) return;
    now: int = tm_now();
    for i in 0..RP_ASKED_MOST {
        if (pane.asked_c[i] == c && pane.asked_k[i] == k && now - pane.asked_at[i] < RP_ASK_AGAIN_MS) return
    }
    i: int = pane.asked_next;
    pane.asked_c[i] = c;
    pane.asked_k[i] = k;
    pane.asked_at[i] = now;
    pane.asked_next = (i + 1) % RP_ASKED_MOST;
    tc_str("want ");
    tc_int(pane.index);
    tc_byte(32);
    tc_int(c);
    tc_byte(32);
    tc_int(k);
    tc_end()
}

rp_asked_clear(pane: *ReaderPane, c: int, k: int) {
    for i in 0..RP_ASKED_MOST {
        if (pane.asked_c[i] == c && pane.asked_k[i] == k) pane.asked_c[i] = -1
    }
}

rp_want_if_stale(pane: *ReaderPane, s: int) {
    info: SlotPart = rp_slot_part(pane, s);
    if (info.stale) rp_want(pane, info.c, info.k)
}

// ---- from part to part ----
// The part after or before one in the window: here (its slot), to be
// asked for (chapter c's part k; before a chapter whose parts aren't known,
// its first, which says how many), or none (the document's end or start).
type PartStep =
    | Found { slot: int }
    | Wanted { c: int, k: int }
    | Edge

rp_found_or_wanted(pane: *ReaderPane, c: int, k: int): PartStep {
    s: int = rp_slot(pane, c, k);
    if (s >= 0) PartStep.Found { slot: s } else PartStep.Wanted { c: c, k: k }
}

rp_step_after(pane: *ReaderPane, s: int): PartStep {
    info: SlotPart = rp_slot_part(pane, s);
    if (info.k + 1 < info.parts) return rp_found_or_wanted(pane, info.c, info.k + 1);
    next: int = (if (info.gap_to >= 0) info.gap_to else info.c) + 1;
    if (next >= rp_chapters) return PartStep.Edge;
    rp_found_or_wanted(pane, next, 0)
}

rp_step_before(pane: *ReaderPane, s: int): PartStep {
    info: SlotPart = rp_slot_part(pane, s);
    if (info.k > 0) return rp_found_or_wanted(pane, info.c, info.k - 1);
    if (info.c <= 0) return PartStep.Edge;
    t: int = rp_slot_holding(pane, info.c - 1, false);
    if (t < 0) return PartStep.Wanted { c: info.c - 1, k: 0 };
    held: SlotPart = rp_slot_part(pane, t);
    if (held.gap_to >= 0 || held.parts <= 0) return PartStep.Found { slot: t };
    rp_found_or_wanted(pane, held.c, held.parts - 1)
}

// A line of the window: shown (line `line` of slot's part), in a part to
// be asked for, or beyond the document's start or end.
type LineAt =
    | Shown { slot: int, line: int }
    | Missing { c: int, k: int }
    | Beyond

rp_line_after(pane: *ReaderPane, at: LineAt): LineAt {
    match at {
        Shown a -> rp_line_after_shown(pane, a.slot, a.line);
        _ -> at
    }
}

rp_line_after_shown(pane: *ReaderPane, s: int, line: int): LineAt {
    if (line + 1 < rp_height(pane, s)) return LineAt.Shown { slot: s, line: line + 1 };
    match rp_step_after(pane, s) {
        Found f -> LineAt.Shown { slot: f.slot, line: 0 };
        Wanted w -> LineAt.Missing { c: w.c, k: w.k };
        Edge -> LineAt.Beyond
    }
}

rp_line_before(pane: *ReaderPane, at: LineAt): LineAt {
    match at {
        Shown a -> rp_line_before_shown(pane, a.slot, a.line);
        _ -> at
    }
}

rp_line_before_shown(pane: *ReaderPane, s: int, line: int): LineAt {
    if (line > 0) return LineAt.Shown { slot: s, line: line - 1 };
    match rp_step_before(pane, s) {
        Found f -> LineAt.Shown { slot: f.slot, line: rp_height(pane, f.slot) - 1 };
        Wanted w -> LineAt.Missing { c: w.c, k: w.k };
        Edge -> LineAt.Beyond
    }
}

// n lines on from a line (n < 0: back), what is there.
rp_lines_on(pane: *ReaderPane, from: LineAt, n: int): LineAt {
    at: LineAt = from;
    for _i in 0..if (n < 0) -n else n at = (if (n < 0) rp_line_before(pane, at) else rp_line_after(pane,
        at));
    at
}

// n lines on from a shown line (n < 0: back), as far as the window goes.
rp_lines_on_within(pane: *ReaderPane, from: LineAt, n: int): LineAt {
    here: LineAt = from;
    going: bool = true;
    for _i in 0..if (n < 0) -n else n {
        if (going) {
            next: LineAt = if (n < 0) rp_line_before(pane, here) else rp_line_after(pane,
                here);
            match next {
                Shown _s -> here = next;
                _ -> going = false
            }
        }
    }
    here
}

// The pane's place as a line of its window (Missing: its part isn't here).
rp_place_line(pane: *ReaderPane): LineAt {
    match pane.place {
        Unplaced -> LineAt.Beyond;
        At p -> rp_place_line_at(pane, p.c, p.k, p.line)
    }
}

rp_place_line_at(
    pane: *ReaderPane,
    c: int,
    k: int,
    line: int
): LineAt {
    s: int = rp_slot(pane, c, k);
    if (s < 0) return LineAt.Missing { c: c, k: k };
    h: int = rp_height(pane, s);
    LineAt.Shown { slot: s, line: if (line >= h) h - 1 else if (line < 0) 0 else line }
}

// The row (of the pane's) its reading line is on.
rp_reading_row(pane: *ReaderPane): int {
    pane.reading_line * pane.rows / 1000
}

// What is on row r of the pane (from its first).
rp_row_line(pane: *ReaderPane, r: int): LineAt {
    rp_lines_on(pane, rp_place_line(pane), r - rp_reading_row(pane))
}

// The pane's place put at a shown line of its window.
rp_place_at_line(pane: *ReaderPane, at: LineAt) {
    match at {
        Shown a -> {
            info: SlotPart = rp_slot_part(pane, a.slot);
            pane.place = ReadingPlace.At { c: info.c, k: info.k, line: a.line }
        }
        _ -> { }
    }
}

// ---- where it is put ----
// `line P THOUSANDTHS`: the pane's reading line.
rp_set_reading_line(pane: *ReaderPane, thousandths: int) {
    pane.reading_line = (if (thousandths < 0) 0 else if (thousandths > 1000) 1000 else thousandths);
    pane.dirty = true
}

// `go P C I FRAC MODE`: the pane to anchor i of chapter c (-1: the
// chapter's top), frac thousandths through its span, once its part is
// here; at once, whatever the mode (a terminal has no glide).
rp_go(
    pane: *ReaderPane,
    c: int,
    i: int,
    frac: int
) {
    if (c < 0 || c >= rp_chapters) return;
    pane.pending = PendingMove.ToPlace { c: c, i: i, frac: frac };
    pane.dirty = true
}

// The pane to verse v of chapter c's first anchor (0: the chapter's top).
rp_go_verse(pane: *ReaderPane, c: int, v: int) {
    if (c < 0 || c >= rp_chapters) return;
    pane.pending = PendingMove.ToVerse { c: c, v: v };
    pane.dirty = true
}

// Where the pane is to go, gone to if its part is here (asked for, if it
// isn't). The place kept within its part, laid out again shorter.
rp_settle(pane: *ReaderPane) {
    if (pane.text_width == 0) return;
    match pane.pending {
        Settled -> { }
        ToPlace t -> rp_arrive_at_place(pane, t.c, t.i, t.frac);
        ToVerse t -> rp_arrive_at_verse(pane, t.c, t.v)
    }
    match pane.place {
        At p -> rp_place_at_line(pane, rp_place_line_at(pane, p.c, p.k, p.line));
        Unplaced -> { }
    }
}

// To verse v's first anchor, as a part of its chapter here says which (the
// last before it, if none is v's); its chapter's first part asked for if
// none is here.
rp_arrive_at_verse(pane: *ReaderPane, c: int, v: int) {
    held: int = rp_slot_holding(pane, c, false);
    if (held < 0) {
        rp_want(pane, c, 0);
        return
    }
    i: int = -1;
    if (v > 0) {
        borrow pane.parts[held] as part {
            exact: bool = false;
            for j in 0..len(part.anchor_verse) {
                if (!exact && part.anchor_verse[j] == v) {
                    i = j;
                    exact = true
                } else if (!exact && part.anchor_verse[j] < v) i = j
            }
        }
    }
    rp_arrive_at_place(pane, c, i, 0)
}

rp_arrive_at_place(
    pane: *ReaderPane,
    c: int,
    i: int,
    frac: int
) {
    held: int = rp_slot_holding(pane, c, true);
    if (held < 0) {
        // (Which part holds it, as a part of its chapter kept says; else
        // its first, which says.)
        kept: int = rp_slot_holding(pane, c, false);
        rp_want(pane, c, if (kept >= 0) rp_part_of_anchor(pane, kept, i) else 0);
        return
    }
    target: int = held;
    info: SlotPart = rp_slot_part(pane, held);
    if (info.gap_to < 0) {
        k: int = rp_part_of_anchor(pane, held, i);
        target = rp_slot(pane, info.c, k);
        if (target < 0 || rp_slot_part(pane, target).stale) {
            rp_want(pane, info.c, k);
            return
        }
    }
    there: SlotPart = rp_slot_part(pane, target);
    // (Its anchor's line, then frac through the span from there to the
    // next anchor's, as far as the parts here go.)
    line: int = if (there.gap_to >= 0) 0 else rp_anchor_first_line(pane, target, i);
    pane.place = ReadingPlace.At { c: there.c, k: there.k, line: line };
    if (frac > 0 && there.gap_to < 0) {
        rows: int = 0;
        region {
            run: PartRun = rp_part_run(pane, c);
            shape: ChapterShape = rp_chapter_shape(pane, &run, c);
            span: AnchorSpan = rp_anchor_span(&shape, i);
            if (span.known) rows = ((span.to - span.from) * frac as f64 / 1000.0f64) as int
        }
        rp_place_at_line(pane, rp_lines_on_within(pane, rp_place_line(pane), rows))
    }
    pane.dirty = true;
    // (A part still to be read, or a chapter still to come: shown, and
    // gone to again as it comes.)
    if (there.coming || there.waiting) return;
    rp_arrived(pane, DocumentPlace.Anchored { c: c, i: i, frac: frac })
}

// Where it was to go: there, its place told again (`at`), as the anchor
// it was sent to if that begins on its reading line with others.
rp_arrived(pane: *ReaderPane, sent_to: DocumentPlace) {
    pane.pending = PendingMove.Settled;
    pane.told = sent_to;
    pane.at_owed = true;
    rp_moved(pane, PANE_MOVED_BY_APP)
}

// The part of slot s's chapter holding its anchor i, as slot s's part
// says (above the first: the first part).
rp_part_of_anchor(pane: *ReaderPane, s: int, i: int): int {
    borrow pane.parts[s] as part {
        n: int = len(part.anchor_part);
        if (i < 0 || n == 0) 0 else if (i >= n) part.anchor_part[n - 1] else part.anchor_part[i]
    }
}

// The line anchor i of its chapter begins on in slot s's part (the last
// of the part's before it, if it isn't the part's; -1, the part's top).
rp_anchor_first_line(pane: *ReaderPane, s: int, i: int): int {
    rp_ensure_laid(pane, s);
    borrow pane.parts[s] as part {
        borrow pane.layouts[s] as lay {
            line: int = 0;
            if (i >= 0) {
                for j in 0..len(part.verse_anchor) {
                    a: int = part.verse_anchor[j];
                    if (a >= 0 && a <= i) line = lay.anchor_line[j]
                }
            }
            line
        }
    }
}

// The pane's place moved (how: PANE_MOVED_BY_APP or PANE_DRAGGED): a
// hand's first move told (`moving`), and its rest timed from now.
rp_moved(pane: *ReaderPane, how: int) {
    now: int = tm_now();
    by_hand: bool = match pane.motion {
        Resting -> false;
        Moved m -> m.by_hand
    };
    if (how == PANE_DRAGGED && !by_hand) {
        tc_str("moving ");
        tc_int(pane.index);
        tc_byte(32);
        tc_int(now);
        tc_end();
        by_hand = true
    }
    pane.motion = PaneMotion.Moved { at: now, by_hand: by_hand };
    pane.dirty = true
}

// ---- places ----
// The parts of a pane's window that run on unbroken from its place's part,
// up and down the document as far as chapter c and the place's own
// chapter go: each part's slot and the row its first line is on, counted
// from the pane's reading line (its place's line, row 0), in order.
type PartRun = {
    slots: []int;
    tops: []int;
    count: int
}

rp_part_run(pane: *ReaderPane, c: int): PartRun@new {
    run: PartRun = PartRun { slots: new int[RP_WINDOW](0), tops: new int[RP_WINDOW](0), count: 0 };
    s: int = rp_place_slot(pane);
    if (s < 0) return run;
    line: int = match pane.place {
        At p -> p.line;
        Unplaced -> 0
    };
    here: SlotPart = rp_slot_part(pane, s);
    here_last: int = if (here.gap_to >= 0) here.gap_to else here.c;
    lo: int = if (c < here.c) c else here.c;
    hi: int = if (c > here_last) c else here_last;
    // (Up from the place's part, then the run put in order from its top.)
    above_slots: []int = new int[RP_WINDOW](0);
    above_tops: []int = new int[RP_WINDOW](0);
    above: int = 0;
    slot: int = s;
    top: int = -line;
    going: bool = true;
    while (going && above + 1 < RP_WINDOW) {
        match rp_step_before(pane, slot) {
            Found f -> {
                info: SlotPart = rp_slot_part(pane, f.slot);
                last: int = if (info.gap_to >= 0) info.gap_to else info.c;
                if (last < lo) going = false else {
                    slot = f.slot;
                    top = top - rp_height(pane, slot);
                    above_slots[above] = slot;
                    above_tops[above] = top;
                    above = above + 1
                }
            }
            _ -> going = false
        }
    }
    for k in 0..above {
        run.slots[k] = above_slots[above - 1 - k];
        run.tops[k] = above_tops[above - 1 - k]
    }
    run.slots[above] = s;
    run.tops[above] = -line;
    run.count = above + 1;
    // (Down from it.)
    slot = s;
    top = rp_height(pane, s) - line;
    going = true;
    while (going && run.count < RP_WINDOW) {
        match rp_step_after(pane, slot) {
            Found f -> {
                if (rp_slot_part(pane, f.slot).c > hi) going = false else {
                    slot = f.slot;
                    run.slots[run.count] = slot;
                    run.tops[run.count] = top;
                    run.count = run.count + 1;
                    top = top + rp_height(pane, slot)
                }
            }
            _ -> going = false
        }
    }
    run
}

// Chapter c as a run of a pane's parts lays it out (core/follow.l8's
// ChapterShape): where each of its anchors begins, where it begins (its
// first part's top) and ends (its last part's end: the next chapter's
// top), each known where its part is in the run; in rows down from the
// pane's reading line, a row its em.
rp_chapter_shape(pane: *ReaderPane, run: *PartRun, c: int): ChapterShape@new {
    n: int = 0;
    for x in 0..run.count {
        borrow pane.parts[run.slots[x]] as part {
            if (part.c == c && len(part.anchor_verse) > n) n = len(part.anchor_verse)
        }
    }
    shape: ChapterShape = ChapterShape {
        starts: new f64[n](0.0f64),
        known: new bool[n](false),
        top: 0.0f64,
        top_known: false,
        end: 0.0f64,
        end_known: false,
        em: 1.0f64
    };
    for x in 0..run.count {
        s: int = run.slots[x];
        top: int = run.tops[x];
        info: SlotPart = rp_slot_part(pane, s);
        if (info.c == c) {
            h: int = rp_height(pane, s);
            if (info.k == 0) {
                shape.top = top as f64;
                shape.top_known = true
            }
            if (info.ends_chapter) {
                shape.end = (top + h) as f64;
                shape.end_known = true
            }
            borrow pane.parts[s] as part {
                borrow pane.layouts[s] as lay {
                    for j in 0..len(part.verse_anchor) {
                        a: int = part.verse_anchor[j];
                        if (a >= 0 && a < n) {
                            shape.starts[a] = (top + lay.anchor_line[j]) as f64;
                            shape.known[a] = true
                        }
                    }
                }
            }
        }
    }
    shape
}

// Anchor i's span in a chapter's shape (-1: from the chapter's top to its
// first anchor): from its start to the next anchor's (after the last, the
// chapter's end); known, whether both are laid out.
type AnchorSpan = {
    from: f64;
    to: f64;
    known: bool
}

rp_anchor_span(shape: *ChapterShape, i: int): AnchorSpan {
    n: int = len(shape.known);
    from_known: bool = if (i < 0) shape.top_known else i < n && shape.known[i];
    from: f64 = if (i < 0) shape.top else if (i < n) shape.starts[i] else 0.0f64;
    to_known: bool = if (i + 1 < n) shape.known[i + 1] else shape.end_known;
    to: f64 = if (i + 1 < n) shape.starts[i + 1] else shape.end;
    AnchorSpan { from: from, to: to, known: from_known && to_known && to > from }
}

// The anchor at row y of a chapter's shape: the last laid out that begins
// at or above it; above them all, the one before the first laid out (-1:
// above the chapter's first).
rp_anchor_at_row(shape: *ChapterShape, y: f64): int {
    i: int = -1;
    first: int = -1;
    for x in 0..len(shape.known) {
        if (shape.known[x]) {
            if (first < 0) first = x;
            if (shape.starts[x] <= y) i = x
        }
    }
    if (i < 0 && first > 0) first - 1 else i
}

// The pane's reading line's place in its document's terms. Of several
// anchors beginning on the reading line, the one it last said or was
// sent to (Go To's verse, though a verse after it begins on its line
// too), else the last.
rp_document_place(pane: *ReaderPane): DocumentPlace {
    s: int = rp_place_slot(pane);
    if (s < 0) return DocumentPlace.Unknown;
    c: int = rp_slot_part(pane, s).c;
    known_i: int = match pane.told {
        Anchored a -> if (a.c == c) a.i else -1;
        Unknown -> -1
    };
    i: int = -1;
    frac: int = 0;
    region {
        run: PartRun = rp_part_run(pane, c);
        shape: ChapterShape = rp_chapter_shape(pane, &run, c);
        i = rp_anchor_at_row(&shape, 0.0f64);
        if (i >= 0 && known_i >= 0 && known_i < i && shape.known[known_i] && shape.starts[known_i] == 0.0f64 && shape.starts[i] == 0.0f64) i = known_i;
        span: AnchorSpan = rp_anchor_span(&shape, i);
        if (span.known) frac = (-span.from * 1000.0f64 / (span.to - span.from)) as int
    }
    DocumentPlace.Anchored { c: c, i: i, frac: if (frac < 0) 0 else if (frac > 999) 999 else frac }
}

// ---- moved by a hand ----
// Down n lines (n < 0: up), as far as its parts here go (the document's
// first line at its reading line at most, the rows above it blank).
rp_scroll_by(pane: *ReaderPane, n: int) {
    at: LineAt = rp_place_line(pane);
    match at {
        Shown _s -> { }
        _ -> return
    }
    was: ReadingPlace = pane.place;
    rp_place_at_line(pane, rp_lines_on_within(pane, at, n));
    rp_hand_moved(pane, was)
}

// Moved by a hand from where it was (if it moved): where it was to go
// given up; it leads, and the other is to follow it.
rp_hand_moved(pane: *ReaderPane, was: ReadingPlace) {
    if (rp_same_place(was, pane.place)) return;
    pane.pending = PendingMove.Settled;
    rp_moved(pane, PANE_DRAGGED);
    rp_following.leader = pane.index;
    rp_following.owed = true
}

rp_same_place(a: ReadingPlace, b: ReadingPlace): bool {
    match a {
        Unplaced -> match b {
            Unplaced -> true;
            At _q -> false
        }
        At p -> match b {
            Unplaced -> false;
            At q -> p.c == q.c && p.k == q.k && p.line == q.line
        }
    }
}

// A page down (1) or up (-1): its rows less three.
rp_page_by(pane: *ReaderPane, direction: int) {
    page: int = pane.rows - 3;
    rp_scroll_by(pane, direction * (if (page < 1) 1 else page))
}

// ---- telling core ----
// Each pane's place (`at`) as the anchor at its reading line changes, and
// at its rest, then its rest (`rest`). A pane not drawn (the page under
// the panel filling the screen, the panel's reader under another screen)
// still goes where it is to.
rp_report_panes() {
    for p in 0..PANES rp_report(reader_pane(p))
}

rp_report(pane: *ReaderPane) {
    if (pane.text_width == 0) return;
    if (!pane.shown) rp_settle(pane);
    match pane.pending {
        Settled -> { }
        _ -> return
    }
    resting: bool = match pane.motion {
        Moved m -> tm_now() - m.at >= RP_REST_MS;
        Resting -> false
    };
    // (Its place in the document's terms, found again only as it moved.)
    if (resting || pane.at_owed || !rp_same_place(pane.told_from, pane.place)) {
        pane.told_from = pane.place;
        now_at: DocumentPlace = rp_document_place(pane);
        match now_at {
            Anchored a -> {
                if (resting || pane.at_owed || !rp_same_anchor(pane.told, a.c, a.i)) {
                    pane.at_owed = false;
                    tc_str("at ");
                    tc_int(pane.index);
                    tc_byte(32);
                    tc_int(a.c);
                    tc_byte(32);
                    tc_int(a.i);
                    tc_byte(32);
                    tc_int(a.frac);
                    tc_end();
                    pane.told = now_at
                }
            }
            Unknown -> { }
        }
    }
    match pane.motion {
        Moved m -> {
            now: int = tm_now();
            if (now - m.at >= RP_REST_MS) {
                tc_str("rest ");
                tc_int(pane.index);
                tc_byte(32);
                tc_int(rp_ends_in_sight(pane));
                tc_byte(32);
                tc_int(now);
                tc_end();
                pane.motion = PaneMotion.Resting
            }
        }
        Resting -> { }
    }
}

// How long until a pane is due to rest (ms; RP_REST_MS at most).
rp_rest_wait(): int {
    wait: int = RP_REST_MS;
    now: int = tm_now();
    for p in 0..PANES {
        match reader_pane(p).motion {
            Moved m -> {
                left: int = m.at + RP_REST_MS - now;
                if (left < wait) wait = left
            }
            Resting -> { }
        }
    }
    if (wait < 0) 0 else wait
}

// The last chapter whose end is on the pane's rows (-1: none).
rp_ends_in_sight(pane: *ReaderPane): int {
    hi: int = -1;
    at: LineAt = rp_row_line(pane, 0);
    for _r in 0..pane.rows {
        match at {
            Shown a -> {
                info: SlotPart = rp_slot_part(pane, a.slot);
                if (info.ends_chapter && a.line + 1 == rp_text_lines(pane, a.slot)) {
                    last: int = if (info.gap_to >= 0) info.gap_to else info.c;
                    if (last > hi) hi = last
                }
            }
            _ -> { }
        }
        at = rp_line_after(pane, at)
    }
    hi
}

// Whether a place told is at anchor i of chapter c.
rp_same_anchor(told: DocumentPlace, c: int, i: int): bool {
    match told {
        Unknown -> false;
        Anchored a -> a.c == c && a.i == i
    }
}

// The parts near the place asked for: those a screen and its rows above
// it and two screens below it, and those to be asked for again among them;
// each kept from being let go.
rp_want_near(pane: *ReaderPane) {
    if (pane.text_width == 0) return;
    match pane.place {
        Unplaced -> { }
        At p -> rp_want_around(pane, p.c, p.k, p.line)
    }
}

rp_want_around(
    pane: *ReaderPane,
    c: int,
    k: int,
    line: int
) {
    s: int = rp_slot(pane, c, k);
    if (s < 0) {
        rp_want(pane, c, k);
        return
    }
    reading: int = rp_reading_row(pane);
    rp_touch(pane, s);
    rp_want_if_stale(pane, s);
    // (Below.)
    slot: int = s;
    lines: int = rp_height(pane, s) - line;
    going: bool = true;
    for _i in 0..RP_WANT_PARTS {
        if (going && lines < pane.rows - reading + 2 * pane.rows) {
            match rp_step_after(pane, slot) {
                Found f -> {
                    slot = f.slot;
                    rp_touch(pane, slot);
                    rp_want_if_stale(pane, slot);
                    lines = lines + rp_height(pane, slot)
                }
                Wanted w -> {
                    rp_want(pane, w.c, w.k);
                    going = false
                }
                Edge -> going = false
            }
        }
    }
    // (Above.)
    slot = s;
    lines = line;
    going = true;
    for _i in 0..RP_WANT_PARTS {
        if (going && lines < reading + pane.rows) {
            match rp_step_before(pane, slot) {
                Found f -> {
                    slot = f.slot;
                    rp_touch(pane, slot);
                    rp_want_if_stale(pane, slot);
                    lines = lines + rp_height(pane, slot)
                }
                Wanted w -> {
                    rp_want(pane, w.c, w.k);
                    going = false
                }
                Edge -> going = false
            }
        }
    }
}

// ---- laid out again ----
// The pane's column now text_width wide: its parts laid out again for it
// as they are drawn (and measured again), its place kept at the same
// anchor, as many lines past it as it was.
rp_set_text_width(pane: *ReaderPane, text_width: int) {
    if (text_width == pane.text_width) return;
    if (pane.text_width == 0) {
        pane.text_width = text_width;
        return
    }
    rp_lay_out_again(pane, text_width)
}

rp_lay_out_again(pane: *ReaderPane, text_width: int) {
    s: int = rp_place_slot(pane);
    was_line: int = match pane.place {
        At p -> p.line;
        Unplaced -> 0
    };
    anchor: int = -1;
    past: int = was_line;
    if (s >= 0 && pane.layouts[s] != null) {
        borrow pane.layouts[s] as lay {
            for j in 0..len(lay.anchor_line)
                if (lay.anchor_line[j] <= was_line) anchor = j;
            if (anchor >= 0) past = was_line - lay.anchor_line[anchor]
        }
    }
    for t in 0..RP_WINDOW {
        drop pane.layouts[t]
    }
    pane.text_width = text_width;
    pane.dirty = true;
    if (s < 0) return;
    h: int = rp_height(pane, s);
    line: int = past;
    if (anchor >= 0) {
        borrow pane.layouts[s] as lay {
            line = lay.anchor_line[anchor] + past
        }
    }
    info: SlotPart = rp_slot_part(pane, s);
    pane.place = ReadingPlace.At { c: info.c, k: info.k, line: if (line >= h) h - 1 else line };
    rp_moved(pane, PANE_MOVED_BY_APP)
}

// Every pane's parts laid out again (the look's spacing changed).
rp_lay_out_all_again() {
    for p in 0..PANES {
        pane: *ReaderPane = reader_pane(p);
        if (pane.text_width > 0) rp_lay_out_again(pane, pane.text_width)
    }
}

// ---- drawing ----
// Every pane not drawn yet this frame.
rp_frame_begin() {
    for p in 0..PANES {
        pane: *ReaderPane = reader_pane(p);
        pane.shown = false;
        pane.dirty = false
    }
}

rp_any_dirty(): bool {
    for p in 0..PANES
        if (reader_pane(p).dirty) return true;
    false
}

// The selection (its chapter, -1 none; its verses), the verse heard: the
// page's, as core says them.
sel_c: int = -1;

sel_v: []bool = new bool[256](false);

heard_c: int = -1;

heard_v: int = 0;

// The pane drawn on rows r0 to r1, columns x0 to x0 + w, on background:
// its words' column centered in them (as wide as core's margins allow).
// Where core said it is to go gone to, the parts near it asked for.
rp_draw(
    pane: *ReaderPane,
    r0: int,
    r1: int,
    x0: int,
    w: int,
    background: int
) {
    rows: int = r1 - r0;
    if (rows < 1) return;
    tw: int = w - 4;
    most: int = if (lk_margin <= 20) 84 else if (lk_margin <= 28) 72 else 60;
    if (tw > most) tw = most;
    if (tw < 20) tw = w;
    rp_set_text_width(pane, tw);
    pane.r0 = r0;
    pane.rows = rows;
    pane.text_x = x0 + (w - tw) / 2;
    pane.background = background;
    pane.shown = true;
    rp_settle(pane);
    rp_want_near(pane);
    reading: int = rp_reading_row(pane);
    // (From the reading row down, then up from it: a part not here yet
    // as dots where it begins.)
    at: LineAt = rp_place_line(pane);
    dotted: bool = false;
    for r in reading..rows {
        dotted = rp_draw_row(pane, r0 + r, at, dotted);
        at = rp_line_after(pane, at)
    }
    at = rp_place_line(pane);
    dotted = false;
    for i in 0..reading {
        at = rp_line_before(pane, at);
        dotted = rp_draw_row(pane, r0 + reading - 1 - i, at, dotted)
    }
    pane.dirty = false
}

// A row of the pane: a line of a part, or dots for one not here (the
// first row of those): whether dots are drawn now.
rp_draw_row(
    pane: *ReaderPane,
    row: int,
    at: LineAt,
    dotted: bool
): bool {
    match at {
        Shown a -> {
            rp_draw_line(pane, row, a.slot, a.line);
            dotted
        }
        Missing _m -> {
            if (!dotted) _w: int = tm_text(row, pane.text_x + pane.text_width / 2 - 1,
                "\Â\·\Â\·\Â\·", lk_faint, pane.background, 0);
            true
        }
        Beyond -> dotted
    }
}

rp_draw_line(
    pane: *ReaderPane,
    row: int,
    s: int,
    line: int
) {
    rp_ensure_laid(pane, s);
    cursor_c: int = -1;
    cursor_v: int = 0;
    link_c: int = -1;
    link_k: int = -1;
    focused_link: int = -1;
    match pane.keys {
        OnVerse o -> {
            cursor_c = o.c;
            cursor_v = rp_anchor_verse(pane, o.c, o.k, o.anchor)
        }
        OnLink l -> {
            link_c = l.c;
            link_k = l.k;
            focused_link = l.link
        }
        NoKeys -> { }
    }
    borrow pane.parts[s] as part {
        borrow pane.layouts[s] as lay {
            x: int = pane.text_x + lay.line_x[line];
            for j in lay.line_from[line]..lay.line_to[line] {
                a: int = lay.cell_attr[j];
                st: int = ra_style(a);
                bg: int = rp_wash(pane, part, ra_verse(a), cursor_c, cursor_v);
                attr: int = rd_attr(st);
                lk: int = ra_link(a);
                if (lk >= 0 && part.c == link_c && part.k == link_k && lk == focused_link) attr = attr | TA_REVERSE;
                x = x + tm_put(row, x, lay.cell_cp[j], rd_fg(st), bg, attr)
            }
        }
    }
}

// A verse's background, on the page: the selection, the keys' cursor, the
// verse heard, its highlight.
rp_wash(
    pane: *ReaderPane,
    part: *ReaderPart,
    v: int,
    cursor_c: int,
    cursor_v: int
): int {
    bg: int = pane.background;
    if (v <= 0 || pane.index != PANE_PAGE) return bg;
    c: int = part.c;
    if (c == sel_c && v < len(sel_v) && sel_v[v]) return tm_mix(lk_accent, bg, if (lk_dark) 300 else 200);
    if (c == cursor_c && v == cursor_v) return tm_mix(lk_ink, bg, 90);
    if (c == heard_c && v == heard_v) return tm_mix(lk_accent, bg, 140);
    for i in 0..len(part.mark_verse) {
        if (part.mark_verse[i] == v && part.mark_color[i] >= 0) return tm_mix(part.mark_color[i],
            bg, if (lk_dark) 320 else 400)
    }
    bg
}

// A style's color (core's STYLE_, then core's own RUN_).
rd_fg(st: int): int {
    if (st == 1 || st == 6 || st == 9 || st == 12 || st == 14 || st >= 26 && st <= 28) return lk_faint;
    if (st == 2 || st == 3 || st == 15 || st == 4 || st == 10 || st == 21 || st == 5 || st == 7 || st == 8 || st == 24 || st == 25) return lk_heading;
    if (st == 11 || st == 18) return lk_accent;
    if ((st == 16 || st == 17 || st == 20) && lk_red) return lk_accent;
    lk_ink
}

rd_attr(st: int): int {
    if (st == 2 || st == 3 || st == 15 || st == 4 || st == 10 || st == 21 || st == 8) return TA_BOLD;
    if (st == 5 || st == 7 || st == 6 || st == 9 || st == 19 || st == 20) return TA_ITALIC;
    if (st == 23 || st == 25) return TA_UNDER;
    0
}

// ---- where a click falls ----
// The cell at a row and column of a pane: its slot and cell (slot -1:
// none).
type CellHit = {
    slot: int;
    cell: int
}

rp_hit(pane: *ReaderPane, row: int, x: int): CellHit {
    none: CellHit = CellHit { slot: -1, cell: -1 };
    if (!pane.shown || row < pane.r0 || row >= pane.r0 + pane.rows) return none;
    match rp_row_line(pane, row - pane.r0) {
        Shown a -> {
            borrow pane.layouts[a.slot] as lay {
                cx: int = pane.text_x + lay.line_x[a.line];
                for j in lay.line_from[a.line]..lay.line_to[a.line] {
                    cw: int = tm_width(lay.cell_cp[j]);
                    if (x >= cx && x < cx + cw) return CellHit { slot: a.slot, cell: j };
                    cx = cx + cw
                }
            }
            none
        }
        _ -> none
    }
}

// A click at a row and column of a pane: a link's (a footnote, a
// reference, a word of the original, the ESV's line), else, on the page, a
// verse's (selected, or let go), else elsewhere.
rp_click(pane: *ReaderPane, row: int, x: int) {
    page: bool = pane.index == PANE_PAGE;
    hit: CellHit = rp_hit(pane, row, x);
    if (hit.slot < 0) {
        if (page) rp_tap_none();
        return
    }
    link: int = -1;
    v: int = 0;
    borrow pane.parts[hit.slot] as part {
        borrow pane.layouts[hit.slot] as lay {
            a: int = lay.cell_attr[hit.cell];
            link = ra_link(a);
            v = ra_verse(a);
            // (A footnote's mark is small: the cell before it counts too.)
            if (link < 0 && hit.cell + 1 < lay.cell_count) {
                after: int = ra_link(lay.cell_attr[hit.cell + 1]);
                if (after >= 0 && part.link_kind[after] == LINK_FOOTNOTE) link = after
            }
        }
    }
    info: SlotPart = rp_slot_part(pane, hit.slot);
    if (link >= 0) {
        rp_open_link(pane, info.c, info.k, link);
        return
    }
    if (!page) return;
    if (v > 0) {
        tc_str("tapverse ");
        tc_int(info.c);
        tc_byte(32);
        tc_int(v);
        tc_end()
    } else rp_tap_none()
}

rp_tap_none() {
    tc_str("tapnone");
    tc_end()
}

// Link `link` of part k of chapter c opened. A footnote and the ESV's line
// are the page's alone (core reads them in the version the page reads).
rp_open_link(
    pane: *ReaderPane,
    c: int,
    k: int,
    link: int
) {
    s: int = rp_slot(pane, c, k);
    if (s < 0) return;
    kind: int = 0;
    arg: int = 0;
    borrow pane.parts[s] as part {
        if (link >= len(part.link_kind)) return;
        kind = part.link_kind[link];
        arg = part.link_arg[link]
    }
    if (pane.index != PANE_PAGE && (kind == LINK_FOOTNOTE || kind == LINK_ESV)) return;
    if (kind == LINK_FOOTNOTE) {
        tc_str("footnote ");
        tc_int(c);
        tc_byte(32);
        tc_int(arg)
    } else if (kind == LINK_WORD) {
        tc_str("word ");
        tc_int(arg)
    } else if (kind == LINK_ESV) {
        tc_str("esvact ");
        tc_int(arg);
        tc_byte(32);
        tc_int(c)
    } else {
        tc_str("preview ");
        tc_int(arg)
    }
    tc_end()
}

// ---- the keys: a verse, and the links in sight ----
// Anchor `anchor` of part k of chapter c's verse (0: not here).
rp_anchor_verse(
    pane: *ReaderPane,
    c: int,
    k: int,
    anchor: int
): int {
    s: int = rp_slot(pane, c, k);
    if (s < 0) return 0;
    borrow pane.parts[s] as part {
        if (anchor < 0 || anchor >= len(part.verse_number)) 0 else part.verse_number[anchor]
    }
}

// An anchor's first line (Missing: its part isn't here).
rp_anchor_at(
    pane: *ReaderPane,
    c: int,
    k: int,
    anchor: int
): LineAt {
    s: int = rp_slot(pane, c, k);
    if (s < 0) return LineAt.Missing { c: c, k: k };
    rp_ensure_laid(pane, s);
    borrow pane.layouts[s] as lay {
        if (anchor < 0 || anchor >= len(lay.anchor_line)) LineAt.Missing { c: c, k: k } else LineAt.Shown { slot: s, line: lay.anchor_line[anchor] }
    }
}

// The row a line is on (-1: not on the pane's rows).
rp_row_of(pane: *ReaderPane, s: int, line: int): int {
    at: LineAt = rp_row_line(pane, 0);
    for r in 0..pane.rows {
        match at {
            Shown a -> if (a.slot == s && a.line == line) return r;
            _ -> { }
        }
        at = rp_line_after(pane, at)
    }
    -1
}

// The first verse beginning on the pane's rows.
rp_first_verse_shown(pane: *ReaderPane): KeysOn {
    at: LineAt = rp_row_line(pane, 0);
    for _r in 0..pane.rows {
        match at {
            Shown a -> {
                info: SlotPart = rp_slot_part(pane, a.slot);
                borrow pane.layouts[a.slot] as lay {
                    for j in 0..len(lay.anchor_line)
                        if (lay.anchor_line[j] == a.line) return KeysOn.OnVerse { c: info.c, k: info.k, anchor: j }
                }
            }
            _ -> { }
        }
        at = rp_line_after(pane, at)
    }
    KeysOn.NoKeys
}

// The keys' cursor to the next verse (d 1) or the one before (-1); from
// the first in sight if it isn't in sight. Its verse brought into sight.
rp_cursor(pane: *ReaderPane, d: int) {
    from: KeysOn = pane.keys;
    in_sight: bool = match from {
        OnVerse o -> rp_anchor_row(pane, o.c, o.k, o.anchor) >= 0;
        _ -> false
    };
    step: int = d;
    if (!in_sight) {
        from = rp_first_verse_shown(pane);
        if (step < 0) step = 0
    }
    match from {
        OnVerse o -> rp_cursor_from(pane, o.c, o.k, o.anchor, step);
        _ -> { }
    }
    pane.dirty = true
}

// The row an anchor's first line is on (-1: not on the pane's rows).
rp_anchor_row(
    pane: *ReaderPane,
    c: int,
    k: int,
    anchor: int
): int {
    match rp_anchor_at(pane, c, k, anchor) {
        Shown a -> rp_row_of(pane, a.slot, a.line);
        _ -> -1
    }
}

rp_cursor_from(
    pane: *ReaderPane,
    c: int,
    k: int,
    anchor: int,
    d: int
) {
    s: int = rp_slot(pane, c, k);
    if (s < 0) return;
    to_c: int = c;
    to_k: int = k;
    to_anchor: int = anchor + d;
    if (to_anchor < 0 || to_anchor >= rp_anchor_count(pane, s)) {
        // (Into the part after or before it, past parts without anchors.)
        slot: int = s;
        to_anchor = -1;
        going: bool = true;
        for _i in 0..RP_WANT_PARTS {
            if (going) {
                step: PartStep = if (d > 0) rp_step_after(pane, slot) else rp_step_before(pane,
                    slot);
                match step {
                    Found f -> {
                        slot = f.slot;
                        n: int = rp_anchor_count(pane, slot);
                        if (n > 0) {
                            info: SlotPart = rp_slot_part(pane, slot);
                            to_c = info.c;
                            to_k = info.k;
                            to_anchor = (if (d > 0) 0 else n - 1);
                            going = false
                        }
                    }
                    _ -> going = false
                }
            }
        }
        if (to_anchor < 0) return
    }
    pane.keys = KeysOn.OnVerse { c: to_c, k: to_k, anchor: to_anchor };
    rp_show_anchor(pane, to_c, to_k, to_anchor, d)
}

rp_anchor_count(pane: *ReaderPane, s: int): int {
    borrow pane.parts[s] as part {
        len(part.verse_number)
    }
}

// An anchor's line brought onto the pane's rows (by a hand): at its first
// row going up (d < 0), its last going down.
rp_show_anchor(
    pane: *ReaderPane,
    c: int,
    k: int,
    anchor: int,
    d: int
) {
    if (rp_anchor_row(pane, c, k, anchor) >= 0) return;
    at: LineAt = rp_anchor_at(pane, c, k, anchor);
    reading: int = rp_reading_row(pane);
    was: ReadingPlace = pane.place;
    rp_place_at_line(pane, rp_lines_on_within(pane, at, if (d < 0) reading else reading - (pane.rows - 1)));
    rp_hand_moved(pane, was)
}

// The keys' verse tapped (`tapverse`): whether they were on one.
rp_tap_keys_verse(pane: *ReaderPane): bool {
    match pane.keys {
        OnVerse o -> {
            tc_str("tapverse ");
            tc_int(o.c);
            tc_byte(32);
            tc_int(rp_anchor_verse(pane, o.c, o.k, o.anchor));
            tc_end();
            true
        }
        _ -> false
    }
}

// The link the keys are on opened: whether they were on one.
rp_open_keys_link(pane: *ReaderPane): bool {
    match pane.keys {
        OnLink l -> {
            rp_open_link(pane, l.c, l.k, l.link);
            true
        }
        _ -> false
    }
}

// The keys let go of what they are on: whether they were on something.
rp_keys_clear(pane: *ReaderPane): bool {
    on: bool = match pane.keys {
        NoKeys -> false;
        _ -> true
    };
    pane.keys = KeysOn.NoKeys;
    pane.dirty = true;
    on
}

// The keys off a link (a click elsewhere).
rp_keys_off_link(pane: *ReaderPane) {
    match pane.keys {
        OnLink _l -> pane.keys = KeysOn.NoKeys;
        _ -> { }
    }
}

// The next link in sight (d 1) or the one before (-1), for the keys; the
// first (or last) if they aren't on one.
rp_next_link(pane: *ReaderPane, d: int) {
    on_c: int = -1;
    on_k: int = 0;
    on_link: int = -1;
    match pane.keys {
        OnLink l -> {
            on_c = l.c;
            on_k = l.k;
            on_link = l.link
        }
        _ -> { }
    }
    take_next: bool = on_c < 0;
    found: KeysOn = KeysOn.NoKeys;
    found_any: bool = false;
    prev: KeysOn = KeysOn.NoKeys;
    at: LineAt = rp_row_line(pane, 0);
    for _r in 0..pane.rows {
        match at {
            Shown a -> {
                info: SlotPart = rp_slot_part(pane, a.slot);
                last: int = -1;
                borrow pane.layouts[a.slot] as lay {
                    for j in lay.line_from[a.line]..lay.line_to[a.line] {
                        lk: int = ra_link(lay.cell_attr[j]);
                        if (lk >= 0 && lk != last && !found_any) {
                            last = lk;
                            here: KeysOn = KeysOn.OnLink { c: info.c, k: info.k, link: lk };
                            on: bool = info.c == on_c && info.k == on_k && lk == on_link;
                            if (d > 0) {
                                if (take_next) {
                                    found = here;
                                    found_any = true
                                } else if (on) take_next = true
                            } else {
                                if (on) {
                                    found = prev;
                                    found_any = true
                                }
                                prev = here
                            }
                        }
                    }
                }
            }
            _ -> { }
        }
        at = rp_line_after(pane, at)
    }
    if (d < 0 && !found_any && on_c < 0) found = prev;
    pane.keys = found;
    pane.dirty = true
}

// ---- moved by the app ----
// Listen's verse kept in sight (`follow C V`): the page to it if it isn't on
// its rows (above the last two).
rp_keep_heard_in_sight(pane: *ReaderPane, c: int, v: int) {
    at: LineAt = rp_row_line(pane, 0);
    for _r in 0..pane.rows - 2 {
        match at {
            Shown a -> {
                if (rp_slot_part(pane, a.slot).c == c && rp_line_has_verse(pane, a.slot,
                    a.line, v)) return
            }
            _ -> { }
        }
        at = rp_line_after(pane, at)
    }
    rp_go_verse(pane, c, v)
}

rp_line_has_verse(
    pane: *ReaderPane,
    s: int,
    line: int,
    v: int
): bool {
    borrow pane.layouts[s] as lay {
        for j in lay.line_from[line]..lay.line_to[line]
            if (ra_verse(lay.cell_attr[j]) == v) return true;
        false
    }
}

// ---- link maps ----
// The link maps core has sent since a pane's document last changed (its
// `link C MODE`, `match I0 I1 J` lines and `end`), a chapter's each: core
// sends each chapter's once (as either pane's place comes near it) until
// it forgets them (`forget P -1`), and a chapter's sent again replaces it.
rp_link_maps: []?owned *LinkMap = new ?owned *LinkMap[0](null);

// `reader N`: the Bible's chapters, a link map's room for each (kept for
// the program's life, so not in a region).
rp_set_chapters(n: int) noregion {
    rp_link_maps_forget();
    if (n != len(rp_link_maps)) rp_link_maps = new ?owned *LinkMap[n](null);
    rp_chapters = n
}

// Whether chapter c's link map is here.
rp_link_map_here(c: int): bool {
    c >= 0 && c < len(rp_link_maps) && rp_link_maps[c] != null
}

// The link map gathered kept, in place of its chapter's.
rp_take_link_map() {
    c: int = -1;
    borrow rp_gathered as lines {
        c = wl_num(lines.bytes, 0, rp_first_line_end(lines), 1)
    }
    if (c < 0 || c >= len(rp_link_maps)) return;
    drop rp_link_maps[c];
    rp_link_maps[c] = rp_gathered_link_map()
}

// `forget P -1`: every link map let go.
rp_link_maps_forget() {
    for c in 0..len(rp_link_maps)
        drop rp_link_maps[c]
}

rp_gathered_link_map(): owned *LinkMap {
    own {
        map: *LinkMap = new LinkMap {
            mode: LINK_BY_VERSE,
            i0: new int[0](0),
            i1: new int[0](0),
            j: new int[0](0)
        };
        borrow rp_gathered as lines {
            rp_link_map_read(map, lines)
        }
        map
    }
}

// A link map read from its lines: its mode, then its matches, counted,
// then read into lists made for them.
rp_link_map_read(map: *LinkMap@new, lines: *PartLines) {
    raw: []i8 = lines.bytes;
    n: int = lines.count;
    first: int = rp_first_line_end(lines);
    map.mode = wl_num(raw, 0, first, 2);
    matches: int = 0;
    p: int = first + 1;
    while (p < n) {
        e: int = p;
        while (e < n && raw[e] as int != 10) e = e + 1;
        if (wl_is(raw, p, e, "match")) matches = matches + 1;
        p = e + 1
    }
    map.i0 = new int[matches](0);
    map.i1 = new int[matches](0);
    map.j = new int[matches](0);
    matches = 0;
    p = first + 1;
    while (p < n) {
        e: int = p;
        while (e < n && raw[e] as int != 10) e = e + 1;
        if (wl_is(raw, p, e, "match")) {
            map.i0[matches] = wl_num(raw, p, e, 1);
            map.i1[matches] = wl_num(raw, p, e, 2);
            map.j[matches] = wl_num(raw, p, e, 3);
            matches = matches + 1
        }
        p = e + 1
    }
}

// ---- following ----
// Linked (SKINS.md, Panes: Linked), the pane a hand last moved leads;
// each of its moves owes the other a following, made before the panes
// are next drawn (or, while the leader's chapter's link map is still to
// come, once it has come).
type Following = {
    leader: int;
    owed: bool
}

rp_following: Following = Following { leader: PANE_PAGE, owed: false };

// What the follower does, by core/follow.l8's rules: wait (its chapter's
// link map still to come), stay, move by rows, or go to a place.
type FollowMove =
    | Wait
    | Stay
    | ByRows { rows: int }
    | ToPlace { c: int, i: int, frac: int }

// The follower placed by the leader, if a following is owed and the
// panel's reader is linked with the page (linked: its screen says so).
rp_follow_leader(linked: bool) {
    if (!rp_following.owed) return;
    leader: *ReaderPane = reader_pane(rp_following.leader);
    follower: *ReaderPane = reader_pane(1 - rp_following.leader);
    if (!linked || leader.text_width == 0 || follower.text_width == 0) {
        rp_following.owed = false;
        return
    }
    match rp_follow_move(leader, follower) {
        Wait -> return;
        Stay -> { }
        ByRows b -> rp_follower_by_rows(follower, b.rows);
        ToPlace t -> rp_go(follower, t.c, t.i, t.frac)
    }
    rp_following.owed = false
}

// The follower moved rows down (up, rows < 0), as far as its parts here
// go: where it was to go given up.
rp_follower_by_rows(follower: *ReaderPane, rows: int) {
    at: LineAt = rp_place_line(follower);
    match at {
        Shown _s -> { }
        _ -> return
    }
    follower.pending = PendingMove.Settled;
    was: ReadingPlace = follower.place;
    rp_place_at_line(follower, rp_lines_on_within(follower, at, rows));
    if (!rp_same_place(was, follower.place)) rp_moved(follower, PANE_MOVED_BY_APP)
}

rp_follow_move(leader: *ReaderPane, follower: *ReaderPane): FollowMove {
    s: int = rp_place_slot(leader);
    if (s < 0) return FollowMove.Stay;
    info: SlotPart = rp_slot_part(leader, s);
    c: int = info.c;
    // (A commentary leading in a run of chapters it says nothing on: by
    // core/follow.l8's follow_run_chapter.)
    if (info.gap_to >= 0) {
        to: int = follow_run_chapter(c, info.gap_to, rp_place_chapter(follower));
        return if (to < 0) FollowMove.Stay else FollowMove.ToPlace { c: to, i: -1, frac: 0 }
    }
    if (!rp_link_map_here(c)) return FollowMove.Wait;
    mode: int = LINK_BY_VERSE;
    borrow rp_link_maps[c] as map {
        mode = map.mode
    }
    if (mode == LINK_BY_VERSE) return rp_follow_by_verse(leader, follower, c);
    if (leader.index == PANE_PAGE) rp_commentary_from_page(leader, follower, c) else rp_page_from_commentary(leader,
        follower, c)
}

// The chapter of a pane's place (-1: not placed).
rp_place_chapter(pane: *ReaderPane): int {
    match pane.place {
        Unplaced -> -1;
        At p -> p.c
    }
}

// A version following, by chapter c's link map: through the pairs both
// panes have laid out (each one's rows from its own reading line, the
// leader's line at 0); past them, to the follower's anchor matched with
// the leader's.
rp_follow_by_verse(leader: *ReaderPane, follower: *ReaderPane, c: int): FollowMove {
    step: FollowMove = FollowMove.Stay;
    page_leads: bool = leader.index == PANE_PAGE;
    region {
        leader_run: PartRun = rp_part_run(leader, c);
        leader_shape: ChapterShape = rp_chapter_shape(leader, &leader_run, c);
        follower_run: PartRun = rp_part_run(follower, c);
        follower_shape: ChapterShape = rp_chapter_shape(follower, &follower_run, c);
        borrow rp_link_maps[c] as map {
            pairs: FollowPairs = if (page_leads) follow_pairs(map, &leader_shape,
                &follower_shape, true) else follow_pairs(map, &follower_shape, &leader_shape,
                false);
            at: FollowPlace = follow_by_verse(&pairs, 0.0f64, leader_shape.em, follower_shape.em);
            if (at.ok) step = FollowMove.ByRows { rows: rp_rounded(at.y) } else {
                i: int = rp_anchor_at_row(&leader_shape, 0.0f64);
                span: AnchorSpan = rp_anchor_span(&leader_shape, i);
                frac: int = if (span.known) (-span.from * 1000.0f64 / (span.to - span.from)) as int else 0;
                step = rp_matched_place(map, c, i, frac, page_leads)
            }
        }
    }
    step
}

rp_rounded(y: f64): int {
    if (y >= 0.0f64) (y + 0.5f64) as int else -(0.5f64 - y) as int
}

// The follower's anchor matched with the leader's anchor i (the page's,
// if page_leads), as far through it (a verse it lacks: the start of the
// one matched before it; -1, the chapter's top).
rp_matched_place(
    map: *LinkMap,
    c: int,
    i: int,
    frac: int,
    page_leads: bool
): FollowMove {
    to: int = -1;
    exact: bool = i < 0;
    for k in 0..len(map.j) {
        from_i: int = if (page_leads) map.i0[k] else map.j[k];
        to_i: int = if (page_leads) map.i1[k] else map.j[k];
        other: int = if (page_leads) map.j[k] else map.i0[k];
        if (!exact && from_i <= i && i <= to_i) {
            to = other;
            exact = true
        } else if (!exact && to_i < i) to = other
    }
    FollowMove.ToPlace { c: c, i: to, frac: if (exact) frac else 0 }
}

// The commentary led by the page: it stays while one of its comments at
// its reading line covers the page's verse there, else goes to the one
// covering it nearest its reading line (in another chapter: to the
// page's chapter's top, if none does). In a run of chapters it says
// nothing on that holds the page's, it stays.
rp_commentary_from_page(page: *ReaderPane, commentary: *ReaderPane, c: int): FollowMove {
    s: int = rp_place_slot(commentary);
    if (s >= 0) {
        held: SlotPart = rp_slot_part(commentary, s);
        if (held.gap_to >= 0 && held.c <= c && c <= held.gap_to) return FollowMove.Stay
    }
    page_i: int = rp_anchor_index(rp_document_place(page));
    commentary_at: DocumentPlace = rp_document_place(commentary);
    same: bool = rp_place_in_chapter(commentary_at, c);
    if (!same && page_i < 0) return FollowMove.ToPlace { c: c, i: -1, frac: 0 };
    step: CommentStep = CommentStep.Stay;
    region {
        run: PartRun = rp_part_run(commentary, c);
        shape: ChapterShape = rp_chapter_shape(commentary, &run, c);
        borrow rp_link_maps[c] as map {
            step = follow_comment_from_page(map, page_i, if (same) rp_anchor_index(commentary_at) else -1,
                &shape, 0.0f64)
        }
    }
    rp_comment_step(step, c, same)
}

// The page led by the commentary: it stays on a verse the comment at the
// commentary's reading line covers, else goes to the comment's first.
rp_page_from_commentary(commentary: *ReaderPane, page: *ReaderPane, c: int): FollowMove {
    comment_j: int = rp_anchor_index(rp_document_place(commentary));
    page_at: DocumentPlace = rp_document_place(page);
    same: bool = rp_place_in_chapter(page_at, c);
    if (!same && comment_j < 0) return FollowMove.ToPlace { c: c, i: -1, frac: 0 };
    step: CommentStep = CommentStep.Stay;
    borrow rp_link_maps[c] as map {
        step = follow_page_from_comment(map, comment_j, if (same) rp_anchor_index(page_at) else -1)
    }
    rp_comment_step(step, c, same)
}

// A step by comment as the follower's move (staying in another chapter:
// to chapter c's top).
rp_comment_step(step: CommentStep, c: int, same: bool): FollowMove {
    match step {
        Stay -> if (same) FollowMove.Stay else FollowMove.ToPlace { c: c, i: -1, frac: 0 };
        GoTo g -> FollowMove.ToPlace { c: c, i: g.anchor, frac: 0 }
    }
}

rp_anchor_index(place: DocumentPlace): int {
    match place {
        Unknown -> -1;
        Anchored a -> a.i
    }
}

rp_place_in_chapter(place: DocumentPlace, c: int): bool {
    match place {
        Unknown -> false;
        Anchored a -> a.c == c
    }
}
