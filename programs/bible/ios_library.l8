tag bible_ios;

use_tag std, ios, bible;

// The library's Round 3 parts: its bottom toolbar (Export on every
// segment, DESIGN.md §8.5; compose a chapter's note on the Notes segment,
// §8.4), and the highlights' color filter (§8.6).
import "../ios/objc.l8";

import "text.l8";

extern NSTemporaryDirectory(): int;

// ---- the toolbar ----
lib_export_item: int = 0;

lib_items: []int = new int[3](0);

// The toolbar's items for the segment shown (compose only on Notes), set
// with a fade when the segment changes.
lib_toolbar(vc: int, animated: bool) {
    if (vc == 0) return;
    // (Memory's: Practice and Add, not Export.)
    if (lib_seg == 3) {
        mm_lib_toolbar(vc, animated);
        return
    }
    if (lib_export_item == 0) {
        lib_export_item = keep(msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")),
            sel("initWithImage:style:target:action:"), symbol("square.and.arrow.up",
            17.0f64, 4, 0), 0, app_obj, sel("libraryExport:")), sel("autorelease")));
        msg1(lib_export_item, sel("setAccessibilityLabel:"), nsstring("Export Notes and Highlights"))
    }
    msg1(lib_export_item, sel("setEnabled:"), if (anything_kept()) 1 else 0);
    lib_items[0] = lib_export_item;
    n: int = 1;
    if (lib_seg == 1) {
        lib_items[1] = msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
            5, 0, 0), sel("autorelease"));
        compose: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
            symbol("square.and.pencil", 17.0f64, 4, 0), 0, app_obj, sel("libraryCompose:")),
            sel("autorelease"));
        msg1(compose, sel("setAccessibilityLabel:"), nsstring("Chapter Note"));
        lib_items[2] = compose;
        n = 3
    }
    msg2(vc, sel("setToolbarItems:animated:"), nsarray(lib_items, n), if (animated) 1 else 0)
}

// Compose: the note of the chapter at the top of the reader (its own, if
// it has one), over the library.
library_compose(_self: int, _cmd: int, _item: int): int {
    open_note(cur, 0, 0);
    0
}

// The export's file's name (Smooth Bible Notes 2026-10-18.md), into fbuf.
export_name(today: int) {
    fbuf_n = 0;
    fput_str("Smooth Bible Notes ");
    fput_iso_date(today);
    fput_str(".md")
}

// Export: everything kept, as Markdown in a file of today's date, given to
// the share sheet. (The demo keeps a copy in Documents, for the CI.)
library_export(_self: int, _cmd: int, item: int): int {
    if (!anything_kept()) return 0;
    help_used("export");
    today: int = local_day(time(0));
    export_name(today);
    name: int = keep(fstring());
    ensure_quotable();
    export_notes(today);
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    path: int = msg1(NSTemporaryDirectory(), sel("stringByAppendingPathComponent:"),
        name);
    msg2(data, sel("writeToFile:atomically:"), path, 1);
    if (demo_on) {
        docs: int = msg(NSSearchPathForDirectoriesInDomains(9, 1, 1), sel("firstObject"));
        if (docs != 0) msg2(data, sel("writeToFile:atomically:"), msg1(docs, sel("stringByAppendingPathComponent:"),
            name), 1)
    }
    release(name);
    one[0] = msg1(cls("NSURL"), sel("fileURLWithPath:"), path);
    vc: int = msg2(msg(cls("UIActivityViewController"), sel("alloc")), sel("initWithActivityItems:applicationActivities:"),
        nsarray(one, 1), 0);
    pop: int = msg(vc, sel("popoverPresentationController"));
    if (pop != 0 && item != 0) msg1(pop, sel("setBarButtonItem:"), item);
    host: int = top_presented();
    msg3(if (host != 0) host else nav, sel("presentViewController:animated:completion:"),
        vc, 1, 0);
    release(vc);
    0
}

// ---- the highlights' color filter ----
// The color shown (-1: all of them).
lib_filter: int = -1;

lib_filter_row: int = 0;

lib_all_button: int = 0;

lib_rings: []int = new int[5](0);

lib_dots: []int = new int[5](0);

// The filter's row, as the highlights' table header: All, then a circle a
// color.
lib_filter_header(W: f64): int {
    box: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, W, 52.0f64), sel("autorelease"));
    row: int = stack(0, 12.0f64);
    msg1(row, sel("setAlignment:"), 3);
    lib_filter_row = row;
    lib_all_button = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        msg(cls("UIButtonConfiguration"), sel("grayButtonConfiguration")), 0);
    msg3(lib_all_button, sel("addTarget:action:forControlEvents:"), app_obj, sel("libraryFilter:"),
        64);
    msg1(lib_all_button, sel("setTag:"), -1);
    msg1(lib_all_button, sel("setAccessibilityLabel:"), nsstring("Show All Highlights"));
    msg1(row, sel("addArrangedSubview:"), lib_all_button);
    for i in 0..5 {
        // (The ring, 2 points out from the circle, around it.)
        ring: int = make("UIView");
        msg1(ring, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        pin_size(ring, "widthAnchor", 36.0f64);
        pin_size(ring, "heightAnchor", 36.0f64);
        rl: int = msg(ring, sel("layer"));
        msg_set_f(rl, sel("setCornerRadius:"), 18.0f64);
        msg_set_f(rl, sel("setBorderWidth:"), 2.0f64);
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(b, sel("setTag:"), i);
        msg1(b, sel("setBackgroundColor:"), c_swatch[i]);
        msg_set_f(msg(b, sel("layer")), sel("setCornerRadius:"), 14.0f64);
        fbuf_n = 0;
        fput_str("Show ");
        fput_str(hl_titles[i]);
        fput_str(" Highlights");
        msg1(b, sel("setAccessibilityLabel:"), fstring());
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("libraryFilter:"),
            64);
        msg1(ring, sel("addSubview:"), b);
        pin_size(b, "widthAnchor", 28.0f64);
        pin_size(b, "heightAnchor", 28.0f64);
        pin_to(b, "centerXAnchor", ring, "centerXAnchor", 0.0f64);
        pin_to(b, "centerYAnchor", ring, "centerYAnchor", 0.0f64);
        msg1(row, sel("addArrangedSubview:"), ring);
        release(ring);
        lib_rings[i] = ring;
        lib_dots[i] = b
    }
    msg1(box, sel("addSubview:"), row);
    pin_by(row, box, "leadingAnchor", 16.0f64);
    pin_to(row, "centerYAnchor", box, "centerYAnchor", 0.0f64);
    lib_filter_marks();
    box
}

// The filter's selection shown: All filled in the accent, or a color's
// ring and check.
lib_filter_marks() {
    if (lib_all_button == 0) return;
    all: bool = lib_filter < 0;
    config: int = msg(cls("UIButtonConfiguration"), sel(if (all) "filledButtonConfiguration" else "grayButtonConfiguration"));
    if (all) {
        msg1(config, sel("setBaseBackgroundColor:"), c_accent);
        msg1(config, sel("setBaseForegroundColor:"), on_accent())
    }
    msg1(config, sel("setCornerStyle:"), 4);
    msg1(config, sel("setTitle:"), nsstring("All"));
    msg1(lib_all_button, sel("setConfiguration:"), config);
    msg1(lib_all_button, sel("setAccessibilityTraits:"), if (all) 9 else 1);
    for i in 0..5 {
        on: bool = lib_filter == i;
        msg1(msg(lib_rings[i], sel("layer")), sel("setBorderColor:"), msg(if (on) c_accent else msg(cls("UIColor"),
            sel("clearColor")), sel("CGColor")));
        msg2(lib_dots[i], sel("setImage:forState:"), if (on) symbol("checkmark", 11.0f64,
            7, msg(cls("UIColor"), sel("whiteColor"))) else 0, 0);
        msg1(lib_dots[i], sel("setAccessibilityTraits:"), if (on) 9 else 1)
    }
}

// A color tapped (again, or All: every color).
library_filter(_self: int, _cmd: int, b: int): int {
    i: int = msg(b, sel("tag"));
    lib_filter = (if (i < 0 || i == lib_filter) -1 else i);
    if (lib_filter_row != 0) {
        t: int = make("CATransition");
        msg1(t, sel("setType:"), objc_const("kCATransitionFade"));
        msg_set_f(t, sel("setDuration:"), 0.15f64);
        msg2(msg(lib_filter_row, sel("layer")), sel("addAnimation:forKey:"), t, 0);
        release(t)
    }
    lib_filter_marks();
    haptic_select();
    lib_build();
    lib_reload(true);
    0
}

// The table's header: the segments (Highlights, Notes, Bookmarks) on a row
// of their own, the width of the list, so each reads in full beside the
// bar's glass buttons (iOS 26), and under them the filter on Highlights.
// One box, kept while the library is shown: the filter's row put in or
// taken out, the box given its new height and set again.
lib_box: int = 0;

lib_filter_box: int = 0;

LIB_SEG_ROW: f64 = 48.0f64;

lib_header() {
    if (lib_table == 0) return;
    W: f64 = view_width(lib_table);
    if (lib_box == 0) {
        lib_box = make("UIView");
        msg_rect(lib_box, sel("setFrame:"), 0.0f64, 0.0f64, W, LIB_SEG_ROW);
        // (Pinned to the box's sides, as the list's width is not yet known
        // when the sheet is made.)
        msg1(seg_control, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(lib_box, sel("addSubview:"), seg_control);
        pin_by(seg_control, lib_box, "leadingAnchor", 16.0f64);
        pin_by(seg_control, lib_box, "trailingAnchor", -16.0f64);
        pin_by(seg_control, lib_box, "topAnchor", 6.0f64);
        pin_size(seg_control, "heightAnchor", 32.0f64);
        lib_filter_box = 0
    }
    if (lib_filter_box != 0) {
        msg(lib_filter_box, sel("removeFromSuperview"));
        lib_filter_box = 0
    }
    h: f64 = LIB_SEG_ROW;
    if (lib_seg == 0) {
        lib_filter_box = lib_filter_header(W);
        msg_rect(lib_filter_box, sel("setFrame:"), 0.0f64, LIB_SEG_ROW - 4.0f64, W,
            52.0f64);
        msg1(lib_filter_box, sel("setAutoresizingMask:"), 2);
        msg1(lib_box, sel("addSubview:"), lib_filter_box);
        h = LIB_SEG_ROW + 48.0f64
    } else {
        lib_filter_row = 0;
        lib_all_button = 0
    }
    msg_rect(lib_box, sel("setFrame:"), 0.0f64, 0.0f64, W, h);
    msg1(lib_table, sel("setTableHeaderView:"), lib_box)
}

// The library gone: its header let go.
lib_header_gone() {
    release(lib_box);
    lib_box = 0;
    lib_filter_box = 0
}

add_library_methods(app: int) {
    add_method1(app, sel("libraryExport:"), &library_export, "v@:@");
    add_method1(app, sel("libraryCompose:"), &library_compose, "v@:@");
    add_method1(app, sel("libraryFilter:"), &library_filter, "v@:@")
}
