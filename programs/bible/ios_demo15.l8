tag bible_ios;

use_tag std, ios, bible;

// The demo's §15 steps (DESIGN.md §15.7): the `help` group, shots 400 to
// 419, on the demo clock, from a fresh install with tips on (every other
// group turns them off before its first launch): Go To's first tip, Next,
// the same tip on the same day and the next one the next day, the
// highlight tips skipped once John 3:16 is highlighted, a tip's action
// (New Ribbon…) and More (the Ribbons page at Making one, washed),
// Reading settings' Help, the Manual's contents, a page, a link, the
// search, tips off and on, Night, the largest text, the Greek and Hebrew
// and Memory pages, every tip seen; and the recording of sequence 20.
// Each tap is made through the function the control calls.
import "../ios/objc.l8";

import "text.l8";

import "help.l8";

// The page and the part of an anchor ("ribbons#making"; -1 none).
d15_part(anchor: str): int {
    help_load();
    for t in 0..hpt_n {
        fbuf_n = 0;
        help_fput_anchor(t);
        if (fbuf_n == len(anchor)) {
            same: bool = true;
            for i in 0..len(anchor)
                if (fbuf[i] != anchor[i]) same = false;
            if (same) return t
        }
    }
    -1
}

d15_page(anchor: str): int {
    t: int = d15_part(anchor);
    if (t < 0) -1 else hpt_page[t]
}

// The tip of an id made current, today.
d15_current(id: str) {
    help_load();
    for i in 0..len(id) hw[i] = id[i];
    i: int = help_tip_named(hw, len(id));
    if (i < 0) return;
    help_make_current(i, today());
    help_state_save()
}

// Go To opened afresh (any sheet put away first).
d15_reopen(d: int) {
    if (presented() != 0) {
        demo_dismiss();
        demo_later_at(0.6f64, d);
        return
    }
    open_picker()
}

// The page on top's slot (-1: none).
d15_top_page(): int {
    top: int = top_presented();
    if (top == 0 || !responds(top, "topViewController")) return -1;
    help_slot_of_vc(msg(top, sel("topViewController")))
}

// A link in the page on top tapped where it is drawn: the one to part t.
d15_tap_link(t: int) {
    k: int = d15_top_page();
    if (k < 0) return;
    tv: int = hpv_tv[k];
    storage: int = msg(tv, sel("textStorage"));
    n: int = msg(storage, sel("length"));
    key: int = nsstring(k_help_link);
    for i in 0..n {
        v: int = msg3(storage, sel("attribute:atIndex:effectiveRange:"), key, i, 0);
        if (v != 0 && msg(v, sel("longValue")) == t + 1 && range_rect(tv, i, 1)) {
            x: f64 = hfa[0] + hfa[2] / 2.0f64;
            y: f64 = hfa[1] + hfa[3] / 2.0f64;
            // (Seen there as the tap would find it.)
            found: int = link_at(tv, x, y, k_help_link) - 1;
            note_num("bible: demo link found part ", found);
            if (found >= 0) help_follow(k, found);
            return
        }
    }
    note("bible: demo link not found")
}

demo_do15(t: int) {
    if (t == 440) {
        // 400: a fresh install; the title tapped.
        demo_dismiss();
        open_picker()
    }
    if (t == 441) {
        // 401: Next.
        _r: int = help_tip_next(0, 0, 0)
    }
    if (t == 442) {
        // 402: Go To closed and opened again.
        demo_dismiss();
        demo_later_at(0.6f64, 800)
    }
    if (t == 443) {
        // 403: the next day.
        demo_day_shift = 1;
        d15_reopen(800)
    }
    if (t == 444) {
        // 404: John 3:16 highlighted; the next day.
        demo_dismiss();
        go_verse(john3(), 16);
        demo_verses[0] = 16;
        apply_highlight(john3(), demo_verses, 1, 0);
        demo_day_shift = 2;
        demo_later_at(0.8f64, 800)
    }
    if (t == 445) {
        // 405: ribbon-new made current; its New Ribbon….
        demo_dismiss();
        d15_current("ribbon-new");
        demo_no_keyboard = true;
        demo_later_at(0.6f64, 801)
    }
    if (t == 446) {
        // 406: back; More.
        demo_no_keyboard = false;
        top: int = top_presented();
        if (top != 0) msg1(top, sel("popToRootViewControllerAnimated:"), 0);
        demo_later_at(0.5f64, 802)
    }
    if (t == 447) {
        // 407: Reading settings, at Help.
        demo_dismiss();
        demo_later_at(0.6f64, 803)
    }
    if (t == 448) {
        // 408: Manual.
        settings_picked(7, 0)
    }
    if (t == 449) {
        // 409: Selecting Verses.
        help_picked(mn_table, 0, d15_page("tray#select"))
    }
    if (t == 450) {
        // 410: its link to Memory.
        d15_tap_link(d15_part("memory#adding"))
    }
    if (t == 451) {
        // 411: back to the contents; "ribbon" searched.
        top: int = top_presented();
        if (top != 0 && mn_vc != 0) msg2(top, sel("popToViewController:animated:"),
            mn_vc, 0);
        demo_later_at(0.5f64, 805)
    }
    if (t == 452) {
        // 412: Show Tips off (as its switch); Go To.
        demo_dismiss();
        set_def_bool("showTips", false);
        note("bible: show tips off");
        demo_later_at(0.6f64, 800)
    }
    if (t == 453) {
        // 413: on again; Go To.
        demo_dismiss();
        set_def_bool("showTips", true);
        note("bible: show tips on");
        demo_later_at(0.6f64, 800)
    }
    if (t == 454) {
        // 414: Night; Go To.
        demo_dismiss();
        set_theme = 4;
        settings_changed(true);
        demo_later_at(0.6f64, 800)
    }
    if (t == 455) {
        // 414b: a page in it (Selecting Verses: its symbols).
        help_open_page(d15_page("tray#select"), -1, false)
    }
    if (t == 456) {
        // 415: (the largest text) Auto again; Go To.
        demo_dismiss();
        set_theme = 0;
        settings_changed(true);
        demo_later_at(0.6f64, 800)
    }
    if (t == 457) {
        // 416: (the largest text) a page.
        help_open_page(d15_page("tray#select"), -1, false)
    }
    if (t == 458) {
        // 417: Reading settings → Manual → Greek and Hebrew.
        demo_dismiss();
        d15_after = d15_page("languages#start");
        demo_later_at(0.6f64, 806)
    }
    if (t == 459) {
        // 418: Manual → Memory.
        top: int = top_presented();
        if (top != 0 && mn_vc != 0) msg2(top, sel("popToViewController:animated:"),
            mn_vc, 0);
        help_open_page(d15_page("memory#adding"), -1, false)
    }
    if (t == 460) {
        // 419: every tip seen, the last current yesterday; Go To.
        demo_dismiss();
        help_load();
        for i in 0..htp_n ht_seen[i] = true;
        help_make_current(htp_order[htp_n - 1], today() - 1);
        for i in 0..htp_n ht_seen[i] = true;
        help_state_save();
        note("bible: demo every tip seen");
        demo_later_at(0.6f64, 800)
    }
    if (t == 461) {
        // Sequence 20's setup: Go To put away, goto-type current.
        demo_dismiss();
        d15_current("goto-type")
    }
    if (t == 462) {
        // Sequence 20: Go To; Next twice; More; back; closed.
        open_picker();
        demo_later_at(1.2f64, 820)
    }
    if (t == 463) {
        demo_dismiss();
        note("bible: demo sequence 20 done")
    }
}

// The page to open after the Manual (417's).
d15_after: int = -1;

demo_later15(d: int) {
    if (d == 800) {
        d15_reopen(800);
        return
    }
    if (d == 801) {
        if (presented() != 0) {
            demo_dismiss();
            demo_later_at(0.6f64, 801);
            return
        }
        open_picker();
        demo_later_at(0.9f64, 804);
        return
    }
    if (d == 804) {
        _r: int = help_tip_action(0, 0, 0);
        return
    }
    if (d == 802) {
        _r: int = help_tip_more(0, 0, 0);
        return
    }
    if (d == 803) {
        if (presented() != 0) {
            demo_dismiss();
            demo_later_at(0.6f64, 803);
            return
        }
        open_settings();
        demo_later_at(0.9f64, 807);
        return
    }
    if (d == 807) {
        if (settings_table != 0) msg3(settings_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
            msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 1, 7), 2,
            0);
        return
    }
    if (d == 805) {
        if (mn_search == 0) return;
        msg1(mn_search, sel("setActive:"), 1);
        bar: int = msg(mn_search, sel("searchBar"));
        msg1(bar, sel("setText:"), nsstring("ribbon"));
        _f: bool = help_search_updated(mn_search);
        msg(bar, sel("resignFirstResponder"));
        return
    }
    if (d == 806) {
        if (presented() != 0) {
            demo_dismiss();
            demo_later_at(0.6f64, 806);
            return
        }
        open_settings();
        demo_later_at(0.9f64, 808);
        return
    }
    if (d == 808) {
        help_open_manual();
        demo_later_at(0.8f64, 809);
        return
    }
    if (d == 809) {
        if (d15_after >= 0) help_open_page(d15_after, -1, false);
        return
    }
    // Sequence 20: a step every 1.2 s.
    if (d == 820 || d == 821) {
        _r: int = help_tip_next(0, 0, 0);
        demo_later_at(1.2f64, d + 1);
        return
    }
    if (d == 822) {
        _r: int = help_tip_more(0, 0, 0);
        demo_later_at(1.6f64, 823);
        return
    }
    if (d == 823) {
        top: int = top_presented();
        if (top != 0) msg1(top, sel("popViewControllerAnimated:"), 1);
        demo_later_at(1.2f64, 824);
        return
    }
    if (d == 824) {
        dismiss_sheets();
        return
    }
}
