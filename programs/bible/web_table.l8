tag bible_web;

use_tag std, bible, dom;

// The height table (WEB.md §W3.3): every chapter's height in the page, so
// the whole Bible is one scroller and a chapter is placed where the scroll
// position says it is. A height is estimated from the chapter's records
// (counting what layout_chapter would lay out, without laying it out, so
// the whole table takes milliseconds) with constants measured once from a
// calibration article; or measured exactly, by writing the chapter into a
// hidden box of the column's width; measured heights are kept in
// localStorage (sb.heights) under a key of everything they depend on.
import "text.l8";

import "html.l8";

import "../web/dom.l8";

import "estimate.l8";

// A line of ordinary text, for a font's average character.
SAMPLE: str = "And God said, Let there be light, and there was light. And God saw that the light was good.";

// The measuring box (hidden, the column's width, in <main>).
t_box: int = 0;

t_rect: []f64 = new f64[8](0.0f64);

t_rects: []f64 = new f64[1024](0.0f64);

// One character eight times (spaces kept), for its width.
h_char8(cp: int) {
    h_str("<span class=\"c\">");
    for _i in 0..8 {
        if (cp < 128) h_char(cp) else if (cp < 2048) {
            h_byte(192 | cp >> 6);
            h_byte(128 | cp & 63)
        } else {
            h_byte(224 | cp >> 12);
            h_byte(128 | cp >> 6 & 63);
            h_byte(128 | cp & 63)
        }
    }
    h_str("</span>")
}

// The constants measured in the hidden box: each kind's block with one
// line (its heights, margins and line widths) and, for each font, every
// character's width; the openers; a stanza's gap.
calibrate() {
    hb_n = 0;
    h_str("<article class=\"ch cal\">");
    for k in 0..KS {
        h_str(if (k == K_S) "<h3 class=\"s\">" else if (k == K_SS) "<h4 class=\"ss\">" else "<p class=\"");
        if (k != K_S && k != K_SS) {
            h_str(kind_classes[k]);
            h_str("\">")
        }
        if (k_font(k) == k) {
            for cp in 32..127 h_char8(cp);
            for x in EXTRA h_char8(x)
        } else h_str("<span class=\"c\">x</span>");
        h_str(if (k == K_S) "</h3>" else if (k == K_SS) "</h4>" else "</p>")
    }
    h_str("<p class=\"p gap\">x</p></article>");
    h_str("<article class=\"ch\"><hr class=\"div\"><h2 class=\"op\"><span class=\"lb\">John</span> <span class=\"nm\">3</span></h2></article>");
    h_str("<article class=\"ch\"><hr class=\"div\"><h2 class=\"op\"><span class=\"bk\">Exodus</span> <span class=\"nm one\">1</span></h2></article>");
    h_str("<article class=\"ch\"><hr class=\"div\"><h2 class=\"op\"><span class=\"bk\">Jude</span></h2></article>");
    h_str("<article class=\"ch\" data-c=\"0\"><h2 class=\"op\"><span class=\"bk\">Genesis</span> <span class=\"nm one\">1</span></h2></article>");
    dom_clear(t_box);
    dom_set_html_of(t_box, hb, 0, hb_n);
    cal: int = dom_query(t_box, "article.cal");
    el: int = dom_query(cal, "*");
    for k in 0..KS {
        k_lh[k] = dom_style_num(el, "line-height");
        k_mb[k] = dom_style_num(el, "margin-bottom");
        w: f64 = dom_get_prop(el, "clientWidth") - dom_style_num(el, "padding-left") - dom_style_num(el,
            "padding-right");
        k_w[k] = w;
        k_w1[k] = w - dom_style_num(el, "text-indent");
        if (k_font(k) == k) {
            n: int = dom_rects_all(el, ".c", t_rects);
            for i in 0..n
                if (i < NCH) cw_tab[k * NCH + i] = t_rects[4 * i + 2] / 8.0f64;
            // (Its height is one line's: the widths' many lines less the
            // rest.)
            dom_rect(el, t_rect);
            lines: f64 = round_f((t_rect[3] - dom_style_num(el, "padding-top") - dom_style_num(el,
                "padding-bottom")) / k_lh[k]);
            k_one[k] = t_rect[3] - (lines - 1.0f64) * k_lh[k]
        } else {
            dom_rect(el, t_rect);
            k_one[k] = t_rect[3]
        }
        next: int = dom_prop_handle(el, "nextElementSibling");
        dom_free(el);
        el = next
    }
    dom_rect(el, t_rect);
    gap_px = t_rect[3] - k_one[0];
    dom_free(el);
    for o in 0..4 {
        a: int = dom_query_nth(t_box, "article", o + 1);
        dom_rect(a, t_rect);
        o_h[o] = t_rect[3];
        dom_free(a)
    }
    dom_free(cal);
    dom_clear(t_box);
    // (Each font's average character, over a line of ordinary text, for
    // estimating from counts.)
    for k in 0..KS {
        f: int = k_font(k);
        w: f64 = 0.0f64;
        for ch in SAMPLE {
            i: int = ch_index(ch as int);
            w = w + cw_tab[f * NCH + (if (i < 0) 78 else i)]
        }
        avg_cw[k] = w / len(SAMPLE) as f64
    }
    cal_report()
}

// The constants, as window.sbCal (to see what a device measured).
cal_report() {
    tb_n = 0;
    for k in 0..KS {
        o_int((k_one[k] * 10.0f64) as int);
        o_byte(47);
        o_int((k_lh[k] * 10.0f64) as int);
        o_byte(47);
        o_int((k_mb[k] * 10.0f64) as int);
        o_byte(47);
        o_int((k_w1[k] * 10.0f64) as int);
        o_byte(47);
        o_int((k_w[k] * 10.0f64) as int);
        o_byte(47);
        o_int((cw_tab[k_font(k) * NCH + 69] * 100.0f64) as int);
        o_byte(32)
    }
    for o in 0..4 {
        o_int((o_h[o] * 10.0f64) as int);
        o_byte(32)
    }
    o_int((gap_px * 10.0f64) as int);
    dom_set_prop_of(DOM_WINDOW, "sbCal", tb_out, 0, tb_n)
}

extern l8_round_f(x: f64): f64 = round;

round_f(x: f64): f64 {
    l8_round_f(x)
}

// The nth element under h matching a selector (0 the first).
dom_query_nth(h: int, selector: str, n: int): int {
    k: int = dom_count(h, selector);
    if (n >= k) return 0;
    first: int = dom_query(h, selector);
    at: int = first;
    for _i in 0..n {
        nx: int = dom_prop_handle(at, "nextElementSibling");
        dom_free(at);
        at = nx
    }
    at
}

// ---- the table ----
ht: []f64 = new f64[1200](0.0f64);

est_h: []f64 = new f64[1200](0.0f64);

measured: []bool = new bool[1200](false);

// Where each chapter's top is in the scroller (pos[c + 1] its bottom).
pos: []f64 = new f64[1201](0.0f64);

// Every chapter estimated (and measured heights taken from storage).
estimate_all(lines: bool) {
    for c in 0..chapters {
        est_h[c] = (if (ch_verses[c] > 0 || !sz_ready) est_chapter(c, lines) else est_from_sizes(c));
        ht[c] = est_h[c];
        measured[c] = false
    }
    load_heights()
}

// Chapter c measured exactly in the hidden box: its height.
measure_one(c: int, lines: bool): f64 {
    hb_n = 0;
    html_chapter(r_text_t, c, lines);
    a: int = dom_insert_html_of(t_box, 2, hb, 0, hb_n);
    dom_rect(a, t_rect);
    hgt: f64 = t_rect[3];
    dom_remove(a);
    dom_free_tree(a);
    hgt
}

// The text the table is for (set by the reader).
r_text_t: int = 0;

// ---- kept heights (sb.heights: three keys, the newest first) ----
key: []i8 = new i8[256](0i8);

key_n: int = 0;

store_buf: []i8 = new i8[65536](0i8);

store_n: int = 0;

// The key (made by the reader from the version, the column's width, the
// settings and the browser's text size) is key's first key_n bytes.
load_heights() {
    n: int = dom_store_get("sb.heights", store_buf);
    if (n <= 0 || n > len(store_buf)) return;
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && store_buf[e] as int != 10) e = e + 1;
        t: int = p;
        while (t < e && store_buf[t] as int != 9) t = t + 1;
        same: bool = t - p == key_n;
        if (same) {
            for i in 0..key_n
                if (store_buf[p + i] != key[i]) same = false
        }
        if (same) {
            // (Heights in tenths of a px, 0 for one not measured.)
            c: int = 0;
            q: int = t + 1;
            while (q < e && c < chapters) {
                v: int = 0;
                while (q < e && store_buf[q] as int >= 48 && store_buf[q] as int <= 57) {
                    v = v * 10 + store_buf[q] as int - 48;
                    q = q + 1
                }
                if (v > 0) {
                    ht[c] = v as f64 / 10.0f64;
                    measured[c] = true
                }
                c = c + 1;
                q = q + 1
            }
            return
        }
        p = e + 1
    }
}

tb_out: []i8 = new i8[65536](0i8);

tb_n: int = 0;

o_byte(c: int) {
    if (tb_n < len(tb_out)) {
        tb_out[tb_n] = c trunc i8;
        tb_n = tb_n + 1
    }
}

o_int(n: int) {
    if (n >= 10) o_int(n / 10);
    o_byte(48 + n % 10)
}

// This key's measured heights kept first, the two other newest after.
save_heights() {
    tb_n = 0;
    for i in 0..key_n o_byte(key[i] as int);
    o_byte(9);
    for c in 0..chapters {
        if (c > 0) o_byte(44);
        if (measured[c]) o_int((ht[c] * 10.0f64 + 0.5f64) as int) else o_byte(48)
    }
    o_byte(10);
    n: int = dom_store_get("sb.heights", store_buf);
    kept: int = 0;
    p: int = 0;
    while (n > 0 && n <= len(store_buf) && p < n && kept < 2) {
        e: int = p;
        while (e < n && store_buf[e] as int != 10) e = e + 1;
        t: int = p;
        while (t < e && store_buf[t] as int != 9) t = t + 1;
        same: bool = t - p == key_n;
        if (same) {
            for i in 0..key_n
                if (store_buf[p + i] != key[i]) same = false
        }
        if (!same && e > p) {
            for i in p..e o_byte(store_buf[i] as int);
            o_byte(10);
            kept = kept + 1
        }
        p = e + 1
    }
    dom_store_set("sb.heights", tb_out, tb_n)
}
