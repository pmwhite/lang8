ref(s: str) raises IoError {
    b: []i8 = bytes(s);
    write(1, s);
    write(1, " = ");
    if (!parse_ref(b, len(b))) {
        print("none");
        return
    }
    write_bytes_n(1, slice_bsb(book_name_start(ref_book), book_name_end(ref_book)),
        book_name_end(ref_book) - book_name_start(ref_book));
    if (ref_chapter >= 0) {
        write(1, " ");
        write_int(1, ref_chapter)
    }
    if (ref_verse >= 0) {
        write(1, ":");
        write_int(1, ref_verse)
    }
    if (ref_verse_end >= 0) {
        write(1, "-");
        write_int(1, ref_verse_end)
    }
    print("")
}

slice_bsb(p: int, e: int): []i8 {
    for i in p..e slice_buf[i - p] = bsb[i];
    slice_buf
}

