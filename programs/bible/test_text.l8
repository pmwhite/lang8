        0 Jesus replied,|
        16  ‚ÄúIt is also written: ‚ÄòDo not put the Lord your God to the test.‚Äô|
        11 c|
        16 ‚Äù|
    |}
}

show_xref(s: str) raises IoError {
    fbuf_t_n = 0;
    for k in s fbuf_t[fbuf_t_n] = k;
    // (Copied into bsb's end, past the text, to be scanned there.)
    base: int = bsb_n + 16;
    for i in 0..len(s) bsb[base + i] = s[i];
    if (xref_scan(base, base + len(s))) {
        write_int(1, xr_book);
        write(1, " ");
        write_int(1, xr_c);
        write(1, ":");
        write_int(1, xr_v);
        write(1, " to ");
        write_int(1, xr_ce);
        write(1, ":");
        write_int(1, xr_ve);
        both: int = xref_both();
        xref_unpack(both);
        write(1, " = ");
        write_int(1, xr_book);
        write(1, " ");
        write_int(1, xr_c);
        write(1, ":");
        write_int(1, xr_v);
        write(1, " to ");
        write_int(1, xr_ce);
        write(1, ":");
        write_int(1, xr_ve);
        print("")
    } else print("none")
}

fbuf_t: []i8 = new i8[64](0i8);

fbuf_t_n: int = 0;

test "references in headings" {
    load();
    for s in ["John 1:1\‚\Ä\ì5", "Hebrews 11:1\‚\Ä\ì3", "Matthew 5:1\‚\Ä\ì7:29", "1 Chronicles 15:29\‚\Ä\ì16:3",
        "Song of Solomon 1:1\‚\Ä\ì17", "Jude 1:3\‚\Ä\ì16", "Psalm 23", "Psalm 23:1",
        "Joshua\‚\Ä\ìMalachi", "John 30:1", "John 3:99", "John 3:5\‚\Ä\ì2"] show_xref(s);
    expect {|
        42 1:1 to 1:5 = 42 1:1 to 1:5
        57 11:1 to 11:3 = 57 11:1 to 11:3
        39 5:1 to 7:29 = 39 5:1 to 7:29
        12 15:29 to 16:3 = 12 15:29 to 16:3
        21 1:1 to 1:17 = 21 1:1 to 1:17
        64 1:3 to 1:16 = 64 1:3 to 1:16
        18 23:0 to 0:0 = 18 23:0 to 23:0
        18 23:1 to 0:0 = 18 23:1 to 23:1
        none
        none
        none
        42 3:5 to 0:0 = 42 3:5 to 3:5
    |}
}

