test "a book begun" {
    load();
    for s in ["1 c", "jo", "ps", "song"] {
        write(1, s);
        write(1, ":");
        b: []i8 = bytes(s);
        for x in 0..66 {
            if (book_begins(x, b, len(b))) {
                write(1, " ");
                write_bytes_n(1, slice_bsb(book_name_start(x), book_name_end(x)),
                    book_name_end(x) - book_name_start(x))
            }
        }
        print("")
    }
    expect {|
        1 c: 1 Chronicles 1 Corinthians
        jo: Joshua Job Joel Jonah John
        ps: Psalms
        song: Song of Solomon
    |}
}

find(q: str, from: int, last: int) raises IoError {
    b: []i8 = bytes(q);
    search(b, len(b), from, last);
    write(1, q);
    write(1, ": ");
    write_int(1, hit_count);
    if (hit_more) write(1, "+");
    for i in 0..mini(hit_count, 4) {
        write(1, " ");
        title_of(hit_chapter[i]);
        print_out(0, out_n);
        write(1, ":");
        write_int(1, hit_verse[i])
    }
    print("")
}

test "search" {
    load();
    find("born again", 0, 65);
    find("\"born again\"", 0, 65);
    find("born again", 0, 38);
    find("Jesus wept", 39, 65);
    find("god\‚\Ä\ôs", 0, 65);
    find("god's love", 0, 65);
    find("shepherd*", 0, 65);
    find("the", 0, 65);
    find("", 0, 65);
    b: []i8 = bytes("born again");
    search(b, len(b), 0, 65);
    match_ranges(book_first[42] + 2, 3);
    print_vt();
    for i in 0..mr_count {
        write_bytes_n(1, slice_vt(mr_begin[i], mr_end[i]), mr_end[i] - mr_begin[i]);
        print("|")
    }
    expect {|
        born again: 4 Judges 13:8 John 3:3 John 3:7 1 Peter 1:23
        "born again": 3 John 3:3 John 3:7 1 Peter 1:23
        born again: 1 Judges 13:8
        Jesus wept: 4 Matthew 26:75 Mark 14:72 Luke 19:41 John 11:35
        god‚Äôs: 134 Genesis 23:6 Genesis 28:12 Genesis 28:22 Exodus 9:28
        god's love: 3 Ecclesiastes 9:1 2 Thessalonians 3:5 1 John 4:9
        shepherd*: 114 Genesis 29:3 Genesis 29:4 Genesis 29:9 Genesis 30:31
        the: 1000+ Genesis 1:1 Genesis 1:2 Genesis 1:4 Genesis 1:5
        : 0
        Jesus replied, ‚ÄúTruly, truly, I tell you, no one can see the kingdom of God unless he is born again.‚Äù|
        born|
        again|
    |}
}

slice_vt(p: int, e: int): []i8 {
    for i in p..e slice_buf[i - p] = vt[i];
    slice_buf
}

// The runs of verse v of the chapter laid out (from its number to its end).
show_verse_runs(v: int) raises IoError {
    i: int = verse_index(v);
    b: int = verse_begin[i];
    e: int = verse_end[i];
    p: int = 0;
    for r in 0..runs {
        if (run_end[r] > b && p < e) {
            write_int(1, run_style[r]);
            write(1, " ");
            from: int = if (p < b) b else p;
            to: int = if (run_end[r] > e) e else run_end[r];
            print_out(from, to);
            print("|")
        }
        p = run_end[r]
    }
}

