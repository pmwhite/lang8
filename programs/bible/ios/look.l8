tag bible_ios;

use_tag std, ios, bible;

// Smooth Bible's look: the themes (a table of colors, applied by hand
// wherever a color is used, since dynamic colors take a block), the fonts
// chosen in the settings, and each style's attributes for the text.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/look.l8";

// Messages with a float (not a CGFloat): a layer's opacity, a slider's
// value, a paragraph's hyphenation.
extern msg_set_f32(receiver: int, selector: int, value: f32): int = objc_msgSend;

extern msg_f32(receiver: int, selector: int): f32 = objc_msgSend;

extern msg_i_f_i(
    receiver: int,
    selector: int,
    a: int,
    x: f64,
    b: int
): int = objc_msgSend;

tab_pair: []int = new int[2](0);

extern msg_f_f(receiver: int, selector: int, x: f64): f64 = objc_msgSend;

extern UIGraphicsBeginImageContextWithOptions(
    w: f64,
    h: f64,
    opaque: int,
    scale: f64
): int;

extern UIRectFill(
    x: f64,
    y: f64,
    w: f64,
    h: f64
): int;

extern UIGraphicsGetImageFromCurrentImageContext(): int;

extern UIGraphicsEndImageContext(): int;

// ---- settings ----
// The theme chosen (0 Auto, 1 Paper, 2 White, 3 Sepia, 4 Night, 5 Black),
// and the one it is now (Auto is Paper in light mode, Night in dark).
set_theme: int = 0;

theme: int = 1;

// The font (0 New York, 1 Iowan, 2 Charter, 3 Georgia, 4 San Francisco),
// the text size's step (0 to 7, on top of the phone's), the line spacing
// (compact, normal, relaxed) and margins (narrow, normal, wide).
set_font: int = 0;

set_size: int = 2;

set_spacing: int = 1;

set_margins: int = 1;

font_names: []str = ["New York", "Iowan", "Charter", "Georgia", "San Francisco"];

// The colors now (UIColors, kept).
c_bg: int = 0;

c_ink: int = 0;

c_heading: int = 0;

c_faint: int = 0;

c_accent: int = 0;

c_rule: int = 0;

c_sel: int = 0;

c_flash: int = 0;

c_underline: int = 0;

// A glossed word's dotted line (the rule's color, a little firmer: the
// rule's own is a hairline's).
c_gloss_line: int = 0;

c_icon: int = 0;

c_sheet: int = 0;

c_cell: int = 0;

c_hl: []int = new int[5](0);

c_swatch: []int = new int[5](0);

// The rule between chapters: an attachment of a hairline's image.
rule_attachment: int = 0;

is_dark(): bool {
    theme >= 4
}

hex_digit(k: int): int {
    if (k >= 48 && k <= 57) return k - 48;
    if (k >= 65 && k <= 70) return k - 55;
    if (k >= 97 && k <= 102) return k - 87;
    0
}

// A color written as RRGGBB, with an alpha (autoreleased).
color_hex(s: str, alpha: f64): int {
    if (len(s) < 6) return 0;
    r: int = hex_digit(s[0] as int) * 16 + hex_digit(s[1] as int);
    g: int = hex_digit(s[2] as int) * 16 + hex_digit(s[3] as int);
    b: int = hex_digit(s[4] as int) * 16 + hex_digit(s[5] as int);
    msg_rect(cls("UIColor"), sel("colorWithRed:green:blue:alpha:"), r as f64 / 255.0f64,
        g as f64 / 255.0f64, b as f64 / 255.0f64, alpha)
}

release(object: int) {
    if (object != 0) msg(object, sel("release"))
}

// A kept color in place of the one before.
// A screen's table (or controller) held in a global: the new one kept, the
// old let go. (Popped, a list is freed while its global still names it:
// messaged then, from a theme's change or a timer, it would crash, and its
// address, reused by another list, would be taken for it. Every such global
// holds what it names, until its sheet has gone: DESIGN.md §10, builder
// notes.)
held(old: int, new_object: int): int {
    if (new_object != 0) msg(new_object, sel("retain"));
    release(old);
    new_object
}

swap_color(old: int, new_color: int): int {
    release(old);
    if (new_color == 0) return 0;
    keep(new_color)
}

// The theme that Auto is, with the phone in dark mode or not.
system_dark(): bool {
    traits: int = msg(msg(cls("UIScreen"), sel("mainScreen")), sel("traitCollection"));
    msg(traits, sel("userInterfaceStyle")) == 2
}

resolve_theme() {
    theme = (if (set_theme != 0) set_theme else if (system_dark()) 4 else 1)
}

// The colors of the theme now.
make_colors() {
    t: int = theme;
    c_bg = swap_color(c_bg, color_hex(t_bg[t], 1.0f64));
    c_ink = swap_color(c_ink, color_hex(t_ink[t], 1.0f64));
    c_heading = swap_color(c_heading, color_hex(t_heading[t], 1.0f64));
    c_faint = swap_color(c_faint, color_hex(t_faint[t], 1.0f64));
    c_accent = swap_color(c_accent, color_hex(t_accent[t], 1.0f64));
    c_rule = swap_color(c_rule, color_hex(t_rule[t], t_rule_alpha[t]));
    c_sel = swap_color(c_sel, color_hex(t_accent[t], t_sel_alpha[t]));
    c_flash = swap_color(c_flash, color_hex(t_ink[t], if (t >= 4) 0.14f64 else 0.09f64));
    c_underline = swap_color(c_underline, color_hex(t_accent[t], 0.7f64));
    c_gloss_line = swap_color(c_gloss_line, color_hex(t_rule[t], if (t >= 4) 0.4f64 else 0.32f64));
    c_icon = swap_color(c_icon, color_hex(t_ink[t], 0.85f64));
    c_sheet = swap_color(c_sheet, if (len(t_sheet[t]) > 0) color_hex(t_sheet[t], 1.0f64) else msg(cls("UIColor"),
        sel("systemGroupedBackgroundColor")));
    c_cell = swap_color(c_cell, if (len(t_cell[t]) > 0) color_hex(t_cell[t], 1.0f64) else msg(cls("UIColor"),
        sel("secondarySystemGroupedBackgroundColor")));
    for i in 0..5 {
        c_hl[i] = swap_color(c_hl[i], if (is_dark()) color_hex(hl_dark[i], hl_dark_alpha[i]) else color_hex(hl_light[i],
            hl_light_alpha[i]));
        if (c_swatch[i] == 0) c_swatch[i] = keep(color_hex(hl_swatch[i], 1.0f64))
    }
    // The hairline: a pixel of the rule's color, drawn 36 points wide.
    UIGraphicsBeginImageContextWithOptions(1.0f64, 1.0f64, 0, 1.0f64);
    msg(c_rule, sel("setFill"));
    UIRectFill(0.0f64, 0.0f64, 1.0f64, 1.0f64);
    image: int = UIGraphicsGetImageFromCurrentImageContext();
    UIGraphicsEndImageContext();
    release(rule_attachment);
    rule_attachment = make("NSTextAttachment");
    msg1(rule_attachment, sel("setImage:"), image)
}

// The background of a sheet's table and its cells, for the theme.
sheet_bg(): int {
    c_sheet
}

cell_bg(): int {
    c_cell
}

// The text on a control filled in the accent: white on the light themes'
// deep accents, the page's own black on the dark themes' pale ones (white
// there is under 3:1; the page's color is above 6:1).
on_accent(): int {
    if (is_dark()) c_bg else msg(cls("UIColor"), sel("whiteColor"))
}

// ---- the text's look ----
// The body's size in points (em): the phone's text size, times the step.
em: f64 = 19.0f64;

k_font: int = 0;

k_color: int = 0;

k_para: int = 0;

k_baseline: int = 0;

k_kern: int = 0;

k_background: int = 0;

k_underline: int = 0;

k_underline_color: int = 0;

k_attachment: int = 0;

k_link: str = "L8Link";

k_note_mark: str = "L8Note";

// A reference in the text (a heading's passages): its start and end, as
// one number (text.l8's xref_both); a chapter's note's mark.
k_xref: str = "L8Ref";

k_chapter_note: str = "L8ChapterNote";

// The words of Jesus in the accent (DESIGN.md §8.8; off at first).
red_letter: bool = false;

body_desc: int = 0;

fonts: []int = new int[STYLES](0);

// Whether small capitals are made by hand (smaller capitals, spaced): for
// fonts without small capitals of their own.
caps_by_hand: bool = false;

// For each style and paragraph kind (with a stanza's break or not, its
// apparatus after it or not), its paragraph style and attributes; and the
// same in the original's chapters (lay_orig) and right to left (the
// Hebrew's, lay_rtl), past one and two ATTRS_SET. Verse-line layouts
// have their own three sets so independent layout options cannot share
// paragraph attributes by mistake.
ATTRS_SET: int = STYLES * 32;

paras: []int = new int[STYLES * 192](0);

attrs: []int = new int[STYLES * 192](0);

layout_attrs_set(ctx: *ChapterLayout): int {
    base: int = if (ctx.lay_rtl) 2 * ATTRS_SET else if (ctx.lay_orig) ATTRS_SET else 0;
    base + (if (ctx.lay_verse_lines) 3 * ATTRS_SET else 0)
}

// The Hebrew and Greek's fonts (§14.11.3): Greek in New York at the
// reader's size, Hebrew in the system's (SF Hebrew) at 1.15 times it; the
// apparatus in SF at 0.78 em.
orig_fonts: []int = new int[4](0);

k_gloss: str = "L8Gloss";

keys: []int = new int[12](0);

values: []int = new int[12](0);

one_object: []int = new int[1](0);

// New York at size (the system's serif), whatever font is chosen: the
// Greek's.
new_york(size: f64): int {
    d: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
        objc_const("UIFontTextStyleBody"));
    serif_d: int = msg1(d, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), if (serif_d != 0) serif_d else d,
        size)
}

new_york_bold(size: f64): int {
    f: int = new_york(size);
    d: int = msg1(msg(f, sel("fontDescriptor")), sel("fontDescriptorWithSymbolicTraits:"),
        2);
    if (d == 0) f else msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

// A style's font: the Hebrew's own for the original's words in a Hebrew
// chapter.
layout_font_of(ctx: *ChapterLayout, style: int): int {
    if (ctx.lay_rtl && (style == STYLE_ORIG || style == STYLE_ORIG_GL)) return orig_fonts[0];
    if (ctx.lay_rtl && (style == STYLE_OTITLE || style == STYLE_OTITLE_GL)) return orig_fonts[1];
    fonts[style]
}

is_orig_style(style: int): bool {
    style == STYLE_ORIG || style == STYLE_ORIG_GL || style == STYLE_OTITLE || style == STYLE_OTITLE_GL || style == STYLE_QERE
}

// The font of the body at size (in the font chosen).
body(size: f64): int {
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), body_desc, size)
}

// The body font with symbolic traits (1 italic, 2 bold), or plain if it has
// no such face.
body_traits(size: f64, traits: int): int {
    d: int = msg1(body_desc, sel("fontDescriptorWithSymbolicTraits:"), traits);
    if (d == 0) d = body_desc;
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

italic(size: f64): int {
    body_traits(size, 1)
}

bold(size: f64): int {
    body_traits(size, 2)
}

// The body, light (New York's weight -0.2; other fonts as they are).
light(size: f64): int {
    if (set_font != 0) return body(size);
    keys[0] = objc_const("UIFontWeightTrait");
    values[0] = nsnumber_f(-0.2f64);
    keys[1] = objc_const("UIFontDescriptorTraitsAttribute");
    values[1] = nsdictionary(keys, values, 1);
    d: int = msg1(body_desc, sel("fontDescriptorByAddingAttributes:"), nsdictionary_at(keys,
        values, 1, 1));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

// A dictionary of keys[at] to values[at], n of them.
pair_keys: []int = new int[4](0);

pair_values: []int = new int[4](0);

nsdictionary_at(
    k: []int,
    v: []int,
    at: int,
    n: int
): int {
    for i in 0..n {
        pair_keys[i] = k[at + i];
        pair_values[i] = v[at + i]
    }
    nsdictionary(pair_keys, pair_values, n)
}

// The body with its capitals as small capitals (the font's own, through
// its feature for them: type 38, kUpperCaseType; selector 1, small caps).
small_caps(size: f64): int {
    keys[0] = objc_const("UIFontFeatureTypeIdentifierKey");
    values[0] = msg1(cls("NSNumber"), sel("numberWithLong:"), 38);
    keys[1] = objc_const("UIFontFeatureSelectorIdentifierKey");
    values[1] = msg1(cls("NSNumber"), sel("numberWithLong:"), 1);
    one: []int = one_object;
    one[0] = nsdictionary(keys, values, 2);
    keys[0] = objc_const("UIFontDescriptorFeatureSettingsAttribute");
    values[0] = nsarray(one, 1);
    d: int = msg1(body_desc, sel("fontDescriptorByAddingAttributes:"), nsdictionary(keys,
        values, 1));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

sans(size: f64, weight: f64): int {
    msg_ff(cls("UIFont"), sel("systemFontOfSize:weight:"), size, weight)
}

// The font chosen's descriptor (New York if it is not on the phone).
font_names_ps: []str = ["", "IowanOldStyle-Roman", "Charter-Roman", "Georgia", ""];

make_body_desc() {
    d: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
        objc_const("UIFontTextStyleBody"));
    serif_d: int = msg1(d, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
    if (serif_d == 0) serif_d = d;
    pick: int = serif_d;
    caps_by_hand = false;
    if (set_font == 4) pick = d else if (set_font > 0) {
        f: int = msg1_f(cls("UIFont"), sel("fontWithName:size:"), nsstring(font_names_ps[set_font]),
            17.0f64);
        if (f != 0) {
            pick = msg(f, sel("fontDescriptor"));
            caps_by_hand = true
        } else set_font = 0
    }
    release(body_desc);
    body_desc = keep(pick)
}

round_half(x: f64): f64 {
    (x * 2.0f64 + 0.5f64) as int as f64 / 2.0f64
}

// The fonts and the rest, for the settings and the phone's text size now.
make_look() {
    if (k_font == 0) {
        k_font = objc_const("NSFontAttributeName");
        k_color = objc_const("NSForegroundColorAttributeName");
        k_para = objc_const("NSParagraphStyleAttributeName");
        k_baseline = objc_const("NSBaselineOffsetAttributeName");
        k_kern = objc_const("NSKernAttributeName");
        k_background = objc_const("NSBackgroundColorAttributeName");
        k_underline = objc_const("NSUnderlineStyleAttributeName");
        k_underline_color = objc_const("NSUnderlineColorAttributeName");
        k_attachment = objc_const("NSAttachmentAttributeName")
    }
    make_body_desc();
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    em = round_half(msg_f_f(metrics, sel("scaledValueForValue:"), 19.0f64) * size_steps[set_size]);
    for i in 0..len(fonts) release(fonts[i]);
    fonts[STYLE_BODY] = keep(body(em));
    fonts[STYLE_VERSE] = keep(msg_ff(cls("UIFont"), sel("monospacedDigitSystemFontOfSize:weight:"),
        em * (if (lay_verse_lines) 0.62f64 else 0.58f64), 0.3f64));
    fonts[STYLE_BOOK] = keep(body(em * 2.0f64));
    fonts[STYLE_NUMERAL] = keep(light(em * 2.6f64));
    fonts[STYLE_NUMERAL1] = keep(light(em * 2.0f64));
    fonts[STYLE_HEAD] = keep(sans(em * 0.84f64, 0.4f64));
    fonts[STYLE_SUBHEAD] = keep(sans(em * 0.78f64, 0.23f64));
    fonts[STYLE_REF] = keep(italic(em * 0.76f64));
    fonts[STYLE_TITLE] = keep(italic(em * 0.92f64));
    fonts[STYLE_MAJOR] = keep(sans(em * 0.62f64, 0.3f64));
    fonts[STYLE_RANGE] = keep(italic(em * 0.78f64));
    fonts[STYLE_ACROSTIC] = keep(sans(em * 0.7f64, 0.3f64));
    fonts[STYLE_NOTE] = keep(sans(em * 0.56f64, 0.3f64));
    fonts[STYLE_BOOKLABEL] = keep(sans(em * 0.62f64, 0.3f64));
    fonts[STYLE_CAPS] = keep(if (caps_by_hand) body(em * 0.8f64) else small_caps(em));
    fonts[STYLE_JESUS] = keep(body(em));
    fonts[STYLE_JESUS_CAPS] = keep(if (caps_by_hand) body(em * 0.8f64) else small_caps(em));
    fonts[STYLE_XREF] = keep(italic(em * 0.76f64));
    // (A passage's heading in a plan's day: the section heading's, a step
    // larger; DESIGN.md §16.2.1.)
    fonts[STYLE_PASSAGE] = keep(sans(em * 1.0f64, 0.4f64));
    // (Words the translators supplied: italic, as printed KJVs set them.)
    fonts[STYLE_SUPPLIED] = keep(italic(em));
    fonts[STYLE_JESUS_SUPPLIED] = keep(italic(em));
    fonts[STYLE_RULE] = keep(sans(em * 0.5f64, 0.0f64));
    fonts[STYLE_ORIG] = keep(new_york(em));
    fonts[STYLE_ORIG_GL] = keep(new_york(em));
    fonts[STYLE_OTITLE] = keep(new_york(em * 0.92f64));
    fonts[STYLE_OTITLE_GL] = keep(new_york(em * 0.92f64));
    fonts[STYLE_QERE] = keep(sans(em * 0.6f64, 0.0f64));
    fonts[STYLE_APPARATUS] = keep(sans(em * 0.78f64, 0.0f64));
    fonts[STYLE_APP_ENTRY] = keep(sans(em * 0.78f64, 0.0f64));
    for i in 0..len(orig_fonts) release(orig_fonts[i]);
    orig_fonts[0] = keep(sans(em * 1.15f64, 0.0f64));
    orig_fonts[1] = keep(sans(em * 1.15f64 * 0.92f64, 0.0f64));
    for i in 0..len(paras) {
        release(paras[i]);
        release(attrs[i]);
        paras[i] = 0;
        attrs[i] = 0
    }
    msg_rect(rule_attachment, sel("setBounds:"), 0.0f64, 0.0f64, 36.0f64, 0.5f64)
}

// A paragraph style: its alignment (0 left, 1 centered, 2 right), its
// first line's indent and the rest's, its space before and after, its lines'
// height (a multiple), and its hyphenation.
para_style(
    align: int,
    first: f64,
    head: f64,
    before: f64,
    after: f64,
    lines: f64
): int {
    p: int = make("NSMutableParagraphStyle");
    msg1(p, sel("setAlignment:"), align);
    msg_set_f(p, sel("setFirstLineHeadIndent:"), first);
    msg_set_f(p, sel("setHeadIndent:"), head);
    msg_set_f(p, sel("setParagraphSpacingBefore:"), before);
    msg_set_f(p, sel("setParagraphSpacing:"), after);
    msg_set_f(p, sel("setLineHeightMultiple:"), lines);
    if (align == 0) msg_set_f32(p, sel("setHyphenationFactor:"), 0.3f64 as f32);
    p
}

is_heading_style(style: int): bool {
    style == STYLE_XREF || style == STYLE_BOOK || style == STYLE_NUMERAL || style == STYLE_NUMERAL1 || style == STYLE_HEAD || style == STYLE_SUBHEAD || style == STYLE_REF || style == STYLE_TITLE || style == STYLE_MAJOR || style == STYLE_RANGE || style == STYLE_ACROSTIC || style == STYLE_BOOKLABEL || style == STYLE_RULE || style == STYLE_PASSAGE
}

// The paragraph style of a style's runs in a paragraph of kind para (right
// to left, in a Hebrew chapter: lay_rtl; the apparatus always left to
// right, its Hebrew isolated).
layout_para_for(ctx: *ChapterLayout, style_in: int, para: int): int {
    // (A heading's reference is set as the rest of its line.)
    style: int = if (style_in == STYLE_XREF) STYLE_REF else style_in;
    app: bool = style == STYLE_APPARATUS || style == STYLE_APP_ENTRY;
    rtl: bool = ctx.lay_rtl && !app;
    // (The original's paragraphs one style whatever their runs: a
    // paragraph takes its first character's, often a verse's number.)
    base: int = if (is_heading_style(style)) style else if (app) STYLE_APPARATUS else if (style == STYLE_OTITLE || style == STYLE_OTITLE_GL) STYLE_OTITLE else if (is_orig_style(style) || ctx.lay_orig) STYLE_ORIG else STYLE_BODY;
    at: int = base * 32 + para % 32 + layout_attrs_set(ctx);
    if (paras[at] != 0) return paras[at];
    kind: int = para % KINDS;
    gap: f64 = if ((para & KINDS) != 0) em * 0.8f64 else 0.0f64;
    // (Hebrew's points need room: 1.5, whatever the spacing.)
    lh: f64 = if (ctx.lay_rtl && !is_heading_style(style) && !app) 1.5f64 else spacings[set_spacing];
    p: int = 0;
    if (app) {
        // (The apparatus: 6 pt below its paragraph, faint, a paragraph's
        // space after it.)
        p = para_style(0, 0.0f64, 0.0f64, 0.0f64, em * 0.55f64, 1.15f64);
        msg_set_f32(p, sel("setHyphenationFactor:"), 0.0f64 as f32)
    } else if (base == STYLE_OTITLE) p = para_style(0, 0.0f64, 0.0f64, em * 0.2f64,
        em * 0.6f64, lh) else if (style == STYLE_RULE) {
        // (A line no taller than the hairline: 2.0 em to the label's
        // capitals below it, less the space above their tops.)
        p = para_style(1, 0.0f64, 0.0f64, 0.0f64, em * 1.85f64, 1.0f64);
        msg_set_f(p, sel("setMinimumLineHeight:"), 2.0f64);
        msg_set_f(p, sel("setMaximumLineHeight:"), 2.0f64)
    } else if (style == STYLE_BOOK) p = para_style(1, 0.0f64, 0.0f64, em * 1.6f64,
        em * 0.15f64, 1.0f64) else if (style == STYLE_BOOKLABEL) p = para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 0.05f64, 1.0f64) else if (style == STYLE_NUMERAL || style == STYLE_NUMERAL1) p = para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 0.9f64, 1.0f64) else if (style == STYLE_HEAD && kind == PARA_CENTER) p = para_style(1,
        0.0f64, 0.0f64, em * 0.25f64, em * 0.35f64, 1.15f64) else if (style == STYLE_HEAD) p = para_style(0,
        0.0f64, 0.0f64, em * 1.5f64, em * 0.35f64, 1.15f64) else if (style == STYLE_PASSAGE) p = para_style(0,
        0.0f64, 0.0f64, 0.0f64, em * 0.6f64, 1.1f64) else if (style == STYLE_SUBHEAD) p = para_style(0,
        0.0f64, 0.0f64, em * 1.1f64, em * 0.3f64, 1.15f64) else if (style == STYLE_REF) p = para_style(0,
        0.0f64, 0.0f64, 0.0f64, em * 0.7f64, 1.1f64) else if (style == STYLE_TITLE) p = para_style(0,
        0.0f64, 0.0f64, em * 0.2f64, em * 0.6f64, 1.15f64) else if (style == STYLE_MAJOR) p = para_style(1,
        0.0f64, 0.0f64, em * 1.4f64, em * 0.1f64, 1.0f64) else if (style == STYLE_RANGE) p = para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 0.6f64, 1.0f64) else if (style == STYLE_ACROSTIC) p = para_style(0,
        0.0f64, 0.0f64, em * 1.2f64, em * 0.3f64, 1.0f64) else if (kind == PARA_VERSE) {
        // (The number right-aligned at 1.3 em, the words from 1.6 em.)
        p = para_style(0, 0.0f64, em * 1.6f64, gap, em * 0.3f64, lh);
        tab_pair[0] = msg(msg_i_f_i(msg(cls("NSTextTab"), sel("alloc")), sel("initWithTextAlignment:location:options:"),
            2, em * 1.3f64, msg(cls("NSDictionary"), sel("dictionary"))), sel("autorelease"));
        tab_pair[1] = msg(msg_i_f_i(msg(cls("NSTextTab"), sel("alloc")), sel("initWithTextAlignment:location:options:"),
            0, em * 1.6f64, msg(cls("NSDictionary"), sel("dictionary"))), sel("autorelease"));
        msg1(p, sel("setTabStops:"), nsarray(tab_pair, 2));
        msg_set_f(p, sel("setDefaultTabInterval:"), em * 1.6f64)
    } else if (ctx.lay_verse_lines && (kind == PARA_Q1 || kind == PARA_Q2)) {
        // (A verse's next line of poetry, under its words.)
        first: f64 = em * (if (kind == PARA_Q1) 1.6f64 else 2.8f64);
        p = para_style(0, first, first + em * 1.2f64, gap, if (kind == PARA_Q1) 0.0f64 else 0.0f64,
            lh)
    } else if (kind == PARA_Q1) p = para_style(0, 0.0f64, em * 2.4f64, gap, 0.0f64,
        lh) else if (kind == PARA_Q2) p = para_style(0, em * 1.2f64, em * 2.4f64,
        gap, 0.0f64, lh) else if (kind == PARA_L1) p = para_style(0, em * 1.0f64,
        em * 2.0f64, gap, 0.0f64, lh) else if (kind == PARA_L2) p = para_style(0,
        em * 2.0f64, em * 3.0f64, gap, 0.0f64, lh) else if (kind == PARA_CENTER) p = para_style(1,
        0.0f64, 0.0f64, gap, em * 0.55f64, lh) else if (kind == PARA_RIGHT) p = para_style(2,
        0.0f64, 0.0f64, gap, em * 0.55f64, lh) else p = para_style(0, 0.0f64, 0.0f64,
        gap, em * 0.55f64, lh);
    // (No hyphens in the original: Koine isn't modern Greek.)
    if (base == STYLE_ORIG || base == STYLE_OTITLE) msg_set_f32(p, sel("setHyphenationFactor:"),
        0.0f64 as f32);
    // (Its apparatus after it: 6 pt between them.)
    if ((para & TIGHT) != 0 && !app) msg_set_f(p, sel("setParagraphSpacing:"), 6.0f64);
    if (rtl) {
        // (Right to left: NSWritingDirectionRightToLeft, aligned naturally
        // but for what is centred.)
        msg1(p, sel("setBaseWritingDirection:"), 1);
        if (kind != PARA_CENTER && kind != PARA_RIGHT && !is_heading_style(style)) msg1(p,
            sel("setAlignment:"), 4)
    }
    paras[at] = p;
    p
}

color_for(style: int): int {
    if (style == STYLE_BODY || style == STYLE_CAPS || style == STYLE_BOOK || style == STYLE_SUPPLIED || style == STYLE_ORIG || style == STYLE_ORIG_GL) return c_ink;
    if (style == STYLE_OTITLE || style == STYLE_OTITLE_GL) return c_heading;
    if (style == STYLE_JESUS || style == STYLE_JESUS_CAPS || style == STYLE_JESUS_SUPPLIED) return if (red_letter) c_accent else c_ink;
    if (style == STYLE_XREF) return c_accent;
    if (style == STYLE_HEAD || style == STYLE_SUBHEAD || style == STYLE_PASSAGE) return c_heading;
    if (style == STYLE_NUMERAL || style == STYLE_NUMERAL1 || style == STYLE_NOTE || style == STYLE_ACROSTIC) return c_accent;
    c_faint
}

layout_attrs_sp(
    ctx: *ChapterLayout,
    style: int,
    para: int,
    r: int
): int {
    link: bool = style == STYLE_NOTE || style == STYLE_XREF || style == STYLE_PASSAGE || style == STYLE_APP_ENTRY;
    at: int = style * 32 + para % 32 + layout_attrs_set(ctx);
    if (!link && attrs[at] != 0) return attrs[at];
    n: int = 0;
    keys[n] = k_font;
    values[n] = layout_font_of(ctx, style);
    n = n + 1;
    keys[n] = k_color;
    values[n] = color_for(style);
    n = n + 1;
    keys[n] = k_para;
    values[n] = layout_para_for(ctx, style, para);
    n = n + 1;
    if (style == STYLE_VERSE && ctx.lay_verse_lines) { } else if (style == STYLE_VERSE || style == STYLE_NOTE) {
        keys[n] = k_baseline;
        values[n] = nsnumber_f(em * (if (style == STYLE_VERSE) 0.36f64 else 0.38f64));
        n = n + 1
    }
    kern: f64 = if (style == STYLE_BOOKLABEL) 0.16f64 else if (style == STYLE_MAJOR) 0.14f64 else if (style == STYLE_ACROSTIC) 0.12f64 else if ((style == STYLE_CAPS || style == STYLE_JESUS_CAPS) && caps_by_hand) 0.02f64 else 0.0f64;
    if (kern > 0.0f64) {
        keys[n] = k_kern;
        values[n] = nsnumber_f(em * kern);
        n = n + 1
    }
    if (style == STYLE_ORIG_GL || style == STYLE_OTITLE_GL) {
        // (A word glossed: a dotted underline in the rule's color, thin.)
        keys[n] = k_underline;
        values[n] = nsnumber_int(257);
        n = n + 1;
        keys[n] = k_underline_color;
        values[n] = c_gloss_line;
        n = n + 1
    }
    if (is_orig_style(style) || style == STYLE_APP_ENTRY) {
        // (Read by VoiceOver in Hebrew or Greek: an installed voice.)
        keys[n] = objc_const("UIAccessibilitySpeechAttributeLanguage");
        values[n] = nsstring(if (style == STYLE_APP_ENTRY) "en" else if (ctx.lay_rtl) "he" else "el");
        n = n + 1
    }
    if (link) {
        xr: bool = style == STYLE_XREF || style == STYLE_PASSAGE;
        keys[n] = nsstring(if (xr) k_xref else if (style == STYLE_APP_ENTRY) k_gloss else k_link);
        values[n] = msg1(cls("NSNumber"), sel("numberWithLong:"), if (xr) ctx.run_arg[r] * 16777216 + ctx.run_arg2[r] else ctx.run_arg[r]);
        n = n + 1
    }
    d: int = nsdictionary(keys, values, n);
    if (!link) attrs[at] = keep(d);
    d
}

// A symbol's image (SF Symbols), at a size and weight (UIImageSymbolWeight:
// 4 regular, 5 medium, 6 semibold, 7 bold), in a color (0: as a template).
symbol(
    name: str,
    size: f64,
    weight: int,
    color: int
): int {
    config: int = msg_f1(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
        size, weight);
    image: int = msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
        nsstring(name), config);
    if (image != 0 && color != 0) image = msg2(image, sel("imageWithTintColor:renderingMode:"),
        color, 1);
    image
}

// Attributes read the layout's language, options, and link arguments.
layout_attrs_for(ctx: *ChapterLayout, r: int): int {
    layout_attrs_sp(ctx, ctx.run_style[r], ctx.run_para[r], r)
}
