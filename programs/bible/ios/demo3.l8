tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 3 steps (DESIGN.md ¬ß8.10): the `more` group (shots 60 to
// 88: previews, keeping the screen on, history, chapter notes, the export,
// the color filter, Listen, the words of Jesus in red, the largest text),
// the screen recording's sequences 7 to 9, the App Store's screenshots (the
// `store` group), and what the iOS 18 group needs. Each step does what the
// reader's own taps would, through the same functions: a tap is made at the
// place on the screen where the words tapped are.
import "../../ios/objc.l8";

import "../core/text.l8";

// Where the words last found are, in their text view (its middle).
demo_x: f64 = 0.0f64;

demo_y: f64 = 0.0f64;

// Whether text view tv has words, and where (demo_x, demo_y).
demo_find(tv: int, words: str): bool {
    if (tv == 0) return false;
    text: int = msg(msg(tv, sel("textStorage")), sel("string"));
    loc: int = msg1(text, sel("rangeOfString:"), nsstring(words));
    if (loc < 0 || loc >= msg(text, sel("length"))) return false;
    n: int = msg(nsstring(words), sel("length"));
    if (!range_rect(tv, loc, n)) return false;
    demo_x = hfa[0] + hfa[2] * 0.5f64;
    demo_y = hfa[1] + hfa[3] * 0.5f64;
    true
}

// The text view in view controller vc's view (the first found), or 0.
text_view_in(vc: int): int {
    if (vc == 0) return 0;
    list: int = msg(msg(vc, sel("view")), sel("subviews"));
    tvc: int = cls("UITextView");
    for i in 0..msg(list, sel("count")) {
        v: int = msg1(list, sel("objectAtIndex:"), i);
        if ((msg1(v, sel("isKindOfClass:"), tvc) & 255) != 0) return v
    }
    0
}

// The footnote's mark in verse v of chapter c (on the screen): where it is.
demo_find_note_mark(c: int, v: int): bool {
    rendering: *ReaderRendering = active_rendering();
    tv: int = view_of(c);
    if (tv == 0) return false;
    compute_ranges(c);
    i: int = rv_index(v);
    if (i < 0) return false;
    storage: int = msg(tv, sel("textStorage"));
    key: int = nsstring(k_link);
    for k in rendering.ranges.rv_b[i]..rendering.ranges.rv_e[i] {
        if (msg3(storage, sel("attribute:atIndex:effectiveRange:"), key, k, 0) != 0 && range_rect(tv,
            k, 1)) {
            demo_x = hfa[0] + hfa[2] * 0.5f64;
            demo_y = hfa[1] + hfa[3] * 0.5f64;
            return true
        }
    }
    false
}

// The more group's marks: John 3's (Round 1's: yellow 16‚Äì17, green 3, a
// bookmark on 1, a note on 5) and a note on 16, a blue highlight on Psalm
// 23:1; and eight places of history over three days, at fixed times of day.
demo_seed() {
    c: int = john3();
    for v in [16, 17] set_highlight(c, v, 0);
    set_highlight(c, 3, 1);
    set_highlight(psalm23(), 1, 2);
    save_highlights();
    set_bookmark(c, 1, true);
    save_bookmarks();
    n: int = nsstring_into(nsstring("Water and Spirit: compare Ezekiel 36:25\‚\Ä\ì27."),
        note_buf);
    set_note(c, 5, 5, note_buf, n);
    n = nsstring_into(nsstring("\·\º\Ä\Œ\≥\Œ\±\œ\Ä\Œ\¨\œ\â (agapa\≈\ç, G25): to love"),
        note_buf);
    set_note(c, 16, 16, note_buf, n);
    save_notes();
    now: int = time(0);
    off: int = local_offset();
    midnight: int = day_of(now + off) * 86400 - off;
    hs_n = 0;
    // (Three days ago, yesterday, today: oldest first.)
    history_add(book_first[19] + 2, 5, 0, true, midnight - 2 * 86400 - 18 * 3600);
    history_add(book_first[1] + 13, 14, 0, true, midnight - 2 * 86400 - 13 * 3600);
    history_add(book_first[0] + 2, 0, 0, false, midnight - 2 * 86400 - 4 * 3600);
    history_add(book_first[22] + 39, 31, 0, true, midnight - 15 * 3600);
    history_add(book_first[42], 0, 0, false, midnight - 3 * 3600);
    history_add(book_first[39] + 4, 3, 0, false, now - 50 * 60);
    history_add(book_first[44] + 7, 28, 0, true, now - 40 * 60);
    history_add(psalm23(), 0, 0, false, now - 30 * 60);
    save_history();
    remake(c)
}

// The word study of John 3:16's "loved" (agapa≈ç), as a sheet.
demo_open_loved() {
    if (!can_study(john3(), 16)) return;
    vi: int = lang_verse(john3(), 16);
    for w in v_first(vi)..v_end(vi) {
        if (w_greek(w) && w_strongs(w) == 25) {
            open_study_sheet(vi, w);
            return
        }
    }
}

matthew5(): int {
    book_first[39] + 4
}

demo_do3(t: int) {
    // ---- ¬ß8.1 previews ----
    if (t == 100) {
        demo_seed();
        demo_dismiss();
        go_place(0, 0, 0);
        bar_set(0.0f64)
    }
    if (t == 101) {
        // A tap on "John 1:1‚Äì5", under The Creation.
        tv: int = view_of(0);
        if (demo_find(tv, "John 1:1")) reader_tap(tv, demo_x, demo_y)
    }
    if (t == 102) {
        // The footnote's mark on Genesis 1:3, tapped.
        demo_dismiss();
        demo_later_at(0.6f64, 50)
    }
    if (t == 103) {
        // The reference in it, tapped.
        tv: int = text_view_in(top_presented());
        if (demo_find(tv, "2 Corinthians 4:6")) footnote_tap_at(tv, demo_x, demo_y)
    }
    if (t == 104) {
        // Open in Reader.
        top: int = top_presented();
        if (top != 0) {
            items: int = msg(msg(top, sel("topViewController")), sel("toolbarItems"));
            if (items != 0 && msg(items, sel("count")) >= 2) preview_open(0, 0, msg1(items,
                sel("objectAtIndex:"), 1))
        }
    }
    if (t == 105) {
        // Word study ‚Üí Definition ‚Üí "Rom 8:37".
        demo_dismiss();
        hide_back();
        demo_later_do(30)
    }
    if (t == 106) {
        // The John 3:5 note, read, then its "Ezekiel 36:25‚Äì27".
        demo_dismiss();
        go_place(john3(), 3, -3000);
        demo_later_do(33)
    }
    if (t == 107) {
        // Matthew 5:1‚Äì7:29, previewed (a demo hook), large, at its end.
        demo_dismiss();
        demo_later_do(35)
    }
    // ---- ¬ß8.2 keeping the screen on ----
    if (t == 108) {
        demo_dismiss();
        keep_on = true;
        set_def_bool("keepScreenOn", true);
        demo_later_at(0.6f64, 51)
    }
    // ---- ¬ß8.3 history ----
    if (t == 109) {
        // (Genesis 1 at the top, so the books' list stays at its top.)
        demo_dismiss();
        go_top(0);
        demo_later_do(39)
    }
    // (Recent's Show All: Recent is the section after Ribbons and Reading
    // Plan.)
    if (t == 110) uk_picked(picker_table, GT_PLAN_SECTION + 1, uk_rows(picker_table,
        GT_PLAN_SECTION + 1) - 1);
    if (t == 111) {
        b: int = uk_button_of(SCR_HISTORY);
        if (b != 0 && responds(b, "performPrimaryAction")) msg(b, sel("performPrimaryAction"));
        demo_later_at(0.5f64, 40)
    }
    // ---- ¬ß8.4 chapter notes ----
    if (t == 112) {
        demo_dismiss_any_menu(uk_button_of(SCR_HISTORY));
        demo_dismiss();
        go_top(john3());
        set_def_int("librarySegment", 1);
        demo_later_do(1)
    }
    if (t == 113) {
        library_compose(0, 0, 0);
        demo_later_do(41)
    }
    if (t == 114) {
        note_done(0, 0, 0);
        demo_later_do(42)
    }
    if (t == 115) {
        demo_dismiss();
        set_def_int("librarySegment", 1);
        demo_later_do(1)
    }
    // ---- ¬ß8.5 the export ----
    if (t == 116) library_export(0, 0, 0);
    // ---- ¬ß8.6 the color filter ----
    if (t == 117) {
        demo_dismiss();
        set_def_int("librarySegment", 0);
        demo_later_do(1)
    }
    if (t == 118) uk_filter_tap(SCR_LIBRARY, 1);
    // ---- ¬ß8.7 Listen ----
    if (t == 119) {
        demo_dismiss();
        go_place(john3(), 14, 100);
        demo_later_do(2)
    }
    if (t == 120) {
        listen_button_tapped(0, 0, 0);
        // (Four seconds of it.)
        demo_later_at(4.0f64, 99)
    }
    if (t == 121) listen_play_pause(0, 0, 0);
    if (t == 122) toggle_verse(john3(), 16);
    // ---- ¬ß8.8 the words of Jesus in red ----
    if (t == 123) {
        clear_selection();
        listen_stop();
        set_red_letter(true);
        go_place(matthew5(), 1, -1500)
    }
    if (t == 124) {
        set_theme = 4;
        settings_changed(true);
        go_place(matthew5(), 1, -1500)
    }
    // (Listen's entry in Night: the filled button's title in the page's
    // black, review r3-1 item 1.)
    if (t == 129) {
        clear_selection();
        demo_dismiss();
        go_place(john3(), 14, 100);
        demo_later_do(2)
    }
    // ---- ¬ß8.9 the largest text ----
    if (t == 125) {
        demo_dismiss();
        set_theme = 0;
        red_letter = false;
        settings_changed(true);
        go_place(john3(), 16, -1500)
    }
    if (t == 126) {
        go_verse(john3(), 16);
        toggle_verse(john3(), 16)
    }
    if (t == 127) {
        clear_selection();
        demo_open_loved()
    }
    if (t == 128) {
        demo_dismiss();
        demo_later_do(2)
    }
    // ---- the App Store's screenshots (¬ß8.9.7) ----
    if (t == 130) {
        hide_back();
        go_top(psalm23());
        bar_set(0.0f64)
    }
    if (t == 131) {
        c: int = john3();
        for v in [14, 15] set_highlight(c, v, 1);
        for v in [16, 17] set_highlight(c, v, 0);
        save_highlights();
        remake(c);
        go_place(c, 12, -900);
        bar_set(0.0f64)
    }
    if (t == 132) {
        set_def_int("interlinearOrder", 0);
        open_interlinear(john3(), 16)
    }
    if (t == 133) demo_study(true, 25);
    if (t == 134) {
        demo_dismiss();
        set_theme = 3;
        settings_changed(true);
        go_place(john3(), 14, 100);
        demo_later_do(2)
    }
}

// The menu of a button's, put away.
demo_dismiss_any_menu(b: int) {
    if (b == 0) return;
    i: int = msg(b, sel("contextMenuInteraction"));
    if (i != 0) msg(i, sel("dismissMenu"))
}

// The later parts of the Round 3 steps (demo_later's kinds 30 and up).
demo_later3(d: int) {
    if (d == 30) {
        demo_open_loved();
        demo_later_do(31)
    } else if (d == 31) {
        open_definition();
        demo_later_do(32)
    } else if (d == 32) {
        // (Its link to Romans 8:37, tapped.)
        xr_book = 44;
        xr_c = 8;
        xr_v = 37;
        xr_ce = 0;
        xr_ve = 0;
        uk_act_kind(SCR_DEFINITION, ACT_VS_PREVIEW, xref_both())
    } else if (d == 33) {
        open_note(john3(), 5, 5);
        demo_later_do(34)
    } else if (d == 34) {
        if (note_tv != 0 && demo_find(note_tv, "Ezekiel 36:25")) ref_tap_at(note_tv,
            demo_x, demo_y)
    } else if (d == 35) {
        xr_book = 39;
        xr_c = 5;
        xr_v = 1;
        xr_ce = 7;
        xr_ve = 29;
        open_preview(xref_both());
        demo_detent(true);
        demo_later_do(36)
    } else if (d == 36) {
        if (pv_tv != 0) {
            n: int = msg(msg(pv_tv, sel("textStorage")), sel("length"));
            msg2(pv_tv, sel("scrollRangeToVisible:"), n - 1, 1)
        }
    } else if (d == 50) {
        if (demo_find_note_mark(0, 3)) reader_tap(view_of(0), demo_x, demo_y)
    } else if (d == 51) {
        // (The reader touched: the idle timer off; then a sheet: on.)
        keep_screen_touched();
        demo_later_do(37)
    } else if (d == 37) {
        open_settings();
        demo_later_do(38)
    } else if (d == 38) {
        if (settings_table != 0) msg3(settings_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
            msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0, 9), 3,
            0)
    } else if (d == 39) open_picker() else if (d == 40) {
        // (If the button would not open its menu: through its interaction.)
        i: int = msg(uk_button_of(SCR_HISTORY), sel("contextMenuInteraction"));
        if (i != 0 && responds(i, "_presentMenuAtLocation:")) {
            l8_msg_hfa(hfa, uk_button_of(SCR_HISTORY), sel("bounds"), 0, 0, 0);
            msg_ff(i, sel("_presentMenuAtLocation:"), hfa[2] / 2.0f64, hfa[3] / 2.0f64)
        }
    } else if (d == 41) {
        if (note_tv != 0) {
            msg1(note_tv, sel("setText:"), nsstring("Born from above: an\≈\çthen \‚\Ä\î again or from above."));
            text_changed(0, 0, note_tv)
        }
    } else if (d == 42) {
        demo_dismiss();
        go_top(john3());
        bar_set(0.0f64)
    } else if (d == 43) {
        // Recording sequence 7, its later parts.
        demo_dismiss_animated();
        demo_later_at(1.0f64, 44)
    } else if (d == 44) {
        if (demo_find_note_mark(0, 3)) reader_tap(view_of(0), demo_x, demo_y);
        demo_later_at(1.2f64, 45)
    } else if (d == 45) {
        tv: int = text_view_in(top_presented());
        if (demo_find(tv, "2 Corinthians 4:6")) footnote_tap_at(tv, demo_x, demo_y);
        demo_later_at(1.8f64, 46)
    } else if (d == 46) demo_dismiss_animated() else if (d == 47) {
        // Sequence 8: ten seconds of Listen, then stopped.
        listen_stop();
        ls_demo_fast = false;
        ls_speed = 1;
        set_def_int("listenRate", 1)
    } else if (d == 48) {
        // Sequence 9: green, then All, then away.
        uk_filter_tap(SCR_LIBRARY, 1);
        demo_later_at(1.2f64, 49)
    } else if (d == 49) {
        uk_filter_tap(SCR_LIBRARY, -1);
        demo_later_at(1.2f64, 46)
    }
}

demo_dismiss_animated() {
    if (presented() != 0) dismiss_sheets()
}

// The recording's sequences 7 to 9 (DESIGN.md ¬ß8.10).
demo_sequence3(t: int) {
    if (t == 77) {
        // 7: a heading's reference tapped, the preview up, put away; then a
        // footnote, the reference in it, the popover fading, the sheet up.
        demo_dismiss();
        go_place(0, 0, 0);
        bar_set(0.0f64);
        tv: int = view_of(0);
        if (demo_find(tv, "John 1:1")) reader_tap(tv, demo_x, demo_y);
        demo_later_at(1.6f64, 43)
    }
    if (t == 78) {
        // 8: Listen at John 3:14, faster, ten seconds (the wash moving on,
        // and once, the page following it).
        demo_dismiss();
        go_verse(john3(), 11);
        bar_set(0.0f64);
        set_def_int("listenRate", 2);
        ls_demo_fast = true;
        listen_start(john3(), 14);
        demo_later_at(10.0f64, 47)
    }
    if (t == 79) {
        // 9: Library's highlights; green, then All.
        demo_dismiss();
        listen_stop();
        set_def_int("librarySegment", 0);
        open_library();
        demo_later_at(1.4f64, 48)
    }
}
