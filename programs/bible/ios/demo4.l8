tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 4 steps (DESIGN.md Â§9.9): the `versions` group (shots
// 100 to 130, and 112b, 121b and 122b to 122d: the version picker, switching in place, marks across
// versions, Compare, the Study sheet's segments, the acknowledgements and
// the largest text), the screen recording's sequence 10, and the
// store group's store-7. Each step does what the reader's own taps would,
// through the same functions.
import "../../ios/objc.l8";

import "../core/text.l8";

demo_compare_large: bool = false;

matthew17(): int {
    book_first[39] + 16
}

// The group's marks: John 3:16â€“17 yellow, 3:3 green, the note on 3:5; and
// a bookmark on Matthew 17:21, made while reading the KJV.
demo_seed4() {
    c: int = john3();
    for v in [16, 17] set_highlight(c, v, 0);
    set_highlight(c, 3, 1);
    save_highlights();
    n: int = nsstring_into(nsstring("Water and Spirit: compare Ezekiel 36:25\â\€\“27."),
        note_buf);
    set_note(c, 5, 5, note_buf, n);
    save_notes();
    switch_version(1);
    set_bookmark(matthew17(), 21, true);
    save_bookmarks();
    switch_version(TEXT_BSB)
}

// The settings sheet's table scrolled to section s, row r.
demo_settings_to(s: int, r: int) {
    if (settings_table != 0) msg3(settings_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
        msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), r, s), 2, 0)
}

// The Compare section of version t (-1 if it has none).
demo_compare_section(t: int): int {
    for i in 0..cmp_count
        if (cmp_order[i] == t) return i;
    -1
}

demo_do4(t: int) {
    if (t == 135) {
        // store-7: Compare on John 3:16, at the large detent.
        demo_dismiss();
        set_theme = 1;
        settings_changed(true);
        go_place(john3(), 14, 0);
        demo_compare_large = true;
        demo_later_at(0.5f64, 110)
    }
    if (t == 200) {
        demo_dismiss();
        demo_seed4();
        go_place(john3(), 14, 0);
        bar_set(0.0f64)
    }
    if (t == 201) {
        demo_dismiss();
        open_settings()
    }
    if (t == 202) open_versions();
    if (t == 203) uk_pick_version(1);
    if (t == 204) {
        demo_dismiss();
        go_place(john3(), 11, 0);
        bar_set(0.0f64)
    }
    if (t == 205) {
        go_place(matthew17(), 19, -400);
        bar_set(0.0f64)
    }
    if (t == 206) switch_version(TEXT_BSB);
    if (t == 207) {
        set_def_int("librarySegment", 2);
        demo_later_do(1)
    }
    if (t == 208) {
        demo_dismiss();
        switch_version(2);
        go_top(psalm23());
        bar_set(0.0f64)
    }
    if (t == 209) switch_version(3);
    if (t == 210) {
        switch_version(4);
        go_top(0);
        bar_set(0.0f64)
    }
    if (t == 211) {
        switch_version(3);
        set_red_letter(true);
        open_settings();
        demo_later_at(0.6f64, 101)
    }
    if (t == 212) {
        demo_dismiss();
        set_red_letter(false);
        switch_version(TEXT_BSB);
        go_place(john3(), 14, 0);
        demo_later_at(0.5f64, 110)
    }
    if (t == 213) {
        // Compare expanded to the large detent.
        demo_detent(true);
        demo_later_at(4.0f64, 100)
    }
    if (t == 214) compare_next(0, 0, 0);
    if (t == 215) {
        s: int = demo_compare_section(1);
        if (s >= 0) compare_picked(compare_table, s, 0)
    }
    if (t == 224) {
        demo_dismiss();
        go_place(john3(), 14, 0);
        set_def_int("studySegment", 0);
        demo_later_at(1.2f64, 106)
    }
    if (t == 225) {
        demo_segment(1);
        demo_detent(true)
    }
    if (t == 226) xref_picked(xref_table, 0, 0);
    if (t == 227) {
        demo_pop();
        demo_segment(2)
    }
    if (t == 228) {
        // A reference in the commentary, tapped.
        if (cm_tv != 0) {
            storage: int = msg(cm_tv, sel("textStorage"));
            key: int = nsstring(k_xref);
            n: int = msg(storage, sel("length"));
            ref: int = 0;
            k: int = 0;
            while (k < n && ref == 0) {
                v: int = msg3(storage, sel("attribute:atIndex:effectiveRange:"), key,
                    k, 0);
                if (v != 0) ref = msg(v, sel("longValue"));
                k = k + 1
            }
            if (ref != 0) push_preview(ref)
        }
    }
    if (t == 229) {
        demo_dismiss();
        demo_later_at(0.5f64, 111)
    }
    if (t == 230) {
        demo_dismiss();
        switch_version(TEXT_BSB);
        go_place(john3(), 14, 0)
    }
    if (t == 231) demo_later_at(0.5f64, 110);
    if (t == 232) {
        demo_dismiss();
        demo_later_at(0.6f64, 108)
    }
    if (t == 236) demo_sequence4(10)
}

// A search typed, and run at once.
demo_search(text: str) {
    q: int = nsstring(text);
    msg1(search_bar, sel("setText:"), q);
    sr_n = nsstring_into(q, sr);
    sr_timer = stop_timer(sr_timer);
    run_search()
}

// The Study sheet's segment s, as a tap on it would.
demo_segment(s: int) {
    if (sv_seg == 0) return;
    msg1(sv_seg, sel("setSelectedSegmentIndex:"), s);
    study_segment(0, 0, sv_seg)
}

// The later parts of the steps (demo_later's kinds 100 and up).
demo_later4(d: int) {
    // (What opens a sheet waits until no sheet is left going away.)
    if ((d == 106 || d == 110 || d == 111) && presented() != 0) {
        demo_later_at(0.3f64, d);
        return
    }
    if (d == 111) {
        open_settings();
        demo_later_at(0.8f64, 107);
        return
    }
    if (d == 110) {
        // Compare on John 3:16.
        demo_verses[0] = 16;
        open_compare(john3(), demo_verses, 1);
        if (demo_compare_large) {
            demo_compare_large = false;
            demo_later_at(0.8f64, 120)
        }
        return
    }
    if (d == 100) { } else if (d == 101) demo_settings_to(6, 3) else if (d == 106) open_study_verse(john3(),
        16) else if (d == 107) {
        open_acknowledgements();
        demo_later_at(0.8f64, 109)
    } else if (d == 108) toggle_verse(john3(), 16) else if (d == 109) {
        if (ack_table != 0) msg3(ack_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
            msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0, 1), 1,
            0)
    } else if (d == 120) demo_detent(true) else if (d == 121) {
        open_settings();
        demo_later_at(0.8f64, 122)
    } else if (d == 122) {
        open_versions();
        demo_later_at(1.2f64, 123)
    } else if (d == 123) {
        uk_pick_version(1);
        demo_later_at(1.6f64, 124)
    } else if (d == 124) {
        uk_pick_version(0);
        demo_later_at(1.6f64, 100)
    }
}

// The bundled-version switching recording (DESIGN.md Â§9.9).
demo_sequence4(k: int) {
    if (k == 10) {
        // 10: at John 3:14, the Versions screen: KJV, then the BSB.
        demo_dismiss();
        switch_version(TEXT_BSB);
        go_place(john3(), 14, 0);
        bar_set(0.0f64);
        demo_later_at(0.6f64, 121)
    }
}
