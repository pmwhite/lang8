tag bible_ios;

use_tag std, ios, bible;

// Ribbons (DESIGN.md §11): ribbons.l8's places kept (ribbons.tsv; Round
// 6's readings made ribbons once), the carried one moved by the reader's
// rests and the chapters it reads (ios/daily.l8's signal), and put down by
// every jump (the capsule back picking it up again); a ribbon's row (in Go
// To's Ribbons section, ios/daily.l8), its tap (the kept place, exactly, no
// flash, then carried) and its ⓘ; New Ribbon (pushed in Go To, or a sheet
// from the title's menu) and Ribbon (rename, delete), with Go To's own
// lists to choose a book and chapter (A Chapter a Day's too); the title's
// long-press menu; the drawn ribbon glyph; and the toasts.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/ribbons.l8";

extern msg_6f(
    receiver: int,
    selector: int,
    a: f64,
    b: f64,
    c: f64,
    d: f64,
    e: f64,
    f: f64
): int = objc_msgSend;

extern msg5(
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int,
    d: int,
    e: int
): int = objc_msgSend;

// ---- kept ----
// Whether a file of ours is there.
file_exists(name: str): bool {
    (msg1(msg(cls("NSFileManager"), sel("defaultManager")), sel("fileExistsAtPath:"),
        file_path(name)) & 255) != 0
}

// At launch: the ribbons; or (the first launch with them) up to three of
// Round 6's readings made ribbons, readings.tsv set aside as
// readings-r6.tsv (§11.4).
load_ribbons() {
    if (ribbons_migrate_due(file_exists("readings.tsv"), file_exists("ribbons.tsv"))) {
        read_file("readings.tsv");
        made: int = migrate_readings(time(0));
        save_ribbons();
        fm: int = msg(cls("NSFileManager"), sel("defaultManager"));
        msg2(fm, sel("removeItemAtPath:error:"), file_path("readings-r6.tsv"), 0);
        msg3(fm, sel("moveItemAtPath:toPath:error:"), file_path("readings.tsv"), file_path("readings-r6.tsv"),
            0);
        msg1(defaults(), sel("removeObjectForKey:"), nsstring("readingsSeeded"));
        if (diag_on) {
            fbuf_n = 0;
            fput_str("bible: ribbons migrated ");
            fput_int(made);
            fput_str(" of ");
            fput_int(mg_of);
            note_ns(fstring())
        }
        note_num("bible: readings-r6.tsv there ", if (file_exists("readings-r6.tsv")) 1 else 0)
    } else {
        read_file("ribbons.tsv");
        parse_ribbons();
        // (An older file's ribbons given their colors: kept.)
        if (rb_colors_filled) {
            save_ribbons();
            note_num("bible: ribbons given colors ", rb_n)
        }
    }
    rbe_n = 0;
    note_num("bible: ribbons ", rb_n);
    note_num("bible: ribbon carried ", rb_carried)
}

save_ribbons() {
    format_ribbons();
    write_file("ribbons.tsv")
}

// What ribbons.l8 says happened, into the log ("bible: ribbon made:
// Morning at MRK 1").
ribbons_log() {
    if (diag_on) {
        s: int = 0;
        for i in 0..rbe_n {
            if (rbe[i] as int == 10) {
                fbuf_n = 0;
                fput_str("bible: ");
                for k in s..i fput(rbe[k] as int);
                note_ns(fstring());
                s = i + 1
            }
        }
    }
    rbe_n = 0
}

// The ribbons changed: kept, logged, the title's menu made again.
ribbons_changed() {
    save_ribbons();
    ribbons_log();
    title_menus_refresh()
}

// A place as the log has it: ROM 3, ROM 3:9.
fput_code_place(c: int, v: int) {
    for i in 0..3 fput(bsb[book_line[ch_book[c]] + 1 + i] as int);
    fput(32);
    fput_int(ch_num[c]);
    if (v >= 2) {
        fput(58);
        fput_int(v)
    }
}

// ---- rests (§11.1.1): core's (core/reading.l8) ----
// A jump's arrival (or a pickup): nothing it leaves moves a ribbon.
reading_jumped() {
    rd_scrolled = false
}

// A finger's scroll, or Listen's following: the rest over, and the next
// one a scroll's.
reading_scrolled() {
    rd_sync();
    rd_scroll(CACurrentMediaTime());
    rd_after()
}

// A rest of the reader's that is not a scroll's end: the app going away, or
// a sheet coming up over it.
reading_rest_now() {
    if (!restored || table == 0) return;
    measure_place();
    reader_rest_core()
}

// Whether chapter c's end (its row's foot) is on the screen.
chapter_end_seen(c: int): bool {
    if (table == 0 || c < 0 || c >= chapters) return false;
    top: f64 = offset_y(table) + top_inset(table);
    bottom: f64 = offset_y(table) + view_height(table) - bottom_inset(table);
    l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), chapter_path(c), 0, 0);
    end: f64 = hfa[1] + hfa[3];
    end <= bottom + 1.0f64 && end >= top - 1.0f64
}

// ---- the ribbon glyph (§11.2.6, owner amendment 2026-10-19) ----
// A template image drawn once a size: one straight, narrow strip (0.2 of
// its height wide, about a third of bookmark.fill's width), from 0.06 to
// 0.94 of the height, with a small V notch at its foot (0.16 deep); no
// curve, no shading. So at small sizes it reads as a thin ribbon, not a
// bookmark.
glyph_size: []f64 = new f64[4](0.0f64);

glyph_image: []int = new int[4](0);

// The strip's width, as a part of the image's size.
GLYPH_W: f64 = 0.2f64;

ribbon_glyph(size: f64): int {
    for k in 0..4
        if (glyph_image[k] != 0 && glyph_size[k] == size) return glyph_image[k];
    S: f64 = size;
    w: f64 = GLYPH_W * S;
    cx: f64 = S / 2.0f64;
    y0: f64 = 0.06f64 * S;
    y1: f64 = 0.94f64 * S;
    notch: f64 = 0.16f64 * S;
    UIGraphicsBeginImageContextWithOptions(S, S, 0, 0.0f64);
    path: int = msg(cls("UIBezierPath"), sel("bezierPath"));
    l: f64 = cx - w / 2.0f64;
    r: f64 = cx + w / 2.0f64;
    msg_ff(path, sel("moveToPoint:"), l, y0);
    msg_ff(path, sel("addLineToPoint:"), r, y0);
    msg_ff(path, sel("addLineToPoint:"), r, y1);
    msg_ff(path, sel("addLineToPoint:"), cx, y1 - notch);
    msg_ff(path, sel("addLineToPoint:"), l, y1);
    msg(path, sel("closePath"));
    msg(msg(cls("UIColor"), sel("blackColor")), sel("setFill"));
    msg(path, sel("fill"));
    image: int = msg1(UIGraphicsGetImageFromCurrentImageContext(), sel("imageWithRenderingMode:"),
        2);
    UIGraphicsEndImageContext();
    // (Kept: a slot free, or the first.)
    slot: int = 0;
    for j in 0..4
        if (glyph_image[j] == 0 && slot == 0) slot = j;
    release(glyph_image[slot]);
    glyph_image[slot] = keep(image);
    glyph_size[slot] = size;
    image
}

// The glyph at the body text's size (rows grow with Dynamic Type).
ribbon_row_glyph(): int {
    f: int = msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleBody"));
    ribbon_glyph((msg_f(f, sel("pointSize")) + 0.5f64) as int as f64)
}

// ---- the ribbons' colors (owner, 2026-10-19; core/look.l8's) ----
// Color k in the theme now (on the dark themes, their own); dark: the dark
// themes' shades whatever the theme (for the toast, on ink).
ribbon_ui_color(k_in: int): int {
    k: int = if (k_in >= 0 && k_in < RB_COLORS) k_in else 0;
    color_hex(ribbon_hex(k, theme, is_dark()), 1.0f64)
}

// Ribbon i's color (the accent if there is no such ribbon).
ribbon_color_of(i: int): int {
    if (i < 0 || i >= rb_n) c_accent else ribbon_ui_color(rb_color[i])
}

ribbon_toast_of(text: int, i: int) {
    msg(text, sel("retain"));
    haptic_impact(0);
    // (On the toast's ink: the other themes' shade; its foot a little under
    // the baseline, as a symbol's is.)
    k: int = if (i >= 0 && i < rb_n) rb_color[i] else 0;
    shade: int = if (i < 0) c_bg else if (is_dark()) color_hex(rc_light[k], 1.0f64) else color_hex(rc_dark[k],
        1.0f64);
    glyph: int = msg2(ribbon_glyph(13.0f64), sel("imageWithTintColor:renderingMode:"),
        shade, 1);
    glyph = msg_set_f(glyph, sel("imageWithBaselineOffsetFromBottom:"), 2.0f64);
    toast_image(text, glyph, if (demo_on) 6.0f64 else 1.6f64);
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: toast ");
        n: int = nsstring_into(text, link_buf);
        for i in 0..n fput(link_buf[i] as int);
        note_ns(fstring())
    }
    release(text)
}

// "Reading with Morning".
toast_reading_with(id: int) {
    i: int = rb_index(id);
    if (i < 0) return;
    fput_reading_with(i);
    ribbon_toast_of(fstring(), i)
}

// ---- opening a ribbon ----
// The reader at a kept place exactly, as launch restores one (no flash: a
// place, not a reference), the sheet away, the place left kept and the
// capsule back to it (unless it is the chapter on the screen); then made
// again once the sheet has gone. The carried ribbon put down first (P1).
rd_go_c: int = 0;

rd_go_v: int = 0;

rd_go_f: int = 0;

rd_settle_timer: int = 0;

ribbon_place_show(
    c: int,
    v: int,
    f: int,
    here: bool
) {
    if (c < 0 || c >= chapters) return;
    clear_selection();
    from_sheet: bool = presented() != 0;
    dismiss_sheets();
    show_bars(false);
    stop_moving();
    go_place(c, v, f);
    arrival_y = offset_y(table);
    arrived_v = 0;
    save_place();
    reading_jumped();
    rd_go_c = c;
    rd_go_v = v;
    rd_go_f = f;
    // (Made again once the sheet has gone, as a jump is: its insets change
    // as it goes.)
    rd_settle_timer = stop_timer(rd_settle_timer);
    rd_settle_timer = after(0.6f64, "readingSettle:");
    if (here) note("bible: ribbon opened in the chapter on screen (no capsule)") else if (from_sheet) {
        back_after_sheet = true;
        style_back()
    } else show_back();
    title_menus_fresh();
    note_num("bible: ribbon place at ", c)
}

reading_settle(_self: int, _cmd: int, _timer: int): int {
    rd_settle_timer = 0;
    d: f64 = offset_y(table) - arrival_y;
    if (d < 0.0f64) d = -d;
    if (d > 2.0f64 || (msg(table, sel("isTracking")) & 255) != 0) return 0;
    go_place(rd_go_c, rd_go_v, rd_go_f);
    arrival_y = offset_y(table);
    save_place();
    style_back();
    measure_place();
    note_num("bible: ribbon settled at ", cur);
    note_num("bible:   verse ", place_v);
    title_menus_refresh();
    0
}

// Ribbon i's row tapped (or its screen's Place): a jump to it, then picked
// up, with the toast.
ribbon_open(i: int) {
    if (i < 0 || i >= rb_n) return;
    // (Core's: a jump to its place, none in the chapter on the screen,
    // then carried, with its toast.)
    origin_here();
    uk_sync();
    here: bool = jp_ribbon(i, jp_oc, jp_ov, jp_of, jp_oe);
    rd_after();
    ribbons_log();
    ribbon_place_show(jp_to_c, jp_to_v, jp_to_f, here)
}

// ---- Begin At: a book and chapter chosen (core's: core/skin.l8's bg_c
// and its screens) ----
// Book: core's Begin At books, pushed (a tap chooses one, at its chapter
// 1, and pops).
bg_open_books() {
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    uk_open(SCR_BEGIN_BOOKS, 0, true, sheet_nav)
}

// (Book b chosen, as a tap on its row would: the demos'.)
bg_choose_book(b: int) {
    uk_tap(SCR_BEGIN_BOOKS, ACT_BEGIN_CHOSEN_BOOK, b)
}

// ---- a text field in a cell (New Ribbon's, and Ribbon's Name) ----
// A plain cell with a field in its content view, to its layout margins:
// the body font, growing with the text size; Done on the keyboard.
field_cell(field_out: []int) {
    cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, 0), sel("autorelease"));
    msg1(cell, sel("setSelectionStyle:"), 0);
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    field: int = msg(make("UITextField"), sel("autorelease"));
    msg1(field, sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleBody")));
    msg1(field, sel("setAdjustsFontForContentSizeCategory:"), 1);
    msg1(field, sel("setTextColor:"), c_ink);
    msg1(field, sel("setClearButtonMode:"), 1);
    msg1(field, sel("setAutocapitalizationType:"), 1);
    msg1(field, sel("setReturnKeyType:"), 9);
    msg1(field, sel("setDelegate:"), app_obj);
    msg1(field, sel("setAccessibilityLabel:"), nsstring(w_name));
    msg1(field, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    content: int = msg(cell, sel("contentView"));
    msg1(content, sel("addSubview:"), field);
    guide: int = msg(content, sel("layoutMarginsGuide"));
    for edge in ["leadingAnchor", "trailingAnchor", "topAnchor", "bottomAnchor"] pin(field,
        guide, edge);
    pin_min_height(field, 22.0f64);
    field_out[0] = cell;
    field_out[1] = field
}

field_pair: []int = new int[2](0);

// A view at least d points high.
pin_min_height(v: int, d: f64) {
    msg1(msg_set_f(msg(v, sel("heightAnchor")), sel("constraintGreaterThanOrEqualToConstant:"),
        d), sel("setActive:"), 1)
}

// A field's text, into nm_in (its length).
nm_in: []i8 = new i8[512](0i8);

// ---- a row of color swatches (New Ribbon's and Ribbon's: owner,
// 2026-10-19) ----
// (The rows are core's screens': ios/skin.l8 keeps a cell of them for each,
// owner 10 + its slot.)
SWATCH: f64 = 30.0f64;

// A cell of the palette's swatches, each a round button of its color (its
// tag the color), owner's, k chosen.
swatch_cell(owner: int, k: int): int {
    cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, 0), sel("autorelease"));
    msg1(cell, sel("setSelectionStyle:"), 0);
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    stack: int = msg(make("UIStackView"), sel("autorelease"));
    msg1(stack, sel("setAxis:"), 0);
    msg_set_f(stack, sel("setSpacing:"), 12.0f64);
    msg1(stack, sel("setTag:"), 9300 + owner);
    msg1(stack, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    for j in 0..RB_COLORS {
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTag:"), j);
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        pin_size(b, "widthAnchor", SWATCH);
        pin_size(b, "heightAnchor", SWATCH);
        msg_set_f(msg(b, sel("layer")), sel("setCornerRadius:"), SWATCH / 2.0f64);
        msg1(b, sel("setAccessibilityLabel:"), nsstring(rb_color_names[j]));
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("ribbonSwatch:"),
            64);
        msg1(stack, sel("addArrangedSubview:"), b)
    }
    content: int = msg(cell, sel("contentView"));
    msg1(content, sel("addSubview:"), stack);
    guide: int = msg(content, sel("layoutMarginsGuide"));
    for edge in ["leadingAnchor", "topAnchor", "bottomAnchor"] pin(stack, guide, edge);
    swatches_set(stack, k);
    cell
}

// The swatches shown for the theme, k's checked (a checkmark in the page's
// color) and selected for VoiceOver ("Gold, selected, button").
swatches_set(stack: int, k: int) {
    if (stack == 0) return;
    views: int = msg(stack, sel("arrangedSubviews"));
    for j in 0..msg(views, sel("count")) {
        b: int = msg1(views, sel("objectAtIndex:"), j);
        msg1(b, sel("setBackgroundColor:"), ribbon_ui_color(j));
        msg2(b, sel("setImage:forState:"), if (j == k) symbol("checkmark", 13.0f64,
            7, c_bg) else 0, 0);
        msg1(b, sel("setAccessibilityTraits:"), objc_const("UIAccessibilityTraitButton") | (if (j == k) objc_const("UIAccessibilityTraitSelected") else 0))
    }
}

swatch_stack(cell: int, owner: int): int {
    if (cell == 0) 0 else msg1(msg(cell, sel("contentView")), sel("viewWithTag:"),
        9300 + owner)
}

// A swatch tapped: New Ribbon's color to give, or the ribbon's own, at
// once (kept, and everywhere its glyph is); the check moved with a 0.15 s
// cross-fade, a selection haptic.
ribbon_swatch(_self: int, _cmd: int, b: int): int {
    k: int = msg(b, sel("tag"));
    stack: int = msg(b, sel("superview"));
    if (stack == 0 || k < 0 || k >= RB_COLORS) return 0;
    owner: int = msg(stack, sel("tag")) - 9300;
    if (!reduce_motion()) fade_layer(msg(stack, sel("layer")), 0.15f64);
    swatches_set(stack, k);
    haptic_select();
    note_num("bible: ribbon color chosen ", k);
    // (Core's: New Ribbon's color to give, or the ribbon's own at once.)
    if (owner >= 10) uk_swatch_tapped(owner - 10, k);
    0
}

// Ribbon i's own screen, pushed (by its row's ⓘ).
open_ribbon_screen(i: int) {
    sheet_nav: int = presented();
    if (sheet_nav == 0 || i < 0 || i >= rb_n) return;
    note_num("bible: ribbon details ", rb_id[i]);
    uk_open(SCR_RIBBON, rb_id[i], true, sheet_nav)
}

// (New Ribbon's Add, as its button would: the demos'.)
nr_add() {
    uk_confirm_kind(SCR_NEW_RIBBON)
}

// The keyboard's Done: New Ribbon's is Add; Ribbon's ends the editing.
field_should_return(_self: int, _cmd: int, field: int): int {
    if (uk_field_return(field)) return 1;
    msg(field, sel("resignFirstResponder"));
    1
}

field_did_end(_self: int, _cmd: int, field: int): int {
    _e: bool = uk_field_end(field);
    0
}

title_menu(_c: int): int {
    uk_title_build();
    kids: int = msg(cls("NSMutableArray"), sel("array"));
    if (ui_sections_n > 0) {
        for x in 0..ui_sections[0].n msg1(kids, sel("addObject:"), uk_title_item(ui_sections[0].first + x))
    }
    if (ui_sections_n > 1) {
        moves: int = msg(cls("NSMutableArray"), sel("array"));
        for x in 0..ui_sections[1].n msg1(moves, sel("addObject:"), uk_title_item(ui_sections[1].first + x));
        msg1(kids, sel("addObject:"), msg5(cls("UIMenu"), sel("menuWithTitle:image:identifier:options:children:"),
            uk_text(ui_sections[1].header), ribbon_glyph(17.0f64), 0, 0, moves))
    }
    msg2(cls("UIMenu"), sel("menuWithTitle:children:"), if (ui_title.n > 0) uk_text(ui_title) else nsstring(""),
        kids)
}

// The title menu's model (core/tray.l8's), at the reader's place as last
// measured.
uk_title_build() {
    uk_sync();
    sk_build_title_menu();
    uk_stale = true
}

// Row i of it as a command: its ribbon's glyph in its color, its words,
// where it is (a subtitle), off if it can't be done.
uk_title_item(i: int): int {
    row: UiRow = ui_rows[i];
    glyph: int = ribbon_glyph(17.0f64);
    if (row.icon_color.n > 0) glyph = msg2(glyph, sel("imageWithTintColor:renderingMode:"),
        uk_icon_color(row), 1);
    cmd: int = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
        uk_text(row.title), glyph, sel("coreTitleItem:"), nsnumber_int(i));
    if (row.detail.n > 0 && responds(cmd, "setSubtitle:")) msg1(cmd, sel("setSubtitle:"),
        uk_text(row.detail));
    if (row.disabled) msg1(cmd, sel("setAttributes:"), 1);
    cmd
}

// An item chosen: its action, core's, at the place measured now.
title_item_chosen(_self: int, _cmd: int, sender: int): int {
    if (sender == 0 || !responds(sender, "propertyList")) return 0;
    n: int = msg(sender, sel("propertyList"));
    if (n == 0) return 0;
    i: int = msg(n, sel("longValue"));
    uk_title_build();
    if (i < 0 || i >= ui_rows_n) return 0;
    uk_title_act(ui_rows[i].action, ui_rows[i].arg);
    0
}

uk_title_act(action: int, arg: int) {
    if (table != 0) measure_place();
    uk_sync();
    uk_nav = 0;
    sk_title_act(action, arg);
    uk_effects()
}

// The compact band's menu, and the title's buttons' (for the chapter each
// shows).
title_menu_set(b: int, c: int) {
    if (b == 0 || c < 0) return;
    // (Not the day's reader's: no ribbons there.)
    if (day_on) {
        msg1(b, sel("setMenu:"), 0);
        return
    }
    msg1(b, sel("setMenu:"), title_menu(c))
}

// The title's and the compact band's menus made again,
// and what VoiceOver says of them (a ribbon made, moved, picked up or put
// down; or the reader at rest elsewhere).
compact_menu_c: int = -2;

title_menus_refresh() {
    title_menu_set(title_btn[0], title_btn_c[0]);
    compact_menu_c = -2;
    title_compact_menu();
    title_ribbon_update();
    title_actions(title_btn[0]);
    title_actions(compact_button)
}

// The same, the place measured first: after an arrival (a jump, the
// capsule, a ribbon opened, their settles), whose place is not yet
// measured, so New Ribbon Here… says where the reader now is (review
// r8-1).
title_menus_fresh() {
    if (table != 0 && restored && cur >= 0) measure_place();
    title_menus_refresh()
}

// (Made only when the chapter it is for changes: the band is laid out at
// every frame of a scroll.)
title_compact_menu() {
    if (compact_button == 0 || title_view == 0) return;
    c: int = title_btn_c[0];
    if (c == compact_menu_c || c < 0) return;
    compact_menu_c = c;
    title_menu_set(compact_button, c)
}

// VoiceOver's: New Ribbon Here, and Leave Morning Here while carried; the
// value "Reading with Morning".
title_actions(b: int) {
    if (b == 0) return;
    if (day_on) {
        msg1(b, sel("setAccessibilityCustomActions:"), 0);
        if (b == compact_button) msg1(b, sel("setAccessibilityValue:"), 0);
        return
    }
    k: int = rb_carried_i();
    one[0] = custom_action(new_ribbon_here_words, "newRibbonHereAction:");
    n: int = 1;
    if (k >= 0) {
        fput_leave_here(k);
        one[1] = msg(msg3(msg(cls("UIAccessibilityCustomAction"), sel("alloc")), sel("initWithName:target:selector:"),
            fstring(), app_obj, sel("leaveRibbonHereAction:")), sel("autorelease"));
        n = 2
    }
    msg1(b, sel("setAccessibilityCustomActions:"), nsarray(one, n));
    if (k >= 0) {
        fput_reading_with(k);
        msg1(b, sel("setAccessibilityValue:"), fstring())
    } else msg1(b, sel("setAccessibilityValue:"), 0)
}

// New Ribbon Here…: the sheet, at the place measured now.
new_ribbon_here(_self: int, _cmd: int, _sender: int): int {
    note("bible: new ribbon here");
    uk_title_act(ACT_TM_NEW, 0);
    0
}

new_ribbon_here_action(_self: int, _cmd: int, _a: int): int {
    _r: int = new_ribbon_here(0, 0, 0);
    1
}

// Move Ribbon Here › name: it takes the place, and is picked up.
move_ribbon_here(_self: int, _cmd: int, sender: int): int {
    id: int = 0;
    if (sender != 0 && responds(sender, "propertyList")) {
        n: int = msg(sender, sel("propertyList"));
        if (n != 0 && responds(n, "longValue")) id = msg(n, sel("longValue"))
    }
    ribbon_move_here_now(id);
    0
}

ribbon_move_here_now(id: int) {
    uk_title_act(ACT_TM_MOVE, id)
}

// Leave Morning Here: the place measured once, then put down; the toast
// "Morning left at Romans 8:20".
leave_ribbon_here(_self: int, _cmd: int, _sender: int): int {
    ribbon_leave_now();
    0
}

leave_ribbon_here_action(_self: int, _cmd: int, _a: int): int {
    ribbon_leave_now();
    1
}

ribbon_leave_now() {
    uk_title_act(ACT_TM_LEAVE, 0)
}

// ---- the sheet gone ----
ribbons_sheet_gone() { }

// The theme changed: the cells core's screens keep (fields and swatches),
// in it.
style_ribbon_sheets() {
    uk_restyle_kept()
}

// ---- classes and methods ----
make_ribbon_classes() { }

// (The title's commands go up the responder chain from the reader: its
// controller has them too.)
add_ribbon_commands(k: int) {
    add_method1(k, sel("newRibbonHere:"), &new_ribbon_here, "v@:@");
    add_method1(k, sel("moveRibbonHere:"), &move_ribbon_here, "v@:@");
    add_method1(k, sel("leaveRibbonHere:"), &leave_ribbon_here, "v@:@")
}

add_ribbon_methods(app: int) {
    add_ribbon_commands(app);
    add_method1(app, sel("readingSettle:"), &reading_settle, "v@:@");
    add_method1(app, sel("ribbonSwatch:"), &ribbon_swatch, "v@:@");
    add_method1(app, sel("newRibbonHereAction:"), &new_ribbon_here_action, "B@:@");
    add_method1(app, sel("coreTitleItem:"), &title_item_chosen, "v@:@");
    add_method1(app, sel("leaveRibbonHereAction:"), &leave_ribbon_here_action, "B@:@");
    add_method1(app, sel("textFieldShouldReturn:"), &field_should_return, "B@:@");
    add_method1(app, sel("textFieldDidEndEditing:"), &field_did_end, "v@:@")
}

// ---- the ribbons' lists (tables.l8) ----
ribbons_screens() {
    on_sheet_gone(&ribbons_sheet_gone)
}
