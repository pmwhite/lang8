tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 11 steps (DESIGN.md §14.11.9): the `original` group,
// shots 270 to 295, on the demo clock: 120 Greek words known, 300 Hebrew
// with the alphabet and the joined words; the Versions screen; John 1 in
// Greek glossed by the words not learned, then the rare ones; μονογενής's
// popover in John 1:14, Learn This Word; John 3 once it is graded Knew It;
// Genesis 1 and Psalm 23 in Hebrew, Show Accents, a Qere's popover with its
// Ketiv, Malachi 4:1's (Hebrew 3:19), Daniel 2:4's Aramaic; Listen's row;
// Memory, Practice and Type in Hebrew and Greek with the letter keyboard;
// Search by Latin and Hebrew letters; Compare; Share as Image; Night; the
// largest text; Read in Greek; a BSB highlight seen in Greek; and the
// recording of sequence 17. Each tap is made through the function the
// control calls.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/learn.l8";

import "../core/orig.l8";

// Chapter c's apparatus entry for a word of number num (Greek or Hebrew),
// in verse v (0: any): its word, and where it is on the screen (hfa);
// -1 if none is laid out.
d11_entry(c: int, num: int, v: int): int {
    tv: int = view_of(c);
    if (tv == 0) return -1;
    compute_ranges(c);
    p: int = 0;
    found: int = -1;
    at: int = 0;
    for r in 0..runs {
        if (found < 0 && run_style[r] == STYLE_APP_ENTRY) {
            w: int = run_arg[r] - 1;
            ok: bool = num == 0 || og_strongs(w) == num;
            if (ok && v > 0) {
                og_where(w);
                ok = og_wv == v
            }
            if (ok) {
                found = w;
                at = shifted(u16_at[p], true)
            }
        }
        p = run_end[r]
    }
    if (found < 0 || !range_rect(tv, at, 1)) return -1;
    found
}

// The popover of that entry, as a tap on it would open it (the entry
// brought up the screen first, to just below its middle).
d11_popover(c: int, num: int, v: int) {
    w: int = d11_entry(c, num, v);
    if (w < 0) {
        note_num("bible: demo no apparatus entry for ", num);
        return
    }
    ey: f64 = hfa[1];
    seen: f64 = view_height(table);
    set_offset(row_y(c) + ey - seen * 0.55f64);
    w2: int = d11_entry(c, num, v);
    if (w2 < 0) return;
    tv: int = view_of(c);
    show_word_popover(tv, c, w2, hfa[0] + 6.0f64, hfa[1] + hfa[3] * 0.5f64)
}

// A word of the original, its popover from where it stands in the text
// (a Qere's: not glossed, it has no entry).
d11_word_popover(w: int) {
    og_where(w);
    c: int = og_wc;
    tv: int = view_of(c);
    if (tv == 0) return;
    compute_ranges(c);
    for i in 0..ow_n {
        if (ow_w[i] == w) {
            at: int = shifted(u16_at[ow_b[i]], true);
            if (range_rect(tv, at, 1)) {
                show_word_popover(tv, c, w, hfa[0] + hfa[2] * 0.5f64, hfa[1] + hfa[3] * 0.5f64);
                return
            }
        }
    }
}

// The first Qere word of the Hebrew whose lemma is glossed now, past
// Genesis's first chapters (-1: none).
d11_qere(): int {
    for w in 0..og_n {
        if ((og_flags(w) & OG_QERE) != 0 && og_wanted(w, OG_UNLEARNED) && og_ketiv(w)) return w
    }
    -1
}

d11_qere_w: int = -1;

// The reader in the original at chapter c's verse v (its top: v 0).
d11_go(c: int, v: int) {
    demo_dismiss();
    clear_selection();
    if (text_cur != TEXT_ORIG) switch_version(TEXT_ORIG);
    if (v > 0) go_verse(c, v) else go_top(c)
}

demo_do11(t: int) {
    if (t == 600) {
        // 270: Reading settings → Version: Hebrew and Greek under Original
        // Languages. (The cards first: 120 Greek, 300 Hebrew.)
        demo_dismiss();
        demo_learn_known(0, 120);
        demo_learn_known(1, 300);
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB);
        go_top(john1());
        demo_later_at(0.6f64, 1100)
    }
    if (t == 601) {
        // 271: John 1 in Greek, words not learned glossed (the cross-fade
        // from Versions' row, then the sheet put away).
        versions_picked(1, 0);
        demo_later_at(0.8f64, 1101)
    }
    if (t == 602) {
        // 272: the same, Rare Words.
        set_gloss_mode(OG_RARE)
    }
    if (t == 603) {
        // 273: (words not learned again) μονογενής's popover, John 1:14.
        set_gloss_mode(OG_UNLEARNED);
        go_verse(john1(), 14);
        demo_later_at(0.8f64, 1102)
    }
    if (t == 604) {
        // 274: Learn This Word: its toast.
        wp_learn_tapped(0, 0, 0)
    }
    if (t == 605) {
        // 275: μονογενής's card graded Knew It in Practice; John 3, laid out
        // again as Practice closed: no longer glossed.
        // (Practice once the popover has gone: presented at once, it was
        // presented on the popover going away, "not in the window
        // hierarchy", review r11-1.)
        demo_dismiss();
        demo_later_at(0.3f64, 1107)
    }
    if (t == 606) {
        // 276: Genesis 1 in Hebrew.
        d11_go(0, 0)
    }
    if (t == 607) {
        // 277: Psalm 23: its title, a verse a line.
        d11_go(psalm23(), 0)
    }
    if (t == 608) set_accents(true);
    if (t == 609) {
        // 279: (accents off) a Qere's popover, its Ketiv.
        set_accents(false);
        d11_qere_w = d11_qere();
        if (d11_qere_w >= 0) {
            og_where(d11_qere_w);
            d11_go(og_wc, og_wv);
            demo_later_at(0.8f64, 1104)
        }
    }
    if (t == 610) {
        // 280: Malachi 4:1's first glossed word: Hebrew 3:19.
        d11_go(malachi4(), 1);
        demo_later_at(0.8f64, 1105)
    }
    if (t == 611) {
        // 281: Daniel 2:4, its Aramaic glossed.
        d11_go(book_first[26] + 1, 4)
    }
    if (t == 612) {
        // 282: Listen in Greek: Reading settings, its row "No recording of
        // the original yet.", disabled; the version's own rows.
        d11_go(john1(), 0);
        listen_start(cur, 1);
        demo_later_at(0.8f64, 1106)
    }
    if (t == 613) {
        // 283: the same in Hebrew (Psalm 23).
        d11_go(psalm23(), 0);
        demo_later_at(0.8f64, 1106)
    }
    if (t == 614) {
        // 284: Psalm 23:1–3 in Hebrew, memorized (the tray's Memorize).
        d11_go(psalm23(), 1);
        toggle_verse(psalm23(), 1);
        toggle_verse(psalm23(), 2);
        toggle_verse(psalm23(), 3);
        demo_later_at(0.5f64, 1130)
    }
    if (t == 615) {
        // 285: its Practice at Letters, right to left.
        toast_clear();
        demo_dismiss();
        i: int = d8_find("PSA", 23, 1);
        if (i >= 0) practice_open_one(i);
        demo_later_at(1.0f64, 1131)
    }
    if (t == 616) {
        // 286: Type: the Hebrew letter keyboard, three words typed.
        px_typing = true;
        set_def_bool("memoryType", true);
        px_keyboard(true);
        d8_type(3, -1)
    }
    if (t == 617) {
        // 287: John 1:1 in Greek memorized, its Practice, the Greek letter
        // keyboard.
        practice_close(true);
        demo_dismiss();
        d11_go(john1(), 1);
        toggle_verse(john1(), 1);
        tray_memorize();
        demo_later_at(0.8f64, 1132)
    }
    if (t == 618) {
        // 288: Search "agape".
        practice_close(true);
        d11_go(john3(), 16);
        demo_later_at(0.5f64, 1133)
    }
    if (t == 619) {
        // 289: Search "שלום" (no points).
        demo_search("\�\�\�\�\�\�\�\�")
    }
    if (t == 620) {
        // 290: Compare John 3:16, the Greek row first (the version read).
        d11_go(john3(), 16);
        demo_later_at(0.5f64, 1134)
    }
    if (t == 627) {
        // 291: Share as Image of Psalm 23:1 in Hebrew.
        d11_go(psalm23(), 1);
        demo_verses[0] = 1;
        share_keep(psalm23(), demo_verses, 1);
        demo_later_at(0.5f64, 1135)
    }
    if (t == 628) {
        // 294: the Greek page from the BSB at John 3: Read in Greek.
        share_finish(false);
        demo_dismiss();
        clear_selection();
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB);
        go_verse(john3(), 16);
        set_def_int("librarySegment", 3);
        demo_later_at(0.5f64, 1136)
    }
    if (t == 629) {
        // 294b: tapped: the reader in Greek at John 3.
        read_in(0)
    }
    if (t == 621) {
        // 292: Night, Hebrew (Genesis 1).
        d11_go(0, 0);
        set_theme = 4;
        settings_changed(true)
    }
    if (t == 622) {
        // 293: (the largest text) Greek with its apparatus: John 1.
        set_theme = 0;
        settings_changed(true);
        d11_go(john1(), 0);
        demo_later_at(0.8f64, 1140)
    }
    if (t == 624) {
        // 295: a highlight made in the BSB on John 3:16, seen in Greek.
        d11_go(john3(), 16);
        switch_version(TEXT_BSB);
        demo_verses[0] = 16;
        apply_highlight(john3(), demo_verses, 1, 2);
        clear_selection();
        switch_version(TEXT_ORIG);
        go_verse(john3(), 16)
    }
    if (t == 625) {
        // Sequence 17's setup: the BSB at John 3, its top.
        demo_dismiss();
        clear_selection();
        if (day_on) day_close(false);
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB);
        go_verse(john3(), 16)
    }
    if (t == 626) demo_sequence11();
    if (t == 630) {
        // 295b: Psalm 23 in Hebrew, verse 1 highlighted there and verse 2
        // selected: the wash and the selection's line, right to left. (At
        // verse 2, a third of the way down, verse 1 above it: both above
        // the tray; at verse 1, the psalm's heading came mid-screen and
        // verse 2 under the tray, review r11-1.)
        d11_go(psalm23(), 2);
        demo_verses[0] = 1;
        apply_highlight(psalm23(), demo_verses, 1, 2);
        toggle_verse(psalm23(), 2)
    }
    if (t == 631) {
        // 296: a plan's day in the Hebrew and Greek (M'Cheyne's day 1:
        // Genesis 1, Matthew 1, Ezra 1, Acts 1): Genesis 1's end and
        // Matthew 1's start, each with its apparatus.
        clear_selection();
        demo_dismiss();
        day_open(PLAN_MCHEYNE, 1, -1);
        demo_later_at(1.0f64, 1141)
    }
    if (t == 632) {
        // 296b: an apparatus entry of Matthew 1 in the day: its popover.
        d11_popover(book_first[39], 0, 0)
    }
    if (t == 633) {
        // (The ipad group's, after 503.) 503b: the Hebrew and Greek on the
        // iPad, John 3:16 selected, Study beside it.
        demo_dismiss();
        clear_selection();
        if (text_cur != TEXT_ORIG) switch_version(TEXT_ORIG);
        go_place(john3(), 14, 0);
        demo_later_at(0.6f64, 1142)
    }
    if (t == 634) {
        // 503c: an apparatus entry of John 3:16 there: its popover.
        d11_popover(john3(), 0, 16)
    }
    if (t == 635) {
        // (Put away: Study beside closed, the BSB again.)
        demo_dismiss();
        clear_selection();
        if (bs_open) beside_close();
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB)
    }
}

john1(): int {
    book_first[42]
}

malachi4(): int {
    book_first[38] + 3
}

demo_later11(d: int) {
    if (d >= 1120 && d < 1130) {
        demo_seq11_step(d);
        return
    }
    // (What opens a sheet waits until no sheet is left going away.)
    if ((d == 1100 || d == 1106 || d == 1107 || d == 1132 || d == 1133 || d == 1134 || d == 1135 || d == 1136) && presented() != 0) {
        demo_later_at(0.3f64, d);
        return
    }
    if (d == 1100) {
        open_settings();
        demo_later_at(0.8f64, 1110)
    }
    if (d == 1110) {
        open_versions();
        demo_later_at(0.7f64, 1111)
    }
    // (Its last section, Original Languages, in sight at the sheet's foot.)
    if (d == 1111 && versions_table != 0) msg3(versions_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
        msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0, 1), 3, 0);
    if (d == 1141) {
        // (Matthew 1's row a little below the screen's middle, Genesis 1's
        // end above it.)
        set_offset(row_y(book_first[39]) - view_height(table) * 0.55f64)
    }
    if (d == 1142) {
        toggle_verse(john3(), 16);
        tray_action(0, 0, tray_actions[4]);
        d17_column()
    }
    if (d == 1101) {
        demo_dismiss();
        go_top(john1())
    }
    if (d == 1102) d11_popover(john1(), 3439, 14);
    if (d == 1103) {
        // (Check, Knew It, and Practice closed: the reader laid out again.)
        // (A new card is shown first with its answer; Next brings it back to
        // be judged: Check, Knew It.)
        k: int = card_of_word(0, 3439);
        for _i in 0..6 {
            if (k >= 0 && !cd_known(k)) {
                if (crd_active && px_step == PX_CARD_DONE) memory_grade_now(G_KNEW) else if (crd_active && px_step == PX_CARD) memory_check() else memory_main()
            }
        }
        practice_close(true);
        demo_dismiss();
        go_verse(john3(), 16)
    }
    if (d == 1104 && d11_qere_w >= 0) {
        // (Its apparatus entry, as a tap would open it.)
        og_where(d11_qere_w);
        d11_popover(og_wc, og_strongs(d11_qere_w), og_wv)
    }
    if (d == 1105) {
        og_verse(malachi4(), 1);
        for w in og_vb..og_ve {
            if (og_glossed(w)) {
                d11_popover(malachi4(), og_strongs(w), 1);
                return
            }
        }
    }
    if (d == 1106) open_settings();
    if (d == 1107) {
        k: int = card_of_word(0, 3439);
        if (k >= 0) {
            d10_practice_card(k);
            demo_later_at(0.8f64, 1103)
        }
    }
    if (d == 1130) tray_action(0, 0, tray_actions[6]);
    if (d == 1131) px_set_level(LV_LETTERS);
    if (d == 1132) {
        toast_clear();
        i: int = d8_find("JHN", 1, 1);
        if (i >= 0) practice_open_one(i);
        demo_later_at(1.0f64, 1137)
    }
    if (d == 1137) {
        px_typing = true;
        set_def_bool("memoryType", true);
        px_keyboard(true);
        d8_type(4, -1)
    }
    if (d == 1133) {
        open_search();
        demo_later_at(0.8f64, 1138)
    }
    if (d == 1138) demo_search("agape");
    if (d == 1134) {
        compare_verses[0] = 16;
        open_compare(john3(), compare_verses, 1)
    }
    if (d == 1135) {
        sh_by_demo = true;
        msg3(nav, sel("presentViewController:animated:completion:"), make_composer(),
            1, 0);
        share_card_save("share-card-hebrew.png")
    }
    if (d == 1136) {
        open_library();
        demo_later_at(0.9f64, 1139)
    }
    if (d == 1139) open_language(0);
    if (d == 1140) {
        // (The first paragraph's apparatus in the middle of the screen.)
        if (d11_entry(john1(), 0, 0) >= 0) {
            ey: f64 = hfa[1];
            set_offset(row_y(john1()) + ey - view_height(table) * 0.5f64)
        }
    }
}

// ---- sequence 17: BSB → Hebrew and Greek at John 3, into John 4, an
// apparatus entry's popover, Learn This Word, closed ----
d11_seq_frame: int = 0;

demo_sequence11() {
    d11_seq_frame = 0;
    demo_later_at(0.1f64, 1120)
}

demo_seq11_step(d: int) {
    if (d == 1120) {
        // (The switch, cross-fading, the verse kept.)
        switch_version(TEXT_ORIG);
        demo_later_at(1.6f64, 1121)
    }
    if (d == 1121) {
        // (Down into John 4, gliding.)
        stop_moving();
        y: f64 = row_y(john3() + 1) - top_inset(table) + em * 2.0f64;
        msg_ff1(table, sel("setContentOffset:animated:"), 0.0f64, y, 1);
        demo_later_at(1.6f64, 1122)
    }
    if (d == 1122) {
        // (The first entry of John 4: its popover.)
        d11_popover(john3() + 1, 0, 0);
        demo_later_at(1.8f64, 1123)
    }
    if (d == 1123) {
        wp_learn_tapped(0, 0, 0);
        demo_later_at(1.6f64, 1124)
    }
    if (d == 1124) {
        if (presented() != 0) msg2(nav, sel("dismissViewControllerAnimated:completion:"),
            1, 0)
    }
}
