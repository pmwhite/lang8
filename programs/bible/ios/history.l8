tag bible_ios;

use_tag std, ios, bible;

// History (DESIGN.md §8.3): core's screen (core/skin.l8, SCR_HISTORY),
// pushed from the passage picker's Recent section by Show All; and the
// local time, which other screens use too.
import "../../ios/objc.l8";

import "../core/text.l8";

// The local time's offset from UTC, in seconds (now).
local_offset(): int {
    msg(msg(cls("NSTimeZone"), sel("localTimeZone")), sel("secondsFromGMT"))
}

// The day (local) of a time.
local_day(t: int): int {
    day_of(t + local_offset())
}

open_history() {
    if (presented() == 0) return;
    uk_open(SCR_HISTORY, 0, true, presented())
}
