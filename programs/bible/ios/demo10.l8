tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 10 steps (DESIGN.md §14.9.2, §14.10b.5): the
// `languages` group, shots 240 to 269 (and 246b, 249b), on the demo clock, from what simulate.sh writes
// before the first launch (Philippians 4:6–7 in Memory, a highlight on
// John 3:16, History with John 1–3 this week, no cards): the
// interlinear's link, the Greek page, the Alphabet and its first letters
// in Practice, Add Words and its preview, words in Practice and a word's
// answer, 120 words known, Related to Words You Know, John 3:16 with what
// is known hidden (its tiles where they were), a tile shown, the word
// study's rows, Forms and a form's concordance, Sounds Written As from the
// Alphabet, Verses You Can Read, Memory's rows, a passage's words,
// Hebrew's alphabet, a joined word, Psalm 23:1 hidden, Hebrew forms, the
// reminder, Night, the largest text, Practise Reading; and the recording
// of sequence 16. Each tap is made through the function the control calls.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/memory.l8";

import "../core/learn.l8";

// The verse's word of number num (Greek or Hebrew), or -1.
d10_word(vi: int, greek: bool, num: int): int {
    for w in v_first(vi)..v_end(vi)
        if (w_greek(w) == greek && w_strongs(w) == num) return w;
    -1
}

// demo_learn_known: the alphabet (and Hebrew's joined words) and the n
// most common words of a language known; of Greek's, 14 due today.
demo_learn_known(lang: int, n: int) {
    ensure_learn_lang();
    for i in 0..lt_n {
        if (lt_lang[i] == lang) {
            k: int = if (cl_of[i] >= 0) cl_of[i] else learn_add_letter(i, FROM_KNOWN,
                today(), time(0));
            if (k >= 0 && !cd_known(k)) learn_mark_known(k, today(), time(0))
        }
    }
    due: int = 0;
    for x in 0..n {
        num: int = vl_num(lang, x);
        k: int = card_of_word(lang, num);
        if (k < 0) k = learn_add_word(lang, num, FROM_KNOWN, today(), time(0));
        if (k >= 0) {
            learn_mark_known(k, today(), time(0));
            if (lang == 0 && due < 14 && x >= 10) {
                cd_due[k] = today();
                due = due + 1
            }
        }
    }
    learn_refresh();
    cards_changed();
    note_num("bible: demo learn known ", n)
}

// The verse of the Study screen shown (core's), or -1.
d10_vi(): int {
    lang_verse(sk_vs_c, sk_vs_v)
}

// The interlinear's tiles, as core has them: "bible: interlinear tiles
// JHN 3:16 original 17 tiles".
d10_tiles() {
    vi: int = d10_vi();
    if (vi < 0) return;
    original: bool = def_int("interlinearOrder") == 1;
    interlinear_tiles(vi, original);
    fbuf_n = 0;
    fput_str("bible: interlinear tiles ");
    c: int = v_chapter(vi);
    b: int = ch_book[c];
    for x in 0..3 fput(bsb_code_at(b, x));
    fput(32);
    fput_int(ch_num[c]);
    fput(58);
    fput_int(v_num(vi));
    fput_str(if (original) " original " else " english ");
    fput_int(tile_n);
    fput_str(" tiles");
    note_ns(fstring())
}

// The Study screen at its end (the language's link in sight), or its top.
d10_scroll_end() {
    t: int = uk_table_of(SCR_VERSE_STUDY);
    if (t == 0) return;
    msg(t, sel("layoutIfNeeded"));
    l8_msg_hfa(hfa, t, sel("contentSize"), 0, 0, 0);
    msg_ff1(t, sel("setContentOffset:animated:"), 0.0f64, hfa[1] - view_height(t),
        0)
}

d10_scroll_top() {
    t: int = uk_table_of(SCR_VERSE_STUDY);
    if (t != 0) msg_ff1(t, sel("setContentOffset:animated:"), 0.0f64, -top_inset(t),
        0)
}

// Word w's tile tapped (its meaning shown, if hidden; else its study).
tile_show(w: int): bool {
    if (w < 0) return false;
    uk_act_kind(SCR_VERSE_STUDY, ACT_VS_TILE, w);
    true
}

// The language's link (Learn Greek), tapped.
d10_link() {
    vi: int = d10_vi();
    if (vi >= 0) uk_tap(SCR_VERSE_STUDY, ACT_MM_LANGUAGE, if (w_greek(v_first(vi))) 0 else 1)
}

// A sheet still up (or going): dismissed, and code d done a moment later;
// true if so.
d10_clear(d: int): bool {
    if (presented() == 0) return false;
    demo_dismiss();
    demo_later_at(0.6f64, d);
    true
}

// Back to the sheet's page of class c (its first), or its root.
d10_pop_to(vc: int) {
    top: int = top_presented();
    if (top == 0) return;
    if (vc != 0) msg2(top, sel("popToViewController:animated:"), vc, 0) else msg1(top,
        sel("popToRootViewControllerAnimated:"), 0)
}

// The forms' parsing whose form is s's (first), or -1.
d10_form(s: str): int {
    for g in 0..fo_n {
        if (fo_form[g] >= 0) {
            p: int = form_at[fo_form[g]];
            same: bool = true;
            for i in 0..len(s)
                if (p + i >= lforms_len || lforms[p + i] != s[i]) same = false;
            if (same && lforms[p + len(s)] as int == 9) return g
        }
    }
    -1
}

// The Practice of one card.
d10_practice_card(k: int) {
    if (k < 0) return;
    px_q[0] = -k - 1;
    px_back[0] = false;
    px_open(1)
}

demo_do10(t: int) {
    if (t == 400) {
        // 240: John 3:16's study, Greek Order, at its end (the link).
        demo_dismiss();
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB);
        clear_selection();
        go_verse(john3(), 16);
        set_def_int("interlinearOrder", 1);
        demo_later_at(0.6f64, 700)
    }
    if (t == 401) {
        // 241: Learn Greek.
        d10_tiles();
        d10_link()
    }
    if (t == 402) {
        // 242: the Alphabet, at its end (Sounds Written As).
        open_alphabet();
        demo_later_at(0.8f64, 747)
    }
    if (t == 403) {
        // 243: Learn 8 Letters: Practice of them, the first new.
        uk_act_kind(SCR_ALPHABET, ACT_LN_LETTERS, 0)
    }
    if (t == 404) {
        // 244: Next ×8; the first back, hidden.
        for _k in 0..8 memory_main()
    }
    if (t == 405) memory_check();
    if (t == 406) {
        // 246: the letters judged (Knew It), closed; Add Words.
        for _k in 0..8 {
            if (crd_active && px_step == PX_CARD_DONE) memory_grade_now(G_KNEW) else if (crd_active && px_step == PX_CARD) memory_check();
            if (crd_active && px_step == PX_CARD_DONE) memory_grade_now(G_KNEW)
        }
        practice_close(true);
        demo_later_at(0.8f64, 701)
    }
    if (t == 407) open_word_preview(-1);
    if (t == 408) {
        // 248: Add; the page's Practice.
        uk_act_kind(SCR_PREVIEW, ACT_LN_ADD, 0);
        demo_later_at(0.9f64, 702)
    }
    if (t == 409) {
        // 249: (the alphabet known) λέγω's card in review, its front.
        practice_close(true);
        learn_know_all_lang(0);
        k: int = card_of_word(0, 3004);
        if (k < 0) k = learn_add_word(0, 3004, FROM_FREQ, today(), time(0));
        if (k >= 0) {
            cd_state[k] = MS_REVIEW;
            cd_box[k] = 2;
            cd_due[k] = today();
            cd_seen[k] = 2
        }
        // (A word of its family known: ἀποκρίνομαι, for 249b's Related.)
        r: int = card_of_word(0, 611);
        if (r < 0) r = learn_add_word(0, 611, FROM_KNOWN, today(), time(0));
        if (r >= 0) learn_mark_known(r, today(), time(0));
        cards_changed();
        demo_later_at(0.8f64, 703)
    }
    if (t == 436) {
        // 249b: Check: λέγω's answer.
        memory_check()
    }
    if (t == 435) {
        // 246b: Add Words with Related to Words You Know (120 known).
        open_add_words()
    }
    if (t == 410) {
        // 250: 120 words known; the Greek page.
        practice_close(true);
        demo_learn_known(0, 120);
        demo_later_at(0.6f64, 704)
    }
    if (t == 411) {
        // 251: John 3:16 in Greek Order, what is known hidden.
        d10_pop_to(0);
        demo_later_at(0.6f64, 705)
    }
    if (t == 412) {
        // 252: ἠγάπησεν shown.
        _s: bool = tile_show(d10_word(d10_vi(), true, 25))
    }
    if (t == 413) {
        // 253: tapped again: its word study.
        d10_tap(25);
        demo_later_at(0.8f64, 706)
    }
    if (t == 414) open_forms(true, 25);
    if (t == 415) {
        g: int = d10_form("\�\�\�\�\�\�\�\�\�\�\�\�\�\�\�\�\�");
        if (g >= 0) open_form_concordance(g)
    }
    if (t == 416) {
        // 256a: Sounds Written As's choices, from the Alphabet (the Greek
        // page pushed again).
        d10_pop_to(0);
        open_language(0);
        demo_later_at(0.7f64, 742)
    }
    if (t == 417) {
        // 256: Koine chosen (its row's tap): back to the Alphabet, in it.
        uk_tap(SCR_PRON, ACT_LN_PRON, 1)
    }
    if (t == 418) {
        // 257: Verses You Can Read.
        d10_pop_to(uk_vc_of(SCR_LANGUAGE));
        open_readable()
    }
    if (t == 419) {
        // 258: the first.
        if (crv_n > 0) uk_tap(SCR_READABLE, ACT_LN_VERSE, crv_vi[0]);
        demo_later_at(0.6f64, 708)
    }
    if (t == 420) {
        // 259: the Library's Memory. (258 opened its verse in the Hebrew
        // and Greek, Round 11: the BSB again.)
        demo_dismiss();
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB);
        set_def_int("librarySegment", 3);
        demo_later_do(1)
    }
    if (t == 421) {
        // 260: ⓘ on Philippians 4:6–7.
        mm_open_passage(d8_find("PHP", 4, 6))
    }
    if (t == 422) {
        // 261: Hebrew → the Alphabet, at its vowels.
        d10_pop_to(0);
        open_language(1);
        demo_later_at(0.7f64, 743)
    }
    if (t == 423) {
        // 262: a Practice card of "and" (וְ).
        k: int = learn_add_letter(jp_lt[0], FROM_ALPHABET, today(), time(0));
        cards_changed();
        d10_practice_card(k)
    }
    if (t == 424) {
        // 263: 300 Hebrew words, the alphabet and the joined words known;
        // Psalm 23:1 in Hebrew Order.
        practice_close(true);
        demo_learn_known(1, 300);
        demo_dismiss();
        go_verse(psalm23(), 1);
        set_def_int("interlinearOrder", 1);
        demo_later_at(0.8f64, 710)
    }
    if (t == 425) {
        // 264: אָמַר's study, then Forms.
        open_lemma(false, 559);
        demo_later_at(0.6f64, 711)
    }
    if (t == 426) {
        // 265: Memory's reminder on (the shim's answer forced).
        demo_dismiss();
        set_def_int("librarySegment", 3);
        demo_later_at(0.8f64, 733)
    }
    if (t == 427) {
        // 266: Night; a word card after Check.
        demo_dismiss();
        set_theme = 4;
        settings_changed(true);
        demo_later_at(0.6f64, 713)
    }
    if (t == 428) {
        // 267: (the largest text) the card again.
        if (crd_active) {
            crd_fill();
            px_toolbar(false)
        }
    }
    if (t == 429) {
        // 268: (the largest text) Forms.
        practice_close(true);
        demo_dismiss();
        set_theme = 0;
        settings_changed(true);
        go_verse(john3(), 16);
        set_def_int("interlinearOrder", 1);
        demo_later_at(0.6f64, 714)
    }
    if (t == 430) {
        // 269: Erasmian again; the Alphabet → Practise Reading; Check.
        demo_dismiss();
        set_def_int("learnPronGreek", 0);
        demo_later_at(0.6f64, 716)
    }
    if (t == 431) {
        // Sequence 16's setup: John 3:16 in Greek Order, hiding on.
        practice_close(true);
        demo_dismiss();
        go_verse(john3(), 16);
        set_def_int("interlinearOrder", 1);
        demo_later_at(0.6f64, 720)
    }
    if (t == 432) demo_later_at(0.7f64, 721);
    if (t == 434) {
        // languages2's start: 120 Greek words and the alphabet known (as
        // the first half leaves them), at John 3.
        demo_dismiss();
        go_verse(john3(), 16);
        demo_learn_known(0, 120)
    }
    if (t == 433) {
        practice_close(true);
        demo_dismiss();
        note("bible: demo sequence 16 done")
    }
}

// The word of number num in the interlinear shown, tapped.
d10_tap(num: int) {
    vi: int = d10_vi();
    if (vi < 0) return;
    for w in v_first(vi)..v_end(vi) {
        if (w_strongs(w) == num) {
            _s: bool = tile_show(w);
            return
        }
    }
}

// I Know These, for a language (the demo's).
learn_know_all_lang(lang: int) {
    for i in 0..lt_n {
        if (lt_lang[i] == lang && lt_kind[i] == CK_LETTER && !cd_known(cl_of[i])) {
            k: int = if (cl_of[i] >= 0) cl_of[i] else learn_add_letter(i, FROM_KNOWN,
                today(), time(0));
            if (k >= 0) learn_mark_known(k, today(), time(0))
        }
    }
    cards_changed()
}

demo_later10(d: int) {
    if (d == 742) {
        open_alphabet();
        demo_later_at(0.7f64, 748);
        return
    }
    if (d == 748) {
        open_pronunciation();
        return
    }
    if (d == 747) {
        // (The Alphabet's end in sight.)
        t: int = uk_table_of(SCR_ALPHABET);
        n: int = if (t != 0) msg(t, sel("numberOfSections")) else 0;
        if (n > 0) {
            msg(t, sel("layoutIfNeeded"));
            one[0] = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0,
                n - 1);
            msg3(t, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), one[0],
                3, 0)
        }
        return
    }
    if (d == 743) {
        open_alphabet();
        demo_later_at(0.7f64, 709);
        return
    }
    if (d == 700) {
        if (d10_clear(700)) return;
        open_interlinear(john3(), 16);
        demo_detent(true);
        demo_later_at(0.8f64, 730);
        return
    }
    if (d == 730) {
        d10_scroll_end();
        d10_tiles();
        return
    }
    if (d == 701) {
        // (The Greek page under the Alphabet: back to it, then Add Words.)
        d10_pop_to(uk_vc_of(SCR_LANGUAGE));
        open_add_words();
        return
    }
    if (d == 702) {
        practice_open_cards(0, false);
        return
    }
    if (d == 703) {
        d10_practice_card(card_of_word(0, 3004));
        return
    }
    if (d == 704) {
        // (The page shown afresh.)
        learn_pages_refresh();
        return
    }
    if (d == 705) {
        // (The interlinear's tiles made again, what is known hidden.)
        demo_detent(true);
        uk_refresh();
        d10_scroll_top();
        d10_tiles();
        return
    }
    if (d == 706) {
        if (study_table != 0) msg(study_table, sel("layoutIfNeeded"));
        return
    }
    if (d == 708) {
        d10_tiles();
        return
    }
    if (d == 709) {
        // (The Vowels in sight.)
        t: int = uk_table_of(SCR_ALPHABET);
        s: int = uk_section_titled(SCR_ALPHABET, "Vowels");
        if (t != 0 && s >= 0) {
            msg(t, sel("layoutIfNeeded"));
            one[0] = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0,
                s);
            msg3(t, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), one[0],
                1, 0)
        }
        return
    }
    if (d == 710) {
        if (d10_clear(710)) return;
        open_interlinear(psalm23(), 1);
        demo_detent(true);
        demo_later_at(0.8f64, 731);
        return
    }
    if (d == 731) {
        d10_tiles();
        return
    }
    if (d == 711) {
        open_forms(false, 559);
        return
    }
    if (d == 733) {
        if (d10_clear(733)) return;
        open_library();
        demo_later_at(1.0f64, 712);
        return
    }
    if (d == 712) {
        auth_why = 3;
        auth_ticks = 0;
        auth_answered = 2;
        auth_timer = stop_timer(auth_timer);
        auth_timer = after(0.2f64, "authTick:");
        return
    }
    if (d == 713) {
        if (d10_clear(713)) return;
        // A Greek word's card (ἀγαπάω, due), after Check.
        k: int = card_of_word(0, 25);
        if (k < 0) k = learn_add_word(0, 25, FROM_FREQ, today(), time(0));
        if (k >= 0) {
            cd_state[k] = MS_REVIEW;
            if (cd_box[k] < 1) cd_box[k] = 1;
            cd_due[k] = today()
        }
        d10_practice_card(k);
        demo_later_at(0.8f64, 715);
        return
    }
    if (d == 715) {
        memory_check();
        return
    }
    if (d == 714) {
        if (d10_clear(714)) return;
        open_interlinear(john3(), 16);
        demo_detent(true);
        demo_later_at(0.8f64, 717);
        return
    }
    if (d == 717) {
        demo_study(true, 25);
        demo_later_at(0.6f64, 718);
        return
    }
    if (d == 718) {
        open_forms(true, 25);
        return
    }
    if (d == 716) {
        if (d10_clear(716)) return;
        open_library();
        demo_later_at(0.9f64, 719);
        return
    }
    if (d == 719) {
        open_language(0);
        demo_later_at(0.7f64, 744);
        return
    }
    if (d == 744) {
        open_alphabet();
        demo_later_at(0.7f64, 745);
        return
    }
    if (d == 745) {
        practice_open_reading(0);
        demo_later_at(1.0f64, 732);
        return
    }
    if (d == 732) {
        memory_check();
        return
    }
    if (d == 720) {
        if (d10_clear(720)) return;
        open_interlinear(john3(), 16);
        demo_detent(true);
        return
    }
    if (d >= 721 && d <= 729) {
        // Sequence 16: three tiles shown; English Order and back (hiding
        // again); the next verse and back; then a word card: Check, the
        // judgement in and out. (A step every 0.8 s.)
        if (d == 721) _a: bool = tile_show(d10_word(d10_vi(), true, 25));
        if (d == 722) _b: bool = tile_show(d10_word(d10_vi(), true, 2889));
        if (d == 723) _c: bool = tile_show(d10_word(d10_vi(), true, 1325));
        if (d == 724) uk_act_value(SCR_VERSE_STUDY, ACT_VS_ORDER, 0, 0);
        if (d == 725) uk_act_value(SCR_VERSE_STUDY, ACT_VS_ORDER, 0, 1);
        if (d == 726) uk_act_kind(SCR_VERSE_STUDY, ACT_VS_STEP, 1);
        if (d == 727) uk_act_kind(SCR_VERSE_STUDY, ACT_VS_STEP, -1);
        if (d == 728) {
            k: int = card_of_word(0, 2316);
            if (k >= 0) cd_due[k] = today();
            d10_practice_card(k)
        }
        if (d == 729) {
            memory_check();
            demo_later_at(1.2f64, 740);
            return
        }
        d10_tiles();
        demo_later_at(0.8f64, d + 1);
        return
    }
    if (d == 740) {
        memory_touch(G_KNEW);
        demo_later_at(0.8f64, 741);
        return
    }
    if (d == 741) {
        // (Then graded: the row goes out, and the end comes in.)
        practice_touch_up(0, 0, 0);
        demo_later_at(0.6f64, 746);
        return
    }
    if (d == 746) {
        memory_grade_now(G_KNEW);
        return
    }
}

add_demo10_methods(_app: int) { }
