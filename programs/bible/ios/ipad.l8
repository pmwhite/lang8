tag bible_ios;

use_tag std, ios, bible, bible_wire;

// The app at any width, and on an iPad (DESIGN.md §17). It follows the
// window's size class, not the device: a narrow window (Split View, Slide
// Over, a small Stage Manager window) is the iPhone's app, and a wide one
// (regular both ways) has form sheets, Reading settings in a popover, and
// Study beside the text where it fits (ios/beside.l8). The page's text is
// a column of at most 34 em (about 70 characters), centred (text.l8's
// column_width). The window's root is a container (L8Root) of the reader's
// navigation controller and, while it is beside, Study's, laid out by
// frames: so the page's width changes only when the container says, and
// the place is measured at the old width first, then the rows made again
// at the new one with the same verse at the top (§17.2.2). The floating
// controls (the tray, the back capsule, Mark Read, the mini player and
// toasts) follow the column. The keys and the menu bar (§17.4) and the
// pointer's hover (§17.5) are here too.
import "../../ios/objc.l8";

import "../core/text.l8";

// ---- the device and the window ----
// Whether this is an iPad, whatever its window.
is_ipad(): bool {
    msg(msg(cls("UIDevice"), sel("currentDevice")), sel("userInterfaceIdiom")) == 1
}

// Whether the window is wide: regular both ways (an iPad's full or a wide
// window; never an iPhone, not even a Max held sideways).
wide(): bool {
    if (window == 0) return false;
    t: int = msg(window, sel("traitCollection"));
    msg(t, sel("horizontalSizeClass")) == 2 && msg(t, sel("verticalSizeClass")) == 2
}

// The margins of a view w wide, its text the column's (no safe area: a
// sheet's, a preview's).
margin_for(w: f64): f64 {
    m: f64 = look_margin;
    cw: f64 = column_width(w, m);
    if (cw < w - 2.0f64 * m) m = (w - cw) / 2.0f64;
    m
}

// A view w wide shows its text w less its margins m wide, but never more
// than the look's column (DESIGN.md §17.2.1).
column_width(w: f64, m: f64): f64 {
    cw: f64 = w - 2.0f64 * m;
    cap: f64 = look_column * em;
    if (cw > cap) cap else cw
}

// ---- the root: the page, and Study beside it ----
root_class: int = 0;

root_vc: int = 0;

// The reader's navigation controller made the root's child, the root the
// window's.
root_attach() {
    root_vc = keep(msg(make("L8Root"), sel("autorelease")));
    view: int = msg(root_vc, sel("view"));
    msg1(view, sel("setBackgroundColor:"), c_bg);
    msg1(root_vc, sel("addChildViewController:"), nav);
    nv: int = msg(nav, sel("view"));
    // (Its frame the root's to set, never the autoresizing's: so it is
    // still at its old width when the root lays out, to measure the place.)
    msg1(nv, sel("setAutoresizingMask:"), 0);
    l8_msg_hfa(hfa, view, sel("bounds"), 0, 0, 0);
    msg_rect(nv, sel("setFrame:"), 0.0f64, 0.0f64, hfa[2], hfa[3]);
    msg1(view, sel("addSubview:"), nv);
    msg1(nav, sel("didMoveToParentViewController:"), root_vc);
    msg1(window, sel("setRootViewController:"), root_vc);
    keys_scroll(table)
}

root_laid_out(self: int, cmd: int): int {
    super0(self, root_class, cmd);
    root_place();
    0
}

// The page (and Study's panel while it is beside), by frames.
root_place() {
    if (root_vc == 0 || nav == 0) return;
    view: int = msg(root_vc, sel("view"));
    l8_msg_hfa(hfa, view, sel("bounds"), 0, 0, 0);
    W: f64 = hfa[2];
    H: f64 = hfa[3];
    if (W <= 0.0f64) return;
    // (The panel at the page's right where it fits, else under it.)
    beside_ensure();
    beside: bool = beside_wanted(W);
    right: bool = beside && beside_fits_in(W);
    pw: f64 = if (right) W - PANEL_W - 1.0f64 else W;
    ph: f64 = if (beside && !right) H - beside_height(H) else H;
    nv: int = msg(nav, sel("view"));
    l8_msg_hfa(hfa, nv, sel("frame"), 0, 0, 0);
    was: f64 = hfa[2];
    was_h: f64 = hfa[3];
    if (was != pw) width_will_change(was);
    if (was != pw || was_h != ph) msg_rect(nv, sel("setFrame:"), 0.0f64, 0.0f64, pw,
        ph);
    beside_place(beside, pw, ph, W, H);
    if (was != pw) width_changed(was, pw);
    float_layout()
}

// The keyboard's focus on the page while no sheet is up (on an iPad): its
// table scrolls by the keys itself (allowsKeyboardScrolling, iOS 17: ↑ and
// ↓ a line, Space a page; review s17-1, Minor 3).
root_focus(self: int, cmd: int): int {
    if (is_ipad() && table != 0 && presented() == 0) {
        one[0] = table;
        return nsarray(one, 1)
    }
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(root_class) };
    msg_super0(&sup, cmd)
}

// A table the page shows (the reader's, a day's) made one the keys scroll,
// with no focus ring of its own.
keys_scroll(t: int) {
    if (t == 0 || !is_ipad()) return;
    if (responds(t, "setAllowsKeyboardScrolling:")) msg1(t, sel("setAllowsKeyboardScrolling:"),
        1);
    if (responds(t, "setFocusEffect:")) msg1(t, sel("setFocusEffect:"), 0)
}

// The focus back on the page (a sheet gone, a day opened or closed).
page_focus() {
    if (root_vc == 0 || !is_ipad()) return;
    msg(root_vc, sel("setNeedsFocusUpdate"));
    msg(root_vc, sel("updateFocusIfNeeded"))
}

// The status bar as the reader's navigation controller has it.
root_status_child(_self: int, _cmd: int): int {
    nav
}

// Every orientation on an iPad; all but upside down on an iPhone (§17.1).
root_orientations(_self: int, _cmd: int): int {
    if (is_ipad()) 30 else 26
}

// ---- keeping the place as the width changes (§17.2.2) ----
// The place measured at the old width (its chapter, verse and thousandths
// of em into it), kept until the reader moves the text: each relayout of a
// resize goes back to it, never to one measured on rows laid out for a
// width they no longer have.
wk_on: bool = false;

wk_c: int = 0;

wk_v: int = 0;

wk_f: int = 0;

// The width it was measured at, and when the rows were last made again.
wk_from: f64 = 0.0f64;

wk_at: f64 = 0.0f64;

// A relayout waiting: for the reader to rest, or the resize's next 0.1 s.
wk_due: bool = false;

wk_timer: int = 0;

// While the rows are made again (go and set_offset keep the place then).
wk_restoring: bool = false;

// The window being resized by hand (iOS 26: the scene's geometry says so).
resize_live: bool = false;

width_will_change(was: f64) {
    if (wk_on || !restored || table == 0 || was <= 0.0f64) return;
    measure_place();
    wk_c = cur;
    wk_v = place_v;
    wk_f = place_frac;
    wk_from = was;
    wk_on = true
}

// The text moved by the reader, or by a jump: the place kept is not where
// the reader is any more.
width_place_moved() {
    if (!wk_restoring) wk_on = false
}

width_changed(was: f64, _now: f64) {
    if (!restored || table == 0 || was <= 0.0f64) return;
    if (resize_live && CACurrentMediaTime() - wk_at < 0.1f64) {
        wk_due = true;
        if (wk_timer == 0) wk_timer = after_common(0.1f64, "widthTick:");
        return
    }
    width_relayout()
}

width_tick(_self: int, _cmd: int, _timer: int): int {
    wk_timer = 0;
    if (wk_due) width_relayout();
    0
}

// The rows made again at the page's width now, the place kept put back.
width_relayout() {
    wk_due = false;
    if (table == 0 || !restored) return;
    if (reader_moving()) {
        // (At rest: reader_rested.)
        wk_due = true;
        return
    }
    if (!wk_on) {
        measure_place();
        wk_c = cur;
        wk_v = place_v;
        wk_f = place_frac;
        wk_from = view_width(table);
        wk_on = true
    }
    wk_at = CACurrentMediaTime();
    wk_restoring = true;
    set_insets();
    msg(table, sel("reloadData"));
    msg(table, sel("layoutIfNeeded"));
    go_place(wk_c, wk_v, wk_f);
    layout_bar();
    wk_restoring = false;
    if (diag_on) {
        tb_n = 0;
        tb_str("bible: width ");
        tb_int(wk_from as int);
        tb_str(" \�\�\� ");
        tb_int(view_width(table) as int);
        tb_str(", kept ");
        tb_int(wk_c);
        tb_byte(58);
        tb_int(wk_v);
        tb_str(" +");
        f: int = if (wk_f < 0) 0 else wk_f;
        tb_int(f / 1000);
        tb_byte(46);
        tb_byte(48 + f / 100 % 10);
        tb_byte(48 + f / 10 % 10);
        tb_str(", column ");
        tb_int(((view_width(table) - 2.0f64 * side_margin()) * 10.0f64 / em) as int);
        tb_str(" tenths of an em");
        note_ns(tb_ns())
    }
    wk_from = view_width(table)
}

// iOS 26: the window's geometry changed (a resize, by hand or done).
scene_geometry(
    _self: int,
    _cmd: int,
    scene: int,
    _previous: int
): int {
    g: int = if (responds(scene, "effectiveGeometry")) msg(scene, sel("effectiveGeometry")) else 0;
    live: bool = g != 0 && responds(g, "isInteractivelyResizing") && (msg(g, sel("isInteractivelyResizing")) & 255) != 0;
    if (live != resize_live) {
        resize_live = live;
        note_num("bible: resizing by hand ", if (live) 1 else 0)
    }
    // (The resize over: the rows made once more, for the width it ended at.)
    if (!live && wk_due) width_relayout();
    0
}

// Before iOS 26: the same, as the coordinate space changed.
scene_space(
    _self: int,
    _cmd: int,
    _scene: int,
    _space: int,
    _orientation: int,
    _traits: int
): int {
    if (wk_due) width_relayout();
    0
}

// The scene's least size (§17.1): 320 by 480, where it can be set.
scene_least(scene: int) {
    if (!responds(scene, "sizeRestrictions")) return;
    r: int = msg(scene, sel("sizeRestrictions"));
    if (r != 0) msg_ff(r, sel("setMinimumSize:"), 320.0f64, 480.0f64)
}

// ---- the floating controls, over the column (§17.2.3) ----
// The page's column in the window (fl_l to fl_r, its middle fl_cx), the
// page's width, and whether the column is narrower than the page less its
// margins (fl_capped: an iPad's page, an iPhone held sideways). Where it
// is not, and the window is not wide, they are as on the iPhone.
fl_l: f64 = 0.0f64;

fl_r: f64 = 0.0f64;

fl_cx: f64 = 0.0f64;

fl_pw: f64 = 0.0f64;

fl_capped: bool = false;

float_measure() {
    if (nav == 0 || table == 0) return;
    fl_pw = view_width(msg(nav, sel("view")));
    l8_msg_hfa(hfa, table, sel("safeAreaInsets"), 0, 0, 0);
    sl: f64 = hfa[1];
    sr: f64 = hfa[3];
    m: f64 = side_margin();
    fl_l = sl + m;
    fl_r = fl_pw - sr - m;
    fl_cx = (fl_l + fl_r) / 2.0f64;
    fl_capped = m > look_margin + 0.5f64
}

// Whether the controls go by the column (else the iPhone's places).
float_by_column(): bool {
    fl_capped || wide()
}

// The tray's width now, and its edges' constraints.
tray_w_now: f64 = 0.0f64;

tray_lead: int = 0;

tray_trail: int = 0;

// Everything floating placed for the page now.
float_layout() {
    if (window == 0 || table == 0) return;
    float_measure();
    W: f64 = view_width(window);
    // The tray: 12 points from the window's edges (inside its safe area,
    // held sideways); or at most 560 wide, centred over the column.
    l8_msg_hfa(hfa, window, sel("safeAreaInsets"), 0, 0, 0);
    a: f64 = 12.0f64 + hfa[1];
    b: f64 = -12.0f64 - hfa[3];
    tray_w_now = W - 24.0f64 - hfa[1] - hfa[3];
    if (float_by_column()) {
        tw: f64 = fl_pw - 24.0f64;
        if (tw > 560.0f64) tw = 560.0f64;
        a = fl_cx - tw / 2.0f64;
        b = fl_cx + tw / 2.0f64 - W;
        tray_w_now = tw
    }
    if (tray_lead != 0 && msg_f(tray_lead, sel("constant")) != a) {
        msg_set_f(tray_lead, sel("setConstant:"), a);
        msg_set_f(tray_trail, sel("setConstant:"), b);
        if (tray_shown) update_tray()
    }
    // (The rest only when the column or the window has moved.)
    if (fl_l == fl_last_l && fl_r == fl_last_r && W == fl_last_w) return;
    fl_last_l = fl_l;
    fl_last_r = fl_r;
    fl_last_w = W;
    if (back_shown) style_back();
    if (listen_shown) layout_player()
}

fl_last_l: f64 = -1.0f64;

fl_last_r: f64 = -1.0f64;

fl_last_w: f64 = -1.0f64;

// The back capsule's left edge: the column's, or 16 from the window's
// (its safe area's).
back_x(): f64 {
    float_measure();
    l8_msg_hfa(hfa, window, sel("safeAreaInsets"), 0, 0, 0);
    if (float_by_column()) fl_l else 16.0f64 + hfa[1]
}

// The middle the mini player and toasts are centred on, and the room.
float_cx(W: f64): f64 {
    float_measure();
    if (float_by_column()) fl_cx else W / 2.0f64
}

float_room(W: f64): f64 {
    float_measure();
    if (float_by_column()) fl_pw else W
}

// ---- sheets and popovers in a wide window (§17.3.1) ----
// The next sheet's form (sheet_of's), in a wide window: a form sheet w by
// h, or (from a view) a popover; else, and in a narrow window, the
// iPhone's page sheet.
sf_w: f64 = 0.0f64;

sf_h: f64 = 0.0f64;

sf_from: int = 0;

sheet_form(w: f64, h: f64) {
    sf_w = w;
    sf_h = h;
    sf_from = 0
}

sheet_popover(from: int, w: f64, h: f64) {
    sf_w = w;
    sf_h = h;
    sf_from = from
}

// The form asked for, given to the sheet before its presentation's
// controller is made: whether it took one (no grabber or detents then,
// which are a page sheet's).
sheet_form_take(sheet_nav: int): bool {
    w: f64 = sf_w;
    h: f64 = sf_h;
    from: int = sf_from;
    sf_w = 0.0f64;
    sf_h = 0.0f64;
    sf_from = 0;
    if (w <= 0.0f64 || !wide()) return false;
    msg1(sheet_nav, sel("setModalPresentationStyle:"), if (from != 0) 7 else 2);
    msg_ff(sheet_nav, sel("setPreferredContentSize:"), w, h);
    if (from != 0) {
        pop: int = msg(sheet_nav, sel("popoverPresentationController"));
        msg1(pop, sel("setSourceView:"), from);
        l8_msg_hfa(hfa, from, sel("bounds"), 0, 0, 0);
        msg_rect(pop, sel("setSourceRect:"), hfa[0], hfa[1], hfa[2], hfa[3]);
        msg1(pop, sel("setPermittedArrowDirections:"), 1);
        popover_theme(sheet_nav)
    }
    if (diag_on) {
        tb_n = 0;
        tb_str(if (from != 0) "bible: sheet as a popover " else "bible: sheet as a form sheet ");
        tb_int(w as int);
        tb_str(" x ");
        tb_int(h as int);
        note_ns(tb_ns())
    }
    true
}

// On an iPad, a sheet's search field under its title, with its scope bar
// (Search's All, OT, NT and the book), as on the iPhone, not beside it.
search_stacked(item: int) {
    if (is_ipad() && responds(item, "setPreferredSearchBarPlacement:")) msg1(item,
        sel("setPreferredSearchBarPlacement:"), 2)
}

// A popover in the theme's appearance (Reading settings in Night is a dark
// popover, its rows legible: review s17-1, Major), set before it is shown
// and again as the theme changes while it is open. Its glass is the
// presentation's, so its trait overrides too (iOS 17); before iOS 26, its
// background the sheets' color.
popover_theme(nav: int) {
    if (nav == 0 || msg(nav, sel("modalPresentationStyle")) != 7) return;
    style: int = if (set_theme == 0) 0 else if (is_dark()) 2 else 1;
    msg1(nav, sel("setOverrideUserInterfaceStyle:"), style);
    pop: int = msg(nav, sel("popoverPresentationController"));
    if (pop == 0) return;
    if (responds(pop, "traitOverrides")) {
        over: int = msg(pop, sel("traitOverrides"));
        if (style == 0) msg1(over, sel("removeTrait:"), cls("UITraitUserInterfaceStyle")) else msg1(over,
            sel("setUserInterfaceStyle:"), style)
    }
    if (cls("UIGlassEffect") == 0) msg1(pop, sel("setBackgroundColor:"), sheet_bg());
    note_num("bible: popover style ", style)
}

// The width a sheet's content is laid out for before it is shown: its form
// sheet's (w) in a wide window, else the window's.
sheet_content_w(w: f64): f64 {
    if (wide()) w else view_width(window)
}

// A form sheet whose window has grown narrow: a page sheet, as UIKit
// adapts it (every other presentation stays as it is: a popover stays one
// on a phone).
adapted_style(controller: int, traits: int): int {
    vc: int = msg(controller, sel("presentedViewController"));
    if (vc != 0 && msg(vc, sel("modalPresentationStyle")) == 2 && msg(traits, sel("horizontalSizeClass")) == 1) return 1;
    -1
}

// A share sheet's popover, on an iPad (UIKit needs one there): from view
// from, or the tray's place over the column.
share_source(vc: int, from: int) {
    pop: int = msg(vc, sel("popoverPresentationController"));
    if (pop == 0) return;
    if (from != 0) {
        msg1(pop, sel("setSourceView:"), from);
        return
    }
    float_measure();
    msg1(pop, sel("setSourceView:"), window);
    l8_msg_hfa(hfa, window, sel("safeAreaInsets"), 0, 0, 0);
    msg_rect(pop, sel("setSourceRect:"), fl_cx - 1.0f64, view_height(window) - hfa[2] - 60.0f64,
        2.0f64, 2.0f64)
}

// Go To's field to take the keys as it appears (⌘L, or a hardware
// keyboard's): §17.3.3.
goto_focus: bool = false;

books_did_appear(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, books_class, cmd, animated);
    search: int = uk_search_of_kind(SCR_GOTO);
    if (!goto_focus || search == 0) return 0;
    goto_focus = false;
    msg1(search, sel("setActive:"), 1);
    msg(msg(search, sel("searchBar")), sel("becomeFirstResponder"));
    note("bible: go to field active");
    0
}

// ---- keys and the menu bar (§17.4) ----
K_CMD: int = 1048576;

K_SHIFT: int = 131072;

K_ALT: int = 524288;

app_class: int = 0;

// The keyboard's commands as core says them (its command lines): each
// one's UIKeyCommand (kept; 0: not said), its menu (0 Go, 1 View, 2 none),
// its key's name and modifiers (as `key NAME MODS` sends them); and those
// that act now (its commands line: bit K). Each is the app's object's, at
// the responder chain's end, whatever is focused, and sent to core as its
// key.
CMD_MOST: int = 32;

cmd_keys: []int = new int[32](0);

cmd_menus: []int = new int[32](2);

cmd_names: []int = new int[32](0);

cmd_mods: []int = new int[32](0);

cmd_acting: int = 0;

// The menu bar's Go and View menus (and the ⌘ overlay), and the keys in no
// menu (an iPad's: §17.4.1), made from them.
key_go: []int = new int[32](0);

key_view: []int = new int[32](0);

app_keys: int = 0;

app_key_list: []int = new int[32](0);

// command K MENU NAME MODS TITLE: kept, made a UIKeyCommand; the menus
// made again with it.
command_line(line: WireLine) {
    k: int = word_n(line, 1);
    if (k < 0 || k >= CMD_MOST) return;
    cmd_menus[k] = word_n(line, 2);
    cmd_names[k] = held(cmd_names[k], word_ns(line, 3));
    cmd_mods[k] = word_n(line, 4);
    m: int = cmd_mods[k];
    flags: int = (if ((m & 1) != 0) K_CMD else 0) | (if ((m & 2) != 0) K_SHIFT else 0) | (if ((m & 4) != 0) K_ALT else 0);
    command: int = msg3(cls("UIKeyCommand"), sel("keyCommandWithInput:modifierFlags:action:"),
        key_input(cmd_names[k]), flags, sel("keyCore:"));
    title: int = field_ns(line, 1);
    if (title != 0 && msg(title, sel("length")) > 0) {
        msg1(command, sel("setTitle:"), title);
        msg1(command, sel("setDiscoverabilityTitle:"), title)
    }
    // (A text field's own handling of ⌘[ and ⌘] doesn't take them when none
    // is focused.)
    if (responds(command, "setWantsPriorityOverSystemBehavior:")) msg1(command, sel("setWantsPriorityOverSystemBehavior:"),
        1);
    cmd_keys[k] = held(cmd_keys[k], command);
    keys_changed()
}

// A key's name (core's) as UIKit's input: an arrow, Space, Return, or the
// character.
key_input(name: int): int {
    if (key_named(name, "left")) objc_const("UIKeyInputLeftArrow") else if (key_named(name,
        "up")) objc_const("UIKeyInputUpArrow") else if (key_named(name, "down")) objc_const("UIKeyInputDownArrow") else if (key_named(name,
        "space")) nsstring(" ") else if (key_named(name, "return")) nsstring("\r") else name
}

key_named(name: int, word: str): bool {
    (msg1(name, sel("isEqualToString:"), nsstring(word)) & 255) != 0
}

// The commands changed: the menus and the keys in none made again.
keys_changed() {
    release(app_keys);
    app_keys = 0;
    msg(msg(cls("UIMenuSystem"), sel("mainSystem")), sel("setNeedsRebuild"))
}

// commands MASK: kept.
commands_line(line: WireLine) {
    cmd_acting = word_n(line, 1)
}

// Menu m's commands (in core's order), into ks: how many.
menu_commands(m: int, ks: []int): int {
    n: int = 0;
    for k in 0..CMD_MOST {
        if (cmd_keys[k] != 0 && cmd_menus[k] == m) {
            ks[n] = cmd_keys[k];
            n = n + 1
        }
    }
    n
}

// The menu bar (iPadOS 26) and the ⌘ overlay: a Go menu after View, and
// View's own commands at its end.
build_menu(self: int, cmd: int, builder: int): int {
    _r: int = super1(self, app_class, cmd, builder);
    // (The iPad's menu bar: an iPhone's menus as they were.)
    if (!is_ipad() || msg(builder, sel("system")) != msg(cls("UIMenuSystem"), sel("mainSystem"))) return 0;
    view_id: int = objc_const("UIMenuView");
    if (view_id == 0 || msg1(builder, sel("menuForIdentifier:"), view_id) == 0) return 0;
    go_n: int = menu_commands(0, key_go);
    view_n: int = menu_commands(1, key_view);
    if (go_n == 0) return 0;
    go: int = msg5(cls("UIMenu"), sel("menuWithTitle:image:identifier:options:children:"),
        nsstring(w_go_menu), 0, nsstring("space.trailingwhite.smoothbible.go"), 0,
        nsarray(key_go, go_n));
    msg2(builder, sel("insertSiblingMenu:afterMenuForIdentifier:"), go, view_id);
    reading: int = msg5(cls("UIMenu"), sel("menuWithTitle:image:identifier:options:children:"),
        nsstring(""), 0, nsstring("space.trailingwhite.smoothbible.reading"), 1, nsarray(key_view,
        view_n));
    msg2(builder, sel("insertChildMenu:atEndOfMenuForIdentifier:"), reading, view_id);
    if (diag_on) {
        tb_n = 0;
        tb_str("bible: menu Go: ");
        menu_log(key_go, go_n);
        tb_str("; View: ");
        menu_log(key_view, view_n);
        note_ns(tb_ns())
    }
    0
}

menu_log(ks: []int, n: int) {
    for i in 0..n {
        if (i > 0) tb_str(", ");
        tb_nsstring(msg(ks[i], sel("title")))
    }
}

menu_title_buf: []i8 = new i8[256](0i8);

// Whether command k may act now: as core says (its commands line), with
// no sheet of the app's own over core's (a share sheet takes the keys).
key_allowed(k: int): bool {
    (cmd_acting >> k & 1) != 0 && (presented() == 0 || top_screen_kind() >= 0)
}

// The kind of core's screen on top (-1: none, or not core's).
top_screen_kind(): int {
    p: int = top_presented();
    if (p == 0) return -1;
    vc: int = if ((msg1(p, sel("isKindOfClass:"), cls("UINavigationController")) & 255) != 0) msg(p,
        sel("topViewController")) else p;
    for k in 0..UK_SLOTS
        if (uk_vcs[k] != 0 && uk_vcs[k] == vc) return uk_kind_of(uk_ids[k]);
    -1
}

// The command of a key command (-1: not one of ours).
key_command_of(command: int, action: int): int {
    if (action != sel("keyCore:") || command == 0 || (msg1(command, sel("isKindOfClass:"),
        cls("UIKeyCommand")) & 255) == 0) return -1;
    for k in 0..CMD_MOST
        if (cmd_keys[k] != 0 && (msg1(msg(command, sel("input")), sel("isEqualToString:"),
            msg(cmd_keys[k], sel("input"))) & 255) != 0 && msg(command, sel("modifierFlags")) == msg(cmd_keys[k],
            sel("modifierFlags"))) return k;
    -1
}

can_perform(
    self: int,
    cmd: int,
    action: int,
    sender: int
): int {
    k: int = key_command_of(sender, action);
    if (k >= 0) return if (key_allowed(k)) 1 else 0;
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(app_class) };
    msg_super2(&sup, cmd, action, sender)
}

// A command's title as core says it now (Show Study, Hide Study).
validate_command(self: int, cmd: int, command: int): int {
    _r: int = super1(self, app_class, cmd, command);
    k: int = key_command_of(command, msg(command, sel("action")));
    if (k >= 0) msg1(command, sel("setTitle:"), msg(cmd_keys[k], sel("title")));
    0
}

// Core's command of a key pressed, said as the key (key NAME MODS), the
// reader's place told first (Study opens at the verse at its top); Go
// To's field to take the keys if it opens.
key_core(_self: int, _cmd: int, command: int): int {
    k: int = key_command_of(command, sel("keyCore:"));
    if (k < 0) return 0;
    note_num("bible: key ", k);
    goto_focus = k == KC_GOTO;
    place_tell();
    n: int = nsstring_into(cmd_names[k], menu_title_buf);
    uk_wire_begin("key");
    uk_wire_byte(32i8);
    for i in 0..n uk_wire_byte(menu_title_buf[i]);
    uk_wire_argument(cmd_mods[k]);
    uk_wire_send();
    uk_effects();
    if (presented() == 0) goto_focus = false;
    0
}

// The keys in no menu (§17.4.1): Space and ⇧Space a page; in a day's
// reader ⌘D, Mark Read; Practice's and its cards' Return (the main button:
// Check, Next) and ⌘1, ⌘2 and ⌘3 (Not Yet, Mostly, Knew It); Study beside
// the text's ⌘↑ and ⌘↓ (its verse). Each offered only where it acts
// (key_allowed); nothing of ours becomes first responder for them. On an
// iPad only: an iPhone is as it was.
app_key_commands(_self: int, _cmd: int): int {
    if (!is_ipad()) return 0;
    if (app_keys == 0) {
        n: int = menu_commands(2, app_key_list);
        app_keys = keep(msg2(cls("NSArray"), sel("arrayWithObjects:count:"), ints_address(app_key_list),
            n))
    }
    app_keys
}

// ---- the pointer (§17.5) ----
// The system's hover on one of our own controls (iOS 17; none before).
hover(v: int) {
    if (v == 0 || cls("UIHoverStyle") == 0 || !responds(v, "setHoverStyle:")) return;
    msg1(v, sel("setHoverStyle:"), msg(cls("UIHoverStyle"), sel("automaticStyle")))
}

make_ipad_classes() {
    root_class = class_make(cls("UIViewController"), "L8Root");
    add_method0(root_class, sel("viewDidLayoutSubviews"), &root_laid_out, "v@:");
    add_method0(root_class, sel("childViewControllerForStatusBarStyle"), &root_status_child,
        "@@:");
    add_method0(root_class, sel("childViewControllerForStatusBarHidden"), &root_status_child,
        "@@:");
    add_method0(root_class, sel("supportedInterfaceOrientations"), &root_orientations,
        "Q@:");
    add_method0(root_class, sel("preferredFocusEnvironments"), &root_focus, "@@:");
    // (Go To's field, when it is to take the keys.)
    add_method1(books_class, sel("viewDidAppear:"), &books_did_appear, "v@:B")
}

add_ipad_methods(app: int) {
    app_class = app;
    add_method1(app, sel("widthTick:"), &width_tick, "v@:@");
    add_method1(app, sel("buildMenuWithBuilder:"), &build_menu, "v@:@");
    add_method2(app, sel("canPerformAction:withSender:"), &can_perform, "B@::@");
    add_method1(app, sel("validateCommand:"), &validate_command, "v@:@");
    add_method0(app, sel("keyCommands"), &app_key_commands, "@@:");
    add_method1(app, sel("keyCore:"), &key_core, "v@:@")
}

add_ipad_scene_methods(scene: int) {
    add_method2(scene, sel("windowScene:didUpdateEffectiveGeometry:"), &scene_geometry,
        "v@:@@");
    add_method4(scene, sel("windowScene:didUpdateCoordinateSpace:interfaceOrientation:traitCollection:"),
        &scene_space, "v@:@@q@")
}
