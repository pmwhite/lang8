tag bible_ios;

use_tag std, ios, bible, bible_wire;

// The app driven from the development machine (RELOAD.md), in a build for
// hot reload only: where the hot reload host's server is set (the Settings
// app's hot_server, or dev-server.txt in the bundle), the app asks it for
// lines for core (`node web/devctl.mjs wire tap shelf`), long-polling
// GET /wire?since=N, and gives each to core as the skin gives its own. A
// line beginning ! is the app's: `!screens` writes the screens shown to
// the log, `!close` closes the sheets shown (as their Done does), `!back`
// goes back a screen (the top sheet's, else the panel's), `!info WORDS`
// taps a row's ⓘ as `!tap` taps the row, `!tap WORDS` taps the row, the
// button (or a button's menu item: Swap Panes, Close Panel) or the bar's
// left button of a screen shown whose title (or spoken label) begins with
// WORDS, or the panel's own Close Panel or Full Screen; `!scroll DY`
// scrolls the top sheet's list (else the panel's); `!uilog on|off` and
// `!follow on|off|pairs` are the logs' (uilog.l8, followlog.l8);
// `!detent small|medium|large` takes the panel's sheet to that height
// (iOS 26, ios/inspector.l8), `!panelswipe` dismisses its sheet as a
// swipe does, `!paneledge system|bar` sets how words pass under its
// reader's bar (to compare the two), and `!where` says the panel's state
// too; `!corelines on|off` writes core's lines about the panes to the log;
// `!boldtext on|off` sets Bold Text as the system's setting does;
// `!rotate landscape|portrait` turns the interface; `!detent snap
// small|medium|large` sets the sheet's height with no animation (the
// uilog checker's broken case); `!rowmenu` and `!rowswipe` bring up a
// row's menu and swipe as UIKit would (below); `!slowmo N` runs the
// window's animations N times slower; `!style light|dark|system` sets the
// interface style under the window, for Auto's checks. While it is
// connected, the screen stays on (a
// phone's Auto-Lock, not ten minutes of Keep Screen On) and its
// diagnostics are written. Data files changed on the server since it
// started (web/dev.mjs --data) are read from it instead of the bundle, so a
// course or the Manual reloads without a new build. A build from the App
// Store has no server set and asks nothing.
import "../../ios/objc.l8";

import "../../ios/block.l8";

import "uilog.l8";

import "followlog.l8";

// The server's address (http://HOST:PORT), the cursor of its lines, the
// request under way, its body, and its session (with a long timeout).
dw_url: int = 0;

dw_since: int = 0;

dw_task: int = 0;

dw_body: int = 0;

// (Kept through a hot reload: one session, not one a build.)
persistent dw_session: int = 0;

// Whether the server has answered: the app is being driven.
dw_on: bool = false;

// The server the hot reload host is set to (0: none).
dw_server(): int {
    defaults: int = msg(cls("NSUserDefaults"), sel("standardUserDefaults"));
    ns: int = msg1(defaults, sel("stringForKey:"), nsstring("hot_server"));
    if (ns == 0 || msg(ns, sel("length")) == 0) {
        path: int = msg2(msg(cls("NSBundle"), sel("mainBundle")), sel("pathForResource:ofType:"),
            nsstring("dev-server"), nsstring("txt"));
        if (path != 0) ns = msg3(cls("NSString"), sel("stringWithContentsOfFile:encoding:error:"),
            path, 4, 0)
    }
    if (ns == 0) return 0;
    ns = msg1(ns, sel("stringByTrimmingCharactersInSet:"), msg(cls("NSCharacterSet"),
        sel("whitespaceAndNewlineCharacterSet")));
    if (msg(ns, sel("length")) == 0) return 0;
    keep(msg1(nsstring("http://"), sel("stringByAppendingString:"), ns))
}

extern os_proc_available_memory(): int;

// Begun at launch (and again after a reload), if a server is set; how much
// memory the app may still take written to the log (a reload that leaks
// shows here).
devwire_begin() {
    if (dw_url == 0) dw_url = dw_server();
    if (dw_url == 0) {
        dw_data_state = DW_DATA_READY;
        return
    }
    tb_n = 0;
    tb_str("bible: memory available MB ");
    tb_int(os_proc_available_memory() / 1048576);
    note_ns(tb_ns());
    if (dw_session == 0) {
        config: int = msg(cls("NSURLSessionConfiguration"), sel("ephemeralSessionConfiguration"));
        msg_set_f(config, sel("setTimeoutIntervalForRequest:"), 40.0f64);
        delegate: int = msg(msg(msg(http_class, sel("alloc")), sel("init")), sel("autorelease"));
        dw_session = keep(msg3(cls("NSURLSession"), sel("sessionWithConfiguration:delegate:delegateQueue:"),
            config, delegate, msg(cls("NSOperationQueue"), sel("mainQueue"))))
    }
    devwire_data_list();
    devwire_ask()
}

// ---- data files from the server ----
// The files there that differ from the bundle's (POST /data with what the
// bundle holds, its dev-data.txt, from tools/ios/hot.sh; a bundle without
// one asks GET /data, those changed since the server started: NAME TAB
// SIZE a line, NAME as core asks for it), each fetched (GET /data/NAME)
// into a file of the app's temporary directory before any data file is
// read; until then core's asks wait (devwire_data_ready). The server out
// of reach, or a file that fails: the bundle's.
DW_DATA_MOST: int = 32;

DW_DATA_NAME_MOST: int = 64;

dw_data_names: []i8 = new i8[32 * 64](0i8);

dw_data_name_n: []int = new int[32](0);

dw_data_paths: []int = new int[32](0);

dw_data_n: int = 0;

// Asking for the list; fetching file dw_data_at; ready.
DW_DATA_LISTING: int = 0;

DW_DATA_FETCHING: int = 1;

DW_DATA_READY: int = 2;

dw_data_state: int = 0;

dw_data_at: int = 0;

dw_data_task: int = 0;

dw_data_body: int = 0;

// Whether core's data asks may be answered.
devwire_data_ready(): bool {
    dw_data_state == DW_DATA_READY
}

// A request for path on the server (posting body, an NSData, unless it is
// 0), not waited for long: the app starts at once when the server can't
// be reached.
devwire_data_get(path: int, body: int) {
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), msg1(dw_url, sel("stringByAppendingString:"),
        path));
    request: int = if (url == 0) 0 else msg1(cls("NSMutableURLRequest"), sel("requestWithURL:"),
        url);
    if (request != 0) _t: int = msg_set_f(request, sel("setTimeoutInterval:"), 3.0f64);
    if (request != 0 && body != 0) {
        msg1(request, sel("setHTTPMethod:"), nsstring("POST"));
        msg1(request, sel("setHTTPBody:"), body)
    }
    task: int = if (request == 0) 0 else msg1(dw_session, sel("dataTaskWithRequest:"),
        request);
    if (task == 0) {
        devwire_data_done();
        return
    }
    dw_data_task = keep(task);
    dw_data_body = keep(make("NSMutableData"));
    msg(task, sel("resume"))
}

devwire_data_list() {
    dw_data_state = DW_DATA_LISTING;
    dw_data_n = 0;
    path: int = msg2(msg(cls("NSBundle"), sel("mainBundle")), sel("pathForResource:ofType:"),
        nsstring("dev-data"), nsstring("txt"));
    held: int = if (path == 0) 0 else msg1(cls("NSData"), sel("dataWithContentsOfFile:"),
        path);
    devwire_data_get(nsstring("/data"), held)
}

// The list come: its names kept, the first fetched.
devwire_data_listed(body: int) {
    n: int = msg(body, sel("length"));
    region {
        b: []i8 = new i8[n + 1](0i8);
        if (n > 0) memcpy_from(b, msg(body, sel("bytes")), n);
        at: int = 0;
        while (at < n) {
            e: int = at;
            while (e < n && b[e] as int != 10) e = e + 1;
            tab: int = at;
            while (tab < e && b[tab] as int != 9) tab = tab + 1;
            if (tab > at && tab - at <= DW_DATA_NAME_MOST && dw_data_n < DW_DATA_MOST) {
                for i in at..tab dw_data_names[dw_data_n * DW_DATA_NAME_MOST + i - at] = b[i];
                dw_data_name_n[dw_data_n] = tab - at;
                dw_data_paths[dw_data_n] = 0;
                dw_data_n = dw_data_n + 1
            }
            at = e + 1
        }
    }
    dw_data_state = DW_DATA_FETCHING;
    dw_data_at = 0;
    devwire_data_next()
}

// The next file asked for, or (none left) the asks let go.
devwire_data_next() {
    if (dw_data_at >= dw_data_n) {
        devwire_data_done();
        return
    }
    tb_n = 0;
    tb_str("/data/");
    k: int = dw_data_at;
    for i in 0..dw_data_name_n[k] tb_byte(dw_data_names[k * DW_DATA_NAME_MOST + i] as int);
    devwire_data_get(tb_ns(), 0)
}

// File dw_data_at come: written where it is read from, the next asked
// for.
devwire_data_fetched(body: int) {
    k: int = dw_data_at;
    fm: int = msg(cls("NSFileManager"), sel("defaultManager"));
    dir: int = msg(msg(fm, sel("temporaryDirectory")), sel("path"));
    tb_n = 0;
    tb_str("devdata-");
    tb_int(k);
    path: int = msg1(dir, sel("stringByAppendingPathComponent:"), tb_ns());
    if ((msg2(body, sel("writeToFile:atomically:"), path, 1) & 255) != 0) {
        dw_data_paths[k] = keep(path);
        tb_n = 0;
        tb_str("bible: data from the server: ");
        for i in 0..dw_data_name_n[k] tb_byte(dw_data_names[k * DW_DATA_NAME_MOST + i] as int);
        note_ns(tb_ns())
    }
    dw_data_at = k + 1;
    devwire_data_next()
}

devwire_data_done() {
    dw_data_state = DW_DATA_READY;
    asks_pump_soon()
}

// The file read for ask id (a name core asked for, as ask_names has it) if
// the server gave one in its place, else 0.
devwire_data_path(id: int): int {
    if (dw_data_state != DW_DATA_READY) return 0;
    for k in 0..dw_data_n {
        if (dw_data_paths[k] != 0 && dw_data_name_n[k] == ask_name_n[id]) {
            same: bool = true;
            for i in 0..ask_name_n[id]
                if (dw_data_names[k * DW_DATA_NAME_MOST + i] != ask_names[id * 64 + i]) same = false;
            if (same) return dw_data_paths[k]
        }
    }
    0
}

devwire_ask() {
    if (dw_task != 0 || dw_url == 0) return;
    tb_n = 0;
    tb_str("/wire?since=");
    tb_int(dw_since);
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), msg1(dw_url, sel("stringByAppendingString:"),
        tb_ns()));
    if (url == 0) return;
    task: int = msg1(dw_session, sel("dataTaskWithURL:"), url);
    if (task == 0) return;
    dw_task = keep(task);
    dw_body = keep(make("NSMutableData"));
    msg(task, sel("resume"))
}

// The session's callbacks (platform.l8's delegate's): whether task is ours.
devwire_received(task: int, data: int): bool {
    if (task != 0 && task == dw_data_task) {
        msg1(dw_data_body, sel("appendData:"), data);
        return true
    }
    if (task == 0 || task != dw_task) return false;
    msg1(dw_body, sel("appendData:"), data);
    true
}

devwire_completed(task: int, error: int): bool {
    if (task != 0 && task == dw_data_task) {
        body: int = dw_data_body;
        dw_data_task = 0;
        dw_data_body = 0;
        // (A failure: the list taken as empty, or the file left the
        // bundle's.)
        ok: bool = error == 0 && msg(msg(task, sel("response")), sel("statusCode")) == 200;
        if (dw_data_state == DW_DATA_LISTING) {
            if (ok) devwire_data_listed(body) else devwire_data_done()
        } else if (ok) devwire_data_fetched(body) else {
            dw_data_at = dw_data_at + 1;
            devwire_data_next()
        }
        release(body);
        release(task);
        return true
    }
    if (task == 0 || task != dw_task) return false;
    body: int = dw_body;
    dw_task = 0;
    dw_body = 0;
    if (error == 0) devwire_lines(body);
    release(body);
    release(task);
    // (Asked again at once; after a failure, in a second.)
    if (error == 0) devwire_ask() else _t: int = after(1.0f64, "devwireAgain:");
    true
}

devwire_again(_self: int, _cmd: int, _timer: int): int {
    devwire_ask();
    0
}

// The server's answer: lines of ID TAB LINE (the first answer, the cursor
// alone).
devwire_lines(body: int) {
    n: int = msg(body, sel("length"));
    if (n <= 0) return;
    region {
        b: []i8 = new i8[n](0i8);
        memcpy_from(b, msg(body, sel("bytes")), n);
        if (!dw_on) {
            dw_on = true;
            diag_on = true;
            set_idle_disabled(true);
            devwire_frames_watched();
            note("bible: driven from the development server")
        }
        at: int = 0;
        while (at < n) {
            e: int = at;
            while (e < n && b[e] as int != 10) e = e + 1;
            tab: int = at;
            while (tab < e && b[tab] as int != 9) tab = tab + 1;
            id: int = 0;
            for i in at..tab id = id * 10 + (b[i] as int - 48);
            if (id > dw_since) dw_since = id;
            if (tab + 1 < e) {
                // (How long the line took, the screens it changed made.)
                began: f64 = CACurrentMediaTime();
                devwire_line(b, tab + 1, e);
                note_num("bible: wire ms ", ((CACurrentMediaTime() - began) * 1000.0f64) as int)
            }
            at = e + 1
        }
    }
}

// One line: the app's (!screens, !close, !back, !tap, !info), else core's.
devwire_line(b: []i8, from: int, to: int) {
    if (uilog_line(b, from, to)) return;
    if (followlog_line(b, from, to)) return;
    if (devwire_line_is(b, from, to, "!screens")) {
        devwire_screens();
        return
    }
    if (devwire_line_is(b, from, to, "!state")) {
        devwire_state();
        return
    }
    if (devwire_line_is(b, from, to, "!where")) {
        devwire_where();
        panel_where();
        return
    }
    if (devwire_line_is(b, from, to, "!panelswipe")) {
        // (The panel's sheet dismissed as a swipe's end dismisses it, its
        // delegate told as UIKit tells it then.)
        presenter: int = if (bs_nav == 0) 0 else msg(bs_nav, sel("presentingViewController"));
        if (presenter == 0) note("bible: driven: the panel is not a sheet") else {
            msg2(presenter, sel("dismissViewControllerAnimated:completion:"), 1, 0);
            _d: int = panel_sheet_dismissed(0, 0, 0)
        }
        return
    }
    if (devwire_line_is(b, from, to, "!corelines on") || devwire_line_is(b, from,
        to, "!corelines off")) {
        dw_core_lines = to - from == len("!corelines on");
        return
    }
    if (devwire_line_is(b, from, to, "!rotate landscape")) {
        root_rotate(ORIENT_LANDSCAPE);
        return
    }
    if (devwire_line_is(b, from, to, "!rotate portrait")) {
        root_rotate(ORIENT_PORTRAIT);
        return
    }
    if (devwire_line_is(b, from, to, "!boldtext on") || devwire_line_is(b, from, to,
        "!boldtext off")) {
        devwire_bold_text(to - from == len("!boldtext on"));
        return
    }
    if (devwire_line_is(b, from, to, "!detent small")) {
        panel_wire_detent("small");
        return
    }
    if (devwire_line_is(b, from, to, "!detent medium")) {
        panel_wire_detent("medium");
        return
    }
    if (devwire_line_is(b, from, to, "!detent large")) {
        panel_wire_detent("large");
        return
    }
    if (to - from > 6 && devwire_line_is(b, from, from + 6, "!type ")) {
        devwire_type(b, from + 6, to);
        return
    }
    if (devwire_line_is(b, from, to, "!blocks")) {
        devwire_blocks();
        return
    }
    if (devwire_line_is(b, from, to, "!record on")) {
        devwire_record_on();
        return
    }
    if (devwire_line_is(b, from, to, "!record off")) {
        devwire_record_off();
        return
    }
    if (to - from == 10 && devwire_line_is(b, from, from + 9, "!segment ")) {
        devwire_segment(b[from + 9] as int - 48);
        return
    }
    if (devwire_line_is(b, from, to, "!close")) {
        dismiss_sheets();
        return
    }
    if (devwire_line_is(b, from, to, "!back")) {
        devwire_back();
        return
    }
    if (to - from > 7 && devwire_line_is(b, from, from + 7, "!flick ")) {
        devwire_flick(b, from + 7, to);
        return
    }
    if (to - from > 8 && devwire_line_is(b, from, from + 8, "!scroll ")) {
        devwire_scroll(b, from + 8, to);
        return
    }
    if (devwire_line_is(b, from, to, "!style light")) {
        devwire_style(INTERFACE_STYLE_LIGHT);
        return
    }
    if (devwire_line_is(b, from, to, "!style dark")) {
        devwire_style(INTERFACE_STYLE_DARK);
        return
    }
    if (devwire_line_is(b, from, to, "!style system")) {
        devwire_style(INTERFACE_STYLE_SYSTEM);
        return
    }
    if (to - from > 8 && devwire_line_is(b, from, from + 8, "!slowmo ")) {
        devwire_slow_motion(b, from + 8, to);
        return
    }
    if (to - from > 9 && devwire_line_is(b, from, from + 9, "!rowmenu ")) {
        devwire_row_menu(b, from + 9, to);
        return
    }
    if (to - from > 10 && devwire_line_is(b, from, from + 10, "!rowswipe ")) {
        devwire_row_swipe(b, from + 10, to);
        return
    }
    if (to - from > 5 && devwire_line_is(b, from, from + 5, "!tap ")) {
        devwire_tap(b, from + 5, to, false);
        return
    }
    if (to - from > 6 && devwire_line_is(b, from, from + 6, "!info ")) {
        devwire_tap(b, from + 6, to, true);
        return
    }
    if (b[from] as int == 33) {
        note("bible: driven: no such line of the app's");
        return
    }
    for i in from..to to_core_byte(b[i] as int);
    to_core_end()
}

// `!back`: back a screen, as the bar's Back does: the top sheet's, else
// the panel's.
devwire_back() {
    nav: int = top_presented();
    if (nav == 0 || (msg1(nav, sel("isKindOfClass:"), cls("UINavigationController")) & 255) == 0) nav = bs_nav;
    if (nav == 0 || msg(msg(nav, sel("viewControllers")), sel("count")) < 2) {
        note("bible: driven: no screen to go back from");
        return
    }
    _p: int = msg1(nav, sel("popViewControllerAnimated:"), 1)
}

// `!scroll DY`: the list of the top sheet's screen (else the panel's top
// screen's) scrolled DY points down (negative: up), within its content.
devwire_scroll(b: []i8, from: int, to: int) {
    at: int = from;
    up: bool = at < to && b[at] as int == 45;
    if (up) at = at + 1;
    dy: int = 0;
    while (at < to && b[at] as int >= 48 && b[at] as int <= 57) {
        dy = dy * 10 + b[at] as int - 48;
        at = at + 1
    }
    nav: int = top_presented();
    if (nav == 0 || (msg1(nav, sel("isKindOfClass:"), cls("UINavigationController")) & 255) == 0) nav = bs_nav;
    vc: int = if (nav == 0) 0 else msg(nav, sel("topViewController"));
    t: int = 0;
    for k in 0..UK_SLOTS
        if (vc != 0 && uk_vcs[k] == vc) t = uk_tables[k];
    if (t == 0) {
        note("bible: driven: no list to scroll");
        return
    }
    y: f64 = offset_y(t) + (if (up) -dy else dy) as f64;
    l8_msg_hfa(hfa, t, sel("contentSize"), 0, 0, 0);
    most: f64 = hfa[1] + bottom_inset(t) - view_height(t);
    if (y > most) y = most;
    if (y < -top_inset(t)) y = -top_inset(t);
    _o: int = msg_ff(t, sel("setContentOffset:"), 0.0f64, y)
}

// `!tap WORDS`: the first row, button at its foot (or a menu's item of
// one) or button at the left of its bar, of a screen shown at the top of
// its navigation, whose title or spoken label begins with WORDS, tapped
// as a finger would; else the panel's own close or Full Screen (Close
// Panel, Full Screen, Beside the Page); `!info WORDS`, the first such
// row's ⓘ.
devwire_tap(
    b: []i8,
    from: int,
    to: int,
    info: bool
) {
    tb_n = 0;
    for i in from..to tb_byte(b[i] as int);
    words: int = keep(tb_ns());
    for k in 0..UK_SLOTS {
        vc: int = uk_vcs[k];
        nav: int = if (vc == 0) 0 else msg(vc, sel("navigationController"));
        if (nav != 0 && msg(nav, sel("topViewController")) == vc && msg(msg(vc, sel("view")),
            sel("window")) != 0 && uk_ensure(k)) {
            for ri in 0..uk_ui.rows_n {
                row: UiRow = uk_ui.rows[ri];
                if (!row.disabled && (row.kind == UI_ITEM || row.kind == UI_BUTTON) && (!info || row.info_action != 0) && devwire_begins(uk_text(row.title),
                    words)) {
                    release(words);
                    uk_nav = nav;
                    uk_wire_act(uk_ids[k], if (info) row.info_action else row.action,
                        row.arg, 0);
                    uk_effects();
                    return
                }
            }
            if (info)
                continue;
            for ti in 0..uk_ui.tools_n {
                tool: UiTool = uk_ui.tools[ti];
                if (devwire_begins(uk_text(tool.title), words) || devwire_begins(uk_text(tool.label),
                    words)) {
                    release(words);
                    uk_nav = nav;
                    uk_wire_act(uk_ids[k], tool.action, tool.arg, 0);
                    uk_effects();
                    return
                }
                // (A tool's menu's items, as if chosen from it: the panel's
                // reader's Swap Panes, Full Screen, Close Panel.)
                idx: int = 0;
                while (idx < 64 && uk_menu_item(tool.menu, idx)) {
                    if (devwire_begins(nsstring_at(bytes_address(uk_ui.pool) + uk_mi_b,
                        uk_mi_e - uk_mi_b), words)) {
                        release(words);
                        uk_nav = nav;
                        uk_wire_act(uk_ids[k], tool.action, uk_mi_arg, 0);
                        uk_effects();
                        return
                    }
                    idx = idx + 1
                }
            }
            // (The button at the left of its bar: the panel's reader's
            // name.)
            if (uk_ui.left.n > 0 && devwire_begins(uk_text(uk_ui.left), words)) {
                release(words);
                uk_nav = nav;
                uk_wire_act(uk_ids[k], uk_ui.left_action, 0, 0);
                uk_effects();
                return
            }
        }
    }
    // (The panel's own buttons, the skin's: its close, Full Screen.)
    if (bs_shown && devwire_begins(nsstring(w_close_beside), words)) {
        release(words);
        _c: int = beside_close_tapped(app_obj, 0, 0);
        return
    }
    if (bs_shown && (devwire_begins(nsstring(w_full_beside), words) || devwire_begins(nsstring(w_unfull_beside),
        words))) {
        release(words);
        _f: int = beside_full_tapped(app_obj, 0, 0);
        return
    }
    release(words);
    note("bible: driven: nothing shown to tap so")
}

// `!boldtext on|off`: Bold Text as the system's setting gives it, through
// the root's traits (the window's own override is the theme's).
devwire_bold_text(on: bool) {
    if (root_vc == 0) return;
    over: int = msg(root_vc, sel("traitOverrides"));
    if (on) msg1(over, sel("setLegibilityWeight:"), UI_LEGIBILITY_BOLD) else msg1(over,
        sel("removeTrait:"), cls("UITraitLegibilityWeight"));
    note_num("bible: bold text ", if (on) 1 else 0)
}

// UILegibilityWeightBold.
UI_LEGIBILITY_BOLD: int = 1;

// Whether text (an NSString, or 0) begins with words.
devwire_begins(text: int, words: int): bool {
    text != 0 && (msg1(text, sel("hasPrefix:"), words) & 255) != 0
}

// `!state`: the wire's flags, to the log (a tap that does nothing: core
// not being fed, or its lines not being read).
devwire_state() {
    tb_n = 0;
    tb_str("bible: state feeding ");
    tb_int(if (feeding) 1 else 0);
    tb_str(" to core ");
    tb_int(to_core_n);
    tb_str(" taking ");
    tb_int(if (taking) 1 else 0);
    tb_str(" waiting ");
    tb_int(waiting);
    tb_str(" from core ");
    tb_int(from_core_n - from_core_at);
    note_ns(tb_ns())
}

// `!where`: each pane's place at its reading line, to the log: its
// chapter, anchor and how far through; the line, the top inset and the
// offset; and, for the anchors of the part at the line, where the window
// keeps each one's start and where its text view lays it out now (a
// difference: a place measured before its part was laid out as shown).
devwire_where() {
    // (Following's state: why the panel last stayed, and what can hold it.)
    tb_n = 0;
    tb_str("bible: where following linked ");
    tb_int(if (win_linked) 1 else 0);
    tb_str(" leader ");
    tb_int(win_leader);
    tb_str(" jump held ");
    tb_int(if (win_jump_held) 1 else 0);
    tb_str(" ruled ");
    tb_int(if (win_ruled) 1 else 0);
    tb_str(" inside ");
    tb_int(if (win_following) 1 else 0);
    tb_str(" self ");
    tb_int(win_self[PANE_PAGE]);
    tb_str(" ");
    tb_int(win_self[PANE_PANEL]);
    tb_str(" glide pane ");
    tb_int(win_follow_glide_pane);
    tb_str(" last: ");
    tb_str(win_follow_whys[win_follow_why]);
    note_ns(tb_ns());
    for p in 0..PANES {
        t: int = win_table[p];
        at: WinPlace = win_place(p);
        tb_n = 0;
        tb_str("bible: where pane ");
        tb_int(p);
        if (t == 0 || !at.ok) {
            tb_str(" none");
            note_ns(tb_ns());
            continue
        }
        tb_str(" c ");
        tb_int(at.c);
        tb_str(" i ");
        tb_int(at.i);
        tb_str(" part ");
        tb_int((at.part * 1000.0f64) as int);
        tb_str(" line ");
        tb_int((at.line * 10.0f64) as int);
        tb_str(" inset ");
        tb_int((top_inset(t) * 10.0f64) as int);
        tb_str(" offset ");
        tb_int((offset_y(t) * 10.0f64) as int);
        told: WinPlace = win_place_told(p);
        tb_str(" told ");
        tb_int(told.c);
        tb_str(" ");
        tb_int(told.i);
        tb_str(" ");
        tb_int((told.part * 1000.0f64 + 0.5f64) as int);
        note_ns(tb_ns());
        r: int = win_row_at(p, at.line);
        if (r < 0)
            continue;
        x: int = wr(p, r);
        s: int = rs_slot(rs_key(p, win_c[x], win_k[x]));
        n: int = win_vn[x];
        first: int = win_first_anchor(p, win_c[x], win_k[x]);
        tb_n = 0;
        tb_str("bible: where   row part ");
        tb_int(win_k[x]);
        tb_str(" verses ");
        tb_int(n);
        tb_str(" first anchor ");
        tb_int(first);
        tb_str(" top ");
        tb_int(((win_y[x] - at.line) * 10.0f64) as int);
        note_ns(tb_ns());
        for j in 0..n {
            y: f64 = win_y[x] + win_vy[x * WIN_VERSES_MOST + j];
            if (y > at.line - 400.0f64 && y < at.line + 400.0f64) {
                now: f64 = if (s >= 0 && range_rect(win_view[x], rs_vb2[s * VS_MOST + j],
                    1)) win_y[x] + hfa[1] else -1.0f64;
                tb_n = 0;
                tb_str("bible: where   anchor ");
                tb_int(first + j);
                tb_str(" verse ");
                tb_int(win_anchor_verse(p, win_c[x], first + j));
                tb_str(" part's ");
                tb_int(if (s >= 0) rs_v_num[s * VS_MOST + j] else -1);
                tb_str(" kept ");
                tb_int(((y - at.line) * 10.0f64) as int);
                tb_str(" now ");
                tb_int(((now - at.line) * 10.0f64) as int);
                tb_str(" (tenths of a point from the line)");
                note_ns(tb_ns())
            }
        }
    }
}

// Whether bytes from to to of b are word.
devwire_line_is(
    b: []i8,
    from: int,
    to: int,
    word: str
): bool {
    if (to - from != len(word)) return false;
    for i in 0..len(word) {
        if (b[from + i] != word[i] as i8) return false
    }
    true
}

// The screens shown, to the log: each one's id, kind and group; then the
// panel's stack, each one's screen and title.
devwire_screens() {
    if (bs_nav != 0) {
        vcs: int = msg(bs_nav, sel("viewControllers"));
        tb_n = 0;
        tb_str("bible: panel stack ");
        tb_int(msg(vcs, sel("count")));
        tb_str(" bar items ");
        tb_int(msg(msg(msg(bs_nav, sel("navigationBar")), sel("items")), sel("count")));
        tb_str(" shown ");
        tb_int(if (bs_shown) 1 else 0);
        note_ns(tb_ns());
        for i in 0..msg(vcs, sel("count")) {
            vc: int = msg1(vcs, sel("objectAtIndex:"), i);
            tb_n = 0;
            tb_str("bible: panel ");
            tb_int(i);
            for k in 0..UK_SLOTS {
                if (uk_vcs[k] == vc) {
                    tb_str(" screen ");
                    tb_int(uk_ids[k]);
                    tb_str(" sections ");
                    tb_int(msg(uk_tables[k], sel("numberOfSections")))
                }
            }
            tb_str(" title ");
            title: int = msg(vc, sel("title"));
            if (title != 0) tb_nsstring(title);
            // (Its bar: the title's view, how wide, whether it is shown;
            // the items at each side.)
            item: int = msg(vc, sel("navigationItem"));
            tv: int = msg(item, sel("titleView"));
            tb_str(" title view ");
            if (tv == 0) tb_str("none") else {
                tb_nsstring(NSStringFromClass(msg(tv, sel("class"))));
                tb_str(" w ");
                tb_int(view_width(tv) as int);
                tb_str(" in window ");
                tb_int(if (msg(tv, sel("window")) == 0) 0 else 1)
            }
            left: int = msg(item, sel("leftBarButtonItems"));
            right: int = msg(item, sel("rightBarButtonItems"));
            tb_str(" left items ");
            tb_int(if (left == 0) 0 else msg(left, sel("count")));
            tb_str(" right items ");
            tb_int(if (right == 0) 0 else msg(right, sel("count")));
            note_ns(tb_ns())
        }
    }
    for index in 0..len(uk_wire_ids) {
        if (uk_wire_ids[index] >= 0 && uk_slot_of_id(uk_wire_ids[index]) >= 0) {
            tb_n = 0;
            tb_str("bible: screen ");
            tb_int(uk_wire_ids[index]);
            tb_str(" kind ");
            tb_int(uk_wire_kinds[index]);
            tb_str(" group ");
            tb_int(uk_wire_groups[index]);
            note_ns(tb_ns())
        }
    }
}

// ---- core's lines ----
// `!corelines on|off`: the lines core sends about the panes and the panel
// (go, forget, panel, beside, halt, push, the arrivals, gap, reader) and
// what the panes tell core of their places (`at`), to the log as the skin
// takes them, cut to their first DW_CORE_LINE_KEPT bytes (a line's words
// after them say nothing these need). Kept through a hot reload, so that
// the lines of a launch are seen too.
persistent dw_core_lines: bool = false;

DW_CORE_LINE_KEPT: int = 100;

dw_core_words: []str = ["go", "forget", "panel", "beside", "halt", "push", "arriving",
    "arrived", "gap", "reader"];

devwire_core_line(line: WireLine) {
    if (!dw_core_lines) return;
    for word in dw_core_words {
        if (wire_is(line, word)) {
            tb_n = 0;
            tb_str("bible: core: ");
            from: int = line.starts[0];
            end: int = if (line.end - from > DW_CORE_LINE_KEPT) from + DW_CORE_LINE_KEPT else line.end;
            for i in from..end tb_byte(if (line.data[i] as int == 9) 32 else line.data[i] as int);
            note_ns(tb_ns());
            return
        }
    }
}

// What a pane tells core of its place (`at P C I FRAC`), with core's
// lines (the page's too: they come as its anchor changes).
devwire_said(
    p: int,
    c: int,
    i: int,
    frac: int
) {
    if (!dw_core_lines) return;
    tb_n = 0;
    tb_str("bible: skin: at ");
    tb_int(p);
    tb_str(" ");
    tb_int(c);
    tb_str(" ");
    tb_int(i);
    tb_str(" ");
    tb_int(frac);
    note_ns(tb_ns())
}

// ---- frames ----
// While it is driven, each frame's interval watched: one much longer than
// the screen's while the page or the panel's reader moves (a stall the eye
// sees: a glide stopping, a stutter) written to the log, with which.
DW_FRAME_LATE_MS: int = 25;

// (Kept through a hot reload: a link made again each build would go on
// calling every frame.)
persistent dw_frame_link: int = 0;

dw_frame_last: f64 = 0.0f64;

devwire_frames_watched() {
    if (dw_frame_link != 0) return;
    dw_frame_link = keep(msg2(cls("CADisplayLink"), sel("displayLinkWithTarget:selector:"),
        app_obj, sel("devwireFrame:")));
    msg2(dw_frame_link, sel("addToRunLoop:forMode:"), msg(cls("NSRunLoop"), sel("mainRunLoop")),
        l8_run_loop_common_modes())
}

devwire_frame(_self: int, _cmd: int, _link: int): int {
    now: f64 = CACurrentMediaTime();
    gap: int = ((now - dw_frame_last) * 1000.0f64) as int;
    page: bool = reader_moving();
    panel: bool = win_moving(PANE_PANEL);
    if (dw_frame_last > 0.0f64 && gap >= DW_FRAME_LATE_MS && (page || panel)) {
        tb_n = 0;
        tb_str("bible: frame late ms ");
        tb_int(gap);
        tb_str(if (page) " page moving" else " panel moving");
        note_ns(tb_ns())
    }
    if (dw_glide_view != 0) {
        if (dw_frame_last > 0.0f64 && gap >= DW_FRAME_LATE_MS) dw_glide_late = dw_glide_late + 1;
        if (gap > dw_glide_worst) dw_glide_worst = gap;
        devwire_glide_step(now)
    }
    dw_frame_last = now;
    if (dw_record_state == DW_RECORD_WRITING) devwire_record_written(now);
    uilog_frame(now);
    followlog_frame(now);
    0
}

// ---- a segment ----
// `!segment N`: segment N of the top sheet's title (its segmented control:
// a search's scopes, say) chosen, as a tap chooses it.
devwire_segment(n: int) {
    nav: int = top_presented();
    if (nav == 0 || (msg1(nav, sel("isKindOfClass:"), cls("UINavigationController")) & 255) == 0) nav = bs_nav;
    vc: int = if (nav == 0) 0 else msg(nav, sel("topViewController"));
    seg: int = if (vc == 0) 0 else msg(msg(vc, sel("navigationItem")), sel("titleView"));
    if (seg == 0 || !responds(seg, "setSelectedSegmentIndex:")) {
        note("bible: driven: no segments in the title");
        return
    }
    msg1(seg, sel("setSelectedSegmentIndex:"), n);
    msg1(seg, sel("sendActionsForControlEvents:"), 4096)
}

// ---- typing ----
// `!type TEXT`: the field of the top sheet's screen holding TEXT, as if
// typed (its search controller told, as UIKit tells it of a key).
devwire_type(b: []i8, from: int, to: int) {
    nav: int = top_presented();
    if (nav == 0 || (msg1(nav, sel("isKindOfClass:"), cls("UINavigationController")) & 255) == 0) nav = bs_nav;
    vc: int = if (nav == 0) 0 else msg(nav, sel("topViewController"));
    sc: int = if (vc == 0) 0 else msg(msg(vc, sel("navigationItem")), sel("searchController"));
    if (sc == 0) {
        note("bible: driven: no field to type in");
        return
    }
    tb_n = 0;
    for i in from..to tb_byte(b[i] as int);
    msg1(msg(sc, sel("searchBar")), sel("setText:"), tb_ns());
    _u: bool = uk_search_updated(sc)
}

// ---- blocks ----
// `!blocks`: each kind of block (ios/block.l8) made and called, what came
// back written to the log: a block of none called as the runtime calls one
// (-invoke), one of two called as C calls it, one returning a double, and
// one called on other threads (an array enumerated concurrently) whose
// handler must run on the main thread, given the objects it was called
// with. `blocks: main N/3` comes when the main thread has run them.
dw_blocks_none: int = 0;

dw_blocks_main_n: int = 0;

dw_blocks_main_ok: bool = true;

dw_blocks_each: int = 0;

devwire_block_none(context: int): int {
    dw_blocks_none = context;
    0
}

devwire_block_sum(context: int, a: int, b: int): int {
    context + a + b
}

devwire_block_half(context: int, a: int): int {
    block_double(context as f64 * 0.5f64 + a as f64)
}

devwire_block_main(context: int, object: int, index: int): int {
    on_main: bool = (msg(cls("NSThread"), sel("isMainThread")) & 255) != 0;
    // (The object it was called with: the array's string at its index.)
    tb_n = 0;
    tb_nsstring(object);
    expected: bool = tb_n == 1 && tb[0] as int == 97 + index;
    if (!on_main || !expected || context != 41) dw_blocks_main_ok = false;
    dw_blocks_main_n = dw_blocks_main_n + 1;
    if (dw_blocks_main_n == 3) block_free(dw_blocks_each);
    if (dw_blocks_main_n == 3) note(if (dw_blocks_main_ok) "bible: blocks: main 3/3, on the main thread, with their objects" else "bible: blocks: main FAILED");
    0
}

devwire_blocks() {
    none: int = block0(&devwire_block_none, 17, "v8@?0");
    if (none == 0) {
        note("bible: blocks: none made (a host without the shims?)");
        return
    }
    dw_blocks_none = 0;
    call_block(none);
    note(if (dw_blocks_none == 17) "bible: blocks: none ok" else "bible: blocks: none FAILED");
    sum: int = block2(&devwire_block_sum, 100, "q24@?0q8q16");
    note(if (l8_block_invoke(sum, 20, 3, 0) == 123) "bible: blocks: two ok" else "bible: blocks: two FAILED");
    half: int = block1_double(&devwire_block_half, 5, "d16@?0q8");
    d: f64 = l8_block_invoke_double(half, 5);
    note(if (d > 7.49f64 && d < 7.51f64) "bible: blocks: double ok" else "bible: blocks: double FAILED");
    // ((id obj, NSUInteger idx, BOOL *stop): the string an object, kept
    // while its call waits for the main thread.)
    dw_blocks_each = block2_main(&devwire_block_main, 41, 1, "v32@?0@8Q16^B24");
    dw_blocks_main_n = 0;
    dw_blocks_main_ok = true;
    one[0] = nsstring("a");
    one[1] = nsstring("b");
    one[2] = nsstring("c");
    msg2(nsarray(one, 3), sel("enumerateObjectsWithOptions:usingBlock:"), 1, dw_blocks_each);
    block_free(none);
    block_free(sum);
    block_free(half);
    note_num("bible: blocks: held after ", blocks_held())
}

// ---- a recording ----
// `!record on`, `!record off`: the app's windows recorded as they are shown
// (ReplayKit's: every animation at the display's rate), then the movie
// posted to the server (POST /video, saved as .build/dev/videos/N.mov) to
// be looked at frame by frame. The first recording after a launch waits
// for the person holding the phone to allow it. Its movie is written after
// the recording stops, with no word when it is done (a handler would be a
// block, ios/block.l8): each frame looks for it, posted once its size
// holds for DW_RECORD_SETTLE_S.
DW_RECORD_NONE: int = 0;

DW_RECORD_ON: int = 1;

DW_RECORD_WRITING: int = 2;

DW_RECORD_SETTLE_S: f64 = 0.5f64;

DW_RECORD_WAIT_S: f64 = 30.0f64;

dw_record_state: int = 0;

dw_record_stopped: f64 = 0.0f64;

dw_record_size: int = -1;

dw_record_settled: f64 = 0.0f64;

// ReplayKit's recorder (the framework loaded the first time: the app
// doesn't link it).
devwire_recorder(): int {
    if (cls("RPScreenRecorder") == 0) _l: int = msg(msg1(cls("NSBundle"), sel("bundleWithPath:"),
        nsstring("/System/Library/Frameworks/ReplayKit.framework")), sel("load"));
    if (cls("RPScreenRecorder") == 0) 0 else msg(cls("RPScreenRecorder"), sel("sharedRecorder"))
}

// Where the movie is written: the app's tmp.
devwire_record_path(): int {
    msg1(NSHomeDirectory(), sel("stringByAppendingString:"), nsstring("/tmp/devwire-recording.mov"))
}

devwire_record_on() {
    recorder: int = devwire_recorder();
    if (recorder == 0 || dw_record_state != DW_RECORD_NONE) {
        note("bible: record: can't record now");
        return
    }
    msg1(recorder, sel("setMicrophoneEnabled:"), 0);
    msg1(recorder, sel("startRecordingWithHandler:"), 0);
    dw_record_state = DW_RECORD_ON;
    note("bible: record: on")
}

devwire_record_off() {
    recorder: int = devwire_recorder();
    if (recorder == 0 || dw_record_state != DW_RECORD_ON) {
        note("bible: record: not recording");
        return
    }
    if ((msg(recorder, sel("isRecording")) & 255) == 0) {
        dw_record_state = DW_RECORD_NONE;
        note("bible: record: it never began (not allowed on the phone?)");
        return
    }
    path: int = devwire_record_path();
    _r: int = msg2(msg(cls("NSFileManager"), sel("defaultManager")), sel("removeItemAtPath:error:"),
        path, 0);
    msg2(recorder, sel("stopRecordingWithOutputURL:completionHandler:"), msg1(cls("NSURL"),
        sel("fileURLWithPath:"), path), 0);
    dw_record_state = DW_RECORD_WRITING;
    dw_record_stopped = CACurrentMediaTime();
    dw_record_size = -1;
    note("bible: record: off, writing")
}

// The movie looked for (each frame while it is being written), posted once
// it is whole.
devwire_record_written(now: f64) {
    if (now - dw_record_stopped > DW_RECORD_WAIT_S) {
        dw_record_state = DW_RECORD_NONE;
        note("bible: record: no movie came");
        return
    }
    path: int = devwire_record_path();
    attributes: int = msg2(msg(cls("NSFileManager"), sel("defaultManager")), sel("attributesOfItemAtPath:error:"),
        path, 0);
    size: int = if (attributes == 0) -1 else msg(attributes, sel("fileSize"));
    if (size <= 0) return;
    if (size != dw_record_size) {
        dw_record_size = size;
        dw_record_settled = now;
        return
    }
    if (now - dw_record_settled < DW_RECORD_SETTLE_S) return;
    dw_record_state = DW_RECORD_NONE;
    body: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), path);
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), msg1(dw_url, sel("stringByAppendingString:"),
        nsstring("/video")));
    request: int = if (url == 0 || body == 0) 0 else msg1(cls("NSMutableURLRequest"),
        sel("requestWithURL:"), url);
    if (request == 0) {
        note("bible: record: could not post");
        return
    }
    msg1(request, sel("setHTTPMethod:"), nsstring("POST"));
    msg1(request, sel("setHTTPBody:"), body);
    task: int = msg1(dw_session, sel("dataTaskWithRequest:"), request);
    if (task != 0) msg(task, sel("resume"));
    note_num("bible: record: posting bytes ", size)
}

// ---- a flick ----
// `!flick page DY`, `!flick panel DY`: the page, or the panel's reader,
// moved as a finger's flick moves it: a drag begun, a glide DY points
// down (negative: up) over DW_GLIDE_S, slowing as a glide does, frame by
// frame, then ended; meanwhile it counts as moving by a finger. Its end
// written to the log: how many frames were late, and the worst.
DW_GLIDE_S: f64 = 1.2f64;

dw_glide_view: int = 0;

// How far the flick has gone so far.
dw_glide_from: f64 = 0.0f64;

dw_glide_by: f64 = 0.0f64;

dw_glide_t0: f64 = 0.0f64;

dw_glide_late: int = 0;

dw_glide_worst: int = 0;

// Whether scroll view sv is being flicked so.
devwire_gliding(sv: int): bool {
    sv != 0 && sv == dw_glide_view
}

devwire_flick(b: []i8, from: int, to: int) {
    e: int = from;
    while (e < to && b[e] as int != 32) e = e + 1;
    panel: bool = devwire_line_is(b, from, e, "panel");
    sv: int = if (panel) win_table[PANE_PANEL] else table;
    if (sv == 0 || dw_glide_view != 0) {
        note("bible: driven: nothing to flick");
        return
    }
    at: int = e;
    while (at < to && b[at] as int == 32) at = at + 1;
    up: bool = at < to && b[at] as int == 45;
    if (up) at = at + 1;
    dy: int = 0;
    while (at < to && b[at] as int >= 48 && b[at] as int <= 57) {
        dy = dy * 10 + b[at] as int - 48;
        at = at + 1
    }
    _b: int = scroll_began(app_obj, 0, sv);
    dw_glide_view = sv;
    dw_glide_from = 0.0f64;
    dw_glide_by = (if (up) -dy else dy) as f64;
    dw_glide_t0 = CACurrentMediaTime();
    dw_glide_late = 0;
    dw_glide_worst = 0
}

// The flick's place at time now (as a glide slows: fast, then gently), and
// at its end, the glide ended.
devwire_glide_step(now: f64) {
    sv: int = dw_glide_view;
    t: f64 = (now - dw_glide_t0) / DW_GLIDE_S;
    done: bool = t >= 1.0f64;
    if (done) t = 1.0f64;
    u: f64 = 1.0f64 - t;
    // (By how far it has gone since the last frame, from where it is now:
    // the window moves its offset as parts come and go above, as it moves
    // UIKit's own glide.)
    went: f64 = dw_glide_by * (1.0f64 - u * u * u);
    y: f64 = offset_y(sv) + went - dw_glide_from;
    dw_glide_from = went;
    l8_msg_hfa(hfa, sv, sel("contentSize"), 0, 0, 0);
    most: f64 = hfa[1] + bottom_inset(sv) - view_height(sv);
    if (y > most) y = most;
    if (y < -top_inset(sv)) y = -top_inset(sv);
    _o: int = msg_ff(sv, sel("setContentOffset:"), 0.0f64, y);
    if (!done) return;
    devwire_glide_end(sv)
}

// Scroll view sv's flick ended now, where it is (as a glide stopped).
devwire_glide_end(sv: int) {
    if (sv == 0 || sv != dw_glide_view) return;
    dw_glide_view = 0;
    _e: int = scroll_ended(app_obj, 0, sv);
    tb_n = 0;
    tb_str("bible: flick ended late ");
    tb_int(dw_glide_late);
    tb_str(" worst ms ");
    tb_int(dw_glide_worst);
    note_ns(tb_ns())
}

add_devwire_methods(app: int) {
    add_method1(app, sel("devwireAgain:"), &devwire_again, "v@:@");
    add_method1(app, sel("devwireFrame:"), &devwire_frame, "v@:@")
}

// ---- a row's menu and swipe, as a finger would bring them ----
// No public API shows a row's context menu or reveals its swipe, so these
// call the app's own delegate methods (ios/rowmenus.l8), as UIKit would,
// and log what they give; then do an action as the menu's or the swipe's
// own handler would. All of it public API and the app's own code.
//
// `!rowmenu SCREEN SECTION ROW`: the menu of that row of the shown screen
// whose title begins with SCREEN (one word: History, Go, Search), each of
// its actions' words, symbol and whether it is destructive; `!rowmenu
// SCREEN SECTION ROW N`: then its action N done by its handler.
// `!rowswipe SCREEN SECTION ROW`: the swipe's actions, then the first done
// by the handler UIKit would call (UIContextualAction's own), with a
// completion of ours that logs what it was told.
type DevwireRow = {
    slot: int;
    path: int;
    // The number after the row (-1: none).
    then: int
}

// The words after the line's name: SCREEN SECTION ROW [N] (the numbers
// read into devwire_row_numbers, -1 for one not given).
devwire_row_numbers: []int = new int[3](-1);

devwire_row_parse(b: []i8, from: int, to: int): DevwireRow {
    at: int = from;
    while (at < to && b[at] as int != 32) at = at + 1;
    tb_n = 0;
    for i in from..at tb_byte(b[i] as int);
    screen: int = tb_ns();
    numbers: []int = devwire_row_numbers;
    for n in 0..3 {
        numbers[n] = -1;
        while (at < to && b[at] as int == 32) at = at + 1;
        if (at < to && b[at] as int >= 48 && b[at] as int <= 57) {
            numbers[n] = 0;
            while (at < to && b[at] as int >= 48 && b[at] as int <= 57) {
                numbers[n] = numbers[n] * 10 + b[at] as int - 48;
                at = at + 1
            }
        }
    }
    slot: int = -1;
    for k in 0..UK_SLOTS {
        vc: int = uk_vcs[k];
        nav: int = if (vc == 0) 0 else msg(vc, sel("navigationController"));
        if (slot < 0 && nav != 0 && msg(nav, sel("topViewController")) == vc && msg(msg(vc,
            sel("view")), sel("window")) != 0 && uk_ensure(k) && devwire_begins(uk_text(uk_ui.title),
            screen)) slot = k
    }
    path: int = if (slot < 0 || numbers[0] < 0 || numbers[1] < 0) 0 else msg2(cls("NSIndexPath"),
        sel("indexPathForRow:inSection:"), numbers[1], numbers[0]);
    DevwireRow { slot: slot, path: path, then: numbers[2] }
}

devwire_row_menu(b: []i8, from: int, to: int) {
    row: DevwireRow = devwire_row_parse(b, from, to);
    if (row.slot < 0 || row.path == 0) {
        note("bible: rowmenu: no such screen shown, or no section and row");
        return
    }
    configuration: int = row_menu_configuration(uk_tables[row.slot], row.path);
    if (configuration == 0) {
        note("bible: rowmenu: none (the row has no actions)");
        return
    }
    menu: int = row_menu_actions(0, 0);
    children: int = if (menu == 0) 0 else msg(menu, sel("children"));
    n: int = if (children == 0) 0 else msg(children, sel("count"));
    i: int = row_menu_row % 4096;
    for j in 0..n {
        action: int = msg1(children, sel("objectAtIndex:"), j);
        tb_n = 0;
        tb_str("bible: rowmenu ");
        tb_int(j);
        tb_str(" ");
        tb_nsstring(msg(action, sel("title")));
        tb_str(" | symbol ");
        if (uk_ensure(row.slot) && i < uk_ui.rows_n && j < uk_ui.rows[i].actions_n) tb_nsstring(uk_text(uk_ui.actions[uk_ui.rows[i].actions + j].icon));
        tb_str(" | image ");
        tb_int(if (msg(action, sel("image")) != 0) 1 else 0);
        tb_str(" destructive ");
        tb_int(if ((msg(action, sel("attributes")) & ROW_DESTRUCTIVE_ATTRIBUTE) != 0) 1 else 0);
        note_ns(tb_ns())
    }
    if (row.then < 0) return;
    if (row.then >= n) {
        note("bible: rowmenu: no such action");
        return
    }
    note_num("bible: rowmenu: done ", row.then);
    _d: int = row_menu_chosen(0, msg1(children, sel("objectAtIndex:"), row.then))
}

// The completion handed to a swipe's handler (made once a process).
persistent devwire_swipe_completion: int = 0;

devwire_swipe_completed(_context: int, success: int): int {
    note_num("bible: rowswipe: completion called with ", success & 255);
    0
}

devwire_row_swipe(b: []i8, from: int, to: int) {
    row: DevwireRow = devwire_row_parse(b, from, to);
    if (row.slot < 0 || row.path == 0) {
        note("bible: rowswipe: no such screen shown, or no section and row");
        return
    }
    t: int = uk_tables[row.slot];
    configuration: int = row_swipe_configuration(t, row.path);
    actions: int = msg(configuration, sel("actions"));
    n: int = if (actions == 0) 0 else msg(actions, sel("count"));
    note_num("bible: rowswipe: actions ", n);
    if (n == 0) return;
    action: int = msg1(actions, sel("objectAtIndex:"), 0);
    tb_n = 0;
    tb_str("bible: rowswipe 0 ");
    tb_nsstring(msg(action, sel("title")));
    tb_str(" | style ");
    tb_int(msg(action, sel("style")));
    note_ns(tb_ns());
    if (devwire_swipe_completion == 0) devwire_swipe_completion = block1(&devwire_swipe_completed,
        0, "v12@?0B8");
    handler: int = if (responds(action, "handler")) msg(action, sel("handler")) else 0;
    cell: int = msg1(t, sel("cellForRowAtIndexPath:"), row.path);
    if (handler != 0) {
        note("bible: rowswipe: done by the action's own handler");
        _h: int = l8_block_invoke(handler, action, cell, devwire_swipe_completion)
    } else {
        note("bible: rowswipe: done by the app's handler (the action has no handler to read)");
        _a: int = row_swipe_chosen(0, action, cell, devwire_swipe_completion)
    }
}

// `!slowmo N`: everything Core Animation runs in the window N times slower
// (the window's layer's speed 1/N; `!slowmo 1` restores it), so that
// screenshots can be taken through a transition (a zoom, a sheet rising)
// without a recording. UIKit's springs and curves are Core Animation's,
// so they slow with it.
devwire_slow_motion(b: []i8, from: int, to: int) {
    n: int = 0;
    for i in from..to
        if (b[i] as int >= 48 && b[i] as int <= 57) n = n * 10 + b[i] as int - 48;
    if (n < 1 || window == 0) {
        note("bible: driven: !slowmo needs a whole number, at least 1");
        return
    }
    msg_set_f32(msg(window, sel("layer")), sel("setSpeed:"), (1.0f64 / n as f64) as f32);
    note_num("bible: slow motion: times ", n)
}

// `!style light|dark|system`: the interface style the system's appearance
// would give, set under the window (the root's trait overrides, iOS 17),
// where the app's themes don't set it (they set the window's own
// override), for Auto's checks; system: the override taken away.
// (UIUserInterfaceStyle's values; unspecified stands for none.)
INTERFACE_STYLE_SYSTEM: int = 0;

INTERFACE_STYLE_LIGHT: int = 1;

INTERFACE_STYLE_DARK: int = 2;

devwire_style(style: int) {
    root: int = if (window == 0) 0 else msg(window, sel("rootViewController"));
    if (root == 0 || !responds(root, "traitOverrides")) {
        note("bible: driven: no trait overrides here (iOS 17)");
        return
    }
    overrides: int = msg(root, sel("traitOverrides"));
    if (style == INTERFACE_STYLE_SYSTEM) msg1(overrides, sel("removeTrait:"), cls("UITraitUserInterfaceStyle")) else msg1(overrides,
        sel("setUserInterfaceStyle:"), style);
    note_num("bible: driven: the style under the window (1 light, 2 dark, 0 the system's) ",
        style)
}
