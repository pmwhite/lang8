tag bible_ios;

use_tag std, ios, bible, bible_wire;

// The panel beside the page (core/beside.l8): what is read with the Bible
// (its reader: a version or a commentary following the page; Study over
// it), core's screens in a navigation controller of its own, kept while
// sheets come and go. The bar's panel button (and ⌥⌘I) opens or closes it
// (with nothing read there yet, core opens Go To aimed at the panel
// instead); core keeps whether it is open and what it shows (its `beside`
// line, at launch as it was left), and makes its screens when it opens
// (`panelmake`); its Back tells core what shows (`panelanchor`), its close
// lets it go (`closegroup 1`). Where it shows (a sheet over the page, or a
// column beside it) is ios/panel.l8's.
import "../../ios/objc.l8";

import "../core/text.l8";

// Whether it is wanted open, and whether it fills the screen (core's to
// keep: told by its `beside` line).
bs_open: bool = false;

bs_full: bool = false;

// Its navigation controller while it is open, whether it is in sight now,
// and its class.
bs_nav: int = 0;

bs_shown: bool = false;

bs_class: int = 0;

// The reader's title (the navigation bar's title view): its box, its
// button (over its words and chevron), its words (the chapter), the
// chevron, and the line under it (what it reads, small and faint).
bs_head: int = 0;

bs_head_name: int = 0;

bs_head_label: int = 0;

bs_head_chevron: int = 0;

bs_head_doc: int = 0;

// How far past the bar's foot its color stays whole before its fade: the
// last of a line going under it, its descenders, isn't left in the fade as
// specks.
BS_HEAD_SOLID: f64 = 6.0f64;

// Screens core pushed on the panel's while its navigation controller is
// being made (`panelmake`'s), pushed once it is.
bs_pending: []int = new int[8](0);

bs_pending_n: int = 0;

// Whether the panel's stack is being made again (core's `panel` with the
// panel shown: what it reads changed): those core pushes with it go on at
// once, not sliding in.
bs_restacking: bool = false;

// Its screens asked for if it is wanted open and not made yet (the root
// laying out).
beside_ensure() {
    if (bs_open && restored && bs_nav == 0) beside_build()
}

// The root laid out again (the panel coming or going, the margins changed).
root_relayout() {
    if (root_vc == 0) return;
    view: int = msg(root_vc, sel("view"));
    msg(view, sel("setNeedsLayout"));
    msg(view, sel("layoutIfNeeded"))
}

// View v's frame set, if it changed (the page measured first where its
// width changes: ios/panel.l8's panel_place).
beside_frame(
    v: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64
) {
    l8_msg_hfa(hfa, v, sel("frame"), 0, 0, 0);
    if (hfa[0] == x && hfa[1] == y && hfa[2] == w && hfa[3] == h) return;
    msg_rect(v, sel("setFrame:"), x, y, w, h)
}

// The panel's screens asked of core (once, until its first comes: core's
// lines may be read later, the skin reading others now).
bs_making: bool = false;

beside_build() {
    if (bs_making) return;
    bs_making = true;
    uk_nav = 0;
    uk_panel_slot = -1;
    bs_pending_n = 0;
    to_core_str("panelmake");
    to_core_end();
    uk_effects()
}

// Core's `panel`: its first screen made (slot k), the panel made round it
// (those core pushes after it go on it), and shown.
beside_made(k: int) {
    if (k < 0) return;
    if (!bs_making && bs_nav != 0) {
        beside_restack(k);
        return
    }
    if (!bs_making || bs_nav != 0) return;
    bs_making = false;
    win_panel_opening = true;
    vc: int = uk_vcs[k];
    beside_dress(vc);
    n: int = msg1(msg(bs_class, sel("alloc")), sel("initWithRootViewController:"),
        vc);
    bs_nav = n;
    msg1(n, sel("setDelegate:"), n);
    msg1(msg(n, sel("toolbar")), sel("setTintColor:"), c_icon);
    // (Those core pushed after it, its stack at once: pushes before the
    // panel is in the window leave its bar unlike its screens.)
    if (bs_pending_n > 0) {
        stack: []int = new int[bs_pending_n + 1](0);
        stack[0] = vc;
        for k in 0..bs_pending_n {
            beside_dress(bs_pending[k]);
            stack[k + 1] = bs_pending[k]
        }
        msg2(n, sel("setViewControllers:animated:"), nsarray(stack, bs_pending_n + 1),
            0)
    }
    bs_pending_n = 0;
    view: int = msg(n, sel("view"));
    msg1(view, sel("setBackgroundColor:"), c_panel_bg);
    // (A group of its own for VoiceOver and the keyboard's focus: §17.3.8.)
    msg1(view, sel("setShouldGroupAccessibilityChildren:"), 1);
    msg1(view, sel("setAccessibilityLabel:"), nsstring(w_beside));
    msg1(view, sel("setAccessibilityContainerType:"), 4);
    msg1(view, sel("setFocusGroupIdentifier:"), nsstring("beside"));
    msg1(msg(nav, sel("view")), sel("setFocusGroupIdentifier:"), nsstring("page"));
    note("bible: beside: made");
    beside_head_refresh();
    panel_show();
    layout_bar();
    if (tray_shown) update_tray();
    if (bs_shown) _a: int = UIAccessibilityPostNotification(objc_const("UIAccessibilityScreenChangedNotification"),
        msg(bs_nav, sel("view")))
}

// The reader's bar made for the panel's stack as it is now (made, or
// made again).
beside_head_refresh() {
    if (bs_nav == 0) return;
    for k in 0..UK_SLOTS {
        if (uk_vcs[k] != 0 && is_panel_reader(uk_tables[k]) && msg(uk_vcs[k], sel("navigationController")) == bs_nav && uk_ensure(k)) {
            beside_reader_dress(k, uk_vcs[k]);
            return
        }
    }
    beside_toolbar_sync(false)
}

// Core's panel made again while it is (what it reads changed, Swap Panes):
// its stack starts over at slot k's screen, the screens it had let go with
// their slots.
beside_restack(k: int) {
    old: []int = new int[UK_SLOTS](0);
    n: int = 0;
    for j in 0..UK_SLOTS {
        if (j != k && uk_vcs[j] != 0 && msg(uk_vcs[j], sel("navigationController")) == bs_nav) {
            old[n] = j;
            n = n + 1
        }
    }
    vc: int = uk_vcs[k];
    beside_dress(vc);
    stack: []int = new int[1](vc);
    // (Not shown as a way back to its first: the old stack wasn't let go
    // by a hand.)
    bs_depth = 0;
    msg2(bs_nav, sel("setViewControllers:animated:"), nsarray(stack, 1), 0);
    // (Its bar, the same title and items, laid out with the new screen's
    // now, so that it isn't drawn empty while the new screen is made. Only
    // the bar: the screen itself comes into sight as UIKit lays it out,
    // after core's lines for it, its place among them.)
    msg(msg(bs_nav, sel("navigationBar")), sel("layoutIfNeeded"));
    for j in 0..n uk_free(old[j]);
    bs_restacking = true;
    beside_toolbar_sync(false)
}

// A screen of core's in the panel (not its reader, which has a bar of its
// own: beside_reader_dress): its buttons in the panel's toolbar, Study's
// segments fitted between them, its edges as a sheet's; in a column, its
// close at the right (a sheet is put away by its swipe, the page's panel
// button or Close Panel: a close there would leave a screen's title no
// room beside Back).
beside_dress(vc: int) {
    sheet_edges(vc);
    if (beside_is_reader(vc)) return;
    item: int = msg(vc, sel("navigationItem"));
    old: int = msg(item, sel("rightBarButtonItem"));
    seg: int = msg(item, sel("titleView"));
    ours: bool = old == 0 || msg(old, sel("action")) == sel("besideClose:") || msg(old,
        sel("action")) == sel("closeSheet:");
    if (ours) {
        if (panel_as_column()) {
            one[0] = beside_close_item();
            msg2(item, sel("setRightBarButtonItems:animated:"), nsarray(one, 1), 0)
        } else msg2(item, sel("setRightBarButtonItems:animated:"), 0, 0)
    }
    // (Each segment as wide as its title, a point smaller, so Commentary
    // is whole.)
    if (seg != 0 && responds(seg, "setApportionsSegmentWidthsByContent:")) {
        msg1(seg, sel("setApportionsSegmentWidthsByContent:"), 1);
        keys[0] = k_font;
        values[0] = sans(12.5f64, 0.0f64);
        msg2(seg, sel("setTitleTextAttributes:forState:"), nsdictionary(keys, values,
            1), 0);
        values[0] = sans(12.5f64, 0.23f64);
        msg2(seg, sel("setTitleTextAttributes:forState:"), nsdictionary(keys, values,
            1), 4);
        msg_rect(seg, sel("setFrame:"), 0.0f64, 0.0f64, 262.0f64, 32.0f64)
    }
}

// Whether the page's panel button is lit: the panel wanted open (at once,
// before it is laid out and shown).
beside_lit(): bool {
    bs_open
}

// Whether vc is the panel's reader's screen.
beside_is_reader(vc: int): bool {
    if (vc == 0) return false;
    for k in 0..UK_SLOTS
        if (uk_vcs[k] == vc) return is_panel_reader(uk_tables[k]);
    false
}

// The panel's toolbar shown with a screen that has buttons there.
beside_toolbar_sync(animated: bool) {
    if (bs_nav == 0) return;
    top: int = msg(bs_nav, sel("topViewController"));
    tools: int = if (top == 0) 0 else msg(top, sel("toolbarItems"));
    hidden: int = if (tools != 0 && msg(tools, sel("count")) > 0) 0 else 1;
    if ((msg(bs_nav, sel("isToolbarHidden")) & 255) != hidden) msg2(bs_nav, sel("setToolbarHidden:animated:"),
        hidden, if (animated) 1 else 0);
    panel_fade_place()
}

// The panel's navigation shows vc next: its toolbar. Study pushed onto the
// sheet at its small height raises it to medium, with the push (at small,
// Study's bars leave too little of a verse's words to read); going back
// never lowers it again: only a hand or a command changes the sheet's
// height.
beside_will_show(
    _self: int,
    _cmd: int,
    _nav: int,
    vc: int,
    animated: int
): int {
    beside_toolbar_sync((animated & 255) != 0);
    if (panel_is_sheet() && panel_detent_rank(panel_detent_now()) == panel_detent_rank(PanelDetent.Small) && uk_vc_kind(vc) == SCR_VERSE_STUDY) {
        note("bible: panel: Study pushed at small: the sheet raised to medium");
        panel_select_detent(PanelDetent.Medium)
    }
    0
}

// The kind of core's screen vc (-1: not core's).
uk_vc_kind(vc: int): int {
    if (vc == 0) return -1;
    for k in 0..UK_SLOTS
        if (uk_vcs[k] == vc) return uk_kind_of(uk_ids[k]);
    -1
}

// Every screen of the panel's dressed again (its home changed, or Full
// Screen).
beside_dress_all() {
    if (bs_nav == 0) return;
    vcs: int = msg(bs_nav, sel("viewControllers"));
    for i in 0..msg(vcs, sel("count")) beside_dress(msg1(vcs, sel("objectAtIndex:"),
        i))
}

// The panel's close (where a sheet's screen has Done).
beside_close_item(): int {
    close: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol("xmark", 15.0f64, 5, 0), 0, app_obj, sel("besideClose:")), sel("autorelease"));
    msg1(close, sel("setAccessibilityLabel:"), nsstring(w_close_beside));
    close
}

// Whether slot k's screen is one of the panel's.
uk_in_panel(k: int): bool {
    slot: int = uk_wire_slot(uk_ids[k]);
    slot >= 0 && uk_wire_groups[slot] == 1
}

// A screen core pushed on the panel's (its group 1): on its navigation
// controller, or kept to be once it is made.
beside_push(vc: int) {
    if (bs_nav == 0) {
        if (bs_pending_n < len(bs_pending)) {
            bs_pending[bs_pending_n] = vc;
            bs_pending_n = bs_pending_n + 1
        }
        return
    }
    beside_dress(vc);
    if (bs_shown && !bs_restacking) {
        msg2(bs_nav, sel("pushViewController:animated:"), vc, 1);
        return
    }
    // (Not in the window yet, or its stack made again: its stack set, not
    // pushed.)
    msg2(bs_nav, sel("setViewControllers:animated:"), msg1(msg(bs_nav, sel("viewControllers")),
        sel("arrayByAddingObject:"), vc), 0);
    beside_head_refresh()
}

// The panel in the theme's colors now (a theme chosen while it shows).
beside_restyle() {
    if (panel_rule != 0) msg1(panel_rule, sel("setBackgroundColor:"), c_divider);
    if (win_table[PANE_PANEL] != 0) msg1(win_table[PANE_PANEL], sel("setBackgroundColor:"),
        c_panel_bg);
    if (bs_nav == 0) return;
    msg1(msg(bs_nav, sel("view")), sel("setBackgroundColor:"), c_panel_bg);
    beside_head_refresh()
}

// Its stack let go (closed, or a Study sheet opened in its place).
beside_discard() {
    if (bs_nav == 0) return;
    panel_detach_column();
    release(bs_nav);
    uk_panel_gone(bs_nav);
    bs_nav = 0;
    bs_depth = 0;
    bs_making = false;
    // (The reader's title was its bar's: made again with the next.)
    bs_head = held(bs_head, 0)
}

// `beside OPEN FULL`, core's: at launch, as it was left (open once the
// reader is at its place); after, opened or closed, filling the screen or
// not.
beside_line(open: bool, full: bool) {
    changed: bool = full != bs_full;
    // (Beside the page again: the page leads, so that following moves only
    // the panel and the page stays where it was; unless the panel was read
    // on while it filled the screen, which the page then follows.)
    if (bs_full && !full) win_leader = (if (win_full_read_on) PANE_PANEL else PANE_PAGE);
    if (!bs_full && full) win_full_read_on = false;
    bs_full = full;
    // (Its words a little smaller than the page's at every height: a sheet
    // moved by a hand isn't laid out again as it goes.)
    _rescaled: bool = panel_look_scaled(PANEL_TEXT_BESIDE);
    if (!restored) {
        bs_open = open;
        return
    }
    if (!open) {
        beside_close();
        return
    }
    if (!bs_open) {
        beside_open();
        return
    }
    if (changed) {
        // (Go back's capsule is the Bible's: away while the panel fills
        // the screen.)
        if (bs_full) hide_back();
        beside_dress_all();
        panel_full_changed();
        layout_bar();
        if (tray_shown) update_tray()
    }
}

// The reader at its place the first time: core told the panel fits (a
// sheet or a column, always), and whether it may fill the screen; the
// panel opened, if it was left open.
beside_restored() {
    send1("panelfits", 1);
    panel_tell_fill();
    if (bs_open) root_relayout()
}

// Opened: its screens asked for, or shown again (its screens kept while it
// went away).
beside_open() {
    bs_open = true;
    layout_bar();
    if (bs_nav == 0) beside_build() else panel_show()
}

// Closed (its close, the bar's panel button, ⌥⌘I, a swipe; core answering
// `panelmake` with nothing to show).
beside_close() {
    if (!bs_open) return;
    bs_open = false;
    bs_making = false;
    panel_hide();
    layout_bar();
    if (tray_shown) update_tray();
    note("bible: beside: closed");
    // (VoiceOver back to the page.)
    tv: int = current_view();
    if (tv != 0) _a: int = UIAccessibilityPostNotification(objc_const("UIAccessibilityScreenChangedNotification"),
        tv)
}

// The bar's panel button: core opens or closes the panel, or opens Go To
// aimed at it (the reader's place told first: a commentary opens at it).
beside_button(_self: int, _cmd: int, _b: int): int {
    place_tell();
    to_core_str("tap shelf");
    to_core_end();
    0
}

// Its close: core told (it says `beside 0`).
beside_close_tapped(_self: int, _cmd: int, _b: int): int {
    to_core_str("tap shelf");
    to_core_end();
    0
}

// Full Screen: core told (the reader's place first: the panel beside it
// again follows it from there).
beside_full_tapped(_self: int, _cmd: int, _b: int): int {
    place_tell();
    to_core_str("tap full");
    to_core_end();
    0
}

// The panel's own chevrons moved Study (the page stays where it is).
beside_moved(_c: int, _v: int) { }

// A push in the panel: its screen's edges as a sheet's.
beside_pushed(
    self: int,
    cmd: int,
    vc: int,
    animated: int
): int {
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(bs_class) };
    msg_super2(&sup, cmd, vc, animated);
    sheet_edges(vc);
    0
}

// How many screens the panel showed last (its stack's depth).
bs_depth: int = 0;

// A screen of the panel's shown: back to it (the stack shorter than
// before), core told which, so that it lets those above go; a push, or the
// panel coming into the window, tells nothing (core made those screens).
beside_did_show(
    _self: int,
    _cmd: int,
    nav: int,
    vc: int,
    _animated: int
): int {
    depth: int = msg(msg(nav, sel("viewControllers")), sel("count"));
    back: bool = depth < bs_depth;
    bs_depth = depth;
    if (!back) return 0;
    for k in 0..UK_SLOTS {
        if (uk_vcs[k] != 0 && uk_vcs[k] == vc) {
            note_num("bible: beside: shows ", uk_ids[k]);
            to_core_str("panelanchor ");
            to_core_int(uk_ids[k]);
            to_core_end();
            return 0
        }
    }
    0
}

// ---- the panel's reader's bar ----
// UIKit's navigation bar, never large, its title the one the page's bar
// has (the chapter with its chevron, what is read small and faint under
// it; a tap is Go To aimed at the panel), Link at its left and the menu at
// its right as plain glyphs. The bar is opaque in the panel's color with a
// short fade below it, as the page's bar is, so that a line going under it
// softens away and nothing is legible behind its title.
beside_reader_dress(k: int, vc: int) {
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    msg2(vc, sel("setToolbarItems:animated:"), 0, 0);
    msg1(vc, sel("setTitle:"), uk_text(uk_ui.left));
    panel_title_make();
    beside_title_fill(k);
    panel_title_layout();
    if (msg(item, sel("titleView")) != bs_head) msg1(item, sel("setTitleView:"), bs_head);
    // (The same two items on every reader screen, moved to this one's bar
    // and changed in place: Swap Panes makes a new screen, and the bar's
    // glyphs aren't taken away and put back as it is dressed again.)
    left: int = 0;
    right: int = 0;
    for j in 0..uk_ui.tools_n {
        tool: UiTool = uk_ui.tools[j];
        if (tool.icon.n == 0)
            continue;
        if (tool.menu.n > 0 && right == 0) right = panel_bar_glyph(k, j, tool, panel_menu_item) else if (tool.menu.n == 0 && left == 0) left = panel_bar_glyph(k,
            j, tool, panel_link_item)
    }
    if (left != 0) panel_link_item = held(panel_link_item, left);
    if (right != 0) panel_menu_item = held(panel_menu_item, right);
    if (msg(item, sel("leftBarButtonItem")) != left) msg2(item, sel("setLeftBarButtonItems:animated:"),
        panel_items(left), 0);
    if (msg(item, sel("rightBarButtonItem")) != right) msg2(item, sel("setRightBarButtonItems:animated:"),
        panel_items(right), 0);
    panel_reader_bar_look(item, uk_tables[k]);
    beside_toolbar_sync(false)
}

// The reader's Link and menu items, kept for its next screen.
panel_link_item: int = 0;

panel_menu_item: int = 0;

panel_items(b: int): int {
    if (b == 0) return 0;
    one[0] = b;
    nsarray(one, 1)
}

panel_reader_bar_look(item: int, t: int) {
    if (t != 0) msg1(msg(t, sel("topEdgeEffect")), sel("setHidden:"), 1);
    look: int = msg(make("UINavigationBarAppearance"), sel("autorelease"));
    msg(look, sel("configureWithOpaqueBackground"));
    msg1(look, sel("setBackgroundColor:"), c_panel_bg);
    msg1(look, sel("setShadowColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(item, sel("setStandardAppearance:"), look);
    msg1(item, sel("setScrollEdgeAppearance:"), look);
    msg1(item, sel("setCompactAppearance:"), look);
    msg1(item, sel("setCompactScrollEdgeAppearance:"), look);
    panel_fade_place()
}

// The fade under the reader's bar: the panel's color whole for
// BS_HEAD_SOLID points below the bar, then easing out over BAR_FADE (as the
// page's bar's, bar.l8's fade_set), over the reader's words; shown while
// the reader is the panel's top screen, placed as the panel lays out.
panel_fade: int = 0;

panel_fade_gradient: int = 0;

panel_fade_place() {
    if (bs_nav == 0) return;
    view: int = msg(bs_nav, sel("view"));
    if (panel_fade == 0) {
        panel_fade = keep(make("UIView"));
        msg1(panel_fade, sel("setUserInteractionEnabled:"), 0);
        msg1(panel_fade, sel("setIsAccessibilityElement:"), 0);
        msg1(panel_fade, sel("setAutoresizingMask:"), 0);
        panel_fade_gradient = keep(make("CAGradientLayer"));
        msg1(msg(panel_fade, sel("layer")), sel("addSublayer:"), panel_fade_gradient)
    }
    if (msg(panel_fade, sel("superview")) != view) msg1(view, sel("addSubview:"),
        panel_fade);
    shown: bool = beside_is_reader(msg(bs_nav, sel("topViewController")));
    msg(cls("CATransaction"), sel("begin"));
    msg1(cls("CATransaction"), sel("setDisableActions:"), 1);
    msg1(panel_fade, sel("setHidden:"), if (shown) 0 else 1);
    if (shown) {
        l8_msg_hfa(hfa, msg(bs_nav, sel("navigationBar")), sel("frame"), 0, 0, 0);
        top: f64 = hfa[1] + hfa[3];
        h: f64 = BS_HEAD_SOLID + BAR_FADE;
        w: f64 = view_width(view);
        msg_rect(panel_fade, sel("setFrame:"), 0.0f64, top, w, h);
        msg_rect(panel_fade_gradient, sel("setFrame:"), 0.0f64, 0.0f64, w, h);
        fade_set(panel_fade_gradient, c_panel_bg, BS_HEAD_SOLID / h, false);
        msg1(view, sel("bringSubviewToFront:"), panel_fade)
    }
    msg(cls("CATransaction"), sel("commit"))
}

// Tool j of slot k as a bar item (item, made if 0): a glyph, no fill (no
// shared glass behind it); Link in the accent while linked; the menu's
// items core's, opening on a tap.
panel_bar_glyph(
    k: int,
    j: int,
    tool: UiTool,
    item: int
): int {
    menu: bool = tool.menu.n > 0;
    on: bool = tool.style == UI_TOOL_PROMINENT;
    // (The menu's dots a weight heavier than the outlines: at one weight
    // they look lighter and smaller than the glyphs beside.)
    image: int = symbol_ns(uk_text(tool.icon), 17.0f64, if (menu) 6 else 4, 0);
    b: int = item;
    if (b == 0) b = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        image, 0, if (menu) 0 else app_obj, if (menu) 0 else sel("coreTool:")), sel("autorelease")) else msg1(b,
        sel("setImage:"), image);
    msg1(b, sel("setTintColor:"), if (on) c_accent else c_icon);
    msg1(b, sel("setTag:"), k * 16 + j);
    if (tool.label.n > 0) msg1(b, sel("setAccessibilityLabel:"), uk_text(tool.label));
    // (Lit by its color alone: a selected item is filled on iOS 26.)
    msg1(b, sel("setAccessibilityTraits:"), if (on) objc_const("UIAccessibilityTraitButton") | objc_const("UIAccessibilityTraitSelected") else objc_const("UIAccessibilityTraitButton"));
    if (menu) msg1(b, sel("setMenu:"), uk_tool_menu(k, j));
    msg1(b, sel("setHidesSharedBackground:"), 1);
    b
}

// The title's views, made once a panel: a box as tall as the bar, the
// chapter and its chevron in it, what is read under them, one button over
// both.
panel_title_make() {
    if (bs_head != 0) return;
    h: int = keep(make("UIView"));
    msg1(h, sel("setAutoresizingMask:"), 0);
    label: int = msg(make("UILabel"), sel("autorelease"));
    msg1(label, sel("setLineBreakMode:"), 4);
    msg1(label, sel("setIsAccessibilityElement:"), 0);
    msg1(h, sel("addSubview:"), label);
    bs_head_label = held(bs_head_label, label);
    chevron: int = msg(make("UIImageView"), sel("autorelease"));
    msg1(h, sel("addSubview:"), chevron);
    bs_head_chevron = held(bs_head_chevron, chevron);
    doc: int = msg(make("UILabel"), sel("autorelease"));
    msg1(doc, sel("setTextAlignment:"), 1);
    msg1(doc, sel("setLineBreakMode:"), 4);
    msg1(doc, sel("setIsAccessibilityElement:"), 0);
    msg1(doc, sel("setUserInteractionEnabled:"), 0);
    msg1(h, sel("addSubview:"), doc);
    bs_head_doc = held(bs_head_doc, doc);
    name: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    msg3(name, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreLeft:"),
        64);
    msg1(name, sel("setAccessibilityHint:"), nsstring("Chooses what to read beside the page"));
    hover(name);
    msg1(h, sel("addSubview:"), name);
    bs_head_name = held(bs_head_name, name);
    bs_head = h
}

// The title's words from slot k's screen (uk_ui): the chapter, what is read
// faint under it, the chevron; the button's tag the slot, its label both.
beside_title_fill(k: int) {
    msg1(bs_head_label, sel("setAttributedText:"), msg(msg2(msg(cls("NSAttributedString"),
        sel("alloc")), sel("initWithString:attributes:"), uk_text(uk_ui.title), title_attrs()),
        sel("autorelease")));
    msg1(bs_head_doc, sel("setFont:"), sans(11.5f64, 0.23f64));
    msg1(bs_head_doc, sel("setTextColor:"), c_faint);
    msg1(bs_head_doc, sel("setText:"), uk_text(uk_ui.left));
    msg1(bs_head_chevron, sel("setImage:"), symbol("chevron.down", 10.0f64, 7, c_faint));
    msg1(bs_head_name, sel("setTag:"), k);
    msg1(bs_head_name, sel("setAccessibilityLabel:"), if (uk_ui.title.n > 0) msg1(msg1(uk_text(uk_ui.title),
        sel("stringByAppendingString:"), nsstring(", ")), sel("stringByAppendingString:"),
        uk_text(uk_ui.left)) else uk_text(uk_ui.left))
}

// The title laid out in a box as wide as the bar leaves between its glyphs
// (two 56 point places), 44 high: the chapter a little above the middle,
// ended with "…" if it must be, the chevron 4 points after it, what is read
// under it, as the page's bar has them.
PANEL_TITLE_H: f64 = 44.0f64;

// The panel's width the title was laid out for.
panel_title_w: f64 = -1.0f64;

panel_title_layout() {
    if (bs_head == 0 || bs_nav == 0) return;
    panel_title_w = view_width(msg(bs_nav, sel("view")));
    room: f64 = panel_title_w - 2.0f64 * 56.0f64;
    if (room < 120.0f64) room = 120.0f64;
    msg(bs_head_label, sel("sizeToFit"));
    words_w: f64 = view_width(bs_head_label);
    msg(bs_head_chevron, sel("sizeToFit"));
    chevron_w: f64 = view_width(bs_head_chevron);
    chevron_h: f64 = view_height(bs_head_chevron);
    if (words_w > room - 4.0f64 - chevron_w) words_w = room - 4.0f64 - chevron_w;
    w: f64 = words_w + 4.0f64 + chevron_w;
    x0: f64 = (room - w) / 2.0f64;
    cy: f64 = PANEL_TITLE_H / 2.0f64;
    ty: f64 = cy - TITLE_LIFT;
    msg_rect(bs_head, sel("setFrame:"), 0.0f64, 0.0f64, room, PANEL_TITLE_H);
    msg_rect(bs_head_label, sel("setFrame:"), x0, ty - 12.0f64, words_w, 24.0f64);
    msg_rect(bs_head_chevron, sel("setFrame:"), x0 + words_w + 4.0f64, ty - chevron_h / 2.0f64 + 1.0f64,
        chevron_w, chevron_h);
    msg_rect(bs_head_doc, sel("setFrame:"), 0.0f64, cy + TITLE_DOC_DROP - 7.0f64,
        room, 14.0f64);
    msg_rect(bs_head_name, sel("setFrame:"), x0 - 8.0f64, 0.0f64, w + 16.0f64, PANEL_TITLE_H)
}

// The bar a document's arriving hairline runs along: the panel's
// navigation bar.
panel_arrive_bar(): int {
    if (bs_nav == 0) 0 else msg(bs_nav, sel("navigationBar"))
}

make_beside_classes() {
    bs_class = class_make(cls("UINavigationController"), "L8BesidePanel");
    add_method2(bs_class, sel("pushViewController:animated:"), &beside_pushed, "v@:@B");
    add_method3(bs_class, sel("navigationController:didShowViewController:animated:"),
        &beside_did_show, "v@:@@B");
    add_method3(bs_class, sel("navigationController:willShowViewController:animated:"),
        &beside_will_show, "v@:@@B");
    add_protocol(bs_class, "UINavigationControllerDelegate")
}

add_beside_methods(app: int) {
    add_method1(app, sel("besideFull:"), &beside_full_tapped, "v@:@");
    add_method1(app, sel("besideClose:"), &beside_close_tapped, "v@:@");
    add_method1(app, sel("besideButton:"), &beside_button, "v@:@")
}
