tag bible_ios;

use_tag std, ios, bible, bible_wire;

// The panel beside the page (core/beside.l8): what is read with the Bible
// (its reader: a version or a commentary following the page; Study over
// it), core's screens in a navigation controller of its own, kept while
// sheets come and go. On a wide window it is at the page's right,
// 390 points wide after a 1 point rule; elsewhere (an iPhone) it is under
// the page, its grabber dragged to make it taller or shorter, down to put
// it away, or up to fill the screen (as its button does). The root (ios/ipad.l8's L8Root) holds it as a second child;
// the page's place is kept as its size changes. The bar's panel button
// (and ⌥⌘I) opens or closes it (with nothing read there yet, core opens Go
// To aimed at the panel instead); core keeps whether it is open and what it
// shows (its `beside` line, at launch as it was left), and makes its
// screens when it opens (`panelmake`); its Back tells core what shows
// (`panelanchor`), its close and the grabber let it go (`closegroup 1`).
import "../../ios/objc.l8";

import "../core/text.l8";

// The panel's width beside the page (fixed: every screen of core's is laid
// out for it, §17.10 question 7), and the least column the page keeps
// beside it.
PANEL_W: f64 = 390.0f64;

PAGE_LEAST_EM: f64 = 28.0f64;

// Under the page: its share of the window's height (as the grabber leaves
// it), the least and most it is dragged to, below what a drag lets it go,
// and above what it fills the screen.
bs_share: f64 = 0.5f64;

BESIDE_SHARE_LEAST: f64 = 0.28f64;

BESIDE_SHARE_MOST: f64 = 0.86f64;

BESIDE_SHARE_GONE: f64 = 0.18f64;

BESIDE_SHARE_FULL: f64 = 0.92f64;

// Whether it is wanted open, and whether it fills the screen (core's to
// keep: told by its `beside` line).
bs_open: bool = false;

bs_full: bool = false;

// The grabber over the top of the panel under the page: the height of the
// strip that takes its drag (over the panel's bar, whose buttons sit
// lower), the pill 6 points down it.
STRIP_H: f64 = 14.0f64;

// The panel's reader's own bar (its navigation bar hidden): one row, the
// document's name at its left, Link and the menu at its right, the grabber
// in its top; a fade below it as tall as the page's bar's (bar.l8's
// BAR_FADE), so that words pass softly under it, never cut at its edge.
BS_HEAD_H: f64 = 48.0f64;

// Half the menu's glyph (an ellipsis at 17 points): its button centred
// that far in from the column's right edge.
BS_HEAD_GLYPH_HALF: f64 = 10.0f64;

// The soft edge at the page's foot, over the panel under it, as the top
// bar's over the page: from the divider up, the page's color whole for
// PAGE_FOOT_SOLID points, 60% at PAGE_FOOT_MID, gone at PAGE_FOOT_FADE, so
// that no letters of a heading show just above the divider.
PAGE_FOOT_FADE: f64 = 32.0f64;

PAGE_FOOT_SOLID: f64 = 10.0f64;

PAGE_FOOT_MID: f64 = 20.0f64;

// Its navigation controller while it is open (kept while a window is
// laid out without it), whether it is in the root now, and whether it and
// the page are one over the other (else it is at the page's right); the
// rule, the grabber, its class.
bs_nav: int = 0;

bs_shown: bool = false;

bs_under: bool = false;

bs_rule: int = 0;

bs_grabber: int = 0;

bs_class: int = 0;

// The page's soft foot (a gradient's view), and the reader's bar: its
// view, its name's button (over its words and chevron), the chapter
// after it, Link, the menu, and its color fading out below it.
bs_foot: int = 0;

bs_foot_gradient: int = 0;

bs_head: int = 0;

bs_head_name: int = 0;

bs_head_label: int = 0;

bs_head_chevron: int = 0;

bs_head_chapter: int = 0;

bs_head_link: int = 0;

bs_head_menu: int = 0;

bs_head_gradient: int = 0;

// Its height under the page (0: at its right, or away).
bs_under_h: f64 = 0.0f64;

// The page's height over the panel as last laid out.
bs_page_h: f64 = 0.0f64;

// Screens core pushed on the panel's while its navigation controller is
// being made (`panelmake`'s), pushed once it is.
bs_pending: []int = new int[8](0);

bs_pending_n: int = 0;

// Whether the panel's stack is being made again (core's `panel` with the
// panel shown: what it reads changed): those core pushes with it go on at
// once, not sliding in.
bs_restacking: bool = false;

// Whether a wide window has room for the panel at the page's right: the
// page beside 390 points still a column of 28 em with its margins.
beside_fits_in(W: f64): bool {
    if (!wide()) return false;
    W >= PANEL_W + 1.0f64 + 2.0f64 * look_margin + PAGE_LEAST_EM * em
}

beside_fits(): bool {
    if (root_vc == 0) return false;
    beside_fits_in(view_width(msg(root_vc, sel("view"))))
}

// Whether the root lays the panel out now: open, and made.
beside_wanted(_W: f64): bool {
    bs_open && restored && bs_nav != 0
}

// Its screens asked for if it is wanted open and not made yet (the root
// laying out).
beside_ensure() {
    if (bs_open && restored && bs_nav == 0) beside_build()
}

// The panel's height under the page in a window H high.
beside_height(H: f64): f64 {
    bs_share * H
}

// The root laid out again (the panel coming or going, the rule changing).
root_relayout() {
    if (root_vc == 0) return;
    view: int = msg(root_vc, sel("view"));
    msg(view, sel("setNeedsLayout"));
    msg(view, sel("layoutIfNeeded"))
}

// The page and the panel placed by the root in a window W by H: the Bible's
// view (nv) and the panel's; side by side where a column fits (the one
// beside 390 points wide), else one over the other, the strip between
// them. Filling the screen (bs_full), the panel has all of it, the Bible
// hidden under it.
beside_lay_out(nv: int, W: f64, H: f64) {
    on: bool = beside_wanted(W);
    full: bool = on && bs_full;
    right: bool = !full && beside_fits_in(W);
    beside_tell_fits(true);
    side_h: f64 = if (right) 0.0f64 else beside_height(H);
    under_h: f64 = if (on && !right && !full) side_h else 0.0f64;
    if (under_h != bs_under_h) {
        bs_under_h = under_h;
        tray_place_bottom();
        // (Go back's capsule kept at the page's foot.)
        if (back_text != 0) style_back()
    }
    // (Hidden under the panel filling the screen, once it has swept over.)
    msg1(nv, sel("setHidden:"), if (full && !bs_sweeping) 1 else 0);
    if (bs_foot != 0) msg1(bs_foot, sel("setHidden:"), if (on && !right && !full) 0 else 1);
    if (!on) {
        beside_frame(nv, 0.0f64, 0.0f64, W, H);
        if (bs_shown) {
            beside_detach();
            note("bible: beside: closed")
        }
        return
    }
    if (!bs_shown) beside_attach();
    panel: int = msg(bs_nav, sel("view"));
    bs_under = !right;
    // (Filling the screen, the strip and the rule just off it, above the
    // panel's top (the rule at its left, on a wide window): they ride the
    // panel's edge as it sweeps, and are hidden once it has.)
    away: bool = full && !bs_sweeping;
    fits: bool = beside_fits_in(W);
    msg1(bs_grabber, sel("setHidden:"), if (fits || away) 1 else 0);
    msg1(bs_rule, sel("setHidden:"), if (away) 1 else 0);
    if (full) {
        if (fits) msg_rect(bs_rule, sel("setFrame:"), -1.0f64, 0.0f64, 1.0f64, H) else {
            msg_rect(bs_grabber, sel("setFrame:"), 0.0f64, 0.0f64 - STRIP_H, W, STRIP_H);
            msg_rect(bs_rule, sel("setFrame:"), 0.0f64, 0.0f64 - STRIP_H, W, 0.5f64)
        }
        beside_frame(panel, 0.0f64, 0.0f64, W, H);
        beside_head_layout();
        return
    }
    if (right) {
        x: f64 = W - PANEL_W - 1.0f64;
        beside_frame(nv, 0.0f64, 0.0f64, x, H);
        msg_rect(bs_rule, sel("setFrame:"), x, 0.0f64, 1.0f64, H);
        beside_frame(panel, x + 1.0f64, 0.0f64, PANEL_W, H)
    } else {
        // (One hairline between them, the page's words fading into it
        // above, the grabber over the panel's top below.)
        y: f64 = H - side_h;
        beside_frame(nv, 0.0f64, 0.0f64, W, y);
        if (y != bs_page_h) {
            bs_page_h = y;
            win_page_moved_alone()
        }
        beside_foot_place(nv, W, y);
        msg_rect(bs_grabber, sel("setFrame:"), 0.0f64, y, W, STRIP_H);
        msg_rect(bs_rule, sel("setFrame:"), 0.0f64, y, W, 0.5f64);
        beside_frame(panel, 0.0f64, y, W, side_h);
        msg1(msg(root_vc, sel("view")), sel("bringSubviewToFront:"), bs_grabber)
    }
    beside_head_layout();
    msg1(msg(root_vc, sel("view")), sel("bringSubviewToFront:"), bs_rule)
}

// The page's soft foot: the last PAGE_FOOT_FADE points above the panel
// (its top at y in a window W wide) fading into the page's color (the
// page's paper, not the panel's tint), as the top bar's lowest points do,
// so that a line half under the panel's edge isn't cut hard. Just over the
// page's view nv (under the tray, the way back's capsule and the panel);
// it takes no touches.
beside_foot_place(nv: int, W: f64, y: f64) {
    root: int = msg(root_vc, sel("view"));
    if (bs_foot == 0) {
        bs_foot = keep(make("UIView"));
        msg1(bs_foot, sel("setUserInteractionEnabled:"), 0);
        msg1(bs_foot, sel("setAutoresizingMask:"), 0);
        msg1(bs_foot, sel("setIsAccessibilityElement:"), 0);
        bs_foot_gradient = keep(make("CAGradientLayer"));
        msg1(msg(bs_foot, sel("layer")), sel("addSublayer:"), bs_foot_gradient)
    }
    if (msg(bs_foot, sel("superview")) != root) msg2(root, sel("insertSubview:aboveSubview:"),
        bs_foot, nv);
    msg(cls("CATransaction"), sel("begin"));
    msg1(cls("CATransaction"), sel("setDisableActions:"), 1);
    msg_rect(bs_foot, sel("setFrame:"), 0.0f64, y - PAGE_FOOT_FADE, W, PAGE_FOOT_FADE);
    msg_rect(bs_foot_gradient, sel("setFrame:"), 0.0f64, 0.0f64, W, PAGE_FOOT_FADE);
    one[0] = msg(msg_set_f(c_bg, sel("colorWithAlphaComponent:"), 0.0f64), sel("CGColor"));
    one[1] = msg(msg_set_f(c_bg, sel("colorWithAlphaComponent:"), 0.6f64), sel("CGColor"));
    one[2] = msg(c_bg, sel("CGColor"));
    one[3] = one[2];
    msg1(bs_foot_gradient, sel("setColors:"), nsarray(one, 4));
    one[0] = nsnumber_f(0.0f64);
    one[1] = nsnumber_f((PAGE_FOOT_FADE - PAGE_FOOT_MID) / PAGE_FOOT_FADE);
    one[2] = nsnumber_f((PAGE_FOOT_FADE - PAGE_FOOT_SOLID) / PAGE_FOOT_FADE);
    one[3] = nsnumber_f(1.0f64);
    msg1(bs_foot_gradient, sel("setLocations:"), nsarray(one, 4));
    msg(cls("CATransaction"), sel("commit"))
}

// View v's frame set, if it changed (the Bible's page measured first where
// its width changes: ios/ipad.l8's root_place).
beside_frame(
    v: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64
) {
    l8_msg_hfa(hfa, v, sel("frame"), 0, 0, 0);
    if (hfa[0] == x && hfa[1] == y && hfa[2] == w && hfa[3] == h) return;
    msg_rect(v, sel("setFrame:"), x, y, w, h)
}

// The Bible's page's width as the root lays it out (W by H).
beside_page_width(W: f64): f64 {
    if (!beside_wanted(W) || bs_full || !beside_fits_in(W)) return W;
    W - PANEL_W - 1.0f64
}

// The panel's screens asked of core (once, until its first comes: core's
// lines may be read later, the skin reading others now).
bs_making: bool = false;

beside_build() {
    if (bs_making) return;
    bs_making = true;
    uk_nav = 0;
    uk_panel_slot = -1;
    bs_pending_n = 0;
    to_core_str("panelmake");
    to_core_end();
    uk_effects()
}

// Core's `panel`: its first screen made (slot k), the panel made round it
// (those core pushes after it go on it), and laid out.
beside_made(k: int) {
    if (k < 0) return;
    if (!bs_making && bs_nav != 0) {
        beside_restack(k);
        return
    }
    if (!bs_making || bs_nav != 0) return;
    bs_making = false;
    win_panel_opening = true;
    vc: int = uk_vcs[k];
    beside_dress(vc);
    n: int = msg1(msg(bs_class, sel("alloc")), sel("initWithRootViewController:"),
        vc);
    bs_nav = n;
    msg1(n, sel("setDelegate:"), n);
    msg1(msg(n, sel("toolbar")), sel("setTintColor:"), c_icon);
    // (Those core pushed after it, its stack at once: pushes before the
    // panel is in the window leave its bar unlike its screens.)
    if (bs_pending_n > 0) {
        stack: []int = new int[bs_pending_n + 1](0);
        stack[0] = vc;
        for k in 0..bs_pending_n {
            beside_dress(bs_pending[k]);
            stack[k + 1] = bs_pending[k]
        }
        msg2(n, sel("setViewControllers:animated:"), nsarray(stack, bs_pending_n + 1),
            0)
    }
    bs_pending_n = 0;
    view: int = msg(n, sel("view"));
    msg1(view, sel("setAutoresizingMask:"), 0);
    msg1(view, sel("setBackgroundColor:"), c_panel_bg);
    // (A group of its own for VoiceOver and the keyboard's focus: §17.3.8.)
    msg1(view, sel("setShouldGroupAccessibilityChildren:"), 1);
    msg1(view, sel("setAccessibilityLabel:"), nsstring(w_beside));
    if (responds(view, "setAccessibilityContainerType:")) msg1(view, sel("setAccessibilityContainerType:"),
        4);
    if (responds(view, "setFocusGroupIdentifier:")) {
        msg1(view, sel("setFocusGroupIdentifier:"), nsstring("beside"));
        msg1(msg(nav, sel("view")), sel("setFocusGroupIdentifier:"), nsstring("page"))
    }
    if (bs_rule == 0) {
        bs_rule = keep(make("UIView"));
        msg1(bs_rule, sel("setAutoresizingMask:"), 0)
    }
    msg1(bs_rule, sel("setBackgroundColor:"), c_divider);
    beside_make_grabber();
    note("bible: beside: made");
    beside_motion(true);
    root_relayout();
    if (bs_shown) {
        beside_motion_after(true);
        _a: int = UIAccessibilityPostNotification(objc_const("UIAccessibilityScreenChangedNotification"),
            msg(bs_nav, sel("view")))
    }
    layout_bar();
    if (tray_shown) update_tray();
    beside_head_refresh()
}

// The reader's bar made for the panel's stack as it is now (made, or
// made again), shown if the reader is on top.
beside_head_refresh() {
    if (bs_nav == 0) return;
    for k in 0..UK_SLOTS {
        if (uk_vcs[k] != 0 && is_panel_reader(uk_tables[k]) && msg(uk_vcs[k], sel("navigationController")) == bs_nav && uk_ensure(k)) {
            beside_reader_dress(k, uk_vcs[k]);
            return
        }
    }
    beside_head_sync(false)
}

// Core's panel made again while it is (what it reads changed, Swap Panes):
// its stack starts over at slot k's screen, the screens it had let go with
// their slots.
beside_restack(k: int) {
    old: []int = new int[UK_SLOTS](0);
    n: int = 0;
    for j in 0..UK_SLOTS {
        if (j != k && uk_vcs[j] != 0 && msg(uk_vcs[j], sel("navigationController")) == bs_nav) {
            old[n] = j;
            n = n + 1
        }
    }
    vc: int = uk_vcs[k];
    beside_dress(vc);
    stack: []int = new int[1](vc);
    // (Not shown as a way back to its first: the old stack wasn't let go
    // by a hand.)
    bs_depth = 0;
    msg2(bs_nav, sel("setViewControllers:animated:"), nsarray(stack, 1), 0);
    for j in 0..n uk_free(old[j]);
    bs_restacking = true;
    beside_head_sync(false)
}

// A screen of core's in the panel: its close at the right (unless its bar
// has a button there), Study's segments fitted between its buttons, its
// edges as a sheet's. The panel's reader has a bar of its own
// (beside_reader_dress).
beside_dress(vc: int) {
    sheet_edges(vc);
    if (beside_is_reader(vc)) return;
    item: int = msg(vc, sel("navigationItem"));
    // (Buttons made for its foot before it was the panel's (a screen made
    // as the panel is restored): in its header, after Back, as the panel's
    // screens have them.)
    tools: int = msg(vc, sel("toolbarItems"));
    if (tools != 0 && msg(tools, sel("count")) > 0) {
        m: int = 0;
        for j in 0..msg(tools, sel("count")) {
            t: int = msg1(tools, sel("objectAtIndex:"), j);
            if (m < len(items) && (msg(t, sel("customView")) != 0 || msg(t, sel("image")) != 0 || msg(t,
                sel("title")) != 0)) {
                items[m] = t;
                m = m + 1
            }
        }
        msg1(item, sel("setLeftItemsSupplementBackButton:"), 1);
        msg2(item, sel("setLeftBarButtonItems:animated:"), nsarray(items, m), 0);
        msg2(vc, sel("setToolbarItems:animated:"), 0, 0)
    }
    // (Its close, then Full Screen; Study's segments, between its buttons,
    // need the room, so it has only its close.)
    old: int = msg(item, sel("rightBarButtonItem"));
    seg: int = msg(item, sel("titleView"));
    ours: bool = old == 0 || msg(old, sel("action")) == sel("besideClose:") || msg(old,
        sel("action")) == sel("closeSheet:");
    if (ours && seg != 0) {
        items[0] = beside_close_item();
        msg2(item, sel("setRightBarButtonItems:animated:"), nsarray(items, 1), 0)
    } else if (ours) {
        items[0] = beside_close_item();
        items[1] = (if (bs_full) beside_item("arrow.down.right.and.arrow.up.left",
            "besideFull:", w_unfull_beside) else beside_item("arrow.up.left.and.arrow.down.right",
            "besideFull:", w_full_beside));
        msg2(item, sel("setRightBarButtonItems:animated:"), nsarray(items, 2), 0)
    }
    // (Each segment as wide as its title, a point smaller, so Commentary
    // is whole.)
    if (seg != 0 && responds(seg, "setApportionsSegmentWidthsByContent:")) {
        msg1(seg, sel("setApportionsSegmentWidthsByContent:"), 1);
        keys[0] = k_font;
        values[0] = sans(12.5f64, 0.0f64);
        msg2(seg, sel("setTitleTextAttributes:forState:"), nsdictionary(keys, values,
            1), 0);
        values[0] = sans(12.5f64, 0.23f64);
        msg2(seg, sel("setTitleTextAttributes:forState:"), nsdictionary(keys, values,
            1), 4);
        msg_rect(seg, sel("setFrame:"), 0.0f64, 0.0f64, 262.0f64, 32.0f64)
    }
}

// Its bar's buttons.
items: []int = new int[2](0);

// ---- the panel's reader's bar ----
// The panel's reader shows no navigation bar: one row of its own (48
// points, the grabber over its top) holds core's `left` (the document's
// name, its tap Go To aimed at the panel), its title faint after it, a
// middot between ("Spurgeon · Psalm 147": the chapter, while it isn't the
// page's or the panel fills the screen), then a small chevron; and its
// tools as glyphs at the right, none filled: Link in the accent while
// linked, else faint; the menu (Swap Panes, Full Screen, Close Panel).

// Whether vc is the panel's reader's screen.
beside_is_reader(vc: int): bool {
    if (vc == 0) return false;
    for k in 0..UK_SLOTS
        if (uk_vcs[k] == vc) return is_panel_reader(uk_tables[k]);
    false
}

// Slot k's screen (the panel's reader, uk_ui its model) dressed: no
// buttons of the navigation bar's, its own bar filled, the reader's words
// under it.
beside_reader_dress(k: int, vc: int) {
    item: int = msg(vc, sel("navigationItem"));
    msg2(item, sel("setLeftBarButtonItems:animated:"), 0, 0);
    msg2(item, sel("setRightBarButtonItems:animated:"), 0, 0);
    msg2(vc, sel("setToolbarItems:animated:"), 0, 0);
    msg1(vc, sel("setTitle:"), uk_text(uk_ui.left));
    msg_rect(vc, sel("setAdditionalSafeAreaInsets:"), BS_HEAD_H, 0.0f64, 0.0f64, 0.0f64);
    beside_head_make();
    beside_head_fill(k);
    beside_head_sync(false)
}

// The bar's views, made once a panel (in its navigation controller's view,
// over its screens).
beside_head_make() {
    if (bs_nav == 0) return;
    view: int = msg(bs_nav, sel("view"));
    if (bs_head != 0 && msg(bs_head, sel("superview")) == view) return;
    if (bs_head != 0) {
        msg(bs_head, sel("removeFromSuperview"));
        bs_head = held(bs_head, 0)
    }
    h: int = keep(make("UIView"));
    msg1(h, sel("setAutoresizingMask:"), 0);
    bs_head_gradient = held(bs_head_gradient, make("CAGradientLayer"));
    msg1(msg(h, sel("layer")), sel("addSublayer:"), bs_head_gradient);
    // (Its name: the document's, the chapter after it, then a small
    // chevron, under a button as wide as all three whose tap is core's
    // left action.)
    label: int = msg(make("UILabel"), sel("autorelease"));
    msg1(label, sel("setLineBreakMode:"), 4);
    msg1(label, sel("setIsAccessibilityElement:"), 0);
    msg1(h, sel("addSubview:"), label);
    bs_head_label = held(bs_head_label, label);
    chevron: int = msg(make("UIImageView"), sel("autorelease"));
    msg1(h, sel("addSubview:"), chevron);
    bs_head_chevron = held(bs_head_chevron, chevron);
    name: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    msg3(name, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreLeft:"),
        64);
    msg1(name, sel("setAccessibilityHint:"), nsstring("Chooses what to read beside the page"));
    hover(name);
    msg1(h, sel("addSubview:"), name);
    bs_head_name = held(bs_head_name, name);
    chapter: int = msg(make("UILabel"), sel("autorelease"));
    msg1(chapter, sel("setIsAccessibilityElement:"), 0);
    msg1(h, sel("addSubview:"), chapter);
    bs_head_chapter = held(bs_head_chapter, chapter);
    bs_head_link = held(bs_head_link, beside_head_glyph(h));
    msg3(bs_head_link, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreTool:"),
        64);
    bs_head_menu = held(bs_head_menu, beside_head_glyph(h));
    msg1(bs_head_menu, sel("setShowsMenuAsPrimaryAction:"), 1);
    // (A drag on it moves the panel, as the grabber's does.)
    pan: int = msg(msg2(msg(cls("UIPanGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("besideDragged:")), sel("autorelease"));
    msg1(h, sel("addGestureRecognizer:"), pan);
    msg1(view, sel("addSubview:"), h);
    bs_head = h;
    beside_head_layout()
}

// A glyph's button of the bar: 44 points, no fill.
beside_head_glyph(h: int): int {
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    msg_rect(b, sel("setBounds:"), 0.0f64, 0.0f64, 44.0f64, 44.0f64);
    hover(b);
    msg1(h, sel("addSubview:"), b);
    b
}

// The bar filled from slot k's screen (uk_ui): its name, the chapter
// after it, Link and the menu (core's first two tools; each tagged k * 16
// + its index, as the toolbar's are).
beside_head_fill(k: int) {
    if (bs_head == 0) return;
    msg1(bs_head_label, sel("setFont:"), sans(17.0f64, 0.3f64));
    msg1(bs_head_label, sel("setTextColor:"), c_ink);
    msg1(bs_head_label, sel("setText:"), uk_text(uk_ui.left));
    msg1(bs_head_chevron, sel("setImage:"), symbol("chevron.down", 12.0f64, 6, c_faint));
    msg1(bs_head_name, sel("setTag:"), k);
    msg1(bs_head_name, sel("setAccessibilityLabel:"), if (uk_ui.title.n > 0) msg1(msg1(uk_text(uk_ui.left),
        sel("stringByAppendingString:"), nsstring(", ")), sel("stringByAppendingString:"),
        uk_text(uk_ui.title)) else uk_text(uk_ui.left));
    msg1(bs_head_chapter, sel("setFont:"), sans(15.0f64, 0.0f64));
    msg1(bs_head_chapter, sel("setTextColor:"), c_faint);
    msg1(bs_head_chapter, sel("setLineBreakMode:"), 4);
    // (A faint middot between the name and the chapter.)
    msg1(bs_head_chapter, sel("setText:"), if (uk_ui.title.n > 0) msg1(nsstring("\�\� "),
        sel("stringByAppendingString:"), uk_text(uk_ui.title)) else 0);
    msg1(bs_head_link, sel("setHidden:"), 1);
    msg1(bs_head_menu, sel("setHidden:"), 1);
    glyphs: int = 0;
    for j in 0..uk_ui.tools_n {
        tool: UiTool = uk_ui.tools[j];
        if (glyphs < 2 && tool.icon.n > 0) {
            b: int = if (tool.menu.n > 0) bs_head_menu else bs_head_link;
            on: bool = tool.style == UI_TOOL_PROMINENT;
            msg2(b, sel("setImage:forState:"), symbol_ns(uk_text(tool.icon), 17.0f64,
                4, 0), 0);
            msg1(b, sel("setTintColor:"), if (on) c_accent else if (tool.menu.n > 0) c_icon else c_faint);
            msg1(b, sel("setTag:"), k * 16 + j);
            if (tool.label.n > 0) msg1(b, sel("setAccessibilityLabel:"), uk_text(tool.label));
            msg1(b, sel("setAccessibilityTraits:"), if (on) objc_const("UIAccessibilityTraitButton") | objc_const("UIAccessibilityTraitSelected") else objc_const("UIAccessibilityTraitButton"));
            if (tool.menu.n > 0) msg1(b, sel("setMenu:"), uk_tool_menu(k, j));
            msg1(b, sel("setHidden:"), 0);
            glyphs = glyphs + 1
        }
    }
    msg(cls("CATransaction"), sel("begin"));
    msg1(cls("CATransaction"), sel("setDisableActions:"), 1);
    one[0] = msg(c_panel_bg, sel("CGColor"));
    one[1] = one[0];
    one[2] = msg(msg_set_f(c_panel_bg, sel("colorWithAlphaComponent:"), 0.0f64), sel("CGColor"));
    msg1(bs_head_gradient, sel("setColors:"), nsarray(one, 3));
    msg(cls("CATransaction"), sel("commit"));
    beside_head_layout()
}

// The bar placed at the panel's top (under the status bar where the panel
// is at the window's top): the name as wide as it needs up to the room
// the chapter and the glyphs leave, the chapter after it (at most half
// the room, cut at its end), then the chevron; nothing overlaps.
beside_head_layout() {
    if (bs_head == 0 || bs_nav == 0) return;
    view: int = msg(bs_nav, sel("view"));
    l8_msg_hfa(hfa, view, sel("safeAreaInsets"), 0, 0, 0);
    top: f64 = hfa[0];
    left: f64 = hfa[1];
    right: f64 = hfa[3];
    whole: f64 = view_width(view);
    W: f64 = whole - right;
    msg(cls("CATransaction"), sel("begin"));
    msg1(cls("CATransaction"), sel("setDisableActions:"), 1);
    // (From the panel's top, under the status bar too where the panel
    // fills the screen: no words show above it.)
    msg_rect(bs_head, sel("setFrame:"), 0.0f64, 0.0f64, whole, top + BS_HEAD_H);
    // (Its color to its foot, then a short fade below it, over the words'
    // first points: drawn past its bounds, which take no touches there.)
    msg_rect(bs_head_gradient, sel("setFrame:"), 0.0f64, 0.0f64, whole, top + BS_HEAD_H + BAR_FADE);
    one[0] = nsnumber_f(0.0f64);
    one[1] = nsnumber_f((top + BS_HEAD_H) / (top + BS_HEAD_H + BAR_FADE));
    one[2] = nsnumber_f(1.0f64);
    msg1(bs_head_gradient, sel("setLocations:"), nsarray(one, 3));
    // (The row's middle a little below the bar's, the grabber over it.
    // Its name's first letter on the reader's text column, the menu's
    // glyph's right edge on the column's right: the Margins setting's.)
    cy: f64 = top + 27.0f64;
    m: f64 = if (win_table[PANE_PANEL] != 0) win_margin(PANE_PANEL) else 20.0f64;
    x: f64 = W - m - BS_HEAD_GLYPH_HALF;
    for b in [bs_head_menu, bs_head_link] {
        if ((msg(b, sel("isHidden")) & 255) == 0) {
            msg_ff(b, sel("setCenter:"), x, cy);
            x = x - 44.0f64
        }
    }
    room: f64 = x + 22.0f64 - 4.0f64 - (left + m);
    chapter_w: f64 = 0.0f64;
    if (msg(bs_head_chapter, sel("text")) != 0) {
        msg(bs_head_chapter, sel("sizeToFit"));
        chapter_w = view_width(bs_head_chapter);
        if (chapter_w > room / 2.0f64) chapter_w = room / 2.0f64
    }
    // (The name as wide as the room leaves, cut at its end; the chapter 5
    // points after it; the chevron 5 points after them.)
    msg(bs_head_label, sel("sizeToFit"));
    name_w: f64 = view_width(bs_head_label);
    msg(bs_head_chevron, sel("sizeToFit"));
    chevron_w: f64 = view_width(bs_head_chevron);
    chevron_h: f64 = view_height(bs_head_chevron);
    most: f64 = room - 5.0f64 - chevron_w - (if (chapter_w > 0.0f64) chapter_w + 5.0f64 else 0.0f64);
    if (name_w > most) name_w = most;
    x0: f64 = left + m;
    msg_rect(bs_head_label, sel("setFrame:"), x0, cy - 12.0f64, name_w, 24.0f64);
    words_end: f64 = x0 + name_w;
    if (chapter_w > 0.0f64) {
        msg_rect(bs_head_chapter, sel("setFrame:"), words_end + 5.0f64, cy - 11.0f64,
            chapter_w, 22.0f64);
        words_end = words_end + 5.0f64 + chapter_w
    } else msg_rect(bs_head_chapter, sel("setFrame:"), words_end, cy - 11.0f64, 0.0f64,
        22.0f64);
    msg_rect(bs_head_chevron, sel("setFrame:"), words_end + 5.0f64, cy - chevron_h / 2.0f64 + 1.0f64,
        chevron_w, chevron_h);
    end: f64 = words_end + 5.0f64 + chevron_w;
    msg_rect(bs_head_name, sel("setFrame:"), x0 - 8.0f64, cy - 22.0f64, end - x0 + 16.0f64,
        44.0f64);
    msg1(view, sel("bringSubviewToFront:"), bs_head);
    msg(cls("CATransaction"), sel("commit"));
    // (A document arriving: its hairline along the row's foot.)
    arrive_place(1)
}

// The bar shown while the panel's top screen is its reader, with the
// navigation bar hidden; else that bar, and this one hidden.
beside_head_sync(animated: bool) {
    if (bs_nav == 0) return;
    reading: bool = beside_is_reader(msg(bs_nav, sel("topViewController")));
    hidden: bool = (msg(bs_nav, sel("isNavigationBarHidden")) & 255) != 0;
    if (hidden != reading) msg2(bs_nav, sel("setNavigationBarHidden:animated:"), if (reading) 1 else 0,
        if (animated) 1 else 0);
    if (bs_head == 0) return;
    was: bool = (msg(bs_head, sel("isHidden")) & 255) == 0;
    msg1(bs_head, sel("setHidden:"), if (reading) 0 else 1);
    if (reading && !was && animated) fade_layer(msg(bs_head, sel("layer")), 0.25f64);
    if (reading) beside_head_layout()
}

// The panel's navigation shows vc next: its bar, or the reader's own.
beside_will_show(
    _self: int,
    _cmd: int,
    _nav: int,
    _vc: int,
    animated: int
): int {
    beside_head_sync((animated & 255) != 0);
    0
}

beside_item(symbol_name: str, action: str, label: str): int {
    b: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol(symbol_name, 15.0f64, 5, 0), 0, app_obj, sel(action)), sel("autorelease"));
    msg1(b, sel("setAccessibilityLabel:"), nsstring(label));
    b
}

// Every screen of the panel's dressed again (filling the screen or not).
beside_dress_all() {
    if (bs_nav == 0) return;
    vcs: int = msg(bs_nav, sel("viewControllers"));
    for i in 0..msg(vcs, sel("count")) beside_dress(msg1(vcs, sel("objectAtIndex:"),
        i))
}

// The panel's close (where a sheet's screen has Done).
beside_close_item(): int {
    close: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol("xmark", 15.0f64, 5, 0), 0, app_obj, sel("besideClose:")), sel("autorelease"));
    msg1(close, sel("setAccessibilityLabel:"), nsstring(w_close_beside));
    close
}

// Whether slot k's screen is one of the panel's.
uk_in_panel(k: int): bool {
    slot: int = uk_wire_slot(uk_ids[k]);
    slot >= 0 && uk_wire_groups[slot] == 1
}

// A screen core pushed on the panel's (its group 1): on its navigation
// controller, or kept to be once it is made.
beside_push(vc: int) {
    if (bs_nav == 0) {
        if (bs_pending_n < len(bs_pending)) {
            bs_pending[bs_pending_n] = vc;
            bs_pending_n = bs_pending_n + 1
        }
        return
    }
    beside_dress(vc);
    if (bs_shown && !bs_restacking) {
        msg2(bs_nav, sel("pushViewController:animated:"), vc, 1);
        return
    }
    // (Not in the window yet, or its stack made again: its stack set, not
    // pushed.)
    msg2(bs_nav, sel("setViewControllers:animated:"), msg1(msg(bs_nav, sel("viewControllers")),
        sel("arrayByAddingObject:"), vc), 0);
    beside_head_refresh()
}

// The grabber at the top of the panel under the page: a drag makes it
// taller or shorter, puts it away, or makes it fill the screen.
beside_make_grabber() {
    if (bs_grabber != 0) return;
    // (A strip the width of the window, the grabber in its middle; it
    // takes the drag.)
    g: int = keep(make("UIView"));
    msg1(g, sel("setAutoresizingMask:"), 0);
    msg1(g, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    pill: int = msg(make("UIView"), sel("autorelease"));
    msg1(pill, sel("setBackgroundColor:"), c_grabber);
    msg1(pill, sel("setTag:"), BS_PILL_TAG);
    msg_set_f(msg(pill, sel("layer")), sel("setCornerRadius:"), 2.5f64);
    msg_rect(pill, sel("setFrame:"), 0.0f64, 6.0f64, 36.0f64, 5.0f64);
    // (Kept in the middle as the strip's width changes.)
    msg1(pill, sel("setAutoresizingMask:"), 5);
    msg1(g, sel("addSubview:"), pill);
    msg1(g, sel("setIsAccessibilityElement:"), 0);
    bs_grabber = g;
    pan: int = msg(msg2(msg(cls("UIPanGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("besideDragged:")), sel("autorelease"));
    msg1(g, sel("addGestureRecognizer:"), pan)
}

BS_PILL_TAG: int = 9501;

// The panel in the theme's colors now (a theme chosen while it shows): its
// background, the hairline, the grabber, the reader's bar and words.
beside_restyle() {
    if (bs_rule != 0) msg1(bs_rule, sel("setBackgroundColor:"), c_divider);
    if (bs_grabber != 0) {
        pill: int = msg1(bs_grabber, sel("viewWithTag:"), BS_PILL_TAG);
        if (pill != 0) msg1(pill, sel("setBackgroundColor:"), c_grabber)
    }
    if (win_table[PANE_PANEL] != 0) msg1(win_table[PANE_PANEL], sel("setBackgroundColor:"),
        c_panel_bg);
    if (bs_nav == 0) return;
    msg1(msg(bs_nav, sel("view")), sel("setBackgroundColor:"), c_panel_bg);
    beside_head_refresh()
}

// The share it had as the drag began.
bs_drag_from: f64 = 0.5f64;

beside_dragged(_self: int, _cmd: int, pan: int): int {
    if (!bs_under || root_vc == 0) return 0;
    view: int = msg(root_vc, sel("view"));
    H: f64 = view_height(view);
    if (H <= 0.0f64) return 0;
    state: int = msg(pan, sel("state"));
    l8_msg_hfa(hfa, pan, sel("translationInView:"), view, 0, 0);
    dy: f64 = hfa[1];
    if (state == 1) bs_drag_from = bs_share;
    share: f64 = bs_drag_from - dy / H;
    // (Let go down past the least: put away; up past the most: filling the
    // screen. Either way it keeps the share it had, for the next time.)
    gone: bool = state == 3 && share < BESIDE_SHARE_GONE;
    filling: bool = state == 3 && share > BESIDE_SHARE_FULL;
    if (gone || filling) {
        bs_share = bs_drag_from;
        to_core_str(if (filling) "tap full" else "tap shelf");
        to_core_end();
        return 0
    }
    // (Dragged, it follows up to the top; let go, it keeps the most.)
    most: f64 = if (state == 3) BESIDE_SHARE_MOST else 1.0f64 - STRIP_H / H;
    if (share < BESIDE_SHARE_LEAST) share = BESIDE_SHARE_LEAST;
    if (share > most) share = most;
    bs_share = share;
    root_relayout();
    0
}

beside_attach() {
    view: int = msg(root_vc, sel("view"));
    msg1(root_vc, sel("addChildViewController:"), bs_nav);
    msg1(view, sel("addSubview:"), bs_rule);
    msg1(view, sel("addSubview:"), msg(bs_nav, sel("view")));
    msg1(view, sel("addSubview:"), bs_grabber);
    msg1(bs_nav, sel("didMoveToParentViewController:"), root_vc);
    bs_shown = true;
    send1("panelvisible", 1);
    note_num("bible: beside: shown, screens ", msg(msg(bs_nav, sel("viewControllers")),
        sel("count")))
}

beside_detach() {
    msg1(bs_nav, sel("willMoveToParentViewController:"), 0);
    msg(msg(bs_nav, sel("view")), sel("removeFromSuperview"));
    msg(bs_nav, sel("removeFromParentViewController"));
    msg(bs_rule, sel("removeFromSuperview"));
    msg(bs_grabber, sel("removeFromSuperview"));
    bs_shown = false;
    send1("panelvisible", 0)
}

// Its stack let go (closed, or a Study sheet opened in its place).
beside_discard() {
    if (bs_nav == 0) return;
    if (bs_shown) beside_detach();
    release(bs_nav);
    uk_panel_gone(bs_nav);
    bs_nav = 0;
    bs_depth = 0;
    bs_making = false;
    bs_grabber = held(bs_grabber, 0);
    // (The reader's bar was its navigation's: made again with the next.)
    bs_head = held(bs_head, 0)
}

// `beside OPEN FULL`, core's: at launch, as it was left (open once the
// reader is at its place); after, opened or closed, filling the screen or
// not.
beside_line(open: bool, full: bool) {
    changed: bool = full != bs_full;
    // (Beside the page again: the page leads, so that following moves only
    // the panel and the page stays where it was; unless the panel was read
    // on while it filled the screen, which the page then follows.)
    if (bs_full && !full) win_leader = (if (win_full_read_on) PANE_PANEL else PANE_PAGE);
    if (!bs_full && full) win_full_read_on = false;
    bs_full = full;
    // (Its words at the page's size while it is the only reader, a little
    // smaller beside the page: laid out again at its place.)
    rescaled: bool = panel_look_scaled(if (bs_full) 1.0f64 else PANEL_TEXT_BESIDE);
    if (!restored) {
        bs_open = open;
        return
    }
    if (!open) {
        beside_close();
        return
    }
    if (!bs_open) {
        beside_open();
        return
    }
    if (changed) {
        // (Go back's capsule is the Bible's: away while the panel fills
        // the screen.)
        if (bs_full) hide_back();
        if (rescaled) win_relaid_at_place(PANE_PANEL);
        beside_dress_all();
        beside_sweep();
        layout_bar();
        if (tray_shown) update_tray()
    }
}

// Whether the panel fits, as told to core (-1: not yet).
bs_told_fits: int = -1;

beside_tell_fits(fits: bool) {
    f: int = if (fits) 1 else 0;
    if (f == bs_told_fits) return;
    bs_told_fits = f;
    send1("panelfits", f)
}

// The reader at its place the first time: the panel opened, if it was left
// open; core told it fits.
beside_restored() {
    beside_tell_fits(true);
    if (bs_open) root_relayout()
}

// ---- opening and closing ----
// Opened: its screens asked for; once they come (beside_made), it slides
// in from the trailing edge (the page cross-fading to its new width) or up
// from the bottom.
beside_open() {
    if (bs_shown) return;
    bs_open = true;
    if (bs_nav == 0) beside_build() else beside_made_again()
}

// Opened again while its screens are kept (a window too narrow for it, then
// wide again): laid out, sliding in.
beside_made_again() {
    beside_motion(true);
    root_relayout();
    if (bs_shown) beside_motion_after(true);
    layout_bar()
}

// Closed (its close, the bar's panel button, ⌥⌘I, the grabber; core
// answering `panelmake` with nothing to show): it slides out, the page
// taking its room, the verse at the top kept.
beside_close() {
    if (!bs_open) return;
    bs_open = false;
    if (!bs_shown) {
        // (Not made: its screens asked for again the next time it opens.)
        bs_making = false;
        beside_discard();
        layout_bar();
        return
    }
    panel: int = msg(bs_nav, sel("view"));
    under: bool = bs_under;
    beside_motion(false);
    // (A picture of it slides away over the page; the stack is let go now.)
    out: int = if (reduce_motion()) 0 else msg1(panel, sel("snapshotViewAfterScreenUpdates:"),
        0);
    if (out != 0) {
        l8_msg_hfa(hfa, panel, sel("frame"), 0, 0, 0);
        msg_rect(out, sel("setFrame:"), hfa[0], hfa[1], hfa[2], hfa[3])
    }
    travel: f64 = if (under) hfa[3] + 1.0f64 else PANEL_W + 1.0f64;
    beside_discard();
    root_relayout();
    if (out != 0) {
        msg1(msg(root_vc, sel("view")), sel("addSubview:"), out);
        layer: int = msg(out, sel("layer"));
        key: str = if (under) "transform.translation.y" else "transform.translation.x";
        msg2(layer, sel("setValue:forKeyPath:"), nsnumber_f(travel), nsstring(key));
        animate(layer, key, 0.0f64, travel, false, 0.3f64);
        beside_gone(0, 0, 0);
        bs_leaving = keep(out);
        _t: int = after_common(0.32f64, "besideGone:")
    }
    layout_bar();
    if (tray_shown) update_tray();
    note("bible: beside: closed");
    // (VoiceOver back to the page.)
    tv: int = current_view();
    if (tv != 0) _a: int = UIAccessibilityPostNotification(objc_const("UIAccessibilityScreenChangedNotification"),
        tv)
}

bs_leaving: int = 0;

// ---- filling the screen ----
// Whether the panel is sweeping over the page to fill the screen (the page
// shown under it until it has).
bs_sweeping: bool = false;

// The panel laid out filling the screen or beside the page again, its
// frame (and its bar, the status bar's height taller filling the screen)
// animated there by UIKit from where it was. With Reduce Motion, a
// cross-fade.
beside_sweep() {
    if (bs_nav == 0 || !bs_shown || reduce_motion()) {
        beside_motion(true);
        root_relayout();
        return
    }
    if (bs_full) bs_sweeping = true;
    // (UIView's animation without a block, which the hot reload host cannot
    // make for the app: the frames set between begin and commit are
    // animated, from where they are now.)
    view_class: int = cls("UIView");
    msg2(view_class, sel("beginAnimations:context:"), 0, 0);
    msg_set_f(view_class, sel("setAnimationDuration:"), 0.35f64);
    msg1(view_class, sel("setAnimationCurve:"), 0);
    msg1(view_class, sel("setAnimationBeginsFromCurrentState:"), 1);
    root_relayout();
    msg(view_class, sel("commitAnimations"));
    _t: int = after_common(0.45f64, "besideSwept:")
}

// The panel has swept over the page: the page hidden under it.
beside_swept(_self: int, _cmd: int, _timer: int): int {
    if (bs_sweeping) {
        bs_sweeping = false;
        root_relayout()
    }
    // (Its lists' edge effects laid out again for its size: the system's
    // keep the height they had before an animated change, until the list
    // scrolls; a half-point scroll there and back.)
    for k in 0..UK_SLOTS {
        t: int = uk_tables[k];
        if (uk_vcs[k] != 0 && t != 0 && uk_in_panel(k)) {
            y: f64 = offset_y(t);
            msg_ff1(t, sel("setContentOffset:animated:"), 0.0f64, y + 0.5f64, 0);
            msg(t, sel("layoutIfNeeded"));
            msg_ff1(t, sel("setContentOffset:animated:"), 0.0f64, y, 0)
        }
    }
    0
}

beside_gone(_self: int, _cmd: int, _timer: int): int {
    if (bs_leaving != 0) {
        msg(bs_leaving, sel("removeFromSuperview"));
        release(bs_leaving);
        bs_leaving = 0
    }
    0
}

// The page's cross-fade as its size changes (0.2 s; 0.15 s, the panel's
// too, with Reduce Motion), at the start, so no line visibly reflows.
beside_motion(_opening: bool) {
    if (nav == 0) return;
    if (reduce_motion()) fade_layer(msg(msg(root_vc, sel("view")), sel("layer")),
        0.15f64) else fade_layer(msg(msg(nav, sel("view")), sel("layer")), 0.2f64)
}

// The panel's slide in from the trailing edge or up from the bottom (the
// panel spring, §0).
beside_motion_after(_opening: bool) {
    if (reduce_motion() || bs_nav == 0) return;
    view: int = msg(bs_nav, sel("view"));
    if (bs_under) animate(msg(view, sel("layer")), "transform.translation.y", view_height(view),
        0.0f64, true, 0.0f64) else animate(msg(view, sel("layer")), "transform.translation.x",
        PANEL_W + 1.0f64, 0.0f64, true, 0.0f64)
}

// The bar's panel button: core opens or closes the panel, or opens Go To
// aimed at it (the reader's place told first: a commentary opens at it).
beside_button(_self: int, _cmd: int, _b: int): int {
    place_tell();
    to_core_str("tap shelf");
    to_core_end();
    0
}

// Its close: core told (it says `beside 0`).
beside_close_tapped(_self: int, _cmd: int, _b: int): int {
    to_core_str("tap shelf");
    to_core_end();
    0
}

// The panel's own chevrons moved Study (the page stays where it is).
beside_moved(_c: int, _v: int) { }

// A push in the panel: its screen's edges as a sheet's (iOS 26).
beside_pushed(
    self: int,
    cmd: int,
    vc: int,
    animated: int
): int {
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(bs_class) };
    msg_super2(&sup, cmd, vc, animated);
    sheet_edges(vc);
    0
}

// How many screens the panel showed last (its stack's depth).
bs_depth: int = 0;

// A screen of the panel's shown: back to it (the stack shorter than
// before), core told which, so that it lets those above go; a push, or the
// panel coming into the window, tells nothing (core made those screens).
beside_did_show(
    _self: int,
    _cmd: int,
    nav: int,
    vc: int,
    _animated: int
): int {
    depth: int = msg(msg(nav, sel("viewControllers")), sel("count"));
    back: bool = depth < bs_depth;
    bs_depth = depth;
    if (!back) return 0;
    for k in 0..UK_SLOTS {
        if (uk_vcs[k] != 0 && uk_vcs[k] == vc) {
            note_num("bible: beside: shows ", uk_ids[k]);
            to_core_str("panelanchor ");
            to_core_int(uk_ids[k]);
            to_core_end();
            return 0
        }
    }
    0
}

make_beside_classes() {
    bs_class = class_make(cls("UINavigationController"), "L8BesidePanel");
    add_method2(bs_class, sel("pushViewController:animated:"), &beside_pushed, "v@:@B");
    add_method3(bs_class, sel("navigationController:didShowViewController:animated:"),
        &beside_did_show, "v@:@@B");
    add_method3(bs_class, sel("navigationController:willShowViewController:animated:"),
        &beside_will_show, "v@:@@B");
    add_protocol(bs_class, "UINavigationControllerDelegate")
}

// Full Screen: core told (the reader's place first: the panel beside it
// again follows it from there).
beside_full_tapped(_self: int, _cmd: int, _b: int): int {
    place_tell();
    to_core_str("tap full");
    to_core_end();
    0
}

add_beside_methods(app: int) {
    add_method1(app, sel("besideFull:"), &beside_full_tapped, "v@:@");
    add_method1(app, sel("besideClose:"), &beside_close_tapped, "v@:@");
    add_method1(app, sel("besideButton:"), &beside_button, "v@:@");
    add_method1(app, sel("besideDragged:"), &beside_dragged, "v@:@");
    add_method1(app, sel("besideGone:"), &beside_gone, "v@:@");
    add_method1(app, sel("besideSwept:"), &beside_swept, "v@:@")
}
