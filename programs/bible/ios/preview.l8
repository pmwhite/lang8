tag bible_ios;

use_tag std, ios, bible;

// Passage previews (DESIGN.md Â§8.1): a reference inside text (a heading's
// passages, a footnote's, a definition's, a note's) shows its verses in a
// sheet, set as the reader sets them (the same attributed strings, cut to
// the range, highlights and all), rather than jumping there. From the
// reader it is a sheet of its own, at the medium detent; from another sheet
// it is pushed onto that sheet's stack. Open in Reader, in its toolbar,
// goes there.
import "../../ios/objc.l8";

import "../core/text.l8";

pv_class: int = 0;

// The text view of the preview made last (for the demo).
pv_tv: int = 0;

// The most verses a preview shows; past them, the reader.
PREVIEW_MOST: int = 80;

// Whether the top of a sheet's stack is a preview.
preview_on_top(sheet_nav: int): bool {
    if (sheet_nav == 0 || !responds(sheet_nav, "topViewController")) return false;
    top: int = msg(sheet_nav, sel("topViewController"));
    top != 0 && (msg1(top, sel("isKindOfClass:"), pv_class) & 255) != 0
}

// The preview of reference ref (text.l8's xref_both), as a sheet over the
// reader.
open_preview(ref: int) {
    if (presented() != 0) return;
    vc: int = make_preview(ref, true);
    sheet_form(620.0f64, 640.0f64);
    sheet_nav: int = sheet_of(vc, 1);
    sheet: int = msg(sheet_nav, sel("sheetPresentationController"));
    if (sheet != 0) msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierMedium"));
    msg2(sheet_nav, sel("setToolbarHidden:animated:"), 0, 0);
    msg1(msg(sheet_nav, sel("toolbar")), sel("setTintColor:"), c_accent);
    present(sheet_nav)
}

// The preview pushed onto the sheet on top (a definition's, a note's,
// another preview's), at the detent the sheet has.
push_preview(ref: int) {
    sheet_nav: int = top_presented();
    if (sheet_nav == 0 || !responds(sheet_nav, "pushViewController:animated:")) {
        open_preview(ref);
        return
    }
    vc: int = make_preview(ref, false);
    msg1(msg(sheet_nav, sel("toolbar")), sel("setTintColor:"), c_accent);
    msg2(sheet_nav, sel("pushViewController:animated:"), vc, 1)
}

// The reference's name into fbuf: John 1:1â€“5, 2 Corinthians 4:6, Matthew
// 5:1â€“7:29, Psalm 23.
fput_xref(ref: int) {
    xref_unpack(ref);
    c: int = xref_chapter();
    fput_title(c);
    single: bool = book_count[xr_book] == 1;
    if (xr_v > 0) {
        fput(if (single) 32 else 58);
        fput_int(xr_v);
        if (xr_ce != xr_c) {
            fput_str("\â\€\“");
            fput_int(xr_ce);
            fput(58);
            fput_int(xr_ve)
        } else if (xr_ve > xr_v) {
            fput_str("\â\€\“");
            fput_int(xr_ve)
        }
    } else if (xr_ce != xr_c) {
        fput_str("\â\€\“");
        fput_int(xr_ce)
    }
}

make_preview(ref: int, root: bool): int {
    vc: int = msg(msg(msg(pv_class, sel("alloc")), sel("init")), sel("autorelease"));
    fbuf_n = 0;
    fput_xref(ref);
    msg1(vc, sel("setTitle:"), fstring());
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    if (root) msg1(item, sel("setRightBarButtonItem:"), system_item(0, "closeSheet:"));
    view: int = msg(vc, sel("view"));
    msg1(view, sel("setBackgroundColor:"), c_bg);
    tv: int = make("UITextView");
    pv_tv = tv;
    msg1(tv, sel("setEditable:"), 0);
    msg1(tv, sel("setSelectable:"), 1);
    msg1(tv, sel("setBackgroundColor:"), c_bg);
    msg1(tv, sel("setTintColor:"), c_accent);
    msg1(tv, sel("setAlwaysBounceVertical:"), 1);
    // (In a wide window's form sheet, the sheet's own margins.)
    m: f64 = if (wide()) margin_for(620.0f64) else side_margin();
    msg_rect(tv, sel("setTextContainerInset:"), 16.0f64, m, 28.0f64, m);
    msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
    msg1(tv, sel("setAutoresizingMask:"), 18);
    l8_msg_hfa(hfa, view, sel("bounds"), 0, 0, 0);
    msg_rect(tv, sel("setFrame:"), 0.0f64, 0.0f64, hfa[2], hfa[3]);
    pv_esv_state = 0;
    if (text_cur == TEXT_ESV && !preview_held(ref)) {
        // (The ESV's chapters asked for; the spinner, centered, until they
        // come, or the BSB's words if they cannot.)
        preview_ask(ref);
        release(pv_wait_tv);
        pv_wait_tv = keep(tv);
        pv_wait_ref = ref;
        sp: int = msg1(msg(cls("UIActivityIndicatorView"), sel("alloc")), sel("initWithActivityIndicatorStyle:"),
            100);
        msg1(sp, sel("setColor:"), c_faint);
        msg(sp, sel("startAnimating"));
        msg1(sp, sel("setTag:"), SPINNER_TAG);
        msg1(sp, sel("setAutoresizingMask:"), 45);
        msg_rect(sp, sel("setFrame:"), hfa[2] / 2.0f64 - 10.0f64, 90.0f64, 20.0f64,
            20.0f64);
        msg1(tv, sel("addSubview:"), sp);
        release(sp);
        msg1(tv, sel("setAttributedText:"), attributed_str(nsstring(""), 0))
    } else msg1(tv, sel("setAttributedText:"), preview_text(ref));
    // (Long-press: the system's own menu, as the text has no chapter.)
    msg1(tv, sel("setDelegate:"), app_obj);
    tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("previewTapped:"));
    msg1(tap, sel("setDelegate:"), app_obj);
    msg1(tv, sel("addGestureRecognizer:"), tap);
    release(tap);
    msg1(view, sel("addSubview:"), tv);
    release(tv);
    // The toolbar: Open in Reader, in the middle.
    open: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithTitle:style:target:action:"),
        nsstring("Open in Reader"), 0, app_obj, sel("previewOpen:")), sel("autorelease"));
    msg1(open, sel("setTag:"), ref);
    flex: int = msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        5, 0, 0), sel("autorelease"));
    pv_items[0] = flex;
    pv_items[1] = open;
    pv_items[2] = flex;
    msg1(vc, sel("setToolbarItems:"), nsarray(pv_items, 3));
    vc
}

pv_items: []int = new int[3](0);

// ---- under the ESV (Â§9.4.7) ----
// The preview waiting for the ESV (its text view, and reference), and
// whether its chapters could not come.
pv_wait_tv: int = 0;

pv_wait_ref: int = 0;

pv_esv_state: int = 0;

// Whether every chapter of the reference is held.
preview_held(ref: int): bool {
    xref_unpack(ref);
    c0: int = xref_chapter();
    c1: int = xref_last_chapter();
    for c in c0..c1 + 1
        if (!esv_held(c)) return false;
    true
}

preview_ask(ref: int) {
    xref_unpack(ref);
    c0: int = xref_chapter();
    ec_hold_c = c0;
    c1: int = xref_last_chapter();
    for c in c0..c1 + 1
        if (!esv_held(c)) esv_want(c, if (c1 > c) 2 else 1)
}

preview_esv_arrived(_c: int) {
    if (pv_wait_tv == 0) return;
    if (!preview_held(pv_wait_ref)) {
        preview_ask(pv_wait_ref);
        return
    }
    preview_settle()
}

preview_esv_failed(_c: int, state: int) {
    if (pv_wait_tv == 0) return;
    pv_esv_state = state;
    preview_settle()
}

// The waiting preview's text in place (a cross-fade), its spinner gone.
preview_settle() {
    tv: int = pv_wait_tv;
    pv_wait_tv = 0;
    sp: int = msg1(tv, sel("viewWithTag:"), SPINNER_TAG);
    if (sp != 0) msg(sp, sel("removeFromSuperview"));
    fade_layer(msg(tv, sel("layer")), 0.2f64);
    msg1(tv, sel("setAttributedText:"), preview_text(pv_wait_ref));
    pv_esv_state = 0;
    release(tv)
}

// The attributes of a place in s, with one key's value replaced.
attrs_with(
    s: int,
    at: int,
    key: int,
    value: int
): int {
    d: int = msg(msg(msg2(s, sel("attributesAtIndex:effectiveRange:"), at, 0), sel("mutableCopy")),
        sel("autorelease"));
    if (value != 0) msg2(d, sel("setObject:forKey:"), value, key) else msg1(d, sel("removeObjectForKey:"),
        key);
    d
}

attributed_str(text: int, attributes: int): int {
    msg(msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, attributes), sel("autorelease"))
}

// The verses of a reference, as the reader sets them: each chapter's
// attributed string (its highlights, not the selection or a flash), cut
// from the first verse's number to the last verse's end, with the headings
// inside the range; a later chapter's label and number before its verses;
// at most PREVIEW_MOST verses, then a line saying the reader has the rest.
preview_text(ref: int): int {
    // (Under the ESV, its own words if they are here, its line after them;
    // else the BSB's, saying so, and why if the reader can do something
    // about it.)
    if (text_cur == TEXT_ESV) {
        if (preview_held(ref)) {
            s: int = preview_text_in(ref);
            esv_footer(s);
            return s
        }
        source: TextSource = text_source(TEXT_BSB);
        s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
        keys[0] = k_font;
        values[0] = sans(13.0f64, 0.0f64);
        keys[1] = k_color;
        values[1] = c_faint;
        keys[2] = k_para;
        values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 10.0f64, 1.0f64), sel("autorelease"));
        why: str = if (pv_esv_state == ESV_OFFLINE) " The ESV needs a connection." else if (pv_esv_state == ESV_BUSY) " The ESV is busy just now." else "";
        fbuf_n = 0;
        fput_str("Shown in the BSB.");
        fput_str(why);
        fput(10);
        msg1(s, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
            values, 3)));
        msg1(s, sel("appendAttributedString:"), preview_text_from(&source, ref));
        return s
    }
    preview_text_in(ref)
}

preview_text_in(ref: int): int {
    source: TextSource = text_source(text_cur);
    preview_text_from(&source, ref)
}

preview_text_from(source: *TextSource, ref: int): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    region {
        ctx: ChapterLayout = chapter_layout();
        ranges: ChapterRanges = chapter_ranges();
        xref_unpack(ref);
        c0: int = xref_chapter();
        c1: int = xref_last_chapter();
        from_v: int = if (xr_v > 0) xr_v else 1;
        to_v: int = xr_ve;
        whole_end: bool = xr_ve == 0;
        shown: int = 0;
        capped: bool = false;
        c: int = c0;
        while (c <= c1 && !capped) {
            a: int = 1;
            z: int = source.verses[c];
            if (c == c0) a = from_v;
            if (c == c1 && !whole_end) z = to_v;
            if (z > source.verses[c]) z = source.verses[c];
            if (z < a) z = a;
            if (shown + z - a + 1 > PREVIEW_MOST) {
                z = a + PREVIEW_MOST - shown - 1;
                capped = true
            }
            orig_before_layout_source(source, c);
            layout_chapter_from(source.*, &ctx, c);
            measure_chapter(&ctx, &ranges, c);
            text: int = chapter_text_layout(&ctx, &ranges, c, true);
            n: int = msg(text, sel("length"));
            ia: int = ranges_index(&ranges, a);
            iz: int = ranges_index(&ranges, z);
            if (ia >= 0 && iz >= 0) {
                b: int = ranges.rv_b[ia];
                e: int = ranges.rv_e[iz];
                // (The note's mark after the last verse, with it.)
                if (note_of(c, z) >= 0 && e + 2 <= n) e = e + 2;
                if (c > c0) {
                    // The chapter's label and number, between chapters.
                    if (msg(s, sel("length")) > 0) msg1(s, sel("appendAttributedString:"),
                        attributed_str(nsstring("\n"), msg2(s, sel("attributesAtIndex:effectiveRange:"),
                        msg(s, sel("length")) - 1, 0)));
                    msg1(s, sel("appendAttributedString:"), preview_opener(source,
                        c))
                }
                // (Verse 1 has no number in the reader, the chapter's number
                // standing for it: here it has one.)
                if (ranges.rv_num[ia] == 1 && ctx.lay_verse_numbers && !ctx.lay_verse_lines && ranges.rv_count > 1 && e > b) {
                    i2: int = ranges_index(&ranges, 2);
                    if (i2 >= 0) {
                        d: int = attrs_with(text, ranges.rv_b[i2], k_para, msg3(text,
                            sel("attribute:atIndex:effectiveRange:"), k_para, b, 0));
                        msg1(d, sel("removeObjectForKey:"), k_background);
                        msg1(s, sel("appendAttributedString:"), attributed_str(ustr(49,
                            8239), d))
                    }
                }
                if (e > b) msg1(s, sel("appendAttributedString:"), msg2(text, sel("attributedSubstringFromRange:"),
                    b, e - b))
            }
            shown = shown + z - a + 1;
            c = c + 1
        }
        if (capped) {
            keys[0] = k_font;
            values[0] = sans(15.0f64, 0.0f64);
            keys[1] = k_color;
            values[1] = c_faint;
            keys[2] = k_para;
            values[2] = msg(para_style(1, 0.0f64, 0.0f64, em * 1.2f64, 0.0f64, 1.0f64),
                sel("autorelease"));
            msg1(s, sel("appendAttributedString:"), attributed_str(nsstring("""

Continues in the reader"""), nsdictionary(keys, values, 3)))
        }
    }
    s
}

// A chapter's label (JOHN) and number, small, centered: where a preview
// goes on into the next chapter.
preview_opener(source: *TextSource, c: int): int {
    o: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    b: int = ch_book[c];
    fbuf_n = 0;
    if (source_book_is(source, b, "PSA")) fput_str("PSALM") else {
        for i in source_book_name_start(source, b)..source_book_name_end(source, b) {
            k: int = source.data[i] as int;
            fput(if (k >= 97 && k <= 122) k - 32 else k)
        }
    }
    fput(10);
    keys[0] = k_font;
    values[0] = sans(em * 0.62f64, 0.3f64);
    keys[1] = k_color;
    values[1] = c_faint;
    keys[2] = k_para;
    values[2] = msg(para_style(1, 0.0f64, 0.0f64, em * 1.6f64, em * 0.05f64, 1.0f64),
        sel("autorelease"));
    keys[3] = k_kern;
    values[3] = nsnumber_f(em * 0.16f64);
    msg1(o, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
        values, 4)));
    fbuf_n = 0;
    fput_int(ch_num[c]);
    fput(10);
    keys[0] = k_font;
    values[0] = light(em * 1.6f64);
    keys[1] = k_color;
    values[1] = c_accent;
    keys[2] = k_para;
    values[2] = msg(para_style(1, 0.0f64, 0.0f64, 0.0f64, em * 0.6f64, 1.0f64), sel("autorelease"));
    msg1(o, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
        values, 3)));
    o
}

// A tap in a preview: on a footnote's mark, its popover (over the
// preview); on a reference, its preview pushed. A verse is not selected.
preview_tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    x: f64 = hfa[0];
    y: f64 = hfa[1];
    range: int = msg(tv, sel("selectedTextRange"));
    if (range != 0 && (msg(range, sel("isEmpty")) & 255) == 0) return 0;
    link: int = link_at(tv, x, y, k_link);
    if (link > 0) {
        c: int = chapter_at_offset(link);
        if (c >= 0) show_footnote(tv, c, link, x, y);
        return 0
    }
    ref: int = link_at_within(tv, x, y, k_xref, 12.0f64);
    if (ref > 0) push_preview(ref);
    0
}

// Open in Reader: the sheets gone, the reader at the first verse (a third
// of the way down, flashed), the way back to where it was.
preview_open(_self: int, _cmd: int, item: int): int {
    xref_unpack(msg(item, sel("tag")));
    c: int = xref_chapter();
    jump(c, xr_v);
    0
}

// A preview's toolbar shown as it comes; as it is popped, the toolbar of
// the screen under it as that screen has it (none, if it has no items).
preview_will_appear(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, pv_class, cmd, animated);
    sheet_nav: int = msg(self, sel("navigationController"));
    if (sheet_nav != 0) msg2(sheet_nav, sel("setToolbarHidden:animated:"), 0, animated & 255);
    0
}

preview_will_disappear(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, pv_class, cmd, animated);
    if ((msg(self, sel("isMovingFromParentViewController")) & 255) == 0) return 0;
    sheet_nav: int = msg(self, sel("navigationController"));
    if (sheet_nav == 0) return 0;
    under: int = msg(sheet_nav, sel("topViewController"));
    if (under == 0 || under == self) return 0;
    items: int = msg(under, sel("toolbarItems"));
    hide: bool = items == 0 || msg(items, sel("count")) == 0 || (msg(under, sel("hidesBottomBarWhenPushed")) & 255) != 0;
    msg2(sheet_nav, sel("setToolbarHidden:animated:"), if (hide) 1 else 0, animated & 255);
    0
}

make_preview_class() {
    pv_class = objc_allocateClassPair(cls("UIViewController"), "L8Preview", 0);
    add_method1(pv_class, sel("viewWillAppear:"), &preview_will_appear, "v@:B");
    add_method1(pv_class, sel("viewWillDisappear:"), &preview_will_disappear, "v@:B");
    objc_registerClassPair(pv_class)
}

add_preview_methods(app: int) {
    add_method1(app, sel("previewTapped:"), &preview_tapped, "v@:@");
    add_method1(app, sel("previewOpen:"), &preview_open, "v@:@")
}
