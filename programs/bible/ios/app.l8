tag bible_ios;

use_tag std, ios, bible, bible_wire;

// Smooth Bible, the Bible app for an iPhone, built with `l8 arm64 --target
// ios` (see tools/ios/build.sh and programs/bible/ios/): a skin of core's,
// as the terminal's, the web's and Android's are (SKINS.md). Core runs in
// the app on its host (core/host.l8, ios/platform.l8); the skin speaks the
// same lines to it (ios/wire.l8) and shows what core says in UIKit's own
// views, so it reads, scrolls, selects and copies as the phone's own apps
// do.
//
// A navigation controller holds a table of every chapter, one after
// another, read on by scrolling from Genesis 1 to Revelation 22. Each row is
// a text view of one attributed string made from core's chapter lines
// (ios/reader.l8), in the look core says (ios/look.l8). The bar's title is
// the chapter being read; it opens Go To, and its long press the ribbons'
// menu (ios/titles.l8). The bar's other buttons open search, the library
// and the reading settings: core's screens, shown as lists (ios/skin.l8). A
// tap on a verse is core's to select; its tray floats up (ios/select.l8).
// Where the reader is, and its rests, are told to core, which keeps them.
//
// Links (bsb://JHN/3) are core's to read.
import "../../../stdlib/print.l8";

import "../../ios/objc.l8";

import "../core/wire.l8";

import "views.l8";

import "look.l8";

import "wire.l8";

import "platform.l8";

import "reader.l8";

import "pane.l8";

import "effects.l8";

import "services.l8";

import "select.l8";

import "sheets.l8";

import "cells.l8";

import "card.l8";

import "bar.l8";

import "titles.l8";

import "ipad.l8";

import "beside.l8";

import "devwire.l8";

import "skin.l8";

extern getenv(name: str): ?*i8;

extern msg_super0(sup: *ObjcSuper, selector: int): int = objc_msgSendSuper;

extern msg_f4(
    receiver: int,
    selector: int,
    t: f64,
    a: int,
    b: int,
    c: int,
    d: int
): int = objc_msgSend;

extern msg1_ff(
    receiver: int,
    selector: int,
    a: int,
    x: f64,
    y: f64
): int = objc_msgSend;

// [super selector], from a method of cls (the class that defines it).
super0(self: int, cls: int, selector: int) {
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(cls) };
    msg_super0(&sup, selector)
}

// A line of diagnostics (the console), only with L8_DEMO or L8_TIMING in
// the environment: a build in normal use says nothing.
note(what: str) {
    if (!diag_on) return;
    try {
        eprint(what)
    } with IoError _e -> { }
}

// A number in the log.
note_num(label: str, n: int) {
    if (!diag_on) return;
    try {
        write(2, label);
        write_int(2, n);
        write(2, "\n")
    } with IoError _e -> { }
}

// ---- what UIKit made ----
// (Kept across a hot reload, RELOAD.md: the delegate, the window and the
// scene UIKit made are the old build's; the new one's reload() fills the
// window again.)
persistent app_obj: int = 0;

persistent window: int = 0;

persistent scene_obj: int = 0;

nav: int = 0;

// The table of chapters (and its controller).
reader: int = 0;

table: int = 0;

// The chapter's name at the top: one button, in a view the bar scales,
// in a view that fades it (as the bar collapses, title_alpha); its text
// changed in place, with a short cross-fade, as the chapter read changes
// (owner, 2026-10-19).
title_view: int = 0;

title_fader: int = 0;

// (One button; kept in arrays of one, as the menus and VoiceOver set it.)
title_btn: []int = new int[1](0);

// The chapter it shows (-1: none yet), and its width.
title_btn_c: []int = new int[1](-1);

title_btn_w: []f64 = new f64[1](0.0f64);

// The width of what the button draws (its name and chevron), to set the
// carried ribbon's glyph beside it.
title_text_w: f64 = 0.0f64;

// While a ribbon is carried, its glyph just left of the title (owner,
// 2026-10-19): an image view in the title's fading view (so the bar scales
// it with the title), shown or not.
title_ribbon: int = 0;

title_ribbon_on: bool = false;

// The glyph's size there, and its gap from the name.
TITLE_GLYPH: f64 = 15.0f64;

TITLE_GLYPH_GAP: f64 = 6.0f64;

// The title's height in its view.
TITLE_H: f64 = 44.0f64;

nav_class: int = 0;

reader_class: int = 0;

// The chapter being read (the one at the top), and how far down into it
// (points).
cur: int = 0;

restored: bool = false;

bars_hidden: bool = false;

// A drag: the highest and lowest the text has been during it.
drag_top: f64 = 0.0f64;

drag_low: f64 = 0.0f64;

// Results of four doubles (msg_hfa), kept: callbacks run outside any region.
hfa: []f64 = new f64[4](0.0f64);

one: []int = new int[8](0);

// The characters cp and then cp2 (if not 0) as an NSString.
ubuf: []i8 = new i8[8](0i8);

ubuf_n: int = 0;

uput(cp: int) {
    if (cp < 128) {
        ubuf[ubuf_n] = cp trunc i8;
        ubuf_n = ubuf_n + 1
    } else if (cp < 2048) {
        ubuf[ubuf_n] = (192 + cp / 64) trunc i8;
        ubuf[ubuf_n + 1] = (128 + cp % 64) trunc i8;
        ubuf_n = ubuf_n + 2
    } else {
        ubuf[ubuf_n] = (224 + cp / 4096) trunc i8;
        ubuf[ubuf_n + 1] = (128 + cp / 64 % 64) trunc i8;
        ubuf[ubuf_n + 2] = (128 + cp % 64) trunc i8;
        ubuf_n = ubuf_n + 3
    }
}

ustr(cp: int, cp2: int): int {
    ubuf_n = 0;
    uput(cp);
    if (cp2 != 0) uput(cp2);
    nsstring_of(ubuf, ubuf_n)
}

// Whether object o answers selector name.
responds(o: int, name: str): bool {
    (msg1(o, sel("respondsToSelector:"), sel(name)) & 255) != 0
}

nsnumber_int(n: int): int {
    msg1(cls("NSNumber"), sel("numberWithLong:"), n)
}

// A timer that sends selector name to the app after t seconds.
after(t: f64, name: str): int {
    msg_f4(cls("NSTimer"), sel("scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:"),
        t, app_obj, sel(name), 0, 0)
}

// The same, in the run loop's common modes: it fires even while the run
// loop is held in another mode (a scroll's tracking, a sheet's or the
// glass's animations), where a default-mode timer waits. For what must
// not stall: core's wakes, the lines and files taken.
after_common(t: f64, name: str): int {
    timer: int = msg_f4(cls("NSTimer"), sel("timerWithTimeInterval:target:selector:userInfo:repeats:"),
        t, app_obj, sel(name), 0, 0);
    msg2(msg(cls("NSRunLoop"), sel("mainRunLoop")), sel("addTimer:forMode:"), timer,
        l8_run_loop_common_modes());
    timer
}

stop_timer(timer: int): int {
    if (timer != 0) msg(timer, sel("invalidate"));
    0
}

// ---- the page ----
// The reader's table is the page (pane 0, ios/pane.l8): no rows, its
// header a window of its parts, each a text view (not scrolling by itself:
// the table does), its tag its part's key plus one.
is_reader(t: int): bool {
    t != 0 && t == table
}

// The text's side margins, for the table's width now: the setting's, or
// wider, the text a column of 34 em centred (§17.2.1). (Held sideways, an
// iPhone's cells are inside its safe area: their width.)
side_margin(): f64 {
    l8_msg_hfa(hfa, table, sel("bounds"), 0, 0, 0);
    w: f64 = hfa[2];
    l8_msg_hfa(hfa, table, sel("safeAreaInsets"), 0, 0, 0);
    w = w - hfa[1] - hfa[3];
    m: f64 = margin_for(w);
    cw: f64 = column_width(w, m);
    if (cw < w - 2.0f64 * m) m = (w - cw) / 2.0f64;
    m
}

// The Bible's first gap: 0.8 em from the bar to the tops of "Genesis"'s
// capitals.
top_gap(): f64 {
    f: int = fonts[STYLE_BOOK];
    g: f64 = em * 0.8f64 - (msg_f(f, sel("ascender")) - msg_f(f, sel("capHeight")));
    if (g < 0.0f64) 0.0f64 else g
}

// Edge name of a and b, the same.
pin(a: int, b: int, edge: str) {
    msg1(msg1(msg(a, sel(edge)), sel("constraintEqualToAnchor:"), msg(b, sel(edge))),
        sel("setActive:"), 1)
}

// Edge name of a, at d points past b's.
pin_by(
    a: int,
    b: int,
    edge: str,
    d: f64
) {
    msg1(msg1_f(msg(a, sel(edge)), sel("constraintEqualToAnchor:constant:"), msg(b,
        sel(edge)), d), sel("setActive:"), 1)
}

// A's edge ea at d points past b's edge eb.
pin_to(
    a: int,
    ea: str,
    b: int,
    eb: str,
    d: f64
) {
    msg1(msg1_f(msg(a, sel(ea)), sel("constraintEqualToAnchor:constant:"), msg(b,
        sel(eb)), d), sel("setActive:"), 1)
}

// A view's width or height, fixed.
pin_size(v: int, dim: str, d: f64) {
    msg1(msg_set_f(msg(v, sel(dim)), sel("constraintEqualToConstant:"), d), sel("setActive:"),
        1)
}

// The page's chapter a part's text view shows (-1: not the page's).
chapter_of_view(v: int): int {
    key: int = view_key(v);
    if (key < 0 || part_key_pane(key) != PANE_PAGE) -1 else part_key_chapter(key)
}

// The key of the part a text view shows (-1: none).
view_key(v: int): int {
    msg(v, sel("tag")) - 1
}

// The text view of the page's chapter c, its first part in the window (0
// if none is).
view_of(c: int): int {
    win_view_of(PANE_PAGE, c)
}

current_view(): int {
    view_of(cur)
}

// The text's top, where it rests unscrolled (the bars above it).
top_inset(sv: int): f64 {
    l8_msg_hfa(hfa, sv, sel("adjustedContentInset"), 0, 0, 0);
    hfa[0]
}

bottom_inset(sv: int): f64 {
    l8_msg_hfa(hfa, sv, sel("adjustedContentInset"), 0, 0, 0);
    hfa[2]
}

offset_y(sv: int): f64 {
    l8_msg_hfa(hfa, sv, sel("contentOffset"), 0, 0, 0);
    hfa[1]
}

view_height(v: int): f64 {
    l8_msg_hfa(hfa, v, sel("bounds"), 0, 0, 0);
    hfa[3]
}

view_width(v: int): f64 {
    l8_msg_hfa(hfa, v, sel("bounds"), 0, 0, 0);
    hfa[2]
}

// The rect of UTF-16 units k to k + n of text view tv (in its own
// coordinates): hfa. Not laid out yet: laid out, and asked again (not
// through the layout manager, which would turn the view to the older text
// system).
range_rect(tv: int, k: int, n: int): bool {
    if (range_rect_if_laid_out(tv, k, n)) return true;
    msg(tv, sel("layoutIfNeeded"));
    range_rect_if_laid_out(tv, k, n)
}

// The same, only if the view has laid out those units already (laying out
// a long chapter takes a while: not while it moves).
range_rect_if_laid_out(tv: int, k: int, n: int): bool {
    begin: int = msg(tv, sel("beginningOfDocument"));
    a: int = msg2(tv, sel("positionFromPosition:offset:"), begin, k);
    b: int = msg2(tv, sel("positionFromPosition:offset:"), begin, k + n);
    if (a == 0 || b == 0) return false;
    range: int = msg2(tv, sel("textRangeFromPosition:toPosition:"), a, b);
    l8_msg_hfa(hfa, tv, sel("firstRectForRange:"), range, 0, 0);
    hfa[3] > 0.0f64 && hfa[1] < 1.0e9f64
}

// Which chapter is at the top (under the bars): cur. The title follows.
find_place() {
    if (table == 0) return;
    top: f64 = offset_y(table) + top_inset(table);
    last_top = top;
    c: int = win_chapter_at(PANE_PAGE, top + 1.0f64);
    if (c < 0) return;
    if (c != cur) {
        cur = c;
        note_num("bible: chapter ", c)
    }
    title_fade()
}

// The top of what is seen (in the table's content), last found.
last_top: f64 = 0.0f64;

// The bars' insets changed (as the bars or the status bar come or go, or
// a sheet goes): the same text kept at the top, unless a finger is moving
// it.
inset_changed(_self: int, _cmd: int, sv: int): int {
    if (is_panel_reader(sv)) {
        win_inset_changed(PANE_PANEL);
        return 0
    }
    if (!is_reader(sv) || !restored) return 0;
    if (reader_moving()) return 0;
    note_num("bible: inset now ", top_inset(sv) as int);
    win_set_offset(PANE_PAGE, last_top - top_inset(sv));
    find_place();
    0
}

// The title names the chapter being read: the one whose row holds the
// bar's bottom line (so its top has reached the bar), following the scroll
// either way. A chapter at the top of the screen, as a jump leaves it, is
// named, and the title is never empty (at Genesis 1 too: it is the way to
// Go To). When the chapter changes, the text is changed in place, with a
// 0.18 s cross-fade (none with Reduce Motion): no movement, no second
// name. Owner, 2026-10-19 (replacing the push of 2026-10-18).
title_fade() {
    title_update(true)
}

title_update(fade: bool) {
    if (table == 0 || title_view == 0 || chapters_n == 0) return;
    c: int = win_chapter_at(PANE_PAGE, offset_y(table) + bar_bottom() + 1.0f64);
    if (c < 0) c = cur;
    if (c < 0 || c >= chapters_n) return;
    was: int = title_btn_c[0];
    if (c != was && title_config(0, c)) {
        if (fade && was >= 0 && !reduce_motion()) {
            tr: int = make("CATransition");
            msg1(tr, sel("setType:"), objc_const("kCATransitionFade"));
            msg_set_f(tr, sel("setDuration:"), 0.18f64);
            msg2(msg(title_btn[0], sel("layer")), sel("addAnimation:forKey:"), tr,
                nsstring("title"));
            release(tr)
        }
        note_num("bible: title ", c)
    }
    title_place()
}

// The bar's scale of the title (17 pt type to 12 pt as it collapses).
title_scale(): f64 {
    1.0f64 - 5.0f64 / 17.0f64 * bar_p
}

// The title placed for the bar's state (no implicit animations: it follows
// the finger), centered in the room between the bar's buttons.
title_place() {
    if (title_view == 0) return;
    msg(cls("CATransaction"), sel("begin"));
    msg1(cls("CATransaction"), sel("setDisableActions:"), 1);
    tw: f64 = 120.0f64;
    // (The bar's own width, the page's: a narrow window's, or beside Study.)
    if (window != 0) tw = bar_room();
    if (tw < 80.0f64) tw = 80.0f64;
    msg_rect(title_view, sel("setBounds:"), 0.0f64, 0.0f64, tw, TITLE_H);
    msg_rect(title_fader, sel("setFrame:"), 0.0f64, 0.0f64, tw, TITLE_H);
    msg_set_f(title_fader, sel("setAlpha:"), title_alpha());
    b: int = title_btn[0];
    w: f64 = title_btn_w[0];
    if (w > tw) w = tw;
    // (Centered; with the ribbon's glyph, moved right only as far as a long
    // name needs for the glyph to fit, and cut at its end if it must be.)
    cx: f64 = tw / 2.0f64;
    content: f64 = if (title_text_w < w) title_text_w else w;
    strip: f64 = GLYPH_W * TITLE_GLYPH;
    if (title_ribbon_on) {
        need: f64 = content / 2.0f64 + TITLE_GLYPH_GAP + strip;
        if (need > cx) cx = need;
        if (cx + w / 2.0f64 > tw) w = 2.0f64 * (tw - cx)
    }
    msg_rect(b, sel("setBounds:"), 0.0f64, 0.0f64, w, TITLE_H);
    msg_ff(b, sel("setCenter:"), cx, TITLE_H / 2.0f64);
    if (title_ribbon != 0) {
        if (carried_color != 0) msg1(title_ribbon, sel("setTintColor:"), carried_color);
        cw: f64 = if (content < w) content else w;
        msg_rect(title_ribbon, sel("setBounds:"), 0.0f64, 0.0f64, TITLE_GLYPH, TITLE_GLYPH);
        msg_ff(title_ribbon, sel("setCenter:"), cx - cw / 2.0f64 - TITLE_GLYPH_GAP - strip / 2.0f64,
            TITLE_H / 2.0f64)
    }
    msg1(b, sel("setHidden:"), if (title_btn_c[0] >= 0) 0 else 1);
    msg1(b, sel("setUserInteractionEnabled:"), if (bar_p <= 0.5f64) 1 else 0);
    set_compact_title(msg(b, sel("accessibilityLabel")));
    title_compact_menu();
    msg(cls("CATransaction"), sel("commit"))
}

// The carried ribbon's glyph by the title: faded in as a ribbon is picked
// up and out as it is put down (0.2 s; at once with Reduce Motion).
title_ribbon_update() {
    if (title_ribbon == 0) return;
    want: bool = carried_color != 0;
    if (want) msg1(title_ribbon, sel("setTintColor:"), carried_color);
    if (want == title_ribbon_on) return;
    title_ribbon_on = want;
    layer: int = msg(title_ribbon, sel("layer"));
    a: f64 = if (want) 1.0f64 else 0.0f64;
    title_place();
    msg_set_f32(layer, sel("setOpacity:"), a as f32);
    if (!reduce_motion()) animate(layer, "opacity", 1.0f64 - a, a, false, 0.2f64);
    note_num("bible: title ribbon shown ", if (want) 1 else 0)
}

// The title when scrolling stops (the place measured again).
title_settle() {
    title_update(true)
}

// Whether the reader's table is moving (a finger on it, or gliding): while
// it is, nothing writes its offset, scrolls it to a row or reloads it
// (DESIGN.md §9.4.11). go and set_offset themselves refuse then (review
// r5-1), and the log counts each refused; what must
// happen still (a look changed, the text size) waits for rest
// (reader_rested), and what the reader asks for (a jump, the back
// capsule, Listen's name) stops the glide first (stop_moving). In
// reader_rested it has stopped, whatever UIKit's flags still say.
resting: bool = false;

reader_moving(): bool {
    !resting && win_moving(PANE_PAGE)
}

// A glide stopped where it is, for a place the reader asked for.
stop_moving() {
    win_halt(PANE_PAGE)
}

// The look (or the text size) changed while the reader moved: the rows
// made again at rest.
relayout_due: bool = false;

text_size_due: bool = false;

// From the top of the line of character k of tv to its capitals' tops
// (the font's ascender less its cap height).
cap_gap(tv: int, k: int): f64 {
    f: int = msg3(msg(tv, sel("textStorage")), sel("attribute:atIndex:effectiveRange:"),
        k_font, k, 0);
    if (f == 0) return 0.0f64;
    msg_f(f, sel("ascender")) - msg_f(f, sel("capHeight"))
}

// Both panes' parts made again (the look, the text's size), each at its
// place (at rest).
relayout() {
    if (table == 0 || !restored) return;
    if (reader_moving()) {
        relayout_due = true;
        return
    }
    relayout_due = false;
    for p in 0..PANES win_rebuild(p);
    // (Study beside the text, if the margins changed whether it fits.)
    root_relayout()
}

// The page's place told to core (`at`), if it moved; its rest.
place_tell() {
    win_tell(PANE_PAGE, false)
}

rest_tell() {
    win_rest_tell(PANE_PAGE)
}

nav_status_hidden(_self: int, _cmd: int): int {
    0
}

nav_status_child(_self: int, _cmd: int): int {
    0
}

nav_status_animation(_self: int, _cmd: int): int {
    1
}

// Dark text on the light themes, light on the dark.
nav_status_style(_self: int, _cmd: int): int {
    if (is_dark()) 1 else 3
}

// The scroll: the place found, the bar following it (ios/bar.l8), and the
// capsule let go once far from where it came; each pane's place told.
scroll_began(_self: int, _cmd: int, sv: int): int {
    p: int = win_pane_of(sv);
    if (p < 0) return 0;
    if (p == PANE_PAGE) {
        drag_top = offset_y(sv);
        drag_low = drag_top;
        width_place_moved();
        // (A finger on it: the status bar's scroll, if any, is the
        // finger's.)
        status_c = -1;
        bar_drag_began()
    }
    win_drag_began(p);
    0
}

scrolled(_self: int, _cmd: int, sv: int): int {
    p: int = win_pane_of(sv);
    if (p < 0) return 0;
    if (p == PANE_PAGE) {
        // (Only the finger's own scroll, or its glide, opens the flick-stop
        // window: not Listen's following, nor the bar's settle.)
        if ((msg(sv, sel("isTracking")) & 255) != 0 || (msg(sv, sel("isDecelerating")) & 255) != 0) moved_at = CACurrentMediaTime();
        // (The window's own move, rows above coming and going, keeps the
        // words where they are: not a scroll for the bar, whatever a
        // fling is doing.)
        if (win_self[PANE_PAGE] > 0) bar_offset_kept(sv) else bar_scrolled(sv);
        find_place();
        back_scrolled(offset_y(sv))
    }
    win_scrolled(p);
    0
}

scroll_ended(_self: int, _cmd: int, sv: int): int {
    p: int = win_pane_of(sv);
    if (p == PANE_PANEL) win_rested(p);
    if (p == PANE_PAGE) {
        bar_settle();
        title_settle();
        reader_rested()
    }
    0
}

// The reader at rest after a scroll: what waited for it done, and core
// told.
reader_rested() {
    resting = true;
    if (text_size_due) {
        text_size_due = false;
        relayout_due = false;
        _r: int = text_size_changed(0, 0, 0)
    } else if (relayout_due) relayout();
    if (wk_due) width_relayout();
    win_rested(PANE_PAGE);
    resting = false
}

scroll_dragged(
    _self: int,
    _cmd: int,
    sv: int,
    decelerate: int
): int {
    if ((decelerate & 255) != 0) return 0;
    _r: int = scroll_ended(0, 0, sv);
    0
}

// A tap on the text: core's to make something of (ios/reader.l8's
// reader_tap says what was tapped).
tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    reader_tap(tv, hfa[0], hfa[1]);
    0
}

// When the reader last moved (scrollViewDidScroll:).
moved_at: f64 = 0.0f64;

// A touch that lands while the text is still moving only stops it, as in
// UIKit's own lists: the reader's tap ignores it (owner, 2026-10-18), and
// takes any other.
tap_receives(
    _self: int,
    _cmd: int,
    tap: int,
    _touch: int
): int {
    // (Only the reader's: the other taps app_obj is the delegate of take all.)
    if (table == 0 || (msg1(msg(tap, sel("view")), sel("isDescendantOfView:"), table) & 255) == 0) return 1;
    moving: bool = (msg(table, sel("isDecelerating")) & 255) != 0;
    if (moving || CACurrentMediaTime() - moved_at < 0.12f64) 0 else 1
}

// The tap is seen alongside the text view's own gestures.
together(
    _self: int,
    _cmd: int,
    _a: int,
    _b: int
): int {
    1
}

// (A popover stays one on a phone, rather than becoming a sheet; a wide
// window's form sheet, grown narrow, becomes a page sheet: §17.3.1.)
popover_style(
    _self: int,
    _cmd: int,
    controller: int,
    traits: int
): int {
    adapted_style(controller, traits)
}

// ---- the chapter's name, at the top ----
title_attrs(): int {
    keys[0] = k_font;
    values[0] = sans(17.0f64, 0.4f64);
    keys[1] = k_color;
    values[1] = c_ink;
    nsdictionary(keys, values, 2)
}

// The title made again (the theme's or the version's changed), for the
// place now, at once.
set_title() {
    title_btn_c[0] = -1;
    title_update(false)
}

// Button i of the title made to show chapter c's name (false: core has
// not said it yet).
title_config(i: int, c: int): bool {
    name: int = chapter_name(c);
    if (name == 0) return false;
    b: int = title_btn[i];
    title_btn_c[i] = c;
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    t: int = msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        name, title_attrs());
    if (title_version_word != 0) {
        keys[0] = k_font;
        values[0] = sans(13.0f64, 0.3f64);
        keys[1] = k_color;
        values[1] = c_faint;
        v: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
            msg1(nsstring("  "), sel("stringByAppendingString:"), title_version_word),
            nsdictionary(keys, values, 2));
        msg1(t, sel("appendAttributedString:"), v);
        release(v)
    }
    msg1(config, sel("setAttributedTitle:"), t);
    msg1(config, sel("setImage:"), symbol("chevron.down", 10.0f64, 7, c_faint));
    msg1(config, sel("setImagePlacement:"), 8);
    msg_set_f(config, sel("setImagePadding:"), 4.0f64);
    // (One line, cut at its end if it must be: never broken in a word.)
    msg1(config, sel("setTitleLineBreakMode:"), 4);
    msg1(b, sel("setConfiguration:"), config);
    msg1(b, sel("setAccessibilityLabel:"), name);
    msg1(b, sel("setAccessibilityValue:"), title_version_word);
    msg1(b, sel("setLargeContentTitle:"), name);
    msg1(b, sel("setAccessibilityHint:"), nsstring(w_title_hint));
    // (Its long press: the ribbons' menu, DESIGN.md §11.2.2.)
    title_menu_set(b, c);
    // (Its size: the title's at 17 pt (it doesn't grow, above), the
    // chevron's and the button's insets, or the button's own, if more;
    // never wider than the room between the bar's buttons, where it is cut
    // at its end (title_place). The configured button's sizeThatFits: is
    // not yet its new title's here: the configuration is applied at its
    // next layout.)
    l8_msg_hfa(hfa, t, sel("size"), 0, 0, 0);
    title_text_w = hfa[0] + 24.0f64;
    w: f64 = hfa[0] + 44.0f64;
    l8_msg_hfa(hfa, b, sel("intrinsicContentSize"), 0, 0, 0);
    if (hfa[0] + 4.0f64 > w) w = hfa[0] + 4.0f64;
    title_btn_w[i] = w;
    release(t);
    true
}

// What is shown over the chapters (a sheet, or a footnote), if any.
presented(): int {
    msg(nav, sel("presentedViewController"))
}

// ---- the theme, applied ----
// The page's color behind the bar and the status bar, and below it a short
// fade from the page's color to clear, so the text goes softly under the
// bar in every theme; its height follows the bar's (ios/bar.l8).
backdrop: int = 0;

backdrop_fade: int = 0;

backdrop_gradient: int = 0;

// The theme (and the look made from it) applied everywhere: crossfaded,
// when asked.
apply_theme(fade: bool) {
    make_colors();
    make_look();
    if (window == 0 || table == 0) return;
    if (fade) {
        t: int = make("CATransition");
        msg1(t, sel("setType:"), objc_const("kCATransitionFade"));
        msg_set_f(t, sel("setDuration:"), 0.25f64);
        msg2(msg(window, sel("layer")), sel("addAnimation:forKey:"), t, 0);
        release(t)
    }
    msg1(window, sel("setOverrideUserInterfaceStyle:"), if (set_theme == 0) 0 else if (is_dark()) 2 else 1);
    msg1(window, sel("setTintColor:"), c_accent);
    msg1(window, sel("setBackgroundColor:"), c_bg);
    msg1(table, sel("setBackgroundColor:"), c_bg);
    msg1(msg(nav, sel("view")), sel("setBackgroundColor:"), c_bg);
    msg1(msg(reader, sel("view")), sel("setBackgroundColor:"), c_bg);
    style_bar();
    set_title();
    msg(nav, sel("setNeedsStatusBarAppearanceUpdate"));
    style_tray();
    style_back();
    style_sheets();
    layout_player()
}

// The phone's light or dark mode changed: core told (Auto follows it, its
// look line).
reader_traits(self: int, cmd: int, previous: int): int {
    _r: int = super1(self, reader_class, cmd, previous);
    if (window == 0 || !core_begun) return 0;
    dark: bool = system_dark();
    if (dark != told_dark) {
        told_dark = dark;
        send1("dark", if (dark) 1 else 0)
    }
    0
}

told_dark: bool = false;

// The reader on the screen: where core said it is, once its parts can be
// laid out.
reader_appeared(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, reader_class, cmd, animated);
    appeared = true;
    win_appeared(PANE_PAGE);
    if (win_n[PANE_PAGE] > 0) reader_restored();
    set_insets();
    title_fade();
    layout_bar();
    0
}

// Whether the reader is on the screen, and the place core said before it
// was (or before it knew its chapters).
appeared: bool = false;

// An animated scroll (a glide's, the status bar's, Listen's) at its end:
// as a rest.
scroll_animated_end(_self: int, _cmd: int, sv: int): int {
    p: int = win_pane_of(sv);
    if (p < 0) return 0;
    if (p == PANE_PAGE) {
        status_c = -1;
        find_place()
    }
    win_glide_ended(p);
    0
}

// The chapter the status bar's tap is taking the reader to the top of
// (-1, none).
status_c: int = -1;

should_scroll_top(_self: int, _cmd: int, sv: int): int {
    if (!is_reader(sv)) return 1;
    status_top();
    0
}

status_top() {
    if (table == 0 || cur < 0) return;
    stop_moving();
    // (This chapter's top, or the one before's if it is there already: a
    // look, not a jump.)
    c: int = cur;
    y: f64 = win_chapter_top_offset(c);
    if (y > -1.0e8f64 && offset_y(table) <= y + 1.0f64) {
        c = cur - 1;
        if (c < 0) return;
        y = win_chapter_top_offset(c)
    }
    note_num("bible: status bar to ", c);
    bar_expand();
    // (Not in the window: there at once.)
    win_lead(PANE_PAGE);
    if (y < -1.0e8f64) {
        win_go(PANE_PAGE, c, -1, 0, PANE_GO_AT_ONCE);
        return
    }
    status_c = c;
    msg_ff1(table, sel("setContentOffset:animated:"), 0.0f64, y, 1)
}

// The page's offset that puts chapter c's opener under the bar (-1e9: its
// first part not in the window).
win_chapter_top_offset(c: int): f64 {
    i: int = win_row_of(PANE_PAGE, c, 0);
    if (i < 0) return -1.0e9f64;
    win_y[wr(PANE_PAGE, i)] - top_inset(table) - win_chapter_top_room(c)
}

// The app away: core told (its rests ended, what it keeps written).
app_background(_self: int, _cmd: int, _application: int): int {
    if (!core_begun) return 0;
    rest_tell();
    send0("away");
    0
}

// The phone's text size changed: the text made again, at the same place.
text_size_changed(_self: int, _cmd: int, _note: int): int {
    if (table == 0 || !restored) return 0;
    if (reader_moving()) {
        // (At rest: reader_rested.)
        text_size_due = true;
        return 0
    }
    make_look();
    set_insets();
    for p in 0..PANES win_rebuild(p);
    uk_restyle();
    // (Study beside the text, if it fits still at this size.)
    root_relayout();
    layout_bar();
    note("bible: text size changed");
    0
}

// ---- links: bsb://JHN/3 ----
// A link: core's to read (link ADDRESS), once it has begun.
pending_link: int = 0;

open_link(url: int) {
    if (url == 0) return;
    if (!core_begun) {
        pending_link = held(pending_link, url);
        return
    }
    to_core_str("link ");
    to_core_ns(msg(url, sel("absoluteString")));
    to_core_end()
}

// Links opened while the app runs, and the one it was opened with.
scene_links(
    _self: int,
    _cmd: int,
    _scene: int,
    contexts: int
): int {
    open_links(contexts);
    0
}

open_links(contexts: int) {
    c: int = msg(contexts, sel("anyObject"));
    if (c != 0) open_link(msg(c, sel("URL")))
}

// Whether diagnostics are written (L8_DEMO or L8_TIMING). (Survives a hot
// reload, whose startup does not run main.)
persistent diag_on: bool = false;

app_launched(
    self: int,
    _cmd: int,
    _application: int,
    _options: int
): int {
    app_obj = self;
    msg4(msg(cls("NSNotificationCenter"), sel("defaultCenter")), sel("addObserver:selector:name:object:"),
        self, sel("textSizeChanged:"), objc_const("UIContentSizeCategoryDidChangeNotification"),
        0);
    // (Before this returns: a notification that launched the app is given
    // to the delegate, DESIGN.md §10.2.2.)
    notify_setup();
    platform_begin();
    devwire_begin();
    1
}

// Hot reload (RELOAD.md): this build's app in the window the old build
// made, core begun again on what is kept (each data file read again into
// this build's datasets). Its classes are the first build's (class_make),
// a method new to one added. The old build's screens are emptied first:
// its globals, which kept them, are gone with it, so its views would live
// on with their text and drawing (each reload's, until there was no room
// for another build).
reload() {
    if (window == 0 || app_obj == 0) return;
    make_classes();
    old: int = msg(window, sel("rootViewController"));
    if (old != 0) {
        shown: int = msg(old, sel("presentedViewController"));
        while (shown != 0) {
            reload_emptied(msg(shown, sel("view")));
            shown = msg(shown, sel("presentedViewController"))
        }
        reload_emptied(msg(old, sel("view")))
    }
    msg1(window, sel("setRootViewController:"), 0);
    build_ui(scene_obj);
    platform_begin();
    devwire_begin()
}

// View v and those in it let go of the text they show, and of this app as
// their data source and delegate (so that they ask this build nothing).
// They stay where they are, UIKit's own views among them, to be let go as
// UIKit lets go of their controllers.
reload_emptied(v: int) {
    if (v == 0) return;
    subs: int = msg(msg(v, sel("subviews")), sel("copy"));
    for i in 0..msg(subs, sel("count")) reload_emptied(msg1(subs, sel("objectAtIndex:"),
        i));
    release(subs);
    if (is_a(v, "UITableView") && msg(v, sel("dataSource")) == app_obj) msg1(v, sel("setDataSource:"),
        0);
    if (is_a(v, "UIScrollView") && msg(v, sel("delegate")) == app_obj) msg1(v, sel("setDelegate:"),
        0);
    if (is_a(v, "UITextView")) msg1(v, sel("setAttributedText:"), msg(make("NSAttributedString"),
        sel("autorelease")));
    // (What it has drawn let go: a material's, a screen's size, most of all.)
    if (is_a(v, "UIVisualEffectView")) msg1(v, sel("setEffect:"), 0);
    msg1(msg(v, sel("layer")), sel("setContents:"), 0)
}

is_a(object: int, name: str): bool {
    (msg1(object, sel("isKindOfClass:"), cls(name)) & 255) != 0
}

// The app's one scene, connected: its window, the chapters in it.
scene_connected(
    _self: int,
    _cmd: int,
    scene: int,
    _session: int,
    options: int
): int {
    if (window != 0) return 0;
    window = msg1(msg(cls("UIWindow"), sel("alloc")), sel("initWithWindowScene:"),
        scene);
    scene_obj = scene;
    build_ui(scene);
    links: int = msg(options, sel("URLContexts"));
    if (links != 0) open_links(links);
    // (Core began before the window: told its size now.)
    if (core_ready_due) core_ready();
    0
}

// ---- core and the reader ----
// Whether core has begun (start sent), and whether it was ready before
// there was a window to measure.
core_begun: bool = false;

core_ready_due: bool = false;

// ready: core has its text; it is told the window's size, the screen's
// density, the phone's mode and time zone (start), the voices, a reminder
// that opened the app, and a link that came before.
core_ready() {
    if (window == 0) {
        core_ready_due = true;
        return
    }
    core_ready_due = false;
    l8_msg_hfa(hfa, window, sel("bounds"), 0, 0, 0);
    told_dark = system_dark();
    to_core_str("start");
    to_core_arg(hfa[2] as int);
    to_core_arg(hfa[3] as int);
    to_core_arg((msg_f(msg(cls("UIScreen"), sel("mainScreen")), sel("scale")) * 100.0f64) as int);
    to_core_arg(if (told_dark) 1 else 0);
    to_core_arg(msg(msg(cls("NSTimeZone"), sel("localTimeZone")), sel("secondsFromGMT")));
    to_core_end();
    voices_tell();
    core_begun = true;
    reminded_tell();
    if (pending_link != 0) {
        url: int = pending_link;
        pending_link = 0;
        open_link(url);
        release(url)
    }
}

// reader N: the reader has N chapters (a version's), each to be asked for
// again.
reader_count(n: int) {
    chapters_n = n;
    reader_forget();
    win_count_changed();
    title_btn_c[0] = -1
}

// look: the theme, the fonts, the text's size, its lines and margins.
look_changed() {
    apply_theme(restored);
    relayout()
}

// The bar's words: the chapter's name is the chapter's own (name, in its
// lines); the title line is core's for the place, kept for VoiceOver's
// value while no chapter is here.
title_words(text: int) {
    if (title_btn[0] != 0 && title_btn_c[0] < 0) msg1(title_btn[0], sel("setAccessibilityLabel:"),
        text)
}

// version ABBR: the version read, after the chapter's name in the bar
// (small and faint), so what is read is always said.
title_version_word: int = 0;

title_version(word: int) {
    if (word != 0 && title_version_word != 0 && (msg1(word, sel("isEqualToString:"),
        title_version_word) & 255) != 0) return;
    title_version_word = held(title_version_word, word);
    set_title()
}

// carried HEX WORDS: the ribbon carried (its color, "Reading with
// Morning"), or - none.
carried_color: int = 0;

carried_words: int = 0;

carried_line(line: WireLine) {
    color: int = word_color(line, 1);
    has: bool = color != 0;
    carried_color = held(carried_color, color);
    carried_words = held(carried_words, if (has) field_ns(line, 1) else 0);
    title_ribbon_update();
    title_place();
    title_actions(title_btn[0]);
    title_actions(compact_button)
}

// go P C I FRAC MODE: a pane to anchor I of chapter C (-1: its top), FRAC
// thousandths through its span; Go To's verse flashed on the page.
reader_go(
    p: int,
    c: int,
    i: int,
    frac: int,
    mode: int
) {
    if (p == PANE_PANEL) {
        win_go(p, c, i, frac, mode);
        return
    }
    stop_moving();
    bar_expand();
    win_go(PANE_PAGE, c, i, frac, mode);
    find_place();
    if (goto_due) {
        goto_due = false;
        v: int = win_anchor_verse(PANE_PAGE, c, i);
        if (v > 0) flash(c, v);
        back_arrived()
    }
    if (win_n[PANE_PAGE] > 0) reader_restored()
}

// A `goto` said (the sheets away): its jump, the next, flashes its verse.
goto_due: bool = false;

// The reader at core's place the first time: Study beside the text, open
// as it was left (§17.3.8).
reader_restored() {
    if (restored) return;
    restored = true;
    beside_restored()
}

// page 1|0: a screen down or up, less three lines (the page leads).
reader_page(down: bool) {
    if (table == 0) return;
    seen: f64 = view_height(table) - top_inset(table) - bottom_inset(table) - 3.0f64 * em * look_spacing;
    win_lead(PANE_PAGE);
    msg_ff1(table, sel("setContentOffset:animated:"), 0.0f64, offset_y(table) + (if (down) seen else -seen),
        if (reduce_motion()) 0 else 1)
}

// hearing C V: the verse being heard (C -1: none), washed.
hearing(c: int, v: int) {
    was: int = speak_c;
    speak_c = c;
    speak_v = v;
    if (was >= 0 && was != c) repaint(was);
    if (c >= 0) repaint(c)
}

// follow C V: Listen's verse brought into sight, if it is not.
reader_follow(c: int, v: int) {
    if (table == 0 || !restored || reader_moving()) return;
    i: int = win_anchor_of_verse(PANE_PAGE, c, v);
    r: int = win_row_of(PANE_PAGE, c, win_anchor_part(PANE_PAGE, c, i));
    if (r < 0 || i < 0) {
        win_go_verse(PANE_PAGE, c, v, PANE_GO_AT_ONCE);
        return
    }
    y: f64 = win_anchor_pos(PANE_PAGE, r, i, 0);
    top: f64 = offset_y(table) + top_inset(table);
    if (y >= top && y + em * 2.0f64 <= top + win_seen(PANE_PAGE)) return;
    msg_ff1(table, sel("setContentOffset:animated:"), 0.0f64, y - win_line_below(PANE_PAGE),
        if (reduce_motion()) 0 else 1)
}

// wake MS: core's tick at that time of the skin's clock.
wake_timer: int = 0;

reader_wake(at: int) {
    wake_timer = stop_timer(wake_timer);
    d: int = at - clock_ms();
    wake_timer = after_common((if (d < 50) 50 else d) as f64 / 1000.0f64, "coreTick:")
}

core_tick(_self: int, _cmd: int, _timer: int): int {
    wake_timer = 0;
    send1("tick", clock_ms());
    0
}

// Every part on the screen washed again (the selection let go).
reader_repaint_all() {
    win_repaint(PANE_PAGE, -1)
}

// What is marked changed: the page's parts asked for again, made again
// where they are.
reader_marks_changed() {
    win_remake(PANE_PAGE, -1)
}

// The app's views in its window: the reader, its bar, the tray.
build_ui(scene: int) {
    self: int = app_obj;
    make_colors();
    make_look();
    // The chapters, one after another.
    reader = msg1(msg(reader_class, sel("alloc")), sel("initWithStyle:"), 0);
    table = msg(reader, sel("tableView"));
    msg1(table, sel("setDataSource:"), self);
    msg1(table, sel("setDelegate:"), self);
    msg1(table, sel("setSeparatorStyle:"), 0);
    msg1(table, sel("setAllowsSelection:"), 0);
    // (No space for section headers: the first chapter rests at the top.)
    if (responds(table, "setSectionHeaderTopPadding:")) msg_set_f(table, sel("setSectionHeaderTopPadding:"),
        0.0f64);
    msg_set_f(table, sel("setSectionHeaderHeight:"), 0.0f64);
    msg_set_f(table, sel("setSectionFooterHeight:"), 0.0f64);
    msg_set_f(table, sel("setEstimatedSectionHeaderHeight:"), 0.0f64);
    msg_set_f(table, sel("setEstimatedSectionFooterHeight:"), 0.0f64);
    msg1(table, sel("setContentInsetAdjustmentBehavior:"), 2);
    msg1(reader, sel("setEdgesForExtendedLayout:"), 15);
    // (Room after Revelation 22, so the last lines scroll clear above the
    // back capsule, 12 + 36 + 12 points: room only at the very end, so no
    // inset changes and no text moves when the capsule comes or goes.)
    end_room: int = msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 0.0f64, 60.0f64);
    msg1(table, sel("setTableFooterView:"), end_room);
    release(end_room);
    win_attach(PANE_PAGE, table);
    // (The text fades softly under the bar, where there is glass.)
    if (responds(table, "topEdgeEffect")) {
        style: int = msg(cls("UIScrollEdgeEffectStyle"), sel("softStyle"));
        if (style != 0) msg1(msg(table, sel("topEdgeEffect")), sel("setStyle:"), style)
    }
    // The bar: search; the chapter's name, which opens Go To; the library
    // and the reading settings.
    b: int = keep(msg1(cls("UIButton"), sel("buttonWithType:"), 1));
    msg3(b, sel("addTarget:action:forControlEvents:"), self, sel("showPicker:"), 64);
    // (As a system bar's title: it doesn't grow with the text; a long press
    // at the largest sizes shows it large, ios/bar.l8's interaction.)
    msg1(b, sel("setMaximumContentSizeCategory:"), objc_const("UIContentSizeCategoryLarge"));
    msg1(b, sel("setShowsLargeContentViewer:"), 1);
    msg1(b, sel("setHidden:"), 1);
    title_btn[0] = b;
    title_btn_c[0] = -1;
    title_view = keep(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 120.0f64, TITLE_H));
    title_fader = keep(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 120.0f64, TITLE_H));
    msg1(title_view, sel("addSubview:"), title_fader);
    msg1(title_fader, sel("addSubview:"), title_btn[0]);
    title_ribbon = keep(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        ribbon_glyph(TITLE_GLYPH)));
    msg_set_f32(msg(title_ribbon, sel("layer")), sel("setOpacity:"), 0.0f64 as f32);
    title_ribbon_on = false;
    msg1(title_fader, sel("addSubview:"), title_ribbon);
    nav = msg1(msg(nav_class, sel("alloc")), sel("initWithRootViewController:"), reader);
    // (Its own bar hidden for good: the reader's is ios/bar.l8's.)
    msg2(nav, sel("setNavigationBarHidden:animated:"), 1, 0);
    make_bar();
    title_actions(title_btn[0]);
    title_actions(compact_button);
    root_attach();
    scene_least(scene);
    msg(window, sel("makeKeyAndVisible"));
    msg(window, sel("layoutIfNeeded"));
    make_tray();
    make_back();
    make_player_view();
    apply_theme(false);
    set_insets();
    layout_bar()
}

scene_window(_self: int, _cmd: int): int {
    window
}

// The app's classes (made once: at a hot reload, the host gives the ones
// made before back, their methods kept, this build's new ones added).
make_classes() {
    // The navigation controller, which hides the status bar with its bar.
    nav_class = class_make(cls("UINavigationController"), "L8Nav");
    add_method0(nav_class, sel("prefersStatusBarHidden"), &nav_status_hidden, "B@:");
    add_method0(nav_class, sel("childViewControllerForStatusBarHidden"), &nav_status_child,
        "@@:");
    add_method0(nav_class, sel("childViewControllerForStatusBarStyle"), &nav_status_child,
        "@@:");
    add_method0(nav_class, sel("preferredStatusBarUpdateAnimation"), &nav_status_animation,
        "q@:");
    add_method0(nav_class, sel("preferredStatusBarStyle"), &nav_status_style, "q@:");
    // The reader's controller: the phone's mode told to core; the place
    // found once it is on the screen; and the edit menu's commands.
    reader_class = class_make(cls("UITableViewController"), "L8Reader");
    add_method1(reader_class, sel("traitCollectionDidChange:"), &reader_traits, "v@:@");
    add_method1(reader_class, sel("viewDidAppear:"), &reader_appeared, "v@:B");
    add_method0(reader_class, sel("viewSafeAreaInsetsDidChange"), &reader_safe_area,
        "v@:");
    add_commands(reader_class);
    add_title_commands(reader_class);
    make_sheet_classes();
    make_platform_classes();
    make_ipad_classes();
    make_beside_classes();
    // The app's delegate, and every other delegate and data source.
    app: int = class_make(cls("UIResponder"), "L8BibleApp");
    add_method2(app, sel("application:didFinishLaunchingWithOptions:"), &app_launched,
        "B@:@@");
    add_method1(app, sel("applicationDidEnterBackground:"), &app_background, "v@:@");
    add_method1(app, sel("applicationWillTerminate:"), &app_background, "v@:@");
    add_method1(app, sel("scrollViewWillBeginDragging:"), &scroll_began, "v@:@");
    add_method1(app, sel("scrollViewDidScroll:"), &scrolled, "v@:@");
    add_method1(app, sel("scrollViewDidChangeAdjustedContentInset:"), &inset_changed,
        "v@:@");
    add_method1(app, sel("scrollViewDidEndDecelerating:"), &scroll_ended, "v@:@");
    add_method1(app, sel("scrollViewDidEndScrollingAnimation:"), &scroll_animated_end,
        "v@:@");
    add_method1(app, sel("scrollViewShouldScrollToTop:"), &should_scroll_top, "B@:@");
    add_method2(app, sel("scrollViewDidEndDragging:willDecelerate:"), &scroll_dragged,
        "v@:@B");
    add_method1(app, sel("tapped:"), &tapped, "v@:@");
    add_method2(app, sel("gestureRecognizer:shouldRecognizeSimultaneouslyWithGestureRecognizer:"),
        &together, "B@:@@");
    add_method2(app, sel("gestureRecognizer:shouldReceiveTouch:"), &tap_receives,
        "B@:@@");
    add_method2(app, sel("adaptivePresentationStyleForPresentationController:traitCollection:"),
        &popover_style, "q@:@@");
    add_method1(app, sel("textSizeChanged:"), &text_size_changed, "v@:@");
    add_method1(app, sel("coreTick:"), &core_tick, "v@:@");
    add_method1(app, sel("paneFill:"), &win_fill_fired, "v@:@");
    add_method1(app, sel("paneFollowGlide:"), &win_follow_glide_tick, "v@:@");
    add_method1(app, sel("pageOpened:"), &win_page_opened, "v@:@");
    add_method1(app, sel("panelOpened:"), &win_panel_opened, "v@:@");
    add_wire_methods(app);
    add_platform_methods(app);
    add_service_methods(app);
    add_select_methods(app);
    add_bar_methods(app);
    add_commands(app);
    add_sheet_methods(app);
    add_cell_methods(app);
    add_skin_methods(app);
    add_title_methods(app);
    add_ipad_methods(app);
    add_beside_methods(app);
    add_devwire_methods(app);
    add_protocol(app, "UIApplicationDelegate");
    add_protocol(app, "UITableViewDataSource");
    add_protocol(app, "UITableViewDelegate");
    add_protocol(app, "UICollectionViewDataSource");
    add_protocol(app, "UICollectionViewDelegate");
    add_protocol(app, "UIGestureRecognizerDelegate");
    add_protocol(app, "UITextFieldDelegate");
    add_protocol(app, "UIPopoverPresentationControllerDelegate");
    add_protocol(app, "UITextViewDelegate");
    add_protocol(app, "UISearchResultsUpdating");
    add_protocol(app, "UISearchBarDelegate");
    add_protocol(app, "UIAdaptivePresentationControllerDelegate");
    // The scene's delegate (UIKit makes it, from Info.plist's manifest): its
    // window is made with the app delegate's objects.
    scene: int = class_make(cls("UIResponder"), "L8BibleScene");
    add_method3(scene, sel("scene:willConnectToSession:options:"), &scene_connected,
        "v@:@@@");
    add_method1(scene, sel("sceneDidEnterBackground:"), &app_background, "v@:@");
    add_method2(scene, sel("scene:openURLContexts:"), &scene_links, "v@:@@");
    add_method0(scene, sel("window"), &scene_window, "@@:");
    add_ipad_scene_methods(scene);
    add_protocol(scene, "UIWindowSceneDelegate")
}

main(): int {
    diag_on = getenv("L8_DEMO") != null || getenv("L8_TIMING") != null;
    note("bible: starting");
    make_classes();
    note("bible: classes made; UIKit next");
    UIApplicationMain(l8rt_argc(), l8rt_argv(), 0, nsstring("L8BibleApp"))
}
