tag bible_ios;

use_tag std, ios, bible;

// The Study sheet (DESIGN.md §9.6.2): core's screen (core/verse_study.l8's
// SCR_VERSE_STUDY), Words · References · Commentary, as a sheet over the
// reader at its medium detent, or (ios/beside.l8) the panel beside the text
// on a wide window.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/lang.l8";

// The Study sheet of verse v of chapter c, from the tray (beside the text,
// where it fits).
open_study_verse(c: int, v: int) {
    if (presented() != 0) return;
    lang_load();
    if (!lang_ready) return;
    if (beside_fits()) {
        beside_open(c, v);
        return
    }
    // (Its panel's, hidden by the window's width, let go: one Study at a
    // time.)
    beside_discard();
    origin_c = c;
    origin_v = v;
    sheet_form(700.0f64, 860.0f64);
    uk_detents = 1;
    uk_medium = true;
    uk_open(SCR_VERSE_STUDY, (c * 1000 + v) * 4, false, 0)
}

// The interlinear of a verse (the study group's demo, the Words segment).
open_interlinear(c: int, v: int) {
    set_def_int("studySegment", 0);
    open_study_verse(c, v)
}

// Its chevrons moved it (core's study_moved): where the tray's way back
// goes, and the panel's verse.
study_verse_moved(c: int, v: int) {
    origin_c = c;
    origin_v = v;
    beside_moved(c, v)
}
