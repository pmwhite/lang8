tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 5 steps (DESIGN.md §10.6, re-pointed by §11.6): the
// `plans` group, shots 140 to 158, with the demo clock (today() is
// 2026-10-19 08:00): Go To's New Ribbon… and Reading Plans, the plans and
// a plan's detail, a plan started there and read (by the reader's rest, as
// a demo hook), Day Done, its row's unfinished days three days on; the
// plan's days (through its row's ⓘ), its Daily Reminder, its
// Time row (the shim's answer forced), a reminder opened, and (last) its
// authorization alert; Share as Image; exact senses and related words; the
// largest text; the recording's sequence 12; and a regression step for the
// lists popped under a theme's change (TestFlight 1.0 (11)'s crash). Each
// step does what the reader's own taps would, through the same functions.
import "../../ios/objc.l8";

import "../../ios/block.l8";

import "../core/text.l8";

// The first plan followed (Bible in a Year's, in this group's steps).
demo_plan(): int {
    if (fw_n > 0) fw_plan[0] else 0
}

genesis(n: int): int {
    book_first[0] + n - 1
}

// A chapter read as the reader would: its end shown, and 20 s of rest
// counted (the demo hook for the dwell).
demo_read(c: int) {
    go_place(c, ch_verses[c], 0);
    bar_set(0.0f64);
    rd_end[c] = true;
    rd_dwell[c] = RD_READ_AFTER;
    rd_sync();
    rd_check(c);
    rd_after()
}

// A completion handler of our own (a block), called as UIKit's would be:
// the path a notification's opening takes.
demo_handler_block: int = 0;

demo_handler(_block: int): int {
    note("bible: completion handler called");
    0
}

// Go To's plan row r tapped (Reading Plans after the last), and its Mark
// as Read, as VoiceOver's action does.
plan_picked(r: int) {
    if (r < fw_n) uk_tap(SCR_GOTO, ACT_GT_PLAN_TODAY, r) else uk_tap(SCR_GOTO, ACT_GT_PLANS,
        0)
}

// The plan's days' Daily Reminder switch (its first row's), or 0.
d5_switch(): int {
    t: int = uk_table_of(SCR_PLAN);
    cell: int = if (t != 0) msg1(t, sel("cellForRowAtIndexPath:"), msg2(cls("NSIndexPath"),
        sel("indexPathForRow:inSection:"), 0, 0)) else 0;
    sw: int = if (cell != 0) msg(cell, sel("accessoryView")) else 0;
    if (sw != 0 && responds(sw, "isOn")) sw else 0
}

plan_row_toggle(i: int) {
    uk_act_kind(SCR_GOTO, ACT_GT_PLAN_MARK, i)
}

demo_do5(t: int) {
    if (t == 240) {
        demo_dismiss();
        // (A place read before, for Recent.)
        history_here(john3(), 16);
        go_top(genesis(1));
        bar_set(0.0f64)
    }
    if (t == 241) open_picker();
    // Reading Plans, tapped; then Bible in a Year.
    if (t == 242) uk_tap(SCR_GOTO, ACT_GT_PLANS, 0);
    if (t == 243) plans_tap(PLAN_YEAR);
    if (t == 244) {
        // Its toolbar's Start Plan.
        _r: int = plan_start(0, 0, 0);
        demo_later_at(0.8f64, 300)
    }
    if (t == 245) {
        demo_dismiss();
        demo_read(genesis(1));
        demo_later_at(0.6f64, 301)
    }
    if (t == 246) {
        demo_dismiss();
        demo_read(genesis(2));
        demo_read(genesis(3))
    }
    if (t == 247) {
        demo_dismiss();
        demo_day_shift = 3;
        demo_later_at(0.4f64, 301)
    }
    if (t == 248) {
        demo_dismiss();
        demo_day_shift = 0;
        demo_later_at(0.4f64, 303)
    }
    if (t == 249) {
        // The plan's Daily Reminder turned on: the system's alert (the
        // shim's call). Last in the group: the alert outlives the app, and the
        // simulator cannot answer it. (The day's reader, put away first.)
        demo_dismiss();
        day_close(false);
        demo_later_at(0.4f64, 330)
    }
    if (t == 250) {
        // (The shim's answer, granted, as the demo gives it.)
        demo_dismiss();
        demo_grant();
        demo_later_at(0.6f64, 303)
    }
    if (t == 251) {
        demo_dismiss();
        go_top(genesis(1));
        if (demo_handler_block == 0) demo_handler_block = global_block0(&demo_handler);
        // (Day 2's reminder: Genesis 4–7, at its first unread chapter.)
        note("bible: reminder opened, day 2");
        day_open(demo_plan(), 2, -1);
        call_block(demo_handler_block)
    }
    if (t == 252) {
        demo_dismiss();
        hide_back();
        go_verse(john3(), 16);
        bar_set(0.0f64);
        toggle_verse(john3(), 16);
        demo_later_at(0.5f64, 304)
    }
    if (t == 253) {
        // (The share sheet's action chosen: the composer UIKit would show.)
        demo_dismiss();
        demo_later_at(0.4f64, 332)
    }
    if (t == 254) {
        if (sh_seg != 0) {
            msg1(sh_seg, sel("setSelectedSegmentIndex:"), 1);
            share_shape(0, 0, sh_seg)
        }
        share_pick_theme(4)
    }
    if (t == 255) {
        // Genesis 1:1's "God".
        share_finish(false);
        demo_dismiss();
        clear_selection();
        demo_later_at(0.5f64, 305)
    }
    if (t == 256) {
        // "N in this sense".
        uk_tap(SCR_STUDY, ACT_STUDY_CONC, 1)
    }
    if (t == 257) {
        demo_dismiss();
        demo_later_at(0.5f64, 306)
    }
    if (t == 258) {
        // φιλέω.
        for i in 0..ws_rel_n
            if (ws_rel_num[i] == 5368) open_lemma(ws_greek, 5368)
    }
    if (t == 259) {
        // (Go To at the largest text, scrolled to its Reading Plan section:
        // review r8-1.)
        demo_dismiss();
        demo_later_at(0.5f64, 348)
    }
    if (t == 260) demo_sequence5();
    if (t == 261) {
        // The lists popped, then the theme and the ESV changed under them.
        demo_dismiss();
        demo_later_at(0.4f64, 309)
    }
    // The title's change in place (owner, 2026-10-19): John 4's row walked
    // up a point at a time to 8 points short of the bar's bottom (John 3
    // named), then 8 points past it (John 4, the change logged), expanded
    // (262, 263) and compact (264, 265).
    if (t >= 262 && t <= 265) {
        before: bool = t == 262 || t == 264;
        if (before) {
            demo_dismiss();
            clear_selection();
            hide_back();
            bar_stop();
            // (John 4 at the top, laid out, then 200 points back up.)
            go_top(john3() + 1);
            set_offset(offset_y(table) - 200.0f64);
            bar_stop();
            bar_set(if (t == 264) 1.0f64 else 0.0f64);
            demo_title_walk(-100.0f64)
        }
        demo_title_walk(if (before) -8.0f64 else 8.0f64)
    }
    if (t == 268) {
        // Genesis 1's top: its name in the bar, the way to Go To.
        demo_dismiss();
        hide_back();
        bar_stop();
        go_top(0);
        bar_set(0.0f64);
        demo_title_note();
        b: int = title_btn[0];
        note_num("bible: Genesis 1's title shown ", if ((msg(b, sel("isHidden")) & 255) == 0) 1 else 0);
        note_num("bible:   takes taps ", msg(b, sel("isUserInteractionEnabled")) & 255)
    }
    // The status bar tapped (the same path as UIKit's): from John 3:14,
    // collapsed, to John 3's top; then (285) again, to John 2's.
    if (t == 269) {
        bar_stop();
        go_verse(john3(), 14);
        bar_set(1.0f64);
        note_num("bible: status bar tapped in ", cur);
        status_top()
    }
    if (t == 285) {
        note_num("bible: status bar tapped in ", cur);
        status_top()
    }
    if (t == 270) {
        // Exodus 20:3's "other gods" (H430J; review r5-1).
        demo_dismiss();
        demo_later_at(0.5f64, 340)
    }
    if (t == 271) {
        // Psalm 136:1's chesed, scrolled down to its related words.
        demo_dismiss();
        demo_later_at(0.5f64, 341)
    }
    if (t == 272) {
        // The plan stopped (its reminder on), then started again: its
        // Daily Reminder off (review r5-1).
        demo_dismiss();
        demo_later_at(0.4f64, 335)
    }
}

// How far John 4's row's top is up past the bar's bottom (in points), or
// -1000 if it is not on the screen.
demo_title_d(): f64 {
    c: int = john3() + 1;
    if (view_of(c) == 0) return -1000.0f64;
    offset_y(table) + bar_bottom() - row_y(c)
}

// The table moved a point at a time until the row's top is d past the bar's
// bottom, the bar's state left as it is; then what the title shows, logged.
demo_title_walk(d: f64) {
    n: int = 0;
    going: bool = true;
    while (going && n < 400) {
        n = n + 1;
        now: f64 = demo_title_d();
        gap: f64 = d - now;
        if (now < -999.0f64) {
            // (Not on the screen: toward it.)
            up: bool = row_y(john3() + 1) < offset_y(table) + top_inset(table);
            set_offset(offset_y(table) + (if (up) -40.0f64 else 40.0f64))
        } else if (gap < 0.5f64 && gap > -0.5f64) going = false else {
            step: f64 = if (gap > 1.0f64) 1.0f64 else if (gap < -1.0f64) -1.0f64 else gap;
            set_offset(offset_y(table) + step)
        }
    }
    demo_title_note()
}

// What the title shows, and where John 4's row is.
demo_title_note() {
    fbuf_n = 0;
    fput_str("bible: title shows ");
    if (title_btn_c[0] >= 0) fput_title(title_btn_c[0]);
    fput_str(", John 4's row past the bar by x10 ");
    fput_int((demo_title_d() * 10.0f64) as int);
    fput_str(", bar x100 ");
    fput_int((bar_p * 100.0f64) as int);
    fput_str(", scale x100 ");
    fput_int((title_scale() * 100.0f64) as int);
    note_ns(fstring())
}

// Word w of verse v of chapter c whose Strong's is num (Hebrew), its study
// as a sheet.
demo_study_of(c: int, v: int, num: int) {
    lang_load();
    vi: int = lang_verse(c, v);
    found: int = -1;
    for w in v_first(vi)..v_end(vi)
        if (found < 0 && !w_greek(w) && w_strongs(w) == num) found = w;
    if (found >= 0 && presented() == 0) open_study_sheet(vi, found)
}

// The later parts of the steps (demo_later's kinds 300 and up).
demo_later5(d: int) {
    // (What opens a sheet waits until no sheet is left.)
    opens: bool = d == 319 || d == 301 || d == 303 || d == 304 || d == 305 || d == 306 || d == 307 || d == 309 || d == 320 || d == 325 || d == 330 || d == 332 || d == 335 || d == 340 || d == 341 || d == 343 || d == 348;
    if (opens && presented() != 0) {
        demo_later_at(0.3f64, d);
        return
    }
    if (d == 300) {
        demo_dismiss();
        demo_later_at(0.5f64, 301)
    } else if (d == 301) open_picker() else if (d == 302) plan_row_details(0) else if (d == 303) {
        open_picker();
        demo_later_at(0.8f64, 302)
    } else if (d == 304) {
        share_verses(sel_c, sel_v, sel_n, 0);
        // (The share sheet comes from another process: a moment for it.)
        demo_later_at(1.5f64, 334)
    } else if (d == 334) { } else if (d == 305) {
        lang_load();
        vi: int = lang_verse(genesis(1), 1);
        for w in v_first(vi)..v_end(vi)
            if (!w_greek(w) && w_strongs(w) == 430 && presented() == 0) open_study_sheet(vi,
                w)
    } else if (d == 306) {
        lang_load();
        vi: int = lang_verse(john3(), 16);
        found: int = -1;
        for w in v_first(vi)..v_end(vi)
            if (found < 0 && w_greek(w) && w_strongs(w) == 25) found = w;
        if (found >= 0) open_study_sheet(vi, found);
        demo_later_at(0.8f64, 308)
    } else if (d == 307) open_picker() else if (d == 348) {
        open_picker();
        demo_later_at(1.0f64, 349)
    } else if (d == 349) {
        if (picker_table != 0) msg3(picker_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
            msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0, GT_PLAN_SECTION),
            1, 0)
    } else if (d == 308) {
        // (Scrolled down to the related words, their header in sight.)
        if (study_table != 0) {
            s: int = 0;
            s = uk_section_titled(SCR_STUDY, "Related Words");
            msg3(study_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
                msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0, s),
                1, 0);
            msg_ff1(study_table, sel("setContentOffset:animated:"), 0.0f64, offset_y(study_table) - 44.0f64,
                0)
        }
    } else if (d == 309) {
        open_settings();
        demo_later_at(0.8f64, 310)
    } else if (d == 310) {
        open_versions();
        demo_later_at(0.8f64, 311)
    } else if (d == 311) {
        demo_pop();
        demo_later_at(0.6f64, 312)
    } else if (d == 312) {
        open_acknowledgements();
        demo_later_at(0.8f64, 313)
    } else if (d == 313) {
        demo_pop();
        demo_later_at(0.6f64, 314)
    } else if (d == 314) {
        // (TestFlight 1.0 (11)'s crash: a theme picked after the lists
        // were popped; and the ESV listed, then not, under them.)
        listed: bool = def_bool("esvAvailable");
        esv_set_listed(!listed);
        esv_set_listed(listed);
        set_theme = 3;
        settings_changed(true);
        set_theme = 0;
        settings_changed(true);
        note("bible: popped lists survived the theme and the ESV")
    } else if (d == 320) {
        open_picker();
        demo_later_at(1.0f64, 321)
    } else if (d == 319) open_picker() else if (d == 321) {
        // The plan row's Mark as Read (its circle cross-fades).
        plan_row_toggle(0)
    } else if (d == 322) open_plans() else if (d == 323) demo_pop_animated() else if (d == 324) {
        dismiss_sheets();
        demo_later_at(0.4f64, 325)
    } else if (d == 325) {
        open_picker();
        demo_later_at(0.6f64, 302)
    } else if (d == 326) {
        // On (the answer forced) and the Time row fading in; then off.
        sw: int = d5_switch();
        if (sw != 0) msg2(sw, sel("setOn:animated:"), 1, 1);
        demo_grant()
    } else if (d == 327) {
        sw: int = d5_switch();
        if (sw != 0) {
            msg2(sw, sel("setOn:animated:"), 0, 1);
            uk_act_kind(SCR_PLAN, ACT_REMIND, plan_slot(detail_plan))
        }
    } else if (d == 328) {
        // The plan stopped and started again (its rows and reminder's
        // section fading; review r5-1).
        if (detail_table != 0) _r: int = plan_stop(0, 0, 0)
    } else if (d == 329) {
        // (Followed again, as Start Plan would: the days' rows and the
        // reminder's section fading in.)
        if (detail_table != 0) {
            _p: int = plan_follow(detail_plan, if (plan_is_day1(detail_plan)) pl_day1_c[detail_plan] else 0);
            uk_refresh()
        }
    } else if (d == 330) {
        open_picker();
        demo_later_at(0.8f64, 331)
    } else if (d == 331) {
        open_plan(demo_plan(), 0);
        demo_later_at(0.8f64, 333)
    } else if (d == 333) {
        sw: int = d5_switch();
        if (sw != 0) msg2(sw, sel("setOn:animated:"), 1, 1);
        notify_ask(1)
    } else if (d == 335) {
        open_picker();
        demo_later_at(0.8f64, 336)
    } else if (d == 336) {
        open_plan(demo_plan(), 0);
        demo_later_at(0.8f64, 337)
    } else if (d == 337) {
        note_num("bible: reminder before stopping ", if (reminders_any()) 1 else 0);
        plan_stop(0, 0, 0);
        demo_later_at(1.0f64, 338)
    } else if (d == 338) {
        // (Started again: back to Go To, Reading Plans, Bible in a Year,
        // Start Plan; then its days through its row's ⓘ.)
        demo_pop();
        demo_later_at(0.8f64, 346)
    } else if (d == 346) {
        plan_picked(fw_n);
        demo_later_at(0.8f64, 347)
    } else if (d == 347) {
        plans_tap(PLAN_YEAR);
        demo_later_at(0.8f64, 342)
    } else if (d == 342) {
        _r: int = plan_start(0, 0, 0);
        demo_later_at(1.0f64, 343)
    } else if (d == 343) {
        open_picker();
        demo_later_at(0.8f64, 344)
    } else if (d == 344) {
        plan_row_details(0);
        demo_later_at(0.8f64, 345)
    } else if (d == 345) {
        note_num("bible: reminder of the plan started ", if (reminders_any()) 1 else 0);
        if (detail_table != 0) msg_ff1(detail_table, sel("setContentOffset:animated:"),
            0.0f64, -top_inset(detail_table), 0)
    } else if (d == 340) demo_study_of(book_first[1] + 19, 3, 430) else if (d == 341) {
        demo_study_of(book_first[18] + 135, 1, 2617);
        demo_later_at(0.8f64, 308)
    } else if (d == 332) {
        sh_by_demo = true;
        msg3(nav, sel("presentViewController:animated:completion:"), make_composer(),
            1, 0);
        share_card_save("share-card.png")
    }
}

// The recording's sequence 12: the plan row's circle, Reading Plans pushed
// and popped, and the Daily Reminder on and off (the Time row fading in and
// out), the plan stopped and started.
demo_seq5_at: int = 0;

// (Its setup, step 341, before the recording's mark: Go To up, so that
// nothing inside the mark is the demo's own unanimated change; review
// r6-1.)
demo_sequence5_setup() {
    demo_dismiss();
    demo_later_at(0.3f64, 319)
}

demo_sequence5() {
    demo_seq5_at = 0;
    demo_seq5_timer = after(0.8f64, "demoSeq5:")
}

demo_seq5_timer: int = 0;

demo_seq5_steps: []int = [321, 322, 323, 324, 326, 327, 328, 329];

demo_seq5(_self: int, _cmd: int, _timer: int): int {
    demo_seq5_timer = 0;
    if (demo_seq5_at >= len(demo_seq5_steps)) return 0;
    d: int = demo_seq5_steps[demo_seq5_at];
    demo_seq5_at = demo_seq5_at + 1;
    demo_next = 0;
    demo_later5(d);
    demo_settle_start();
    demo_seq5_timer = after(if (d == 324) 1.4f64 else 1.6f64, "demoSeq5:");
    0
}

add_demo5_methods(app: int) {
    add_method1(app, sel("demoSeq5:"), &demo_seq5, "v@:@")
}
