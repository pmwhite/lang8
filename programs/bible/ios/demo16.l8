tag bible_ios;

use_tag std, ios, bible;

// The demo's §16 steps (DESIGN.md §16.8): in the `plans` group, shots 430
// to 454, on the demo clock, with the Chronological plan followed from 121
// days before (day 122 today, its days before it read: a day of several
// passages, Psalm 22 first), written by the demo as plan.tsv would be: the
// plans listed, the Chronological's days, Go To's row, the day's reader
// opened from it, its passages crossed, Mark Read, the day's end, Day Done,
// Next, the tray, a preview's Open in Reader and the capsule back, Listen
// through the day crossing a passage, M'Cheyne's Calendar started, a
// passage begun mid-chapter, the reminder opening the day, the ESV's
// placeholder in one passage, 1.0's plan.tsv, a carried ribbon left as it
// was, Night, the largest text, the title's plan's days, Old and New
// Together, and a relaunch with the day open; and the recording's sequence
// 21. Each tap is made through the function the control calls.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/plans.l8";

// Today's day of the Chronological, in the demo.
DD: int = 122;

// Every plan followed stopped (archived, as Stop Plan does).
d16_stop_all() {
    while (fw_n > 0) plan_archive(fw_n - 1)
}

// The Chronological followed alone, day DD today, the days before it read,
// and its Day Done not yet given today.
d16_seed() {
    daily_ready();
    if (day_on) day_close(false);
    d16_stop_all();
    _p: int = plan_follow(PLAN_CHRONO, 0);
    i: int = plan_slot(PLAN_CHRONO);
    fw_start[i] = today() - (DD - 1);
    for d in 1..DD mark_day(plan_day(PLAN_CHRONO, d), true, time(0) - (DD - d) * 86400);
    save_plan(i);
    daily_reschedule();
    note_num("bible: demo chronological, today day ", plan_today_of(i, today()))
}

// The day's passages, in the log: "bible: day shows Psalm 60; Psalm 108; …".
d16_log_day() {
    if (!day_on) return;
    fbuf_n = 0;
    fput_str("bible: day shows Day ");
    fput_int(day_num);
    fput_str(": ");
    fput_day(dy_di);
    fput_str(" (title ");
    if (day_k >= 0) fput_reading(day_k, false);
    fput_str(", capsule ");
    fput_str(if (mark_shown) if (day_state(dy_di) == 2) "Read" else "Mark Read" else "none");
    fput(41);
    note_ns(fstring())
}

// The page's end in sight (again, once the rows on the way are laid out:
// the size is an estimate till then).
d16_to_end() {
    for _i in 0..4 {
        l8_msg_hfa(hfa, table, sel("contentSize"), 0, 0, 0);
        set_offset(hfa[1] + bottom_inset(table) - view_height(table));
        msg(table, sel("layoutIfNeeded"))
    }
    find_place()
}

// The reference of passage i of the day's heading (as its run has it).
d16_heading_ref(i: int): int {
    k: int = pl_r0[dy_di] + i;
    xr_book = ch_book[pl_c1[k]];
    xr_c = ch_num[pl_c1[k]];
    xr_v = (if (passage_whole(k)) 0 else pl_v1[k]);
    xr_ce = ch_num[pl_c2[k]];
    xr_ve = (if (passage_whole(k)) 0 else pl_v2[k]);
    if (xr_ce == xr_c && xr_ve == xr_v) xr_ce = 0;
    xref_both()
}

// The ribbon carried for 449, and where it was.
d16_rb_c: int = -1;

d16_rb_v: int = 0;

d16_name: []i8 = new i8[16](0i8);

d16_handler: int = 0;

d16_handled(_block: int): int {
    note("bible: completion handler called");
    0
}

demo_do16(t: int) {
    if (t == 480) {
        // (The Chronological followed, day 122 today.)
        demo_dismiss();
        clear_selection();
        hide_back();
        listen_stop();
        d16_seed();
        go_top(john3());
        bar_set(0.0f64)
    }
    if (t == 481) {
        // 430: Go To, Reading Plans.
        open_picker();
        demo_later_at(0.8f64, 901)
    }
    // 431: the Chronological's description and days.
    if (t == 482) plans_tap(PLAN_CHRONO);
    if (t == 483) {
        // 432: back to Go To, its plan row today's passages.
        top: int = top_presented();
        if (top != 0) msg1(top, sel("popToRootViewControllerAnimated:"), 0)
    }
    if (t == 484) {
        // 433: the plan's row tapped: the day's reader comes up.
        plan_picked(0);
        demo_later_at(1.2f64, 920)
    }
    if (t == 485) {
        // 434: scrolled to the second passage: its name in the title.
        day_go_row(demo_day_row(1));
        bar_set(0.0f64);
        d16_log_day()
    }
    if (t == 486) {
        // 435: Mark Read: the day read (Day Done, today's).
        _r: int = day_mark_tapped(0, 0, 0);
        d16_log_day()
    }
    if (t == 487) {
        // 436: the day's end: its quiet "Day 122 is read", Next.
        d16_to_end();
        bar_set(0.0f64)
    }
    if (t == 488) {
        // 437: Mark Read again: the day unread (a toggle; §16.13).
        _r: int = day_mark_tapped(0, 0, 0);
        d16_log_day()
    }
    if (t == 489) {
        // 438: Next: day 123.
        _r: int = day_next(0, 0, 0);
        bar_set(0.0f64);
        demo_later_at(0.5f64, 920)
    }
    if (t == 490) {
        // 439: a verse selected: the tray, the capsule above it.
        toggle_verse(dy_c[0], dy_v1[0])
    }
    if (t == 491) {
        // 440: a heading's reference previewed, Open in Reader: the reader
        // there, its capsule "Day 123".
        clear_selection();
        open_preview(d16_heading_ref(1));
        demo_later_at(1.2f64, 902)
    }
    if (t == 492) {
        // 441: the capsule: the day where it was.
        _r: int = back_tapped(0, 0, 0);
        demo_later_at(1.2f64, 920)
    }
    if (t == 493) {
        // 442: Aa, Listen to Day 123 (the iPhone's voice, its verses short).
        set_audio_source(TEXT_BSB, SRC_VOICE);
        ls_demo_fast = true;
        open_settings();
        demo_later_at(1.0f64, 903)
    }
    if (t == 494) {
        // 443: the first passage's last verse, then on: the wash in the
        // second, the first read.
        if (ls_active && ls_day) {
            ls_row = 0;
            listen_restart_at(dy_c[0], day_row_last(0))
        }
        demo_later_at(4.5f64, 904)
    }
    if (t == 495) {
        // 444: M'Cheyne's Calendar started instead: its day 1.
        listen_stop();
        open_picker();
        demo_later_at(0.8f64, 905)
    }
    if (t == 496) {
        // 445: a passage begun mid-chapter (the Chronological's day 109, not
        // followed now: no capsule).
        k: int = pl_r0[plan_day(PLAN_CHRONO, 109)] + 2;
        day_open(PLAN_CHRONO, 109, k);
        bar_set(0.0f64);
        demo_later_at(0.6f64, 920)
    }
    if (t == 497) {
        // 446: today's reminder opened: today's day.
        day_close(false);
        if (d16_handler == 0) d16_handler = global_block0(&d16_handled);
        notify_open_plan(fw_num[0]);
        call_block(d16_handler);
        demo_later_at(1.2f64, 920)
    }
    if (t == 498) {
        // 447: the ESV: Genesis 1 comes (the fixture), Matthew 1 does not:
        // its placeholder only.
        switch_version(TEXT_ESV);
        day_open(PLAN_MCHEYNE, 1, -1);
        demo_later_at(2.0f64, 908)
    }
    if (t == 499) {
        // 448: 1.0's plan.tsv (Bible in a Year, READ lines): its days'
        // circles as 1.0 drew them.
        switch_version(TEXT_BSB);
        day_close(false);
        demo_dismiss();
        // (The plans followed stopped: a 1.0 install's files, plan.tsv alone,
        // migrated at the next read.)
        d16_stop_all();
        fbuf_n = 0;
        fput_str("PLAN\tyear\t");
        fput_iso_date(today() - 3);
        fput_str("""

READ	GEN	1	1792000000
READ	GEN	4	1792000100
READ	GEN	5	1792000200
READ	GEN	6	1792000300
READ	GEN	7	1792000400
READ	GEN	8	1792000500
""");
        write_file("plan.tsv");
        load_daily();
        for d in 1..5 note_num("bible: 1.0 day state x10 ", d * 10 + day_state(plan_day(PLAN_YEAR,
            d)));
        open_picker();
        demo_later_at(0.8f64, 909)
    }
    if (t == 500) {
        // 449: a ribbon carried (John 3:16), today's day opened, read, Done:
        // the ribbon where it was, the reader too.
        demo_dismiss();
        hide_back();
        d16_name[0] = 69i8;
        d16_name[1] = 118i8;
        d16_name[2] = 101i8;
        d16_name[3] = 110i8;
        _id: int = ribbon_make(d16_name, 4, john3(), 16, 0, time(0));
        ribbons_changed();
        ribbon_open(rb_n - 1);
        demo_later_at(1.0f64, 910)
    }
    if (t == 501) {
        // 450: Night.
        demo_dismiss();
        hide_back();
        day_open_today();
        demo_later_at(1.0f64, 912)
    }
    if (t == 502) {
        set_theme = 0;
        settings_changed(true)
    }
    // 451: the largest text, the day's end.
    if (t == 503) d16_to_end();
    // 452: the title tapped: the plan's days, today's selected.
    if (t == 504) day_title_tapped();
    if (t == 505) {
        // 453: Old and New Together's days.
        demo_dismiss();
        day_close(false);
        demo_later_at(0.6f64, 925)
    }
    if (t == 506) {
        // (454's: the day's reader up, a little way into it, as the app is
        // shut.)
        demo_dismiss();
        day_open_today();
        demo_later_at(1.2f64, 915)
    }
    if (t == 507) {
        // (Sequence 21's setup, before the recording's mark: the BSB again
        // after 447's ESV, the Chronological at day 122 again, Go To up.)
        demo_dismiss();
        switch_version(TEXT_BSB);
        day_close(false);
        hide_back();
        d16_seed();
        mark_day(plan_day(PLAN_CHRONO, DD), false, time(0));
        save_plan(plan_slot(PLAN_CHRONO));
        go_top(john3());
        bar_set(0.0f64);
        demo_later_at(0.4f64, 916)
    }
    if (t == 508) {
        ds_at = 0;
        ds_timer = after_common(0.6f64, "demoSeq16:")
    }
    // ---- §16.11, several plans at once ----
    if (t == 509) {
        // (The Chronological followed alone, day 122 today.)
        demo_dismiss();
        hide_back();
        d16_seed();
        go_top(john3());
        bar_set(0.0f64)
    }
    if (t == 510) {
        // 459b: M'Cheyne's detail, Start Plan while the Chronological is
        // followed.
        open_picker();
        demo_later_at(0.8f64, 922)
    }
    if (t == 511) {
        // (Started beside it: its day 1 comes up.)
        _r: int = plan_start(0, 0, 0);
        demo_later_at(2.0f64, 920)
    }
    if (t == 512) {
        // 455: Go To, a row each.
        day_close(false);
        open_picker()
    }
    if (t == 513) {
        // 456: Reading Plans, Following.
        open_plans()
    }
    if (t == 514) {
        // 457: the Chronological's day, its end: Also today, M'Cheyne's.
        demo_dismiss();
        day_open_today_of(plan_slot(PLAN_CHRONO));
        demo_later_at(1.4f64, 924)
    }
    if (t == 515) {
        // 458: Also today tapped: M'Cheyne's day 1.
        i: int = plan_slot(PLAN_MCHEYNE);
        b: int = msg(cls("UIButton"), sel("new"));
        msg1(b, sel("setTag:"), i + 1);
        _r: int = day_also(0, 0, b);
        release(b);
        demo_later_at(0.6f64, 920)
    }
    if (t == 516) {
        // 459 (logged): both in the reminder: "Today's Reading", a line
        // each.
        for i in 0..fw_n {
            fw_remind[i] = true;
            save_plan(i)
        }
        notify_schedule();
        also_today(PLAN_CHRONO, today());
        note_num("bible: also today from the Chronological ", al_n)
    }
}

// The later parts of the steps (demo_later's kinds 900 and up).
demo_later16(d: int) {
    if (d == 901) open_plans() else if (d == 902) {
        // (The preview's Open in Reader, as its toolbar's item sends it.)
        top: int = top_presented();
        if (top != 0) {
            item: int = msg(cls("UIBarButtonItem"), sel("new"));
            msg1(item, sel("setTag:"), d16_heading_ref(1));
            _r: int = preview_open(0, 0, item);
            release(item)
        }
        demo_later_at(1.2f64, 921)
    } else if (d == 903) {
        _r: int = listen_button_tapped(0, 0, 0);
        demo_later_at(1.5f64, 920)
    } else if (d == 904) d16_log_day() else if (d == 905) {
        open_plans();
        demo_later_at(0.8f64, 906)
    } else if (d == 906) {
        plans_tap(PLAN_MCHEYNE);
        demo_later_at(0.8f64, 907)
    } else if (d == 907) {
        _r: int = plan_start(0, 0, 0);
        demo_later_at(2.0f64, 920)
    } else if (d == 908) {
        // (Matthew 1's heading a little below the top, Genesis 1's end above
        // it.)
        r: int = demo_day_row(1);
        if (r > 0) {
            day_go_row(r);
            set_offset(offset_y(table) - 260.0f64);
            find_place()
        }
        bar_set(0.0f64);
        d16_log_day()
    } else if (d == 909) plan_row_details(0) else if (d == 910) {
        d16_rb_c = cur;
        measure_place();
        d16_rb_v = place_v;
        note_num("bible: ribbon carried before the day ", rb_carried_i());
        day_open_today();
        demo_later_at(1.5f64, 911)
    } else if (d == 911) {
        // (Read in the day, and marked read by its capsule.)
        set_offset(offset_y(table) + 400.0f64);
        find_place();
        _r: int = day_mark_tapped(0, 0, 0);
        demo_later_at(0.8f64, 914)
    } else if (d == 914) {
        day_close(true);
        demo_later_at(0.8f64, 917)
    } else if (d == 917) {
        measure_place();
        k: int = rb_carried_i();
        moved: bool = k < 0 || rb_c[k] != john3() || rb_v[k] != 16;
        fbuf_n = 0;
        fput_str(if (moved) "bible: ribbon moved by the day" else "bible: ribbon unmoved by the day");
        fput_str(if (cur == d16_rb_c && place_v == d16_rb_v) ", the reader where it was" else ", the reader moved");
        note_ns(fstring())
    } else if (d == 912) {
        set_theme = 4;
        settings_changed(true)
    } else if (d == 913) {
        open_plans();
        demo_later_at(0.8f64, 918)
    } else if (d == 918) plans_tap(PLAN_BOTH) else if (d == 915) {
        set_offset(offset_y(table) + 600.0f64);
        find_place();
        day_save_place();
        msg(defaults(), sel("synchronize"));
        d16_log_day()
    } else if (d == 922) {
        open_plans();
        demo_later_at(0.8f64, 923)
    } else if (d == 923) plans_tap(PLAN_MCHEYNE) else if (d == 924) {
        d16_to_end();
        bar_set(0.0f64);
        d16_log_day()
    } else if (d == 925) {
        open_picker();
        demo_later_at(0.8f64, 913)
    } else if (d == 916) open_picker() else if (d == 920) d16_log_day() else if (d == 921) {
        fbuf_n = 0;
        fput_str("bible: left the day for ");
        fput_title(cur);
        fput_str(if (back_shown && bk_n > 0 && bk_day[bk_n - 1] > 0) ", the capsule to its day" else ", no capsule to the day");
        note_ns(fstring())
    }
}

// ---- the recording's sequence 21 (DESIGN.md §16.8) ----
// The day opened from Go To's row (the slide up), scrolled across a passage
// (the title's cross-fade, the capsule's), Mark Read, scrolled to the end,
// Next (the cross-fade), Done (the slide down).
ds_at: int = 0;

ds_timer: int = 0;

demo_seq16(_self: int, _cmd: int, _timer: int): int {
    ds_timer = 0;
    at: int = ds_at;
    ds_at = ds_at + 1;
    wait: f64 = 1.6f64;
    if (at == 0) {
        plan_picked(0);
        wait = 2.2f64
    } else if (at == 1) {
        r: int = demo_day_row(1);
        if (r > 0) {
            l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), msg2(cls("NSIndexPath"),
                sel("indexPathForRow:inSection:"), r, 0), 0, 0);
            set_offset_animated(hfa[1] + day_row_gap(r) - em * 0.8f64 - top_inset(table))
        }
    } else if (at == 2) {
        _r: int = day_mark_tapped(0, 0, 0);
        wait = 1.2f64
    } else if (at == 3) {
        l8_msg_hfa(hfa, table, sel("contentSize"), 0, 0, 0);
        set_offset_animated(hfa[1] + bottom_inset(table) - view_height(table))
    } else if (at == 4) {
        _r: int = day_next(0, 0, 0);
        wait = 1.4f64
    } else if (at == 5) {
        day_close(true);
        wait = 1.2f64
    } else {
        demo_settle_start();
        return 0
    }
    note_num("bible: sequence 21 part ", at);
    ds_timer = after_common(wait, "demoSeq16:");
    0
}

add_demo16_methods(app: int) {
    add_method1(app, sel("demoSeq16:"), &demo_seq16, "v@:@")
}
