tag bible_ios;

use_tag std, ios, bible, bible_wire;

// Core's lines (SKINS.md), each done as the iPhone does it: a screen's
// effects by its lists (ios/skin.l8), the reader's by the chapters
// (ios/app.l8), the tray, toasts and the capsule (ios/select.l8), and what
// only the phone can do (ios/services.l8). A line the skin does not know
// is let be.
import "../../ios/objc.l8";

import "../core/wire.l8";

// Screen effects: done by the lists.
screen_effects: []str = ["present", "push", "update", "refill", "retext", "blur",
    "pop", "pop_to", "close", "dismiss", "present_over", "panel", "focus", "reveal"];

core_line(line: WireLine) {
    devwire_core_line(line);
    for word in screen_effects {
        if (wire_is(line, word)) {
            uk_apply_effect(UiEffect {
                word: word,
                a: if (has_word(line, 1)) word_n(line, 1) else -1,
                b: if (has_word(line, 2)) word_n(line, 2) else -1,
                text: ""
            });
            return
        }
    }
    if (wire_is(line, "ready")) core_ready() else if (wire_is(line, "reader")) reader_count(word_n(line,
        1)) else if (wire_is(line, "highlights")) highlights_line(line) else if (wire_is(line,
        "command")) command_line(line) else if (wire_is(line, "commands")) commands_line(line) else if (wire_is(line,
        "credit")) credit_line(line) else if (wire_is(line, "editcommand")) editcommand_line(line) else if (wire_is(line,
        "accessory")) accessory_line(line) else if (wire_is(line, "trayfit")) trayfit_line(line) else if (wire_is(line,
        "themes")) themes_line(line) else if (wire_is(line, "look")) {
        if (look_line(line)) look_changed()
    } else if (wire_is(line, "go")) {
        gp: int = word_n(line, 1);
        if (gp >= 0 && gp < PANES) reader_go(gp, word_n(line, 2), word_n(line, 3),
            word_n(line, 4), word_n(line, 5))
    } else if (wire_is(line, "arriving")) arriving_line(word_n(line, 1), word_n(line,
        2)) else if (wire_is(line, "arrived")) arrived_line(word_n(line, 1)) else if (wire_is(line,
        "halt")) {
        hp: int = word_n(line, 1);
        if (hp >= 0 && hp < PANES) win_halt(hp)
    } else if (wire_is(line, "forget")) {
        fp: int = word_n(line, 1);
        if (fp >= 0 && fp < PANES) win_forget(fp, word_n(line, 2));
        if (word_n(line, 2) < 0) win_maps_forget()
    } else if (wire_is(line, "line")) {
        lp: int = word_n(line, 1);
        if (lp >= 0 && lp < PANES) win_line[lp] = word_n(line, 2) as f64 / 1000.0f64
    } else if (wire_is(line, "title")) title_words(field_ns(line, 1)) else if (wire_is(line,
        "version")) title_version(field_ns(line, 1)) else if (wire_is(line, "carried")) carried_line(line) else if (wire_is(line,
        "title_menus")) title_menus_changed() else if (wire_is(line, "goto")) {
        // (The sheets away; the page's jump follows: ios/app.l8.)
        send1("jumped", 0);
        dismiss_sheets();
        back_jump_begin();
        goto_due = true
    } else if (wire_is(line, "page")) reader_page(word_n(line, 1) == 1) else if (wire_is(line,
        "selection")) selection_line(line) else if (wire_is(line, "hearing")) hearing(word_n(line,
        1), word_n(line, 2)) else if (wire_is(line, "follow")) reader_follow(word_n(line,
        1), word_n(line, 2)) else if (wire_is(line, "wake")) reader_wake(word_n(line,
        1)) else if (wire_is(line, "next")) core_next_soon() else if (wire_is(line,
        "beside")) beside_line(word_n(line, 1) == 1, word_n(line, 2) == 1) else if (wire_is(line,
        "back")) back_line(line) else if (wire_is(line, "awake")) keep_awake(word_n(line,
        1)) else if (wire_is(line, "tray")) update_tray() else if (wire_is(line, "tray_away")) tray_away() else if (wire_is(line,
        "clear_selection")) {
        sel_c = -1;
        sel_n = 0;
        tray_away();
        reader_repaint_all()
    } else if (wire_is(line, "highlighted")) {
        haptic_impact(0);
        reader_marks_changed()
    } else if (wire_is(line, "bookmarked")) {
        if (word_n(line, 1) == 1) haptic_impact(1);
        reader_marks_changed()
    } else if (wire_is(line, "marked")) {
        haptic_select();
        reader_marks_changed()
    } else if (wire_is(line, "felt")) {
        if (word_n(line, 1) == PX_FELT_WRONG) {
            top: int = top_presented();
            if (top != 0 && !reduce_motion()) fade_layer(msg(msg(top, sel("view")),
                sel("layer")), 0.15f64)
        } else haptic_select()
    } else if (wire_is(line, "announce")) {
        if ((UIAccessibilityIsVoiceOverRunning() & 255) != 0) UIAccessibilityPostNotification(objc_const("UIAccessibilityAnnouncementNotification"),
            field_ns(line, 1))
    } else if (wire_is(line, "toast")) toast_line(line) else if (wire_is(line, "copy")) {
        msg1(msg(cls("UIPasteboard"), sel("generalPasteboard")), sel("setString:"),
            field_ns(line, 1));
        haptic_success();
        toast(w_copied)
    } else if (wire_is(line, "share")) share_text(field_ns(line, 1)) else if (wire_is(line,
        "share_image")) share_card() else if (wire_is(line, "savefile")) save_file(field_ns(line,
        1), field_ns(line, 2)) else if (wire_is(line, "url")) open_web(field_ns(line,
        1)) else if (wire_is(line, "study_verse")) {
        tray_away();
        send2("versestudy", word_n(line, 1), word_n(line, 2))
    } else if (wire_is(line, "study_moved")) beside_moved(word_n(line, 1), word_n(line,
        2)) else if (wire_is(line, "say")) speech_say(line) else if (wire_is(line,
        "speech_stop")) speech_stop() else if (wire_is(line, "audio_play")) audio_play_line(line) else if (wire_is(line,
        "audio_stop")) audio_stop() else if (wire_is(line, "listen_pause")) listen_pause() else if (wire_is(line,
        "listen_resume")) listen_resume() else if (wire_is(line, "listen_stop")) listen_stop() else if (wire_is(line,
        "player")) player_line(line) else if (wire_is(line, "timer")) timer_line(word_n(line,
        1), word_n(line, 2)) else if (wire_is(line, "notify_ask")) notify_ask(word_n(line,
        1)) else if (wire_is(line, "notify_clear")) notify_clear() else if (wire_is(line,
        "notify")) notify_line(line) else if (wire_is(line, "open_settings")) open_system_settings() else if (wire_is(line,
        "refresh")) send0("refresh")
}
