tag bible_ios;

use_tag std, ios, bible;

// Learning Greek and Hebrew (DESIGN.md §14.2–§14.5, §14.10b) on the
// iPhone: what is kept (cards.tsv and its log, vocab.bin and letters.txt
// mapped at first use), the iPhone's Greek and Hebrew voices (behind
// LEARN_SPEECH, off: nothing is spoken), and the openers of the language
// page and what it pushes, core's screens (core/learn_screens.l8). The
// cards in Practice are ios/cards.l8; the interlinear's hiding and the
// word study's rows are ios/study.l8's.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/lang.l8";

import "../core/memory.l8";

import "../core/learn.l8";

// ---- the data, at first use ----
ln_mapped: bool = false;

// vocab.bin and letters.txt mapped and indexed (no more: cards.tsv needs
// only these).
ensure_learn() {
    if (ln_mapped) return;
    ln_mapped = true;
    lvoc = lang_map("vocab", "bin");
    lvoc_n = lang_mapped;
    llet = lang_map("letters", "txt");
    llet_n = lang_mapped;
    learn_index_files();
    note_num("bible: learn data, letters ", lt_n)
}

// And the language data (lang.l8's), for what reads the text.
ensure_learn_lang() {
    lang_load();
    ensure_learn();
    if (!learn_lang_ready) learn_index_lang()
}

// cards.tsv, at launch only if it is there (no file: nothing read).
load_cards() {
    read_file("cards.tsv");
    if (fbuf_n == 0) return;
    ensure_learn();
    read_file("cards.tsv");
    parse_cards(today());
    mev_n = 0;
    cdl_n = 0;
    note_num("bible: learn cards ", cd_n)
}

save_cards() {
    format_cards();
    write_file("cards.tsv");
    learn_flush()
}

// learn.l8's events onto the console (memory.l8's drain), and its log's
// lines onto cards-log.tsv.
learn_flush() {
    memory_flush();
    if (cdl_n > 0) {
        fbuf_n = 0;
        for k in 0..cdl_n fput(cdl[k] as int);
        append_file("cards-log.tsv");
        cdl_n = 0
    }
}

// A card added, graded, marked known or deleted: kept, the reminders
// scheduled again, the lists shown afresh.
cards_changed() {
    save_cards();
    orig_cards_changed();
    daily_reschedule();
    if (lib_table != 0 && sk_lib_seg == 3 && px_nav == 0) lib_refresh(false)
}

ln_speak_on(lang: int): bool {
    def_bool(if (lang == 0) "learnSpeakGreek" else "learnSpeakHebrew")
}

// ---- the voices (§14.4.2) ----
// No synthesized Greek or Hebrew is spoken anywhere (§14.10b.1: the
// iPhone's voices speak only modern Greek and Israeli Hebrew); kept for
// the commissioned recordings to use the same places (§14.14.2).
LEARN_SPEECH: bool = false;

ln_voice: []int = static_buffer([2]int);

ln_voice_read: []bool = static_buffer([2]bool);

ln_synth: int = 0;

// The best installed voice of a language (Premium, then Enhanced, then
// compact; any region), or 0.
ln_voice_of(lang: int): int {
    if (!LEARN_SPEECH) return 0;
    if (ln_voice_read[lang]) return ln_voice[lang];
    ln_voice_read[lang] = true;
    if (cls("AVSpeechSynthesisVoice") == 0) listen_frameworks();
    all: int = msg(cls("AVSpeechSynthesisVoice"), sel("speechVoices"));
    best: int = 0;
    best_q: int = -1;
    if (all != 0) {
        for i in 0..msg(all, sel("count")) {
            v: int = msg1(all, sel("objectAtIndex:"), i);
            l: int = msg(v, sel("language"));
            if (l != 0 && (msg1(l, sel("hasPrefix:"), nsstring(if (lang == 0) "el" else "he")) & 255) != 0) {
                q: int = msg(v, sel("quality"));
                if (q > best_q) {
                    best = v;
                    best_q = q
                }
            }
        }
    }
    if (best != 0) ln_voice[lang] = keep(best);
    fbuf_n = 0;
    fput_str("bible: learn voice ");
    fput_str(if (lang == 0) "el-GR " else "he-IL ");
    if (best == 0) fput_str("none") else {
        n: int = nsstring_into(msg(best, sel("name")), link_buf);
        for x in 0..n fput(link_buf[x] as int);
        fput_str(if (best_q >= 3) " (premium)" else if (best_q == 2) " (enhanced)" else " (compact)")
    }
    note_ns(fstring());
    ln_voice[lang]
}

// Whether a language can be spoken now (its switch on, and a voice).
ln_can_speak(lang: int): bool {
    LEARN_SPEECH && ln_speak_on(lang) && ln_voice_of(lang) != 0
}

// Bytes a to b of x said in a language (Greek monotonic, Hebrew as shown,
// maqaf a space), after what is being said; the reader's Listen and
// Practice's paused.
ln_say_more: bool = false;

ln_say(
    lang: int,
    x: []i8,
    a: int,
    b: int
) {
    if (!ln_can_speak(lang)) return;
    if (!ln_say_more) {
        listen_stop();
        if (pxa_mode != 0) px_au_stop();
        if (ln_synth == 0) ln_synth = make("AVSpeechSynthesizer");
        msg1(ln_synth, sel("stopSpeakingAtBoundary:"), 0)
    }
    if (lang == 0) speak_greek(x, a, b) else {
        sg_n = 0;
        p: int = a;
        while (p < b) {
            cp: int = cp_at(x, p, b);
            p = p + cp_len;
            // (No cantillation; the maqaf a space.)
            if (cp == 1470) sg_n = cp_put(sg, sg_n, 32) else if (!(cp >= 1425 && cp <= 1455)) sg_n = cp_put(sg,
                sg_n, cp)
        }
    }
    u: int = msg1(cls("AVSpeechUtterance"), sel("speechUtteranceWithString:"), nsstring_of(sg,
        sg_n));
    if (u == 0) return;
    msg1(u, sel("setVoice:"), ln_voice_of(lang));
    msg_set_f32(u, sel("setRate:"), 0.40f64 as f32);
    msg_set_f(u, sel("setPostUtteranceDelay:"), 0.25f64);
    msg1(ln_synth, sel("speakUtterance:"), u)
}

// A letter: its name, then its example (§14.4.2).
ln_say_letter(i: int) {
    lang: int = lt_lang[i];
    ln_say(lang, llet, lt_fb[i * 9 + LF_SPEAK], lt_fe[i * 9 + LF_SPEAK]);
    lt_example(i);
    ln_say_more = true;
    ln_say(lang, exm, 0, exm_n);
    ln_say_more = false
}

// ---- words and their text ----
// A paragraph style for original text: right to left (Hebrew) or not,
// aligned (0 left, 1 centred, 2 right), its lines' height.
orig_para(lang: int, align: int, lines: f64): int {
    p: int = msg(para_style(align, 0.0f64, 0.0f64, 0.0f64, 0.0f64, lines), sel("autorelease"));
    if (lang == 1) msg1(p, sel("setBaseWritingDirection:"), 1);
    p
}

// (A VoiceOver action's number: study.l8's.)
ln_action_key: []int = static_buffer([1]int);

// ---- Learn's lists: core's (core/learn_screens.l8), pushed in the sheet
// on top (the Library's, or the Study sheet's from the interlinear's
// link) ----
learn_push(kind: int, arg: int) {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    ensure_learn_lang();
    uk_open(kind, arg, true, sheet_nav)
}

open_language(lang: int) {
    learn_push(SCR_LANGUAGE, lang);
    note_num("bible: learn page ", lang)
}

open_alphabet() {
    learn_push(SCR_ALPHABET, sk_lg);
    note_num("bible: learn alphabet ", sk_lg)
}

open_pronunciation() {
    learn_push(SCR_PRON, sk_lg)
}

open_add_words() {
    learn_push(SCR_ADD_WORDS, sk_lg);
    fbuf_n = 0;
    fput_str("bible: learn add words, related ");
    fput_int(adw_related);
    fput_str(", from your reading ");
    fput_int(adw_n);
    note_ns(fstring())
}

open_readable() {
    learn_push(SCR_READABLE, sk_lg);
    fbuf_n = 0;
    fput_str("bible: learn readable ");
    fput_int(crv_readable);
    fput_str(", sections");
    for s in 0..5 {
        fput(32);
        fput_int(crv_count[s])
    }
    note_ns(fstring())
}

open_forms(greek: bool, num: int) {
    learn_push(SCR_FORMS, (if (greek) 100000 else 0) + num);
    fbuf_n = 0;
    fput_str("bible: learn forms ");
    fput(if (greek) 71 else 72);
    fput_int(num);
    fput_str(", ");
    fput_int(fo_total);
    fput_str(" times, ");
    fput_int(fs_n);
    fput_str(" sections");
    note_ns(fstring())
}

// Add Words' row from (core's WPV_MOST, WPV_RELATED, or a row) previewed.
open_word_preview(from: int) {
    uk_act_kind(SCR_ADD_WORDS, ACT_LN_PREVIEW, from)
}

// The reader in the Hebrew and Greek (core's read_in effect): at chapter
// and verse cv (c * 1000 + v), or the ribbon's place; the sheets away.
learn_read_in(cv: int, ribbon: int) {
    c: int = cv / 1000;
    v: int = cv % 1000;
    if (c < 0 || c >= chapters) return;
    dismiss_sheets();
    switch_version(TEXT_ORIG);
    if (v == 0) note(if (ch_book[c] >= 39) "bible: learn read in greek" else "bible: learn read in hebrew");
    if (ribbon >= 0) ribbon_open(ribbon) else if (ri_moves(c, v, cur)) jump(c, v)
}

// Read in Greek (Hebrew), as the language page's row does.
read_in(lang: int) {
    uk_sync();
    read_in_target(lang);
    learn_read_in(ri_c * 1000, ri_ribbon)
}

// Practice closed: the pages under it shown afresh.
learn_pages_refresh() {
    uk_refresh()
}

// The text's size changed: a card shown laid out again (the judgement
// row stacked or not), the pages' rows at the new size.
learn_text_size_changed() {
    if (crd_active) {
        crd_fill();
        px_toolbar(false)
    }
    uk_restyle()
}

make_learn_classes() {
    make_card_classes()
}

add_learn_methods(app: int) {
    add_card_methods(app)
}
