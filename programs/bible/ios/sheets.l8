    if (t == 0 || t == table || msg(t, sel("style")) != 0) return 0;
    if ((msg1(header, sel("isKindOfClass:"), cls("UITableViewHeaderFooterView")) & 255) == 0) return 0;
    config: int = msg(cls("UIBackgroundConfiguration"), sel("listPlainHeaderFooterConfiguration"));
    if (config == 0) return 0;
    msg1(config, sel("setBackgroundColor:"), c_bg);
    msg1(header, sel("setBackgroundConfiguration:"), config);
