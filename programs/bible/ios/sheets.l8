// The screens with lists the app's object answers for, and what each lets
// go when the sheets are gone, in this order.
sheet_screens_made() {
    sheets_screens();
    study_screens();
    daily_screens();
    ribbons_screens();
    uk_screens();
    compare_screens();
    memory_screens();
    practice_screens();
    // (The page as it was before the original's reader is laid out again.)
    on_sheet_gone(&sheet_page_back);
    orig_screens();
    audio_screens()
}
