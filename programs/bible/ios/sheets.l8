// Go To's list, first laid out: at core's focus (aimed at the panel or
// from Reading's Version, what that pane reads, in the middle); aimed at
// the page, none: its top, what there is to read in sight.
books_class: int = 0;

search_class: int = 0;

books_layout(self: int, cmd: int): int {
    super0(self, books_class, cmd);
    list: int = msg(self, sel("tableView"));
    if (msg(list, sel("tag")) != 0) return 0;
    msg1(list, sel("setTag:"), 1);
    // (Core's focus: none where the top is to be seen.)
    uk_show_focus(list);
    0
}

// ---- LORD and GOD in small capitals, outside the reader too ----
// The small capitals for a size: of the body (made smaller by hand, for
// fonts without their own), or of the system's font.
caps_font(serif_face: bool, size: f64): int {
    if (serif_face && caps_by_hand) return body(size * 0.8f64);
    if (serif_face) return small_caps(size);
    keys[0] = objc_const("UIFontFeatureTypeIdentifierKey");
    values[0] = msg1(cls("NSNumber"), sel("numberWithLong:"), 38);
    keys[1] = objc_const("UIFontFeatureSelectorIdentifierKey");
    values[1] = msg1(cls("NSNumber"), sel("numberWithLong:"), 1);
    one_object[0] = nsdictionary(keys, values, 2);
    keys[0] = objc_const("UIFontDescriptorFeatureSettingsAttribute");
    values[0] = nsarray(one_object, 1);
    d: int = msg1(msg(sans(size, 0.0f64), sel("fontDescriptor")), sel("fontDescriptorByAddingAttributes:"),
        nsdictionary(keys, values, 1));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

// Row's divine names (core's caps: its detail's UTF-16 places) in s, its
// detail at s's start, set in small capitals.
row_caps_into(
    s: int,
    row: UiRow,
    serif_face: bool,
    size: f64
) {
    if (row.caps_n == 0) return;
    f: int = caps_font(serif_face, size);
    for m in 0..row.caps_n {
        b: int = uk_ui.marks[row.caps + m * 2];
        n: int = uk_ui.marks[row.caps + m * 2 + 1] - b;
        msg4(s, sel("addAttribute:value:range:"), k_font, f, b, n);
        if (serif_face && caps_by_hand) msg4(s, sel("addAttribute:value:range:"),
            k_kern, nsnumber_f(size * 0.02f64), b, n)
    }
}

// A verse's words for a list's second line: in the body's face or the
// system's, at a size and color.
// A Library row's size: size points at the default text size, scaled as
// the Subheadline style is (so the rows grow with Dynamic Type, in step
// with their state lines and headers).
lib_pt(size: f64): f64 {
    m: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleSubheadline"));
    if (m == 0) return size;
    msg_f(msg1(m, sel("scaledFontForFont:"), sans(size, 0.0f64)), sel("pointSize"))
}

preview(
    text: int,
    serif_face: bool,
    size: f64,
    color: int
): int {
    keys[0] = k_font;
    values[0] = (if (serif_face) body(size) else sans(size, 0.0f64));
    keys[1] = k_color;
    values[1] = color;
    msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        if (text == 0) nsstring("") else text, nsdictionary(keys, values, 2)), sel("autorelease"))
}

// A scripture row's detail as preview's, its divine names in small
// capitals.
row_preview(
    row: UiRow,
    serif_face: bool,
    size: f64,
    color: int
): int {
    s: int = preview(if (row.detail.n > 0) uk_text(row.detail) else nsstring(""),
        serif_face, size, color);
    row_caps_into(s, row, serif_face, size);
    s
}

show_search(_self: int, _cmd: int, _sender: int): int {
    if (presented() == 0) send0("tap search");
    0
}

// Search coming on screen: its field active, ready to type in, as the sheet
// rises (so the keyboard, the field's clear button and the scopes come with
// it, rather than popping in after).
search_appeared(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, search_class, cmd, animated);
    sc: int = msg(msg(self, sel("navigationItem")), sel("searchController"));
    if (sc != 0) msg(msg(sc, sel("searchBar")), sel("becomeFirstResponder"));
    0
}

show_library(_self: int, _cmd: int, _sender: int): int {
    if (presented() == 0) send0("tap library");
    0
}

// Each place q is in a (case aside), in font f, in ink.
bold_matches(a: int, q: int, f: int) {
    text: int = msg(a, sel("string"));
    n: int = msg(text, sel("length"));
    ql: int = msg(q, sel("length"));
    at: int = 0;
    more: bool = ql > 0;
    while (more && at < n) {
        loc: int = msg4(text, sel("rangeOfString:options:range:"), q, 1, at, n - at);
        if (loc < 0 || loc >= n) more = false else {
            msg4(a, sel("addAttribute:value:range:"), k_font, f, loc, ql);
            msg4(a, sel("addAttribute:value:range:"), k_color, c_ink, loc, ql);
            at = loc + ql
        }
    }
}

show_settings(_self: int, _cmd: int, _sender: int): int {
    if (presented() == 0) send0("tap settings");
    0
}

// A text view typed in: core's field of many lines (a note's).
text_changed(_self: int, _cmd: int, tv: int): int {
    _p: bool = uk_prose_changed(tv);
    0
}

// ---- the tables' data, for every table ----
// The reader's own (and the day's), then the screen showing the table
// (tables.l8: sheet_screens_made says which they are).
table_sections(_self: int, _cmd: int, t: int): int {
    // (A pane's words are its header's, ios/pane.l8.)
    if (is_reader(t) || is_panel_reader(t)) return 0;
    i: int = table_find(t);
    if (i < 0) return 0;
    f: fn(t: int): int = table_screens[i].sections;
    f(t)
}

table_rows(
    _self: int,
    _cmd: int,
    t: int,
    section: int
): int {
    if (is_reader(t) || is_panel_reader(t)) return 0;
    i: int = table_find(t);
    if (i < 0) return 0;
    f: fn(t: int, section: int): int = table_screens[i].rows;
    f(t, section)
}

table_header(
    _self: int,
    _cmd: int,
    t: int,
    section: int
): int {
    i: int = table_find(t);
    if (i < 0) return 0;
    f: ?fn(t: int, section: int): int = table_screens[i].header;
    if (f == null) 0 else f(t, section)
}

table_footer(
    _self: int,
    _cmd: int,
    t: int,
    section: int
): int {
    i: int = table_find(t);
    if (i < 0) return 0;
    f: ?fn(t: int, section: int): int = table_screens[i].footer;
    if (f == null) 0 else f(t, section)
}

table_header_view(
    _self: int,
    _cmd: int,
    t: int,
    section: int
): int {
    i: int = table_find(t);
    if (i < 0) return 0;
    f: ?fn(t: int, section: int): int = table_screens[i].header_view;
    if (f == null) 0 else f(t, section)
}

// A plain list's header about to show (search's count of verses found):
// the page's own color behind it, so pinned under the bar it covers the
// rows passing under it rather than lying over their words (iOS 26 draws
// no material behind a plain header).
table_will_show_header(
    _self: int,
    _cmd: int,
    t: int,
    header: int,
    _section: int
): int {
    if (t == 0 || t == table || msg(t, sel("style")) != 0) return 0;
    if ((msg1(header, sel("isKindOfClass:"), cls("UITableViewHeaderFooterView")) & 255) == 0) return 0;
    config: int = msg(cls("UIBackgroundConfiguration"), sel("listPlainHeaderFooterConfiguration"));
    if (config == 0) return 0;
    msg1(config, sel("setBackgroundColor:"), c_bg);
    msg1(header, sel("setBackgroundConfiguration:"), config);
    0
}

table_footer_view(
    _self: int,
    _cmd: int,
    t: int,
    section: int
): int {
    i: int = table_find(t);
    if (i < 0) return 0;
    f: ?fn(t: int, section: int): int = table_screens[i].footer_view;
    if (f == null) 0 else f(t, section)
}

// The credits core says (credit K WORDS LINK ADDRESS LABEL): each one's
// words, its link's and address, and VoiceOver's label (kept; 0 none).
CREDIT_MOST: int = 8;

credit_words: []int = new int[8](0);

credit_links: []int = new int[8](0);

credit_addresses: []int = new int[8](0);

credit_labels: []int = new int[8](0);

credit_line(line: WireLine) {
    k: int = word_n(line, 1);
    if (k <= 0 || k >= CREDIT_MOST) return;
    credit_words[k] = held(credit_words[k], field_ns(line, 1));
    credit_links[k] = held(credit_links[k], field_ns(line, 2));
    credit_addresses[k] = held(credit_addresses[k], field_ns(line, 3));
    credit_labels[k] = held(credit_labels[k], field_ns(line, 4))
}

// Credit k under a list ("(ESV) · esv.org", the link to its site); 0 if
// core has not said it.
credit_view(k: int): int {
    if (k <= 0 || k >= CREDIT_MOST || credit_words[k] == 0) return 0;
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    keys[0] = k_font;
    values[0] = sans(13.0f64, 0.0f64);
    keys[1] = k_color;
    values[1] = c_faint;
    msg1(s, sel("appendAttributedString:"), attributed_str(credit_words[k], nsdictionary(keys,
        values, 2)));
    values[1] = c_accent;
    msg1(s, sel("appendAttributedString:"), attributed_str(credit_links[k], nsdictionary(keys,
        values, 2)));
    msg2(b, sel("setAttributedTitle:forState:"), s, 0);
    msg1(b, sel("setTag:"), k);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("esvOrg:"), 64);
    msg1(b, sel("setAccessibilityLabel:"), credit_labels[k]);
    msg_rect(b, sel("setFrame:"), 0.0f64, 0.0f64, 300.0f64, 44.0f64);
    b
}

// A credit's link tapped: its address.
esv_org(_self: int, _cmd: int, b: int): int {
    k: int = msg(b, sel("tag"));
    if (k > 0 && k < CREDIT_MOST && credit_addresses[k] != 0) open_web_ns(credit_addresses[k]);
    0
}

table_cell(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    i: int = table_find(t);
    // (A list no screen has, asked for a cell: an empty one.)
    if (i < 0) return list_cell(t, "none", 0);
    f: fn(t: int, path: int): int = table_screens[i].cell;
    f(t, path)
}

table_picked(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    if (is_reader(t)) return 0;
    msg2(t, sel("deselectRowAtIndexPath:animated:"), path, 1);
    i: int = table_find(t);
    if (i < 0) return 0;
    f: ?fn(t: int, section: int, row: int) = table_screens[i].picked;
    if (f != null) f(t, msg(path, sel("section")), msg(path, sel("row")));
    0
}

table_can_edit(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    i: int = table_find(t);
    if (i < 0) return 0;
    f: ?fn(t: int, path: int): bool = table_screens[i].can_edit;
    if (f != null && f(t, path)) 1 else 0
}

table_commit(
    _self: int,
    _cmd: int,
    t: int,
    style: int,
    path: int
): int {
    i: int = table_find(t);
    if (i < 0) return 0;
    f: ?fn(t: int, style: int, path: int) = table_screens[i].commit;
    if (f != null) f(t, style, path);
    0
}

// The swipe's word: Delete, but where a screen says otherwise.
table_delete_title(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    i: int = table_find(t);
    f: ?fn(t: int, path: int): int = if (i < 0) null else table_screens[i].delete_title;
    if (f == null) nsstring(w_delete) else f(t, path)
}

table_accessory(
    _self: int,
