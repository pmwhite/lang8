tag bible_ios;

use_tag std, ios, bible, bible_wire;

// The sheets over the reader that core's screens are shown in (ios/
// skin.l8): made, presented and let go; the bar's buttons, which ask core
// for Go To, Search, the Library and the reading settings; and the lists'
// data source and delegate, each list's answered by the screen showing it
// (tables.l8).
import "../../ios/objc.l8";

import "../core/text.l8";

import "tables.l8";

// The reading settings' sheet (0 when not shown), for its popover's look.
settings_nav: int = 0;

// ---- sheets ----
// A navigation controller of root, as a sheet with a grabber: detents
// (0 large, 1 medium and large starting large, 2 medium only).
sheet_of(root: int, detents: int): int {
    sheet_nav: int = msg1(msg(sheet_nav_class, sel("alloc")), sel("initWithRootViewController:"),
        root);
    // (In a wide window, a form sheet or popover if one was asked for:
    // ios/ipad.l8's sheet_form, §17.3.1.)
    if (sheet_form_take(sheet_nav)) {
        msg1(msg(sheet_nav, sel("presentationController")), sel("setDelegate:"), app_obj);
        return msg(sheet_nav, sel("autorelease"))
    }
    sheet: int = msg(sheet_nav, sel("sheetPresentationController"));
    if (sheet != 0) {
        msg1(sheet, sel("setPrefersGrabberVisible:"), 1);
        det: int = cls("UISheetPresentationControllerDetent");
        if (detents == 1) {
            one[0] = msg(det, sel("mediumDetent"));
            one[1] = msg(det, sel("largeDetent"));
            msg1(sheet, sel("setDetents:"), nsarray(one, 2));
            msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierLarge"))
        } else if (detents == 2) {
            one[0] = msg(det, sel("mediumDetent"));
            msg1(sheet, sel("setDetents:"), nsarray(one, 1));
            msg1(sheet, sel("setLargestUndimmedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierMedium"));
            msg1(sheet, sel("setPrefersScrollingExpandsWhenScrolledToEdge:"), 0)
        }
    }
    msg1(msg(sheet_nav, sel("presentationController")), sel("setDelegate:"), app_obj);
    msg(sheet_nav, sel("autorelease"))
}

// A system bar button (0 Done, 1 Cancel, 16 Trash) sending action to the app.
system_item(kind: int, action: str): int {
    msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        kind, app_obj, sel(action)), sel("autorelease"))
}

// A sheet's Done: a check in the words' color on the bar's plain glass,
// not the system's Done (filled in the accent on every sheet: the loudest
// thing on the screen at a routine moment).
done_item(): int {
    b: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol("checkmark", 17.0f64, 5, 0), 0, app_obj, sel("closeSheet:")), sel("autorelease"));
    msg1(b, sel("setTintColor:"), c_ink);
    msg1(b, sel("setAccessibilityLabel:"), nsstring("Done"));
    b
}

// A sheet over the reader, its bar expanding alongside (never a sheet
// over a collapsed bar); a rest of the reader's (DESIGN.md §11.1.1).
present(vc: int) {
    rest_tell();
    bar_expand();
    sheet_zoom_from(vc);
    msg3(sheet_presenter(), sel("presentViewController:animated:completion:"), vc,
        1, 0)
}

// ---- a sheet grows from what opened it (iOS 26's zoom) ----
// On iOS 26, where a sheet morphing out of the control that opened it is
// the system's design, a sheet of core's grows from that control and
// shrinks back into it: Go To from the title of the pane it goes to,
// the Library from its button, both of them over the whole page. Reading
// (half height, over the text being read) slides up from the foot, as the
// panel does; History and Search have no control of their own on an
// iPhone (Go To pushes them). Elsewhere, and where its control isn't in
// sight, UIKit's slide from the foot. (The zoom came in iOS 18; it is
// used, and checked, only on iOS 26.)
//
// No control is kept: the provider, asked as the sheet opens and again as
// it closes, finds the control from the sheet it is asked for (its
// context's zoomedViewController) among the views there are then, so a
// control let go meanwhile (the panel's title, the panel put away under Go
// To) is never asked for.

// The provider (made once a process, kept through a hot reload as other
// blocks UIKit keeps are).
persistent sheet_zoom_provider: int = 0;

// Whether this iOS is one that zooms sheets (iOS 26: the zoom from a bar
// button item, which came with it, is there).
sheet_zooms(): bool {
    transitions: int = cls("UIViewControllerTransition");
    transitions != 0 && (msg1(transitions, sel("respondsToSelector:"), sel("zoomWithOptions:sourceBarButtonItemProvider:")) & 255) != 0
}

// The control sheet vc (a navigation controller of core's screens, its
// first the one it was opened for) opens from, while it is in sight (in
// the window, nothing holding it hidden or faded out: a collapsed bar's
// title); else 0.
sheet_zoom_source_of(vc: int): int {
    if (vc == 0) return 0;
    // (Its screen's kind and argument, told to the sheet as it was
    // presented: by its close, the screen may have been let go.)
    told: int = objc_getAssociatedObject(vc, ints_address(sheet_zoom_key));
    kind: int = -1;
    arg: int = 0;
    if (told != 0) {
        kind = msg(msg1(told, sel("objectAtIndex:"), 0), sel("longValue"));
        arg = msg(msg1(told, sel("objectAtIndex:"), 1), sel("longValue"))
    } else {
        nav: bool = (msg1(vc, sel("isKindOfClass:"), cls("UINavigationController")) & 255) != 0;
        screens: int = if (nav) msg(vc, sel("viewControllers")) else 0;
        first: int = if (!nav) vc else if (screens == 0 || msg(screens, sel("count")) == 0) 0 else msg1(screens,
            sel("objectAtIndex:"), 0);
        for k in 0..UK_SLOTS {
            if (first != 0 && uk_vcs[k] == first) {
                kind = uk_kind_of(uk_ids[k]);
                arg = uk_arg_of(uk_ids[k])
            }
        }
        if (kind >= 0) {
            sheet_zoom_told[0] = nsnumber_int(kind);
            sheet_zoom_told[1] = nsnumber_int(arg);
            objc_setAssociatedObject(vc, ints_address(sheet_zoom_key), nsarray(sheet_zoom_told,
                2), 1)
        }
    }
    source: int = if (kind == SCR_GOTO) if (arg == GOTO_PANEL && bs_shown && bs_head != 0) bs_head else title_btn[0] else if (kind == SCR_LIBRARY) bar_buttons[BAR_LIBRARY] else 0;
    if (source == 0) return 0;
    if (msg(source, sel("window")) == 0) {
        note("bible: sheet: its control is not in the window");
        return 0
    }
    // (The control's own opacity is not asked: UIKit hides it while the
    // sheet is grown from it, and asks again as the sheet closes.)
    // (Nor what UIKit does to the panel's sheet: it hides the sheet while a
    // full-height one covers it, and shows it again as that one goes, so
    // the walk stops at the panel's own view.)
    panel_view: int = if (bs_nav == 0) 0 else msg(bs_nav, sel("view"));
    v: int = msg(source, sel("superview"));
    while (v != 0 && v != panel_view) {
        if ((msg(v, sel("isHidden")) & 255) != 0 || msg_f(v, sel("alpha")) < 0.05f64) {
            tb_n = 0;
            tb_str("bible: sheet: its control is held by a view hidden or faded: ");
            tb_nsstring(NSStringFromClass(object_getClass(v)));
            tb_str(" alpha100 ");
            tb_int((msg_f(v, sel("alpha")) * 100.0f64) as int);
            note_ns(tb_ns());
            return 0
        }
        v = msg(v, sel("superview"))
    }
    source
}

// The provider's answer for the sheet its context names, each call logged
// with the source's rectangle in the window, for the zoom's checks (a call
// is UIKit zooming from it; none, UIKit's own transition).
sheet_zoom_source_view(_context: int, zoom_context: int): int {
    vc: int = if (zoom_context == 0 || !responds(zoom_context, "zoomedViewController")) 0 else msg(zoom_context,
        sel("zoomedViewController"));
    source: int = sheet_zoom_source_of(vc);
    // (UIKit zooms only if a control is given: the uilog is told then, as
    // the sheet opens.)
    if (source != 0 && (msg(vc, sel("isBeingPresented")) & 255) != 0) uilog_zoom();
    if (diag_on) {
        tb_n = 0;
        tb_str("bible: sheet: zoom asks for its source: ");
        if (source == 0) tb_str("none in sight") else {
            l8_msg_hfa(hfa, source, sel("bounds"), 0, 0, 0);
            if (sheet_zoom_convert == 0) sheet_zoom_convert = rect_object_invocation(source,
                "convertRect:toView:");
            if (sheet_zoom_convert != 0 && rect_object_invoke(sheet_zoom_convert,
                source, hfa[0], hfa[1], hfa[2], hfa[3], 0, hfa)) {
                tb_str("window rect");
                for k in 0..4 {
                    tb_str(" ");
                    tb_int((hfa[k] * 10.0f64) as int)
                }
                tb_str(" (tenths of a point)")
            }
        }
        note_ns(tb_ns())
    }
    source
}

// The key the kind and argument of a sheet's screen are kept under, on
// the sheet, and the two as they are told.
sheet_zoom_key: []int = new int[1](0);

sheet_zoom_told: []int = new int[2](0);

// UIView's convertRect:toView: (made the first time a source is logged).
sheet_zoom_convert: int = 0;

// Sheet vc told how it comes: growing from its control, if this iOS zooms
// sheets and the control is in sight; else UIKit's own (its transition
// set to none, so a controller presented again never keeps an old zoom).
// (A popover, in a wide window, grows from its source on its own: a zoom
// set on one is a combination UIKit doesn't document, and is never set.
// Reading slides up from the foot, as the panel's sheet does: a sheet at
// half height over the text being read, which a card growing from AA
// would cross.)
sheet_zoom_from(vc: int) {
    if (!responds(vc, "setPreferredTransition:")) return;
    zoom: int = 0;
    popover: bool = msg(vc, sel("modalPresentationStyle")) == SHEET_STYLE_POPOVER;
    if (sheet_zooms() && !popover && sheet_zoom_source_of(vc) != 0) {
        if (sheet_zoom_provider == 0) sheet_zoom_provider = block1(&sheet_zoom_source_view,
            0, "@16@?0@8");
        if (sheet_zoom_provider != 0) zoom = msg2(cls("UIViewControllerTransition"),
            sel("zoomWithOptions:sourceViewProvider:"), 0, sheet_zoom_provider)
    }
    msg1(vc, sel("setPreferredTransition:"), zoom);
    note(if (zoom != 0) "bible: sheet: grows from its control" else if (!sheet_zooms()) "bible: sheet: slides (this iOS doesn't zoom sheets)" else if (popover) "bible: sheet: a popover (grows from its source its own way)" else "bible: sheet: slides (Reading, or no control of its own in sight)")
}

// UIModalPresentationPopover.
SHEET_STYLE_POPOVER: int = 7;

// What presents the next sheet: the top sheet; else the panel, while it is
// UIKit's sheet over the page (ios/inspector.l8: Go To over it, not
// instead of it); else the reader's navigation.
sheet_presenter(): int {
    top: int = top_presented();
    if (top != 0) return top;
    if (panel_in_split() && bs_nav != 0 && msg(bs_nav, sel("presentingViewController")) != 0 && (msg(bs_nav,
        sel("isBeingDismissed")) & 255) == 0) return bs_nav;
    nav
}

close_sheet(_self: int, _cmd: int, _sender: int): int {
    dismiss_sheets();
    0
}

dismiss_sheets() {
    shown: int = presented();
    if (shown == 0) return;
    sheet_gone();
    // (From what presented the first of them: the reader's navigation, or
    // the panel's sheet, which stays.)
    under: int = if (panel_in_split()) msg(shown, sel("presentingViewController")) else nav;
    msg2(if (under != 0) under else nav, sel("dismissViewControllerAnimated:completion:"),
        1, 0)
}

// A sheet swiped away (or closed): what it held let go (a sheet over
// another: the one under it stays).
sheet_dismissed(_self: int, _cmd: int, _controller: int): int {
    if (presented() != 0 && (msg(presented(), sel("isBeingDismissed")) & 255) == 0) return 0;
    sheet_gone();
    // (The panel, waiting for the sheets to go: shown now.)
    ins_after_sheets();
    0
}

sheet_gone() {
    settings_nav = 0;
    // (Each screen's own: sheet_screens_made.)
    sheet_parts_gone()
}

// Study's panel back, if a sheet of Study's kept it away; on an iPad, the
// keys' focus back on the page.
sheet_page_back() {
    if (bs_open) root_relayout();
    page_focus()
}

// The theme's colors on a sheet's table.
style_table(t: int, grouped: bool) {
    if (t == 0) return;
    msg1(t, sel("setBackgroundColor:"), if (grouped) sheet_bg() else c_bg)
}

// Every list shown, in the look its screen said (sheet_screens_made); then
// what screens restyle themselves.
style_sheets() {
    for i in 0..table_screens_n {
        t: int = table_screens[i].table.*;
        if (t != 0) {
            match table_screens[i].look {
                Plain -> {
                    style_table(t, false);
                    msg(t, sel("reloadData"))
                }
                Grouped -> {
                    style_table(t, true);
                    msg(t, sel("reloadData"))
                }
                Kept -> { }
            }
        }
    }
    uk_restyle_kept();
    sheet_bars_restyle();
    beside_restyle()
}

// The bars' buttons of every screen of core's shown tinted for the theme
// now (a sheet up while the theme changes keeps its buttons, made in the
// old one's colors): a Done in the words' color, the panel's close and a
// toolbar's icons in the icons'.
sheet_bars_restyle() {
    for k in 0..UK_SLOTS {
        vc: int = uk_vcs[k];
        if (vc != 0) {
            item: int = msg(vc, sel("navigationItem"));
            for side in ["rightBarButtonItems", "leftBarButtonItems"] {
                list: int = msg(item, sel(side));
                if (list != 0) {
                    for j in 0..msg(list, sel("count")) {
                        b: int = msg1(list, sel("objectAtIndex:"), j);
                        action: int = msg(b, sel("action"));
                        if (action == sel("closeSheet:") && msg(b, sel("image")) != 0) msg1(b,
                            sel("setTintColor:"), c_ink) else if (action == sel("besideClose:") || action == sel("besideFull:")) msg1(b,
                            sel("setTintColor:"), c_icon)
                    }
                }
            }
            nav: int = msg(vc, sel("navigationController"));
            if (nav != 0) msg1(msg(nav, sel("toolbar")), sel("setTintColor:"), c_icon)
        }
    }
}

// A list cell (UIListContentConfiguration: 0 cell, 1 value, 2 subtitle).
list_cell(t: int, id: str, _kind: int): int {
    cell: int = msg1(t, sel("dequeueReusableCellWithIdentifier:"), nsstring(id));
    if (cell == 0) cell = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, nsstring(id)), sel("autorelease"));
    msg1(cell, sel("setAccessoryType:"), 0);
    msg1(cell, sel("setAccessoryView:"), 0);
    msg1(cell, sel("setBackgroundColor:"), if (uk_plain_table(t)) c_bg else cell_bg());
    cell
}

list_config(kind: int): int {
    u: int = cls("UIListContentConfiguration");
    if (kind == 1) return msg(u, sel("valueCellConfiguration"));
    if (kind == 2) return msg(u, sel("subtitleCellConfiguration"));
    msg(u, sel("cellConfiguration"))
}

text_props(config: int): int {
    msg(config, sel("textProperties"))
}

detail_props(config: int): int {
    msg(config, sel("secondaryTextProperties"))
}

// A config's image: a symbol, tinted. A row's own icon (17 points, the
// body's size) follows the body text style, so it grows with Dynamic
// Type as system lists' do (review r6-1).
config_image(
    config: int,
    name: str,
    size: f64,
    color: int
) {
    if (size == 17.0f64) {
        sc: int = msg1(cls("UIImageSymbolConfiguration"), sel("configurationWithTextStyle:"),
            objc_const("UIFontTextStyleBody"));
        image: int = msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
            nsstring(name), sc);
        if (image != 0 && color != 0) image = msg2(image, sel("imageWithTintColor:renderingMode:"),
            color, 1);
        msg1(config, sel("setImage:"), image)
    } else msg1(config, sel("setImage:"), symbol(name, size, 4, color));
    msg1(msg(config, sel("imageProperties")), sel("setTintColor:"), color)
}

// ---- the bar's buttons: core's screens ----
show_picker(_self: int, _cmd: int, _sender: int): int {
    if (presented() == 0) send0("tap goto");
