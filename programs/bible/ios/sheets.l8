// ---- LORD and GOD in small capitals, outside the reader too ----
caps_buf: []i8 = new i8[4096](0i8);

caps_n: int = 0;

// The divine name at caps_buf[i] (as divine_at in text.l8): its length,
// or 0.
caps_divine(i: int): int {
    if (i > 0 && is_letter(caps_buf[i - 1] as int)) return 0;
    n: int = 0;
    if (caps_at(i, "LORD")) n = 4 else if (caps_at(i, "GOD")) n = 3;
    if (n == 0 || i + n < caps_n && is_letter(caps_buf[i + n] as int)) return 0;
    n
}

caps_at(i: int, word: str): bool {
    if (i + len(word) > caps_n) return false;
    for k in 0..len(word)
        if (caps_buf[i + k] != word[k]) return false;
    true
}

// The small capitals for a size: of the body (made smaller by hand, for
// fonts without their own), or of the system's font.
caps_font(serif_face: bool, size: f64): int {
    if (serif_face && caps_by_hand) return body(size * 0.8f64);
    if (serif_face) return small_caps(size);
    keys[0] = objc_const("UIFontFeatureTypeIdentifierKey");
    values[0] = msg1(cls("NSNumber"), sel("numberWithLong:"), 38);
    keys[1] = objc_const("UIFontFeatureSelectorIdentifierKey");
    values[1] = msg1(cls("NSNumber"), sel("numberWithLong:"), 1);
    one_object[0] = nsdictionary(keys, values, 2);
    keys[0] = objc_const("UIFontDescriptorFeatureSettingsAttribute");
    values[0] = nsarray(one_object, 1);
    d: int = msg1(msg(sans(size, 0.0f64), sel("fontDescriptor")), sel("fontDescriptorByAddingAttributes:"),
        nsdictionary(keys, values, 1));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

// LORD and GOD in text (an NSString at UTF-16 base in s) set in small
// capitals after their first letter.
caps_into(
    s: int,
    base: int,
    text: int,
    serif_face: bool,
    size: f64
) {
    caps_n = nsstring_into(text, caps_buf);
    f: int = 0;
    u: int = base;
    i: int = 0;
    while (i < caps_n) {
        d: int = caps_divine(i);
        if (d > 0) {
            if (f == 0) f = caps_font(serif_face, size);
            msg4(s, sel("addAttribute:value:range:"), k_font, f, u + 1, d - 1);
            if (serif_face && caps_by_hand) msg4(s, sel("addAttribute:value:range:"),
                k_kern, nsnumber_f(size * 0.02f64), u + 1, d - 1);
            i = i + d;
            u = u + d
        } else {
            k: int = caps_buf[i] as int & 255;
            if (k < 128 || k >= 192) u = u + 1;
            if (k >= 240) u = u + 1;
            i = i + 1
        }
    }
}

// Text with attributes, its divine names in small capitals.
with_caps(
    text: int,
    attributes: int,
    serif_face: bool,
    size: f64
): int {
    s: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, attributes), sel("autorelease"));
    caps_into(s, 0, text, serif_face, size);
    s
}

// A verse's words for a list's second line: in the body's face or the
// system's, at a size and color.
// A Library row's size: size points at the default text size, scaled as
// the Subheadline style is (so the rows grow with Dynamic Type, in step
// with their state lines and headers).
lib_pt(size: f64): f64 {
    m: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleSubheadline"));
    if (m == 0) return size;
    msg_f(msg1(m, sel("scaledFontForFont:"), sans(size, 0.0f64)), sel("pointSize"))
}

preview(
    text: int,
    serif_face: bool,
    size: f64,
    color: int
): int {
    keys[0] = k_font;
    values[0] = (if (serif_face) body(size) else sans(size, 0.0f64));
    keys[1] = k_color;
    values[1] = color;
    with_caps(text, nsdictionary(keys, values, 2), serif_face, size)
}

// The words of verses v to last of chapter c (some of them, if long).
range_words(c: int, v: int, last: int): int {
    fbuf_n = 0;
    x: int = v;
    t: int = quote_text(c, v);
    while (x <= last && fbuf_n < 600 && t >= 0) {
        _n: int = verse_text_of(t, c, x);
        if (x > v) fput(32);
        for i in 0..vt_n fput(vt[i] as int);
        x = x + 1
    }
    fstring()
}

// A chapter (and verse) as an NSString: John 3:16.
place_name(c: int, v: int): int {
    fbuf_n = 0;
    if (v > 0) {
        one_verse[0] = v;
        put_ref(c, one_verse, 1)
    } else put_ref(c, one_verse, 0);
    fstring()
}

one_verse: []int = new int[1](0);

number_buf: []i8 = new i8[24](0i8);

// A number as an NSString.
nsnumber_text(n: int): int {
    fbuf_n = 0;
    fput_int(n);
    fstring()
}

// ---- the chapters of a book, as a grid ----
picker_book: int = 0;

show_chapters(b: int) {
    show_chapters_mode(b, false)
}

// The grid of book b's chapters: Go To's (a tap goes there), or Begin At's
// (choosing, for New Ribbon or A Chapter a Day: a tap chooses it and pops,
// the chapter chosen filled). Its view's tag is the book (plus one), 1000
// more when choosing.
show_chapters_mode(b: int, choosing: bool) {
    picker_book = b;
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    width: f64 = view_width(msg(sheet_nav, sel("view")));
    cols: int = ((width - 40.0f64 + 10.0f64) / 66.0f64) as int;
    if (cols < 1) cols = 1;
    side: f64 = ((width - 40.0f64 - (cols - 1) as f64 * 10.0f64) / cols as f64) as int as f64;
    layout: int = make("UICollectionViewFlowLayout");
    msg_ff(layout, sel("setItemSize:"), side, side);
    msg_set_f(layout, sel("setMinimumInteritemSpacing:"), 9.0f64);
    msg_set_f(layout, sel("setMinimumLineSpacing:"), 10.0f64);
    msg_rect(layout, sel("setSectionInset:"), 20.0f64, 20.0f64, 32.0f64, 20.0f64);
    grid: int = msg1(msg(cls("UICollectionViewController"), sel("alloc")), sel("initWithCollectionViewLayout:"),
        layout);
    release(layout);
    msg1(grid, sel("setTitle:"), if (choosing) nsstring("Chapter") else book_name(b));
    msg1(msg(grid, sel("navigationItem")), sel("setLargeTitleDisplayMode:"), if (choosing) 2 else 0);
    msg1(msg(grid, sel("navigationItem")), sel("setRightBarButtonItem:"), system_item(0,
        "closeSheet:"));
    view: int = msg(grid, sel("collectionView"));
    msg1(view, sel("setTag:"), b + 1 + (if (choosing) 1000 else 0));
    msg1(view, sel("setBackgroundColor:"), sheet_bg());
    msg2(view, sel("registerClass:forCellWithReuseIdentifier:"), cls("UICollectionViewCell"),
        nsstring("chapter"));
    msg1(view, sel("setDataSource:"), app_obj);
    msg1(view, sel("setDelegate:"), app_obj);
    msg2(sheet_nav, sel("pushViewController:animated:"), grid, 1);
    release(grid)
}

// A grid's book, and whether it is choosing (its view's tag).
grid_book(view: int): int {
    k: int = msg(view, sel("tag"));
    if (k <= 0) return picker_book;
    (k - 1) % 1000
}

grid_choosing(view: int): bool {
    msg(view, sel("tag")) > 1000
}

grid_items(
    _self: int,
    _cmd: int,
    view: int,
    _section: int
): int {
    book_count[grid_book(view)]
}

grid_cell(
    _self: int,
    _cmd: int,
    view: int,
    path: int
): int {
    cell: int = msg2(view, sel("dequeueReusableCellWithReuseIdentifier:forIndexPath:"),
        nsstring("chapter"), path);
    content: int = msg(cell, sel("contentView"));
    label: int = msg1(content, sel("viewWithTag:"), 7);
    if (label == 0) {
        l8_msg_hfa(hfa, content, sel("bounds"), 0, 0, 0);
        label = msg_rect(msg(cls("UILabel"), sel("alloc")), sel("initWithFrame:"),
            hfa[0], hfa[1], hfa[2], hfa[3]);
        msg1(label, sel("setTag:"), 7);
        msg1(label, sel("setAutoresizingMask:"), 18);
        msg1(label, sel("setTextAlignment:"), 1);
        msg1(content, sel("addSubview:"), label);
        release(label);
        layer: int = msg(content, sel("layer"));
        msg_set_f(layer, sel("setCornerRadius:"), 14.0f64);
        curve: int = objc_const("kCACornerCurveContinuous");
        if (curve != 0) msg1(layer, sel("setCornerCurve:"), curve);
        msg1(content, sel("setClipsToBounds:"), 1)
    }
    n: int = msg(path, sel("item"));
    here: bool = book_first[grid_book(view)] + n == (if (grid_choosing(view)) bg_c else cur);
    msg1(label, sel("setText:"), nsnumber_text(n + 1));
    msg1(label, sel("setFont:"), sans(19.0f64, 0.23f64));
    msg1(label, sel("setTextColor:"), if (here) on_accent() else c_ink);
    msg1(content, sel("setBackgroundColor:"), if (here) c_accent else cell_bg());
    cell
}

grid_picked(
    _self: int,
    _cmd: int,
    view: int,
    path: int
): int {
    c: int = book_first[grid_book(view)] + msg(path, sel("item"));
    if (grid_choosing(view)) bg_choose_chapter(c) else jump(c, 0);
    0
}

// ---- search ----
show_search(_self: int, _cmd: int, _sender: int): int {
