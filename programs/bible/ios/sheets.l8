}

// Note i in the text view, to be read: its references to verses links, in
// the accent.
note_show_read(i: int) {
    msg1(note_tv, sel("setEditable:"), 0);
    msg1(note_tv, sel("setSelectable:"), 1);
    n: int = kept_notes[i].text_n;
    for x in 0..n note_buf[x] = nt_pool[kept_notes[i].text_at + x];
    keys[0] = k_font;
    values[0] = body(em);
    keys[1] = k_color;
    values[1] = c_ink;
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.25f64), sel("autorelease"));
    a: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        nsstring_of(note_buf, n), nsdictionary(keys, values, 3)), sel("autorelease"));
    note_refs(note_buf, n);
    for r in 0..nr_n {
        b: int = units_of(note_buf, 0, nr_b[r]);
        u: int = units_of(note_buf, nr_b[r], nr_e[r]);
        msg4(a, sel("addAttribute:value:range:"), k_color, c_accent, b, u);
        xr_book = nr_book[r];
        xr_c = nr_c[r];
        xr_v = (if (nr_v[r] > 0) nr_v[r] else 0);
        xr_ce = (if (nr_ve[r] > 0) nr_c[r] else 0);
        xr_ve = (if (nr_ve[r] > 0) nr_ve[r] else 0);
        msg4(a, sel("addAttribute:value:range:"), nsstring(k_xref), nsnumber_int(xref_both()),
            b, u)
    }
    msg1(note_tv, sel("setAttributedText:"), a)
}

// How many UTF-16 units bytes a to b of x are.
units_of(x: []i8, a: int, b: int): int {
    n: int = 0;
    for i in a..b {
        k: int = x[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    n
}

// A tap on the note read: a reference's preview, pushed in the note's
// sheet (DESIGN.md §8.1).
note_tapped(_self: int, _cmd: int, tap: int): int {
    if (!note_reading) return 0;
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    ref_tap_at(tv, hfa[0], hfa[1]);
    0
}

// A tap at (x, y) on text with references (a note's, a definition's): the
// reference's preview pushed.
ref_tap_at(tv: int, x: f64, y: f64) {
    ref: int = link_at(tv, x, y, k_xref);
    if (ref > 0) push_preview(ref)
}

// Edit: the editor in place, the keyboard up.
note_edit(_self: int, _cmd: int, _b: int): int {
    if (note_tv == 0) return 0;
    note_reading = false;
    fade_layer(msg(note_tv, sel("layer")), 0.2f64);
    i: int = note_of(ne_c, ne_v);
    msg1(note_tv, sel("setText:"), if (i >= 0) note_string(i) else nsstring(""));
    msg1(note_tv, sel("setFont:"), body(em));
    msg1(note_tv, sel("setTextColor:"), c_ink);
    msg1(note_tv, sel("setEditable:"), 1);
    note_edit_items(true, true);
    if (!demo_no_keyboard) msg(note_tv, sel("becomeFirstResponder"));
    msg2(note_tv, sel("setSelectedRange:"), msg(msg(note_tv, sel("text")), sel("length")),
        0);
    0
}

note_close(_self: int, _cmd: int, _b: int): int {
    close_note();
    0
}

demo_no_keyboard: bool = false;

// The text typed: the placeholder shown only while there is none.
text_changed(_self: int, _cmd: int, tv: int): int {
    if (tv == note_tv && note_placeholder != 0) msg1(note_placeholder, sel("setHidden:"),
        if (msg(msg(tv, sel("text")), sel("length")) > 0) 1 else 0);
    0
}

// The note as it is in the editor, kept (none, if empty).
save_note_editor() {
    if (note_tv == 0) return;
    n: int = nsstring_into(msg(note_tv, sel("text")), note_buf);
    // (Trailing spaces and lines let go.)
    while (n > 0 && (note_buf[n - 1] as int == 32 || note_buf[n - 1] as int == 10)) n = n - 1;
    old: int = note_of(ne_c, ne_v);
    same: bool = old >= 0 && kept_notes[old].text_n == n;
    if (same) {
        for i in 0..n
            if (nt_pool[kept_notes[old].text_at + i] != note_buf[i]) same = false
    }
    if (!same && !(old < 0 && n == 0)) {
        set_note(ne_c, ne_v, ne_last, note_buf, n);
        save_notes();
        remake(ne_c)
    }
}

// Closes the editor (over the library, or the reader).
close_note() {
    note_tv = 0;
    top: int = presented();
    if (top == 0) return;
    inner: int = msg(top, sel("presentedViewController"));
    if (inner != 0) {
        msg2(top, sel("dismissViewControllerAnimated:completion:"), 1, 0);
        if (lib_table != 0) lib_refresh(false)
    } else dismiss_sheets()
}

note_done(_self: int, _cmd: int, _sender: int): int {
    save_note_editor();
    // (Opened to be read: back to reading it, unless it is gone.)
    i: int = note_of(ne_c, ne_v);
    if (note_from_read && i >= 0 && note_tv != 0) {
        msg(note_tv, sel("resignFirstResponder"));
        fade_layer(msg(note_tv, sel("layer")), 0.2f64);
        note_reading = true;
        note_show_read(i);
        note_read_items(true);
        return 0
    }
    close_note();
    0
}

note_cancel(_self: int, _cmd: int, _sender: int): int {
    close_note();
    0
}

note_trash(_self: int, _cmd: int, _sender: int): int {
    set_note(ne_c, ne_v, 0, note_buf, 0);
    save_notes();
    remake(ne_c);
    close_note();
    0
}

