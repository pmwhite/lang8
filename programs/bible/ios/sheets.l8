// Go To's list, first laid out: at the book being read (core's focus),
// but at the top while there is a ribbon or a plan followed, a tap away
// (§3.2, DESIGN.md §10.7a-4, §11.2.1).
books_layout(self: int, cmd: int): int {
    super0(self, books_class, cmd);
    list: int = msg(self, sel("tableView"));
    if (msg(list, sel("tag")) != 0) return 0;
    msg1(list, sel("setTag:"), 1);
    if (!today_has()) uk_show_focus(list);
    0
