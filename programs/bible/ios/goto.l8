tag vellum;

use_tag std, ios, bible, bible_wire;

// Go To's quick form: what the dock's capsule opens (and the panel's name,
// and the keys' Go To). The keys rise at once with a field of glass on
// them, where the capsule was; above the field, nearest first, Go To's
// rows (the ribbons, the plan's day, the recent places, the documents and
// Browse; what the words typed find) and, while the words name books, core's passage
// chooser: the books as chips, the chosen one's chapters as a grid. A
// chapter's tap goes there; held, the grid is its verses, and a finger
// slid to one and lifted goes there. Nothing typed, Books of the Bible
// makes the grid every book's, a book's tap its chapters. Return goes to
// what is marked as Return's (the grid's chapter, else the nearest row).
// It is all of Go To (core's sk_has_quick_goto): a screen it opens (a
// document's page, History, Reading Plans, every verse found) is a sheet
// over it, the keys down, and swiped away, it is Go To again, the keys
// up.
import "../../ios/objc.l8";

import "../core/wire.l8";

import "../core/ui.l8";

import "kit.l8";

import "look.l8";

type QuickGoTo = {
    // The Go To screen's slot (-1: none yet, or none shown), its overlay
    // (held, over everything of the app's window: a VellumGoToView) and
    // its views; whether core is being asked for it (risen from the
    // capsule, before core's screen came).
    slot: int;
    root: int;
    asking: bool;
    backdrop: int;
    // (A view whose foot is the keys' top, by a constraint: the layout
    // follows the keys as they move.)
    keys_anchor: int;
    // The field and the close, shapes of glass in one container (they part
    // as liquid does), and the chapter's name and what is read, as the
    // capsule shows them (in the field while it is the capsule).
    field_box: int;
    field_glass: int;
    field: int;
    close_glass: int;
    capsule_name: int;
    capsule_version: int;
    // Risen from the capsule (it goes back into it), and whether its shapes
    // are at the capsule now; whether the rows have formed (core's screen
    // come).
    from_capsule: bool;
    at_capsule: bool;
    rows_formed: bool;
    // The rows: a scroll view whose content is laid out nearest-first from
    // its foot, how tall it is, where its first shape's top is (a tap
    // above it closes), and whether it is kept at its foot (until a hand
    // moves it).
    rows: int;
    rows_content: int;
    rows_height: f64;
    rows_top: f64;
    // The screens Go To opened: their navigation (held; 0: none, Go To's
    // home shows) and the shape it is shown on; and the controller whose
    // view the overlay is (held), their navigation's parent (UIKit wants a
    // child's view within its parent's).
    drill_nav: int;
    host: int;
    // Where the screens Go To opened are (QUICK_DRILL_): none, shown in
    // the room above the field, or going back into Go To's panel; and Go
    // To's panel, the shape they grow out of and go back into.
    drill_phase: int;
    panel: int;
    // Going back: where the panel will be once the keys are up (where the
    // glass goes, fixed as it goes), and the first screen to say closed to
    // core once it is there (0: none, core closed it).
    drill_target: Rect;
    drill_closing: int;
    drill_box: int;
    // The keys' height as last seen (0: not yet), what the rows are made
    // to fit above; the width of the column of its lines' names (as wide
    // as the widest of them).
    keys_h: f64;
    name_w: f64;
    rows_at_foot: bool;
    // The passage chooser: the chips (a scroll view), the grid's glass, the
    // chapters' scroll view in it and the verses' view (a chapter held).
    chips: int;
    chips_content: int;
    grid_glass: int;
    grid: int;
    grid_content: int;
    verses_view: int;
    // As core sent it: whether there is one, the chosen book's first
    // chapter (of the Bible's), its name, how many chapters, the chapter
    // marked and whether Return goes there.
    has_passage: bool;
    first_chapter: int;
    book_name: int;
    chapters: int;
    mark: int;
    goes: bool;
    // A chapter held (0: none), its verses the grid, and the verse under
    // the finger (0: none); whether the grid has yet to bring the marked
    // chapter into sight.
    held_chapter: int;
    held_verse: int;
    grid_unplaced: bool;
    // The words typed, waiting their rest before they are sent.
    query_timer: int;
    // The width the content was made for.
    built_width: f64;
    // Shown (false while it fades out), and the controller fading out.
    shown: bool;
    leaving: int
}

quick: QuickGoTo = QuickGoTo {
    slot: -1,
    root: 0,
    asking: false,
    backdrop: 0,
    keys_anchor: 0,
    field_box: 0,
    field_glass: 0,
    field: 0,
    close_glass: 0,
    capsule_name: 0,
    capsule_version: 0,
    from_capsule: false,
    at_capsule: false,
    rows_formed: false,
    rows: 0,
    rows_content: 0,
    rows_height: 0.0f64,
    rows_top: 0.0f64,
    drill_nav: 0,
    host: 0,
    drill_phase: 0,
    panel: 0,
    drill_target: Rect {
        x: 0.0f64,
        y: 0.0f64,
        w: 0.0f64,
        h: 0.0f64
    },
    drill_closing: 0,
    drill_box: 0,
    keys_h: 0.0f64,
    name_w: 0.0f64,
    rows_at_foot: true,
    chips: 0,
    chips_content: 0,
    grid_glass: 0,
    grid: 0,
    grid_content: 0,
    verses_view: 0,
    has_passage: false,
    first_chapter: 0,
    book_name: 0,
    chapters: 0,
    mark: 0,
    goes: false,
    held_chapter: 0,
    held_verse: 0,
    grid_unplaced: false,
    query_timer: 0,
    built_width: 0.0f64,
    shown: false,
    leaving: 0
};

// How many verses each of the chosen book's chapters has (room for the
// longest book's, the Psalms').
quick_verses: []int = new int[150](0);

// Its sizes.
QUICK_FIELD_H: f64 = 50.0f64;

QUICK_GAP: f64 = 10.0f64;

QUICK_SIDE: f64 = 16.0f64;

QUICK_WIDEST: f64 = 560.0f64;

QUICK_CHIP_H: f64 = 38.0f64;

QUICK_CELL_H: f64 = 44.0f64;

QUICK_COLUMNS: int = 7;

// The chapters' rows shown at once (more scroll).
QUICK_GRID_ROWS: int = 4;

QUICK_GRID_PAD: f64 = 6.0f64;

QUICK_CARD_CORNER: f64 = 24.0f64;

// ---- shown and closed ----
quick_shows(s: int): bool {
    s >= 0 && quick.slot == s
}

// The capsule tapped: Go To's field rises out of the capsule at once, the
// keys with it, and core is asked for Go To on the next turn
// (quick_ask_fired), so that the keys wait on nothing.
quick_rise_from_capsule() {
    if (quick.root != 0 && quick.leaving == 0) return;
    quick_root_make(true);
    quick.asking = true;
    _t: int = timer_after(quick.root, 0.0f64, "vellumGoToAsk:")
}

quick_ask_fired(_self: int, _cmd: int, _timer: int): int {
    if (!quick.asking) return 0;
    page_pane.said_c = -1;
    pane_tell(PANE_PAGE, true);
    send0("tap goto");
    // (Core opened no Go To: the field goes back.)
    if (quick.asking) {
        quick.asking = false;
        quick_close(false)
    }
    0
}

// Slot s's Go To shown as the quick form: the field risen from the
// capsule taking it, else one made now, the keys up; its rows form as
// they come.
quick_show(s: int) {
    if (!quick.asking) {
        if (quick.slot >= 0) quick_close(false);
        quick_root_make(false)
    }
    quick.asking = false;
    quick.slot = s;
    quick.held_chapter = 0;
    quick.rows_at_foot = true;
    quick.built_width = 0.0f64;
    if (screen_load(s)) {
        msg1(quick.field, sel("setPlaceholder:"), ui_text(ui.search));
        if (ns_length(msg(quick.field, sel("text"))) == 0) msg1(quick.field, sel("setText:"),
            ui_text(ui.search_text))
    }
    quick_fill();
    // (The rows placed at once, at their foot: only their glass animates.)
    msg(quick.root, sel("layoutIfNeeded"));
    // (Typed while core made Go To: sent now.)
    if (ns_length(msg(quick.field, sel("text"))) > 0 && ui.search_text.n == 0) quick_send();
    quick.rows_formed = true;
    ease(ANIM_GOTO, 0.22f64)
}

// The overlay made and put over everything of the app's window, the field
// given the keys: from the capsule, the capsule's own glass (the dock's
// handed over at once), rising to the keys' top as they do; else the
// field forming there.
quick_root_make(from_capsule: bool) {
    quick_remove_now();
    b: Rect = bounds_of(window);
    root: int = autoreleased(msg_rect(msg(cls("VellumGoToView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, b.w, b.h));
    msg1(root, sel("setAutoresizingMask:"), 18);
    quick.root = held(quick.root, root);
    host: int = autoreleased(make("UIViewController"));
    msg1(host, sel("setView:"), root);
    quick.host = held(quick.host, host);
    quick.slot = -1;
    quick.asking = false;
    quick.from_capsule = from_capsule;
    quick.at_capsule = from_capsule;
    quick.shown = false;
    quick.rows_formed = false;
    quick.has_passage = false;
    quick_views_make(root);
    msg1(quick.capsule_name, sel("setText:"), msg(dock.title_label, sel("text")));
    msg1(quick.capsule_version, sel("setText:"), msg(dock.version_label, sel("text")));
    add_sub(window, root);
    if (from_capsule) {
        glass_shown(quick.field_glass, true, false, dock_tint());
        glass_shown(dock.title_glass, false, true, dock_tint())
    }
    msg(root, sel("layoutIfNeeded"));
    dock_cover(true);
    quick_focus();
    quick.shown = true;
    quick.at_capsule = false;
    spring(ANIM_GOTO, 0.4f64, 0.1f64)
}

// The field given the keys. Its window made key first: the capsule's tap
// is the dock's window's (dock.l8), and the keys answer the key window's
// first responder.
quick_focus() {
    if (quick.root == 0 || quick.leaving != 0 || truth(msg(quick.field, sel("isFirstResponder")))) return;
    field_window: int = msg(quick.field, sel("window"));
    if (field_window == 0) return;
    if (!truth(msg(field_window, sel("isKeyWindow")))) msg(field_window, sel("makeKeyWindow"));
    if (!truth(msg(quick.field, sel("becomeFirstResponder")))) note("vellum: goto field refused the keys")
}

// It goes, the keys falling: risen from the capsule, the field goes back
// into it (the chapter's name in it again), the rest dissolving; said
// `closed` to core when the reader closed it (not when core did).
quick_close(said: bool) {
    s: int = quick.slot;
    if (quick.root == 0 || quick.leaving != 0) return;
    id: int = if (s >= 0) slots[s].id else 0;
    quick.query_timer = timer_stop(quick.query_timer);
    quick.slot = -1;
    quick.asking = false;
    quick.shown = false;
    quick.at_capsule = quick.from_capsule && dock.mode == DOCK_EXPANDED;
    quick.leaving = quick.root;
    msg1(quick.root, sel("setUserInteractionEnabled:"), 0);
    msg1(quick.capsule_name, sel("setText:"), msg(dock.title_label, sel("text")));
    msg1(quick.capsule_version, sel("setText:"), msg(dock.version_label, sel("text")));
    msg(quick.field, sel("resignFirstResponder"));
    spring(ANIM_GOTO, 0.36f64, 0.0f64);
    if (s >= 0 && slots[s].controller == 0) slot_free(s);
    if (said && id > 0) send1("closed", id)
}

// The fade ended: the overlay gone, the dock whole again (its capsule's
// glass at once, where the field came back to).
quick_faded() {
    if (quick.shown) return;
    quick_remove_now();
    dock_sheets_check()
}

quick_remove_now() {
    v: int = quick.leaving;
    if (v == 0) return;
    quick.leaving = 0;
    quick_drill_detach();
    msg(v, sel("removeFromSuperview"));
    if (v == quick.root) {
        quick.root = held(quick.root, 0);
        quick.host = held(quick.host, 0)
    }
    if (dock.title_glass != 0) glass_shown(dock.title_glass, dock_visible() || quick.from_capsule,
        true, dock_tint())
}

// Whether it covers the dock (dock.l8: its glass dissolved under it).
quick_covers_dock(): bool {
    quick.root != 0 && quick.leaving == 0
}

// A sheet of a screen it opened, over it: the keys down; gone again, up.
quick_covered() {
    if (quick.slot >= 0) {
        quick_send_now();
        msg(quick.field, sel("resignFirstResponder"))
    }
}

quick_uncovered() {
    quick_focus()
}

// Its glass and backdrop as shown or not, its shapes where they go
// (ANIM_GOTO's layout): at the capsule, the field and the close one
// shape with the chapter's name in it.
quick_animated() {
    if (quick.backdrop == 0) return;
    shown: bool = quick.shown;
    msg1(quick.backdrop, sel("setEffect:"), if (shown) msg1(cls("UIBlurEffect"), sel("effectWithStyle:"),
        7) else 0);
    set_alpha(msg1(glass_content(quick.backdrop), sel("viewWithTag:"), QUICK_WASH_TAG),
        if (shown) 0.55f64 else 0.0f64);
    glass_shown(quick.field_glass, shown || quick.at_capsule, false, dock_tint());
    glass_shown(quick.close_glass, shown && !quick.at_capsule, true, dock_tint());
    formed: bool = shown && quick.rows_formed;
    glass_shown(quick.grid_glass, formed, false, dock_tint());
    quick_contents_shown(quick.rows_content, formed, false);
    quick_contents_shown(quick.chips_content, formed, true);
    capsule: f64 = if (quick.at_capsule) 1.0f64 else 0.0f64;
    set_alpha(quick.capsule_name, capsule);
    set_alpha(quick.capsule_version, capsule);
    set_alpha(quick.field, 1.0f64 - capsule);
    set_alpha(msg1(glass_content(quick.field_glass), sel("viewWithTag:"), 1), 1.0f64 - capsule);
    quick_layout()
}

// The tag of the chosen book's chip (its glass the accent's, not the
// page's).
QUICK_CHOSEN_TAG: int = 7;

// The shapes of glass in view materialized or dissolved (glass_shown: a
// glass view faded by its alpha draws no glass), anything else faded.
quick_contents_shown(view: int, shown: bool, interactive: bool) {
    subs: int = msg(view, sel("subviews"));
    for i in 0..msg(subs, sel("count")) {
        sub: int = msg1(subs, sel("objectAtIndex:"), i);
        if (is_kind(sub, "UIVisualEffectView")) glass_shown(sub, shown, interactive,
            if (msg(sub, sel("tag")) == QUICK_CHOSEN_TAG) colors.accent else dock_tint()) else set_alpha(sub,
            if (shown) 1.0f64 else 0.0f64)
    }
}

// ---- made ----
quick_views_make(view: int) {
    target: int = quick.root;
    quick.backdrop = backdrop_view_new();
    add_sub(view, quick.backdrop);
    // (The page under it washed in its own color as it blurs: it recedes
    // in its theme, not into grey.)
    wash: int = autoreleased(view_new());
    set_background(wash, colors.page);
    set_alpha(wash, 0.0f64);
    msg1(wash, sel("setAutoresizingMask:"), 18);
    msg1(wash, sel("setUserInteractionEnabled:"), 0);
    msg1(wash, sel("setTag:"), QUICK_WASH_TAG);
    add_sub(glass_content(quick.backdrop), wash);
    tap: int = autoreleased(msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")),
        sel("initWithTarget:action:"), target, sel("vellumGoToBackdrop:")));
    msg1(quick.backdrop, sel("addGestureRecognizer:"), tap);
    // (The keys' top, followed.)
    anchor: int = autoreleased(view_new());
    msg1(anchor, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(anchor, sel("setUserInteractionEnabled:"), 0);
    add_sub(view, anchor);
    guide: int = msg(view, sel("keyboardLayoutGuide"));
    constraint_on(msg1(msg(anchor, sel("bottomAnchor")), sel("constraintEqualToAnchor:"),
        msg(guide, sel("topAnchor"))));
    constraint_on(msg1(msg(anchor, sel("leadingAnchor")), sel("constraintEqualToAnchor:"),
        msg(view, sel("leadingAnchor"))));
    constraint_on(msg_f_obj_kit(msg(anchor, sel("widthAnchor")), sel("constraintEqualToConstant:"),
        1.0f64));
    constraint_on(msg_f_obj_kit(msg(anchor, sel("heightAnchor")), sel("constraintEqualToConstant:"),
        1.0f64));
    quick.keys_anchor = anchor;
    // (The rows, nearest the field at their foot.)
    rows: int = autoreleased(msg_rect(msg(cls("UIScrollView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 0.0f64, 0.0f64));
    msg1(rows, sel("setAlwaysBounceVertical:"), 0);
    msg1(rows, sel("setShowsVerticalScrollIndicator:"), 0);
    msg1(rows, sel("setContentInsetAdjustmentBehavior:"), 2);
    msg1(rows, sel("setKeyboardDismissMode:"), 0);
    msg1(rows, sel("setDelegate:"), target);
    rows_tap: int = autoreleased(msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")),
        sel("initWithTarget:action:"), target, sel("vellumGoToRowsTap:")));
    msg1(rows_tap, sel("setCancelsTouchesInView:"), 0);
    msg1(rows, sel("addGestureRecognizer:"), rows_tap);
    add_sub(view, rows);
    quick.rows = rows;
    quick.rows_content = autoreleased(view_new());
    add_sub(rows, quick.rows_content);
    // (The chooser: chips edge to edge, the grid's glass.)
    chips: int = autoreleased(msg_rect(msg(cls("UIScrollView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 0.0f64, 0.0f64));
    msg1(chips, sel("setShowsHorizontalScrollIndicator:"), 0);
    msg1(chips, sel("setContentInsetAdjustmentBehavior:"), 2);
    msg1(chips, sel("setAlwaysBounceHorizontal:"), 1);
    msg1(chips, sel("setClipsToBounds:"), 0);
    add_sub(view, chips);
    quick.chips = chips;
    quick.chips_content = autoreleased(view_new());
    add_sub(chips, quick.chips_content);
    quick.grid_glass = glass_view(false);
    glass_tint(quick.grid_glass, dock_tint());
    set_corners(quick.grid_glass, QUICK_CARD_CORNER);
    add_sub(view, quick.grid_glass);
    grid: int = autoreleased(msg_rect(msg(cls("UIScrollView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 0.0f64, 0.0f64));
    msg1(grid, sel("setShowsVerticalScrollIndicator:"), 0);
    msg1(grid, sel("setContentInsetAdjustmentBehavior:"), 2);
    add_sub(glass_content(quick.grid_glass), grid);
    quick.grid = grid;
    quick.grid_content = autoreleased(view_new());
    add_sub(grid, quick.grid_content);
    hold: int = autoreleased(msg2(msg(cls("UILongPressGestureRecognizer"), sel("alloc")),
        sel("initWithTarget:action:"), target, sel("vellumGoToHold:")));
    msg_set_f(hold, sel("setMinimumPressDuration:"), 0.3f64);
    msg1(quick.grid_glass, sel("addGestureRecognizer:"), hold);
    quick.verses_view = autoreleased(view_new());
    set_hidden(quick.verses_view, true);
    add_sub(glass_content(quick.grid_glass), quick.verses_view);
    // (The screens Go To opens, on a shape of their own, hidden till then.)
    quick.drill_box = glass_view(false);
    glass_tint(quick.drill_box, dock_tint());
    set_corners(quick.drill_box, QUICK_PANEL_CORNER);
    msg1(quick.drill_box, sel("setClipsToBounds:"), 1);
    set_hidden(quick.drill_box, true);
    // (Under Go To's rows: the panel's words fade over it as it grows out
    // of the panel's shape and goes back into it.)
    msg2(view, sel("insertSubview:belowSubview:"), quick.drill_box, quick.rows);
    // (The field, where the capsule was, and the close beside it.)
    quick.field_box = glass_container(14.0f64);
    add_sub(view, quick.field_box);
    quick.field_glass = glass_view(false);
    glass_tint(quick.field_glass, dock_tint());
    set_corners(quick.field_glass, QUICK_FIELD_H / 2.0f64);
    add_sub(glass_content(quick.field_box), quick.field_glass);
    glass: int = glass_content(quick.field_glass);
    quick.capsule_name = label_new(font_rounded(17.0f64, 0.4f64), colors.ink, 1);
    msg1(quick.capsule_name, sel("setTextAlignment:"), 1);
    quick.capsule_version = label_new(font_rounded(11.5f64, 0.0f64), colors.faint,
        1);
    msg1(quick.capsule_version, sel("setTextAlignment:"), 1);
    add_sub(glass, quick.capsule_name);
    add_sub(glass, quick.capsule_version);
    lens: int = autoreleased(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol("magnifyingglass", 16.0f64, 5)));
    msg1(lens, sel("setTintColor:"), colors.faint);
    msg1(lens, sel("setContentMode:"), 4);
    msg1(lens, sel("setTag:"), 1);
    add_sub(glass, lens);
    field: int = autoreleased(msg_rect(msg(cls("UITextField"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 0.0f64, 0.0f64));
    msg1(field, sel("setFont:"), font_system(17.0f64, 0.0f64));
    msg1(field, sel("setTextColor:"), colors.ink);
    msg1(field, sel("setTintColor:"), colors.accent);
    msg1(field, sel("setAutocorrectionType:"), 1);
    msg1(field, sel("setAutocapitalizationType:"), 0);
    msg1(field, sel("setSpellCheckingType:"), 1);
    msg1(field, sel("setReturnKeyType:"), 1);
    msg1(field, sel("setClearButtonMode:"), 1);
    if (responds(field, "setInlinePredictionType:")) msg1(field, sel("setInlinePredictionType:"),
        1);
    msg1(field, sel("setDelegate:"), target);
    msg3(field, sel("addTarget:action:forControlEvents:"), target, sel("vellumGoToTyped:"),
        131072);
    msg3(field, sel("addTarget:action:forControlEvents:"), target, sel("vellumGoToBegan:"),
        65536);
    if (screen_load(quick.slot)) msg1(field, sel("setPlaceholder:"), ui_text(ui.search));
    add_sub(glass, field);
    quick.field = field;
    quick.close_glass = glass_view(true);
    glass_tint(quick.close_glass, dock_tint());
    set_corners(quick.close_glass, QUICK_FIELD_H / 2.0f64);
    close: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg2(close, sel("setImage:forState:"), symbol("xmark", 17.0f64, 6), 0);
    msg1(close, sel("setTintColor:"), colors.ink);
    msg1(close, sel("setAccessibilityLabel:"), nsstring("Close"));
    msg3(close, sel("addTarget:action:forControlEvents:"), target, sel("vellumGoToClose:"),
        64);
    msg1(close, sel("setTag:"), 1);
    add_sub(glass_content(quick.close_glass), close);
    add_sub(glass_content(quick.field_box), quick.close_glass);
    // (Formed as it shows: quick_animated.)
    glass_shown(quick.field_glass, false, false, dock_tint());
    glass_shown(quick.close_glass, false, true, dock_tint());
    glass_shown(quick.grid_glass, false, false, dock_tint())
}

// The tag of the backdrop's wash.
QUICK_WASH_TAG: int = 9;

// A visual effect view with no effect yet (the backdrop: blurred as it
// shows).
backdrop_view_new(): int {
    autoreleased(msg1(msg(cls("UIVisualEffectView"), sel("alloc")), sel("initWithEffect:"),
        0))
}

constraint_on(constraint: int) {
    msg1(constraint, sel("setActive:"), 1)
}

// The views in view let go.
subviews_cleared(view: int) {
    subs: int = msg(msg(view, sel("subviews")), sel("copy"));
    for i in 0..msg(subs, sel("count")) msg(msg1(subs, sel("objectAtIndex:"), i),
        sel("removeFromSuperview"));
    release(subs)
}

// ---- filled from core's screen ----
// The chooser and the rows made again from the screen as core has it now.
quick_fill() {
    s: int = quick.slot;
    if (s < 0 || !screen_load(s)) return;
    w: f64 = bounds_of(root_view).w;
    quick.built_width = w;
    quick_passage_take();
    quick_chips_make(w);
    quick_grid_make();
    quick_rows_make(w);
    // (What was made laid out now, its buttons' words too: not later, in
    // an animation of something else's, grown out of nothing.)
    msg(quick.rows_content, sel("layoutIfNeeded"));
    msg(quick.chips_content, sel("layoutIfNeeded"));
    msg(quick.grid_content, sel("layoutIfNeeded"));
    // (Made before they have formed: formed as they show, quick_animated.)
    if (!quick.rows_formed) {
        quick_contents_shown(quick.rows_content, false, false);
        quick_contents_shown(quick.chips_content, false, true)
    }
    quick.rows_at_foot = true;
    // (Made again under a screen Go To opened, or as it goes back: the
    // chooser's glass and the panel's kept as they are there.)
    if (quick.drill_phase == QUICK_DRILL_SHOWN) quick_chooser_shown(false);
    if (quick.drill_phase != QUICK_DRILL_NONE && quick.panel != 0) msg1(quick.panel,
        sel("setEffect:"), 0);
    if (quick.root != 0) msg(quick.root, sel("setNeedsLayout"))
}

// The chooser and the rows made again from a layout pass, which may be
// inside an animation (the keys rising): with animations off meanwhile,
// so that what is made new appears where it goes, not grown out of a
// frame of nothing (the rest of the pass moves the rows with the keys,
// as ever).
quick_fill_in_place() {
    view_class: int = cls("UIView");
    was: bool = truth(msg(view_class, sel("areAnimationsEnabled")));
    msg1(view_class, sel("setAnimationsEnabled:"), 0);
    quick_fill();
    msg1(view_class, sel("setAnimationsEnabled:"), if (was) 1 else 0)
}

// The content's width and left for the root's width w.
quick_width(w: f64): f64 {
    safe: Insets = safe_insets(root_view);
    room: f64 = w - safe.left - safe.right - 2.0f64 * QUICK_SIDE;
    if (room > QUICK_WIDEST) QUICK_WIDEST else room
}

quick_left(w: f64): f64 {
    (w - quick_width(w)) / 2.0f64
}

// The passage chooser's words, as core sent them (ui.passage), kept.
quick_passage_take() {
    match ui.passage {
        NoPassage -> quick.has_passage = false;
        Passage p -> {
            quick.has_passage = true;
            quick.first_chapter = p.first_chapter;
            quick.mark = p.mark;
            quick.goes = p.goes;
            n: int = 0;
            value: int = 0;
            digits: bool = false;
            for x in p.verses.at..p.verses.at + p.verses.n + 1 {
                k: int = if (x < p.verses.at + p.verses.n) ui.pool[x] as int else 32;
                if (k >= 48 && k <= 57) {
                    value = value * 10 + k - 48;
                    digits = true
                } else if (digits) {
                    if (n < len(quick_verses)) {
                        quick_verses[n] = value;
                        n = n + 1
                    }
                    value = 0;
                    digits = false
                }
            }
            quick.chapters = n;
            quick.book_name = held(quick.book_name, 0);
            for k in 0..split_count(&ui, p.books) {
                chip: int = split_word(&ui, p.books, k);
                if (quick_chip_book(chip) == p.book) quick.book_name = held(quick.book_name,
                    quick_chip_name(chip))
            }
        }
    }
}

// A chip's words (`BOOK:NAME`): its book, and its name.
quick_chip_book(chip: int): int {
    msg(chip, sel("integerValue"))
}

quick_chip_name(chip: int): int {
    colon: int = msg1(chip, sel("rangeOfString:"), nsstring(":"));
    if (colon < 0 || colon >= ns_length(chip)) chip else msg1(chip, sel("substringFromIndex:"),
        colon + 1)
}

QUICK_CHIP_FONT_SIZE: f64 = 16.0f64;

// The chips, the chosen one tinted and in sight, in a row that scrolls
// edge to edge.
quick_chips_make(w: f64) {
    subviews_cleared(quick.chips_content);
    set_hidden(quick.chips, !quick.has_passage);
    if (!quick.has_passage) return;
    chosen_x: f64 = 0.0f64;
    chosen_w: f64 = 0.0f64;
    chosen: int = -1;
    match ui.passage {
        NoPassage -> { }
        Passage p -> {
            chosen = p.book;
            font: int = font_rounded(QUICK_CHIP_FONT_SIZE, 0.23f64);
            x: f64 = quick_left(w);
            for k in 0..split_count(&ui, p.books) {
                chip: int = split_word(&ui, p.books, k);
                b: int = quick_chip_book(chip);
                name: int = quick_chip_name(chip);
                cw: f64 = text_width(name, font) + 30.0f64;
                glass: int = glass_view(true);
                set_corners(glass, QUICK_CHIP_H / 2.0f64);
                set_frame4(glass, x, 0.0f64, cw, QUICK_CHIP_H);
                button: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
                msg2(button, sel("setTitle:forState:"), name, 0);
                msg1(msg(button, sel("titleLabel")), sel("setFont:"), font);
                on: bool = b == chosen;
                msg2(button, sel("setTitleColor:forState:"), if (on) system_color("whiteColor") else colors.ink,
                    0);
                if (!on) glass_tint(glass, dock_tint());
                if (on) {
                    chosen_x = x;
                    chosen_w = cw;
                    msg1(glass, sel("setTag:"), QUICK_CHOSEN_TAG);
                    glass_tint(glass, colors.accent);
                    msg1(button, sel("setAccessibilityTraits:"), msg(cls("UIAccessibilityTraitSelected"),
                        sel("self")))
                }
                msg1(button, sel("setTag:"), b);
                msg3(button, sel("addTarget:action:forControlEvents:"), quick.root,
                    sel("vellumGoToChip:"), 64);
                set_frame4(button, 0.0f64, 0.0f64, cw, QUICK_CHIP_H);
                add_sub(glass_content(glass), button);
                add_sub(quick.chips_content, glass);
                x = x + cw + 8.0f64
            }
            set_frame4(quick.chips_content, 0.0f64, 0.0f64, x - 8.0f64 + quick_left(w),
                QUICK_CHIP_H);
            content_w: f64 = x - 8.0f64 + quick_left(w);
            msg_ff(quick.chips, sel("setContentSize:"), content_w, QUICK_CHIP_H);
            // (The chosen chip in the middle, where the row can be moved.)
            most: f64 = content_w - w;
            at: f64 = chosen_x + chosen_w / 2.0f64 - w / 2.0f64;
            msg_ff(quick.chips, sel("setContentOffset:"), if (most < 0.0f64 || at < 0.0f64) 0.0f64 else if (at > most) most else at,
                0.0f64)
        }
    }
}

// The chosen book's chapters as buttons, QUICK_COLUMNS a row, the marked
// one ringed (washed where Return goes there), its row in sight.
quick_grid_make() {
    subviews_cleared(quick.grid_content);
    subviews_cleared(quick.verses_view);
    quick.held_chapter = 0;
    quick.grid_unplaced = true;
    set_hidden(quick.verses_view, true);
    set_hidden(quick.grid, false);
    set_hidden(quick.grid_glass, !quick.has_passage);
    if (!quick.has_passage) return;
    for n in 1..quick.chapters + 1 {
        button: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
        words_begin();
        words_add_int(n);
        msg2(button, sel("setTitle:forState:"), words_ns(), 0);
        msg1(msg(button, sel("titleLabel")), sel("setFont:"), font_monospaced_digits(17.0f64,
            0.0f64));
        msg1(button, sel("setTintColor:"), colors.ink);
        if (n == quick.mark) {
            layer: int = msg(button, sel("layer"));
            msg1(layer, sel("setBorderColor:"), msg(colors.accent, sel("CGColor")));
            msg_set_f(layer, sel("setBorderWidth:"), 1.5f64);
            msg_set_f(layer, sel("setCornerRadius:"), 12.0f64);
            msg1(button, sel("setTintColor:"), colors.accent);
            if (quick.goes) set_background(button, colors.selection)
        }
        quick_chapter_label(button, n);
        msg1(button, sel("setTag:"), n);
        msg3(button, sel("addTarget:action:forControlEvents:"), quick.root, sel("vellumGoToChapter:"),
            64);
        add_sub(quick.grid_content, button)
    }
}

// What a screen reader says of chapter n's button.
quick_chapter_label(button: int, n: int) {
    words_begin();
    words_add_ns(quick.book_name);
    words_add(" ");
    words_add_int(n);
    msg1(button, sel("setAccessibilityLabel:"), words_ns());
    msg1(button, sel("setAccessibilityHint:"), nsstring("Touch and hold for its verses."))
}

// Go To's places and finds on one shape of glass above the field (the
// field, its close, the book chips and the grid are its other glass),
// made to fit the room there: nothing scrolls, since nothing would say
// there is more. Its sections, nearest the field first, each a block of
// lines with hairlines between: a section of chips with no notes (Recent,
// the documents, Browse) one line, its name in a column at its left, its
// places plain words after it (the one a pane shows in the accent), as
// many as fit whole, its button or Show All at its right; a section of
// chips with notes (the ribbons, the plans' days) and a section of rows
// (what words find) its header (its button or link at its right) over a
// line a row. Those that fit are shown, a section of rows that half fits
// its first rows; the rest, where their more is a tap away, a last line
// of links. Laid out top down from the farthest; the first, nearest the
// field, at the foot.
QUICK_SECTIONS_MOST: int = 128;

quick_block_views: []int = new int[128](0);

quick_block_heights: []f64 = new f64[128](0.0f64);

quick_block_rows: []int = new int[128](0);

// A section's block shown: its rows all (-1), some (n), or none (0).
QUICK_ALL_ROWS: int = -1;

// Its sizes: a line, a header, the column of a line's name, the inset of
// words from the shape's edge, the shape's corners.
QUICK_LINE_H: f64 = 46.0f64;

QUICK_HEAD_H: f64 = 30.0f64;

QUICK_NAME_W_LEAST: f64 = 64.0f64;

QUICK_INSET: f64 = 18.0f64;

QUICK_PANEL_CORNER: f64 = 26.0f64;

// The height of the block last made.
quick_block_made_h: f64 = 0.0f64;

quick_rows_make(w: f64) {
    subviews_cleared(quick.rows_content);
    quick.panel = 0;
    x: f64 = quick_left(w);
    cw: f64 = quick_width(w);
    typed: bool = ui.search_text.n > 0;
    // (Return's: the first row, where the chooser isn't Return's.)
    outlined: int = if (typed && ui.rows_n > 0 && !(quick.has_passage && quick.goes)) 0 else -1;
    n: int = if (ui.sections_n < QUICK_SECTIONS_MOST) ui.sections_n else QUICK_SECTIONS_MOST;
    quick.name_w = quick_names_width(n);
    for k in 0..n {
        quick_block_views[k] = (if (quick_section_shows(k)) quick_block_make(k, cw,
            QUICK_ALL_ROWS, outlined) else 0);
        quick_block_heights[k] = quick_block_made_h
    }
    // (Those that fit; with some left out, room kept for the line of what
    // is left out.)
    room: f64 = quick_rows_room() - 12.0f64;
    fits_all: bool = quick_blocks_choose(n, room, cw, outlined);
    more: int = 0;
    if (!fits_all) {
        _f: bool = quick_blocks_choose(n, room - QUICK_LINE_H, cw, outlined);
        more = quick_more_line_make(n, cw)
    }
    quick.rows_top = 0.0f64;
    if (ui.rows_n == 0 && typed && !quick.has_passage) {
        empty: int = label_new(font_system(17.0f64, 0.0f64), colors.faint, 1);
        msg1(empty, sel("setText:"), ui_text(ui.empty_title));
        msg1(empty, sel("setTextAlignment:"), 1);
        set_frame4(empty, x, 0.0f64, cw, 30.0f64);
        add_sub(quick.rows_content, empty);
        quick.rows_height = 42.0f64;
        set_frame4(quick.rows_content, 0.0f64, 0.0f64, w, quick.rows_height);
        msg_ff(quick.rows, sel("setContentSize:"), w, quick.rows_height);
        return
    }
    // (The shape: the line of what is left out, then the blocks chosen,
    // the last section's first, a hairline between each.)
    panel: int = glass_view(false);
    quick.panel = panel;
    glass_tint(panel, dock_tint());
    set_corners(panel, QUICK_PANEL_CORNER);
    inside: int = glass_content(panel);
    y: f64 = 4.0f64;
    first: bool = true;
    if (more != 0) {
        y = quick_panel_put(inside, more, QUICK_LINE_H, cw, y, first);
        first = false
    }
    k: int = n - 1;
    while (k >= 0) {
        v: int = quick_block_views[k];
        if (v != 0 && quick_block_rows[k] != 0) {
            y = quick_panel_put(inside, v, quick_block_heights[k], cw, y, first);
            first = false
        }
        k = k - 1
    }
    y = y + 4.0f64;
    h: f64 = if (first) 0.0f64 else y;
    if (!first) {
        set_frame4(panel, x, 0.0f64, cw, h);
        add_sub(quick.rows_content, panel)
    }
    quick.rows_height = h;
    set_frame4(quick.rows_content, 0.0f64, 0.0f64, w, h);
    msg_ff(quick.rows, sel("setContentSize:"), w, h)
}

// A block put into the shape at y (a hairline over it but the first):
// where the next goes.
quick_panel_put(
    inside: int,
    block: int,
    h: f64,
    cw: f64,
    y: f64,
    first: bool
): f64 {
    if (!first) {
        rule: int = autoreleased(view_new());
        set_background(rule, colors.rule);
        set_frame4(rule, QUICK_INSET, y, cw - QUICK_INSET, 0.5f64);
        add_sub(inside, rule)
    }
    set_frame4(block, 0.0f64, y, cw, h);
    add_sub(inside, block);
    y + h
}

// Whether section k has anything to show.
quick_section_shows(k: int): bool {
    section: UiSection = ui.sections[k];
    section.n > 0 || section.button.n > 0
}

// Whether section k is one line: chips with no notes.
quick_section_is_line(k: int): bool {
    section: UiSection = ui.sections[k];
    if (section.style != UI_SECTION_CHIPS) return false;
    for r in section.first..section.first + section.n
        if (ui.rows[r].note.n > 0) return false;
    true
}

// The blocks that fit room, nearest first (quick_block_rows: all, some or
// none of each section's rows; a section of rows half fitting made again
// with the rows that fit); whether every one fit whole.
quick_blocks_choose(
    n: int,
    room: f64,
    cw: f64,
    outlined: int
): bool {
    left: f64 = room;
    all: bool = true;
    for k in 0..n {
        quick_block_rows[k] = 0;
        if (quick_block_views[k] != 0) {
            if (quick_block_heights[k] <= left) {
                quick_block_rows[k] = QUICK_ALL_ROWS;
                left = left - quick_block_heights[k]
            } else {
                all = false;
                if (!quick_section_is_line(k) && ui.sections[k].style != UI_SECTION_BUTTONS) {
                    fit: int = quick_rows_fitting(k, cw, left);
                    if (fit > 0) {
                        quick_block_views[k] = quick_block_make(k, cw, fit, outlined);
                        quick_block_heights[k] = quick_block_made_h;
                        quick_block_rows[k] = fit;
                        left = left - quick_block_made_h
                    }
                }
            }
        }
    }
    all
}

// How many of section k's rows fit room under its header (0: none).
quick_rows_fitting(k: int, cw: f64, room: f64): int {
    section: UiSection = ui.sections[k];
    h: f64 = if (quick_section_has_head(k)) QUICK_HEAD_H else 0.0f64;
    fit: int = 0;
    for r in section.first..section.first + section.n {
        if (r != quick_link_row(k)) {
            h = h + quick_row_height(k, r, cw);
            if (h > room) return fit;
            fit = fit + 1
        }
    }
    fit
}

// A section's link (its last row, a tinted Show All or All N Verses, where
// it has rows before it): at its header's or line's right, not a row; -1:
// none.
quick_link_row(k: int): int {
    section: UiSection = ui.sections[k];
    if (section.n < 2) return -1;
    last: int = section.first + section.n - 1;
    if (ui.rows[last].tinted && ui.rows[last].action != 0) last else -1
}

// Whether section k's block has a header line (a section of lines has its
// name at its left instead).
quick_section_has_head(k: int): bool {
    section: UiSection = ui.sections[k];
    !quick_section_is_line(k) && section.style != UI_SECTION_BUTTONS && (section.header.n > 0 || section.button.n > 0 || quick_link_row(k) >= 0)
}

// Section k's block (autoreleased) cw wide, with its first rows rows
// (QUICK_ALL_ROWS: all); its height, quick_block_made_h.
quick_block_make(
    k: int,
    cw: f64,
    rows: int,
    outlined: int
): int {
    if (ui.sections[k].style == UI_SECTION_BUTTONS) return quick_ways_make(k, cw);
    if (quick_section_is_line(k)) return quick_line_make(k, cw, outlined);
    section: UiSection = ui.sections[k];
    block: int = autoreleased(view_new());
    link: int = quick_link_row(k);
    y: f64 = 0.0f64;
    if (quick_section_has_head(k)) {
        quick_head_make(block, k, link, cw);
        y = QUICK_HEAD_H
    }
    // (Its rows from the last shown, the first at the foot.)
    last: int = section.first - 1;
    counted: int = 0;
    for r in section.first..section.first + section.n {
        if (r != link && (rows == QUICK_ALL_ROWS || counted < rows)) {
            last = r;
            counted = counted + 1
        }
    }
    r: int = last;
    while (r >= section.first) {
        if (r != link) {
            if (r != last) {
                rule: int = autoreleased(view_new());
                set_background(rule, colors.rule);
                set_frame4(rule, QUICK_INSET, y, cw - QUICK_INSET, 0.5f64);
                add_sub(block, rule)
            }
            y = y + quick_row_make(block, k, r, y, cw, r == outlined)
        }
        r = r - 1
    }
    set_frame4(block, 0.0f64, 0.0f64, cw, y);
    quick_block_made_h = y;
    block
}

// Section k's header line in block: its words, small and faint, and at
// its right its button (New, Plans) or its link (All 77 Verses).
quick_head_make(
    block: int,
    k: int,
    link: int,
    cw: f64
) {
    section: UiSection = ui.sections[k];
    if (section.header.n > 0) {
        header: int = label_new(font_system(13.0f64, 0.0f64), colors.faint, 1);
        msg1(header, sel("setText:"), ui_text(section.header));
        set_frame4(header, QUICK_INSET, 10.0f64, cw - 160.0f64, 18.0f64);
        add_sub(block, header)
    }
    end: int = quick_end_button(k, link, 15.0f64);
    if (end != 0) {
        bw: f64 = intrinsic_size(end).w;
        set_frame4(end, cw - QUICK_INSET - bw, 4.0f64, bw, QUICK_HEAD_H - 4.0f64);
        add_sub(block, end)
    }
}

// A section's button (History, New) or its link (Show All), in the
// accent, plain: 0 with neither.
quick_end_button(k: int, link: int, size: f64): int {
    section: UiSection = ui.sections[k];
    words: int = if (link >= 0) quick_link_words(link) else if (section.button.n > 0) ui_text(section.button) else 0;
    if (words == 0) return 0;
    button: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg2(button, sel("setTitle:forState:"), words, 0);
    msg1(msg(button, sel("titleLabel")), sel("setFont:"), font_system(size, 0.0f64));
    msg1(button, sel("setTintColor:"), colors.accent);
    if (link >= 0) {
        msg1(button, sel("setTag:"), link);
        msg3(button, sel("addTarget:action:forControlEvents:"), quick.root, sel("vellumGoToRow:"),
            64)
    } else {
        msg1(button, sel("setTag:"), k);
        msg3(button, sel("addTarget:action:forControlEvents:"), quick.root, sel("vellumGoToHeader:"),
            64)
    }
    button
}

// A link's words, short: "Show All 988" and "All 77 Verses" as "All 988",
// "All 77".
quick_link_words(r: int): int {
    words: int = ui_text(ui.rows[r].title);
    digits: int = msg(cls("NSCharacterSet"), sel("decimalDigitCharacterSet"));
    found: int = msg1(words, sel("rangeOfCharacterFromSet:"), digits);
    if (found < 0 || found >= ns_length(words)) return words;
    end: int = found;
    while (end < ns_length(words) && truth(msg1(digits, sel("characterIsMember:"),
        msg1(words, sel("characterAtIndex:"), end)))) end = end + 1;
    msg1(nsstring("All "), sel("stringByAppendingString:"), msg2(words, sel("substringWithRange:"),
        found, end - found))
}

// Section k as one line: its name in the column at its left, its places
// plain words after it (the one a pane shows in the accent, Return's on a
// wash), as many as fit whole, its button or link at its right.
quick_line_make(k: int, cw: f64, outlined: int): int {
    section: UiSection = ui.sections[k];
    line: int = autoreleased(view_new());
    if (section.header.n > 0) {
        name: int = label_new(font_system(13.0f64, 0.0f64), colors.faint, 1);
        msg1(name, sel("setText:"), ui_text(section.header));
        set_frame4(name, QUICK_INSET, 0.0f64, quick.name_w - QUICK_INSET - 8.0f64,
            QUICK_LINE_H);
        add_sub(line, name)
    }
    link: int = quick_link_row(k);
    end: int = quick_end_button(k, link, 16.0f64);
    right: f64 = cw - QUICK_INSET;
    if (end != 0) {
        bw: f64 = intrinsic_size(end).w;
        set_frame4(end, right - bw, 0.0f64, bw, QUICK_LINE_H);
        add_sub(line, end);
        right = right - bw - 18.0f64
    }
    lx: f64 = if (section.header.n > 0) quick.name_w else QUICK_INSET;
    // (Each that fits whole; the first, cut short if it must be.)
    placed: bool = false;
    for r in section.first..section.first + section.n {
        if (r != link) {
            item: int = quick_word_button(r, r == outlined);
            iw: f64 = intrinsic_size(item).w;
            if (!placed && lx + iw > right) iw = right - lx;
            if (lx + iw <= right && iw > 0.0f64) {
                msg1(msg(item, sel("titleLabel")), sel("setLineBreakMode:"), 4);
                set_frame4(item, lx - 6.0f64, 7.0f64, iw + 12.0f64, QUICK_LINE_H - 14.0f64);
                add_sub(line, item);
                lx = lx + iw + 18.0f64;
                placed = true
            }
        }
    }
    set_frame4(line, 0.0f64, 0.0f64, cw, QUICK_LINE_H);
    quick_block_made_h = QUICK_LINE_H;
    line
}

// Section k as its buttons, its ways to more (Books, History, Plans,
// Browse): as wide each, its symbol over its words, quiet.
QUICK_WAYS_H: f64 = 60.0f64;

quick_ways_make(k: int, cw: f64): int {
    section: UiSection = ui.sections[k];
    line: int = autoreleased(view_new());
    n: int = section.n;
    each: f64 = if (n > 0) (cw - 2.0f64 * 8.0f64) / n as f64 else cw;
    for i in 0..n {
        r: int = section.first + i;
        row: UiRow = ui.rows[r];
        button: int = quick_row_button(r);
        if (row.icon.n > 0) {
            icon: int = autoreleased(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
                symbol_image(ui_text(row.icon), 19.0f64, 4)));
            msg1(icon, sel("setTintColor:"), colors.accent);
            msg1(icon, sel("setContentMode:"), 4);
            msg1(icon, sel("setUserInteractionEnabled:"), 0);
            set_frame4(icon, 0.0f64, 9.0f64, each, 24.0f64);
            add_sub(button, icon)
        }
        words: int = label_new(font_system(12.0f64, 0.0f64), colors.faint, 1);
        msg1(words, sel("setText:"), ui_text(if (row.short.n > 0) row.short else row.title));
        msg1(words, sel("setTextAlignment:"), 1);
        msg1(words, sel("setUserInteractionEnabled:"), 0);
        set_frame4(words, 2.0f64, 36.0f64, each - 4.0f64, 16.0f64);
        add_sub(button, words);
        set_frame4(button, 8.0f64 + i as f64 * each, 0.0f64, each, QUICK_WAYS_H);
        add_sub(line, button)
    }
    set_frame4(line, 0.0f64, 0.0f64, cw, QUICK_WAYS_H);
    quick_block_made_h = QUICK_WAYS_H;
    line
}

// The width of the column of the lines' names: the widest of the names of
// the n sections that are lines, and More's.
quick_names_width(n: int): f64 {
    font: int = font_system(13.0f64, 0.0f64);
    widest: f64 = text_width(nsstring("More"), font);
    for k in 0..n {
        if (quick_section_is_line(k) && ui.sections[k].header.n > 0) {
            w: f64 = text_width(ui_text(ui.sections[k].header), font);
            if (w > widest) widest = w
        }
    }
    QUICK_INSET + clamp_f(widest, QUICK_NAME_W_LEAST - QUICK_INSET - 14.0f64, 110.0f64) + 14.0f64
}

// Row r as plain words in a line: its short words (or title) and, faint
// after them, its count; in the accent where a pane shows it; on a wash
// where Return goes; its tap and its menu a row's.
quick_word_button(r: int, outlined: bool): int {
    row: UiRow = ui.rows[r];
    button: int = quick_row_button(r);
    on: bool = row.acc == ACC_CHECK;
    words: int = ui_text(if (row.short.n > 0) row.short else row.title);
    a: int = autoreleased(msg1(msg(cls("NSMutableAttributedString"), sel("alloc")),
        sel("initWithString:"), words));
    n: int = ns_length(words);
    msg4(a, sel("addAttribute:value:range:"), objc_const("NSFontAttributeName"), font_system(16.0f64,
        if (on) 0.3f64 else 0.0f64), 0, n);
    msg4(a, sel("addAttribute:value:range:"), objc_const("NSForegroundColorAttributeName"),
        if (on || row.tinted) colors.accent else colors.ink, 0, n);
    if (row.value_detail && row.detail.n > 0) {
        count: int = msg1(nsstring(" "), sel("stringByAppendingString:"), ui_text(row.detail));
        tail: int = autoreleased(msg1(msg(cls("NSMutableAttributedString"), sel("alloc")),
            sel("initWithString:"), count));
        msg4(tail, sel("addAttribute:value:range:"), objc_const("NSFontAttributeName"),
            font_system(16.0f64, 0.0f64), 0, ns_length(count));
        msg4(tail, sel("addAttribute:value:range:"), objc_const("NSForegroundColorAttributeName"),
            colors.faint, 0, ns_length(count));
        msg1(a, sel("appendAttributedString:"), tail)
    }
    msg2(button, sel("setAttributedTitle:forState:"), a, 0);
    if (outlined) {
        set_background(button, colors.selection);
        set_corners(button, 10.0f64)
    }
    button
}

// Row r of section k made in block at top, cw wide (washed where Return
// goes to it): its height. A chip with a note (a ribbon, a plan's day) one
// line: its mark, its short words, its note at its right; a row found its
// title over its words, a line of each, its info button or check at its
// right.
quick_row_make(
    block: int,
    k: int,
    r: int,
    top: f64,
    cw: f64,
    outlined: bool
): f64 {
    row: UiRow = ui.rows[r];
    button: int = quick_row_button(r);
    chip: bool = ui.sections[k].style == UI_SECTION_CHIPS;
    ink: int = if (row.tinted) colors.accent else if (row.faint || row.disabled) colors.faint else colors.ink;
    lx: f64 = QUICK_INSET;
    mark: int = quick_row_mark(row);
    if (mark != 0) lx = 50.0f64;
    end: int = 0;
    end_w: f64 = 0.0f64;
    if (chip && row.note.n > 0) {
        end = label_new(font_system(15.0f64, 0.0f64), colors.faint, 1);
        msg1(end, sel("setText:"), ui_text(row.note));
        end_w = clamp_f(intrinsic_size(end).w, 0.0f64, cw * 0.45f64)
    } else if (row.info_action != 0) {
        end = quick_info_button(r);
        end_w = 30.0f64
    } else if (row.acc == ACC_CHECK) {
        end = quick_symbol_view("checkmark", colors.accent);
        end_w = 20.0f64
    }
    text_w: f64 = cw - lx - QUICK_INSET - (if (end != 0) end_w + 12.0f64 else 0.0f64);
    title: int = label_new(font_system(16.0f64, if (!chip && row.detail.n > 0) 0.3f64 else 0.0f64),
        ink, 1);
    msg1(title, sel("setText:"), ui_text(if (chip && row.short.n > 0) row.short else row.title));
    if (row.suffix.n > 0 && !chip) {
        words: int = msg1(ui_text(row.title), sel("stringByAppendingString:"), ui_text(row.suffix));
        a: int = autoreleased(msg1(msg(cls("NSMutableAttributedString"), sel("alloc")),
            sel("initWithString:"), words));
        msg4(a, sel("addAttribute:value:range:"), objc_const("NSForegroundColorAttributeName"),
            colors.faint, ns_length(ui_text(row.title)), ns_length(ui_text(row.suffix)));
        msg1(title, sel("setAttributedText:"), a)
    }
    h: f64 = QUICK_LINE_H;
    detail: int = 0;
    if (!chip && row.detail.n > 0 && !row.value_detail) {
        detail = label_new(if (row.scripture) new_york(15.0f64) else font_system(14.0f64,
            0.0f64), colors.faint, 1);
        a: int = autoreleased(msg1(msg(cls("NSMutableAttributedString"), sel("alloc")),
            sel("initWithString:"), ui_text(row.detail)));
        marks_stress(a, row);
        if (row.query_marks) query_stress(quick.slot, a);
        msg1(detail, sel("setAttributedText:"), a);
        h = 60.0f64
    }
    if (detail != 0) {
        set_frame4(title, lx, 9.0f64, text_w, 21.0f64);
        set_frame4(detail, lx, 31.0f64, text_w, 19.0f64);
        msg1(detail, sel("setUserInteractionEnabled:"), 0);
        add_sub(button, detail)
    } else set_frame4(title, lx, 0.0f64, text_w, h);
    msg1(title, sel("setUserInteractionEnabled:"), 0);
    add_sub(button, title);
    if (mark != 0) {
        f: Rect = frame_of(mark);
        set_frame4(mark, 18.0f64 + (24.0f64 - f.w) / 2.0f64, (h - f.h) / 2.0f64, f.w,
            f.h);
        add_sub(button, mark)
    }
    if (end != 0) {
        msg1(end, sel("setTextAlignment:"), 2);
        set_frame4(end, cw - QUICK_INSET - end_w, 0.0f64, end_w, h);
        add_sub(button, end)
    }
    if (outlined) {
        wash: int = autoreleased(view_new());
        set_background(wash, colors.selection);
        set_corners(wash, 14.0f64);
        msg1(wash, sel("setUserInteractionEnabled:"), 0);
        set_frame4(wash, 6.0f64, 3.0f64, cw - 12.0f64, h - 6.0f64);
        msg2(button, sel("insertSubview:atIndex:"), wash, 0)
    }
    if (row.detail.n > 0 && row.label.n == 0) msg1(button, sel("setAccessibilityValue:"),
        ui_text(row.detail));
    set_frame4(button, 0.0f64, top, cw, h);
    add_sub(block, button);
    h
}

// A row's mark at its start (sized; 0: none): a ribbon's strip in its
// color, else its symbol.
quick_row_mark(row: UiRow): int {
    if (row.icon.n == 0) return 0;
    tint: int = if (row.icon_color.n > 0) screen_color(&ui, row.icon_color) else 0;
    if (ns_equal(ui_text(row.icon), nsstring("ribbon"))) {
        strip: int = autoreleased(view_new());
        set_background(strip, if (tint != 0) tint else colors.accent);
        set_corners(strip, 2.0f64);
        msg1(strip, sel("setUserInteractionEnabled:"), 0);
        set_frame4(strip, 0.0f64, 0.0f64, 4.0f64, 20.0f64);
        return strip
    }
    icon: int = autoreleased(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol_image(ui_text(row.icon), 16.0f64, 4)));
    msg1(icon, sel("setTintColor:"), if (tint != 0) tint else if (row.icon_faint) colors.faint else colors.accent);
    msg1(icon, sel("setContentMode:"), 4);
    msg1(icon, sel("setUserInteractionEnabled:"), 0);
    set_frame4(icon, 0.0f64, 0.0f64, 22.0f64, 22.0f64);
    icon
}

// Row r's height as quick_row_make makes it in section k.
quick_row_height(k: int, r: int, cw: f64): f64 {
    holder: int = autoreleased(view_new());
    quick_row_make(holder, k, r, 0.0f64, cw, false)
}

// A row's button (its tag the row): its tap, its press washed, its
// actions a menu on a long press.
quick_row_button(r: int): int {
    row: UiRow = ui.rows[r];
    button: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    msg1(button, sel("setTag:"), r);
    if (row.action != 0 && !row.disabled) {
        msg3(button, sel("addTarget:action:forControlEvents:"), quick.root, sel("vellumGoToRow:"),
            64);
        msg3(button, sel("addTarget:action:forControlEvents:"), quick.root, sel("vellumGoToRowDown:"),
            1);
        msg3(button, sel("addTarget:action:forControlEvents:"), quick.root, sel("vellumGoToRowUp:"),
            32 | 64 | 128 | 256)
    }
    if (row.actions_n > 0 && !row.disabled) {
        interaction: int = autoreleased(msg1(msg(cls("UIContextMenuInteraction"),
            sel("alloc")), sel("initWithDelegate:"), quick.root));
        msg1(button, sel("addInteraction:"), interaction)
    }
    msg1(button, sel("setAccessibilityLabel:"), if (row.label.n > 0) ui_text(row.label) else ui_text(row.title));
    if (row.hint.n > 0) msg1(button, sel("setAccessibilityHint:"), ui_text(row.hint));
    button
}

// The line of what was left out (n sections), its name More: each
// section whose more is a tap away, its name in the accent (its link's
// tap, else its button's); 0 when there is none.
quick_more_line_make(n: int, cw: f64): int {
    line: int = autoreleased(view_new());
    name: int = label_new(font_system(13.0f64, 0.0f64), colors.faint, 1);
    msg1(name, sel("setText:"), nsstring("More"));
    set_frame4(name, QUICK_INSET, 0.0f64, quick.name_w - QUICK_INSET - 8.0f64, QUICK_LINE_H);
    add_sub(line, name);
    lx: f64 = quick.name_w;
    made: bool = false;
    for k in 0..n {
        section: UiSection = ui.sections[k];
        link: int = quick_link_row(k);
        if (quick_block_views[k] != 0 && quick_block_rows[k] == 0 && section.header.n > 0 && (link >= 0 || section.button.n > 0)) {
            button: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
            msg2(button, sel("setTitle:forState:"), ui_text(section.header), 0);
            msg1(msg(button, sel("titleLabel")), sel("setFont:"), font_system(16.0f64,
                0.0f64));
            msg1(button, sel("setTintColor:"), colors.accent);
            if (link >= 0) {
                msg1(button, sel("setTag:"), link);
                msg3(button, sel("addTarget:action:forControlEvents:"), quick.root,
                    sel("vellumGoToRow:"), 64)
            } else {
                msg1(button, sel("setTag:"), k);
                msg3(button, sel("addTarget:action:forControlEvents:"), quick.root,
                    sel("vellumGoToHeader:"), 64)
            }
            bw: f64 = intrinsic_size(button).w;
            if (lx + bw <= cw - QUICK_INSET) {
                set_frame4(button, lx, 0.0f64, bw, QUICK_LINE_H);
                add_sub(line, button);
                lx = lx + bw + 20.0f64;
                made = true
            }
        }
    }
    if (!made) return 0;
    set_frame4(line, 0.0f64, 0.0f64, cw, QUICK_LINE_H);
    line
}

// A row's info button: its info action (tag: the row).
quick_info_button(r: int): int {
    info: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg2(info, sel("setImage:forState:"), symbol("info.circle", 19.0f64, 4), 0);
    msg1(info, sel("setTintColor:"), colors.accent);
    msg1(info, sel("setTag:"), r);
    msg1(info, sel("setAccessibilityLabel:"), nsstring("More Info"));
    msg3(info, sel("addTarget:action:forControlEvents:"), quick.root, sel("vellumGoToInfo:"),
        64);
    info
}

quick_symbol_view(name: str, tint: int): int {
    view: int = autoreleased(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol(name, 15.0f64, 6)));
    msg1(view, sel("setTintColor:"), tint);
    msg1(view, sel("setContentMode:"), 4);
    msg1(view, sel("setUserInteractionEnabled:"), 0);
    view
}

// The room the rows have: above the field where the keys put it (their
// height as last seen, else as most phones have them), less the chooser
// and the status bar's.
quick_rows_room(): f64 {
    b: Rect = bounds_of(window);
    safe: Insets = safe_insets(root_view);
    keys: f64 = if (quick.keys_h > 0.0f64) quick.keys_h else b.h * 0.4f64;
    field_y: f64 = b.h - keys - QUICK_GAP - QUICK_FIELD_H;
    room: f64 = field_y - QUICK_GAP - quick_chooser_height() - safe.top - 8.0f64;
    if (room < 0.0f64) 0.0f64 else room
}

// ---- laid out ----
// From the keys' top up: the field and its close, the chips, the grid
// (grown to a chapter's verses while one is held), the rows.
quick_layout() {
    if (quick.root == 0) return;
    view: int = quick.root;
    b: Rect = bounds_of(view);
    if (b.w <= 0.0f64) return;
    if (quick.slot >= 0 && b.w != quick.built_width) quick_fill_in_place();
    safe: Insets = safe_insets(view);
    set_frame4(quick.backdrop, 0.0f64, 0.0f64, b.w, b.h);
    wash: int = msg1(glass_content(quick.backdrop), sel("viewWithTag:"), QUICK_WASH_TAG);
    if (wash != 0) set_frame4(wash, 0.0f64, 0.0f64, b.w, b.h);
    keys_top: f64 = b.h - safe.bottom;
    if (quick.keys_anchor != 0) {
        a: Rect = frame_of(quick.keys_anchor);
        if (a.y + a.h > 0.0f64) keys_top = a.y + a.h
    }
    // (The keys up, at another height than the rows were made for: made
    // again to fit. No keys, a hardware keyboard: the field where the
    // dock's capsule stands.)
    keys_h: f64 = b.h - keys_top;
    if (quick.shown && keys_h > b.h * 0.2f64 && abs_f(keys_h - quick.keys_h) > 4.0f64) {
        quick.keys_h = keys_h;
        if (quick.slot >= 0) quick_fill_in_place()
    }
    if (keys_top > b.h - safe.bottom - 8.0f64) keys_top = b.h - safe.bottom - 8.0f64;
    x: f64 = quick_left(b.w);
    cw: f64 = quick_width(b.w);
    field_y: f64 = keys_top - QUICK_GAP - QUICK_FIELD_H;
    quick_field_place(x, cw, field_y);
    top: f64 = field_y - QUICK_GAP;
    if (quick.has_passage) {
        top = top - QUICK_CHIP_H;
        set_frame4(quick.chips, 0.0f64, top, b.w, QUICK_CHIP_H);
        top = top - 8.0f64;
        top = top - quick_grid_place(x, cw, top, safe.top + 8.0f64);
        top = top - QUICK_GAP
    }
    rows_h: f64 = top - safe.top;
    if (rows_h < 0.0f64) rows_h = 0.0f64;
    set_frame4(quick.rows, 0.0f64, safe.top, b.w, rows_h);
    // (Little to show: at the foot, above the empty room.)
    room: f64 = rows_h - quick.rows_height;
    msg_insets(quick.rows, sel("setContentInset:"), if (room > 0.0f64) room else 0.0f64,
        0.0f64, 0.0f64, 0.0f64);
    if (quick.rows_at_foot && !truth(msg(quick.rows, sel("isTracking")))) set_offset_y(quick.rows,
        quick.rows_height - rows_h);
    // (The screens Go To opened: the room above the field, or, going back,
    // Go To's panel's shape, where the rows were just laid out.)
    if (quick.drill_phase == QUICK_DRILL_SHOWN) {
        set_frame4(quick.drill_box, x, safe.top + 8.0f64, cw, field_y - QUICK_GAP - safe.top - 8.0f64);
        nav_view: int = if (quick.drill_nav != 0) msg(quick.drill_nav, sel("view")) else 0;
        if (nav_view != 0) set_frame(nav_view, bounds_of(quick.drill_box))
    } else if (quick.drill_phase == QUICK_DRILL_LEAVING) set_frame(quick.drill_box,
        quick.drill_target)
}

// The field and the close placed: risen, the field at field_y (x, cw the
// content's), the close at its right; at the capsule, both in the
// capsule's frame (dock.l8's, in the window), one shape with its words.
// Their container is as large as both, so it takes no touch from the
// rows.
quick_field_place(x: f64, cw: f64, field_y: f64) {
    field: Rect = Rect {
        x: x,
        y: field_y,
        w: cw - QUICK_FIELD_H - QUICK_GAP,
        h: QUICK_FIELD_H
    };
    close: Rect = Rect {
        x: x + cw - QUICK_FIELD_H,
        y: field_y,
        w: QUICK_FIELD_H,
        h: QUICK_FIELD_H
    };
    if (quick.at_capsule) {
        c: Rect = frame_of(dock.title_glass);
        field = Rect {
            x: c.x + dock_origin_x,
            y: c.y + dock_origin_y,
            w: c.w,
            h: c.h
        };
        close = field
    }
    left: f64 = if (field.x < close.x) field.x else close.x;
    right: f64 = if (field.x + field.w > close.x + close.w) field.x + field.w else close.x + close.w;
    set_frame4(quick.field_box, left, field.y, right - left, field.h);
    set_frame4(quick.field_glass, field.x - left, 0.0f64, field.w, field.h);
    set_corners(quick.field_glass, field.h / 2.0f64);
    set_frame4(quick.close_glass, close.x - left, 0.0f64, close.w, close.h);
    set_corners(quick.close_glass, close.h / 2.0f64);
    button: int = msg1(glass_content(quick.close_glass), sel("viewWithTag:"), 1);
    if (button != 0) set_frame4(button, 0.0f64, 0.0f64, close.w, close.h);
    lens: int = msg1(glass_content(quick.field_glass), sel("viewWithTag:"), 1);
    if (lens != 0) set_frame4(lens, 14.0f64, 0.0f64, 22.0f64, field.h);
    set_frame4(quick.field, 42.0f64, 0.0f64, field.w - 50.0f64, field.h);
    // (The capsule's words as the dock lays them out, about its middle.)
    set_frame4(quick.capsule_name, 8.0f64, field.h / 2.0f64 - 18.0f64, field.w - 16.0f64,
        22.0f64);
    set_frame4(quick.capsule_version, 8.0f64, field.h / 2.0f64 + 3.0f64, field.w - 16.0f64,
        15.0f64)
}

// The chooser's height (its chips and its grid, and the gap over them),
// as quick_layout places it: none without one.
quick_chooser_height(): f64 {
    if (!quick.has_passage) return 0.0f64;
    rows: int = quick_grid_rows_shown();
    QUICK_CHIP_H + 8.0f64 + rows as f64 * QUICK_CELL_H + 2.0f64 * QUICK_GRID_PAD + QUICK_GAP
}

// How many of the grid's rows show (more scroll inside it).
quick_grid_rows_shown(): int {
    rows: int = (quick.chapters + QUICK_COLUMNS - 1) / QUICK_COLUMNS;
    if (rows < QUICK_GRID_ROWS) rows else QUICK_GRID_ROWS
}

// The grid's glass placed with its foot at foot (x, cw as the content's;
// up to ceiling while a chapter's verses show): its height.
quick_grid_place(
    x: f64,
    cw: f64,
    foot: f64,
    ceiling: f64
): f64 {
    pad: f64 = QUICK_GRID_PAD;
    inner_w: f64 = cw - 2.0f64 * pad;
    if (quick.held_chapter > 0) {
        n: int = quick_verses[quick.held_chapter - 1];
        shape: GridShape = quick_verse_shape(n, inner_w, foot - ceiling - 2.0f64 * pad - QUICK_HELD_TITLE_H);
        h: f64 = QUICK_HELD_TITLE_H + shape.rows as f64 * shape.cell_h + 2.0f64 * pad;
        set_frame4(quick.grid_glass, x, foot - h, cw, h);
        set_frame4(quick.verses_view, pad, pad, inner_w, h - 2.0f64 * pad);
        quick_verses_place(shape, inner_w);
        return h
    }
    columns: int = QUICK_COLUMNS;
    rows: int = (quick.chapters + columns - 1) / columns;
    shown: int = quick_grid_rows_shown();
    h: f64 = shown as f64 * QUICK_CELL_H + 2.0f64 * pad;
    set_frame4(quick.grid_glass, x, foot - h, cw, h);
    set_frame4(quick.grid, pad, pad, inner_w, h - 2.0f64 * pad);
    cell_w: f64 = inner_w / columns as f64;
    subs: int = msg(quick.grid_content, sel("subviews"));
    for i in 0..msg(subs, sel("count")) {
        button: int = msg1(subs, sel("objectAtIndex:"), i);
        n: int = msg(button, sel("tag"));
        if (n >= 1) {
            place: int = n - 1;
            column: int = place % columns;
            row: int = place / columns;
            set_frame4(button, column as f64 * cell_w + 2.0f64, row as f64 * QUICK_CELL_H + 2.0f64,
                cell_w - 4.0f64, QUICK_CELL_H - 4.0f64)
        }
    }
    set_frame4(quick.grid_content, 0.0f64, 0.0f64, inner_w, rows as f64 * QUICK_CELL_H);
    msg_ff(quick.grid, sel("setContentSize:"), inner_w, rows as f64 * QUICK_CELL_H);
    // (The marked chapter's row in sight, once, as it is made.)
    if (quick.grid_unplaced) {
        quick.grid_unplaced = false;
        mark_row: int = if (quick.mark >= 1) (quick.mark - 1) / columns else 0;
        most: f64 = (rows - shown) as f64 * QUICK_CELL_H;
        y: f64 = (mark_row - 1) as f64 * QUICK_CELL_H;
        set_offset_y(quick.grid, if (y < 0.0f64) 0.0f64 else if (y > most) most else y)
    }
    h
}

// ---- a chapter held: its verses ----
// The verses' grid: its columns, rows and their height.
type GridShape = {
    columns: int;
    rows: int;
    cell_h: f64
}

// The chapter's name over its verses.
QUICK_HELD_TITLE_H: f64 = 26.0f64;

// n verses in a grid inner_w wide, at most room tall: seven columns, more
// where they would be taller than the room, their rows lower if need be.
quick_verse_shape(n: int, inner_w: f64, room: f64): GridShape {
    columns: int = QUICK_COLUMNS;
    fits: int = (room / QUICK_CELL_H) as int;
    if (fits < 1) fits = 1;
    while (columns < 12 && (n + columns - 1) / columns > fits) columns = columns + 1;
    rows: int = (n + columns - 1) / columns;
    cell_h: f64 = QUICK_CELL_H;
    if (rows as f64 * cell_h > room && rows > 0) cell_h = room / rows as f64;
    _w: f64 = inner_w;
    GridShape { columns: columns, rows: rows, cell_h: cell_h }
}

// The held chapter's verses made (its name over them), its chapters hidden.
quick_verses_make() {
    subviews_cleared(quick.verses_view);
    title: int = label_new(font_system(13.0f64, 0.23f64), colors.faint, 1);
    words_begin();
    words_add_ns(quick.book_name);
    words_add(" ");
    words_add_int(quick.held_chapter);
    msg1(title, sel("setText:"), msg(words_ns(), sel("uppercaseString")));
    msg1(title, sel("setTag:"), -1);
    add_sub(quick.verses_view, title);
    n: int = quick_verses[quick.held_chapter - 1];
    for v in 1..n + 1 {
        cell: int = label_new(font_monospaced_digits(16.0f64, 0.0f64), colors.ink,
            1);
        words_begin();
        words_add_int(v);
        msg1(cell, sel("setText:"), words_ns());
        msg1(cell, sel("setTextAlignment:"), 1);
        msg1(cell, sel("setTag:"), v);
        msg1(cell, sel("setClipsToBounds:"), 1);
        msg_set_f(msg(cell, sel("layer")), sel("setCornerRadius:"), 10.0f64);
        add_sub(quick.verses_view, cell)
    }
    set_hidden(quick.grid, true);
    set_hidden(quick.verses_view, false)
}

quick_verses_place(shape: GridShape, inner_w: f64) {
    cell_w: f64 = inner_w / shape.columns as f64;
    subs: int = msg(quick.verses_view, sel("subviews"));
    for i in 0..msg(subs, sel("count")) {
        cell: int = msg1(subs, sel("objectAtIndex:"), i);
        v: int = msg(cell, sel("tag"));
        if (v < 0) set_frame4(cell, 6.0f64, 0.0f64, inner_w - 12.0f64, QUICK_HELD_TITLE_H - 6.0f64) else if (v >= 1) {
            column: int = (v - 1) % shape.columns;
            row: int = (v - 1) / shape.columns;
            set_frame4(cell, column as f64 * cell_w + 2.0f64, QUICK_HELD_TITLE_H + row as f64 * shape.cell_h + 2.0f64,
                cell_w - 4.0f64, shape.cell_h - 4.0f64)
        }
    }
}

// The verse cell at a point in the verses' view (0: none).
quick_verse_at(px: f64, py: f64): int {
    subs: int = msg(quick.verses_view, sel("subviews"));
    for i in 0..msg(subs, sel("count")) {
        cell: int = msg1(subs, sel("objectAtIndex:"), i);
        v: int = msg(cell, sel("tag"));
        if (v >= 1) {
            f: Rect = frame_of(cell);
            if (px >= f.x - 2.0f64 && px < f.x + f.w + 2.0f64 && py >= f.y - 2.0f64 && py < f.y + f.h + 2.0f64) return v
        }
    }
    0
}

// The verse under the finger lit (0: none), felt as it changes.
quick_verse_light(v: int) {
    if (v == quick.held_verse) return;
    subs: int = msg(quick.verses_view, sel("subviews"));
    for i in 0..msg(subs, sel("count")) {
        cell: int = msg1(subs, sel("objectAtIndex:"), i);
        k: int = msg(cell, sel("tag"));
        if (k >= 1 && (k == v || k == quick.held_verse)) {
            set_background(cell, if (k == v) colors.accent else clear_color());
            msg1(cell, sel("setTextColor:"), if (k == v) system_color("whiteColor") else colors.ink)
        }
    }
    quick.held_verse = v;
    if (v > 0) haptic_tick()
}

// The chapters again (the finger lifted away from the verses).
quick_verses_away() {
    quick.held_chapter = 0;
    quick.held_verse = 0;
    set_hidden(quick.verses_view, true);
    set_hidden(quick.grid, false);
    ease(ANIM_GOTO_GRID, 0.2f64)
}

// The chapter button at a point in the chapters' scroll view (0: none).
quick_chapter_at(px: f64, py: f64): int {
    subs: int = msg(quick.grid_content, sel("subviews"));
    for i in 0..msg(subs, sel("count")) {
        button: int = msg1(subs, sel("objectAtIndex:"), i);
        n: int = msg(button, sel("tag"));
        if (n >= 1) {
            f: Rect = frame_of(button);
            if (px >= f.x && px < f.x + f.w && py >= f.y && py < f.y + f.h) return n
        }
    }
    0
}

// ---- what the reader does ----
quick_typed(_self: int, _cmd: int, _field: int): int {
    s: int = quick.slot;
    if (s < 0) return 0;
    wait: f64 = 0.15f64;
    if (screen_load(s) && ui.search_wait > 0) wait = ui.search_wait as f64 / 1000.0f64;
    quick.query_timer = timer_stop(quick.query_timer);
    quick.query_timer = timer_after(quick.root, wait, "vellumGoToQuery:");
    0
}

quick_query_fired(_self: int, _cmd: int, _timer: int): int {
    quick.query_timer = 0;
    quick_send();
    0
}

// The words sent now, if they wait.
quick_send_now() {
    if (quick.query_timer == 0) return;
    quick.query_timer = timer_stop(quick.query_timer);
    quick_send()
}

quick_send() {
    s: int = quick.slot;
    if (s < 0) return;
    out_word("query");
    out_arg(slots[s].id);
    out_byte(32);
    out_ns(msg(quick.field, sel("text")));
    out_end()
}

// Return: where the chooser's mark is Return's, its chapter; else core's
// submit (the reference, the first document or verse found).
quick_returned(_self: int, _cmd: int, _field: int): int {
    s: int = quick.slot;
    if (s < 0) return 0;
    quick_send_now();
    if (!screen_load(s)) return 0;
    quick_passage_take();
    if (quick.has_passage && quick.goes && quick.mark >= 1) act(s, ACT_CHAPTER, quick.first_chapter + quick.mark - 1,
        0) else send1("submit", slots[s].id);
    0
}

quick_row_tapped(_self: int, _cmd: int, sender: int): int {
    s: int = quick.slot;
    if (s < 0 || !screen_load(s)) return 0;
    r: int = msg(sender, sel("tag"));
    if (r < 0 || r >= ui.rows_n) return 0;
    row: UiRow = ui.rows[r];
    if (row.disabled || row.action == 0) return 0;
    haptic_tick();
    quick_send_now();
    act(s, row.action, row.arg, row.value);
    0
}

// A row pressed: washed while the finger is on it (gone as it lifts,
// whether it is tapped or not: a way to more opens a screen and comes back
// to Go To, which would show the wash still).
quick_row_down(_self: int, _cmd: int, sender: int): int {
    set_background(sender, colors.flash);
    0
}

quick_row_up(_self: int, _cmd: int, sender: int): int {
    set_background(sender, clear_color());
    0
}

quick_chip_tapped(_self: int, _cmd: int, sender: int): int {
    s: int = quick.slot;
    if (s < 0) return 0;
    haptic_tick();
    quick_send_now();
    act(s, ACT_GT_PASSAGE_BOOK, msg(sender, sel("tag")), 0);
    0
}

quick_chapter_tapped(_self: int, _cmd: int, sender: int): int {
    s: int = quick.slot;
    n: int = msg(sender, sel("tag"));
    if (s < 0 || n < 1 || quick.held_chapter > 0) return 0;
    haptic_tick();
    act(s, ACT_CHAPTER, quick.first_chapter + n - 1, 0);
    0
}

// A chapter held: its verses; slid to one and lifted there, it is gone
// to; lifted elsewhere, the chapters again.
quick_held(_self: int, _cmd: int, gesture: int): int {
    s: int = quick.slot;
    if (s < 0) return 0;
    state: int = msg(gesture, sel("state"));
    if (state == 1) {
        p: Rect = point_in(gesture, quick.grid_content);
        n: int = quick_chapter_at(p.x, p.y);
        if (n < 1 || n > quick.chapters || quick_verses[n - 1] < 1) return 0;
        quick.held_chapter = n;
        quick.held_verse = 0;
        quick_verses_make();
        haptic_impact(0);
        ease(ANIM_GOTO_GRID, 0.18f64);
        return 0
    }
    if (quick.held_chapter == 0) return 0;
    p: Rect = point_in(gesture, quick.verses_view);
    if (state == 2) quick_verse_light(quick_verse_at(p.x, p.y)) else if (state == 3) {
        v: int = quick_verse_at(p.x, p.y);
        c: int = quick.first_chapter + quick.held_chapter - 1;
        if (v >= 1) act(s, ACT_PLACE, c * 1000 + v, 0) else quick_verses_away()
    } else if (state >= 4) quick_verses_away();
    0
}

quick_close_tapped(_self: int, _cmd: int, _sender: int): int {
    quick_close(true);
    0
}

quick_header_tapped(_self: int, _cmd: int, sender: int): int {
    s: int = quick.slot;
    k: int = msg(sender, sel("tag"));
    if (s < 0 || !screen_load(s) || k < 0 || k >= ui.sections_n) return 0;
    haptic_tick();
    act(s, ui.sections[k].button_action, 0, 0);
    0
}

quick_info_tapped(_self: int, _cmd: int, sender: int): int {
    s: int = quick.slot;
    r: int = msg(sender, sel("tag"));
    if (s < 0 || !screen_load(s) || r < 0 || r >= ui.rows_n) return 0;
    act(s, ui.rows[r].info_action, ui.rows[r].arg, 0);
    0
}

// A row's menu (its actions, screens.l8's row_menu_built), on a long press.
quick_row_menu(
    _self: int,
    _cmd: int,
    interaction: int,
    _location: int
): int {
    s: int = quick.slot;
    if (s < 0 || !screen_load(s)) return 0;
    r: int = msg(msg(interaction, sel("view")), sel("tag"));
    if (r < 0 || r >= ui.rows_n || ui.rows[r].actions_n == 0) return 0;
    if (row_menu_provider == 0) row_menu_provider = block1(&row_menu_built, 0, "@16@?0@8");
    if (row_menu_provider == 0) return 0;
    row_menu_slot = s;
    row_menu_row = r;
    msg3(cls("UIContextMenuConfiguration"), sel("configurationWithIdentifier:previewProvider:actionProvider:"),
        0, 0, row_menu_provider)
}

// A menu's item (a UICommand up the responder chain): its action and the
// row's argument.
quick_command(_self: int, _cmd: int, sender: int): int {
    s: int = quick.slot;
    if (s < 0 || sender == 0 || !responds(sender, "propertyList")) return 0;
    k: int = msg(msg(sender, sel("propertyList")), sel("longValue"));
    act(s, k / 1000000, k % 1000000, 0);
    0
}

quick_backdrop_tapped(_self: int, _cmd: int, _gesture: int): int {
    quick_close(true);
    0
}

// A tap among the rows, above the first of them: closed.
quick_rows_tapped(_self: int, _cmd: int, gesture: int): int {
    p: Rect = point_in(gesture, quick.rows_content);
    if (p.y < quick.rows_top) quick_close(true);
    0
}

// The rows moved by hand: no longer kept at their foot.
quick_rows_dragged(_self: int, _cmd: int, _scroll: int): int {
    quick.rows_at_foot = false;
    0
}

// (Its constraint's view, which the keys move, laid out by UIKit first.)
quick_laid_out(self: int, cmd: int): int {
    _r: int = super1(self, cls("VellumGoToView"), cmd, 0);
    if (self == quick.root || self == quick.leaving) quick_layout();
    0
}

// The overlay's class: a view of the app's window's (not a controller
// presented, which would take a turn before the field could take the
// keys), the target of everything in it.
goto_classes_make() {
    c: int = class_make(cls("UIView"), "VellumGoToView");
    add_method0(c, sel("layoutSubviews"), &quick_laid_out, "v@:");
    add_method1(c, sel("vellumGoToAsk:"), &quick_ask_fired, "v@:@");
    add_method1(c, sel("vellumGoToBegan:"), &quick_field_began, "v@:@");
    add_method1(c, sel("vellumGoToTyped:"), &quick_typed, "v@:@");
    add_method1(c, sel("vellumGoToQuery:"), &quick_query_fired, "v@:@");
    add_method1(c, sel("textFieldShouldReturn:"), &quick_returned, "B@:@");
    add_method1(c, sel("vellumGoToRow:"), &quick_row_tapped, "v@:@");
    add_method1(c, sel("vellumGoToRowDown:"), &quick_row_down, "v@:@");
    add_method1(c, sel("vellumGoToRowUp:"), &quick_row_up, "v@:@");
    add_method1(c, sel("vellumGoToChip:"), &quick_chip_tapped, "v@:@");
    add_method1(c, sel("vellumGoToChapter:"), &quick_chapter_tapped, "v@:@");
    add_method1(c, sel("vellumGoToHold:"), &quick_held, "v@:@");
    add_method1(c, sel("vellumGoToClose:"), &quick_close_tapped, "v@:@");
    add_method1(c, sel("vellumGoToHeader:"), &quick_header_tapped, "v@:@");
    add_method1(c, sel("vellumGoToInfo:"), &quick_info_tapped, "v@:@");
    add_method2(c, sel("contextMenuInteraction:configurationForMenuAtLocation:"),
        &quick_row_menu, "@@:@{CGPoint=dd}");
    add_method1(c, sel("vellumCommand:"), &quick_command, "v@:@");
    add_method1(c, sel("vellumGoToBackdrop:"), &quick_backdrop_tapped, "v@:@");
    add_method1(c, sel("vellumGoToRowsTap:"), &quick_rows_tapped, "v@:@");
    add_method1(c, sel("scrollViewWillBeginDragging:"), &quick_rows_dragged, "v@:@");
    add_protocol(c, "UIContextMenuInteractionDelegate");
    add_protocol(c, "UITextFieldDelegate");
    add_protocol(c, "UIScrollViewDelegate")
}

// ---- the development wire's (devwire.l8) ----
// `!type WORDS`: the words in the field, sent at once.
quick_wire_type(b: []i8, from: int, to: int) {
    if (quick.slot < 0) return;
    msg1(quick.field, sel("setText:"), nsstring_of_range(b, from, to));
    quick.query_timer = timer_stop(quick.query_timer);
    quick_send()
}

// `!tap WORDS` while it shows: its first row whose title begins with WORDS
// (whether there was one).
quick_wire_tap(b: []i8, from: int, to: int): bool {
    s: int = quick.slot;
    if (s < 0 || !screen_load(s)) return false;
    want: int = nsstring_of_range(b, from, to);
    for r in 0..ui.rows_n {
        title: int = ui_text(ui.rows[r].title);
        if (title != 0 && truth(msg1(title, sel("hasPrefix:"), want))) {
            act(s, ui.rows[r].action, ui.rows[r].arg, ui.rows[r].value);
            return true
        }
    }
    false
}

// `!hold N V`: chapter N held, the finger on verse V (shown, not gone to);
// `!hold 0`: the chapters again.
quick_wire_hold(chapter: int, verse: int) {
    if (quick.slot < 0 || !quick.has_passage) return;
    if (chapter < 1 || chapter > quick.chapters) {
        quick_verses_away();
        return
    }
    quick.held_chapter = chapter;
    quick.held_verse = 0;
    quick_verses_make();
    quick_verse_light(verse);
    ease(ANIM_GOTO_GRID, 0.18f64)
}

// What `!state` says of it.
quick_state() {
    if (quick.slot < 0) return;
    words_begin();
    words_add("vellum: goto quick screen ");
    words_add_int(slots[quick.slot].id);
    words_add(" rows ");
    words_add_int(quick.rows_height as int);
    words_add(" passage ");
    words_add_int(if (quick.has_passage) quick.first_chapter else -1);
    words_add(" mark ");
    words_add_int(quick.mark);
    words_add(if (quick.goes) " goes" else " row");
    words_add(" held ");
    words_add_int(quick.held_chapter);
    words_add(if (responds(quick.root, "vellumGoToHeader:") && responds(quick.root,
        "vellumCommand:")) " taps" else " TAPS MISSING");
    words_add(" keys ");
    words_add_int(if (truth(msg(quick.field, sel("isFirstResponder")))) 1 else 0);
    note_ns(words_ns())
}

// The old build's overlay let go of (hot reload): its globals are gone.
goto_views_removed(view: int) {
    subs: int = msg(msg(view, sel("subviews")), sel("copy"));
    for i in 0..msg(subs, sel("count")) {
        v: int = msg1(subs, sel("objectAtIndex:"), i);
        if (is_kind(v, "VellumGoToView")) msg(v, sel("removeFromSuperview"))
    }
    release(subs)
}

// ---- deeper: a screen Go To opens ----
// A screen Go To opens (Books of the Bible, History, Plans, Browse, a
// document's page, every verse found) fills the room above the field, the
// keys down, the field's words kept: a navigation of the app's (screens.l8's
// lists, the system's) on a shape of its own, a child of the overlay's
// controller, its
// first screen's Back (‹) Go To again, each deeper one's the one before.
// The field's tap is Go To again too, the keys up; a place picked in it
// closes Go To, as anywhere.
quick_drilled(): bool {
    quick.drill_phase == QUICK_DRILL_SHOWN
}

// Whether controller is on the navigation of the screens Go To opened.
quick_drill_holds(controller: int): bool {
    quick.drill_nav != 0 && msg(controller, sel("navigationController")) == quick.drill_nav
}

// Where the screens Go To opened are: none (Go To's home shows), shown
// (the room above the field), or going back into Go To's panel (its
// navigation let go as it gets there).
QUICK_DRILL_NONE: int = 0;

QUICK_DRILL_SHOWN: int = 1;

QUICK_DRILL_LEAVING: int = 2;

// Slot s's screen, pushed over Go To: the first of them, the navigation
// made (later ones are pushed onto it, screens.l8's sheet navigation).
// Its glass is Go To's panel's at first, in its place and shape (the
// panel's own let go there, its words fading), and grows with a spring
// into the room above the field as the keys fall, the screen's lists
// fading in; the chooser's glass dissolves.
quick_drill_begin(s: int) {
    controller: int = slot_controller(s);
    nav: int = nav_new(controller);
    quick.drill_nav = held(quick.drill_nav, nav);
    sheet_nav = held(sheet_nav, nav);
    msg1(quick.host, sel("addChildViewController:"), nav);
    view: int = msg(nav, sel("view"));
    set_background(view, clear_color());
    add_sub(glass_content(quick.drill_box), view);
    msg1(nav, sel("didMoveToParentViewController:"), quick.host);
    // (From the panel's place, at once, the lists clear.)
    set_frame(quick.drill_box, quick_panel_rect());
    set_frame(view, bounds_of(quick.drill_box));
    set_hidden(quick.drill_box, false);
    set_alpha(view, 0.0f64);
    if (quick.panel != 0) msg1(quick.panel, sel("setEffect:"), 0);
    quick.drill_phase = QUICK_DRILL_SHOWN;
    msg(quick.root, sel("setNeedsLayout"));
    quick_covered();
    spring(ANIM_GOTO_DRILL, 0.5f64, 0.08f64)
}

// Back to Go To: the screens' glass goes back into Go To's panel's shape,
// where the panel will be once the keys are up (fixed as it goes, so the
// keys' own layout doesn't pull at it), with a spring as long as the keys
// take, the lists fading and the panel's words coming back. Core is told
// the screens closed (the first and those over it, unless core closed
// them) only once it is there: its Go To made again meanwhile would be
// work for the frames.
quick_drill_home(said: bool) {
    nav: int = quick.drill_nav;
    if (nav == 0 || quick.drill_phase != QUICK_DRILL_SHOWN) return;
    first: int = msg(msg(nav, sel("viewControllers")), sel("firstObject"));
    s: int = slot_of_controller(first);
    quick.drill_closing = (if (said && s >= 0) slots[s].id else 0);
    sheet_mark_closing(msg(nav, sel("viewControllers")));
    quick.drill_target = quick_panel_rect_risen();
    quick.drill_phase = QUICK_DRILL_LEAVING;
    set_hidden(quick.rows, false);
    quick_focus();
    spring(ANIM_GOTO_DRILL, 0.36f64, 0.0f64)
}

// Where Go To's panel will be once the keys are up (their height as last
// seen): its rows at their foot, over the chooser, over the field.
quick_panel_rect_risen(): Rect {
    b: Rect = bounds_of(quick.root);
    keys: f64 = if (quick.keys_h > 0.0f64) quick.keys_h else b.h * 0.4f64;
    field_y: f64 = b.h - keys - QUICK_GAP - QUICK_FIELD_H;
    rows_bottom: f64 = field_y - QUICK_GAP - quick_chooser_height();
    if (quick.panel == 0) return Rect {
        x: quick_left(b.w),
        y: field_y,
        w: quick_width(b.w),
        h: QUICK_FIELD_H
    };
    f: Rect = frame_of(quick.panel);
    Rect {
        x: f.x,
        y: rows_bottom - quick.rows_height + f.y,
        w: f.w,
        h: f.h
    }
}

// (ANIM_GOTO_DRILL's layout: the lists, the panel's words and the
// chooser's glass as the phase has them; the shapes where they go.)
quick_drill_animated() {
    if (quick.root == 0) return;
    shown: bool = quick.drill_phase == QUICK_DRILL_SHOWN;
    nav_view: int = if (quick.drill_nav != 0) msg(quick.drill_nav, sel("view")) else 0;
    if (nav_view != 0) set_alpha(nav_view, if (shown) 1.0f64 else 0.0f64);
    if (quick.panel != 0) set_alpha(glass_content(quick.panel), if (shown) 0.0f64 else 1.0f64);
    quick_chooser_shown(!shown && quick.has_passage);
    if (shown) msg(quick.root, sel("layoutIfNeeded")) else set_frame(quick.drill_box,
        quick.drill_target)
}

// The spring ended: shown, Go To's rows hidden under the glass; gone back,
// the navigation let go and the panel's own glass where its was.
quick_drill_settled() {
    if (quick.root == 0) return;
    if (quick.drill_phase == QUICK_DRILL_SHOWN) {
        set_hidden(quick.rows, true);
        return
    }
    if (quick.drill_phase != QUICK_DRILL_LEAVING) return;
    if (quick.panel != 0) glass_shown(quick.panel, true, false, dock_tint());
    set_hidden(quick.drill_box, true);
    closing: int = quick.drill_closing;
    quick.drill_closing = 0;
    quick_drill_detach();
    if (closing > 0) send1("closed", closing)
}

// The navigation let go of: its screens marked closing (they are said
// closed, if at all, by quick_drill_home), off the overlay's controller,
// the sheet's navigation none.
quick_drill_detach() {
    nav: int = quick.drill_nav;
    quick.drill_phase = QUICK_DRILL_NONE;
    if (nav == 0) return;
    sheet_mark_closing(msg(nav, sel("viewControllers")));
    msg1(nav, sel("willMoveToParentViewController:"), 0);
    msg(msg(nav, sel("view")), sel("removeFromSuperview"));
    msg(nav, sel("removeFromParentViewController"));
    if (sheet_nav == nav) sheet_nav = held(sheet_nav, 0);
    quick.drill_nav = held(quick.drill_nav, 0);
    screens_forget_gone_soon()
}

// The chooser's glass (the book chips, the grid) formed or dissolved.
quick_chooser_shown(shown: bool) {
    glass_shown(quick.grid_glass, shown, false, dock_tint());
    quick_contents_shown(quick.chips_content, shown, true)
}

// Go To's panel's place and shape in the overlay (the rows' scroll view's
// frame, less how far it has scrolled), or the field's without one.
quick_panel_rect(): Rect {
    if (quick.panel == 0) return frame_of(quick.field_box);
    f: Rect = frame_of(quick.panel);
    r: Rect = frame_of(quick.rows);
    Rect {
        x: r.x + f.x,
        y: r.y + f.y - offset_y(quick.rows),
        w: f.w,
        h: f.h
    }
}

// The field begun to be typed in while a screen Go To opened shows: Go To
// again.
quick_field_began(_self: int, _cmd: int, _field: int): int {
    if (quick_drilled()) quick_drill_home(true);
    0
}

// The first screen's Back (screens.l8's list_dress gives it).
quick_drill_back_tapped(_self: int, _cmd: int, _item: int): int {
    quick_drill_home(true);
    0
}

// Slot s's list's rows' color: on Go To's glass (a screen Go To opened), the
// ink's wash, or nothing for a page's or a plain list's, the glass under
// them; else the theme's (a page's its page, a sheet's its rows').
cell_color_of(s: int): int {
    if (s >= 0 && quick_drill_holds(slots[s].controller)) return if (ui.page || ui.plain) clear_color() else colors.well;
    if (ui.page) colors.page else colors.cell
}
