tag bible_ios;

use_tag std, ios, bible;

// The demo's §15 steps (DESIGN.md §15.7, as §15.11 leaves them: the quick
// tips removed): the `help` group, on the demo clock, from a fresh install:
// Go To with no tip, Reading settings' Help, the Manual's contents, a page,
// a link, the search, Night, the largest text, the Greek and Hebrew and
// Memory pages. Each tap is made through the function the control calls.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/help.l8";

// The page and the part of an anchor ("ribbons#making"; -1 none).
d15_part(anchor: str): int {
    help_load();
    for t in 0..hpt_n {
        fbuf_n = 0;
        help_fput_anchor(t);
        if (fbuf_n == len(anchor)) {
            same: bool = true;
            for i in 0..len(anchor)
                if (fbuf[i] != anchor[i]) same = false;
            if (same) return t
        }
    }
    -1
}

d15_page(anchor: str): int {
    t: int = d15_part(anchor);
    if (t < 0) -1 else hpt_page[t]
}

// Go To opened afresh (any sheet put away first).
d15_reopen(d: int) {
    if (presented() != 0) {
        demo_dismiss();
        demo_later_at(0.6f64, d);
        return
    }
    open_picker()
}

// The page on top's slot (-1: none).
d15_top_page(): int {
    top: int = top_presented();
    if (top == 0 || !responds(top, "topViewController")) return -1;
    help_slot_of_vc(msg(top, sel("topViewController")))
}

// A link in the page on top tapped where it is drawn: the one to part t.
d15_tap_link(t: int) {
    k: int = d15_top_page();
    if (k < 0) return;
    tv: int = hpv_tv[k];
    storage: int = msg(tv, sel("textStorage"));
    n: int = msg(storage, sel("length"));
    key: int = nsstring(k_help_link);
    for i in 0..n {
        v: int = msg3(storage, sel("attribute:atIndex:effectiveRange:"), key, i, 0);
        if (v != 0 && msg(v, sel("longValue")) == t + 1 && range_rect(tv, i, 1)) {
            x: f64 = hfa[0] + hfa[2] / 2.0f64;
            y: f64 = hfa[1] + hfa[3] / 2.0f64;
            // (Seen there as the tap would find it.)
            found: int = link_at(tv, x, y, k_help_link) - 1;
            note_num("bible: demo link found part ", found);
            if (found >= 0) help_follow(k, found);
            return
        }
    }
    note("bible: demo link not found")
}

demo_do15(t: int) {
    if (t == 440) {
        // 400: a fresh install; the title tapped: Go To, no tip, at the book
        // read (§15.11).
        demo_dismiss();
        open_picker()
    }
    if (t == 447) {
        // 407: Reading settings, at Help.
        demo_dismiss();
        demo_later_at(0.6f64, 803)
    }
    if (t == 448) {
        // 408: Manual.
        settings_picked(7, 0)
    }
    if (t == 449) {
        // 409: Selecting Verses.
        help_picked(mn_table, 0, d15_page("tray#select"))
    }
    if (t == 450) {
        // 410: its link to Memory.
        d15_tap_link(d15_part("memory#adding"))
    }
    if (t == 451) {
        // 411: back to the contents; "ribbon" searched.
        top: int = top_presented();
        if (top != 0 && mn_vc != 0) msg2(top, sel("popToViewController:animated:"),
            mn_vc, 0);
        demo_later_at(0.5f64, 805)
    }
    if (t == 454) {
        // 414: Night; Go To.
        demo_dismiss();
        set_theme = 4;
        settings_changed(true);
        demo_later_at(0.6f64, 800)
    }
    if (t == 455) {
        // 414b: a page in it (Selecting Verses: its symbols).
        help_open_page(d15_page("tray#select"), -1, false)
    }
    if (t == 456) {
        // 415: (the largest text) Auto again; Go To.
        demo_dismiss();
        set_theme = 0;
        settings_changed(true);
        demo_later_at(0.6f64, 800)
    }
    if (t == 457) {
        // 416: (the largest text) a page.
        help_open_page(d15_page("tray#select"), -1, false)
    }
    if (t == 458) {
        // 417: Reading settings → Manual → Greek and Hebrew.
        demo_dismiss();
        d15_after = d15_page("languages#start");
        demo_later_at(0.6f64, 806)
    }
    if (t == 459) {
        // 418: Manual → Memory.
        top: int = top_presented();
        if (top != 0 && mn_vc != 0) msg2(top, sel("popToViewController:animated:"),
            mn_vc, 0);
        help_open_page(d15_page("memory#adding"), -1, false)
    }
}

// The page to open after the Manual (417's).
d15_after: int = -1;

demo_later15(d: int) {
    if (d == 800) {
        d15_reopen(800);
        return
    }
    if (d == 803) {
        if (presented() != 0) {
            demo_dismiss();
            demo_later_at(0.6f64, 803);
            return
        }
        open_settings();
        demo_later_at(0.9f64, 807);
        return
    }
    if (d == 807) {
        if (settings_table != 0) msg3(settings_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
            msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0, 7), 2,
            0);
        return
    }
    if (d == 805) {
        if (mn_search == 0) return;
        msg1(mn_search, sel("setActive:"), 1);
        bar: int = msg(mn_search, sel("searchBar"));
        msg1(bar, sel("setText:"), nsstring("ribbon"));
        _f: bool = help_search_updated(mn_search);
        msg(bar, sel("resignFirstResponder"));
        return
    }
    if (d == 806) {
        if (presented() != 0) {
            demo_dismiss();
            demo_later_at(0.6f64, 806);
            return
        }
        open_settings();
        demo_later_at(0.9f64, 808);
        return
    }
    if (d == 808) {
        help_open_manual();
        demo_later_at(0.8f64, 809);
        return
    }
    if (d == 809) {
        if (d15_after >= 0) help_open_page(d15_after, -1, false);
        return
    }
}
