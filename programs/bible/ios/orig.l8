tag bible_ios;

use_tag std, ios, bible;

// The Hebrew and Greek in the reader (DESIGN.md §14.11): its data mapped
// at first use; Reading settings' Glosses and Show Accents (in this version
// only); the glosses made for each chapter as it is laid out, and the
// glossed words' dotted lines; a word's popover, from an apparatus entry
// (the form, its transliteration, gloss, meaning here, parsing, Ketiv and
// Hebrew number, Word Study and Learn This Word); and the reader laid out
// again once cards change. orig.l8 is its portable part; text.l8 lays the
// words out.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/lang.l8";

import "../core/learn.l8";

import "../core/orig.l8";

// ---- the data, at first use (never at launch, but in this version) ----
orig_mapped: bool = false;

// orig-words.bin and the Ketivs, and the language data the glosses read;
// false if the words are not in the bundle.
orig_open(): bool {
    if (!orig_mapped) {
        orig_mapped = true;
        t0: f64 = CFAbsoluteTimeGetCurrent();
        og = lang_map("orig-words", "bin");
        og_n = lang_mapped / 12;
        lket = lang_map("orig-ketiv", "txt");
        lket_n = lang_mapped;
        ket_index();
        ensure_learn_lang();
        og_setting = pref_fit("origGlosses", def_int("origGlosses")) - 1;
        lay_accents = def_bool("origAccents");
        if (lay_accents) accents_open();
        note_num("bible: orig words mapped, ms ", ((CFAbsoluteTimeGetCurrent() - t0) * 1000.0f64) as int)
    }
    og_n > 0
}

// The cantillated forms (orig-accents.txt), for Show Accents.
accents_open() {
    if (og_acc_n > 0) return;
    og_acc = lang_map("orig-accents", "txt");
    og_acc_n = lang_mapped;
    og_acc_index()
}

// ---- the reader ----
// Chapter c's glosses made before it is laid out (in this version), and
// the log's line when they are new: "bible: orig JHN 3 glossed 41 of 512
// (words I haven't learned)".
orig_before_layout_source(source: *TextSource, c: int) {
    if (source.version != TEXT_ORIG || og_n == 0) return;
    was: int = og_gl_c;
    gen: int = og_gl_gen;
    orig_prepare(c);
    if (was == c && gen == og_gl_gen) return;
    if (!diag_on) return;
    // (Written out bit by bit, not through fbuf, which a layout may come in
    // the middle of.)
    try {
        write(2, "bible: orig ");
        b: int = ch_book[c];
        for i in 0..3 one_byte_out(source.data[source.book_lines[b] + 1 + i] as int);
        write(2, " ");
        write_int(2, ch_num[c]);
        write(2, " glossed ");
        write_int(2, og_prep_glossed);
        write(2, " of ");
        write_int(2, og_prep_words);
        write(2, " (");
        write(2, gloss_names_lower[og_gl_mode]);
        write(2, ")\n")
    } with IoError _e -> { }
}

ob_buf: []i8 = new i8[1](0i8);

one_byte_out(k: int) raises IoError {
    ob_buf[0] = k trunc i8;
    write_bytes_n(2, ob_buf, 1)
}

// fbuf as a line of the log.
note_fbuf() {
    if (!diag_on) return;
    try {
        write_bytes_n(2, fbuf, fbuf_n);
        write(2, "\n")
    } with IoError _e -> { }
}

// A place past the marks inserted by the visible reader.
shifted(u: int, begin: bool): int {
    rendering: *ReaderRendering = active_rendering();
    ranges_shifted(&rendering.ranges, u, begin)
}

paint_glosses_in(
    ranges: *ChapterRanges,
    s: int,
    c: int,
    preview: bool
) {
    n: int = msg(s, sel("length"));
    for i in 0..ranges.gw_n {
        // (Not in a verse selected: its own line is there.)
        k: int = ranges_at(ranges, ranges.gw_b[i]);
        chosen: bool = !preview && c == sel_c && k >= 0 && is_selected(ranges.rv_num[k]);
        if (!chosen && ranges.gw_e[i] > ranges.gw_b[i] && ranges.gw_e[i] <= n) {
            msg4(s, sel("addAttribute:value:range:"), k_underline, nsnumber_int(257),
                ranges.gw_b[i], ranges.gw_e[i] - ranges.gw_b[i]);
            msg4(s, sel("addAttribute:value:range:"), k_underline_color, c_gloss_line,
                ranges.gw_b[i], ranges.gw_e[i] - ranges.gw_b[i])
        }
    }
}

// A card changed: the glosses made again at the next layout; the reader's
// rows once Practice (or the sheet) is put away (§14.11.4).
orig_relayout_due: bool = false;

orig_cards_changed() {
    orig_forget();
    if (text_cur == TEXT_ORIG) orig_relayout_due = true
}

// The sheets put away: the reader laid out again, if a card changed.
orig_sheets_gone() {
    if (!orig_relayout_due) return;
    orig_relayout_due = false;
    if (text_cur != TEXT_ORIG) return;
    note("bible: orig relaid after cards changed");
    relayout()
}

// ---- Reading settings: Glosses and Show Accents (§14.11.3, §14.11.4) ----
gloss_names_lower: []str = ["words I haven't learned", "rare words", "none"];

// Show Accents on or off: the cantillation shown (or not), the reader
// cross-fading, the place kept.
set_accents(on: bool) {
    if (on) accents_open();
    lay_accents = on && og_acc_n > 0;
    set_def_bool("origAccents", lay_accents);
    note(if (lay_accents) "bible: orig accents on" else "bible: orig accents off");
    fade_layer(msg(table, sel("layer")), if (reduce_motion()) 0.15f64 else 0.2f64);
    relayout()
}

// Glosses: core's screen (core/skin.l8's SCR_GLOSSES), pushed in the
// settings sheet.
open_glosses() {
    if (settings_nav == 0) return;
    uk_open(SCR_GLOSSES, 0, true, settings_nav)
}

// A mode chosen: kept, the glosses made again, the reader cross-fading
// behind the sheet, the checkmark moved.
set_gloss_mode(r: int) {
    if (r < 0 || r > 2) return;
    haptic_select();
    og_setting = r;
    set_def_int("origGlosses", r + 1);
    orig_forget();
    fbuf_n = 0;
    fput_str("bible: orig glosses ");
    fput_str(gloss_names_lower[r]);
    note_fbuf();
    fade_layer(msg(table, sel("layer")), if (reduce_motion()) 0.15f64 else 0.25f64);
    relayout()
}

// ---- a word's popover (§14.11.4) ----
// Over the reader, pointing at the entry tapped: the word (hero size), its
// transliteration, its gloss, its meaning here and domain (UBS's), its
// parsing in plain words, a Qere's Ketiv, the verse's Hebrew number where it
// differs; Word Study and Learn This Word (or how its card stands).
wp_w: int = -1;

wp_vc: int = 0;

wp_learn: int = 0;

wp_stack: int = 0;

// A label of fbuf's words, in a font and color, wrapping.
wp_label(font: int, color: int, rtl: bool): int {
    l: int = make("UILabel");
    msg1(l, sel("setNumberOfLines:"), 0);
    msg1(l, sel("setFont:"), font);
    msg1(l, sel("setTextColor:"), color);
    msg1(l, sel("setText:"), fstring());
    if (rtl) msg1(l, sel("setTextAlignment:"), 2);
    msg(l, sel("autorelease"))
}

// The popover's button: a title, its action.
// The popover's sizes follow the reader's: the gloss as a footnote's text,
// 0.88 em from 15 to 22 points, the smaller lines in proportion (they were
// set for a gloss of 19); the form keeps its hero size. Review r11-1.
wp_gloss_size(): f64 {
    size: f64 = em * 0.88f64;
    if (size < 15.0f64) size = 15.0f64;
    if (size > 22.0f64) size = 22.0f64;
    size
}

wp_button(title: str, action: str): int {
    config: int = msg(cls("UIButtonConfiguration"), sel("tintedButtonConfiguration"));
    msg1(config, sel("setBaseForegroundColor:"), c_accent);
    msg1(config, sel("setBaseBackgroundColor:"), c_accent);
    msg1(config, sel("setCornerStyle:"), 4);
    // (Two side by side on one line each: small insets.)
    msg_rect(config, sel("setContentInsets:"), 9.0f64, 8.0f64, 9.0f64, 8.0f64);
    msg1(config, sel("setTitleLineBreakMode:"), 4);
    keys[0] = k_font;
    values[0] = sans(14.0f64, 0.3f64);
    t: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        nsstring(title), nsdictionary(keys, values, 1));
    msg1(config, sel("setAttributedTitle:"), t);
    release(t);
    b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel(action), 64);
    b
}

show_word_popover(
    tv: int,
    _c: int,
    w: int,
    x: f64,
    y: f64
) {
    host: int = top_presented();
    if (host != 0) return;
    host = nav;
    if (w < 0 || w >= og_n) return;
    wp_w = w;
    greek: bool = og_greek(w);
    lang: int = og_lang(w);
    vc: int = make("UIViewController");
    view: int = msg(vc, sel("view"));
    bg: int = if (theme == 2 || theme == 4) msg(cls("UIColor"), sel("systemBackgroundColor")) else c_cell;
    msg1(view, sel("setBackgroundColor:"), bg);
    col: int = stack(1, 4.0f64);
    msg1(col, sel("setAlignment:"), 0);
    gsize: f64 = wp_gloss_size();
    r: f64 = gsize / 19.0f64;
    // (Core's parts, core/word.l8: its verse, and the Hebrew's own number
    // where it differs; its form, transliteration, gloss, meaning,
    // parsing, Qere and Ketiv.)
    uk_sync();
    wp_part(w, WP_WHERE);
    msg1(col, sel("addArrangedSubview:"), wp_label(sans(12.0f64 * r, 0.3f64), c_faint,
        false));
    wp_part(w, WP_FORM);
    form: int = wp_label(if (greek) new_york(34.0f64) else sans(40.0f64, 0.0f64),
        c_ink, !greek);
    msg1(form, sel("setAccessibilityLanguage:"), nsstring(if (greek) "el" else "he"));
    msg1(col, sel("addArrangedSubview:"), form);
    wp_part(w, WP_TR);
    if (fbuf_n > 0) {
        tl: int = wp_label(msg_set_f(cls("UIFont"), sel("italicSystemFontOfSize:"),
            15.0f64 * r), c_faint, false);
        msg1(col, sel("addArrangedSubview:"), tl);
        msg1(form, sel("setAccessibilityHint:"), fstring())
    }
    wp_part(w, WP_GLOSS);
    if (fbuf_n > 0) msg1(col, sel("addArrangedSubview:"), wp_label(body(gsize), c_ink,
        false));
    wp_part(w, WP_MEANING);
    if (fbuf_n > 0) msg1(col, sel("addArrangedSubview:"), wp_label(sans(14.0f64 * r,
        0.0f64), c_heading, false));
    wp_part(w, WP_PARSING);
    if (fbuf_n > 0) msg1(col, sel("addArrangedSubview:"), wp_label(sans(13.0f64 * r,
        0.0f64), c_faint, false));
    wp_part(w, WP_QERE);
    if (fbuf_n > 0) msg1(col, sel("addArrangedSubview:"), wp_label(sans(13.0f64 * r,
        0.0f64), c_faint, false));
    // (Word Study, where the BSB's tables have the word; Learn This Word, or
    // its card.)
    row: int = stack(0, 8.0f64);
    msg1(row, sel("setDistribution:"), 1);
    if (wp_has_study(w)) msg1(row, sel("addArrangedSubview:"), wp_button(wp_study_title,
        "wpStudy:"));
    wp_learn = 0;
    k: int = wp_card(w);
    if (k == -2) {
        wp_learn = wp_button(wp_learn_title, "wpLearn:");
        msg1(row, sel("addArrangedSubview:"), wp_learn)
    } else if (k >= 0) {
        fbuf_n = 0;
        fput_wp_card(k);
        msg1(row, sel("addArrangedSubview:"), wp_label(sans(13.0f64 * r, 0.0f64),
            c_faint, false))
    }
    msg1(col, sel("addArrangedSubview:"), row);
    msg1(view, sel("addSubview:"), col);
    pin_by(col, view, "leadingAnchor", 16.0f64);
    pin_by(col, view, "topAnchor", 14.0f64);
    pin_size(col, "widthAnchor", 288.0f64);
    msg_rect(view, sel("setFrame:"), 0.0f64, 0.0f64, 320.0f64, 2000.0f64);
    msg_ff(vc, sel("setPreferredContentSize:"), 320.0f64, popover_height(view, col));
    msg1(vc, sel("setModalPresentationStyle:"), 7);
    pop: int = msg(vc, sel("popoverPresentationController"));
    msg1(pop, sel("setSourceView:"), tv);
    msg_rect(pop, sel("setSourceRect:"), x - 4.0f64, y - 10.0f64, 8.0f64, 20.0f64);
    msg1(pop, sel("setPermittedArrowDirections:"), 3);
    msg1(pop, sel("setBackgroundColor:"), bg);
    msg1(pop, sel("setDelegate:"), app_obj);
    wp_vc = held(wp_vc, vc);
    bar_expand();
    keep_screen_release();
    fbuf_n = 0;
    fput_str("bible: orig popover ");
    fput_og_form(w);
    note_fbuf();
    msg3(host, sel("presentViewController:animated:completion:"), vc, 1, 0);
    release(vc)
}

// The stack's height at its width (laid out in its view, tall enough),
// plus the popover's margins.
popover_height(view: int, col: int): f64 {
    msg(view, sel("setNeedsLayout"));
    msg(view, sel("layoutIfNeeded"));
    l8_msg_hfa(hfa, col, sel("frame"), 0, 0, 0);
    hfa[3] + 30.0f64
}

// Word Study: the popover away, then the word's study as a sheet.
wp_study(_self: int, _cmd: int, _b: int): int {
    w: int = wp_w;
    j: int = og_join(w);
    if (j < 0) return 0;
    vi: int = word_verse(j);
    pending_study_vi = vi;
    pending_study_w = j;
    msg2(nav, sel("dismissViewControllerAnimated:completion:"), 1, 0);
    _t: int = after(0.35f64, "wpStudyLater:");
    0
}

pending_study_vi: int = -1;

pending_study_w: int = -1;

wp_study_later(_self: int, _cmd: int, _timer: int): int {
    if (pending_study_vi < 0) return 0;
    if (presented() != 0 && (msg(presented(), sel("isBeingDismissed")) & 255) != 0) {
        _t: int = after(0.1f64, "wpStudyLater:");
        return 0
    }
    vi: int = pending_study_vi;
    pending_study_vi = -1;
    open_study_sheet(vi, pending_study_w);
    0
}

// Learn This Word: the card added, the button's place says so, a toast.
wp_learn_tapped(_self: int, _cmd: int, _b: int): int {
    w: int = wp_w;
    if (w < 0) return 0;
    // (Core's: the card made and kept.)
    uk_sync();
    k: int = wp_learn_word(w);
    if (k < 0) return 0;
    if (wp_learn != 0) {
        // (In its place, the card's line as the popover shows it once the
        // word has a card, wrapping: "Learning · in your next practice" is
        // too long for a button beside Word Study. The popover grows to it.)
        row: int = msg(wp_learn, sel("superview"));
        fbuf_n = 0;
        fput_wp_card(k);
        if (row != 0) {
            msg1(row, sel("addArrangedSubview:"), wp_label(sans(13.0f64 * wp_gloss_size() / 19.0f64,
                0.0f64), c_faint, false));
            msg(wp_learn, sel("removeFromSuperview"));
            col: int = msg(row, sel("superview"));
            if (wp_vc != 0 && col != 0) msg_ff(wp_vc, sel("setPreferredContentSize:"),
                320.0f64, popover_height(msg(wp_vc, sel("view")), col))
        }
        wp_learn = 0
    }
    toast_symbol(nsstring(wp_added(w)), "plus", 1.6f64);
    fbuf_n = 0;
    fput_str("bible: toast ");
    fput_str(wp_added(w));
    note_fbuf();
    0
}

add_orig_methods(app: int) {
    add_method1(app, sel("letterKey:"), &letter_key, "v@:@");
    add_method1(app, sel("keyboardFramed:"), &keyboard_framed, "v@:@");
    add_method1(app, sel("wpStudy:"), &wp_study, "v@:@");
    add_method1(app, sel("wpStudyLater:"), &wp_study_later, "v@:@");
    add_method1(app, sel("wpLearn:"), &wp_learn_tapped, "v@:@")
}

// ---- the letter keyboard (§14.11.5) ----
// A keyboard of our own for Greek and Hebrew letters, the inputView of
// Practice's first-letter keys (and, from Round 12, of answers): three rows
// in the system keyboard's order (Greek's; the Israeli layout's), then
// space, delete and Return. Its keys are buttons sized like the system's
// (its height the system keyboard's as last seen, else 216 points), with a
// click, and VoiceOver's names of the letters.
// (Its rows and the letters' spoken names: core/keys.l8's kb_*.)
lk_class: int = 0;

// initWithFrame:inputViewStyle: (a rect, then an integer).
extern msg_rect_i(
    receiver: int,
    selector: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    style: int
): int = objc_msgSend;

lk_view: int = 0;

lk_hebrew: bool = false;

// The system keyboard's height, once seen (0: not yet).
kb_seen_h: f64 = 0.0f64;

// A system keyboard's frame changing: its height kept (without
// Practice's bar over it).
keyboard_framed(_self: int, _cmd: int, note_obj: int): int {
    info: int = msg(note_obj, sel("userInfo"));
    if (info == 0) return 0;
    v: int = msg1(info, sel("objectForKey:"), objc_const("UIKeyboardFrameEndUserInfoKey"));
    if (v == 0) return 0;
    l8_msg_hfa(hfa, v, sel("CGRectValue"), 0, 0, 0);
    h: f64 = hfa[3];
    // (Ours is not the system's.)
    if (lk_view != 0 && px_keyboard_up() && mt_orig) return 0;
    if (px_keyboard_up()) h = h - 44.0f64;
    if (h >= 180.0f64 && h <= 420.0f64) kb_seen_h = h;
    0
}

// The keyboard for the passage practised: Greek or Hebrew.
letter_keyboard(hebrew: bool): int {
    if (lk_view != 0 && lk_hebrew == hebrew) return lk_view;
    lk_hebrew = hebrew;
    h: f64 = if (kb_seen_h > 0.0f64) kb_seen_h else 216.0f64;
    l8_msg_hfa(hfa, msg(cls("UIScreen"), sel("mainScreen")), sel("bounds"), 0, 0,
        0);
    w: f64 = hfa[2];
    kb: int = msg_rect_i(msg(lk_class, sel("alloc")), sel("initWithFrame:inputViewStyle:"),
        0.0f64, 0.0f64, w, h, 1);
    msg1(kb, sel("setAllowsSelfSizing:"), 0);
    col: int = stack(1, 10.0f64);
    msg1(col, sel("setDistribution:"), 1);
    rows: []str = if (hebrew) kb_hebrew_rows else kb_greek_rows;
    names: []str = if (hebrew) kb_hebrew_names else kb_greek_names;
    at: int = 0;
    for r in 0..3 {
        row: int = stack(0, 6.0f64);
        msg1(row, sel("setDistribution:"), 1);
        s: str = rows[r];
        i: int = 0;
        while (i < len(s)) {
            cp: int = str_cp(s, i);
            i = i + str_cp_n;
            msg1(row, sel("addArrangedSubview:"), lk_key(cp, names[at]));
            at = at + 1
        }
        // (A shorter row centred, as the system's are.)
        if (len_cps(s) < 10) {
            msg1(row, sel("setLayoutMarginsRelativeArrangement:"), 1);
            pad: f64 = (10 - len_cps(s)) as f64 * w / 22.0f64;
            msg_rect(row, sel("setLayoutMargins:"), 0.0f64, pad, 0.0f64, pad)
        }
        msg1(col, sel("addArrangedSubview:"), row)
    }
    last: int = stack(0, 6.0f64);
    space: int = lk_key(32, "space");
    msg1(last, sel("addArrangedSubview:"), space);
    del: int = lk_key(8, "delete");
    msg1(last, sel("addArrangedSubview:"), del);
    ret: int = lk_key(10, "return");
    msg1(last, sel("addArrangedSubview:"), ret);
    pin_size(del, "widthAnchor", w * 0.16f64);
    pin_size(ret, "widthAnchor", w * 0.22f64);
    msg1(col, sel("addArrangedSubview:"), last);
    msg1(kb, sel("addSubview:"), col);
    pin_by(col, kb, "leadingAnchor", 4.0f64);
    pin_by(col, kb, "trailingAnchor", -4.0f64);
    pin_by(col, kb, "topAnchor", 8.0f64);
    pin_to(col, "bottomAnchor", msg(kb, sel("safeAreaLayoutGuide")), "bottomAnchor",
        -4.0f64);
    lk_view = held(lk_view, kb);
    release(kb);
    note(if (hebrew) "bible: letter keyboard hebrew" else "bible: letter keyboard greek");
    lk_view
}

// A key: a letter (its code point, its name for VoiceOver), space (32),
// delete (8) or Return (10).
lk_key(cp: int, name: str): int {
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    letter: bool = cp > 32;
    bgc: int = msg(cls("UIColor"), sel(if (letter || cp == 32) "systemBackgroundColor" else "systemGray3Color"));
    background: int = msg(cls("UIBackgroundConfiguration"), sel("clearConfiguration"));
    msg1(background, sel("setBackgroundColor:"), bgc);
    msg_set_f(background, sel("setCornerRadius:"), 5.0f64);
    msg1(config, sel("setBackground:"), background);
    msg1(config, sel("setBaseForegroundColor:"), msg(cls("UIColor"), sel("labelColor")));
    if (cp == 8) msg1(config, sel("setImage:"), symbol("delete.left", 18.0f64, 4,
        0)) else {
        keys[0] = k_font;
        values[0] = (if (letter) if (lk_hebrew) sans(23.0f64, 0.0f64) else new_york(24.0f64) else sans(16.0f64,
            0.0f64));
        t: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
            if (cp == 32) nsstring(kb_space_name) else if (cp == 10) nsstring(kb_return_name) else ustr(cp,
            0), nsdictionary(keys, values, 1));
        msg1(config, sel("setAttributedTitle:"), t);
        release(t)
    }
    msg_rect(config, sel("setContentInsets:"), 0.0f64, 0.0f64, 0.0f64, 0.0f64);
    b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(b, sel("setTag:"), cp);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("letterKey:"),
        64);
    msg1(b, sel("setAccessibilityLabel:"), nsstring(name));
    msg1(b, sel("setAccessibilityTraits:"), objc_const("UIAccessibilityTraitKeyboardKey"));
    // (The system's keys' shadow, under each.)
    l: int = msg(b, sel("layer"));
    msg1(l, sel("setShadowColor:"), msg(msg(cls("UIColor"), sel("blackColor")), sel("CGColor")));
    msg_set_f32(l, sel("setShadowOpacity:"), 0.3f64 as f32);
    msg_ff(l, sel("setShadowOffset:"), 0.0f64, 1.0f64);
    msg_set_f(l, sel("setShadowRadius:"), 0.0f64);
    b
}

// A key tapped: its click, and its letter (space, delete, Return) to the
// first responder.
letter_key(_self: int, _cmd: int, b: int): int {
    msg(msg(cls("UIDevice"), sel("currentDevice")), sel("playInputClick"));
    cp: int = msg(b, sel("tag"));
    if (cp == 8) {
        if (px_keys != 0) msg(px_keys, sel("deleteBackward"));
        return 0
    }
    if (px_keys != 0) msg1(px_keys, sel("insertText:"), ustr(cp, 0));
    0
}

// The keyboard plays clicks (UIInputViewAudioFeedback).
lk_clicks(_self: int, _cmd: int): int {
    1
}

// A code point of a string at i (UTF-8), its length in str_cp_n.
str_cp_n: int = 1;

str_cp(s: str, i: int): int {
    k: int = s[i] as int & 255;
    str_cp_n = 1;
    if (k < 128) return k;
    if (k < 224) {
        str_cp_n = 2;
        return (k & 31) * 64 + (s[i + 1] as int & 63)
    }
    str_cp_n = 3;
    (k & 15) * 4096 + (s[i + 1] as int & 63) * 64 + (s[i + 2] as int & 63)
}

len_cps(s: str): int {
    n: int = 0;
    i: int = 0;
    while (i < len(s)) {
        _c: int = str_cp(s, i);
        i = i + str_cp_n;
        n = n + 1
    }
    n
}

make_orig_classes() {
    lk_class = objc_allocateClassPair(cls("UIInputView"), "L8LetterKeyboard", 0);
    add_method0(lk_class, sel("enableInputClicksWhenVisible"), &lk_clicks, "B@:");
    add_protocol(lk_class, "UIInputViewAudioFeedback");
    objc_registerClassPair(lk_class)
}

// ---- the original's lists (tables.l8) ----
orig_part_gone() {
    wp_vc = held(wp_vc, 0);
    orig_sheets_gone()
}

orig_screens() {
    on_sheet_gone(&orig_part_gone)
}
