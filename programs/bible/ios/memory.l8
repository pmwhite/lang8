tag bible_ios;

use_tag std, ios, bible;

// Memory (DESIGN.md Â§13): what is kept (memory.tsv, the log, the ESV's
// pinned verses), the tray's seventh action (Memorize, or Memorizing),
// the Library's Memory segment (Today, New and Later, the toolbar's
// Practice and Add, the Daily Reminder's rows), Add Passage, a passage's
// details (Passage) and the versions' checklist. memory.l8 is its
// portable part; Practice is ios/practice.l8.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/memory.l8";

import "../core/esv_cache.l8";

// ---- kept ----
// Memory's reason for the daily reminder (Â§13.5).
mm_reminder: bool = false;

load_memory() {
    read_file("memory.tsv");
    parse_memory();
    mev_n = 0;
    mlog_n = 0;
    mm_reminder = def_bool("memoryReminder");
    mm_load_pins();
    note_num("bible: memory passages ", mq_n)
}

save_memory() {
    format_memory();
    write_file("memory.tsv");
    memory_flush()
}

// What memory.l8 says happened, into the log ("bible: memory added: JHN
// 3:16-17 bsb (id 4)"), and its log's lines onto memory-log.tsv.
memory_flush() {
    if (diag_on) {
        s: int = 0;
        for i in 0..mev_n {
            if (mev[i] as int == 10) {
                fbuf_n = 0;
                fput_str("bible: ");
                for k in s..i fput(mev[k] as int);
                note_ns(fstring());
                s = i + 1
            }
        }
    }
    mev_n = 0;
    if (mlog_n > 0) {
        fbuf_n = 0;
        for k in 0..mlog_n fput(mlog[k] as int);
        append_file("memory-log.tsv");
        mlog_n = 0
    }
}

// A passage added, deleted, begun again, graded: kept, logged, the
// reminders scheduled again.
memory_changed() {
    save_memory();
    daily_reschedule()
}

// ---- the ESV's pinned verses (Â§13.6): Library/Caches/SmoothBible/esv/memory.txt ----
// (The ESV passages' ids, whatever their size: review r9-1 Minor 10.)
mm_keep: []int = new int[256](0);

pins_path(): int {
    msg1(esv_dir(), sel("stringByAppendingPathComponent:"), nsstring("memory.txt"))
}

mm_load_pins() {
    fbuf_n = 0;
    data: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), pins_path());
    if (data != 0) {
        n: int = msg(data, sel("length"));
        if (n > len(fbuf)) n = len(fbuf);
        if (n > 0) memcpy_from(fbuf, msg(data, sel("bytes")), n);
        fbuf_n = n
    }
    kn: int = 0;
    for i in 0..mq_n {
        if (mq_ver[i] == TEXT_ESV && kn < len(mm_keep)) {
            mm_keep[kn] = mq_id[i];
            kn = kn + 1
        }
    }
    parse_pins(mm_keep, kn);
    // (An ESV passage without its pins, its file gone: pinned again, to be
    // fetched.)
    for i in 0..mq_n {
        if (mq_ver[i] == TEXT_ESV && !mm_pinned(mq_id[i])) _a: bool = esv_pin_add(mq_id[i],
            mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i])
    }
    note_num("bible: memory esv pins ", pn_n)
}

mm_pinned(id: int): bool {
    for k in 0..pn_n
        if (pn_id[k] == id) return true;
    false
}

save_pins() {
    format_pins();
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    msg2(data, sel("writeToFile:atomically:"), pins_path(), 1)
}

// Passage i's verses asked of the ESV (each chapter, unless here and
// fresh).
// A chapter the reader holds fresh fills the pins from what it holds; one
// it doesn't is asked for the pins alone (esv_pin_only: its records go to
// the pins, not into the reading cache, so they count once: review r9-1
// Minor 9). Pins fetched more than 30 days ago are fetched again (Â§13.6;
// Major 6); offline, the held text is kept.
mm_fetch(i: int) {
    if (mq_ver[i] != TEXT_ESV || !esv_listed()) return;
    now: int = time(0);
    for c in mq_c1[i]..mq_c2[i] + 1 {
        if (esv_pin_wants(c, now)) {
            stale: bool = esv_pin_stale(c, now);
            if (esv_pin_from_cache(c, now) > 0) {
                save_pins();
                note_num("bible: memory esv verses kept from the cache, chapter ",
                    c)
            } else {
                if (stale) note_num("bible: esv pin refetched, chapter ", c);
                held: bool = esv_find(c) >= 0;
                esv_want(c, 1);
                if (!held) esv_pin_only[c] = true
            }
        }
    }
}

// Every ESV passage's pins fetched if missing or stale (at launch, on
// return to the app, and when Practice opens).
memory_esv_refresh() {
    for i in 0..mq_n
        if (mq_ver[i] == TEXT_ESV) mm_fetch(i)
}

// An ESV chapter came (its records, n bytes of b): the pins of it filled,
// and kept; what shows them told.
memory_esv_came(c: int, b: []i8, n: int) {
    if (esv_pin_fill(c, b, n, time(0)) == 0) return;
    save_pins();
    note_num("bible: memory esv verses kept, chapter ", c);
    if (lib_table != 0 && sk_lib_seg == 3) lib_refresh(false);
    practice_esv_came()
}

// The message an ESV passage that would not fit is refused with (0: it
// fits).
mm_esv_refusal(
    c1: int,
    v1: int,
    c2: int,
    v2: int
): int {
    // (Core's words.)
    if (mm_esv_refusal_words(c1, v1, c2, v2) == 0) return 0;
    fstring()
}

// A passage made: its id (0, none). ESV: pinned and fetched, or refused
// with the toast.
mm_add(
    ver: int,
    c1: int,
    v1: int,
    c2: int,
    v2: int
): int {
    if (ver == TEXT_ESV) {
        why: int = mm_esv_refusal(c1, v1, c2, v2);
        if (why != 0) {
            toast_symbol(why, "brain", 1.6f64);
            note_ns(why);
            return 0
        }
    }
    id: int = memory_add(ver, c1, v1, c2, v2, time(0));
    if (id == 0) return 0;
    if (ver == TEXT_ESV) {
        _p: bool = esv_pin_add(id, c1, v1, c2, v2);
        save_pins();
        mm_fetch(mem_index(id))
    }
    memory_changed();
    id
}

mm_delete(i: int) {
    if (i < 0) return;
    id: int = mq_id[i];
    was_esv: bool = mq_ver[i] == TEXT_ESV;
    memory_delete(i, time(0));
    if (was_esv) {
        esv_pin_remove(id);
        save_pins()
    }
    memory_changed()
}

// ---- a passage's text ----
// Passage i laid out (memory.l8's mt, words, parts), from its own version
// (the ESV's from its pins): whether it has words.
// Whose words mt holds now (a passage's id; 0, none or another's).
mm_text_id: int = 0;

mm_text(i: int): bool {
    mm_text_id = 0;
    mt_n = 0;
    mw_n = 0;
    mv_n = 0;
    mpt_n = 0;
    if (i < 0 || i >= mq_n) return false;
    t: int = mq_ver[i];
    if (t == TEXT_ESV) {
        if (!esv_pin_ready(mq_id[i])) return false;
        esv_pin_build(mq_id[i]);
        t = TEXT_PIN
    } else ensure_text(t);
    if (!tx_ready[t]) return false;
    source: TextSource = text_source(t);
    memory_layout_from(source, mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i], mq_id[i]);
    mm_text_id = mq_id[i];
    mw_n > 0
}

// Its first words (about two lines' worth), into fbuf.
fput_first_words(most: int) {
    p: int = 0;
    start: int = fbuf_n;
    space: bool = false;
    while (p < mt_n && fbuf_n - start < most) {
        k: int = mt[p] as int & 255;
        if (mt_vn[p]) {
            if (fbuf_n > start) space = true
        } else if (k == 10 || k == 32) space = fbuf_n > start else {
            if (space) fput(32);
            space = false;
            fput(k)
        }
        p = p + 1
    }
    // (Not cut inside a character, and an ellipsis if cut.)
    if (p < mt_n) {
        while (fbuf_n > start && (fbuf[fbuf_n - 1] as int & 192) == 128) fbuf_n = fbuf_n - 1;
        if (fbuf_n > start && (fbuf[fbuf_n - 1] as int & 255) >= 192) fbuf_n = fbuf_n - 1;
        fput_str("\â\€\¦")
    }
}

// The verses passage i's learned parts cover (its text laid out).
mm_learned_verses(i: int): int {
    if (mq_state[i] != MS_LEARNING || !mm_text(i)) return 0;
    memory_verses_learned(mq_learned[i])
}

// Its state line, into fbuf (after what is there).
fput_mm_state(i: int) {
    if (mq_ver[i] == TEXT_ESV && !esv_pin_ready(mq_id[i])) {
        if (esv_listed()) fput_str("Waiting for the ESV\â\€\¦") else fput_str("The ESV isn\â\€\™t available. Change this passage\â\€\™s version in its details.");
        return
    }
    fput_memory_state(i, today(), mm_learned_verses(i), mem_verses(i))
}

// Memorize (the tray's, core's): a passage of verses first to last of
// chapter c, in the reader's version.
memorize_range(c: int, first: int, last: int) {
    id: int = mm_add(text_cur, c, first, c, last);
    if (id == 0) return;
    memorized()
}

// A passage added (core's, or the ESV's here): felt, and said.
memorized() {
    haptic_impact(0);
    // (Longer in the demo, as the ribbons' and plans' are: its shot waits for
    // the log's line, which can come late; review r11-1's 211 and 284.)
    toast_symbol(nsstring("Added to Memory"), "brain", if (demo_on) 6.0f64 else 1.6f64);
    note("bible: toast Added to Memory")
}

// ---- the Library's Memory segment (Â§13.4): core's (core/skin.l8's
// sk_build_lib_memory); its toolbar's Practice ----
memory_practice(_self: int, _cmd: int, _item: int): int {
    practice_open_today();
    0
}

// The authorization answered for Memory's switch.
mm_remind_answer(granted: bool) {
    if (granted) {
        was: bool = mm_reminder;
        mm_reminder = true;
        set_def_bool("memoryReminder", true);
        note("bible: memory reminder on");
        // (On, as the switch was turned; and so if it was not.)
        if (!was) uk_refresh()
    } else {
        mm_reminder = false;
        set_def_bool("memoryReminder", false);
        uk_refresh()
    }
    daily_reschedule()
}

// A range's words in version ver laid out (the ESV's only if its chapter
// is held now).
mm_range_text(
    ver: int,
    c1: int,
    v1: int,
    c2: int,
    v2: int
): bool {
    mw_n = 0;
    mt_n = 0;
    mm_text_id = 0;
    t: int = ver;
    ensure_text(t);
    if (!tx_ready[t]) return false;
    source: TextSource = text_source(t);
    memory_layout_from(source, c1, v1, c2, v2, 1);
    mt_n > 0
}

// The passage whose details are shown (its id).
mm_ps_id: int = 0;

mm_open_passage(i: int) {
    sheet_nav: int = presented();
    if (sheet_nav == 0 || i < 0) return;
    mm_ps_id = mq_id[i];
    note_num("bible: memory passage details ", mm_ps_id);
    uk_open(SCR_MM_PASSAGE, mq_id[i], true, sheet_nav)
}

// Its version changed: the state and schedule kept, learning's verses
// learned rounded down to a part's end; the ESV's pins made or let go.
mm_ps_set_version(ver: int) {
    i: int = mem_index(mm_ps_id);
    if (i < 0 || ver == mq_ver[i]) return;
    if (ver == TEXT_ESV) {
        why: int = mm_esv_refusal(mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i]);
        if (why != 0) {
            toast_symbol(why, "brain", 1.6f64);
            return
        }
    }
    learned_v: int = mm_learned_verses(i);
    old: int = mq_ver[i];
    mq_ver[i] = ver;
    k: int = 0;
    if (mq_state[i] == MS_LEARNING && ver != TEXT_ESV && mm_text(i)) k = memory_parts_for_verses(learned_v);
    mq_ver[i] = old;
    memory_set_version(i, ver, k);
    if (old == TEXT_ESV) esv_pin_remove(mq_id[i]);
    if (ver == TEXT_ESV) {
        _p: bool = esv_pin_add(mq_id[i], mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i]);
        mm_fetch(i)
    }
    if (old == TEXT_ESV || ver == TEXT_ESV) save_pins();
    memory_changed()
}

// The sheets gone: what they held let go.
memory_sheet_gone() { }

make_memory_classes() { }

add_memory_methods(app: int) {
    add_method1(app, sel("memoryPractice:"), &memory_practice, "v@:@");
    add_method1(app, sel("memoryOpenLibrary:"), &memory_open_library, "v@:@")
}

// ---- Memory's lists (tables.l8) ----
memory_screens() {
    on_sheet_gone(&memory_sheet_gone)
}
