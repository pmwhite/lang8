tag bible_ios;

use_tag std, ios, bible;

// The study screens (DESIGN.md §7): a verse's interlinear (a sheet from
// the verse tray's Study), a word's study pushed from it, the word's
// definition and its concordance, and the acknowledgements pushed from
// the reading settings. What they show comes from lang.l8; the data
// (data/lang/, in the app's bundle) is read at the first study, mapped by
// NSData, not at launch.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/lang.l8";

// ---- the data, at first use ----
// Each file mapped (mmap) at the first study, never at launch: nothing is
// read or allocated for a reader who never studies. A mapping is an L8
// array: its length in the (anonymous, writable) page before the file's
// pages, the file itself mapped read-only after them.
extern mmap(
    addr: int,
    n: int,
    prot: int,
    flags: int,
    fd: int,
    offset: int
): int;

extern open_c(path: int, flags: int, mode: int): int = open;

extern lseek(fd: int, offset: int, whence: int): int;

extern bytes_at(p: int): []i8 = l8_as_int;

extern ints_bytes(a: []int): []i8 = l8_as_int;

extern CFAbsoluteTimeGetCurrent(): f64;

extern dlopen(path: str, mode: int): int;

lang_page: int = 16384;

lang_none: []i8 = new i8[1](0i8);

// The size of the file last mapped (0 if it is missing).
lang_mapped: int = 0;

lang_map(name: str, ext: str): []i8 {
    lang_mapped = 0;
    bundle: int = msg(cls("NSBundle"), sel("mainBundle"));
    path: int = msg2(bundle, sel("pathForResource:ofType:"), nsstring(name), nsstring(ext));
    if (path == 0) return lang_none;
    fd: int = open_c(msg(path, sel("fileSystemRepresentation")), 0, 0);
    if (fd < 0) return lang_none;
    // (Its size by seeking to its end: no file attributes read, so none of
    // its times, which the privacy manifest would have to give a reason for.)
    n: int = lseek(fd, 0, 2);
    if (n <= 0) {
        close(fd);
        return lang_none
    }
    // (PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON; then PROT_READ,
    // MAP_PRIVATE|MAP_FIXED over all but its first page.)
    base: int = mmap(0, n + lang_page, 3, 4098, -1, 0);
    if (base == -1 || base == 0) {
        close(fd);
        return lang_none
    }
    at: int = mmap(base + lang_page, n, 1, 18, fd, 0);
    close(fd);
    if (at != base + lang_page) return lang_none;
    one[0] = n;
    memcpy_to(base + lang_page - 8, ints_bytes(one), 8);
    lang_mapped = n;
    bytes_at(base + lang_page)
}

lang_load() {
    if (lang_ready) return;
    t0: f64 = CFAbsoluteTimeGetCurrent();
    lw = lang_map("words", "bin");
    if (lang_mapped == 0) {
        note("bible: no language data");
        return
    }
    lw_n = lang_mapped / 12;
    lv = lang_map("verses", "bin");
    lv_n = lang_mapped / 8 - 1;
    lsup = lang_map("supplied", "bin");
    lsup_n = lang_mapped / 8;
    lforms = lang_map("forms", "txt");
    lforms_len = lang_mapped;
    lmorph = lang_map("morph", "txt");
    lmorph_len = lang_mapped;
    lconc = lang_map("conc", "bin");
    lconc_len = lang_mapped;
    llex = lang_map("lexicon", "txt");
    llex_len = lang_mapped;
    lgram = lang_map("grammar", "txt");
    lgram_len = lang_mapped;
    // (Senses and related words: DESIGN.md §10.3, §10.4.)
    lsen = lang_map("senses", "bin");
    lsen_n = lang_mapped;
    lrel = lang_map("related", "bin");
    lrel_n = lang_mapped;
    // (Cross references and the commentary: DESIGN.md §9.6, §9.7.)
    lxi = lang_map("xref_index", "bin");
    lxi_n = lang_mapped / 4;
    lxr = lang_map("xrefs", "bin");
    lxr_n = lang_mapped;
    lmh = lang_map("mhcc", "txt");
    lmh_n = lang_mapped;
    // (Meanings in context, UBS's: DESIGN.md §14.10b.3.)
    lmean = lang_map("meanings", "bin");
    lmean_n = lang_mapped;
    lmeant = lang_map("meanings", "txt");
    lmeant_n = lang_mapped;
    mean_index();
    lang_index();
    note_num("bible: language data mapped, ms ", ((CFAbsoluteTimeGetCurrent() - t0) * 1000.0f64) as int)
}

// Whether verse v of chapter c can be studied (the data read, if not yet).
can_study(c: int, v: int): bool {
    lang_load();
    vi: int = lang_verse(c, v);
    vi >= 0 && v_aligned(vi) && v_end(vi) > v_first(vi)
}

// Whether verse v of chapter c may be studied, as far as is known without
// reading the data (so the tray does not read it).
study_maybe(c: int, v: int): bool {
    if (!lang_ready) return true;
    vi: int = lang_verse(c, v);
    vi >= 0 && v_aligned(vi) && v_end(vi) > v_first(vi)
}

// ---- fonts and text ----
// Greek in New York, Hebrew in the system's font (its Hebrew), at a size
// (scaled with the phone's text size).
scaled(size: f64): f64 {
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    msg_f_f(metrics, sel("scaledValueForValue:"), size)
}

serif(size: f64): int {
    d: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
        objc_const("UIFontTextStyleBody"));
    s: int = msg1(d, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), if (s != 0) s else d, size)
}

original_font(greek: bool, greek_size: f64, hebrew_size: f64): int {
    if (greek) serif(scaled(greek_size)) else sans(scaled(hebrew_size), 0.0f64)
}

italic_sans(size: f64): int {
    f: int = sans(size, 0.0f64);
    d: int = msg1(msg(f, sel("fontDescriptor")), sel("fontDescriptorWithSymbolicTraits:"),
        1);
    if (d == 0) return f;
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

mono(size: f64): int {
    msg_ff(cls("UIFont"), sel("monospacedDigitSystemFontOfSize:weight:"), size, 0.0f64)
}

// Bytes a to b of buffer x as an NSString.
ns_of(x: []i8, a: int, b: int): int {
    if (b <= a) return nsstring("");
    nsstring_at(bytes_address(x) + a, b - a)
}

attributed(text: int, font: int, color: int): int {
    keys[0] = k_font;
    values[0] = font;
    keys[1] = k_color;
    values[1] = color;
    msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, nsdictionary(keys, values, 2)), sel("autorelease"))
}

append(
    s: int,
    text: int,
    font: int,
    color: int
) {
    msg1(s, sel("appendAttributedString:"), attributed(text, font, color))
}

label_of(a: int): int {
    l: int = msg(make("UILabel"), sel("autorelease"));
    msg1(l, sel("setAttributedText:"), a);
    msg1(l, sel("setTextAlignment:"), 1);
    l
}

// A label's size: hfa[0], hfa[1].
label_size(l: int, most: f64) {
    msg_set_f(l, sel("setPreferredMaxLayoutWidth:"), most);
    l8_msg_hfa(hfa, l, sel("intrinsicContentSize"), 0, 0, 0)
}

// The view controller on top of the sheets.
top_presented(): int {
    top: int = presented();
    if (top == 0) return 0;
    while (msg(top, sel("presentedViewController")) != 0) top = msg(top, sel("presentedViewController"));
    top
}

// A page in Safari's own view, over everything.
open_web(url: str) {
    u: int = msg1(cls("NSURL"), sel("URLWithString:"), nsstring(url));
    // (SafariServices loaded at its first use, not linked: nothing more for
    // the launch to load.)
    if (cls("SFSafariViewController") == 0) _h: int = dlopen("/System/Library/Frameworks/SafariServices.framework/SafariServices",
        1);
    sf: int = cls("SFSafariViewController");
    if (sf == 0 || u == 0) return;
    vc: int = msg1(msg(sf, sel("alloc")), sel("initWithURL:"), u);
    top: int = top_presented();
    msg3(if (top != 0) top else nav, sel("presentViewController:animated:completion:"),
        vc, 1, 0);
    release(vc)
}

// ---- the interlinear ----
il_class: int = 0;

il_vc: int = 0;

il_scroll: int = 0;

il_seg: int = 0;

// (The tiles' view, in the scroll view.)
il_content: int = 0;

// The verse shown, and whether in the original order.
il_vi: int = -1;

il_original: bool = false;

il_width: f64 = 0.0f64;

tile_ws: []f64 = new f64[300](0.0f64);

tile_hs: []f64 = new f64[300](0.0f64);

tile_views: []int = new int[300](0);

// Each tile's English and transliteration labels (for hiding, §14.5.1).
tile_eng: []int = new int[300](0);

tile_tr: []int = new int[300](0);

// Hiding what you know (§14.5.1): whether it applies to the verse shown
// (Hide What I Know on, the original order), what each tile hides now,
// and which of the verse's words (by place) a tap has shown.
il_hide: bool = false;

tile_hid_eng: []bool = new bool[300](false);

tile_hid_tr: []bool = new bool[300](false);

il_shown: []bool = new bool[300](false);

// (A verse pushed from Verses You Can Read: the original order, whatever
// the setting.)
il_force_original: bool = false;

// An interlinear pushed over another (Verses You Can Read's, over the Study
// sheet's): the one under it kept, and given back (its tiles made again)
// when the pushed one is popped.
il_pushed_vc: int = 0;

il_s_vc: int = 0;

il_s_scroll: int = 0;

il_s_content: int = 0;

il_s_seg: int = 0;

il_s_vi: int = -1;

il_s_original: bool = false;

il_s_width: f64 = 0.0f64;

push_interlinear_over(vi: int) {
    il_s_vc = il_vc;
    il_s_scroll = il_scroll;
    il_s_content = il_content;
    il_s_seg = il_seg;
    il_s_vi = il_vi;
    il_s_original = il_original;
    il_s_width = il_width;
    push_interlinear(vi);
    il_pushed_vc = il_vc
}

il_disappearing(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, il_class, cmd, animated);
    if (self != il_pushed_vc || (msg(self, sel("isMovingFromParentViewController")) & 255) == 0) return 0;
    il_pushed_vc = 0;
    il_vc = il_s_vc;
    il_scroll = il_s_scroll;
    il_content = il_s_content;
    il_seg = il_s_seg;
    il_vi = il_s_vi;
    il_original = il_s_original;
    il_width = il_s_width;
    for x in 0..len(il_shown) il_shown[x] = false;
    if (il_scroll != 0 && il_vi >= 0) il_build();
    0
}

// The interlinear of verse vi pushed in the sheet (from a word study's
// toolbar).
push_interlinear(vi: int) {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    vc: int = make_interlinear(vi);
    msg2(sheet_nav, sel("setToolbarHidden:animated:"), 0, 1);
    msg2(sheet_nav, sel("pushViewController:animated:"), vc, 1)
}

make_interlinear(vi: int): int {
    vc: int = msg(msg(msg(il_class, sel("alloc")), sel("init")), sel("autorelease"));
    il_vc = vc;
    view: int = msg(vc, sel("view"));
    msg1(view, sel("setBackgroundColor:"), c_bg);
    il_setup(view, vi);
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    il_set_title();
    il_toolbar(vc, false);
    vc
}

// The interlinear's scroll view and the tiles' view, in view, for verse vi.
il_setup(view: int, vi: int) {
    il_vi = vi;
    il_original = def_int("interlinearOrder") == 1 || il_force_original;
    for x in 0..len(il_shown) il_shown[x] = false;
    il_scroll = make("UIScrollView");
    msg1(il_scroll, sel("setAutoresizingMask:"), 18);
    msg1(il_scroll, sel("setBackgroundColor:"), c_bg);
    msg1(il_scroll, sel("setAlwaysBounceVertical:"), 1);
    l8_msg_hfa(hfa, view, sel("bounds"), 0, 0, 0);
    msg_rect(il_scroll, sel("setFrame:"), 0.0f64, 0.0f64, hfa[2], hfa[3]);
    msg1(view, sel("addSubview:"), il_scroll);
    release(il_scroll);
    il_content = make("UIView");
    msg1(il_scroll, sel("addSubview:"), il_content);
    release(il_content);
    il_width = 0.0f64
}

// The interlinear's toolbar on vc: the verse before, the order, the verse
// after (animated, as the Study sheet's segments change).
il_toolbar(vc: int, animated: bool) {
    prev: int = msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol("chevron.up", 17.0f64, 4, 0), 0, app_obj, sel("ilPrevious:"));
    msg1(prev, sel("setAccessibilityLabel:"), nsstring("Previous Verse"));
    next: int = msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol("chevron.down", 17.0f64, 4, 0), 0, app_obj, sel("ilNext:"));
    msg1(next, sel("setAccessibilityLabel:"), nsstring("Next Verse"));
    one[0] = nsstring("English Order");
    one[1] = nsstring(if (w_greek(v_first(il_vi))) "Greek Order" else "Hebrew Order");
    il_seg = msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
        nsarray(one, 2));
    msg1(il_seg, sel("setSelectedSegmentIndex:"), if (def_int("interlinearOrder") == 1) 1 else 0);
    msg3(il_seg, sel("addTarget:action:forControlEvents:"), app_obj, sel("ilOrder:"),
        4096);
    msg_rect(il_seg, sel("setFrame:"), 0.0f64, 0.0f64, 240.0f64, 32.0f64);
    seg_item: int = msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
        il_seg);
    release(il_seg);
    flex: int = msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        5, 0, 0);
    flex2: int = msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        5, 0, 0);
    bar_items[0] = prev;
    bar_items[1] = flex;
    bar_items[2] = seg_item;
    bar_items[3] = flex2;
    bar_items[4] = next;
    msg2(vc, sel("setToolbarItems:animated:"), nsarray(bar_items, 5), if (animated) 1 else 0);
    for i in 0..5 release(bar_items[i])
}

bar_items: []int = new int[6](0);

il_set_title() {
    if (il_vc == 0) return;
    fbuf_n = 0;
    one_verse[0] = v_num(il_vi);
    put_ref(v_chapter(il_vi), one_verse, 1);
    msg1(il_vc, sel("setTitle:"), fstring())
}

// Laid out again when its width is known or changes.
il_layout(self: int, cmd: int): int {
    super0(self, il_class, cmd);
    w: f64 = view_width(msg(self, sel("view")));
    if (w != il_width && w > 0.0f64) {
        il_width = w;
        il_build()
    }
    0
}

// A tile: its labels, one under another, centered.
tile_lines: []int = new int[4](0);

make_tile(i: int): int {
    w: int = tile_word[i];
    n: int = 0;
    soft: int = c_faint;
    tile_eng[i] = 0;
    tile_tr[i] = 0;
    tile_hid_eng[i] = false;
    tile_hid_tr[i] = false;
    if (w < 0) {
        tile_lines[0] = label_of(attributed(ns_of(st, tok_b[tile_t0[i]], tok_e[tile_t0[i] + tile_tn[i] - 1]),
            italic_sans(15.0f64), soft));
        n = 1
    } else {
        fl: int = w_flags(w);
        eng: int = 0;
        if (tile_tn[i] > 0) eng = attributed(ns_of(st, tok_b[tile_t0[i]], tok_e[tile_t0[i] + tile_tn[i] - 1]),
            sans(15.0f64, 0.0f64), c_ink) else if ((fl & 2) != 0) eng = attributed(nsstring(if ((fl & 8) != 0) "(with previous)" else "(with next)"),
            italic_sans(12.0f64), soft) else eng = attributed(nsstring("\�\�\�"),
            sans(15.0f64, 0.0f64), soft);
        tile_lines[0] = label_of(eng);
        tile_eng[i] = tile_lines[0];
        form_of(w);
        tile_lines[1] = label_of(attributed(ns_of(lforms, wf_b, wf_e), original_font(w_greek(w),
            21.0f64, 25.0f64), c_ink));
        tile_lines[2] = label_of(attributed(ns_of(lforms, wt_b, wt_e), italic_sans(12.0f64),
            soft));
        tile_tr[i] = tile_lines[2];
        // What it hides (§14.5.1): the English of a word known, the
        // transliteration once the alphabet is; drawn clear, its space
        // kept.
        shown: bool = il_shown[w - v_first(il_vi)];
        tile_hid_eng[i] = il_hide && !shown && word_known(w);
        tile_hid_tr[i] = il_hide && !shown && kn_alpha[word_lang(w)];
        if (tile_hid_eng[i]) msg_set_f(tile_lines[0], sel("setAlpha:"), 0.0f64);
        if (tile_hid_tr[i]) msg_set_f(tile_lines[2], sel("setAlpha:"), 0.0f64);
        fbuf_n = 0;
        if (w_strongs(w) > 0) {
            fput_key(w_greek(w), w_strongs(w));
            fput_str(" \�\� ")
        }
        morph_of(w_morph(w));
        for x in mc_b..mc_e fput(lmorph[x] as int);
        tile_lines[3] = label_of(attributed(fstring(), mono(11.0f64), soft));
        n = 4
    }
    // Its width: the widest line's, and 16; never wider than a row, its
    // lines wrapping within that rather than cut short.
    wide: f64 = 0.0f64;
    for k in 0..n {
        label_size(tile_lines[k], 2000.0f64);
        if (hfa[0] > wide) wide = hfa[0]
    }
    most: f64 = il_width - 28.0f64 - 16.0f64;
    if (most > 40.0f64 && wide > most) wide = most;
    wide = (wide + 0.99f64) as int as f64;
    h: f64 = 12.0f64;
    for k in 0..n {
        msg1(tile_lines[k], sel("setNumberOfLines:"), 0);
        label_size(tile_lines[k], wide);
        h = h + hfa[1] + (if (k > 0) 2.0f64 else 0.0f64)
    }
    tw: f64 = wide + 16.0f64;
    t: int = msg(make(if (w >= 0) "UIControl" else "UIView"), sel("autorelease"));
    y: f64 = 6.0f64;
    for k in 0..n {
        label_size(tile_lines[k], wide);
        lh: f64 = hfa[1];
        msg_rect(tile_lines[k], sel("setFrame:"), 8.0f64, y, wide, lh);
        msg1(t, sel("addSubview:"), tile_lines[k]);
        y = y + lh + 2.0f64
    }
    msg_set_f(msg(t, sel("layer")), sel("setCornerRadius:"), 10.0f64);
    // (Shown by a tap: the helped mark under its English.)
    if (w >= 0 && il_hide && il_shown[w - v_first(il_vi)] && word_known(w)) tile_underline(t,
        tile_lines[0]);
    if (w >= 0) {
        msg1(t, sel("setTag:"), w + 1);
        msg3(t, sel("addTarget:action:forControlEvents:"), app_obj, sel("tileTapped:"),
            64);
        hover(t);
        msg1(t, sel("setIsAccessibilityElement:"), 1);
        tile_label(t, i);
        msg1(t, sel("setAccessibilityTraits:"), objc_const("UIAccessibilityTraitButton"))
    }
    tile_ws[i] = tw;
    tile_hs[i] = h;
    t
}

// A tile's VoiceOver label: "loved, Greek ēgapēsen, verb, aorist …"; with
// its meaning hidden, "Greek ēgapēsen, verb, aorist …, meaning hidden",
// and the actions Show Meaning and Word Study.
tile_label(t: int, i: int) {
    w: int = tile_word[i];
    form_of(w);
    fbuf_n = 0;
    if (!tile_hid_eng[i]) {
        if (tile_tn[i] > 0) {
            for x in tok_b[tile_t0[i]]..tok_e[tile_t0[i] + tile_tn[i] - 1] fput(st[x] as int)
        } else fput_str("not translated");
        fput_str(", ")
    }
    fput_str(if (w_greek(w)) "Greek " else "Hebrew ");
    for x in wt_b..wt_e fput(lforms[x] as int);
    fput_str(", ");
    plain_parsing(w_morph(w));
    for x in 0..pl_n fput(pl[x] as int);
    if (tile_hid_eng[i]) fput_str(", meaning hidden");
    msg1(t, sel("setAccessibilityLabel:"), fstring());
    if (tile_hid_eng[i] || tile_hid_tr[i]) {
        msg1(t, sel("setAccessibilityHint:"), nsstring("Shows its meaning"));
        a: int = custom_action("Show Meaning", "learnTileShow:");
        objc_setAssociatedObject(a, ints_address(ln_action_key), nsnumber_int(w),
            1);
        b: int = custom_action("Word Study", "learnTileStudy:");
        objc_setAssociatedObject(b, ints_address(ln_action_key), nsnumber_int(w),
            1);
        one[0] = a;
        one[1] = b;
        msg1(t, sel("setAccessibilityCustomActions:"), nsarray(one, 2))
    } else {
        msg1(t, sel("setAccessibilityHint:"), nsstring("Shows word study"));
        msg1(t, sel("setAccessibilityCustomActions:"), 0)
    }
}

// The helped mark: 1.5 points of accent at 50% under a tile's English.
tile_underline(t: int, eng: int) {
    // (Under its words only: the text's width, centred in the line.)
    l8_msg_hfa(hfa, eng, sel("frame"), 0, 0, 0);
    fx: f64 = hfa[0];
    fy: f64 = hfa[1];
    fw: f64 = hfa[2];
    fh: f64 = hfa[3];
    label_size(eng, fw);
    tw: f64 = if (hfa[0] > 0.0f64 && hfa[0] < fw) hfa[0] else fw;
    hfa[0] = fx + (fw - tw) / 2.0f64;
    hfa[1] = fy;
    hfa[2] = tw;
    hfa[3] = fh;
    u: int = msg(make("UIView"), sel("autorelease"));
    msg1(u, sel("setBackgroundColor:"), msg_set_f(c_accent, sel("colorWithAlphaComponent:"),
        0.5f64));
    msg1(u, sel("setUserInteractionEnabled:"), 0);
    msg_rect(u, sel("setFrame:"), hfa[0], hfa[1] + hfa[3] - 0.5f64, hfa[2], 1.5f64);
    msg1(t, sel("addSubview:"), u)
}

// A tile tapped with something hidden: shown (the English and
// transliteration fading in at ink, the helped mark under it). True if it
// had anything hidden.
tile_show(w: int): bool {
    // (No interlinear on the screen: nothing to show.)
    if (il_scroll == 0 || il_vi < 0) return false;
    i: int = -1;
    for x in 0..tile_n
        if (tile_word[x] == w) i = x;
    if (i < 0 || !(tile_hid_eng[i] || tile_hid_tr[i])) return false;
    il_shown[w - v_first(il_vi)] = true;
    t: int = tile_views[i];
    if (!reduce_motion()) fade_layer(msg(t, sel("layer")), 0.2f64);
    msg_set_f(tile_eng[i], sel("setAlpha:"), 1.0f64);
    msg_set_f(tile_tr[i], sel("setAlpha:"), 1.0f64);
    if (tile_hid_eng[i]) tile_underline(t, tile_eng[i]);
    tile_hid_eng[i] = false;
    tile_hid_tr[i] = false;
    tile_label(t, i);
    fbuf_n = 0;
    fput_str("bible: learn shown in the interlinear ");
    form_of(w);
    for x in wt_b..wt_e fput(lforms[x] as int);
    note_ns(fstring());
    if ((UIAccessibilityIsVoiceOverRunning() & 255) != 0) UIAccessibilityPostNotification(objc_const("UIAccessibilityLayoutChangedNotification"),
        t);
    true
}

learn_tile_show(_self: int, _cmd: int, a: int): int {
    n: int = objc_getAssociatedObject(a, ints_address(ln_action_key));
    if (n != 0 && tile_show(msg(n, sel("longValue")))) 1 else 0
}

learn_tile_study(_self: int, _cmd: int, a: int): int {
    n: int = objc_getAssociatedObject(a, ints_address(ln_action_key));
    if (n == 0) return 0;
    open_study(il_vi, msg(n, sel("longValue")));
    1
}

// Whether a verse has Aramaic (no link to a language page there).
verse_aramaic(vi: int): bool {
    for w in v_first(vi)..v_end(vi)
        if (word_aramaic(w)) return true;
    false
}

// "bible: learn hide JHN 3:16 known 11 of 14 translit hidden".
il_hide_log() {
    if (!diag_on || !il_hide) return;
    known: int = 0;
    words: int = 0;
    tr: bool = false;
    for i in 0..tile_n {
        if (tile_word[i] >= 0) {
            words = words + 1;
            if (word_known(tile_word[i])) known = known + 1;
            if (tile_hid_tr[i]) tr = true
        }
    }
    fbuf_n = 0;
    fput_str("bible: learn hide ");
    c: int = v_chapter(il_vi);
    b: int = ch_book[c];
    for x in 0..3 fput(bsb_code_at(b, x));
    fput(32);
    fput_int(ch_num[c]);
    fput(58);
    fput_int(v_num(il_vi));
    fput_str(" known ");
    fput_int(known);
    fput_str(" of ");
    fput_int(words);
    if (tr) fput_str(" translit hidden");
    note_ns(fstring())
}

il_build() {
    if (il_scroll == 0 || il_vi < 0) return;
    subs: int = msg(msg(il_content, sel("subviews")), sel("copy"));
    for i in 0..msg(subs, sel("count")) msg(msg1(subs, sel("objectAtIndex:"), i),
        sel("removeFromSuperview"));
    release(subs);
    // (At most 680 wide, centred: a wide window's form sheet, §17.3.4.)
    W: f64 = if (il_width > 680.0f64) 680.0f64 else il_width;
    // The verse's reference, small, over it (DESIGN.md §9.6.2).
    fbuf_n = 0;
    one_verse[0] = v_num(il_vi);
    put_ref(v_chapter(il_vi), one_verse, 1);
    where: int = label_of(attributed(fstring(), sans(13.0f64, 0.3f64), c_faint));
    msg1(where, sel("setTextAlignment:"), 0);
    label_size(where, W - 40.0f64);
    msg_rect(where, sel("setFrame:"), 20.0f64, 16.0f64, W - 40.0f64, hfa[1]);
    msg1(il_content, sel("addSubview:"), where);
    top: f64 = 16.0f64 + hfa[1] + 16.0f64;
    // The verse, as the reader sets it.
    study_load(il_vi);
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    size: f64 = em * 0.9f64;
    fbuf_n = 0;
    fput_int(v_num(il_vi));
    fput_str("\�\�\�");
    // (Its number exactly as the reader sets one: 0.58 em semibold, faint,
    // raised 0.36 em, then a narrow no-break space.)
    append(s, fstring(), msg_ff(cls("UIFont"), sel("monospacedDigitSystemFontOfSize:weight:"),
        size * 0.58f64, 0.3f64), c_faint);
    msg4(s, sel("addAttribute:value:range:"), k_baseline, nsnumber_f(size * 0.36f64),
        0, msg(s, sel("length")));
    if (st_title > 0) {
        append(s, ns_of(st, 0, st_title + 1), italic(size), c_faint);
        append(s, ns_of(st, st_title + 1, st_n), body(size), c_ink)
    } else append(s, ns_of(st, 0, st_n), body(size), c_ink);
    caps_into(s, msg(s, sel("length")) - msg(ns_of(st, if (st_title > 0) st_title + 1 else 0,
        st_n), sel("length")), ns_of(st, if (st_title > 0) st_title + 1 else 0, st_n),
        true, size);
    // (In another version, the verse is the BSB's, and says so.)
    if (text_cur != TEXT_BSB) append(s, nsstring(" BSB"), sans(size * 0.62f64, 0.3f64),
        c_faint);
    p: int = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.3f64), sel("autorelease"));
    msg4(s, sel("addAttribute:value:range:"), k_para, p, 0, msg(s, sel("length")));
    verse: int = msg(make("UILabel"), sel("autorelease"));
    msg1(verse, sel("setNumberOfLines:"), 0);
    msg1(verse, sel("setAttributedText:"), s);
    label_size(verse, W - 40.0f64);
    msg_rect(verse, sel("setFrame:"), 20.0f64, top, W - 40.0f64, hfa[1]);
    msg1(il_content, sel("addSubview:"), verse);
    y: f64 = top + hfa[1] + 14.0f64;
    rule: int = msg(make("UIView"), sel("autorelease"));
    msg1(rule, sel("setBackgroundColor:"), c_rule);
    msg_rect(rule, sel("setFrame:"), 20.0f64, y, W - 40.0f64, 1.0f64);
    msg1(il_content, sel("addSubview:"), rule);
    y = y + 15.0f64;
    // The tiles, in lines (hiding what is known in the original order:
    // §14.5.1).
    il_hide = false;
    if (il_original && ln_hide()) {
        ensure_learn_lang();
        il_hide = learn_ready
    }
    interlinear_tiles(il_vi, il_original);
    for i in 0..tile_n tile_views[i] = make_tile(i);
    wrap_tiles(tile_ws, tile_n, W - 28.0f64, 6.0f64);
    rtl: bool = il_original && !w_greek(v_first(il_vi));
    for l in 0..line_count {
        a: int = line_first[l];
        b: int = if (l + 1 < line_count) line_first[l + 1] else tile_n;
        lh: f64 = 0.0f64;
        for i in a..b
            if (tile_hs[i] > lh) lh = tile_hs[i];
        x: f64 = if (rtl) W - 14.0f64 else 14.0f64;
        for i in a..b {
            if (rtl) x = x - tile_ws[i];
            msg_rect(tile_views[i], sel("setFrame:"), x, y, tile_ws[i], tile_hs[i]);
            msg1(il_content, sel("addSubview:"), tile_views[i]);
            if (rtl) x = x - 6.0f64 else x = x + tile_ws[i] + 6.0f64
        }
        y = y + lh + 14.0f64
    }
    il_hide_log();
    // The link to the language's page: Learn Greek (or, once started,
    // Greek); none in an Aramaic verse.
    il_link = 0;
    if (!verse_aramaic(il_vi)) {
        ensure_learn();
        lang: int = if (w_greek(v_first(il_vi))) 0 else 1;
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
        msg2(b, sel("setTitle:forState:"), nsstring(if (learn_started(lang)) language_names[lang] else if (lang == 0) "Learn Greek" else "Learn Hebrew"),
            0);
        msg1(msg(b, sel("titleLabel")), sel("setFont:"), sans(scaled(15.0f64), 0.0f64));
        msg2(b, sel("setTitleColor:forState:"), c_accent, 0);
        msg1(b, sel("setTag:"), lang);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("learnLink:"),
            64);
        msg(b, sel("sizeToFit"));
        bw: f64 = view_width(b);
        bh: f64 = view_height(b);
        y = y + 10.0f64;
        msg_rect(b, sel("setFrame:"), (W - bw) / 2.0f64, y, bw, bh);
        msg1(il_content, sel("addSubview:"), b);
        il_link = b;
        y = y + bh + 14.0f64
    }
    // (Its words are the BSB's, whatever version is read.)
    if (text_cur != TEXT_BSB) {
        foot: int = label_of(attributed(nsstring("The interlinear follows the Berean Standard Bible."),
            sans(13.0f64, 0.0f64), c_faint));
        msg1(foot, sel("setNumberOfLines:"), 0);
        label_size(foot, W - 40.0f64);
        msg_rect(foot, sel("setFrame:"), 20.0f64, y + 6.0f64, W - 40.0f64, hfa[1]);
        msg1(il_content, sel("addSubview:"), foot);
        y = y + 6.0f64 + hfa[1] + 10.0f64
    }
    msg_rect(il_content, sel("setFrame:"), (il_width - W) / 2.0f64, 0.0f64, W, y + 20.0f64);
    msg_ff(il_scroll, sel("setContentSize:"), il_width, y + 20.0f64)
}

// The interlinear's link (the demo's tap).
il_link: int = 0;

learn_link(_self: int, _cmd: int, b: int): int {
    open_language(msg(b, sel("tag")));
    0
}

il_order(_self: int, _cmd: int, seg: int): int {
    il_original = msg(seg, sel("selectedSegmentIndex")) == 1;
    set_def_int("interlinearOrder", if (il_original) 1 else 0);
    // (The tiles cross-fade into their new order.)
    fade_layer(msg(il_scroll, sel("layer")), 0.2f64);
    il_build();
    0
}

// A cross-fade of whatever changes in a layer next, over t seconds.
fade_layer(layer: int, t: f64) {
    if (layer == 0) return;
    tr: int = make("CATransition");
    msg1(tr, sel("setType:"), objc_const("kCATransitionFade"));
    msg_set_f(tr, sel("setDuration:"), t);
    msg2(layer, sel("addAnimation:forKey:"), tr, 0);
    release(tr)
}

// The verse before or after (across chapters; not one that cannot be
// studied).
il_step(d: int) {
    vi: int = il_vi + d;
    while (vi >= 0 && vi < lv_n && !(v_aligned(vi) && v_end(vi) > v_first(vi))) vi = vi + d;
    if (vi < 0 || vi >= lv_n) return;
    il_vi = vi;
    for x in 0..len(il_shown) il_shown[x] = false;
    il_set_title();
    study_verse_moved(v_chapter(vi), v_num(vi));
    fade_layer(msg(il_scroll, sel("layer")), 0.2f64);
    il_build();
    msg_ff1(il_scroll, sel("setContentOffset:animated:"), 0.0f64, -top_inset(il_scroll),
        0)
}

il_previous(_self: int, _cmd: int, _b: int): int {
    il_step(-1);
    0
}

il_next(_self: int, _cmd: int, _b: int): int {
    il_step(1);
    0
}

// One tap shows what is hidden; the next (nothing hidden) studies.
tile_tapped(_self: int, _cmd: int, t: int): int {
    w: int = msg(t, sel("tag")) - 1;
    if (w >= 0 && !tile_show(w)) open_study(il_vi, w);
    0
}

// ---- word study: core's (core/skin.l8's SCR_STUDY, with SCR_GRAMMAR
// and SCR_CONCORDANCE); its numbers (ws_*) core's, which the
// interlinear, the definition and Add to Note read ----
study_table: int = 0;

// A word's study pushed in the sheet (from the interlinear), large.
open_study(vi: int, w: int) {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    lang_load();
    uk_sync();
    uk_nav = sheet_nav;
    sk_study_open(vi, w, w_greek(w), w_strongs(w), true, true);
    uk_effects();
    study_table = uk_table_of(SCR_STUDY);
    sheet: int = msg(sheet_nav, sel("sheetPresentationController"));
    if (sheet != 0) msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierLarge"))
}

// A related word's lemma study pushed (no verse: no grammar, nor Add to
// Note).
open_lemma(greek: bool, num: int) {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    lang_load();
    uk_sync();
    uk_nav = sheet_nav;
    sk_study_open(-1, -1, greek, num, false, true);
    uk_effects()
}

// A word's study as a sheet of its own, large (from the edit menu's Study);
// beside the text, where it fits, pushed in the panel at its verse.
open_study_sheet(vi: int, w: int) {
    if (presented() != 0) return;
    if (beside_fits()) {
        beside_open(v_chapter(vi), v_num(vi));
        if (bs_nav != 0) open_study(vi, w);
        return
    }
    beside_discard();
    lang_load();
    origin_c = v_chapter(vi);
    origin_v = v_num(vi);
    sheet_form(700.0f64, 860.0f64);
    uk_detents = 1;
    uk_sync();
    uk_nav = 0;
    sk_study_open(vi, w, w_greek(w), w_strongs(w), false, false);
    uk_effects();
    study_table = uk_table_of(SCR_STUDY)
}

// Add to Note: "ἀγαπάω (agapaō, G25): to love" on a line of its own at the
// end of the verse's note (a new note if it has none), and the note's
// editor over the study, the cursor at its end.
add_to_note(_self: int, _cmd: int, _b: int): int {
    c: int = v_chapter(ws_vi);
    v: int = v_num(ws_vi);
    i: int = note_of(c, v);
    n: int = 0;
    last: int = v;
    if (i >= 0) {
        n = kept_notes[i].text_n;
        for x in 0..n note_buf[x] = nt_pool[kept_notes[i].text_at + x];
        last = kept_notes[i].end;
        if (n > 0 && n < len(note_buf)) {
            note_buf[n] = 10i8;
            n = n + 1
        }
    }
    fbuf_n = 0;
    if (ws_lex >= 0) {
        lex_field(ws_lex, 0);
        for x in lf_b..lf_e fput(llex[x] as int);
        fput_str(" (");
        lex_field(ws_lex, 1);
        for x in lf_b..lf_e fput(llex[x] as int);
        fput_str(", ")
    } else fput_str("(");
    fput_key(w_greek(ws_w), w_strongs(ws_w));
    fput_str(")");
    if (ws_lex >= 0) {
        fput_str(": ");
        lex_field(ws_lex, 3);
        for x in lf_b..lf_e fput(llex[x] as int)
    }
    for x in 0..fbuf_n {
        if (n < len(note_buf)) {
            note_buf[n] = fbuf[x];
            n = n + 1
        }
    }
    set_note(c, v, last, note_buf, n);
    save_notes();
    remake(c);
    note_force_edit = true;
    open_note(c, v, last);
    0
}

study_interlinear(_self: int, _cmd: int, _b: int): int {
    push_interlinear(ws_vi);
    0
}

// The count, a faint checkmark, and the disclosure.
value_check_disclosure(text: int): int {
    v: int = value_disclosure(text, c_faint);
    iv: int = msg(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol("checkmark", 13.0f64, 6, c_faint)), sel("autorelease"));
    msg(iv, sel("sizeToFit"));
    l8_msg_hfa(hfa, v, sel("frame"), 0, 0, 0);
    vw: f64 = hfa[2];
    vh: f64 = hfa[3];
    iw: f64 = view_width(iv);
    ih: f64 = view_height(iv);
    // (The checkmark between the count and the chevron.)
    subs: int = msg(v, sel("subviews"));
    label: int = msg1(subs, sel("objectAtIndex:"), 0);
    chevron: int = msg1(subs, sel("objectAtIndex:"), 1);
    l8_msg_hfa(hfa, chevron, sel("frame"), 0, 0, 0);
    cx: f64 = hfa[0];
    msg_rect(chevron, sel("setFrame:"), cx + iw + 6.0f64, hfa[1], hfa[2], hfa[3]);
    msg_rect(iv, sel("setFrame:"), cx, (vh - ih) / 2.0f64, iw, ih);
    msg1(v, sel("addSubview:"), iv);
    msg_rect(v, sel("setFrame:"), 0.0f64, 0.0f64, vw + iw + 6.0f64, vh);
    _l: int = label;
    v
}

// ---- the definition ----
def_tv: int = 0;

open_definition() {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    vc: int = msg(make("UIViewController"), sel("autorelease"));
    msg1(vc, sel("setTitle:"), nsstring("Definition"));
    msg1(vc, sel("setHidesBottomBarWhenPushed:"), 1);
    msg1(msg(vc, sel("navigationItem")), sel("setLargeTitleDisplayMode:"), 2);
    view: int = msg(vc, sel("view"));
    msg1(view, sel("setBackgroundColor:"), c_bg);
    tv: int = make("UITextView");
    def_tv = tv;
    msg1(tv, sel("setEditable:"), 0);
    msg1(tv, sel("setBackgroundColor:"), c_bg);
    msg_rect(tv, sel("setTextContainerInset:"), 20.0f64, 20.0f64, 28.0f64, 20.0f64);
    msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
    msg1(tv, sel("setAutoresizingMask:"), 18);
    l8_msg_hfa(hfa, view, sel("bounds"), 0, 0, 0);
    msg_rect(tv, sel("setFrame:"), 0.0f64, 0.0f64, hfa[2], hfa[3]);
    msg1(tv, sel("setAttributedText:"), definition_text());
    tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("definitionTapped:"));
    msg1(tap, sel("setDelegate:"), app_obj);
    msg1(tv, sel("addGestureRecognizer:"), tap);
    release(tap);
    msg1(view, sel("addSubview:"), tv);
    release(tv);
    msg2(sheet_nav, sel("pushViewController:animated:"), vc, 1)
}

k_web: str = "L8Web";

// A paragraph style for the definition: hung for a sense; an outline's
// line indented 1.2 em a level (level 1 at the margin), its wrapped lines
// hung past its label.
def_para(hang: bool, after: f64): int {
    p: int = msg(para_style(0, 0.0f64, if (hang) scaled(16.0f64) * 1.4f64 else 0.0f64,
        0.0f64, after, 1.3f64), sel("autorelease"));
    p
}

def_outline_para(level: int, after: f64): int {
    size: f64 = scaled(16.0f64);
    x: f64 = (level - 1) as f64 * 1.2f64 * size;
    msg(para_style(0, x, x + 1.4f64 * size, 0.0f64, after, 1.3f64), sel("autorelease"))
}

definition_text(): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    greek: bool = ws_greek;
    size: f64 = scaled(16.0f64);
    n: int = lex_count(ws_lex);
    // (The verse's sense first, captioned "In John 3:16"; the rest in
    // their order.)
    first: int = if (ws_sense > 0 && !ws_lemma) ws_sense - 1 else 0;
    for e in 0..n {
        x_: int = if (e == 0) first else if (e <= first) e - 1 else e;
        p: int = lex_line(ws_lex, x_);
        start: int = msg(s, sel("length"));
        if (e == 0 && ws_sense > 0 && !ws_lemma && n > 1) {
            fbuf_n = 0;
            fput_str("In ");
            one_verse[0] = v_num(ws_vi);
            put_ref(v_chapter(ws_vi), one_verse, 1);
            fput_str("\n");
            append(s, fstring(), sans(12.0f64, 0.3f64), c_accent)
        }
        if (e == 0) {
            lex_field(p, 0);
            append(s, ns_of(llex, lf_b, lf_e), original_font(greek, 34.0f64, 40.0f64),
                c_ink);
            append(s, nsstring("\n"), sans(10.0f64, 0.0f64), c_ink);
            lex_field(p, 1);
            append(s, ns_of(llex, lf_b, lf_e), italic_sans(17.0f64), c_faint);
            fbuf_n = 0;
            fput_str(" \�\� ");
            if (e == 0 && ws_sense > 0 && !ws_lemma) fput_sense_code() else fput_key(greek,
                ws_num);
            fput_str("\n");
            append(s, fstring(), mono(15.0f64), c_faint);
            lex_field(p, 3);
            append(s, ns_of(llex, lf_b, lf_e), sans(20.0f64, 0.4f64), c_ink);
            append(s, nsstring("\n"), sans(20.0f64, 0.0f64), c_ink);
            msg4(s, sel("addAttribute:value:range:"), k_para, def_para(false, 16.0f64),
                start, msg(s, sel("length")) - start)
        } else {
            fbuf_n = 0;
            fput_str("Also: ");
            lex_field(p, 0);
            for x in lf_b..lf_e fput(llex[x] as int);
            lex_field(p, 3);
            fput_str(" \�\� ");
            for x in lf_b..lf_e fput(llex[x] as int);
            fput_str("\n");
            append(s, fstring(), sans(15.0f64, 0.4f64), c_heading);
            msg4(s, sel("addAttribute:value:range:"), k_para, def_para(false, 6.0f64),
                start, msg(s, sel("length")) - start)
        }
        lex_field(p, 4);
        lex_markup(lf_b, lf_e);
        a: int = 0;
        for r in 0..lx_runs {
            st_: int = lx_style[r];
            f: int = 0;
            if ((st_ & LX_HEBREW) != 0) f = sans(scaled(19.0f64), 0.0f64) else if ((st_ & LX_BOLD) != 0) f = bold(size) else if ((st_ & LX_ITALIC) != 0) f = italic(size) else f = body(size);
            color: int = if ((st_ & LX_REF) != 0) c_accent else if ((st_ & LX_LABEL) != 0) c_faint else c_ink;
            at: int = msg(s, sel("length"));
            append(s, ns_of(lx, a, lx_end[r]), f, color);
            n2: int = msg(s, sel("length")) - at;
            msg4(s, sel("addAttribute:value:range:"), k_para, if (lx_level[r] > 0) def_outline_para(lx_level[r],
                size * 0.25f64) else def_para(lx_sense[r], size * 0.5f64), at, n2);
            if ((st_ & LX_REF) != 0 && lx_book[r] >= 0) {
                xr_book = lx_book[r];
                xr_c = lx_ch[r];
                xr_v = lx_verse[r];
                xr_ce = 0;
                xr_ve = 0;
                msg4(s, sel("addAttribute:value:range:"), nsstring(k_xref), nsnumber_int(xref_both()),
                    at, n2)
            }
            a = lx_end[r]
        }
        append(s, nsstring("\n"), body(size), c_ink)
    }
    // The credit (CC BY): STEP Bible, linked.
    at: int = msg(s, sel("length"));
    append(s, nsstring("""

Source: """), sans(13.0f64, 0.0f64), c_faint);
    l: int = msg(s, sel("length"));
    append(s, nsstring("STEP Bible"), sans(13.0f64, 0.0f64), c_accent);
    msg4(s, sel("addAttribute:value:range:"), nsstring(k_web), nsnumber_int(1), l,
        10);
    msg4(s, sel("addAttribute:value:range:"), k_para, def_para(false, 0.0f64), at,
        msg(s, sel("length")) - at);
    s
}

// A tap on the definition: a reference's preview pushed (DESIGN.md §8.1);
// the credit opens STEP Bible.
definition_tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    x: f64 = hfa[0];
    y: f64 = hfa[1];
    if (link_at(tv, x, y, k_web) > 0) {
        open_web("https://www.STEPBible.org");
        return 0
    }
    ref_tap_at(tv, x, y);
    0
}

// ---- the concordance: core's (SCR_CONCORDANCE) ----
// A parsing's concordance (Forms' tap): its parsing (lang.l8's fo_*).
open_form_concordance(g: int) {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    uk_sync();
    uk_nav = sheet_nav;
    sk_form_concordance(g);
    uk_effects()
}

// ---- acknowledgements: core's (core/skin.l8's SCR_ACKNOWLEDGEMENTS),
// pushed in the settings sheet, made large ----
open_acknowledgements() {
    if (settings_nav == 0) return;
    help_grow(settings_nav);
    uk_open(SCR_ACKNOWLEDGEMENTS, 0, true, settings_nav)
}

// "Smooth Bible 1.0 (21)": the acknowledgements' last footer, and the
// Manual's.
app_version_line(): int {
    bundle: int = msg(cls("NSBundle"), sel("mainBundle"));
    fbuf_n = 0;
    fput_str("Smooth Bible ");
    for key in ["CFBundleShortVersionString", "CFBundleVersion"] {
        // (Read from the bundle's own Info.plist at run time: the build
        // number written into it when it was built or signed.)
        v: int = msg1(msg(bundle, sel("infoDictionary")), sel("objectForKey:"), nsstring(key));
        if (key[8] as int == 86) fput_str(" (");
        if (v != 0) {
            n: int = nsstring_into(v, number_buf);
            for i in 0..n fput(number_buf[i] as int)
        }
    }
    fput_str(")");
    fstring()
}

// ---- classes and methods ----
make_study_classes() {
    il_class = objc_allocateClassPair(cls("UIViewController"), "L8Interlinear", 0);
    add_method0(il_class, sel("viewDidLayoutSubviews"), &il_layout, "v@:");
    add_method1(il_class, sel("viewWillDisappear:"), &il_disappearing, "v@:B");
    objc_registerClassPair(il_class)
}

study_index_titles(_self: int, _cmd: int, t: int): int {
    uk_index_titles(t)
}

add_study_methods(app: int) {
    add_method1(app, sel("ilPrevious:"), &il_previous, "v@:@");
    add_method1(app, sel("ilNext:"), &il_next, "v@:@");
    add_method1(app, sel("ilOrder:"), &il_order, "v@:@");
    add_method1(app, sel("tileTapped:"), &tile_tapped, "v@:@");
    add_method1(app, sel("learnTileShow:"), &learn_tile_show, "B@:@");
    add_method1(app, sel("learnTileStudy:"), &learn_tile_study, "B@:@");
    add_method1(app, sel("learnLink:"), &learn_link, "v@:@");
    add_method1(app, sel("definitionTapped:"), &definition_tapped, "v@:@");
    add_method1(app, sel("addToNote:"), &add_to_note, "v@:@");
    add_method1(app, sel("studyInterlinear:"), &study_interlinear, "v@:@");
    add_method1(app, sel("sectionIndexTitlesForTableView:"), &study_index_titles,
        "@@:@")
}

// ---- Study's lists (tables.l8) ----
// (Study's screens kept while its panel, beside the text, holds them.)
study_part_gone() {
    if (bs_nav == 0) study_globals_gone()
}

study_screens() {
    s: TableScreen = table_screen(&xref_table, &xref_sections, &xref_rows, &xref_cell);
    s.picked = &xref_picked;
    s.footer = &xref_footer;
    table_add(s);
    on_sheet_gone(&study_part_gone)
}
