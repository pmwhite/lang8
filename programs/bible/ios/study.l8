tag bible_ios;

use_tag std, ios, bible;

// The study screens (DESIGN.md §7): a verse's interlinear (a sheet from
// the verse tray's Study), a word's study pushed from it, the word's
// definition and its concordance, and the acknowledgements pushed from
// the reading settings. What they show comes from lang.l8; the data
// (data/lang/, in the app's bundle) is read at the first study, mapped by
// NSData, not at launch.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/lang.l8";

// ---- the data, at first use ----
// Each file mapped (mmap) at the first study, never at launch: nothing is
// read or allocated for a reader who never studies. A mapping is an L8
// array: its length in the (anonymous, writable) page before the file's
// pages, the file itself mapped read-only after them.
extern mmap(
    addr: int,
    n: int,
    prot: int,
    flags: int,
    fd: int,
    offset: int
): int;

extern open_c(path: int, flags: int, mode: int): int = open;

extern lseek(fd: int, offset: int, whence: int): int;

extern bytes_at(p: int): []i8 = l8_as_int;

extern ints_bytes(a: []int): []i8 = l8_as_int;

extern CFAbsoluteTimeGetCurrent(): f64;

extern dlopen(path: str, mode: int): int;

lang_page: int = 16384;

lang_none: []i8 = new i8[1](0i8);

// The size of the file last mapped (0 if it is missing).
lang_mapped: int = 0;

lang_map(name: str, ext: str): []i8 {
    lang_mapped = 0;
    bundle: int = msg(cls("NSBundle"), sel("mainBundle"));
    path: int = msg2(bundle, sel("pathForResource:ofType:"), nsstring(name), nsstring(ext));
    if (path == 0) return lang_none;
    fd: int = open_c(msg(path, sel("fileSystemRepresentation")), 0, 0);
    if (fd < 0) return lang_none;
    // (Its size by seeking to its end: no file attributes read, so none of
    // its times, which the privacy manifest would have to give a reason for.)
    n: int = lseek(fd, 0, 2);
    if (n <= 0) {
        close(fd);
        return lang_none
    }
    // (PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON; then PROT_READ,
    // MAP_PRIVATE|MAP_FIXED over all but its first page.)
    base: int = mmap(0, n + lang_page, 3, 4098, -1, 0);
    if (base == -1 || base == 0) {
        close(fd);
        return lang_none
    }
    at: int = mmap(base + lang_page, n, 1, 18, fd, 0);
    close(fd);
    if (at != base + lang_page) return lang_none;
    one[0] = n;
    memcpy_to(base + lang_page - 8, ints_bytes(one), 8);
    lang_mapped = n;
    bytes_at(base + lang_page)
}

lang_load() {
    if (lang_ready) return;
    t0: f64 = CFAbsoluteTimeGetCurrent();
    lw = lang_map("words", "bin");
    if (lang_mapped == 0) {
        note("bible: no language data");
        return
    }
    lw_n = lang_mapped / 12;
    lv = lang_map("verses", "bin");
    lv_n = lang_mapped / 8 - 1;
    lsup = lang_map("supplied", "bin");
    lsup_n = lang_mapped / 8;
    lforms = lang_map("forms", "txt");
    lforms_len = lang_mapped;
    lmorph = lang_map("morph", "txt");
    lmorph_len = lang_mapped;
    lconc = lang_map("conc", "bin");
    lconc_len = lang_mapped;
    llex = lang_map("lexicon", "txt");
    llex_len = lang_mapped;
    lgram = lang_map("grammar", "txt");
    lgram_len = lang_mapped;
    // (Senses and related words: DESIGN.md §10.3, §10.4.)
    lsen = lang_map("senses", "bin");
    lsen_n = lang_mapped;
    lrel = lang_map("related", "bin");
    lrel_n = lang_mapped;
    // (Cross references and the commentary: DESIGN.md §9.6, §9.7.)
    lxi = lang_map("xref_index", "bin");
    lxi_n = lang_mapped / 4;
    lxr = lang_map("xrefs", "bin");
    lxr_n = lang_mapped;
    lmh = lang_map("mhcc", "txt");
    lmh_n = lang_mapped;
    // (Meanings in context, UBS's: DESIGN.md §14.10b.3.)
    lmean = lang_map("meanings", "bin");
    lmean_n = lang_mapped;
    lmeant = lang_map("meanings", "txt");
    lmeant_n = lang_mapped;
    mean_index();
    lang_index();
    note_num("bible: language data mapped, ms ", ((CFAbsoluteTimeGetCurrent() - t0) * 1000.0f64) as int)
}

// Whether verse v of chapter c can be studied (the data read, if not yet).
can_study(c: int, v: int): bool {
    lang_load();
    vi: int = lang_verse(c, v);
    vi >= 0 && v_aligned(vi) && v_end(vi) > v_first(vi)
}

// Whether verse v of chapter c may be studied, as far as is known without
// reading the data (so the tray does not read it).
study_maybe(c: int, v: int): bool {
    if (!lang_ready) return true;
    vi: int = lang_verse(c, v);
    vi >= 0 && v_aligned(vi) && v_end(vi) > v_first(vi)
}

// ---- fonts and text ----
// Greek in New York, Hebrew in the system's font (its Hebrew), at a size
// (scaled with the phone's text size).
scaled(size: f64): f64 {
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    msg_f_f(metrics, sel("scaledValueForValue:"), size)
}

serif(size: f64): int {
    d: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
        objc_const("UIFontTextStyleBody"));
    s: int = msg1(d, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), if (s != 0) s else d, size)
}

original_font(greek: bool, greek_size: f64, hebrew_size: f64): int {
    if (greek) serif(scaled(greek_size)) else sans(scaled(hebrew_size), 0.0f64)
}

italic_sans(size: f64): int {
    f: int = sans(size, 0.0f64);
    d: int = msg1(msg(f, sel("fontDescriptor")), sel("fontDescriptorWithSymbolicTraits:"),
        1);
    if (d == 0) return f;
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

mono(size: f64): int {
    msg_ff(cls("UIFont"), sel("monospacedDigitSystemFontOfSize:weight:"), size, 0.0f64)
}

// Bytes a to b of buffer x as an NSString.
ns_of(x: []i8, a: int, b: int): int {
    if (b <= a) return nsstring("");
    nsstring_at(bytes_address(x) + a, b - a)
}

attributed(text: int, font: int, color: int): int {
    keys[0] = k_font;
    values[0] = font;
    keys[1] = k_color;
    values[1] = color;
    msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, nsdictionary(keys, values, 2)), sel("autorelease"))
}

append(
    s: int,
    text: int,
    font: int,
    color: int
) {
    msg1(s, sel("appendAttributedString:"), attributed(text, font, color))
}

label_of(a: int): int {
    l: int = msg(make("UILabel"), sel("autorelease"));
    msg1(l, sel("setAttributedText:"), a);
    msg1(l, sel("setTextAlignment:"), 1);
    l
}

// A label's size: hfa[0], hfa[1].
label_size(l: int, most: f64) {
    msg_set_f(l, sel("setPreferredMaxLayoutWidth:"), most);
    l8_msg_hfa(hfa, l, sel("intrinsicContentSize"), 0, 0, 0)
}

// The view controller on top of the sheets.
top_presented(): int {
    top: int = presented();
    if (top == 0) return 0;
    while (msg(top, sel("presentedViewController")) != 0) top = msg(top, sel("presentedViewController"));
    top
}

// A page in Safari's own view, over everything.
open_web(url: str) {
    u: int = msg1(cls("NSURL"), sel("URLWithString:"), nsstring(url));
    // (SafariServices loaded at its first use, not linked: nothing more for
    // the launch to load.)
    if (cls("SFSafariViewController") == 0) _h: int = dlopen("/System/Library/Frameworks/SafariServices.framework/SafariServices",
        1);
    sf: int = cls("SFSafariViewController");
    if (sf == 0 || u == 0) return;
    vc: int = msg1(msg(sf, sel("alloc")), sel("initWithURL:"), u);
    top: int = top_presented();
    msg3(if (top != 0) top else nav, sel("presentViewController:animated:completion:"),
        vc, 1, 0);
    release(vc)
}

// The helped mark: 1.5 points of accent at 50% under a tile's English.
tile_underline(t: int, eng: int) {
    // (Under its words only: the text's width, centred in the line.)
    l8_msg_hfa(hfa, eng, sel("frame"), 0, 0, 0);
    fx: f64 = hfa[0];
    fy: f64 = hfa[1];
    fw: f64 = hfa[2];
    fh: f64 = hfa[3];
    label_size(eng, fw);
    tw: f64 = if (hfa[0] > 0.0f64 && hfa[0] < fw) hfa[0] else fw;
    hfa[0] = fx + (fw - tw) / 2.0f64;
    hfa[1] = fy;
    hfa[2] = tw;
    hfa[3] = fh;
    u: int = msg(make("UIView"), sel("autorelease"));
    msg1(u, sel("setBackgroundColor:"), msg_set_f(c_accent, sel("colorWithAlphaComponent:"),
        0.5f64));
    msg1(u, sel("setUserInteractionEnabled:"), 0);
    msg_rect(u, sel("setFrame:"), hfa[0], hfa[1] + hfa[3] - 0.5f64, hfa[2], 1.5f64);
    msg1(t, sel("addSubview:"), u)
}

// A cross-fade of whatever changes in a layer next, over t seconds.
fade_layer(layer: int, t: f64) {
    if (layer == 0) return;
    tr: int = make("CATransition");
    msg1(tr, sel("setType:"), objc_const("kCATransitionFade"));
    msg_set_f(tr, sel("setDuration:"), t);
    msg2(layer, sel("addAnimation:forKey:"), tr, 0);
    release(tr)
}

// ---- word study: core's (core/skin.l8's SCR_STUDY, with SCR_GRAMMAR
// and SCR_CONCORDANCE); its numbers (ws_*) core's, which the
// interlinear, the definition and Add to Note read ----
study_table: int = 0;

// A word's study pushed in the sheet (from the interlinear), large.
open_study(vi: int, w: int) {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    lang_load();
    uk_sync();
    uk_nav = sheet_nav;
    sk_study_open(vi, w, w_greek(w), w_strongs(w), true, true);
    uk_effects();
    study_table = uk_table_of(SCR_STUDY);
    sheet: int = msg(sheet_nav, sel("sheetPresentationController"));
    if (sheet != 0) msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierLarge"))
}

// A related word's lemma study pushed (no verse: no grammar, nor Add to
// Note).
open_lemma(greek: bool, num: int) {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    lang_load();
    uk_sync();
    uk_nav = sheet_nav;
    sk_study_open(-1, -1, greek, num, false, true);
    uk_effects()
}

// A word's study as a sheet of its own, large (from the edit menu's Study);
// beside the text, where it fits, pushed in the panel at its verse.
open_study_sheet(vi: int, w: int) {
    if (presented() != 0) return;
    if (beside_fits()) {
        beside_open(v_chapter(vi), v_num(vi));
        if (bs_nav != 0) open_study(vi, w);
        return
    }
    beside_discard();
    lang_load();
    origin_c = v_chapter(vi);
    origin_v = v_num(vi);
    sheet_form(700.0f64, 860.0f64);
    uk_detents = 1;
    uk_sync();
    uk_nav = 0;
    sk_study_open(vi, w, w_greek(w), w_strongs(w), false, false);
    uk_effects();
    study_table = uk_table_of(SCR_STUDY)
}

// The count, a faint checkmark, and the disclosure.
value_check_disclosure(text: int): int {
    v: int = value_disclosure(text, c_faint);
    iv: int = msg(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol("checkmark", 13.0f64, 6, c_faint)), sel("autorelease"));
    msg(iv, sel("sizeToFit"));
    l8_msg_hfa(hfa, v, sel("frame"), 0, 0, 0);
    vw: f64 = hfa[2];
    vh: f64 = hfa[3];
    iw: f64 = view_width(iv);
    ih: f64 = view_height(iv);
    // (The checkmark between the count and the chevron.)
    subs: int = msg(v, sel("subviews"));
    label: int = msg1(subs, sel("objectAtIndex:"), 0);
    chevron: int = msg1(subs, sel("objectAtIndex:"), 1);
    l8_msg_hfa(hfa, chevron, sel("frame"), 0, 0, 0);
    cx: f64 = hfa[0];
    msg_rect(chevron, sel("setFrame:"), cx + iw + 6.0f64, hfa[1], hfa[2], hfa[3]);
    msg_rect(iv, sel("setFrame:"), cx, (vh - ih) / 2.0f64, iw, ih);
    msg1(v, sel("addSubview:"), iv);
    msg_rect(v, sel("setFrame:"), 0.0f64, 0.0f64, vw + iw + 6.0f64, vh);
    _l: int = label;
    v
}

// ---- the definition: core's (core/verse_study.l8's SCR_DEFINITION) ----
// The word study's definition pushed, as its row does (the demos').
open_definition() {
    uk_act_kind(SCR_STUDY, ACT_STUDY_DEFINITION, 0)
}

// ---- the concordance: core's (SCR_CONCORDANCE) ----
// A parsing's concordance (Forms' tap): its parsing (lang.l8's fo_*).
open_form_concordance(g: int) {
    sheet_nav: int = study_host();
    if (sheet_nav == 0) return;
    uk_sync();
    uk_nav = sheet_nav;
    sk_form_concordance(g);
    uk_effects()
}

// ---- acknowledgements: core's (core/skin.l8's SCR_ACKNOWLEDGEMENTS),
// pushed in the settings sheet, made large ----
open_acknowledgements() {
    if (settings_nav == 0) return;
    help_grow(settings_nav);
    uk_open(SCR_ACKNOWLEDGEMENTS, 0, true, settings_nav)
}

// "Smooth Bible 1.0 (21)": the acknowledgements' last footer, and the
// Manual's.
app_version_line(): int {
    bundle: int = msg(cls("NSBundle"), sel("mainBundle"));
    fbuf_n = 0;
    fput_str("Smooth Bible ");
    for key in ["CFBundleShortVersionString", "CFBundleVersion"] {
        // (Read from the bundle's own Info.plist at run time: the build
        // number written into it when it was built or signed.)
        v: int = msg1(msg(bundle, sel("infoDictionary")), sel("objectForKey:"), nsstring(key));
        if (key[8] as int == 86) fput_str(" (");
        if (v != 0) {
            n: int = nsstring_into(v, number_buf);
            for i in 0..n fput(number_buf[i] as int)
        }
    }
    fput_str(")");
    fstring()
}

// ---- classes and methods ----
study_index_titles(_self: int, _cmd: int, t: int): int {
    uk_index_titles(t)
}

add_study_methods(app: int) {
    add_method1(app, sel("sectionIndexTitlesForTableView:"), &study_index_titles,
        "@@:@")
}

// ---- Study's lists (tables.l8) ----
// (Study's screens kept while its panel, beside the text, holds them.)
study_part_gone() {
    if (bs_nav == 0) study_globals_gone()
}

study_screens() {
    on_sheet_gone(&study_part_gone)
}
