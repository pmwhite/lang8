tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 9 steps (DESIGN.md §13.8.2): the `memory` group, shots
// 210 to 233, on the demo clock, from a memory.tsv simulate.sh writes
// before the first launch (Philippians 4:6–7 to review, Romans 8:28–39
// learning, Psalm 23 in the KJV later), with the audio fixture (ROM 8 given
// its timings there): the tray's Memorize and Memorizing, the Library's
// Memory, Add Passage, a passage learned in parts, a review typed, the
// judgement and its line, Echo, the end, Passage, the reminder, Night,
// the largest text; and the recording of sequence 15. Each tap is made
// through the function the control calls; the text's layout is logged
// after each level and reveal (the same words in the same places).
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/memory.l8";

// The passage of code c:v (its first verse), or -1.
d8_find(code: str, c: int, v: int): int {
    b: int = book_coded(code);
    if (b < 0) return -1;
    ch: int = book_first[b] + c - 1;
    for i in 0..mq_n
        if (mq_c1[i] == ch && mq_v1[i] == v) return i;
    -1
}

// Word w's place, as UTF-16 rects: their sum, so that two layouts with
// every word where it was give the same number.
d8_rect: []f64 = new f64[4](0.0f64);

d8_layout() {
    // (The words Practice's, not a row's that the Library asked for since.)
    px_sync();
    if (px_tv == 0 || mw_n == 0) return;
    // (Laid out first: the sheet's views, then all of the text.)
    if (px_vc != 0) msg(msg(px_vc, sel("view")), sel("layoutIfNeeded"));
    lm: int = msg(px_tv, sel("layoutManager"));
    container: int = msg(px_tv, sel("textContainer"));
    msg1(lm, sel("ensureLayoutForTextContainer:"), container);
    note_num("bible: practice text width ", view_width(px_tv) as int);
    sum: int = 0;
    for w in 0..mw_n {
        b: int = px_at16(mw_b[w]);
        l8_msg_hfa(d8_rect, lm, sel("boundingRectForGlyphRange:inTextContainer:"),
            b, px_at16(mw_e[w]) - b, container);
        sum = sum + (d8_rect[0] * 10.0f64) as int * 7 + (d8_rect[1] * 10.0f64) as int * 13 + (d8_rect[2] * 10.0f64) as int;
        // (A few words' places, to say what moved, should anything.)
        if (w == 0 || w == 26 || w == 27 || w == mw_n - 1) {
            fbuf_n = 0;
            fput_str("bible: practice word ");
            fput_int(w);
            fput_str(" at ");
            fput_int(d8_rect[0] as int);
            fput_str(",");
            fput_int(d8_rect[1] as int);
            fput_str(" width ");
            fput_int(d8_rect[2] as int);
            fput_str(", glyph ");
            fput_int(b);
            note_ns(fstring())
        }
    }
    note_num("bible: practice layout ", sum)
}

// The word of the passage shown spelled s (its first), or -1.
d8_word(s: str): int {
    for w in 0..mw_n {
        if (mw_h2[w] - mw_k[w] == len(s)) {
            same: bool = true;
            for i in 0..len(s)
                if (mt[mw_k[w] + i] != s[i]) same = false;
            if (same) return w
        }
    }
    -1
}

// A letter not word w's (a wrong key).
d8_wrong(w: int): int {
    k: int = 113;
    while (k == mw_key[w] || k == mw_alt[w]) k = k + 1;
    k
}

// The first n words practised typed (word wrong_at with a wrong key twice).
d8_type(n: int, wrong_at: int) {
    typed: int = 0;
    while (typed < n && px_cur >= 0) {
        w: int = px_cur;
        if (w == wrong_at) {
            memory_type(d8_wrong(w));
            memory_type(d8_wrong(w))
        } else memory_type(mw_key[w]);
        typed = typed + 1
    }
}

demo_do8(t: int) {
    if (t == 370) {
        // 210: John 3:16–17 selected (the BSB).
        demo_dismiss();
        listen_stop();
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB);
        clear_selection();
        go_verse(john3(), 14);
        bar_set(0.0f64);
        toggle_verse(john3(), 16);
        toggle_verse(john3(), 17)
    }
    if (t == 371) tray_action(0, 0, tray_actions[6]);
    if (t == 372) {
        toast_clear();
        toggle_verse(john3(), 16);
        note_num("bible: demo memorizing ", tray_memory_holding())
    }
    if (t == 373) {
        // 213: the Library on Memory.
        clear_selection();
        set_def_int("librarySegment", 3);
        demo_later_do(1)
    }
    if (t == 374) {
        // 214: Add Passage, "isa 52:13-53:12" typed (the keyboard kept down
        // so the text shows).
        demo_no_keyboard = true;
        mm_open_add();
        demo_later_at(0.8f64, 600)
    }
    if (t == 375) {
        // 215: back without adding; John 3:16–17's row tapped.
        demo_no_keyboard = false;
        top: int = presented();
        if (top != 0) msg1(top, sel("popToRootViewControllerAnimated:"), 0);
        demo_later_at(0.6f64, 601)
    }
    if (t == 376 || t == 377 || t == 378) {
        // 216–218: Next, Next, Next.
        memory_main();
        d8_layout()
    }
    if (t == 379) {
        // 219: "loved" tapped.
        memory_show_word(d8_word("loved"));
        d8_layout()
    }
    if (t == 380) {
        // 220: Check.
        memory_check();
        d8_layout()
    }
    if (t == 381) {
        // 221: Next Verse; verse 17 Next ×3 and Check; Done (the part
        // learned, the passage to review); the two joined at Blank, Check.
        memory_main();
        demo_later_at(0.5f64, 602)
    }
    if (t == 382) {
        // 222: Practice (Today: Philippians, Romans); Type; 14 key letters,
        // the sixth wrong twice.
        practice_close(true);
        demo_later_at(0.8f64, 607)
    }
    if (t == 383) {
        // 223: the rest typed: checked by itself.
        d8_type(1000, -1)
    }
    if (t == 384) memory_touch(G_KNEW);
    if (t == 385) {
        // 225: Mostly; Romans' warm-up.
        practice_touch_up(0, 0, 0);
        memory_grade_now(G_MOSTLY)
    }
    if (t == 386) {
        // 226: Check; the new part (8:32) at Full; Echo.
        memory_main();
        memory_main();
        memory_listen(2);
        demo_later_at(0.3f64, 699)
    }
    if (t == 387) {
        // 226b: in the pause (the verse's end reached at once: the
        // fixture's 8:32 is long, so that 226 shows it washed).
        if (px_au_mode == 2 && px_turn < 0 && px_au_player) {
            if (px_ap != 0) msg(px_ap, sel("pause"));
            px_echo_pause(px_ap_to - px_ap_from)
        }
        demo_later_at(0.3f64, 699)
    }
    if (t == 388) {
        // 227: 8:32 learned (Next ×3, Check, Next Verse); Done; Practice
        // again: the end.
        px_au_stop();
        for _k in 0..3 memory_main();
        memory_check();
        memory_main();
        demo_later_at(0.6f64, 610)
    }
    if (t == 389) {
        // 228: closed: the Library.
        practice_close(true)
    }
    if (t == 390) {
        // 229: ⓘ on Psalm 23 · KJV.
        mm_open_passage(d8_find("PSA", 23, 1))
    }
    if (t == 391) {
        // 230: back; the reminder on (the shim's answer forced).
        top: int = presented();
        if (top != 0) msg1(top, sel("popToRootViewControllerAnimated:"), 0);
        auth_why = 3;
        auth_ticks = 0;
        auth_answered = 2;
        auth_timer = stop_timer(auth_timer);
        auth_timer = after(0.2f64, "authTick:");
        demo_later_at(0.8f64, 612)
    }
    if (t == 392) {
        // 231: Night; John 3:16–17 from its row (over the Library, which
        // stays), at Letters, typing on.
        set_theme = 4;
        settings_changed(true);
        demo_later_at(0.6f64, 613)
    }
    if (t == 393) {
        // 232: (the largest text) Psalm 23, after Check (over the Library
        // again).
        practice_close(true);
        set_theme = 0;
        settings_changed(true);
        demo_later_at(0.6f64, 615)
    }
    if (t == 394) {
        // 233: the Library on Memory at the largest text.
        practice_close(true);
        demo_dismiss();
        set_def_int("librarySegment", 3);
        demo_later_do(1)
    }
    if (t == 395) {
        // Sequence 15's setup: Practice of John 3:16–17 and Psalm 23, both
        // to review, John at Full.
        demo_dismiss();
        set_def_bool("memoryType", false);
        jn: int = d8_find("JHN", 3, 16);
        ps: int = d8_find("PSA", 23, 1);
        if (jn >= 0 && ps >= 0) {
            mq_due[jn] = today();
            mq_due[ps] = today();
            mq_level[jn] = LV_FULL;
            save_memory()
        }
        demo_later_at(0.8f64, 620)
    }
    if (t == 396) {
        // Sequence 15: Full → Some → Letters → Blank → Letters, a word
        // tapped, Check, Next Passage, the judgement in and out.
        demo_later_at(0.7f64, 621)
    }
    if (t == 397) {
        // (After the recording: closed.) Then review r9-1's Majors 7, 8
        // and 6: a memory-only reminder opened on a cold launch (kept until
        // the reader is up, then the Library on Memory); Memory's reminder
        // turned off with the plan's off (nothing left pending); an ESV
        // passage's verses fetched again once older than 30 days.
        practice_close(true);
        demo_dismiss();
        note("bible: demo sequence 15 done");
        restored = false;
        memory_reminder_opened();
        restored = true;
        daily_reader_up();
        demo_later_at(2.0f64, 640)
    }
    if (t == 398) {
        // 229b: Passage, scrolled to its end (Start Over, Delete Passage).
        d8_scroll_end(uk_table_of(SCR_MM_PASSAGE))
    }
    if (t == 399) {
        // 234: the BSB's longest passage of 40 verses in one book (2 Kings
        // 22:12-23:31, 1,501 words) at Blank: every word underlined, no
        // crash (review r9-1 Major 5).
        demo_dismiss();
        b: int = book_coded("2KI");
        if (b >= 0) {
            id: int = memory_add(TEXT_BSB, book_first[b] + 21, 12, book_first[b] + 22,
                31, time(0));
            i: int = mem_index(id);
            if (i >= 0) {
                memory_open(i, today());
                memory_part_checked(i, 1, today(), time(0));
                mq_level[i] = LV_BLANK;
                save_memory();
                practice_open_one(i);
                demo_later_at(1.2f64, 645)
            }
        }
    }
}

d8_waits: int = 0;

// The Library scrolled to its Daily Reminder's first row.
d8_reminder_row() {
    if (lib_table == 0) return;
    msg(lib_table, sel("layoutIfNeeded"));
    k: int = uk_section_titled(SCR_LIBRARY, "Daily Reminder");
    if (k >= 0) {
        path: int = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0,
            k);
        msg3(lib_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
            path, 2, 0);
        msg(lib_table, sel("layoutIfNeeded"))
    }
}

// The switch on screen: its row's cell's (the one shown), else the one
// kept.
d8_reminder_switch(): int {
    if (lib_table != 0) {
        k: int = uk_section_titled(SCR_LIBRARY, "Daily Reminder");
        if (k >= 0) {
            path: int = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"),
                0, k);
            cell: int = msg1(lib_table, sel("cellForRowAtIndexPath:"), path);
            if (cell != 0) {
                sw: int = msg(cell, sel("accessoryView"));
                if (sw != 0 && responds(sw, "isOn")) return sw
            }
        }
    }
    0
}

// Table t scrolled to its end, at once.
d8_scroll_end(t: int) {
    if (t == 0) return;
    msg(t, sel("layoutIfNeeded"));
    l8_msg_hfa(hfa, t, sel("contentSize"), 0, 0, 0);
    h: f64 = hfa[1];
    l8_msg_hfa(hfa, t, sel("adjustedContentInset"), 0, 0, 0);
    y: f64 = h - view_height(t) + hfa[2];
    if (y > -hfa[0]) msg1_ff(t, sel("setContentOffset:animated:"), 0, 0.0f64, y)
}

demo_later8(d: int) {
    if (d == 600) {
        // (The reference typed, as the field's editing would.)
        mm_add_field: int = uk_field_of(SCR_MM_ADD);
        if (mm_add_field != 0) {
            msg1(mm_add_field, sel("setText:"), nsstring("isa 52:13-53:12"));
            uk_field_commit_kind(SCR_MM_ADD);
            if (diag_on) {
                fbuf_n = 0;
                fput_str("bible: add passage footer ");
                if (sk_mm_parsed) {
                    fput_range(rg_c1, rg_v1, rg_c2, rg_v2);
                    fput_str(", ");
                    fput_int(rg_verses)
                }
                fput_str(if (sk_mm_ok) ", Add enabled" else ", Add disabled");
                note_ns(fstring())
            }
        }
        return
    }
    if (d == 601) {
        lib_refresh(false);
        practice_open_one(d8_find("JHN", 3, 16));
        demo_later_at(0.9f64, 698);
        return
    }
    if (d == 698) {
        d8_layout();
        return
    }
    if (d == 602) {
        for _k in 0..3 memory_main();
        demo_later_at(0.4f64, 603);
        return
    }
    if (d == 603) {
        memory_check();
        demo_later_at(0.4f64, 604);
        return
    }
    if (d == 604) {
        // Done: the last part learned; the two joined at Blank.
        memory_main();
        demo_later_at(0.5f64, 605);
        return
    }
    if (d == 605) {
        memory_check();
        return
    }
    if (d == 607) {
        lib_refresh(false);
        practice_open_today();
        demo_later_at(1.0f64, 608);
        return
    }
    if (d == 608) {
        px_typing = true;
        set_def_bool("memoryType", true);
        px_keyboard(true);
        d8_type(14, 5);
        return
    }
    if (d == 699) {
        note_num("bible: demo echo wash ", px_wash);
        note_num("bible: demo echo turn ", px_turn);
        return
    }
    if (d == 610) {
        // Done (closed), then Practice again: nothing left today.
        practice_close(true);
        demo_later_at(0.8f64, 611);
        return
    }
    if (d == 611) {
        practice_open_today();
        return
    }
    if (d == 612) {
        // (The reminder's rows and footer in sight: the list at its end.)
        if (lib_table != 0) {
            msg(lib_table, sel("layoutIfNeeded"));
            l8_msg_hfa(hfa, lib_table, sel("contentSize"), 0, 0, 0);
            h: f64 = hfa[1];
            l8_msg_hfa(hfa, lib_table, sel("adjustedContentInset"), 0, 0, 0);
            y: f64 = h - view_height(lib_table) + hfa[2];
            if (y > -hfa[0]) msg1_ff(lib_table, sel("setContentOffset:animated:"),
                0, 0.0f64, y)
        }
        return
    }
    if (d == 613) {
        set_def_bool("memoryType", true);
        practice_open_one(d8_find("JHN", 3, 16));
        demo_later_at(0.9f64, 614);
        return
    }
    if (d == 614) {
        px_set_level(LV_LETTERS);
        demo_no_keyboard = true;
        px_cur = px_next_word(px_a0);
        memory_type(mw_key[px_cur]);
        memory_type(mw_key[px_cur]);
        px_paint(false);
        demo_no_keyboard = false;
        return
    }
    if (d == 615) {
        set_def_bool("memoryType", false);
        px_typing = false;
        ps: int = d8_find("PSA", 23, 1);
        if (ps >= 0) mq_due[ps] = today();
        practice_open_one(ps);
        demo_later_at(0.9f64, 616);
        return
    }
    if (d == 616) {
        memory_check();
        return
    }
    if (d == 620) {
        jn: int = d8_find("JHN", 3, 16);
        ps: int = d8_find("PSA", 23, 1);
        px_q[0] = mq_id[jn];
        px_q[1] = mq_id[ps];
        px_back[0] = false;
        px_back[1] = false;
        px_open(2);
        return
    }
    if (d == 640) {
        // (The Library at its Daily Reminder, so the switch's cell is made;
        // once the Library is up.)
        if (presented() == 0 && d8_waits < 10) {
            d8_waits = d8_waits + 1;
            demo_later_at(0.3f64, 640);
            return
        }
        d8_reminder_row();
        demo_later_at(0.8f64, 646);
        return
    }
    if (d == 646) {
        // (Memory's switch turned off on screen, the plan's off: "memory
        // reminder off", then "reminders 0 pending"; review r9-2.)
        sw: int = d8_reminder_switch();
        if (sw != 0) {
            msg2(sw, sel("setOn:animated:"), 0, 1);
            msg1(sw, sel("sendActionsForControlEvents:"), 4096)
        } else {
            fbuf_n = 0;
            fput_str("bible: demo no memory switch: sections ");
            fput_int(if (lib_table != 0) uk_sections(lib_table) else 0);
            fput_str(", segment ");
            fput_int(sk_lib_seg);
            fput_str(", shown ");
            fput_int(if (presented() != 0) 1 else 0);
            note_ns(fstring())
        }
        demo_later_at(1.0f64, 641);
        return
    }
    if (d == 641) {
        // (An ESV passage added: its verse fetched for its pin.)
        demo_dismiss();
        jn: int = book_first[42] + 2;
        id: int = mm_add(TEXT_ESV, jn, 16, jn, 16);
        note_num("bible: demo esv passage ", id);
        demo_later_at(2.5f64, 642);
        return
    }
    if (d == 642) {
        // (Its pin made 31 days old, then the return to the app's check.)
        for k in 0..pn_n
            if (pn_len[k] >= 0) pn_fetched[k] = time(0) - 31 * 86400;
        save_pins();
        esv_app_active();
        demo_later_at(2.5f64, 643);
        return
    }
    if (d == 643) {
        // (And deleted again, so nothing else counts it.)
        for i in 0..mq_n {
            if (mq_ver[i] == TEXT_ESV) {
                esv_pin_remove(mq_id[i]);
                save_pins()
            }
        }
        return
    }
    if (d == 645) {
        // (The long passage: its words and underlines, pieces too.)
        fbuf_n = 0;
        fput_str("bible: practice long passage: words ");
        fput_int(mw_n);
        fput_str(", underlines ");
        fput_int(px_ul_n);
        fput_str(", pieces ");
        fput_int(px_ul_made);
        fput_str(", level ");
        fput_int(px_level);
        note_ns(fstring());
        return
    }
    if (d >= 621 && d <= 631) {
        // (A step every 0.8 s; 1.6 s after Check, so the judgement row is
        // seen coming in, staying, and going: review r9-1 Minor 2.)
        if (d == 621) px_set_level(LV_SOME);
        if (d == 622) px_set_level(LV_LETTERS);
        if (d == 623) px_set_level(LV_BLANK);
        if (d == 624) px_set_level(LV_LETTERS);
        if (d == 625) memory_show_word(d8_word("loved"));
        if (d == 626) memory_check();
        if (d == 627) memory_grade_now(G_MOSTLY);
        if (d == 628) px_set_level(LV_LETTERS);
        if (d == 629) memory_check();
        if (d == 630) memory_grade_now(G_MOSTLY);
        d8_layout();
        if (d < 630) demo_later_at(if (d == 626 || d == 629) 1.6f64 else 0.8f64, d + 1)
    }
}

add_demo8_methods(_app: int) { }
