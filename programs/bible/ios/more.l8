tag vellum;

use_tag std, ios, bible, bible_wire;

// The ⋯ panel: what ⋯ opens (the dock's, or the divider's in a split side
// by side). One card of glass grows out of ⋯ over the page, everything at
// once, nothing to scroll: how the text looks (its size, the theme, the
// font, and the rest of the reading settings as one menu), Listen with
// its speed and voice, and the Library's collections. It is core's
// reading settings (sk_has_quick_more: the Library's rows first) drawn
// as a panel, not a list: a collection opens the Library in place of it;
// a screen it opens (Voice, the Manual) is a sheet over it, swiped away
// to it again. A tap beside it, or ⋯ again, puts it away into ⋯.
import "../../ios/objc.l8";

import "../core/wire.l8";

import "../core/ui.l8";

import "kit.l8";

import "look.l8";

type MorePanel = {
    // The settings screen's slot (-1: none yet, or none shown), and
    // whether core is being asked for it (⋯ tapped, before core's screen
    // came).
    slot: int;
    asking: bool;
    // The overlay (held, over everything of the app's window, under the
    // dock's: a VellumMoreView, the target of everything in it), the card
    // (glass) and what it shows, made at the card's size at rest and
    // pinned to its corner nearest ⋯, so that it is uncovered as the card
    // grows out of ⋯ (clipped by it).
    root: int;
    card: int;
    body: int;
    // The ⋯ it grows out of (a button: the dock's or the divider's), where
    // that is on the screen, and where the card is at rest; whether the
    // card hangs below ⋯ (⋯ high in a split) rather than standing over it.
    source: int;
    from: Rect;
    rest: Rect;
    below: bool;
    // Shown (false while it goes back into ⋯), and the overlay going.
    shown: bool;
    leaving: int
}

more: MorePanel = MorePanel {
    slot: -1,
    asking: false,
    root: 0,
    card: 0,
    body: 0,
    source: 0,
    from: Rect {
        x: 0.0f64,
        y: 0.0f64,
        w: 0.0f64,
        h: 0.0f64
    },
    rest: Rect {
        x: 0.0f64,
        y: 0.0f64,
        w: 0.0f64,
        h: 0.0f64
    },
    below: false,
    shown: false,
    leaving: 0
};

// Its measures: the card's margin to the screen's edges and its gap to ⋯,
// its padding and corners; a control's height, the gap between controls
// and between the panel's two parts; a theme's circle; a collection's
// tile.
MORE_MARGIN: f64 = 12.0f64;

MORE_PAD: f64 = 18.0f64;

MORE_CORNER: f64 = 30.0f64;

MORE_ROW_H: f64 = 44.0f64;

MORE_GAP: f64 = 12.0f64;

MORE_PART_GAP: f64 = 22.0f64;

MORE_SWATCH: f64 = 34.0f64;

MORE_TILE_H: f64 = 64.0f64;

// The widest the card is, in one column and in two (a phone held on its
// side: how the text looks beside Listen and the Library).
MORE_NARROW_MOST: f64 = 420.0f64;

MORE_WIDE_MOST: f64 = 700.0f64;

// ---- shown and put away ----
more_shows(s: int): bool {
    s >= 0 && more.slot == s
}

more_open(): bool {
    more.root != 0 && more.leaving == 0
}

// ⋯ tapped: shown, core asked for the settings; or put away if it shows.
more_toggle(button: int) {
    if (more_open()) {
        more_close(true);
        return
    }
    haptic_impact(0);
    quick_close(false);
    more.source = button;
    more.asking = true;
    send0("tap settings");
    // (Core opened none: nothing shown.)
    more.asking = false
}

// Slot s's settings shown as the panel: grown out of ⋯ when it was
// asked for, else (core opened it: the keys' settings) at once.
more_show(s: int) {
    if (more_open()) {
        if (more.slot >= 0 && more.slot != s && slots[more.slot].controller == 0) slot_free(more.slot);
        more.slot = s;
        more_fill();
        ease(ANIM_MORE, 0.2f64);
        return
    }
    if (!more.asking) more.source = (if (panel_side() && panel.shown) panel_more_button else dock.more_button);
    more.asking = false;
    more_remove_now();
    more.slot = s;
    b: Rect = bounds_of(window);
    root: int = autoreleased(msg_rect(msg(cls("VellumMoreView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, b.w, b.h));
    msg1(root, sel("setAutoresizingMask:"), 18);
    more.root = held(more.root, root);
    tap: int = autoreleased(msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")),
        sel("initWithTarget:action:"), root, sel("vellumMoreBackdrop:")));
    msg1(root, sel("addGestureRecognizer:"), tap);
    more.card = glass_view(false);
    glass_tint(more.card, dock_tint());
    msg1(more.card, sel("setClipsToBounds:"), 1);
    add_sub(root, more.card);
    more.body = autoreleased(view_new());
    add_sub(glass_content(more.card), more.body);
    add_sub(window, root);
    more_fill();
    // (From ⋯: the card the size of ⋯ under it, its glass at once.)
    more.shown = false;
    more_animated();
    glass_shown(more.card, true, false, dock_tint());
    set_alpha(more.body, 0.0f64);
    msg(root, sel("layoutIfNeeded"));
    more.shown = true;
    spring(ANIM_MORE, 0.42f64, 0.12f64)
}

// Put away into ⋯; said `closed` to core when the reader put it away
// (not when core closed it, or opened a screen in place of it).
more_close(said: bool) {
    s: int = more.slot;
    if (!more_open()) return;
    id: int = if (s >= 0) slots[s].id else 0;
    more.slot = -1;
    more.asking = false;
    more.shown = false;
    more.leaving = more.root;
    msg1(more.root, sel("setUserInteractionEnabled:"), 0);
    more.from = more_source_rect();
    spring(ANIM_MORE, 0.34f64, 0.0f64);
    if (s >= 0 && slots[s].controller == 0) slot_free(s);
    if (said && id > 0) send1("closed", id)
}

// Gone into ⋯: the overlay let go.
more_settled() {
    if (more.shown) return;
    more_remove_now()
}

more_remove_now() {
    v: int = more.leaving;
    if (v == 0) return;
    more.leaving = 0;
    msg(v, sel("removeFromSuperview"));
    if (v == more.root) {
        more.root = held(more.root, 0);
        more.card = 0;
        more.body = 0
    }
}

// (ANIM_MORE's layout: the card at rest, or the size of ⋯ under it, its
// glass and what it shows coming and going with it.)
more_animated() {
    if (more.card == 0) return;
    r: Rect = if (more.shown) more.rest else more.from;
    set_frame(more.card, r);
    set_corners(more.card, if (more.shown) MORE_CORNER else r.h / 2.0f64);
    // (What it shows, at its size at rest, kept to the corner nearest ⋯.)
    set_frame4(more.body, r.w - more.rest.w, if (more.below) 0.0f64 else r.h - more.rest.h,
        more.rest.w, more.rest.h);
    set_alpha(more.body, if (more.shown) 1.0f64 else 0.0f64);
    if (!more.shown) glass_shown(more.card, false, false, dock_tint())
}

// Where ⋯ is on the screen (its glass's frame, through the views it is
// in, scrolled or not, to its window's place).
more_source_rect(): Rect {
    v: int = more.source;
    if (v == 0) return Rect {
        x: more.rest.x + more.rest.w - 44.0f64,
        y: more.rest.y + more.rest.h - 44.0f64,
        w: 44.0f64,
        h: 44.0f64
    };
    parent: int = msg(v, sel("superview"));
    if (parent != 0 && is_kind(msg(parent, sel("superview")), "UIVisualEffectView")) v = msg(parent,
        sel("superview"));
    r: Rect = frame_of(v);
    up: int = msg(v, sel("superview"));
    while (up != 0) {
        f: Rect = frame_of(up);
        if (is_kind(up, "UIWindow")) {
            r.x = r.x + f.x;
            r.y = r.y + f.y;
            return r
        }
        b: Rect = bounds_of(up);
        r.x = r.x + f.x - b.x;
        r.y = r.y + f.y - b.y;
        up = msg(up, sel("superview"))
    }
    r
}

// Whether it is laid out in two columns: a screen wider than it is tall,
// wide enough for both.
more_wide(): bool {
    b: Rect = bounds_of(window);
    b.w > b.h && b.w >= 640.0f64
}

// Where the card rests for a body w by h: over ⋯ (or under it, if there
// is no room over it), as near it across as the screen allows.
more_place(w: f64, h: f64) {
    b: Rect = bounds_of(window);
    safe: Insets = safe_insets(window);
    more.from = more_source_rect();
    src: Rect = more.from;
    x: f64 = if (more_wide()) src.x + src.w - w else (b.w - w) / 2.0f64;
    x = clamp_f(x, safe.left + MORE_MARGIN, b.w - safe.right - MORE_MARGIN - w);
    top: f64 = safe.top + MORE_MARGIN;
    y: f64 = src.y - MORE_MARGIN - h;
    more.below = y < top;
    if (more.below) {
        y = src.y + src.h + MORE_MARGIN;
        if (y + h > b.h - safe.bottom - MORE_MARGIN) y = clamp_f((b.h - h) / 2.0f64,
            top, b.h - h)
    }
    more.rest = Rect {
        x: x,
        y: y,
        w: w,
        h: h
    }
}

// ---- filled from core's screen ----
// The panel made again from the settings as core has them now, at the
// width the screen gives it.
more_fill() {
    s: int = more.slot;
    if (more.body == 0 || s < 0 || !screen_load(s)) return;
    subviews_cleared(more.body);
    b: Rect = bounds_of(window);
    safe: Insets = safe_insets(window);
    room: f64 = b.w - safe.left - safe.right - 2.0f64 * MORE_MARGIN;
    wide: bool = more_wide();
    w: f64 = if (wide) if (room < MORE_WIDE_MOST) room else MORE_WIDE_MOST else if (room < MORE_NARROW_MOST) room else MORE_NARROW_MOST;
    // (Two columns: how it looks at the left, Listen and the Library at
    // the right; else one, Listen and the Library nearest ⋯, at its foot.)
    col: f64 = if (wide) (w - 3.0f64 * MORE_PAD) / 2.0f64 else w - 2.0f64 * MORE_PAD;
    looks_h: f64 = more_looks_make(MORE_PAD, MORE_PAD, col);
    keep_x: f64 = if (wide) 2.0f64 * MORE_PAD + col else MORE_PAD;
    keep_y: f64 = if (wide) MORE_PAD else MORE_PAD + looks_h + MORE_PART_GAP;
    keep_h: f64 = more_keeps_make(keep_x, keep_y, col);
    if (!wide) {
        rule: int = autoreleased(view_new());
        set_background(rule, colors.rule);
        set_frame4(rule, MORE_PAD, MORE_PAD + looks_h + MORE_PART_GAP / 2.0f64, col,
            1.0f64 / msg_f(msg(cls("UIScreen"), sel("mainScreen")), sel("scale")));
        add_sub(more.body, rule)
    }
    h: f64 = if (wide) MORE_PAD + (if (looks_h > keep_h) looks_h else keep_h) + MORE_PAD else keep_y + keep_h + MORE_PAD;
    more_place(w, h);
    if (more.shown) glass_tint(more.card, dock_tint())
}

// The row of the settings with action (and, past -1, argument; -1: none).
more_row(action: int, arg: int): int {
    for r in 0..ui.rows_n {
        if (ui.rows[r].action == action && (arg < 0 || ui.rows[r].arg == arg)) return r
    }
    -1
}

// A button of the panel's sending selector, tagged.
more_button(selector: str, tag: int): int {
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg1(b, sel("setTag:"), tag);
    msg3(b, sel("addTarget:action:forControlEvents:"), more.root, sel(selector), 64);
    b
}

// A well: a shape of the ink's faint wash on the glass (as Go To's rows).
more_well(
    view: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    corner: f64
) {
    set_frame4(view, x, y, w, h);
    set_background(view, colors.well);
    set_corners(view, corner);
    add_sub(more.body, view)
}

// ---- how the text looks ----
// The text's size (smaller, a slider of steps, larger) and the rest of
// the settings as a menu beside it; the themes; the fonts. Its height.
more_looks_make(x: f64, y: f64, w: f64): f64 {
    at: f64 = y;
    size: int = more_row(ACT_SIZE, -1);
    options: int = more_options_button();
    ow: f64 = if (options != 0) MORE_ROW_H else 0.0f64;
    if (size >= 0) {
        row: UiRow = ui.rows[size];
        smaller: int = more_button("vellumMoreStep:", size * ROW_TAG);
        button_symbol(smaller, "textformat.size.smaller", 15.0f64);
        msg1(smaller, sel("setAccessibilityLabel:"), nsstring("Smaller Text"));
        set_frame4(smaller, x - 8.0f64, at, 40.0f64, MORE_ROW_H);
        add_sub(more.body, smaller);
        larger: int = more_button("vellumMoreStep:", size * ROW_TAG + 1);
        button_symbol(larger, "textformat.size.larger", 21.0f64);
        msg1(larger, sel("setAccessibilityLabel:"), nsstring("Larger Text"));
        right: f64 = x + w - ow - (if (ow > 0.0f64) 10.0f64 else 0.0f64);
        set_frame4(larger, right - 36.0f64, at, 40.0f64, MORE_ROW_H);
        add_sub(more.body, larger);
        slider: int = autoreleased(make("UISlider"));
        msg_set_f32(slider, sel("setMinimumValue:"), row.lo as f32);
        msg_set_f32(slider, sel("setMaximumValue:"), row.hi as f32);
        msg_set_f32(slider, sel("setValue:"), row.value as f32);
        msg1(slider, sel("setMinimumTrackTintColor:"), colors.accent);
        msg1(slider, sel("setTag:"), size * ROW_TAG);
        msg1(slider, sel("setAccessibilityLabel:"), ui_text(row.title));
        msg3(slider, sel("addTarget:action:forControlEvents:"), more.root, sel("vellumMoreSlid:"),
            64 | 128);
        set_frame4(slider, x + 34.0f64, at, right - 36.0f64 - 6.0f64 - (x + 34.0f64),
            MORE_ROW_H);
        add_sub(more.body, slider)
    }
    if (options != 0) {
        more_well(options, x + w - MORE_ROW_H, at, MORE_ROW_H, MORE_ROW_H, MORE_ROW_H / 2.0f64);
        at = at + MORE_ROW_H + MORE_GAP
    } else if (size >= 0) at = at + MORE_ROW_H + MORE_GAP;
    theme: int = more_row(ACT_THEME, -1);
    if (theme >= 0) {
        more_themes_make(theme, x, at, w);
        at = at + MORE_ROW_H + MORE_GAP
    }
    first_font: int = more_row(ACT_FONT, -1);
    if (first_font >= 0) {
        more_fonts_make(first_font, x, at, w);
        at = at + MORE_ROW_H + MORE_GAP
    }
    at - MORE_GAP - y
}

// The themes: a circle each of its page, the chosen ringed in the accent;
// Auto its day's and its night's corner to corner.
more_themes_make(
    r: int,
    x: f64,
    y: f64,
    w: f64
) {
    row: UiRow = ui.rows[r];
    n: int = split_count(&ui, row.options);
    if (n == 0) return;
    step: f64 = if (n > 1) (w - MORE_SWATCH) / (n - 1) as f64 else 0.0f64;
    d: f64 = MORE_SWATCH;
    for j in 0..n {
        chosen: bool = j == row.value;
        theme: int = if (j == 0) auto_day else clamp_i(j, 0, THEMES_MOST - 1);
        page: int = theme_pages[theme];
        b: int = more_button("vellumMorePick:", r * ROW_TAG + j);
        set_frame4(b, x + step * j as f64, y + (MORE_ROW_H - d) / 2.0f64, d, d);
        set_background(b, if (page >= 0) rgb(page, 1.0f64) else colors.page);
        set_corners(b, d / 2.0f64);
        layer: int = msg(b, sel("layer"));
        msg_set_f(layer, sel("setBorderWidth:"), if (chosen) 2.5f64 else 1.0f64);
        msg1(layer, sel("setBorderColor:"), msg(if (chosen) colors.accent else colors.rule,
            sel("CGColor")));
        msg1(b, sel("setClipsToBounds:"), 1);
        if (j == 0) more_auto_split(layer, d);
        msg1(b, sel("setAccessibilityLabel:"), split_word(&ui, row.options, j));
        if (chosen) msg1(b, sel("setAccessibilityTraits:"), objc_const_int("UIAccessibilityTraitSelected"));
        add_sub(more.body, b)
    }
}

// Auto's circle: the day's page and the night's, split corner to corner.
more_auto_split(layer: int, d: f64) {
    auto_split(layer);
    subs: int = msg(layer, sel("sublayers"));
    if (subs != 0 && msg(subs, sel("count")) > 0) msg_rect(msg1(subs, sel("objectAtIndex:"),
        0), sel("setFrame:"), 0.0f64, 0.0f64, d, d)
}

// The fonts: Aa in each, the chosen in the accent on a well.
more_fonts_make(
    first: int,
    x: f64,
    y: f64,
    w: f64
) {
    n: int = 0;
    while (first + n < ui.rows_n && ui.rows[first + n].action == ACT_FONT) n = n + 1;
    cw: f64 = w / n as f64;
    for k in 0..n {
        r: int = first + k;
        row: UiRow = ui.rows[r];
        chosen: bool = row.acc == ACC_CHECK;
        b: int = more_button("vellumMorePick:", r * ROW_TAG);
        keys: []int = dict_keys;
        values: []int = dict_values;
        keys[0] = objc_const("NSFontAttributeName");
        values[0] = font_face_sample(row.arg, 21.0f64);
        keys[1] = objc_const("NSForegroundColorAttributeName");
        values[1] = (if (chosen) colors.accent else colors.ink);
        msg2(b, sel("setAttributedTitle:forState:"), autoreleased(msg2(msg(cls("NSAttributedString"),
            sel("alloc")), sel("initWithString:attributes:"), nsstring("Aa"), nsdictionary(keys,
            values, 2))), 0);
        msg1(b, sel("setAccessibilityLabel:"), ui_text(row.title));
        if (chosen) {
            msg1(b, sel("setAccessibilityTraits:"), objc_const_int("UIAccessibilityTraitSelected"));
            well: int = autoreleased(view_new());
            msg1(well, sel("setUserInteractionEnabled:"), 0);
            more_well(well, x + cw * k as f64 + 3.0f64, y, cw - 6.0f64, MORE_ROW_H,
                MORE_ROW_H / 2.0f64)
        }
        set_frame4(b, x + cw * k as f64, y, cw, MORE_ROW_H);
        add_sub(more.body, b)
    }
}

// The rest of the reading settings as one menu (a button of the slider's
// symbol): the settings' rows but those the panel shows itself, each
// section a group. 0 if there are none.
more_options_button(): int {
    groups: int = fresh("NSMutableArray");
    for k in 0..ui.sections_n {
        section: UiSection = ui.sections[k];
        kids: int = fresh("NSMutableArray");
        for r in section.first..section.first + section.n {
            item: int = more_option_item(r);
            if (item != 0) msg1(kids, sel("addObject:"), item)
        }
        if (msg(kids, sel("count")) > 0) msg1(groups, sel("addObject:"), msg5(cls("UIMenu"),
            sel("menuWithTitle:image:identifier:options:children:"), nsstring(""),
            0, 0, 1, kids))
    }
    if (msg(groups, sel("count")) == 0) return 0;
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    button_symbol(b, "slider.horizontal.3", 17.0f64);
    msg1(b, sel("setAccessibilityLabel:"), nsstring("More Settings"));
    msg1(b, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""),
        groups));
    msg1(b, sel("setShowsMenuAsPrimaryAction:"), 1);
    b
}

// Row r as an item of the menu (0: the panel shows it itself): a switch
// checked or not, a choice its options (the chosen checked, its name under
// it), a screen it opens.
more_option_item(r: int): int {
    row: UiRow = ui.rows[r];
    a: int = row.action;
    if (a == ACT_LIB_OPEN || a == ACT_SIZE || a == ACT_THEME || a == ACT_FONT || a == ACT_LISTEN || a == ACT_LISTEN_RATE) return 0;
    if (a == ACT_OPEN && row.arg == OPEN_VOICE) return 0;
    if (row.kind == UI_CHOICE) {
        kids: int = fresh("NSMutableArray");
        n: int = split_count(&ui, row.options);
        for k in 0..n {
            c: int = more_command(split_word(&ui, row.options, k), r * ROW_TAG + k);
            if (k == row.value) msg1(c, sel("setState:"), 1);
            msg1(kids, sel("addObject:"), c)
        }
        menu: int = msg5(cls("UIMenu"), sel("menuWithTitle:image:identifier:options:children:"),
            ui_text(row.title), 0, 0, 32, kids);
        if (responds(menu, "setSubtitle:")) msg1(menu, sel("setSubtitle:"), split_word(&ui,
            row.options, row.value));
        return menu
    }
    on: bool = row.on || row.value == 1;
    c: int = more_command(ui_text(row.title), r * ROW_TAG + (if (row.kind == UI_TOGGLE && !on) 1 else 0));
    if (row.kind == UI_TOGGLE && on) msg1(c, sel("setState:"), 1);
    if (row.kind == UI_ITEM && row.detail.n > 0 && responds(c, "setSubtitle:")) msg1(c,
        sel("setSubtitle:"), ui_text(row.detail));
    if (row.disabled || row.faint) msg1(c, sel("setAttributes:"), 1);
    c
}

// A command of the menu's: its title, and row * 16 + the value to act
// with (a choice's; a switch's to be), up the responder chain.
more_command(title: int, tag: int): int {
    msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"), title,
        0, sel("vellumMoreCommand:"), nsnumber_int(tag))
}

// ---- what is kept, and heard ----
// Listen (from the page's place, or stopping) and its speed, its voice in
// the speed's menu; the Library's collections, a tile each. Its height.
more_keeps_make(x: f64, y: f64, w: f64): f64 {
    at: f64 = y;
    listen: int = more_row(ACT_LISTEN, -1);
    rate: int = more_row(ACT_LISTEN_RATE, -1);
    if (listen >= 0) {
        row: UiRow = ui.rows[listen];
        chip_w: f64 = if (rate >= 0) 64.0f64 else 0.0f64;
        pill_w: f64 = w - chip_w - (if (chip_w > 0.0f64) 10.0f64 else 0.0f64);
        pill: int = more_button("vellumMoreListen:", listen * ROW_TAG);
        config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
        msg1(config, sel("setTitle:"), ui_text(row.title));
        glyph: int = symbol(if (row.on) "stop.fill" else "play.fill", 14.0f64, 6);
        if (glyph != 0 && !row.disabled) glyph = msg2(glyph, sel("imageWithTintColor:renderingMode:"),
            colors.accent, 1);
        msg1(config, sel("setImage:"), glyph);
        msg_set_f(config, sel("setImagePadding:"), 10.0f64);
        msg1(config, sel("setBaseForegroundColor:"), if (row.disabled) colors.faint else colors.ink);
        msg1(config, sel("setTitleLineBreakMode:"), 4);
        msg1(pill, sel("setConfiguration:"), config);
        msg1(pill, sel("setTintColor:"), colors.accent);
        if (row.disabled) msg1(pill, sel("setEnabled:"), 0);
        more_well(pill, x, at, pill_w, MORE_ROW_H, MORE_ROW_H / 2.0f64);
        if (rate >= 0) {
            chip: int = more_rate_button(rate);
            more_well(chip, x + w - chip_w, at, chip_w, MORE_ROW_H, MORE_ROW_H / 2.0f64)
        }
        at = at + MORE_ROW_H + MORE_GAP
    }
    first: int = more_row(ACT_LIB_OPEN, -1);
    if (first >= 0) {
        n: int = 0;
        while (first + n < ui.rows_n && ui.rows[first + n].action == ACT_LIB_OPEN) n = n + 1;
        gap: f64 = 8.0f64;
        tw: f64 = (w - gap * (n - 1) as f64) / n as f64;
        for k in 0..n more_tile_make(first + k, x + (tw + gap) * k as f64, at, tw);
        at = at + MORE_TILE_H + MORE_GAP
    }
    at - MORE_GAP - y
}

// The speed: a chip of it (1×), its menu the speeds and the voice.
more_rate_button(r: int): int {
    row: UiRow = ui.rows[r];
    kids: int = fresh("NSMutableArray");
    n: int = split_count(&ui, row.options);
    for k in 0..n {
        c: int = more_command(split_word(&ui, row.options, k), r * ROW_TAG + k);
        if (k == row.value) msg1(c, sel("setState:"), 1);
        msg1(kids, sel("addObject:"), c)
    }
    groups: int = fresh("NSMutableArray");
    msg1(groups, sel("addObject:"), msg5(cls("UIMenu"), sel("menuWithTitle:image:identifier:options:children:"),
        ui_text(row.title), 0, 0, 1 | 32, kids));
    voice: int = more_row(ACT_OPEN, OPEN_VOICE);
    if (voice >= 0) {
        v: UiRow = ui.rows[voice];
        c: int = more_command(ui_text(v.title), voice * ROW_TAG);
        if (v.detail.n > 0 && responds(c, "setSubtitle:")) msg1(c, sel("setSubtitle:"),
            ui_text(v.detail));
        if (v.faint) msg1(c, sel("setAttributes:"), 1);
        msg1(groups, sel("addObject:"), msg5(cls("UIMenu"), sel("menuWithTitle:image:identifier:options:children:"),
            nsstring(""), 0, 0, 1, one_command(c)))
    }
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg2(b, sel("setTitle:forState:"), if (row.detail.n > 0) ui_text(row.detail) else split_word(&ui,
        row.options, row.value), 0);
    msg2(b, sel("setTitleColor:forState:"), colors.ink, 0);
    msg1(msg(b, sel("titleLabel")), sel("setFont:"), font_rounded(15.0f64, 0.3f64));
    msg1(b, sel("setAccessibilityLabel:"), ui_text(row.title));
    msg1(b, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""),
        groups));
    msg1(b, sel("setShowsMenuAsPrimaryAction:"), 1);
    b
}

one_command(c: int): int {
    kids: int = fresh("NSMutableArray");
    msg1(kids, sel("addObject:"), c);
    kids
}

// A collection's tile: its symbol over its name; Learn's symbol in the
// accent while passages wait to be practised today.
more_tile_make(
    r: int,
    x: f64,
    y: f64,
    w: f64
) {
    row: UiRow = ui.rows[r];
    b: int = more_button("vellumMoreTile:", r * ROW_TAG);
    msg1(b, sel("setAccessibilityLabel:"), ui_text(row.title));
    if (row.detail.n > 0) msg1(b, sel("setAccessibilityValue:"), ui_text(row.detail));
    more_well(b, x, y, w, MORE_TILE_H, 18.0f64);
    due: bool = row.arg == 3 && row.detail.n > 0;
    glyph: int = autoreleased(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol_image(ui_text(row.icon), 19.0f64, 5)));
    msg1(glyph, sel("setTintColor:"), if (due) colors.accent else colors.ink);
    msg1(glyph, sel("setContentMode:"), 4);
    set_frame4(glyph, 0.0f64, 11.0f64, w, 24.0f64);
    msg1(glyph, sel("setUserInteractionEnabled:"), 0);
    add_sub(b, glyph);
    name: int = label_new(font_system(12.0f64, 0.0f64), colors.ink, 1);
    msg1(name, sel("setText:"), ui_text(row.title));
    msg1(name, sel("setTextAlignment:"), 1);
    msg1(name, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(name, sel("setMinimumScaleFactor:"), 0.8f64);
    set_frame4(name, 4.0f64, 38.0f64, w - 8.0f64, 16.0f64);
    msg1(name, sel("setUserInteractionEnabled:"), 0);
    add_sub(b, name)
}

// ---- touched ----
// Row r and the value of a control's tag (row * 16 + value), if the
// panel's screen is loaded and has it (-1: not).
more_tagged_row(tag: int): int {
    r: int = tag / ROW_TAG;
    if (more.slot < 0 || !screen_load(more.slot) || r >= ui.rows_n) return -1;
    r
}

more_backdrop_tapped(_self: int, _cmd: int, gesture: int): int {
    p: Rect = point_in(gesture, more.root);
    c: Rect = frame_of(more.card);
    if (p.x >= c.x && p.x < c.x + c.w && p.y >= c.y && p.y < c.y + c.h) return 0;
    more_close(true);
    0
}

more_stepped(_self: int, _cmd: int, b: int): int {
    tag: int = msg(b, sel("tag"));
    r: int = more_tagged_row(tag);
    if (r < 0) return 0;
    row: UiRow = ui.rows[r];
    value: int = row.value + (if (tag % ROW_TAG == 1) 1 else -1);
    if (value < row.lo || value > row.hi) return 0;
    haptic_tick();
    act(more.slot, row.action, row.arg, value);
    0
}

more_slid(_self: int, _cmd: int, slider: int): int {
    r: int = more_tagged_row(msg(slider, sel("tag")));
    if (r < 0) return 0;
    value: int = (msg_ret_f32(slider, sel("value")) as f64 + 0.5f64) as int;
    msg_set_f32(slider, sel("setValue:"), value as f32);
    if (value != ui.rows[r].value) act(more.slot, ui.rows[r].action, ui.rows[r].arg,
        value);
    0
}

// A theme's circle or a font's Aa.
more_picked(_self: int, _cmd: int, b: int): int {
    tag: int = msg(b, sel("tag"));
    r: int = more_tagged_row(tag);
    if (r < 0) return 0;
    haptic_tick();
    act(more.slot, ui.rows[r].action, ui.rows[r].arg, tag % ROW_TAG);
    0
}

// Listen: begun or stopped, the panel put away (the player rises in the
// dock).
more_listen_tapped(_self: int, _cmd: int, b: int): int {
    r: int = more_tagged_row(msg(b, sel("tag")));
    if (r < 0) return 0;
    s: int = more.slot;
    haptic_impact(0);
    act(s, ui.rows[r].action, ui.rows[r].arg, 0);
    more_close(true);
    0
}

// A collection: the Library at it, in place of the panel (core closes the
// settings as it opens it).
more_tile_tapped(_self: int, _cmd: int, b: int): int {
    r: int = more_tagged_row(msg(b, sel("tag")));
    if (r < 0) return 0;
    haptic_impact(0);
    act(more.slot, ui.rows[r].action, ui.rows[r].arg, 0);
    0
}

// A command of a menu's: its row's action with its value.
more_command_chosen(_self: int, _cmd: int, sender: int): int {
    if (sender == 0 || !responds(sender, "propertyList")) return 0;
    tag: int = msg(msg(sender, sel("propertyList")), sel("longValue"));
    r: int = more_tagged_row(tag);
    if (r < 0) return 0;
    act(more.slot, ui.rows[r].action, ui.rows[r].arg, tag % ROW_TAG);
    0
}

// The overlay's class: a view of the app's window's, the target of
// everything in it.
more_classes_make() {
    c: int = class_make(cls("UIView"), "VellumMoreView");
    add_method1(c, sel("vellumMoreBackdrop:"), &more_backdrop_tapped, "v@:@");
    add_method1(c, sel("vellumMoreStep:"), &more_stepped, "v@:@");
    add_method1(c, sel("vellumMoreSlid:"), &more_slid, "v@:@");
    add_method1(c, sel("vellumMorePick:"), &more_picked, "v@:@");
    add_method1(c, sel("vellumMoreListen:"), &more_listen_tapped, "v@:@");
    add_method1(c, sel("vellumMoreTile:"), &more_tile_tapped, "v@:@");
    add_method1(c, sel("vellumMoreCommand:"), &more_command_chosen, "v@:@")
}

// The old build's overlay let go of (hot reload): its globals are gone.
more_views_removed(view: int) {
    subs: int = msg(msg(view, sel("subviews")), sel("copy"));
    for i in 0..msg(subs, sel("count")) {
        v: int = msg1(subs, sel("objectAtIndex:"), i);
        if (is_kind(v, "VellumMoreView")) msg(v, sel("removeFromSuperview"))
    }
    release(subs)
}

// What `!state` says of it.
more_state() {
    if (!more_open()) return;
    words_begin();
    words_add("vellum: more panel screen ");
    words_add_int(if (more.slot >= 0) slots[more.slot].id else -1);
    words_add(" rest ");
    words_add_int(more.rest.x as int);
    words_add(" ");
    words_add_int(more.rest.y as int);
    words_add(" ");
    words_add_int(more.rest.w as int);
    words_add(" ");
    words_add_int(more.rest.h as int);
    words_add(if (more.below) " below" else " above");
    note_ns(words_ns())
}

// ---- a screen it opens ----
// A screen it opens (Voice, the Manual, the Acknowledgements): a sheet of
// its own over it, as from anywhere.
more_sheet_over(s: int) {
    nav: int = nav_new(slot_controller(s));
    sheet_dress(nav, slots[s].kind);
    sheet_nav = held(sheet_nav, nav);
    msg3(top_controller(), sel("presentViewController:animated:completion:"), nav,
        1, 0);
    dock_along(nav, true)
}

// That sheet put away, the panel again: its screens said closed when the
// reader closed them (not when core popped them).
more_sheet_away(said: bool) {
    if (sheet_nav == 0) return;
    if (!said) sheet_mark_closing(msg(sheet_nav, sel("viewControllers")));
    presenter: int = msg(sheet_nav, sel("presentingViewController"));
    if (presenter != 0) {
        msg2(presenter, sel("dismissViewControllerAnimated:completion:"), 1, 0);
        dock_along(sheet_nav, false)
    }
    sheet_nav = held(sheet_nav, 0);
    screens_forget_gone_soon()
}

// `!tap WORDS` while it shows: its first row whose title begins with WORDS
// acted on as its control would (whether there was one).
more_wire_tap(b: []i8, from: int, to: int): bool {
    s: int = more.slot;
    if (!more_open() || s < 0 || !screen_load(s)) return false;
    want: int = nsstring_of_range(b, from, to);
    for r in 0..ui.rows_n {
        title: int = ui_text(ui.rows[r].title);
        if (title != 0 && truth(msg1(title, sel("hasPrefix:"), want))) {
            row: UiRow = ui.rows[r];
            act(s, row.action, row.arg, if (row.kind == UI_TOGGLE) if (row.on || row.value == 1) 0 else 1 else row.value);
            return true
        }
    }
    false
}
