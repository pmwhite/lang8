tag bible_ios;

use_tag std, ios, bible;

// The demo's §17 steps (DESIGN.md §17.8.2), on the 13-inch iPad of the
// `ipad` group: the reader in portrait, rotated (the verse kept), at an
// accessibility size; the tray; Go To, Search, Library, Compare, Study,
// Practice, a card, the Greek page, a preview, the note editor and the
// manual as form sheets, Reading settings as a popover from Aa (Night seen
// live), the share popover; the day's reader, the back capsule and the mini
// player at the column's corners and middle; the keys (⌘L through its
// action) and the menu bar's commands (logged); the narrow window's
// stand-in (the window 375 points wide, centred, compact); and Study beside
// the text (shots 492 to 503): opened from the tray, a tile's word study in
// it, what is known hidden, a verse selected, the page scrolled on, Show in
// Text, References, portrait, the stand-in at 900 points and back, the
// day's reader, and closed by ⌥⌘I. Then the recordings' sequences 22 and 23.
// In the `read` group, on an iPhone: 490 and 491, held sideways.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/plans.l8";

// The iPad (or iPhone) turned: landscape, or portrait (iOS 16's geometry
// request; no error handler).
d17_rotate(landscape: bool) {
    scene: int = msg(window, sel("windowScene"));
    if (scene == 0 || cls("UIWindowSceneGeometryPreferencesIOS") == 0) return;
    if (responds(root_vc, "setNeedsUpdateOfSupportedInterfaceOrientations")) msg(root_vc,
        sel("setNeedsUpdateOfSupportedInterfaceOrientations"));
    prefs: int = msg(msg1(msg(cls("UIWindowSceneGeometryPreferencesIOS"), sel("alloc")),
        sel("initWithInterfaceOrientations:"), if (landscape) 8 else 2), sel("autorelease"));
    msg2(scene, sel("requestGeometryUpdateWithPreferences:errorHandler:"), prefs,
        0);
    note(if (landscape) "bible: demo rotate landscape" else "bible: demo rotate portrait")
}

// The narrow window's stand-in (§17.8.2): the window w points wide, centred
// in the screen (compact below 600 points, through the scene's trait
// overrides, iOS 17); 0, the whole screen again.
d17_narrow_w: f64 = 0.0f64;

d17_narrow(w: f64) {
    scene: int = msg(window, sel("windowScene"));
    if (scene == 0) return;
    l8_msg_hfa(hfa, msg(scene, sel("coordinateSpace")), sel("bounds"), 0, 0, 0);
    W: f64 = hfa[2];
    H: f64 = hfa[3];
    d17_narrow_w = w;
    over: int = if (responds(scene, "traitOverrides")) msg(scene, sel("traitOverrides")) else 0;
    if (w <= 0.0f64) {
        if (over != 0) msg1(over, sel("removeTrait:"), cls("UITraitHorizontalSizeClass"));
        msg_rect(window, sel("setFrame:"), 0.0f64, 0.0f64, W, H)
    } else {
        if (over != 0 && w < 600.0f64) msg1(over, sel("setHorizontalSizeClass:"),
            1);
        msg_rect(window, sel("setFrame:"), (W - w) / 2.0f64, 0.0f64, w, H)
    }
    msg(window, sel("layoutIfNeeded"));
    root_relayout();
    note_num("bible: demo narrow window ", w as int);
    note_num("bible:   wide ", if (wide()) 1 else 0)
}

// The column now, in the log: "bible: column 646 pt, 34.0 em, page 1366".
d17_column() {
    float_measure();
    fbuf_n = 0;
    fput_str("bible: column ");
    fput_int((fl_r - fl_l) as int);
    fput_str(" pt, ");
    tenths: int = ((fl_r - fl_l) * 10.0f64 / em) as int;
    fput_int(tenths / 10);
    fput(46);
    fput_int(tenths % 10);
    fput_str(" em, page ");
    fput_int(fl_pw as int);
    fput_str(", wide ");
    fput_int(if (wide()) 1 else 0);
    note_ns(fstring())
}

// Everything put away: sheets, the tray, a day, Listen, the stand-in.
d17_clear() {
    demo_dismiss();
    clear_selection();
    if (day_on) day_close(false);
    listen_stop();
    hide_back()
}

// The Practice of Philippians 4:6–7 (or the first passage).
d17_practice() {
    i: int = d8_find("PHP", 4, 6);
    if (i < 0 && mq_n > 0) i = 0;
    if (i >= 0) practice_open_one(i)
}

// The menu bar's commands, in the log (§17.8.2's 479).
d17_menu_log() {
    keys_make();
    fbuf_n = 0;
    fput_str("bible: demo menu Go: ");
    menu_log(key_go, 6);
    fput_str("; View: ");
    menu_log(key_view, 3);
    note_ns(fstring())
}

demo_do17(t: int) {
    if (t == 520) {
        // 460: John 3:16 at the top, portrait.
        d17_clear();
        if (text_cur != TEXT_BSB) switch_version(TEXT_BSB);
        go_place(john3(), 16, 0);
        d17_column()
    }
    if (t == 521) {
        // 461: turned to landscape (the script's, through Simulator: an iPad
        // that supports multitasking can't be turned by its app): the same
        // verse at the top.
        d17_column()
    }
    if (t == 522) {
        // 462: at an accessibility size (the script's): the column wider.
        d17_column()
    }
    if (t == 523) {
        // 463: the tray over the column.
        toggle_verse(john3(), 16)
    }
    if (t == 524) {
        // 464: Go To.
        clear_selection();
        open_picker()
    }
    if (t == 525) show_chapters(42);
    if (t == 526) {
        // 466: Search, its field active.
        demo_dismiss();
        demo_later_at(0.6f64, 1001)
    }
    if (t == 527) {
        // 467: Reading settings, a popover from Aa.
        demo_dismiss();
        demo_later_at(0.6f64, 1002)
    }
    if (t == 528) {
        // 468: Night, seen live beside it.
        set_theme = 4;
        settings_changed(true)
    }
    if (t == 566) {
        // 468b: Black, the popover dark too (review s17-1, Major).
        set_theme = 5;
        settings_changed(true)
    }
    if (t == 529) {
        // 469: Study as a form sheet (beside it, off for these shots).
        set_theme = 0;
        settings_changed(true);
        demo_dismiss();
        bs_demo_off = true;
        set_def_int("interlinearOrder", 0);
        demo_later_at(0.6f64, 1003)
    }
    if (t == 530) {
        // 470: ἀγαπάω's word study.
        tile_tapped(0, 0, tile_views[d10_tile(25)])
    }
    if (t == 531) {
        // 471: Compare.
        demo_dismiss();
        demo_later_at(0.6f64, 1004)
    }
    if (t == 532) {
        // 472: the Library on Memory.
        demo_dismiss();
        set_def_int("librarySegment", 3);
        demo_later_do(1)
    }
    if (t == 533) {
        // 473: Practice at Letters.
        demo_dismiss();
        demo_later_at(0.6f64, 1005)
    }
    if (t == 534) {
        // 474: a Greek card (120 Greek words known).
        practice_close(true);
        demo_later_at(0.8f64, 1006)
    }
    if (t == 535) {
        // 475: the Greek page, from the Library's Memory.
        practice_close(true);
        demo_dismiss();
        set_def_int("librarySegment", 3);
        demo_later_at(0.8f64, 1007)
    }
    if (t == 536) {
        // 476: a plan's day, full screen, Mark Read at the column's corner.
        demo_dismiss();
        d16_seed();
        day_open_today()
    }
    if (t == 537) {
        // 477: the back capsule at the column's corner after a jump.
        day_close(false);
        go_place(john3(), 16, 0);
        jump(psalm23(), 0)
    }
    if (t == 538) {
        // 478: the mini player, centred under the column.
        hide_back();
        listen_start(john3(), 16)
    }
    if (t == 539) {
        // 479: the menu bar's commands (logged).
        listen_stop();
        d17_menu_log()
    }
    if (t == 540) {
        // 480: ⌘L, through its command's action: Go To, its field active.
        _r: int = key_go_to(0, 0, 0)
    }
    if (t == 541) {
        // 481: the narrow window: the iPhone's layout, Go To a page sheet.
        demo_dismiss();
        d17_narrow(375.0f64);
        d17_column();
        demo_later_at(0.8f64, 1008)
    }
    if (t == 542) {
        // 482: the tray at the iPhone's width.
        demo_dismiss();
        toggle_verse(john3(), 16)
    }
    if (t == 543) {
        // 483: the window whole again; Practice in landscape.
        clear_selection();
        d17_narrow(0.0f64);
        demo_later_at(0.8f64, 1005)
    }
    if (t == 544) {
        // 484: a preview (Romans 8:28) as a form sheet.
        practice_close(true);
        demo_later_at(0.8f64, 1009)
    }
    if (t == 545) {
        // 485: the manual's "With a keyboard", in Reading settings' popover.
        demo_dismiss();
        demo_later_at(0.6f64, 1010)
    }
    if (t == 546) {
        // 486: Night, landscape.
        demo_dismiss();
        set_theme = 4;
        settings_changed(true);
        go_place(john3(), 16, 0)
    }
    if (t == 547) {
        // 487: Sepia at an accessibility size (the script's).
        set_theme = 3;
        settings_changed(true);
        d17_column()
    }
    if (t == 548) {
        // 488: the note editor.
        set_theme = 0;
        settings_changed(true);
        go_place(john3(), 16, 0);
        note_force_edit = true;
        open_note(john3(), 16, 16)
    }
    if (t == 549) {
        // 489: the share popover from the tray's Share.
        note_done(0, 0, 0);
        demo_dismiss();
        demo_later_at(0.6f64, 1011)
    }
    // ---- Study beside the text: 492 to 503 ----
    if (t == 550) {
        // 492: John 3:16 selected, the tray's Study: the panel.
        demo_dismiss();
        clear_selection();
        bs_demo_off = false;
        set_def_int("interlinearOrder", 0);
        demo_later_at(0.6f64, 1012)
    }
    if (t == 551) {
        // 493: a tile tapped: its word study pushed in the panel.
        tile_tapped(0, 0, tile_views[d10_tile(25)])
    }
    if (t == 552) {
        // 494: 120 Greek words known, Greek Order: known English hidden.
        if (bs_nav != 0) msg1(bs_nav, sel("popToRootViewControllerAnimated:"), 0);
        demo_learn_known(0, 120);
        set_def_bool("learnHideKnown", true);
        set_def_int("interlinearOrder", 1);
        beside_show_verse(bs_c, bs_v, false)
    }
    if (t == 553) {
        // 495: 3:17 selected in the page: the panel shows it.
        set_def_int("interlinearOrder", 0);
        toggle_verse(john3(), 16);
        toggle_verse(john3(), 17)
    }
    if (t == 554) {
        // 496: the page scrolled on to John 4: the panel stays.
        clear_selection();
        go_top(john3() + 1)
    }
    if (t == 555) {
        // 497: Show in Text: the page back at 3:17, flashed; the capsule.
        _r: int = beside_show_in_text(0, 0, 0)
    }
    if (t == 556) {
        // 498: References.
        if (sv_seg != 0) {
            msg1(sv_seg, sel("setSelectedSegmentIndex:"), 1);
            _r: int = study_segment(0, 0, sv_seg)
        }
    }
    if (t == 557) {
        // 499: portrait: still beside, the column narrowed; Words, and
        // θεός's word study pushed in the panel (500 hides it, 501 brings it
        // back with its stack: review s17-1, Minor 2).
        hide_back();
        d17_column();
        if (sv_seg != 0) {
            msg1(sv_seg, sel("setSelectedSegmentIndex:"), 0);
            _r: int = study_segment(0, 0, sv_seg)
        }
        demo_later_at(0.4f64, 1019)
    }
    if (t == 558) {
        // 500: the stand-in at 900 points: the panel gone.
        d17_narrow(900.0f64);
        d17_column()
    }
    if (t == 559) {
        // 501: whole again: the panel back, as it was.
        d17_narrow(0.0f64);
        d17_column()
    }
    if (t == 560) {
        // 502: landscape again, a plan's day with Study beside it.
        demo_later_at(0.3f64, 1014)
    }
    if (t == 561) {
        // 503: ⌥⌘I: closed, the verse at the top kept.
        day_close(false);
        go_place(john3(), 16, 0);
        demo_later_at(0.6f64, 1015)
    }
    if (t == 565) {
        // The recording's setup: everything put away, John 3:16 at the top.
        d17_clear();
        if (bs_open) beside_close();
        go_place(john3(), 16, 0)
    }
    if (t == 562) {
        // Recording sequence 22, after the script's turns (portrait,
        // landscape, portrait at John 3:16): Go To opened and closed; the
        // settings popover, Night and back.
        demo_later_at(0.1f64, 1023)
    }
    if (t == 563) {
        // Recording sequence 23's setup (landscape, the script's): John 3:14
        // at the top.
        d17_clear();
        if (bs_open) beside_close();
        demo_later_at(0.3f64, 1040)
    }
    if (t == 564) {
        // Recording sequence 23: Study beside opened, a tile, 3:17, the page
        // scrolled, the stand-in and back, closed.
        demo_later_at(0.1f64, 1041)
    }
    // ---- an iPhone held sideways (the read group): 490, 491 ----
    if (t == 590) {
        // (John 3:16 at the top, once more when the rows around it are laid
        // out; then turned.)
        d17_clear();
        go_place(john3(), 16, 0);
        demo_later_at(0.5f64, 1061)
    }
    if (t == 591) toggle_verse(john3(), 16);
    if (t == 592) {
        clear_selection();
        d17_rotate(false)
    }
}

// What opens a sheet waits until no sheet is left going away (a present
// over one being dismissed is refused: run 39536990908's 474).
d17_tries: int = 0;

d17_opens(d: int): bool {
    d >= 1001 && d <= 1012 || d == 1014 || d == 1023 || d == 1025 || d == 1041
}

demo_later17(d: int) {
    if (d17_opens(d) && presented() != 0 && d17_tries < 30) {
        d17_tries = d17_tries + 1;
        demo_later_at(0.2f64, d);
        return
    }
    d17_tries = 0;
    if (d == 1000) {
        d17_column();
        // (The window's width logged with the place kept: width_relayout.)
        return
    }
    if (d == 1001) {
        open_search();
        uk_search_for(nsstring("born again"));
        return
    }
    if (d == 1002) {
        open_settings();
        return
    }
    if (d == 1003) {
        open_interlinear(john3(), 16);
        return
    }
    if (d == 1004) {
        compare_verses[0] = 16;
        open_compare(john3(), compare_verses, 1);
        return
    }
    if (d == 1005) {
        d17_practice();
        px_set_level(LV_LETTERS);
        return
    }
    if (d == 1006) {
        demo_learn_known(0, 120);
        k: int = card_of_word(0, 3004);
        if (k < 0) k = learn_add_word(0, 3004, FROM_KNOWN, today(), time(0));
        d10_practice_card(k);
        return
    }
    if (d == 1007) {
        open_library();
        demo_later_at(0.8f64, 1016);
        return
    }
    if (d == 1016) {
        open_language(0);
        return
    }
    if (d == 1008) {
        open_picker();
        return
    }
    if (d == 1009) {
        xr_book = book_coded("ROM");
        xr_c = 8;
        xr_v = 28;
        xr_ce = 0;
        xr_ve = 0;
        open_preview(xref_both());
        return
    }
    if (d == 1010) {
        open_settings();
        demo_later_at(0.8f64, 1017);
        return
    }
    if (d == 1017) {
        help_open_manual();
        demo_later_at(0.8f64, 1018);
        return
    }
    if (d == 1018) {
        help_open_page(d15_page("reading#keys"), d15_part("reading#keys"), true);
        return
    }
    if (d == 1011) {
        toggle_verse(john3(), 16);
        tray_action(0, 0, tray_actions[1]);
        return
    }
    if (d == 1012) {
        go_place(john3(), 14, 0);
        toggle_verse(john3(), 16);
        tray_action(0, 0, tray_actions[4]);
        d17_column();
        return
    }
    if (d == 1019) {
        if (il_scroll != 0) tile_tapped(0, 0, tile_views[d10_tile(2316)]);
        return
    }
    if (d == 1014) {
        d16_seed();
        day_open_today();
        return
    }
    if (d == 1015) {
        _r: int = key_study(0, 0, 0);
        d17_column();
        return
    }
    // ---- sequence 22 ----
    if (d == 1023) {
        open_picker();
        demo_later_at(2.0f64, 1024);
        return
    }
    if (d == 1024) {
        dismiss_sheets();
        demo_later_at(1.5f64, 1025);
        return
    }
    if (d == 1025) {
        open_settings();
        demo_later_at(1.5f64, 1026);
        return
    }
    if (d == 1026) {
        set_theme = 4;
        settings_changed(true);
        demo_later_at(1.5f64, 1027);
        return
    }
    if (d == 1027) {
        set_theme = 0;
        settings_changed(true);
        demo_later_at(1.5f64, 1028);
        return
    }
    if (d == 1028) {
        dismiss_sheets();
        note("bible: demo sequence 22 done");
        return
    }
    // ---- sequence 23 ----
    if (d == 1040) {
        go_place(john3(), 14, 0);
        d17_column();
        return
    }
    if (d == 1041) {
        toggle_verse(john3(), 16);
        demo_later_at(1.2f64, 1042);
        return
    }
    if (d == 1042) {
        tray_action(0, 0, tray_actions[4]);
        demo_later_at(2.0f64, 1043);
        return
    }
    if (d == 1043) {
        tile_tapped(0, 0, tile_views[d10_tile(25)]);
        demo_later_at(2.0f64, 1044);
        return
    }
    if (d == 1044) {
        toggle_verse(john3(), 16);
        toggle_verse(john3(), 17);
        demo_later_at(2.0f64, 1045);
        return
    }
    if (d == 1045) {
        clear_selection();
        set_offset_animated(offset_y(table) + 500.0f64);
        demo_later_at(2.0f64, 1046);
        return
    }
    if (d == 1046) {
        d17_narrow(900.0f64);
        demo_later_at(2.0f64, 1047);
        return
    }
    if (d == 1047) {
        d17_narrow(0.0f64);
        demo_later_at(2.0f64, 1048);
        return
    }
    if (d == 1048) {
        beside_close();
        note("bible: demo sequence 23 done");
        return
    }
    if (d == 1060) {
        d17_column();
        return
    }
    if (d == 1061) {
        go_place(john3(), 16, 0);
        d17_rotate(true);
        demo_later_at(1.5f64, 1060);
        return
    }
}
