tag bible_ios;

use_tag std, ios, bible;

// The ESV, online (DESIGN.md ยง9.4): its chapters asked of our own server
// (smoothbible.com/api/v1/, worker/worker.js, which holds the ESV API's
// key), kept by esv_cache.l8's rules (Library/Caches/SmoothBible/esv/),
// made into text 5 (text.l8), and the reader's states while a chapter is
// not here: its opener, a quiet spinner under it, and, if it cannot come,
// a calm line in the reader's own type with what can be done.
//
// The ESV is listed (in Versions, Compare, Search) only once the server has
// said, to a cheap status request, that it can give it (the owner's rule,
// 2026-10-18): asked quietly at most once a day, and when the reading
// settings open; the answer kept. Until then it is not offered at all.
//
// No blocks: the session's delegate is a class made here (L8Net), on the
// main queue, given each task's data and its end.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/esv_cache.l8";

ESV_BASE: str = "https://smoothbible.com/api/v1/";

extern getenv_address(name: str): int = getenv;

// ---- whether the ESV is offered ----
// Disable requests explicitly for a manual demo with L8_ESV_OFF.
esv_off_checked: bool = false;

esv_off_on: bool = false;

esv_off(): bool {
    if (!esv_off_checked) {
        esv_off_checked = true;
        p: int = getenv_address("L8_ESV_OFF");
        esv_off_on = p != 0 && strlen(p) > 0;
        if (esv_off_on) note("bible: esv server off")
    }
    esv_off_on
}

// Whether our server said it can provide the ESV.
esv_listed(): bool {
    def_bool("esvAvailable")
}

// The server asked whether it gives the ESV: if forced (the reading
// settings opening), or else if a day has passed since it was last asked.
esv_check(forced: bool) {
    if (esv_off()) return;
    now: int = time(0);
    if (!forced && now - def_int("esvChecked") < 86400) return;
    if (esv_status_task != 0) return;
    set_def_int("esvChecked", now);
    esv_status_task = net_get("status", NET_STATUS, -1, 0)
}

esv_status_task: int = 0;

// The server's answer kept; and in the Versions and Acknowledgements lists
// on screen, the ESV's section fading in or out (ยง0 principle 6), the
// others untouched; one popped (off the window) reloaded whole, which lays
// out nothing (review r7-1, Minor 6).
esv_set_listed(on: bool) {
    was: bool = def_bool("esvAvailable");
    set_def_bool("esvAvailable", on);
    if (on == was) return;
    for t in [versions_table, ack_table] {
        if (t != 0 && !on_window(t, if (t == ack_table) "Acknowledgements, the ESV listed" else "Versions, the ESV listed")) msg(t,
            sel("reloadData")) else if (t != 0) {
            set: int = msg1(cls("NSIndexSet"), sel("indexSetWithIndex:"), if (t == ack_table) ACK_ESV else 1);
            msg2(t, sel(if (on) "insertSections:withRowAnimation:" else "deleteSections:withRowAnimation:"),
                set, 0)
        }
    }
}

// ---- the session ----
NET_CHAPTERS: int = 0;

NET_SEARCH: int = 1;

NET_STATUS: int = 2;

NET_AUDIO: int = 3;

net_class: int = 0;

net_session: int = 0;

// The tasks running: each one's data so far, what it asks, and of what.
NET_MOST: int = 8;

net_task: []int = new int[8](0);

net_data: []int = new int[8](0);

net_kind: []int = new int[8](0);

net_c: []int = new int[8](0);

net_count: []int = new int[8](0);

session(): int {
    if (net_session != 0) return net_session;
    config: int = msg(cls("NSURLSessionConfiguration"), sel("ephemeralSessionConfiguration"));
    msg_set_f(config, sel("setTimeoutIntervalForRequest:"), 12.0f64);
    msg1(config, sel("setRequestCachePolicy:"), 1);
    msg1(config, sel("setURLCache:"), 0);
    delegate: int = msg(make_net_delegate(), sel("autorelease"));
    net_session = keep(msg3(cls("NSURLSession"), sel("sessionWithConfiguration:delegate:delegateQueue:"),
        config, delegate, msg(cls("NSOperationQueue"), sel("mainQueue"))));
    net_session
}

make_net_delegate(): int {
    msg(msg(net_class, sel("alloc")), sel("init"))
}

// A GET of path (under the base) begun: its task (0 if none could be).
net_get(
    path: str,
    kind: int,
    c: int,
    count: int
): int {
    net_get_ns(nsstring(path), kind, c, count)
}

net_get_ns(
    path: int,
    kind: int,
    c: int,
    count: int
): int {
    if (esv_off()) return 0;
    slot: int = -1;
    for i in 0..NET_MOST
        if (net_task[i] == 0 && slot < 0) slot = i;
    if (slot < 0) return 0;
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), msg1(nsstring(ESV_BASE),
        sel("stringByAppendingString:"), path));
    if (url == 0) return 0;
    req: int = msg1(cls("NSMutableURLRequest"), sel("requestWithURL:"), url);
    info: int = msg(msg(cls("NSBundle"), sel("mainBundle")), sel("infoDictionary"));
    v: int = msg1(info, sel("objectForKey:"), nsstring("CFBundleShortVersionString"));
    b: int = msg1(info, sel("objectForKey:"), nsstring("CFBundleVersion"));
    head: int = msg1(msg1(msg1(if (v != 0) v else nsstring("1.0"), sel("stringByAppendingString:"),
        nsstring(" (")), sel("stringByAppendingString:"), if (b != 0) b else nsstring("1")),
        sel("stringByAppendingString:"), nsstring(")"));
    msg2(req, sel("setValue:forHTTPHeaderField:"), head, nsstring("X-Smooth-Bible"));
    task: int = msg1(session(), sel("dataTaskWithRequest:"), req);
    if (task == 0) return 0;
    net_task[slot] = keep(task);
    net_data[slot] = make("NSMutableData");
    net_kind[slot] = kind;
    net_c[slot] = c;
    net_count[slot] = count;
    msg(task, sel("resume"));
    task
}

net_slot(task: int): int {
    for i in 0..NET_MOST
        if (net_task[i] == task && task != 0) return i;
    -1
}

net_received(
    _self: int,
    _cmd: int,
    _session: int,
    task: int,
    data: int
): int {
    i: int = net_slot(task);
    if (i >= 0) msg1(net_data[i], sel("appendData:"), data);
    0
}

// A task's end: its status and its JSON, to what asked.
net_completed(
    _self: int,
    _cmd: int,
    _session: int,
    task: int,
    error: int
): int {
    i: int = net_slot(task);
    // (Not one of these: a recording's download, ios/audio.l8.)
    if (i < 0) {
        dl_completed(task, error);
        return 0
    }
    kind: int = net_kind[i];
    c: int = net_c[i];
    count: int = net_count[i];
    data: int = net_data[i];
    status: int = if (error == 0) msg(msg(task, sel("response")), sel("statusCode")) else 0;
    json: int = if (error == 0) msg3(cls("NSJSONSerialization"), sel("JSONObjectWithData:options:error:"),
        data, 0, 0) else 0;
    net_task[i] = 0;
    net_data[i] = 0;
    // (The answer handled before the task and its data are let go.)
    net_answer(kind, c, count, status, json);
    release(data);
    release(task);
    0
}

// An answer: status 0 for no answer (no connection, or no answer in time).
net_answer(
    kind: int,
    c: int,
    count: int,
    status: int,
    json: int
) {
    if (kind == NET_STATUS) {
        esv_status_task = 0;
        if (status == 200 && json != 0) {
            ok: int = msg1(json, sel("objectForKey:"), nsstring("esv"));
            on: bool = ok != 0 && (msg(ok, sel("boolValue")) & 255) != 0;
            // (The ESV's recording too, once the Worker says so: ยง12.6.)
            au: int = msg1(json, sel("objectForKey:"), nsstring("esvAudio"));
            set_def_bool("esvAudioAvailable", au != 0 && (msg(au, sel("boolValue")) & 255) != 0);
            esv_set_listed(on)
        } else if (status != 0 && status != 429 && status < 500) esv_set_listed(false);
        return
    }
    if (kind == NET_AUDIO) {
        esv_audio_answered(c, status, json);
        return
    }
    state: int = esv_state_of(status, json);
    if (kind == NET_SEARCH) {
        esv_search_answered(state, json);
        return
    }
    esv_inflight = -1;
    if (state == ESV_HERE) esv_take(json) else esv_failed(c, count, state, esv_retry_of(json));
    esv_next()
}

// ---- states ----
ESV_HERE: int = 0;

ESV_LOADING: int = 1;

ESV_OFFLINE: int = 2;

ESV_BUSY: int = 3;

ESV_DAILY: int = 4;

ESV_UNAVAILABLE: int = 5;

// Each chapter's state, while it is not here.
esv_state: []int = new int[1200](0);

// When each began loading (for the spinner's 0.4 s).
esv_since: []f64 = new f64[1200](0.0f64);

// Not to ask again before this (busy, resting for today).
esv_hold_until: f64 = 0.0f64;

esv_state_of(status: int, json: int): int {
    if (status == 200) return ESV_HERE;
    if (status == 0) return ESV_OFFLINE;
    if (status == 429) return ESV_BUSY;
    if (status == 503 && json != 0) {
        e: int = msg1(json, sel("objectForKey:"), nsstring("error"));
        if (e != 0 && (msg1(e, sel("isEqualToString:"), nsstring("daily_limit")) & 255) != 0) return ESV_DAILY
    }
    if (status == 504) return ESV_OFFLINE;
    ESV_UNAVAILABLE
}

esv_retry_of(json: int): int {
    if (json == 0) return 0;
    r: int = msg1(json, sel("objectForKey:"), nsstring("retry"));
    if (r == 0) 0 else msg(r, sel("longValue"))
}

// ---- the cache, on disk ----
esv_dir_ns: int = 0;

esv_dir(): int {
    if (esv_dir_ns != 0) return esv_dir_ns;
    dirs: int = NSSearchPathForDirectoriesInDomains(13, 1, 1);
    base: int = msg(dirs, sel("firstObject"));
    if (base == 0) base = NSHomeDirectory();
    esv_dir_ns = keep(msg1(msg1(base, sel("stringByAppendingPathComponent:"), nsstring("SmoothBible")),
        sel("stringByAppendingPathComponent:"), nsstring("esv")));
    msg4(msg(cls("NSFileManager"), sel("defaultManager")), sel("createDirectoryAtPath:withIntermediateDirectories:attributes:error:"),
        esv_dir_ns, 1, 0, 0);
    esv_dir_ns
}

// The file of chapter c (JHN-3.txt).
esv_file(c: int): int {
    fbuf_n = 0;
    for x in 0..3 fput(bsb_code_byte(ch_book[c], x));
    fput(45);
    fput_int(ch_num[c]);
    fput_str(".txt");
    msg1(esv_dir(), sel("stringByAppendingPathComponent:"), fstring())
}

esv_buf: []i8 = new i8[262144](0i8);

esv_opened: bool = false;

// The ESV made a text: what is on disk held again (by index.tsv, a
// chapter whose file is missing left out), then text 5 made of it.
esv_open() {
    if (!esv_opened) {
        esv_opened = true;
        data: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), msg1(esv_dir(),
            sel("stringByAppendingPathComponent:"), nsstring("index.tsv")));
        fbuf_n = 0;
        if (data != 0) {
            n: int = msg(data, sel("length"));
            if (n > len(fbuf)) n = len(fbuf);
            if (n > 0) memcpy_from(fbuf, msg(data, sel("bytes")), n);
            fbuf_n = n
        }
        parse_esv_index();
        for i in 0..ix_n {
            c: int = ix_c[i];
            d: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), esv_file(c));
            if (d != 0) {
                n: int = msg(d, sel("length"));
                if (n > len(esv_buf)) n = len(esv_buf);
                if (n > 0) memcpy_from(esv_buf, msg(d, sel("bytes")), n);
                esv_restore(c, esv_buf, n, ix_fetched[i], ix_used[i])
            }
        }
        esv_save()
    }
    esv_build()
}

// What is held written: each chapter on disk its file (those let go
// deleted), and the index.
esv_save() {
    fm: int = msg(cls("NSFileManager"), sel("defaultManager"));
    for i in 0..ec_gone_n {
        if (esv_find(ec_gone[i]) < 0) msg2(fm, sel("removeItemAtPath:error:"), esv_file(ec_gone[i]),
            0)
    }
    ec_gone_n = 0;
    format_esv_index();
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    msg2(data, sel("writeToFile:atomically:"), msg1(esv_dir(), sel("stringByAppendingPathComponent:"),
        nsstring("index.tsv")), 1)
}

esv_write_chapter(c: int) {
    i: int = esv_find(c);
    if (i < 0 || !ec_disk[i]) return;
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(ec_pool) + ec_at[i],
        ec_len[i]);
    msg2(data, sel("writeToFile:atomically:"), esv_file(c), 1)
}

esv_log() {
    if (!diag_on) return;
    format_esv_summary();
    try {
        write_bytes_n(2, fbuf, fbuf_n)
    } with IoError _e -> { }
}

// ---- asking for chapters: one request at a time ----
// The request running (its chapter, -1: none), and the one waiting (a
// newer one replaces it).
esv_inflight: int = -1;

esv_queued: int = -1;

esv_queued_count: int = 1;

// The notice the server sent with the text ("(ESV)").
esv_notice: int = 0;

// Chapter c wanted (and count chapters from it): asked for, or queued.
// (Chapters asked for Memory's pins alone: not for the reader.)
esv_pin_only: []bool = new bool[1200](false);

esv_want(c: int, count: int) {
    if (c < 0 || c >= chapters) return;
    // (The reader wants it too now: held as any other.)
    esv_pin_only[c] = false;
    if (!esv_wanted(c, time(0)) && (count < 2 || c + 1 >= chapters || !esv_wanted(c + 1,
        time(0)))) return;
    if (esv_inflight == c) return;
    if (CACurrentMediaTime() < esv_hold_until) return;
    if (esv_inflight >= 0) {
        // (The one it replaces is no longer on its way.)
        if (esv_queued >= 0 && esv_queued != c && esv_state[esv_queued] == ESV_LOADING) esv_state[esv_queued] = 0;
        esv_queued = c;
        esv_queued_count = count;
        esv_mark_loading(c);
        return
    }
    esv_ask(c, count)
}

esv_mark_loading(c: int) {
    if (esv_state[c] != ESV_LOADING) {
        esv_state[c] = ESV_LOADING;
        esv_since[c] = CACurrentMediaTime()
    }
}

esv_ask(c: int, count: int) {
    esv_inflight = c;
    esv_mark_loading(c);
    // (Its start, for the client's own limit; and the BSB's heights of what
    // is asked measured now, off the fling, for its placeholders.)
    esv_req_t[esv_req_i % len(esv_req_t)] = CACurrentMediaTime();
    esv_req_i = esv_req_i + 1;
    note_num("bible: esv asked ", c * 10 + count);
    if (text_cur == TEXT_ESV && table != 0) {
        for x in c..c + count
            if (x < chapters) _h: f64 = esv_bsb_height(x)
    }
    fbuf_n = 0;
    fput_str("esv/chapters?book=");
    for x in 0..3 fput(bsb_code_byte(ch_book[c], x));
    fput_str("&chapter=");
    fput_int(ch_num[c]);
    fput_str("&count=");
    fput_int(count);
    if (net_get_ns(fstring(), NET_CHAPTERS, c, count) == 0) {
        esv_inflight = -1;
        esv_failed(c, count, ESV_OFFLINE, 0)
    }
}

// The next request: one asked for directly (Compare, a preview, Listen,
// Try Again), or else the reader's next (esv_pump).
esv_next() {
    if (esv_inflight >= 0) return;
    if (esv_queued < 0) {
        esv_pump();
        return
    }
    c: int = esv_queued;
    esv_queued = -1;
    esv_ask(c, esv_queued_count)
}

// ---- the reader's window (DESIGN.md ยง9.4.11) ----
// The landing chapter (where a glide will rest, or the reader is): the
// chapters wanted are L - 1 to L + 2, asked for L, L + 1, L + 2, then
// L - 1, one request at a time, the newest window always winning.
esv_win_l: int = -1;

// The starts of the last 20 requests: past 20 in 60 s, only a chapter on
// the screen is asked for.
esv_req_t: []f64 = new f64[20](-1000.0f64);

esv_req_i: int = 0;

esv_rate_ok(): bool {
    oldest: f64 = esv_req_t[esv_req_i % len(esv_req_t)];
    CACurrentMediaTime() - oldest >= 60.0f64
}

esv_window(l: int) {
    if (text_cur != TEXT_ESV || l < 0 || l >= chapters) return;
    esv_win_l = l;
    esv_pump()
}

// Whether chapter c is the reader's to ask for now: wanted, not on its way
// or failed, and, if it is not on the screen, small enough and with room
// to be held ahead, within the client's limit.
esv_askable(c: int, on_screen: bool): bool {
    if (c < 0 || c >= chapters || !esv_wanted(c, time(0)) || c == esv_inflight) return false;
    st: int = esv_state[c];
    if (st >= ESV_OFFLINE) return false;
    if (on_screen) return true;
    !esv_too_big(c) && esv_rate_ok() && esv_room_for(c)
}

// The client idle: the reader's next chapter asked for (a placeholder on
// the screen first, then the window's).
esv_pump() {
    if (esv_inflight >= 0 || text_cur != TEXT_ESV || table == 0) return;
    if (CACurrentMediaTime() < esv_hold_until) return;
    // (A plan's day: its passages' chapters, those on the screen first.)
    if (day_on && day_esv_pump()) return;
    esv_visible_rows();
    note_num("bible: esv pump, on screen from ", ec_vis_lo);
    note_num("bible:   to ", ec_vis_hi);
    note_num("bible:   window at ", esv_win_l);
    // (The chapter being read, first.)
    if (cur >= 0 && esv_askable(cur, true)) {
        esv_ask(cur, if (esv_askable(cur + 1, true)) 2 else 1);
        return
    }
    if (ec_vis_lo >= 0) {
        for c in ec_vis_lo..ec_vis_hi + 1 {
            if (esv_askable(c, true)) {
                esv_ask(c, if (esv_askable(c + 1, c + 1 <= ec_vis_hi || c + 1 == esv_win_l || c + 1 == esv_win_l + 1)) 2 else 1);
                return
            }
        }
    }
    l: int = esv_win_l;
    if (l < 0) return;
    for d in [0, 1, 2, -1] {
        c: int = l + d;
        if (esv_askable(c, false)) {
            esv_ask(c, if (d >= 0 && d < 2 && esv_askable(c + 1, false)) 2 else 1);
            return
        }
    }
}

// ---- chapters come ----
esv_ch_buf: []i8 = new i8[262144](0i8);

// The chapters of a 200 answer held, kept on disk, text 5 made again, and
// each one's arrival told to what waits for it.
esv_take(json: int) {
    list: int = msg1(json, sel("objectForKey:"), nsstring("chapters"));
    note_ns: int = msg1(json, sel("objectForKey:"), nsstring("notice"));
    if (note_ns != 0) {
        release(esv_notice);
        esv_notice = keep(note_ns)
    }
    if (list == 0) return;
    // (What the reader shows now, so that a chapter it shows is kept.)
    esv_visible_rows();
    got: []int = esv_got;
    got_n: int = 0;
    now: int = time(0);
    for i in 0..msg(list, sel("count")) {
        ch: int = msg1(list, sel("objectAtIndex:"), i);
        book: int = msg1(ch, sel("objectForKey:"), nsstring("book"));
        num: int = msg(msg1(ch, sel("objectForKey:"), nsstring("chapter")), sel("longValue"));
        records: int = msg1(ch, sel("objectForKey:"), nsstring("records"));
        b: int = esv_book_of(book);
        if (b >= 0 && records != 0 && num >= 1 && num <= book_count[b]) {
            c: int = book_first[b] + num - 1;
            n: int = nsstring_into(records, esv_ch_buf);
            if (n < len(esv_ch_buf)) {
                esv_ch_buf[n] = 10i8;
                n = n + 1
            }
            // (Memory's pinned verses of it kept first: DESIGN.md ยง13.6. A
            // chapter asked for the pins alone goes no further: held once.)
            memory_esv_came(c, esv_ch_buf, n);
            if (esv_pin_only[c]) {
                esv_pin_only[c] = false;
                if (esv_state[c] == ESV_LOADING) esv_state[c] = 0
            } else {
                esv_insert(c, esv_ch_buf, n, now);
                esv_touch(c, now);
                esv_write_chapter(c);
                esv_state[c] = ESV_HERE
            }
            if (got_n < len(got)) {
                got[got_n] = c;
                got_n = got_n + 1
            }
        }
    }
    esv_save();
    esv_build();
    esv_log();
    for i in 0..got_n esv_arrived(got[i])
}

esv_got: []int = new int[4](0);

// The book whose code is ns (JHN), or -1.
esv_book_of(ns: int): int {
    n: int = nsstring_into(ns, esv_code);
    if (n != 3) return -1;
    for b in 0..books {
        same: bool = true;
        for x in 0..3
            if (bsb_code_byte(b, x) != esv_code[x] as int) same = false;
        if (same) return b
    }
    -1
}

esv_code: []i8 = new i8[8](0i8);

// A request failed: its chapters' state, the hold if the server is busy or
// resting, and the reader's line where its text would be.
esv_failed(
    c: int,
    count: int,
    state: int,
    retry: int
) {
    note_num("bible: esv failed, state ", state);
    for x in c..c + count {
        if (x < chapters && !esv_held(x)) esv_state[x] = state
    }
    if (state == ESV_BUSY || state == ESV_DAILY) esv_hold_until = CACurrentMediaTime() + (if (retry > 0) retry as f64 else 60.0f64);
    esv_show_state(c);
    compare_esv_failed(state);
    preview_esv_failed(c, state);
    listen_esv_failed(c);
    esv_retry_timer()
}

// ---- the reader ----
// Where the reader waits for a chapter: the place a switch to the ESV was
// at (esv_wait_c), and the verse a jump went to (esv_jump_c).
esv_wait_c: int = -1;

esv_wait_v: int = 0;

esv_wait_f: int = 0;

esv_jump_c: int = -1;

esv_jump_v: int = 0;

// What the reader in the ESV wants now: the chapter at its top, and the
// one after it (two at once, if neither is held), or the one before it
// when it has been scrolled up into.
esv_reader_wants() {
    if (text_cur != TEXT_ESV) return;
    esv_visible_now();
    if (cur < 0 || cur >= chapters) return;
    esv_window(cur)
}

// The rows on the screen, told to the cache, nothing let go yet.
esv_visible_rows() {
    if (table == 0 || text_cur != TEXT_ESV) return;
    if (day_on) {
        day_visible_chapters();
        return
    }
    paths: int = msg(table, sel("indexPathsForVisibleRows"));
    if (paths == 0) return;
    lo: int = -1;
    hi: int = -1;
    for i in 0..msg(paths, sel("count")) {
        r: int = msg(msg1(paths, sel("objectAtIndex:"), i), sel("row"));
        if (lo < 0 || r < lo) lo = r;
        if (r > hi) hi = r
    }
    ec_vis_lo = lo;
    ec_vis_hi = hi
}

// The rows on the screen, told to the cache (what it may not let go), each
// one's use now.
esv_visible_now() {
    paths: int = msg(table, sel("indexPathsForVisibleRows"));
    lo: int = -1;
    hi: int = -1;
    t: int = time(0);
    if (paths != 0) {
        for i in 0..msg(paths, sel("count")) {
            // (A day's rows: their chapters, which need not be in a row.)
            r: int = row_chapter(msg(msg1(paths, sel("objectAtIndex:"), i), sel("row")));
            if (day_on && r >= 0) esv_touch(r, t);
            if (r >= 0 && (lo < 0 || r < lo)) lo = r;
            if (r > hi) hi = r
        }
    }
    if (lo >= 0 && !day_on) {
        for c in lo..hi + 1 esv_touch(c, t)
    }
    was: int = ec_n;
    esv_set_visible(lo, hi);
    if (ec_n != was) {
        esv_save();
        esv_build();
        esv_log()
    }
}

// A placeholder row being shown (chapter c): asked for, if it is not on its
// way.
esv_row_shown(c: int) {
    if (text_cur != TEXT_ESV || esv_held(c)) return;
    if (esv_state[c] == ESV_HERE) esv_state[c] = 0;
    if (esv_state[c] == ESV_LOADING && c != esv_inflight && c != esv_queued) esv_state[c] = 0;
    if (!esv_seen[c]) {
        esv_seen[c] = true;
        note_num("bible: esv row visible ", c)
    }
    if (esv_state[c] == 0) esv_pump()
}

// Which placeholders have been on the screen (the demo's log of when).
esv_seen: []bool = new bool[1200](false);

// Chapter c's text came (DESIGN.md ยง9.4.11): what waits for it told; and
// in the reader, its row swapped in without touching the scroll: below
// what is seen, nothing; on the screen at or below the reading line, its
// text in place (its height taken with no animation while the table moves,
// the system's at rest); above that line, or above the screen, only at
// rest, the place kept (esv_rest).
esv_pending_n: int = 0;

esv_pending: []int = new int[16](0);

esv_refresh_due: bool = false;

esv_pend(c: int) {
    for i in 0..esv_pending_n
        if (esv_pending[i] == c) return;
    if (esv_pending_n < len(esv_pending)) {
        esv_pending[esv_pending_n] = c;
        esv_pending_n = esv_pending_n + 1
    }
}

esv_arrived(c: int) {
    compare_esv_arrived(c);
    preview_esv_arrived(c);
    listen_esv_arrived(c);
    if (text_cur != TEXT_ESV || table == 0) return;
    // (A plan's day: its rows of the chapter made again, the place kept, at
    // rest.)
    if (day_on) {
        if (day_row_first(c) < 0) return;
        if (reader_moving()) esv_refresh_due = true else day_esv_reload();
        esv_visible_now();
        return
    }
    moving: bool = reader_moving();
    tv: int = view_of(c);
    top: f64 = offset_y(table) + top_inset(table);
    above: bool = row_y(c) < top;
    note_num("bible: esv arrived ", c);
    note_num("bible:   moving ", if (moving) 1 else 0);
    note_num("bible:   visible ", if (tv != 0) 1 else 0);
    note_num("bible:   above ", if (above) 1 else 0);
    waited: bool = esv_wait_c == c || esv_jump_c == c;
    if (tv != 0 && !above && !waited) {
        // On the screen, below the reading line: in place.
        esv_fill(c, tv, !moving)
    } else if (moving) {
        // (Above the reading line, or above the screen: at rest.)
        if (tv != 0 || above) esv_pend(c)
    } else if (tv != 0 || waited) {
        measure_place();
        pc: int = cur;
        pv: int = place_v;
        pf: int = place_frac;
        before: f64 = esv_fixed_line(c);
        if (tv != 0) esv_fill(c, tv, false);
        msg(table, sel("layoutIfNeeded"));
        if (esv_wait_c == c) {
            esv_wait_c = -1;
            go_place(c, esv_wait_v, esv_wait_f)
        } else if (esv_jump_c == c) {
            esv_jump_c = -1;
            go_verse(c, esv_jump_v);
            flash(c, esv_jump_v)
        } else go_place(pc, pv, pf);
        note_num("bible: esv fixed line before ", before as int);
        note_num("bible: esv fixed line after ", esv_fixed_line(c) as int)
    } else if (above) esv_pend(c);
    if (moving) esv_refresh_due = true else esv_refresh_others(c);
    esv_visible_now()
}

// Row c's text set where it is (a 0.2 s cross-fade), and its height taken:
// with the system's animation (at rest, below the reading line) or none.
esv_fill(c: int, tv: int, animated: bool) {
    l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), chapter_path(c), 0, 0);
    h0: f64 = hfa[3];
    fade_layer(msg(tv, sel("layer")), 0.2f64);
    msg1(tv, sel("setAttributedText:"), chapter_text(c));
    esv_dress(tv, c);
    if (!animated) msg1(cls("UIView"), sel("setAnimationsEnabled:"), 0);
    msg(table, sel("beginUpdates"));
    msg(table, sel("endUpdates"));
    // (Without animation the update laid out now, not under the next
    // frame's scroll: CI's glide once lost a frame's step to it.)
    if (!animated) msg(table, sel("layoutIfNeeded"));
    if (!animated) msg1(cls("UIView"), sel("setAnimationsEnabled:"), 1);
    l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), chapter_path(c), 0, 0);
    h1: f64 = hfa[3];
    esv_learn(c);
    note_num("bible: esv row ", c);
    note_num("bible:   placeholder ", h0 as int);
    note_num("bible:   filled ", h1 as int)
}

// The reader at rest: the rows that came while it moved swapped in, once,
// the place kept; the others' text given again; the window's next asked.
// (Once at a time: its own update and jump can bring the reader to rest
// again, as CI's log showed, and a second pass inside the first measured
// the place before the first's jump; review r5-1.)
esv_in_rest: bool = false;

esv_rest() {
    if (text_cur != TEXT_ESV || table == 0 || esv_in_rest) return;
    if (day_on) {
        if (esv_refresh_due) {
            esv_refresh_due = false;
            day_esv_reload()
        }
        return
    }
    esv_in_rest = true;
    if (esv_pending_n > 0) {
        note_num("bible: esv rest pending ", esv_pending_n);
        for i in 0..esv_pending_n note_num("bible:   pending ", esv_pending[i]);
        measure_place();
        pc: int = cur;
        pv: int = place_v;
        pf: int = place_frac;
        // (In a placeholder, with no verse to keep, the line kept is its
        // row's top: its opener's place in the text that has not come
        // means nothing.)
        before: f64 = if (pv == 0) row_y(pc) - offset_y(table) - top_inset(table) else esv_fixed_line(esv_pending[0]);
        msg1(cls("UIView"), sel("setAnimationsEnabled:"), 0);
        for i in 0..esv_pending_n {
            c: int = esv_pending[i];
            tv: int = view_of(c);
            if (tv != 0) {
                fade_layer(msg(tv, sel("layer")), 0.2f64);
                msg1(tv, sel("setAttributedText:"), chapter_text(c));
                esv_dress(tv, c);
                esv_learn(c)
            }
        }
        msg(table, sel("beginUpdates"));
        msg(table, sel("endUpdates"));
        msg1(cls("UIView"), sel("setAnimationsEnabled:"), 1);
        msg(table, sel("layoutIfNeeded"));
        go_place(pc, pv, pf);
        after: f64 = if (pv == 0) row_y(pc) - offset_y(table) - top_inset(table) else esv_fixed_line(esv_pending[0]);
        note_num("bible: esv fixed line before ", before as int);
        note_num("bible: esv fixed line after ", after as int);
        esv_pending_n = 0
    }
    if (esv_refresh_due) {
        esv_refresh_due = false;
        esv_refresh_others(-1)
    }
    esv_in_rest = false
}

// The ESV's height against the BSB's, learned at each fill (below the
// opener and without the footer): their mean, kept, within 0.9 to 1.1.
esv_learn(c: int) {
    if (esv_h[c] <= 0.0f64 || esv_open_h[c] <= 0.0f64) return;
    bsb_text: f64 = esv_h[c] - esv_open_h[c];
    if (bsb_text < 100.0f64) return;
    esv_text: f64 = esv_height_of(chapter_text(c)) - esv_open_h[c] - esv_footer_h();
    compute_ranges(c);
    r: f64 = esv_text / bsb_text;
    if (r < 0.5f64 || r > 2.0f64) return;
    n: int = def_int("esvRatioN");
    mean: f64 = esv_ratio();
    mean = (mean * n as f64 + r) / (n + 1) as f64;
    set_def_int("esvRatioN", n + 1);
    set_def_int("esvRatio", (mean * 10000.0f64) as int)
}

esv_ratio(): f64 {
    k: int = def_int("esvRatio");
    r: f64 = if (k <= 0) 1.0f64 else k as f64 / 10000.0f64;
    if (r < 0.9f64) 0.9f64 else if (r > 1.1f64) 1.1f64 else r
}

// The footer's height ("(ESV) ยท esv.org" and its space), measured once a
// size and width.
esv_footer_key: f64 = 0.0f64;

esv_footer_height: f64 = 0.0f64;

esv_footer_h(): f64 {
    key: f64 = em * 10000.0f64 + view_width(table);
    if (key == esv_footer_key) return esv_footer_height;
    esv_footer_key = key;
    a: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    esv_put(a, nsstring("x"), em, c_ink, 0, 0.0f64);
    h0: f64 = esv_height_of(a);
    esv_footer(a);
    esv_footer_height = esv_height_of(a) - h0;
    esv_footer_height
}

// The other ESV rows on the screen given their text again (the same
// words: text 5 was made again, and a footnote's mark says where its note is
// in it).
esv_refresh_others(c: int) {
    if (table == 0 || day_on) return;
    paths: int = msg(table, sel("indexPathsForVisibleRows"));
    if (paths == 0) return;
    for i in 0..msg(paths, sel("count")) {
        r: int = msg(msg1(paths, sel("objectAtIndex:"), i), sel("row"));
        tv: int = if (r != c && ch_start[r] >= 0) view_of(r) else 0;
        if (tv != 0) msg1(tv, sel("setAttributedText:"), chapter_text(r))
    }
}

// Where a line on the screen is (the demo's check that nothing moved): the
// top of chapter c's row, the one coming (its divider), if it is on the
// screen, else the opener of the chapter at the top; from the screen's top.
esv_fixed_line(c: int): f64 {
    rendering: *ReaderRendering = active_rendering();
    // (From the reading line, the bar's bottom: the same, whatever the
    // bar's height does after.)
    top: f64 = offset_y(table) + top_inset(table);
    y: f64 = row_y(c) - offset_y(table);
    if (c != cur && y >= 0.0f64 && y < view_height(table)) return row_y(c) - top;
    tv: int = view_of(cur);
    if (tv == 0 || !range_rect(tv, rendering.openers[cur], 1)) return 0.0f64;
    h: f64 = hfa[1];
    row_y(cur) + h - top
}

// A chapter's state changed while it is not here: its row's line or
// spinner, cross-fading.
esv_show_state(c: int) {
    if (text_cur != TEXT_ESV) return;
    tv: int = view_of(c);
    if (tv == 0) return;
    fade_layer(msg(tv, sel("layer")), 0.2f64);
    msg1(tv, sel("setAttributedText:"), chapter_text(c));
    esv_dress(tv, c)
}

// ---- a row not here yet: its opener, the spinner, the line ----
SPINNER_TAG: int = 4242;

// The spinner over text view tv of chapter c: there (48 pt under the
// opener) while it loads, fading in only after 0.4 s; gone otherwise.
esv_dress(tv: int, c: int) {
    sp: int = msg1(tv, sel("viewWithTag:"), SPINNER_TAG);
    esv_actions(tv, c);
    loading: bool = text_cur == TEXT_ESV && ch_start[c] < 0 && (esv_state[c] == ESV_LOADING || esv_state[c] == 0);
    if (!loading) {
        if (sp != 0) msg(sp, sel("removeFromSuperview"));
        return
    }
    if (sp == 0) {
        sp = msg1(msg(cls("UIActivityIndicatorView"), sel("alloc")), sel("initWithActivityIndicatorStyle:"),
            100);
        msg1(sp, sel("setTag:"), SPINNER_TAG);
        msg1(sp, sel("setColor:"), c_faint);
        msg(sp, sel("startAnimating"));
        msg_set_f(sp, sel("setAlpha:"), 0.0f64);
        msg1(tv, sel("addSubview:"), sp);
        release(sp)
    }
    msg1(sp, sel("setColor:"), c_faint);
    // (Under the opener: its height as set, under the row's top inset,
    // and 48 pt, less the numeral's own space after it.)
    y: f64 = (if (day_on) day_row_gap(chapter_row(c)) else if (c == 0) top_gap() else em * 2.4f64) + esv_open_h[c] + 48.0f64 - em * 0.9f64;
    // (Centered on the row's width, the table's: a new row's text view is
    // not yet as wide as the row it is laid out in.)
    w: f64 = view_width(table);
    msg_rect(sp, sel("setFrame:"), w / 2.0f64 - 10.0f64, y, 20.0f64, 20.0f64);
    if (CACurrentMediaTime() - esv_since[c] >= 0.4f64) msg_set_f(sp, sel("setAlpha:"),
        1.0f64) else _t: int = after(0.4f64 - (CACurrentMediaTime() - esv_since[c]) + 0.01f64,
        "esvSpinner:")
}

// An ESV chapter's row, to VoiceOver: "Open esv.org" among its actions
// (its line's link is a tap target in the text, not a link it can reach).
esv_actions(tv: int, c: int) {
    if (text_cur != TEXT_ESV || ch_start[c] < 0) {
        msg1(tv, sel("setAccessibilityCustomActions:"), 0);
        return
    }
    a: int = msg3(msg(cls("UIAccessibilityCustomAction"), sel("alloc")), sel("initWithName:target:selector:"),
        nsstring("Open esv.org"), app_obj, sel("esvOpenSite:"));
    one[0] = a;
    msg1(tv, sel("setAccessibilityCustomActions:"), nsarray(one, 1));
    release(a)
}

// The action done: esv.org at the chapter whose row has it.
esv_open_site(_self: int, _cmd: int, action: int): int {
    paths: int = msg(table, sel("indexPathsForVisibleRows"));
    if (paths == 0) return 0;
    for i in 0..msg(paths, sel("count")) {
        c: int = msg(msg1(paths, sel("objectAtIndex:"), i), sel("row"));
        tv: int = view_of(c);
        acts: int = if (tv != 0) msg(tv, sel("accessibilityCustomActions")) else 0;
        if (acts != 0 && msg(acts, sel("count")) > 0 && msg(acts, sel("firstObject")) == action) {
            esv_site(c);
            return 1
        }
    }
    0
}

// The spinners due, faded in (0.2 s).
esv_spinner(_self: int, _cmd: int, _timer: int): int {
    if (table == 0) return 0;
    paths: int = msg(table, sel("indexPathsForVisibleRows"));
    if (paths == 0) return 0;
    for i in 0..msg(paths, sel("count")) {
        c: int = msg(msg1(paths, sel("objectAtIndex:"), i), sel("row"));
        tv: int = view_of(c);
        sp: int = if (tv != 0) msg1(tv, sel("viewWithTag:"), SPINNER_TAG) else 0;
        if (sp != 0 && msg_f(sp, sel("alpha")) < 0.5f64 && CACurrentMediaTime() - esv_since[c] >= 0.39f64) {
            msg_set_f(sp, sel("setAlpha:"), 1.0f64);
            animate(msg(sp, sel("layer")), "opacity", 0.0f64, 1.0f64, false, 0.2f64)
        }
    }
    0
}

// What a tap on the ESV's own words does (a value of k_esv): try again,
// read in the BSB, or esv.org.
k_esv: str = "L8ESV";

ESV_TRY: int = 1;

ESV_BSB: int = 2;

ESV_SITE: int = 3;

ESV_VERSION: int = 4;

esv_tapped(c: int, what: int) {
    if (what == ESV_TRY) {
        esv_state[c] = 0;
        esv_hold_until = 0.0f64;
        esv_want(c, 1);
        esv_show_state(c)
    } else if (what == ESV_BSB) switch_version(TEXT_BSB) else if (what == ESV_SITE) esv_site(c) else if (what == ESV_VERSION) {
        open_settings();
        _t: int = after(0.5f64, "dayVersions:")
    }
}

// esv.org's page of chapter c (John+3), in Safari's own view.
esv_site(c: int) {
    fbuf_n = 0;
    fput_str("https://www.esv.org/");
    b: int = ch_book[c];
    if (book_is(b, "PSA")) fput_str("Psalm") else {
        for i in book_name_start(b)..book_name_end(b) {
            k: int = bsb[i] as int;
            fput(if (k == 32) 43 else k)
        }
    }
    if (book_count[b] > 1) {
        fput(43);
        fput_int(ch_num[c])
    }
    fput(47);
    open_web_ns(fstring())
}

// A page (its address an NSString) in Safari's own view, over everything.
open_web_ns(address: int) {
    u: int = msg1(cls("NSURL"), sel("URLWithString:"), address);
    if (cls("SFSafariViewController") == 0) _h: int = dlopen("/System/Library/Frameworks/SafariServices.framework/SafariServices",
        1);
    sf: int = cls("SFSafariViewController");
    if (sf == 0 || u == 0) return;
    vc: int = msg1(msg(sf, sel("alloc")), sel("initWithURL:"), u);
    top: int = top_presented();
    msg3(if (top != 0) top else nav, sel("presentViewController:animated:completion:"),
        vc, 1, 0);
    release(vc)
}

// The attributes of the ESV's lines: size, color, centered, a tap's value.
esv_attrs(
    size: f64,
    color: int,
    what: int,
    before: f64
): int {
    keys[0] = k_font;
    values[0] = body(size);
    keys[1] = k_color;
    values[1] = color;
    p: int = msg(para_style(1, 0.0f64, 0.0f64, before, 0.0f64, 1.35f64), sel("autorelease"));
    keys[2] = k_para;
    values[2] = p;
    n: int = 3;
    if (what > 0) {
        keys[3] = nsstring(k_esv);
        values[3] = nsnumber_int(what);
        n = 4
    }
    nsdictionary(keys, values, n)
}

esv_put(
    s: int,
    text: int,
    size: f64,
    color: int,
    what: int,
    before: f64
) {
    msg1(s, sel("appendAttributedString:"), attributed_str(text, esv_attrs(size, color,
        what, before)))
}

// The line ending an ESV chapter (and every ESV page): "(ESV) ยท esv.org",
// the notice faint, the link accent.
esv_footer(s: int) {
    size: f64 = em * 0.7f64;
    esv_put(s, nsstring("\n"), size, c_faint, 0, 0.0f64);
    // (24 pt above it.)
    k: int = msg(s, sel("length"));
    esv_put(s, if (esv_notice != 0) esv_notice else nsstring("(ESV)"), size, c_faint,
        0, 24.0f64);
    esv_put(s, nsstring(" \ย\ท "), size, c_faint, 0, 24.0f64);
    esv_put(s, nsstring("esv.org"), size, c_accent, ESV_SITE, 24.0f64);
    _k: int = k
}

// The rest of a row not here: under its opener, the state's line (if the
// chapter cannot come now), then space to the BSB's height of the same
// chapter, so the scroll is believable before the text comes.
esv_open_h: []f64 = new f64[1200](0.0f64);

esv_placeholder(s: int, c: int) {
    esv_open_h[c] = esv_height_of(s);
    st: int = esv_state[c];
    size: f64 = em * 0.9f64;
    if (st >= ESV_OFFLINE) {
        msg1(s, sel("appendAttributedString:"), attributed_str(nsstring("\n"), esv_attrs(size,
            c_faint, 0, 0.0f64)));
        line: str = if (st == ESV_OFFLINE && day_on) "This passage needs a connection in the ESV." else if (st == ESV_OFFLINE) "The ESV needs an internet connection." else if (st == ESV_BUSY) "Many people are reading the ESV just now. It will try again in a minute." else if (st == ESV_DAILY) "The ESV has reached its daily limit for Smooth Bible. It will be back tomorrow." else "The ESV isn\โ\€\t available right now.";
        esv_put(s, nsstring(line), size, c_faint, 0, 36.0f64);
        esv_put(s, nsstring("\n"), size, c_faint, 0, 0.0f64);
        if (st == ESV_OFFLINE || st == ESV_UNAVAILABLE) {
            esv_put(s, nsstring("Try Again"), size, c_accent, ESV_TRY, 8.0f64);
            esv_put(s, nsstring(" \ย\ท "), size, c_faint, 0, 8.0f64)
        }
        // (In a plan's day: Change Version, Reading settings' versions.)
        if (day_on) esv_put(s, nsstring("Change Version"), size, c_accent, ESV_VERSION,
            8.0f64) else esv_put(s, nsstring("Read in the BSB"), size, c_accent, ESV_BSB,
            8.0f64)
    }
    // (The space: one invisible line, as tall as the rest of the BSB's
    // chapter.)
    // (The BSB's text below the opener, scaled by what the ESV's has been
    // to it, and the footer the filled row will have: the fill changes the
    // row by a few lines at most.)
    bsb_h: f64 = esv_bsb_height(c);
    pad: f64 = (bsb_h - esv_open_h[c]) * esv_ratio() + esv_footer_h() - (esv_height_of(s) - esv_open_h[c]);
    if (pad < 96.0f64) pad = 96.0f64;
    p: int = msg(para_style(1, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.0f64), sel("autorelease"));
    msg_set_f(p, sel("setMinimumLineHeight:"), pad);
    msg_set_f(p, sel("setMaximumLineHeight:"), pad);
    keys[0] = k_font;
    values[0] = body(em);
    keys[1] = k_para;
    values[1] = p;
    msg1(s, sel("appendAttributedString:"), attributed_str(ustr(10, 8203), nsdictionary(keys,
        values, 2)))
}

// The height of an attributed string as the reader would set it (a
// label's, at the text's width).
esv_label: int = 0;

esv_height_of(s: int): f64 {
    if (esv_label == 0) {
        esv_label = make("UILabel");
        msg1(esv_label, sel("setNumberOfLines:"), 0)
    }
    msg1(esv_label, sel("setAttributedText:"), s);
    w: f64 = view_width(table) - 2.0f64 * side_margin();
    if (w < 100.0f64) w = 300.0f64;
    label_size(esv_label, w);
    hfa[1]
}

// The BSB's chapter c, set: its height (kept, for the look and the width
// it was measured at).
esv_h: []f64 = new f64[1200](0.0f64);

esv_h_key: f64 = 0.0f64;

esv_bsb_height(c: int): f64 {
    key: f64 = em * 10000.0f64 + view_width(table);
    if (key != esv_h_key) {
        esv_h_key = key;
        for i in 0..len(esv_h) esv_h[i] = 0.0f64
    }
    if (esv_h[c] > 0.0f64) return esv_h[c];
    was: int = text_cur;
    text_use(TEXT_BSB);
    s: int = chapter_text(c);
    text_use(was);
    esv_h[c] = esv_height_of(s);
    // (The ranges measured again, for the chapter as it is shown.)
    compute_ranges(c);
    esv_h[c]
}

// ---- trying again ----
esv_timer: int = 0;

// Every 30 s while a row that could not come is on the screen (one timer):
// asked again.
esv_retry_timer() {
    if (esv_timer != 0) return;
    esv_timer = after(30.0f64, "esvRetry:")
}

esv_retry(_self: int, _cmd: int, _timer: int): int {
    esv_timer = 0;
    if (text_cur != TEXT_ESV || table == 0) return 0;
    any: bool = false;
    paths: int = msg(table, sel("indexPathsForVisibleRows"));
    if (paths != 0) {
        for i in 0..msg(paths, sel("count")) {
            c: int = msg(msg1(paths, sel("objectAtIndex:"), i), sel("row"));
            st: int = esv_state[c];
            if (!esv_held(c) && (st == ESV_OFFLINE || st == ESV_UNAVAILABLE || (st == ESV_BUSY || st == ESV_DAILY) && CACurrentMediaTime() >= esv_hold_until)) {
                any = true;
                esv_want(c, 1)
            }
        }
    }
    if (any) esv_retry_timer();
    0
}

// The app active again: what could not come, asked again.
esv_app_active() {
    esv_check(false);
    // (Memory's ESV verses fetched if missing or older than 30 days.)
    memory_esv_refresh();
    if (text_cur == TEXT_ESV && table != 0) esv_retry(0, 0, 0)
}

// ---- the ESV searched (ยง9.4.8): one request a tap ----
esv_search(q: int, page: int) {
    allowed: int = msg(cls("NSCharacterSet"), sel("URLQueryAllowedCharacterSet"));
    enc: int = msg1(q, sel("stringByAddingPercentEncodingWithAllowedCharacters:"),
        allowed);
    fbuf_n = 0;
    fput_str("&page=");
    fput_int(page);
    path: int = msg1(msg1(nsstring("esv/search?q="), sel("stringByAppendingString:"),
        msg2(enc, sel("stringByReplacingOccurrencesOfString:withString:"), nsstring("&"),
        nsstring("%26"))), sel("stringByAppendingString:"), fstring());
    if (net_get_ns(path, NET_SEARCH, -1, 0) == 0) esv_search_answered(ESV_OFFLINE,
        0)
}

// ---- classes and methods ----
make_esv_class() {
    net_class = objc_allocateClassPair(cls("NSObject"), "L8Net", 0);
    add_method3(net_class, sel("URLSession:dataTask:didReceiveData:"), &net_received,
        "v@:@@@");
    add_method3(net_class, sel("URLSession:task:didCompleteWithError:"), &net_completed,
        "v@:@@@");
    add_protocol(net_class, "NSURLSessionDataDelegate");
    add_download_methods(net_class);
    objc_registerClassPair(net_class)
}

add_esv_methods(app: int) {
    add_method1(app, sel("esvSpinner:"), &esv_spinner, "v@:@");
    add_method1(app, sel("esvOpenSite:"), &esv_open_site, "B@:@");
    add_method1(app, sel("esvRetry:"), &esv_retry, "v@:@")
}
