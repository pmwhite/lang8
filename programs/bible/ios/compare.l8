tag bible_ios;

use_tag std, ios, bible;

// Compare (DESIGN.md §9.5): core's screen (core/skin.l8's SCR_COMPARE), in a
// sheet from the tray's sixth action, at its medium detent. The ESV's
// section loads as the reader's chapters do (ios/esv.l8).
import "../../ios/objc.l8";

import "../core/text.l8";

// The verses selected, for the tray (its sixth action).
compare_verses: []int = new int[200](0);

open_compare(c: int, vs: []int, n: int) {
    if (presented() != 0 || n == 0) return;
    sheet_form(620.0f64, 760.0f64);
    uk_detents = 1;
    uk_medium = true;
    uk_esv_state = 0;
    uk_sync();
    uk_nav = 0;
    sk_open_compare(c, vs, n);
    uk_effects()
}

// A run of words onto s, in a font and color, its paragraph p.
cmp_put(
    s: int,
    text: int,
    font: int,
    color: int,
    p: int
) {
    keys[0] = k_font;
    values[0] = font;
    keys[1] = k_color;
    values[1] = color;
    keys[2] = k_para;
    values[2] = p;
    msg1(s, sel("appendAttributedString:"), attributed_str(text, nsdictionary(keys,
        values, 3)))
}

// The ESV's chapter come, or not to be had: Compare made again.
compare_esv_arrived(c: int) {
    if (uk_table_of(SCR_COMPARE) == 0 || c != sk_cmp_c) return;
    uk_esv_state = 0;
    uk_update_kind(SCR_COMPARE)
}

compare_esv_failed(state: int) {
    if (uk_table_of(SCR_COMPARE) == 0 || uk_esv_state != ESV_LOADING) return;
    uk_esv_state = state;
    uk_update_kind(SCR_COMPARE)
}

// (The verses before or after, as a chevron would: the demos'.)
compare_next(_self: int, _cmd: int, _b: int): int {
    uk_sync();
    k: int = uk_slot_of(uk_table_of(SCR_COMPARE));
    if (k >= 0) sk_act(uk_ids[k], ACT_COMPARE_STEP, 1, 0);
    uk_effects();
    0
}

add_compare_methods(_app: int) { }

// The sheet gone: the ESV's chapter no longer held for it.
compare_gone() {
    if (ec_hold_c == sk_cmp_c) ec_hold_c = -1
}

compare_screens() {
    on_sheet_gone(&compare_gone)
}
