tag bible_ios;

use_tag std, ios, bible;

// Compare (DESIGN.md Â§9.5): the verses selected in every version, a
// section each (the one read first, then the BSB, the ESV, the KJV, the
// WEB, the ASV and the YLT), in a sheet from the tray's sixth action. Its
// chevrons go on to the verses before and after (by the selection's
// length, across chapters); a version's cell taps through to the reader in
// that version, at those verses. The ESV's section loads as the reader's
// chapters do (ios/esv.l8), and is not there unless the ESV is listed.
import "../../ios/objc.l8";

import "../core/text.l8";

COMPARE_MOST: int = 20;

compare_table: int = 0;

compare_vc: int = 0;

// The verses compared: chapter, the verses (keys), whether more were
// selected than are shown.
cmp_c: int = 0;

cmp_vs: []int = new int[20](0);

cmp_n: int = 0;

cmp_capped: bool = false;

compare_verses: []int = new int[200](0);

// The versions, in the sheet's order.
cmp_order: []int = new int[8](0);

cmp_count: int = 0;

// When the ESV's section began waiting (its spinner after 0.4 s).
cmp_esv_since: f64 = 0.0f64;

cmp_esv_state: int = 0;

compare_order() {
    cmp_count = 0;
    cmp_order[0] = text_cur;
    cmp_count = 1;
    for t in [TEXT_BSB, TEXT_ESV, 1, 2, 3, 4, TEXT_ORIG] {
        if (t != text_cur && (t != TEXT_ESV || esv_listed())) {
            cmp_order[cmp_count] = t;
            cmp_count = cmp_count + 1
        }
    }
}

// Compare on the first n verses of vs in chapter c, as a sheet at the
// medium detent.
open_compare(c: int, vs: []int, n: int) {
    if (presented() != 0 || n == 0) return;
    cmp_c = c;
    cmp_n = (if (n > COMPARE_MOST) COMPARE_MOST else n);
    cmp_capped = n > COMPARE_MOST;
    for i in 0..cmp_n cmp_vs[i] = vs[i];
    compare_order();
    for i in 0..cmp_count ensure_text(cmp_order[i]);
    vc: int = msg(msg1(msg(cls("UITableViewController"), sel("alloc")), sel("initWithStyle:"),
        2), sel("autorelease"));
    compare_vc = vc;
    compare_table = msg(vc, sel("tableView"));
    msg1(compare_table, sel("setDataSource:"), app_obj);
    msg1(compare_table, sel("setDelegate:"), app_obj);
    style_table(compare_table, true);
    msg_set_f(compare_table, sel("setSectionHeaderHeight:"), objc_const_f("UITableViewAutomaticDimension"));
    msg_set_f(compare_table, sel("setEstimatedSectionHeaderHeight:"), 38.0f64);
    msg_set_f(compare_table, sel("setSectionFooterHeight:"), objc_const_f("UITableViewAutomaticDimension"));
    msg_set_f(compare_table, sel("setEstimatedSectionFooterHeight:"), 20.0f64);
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    msg1(item, sel("setRightBarButtonItem:"), system_item(0, "closeSheet:"));
    compare_title();
    // The toolbar: the verses before, and after.
    prev: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol("chevron.up", 17.0f64, 4, 0), 0, app_obj, sel("comparePrevious:")),
        sel("autorelease"));
    msg1(prev, sel("setAccessibilityLabel:"), nsstring("Previous Verse"));
    next: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol("chevron.down", 17.0f64, 4, 0), 0, app_obj, sel("compareNext:")), sel("autorelease"));
    msg1(next, sel("setAccessibilityLabel:"), nsstring("Next Verse"));
    bar_items[0] = prev;
    bar_items[1] = msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        5, 0, 0), sel("autorelease"));
    bar_items[2] = next;
    msg1(vc, sel("setToolbarItems:"), nsarray(bar_items, 3));
    compare_esv_ask();
    sheet_form(620.0f64, 760.0f64);
    sheet_nav: int = sheet_of(vc, 1);
    sheet: int = msg(sheet_nav, sel("sheetPresentationController"));
    if (sheet != 0) msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierMedium"));
    msg2(sheet_nav, sel("setToolbarHidden:animated:"), 0, 0);
    msg1(msg(sheet_nav, sel("toolbar")), sel("setTintColor:"), c_icon);
    present(sheet_nav)
}

// The title: the verses' reference, in the numbering of the version read.
compare_title() {
    fbuf_n = 0;
    put_ref(cmp_c, cmp_vs, cmp_n);
    msg1(compare_vc, sel("setTitle:"), fstring())
}

// The ESV's chapter asked for, if it is listed and not here.
compare_esv_ask() {
    cmp_esv_state = 0;
    if (!esv_listed()) return;
    ensure_text(TEXT_ESV);
    ec_hold_c = cmp_c;
    if (esv_held(cmp_c)) return;
    cmp_esv_since = CACurrentMediaTime();
    cmp_esv_state = ESV_LOADING;
    esv_want(cmp_c, 1);
    _t: int = after(0.42f64, "compareSpinner:")
}

compare_gone() {
    if (compare_table != 0) ec_hold_c = -1;
    compare_table = 0;
    compare_vc = 0
}

compare_sections(_t: int): int {
    cmp_count + (if (cmp_capped) 1 else 0)
}

compare_rows(_t: int, _s: int): int {
    1
}

// A section's header: the version's name, and "Â· Reading" for the one
// read; wrapping at the largest sizes.
compare_header_view(_t: int, s: int): int {
    if (s >= cmp_count) return 0;
    t: int = cmp_order[s];
    v: int = msg(make("UIView"), sel("autorelease"));
    label: int = make("UILabel");
    msg1(label, sel("setNumberOfLines:"), 0);
    font: int = msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleFootnote"));
    keys[0] = k_font;
    values[0] = font;
    keys[1] = k_color;
    values[1] = msg(cls("UIColor"), sel("secondaryLabelColor"));
    s1: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    msg1(s1, sel("appendAttributedString:"), attributed_str(nsstring(text_names[t]),
        nsdictionary(keys, values, 2)));
    if (s == 0) {
        values[1] = c_faint;
        msg1(s1, sel("appendAttributedString:"), attributed_str(nsstring(" \Â\· Reading"),
            nsdictionary(keys, values, 2)))
    }
    msg1(label, sel("setAttributedText:"), s1);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), label);
    release(label);
    pin_by(label, v, "leadingAnchor", 20.0f64);
    pin_by(label, v, "trailingAnchor", -20.0f64);
    pin_by(label, v, "topAnchor", 14.0f64);
    pin_by(label, v, "bottomAnchor", -6.0f64);
    v
}

// The ESV's footer, once its text is there: "(ESV) Â· esv.org".
compare_footer_view(_t: int, s: int): int {
    if (s >= cmp_count || cmp_order[s] != TEXT_ESV || !esv_held(cmp_c)) return 0;
    esv_footer_view()
}

// The verses in version t, as the reader sets them, smaller: its words
// (LORD in small capitals, the words of Jesus red if they are, supplied
// words italic), each verse's number faint before it when there are
// several; a verse the version lacks said so, faint, italic.
compare_text(t: int): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    region {
        source: TextSource = text_source(t);
        ctx: ChapterLayout = chapter_layout();
        size: f64 = em * 0.9f64;
        p: int = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.3f64), sel("autorelease"));
        // (The Hebrew right to left, its line taller for its points: Â§14.11.7.)
        hebrew: bool = t == TEXT_ORIG && ch_book[cmp_c] < 39;
        if (hebrew) {
            msg1(p, sel("setBaseWritingDirection:"), 1);
            msg1(p, sel("setAlignment:"), 4);
            msg_set_f(p, sel("setLineHeightMultiple:"), 1.5f64)
        }
        layout_chapter_from(source, &ctx, cmp_c);
        for i in 0..cmp_n {
            v: int = cmp_vs[i];
            if (i > 0) cmp_put(s, nsstring(" "), body(size), c_ink, p);
            vi: int = layout_verse_find(&ctx, v);
            if (cmp_n > 1) {
                fbuf_n = 0;
                fput_int(if (vi >= 0) ctx.verse_shown[vi] else v);
                cmp_put(s, fstring(), body(size * 0.78f64), c_faint, p);
                cmp_put(s, ustr(8201, 0), body(size * 0.78f64), c_faint, p)
            }
            if (vi < 0 || ctx.verse_begin[vi] < 0) {
                fbuf_n = 0;
                if (t == TEXT_BSB) {
                    fput_str("Not in the BSB");
                    if (text_has(1, cmp_c, v) || text_has(2, cmp_c, v)) {
                        fput_str("; see the footnote at ");
                        one_verse[0] = v - 1;
                        put_ref_from(&source, cmp_c, one_verse, 1)
                    }
                } else fput_str("Not in this version");
                cmp_put(s, fstring(), italic(size), c_faint, p)
            } else cmp_runs(&ctx, s, ctx.verse_begin[vi], ctx.verse_end[vi], size,
                p)
        }
    }
    s
}

cmp_put(
    s: int,
    text: int,
    font: int,
    color: int,
    p: int
) {
    keys[0] = k_font;
    values[0] = font;
    keys[1] = k_color;
    values[1] = color;
    keys[2] = k_para;
    values[2] = p;
    msg1(s, sel("appendAttributedString:"), attributed_str(text, nsdictionary(keys,
        values, 3)))
}

// The runs of out from b to e: words only (no numbers, no notes' marks),
// lines run together.
cmp_runs(
    ctx: *ChapterLayout,
    s: int,
    b: int,
    e: int,
    size: f64,
    p: int
) {
    q: int = 0;
    for r in 0..ctx.runs {
        a: int = q;
        z: int = ctx.run_end[r];
        q = z;
        st: int = ctx.run_style[r];
        if (z > b && a < e) {
            if (a < b) a = b;
            if (z > e) z = e;
            words: bool = st == STYLE_BODY || st == STYLE_CAPS || st == STYLE_JESUS || st == STYLE_JESUS_CAPS || st == STYLE_SUPPLIED || st == STYLE_JESUS_SUPPLIED || st == STYLE_ORIG || st == STYLE_ORIG_GL;
            if (words && z > a) {
                fbuf_n = 0;
                for x in a..z {
                    k: int = ctx.out[x] as int;
                    fput(if (k == 10 || k == 9) 32 else k)
                }
                font: int = if (st == STYLE_ORIG || st == STYLE_ORIG_GL) if (ctx.lay_rtl) sans(size * 1.15f64,
                    0.0f64) else new_york(size) else if (st == STYLE_SUPPLIED || st == STYLE_JESUS_SUPPLIED) italic(size) else if (st == STYLE_CAPS || st == STYLE_JESUS_CAPS) if (caps_by_hand) body(size * 0.8f64) else small_caps(size) else body(size);
                color: int = if ((st == STYLE_JESUS || st == STYLE_JESUS_CAPS || st == STYLE_JESUS_SUPPLIED) && red_letter) c_accent else c_ink;
                cmp_put(s, fstring(), font, color, p)
            }
        }
    }
}

compare_cell(_tv: int, path: int): int {
    s: int = msg(path, sel("section"));
    cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, 0), sel("autorelease"));
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    content: int = msg(cell, sel("contentView"));
    label: int = make("UILabel");
    msg1(label, sel("setNumberOfLines:"), 0);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    if (s >= cmp_count) {
        // (The last row, under a long selection.)
        msg1(label, sel("setText:"), nsstring("Compare shows up to 20 verses."));
        msg1(label, sel("setFont:"), sans(15.0f64, 0.0f64));
        msg1(label, sel("setTextColor:"), c_faint);
        msg1(cell, sel("setSelectionStyle:"), 0)
    } else {
        t: int = cmp_order[s];
        if (t == TEXT_ESV && !esv_held(cmp_c)) {
            msg1(cell, sel("setSelectionStyle:"), 0);
            if (cmp_esv_state >= ESV_OFFLINE) msg1(label, sel("setText:"), nsstring("The ESV needs an internet connection.")) else {
                msg1(label, sel("setText:"), nsstring("Loading\â\€\¦"));
                sp: int = msg1(msg(cls("UIActivityIndicatorView"), sel("alloc")),
                    sel("initWithActivityIndicatorStyle:"), 100);
                msg1(sp, sel("setColor:"), c_faint);
                msg(sp, sel("startAnimating"));
                msg_set_f(sp, sel("setAlpha:"), if (CACurrentMediaTime() - cmp_esv_since >= 0.4f64) 1.0f64 else 0.0f64);
                msg1(sp, sel("setTag:"), SPINNER_TAG);
                msg1(sp, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
                msg1(content, sel("addSubview:"), sp);
                release(sp);
                pin_by(sp, content, "leadingAnchor", 16.0f64);
                pin_to(sp, "centerYAnchor", content, "centerYAnchor", 0.0f64)
            }
            msg1(label, sel("setFont:"), body(em * 0.9f64));
            msg1(label, sel("setTextColor:"), c_faint)
        } else {
            msg1(label, sel("setAttributedText:"), compare_text(t));
            msg1(cell, sel("setSelectionStyle:"), 3);
            fbuf_n = 0;
            fput_str("Reads in ");
            fput_str(text_names[t]);
            msg1(cell, sel("setAccessibilityHint:"), fstring())
        }
    }
    msg1(content, sel("addSubview:"), label);
    release(label);
    loading: bool = s < cmp_count && cmp_order[s] == TEXT_ESV && !esv_held(cmp_c) && cmp_esv_state < ESV_OFFLINE;
    pin_by(label, content, "leadingAnchor", if (loading) 44.0f64 else 16.0f64);
    pin_by(label, content, "trailingAnchor", -16.0f64);
    pin_by(label, content, "topAnchor", 14.0f64);
    pin_by(label, content, "bottomAnchor", -14.0f64);
    cell
}

// A version's cell tapped: the sheet gone, the reader in that version, at
// these verses (flashed). A list row goes.
compare_picked(_t: int, s: int, _r: int) {
    if (s >= cmp_count) return;
    t: int = cmp_order[s];
    if (t == TEXT_ESV && !esv_held(cmp_c)) return;
    c: int = cmp_c;
    v: int = cmp_vs[0];
    dismiss_sheets();
    switch_version(t);
    jump(c, v)
}

// The chevrons: the verses before or after, by the selection's length,
// across chapters (in the version read).
compare_step(d: int) {
    if (compare_vc == 0 || cmp_n == 0) return;
    n: int = cmp_n;
    c: int = cmp_c;
    first: int = if (d > 0) cmp_vs[cmp_n - 1] + 1 else cmp_vs[0] - n;
    if (d > 0 && first > ch_verses[c]) {
        if (c + 1 >= chapters) return;
        c = c + 1;
        first = 1
    } else if (d < 0 && first < 1) {
        if (first + n - 1 >= 1) first = 1 else {
            if (c == 0) return;
            c = c - 1;
            first = ch_verses[c] - n + 1;
            if (first < 1) first = 1
        }
    }
    cmp_c = c;
    m: int = 0;
    x: int = first;
    while (m < n && x <= ch_verses[c]) {
        cmp_vs[m] = x;
        m = m + 1;
        x = x + 1
    }
    cmp_n = m;
    // (The title fades to its new reference.)
    bar: int = msg(msg(compare_vc, sel("navigationController")), sel("navigationBar"));
    if (bar != 0) fade_layer(msg(bar, sel("layer")), 0.15f64);
    compare_title();
    compare_esv_ask()
}

compare_reload() {
    if (compare_table == 0) return;
    n: int = compare_sections(compare_table);
    set: int = msg2(cls("NSIndexSet"), sel("indexSetWithIndexesInRange:"), 0, n);
    msg2(compare_table, sel("reloadSections:withRowAnimation:"), set, 0)
}

compare_previous(_self: int, _cmd: int, _b: int): int {
    compare_step(-1);
    compare_reload();
    0
}

compare_next(_self: int, _cmd: int, _b: int): int {
    compare_step(1);
    compare_reload();
    0
}

// The ESV's section, as its chapter comes (a cross-fade, its height
// animated) or cannot.
compare_esv_arrived(c: int) {
    if (compare_table == 0 || c != cmp_c) return;
    cmp_esv_state = 0;
    compare_esv_section()
}

compare_esv_failed(state: int) {
    if (compare_table == 0 || cmp_esv_state != ESV_LOADING) return;
    cmp_esv_state = state;
    compare_esv_section()
}

compare_esv_section() {
    s: int = -1;
    for i in 0..cmp_count
        if (cmp_order[i] == TEXT_ESV) s = i;
    if (s < 0) return;
    fade_layer(msg(compare_table, sel("layer")), 0.2f64);
    msg(compare_table, sel("beginUpdates"));
    msg2(compare_table, sel("reloadSections:withRowAnimation:"), msg1(cls("NSIndexSet"),
        sel("indexSetWithIndex:"), s), 5);
    msg(compare_table, sel("endUpdates"))
}

// The ESV's spinner, after 0.4 s of waiting.
compare_spinner(_self: int, _cmd: int, _timer: int): int {
    if (compare_table == 0 || cmp_esv_state != ESV_LOADING) return 0;
    for i in 0..cmp_count {
        if (cmp_order[i] == TEXT_ESV) {
            cell: int = msg1(compare_table, sel("cellForRowAtIndexPath:"), msg2(cls("NSIndexPath"),
                sel("indexPathForRow:inSection:"), 0, i));
            sp: int = if (cell != 0) msg1(msg(cell, sel("contentView")), sel("viewWithTag:"),
                SPINNER_TAG) else 0;
            if (sp != 0) {
                msg_set_f(sp, sel("setAlpha:"), 1.0f64);
                animate(msg(sp, sel("layer")), "opacity", 0.0f64, 1.0f64, false, 0.2f64)
            }
        }
    }
    0
}

add_compare_methods(app: int) {
    add_method1(app, sel("comparePrevious:"), &compare_previous, "v@:@");
    add_method1(app, sel("compareNext:"), &compare_next, "v@:@");
    add_method1(app, sel("compareSpinner:"), &compare_spinner, "v@:@")
}

// ---- Compare's list (tables.l8) ----
compare_screens() {
    s: TableScreen = table_screen(&compare_table, &compare_sections, &compare_rows,
        &compare_cell);
    s.picked = &compare_picked;
    s.header_view = &compare_header_view;
    s.footer_view = &compare_footer_view;
    s.look = TableLook.Grouped;
    table_add(s);
    on_sheet_gone(&compare_gone)
}
