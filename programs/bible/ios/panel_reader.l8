tag bible_ios;

use_tag std, ios, bible, bible_wire;

// The panel's reader (core/beside.l8's): a version or a commentary read
// beside the page as the page is read, every chapter in turn, in the table
// of core's screen that says `reader C V`. Its words are core's parts
// (`besidepart`: about 2 KB of a commentary's chapter each; a version's
// chapter, `besidechapter`, is one), kept with the page's chapters
// (ios/reader.l8, by pr_part_key).
//
// It shows a window of them: the parts around what is on the screen, each
// a text view of its own, one after another in a view that is the table's
// header (the table has no rows). A part comes into the window measured:
// its height, and where each of its verses begins, so that where anything
// in the window is is known, not estimated, and never changes while it is
// there. Parts come into the window ahead of the screen at either end, and
// those far behind it go; one coming in above the screen moves the table's
// offset by its height at once, so that nothing on the screen moves.
//
// Where it is read is its top (the page's is a third of the way down it,
// reading_line, where Go To leaves a verse): its place is told to core as
// it changes (`besideplace C V FRAC`), core jumps it to a verse there
// (`besidejump C V`), and linked with the page it follows the page's
// reading line there, or leads it.

// The table it is read in (0: none), and the place last told.
pr_table: int = 0;

pr_told_c: int = -1;

pr_told_v: int = -1;

// Scrolls of its own under way (a jump's, the window's): not told as a
// finger's.
pr_self: int = 0;

is_panel_reader(t: int): bool {
    t != 0 && t == pr_table
}

// Table t, core's screen's, made the panel's reader, at chapter c, verse v:
// rows none, its header the window's view.
pr_attach(t: int, c: int, v: int) {
    if (pr_table != 0 && pr_table != t) pr_detach(pr_table);
    pr_table = t;
    pr_told_c = -1;
    pr_told_v = -1;
    msg1(t, sel("setSeparatorStyle:"), 0);
    msg1(t, sel("setAllowsSelection:"), 0);
    msg1(t, sel("setBackgroundColor:"), c_bg);
    if (pr_box == 0) {
        pr_box = msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
            0.0f64, 0.0f64, view_width(t), 1.0f64);
        msg1(pr_box, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")))
    }
    pw_clear();
    msg(t, sel("reloadData"));
    pr_jump(c, v)
}

// Table t let go (its screen gone): the window emptied.
pr_detach(t: int) {
    if (t != pr_table) return;
    pw_clear();
    pr_table = 0
}

// The text's side margins in the panel's width: the setting's, or wider,
// a column of 34 em centred.
pr_margin(): f64 {
    w: f64 = view_width(pr_table);
    m: f64 = margin_for(w);
    cw: f64 = column_width(w, m);
    if (cw < w - 2.0f64 * m) m = (w - cw) / 2.0f64;
    m
}

// ---- a chapter's parts ----
// How many parts each chapter has, as core last said (1 until it has; a
// commentary still opening says 0, and has 1 until it is open).
PR_CHAPTERS_MOST: int = 2048;

pr_parts: []int = new int[PR_CHAPTERS_MOST](1);

pr_part_count(c: int): int {
    if (c < 0 || c >= PR_CHAPTERS_MOST) 1 else pr_parts[c]
}

// Every chapter's parts let go (the chapters themselves changed: a
// version, what is read, or how it looks): the parts kept, their counts
// and the chapters' anchors.
pr_parts_forget() {
    for c in 0..PR_CHAPTERS_MOST {
        pr_parts[c] = 1;
        pr_gap_first[c] = -1;
        pr_gap_last[c] = -1
    }
    for k in 0..PR_ANCHORED_MOST pr_an_c[k] = -1;
    for s in 0..RS_SLOTS {
        if (rs_c[s] >= PR_PART_KEY) {
            rs_c[s] = -1;
            rs_text[s] = held(rs_text[s], 0)
        }
    }
}

// Part p of chapter c kept (ios/reader.l8), its chapter in parts parts (0:
// not known yet).
pr_part_stored(c: int, _p: int, parts: int) {
    if (c >= 0 && c < PR_CHAPTERS_MOST && parts > 0) pr_parts[c] = parts
}

// The chapters a commentary has no comment on, in runs (core's `gap C0
// C1`): each one's run's first and last (-1: not one, or not known yet).
// A run is one row of the window, the placeholder that says so.
pr_gap_first: []int = new int[PR_CHAPTERS_MOST](-1);

pr_gap_last: []int = new int[PR_CHAPTERS_MOST](-1);

pr_gap_noted(from: int, to: int) {
    for c in from..to + 1 {
        if (c >= 0 && c < PR_CHAPTERS_MOST) {
            pr_gap_first[c] = from;
            pr_gap_last[c] = to
        }
    }
}

// The first chapter of the row chapter c is in (its gap's first, in one;
// its first part asked for, if it isn't known), and the last.
pr_row_chapter(c: int): int {
    if (c < 0 || c >= PR_CHAPTERS_MOST) return c;
    if (!pr_known(c)) _first: int = rs_need(pr_part_key(c, 0));
    if (pr_gap_first[c] >= 0) pr_gap_first[c] else c
}

pr_row_last(c: int): int {
    if (c < 0 || c >= PR_CHAPTERS_MOST || pr_gap_first[c] < 0) c else pr_gap_last[c]
}

// Whether part p of chapter c only holds its place while core reads it.
pr_part_coming(c: int, p: int): bool {
    s: int = rs_slot(pr_part_key(c, p));
    s >= 0 && rs_coming[s]
}

// ---- a chapter's anchors ----
// Where the verses of the reader's chapters begin: each verse a
// commentary's chapter's comments begin, in order (one may come again,
// where its commentator goes through the verses again), with the part it
// is in, as core says them with each part (`anchor V P`); a version's
// verses, all in its one part. Kept for a few chapters, the latest asked
// for. A part's verse lines are its anchors, in order.
PR_ANCHORED_MOST: int = 8;

PR_ANCHORS_MOST: int = 2048;

pr_an_c: []int = new int[PR_ANCHORED_MOST](-1);

pr_an_n: []int = new int[PR_ANCHORED_MOST](0);

pr_an_used: []int = new int[PR_ANCHORED_MOST](0);

pr_an_verse: []int = new int[PR_ANCHORED_MOST * PR_ANCHORS_MOST](0);

pr_an_part: []int = new int[PR_ANCHORED_MOST * PR_ANCHORS_MOST](0);

// Each anchor's reach: the verse of the first anchor after it whose verse
// is greater (past the chapter's last: PR_REACH_END), as pr_covers asks.
pr_an_reach: []int = new int[PR_ANCHORED_MOST * PR_ANCHORS_MOST](0);

PR_REACH_END: int = 1000000;

pr_an_clock: int = 0;

// (The place last found: asked for again and again as a link is made.)
pr_an_last: int = 0;

// Chapter c's anchors' place (-1: not known).
pr_anchored(c: int): int {
    if (pr_an_c[pr_an_last] == c) return pr_an_last;
    for k in 0..PR_ANCHORED_MOST {
        if (pr_an_c[k] == c) {
            pr_an_clock = pr_an_clock + 1;
            pr_an_used[k] = pr_an_clock;
            pr_an_last = k;
            return k
        }
    }
    -1
}

// Chapter c's anchors begun again (none yet), in its place or the one used
// longest ago.
pr_anchors_begin(c: int) {
    at: int = pr_anchored(c);
    if (at < 0) {
        at = 0;
        for k in 0..PR_ANCHORED_MOST
            if (pr_an_used[k] < pr_an_used[at]) at = k
    }
    pr_an_c[at] = c;
    pr_an_n[at] = 0;
    pr_an_clock = pr_an_clock + 1;
    pr_an_used[at] = pr_an_clock
}

pr_anchor_add(c: int, verse: int, part: int) {
    at: int = pr_anchored(c);
    if (at < 0 || pr_an_n[at] >= PR_ANCHORS_MOST) return;
    k: int = at * PR_ANCHORS_MOST + pr_an_n[at];
    pr_an_verse[k] = verse;
    pr_an_part[k] = part;
    pr_an_n[at] = pr_an_n[at] + 1
}

// A version's chapter kept in slot s: its verses its anchors.
pr_anchors_of_version(c: int, s: int) {
    pr_anchors_begin(c);
    for i in 0..rs_v_n[s] pr_anchor_add(c, rs_v_num[s * VS_MOST + i], 0);
    pr_anchors_ended(c)
}

// Chapter c's anchors all said: each one's reach found (from the last
// back, keeping the indices of those not yet passed by a greater verse).
pr_an_stack: []int = new int[PR_ANCHORS_MOST](0);

pr_anchors_ended(c: int) {
    at: int = pr_anchored(c);
    if (at < 0) return;
    base: int = at * PR_ANCHORS_MOST;
    n: int = pr_an_n[at];
    depth: int = 0;
    for k in 0..n {
        i: int = n - 1 - k;
        while (depth > 0 && pr_an_verse[base + pr_an_stack[depth - 1]] <= pr_an_verse[base + i]) depth = depth - 1;
        pr_an_reach[base + i] = (if (depth == 0) PR_REACH_END else pr_an_verse[base + pr_an_stack[depth - 1]]);
        pr_an_stack[depth] = i;
        depth = depth + 1
    }
}

// Anchor i of chapter c's reach (PR_REACH_END: none known).
pr_anchor_reach(c: int, i: int): int {
    at: int = pr_anchored(c);
    if (at < 0 || i < 0 || i >= pr_an_n[at]) PR_REACH_END else pr_an_reach[at * PR_ANCHORS_MOST + i]
}

// Whether chapter c's anchors are known (else its first part asked for,
// with them, at rest: pr_link_waits).
pr_known(c: int): bool {
    pr_anchored(c) >= 0
}

pr_anchor_count(c: int): int {
    at: int = pr_anchored(c);
    if (at < 0) 0 else pr_an_n[at]
}

pr_anchor_verse(c: int, i: int): int {
    at: int = pr_anchored(c);
    if (at < 0 || i < 0 || i >= pr_an_n[at]) -1 else pr_an_verse[at * PR_ANCHORS_MOST + i]
}

pr_anchor_part(c: int, i: int): int {
    at: int = pr_anchored(c);
    if (at < 0 || i < 0 || i >= pr_an_n[at]) 0 else pr_an_part[at * PR_ANCHORS_MOST + i]
}

// The index of chapter c's first anchor in part p or after (its count,
// if none): its anchors are in their parts' order.
pr_part_first_anchor(c: int, p: int): int {
    at: int = pr_anchored(c);
    if (at < 0) return 0;
    low: int = 0;
    high: int = pr_an_n[at];
    while (low < high) {
        mid: int = (low + high) / 2;
        if (pr_an_part[at * PR_ANCHORS_MOST + mid] < p) low = mid + 1 else high = mid
    }
    low
}

// The index of chapter c's first anchor of verse v (-1: none).
pr_anchor_of(c: int, v: int): int {
    for i in 0..pr_anchor_count(c)
        if (pr_anchor_verse(c, i) == v) return i;
    -1
}

// ---- a part's words ----
// Part p of chapter c's words, attributed and washed as chapter_text makes
// them (asked for, if it is not kept).
pr_part_text(c: int, p: int): int {
    key: int = pr_part_key(c, p);
    if (rs_need(key) < 0) return msg(make("NSMutableAttributedString"), sel("autorelease"));
    chapter_text(key)
}

// ---- the window ----
// The parts shown, in order, at most PW_MOST: each one's chapter and part,
// its text view (kept), where it begins down the window's view and how
// tall it is, the index of its first anchor in its chapter, and where each
// of its verses begins (down from its own top), its anchors in order.
PW_MOST: int = 48;

PW_VERSES_MOST: int = 200;

pw_n: int = 0;

pw_c: []int = new int[PW_MOST](-1);

pw_p: []int = new int[PW_MOST](0);

pw_view: []int = new int[PW_MOST](0);

pw_y: []f64 = new f64[PW_MOST](0.0f64);

pw_h: []f64 = new f64[PW_MOST](0.0f64);

pw_first: []int = new int[PW_MOST](0);

// The last chapter each row stands for (its own; a gap's last).
pw_last: []int = new int[PW_MOST](-1);

pw_vn: []int = new int[PW_MOST](0);

pw_vy: []f64 = new f64[PW_MOST * PW_VERSES_MOST](0.0f64);

// The window's view (the table's header), and the width its parts were
// measured at.
pr_box: int = 0;

pw_width: f64 = 0.0f64;

// How tall the window is.
pw_height(): f64 {
    if (pw_n == 0) 0.0f64 else pw_y[pw_n - 1] + pw_h[pw_n - 1]
}

// The window's view as tall as its parts (the table told again: its
// header's height is its content's).
pw_box_fit() {
    msg_rect(pr_box, sel("setFrame:"), 0.0f64, 0.0f64, pw_width, if (pw_n == 0) 1.0f64 else pw_height());
    msg1(pr_table, sel("setTableHeaderView:"), pr_box)
}

pw_clear() {
    for k in 0..pw_n {
        msg(pw_view[k], sel("removeFromSuperview"));
        release(pw_view[k]);
        pw_view[k] = 0
    }
    pw_n = 0;
    pw_fit_due = false;
    pw_shift_due = 0.0f64;
    if (pr_table != 0 && pr_box != 0) {
        pw_width = view_width(pr_table);
        pw_box_fit()
    }
}

// The row of the window showing part p of chapter c (-1: none).
pw_row_of(c: int, p: int): int {
    for k in 0..pw_n
        if (pw_c[k] <= c && c <= pw_last[k] && pw_p[k] == p) return k;
    -1
}

// The row holding y, down the window's view (-1: none; the last for one
// past its end).
pw_row_at(y: f64): int {
    if (pw_n == 0) return -1;
    k: int = 0;
    while (k + 1 < pw_n && pw_y[k + 1] <= y) k = k + 1;
    k
}

// Part p of chapter c made a text view (kept), laid out at the window's
// width, its height and its verses' places measured (into row k's).
pw_made(k: int, c: int, p: int): int {
    tv: int = msg_rect(msg(cls("UITextView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, pw_width, 100.0f64);
    msg1(tv, sel("setScrollEnabled:"), 0);
    msg1(tv, sel("setEditable:"), 0);
    msg1(tv, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
    msg1(tv, sel("setTintColor:"), c_accent);
    pw_dress(k, tv, c, p);
    tv
}

// Row k's text view tv given part p of chapter c's words, and measured.
// (A chapter's first part below the space between chapters; another, below
// a paragraph's; the Bible's last, room after it.)
pw_dress(
    k: int,
    tv: int,
    c: int,
    p: int
) {
    m: f64 = pr_margin();
    top: f64 = if (p > 0) em * 0.55f64 else if (c == 0) top_gap() else em * 2.4f64;
    last: bool = c + 1 == chapters_n && p + 1 >= pr_part_count(c);
    msg_rect(tv, sel("setTextContainerInset:"), top, m, if (last) 120.0f64 else 0.0f64,
        m);
    msg1(tv, sel("setAttributedText:"), pr_part_text(c, p));
    // (Its height laid out whole, in a frame taller than any part: a text
    // view by itself lays out only near what it shows, and its words no
    // further down than its frame.)
    msg_rect(tv, sel("setFrame:"), 0.0f64, 0.0f64, pw_width, 1000000.0f64);
    h: f64 = top + (if (last) 120.0f64 else 0.0f64) + pw_text_height(tv);
    if (h < 1.0f64) h = 1.0f64;
    msg_rect(tv, sel("setFrame:"), 0.0f64, 0.0f64, pw_width, h);
    // (A gap's placeholder as tall as what the panel shows: in view
    // wherever the page is in the gap.)
    gap: bool = c >= 0 && c < PR_CHAPTERS_MOST && pr_gap_first[c] >= 0;
    shown: f64 = view_height(pr_table) - top_inset(pr_table);
    if (gap && h < shown) {
        h = shown;
        msg_rect(tv, sel("setFrame:"), 0.0f64, 0.0f64, pw_width, h)
    }
    pw_h[k] = h;
    pw_c[k] = c;
    pw_last[k] = pr_row_last(c);
    pw_p[k] = p;
    pw_first[k] = pr_part_first_anchor(c, p);
    // (Its verses' places: its verse lines are its anchors, in order.)
    s: int = rs_slot(pr_part_key(c, p));
    n: int = if (s < 0) 0 else rs_v_n[s];
    if (n > PW_VERSES_MOST) n = PW_VERSES_MOST;
    pw_vn[k] = n;
    for j in 0..n pw_vy[k * PW_VERSES_MOST + j] = (if (range_rect(tv, rs_vb2[s * VS_MOST + j],
        1)) hfa[1] else 0.0f64)
}

// How tall text view tv's words are at its width, laid out whole (its
// insets apart).
pw_text_height(tv: int): f64 {
    layout: int = msg(tv, sel("textLayoutManager"));
    if (layout == 0) return 0.0f64;
    msg1(layout, sel("ensureLayoutForRange:"), msg(layout, sel("documentRange")));
    l8_msg_hfa(hfa, layout, sel("usageBoundsForTextContainer"), 0, 0, 0);
    hfa[1] + hfa[3]
}

// Each row's place from the first's, its view put there.
pw_place_from(k0: int) {
    for k in k0..pw_n {
        pw_y[k] = (if (k == 0) 0.0f64 else pw_y[k - 1] + pw_h[k - 1]);
        msg_rect(pw_view[k], sel("setFrame:"), 0.0f64, pw_y[k], pw_width, pw_h[k])
    }
}

// Rows added or let go: the window's view to be made as tall as they are,
// and the table moved by as much as those above the screen came to, once,
// when they all have been (pw_commit; the table's header set again for
// each would lay it out each time).
pw_fit_due: bool = false;

pw_shift_due: f64 = 0.0f64;

pw_commit() {
    if (pw_fit_due) {
        pw_fit_due = false;
        pw_box_fit()
    }
    if (pw_shift_due != 0.0f64) {
        dy: f64 = pw_shift_due;
        pw_shift_due = 0.0f64;
        pw_shift(dy)
    }
}

// The reader's top and bottom, down the window's view, as they will be
// once what is due is done.
pw_top(): f64 {
    offset_y(pr_table) + top_inset(pr_table) + pw_shift_due
}

pw_bottom(): f64 {
    offset_y(pr_table) + view_height(pr_table) + pw_shift_due
}

// The table moved down by dy, as its own scroll (a glide goes on).
pw_shift(dy: f64) {
    pr_self = pr_self + 1;
    _o: int = msg_ff(pr_table, sel("setContentOffset:"), 0.0f64, offset_y(pr_table) + dy);
    pr_self = pr_self - 1
}

// Part p of chapter c added after the window's last.
pw_add_below(c: int, p: int) {
    if (pw_n >= PW_MOST) pw_drop_above();
    k: int = pw_n;
    pw_n = pw_n + 1;
    pw_view[k] = pw_made(k, c, p);
    msg1(pr_box, sel("addSubview:"), pw_view[k]);
    pw_place_from(k);
    pw_fit_due = true
}

// Part p of chapter c added before the window's first: the rows below
// moved down by its height, and the table with them.
pw_add_above(c: int, p: int) {
    if (pw_n >= PW_MOST) pw_drop_below();
    for j in 0..pw_n {
        k: int = pw_n - j;
        pw_c[k] = pw_c[k - 1];
        pw_p[k] = pw_p[k - 1];
        pw_view[k] = pw_view[k - 1];
        pw_h[k] = pw_h[k - 1];
        pw_first[k] = pw_first[k - 1];
        pw_vn[k] = pw_vn[k - 1];
        pw_last[k] = pw_last[k - 1];
        for v in 0..pw_vn[k] pw_vy[k * PW_VERSES_MOST + v] = pw_vy[(k - 1) * PW_VERSES_MOST + v]
    }
    pw_n = pw_n + 1;
    pw_view[0] = pw_made(0, c, p);
    msg1(pr_box, sel("addSubview:"), pw_view[0]);
    pw_place_from(0);
    pw_fit_due = true;
    pw_shift_due = pw_shift_due + pw_h[0]
}

// The window's first row let go: the rows below moved up, and the table.
pw_drop_above() {
    if (pw_n == 0) return;
    h: f64 = pw_h[0];
    msg(pw_view[0], sel("removeFromSuperview"));
    release(pw_view[0]);
    for k in 0..pw_n - 1 {
        pw_c[k] = pw_c[k + 1];
        pw_p[k] = pw_p[k + 1];
        pw_view[k] = pw_view[k + 1];
        pw_h[k] = pw_h[k + 1];
        pw_first[k] = pw_first[k + 1];
        pw_vn[k] = pw_vn[k + 1];
        pw_last[k] = pw_last[k + 1];
        for v in 0..pw_vn[k] pw_vy[k * PW_VERSES_MOST + v] = pw_vy[(k + 1) * PW_VERSES_MOST + v]
    }
    pw_n = pw_n - 1;
    pw_view[pw_n] = 0;
    pw_place_from(0);
    pw_fit_due = true;
    pw_shift_due = pw_shift_due - h
}

pw_drop_below() {
    if (pw_n == 0) return;
    pw_n = pw_n - 1;
    msg(pw_view[pw_n], sel("removeFromSuperview"));
    release(pw_view[pw_n]);
    pw_view[pw_n] = 0;
    pw_fit_due = true
}

// Row k's words made again as its part is now (come, after holding its
// place): it and those below moved by how much taller it is, and the table
// with them if it is above the screen's top.
pw_redress(k: int) {
    was: f64 = pw_h[k];
    pw_dress(k, pw_view[k], pw_c[k], pw_p[k]);
    pw_place_from(k);
    pw_fit_due = true;
    if (pw_y[k] + was <= pw_top()) pw_shift_due = pw_shift_due + pw_h[k] - was;
    pw_commit()
}

// The part after part p of chapter c, and the one before it (c -1: none;
// a chapter's last part known once its first has said how many).
pw_next_c: int = -1;

pw_next_p: int = 0;

pw_after(c: int, p: int) {
    last: int = pr_row_last(c);
    if (last == c && p + 1 < pr_part_count(c)) {
        pw_next_c = c;
        pw_next_p = p + 1
    } else if (last + 1 < chapters_n) {
        pw_next_c = pr_row_chapter(last + 1);
        pw_next_p = 0
    } else pw_next_c = -1
}

pw_before(c: int, p: int) {
    if (p > 0) {
        pw_next_c = c;
        pw_next_p = p - 1;
        return
    }
    if (c <= 0) {
        pw_next_c = -1;
        return
    }
    // (Its chapter's parts counted, and whether it is in a gap: its first
    // asked for, which says.)
    first: int = pr_row_chapter(c - 1);
    pw_next_c = first;
    pw_next_p = (if (first != c - 1) 0 else pr_part_count(c - 1) - 1)
}

// The window made to reach margin beyond the screen at either end, a part
// at a time, budget parts at most (above the screen, not while it glides
// by itself: the glide's offset would be moved under it); then what is far
// beyond it let go. Whether it reaches.
pw_fill(margin: f64, budget: int): bool {
    if (pr_table == 0 || pw_n == 0) return true;
    if (view_width(pr_table) != pw_width) {
        pr_rebuild();
        return false
    }
    left: int = budget;
    while (left > 0) {
        if (pw_height() - pw_bottom() < margin) {
            pw_after(pw_c[pw_n - 1], pw_p[pw_n - 1]);
            if (pw_next_c < 0)
                break;
            pw_add_below(pw_next_c, pw_next_p)
        } else if (pw_top() < margin && !pr_gliding) {
            pw_before(pw_c[0], pw_p[0]);
            if (pw_next_c < 0)
                break;
            pw_add_above(pw_next_c, pw_next_p)
        } else
            break;
        left = left - 1
    }
    // (Far behind: let go.)
    far: f64 = margin * 2.0f64 + view_height(pr_table);
    while (pw_n > 1 && pw_y[pw_n - 1] - pw_bottom() > far) pw_drop_below();
    while (pw_n > 1 && !pr_gliding && pw_top() - (pw_y[0] + pw_h[0]) > far) pw_drop_above();
    pw_commit();
    left > 0
}

// The window's margins: while it moves, a screen and a half ahead; at
// rest, three, a part at a time between frames (pr_fill_soon).
pw_margin_moving(): f64 {
    view_height(pr_table) * 1.5f64
}

pw_margin_resting(): f64 {
    view_height(pr_table) * 3.0f64
}

pr_fill_due: bool = false;

pr_fill_soon() {
    if (pr_fill_due || pr_table == 0) return;
    pr_fill_due = true;
    _t: int = after_common(0.05f64, "besideFill:")
}

pr_fill_fired(_self: int, _cmd: int, _timer: int): int {
    pr_fill_due = false;
    if (pr_table == 0) return 0;
    // (A glide UIKit didn't say the end of, as one cut short: over by now.)
    if (pr_gliding) {
        if (CACurrentMediaTime() > pr_glide_until) pr_glide_ended() else pr_fill_soon();
        return 0
    }
    if (pr_moving()) return 0;
    if (!pw_fill(pw_margin_resting(), 1)) pr_fill_soon();
    0
}

// ---- where things are ----
// Where chapter c's anchor i begins, down from the table's top, and
// whether its part is in the window (pr_found).
pr_found: bool = false;

pr_index_y(c: int, i: int): f64 {
    pr_found = false;
    if (i < 0) return pr_chapter_y(c);
    // (Its part in the window: where in it its verse line says; a part
    // core says more anchors of than it has verse lines, its top.)
    p: int = pr_anchor_part(c, i);
    for k in 0..pw_n {
        if (pw_c[k] == c && pw_p[k] == p) {
            pr_found = true;
            j: int = i - pw_first[k];
            return pw_y[k] + (if (j >= 0 && j < pw_vn[k]) pw_vy[k * PW_VERSES_MOST + j] else 0.0f64)
        }
    }
    0.0f64
}

// Where chapter c begins (its first part's top; the end of the one before
// it, if that is the window's last), and whether that is in the window
// (pr_found); past the window's end, its end.
pr_chapter_y(c: int): f64 {
    pr_found = true;
    for k in 0..pw_n {
        if (pw_c[k] <= c && c <= pw_last[k] && pw_p[k] == 0) return pw_y[k];
        if (pw_c[k] >= c) {
            pr_found = false;
            return pw_y[k]
        }
    }
    pr_found = pw_n > 0 && pw_last[pw_n - 1] == c - 1 && (pw_last[pw_n - 1] != pw_c[pw_n - 1] || pw_p[pw_n - 1] + 1 >= pr_part_count(c - 1));
    pw_height()
}

// Where verse v of chapter c begins (its first place; verse 0: the
// chapter's top), and whether in the window (pr_found).
pr_verse_y(c: int, v: int): f64 {
    if (v <= 0) pr_chapter_y(c) else pr_index_y(c, pr_anchor_of(c, v))
}

// The table at y (under its header), as its own scroll.
pr_set_offset(y: f64) {
    least: f64 = -top_inset(pr_table);
    pr_self = pr_self + 1;
    msg_ff1(pr_table, sel("setContentOffset:animated:"), 0.0f64, if (y < least) least else y,
        0);
    pr_self = pr_self - 1
}

// The window made again around where it is read (its width or its parts
// changed).
pr_rebuild() {
    c: int = pr_told_c;
    v: int = pr_told_v;
    if (c < 0) return;
    pr_jump(c, if (v < 0) 0 else v)
}

// ---- jumps ----
// `besidejump C V`: chapter c's verse v (0: its top) at the top, under the
// header (following by comment, its first comment on v): the window made
// again around it.
pr_jump(c: int, to_v: int) {
    if (pr_table == 0 || c < 0 || c >= chapters_n) return;
    // (Its anchors known first: its first part asked for, which says them.)
    if (!pr_known(c)) _first: int = rs_need(pr_part_key(c, 0));
    i: int = if (to_v <= 0) -1 else if (pr_by_comment) pr_comment_first(c, to_v) else pr_anchor_of(c,
        to_v);
    pr_jump_to_anchor(c, i)
}

// Chapter c's anchor i (-1: its top) at the top: the window made again
// around it.
pr_jump_to_anchor(c: int, i: int) {
    p: int = if (i >= 0) pr_anchor_part(c, i) else 0;
    pr_glide_stop();
    pw_clear();
    pw_add_below(if (i >= 0) c else pr_row_chapter(c), p);
    pw_commit();
    y: f64 = pr_index_y(c, i);
    pr_set_offset(y - top_inset(pr_table));
    // (The screen filled at once (below the place; a little above it), the
    // rest a part at a time between frames.)
    _full: bool = pw_fill(0.0f64, 4);
    v: int = if (i >= 0) pr_anchor_verse(c, i) else 0;
    pr_told_c = c;
    pr_told_v = v;
    pr_glided_forget();
    pr_fill_soon()
}

// ---- gliding to a place ----
// The reader moved to y by UIKit's own animation (near), or at once (far:
// more than a screen and a half, a blur of words otherwise); while it
// glides, the window grows only below (pr_gliding).
pr_gliding: bool = false;

pr_glide_to(c: int, i: int) {
    _y: f64 = pr_index_y(c, i);
    if (!pr_found) _near: bool = pw_reach(c, if (i >= 0) pr_anchor_part(c, i) else 0);
    y: f64 = pr_index_y(c, i);
    if (!pr_found) {
        pw_commit();
        pr_jump_to_anchor(c, i);
        return
    }
    // (Room below the place for the screen, so that a glide ends where it
    // aims; the window made so before the table moves.)
    while (pw_height() - (y + view_height(pr_table)) < 0.0f64) {
        pw_after(pw_c[pw_n - 1], pw_p[pw_n - 1]);
        if (pw_next_c < 0)
            break;
        pw_add_below(pw_next_c, pw_next_p)
    }
    pw_commit();
    y = pr_index_y(c, i);
    to: f64 = y - top_inset(pr_table);
    d: f64 = to - offset_y(pr_table);
    if (d < 0.0f64) d = -d;
    if (d > view_height(pr_table) * 1.5f64 || reduce_motion()) {
        pr_set_offset(to);
        pr_fill_soon();
        return
    }
    if (d < 1.0f64) {
        pr_place_tell();
        return
    }
    pr_gliding = true;
    pr_glide_until = CACurrentMediaTime() + PR_GLIDE_SECONDS;
    msg_ff1(pr_table, sel("setContentOffset:animated:"), 0.0f64, to, 1);
    pr_fill_soon()
}

// The window grown to reach part p of chapter c, if it is a few parts
// beyond either end (its glide stopped first, to grow above); whether it
// does now.
PW_REACH_PARTS: int = 6;

pw_reach(to_c: int, p: int): bool {
    if (pw_n == 0) return false;
    c: int = if (p == 0) pr_row_chapter(to_c) else to_c;
    if (c > pw_c[pw_n - 1] || c == pw_c[pw_n - 1] && p > pw_p[pw_n - 1]) {
        for _step in 0..PW_REACH_PARTS {
            pw_after(pw_c[pw_n - 1], pw_p[pw_n - 1]);
            if (pw_next_c < 0) return false;
            pw_add_below(pw_next_c, pw_next_p);
            if (pw_next_c == c && pw_next_p == p) return true
        }
        return false
    }
    if (c < pw_c[0] || c == pw_c[0] && p < pw_p[0]) {
        pr_glide_stop();
        for _step in 0..PW_REACH_PARTS {
            pw_before(pw_c[0], pw_p[0]);
            if (pw_next_c < 0) return false;
            pw_add_above(pw_next_c, pw_next_p);
            if (pw_next_c == c && pw_next_p == p) return true
        }
        return false
    }
    true
}

// Its glide ended (scrollViewDidEndScrollingAnimation), or stopped.
// Following the page, at rest: where its verse is checked again (a glide
// cut short goes on).
pr_glide_ended() {
    pr_gliding = false;
    pr_place_tell();
    if (pr_linked && !link_leader_panel && table != 0 && !touched(table)) {
        pr_glided_forget();
        pr_follow_page()
    }
    pr_fill_soon()
}

// When a glide is over at the latest (UIKit's take about a third of a
// second; one cut short isn't said to end).
PR_GLIDE_SECONDS: f64 = 0.6f64;

pr_glide_until: f64 = 0.0f64;

pr_glide_stop() {
    if (!pr_gliding || pr_table == 0) return;
    pr_gliding = false;
    pr_set_offset(offset_y(pr_table))
}

// ---- its place ----
// Its top told to core as its verse changes: the chapter there, the verse
// (0 above the first), thousandths of an em into it.
pr_place_tell() {
    if (!pr_measure()) return;
    c: int = pr_at_c;
    v: int = pr_at_v;
    frac: int = pr_at_frac;
    if (c == pr_told_c && v == pr_told_v) return;
    pr_told_c = c;
    pr_told_v = v;
    to_core_str("besideplace");
    to_core_arg(c);
    to_core_arg(v);
    to_core_arg(if (frac < 0) 0 else frac);
    to_core_end();
    uk_effects()
}

// Its top: the chapter there, the anchor at or before it (-1 above its
// first), the verse (0 above the first), thousandths of an em into it, and
// how far through the anchor's span (pr_at_*); whether it is in the window.
pr_at_c: int = -1;

pr_at_i: int = -1;

pr_at_v: int = 0;

pr_at_frac: int = 0;

pr_measure(): bool {
    if (pr_table == 0 || pw_n == 0) return false;
    top: f64 = offset_y(pr_table) + top_inset(pr_table);
    k: int = pw_row_at(top);
    // (A gap's placeholder: the page's chapter, if it is in the gap.)
    c: int = if (pw_last[k] > pw_c[k] && cur >= pw_c[k] && cur <= pw_last[k]) cur else pw_c[k];
    into: f64 = top - pw_y[k];
    // (The last of its verses at or before the top; else the last of the
    // rows above's in the chapter; else none.)
    i: int = -1;
    for j in 0..pw_vn[k]
        if (pw_vy[k * PW_VERSES_MOST + j] <= into) i = pw_first[k] + j;
    if (i < 0) i = pw_first[k] - 1;
    v: int = if (i >= 0) pr_anchor_verse(c, i) else 0;
    if (v < 0) v = 0;
    y: f64 = pr_index_y(c, if (v > 0) i else -1);
    pr_at_c = c;
    pr_at_i = (if (v > 0) i else -1);
    pr_at_v = v;
    pr_at_frac = ((top - y) * 1000.0f64 / em) as int;
    true
}

// Its scroll: the window kept ahead of it (not while it glides by itself:
// the table's header set again would cut the glide short; room for where
// it goes was made before), its place told; moved by a finger (or gliding
// after one) while linked and leading, the page kept with it.
pr_scrolled() {
    if (pr_self == 0 && !pr_gliding) _full: bool = pw_fill(pw_margin_moving(), 1);
    pr_place_tell();
    if (pr_self == 0 && pr_linked && link_leader_panel && touched(pr_table)) pr_lead_page()
}

// Which leads, linked: the one a finger last touched (the panel's reader,
// or else the page). A finger on one stops the other's glide, so that it
// can be held still.
link_leader_panel: bool = false;

// A finger down on the page: it leads, the reader's glide stopped.
pr_page_touched() {
    link_leader_panel = false;
    pr_glided_forget();
    pr_glide_stop();
    if (pr_table != 0 && (msg(pr_table, sel("isDecelerating")) & 255) != 0) pr_set_offset(offset_y(pr_table))
}

// Whether scroll view sv is moving by a finger, or gliding after one (not
// moved by the app).
touched(sv: int): bool {
    (msg(sv, sel("isTracking")) & 255) != 0 || (msg(sv, sel("isDecelerating")) & 255) != 0 || devwire_gliding(sv)
}

// Whether the page or the reader moves.
pr_moving(): bool {
    pr_table != 0 && (touched(pr_table) || pr_gliding) || table != 0 && touched(table)
}

// ---- linked, moving together ----
// The two kept at the same verse, as far through it as each other, at each
// one's reading line (the page's a third of the way down, the reader's its
// top): each version's verses are as long as they are, so the one followed
// is placed that far through its own. A verse runs from the top of the
// line its number begins to the top of the next verse's (the chapter's top
// before its first verse; the next chapter's top after its last), so that
// a reading line moving smoothly through one reader moves the other
// smoothly too, verse to verse and chapter to chapter.

// Whether the reader is linked with the page (its screen's `reader` line).
pr_linked: bool = false;

// The page, or the panel's reader.
type LinkSide =
    | Page
    | Panel

// Chapter c's key in the chapters kept, on side.
side_key(side: LinkSide, c: int): int {
    match side {
        Page -> c;
        Panel -> PR_KEY + c
    }
}

side_table(side: LinkSide): int {
    match side {
        Page -> table;
        Panel -> pr_table
    }
}

// Where chapter c's row begins, and its verse v, down from the side's
// table's top.
side_row_y(side: LinkSide, c: int): f64 {
    match side {
        Page -> {
            l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), chapter_path(c),
                0, 0);
            hfa[1]
        }
        Panel -> pr_chapter_y(c)
    }
}

side_verse_y(side: LinkSide, c: int, v: int): f64 {
    match side {
        Page -> verse_y(c, v);
        Panel -> pr_verse_y(c, v)
    }
}

// Where verse index i of chapter c begins on a side (the panel's may have
// a verse more than once).
side_index_y(side: LinkSide, c: int, i: int): f64 {
    match side {
        Page -> verse_y(c, link_verse_num(c, i));
        Panel -> pr_index_y(c, i)
    }
}

// The side's reading line, down its table (and how far below its offset
// that is).
side_line_below(side: LinkSide): f64 {
    match side {
        Page -> top_inset(table) + reading_line();
        Panel -> top_inset(pr_table)
    }
}

side_top(side: LinkSide): f64 {
    offset_y(side_table(side)) + side_line_below(side)
}

// The verses of a chapter in order, each once: their count and the i-th's
// number (in the chapter kept as key).
// (The panel's chapter's (PR_KEY plus it): its anchors.)
link_verse_count(key: int): int {
    if (key >= PR_KEY) return pr_anchor_count(key - PR_KEY);
    s: int = rs_need(key);
    if (s < 0) 0 else rs_v_n[s]
}

link_verse_num(key: int, i: int): int {
    if (key >= PR_KEY) return pr_anchor_verse(key - PR_KEY, i);
    s: int = rs_need(key);
    if (s < 0 || i < 0 || i >= rs_v_n[s]) -1 else rs_v_num[s * VS_MOST + i]
}

// A verse's span on a side (span_a to span_b, down from its table's top):
// verse index i of chapter c (-1: above its first).
span_a: f64 = 0.0f64;

span_b: f64 = 0.0f64;

link_span(side: LinkSide, c: int, i: int) {
    key: int = side_key(side, c);
    n: int = link_verse_count(key);
    span_a = (if (i < 0) side_row_y(side, c) else side_index_y(side, c, i));
    span_b = (if (i + 1 < n) side_index_y(side, c, i + 1) else if (c + 1 < chapters_n) side_row_y(side,
        c + 1) else span_a + view_height(side_table(side)))
}

// Where a side's reading line is: its chapter, the index of the verse
// whose span holds it (-1 above the first), and how far through that span
// (0 to 1): at_c, at_i, at_part. The page's search starts at the index
// last found there; the reader's is measured (pr_measure).
at_c: int = -1;

at_i: int = -1;

at_part: f64 = 0.0f64;

link_hint_page: int = -1;

link_locate(side: LinkSide): bool {
    y: f64 = side_top(side);
    match side {
        Panel -> {
            if (!pr_measure()) return false;
            at_c = pr_at_c;
            at_i = pr_at_i;
            link_span(side, at_c, at_i);
            d: f64 = span_b - span_a;
            at_part = (if (d < 1.0f64) 0.0f64 else (y - span_a) / d);
            if (at_part < 0.0f64) at_part = 0.0f64;
            if (at_part > 1.0f64) at_part = 1.0f64;
            return true
        }
        Page -> { }
    }
    if (table == 0) return false;
    path: int = msg_ff(table, sel("indexPathForRowAtPoint:"), 40.0f64, y + 1.0f64);
    if (path == 0) return false;
    c: int = msg(path, sel("row"));
    n: int = link_verse_count(c);
    i: int = link_hint_page;
    if (i >= n) i = n - 1;
    if (i < -1) i = -1;
    // (Back while above the verse's start; on while past the next's. Far
    // from the hint, found by halves first: the verses' starts go down in
    // order.)
    link_span(side, c, i);
    if (y < span_a || y >= span_b) {
        low: int = -1;
        high: int = n - 1;
        while (low < high) {
            mid: int = (low + high + 1) / 2;
            if (side_index_y(side, c, mid) <= y) low = mid else high = mid - 1
        }
        i = low;
        link_span(side, c, i)
    }
    while (i >= 0 && y < span_a) {
        i = i - 1;
        link_span(side, c, i)
    }
    while (i + 1 < n && y >= span_b) {
        i = i + 1;
        link_span(side, c, i)
    }
    link_hint_page = i;
    at_c = c;
    at_i = i;
    d: f64 = span_b - span_a;
    at_part = (if (d < 1.0f64) 0.0f64 else (y - span_a) / d);
    if (at_part < 0.0f64) at_part = 0.0f64;
    if (at_part > 1.0f64) at_part = 1.0f64;
    true
}

// ---- the curve between them ----
// Where the follower's top goes for the leader's at y: through the verses'
// starts on both sides (each verse lands where it begins), and between
// them along a monotone cubic (Fritsch and Carlson's), its slope at each
// verse's start the harmonic mean of the two verses' ratios either side, so
// that the follower's speed changes gradually from verse to verse, never
// at once, and it never moves against the leader.

// The start of the span of verse v of chapter c on side (v 0: the chapter's
// top, above its first verse; LINK_NEXT: the next chapter's top), and
// whether the side has that verse.
LINK_NEXT: int = -2;

link_found: bool = false;

link_anchor(side: LinkSide, c: int, v: int): f64 {
    link_found = true;
    if (v == 0) return side_row_y(side, c);
    if (v == LINK_NEXT) return if (c + 1 < chapters_n) side_row_y(side, c + 1) else side_row_y(side,
        c) + view_height(side_table(side)) * 4.0f64;
    has: bool = match side {
        Page -> verse_unit(c, v) >= 0;
        Panel -> pr_anchor_of(c, v) >= 0
    };
    if (!has) {
        link_found = false;
        return 0.0f64
    }
    y: f64 = side_verse_y(side, c, v);
    // (The reader's: only where its part is in the window.)
    match side {
        Panel -> link_found = pr_found;
        Page -> { }
    }
    y
}

// The leader's verse number k places from its index i (-1: above the
// first, 0; past the last, LINK_NEXT).
link_number(key: int, i: int): int {
    n: int = link_verse_count(key);
    if (i < 0) return 0;
    if (i >= n) return LINK_NEXT;
    link_verse_num(key, i)
}

// The ratio of a follower's span to a leader's (its slope there).
link_ratio(
    l0: f64,
    l1: f64,
    f0: f64,
    f1: f64
): f64 {
    if (l1 - l0 < 1.0f64) 1.0f64 else (f1 - f0) / (l1 - l0)
}

// The harmonic mean of two slopes (0 if either isn't forward).
link_mean(a: f64, b: f64): f64 {
    if (a <= 0.0f64 || b <= 0.0f64) 0.0f64 else 2.0f64 * a * b / (a + b)
}

// The follower's y for the leader's top in chapter c, verse index i (as
// link_locate found it), part of the way through that span.
link_map(
    leader: LinkSide,
    follower: LinkSide,
    c: int,
    i: int,
    part: f64
): f64 {
    lkey: int = side_key(leader, c);
    // (The two verses' starts the top is between, and one either side.)
    va: int = link_number(lkey, i);
    vb: int = link_number(lkey, i + 1);
    l1: f64 = link_anchor(leader, c, va);
    l2: f64 = link_anchor(leader, c, vb);
    f1: f64 = link_anchor(follower, c, va);
    ok1: bool = link_found;
    f2: f64 = link_anchor(follower, c, vb);
    ok2: bool = link_found;
    // (A verse the follower hasn't: its chapter's top, as far through.)
    if (!ok1 || !ok2) {
        top: f64 = link_anchor(follower, c, 0);
        end: f64 = link_anchor(follower, c, LINK_NEXT);
        return top + part * (end - top)
    }
    m: f64 = link_ratio(l1, l2, f1, f2);
    d1: f64 = m;
    d2: f64 = m;
    if (i >= 0) {
        v0: int = link_number(lkey, i - 1);
        l0: f64 = link_anchor(leader, c, v0);
        f0: f64 = link_anchor(follower, c, v0);
        if (link_found && l1 - l0 >= 1.0f64) d1 = link_mean(link_ratio(l0, l1, f0,
            f1), m)
    }
    if (vb != LINK_NEXT) {
        v3: int = link_number(lkey, i + 2);
        l3: f64 = link_anchor(leader, c, v3);
        f3: f64 = link_anchor(follower, c, v3);
        if (link_found && l3 - l2 >= 1.0f64) d2 = link_mean(m, link_ratio(l2, l3,
            f2, f3))
    }
    h: f64 = l2 - l1;
    t: f64 = part;
    t2: f64 = t * t;
    t3: f64 = t2 * t;
    (2.0f64 * t3 - 3.0f64 * t2 + 1.0f64) * f1 + (t3 - 2.0f64 * t2 + t) * h * d1 + (-2.0f64 * t3 + 3.0f64 * t2) * f2 + (t3 - t2) * h * d2
}

// ---- near the verses, at a steady speed ----
// The curve through every verse's start still changes speed from verse to
// verse, as much as their lengths differ. The follower goes instead along a
// steadier line, fitted through the verses' starts about LINK_REACH_LINES
// either way (each weighted less the farther it is), but is kept within
// half a line of the curve (softly: the nearer the limit, the less it moves
// apart), so that no verse is ever more than that from its place.
LINK_REACH_LINES: f64 = 6.0f64;

LINK_SLACK_EM: f64 = 0.5f64;

// How many verses either way the line is fitted through.
LINK_FIT_VERSES: int = 5;

// The follower's y for the leader's top at y (in chapter c, verse index i,
// part of the way through it, as link_locate found it).
link_map_near(
    leader: LinkSide,
    follower: LinkSide,
    c: int,
    i: int,
    part: f64,
    y: f64
): f64 {
    exact: f64 = link_map(leader, follower, c, i, part);
    lkey: int = side_key(leader, c);
    n: int = link_verse_count(lkey);
    reach: f64 = em * 1.5f64 * LINK_REACH_LINES;
    // (A weighted least-squares line through the starts, x the leader's y
    // from the top's, so that its value at the top is its intercept.)
    sw: f64 = 0.0f64;
    sx: f64 = 0.0f64;
    sy: f64 = 0.0f64;
    sxx: f64 = 0.0f64;
    sxy: f64 = 0.0f64;
    from: int = if (i - LINK_FIT_VERSES < -1) -1 else i - LINK_FIT_VERSES;
    to: int = if (i + LINK_FIT_VERSES + 1 > n) n else i + LINK_FIT_VERSES + 1;
    for k in from..to + 1 {
        v: int = link_number(lkey, k);
        l: f64 = link_anchor(leader, c, v);
        f: f64 = link_anchor(follower, c, v);
        if (link_found) {
            x: f64 = l - y;
            u: f64 = x / reach;
            w: f64 = 1.0f64 / ((1.0f64 + u * u) * (1.0f64 + u * u));
            sw = sw + w;
            sx = sx + w * x;
            sy = sy + w * f;
            sxx = sxx + w * x * x;
            sxy = sxy + w * x * f
        }
    }
    det: f64 = sw * sxx - sx * sx;
    if (sw <= 0.0f64 || det <= 0.000001f64 * sw * sw) return exact;
    slope: f64 = (sw * sxy - sx * sy) / det;
    if (slope <= 0.0f64) return exact;
    steady: f64 = (sy - slope * sx) / sw;
    // (Kept near the curve: apart by d, it goes d / (1 + |d| / slack).)
    slack: f64 = em * LINK_SLACK_EM;
    d: f64 = steady - exact;
    far: f64 = if (d < 0.0f64) -d else d;
    exact + d / (1.0f64 + far / slack)
}

// ---- following by comment ----
// Whether the reader follows the page comment by comment (a commentary's:
// its screen's `reader` line), and the verse it last went to (its
// chapter, -1 none, and verse).
pr_by_comment: bool = false;

pr_glided_c: int = -1;

pr_glided_v: int = -1;

// The verse gone to forgotten: the follower moved some other way (a finger
// on either, a jump), so the next one is gone to even if it is the one
// before.
pr_glided_forget() {
    pr_glided_c = -1;
    pr_glided_v = -1
}

// Whether verse index i of the reader's chapter c is where verse v is
// commented on: its verse at or before v, and the next of the chapter's
// anchors that goes further than it past v. (A commentator going back a
// verse or two, as Spurgeon's notes on one verse cite the one before, or
// through the verses again, doesn't end the run: the anchor before goes on
// only until the verses go further.)
pr_covers(c: int, i: int, v: int): bool {
    a: int = pr_anchor_verse(c, i);
    a > 0 && a <= v && pr_anchor_reach(c, i) > v
}

// The verse index of the first place in the reader's chapter c where
// verse v is commented on (-1: none, the chapter's top).
pr_comment_first(c: int, v: int): int {
    for i in 0..pr_anchor_count(c)
        if (pr_covers(c, i, v)) return i;
    -1
}

// Of the places in the reader's chapter c where verse v is commented on
// (one each time the commentator goes through the verses), the nearest to
// the reader's top: those in the window by where they are, others by how
// many parts away (-1: none, the chapter's top).
pr_comment_nearest(c: int, v: int): int {
    top: f64 = side_top(LinkSide.Panel);
    here: int = if (pw_n == 0) 0 else pw_p[pw_row_at(top)];
    best: int = -1;
    best_d: f64 = 0.0f64;
    for i in 0..pr_anchor_count(c) {
        if (pr_covers(c, i, v)) {
            y: f64 = pr_index_y(c, i);
            d: f64 = if (pr_found) y - top else (pr_anchor_part(c, i) - here) as f64 * view_height(pr_table);
            if (d < 0.0f64) d = -d;
            if (best < 0 || d < best_d) {
                best = i;
                best_d = d
            }
        }
    }
    best
}

// The page moved by a finger, the reader following by comment: as the
// page's reading line comes to a verse the reader's comment isn't on, the
// reader goes to the nearest comment on it (a long comment stays while
// its verses are read). Either way, the one followed moves only at a
// comment's border, never creeping.
// (While a finger drags the page, a step at most each PR_STEP_SECONDS;
// while it glides after a flick, none: it passes a verse every few frames,
// each comment some parts on in the reader, and no one reads it. At rest
// the reader settles at the page's verse.)
PR_STEP_SECONDS: f64 = 0.25f64;

pr_stepped_at: f64 = 0.0f64;

pr_follow_by_comment() {
    if (!link_locate(LinkSide.Page)) return;
    c: int = at_c;
    v: int = if (at_i < 0) 0 else link_verse_num(c, at_i);
    if (c == pr_glided_c && v == pr_glided_v) return;
    now: f64 = CACurrentMediaTime();
    if (table != 0 && ((msg(table, sel("isDecelerating")) & 255) != 0 || devwire_gliding(table) && now - dw_glide_t0 > 0.25f64)) return;
    if (table != 0 && touched(table) && now - pr_stepped_at < PR_STEP_SECONDS) return;
    pr_glided_c = c;
    pr_glided_v = v;
    if (!pr_known(c)) _first: int = rs_need(pr_part_key(c, 0));
    // (The reader at a comment on that verse already, wherever in it: it
    // stays (its place told: a gap's placeholder stands for the page's
    // chapter). A long comment is a long way to its start.)
    if (pr_measure() && pr_at_c == c && (if (pr_at_i < 0) v == 0 else pr_covers(c,
        pr_at_i, v))) {
        pr_place_tell();
        return
    }
    pr_stepped_at = now;
    pr_glide_to(c, if (v == 0) -1 else pr_comment_nearest(c, v))
}

// The page moved by a finger: the panel's reader with it.
pr_follow_page() {
    if (pr_table == 0 || !pr_linked || link_leader_panel || chapters_n == 0) return;
    if (pr_by_comment) {
        pr_follow_by_comment();
        return
    }
    if (!link_locate(LinkSide.Page)) return;
    c: int = at_c;
    v: int = if (at_i < 0) 0 else link_verse_num(c, at_i);
    // (The verse's part in the window: grown to it if it is near, else
    // there at once.)
    if (!pr_known(c)) _first: int = rs_need(pr_part_key(c, 0));
    i: int = if (v > 0) pr_anchor_of(c, v) else -1;
    if (!pw_reach(c, if (i >= 0) pr_anchor_part(c, i) else 0)) {
        pw_commit();
        pr_jump(c, v)
    }
    pw_commit();
    pr_set_offset(link_map_near(LinkSide.Page, LinkSide.Panel, c, at_i, at_part, side_top(LinkSide.Page)) - side_line_below(LinkSide.Panel));
    // (Moved by the app, not a finger: the window kept ahead of it here.)
    _full: bool = pw_fill(pw_margin_moving(), 1);
    pr_place_tell()
}

// The panel's reader, following by comment, moved by a finger: the page
// glides to the first verse of the comment at its top as that changes (it
// stays while a comment is read), that verse at its reading line. A verse
// commented on again later (notes after an exposition) takes the page back
// to it.
pr_lead_by_comment() {
    if (!link_locate(LinkSide.Panel)) return;
    c: int = at_c;
    i: int = at_i;
    v: int = if (i < 0) 0 else pr_anchor_verse(c, i);
    if (c == pr_glided_c && v == pr_glided_v) return;
    pr_glided_c = c;
    pr_glided_v = v;
    // (The page at a verse that comment is on already: it stays.)
    if (i >= 0 && view_of(c) != 0 && link_locate(LinkSide.Page) && at_c == c && pr_covers(c,
        i, if (at_i < 0) 0 else link_verse_num(c, at_i))) return;
    if (view_of(c) == 0) {
        go_verse(c, v);
        place_tell();
        return
    }
    // (While they move, where the verse nearly is, and exactly once they
    // rest.)
    at: VerseY = if (pr_moving()) verse_y_soon(c, v) else VerseY { y: verse_y(c, v), exact: true };
    if (!at.exact) pr_glided_forget();
    y: f64 = at.y - side_line_below(LinkSide.Page);
    least: f64 = -top_inset(table);
    msg_ff1(table, sel("setContentOffset:animated:"), 0.0f64, if (y < least) least else y,
        if (reduce_motion()) 0 else 1)
}

// The panel's reader moved by a finger: the page with it.
pr_lead_page() {
    if (pr_by_comment) {
        pr_lead_by_comment();
        return
    }
    if (table == 0 || !link_locate(LinkSide.Panel)) return;
    c: int = at_c;
    if (view_of(c) == 0) go_verse(c, if (at_i < 0) 0 else pr_anchor_verse(c, at_i));
    set_offset(link_map_near(LinkSide.Panel, LinkSide.Page, c, at_i, at_part, side_top(LinkSide.Panel)) - side_line_below(LinkSide.Page));
    find_place();
    place_tell()
}

// ---- at rest ----
// The page at rest (reader_rested), or the reader: the follower where the
// leader's reading line is (a glide may have stopped short of it), and the
// window filled out.
pr_page_rested() {
    if (pr_table == 0) return;
    if (pr_linked && !link_leader_panel) {
        pr_glided_forget();
        pr_follow_page()
    }
    pr_fill_soon()
}

pr_panel_rested() {
    if (pr_table == 0) return;
    pr_place_tell();
    if (pr_linked && link_leader_panel) {
        pr_glided_forget();
        pr_lead_page()
    }
    pr_fill_soon()
}

// ---- made again ----
// `besiderelayout`: every chapter made again (the look or the settings
// changed): the window made again at its place.
pr_relayout() {
    if (pr_table == 0) return;
    pr_parts_forget();
    pr_rebuild()
}

// Where the reader is to open, once its table is in the window (a jump
// before then has no width to lay out at): -1 none.
pr_open_c: int = -1;

pr_open_v: int = 0;

// Its table made the panel's reader, opened at chapter c, verse v as soon
// as the screen is shown.
pr_attach_later(t: int, c: int, v: int) {
    pr_open_c = c;
    pr_open_v = v;
    pr_table = t;
    _t: int = after_common(0.05f64, "besideOpened:")
}

// (The timer's: the reader made and opened where it was to; the chapters
// not counted yet (a launch's first lines), when they are.)
pr_opened(_self: int, _cmd: int, _timer: int): int {
    if (chapters_n == 0) return 0;
    if (pr_table != 0 && pr_open_c >= 0) pr_attach(pr_table, pr_open_c, pr_open_v);
    pr_open_c = -1;
    0
}

// The reader's screen coming into sight (a launch's, a reload's, the panel
// opened again): made again where it was to open, or is.
pr_appeared() {
    if (chapters_n == 0) return;
    pr_count_changed()
}

// The page's chapters counted (`reader N`, a launch's or a version's):
// the panel's reader made again, at its place (or opened, if it waited).
pr_count_changed() {
    if (pr_table == 0) return;
    if (pr_open_c >= 0) {
        c: int = pr_open_c;
        pr_open_c = -1;
        pr_attach(pr_table, c, pr_open_v);
        return
    }
    pr_parts_forget();
    pr_rebuild()
}

// Chapter c's comments come (`besidechapterready C`): the rows of it that
// held their places made again with them, where they are.
pr_chapter_came(c: int) {
    if (pr_table == 0 || c < 0 || c >= chapters_n) return;
    for k in 0..pw_n {
        if (pw_c[k] == c && rs_slot(pr_part_key(c, pw_p[k])) >= 0) pw_redress(k)
    }
    pr_fill_soon()
}

// A finger's drag begun on it: a hand moves it now (linked, it leads the
// page, the page's glide stopped).
pr_drag_began() {
    link_leader_panel = true;
    pr_glided_forget();
    pr_gliding = false;
    if (table != 0 && (msg(table, sel("isDecelerating")) & 255) != 0) msg_ff1(table,
        sel("setContentOffset:animated:"), 0.0f64, offset_y(table), 0);
    to_core_str("besidemoving");
    to_core_end();
    uk_effects()
}
