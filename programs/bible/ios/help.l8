tag bible_ios;

use_tag std, ios, bible;

// Native Manual presentation: help.txt is mapped when the Manual first opens,
// outside launch. It presents contents, search and pages: headings,
// paragraphs, symbols drawn
// inline, links, opened at a part with its heading washed, and read by
// VoiceOver part by part. It also provides Reading settings' Help section.
// Legacy defaults tipCurrent, tipDay, tipSeen, helpUsed and showTips are
// ignored; opening the Manual does not read or migrate them.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/store.l8";

import "../core/help.l8";

extern msg_f32_i(
    receiver: int,
    selector: int,
    p: f32,
    axis: int
): int = objc_msgSend;

// ---- the file, and what is kept ----
help_mapped: bool = false;

help_load() {
    if (help_mapped) return;
    help_mapped = true;
    hlp = lang_map("help", "txt");
    hlp_n = lang_mapped;
    help_index();
    note_num("bible: help parts ", hpt_n);
    if (he_n > 0 && diag_on) {
        note_num("bible: help problems ", he_n);
        note_ns(nsstring_of(hlog, hlog_n))
    }
}

// A string of the defaults' into out: its length.
def_string(key: str, out: []i8): int {
    nsstring_into(msg1(defaults(), sel("stringForKey:"), nsstring(key)), out)
}

set_def_string(key: str, b: []i8, n: int) {
    msg2(defaults(), sel("setObject:forKey:"), nsstring_of(b, n), nsstring(key))
}

// ---- the Manual ----
// The contents: core's screen (core/skin.l8's SCR_MANUAL), pushed in the
// sheet on top (Go To's or Reading settings').
help_open_manual() {
    sheet_nav: int = top_presented();
    if (sheet_nav == 0) return;
    help_load();
    help_grow(sheet_nav);
    note("bible: manual");
    uk_open(SCR_MANUAL, 0, true, sheet_nav)
}

// Reading settings' sheet (medium only) made large for the Manual, as
// for the acknowledgements.
help_grow(sheet_nav: int) {
    if (sheet_nav != settings_nav || settings_nav == 0) return;
    sheet: int = msg(settings_nav, sel("sheetPresentationController"));
    if (sheet == 0) return;
    one[0] = msg(cls("UISheetPresentationControllerDetent"), sel("mediumDetent"));
    one[1] = msg(cls("UISheetPresentationControllerDetent"), sel("largeDetent"));
    msg1(sheet, sel("setDetents:"), nsarray(one, 2));
    msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierLarge"))
}

// Page g pushed in the sheet on top (core's SCR_HELP_PAGE), at part t
// (-1: its top), its heading washed if wash (the demos').
help_open_page(g: int, t: int, wash: bool) {
    sheet_nav: int = top_presented();
    if (sheet_nav == 0 || g < 0) return;
    help_load();
    if (g >= hpg_n) return;
    help_grow(sheet_nav);
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: manual page ");
        fput_bytes(hlp, hpg_id_b[g], hpg_id_e[g]);
        if (t >= 0) {
            fput_str(" at ");
            help_fput_anchor(t)
        }
        note_ns(fstring())
    }
    uk_open(SCR_HELP_PAGE, (g * 1000 + t + 1) * 2 + (if (wash && t >= 0) 1 else 0),
        true, sheet_nav)
}
