tag bible_ios;

use_tag std, ios, bible;

// The Manual (DESIGN.md §15; the quick tips removed, owner 2026-10-21:
// §15.11): help.txt mapped at the first Manual (never at launch); the Manual
// (its contents, its search, a page: headings, paragraphs, symbols drawn
// inline, links, opened at a part with its heading washed, and read by
// VoiceOver part by part); and Reading settings' Help section (Manual).
// (tipCurrent, tipDay, tipSeen, helpUsed and showTips, in an older build's
// defaults, are left there unread.)
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/store.l8";

import "../core/help.l8";

extern msg_f32_i(
    receiver: int,
    selector: int,
    p: f32,
    axis: int
): int = objc_msgSend;

// ---- the file, and what is kept ----
help_mapped: bool = false;

help_load() {
    if (help_mapped) return;
    help_mapped = true;
    hlp = lang_map("help", "txt");
    hlp_n = lang_mapped;
    help_index();
    note_num("bible: help parts ", hpt_n);
    if (he_n > 0 && diag_on) {
        note_num("bible: help problems ", he_n);
        note_ns(nsstring_of(hlog, hlog_n))
    }
}

// A string of the defaults' into out: its length.
def_string(key: str, out: []i8): int {
    nsstring_into(msg1(defaults(), sel("stringForKey:"), nsstring(key)), out)
}

set_def_string(key: str, b: []i8, n: int) {
    msg2(defaults(), sel("setObject:forKey:"), nsstring_of(b, n), nsstring(key))
}

// A sans font at size (scaled with the phone's text size) and weight.
help_font(size: f64, weight: f64): int {
    m: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    msg1(m, sel("scaledFontForFont:"), sans(size, weight))
}

// ---- the Manual (§15.3) ----
// The contents: core's screen (core/skin.l8's SCR_MANUAL), pushed in the
// sheet on top (Go To's or Reading settings').
help_open_manual() {
    sheet_nav: int = top_presented();
    if (sheet_nav == 0) return;
    help_load();
    help_grow(sheet_nav);
    note("bible: manual");
    uk_open(SCR_MANUAL, 0, true, sheet_nav)
}

// Reading settings' sheet (medium only) made large for the Manual, as
// for the acknowledgements.
help_grow(sheet_nav: int) {
    if (sheet_nav != settings_nav || settings_nav == 0) return;
    sheet: int = msg(settings_nav, sel("sheetPresentationController"));
    if (sheet == 0) return;
    one[0] = msg(cls("UISheetPresentationControllerDetent"), sel("mediumDetent"));
    one[1] = msg(cls("UISheetPresentationControllerDetent"), sel("largeDetent"));
    msg1(sheet, sel("setDetents:"), nsarray(one, 2));
    msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierLarge"))
}

// ---- a page (§15.3.3) ----
// The pages pushed (a page may push another, by a link): each one's
// controller, text view, page, the part to scroll to once laid out (-1
// none) and whether to wash its heading, its wash, and the width its
// VoiceOver parts were placed for.
HPV_MOST: int = 8;

hpv_vc: []int = new int[8](0);

hpv_tv: []int = new int[8](0);

hpv_page: []int = new int[8](0);

hpv_part: []int = new int[8](-1);

hpv_washes: []bool = new bool[8](false);

hpv_wash: []int = new int[8](0);

hpv_w: []f64 = new f64[8](0.0f64);

hpv_next: int = 0;

help_page_class: int = 0;

// Each part's heading, and each paragraph, where it is in its page's text
// (UTF-16), as last made.
hpt_at: []int = new int[256](0);

hpt_len: []int = new int[256](0);

hpa_at: []int = new int[1024](0);

hpa_len: []int = new int[1024](0);

k_help_link: str = "L8HelpLink";

// Page g pushed in the sheet on top, at part t (-1: its top), its heading
// washed if wash.
help_open_page(g: int, t: int, wash: bool) {
    sheet_nav: int = top_presented();
    if (sheet_nav == 0 || g < 0 || g >= hpg_n) return;
    help_load();
    help_grow(sheet_nav);
    k: int = hpv_next;
    hpv_next = (hpv_next + 1) % HPV_MOST;
    hpv_vc[k] = held(hpv_vc[k], 0);
    hpv_tv[k] = held(hpv_tv[k], 0);
    hpv_wash[k] = held(hpv_wash[k], 0);
    vc: int = msg(make_class_object(help_page_class), sel("autorelease"));
    msg1(vc, sel("setTitle:"), ns_of(hlp, hpg_title_b[g], hpg_title_e[g]));
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    msg1(item, sel("setRightBarButtonItem:"), system_item(0, "closeSheet:"));
    view: int = msg(vc, sel("view"));
    msg1(view, sel("setBackgroundColor:"), sheet_bg());
    tv: int = 0;
    if (responds(cls("UITextView"), "textViewUsingTextLayoutManager:")) tv = msg1(cls("UITextView"),
        sel("textViewUsingTextLayoutManager:"), 0) else tv = msg(make("UITextView"),
        sel("autorelease"));
    msg1(tv, sel("setEditable:"), 0);
    msg1(tv, sel("setSelectable:"), 1);
    msg1(tv, sel("setBackgroundColor:"), sheet_bg());
    msg1(tv, sel("setTintColor:"), c_accent);
    msg_rect(tv, sel("setTextContainerInset:"), 20.0f64, 20.0f64, 28.0f64, 20.0f64);
    msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
    msg1(tv, sel("setAutoresizingMask:"), 18);
    msg1(tv, sel("setTag:"), g + 1);
    l8_msg_hfa(hfa, view, sel("bounds"), 0, 0, 0);
    msg_rect(tv, sel("setFrame:"), 0.0f64, 0.0f64, hfa[2], hfa[3]);
    msg1(tv, sel("setAttributedText:"), help_page_text(g));
    tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("helpPageTapped:"));
    msg1(tap, sel("setDelegate:"), app_obj);
    msg1(tv, sel("addGestureRecognizer:"), tap);
    release(tap);
    msg1(tv, sel("setIsAccessibilityElement:"), 0);
    msg1(view, sel("addSubview:"), tv);
    hpv_vc[k] = held(0, vc);
    hpv_tv[k] = held(0, tv);
    hpv_page[k] = g;
    hpv_part[k] = t;
    hpv_washes[k] = wash && t >= 0;
    hpv_w[k] = 0.0f64;
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: manual page ");
        fput_bytes(hlp, hpg_id_b[g], hpg_id_e[g]);
        if (t >= 0) {
            fput_str(" at ");
            help_fput_anchor(t)
        }
        note_ns(fstring())
    }
    msg2(sheet_nav, sel("pushViewController:animated:"), vc, 1)
}

make_class_object(c: int): int {
    msg(msg(c, sel("alloc")), sel("init"))
}

// The page's text: each part's heading (Headline), its paragraphs (Body,
// 0.6 em apart), **bold** semibold, _italic_ italic, symbols drawn at the
// text's size and weight in ink, links in the accent.
help_page_text(g: int): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    head: int = msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleHeadline"));
    body_font: int = msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleBody"));
    size: f64 = msg_f(body_font, sel("pointSize"));
    bold: int = help_font(17.0f64, 0.3f64);
    ital: int = help_scaled(italic_sans(17.0f64));
    bold_ital: int = bold;
    first: bool = true;
    for t in hpg_part0[g]..hpg_part0[g] + hpg_parts[g] {
        start: int = msg(s, sel("length"));
        hpt_at[t] = start;
        append(s, ns_of(hlp, hpt_head_b[t], hpt_head_e[t]), head, c_ink);
        hpt_len[t] = msg(s, sel("length")) - hpt_at[t];
        append(s, nsstring("\n"), head, c_ink);
        msg4(s, sel("addAttribute:value:range:"), k_para, help_para(if (first) 0.0f64 else 20.0f64,
            6.0f64), start, msg(s, sel("length")) - start);
        first = false;
        last: int = hpt_para0[t] + hpt_paras[t] - 1;
        for a in hpt_para0[t]..last + 1 {
            p0: int = msg(s, sel("length"));
            hpa_at[a] = p0;
            help_runs(a);
            for r in 0..hrun_n {
                if (hrun_kind[r] == HRUN_SYM) {
                    if (hrun_sym[r] >= 0) msg1(s, sel("appendAttributedString:"),
                        help_symbol(hsym_names[hrun_sym[r]], body_font, if (hrun_bold[r]) 6 else 4))
                } else {
                    f: int = if (hrun_bold[r] && hrun_italic[r]) bold_ital else if (hrun_bold[r]) bold else if (hrun_italic[r]) ital else body_font;
                    color: int = if (hrun_kind[r] == HRUN_LINK) c_accent else c_ink;
                    at: int = msg(s, sel("length"));
                    append(s, ns_of(hlp, hrun_b[r], hrun_e[r]), f, color);
                    if (hrun_kind[r] == HRUN_LINK && hrun_link[r] >= 0) msg4(s, sel("addAttribute:value:range:"),
                        nsstring(k_help_link), nsnumber_int(hrun_link[r] + 1), at,
                        msg(s, sel("length")) - at)
                }
            }
            hpa_len[a] = msg(s, sel("length")) - p0;
            if (a < last || t < hpg_part0[g] + hpg_parts[g] - 1) append(s, nsstring("\n"),
                body_font, c_ink);
            msg4(s, sel("addAttribute:value:range:"), k_para, help_para(0.0f64, if (a < last) size * 0.6f64 else 0.0f64),
                p0, msg(s, sel("length")) - p0)
        }
    }
    s
}

help_scaled(f: int): int {
    m: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    msg1(m, sel("scaledFontForFont:"), f)
}

help_para(before: f64, after: f64): int {
    msg(para_style(0, 0.0f64, 0.0f64, before, after, 1.0f64), sel("autorelease"))
}

// A symbol as an attachment: at the text's size and weight, in ink,
// centred on the capitals' height.
help_symbol(name: str, font: int, weight: int): int {
    size: f64 = msg_f(font, sel("pointSize"));
    image: int = symbol(name, size, weight, c_ink);
    att: int = msg1(cls("NSTextAttachment"), sel("textAttachmentWithImage:"), image);
    l8_msg_hfa(hfa, image, sel("size"), 0, 0, 0);
    w: f64 = hfa[0];
    h: f64 = hfa[1];
    cap: f64 = msg_f(font, sel("capHeight"));
    msg_rect(att, sel("setBounds:"), 0.0f64, (cap - h) / 2.0f64, w, h);
    a: int = msg1(cls("NSAttributedString"), sel("attributedStringWithAttachment:"),
        att);
    m: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    msg1(m, sel("appendAttributedString:"), a);
    msg4(m, sel("addAttribute:value:range:"), k_font, font, 0, msg(m, sel("length")));
    m
}

// The slot of a page's controller, or of its text view (-1: none).
help_slot_of_vc(vc: int): int {
    for k in 0..HPV_MOST
        if (hpv_vc[k] == vc && vc != 0) return k;
    -1
}

help_slot_of_tv(tv: int): int {
    for k in 0..HPV_MOST
        if (hpv_tv[k] == tv && tv != 0) return k;
    -1
}

// The page's text laid out whole (its own TextKit 1 layout manager).
help_page_laid_out(tv: int) {
    if (!responds(tv, "layoutManager")) return;
    lm: int = msg(tv, sel("layoutManager"));
    if (lm != 0) msg1(lm, sel("ensureLayoutForTextContainer:"), msg(tv, sel("textContainer")));
    msg(tv, sel("layoutIfNeeded"))
}

// Laid out: VoiceOver's parts placed (again, at a new width); the first
// time, scrolled to its part (before the push is seen) and washed.
help_page_layout(self: int, cmd: int): int {
    super0(self, help_page_class, cmd);
    k: int = help_slot_of_vc(self);
    if (k < 0) return 0;
    tv: int = hpv_tv[k];
    w: f64 = view_width(tv);
    if (w <= 0.0f64) return 0;
    if (w != hpv_w[k]) {
        hpv_w[k] = w;
        help_page_laid_out(tv);
        help_page_access(k)
    }
    if (hpv_part[k] >= 0) {
        t: int = hpv_part[k];
        hpv_part[k] = -1;
        help_page_scroll(k, t, false);
        if (hpv_washes[k]) help_wash(k, t)
    }
    0
}

// Part t's heading 8 points under the top (the whole text laid out
// first: a page is short).
help_page_scroll(k: int, t: int, animated: bool) {
    tv: int = hpv_tv[k];
    if (tv == 0) return;
    help_page_laid_out(tv);
    if (!range_rect(tv, hpt_at[t], 1)) return;
    y: f64 = hfa[1];
    l8_msg_hfa(hfa, tv, sel("adjustedContentInset"), 0, 0, 0);
    top: f64 = hfa[0];
    bottom: f64 = hfa[2];
    l8_msg_hfa(hfa, tv, sel("contentSize"), 0, 0, 0);
    most: f64 = hfa[1] + bottom - view_height(tv);
    off: f64 = y - 8.0f64 - top;
    if (off > most) off = most;
    if (off < -top) off = -top;
    msg_ff1(tv, sel("setContentOffset:animated:"), 0.0f64, off, if (animated) 1 else 0)
}

// Its heading washed in the selection's color, fading over a second (in
// the demo, six, for the screenshot); not under Reduce Motion.
help_wash(k: int, t: int) {
    tv: int = hpv_tv[k];
    if (tv == 0 || reduce_motion()) return;
    if (!range_rect(tv, hpt_at[t], if (hpt_len[t] > 0) hpt_len[t] else 1)) return;
    y: f64 = hfa[1];
    hh: f64 = hfa[3];
    if (hpv_wash[k] != 0) msg(hpv_wash[k], sel("removeFromSuperview"));
    v: int = msg(make("UIView"), sel("autorelease"));
    msg_rect(v, sel("setFrame:"), 12.0f64, y - 4.0f64, view_width(tv) - 24.0f64, hh + 8.0f64);
    msg1(v, sel("setBackgroundColor:"), c_sel);
    msg1(v, sel("setUserInteractionEnabled:"), 0);
    msg_set_f(msg(v, sel("layer")), sel("setCornerRadius:"), 6.0f64);
    msg2(tv, sel("insertSubview:atIndex:"), v, 0);
    hpv_wash[k] = held(hpv_wash[k], v);
    layer: int = msg(v, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 0.0f64 as f32);
    animate(layer, "opacity", 1.0f64, 0.0f64, false, if (demo_on) 6.0f64 else 1.0f64);
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: manual washed ");
        help_fput_anchor(t);
        note_ns(fstring())
    }
}

// VoiceOver: each heading (a header, so the rotor's Headings moves by
// part) and each paragraph (its symbols by name; its links as actions),
// placed where they are in the text.
help_page_access(k: int) {
    tv: int = hpv_tv[k];
    g: int = hpv_page[k];
    list: int = msg(cls("NSMutableArray"), sel("array"));
    header: int = objc_const("UIAccessibilityTraitHeader") | objc_const("UIAccessibilityTraitStaticText");
    for t in hpg_part0[g]..hpg_part0[g] + hpg_parts[g] {
        e: int = help_element(tv, hpt_at[t], hpt_len[t], ns_of(hlp, hpt_head_b[t],
            hpt_head_e[t]), header);
        if (e != 0) msg1(list, sel("addObject:"), e);
        for a in hpt_para0[t]..hpt_para0[t] + hpt_paras[t] {
            help_plain(a, true);
            e2: int = help_element(tv, hpa_at[a], hpa_len[a], nsstring_of(hx, hx_n),
                objc_const("UIAccessibilityTraitStaticText"));
            if (e2 != 0) {
                help_runs(a);
                n: int = 0;
                for r in 0..hrun_n {
                    if (hrun_kind[r] == HRUN_LINK && hrun_link[r] >= 0 && n < 8) {
                        fbuf_n = 0;
                        fput_str("Open ");
                        fput_bytes(hlp, hrun_b[r], hrun_e[r]);
                        act: int = msg(msg3(msg(cls("UIAccessibilityCustomAction"),
                            sel("alloc")), sel("initWithName:target:selector:"), fstring(),
                            app_obj, sel("helpLinkAction:")), sel("autorelease"));
                        objc_setAssociatedObject(act, ints_address(hlink_key), nsnumber_int(hrun_link[r]),
                            1);
                        one[n] = act;
                        n = n + 1
                    }
                }
                if (n > 0) msg1(e2, sel("setAccessibilityCustomActions:"), nsarray(one,
                    n));
                msg1(list, sel("addObject:"), e2)
            }
        }
    }
    msg1(tv, sel("setAccessibilityElements:"), list)
}

hlink_key: []int = new int[1](0);

// An element of the text from UTF-16 unit at, n long: its words, traits,
// and frame (from its first line's top to its last's bottom, the text's
// width).
help_element(
    tv: int,
    at: int,
    n: int,
    words: int,
    traits: int
): int {
    if (n <= 0 || !range_rect(tv, at, 1)) return 0;
    y0: f64 = hfa[1];
    if (!range_rect(tv, at + n - 1, 1)) return 0;
    y1: f64 = hfa[1] + hfa[3];
    e: int = msg(msg1(msg(cls("UIAccessibilityElement"), sel("alloc")), sel("initWithAccessibilityContainer:"),
        tv), sel("autorelease"));
    msg1(e, sel("setAccessibilityLabel:"), words);
    msg1(e, sel("setAccessibilityTraits:"), traits);
    msg_rect(e, sel("setAccessibilityFrameInContainerSpace:"), 16.0f64, y0 - 2.0f64,
        view_width(tv) - 32.0f64, y1 - y0 + 4.0f64);
    e
}

// A link tapped: its part, in this page (scrolled to, washed) or another
// (pushed).
help_page_tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    t: int = link_at(tv, hfa[0], hfa[1], k_help_link) - 1;
    if (t >= 0) help_follow(help_slot_of_tv(tv), t);
    0
}

help_follow(k: int, t: int) {
    if (k < 0 || t < 0 || t >= hpt_n) return;
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: manual link ");
        help_fput_anchor(t);
        note_ns(fstring())
    }
    if (hpt_page[t] == hpv_page[k]) {
        help_page_scroll(k, t, !reduce_motion());
        help_wash(k, t)
    } else help_open_page(hpt_page[t], t, true)
}

help_link_action(_self: int, _cmd: int, a: int): int {
    v: int = objc_getAssociatedObject(a, ints_address(hlink_key));
    if (v == 0) return 0;
    t: int = msg(v, sel("longValue"));
    // (The page on top: the one VoiceOver is in.)
    top: int = top_presented();
    if (top != 0 && responds(top, "topViewController")) help_follow(help_slot_of_vc(msg(top,
        sel("topViewController"))), t);
    1
}

// ---- the sheet gone, the theme, the text size ----
help_sheet_gone() {
    for k in 0..HPV_MOST {
        hpv_vc[k] = held(hpv_vc[k], 0);
        hpv_tv[k] = held(hpv_tv[k], 0);
        hpv_wash[k] = held(hpv_wash[k], 0)
    }
}

// The theme changed, or the text size: the Manual's pages made again in it
// (each page's place kept; its list is core's).
help_restyle() {
    for k in 0..HPV_MOST {
        tv: int = hpv_tv[k];
        if (tv != 0) {
            y: f64 = offset_y(tv);
            msg1(tv, sel("setBackgroundColor:"), sheet_bg());
            msg1(msg(hpv_vc[k], sel("view")), sel("setBackgroundColor:"), sheet_bg());
            msg1(tv, sel("setAttributedText:"), help_page_text(hpv_page[k]));
            msg_ff1(tv, sel("setContentOffset:animated:"), 0.0f64, y, 0);
            hpv_w[k] = 0.0f64;
            msg(msg(hpv_vc[k], sel("view")), sel("setNeedsLayout"))
        }
    }
}

// ---- classes and methods ----
make_help_classes() {
    help_page_class = objc_allocateClassPair(cls("UIViewController"), "L8ManualPage",
        0);
    add_method0(help_page_class, sel("viewDidLayoutSubviews"), &help_page_layout,
        "v@:");
    objc_registerClassPair(help_page_class)
}

add_help_methods(app: int) {
    add_method1(app, sel("helpPageTapped:"), &help_page_tapped, "v@:@");
    add_method1(app, sel("helpLinkAction:"), &help_link_action, "B@:@")
}

// ---- Help's list (tables.l8) ----
help_screens() {
    on_sheet_gone(&help_sheet_gone)
}
