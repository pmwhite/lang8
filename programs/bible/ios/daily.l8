tag bible_ios;

use_tag std, ios, bible;

// Daily reading (DESIGN.md §10.1, and §10's owner amendment; §11 as
// revised): the Go To sheet's Ribbons section (ios/ribbons.l8's rows, New
// Ribbon…) and Reading Plan section (the plan followed's one row, Reading
// Plans), the plans and a plan's days (pushed in that sheet, Start Plan
// there), A Chapter a Day, a chapter counted as read (by rest and its end
// seen, by Listen, or by hand; with a plan or without, for the carried
// ribbon too) and the day's toast; and the plan's daily reminder: its
// switch (with the plan's days), its authorization (the one block,
// ../../ios/block.l8), the 30 requests scheduled ahead, and the reader taken
// to the day's reading when one is opened.
// plans.l8 computes the plans and keeps their lines; every date here is
// today()'s.
import "../../ios/objc.l8";

import "../../ios/block.l8";

import "../core/text.l8";

import "../core/plans.l8";

extern objc_setAssociatedObject(
    object: int,
    key: int,
    value: int,
    policy: int
): int;

extern objc_getAssociatedObject(object: int, key: int): int;

// ---- the day ----
// "Today": the phone's local day; in the demo, 2026-10-19 at 08:00 (and as
// many days on as a step has moved it).
demo_day_shift: int = 0;

today(): int {
    if (demo_on) return days_from_civil(2026, 10, 19) + demo_day_shift;
    local_day(time(0))
}

// Minutes past midnight now (local).
now_minutes(): int {
    if (demo_on) return 480;
    t: int = time(0) + local_offset();
    (t - day_of(t) * 86400) / 60
}

// What is kept, read at launch: the plans followed, a file each,
// plan-N.tsv, in N's order (the order they were started; §16.11.6). 1.0's
// plan.tsv becomes plan-1.tsv first (its reminder's switch as REMIND). The
// plans are made first: a plan's lines name its days' passages. A plan
// this build has not is kept in plans-done.tsv, and its file removed.
load_daily() {
    daily_ready();
    plans_migrate();
    plans_clear();
    fm: int = msg(cls("NSFileManager"), sel("defaultManager"));
    names: int = msg2(fm, sel("contentsOfDirectoryAtPath:error:"), dir_path(), 0);
    nums_n: int = 0;
    if (names != 0) {
        for i in 0..msg(names, sel("count")) {
            n: int = plan_file_num(msg1(names, sel("objectAtIndex:"), i));
            if (n > 0 && nums_n < len(pf_nums)) {
                // (Kept in order, as they come.)
                at: int = nums_n;
                while (at > 0 && pf_nums[at - 1] > n) {
                    pf_nums[at] = pf_nums[at - 1];
                    at = at - 1
                }
                pf_nums[at] = n;
                nums_n = nums_n + 1
            }
        }
    }
    for x in 0..nums_n {
        n: int = pf_nums[x];
        read_path(plan_path(n));
        i: int = parse_plan(n);
        if (i < 0) {
            fput_str("END\t");
            fput_int(time(0));
            fput(10);
            append_file("plans-done.tsv");
            msg2(fm, sel("removeItemAtPath:error:"), plan_path(n), 0);
            note_num("bible: plan unknown, file ", n)
        }
        if (n >= def_int("planNext")) set_def_int("planNext", n + 1)
    }
    note_num("bible: plans followed ", fw_n)
}

pf_nums: []int = new int[64](0);

// The number of a file named plan-N.tsv (0 if it is not one).
plan_file_num(name: int): int {
    k: int = nsstring_into(name, link_buf);
    if (k < 10 || link_buf[0] as int != 112 || link_buf[4] as int != 45 || link_buf[k - 4] as int != 46) return 0;
    n: int = 0;
    for i in 5..k - 4 {
        d: int = link_buf[i] as int;
        if (d < 48 || d > 57) return 0;
        n = n * 10 + d - 48
    }
    n
}

// plan-N.tsv's path.
plan_path(n: int): int {
    fbuf_n = 0;
    fput_str("plan-");
    fput_int(n);
    fput_str(".tsv");
    msg1(dir_path(), sel("stringByAppendingPathComponent:"), fstring())
}

// A file at path into fbuf (empty if there is none).
read_path(path: int) {
    data: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), path);
    fbuf_n = 0;
    if (data == 0) return;
    n: int = msg(data, sel("length"));
    if (n > len(fbuf)) n = len(fbuf);
    if (n > 0) memcpy_from(fbuf, msg(data, sel("bytes")), n);
    fbuf_n = n
}

// 1.0's (and §16's first build's) plan.tsv, when no plan-N.tsv is there yet:
// renamed plan-1.tsv, with REMIND if planReminder was on; planNext 2; logged
// "plans migrated 1".
plans_migrate() {
    fm: int = msg(cls("NSFileManager"), sel("defaultManager"));
    old: int = file_path("plan.tsv");
    if ((msg1(fm, sel("fileExistsAtPath:"), old) & 255) == 0) return;
    names: int = msg2(fm, sel("contentsOfDirectoryAtPath:error:"), dir_path(), 0);
    if (names != 0) {
        for i in 0..msg(names, sel("count"))
            if (plan_file_num(msg1(names, sel("objectAtIndex:"), i)) > 0) return
    }
    // (plan_path writes its name in fbuf: before the file is read.)
    to: int = plan_path(1);
    read_path(old);
    plan_migrate(def_bool("planReminder"));
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    msg2(data, sel("writeToFile:atomically:"), to, 1);
    msg2(fm, sel("removeItemAtPath:error:"), old, 0);
    set_def_int("planNext", 2);
    msg1(defaults(), sel("removeObjectForKey:"), nsstring("planReminder"));
    note("bible: plans migrated 1")
}

daily_ready() {
    if (pl_ready) return;
    t0: f64 = CFAbsoluteTimeGetCurrent();
    plans_files_load();
    plans_make();
    note_num("bible: plans made, passages ", pl_readings);
    note_num("bible:   in ms ", ((CFAbsoluteTimeGetCurrent() - t0) * 1000.0f64) as int)
}

// The listed plans' files, from the app's bundle (mapped, kept).
plans_files_load() {
    m: []i8 = lang_map("mcheyne", "txt");
    plan_file_set(PLAN_MCHEYNE, m, lang_mapped);
    k: []i8 = lang_map("chrono", "txt");
    plan_file_set(PLAN_CHRONO, k, lang_mapped)
}

// Slot i's file written (whole).
save_plan(i: int) {
    if (i < 0 || i >= fw_n) return;
    path: int = plan_path(fw_num[i]);
    format_plan(i);
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    msg2(data, sel("writeToFile:atomically:"), path, 1)
}

// The same, by plan.
save_plan_p(p: int) {
    save_plan(plan_slot(p))
}

// Slot i's plan stopped: its file onto plans-done.tsv (with when it
// ended), and gone; the others go on (§16.11.1).
plan_archive(i: int) {
    if (i < 0 || i >= fw_n) return;
    n: int = fw_num[i];
    fbuf_n = 0;
    put_plan(i);
    fput_str("END\t");
    fput_int(time(0));
    fput(10);
    append_file("plans-done.tsv");
    msg2(msg(cls("NSFileManager"), sel("defaultManager")), sel("removeItemAtPath:error:"),
        plan_path(n), 0);
    note_num("bible: plan archived, file ", n);
    plan_end(i)
}

// ---- a chapter read ----
// How long the reader has rested in each chapter (seconds), and whether
// its end has been on the screen; the chapter resting in now, since when.
pr_dwell: []f64 = new f64[1200](0.0f64);

pr_end: []bool = new bool[1200](false);

pr_c: int = -1;

pr_since: f64 = 0.0f64;

pr_timer: int = 0;

// The reader at rest (a scroll ended): resting in the chapter at the top,
// checked again once it could have been 20 s. (With a plan or without:
// the carried ribbon moves on as chapters are read, DESIGN.md §11.1.4.)
plan_rest_began() {
    // (A plan's day is marked only by Mark Read: §16.13.)
    if (day_on) return;
    if (cur < 0) return;
    plan_rest_ended();
    plan_seen();
    pr_c = cur;
    pr_since = CACurrentMediaTime();
    left: f64 = 20.0f64 - pr_dwell[cur];
    if (left < 0.5f64) left = 0.5f64;
    pr_timer = stop_timer(pr_timer);
    pr_timer = after(left, "planRested:")
}

// The rest over (a scroll began, the app went away): its time added.
plan_rest_ended() {
    // (A plan's day is marked only by Mark Read: §16.13.)
    if (day_on) return;
    if (pr_since <= 0.0f64 || pr_c < 0) return;
    // (Not the time a sheet was over the reader; nor, in the demo, CI's own
    // pauses: there only the demo's hook, demo_read, counts a chapter read,
    // so no group's shots depend on how long a step took. §11.3a note 4.)
    if (presented() == 0 && !demo_on) pr_dwell[pr_c] = pr_dwell[pr_c] + CACurrentMediaTime() - pr_since;
    pr_since = 0.0f64;
    pr_timer = stop_timer(pr_timer);
    plan_check(pr_c)
}

plan_rested(_self: int, _cmd: int, _timer: int): int {
    pr_timer = 0;
    if (pr_since <= 0.0f64) return 0;
    c: int = pr_c;
    plan_rest_ended();
    if (presented() == 0 && c == cur) plan_rest_began();
    0
}

// The ends of the chapters on the screen now, seen (from the scroll).
plan_seen() {
    // (A plan's day is marked only by Mark Read: §16.13.)
    if (day_on) return;
    if (cur < 0 || table == 0) return;
    bottom: f64 = offset_y(table) + view_height(table) - bottom_inset(table);
    c: int = cur;
    more: bool = true;
    while (more && c < chapters) {
        l8_msg_hfa(hfa, table, sel("rectForRowAtIndexPath:"), chapter_path(c), 0,
            0);
        if (hfa[1] + hfa[3] <= bottom + 1.0f64) {
            if (!pr_end[c]) {
                pr_end[c] = true;
                plan_check(c)
            }
            c = c + 1
        } else more = false
    }
}

// A chapter read once its rest and its end are both there: counted (for
// the carried ribbon, and the plan if one is followed), and its rest and end
// begun again, so that only reading it again counts it again.
plan_check(c: int) {
    if (c < 0 || c >= chapters) return;
    if (pr_dwell[c] >= 20.0f64 && pr_end[c]) {
        pr_dwell[c] = 0.0f64;
        pr_end[c] = false;
        chapter_read_now(c)
    }
}

// Listen said a chapter's last verse (for the carried ribbon: a plan is
// read only in its day's reader, DESIGN.md §16.0 decision 7).
plan_heard(c: int) {
    if (c >= 0 && c < chapters && (!demo_on || demo_heard)) chapter_read_now(c)
}

// (The ribbons group's: Listen's chapter's end counts, as on a phone.)
demo_heard: bool = false;

// Slot i's today finished: the toast, once a day for each plan (DONEDAY;
// naming the plan when more than one is followed, §16.11.4).
day_done(i: int) {
    d: int = today();
    if (!plan_day_done_due(i, d)) return;
    fw_doneday[i] = d;
    save_plan(i);
    fbuf_n = 0;
    fput_day_done(i, d);
    haptic_success();
    toast_symbol(fstring(), "checkmark", if (demo_on) 6.0f64 else 1.6f64);
    note("bible: day done")
}

// Whether Go To opens at its top (a ribbon, or a plan followed).
today_has(): bool {
    rb_n > 0 || fw_n > 0
}

// A circle for a reading's or a day's state (0 none, 1 some, 2 all read).
circle_name(state: int): str {
    if (state == 2) "checkmark.circle.fill" else if (state == 1) "circle.lefthalf.filled" else "circle"
}

// A row with a circle at its start (a button over the cell's image, 28
// points), its title and secondary text: for the circle, tag and action.
circle_key: []int = new int[1](0);

circle_cell(
    t: int,
    id: str,
    _state: int,
    tag: int,
    action: str
): int {
    cell: int = list_cell(t, id, 2);
    // (A list configuration first: setting the first one replaces the cell's
    // content view, and the button must be in the one that stays.)
    if (msg(cell, sel("contentConfiguration")) == 0) msg1(cell, sel("setContentConfiguration:"),
        list_config(2));
    b: int = msg1(msg(cell, sel("contentView")), sel("viewWithTag:"), 9100);
    if (b == 0) {
        b = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTag:"), 9100);
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        content: int = msg(cell, sel("contentView"));
        msg1(content, sel("addSubview:"), b);
        pin(b, content, "leadingAnchor");
        pin(b, content, "topAnchor");
        pin(b, content, "bottomAnchor");
        pin_size(b, "widthAnchor", 60.0f64);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel(action), 64)
    }
    objc_setAssociatedObject(b, ints_address(circle_key), nsnumber_int(tag), 1);
    msg1(cell, sel("setAccessoryType:"), 0);
    cell
}

circle_tag(b: int): int {
    n: int = objc_getAssociatedObject(b, ints_address(circle_key));
    if (n == 0) -1 else msg(n, sel("longValue"))
}

// The configuration of a circle's row: the circle, a title and a line.
circle_config(state: int, title: int, line: int): int {
    circle_config_of(state, title, line, false)
}

// The same, the circle dimmed when it does nothing (a plan not started:
// review r5-1).
circle_config_of(
    state: int,
    title: int,
    line: int,
    dim: bool
): int {
    config: int = list_config(2);
    color: int = if (dim) msg_set_f(c_faint, sel("colorWithAlphaComponent:"), 0.4f64) else if (state == 0) c_faint else c_accent;
    config_image(config, circle_name(state), 22.0f64, color);
    msg_ff(msg(config, sel("imageProperties")), sel("setReservedLayoutSize:"), 28.0f64,
        28.0f64);
    msg1(config, sel("setText:"), title);
    msg1(config, sel("setSecondaryText:"), line);
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(text_props(config), sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleBody")));
    msg1(detail_props(config), sel("setColor:"), c_faint);
    config
}

// A row's VoiceOver: what it says, and its action (Mark as Read, or as
// Unread).
circle_access(
    cell: int,
    label: int,
    state: int,
    action: str
) {
    msg1(cell, sel("setIsAccessibilityElement:"), 1);
    msg1(cell, sel("setAccessibilityLabel:"), label);
    // (A circle that does nothing has no action.)
    b0: int = msg1(msg(cell, sel("contentView")), sel("viewWithTag:"), 9100);
    if (b0 != 0 && (msg(b0, sel("isEnabled")) & 255) == 0) {
        msg1(cell, sel("setAccessibilityCustomActions:"), 0);
        return
    }
    a: int = msg(msg3(msg(cls("UIAccessibilityCustomAction"), sel("alloc")), sel("initWithName:target:selector:"),
        nsstring(if (state == 2) "Mark as Unread" else "Mark as Read"), app_obj, sel(action)),
        sel("autorelease"));
    b: int = msg1(msg(cell, sel("contentView")), sel("viewWithTag:"), 9100);
    objc_setAssociatedObject(a, ints_address(circle_key), objc_getAssociatedObject(b,
        ints_address(circle_key)), 1);
    one[0] = a;
    msg1(cell, sel("setAccessibilityCustomActions:"), nsarray(one, 1))
}

// A selector-based VoiceOver action (no blocks), named.
custom_action(name: str, action: str): int {
    msg(msg3(msg(cls("UIAccessibilityCustomAction"), sel("alloc")), sel("initWithName:target:selector:"),
        nsstring(name), app_obj, sel(action)), sel("autorelease"))
}

// A label for the rows (wrapping, at the phone's size).
today_label(font: int, color: int, lines: int): int {
    l: int = msg(make("UILabel"), sel("autorelease"));
    msg1(l, sel("setFont:"), font);
    msg1(l, sel("setTextColor:"), color);
    msg1(l, sel("setNumberOfLines:"), lines);
    msg1(l, sel("setAdjustsFontForContentSizeCategory:"), 0);
    l
}

// The plan's days, as its row's ⓘ opens them: at the first unfinished
// day, if one is (as Catch Up did); else at today, once today is past the
// first screen (day 8 on: review r6-1); else at their top (the Daily
// Reminder in sight early in a plan).
plan_row_details(i: int) {
    if (i < 0 || i >= fw_n) return;
    daily_ready();
    td: int = plan_today_of(i, today());
    open_plan(fw_plan[i], if (plan_behind_of(i, today()) > 0) pl_first_behind else if (td > 7) td else 0)
}

picker_appeared: bool = false;

// The picker about to show again (from a screen pushed over it): its
// Ribbons and Reading Plan sections as they are now (reloaded whole while
// it is not yet on the window, which lays out nothing: review r7-1, Minor
// 6).
books_will_appear(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, books_class, cmd, animated);
    if (picker_table == 0 || sk_q_n > 0) return 0;
    if (!picker_appeared) {
        picker_appeared = true;
        return 0
    }
    // (Core's rows made again, its ribbons' and plans' as they are now.)
    k: int = uk_slot_of(picker_table);
    if (k < 0) return 0;
    uk_stale = true;
    msg(picker_table, sel("reloadData"));
    uk_dress(k, false);
    0
}

// ---- the plans, and a plan's days (pushed in the Go To sheet: §11.3.2,
// Round 5's restored) ----
plans_table: int = 0;

detail_table: int = 0;

// The plan whose days are shown.
detail_plan: int = 0;

// The Day 4 (in accent) and the disclosure, as a row's accessory.
value_disclosure(text: int, color: int): int {
    l: int = today_label(msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleBody")),
        color, 1);
    msg1(l, sel("setText:"), text);
    msg(l, sel("sizeToFit"));
    lw: f64 = view_width(l);
    lh: f64 = view_height(l);
    chevron: int = msg(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol("chevron.right", 13.0f64, 6, msg(cls("UIColor"), sel("tertiaryLabelColor")))),
        sel("autorelease"));
    msg(chevron, sel("sizeToFit"));
    cw: f64 = view_width(chevron);
    ch: f64 = view_height(chevron);
    h: f64 = if (lh > ch) lh else ch;
    box: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, lw + 8.0f64 + cw, h), sel("autorelease"));
    msg_rect(l, sel("setFrame:"), 0.0f64, (h - lh) / 2.0f64, lw, lh);
    msg_rect(chevron, sel("setFrame:"), lw + 8.0f64, (h - ch) / 2.0f64, cw, ch);
    msg1(box, sel("addSubview:"), l);
    msg1(box, sel("addSubview:"), chevron);
    box
}

// Reading Plans: core's screen (core/skin.l8's SCR_PLANS), pushed in the
// Go To sheet.
open_plans() {
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    note("bible: reading plans");
    uk_open(SCR_PLANS, 0, true, sheet_nav);
    plans_table = uk_table_of(SCR_PLANS)
}

// Plan p's row in Reading Plans tapped (the demos'; -1: A Chapter a Day).
plans_tap(p: int) {
    if (p < 0) uk_tap(SCR_PLANS, ACT_OPEN, OPEN_DAY1) else uk_tap(SCR_PLANS, ACT_PLAN,
        p)
}

// A plan's days: core's screen (core/skin.l8's SCR_PLAN), pushed in the
// sheet, at day d (from 1; 0 the top).
open_plan(p: int, d: int) {
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    daily_ready();
    detail_plan = p;
    uk_open_plan(p, d, false, sheet_nav);
    detail_table = uk_table_of(SCR_PLAN)
}

// A plan followed from today (Start Plan; A Chapter a Day from chapter c),
// beside any others (§16.11.1), in a new file, its reminder's switch off
// until asked for: its plan (-1 if it is followed already).
plan_follow(p_in: int, c: int): int {
    daily_ready();
    p: int = if (plan_is_day1(p_in)) plan_day1_choose(c) else p_in;
    if (p < 0 || plan_slot(p) >= 0) return -1;
    n: int = def_int("planNext");
    if (n < 1) n = 1;
    set_def_int("planNext", n + 1);
    i: int = plan_begin(p, today(), n);
    if (i < 0) return -1;
    save_plan(i);
    note_num("bible: plan started, file ", n);
    daily_reschedule();
    p
}

// Start Plan (or Start Instead), a plan's detail's: Round 6's start.
plan_start(_self: int, _cmd: int, _b: int): int {
    plans_start_now(detail_plan, cur);
    0
}

// Plan p followed from today (A Chapter a Day from chapter c), then Go To
// away and day 1 in the day's reader (§16.1), and the toast "Started
// Chronological".
plans_start_now(p_in: int, c: int) {
    p: int = plan_follow(p_in, c);
    if (p < 0) return;
    fbuf_n = 0;
    fput_str("Started ");
    fput_plan_name(p);
    text: int = fstring();
    msg(text, sel("retain"));
    haptic_impact(0);
    release(do_toast);
    do_toast = text;
    msg(text, sel("retain"));
    day_open(p, 1, -1);
    // (Up at once: the toast now; else once the sheet has gone.)
    if (do_plan < 0 && do_toast != 0) {
        toast_symbol(do_toast, "checkmark", if (demo_on) 6.0f64 else 1.6f64);
        release(do_toast);
        do_toast = 0
    }
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: toast ");
        n: int = nsstring_into(text, link_buf);
        for i in 0..n fput(link_buf[i] as int);
        note_ns(fstring())
    }
    release(text);
    note_num("bible: started, the day's reader ", if (day_on) 1 else 0)
}

// ---- A Chapter a Day (pushed from Reading Plans, §11.3.3): core's
// screen (core/skin.l8's SCR_DAY1), Begin At the reader's book and
// chapter ----
open_day1() {
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    daily_ready();
    note_num("bible: a chapter a day from ", cur);
    uk_open(SCR_DAY1, 0, true, sheet_nav)
}

// Its Start Plan (the demos').
day1_start(_self: int, _cmd: int, _b: int): int {
    if (day1_days(bg_c) > 0) plans_start_now(PLAN_DAY1, bg_c);
    0
}

plan_stop(_self: int, _cmd: int, _b: int): int {
    plan_archive(plan_slot(detail_plan));
    note("bible: plan stopped");
    // (A day of it up: read on, not marked.)
    if (day_on) {
        mark_hide(true);
        day_footer_update()
    }
    daily_reschedule();
    // (Its days made again: Start Plan, its reminder gone.)
    uk_refresh();
    0
}

// The sheet gone: what its pushed lists held let go.
daily_sheet_gone() {
    plans_table = 0;
    detail_table = 0
}

// ---- the daily reminder (§10, owner amendment; §16.11.5) ----
// Each plan's switch (REMIND in its file: the one notification names it),
// the shared time (minutes past midnight), and whether the phone's Settings
// turned notifications off for the app.
// The switch of the plan whose days are shown.
nt_on_detail(): bool {
    i: int = plan_slot(detail_plan);
    i >= 0 && fw_remind[i]
}

nt_set_detail(on: bool) {
    i: int = plan_slot(detail_plan);
    if (i < 0) return;
    fw_remind[i] = on;
    save_plan(i)
}

// Whether any plan's switch is on.
reminders_any(): bool {
    for i in 0..fw_n
        if (fw_remind[i]) return true;
    false
}

// Every plan's switch off (Settings turned notifications off).
reminders_all_off() {
    for i in 0..fw_n {
        if (fw_remind[i]) {
            fw_remind[i] = false;
            save_plan(i)
        }
    }
}

nt_minutes: int = 420;

nt_denied: bool = false;

notify_center(): int {
    if (cls("UNUserNotificationCenter") == 0) _h: int = dlopen("/System/Library/Frameworks/UserNotifications.framework/UserNotifications",
        1);
    c: int = cls("UNUserNotificationCenter");
    if (c == 0) 0 else msg(c, sel("currentNotificationCenter"))
}

// The answer to an authorization request, from the block, on a queue of
// the system's: auth_granted the answer, auth_answered 1 plus it (one store
// that says both, so the order of the two stores cannot matter to the main
// thread, which reads only auth_answered).
auth_granted: int = 0;

auth_answered: int = 0;

// The block's invoke (DESIGN.md §10.2.3). It runs on a background queue:
// it must not allocate, send a message, or touch a region; it stores two
// ints and returns.
auth_done(_block: int, granted: int, _error: int): int {
    auth_granted = granted & 255;
    auth_answered = 1 + (granted & 255);
    0
}

auth_block: int = 0;

// Why the answer is waited for (1 the switch turned on, 2 the app active
// again), and how long it has been (0.2 s ticks).
auth_why: int = 0;

auth_ticks: int = 0;

auth_timer: int = 0;

notify_ask(why: int) {
    center: int = notify_center();
    if (center == 0) return;
    if (auth_block == 0) auth_block = global_block(&auth_done);
    auth_why = why;
    auth_answered = 0;
    auth_ticks = 0;
    note_num("bible: notification authorization asked, why ", why);
    msg2(center, sel("requestAuthorizationWithOptions:completionHandler:"), 6, auth_block);
    auth_timer = stop_timer(auth_timer);
    auth_timer = after(0.2f64, "authTick:")
}

// (The demo's own answer, through the same flag: the simulator cannot tap
// Allow.)
demo_grant() {
    auth_why = 1;
    auth_ticks = 0;
    auth_answered = 2;
    auth_timer = stop_timer(auth_timer);
    auth_timer = after(0.2f64, "authTick:")
}

auth_tick(_self: int, _cmd: int, _timer: int): int {
    auth_timer = 0;
    a: int = auth_answered;
    if (a == 0) {
        auth_ticks = auth_ticks + 1;
        if (auth_ticks < 600) auth_timer = after(0.2f64, "authTick:") else note("bible: notification authorization never answered");
        return 0
    }
    granted: bool = a == 2;
    note_num("bible: notification authorization answered ", a - 1);
    // (Memory's switch, DESIGN.md §13.5: the same authorization.)
    if (auth_why == 3) {
        nt_denied = !granted;
        mm_remind_answer(granted);
        demo_event();
        return 0
    }
    if (granted) {
        was: bool = nt_on_detail();
        nt_denied = false;
        if (auth_why == 1) nt_set_detail(true);
        notify_schedule();
        // (Core's rows made again: its Time row, the footer.)
        if (!was && auth_why == 1) uk_refresh()
    } else {
        was_denied: bool = nt_denied;
        nt_denied = true;
        if (reminders_any() || auth_why == 1) {
            reminders_all_off();
            center: int = notify_center();
            if (center != 0) msg(center, sel("removeAllPendingNotificationRequests"))
        }
        if (!was_denied || auth_why == 2 || auth_why == 1) uk_refresh()
    }
    demo_event();
    0
}

load_notify_settings() {
    nt_minutes = def_int("planReminderMinutes");
    if (nt_minutes <= 0 || nt_minutes >= 1440) nt_minutes = 420
}

// Every launch, return, and change of either switch, the time, the plan
// or its progress, and a passage added, deleted, begun again or graded:
// the 30 days ahead scheduled again (§13.5: one notification a day, the
// plan's reading and Memory's passages its two reasons).
// (Always: with neither reason on, what is pending is removed, and nothing
// scheduled; review r9-1 Major 8.)
daily_reschedule() {
    notify_schedule()
}

// The app active again: the permission asked again (no prompt now), which
// flips the switch off if Settings has turned it off; then scheduled.
daily_active() {
    if (reminders_any() || mm_reminder) notify_ask(2)
}

notify_schedule() {
    center: int = notify_center();
    if (center == 0) return;
    msg(center, sel("removeAllPendingNotificationRequests"));
    plan_on: bool = reminders_any();
    if (!plan_on && !mm_reminder) {
        note("bible: reminders 0 pending");
        return
    }
    if (plan_on) daily_ready();
    first: int = today();
    if (now_minutes() >= nt_minutes) first = first + 1;
    n: int = 0;
    plans_n: int = 0;
    memory_n: int = 0;
    for k in 0..30 {
        d: int = first + k;
        mem: bool = mm_reminder && memory_due_on(d) > 0;
        if (notify_add(center, d, mem)) {
            n = n + 1;
            if (rmp_n > 0) plans_n = plans_n + 1;
            if (mem) memory_n = memory_n + 1;
            if (n == 1 && diag_on) {
                // (The first request's words, for the demo's log.)
                for x in 0..fbuf_n
                    if (fbuf[x] as int == 10) fbuf[x] = 47i8;
                for x in 0..fbuf_n rm_spare[x] = fbuf[x];
                at: int = fbuf_n;
                fbuf_n = 0;
                fput_str("bible: reminder first: ");
                for x in 0..rm_title fput(rm_spare[x] as int);
                fput_str(" | ");
                for x in rm_title..at fput(rm_spare[x] as int);
                note_ns(fstring())
            }
        }
    }
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: scheduled ");
        fput_int(n);
        fput_str(" daily reminders from ");
        fput_iso_date(first);
        fput(32);
        put2(nt_minutes / 60);
        fput(58);
        put2(nt_minutes % 60);
        note_ns(fstring());
        fbuf_n = 0;
        fput_str("bible: reminders 30 days from ");
        fput_iso_date(first);
        fput(32);
        put2(nt_minutes / 60);
        fput(58);
        put2(nt_minutes % 60);
        fput_str(" (plan ");
        fput_int(plans_n);
        fput_str(", memory ");
        fput_int(memory_n);
        fput(41);
        note_ns(fstring())
    }
}

put2(n: int) {
    if (n < 10) fput(48);
    fput_int(n)
}

// A line of the log, an NSString.
note_ns(s: int) {
    n: int = nsstring_into(s, link_buf);
    try {
        write_bytes_n(2, link_buf, n);
        write(2, "\n")
    } with IoError _e -> { }
}

// The reminder for day d (mem, Memory's part too): the plans' (each whose
// switch is on and whose day isn't read: §16.11.5) and/or the passages to
// review (memory.l8's words); no scripture. False if neither.
notify_add(center: int, d: int, mem: bool): bool {
    if (!fput_reminder_all(d, mem)) return false;
    content: int = msg(make("UNMutableNotificationContent"), sel("autorelease"));
    msg1(content, sel("setTitle:"), nsstring_of(fbuf, rm_title));
    for x in rm_title..fbuf_n rm_spare[x - rm_title] = fbuf[x];
    msg1(content, sel("setBody:"), nsstring_of(rm_spare, fbuf_n - rm_title));
    n: int = 0;
    // ({"plans": the files' numbers of the plans it names, in the order
    // started}.)
    if (rmp_n > 0) {
        for j in 0..rmp_n nf_ids[j] = nsnumber_int(fw_num[rmp_slot[j]]);
        keys[n] = nsstring("plans");
        values[n] = nsarray(nf_ids, rmp_n);
        n = n + 1
    }
    if (mem) {
        keys[n] = nsstring("memory");
        values[n] = nsnumber_int(1);
        n = n + 1
    }
    msg1(content, sel("setUserInfo:"), nsdictionary(keys, values, n));
    msg1(content, sel("setSound:"), msg(cls("UNNotificationSound"), sel("defaultSound")));
    msg1(content, sel("setThreadIdentifier:"), nsstring("daily"));
    civil_date(d);
    parts: int = msg(make("NSDateComponents"), sel("autorelease"));
    msg1(parts, sel("setYear:"), date_y);
    msg1(parts, sel("setMonth:"), date_m);
    msg1(parts, sel("setDay:"), date_d);
    msg1(parts, sel("setHour:"), nt_minutes / 60);
    msg1(parts, sel("setMinute:"), nt_minutes % 60);
    trigger: int = msg2(cls("UNCalendarNotificationTrigger"), sel("triggerWithDateMatchingComponents:repeats:"),
        parts, 0);
    // (fbuf kept for the caller's log: the id made apart.)
    keep_n: int = fbuf_n;
    for x in 0..keep_n nf_spare[x] = fbuf[x];
    fbuf_n = 0;
    fput_str("daily-");
    fput_iso_date(d);
    id: int = fstring();
    fbuf_n = 0;
    for x in 0..keep_n fput(nf_spare[x] as int);
    request: int = msg3(cls("UNNotificationRequest"), sel("requestWithIdentifier:content:trigger:"),
        id, content, trigger);
    msg2(center, sel("addNotificationRequest:withCompletionHandler:"), request, 0);
    true
}

nf_spare: []i8 = new i8[1024](0i8);

nf_ids: []int = new int[16](0);

// ---- a reminder opened ----
notify_obj: int = 0;

// A day of the plan to go to once the reader is up (a reminder that
// launched the app), or 0.
pending_day: int = 0;

notify_setup() {
    center: int = notify_center();
    if (center == 0) return;
    k: int = objc_allocateClassPair(cls("NSObject"), "L8Notify", 0);
    add_method3(k, sel("userNotificationCenter:didReceiveNotificationResponse:withCompletionHandler:"),
        &notify_opened, "v@:@@@?");
    add_protocol(k, "UNUserNotificationCenterDelegate");
    objc_registerClassPair(k);
    notify_obj = make("L8Notify");
    msg1(center, sel("setDelegate:"), notify_obj)
}

notify_opened(
    _self: int,
    _cmd: int,
    _center: int,
    response: int,
    handler: int
): int {
    info: int = msg(msg(msg(msg(response, sel("notification")), sel("request")), sel("content")),
        sel("userInfo"));
    plans: int = if (info != 0) msg1(info, sel("objectForKey:"), nsstring("plans")) else 0;
    day: int = if (info != 0) msg1(info, sel("objectForKey:"), nsstring("day")) else 0;
    mem: int = if (info != 0) msg1(info, sel("objectForKey:"), nsstring("memory")) else 0;
    // (The first plan it names; an older build's {"day"}, the first
    // followed.)
    num: int = if (plans != 0 && msg(plans, sel("count")) > 0) msg(msg1(plans, sel("objectAtIndex:"),
        0), sel("longValue")) else if (day != 0 && fw_n > 0) fw_num[0] else 0;
    if (num > 0) notify_open_plan(num) else if (mem != 0) memory_reminder_opened();
    call_block(handler);
    0
}

// The reminder opened: the first plan it names (its file's number), its
// today in the day's reader (the sheets put away), or once the reader is
// up; its end offers the others (Also today).
notify_open_plan(num: int) {
    i: int = -1;
    for j in 0..fw_n
        if (fw_num[j] == num) i = j;
    if (i < 0) return;
    note_num("bible: reminder opened, plan file ", num);
    if (!restored) {
        pending_day = num;
        return
    }
    day_open_today_of(i)
}

// (The reader up: a reminder's day that came before it; else the day's
// reader, if it was up when the app was last shut.)
daily_reader_up() {
    if (pending_day > 0) {
        num: int = pending_day;
        pending_day = 0;
        notify_open_plan(num)
    } else if (pending_memory) {
        pending_memory = false;
        memory_reminder_opened()
    } else day_restore();
    // (At launch, nothing pending but the plan's own reminders: none, with
    // the switch off or no plan (an older build's verse of the day, or a
    // stopped plan's), and the plan's scheduled again with it on; and the
    // verse of the day's delivered ones put away. Review r5-1.)
    if (!reminders_any() && !mm_reminder) {
        center: int = notify_center();
        if (center != 0) {
            msg(center, sel("removeAllPendingNotificationRequests"));
            msg1(center, sel("removeDeliveredNotificationsWithIdentifiers:"), votd_ids());
            note("bible: pending reminders cleared")
        }
    }
    daily_reschedule()
}

// The ids an older build gave its verses of the day (votd-YYYY-MM-DD),
// for the 31 days to today.
votd_ids(): int {
    a: int = msg(cls("NSMutableArray"), sel("array"));
    for k in 0..32 {
        fbuf_n = 0;
        fput_str("votd-");
        fput_iso_date(today() - k);
        msg1(a, sel("addObject:"), fstring())
    }
    a
}

// A local time today (minutes past midnight) as a date.
date_at_minutes(m: int): int {
    t: int = local_day(time(0)) * 86400 - local_offset() + m * 60;
    msg_set_f(cls("NSDate"), sel("dateWithTimeIntervalSince1970:"), t as f64)
}

// ---- classes and methods ----
make_daily_classes() { }

add_daily_methods(app: int) {
    add_method1(app, sel("planRested:"), &plan_rested, "v@:@");
    add_method1(app, sel("authTick:"), &auth_tick, "v@:@")
}

// A reminder with only Memory's reason opened: the Library on Memory, Today
// at the top (Practice not begun for you).
memory_reminder_opened() {
    note("bible: memory reminder opened");
    // (A cold launch: once the reader is up, as the plan's day is kept;
    // review r9-1 Major 7.)
    if (!restored) {
        pending_memory = true;
        return
    }
    set_def_int("librarySegment", 3);
    // (A sheet up: put away first, and the Library opened once it has
    // gone, since a sheet can't be presented over one going away.)
    mm_open_tries = 0;
    memory_open_library(0, 0, 0)
}

mm_open_tries: int = 0;

// (Tried again every 0.3 s, up to 3 s, while a sheet is still going.)
memory_open_library(_self: int, _cmd: int, _timer: int): int {
    if (presented() != 0) {
        demo_dismiss();
        mm_open_tries = mm_open_tries + 1;
        if (mm_open_tries <= 10) _t: int = after_common(0.3f64, "memoryOpenLibrary:") else note("bible: Library not opened for Memory");
        return 0
    }
    open_library();
    note("bible: opened Library on Memory");
    0
}

pending_memory: bool = false;

// ---- the plans' lists (tables.l8) ----
daily_screens() {
    on_sheet_gone(&daily_sheet_gone)
}
