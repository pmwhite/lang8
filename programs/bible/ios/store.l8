tag bible_ios;

use_tag std, ios, bible;

// What the reader keeps: highlights, bookmarks, notes and the places jumped
// from, each a file of tab-separated lines in Application
// Support/SmoothBible (written whole after every change, by way of a
// temporary file), and the settings, in the user's defaults.
import "../../ios/objc.l8";

import "../core/text.l8";

import "../core/store.l8";

extern NSSearchPathForDirectoriesInDomains(directory: int, mask: int, expand: int): int;

extern memcpy_to(dst: int, src: []i8, n: int): int = memcpy;

// The directory the files are in (made, if it was not).
data_dir: int = 0;

dir_path(): int {
    if (data_dir != 0) return data_dir;
    dirs: int = NSSearchPathForDirectoriesInDomains(14, 1, 1);
    base: int = msg(dirs, sel("firstObject"));
    if (base == 0) base = NSHomeDirectory();
    data_dir = keep(msg1(base, sel("stringByAppendingPathComponent:"), nsstring("SmoothBible")));
    msg4(msg(cls("NSFileManager"), sel("defaultManager")), sel("createDirectoryAtPath:withIntermediateDirectories:attributes:error:"),
        data_dir, 1, 0, 0);
    data_dir
}

file_path(name: str): int {
    msg1(dir_path(), sel("stringByAppendingPathComponent:"), nsstring(name))
}

// fbuf written to the file name (whole, by way of a temporary file).
write_file(name: str) {
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    msg2(data, sel("writeToFile:atomically:"), file_path(name), 1)
}

// fbuf added to the end of the file name (made if there is none): never
// read back through fbuf, so a file past its size is not cut (review r5-1).
append_file(name: str) {
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    h: int = msg1(cls("NSFileHandle"), sel("fileHandleForWritingAtPath:"), file_path(name));
    if (h == 0) {
        msg2(data, sel("writeToFile:atomically:"), file_path(name), 1);
        return
    }
    msg(h, sel("seekToEndOfFile"));
    msg1(h, sel("writeData:"), data);
    msg(h, sel("closeFile"))
}

// The file name into fbuf (empty if there is none).
read_file(name: str) {
    fbuf_n = 0;
    data: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), file_path(name));
    if (data == 0) return;
    n: int = msg(data, sel("length"));
    if (n > len(fbuf)) n = len(fbuf);
    if (n > 0) memcpy_from(fbuf, msg(data, sel("bytes")), n);
    fbuf_n = n
}

save_highlights() {
    format_highlights();
    write_file("highlights.tsv")
}

save_bookmarks() {
    format_bookmarks();
    write_file("bookmarks.tsv")
}

save_notes() {
    format_notes();
    write_file("notes.tsv")
}

save_history() {
    format_history();
    write_file("history.tsv")
}

// Everything kept, read (a bad line skipped: store.l8).
load_marks() {
    read_file("highlights.tsv");
    parse_highlights();
    read_file("bookmarks.tsv");
    parse_bookmarks();
    read_file("notes.tsv");
    parse_notes();
    read_file("history.tsv");
    parse_history()
}

// ---- the settings ----
defaults(): int {
    msg(cls("NSUserDefaults"), sel("standardUserDefaults"))
}

def_int(key: str): int {
    msg1(defaults(), sel("integerForKey:"), nsstring(key))
}

set_def_int(key: str, n: int) {
    msg2(defaults(), sel("setInteger:forKey:"), n, nsstring(key))
}

def_bool(key: str): bool {
    (msg1(defaults(), sel("boolForKey:"), nsstring(key)) & 255) != 0
}

set_def_bool(key: str, on: bool) {
    msg2(defaults(), sel("setBool:forKey:"), if (on) 1 else 0, nsstring(key))
}

// What the settings are until they are changed.
def_keys: []int = new int[12](0);

def_values: []int = new int[12](0);

register_defaults() {
    yes: int = msg1(cls("NSNumber"), sel("numberWithBool:"), 1);
    two: int = msg1(cls("NSNumber"), sel("numberWithLong:"), 2);
    one: int = msg1(cls("NSNumber"), sel("numberWithLong:"), 1);
    def_keys[0] = nsstring("showVerseNumbers");
    def_values[0] = yes;
    def_keys[1] = nsstring("showHeadings");
    def_values[1] = yes;
    def_keys[2] = nsstring("showNotes");
    def_values[2] = yes;
    def_keys[3] = nsstring("sizeStep");
    def_values[3] = two;
    def_keys[4] = nsstring("spacing");
    def_values[4] = one;
    def_keys[5] = nsstring("margins");
    def_values[5] = one;
    def_keys[6] = nsstring("listenRate");
    def_values[6] = one;
    // (Learning's switches, on: DESIGN.md §14.1.9.)
    def_keys[7] = nsstring("learnHideKnown");
    def_values[7] = yes;
    def_keys[8] = nsstring("learnSpeakGreek");
    def_values[8] = yes;
    def_keys[9] = nsstring("learnSpeakHebrew");
    def_values[9] = yes;
    msg1(defaults(), sel("registerDefaults:"), nsdictionary(def_keys, def_values,
        10))
}

clamp(n: int, lo: int, hi: int): int {
    if (n < lo) lo else if (n > hi) hi else n
}

load_settings() {
    register_defaults();
    set_theme = clamp(def_int("theme"), 0, 5);
    set_font = clamp(def_int("font"), 0, 4);
    set_size = clamp(def_int("sizeStep"), 0, 7);
    set_spacing = clamp(def_int("spacing"), 0, 2);
    set_margins = clamp(def_int("margins"), 0, 2);
    lay_verse_numbers = def_bool("showVerseNumbers");
    lay_headings = def_bool("showHeadings");
    lay_notes = def_bool("showNotes");
    lay_verse_lines = def_bool("verseLines");
    red_letter = def_bool("redLetter");
    keep_on = def_bool("keepScreenOn")
}

save_settings() {
    set_def_int("theme", set_theme);
    set_def_int("font", set_font);
    set_def_int("sizeStep", set_size);
    set_def_int("spacing", set_spacing);
    set_def_int("margins", set_margins);
    set_def_bool("showVerseNumbers", lay_verse_numbers);
    set_def_bool("showHeadings", lay_headings);
    set_def_bool("showNotes", lay_notes);
    set_def_bool("verseLines", lay_verse_lines);
    set_def_bool("redLetter", red_letter)
}

// A note's text as an NSString.
note_string(i: int): int {
    nsstring_at(bytes_address(nt_pool) + nt_at[i], nt_len[i])
}
