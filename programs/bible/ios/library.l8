tag bible_ios;

use_tag std, ios, bible;

// The library's own parts (its screen is core's: core/skin.l8's
// SCR_LIBRARY): Export (DESIGN.md §8.5) and composing a chapter's note
// (§8.4), which its toolbar asks for.
import "../../ios/objc.l8";

import "../core/text.l8";

extern NSTemporaryDirectory(): int;

// Its search controller (core's field: ios/skin.l8's).
lib_search: int = 0;

// The Library shown made again (a passage added, learned, its ESV words
// come): faded, or at once.
lib_refresh(fade: bool) {
    if (lib_table == 0) return;
    if (fade) uk_refresh() else uk_reload_kind(SCR_LIBRARY)
}

// (What the demos type in its field: searched at once.)
library_typed(_text: int) {
    _q: bool = uk_search_updated(lib_search)
}

// Compose: the note of the chapter at the top of the reader (its own, if
// it has one), over the library.
library_compose(_self: int, _cmd: int, _item: int): int {
    open_note(cur, 0, 0);
    0
}

// The export's file's name (Smooth Bible Notes 2026-10-18.md), into fbuf.
export_name(today: int) {
    fbuf_n = 0;
    fput_str("Smooth Bible Notes ");
    fput_iso_date(today);
    fput_str(".md")
}

// Export: everything kept, as Markdown in a file of today's date, given to
// the share sheet. (The demo keeps a copy in Documents, for the CI.)
library_export(_self: int, _cmd: int, item: int): int {
    if (!anything_kept()) return 0;
    today: int = local_day(time(0));
    export_name(today);
    name: int = keep(fstring());
    ensure_quotable();
    export_notes(today);
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    path: int = msg1(NSTemporaryDirectory(), sel("stringByAppendingPathComponent:"),
        name);
    msg2(data, sel("writeToFile:atomically:"), path, 1);
    if (demo_on) {
        docs: int = msg(NSSearchPathForDirectoriesInDomains(9, 1, 1), sel("firstObject"));
        if (docs != 0) msg2(data, sel("writeToFile:atomically:"), msg1(docs, sel("stringByAppendingPathComponent:"),
            name), 1)
    }
    release(name);
    one[0] = msg1(cls("NSURL"), sel("fileURLWithPath:"), path);
    vc: int = msg2(msg(cls("UIActivityViewController"), sel("alloc")), sel("initWithActivityItems:applicationActivities:"),
        nsarray(one, 1), 0);
    pop: int = msg(vc, sel("popoverPresentationController"));
    if (pop != 0 && item != 0) msg1(pop, sel("setBarButtonItem:"), item) else if (is_ipad()) share_source(vc,
        0);
    host: int = top_presented();
    msg3(if (host != 0) host else nav, sel("presentViewController:animated:completion:"),
        vc, 1, 0);
    release(vc);
    0
}

add_library_methods(app: int) {
    add_method1(app, sel("libraryExport:"), &library_export, "v@:@");
    add_method1(app, sel("libraryCompose:"), &library_compose, "v@:@")
}
