tag bible_ios;

use_tag std, ios, bible;

// The iPhone as a skin (SKINS.md): core's screens (core/skin.l8), drawn
// as the app's own lists are, in UITableViews whose data comes from the
// screen's records (core/ui.l8); their actions handed to core; and what
// core then says to do (ui_effects) done the iPhone's way: a sheet, a
// screen pushed in it, the list made again, the sheet put away. The
// platform's work core asks for (switching the version) is the app's own.
import "../../ios/objc.l8";

import "../core/skin.l8";

// ---- the host ----
uk_switch_version(t: int): bool {
    haptic_select();
    switch_version(t);
    text_cur == t
}

// (What core changes of the defaults' own: the next plan file's number.)
uk_save_prefs() {
    if (pref("planNext", 0) > def_int("planNext")) set_def_int("planNext", pref("planNext",
        0))
}

uk_save_kept(what: int) {
    if (what == SK_KEPT_HISTORY) save_history();
    if (what == SK_KEPT_RIBBONS) ribbons_changed();
    if (what == SK_KEPT_MEMORY) memory_changed();
    if (what == SK_KEPT_CARDS) cards_changed();
    if (what == SK_KEPT_PLAN_DONE) plan_done_kept(dd_done_num);
    if (what == SK_KEPT_PLANS) {
        for i in 0..fw_n save_plan(i);
        daily_reschedule()
    }
    if (what == SK_KEPT_HIGHLIGHTS) save_highlights();
    if (what == SK_KEPT_NOTES) save_notes();
    if (what == SK_KEPT_BOOKMARKS) save_bookmarks();
    // (The chapter of the marks changed laid out again.)
    if ((what == SK_KEPT_HIGHLIGHTS || what == SK_KEPT_NOTES || what == SK_KEPT_BOOKMARKS) && sk_kept_c >= 0) remake(sk_kept_c);
    if (what == SK_KEPT_SEARCHES) {
        if (sk_searches_n == 0) {
            msg1(defaults(), sel("removeObjectForKey:"), nsstring("recentSearches"));
            return
        }
        a: int = make("NSMutableArray");
        for i in 0..sk_searches_n {
            sk_search_words(i);
            msg1(a, sel("addObject:"), fstring())
        }
        msg2(defaults(), sel("setObject:forKey:"), a, nsstring("recentSearches"));
        release(a)
    }
}

// Words only the app has: a passage's (Memory's: its own version's words
// and state), the app's version line, the voice tip (the Settings app's
// path).
uk_words(what: int) {
    fbuf_n = 0;
    if (what == SK_WORDS_RANGE_TEXT) {
        // (The ESV's words of a range: its verses held here.)
        made: bool = mm_range_text(sk_words_arg, rg_c1, rg_v1, rg_c2, rg_v2);
        fbuf_n = 0;
        if (made) fput_first_words(2000)
    } else if (what == SK_WORDS_APP_VERSION) {
        n: int = nsstring_into(app_version_line(), uk_query_buf);
        fput_bytes(uk_query_buf, 0, n)
    } else if (what == SK_WORDS_VOICE_TIP) fput_str(" For a more natural voice, download an Enhanced or Premium English voice in the Settings app: Accessibility \â\€\º Read & Speak \â\€\º Voices \â\€\º English.")
}

// Numbers only the app knows (core/skin.l8's SK_NUM_).
uk_num(what: int, a: int): int {
    if (what == SK_NUM_AUDIO_SOURCE) return audio_source(a);
    if (what == SK_NUM_ESV_AUDIO) return if (esv_audio_listed()) 1 else 0;
    if (what == SK_NUM_CELLULAR) return if (def_bool("downloadAheadCellular")) 1 else 0;
    if (what == SK_NUM_DOWNLOADED) return downloaded_mb();
    if (what == SK_NUM_BETTER_VOICE) return if (better_voice_installed()) 1 else 0;
    if (what == SK_NUM_TEXT) {
        if (a < 0 || a >= TEXTS) return 0;
        ensure_text(a);
        return if (tx_ready[a]) 1 else 0
    }
    if (what == SK_NUM_ESV_STATE) return if (esv_held(a)) 0 else if (uk_esv_state >= ESV_OFFLINE) 2 else 1;
    if (what == SK_NUM_LANG) {
        lang_load();
        ensure_learn_lang();
        return if (lang_ready) 1 else 0
    }
    if (what == SK_NUM_END_SEEN) return if (chapter_end_seen(a)) 1 else 0;
    if (what == SK_NUM_MEMORY_TEXT) return if (mm_text(a)) 1 else 0;
    if (what == SK_NUM_OWN_JUMPS || what == SK_NUM_OWN_LISTEN) return 1;
    if (what == SK_NUM_VOICE_SEEN) return if (def_bool("voiceScreenSeen")) 1 else 0;
    if (what == SK_NUM_ESV_SEARCH) return esv_sr_state;
    if (what == SK_NUM_OWN_VIEW) return if (a == SCR_PRACTICE || a == SCR_PASSAGE || a == SCR_FOOTNOTE || a == SCR_DAY || a == SCR_PLAN || a == SCR_DAY1 || a == SCR_MANUAL || a == SCR_VOICE) 1 else 0;
    if (what == SK_NUM_REMIND) return if (a == 0) nt_minutes else if (a == 1) if (nt_denied) 1 else 0 else if (mm_reminder) 1 else 0;
    if (what == SK_NUM_QUOTABLE) {
        ensure_quotable();
        return 1
    }
    if (what == SK_NUM_LEARN) {
        if (cd_n == 0 && !ln_mapped) return 0;
        ensure_learn();
        return 1
    }
    if (what == SK_NUM_DOWNLOAD) {
        // (Book a's chapters here for the version's reader, and the one
        // coming: thousandths; 1000 whole.)
        downloads_open();
        s: int = dl_reader();
        if (a < 0 || a >= books || dl_index(s, a) < 0) return -1;
        part: f64 = 0.0f64;
        if (dl_c >= 0 && !dl_ahead && dl_s == s && ch_book[dl_c] == a && dl_want > 0) part = dl_got as f64 / dl_want as f64;
        // (Core's measure: its chapters here and the one coming.)
        return dl_progress(s, a, dl_have(s, a), part)
    }
    -1
}

// The ESV's chapter asked for (by Compare): coming, or why it can't.
uk_esv_state: int = 0;

// Lists only the app has (SK_ITEMS_): the English voices installed, best
// first, the one chosen (if it still is) flagged.
uk_fill(what: int) {
    if (what != SK_ITEMS_VOICES) return;
    if (!vo_read) voices_read();
    vid: int = msg1(defaults(), sel("stringForKey:"), nsstring("listenVoiceID"));
    for i in 0..vo_n {
        fbuf_n = 0;
        fput_voice(vo_obj[i]);
        chosen: bool = vid != 0 && (msg1(msg(vo_obj[i], sel("identifier")), sel("isEqualToString:"),
            vid) & 255) != 0;
        sk_item_fbuf(vo_q[i] / 10, if (chosen) 1 else 0)
    }
}

// Core made ready for the iPhone (once, as the app begins).
uk_begin() {
    ui_wire = false;
    sk_device = "iPhone";
    sk_has_orig = true;
    sk_host = SkinHost {
        save_prefs: &uk_save_prefs,
        save_kept: &uk_save_kept,
        words: &uk_words,
        switch_version: &uk_switch_version,
        num: &uk_num,
        fill: &uk_fill,
        fetch: &esv_fetch
    };
    sk_has_listen = true;
    sk_has_manual = true;
    sk_has_acknowledgements = true;
    sk_has_keep_on = true;
    sk_has_ribbons = true;
    sk_has_reminders = true;
    sk_fonts = font_names;
    // (The recent searches, kept in the defaults as they were.)
    a: int = msg1(defaults(), sel("arrayForKey:"), nsstring("recentSearches"));
    if (a != 0) {
        for i in 0..msg(a, sel("count")) {
            n: int = nsstring_into(msg1(a, sel("objectAtIndex:"), i), uk_query_buf);
            sk_searches_add(uk_query_buf, n)
        }
    }
}

// The app's settings, as core keeps them (by the defaults' names), so its
// screens show them as they are.
uk_prefs_from_app() {
    set_pref("sizeStep", set_size);
    set_pref("theme", set_theme);
    set_pref("font", set_font);
    set_pref("spacing", set_spacing);
    set_pref("margins", set_margins);
    set_pref_on("showVerseNumbers", lay_verse_numbers);
    set_pref_on("showHeadings", lay_headings);
    set_pref_on("showNotes", lay_notes);
    set_pref_on("verseLines", lay_verse_lines);
    set_pref_on("redLetter", red_letter);
    set_pref_on("keepScreenOn", keep_on);
    set_pref_on("origAccents", lay_accents);
    set_pref("listenRate", pref_fit("listenRate", def_int("listenRate")));
    set_pref("origGlosses", pref_fit("origGlosses", def_int("origGlosses")));
    set_pref("librarySegment", pref_fit("librarySegment", def_int("librarySegment")));
    set_pref("librarySort", pref_fit("librarySort", def_int("librarySort")));
    set_pref_on("learnHideKnown", def_bool("learnHideKnown"));
    set_pref("learnPronGreek", def_int("learnPronGreek"));
    set_pref("learnPronHebrew", def_int("learnPronHebrew"));
    set_pref("studySegment", pref_fit("studySegment", def_int("studySegment")));
    set_pref("interlinearOrder", pref_fit("interlinearOrder", def_int("interlinearOrder")));
    for name in ["memorySeen", "memoryType", "learnSeen", "learnReadSeen"] set_pref_on(name,
        def_bool(name));
    set_pref("planNext", def_int("planNext"));
    set_pref_on("memoryReminder", mm_reminder);
    // (The highlight color used last, kept by its name.)
    lh: int = msg1(defaults(), sel("stringForKey:"), nsstring("lastHighlight"));
    if (lh != 0) {
        for i in 0..5
            if ((msg1(lh, sel("isEqualToString:"), nsstring(hl_names[i])) & 255) != 0) set_pref("lastHighlight",
                i)
    }
}

// A setting core changed, done as the app does it (kept, and the reader
// made again, faded where the app fades it).
uk_app_from_prefs() {
    n: int = pref_get("sizeStep");
    if (n != set_size) set_size_step(n);
    if (pref("theme", set_theme) != set_theme) {
        set_theme = pref_get("theme");
        haptic_select();
        settings_changed(true)
    }
    if (pref("font", set_font) != set_font) {
        set_font = clamp(pref("font", 0), 0, len(font_names) - 1);
        settings_changed(false)
    }
    spacing: int = pref_get("spacing");
    margin: int = pref_get("margins");
    shown: bool = pref_on("showVerseNumbers", lay_verse_numbers) != lay_verse_numbers || pref_on("showHeadings",
        lay_headings) != lay_headings || pref_on("showNotes", lay_notes) != lay_notes || pref_on("verseLines",
        lay_verse_lines) != lay_verse_lines;
    if (spacing != set_spacing || margin != set_margins || shown) {
        set_spacing = spacing;
        set_margins = margin;
        lay_verse_numbers = pref_on("showVerseNumbers", lay_verse_numbers);
        lay_headings = pref_on("showHeadings", lay_headings);
        lay_notes = pref_on("showNotes", lay_notes);
        lay_verse_lines = pref_on("verseLines", lay_verse_lines);
        save_settings();
        make_look();
        relayout()
    }
    if (pref_on("redLetter", red_letter) != red_letter) set_red_letter(!red_letter);
    if (pref_on("keepScreenOn", keep_on) != keep_on) set_keep_on(!keep_on);
    if (pref_on("origAccents", lay_accents) != lay_accents) set_accents(!lay_accents);
    for name in ["librarySegment", "librarySort", "learnHideKnown", "learnPronGreek",
        "learnPronHebrew", "studySegment", "interlinearOrder"]
        if (pref(name, 0) != def_int(name)) set_def_int(name, pref(name, 0));
    gl: int = pref_get("origGlosses");
    if (gl > 0 && gl != pref_fit("origGlosses", def_int("origGlosses"))) set_gloss_mode(gl - 1);
    if (pref("planNext", 0) > def_int("planNext")) set_def_int("planNext", pref("planNext",
        0));
    lh: int = pref_get("lastHighlight");
    msg2(defaults(), sel("setObject:forKey:"), nsstring(hl_names[lh]), nsstring("lastHighlight"));
    rate: int = pref_get("listenRate");
    if (rate != pref_fit("listenRate", def_int("listenRate"))) listen_set_speed(rate)
}

// What core reads of the app's state, as it is now.
uk_sync() {
    uk_prefs_from_app();
    sk_esv_listed = esv_listed();
    sk_c = cur;
    // (Where in it, as last measured: Go To's New Ribbon's place.)
    sk_v = place_v;
    sk_frac = place_frac;
    sk_tz = local_offset();
    sk_esv_results = esv_sr_on;
    sk_today = today();
    // (No Practice sheet: no session going, whatever core was told.)
    if (px_nav == 0 && px_live) px_closed();
    // (The plans made, once: their files are the app's.)
    daily_ready();
    // (The chapters the ribbons' rows show.)
    sk_listed_n = 0;
    for i in 0..rb_n {
        if (sk_listed_n < len(sk_listed_c)) {
            sk_listed_c[sk_listed_n] = rb_c[i];
            sk_listed_n = sk_listed_n + 1
        }
    }
}

// ---- the lists: a slot each for the screens shown ----
UK_SLOTS: int = 12;

uk_tables: []int = new int[UK_SLOTS](0);

uk_vcs: []int = new int[UK_SLOTS](0);

// Each slot's screen (core's id; 0: free).
uk_ids: []int = new int[UK_SLOTS](0);

uk_slot_of(t: int): int {
    if (t == 0) return -1;
    for k in 0..UK_SLOTS
        if (uk_tables[k] == t) return k;
    -1
}

uk_slot_of_id(id: int): int {
    for k in 0..UK_SLOTS
        if (uk_ids[k] == id && id != 0) return k;
    -1
}

// The records of slot k's screen, built if they are another's (or stale).
uk_stale: bool = true;

uk_ensure(k: int): bool {
    id: int = uk_ids[k];
    if (id == 0) return false;
    if (ui_id == id && !uk_stale) return true;
    i: int = sk_find(id);
    if (i < 0) return false;
    uk_sync();
    sk_build(i);
    uk_stale = false;
    true
}

uk_text(t: UiText): int {
    if (t.n == 0) 0 else nsstring_at(bytes_address(ui_pool) + t.at, t.n)
}

uk_sections(t: int): int {
    k: int = uk_slot_of(t);
    // (A reload begins here: the app's settings may have changed since.)
    uk_stale = true;
    if (k < 0 || !uk_ensure(k)) 0 else ui_sections_n
}

uk_rows(t: int, s: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= ui_sections_n) return 0;
    // (A grid: its rows one cell of them.)
    if (ui_grid)
        if (ui_sections[s].n > 0) 1 else 0 else ui_sections[s].n
}

uk_header(t: int, s: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= ui_sections_n) return 0;
    uk_text(ui_sections[s].header)
}

uk_footer(t: int, s: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= ui_sections_n) return 0;
    uk_text(ui_sections[s].footer)
}

// The row at path (of the screen just ensured), or -1.
uk_row_at(path: int): int {
    uk_row_of(msg(path, sel("section")), msg(path, sel("row")))
}

// Row r of section s (made now, a lazy section's), or -1.
uk_row_of(s: int, r: int): int {
    if (s < 0 || s >= ui_sections_n || r < 0 || r >= ui_sections[s].n) return -1;
    if (ui_sections[s].lazy) ui_lazy_row(s, r) else ui_sections[s].first + r
}

// A row as the app's lists draw it: its words (a subtitle under, or a value
// beside, its title), an image, and a check or a disclosure; a switch or a
// segmented control for a toggle or a choice; or the app's own cell for a
// row with its own presentation (the settings' size, themes, Listen).
uk_cell(t: int, path: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k)) return list_cell(t, "none", 0);
    i: int = uk_row_at(path);
    if (i < 0) return list_cell(t, "none", 0);
    row: UiRow = ui_rows[i];
    if (row.custom == CUSTOM_SIZE) return size_cell(t, i);
    if (row.custom == CUSTOM_THEMES) return theme_cell(t);
    if (row.custom == CUSTOM_LISTEN) return listen_cell(t, i);
    if (row.custom == CUSTOM_HIT) return uk_hit_cell(t, i);
    if (row.custom == CUSTOM_VERSES || row.busy) return uk_row_extras(uk_verses_cell(t,
        i), k, i);
    if (row.custom == CUSTOM_MARK) return uk_row_extras(uk_mark_cell(t, i), k, i);
    if (row.custom == CUSTOM_PASSAGE) return uk_row_extras(uk_passage_cell(t, i),
        k, i);
    if (ui_grid) return uk_grid_cell_of(t, k, msg(path, sel("section")));
    if (row.kind == UI_TEXT) return uk_text_cell(t, k, i);
    if (row.kind == UI_TILES) return uk_tiles_cell(t, k, i);
    if (row.lead.n > 0) return uk_row_extras(uk_letter_cell(t, i), k, i);
    if (row.cells_n > 0) return uk_grid_cell(t, k, i);
    if (row.kind == UI_FIELD && row.field_kind == 2) return uk_prose_cell(t, k, i);
    if (row.kind == UI_FIELD) return uk_field_cell(k, i);
    if (row.custom == CUSTOM_SWATCHES) return uk_swatch_cell(k, i);
    if (row.circle > 0) return uk_circle_cell(t, k, i);
    downloading: bool = row.custom == CUSTOM_DOWNLOAD;
    if (row.kind == UI_TOGGLE || row.kind == UI_CHOICE || row.kind == UI_TIME) return uk_control_cell(t,
        k, i);
    kind: int = if (row.detail.n == 0) 0 else if (row.value_detail) 1 else 2;
    cell: int = list_cell(t, if (kind == 2) "coresub" else if (kind == 1) "corevalue" else "corerow",
        kind);
    config: int = list_config(kind);
    msg1(config, sel("setText:"), uk_text(row.title));
    msg1(text_props(config), sel("setColor:"), if (row.destructive) msg(cls("UIColor"),
        sel("systemRedColor")) else if (row.tinted) c_accent else if (row.faint) c_faint else c_ink);
    // (A button's words centered: Delete Ribbon.)
    if (row.kind == UI_BUTTON) msg1(text_props(config), sel("setAlignment:"), 1);
    // (A strong row's title: Go To's reference, the book being read.)
    msg1(text_props(config), sel("setFont:"), if (row.custom == CUSTOM_FONT) font_sample(row.arg) else if (row.strong) sans(17.0f64,
        0.3f64) else msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleBody")));
    if (row.detail.n > 0 && row.scripture) {
        // (The Bible's words: the divine name in small capitals, one line.)
        msg1(config, sel("setSecondaryAttributedText:"), preview(uk_text(row.detail),
            false, 15.0f64, c_faint));
        msg1(detail_props(config), sel("setColor:"), c_faint);
        msg1(detail_props(config), sel("setNumberOfLines:"), if (row.strong) 2 else 1)
    } else if (row.detail.n > 0) {
        msg1(config, sel("setSecondaryText:"), uk_text(row.detail));
        msg1(detail_props(config), sel("setColor:"), c_faint);
        if (row.small) msg1(detail_props(config), sel("setFont:"), msg1(cls("UIFont"),
            sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleFootnote")));
        if (row.strong) msg1(detail_props(config), sel("setNumberOfLines:"), 2)
    }
    if (row.icon.n == 6 && ui_pool[row.icon.at] as int == 114 && ui_pool[row.icon.at + 1] as int == 105) {
        // (A ribbon: its own glyph, in its color.)
        msg1(config, sel("setImage:"), ribbon_row_glyph());
        msg1(msg(config, sel("imageProperties")), sel("setTintColor:"), uk_icon_color(row))
    } else if (row.icon.n > 0) {
        // (Of the body's size, as the app's rows' icons are; a strong
        // row's larger.)
        color: int = if (row.icon_faint) c_faint else c_accent;
        name: int = uk_text(row.icon);
        if (row.strong) {
            sc: int = msg_f1(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
                22.0f64, 4);
            msg1(config, sel("setImage:"), msg2(msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
                name, sc), sel("imageWithTintColor:renderingMode:"), color, 1))
        } else {
            sc: int = msg1(cls("UIImageSymbolConfiguration"), sel("configurationWithTextStyle:"),
                objc_const("UIFontTextStyleBody"));
            msg1(config, sel("setImage:"), msg2(msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
                name, sc), sel("imageWithTintColor:renderingMode:"), color, 1))
        }
        msg1(msg(config, sel("imageProperties")), sel("setTintColor:"), color)
    }
    if (row.lines > 0) msg1(detail_props(config), sel("setNumberOfLines:"), row.lines);
    // (Rich words: a title or detail set by its runs; a note under the
    // detail, small and faint.)
    title_font: int = msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleBody"));
    if (row.truns_n > 0) msg1(config, sel("setAttributedText:"), uk_rich_text(uk_text(row.title),
        row.truns, row.truns_n, title_font, c_ink));
    if (row.title_lines > 0) {
        msg1(text_props(config), sel("setNumberOfLines:"), row.title_lines);
        msg1(text_props(config), sel("setLineBreakMode:"), 4)
    }
    if (row.runs_n > 0 && !row.scripture) msg1(config, sel("setSecondaryAttributedText:"),
        uk_rich_text(uk_text(row.detail), row.runs, row.runs_n, msg1(cls("UIFont"),
        sel("preferredFontForTextStyle:"), objc_const(if (kind == 1) "UIFontTextStyleBody" else "UIFontTextStyleSubheadline")),
        c_faint));
    if (row.note.n > 0) {
        a: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
        if (row.detail.n > 0) {
            d: int = msg(config, sel("secondaryAttributedText"));
            if (d != 0) msg1(a, sel("appendAttributedString:"), d) else append(a,
                uk_text(row.detail), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
                objc_const("UIFontTextStyleBody")), c_ink);
            append(a, nsstring("\n"), sans(6.0f64, 0.0f64), c_faint)
        }
        append(a, uk_text(row.note), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
            objc_const("UIFontTextStyleFootnote")), c_faint);
        msg1(config, sel("setSecondaryAttributedText:"), a);
        msg1(detail_props(config), sel("setNumberOfLines:"), 0)
    }
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setTintColor:"), c_accent);
    acc: int = if (row.acc == ACC_CHECK) 3 else if (row.acc == ACC_MORE) 1 else if (row.acc == ACC_INFO) 4 else 0;
    msg1(cell, sel("setAccessoryType:"), acc);
    if (row.acc == ACC_LINK) {
        // (A page outside the app: an arrow up and away.)
        iv: int = msg(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
            symbol("arrow.up.right", 13.0f64, 6, c_faint)), sel("autorelease"));
        msg1(cell, sel("setAccessoryView:"), iv)
    }
    if (row.acc == ACC_DONE) {
        // (Today's reading read: a faint check, nothing to choose.)
        img: int = msg(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
            symbol("checkmark", 15.0f64, 5, c_faint)), sel("autorelease"));
        msg(img, sel("sizeToFit"));
        msg1(img, sel("setAccessibilityLabel:"), nsstring(ui_acc_done_words));
        msg1(cell, sel("setAccessoryView:"), img)
    }
    // (A book downloading: its ring, which can stop it, a ring a list.)
    if (downloading) msg1(cell, sel("setAccessoryView:"), dl_ring(row.arg, if (uk_kind_of(uk_ids[k]) == SCR_DOWNLOADS) 0 else 1));
    // (Words at the row's end, as a time is: a label of their own; with a
    // disclosure, a count beside it, a word known checked.)
    if (row.trailing.n > 0 && row.acc == ACC_MORE) msg1(cell, sel("setAccessoryView:"),
        if (row.on) value_check_disclosure(uk_text(row.trailing)) else value_disclosure(uk_text(row.trailing),
        c_faint)) else if (row.trailing.n > 0) {
        l: int = msg(make("UILabel"), sel("autorelease"));
        msg1(l, sel("setText:"), uk_text(row.trailing));
        msg1(l, sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
            objc_const("UIFontTextStyleBody")));
        msg1(l, sel("setTextColor:"), c_faint);
        msg(l, sel("sizeToFit"));
        msg1(cell, sel("setAccessoryView:"), l)
    }
    if (row.disabled) {
        // (Dimmed by its colors: a content view's alpha is the
        // configuration's to set.)
        msg1(text_props(config), sel("setColor:"), msg_set_f(c_ink, sel("colorWithAlphaComponent:"),
            0.4f64));
        msg1(detail_props(config), sel("setColor:"), msg_set_f(c_faint, sel("colorWithAlphaComponent:"),
            0.4f64));
        msg1(cell, sel("setContentConfiguration:"), config)
    }
    msg1(cell, sel("setSelectionStyle:"), if (row.disabled || row.faint || row.action == 0) 0 else 3);
    msg1(cell, sel("setUserInteractionEnabled:"), if (row.disabled) 0 else 1);
    if (row.label.n > 0) msg1(cell, sel("setAccessibilityLabel:"), uk_text(row.label)) else msg1(cell,
        sel("setAccessibilityLabel:"), 0);
    msg1(cell, sel("setAccessibilityTraits:"), if (row.disabled) 256 else if (row.acc == ACC_CHECK) objc_const("UIAccessibilityTraitSelected") else 0);
    msg1(cell, sel("setAccessibilityHint:"), if (row.hint.n > 0) uk_text(row.hint) else 0);
    // (Its actions as a menu at its end, too: a word's.)
    if (row.menu && row.actions_n > 0) msg1(cell, sel("setAccessoryView:"), uk_menu_view(k,
        i));
    uk_row_extras(cell, k, i)
}

// A row's actions for VoiceOver (its custom actions, each saying its slot,
// row and index: (k * 4096 + i) * 8 + j); none, if it has none.
uk_act_key: []int = new int[1](0);

uk_row_extras(cell: int, k: int, i: int): int {
    row: UiRow = ui_rows[i];
    if (row.actions_n == 0) {
        msg1(cell, sel("setAccessibilityCustomActions:"), 0);
        return cell
    }
    for j in 0..row.actions_n {
        if (j < len(one)) {
            a: UiAction = ui_actions[row.actions + j];
            one[j] = msg(msg3(msg(cls("UIAccessibilityCustomAction"), sel("alloc")),
                sel("initWithName:target:selector:"), uk_text(a.title), app_obj, sel("coreRowAction:")),
                sel("autorelease"));
            objc_setAssociatedObject(one[j], ints_address(uk_act_key), nsnumber_int((k * 4096 + i) * 8 + j),
                1)
        }
    }
    msg1(cell, sel("setAccessibilityCustomActions:"), nsarray(one, row.actions_n));
    cell
}

uk_row_action(_self: int, _cmd: int, a: int): int {
    nn: int = objc_getAssociatedObject(a, ints_address(uk_act_key));
    if (nn == 0) return 0;
    uk_row_act(msg(nn, sel("longValue")))
}

// Action j of row i of slot k ((k * 4096 + i) * 8 + j) done.
uk_row_act(n: int): int {
    k: int = n / 8 / 4096;
    i: int = n / 8 % 4096;
    j: int = n % 8;
    if (k >= UK_SLOTS || !uk_ensure(k) || i >= ui_rows_n || j >= ui_rows[i].actions_n) return 0;
    action: int = ui_actions[ui_rows[i].actions + j].action;
    arg: int = ui_rows[i].arg;
    // (A row's Delete: as its swipe, the row going.)
    if (action == ui_rows[i].delete_action) {
        for s in 0..ui_sections_n {
            if (i >= ui_sections[s].first && i < ui_sections[s].first + ui_sections[s].n) {
                uk_delete_row(k, s, i - ui_sections[s].first, action, arg);
                return 1
            }
        }
    }
    uk_sync();
    sk_act(uk_ids[k], action, arg, 0);
    uk_effects();
    1
}

// A config's image: a symbol (an NSString's name), tinted, at the body's
// size (17) growing with the text, or at a size.
uk_config_image(
    config: int,
    name: int,
    size: f64,
    color: int
) {
    sc: int = if (size == 17.0f64) msg1(cls("UIImageSymbolConfiguration"), sel("configurationWithTextStyle:"),
        objc_const("UIFontTextStyleBody")) else msg_f1(cls("UIImageSymbolConfiguration"),
        sel("configurationWithPointSize:weight:"), size, 4);
    image: int = msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
        name, sc);
    if (image != 0 && color != 0) image = msg2(image, sel("imageWithTintColor:renderingMode:"),
        color, 1);
    msg1(config, sel("setImage:"), image);
    msg1(msg(config, sel("imageProperties")), sel("setTintColor:"), color)
}

// The row's icon color (its hex), or the accent.
uk_icon_color(row: UiRow): int {
    if (row.icon_color.n == 0) return c_accent;
    for x in 0..row.icon_color.n uk_query_buf[x] = ui_pool[row.icon_color.at + x];
    uk_hex_color(row.icon_color.n)
}

// Verses as the reader sets them, smaller (Compare's): its runs' words,
// the divine name in small capitals, the words of Jesus red if they are,
// supplied words italic, a verse's number small and faint, a verse not in
// the version faint and italic; or, waiting, its words faint by a
// spinner.
uk_verses_cell(_t: int, i: int): int {
    row: UiRow = ui_rows[i];
    cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, 0), sel("autorelease"));
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    content: int = msg(cell, sel("contentView"));
    label: int = make("UILabel");
    msg1(label, sel("setNumberOfLines:"), 0);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    size: f64 = em * 0.9f64;
    if (row.busy || row.custom != CUSTOM_VERSES) {
        msg1(label, sel("setText:"), uk_text(if (row.title.n > 0) row.title else row.detail));
        msg1(label, sel("setFont:"), body(size));
        msg1(label, sel("setTextColor:"), c_faint);
        msg1(cell, sel("setSelectionStyle:"), 0);
        if (row.busy) {
            sp: int = msg1(msg(cls("UIActivityIndicatorView"), sel("alloc")), sel("initWithActivityIndicatorStyle:"),
                100);
            msg1(sp, sel("setColor:"), c_faint);
            msg(sp, sel("startAnimating"));
            msg1(sp, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
            msg1(content, sel("addSubview:"), sp);
            release(sp);
            pin_by(sp, content, "leadingAnchor", 16.0f64);
            pin_to(sp, "centerYAnchor", content, "centerYAnchor", 0.0f64);
            // (Faded in, not at once: most chapters come sooner.)
            animate(msg(sp, sel("layer")), "opacity", 0.0f64, 1.0f64, false, 0.4f64)
        }
    } else {
        msg1(label, sel("setAttributedText:"), uk_runs_text(i, size));
        msg1(cell, sel("setSelectionStyle:"), 3);
        if (row.hint.n > 0) msg1(cell, sel("setAccessibilityHint:"), uk_text(row.hint))
    }
    msg1(content, sel("addSubview:"), label);
    release(label);
    pin_by(label, content, "leadingAnchor", if (row.busy) 44.0f64 else 16.0f64);
    pin_by(label, content, "trailingAnchor", -16.0f64);
    pin_by(label, content, "topAnchor", 14.0f64);
    pin_by(label, content, "bottomAnchor", -14.0f64);
    cell
}

// Row i's detail by its runs, at size (the Hebrew right to left).
uk_runs_text(i: int, size: f64): int {
    row: UiRow = ui_rows[i];
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    p: int = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.3f64), sel("autorelease"));
    rtl: bool = false;
    for x in 0..row.runs_n
        if (ui_runs[row.runs + x * 2 + 1] == STYLE_ORIG && row.arg == TEXT_ORIG) rtl = sk_cmp_c >= 0 && sk_cmp_c < chapters && ch_book[sk_cmp_c] < 39;
    if (rtl) {
        msg1(p, sel("setBaseWritingDirection:"), 1);
        msg1(p, sel("setAlignment:"), 4);
        msg_set_f(p, sel("setLineHeightMultiple:"), 1.5f64)
    }
    text: int = uk_text(row.detail);
    if (text == 0) return s;
    from: int = 0;
    for x in 0..row.runs_n {
        e: int = ui_runs[row.runs + x * 2];
        st: int = ui_runs[row.runs + x * 2 + 1];
        if (e > from) {
            font: int = if (st == RUN_NUMBER) body(size * 0.78f64) else if (st == RUN_MISSING) italic(size) else if (st == STYLE_ORIG || st == STYLE_ORIG_GL) if (rtl) sans(size * 1.15f64,
                0.0f64) else new_york(size) else if (st == STYLE_SUPPLIED || st == STYLE_JESUS_SUPPLIED) italic(size) else if (st == STYLE_CAPS || st == STYLE_JESUS_CAPS) if (caps_by_hand) body(size * 0.8f64) else small_caps(size) else body(size);
            color: int = if (st == RUN_NUMBER || st == RUN_MISSING) c_faint else if ((st == STYLE_JESUS || st == STYLE_JESUS_CAPS || st == STYLE_JESUS_SUPPLIED) && red_letter) c_accent else c_ink;
            cmp_put(s, msg2(text, sel("substringWithRange:"), from, e - from), font,
                color, p)
        }
        from = e
    }
    s
}

// Words set by runs (core/ui.l8's RUN_ and the reader's STYLE_), from a
// face and color.
uk_rich_text(
    text: int,
    at: int,
    n: int,
    font: int,
    color: int
): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    if (text == 0) return s;
    size: f64 = msg_f(font, sel("pointSize"));
    from: int = 0;
    for x in 0..n {
        e: int = ui_runs[at + x * 2];
        st: int = ui_runs[at + x * 2 + 1];
        if (e > from) {
            f: int = font;
            c: int = color;
            if (st == RUN_GREEK || st == RUN_GREEK_FAINT) f = original_font(true,
                size, size + 2.0f64) else if (st == RUN_HEBREW || st == RUN_HEBREW_FAINT) f = original_font(false,
                size, size + 2.0f64) else if (st == RUN_TRANSLIT) f = italic_sans(size) else if (st == RUN_CODE) f = mono(size) else if (st == RUN_STRONG) f = sans(size,
                0.4f64) else if (st == RUN_SMALL) f = sans(13.0f64, 0.0f64) else if (st == RUN_READING) f = body(scaled(16.0f64)) else if (st == RUN_SCRIPTURE) f = body(em * 0.9f64);
            if (st == RUN_ITALIC) f = italic_sans(size);
            if (st == RUN_SCRIPTURE) c = c_ink;
            if (st == RUN_ACCENT) c = c_accent else if (st == RUN_PLAIN || st == RUN_GREEK || st == RUN_HEBREW || st == RUN_STRONG || st == RUN_READING || st == RUN_ITALIC) c = c_ink else if (st == RUN_FAINT || st == RUN_TRANSLIT || st == RUN_SMALL || st == RUN_GREEK_FAINT || st == RUN_HEBREW_FAINT) c = c_faint;
            at: int = msg(s, sel("length"));
            part: int = msg2(text, sel("substringWithRange:"), from, e - from);
            append(s, part, f, c);
            // (The Bible's words: the divine name in small capitals.)
            if (st == RUN_SCRIPTURE) caps_into(s, at, part, true, em * 0.9f64)
        }
        from = e
    }
    // (Anything after the last run, in the face given.)
    total: int = msg(text, sel("length"));
    if (total > from) append(s, msg2(text, sel("substringWithRange:"), from, total - from),
        font, color);
    s
}

// A word as the screen's heading: the word large in its script (made
// smaller to fit, rather than cut off), its transliteration, and its line.
uk_hero_view(W: f64): int {
    v: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, W, 100.0f64), sel("autorelease"));
    hero: int = label_of(attributed(uk_text(ui_hero), original_font(ui_hero_script == RUN_GREEK,
        34.0f64, 40.0f64), c_ink));
    tr: int = label_of(attributed(uk_text(ui_hero_sub), italic_sans(17.0f64), c_faint));
    line: int = label_of(uk_rich_text(uk_text(ui_hero_line), ui_hero_runs, ui_hero_runs_n,
        sans(15.0f64, 0.0f64), msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64)));
    msg1(hero, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(hero, sel("setMinimumScaleFactor:"), 0.3f64);
    msg1(tr, sel("setNumberOfLines:"), 0);
    msg1(line, sel("setNumberOfLines:"), 0);
    y: f64 = 24.0f64;
    for x in [hero, tr, line] {
        label_size(x, W - 40.0f64);
        h: f64 = hfa[1];
        msg_rect(x, sel("setFrame:"), 20.0f64, y, W - 40.0f64, h);
        msg1(v, sel("addSubview:"), x);
        y = y + h + (if (x == hero) 4.0f64 else 8.0f64)
    }
    msg_rect(v, sel("setFrame:"), 0.0f64, 0.0f64, W, y - 8.0f64 + 20.0f64);
    v
}

// The short titles of the sections of core's list t, for its index (none,
// unless it has them).
uk_index_titles(t: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || ui_index.n == 0) return 0;
    a: int = msg(make("NSMutableArray"), sel("autorelease"));
    p: int = ui_index.at;
    e: int = ui_index.at + ui_index.n;
    for x in ui_index.at..e + 1 {
        if (x == e || ui_pool[x] as int == 124) {
            msg1(a, sel("addObject:"), nsstring_at(bytes_address(ui_pool) + p, x - p));
            p = x + 1
        }
    }
    a
}

// A mark (the Library's): its reference (15 points, grown with the text
// size), the version it is quoted in faint after it; its icon (a
// highlight's dot, a note's, a bookmark's); its words (the verses' in
// the reader's face, a note's plain), softer; the words searched for
// semibold; when it was made, newest first.
uk_mark_cell(t: int, i: int): int {
    row: UiRow = ui_rows[i];
    cell: int = list_cell(t, "mark", 2);
    pt: f64 = lib_pt(15.0f64);
    config: int = list_config(2);
    if (row.suffix.n > 0) {
        keys[0] = k_font;
        values[0] = sans(pt, 0.3f64);
        keys[1] = k_color;
        values[1] = c_ink;
        title: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
        msg1(title, sel("appendAttributedString:"), attributed_str(uk_text(row.title),
            nsdictionary(keys, values, 2)));
        values[1] = c_faint;
        msg1(title, sel("appendAttributedString:"), attributed_str(uk_text(row.suffix),
            nsdictionary(keys, values, 2)));
        msg1(config, sel("setAttributedText:"), title)
    } else msg1(config, sel("setText:"), uk_text(row.title));
    msg1(text_props(config), sel("setFont:"), sans(pt, 0.3f64));
    msg1(text_props(config), sel("setColor:"), c_ink);
    soft: int = msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64);
    if (row.icon.n > 0) uk_config_image(config, uk_text(row.icon), if (row.icon_color.n > 0) 12.0f64 else pt,
        uk_icon_color(row));
    words: int = if (row.detail.n > 0) uk_text(row.detail) else nsstring("");
    if (row.scripture) {
        msg1(config, sel("setSecondaryAttributedText:"), preview(words, true, pt,
            soft));
        msg1(detail_props(config), sel("setFont:"), body(pt))
    } else {
        if (row.query_marks) msg1(config, sel("setSecondaryAttributedText:"), preview(words,
            false, pt, soft)) else msg1(config, sel("setSecondaryText:"), words);
        msg1(detail_props(config), sel("setFont:"), sans(pt, 0.0f64))
    }
    msg1(detail_props(config), sel("setNumberOfLines:"), row.lines);
    msg1(detail_props(config), sel("setColor:"), soft);
    msg_set_f(config, sel("setTextToSecondaryTextVerticalPadding:"), 3.0f64);
    if (row.query_marks && ui_search_text.n > 0) {
        q: int = uk_text(ui_search_text);
        for x in [0, 1] {
            a: int = msg(msg(config, sel(if (x == 0) "attributedText" else "secondaryAttributedText")),
                sel("mutableCopy"));
            if (a != 0) {
                bold_matches(a, q, if (x == 0 || !row.scripture) sans(pt, 0.4f64) else bold(pt));
                msg1(config, sel(if (x == 0) "setAttributedText:" else "setSecondaryAttributedText:"),
                    a);
                release(a)
            }
        }
    }
    if (row.trailing.n > 0) {
        l: int = msg(make("UILabel"), sel("autorelease"));
        msg1(l, sel("setText:"), uk_text(row.trailing));
        msg1(l, sel("setFont:"), sans(pt, 0.0f64));
        msg1(l, sel("setTextColor:"), c_faint);
        msg(l, sel("sizeToFit"));
        msg1(cell, sel("setAccessoryView:"), l)
    }
    msg1(cell, sel("setContentConfiguration:"), config);
    cell
}

// A passage to learn (Memory's): its icon, its reference (and version),
// its first words softer and its state under them, smaller and faint;
// its â“˜ to its details.
uk_passage_cell(t: int, i: int): int {
    row: UiRow = ui_rows[i];
    cell: int = list_cell(t, "memory", 2);
    config: int = list_config(2);
    uk_config_image(config, uk_text(row.icon), 17.0f64, c_accent);
    pt: f64 = lib_pt(15.0f64);
    keys[0] = k_font;
    values[0] = sans(pt, 0.3f64);
    keys[1] = k_color;
    values[1] = c_ink;
    title: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    msg1(title, sel("appendAttributedString:"), attributed_str(uk_text(row.title),
        nsdictionary(keys, values, 2)));
    if (row.suffix.n > 0) msg1(title, sel("appendAttributedString:"), attributed_str(uk_text(row.suffix),
        nsdictionary(keys, values, 2)));
    msg1(config, sel("setAttributedText:"), title);
    words: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    keys[0] = k_font;
    values[0] = body(pt);
    values[1] = msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64);
    if (row.detail.n > 0) {
        msg1(words, sel("appendAttributedString:"), attributed_str(uk_text(row.detail),
            nsdictionary(keys, values, 2)));
        msg1(words, sel("appendAttributedString:"), attributed_str(nsstring("\n"),
            nsdictionary(keys, values, 2)))
    }
    values[0] = msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleFootnote"));
    values[1] = c_faint;
    if (row.note.n > 0) msg1(words, sel("appendAttributedString:"), attributed_str(uk_text(row.note),
        nsdictionary(keys, values, 2)));
    msg1(config, sel("setSecondaryAttributedText:"), words);
    msg1(detail_props(config), sel("setNumberOfLines:"), 0);
    msg_set_f(config, sel("setTextToSecondaryTextVerticalPadding:"), 3.0f64);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryType:"), 4);
    msg1(cell, sel("setAccessibilityLabel:"), if (row.label.n > 0) uk_text(row.label) else 0);
    cell
}

// A row with a circle (a plan's day): the app's circle cell (the circle a
// button doing the row's circle action; dimmed and inert, circle_off), its
// title and line, its trailing words (Today, in the accent), and VoiceOver
// its label and the circle's action (Mark as Read, or as Unread). The
// circle's tag says its slot and row: k * 4096 + i.
uk_circle_cell(t: int, k: int, i: int): int {
    row: UiRow = ui_rows[i];
    state: int = row.circle - 1;
    cell: int = circle_cell(t, "corecircle", state, k * 4096 + i, "coreCircle:");
    msg1(cell, sel("setContentConfiguration:"), circle_config_of(state, uk_text(row.title),
        uk_text(row.detail), row.circle_off));
    b: int = msg1(msg(cell, sel("contentView")), sel("viewWithTag:"), 9100);
    if (b != 0) msg1(b, sel("setEnabled:"), if (row.circle_off) 0 else 1);
    if (row.trailing.n > 0) {
        l: int = today_label(msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
            objc_const("UIFontTextStyleBody")), if (row.trailing_tinted) c_accent else c_faint,
            1);
        msg1(l, sel("setText:"), uk_text(row.trailing));
        msg(l, sel("sizeToFit"));
        msg1(cell, sel("setAccessoryView:"), l)
    } else msg1(cell, sel("setAccessoryView:"), 0);
    circle_access(cell, uk_text(row.label), state, "coreCircleAction:");
    cell
}

// A circle tapped (its button), or its VoiceOver action: its row's circle
// action, core's.
uk_circle_act(n: int) {
    k: int = n / 4096;
    i: int = n % 4096;
    if (n < 0 || k >= UK_SLOTS || !uk_ensure(k) || i >= ui_rows_n) return;
    row: UiRow = ui_rows[i];
    uk_sync();
    sk_act(uk_ids[k], row.circle_action, row.arg, 0);
    uk_effects()
}

uk_circle(_self: int, _cmd: int, b: int): int {
    uk_circle_act(circle_tag(b));
    0
}

uk_circle_action(_self: int, _cmd: int, a: int): int {
    n: int = objc_getAssociatedObject(a, ints_address(circle_key));
    if (n != 0) uk_circle_act(msg(n, sel("longValue")));
    1
}

// A screen's words above its first section (a plan's description), W
// wide.
uk_intro_view(W: f64, text: int): int {
    v: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, W, 100.0f64), sel("autorelease"));
    a: int = uk_rich_text(text, ui_intro_runs, ui_intro_runs_n, sans(scaled(15.0f64),
        0.0f64), msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64));
    // (A quote: faint, four lines at most, an accent's bar beside it.)
    if (ui_intro_quote) msg4(a, sel("addAttribute:value:range:"), k_color, c_faint,
        0, msg(a, sel("length")));
    l: int = label_of(a);
    msg1(l, sel("setNumberOfLines:"), if (ui_intro_quote) 4 else 0);
    msg1(l, sel("setLineBreakMode:"), 4);
    msg1(l, sel("setTextAlignment:"), 4);
    x: f64 = if (ui_intro_quote) 33.0f64 else 20.0f64;
    label_size(l, W - x - 20.0f64);
    h: f64 = hfa[1];
    msg_rect(l, sel("setFrame:"), x, if (ui_intro_quote) 16.0f64 else 20.0f64, W - x - 20.0f64,
        h);
    msg1(v, sel("addSubview:"), l);
    if (ui_intro_quote) {
        bar: int = msg(make("UIView"), sel("autorelease"));
        msg1(bar, sel("setBackgroundColor:"), c_accent);
        msg_set_f(msg(bar, sel("layer")), sel("setCornerRadius:"), 1.5f64);
        msg_rect(bar, sel("setFrame:"), 20.0f64, 16.0f64, 3.0f64, h);
        msg1(v, sel("addSubview:"), bar);
        rule: int = msg(make("UIView"), sel("autorelease"));
        msg1(rule, sel("setBackgroundColor:"), c_rule);
        msg_rect(rule, sel("setFrame:"), 20.0f64, 16.0f64 + h + 16.0f64, W - 40.0f64,
            1.0f64);
        msg1(v, sel("addSubview:"), rule);
        msg_rect(v, sel("setFrame:"), 0.0f64, 0.0f64, W, 16.0f64 + h + 17.0f64);
        return v
    }
    msg_rect(v, sel("setFrame:"), 0.0f64, 0.0f64, W, 20.0f64 + h + 4.0f64);
    v
}

// The button at a screen's foot (its slot's tag), core's action.
uk_tool(_self: int, _cmd: int, item: int): int {
    n: int = msg(item, sel("tag"));
    k: int = n / 16;
    j: int = n % 16;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || j >= ui_tools_n) return 0;
    action: int = ui_tools[j].action;
    arg: int = ui_tools[j].arg;
    uk_tool_item = item;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], action, arg, 0);
    uk_effects();
    uk_tool_item = 0;
    0
}

// ---- a grid (a book's chapters) ----
// Section s's rows as square buttons of their numbers (66 points or so,
// 10 apart, as many across as fit), the chosen in the accent; a tap its
// row's action.
uk_grid_cell_of(t: int, k: int, s: int): int {
    cell: int = fresh_cell(t);
    msg1(cell, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(cell, sel("setSelectionStyle:"), 0);
    msg_rect(cell, sel("setSeparatorInset:"), 0.0f64, 10000.0f64, 0.0f64, 0.0f64);
    W: f64 = view_width(t);
    cols: int = ((W - 40.0f64 + 10.0f64) / 66.0f64) as int;
    if (cols < 1) cols = 1;
    side: f64 = ((W - 40.0f64 - (cols - 1) as f64 * 10.0f64) / cols as f64) as int as f64;
    first: int = ui_sections[s].first;
    n: int = ui_sections[s].n;
    box: int = msg(make("UIView"), sel("autorelease"));
    for x in 0..n {
        row: UiRow = ui_rows[first + x];
        chosen: bool = row.acc == ACC_CHECK;
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        fbuf_n = 0;
        fput_int(row.value);
        msg2(b, sel("setTitle:forState:"), fstring(), 0);
        msg1(msg(b, sel("titleLabel")), sel("setFont:"), sans(19.0f64, 0.23f64));
        msg2(b, sel("setTitleColor:forState:"), if (chosen) on_accent() else c_ink,
            0);
        msg1(b, sel("setBackgroundColor:"), if (chosen) c_accent else cell_bg());
        layer: int = msg(b, sel("layer"));
        msg_set_f(layer, sel("setCornerRadius:"), 14.0f64);
        curve: int = objc_const("kCACornerCurveContinuous");
        if (curve != 0) msg1(layer, sel("setCornerCurve:"), curve);
        msg_rect(b, sel("setFrame:"), 20.0f64 + (x % cols) as f64 * (side + 10.0f64),
            20.0f64 + (x / cols) as f64 * (side + 10.0f64), side, side);
        msg1(b, sel("setTag:"), k * 4096 + first + x + 1);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreGridButton:"),
            64);
        msg1(b, sel("setAccessibilityLabel:"), uk_text(row.title));
        if (chosen) msg1(b, sel("setAccessibilityTraits:"), objc_const("UIAccessibilityTraitButton") | objc_const("UIAccessibilityTraitSelected"));
        hover(b);
        msg1(box, sel("addSubview:"), b)
    }
    lines: int = (n + cols - 1) / cols;
    h: f64 = 20.0f64 + lines as f64 * side + (if (lines > 0) (lines - 1) as f64 * 10.0f64 else 0.0f64) + 32.0f64;
    content: int = msg(cell, sel("contentView"));
    msg1(box, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(content, sel("addSubview:"), box);
    pin_by(box, content, "topAnchor", 0.0f64);
    pin_by(box, content, "bottomAnchor", 0.0f64);
    pin_by(box, content, "leadingAnchor", 0.0f64);
    pin_size(box, "widthAnchor", W);
    pin_size(box, "heightAnchor", h);
    uk_tiles_w[k] = W;
    cell
}

uk_grid_button(_self: int, _cmd: int, b: int): int {
    n: int = msg(b, sel("tag")) - 1;
    k: int = n / 4096;
    i: int = n % 4096;
    if (n < 0 || k >= UK_SLOTS || !uk_ensure(k) || i >= ui_rows_n) return 0;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], ui_rows[i].action, ui_rows[i].arg, 0);
    uk_effects();
    0
}

// ---- the interlinear's tiles (UI_TILES) ----
// A row of tiles: each its lines (its English, the original, its
// transliteration, its code; what it hides drawn clear, its space kept),
// in lines as wide as the list (at most 680, centred), right to left for
// the Hebrew's order.
uk_tw: []f64 = new f64[300](0.0f64);

uk_th: []f64 = new f64[300](0.0f64);

uk_tv: []int = new int[300](0);

uk_tlines: []int = new int[4](0);

uk_tiles_cell(t: int, k: int, i: int): int {
    row: UiRow = ui_rows[i];
    cell: int = fresh_cell(t);
    msg1(cell, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(cell, sel("setSelectionStyle:"), 0);
    msg_rect(cell, sel("setSeparatorInset:"), 0.0f64, 10000.0f64, 0.0f64, 0.0f64);
    TW: f64 = view_width(t);
    W: f64 = if (TW > 680.0f64) 680.0f64 else TW;
    n: int = if (row.cells_n > len(uk_tw)) len(uk_tw) else row.cells_n;
    for c in 0..n uk_tv[c] = uk_tile_view(k, i, c, W);
    wrap_tiles(uk_tw, n, W - 28.0f64, 6.0f64);
    rtl: bool = row.value == 1;
    box: int = msg(make("UIView"), sel("autorelease"));
    y: f64 = 6.0f64;
    for l in 0..line_count {
        a: int = line_first[l];
        b: int = if (l + 1 < line_count) line_first[l + 1] else n;
        lh: f64 = 0.0f64;
        for x in a..b
            if (uk_th[x] > lh) lh = uk_th[x];
        x0: f64 = if (rtl) W - 14.0f64 else 14.0f64;
        for x in a..b {
            if (rtl) x0 = x0 - uk_tw[x];
            msg_rect(uk_tv[x], sel("setFrame:"), x0, y, uk_tw[x], uk_th[x]);
            msg1(box, sel("addSubview:"), uk_tv[x]);
            if (rtl) x0 = x0 - 6.0f64 else x0 = x0 + uk_tw[x] + 6.0f64
        }
        y = y + lh + 14.0f64
    }
    content: int = msg(cell, sel("contentView"));
    msg1(box, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(content, sel("addSubview:"), box);
    pin_by(box, content, "topAnchor", 0.0f64);
    pin_by(box, content, "bottomAnchor", 0.0f64);
    pin_to(box, "leadingAnchor", content, "leadingAnchor", (TW - W) / 2.0f64);
    pin_size(box, "widthAnchor", W);
    pin_size(box, "heightAnchor", y);
    uk_tiles_w[k] = TW;
    msg1(cell, sel("setAccessibilityElements:"), msg(box, sel("subviews")));
    cell
}

// The width each slot's tiles were laid out for: laid out again (the
// list reloaded) when its list's width changes.
uk_tiles_w: []f64 = new f64[UK_SLOTS](0.0f64);

uk_layout(self: int, cmd: int): int {
    super0(self, uk_class, cmd);
    for k in 0..UK_SLOTS {
        if (uk_vcs[k] == self && uk_vcs[k] != 0 && uk_tiles_w[k] > 0.0f64) {
            w: f64 = view_width(uk_tables[k]);
            if (w > 0.0f64 && w != uk_tiles_w[k]) {
                uk_tiles_w[k] = w;
                msg(uk_tables[k], sel("reloadData"))
            }
        }
    }
    0
}

// Cell c of row i: its tile, its size in uk_tw, uk_th.
uk_tile_view(
    k: int,
    i: int,
    c: int,
    W: f64
): int {
    cl: UiCell = ui_cells[ui_rows[i].cells + c];
    n: int = 0;
    if ((cl.flags & UI_TILE_ADDED) != 0) {
        uk_tlines[0] = label_of(attributed(uk_text(cl.sub), italic_sans(15.0f64),
            c_faint));
        n = 1
    } else {
        uk_tlines[0] = label_of(if ((cl.flags & UI_TILE_FAINT_SUB) != 0) attributed(uk_text(cl.sub),
            italic_sans(12.0f64), c_faint) else attributed(uk_text(cl.sub), sans(15.0f64,
            0.0f64), c_ink));
        uk_tlines[1] = label_of(attributed(uk_text(cl.text), original_font(cl.script != RUN_HEBREW,
            21.0f64, 25.0f64), c_ink));
        uk_tlines[2] = label_of(attributed(uk_text(cl.tr), italic_sans(12.0f64), c_faint));
        uk_tlines[3] = label_of(attributed(uk_text(cl.count), mono(11.0f64), c_faint));
        if ((cl.flags & UI_TILE_HIDE_SUB) != 0) msg_set_f(uk_tlines[0], sel("setAlpha:"),
            0.0f64);
        if ((cl.flags & UI_TILE_HIDE_TR) != 0) msg_set_f(uk_tlines[2], sel("setAlpha:"),
            0.0f64);
        n = 4
    }
    // (As wide as its widest line, never wider than a row: its lines wrap.)
    wide: f64 = 0.0f64;
    for x in 0..n {
        label_size(uk_tlines[x], 2000.0f64);
        if (hfa[0] > wide) wide = hfa[0]
    }
    most: f64 = W - 28.0f64 - 16.0f64;
    if (most > 40.0f64 && wide > most) wide = most;
    wide = (wide + 0.99f64) as int as f64;
    v: int = msg(make(if (cl.action != 0) "UIControl" else "UIView"), sel("autorelease"));
    y: f64 = 6.0f64;
    for x in 0..n {
        msg1(uk_tlines[x], sel("setNumberOfLines:"), 0);
        label_size(uk_tlines[x], wide);
        lh: f64 = hfa[1];
        msg_rect(uk_tlines[x], sel("setFrame:"), 8.0f64, y, wide, lh);
        msg1(v, sel("addSubview:"), uk_tlines[x]);
        y = y + lh + 2.0f64
    }
    msg_set_f(msg(v, sel("layer")), sel("setCornerRadius:"), 10.0f64);
    if ((cl.flags & UI_TILE_HELPED) != 0) tile_underline(v, uk_tlines[0]);
    uk_tw[c] = wide + 16.0f64;
    uk_th[c] = y + 4.0f64;
    if (cl.action != 0) {
        msg1(v, sel("setTag:"), (k * 4096 + i) * 512 + c + 1);
        msg3(v, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreTile:"),
            64);
        hover(v);
        msg1(v, sel("setIsAccessibilityElement:"), 1);
        msg1(v, sel("setAccessibilityLabel:"), uk_text(cl.label));
        msg1(v, sel("setAccessibilityTraits:"), objc_const("UIAccessibilityTraitButton"));
        hidden: bool = (cl.flags & (UI_TILE_HIDE_SUB | UI_TILE_HIDE_TR)) != 0;
        msg1(v, sel("setAccessibilityHint:"), nsstring(if (hidden) w_shows_meaning else w_shows_study));
        m: int = 0;
        for j in 0..cl.actions_n {
            if (m < len(one)) {
                a: UiAction = ui_actions[cl.actions + j];
                one[m] = msg(msg3(msg(cls("UIAccessibilityCustomAction"), sel("alloc")),
                    sel("initWithName:target:selector:"), uk_text(a.title), app_obj,
                    sel("coreTileAction:")), sel("autorelease"));
                objc_setAssociatedObject(one[m], ints_address(uk_act_key), nsnumber_int(((k * 4096 + i) * 512 + c) * 8 + j),
                    1);
                m = m + 1
            }
        }
        msg1(v, sel("setAccessibilityCustomActions:"), if (m > 0) nsarray(one, m) else 0)
    } else {
        msg1(v, sel("setIsAccessibilityElement:"), 1);
        msg1(v, sel("setAccessibilityLabel:"), uk_text(cl.sub))
    }
    v
}

uk_tile_tapped(_self: int, _cmd: int, v: int): int {
    n: int = msg(v, sel("tag")) - 1;
    if (n >= 0) uk_tile_act(n, -1);
    0
}

uk_tile_action(_self: int, _cmd: int, a: int): int {
    nn: int = objc_getAssociatedObject(a, ints_address(uk_act_key));
    if (nn == 0) return 0;
    n: int = msg(nn, sel("longValue"));
    uk_tile_act(n / 8, n % 8);
    1
}

// Tile c of row i of slot k ((k * 4096 + i) * 512 + c): its tap (j -1),
// or its action j.
uk_tile_act(n: int, j: int) {
    k: int = n / 512 / 4096;
    i: int = n / 512 % 4096;
    c: int = n % 512;
    if (k >= UK_SLOTS || !uk_ensure(k) || i >= ui_rows_n || c >= ui_rows[i].cells_n) return;
    cl: UiCell = ui_cells[ui_rows[i].cells + c];
    action: int = if (j >= 0 && j < cl.actions_n) ui_actions[cl.actions + j].action else cl.action;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], action, cl.arg, 0);
    uk_effects()
}

// Segments at a screen's foot chosen (the interlinear's order): the
// tool's action, its item's argument the value.
uk_tool_segment(_self: int, _cmd: int, seg: int): int {
    n: int = msg(seg, sel("tag"));
    k: int = n / 16;
    j: int = n % 16;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || j >= ui_tools_n) return 0;
    if (!uk_menu_item(ui_tools[j].menu, msg(seg, sel("selectedSegmentIndex")))) return 0;
    action: int = ui_tools[j].action;
    arg: int = ui_tools[j].arg;
    v: int = uk_mi_arg;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], action, arg, v);
    uk_effects();
    0
}

// Slot k's segments as the bar's title (the Study sheet's): made once, then
// their choice kept as core says.
uk_title_segments(k: int, item: int) {
    seg: int = msg(item, sel("titleView"));
    if (seg == 0 || !responds(seg, "setSelectedSegmentIndex:")) {
        n: int = 0;
        while (n < len(one) && uk_menu_title(ui_segments, n)) {
            one[n] = nsstring_at(bytes_address(ui_pool) + uk_mi_b, uk_mi_e - uk_mi_b);
            n = n + 1
        }
        seg = msg(msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
            nsarray(one, n)), sel("autorelease"));
        msg3(seg, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreSegment:"),
            4096);
        msg_rect(seg, sel("setFrame:"), 0.0f64, 0.0f64, 300.0f64, 32.0f64);
        msg1(item, sel("setTitleView:"), seg)
    }
    msg1(seg, sel("setTag:"), k);
    msg1(seg, sel("setSelectedSegmentIndex:"), ui_segment)
}

// Title idx of words split by | (its place in uk_mi_b, uk_mi_e), or false.
uk_menu_title(t: UiText, idx: int): bool {
    x: int = t.at;
    end: int = t.at + t.n;
    if (t.n == 0) return false;
    for _j in 0..idx {
        while (x < end && ui_pool[x] as int != 124) x = x + 1;
        if (x >= end) return false;
        x = x + 1
    }
    uk_mi_b = x;
    while (x < end && ui_pool[x] as int != 124) x = x + 1;
    uk_mi_e = x;
    true
}

// The slots of the panel's screens (those in nav) let go, and core's.
uk_panel_gone(nav: int) {
    for k in 0..UK_SLOTS {
        if (uk_vcs[k] != 0 && msg(uk_vcs[k], sel("navigationController")) == nav && nav != 0) uk_free(k)
    }
    sk_close_group(1);
    uk_stale = true
}

// The panel's screen made (core's panel effect), its slot.
uk_panel_slot: int = -1;

// ---- a page's paragraphs (UI_TEXT) ----
// A paragraph: its words selectable in a text view of its own (not
// scrolling), set by its runs (a heading in the Headline face; a symbol
// drawn at the text's size), its links tappable; a heading 20 points under
// what is before it, a paragraph 0.6 em before the next.
k_page_link: str = "L8PageLink";

uk_text_cell(t: int, k: int, i: int): int {
    row: UiRow = ui_rows[i];
    cell: int = fresh_cell(t);
    msg1(cell, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(cell, sel("setSelectionStyle:"), 0);
    // (No line under it: a page.)
    msg_rect(cell, sel("setSeparatorInset:"), 0.0f64, 10000.0f64, 0.0f64, 0.0f64);
    tv: int = msg(make("UITextView"), sel("autorelease"));
    msg1(tv, sel("setEditable:"), 0);
    msg1(tv, sel("setSelectable:"), 1);
    msg1(tv, sel("setScrollEnabled:"), 0);
    msg1(tv, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(tv, sel("setTintColor:"), c_accent);
    msg_rect(tv, sel("setTextContainerInset:"), 0.0f64, 0.0f64, 0.0f64, 0.0f64);
    msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
    msg1(tv, sel("setAttributedText:"), uk_page_text(i));
    msg1(tv, sel("setTag:"), k * 4096 + i);
    msg1(tv, sel("setIsAccessibilityElement:"), 0);
    if (row.links_n > 0) {
        tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
            app_obj, sel("corePageTapped:"));
        msg1(tap, sel("setDelegate:"), app_obj);
        msg1(tv, sel("addGestureRecognizer:"), tap);
        release(tap)
    }
    msg1(tv, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    content: int = msg(cell, sel("contentView"));
    msg1(content, sel("addSubview:"), tv);
    first: bool = false;
    for s in 0..ui_sections_n
        if (i == ui_sections[s].first) first = true;
    size: f64 = msg_f(msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleBody")),
        sel("pointSize"));
    pin_by(tv, content, "leadingAnchor", 20.0f64);
    pin_by(tv, content, "trailingAnchor", -20.0f64);
    pin_by(tv, content, "topAnchor", if (row.heading && !first) 20.0f64 else if (first) 16.0f64 else 0.0f64);
    pin_by(tv, content, "bottomAnchor", if (row.heading) -6.0f64 else -(size * 0.6f64));
    // (VoiceOver: the paragraph, each symbol by name; a heading as one;
    // its links as actions.)
    msg1(cell, sel("setIsAccessibilityElement:"), 1);
    msg1(cell, sel("setAccessibilityLabel:"), uk_text(if (row.label.n > 0) row.label else row.title));
    msg1(cell, sel("setAccessibilityTraits:"), if (row.heading) objc_const("UIAccessibilityTraitHeader") | objc_const("UIAccessibilityTraitStaticText") else objc_const("UIAccessibilityTraitStaticText"));
    n: int = 0;
    for j in 0..row.links_n {
        if (n < len(one)) {
            lk: UiLink = ui_links[row.links + j];
            fbuf_n = 0;
            fput_str(w_open);
            ns: int = msg2(uk_text(row.title), sel("substringWithRange:"), lk.b, lk.e - lk.b);
            m: int = nsstring_into(ns, uk_query_buf);
            fput_bytes(uk_query_buf, 0, m);
            a: int = msg(msg3(msg(cls("UIAccessibilityCustomAction"), sel("alloc")),
                sel("initWithName:target:selector:"), fstring(), app_obj, sel("corePageLinkAction:")),
                sel("autorelease"));
            objc_setAssociatedObject(a, ints_address(uk_act_key), nsnumber_int((k * 4096 + i) * 64 + j),
                1);
            one[n] = a;
            n = n + 1
        }
    }
    msg1(cell, sel("setAccessibilityCustomActions:"), if (n > 0) nsarray(one, n) else 0);
    cell
}

// Row i's words as a page sets them: its runs, each symbol an image, each
// link marked (its index plus one, k_page_link).
uk_page_text(i: int): int {
    row: UiRow = ui_rows[i];
    // (The commentary's in the reader's face, a little smaller.)
    font: int = if (row.scripture) body(em * 0.95f64) else msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const(if (row.heading) "UIFontTextStyleHeadline" else "UIFontTextStyleBody"));
    text: int = uk_text(row.title);
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    if (text == 0) return s;
    from: int = 0;
    total: int = msg(text, sel("length"));
    for x in 0..row.truns_n + 1 {
        e: int = if (x < row.truns_n) ui_runs[row.truns + x * 2] else total;
        st: int = if (x < row.truns_n) ui_runs[row.truns + x * 2 + 1] else RUN_PLAIN;
        if (e > from) {
            part: int = msg2(text, sel("substringWithRange:"), from, e - from);
            at: int = msg(s, sel("length"));
            if (st == RUN_SYMBOL || st == RUN_SYMBOL_BOLD) msg1(s, sel("appendAttributedString:"),
                uk_symbol_text(part, font, if (st == RUN_SYMBOL_BOLD) 6 else 4)) else msg1(s,
                sel("appendAttributedString:"), uk_rich_text(part, 0, 0, font, c_ink));
            if (st != RUN_SYMBOL && st != RUN_SYMBOL_BOLD) {
                uk_run_look(st, font, row.scripture);
                msg4(s, sel("addAttribute:value:range:"), k_font, uk_rl_font, at,
                    e - from);
                msg4(s, sel("addAttribute:value:range:"), k_color, uk_rl_color, at,
                    e - from)
            }
            // (Its links, in these words.)
            for j in 0..row.links_n {
                lk: UiLink = ui_links[row.links + j];
                if (lk.b >= from && lk.e <= e && lk.e > lk.b && st != RUN_SYMBOL && st != RUN_SYMBOL_BOLD) msg4(s,
                    sel("addAttribute:value:range:"), nsstring(k_page_link), nsnumber_int(j + 1),
                    at + lk.b - from, lk.e - lk.b)
            }
        }
        if (e > from) from = e
    }
    // (Its indent and hang, tenths of an em: a definition's sense, its
    // outline's levels.)
    if (row.value > 0 || row.lo > 0) {
        size: f64 = msg_f(font, sel("pointSize"));
        first: f64 = row.value as f64 * size / 10.0f64;
        p: int = msg(para_style(0, first, first + row.lo as f64 * size / 10.0f64,
            0.0f64, 0.0f64, 1.3f64), sel("autorelease"));
        msg4(s, sel("addAttribute:value:range:"), k_para, p, 0, msg(s, sel("length")))
    }
    s
}

// A run's face and color (core/ui.l8's RUN_, from the paragraph's face).
uk_rl_font: int = 0;

uk_rl_color: int = 0;

uk_run_look(st: int, font: int, reading: bool) {
    size: f64 = msg_f(font, sel("pointSize"));
    uk_rl_font = font;
    uk_rl_color = c_ink;
    if (st == RUN_STRONG) uk_rl_font = sans(size, 0.4f64) else if (st == RUN_ITALIC) uk_rl_font = (if (reading) italic(size) else italic_sans(size)) else if (st == RUN_SMALL) uk_rl_font = sans(13.0f64,
        0.3f64);
    if (st == RUN_ACCENT) uk_rl_color = c_accent else if (st == RUN_FAINT || st == RUN_SMALL) uk_rl_color = c_faint
}

// A symbol (its name an NSString) as an attachment: at the text's size and
// weight, in ink, centred on the capitals' height.
uk_symbol_text(name: int, font: int, weight: int): int {
    size: f64 = msg_f(font, sel("pointSize"));
    config: int = msg_f1(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
        size, weight);
    image: int = msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
        name, config);
    m: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    if (image == 0) return m;
    image = msg2(image, sel("imageWithTintColor:renderingMode:"), c_ink, 1);
    att: int = msg1(cls("NSTextAttachment"), sel("textAttachmentWithImage:"), image);
    l8_msg_hfa(hfa, image, sel("size"), 0, 0, 0);
    w: f64 = hfa[0];
    h: f64 = hfa[1];
    cap: f64 = msg_f(font, sel("capHeight"));
    msg_rect(att, sel("setBounds:"), 0.0f64, (cap - h) / 2.0f64, w, h);
    msg1(m, sel("appendAttributedString:"), msg1(cls("NSAttributedString"), sel("attributedStringWithAttachment:"),
        att));
    msg4(m, sel("addAttribute:value:range:"), k_font, font, 0, msg(m, sel("length")));
    m
}

// A link tapped in a paragraph: its action.
uk_page_tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    j: int = link_at(tv, hfa[0], hfa[1], k_page_link) - 1;
    if (j >= 0) uk_page_link(msg(tv, sel("tag")) * 64 + j);
    0
}

uk_page_link_action(_self: int, _cmd: int, a: int): int {
    nn: int = objc_getAssociatedObject(a, ints_address(uk_act_key));
    if (nn != 0) uk_page_link(msg(nn, sel("longValue")));
    1
}

// Link j of row i of slot k ((k * 4096 + i) * 64 + j) followed.
uk_page_link(n: int) {
    k: int = n / 64 / 4096;
    i: int = n / 64 % 4096;
    j: int = n % 64;
    if (k >= UK_SLOTS || !uk_ensure(k) || i >= ui_rows_n || j >= ui_rows[i].links_n) return;
    lk: UiLink = ui_links[ui_rows[i].links + j];
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], lk.action, lk.arg, 0);
    uk_effects()
}

// Slot k's focus row washed in the selection's color, fading over a second
// (in the demo, six); not under Reduce Motion.
uk_wash(k: int) {
    if (reduce_motion() || !uk_ensure(k) || ui_focus < 0) return;
    t: int = uk_tables[k];
    for s in 0..ui_sections_n {
        first: int = ui_sections[s].first;
        if (ui_focus >= first && ui_focus < first + ui_sections[s].n) {
            msg(t, sel("layoutIfNeeded"));
            cell: int = msg1(t, sel("cellForRowAtIndexPath:"), msg2(cls("NSIndexPath"),
                sel("indexPathForRow:inSection:"), ui_focus - first, s));
            if (cell == 0) return;
            v: int = msg(make("UIView"), sel("autorelease"));
            l8_msg_hfa(hfa, cell, sel("bounds"), 0, 0, 0);
            msg_rect(v, sel("setFrame:"), 12.0f64, 8.0f64, hfa[2] - 24.0f64, hfa[3] - 8.0f64);
            msg1(v, sel("setBackgroundColor:"), c_sel);
            msg1(v, sel("setUserInteractionEnabled:"), 0);
            msg_set_f(msg(v, sel("layer")), sel("setCornerRadius:"), 6.0f64);
            msg2(msg(cell, sel("contentView")), sel("insertSubview:atIndex:"), v,
                0);
            layer: int = msg(v, sel("layer"));
            msg_set_f32(layer, sel("setOpacity:"), 0.0f64 as f32);
            animate(layer, "opacity", 1.0f64, 0.0f64, false, if (demo_on) 6.0f64 else 1.0f64);
            return
        }
    }
}

// ---- a letter's row, a grid's row, a row's menu ----
// A letter's row (the Alphabet's): its glyph in a 56-point column, its
// name over its sound, its example (its letter in the accent) over its
// gloss; at the accessibility sizes the example under the name.
uk_letter_cell(t: int, i: int): int {
    row: UiRow = ui_rows[i];
    greek: bool = row.lead_style != RUN_HEBREW;
    cell: int = fresh_cell(t);
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    big: bool = ax_size();
    line: int = stack(if (big) 1 else 0, if (big) 6.0f64 else 12.0f64);
    msg1(line, sel("setAlignment:"), if (big) 1 else 3);
    msg1(line, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    glyph: int = msg(make("UILabel"), sel("autorelease"));
    msg1(glyph, sel("setAttributedText:"), attributed(uk_text(row.lead), original_font(greek,
        34.0f64, 40.0f64), c_ink));
    msg1(glyph, sel("setTextAlignment:"), 1);
    msg1(glyph, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(glyph, sel("setMinimumScaleFactor:"), 0.5f64);
    if (!big) pin_size(glyph, "widthAnchor", 56.0f64);
    msg1(line, sel("addArrangedSubview:"), glyph);
    names: int = stack(1, 2.0f64);
    name: int = msg(make("UILabel"), sel("autorelease"));
    msg1(name, sel("setAttributedText:"), attributed(uk_text(row.title), sans(scaled(17.0f64),
        0.0f64), c_ink));
    msg1(name, sel("setNumberOfLines:"), 0);
    msg1(names, sel("addArrangedSubview:"), name);
    sound: int = msg(make("UILabel"), sel("autorelease"));
    msg1(sound, sel("setAttributedText:"), attributed(uk_text(row.detail), sans(scaled(15.0f64),
        0.0f64), c_faint));
    msg1(sound, sel("setNumberOfLines:"), 0);
    msg1(names, sel("addArrangedSubview:"), sound);
    msg1(line, sel("addArrangedSubview:"), names);
    if (row.side.n > 0) {
        ex: int = stack(1, 2.0f64);
        msg1(ex, sel("setAlignment:"), if (big) 1 else 4);
        word: int = msg(make("UILabel"), sel("autorelease"));
        s: int = uk_rich_text(uk_text(row.side), row.sruns, row.sruns_n, original_font(greek,
            17.0f64, 19.0f64), c_ink);
        msg4(s, sel("addAttribute:value:range:"), k_para, orig_para(if (greek) 0 else 1,
            if (big) 0 else 2, 1.0f64), 0, msg(s, sel("length")));
        msg1(word, sel("setAttributedText:"), s);
        msg1(ex, sel("addArrangedSubview:"), word);
        gloss: int = msg(make("UILabel"), sel("autorelease"));
        msg1(gloss, sel("setAttributedText:"), attributed(uk_text(row.side_note),
            sans(scaled(13.0f64), 0.0f64), c_faint));
        msg1(gloss, sel("setNumberOfLines:"), 0);
        msg1(gloss, sel("setTextAlignment:"), if (big) 0 else 2);
        msg1(ex, sel("addArrangedSubview:"), gloss);
        msg1(line, sel("addArrangedSubview:"), ex)
    }
    content: int = msg(cell, sel("contentView"));
    msg1(content, sel("addSubview:"), line);
    guide: int = msg(content, sel("layoutMarginsGuide"));
    pin_to(line, "topAnchor", guide, "topAnchor", 2.0f64);
    pin_to(line, "bottomAnchor", guide, "bottomAnchor", -2.0f64);
    pin_to(line, "leadingAnchor", guide, "leadingAnchor", 0.0f64);
    pin_to(line, "trailingAnchor", guide, "trailingAnchor", 0.0f64);
    if (row.acc == ACC_DONE) {
        iv: int = msg(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
            symbol("checkmark", 15.0f64, 4, c_faint)), sel("autorelease"));
        msg1(cell, sel("setAccessoryView:"), iv)
    }
    msg1(cell, sel("setSelectionStyle:"), if (row.action == 0) 0 else 3);
    msg1(cell, sel("setIsAccessibilityElement:"), 1);
    msg1(cell, sel("setAccessibilityLabel:"), if (row.label.n > 0) uk_text(row.label) else uk_text(row.title));
    cell
}

// A grid's column c (of n) in a list of width W: its x and width, within
// the inset group's row (16 points in from each side), after a label
// column of 36%.
uk_cx: f64 = 0.0f64;

uk_cw: f64 = 0.0f64;

uk_column(W: f64, n: int, c: int) {
    // (As the cells lie: the row 16 points in, its margins 20, the label
    // column, 16 points, then the cells to the trailing margin.)
    inner: f64 = W - 32.0f64;
    x0: f64 = 16.0f64 + 20.0f64 + inner * 0.36f64;
    uk_cw = (W - 36.0f64 - x0) / n as f64;
    uk_cx = x0 + c as f64 * uk_cw
}

// Section s's column names (Singular|Plural): name c into fbuf.
uk_column_name(s: int, c: int) {
    fbuf_n = 0;
    t: UiText = ui_sections[s].columns;
    k: int = 0;
    for x in t.at..t.at + t.n {
        if (ui_pool[x] as int == 124) k = k + 1 else if (k == c) fput(ui_pool[x] as int)
    }
}

// A grid's section header: its title, and over its columns their names,
// once (not at the accessibility sizes, where each cell is labelled).
uk_columns_header(t: int, s: int): int {
    W: f64 = view_width(t);
    v: int = msg(make("UIView"), sel("autorelease"));
    title: int = msg(make("UILabel"), sel("autorelease"));
    msg1(title, sel("setText:"), uk_text(ui_sections[s].header));
    // (The headline's size, to 26 points: at the largest sizes the table
    // gives a header two lines, and "Present Active Indicative" fits them.)
    hs: f64 = scaled(17.0f64);
    msg1(title, sel("setFont:"), sans(if (hs > 26.0f64) 26.0f64 else hs, 0.4f64));
    msg1(title, sel("setTextColor:"), c_ink);
    msg1(title, sel("setNumberOfLines:"), 0);
    msg_set_f(title, sel("setPreferredMaxLayoutWidth:"), W - 40.0f64);
    msg1(title, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), title);
    pin_to(title, "topAnchor", v, "topAnchor", 16.0f64);
    pin_to(title, "leadingAnchor", v, "leadingAnchor", 20.0f64);
    pin_to(title, "trailingAnchor", v, "trailingAnchor", -20.0f64);
    last: int = title;
    n: int = 1;
    t2: UiText = ui_sections[s].columns;
    for x in t2.at..t2.at + t2.n
        if (ui_pool[x] as int == 124) n = n + 1;
    if (!ax_size()) {
        for c in 0..n {
            uk_column(W, n, c);
            l: int = msg(make("UILabel"), sel("autorelease"));
            uk_column_name(s, c);
            msg1(l, sel("setText:"), fstring());
            msg1(l, sel("setFont:"), sans(13.0f64, 0.0f64));
            msg1(l, sel("setTextColor:"), c_faint);
            msg1(l, sel("setTextAlignment:"), 1);
            msg1(l, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
            msg1(v, sel("addSubview:"), l);
            pin_to(l, "topAnchor", title, "bottomAnchor", 4.0f64);
            pin_to(l, "leadingAnchor", v, "leadingAnchor", uk_cx);
            pin_size(l, "widthAnchor", uk_cw);
            last = l
        }
    }
    pin_to(last, "bottomAnchor", v, "bottomAnchor", -6.0f64);
    // (Its height given, its title's wrapped lines and all: the table
    // measured it as one line at the largest sizes.)
    label_size(title, W - 40.0f64);
    h: f64 = 16.0f64 + hfa[1] + 6.0f64 + (if (last != title) 4.0f64 + 18.0f64 else 0.0f64);
    pin_size(v, "heightAnchor", h);
    v
}

// A grid's row: its title in a fixed leading column, then its cells; at
// the accessibility sizes stacked, each labelled with its column's name.
uk_grid_cell(t: int, k: int, i: int): int {
    row: UiRow = ui_rows[i];
    cell: int = fresh_cell(t);
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    msg1(cell, sel("setSelectionStyle:"), 0);
    content: int = msg(cell, sel("contentView"));
    big: bool = ax_size();
    W: f64 = view_width(t);
    label: int = msg(make("UILabel"), sel("autorelease"));
    msg1(label, sel("setText:"), uk_text(row.title));
    msg1(label, sel("setFont:"), sans(scaled(15.0f64), 0.0f64));
    msg1(label, sel("setTextColor:"), c_faint);
    msg1(label, sel("setNumberOfLines:"), 0);
    msg1(label, sel("setIsAccessibilityElement:"), 0);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(content, sel("addSubview:"), label);
    guide: int = msg(content, sel("layoutMarginsGuide"));
    pin_to(label, "leadingAnchor", guide, "leadingAnchor", 0.0f64);
    pin_to(label, "topAnchor", guide, "topAnchor", 4.0f64);
    cells: int = stack(if (big) 1 else 0, if (big) 8.0f64 else 16.0f64);
    msg1(cells, sel("setDistribution:"), 1);
    msg1(cells, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    s: int = -1;
    for x in 0..ui_sections_n
        if (i >= ui_sections[x].first && i < ui_sections[x].first + ui_sections[x].n) s = x;
    for c in 0..row.cells_n {
        fbuf_n = 0;
        if (big && s >= 0 && row.cells_n > 1) uk_column_name(s, c);
        name: int = if (fbuf_n > 0) fstring() else 0;
        msg1(cells, sel("addArrangedSubview:"), uk_grid_cell_view(k, i, c, name))
    }
    msg1(content, sel("addSubview:"), cells);
    if (big) {
        pin_to(cells, "topAnchor", label, "bottomAnchor", 6.0f64);
        pin_to(cells, "leadingAnchor", guide, "leadingAnchor", 0.0f64)
    } else {
        inner: f64 = W - 32.0f64;
        pin_size(label, "widthAnchor", inner * 0.36f64 - 16.0f64);
        pin_to(cells, "topAnchor", guide, "topAnchor", 0.0f64);
        pin_to(cells, "leadingAnchor", label, "trailingAnchor", 16.0f64)
    }
    pin_to(cells, "trailingAnchor", guide, "trailingAnchor", 0.0f64);
    pin_to(cells, "bottomAnchor", guide, "bottomAnchor", 0.0f64);
    msg1(cell, sel("setAccessibilityElements:"), msg(cells, sel("arrangedSubviews")));
    cell
}

// A grid's cell: a control of its words (a form) over what it does (in
// italic) and its count, smaller, doing its action; or its words faint,
// doing nothing. Tagged (k * 4096 + i) * 8 + c, and 1.
uk_grid_cell_view(
    k: int,
    i: int,
    c: int,
    name: int
): int {
    cl: UiCell = ui_cells[ui_rows[i].cells + c];
    v: int = msg(make("UIControl"), sel("autorelease"));
    col: int = stack(1, 1.0f64);
    msg1(col, sel("setAlignment:"), 3);
    msg1(col, sel("setUserInteractionEnabled:"), 0);
    msg1(col, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    if (name != 0) {
        h: int = msg(make("UILabel"), sel("autorelease"));
        msg1(h, sel("setText:"), name);
        msg1(h, sel("setFont:"), sans(scaled(13.0f64), 0.0f64));
        msg1(h, sel("setTextColor:"), c_faint);
        msg1(col, sel("addArrangedSubview:"), h)
    }
    f: int = msg(make("UILabel"), sel("autorelease"));
    msg1(f, sel("setTextAlignment:"), 1);
    msg1(f, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(f, sel("setMinimumScaleFactor:"), 0.6f64);
    if (cl.script != 0) msg1(f, sel("setAttributedText:"), attributed(uk_text(cl.text),
        original_font(cl.script != RUN_HEBREW, 17.0f64, 19.0f64), c_ink)) else {
        msg1(f, sel("setText:"), uk_text(cl.text));
        msg1(f, sel("setFont:"), sans(scaled(17.0f64), 0.0f64));
        msg1(f, sel("setTextColor:"), c_faint)
    }
    msg1(col, sel("addArrangedSubview:"), f);
    if (cl.sub.n > 0) {
        e: int = msg(make("UILabel"), sel("autorelease"));
        msg1(e, sel("setAttributedText:"), attributed(uk_text(cl.sub), italic_sans(scaled(14.0f64)),
            msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64)));
        msg1(e, sel("setTextAlignment:"), 1);
        msg1(e, sel("setNumberOfLines:"), 2);
        msg1(col, sel("addArrangedSubview:"), e)
    }
    if (cl.count.n > 0) {
        n: int = msg(make("UILabel"), sel("autorelease"));
        msg1(n, sel("setText:"), uk_text(cl.count));
        msg1(n, sel("setFont:"), sans(scaled(11.0f64), 0.0f64));
        msg1(n, sel("setTextColor:"), c_faint);
        msg1(col, sel("addArrangedSubview:"), n)
    }
    msg1(v, sel("setIsAccessibilityElement:"), 1);
    msg1(v, sel("setAccessibilityLabel:"), uk_text(cl.label));
    if (cl.action != 0) {
        msg1(v, sel("setTag:"), (k * 4096 + i) * 8 + c + 1);
        msg3(v, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreGridCell:"),
            64);
        hover(v);
        msg1(v, sel("setAccessibilityTraits:"), objc_const("UIAccessibilityTraitButton"))
    }
    msg1(v, sel("addSubview:"), col);
    pin_to(col, "topAnchor", v, "topAnchor", 6.0f64);
    pin_to(col, "bottomAnchor", v, "bottomAnchor", -6.0f64);
    pin_to(col, "leadingAnchor", v, "leadingAnchor", 0.0f64);
    pin_to(col, "trailingAnchor", v, "trailingAnchor", 0.0f64);
    v
}

uk_grid_tapped(_self: int, _cmd: int, v: int): int {
    n: int = msg(v, sel("tag")) - 1;
    if (n < 0) return 0;
    k: int = n / 8 / 4096;
    i: int = n / 8 % 4096;
    c: int = n % 8;
    if (k >= UK_SLOTS || !uk_ensure(k) || i >= ui_rows_n || c >= ui_rows[i].cells_n) return 0;
    cl: UiCell = ui_cells[ui_rows[i].cells + c];
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], cl.action, cl.arg, 0);
    uk_effects();
    0
}

// A row's actions as a menu at its end: an ellipsis.circle button (each
// action a command, saying its slot, row and index as VoiceOver's do; its
// Delete destructive), after its trailing words if it has them.
uk_menu_view(k: int, i: int): int {
    row: UiRow = ui_rows[i];
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    msg2(b, sel("setImage:forState:"), symbol("ellipsis.circle", 20.0f64, 4, c_accent),
        0);
    for j in 0..row.actions_n {
        if (j < len(one)) {
            a: UiAction = ui_actions[row.actions + j];
            image: int = if (a.icon.n == 0) 0 else msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
                uk_text(a.icon), msg_f1(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
                17.0f64, 4));
            one[j] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
                uk_text(a.title), image, sel("coreRowMenu:"), nsnumber_int((k * 4096 + i) * 8 + j));
            if (a.action == row.delete_action) msg1(one[j], sel("setAttributes:"),
                2)
        }
    }
    msg1(b, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""),
        nsarray(one, if (row.actions_n > len(one)) len(one) else row.actions_n)));
    msg1(b, sel("setShowsMenuAsPrimaryAction:"), 1);
    msg1(b, sel("setAccessibilityLabel:"), nsstring(w_more));
    msg_rect(b, sel("setFrame:"), 0.0f64, 0.0f64, 32.0f64, 32.0f64);
    if (row.trailing.n == 0) return b;
    // (Its count, then the menu.)
    box: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 100.0f64, 32.0f64), sel("autorelease"));
    count: int = today_label(msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleBody")), c_faint, 1);
    msg1(count, sel("setText:"), uk_text(row.trailing));
    msg(count, sel("sizeToFit"));
    cw: f64 = view_width(count);
    ch: f64 = view_height(count);
    msg_rect(box, sel("setFrame:"), 0.0f64, 0.0f64, cw + 8.0f64 + 32.0f64, if (ch > 32.0f64) ch else 32.0f64);
    msg_rect(count, sel("setFrame:"), 0.0f64, (view_height(box) - ch) / 2.0f64, cw,
        ch);
    msg_rect(b, sel("setFrame:"), cw + 8.0f64, (view_height(box) - 32.0f64) / 2.0f64,
        32.0f64, 32.0f64);
    msg1(box, sel("addSubview:"), count);
    msg1(box, sel("addSubview:"), b);
    box
}

uk_row_menu(_self: int, _cmd: int, command: int): int {
    if (command == 0 || !responds(command, "propertyList")) return 0;
    nn: int = msg(command, sel("propertyList"));
    if (nn == 0) return 0;
    uk_row_act(msg(nn, sel("longValue")))
}

// A tool's menu item (ARG:TITLE, the idx'th of its |-split list): its
// argument and title's place in the pool, or false.
uk_mi_arg: int = 0;

uk_mi_b: int = 0;

uk_mi_e: int = 0;

uk_menu_item(t: UiText, idx: int): bool {
    x: int = t.at;
    end: int = t.at + t.n;
    for _j in 0..idx {
        while (x < end && ui_pool[x] as int != 124) x = x + 1;
        if (x >= end) return false;
        x = x + 1
    }
    if (x >= end) return false;
    neg: bool = ui_pool[x] as int == 45;
    if (neg) x = x + 1;
    n: int = 0;
    while (x < end && ui_pool[x] as int >= 48 && ui_pool[x] as int <= 57) {
        n = n * 10 + ui_pool[x] as int - 48;
        x = x + 1
    }
    uk_mi_arg = (if (neg) -n else n);
    if (x < end && ui_pool[x] as int == 58) x = x + 1;
    uk_mi_b = x;
    while (x < end && ui_pool[x] as int != 124) x = x + 1;
    uk_mi_e = x;
    true
}

// A tool's menu, its items commands (each saying its slot, tool and
// index: (k * 16 + j) * 64 + idx).
uk_tool_menu(k: int, j: int): int {
    kids: int = msg(cls("NSMutableArray"), sel("array"));
    idx: int = 0;
    while (idx < 64 && uk_menu_item(ui_tools[j].menu, idx)) {
        msg1(kids, sel("addObject:"), msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
            nsstring_at(bytes_address(ui_pool) + uk_mi_b, uk_mi_e - uk_mi_b), 0, sel("coreToolMenu:"),
            nsnumber_int((k * 16 + j) * 64 + idx)));
        idx = idx + 1
    }
    msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""), kids)
}

uk_tool_menu_chosen(_self: int, _cmd: int, command: int): int {
    if (command == 0 || !responds(command, "propertyList")) return 0;
    nn: int = msg(command, sel("propertyList"));
    if (nn == 0) return 0;
    n: int = msg(nn, sel("longValue"));
    k: int = n / 64 / 16;
    j: int = n / 64 % 16;
    if (k >= UK_SLOTS || !uk_ensure(k) || j >= ui_tools_n || !uk_menu_item(ui_tools[j].menu,
        n % 64)) return 0;
    action: int = ui_tools[j].action;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], action, uk_mi_arg, 0);
    uk_effects();
    0
}

// Core's screen of kind acted on, as one of its buttons does (the demos').
uk_act_kind(kind: int, action: int, arg: int) {
    uk_act_value(kind, action, arg, 0)
}

uk_act_value(
    kind: int,
    action: int,
    arg: int,
    value: int
) {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0) return;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], action, arg, value);
    uk_effects()
}

// The argument of the first row (or link) of core's screen of kind doing
// action, or 0 (the demos').
uk_first_arg(kind: int, action: int): int {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0 || !uk_ensure(k)) return 0;
    for i in 0..ui_rows_n {
        if (ui_rows[i].action == action) return ui_rows[i].arg;
        for l in 0..ui_rows[i].links_n
            if (ui_links[ui_rows[i].links + l].action == action) return ui_links[ui_rows[i].links + l].arg
    }
    0
}

// Every list of core's shown laid out again (the text's size changed).
uk_restyle() {
    for k in 0..UK_SLOTS {
        if (uk_ids[k] != 0 && uk_tables[k] != 0) {
            uk_stale = true;
            msg(uk_tables[k], sel("reloadData"))
        }
    }
}

// The button at the left of slot k's bar (a note's Cancel, Delete Note):
// the system's Trash for a trash symbol, in red if destructive.
uk_left_item(k: int, item: int) {
    b: int = 0;
    if (ui_left_icon.n > 0) {
        b = system_item(16, "coreLeft:");
        msg1(b, sel("setAccessibilityLabel:"), uk_text(ui_left))
    } else b = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithTitle:style:target:action:"),
        uk_text(ui_left), 0, app_obj, sel("coreLeft:")), sel("autorelease"));
    if (ui_left_style == UI_TOOL_DESTRUCTIVE) msg1(b, sel("setTintColor:"), msg(cls("UIColor"),
        sel("systemRedColor")));
    msg1(b, sel("setTag:"), k);
    msg1(item, sel("setLeftBarButtonItem:"), b)
}

uk_left_tapped(_self: int, _cmd: int, b: int): int {
    k: int = msg(b, sel("tag"));
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return 0;
    action: int = ui_left_action;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], action, 0, 0);
    uk_effects();
    0
}

// A field of many lines (a note's): its words in a text view that grows
// with them, a placeholder over it while it is empty; its words to core as
// its editing ends.
uk_prose_cell(t: int, k: int, i: int): int {
    row: UiRow = ui_rows[i];
    if (uk_fcells[k] == 0) {
        cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
            0, 0), sel("autorelease"));
        msg1(cell, sel("setSelectionStyle:"), 0);
        msg1(cell, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
        msg_rect(cell, sel("setSeparatorInset:"), 0.0f64, 10000.0f64, 0.0f64, 0.0f64);
        tv: int = msg(make("UITextView"), sel("autorelease"));
        msg1(tv, sel("setScrollEnabled:"), 0);
        msg1(tv, sel("setFont:"), body(em));
        msg1(tv, sel("setTextColor:"), c_ink);
        msg1(tv, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
        msg1(tv, sel("setTintColor:"), c_accent);
        msg_rect(tv, sel("setTextContainerInset:"), 12.0f64, 20.0f64, 20.0f64, 20.0f64);
        msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
        msg1(tv, sel("setDelegate:"), app_obj);
        msg1(tv, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        content: int = msg(cell, sel("contentView"));
        msg1(content, sel("addSubview:"), tv);
        for edge in ["leadingAnchor", "trailingAnchor", "topAnchor", "bottomAnchor"] pin(tv,
            content, edge);
        pin_min_height(tv, 200.0f64);
        ph: int = msg(make("UILabel"), sel("autorelease"));
        msg1(ph, sel("setFont:"), body(em));
        msg1(ph, sel("setTextColor:"), c_faint);
        msg1(ph, sel("setTag:"), 9400);
        msg1(ph, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(tv, sel("addSubview:"), ph);
        pin_to(ph, "topAnchor", tv, "topAnchor", 12.0f64);
        pin_to(ph, "leadingAnchor", tv, "leadingAnchor", 20.0f64);
        uk_fcells[k] = held(0, cell);
        uk_fields[k] = held(0, tv);
        if (row.detail.n > 0) msg1(tv, sel("setText:"), uk_text(row.detail))
    }
    tv: int = uk_fields[k];
    ph: int = msg1(tv, sel("viewWithTag:"), 9400);
    if (ph != 0) {
        msg1(ph, sel("setText:"), uk_text(row.title));
        msg1(ph, sel("setHidden:"), if (msg(msg(tv, sel("text")), sel("length")) > 0) 1 else 0)
    }
    uk_fcells[k]
}

// A text view typed in (core's field of many lines): its placeholder, its
// list's row grown with it. True if it was core's.
uk_prose_changed(tv: int): bool {
    k: int = uk_slot_of_field(tv);
    if (k < 0) return false;
    ph: int = msg1(tv, sel("viewWithTag:"), 9400);
    if (ph != 0) msg1(ph, sel("setHidden:"), if (msg(msg(tv, sel("text")), sel("length")) > 0) 1 else 0);
    t: int = uk_tables[k];
    if (t != 0) {
        msg1(cls("UIView"), sel("setAnimationsEnabled:"), 0);
        msg(t, sel("beginUpdates"));
        msg(t, sel("endUpdates"));
        msg1(cls("UIView"), sel("setAnimationsEnabled:"), 1)
    }
    true
}

uk_prose_ended(_self: int, _cmd: int, tv: int): int {
    _e: bool = uk_field_end(tv);
    0
}

// The tray's button a share's popover points at.
uk_share_from: int = 0;

// The tray's model (core/tray.l8's), for the iPhone's selection, built now
// (the lists' records made again as they are next wanted).
uk_tray_build() {
    uk_sync();
    sk_sel_c = sel_c;
    sk_sel_n = sel_n;
    for i in 0..sel_n
        if (i < len(sk_sel_v)) sk_sel_v[i] = sel_v[i];
    sk_studying = bs_shown;
    sk_build_tray();
    uk_stale = true
}

// The tray's action done (core's), and what it says to do.
// A command of the text's menu (core's em_act) on the selection.
uk_tray_act_on(cmd: int) {
    uk_tray_build();
    uk_nav = 0;
    em_act(cmd);
    uk_stale = true;
    uk_effects()
}

uk_tray_act(action: int, value: int) {
    uk_tray_build();
    uk_nav = 0;
    sk_tray_act(action, value);
    uk_stale = true;
    uk_effects()
}

// The button tapped at the foot (a share's popover points at it).
uk_tool_item: int = 0;

// Slot k's toolbar: those at the left, then (spaced) those in the middle,
// then those at the right. Each tagged k * 16 + its index.
uk_bar_items: []int = new int[16](0);

uk_toolbar(k: int, vc: int, fade: bool) {
    n: int = 0;
    icons: bool = false;
    centers: int = 0;
    rights: int = 0;
    for j in 0..ui_tools_n {
        if (ui_tools[j].place == 1) centers = centers + 1;
        if (ui_tools[j].place == 2) rights = rights + 1
    }
    for place in 0..3 {
        if (place == 1 && centers > 0 || place == 2 && centers == 0 && rights > 0) n = uk_bar_flex(n);
        if (place == 2 && centers > 0 && rights > 0) n = uk_bar_flex(n);
        for j in 0..ui_tools_n {
            tool: UiTool = ui_tools[j];
            if (tool.place == place && n < len(uk_bar_items)) {
                item: int = 0;
                if (tool.style == UI_TOOL_SEGMENTS) {
                    // (Segments: the interlinear's order.)
                    m: int = 0;
                    chosen: int = 0;
                    while (m < 8 && uk_menu_item(tool.menu, m)) {
                        if (uk_mi_arg == tool.arg) chosen = m;
                        one[m] = nsstring_at(bytes_address(ui_pool) + uk_mi_b, uk_mi_e - uk_mi_b);
                        m = m + 1
                    }
                    seg: int = msg(msg1(msg(cls("UISegmentedControl"), sel("alloc")),
                        sel("initWithItems:"), nsarray(one, m)), sel("autorelease"));
                    msg1(seg, sel("setSelectedSegmentIndex:"), chosen);
                    msg1(seg, sel("setTag:"), k * 16 + j);
                    msg3(seg, sel("addTarget:action:forControlEvents:"), app_obj,
                        sel("coreToolSegment:"), 4096);
                    msg_rect(seg, sel("setFrame:"), 0.0f64, 0.0f64, 240.0f64, 32.0f64);
                    item = msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
                        seg)
                } else if (tool.title.n > 0) item = msg4(msg(cls("UIBarButtonItem"),
                    sel("alloc")), sel("initWithTitle:style:target:action:"), uk_text(tool.title),
                    if (tool.style == UI_TOOL_PROMINENT) 2 else 0, app_obj, sel("coreTool:")) else {
                    fbuf_n = 0;
                    fput_bytes(ui_pool, tool.icon.at, tool.icon.at + tool.icon.n);
                    item = msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
                        msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
                        fstring(), msg_f1(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
                        17.0f64, 4)), 0, app_obj, sel("coreTool:"));
                    icons = true
                }
                msg(item, sel("autorelease"));
                msg1(item, sel("setTag:"), k * 16 + j);
                // (A menu instead, I Know These': its items do the action.)
                if (tool.menu.n > 0) {
                    msg1(item, sel("setTarget:"), 0);
                    msg1(item, sel("setAction:"), 0);
                    msg1(item, sel("setMenu:"), uk_tool_menu(k, j))
                }
                if (tool.label.n > 0) msg1(item, sel("setAccessibilityLabel:"), uk_text(tool.label));
                if (tool.style == UI_TOOL_DESTRUCTIVE) msg1(item, sel("setTintColor:"),
                    msg(cls("UIColor"), sel("systemRedColor")));
                if (tool.style == UI_TOOL_OFF) msg1(item, sel("setEnabled:"), 0);
                uk_bar_items[n] = item;
                n = n + 1
            }
        }
        if (place == 1 && centers > 0 && rights == 0) n = uk_bar_flex(n)
    }
    msg2(vc, sel("setToolbarItems:animated:"), nsarray(uk_bar_items, n), if (fade) 1 else 0);
    // (Icons in the icons' color, as the bar's.)
    nav: int = msg(vc, sel("navigationController"));
    if (icons && nav != 0) msg1(msg(nav, sel("toolbar")), sel("setTintColor:"), c_icon)
}

uk_bar_flex(n: int): int {
    if (n >= len(uk_bar_items)) return n;
    uk_bar_items[n] = msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        5, 0, 0), sel("autorelease"));
    n + 1
}

// ---- segments and a color filter, as a list's header (the Library's):
// the segments on a row of their own, the width of the list, and under
// them the filter, All then a circle each color. One box a slot, kept
// while it is shown ----
uk_boxes: []int = new int[UK_SLOTS](0);

uk_segs: []int = new int[UK_SLOTS](0);

uk_fboxes: []int = new int[UK_SLOTS](0);

UK_SEG_ROW: f64 = 48.0f64;

uk_header_box(k: int, fade: bool) {
    t: int = uk_tables[k];
    W: f64 = view_width(t);
    if (uk_boxes[k] == 0) {
        box: int = make("UIView");
        msg_rect(box, sel("setFrame:"), 0.0f64, 0.0f64, W, UK_SEG_ROW);
        n: int = uk_split(ui_segments, one);
        seg: int = msg(msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
            nsarray(one, n)), sel("autorelease"));
        msg1(seg, sel("setTag:"), k);
        msg3(seg, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreSegment:"),
            4096);
        // (Pinned to the box's sides: the list's width is not yet known
        // when the sheet is made.)
        msg1(seg, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(box, sel("addSubview:"), seg);
        pin_by(seg, box, "leadingAnchor", 16.0f64);
        pin_by(seg, box, "trailingAnchor", -16.0f64);
        pin_by(seg, box, "topAnchor", 6.0f64);
        pin_size(seg, "heightAnchor", 32.0f64);
        uk_boxes[k] = box;
        uk_segs[k] = seg
    }
    msg1(uk_segs[k], sel("setSelectedSegmentIndex:"), ui_segment);
    if (uk_fboxes[k] != 0) {
        msg(uk_fboxes[k], sel("removeFromSuperview"));
        uk_fboxes[k] = 0
    }
    h: f64 = UK_SEG_ROW;
    if (ui_filter_colors.n > 0) {
        f: int = uk_filter_row(k, W);
        msg_rect(f, sel("setFrame:"), 0.0f64, UK_SEG_ROW - 4.0f64, W, 52.0f64);
        msg1(f, sel("setAutoresizingMask:"), 2);
        msg1(uk_boxes[k], sel("addSubview:"), f);
        if (fade) fade_layer(msg(f, sel("layer")), 0.15f64);
        uk_fboxes[k] = f;
        h = UK_SEG_ROW + 48.0f64
    }
    if (ui_intro.n > 0) {
        f: int = uk_intro_view(if (W < 1.0f64) 375.0f64 else W, uk_text(ui_intro));
        l8_msg_hfa(hfa, f, sel("frame"), 0, 0, 0);
        fh: f64 = hfa[3] - 14.0f64;
        msg_rect(f, sel("setFrame:"), 0.0f64, h - 14.0f64, W, fh);
        msg1(f, sel("setAutoresizingMask:"), 2);
        msg1(uk_boxes[k], sel("addSubview:"), f);
        if (uk_fboxes[k] == 0) uk_fboxes[k] = f;
        h = h - 14.0f64 + fh
    }
    msg_rect(uk_boxes[k], sel("setFrame:"), 0.0f64, 0.0f64, W, h);
    msg1(t, sel("setTableHeaderView:"), uk_boxes[k])
}

// The filter: All (filled in the accent when chosen), then each color's
// circle (ringed and checked when chosen). Tags: -1 All, else the color.
uk_filter_row(k: int, W: f64): int {
    box: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, W, 52.0f64), sel("autorelease"));
    row: int = stack(0, 12.0f64);
    msg1(row, sel("setAlignment:"), 3);
    all: bool = ui_filter < 0;
    config: int = msg(cls("UIButtonConfiguration"), sel(if (all) "filledButtonConfiguration" else "grayButtonConfiguration"));
    if (all) {
        msg1(config, sel("setBaseBackgroundColor:"), c_accent);
        msg1(config, sel("setBaseForegroundColor:"), on_accent())
    }
    msg1(config, sel("setCornerStyle:"), 4);
    msg1(config, sel("setTitle:"), nsstring(w_all));
    b0: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(b0, sel("setTag:"), -1);
    msg3(b0, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreFilter:"),
        64);
    msg1(b0, sel("setAccessibilityLabel:"), nsstring(w_show_all));
    msg1(b0, sel("setAccessibilityTraits:"), if (all) 9 else 1);
    msg1(row, sel("addArrangedSubview:"), b0);
    uk_filter_k = k;
    n: int = uk_split(ui_filter_colors, one);
    _l: int = uk_split(ui_filter_labels, uk_labels);
    for i in 0..n {
        on: bool = ui_filter == i;
        ring: int = make("UIView");
        msg1(ring, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        pin_size(ring, "widthAnchor", 36.0f64);
        pin_size(ring, "heightAnchor", 36.0f64);
        rl: int = msg(ring, sel("layer"));
        msg_set_f(rl, sel("setCornerRadius:"), 18.0f64);
        msg_set_f(rl, sel("setBorderWidth:"), 2.0f64);
        msg1(rl, sel("setBorderColor:"), msg(if (on) c_accent else msg(cls("UIColor"),
            sel("clearColor")), sel("CGColor")));
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(b, sel("setTag:"), i);
        n_hex: int = nsstring_into(one[i], uk_query_buf);
        msg1(b, sel("setBackgroundColor:"), uk_hex_color(n_hex));
        msg_set_f(msg(b, sel("layer")), sel("setCornerRadius:"), 14.0f64);
        msg1(b, sel("setAccessibilityLabel:"), uk_labels[i]);
        msg1(b, sel("setAccessibilityTraits:"), if (on) 9 else 1);
        if (on) msg2(b, sel("setImage:forState:"), symbol("checkmark", 11.0f64, 7,
            msg(cls("UIColor"), sel("whiteColor"))), 0);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreFilter:"),
            64);
        msg1(ring, sel("addSubview:"), b);
        pin_size(b, "widthAnchor", 28.0f64);
        pin_size(b, "heightAnchor", 28.0f64);
        pin_to(b, "centerXAnchor", ring, "centerXAnchor", 0.0f64);
        pin_to(b, "centerYAnchor", ring, "centerYAnchor", 0.0f64);
        msg1(row, sel("addArrangedSubview:"), ring);
        release(ring)
    }
    msg1(box, sel("addSubview:"), row);
    pin_by(row, box, "leadingAnchor", 16.0f64);
    pin_to(row, "centerYAnchor", box, "centerYAnchor", 0.0f64);
    box
}

uk_filter_k: int = -1;

// (The hex in uk_query_buf's first n bytes, as a color.)
uk_hex_color(n: int): int {
    v: int = 0;
    for i in 0..n {
        c: int = uk_query_buf[i] as int;
        d: int = if (c >= 48 && c <= 57) c - 48 else if (c >= 65 && c <= 70) c - 55 else if (c >= 97 && c <= 102) c - 87 else 0;
        v = v * 16 + d
    }
    msg_rect(cls("UIColor"), sel("colorWithRed:green:blue:alpha:"), (v / 65536 % 256) as f64 / 255.0f64,
        (v / 256 % 256) as f64 / 255.0f64, (v % 256) as f64 / 255.0f64, 1.0f64)
}

uk_segment_chosen(_self: int, _cmd: int, seg: int): int {
    k: int = msg(seg, sel("tag"));
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return 0;
    action: int = ui_segments_action;
    uk_sync();
    sk_act(uk_ids[k], action, 0, msg(seg, sel("selectedSegmentIndex")));
    uk_effects();
    0
}

// (Segment i of core's screen of kind chosen, as a tap would: the
// demos'.)
uk_segment_tap(kind: int, i: int) {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0 || uk_segs[k] == 0) return;
    msg1(uk_segs[k], sel("setSelectedSegmentIndex:"), i);
    _r: int = uk_segment_chosen(0, 0, uk_segs[k])
}

// (Color i of core's screen of kind's filter chosen, as a tap would.)
uk_filter_tap(kind: int, i: int) {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0 || !uk_ensure(k)) return;
    action: int = ui_filter_action;
    uk_sync();
    sk_act(uk_ids[k], action, 0, i);
    uk_effects()
}

uk_filter_tapped(_self: int, _cmd: int, b: int): int {
    k: int = uk_filter_k;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return 0;
    action: int = ui_filter_action;
    haptic_select();
    uk_sync();
    sk_act(uk_ids[k], action, 0, msg(b, sel("tag")));
    uk_effects();
    0
}

// The sort menu, at the top left (the system's "Sort By": its commands
// answered by the app, the one in force checked). Its button, the demos'.
lib_sort_button: int = 0;

uk_sort_button(k: int) {
    item: int = msg(uk_vcs[k], sel("navigationItem"));
    old: int = msg(item, sel("leftBarButtonItem"));
    b: int = if (old != 0) msg(old, sel("customView")) else 0;
    if (b == 0) {
        config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
        msg1(config, sel("setImage:"), symbol("arrow.up.arrow.down", 17.0f64, 4, 0));
        b = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"), config,
            0);
        msg1(b, sel("setShowsMenuAsPrimaryAction:"), 1);
        msg1(b, sel("setAccessibilityLabel:"), nsstring(w_sort));
        bi: int = msg(msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
            b), sel("autorelease"));
        msg1(item, sel("setLeftBarButtonItem:"), bi)
    }
    lib_sort_button = b;
    n: int = uk_split(ui_sorts, uk_labels);
    for i in 0..n {
        one[i] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
            uk_labels[i], 0, sel("coreSort:"), nsnumber_int(k * 16 + i));
        msg1(one[i], sel("setState:"), if (i == ui_sort) 1 else 0)
    }
    msg1(b, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring("Sort By"),
        nsarray(one, n)))
}

// (Sort i of core's screen of kind chosen, as its menu would.)
uk_sort_tap(kind: int, i: int) {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0 || !uk_ensure(k)) return;
    action: int = ui_sort_action;
    uk_sync();
    sk_act(uk_ids[k], action, 0, i);
    uk_effects()
}

uk_sort_chosen(_self: int, _cmd: int, command: int): int {
    n: int = msg(msg(command, sel("propertyList")), sel("integerValue"));
    k: int = n / 16;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return 0;
    action: int = ui_sort_action;
    uk_sync();
    sk_act(uk_ids[k], action, 0, n % 16);
    uk_effects();
    0
}

// Whether slot k's screen has a button at its foot (its toolbar shown
// while it is).
uk_tooled: []bool = new bool[UK_SLOTS](false);

// ---- fields and swatches: a cell each kept for the screen's while it is
// up (a field keeps the keys through a reload; the swatches' check moves
// with a fade) ----
uk_fcells: []int = new int[UK_SLOTS](0);

uk_fields: []int = new int[UK_SLOTS](0);

uk_swcells: []int = new int[UK_SLOTS](0);

// Slot k's field (row i): the app's field cell, its placeholder faint, its
// words as core has them (unless being typed in).
uk_field_cell(k: int, i: int): int {
    row: UiRow = ui_rows[i];
    if (uk_fcells[k] == 0) {
        field_cell(field_pair);
        uk_fcells[k] = held(0, field_pair[0]);
        uk_fields[k] = held(0, field_pair[1])
    }
    f: int = uk_fields[k];
    if (row.field_live && !uk_field_lives[k]) {
        // (Its words to core as they are typed.)
        msg3(f, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreFieldTyped:"),
            131072);
        uk_field_lives[k] = true
    }
    if (row.field_kind == 1) {
        msg1(f, sel("setAutocapitalizationType:"), 2);
        msg1(f, sel("setAutocorrectionType:"), 1)
    }
    keys[0] = k_color;
    values[0] = c_faint;
    msg1(f, sel("setAttributedPlaceholder:"), if (row.title.n > 0) attributed_str(uk_text(row.title),
        nsdictionary(keys, values, 1)) else 0);
    if ((msg(f, sel("isFirstResponder")) & 255) == 0) msg1(f, sel("setText:"), if (row.detail.n > 0) uk_text(row.detail) else nsstring(""));
    if (row.label.n > 0) msg1(f, sel("setAccessibilityLabel:"), uk_text(row.label));
    uk_fcells[k]
}

uk_field_lives: []bool = new bool[UK_SLOTS](false);

uk_field_typed(_self: int, _cmd: int, f: int): int {
    k: int = uk_slot_of_field(f);
    if (k >= 0) uk_field_commit(k);
    0
}

// The slot whose field f is (-1: none of core's).
uk_slot_of_field(f: int): int {
    for k in 0..UK_SLOTS
        if (f != 0 && uk_fields[k] == f && uk_ids[k] != 0) return k;
    -1
}

// Slot k's field row (of the screen just ensured), or -1.
uk_field_row(): int {
    for i in 0..ui_rows_n
        if (ui_rows[i].kind == UI_FIELD) return i;
    -1
}

// Slot k's field's words given to core (its row's action).
uk_field_commit(k: int) {
    if (k < 0 || uk_fields[k] == 0 || !uk_ensure(k)) return;
    i: int = uk_field_row();
    if (i < 0) return;
    action: int = ui_rows[i].action;
    arg: int = ui_rows[i].arg;
    n: int = nsstring_into(msg(uk_fields[k], sel("text")), uk_query_buf);
    uk_sync();
    sk_text(uk_ids[k], action, arg, uk_query_buf, 0, n);
    uk_effects()
}

// A field's editing ended (its words to core); whether it was core's.
uk_field_end(f: int): bool {
    k: int = uk_slot_of_field(f);
    if (k < 0) return false;
    uk_field_commit(k);
    true
}

// A field's Return: the screen's confirm (New Ribbon's Add), or the
// editing ended; whether it was core's.
uk_field_return(f: int): bool {
    k: int = uk_slot_of_field(f);
    if (k < 0) return false;
    i: int = if (uk_ensure(k)) uk_field_row() else -1;
    if (i >= 0 && ui_rows[i].field_go) uk_confirm(k) else msg(f, sel("resignFirstResponder"));
    true
}

// The theme changed: the kept cells in it (their backgrounds, a field's
// words, the swatches' colors).
uk_restyle_kept() {
    for k in 0..UK_SLOTS {
        for c in [uk_fcells[k], uk_swcells[k]] {
            if (c != 0) msg1(c, sel("setBackgroundColor:"), cell_bg())
        }
        if (uk_fields[k] != 0) msg1(uk_fields[k], sel("setTextColor:"), c_ink);
        if (uk_swcells[k] != 0 && uk_ensure(k)) {
            for i in 0..ui_rows_n
                if (ui_rows[i].custom == CUSTOM_SWATCHES) swatches_set(swatch_stack(uk_swcells[k],
                    10 + k), ui_rows[i].value)
        }
    }
}

// The field of core's screen of kind (the demos').
uk_field_of(kind: int): int {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0) 0 else uk_fields[k]
}

uk_field_commit_kind(kind: int) {
    uk_field_commit(uk_slot_of(uk_table_of(kind)))
}

// Slot k's swatches (row i): the app's swatch cell (its owner 10 + k), the
// one chosen checked.
uk_swatch_cell(k: int, i: int): int {
    row: UiRow = ui_rows[i];
    if (uk_swcells[k] == 0) uk_swcells[k] = held(0, swatch_cell(10 + k, row.value)) else swatches_set(swatch_stack(uk_swcells[k],
        10 + k), row.value);
    uk_swcells[k]
}

// A swatch of slot k's tapped (color c): its row's action, core's.
uk_swatch_tapped(k: int, c: int) {
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return;
    for i in 0..ui_rows_n {
        if (ui_rows[i].custom == CUSTOM_SWATCHES) {
            action: int = ui_rows[i].action;
            arg: int = ui_rows[i].arg;
            uk_sync();
            sk_act(uk_ids[k], action, arg, c);
            uk_effects();
            return
        }
    }
}

uk_swatch_stack(kind: int): int {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0) 0 else swatch_stack(uk_swcells[k], 10 + k)
}

// The screen's confirm (its button, or its field's Return): the field's
// words given first, the keyboard put away.
uk_confirm(k: int) {
    if (k < 0 || k >= UK_SLOTS || uk_ids[k] == 0) return;
    uk_field_commit(k);
    if (uk_fields[k] != 0) msg(uk_fields[k], sel("resignFirstResponder"));
    if (!uk_ensure(k)) return;
    action: int = ui_confirm_action;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], action, 0, 0);
    uk_effects()
}

uk_confirm_tapped(_self: int, _cmd: int, item: int): int {
    uk_confirm(msg(item, sel("tag")));
    0
}

uk_confirm_kind(kind: int) {
    uk_confirm(uk_slot_of(uk_table_of(kind)))
}

// Whether slot k's screen was pushed (else presented: Cancel beside its
// confirm).
uk_pushed: []bool = new bool[UK_SLOTS](false);

uk_making_push: bool = false;

// A verse found: its reference small, in the accent; its words as the
// reader's, the matches in full ink, bold and washed, the rest softer, up
// to four lines.
uk_hit_cell(t: int, i: int): int {
    row: UiRow = ui_rows[i];
    cell: int = list_cell(t, "hit", 2);
    config: int = list_config(2);
    keys[0] = k_font;
    values[0] = sans(13.0f64, 0.3f64);
    keys[1] = k_color;
    values[1] = c_accent;
    a: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        uk_text(row.title), nsdictionary(keys, values, 2)), sel("autorelease"));
    // (" Â· not translated", faint.)
    if (row.suffix.n > 0) append(a, uk_text(row.suffix), sans(13.0f64, 0.0f64), c_faint);
    msg1(config, sel("setAttributedText:"), a);
    msg1(config, sel("setSecondaryAttributedText:"), uk_hit_text(i));
    // (A verse in its own script whole: Verses You Can Read's.)
    msg1(detail_props(config), sel("setNumberOfLines:"), if (row.runs_n > 0) 0 else if (row.lines > 0) row.lines else 4);
    msg1(detail_props(config), sel("setLineBreakMode:"), 4);
    msg_set_f(config, sel("setTextToSecondaryTextVerticalPadding:"), 3.0f64);
    msg_rect(config, sel("setDirectionalLayoutMargins:"), 12.0f64, 20.0f64, 12.0f64,
        20.0f64);
    msg1(cell, sel("setContentConfiguration:"), config);
    cell
}

// Row i's words with its marks stressed (the original's in its fonts, the
// Hebrew right to left).
uk_hit_text(i: int): int {
    row: UiRow = ui_rows[i];
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    size: f64 = msg_f_f(metrics, sel("scaledValueForValue:"), 16.0f64);
    c: int = row.arg / 1000;
    // (In its script, if its runs say: else as the reader's version.)
    script: int = if (row.runs_n > 0) ui_runs[row.runs + 1] else 0;
    orig: bool = text_cur == TEXT_ORIG || script == RUN_GREEK || script == RUN_HEBREW;
    hebrew: bool = script == RUN_HEBREW || script == 0 && orig && c >= 0 && c < chapters && ch_book[c] < 39;
    keys[0] = k_font;
    values[0] = (if (hebrew) sans(size * 1.15f64, 0.0f64) else if (orig) new_york(size) else body(size));
    keys[1] = k_color;
    values[1] = msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64);
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, if (hebrew) 1.4f64 else 1.25f64),
        sel("autorelease"));
    msg1(values[2], sel("setLineBreakMode:"), 4);
    if (hebrew) {
        msg1(values[2], sel("setBaseWritingDirection:"), 1);
        msg1(values[2], sel("setAlignment:"), 4)
    }
    text: int = uk_text(row.detail);
    if (text == 0) text = nsstring("");
    s: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, nsdictionary(keys, values, 3)), sel("autorelease"));
    if (!orig) caps_into(s, 0, text, true, size);
    bold_font: int = if (hebrew) sans(size * 1.15f64, 0.4f64) else if (orig) new_york_bold(size) else bold(size);
    for m in 0..row.marks_n {
        b: int = ui_marks[row.marks + m * 2];
        n: int = ui_marks[row.marks + m * 2 + 1] - b;
        msg4(s, sel("addAttribute:value:range:"), k_font, bold_font, b, n);
        msg4(s, sel("addAttribute:value:range:"), k_color, c_ink, b, n);
        // (Hebrew semibold only: a background is drawn in pieces round its
        // points, run 39573776932's 289.)
        if (!hebrew) msg4(s, sel("addAttribute:value:range:"), k_background, c_sel,
            b, n)
    }
    s
}

// A section's header with a button (Recent Searches' Clear): its title,
// and the button, doing its action. The button's tag says its slot and
// section: k * 64 + s.
uk_header_view(t: int, s: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= ui_sections_n) return 0;
    if (ui_sections[s].columns.n > 0) return uk_columns_header(t, s);
    if (ui_sections[s].button.n == 0 && ui_sections[s].header_suffix.n > 0) return uk_suffix_header(s);
    if (ui_sections[s].button.n == 0) return 0;
    v: int = msg(make("UIView"), sel("autorelease"));
    label: int = make("UILabel");
    msg1(label, sel("setText:"), uk_text(ui_sections[s].header));
    msg1(label, sel("setFont:"), sans(15.0f64, 0.4f64));
    msg1(label, sel("setTextColor:"), c_ink);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), label);
    release(label);
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setTitle:"), uk_text(ui_sections[s].button));
    msg1(config, sel("setBaseForegroundColor:"), c_accent);
    b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(b, sel("setTag:"), k * 64 + s);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreSectionButton:"),
        64);
    msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), b);
    pin_by(label, v, "leadingAnchor", 20.0f64);
    pin_by(label, v, "topAnchor", 14.0f64);
    pin_by(label, v, "bottomAnchor", -6.0f64);
    pin_by(b, v, "trailingAnchor", -8.0f64);
    pin_to(b, "centerYAnchor", label, "centerYAnchor", 0.0f64);
    msg1(v, sel("setBackgroundColor:"), c_bg);
    v
}

// A header with faint words after it (Compare's " Â· Reading"), wrapping at
// the largest sizes.
uk_suffix_header(s: int): int {
    v: int = msg(make("UIView"), sel("autorelease"));
    label: int = make("UILabel");
    msg1(label, sel("setNumberOfLines:"), 0);
    keys[0] = k_font;
    values[0] = msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleFootnote"));
    keys[1] = k_color;
    values[1] = msg(cls("UIColor"), sel("secondaryLabelColor"));
    s1: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    if (ui_sections[s].header.n > 0) msg1(s1, sel("appendAttributedString:"), attributed_str(uk_text(ui_sections[s].header),
        nsdictionary(keys, values, 2)));
    values[1] = c_faint;
    msg1(s1, sel("appendAttributedString:"), attributed_str(uk_text(ui_sections[s].header_suffix),
        nsdictionary(keys, values, 2)));
    msg1(label, sel("setAttributedText:"), s1);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), label);
    release(label);
    pin_by(label, v, "leadingAnchor", 20.0f64);
    pin_by(label, v, "trailingAnchor", -20.0f64);
    pin_by(label, v, "topAnchor", 14.0f64);
    pin_by(label, v, "bottomAnchor", -6.0f64);
    v
}

// A section's credit under it (the ESV's link).
uk_footer_view(t: int, s: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= ui_sections_n || ui_sections[s].credit != 1) return 0;
    esv_footer_view()
}

uk_section_button(_self: int, _cmd: int, b: int): int {
    n: int = msg(b, sel("tag"));
    k: int = n / 64;
    s: int = n % 64;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || s >= ui_sections_n) return 0;
    action: int = ui_sections[s].button_action;
    uk_sync();
    sk_act(uk_ids[k], action, 0, 0);
    uk_effects();
    0
}

// A toggle's switch, or a choice's segmented control, beside its title (a
// choice's under it at the accessibility sizes). Its tag says its slot and
// row: k * 4096 + i.
uk_control_cell(t: int, k: int, i: int): int {
    row: UiRow = ui_rows[i];
    control: int = 0;
    if (row.kind == UI_TOGGLE) {
        control = msg(make("UISwitch"), sel("autorelease"));
        msg1(control, sel("setOn:"), if (row.on) 1 else 0);
        msg1(control, sel("setOnTintColor:"), c_accent);
        msg3(control, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreToggle:"),
            4096)
    } else if (row.kind == UI_TIME) {
        // (A time: the system's compact picker, at its value's minutes.)
        control = msg(make("UIDatePicker"), sel("autorelease"));
        msg1(control, sel("setDatePickerMode:"), 0);
        if (responds(control, "setPreferredDatePickerStyle:")) msg1(control, sel("setPreferredDatePickerStyle:"),
            2);
        msg1(control, sel("setDate:"), date_at_minutes(row.value));
        msg3(control, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreTime:"),
            4096);
        msg(control, sel("sizeToFit"))
    } else {
        // (Its options, split at |.)
        n: int = 0;
        p: int = row.options.at;
        e: int = row.options.at + row.options.n;
        for x in row.options.at..e + 1 {
            if (x == e || ui_pool[x] as int == 124) {
                if (n < len(one)) one[n] = nsstring_at(bytes_address(ui_pool) + p,
                    x - p);
                n = n + 1;
                p = x + 1
            }
        }
        control = msg(msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
            nsarray(one, n)), sel("autorelease"));
        msg1(control, sel("setSelectedSegmentIndex:"), row.value);
        msg3(control, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreChoice:"),
            4096);
        msg_rect(control, sel("setFrame:"), 0.0f64, 0.0f64, 220.0f64, 32.0f64)
    }
    msg1(control, sel("setTag:"), k * 4096 + i);
    fbuf_n = 0;
    fput_bytes(ui_pool, row.title.at, row.title.at + row.title.n);
    if (row.kind == UI_CHOICE && ax_size()) {
        cell: int = fresh_cell(t);
        content: int = msg(cell, sel("contentView"));
        column: int = stack(1, 10.0f64);
        label: int = make("UILabel");
        msg1(label, sel("setText:"), fstring());
        msg1(label, sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
            objc_const("UIFontTextStyleBody")));
        msg1(label, sel("setTextColor:"), c_ink);
        msg1(label, sel("setNumberOfLines:"), 0);
        msg1(column, sel("addArrangedSubview:"), label);
        release(label);
        msg1(column, sel("addArrangedSubview:"), control);
        msg1(content, sel("addSubview:"), column);
        pin_by(column, content, "leadingAnchor", 16.0f64);
        pin_by(column, content, "trailingAnchor", -16.0f64);
        pin_by(column, content, "topAnchor", 12.0f64);
        pin_by(column, content, "bottomAnchor", -12.0f64);
        return cell
    }
    cell: int = fresh_cell(t);
    config: int = list_config(0);
    msg1(config, sel("setText:"), fstring());
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryView:"), control);
    cell
}

// A switch switched, or a segment chosen: its row's action, core's.
uk_control_act(control: int, value: int) {
    n: int = msg(control, sel("tag"));
    k: int = n / 4096;
    i: int = n % 4096;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || i >= ui_rows_n) return;
    row: UiRow = ui_rows[i];
    uk_sync();
    sk_act(uk_ids[k], row.action, row.arg, value);
    uk_effects()
}

uk_toggled(_self: int, _cmd: int, sw: int): int {
    uk_control_act(sw, if ((msg(sw, sel("isOn")) & 255) != 0) 1 else 0);
    0
}

// A time chosen: its minutes past midnight, the row's action's value.
uk_time_chosen(_self: int, _cmd: int, picker: int): int {
    cal: int = msg(cls("NSCalendar"), sel("currentCalendar"));
    date: int = msg(picker, sel("date"));
    h: int = msg2(cal, sel("component:fromDate:"), 32, date);
    m: int = msg2(cal, sel("component:fromDate:"), 64, date);
    uk_control_act(picker, h * 60 + m);
    0
}

uk_chose(_self: int, _cmd: int, s: int): int {
    uk_control_act(s, msg(s, sel("selectedSegmentIndex")));
    0
}

// A row tapped: its action, core's, and what core says then.
uk_picked(t: int, s: int, r: int) {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= ui_sections_n) return;
    // (A grid's cell: its buttons are tapped, not it.)
    if (ui_grid) return;
    ri: int = uk_row_of(s, r);
    if (ri < 0) return;
    row: UiRow = ui_rows[ri];
    if (row.disabled || row.kind != UI_ITEM && row.kind != UI_BUTTON) return;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], row.action, row.arg, 0);
    uk_effects()
}

// Where a screen core pushes goes: the navigation the action came from
// (0: the sheet up).
uk_nav: int = 0;

// Whether the next sheet opens at its medium detent (Compare).
uk_medium: bool = false;

// The next sheet's detents (sheet_of's), and the last sheet presented.
uk_detents: int = 0;

uk_sheet: int = 0;

// A row swiped: whether it can be, and its deletion (core's action).
uk_can_edit(t: int, path: int): bool {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k)) return false;
    i: int = uk_row_at(path);
    i >= 0 && ui_rows[i].delete_action != 0
}

uk_commit(t: int, style: int, path: int) {
    k: int = uk_slot_of(t);
    if (style != 1 || k < 0 || !uk_ensure(k)) return;
    r: int = msg(path, sel("row"));
    i: int = uk_row_at(path);
    if (i < 0 || ui_rows[i].delete_action == 0) return;
    uk_delete_row(k, msg(path, sel("section")), r, ui_rows[i].delete_action, ui_rows[i].arg)
}

// Row r of section s of slot k deleted (its action): the screen made
// again, and if all it lost is that row (or its section, the row its
// last), the row (or section) taken away with the system's animation, the
// section's footer changing in place; else a cross-fade.
uk_del_k: int = -1;

uk_del_s: int = 0;

uk_del_r: int = 0;

uk_del_n: int = 0;

uk_del_counts: []int = new int[128](0);

uk_del_header: int = 0;

uk_del_footer: int = 0;

uk_delete_row(
    k: int,
    s: int,
    r: int,
    action: int,
    arg: int
) {
    if (!uk_ensure(k) || s >= ui_sections_n) return;
    uk_del_k = k;
    uk_del_s = s;
    uk_del_r = r;
    uk_del_n = ui_sections_n;
    for x in 0..ui_sections_n
        if (x < len(uk_del_counts)) uk_del_counts[x] = ui_sections[x].n;
    uk_del_header = held(0, uk_text(ui_sections[s].header));
    uk_del_footer = held(0, uk_text(ui_sections[s].footer));
    uk_sync();
    sk_act(uk_ids[k], action, arg, 0);
    uk_effects();
    uk_del_k = -1;
    uk_del_header = held(uk_del_header, 0);
    uk_del_footer = held(uk_del_footer, 0)
}

// (Whether two words, either none, are the same.)
uk_same_text(a: int, b: int): bool {
    if (a == 0 || b == 0) return a == b;
    (msg1(a, sel("isEqualToString:"), b) & 255) != 0
}

// The update of the slot a row was deleted from: animated if it can be;
// whether it was.
uk_deleted(k: int): bool {
    t: int = uk_tables[k];
    if (t == 0 || msg(t, sel("window")) == 0) return false;
    uk_stale = true;
    if (!uk_ensure(k)) return false;
    s: int = uk_del_s;
    if (ui_sections_n == uk_del_n) {
        for x in 0..ui_sections_n {
            want: int = if (x == s) uk_del_counts[x] - 1 else uk_del_counts[x];
            if (x >= len(uk_del_counts) || ui_sections[x].n != want) return false
        }
        if (!uk_same_text(uk_text(ui_sections[s].header), uk_del_header)) return false;
        one[0] = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), uk_del_r,
            s);
        msg2(t, sel("deleteRowsAtIndexPaths:withRowAnimation:"), nsarray(one, 1),
            100);
        footer: int = uk_text(ui_sections[s].footer);
        if (!uk_same_text(footer, uk_del_footer)) {
            // (The footer's words, in place, faded; its height after.)
            f: int = msg1(t, sel("footerViewForSection:"), s);
            if (f != 0) {
                fade_layer(msg(f, sel("layer")), 0.2f64);
                if (responds(f, "textLabel")) msg1(msg(f, sel("textLabel")), sel("setText:"),
                    footer)
            }
            msg(t, sel("beginUpdates"));
            msg(t, sel("endUpdates"))
        }
        uk_dress(k, false);
        return true
    }
    if (ui_sections_n == uk_del_n - 1 && s < len(uk_del_counts) && uk_del_counts[s] == 1) {
        for x in 0..ui_sections_n {
            was: int = if (x < s) uk_del_counts[x] else uk_del_counts[x + 1];
            if (ui_sections[x].n != was) return false
        }
        msg2(t, sel("deleteSections:withRowAnimation:"), msg1(cls("NSIndexSet"), sel("indexSetWithIndex:"),
            s), 100);
        uk_dress(k, false);
        return true
    }
    false
}

// The swipe's word: its row's action's that it does (a plan's Remove:
// nothing is lost, Â§11.3.1), else Delete.
uk_delete_title(t: int, path: int): int {
    k: int = uk_slot_of(t);
    i: int = if (k >= 0 && uk_ensure(k)) uk_row_at(path) else -1;
    if (i >= 0) {
        for j in 0..ui_rows[i].actions_n {
            a: UiAction = ui_actions[ui_rows[i].actions + j];
            if (a.action == ui_rows[i].delete_action) return uk_text(a.title)
        }
    }
    nsstring(w_delete)
}

// A row's â“˜: its action (a ribbon's screen, the plan followed's days).
uk_accessory(t: int, path: int) {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k)) return;
    i: int = uk_row_at(path);
    if (i < 0 || ui_rows[i].info_action == 0) return;
    action: int = ui_rows[i].info_action;
    arg: int = ui_rows[i].arg;
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_act(uk_ids[k], action, arg, 0);
    uk_effects()
}

// A command of a screen's button's menu chosen (its slot and index in its
// propertyList).
uk_command(_self: int, _cmd: int, command: int): int {
    n: int = msg(msg(command, sel("propertyList")), sel("integerValue"));
    k: int = n / 64;
    j: int = n % 64;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || j >= ui_commands_n) return 0;
    c: UiCommand = ui_commands[j];
    uk_sync();
    sk_act(uk_ids[k], c.action, c.arg, 0);
    uk_effects();
    0
}

// A list's empty state (as empty_state, with the screen's words): a
// symbol, a title and a line; none, if symbol is 0.
uk_empty(
    vc: int,
    t: int,
    symbol_name: int,
    title: int,
    line: int
) {
    u: int = cls("UIContentUnavailableConfiguration");
    if (u != 0) {
        if (symbol_name == 0) {
            msg1(vc, sel("setContentUnavailableConfiguration:"), 0);
            return
        }
        config: int = msg(u, sel("emptyConfiguration"));
        sc: int = msg_f1(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
            40.0f64, 4);
        msg1(config, sel("setImage:"), msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
            symbol_name, sc));
        msg1(config, sel("setText:"), title);
        msg1(config, sel("setSecondaryText:"), line);
        msg1(vc, sel("setContentUnavailableConfiguration:"), config);
        return
    }
    if (symbol_name == 0) {
        msg1(t, sel("setBackgroundView:"), 0);
        return
    }
    label: int = make("UILabel");
    msg1(label, sel("setText:"), title);
    msg1(label, sel("setTextAlignment:"), 1);
    msg1(label, sel("setTextColor:"), c_faint);
    msg1(t, sel("setBackgroundView:"), label);
    release(label)
}

// Slot k's screen's controller dressed as the screen says: its empty state
// (no rows), and its button (its menu of commands; none, dimmed).
uk_dress(k: int, fade: bool) {
    if (!uk_ensure(k)) return;
    vc: int = uk_vcs[k];
    t: int = uk_tables[k];
    if (ui_rows_n == 0 && ui_empty_title.n > 0) {
        if (fade) fade_layer(msg(msg(vc, sel("view")), sel("layer")), 0.25f64);
        uk_empty(vc, t, uk_text(ui_empty_symbol), uk_text(ui_empty_title), uk_text(ui_empty_line))
    } else uk_empty(vc, t, 0, 0, 0);
    // (Its words above the first section, as wide as the list is, or will
    // be.)
    if (ui_hero.n > 0) {
        W: f64 = view_width(t);
        if (W < 1.0f64) {
            nav: int = if (uk_nav != 0) uk_nav else presented();
            W = (if (nav != 0) view_width(msg(nav, sel("view"))) else sheet_content_w(700.0f64))
        }
        msg1(t, sel("setTableHeaderView:"), uk_hero_view(W))
    }
    if (ui_intro.n > 0 && (ui_segments.n == 0 || ui_segments_title)) {
        W: f64 = view_width(t);
        if (W < 1.0f64) {
            nav: int = if (uk_nav != 0) uk_nav else presented();
            W = (if (nav != 0) view_width(msg(nav, sel("view"))) else sheet_content_w(540.0f64))
        }
        head: int = uk_intro_view(W, uk_text(ui_intro));
        msg1(t, sel("setTableHeaderView:"), head);
        if (fade) fade_layer(msg(head, sel("layer")), 0.25f64)
    }
    // (At its foot, its buttons: Start Plan, or Stop Plan in red; the
    // Library's Export, a note to write.)
    uk_tooled[k] = ui_tools_n > 0;
    if (ui_tools_n > 0) uk_toolbar(k, vc, fade);
    // (Its segments and filter as its list's header; its sort, at the
    // top left; its field's placeholder, the segment's.)
    if (ui_segments.n > 0 && !ui_segments_title) uk_header_box(k, fade);
    if (ui_segments.n > 0 && ui_segments_title) uk_title_segments(k, msg(vc, sel("navigationItem")));
    if (ui_sorts.n > 0) uk_sort_button(k);
    if (uk_searches[k] != 0) msg1(msg(uk_searches[k], sel("searchBar")), sel("setPlaceholder:"),
        uk_text(ui_search));
    msg1(vc, sel("setTitle:"), uk_text(ui_title));
    // (At the top right: the screen's button, as History's Clear; else
    // Done.)
    item: int = msg(vc, sel("navigationItem"));
    if (ui_confirm.n > 0) {
        // (Its confirm, New Ribbon's Add; on a sheet of its own, Cancel.)
        add: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithTitle:style:target:action:"),
            uk_text(ui_confirm), 2, app_obj, sel("coreConfirm:")), sel("autorelease"));
        msg1(add, sel("setTag:"), k);
        msg1(add, sel("setEnabled:"), if (ui_confirm_off) 0 else 1);
        msg1(item, sel("setRightBarButtonItem:"), add);
        if (ui_left.n > 0) uk_left_item(k, item) else if (!uk_pushed[k]) msg1(item,
            sel("setLeftBarButtonItem:"), system_item(1, "closeSheet:"));
        return
    }
    if (ui_left.n > 0) uk_left_item(k, item);
    if (ui_button.n == 0) {
        // (Done, if it isn't there: not made again as a query is typed.)
        old: int = msg(item, sel("rightBarButtonItem"));
        if (old == 0 || msg(old, sel("customView")) != 0) msg1(item, sel("setRightBarButtonItem:"),
            system_item(0, "closeSheet:"));
        return
    }
    old: int = msg(item, sel("rightBarButtonItem"));
    b: int = if (old != 0) msg(old, sel("customView")) else 0;
    if (b == 0) {
        config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
        msg1(config, sel("setTitle:"), uk_text(ui_button));
        msg1(config, sel("setBaseForegroundColor:"), c_accent);
        b = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"), config,
            0);
        msg1(b, sel("setShowsMenuAsPrimaryAction:"), 1);
        bi: int = msg(msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
            b), sel("autorelease"));
        msg1(item, sel("setRightBarButtonItem:"), bi)
    }
    for j in 0..ui_commands_n {
        if (j < len(one)) {
            one[j] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
                uk_text(ui_commands[j].title), 0, sel("coreCommand:"), nsnumber_int(k * 64 + j));
            if (ui_commands[j].destructive) msg1(one[j], sel("setAttributes:"), 2)
        }
    }
    msg1(b, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""),
        nsarray(one, ui_commands_n)));
    msg1(b, sel("setEnabled:"), if (ui_commands_n > 0) 1 else 0)
}

// ---- what core says to do ----
// A screen's list, its controller, in a free slot (one whose controller
// has been popped, or let go, is free again).
uk_make(id: int): int {
    k: int = -1;
    for j in 0..UK_SLOTS {
        if (k < 0 && (uk_ids[j] == 0 || uk_vcs[j] == 0 || msg(uk_vcs[j], sel("navigationController")) == 0 && msg(uk_vcs[j],
            sel("presentingViewController")) == 0)) k = j
    }
    if (k < 0) return -1;
    uk_free(k);
    uk_ids[k] = id;
    uk_stale = true;
    _b: bool = uk_ensure(k);
    // (Go To's and Search's controllers are the app's own kinds: Go To opens
    // at its focus and makes its ribbons again as it comes back, Search
    // takes the keys as it appears: ios/sheets.l8.)
    kind: int = uk_kind_of(id);
    c: int = if (kind == SCR_GOTO) books_class else if (kind == SCR_SEARCH) search_class else uk_class;
    vc: int = msg(msg1(msg(c, sel("alloc")), sel("initWithStyle:"), if (ui_plain) 0 else 2),
        sel("autorelease"));
    goto: bool = kind == SCR_GOTO;
    uk_vcs[k] = keep(vc);
    uk_tables[k] = keep(msg(vc, sel("tableView")));
    uk_waits[k] = ui_search_wait;
    uk_seen[k] = false;
    uk_pushed[k] = uk_making_push;
    // (Its field made now, to take the keys as it appears.)
    fi: int = uk_field_row();
    if (fi >= 0) _f: int = uk_field_cell(k, fi);
    msg1(vc, sel("setTitle:"), uk_text(ui_title));
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), if (goto) 0 else 2);
    if (ui_search.n > 0) uk_make_search(k, item);
    msg1(uk_tables[k], sel("setDataSource:"), app_obj);
    msg1(uk_tables[k], sel("setDelegate:"), app_obj);
    style_table(uk_tables[k], !ui_plain);
    table_screens[uk_entry + k].look = (if (ui_plain) TableLook.Plain else TableLook.Grouped);
    if (ui_plain) {
        // (Search's results: full-width rows, headers as tall as they need,
        // and the keyboard dragged down with the rows.)
        t: int = uk_tables[k];
        msg_rect(t, sel("setSeparatorInset:"), 0.0f64, 20.0f64, 0.0f64, 0.0f64);
        msg_set_f(t, sel("setSectionHeaderHeight:"), objc_const_f("UITableViewAutomaticDimension"));
        msg_set_f(t, sel("setEstimatedSectionHeaderHeight:"), 36.0f64);
        msg1(t, sel("setKeyboardDismissMode:"), 1)
    }
    uk_dress(k, false);
    k
}

// Core's screens' controllers (but Go To's and Search's, the app's own
// kinds): each made again as it comes back (from a plan's days, say),
// reloaded whole, which lays out nothing off the window.
uk_class: int = 0;

uk_seen: []bool = new bool[UK_SLOTS](false);

uk_will_appear(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, uk_class, cmd, animated);
    for k in 0..UK_SLOTS {
        if (uk_vcs[k] == self && uk_vcs[k] != 0) {
            if (uk_seen[k]) {
                // (The voices again: one just downloaded in Settings shows.)
                if (uk_kind_of(uk_ids[k]) == SCR_VOICES) voices_read();
                uk_stale = true;
                msg(uk_tables[k], sel("reloadData"));
                uk_dress(k, false)
            } else if (uk_ensure(k) && ui_focus >= 0 && ui_rows[ui_focus].kind == UI_FIELD) {
                // (A field first: the keyboard rising with the screen.)
                if (uk_fields[k] != 0 && !demo_no_keyboard) msg(uk_fields[k], sel("becomeFirstResponder"))
            } else if (uk_ensure(k) && ui_focus >= 0) {
                // (First: at its focus, at the top; selected, in the
                // middle.)
                msg(uk_tables[k], sel("layoutIfNeeded"));
                uk_show_focus_at(uk_tables[k], if (ui_focus_select || ui_focus_middle) 2 else 1,
                    ui_focus_select);
                // (A Manual's part gone to: washed.)
                if (ui_focus_wash) uk_wash(k)
            }
            uk_seen[k] = true;
            nav: int = msg(self, sel("navigationController"));
            if (nav != 0) msg2(nav, sel("setToolbarHidden:animated:"), if (uk_tooled[k]) 0 else 1,
                animated & 255)
        }
    }
    0
}

// (Going: its toolbar hidden, if it had one.)
uk_will_go(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, uk_class, cmd, animated);
    // (Leaving ends the editing, and so keeps a name typed; a preview of a
    // voice stops.)
    msg1(msg(self, sel("view")), sel("endEditing:"), 1);
    for k in 0..UK_SLOTS {
        kind: int = if (uk_vcs[k] == self) uk_kind_of(uk_ids[k]) else 0;
        if (kind == SCR_VOICE || kind == SCR_VOICES) preview_stop()
    }
    for k in 0..UK_SLOTS {
        if (uk_vcs[k] == self && uk_vcs[k] != 0 && uk_tooled[k]) {
            nav: int = msg(self, sel("navigationController"));
            if (nav != 0) msg2(nav, sel("setToolbarHidden:animated:"), 1, animated & 255)
        }
    }
    0
}

// A row of core's screen of kind (its action and argument) tapped, as a
// tap on it would be (the demos').
uk_tap(kind: int, action: int, arg: int) {
    t: int = uk_table_of(kind);
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k)) return;
    for s in 0..ui_sections_n {
        first: int = ui_sections[s].first;
        for r in 0..ui_sections[s].n {
            if (ui_rows[first + r].action == action && ui_rows[first + r].arg == arg) {
                uk_picked(t, s, r);
                return
            }
        }
    }
}

// Whether t is one of core's plain lists (its cells on the page's color).
uk_plain_table(t: int): bool {
    k: int = uk_slot_of(t);
    k >= 0 && table_screens[uk_entry + k].look == TableLook.Plain
}

// The registry's entry of slot 0 (the slots' are in order).
uk_entry: int = 0;

// Slot k's field's rest before what is typed is sent (ms).
uk_waits: []int = new int[UK_SLOTS](0);

// Slot k's search field (as the screen's ui_search says), under its title.
uk_searches: []int = new int[UK_SLOTS](0);

uk_make_search(k: int, item: int) {
    sc: int = msg1(msg(cls("UISearchController"), sel("alloc")), sel("initWithSearchResultsController:"),
        0);
    msg1(sc, sel("setObscuresBackgroundDuringPresentation:"), 0);
    msg1(sc, sel("setHidesNavigationBarDuringPresentation:"), 0);
    msg1(sc, sel("setSearchResultsUpdater:"), app_obj);
    bar: int = msg(sc, sel("searchBar"));
    msg1(bar, sel("setPlaceholder:"), uk_text(ui_search));
    msg1(bar, sel("setAutocorrectionType:"), 1);
    if (ui_search_go) {
        msg1(bar, sel("setAutocapitalizationType:"), 0);
        msg1(bar, sel("setReturnKeyType:"), 1)
    } else {
        // (The sheet has Done: no Cancel button popping in beside the
        // field.)
        msg1(sc, sel("setAutomaticallyShowsCancelButton:"), 0)
    }
    msg1(bar, sel("setDelegate:"), app_obj);
    if (ui_scopes.n > 0) {
        if ((msg1(sc, sel("respondsToSelector:"), sel("setScopeBarActivation:")) & 255) != 0) msg1(sc,
            sel("setScopeBarActivation:"), 1);
        msg1(sc, sel("setAutomaticallyShowsScopeBar:"), 0);
        // (Short titles, so none is cut off; the full names for VoiceOver.)
        n: int = uk_split(ui_scopes, one);
        _l: int = uk_split(ui_scope_labels, uk_labels);
        for i in 0..n {
            title: int = msg(msg1(msg(cls("NSString"), sel("alloc")), sel("initWithString:"),
                one[i]), sel("autorelease"));
            if ((msg1(one[i], sel("isEqualToString:"), uk_labels[i]) & 255) == 0) msg1(title,
                sel("setAccessibilityLabel:"), uk_labels[i]);
            one[i] = title
        }
        msg1(bar, sel("setScopeButtonTitles:"), nsarray(one, n));
        msg1(bar, sel("setSelectedScopeButtonIndex:"), ui_scope);
        msg1(bar, sel("setShowsScopeBar:"), 1)
    }
    if (ui_search_text.n > 0) msg1(bar, sel("setText:"), uk_text(ui_search_text));
    msg1(item, sel("setSearchController:"), sc);
    search_stacked(item);
    msg1(item, sel("setHidesSearchBarWhenScrolling:"), 0);
    uk_searches[k] = sc;
    release(sc)
}

// Words split at | into into (NSStrings): how many (as many as fit).
uk_split(t: UiText, into: []int): int {
    n: int = 0;
    p: int = t.at;
    e: int = t.at + t.n;
    for x in t.at..e + 1 {
        if ((x == e || ui_pool[x] as int == 124) && n < len(into)) {
            into[n] = nsstring_at(bytes_address(ui_pool) + p, x - p);
            n = n + 1;
            p = x + 1
        }
    }
    n
}

uk_labels: []int = new int[8](0);

uk_query_buf: []i8 = new i8[65536](0i8);

// The section of core's screen of kind with header title (the demos'),
// or 0.
uk_section_titled(kind: int, title: str): int {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0 || !uk_ensure(k)) return 0;
    for s in 0..ui_sections_n {
        h: UiText = ui_sections[s].header;
        if (h.n == len(title)) {
            same: bool = true;
            for x in 0..h.n
                if (ui_pool[h.at + x] != title[x]) same = false;
            if (same) return s
        }
    }
    0
}

// The controller of core's screen of kind (the demos'), or 0.
uk_vc_of(kind: int): int {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0) 0 else uk_vcs[k]
}

// The search controller of core's screen of kind (the demos'), or 0.
uk_search_of_kind(kind: int): int {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0) 0 else uk_searches[k]
}

// The slot whose field is sc's (a search controller's), or -1.
uk_slot_of_search(sc: int): int {
    for k in 0..UK_SLOTS
        if (sc != 0 && uk_searches[k] == sc && uk_ids[k] != 0) return k;
    -1
}

uk_slot_of_bar(bar: int): int {
    for k in 0..UK_SLOTS
        if (uk_searches[k] != 0 && uk_ids[k] != 0 && msg(uk_searches[k], sel("searchBar")) == bar) return k;
    -1
}

// What is typed waiting to be sent (its slot, -1: none), and its timer.
uk_pending: int = -1;

uk_timer: int = 0;

// A screen's field typed in (sc, its search controller): core's query, at
// once or as typing rests (the screen's wait; cleared, at once); whether
// it was one of core's.
uk_search_updated(sc: int): bool {
    k: int = uk_slot_of_search(sc);
    if (k < 0) return false;
    uk_timer = stop_timer(uk_timer);
    uk_pending = -1;
    empty: bool = msg(msg(msg(sc, sel("searchBar")), sel("text")), sel("length")) == 0;
    if (uk_waits[k] > 0 && !empty) {
        uk_pending = k;
        uk_timer = after(uk_waits[k] as f64 / 1000.0f64, "coreSearchFire:");
        return true
    }
    uk_search_send(k);
    true
}

uk_search_send(k: int) {
    sc: int = uk_searches[k];
    if (sc == 0 || uk_ids[k] == 0) return;
    n: int = nsstring_into(msg(msg(sc, sel("searchBar")), sel("text")), uk_query_buf);
    uk_sync();
    sk_query(uk_ids[k], uk_query_buf, 0, n);
    uk_effects()
}

uk_search_fire(_self: int, _cmd: int, _timer: int): int {
    uk_timer = 0;
    k: int = uk_pending;
    uk_pending = -1;
    if (k >= 0) uk_search_send(k);
    0
}

// (What waits sent now: Return, or a scope chosen.)
uk_search_flush() {
    if (uk_pending < 0) return;
    uk_timer = stop_timer(uk_timer);
    k: int = uk_pending;
    uk_pending = -1;
    uk_search_send(k)
}

// Return in a screen's field (bar): its first suggestion, core's.
uk_search_return(bar: int): bool {
    k: int = uk_slot_of_bar(bar);
    if (k < 0) return false;
    uk_search_flush();
    uk_sync();
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    sk_submit(uk_ids[k]);
    uk_effects();
    true
}

// A scope chosen in a screen's field (bar).
uk_scope_changed(bar: int, scope: int): bool {
    k: int = uk_slot_of_bar(bar);
    if (k < 0) return false;
    uk_search_flush();
    uk_sync();
    sk_scope_chosen(uk_ids[k], scope);
    uk_effects();
    true
}

// (For the demos: Search's field given q, searched at once; its scope.)
uk_search_for(q: int) {
    k: int = uk_slot_of(uk_table_of(SCR_SEARCH));
    if (k < 0) return;
    msg1(msg(uk_searches[k], sel("searchBar")), sel("setText:"), q);
    uk_timer = stop_timer(uk_timer);
    uk_pending = -1;
    uk_search_send(k)
}

uk_search_scope(scope: int) {
    k: int = uk_slot_of(uk_table_of(SCR_SEARCH));
    if (k < 0) return;
    msg1(msg(uk_searches[k], sel("searchBar")), sel("setSelectedScopeButtonIndex:"),
        scope);
    _s: bool = uk_scope_changed(msg(uk_searches[k], sel("searchBar")), scope)
}

// A list scrolled to its screen's focus (as it is first laid out), in
// the middle.
uk_show_focus(t: int) {
    uk_show_focus_at(t, 2, false)
}

// (At position: 1 the top, 2 the middle; and selected, if select.)
uk_show_focus_at(t: int, position: int, select: bool) {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || ui_focus < 0) return;
    for s in 0..ui_sections_n {
        first: int = ui_sections[s].first;
        if (ui_focus >= first && ui_focus < first + ui_sections[s].n) {
            path: int = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"),
                ui_focus - first, s);
            msg3(t, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), path,
                position, 0);
            if (select) msg3(t, sel("selectRowAtIndexPath:animated:scrollPosition:"),
                path, 0, 0);
            return
        }
    }
}

// The kind of core's screen id (0: not shown).
uk_kind_of(id: int): int {
    i: int = sk_find(id);
    if (i < 0) 0 else sk_kinds[i]
}

uk_free(k: int) {
    uk_tiles_w[k] = 0.0f64;
    uk_searches[k] = 0;
    release(uk_boxes[k]);
    uk_boxes[k] = 0;
    uk_segs[k] = 0;
    uk_fboxes[k] = 0;
    if (uk_fields[k] != 0) msg1(uk_fields[k], sel("setDelegate:"), 0);
    uk_fields[k] = held(uk_fields[k], 0);
    uk_field_lives[k] = false;
    uk_fcells[k] = held(uk_fcells[k], 0);
    uk_swcells[k] = held(uk_swcells[k], 0);
    release(uk_tables[k]);
    release(uk_vcs[k]);
    uk_tables[k] = 0;
    uk_vcs[k] = 0;
    uk_ids[k] = 0
}

// (Run once at a time: what an effect's work asks for is queued, and run
// by the same loop.)
uk_in_effects: bool = false;

uk_effects() {
    if (uk_in_effects) return;
    uk_in_effects = true;
    i: int = 0;
    while (i < ui_effects_n) {
        e: UiEffect = ui_effects[i];
        if (e.word == "push") {
            uk_making_push = true;
            k: int = uk_make(e.a);
            uk_making_push = false;
            sheet: int = if (uk_nav != 0) uk_nav else presented();
            if (k >= 0 && sheet != 0) msg2(sheet, sel("pushViewController:animated:"),
                uk_vcs[k], 1);
            if (uk_kind_of(e.a) == SCR_DOWNLOADS) dl_pump();
            // (The settings' sheet made large for the credits.)
            if (uk_kind_of(e.a) == SCR_ACKNOWLEDGEMENTS && sheet != 0) help_grow(sheet)
        } else if (e.word == "present") {
            // (Compare and Study at their medium detent, in their own
            // form sheet on a wide window.)
            pk: int = uk_kind_of(e.a);
            if (pk == SCR_NEW_RIBBON) sheet_form(540.0f64, 720.0f64);
            if (pk == SCR_NOTE) {
                sheet_form(620.0f64, 640.0f64);
                uk_detents = 1
            }
            if (pk == SCR_COMPARE || pk == SCR_VERSE_STUDY) {
                if (pk == SCR_COMPARE) sheet_form(620.0f64, 760.0f64) else sheet_form(700.0f64,
                    860.0f64);
                uk_detents = 1;
                uk_medium = true
            }
            k: int = uk_make(e.a);
            if (k >= 0) {
                uk_sheet = sheet_of(uk_vcs[k], uk_detents);
                if (uk_kind_of(e.a) == SCR_LIBRARY) {
                    // (For what changes it: memory.l8, learn.l8,
                    // practice.l8's lib_refresh; its toolbar up at once.)
                    lib_table = uk_tables[k];
                    lib_vc = uk_vcs[k];
                    lib_search = uk_searches[k]
                }
                if (uk_tooled[k]) {
                    // (Its toolbar up with it, in the icons' color.)
                    msg2(uk_sheet, sel("setToolbarHidden:animated:"), 0, 0);
                    msg1(msg(uk_sheet, sel("toolbar")), sel("setTintColor:"), c_icon)
                }
                if (uk_medium) {
                    sheet: int = msg(uk_sheet, sel("sheetPresentationController"));
                    if (sheet != 0) msg1(sheet, sel("setSelectedDetentIdentifier:"),
                        objc_const("UISheetPresentationControllerDetentIdentifierMedium"));
                    uk_medium = false
                }
                if (uk_kind_of(e.a) == SCR_SEARCH) {
                    // (For ios/esv.l8's answers, and the cells' colors.)
                    search_table = uk_tables[k];
                    search_vc = uk_vcs[k];
                    search_bar = msg(uk_searches[k], sel("searchBar"))
                }
                if (uk_kind_of(e.a) == SCR_GOTO) {
                    // (Known before it appears: ios/daily.l8's
                    // books_will_appear, ios/ipad.l8's books_did_appear.)
                    picker_table = uk_tables[k];
                    picker_search = uk_searches[k];
                    msg1(msg(uk_sheet, sel("navigationBar")), sel("setPrefersLargeTitles:"),
                        1)
                }
                present(uk_sheet)
            }
            uk_detents = 0
        } else if (e.word == "refill") {
            // (Typed: the rows as they are now, at once; what they are
            // changed (recent searches giving way to results), a
            // cross-fade, not a jump.)
            k: int = uk_slot_of_id(e.a);
            if (k >= 0) {
                if (e.b == 1) fade_layer(msg(uk_tables[k], sel("layer")), 0.2f64);
                uk_stale = true;
                msg(uk_tables[k], sel("reloadData"));
                uk_dress(k, false)
            }
        } else if (e.word == "retext") {
            k: int = uk_slot_of_id(e.a);
            if (k >= 0 && uk_searches[k] != 0 && uk_ensure(k)) msg1(msg(uk_searches[k],
                sel("searchBar")), sel("setText:"), if (ui_search_text.n > 0) uk_text(ui_search_text) else nsstring(""))
        } else if (e.word == "blur") {
            k: int = uk_slot_of_id(e.a);
            if (k >= 0 && uk_searches[k] != 0) msg(msg(uk_searches[k], sel("searchBar")),
                sel("resignFirstResponder"))
        } else if (e.word == "searched") esv_sr_reset() else if (e.word == "esv_search") {
            if (esv_sr_state != 1) esv_search_ask(e.a)
        } else if (e.word == "audio_source") uk_audio_source(e.a, e.b) else if (e.word == "voice") uk_voice_chosen(e.a) else if (e.word == "cellular") set_def_bool("downloadAheadCellular",
            e.a != 0) else if (e.word == "download") {
            s: int = dl_reader();
            if (src_cacheable(s) && dl_index(s, e.a) < 0) {
                haptic_select();
                dl_start(s, e.a)
            }
        } else if (e.word == "download_delete") dl_stop(dl_reader(), e.a) else if (e.word == "refresh") {
            // (What the app has done shown: the screens made again.)
            uk_sync();
            sk_update_all()
        } else if (e.word == "title_menus") title_menus_refresh() else if (e.word == "toast" && e.a == TOAST_RIBBON) ribbon_toast_of(nsstring_of(ui_effect_words,
            ui_effect_words_n), rb_carried_i()) else if (e.word == "toast" && e.a == TOAST_CHECK && do_plan >= 0) {
            // (A day waiting for a sheet to go: its toast with it.)
            release(do_toast);
            do_toast = keep(nsstring_of(ui_effect_words, ui_effect_words_n));
            haptic_impact(0)
        } else if (e.word == "toast") {
            // (Core's toast: its words and symbol.)
            if (e.a == TOAST_CHECK) haptic_success();
            toast_symbol(nsstring_of(ui_effect_words, ui_effect_words_n), toast_symbols[clamp(e.a,
                0, len(toast_symbols) - 1)], 1.6f64);
            fbuf_n = 0;
            fput_str("bible: toast ");
            for x in 0..ui_effect_words_n fput(ui_effect_words[x] as int);
            note_fbuf()
        } else if (e.word == "pins_changed") save_pins() else if (e.word == "mm_fetch") mm_fetch(e.a) else if (e.word == "url") open_web(e.text) else if (e.word == "esv_want") {
            // (The ESV's chapter asked for, for Compare; its answer, ios/
            // esv.l8's, makes Compare again.)
            ensure_text(TEXT_ESV);
            ec_hold_c = e.a;
            if (!esv_held(e.a)) {
                uk_esv_state = ESV_LOADING;
                esv_want(e.a, 1)
            }
        } else if (e.word == "export") _x: int = library_export(0, 0, uk_tool_item) else if (e.word == "note") open_note(e.a,
            e.b / 1000, e.b % 1000) else if (e.word == "passage") mm_open_passage(e.a) else if (e.word == "marked") haptic_select() else if (e.word == "awake") {
            // (Keep Screen On let go, a sheet up; its touches are the
            // reader's own, keep_screen_touched.)
            if (e.a <= 0) keep_screen_release()
        } else if (e.word == "chosen") note_num("bible: begin at book ", ch_book[bg_c]) else if (e.word == "ribbon_added") uk_ribbon_added(e.a) else if (e.word == "ribbon_open") ribbon_open(e.a) else if (e.word == "ribbon_color") {
            // (The bar's glyph, if this is the ribbon carried, cross-fades
            // to it.)
            if (e.a == rb_carried && title_ribbon != 0) {
                if (!reduce_motion()) fade_layer(msg(title_ribbon, sel("layer")),
                    0.2f64);
                title_place()
            }
        } else if (e.word == "remind") {
            // (A reminder's switch: on asks the phone, which answers in
            // auth_tick; off at once.)
            // (Off: core's, at once.)
            if (e.a == 0 && e.b == 1) notify_ask(3) else if (e.a == 0) {
                rm_off(0);
                rm_kept();
                note("bible: memory reminder off");
                uk_refresh()
            } else if (e.a - 1 < fw_n) {
                detail_plan = fw_plan[e.a - 1];
                if (e.b == 1) notify_ask(1) else {
                    rm_off(e.a);
                    rm_kept();
                    uk_refresh()
                }
            }
        } else if (e.word == "remind_time") {
            nt_minutes = rm_time_ok(e.a);
            set_def_int("planReminderMinutes", nt_minutes);
            note_num("bible: reminder time minutes ", nt_minutes);
            daily_reschedule()
        } else if (e.word == "open_settings") {
            app: int = msg(cls("UIApplication"), sel("sharedApplication"));
            url: int = msg1(cls("NSURL"), sel("URLWithString:"), objc_const("UIApplicationOpenSettingsURLString"));
            msg3(app, sel("openURL:options:completionHandler:"), url, nsdictionary(keys,
                values, 0), 0)
        } else if (e.word == "preview") push_preview(e.a) else if (e.word == "study_moved") study_verse_moved(e.a,
            e.b) else if (e.word == "panel") uk_panel_slot = uk_make(e.a) else if (e.word == "present_over") {
            // (Over the sheet up: a note over the Library.)
            if (uk_kind_of(e.a) == SCR_NOTE) sheet_form(620.0f64, 640.0f64);
            k: int = uk_make(e.a);
            over: int = presented();
            if (k >= 0) {
                s2: int = sheet_of(uk_vcs[k], 1);
                if (over != 0) msg3(over, sel("presentViewController:animated:completion:"),
                    s2, 1, 0) else present(s2)
            }
            uk_detents = 0
        } else if (e.word == "close") {
            // (Itself closed: over a sheet, that sheet stays; else the
            // sheets away.)
            k: int = uk_slot_of_id(e.a);
            sn: int = if (k >= 0) msg(uk_vcs[k], sel("navigationController")) else 0;
            under: int = if (sn != 0) msg(sn, sel("presentingViewController")) else 0;
            if (under != 0 && under != nav) msg2(under, sel("dismissViewControllerAnimated:completion:"),
                1, 0) else dismiss_sheets()
        } else if (e.word == "ribbon_toast_of") ribbon_toast_of(nsstring_of(ui_effect_words,
            ui_effect_words_n), e.a) else if (e.word == "ribbon_moved") {
            reading_jumped();
            toast_reading_with(e.a)
        } else if (e.word == "clear_selection") clear_selection() else if (e.word == "highlighted") {
            // (A color on verses: the edit menu's Highlight's next, core's
            // lastHighlight, kept; felt.)
            if (e.a >= 0) uk_app_from_prefs();
            haptic_impact(0)
        } else if (e.word == "bookmarked") {
            if (e.a == 1) haptic_impact(1)
        } else if (e.word == "copy") {
            msg1(msg(cls("UIPasteboard"), sel("generalPasteboard")), sel("setString:"),
                nsstring_of(ui_effect_words, ui_effect_words_n));
            haptic_success();
            toast(w_copied)
        } else if (e.word == "share") share_verses(sel_c, sel_v, sel_n, uk_share_from) else if (e.word == "study_verse") tray_study(e.a,
            e.b) else if (e.word == "memorized") memorized() else if (e.word == "plan_today") day_open_today_of(e.a) else if (e.word == "plan_details") plan_row_details(e.a) else if (e.word == "plan_stopped") {
            // (A day of it up: read on, not marked.)
            if (day_on && dd_plan == e.a) {
                mark_hide(true);
                day_footer_update()
            }
        } else if (e.word == "update" && uk_slot_of_id(e.a) == uk_del_k && uk_del_k >= 0 && uk_deleted(uk_del_k)) {
            // (A row deleted: taken away.)
            uk_del_k = -1
        } else if (e.word == "update") {
            k: int = uk_slot_of_id(e.a);
            if (k >= 0) {
                uk_stale = true;
                fade_layer(msg(uk_tables[k], sel("layer")), 0.15f64);
                msg(uk_tables[k], sel("reloadData"));
                uk_dress(k, true)
            }
        } else if (e.word == "relayout" || e.word == "settings") uk_app_from_prefs() else if (e.word == "open") {
            if (e.a == OPEN_GLOSSES) open_glosses() else if (e.a == OPEN_VOICE) {
                if (text_cur != TEXT_ORIG) open_voice()
            } else if (e.a == OPEN_MANUAL) help_open_manual() else if (e.a == OPEN_ACKNOWLEDGEMENTS) open_acknowledgements() else if (e.a == OPEN_PLAN) open_plan(e.b,
                0) else if (e.a == OPEN_DAY1) open_day1() else if (e.a == OPEN_DAY) day_open(e.b / 1000,
                e.b % 1000, -1)
        } else if (e.word == "listen") _l: int = listen_button_tapped(0, 0, 0) else if (e.word == "goto") {
            // (The app's own jump: the sheet away, the way back shown.)
            jump(e.a, e.b)
        } else if (e.word == "practice_session") {
            // (Core's session, queued: the sheet that shows it.)
            if (e.b == PXS_READING) note_num("bible: learn practise reading, words ",
                e.a);
            px_open(e.a)
        } else if (e.word == "read_in") learn_read_in(e.a, e.b) else if (e.word == "pop_to") {
            k: int = uk_slot_of_id(e.a);
            nav: int = if (k >= 0) msg(uk_vcs[k], sel("navigationController")) else 0;
            if (nav != 0) _p: int = msg2(nav, sel("popToViewController:animated:"),
                uk_vcs[k], 1)
        } else if (e.word == "focus") {
            // (Its focus row shown again, washed: a link to a part of the
            // same page.)
            k: int = uk_slot_of_id(e.a);
            if (k >= 0 && uk_ensure(k) && ui_focus >= 0) {
                uk_stale = true;
                msg(uk_tables[k], sel("reloadData"));
                _e: bool = uk_ensure(k);
                uk_show_focus_at(uk_tables[k], 1, false);
                if (ui_focus_wash) uk_wash(k)
            }
        } else if (e.word == "dismiss") dismiss_sheets() else if (e.word == "pop") {
            // (The navigation the action came from: a sheet's, or Study's
            // beside the text.)
            sheet: int = if (uk_nav != 0) uk_nav else presented();
            if (sheet != 0) _p: int = msg1(sheet, sel("popViewControllerAnimated:"),
                1)
        }
        i = i + 1
    }
    ui_effects_n = 0;
    uk_nav = 0;
    uk_in_effects = false
}

// New Ribbon's Add done: the reader at the ribbon's place, unless it is
// there already (the sheet, or Go To, away); the ribbon picked up, with
// the toast.
uk_ribbon_added(id: int) {
    ribbons_log();
    there: bool = bg_c == cur && (bg_v == place_v || bg_v < 2 && place_v < 2);
    // (Core's: picked up, from here (a jump to it unless it is here), with
    // its toast.)
    origin_here();
    uk_sync();
    here: bool = jp_ribbon(rb_index(id), jp_oc, jp_ov, jp_of, jp_oe);
    rd_after();
    ribbons_log();
    if (there) dismiss_sheets() else ribbon_place_show(jp_to_c, jp_to_v, jp_to_f,
        here)
}

// A version's reader chosen (its tx and source s): kept; listening, heard
// in place; else a preview of it.
uk_audio_source(tx: int, s: int) {
    was: int = audio_source(tx);
    if (s != was) {
        haptic_select();
        set_audio_source(tx, s);
        fbuf_n = 0;
        fput_str("bible: voice ");
        fput_str(text_abbrs[tx]);
        fput_str(" ");
        fput_str(src_ids[s]);
        note_ns(fstring())
    }
    if (ls_active) {
        if (s != was && tx == text_cur) listen_reader_changed()
    } else preview_toggle(s)
}

// The iPhone's voice chosen (i, in the voices' order; -1 Best Available).
uk_voice_chosen(i: int) {
    v: int = if (i < 0 || i >= vo_n) 0 else vo_obj[i];
    haptic_select();
    if (v == 0) msg1(defaults(), sel("removeObjectForKey:"), nsstring("listenVoiceID")) else msg2(defaults(),
        sel("setObject:forKey:"), msg(v, sel("identifier")), nsstring("listenVoiceID"));
    ls_voice = 0;
    if (!ls_active) preview_voice()
}

// The list showing core's screen of kind made again, cross-fading.
uk_update_kind(kind: int) {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0) return;
    uk_stale = true;
    fade_layer(msg(uk_tables[k], sel("layer")), 0.2f64);
    msg(uk_tables[k], sel("reloadData"));
    uk_dress(k, true)
}

// The list showing core's screen of kind made again at once (a download's
// progress).
uk_reload_kind(kind: int) {
    k: int = uk_slot_of(uk_table_of(kind));
    if (k < 0) return;
    uk_stale = true;
    msg(uk_tables[k], sel("reloadData"));
    uk_dress(k, false)
}

// Plan p's days (core's), at day d (selected, select), pushed in nav or
// presented (nav 0).
uk_open_plan(
    p: int,
    d: int,
    select: bool,
    nav: int
) {
    uk_sync();
    uk_nav = nav;
    sk_open_plan(p, d, select, nav != 0);
    uk_effects()
}

// Core's screen of kind and arg shown: pushed in nav (0: the sheet up),
// or presented as a sheet of its own.
uk_open(
    kind: int,
    arg: int,
    push: bool,
    nav: int
) {
    uk_sync();
    uk_nav = nav;
    // (Pushed over the screen the navigation shows: those core had over
    // it, popped, let go.)
    if (push && nav != 0) {
        top: int = msg(nav, sel("topViewController"));
        for k in 0..UK_SLOTS {
            i: int = if (uk_vcs[k] == top && top != 0) sk_find(uk_ids[k]) else -1;
            if (i >= 0) sk_closing(i + 1)
        }
    }
    sk_open(kind, arg, push);
    uk_effects()
}

// What core's screens say changed (the ESV listed, a version loaded): each
// shown made again.
uk_refresh() {
    uk_sync();
    sk_update_all();
    uk_effects()
}

// The list showing core's screen of kind (the top one), or 0.
uk_table_of(kind: int): int {
    for k in 0..UK_SLOTS {
        i: int = sk_find(uk_ids[k]);
        if (uk_ids[k] != 0 && i >= 0 && sk_kinds[i] == kind) return uk_tables[k]
    }
    0
}

// The button at the top of core's screen of kind (History's Clear), or 0.
uk_button_of(kind: int): int {
    t: int = uk_table_of(kind);
    k: int = uk_slot_of(t);
    if (k < 0) return 0;
    item: int = msg(msg(uk_vcs[k], sel("navigationItem")), sel("rightBarButtonItem"));
    if (item == 0) 0 else msg(item, sel("customView"))
}

add_skin_methods(app: int) {
    add_method1(app, sel("coreCommand:"), &uk_command, "v@:@");
    add_method1(app, sel("coreToggle:"), &uk_toggled, "v@:@");
    add_method1(app, sel("coreChoice:"), &uk_chose, "v@:@");
    add_method1(app, sel("coreTime:"), &uk_time_chosen, "v@:@");
    add_method1(app, sel("coreSectionButton:"), &uk_section_button, "v@:@");
    add_method1(app, sel("coreSearchFire:"), &uk_search_fire, "v@:@");
    add_method1(app, sel("coreCircle:"), &uk_circle, "v@:@");
    add_method1(app, sel("coreCircleAction:"), &uk_circle_action, "B@:@");
    add_method1(app, sel("coreTool:"), &uk_tool, "v@:@");
    add_method1(app, sel("coreConfirm:"), &uk_confirm_tapped, "v@:@");
    add_method1(app, sel("coreFieldTyped:"), &uk_field_typed, "v@:@");
    add_method1(app, sel("coreSegment:"), &uk_segment_chosen, "v@:@");
    add_method1(app, sel("coreFilter:"), &uk_filter_tapped, "v@:@");
    add_method1(app, sel("coreSort:"), &uk_sort_chosen, "v@:@");
    add_method1(app, sel("coreRowAction:"), &uk_row_action, "B@:@");
    add_method1(app, sel("coreRowMenu:"), &uk_row_menu, "B@:@");
    add_method1(app, sel("coreToolMenu:"), &uk_tool_menu_chosen, "v@:@");
    add_method1(app, sel("coreGridCell:"), &uk_grid_tapped, "v@:@");
    add_method1(app, sel("corePageTapped:"), &uk_page_tapped, "v@:@");
    add_method1(app, sel("coreTile:"), &uk_tile_tapped, "v@:@");
    add_method1(app, sel("coreLeft:"), &uk_left_tapped, "v@:@");
    add_method1(app, sel("coreGridButton:"), &uk_grid_button, "v@:@");
    add_method1(app, sel("textViewDidEndEditing:"), &uk_prose_ended, "v@:@");
    add_method1(app, sel("coreTileAction:"), &uk_tile_action, "B@:@");
    add_method1(app, sel("coreToolSegment:"), &uk_tool_segment, "v@:@");
    add_method1(app, sel("corePageLinkAction:"), &uk_page_link_action, "B@:@")
}

// The sheets gone: their lists let go, and core's screens with them.
uk_gone() {
    // (Not the panel's: it stays as sheets come and go.)
    for k in 0..UK_SLOTS {
        i: int = sk_find(uk_ids[k]);
        if (i < 0 || sk_groups[i] == 0) uk_free(k)
    }
    uk_timer = stop_timer(uk_timer);
    uk_pending = -1;
    // (What Search searched for kept first among the recent searches.)
    sk_close_group(0);
    uk_stale = true
}

uk_screens() {
    uk_class = objc_allocateClassPair(cls("UITableViewController"), "L8CoreList",
        0);
    add_method1(uk_class, sel("viewWillAppear:"), &uk_will_appear, "v@:B");
    add_method1(uk_class, sel("viewWillDisappear:"), &uk_will_go, "v@:B");
    add_method0(uk_class, sel("viewDidLayoutSubviews"), &uk_layout, "v@:");
    objc_registerClassPair(uk_class);
    uk_entry = table_screens_n;
    for k in 0..UK_SLOTS {
        s: TableScreen = table_screen(&uk_tables[k], &uk_sections, &uk_rows, &uk_cell);
        s.picked = &uk_picked;
        s.header = &uk_header;
        s.footer = &uk_footer;
        s.header_view = &uk_header_view;
        s.footer_view = &uk_footer_view;
        s.can_edit = &uk_can_edit;
        s.commit = &uk_commit;
        s.delete_title = &uk_delete_title;
        s.accessory = &uk_accessory;
        s.look = TableLook.Grouped;
        table_add(s)
    }
    on_sheet_gone(&uk_gone)
}
