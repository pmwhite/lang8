}

// A field of many lines (a note's): its words in a text view that grows
// with them, a placeholder over it while it is empty; its words to core as
// its editing ends.
uk_prose_cell(t: int, k: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    if (uk_fcells[k] == 0) {
        cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
            0, 0), sel("autorelease"));
        msg1(cell, sel("setSelectionStyle:"), 0);
        msg1(cell, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
        msg_rect(cell, sel("setSeparatorInset:"), 0.0f64, 10000.0f64, 0.0f64, 0.0f64);
        tv: int = msg(make("UITextView"), sel("autorelease"));
        msg1(tv, sel("setScrollEnabled:"), 0);
        msg1(tv, sel("setFont:"), body(em));
        msg1(tv, sel("setTextColor:"), c_ink);
        msg1(tv, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
        msg1(tv, sel("setTintColor:"), c_accent);
        msg_rect(tv, sel("setTextContainerInset:"), 12.0f64, 20.0f64, 20.0f64, 20.0f64);
        msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
        msg1(tv, sel("setDelegate:"), app_obj);
        msg1(tv, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        content: int = msg(cell, sel("contentView"));
        msg1(content, sel("addSubview:"), tv);
        for edge in ["leadingAnchor", "trailingAnchor", "topAnchor", "bottomAnchor"] pin(tv,
            content, edge);
        pin_min_height(tv, 200.0f64);
        ph: int = msg(make("UILabel"), sel("autorelease"));
        msg1(ph, sel("setFont:"), body(em));
        msg1(ph, sel("setTextColor:"), c_faint);
        msg1(ph, sel("setTag:"), 9400);
        msg1(ph, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(tv, sel("addSubview:"), ph);
        pin_to(ph, "topAnchor", tv, "topAnchor", 12.0f64);
        pin_to(ph, "leadingAnchor", tv, "leadingAnchor", 20.0f64);
        uk_fcells[k] = held(0, cell);
        uk_fields[k] = held(0, tv);
        if (row.detail.n > 0) msg1(tv, sel("setText:"), uk_text(row.detail))
    }
    tv: int = uk_fields[k];
    ph: int = msg1(tv, sel("viewWithTag:"), 9400);
    if (ph != 0) {
        msg1(ph, sel("setText:"), uk_text(row.title));
        msg1(ph, sel("setHidden:"), if (msg(msg(tv, sel("text")), sel("length")) > 0) 1 else 0)
    }
    uk_fcells[k]
}

// A text view typed in (core's field of many lines): its placeholder, its
// list's row grown with it. True if it was core's.
uk_prose_changed(tv: int): bool {
    k: int = uk_slot_of_field(tv);
    if (k < 0) return false;
    ph: int = msg1(tv, sel("viewWithTag:"), 9400);
    if (ph != 0) msg1(ph, sel("setHidden:"), if (msg(msg(tv, sel("text")), sel("length")) > 0) 1 else 0);
    t: int = uk_tables[k];
    if (t != 0) {
        msg1(cls("UIView"), sel("setAnimationsEnabled:"), 0);
        msg(t, sel("beginUpdates"));
        msg(t, sel("endUpdates"));
        msg1(cls("UIView"), sel("setAnimationsEnabled:"), 1)
    }
    true
}

uk_prose_ended(_self: int, _cmd: int, tv: int): int {
    _e: bool = uk_field_end(tv);
    0
}

// The button tapped at the foot (a share's popover points at it).
uk_tool_item: int = 0;

// Slot k's toolbar: those at the left, then (spaced) those in the middle,
// then those at the right. Each tagged k * 16 + its index.
uk_bar_items: []int = new int[16](0);

uk_toolbar(k: int, vc: int, fade: bool) {
    n: int = 0;
    icons: bool = false;
    centers: int = 0;
    rights: int = 0;
    for j in 0..uk_ui.tools_n {
        if (uk_ui.tools[j].place == 1) centers = centers + 1;
        if (uk_ui.tools[j].place == 2) rights = rights + 1
    }
    for place in 0..3 {
        if (place == 1 && centers > 0 || place == 2 && centers == 0 && rights > 0) n = uk_bar_flex(n);
        if (place == 2 && centers > 0 && rights > 0) n = uk_bar_flex(n);
        for j in 0..uk_ui.tools_n {
            tool: UiTool = uk_ui.tools[j];
            if (tool.place == place && n < len(uk_bar_items)) {
                item: int = 0;
                if (tool.style == UI_TOOL_SEGMENTS) {
                    // (Segments: the interlinear's order.)
                    m: int = 0;
                    chosen: int = 0;
                    while (m < 8 && uk_menu_item(tool.menu, m)) {
                        if (uk_mi_arg == tool.arg) chosen = m;
                        one[m] = nsstring_at(bytes_address(uk_ui.pool) + uk_mi_b,
                            uk_mi_e - uk_mi_b);
                        m = m + 1
                    }
                    seg: int = msg(msg1(msg(cls("UISegmentedControl"), sel("alloc")),
                        sel("initWithItems:"), nsarray(one, m)), sel("autorelease"));
                    msg1(seg, sel("setSelectedSegmentIndex:"), chosen);
                    msg1(seg, sel("setTag:"), k * 16 + j);
                    msg3(seg, sel("addTarget:action:forControlEvents:"), app_obj,
                        sel("coreToolSegment:"), 4096);
                    msg_rect(seg, sel("setFrame:"), 0.0f64, 0.0f64, 240.0f64, 32.0f64);
                    item = msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
                        seg)
                } else if (tool.title.n > 0) item = msg4(msg(cls("UIBarButtonItem"),
                    sel("alloc")), sel("initWithTitle:style:target:action:"), uk_text(tool.title),
                    if (tool.style == UI_TOOL_PROMINENT) 2 else 0, app_obj, sel("coreTool:")) else {
                    item = msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
                        msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
                        uk_text(tool.icon), msg_f1(cls("UIImageSymbolConfiguration"),
                        sel("configurationWithPointSize:weight:"), 17.0f64, 4)), 0,
                        app_obj, sel("coreTool:"));
                    icons = true
                }
                msg(item, sel("autorelease"));
                msg1(item, sel("setTag:"), k * 16 + j);
                // (A menu instead, I Know These': its items do the action.)
                if (tool.menu.n > 0) {
                    msg1(item, sel("setTarget:"), 0);
                    msg1(item, sel("setAction:"), 0);
                    msg1(item, sel("setMenu:"), uk_tool_menu(k, j))
                }
                if (tool.label.n > 0) msg1(item, sel("setAccessibilityLabel:"), uk_text(tool.label));
                if (tool.style == UI_TOOL_DESTRUCTIVE) msg1(item, sel("setTintColor:"),
                    msg(cls("UIColor"), sel("systemRedColor")));
                if (tool.style == UI_TOOL_OFF) msg1(item, sel("setEnabled:"), 0);
                uk_bar_items[n] = item;
                n = n + 1
            }
        }
        if (place == 1 && centers > 0 && rights == 0) n = uk_bar_flex(n)
    }
    msg2(vc, sel("setToolbarItems:animated:"), nsarray(uk_bar_items, n), if (fade) 1 else 0);
    // (Icons in the icons' color, as the bar's.)
    nav: int = msg(vc, sel("navigationController"));
    if (icons && nav != 0) msg1(msg(nav, sel("toolbar")), sel("setTintColor:"), c_icon)
}

uk_bar_flex(n: int): int {
    if (n >= len(uk_bar_items)) return n;
    uk_bar_items[n] = msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        5, 0, 0), sel("autorelease"));
    n + 1
}

// ---- segments and a color filter, as a list's header (the Library's):
// the segments on a row of their own, the width of the list, and under
// them the filter, All then a circle each color. One box a slot, kept
// while it is shown ----
uk_boxes: []int = new int[UK_SLOTS](0);

uk_segs: []int = new int[UK_SLOTS](0);

uk_fboxes: []int = new int[UK_SLOTS](0);

UK_SEG_ROW: f64 = 48.0f64;

uk_header_box(k: int, fade: bool) {
    t: int = uk_tables[k];
    W: f64 = view_width(t);
    if (uk_boxes[k] == 0) {
        box: int = make("UIView");
        msg_rect(box, sel("setFrame:"), 0.0f64, 0.0f64, W, UK_SEG_ROW);
        n: int = uk_split(uk_ui.segments, one);
        seg: int = msg(msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
            nsarray(one, n)), sel("autorelease"));
        msg1(seg, sel("setTag:"), k);
        msg3(seg, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreSegment:"),
            4096);
        // (Pinned to the box's sides: the list's width is not yet known
        // when the sheet is made.)
        msg1(seg, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(box, sel("addSubview:"), seg);
        pin_by(seg, box, "leadingAnchor", 16.0f64);
        pin_by(seg, box, "trailingAnchor", -16.0f64);
        pin_by(seg, box, "topAnchor", 6.0f64);
        pin_size(seg, "heightAnchor", 32.0f64);
        uk_boxes[k] = box;
        uk_segs[k] = seg
    }
    msg1(uk_segs[k], sel("setSelectedSegmentIndex:"), uk_ui.segment);
    if (uk_fboxes[k] != 0) {
        msg(uk_fboxes[k], sel("removeFromSuperview"));
        uk_fboxes[k] = 0
    }
    h: f64 = UK_SEG_ROW;
    if (uk_ui.filter_colors.n > 0) {
        f: int = uk_filter_row(k, W);
        msg_rect(f, sel("setFrame:"), 0.0f64, UK_SEG_ROW - 4.0f64, W, 52.0f64);
        msg1(f, sel("setAutoresizingMask:"), 2);
        msg1(uk_boxes[k], sel("addSubview:"), f);
        if (fade) fade_layer(msg(f, sel("layer")), 0.15f64);
        uk_fboxes[k] = f;
        h = UK_SEG_ROW + 48.0f64
    }
    if (uk_ui.intro.n > 0) {
        f: int = uk_intro_view(if (W < 1.0f64) 375.0f64 else W, uk_text(uk_ui.intro));
        l8_msg_hfa(hfa, f, sel("frame"), 0, 0, 0);
        fh: f64 = hfa[3] - 14.0f64;
        msg_rect(f, sel("setFrame:"), 0.0f64, h - 14.0f64, W, fh);
        msg1(f, sel("setAutoresizingMask:"), 2);
        msg1(uk_boxes[k], sel("addSubview:"), f);
        if (uk_fboxes[k] == 0) uk_fboxes[k] = f;
        h = h - 14.0f64 + fh
    }
    msg_rect(uk_boxes[k], sel("setFrame:"), 0.0f64, 0.0f64, W, h);
    msg1(t, sel("setTableHeaderView:"), uk_boxes[k])
}

// The filter: All (filled in the accent when chosen), then each color's
// circle (ringed and checked when chosen). Tags: -1 All, else the color.
uk_filter_row(k: int, W: f64): int {
    box: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, W, 52.0f64), sel("autorelease"));
    row: int = stack(0, 12.0f64);
    msg1(row, sel("setAlignment:"), 3);
    all: bool = uk_ui.filter < 0;
    config: int = msg(cls("UIButtonConfiguration"), sel(if (all) "filledButtonConfiguration" else "grayButtonConfiguration"));
    if (all) {
        msg1(config, sel("setBaseBackgroundColor:"), c_accent);
        msg1(config, sel("setBaseForegroundColor:"), on_accent())
    }
    msg1(config, sel("setCornerStyle:"), 4);
    msg1(config, sel("setTitle:"), nsstring(w_all));
    b0: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(b0, sel("setTag:"), -1);
    msg3(b0, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreFilter:"),
        64);
    msg1(b0, sel("setAccessibilityLabel:"), nsstring(w_show_all));
    msg1(b0, sel("setAccessibilityTraits:"), if (all) 9 else 1);
    msg1(row, sel("addArrangedSubview:"), b0);
    uk_filter_k = k;
    n: int = uk_split(uk_ui.filter_colors, one);
    _l: int = uk_split(uk_ui.filter_labels, uk_labels);
    for i in 0..n {
        on: bool = uk_ui.filter == i;
        ring: int = make("UIView");
        msg1(ring, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        pin_size(ring, "widthAnchor", 36.0f64);
        pin_size(ring, "heightAnchor", 36.0f64);
        rl: int = msg(ring, sel("layer"));
        msg_set_f(rl, sel("setCornerRadius:"), 18.0f64);
        msg_set_f(rl, sel("setBorderWidth:"), 2.0f64);
        msg1(rl, sel("setBorderColor:"), msg(if (on) c_accent else msg(cls("UIColor"),
            sel("clearColor")), sel("CGColor")));
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(b, sel("setTag:"), i);
        n_hex: int = nsstring_into(one[i], uk_query_buf);
        msg1(b, sel("setBackgroundColor:"), uk_hex_color(n_hex));
        msg_set_f(msg(b, sel("layer")), sel("setCornerRadius:"), 14.0f64);
        msg1(b, sel("setAccessibilityLabel:"), uk_labels[i]);
        msg1(b, sel("setAccessibilityTraits:"), if (on) 9 else 1);
        if (on) msg2(b, sel("setImage:forState:"), symbol("checkmark", 11.0f64, 7,
            msg(cls("UIColor"), sel("whiteColor"))), 0);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreFilter:"),
            64);
        msg1(ring, sel("addSubview:"), b);
        pin_size(b, "widthAnchor", 28.0f64);
        pin_size(b, "heightAnchor", 28.0f64);
        pin_to(b, "centerXAnchor", ring, "centerXAnchor", 0.0f64);
        pin_to(b, "centerYAnchor", ring, "centerYAnchor", 0.0f64);
        msg1(row, sel("addArrangedSubview:"), ring);
        release(ring)
    }
    msg1(box, sel("addSubview:"), row);
    pin_by(row, box, "leadingAnchor", 16.0f64);
    pin_to(row, "centerYAnchor", box, "centerYAnchor", 0.0f64);
    box
}

uk_filter_k: int = -1;

// (The hex in uk_query_buf's first n bytes, as a color.)
uk_hex_color(n: int): int {
    v: int = 0;
    for i in 0..n {
        c: int = uk_query_buf[i] as int;
        d: int = if (c >= 48 && c <= 57) c - 48 else if (c >= 65 && c <= 70) c - 55 else if (c >= 97 && c <= 102) c - 87 else 0;
        v = v * 16 + d
    }
    msg_rect(cls("UIColor"), sel("colorWithRed:green:blue:alpha:"), (v / 65536 % 256) as f64 / 255.0f64,
        (v / 256 % 256) as f64 / 255.0f64, (v % 256) as f64 / 255.0f64, 1.0f64)
}

uk_segment_chosen(_self: int, _cmd: int, seg: int): int {
    k: int = msg(seg, sel("tag"));
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return 0;
    action: int = uk_ui.segments_action;
    uk_wire_act(uk_ids[k], action, 0, msg(seg, sel("selectedSegmentIndex")));
    uk_effects();
    0
}

uk_filter_tapped(_self: int, _cmd: int, b: int): int {
    k: int = uk_filter_k;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return 0;
    action: int = uk_ui.filter_action;
    haptic_select();
    uk_wire_act(uk_ids[k], action, 0, msg(b, sel("tag")));
    uk_effects();
    0
}

// The sort menu, at the top left (the system's "Sort By": its commands
// answered by the app, the one in force checked).
// The sort button let go (a screen no longer sorted: Library's segment
// with nothing in it).
uk_sort_button_gone(k: int) {
    item: int = msg(uk_vcs[k], sel("navigationItem"));
    old: int = msg(item, sel("leftBarButtonItem"));
    b: int = if (old != 0) msg(old, sel("customView")) else 0;
    if (b != 0 && (msg1(msg(b, sel("accessibilityLabel")), sel("isEqualToString:"),
        nsstring(w_sort)) & 255) != 0) msg1(item, sel("setLeftBarButtonItem:"), 0)
}

uk_sort_button(k: int) {
    item: int = msg(uk_vcs[k], sel("navigationItem"));
    old: int = msg(item, sel("leftBarButtonItem"));
    b: int = if (old != 0) msg(old, sel("customView")) else 0;
    if (b == 0) {
        config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
        msg1(config, sel("setImage:"), symbol("arrow.up.arrow.down", 17.0f64, 4, 0));
        b = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"), config,
            0);
        msg1(b, sel("setShowsMenuAsPrimaryAction:"), 1);
        msg1(b, sel("setAccessibilityLabel:"), nsstring(w_sort));
        bi: int = msg(msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
            b), sel("autorelease"));
        msg1(item, sel("setLeftBarButtonItem:"), bi)
    }
    n: int = uk_split(uk_ui.sorts, uk_labels);
    for i in 0..n {
        one[i] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
            uk_labels[i], 0, sel("coreSort:"), nsnumber_int(k * 16 + i));
        msg1(one[i], sel("setState:"), if (i == uk_ui.sort) 1 else 0)
    }
    msg1(b, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring("Sort By"),
        nsarray(one, n)))
}

uk_sort_chosen(_self: int, _cmd: int, command: int): int {
    n: int = msg(msg(command, sel("propertyList")), sel("integerValue"));
    k: int = n / 16;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return 0;
    action: int = uk_ui.sort_action;
    uk_wire_act(uk_ids[k], action, 0, n % 16);
    uk_effects();
    0
}

// Whether slot k's screen has a button at its foot (its toolbar shown
// while it is).
uk_tooled: []bool = new bool[UK_SLOTS](false);

// ---- fields and swatches: a cell each kept for the screen's while it is
// up (a field keeps the keys through a reload; the swatches' check moves
// with a fade) ----
uk_fcells: []int = new int[UK_SLOTS](0);

uk_fields: []int = new int[UK_SLOTS](0);

uk_swcells: []int = new int[UK_SLOTS](0);

// Slot k's field (row i): the app's field cell, its placeholder faint, its
// words as core has them (unless being typed in).
uk_field_cell(k: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    if (uk_fcells[k] == 0) {
        field_cell(field_pair);
        uk_fcells[k] = held(0, field_pair[0]);
        uk_fields[k] = held(0, field_pair[1])
    }
    f: int = uk_fields[k];
    if (row.field_live && !uk_field_lives[k]) {
        // (Its words to core as they are typed.)
        msg3(f, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreFieldTyped:"),
            131072);
        uk_field_lives[k] = true
    }
    if (row.field_kind == 1) {
        msg1(f, sel("setAutocapitalizationType:"), 2);
        msg1(f, sel("setAutocorrectionType:"), 1)
    }
    keys[0] = k_color;
    values[0] = c_faint;
    msg1(f, sel("setAttributedPlaceholder:"), if (row.title.n > 0) attributed_str(uk_text(row.title),
        nsdictionary(keys, values, 1)) else 0);
    if ((msg(f, sel("isFirstResponder")) & 255) == 0) msg1(f, sel("setText:"), if (row.detail.n > 0) uk_text(row.detail) else nsstring(""));
    if (row.label.n > 0) msg1(f, sel("setAccessibilityLabel:"), uk_text(row.label));
    uk_fcells[k]
}

uk_field_lives: []bool = new bool[UK_SLOTS](false);

uk_field_typed(_self: int, _cmd: int, f: int): int {
    k: int = uk_slot_of_field(f);
    if (k >= 0) uk_field_commit(k);
    0
}

// The slot whose field f is (-1: none of core's).
uk_slot_of_field(f: int): int {
    for k in 0..UK_SLOTS
        if (f != 0 && uk_fields[k] == f && uk_ids[k] != 0) return k;
    -1
}

// Slot k's field row (of the screen just ensured), or -1.
uk_field_row(): int {
    for i in 0..uk_ui.rows_n
        if (uk_ui.rows[i].kind == UI_FIELD) return i;
    -1
}

// Slot k's field's words given to core (its row's action).
uk_field_commit(k: int) {
    if (k < 0 || uk_fields[k] == 0 || !uk_ensure(k)) return;
    i: int = uk_field_row();
    if (i < 0) return;
    action: int = uk_ui.rows[i].action;
    arg: int = uk_ui.rows[i].arg;
    n: int = nsstring_into(msg(uk_fields[k], sel("text")), uk_query_buf);
    uk_wire_text(uk_ids[k], action, arg, uk_query_buf, 0, n);
    uk_effects()
}

// A field's editing ended (its words to core); whether it was core's.
uk_field_end(f: int): bool {
    k: int = uk_slot_of_field(f);
    if (k < 0) return false;
    uk_field_commit(k);
    true
}

// A field's Return: the screen's confirm (New Ribbon's Add), or the
// editing ended; whether it was core's.
uk_field_return(f: int): bool {
    k: int = uk_slot_of_field(f);
    if (k < 0) return false;
    i: int = if (uk_ensure(k)) uk_field_row() else -1;
    if (i >= 0 && uk_ui.rows[i].field_go) uk_confirm(k) else msg(f, sel("resignFirstResponder"));
    true
}

// The theme changed: the kept cells in it (their backgrounds, a field's
// words, the swatches' colors).
uk_restyle_kept() {
    for k in 0..UK_SLOTS {
        for c in [uk_fcells[k], uk_swcells[k]] {
            if (c != 0) msg1(c, sel("setBackgroundColor:"), cell_bg())
        }
        if (uk_fields[k] != 0) msg1(uk_fields[k], sel("setTextColor:"), c_ink);
        if (uk_swcells[k] != 0 && uk_ensure(k)) {
            for i in 0..uk_ui.rows_n
                if (uk_ui.rows[i].custom == CUSTOM_SWATCHES) swatches_set(swatch_stack(uk_swcells[k],
                    10 + k), uk_ui.rows[i])
        }
    }
}

// Slot k's swatches (row i): the app's swatch cell (its owner 10 + k), the
// one chosen checked.
uk_swatch_cell(k: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    if (uk_swcells[k] == 0) uk_swcells[k] = held(0, swatch_cell(10 + k, row)) else swatches_set(swatch_stack(uk_swcells[k],
        10 + k), row);
    uk_swcells[k]
}

// A swatch of slot k's tapped (color c): its row's action, core's.
uk_swatch_tapped(k: int, c: int) {
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return;
    for i in 0..uk_ui.rows_n {
        if (uk_ui.rows[i].custom == CUSTOM_SWATCHES) {
            action: int = uk_ui.rows[i].action;
            arg: int = uk_ui.rows[i].arg;
            uk_wire_act(uk_ids[k], action, arg, c);
            uk_effects();
            return
        }
    }
}

// The screen's confirm (its button, or its field's Return): the field's
// words given first, the keyboard put away.
uk_confirm(k: int) {
    if (k < 0 || k >= UK_SLOTS || uk_ids[k] == 0) return;
    uk_field_commit(k);
    if (uk_fields[k] != 0) msg(uk_fields[k], sel("resignFirstResponder"));
    if (!uk_ensure(k)) return;
    action: int = uk_ui.confirm_action;
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    uk_wire_act(uk_ids[k], action, 0, 0);
    uk_effects()
}

uk_confirm_tapped(_self: int, _cmd: int, item: int): int {
    uk_confirm(msg(item, sel("tag")));
    0
}

// Whether slot k's screen was pushed (else presented: Cancel beside its
// confirm).
uk_pushed: []bool = new bool[UK_SLOTS](false);

uk_making_push: bool = false;

// A verse found: its reference small, in the accent; its words as the
// reader's, the matches in full ink, bold and washed, the rest softer, up
// to four lines.
uk_hit_cell(t: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    cell: int = list_cell(t, "hit", 2);
    config: int = list_config(2);
    keys[0] = k_font;
    values[0] = sans(13.0f64, 0.3f64);
    keys[1] = k_color;
    values[1] = c_accent;
    a: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        uk_text(row.title), nsdictionary(keys, values, 2)), sel("autorelease"));
    // (" · not translated", faint.)
    if (row.suffix.n > 0) append(a, uk_text(row.suffix), sans(13.0f64, 0.0f64), c_faint);
    msg1(config, sel("setAttributedText:"), a);
    msg1(config, sel("setSecondaryAttributedText:"), uk_hit_text(i));
    // (A verse in its own script whole: Verses You Can Read's.)
    msg1(detail_props(config), sel("setNumberOfLines:"), if (row.runs_n > 0) 0 else if (row.lines > 0) row.lines else 4);
    msg1(detail_props(config), sel("setLineBreakMode:"), 4);
    msg_set_f(config, sel("setTextToSecondaryTextVerticalPadding:"), 3.0f64);
    msg_rect(config, sel("setDirectionalLayoutMargins:"), 12.0f64, 20.0f64, 12.0f64,
        20.0f64);
    msg1(cell, sel("setContentConfiguration:"), config);
    cell
}

// Row i's words with its marks stressed (the original's in its fonts, the
// Hebrew right to left).
uk_hit_text(i: int): int {
    row: UiRow = uk_ui.rows[i];
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    size: f64 = msg_f_f(metrics, sel("scaledValueForValue:"), 16.0f64);
    // (In its script, if its runs or its value say.)
    script: int = if (row.runs_n > 0) uk_ui.runs[row.runs + 1] else 0;
    hebrew: bool = script == RUN_HEBREW || row.value == HIT_HEBREW;
    orig: bool = hebrew || script == RUN_GREEK || row.value == HIT_GREEK;
    keys[0] = k_font;
    values[0] = (if (hebrew) sans(size * 1.15f64, 0.0f64) else if (orig) new_york(size) else body(size));
    keys[1] = k_color;
    values[1] = msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64);
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, if (hebrew) 1.4f64 else 1.25f64),
        sel("autorelease"));
    msg1(values[2], sel("setLineBreakMode:"), 4);
    if (hebrew) {
        msg1(values[2], sel("setBaseWritingDirection:"), 1);
        msg1(values[2], sel("setAlignment:"), 4)
    }
    text: int = uk_text(row.detail);
    if (text == 0) text = nsstring("");
    s: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, nsdictionary(keys, values, 3)), sel("autorelease"));
    if (!orig) row_caps_into(s, row, true, size);
    bold_font: int = if (hebrew) sans(size * 1.15f64, 0.4f64) else if (orig) new_york_bold(size) else bold(size);
    for m in 0..row.marks_n {
        b: int = uk_ui.marks[row.marks + m * 2];
        n: int = uk_ui.marks[row.marks + m * 2 + 1] - b;
        msg4(s, sel("addAttribute:value:range:"), k_font, bold_font, b, n);
        msg4(s, sel("addAttribute:value:range:"), k_color, c_ink, b, n);
        // (Hebrew semibold only: a background is drawn in pieces round its
        // points, run 39573776932's 289.)
        if (!hebrew) msg4(s, sel("addAttribute:value:range:"), k_background, c_sel,
            b, n)
    }
    s
}

// A section's header with a button (Recent Searches' Clear): its title,
// and the button, doing its action. The button's tag says its slot and
// section: k * 64 + s.
uk_header_view(t: int, s: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= uk_ui.sections_n) return 0;
    if (uk_ui.sections[s].columns.n > 0) return uk_columns_header(t, s);
    if (uk_ui.sections[s].button.n == 0 && uk_ui.sections[s].header_suffix.n > 0) return uk_suffix_header(s);
    if (uk_ui.sections[s].button.n == 0) return 0;
    v: int = msg(make("UIView"), sel("autorelease"));
    label: int = make("UILabel");
    msg1(label, sel("setText:"), uk_text(uk_ui.sections[s].header));
    msg1(label, sel("setFont:"), sans(15.0f64, 0.4f64));
    msg1(label, sel("setTextColor:"), c_ink);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), label);
    release(label);
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setTitle:"), uk_text(uk_ui.sections[s].button));
    msg1(config, sel("setBaseForegroundColor:"), c_accent);
    b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(b, sel("setTag:"), k * 64 + s);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreSectionButton:"),
        64);
    msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), b);
    pin_by(label, v, "leadingAnchor", 20.0f64);
    pin_by(label, v, "topAnchor", 14.0f64);
    pin_by(label, v, "bottomAnchor", -6.0f64);
    pin_by(b, v, "trailingAnchor", -8.0f64);
    pin_to(b, "centerYAnchor", label, "centerYAnchor", 0.0f64);
    msg1(v, sel("setBackgroundColor:"), c_bg);
    v
}

// A header with faint words after it (Compare's " · Reading"), wrapping at
// the largest sizes.
uk_suffix_header(s: int): int {
    v: int = msg(make("UIView"), sel("autorelease"));
    label: int = make("UILabel");
    msg1(label, sel("setNumberOfLines:"), 0);
    keys[0] = k_font;
    values[0] = msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleFootnote"));
    keys[1] = k_color;
    values[1] = msg(cls("UIColor"), sel("secondaryLabelColor"));
    s1: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    if (uk_ui.sections[s].header.n > 0) msg1(s1, sel("appendAttributedString:"), attributed_str(uk_text(uk_ui.sections[s].header),
        nsdictionary(keys, values, 2)));
    values[1] = c_faint;
    msg1(s1, sel("appendAttributedString:"), attributed_str(uk_text(uk_ui.sections[s].header_suffix),
        nsdictionary(keys, values, 2)));
    msg1(label, sel("setAttributedText:"), s1);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), label);
    release(label);
    pin_by(label, v, "leadingAnchor", 20.0f64);
    pin_by(label, v, "trailingAnchor", -20.0f64);
    pin_by(label, v, "topAnchor", 14.0f64);
    pin_by(label, v, "bottomAnchor", -6.0f64);
    v
}

// A section's credit under it (the ESV's link).
uk_footer_view(t: int, s: int): int {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= uk_ui.sections_n) return 0;
    credit_view(uk_ui.sections[s].credit)
}

uk_section_button(_self: int, _cmd: int, b: int): int {
    n: int = msg(b, sel("tag"));
    k: int = n / 64;
    s: int = n % 64;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || s >= uk_ui.sections_n) return 0;
    action: int = uk_ui.sections[s].button_action;
    uk_wire_act(uk_ids[k], action, 0, 0);
    uk_effects();
    0
}

// A toggle's switch, or a choice's segmented control, beside its title (a
// choice's under it at the accessibility sizes). Its tag says its slot and
// row: k * 4096 + i.
uk_control_cell(t: int, k: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    control: int = 0;
    if (row.kind == UI_TOGGLE) {
        control = msg(make("UISwitch"), sel("autorelease"));
        msg1(control, sel("setOn:"), if (row.on) 1 else 0);
        msg1(control, sel("setOnTintColor:"), c_accent);
        msg3(control, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreToggle:"),
            4096)
    } else if (row.kind == UI_TIME) {
        // (A time: the system's compact picker, at its value's minutes.)
        control = msg(make("UIDatePicker"), sel("autorelease"));
        msg1(control, sel("setDatePickerMode:"), 0);
        if (responds(control, "setPreferredDatePickerStyle:")) msg1(control, sel("setPreferredDatePickerStyle:"),
            2);
        msg1(control, sel("setDate:"), date_at_minutes(row.value));
        msg3(control, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreTime:"),
            4096);
        msg(control, sel("sizeToFit"))
    } else {
        // (Its options, split at |.)
        n: int = 0;
        p: int = row.options.at;
        e: int = row.options.at + row.options.n;
        for x in row.options.at..e + 1 {
            if (x == e || uk_ui.pool[x] as int == 124) {
                if (n < len(one)) one[n] = nsstring_at(bytes_address(uk_ui.pool) + p,
                    x - p);
                n = n + 1;
                p = x + 1
            }
        }
        control = msg(msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
            nsarray(one, n)), sel("autorelease"));
        msg1(control, sel("setSelectedSegmentIndex:"), row.value);
        msg3(control, sel("addTarget:action:forControlEvents:"), app_obj, sel("coreChoice:"),
            4096);
        msg_rect(control, sel("setFrame:"), 0.0f64, 0.0f64, 220.0f64, 32.0f64)
    }
    msg1(control, sel("setTag:"), k * 4096 + i);
    title: int = uk_text(row.title);
    if (row.kind == UI_CHOICE && ax_size()) {
        cell: int = fresh_cell(t);
        content: int = msg(cell, sel("contentView"));
        column: int = stack(1, 10.0f64);
        label: int = make("UILabel");
        msg1(label, sel("setText:"), title);
        msg1(label, sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
            objc_const("UIFontTextStyleBody")));
        msg1(label, sel("setTextColor:"), c_ink);
        msg1(label, sel("setNumberOfLines:"), 0);
        msg1(column, sel("addArrangedSubview:"), label);
        release(label);
        msg1(column, sel("addArrangedSubview:"), control);
        msg1(content, sel("addSubview:"), column);
        pin_by(column, content, "leadingAnchor", 16.0f64);
        pin_by(column, content, "trailingAnchor", -16.0f64);
        pin_by(column, content, "topAnchor", 12.0f64);
        pin_by(column, content, "bottomAnchor", -12.0f64);
        return cell
    }
    cell: int = fresh_cell(t);
    config: int = list_config(0);
    msg1(config, sel("setText:"), title);
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryView:"), control);
    cell
}

// A switch switched, or a segment chosen: its row's action, core's.
uk_control_act(control: int, value: int) {
    n: int = msg(control, sel("tag"));
    k: int = n / 4096;
    i: int = n % 4096;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || i >= uk_ui.rows_n) return;
    row: UiRow = uk_ui.rows[i];
    uk_wire_act(uk_ids[k], row.action, row.arg, value);
    uk_effects()
}

uk_toggled(_self: int, _cmd: int, sw: int): int {
    uk_control_act(sw, if ((msg(sw, sel("isOn")) & 255) != 0) 1 else 0);
    0
}

// A time chosen: its minutes past midnight, the row's action's value.
uk_time_chosen(_self: int, _cmd: int, picker: int): int {
    cal: int = msg(cls("NSCalendar"), sel("currentCalendar"));
    date: int = msg(picker, sel("date"));
    h: int = msg2(cal, sel("component:fromDate:"), 32, date);
    m: int = msg2(cal, sel("component:fromDate:"), 64, date);
    uk_control_act(picker, h * 60 + m);
    0
}

uk_chose(_self: int, _cmd: int, s: int): int {
    uk_control_act(s, msg(s, sel("selectedSegmentIndex")));
    0
}

// A row tapped: its action, core's, and what core says then.
uk_picked(t: int, s: int, r: int) {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k) || s >= uk_ui.sections_n) return;
    // (A grid's cell: its buttons are tapped, not it.)
    if (uk_ui.grid) return;
    ri: int = uk_row_of(s, r);
    if (ri < 0) return;
    row: UiRow = uk_ui.rows[ri];
    if (row.disabled || row.kind != UI_ITEM && row.kind != UI_BUTTON) return;
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    uk_wire_act(uk_ids[k], row.action, row.arg, 0);
    uk_effects()
}

// Where a screen core pushes goes: the navigation the action came from
// (0: the sheet up).
uk_nav: int = 0;

// Whether the next sheet opens at its medium detent (Compare).
uk_medium: bool = false;

// The next sheet's detents (sheet_of's), and the last sheet presented.
uk_detents: int = 0;

uk_sheet: int = 0;

// A row swiped: whether it can be, and its deletion (core's action).
uk_can_edit(t: int, path: int): bool {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k)) return false;
    i: int = uk_row_at(path);
    i >= 0 && uk_ui.rows[i].delete_action != 0
}

uk_commit(t: int, style: int, path: int) {
    k: int = uk_slot_of(t);
    if (style != 1 || k < 0 || !uk_ensure(k)) return;
    r: int = msg(path, sel("row"));
    i: int = uk_row_at(path);
    if (i < 0 || uk_ui.rows[i].delete_action == 0) return;
    uk_delete_row(k, msg(path, sel("section")), r, uk_ui.rows[i].delete_action, uk_ui.rows[i].arg)
}

// Row r of section s of slot k deleted (its action): the screen made
// again, and if all it lost is that row (or its section, the row its
// last), the row (or section) taken away with the system's animation, the
// section's footer changing in place; else a cross-fade.
uk_del_k: int = -1;

uk_del_s: int = 0;

uk_del_r: int = 0;

uk_del_n: int = 0;

uk_del_counts: []int = new int[128](0);

uk_del_header: int = 0;

uk_del_footer: int = 0;

uk_delete_row(
    k: int,
    s: int,
    r: int,
    action: int,
    arg: int
) {
    if (!uk_ensure(k) || s >= uk_ui.sections_n) return;
    uk_del_k = k;
    uk_del_s = s;
    uk_del_r = r;
    uk_del_n = uk_ui.sections_n;
    for x in 0..uk_ui.sections_n
        if (x < len(uk_del_counts)) uk_del_counts[x] = uk_ui.sections[x].n;
    uk_del_header = held(0, uk_text(uk_ui.sections[s].header));
    uk_del_footer = held(0, uk_text(uk_ui.sections[s].footer));
    uk_wire_act(uk_ids[k], action, arg, 0);
    uk_effects();
    uk_del_k = -1;
    uk_del_header = held(uk_del_header, 0);
    uk_del_footer = held(uk_del_footer, 0)
}

// (Whether two words, either none, are the same.)
uk_same_text(a: int, b: int): bool {
    if (a == 0 || b == 0) return a == b;
    (msg1(a, sel("isEqualToString:"), b) & 255) != 0
}

// The update of the slot a row was deleted from: animated if it can be;
// whether it was.
uk_deleted(k: int): bool {
    t: int = uk_tables[k];
    if (t == 0 || msg(t, sel("window")) == 0) return false;
    uk_stale = true;
    if (!uk_ensure(k)) return false;
    s: int = uk_del_s;
    if (uk_ui.sections_n == uk_del_n) {
        for x in 0..uk_ui.sections_n {
            want: int = if (x == s) uk_del_counts[x] - 1 else uk_del_counts[x];
            if (x >= len(uk_del_counts) || uk_ui.sections[x].n != want) return false
        }
        if (!uk_same_text(uk_text(uk_ui.sections[s].header), uk_del_header)) return false;
        one[0] = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), uk_del_r,
            s);
        msg2(t, sel("deleteRowsAtIndexPaths:withRowAnimation:"), nsarray(one, 1),
            100);
        footer: int = uk_text(uk_ui.sections[s].footer);
        if (!uk_same_text(footer, uk_del_footer)) {
            // (The footer's words, in place, faded; its height after.)
            f: int = msg1(t, sel("footerViewForSection:"), s);
            if (f != 0) {
                fade_layer(msg(f, sel("layer")), 0.2f64);
                if (responds(f, "textLabel")) msg1(msg(f, sel("textLabel")), sel("setText:"),
                    footer)
            }
            msg(t, sel("beginUpdates"));
            msg(t, sel("endUpdates"))
        }
        uk_dress(k, false);
        return true
    }
    if (uk_ui.sections_n == uk_del_n - 1 && s < len(uk_del_counts) && uk_del_counts[s] == 1) {
        for x in 0..uk_ui.sections_n {
            was: int = if (x < s) uk_del_counts[x] else uk_del_counts[x + 1];
            if (uk_ui.sections[x].n != was) return false
        }
        msg2(t, sel("deleteSections:withRowAnimation:"), msg1(cls("NSIndexSet"), sel("indexSetWithIndex:"),
            s), 100);
        uk_dress(k, false);
        return true
    }
    false
}

// The swipe's word: its row's action's that it does (a plan's Remove:
// nothing is lost, §11.3.1), else Delete.
uk_delete_title(t: int, path: int): int {
    k: int = uk_slot_of(t);
    i: int = if (k >= 0 && uk_ensure(k)) uk_row_at(path) else -1;
    if (i >= 0) {
        for j in 0..uk_ui.rows[i].actions_n {
            a: UiAction = uk_ui.actions[uk_ui.rows[i].actions + j];
            if (a.action == uk_ui.rows[i].delete_action) return uk_text(a.title)
        }
    }
    nsstring(w_delete)
}

// A row's ⓘ: its action (a ribbon's screen, the plan followed's days).
uk_accessory(t: int, path: int) {
    k: int = uk_slot_of(t);
    if (k < 0 || !uk_ensure(k)) return;
    i: int = uk_row_at(path);
    if (i < 0 || uk_ui.rows[i].info_action == 0) return;
    action: int = uk_ui.rows[i].info_action;
    arg: int = uk_ui.rows[i].arg;
    uk_nav = msg(uk_vcs[k], sel("navigationController"));
    uk_wire_act(uk_ids[k], action, arg, 0);
    uk_effects()
}

// A command of a screen's button's menu chosen (its slot and index in its
// propertyList).
uk_command(_self: int, _cmd: int, command: int): int {
    n: int = msg(msg(command, sel("propertyList")), sel("integerValue"));
    k: int = n / 64;
    j: int = n % 64;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || j >= uk_ui.commands_n) return 0;
    c: UiCommand = uk_ui.commands[j];
    uk_wire_act(uk_ids[k], c.action, c.arg, 0);
    uk_effects();
    0
}

// A list's empty state (as empty_state, with the screen's words): a
// symbol, a title and a line; none, if symbol is 0.
uk_empty(
    vc: int,
    t: int,
    symbol_name: int,
    title: int,
    line: int
) {
    u: int = cls("UIContentUnavailableConfiguration");
    if (u != 0) {
        if (symbol_name == 0) {
            msg1(vc, sel("setContentUnavailableConfiguration:"), 0);
            return
        }
        config: int = msg(u, sel("emptyConfiguration"));
        sc: int = msg_f1(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
            40.0f64, 4);
        msg1(config, sel("setImage:"), msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
            symbol_name, sc));
        msg1(config, sel("setText:"), title);
        msg1(config, sel("setSecondaryText:"), line);
        msg1(vc, sel("setContentUnavailableConfiguration:"), config);
        return
    }
    if (symbol_name == 0) {
        msg1(t, sel("setBackgroundView:"), 0);
        return
    }
    label: int = make("UILabel");
    msg1(label, sel("setText:"), title);
    msg1(label, sel("setTextAlignment:"), 1);
    msg1(label, sel("setTextColor:"), c_faint);
    msg1(t, sel("setBackgroundView:"), label);
    release(label)
}

// Slot k's screen's controller dressed as the screen says: its empty state
// (no rows), and its button (its menu of commands; none, dimmed).
uk_dress(k: int, fade: bool) {
    if (!uk_ensure(k)) return;
    vc: int = uk_vcs[k];
    t: int = uk_tables[k];
    if (uk_ui.rows_n == 0 && uk_ui.empty_title.n > 0) {
        if (fade) fade_layer(msg(msg(vc, sel("view")), sel("layer")), 0.25f64);
        uk_empty(vc, t, uk_text(uk_ui.empty_symbol), uk_text(uk_ui.empty_title), uk_text(uk_ui.empty_line))
    } else uk_empty(vc, t, 0, 0, 0);
    // (Its words above the first section, as wide as the list is, or will
    // be.)
    if (uk_ui.hero.n > 0) {
        W: f64 = view_width(t);
        if (W < 1.0f64) {
            nav: int = if (uk_nav != 0) uk_nav else presented();
            W = (if (nav != 0) view_width(msg(nav, sel("view"))) else sheet_content_w(700.0f64))
        }
        msg1(t, sel("setTableHeaderView:"), uk_hero_view(W))
    }
    if (uk_ui.intro.n > 0 && (uk_ui.segments.n == 0 || uk_ui.segments_title)) {
        W: f64 = view_width(t);
        if (W < 1.0f64) {
            nav: int = if (uk_nav != 0) uk_nav else presented();
            W = (if (nav != 0) view_width(msg(nav, sel("view"))) else sheet_content_w(540.0f64))
        }
        head: int = uk_intro_view(W, uk_text(uk_ui.intro));
        // (Under the hero, if there is one: a new card's word, then "New".)
        if (uk_ui.hero.n > 0) {
            hero: int = msg(t, sel("tableHeaderView"));
            l8_msg_hfa(hfa, hero, sel("frame"), 0, 0, 0);
            hh: f64 = hfa[3];
            l8_msg_hfa(hfa, head, sel("frame"), 0, 0, 0);
            ih: f64 = hfa[3];
            box: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
                0.0f64, 0.0f64, W, hh + ih), sel("autorelease"));
            msg1(box, sel("addSubview:"), hero);
            msg_rect(head, sel("setFrame:"), 0.0f64, hh, W, ih);
            msg1(box, sel("addSubview:"), head);
            head = box
        }
        msg1(t, sel("setTableHeaderView:"), head);
        if (fade) fade_layer(msg(head, sel("layer")), 0.25f64)
    }
    // (At its foot, its buttons: Start Plan, or Stop Plan in red; the
    // Library's Export, a note to write.)
    uk_tooled[k] = uk_ui.tools_n > 0;
    if (uk_ui.tools_n > 0) uk_toolbar(k, vc, fade);
    // (Its segments and filter as its list's header; its sort, at the
    // top left; its field's placeholder, the segment's.)
    if (uk_ui.segments.n > 0 && !uk_ui.segments_title) uk_header_box(k, fade);
    if (uk_ui.segments.n > 0 && uk_ui.segments_title) uk_title_segments(k, msg(vc,
        sel("navigationItem")));
    if (uk_ui.sorts.n > 0) uk_sort_button(k) else uk_sort_button_gone(k);
    if (uk_searches[k] != 0) msg1(msg(uk_searches[k], sel("searchBar")), sel("setPlaceholder:"),
        uk_text(uk_ui.search));
    msg1(vc, sel("setTitle:"), uk_text(uk_ui.title));
    uk_set_subtitle(vc);
    // (At the top right: the screen's button, as History's Clear; else
    // Done.)
    item: int = msg(vc, sel("navigationItem"));
    if (uk_ui.confirm.n > 0) {
        // (Its confirm, New Ribbon's Add; on a sheet of its own, Cancel.)
        add: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithTitle:style:target:action:"),
            uk_text(uk_ui.confirm), 2, app_obj, sel("coreConfirm:")), sel("autorelease"));
        msg1(add, sel("setTag:"), k);
        msg1(add, sel("setEnabled:"), if (uk_ui.confirm_off) 0 else 1);
        msg1(item, sel("setRightBarButtonItem:"), add);
        if (uk_ui.left.n > 0) uk_left_item(k, item) else if (!uk_pushed[k]) msg1(item,
            sel("setLeftBarButtonItem:"), system_item(1, "closeSheet:"));
        return
    }
    if (uk_ui.left.n > 0) uk_left_item(k, item);
    if (uk_ui.button.n == 0) {
        // (Done, if it isn't there: not made again as a query is typed.)
        old: int = msg(item, sel("rightBarButtonItem"));
        // (In the panel beside the page: its close.)
        if (old == 0 || msg(old, sel("customView")) != 0) msg1(item, sel("setRightBarButtonItem:"),
            if (uk_in_panel(k)) beside_close_item() else system_item(0, "closeSheet:"));
        return
    }
    old: int = msg(item, sel("rightBarButtonItem"));
    b: int = if (old != 0) msg(old, sel("customView")) else 0;
    if (b == 0) {
        config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
        msg1(config, sel("setTitle:"), uk_text(uk_ui.button));
        msg1(config, sel("setBaseForegroundColor:"), c_accent);
        b = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"), config,
            0);
        msg1(b, sel("setShowsMenuAsPrimaryAction:"), 1);
        bi: int = msg(msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
            b), sel("autorelease"));
        msg1(item, sel("setRightBarButtonItem:"), bi)
    }
    for j in 0..uk_ui.commands_n {
        if (j < len(one)) {
            one[j] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
                uk_text(uk_ui.commands[j].title), 0, sel("coreCommand:"), nsnumber_int(k * 64 + j));
            if (uk_ui.commands[j].destructive) msg1(one[j], sel("setAttributes:"),
                2)
        }
    }
    msg1(b, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""),
        nsarray(one, uk_ui.commands_n)));
    msg1(b, sel("setEnabled:"), if (uk_ui.commands_n > 0) 1 else 0)
}

// ---- what core says to do ----
// A screen's list, its controller, in a free slot (one whose controller
// has been popped, or let go, is free again).
uk_make(id: int): int {
    k: int = -1;
    for j in 0..UK_SLOTS {
        if (k < 0 && (uk_ids[j] == 0 || uk_vcs[j] == 0 || msg(uk_vcs[j], sel("navigationController")) == 0 && msg(uk_vcs[j],
            sel("presentingViewController")) == 0)) k = j
    }
    if (k < 0) return -1;
    uk_free(k);
    uk_ids[k] = id;
    uk_stale = true;
    _b: bool = uk_ensure(k);
    // (Go To's and Search's controllers are the app's own kinds: Go To opens
    // at its focus and makes its ribbons again as it comes back, Search
    // takes the keys as it appears: ios/sheets.l8.)
    kind: int = uk_kind_of(id);
    c: int = if (kind == SCR_GOTO) books_class else if (kind == SCR_SEARCH) search_class else uk_class;
    vc: int = msg(msg1(msg(c, sel("alloc")), sel("initWithStyle:"), if (uk_ui.plain) 0 else 2),
        sel("autorelease"));
    goto: bool = kind == SCR_GOTO;
    uk_vcs[k] = keep(vc);
    uk_tables[k] = keep(msg(vc, sel("tableView")));
    uk_waits[k] = uk_ui.search_wait;
    uk_seen[k] = false;
    uk_pushed[k] = uk_making_push;
    // (Its field made now, to take the keys as it appears.)
    fi: int = uk_field_row();
    if (fi >= 0) _f: int = uk_field_cell(k, fi);
    msg1(vc, sel("setTitle:"), uk_text(uk_ui.title));
    uk_set_subtitle(vc);
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), if (goto) 0 else 2);
    if (uk_ui.search.n > 0) uk_make_search(k, item);
    msg1(uk_tables[k], sel("setDataSource:"), app_obj);
    msg1(uk_tables[k], sel("setDelegate:"), app_obj);
    style_table(uk_tables[k], !uk_ui.plain);
    // (A page's paragraphs have no lines between them, nor its sections:
    // a cell's separator set aside still leaves a sliver at the edge.)
    msg1(uk_tables[k], sel("setSeparatorStyle:"), if (uk_ui.page) 0 else 1);
    table_screens[uk_entry + k].look = (if (uk_ui.plain) TableLook.Plain else TableLook.Grouped);
    if (uk_ui.plain) {
        // (Search's results: full-width rows, headers as tall as they need,
        // and the keyboard dragged down with the rows.)
        t: int = uk_tables[k];
        msg_rect(t, sel("setSeparatorInset:"), 0.0f64, 20.0f64, 0.0f64, 0.0f64);
        msg_set_f(t, sel("setSectionHeaderHeight:"), objc_const_f("UITableViewAutomaticDimension"));
        msg_set_f(t, sel("setEstimatedSectionHeaderHeight:"), 36.0f64);
        msg1(t, sel("setKeyboardDismissMode:"), 1)
    }
    uk_dress(k, false);
    k
}

// Core's screens' controllers (but Go To's and Search's, the app's own
// kinds): each made again as it comes back (from a plan's days, say),
// reloaded whole, which lays out nothing off the window.
