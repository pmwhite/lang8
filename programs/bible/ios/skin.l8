uk_apply_effect(e: UiEffect) {
    if (e.word == "push") {
        uk_making_push = true;
        k: int = uk_make(e.a);
        uk_making_push = false;
        // (One of the panel's: on its navigation controller.)
        slot: int = uk_wire_slot(e.a);
        if (k >= 0 && slot >= 0 && uk_wire_groups[slot] == 1) {
            beside_push(uk_vcs[k]);
            return
        }
        sheet: int = if (uk_nav != 0) uk_nav else presented();
        if (k >= 0 && sheet != 0) msg2(sheet, sel("pushViewController:animated:"),
            uk_vcs[k], 1)
    } else if (e.word == "present") {
        pk: int = uk_kind_of(e.a);
        // (A footnote, a word, a reference: a popover at what was tapped.)
        if ((pk == SCR_FOOTNOTE || pk == SCR_WORD || pk == SCR_PREVIEW) && tap_rect_view != 0 && presented() == 0) {
            k: int = uk_make(e.a);
            if (k >= 0) uk_popover(k);
            return
        }
        // (Each kind as the app shows it: in a wide window a form sheet of
        // its size or a popover from its button; Compare and Study at their
        // medium detent.)
        if (pk == SCR_GOTO) sheet_form(540.0f64, 720.0f64);
        if (pk == SCR_SEARCH) sheet_form(620.0f64, 760.0f64);
        if (pk == SCR_LIBRARY) {
            sheet_form(620.0f64, 800.0f64);
            uk_detents = 1
        }
        if (pk == SCR_SETTINGS) {
            sheet_popover(bar_buttons[2], 375.0f64, 640.0f64);
            uk_detents = 2
        }
        if (pk == SCR_NEW_RIBBON) sheet_form(540.0f64, 720.0f64);
        if (pk == SCR_NOTE) {
            sheet_form(620.0f64, 640.0f64);
            uk_detents = 1
        }
        if (pk == SCR_COMPARE || pk == SCR_VERSE_STUDY) {
            if (pk == SCR_COMPARE) sheet_form(620.0f64, 760.0f64) else sheet_form(700.0f64,
                860.0f64);
            uk_detents = 1;
            uk_medium = true
        }
        // (A sheet up already: this one over it.)
        over: int = top_presented();
        k: int = uk_make(e.a);
        if (k >= 0) {
            uk_sheet = sheet_of(uk_vcs[k], uk_detents);
            if (uk_tooled[k]) {
                // (Its toolbar up with it, in the icons' color.)
                msg2(uk_sheet, sel("setToolbarHidden:animated:"), 0, 0);
                msg1(msg(uk_sheet, sel("toolbar")), sel("setTintColor:"), c_icon)
            }
            if (uk_medium) {
                sheet: int = msg(uk_sheet, sel("sheetPresentationController"));
                if (sheet != 0) msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierMedium"));
                uk_medium = false
            }
            if (pk == SCR_GOTO) msg1(msg(uk_sheet, sel("navigationBar")), sel("setPrefersLargeTitles:"),
                1);
            if (pk == SCR_SETTINGS) settings_nav = uk_sheet;
            if (over != 0 && (msg(over, sel("isBeingDismissed")) & 255) == 0) msg3(over,
                sel("presentViewController:animated:completion:"), uk_sheet, 1, 0) else present(uk_sheet)
        }
        uk_detents = 0
    } else if (e.word == "refill") {
        // (Typed: the rows as they are now, at once; what they are
        // changed (recent searches giving way to results), a
        // cross-fade, not a jump.)
        k: int = uk_slot_of_id(e.a);
        if (k >= 0) {
            if (e.b == 1) fade_layer(msg(uk_tables[k], sel("layer")), 0.2f64);
            uk_stale = true;
            msg(uk_tables[k], sel("reloadData"));
            uk_dress(k, false)
        }
    } else if (e.word == "retext") {
        k: int = uk_slot_of_id(e.a);
        if (k >= 0 && uk_searches[k] != 0 && uk_ensure(k)) msg1(msg(uk_searches[k],
            sel("searchBar")), sel("setText:"), if (uk_ui.search_text.n > 0) uk_text(uk_ui.search_text) else nsstring(""))
    } else if (e.word == "blur") {
        k: int = uk_slot_of_id(e.a);
        if (k >= 0 && uk_searches[k] != 0) msg(msg(uk_searches[k], sel("searchBar")),
            sel("resignFirstResponder"))
    } else if (e.word == "panel") {
        uk_panel_slot = uk_make(e.a);
        beside_made(uk_panel_slot)
    } else if (e.word == "present_over") {
        // (Over the sheet up: a note over the Library.)
        if (uk_kind_of(e.a) == SCR_NOTE) sheet_form(620.0f64, 640.0f64);
        k: int = uk_make(e.a);
        over: int = top_presented();
        if (k >= 0) {
            s2: int = sheet_of(uk_vcs[k], 1);
            if (over != 0) msg3(over, sel("presentViewController:animated:completion:"),
                s2, 1, 0) else present(s2)
        }
        uk_detents = 0
    } else if (e.word == "close") {
        // (Itself closed: over a sheet, that sheet stays; else the
        // sheets away.)
        k: int = uk_slot_of_id(e.a);
        sn: int = if (k >= 0) msg(uk_vcs[k], sel("navigationController")) else 0;
        if (k >= 0 && sn == 0 && msg(uk_vcs[k], sel("presentingViewController")) != 0) {
            msg2(uk_vcs[k], sel("dismissViewControllerAnimated:completion:"), 1, 0);
            return
        }
        under: int = if (sn != 0) msg(sn, sel("presentingViewController")) else 0;
        if (under != 0 && under != nav) msg2(under, sel("dismissViewControllerAnimated:completion:"),
            1, 0) else dismiss_sheets()
    } else if (e.word == "update" && uk_slot_of_id(e.a) == uk_del_k && uk_del_k >= 0 && uk_deleted(uk_del_k)) {
        // (A row deleted: taken away.)
        uk_del_k = -1
    } else if (e.word == "update") {
        k: int = uk_slot_of_id(e.a);
        if (k >= 0) {
            uk_stale = true;
            fade_layer(msg(uk_tables[k], sel("layer")), 0.15f64);
            msg(uk_tables[k], sel("reloadData"));
            uk_dress(k, true)
        }
    } else if (e.word == "pop_to") {
        k: int = uk_slot_of_id(e.a);
        nav: int = if (k >= 0) msg(uk_vcs[k], sel("navigationController")) else 0;
        if (nav != 0) _p: int = msg2(nav, sel("popToViewController:animated:"), uk_vcs[k],
            1)
    } else if (e.word == "focus") {
        // (Its focus row shown again, washed: a link to a part of the
        // same page.)
        k: int = uk_slot_of_id(e.a);
        if (k >= 0 && uk_ensure(k) && uk_ui.focus >= 0) {
            uk_stale = true;
            msg(uk_tables[k], sel("reloadData"));
            _e: bool = uk_ensure(k);
            uk_show_focus_at(uk_tables[k], 1, false);
            if (uk_ui.focus_wash) uk_wash(k)
        }
    } else if (e.word == "reveal") {
        k: int = uk_slot_of_id(e.a);
        if (k >= 0) uk_reveal(k)
    } else if (e.word == "dismiss") dismiss_sheets() else if (e.word == "pop") {
        // (The navigation the action came from: a sheet's, or Study's
        // beside the text.)
        sheet: int = if (uk_nav != 0) uk_nav else top_presented();
        if (sheet != 0) _p: int = msg1(sheet, sel("popViewControllerAnimated:"), 1)
    }
}

// Slot k's focus row's words (focus_from to focus_to, UTF-16) brought into
// sight, the list moving as little as it can: none if they are in sight
// already (Practice's words practised, the word being typed).
uk_reveal(k: int) {
    if (!uk_ensure(k) || uk_ui.focus < 0 || uk_ui.focus_from < 0) return;
    row: int = uk_ui.focus;
    from: int = uk_ui.focus_from;
    to: int = uk_ui.focus_to;
    t: int = uk_tables[k];
    for s in 0..uk_ui.sections_n {
        first: int = uk_ui.sections[s].first;
        if (row >= first && row < first + uk_ui.sections[s].n) {
            path: int = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"),
                row - first, s);
            msg(t, sel("layoutIfNeeded"));
            cell: int = msg1(t, sel("cellForRowAtIndexPath:"), path);
            if (cell == 0) {
                // (Its row out of sight: brought in, then its words.)
                msg3(t, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
                    path, 0, 0);
                msg(t, sel("layoutIfNeeded"));
                cell = msg1(t, sel("cellForRowAtIndexPath:"), path)
            }
            if (cell == 0) return;
            tv: int = msg1(msg(cell, sel("contentView")), sel("viewWithTag:"), k * 4096 + row);
            if (tv == 0) return;
            // (The words' top and bottom, in the list: the row's place,
            // the text view's in it, the first and last line's.)
            l8_msg_hfa(hfa, t, sel("rectForRowAtIndexPath:"), path, 0, 0);
            row_top: f64 = hfa[1];
            l8_msg_hfa(hfa, tv, sel("frame"), 0, 0, 0);
            text_top: f64 = row_top + hfa[1];
            if (!range_rect(tv, from, 1)) return;
            words_top: f64 = text_top + hfa[1];
            if (!range_rect(tv, if (to > from) to - 1 else from, 1)) return;
            words_bottom: f64 = text_top + hfa[1] + hfa[3];
            margin: f64 = 16.0f64;
            seen_top: f64 = offset_y(t) + top_inset(t);
            seen_bottom: f64 = offset_y(t) + view_height(t) - bottom_inset(t);
            y: f64 = offset_y(t);
            if (words_top - margin < seen_top) y = words_top - margin - top_inset(t) else if (words_bottom + margin > seen_bottom) {
                y = words_bottom + margin - view_height(t) + bottom_inset(t);
                // (Taller than the list shows: their top.)
                if (words_top - margin - top_inset(t) < y) y = words_top - margin - top_inset(t)
            }
            if (y == offset_y(t)) return;
            l8_msg_hfa(hfa, t, sel("contentSize"), 0, 0, 0);
            most: f64 = hfa[1] + bottom_inset(t) - view_height(t);
            if (y > most) y = most;
            if (y < -top_inset(t)) y = -top_inset(t);
            msg_ff1(t, sel("setContentOffset:animated:"), 0.0f64, y, if (reduce_motion()) 0 else 1);
            return
        }
    }
}

// Slot k's list in a popover pointing at what was tapped in the reader
// (a footnote's mark, a word, a reference), sized to its rows.
uk_popover(k: int) {
    vc: int = uk_vcs[k];
    msg1(vc, sel("setModalPresentationStyle:"), 7);
    l8_msg_hfa(hfa, window, sel("bounds"), 0, 0, 0);
    w: f64 = if (hfa[2] - 32.0f64 < 360.0f64) hfa[2] - 32.0f64 else 360.0f64;
    msg_ff(vc, sel("setPreferredContentSize:"), w, 280.0f64);
    pc: int = msg(vc, sel("popoverPresentationController"));
    if (pc != 0) {
        msg1(pc, sel("setSourceView:"), tap_rect_view);
        msg_rect(pc, sel("setSourceRect:"), tap_rect_x - 4.0f64, tap_rect_y - 10.0f64,
            8.0f64, 20.0f64);
        msg1(pc, sel("setPermittedArrowDirections:"), 3);
        msg1(pc, sel("setDelegate:"), app_obj)
    }
    present(vc)
}

// The list showing core's screen of kind (the top one), or 0.
uk_table_of(kind: int): int {
    for k in 0..UK_SLOTS {
        if (uk_ids[k] != 0 && uk_kind_of(uk_ids[k]) == kind) return uk_tables[k]
    }
    0
}

add_skin_methods(app: int) {
    add_method1(app, sel("coreCommand:"), &uk_command, "v@:@");
    add_method1(app, sel("coreToggle:"), &uk_toggled, "v@:@");
    add_method1(app, sel("coreChoice:"), &uk_chose, "v@:@");
    add_method1(app, sel("coreTime:"), &uk_time_chosen, "v@:@");
    add_method1(app, sel("coreSectionButton:"), &uk_section_button, "v@:@");
    add_method1(app, sel("coreSearchFire:"), &uk_search_fire, "v@:@");
    add_method1(app, sel("coreCircle:"), &uk_circle, "v@:@");
    add_method1(app, sel("coreCircleAction:"), &uk_circle_action, "B@:@");
    add_method1(app, sel("coreTool:"), &uk_tool, "v@:@");
    add_method1(app, sel("coreConfirm:"), &uk_confirm_tapped, "v@:@");
    add_method1(app, sel("coreFieldTyped:"), &uk_field_typed, "v@:@");
    add_method1(app, sel("coreSegment:"), &uk_segment_chosen, "v@:@");
    add_method1(app, sel("coreFilter:"), &uk_filter_tapped, "v@:@");
    add_method1(app, sel("coreSort:"), &uk_sort_chosen, "v@:@");
    add_method1(app, sel("coreRowAction:"), &uk_row_action, "B@:@");
    add_method1(app, sel("coreRowMenu:"), &uk_row_menu, "B@:@");
    add_method1(app, sel("coreToolMenu:"), &uk_tool_menu_chosen, "v@:@");
    add_method1(app, sel("coreGridCell:"), &uk_grid_tapped, "v@:@");
    add_method1(app, sel("corePageTapped:"), &uk_page_tapped, "v@:@");
    add_method1(app, sel("coreTile:"), &uk_tile_tapped, "v@:@");
    add_method1(app, sel("coreLeft:"), &uk_left_tapped, "v@:@");
    add_method1(app, sel("coreGridButton:"), &uk_grid_button, "v@:@");
    add_method1(app, sel("textViewDidEndEditing:"), &uk_prose_ended, "v@:@");
    add_method1(app, sel("coreTileAction:"), &uk_tile_action, "B@:@");
    add_method1(app, sel("coreToolSegment:"), &uk_tool_segment, "v@:@");
    add_method1(app, sel("corePageLinkAction:"), &uk_page_link_action, "B@:@")
}

// The sheets gone: their lists let go, and core's screens with them.
uk_gone() {
    // (Not the panel's: it stays as sheets come and go.)
    for k in 0..UK_SLOTS {
        slot: int = uk_wire_slot(uk_ids[k]);
        if (slot < 0 || uk_wire_groups[slot] == 0) uk_free(k)
    }
    uk_timer = stop_timer(uk_timer);
    uk_pending = -1;
    // (What Search searched for kept first among the recent searches.)
    uk_wire_single("closegroup", 0);
    uk_stale = true
}

uk_screens() {
    uk_class = class_make(cls("UITableViewController"), "L8CoreList");
    add_method1(uk_class, sel("viewWillAppear:"), &uk_will_appear, "v@:B");
    add_method1(uk_class, sel("viewWillDisappear:"), &uk_will_go, "v@:B");
    add_method0(uk_class, sel("viewDidLayoutSubviews"), &uk_layout, "v@:");
    uk_entry = table_screens_n;
    for k in 0..UK_SLOTS {
        s: TableScreen = table_screen(&uk_tables[k], &uk_sections, &uk_rows, &uk_cell);
        s.picked = &uk_picked;
        s.header = &uk_header;
        s.footer = &uk_footer;
        s.header_view = &uk_header_view;
        s.footer_view = &uk_footer_view;
        s.can_edit = &uk_can_edit;
        s.commit = &uk_commit;
        s.delete_title = &uk_delete_title;
        s.accessory = &uk_accessory;
        s.look = TableLook.Grouped;
        table_add(s)
    }
    on_sheet_gone(&uk_gone)
}
