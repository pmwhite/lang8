            "coreLeft:") else msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")),
            sel("initWithImage:style:target:action:"), msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
            icon, msg_f1(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
            17.0f64, 4)), 0, app_obj, sel("coreLeft:")), sel("autorelease")));
        msg1(b, sel("setAccessibilityLabel:"), uk_text(uk_ui.left))
    } else b = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithTitle:style:target:action:"),
        uk_text(uk_ui.left), 0, app_obj, sel("coreLeft:")), sel("autorelease"));
    if (uk_ui.left_style == UI_TOOL_DESTRUCTIVE) msg1(b, sel("setTintColor:"), msg(cls("UIColor"),
        sel("systemRedColor")));
    msg1(b, sel("setTag:"), k);
    msg1(item, sel("setLeftBarButtonItem:"), b)
}

uk_left_tapped(_self: int, _cmd: int, b: int): int {
    k: int = msg(b, sel("tag"));
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k)) return 0;
