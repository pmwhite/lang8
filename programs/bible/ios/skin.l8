// Words split at | into into (NSStrings): how many (as many as fit).
uk_split(t: UiText, into: []int): int {
    n: int = 0;
    p: int = t.at;
    e: int = t.at + t.n;
    for x in t.at..e + 1 {
        if ((x == e || uk_ui.pool[x] as int == 124) && n < len(into)) {
            into[n] = nsstring_at(bytes_address(uk_ui.pool) + p, x - p);
            n = n + 1;
            p = x + 1
        }
    }
    n
}

