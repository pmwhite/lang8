tag bible_ios;

use_tag std, ios, bible;

// The app's own views and text, apart from what they show: fonts, labels,
// attributed text, fades, accessories, the circle rows' cells, the presented
// controllers, the app's own defaults, and the log.
import "../../ios/objc.l8";

import "../core/text.l8";

extern UIAccessibilityPostNotification(notification: int, argument: int): int;

append(
    s: int,
    text: int,
    font: int,
    color: int
) {
    msg1(s, sel("appendAttributedString:"), attributed(text, font, color))
}

attributed(text: int, font: int, color: int): int {
    keys[0] = k_font;
    values[0] = font;
    keys[1] = k_color;
    values[1] = color;
    msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, nsdictionary(keys, values, 2)), sel("autorelease"))
}

extern dlopen(path: str, mode: int): int;

// A cross-fade of whatever changes in a layer next, over t seconds.
fade_layer(layer: int, t: f64) {
    if (layer == 0) return;
    tr: int = make("CATransition");
    msg1(tr, sel("setType:"), objc_const("kCATransitionFade"));
    msg_set_f(tr, sel("setDuration:"), t);
    msg2(layer, sel("addAnimation:forKey:"), tr, 0);
    release(tr)
}

italic_sans(size: f64): int {
    f: int = sans(size, 0.0f64);
    d: int = msg1(msg(f, sel("fontDescriptor")), sel("fontDescriptorWithSymbolicTraits:"),
        1);
    if (d == 0) return f;
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

label_of(a: int): int {
    l: int = msg(make("UILabel"), sel("autorelease"));
    msg1(l, sel("setAttributedText:"), a);
    msg1(l, sel("setTextAlignment:"), 1);
    l
}

// A label's size: hfa[0], hfa[1].
label_size(l: int, most: f64) {
    msg_set_f(l, sel("setPreferredMaxLayoutWidth:"), most);
    l8_msg_hfa(hfa, l, sel("intrinsicContentSize"), 0, 0, 0)
}

mono(size: f64): int {
    msg_ff(cls("UIFont"), sel("monospacedDigitSystemFontOfSize:weight:"), size, 0.0f64)
}

// Greek in New York, Hebrew in the system's font (its Hebrew), at a size
// (scaled with the phone's text size).
scaled(size: f64): f64 {
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    msg_f_f(metrics, sel("scaledValueForValue:"), size)
}

serif(size: f64): int {
    d: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
        objc_const("UIFontTextStyleBody"));
    s: int = msg1(d, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), if (s != 0) s else d, size)
}

original_font(greek: bool, greek_size: f64, hebrew_size: f64): int {
    if (greek) serif(scaled(greek_size)) else sans(scaled(hebrew_size), 0.0f64)
}

// The helped mark: 1.5 points of accent at 50% under a tile's English.
tile_underline(t: int, eng: int) {
    // (Under its words only: the text's width, centred in the line.)
    l8_msg_hfa(hfa, eng, sel("frame"), 0, 0, 0);
    fx: f64 = hfa[0];
    fy: f64 = hfa[1];
    fw: f64 = hfa[2];
    fh: f64 = hfa[3];
    label_size(eng, fw);
    tw: f64 = if (hfa[0] > 0.0f64 && hfa[0] < fw) hfa[0] else fw;
    hfa[0] = fx + (fw - tw) / 2.0f64;
    hfa[1] = fy;
    hfa[2] = tw;
    hfa[3] = fh;
    u: int = msg(make("UIView"), sel("autorelease"));
    msg1(u, sel("setBackgroundColor:"), msg_set_f(c_accent, sel("colorWithAlphaComponent:"),
        0.5f64));
    msg1(u, sel("setUserInteractionEnabled:"), 0);
    msg_rect(u, sel("setFrame:"), hfa[0], hfa[1] + hfa[3] - 0.5f64, hfa[2], 1.5f64);
    msg1(t, sel("addSubview:"), u)
}

// The view controller on top of the sheets.
top_presented(): int {
    top: int = presented();
    if (top == 0) return 0;
    while (msg(top, sel("presentedViewController")) != 0) top = msg(top, sel("presentedViewController"));
    top
}

// The count, a faint checkmark, and the disclosure.
value_check_disclosure(text: int): int {
    v: int = value_disclosure(text, c_faint);
    iv: int = msg(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol("checkmark", 13.0f64, 6, c_faint)), sel("autorelease"));
    msg(iv, sel("sizeToFit"));
    l8_msg_hfa(hfa, v, sel("frame"), 0, 0, 0);
    vw: f64 = hfa[2];
    vh: f64 = hfa[3];
    iw: f64 = view_width(iv);
    ih: f64 = view_height(iv);
    // (The checkmark between the count and the chevron.)
    subs: int = msg(v, sel("subviews"));
    label: int = msg1(subs, sel("objectAtIndex:"), 0);
    chevron: int = msg1(subs, sel("objectAtIndex:"), 1);
    l8_msg_hfa(hfa, chevron, sel("frame"), 0, 0, 0);
    cx: f64 = hfa[0];
    msg_rect(chevron, sel("setFrame:"), cx + iw + 6.0f64, hfa[1], hfa[2], hfa[3]);
    msg_rect(iv, sel("setFrame:"), cx, (vh - ih) / 2.0f64, iw, ih);
    msg1(v, sel("addSubview:"), iv);
    msg_rect(v, sel("setFrame:"), 0.0f64, 0.0f64, vw + iw + 6.0f64, vh);
    _l: int = label;
    v
}

attributed_str(text: int, attributes: int): int {
    msg(msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, attributes), sel("autorelease"))
}

// A circle for a reading's or a day's state (0 none, 1 some, 2 all read).
circle_name(state: int): str {
    if (state == 2) "checkmark.circle.fill" else if (state == 1) "circle.lefthalf.filled" else "circle"
}

// A row with a circle at its start (a button over the cell's image, 28
// points), its title and secondary text: for the circle, tag and action.
circle_key: []int = new int[1](0);

circle_tag(b: int): int {
    n: int = objc_getAssociatedObject(b, ints_address(circle_key));
    if (n == 0) -1 else msg(n, sel("longValue"))
}

circle_cell(
    t: int,
    id: str,
    _state: int,
    tag: int,
    action: str
): int {
    cell: int = list_cell(t, id, 2);
    // (A list configuration first: setting the first one replaces the cell's
    // content view, and the button must be in the one that stays.)
    if (msg(cell, sel("contentConfiguration")) == 0) msg1(cell, sel("setContentConfiguration:"),
        list_config(2));
    b: int = msg1(msg(cell, sel("contentView")), sel("viewWithTag:"), 9100);
    if (b == 0) {
        b = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTag:"), 9100);
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        content: int = msg(cell, sel("contentView"));
        msg1(content, sel("addSubview:"), b);
        pin(b, content, "leadingAnchor");
        pin(b, content, "topAnchor");
        pin(b, content, "bottomAnchor");
        pin_size(b, "widthAnchor", 60.0f64);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel(action), 64)
    }
    objc_setAssociatedObject(b, ints_address(circle_key), nsnumber_int(tag), 1);
    msg1(cell, sel("setAccessoryType:"), 0);
    cell
}

// The same, the circle dimmed when it does nothing (a plan not started:
// review r5-1).
circle_config_of(
    state: int,
    title: int,
    line: int,
    dim: bool
): int {
    config: int = list_config(2);
    color: int = if (dim) msg_set_f(c_faint, sel("colorWithAlphaComponent:"), 0.4f64) else if (state == 0) c_faint else c_accent;
    config_image(config, circle_name(state), 22.0f64, color);
    msg_ff(msg(config, sel("imageProperties")), sel("setReservedLayoutSize:"), 28.0f64,
        28.0f64);
    msg1(config, sel("setText:"), title);
    msg1(config, sel("setSecondaryText:"), line);
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(text_props(config), sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleBody")));
    msg1(detail_props(config), sel("setColor:"), c_faint);
    config
}

// A row's VoiceOver: what it says, and its action (Mark as Read, or as
// Unread).
circle_access(
    cell: int,
    label: int,
    state: int,
    action: str
) {
    msg1(cell, sel("setIsAccessibilityElement:"), 1);
    msg1(cell, sel("setAccessibilityLabel:"), label);
    // (A circle that does nothing has no action.)
    b0: int = msg1(msg(cell, sel("contentView")), sel("viewWithTag:"), 9100);
    if (b0 != 0 && (msg(b0, sel("isEnabled")) & 255) == 0) {
        msg1(cell, sel("setAccessibilityCustomActions:"), 0);
        return
    }
    a: int = msg(msg3(msg(cls("UIAccessibilityCustomAction"), sel("alloc")), sel("initWithName:target:selector:"),
        nsstring(if (state == 2) w_mark_unread else w_mark_read), app_obj, sel(action)),
        sel("autorelease"));
    b: int = msg1(msg(cell, sel("contentView")), sel("viewWithTag:"), 9100);
    objc_setAssociatedObject(a, ints_address(circle_key), objc_getAssociatedObject(b,
        ints_address(circle_key)), 1);
    one[0] = a;
    msg1(cell, sel("setAccessibilityCustomActions:"), nsarray(one, 1))
}

extern objc_getAssociatedObject(object: int, key: int): int;

extern objc_setAssociatedObject(
    object: int,
    key: int,
    value: int,
    policy: int
): int;

// A label for the rows (wrapping, at the phone's size).
today_label(font: int, color: int, lines: int): int {
    l: int = msg(make("UILabel"), sel("autorelease"));
    msg1(l, sel("setFont:"), font);
    msg1(l, sel("setTextColor:"), color);
    msg1(l, sel("setNumberOfLines:"), lines);
    msg1(l, sel("setAdjustsFontForContentSizeCategory:"), 0);
    l
}

// The Day 4 (in accent) and the disclosure, as a row's accessory.
value_disclosure(text: int, color: int): int {
    l: int = today_label(msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const("UIFontTextStyleBody")),
        color, 1);
    msg1(l, sel("setText:"), text);
    msg(l, sel("sizeToFit"));
    lw: f64 = view_width(l);
    lh: f64 = view_height(l);
    chevron: int = msg(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        symbol("chevron.right", 13.0f64, 6, msg(cls("UIColor"), sel("tertiaryLabelColor")))),
        sel("autorelease"));
    msg(chevron, sel("sizeToFit"));
    cw: f64 = view_width(chevron);
    ch: f64 = view_height(chevron);
    h: f64 = if (lh > ch) lh else ch;
    box: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, lw + 8.0f64 + cw, h), sel("autorelease"));
    msg_rect(l, sel("setFrame:"), 0.0f64, (h - lh) / 2.0f64, lw, lh);
    msg_rect(chevron, sel("setFrame:"), lw + 8.0f64, (h - ch) / 2.0f64, cw, ch);
    msg1(box, sel("addSubview:"), l);
    msg1(box, sel("addSubview:"), chevron);
    box
}

clamp(n: int, lo: int, hi: int): int {
    if (n < lo) lo else if (n > hi) hi else n
}

// A run of words onto s, in a font and color, its paragraph p.
cmp_put(
    s: int,
    text: int,
    font: int,
    color: int,
    p: int
) {
    keys[0] = k_font;
    values[0] = font;
    keys[1] = k_color;
    values[1] = color;
    keys[2] = k_para;
    values[2] = p;
    msg1(s, sel("appendAttributedString:"), attributed_str(text, nsdictionary(keys,
        values, 3)))
}

// A page (its address an NSString) in Safari's own view, over everything.
open_web_ns(address: int) {
    u: int = msg1(cls("NSURL"), sel("URLWithString:"), address);
    if (cls("SFSafariViewController") == 0) _h: int = dlopen("/System/Library/Frameworks/SafariServices.framework/SafariServices",
        1);
    sf: int = cls("SFSafariViewController");
    if (sf == 0 || u == 0) return;
    vc: int = msg1(msg(sf, sel("alloc")), sel("initWithURL:"), u);
    top: int = top_presented();
    msg3(if (top != 0) top else nav, sel("presentViewController:animated:completion:"),
        vc, 1, 0);
    release(vc)
}

// A paragraph style for original text: right to left (Hebrew) or not,
// aligned (0 left, 1 centred, 2 right), its lines' height.
orig_para(lang: int, align: int, lines: f64): int {
    p: int = msg(para_style(align, 0.0f64, 0.0f64, 0.0f64, 0.0f64, lines), sel("autorelease"));
    if (lang == 1) msg1(p, sel("setBaseWritingDirection:"), 1);
    p
}

// A local time today (minutes past midnight) as a date.
date_at_minutes(m: int): int {
    offset: int = msg(msg(cls("NSTimeZone"), sel("localTimeZone")), sel("secondsFromGMT"));
    now: int = time(0) + offset;
    t: int = now - (now % 86400 + 86400) % 86400 - offset + m * 60;
    msg_set_f(cls("NSDate"), sel("dateWithTimeIntervalSince1970:"), t as f64)
}

// A line of the log, an NSString.
log_line_buf: []i8 = new i8[1024](0i8);

note_ns(s: int) {
    n: int = nsstring_into(s, log_line_buf);
    try {
        write_bytes_n(2, log_line_buf, n);
        write(2, "\n")
    } with IoError _e -> { }
}

// What was put in the format buffer (core/text.l8's fput), an NSString.
fstring(): int {
    nsstring_of(fbuf, fbuf_n)
}
