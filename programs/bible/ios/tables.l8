tag bible_ios;

use_tag std;

// The lists the app's object is the data source of, each a screen's own: a
// screen says once, when the app begins, which of its globals holds its
// table and what answers for it. The table callbacks (sheets.l8) find the
// screen whose global holds the table asked about, and ask it.
type TableScreen = {
    // The screen's global holding its table (0 while it is not shown).
    table: *int;
    sections: fn(t: int): int;
    rows: fn(t: int, section: int): int;
    cell: fn(t: int, path: int): int;
    picked: ?fn(t: int, section: int, row: int);
    header: ?fn(t: int, section: int): int;
    footer: ?fn(t: int, section: int): int;
    header_view: ?fn(t: int, section: int): int;
    footer_view: ?fn(t: int, section: int): int;
    can_edit: ?fn(t: int, path: int): bool;
    commit: ?fn(t: int, style: int, path: int);
    delete_title: ?fn(t: int, path: int): int;
    accessory: ?fn(t: int, path: int)
}

// A screen's table with its sections, rows and cells; the rest, if it
// has them, set after.
table_screen(
    table: *int,
    sections: fn(t: int): int,
    rows: fn(t: int, section: int): int,
    cell: fn(t: int, path: int): int
): TableScreen {
    TableScreen {
        table: table,
        sections: sections,
        rows: rows,
        cell: cell,
        picked: null,
        header: null,
        footer: null,
        header_view: null,
        footer_view: null,
        can_edit: null,
        commit: null,
        delete_title: null,
        accessory: null
    }
}

no_table: int = 0;

no_sections(_t: int): int {
    0
}

no_rows(_t: int, _s: int): int {
    0
}

no_cell(_t: int, _path: int): int {
    0
}

TABLES_MOST: int = 64;

table_screens: []TableScreen = new TableScreen[TABLES_MOST](table_screen(&no_table,
    &no_sections, &no_rows, &no_cell));

table_screens_n: int = 0;

table_add(screen: TableScreen@immortal) {
    if (table_screens_n >= TABLES_MOST) return;
    table_screens[table_screens_n] = screen;
    table_screens_n = table_screens_n + 1
}

// The screen showing table t, or -1.
table_find(t: int): int {
    if (t == 0) return -1;
    for i in 0..table_screens_n
        if (table_screens[i].table.* == t) return i;
    -1
}

// ---- what a sheet's going lets go ----
// Each screen's own: its tables, controllers and state let go when the
// sheets over the reader are gone, in the order the screens said so.
SHEET_PARTS_MOST: int = 64;

sheet_parts: []fn() = new fn()[SHEET_PARTS_MOST](&nothing_gone);

sheet_parts_n: int = 0;

nothing_gone() { }

on_sheet_gone(gone: fn()) {
    if (sheet_parts_n >= SHEET_PARTS_MOST) return;
    sheet_parts[sheet_parts_n] = gone;
    sheet_parts_n = sheet_parts_n + 1
}

sheet_parts_gone() {
    for i in 0..sheet_parts_n {
        gone: fn() = sheet_parts[i];
        gone()
    }
}
