tag vellum;

use_tag std, ios, bible, bible_wire;

// The panel beside the page (SKINS.md: core/beside.l8's screens, group 1):
// its navigation a child of the root's, under the page in a split (an
// iPhone's, or a window too narrow for a column) or a column at its right
// (an iPad's wide window). Its first screen is the panel's reader (pane
// 1), a VellumList whose view is the pane's scroll view: in a split it has
// no bar (the dock is the header of both readers, dock.l8), in a column
// the system's (the chapter as its title, what it reads under it, Link and
// the menu). Study goes on its navigation over it.
//
// The split: the page above, the panel below, parted by the divider, a
// hairline with two glass buttons on it: the split's (the dock's panel
// button, moved up into the divider as the panel comes and back down
// into the dock as it goes; a tap closes the split) and the link (in the
// accent linked, faint unlinked, none where the panel's document can't be
// linked). A drag of the divider sizes the two, settling at a third, a half
// or two thirds of the window; dragged to the top, the panel fills the
// screen (core's Full Screen), dragged down past the foot, the split
// closes. The dock floats over the panel's foot (its safe area made larger
// there), and once the divider is still the page's foot is where it is
// (the page's offset untouched: no word on it moves).
import "../../ios/objc.l8";

import "../../ios/block.l8";

import "kit.l8";

import "pane.l8";

type Panel = {
    // Its navigation controller (held; 0: none), whether it shows, and
    // whether core wants it open and filling the screen.
    nav: int;
    shown: bool;
    wanted: bool;
    full: bool;
    // Where its top (the divider's line) is in the window (the window's
    // height: none, or a column).
    top: f64;
    // The reader screen's slot (-1: none).
    reader_slot: int;
    // A column at the page's right (an iPad's wide window), not a split.
    column: bool
}

panel: Panel = Panel {
    nav: 0,
    shown: false,
    wanted: false,
    full: false,
    top: 0.0f64,
    reader_slot: -1,
    column: false
};

// The column's width, and the page's least beside it (em of its type, and
// its margins).
PANEL_COLUMN_W: f64 = 390.0f64;

PAGE_LEAST_EM: f64 = 28.0f64;

// Whether the window has room for the panel as a column: a regular width
// (an iPad's), the page keeping 28 em and its margins beside it.
panel_column_fits(): bool {
    if (root_vc == 0) return false;
    if (msg(msg(root_vc, sel("traitCollection")), sel("horizontalSizeClass")) != 2) return false;
    w: f64 = bounds_of(root_view).w;
    w >= PAGE_LEAST_EM * page_type.em + 2.0f64 * look.margin + PANEL_COLUMN_W + 1.0f64
}

// The page's width now (the window's, less the column where it is one).
page_width(w: f64): f64 {
    if (panel.shown && panel.column) w - PANEL_COLUMN_W - 1.0f64 else w
}

// ---- its navigation, the root's child ----
// The navigation in the root's view, over the page and under the chrome
// (the way back, toasts); kept there while a split closes (panel.nav let
// go at once), let go once it has.
panel_attached: int = 0;

panel_attach(nav: int) {
    if (panel_attached != 0 && panel_attached != nav) panel_detach_now();
    panel_attached = held(panel_attached, nav);
    panel_inset_top = -1.0f64;
    panel_inset_bottom = -1.0f64;
    msg1(root_vc, sel("addChildViewController:"), nav);
    msg2(root_view, sel("insertSubview:aboveSubview:"), msg(nav, sel("view")), page_pane.scroll);
    msg1(nav, sel("didMoveToParentViewController:"), root_vc);
    panel.column = panel_column_fits();
    send1("panelfill", if (panel.column) 0 else 1);
    panel_insets_fit();
    if (panel.column) {
        chrome_relayout();
        return
    }
    panel_split_open()
}

panel_detach_now() {
    nav: int = panel_attached;
    if (nav == 0) return;
    msg1(nav, sel("willMoveToParentViewController:"), 0);
    msg(msg(nav, sel("view")), sel("removeFromSuperview"));
    msg(nav, sel("removeFromParentViewController"));
    panel_attached = held(panel_attached, 0);
    if (!panel.shown) panel_divider_remove()
}

// The panel laid out for the root's bounds (w by h): a column at the
// right, a hairline before it; a split where its divider is, unless a
// hand or an animation is moving it.
panel_layout(w: f64, h: f64) {
    if (panel_attached == 0) return;
    if (panel.column) {
        if (!panel.shown) return;
        set_frame4(msg(panel_attached, sel("view")), w - PANEL_COLUMN_W, 0.0f64, PANEL_COLUMN_W,
            h);
        msg_set_f(msg(msg(panel_attached, sel("view")), sel("layer")), sel("setBorderWidth:"),
            0.0f64);
        panel.top = h;
        return
    }
    if (panel_dragging || panel_split_moving > 0 || panel_moving) return;
    panel_split_place(if (panel.shown) panel_split_top() else h)
}

// The window changed size: the panel moved between split and column.
panel_mode_check() {
    if (!panel.shown || panel_attached == 0) return;
    fits: bool = panel_column_fits();
    if (fits == panel.column) return;
    panel.column = fits;
    send1("panelfill", if (fits) 0 else 1);
    panel_insets_fit();
    if (fits) {
        panel_divider_remove();
        dock_panel_button_back()
    } else {
        panel_divider_attach();
        dock_panel_button_away_now()
    }
    if (panel.reader_slot >= 0 && screen_load(panel.reader_slot)) panel_reader_dress(panel.reader_slot);
    panel_bar_fit();
    chrome_relayout()
}

panel_nav(): int {
    panel.nav
}

panel_shown(): bool {
    panel.shown
}

// What of the page's foot the panel covers: the split's, to a little above
// its divider (the buttons' room); none in a column.
panel_page_cover(): f64 {
    if (!panel.shown || panel.column) return 0.0f64;
    chrome_bounds.h - panel_split_top() + PANEL_DIVIDER_ROOM
}

// `beside OPEN FULL`: the panel wanted open (its screens asked for:
// `panelmake`) or not, and filling the screen or not.
beside_line(open: bool, full: bool) {
    full_was: bool = panel.full;
    panel.full = full;
    if (open && !panel.wanted) {
        panel.wanted = true;
        send0("panelmake")
    } else if (!open && panel.wanted) {
        panel.wanted = false;
        panel_put_away()
    } else if (open && panel.shown && full != full_was) panel_split_animate()
}

// A screen of the panel's shown: its first (the reader, or Study) as the
// navigation's root, attached if it isn't.
panel_screen_show(s: int) {
    if (s < 0) return;
    controller: int = slot_controller(s);
    if (screen_load(s) && ui.reader) panel.reader_slot = s;
    if (panel.nav != 0 && panel.shown) {
        stack: int = msg(panel.nav, sel("viewControllers"));
        sheet_mark_closing(stack);
        one_item[0] = controller;
        msg2(panel.nav, sel("setViewControllers:animated:"), nsarray(one_item, 1),
            0);
        panel_forget_gone();
        return
    }
    nav: int = nav_new(controller);
    panel.nav = held(panel.nav, nav);
    panel.shown = true;
    send1("panelvisible", 1);
    panel_button_light(true);
    panel_attach(nav)
}

// Put away by the app: its screens let go (`closegroup 1`).
panel_put_away() {
    if (panel.nav == 0) return;
    sheet_mark_closing(msg(panel.nav, sel("viewControllers")));
    panel_gone();
    send1("closegroup", 1)
}

// Dragged down past the foot by a hand: Close Panel, core's.
panel_dragged_away() {
    panel_gone();
    send0("tap shelf")
}

panel_gone() {
    // (A split: the button handed to the dock first, so that the dock
    // follows it back rather than changing on its own; drawn in, it comes
    // out as it does.)
    if (!panel.column && panel_divider != 0) {
        panel_move_begin(panel.top);
        dock_expand()
    }
    panel.shown = false;
    panel.wanted = false;
    panel.reader_slot = -1;
    // (Its words shown as it goes, let go once it has.)
    _t: int = timer_after(app_obj, 0.7f64, "vellumPanelDetach:");
    panel.nav = held(panel.nav, 0);
    send1("panelvisible", 0);
    panel_button_light(false);
    dock_panel_gone();
    panel_forget_gone();
    if (panel.column) {
        panel_detach_now();
        panel.top = chrome_bounds.h
    } else {
        // (The split closes, the panel going down off the screen and the
        // split's button down into the dock.)
        panel_split_animate()
    }
    chrome_relayout();
    panel_settle_soon()
}

// Screens of the panel's no longer on its navigation let go.
panel_forget_gone() {
    for s in 0..SLOTS_MOST {
        c: int = slots[s].controller;
        if (c != 0 && slots[s].group == 1 && (panel.nav == 0 || msg(c, sel("navigationController")) != panel.nav)) {
            closing: bool = slots[s].closing;
            if (panel.reader_slot == s) panel.reader_slot = -1;
            slot_free(s);
            if (!closing && panel.nav != 0) send1("panelanchor", panel_top_id())
        }
    }
}

// The id of the panel's top screen (0: none).
panel_top_id(): int {
    if (panel.nav == 0) return 0;
    s: int = slot_of_controller(msg(panel.nav, sel("topViewController")));
    if (s < 0) 0 else slots[s].id
}

// A screen shown on the panel's navigation: those a hand popped told.
panel_nav_showed() {
    if (panel.nav == 0) return;
    panel_forget_gone();
    panel_bar_fit()
}

// The panel's bar: none over its reader in a split (the dock is its
// header), the system's over Study (its Back) and in a column.
panel_bar_fit() {
    if (panel.nav == 0) return;
    top: int = msg(panel.nav, sel("topViewController"));
    reader: bool = panel.reader_slot >= 0 && top != 0 && top == slots[panel.reader_slot].controller;
    hide: bool = reader && !panel.column;
    if (truth(msg(panel.nav, sel("isNavigationBarHidden"))) != hide) msg2(panel.nav,
        sel("setNavigationBarHidden:animated:"), if (hide) 1 else 0, 1)
}

// The panel's ground in the look's color (its navigation's and its
// reader's), and its divider's.
panel_ground_dress() {
    if (panel.nav != 0) set_background(msg(panel.nav, sel("view")), colors.page);
    if (panel.reader_slot >= 0 && slots[panel.reader_slot].controller != 0) set_background(msg(slots[panel.reader_slot].controller,
        sel("view")), colors.page);
    panel_divider_dress()
}

// ---- its reader ----
// The reader screen's view: the pane's scroll view, filling it.
panel_reader_install(s: int, view: int) {
    scroll: int = fresh("UIScrollView");
    msg1(scroll, sel("setAutoresizingMask:"), 18);
    set_frame(scroll, bounds_of(view));
    set_background(view, colors.page);
    add_sub(view, scroll);
    panel.reader_slot = s;
    pane_attach(PANE_PANEL, scroll);
    panel_reader_dress(s)
}

// The reader's bar: the chapter and what it reads (a button: Go To aimed
// at the panel), Link at its left, the menu at its right.
panel_reader_dress(s: int) {
    controller: int = slots[s].controller;
    if (controller == 0 || ui_slot != s) return;
    linked = ui.reader_linked;
    // (A split: the dock is its header, dock.l8; its own bar hidden.)
    if (!panel.column) {
        dock_panel_said(s);
        panel_bar_fit();
        return
    }
    item: int = msg(controller, sel("navigationItem"));
    title: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setTitle:"), ui_text(ui.title));
    msg1(config, sel("setSubtitle:"), ui_text(ui.left));
    msg1(config, sel("setTitleAlignment:"), 2);
    msg1(config, sel("setBaseForegroundColor:"), colors.ink);
    msg1(title, sel("setConfiguration:"), config);
    msg3(title, sel("addTarget:action:forControlEvents:"), controller, sel("vellumLeft:"),
        64);
    msg1(item, sel("setTitleView:"), title);
    msg1(item, sel("setLeftBarButtonItem:"), 0);
    msg1(item, sel("setRightBarButtonItem:"), 0);
    // (Link at the outer left, the menu at the outer right: the first tool
    // left, the others right, as the page's dock has its glyphs.)
    for k in 0..ui.tools_n {
        tool: UiTool = ui.tools[k];
        b: int = if (tool.menu.n > 0) tool_menu_item(tool) else bar_item_symbol_ns(ui_text(tool.icon),
            "vellumTool:", controller);
        if (b == 0)
            continue;
        msg1(b, sel("setTag:"), k);
        if (tool.style == UI_TOOL_PROMINENT) msg1(b, sel("setTintColor:"), colors.accent) else msg1(b,
            sel("setTintColor:"), colors.ink);
        // (Off: shown, not tapped; Link on a document read in its own
        // divisions, which can't be linked.)
        if (tool.style == UI_TOOL_OFF) msg1(b, sel("setEnabled:"), 0);
        if (tool.label.n > 0) msg1(b, sel("setAccessibilityLabel:"), ui_text(tool.label));
        if (k == 0 && ui.tools_n > 1) msg1(item, sel("setLeftBarButtonItem:"), b) else msg1(item,
            sel("setRightBarButtonItem:"), b)
    }
    msg2(controller, sel("setToolbarItems:animated:"), 0, 0);
    nav: int = msg(controller, sel("navigationController"));
    if (nav != 0) msg2(nav, sel("setToolbarHidden:animated:"), 1, 0)
}

// A tool with a menu: its items (ARG:TITLE split by |), each its action
// with its argument.
tool_menu_item(tool: UiTool): int {
    kids: int = fresh("NSMutableArray");
    n: int = split_count(&ui, tool.menu);
    for i in 0..n {
        part: int = split_word(&ui, tool.menu, i);
        colon: int = msg1(part, sel("rangeOfString:"), nsstring(":"));
        if (colon >= 0 && colon < ns_length(part)) {
            arg: int = msg(msg1(part, sel("substringToIndex:"), colon), sel("integerValue"));
            words: int = msg1(part, sel("substringFromIndex:"), colon + 1);
            c: int = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
                words, 0, sel("vellumCommand:"), nsnumber_int(tool.action * 1000000 + arg));
            msg1(kids, sel("addObject:"), c)
        }
    }
    menu: int = msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""),
        kids);
    autoreleased(msg2(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:menu:"),
        symbol_image(ui_text(tool.icon), 17.0f64, 5), menu))
}

// The reader's view laid out: the pane's chrome its safe area's (the
// divider's room over it, the dock's at its foot, panel_insets_fit).
panel_reader_layout(controller: int) {
    safe: Insets = safe_insets(msg(controller, sel("view")));
    pane_chrome(PANE_PANEL, safe.top, safe.bottom);
    if (panel_pane.go_c >= 0) pane_settle_soon()
}

// The navigation's safe area made larger in a split: at its top for the
// divider's buttons, at its foot for the dock over it (what of that the
// window's safe area hasn't already). Each as last set (-1: not yet).
panel_inset_top: f64 = -1.0f64;

panel_inset_bottom: f64 = -1.0f64;

panel_insets_fit() {
    nav: int = panel_attached;
    if (nav == 0) return;
    top: f64 = if (panel.column) 0.0f64 else PANEL_DIVIDER_ROOM;
    bottom: f64 = if (panel.column) 0.0f64 else clamp_f(chrome_bottom_cover() - chrome_safe.bottom,
        0.0f64, chrome_bounds.h);
    if (top == panel_inset_top && bottom == panel_inset_bottom) return;
    panel_inset_top = top;
    panel_inset_bottom = bottom;
    msg_insets(nav, sel("setAdditionalSafeAreaInsets:"), top, 0.0f64, bottom, 0.0f64)
}

// ---- the split ----
// Half the divider's height (its touch's, and the room either side of
// its line for its buttons), its buttons' size, and the heights the
// panel settles at (of the window's). The halves are parted by a band
// (colors.split) as tall as PANEL_BAND, each half's corners at it rounded
// as far as PANEL_HALF_CORNER, as two cards side by side: each half's
// words scroll under the band itself.
PANEL_DIVIDER_ROOM: f64 = 22.0f64;

PANEL_BAND: f64 = 8.0f64;

PANEL_HALF_CORNER: f64 = 13.0f64;

PANEL_DIVIDER_BUTTON: f64 = 40.0f64;

PANEL_SNAPS: []f64 = [0.36f64, 0.5f64, 0.64f64];

// The divider and what is on it (made once, held).
panel_divider: int = 0;

// The band (and its corners' room above and below it), the band's own
// color between the halves, and the halves' four corners at it: each a
// square of the band's color at an edge with a disc of the page's ground
// in it, clipped to a quarter (so that each half's words reach the band
// itself, as nothing else of the divider's covers them).
panel_divider_band: int = 0;

panel_divider_gap: int = 0;

panel_divider_corners: []int = new int[4](0);

panel_divider_discs: []int = new int[4](0);

panel_split_glass: int = 0;

panel_split_button: int = 0;

panel_link_glass: int = 0;

panel_link_button: int = 0;

panel_swap_glass: int = 0;

panel_swap_button: int = 0;

// Whether a hand is moving the divider (from where it was), and how many
// of the split's animations are under way (panel_split_animate: one
// taking over from another ends it, and says so, at once).
panel_dragging: bool = false;

panel_drag_from: f64 = 0.0f64;

panel_split_moving: int = 0;

// Whether the split's height is changing (by a hand or in its spring;
// not opening or closing): the linked panes not followed meanwhile, but
// once it is still (panel_settle_fired).
panel_resizing(): bool {
    panel_dragging || panel_split_moving > 0 && !panel_moving
}

panel_divider_make() {
    if (panel_divider != 0) return;
    panel_divider = retain(view_new());
    pan: int = autoreleased(msg2(msg(cls("UIPanGestureRecognizer"), sel("alloc")),
        sel("initWithTarget:action:"), app_obj, sel("vellumDividerPan:")));
    msg1(panel_divider, sel("addGestureRecognizer:"), pan);
    panel_divider_band = retain(view_new());
    msg1(panel_divider_band, sel("setUserInteractionEnabled:"), 0);
    add_sub(panel_divider, panel_divider_band);
    panel_divider_gap = retain(view_new());
    add_sub(panel_divider_band, panel_divider_gap);
    for k in 0..4 {
        corner: int = retain(view_new());
        msg1(corner, sel("setClipsToBounds:"), 1);
        disc: int = retain(view_new());
        set_corners(disc, PANEL_HALF_CORNER);
        add_sub(corner, disc);
        add_sub(panel_divider_band, corner);
        panel_divider_corners[k] = corner;
        panel_divider_discs[k] = disc
    }
    panel_split_glass = retain(glass_view(true));
    add_sub(panel_divider, panel_split_glass);
    panel_split_button = retain(msg1(cls("UIButton"), sel("buttonWithType:"), 1));
    msg3(panel_split_button, sel("addTarget:action:forControlEvents:"), app_obj, sel("vellumSplitTapped:"),
        64);
    button_symbol(panel_split_button, "rectangle.bottomhalf.inset.filled", 18.0f64);
    msg1(panel_split_button, sel("setAccessibilityLabel:"), nsstring("Close Panel"));
    add_sub(glass_content(panel_split_glass), panel_split_button);
    panel_link_glass = retain(glass_view(true));
    add_sub(panel_divider, panel_link_glass);
    panel_link_button = retain(msg1(cls("UIButton"), sel("buttonWithType:"), 1));
    msg3(panel_link_button, sel("addTarget:action:forControlEvents:"), app_obj, sel("vellumDividerLink:"),
        64);
    button_symbol(panel_link_button, "link", 16.0f64);
    add_sub(glass_content(panel_link_glass), panel_link_button);
    panel_swap_glass = retain(glass_view(true));
    add_sub(panel_divider, panel_swap_glass);
    panel_swap_button = retain(msg1(cls("UIButton"), sel("buttonWithType:"), 1));
    msg3(panel_swap_button, sel("addTarget:action:forControlEvents:"), app_obj, sel("vellumDividerSwap:"),
        64);
    button_symbol(panel_swap_button, "arrow.up.arrow.down", 16.0f64);
    msg1(panel_swap_button, sel("setAccessibilityLabel:"), nsstring("Swap Panes"));
    add_sub(glass_content(panel_swap_glass), panel_swap_button);
    panel_divider_dress()
}

// The divider over the panel and the page (under the chrome).
panel_divider_attach() {
    panel_divider_make();
    under: int = if (panel_attached != 0) msg(panel_attached, sel("view")) else page_pane.scroll;
    msg2(root_view, sel("insertSubview:aboveSubview:"), panel_divider, under)
}

panel_divider_remove() {
    if (panel_divider != 0) msg(panel_divider, sel("removeFromSuperview"))
}

// Its colors (the look's), and the link as the panel's reader says it.
panel_divider_dress() {
    if (panel_divider == 0) return;
    set_background(panel_divider_gap, colors.split);
    for k in 0..4 {
        set_background(panel_divider_corners[k], colors.split);
        set_background(panel_divider_discs[k], colors.page)
    }
    for g in [panel_split_glass, panel_link_glass, panel_swap_glass] glass_tint(g,
        dock_tint());
    msg1(panel_split_button, sel("setTintColor:"), colors.accent);
    msg1(panel_swap_button, sel("setTintColor:"), colors.accent);
    set_hidden(panel_swap_glass, !dock_panel_can_swap());
    msg1(panel_link_button, sel("setTintColor:"), if (dock_panel.linked) colors.accent else colors.faint);
    msg1(panel_link_button, sel("setAccessibilityLabel:"), nsstring(if (dock_panel.linked) "Linked" else "Not Linked"));
    set_hidden(panel_link_glass, dock_panel.link_off || dock_panel.link_action == 0)
}

// Where the divider's line is to be: at the top filling the screen, else
// the panel the height chosen (kept), within reach of both.
panel_split_top(): f64 {
    h: f64 = chrome_bounds.h;
    least: f64 = chrome_safe.top + PANEL_DIVIDER_ROOM;
    if (panel.full) return least;
    clamp_f(h - panel_fraction() * h, least + 120.0f64, h - 160.0f64)
}

// The split laid out with the divider's line at top: the panel under it
// (never shorter than it is open, so that coming and going it moves
// rather than being laid out again), the divider about it, its buttons on
// it (the split's hidden while the dock's own is moving: panel_moving).
panel_split_place(top: f64) {
    w: f64 = chrome_bounds.w;
    h: f64 = chrome_bounds.h;
    panel.top = top;
    if (panel_attached != 0) set_frame4(msg(panel_attached, sel("view")), 0.0f64,
        top, w, h - (if (top < panel_split_top()) top else panel_split_top()));
    if (panel_divider == 0) return;
    set_frame4(panel_divider, 0.0f64, top - PANEL_DIVIDER_ROOM, w, 2.0f64 * PANEL_DIVIDER_ROOM);
    r: f64 = PANEL_HALF_CORNER;
    set_frame4(panel_divider_band, 0.0f64, PANEL_DIVIDER_ROOM - PANEL_BAND / 2.0f64 - r,
        w, PANEL_BAND + 2.0f64 * r);
    set_frame4(panel_divider_gap, 0.0f64, r, w, PANEL_BAND);
    // (Upper left and right, the page's; lower left and right, the
    // panel's: each disc's middle where its half's corner's arc is.)
    for k in 0..4 {
        right: bool = k % 2 == 1;
        lower: bool = k >= 2;
        set_frame4(panel_divider_corners[k], if (right) w - r else 0.0f64, if (lower) r + PANEL_BAND else 0.0f64,
            r, r);
        set_frame4(panel_divider_discs[k], if (right) -r else 0.0f64, if (lower) 0.0f64 else -r,
            2.0f64 * r, 2.0f64 * r)
    }
    b: f64 = PANEL_DIVIDER_BUTTON;
    y: f64 = PANEL_DIVIDER_ROOM - b / 2.0f64;
    set_frame4(panel_link_glass, (w - b) / 2.0f64, y, b, b);
    set_corners(panel_link_glass, b / 2.0f64);
    set_frame4(panel_link_button, 0.0f64, 0.0f64, b, b);
    // (Under the dock's panel button's place, so that it goes straight up
    // and down.)
    set_frame4(panel_split_glass, chrome_safe.left + DOCK_SIDE + DOCK_H / 2.0f64 - b / 2.0f64,
        y, b, b);
    set_corners(panel_split_glass, b / 2.0f64);
    set_frame4(panel_split_button, 0.0f64, 0.0f64, b, b);
    // (Swap Panes as far in from the right: the divider symmetrical.)
    set_frame4(panel_swap_glass, w - chrome_safe.right - DOCK_SIDE - DOCK_H / 2.0f64 - b / 2.0f64,
        y, b, b);
    set_corners(panel_swap_glass, b / 2.0f64);
    set_frame4(panel_swap_button, 0.0f64, 0.0f64, b, b);
    set_hidden(panel_split_glass, panel_moving);
    // (Coming up with the button, going down with it.)
    panel_divider_out(!panel_moving || panel.shown)
}

// The divider's band and buttons shown or not (in the split's animation,
// with it).
panel_divider_out(out: bool) {
    set_alpha(panel_divider_band, if (out) 1.0f64 else 0.0f64);
    glass_shown(panel_link_glass, out, true, dock_tint());
    glass_shown(panel_swap_glass, out, true, dock_tint())
}

// ---- the split opening and closing ----
// Each in one spring, from a tap or as a hand lets the divider go: the
// split's button is the dock's own glass meanwhile (dock_morph), going
// between its place in the dock and the divider as the dock goes between
// the page's alone and both readers', and the divider and the panel come
// up from the foot with it or go down off the screen.
panel_moving: bool = false;

// The button's middle in its place in the dock.
panel_slot_y(): f64 {
    r: Rect = dock_panel_button_home();
    r.y + r.h / 2.0f64
}

// Begun with the button at y: the divider's handed to the dock's, the
// dock as it is (both readers' or the page's).
panel_move_begin(y: f64) {
    if (panel_moving) return;
    panel_moving = true;
    if (panel_divider != 0) set_hidden(panel_split_glass, true);
    dock_morph_begin(dock_both(), y)
}

// The button, the divider and the panel at y (in the spring).
panel_move_to(y: f64) {
    panel_split_place(y);
    if (panel_moving) dock_morph(panel.shown, y)
}

// The split opening: the button rising out of the dock, the divider with
// it and the panel coming up from the foot under it, once its reader is
// laid out at its place (the page's foot where the split will put it,
// so that, linked, the rule places it for the page as it will stay).
panel_split_open() {
    panel_divider_attach();
    nav_view: int = msg(panel_attached, sel("view"));
    view_class: int = cls("UIView");
    was: bool = truth(msg(view_class, sel("areAnimationsEnabled")));
    msg1(view_class, sel("setAnimationsEnabled:"), 0);
    panel_move_begin(panel_slot_y());
    panel_split_place(panel_slot_y());
    panel_divider_out(false);
    set_frame4(nav_view, 0.0f64, chrome_bounds.h, chrome_bounds.w, frame_of(nav_view).h);
    msg1(view_class, sel("setAnimationsEnabled:"), if (was) 1 else 0);
    page_chrome_set();
    panel_open_asked_at = CACurrentMediaTime();
    panel_split_open_when_placed()
}

// Its reader laid out at its place (its parts come, no `go` waiting for
// it), or half a second gone: the split's spring. (Closed meanwhile,
// nothing: closing has its own.)
PANEL_OPEN_WAIT_MOST: f64 = 0.5f64;

panel_open_asked_at: f64 = 0.0f64;

panel_split_open_when_placed() {
    if (!panel.shown || panel.column || !panel_moving || panel_split_moving > 0) return;
    placed: bool = pane_ready(PANE_PANEL) && panel_pane.n > 0 && panel_pane.go_c < 0;
    if (!placed && CACurrentMediaTime() - panel_open_asked_at < PANEL_OPEN_WAIT_MOST) {
        _t: int = timer_after(app_obj, 1.0f64 / 60.0f64, "vellumSplitPlaced:");
        return
    }
    panel_split_animate()
}

panel_split_placed_fired(_self: int, _cmd: int, _timer: int): int {
    panel_split_open_when_placed();
    0
}

// The split moved to where it is to be (open, at its height; closed, the
// button home), in a spring carrying on a hand's throw (panel_thrown,
// points a second downwards, spent here): closing, faster and without a
// bounce. The panel's capsule's words go at once closing, come as it has
// grown opening (dock.l8).
panel_thrown: f64 = 0.0f64;

panel_split_animate() {
    if (panel.column || panel_divider == 0) return;
    if (!panel.shown) panel_move_begin(panel.top);
    panel_split_moving = panel_split_moving + 1;
    to: f64 = if (panel.shown) panel_split_top() else panel_slot_y();
    distance: f64 = to - panel.top;
    velocity: f64 = if (abs_f(distance) > 1.0f64) clamp_f(panel_thrown / distance,
        0.0f64, 12.0f64) else 0.0f64;
    panel_thrown = 0.0f64;
    if (panel_moving && !panel.shown) ease(ANIM_DOCK_WORDS_OUT, 0.1f64);
    spring_moving(ANIM_SPLIT, if (panel.shown) 0.5f64 else 0.42f64, if (panel.shown) 0.1f64 else 0.0f64,
        velocity);
    if (panel_moving && panel.shown) ease_after(ANIM_DOCK_WORDS, 0.2f64, 0.22f64)
}

panel_split_animated() {
    if (panel.shown) panel_move_to(panel_split_top()) else {
        panel_split_place(chrome_bounds.h + PANEL_DIVIDER_ROOM);
        dock_morph(false, panel_slot_y())
    }
}

// Settled (the last of them; a hand may have taken over): the button the
// divider's again, open, or the dock's in its place, closed, the panel
// let go; the page's foot told.
panel_split_settled() {
    panel_split_moving = panel_split_moving - 1;
    if (panel_split_moving > 0) return;
    panel_split_moving = 0;
    if (panel_dragging) return;
    if (panel_moving) {
        panel_moving = false;
        dock_morph_end(panel.shown);
        if (panel_divider != 0) set_hidden(panel_split_glass, !panel.shown)
    }
    if (!panel.shown) {
        if (panel_attached != 0) panel_detach_now() else panel_divider_remove()
    }
    panel_settle_soon()
}

// A hand on the divider: it follows, the dock as it is; let go, the
// split settles at the height nearest where it was going (thrown up to
// the top, the panel fills the screen; down to the dock, the split
// closes).
panel_divider_panned(_self: int, _cmd: int, gesture: int): int {
    state: int = msg(gesture, sel("state"));
    // (Ended however it ends: no longer a hand's.)
    if (state >= 3) panel_dragging = false;
    if (panel_attached == 0 || !panel.shown || panel.column) {
        if (state >= 3 && panel_moving) panel_split_animate();
        return 0
    }
    h: f64 = chrome_bounds.h;
    if (state == 1) {
        panel_dragging = true;
        panel_drag_from = panel.top;
        return 0
    }
    geo_of1(gesture, "translationInView:", root_view);
    if (state == 2) {
        panel_split_place(clamp_f(panel_drag_from + geo[1], chrome_safe.top + PANEL_DIVIDER_ROOM,
            h - 40.0f64));
        return 0
    }
    panel_dragging = false;
    geo_of1(gesture, "velocityInView:", root_view);
    panel_thrown = (if (state == 3) geo[1] else 0.0f64);
    panel_divider_let_go(panel.top + geo[1] * 0.15f64, state == 3);
    0
}

// The divider let go, its line going to going (where it would come to,
// thrown; given up, not thrown).
panel_divider_let_go(going: f64, thrown: bool) {
    panel_dragging = false;
    h: f64 = chrome_bounds.h;
    if (going > h * 0.84f64) {
        panel_dragged_away();
        return
    }
    full: bool = thrown && going < chrome_safe.top + PANEL_DIVIDER_ROOM + h * 0.1f64;
    if (!full) panel_fraction_keep(panel_snap_nearest((h - going) / h));
    if (full != panel.full) {
        panel.full = full;
        send0("tap full")
    }
    panel_split_animate()
}

// The settling height nearest fraction (of the window's).
panel_snap_nearest(fraction: f64): f64 {
    best: f64 = PANEL_SNAPS[0];
    for snap in PANEL_SNAPS {
        if (abs_f(snap - fraction) < abs_f(best - fraction)) best = snap
    }
    best
}

// The height chosen, kept on the device (half the window's at first).
PANEL_FRACTION_KEY: str = "VellumPanelFraction";

panel_fraction(): f64 {
    kept: int = msg1(msg(cls("NSUserDefaults"), sel("standardUserDefaults")), sel("objectForKey:"),
        nsstring(PANEL_FRACTION_KEY));
    if (kept != 0 && responds(kept, "doubleValue")) msg_f(kept, sel("doubleValue")) else 0.5f64
}

panel_fraction_keep(fraction: f64) {
    msg1_f(msg(cls("NSUserDefaults"), sel("standardUserDefaults")), sel("setDouble:forKey:"),
        nsstring(PANEL_FRACTION_KEY), fraction)
}

// The split's button tapped: Close Panel, core's.
panel_split_tapped(_self: int, _cmd: int, _sender: int): int {
    haptic_impact(0);
    send0("tap shelf");
    0
}

// Swap Panes on the divider: core's, as the panel's menu has it (what
// each pane reads pictured over it until laid out in the other, pane.l8).
panel_swap_tapped(_self: int, _cmd: int, _sender: int): int {
    if (!panel.shown || dock_panel.slot < 0 || !dock_panel_can_swap()) return 0;
    haptic_impact(0);
    act(dock_panel.slot, dock_panel.menu_action, BESIDE_MENU_SWAP, 0);
    0
}

// The link tapped: linked or not, as the panel's Link does it.
panel_divider_link_tapped(_self: int, _cmd: int, _sender: int): int {
    _l: int = dock_link_tapped(0, 0, 0);
    0
}

// Once the divider has been still a moment: the page's foot what it covers.
panel_settle_due: bool = false;

panel_settle_soon() {
    if (panel_settle_due || app_obj == 0) return;
    panel_settle_due = true;
    _t: int = timer_after(app_obj, 0.15f64, "vellumPanelSettle:")
}

panel_settle_fired(_self: int, _cmd: int, _timer: int): int {
    panel_settle_due = false;
    page_chrome_set();
    if (panel.shown) {
        pane_tell(PANE_PAGE, true);
        pane_tell(PANE_PANEL, true);
        follow_rested(PANE_PAGE)
    }
    0
}

panel_close_tapped(_self: int, _cmd: int, _item: int): int {
    send0("tap shelf");
    0
}

panel_detach_fired(_self: int, _cmd: int, _timer: int): int {
    if (!panel.shown) pane_detach(PANE_PANEL);
    0
}

add_panel_methods(app: int) {
    add_method1(app, sel("vellumPanelDetach:"), &panel_detach_fired, "v@:@");
    add_method1(app, sel("vellumPanelSettle:"), &panel_settle_fired, "v@:@");
    add_method1(app, sel("vellumDividerPan:"), &panel_divider_panned, "v@:@");
    add_method1(app, sel("vellumSplitTapped:"), &panel_split_tapped, "v@:@");
    add_method1(app, sel("vellumSplitPlaced:"), &panel_split_placed_fired, "v@:@");
    add_method1(app, sel("vellumDividerLink:"), &panel_divider_link_tapped, "v@:@");
    add_method1(app, sel("vellumDividerSwap:"), &panel_swap_tapped, "v@:@");
    // (The dock's look at the sheets now and then: dock.l8.)
    add_method1(app, sel("vellumDockSheets:"), &dock_sheets_fired, "v@:@")
}
