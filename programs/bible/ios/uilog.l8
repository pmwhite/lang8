tag bible_ios;

use_tag std, ios, bible, bible_wire;

// A UI-change log for the hot reload build (programs/bible/tools/uilog's
// README): `!uilog on` from the development server (devwire.l8) starts it,
// `!uilog off` ends it and posts it to the server (POST /uilog, saved
// under .build/dev/uilog/). While it is on, each frame (devwire's display
// link) walks the windows' view trees and compares each view a person sees
// as a thing (bars, buttons, rows, labels, text, lists, sheets, hairlines,
// the toast) with the frame before: what appeared or went, moved, faded,
// changed its words, scrolled; the lists' drags and glides and the
// fingers' touches are kept too, so the checker (check.mjs) can tell what
// the app did from what a hand did. Events are JSON lines in the web
// logger's format (uilog.js), points for pixels.
//
// Rectangles are the presentation layers' (what is on the screen during an
// animation), in window coordinates, added up from each layer's frame in
// its parent's bounds (an ancestor's scale or rotation is not applied: a
// sheet's card shrinking the page behind it shows only on the card's own
// frame). A view is reported moved when it moves within the nearest
// reported view holding it (in a list, within its content) and on the
// screen, so a list scrolling is a `scroll`, not a move of every row.
// Text views' insides and controls' parts are not walked.
import "../../ios/objc.l8";

extern NSStringFromClass(c: int): int;

// ---- what is kept ----
// Views reported a frame, at most (more: the walk stops there and says so).
UL_MOST: int = 1500;

// Views looked at a frame, at most (reported or not).
UL_VISITS_MOST: int = 6000;

UL_DEPTH_MOST: int = 48;

// Bytes of a view's words kept for its events (the comparison is of all
// of them, by hash).
UL_TEXT_KEPT: int = 60;

// The log in memory, at most (more: logging stops and the log says why).
UL_BYTES_MOST: int = 48 * 1048576;

// A frame without a visible change, this many in a row, is rest: the
// rectangles on the screen are written once then.
UL_REST_FRAMES: int = 18;

// Kinds of view (check.mjs's kinds).
UL_NONE: int = 0;

UL_BAR: int = 1;

UL_SHEET: int = 2;

UL_TOAST: int = 3;

UL_HAIRLINE: int = 4;

UL_ROW: int = 5;

UL_BUTTON: int = 6;

UL_TEXT: int = 7;

UL_PARA: int = 8;

UL_PANE: int = 9;

// A pane's cover while its document changes (ios/pane.l8's win_cover): a
// picture of what it showed, over it.
UL_COVER: int = 10;

ul_kind_name(kind: int): str {
    if (kind == UL_BAR) "bar" else if (kind == UL_SHEET) "sheet" else if (kind == UL_TOAST) "toast" else if (kind == UL_HAIRLINE) "hairline" else if (kind == UL_ROW) "row" else if (kind == UL_BUTTON) "button" else if (kind == UL_TEXT) "text" else if (kind == UL_PARA) "para" else if (kind == UL_PANE) "pane" else if (kind == UL_COVER) "cover" else "view"
}

// Whether logging is on, since when, and the log so far (an
// NSMutableData of JSON lines).
ul_on: bool = false;

ul_t0: f64 = 0.0f64;

ul_data: int = 0;

ul_frames: int = 0;

ul_quiet: int = 0;

ul_rest_written: bool = false;

// The walks' cost: total and worst, in ms, and the views reported.
ul_walk_total: f64 = 0.0f64;

ul_walk_worst: f64 = 0.0f64;

ul_walk_last_note: f64 = 0.0f64;

// (Kept through a hot reload: one recognizer on the window, whatever the
// build; its target's class is made once, as class_make keeps it.)
persistent ul_touch_target: int = 0;

persistent ul_touch_recognizer: int = 0;

// ---- each frame's views: two banks, this frame's and the last ----
// A view's record at bank * UL_MOST + i.
ul_bank: int = 0;

ul_n: []int = new int[2](0);

ul_view: []int = new int[2 * 1500](0);

// Each record's id in the log: a number given as its view is first seen
// and kept while it is seen again (a view's address is not an id: UIKit
// reuses the address of a view freed for another).
ul_id: []int = new int[2 * 1500](0);

ul_last_id: int = 0;

// Whether the record is a presented controller's view (a sheet, a
// popover, a full-screen cover), as UIKit placed it.
ul_presented_view: []bool = new bool[2 * 1500](false);

ul_class: []int = new int[2 * 1500](0);

ul_kind: []int = new int[2 * 1500](0);

ul_anchor: []int = new int[2 * 1500](0);

ul_anchor_scrolls: []bool = new bool[2 * 1500](false);

ul_rect: []f64 = new f64[2 * 1500 * 4](0.0f64);

ul_rel: []f64 = new f64[2 * 1500 * 2](0.0f64);

ul_visible: []f64 = new f64[2 * 1500 * 4](0.0f64);

ul_alpha: []f64 = new f64[2 * 1500](0.0f64);

ul_scroll: []f64 = new f64[2 * 1500 * 2](0.0f64);

ul_flags: []int = new int[2 * 1500](0);

ul_text_object: []int = new int[2 * 1500](0);

ul_text_hash: []int = new int[2 * 1500](0);

ul_text_n: []int = new int[2 * 1500](0);

ul_text: []i8 = new i8[2 * 1500 * 60](0i8);

// Each record's spoken label, its start (read as its view is first seen,
// so that a view gone, perhaps freed, is never asked for it).
UL_LABEL_KEPT: int = 24;

ul_label_n: []int = new int[2 * 1500](0);

ul_label: []i8 = new i8[2 * 1500 * 24](0i8);

// Whether last frame's record i was seen again this frame.
ul_matched: []bool = new bool[1500](false);

// Flags of a scroll view: a finger on it, gliding.
UL_DRAGGING: int = 1;

UL_DECELERATING: int = 2;

// Last frame's views by address, put at the start of this frame: open
// addressing, each slot stamped with the frame it was put in (no
// clearing).
UL_HASH: int = 4096;

ul_hash_view: []int = new int[4096](0);

ul_hash_index: []int = new int[4096](0);

ul_hash_stamp: []int = new int[4096](0);

ul_hash_put(view: int, index: int) {
    h: int = view / 16 % UL_HASH;
    while (ul_hash_stamp[h] == ul_frames && ul_hash_view[h] != view) h = (h + 1) % UL_HASH;
    ul_hash_view[h] = view;
    ul_hash_index[h] = index;
    ul_hash_stamp[h] = ul_frames
}

// Last frame's record of view, or -1.
ul_hash_get(view: int): int {
    h: int = view / 16 % UL_HASH;
    while (ul_hash_stamp[h] == ul_frames) {
        if (ul_hash_view[h] == view) return ul_hash_index[h];
        h = (h + 1) % UL_HASH
    }
    -1
}

// ---- classes: each one's kind and how it is walked, found once ----
UL_CLASSES: int = 512;

ul_class_key: []int = new int[512](0);

ul_class_kind: []int = new int[513](0);

ul_class_how: []int = new int[513](0);

// How a class's views are walked: their subviews skipped (a control's
// parts, a text view's insides); or a private class of UIKit's (reported
// only if it is a kind of its own: a hairline is not looked for in it).
UL_LEAF: int = 1;

UL_PRIVATE: int = 2;

ul_name_buf: []i8 = new i8[256](0i8);

// (The table full, the slot past its end: walked as a plain view, not
// reported.)
ul_class_slot(c: int): int {
    h: int = c / 8 % UL_CLASSES;
    probes: int = 0;
    while (ul_class_key[h] != 0 && ul_class_key[h] != c) {
        h = (h + 1) % UL_CLASSES;
        probes = probes + 1;
        if (probes >= UL_CLASSES) return UL_CLASSES
    }
    if (ul_class_key[h] == c) return h;
    ul_class_key[h] = c;
    n: int = nsstring_into(NSStringFromClass(c), ul_name_buf);
    kind: int = UL_NONE;
    how: int = if (n > 0 && ul_name_buf[0] as int == 95) UL_PRIVATE else 0;
    // (Subclasses first: a cell before a view, a text view before a list.)
    if (ul_is(c, "UITableViewCell") || ul_is(c, "UICollectionViewCell")) kind = UL_ROW else if (ul_is(c,
        "UITextView")) {
        kind = UL_PARA;
        how = how | UL_LEAF
    } else if (ul_is(c, "UIScrollView")) kind = UL_PANE else if (ul_is(c, "UINavigationBar") || ul_is(c,
        "UIToolbar") || ul_is(c, "UITabBar")) kind = UL_BAR else if (ul_is(c, "UILabel")) {
        kind = UL_TEXT;
        how = how | UL_LEAF
    } else if (ul_is(c, "UIControl")) {
        kind = UL_BUTTON;
        how = how | UL_LEAF
    } else if (ul_is(c, "UIImageView") || ul_is(c, "UIActivityIndicatorView")) how = how | UL_LEAF else if (ul_name_is(n,
        "UILayoutContainerView") || ul_name_is(n, "UIDropShadowView") || ul_name_has(n,
        "Popover") || ul_name_has(n, "ContextMenuContainer") || ul_name_has(n, "SheetView")) kind = UL_SHEET;
    ul_class_kind[h] = kind;
    ul_class_how[h] = how;
    h
}

ul_is(c: int, name: str): bool {
    other: int = cls(name);
    other != 0 && (msg1(c, sel("isSubclassOfClass:"), other) & 255) != 0
}

ul_name_is(n: int, name: str): bool {
    if (n != len(name)) return false;
    for i in 0..n
        if (ul_name_buf[i] != name[i] as i8) return false;
    true
}

ul_name_has(n: int, part: str): bool {
    m: int = len(part);
    for at in 0..n - m + 1 {
        same: bool = true;
        for i in 0..m
            if (ul_name_buf[at + i] != part[i] as i8) same = false;
        if (same) return true
    }
    false
}

// ---- the log's lines ----
ul_line: []i8 = new i8[8192](0i8);

ul_line_n: int = 0;

ul_byte(k: int) {
    if (ul_line_n < len(ul_line)) {
        ul_line[ul_line_n] = k trunc i8;
        ul_line_n = ul_line_n + 1
    }
}

ul_str(s: str) {
    for c in s ul_byte(c as int)
}

ul_int(n: int) {
    if (n < 0) {
        ul_byte(45);
        ul_int(-n);
        return
    }
    if (n >= 10) ul_int(n / 10);
    ul_byte(48 + n % 10)
}

// A number to a tenth.
ul_num(x: f64) {
    if (x < 0.0f64) {
        ul_byte(45);
        ul_num(-x);
        return
    }
    tenths: int = (x * 10.0f64 + 0.5f64) as int;
    ul_int(tenths / 10);
    if (tenths % 10 != 0) {
        ul_byte(46);
        ul_byte(48 + tenths % 10)
    }
}

// Bytes as a JSON string's insides.
ul_escaped(b: []i8, from: int, n: int) {
    for i in from..from + n {
        k: int = b[i] as int & 255;
        if (k == 34 || k == 92) {
            ul_byte(92);
            ul_byte(k)
        } else if (k < 32) ul_byte(32) else ul_byte(k)
    }
}

// A line begun: {"t":MS,"e":"EVENT"
ul_begin(event: str) {
    ul_line_n = 0;
    ul_str("{\"t\":");
    ul_num((CACurrentMediaTime() - ul_t0) * 1000.0f64);
    ul_str(",\"e\":\"");
    ul_str(event);
    ul_str("\"")
}

// The line ended and kept (a line too long for its buffer, cut, is ended
// as valid JSON all the same: only its words were cut).
ul_end() {
    if (ul_line_n > len(ul_line) - 2) ul_line_n = len(ul_line) - 2;
    ul_byte(125);
    ul_byte(10);
    if (ul_data == 0) return;
    if (msg(ul_data, sel("length")) + ul_line_n > UL_BYTES_MOST) {
        note("bible: uilog: the log is full; logging stopped (send !uilog off to post it)");
        ul_stop_walking();
        return
    }
    msg2(ul_data, sel("appendBytes:length:"), bytes_address(ul_line), ul_line_n)
}

ul_field_int(name: str, n: int) {
    ul_str(",\"");
    ul_str(name);
    ul_str("\":");
    ul_int(n)
}

ul_field_num(name: str, x: f64) {
    ul_str(",\"");
    ul_str(name);
    ul_str("\":");
    ul_num(x)
}

ul_rect_field(name: str, at: int) {
    ul_str(",\"");
    ul_str(name);
    ul_str("\":[");
    for k in 0..4 {
        if (k > 0) ul_byte(44);
        ul_num(ul_rect[at * 4 + k])
    }
    ul_str("]")
}

// A record's descriptor: its class, its spoken label, the start of its
// words.
ul_desc_field(at: int) {
    ul_str(",\"d\":\"");
    n: int = nsstring_into(NSStringFromClass(ul_class[at]), ul_name_buf);
    ul_escaped(ul_name_buf, 0, n);
    if (ul_label_n[at] > 0) {
        ul_str(" [");
        ul_escaped(ul_label, at * UL_LABEL_KEPT, ul_label_n[at]);
        ul_str("]")
    }
    if (ul_text_n[at] > 0) {
        ul_str(" \\\"");
        ul_escaped(ul_text, at * UL_TEXT_KEPT, ul_short(ul_text, at * UL_TEXT_KEPT,
            ul_text_n[at], 30));
        ul_str("\\\"")
    }
    ul_str("\"")
}

// Of n bytes at from, how many to show in at most most bytes: cut, if
// cut, before a character, not inside one.
ul_short(
    b: []i8,
    from: int,
    n: int,
    most: int
): int {
    if (n <= most) return n;
    m: int = most;
    while (m > 0 && (b[from + m] as int & 192) == 128) m = m - 1;
    m
}

ul_text_field(name: str, at: int) {
    ul_str(",\"");
    ul_str(name);
    ul_str("\":\"");
    ul_escaped(ul_text, at * UL_TEXT_KEPT, ul_text_n[at]);
    ul_str("\"")
}

// ---- on and off ----
// A wire line: `!uilog on` or `!uilog off` (true: it was one); while on,
// any other kept as an input (a tap the line stands for).
uilog_line(b: []i8, from: int, to: int): bool {
    if (devwire_line_is(b, from, to, "!uilog on")) {
        uilog_start();
        return true
    }
    if (devwire_line_is(b, from, to, "!uilog off")) {
        uilog_stop();
        return true
    }
    if (ul_on) {
        ul_begin("input");
        ul_str(",\"type\":\"wire\",\"detail\":\"");
        ul_escaped(b, from, to - from);
        ul_str("\"");
        ul_end()
    }
    false
}

uilog_start() {
    if (ul_on) return;
    release(ul_data);
    ul_data = make("NSMutableData");
    ul_t0 = CACurrentMediaTime();
    ul_on = true;
    ul_frames = 0;
    ul_last_id = 0;
    ul_quiet = 0;
    ul_rest_written = false;
    ul_n[0] = 0;
    ul_n[1] = 0;
    ul_walk_total = 0.0f64;
    ul_walk_worst = 0.0f64;
    ul_walk_last_note = ul_t0;
    ul_panes_moving = false;
    for p in 0..2 ul_panes_last[p] = -1.0f64;
    for i in 0..3 ul_value_last[i] = -1.0f64;
    l8_msg_hfa(hfa, window, sel("bounds"), 0, 0, 0);
    ul_begin("meta");
    ul_str(",\"platform\":\"ios\",\"viewport\":[");
    ul_num(hfa[2]);
    ul_byte(44);
    ul_num(hfa[3]);
    ul_str("],\"dpr\":");
    ul_num(msg_f(msg(cls("UIScreen"), sel("mainScreen")), sel("scale")));
    ul_end();
    ul_touches_watched();
    note("bible: uilog on")
}

// Logging stopped (the log kept for !uilog off).
ul_stop_walking() {
    ul_on = false;
    release(ul_convert);
    ul_convert = 0;
    if (ul_touch_recognizer != 0) msg1(msg(ul_touch_recognizer, sel("view")), sel("removeGestureRecognizer:"),
        ul_touch_recognizer);
    release(ul_touch_recognizer);
    ul_touch_recognizer = 0
}

// `!uilog off`: logging stopped, the log posted to the server
// (POST /uilog; GET /uilog/latest gives it back), its size and the walks'
// cost written to the log.
uilog_stop() {
    if (ul_data == 0) {
        note("bible: uilog: nothing logged (send !uilog on first)");
        return
    }
    if (ul_on) {
        ul_begin("stop");
        ul_end();
        ul_stop_walking()
    }
    ul_walk_note("bible: uilog off: ");
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), msg1(dw_url, sel("stringByAppendingString:"),
        nsstring("/uilog")));
    request: int = if (url == 0) 0 else msg1(cls("NSMutableURLRequest"), sel("requestWithURL:"),
        url);
    task: int = 0;
    if (request != 0) {
        msg1(request, sel("setHTTPMethod:"), nsstring("POST"));
        msg1(request, sel("setHTTPBody:"), ul_data);
        // (Not one of the app's requests: platform.l8's delegate lets its
        // answer go.)
        task = msg1(dw_session, sel("dataTaskWithRequest:"), request)
    }
    if (task == 0) {
        note("bible: uilog: could not post the log to the server");
        return
    }
    msg(task, sel("resume"));
    tb_n = 0;
    tb_str("bible: uilog: posting ");
    tb_int(msg(ul_data, sel("length")));
    tb_str(" bytes to the server's /uilog");
    note_ns(tb_ns());
    release(ul_data);
    ul_data = 0
}

// The walks' cost so far, to the log.
ul_walk_note(head: str) {
    tb_n = 0;
    tb_str(head);
    tb_str("frames ");
    tb_int(ul_frames);
    tb_str(" views ");
    tb_int(ul_n[ul_bank]);
    tb_str(" walk ms mean ");
    tb_int(if (ul_frames > 0) (ul_walk_total / ul_frames as f64 + 0.5f64) as int else 0);
    tb_str(" worst ");
    tb_int((ul_walk_worst + 0.5f64) as int);
    note_ns(tb_ns())
}

// ---- each frame (devwire_frame) ----
uilog_frame(now: f64) {
    if (!ul_on || window == 0) return;
    started: f64 = CACurrentMediaTime();
    ul_frames = ul_frames + 1;
    // Last frame's views by address; this frame's bank emptied.
    last: int = ul_bank;
    for i in 0..ul_n[last] {
        ul_hash_put(ul_view[last * UL_MOST + i], i);
        ul_matched[i] = false
    }
    ul_bank = 1 - last;
    ul_n[ul_bank] = 0;
    ul_changes = 0;
    ul_visits = 0;
    ul_capped = false;
    ul_presented_found();
    l8_msg_hfa(hfa, window, sel("bounds"), 0, 0, 0);
    ul_screen_w = hfa[2];
    ul_screen_h = hfa[3];
    windows: int = msg(msg(window, sel("windowScene")), sel("windows"));
    count: int = if (windows == 0) 0 else msg(windows, sel("count"));
    if (count == 0) ul_walk_window(window);
    for k in 0..count {
        w: int = msg1(windows, sel("objectAtIndex:"), k);
        if ((msg(w, sel("isHidden")) & 255) == 0 && !ul_keyboard_window(w)) ul_walk_window(w)
    }
    // What was there last frame and isn't now: gone.
    for i in 0..ul_n[last] {
        if (!ul_matched[i]) {
            at: int = last * UL_MOST + i;
            ul_begin("remove");
            ul_field_int("id", ul_id[at]);
            ul_desc_field(at);
            ul_rect_field("r", at);
            ul_end();
            ul_changes = ul_changes + 1
        }
    }
    ul_panes();
    ul_values();
    if (ul_capped) {
        ul_begin("walk");
        ul_field_int("capped", 1);
        ul_field_int("views", ul_n[ul_bank]);
        ul_field_int("visits", ul_visits);
        ul_end()
    }
    if (ul_presented_capped) {
        ul_begin("walk");
        ul_field_int("presented", UL_PRESENTED_MOST);
        ul_end()
    }
    ul_quiet = (if (ul_changes > 0) 0 else ul_quiet + 1);
    if (ul_changes > 0) ul_rest_written = false;
    if (!ul_rest_written && ul_quiet >= UL_REST_FRAMES) {
        ul_rest_written = true;
        ul_rest()
    }
    // (The window's layers are this frame's only: not kept past it.)
    ul_window_layer = 0;
    ul_window_model = 0;
    took: f64 = (CACurrentMediaTime() - started) * 1000.0f64;
    ul_walk_total = ul_walk_total + took;
    if (took > ul_walk_worst) ul_walk_worst = took;
    ul_begin("f");
    ul_field_num("c", took);
    ul_end();
    // (The cost, to the log every five seconds while it runs.)
    if (now - ul_walk_last_note > 5.0f64) {
        ul_walk_last_note = now;
        ul_walk_note("bible: uilog: ")
    }
}

// This frame's walk: changes found, views looked at, whether it stopped at
// a limit, and the window's size.
ul_changes: int = 0;

ul_visits: int = 0;

ul_capped: bool = false;

ul_screen_w: f64 = 0.0f64;

ul_screen_h: f64 = 0.0f64;

// The keyboard's windows (UIKit's, not the app's).
ul_keyboard_window(w: int): bool {
    n: int = nsstring_into(NSStringFromClass(object_getClass(w)), ul_name_buf);
    ul_name_has(n, "Keyboard") || ul_name_has(n, "TextEffects")
}

// Where a view's parent is and what holds it: the parent's window
// position and bounds' origin and its opacity; the nearest reported view
// above (its log id; 0: none), whether it is a list, and its position (in
// its content, for a list); the parent's own layer; and the rectangle that
// clips what is in sight.
type UlFrom = {
    x: f64;
    y: f64;
    bx: f64;
    by: f64;
    alpha: f64;
    anchor: int;
    anchor_scrolls: bool;
    ax: f64;
    ay: f64;
    layer: int;
    clip_x0: f64;
    clip_y0: f64;
    clip_x1: f64;
    clip_y1: f64
}

ul_walk_window(w: int) {
    layer: int = ul_layer(w);
    ul_window_layer = layer;
    ul_window_model = msg(w, sel("layer"));
    l8_msg_hfa(hfa, layer, sel("frame"), 0, 0, 0);
    x: f64 = hfa[0];
    y: f64 = hfa[1];
    from: UlFrom = UlFrom {
        x: x,
        y: y,
        bx: 0.0f64,
        by: 0.0f64,
        alpha: msg_f(w, sel("alpha")),
        anchor: 0,
        anchor_scrolls: false,
        ax: 0.0f64,
        ay: 0.0f64,
        layer: msg(w, sel("layer")),
        clip_x0: 0.0f64,
        clip_y0: 0.0f64,
        clip_x1: ul_screen_w,
        clip_y1: ul_screen_h
    };
    ul_walk_children(w, from, 0)
}

// A view's layer as shown: its presentation layer (the model's before
// one is made).
ul_layer(v: int): int {
    layer: int = msg(v, sel("layer"));
    shown: int = msg(layer, sel("presentationLayer"));
    if (shown != 0) shown else layer
}

ul_walk_children(v: int, from: UlFrom, depth: int) {
    subs: int = msg(v, sel("subviews"));
    n: int = if (subs == 0) 0 else msg(subs, sel("count"));
    for k in 0..n {
        if (ul_capped) return;
        ul_walk(msg1(subs, sel("objectAtIndex:"), k), from, depth)
    }
}

ul_walk(v: int, from: UlFrom, depth: int) {
    ul_visits = ul_visits + 1;
    if (ul_visits > UL_VISITS_MOST || depth > UL_DEPTH_MOST) {
        ul_capped = true;
        return
    }
    if ((msg(v, sel("isHidden")) & 255) != 0) return;
    c: int = object_getClass(v);
    slot: int = ul_class_slot(c);
    kind: int = ul_class_kind[slot];
    how: int = ul_class_how[slot];
    model: int = msg(v, sel("layer"));
    layer: int = ul_layer(v);
    l8_msg_hfa(hfa, layer, sel("frame"), 0, 0, 0);
    x: f64 = from.x + hfa[0] - from.bx;
    y: f64 = from.y + hfa[1] - from.by;
    w: f64 = hfa[2];
    h: f64 = hfa[3];
    // (A presented controller's view, or a view whose layer UIKit has put
    // under layers of its own rather than its superview's (iOS 26's panel
    // sheet, whose height above the window's foot is in such a layer):
    // where the screen shows it, converted through every layer above it,
    // their transforms (a zoom's) included. What it holds is placed from
    // there.)
    presented: bool = ul_is_presented(v);
    if (presented) kind = UL_SHEET;
    if ((presented || msg(model, sel("superlayer")) != from.layer) && ul_window_rect(layer,
        model)) {
        x = ul_convert_out[0];
        y = ul_convert_out[1];
        w = ul_convert_out[2];
        h = ul_convert_out[3]
    }
    l8_msg_hfa(hfa, layer, sel("bounds"), 0, 0, 0);
    bx: f64 = hfa[0];
    by: f64 = hfa[1];
    // (Opacity: the model's, unless an animation runs on the layer.)
    alpha: f64 = msg_f(v, sel("alpha"));
    if (msg(model, sel("animationKeys")) != 0) alpha = msg_f(msg1(layer, sel("valueForKey:"),
        nsstring("opacity")), sel("doubleValue"));
    alpha = alpha * from.alpha;
    if (v == toast_label) kind = UL_TOAST;
    if (msg(v, sel("tag")) == PANE_COVER_TAG) {
        kind = UL_COVER;
        how = how | UL_LEAF
    }
    if (kind == UL_NONE && (how & UL_PRIVATE) == 0 && h <= 1.5f64 && w >= 16.0f64) kind = UL_HAIRLINE;
    next: UlFrom = from;
    next.x = x;
    next.y = y;
    next.bx = bx;
    next.by = by;
    next.alpha = alpha;
    next.layer = model;
    if (kind != UL_NONE) {
        if (ul_n[ul_bank] >= UL_MOST) {
            ul_capped = true;
            return
        }
        next.anchor = ul_record(v, c, kind, x, y, w, h, alpha, from, bx, by, presented);
        next.anchor_scrolls = kind == UL_PANE;
        next.ax = x;
        next.ay = y;
        if (kind == UL_PANE) {
            next.ax = x - bx;
            next.ay = y - by;
            if (x > next.clip_x0) next.clip_x0 = x;
            if (y > next.clip_y0) next.clip_y0 = y;
            if (x + w < next.clip_x1) next.clip_x1 = x + w;
            if (y + h < next.clip_y1) next.clip_y1 = y + h
        }
    }
    if ((how & UL_LEAF) == 0) ul_walk_children(v, next, depth + 1)
}

// View v seen this frame: recorded, and compared with last frame's record
// of it.
ul_record(
    v: int,
    c: int,
    kind: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    alpha: f64,
    from: UlFrom,
    bx: f64,
    by: f64,
    presented: bool
): int {
    i: int = ul_n[ul_bank];
    ul_n[ul_bank] = i + 1;
    at: int = ul_bank * UL_MOST + i;
    ul_view[at] = v;
    ul_class[at] = c;
    ul_kind[at] = kind;
    ul_anchor[at] = from.anchor;
    ul_anchor_scrolls[at] = from.anchor_scrolls;
    ul_rect[at * 4] = x;
    ul_rect[at * 4 + 1] = y;
    ul_rect[at * 4 + 2] = w;
    ul_rect[at * 4 + 3] = h;
    ul_rel[at * 2] = x - from.ax;
    ul_rel[at * 2 + 1] = y - from.ay;
    // (In sight: within the window and the lists holding it.)
    vx0: f64 = if (x > from.clip_x0) x else from.clip_x0;
    vy0: f64 = if (y > from.clip_y0) y else from.clip_y0;
    vx1: f64 = if (x + w < from.clip_x1) x + w else from.clip_x1;
    vy1: f64 = if (y + h < from.clip_y1) y + h else from.clip_y1;
    ul_visible[at * 4] = vx0;
    ul_visible[at * 4 + 1] = vy0;
    ul_visible[at * 4 + 2] = vx1 - vx0;
    ul_visible[at * 4 + 3] = vy1 - vy0;
    ul_alpha[at] = alpha;
    ul_scroll[at * 2] = bx;
    ul_scroll[at * 2 + 1] = by;
    flags: int = 0;
    if (kind == UL_PANE) {
        if ((msg(v, sel("isDragging")) & 255) != 0) flags = flags | UL_DRAGGING;
        if ((msg(v, sel("isDecelerating")) & 255) != 0) flags = flags | UL_DECELERATING
    }
    ul_flags[at] = flags;
    li: int = ul_hash_get(v);
    // (An address reused by a view of another class: another view.)
    if (li >= 0 && ul_class[(1 - ul_bank) * UL_MOST + li] != c) li = -1;
    old: int = if (li >= 0) (1 - ul_bank) * UL_MOST + li else -1;
    if (li >= 0) ul_matched[li] = true;
    ul_presented_view[at] = presented;
    if (old >= 0) ul_id[at] = ul_id[old] else {
        ul_last_id = ul_last_id + 1;
        ul_id[at] = ul_last_id
    }
    ul_words(v, kind, at, old);
    ul_label_kept(v, at, old);
    if (old < 0) ul_added(at) else ul_compared(at, old);
    ul_id[at]
}

// View v's spoken label's start kept for record at: read once, as the view
// is first seen (old < 0), else last frame's record's.
ul_label_kept(v: int, at: int, old: int) {
    n: int = 0;
    if (old >= 0) {
        n = ul_label_n[old];
        for k in 0..n ul_label[at * UL_LABEL_KEPT + k] = ul_label[old * UL_LABEL_KEPT + k]
    } else {
        label: int = msg(v, sel("accessibilityLabel"));
        if (label != 0 && msg(label, sel("length")) > 0) {
            whole: int = nsstring_into(label, ul_name_buf);
            n = ul_short(ul_name_buf, 0, whole, UL_LABEL_KEPT);
            for k in 0..n ul_label[at * UL_LABEL_KEPT + k] = ul_name_buf[k]
        }
    }
    ul_label_n[at] = n
}

// A label's or button's words, read again only when its string is another
// object; a text view's start, read when it first shows.
ul_words(
    v: int,
    kind: int,
    at: int,
    old: int
) {
    ns: int = 0;
    if (kind == UL_TEXT) ns = msg(v, sel("text")) else if (kind == UL_BUTTON && (msg1(v,
        sel("isKindOfClass:"), cls("UIButton")) & 255) != 0) ns = msg(v, sel("currentTitle")) else if (kind == UL_PARA && old < 0) {
        whole: int = msg(v, sel("text"));
        if (whole != 0 && msg(whole, sel("length")) > 40) ns = msg1(whole, sel("substringToIndex:"),
            40) else ns = whole
    } else if (kind == UL_PARA) ns = ul_text_object[old];
    ul_text_object[at] = ns;
    if (old >= 0 && ns == ul_text_object[old]) {
        ul_text_hash[at] = ul_text_hash[old];
        ul_text_n[at] = ul_text_n[old];
        for k in 0..ul_text_n[old] ul_text[at * UL_TEXT_KEPT + k] = ul_text[old * UL_TEXT_KEPT + k];
        return
    }
    n: int = if (ns == 0) 0 else nsstring_into(ns, tb_ns_buf);
    hash: int = 5381;
    for k in 0..n hash = (hash * 33 + (tb_ns_buf[k] as int & 255)) % 1000000007;
    ul_text_hash[at] = hash;
    kept: int = ul_short(tb_ns_buf, 0, n, UL_TEXT_KEPT);
    ul_text_n[at] = kept;
    for k in 0..kept ul_text[at * UL_TEXT_KEPT + k] = tb_ns_buf[k]
}

ul_on_screen(at: int): bool {
    ul_visible[at * 4 + 2] > 0.0f64 && ul_visible[at * 4 + 3] > 0.0f64
}

ul_added(at: int) {
    ul_begin("add");
    ul_field_int("id", ul_id[at]);
    ul_str(",\"k\":\"");
    ul_str(ul_kind_name(ul_kind[at]));
    ul_str("\"");
    ul_desc_field(at);
    ul_rect_field("r", at);
    ul_field_num("o", ul_alpha[at]);
    if (ul_text_n[at] > 0) ul_text_field("tx", at);
    if (!ul_on_screen(at)) ul_field_int("off", 1);
    if (ul_frames == 1) ul_field_int("base", 1);
    if (ul_presented_view[at]) ul_field_int("pv", 1);
    if (ul_anchor[at] != 0) ul_field_int("a", ul_anchor[at]);
    if (ul_anchor_scrolls[at]) ul_field_int("sc", 1);
    if (ul_kind[at] == UL_PANE) {
        ul_str(",\"s\":[");
        ul_num(ul_scroll[at * 2]);
        ul_byte(44);
        ul_num(ul_scroll[at * 2 + 1]);
        ul_str("]")
    }
    ul_end();
    if (ul_frames > 1) ul_changes = ul_changes + 1
}

ul_differs(a: f64, b: f64): bool {
    a - b >= 0.5f64 || b - a >= 0.5f64
}

ul_compared(at: int, old: int) {
    if (ul_on_screen(at) || ul_on_screen(old)) {
        relative: bool = ul_differs(ul_rel[at * 2], ul_rel[old * 2]) || ul_differs(ul_rel[at * 2 + 1],
            ul_rel[old * 2 + 1]) || ul_differs(ul_rect[at * 4 + 2], ul_rect[old * 4 + 2]) || ul_differs(ul_rect[at * 4 + 3],
            ul_rect[old * 4 + 3]);
        on_screen: bool = ul_differs(ul_rect[at * 4], ul_rect[old * 4]) || ul_differs(ul_rect[at * 4 + 1],
            ul_rect[old * 4 + 1]) || ul_differs(ul_rect[at * 4 + 2], ul_rect[old * 4 + 2]) || ul_differs(ul_rect[at * 4 + 3],
            ul_rect[old * 4 + 3]);
        if (relative && on_screen) {
            ul_begin("move");
            ul_field_int("id", ul_id[at]);
            ul_desc_field(at);
            ul_rect_field("r", at);
            ul_field_num("dx", ul_rel[at * 2] - ul_rel[old * 2]);
            ul_field_num("dy", ul_rel[at * 2 + 1] - ul_rel[old * 2 + 1]);
            ul_field_num("dw", ul_rect[at * 4 + 2] - ul_rect[old * 4 + 2]);
            ul_field_num("dh", ul_rect[at * 4 + 3] - ul_rect[old * 4 + 3]);
            ul_end();
            ul_changes = ul_changes + 1
        }
        if (ul_alpha[at] - ul_alpha[old] >= 0.02f64 || ul_alpha[old] - ul_alpha[at] >= 0.02f64) {
            ul_begin("fade");
            ul_field_int("id", ul_id[at]);
            ul_desc_field(at);
            ul_field_num("from", ul_alpha[old]);
            ul_field_num("to", ul_alpha[at]);
            ul_end();
            ul_changes = ul_changes + 1
        }
        if (ul_text_hash[at] != ul_text_hash[old]) {
            ul_begin("text");
            ul_field_int("id", ul_id[at]);
            ul_desc_field(at);
            ul_text_field("from", old);
            ul_text_field("to", at);
            ul_end();
            ul_changes = ul_changes + 1
        }
    }
    if (ul_kind[at] == UL_PANE) {
        if (ul_differs(ul_scroll[at * 2 + 1], ul_scroll[old * 2 + 1]) || ul_differs(ul_scroll[at * 2],
            ul_scroll[old * 2])) {
            ul_begin("scroll");
            ul_field_int("id", ul_id[at]);
            ul_desc_field(at);
            ul_field_num("from", ul_scroll[old * 2 + 1]);
            ul_field_num("to", ul_scroll[at * 2 + 1]);
            if (ul_differs(ul_scroll[at * 2], ul_scroll[old * 2])) {
                ul_field_num("fromx", ul_scroll[old * 2]);
                ul_field_num("tox", ul_scroll[at * 2])
            }
            ul_end();
            ul_changes = ul_changes + 1
        }
        // A finger on a list, or its glide, begun or ended: the hand's.
        ul_flag_input(at, old, UL_DRAGGING, "drag-start", "drag-end");
        ul_flag_input(at, old, UL_DECELERATING, "decel-start", "decel-end")
    }
}

ul_flag_input(
    at: int,
    old: int,
    flag: int,
    began: str,
    ended: str
) {
    now: bool = (ul_flags[at] & flag) != 0;
    was: bool = (ul_flags[old] & flag) != 0;
    if (now == was) return;
    ul_begin("input");
    ul_str(",\"type\":\"");
    if (now) ul_str(began) else ul_str(ended);
    ul_str("\"");
    ul_field_int("id", ul_id[at]);
    ul_field_int("pane", ul_pane_of_view(ul_view[at]));
    ul_end()
}

// Which pane a list is: 0 the page, 1 the panel's reader, -1 another.
ul_pane_of_view(v: int): int {
    for p in 0..PANES
        if (v != 0 && win_table[p] == v) return p;
    -1
}

// ---- at rest ----
// Each view in sight, its rectangle, whether its words are cut off (a
// one-line label narrower than its words), and the part of it in sight.
ul_rest() {
    ul_begin("rest");
    ul_str(",\"items\":[");
    first: bool = true;
    for i in 0..ul_n[ul_bank] {
        at: int = ul_bank * UL_MOST + i;
        if (!ul_on_screen(at) || ul_alpha[at] < 0.05f64)
            continue;
        if (!first) ul_byte(44);
        first = false;
        ul_byte(91);
        ul_int(ul_id[at]);
        for k in 0..4 {
            ul_byte(44);
            ul_num(ul_rect[at * 4 + k])
        }
        ul_byte(44);
        ul_int(ul_clipped(at));
        ul_str(",[");
        for k in 0..4 {
            if (k > 0) ul_byte(44);
            ul_num(ul_visible[at * 4 + k])
        }
        ul_str("]]")
    }
    ul_str("]");
    ul_end()
}

// Whether a one-line label's words are wider than it: 0 not; 1 cut where
// its box ends; 2 shortened with an ellipsis (its line break mode
// truncates: NSLineBreakByTruncatingHead, Tail or Middle, 3 to 5), which
// says so.
UL_FITS: int = 0;

UL_CUT: int = 1;

UL_ELLIPSIS: int = 2;

ul_clipped(at: int): int {
    if (ul_kind[at] != UL_TEXT || ul_text_n[at] == 0) return UL_FITS;
    v: int = ul_view[at];
    if (msg(v, sel("numberOfLines")) != 1) return UL_FITS;
    l8_msg_hfa(hfa, v, sel("intrinsicContentSize"), 0, 0, 0);
    if (hfa[0] <= ul_rect[at * 4 + 2] + 1.0f64) return UL_FITS;
    mode: int = msg(v, sel("lineBreakMode"));
    if (mode >= 3 && mode <= 5) UL_ELLIPSIS else UL_CUT
}

// ---- the two panes ----
// While the panel's reader shows beside the page, each frame either one's
// offset changed (and the frame after, which shows it stopped): both
// offsets, and each one's place at its reading line as CHAPTER:aANCHOR.FF
// (the anchor whose span holds the line, and how far through it).
ul_panes_last: []f64 = new f64[2](-1.0f64);

ul_panes_moving: bool = false;

ul_panes() {
    if (!bs_shown || win_table[PANE_PAGE] == 0 || win_table[PANE_PANEL] == 0) return;
    page: f64 = offset_y(win_table[PANE_PAGE]);
    panel: f64 = offset_y(win_table[PANE_PANEL]);
    moved: bool = page != ul_panes_last[0] || panel != ul_panes_last[1];
    if (!moved && !ul_panes_moving) return;
    ul_panes_moving = moved;
    ul_panes_last[0] = page;
    ul_panes_last[1] = panel;
    ul_begin("panes");
    ul_str(",\"p\":[");
    ul_num(page);
    ul_byte(44);
    ul_num(panel);
    ul_str("],\"at\":[");
    ul_place(PANE_PAGE);
    ul_byte(44);
    ul_place(PANE_PANEL);
    ul_str("]");
    ul_end()
}

// Numbers that shape what shows, as they change (iOS 26's panel,
// ios/inspector.l8): the page's bottom inset, set at the sheet's settle,
// how much of the window's foot the sheet covers, each frame, and the top
// of the page-colored cover under the floating sheet (-1: none).
ul_value_last: []f64 = new f64[3](-1.0f64);

ul_values() {
    ul_value(0, "page-inset", if (table == 0) 0.0f64 else bottom_inset(table));
    ul_value(1, "sheet-cover", ins_cover_measure());
    ul_value(2, "gap-top", ins_gap_top())
}

ul_value(i: int, name: str, v: f64) {
    if (v == ul_value_last[i]) return;
    ul_value_last[i] = v;
    ul_begin("value");
    ul_str(",\"n\":\"");
    ul_str(name);
    ul_str("\",\"v\":");
    ul_num(v);
    ul_end()
}

// (win_place notes the place it finds as the pane's spot, kept for the
// pane's next layout: the pane's own spot put back after.)
ul_place(p: int) {
    spot_c: int = win_spot_c[p];
    spot_k: int = win_spot_k[p];
    spot_part: f64 = win_spot_part[p];
    at: WinPlace = win_place(p);
    win_spot_c[p] = spot_c;
    win_spot_k[p] = spot_k;
    win_spot_part[p] = spot_part;
    if (!at.ok) {
        ul_str("null");
        return
    }
    ul_byte(34);
    ul_int(at.c);
    ul_str(":a");
    ul_int(at.i);
    hundredths: int = (at.part * 100.0f64) as int;
    if (hundredths > 99) hundredths = 99;
    if (hundredths < 0) hundredths = 0;
    ul_byte(46);
    ul_byte(48 + hundredths / 10);
    ul_byte(48 + hundredths % 10);
    ul_byte(34)
}

// ---- touches ----
// A recognizer on the window that sees every touch and stops none (a long
// press of no duration, recognized with any other), its target an object
// of a class of its own; each touch's start, movement (once a frame) and
// end kept as an input, with which pane it is in.
ul_touches_watched() {
    if (ul_touch_target == 0) {
        target_class: int = class_make(cls("NSObject"), "L8UilogTouches");
        add_method1(target_class, sel("uilogTouched:"), &uilog_touched, "v@:@");
        add_method2(target_class, sel("gestureRecognizer:shouldRecognizeSimultaneouslyWithGestureRecognizer:"),
            &uilog_together, "B@:@@");
        ul_touch_target = keep(msg(msg(cls("L8UilogTouches"), sel("alloc")), sel("init")))
    }
    if (ul_touch_recognizer != 0) return;
    g: int = msg2(msg(cls("UILongPressGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        ul_touch_target, sel("uilogTouched:"));
    msg_set_f(g, sel("setMinimumPressDuration:"), 0.0f64);
    msg_set_f(g, sel("setAllowableMovement:"), 100000.0f64);
    msg1(g, sel("setCancelsTouchesInView:"), 0);
    msg1(g, sel("setDelaysTouchesBegan:"), 0);
    msg1(g, sel("setDelaysTouchesEnded:"), 0);
    msg1(g, sel("setDelegate:"), ul_touch_target);
    msg1(window, sel("addGestureRecognizer:"), g);
    ul_touch_recognizer = g
}

ul_touch_frame: int = -1;

uilog_touched(_self: int, _cmd: int, g: int): int {
    if (!ul_on) return 0;
    state: int = msg(g, sel("state"));
    // (UIGestureRecognizerState: began 1, changed 2, ended 3, cancelled 4.)
    if (state == 2 && ul_touch_frame == ul_frames) return 0;
    if (state == 2) ul_touch_frame = ul_frames;
    l8_msg_hfa(hfa, g, sel("locationInView:"), 0, 0, 0);
    x: f64 = hfa[0];
    y: f64 = hfa[1];
    ul_begin("input");
    ul_str(",\"type\":\"");
    ul_str(if (state == 1) "touchstart" else if (state == 2) "touchmove" else "touchend");
    ul_str("\"");
    ul_field_num("x", x);
    ul_field_num("y", y);
    ul_field_int("pane", ul_pane_at(x, y));
    ul_end();
    0
}

uilog_together(
    _self: int,
    _cmd: int,
    _a: int,
    _b: int
): int {
    1
}

// The pane under a point: the panel's reader if it is within its list's
// rectangle (as last walked), else the page.
ul_pane_at(x: f64, y: f64): int {
    panel: int = win_table[PANE_PANEL];
    if (panel == 0 || !bs_shown) return 0;
    for i in 0..ul_n[ul_bank] {
        at: int = ul_bank * UL_MOST + i;
        if (ul_view[at] == panel) {
            inside: bool = x >= ul_visible[at * 4] && x < ul_visible[at * 4] + ul_visible[at * 4 + 2] && y >= ul_visible[at * 4 + 1] && y < ul_visible[at * 4 + 1] + ul_visible[at * 4 + 3];
            return if (inside) 1 else 0
        }
    }
    0
}

// The next sheet presented grows from its control (iOS 26's zoom, set by
// sheets.l8's sheet_zoom_from): a zoom the walk can't see (UIKit draws it
// where the walk doesn't reach), so the log says so for the checker.
uilog_zoom() {
    if (!ul_on) return;
    ul_begin("zoom");
    ul_end()
}

// ---- where the screen shows a view ----
// CALayer's convertRect:toLayer: (0 until first wanted; let go as logging
// stops), the layer of the window being walked (its presentation), and the
// last rectangle converted.
ul_convert: int = 0;

ul_window_layer: int = 0;

ul_window_model: int = 0;

ul_convert_out: []f64 = new f64[4](0.0f64);

// Shown layer's bounds in the window's points, through every presentation
// layer above it and their transforms, to ul_convert_out; false if it
// can't be converted.
// (Within one tree: a presentation layer to the window's presentation; a
// layer that has none yet, added this frame (model is layer), to the
// window's own.)
// Only a layer in the window's tree is converted (a frame where it is
// not, as a sheet is moved between UIKit's containers, would give a rect
// against another root: the walk's sum is used then). The tree is the
// model layers' (their objects last; a presentation copy is made anew).
ul_window_rect(layer: int, model: int): bool {
    if (ul_convert == 0) ul_convert = rect_object_invocation(layer, "convertRect:toLayer:");
    target: int = if (layer == model) ul_window_model else ul_window_layer;
    if (ul_convert == 0 || target == 0 || ul_window_model == 0) return false;
    above: int = msg(model, sel("superlayer"));
    depth: int = 0;
    while (above != 0 && above != ul_window_model && depth < UL_DEPTH_MOST * 2) {
        above = msg(above, sel("superlayer"));
        depth = depth + 1
    }
    if (above != ul_window_model) return false;
    l8_msg_hfa(hfa, layer, sel("bounds"), 0, 0, 0);
    rect_object_invoke(ul_convert, layer, hfa[0], hfa[1], hfa[2], hfa[3], target,
        ul_convert_out)
}

// The presented controllers' views this frame (each sheet, popover or
// cover UIKit shows over the window's root, the panel's sheet among them),
// found as the frame begins.
UL_PRESENTED_MOST: int = 8;

ul_presented: []int = new int[UL_PRESENTED_MOST](0);

ul_presented_n: int = 0;

// Whether there were more presented than that (the walk says so).
ul_presented_capped: bool = false;

ul_presented_found() {
    ul_presented_n = 0;
    root: int = if (window == 0) 0 else msg(window, sel("rootViewController"));
    shown: int = if (root == 0) 0 else msg(root, sel("presentedViewController"));
    while (shown != 0 && ul_presented_n < UL_PRESENTED_MOST) {
        controller: int = msg(shown, sel("presentationController"));
        view: int = if (controller == 0) 0 else msg(controller, sel("presentedView"));
        if (view != 0) {
            ul_presented[ul_presented_n] = view;
            ul_presented_n = ul_presented_n + 1
        }
        shown = msg(shown, sel("presentedViewController"))
    }
    ul_presented_capped = shown != 0
}

ul_is_presented(v: int): bool {
    for i in 0..ul_presented_n
        if (ul_presented[i] == v) return true;
    false
}
