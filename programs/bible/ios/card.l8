tag bible_ios;

use_tag std, ios, bible, bible_wire;

// Share as Image's card (core/share.l8's CUSTOM_CARD row): its words set
// by their runs at the largest size from core's most to least that fits
// above the reference, drawn at the card's pixels, shown in the composer
// and kept for Share Image (share_image).
import "../../ios/objc.l8";

import "../core/share.l8";

// The card last drawn (a UIImage, kept), and its width over its height.
card_image: int = 0;

// Core's measures (the row's trailing): W H MARGIN GAP REF VERSION MOST
// LEAST STEP.
card_measures: []int = new int[9](0);

card_measures_read(row: UiRow) {
    for j in 0..len(card_measures) card_measures[j] = 0;
    j: int = 0;
    n: int = 0;
    digits: bool = false;
    for x in row.trailing.at..row.trailing.at + row.trailing.n + 1 {
        c: int = if (x < row.trailing.at + row.trailing.n) uk_ui.pool[x] as int else 32;
        if (c >= 48 && c <= 57) {
            n = n * 10 + c - 48;
            digits = true
        } else if (digits) {
            if (j >= len(card_measures)) wire_fail("core's card has too many measures");
            card_measures[j] = n;
            j = j + 1;
            n = 0;
            digits = false
        }
    }
    if (j < len(card_measures)) wire_fail("core's card has too few measures")
}

// Its colors (the row's options): the page's, the words', the faint's,
// the accent's.
card_color(row: UiRow, j: int): int {
    at: int = pool_part_at(row.options, j);
    if (at < 0) wire_fail("core's card has too few colors");
    hex_color_at(uk_ui.pool, at, at + pool_part_n)
}

// Whether its words are Hebrew (right to left: a run says so).
card_rtl(row: UiRow): bool {
    for x in 0..row.runs_n
        if ((uk_ui.runs[row.runs + x * 2 + 1] - RUN_CARD & 32) != 0) return true;
    false
}

// The words at size s: each run in its face (the reader's; New York for
// Greek, the system's for Hebrew, larger; italic where supplied; a verse's
// number smaller, faint and raised), His words in the accent, lines 1.35
// high (1.5 in Hebrew), an indented line 40 in.
card_text(row: UiRow, s: f64, rtl: bool): int {
    a: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    text: int = uk_text(row.detail);
    if (text == 0) return a;
    ink: int = card_color(row, 1);
    faint: int = card_color(row, 2);
    accent: int = card_color(row, 3);
    from: int = 0;
    total: int = msg(text, sel("length"));
    for x in 0..row.runs_n + 1 {
        e: int = if (x < row.runs_n) uk_ui.runs[row.runs + x * 2] else total;
        st: int = if (x < row.runs_n) uk_ui.runs[row.runs + x * 2 + 1] - RUN_CARD else 0;
        if (e > total) e = total;
        if (e > from) {
            k: int = st & 7;
            size: f64 = if ((st & 64) != 0) s * 0.8f64 else s;
            font: int = if (k == 4) sans(s * 0.6f64, 0.0f64) else if ((st & 32) != 0) sans(s * 1.15f64,
                0.0f64) else if ((st & 16) != 0) new_york(size) else if (k == 1 || k == 3) italic(size) else body(size);
            color: int = if (k == 4) faint else if (k == 2 || k == 3) accent else ink;
            indent: f64 = if ((st & 8) != 0) 40.0f64 else 0.0f64;
            p: int = msg(para_style(if (rtl) 2 else 0, indent, indent, 0.0f64, s * 0.25f64,
                if (rtl) 1.5f64 else 1.35f64), sel("autorelease"));
            if (rtl) msg1(p, sel("setBaseWritingDirection:"), 1);
            at: int = msg(a, sel("length"));
            cmp_put(a, msg2(text, sel("substringWithRange:"), from, e - from), font,
                color, p);
            if (k == 4) msg4(a, sel("addAttribute:value:range:"), k_baseline, nsnumber_f(s * 0.3f64),
                at, msg(a, sel("length")) - at)
        }
        from = e
    }
    a
}

// The reference (semibold, in the accent) then the version (faint), at the
// right under Hebrew.
card_reference(row: UiRow, rtl: bool): int {
    a: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    append(a, uk_text(row.title), sans(card_measures[4] as f64, 0.3f64), card_color(row,
        3));
    append(a, nsstring(" "), sans(card_measures[5] as f64, 0.0f64), card_color(row,
        2));
    if (row.suffix.n > 0) append(a, uk_text(row.suffix), sans(card_measures[5] as f64,
        0.0f64), card_color(row, 2));
    if (rtl) {
        p: int = msg(make("NSMutableParagraphStyle"), sel("autorelease"));
        msg1(p, sel("setAlignment:"), 2);
        msg4(a, sel("addAttribute:value:range:"), k_para, p, 0, msg(a, sel("length")))
    }
    a
}

// The height of a text set w wide.
card_text_height(a: int, w: f64): f64 {
    l: int = make("UILabel");
    msg1(l, sel("setNumberOfLines:"), 0);
    msg1(l, sel("setAttributedText:"), a);
    label_size(l, w);
    release(l);
    hfa[1]
}

// The card drawn (kept as card_image).
card_draw(row: UiRow) {
    card_measures_read(row);
    W: f64 = card_measures[0] as f64;
    H: f64 = card_measures[1] as f64;
    margin: f64 = card_measures[2] as f64;
    gap: f64 = card_measures[3] as f64;
    most: f64 = card_measures[6] as f64;
    least: f64 = card_measures[7] as f64;
    step: f64 = card_measures[8] as f64;
    if (W <= 0.0f64 || H <= 0.0f64 || step <= 0.0f64) wire_fail("core's card has no size");
    w: f64 = W - 2.0f64 * margin;
    rtl: bool = card_rtl(row);
    reference: int = card_reference(row, rtl);
    ref_h: f64 = card_text_height(reference, w);
    room: f64 = H - 2.0f64 * margin - gap - ref_h;
    s: f64 = most;
    text: int = card_text(row, s, rtl);
    text_h: f64 = card_text_height(text, w);
    while (s > least && text_h > room) {
        s = s - step;
        text = card_text(row, s, rtl);
        text_h = card_text_height(text, w)
    }
    top: f64 = (H - text_h - gap - ref_h) / 2.0f64;
    if (top < margin) top = margin;
    UIGraphicsBeginImageContextWithOptions(W, H, 1, 1.0f64);
    msg(card_color(row, 0), sel("setFill"));
    UIRectFill(0.0f64, 0.0f64, W, H);
    msg_rect(text, sel("drawInRect:"), margin, top, w, text_h + 2.0f64);
    msg_rect(reference, sel("drawInRect:"), margin, top + text_h + gap, w, ref_h + 2.0f64);
    image: int = UIGraphicsGetImageFromCurrentImageContext();
    UIGraphicsEndImageContext();
    card_image = held(card_image, image);
    note_num("bible: card size ", s as int)
}

// The card's row: the card drawn, shown whole at the list's width.
card_cell(t: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    card_draw(row);
    cell: int = fresh_cell(t);
    content: int = msg(cell, sel("contentView"));
    view: int = msg1(make("UIImageView"), sel("initWithImage:"), card_image);
    msg1(view, sel("setContentMode:"), 1);
    msg1(view, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(view, sel("setIsAccessibilityElement:"), 1);
    msg1(view, sel("setAccessibilityTraits:"), objc_const("UIAccessibilityTraitImage"));
    msg1(view, sel("setAccessibilityLabel:"), uk_text(row.label));
    layer: int = msg(view, sel("layer"));
    msg_set_f(layer, sel("setCornerRadius:"), 12.0f64);
    msg1(view, sel("setClipsToBounds:"), 1);
    msg1(content, sel("addSubview:"), view);
    release(view);
    pin_by(view, content, "leadingAnchor", 16.0f64);
    pin_by(view, content, "trailingAnchor", -16.0f64);
    pin_by(view, content, "topAnchor", 12.0f64);
    pin_by(view, content, "bottomAnchor", -12.0f64);
    ratio: f64 = card_measures[1] as f64 / card_measures[0] as f64;
    tall: int = msg1_f(msg(view, sel("heightAnchor")), sel("constraintEqualToAnchor:multiplier:"),
        msg(view, sel("widthAnchor")), ratio);
    msg1(tall, sel("setActive:"), 1);
    cell
}

// share_image WORDS: the card last drawn, to the share sheet (over the
// composer).
share_card() {
    if (card_image == 0) return;
    card_one[0] = card_image;
    share_items(nsarray(card_one, 1))
}

card_one: []int = new int[1](0)
