tag bible_ios;

use_tag std, ios, bible, bible_wire;

// The app's own cells for rows core marks as having one (core/skin.l8's
// CUSTOM_): the text size's slider between its two buttons, the themes as
// swatches, and Listen's wide button; each drawn from its row and sending
// the row's action as a list's control does (ios/skin.l8).
import "../../ios/objc.l8";

import "../core/look.l8";

// Whether the phone's text size is one of the accessibility sizes.
extern UIContentSizeCategoryIsAccessibilityCategory(category: int): int;

ax_size(): bool {
    (UIContentSizeCategoryIsAccessibilityCategory(msg(msg(cls("UIApplication"), sel("sharedApplication")),
        sel("preferredContentSizeCategory"))) & 255) != 0
}

// A plain cell with nothing reused in it.
fresh_cell(_t: int): int {
    cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, 0), sel("autorelease"));
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    msg1(cell, sel("setSelectionStyle:"), 0);
    cell
}

symbol_button(name: str, action: str, label: str): int {
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg2(b, sel("setImage:forState:"), symbol(name, 17.0f64, 4, 0), 0);
    msg1(b, sel("setTintColor:"), c_ink);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel(action), 64);
    msg1(b, sel("setAccessibilityLabel:"), nsstring(label));
    b
}

// ---- the text size (CUSTOM_SIZE: a slider from LO to HI at VALUE; its
// detail a caption) ----
slider: int = 0;

size_cell(t: int, k: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    cell: int = fresh_cell(t);
    content: int = msg(cell, sel("contentView"));
    column: int = stack(1, 6.0f64);
    line: int = stack(0, 12.0f64);
    msg1(line, sel("setAlignment:"), 3);
    smaller: int = symbol_button("textformat.size.smaller", "sizeSmaller:", w_smaller_text);
    msg1(smaller, sel("setTag:"), k * 4096 + i);
    msg1(line, sel("addArrangedSubview:"), smaller);
    slider = make("UISlider");
    msg1(slider, sel("setTag:"), k * 4096 + i);
    msg_set_f32(slider, sel("setMinimumValue:"), row.lo as f64 as f32);
    msg_set_f32(slider, sel("setMaximumValue:"), row.hi as f64 as f32);
    msg_set_f32(slider, sel("setValue:"), row.value as f64 as f32);
    msg1(slider, sel("setMinimumTrackTintColor:"), c_accent);
    msg3(slider, sel("addTarget:action:forControlEvents:"), app_obj, sel("sizeSlid:"),
        4096);
    msg1(slider, sel("setAccessibilityLabel:"), uk_text(row.title));
    msg1(line, sel("addArrangedSubview:"), slider);
    release(slider);
    larger: int = symbol_button("textformat.size.larger", "sizeLarger:", w_larger_text);
    msg1(larger, sel("setTag:"), k * 4096 + i);
    msg1(line, sel("addArrangedSubview:"), larger);
    msg1(column, sel("addArrangedSubview:"), line);
    if (row.detail.n > 0) {
        caption: int = make("UILabel");
        msg1(caption, sel("setText:"), uk_text(row.detail));
        msg1(caption, sel("setFont:"), sans(12.0f64, 0.0f64));
        msg1(caption, sel("setTextColor:"), c_faint);
        msg1(caption, sel("setTextAlignment:"), 1);
        msg1(column, sel("addArrangedSubview:"), caption);
        release(caption)
    }
    msg1(content, sel("addSubview:"), column);
    pin_by(column, content, "leadingAnchor", 16.0f64);
    pin_by(column, content, "trailingAnchor", -16.0f64);
    pin_by(column, content, "topAnchor", 10.0f64);
    pin_by(column, content, "bottomAnchor", -10.0f64);
    cell
}

// The slider let go of at a step (the steps whole), or a button a step
// either way: the row's action with the step.
size_slid(_self: int, _cmd: int, s: int): int {
    n: int = (msg_f32(s, sel("value")) as f64 + 0.5f64) as int;
    msg_set_f32(s, sel("setValue:"), n as f64 as f32);
    size_step(s, n);
    0
}

size_smaller(_self: int, _cmd: int, b: int): int {
    size_step(b, size_now(b) - 1);
    0
}

size_larger(_self: int, _cmd: int, b: int): int {
    size_step(b, size_now(b) + 1);
    0
}

size_now(control: int): int {
    n: int = msg(control, sel("tag"));
    k: int = n / 4096;
    i: int = n % 4096;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || i >= uk_ui.rows_n) -1 else uk_ui.rows[i].value
}

size_step(control: int, value: int) {
    n: int = msg(control, sel("tag"));
    k: int = n / 4096;
    i: int = n % 4096;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || i >= uk_ui.rows_n) return;
    row: UiRow = uk_ui.rows[i];
    if (value < row.lo || value > row.hi || value == row.value) return;
    if (slider != 0) msg_set_f32(slider, sel("setValue:"), value as f64 as f32);
    uk_control_act(control, value)
}

// ---- the themes (CUSTOM_THEMES: OPTIONS their names, VALUE the one
// chosen; core/look.l8's colors) ----
theme_cell(t: int, k: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    cell: int = fresh_cell(t);
    content: int = msg(cell, sel("contentView"));
    line: int = stack(0, 0.0f64);
    msg1(line, sel("setDistribution:"), 1);
    names: int = uk_split(row.options, theme_name_ns);
    for j in 0..names {
        chosen: bool = j == row.value;
        column: int = stack(1, 6.0f64);
        msg1(column, sel("setAlignment:"), 3);
        // The ring (when chosen), around the swatch.
        ring: int = make("UIView");
        msg1(ring, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        pin_size(ring, "widthAnchor", 55.0f64);
        pin_size(ring, "heightAnchor", 55.0f64);
        rl: int = msg(ring, sel("layer"));
        msg_set_f(rl, sel("setCornerRadius:"), 27.5f64);
        msg_set_f(rl, sel("setBorderWidth:"), 2.5f64);
        msg1(rl, sel("setBorderColor:"), msg(if (chosen) c_accent else msg(cls("UIColor"),
            sel("clearColor")), sel("CGColor")));
        tt: int = if (j == 0) 1 else clamp(j, 1, len(t_bg) - 1);
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(b, sel("setTag:"), (k * 4096 + i) * 8 + j);
        msg1(b, sel("setBackgroundColor:"), color_hex(t_bg[tt], 1.0f64));
        bl: int = msg(b, sel("layer"));
        msg_set_f(bl, sel("setCornerRadius:"), 22.0f64);
        msg_set_f(bl, sel("setBorderWidth:"), 1.0f64);
        msg1(bl, sel("setBorderColor:"), msg(c_rule, sel("CGColor")));
        msg1(b, sel("setClipsToBounds:"), 1);
        if (j == 0) {
            // Auto: Paper and Night, split corner to corner.
            g: int = make("CAGradientLayer");
            one[0] = msg(color_hex(t_bg[1], 1.0f64), sel("CGColor"));
            one[1] = one[0];
            one[2] = msg(color_hex(t_bg[4], 1.0f64), sel("CGColor"));
            one[3] = one[2];
            msg1(g, sel("setColors:"), nsarray(one, 4));
            one[0] = nsnumber_f(0.0f64);
            one[1] = nsnumber_f(0.5f64);
            one[2] = nsnumber_f(0.5f64);
            one[3] = nsnumber_f(1.0f64);
            msg1(g, sel("setLocations:"), nsarray(one, 4));
            msg_ff(g, sel("setStartPoint:"), 0.0f64, 0.0f64);
            msg_ff(g, sel("setEndPoint:"), 1.0f64, 1.0f64);
            msg_rect(g, sel("setFrame:"), 0.0f64, 0.0f64, 44.0f64, 44.0f64);
            msg2(bl, sel("insertSublayer:atIndex:"), g, 0);
            release(g)
        }
        keys[0] = k_font;
        values[0] = body(15.0f64);
        keys[1] = k_color;
        values[1] = color_hex(t_ink[tt], 1.0f64);
        a: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
            nsstring(if (j == 0) "" else w_font_sample), nsdictionary(keys, values,
            2));
        msg2(b, sel("setAttributedTitle:forState:"), a, 0);
        release(a);
        msg1(b, sel("setAccessibilityLabel:"), theme_name_ns[j]);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("themePicked:"),
            64);
        msg1(ring, sel("addSubview:"), b);
        pin_size(b, "widthAnchor", 44.0f64);
        pin_size(b, "heightAnchor", 44.0f64);
        pin_to(b, "centerXAnchor", ring, "centerXAnchor", 0.0f64);
        pin_to(b, "centerYAnchor", ring, "centerYAnchor", 0.0f64);
        msg1(column, sel("addArrangedSubview:"), ring);
        release(ring);
        caption: int = make("UILabel");
        msg1(caption, sel("setText:"), theme_name_ns[j]);
        msg1(caption, sel("setFont:"), sans(11.0f64, if (chosen) 0.3f64 else 0.0f64));
        msg1(caption, sel("setTextColor:"), if (chosen) c_ink else c_faint);
        msg1(column, sel("addArrangedSubview:"), caption);
        release(caption);
        msg1(line, sel("addArrangedSubview:"), column)
    }
    msg1(content, sel("addSubview:"), line);
    pin_by(line, content, "leadingAnchor", 8.0f64);
    pin_by(line, content, "trailingAnchor", -8.0f64);
    pin_by(line, content, "topAnchor", 12.0f64);
    pin_by(line, content, "bottomAnchor", -10.0f64);
    cell
}

theme_name_ns: []int = new int[8](0);

// A theme tapped: the row's action with it.
theme_picked(_self: int, _cmd: int, b: int): int {
    n: int = msg(b, sel("tag"));
    haptic_select();
    k: int = n / 8 / 4096;
    i: int = n / 8 % 4096;
    if (k < 0 || k >= UK_SLOTS || !uk_ensure(k) || i >= uk_ui.rows_n) return 0;
    uk_wire_act(uk_ids[k], uk_ui.rows[i].action, uk_ui.rows[i].arg, n % 8);
    uk_effects();
    0
}

// Font i's face at 17 points, for its name in the list.
font_sample(i: int): int {
    if (i == 4) return sans(17.0f64, 0.0f64);
    if (i == 0) return serif(17.0f64);
    if (i < 0 || i >= len(font_names_ps)) return sans(17.0f64, 0.0f64);
    f: int = msg1_f(cls("UIFont"), sel("fontWithName:size:"), nsstring(font_names_ps[i]),
        17.0f64);
    if (f == 0) sans(17.0f64, 0.0f64) else f
}

// ---- Listen (CUSTOM_LISTEN, DESIGN.md §8.7): a wide button of the row's
// words, "Listen from John 3:14", or Stop Listening while it reads; off
// where there is nothing to play ----
listen_cell(t: int, k: int, i: int): int {
    row: UiRow = uk_ui.rows[i];
    cell: int = fresh_cell(t);
    content: int = msg(cell, sel("contentView"));
    playing: bool = listen_shown;
    config: int = msg(cls("UIButtonConfiguration"), sel(if (playing || row.disabled) "grayButtonConfiguration" else "filledButtonConfiguration"));
    if (!playing && !row.disabled) {
        msg1(config, sel("setBaseBackgroundColor:"), c_accent);
        msg1(config, sel("setBaseForegroundColor:"), on_accent())
    }
    msg1(config, sel("setCornerStyle:"), 4);
    if (!row.disabled) {
        msg1(config, sel("setImage:"), symbol(if (playing) "stop.fill" else "play.fill",
            15.0f64, 6, 0));
        msg_set_f(config, sel("setImagePadding:"), 8.0f64)
    }
    keys[0] = k_font;
    values[0] = sans(17.0f64, 0.3f64);
    title: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        uk_text(row.title), nsdictionary(keys, values, 1));
    msg1(config, sel("setAttributedTitle:"), title);
    release(title);
    b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(b, sel("setTag:"), k * 4096 + i);
    msg1(b, sel("setEnabled:"), if (row.disabled) 0 else 1);
    msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("listenButton:"),
        64);
    msg1(content, sel("addSubview:"), b);
    pin_by(b, content, "leadingAnchor", 16.0f64);
    pin_by(b, content, "trailingAnchor", -16.0f64);
    pin_by(b, content, "topAnchor", 12.0f64);
    pin_by(b, content, "bottomAnchor", -12.0f64);
    pin_size(b, "heightAnchor", 50.0f64);
    cell
}

listen_button(_self: int, _cmd: int, b: int): int {
    uk_control_act(b, 0);
    0
}

add_cell_methods(app: int) {
    add_method1(app, sel("sizeSlid:"), &size_slid, "v@:@");
    add_method1(app, sel("sizeSmaller:"), &size_smaller, "v@:@");
    add_method1(app, sel("sizeLarger:"), &size_larger, "v@:@");
    add_method1(app, sel("themePicked:"), &theme_picked, "v@:@");
    add_method1(app, sel("listenButton:"), &listen_button, "v@:@")
}
