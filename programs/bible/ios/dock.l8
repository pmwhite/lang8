tag vellum;

use_tag std, ios, bible, bible_wire;

// The chrome over the page: Liquid Glass that floats near the thumb and
// gets out of the way of the words.
//
// The dock, at the foot: the chapter read (and, small under it, what the
// page reads) in a capsule in its middle, whose tap is Go To and whose long
// press is core's title menu; at its left the panel's button, at its
// right ⋯ (the Library, Listen, the reading settings). The two are alike,
// so the chapter's name is in the middle of the screen, and stays there as
// the dock changes. Read on (the words moved up), it draws in: the
// buttons melt into the capsule's ends, which narrows about its middle to the chapter's
// name, and the status bar goes; moving back, a tap on
// it, a jump or a selection brings it out again. Its glass shapes are in
// one container (UIGlassContainerEffect), so they merge and part as
// liquid does.
//
// Verses selected, the capsule becomes the tray: it grows up out of the
// dock into a panel of core's tray (the reference, the highlights' colors,
// what can be done), and goes back into the capsule as they are let go.
//
// At the top, under the status bar: the way back after a jump (core's
// `back`), a capsule of glass, and the toasts core says, dropping in where
// it is.
import "../../ios/objc.l8";

import "../core/wire.l8";

import "../core/tray.l8";

import "kit.l8";

import "look.l8";

DOCK_EXPANDED: int = 0;

DOCK_COMPACT: int = 1;

DOCK_TRAY: int = 2;

type Dock = {
    mode: int;
    // The glass views' container, and its shapes: the panel's button, the
    // capsule, ⋯, the tray.
    container: int;
    left_glass: int;
    title_glass: int;
    right_glass: int;
    tray_glass: int;
    panel_button: int;
    title_button: int;
    title_label: int;
    // The chapter's name smaller, as the drawn-in capsule shows it (the
    // two cross-fade as the glass reshapes: a font can't animate).
    version_label: int;
    // ⋯: the Library, Listen and Reading.
    more_button: int;
    // The tray's contents: its reference, its close, the swatches, its
    // actions (a stack of buttons).
    tray_label: int;
    tray_close: int;
    swatches: []int;
    actions: []int;
    // The panel's button lit (the panel shown).
    panel_lit: bool;
    // Each pane's offset where the last change of mode began, for the
    // scroll's hysteresis.
    turned_at: []f64
}

dock: Dock = Dock {
    mode: 0,
    container: 0,
    left_glass: 0,
    title_glass: 0,
    right_glass: 0,
    tray_glass: 0,
    panel_button: 0,
    title_button: 0,
    title_label: 0,
    version_label: 0,
    more_button: 0,
    tray_label: 0,
    tray_close: 0,
    swatches: new int[6](0),
    actions: new int[8](0),
    panel_lit: false,
    turned_at: new f64[2](0.0f64)
};

// Its sizes.
DOCK_H: f64 = 54.0f64;

DOCK_COMPACT_H: f64 = 36.0f64;

DOCK_SIDE: f64 = 16.0f64;

DOCK_GAP: f64 = 10.0f64;

TRAY_H: f64 = 170.0f64;

// How far the words must move on (or back) before it draws in (or out).
DOCK_TRAVEL: f64 = 60.0f64;

// ---- made ----
// A plain button (autoreleased) whose touch up inside sends selector to
// the chrome's target.
chrome_button(selector: str): int {
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg3(b, sel("addTarget:action:forControlEvents:"), chrome_target, sel(selector),
        64);
    b
}

// A button's image: a symbol in the ink.
button_symbol(b: int, name: str, size: f64) {
    msg2(b, sel("setImage:forState:"), symbol(name, size, 5), 0);
    msg1(b, sel("setTintColor:"), colors.ink)
}

chrome_target: int = 0;

dock_make(parent: int) {
    container: int = glass_container(14.0f64);
    dock.container = retain(container);
    add_sub(dock_window_make(), container);
    content: int = glass_content(container);
    dock.left_glass = retain(glass_view(true));
    dock.title_glass = retain(glass_view(true));
    dock.right_glass = retain(glass_view(true));
    dock.tray_glass = retain(glass_view(false));
    add_sub(content, dock.tray_glass);
    add_sub(content, dock.left_glass);
    add_sub(content, dock.title_glass);
    add_sub(content, dock.right_glass);
    set_alpha(dock.tray_glass, 0.0f64);
    set_hidden(dock.tray_glass, true);
    dock.panel_button = retain(chrome_button("vellumPanelTapped:"));
    button_symbol(dock.panel_button, "rectangle.bottomhalf.inset.filled", 18.0f64);
    msg1(dock.panel_button, sel("setAccessibilityLabel:"), nsstring("Panel"));
    add_sub(glass_content(dock.left_glass), dock.panel_button);
    dock.title_button = retain(chrome_button("vellumTitleTapped:"));
    add_sub(glass_content(dock.title_glass), dock.title_button);
    dock.title_label = retain(label_new(font_rounded(17.0f64, 0.4f64), colors.ink,
        1));
    dock.version_label = retain(label_new(font_rounded(11.5f64, 0.0f64), colors.faint,
        1));
    msg1(dock.title_label, sel("setTextAlignment:"), 1);
    msg1(dock.title_label, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(dock.title_label, sel("setMinimumScaleFactor:"), 0.75f64);
    msg1(dock.version_label, sel("setLineBreakMode:"), 4);
    msg1(dock.version_label, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(dock.version_label, sel("setMinimumScaleFactor:"), VERSION_SHRINK);
    msg1(dock.version_label, sel("setTextAlignment:"), 1);
    msg1(dock.title_label, sel("setUserInteractionEnabled:"), 0);
    msg1(dock.version_label, sel("setUserInteractionEnabled:"), 0);
    add_sub(dock.title_button, dock.title_label);
    add_sub(dock.title_button, dock.version_label);
    dock_hold_menu_attach(dock.title_button);
    dock.more_button = retain(msg1(cls("VellumDockMenuButton"), sel("buttonWithType:"),
        1));
    button_symbol(dock.more_button, "ellipsis", 18.0f64);
    msg1(dock.more_button, sel("setAccessibilityLabel:"), nsstring("More"));
    msg1(dock.more_button, sel("setMenu:"), dock_more_menu());
    msg1(dock.more_button, sel("setShowsMenuAsPrimaryAction:"), 1);
    add_sub(glass_content(dock.right_glass), dock.more_button);
    dock_panel_make(content);
    tray_make();
    player_make(content);
    capsule_make(parent);
    toast_make(parent)
}

// ---- the dock's window ----
// The dock floats over everything of the app's, the split's panel too: in
// a window of its own above the app's (a scene's windows, UIKit's), as
// large as the dock and moved and sized with it, so that a touch beside
// the dock reaches what is under it. Kept across a hot reload.
persistent vellum_dock_window: int = 0;

// Its root (holding the dock's container in its view), a VellumDockRoot:
// what the dock's menus choose goes to it, up the responder chain.
dock_root: int = 0;

// The dock's window made (once), a root new to it: the view the dock goes in.
dock_window_make(): int {
    if (vellum_dock_window == 0 && scene_obj != 0) {
        w: int = msg1(msg(cls("UIWindow"), sel("alloc")), sel("initWithWindowScene:"),
            scene_obj);
        msg_set_f(w, sel("setWindowLevel:"), 1.0f64);
        vellum_dock_window = w
    }
    if (vellum_dock_window == 0) return root_view;
    dock_root = held(dock_root, autoreleased(make("VellumDockRoot")));
    view: int = msg(dock_root, sel("view"));
    msg1(view, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(vellum_dock_window, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(vellum_dock_window, sel("setRootViewController:"), dock_root);
    msg1(vellum_dock_window, sel("setOverrideUserInterfaceStyle:"), if (look_said) look_style() else 0);
    msg1(vellum_dock_window, sel("setHidden:"), 0);
    view
}

// The old build's dock let go of (hot reload): its window kept, emptied.
dock_window_empty() {
    if (vellum_dock_window == 0) return;
    old: int = msg(vellum_dock_window, sel("rootViewController"));
    if (old != 0) emptied(msg(old, sel("view")));
    msg1(vellum_dock_window, sel("setRootViewController:"), 0)
}

// ---- the dock under a sheet ----
// A sheet of a task (Go To, the Library, Reading, Share, a page of the
// web) has the screen: the dock's glass dissolves as it comes and forms
// again as it goes, in its transition's animation (a hand's swipe's too,
// given up or not). The split's panel isn't one: the dock stays over it.
dock_covered: bool = false;

// Whether a sheet of a task is shown (other than except, which is going).
dock_sheet_shown(except: int): bool {
    if (root_vc == 0) return false;
    if (quick_covers_dock()) return true;
    vc: int = msg(root_vc, sel("presentedViewController"));
    steps: int = 0;
    while (vc != 0 && steps < 8) {
        if (vc != except && !truth(msg(vc, sel("isBeingDismissed")))) return true;
        vc = msg(vc, sel("presentedViewController"));
        steps = steps + 1
    }
    false
}

dock_along_block: int = 0;

dock_along_done_block: int = 0;

// Whether the dock is being covered (or uncovered) in a transition.
dock_covering: bool = false;

// controller just presented or dismissed: the dock covered or not along
// its transition (at once, eased, without one).
dock_along(controller: int, covered: bool) {
    coordinator: int = if (controller != 0) msg(controller, sel("transitionCoordinator")) else 0;
    if (coordinator == 0) {
        dock_cover(covered);
        return
    }
    if (dock_along_block == 0) {
        dock_along_block = block1(&dock_along_animated, 0, "v16@?0@8");
        dock_along_done_block = block1(&dock_along_ended, 0, "v16@?0@8")
    }
    dock_covering = covered;
    if (!truth(msg2(coordinator, sel("animateAlongsideTransition:completion:"), dock_along_block,
        dock_along_done_block))) dock_cover(covered)
}

dock_along_animated(_context: int, _transition: int): int {
    dock_covered = dock_covering;
    dock_layout();
    0
}

// Done; or a hand's swipe given up, covered again.
dock_along_ended(_context: int, transition: int): int {
    if (transition != 0 && truth(msg(transition, sel("isCancelled")))) {
        dock_covered = !dock_covering;
        dock_layout()
    }
    dock_sheets_check();
    0
}

// The dock covered or not, its glass eased.
dock_cover(covered: bool) {
    if (dock_covered != covered) {
        dock_covered = covered;
        ease(ANIM_DOCK, 0.25f64)
    }
    dock_sheets_watch()
}

// Whether the dock should be covered now (a sheet may go of itself, as
// Share's does once shared: while covered, looked at now and then).
dock_sheets_check() {
    dock_cover(dock_sheet_shown(0))
}

dock_sheets_due: bool = false;

dock_sheets_watch() {
    if (!dock_covered || dock_sheets_due || app_obj == 0) return;
    dock_sheets_due = true;
    _t: int = timer_after(app_obj, 0.5f64, "vellumDockSheets:")
}

dock_sheets_fired(_self: int, _cmd: int, _timer: int): int {
    dock_sheets_due = false;
    dock_sheets_check();
    0
}

// A sheet's swipe away begun: the dock formed along it, if no other
// sheet of a task stays.
dock_sheet_will_go(presentation: int) {
    vc: int = msg(presentation, sel("presentedViewController"));
    if (vc == 0 || dock_sheet_shown(vc)) return;
    dock_along(vc, false)
}

// ---- laid out ----
// The chrome's frames for the root's bounds and safe area now, for the
// dock's mode (called inside the animations of a change of mode too).
chrome_bounds: Rect = Rect {
    x: 0.0f64,
    y: 0.0f64,
    w: 0.0f64,
    h: 0.0f64
};

chrome_safe: Insets = Insets {
    top: 0.0f64,
    left: 0.0f64,
    bottom: 0.0f64,
    right: 0.0f64
};

// The dock's foot: a little into the home indicator's room, as the
// system's own floating bars sit.
dock_foot(): f64 {
    gap: f64 = if (chrome_safe.bottom > 20.0f64) chrome_safe.bottom - 10.0f64 else 12.0f64;
    foot: f64 = chrome_bounds.h - gap;
    foot
}

// Whether the dock shows: not under a sheet of a task.
dock_visible(): bool {
    !dock_covered
}

// What of the page the chrome covers at its top and foot (the expanded
// dock's, whatever its mode: the words never move as it draws in).
chrome_top_cover(): f64 {
    chrome_safe.top + 8.0f64
}

chrome_bottom_cover(): f64 {
    chrome_bounds.h - dock_foot() + DOCK_H + 8.0f64
}

dock_layout() {
    if (dock.container == 0) return;
    side: bool = panel_side();
    dock_glyphs_fit(side);
    if (dock_morphing) {
        dock_morph_layout();
        dock_layout_end();
        return
    }
    left: f64 = chrome_safe.left + DOCK_SIDE;
    right: f64 = chrome_bounds.w - chrome_safe.right - DOCK_SIDE;
    // (Everything about one middle: the chapter's name never moves
    // sideways.)
    middle: f64 = (left + right) / 2.0f64;
    foot: f64 = dock_foot();
    expanded_top: f64 = foot - DOCK_H;
    title_x: f64 = left + DOCK_H + DOCK_GAP;
    title_w: f64 = right - DOCK_H - DOCK_GAP - title_x;
    // (The player, while one listens, a pill above the rest.)
    above: f64 = if (player.shown) PLAYER_H + DOCK_GAP else 0.0f64;
    // (Both readers': the panel's capsule beside the page's, divided out
    // of it as it comes, going back into it as it goes.)
    split: bool = dock_split() && dock.mode != DOCK_TRAY && !player.shown;
    was_split: bool = dock_both();
    if (split) dock_readers = DOCK_BOTH else if (was_split) dock_readers = DOCK_PAGE_FOLDING;
    if (split != was_split) dock_words_changed = true;
    if (split) {
        if (!was_split) dock_panel_in_capsule();
        dock_split_layout(left, right, foot);
        dock_layout_end();
        return
    }
    // (The container is as large as the shapes that show, so that it takes
    // no touch meant for the page around them. Side by side, the panel's
    // button at the right end, where the panel comes from, ⋯ at the left.)
    panel_x: f64 = if (side) right - DOCK_H else left;
    more_x: f64 = if (side) left else right - DOCK_H;
    if (dock.mode == DOCK_EXPANDED) {
        dock_container_at(left, expanded_top - above, right - left, DOCK_H + above);
        dock_place(dock.left_glass, panel_x, expanded_top, DOCK_H, DOCK_H, if (dock_panel_button_away) 0.0f64 else 1.0f64);
        dock_place(dock.title_glass, title_x, expanded_top, title_w, DOCK_H, 1.0f64);
        dock_place(dock.right_glass, more_x, expanded_top, DOCK_H, DOCK_H, 1.0f64);
        tray_place_folded(title_x, expanded_top, title_w, DOCK_H);
        player_place_at(left, expanded_top, right - left, title_x, title_w, DOCK_H)
    } else if (dock.mode == DOCK_COMPACT) {
        cw: f64 = compact_width();
        cx: f64 = middle - cw / 2.0f64;
        top: f64 = foot - DOCK_COMPACT_H + 6.0f64;
        pw: f64 = if (player.shown) clamp_f(right - left, cw, 360.0f64) else cw;
        px: f64 = middle - pw / 2.0f64;
        dock_container_at(px, top - above, pw, DOCK_COMPACT_H + above);
        // (The buttons drawn into the capsule's ends, alike.)
        end: f64 = cx + cw - DOCK_COMPACT_H;
        dock_place(dock.left_glass, if (side) end else cx, top, DOCK_COMPACT_H, DOCK_COMPACT_H,
            0.0f64);
        dock_place(dock.title_glass, cx, top, cw, DOCK_COMPACT_H, 1.0f64);
        dock_place(dock.right_glass, if (side) cx else end, top, DOCK_COMPACT_H, DOCK_COMPACT_H,
            0.0f64);
        tray_place_folded(cx, top, cw, DOCK_COMPACT_H);
        player_place_at(px, top, pw, cx, cw, DOCK_COMPACT_H)
    } else {
        tray_w: f64 = right - left + 16.0f64;
        tray_x: f64 = left - 8.0f64;
        tray_top: f64 = foot - TRAY_H;
        dock_container_at(tray_x, tray_top - above, tray_w, TRAY_H + above);
        dock_place(dock.left_glass, panel_x, foot - DOCK_H, DOCK_H, DOCK_H, 0.0f64);
        dock_place(dock.title_glass, title_x, foot - DOCK_H, title_w, DOCK_H, 0.0f64);
        dock_place(dock.right_glass, more_x, foot - DOCK_H, DOCK_H, DOCK_H, 0.0f64);
        dock_place(dock.tray_glass, tray_x, tray_top, tray_w, TRAY_H, 1.0f64);
        tray_layout(tray_w);
        player_place_at(tray_x, tray_top, tray_w, title_x, title_w, DOCK_H)
    }
    // (The panel's capsule folded into ⋯; side by side, into the panel's
    // button, where it grew from.)
    f: Rect = frame_of(if (side) dock.left_glass else dock.right_glass);
    dock_panel_fold(f.x + dock_origin_x, f.y + dock_origin_y, f.w, f.h, dock_readers == DOCK_PAGE_FOLDING);
    dock_layout_end()
}

// The panel's button's glyph for the axis the split would take: its lower
// half stacked, its right half side by side (-1: not yet drawn).
dock_glyphs_side: int = -1;

dock_glyphs_fit(side: bool) {
    k: int = if (side) 1 else 0;
    if (dock_glyphs_side == k) return;
    dock_glyphs_side = k;
    button_symbol(dock.panel_button, if (side) "rectangle.righthalf.inset.filled" else "rectangle.bottomhalf.inset.filled",
        18.0f64)
}

// (Every layout's end: the capsules' words, the buttons, the container
// shown and touched while the dock shows.)
dock_layout_end() {
    title_contents_layout();
    dock_panel_contents_layout();
    dock_buttons_layout();
    dock_words_change();
    set_alpha(dock.container, 1.0f64);
    msg1(dock.container, sel("setUserInteractionEnabled:"), if (dock_visible()) 1 else 0);
    msg1(dock.container, sel("setAccessibilityElementsHidden:"), if (dock_visible()) 0 else 1)
}

// The buttons: each fills its circle.
dock_buttons_layout() {
    l: Rect = frame_of(dock.left_glass);
    r: Rect = frame_of(dock.right_glass);
    set_frame4(dock.panel_button, 0.0f64, 0.0f64, l.w, l.h);
    set_frame4(dock.more_button, 0.0f64, 0.0f64, r.w, r.h);
    dock_words_set()
}

// ---- the dock's words as it becomes both readers' or the page's ----
// The words that change (the panel's button, the panel's capsule's) go
// at once as the shapes begin to move and the new come as they
// settle: never one set over the other, nor words sliding under glass.
// (The going and the coming are other views, each its own animation.)
dock_words_changed: bool = false;

// The words going: the panel's button as the dock becomes both readers'
// stacked (side by side it stays, at the divider's foot), the panel's
// capsule's as it becomes the page's (and as the split closes: the
// panel's button is the split's meanwhile, its symbol shown).
dock_words_go() {
    if (dock_morphing) {
        if (!panel.shown && dock_panel.button != 0) set_alpha(dock_panel.button, 0.0f64)
    } else if (dock_both()) {
        if (!panel_side()) set_alpha(dock.panel_button, 0.0f64)
    } else if (dock_panel.button != 0) set_alpha(dock_panel.button, 0.0f64)
}

// The words coming: the other way about.
dock_words_come() {
    if (dock_morphing) {
        if (panel.shown && dock_panel.button != 0) set_alpha(dock_panel.button, 1.0f64)
    } else if (!dock_both() || panel_side()) set_alpha(dock.panel_button, 1.0f64);
    if (!dock_morphing && dock_both() && dock_panel.button != 0) set_alpha(dock_panel.button,
        1.0f64)
}

// (Laid out: as they are, but for a change, which dock_words_change
// animates; set in the dock's spring too, the spring would be theirs.)
dock_words_set() {
    if (dock_morphing) {
        set_alpha(dock.panel_button, 1.0f64);
        if (dock_panel.button != 0 && !dock_morph_open) set_alpha(dock_panel.button,
            0.0f64);
        return
    }
    if (dock_words_changed) return;
    dock_words_go();
    dock_words_come()
}

// (At a layout's end: changed, the old words going quickly, the new
// coming as the shapes settle.)
dock_words_change() {
    if (!dock_words_changed) return;
    dock_words_changed = false;
    ease(ANIM_DOCK_WORDS_OUT, 0.1f64);
    ease_after(ANIM_DOCK_WORDS, 0.2f64, 0.2f64)
}

// The player above the shapes whose top is top (x, w its width there),
// or folded into the capsule (at fx, fw, fh tall) while it isn't shown.
player_place_at(
    x: f64,
    top: f64,
    w: f64,
    fx: f64,
    fw: f64,
    fh: f64
) {
    if (player.shown) player_place(x, top - PLAYER_H - DOCK_GAP, w) else player_place(fx,
        top, fw);
    _h: f64 = fh
}

// Where the container is: the shapes are placed in the root's
// coordinates, less its origin.
dock_origin_x: f64 = 0.0f64;

dock_origin_y: f64 = 0.0f64;

dock_container_at(
    x: f64,
    y: f64,
    w: f64,
    h: f64
) {
    dock_origin_x = x;
    dock_origin_y = y;
    if (vellum_dock_window == 0 || msg(dock.container, sel("window")) != vellum_dock_window) set_frame4(dock.container,
        x, y, w, h) else if (dock_menu_shown) {
        set_frame(vellum_dock_window, bounds_of(window));
        set_frame4(dock.container, x, y, w, h)
    } else {
        set_frame4(vellum_dock_window, x, y, w, h);
        set_frame4(dock.container, 0.0f64, 0.0f64, w, h)
    }
}

// ---- the dock's menus ----
// A window draws nothing past itself, and the dock's is only as large as
// the dock: while a menu of the dock's shows (⋯'s, the capsules' held),
// its window is the screen's size, the dock where it was, and once the
// menu has gone, the dock's again. (Told by ⋯'s own menu interaction, a
// VellumDockMenuButton's, and by the capsules' held menus' delegate.)
dock_menu_shown: bool = false;

dock_menu_button_class: int = 0;

dock_menu_classes_make() {
    c: int = class_make(cls("UIButton"), "VellumDockMenuButton");
    dock_menu_button_class = c;
    add_method3(c, sel("contextMenuInteraction:willDisplayMenuForConfiguration:animator:"),
        &dock_menu_will_show, "v@:@@@");
    add_method3(c, sel("contextMenuInteraction:willEndForConfiguration:animator:"),
        &dock_menu_will_end, "v@:@@@")
}

dock_menu_will_show(
    self: int,
    cmd: int,
    interaction: int,
    configuration: int,
    animator: int
): int {
    dock_menu_shown = true;
    dock_window_refit();
    _s: int = super3(self, dock_menu_button_class, cmd, interaction, configuration,
        animator);
    0
}

dock_menu_will_end(
    self: int,
    cmd: int,
    interaction: int,
    configuration: int,
    animator: int
): int {
    _s: int = super3(self, dock_menu_button_class, cmd, interaction, configuration,
        animator);
    if (animator != 0) msg1(animator, sel("addCompletion:"), block0(&dock_menu_gone,
        0, "v8@?0")) else _g: int = dock_menu_gone(0);
    0
}

dock_menu_gone(_context: int): int {
    dock_menu_shown = false;
    dock_window_refit();
    0
}

// ---- the capsules' menus, held ----
// A hold on the page's capsule or the panel's, alike: its pane's ribbons
// at its place (title_menu_make), a context menu, the capsule's glass lifted
// as its preview and the menu beside it, so that letting go chooses
// nothing (a button's menu opens over the finger, and takes its letting
// go for a choice of what is under it). The dock's window's root is its
// delegate, what the menu chooses going up to it.
dock_hold_menu_attach(b: int) {
    delegate: int = if (dock_root != 0) dock_root else chrome_target;
    msg1(b, sel("addInteraction:"), autoreleased(msg1(msg(cls("UIContextMenuInteraction"),
        sel("alloc")), sel("initWithDelegate:"), delegate)))
}

// The held capsule's button, and the menu's maker.
dock_hold_button: int = 0;

dock_hold_provider: int = 0;

dock_hold_configuration(
    _self: int,
    _cmd: int,
    interaction: int,
    _location: int
): int {
    dock_hold_button = msg(interaction, sel("view"));
    if (dock_hold_provider == 0) dock_hold_provider = block1(&dock_hold_menu_built,
        0, "@16@?0@8");
    if (dock_hold_provider == 0) return 0;
    msg3(cls("UIContextMenuConfiguration"), sel("configurationWithIdentifier:previewProvider:actionProvider:"),
        0, 0, dock_hold_provider)
}

dock_hold_menu_built(_context: int, _suggested: int): int {
    title_menu_pane = (if (dock_hold_button == dock_panel.button && dock_panel.button != 0) PANE_PANEL else PANE_PAGE);
    title_menu_make()
}

// (Its preview, lifted and put back: the capsule's glass, nothing about
// it.)
dock_hold_preview(
    _self: int,
    _cmd: int,
    interaction: int,
    _configuration: int,
    _identifier: int
): int {
    button: int = msg(interaction, sel("view"));
    glass: int = if (button == dock_panel.button && dock_panel.button != 0) dock_panel.glass else dock.title_glass;
    parameters: int = fresh("UIPreviewParameters");
    msg1(parameters, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    autoreleased(msg2(msg(cls("UITargetedPreview"), sel("alloc")), sel("initWithView:parameters:"),
        glass, parameters))
}

// (While it shows, the dock's window the screen's: dock_menu_shown.)
dock_hold_will_show(
    _self: int,
    _cmd: int,
    _interaction: int,
    _configuration: int,
    _animator: int
): int {
    dock_menu_shown = true;
    dock_window_refit();
    0
}

dock_hold_will_end(
    _self: int,
    _cmd: int,
    _interaction: int,
    _configuration: int,
    animator: int
): int {
    if (animator != 0) msg1(animator, sel("addCompletion:"), block0(&dock_menu_gone,
        0, "v8@?0")) else _g: int = dock_menu_gone(0);
    0
}

// The dock's window fitted again where the dock is.
dock_window_refit() {
    if (dock.container == 0) return;
    b: Rect = bounds_of(dock.container);
    dock_container_at(dock_origin_x, dock_origin_y, b.w, b.h)
}

// A glass shape placed (in the root's coordinates), capsule-cornered (the
// tray a rounded panel), at alpha (taking no touch, and hidden, when clear
// at the end of its animation: dock_animation_ended).
TRAY_CORNER: f64 = 30.0f64;

dock_place(
    glass: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    alpha: f64
) {
    set_frame4(glass, x - dock_origin_x, y - dock_origin_y, w, h);
    set_corners(glass, if (h > DOCK_H) TRAY_CORNER else h / 2.0f64);
    glass_shown(glass, alpha > 0.5f64 && dock_visible(), glass != dock.tray_glass,
        dock_tint());
    msg1(glass, sel("setUserInteractionEnabled:"), if (alpha > 0.5f64) 1 else 0);
    // (The capsule's button fills it; the others, dock_buttons_layout.)
    if (glass == dock.title_glass) set_frame4(dock.title_button, 0.0f64, 0.0f64, w,
        h)
}

// The tray folded into the capsule (where it grows from and goes back
// to), clear.
tray_place_folded(
    x: f64,
    y: f64,
    w: f64,
    h: f64
) {
    set_frame4(dock.tray_glass, x - dock_origin_x, y - dock_origin_y, w, h);
    set_corners(dock.tray_glass, h / 2.0f64);
    glass_shown(dock.tray_glass, false, false, dock_tint());
    msg1(dock.tray_glass, sel("setUserInteractionEnabled:"), 0);
    tray_layout(w)
}

// The capsule's words: the chapter, and what is read under it (expanded),
// or the chapter alone, smaller (drawn in).
title_contents_layout() {
    frame: Rect = frame_of(dock.title_glass);
    w: f64 = frame.w;
    h: f64 = frame.h;
    compact: bool = dock.mode == DOCK_COMPACT;
    // (Each name at its own width, about the capsule's middle, which is the
    // dock's middle in every state: as the capsule grows or narrows the
    // words stay where they are, never laid out again at another width.
    // Drawn in, the chapter's name is scaled smaller, not set again in a
    // smaller type, so that it shrinks to the middle and grows back out;
    // the version slides up under it, fading, and back.)
    // (Its names as wide drawn in as out, the room they have drawn out:
    // a label laid out at another width shows its old picture squeezed
    // while it moves, and snaps at the end.)
    room: f64 = dock_capsule_room_out(false);
    shown: int = version_shown(version_words, room);
    if (shown != 0 && !ns_equal(shown, msg(dock.version_label, sel("text")))) msg1(dock.version_label,
        sel("setText:"), shown);
    dock_names_place(dock.title_label, dock.version_label, w, h, room, if (compact) DOCK_COMPACT_SCALE else 1.0f64)
}

// The room a capsule's names have with the dock drawn out, the panel's
// or the page's: its width then, as dock_layout makes it (the page's alone
// between the buttons; both readers', each half the row about ⋯, or side
// by side each in its half), less its ends.
dock_capsule_room_out(panel_s: bool): f64 {
    left: f64 = chrome_safe.left + DOCK_SIDE;
    right: f64 = chrome_bounds.w - chrome_safe.right - DOCK_SIDE;
    if (!dock_split() && !(dock_morphing && dock_morph_open)) return right - left - 2.0f64 * (DOCK_H + DOCK_GAP) - 28.0f64;
    w: f64 = (right - left - DOCK_H - 2.0f64 * DOCK_GAP) / 2.0f64;
    if (panel_side()) {
        at: f64 = if (dock_morphing) dock_morph_at else panel.line;
        r: Rect = if (panel_s) dock_side_capsule_in(at + DOCK_H / 2.0f64 + DOCK_GAP,
            right, 0.0f64, -1.0f64) else dock_side_capsule_in(left, at - DOCK_H / 2.0f64 - DOCK_GAP,
            0.0f64, -1.0f64);
        w = r.w
    }
    w - 16.0f64
}

// Drawn in, a capsule's name's scale (its 17-point type looking 15).
DOCK_COMPACT_SCALE: f64 = 0.882f64;

// A capsule's two names placed in it (w by h), as wide as room lets them
// (drawn out's: the same drawn in), the larger scaled by scale: its
// middle above the capsule's (at it drawn in), the smaller under it (up
// under it drawn in, clear).
dock_names_place(
    large: int,
    small: int,
    w: f64,
    h: f64,
    room: f64,
    scale: f64
) {
    drawn_in: bool = scale < 1.0f64;
    large_w: f64 = clamp_f(intrinsic_size(large).w, 0.0f64, room);
    small_w: f64 = clamp_f(intrinsic_size(small).w, 0.0f64, room);
    set_bounds_center(large, w / 2.0f64, if (drawn_in) h / 2.0f64 else h / 2.0f64 - 7.0f64,
        large_w, 22.0f64);
    set_transform(large, scale, scale, 0.0f64, 0.0f64);
    set_bounds_center(small, w / 2.0f64, if (drawn_in) h / 2.0f64 else h / 2.0f64 + 10.5f64,
        small_w, 15.0f64);
    set_transform(small, scale, scale, 0.0f64, 0.0f64);
    set_alpha(large, 1.0f64);
    set_alpha(small, if (drawn_in) 0.0f64 else 1.0f64)
}

// What the page reads as the capsule says it, in room: its name, shrunk a
// little to fit (the label's); too long even so, its last words let go
// until it fits, two kept at least and none of the little ones last
// ("Henry's Concise", "Spurgeon's Treasury"): the panel's bar and a screen
// reader have it whole.
VERSION_SHRINK: f64 = 0.85f64;

version_shown(words: int, room: f64): int {
    if (words == 0 || dock.version_label == 0) return words;
    font: int = msg(dock.version_label, sel("font"));
    if (text_width(words, font) * VERSION_SHRINK <= room) return words;
    parts: int = msg1(words, sel("componentsSeparatedByString:"), nsstring(" "));
    n: int = msg(parts, sel("count"));
    while (n > 2) {
        n = n - 1;
        // (Not ending on "of", "the", "on", "and".)
        while (n > 2 && version_little_word(msg1(parts, sel("objectAtIndex:"), n - 1))) n = n - 1;
        made: int = version_words_first(parts, n);
        if (text_width(made, font) * VERSION_SHRINK <= room) return made
    }
    version_words_first(parts, n)
}

// The first n of words, a space between each.
version_words_first(parts: int, n: int): int {
    joined: int = fresh("NSMutableString");
    for k in 0..n {
        if (k > 0) msg1(joined, sel("appendString:"), nsstring(" "));
        msg1(joined, sel("appendString:"), msg1(parts, sel("objectAtIndex:"), k))
    }
    joined
}

version_little_word(word: int): bool {
    for little in ["of", "the", "on", "and", "a", "to", "in"] {
        if (ns_equal(word, nsstring(little))) return true
    }
    false
}

// The width of words set in font.
text_width(words: int, font: int): f64 {
    attributes: int = msg2(cls("NSDictionary"), sel("dictionaryWithObject:forKey:"),
        font, objc_const("NSFontAttributeName"));
    geo_of1(words, "sizeWithAttributes:", attributes);
    geo[0]
}

// The widest the names may be: the expanded capsule's width less its
// insets.
title_room(): f64 {
    if (dock_split() || dock_morphing) return frame_of(dock.title_glass).w - 16.0f64;
    left: f64 = chrome_safe.left + DOCK_SIDE;
    right: f64 = chrome_bounds.w - chrome_safe.right - DOCK_SIDE;
    right - left - 2.0f64 * (DOCK_H + DOCK_GAP) - 28.0f64
}

// The drawn-in capsule's width: its chapter's name and room either side.
compact_width(): f64 {
    text_w: f64 = intrinsic_size(dock.title_label).w * DOCK_COMPACT_SCALE;
    clamp_f(text_w + 40.0f64, 110.0f64, chrome_bounds.w - 80.0f64)
}

// The dock's mode changed, with a spring (the glass merging and parting).
dock_mode_set(mode: int) {
    if (dock.mode == mode) return;
    dock.mode = mode;
    if (mode == DOCK_TRAY) {
        set_hidden(dock.tray_glass, false);
        tray_contents_alpha(0.0f64)
    }
    spring(ANIM_DOCK, if (mode == DOCK_TRAY) 0.5f64 else 0.42f64, if (mode == DOCK_TRAY) 0.18f64 else 0.12f64);
    // (The tray's words come once its glass has mostly grown, and go before
    // it folds: never over the dock's.)
    if (mode == DOCK_TRAY) ease_after(ANIM_TRAY_WORDS, 0.2f64, 0.18f64) else ease(ANIM_TRAY_WORDS,
        0.1f64);
    status_bar_update()
}

// (The dock's animation: laid out in its mode; the tray's words come in
// as it opens.)
dock_animated() {
    dock_layout()
}

tray_words_animated() {
    tray_contents_alpha(if (dock.mode == DOCK_TRAY) 1.0f64 else 0.0f64)
}

dock_animation_ended() {
    if (dock.mode != DOCK_TRAY) set_hidden(dock.tray_glass, true);
    // (Gone back into the capsule: the panel's glass let go.)
    if (dock_readers == DOCK_PAGE_FOLDING) {
        dock_readers = DOCK_PAGE;
        glass_shown(dock_panel.glass, false, true, dock_tint())
    }
    if (!player.shown && player.glass != 0) set_hidden(player.glass, true)
}

// Drawn in or out (the development wire's `!dock`; a tap).
dock_set_compact(compact: bool) {
    if (dock.mode == DOCK_TRAY) return;
    dock_mode_set(if (compact) DOCK_COMPACT else DOCK_EXPANDED)
}

// Pane p moved by a hand to offset y (either pane: the dock is both
// readers' header): read on far enough, the dock draws in; back far
// enough, out. (Not while the tray shows.) Changed, each pane's turning
// point is where it is now, so that the other's earlier reading doesn't
// turn it back.
dock_pane_moved(p: int, y: f64, by_hand: bool) {
    if (dock.mode == DOCK_TRAY || !by_hand) {
        dock.turned_at[p] = y;
        return
    }
    d: f64 = y - dock.turned_at[p];
    if (dock.mode == DOCK_EXPANDED) {
        if (d > DOCK_TRAVEL) {
            dock_turned_here();
            dock_mode_set(DOCK_COMPACT)
        } else if (d < 0.0f64) dock.turned_at[p] = y
    } else {
        if (d < -DOCK_TRAVEL) {
            dock_turned_here();
            dock_mode_set(DOCK_EXPANDED)
        } else if (d > 0.0f64) dock.turned_at[p] = y
    }
}

// Each pane's turning point where it is now.
dock_turned_here() {
    for p in 0..PANES {
        pane: *Pane = pane_of(p);
        if (pane.scroll != 0) dock.turned_at[p] = pane_offset(pane)
    }
}

// A jump, a sheet: the dock out.
dock_expand() {
    if (dock.mode == DOCK_COMPACT) dock_mode_set(DOCK_EXPANDED);
    dock_turned_here()
}

// ---- its words ----
// The chapter's name (the page's named chapter's, as its part names it;
// before that, core's title line) and what the page reads.
title_shown_c: int = -2;

title_line_words: int = 0;

version_words: int = 0;

title_update() {
    if (dock.title_label == 0) return;
    c: int = page_named();
    if (c == title_shown_c && c >= 0) return;
    name: int = if (c >= 0) chapter_name(c) else 0;
    if (name == 0) name = title_line_words;
    if (name == 0) return;
    if (title_shown_c >= -1) cross_fade(dock.title_label, 0.18f64);
    title_shown_c = c;
    title_label_set(dock.title_label, name);
    msg1(dock.title_button, sel("setAccessibilityLabel:"), name);
    msg1(dock.title_button, sel("setAccessibilityHint:"), nsstring("Opens Go To"));
    if (dock.mode == DOCK_COMPACT) spring(ANIM_DOCK, 0.3f64, 0.0f64) else title_contents_layout()
}

// Chapter c's name as its first part on the page says it (0: unknown).
chapter_name(c: int): int {
    s: int = part_slot(PANE_PAGE, c, 0);
    if (s < 0) s = part_need(PANE_PAGE, c, 0);
    if (s < 0) return 0;
    name: int = 0;
    borrow parts[s] as part {
        name = part.name
    }
    name
}

// `carried HEX WORDS`: the ribbon carried ("Reading with Morning"), its
// glyph in its color before the chapter's name (`-`: none).
carried_color: int = 0;

carried_line(line: WireLine) {
    hex: int = word_hex(line, 1);
    carried_color = held(carried_color, if (hex >= 0) rgb(hex, 1.0f64) else 0);
    msg1(dock.title_button, sel("setAccessibilityValue:"), if (hex >= 0) field_ns(line,
        1) else version_words);
    title_shown_c = -2;
    title_update()
}

// The chapter's name as the capsule shows it: after the carried ribbon's
// glyph, if one is carried.
title_words_shown(name: int): int {
    if (carried_color == 0) return name;
    a: int = fresh("NSMutableAttributedString");
    glyph: int = msg2(symbol("bookmark.fill", 13.0f64, 6), sel("imageWithTintColor:renderingMode:"),
        carried_color, 1);
    attachment: int = msg1(cls("NSTextAttachment"), sel("textAttachmentWithImage:"),
        glyph);
    msg1(a, sel("appendAttributedString:"), msg1(cls("NSAttributedString"), sel("attributedStringWithAttachment:"),
        attachment));
    msg1(a, sel("appendAttributedString:"), autoreleased(msg1(msg(cls("NSAttributedString"),
        sel("alloc")), sel("initWithString:"), nsstring(" "))));
    msg1(a, sel("appendAttributedString:"), autoreleased(msg1(msg(cls("NSAttributedString"),
        sel("alloc")), sel("initWithString:"), name)));
    a
}

// ---- a document arriving: a hairline along the foot of its pane's bar
// (the page's capsule; the panel's bar), ink at 30%, as far as it has come
// ----
arrive_views: []int = new int[2](0);

arrive_shares: []f64 = new f64[2](-1.0f64);

arriving_line(p: int, thousandths: int) {
    if (p < 0 || p > 1) return;
    arrive_shares[p] = clamp_f(thousandths as f64 / 1000.0f64, 0.0f64, 1.0f64);
    arrive_place(p)
}

arrived_line(p: int) {
    if (p < 0 || p > 1) return;
    arrive_shares[p] = -1.0f64;
    if (arrive_views[p] != 0) ease(ANIM_ARRIVED, 0.2f64)
}

// The bar a pane's hairline is along.
arrive_bar(p: int): int {
    if (p == PANE_PAGE) return glass_content(dock.title_glass);
    if (!panel.column && dock_panel.glass != 0) return glass_content(dock_panel.glass);
    if (panel.nav == 0) 0 else msg(panel.nav, sel("navigationBar"))
}

arrive_place(p: int) {
    if (arrive_shares[p] < 0.0f64) return;
    bar: int = arrive_bar(p);
    if (bar == 0) return;
    v: int = arrive_views[p];
    if (v == 0 || msg(v, sel("superview")) != bar) {
        if (v != 0) msg(v, sel("removeFromSuperview"));
        v = view_new();
        msg1(v, sel("setUserInteractionEnabled:"), 0);
        add_sub(bar, v);
        arrive_views[p] = held(arrive_views[p], v);
        release(v)
    }
    set_background(v, rgb(look.ink, 0.3f64));
    set_alpha(v, 1.0f64);
    box: Rect = bounds_of(bar);
    inset: f64 = if (p == PANE_PAGE) box.h / 2.0f64 else 0.0f64;
    set_frame4(v, inset, box.h - 1.0f64, (box.w - 2.0f64 * inset) * arrive_shares[p],
        1.0f64)
}

// (Its fade, and its end.)
arrived_faded() {
    for p in 0..2
        if (arrive_shares[p] < 0.0f64 && arrive_views[p] != 0) set_alpha(arrive_views[p],
            0.0f64)
}

title_label_set(label: int, name: int) {
    if (carried_color != 0) msg1(label, sel("setAttributedText:"), title_words_shown(name)) else msg1(label,
        sel("setText:"), name)
}

// `title WORDS`: core's for the place (kept for before a part names it).
title_line(words: int) {
    title_line_words = held(title_line_words, words);
    if (title_shown_c < 0) {
        title_shown_c = -2;
        title_update()
    }
}

// `version WORDS`: what the page reads, under the chapter.
version_line(words: int) {
    if (ns_equal(words, version_words)) return;
    version_words = held(version_words, words);
    if (dock.version_label != 0) {
        cross_fade(dock.version_label, 0.18f64);
        title_contents_layout();
        msg1(dock.title_button, sel("setAccessibilityValue:"), words)
    }
}

// The chrome dressed in the look's colors.
chrome_dress() {
    if (dock.container == 0) return;
    for b in [dock.panel_button, dock.more_button] msg1(b, sel("setTintColor:"), colors.ink);
    msg1(dock.title_label, sel("setTextColor:"), colors.ink);
    msg1(dock.version_label, sel("setTextColor:"), colors.faint);
    msg1(dock.tray_label, sel("setTextColor:"), colors.ink);
    msg1(dock.tray_close, sel("setTintColor:"), colors.faint);
    tint: int = dock_tint();
    for g in [dock.left_glass, dock.title_glass, dock.right_glass, dock.tray_glass,
        capsule.glass, toast.glass] glass_tint(g, tint);
    panel_button_light(dock.panel_lit);
    dock_panel_dress();
    player_dress();
    capsule_dress();
    tray_dress()
}

// The panel's shapes in the look's colors.
dock_panel_dress() {
    if (dock_panel.glass == 0) return;
    msg1(dock_panel.place_label, sel("setTextColor:"), colors.ink);
    msg1(dock_panel.name_label, sel("setTextColor:"), colors.faint);
    glass_tint(dock_panel.glass, dock_tint())
}

// The glass's tint: the page's color, so the words over it read whatever
// passes under it.
dock_tint(): int {
    rgb(look.page, 0.62f64)
}

// The panel's button lit while the panel shows: the accent.
panel_button_light(lit: bool) {
    dock.panel_lit = lit;
    if (dock.panel_button == 0) return;
    msg1(dock.panel_button, sel("setTintColor:"), if (lit) colors.accent else colors.ink);
    msg1(dock.panel_button, sel("setAccessibilityValue:"), nsstring(if (lit) "Shown" else "Hidden"))
}

// ---- a title's menu: core's (titlemenu P), made as it opens ----
// The page's or the panel's: the pane whose capsule is held.
title_menu_pane: int = 0;

title_menu_block: int = 0;

// The menu, made as it opens (0: it can't be).
title_menu_make(): int {
    if (title_menu_block == 0) title_menu_block = block1(&title_menu_provide, 0, "v16@?0@?8");
    if (title_menu_block == 0) return 0;
    deferred: int = msg1(cls("UIDeferredMenuElement"), sel("elementWithUncachedProvider:"),
        title_menu_block);
    one_item[0] = deferred;
    msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""), nsarray(one_item,
        1))
}

one_item: []int = new int[1](0);

// The menu's model, for the place now (its place told first).
menu_screen: WireScreen = wire_screen();

title_menu_provide(_context: int, completion: int): int {
    pane_of(title_menu_pane).said_c = -1;
    pane_tell(title_menu_pane, true);
    items: int = fresh("NSMutableArray");
    ask_begin();
    out_word("titlemenu");
    out_arg(title_menu_pane);
    out_end();
    if (ask_end("screen") && wire_decode_span(&menu_screen, answer_buf, 0, answer_n)) menu_items_add(&menu_screen,
        items);
    _r: int = l8_block_invoke(completion, items, 0, 0);
    0
}

// A screen's sections as menu items: the first's rows as commands, each
// other a submenu under its header.
menu_items_add(screen: *WireScreen, items: int) {
    for s in 0..screen.sections_n {
        section: UiSection = screen.sections[s];
        kids: int = if (s == 0) items else fresh("NSMutableArray");
        for r in section.first..section.first + section.n msg1(kids, sel("addObject:"),
            menu_command(screen, screen.rows[r]));
        if (s > 0) msg1(items, sel("addObject:"), msg5(cls("UIMenu"), sel("menuWithTitle:image:identifier:options:children:"),
            screen_text(screen, section.header), 0, 0, 0, kids))
    }
}

extern msg5(
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int,
    d: int,
    e: int
): int = objc_msgSend;

// A row as a command: its words, its symbol (in its color), where it is
// (a subtitle), off if it can't be done; its action and argument its
// property list, done by vellumMenuItem: up the responder chain.
menu_command(screen: *WireScreen, row: UiRow): int {
    image: int = if (row.icon.n > 0) symbol_image(screen_text(screen, row.icon), 17.0f64,
        4) else 0;
    if (image != 0 && row.icon_color.n > 0) image = msg2(image, sel("imageWithTintColor:renderingMode:"),
        screen_color(screen, row.icon_color), 1);
    command: int = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
        screen_text(screen, row.title), image, sel("vellumMenuItem:"), nsnumber_int(row.action * 1000000 + row.arg));
    if (row.detail.n > 0 && responds(command, "setSubtitle:")) msg1(command, sel("setSubtitle:"),
        screen_text(screen, row.detail));
    if (row.disabled) msg1(command, sel("setAttributes:"), 1);
    if (row.destructive) msg1(command, sel("setAttributes:"), 2);
    command
}

// A menu's item chosen (a title's): core's, at its pane's place measured
// now.
menu_item_chosen(_self: int, _cmd: int, sender: int): int {
    if (sender == 0 || !responds(sender, "propertyList")) return 0;
    number: int = msg(sender, sel("propertyList"));
    if (number == 0) return 0;
    k: int = msg(number, sel("longValue"));
    pane_of(title_menu_pane).said_c = -1;
    pane_tell(title_menu_pane, true);
    send3("menuact", k / 1000000, k % 1000000, title_menu_pane);
    0
}

// ---- the tray ----
tray_screen: WireScreen = wire_screen();

tray_make() {
    content: int = glass_content(dock.tray_glass);
    dock.tray_label = retain(label_new(font_rounded(15.0f64, 0.5f64), colors.ink,
        1));
    add_sub(content, dock.tray_label);
    dock.tray_close = retain(chrome_button("vellumTrayClose:"));
    button_symbol(dock.tray_close, "xmark", 14.0f64);
    msg1(dock.tray_close, sel("setAccessibilityLabel:"), nsstring("Close"));
    add_sub(content, dock.tray_close);
    for i in 0..len(dock.swatches) {
        b: int = chrome_button("vellumTraySwatch:");
        msg1(b, sel("setTag:"), i);
        set_corners(b, 15.0f64);
        layer: int = msg(b, sel("layer"));
        msg_set_f(layer, sel("setBorderWidth:"), 1.0f64);
        dock.swatches[i] = retain(b);
        add_sub(content, b)
    }
    for i in 0..len(dock.actions) {
        b: int = chrome_button("vellumTrayAction:");
        msg1(b, sel("setTag:"), i);
        dock.actions[i] = retain(b);
        add_sub(content, b)
    }
}

tray_contents_alpha(alpha: f64) {
    set_alpha(dock.tray_label, alpha);
    set_alpha(dock.tray_close, alpha);
    for b in dock.swatches set_alpha(b, alpha);
    for b in dock.actions set_alpha(b, alpha)
}

// The tray's contents laid out for its width w: the reference and close
// along its top, the swatches under them, the actions along its foot.
tray_layout(w: f64) {
    if (dock.tray_label == 0) return;
    pad: f64 = 14.0f64;
    set_frame4(dock.tray_label, pad + 4.0f64, 16.0f64, w - pad * 2.0f64 - 36.0f64,
        22.0f64);
    set_frame4(dock.tray_close, w - pad - 30.0f64, 10.0f64, 30.0f64, 30.0f64);
    shown: int = tray_swatches_shown();
    size: f64 = 30.0f64;
    gap: f64 = 14.0f64;
    x: f64 = pad + 4.0f64;
    for i in 0..len(dock.swatches) {
        b: int = dock.swatches[i];
        if (i < shown) {
            set_frame4(b, x, 50.0f64, size, size);
            x = x + size + gap
        }
        set_hidden(b, i >= shown)
    }
    n: int = tray_actions_shown();
    if (n == 0) return;
    aw: f64 = (w - pad * 2.0f64) / n as f64;
    for i in 0..len(dock.actions) {
        b: int = dock.actions[i];
        if (i < n) set_frame4(b, pad + aw * i as f64, 96.0f64, aw, 62.0f64);
        set_hidden(b, i >= n)
    }
}

tray_swatches_shown(): int {
    if (tray_screen.sections_n < 1 || tray_screen.sections[0].n < 1) return 0;
    row: UiRow = tray_screen.rows[tray_screen.sections[0].first];
    n: int = 1;
    for x in row.options.at..row.options.at + row.options.n
        if (tray_screen.pool[x] as int == 124) n = n + 1;
    if (row.options.n == 0) 0 else clamp_i(n, 0, len(dock.swatches))
}

tray_actions_shown(): int {
    if (tray_screen.sections_n < 2) 0 else clamp_i(tray_screen.sections[1].n, 0, len(dock.actions))
}

// The tray dressed as core's model says (core/tray.l8): the reference,
// each color (the chosen ringed), each action's words, symbol and state.
tray_dress() {
    if (dock.tray_label == 0 || tray_screen.sections_n < 1) return;
    msg1(dock.tray_label, sel("setText:"), screen_text(&tray_screen, tray_screen.title));
    swatch_row: UiRow = tray_screen.rows[tray_screen.sections[0].first];
    labels: int = screen_text(&tray_screen, swatch_row.detail);
    label_parts: int = if (labels != 0) msg1(labels, sel("componentsSeparatedByString:"),
        nsstring("|")) else 0;
    shown: int = tray_swatches_shown();
    for i in 0..shown {
        b: int = dock.swatches[i];
        // (The last, past the five colors: None.)
        fill: int = if (i < HIGHLIGHTS && highlight_swatch[i] != 0) highlight_swatch[i] else colors.page;
        set_background(b, fill);
        layer: int = msg(b, sel("layer"));
        chosen: bool = swatch_row.value == i;
        msg_set_f(layer, sel("setBorderWidth:"), if (chosen) 2.5f64 else 1.0f64);
        msg1(layer, sel("setBorderColor:"), msg(if (chosen) colors.ink else with_alpha(colors.ink,
            0.15f64), sel("CGColor")));
        if (i >= HIGHLIGHTS) button_symbol(b, "circle.slash", 14.0f64) else msg2(b,
            sel("setImage:forState:"), 0, 0);
        if (label_parts != 0 && i < msg(label_parts, sel("count"))) msg1(b, sel("setAccessibilityLabel:"),
            msg1(label_parts, sel("objectAtIndex:"), i))
    }
    n: int = tray_actions_shown();
    for i in 0..n {
        row: UiRow = tray_screen.rows[tray_screen.sections[1].first + i];
        b: int = dock.actions[i];
        config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
        msg1(config, sel("setImage:"), symbol_image(screen_text(&tray_screen, row.icon),
            19.0f64, 5));
        // (Seven across a phone: small titles, no insets, so every word
        // shows whole.)
        keys: []int = dict_keys;
        values: []int = dict_values;
        keys[0] = objc_const("NSFontAttributeName");
        values[0] = font_system(10.0f64, 0.23f64);
        msg1(config, sel("setAttributedTitle:"), autoreleased(msg2(msg(cls("NSAttributedString"),
            sel("alloc")), sel("initWithString:attributes:"), if (row.title.n > 0) screen_text(&tray_screen,
            row.title) else nsstring(""), nsdictionary(keys, values, 1))));
        msg_insets(config, sel("setContentInsets:"), 4.0f64, 0.0f64, 4.0f64, 0.0f64);
        msg1(config, sel("setImagePlacement:"), 1);
        msg_set_f(config, sel("setImagePadding:"), 5.0f64);
        msg1(config, sel("setBaseForegroundColor:"), if (row.tinted) colors.accent else colors.ink);
        msg1(config, sel("setTitleLineBreakMode:"), 4);
        msg1(b, sel("setConfiguration:"), config);
        msg1(b, sel("setEnabled:"), if (row.disabled) 0 else 1);
        msg1(b, sel("setAccessibilityLabel:"), screen_text(&tray_screen, if (row.label.n > 0) row.label else row.title));
        msg1(b, sel("setAccessibilityHint:"), if (row.hint.n > 0) screen_text(&tray_screen,
            row.hint) else 0)
    }
    tray_layout(frame_of(dock.tray_glass).w)
}

// `tray`: the model came (screen 0): the capsule becomes the tray.
tray_shown_now() {
    capsule_away();
    tray_dress();
    if (dock.mode != DOCK_TRAY) {
        tray_return_mode = dock.mode;
        dock_mode_set(DOCK_TRAY)
    }
}

tray_return_mode: int = 0;

// `tray_away`: back into the capsule.
tray_hide() {
    if (dock.mode == DOCK_TRAY) dock_mode_set(DOCK_EXPANDED)
}

tray_close_tapped(_self: int, _cmd: int, _sender: int): int {
    send2("trayact", ACT_TRAY_CLOSE, 0);
    0
}

tray_swatch_tapped(_self: int, _cmd: int, sender: int): int {
    haptic_impact(0);
    send2("trayact", ACT_TRAY_COLOR, msg(sender, sel("tag")));
    0
}

// The button a share's popover points from (the tray's Share).
share_from: int = 0;

tray_action_tapped(_self: int, _cmd: int, sender: int): int {
    i: int = msg(sender, sel("tag"));
    if (tray_screen.sections_n < 2 || i >= tray_screen.sections[1].n) return 0;
    share_from = sender;
    send2("trayact", tray_screen.rows[tray_screen.sections[1].first + i].action, 0);
    share_from = 0;
    0
}

// ---- the way back: a capsule at the top ----
type Capsule = {
    glass: int;
    button: int;
    words: int;
    shown: bool;
    // How long it stays (s), how many screens of reading on let it go, and
    // the page's offset it measures from.
    seconds: f64;
    screens: f64;
    from_y: f64;
    timer: int
}

capsule: Capsule = Capsule {
    glass: 0,
    button: 0,
    words: 0,
    shown: false,
    seconds: 8.0f64,
    screens: 2.0f64,
    from_y: 0.0f64,
    timer: 0
};

capsule_make(parent: int) {
    capsule.glass = retain(glass_view(true));
    add_sub(parent, capsule.glass);
    capsule.button = retain(chrome_button("vellumBackTapped:"));
    add_sub(glass_content(capsule.glass), capsule.button);
    set_alpha(capsule.glass, 0.0f64);
    set_hidden(capsule.glass, true)
}

capsule_dress() {
    if (capsule.button == 0 || capsule.words == 0) return;
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setImage:"), symbol("arrow.uturn.backward", 13.0f64, 6));
    msg1(config, sel("setTitle:"), capsule.words);
    msg_set_f(config, sel("setImagePadding:"), 7.0f64);
    msg1(config, sel("setBaseForegroundColor:"), colors.ink);
    msg1(capsule.button, sel("setConfiguration:"), config)
}

capsule_layout() {
    if (capsule.glass == 0) return;
    w: f64 = clamp_f(intrinsic_size(capsule.button).w + 8.0f64, 120.0f64, chrome_bounds.w - 60.0f64);
    h: f64 = 40.0f64;
    x: f64 = (chrome_bounds.w - w) / 2.0f64;
    y: f64 = chrome_safe.top + 2.0f64;
    set_frame4(capsule.glass, x, if (capsule.shown) y else y - 12.0f64, w, h);
    set_corners(capsule.glass, h / 2.0f64);
    set_frame4(capsule.button, 0.0f64, 0.0f64, w, h);
    set_alpha(capsule.glass, if (capsule.shown) 1.0f64 else 0.0f64)
}

// `back MS SCREENS WORDS HINT`: the capsule's words (none: away).
back_line(line: WireLine) {
    capsule.seconds = word_n(line, 1) as f64 / 1000.0f64;
    capsule.screens = word_n(line, 2) as f64;
    words: int = field_ns(line, 1);
    capsule.words = held(capsule.words, if (ns_length(words) > 0) words else 0);
    if (capsule.button != 0) msg1(capsule.button, sel("setAccessibilityHint:"), field_ns(line,
        2));
    if (capsule.words == 0) {
        capsule_away();
        return
    }
    capsule.from_y = (if (page_pane.scroll != 0) pane_offset(&page_pane) else 0.0f64);
    capsule_dress();
    if (dock.mode != DOCK_TRAY) capsule_show()
}

capsule_show() {
    if (capsule.glass == 0) return;
    set_hidden(capsule.glass, false);
    capsule_layout();
    capsule.shown = true;
    spring(ANIM_CAPSULE, 0.4f64, 0.2f64);
    capsule.timer = timer_stop(capsule.timer);
    capsule.timer = timer_after(chrome_target, if (capsule.seconds > 0.5f64) capsule.seconds else 8.0f64,
        "vellumBackTimeout:")
}

capsule_away() {
    if (!capsule.shown) return;
    capsule.shown = false;
    capsule.timer = timer_stop(capsule.timer);
    ease(ANIM_CAPSULE, 0.2f64)
}

capsule_ended() {
    if (!capsule.shown) set_hidden(capsule.glass, true)
}

// The page read on a while from where the jump left it: the way back goes.
capsule_page_moved(y: f64) {
    if (!capsule.shown) return;
    if (abs_f(y - capsule.from_y) > capsule.screens * chrome_bounds.h) capsule_away()
}

capsule_tapped(_self: int, _cmd: int, _sender: int): int {
    if (capsule.words == 0) return 0;
    send0("back");
    0
}

capsule_timed_out(_self: int, _cmd: int, _timer: int): int {
    capsule.timer = 0;
    capsule_away();
    0
}

// ---- toasts ----
type Toast = {
    glass: int;
    icon: int;
    label: int;
    shown: bool;
    timer: int
}

toast: Toast = Toast {
    glass: 0,
    icon: 0,
    label: 0,
    shown: false,
    timer: 0
};

toast_make(parent: int) {
    toast.glass = retain(glass_view(false));
    add_sub(parent, toast.glass);
    content: int = glass_content(toast.glass);
    toast.icon = retain(autoreleased(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        0)));
    toast.label = retain(label_new(font_rounded(15.0f64, 0.4f64), colors.ink, 2));
    add_sub(content, toast.icon);
    add_sub(content, toast.label);
    msg1(toast.glass, sel("setUserInteractionEnabled:"), 0);
    set_alpha(toast.glass, 0.0f64);
    set_hidden(toast.glass, true)
}

toast_layout() {
    if (toast.glass == 0) return;
    max_w: f64 = chrome_bounds.w - 64.0f64;
    msg_set_f(toast.label, sel("setPreferredMaxLayoutWidth:"), max_w - 64.0f64);
    text: Rect = intrinsic_size(toast.label);
    has_icon: bool = msg(toast.icon, sel("image")) != 0;
    w: f64 = clamp_f(text.w + (if (has_icon) 64.0f64 else 40.0f64), 140.0f64, max_w);
    h: f64 = clamp_f(text.h + 24.0f64, 44.0f64, 90.0f64);
    x: f64 = (chrome_bounds.w - w) / 2.0f64;
    y: f64 = chrome_safe.top + 2.0f64;
    set_frame4(toast.glass, x, if (toast.shown) y else y - 20.0f64, w, h);
    set_corners(toast.glass, if (h < 50.0f64) h / 2.0f64 else 22.0f64);
    left: f64 = if (has_icon) 44.0f64 else 20.0f64;
    set_frame4(toast.icon, 16.0f64, (h - 20.0f64) / 2.0f64, 20.0f64, 20.0f64);
    set_frame4(toast.label, left, 0.0f64, w - left - 20.0f64, h);
    set_alpha(toast.glass, if (toast.shown) 1.0f64 else 0.0f64)
}

// A toast: its words and symbol (0: none), for a moment.
toast_show(words: int, symbol_name: int) {
    if (toast.glass == 0 || words == 0) return;
    msg1(toast.label, sel("setText:"), words);
    msg1(toast.label, sel("setTextColor:"), colors.ink);
    image: int = if (symbol_name != 0 && ns_length(symbol_name) > 0) symbol_image(symbol_name,
        16.0f64, 6) else 0;
    msg1(toast.icon, sel("setImage:"), image);
    msg1(toast.icon, sel("setTintColor:"), colors.accent);
    capsule_away();
    if (!toast.shown) {
        set_hidden(toast.glass, false);
        toast_layout()
    }
    toast.shown = true;
    spring(ANIM_TOAST, 0.45f64, 0.25f64);
    if (voice_over()) UIAccessibilityPostNotification(objc_const("UIAccessibilityAnnouncementNotification"),
        words);
    toast.timer = timer_stop(toast.timer);
    seconds: f64 = 1.4f64 + ns_length(words) as f64 * 0.03f64;
    toast.timer = timer_after(chrome_target, clamp_f(seconds, 1.4f64, 4.0f64), "vellumToastDone:")
}

toast_timed_out(_self: int, _cmd: int, _timer: int): int {
    toast.timer = 0;
    toast.shown = false;
    ease(ANIM_TOAST, 0.25f64);
    0
}

toast_ended() {
    if (!toast.shown) set_hidden(toast.glass, true)
}

// `toast SYMBOL ICON WORDS`: core's (ICON `-`: the carried ribbon's).
toast_line(line: WireLine) {
    icon: int = word_ns_at(line, 2);
    if (icon != 0 && ns_equal(icon, nsstring("-"))) icon = nsstring("bookmark.fill");
    haptic_impact(2);
    toast_show(field_ns(line, 1), icon)
}

// Word w of the first field as an NSString (0: none).
word_ns_at(line: WireLine, w: int): int {
    at: int = field_word_at(line, w);
    e: int = word_end_at(line, at);
    if (e <= at) return 0;
    nsstring_at(bytes_address(line.data) + at, e - at)
}

add_dock_methods(target: int) {
    add_method1(target, sel("vellumPanelTapped:"), &dock_panel_tapped, "v@:@");
    add_method1(target, sel("vellumTitleTapped:"), &dock_title_tapped, "v@:@");
    add_method1(target, sel("vellumTrayClose:"), &tray_close_tapped, "v@:@");
    add_method1(target, sel("vellumTraySwatch:"), &tray_swatch_tapped, "v@:@");
    add_method1(target, sel("vellumTrayAction:"), &tray_action_tapped, "v@:@");
    add_method1(target, sel("vellumBackTapped:"), &capsule_tapped, "v@:@");
    add_method1(target, sel("vellumBackTimeout:"), &capsule_timed_out, "v@:@");
    add_method1(target, sel("vellumToastDone:"), &toast_timed_out, "v@:@");
    add_method1(target, sel("vellumMenuItem:"), &menu_item_chosen, "v@:@");
    add_method1(target, sel("vellumPanelTitleTapped:"), &dock_panel_title_tapped,
        "v@:@");
    add_method1(target, sel("vellumDockMore:"), &dock_more_chosen, "v@:@");
    add_method2(target, sel("contextMenuInteraction:configurationForMenuAtLocation:"),
        &dock_hold_configuration, "@@:@{CGPoint=dd}");
    add_method3(target, sel("contextMenuInteraction:configuration:highlightPreviewForItemWithIdentifier:"),
        &dock_hold_preview, "@@:@@@");
    add_method3(target, sel("contextMenuInteraction:configuration:dismissalPreviewForItemWithIdentifier:"),
        &dock_hold_preview, "@@:@@@");
    add_method3(target, sel("contextMenuInteraction:willDisplayMenuForConfiguration:animator:"),
        &dock_hold_will_show, "v@:@@@");
    add_method3(target, sel("contextMenuInteraction:willEndForConfiguration:animator:"),
        &dock_hold_will_end, "v@:@@@");
    add_protocol(target, "UIContextMenuInteractionDelegate")
}

dock_panel_tapped(_self: int, _cmd: int, _sender: int): int {
    haptic_impact(0);
    send0("tap shelf");
    0
}

// The capsule: drawn in, a tap brings the dock out; else Go To, its field
// rising out of the capsule (goto.l8).
dock_title_tapped(_self: int, _cmd: int, _sender: int): int {
    if (dock.mode == DOCK_COMPACT) {
        dock_mode_set(DOCK_EXPANDED);
        return 0
    }
    quick_rise_from_capsule();
    0
}

// Listen: core's own command (KC_LISTEN, as the keyboard's), started or
// paused where core says it acts.
dock_listen_tapped(_self: int, _cmd: int, _sender: int): int {
    command: KeyCommand = key_commands[KC_LISTEN];
    if (command.name == 0) return 0;
    haptic_impact(0);
    out_word("key ");
    out_ns(command.name);
    out_arg(command.mods);
    out_end();
    0
}

// ---- the panel's title in the dock ----
// While the panel shows in a split (not a column), the dock is the header
// of both readers, as symmetrical as the page's alone: the page's capsule
// (its chapter, the version) at the left, ⋯ in the middle and the panel's
// (what it reads, where) at the right. The panel's own bar is gone, and
// the panel's button is on the split's divider (panel.l8: it goes up
// there as the panel comes, with the link beside it, and back as it
// goes): coming, the dock moves over by a place, the page's capsule over
// where the panel's button was, ⋯ to the middle, the panel's capsule
// growing out of where ⋯ was. The panel's capsule's tap is Go To aimed at
// the panel; its long press, the panel's menu (core's: Swap Panes, Close
// Panel).
type DockPanel = {
    glass: int;
    button: int;
    name_label: int;
    place_label: int;
    // The panel's reader's screen as it last said it: its slot (-1: none
    // yet), what it reads and where, its title's action (Go To aimed at
    // it), Link's action and argument and whether linked or off, its
    // menu's action and items (`ARG:TITLE` split by |, held).
    slot: int;
    name: int;
    place: int;
    title_action: int;
    link_action: int;
    link_arg: int;
    linked: bool;
    link_off: bool;
    menu_action: int;
    menu: int
}

dock_panel: DockPanel = DockPanel {
    glass: 0,
    button: 0,
    name_label: 0,
    place_label: 0,
    slot: -1,
    name: 0,
    place: 0,
    title_action: 0,
    link_action: 0,
    link_arg: 0,
    linked: false,
    link_off: false,
    menu_action: 0,
    menu: 0
};

// Whether the dock is the header of both: the panel shown in a split,
// its reader said.
dock_split(): bool {
    dock.panel_lit && !panel.column && dock_panel.slot >= 0
}

// The panel's shapes made, in the dock's container (content), unseen.
dock_panel_make(content: int) {
    dock_panel.glass = retain(glass_view(true));
    add_sub(content, dock_panel.glass);
    dock_panel.button = retain(chrome_button("vellumPanelTitleTapped:"));
    add_sub(glass_content(dock_panel.glass), dock_panel.button);
    // (As the page's capsule has its chapter over its version: where the
    // panel is over what it reads, in the same type.)
    dock_panel.place_label = retain(label_new(font_rounded(17.0f64, 0.4f64), colors.ink,
        1));
    msg1(dock_panel.place_label, sel("setTextAlignment:"), 1);
    msg1(dock_panel.place_label, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(dock_panel.place_label, sel("setMinimumScaleFactor:"), 0.75f64);
    dock_panel.name_label = retain(label_new(font_rounded(11.5f64, 0.0f64), colors.faint,
        1));
    msg1(dock_panel.name_label, sel("setTextAlignment:"), 1);
    msg1(dock_panel.name_label, sel("setLineBreakMode:"), 4);
    msg1(dock_panel.name_label, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(dock_panel.name_label, sel("setMinimumScaleFactor:"), VERSION_SHRINK);
    for l in [dock_panel.name_label, dock_panel.place_label] {
        msg1(l, sel("setUserInteractionEnabled:"), 0);
        add_sub(dock_panel.button, l)
    }
    dock_hold_menu_attach(dock_panel.button);
    set_alpha(dock_panel.glass, 0.0f64);
    set_hidden(dock_panel.glass, true);
    set_alpha(dock_panel.button, 0.0f64)
}

// The panel's reader's screen (decoded now, slot s): its title, Link and
// menu taken into the dock, the dock laid out anew.
dock_panel_said(s: int) {
    dock_panel.slot = s;
    dock_panel_dress();
    dock_panel.name = held(dock_panel.name, dock_panel_title_short(ui_text(ui.left)));
    dock_panel.place = held(dock_panel.place, ui_text(ui.title));
    dock_panel.title_action = ui.left_action;
    dock_panel.link_action = 0;
    dock_panel.menu_action = 0;
    dock_panel.menu = held(dock_panel.menu, 0);
    for k in 0..ui.tools_n {
        tool: UiTool = ui.tools[k];
        if (tool.menu.n > 0) {
            dock_panel.menu_action = tool.action;
            dock_panel.menu = held(dock_panel.menu, ui_text(tool.menu))
        } else if (dock_panel.link_action == 0) {
            dock_panel.link_action = tool.action;
            dock_panel.link_arg = tool.arg;
            dock_panel.linked = tool.style == UI_TOOL_PROMINENT;
            dock_panel.link_off = tool.style == UI_TOOL_OFF
        }
    }
    panel_divider_dress();
    msg1(dock_panel.name_label, sel("setText:"), dock_panel.name);
    msg1(dock_panel.place_label, sel("setText:"), dock_panel.place);
    msg1(dock_panel.button, sel("setAccessibilityValue:"), if (dock_panel.link_off) 0 else nsstring(if (dock_panel.linked) "Linked" else "Not Linked"));
    words_begin();
    words_add_ns(dock_panel.place);
    words_add(", ");
    words_add_ns(dock_panel.name);
    msg1(dock_panel.button, sel("setAccessibilityLabel:"), words_ns());
    msg1(dock_panel.button, sel("setAccessibilityHint:"), nsstring("Go To for the panel. Touch and hold for its menu."));
    spring(ANIM_DOCK, 0.42f64, 0.12f64)
}

// The panel's button on the split's divider (panel.l8) rather than in the
// dock, at rest: its glass here let go at once, the divider's in its
// place; back, its glass here again.
dock_panel_button_away: bool = false;

dock_panel_button_away_now() {
    dock_panel_button_away = true;
    view_class: int = cls("UIView");
    was: bool = truth(msg(view_class, sel("areAnimationsEnabled")));
    msg1(view_class, sel("setAnimationsEnabled:"), 0);
    glass_shown(dock.left_glass, false, true, dock_tint());
    msg1(view_class, sel("setAnimationsEnabled:"), if (was) 1 else 0)
}

dock_panel_button_back() {
    if (!dock_panel_button_away) return;
    dock_panel_button_away = false;
    view_class: int = cls("UIView");
    was: bool = truth(msg(view_class, sel("areAnimationsEnabled")));
    msg1(view_class, sel("setAnimationsEnabled:"), 0);
    dock_layout();
    msg1(view_class, sel("setAnimationsEnabled:"), if (was) 1 else 0)
}

// ---- the panel's button leaving the dock, and coming back ----
// As the split opens or closes (panel.l8), in one spring, the panel's
// button is the dock's own glass, its middle at at across the divider
// (the root's coordinates: its y stacked, its x side by side), going
// between its place in the dock and the divider as the dock's other
// shapes go between the page's alone and both readers' (open). Stacked:
// the capsule over into its place, ⋯ to the middle, the panel's capsule
// growing out of ⋯. Side by side, the button sliding along the dock's
// row from its right end to the divider's foot: the capsule to the middle
// of the page's half, ⋯ up onto the divider, the panel's capsule growing
// out of the button to the middle of the panel's half. Its window is the
// screen's meanwhile, so that its glass goes wherever the button does.
dock_morphing: bool = false;

dock_morph_open: bool = false;

dock_morph_at: f64 = 0.0f64;

// ⋯ on the divider (panel.l8) rather than in the dock, at rest side by
// side: its glass here let go, the divider's in its place.
dock_more_away: bool = false;

// (Begun with the button where it is, in the dock or on the divider.)
dock_morph_begin(open: bool, at: f64) {
    if (dock_morphing) return;
    dock_morphing = true;
    dock_panel_button_away = false;
    dock_more_away = false;
    dock_morph_open = open;
    dock_morph_at = at;
    view_class: int = cls("UIView");
    was: bool = truth(msg(view_class, sel("areAnimationsEnabled")));
    msg1(view_class, sel("setAnimationsEnabled:"), 0);
    dock_layout();
    msg1(view_class, sel("setAnimationsEnabled:"), if (was) 1 else 0)
}

// (In the spring: the shapes go there in it.)
dock_morph(open: bool, at: f64) {
    dock_morph_open = open;
    dock_morph_at = at;
    dock_layout()
}

// Ended: the dock both readers' (the button on the divider) or the page's
// alone (the button in its place), at once, as the morph left it.
dock_morph_end(open: bool) {
    if (!dock_morphing) return;
    dock_morphing = false;
    dock_readers = (if (open && dock_split()) DOCK_BOTH else DOCK_PAGE);
    side: bool = panel_side();
    dock_panel_button_away = open && !side;
    dock_more_away = open && side;
    view_class: int = cls("UIView");
    was: bool = truth(msg(view_class, sel("areAnimationsEnabled")));
    msg1(view_class, sel("setAnimationsEnabled:"), 0);
    if (dock_panel_button_away) glass_shown(dock.left_glass, false, true, dock_tint());
    if (dock_more_away) glass_shown(dock.right_glass, false, true, dock_tint());
    dock_layout();
    msg1(view_class, sel("setAnimationsEnabled:"), if (was) 1 else 0)
}

// The shapes open or not, the button's middle at y, in a container the
// screen's size.
dock_morph_layout() {
    left: f64 = chrome_safe.left + DOCK_SIDE;
    right: f64 = chrome_bounds.w - chrome_safe.right - DOCK_SIDE;
    top: f64 = dock_foot() - DOCK_H;
    open: bool = dock_morph_open;
    dock_container_at(0.0f64, 0.0f64, chrome_bounds.w, chrome_bounds.h);
    if (panel_side()) {
        dock_morph_layout_side(left, right, top, open);
        return
    }
    b: f64 = if (open) PANEL_DIVIDER_BUTTON else DOCK_H;
    dock_place(dock.left_glass, left + DOCK_H / 2.0f64 - b / 2.0f64, dock_morph_at - b / 2.0f64,
        b, b, 1.0f64);
    // (Drawn in, the capsules as they are drawn in, until the dock comes
    // out in the spring: dock_expand.)
    if (dock.mode == DOCK_COMPACT) {
        dock_morph_layout_small(left, right, open);
        return
    }
    side_w: f64 = (right - left - DOCK_H - 2.0f64 * DOCK_GAP) / 2.0f64;
    title_x: f64 = if (open) left else left + DOCK_H + DOCK_GAP;
    title_w: f64 = if (open) side_w else right - left - 2.0f64 * (DOCK_H + DOCK_GAP);
    dock_place(dock.title_glass, title_x, top, title_w, DOCK_H, 1.0f64);
    dock_place(dock.right_glass, if (open) (left + right - DOCK_H) / 2.0f64 else right - DOCK_H,
        top, DOCK_H, DOCK_H, 1.0f64);
    if (dock_panel.glass != 0) {
        set_hidden(dock_panel.glass, false);
        w: f64 = if (open) side_w else DOCK_H;
        dock_place(dock_panel.glass, right - w, top, w, DOCK_H, if (open) 1.0f64 else 0.0f64)
    }
    tray_place_folded(title_x, top, title_w, DOCK_H)
}

// (Side by side: the panel's button in the dock's row at the morph's
// place; open, the capsules each in its half and ⋯ up on the divider over
// the button; else the dock alone's, the panel's capsule folded into the
// button's home. Drawn in, the capsules alone, each in its half open.)
dock_morph_layout_side(
    left: f64,
    right: f64,
    top: f64,
    open: bool
) {
    at: f64 = dock_morph_at;
    compact: bool = dock.mode == DOCK_COMPACT;
    row_h: f64 = if (compact) DOCK_COMPACT_H else DOCK_H;
    row_top: f64 = if (compact) dock_foot() - row_h + 6.0f64 else top;
    dock_place(dock.left_glass, at - row_h / 2.0f64, row_top, row_h, row_h, if (compact) 0.0f64 else 1.0f64);
    page: Rect = dock_side_page_rect(at, left, right, row_top, open);
    dock_place_side_capsule(dock.title_glass, page, at);
    b: f64 = PANEL_DIVIDER_BUTTON;
    if (open) dock_place(dock.right_glass, at - b / 2.0f64, panel_side_more_y() - b / 2.0f64,
        b, b, if (compact) 0.0f64 else 1.0f64) else dock_place(dock.right_glass, if (compact) page.x else left,
        row_top, row_h, row_h, if (compact) 0.0f64 else 1.0f64);
    if (dock_panel.glass != 0) {
        set_hidden(dock_panel.glass, false);
        if (open) dock_place_side_capsule(dock_panel.glass, dock_side_panel_rect(at,
            right, row_top), at) else dock_place(dock_panel.glass, right - row_h,
            row_top, row_h, row_h, 0.0f64)
    }
    tray_place_folded(page.x, page.y, page.w, page.h)
}

// Side by side, the page's capsule: open, in the middle of its half (left
// of the divider at at), as wide as it has room for; else the dock
// alone's, between ⋯ and the panel's button (drawn in, its own width in
// the middle). At the row's top, its height.
dock_side_page_rect(
    at: f64,
    left: f64,
    right: f64,
    row_top: f64,
    open: bool
): Rect {
    compact: bool = dock.mode == DOCK_COMPACT;
    h: f64 = if (compact) DOCK_COMPACT_H else DOCK_H;
    if (!open) {
        if (compact) {
            cw: f64 = compact_width();
            return Rect {
                x: (left + right - cw) / 2.0f64,
                y: row_top,
                w: cw,
                h: h
            }
        }
        return Rect {
            x: left + DOCK_H + DOCK_GAP,
            y: row_top,
            w: right - left - 2.0f64 * (DOCK_H + DOCK_GAP),
            h: h
        }
    }
    dock_side_capsule_in(left, at - DOCK_H / 2.0f64 - DOCK_GAP, row_top, if (compact) compact_width() else -1.0f64)
}

// Side by side, the panel's capsule: in the middle of its half (right of
// the divider at at).
dock_side_panel_rect(at: f64, right: f64, row_top: f64): Rect {
    compact: bool = dock.mode == DOCK_COMPACT;
    dock_side_capsule_in(at + DOCK_H / 2.0f64 + DOCK_GAP, right, row_top, if (compact) dock_panel_compact_w() else -1.0f64)
}

// A capsule in the middle of the room from x0 to x1, at most
// DOCK_SIDE_CAPSULE_MOST wide (drawn in, width wide, as its words are; -1:
// drawn out), at the row's top; no room (its half too narrow: the panel
// filling the screen), none wide.
DOCK_SIDE_CAPSULE_MOST: f64 = 320.0f64;

// A side-by-side capsule placed at r; none wide, folded into the panel's
// button at at, clear.
dock_place_side_capsule(glass: int, r: Rect, at: f64) {
    if (r.w > 0.0f64) dock_place(glass, r.x, r.y, r.w, r.h, 1.0f64) else dock_place(glass,
        at - r.h / 2.0f64, r.y, r.h, r.h, 0.0f64)
}

dock_side_capsule_in(
    x0: f64,
    x1: f64,
    row_top: f64,
    width: f64
): Rect {
    h: f64 = if (width >= 0.0f64) DOCK_COMPACT_H else DOCK_H;
    room: f64 = x1 - x0;
    w: f64 = if (width >= 0.0f64) width else room;
    if (w > DOCK_SIDE_CAPSULE_MOST) w = DOCK_SIDE_CAPSULE_MOST;
    if (w > room) w = room;
    if (w < h) w = 0.0f64;
    Rect {
        x: (x0 + x1 - w) / 2.0f64,
        y: row_top,
        w: w,
        h: h
    }
}

// (Drawn in: the page's capsule, the panel's beside it while open, ⋯
// drawn into them, as dock_split_layout and dock_layout draw them.)
dock_morph_layout_small(left: f64, right: f64, open: bool) {
    h: f64 = DOCK_COMPACT_H;
    top: f64 = dock_foot() - h + 6.0f64;
    page_w: f64 = compact_width();
    panel_w: f64 = if (open && dock_panel.glass != 0) dock_panel_compact_w() else h;
    total: f64 = if (open) page_w + DOCK_GAP + panel_w else page_w;
    x: f64 = (left + right) / 2.0f64 - total / 2.0f64;
    dock_place(dock.title_glass, x, top, page_w, h, 1.0f64);
    dock_place(dock.right_glass, if (open) x + page_w + DOCK_GAP / 2.0f64 - h / 2.0f64 else x + page_w - h,
        top, h, h, 0.0f64);
    if (dock_panel.glass != 0) {
        set_hidden(dock_panel.glass, false);
        dock_place(dock_panel.glass, x + total - panel_w, top, panel_w, h, if (open) 1.0f64 else 0.0f64)
    }
    tray_place_folded(x, top, page_w, h)
}

// Where the panel's button is now (the root's coordinates), and where it
// is in the dock drawn out, the page's alone.
dock_panel_button_rect(): Rect {
    f: Rect = frame_of(dock.left_glass);
    Rect {
        x: f.x + dock_origin_x,
        y: f.y + dock_origin_y,
        w: f.w,
        h: f.h
    }
}

dock_panel_button_home(): Rect {
    Rect {
        x: if (panel_side()) chrome_bounds.w - chrome_safe.right - DOCK_SIDE - DOCK_H else chrome_safe.left + DOCK_SIDE,
        y: dock_foot() - DOCK_H,
        w: DOCK_H,
        h: DOCK_H
    }
}

// The panel's reader gone (its split closed): the dock the page's alone.
dock_panel_gone() {
    dock_panel.slot = -1;
    spring(ANIM_DOCK, 0.42f64, 0.12f64)
}

// A document's title as its capsule says it: its leading "The" let go,
// and what follows " by ", " (" or a comma ("The Pilgrim's Progress by
// John Bunyan (1628-1688)": Pilgrim's Progress); the capsule lets more go
// if it must (version_shown).
dock_panel_title_short(title: int): int {
    if (title == 0) return 0;
    words: int = title;
    for cut in [" by ", " (", ","] {
        found: int = msg1(words, sel("rangeOfString:"), nsstring(cut));
        if (found > 0 && found < ns_length(words)) words = msg1(words, sel("substringToIndex:"),
            found)
    }
    if (truth(msg1(words, sel("hasPrefix:"), nsstring("The "))) && ns_length(words) > 4) words = msg1(words,
        sel("substringFromIndex:"), 4);
    words
}

// The panel's capsule's width drawn in (its place's).
dock_panel_compact_w(): f64 {
    clamp_f(intrinsic_size(dock_panel.place_label).w * DOCK_COMPACT_SCALE + 32.0f64,
        72.0f64, 160.0f64)
}

// The split dock laid out (dock_layout's, for the mode): the page's
// capsule, ⋯ and the panel's; drawn in, the two capsules alone, ⋯ drawn
// into them. Side by side, the panel's button at the divider's foot in
// the row, each capsule in its half, ⋯ on the divider (dock_more_away).
dock_split_layout(left: f64, right: f64, foot: f64) {
    set_hidden(dock_panel.glass, false);
    if (panel_side()) {
        dock_split_layout_side(left, right, foot);
        return
    }
    gap: f64 = DOCK_GAP;
    if (dock.mode == DOCK_COMPACT) {
        h: f64 = DOCK_COMPACT_H;
        top: f64 = foot - h + 6.0f64;
        page_w: f64 = compact_width();
        panel_w: f64 = dock_panel_compact_w();
        total: f64 = page_w + gap + panel_w;
        x: f64 = (left + right) / 2.0f64 - total / 2.0f64;
        dock_container_at(x, top, total, h);
        dock_place(dock.left_glass, x, top, h, h, 0.0f64);
        dock_place(dock.title_glass, x, top, page_w, h, 1.0f64);
        dock_place(dock.right_glass, x + page_w + gap / 2.0f64 - h / 2.0f64, top,
            h, h, 0.0f64);
        dock_place(dock_panel.glass, x + total - panel_w, top, panel_w, h, 1.0f64);
        tray_place_folded(x, top, page_w, h);
        player_place_at(x, top, total, x, page_w, h);
        return
    }
    top: f64 = foot - DOCK_H;
    side_w: f64 = (right - left - DOCK_H - 2.0f64 * gap) / 2.0f64;
    middle: f64 = (left + right) / 2.0f64;
    dock_container_at(left, top, right - left, DOCK_H);
    // (The panel's button's place, under the page's capsule: it is on the
    // divider.)
    dock_place(dock.left_glass, left, top, DOCK_H, DOCK_H, 0.0f64);
    dock_place(dock.title_glass, left, top, side_w, DOCK_H, 1.0f64);
    dock_place(dock.right_glass, middle - DOCK_H / 2.0f64, top, DOCK_H, DOCK_H, 1.0f64);
    dock_place(dock_panel.glass, right - side_w, top, side_w, DOCK_H, 1.0f64);
    tray_place_folded(left, top, side_w, DOCK_H);
    player_place_at(left, top, right - left, left, side_w, DOCK_H)
}

dock_split_layout_side(left: f64, right: f64, foot: f64) {
    at: f64 = panel.line;
    compact: bool = dock.mode == DOCK_COMPACT;
    h: f64 = if (compact) DOCK_COMPACT_H else DOCK_H;
    top: f64 = if (compact) foot - h + 6.0f64 else foot - h;
    dock_container_at(left, top, right - left, h);
    dock_place(dock.left_glass, at - h / 2.0f64, top, h, h, if (compact) 0.0f64 else 1.0f64);
    page: Rect = dock_side_page_rect(at, left, right, top, true);
    dock_place_side_capsule(dock.title_glass, page, at);
    b: f64 = PANEL_DIVIDER_BUTTON;
    dock_place(dock.right_glass, at - b / 2.0f64, panel_side_more_y() - b / 2.0f64,
        b, b, if (dock_more_away) 0.0f64 else 1.0f64);
    dock_place_side_capsule(dock_panel.glass, dock_side_panel_rect(at, right, top),
        at);
    tray_place_folded(page.x, page.y, page.w, page.h);
    player_place_at(left, top, right - left, page.x, page.w, h)
}

// Whose the dock was at its last layout: the page's alone, the page's
// with the panel's capsule still going back into ⋯, or both readers'.
DOCK_PAGE: int = 0;

DOCK_PAGE_FOLDING: int = 1;

DOCK_BOTH: int = 2;

dock_readers: int = 0;

dock_both(): bool {
    dock_readers == DOCK_BOTH
}

// The panel's capsule folded into ⋯ (the dock the page's alone): going
// (leaving, it was both readers'), its glass flowing into ⋯'s, dissolved
// once there (dock_animation_ended); else unseen.
dock_panel_fold(
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    leaving: bool
) {
    if (dock_panel.glass == 0) return;
    dock_place(dock_panel.glass, x, y, w, h, if (leaving) 1.0f64 else 0.0f64);
    set_alpha(glass_content(dock_panel.glass), 0.0f64)
}

// The dock becoming both readers': the panel's capsule put in ⋯'s place
// at once (side by side, the panel's button's), its glass on and its
// words clear, so that the split's animation grows it out of ⋯ as ⋯ goes
// to the middle (out of the button as it slides to the divider).
dock_panel_in_capsule() {
    if (dock_panel.glass == 0) return;
    view_class: int = cls("UIView");
    was: bool = truth(msg(view_class, sel("areAnimationsEnabled")));
    msg1(view_class, sel("setAnimationsEnabled:"), 0);
    f: Rect = frame_of(if (panel_side()) dock.left_glass else dock.right_glass);
    g: int = dock_panel.glass;
    set_hidden(g, false);
    set_frame(g, f);
    set_corners(g, f.h / 2.0f64);
    glass_shown(g, true, true, dock_tint());
    set_alpha(glass_content(g), 0.0f64);
    msg1(view_class, sel("setAnimationsEnabled:"), if (was) 1 else 0)
}

// The panel's capsule's words: where it is over what it reads (as the
// page's capsule has its chapter over the version), where it is alone
// drawn in, scaled as the page's is (dock_names_place).
dock_panel_contents_layout() {
    if (dock_panel.glass == 0) return;
    f: Rect = frame_of(dock_panel.glass);
    compact: bool = dock.mode == DOCK_COMPACT;
    set_frame4(dock_panel.button, 0.0f64, 0.0f64, f.w, f.h);
    // (Its names as wide drawn in as out, fitted to the capsule drawn out,
    // as the page's are.)
    room: f64 = dock_capsule_room_out(true);
    msg1(dock_panel.name_label, sel("setText:"), version_shown(dock_panel.name, room));
    dock_names_place(dock_panel.place_label, dock_panel.name_label, f.w, f.h, room,
        if (compact) DOCK_COMPACT_SCALE else 1.0f64)
}

// Whether the panel's reader's menu (core's) has Swap Panes: where the
// two can be swapped, the divider's.
dock_panel_can_swap(): bool {
    menu: int = dock_panel.menu;
    if (menu == 0) return false;
    words_begin();
    words_add_int(BESIDE_MENU_SWAP);
    words_add(":");
    at: int = words_ns();
    truth(msg1(menu, sel("hasPrefix:"), at)) || truth(msg1(menu, sel("containsString:"),
        msg1(nsstring("|"), sel("stringByAppendingString:"), at)))
}

// ⋯: the Library, Listen and Reading.
DOCK_MORE_LIBRARY: int = 1;

DOCK_MORE_LISTEN: int = 2;

DOCK_MORE_READING: int = 3;

dock_more_menu(): int {
    items: int = fresh("NSMutableArray");
    for k in [DOCK_MORE_LIBRARY, DOCK_MORE_LISTEN, DOCK_MORE_READING] {
        title: str = if (k == DOCK_MORE_LIBRARY) "Library" else if (k == DOCK_MORE_LISTEN) "Listen" else "Reading";
        icon: str = if (k == DOCK_MORE_LIBRARY) "books.vertical" else if (k == DOCK_MORE_LISTEN) "headphones" else "textformat.size";
        msg1(items, sel("addObject:"), msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
            nsstring(title), symbol(icon, 17.0f64, 4), sel("vellumDockMore:"), nsnumber_int(k)))
    }
    msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""), items)
}

dock_more_chosen(_self: int, _cmd: int, sender: int): int {
    if (sender == 0 || !responds(sender, "propertyList")) return 0;
    k: int = msg(msg(sender, sel("propertyList")), sel("longValue"));
    if (k == DOCK_MORE_LIBRARY) send0("tap library") else if (k == DOCK_MORE_LISTEN) _r: int = dock_listen_tapped(0,
        0, 0) else if (k == DOCK_MORE_READING) send0("tap settings");
    0
}

// The panel's capsule tapped: Go To aimed at the panel, its field rising
// out of the capsule.
dock_panel_title_tapped(_self: int, _cmd: int, _sender: int): int {
    if (dock.mode == DOCK_COMPACT) {
        dock_mode_set(DOCK_EXPANDED);
        return 0
    }
    if (dock_panel.slot >= 0 && dock_panel.title_action != 0) quick_rise_from_panel();
    0
}

// The divider's link tapped (or the development wire's `!link`): linked
// or not, as the panel's Link does it.
dock_link_tapped(_self: int, _cmd: int, _sender: int): int {
    if (dock_panel.slot < 0 || dock_panel.link_action == 0 || dock_panel.link_off) return 0;
    haptic_impact(0);
    act(dock_panel.slot, dock_panel.link_action, dock_panel.link_arg, 0);
    0
}
