// Section s's title is t.
title_is(s: int, t: str): bool {
    if (fs_title_e[s] - fs_title_b[s] != len(t)) return false;
    for i in 0..len(t)
        if (fs_pool[fs_title_b[s] + i] != t[i]) return false;
    true
}

test "a lemma's forms" {
    fresh();
    for which in 0..2 {
        if (which == 0) forms_of(true, 25) else forms_of(false, 559);
        forms_layout();
        forms_renderings();
        fbuf_n = 0;
        fput_int(fo_total);
        fput_str(" times, ");
        fput_int(fo_n);
        fput_str(" parsings:");
        for s in 0..fs_n {
            fput_str(if (s > 0) ", " else " ");
            fput_bytes(fs_pool, fs_title_b[s], fs_title_e[s]);
            if (!fs_grid[s]) fput_str(" (list)")
        }
        fput(10);
        for s in 0..fs_n {
            if (title_is(s, if (which == 0) "Aorist Active Indicative" else "Qal Consecutive Imperfect") || title_is(s,
                "Participles") || title_is(s, "Absolute")) {
                fput_bytes(fs_pool, fs_title_b[s], fs_title_e[s]);
                fput(58);
                for k in 0..fs_rows[s] {
                    r: int = fs_row_at(s, k);
                    if (k < 4) {
                        fput_str(" [");
                        fput_bytes(fs_pool, fr_label_b[r], fr_label_e[r]);
                        for c in [fr_cell0[r], fr_cell1[r]] {
                            if (c >= 0 || fs_grid[s]) fput(32);
                            if (c >= 0) {
                                at: int = form_at[fo_form[c]];
                                e: int = at;
                                while (lforms[e] as int != 9) e = e + 1;
                                fput_bytes(lforms, at, e);
                                fput(120);
                                fput_int(fo_count[c]);
                                fput(40);
                                _r: bool = fput_form_rendering(c);
                                fput(41)
                            } else if (fs_grid[s]) fput_str("\�\�\�")
                        }
                        fput(93)
                    }
                }
                fput(10)
            }
        }
        show_fbuf()
    }
    expect {|
        143 times, 39 parsings: Present Active Indicative, Present Active Subjunctive, Present Active Imperative, Present Middle or Passive Indicative, Imperfect Active Indicative, Future Active Indicative, Future Passive Indicative, Aorist Active Indicative, Aorist Active Subjunctive, Aorist Active Imperative, Perfect Active Indicative, Infinitives (list), Participles (list)
        Aorist Active Indicative: [1st person ἠγάπησαx5(I have loved) —] [2nd person ἠγάπησαςx5(You have loved) —] [3rd person ἠγάπησενx12(loved) ἠγάπησανx3(loved)]
        Participles: [ ἀγαπῶνx14(loves)] [ ἀγαπῶσινx4(love)] [ ἀγαπῶνταςx3(love)] [ ἀγαπώντωνx1(love)]
        5308 times, 65 parsings: Qal Perfect, Qal Imperfect, Qal Consecutive Imperfect, Qal Conjunctive Perfect, Qal Imperative, Nifal Perfect, Nifal Imperfect, Nifal Consecutive Imperfect, Hifil Perfect, Hitpael Imperfect, Qal Infinitive Construct (list), Qal Participle (list)
        Qal Consecutive Imperfect: [3rd masculine וַיֹּאמֶרx2071(said) וַיֹּאמְרוּx299(said)] [3rd feminine וַתֹּאמֶרx193(said) וַתֹּאמַרְנָהx8(answered)] [2nd masculine וַתֹּאמֶרx11(and you have said) וַתֹּאמְרוּx8(and said)] [2nd feminine וַתֹּאמְרִיx5(you said) —]
    |}
}

