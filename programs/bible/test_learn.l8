    fbuf_n = 0;
    fput_card_state(k, D0);
    learn_shown(k, D0);
    fput_str(", shown: ");
    fput_card_state(k, D0);
    _g: bool = learn_grade(k, G_KNEW, D0, T0, vi_of("JHN", 3, 16));
    fput_str(", Knew It: ");
    fput_card_state(k, D0);
    fput_str(if (word_card_known(0, 25)) " (known)" else " (not known)");
    // Two weeks on, Not Yet from box 2: box 1, not known.
    _n: bool = learn_grade(k, G_NOTYET, D0 + 14, T0, -1);
    fput_str("""

Not Yet: box """);
    fput_int(cd_box[k]);
    fput_str(if (word_card_known(0, 25)) " (known)" else " (not known)");
    // Mark as Known: box 4, due in 7 to 14 days.
    for num in [3588, 2532, 846, 4771, 1161] {
        j: int = learn_add_word(0, num, FROM_FREQ, D0, T0);
        learn_mark_known(j, D0, T0);
        fput_str("""

G""");
