test "verses you can read" {
    fresh();
    know_top(0, 120);
    know_letters(0, false);
    learn_readable(0, T0);
    fbuf_n = 0;
    fput_int(crv_readable);
    fput_str(" readable, ");
    fput_int(crv_nearly);
    fput_str(" with one word to learn; sections");
    for s in 0..5 {
        fput(32);
        fput_int(crv_count[s])
    }
    fput(10);
    show_fbuf();
    jn: int = vi_of("JHN", 3, 16);
    show_known(jn);
    for x in 0..crv_n
        if (crv_vi[x] == jn) print("John 3:16 is readable");
    // The first elsewhere, and the first with one word to learn.
    shown: int = 0;
    for x in 0..crv_n {
        if (shown < 2 && (crv_sec[x] == 3 && shown == 0 || crv_sec[x] == 4 && shown == 1)) {
            fbuf_n = 0;
            fput_ref(v_chapter(crv_vi[x]), v_num(crv_vi[x]), 0);
            if (crv_word[x] >= 0) {
                form_of(crv_word[x]);
                fput_str(" needs ");
                fput_bytes(lforms, wf_b, wf_e)
            }
            fput(10);
            show_fbuf();
            shown = shown + 1
        }
    }
    // Hebrew, at 300 with the alphabet and the joined words.
    know_top(1, 300);
    know_letters(1, true);
    learn_readable(1, T0);
    write_int(1, crv_readable);
    write(1, " Hebrew verses readable, ");
    write_int(1, crv_nearly);
    print(" nearly");
    show_known(vi_of("PSA", 23, 1));
    expect {|
        102 readable, 351 with one word to learn; sections 0 0 0 102 100
        Οὕτως+ γὰρ+ ἠγάπησεν+ ὁ+ Θεὸς+ τὸν+ κόσμον+ ὥστε? τὸν+ Υἱὸν+ τὸν+ μονογενῆ? ἔδωκεν+ ἵνα+ πᾶς+ ὁ+ πιστεύων+ εἰς+ αὐτὸν+ μὴ+ ἀπόληται? ἀλλ’+ ἔχῃ+ ζωὴν+ αἰώνιον?
        Matthew 2:5
        Matthew 1:25 needs ἔτεκεν
        3176 Hebrew verses readable, 3797 nearly
        מִזְמוֹר? לְדָוִד+ יְהוָה+ רֹעִי+ לֹא+ אֶחְסָֽר?
    |}
}

test "a card's verse" {
    fresh();
    k: int = learn_add_word(0, 3588, FROM_FREQ, D0, T0);
    // Philippians 4:6–7 in Memory; Romans 8:28 highlighted; John 3 read
    // lately.
    _p: int = memory_add(0, ch("PHP", 4), 6, ch("PHP", 4), 7, T0);
    hl_n = 1;
    hl_key[0] = verse_key(ch("ROM", 8), 28);
    hl_color[0] = 0;
    hs_n = 1;
    hs_ch[0] = ch("JHN", 3);
    hs_time[0] = T0 - 86400;
    fbuf_n = 0;
    for seen in 0..6 {
        cd_seen[k] = seen;
        if (learn_context(k, T0)) {
            fput_ref(v_chapter(ctx_vi), v_num(ctx_vi), 0);
            fput_str(" ")
        }
    }
    fput_int(ctx_n);
    fput_str(" candidates\n");
    // Wrapped: the last, then the first again.
    cd_seen[k] = ctx_n - 1;
    _a: bool = learn_context(k, T0);
    fput_ref(v_chapter(ctx_vi), v_num(ctx_vi), 0);
    cd_seen[k] = ctx_n;
    _b: bool = learn_context(k, T0);
    fput_str(", ");
    fput_ref(v_chapter(ctx_vi), v_num(ctx_vi), 0);
    fput(10);
    // A letter's: its example's.
    a: int = learn_add_letter(lt_find(0, "alpha"), FROM_ALPHABET, D0, T0);
    _c: bool = learn_context(a, T0);
    form_of(ctx_w);
    fput_ref(v_chapter(ctx_vi), v_num(ctx_vi), 0);
    fput(32);
    fput_bytes(lforms, wf_b, wf_e);
    // Its window: the words around it.
    learn_window(ctx_vi, ctx_w);
    fput_str(", window ");
    fput_int(ow_from);
    fput(45);
    fput_int(ow_to);
    fput(10);
    show_fbuf();
    expect {|
        Philippians 4:6 Philippians 4:7 Romans 8:28 John 3:1 John 3:3 John 3:5 5345 candidates
        Revelation 22:21, Philippians 4:6
        1 John 4:8 ἀγάπη, window 0-12
    |}
}

test "cards on the schedule" {
