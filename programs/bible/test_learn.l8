tag bible_learn_tests;

use_tag std, bible;

// Learning Greek and Hebrew (learn.l8, DESIGN.md §14.1, §14.9.1): vocab.bin,
// what is known, coverage, a passage's words, the verses you can read, a
// card's verse, cards on the schedule, Today and the reminder with cards,
// cards.tsv read back, a lemma's forms, and Greek for the voice. Every day
// is fixed: D0 is 2026-10-19.
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "plans.l8";

import "lang.l8";

import "memory.l8";

import "ribbons.l8";

import "learn.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

file_n: int = 0;

scratch: []i8 = new i8[8388608](0i8);

read_whole(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    got: int = 0;
    more: bool = fd >= 0;
    while (more && got < len(scratch)) {
        r: int = read(fd, scratch, got, len(scratch) - got);
        if (r <= 0) more = false else got = got + r
    }
    if (fd >= 0) close(fd);
    b: []i8 = new i8[got + 1](0i8);
    for i in 0..got b[i] = scratch[i];
    file_n = got;
    b
}

loaded: bool = false;

load() noregion {
    if (loaded) return;
    loaded = true;
    bsb = read_whole("programs/bible/data/bsb.txt");
    bible_index(file_n);
    text_load(TEXT_BSB, bsb, file_n);
    text_use(TEXT_BSB);
    lw = read_whole("programs/bible/data/lang/words.bin");
    lw_n = file_n / 12;
    lv = read_whole("programs/bible/data/lang/verses.bin");
    lv_n = file_n / 8 - 1;
    lsup = read_whole("programs/bible/data/lang/supplied.bin");
    lsup_n = file_n / 8;
    lforms = read_whole("programs/bible/data/lang/forms.txt");
    lforms_len = file_n;
    lmorph = read_whole("programs/bible/data/lang/morph.txt");
    lmorph_len = file_n;
    lconc = read_whole("programs/bible/data/lang/conc.bin");
    lconc_len = file_n;
    llex = read_whole("programs/bible/data/lang/lexicon.txt");
    llex_len = file_n;
    lgram = read_whole("programs/bible/data/lang/grammar.txt");
    lgram_len = file_n;
    lsen = read_whole("programs/bible/data/lang/senses.bin");
    lsen_n = file_n;
    lrel = read_whole("programs/bible/data/lang/related.bin");
    lrel_n = file_n;
    lang_index();
    lvoc = read_whole("programs/bible/data/lang/vocab.bin");
    lvoc_n = file_n;
    llet = read_whole("programs/bible/data/lang/letters.txt");
    llet_n = file_n;
    learn_index()
}

D0: int = 20745;

T0: int = 1792396800;

// Nothing kept: no cards, passages, marks, history or ribbons.
fresh() noregion {
    load();
    cd_n = 0;
    memory_clear();
    hl_n = 0;
    bm_n = 0;
    nt_n = 0;
    hs_n = 0;
    rb_n = 0;
    mev_n = 0;
    cdl_n = 0;
    learn_refresh()
}

ch(code: str, n: int): int {
    book_first[book_coded(code)] + n - 1
}

vi_of(code: str, c: int, v: int): int {
    lang_verse(ch(code, c), v)
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

// A word card known (Mark as Known).
know(lang: int, num: int) {
    k: int = card_of_word(lang, num);
    if (k < 0) k = learn_add_word(lang, num, FROM_KNOWN, D0, T0);
    learn_mark_known(k, D0, T0)
}

// Every letter (and, with joined, the joined words) of a language known.
know_letters(lang: int, joined: bool) {
    for i in 0..lt_n {
        if (lt_lang[i] == lang && (lt_kind[i] == CK_LETTER || joined)) {
            k: int = if (cl_of[i] >= 0) cl_of[i] else learn_add_letter(i, FROM_KNOWN,
                D0, T0);
            learn_mark_known(k, D0, T0)
        }
    }
}

// The n most common words known.
know_top(lang: int, n: int) {
    for x in 0..n know(lang, vl_num(lang, x))
}

// Word w of a verse: its form, and whether it is known.
show_known(vi: int) raises IoError {
    fbuf_n = 0;
    for o in 0..v_end(vi) - v_first(vi) {
        w: int = word_at_order(vi, o);
        form_of(w);
        if (o > 0) fput(32);
        fput_bytes(lforms, wf_b, wf_e);
        fput(if (word_known(w)) 43 else 63)
    }
    fput(10);
    show_fbuf()
}

