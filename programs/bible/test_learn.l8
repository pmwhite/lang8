    write(1, "Daniel 2:4, 300 known (Aramaic always): ");
    show_glossed(ch("DAN", 2), 4, OG_UNLEARNED);
    og_setting = -1;
    expect "rare: G59 (30) yes, G417 (31) no, H3282 (99) yes, H1121 4932 no\nmode with no cards: 1\nJohn 3:16, rare: 1 of 25: μονογενῆ one and only\nmode with cards: 0\nJohn 3:16, not learned: 4 of 25: ὥστε that · μονογενῆ one and only · ἀπόληται shall not perish · αἰώνιον eternal\nJohn 1:1, not learned: 1 of 17: ἀρχῇ the beginning\nJohn 3:16, none: 0 of 25: \nGenesis 1:1, not learned, no Hebrew: 7 of 7: בְּרֵאשִׁית in the beginning · בָּרָא created · אֱלֹהִים God · אֵת [Obj.] · הַשָּׁמַיִם the heavens · וְאֵת and · הָאָֽרֶץ the earth\nGenesis 1:1, 300 known: 2 of 7: בְּרֵאשִׁית in the beginning · בָּרָא created\nPsalm 23:1, 300 known: 1 of 4: אֶחְסָֽר want\nDaniel 2:4, 300 known (Aramaic always): 9 of 12: אֲרָמִית in Aramaic · מַלְכָּא o king · לְעָלְמִין forever · חֱיִי may you live · אֱמַר tell · חֶלְמָא the dream · לְעַבְדָךְ your servants · וּפִשְׁרָא the interpretation · נְחַוֵּֽא and we will give\n"
}

// The verses query s finds in the original (its count, and the first
// three).
show_search(s: str) raises IoError {
    text_use(TEXT_ORIG);
    b: []i8 = new i8[64](0i8);
    for i in 0..len(s) b[i] = s[i];
    og_search(b, len(s), 0, 65);
    write(1, s);
    write(1, ": ");
    write_int(1, hit_count);
    for i in 0..if (hit_count < 3) hit_count else 3 {
        fbuf_n = 0;
        fput_ref(hit_chapter[i], hit_verse[i], 0);
        write(1, if (i == 0) " " else ", ");
        show_fbuf()
    }
    // (The first verse's words found.)
    if (hit_count > 0) {
        og_match_ranges(hit_chapter[0], hit_verse[0]);
        write(1, " [");
        for m in 0..mr_count {
            if (m > 0) write(1, " ");
            write_bytes_n(1, bytes_from(vt, mr_begin[m], mr_end[m]), mr_end[m] - mr_begin[m])
        }
        write(1, "]")
    }
    print("");
    text_use(TEXT_BSB)
}

bytes_from(b: []i8, p: int, e: int): []i8@new {
    out: []i8 = new i8[e - p + 1](0i8);
    for i in p..e out[i - p] = b[i];
    out
}

