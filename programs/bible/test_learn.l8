            cd_due[j] = D0
        }
        if (kind != 0) {
            i: int = mem_index(memory_add(1, ch("PSA", 23), 1, ch("PSA", 23), 6, T0));
            mq_state[i] = MS_REVIEW;
            mq_box[i] = 1;
            mq_due[i] = D0
        }
        if (fput_reminder_both(0, -1, memory_due_on(D0) > 0, D0)) {
            write_bytes_n(1, fbuf, fbuf_n);
            print("")
        }
    }
