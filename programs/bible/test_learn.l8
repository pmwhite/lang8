    fresh();
    for s in ["\�\�\�\�\�\�\�\�\�\�\�\�\�\�\�\�\�", "\�\�\�\�\�", "\�\�\�\�\� \�\�\�\�\�\�\�\�\�\� \�\�\�\�\� \�\�\� \�\�\�\�\�\�\�\�\�\�",
        "\�\�\�\�\�\�\�\�\�\� \�\�\�\�\�\�\�\�\�\�\�"] {
        fbuf_n = 0;
        fput_str(s);
