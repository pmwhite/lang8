    show_search("\�\�\�\�\�\�\�\�\�\�\�\�\�\�");
    show_search("\�\�\�\�\�\�\�\�\�\�");
    show_search("\�\�\�\�\�\�\�\�\�\�\�");
    show_search("theos");
    show_search("chesed");
    show_search("agap*");
    show_search("\"ho logos\"");
    // (Key letters: each word's first letter as written, a prefix's: וַיֹּאמֶר
    // ו; Greek's without its breathing; typed letters folded, ς as σ, ם as
    // מ.)
    text_use(TEXT_ORIG);
    memory_layout(0, 3, 0, 3, 1);
    write(1, "Genesis 1:3's keys: ");
    for w in 0..mw_n {
        fbuf_n = 0;
        fput_cp(mw_key[w]);
        show_fbuf()
    }
    print("");
    memory_layout(ch("JHN", 1), 1, ch("JHN", 1), 1, 1);
    write(1, "John 1:1's keys: ");
    for w in 0..mw_n {
        fbuf_n = 0;
        fput_cp(mw_key[w]);
        show_fbuf()
    }
    print("");
    write(1, "typed: \�\� for \�\� ");
    write(1, if (memory_key_is(0, 962) == memory_key_is(0, 963)) "same" else "apart");
    write(1, ", \�\�\� for \�\� ");
    write(1, if (mem_fold(7960) == 949) "same" else "apart");
    write(1, ", \�\� for \�\� ");
    write(1, if (mem_fold(1501) == 1502) "same" else "apart");
    write(1, ", \�\� for \�\� ");
    print(if (mem_fold(940) == 945) "same" else "apart");
    text_use(TEXT_BSB);
    expect {|
        agape: 56 Matthew 24:12, John 15:9, John 15:10 [ἀγάπη]
        shalom: 103 Genesis 29:6, Genesis 43:23, Genesis 43:28 [שָׁלוֹם]
        שלום: 120 Genesis 29:6, Genesis 37:14, Genesis 41:16 [שָׁלוֹם]
        שָׁלוֹם: 120 Genesis 29:6, Genesis 37:14, Genesis 41:16 [שָׁלוֹם]
        αγαπη: 56 Matthew 24:12, John 15:9, John 15:10 [ἀγάπη]
        ἀγάπη: 56 Matthew 24:12, John 15:9, John 15:10 [ἀγάπη]
        theos: 287 Matthew 1:23, Matthew 3:9, Matthew 6:30 [θεός]
        chesed: 65 Genesis 24:12, Genesis 24:14, Genesis 24:49 [חֶסֶד]
        agap*: 243 Ezekiel 12:14, Ezekiel 17:21, Ezekiel 38:6 [אֲגַפָּיו]
        "ho logos": 58 Matthew 5:37, Matthew 28:15, Mark 4:15 [ὁ λόγος]
        Genesis 1:3's keys: ואיאוא
        John 1:1's keys: εαηολκοληπτθκθηολ
        typed: ς for σ same, Ἐ for ε same, ם for מ same, ά for α same
    |}
}

// A code point onto fbuf (UTF-8).
fput_cp(cp: int) {
    if (cp < 128) fput(cp) else if (cp < 2048) {
        fput(192 + cp / 64);
        fput(128 + cp % 64)
    } else {
        fput(224 + cp / 4096);
        fput(128 + cp / 64 % 64);
        fput(128 + cp % 64)
    }
}
