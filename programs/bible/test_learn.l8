}

test "what is known" {
    fresh();
    // John 3:16: γάρ known; the rest not.
    know(0, 1063);
    show_known(vi_of("JHN", 3, 16));
    // A name: Ἰησοῦς in John 1:17, before and after the alphabet.
    vi: int = vi_of("JHN", 1, 17);
    show_known(vi);
    know_letters(0, false);
    show_known(vi);
    // Genesis 1:1's וְאֵת: H853 and "and" both wanted.
    g: int = vi_of("GEN", 1, 1);
    know(1, 853);
    show_known(g);
    know_letters(1, false);
    learn_mark_known(learn_add_letter(jp_lt[0], FROM_ALPHABET, D0, T0), D0, T0);
    show_known(g);
    // לוֹ (no number) in Genesis 2:19 wants "to" and "his".
    v2: int = vi_of("GEN", 2, 19);
    for w in v_first(v2)..v_end(v2) {
        if (w_strongs(w) == 0) {
            form_of(w);
            fbuf_n = 0;
            fput_bytes(lforms, wf_b, wf_e);
            fput_str(if (word_known(w)) " known" else " not known");
            learn_mark_known(learn_add_letter(jp_lt[3], FROM_ALPHABET, D0, T0), D0,
                T0);
            fput_str(if (word_known(w)) ", known" else ", not known");
            learn_mark_known(learn_add_letter(jp_lt[9], FROM_ALPHABET, D0, T0), D0,
                T0);
            fput_str(if (word_known(w)) ", known\n" else ", not known\n");
            show_fbuf()
        }
    }
    // Daniel 2:4's Aramaic: never known, every word's card known.
    d: int = vi_of("DAN", 2, 4);
    for w in v_first(d)..v_end(d)
        if (w_strongs(w) > 0 && learnable(1, w_strongs(w))) know(1, w_strongs(w));
    know_letters(1, true);
    show_known(d);
    expect {|
        Οὕτως? γὰρ+ ἠγάπησεν? ὁ? Θεὸς? τὸν? κόσμον? ὥστε? τὸν? Υἱὸν? τὸν? μονογενῆ? ἔδωκεν? ἵνα? πᾶς? ὁ? πιστεύων? εἰς? αὐτὸν? μὴ? ἀπόληται? ἀλλ’? ἔχῃ? ζωὴν? αἰώνιον?
        ὅτι? ὁ? νόμος? διὰ? Μωϋσέως? ἐδόθη? ἡ? χάρις? καὶ? ἡ? ἀλήθεια? διὰ? Ἰησοῦ? Χριστοῦ? ἐγένετο?
        ὅτι? ὁ? νόμος? διὰ? Μωϋσέως+ ἐδόθη? ἡ? χάρις? καὶ? ἡ? ἀλήθεια? διὰ? Ἰησοῦ+ Χριστοῦ+ ἐγένετο?
        בְּרֵאשִׁית? בָּרָא? אֱלֹהִים? אֵת+ הַשָּׁמַיִם? וְאֵת? הָאָֽרֶץ?
        בְּרֵאשִׁית? בָּרָא? אֱלֹהִים? אֵת+ הַשָּׁמַיִם? וְאֵת+ הָאָֽרֶץ?
        לוֹ not known, not known, known
        לוֹ known, known, known
        וַֽיְדַבְּרוּ+ הַכַּשְׂדִּים+ לַמֶּלֶךְ+ אֲרָמִית+ מַלְכָּא? לְעָלְמִין? חֱיִי? אֱמַר? חֶלְמָא? לְעַבְדַּיִךְ? וּפִשְׁרָא? נְחַוֵּֽא?
    |}
}

test "coverage" {
    fresh();
    // A fixture set: the 10 most common Greek words, then John 3's words.
    know_top(0, 10);
    fbuf_n = 0;
    fput_int(learn_coverage(0));
    fput_str("% of the New Testament; of John 3: ");
    one: []int = new int[1](0);
    one[0] = ch("JHN", 3);
    fput_int(learn_coverage_of(0, one, 1));
    fput_str("%; ");
    know_letters(0, false);
    fput_int(learn_coverage_of(0, one, 1));
    fput_str("% with the alphabet\n");
    // History: John 3 and Romans 8 lately, Genesis 1 long ago.
    hs_n = 3;
    hs_ch[0] = ch("GEN", 1);
    hs_time[0] = T0 - 40 * 86400;
    hs_ch[1] = ch("JHN", 3);
    hs_time[1] = T0 - 3 * 86400;
    hs_ch[2] = ch("ROM", 8);
    hs_time[2] = T0 - 86400;
    _r: bool = fput_language_recent(0, T0);
    fput(10);
    fput_language_row(0);
    fput(10);
    fput_language_row(1);
    fput(10);
    show_fbuf();
    expect {|
        37% of the New Testament; of John 3: 37%; 40% with the alphabet
        In the chapters you’ve read this month, you know 38% of the words.
        10 words · 37% of the New Testament
        The language of the Old Testament
    |}
}

