    for g in [G_NOTYET, G_MOSTLY, G_KNEW] {
        fput_card_would(k, g, D0 + 15);
        fput(10)
    }
    show_fbuf();
    write_bytes_n(1, mev, mev_n);
    write_bytes_n(1, cdl, cdl_n);
    expect "New, shown: To review, Knew It: Known · next review Thursday (known)\nNot Yet: box 1 (not known)\nG3588 box 4 due in 11 days\nG2532 box 4 due in 11 days\nG846 box 4 due in 9 days\nG4771 box 4 due in 12 days\nG1161 box 4 due in 14 days\nAgain tomorrow\nNext review Wednesday\nNext review Friday\nlearn added G25 from study\nlearn card G25 knew box 1→2 due 2026-10-22 context JHN 3:16 (seen 1)\nlearn card G25 notyet box 2→1 due 2026-11-03 (seen 1)\nlearn added G3588 from freq\nlearn known G3588 box 4 due 2026-10-30\nlearn added G2532 from freq\nlearn known G2532 box 4 due 2026-10-30\nlearn added G846 from freq\nlearn known G846 box 4 due 2026-10-28\nlearn added G4771 from freq\nlearn known G4771 box 4 due 2026-10-31\nlearn added G1161 from freq\nlearn known G1161 box 4 due 2026-11-02\nG25\t1792396800\tadded\t0\t0\tstudy\nG25\t1792396800\tknew\t1\t2\t-\nG25\t1792396800\tnotyet\t2\t1\t-\nG3588\t1792396800\tadded\t0\t0\tfreq\nG3588\t1792396800\tknown\t0\t4\tknown\nG2532\t1792396800\tadded\t0\t0\tfreq\nG2532\t1792396800\tknown\t0\t4\tknown\nG846\t1792396800\tadded\t0\t0\tfreq\nG846\t1792396800\tknown\t0\t4\tknown\nG4771\t1792396800\tadded\t0\t0\tfreq\nG4771\t1792396800\tknown\t0\t4\tknown\nG1161\t1792396800\tadded\t0\t0\tfreq\nG1161\t1792396800\tknown\t0\t4\tknown\n"
}

test "Today and the reminder with cards" {
    fresh();
    plans_make();
    // Cards: a Greek letter new, two Greek words (one new, one overdue),
    // a Hebrew word due, one later.
    w1: int = learn_add_word(0, 25, FROM_FREQ, D0, T0);
    w2: int = learn_add_word(0, 3588, FROM_FREQ, D0, T0);
    cd_state[w2] = MS_REVIEW;
    cd_box[w2] = 2;
    cd_due[w2] = D0 - 2;
    l1: int = learn_add_letter(lt_find(0, "alpha"), FROM_ALPHABET, D0, T0 + 5);
    h1: int = learn_add_word(1, 559, FROM_FREQ, D0, T0);
    cd_state[h1] = MS_REVIEW;
    cd_box[h1] = 3;
    cd_due[h1] = D0;
    h2: int = learn_add_word(1, 1961, FROM_FREQ, D0, T0);
    cd_state[h2] = MS_REVIEW;
    cd_box[h2] = 3;
    cd_due[h2] = D0 + 5;
    _x: int = w1 + l1;
    cd_today(D0);
    fbuf_n = 0;
    for x in 0..ct_n {
        fput_card_key(ct[x]);
        fput(32)
    }
    fput_str("(");
    fput_int(ct_greek);
    fput_str(" Greek, ");
    fput_int(ct_hebrew);
    fput_str(" Hebrew); Greek ");
    fput_cards_due(0, D0);
    fput_str("; Hebrew ");
    fput_cards_due(1, D0);
    fput(10);
    for d in [D0 - 3, D0, D0 + 5] {
        fput_int(memory_due_on(d));
        fput(32)
    }
    fput(10);
    show_fbuf();
    // The reminder: words only, passages only, and both.
    for kind in 0..3 {
        fresh();
        if (kind != 1) {
            for num in [25, 3588] {
                j: int = learn_add_word(0, num, FROM_FREQ, D0, T0);
                cd_state[j] = MS_REVIEW;
                cd_box[j] = 1;
                cd_due[j] = D0
            }
        }
        if (kind == 2) {
            j: int = learn_add_word(1, 559, FROM_FREQ, D0, T0);
            cd_due[j] = D0
        }
        if (kind != 0) {
            i: int = mem_index(memory_add(1, ch("PSA", 23), 1, ch("PSA", 23), 6, T0));
            mq_state[i] = MS_REVIEW;
            mq_box[i] = 1;
            mq_due[i] = D0
        }
        if (fput_reminder_both(0, -1, memory_due_on(D0) > 0, D0)) {
            write_bytes_n(1, fbuf, fbuf_n);
            print("")
        }
    }
    mev_n = 0;
    expect "G:alpha G25 G3588 H559 (3 Greek, 1 Hebrew); Greek 2 new · 1 to review; Hebrew 1 to review\n0 4 5 \nMemoryTo review: 2 Greek words\nMemoryTo review: Psalm 23\nMemoryTo review: Psalm 23, 2 Greek words and 1 Hebrew word\n"
}

feed(s: str) {
    fbuf_n = 0;
    fput_str(s)
}

test "cards.tsv read back" {
    fresh();
    k: int = learn_add_word(0, 25, FROM_FREQ, D0, T0);
    learn_shown(k, D0);
    _g: bool = learn_grade(k, G_KNEW, D0, T0, -1);
    _a: int = learn_add_letter(lt_find(0, "alpha"), FROM_ALPHABET, D0, T0);
    _j: int = learn_add_letter(jp_lt[0], FROM_ALPHABET, D0, T0);
    format_cards();
    show_fbuf();
    parse_cards(D0);
    format_cards();
    show_fbuf();
    // Malformed, unknown kinds and keys, a name, duplicates.
    feed("""
CARD	G	word	G25	review	2	2026-10-22	1792396800	1
CARD	G	word	G25	new	0	-	5	0
CARD	G	verb	G26	new	0	-	5	0
CARD	G	word	G2424	new	0	-	5	0
CARD	G	word	G26	review	0	2026-10-22	5	0
CARD	H	joined	H:w	new	0	-	5	0
CARD	H	letter	H:zz	new	0	-	5	0
CARD	G	word	G26	new	0	-	5

NOT	a card
""");
    parse_cards(D0);
    write_int(1, lines_read);
    write(1, " read, ");
    write_int(1, lines_skipped);
    print(" skipped");
    format_cards();
    show_fbuf();
    mev_n = 0;
    expect "CARD\tG\tword\tG25\treview\t2\t2026-10-22\t1792396800\t1\nCARD\tG\tletter\tG:alpha\tnew\t0\t2026-10-19\t1792396800\t0\nCARD\tH\tjoined\tH:w\tnew\t0\t2026-10-19\t1792396800\t0\nCARD\tG\tword\tG25\treview\t2\t2026-10-22\t1792396800\t1\nCARD\tG\tletter\tG:alpha\tnew\t0\t2026-10-19\t1792396800\t0\nCARD\tH\tjoined\tH:w\tnew\t0\t2026-10-19\t1792396800\t0\n9 read, 7 skipped\nCARD\tG\tword\tG25\treview\t2\t2026-10-22\t1792396800\t1\nCARD\tH\tjoined\tH:w\tnew\t0\t2026-10-19\t5\t0\n"
}

// Section s's title is t.
title_is(s: int, t: str): bool {
    if (fs_title_e[s] - fs_title_b[s] != len(t)) return false;
    for i in 0..len(t)
        if (fs_pool[fs_title_b[s] + i] != t[i]) return false;
    true
}

test "a lemma's forms" {
    fresh();
    for which in 0..2 {
        if (which == 0) forms_of(true, 25) else forms_of(false, 559);
        forms_layout();
        fbuf_n = 0;
        fput_int(fo_total);
        fput_str(" times, ");
        fput_int(fo_n);
        fput_str(" parsings:");
        for s in 0..fs_n {
            fput_str(if (s > 0) ", " else " ");
            fput_bytes(fs_pool, fs_title_b[s], fs_title_e[s]);
            if (!fs_grid[s]) fput_str(" (list)")
        }
        fput(10);
        for s in 0..fs_n {
            if (title_is(s, if (which == 0) "Aorist Active Indicative" else "Qal Consecutive Imperfect") || title_is(s,
                "Participles") || title_is(s, "Absolute")) {
                fput_bytes(fs_pool, fs_title_b[s], fs_title_e[s]);
                fput(58);
                for k in 0..fs_rows[s] {
                    r: int = fs_row_at(s, k);
                    if (k < 4) {
                        fput_str(" [");
                        fput_bytes(fs_pool, fr_label_b[r], fr_label_e[r]);
                        for c in [fr_cell0[r], fr_cell1[r]] {
                            if (c >= 0 || fs_grid[s]) fput(32);
                            if (c >= 0) {
                                at: int = form_at[fo_form[c]];
                                e: int = at;
                                while (lforms[e] as int != 9) e = e + 1;
                                fput_bytes(lforms, at, e);
                                fput(120);
                                fput_int(fo_count[c])
                            } else if (fs_grid[s]) fput_str("\�\�\�")
                        }
                        fput(93)
                    }
                }
                fput(10)
            }
        }
        show_fbuf()
    }
    expect {|
        143 times, 39 parsings: Present Active Indicative, Present Active Subjunctive, Present Active Imperative, Present Middle or Passive Indicative, Imperfect Active Indicative, Future Active Indicative, Future Passive Indicative, Aorist Active Indicative, Aorist Active Subjunctive, Aorist Active Imperative, Perfect Active Indicative, Infinitives (list), Participles (list)
        Aorist Active Indicative: [1st person ἠγάπησαx5 —] [2nd person ἠγάπησαςx5 —] [3rd person ἠγάπησενx12 ἠγάπησανx3]
        Participles: [ ἀγαπῶνx14] [ ἀγαπῶσινx4] [ ἀγαπῶνταςx3] [ ἀγαπώντωνx1]
        5308 times, 65 parsings: Qal Perfect, Qal Imperfect, Qal Consecutive Imperfect, Qal Conjunctive Perfect, Qal Imperative, Nifal Perfect, Nifal Imperfect, Nifal Consecutive Imperfect, Hifil Perfect, Hitpael Imperfect, Qal Infinitive Construct (list), Qal Participle (list)
        Qal Consecutive Imperfect: [3rd masculine וַיֹּאמֶרx2071 וַיֹּאמְרוּx299] [3rd feminine וַתֹּאמֶרx193 וַתֹּאמַרְנָהx8] [2nd masculine וַתֹּאמֶרx11 וַתֹּאמְרוּx8] [2nd feminine וַתֹּאמְרִיx5 —]
    |}
}

