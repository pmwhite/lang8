// A word card's answer (§14.10b.2) for number num in a verse: the BSB's
// words there, the sense, the faint line, and related words known.
show_answer(
    code: str,
    c: int,
    v: int,
    greek: bool,
    num: int
) raises IoError {
    vi: int = vi_of(code, c, v);
    w: int = -1;
    for x in v_first(vi)..v_end(vi)
        if (w < 0 && w_strongs(x) == num && w_greek(x) == greek && w_ntok(x) > 0) w = x;
    lang: int = if (greek) 0 else 1;
    fbuf_n = 0;
    fput_str(code);
    fput(32);
    fput_int(c);
    fput(58);
    fput_int(v);
    fput_str(": ");
    if (!fput_words_here(vi, w)) fput_str("(none)");
    fput_str(" | ");
    if (!fput_sense_here(vi, w)) fput_str("-");
    fput_str(" | ");
    fput_card_meta(lang, num);
    fput_str(" | ");
    if (!fput_related_known(lang, num)) fput_str("-");
    fput(10);
    show_fbuf()
}

