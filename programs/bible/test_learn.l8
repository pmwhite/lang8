    write(1, "mode with no cards: ");
    write_int(1, og_mode(0));
    print("");
    write(1, "John 3:16, rare: ");
    show_glossed(ch("JHN", 3), 16, OG_RARE);
    // (Words I Haven't Learned with a set known: the 120 most common, and
    // ἀγαπάω.)
    know_top(0, 120);
    know(0, 25);
    og_setting = -1;
    write(1, "mode with cards: ");
