test "verses you can read" {
    fresh();
    know_top(0, 120);
    know_letters(0, false);
    learn_readable(0, T0);
    fbuf_n = 0;
    fput_int(rv_readable);
    fput_str(" readable, ");
    fput_int(rv_nearly);
    fput_str(" with one word to learn; sections");
    for s in 0..5 {
        fput(32);
        fput_int(rv_count[s])
    }
    fput(10);
    show_fbuf();
    jn: int = vi_of("JHN", 3, 16);
    show_known(jn);
    for x in 0..rv_n
        if (rv_vi[x] == jn) print("John 3:16 is readable");
    // The first elsewhere, and the first with one word to learn.
    shown: int = 0;
    for x in 0..rv_n {
        if (shown < 2 && (rv_sec[x] == 3 && shown == 0 || rv_sec[x] == 4 && shown == 1)) {
            fbuf_n = 0;
            fput_ref(v_chapter(rv_vi[x]), v_num(rv_vi[x]), 0);
            if (rv_word[x] >= 0) {
                form_of(rv_word[x]);
                fput_str(" needs ");
                fput_bytes(lforms, wf_b, wf_e)
            }
            fput(10);
            show_fbuf();
            shown = shown + 1
        }
    }
    // Hebrew, at 300 with the alphabet and the joined words.
    know_top(1, 300);
    know_letters(1, true);
    learn_readable(1, T0);
    write_int(1, rv_readable);
    write(1, " Hebrew verses readable, ");
    write_int(1, rv_nearly);
    print(" nearly");
    show_known(vi_of("PSA", 23, 1));
    expect {|
        102 readable, 351 with one word to learn; sections 0 0 0 102 100
        Οὕτως+ γὰρ+ ἠγάπησεν+ ὁ+ Θεὸς+ τὸν+ κόσμον+ ὥστε? τὸν+ Υἱὸν+ τὸν+ μονογενῆ? ἔδωκεν+ ἵνα+ πᾶς+ ὁ+ πιστεύων+ εἰς+ αὐτὸν+ μὴ+ ἀπόληται? ἀλλ’+ ἔχῃ+ ζωὴν+ αἰώνιον?
        Matthew 2:5
        Matthew 1:25 needs ἔτεκεν
        3176 Hebrew verses readable, 3797 nearly
        מִזְמוֹר? לְדָוִד+ יְהוָה+ רֹעִי+ לֹא+ אֶחְסָֽר?
    |}
}

test "a card's verse" {
    fresh();
    k: int = learn_add_word(0, 3588, FROM_FREQ, D0, T0);
    // Philippians 4:6–7 in Memory; Romans 8:28 highlighted; John 3 read
    // lately.
    _p: int = memory_add(0, ch("PHP", 4), 6, ch("PHP", 4), 7, T0);
    hl_n = 1;
    hl_key[0] = verse_key(ch("ROM", 8), 28);
    hl_color[0] = 0;
    hs_n = 1;
    hs_ch[0] = ch("JHN", 3);
    hs_time[0] = T0 - 86400;
    fbuf_n = 0;
    for seen in 0..6 {
        cd_seen[k] = seen;
        if (learn_context(k, T0)) {
            fput_ref(v_chapter(ctx_vi), v_num(ctx_vi), 0);
            fput_str(" ")
        }
    }
    fput_int(ctx_n);
    fput_str(" candidates\n");
    // Wrapped: the last, then the first again.
    cd_seen[k] = ctx_n - 1;
    _a: bool = learn_context(k, T0);
    fput_ref(v_chapter(ctx_vi), v_num(ctx_vi), 0);
    cd_seen[k] = ctx_n;
    _b: bool = learn_context(k, T0);
    fput_str(", ");
    fput_ref(v_chapter(ctx_vi), v_num(ctx_vi), 0);
    fput(10);
    // A letter's: its example's.
    a: int = learn_add_letter(lt_find(0, "alpha"), FROM_ALPHABET, D0, T0);
    _c: bool = learn_context(a, T0);
    form_of(ctx_w);
    fput_ref(v_chapter(ctx_vi), v_num(ctx_vi), 0);
    fput(32);
    fput_bytes(lforms, wf_b, wf_e);
    // Its window: the words around it.
    learn_window(ctx_vi, ctx_w);
    fput_str(", window ");
    fput_int(ow_from);
    fput(45);
    fput_int(ow_to);
    fput(10);
    show_fbuf();
    expect {|
        Philippians 4:6 Philippians 4:7 Romans 8:28 John 3:1 John 3:3 John 3:5 5345 candidates
        Revelation 22:21, Philippians 4:6
        1 John 4:8 ἀγάπη, window 0-12
    |}
}

test "cards on the schedule" {
    fresh();
    k: int = learn_add_word(0, 25, FROM_STUDY, D0, T0);
    fbuf_n = 0;
    fput_card_state(k, D0);
    learn_shown(k, D0);
    fput_str(", shown: ");
    fput_card_state(k, D0);
    _g: bool = learn_grade(k, G_KNEW, D0, T0, vi_of("JHN", 3, 16));
    fput_str(", Knew It: ");
    fput_card_state(k, D0);
    fput_str(if (word_card_known(0, 25)) " (known)" else " (not known)");
    // Two weeks on, Not Yet from box 2: box 1, not known.
    _n: bool = learn_grade(k, G_NOTYET, D0 + 14, T0, -1);
    fput_str("""

Not Yet: box """);
    fput_int(cd_box[k]);
    fput_str(if (word_card_known(0, 25)) " (known)" else " (not known)");
    // Mark as Known: box 4, due in 7 to 14 days.
    for num in [3588, 2532, 846, 4771, 1161] {
        j: int = learn_add_word(0, num, FROM_FREQ, D0, T0);
        learn_mark_known(j, D0, T0);
        fput_str("""

G""");
        fput_int(num);
        fput_str(" box ");
        fput_int(cd_box[j]);
        fput_str(" due in ");
        fput_int(cd_due[j] - D0);
        fput_str(" days")
    }
