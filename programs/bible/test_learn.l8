// ---- the Hebrew and Greek's glosses (DESIGN.md §14.11.4, §14.11.9) ----
orig_loaded: bool = false;

orig_load() noregion {
    load();
    if (orig_loaded) return;
    orig_loaded = true;
    og = read_whole("programs/bible/data/lang/orig-words.bin");
    og_n = file_n / 12;
    t: []i8 = read_whole("programs/bible/data/orig.txt");
    text_load(TEXT_ORIG, t, file_n);
    text_use(TEXT_BSB)
}

// The words of verse v of chapter c glossed in a mode (made as the reader
// makes them), each "form gloss".
show_glossed(c: int, v: int, mode: int) raises IoError {
    og_setting = mode;
    orig_forget();
    text_use(TEXT_ORIG);
    orig_prepare(c);
    og_verse(c, v);
    n: int = 0;
    fbuf_n = 0;
    for w in og_vb..og_ve {
        if (og_glossed(w)) {
            if (n > 0) fput_str(" \�\� ");
            fput_og_form(w);
            fput(32);
            j: int = w - og_gl_first;
            for q in og_gt_b[j]..og_gt_e[j] fput(og_gt[q] as int);
            n = n + 1
        }
    }
    text_use(TEXT_BSB);
    write_int(1, n);
    write(1, " of ");
    write_int(1, og_ve - og_vb);
    write(1, ": ");
    show_fbuf();
    print("")
}

