}

// A card's box and due day, and what comes back.
show_ret(label: str, k: int, next: int) {
    fbuf_n = 0;
    fput_str(label);
    fput_str(": box ");
    fput_int(cd_box[k]);
    fput_str(", due in ");
    fput_int(cd_due[k] - D0);
    fput_str(if (next == RET_RETRY) ", back once more at the end\n" else ", not back\n");
    try {
        write_bytes_n(1, fbuf, fbuf_n)
    } with IoError _e -> { }
}

test "a session's returns (review r10-1 Minor 1)" {
    fresh();
    // A new card, shown with its answer, then back for its first
    // judgement: Not Yet is graded, and it comes back at the end; that
    // retry's Not Yet changes nothing.
    k: int = learn_add_word(0, 25, FROM_FREQ, D0, T0);
    learn_shown(k, D0);
    show_ret("new, Not Yet", k, learn_judged(k, G_NOTYET, RET_NEW, D0, T0, -1));
    show_ret("its retry, Not Yet", k, learn_judged(k, G_NOTYET, RET_RETRY, D0, T0,
        -1));
    // A card in review (box 4, due): Not Yet two boxes down, and back; the
    // retry's Knew It changes nothing.
    j: int = learn_add_word(0, 26, FROM_FREQ, D0, T0);
    cd_state[j] = MS_REVIEW;
    cd_box[j] = 4;
    cd_due[j] = D0;
    show_ret("review, Not Yet", j, learn_judged(j, G_NOTYET, RET_FIRST, D0, T0, -1));
    show_ret("its retry, Knew It", j, learn_judged(j, G_KNEW, RET_RETRY, D0, T0, -1));
    // A new card's return answered Knew It: box 2, not back.
    m: int = learn_add_word(0, 3588, FROM_FREQ, D0, T0);
    learn_shown(m, D0);
    show_ret("new, Knew It", m, learn_judged(m, G_KNEW, RET_NEW, D0, T0, -1));
    write_bytes_n(1, mev, mev_n);
    mev_n = 0;
    expect {|
        new, Not Yet: box 1, due in 1, back once more at the end
        its retry, Not Yet: box 1, due in 1, not back
        review, Not Yet: box 2, due in 1, back once more at the end
        its retry, Knew It: box 2, due in 1, not back
        new, Knew It: box 2, due in 3, not back
        learn added G25 from freq
        learn card G25 notyet box 1→1 due 2026-10-20 (seen 1)
        learn card G25 notyet again, nothing changed
        learn added G26 from freq
        learn card G26 notyet box 4→2 due 2026-10-20 (seen 0)
        learn card G26 knew again, nothing changed
        learn added G3588 from freq
        learn card G3588 knew box 1→2 due 2026-10-22 (seen 1)
    |}
}

