tag bible_ios;

use_tag std, ios, bible;

// Verses selected and what can be done with them: the tray that floats up
// (highlight in a color, copy, share, bookmark, note), the commands added to
// the text's own edit menu, and the toast that says a copy was made. Also
// jumps: the place jumped from kept, the capsule that goes back to it, and
// the verse jumped to flashed.
import "../ios/objc.l8";

import "text.l8";

extern NSLog(format: int): int;

// ---- the selection: verses of one chapter ----
sel_c: int = -1;

sel_n: int = 0;

sel_v: []int = new int[200](0);

is_selected(v: int): bool {
    for i in 0..sel_n
        if (sel_v[i] == v) return true;
    false
}

// Haptics: a tick for a selection, a light or medium tap, and success.
haptic_select() {
    g: int = make("UISelectionFeedbackGenerator");
    msg(g, sel("selectionChanged"));
    release(g)
}

haptic_impact(style: int) {
    g: int = msg1(msg(cls("UIImpactFeedbackGenerator"), sel("alloc")), sel("initWithStyle:"),
        style);
    msg(g, sel("impactOccurred"));
    release(g)
}

haptic_success() {
    g: int = make("UINotificationFeedbackGenerator");
    msg1(g, sel("notificationOccurred:"), 0);
    release(g)
}

// Verse v of chapter c selected, or not (a verse of another chapter starts
// the selection again).
toggle_verse(c: int, v: int) {
    if (c != sel_c && sel_n > 0) {
        old: int = sel_c;
        sel_n = 0;
        sel_c = -1;
        repaint(old)
    }
    sel_c = c;
    at: int = -1;
    for i in 0..sel_n
        if (sel_v[i] == v) at = i;
    if (at >= 0) {
        for i in at..sel_n - 1 sel_v[i] = sel_v[i + 1];
        sel_n = sel_n - 1
    } else if (sel_n < len(sel_v)) {
        i: int = sel_n;
        while (i > 0 && sel_v[i - 1] > v) {
            sel_v[i] = sel_v[i - 1];
            i = i - 1
        }
        sel_v[i] = v;
        sel_n = sel_n + 1
    }
    haptic_select();
    repaint(c);
    if (sel_n > 0) show_tray() else hide_tray()
}

clear_selection() {
    if (sel_n == 0) return;
    c: int = sel_c;
    sel_n = 0;
    sel_c = -1;
    repaint(c);
    hide_tray()
}

// ---- references and text, for the tray, copies and the library ----
// A reference into fbuf: the chapter's name, then its verses (16‚Äì18, or 16,
// 18), from the first n of vs.
put_ref(c: int, vs: []int, n: int) {
    title_of(c);
    for i in 0..out_n fput(out[i] as int);
    if (n == 0) return;
    fput(if (book_count[ch_book[c]] > 1) 58 else 32);
    i: int = 0;
    while (i < n) {
        j: int = i;
        while (j + 1 < n && vs[j + 1] == vs[j] + 1) j = j + 1;
        if (i > 0) fput_str(", ");
        fput_int(vs[i]);
        // (In the version's own numbers: the ESV's 3 John 1:14 is shown as
        // 14 and 15.)
        last: int = verse_shown_last(c, vs[j]);
        if (last > vs[i]) {
            fput_str("\‚\Ä\ì");
            fput_int(last)
        }
        i = j + 1
    }
}

ref_verses: []int = new int[200](0);

// Verses from to last (a range) of chapter c, as a reference in fbuf.
put_range_ref(c: int, from: int, last: int) {
    n: int = 0;
    v: int = from;
    while (v <= last && n < len(ref_verses)) {
        ref_verses[n] = v;
        n = n + 1;
        v = v + 1
    }
    put_ref(c, ref_verses, n)
}

// fbuf as an NSString.
fstring(): int {
    nsstring_of(fbuf, fbuf_n)
}

// The verses' words, quoted, and their reference: what a copy or a share
// is (‚Äú‚Ä¶‚Äù John 3:16 BSB, or KJV, or the version read).
put_quote(c: int, vs: []int, n: int) {
    fput_str("\‚\Ä\ú");
    for i in 0..n {
        if (i > 0) fput(32);
        if (lay_verse_lines && n > 1) {
            fput_int(vs[i]);
            fput(32)
        }
        verse_text(c, vs[i]);
        for x in 0..vt_n fput(vt[x] as int)
    }
    fput_str("\‚\Ä\ù\n");
    put_ref(c, vs, n);
    fput(32);
    fput_str(text_abbrs[text_cur])
}

// ---- the tray ----
tray: int = 0;

tray_shown: bool = false;

tray_label: int = 0;

tray_close: int = 0;

tray_swatches: []int = new int[6](0);

tray_actions: []int = new int[7](0);

tray_effect: int = 0;

tray_timer: int = 0;

action_titles: []str = ["Copy", "Share", "Bookmark", "Note", "Study", "Compare", "Memorize"];

action_symbols: []str = ["doc.on.doc", "square.and.arrow.up", "bookmark", "square.and.pencil",
    "character.book.closed", "books.vertical", "brain"];

stack(axis: int, spacing: f64): int {
    s: int = make("UIStackView");
    msg1(s, sel("setAxis:"), axis);
    msg_set_f(s, sel("setSpacing:"), spacing);
    msg1(s, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg(s, sel("autorelease"))
}

// An action's button: its symbol over its title.
action_config(title: str, name: str): int {
    action_config_c(title, name, 0)
}

// The same, its symbol in a color of its own (0: ink, as the title).
action_config_c(title: str, name: str, color: int): int {
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    keys[0] = k_font;
    values[0] = sans(tray_title_size, 0.23f64);
    keys[1] = k_color;
    values[1] = c_ink;
    t: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        nsstring(title), nsdictionary(keys, values, 2));
    msg1(config, sel("setAttributedTitle:"), t);
    release(t);
    msg1(config, sel("setImage:"), symbol(name, 19.0f64, 4, color));
    msg1(config, sel("setImagePlacement:"), 1);
    msg_set_f(config, sel("setImagePadding:"), 4.0f64);
    // (Seven across: no room at the sides, so that the title has the
    // button's width (the insets grow with the text size, and at the
    // largest sizes clipped "Bookmark"); one line, the size fitted to the
    // longest title, DESIGN.md ¬ß13.2.1.)
    msg_rect(config, sel("setContentInsets:"), 6.0f64, 0.0f64, 6.0f64, 0.0f64);
    msg1(config, sel("setTitleLineBreakMode:"), 4);
    msg1(config, sel("setBaseForegroundColor:"), c_ink);
    config
}

make_tray() {
    root: int = window;
    tray = make("UIView");
    msg1(tray, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    layer: int = msg(tray, sel("layer"));
    msg1(layer, sel("setShadowColor:"), msg(msg(cls("UIColor"), sel("blackColor")),
        sel("CGColor")));
    msg_set_f32(layer, sel("setShadowOpacity:"), 0.15f64 as f32);
    msg_set_f(layer, sel("setShadowRadius:"), 20.0f64);
    msg_ff(layer, sel("setShadowOffset:"), 0.0f64, 6.0f64);
    glass: int = cls("UIGlassEffect");
    effect: int = if (glass != 0) make("UIGlassEffect") else msg1(cls("UIBlurEffect"),
        sel("effectWithStyle:"), 10);
    tray_effect = msg1(msg(cls("UIVisualEffectView"), sel("alloc")), sel("initWithEffect:"),
        effect);
    msg1(tray_effect, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    el: int = msg(tray_effect, sel("layer"));
    msg_set_f(el, sel("setCornerRadius:"), 26.0f64);
    curve: int = objc_const("kCACornerCurveContinuous");
    if (curve != 0) msg1(el, sel("setCornerCurve:"), curve);
    msg1(tray_effect, sel("setClipsToBounds:"), 1);
    msg1(tray, sel("addSubview:"), tray_effect);
    release(tray_effect);
    for e in ["leadingAnchor", "trailingAnchor", "topAnchor", "bottomAnchor"] pin(tray_effect,
        tray, e);
    content: int = msg(tray_effect, sel("contentView"));
    column: int = stack(1, 12.0f64);
    msg1(content, sel("addSubview:"), column);
    pin_by(column, content, "leadingAnchor", 14.0f64);
    pin_by(column, content, "trailingAnchor", -14.0f64);
    pin_by(column, content, "topAnchor", 14.0f64);
    pin_by(column, content, "bottomAnchor", -14.0f64);
    // The reference, and the close button.
    header: int = stack(0, 8.0f64);
    msg1(header, sel("setAlignment:"), 3);
    tray_label = make("UILabel");
    msg1(tray_label, sel("setFont:"), sans(15.0f64, 0.3f64));
    msg1(header, sel("addArrangedSubview:"), tray_label);
    release(tray_label);
    tray_close = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    msg2(tray_close, sel("setImage:forState:"), symbol("xmark", 13.0f64, 6, 0), 0);
    msg1(tray_close, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("systemFillColor")));
    msg_set_f(msg(tray_close, sel("layer")), sel("setCornerRadius:"), 14.0f64);
    pin_size(tray_close, "widthAnchor", 28.0f64);
    pin_size(tray_close, "heightAnchor", 28.0f64);
    msg1(tray_close, sel("setAccessibilityLabel:"), nsstring("Close"));
    msg3(tray_close, sel("addTarget:action:forControlEvents:"), app_obj, sel("trayClose:"),
        64);
    msg1(header, sel("addArrangedSubview:"), tray_close);
    msg1(column, sel("addArrangedSubview:"), header);
    // The colors (and, if any verse is highlighted, none).
    colors: int = stack(0, 0.0f64);
    msg1(colors, sel("setDistribution:"), 3);
    msg1(colors, sel("setAlignment:"), 3);
    for i in 0..6 {
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        pin_size(b, "widthAnchor", 34.0f64);
        pin_size(b, "heightAnchor", 34.0f64);
        msg_set_f(msg(b, sel("layer")), sel("setCornerRadius:"), 17.0f64);
        msg1(b, sel("setTag:"), i);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("traySwatch:"),
            64);
        if (i < 5) {
            fbuf_n = 0;
            fput_str("Highlight ");
            fput_str(hl_titles[i]);
            msg1(b, sel("setAccessibilityLabel:"), fstring())
        } else msg1(b, sel("setAccessibilityLabel:"), nsstring("Remove Highlight"));
        msg1(colors, sel("addArrangedSubview:"), b);
        tray_swatches[i] = b
    }
    msg1(column, sel("addArrangedSubview:"), colors);
    // Copy, share, bookmark and note.
    actions: int = stack(0, 0.0f64);
    msg1(actions, sel("setDistribution:"), 1);
    for i in 0..len(action_titles) {
        b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
            action_config(action_titles[i], action_symbols[i]), 0);
        msg1(b, sel("setTag:"), i);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("trayAction:"),
            64);
        if (i == 5) msg1(b, sel("setAccessibilityLabel:"), nsstring("Compare Versions"));
        // (No action narrower than 44 points.)
        msg1(msg_set_f(msg(b, sel("widthAnchor")), sel("constraintGreaterThanOrEqualToConstant:"),
            44.0f64), sel("setActive:"), 1);
        msg1(actions, sel("addArrangedSubview:"), b);
        tray_actions[i] = b
    }
    msg1(column, sel("addArrangedSubview:"), actions);
    msg1(root, sel("addSubview:"), tray);
    pin_by(tray, root, "leadingAnchor", 12.0f64);
    pin_by(tray, root, "trailingAnchor", -12.0f64);
    // (Its bottom kept: it moves up over the mini player while listening.)
    tray_bottom = keep(msg1_f(msg(tray, sel("bottomAnchor")), sel("constraintEqualToAnchor:constant:"),
        msg(msg(root, sel("safeAreaLayoutGuide")), sel("bottomAnchor")), -8.0f64));
    msg1(tray_bottom, sel("setActive:"), 1);
    msg1(tray, sel("setHidden:"), 1)
}

tray_bottom: int = 0;

style_tray() {
    if (tray == 0) return;
    msg1(tray_label, sel("setTextColor:"), c_ink);
    msg1(tray_close, sel("setTintColor:"), c_ink);
    for i in 0..5 msg1(tray_swatches[i], sel("setBackgroundColor:"), c_swatch[i]);
    msg2(tray_swatches[5], sel("setImage:forState:"), symbol("circle.slash", 30.0f64,
        4, c_faint), 0);
    if (tray_shown) update_tray()
}

// The actions' titles' one size (DESIGN.md ¬ß13.2.1): 11 points, or the
// largest from 11 down to 9, in half points, at which the longest title
// fits its button with 2 points to spare; measured once for each width of
// the tray. (A state's longer title, Bookmarked or Memorizing, is let
// shrink a little more in its button, should it not fit even at 9.)
tray_title_size: f64 = 11.0f64;

tray_fit_w: f64 = -1.0f64;

tray_fit_titles: []str = ["Copy", "Share", "Bookmark", "Note", "Study", "Compare",
    "Memorize"];

tray_fit() {
    w: f64 = view_width(window) - 24.0f64 - 28.0f64;
    if (w == tray_fit_w || w <= 0.0f64) return;
    tray_fit_w = w;
    room: f64 = w / len(action_titles) as f64 - 2.0f64;
    label: int = make("UILabel");
    size: f64 = 11.0f64;
    fits: bool = false;
    while (!fits && size >= 9.0f64) {
        msg1(label, sel("setFont:"), sans(size, 0.23f64));
        widest: f64 = 0.0f64;
        for t in tray_fit_titles {
            msg1(label, sel("setText:"), nsstring(t));
            l8_msg_hfa(hfa, label, sel("intrinsicContentSize"), 0, 0, 0);
            if (hfa[0] > widest) widest = hfa[0]
        }
        if (widest <= room) fits = true else size = size - 0.5f64
    }
    release(label);
    if (size < 9.0f64) size = 9.0f64;
    tray_title_size = size;
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: tray titles at ");
        fput_int((size * 10.0f64) as int);
        fput_str(" tenths of a point, room ");
        fput_int((room * 10.0f64) as int);
        note_ns(fstring())
    }
}

// A button's title let shrink to fit (a state's longer title).
tray_title_shrinks(b: int) {
    l: int = msg(b, sel("titleLabel"));
    if (l == 0) return;
    msg1(l, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(l, sel("setMinimumScaleFactor:"), 0.8f64)
}

// The tray's reference, checked color, and bookmark's and note's titles,
// for the verses selected.
update_tray() {
    tray_fit();
    fbuf_n = 0;
    put_ref(sel_c, sel_v, sel_n);
    msg1(tray_label, sel("setText:"), fstring());
    // The color all the verses share (-1 if not one), and whether any is
    // highlighted.
    shared: int = -2;
    any: bool = false;
    for i in 0..sel_n {
        h: int = highlight_of(sel_c, sel_v[i]);
        if (h >= 0) any = true;
        if (shared == -2) shared = h else if (shared != h) shared = -1
    }
    for i in 0..5 {
        msg2(tray_swatches[i], sel("setImage:forState:"), if (shared == i) symbol("checkmark",
            12.0f64, 7, msg(cls("UIColor"), sel("whiteColor"))) else 0, 0);
        msg1(tray_swatches[i], sel("setSelected:"), if (shared == i) 1 else 0)
    }
    msg1(tray_swatches[5], sel("setHidden:"), if (any) 0 else 1);
    marked: bool = sel_n > 0 && is_bookmarked(sel_c, sel_v[0]);
    msg1(tray_actions[2], sel("setConfiguration:"), action_config(if (marked) "Bookmarked" else "Bookmark",
        if (marked) "bookmark.fill" else "bookmark"));
    noted: bool = sel_n > 0 && note_of(sel_c, sel_v[0]) >= 0;
    msg1(tray_actions[3], sel("setConfiguration:"), action_config(if (noted) "Edit Note" else "Note",
        if (noted) "note.text" else "square.and.pencil"));
    for i in [0, 1, 4, 5] msg1(tray_actions[i], sel("setConfiguration:"), action_config(action_titles[i],
        action_symbols[i]));
    // Memorize, or Memorizing (accent) when a passage holds every verse.
    holding: int = tray_memory_holding();
    mb: int = tray_actions[6];
    msg1(mb, sel("setConfiguration:"), action_config_c(if (holding >= 0) "Memorizing" else "Memorize",
        "brain", if (holding >= 0) c_accent else 0));
    ok: bool = holding >= 0 || tray_memory_ok();
    msg1(mb, sel("setEnabled:"), if (ok) 1 else 0);
    msg1(mb, sel("setAccessibilityLabel:"), nsstring(if (holding >= 0) "Memorizing" else "Memorize"));
    msg1(mb, sel("setAccessibilityHint:"), nsstring(if (holding >= 0) "Practises this passage." else if (ok) "Adds these verses to Memory in the Library." else "Memory passages are up to 40 verses."));
    for i in 0..7 tray_title_shrinks(tray_actions[i]);
    // (Study: its References and Commentary are every verse's, the Words
    // where they can be.)
    msg1(tray_actions[4], sel("setEnabled:"), if (sel_n > 0) 1 else 0)
}

reduce_motion(): bool {
    (UIAccessibilityIsReduceMotionEnabled() & 255) != 0
}

extern UIAccessibilityIsReduceMotionEnabled(): int;

// A layer's key path animated from a to b (a spring, or ease in and out
// over t seconds).
animate(
    layer: int,
    path: str,
    a: f64,
    b: f64,
    spring: bool,
    t: f64
) {
    anim: int = 0;
    if (spring) {
        anim = msg1(cls("CASpringAnimation"), sel("animationWithKeyPath:"), nsstring(path));
        msg_set_f(anim, sel("setMass:"), 1.0f64);
        msg_set_f(anim, sel("setStiffness:"), 300.0f64);
        msg_set_f(anim, sel("setDamping:"), 30.0f64);
        msg_set_f(anim, sel("setDuration:"), msg_f(anim, sel("settlingDuration")))
    } else {
        anim = msg1(cls("CABasicAnimation"), sel("animationWithKeyPath:"), nsstring(path));
        msg_set_f(anim, sel("setDuration:"), t);
        msg1(anim, sel("setTimingFunction:"), msg1(cls("CAMediaTimingFunction"), sel("functionWithName:"),
            objc_const("kCAMediaTimingFunctionEaseInEaseOut")))
    }
    msg1(anim, sel("setFromValue:"), nsnumber_f(a));
    msg1(anim, sel("setToValue:"), nsnumber_f(b));
    msg2(layer, sel("addAnimation:forKey:"), anim, nsstring(path))
}

show_tray() {
    update_tray();
    hide_back();
    if (tray_shown) return;
    tray_shown = true;
    tray_timer = stop_timer(tray_timer);
    msg1(tray, sel("setHidden:"), 0);
    root: int = window;
    msg(root, sel("layoutIfNeeded"));
    layer: int = msg(tray, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 1.0f64 as f32);
    if (reduce_motion()) {
        animate(layer, "opacity", 0.0f64, 1.0f64, false, 0.15f64);
        return
    }
    note_frame("bible: tray y ", tray);
    h: f64 = view_height(tray);
    animate(layer, "transform.translation.y", h + 24.0f64, 0.0f64, true, 0.0f64);
    animate(layer, "opacity", 0.0f64, 1.0f64, false, 0.18f64)
}

hide_tray() {
    if (!tray_shown) return;
    tray_shown = false;
    layer: int = msg(tray, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 0.0f64 as f32);
    if (!reduce_motion()) animate(layer, "transform.translation.y", 0.0f64, view_height(tray) + 24.0f64,
        false, 0.2f64);
    animate(layer, "opacity", 1.0f64, 0.0f64, false, 0.2f64);
    tray_timer = stop_timer(tray_timer);
    tray_timer = after(0.22f64, "trayHidden:")
}

tray_hidden(_self: int, _cmd: int, _timer: int): int {
    tray_timer = 0;
    if (!tray_shown) msg1(tray, sel("setHidden:"), 1);
    0
}

tray_closed(_self: int, _cmd: int, _sender: int): int {
    clear_selection();
    0
}

// A swatch: its color on every verse selected (or off, if they all had it).
tray_swatch(_self: int, _cmd: int, sender: int): int {
    i: int = msg(sender, sel("tag"));
    color: int = if (i >= 5) -1 else i;
    if (color >= 0) {
        all: bool = true;
        for x in 0..sel_n
            if (highlight_of(sel_c, sel_v[x]) != color) all = false;
        if (all) color = -1
    }
    apply_highlight(sel_c, sel_v, sel_n, color);
    clear_selection();
    0
}

// Color (-1: none) on the first n verses of vs in chapter c, kept.
apply_highlight(
    c: int,
    vs: []int,
    n: int,
    color: int
) {
    for i in 0..n set_highlight(c, vs[i], color);
    save_highlights();
    if (color >= 0) {
        msg2(defaults(), sel("setObject:forKey:"), nsstring(hl_names[color]), nsstring("lastHighlight"));
        last_color = color
    }
    haptic_impact(0);
    repaint(c)
}

last_color: int = -1;

// The color the edit menu's Highlight uses: the last one used (yellow at
// first).
last_highlight(): int {
    if (last_color >= 0) return last_color;
    name: int = msg1(defaults(), sel("stringForKey:"), nsstring("lastHighlight"));
    last_color = 0;
    if (name != 0) {
        for i in 0..5
            if ((msg1(name, sel("isEqualToString:"), nsstring(hl_names[i])) & 255) != 0) last_color = i
    }
    last_color
}

tray_action(_self: int, _cmd: int, sender: int): int {
    i: int = msg(sender, sel("tag"));
    if (i == 0) copy_verses(sel_c, sel_v, sel_n) else if (i == 1) share_verses(sel_c,
        sel_v, sel_n, sender) else if (i == 2) toggle_bookmark(sel_c, sel_v[0]) else if (i == 3) {
        c: int = sel_c;
        v: int = sel_v[0];
        last: int = sel_v[sel_n - 1];
        clear_selection();
        open_note(c, v, last);
        return 0
    } else if (i == 4) {
        c: int = sel_c;
        v: int = sel_v[0];
        clear_selection();
        open_study_verse(c, v);
        return 0
    } else if (i == 5) {
        c: int = sel_c;
        n: int = sel_n;
        for x in 0..n compare_verses[x] = sel_v[x];
        clear_selection();
        open_compare(c, compare_verses, n);
        return 0
    } else if (i == 6) {
        tray_memorize();
        return 0
    }
    clear_selection();
    0
}

copy_verses(c: int, vs: []int, n: int) {
    if (n == 0) return;
    fbuf_n = 0;
    put_quote(c, vs, n);
    msg1(msg(cls("UIPasteboard"), sel("generalPasteboard")), sel("setString:"), fstring());
    haptic_success();
    toast("Copied")
}

share_verses(
    c: int,
    vs: []int,
    n: int,
    from: int
) {
    if (n == 0) return;
    fbuf_n = 0;
    put_quote(c, vs, n);
    text: int = fstring();
    // (With Share as Image among its actions, DESIGN.md ¬ß10.5.)
    share_keep(c, vs, n);
    one[0] = text;
    vc: int = msg2(msg(cls("UIActivityViewController"), sel("alloc")), sel("initWithActivityItems:applicationActivities:"),
        nsarray(one, 1), share_activities());
    pop: int = msg(vc, sel("popoverPresentationController"));
    if (pop != 0 && from != 0) msg1(pop, sel("setSourceView:"), from);
    bar_expand();
    msg3(nav, sel("presentViewController:animated:completion:"), vc, 1, 0);
    release(vc)
}

toggle_bookmark(c: int, v: int) {
    on: bool = !is_bookmarked(c, v);
    set_bookmark(c, v, on);
    save_bookmarks();
    if (on) haptic_impact(1);
    remake(c)
}

// ---- the toast ----
toast_label: int = 0;

toast_timer: int = 0;

toast(text: str) {
    toast_symbol(nsstring(text), "", 1.2f64)
}

// A toast of text (an NSString), after a symbol if one is named, for t
// seconds.
toast_symbol(text: int, name: str, t: f64) {
    toast_image(text, if (len(name) > 0) symbol(name, 13.0f64, 7, c_bg) else 0, t)
}

// The same, after an image (0, none).
toast_image(text: int, image: int, t: f64) {
    root: int = window;
    if (toast_label == 0) {
        toast_label = make("UILabel");
        msg1(toast_label, sel("setTextAlignment:"), 1);
        msg1(toast_label, sel("setFont:"), sans(14.0f64, 0.3f64));
        msg1(toast_label, sel("setClipsToBounds:"), 1);
        msg1(root, sel("addSubview:"), toast_label)
    }
    msg1(toast_label, sel("setTextColor:"), c_bg);
    if (image != 0) {
        a: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
        att: int = msg1(cls("NSTextAttachment"), sel("textAttachmentWithImage:"),
            image);
        msg1(a, sel("appendAttributedString:"), msg1(cls("NSAttributedString"), sel("attributedStringWithAttachment:"),
            att));
        msg1(a, sel("appendAttributedString:"), msg(msg1(msg(cls("NSAttributedString"),
            sel("alloc")), sel("initWithString:"), ustr(32, 0)), sel("autorelease")));
        msg1(a, sel("appendAttributedString:"), msg(msg1(msg(cls("NSAttributedString"),
            sel("alloc")), sel("initWithString:"), text), sel("autorelease")));
        msg1(toast_label, sel("setAttributedText:"), a)
    } else {
        msg1(toast_label, sel("setAttributedText:"), 0);
        msg1(toast_label, sel("setText:"), text)
    }
    msg1(toast_label, sel("setBackgroundColor:"), msg_set_f(c_ink, sel("colorWithAlphaComponent:"),
        0.9f64));
    l8_msg_hfa(hfa, toast_label, sel("intrinsicContentSize"), 0, 0, 0);
    w: f64 = hfa[0] + 32.0f64;
    h: f64 = 34.0f64;
    l8_msg_hfa(hfa, root, sel("safeAreaInsets"), 0, 0, 0);
    bottom: f64 = hfa[2];
    W: f64 = view_width(root);
    H: f64 = view_height(root);
    msg_rect(toast_label, sel("setFrame:"), (W - w) / 2.0f64, H - bottom - 8.0f64 - 132.0f64 - 12.0f64 - h,
        w, h);
    msg_set_f(msg(toast_label, sel("layer")), sel("setCornerRadius:"), h / 2.0f64);
    msg1(root, sel("bringSubviewToFront:"), toast_label);
    layer: int = msg(toast_label, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 1.0f64 as f32);
    animate(layer, "opacity", 0.0f64, 1.0f64, false, 0.2f64);
    toast_timer = stop_timer(toast_timer);
    toast_timer = after(t, "toastDone:")
}

toast_done(_self: int, _cmd: int, _timer: int): int {
    toast_timer = 0;
    layer: int = msg(toast_label, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 0.0f64 as f32);
    animate(layer, "opacity", 1.0f64, 0.0f64, false, 0.2f64);
    0
}

// ---- the edit menu: the app's commands first ----
// Whether the text view asked for the menu (the demo checks).
menu_asked: bool = false;

// The text view and range of the text selected when the menu was asked for.
em_tv: int = 0;

em_loc: int = 0;

em_len: int = 0;

command_titles: []str = ["Highlight", "Note", "Copy with Reference", "Share"];

command_sels: []str = ["bibleHighlight:", "bibleNote:", "bibleCopyRef:", "bibleShare:"];

edit_menu(
    _self: int,
    _cmd: int,
    tv: int,
    loc: int,
    length: int,
    suggested: int
): int {
    if (chapter_of_view(tv) < 0) return msg2(cls("UIMenu"), sel("menuWithTitle:children:"),
        nsstring(""), suggested);
    if (!menu_asked) {
        // (Once, to the console and the system log: so a long press on a
        // device can be seen to reach it.)
        note("bible: edit menu delegate");
        if (diag_on) NSLog(nsstring("bible: edit menu delegate"))
    }
    menu_asked = true;
    em_tv = tv;
    em_loc = loc;
    em_len = length;
    app_menu(suggested)
}

// The edit menu (iOS 26 asks with the ranges selected): the same, for the
// text selected.
edit_menu_ranges(
    self: int,
    cmd: int,
    tv: int,
    _ranges: int,
    suggested: int
): int {
    r: int = msg(tv, sel("selectedTextRange"));
    if (r == 0) return msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""),
        suggested);
    begin: int = msg(tv, sel("beginningOfDocument"));
    a: int = msg(r, sel("start"));
    loc: int = msg2(tv, sel("offsetFromPosition:toPosition:"), begin, a);
    n: int = msg2(tv, sel("offsetFromPosition:toPosition:"), a, msg(r, sel("end")));
    edit_menu(self, cmd, tv, loc, n, suggested)
}

// A menu of the app's commands (Study, where the words selected can be
// studied; Highlight; Note), then the system's suggested ones.
app_menu(suggested: int): int {
    n: int = 0;
    if (menu_studyable()) {
        one[0] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
            nsstring("Study"), 0, sel("bibleStudy:"), 0);
        n = 1
    }
    for i in 0..2 {
        one[n] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
            nsstring(command_titles[i]), 0, sel(command_sels[i]), 0);
        n = n + 1
    }
    children: int = msg1(nsarray(one, n), sel("arrayByAddingObjectsFromArray:"), suggested);
    m: int = cls("UIMenu");
    if ((msg1(m, sel("respondsToSelector:"), sel("menuWithChildren:")) & 255) != 0) return msg1(m,
        sel("menuWithChildren:"), children);
    msg2(m, sel("menuWithTitle:children:"), nsstring(""), children)
}

// The verses the text selected touches: into the selection (of its
// chapter); false if none.
command_verses(): bool {
    if (em_tv == 0) return false;
    c: int = chapter_of_view(em_tv);
    if (c < 0) return false;
    compute_ranges(c);
    clear_selection();
    sel_c = c;
    sel_n = 0;
    for i in 0..rv_count {
        if (rv_b[i] < em_loc + em_len && rv_e[i] > em_loc && sel_n < len(sel_v)) {
            sel_v[sel_n] = rv_num[i];
            sel_n = sel_n + 1
        }
    }
    msg2(em_tv, sel("setSelectedRange:"), em_loc, 0);
    msg(em_tv, sel("resignFirstResponder"));
    sel_n > 0
}

// Whether the text selected (em_tv, em_loc, em_len) has a word that can be
// studied: then its verse and word are pick_vi and pick_word (lang.l8).
menu_studyable(): bool {
    // (Only the BSB's words are the original's: a KJV word cannot be
    // mapped to them. Elsewhere the tray's Study is the way.)
    if (em_tv == 0 || text_cur != TEXT_BSB) return false;
    c: int = chapter_of_view(em_tv);
    if (c < 0) return false;
    lang_load();
    if (!lang_ready) return false;
    compute_ranges(c);
    b: int = byte_of_unit(em_loc);
    e: int = byte_of_unit(em_loc + (if (em_len > 0) em_len else 1));
    if (!study_pick(c, b, e)) return false;
    pick_word >= 0 && v_aligned(pick_vi)
}

// The byte of the chapter laid out (out) at UTF-16 unit k of its text view
// (the marks put in it not counted).
byte_of_unit(k: int): int {
    u: int = k;
    shift: int = 0;
    for j in 0..ev_n {
        at: int = ev_pos[j] + shift;
        if (k >= at + ev_len[j]) shift = shift + ev_len[j] else if (k >= at) u = ev_pos[j] + shift
    }
    u = u - shift;
    if (u < 0) u = 0;
    lo: int = 0;
    hi: int = out_n;
    while (lo < hi) {
        mid: int = (lo + hi) / 2;
        if (u16_at[mid] < u) lo = mid + 1 else hi = mid
    }
    lo
}

// Study: the word study of the first word selected, as a sheet.
command_study(_self: int, _cmd: int, _sender: int): int {
    if (!menu_studyable()) return 0;
    vi: int = pick_vi;
    w: int = pick_word;
    if (em_tv != 0) {
        msg2(em_tv, sel("setSelectedRange:"), em_loc, 0);
        msg(em_tv, sel("resignFirstResponder"))
    }
    open_study_sheet(vi, w);
    0
}

command_highlight(_self: int, _cmd: int, _sender: int): int {
    if (command_verses()) {
        apply_highlight(sel_c, sel_v, sel_n, last_highlight());
        sel_n = 0;
        sel_c = -1
    }
    0
}

command_note(_self: int, _cmd: int, _sender: int): int {
    if (command_verses()) {
        c: int = sel_c;
        v: int = sel_v[0];
        last: int = sel_v[sel_n - 1];
        sel_n = 0;
        sel_c = -1;
        open_note(c, v, last)
    }
    0
}

command_copy(_self: int, _cmd: int, _sender: int): int {
    if (command_verses()) {
        copy_verses(sel_c, sel_v, sel_n);
        sel_n = 0;
        sel_c = -1
    }
    0
}

command_share(_self: int, _cmd: int, _sender: int): int {
    if (command_verses()) {
        share_verses(sel_c, sel_v, sel_n, em_tv);
        sel_n = 0;
        sel_c = -1
    }
    0
}

add_commands(c: int) {
    add_method1(c, sel("bibleStudy:"), &command_study, "v@:@");
    add_method1(c, sel("bibleHighlight:"), &command_highlight, "v@:@");
    add_method1(c, sel("bibleNote:"), &command_note, "v@:@");
    add_method1(c, sel("bibleCopyRef:"), &command_copy, "v@:@");
    add_method1(c, sel("bibleShare:"), &command_share, "v@:@")
}

// ---- jumps, and the way back ----
back: int = 0;

back_shown: bool = false;

back_material: int = 0;

back_timer: int = 0;

// Where the reader arrived (the table's offset), and whether at a verse
// (and which).
arrival_y: f64 = 0.0f64;

arrived_v: int = 0;

make_back() {
    back = keep(msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        msg(cls("UIButtonConfiguration"), sel("filledButtonConfiguration")), 0));
    msg3(back, sel("addTarget:action:forControlEvents:"), app_obj, sel("backTapped:"),
        64);
    layer: int = msg(back, sel("layer"));
    msg1(layer, sel("setShadowColor:"), msg(msg(cls("UIColor"), sel("blackColor")),
        sel("CGColor")));
    msg_set_f32(layer, sel("setShadowOpacity:"), 0.12f64 as f32);
    msg_set_f(layer, sel("setShadowRadius:"), 12.0f64);
    msg_ff(layer, sel("setShadowOffset:"), 0.0f64, 4.0f64);
    msg1(back, sel("setHidden:"), 1);
    msg1(window, sel("addSubview:"), back);
    // (iOS 26: the reader's bottom edge effect drawn under the capsule
    // while it is shown, as under the system's floating controls, so the
    // words it floats over soften rather than clash with its glass.)
    if (cls("UIScrollEdgeElementContainerInteraction") != 0) {
        back_edge = keep(msg(make("UIScrollEdgeElementContainerInteraction"), sel("autorelease")));
        msg1(back_edge, sel("setEdge:"), 4);
        msg1(back, sel("addInteraction:"), back_edge)
    }
}

back_edge: int = 0;

// The capsule's edge effect on the reader (shown) or off it.
back_edge_on(on: bool) {
    if (back_edge == 0) return;
    msg1(back_edge, sel("setScrollView:"), if (on) table else 0)
}

// The capsule faded out: its edge effect gone with it (unless it came back).
back_faded(_self: int, _cmd: int, _timer: int): int {
    if (!back_shown) back_edge_on(false);
    0
}

// The capsule's look, and its title: the place it goes back to.
style_back() {
    if (back == 0 || bk_n == 0) return;
    // (Glass where there is glass; else a capsule of thick material behind
    // a clear button.)
    // (Glass tinted so it stands clear of the page in every theme: near
    // white on the light themes, the ink's tone on the dark ones.)
    glass: bool = responds(cls("UIButtonConfiguration"), "prominentGlassButtonConfiguration");
    config: int = if (glass) msg(cls("UIButtonConfiguration"), sel("prominentGlassButtonConfiguration")) else msg(cls("UIButtonConfiguration"),
        sel("plainButtonConfiguration"));
    if (glass) msg1(config, sel("setBaseBackgroundColor:"), if (is_dark()) color_hex("4A4744",
        0.95f64) else color_hex("FFFFFF", 0.92f64));
    msg1(config, sel("setBaseForegroundColor:"), c_ink);
    msg_set_f32(msg(back, sel("layer")), sel("setShadowOpacity:"), (if (glass) 0.0f64 else 0.12f64) as f32);
    msg1(config, sel("setCornerStyle:"), 4);
    msg_rect(config, sel("setContentInsets:"), 0.0f64, 14.0f64, 0.0f64, 14.0f64);
    msg1(config, sel("setImage:"), symbol("chevron.left", 12.0f64, 6, 0));
    msg_set_f(config, sel("setImagePadding:"), 6.0f64);
    i: int = bk_n - 1;
    fbuf_n = 0;
    fput_ref(bk_c[i], if (bk_exact[i]) bk_v[i] else 0, 0);
    keys[0] = k_font;
    values[0] = sans(14.0f64, 0.3f64);
    keys[1] = k_color;
    values[1] = c_ink;
    t: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        fstring(), nsdictionary(keys, values, 2));
    msg1(config, sel("setAttributedTitle:"), t);
    release(t);
    msg1(back, sel("setConfiguration:"), config);
    fput_str("");
    msg1(back, sel("setAccessibilityLabel:"), fstring());
    msg1(back, sel("setAccessibilityHint:"), nsstring("Go back"));
    l8_msg_hfa(hfa, back, sel("intrinsicContentSize"), 0, 0, 0);
    w: f64 = hfa[0];
    root: int = window;
    l8_msg_hfa(hfa, root, sel("safeAreaInsets"), 0, 0, 0);
    bottom: f64 = hfa[2];
    msg_rect(back, sel("setFrame:"), 16.0f64, view_height(root) - bottom - 12.0f64 - 36.0f64,
        w, 36.0f64);
    if (!glass) {
        if (back_material == 0) {
            back_material = msg1(msg(cls("UIVisualEffectView"), sel("alloc")), sel("initWithEffect:"),
                msg1(cls("UIBlurEffect"), sel("effectWithStyle:"), 9));
            msg1(back_material, sel("setUserInteractionEnabled:"), 0);
            msg_set_f(msg(back_material, sel("layer")), sel("setCornerRadius:"), 18.0f64);
            msg1(back_material, sel("setClipsToBounds:"), 1);
            msg2(back, sel("insertSubview:atIndex:"), back_material, 0)
        }
        msg_rect(back_material, sel("setFrame:"), 0.0f64, 0.0f64, w, 36.0f64)
    }
}

show_back() {
    style_back();
    if (tray_shown || bk_n == 0 || listen_shown) return;
    msg1(window, sel("bringSubviewToFront:"), back);
    msg1(back, sel("setHidden:"), 0);
    layer: int = msg(back, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 1.0f64 as f32);
    animate(layer, "opacity", 0.0f64, 1.0f64, false, 0.25f64);
    if (!reduce_motion()) animate(layer, "transform.scale", 0.92f64, 1.0f64, false,
        0.25f64);
    back_shown = true;
    back_edge_on(true);
    note_frame("bible: back y ", back);
    back_timer = stop_timer(back_timer);
    back_timer = after(12.0f64, "backTimeout:")
}

hide_back() {
    if (!back_shown) return;
    back_shown = false;
    back_timer = stop_timer(back_timer);
    layer: int = msg(back, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 0.0f64 as f32);
    animate(layer, "opacity", 1.0f64, 0.0f64, false, 0.2f64);
    _t: int = after(0.2f64, "backFaded:")
}

back_timeout(_self: int, _cmd: int, _timer: int): int {
    back_timer = 0;
    if (demo_on) return 0;
    hide_back();
    0
}

// The capsule goes when the reader has scrolled two screens from where
// it arrived.
back_scrolled(y: f64) {
    if (!back_shown) return;
    d: f64 = y - arrival_y;
    if (d < 0.0f64) d = -d;
    if (d > 2.0f64 * view_height(table)) hide_back();
    if (d > 8.0f64) arrived_v = 0
}

// The way back (the places jumped from, newest last; the capsule goes to
// the newest), apart from the history's trail.
bk_n: int = 0;

bk_c: []int = new int[50](0);

bk_v: []int = new int[50](0);

bk_frac: []int = new int[50](0);

bk_exact: []bool = new bool[50](false);

back_push(
    c: int,
    v: int,
    frac: int,
    exact: bool
) {
    if (bk_n >= len(bk_c)) {
        for i in 0..bk_n - 1 {
            bk_c[i] = bk_c[i + 1];
            bk_v[i] = bk_v[i + 1];
            bk_frac[i] = bk_frac[i + 1];
            bk_exact[i] = bk_exact[i + 1]
        }
        bk_n = bk_n - 1
    }
    bk_c[bk_n] = c;
    bk_v[bk_n] = v;
    bk_frac[bk_n] = frac;
    bk_exact[bk_n] = exact;
    bk_n = bk_n + 1
}

// Where the reader is now, onto the way back and the history (a jump's
// origin).
push_here() {
    measure_place();
    v: int = if (arrived_v > 0) arrived_v else place_v;
    frac: int = place_frac;
    exact: bool = arrived_v > 0;
    // (From a sheet opened on a verse of this chapter: that verse.)
    if (origin_v > 0 && origin_c == cur) {
        v = origin_v;
        frac = 0;
        exact = true
    }
    back_push(cur, v, frac, exact);
    history_add(cur, v, frac, exact, time(0));
    origin_v = 0;
    save_history()
}

// A jump's destination, onto the history.
history_here(c: int, v: int) {
    history_add(c, v, 0, v > 0, time(0));
    save_history()
}

// ---- dwelling: a chapter read for 20 s goes onto the history ----
dwell_c: int = -1;

dwell_timer: int = 0;

// Scrolling stopped: if this chapter is not the history's newest, it goes
// on once the reader has stayed in it for 20 s.
dwell_check() {
    if (hs_n > 0 && hs_ch[hs_n - 1] == cur) {
        dwell_timer = stop_timer(dwell_timer);
        dwell_c = -1;
        return
    }
    if (dwell_timer != 0 && dwell_c == cur) return;
    dwell_timer = stop_timer(dwell_timer);
    dwell_c = cur;
    dwell_timer = after(if (demo_on && demo_fast_dwell) 1.0f64 else 20.0f64, "dwellDone:")
}

demo_fast_dwell: bool = false;

dwell_done(_self: int, _cmd: int, _timer: int): int {
    dwell_timer = 0;
    if (!restored) return 0;
    measure_place();
    if (cur != dwell_c || hs_n > 0 && hs_ch[hs_n - 1] == cur) return 0;
    history_add(cur, place_v, place_frac, false, time(0));
    save_history();
    note_num("bible: dwelt in ", cur);
    0
}

// The verse a study sheet was opened on (its chapter), while it is shown.
origin_c: int = -1;

origin_v: int = 0;

// A jump: to chapter c (at verse v, flashed, if v > 0), from a sheet, a
// link or anywhere; the place left kept, and the capsule back to it shown.
jump(c: int, v: int) {
    if (c < 0 || c >= chapters) return;
    // (A ribbon carried is put down where it was, before the reader moves:
    // DESIGN.md ¬ß11.1.3, P1.)
    ribbons_jump(0);
    push_here();
    clear_selection();
    // (From a sheet: the capsule once the sheet has gone, from its
    // controller's viewDidDisappear:.)
    from_sheet: bool = presented() != 0;
    dismiss_sheets();
    show_bars(false);
    arrive(c, v);
    history_here(c, v);
    if (from_sheet) {
        back_after_sheet = true;
        style_back()
    } else show_back()
}

back_after_sheet: bool = false;

arrive(c: int, v: int) {
    // (A place asked for: a glide stops for it; it moves no ribbon.)
    stop_moving();
    reading_jumped();
    // (An ESV chapter not here yet: the verse found and flashed when it
    // comes.)
    if (text_cur == TEXT_ESV && ch_start[c] < 0) {
        esv_jump_c = c;
        esv_jump_v = v
    }
    if (v > 0) {
        go_verse(c, v);
        flash(c, v)
    } else go_top(c);
    arrival_y = offset_y(table);
    arrived_v = v;
    save_place();
    settle_c = c;
    settle_v = v;
    settle_timer = stop_timer(settle_timer);
    settle_timer = after(0.6f64, "jumpSettle:");
    title_menus_fresh()
}

// A jump made again once a sheet has gone (the bars' and status bar's
// insets change as it goes), unless the reader has scrolled since.
settle_c: int = 0;

settle_v: int = 0;

settle_timer: int = 0;

jump_settle(_self: int, _cmd: int, _timer: int): int {
    settle_timer = 0;
    y: f64 = offset_y(table);
    d: f64 = y - arrival_y;
    if (d < 0.0f64) d = -d;
    if (d > 2.0f64 || (msg(table, sel("isTracking")) & 255) != 0) return 0;
    if (settle_v > 0) go_verse(settle_c, settle_v) else go_top(settle_c);
    arrival_y = offset_y(table);
    save_place();
    style_back();
    note_num("bible: settled at ", settle_c);
    note_num("bible:   top ", last_top as int);
    note_num("bible:   row ", row_y(settle_c) as int);
    tv: int = view_of(settle_c);
    if (tv != 0) {
        note_num("bible:   text offset ", offset_y(tv) as int);
        note_num("bible:   measured ", if (range_rect(tv, opener16[settle_c], 1)) hfa[1] as int else -1)
    }
    note_num("bible:   alpha x100 ", (msg_f(title_fader, sel("alpha")) * 100.0f64) as int);
    title_menus_fresh();
    0
}

// The capsule: back to where the reader was (and this place kept, to come
// back to in turn).
back_tapped(_self: int, _cmd: int, _sender: int): int {
    if (bk_n == 0) return 0;
    i: int = bk_n - 1;
    c: int = bk_c[i];
    v: int = bk_v[i];
    f: int = bk_frac[i];
    exact: bool = bk_exact[i];
    bk_n = bk_n - 1;
    stop_moving();
    // (A jump, so the carried ribbon is put down; and the one the jump it
    // undoes put down is picked up again once there: P4.)
    ribbons_jump(1);
    push_here();
    if (exact) arrive(c, v) else {
        reading_jumped();
        go_place(c, v, f);
        arrival_y = offset_y(table);
        arrived_v = 0;
        save_place()
    }
    history_here(c, if (exact) v else 0);
    show_back();
    ribbons_capsule_arrived();
    title_menus_fresh();
    0
}

// ---- the flash on a verse jumped to ----
flash_timer: int = 0;

flash(c: int, v: int) {
    flash_c = c;
    flash_v = v;
    repaint(c);
    flash_timer = stop_timer(flash_timer);
    flash_timer = after(if (demo_on) 6.0f64 else 0.9f64, "flashDone:")
}

flash_done(_self: int, _cmd: int, _timer: int): int {
    flash_timer = 0;
    c: int = flash_c;
    flash_c = -1;
    tv: int = view_of(c);
    if (tv != 0) {
        t: int = make("CATransition");
        msg1(t, sel("setType:"), objc_const("kCATransitionFade"));
        msg_set_f(t, sel("setDuration:"), 0.4f64);
        msg2(msg(tv, sel("layer")), sel("addAnimation:forKey:"), t, 0);
        release(t)
    }
    repaint(c);
    0
}

add_select_methods(app: int) {
    add_method1(app, sel("trayClose:"), &tray_closed, "v@:@");
    add_method1(app, sel("traySwatch:"), &tray_swatch, "v@:@");
    add_method1(app, sel("trayAction:"), &tray_action, "v@:@");
    add_method1(app, sel("trayHidden:"), &tray_hidden, "v@:@");
    add_method1(app, sel("toastDone:"), &toast_done, "v@:@");
    add_method1(app, sel("backTapped:"), &back_tapped, "v@:@");
    add_method1(app, sel("backTimeout:"), &back_timeout, "v@:@");
    add_method1(app, sel("backFaded:"), &back_faded, "v@:@");
    add_method1(app, sel("flashDone:"), &flash_done, "v@:@");
    add_method1(app, sel("jumpSettle:"), &jump_settle, "v@:@");
    add_method1(app, sel("dwellDone:"), &dwell_done, "v@:@");
    add_method1(app, sel("demoLater:"), &demo_later, "v@:@");
    add_method1(app, sel("demoCheck:"), &demo_check, "v@:@");
    add_method1(app, sel("demoTick:"), &demo_tick, "v@:@");
    add_method3(app, sel("textView:editMenuForTextInRanges:suggestedActions:"), &edit_menu_ranges,
        "@@:@@@");
    add_method3(app, sel("editMenuInteraction:menuForConfiguration:suggestedActions:"),
        &demo_menu, "@@:@@@");
    add_method4(app, sel("textView:editMenuForTextInRange:suggestedActions:"), &edit_menu,
        "@@:@{_NSRange=QQ}@")
}
