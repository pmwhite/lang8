tag bible;

use_tag std;

// The text as HTML, for the web (WEB.md §W1.5): what layout_chapter lays
// out (text.l8), written as one chapter's <article>, the same in the
// browser and in the pages made at build time (prerender.l8), so the app
// can take a prerendered chapter as its own. Also the escaping every other
// screen's HTML uses, and the reader's addresses (/read/bsb/john/3#16).
//
// The markup is the contract with read.css: an <hr class="div"> between
// chapters; the opener an <h2 class="op"> of the book's name (bk) or its
// label (lb) and the number (nm, "nm one" for chapter 1); headings h3.s
// and h4.ss; a heading's passages p.r with a.ref links; a psalm's title
// p.d; major sections p.m and p.mr; acrostic letters p.ac; paragraphs by
// kind (p.p, q1, q2, l1, l2, c, rt, vl, with gap after a stanza's break),
// each verse in them a span.v with data-v (several where a verse crosses
// paragraphs), its number span.vn; LORD's small capitals span.sc, the
// words of Jesus span.j, supplied words span.su; a footnote's mark a.fn,
// and the notes listed at the end in ol.fns.
import "text.l8";

// What is written: hb's first hb_n bytes.
hb: []i8 = new i8[1048576](0i8);

hb_n: int = 0;

h_byte(c: int) {
    if (hb_n < len(hb)) {
        hb[hb_n] = c trunc i8;
        hb_n = hb_n + 1
    }
}

// Markup, as it is.
h_str(s: str) {
    for c in s h_byte(c as int)
}

h_int(n: int) {
    if (n < 0) {
        h_byte(45);
        h_int(0 - n);
        return
    }
    if (n >= 10) h_int(n / 10);
    h_byte(48 + n % 10)
}

// Text from b's p to e, escaped for HTML: & < > " ' as entities, so it is
// safe in an element and in a quoted attribute alike.
h_text(b: []i8, p: int, e: int) {
    for i in p..e h_char(b[i] as int & 255)
}

h_text_s(s: str) {
    for c in s h_char(c as int & 255)
}

h_char(k: int) {
    if (k == 38) h_str("&amp;") else if (k == 60) h_str("&lt;") else if (k == 62) h_str("&gt;") else if (k == 34) h_str("&quot;") else if (k == 39) h_str("&#39;") else h_byte(k)
}

// The same for an attribute's value (the same escapes).
h_attr(b: []i8, p: int, e: int) {
    h_text(b, p, e)
}

// ---- addresses ----
// The version's name in addresses (bsb, kjv ...): its abbreviation in
// lower case.
h_version(t: int) {
    s: str = text_abbrs[t];
    for c in s h_byte(lower(c as int))
}

lower(k: int): int {
    if (k >= 65 && k <= 90) k + 32 else k
}

// Book b's name in addresses: in lower case, hyphens for spaces
// (1-samuel, song-of-solomon).
h_book_slug(b: int) {
    for i in book_name_start(b)..book_name_end(b) {
        k: int = bsb[i] as int;
        h_byte(if (k == 32) 45 else lower(k))
    }
}

// Chapter c of text t's address; with verses v to w (0 for none; w == v
// or 0 for one).
h_chapter_url(
    t: int,
    c: int,
    v: int,
    w: int
) {
    h_str("/read/");
    h_version(t);
    h_byte(47);
    h_book_slug(ch_book[c]);
    h_byte(47);
    h_int(ch_num[c]);
    if (v > 0) {
        h_byte(35);
        h_int(v);
        if (w > v) {
            h_byte(45);
            h_int(w)
        }
    }
}

// The book of a slug (s's first n bytes), or -1.
book_of_slug(s: []i8, p: int, e: int): int {
    for b in 0..books {
        a: int = book_name_start(b);
        z: int = book_name_end(b);
        if (z - a == e - p) {
            same: bool = true;
            for i in 0..z - a {
                k: int = bsb[a + i] as int;
                want: int = if (k == 32) 45 else lower(k);
                if (lower(s[p + i] as int) != want) same = false
            }
            if (same) return b
        }
    }
    -1
}

// ---- a chapter ----
// The text the chapter's HTML is for (its addresses' version).
html_text: int = 0;

// Where the line from p ends in out (its newline, or out_n).
out_line_end(p: int): int {
    e: int = p;
    while (e < out_n && out[e] as int != 10) e = e + 1;
    e
}

// The run a byte of out is in (runs are in order: from r on).
run_of(a: int, r: int): int {
    k: int = r;
    while (k < runs - 1 && run_end[k] <= a) k = k + 1;
    k
}

// Whether a style is the opener's (and the divider, and major sections,
// which come with it).
is_opener(style: int): bool {
    style == STYLE_RULE || style == STYLE_BOOK || style == STYLE_BOOKLABEL || style == STYLE_NUMERAL || style == STYLE_NUMERAL1 || style == STYLE_MAJOR || style == STYLE_RANGE
}

para_classes: []str = ["p", "q1", "q2", "l1", "l2", "c", "rt", "vl"];

// The footnotes' marks as they are written: their F lines, for the list.
h_notes: int = 0;

h_note_at: []int = new int[512](0);

h_note_verse: []int = new int[512](0);

// The verse table's index of the next verse to begin, walking the chapter.
h_vk: int = 0;

// Chapter c of text t (the current text) as an <article>, into hb from
// hb_n. Laid out with everything shown (read.css hides what the settings
// hide); verses on lines of their own if lines.
html_chapter(t: int, c: int, lines: bool) {
    html_text = t;
    was_numbers: bool = lay_verse_numbers;
    was_headings: bool = lay_headings;
    was_notes: bool = lay_notes;
    was_lines: bool = lay_verse_lines;
    lay_verse_numbers = true;
    lay_headings = true;
    lay_notes = true;
    lay_verse_lines = lines;
    layout_chapter(c);
    lay_verse_numbers = was_numbers;
    lay_headings = was_headings;
    lay_notes = was_notes;
    lay_verse_lines = was_lines;
    h_notes = 0;
    h_vk = 0;
    b: int = ch_book[c];
    h_str("<article class=\"ch");
    if (lines) h_str(" lines");
    h_str("\" data-c=\"");
    h_int(c);
    h_str("\" data-b=\"");
    h_text(bsb, book_line[b] + 1, book_line[b] + 4);
    h_str("\" data-n=\"");
    h_int(ch_num[c]);
    h_str("\" aria-labelledby=\"h");
    h_int(c);
    h_str("\">\n");
    // The opener: the divider, any major section (before the heading, so
    // the heading is one element), then the book's name or label and the
    // number.
    a: int = 0;
    r: int = 0;
    head_book: int = -1;
    head_label: bool = false;
    head_num: int = -1;
    while (a < out_n && is_opener(run_style[run_of(a, r)])) {
        r = run_of(a, r);
        e: int = out_line_end(a);
        style: int = run_style[r];
        if (style == STYLE_RULE) h_str("<hr class=\"div\">\n") else if (style == STYLE_MAJOR) {
            h_str("<p class=\"m\">");
            h_text(out, a, e);
            h_str("</p>\n")
        } else if (style == STYLE_RANGE) {
            h_str("<p class=\"mr\">");
            h_text(out, a, e);
            h_str("</p>\n")
        } else if (style == STYLE_BOOK) head_book = b else if (style == STYLE_BOOKLABEL) head_label = true else head_num = style;
        a = e + 1
    }
    h_str("<h2 class=\"op\" id=\"h");
    h_int(c);
    h_str("\">");
    if (head_book >= 0) {
        h_str("<span class=\"bk\">");
        h_text(bsb, book_name_start(b), book_name_end(b));
        h_str("</span>")
    } else if (head_label) {
        h_str("<span class=\"lb\">");
        if (book_is(b, "PSA")) h_str("Psalm") else h_text(bsb, book_name_start(b),
            book_name_end(b));
        h_str("</span>")
    }
    if (head_num >= 0) {
        h_str(" <span class=\"nm");
        if (head_num == STYLE_NUMERAL1) h_str(" one");
        h_str("\">");
        h_int(ch_num[c]);
        h_str("</span>")
    }
    h_str("</h2>\n");
    // Then a line at a time: headings, and paragraphs of verses.
    while (a < out_n) {
        r = run_of(a, r);
        e: int = out_line_end(a);
        if (e > a) html_line(c, a, e, r);
        a = e + 1
    }
    if (h_notes > 0) {
        h_str("<ol class=\"fns\" aria-label=\"Footnotes\">\n");
        for i in 0..h_notes {
            h_str("<li id=\"f");
            h_int(c);
            h_byte(45);
            h_int(i + 1);
            // (Its mark's letter, then where it is: a b c, as the marks.)
            h_str("\"><b class=\"fl\">");
            h_byte(97 + i % 26);
            h_str("</b> ");
            h_verse_ref(c, h_note_verse[i]);
            h_byte(32);
            p: int = h_note_at[i];
            h_text(bsb, p + 1, line_end(p));
            h_str("</li>\n")
        }
        h_str("</ol>\n")
    }
    h_str("</article>\n")
}

// A line of out from a to e, its first run r.
html_line(
    c: int,
    a: int,
    e: int,
    r: int
) {
    style: int = run_style[r];
    para: int = run_para[r];
    if (style == STYLE_HEAD || style == STYLE_SUBHEAD) {
        h_str(if (style == STYLE_HEAD) "<h3 class=\"s\">" else "<h4 class=\"ss\">");
        html_runs(c, a, e, r, false);
        h_str(if (style == STYLE_HEAD) "</h3>\n" else "</h4>\n");
        return
    }
    if (style == STYLE_REF || style == STYLE_XREF || style == STYLE_TITLE || style == STYLE_MAJOR || style == STYLE_RANGE || style == STYLE_ACROSTIC) {
        h_str("<p class=\"");
        h_str(if (style == STYLE_TITLE) "d" else if (style == STYLE_MAJOR) "m" else if (style == STYLE_RANGE) "mr" else if (style == STYLE_ACROSTIC) "ac" else "r");
        h_str("\">");
        html_runs(c, a, e, r, false);
        h_str("</p>\n");
        return
    }
    h_str("<p class=\"");
    h_str(para_classes[para % KINDS]);
    if (para >= KINDS) h_str(" gap");
    h_str("\">");
    html_runs(c, a, e, r, true);
    h_str("</p>\n")
}

// The runs from a to e (r the first), as spans; in verses if verses.
html_runs(
    c: int,
    a: int,
    e: int,
    r: int,
    verses: bool
) {
    // The verse open (an index in the verse table), or -1.
    open: int = -1;
    i: int = a;
    k: int = r;
    while (i < e) {
        k = run_of(i, k);
        stop: int = if (run_end[k] < e) run_end[k] else e;
        if (verses) {
            // (A verse begins or ends here; the bytes between verses, a
            // space, are outside them.)
            while (h_vk < verse_count && (verse_begin[h_vk] < 0 || verse_end[h_vk] <= i)) h_vk = h_vk + 1;
            inside: bool = h_vk < verse_count && verse_begin[h_vk] <= i;
            if (inside && open != h_vk) {
                if (open >= 0) h_str("</span>");
                h_str("<span class=\"v\" data-v=\"");
                h_int(verse_num[h_vk]);
                h_str("\">");
                open = h_vk
            } else if (!inside && open >= 0) {
                h_str("</span>");
                open = -1
            }
            if (inside && verse_end[h_vk] < stop) stop = verse_end[h_vk];
            if (!inside && h_vk < verse_count && verse_begin[h_vk] > i && verse_begin[h_vk] < stop) stop = verse_begin[h_vk];
            // (On a line of its own a verse begins at its words: its
            // number, just before, goes in its span too.)
            if (!inside && open < 0 && run_style[k] == STYLE_VERSE && h_vk < verse_count && verse_begin[h_vk] == stop) {
                h_str("<span class=\"v\" data-v=\"");
                h_int(verse_num[h_vk]);
                h_str("\">");
                open = h_vk
            }
        }
        html_piece(c, i, stop, k);
        i = stop
    }
    if (open >= 0) h_str("</span>")
}

// Bytes a to e of out, all in run k.
html_piece(
    c: int,
    a: int,
    e: int,
    k: int
) {
    style: int = run_style[k];
    if (style == STYLE_VERSE) {
        // (The number, without the tabs of a verse on its own line.)
        p: int = a;
        z: int = e;
        while (p < z && out[p] as int == 9) p = p + 1;
        while (z > p && out[z - 1] as int == 9) z = z - 1;
        if (z > p) {
            h_str("<span class=\"vn\">");
            h_text(out, p, z);
            h_str("</span>")
        }
    } else if (style == STYLE_NOTE) {
        n: int = h_notes;
        if (n < len(h_note_at)) {
            h_note_at[n] = run_arg[k];
            h_note_verse[n] = verse_at(c, run_arg[k]);
            h_notes = n + 1
        }
        h_str("<a class=\"fn\" href=\"#f");
        h_int(c);
        h_byte(45);
        h_int(n + 1);
        h_str("\" data-act=\"fn\" data-f=\"");
        h_int(run_arg[k]);
        h_str("\" role=\"button\" aria-label=\"Footnote\">");
        h_text(out, a, e);
        h_str("</a>")
    } else if (style == STYLE_XREF) {
        h_str("<a class=\"ref\" href=\"");
        xref_unpack2(run_arg[k], run_arg2[k]);
        if (xr_book >= 0 && xr_book < books && xr_c >= 1) {
            rc: int = chapter_of(xr_book, xr_c);
            h_chapter_url(html_text, rc, xr_v, if (xr_ce == xr_c) xr_ve else 0)
        }
        h_str("\" data-act=\"ref\">");
        h_text(out, a, e);
        h_str("</a>")
    } else {
        cls: str = if (style == STYLE_CAPS) "sc" else if (style == STYLE_JESUS) "j" else if (style == STYLE_JESUS_CAPS) "j sc" else if (style == STYLE_SUPPLIED) "su" else if (style == STYLE_JESUS_SUPPLIED) "j su" else "";
        if (len(cls) > 0) {
            h_str("<span class=\"");
            h_str(cls);
            h_str("\">")
        }
        h_text(out, a, e);
        if (len(cls) > 0) h_str("</span>")
    }
}

// Chapter c's verse v by name: John 3:3, Jude 3, Psalm 3 (v 0, its title).
h_verse_ref(c: int, v: int) {
    b: int = ch_book[c];
    if (book_is(b, "PSA")) h_str("Psalm") else h_text(bsb, book_name_start(b), book_name_end(b));
    if (book_count[b] > 1) {
        h_byte(32);
        h_int(ch_num[c]);
        if (v > 0) {
            h_byte(58);
            h_int(v)
        }
    } else if (v > 0) {
        h_byte(32);
        h_int(v)
    }
}

// ---- a version's books ----
// Text t's books, each with its chapters as links, into hb: the book
// index page's content (/read/bsb/).
html_books(t: int) {
    h_str("<nav class=\"books\" aria-label=\"Books\">\n");
    for b in 0..books {
        h_str("<section><h2>");
        h_text(bsb, book_name_start(b), book_name_end(b));
        h_str("</h2><ol>");
        for n in 0..book_count[b] {
            h_str("<li><a href=\"");
            h_chapter_url(t, book_first[b] + n, 0, 0);
            h_str("\">");
            h_int(n + 1);
            h_str("</a></li>")
        }
        h_str("</ol></section>\n")
    }
    h_str("</nav>\n")
}
