tag bible_ios;

use_tag std, ios, bible;

// Share as Image (DESIGN.md §10.5): an action of the system's share sheet
// (a UIActivity of our own, L8ImageActivity) whose screen is the composer,
// a card of the verses shared in a shape and a theme; Share hands the
// card's image to a share sheet of its own, once the first has gone. The
// card is drawn by hand at its pixel size (UIGraphics' C calls, no block):
// the page's color, the verses in the reader's font, their reference and
// version under them, the two centered together.
import "../ios/objc.l8";

import "text.l8";

extern msg_rect2(
    receiver: int,
    selector: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    a: int,
    b: int
): int = objc_msgSend;

extern UIImagePNGRepresentation(image: int): int;

extern msg_perform(
    receiver: int,
    selector: int,
    action: int,
    object: int,
    delay: f64
): int = objc_msgSend;

// ---- the verses shared ----
sh_c: int = -1;

sh_v: []int = new int[200](0);

sh_n: int = 0;

// How many characters they have (their words).
sh_chars: int = 0;

// The verses a share sheet is about to show (kept for the activity).
share_keep(c: int, vs: []int, n: int) {
    sh_c = c;
    sh_n = (if (n > len(sh_v)) len(sh_v) else n);
    sh_chars = 0;
    for i in 0..sh_n {
        sh_v[i] = vs[i];
        verse_text(c, vs[i]);
        for x in 0..vt_n {
            k: int = vt[x] as int & 255;
            if (k < 128 || k >= 192) sh_chars = sh_chars + 1
        }
    }
}

// The share sheet's own actions (the app's): Share as Image.
share_activities(): int {
    one[0] = msg(make("L8ImageActivity"), sel("autorelease"));
    nsarray(one, 1)
}

// ---- the activity ----
image_activity_class: int = 0;

// The activity UIKit is showing (its composer's), while it is.
sh_activity: int = 0;

act_type(_self: int, _cmd: int): int {
    nsstring("space.trailingwhite.smoothbible.image")
}

act_title(_self: int, _cmd: int): int {
    nsstring("Share as Image")
}

act_image(_self: int, _cmd: int): int {
    symbol("photo", 22.0f64, 4, 0)
}

act_category(_self: int, _cmd: int): int {
    0
}

// At most 8 verses and 700 characters fit a card.
act_can(_self: int, _cmd: int, _items: int): int {
    if (sh_c >= 0 && sh_n > 0 && sh_n <= 8 && sh_chars <= 700) 1 else 0
}

act_prepare(_self: int, _cmd: int, _items: int): int {
    0
}

act_controller(self: int, _cmd: int): int {
    release(sh_activity);
    sh_activity = keep(self);
    make_composer()
}

// ---- the composer ----
composer_class: int = 0;

sh_nav: int = 0;

sh_view: int = 0;

// The card's frame (its shadow) and its image.
sh_frame: int = 0;

sh_image_view: int = 0;

sh_seg: int = 0;

sh_rings: []int = new int[5](0);

sh_swatches: []int = new int[5](0);

// The shape (0 square, 1 portrait) and theme (1 Paper to 5 Black) chosen.
sh_shape: int = 0;

sh_theme: int = 1;

// The card now (kept).
sh_card: int = 0;

// Whether the demo showed the composer itself (not UIKit, which it cannot
// tap): it puts it away itself then.
sh_by_demo: bool = false;

swatch_names: []str = ["Paper Background", "White Background", "Sepia Background",
    "Night Background", "Black Background"];

make_composer(): int {
    sh_shape = clamp(def_int("shareShape"), 0, 1);
    // (At first the reader's theme, Auto's being Paper or Night now.)
    sh_theme = def_int("shareTheme");
    if (sh_theme < 1 || sh_theme > 5) sh_theme = clamp(theme, 1, 5);
    vc: int = msg(make_of(composer_class), sel("autorelease"));
    msg1(vc, sel("setTitle:"), nsstring("Share Image"));
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    msg1(item, sel("setLeftBarButtonItem:"), system_item(1, "shareCancel:"));
    msg1(item, sel("setRightBarButtonItem:"), msg(msg4(msg(cls("UIBarButtonItem"),
        sel("alloc")), sel("initWithTitle:style:target:action:"), nsstring("Share"),
        2, app_obj, sel("shareDone:")), sel("autorelease")));
    view: int = msg(vc, sel("view"));
    sh_view = view;
    msg1(view, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("secondarySystemBackgroundColor")));
    // The card: a frame with its shadow, the image clipped to its corners.
    sh_frame = make("UIView");
    fl: int = msg(sh_frame, sel("layer"));
    msg1(fl, sel("setShadowColor:"), msg(msg(cls("UIColor"), sel("blackColor")), sel("CGColor")));
    msg_set_f32(fl, sel("setShadowOpacity:"), 0.12f64 as f32);
    msg_set_f(fl, sel("setShadowRadius:"), 16.0f64);
    msg_ff(fl, sel("setShadowOffset:"), 0.0f64, 4.0f64);
    sh_image_view = make("UIImageView");
    msg1(sh_image_view, sel("setContentMode:"), 1);
    msg1(sh_image_view, sel("setClipsToBounds:"), 1);
    il: int = msg(sh_image_view, sel("layer"));
    msg_set_f(il, sel("setCornerRadius:"), 14.0f64);
    curve: int = objc_const("kCACornerCurveContinuous");
    if (curve != 0) msg1(il, sel("setCornerCurve:"), curve);
    msg1(sh_image_view, sel("setIsAccessibilityElement:"), 1);
    msg1(sh_frame, sel("addSubview:"), sh_image_view);
    release(sh_image_view);
    msg1(view, sel("addSubview:"), sh_frame);
    release(sh_frame);
    // The shape, and the five themes.
    one[0] = nsstring("Square");
    one[1] = nsstring("Portrait");
    sh_seg = msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
        nsarray(one, 2));
    msg1(sh_seg, sel("setSelectedSegmentIndex:"), sh_shape);
    msg3(sh_seg, sel("addTarget:action:forControlEvents:"), app_obj, sel("shareShape:"),
        4096);
    msg1(view, sel("addSubview:"), sh_seg);
    release(sh_seg);
    for i in 0..5 {
        ring: int = make("UIView");
        rl: int = msg(ring, sel("layer"));
        msg_set_f(rl, sel("setCornerRadius:"), 23.0f64);
        msg_set_f(rl, sel("setBorderWidth:"), 2.5f64);
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTag:"), i + 1);
        msg1(b, sel("setBackgroundColor:"), color_hex(t_bg[i + 1], 1.0f64));
        bl: int = msg(b, sel("layer"));
        msg_set_f(bl, sel("setCornerRadius:"), 18.0f64);
        msg_set_f(bl, sel("setBorderWidth:"), 1.0f64);
        msg1(bl, sel("setBorderColor:"), msg(color_hex(t_rule[i + 1], t_rule_alpha[i + 1] + 0.1f64),
            sel("CGColor")));
        msg1(b, sel("setAccessibilityLabel:"), nsstring(swatch_names[i]));
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("shareTheme:"),
            64);
        msg_rect(b, sel("setFrame:"), 5.0f64, 5.0f64, 36.0f64, 36.0f64);
        msg1(ring, sel("addSubview:"), b);
        msg1(view, sel("addSubview:"), ring);
        sh_rings[i] = ring;
        sh_swatches[i] = b;
        release(ring)
    }
    share_rings();
    share_render(false);
    nav_sheet: int = msg(msg1(msg(cls("UINavigationController"), sel("alloc")), sel("initWithRootViewController:"),
        vc), sel("autorelease"));
    sh_nav = nav_sheet;
    nav_sheet
}

make_of(c: int): int {
    msg(msg(c, sel("alloc")), sel("init"))
}

// The accent ring on the theme chosen.
share_rings() {
    for i in 0..5 {
        msg1(msg(sh_rings[i], sel("layer")), sel("setBorderColor:"), msg(if (i + 1 == sh_theme) c_accent else msg(cls("UIColor"),
            sel("clearColor")), sel("CGColor")));
        msg1(sh_swatches[i], sel("setSelected:"), if (i + 1 == sh_theme) 1 else 0);
        msg1(sh_swatches[i], sel("setAccessibilityTraits:"), if (i + 1 == sh_theme) 9 else 1)
    }
}

// The composer laid out: the card as large as fits above the controls,
// 20 points from the edges; the shapes, then the themes, under it.
composer_layout(self: int, cmd: int): int {
    super0(self, composer_class, cmd);
    view: int = msg(self, sel("view"));
    l8_msg_hfa(hfa, view, sel("safeAreaInsets"), 0, 0, 0);
    top: f64 = hfa[0];
    bottom: f64 = hfa[2];
    W: f64 = view_width(view);
    H: f64 = view_height(view);
    controls: f64 = 32.0f64 + 20.0f64 + 46.0f64;
    room_h: f64 = H - top - bottom - 20.0f64 - 24.0f64 - controls - 24.0f64;
    aspect: f64 = if (sh_shape == 1) 1350.0f64 / 1080.0f64 else 1.0f64;
    w: f64 = W - 40.0f64;
    if (w * aspect > room_h) w = room_h / aspect;
    h: f64 = w * aspect;
    x: f64 = (W - w) / 2.0f64;
    y: f64 = top + 20.0f64;
    msg_rect(sh_frame, sel("setFrame:"), x, y, w, h);
    msg_rect(sh_image_view, sel("setFrame:"), 0.0f64, 0.0f64, w, h);
    y = y + h + 24.0f64;
    sw: f64 = if (W - 40.0f64 > 360.0f64) 360.0f64 else W - 40.0f64;
    msg_rect(sh_seg, sel("setFrame:"), (W - sw) / 2.0f64, y, sw, 32.0f64);
    y = y + 32.0f64 + 20.0f64;
    gap: f64 = 14.0f64;
    rw: f64 = 5.0f64 * 46.0f64 + 4.0f64 * gap;
    for i in 0..5 msg_rect(sh_rings[i], sel("setFrame:"), (W - rw) / 2.0f64 + i as f64 * (46.0f64 + gap),
        y, 46.0f64, 46.0f64);
    0
}

// The card drawn again (the preview cross-fading over 0.15 s, if asked).
share_render(fade: bool) {
    release(sh_card);
    sh_card = keep(share_card(sh_theme, sh_shape));
    if (fade) fade_layer(msg(sh_image_view, sel("layer")), 0.15f64);
    msg1(sh_image_view, sel("setImage:"), sh_card);
    fbuf_n = 0;
    for i in 0..sh_n {
        if (i > 0) fput(32);
        verse_text(sh_c, sh_v[i]);
        for x in 0..vt_n fput(vt[x] as int)
    }
    fput_str(", ");
    put_ref(sh_c, sh_v, sh_n);
    msg1(sh_image_view, sel("setAccessibilityLabel:"), fstring());
    if (sh_view != 0) msg(sh_view, sel("setNeedsLayout"))
}

share_shape(_self: int, _cmd: int, seg: int): int {
    sh_shape = msg(seg, sel("selectedSegmentIndex"));
    set_def_int("shareShape", sh_shape);
    share_render(true);
    if (sh_view != 0) msg(sh_view, sel("layoutIfNeeded"));
    0
}

share_theme(_self: int, _cmd: int, b: int): int {
    share_pick_theme(msg(b, sel("tag")));
    0
}

share_pick_theme(t: int) {
    sh_theme = t;
    set_def_int("shareTheme", t);
    haptic_select();
    share_rings();
    share_render(true)
}

// Cancel: the activity done, nothing shared.
share_cancel(_self: int, _cmd: int, _b: int): int {
    share_finish(false);
    0
}

// Share: the activity done (UIKit puts the composer away), and after
// 0.35 s the card's image in a share sheet of its own, from the reader.
share_done(_self: int, _cmd: int, _b: int): int {
    share_finish(true);
    msg_perform(app_obj, sel("performSelector:withObject:afterDelay:"), sel("shareImageNow:"),
        0, 0.35f64);
    0
}

share_finish(done: bool) {
    if (sh_by_demo) {
        sh_by_demo = false;
        msg2(nav, sel("dismissViewControllerAnimated:completion:"), 1, 0)
    } else if (sh_activity != 0) msg1(sh_activity, sel("activityDidFinish:"), if (done) 1 else 0);
    release(sh_activity);
    sh_activity = 0;
    sh_view = 0;
    sh_nav = 0
}

share_image_now(_self: int, _cmd: int, _object: int): int {
    if (sh_card == 0) return 0;
    help_used("share-image");
    if (presented() != 0) {
        msg_perform(app_obj, sel("performSelector:withObject:afterDelay:"), sel("shareImageNow:"),
            0, 0.15f64);
        return 0
    }
    one[0] = sh_card;
    vc: int = msg2(msg(cls("UIActivityViewController"), sel("alloc")), sel("initWithActivityItems:applicationActivities:"),
        nsarray(one, 1), 0);
    if (is_ipad()) share_source(vc, 0);
    bar_expand();
    msg3(nav, sel("presentViewController:animated:completion:"), vc, 1, 0);
    release(vc);
    0
}

// ---- the card ----
// Its text at size s (pixels): the verses' words in the reader's font, in
// the theme's ink, lines 1.35 high, poetry's lines kept (q2 in 40 px); LORD
// in small capitals, His words in red if the reader has them so; the verse
// numbers, faint and 0.6 as large, if there are several.
CARD_SIDE: f64 = 1080.0f64;

// Whether the card's words are the original's, and right to left.
card_orig: bool = false;

card_rtl: bool = false;

card_text(s: f64, t: int): int {
    a: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    ink: int = color_hex(t_ink[t], 1.0f64);
    faint: int = color_hex(t_faint[t], 1.0f64);
    red: int = color_hex(t_accent[t], 1.0f64);
    // (The version read, or the BSB's where its chapter is not here.)
    was: int = text_cur;
    if (ch_start[sh_c] < 0) text_use(TEXT_BSB);
    // (The Hebrew and Greek: New York, or SF Hebrew right to left;
    // §14.11.7.)
    card_orig = text_cur == TEXT_ORIG;
    card_rtl = card_orig && ch_book[sh_c] < 39;
    kind: int = PARA_PROSE;
    p: int = ch_start[sh_c];
    e_ch: int = ch_end[sh_c];
    inside: bool = false;
    words: bool = false;
    broke: bool = false;
    done: int = 0;
    while (p < e_ch) {
        e: int = line_end(p);
        k: int = bsb[p] as int;
        if (k == 86) {
            v: int = key_at(p + 1);
            was_in: bool = inside;
            inside = false;
            for i in 0..sh_n
                if (sh_v[i] == v) inside = true;
            if (inside && !was_in && done > 0 && words) broke = true;
            if (inside) {
                if (words && !broke) card_add(a, nsstring(" "), body(s), ink, kind,
                    s);
                if (broke && words) card_add(a, nsstring("\n"), body(s), ink, kind,
                    s);
                if (broke) broke = false;
                if (sh_n > 1) {
                    fbuf_n = 0;
                    fput_int(number_at(p + 1));
                    at: int = msg(a, sel("length"));
                    card_add(a, fstring(), body(s * 0.6f64), faint, kind, s);
                    msg4(a, sel("addAttribute:value:range:"), k_baseline, nsnumber_f(s * 0.3f64),
                        at, msg(a, sel("length")) - at);
                    card_add(a, ustr(8239, 0), body(s * 0.6f64), faint, kind, s)
                }
                done = done + 1;
                words = true
            }
        } else if (k == 80) {
            m: int = bsb[p + 1] as int;
            kind = (if (m == 49) PARA_Q1 else if (m == 50) PARA_Q2 else if (m == 108) PARA_L1 else if (m == 76) PARA_L2 else PARA_PROSE);
            if (inside && words) broke = true
        } else if (inside && (k == 84 || k == 87 || k == 73 || k == 74 || k == 72 || k == 88)) {
            if (broke) {
                card_add(a, nsstring("\n"), body(s), ink, kind, s);
                broke = false
            }
            text: int = nsstring_at(bytes_address(bsb) + p + 1, e - p - 1);
            at: int = msg(a, sel("length"));
            card_add(a, text, if (card_rtl) sans(s * 1.15f64, 0.0f64) else if (card_orig) new_york(s) else if (k == 73 || k == 74) italic(s) else body(s),
                if ((k == 87 || k == 74) && red_letter) red else ink, kind, s);
            if (!card_orig) caps_into(a, at, text, true, s);
            words = true
        } else if (inside && k != 70 && k != 95) broke = true;
        p = e + 1
    }
    text_use(was);
    a
}

card_add(
    a: int,
    text: int,
    font: int,
    color: int,
    kind: int,
    s: f64
) {
    keys[0] = k_font;
    values[0] = font;
    keys[1] = k_color;
    values[1] = color;
    keys[2] = k_para;
    indent: f64 = if (kind == PARA_Q2 || kind == PARA_L2) 40.0f64 else 0.0f64;
    values[2] = msg(para_style(0, indent, indent, 0.0f64, s * 0.25f64, if (card_rtl) 1.5f64 else 1.35f64),
        sel("autorelease"));
    if (card_rtl) {
        // (Right, not natural: drawn as a string, natural is the app's left
        // whatever the paragraph's direction; run 39573776932's 291b.)
        msg1(values[2], sel("setBaseWritingDirection:"), 1);
        msg1(values[2], sel("setAlignment:"), 2)
    }
    msg1(a, sel("appendAttributedString:"), msg(msg2(msg(cls("NSAttributedString"),
        sel("alloc")), sel("initWithString:attributes:"), text, nsdictionary(keys,
        values, 3)), sel("autorelease")))
}

// "John 3:16" (SF semibold 34, accent) then " BSB" (regular 30, faint).
card_ref(t: int): int {
    a: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    fbuf_n = 0;
    put_ref(sh_c, sh_v, sh_n);
    keys[0] = k_font;
    values[0] = sans(34.0f64, 0.3f64);
    keys[1] = k_color;
    values[1] = color_hex(t_accent[t], 1.0f64);
    msg1(a, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
        values, 2)));
    fbuf_n = 0;
    fput(32);
    fput_version_short(if (ch_start[sh_c] < 0) TEXT_BSB else text_cur, sh_c);
    values[0] = sans(30.0f64, 0.0f64);
    values[1] = color_hex(t_faint[t], 1.0f64);
    msg1(a, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
        values, 2)));
    // (Under Hebrew, at the right with it; still English, left to right.)
    // (card_rtl isn't set yet: the reference is measured before the text.)
    if (text_cur == TEXT_ORIG && ch_start[sh_c] >= 0 && ch_book[sh_c] < 39) {
        p: int = msg(make("NSMutableParagraphStyle"), sel("autorelease"));
        msg1(p, sel("setAlignment:"), 2);
        msg4(a, sel("addAttribute:value:range:"), k_para, p, 0, msg(a, sel("length")))
    }
    a
}

// The height of a text set w wide (as a label lays it out).
text_height(a: int, w: f64): f64 {
    l: int = make("UILabel");
    msg1(l, sel("setNumberOfLines:"), 0);
    msg1(l, sel("setAttributedText:"), a);
    msg_set_f(l, sel("setPreferredMaxLayoutWidth:"), w);
    l8_msg_hfa(hfa, l, sel("intrinsicContentSize"), 0, 0, 0);
    release(l);
    hfa[1]
}

// The card for theme t (1 to 5), square (1080 × 1080 px) or portrait
// (1080 × 1350), drawn at one pixel a point.
share_card(t: int, shape: int): int {
    W: f64 = CARD_SIDE;
    H: f64 = if (shape == 1) 1350.0f64 else CARD_SIDE;
    margin: f64 = 110.0f64;
    w: f64 = W - 2.0f64 * margin;
    ref: int = card_ref(t);
    ref_h: f64 = text_height(ref, w);
    room: f64 = H - 2.0f64 * margin - 44.0f64 - ref_h;
    // (The largest size, from 64 px down to 34 in steps of 2, that fits.)
    size: f64 = 64.0f64;
    text: int = card_text(size, t);
    text_h: f64 = text_height(text, w);
    while (size > 34.0f64 && text_h > room) {
        size = size - 2.0f64;
        text = card_text(size, t);
        text_h = text_height(text, w)
    }
    block: f64 = text_h + 44.0f64 + ref_h;
    top: f64 = (H - block) / 2.0f64;
    if (top < margin) top = margin;
    UIGraphicsBeginImageContextWithOptions(W, H, 1, 1.0f64);
    msg(color_hex(t_bg[t], 1.0f64), sel("setFill"));
    UIRectFill(0.0f64, 0.0f64, W, H);
    // (NSStringDrawingUsesLineFragmentOrigin.)
    msg_rect2(text, sel("drawWithRect:options:context:"), margin, top, w, text_h + 2.0f64,
        1, 0);
    msg_rect2(ref, sel("drawWithRect:options:context:"), margin, top + text_h + 44.0f64,
        w, ref_h + 2.0f64, 1, 0);
    image: int = UIGraphicsGetImageFromCurrentImageContext();
    UIGraphicsEndImageContext();
    note_num("bible: card size ", size as int);
    l8_msg_hfa(hfa, image, sel("size"), 0, 0, 0);
    note_num("bible: card w ", hfa[0] as int);
    note_num("bible: card h ", hfa[1] as int);
    image
}

// (The demo's: the card at full size, kept in Documents for the CI.)
share_card_save(name: str) {
    if (sh_card == 0) return;
    data: int = UIImagePNGRepresentation(sh_card);
    docs: int = msg(NSSearchPathForDirectoriesInDomains(9, 1, 1), sel("firstObject"));
    if (docs != 0 && data != 0) msg2(data, sel("writeToFile:atomically:"), msg1(docs,
        sel("stringByAppendingPathComponent:"), nsstring(name)), 1)
}

// ---- classes and methods ----
make_share_class() {
    k: int = objc_allocateClassPair(cls("UIActivity"), "L8ImageActivity", 0);
    add_method0(k, sel("activityType"), &act_type, "@@:");
    add_method0(k, sel("activityTitle"), &act_title, "@@:");
    add_method0(k, sel("activityImage"), &act_image, "@@:");
    add_method1(k, sel("canPerformWithActivityItems:"), &act_can, "B@:@");
    add_method1(k, sel("prepareWithActivityItems:"), &act_prepare, "v@:@");
    add_method0(k, sel("activityViewController"), &act_controller, "@@:");
    add_method0(object_getClass(k), sel("activityCategory"), &act_category, "q@:");
    objc_registerClassPair(k);
    image_activity_class = k;
    composer_class = objc_allocateClassPair(cls("UIViewController"), "L8Composer",
        0);
    add_method0(composer_class, sel("viewDidLayoutSubviews"), &composer_layout, "v@:");
    objc_registerClassPair(composer_class)
}

add_share_methods(app: int) {
    add_method1(app, sel("shareShape:"), &share_shape, "v@:@");
    add_method1(app, sel("shareTheme:"), &share_theme, "v@:@");
    add_method1(app, sel("shareCancel:"), &share_cancel, "v@:@");
    add_method1(app, sel("shareDone:"), &share_done, "v@:@");
    add_method1(app, sel("shareImageNow:"), &share_image_now, "v@:@")
}
