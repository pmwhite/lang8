tag bible_ios;

use_tag std, ios, bible;

// Versions (DESIGN.md Â§9.3): the BSB and the public-domain versions bundled
// beside it (data/kjv.txt and the rest, mapped at first use, never all at
// launch), and the ESV online (ios_esv.l8). The current one is the reader's;
// it is chosen in the reading settings' first section, a screen of its own
// pushed there, and the reader switches in place: the same verse at the
// same height, the rows cross-fading. Marks, history and the place are by
// reference (the BSB's numbering), so they are every version's.
import "../ios/objc.l8";

import "text.l8";

// The versions' files (text t is version_files[t].txt in the bundle).
version_files: []str = ["bsb", "kjv", "web", "asv", "ylt", "", "orig"];

// What the Versions screen says under each name.
version_lines: []str = ["BSB \Â\· Modern, word-for-word and readable", "KJV \Â\· 1769 \Â\· The Authorized Version",
    "WEB \Â\· Modern, public domain", "ASV \Â\· 1901", "YLT \Â\· 1898 \Â\· Very literal",
    "ESV \Â\· Needs an internet connection", "The Hebrew Bible (Leningrad Codex) and the Greek New Testament, word by word from STEP Bible"];

// Whether a version marks the words of Jesus (W records): the ASV and the
// YLT do not.
version_red: []bool = [true, true, true, false, false, true, false];

// Text t, ready (mapped and indexed at its first use; the ESV's made of
// what is held).
ensure_text(t: int) {
    if (t < 0 || t >= TEXTS || tx_ready[t]) return;
    if (t == TEXT_ESV) {
        esv_open();
        return
    }
    t0: f64 = CFAbsoluteTimeGetCurrent();
    // (The Hebrew and Greek: its words first, which its text is counted
    // by, and what its glosses read: ios_orig.l8.)
    if (t == TEXT_ORIG && !orig_open()) return;
    buf: []i8 = lang_map(version_files[t], "txt");
    if (lang_mapped == 0) {
        note("bible: no version file");
        return
    }
    text_load(t, buf, lang_mapped);
    note_num("bible: version indexed, ms ", ((CFAbsoluteTimeGetCurrent() - t0) * 1000.0f64) as int)
}

// The version kept in the defaults (BSB, KJV, â€¦) as a text, or the BSB.
saved_version(): int {
    name: int = msg1(defaults(), sel("stringForKey:"), nsstring("version"));
    if (name == 0) return TEXT_BSB;
    for t in 0..TEXTS
        if ((msg1(name, sel("isEqualToString:"), nsstring(text_abbrs[t])) & 255) != 0) return t;
    TEXT_BSB
}

// At launch: the version read last, current (the BSB if it was the ESV and
// the ESV is not to be had now).
use_saved_version() {
    t: int = saved_version();
    if (t == TEXT_ESV && !esv_listed()) t = TEXT_BSB;
    ensure_text(t);
    if (tx_ready[t]) text_use(t)
}

// ---- switching in place (Â§9.3.3) ----
// Where the reader was before a switch, in the log: chapter, verse, and
// thousandths of em into it.
switch_note(what: str) {
    measure_place();
    note_num(what, cur * 1000000 + place_v * 1000 + place_frac)
}

// The reader in version t: the same verse at the same distance below the
// bar (or the nearest before it the version has), the table's layer
// cross-fading over the reload; selection cleared first, the tray leaving.
switch_version(t: int) {
    if (t == text_cur || t < 0 || t >= TEXTS) return;
    ensure_text(t);
    if (!tx_ready[t]) return;
    clear_selection();
    switch_place();
    c: int = sw_c;
    v: int = sw_v;
    f: int = sw_f;
    note_num("bible: place before ", c * 1000000 + v * 1000 + f);
    // (Listening: the verse being read noted, the engine stopped, and the
    // new version's source started there, the player staying up: Â§12.3.6.)
    playing: bool = ls_active;
    listen_v: int = if (playing) listen_current_verse() else 0;
    listen_c: int = if (playing) speak_c else -1;
    if (playing) listen_stop_engine();
    text_use(t);
    msg2(defaults(), sel("setObject:forKey:"), nsstring(text_abbrs[t]), nsstring("version"));
    // (The notifications' words are the version's: scheduled again.)
    daily_reschedule();
    esv_wait_c = -1;
    // (A verse the version lacks: the nearest before it that it has.)
    if (v > 0 && !has_verse(c, v) && ch_start[c] >= 0) {
        x: int = v - 1;
        while (x > 0 && !has_verse(c, x)) x = x - 1;
        if (x != v) f = 0;
        v = x
    }
    // (Asked for: a glide stops here.)
    stop_moving();
    fade_layer(msg(table, sel("layer")), if (reduce_motion()) 0.15f64 else 0.25f64);
    msg(table, sel("reloadData"));
    msg(table, sel("layoutIfNeeded"));
    if (t == TEXT_ESV && ch_start[c] < 0) {
        // (Not here yet: at its row's top; the place follows the text.)
        esv_wait_c = c;
        esv_wait_v = v;
        esv_wait_f = f;
        go_place(c, 0, 0)
    } else go_place(c, v, f);
    save_place();
    switch_place();
    note_num("bible: place after ", sw_c * 1000000 + sw_v * 1000 + sw_f);
    set_title();
    if (settings_table != 0) msg(settings_table, sel("reloadData"));
    if (playing && listen_c >= 0) {
        // (The verse kept by reference: one the version lacks, the nearest
        // before it that it has.)
        lv: int = if (listen_v > 0) listen_v else 1;
        if (ch_start[listen_c] >= 0) {
            while (lv > 1 && !has_verse(listen_c, lv)) lv = lv - 1
        }
        listen_restart_at(listen_c, lv)
    }
    if (t == TEXT_ESV) esv_reader_wants()
}

// The place at the top, measured as go_place goes to it: the chapter, the
// last verse whose beginning is at or above the bar's foot, and how far
// below it the bar's foot is (thousandths of em).
sw_c: int = 0;

sw_v: int = 0;

sw_f: int = 0;

switch_place() {
    find_place();
    c: int = cur;
    top: f64 = offset_y(table) + top_inset(table);
    sw_c = c;
    sw_v = 0;
    sw_f = ((top - row_y(c)) * 1000.0f64 / em) as int;
    tv: int = view_of(c);
    if (tv == 0) return;
    compute_ranges(c);
    ry: f64 = row_y(c);
    for i in 0..rv_count {
        if (range_rect(tv, rv_b[i], 1)) {
            // (hfa read before anything else asks for it.)
            y: f64 = ry + hfa[1];
            if (y <= top + 1.0f64) {
                sw_v = rv_num[i];
                sw_f = ((top - y) * 1000.0f64 / em) as int
            }
        }
    }
}

// ---- the reading settings' Version section ----
// Its one row: Version, the version's abbreviation, a disclosure.
version_cell(t: int): int {
    cell: int = list_cell(t, "version", 1);
    config: int = list_config(1);
    msg1(config, sel("setText:"), nsstring("Version"));
    msg1(config, sel("setSecondaryText:"), nsstring(text_abbrs[text_cur]));
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(detail_props(config), sel("setColor:"), c_faint);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryType:"), 1);
    msg1(cell, sel("setSelectionStyle:"), 3);
    fbuf_n = 0;
    fput_str("Version, ");
    fput_str(text_names[text_cur]);
    msg1(cell, sel("setAccessibilityLabel:"), fstring());
    msg1(cell, sel("setAccessibilityHint:"), nsstring("Choose a translation"));
    cell
}

version_footer(): int {
    if (text_cur == TEXT_ORIG) return nsstring("A word you haven\â\€\™t learned is glossed under its paragraph with the BSB\â\€\™s words for it there. Tap a gloss for the word.");
    nsstring("Study, the interlinear and the concordance always use the BSB.")
}

// The Show section's footer: what the version cannot show.
show_footer(): int {
    if (text_cur == TEXT_ORIG) return nsstring("The Hebrew and Greek has no headings or footnotes, and doesn\â\€\™t mark the words of Jesus.");
    if (version_red[text_cur]) return 0;
    fbuf_n = 0;
    fput_str("The ");
    fput_str(text_abbrs[text_cur]);
    fput_str(" doesn\â\€\™t mark the words of Jesus.");
    fstring()
}

// ---- the Versions screen (Â§9.3.2) ----
versions_table: int = 0;

versions_vc: int = 0;

open_versions() {
    if (settings_nav == 0) return;
    vc: int = msg(msg1(msg(cls("UITableViewController"), sel("alloc")), sel("initWithStyle:"),
        2), sel("autorelease"));
    msg1(vc, sel("setTitle:"), nsstring("Version"));
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    msg1(item, sel("setRightBarButtonItem:"), system_item(0, "closeSheet:"));
    versions_vc = vc;
    // (Kept while the sheet is up: popped, its table would otherwise be
    // freed under the theme's and the ESV's later updates.)
    release(versions_table);
    versions_table = keep(msg(vc, sel("tableView")));
    msg1(versions_table, sel("setDataSource:"), app_obj);
    msg1(versions_table, sel("setDelegate:"), app_obj);
    style_table(versions_table, true);
    msg2(settings_nav, sel("pushViewController:animated:"), vc, 1)
}

// On This iPhone, Original Languages (the Hebrew and Greek, Â§14.11.2),
// and Online (the ESV, only once our server has said it can give it:
// ios_esv.l8).
versions_sections(): int {
    if (esv_listed()) 3 else 2
}

versions_rows(s: int): int {
    if (s == 0) 5 else 1
}

versions_header(s: int): int {
    nsstring(if (s == 0) "On This iPhone" else if (s == 1) "Original Languages" else "Online")
}

// A row's version, and a version's section and row.
versions_text(s: int, r: int): int {
    if (s == 0) r else if (s == 1) TEXT_ORIG else TEXT_ESV
}

versions_section_of(t: int): int {
    if (t == TEXT_ORIG) 1 else if (t == TEXT_ESV) 2 else 0
}

versions_footer(s: int): int {
    if (s < 2) return 0;
    nsstring("The ESV comes from Crossway\â\€\™s ESV API. Only the chapters you\â\€\™re reading are kept on this iPhone.")
}

versions_cell(tv: int, path: int): int {
    s: int = msg(path, sel("section"));
    t: int = versions_text(s, msg(path, sel("row")));
    cell: int = list_cell(tv, "versionrow", 2);
    config: int = list_config(2);
    msg1(config, sel("setText:"), nsstring(text_names[t]));
    msg1(config, sel("setSecondaryText:"), nsstring(version_lines[t]));
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(text_props(config), sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleBody")));
    msg1(detail_props(config), sel("setColor:"), c_faint);
    msg1(detail_props(config), sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleFootnote")));
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setTintColor:"), c_accent);
    msg1(cell, sel("setAccessoryType:"), if (t == text_cur) 3 else 0);
    msg1(cell, sel("setSelectionStyle:"), 3);
    // (Read as it is shown, its dots as pauses.)
    fbuf_n = 0;
    fput_str(text_names[t]);
    fput_str(", ");
    line: str = version_lines[t];
    i: int = 0;
    while (i < len(line)) {
        k: int = line[i] as int & 255;
        if (k == 194 && i + 1 < len(line) && (line[i + 1] as int & 255) == 183) {
            // (" Â· " as ", ".)
            if (fbuf_n > 0 && fbuf[fbuf_n - 1] as int == 32) fbuf_n = fbuf_n - 1;
            fput(44);
            i = i + 2
        } else {
            fput(k);
            i = i + 1
        }
    }
    msg1(cell, sel("setAccessibilityLabel:"), fstring());
    msg1(cell, sel("setAccessibilityTraits:"), if (t == text_cur) objc_const("UIAccessibilityTraitSelected") else 0);
    cell
}

// A version tapped: the reader switched behind the sheet, the checkmark
// moved (the two rows faded), a tick; the screen stays.
versions_picked(s: int, r: int) {
    t: int = versions_text(s, r);
    if (t == text_cur) return;
    was: int = text_cur;
    haptic_select();
    switch_version(t);
    if (versions_table == 0) return;
    fade_layer(msg(versions_table, sel("layer")), 0.15f64);
    one[0] = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), if (was >= TEXT_ESV) 0 else was,
        versions_section_of(was));
    one[1] = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), if (t >= TEXT_ESV) 0 else t,
        versions_section_of(t));
    if (was == TEXT_ESV && !esv_listed()) msg(versions_table, sel("reloadData")) else msg2(versions_table,
        sel("reloadRowsAtIndexPaths:withRowAnimation:"), nsarray(one, 2), 5)
}

// Every version loaded that a mark's quote might need: if any mark is on
// a verse the BSB lacks (KJV Matthew 17:21), the bundled versions, so the
// Library and the export can quote it (Â§9.1.3).
ensure_quotable() {
    need: bool = false;
    for i in 0..hl_n
        if (!need && !text_has(TEXT_BSB, key_chapter(hl_key[i]), key_verse(hl_key[i]))) need = true;
    for i in 0..bm_n
        if (!need && !text_has(TEXT_BSB, key_chapter(bm_key[i]), key_verse(bm_key[i]))) need = true;
    for i in 0..nt_n {
        v: int = key_verse(nt_key[i]);
        if (!need && v > 0 && !text_has(TEXT_BSB, key_chapter(nt_key[i]), v)) need = true
    }
    if (!need) return;
    for t in 1..TEXT_ESV ensure_text(t)
}

// ---- the version's own rows in Reading settings (the Hebrew and Greek's:
// Glosses and Show Accents, Â§14.11.3â€“Â§14.11.4) ----
version_rows(): int {
    if (text_cur == TEXT_ORIG) 3 else 1
}
