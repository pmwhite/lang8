tag bible_readings_tests;

use_tag std, bible;

// What you are reading (readings.l8, DESIGN.md §11.1): how a reading
// starts, moves and meets another, ends and is removed; read.tsv and
// readings.tsv read back; the readings seeded from history; and what a row
// says. Every time is fixed: T0 is 2026-10-19 08:00 (UTC, the offset 0).
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "plans.l8";

import "readings.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

loaded: bool = false;

load() noregion {
    if (loaded) return;
    loaded = true;
    fd: int = open("programs/bible/data/bsb.txt", 0, 0);
    n: int = 8388608;
    bsb = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, bsb, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    bible_index(got);
    text_load(TEXT_BSB, bsb, got);
    plans_make()
}

T0: int = 1792396800;

H: int = 3600;

today0(): int {
    days_from_civil(2026, 10, 19)
}

// Nothing read, no readings, no plan.
fresh() noregion {
    load();
    rg_n = 0;
    rg_cleared = 0;
    rlog_n = 0;
    rev_n = 0;
    hs_n = 0;
    plan_clear()
}

// Book code's chapter n.
ch(code: str, n: int): int {
    book_first[book_coded(code)] + n - 1
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

// Chapter x read at t (and what happened, said).
read_at(x: int, t: int) raises IoError {
    _r: bool = chapter_read(x, t, today0());
    events()
}

events() raises IoError {
    for i in 0..rev_n {
        fbuf_n = 0;
        fput_event(i);
        show_fbuf();
        print("")
    }
    rev_n = 0
}

// The readings, newest first: place, started, last (hours after T0).
show() raises IoError {
    if (rg_n == 0) print("(no readings)");
    for i in 0..rg_n {
        fbuf_n = 0;
        fput_reading_place(i);
        fput_str(" \�\� started ");
        fput_int((rg_started[i] - T0) / H);
        fput_str(" \�\� last ");
        fput_int((rg_last[i] - T0) / H);
        show_fbuf();
        print("")
    }
}

test "how a reading starts" {
    fresh();
    // Romans 1: a book's first chapter.
    read_at(ch("ROM", 1), T0);
    // Psalm 23 alone (a search's): nothing.
    read_at(ch("PSA", 23), T0 + H);
    // John 13 then 14, a week apart.
    read_at(ch("JHN", 13), T0 + 2 * H);
    read_at(ch("JHN", 14), T0 + 170 * H);
    // Malachi 4 then Matthew 1 (across books).
    read_at(ch("MAL", 4), T0 + 171 * H);
    read_at(ch("MAT", 1), T0 + 172 * H);
    show();
    expect {|
        reading started at ROM 2
        reading started at JHN 15
        reading started at MAT 2
        Matthew 2 · started 172 · last 172
        John 15 · started 170 · last 170
        Romans 2 · started 0 · last 0
    |}
}

test "a plan's chapters start nothing; one-chapter books; the end" {
    fresh();
    plan_begin(PLAN_YEAR, today0());
    // Genesis 1 as Bible in a Year's day 1.
    read_at(ch("GEN", 1), T0);
    // (A plan's chapter of a later day than tomorrow's does: Romans 1.)
    read_at(ch("ROM", 1), T0 + H);
    plan_clear();
    // Revelation 21 then 22: nothing after.
    read_at(ch("REV", 21), T0 + 2 * H);
    read_at(ch("REV", 22), T0 + 3 * H);
    // Jude alone; then 3 John and Jude.
    read_at(ch("JUD", 1), T0 + 4 * H);
    read_at(ch("3JN", 1), T0 + 5 * H);
    read_at(ch("JUD", 1), T0 + 6 * H);
    show();
    expect {|
        reading started at ROM 2
        reading started at REV 1
        Revelation 1 · started 6 · last 6
        Romans 2 · started 1 · last 1
    |}
}

test "rests and reading on move a reading" {
    fresh();
    rom: int = ch("ROM", 3);
    reading_start(rom, T0);
    events();
    // A rest in R.c, down and back up.
    _a: bool = reading_rest(rom, 9, 120, false, T0 + H);
    _b: bool = reading_rest(rom, 4, 0, false, T0 + 2 * H);
    events();
    show();
    // 19 s in Romans 4 (not dwelt): nothing; 20 s: there.
    _c: bool = reading_rest(rom + 1, 2, 0, false, T0 + 3 * H);
    show();
    _d: bool = reading_rest(rom + 1, 2, 0, true, T0 + 4 * H);
    events();
    show();
    // Across a book: Romans 16 dwelt in from 15.
    fresh();
    reading_start(ch("ROM", 15), T0);
    _e: bool = reading_rest(ch("1CO", 1), 0, 0, true, T0 + H);
    _f: bool = reading_rest(ch("ROM", 16), 3, 0, true, T0 + H);
    rev_n = 0;
    show();
    // Romans 16 read: 1 Corinthians 1.
    read_at(ch("ROM", 16), T0 + 2 * H);
    show();
    expect {|
        reading started at ROM 3 (chosen)
        reading moved to ROM 3:9
        reading moved to ROM 3:4
        Romans 3:4 · started 0 · last 2
        Romans 3:4 · started 0 · last 2
        reading moved to ROM 4:2
        Romans 4:2 · started 0 · last 4
        Romans 16:3 · started 0 · last 1
        reading moved to 1CO 1
        1 Corinthians 1 · started 0 · last 2
    |}
}

test "what does not move a reading" {
    fresh();
    reading_start(ch("ROM", 8), T0);
    reading_start(ch("JHN", 15), T0 + H);
    rev_n = 0;
    // A single chapter read further ahead (Romans 12), and one behind
    // (Romans 5): nothing moves.
    read_at(ch("ROM", 12), T0 + 2 * H);
    read_at(ch("ROM", 5), T0 + 3 * H);
    show();
    // Two in a row ahead (Romans 12, then 13): carried past the skipped.
    read_at(ch("ROM", 13), T0 + 4 * H);
    // John 15 read: only the John reading moves.
    read_at(ch("JHN", 15), T0 + 5 * H);
    show();
    expect {|
        John 15 · started 1 · last 1
        Romans 8 · started 0 · last 0
        reading moved to ROM 14
        reading moved to JHN 16
        John 16 · started 1 · last 5
        Romans 14 · started 0 · last 4
    |}
}

test "readings that meet become one" {
    fresh();
    reading_start(ch("JHN", 15), T0);
    reading_start(ch("JHN", 17), T0 - 48 * H);
    rev_n = 0;
    read_at(ch("JHN", 15), T0 + H);
    read_at(ch("JHN", 16), T0 + 2 * H);
    show();
    // Two in a row past another (Acts 4's, past Acts 9's): merged.
    fresh();
    reading_start(ch("ACT", 4), T0);
    reading_start(ch("ACT", 9), T0 + H);
    rev_n = 0;
    read_at(ch("ACT", 7), T0 + 2 * H);
    read_at(ch("ACT", 8), T0 + 3 * H);
    show();
    // Starting where one is: nothing new, it is touched.
    reading_start(ch("ACT", 9), T0 + 4 * H);
    rev_n = 0;
    show();
    expect {|
        reading moved to JHN 16
        reading moved to JHN 17
        readings met at JHN 17
        John 17 · started -48 · last 2
        reading moved to ACT 9
        readings met at ACT 9
        Acts 9 · started 0 · last 3
        Acts 9 · started 0 · last 4
    |}
}

test "the end, and removing" {
    fresh();
    reading_start(ch("REV", 22), T0);
    rev_n = 0;
    read_at(ch("REV", 22), T0 + H);
    show();
    // Removed: the run that made it starts nothing again; a new run, or a
    // first chapter, does.
    fresh();
    read_at(ch("EPH", 2), T0);
    read_at(ch("EPH", 3), T0 + H);
    reading_remove(0, T0 + 2 * H);
    events();
    write_int(1, (rg_cleared - T0) / H);
    print(" cleared");
    read_at(ch("EPH", 4), T0 + 3 * H);
    show();
    read_at(ch("EPH", 5), T0 + 4 * H);
    read_at(ch("GAL", 1), T0 + 5 * H);
    show();
    format_readings();
    show_fbuf();
    expect "reading reached the end\n(no readings)\nreading started at EPH 4\nreading removed at EPH 4\n2 cleared\n(no readings)\nreading started at EPH 6\nreading started at GAL 2\nGalatians 2 · started 5 · last 5\nEphesians 6 · started 4 · last 4\nREADING\tGAL\t2\t0\t0\t1792414800\t1792414800\nREADING\tEPH\t6\t0\t0\t1792411200\t1792411200\nCLEARED\t1792404000\n"
}

test "read.tsv" {
    fresh();
    read_at(ch("GEN", 3), T0);
    read_at(ch("GEN", 5), T0 + H);
    read_at(ch("GEN", 3), T0 + 2 * H);
    format_read_log();
    show_fbuf();
    // 300 at most: the oldest let go.
    for k in 0..310 read_log_add(k, T0 + k);
    write_int(1, rlog_n);
    write(1, " lines, the oldest ");
    write_int(1, rlog_c[0]);
    print("");
    // Read back, a bad line skipped.
    fbuf_n = 0;
    fput_str("""
GEN	1	1792396800
XYZ	1	5
GEN	99	5
GEN	2
EXO	4	1792396900
""");
    parse_read_log();
    write_int(1, lines_skipped);
    write(1, " skipped, ");
    write_int(1, rlog_n);
    print(" kept");
    // And readings.tsv's: a bad line skipped, two of a chapter merged.
    fbuf_n = 0;
    fput_str("""
READING	ROM	3	9	120	100	500
READING	ROM	3	2	0	50	400
READING	ROM	99	1	0	1	1
READING	ROM	4	x	0	1	1
CLEARED	77
""");
    parse_readings();
    write_int(1, lines_skipped);
    write(1, " skipped; ");
    format_readings();
    show_fbuf();
    expect "GEN\t5\t1792400400\nGEN\t3\t1792404000\n300 lines, the oldest 10\n3 skipped, 2 kept\n2 skipped; READING\tROM\t3\t9\t120\t50\t500\nCLEARED\t77\n"
}

test "seeded from history" {
    fresh();
    y21: int = T0 - 11 * H;
    // Acts 9:1 and 10:9 yesterday, Psalm 23, and two older than 30 days.
    history_add(ch("ACT", 9), 1, 0, true, y21);
    history_add(ch("PSA", 23), 1, 0, true, y21 + 600);
    history_add(ch("ACT", 10), 9, 0, true, y21 + 1200);
    history_add(ch("MAL", 4), 3, 0, false, T0 - 3 * 24 * H);
    history_add(ch("MAT", 1), 18, 0, false, T0 - 3 * 24 * H + 60);
    history_add(ch("EXO", 1), 1, 0, true, T0 - 31 * 24 * H);
    history_add(ch("EXO", 2), 1, 0, true, T0 - 31 * 24 * H + 60);
    history_add(ch("REV", 21), 1, 0, true, T0 - 2 * H);
    history_add(ch("REV", 22), 5, 0, true, T0 - H);
    seed_readings(T0);
    events();
    show();
    expect {|
        reading started at MAT 1
        reading started at ACT 10
        Acts 10:9 · started -10 · last -10
        Matthew 1 · started -71 · last -71
    |}
}

test "what a row says" {
    fresh();
    reading_start(ch("ROM", 3), T0 - 30);
    rg_v[0] = 9;
    reading_start(ch("PSA", 41), T0 - 3 * H);
    reading_start(ch("JUD", 1), T0 - 20 * H);
    reading_start(ch("1CO", 1), T0 - 4 * 24 * H);
    reading_start(ch("GEN", 12), T0 - 7 * 24 * H);
    reading_start(ch("EXO", 2), T0 - 300 * 24 * H);
    for i in 0..rg_n {
        fbuf_n = 0;
        fput_reading_place(i);
        fput_str(" \�\� ");
        fput_reading_line(i, T0, 0);
        fput_str(" | ");
        fput_reading_label(i, T0, 0);
        show_fbuf();
        print("")
    }
    expect {|
        Romans 3:9 · Chapter 3 of 16 · Now | Romans, chapter 3, verse 9. Chapter 3 of 16, read just now.
        Psalm 41 · Psalm 41 of 150 · Today | Psalm 41. Psalm 41 of 150, read today.
        Jude · Yesterday | Jude. Read yesterday.
        1 Corinthians 1 · Chapter 1 of 16 · Thursday | 1 Corinthians, chapter 1. Chapter 1 of 16, read on Thursday.
        Genesis 12 · Chapter 12 of 50 · 12 October | Genesis, chapter 12. Chapter 12 of 50, read on 12 October.
        Exodus 2 · Chapter 2 of 40 · 23 December 2025 | Exodus, chapter 2. Chapter 2 of 40, read on 23 December 2025.
    |}
}

test "a chapter a day" {
    load();
    plan_clear();
    rom: int = ch("ROM", 3);
    write_int(1, day1_days(rom));
    write(1, " days from Romans 3; Jude ");
    write_int(1, day1_days(ch("JUD", 1)));
    write(1, "; Romans 16 ");
    write_int(1, day1_days(ch("ROM", 16)));
    print("");
    _ok: bool = plan_day1_choose(rom);
    plan_begin(PLAN_DAY1, today0());
    fbuf_n = 0;
    fput_plan_name(PLAN_DAY1);
    fput_str(" \�\� ");
    fput_plan_blurb(PLAN_DAY1);
    fput_str(" \�\� day 1 ");
    fput_day(plan_day(PLAN_DAY1, 1));
    fput_str(", day 14 ");
    fput_day(plan_day(PLAN_DAY1, 14));
    show_fbuf();
    print("");
    // Kept and read back; a bad id skipped like a bad line.
    _m: bool = mark_chapter(rom + 1, 5, today0());
    format_plan();
    show_fbuf();
    parse_plan();
    write_int(1, plan_lengths[pl_active]);
    write(1, " days, Romans 4 ");
    print(if (pl_read[rom + 1]) "read" else "unread");
    for id in ["day1-JUD-1", "day1-ROM-99", "day1-XYZ-1", "day1-ROM"] {
        fbuf_n = 0;
        fput_str("PLAN\t");
        fput_str(id);
        fput_str("\t2026-10-19\n");
        parse_plan();
        write(1, id);
        write(1, ": ");
        write_int(1, pl_active);
        write(1, ", skipped ");
        write_int(1, lines_skipped);
        print("")
    }
    _p: bool = plan_day1_choose(ch("PSA", 23));
    fbuf_n = 0;
    fput_plan_name(PLAN_DAY1);
    fput_str(" \�\� ");
    fput_plan_blurb(PLAN_DAY1);
    show_fbuf();
    print("");
    expect "14 days from Romans 3; Jude 0; Romans 16 0\nRomans, a Chapter a Day · Romans 3–16, one chapter a day. · day 1 Romans 3, day 14 Romans 16\nPLAN\tday1-ROM-3\t2026-10-19\nREAD\tROM\t4\t5\n14 days, Romans 4 read\nday1-JUD-1: -1, skipped 1\nday1-ROM-99: -1, skipped 1\nday1-XYZ-1: -1, skipped 1\nday1-ROM: -1, skipped 1\nPsalms, a Psalm a Day · Psalms 23–150, one psalm a day.\n"
}
