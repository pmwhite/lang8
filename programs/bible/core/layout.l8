tag bible;

use_tag std;

import "text.l8";

// A chapter's destination, options, and scratch state. Each independent
// reader owns one; its buffers can be reused without allocating per chapter.
// The source and original-language tables are borrowed for rendering.
type ChapterLayout = {
    source: TextSource;
    // The chapter as runs in out's first out_n bytes: a divider (but before
    // Genesis 1); its book's name if the book begins here, then its number
    // (a book of one chapter has only the name); otherwise its label (JOHN,
    // PSALM) over its number; then its headings, paragraphs, verses and
    // footnotes' marks.
    out: []i8;
    out_n: int;
    runs: int;
    run_end: []int;
    run_style: []int;
    run_para: []int;
    // For a footnote's mark, where its F line is in the text; for a
    // reference, its start (and in run_arg2, its end).
    run_arg: []int;
    run_arg2: []int;
    // The verses laid out: their numbers, and where each is in out, from its
    // number (or its first word, if it has no number shown) to the end of
    // its last words or footnote's mark. verse_num is a verse's key (as marks
    // and selection know it), verse_shown the number it is shown with: the
    // same, but for the ESV's V15>14.
    verse_count: int;
    verse_num: []int;
    verse_shown: []int;
    verse_begin: []int;
    verse_end: []int;
    // Where the chapter's number is in out (or its book's name, for a book
    // of one chapter): the end of its heading.
    opener_at: int;
    // Where the chapter's label (JOHN; or its book's name, for chapter 1)
    // ends in out: a chapter's note's mark goes there.
    label_end: int;
    // Whether the chapter laid out is not here yet (the ESV's, not loaded):
    // its opener only, for the platform to put its placeholder under.
    lay_placeholder: bool;
    lay_verse_numbers: bool;
    lay_headings: bool;
    lay_notes: bool;
    lay_verse_lines: bool;
    // A chapter laid out in part, for a plan's day (DESIGN.md §16.2.1): its
    // verses lay_v1 to lay_v2 (0: from its start, to its end; each verse's
    // headings go with it), and whether it begins a passage (lay_passage: no
    // divider, label or book's name, the passage's heading above standing
    // for them). Begun mid-chapter, it has no opener, and its first verse's
    // number is shown.
    lay_v1: int;
    lay_v2: int;
    lay_passage: bool;
    lay_accents: bool;
    lay_orig: bool;
    lay_rtl: bool;
    // The original's words laid out: each one's letters in out (ow_b to
    // ow_e, the word ow_w), and whether it was glossed, for a word picked or
    // read aloud.
    ow_n: int;
    ow_b: []int;
    ow_e: []int;
    ow_w: []int;
    ow_gl: []bool;
    lay_fresh: bool;
    lay_ow: int;
    lay_prev_w: int;
    lay_prev_i: int;
    ap_n: int;
    ap_run0: int;
    ap_w: []int;
    ap_p: []int;
    ap_e: []int;
    og_acc_line: int;
    og_acc_w: int;
    xr_book: int;
    xr_c: int;
    xr_v: int;
    xr_ce: int;
    xr_ve: int;
    xn_end: int
}

// Allocate an independent destination in the caller's region. Options
// begin with the reader's current settings and can then be changed locally.
chapter_layout(): ChapterLayout@new {
    source: TextSource = text_source(text_cur);
    ChapterLayout {
        source: source,
        out: new i8[262144](0i8),
        out_n: 0,
        runs: 0,
        run_end: new int[8192](0),
        run_style: new int[8192](0),
        run_para: new int[8192](0),
        run_arg: new int[8192](0),
        run_arg2: new int[8192](0),
        verse_count: 0,
        verse_num: new int[200](0),
        verse_shown: new int[200](0),
        verse_begin: new int[200](0),
        verse_end: new int[200](0),
        opener_at: 0,
        label_end: 0,
        lay_placeholder: false,
        lay_verse_numbers: lay_verse_numbers,
        lay_headings: lay_headings,
        lay_notes: lay_notes,
        lay_verse_lines: lay_verse_lines,
        lay_v1: 0,
        lay_v2: 0,
        lay_passage: false,
        lay_accents: lay_accents,
        lay_orig: false,
        lay_rtl: false,
        ow_n: 0,
        ow_b: new int[OW_MOST](0),
        ow_e: new int[OW_MOST](0),
        ow_w: new int[OW_MOST](0),
        ow_gl: new bool[OW_MOST](false),
        lay_fresh: false,
        lay_ow: 0,
        lay_prev_w: -1,
        lay_prev_i: 0,
        ap_n: 0,
        ap_run0: -1,
        ap_w: new int[512](0),
        ap_p: new int[512](0),
        ap_e: new int[512](0),
        og_acc_line: -1,
        og_acc_w: 0,
        xr_book: -1,
        xr_c: 0,
        xr_v: 0,
        xr_ce: 0,
        xr_ve: 0,
        xn_end: 0
    }
}

// Render a complete chapter without selecting its version or touching
// any other layout. For a passage, set lay_v1, lay_v2, and lay_passage.
layout_chapter_from(source: TextSource@ctx, ctx: *ChapterLayout, c: int) {
    ctx.source = source;
    ctx.out_n = 0;
    ctx.runs = 0;
    ctx.verse_count = 0;
    ctx.opener_at = 0;
    ctx.label_end = 0;
    ctx.lay_fresh = false;
    ctx.lay_prev_w = -1;
    ctx.lay_prev_i = 0;
    ctx.og_acc_line = -1;
    ctx.og_acc_w = 0;
    layout_append(ctx, c)
}

// Book labels come from the rendered version, not the selected one.
source_book_name_start(source: *TextSource, b: int): int {
    source.book_lines[b] + 5
}

source_book_name_end(source: *TextSource, b: int): int {
    record_line_end(source.data, source.size, source.book_lines[b])
}

source_book_is(source: *TextSource, b: int, code: str): bool {
    p: int = source.book_lines[b] + 1;
    for i in 0..len(code)
        if (source.data[p + i] != code[i]) return false;
    true
}

// Resolve a heading's book name without changing parse_ref's result or
// scratch buffers. Exact aliases win; otherwise allow a full-name prefix.
heading_book(data: []i8, p: int, e: int): int {
    b: int = 0;
    a: int = 0;
    first: bool = true;
    prefix: int = -1;
    while (a < len(aliases)) {
        z: int = a;
        while (z < len(aliases) && aliases[z] as int != 32 && aliases[z] as int != 10) z = z + 1;
        i: int = p;
        j: int = a;
        same: bool = true;
        while (i < e && same) {
            k: int = data[i] as int;
            if (k != 32 && k != 46) {
                if (k >= 65 && k <= 90) k = k + 32;
                if (j >= z || aliases[j] as int != k) same = false else j = j + 1
            }
            i = i + 1
        }
        if (same && j > a) {
            if (j == z) return b;
            if (first && prefix < 0) prefix = b
        }
        first = z < len(aliases) && aliases[z] as int == 10;
        if (first) b = b + 1;
        a = z + 1
    }
    prefix
}

lay_begin(
    ctx: *ChapterLayout,
    style: int,
    para: int,
    arg: int
) {
    if (ctx.runs > 0 && !ctx.lay_fresh && ctx.run_style[ctx.runs - 1] == style && ctx.run_para[ctx.runs - 1] == para && style != STYLE_NOTE && style != STYLE_XREF && style != STYLE_APP_ENTRY) return;
    if (ctx.runs >= len(ctx.run_end)) return;
    ctx.lay_fresh = false;
    ctx.run_end[ctx.runs] = ctx.out_n;
    ctx.run_style[ctx.runs] = style;
    ctx.run_para[ctx.runs] = para;
    ctx.run_arg[ctx.runs] = arg;
    ctx.run_arg2[ctx.runs] = 0;
    ctx.runs = ctx.runs + 1
}

lay_byte(ctx: *ChapterLayout, c: int) {
    if (ctx.out_n >= len(ctx.out) || ctx.runs == 0) return;
    ctx.out[ctx.out_n] = c trunc i8;
    ctx.out_n = ctx.out_n + 1;
    ctx.run_end[ctx.runs - 1] = ctx.out_n
}

lay_str(ctx: *ChapterLayout, s: str) {
    for c in s lay_byte(ctx, c as int)
}

// The source's bytes from p to e.
lay_bytes(ctx: *ChapterLayout, p: int, e: int) {
    for i in p..e lay_byte(ctx, ctx.source.data[i] as int)
}

// The source's bytes from p to e, in capitals.
lay_upper(ctx: *ChapterLayout, p: int, e: int) {
    for i in p..e {
        k: int = ctx.source.data[i] as int;
        lay_byte(ctx, if (k >= 97 && k <= 122) k - 32 else k)
    }
}

lay_int(ctx: *ChapterLayout, n: int) {
    if (n >= 10) lay_int(ctx, n / 10);
    lay_byte(ctx, 48 + n % 10)
}

// Words from the source's p to e, in a paragraph of kind para: LORD and GOD with
// their capitals after the first as small capitals (the words of Jesus in
// their own styles).
lay_words(
    ctx: *ChapterLayout,
    p: int,
    e: int,
    para: int,
    jesus: bool
) {
    lay_words_as(ctx, p, e, para, jesus, false)
}

lay_words_as(
    ctx: *ChapterLayout,
    p: int,
    e: int,
    para: int,
    jesus: bool,
    supplied: bool
) {
    plain: int = if (supplied) if (jesus) STYLE_JESUS_SUPPLIED else STYLE_SUPPLIED else if (jesus) STYLE_JESUS else STYLE_BODY;
    caps: int = if (jesus) STYLE_JESUS_CAPS else STYLE_CAPS;
    i: int = p;
    // (The space that joins His words to the narration before them is the
    // narration's, not His: only the words take the red letter.)
    if (jesus && i < e && ctx.source.data[i] as int == 32) {
        lay_begin(ctx, STYLE_BODY, para, 0);
        while (i < e && ctx.source.data[i] as int == 32) {
            lay_byte(ctx, 32);
            i = i + 1
        }
    }
    lay_begin(ctx, plain, para, 0);
    while (i < e) {
        n: int = record_divine_at(ctx.source.data, i, e);
        if (n > 0) {
            lay_byte(ctx, ctx.source.data[i] as int);
            lay_begin(ctx, caps, para, 0);
            lay_bytes(ctx, i + 1, i + n);
            lay_begin(ctx, plain, para, 0);
            i = i + n
        } else {
            lay_byte(ctx, ctx.source.data[i] as int);
            i = i + 1
        }
    }
}

// A narrow space that does not break (U+202F), after a verse's number.
lay_narrow(ctx: *ChapterLayout) {
    lay_byte(ctx, 226);
    lay_byte(ctx, 128);
    lay_byte(ctx, 175)
}

// The object replacement character (U+FFFC), for the divider.
lay_object(ctx: *ChapterLayout) {
    lay_byte(ctx, 239);
    lay_byte(ctx, 191);
    lay_byte(ctx, 188)
}

// A verse begins (its key k, shown as n): a row of the verse table.
verse_open(ctx: *ChapterLayout, k: int, n: int) {
    if (ctx.verse_count >= len(ctx.verse_num)) return;
    ctx.verse_num[ctx.verse_count] = k;
    ctx.verse_shown[ctx.verse_count] = n;
    ctx.verse_begin[ctx.verse_count] = -1;
    ctx.verse_end[ctx.verse_count] = -1;
    ctx.verse_count = ctx.verse_count + 1
}

// The verse being laid out begins here, if it has not yet.
verse_here(ctx: *ChapterLayout) {
    if (ctx.verse_count > 0 && ctx.verse_begin[ctx.verse_count - 1] < 0) ctx.verse_begin[ctx.verse_count - 1] = ctx.out_n
}

// The verse being laid out goes on to here.
verse_on(ctx: *ChapterLayout) {
    if (ctx.verse_count > 0) ctx.verse_end[ctx.verse_count - 1] = ctx.out_n
}

layout_append(ctx: *ChapterLayout, c: int) {
    ctx.lay_placeholder = ctx.source.starts[c] < 0;
    b: int = ch_book[c];
    // (The Hebrew and Greek: its words one by one, from the chapter's first;
    // the Hebrew right to left.)
    ctx.lay_orig = ctx.source.version == TEXT_ORIG && og_n > 0 && c < len(og_ch_first);
    ctx.lay_rtl = ctx.lay_orig && b < 39;
    ctx.ow_n = 0;
    ctx.ap_n = 0;
    if (ctx.lay_orig) ctx.lay_ow = og_ch_first[c];
    first: bool = ch_num[c] == 1;
    single: bool = book_count[b] == 1;
    mid: bool = ctx.lay_v1 > 1;
    if (c > 0 && !ctx.lay_passage) {
        lay_begin(ctx, STYLE_RULE, PARA_CENTER, 0);
        lay_object(ctx);
        lay_byte(ctx, 10)
    }
    if (first && !ctx.lay_passage) {
        lay_begin(ctx, STYLE_BOOK, PARA_CENTER, 0);
        ctx.opener_at = ctx.out_n;
        lay_bytes(ctx, source_book_name_start(&ctx.source, b), source_book_name_end(&ctx.source,
            b));
        ctx.label_end = ctx.out_n;
        lay_byte(ctx, 10)
    }
    // (A major section, as Psalms' BOOK I, comes before the chapter it
    // begins with.)
    p: int = ctx.source.starts[c];
    while (p < ctx.source.ends[c] && (ctx.source.data[p] as int == 77 || ctx.source.data[p] as int == 109)) {
        e: int = record_line_end(ctx.source.data, ctx.source.size, p);
        if (ctx.lay_headings && !mid) {
            lay_begin(ctx, if (ctx.source.data[p] as int == 77) STYLE_MAJOR else STYLE_RANGE,
                PARA_CENTER, 0);
            lay_bytes(ctx, p + 1, e);
            lay_byte(ctx, 10)
        }
        p = e + 1
    }
    if (!first && !ctx.lay_passage) {
        lay_begin(ctx, STYLE_BOOKLABEL, PARA_CENTER, 0);
        if (source_book_is(&ctx.source, b, "PSA")) lay_str(ctx, "PSALM") else lay_upper(ctx,
            source_book_name_start(&ctx.source, b), source_book_name_end(&ctx.source,
            b));
        ctx.label_end = ctx.out_n;
        lay_byte(ctx, 10)
    }
    if (!single && !mid) {
        lay_begin(ctx, if (first) STYLE_NUMERAL1 else STYLE_NUMERAL, PARA_CENTER,
            0);
        ctx.opener_at = ctx.out_n;
        lay_int(ctx, ch_num[c]);
        lay_byte(ctx, 10)
    }
    // In a paragraph (and it has words), of what kind; a stanza's break
    // before the next; just after a heading; footnotes so far.
    open: bool = false;
    words: bool = false;
    kind: int = PARA_PROSE;
    gap: bool = false;
    headed: bool = true;
    notes: int = 0;
    lines: bool = ctx.lay_verse_lines;
    // In a psalm's title (which a footnote's mark may be inside).
    in_title: bool = false;
    e_ch: int = ctx.source.ends[c];
    if (mid && p < e_ch) {
        q: int = source_verse_block(&ctx.source, c, ctx.lay_v1);
        if (ctx.lay_orig) ctx.lay_ow = og_word_at(ctx, c, q);
        p = q
    }
    if (ctx.lay_v2 > 0 && p < e_ch) e_ch = source_verse_block(&ctx.source, c, ctx.lay_v2 + 1);
    while (p < e_ch) {
        e: int = record_line_end(ctx.source.data, ctx.source.size, p);
        k: int = ctx.source.data[p] as int;
        jesus: bool = k == 87 || k == 74;
        supplied: bool = k == 73 || k == 74;
        if (k == 87 || k == 73 || k == 74 || k == 72 || k == 88) k = 84;
        if (in_title && k != 70 && k != 100) {
            if (ctx.lay_headings) lay_byte(ctx, 10);
            in_title = false
        }
        if (in_title) {
            // A footnote's mark in the title, or the title going on.
            if (k == 70 && ctx.lay_notes && ctx.lay_headings) {
                lay_begin(ctx, STYLE_NOTE, PARA_PROSE, p);
                lay_byte(ctx, 97 + notes % 26);
                notes = notes + 1
            } else if (k == 100 && ctx.lay_headings) {
                lay_begin(ctx, STYLE_TITLE, PARA_PROSE, 0);
                lay_bytes(ctx, p + 1, e)
            }
        } else if (k == 80) {
            // P: a paragraph (in verses on lines of their own, only poetry's
            // and lists' lines break; prose runs on).
            m: int = ctx.source.data[p + 1] as int;
            pk: int = if (m == 49) PARA_Q1 else if (m == 50) PARA_Q2 else if (m == 108) PARA_L1 else if (m == 76) PARA_L2 else if (m == 99) PARA_CENTER else if (m == 114) PARA_RIGHT else PARA_PROSE;
            if (!lines || pk >= PARA_Q1 && pk <= PARA_L2) {
                if (open && words) lay_para_end(ctx);
                open = true;
                words = false;
                kind = pk;
                lay_para_open(ctx)
            } else if (open && words) {
                lay_begin(ctx, STYLE_BODY, kind, 0);
                lay_byte(ctx, 32)
            }
        } else if (k == 95) {
            // _: a stanza's break (none after a heading, which has its own space).
            if (!headed) gap = true
        } else if (k == 86 || k == 84 || k == 70) {
            if (!open) {
                open = true;
                words = false;
                lay_para_open(ctx)
            }
            if (k == 86) {
                // V: a verse's number (not the first's, but on a line of its
                // own).
                v: int = record_number_at(ctx.source.data, ctx.source.size, p + 1);
                verse_open(ctx, record_key_at(ctx.source.data, ctx.source.size, p + 1),
                    v);
                if (lines) {
                    if (words) lay_para_end(ctx);
                    lay_para_open(ctx);
                    words = false;
                    kind = PARA_VERSE
                }
                para: int = kind + (if (gap && !words) KINDS else 0);
                if (words) {
                    lay_begin(ctx, STYLE_BODY, para, 0);
                    lay_byte(ctx, 32)
                }
                if (lines) {
                    // (On a line of its own: the number right-aligned in
                    // the margin, between two tabs; the verse begins at its
                    // words.)
                    lay_begin(ctx, STYLE_VERSE, para, 0);
                    lay_byte(ctx, 9);
                    if (ctx.lay_verse_numbers) lay_int(ctx, v);
                    lay_byte(ctx, 9)
                } else if (ctx.lay_verse_numbers && v != 1) {
                    lay_begin(ctx, STYLE_VERSE, para, 0);
                    verse_here(ctx);
                    lay_int(ctx, v);
                    lay_narrow(ctx)
                }
            } else if (k == 84) {
                // T: words.
                para: int = kind + (if (gap && !words) KINDS else 0);
                verse_here(ctx);
                if (ctx.lay_orig) lay_orig_words(ctx, p + 1, e, para, false) else lay_words_as(ctx,
                    p + 1, e, para, jesus, supplied);
                verse_on(ctx);
                words = true;
                gap = false;
                headed = false
            } else if (ctx.lay_notes) {
                // F: a footnote's mark (a to z, then again).
                para: int = kind + (if (gap && !words) KINDS else 0);
                lay_begin(ctx, STYLE_NOTE, para, p);
                lay_byte(ctx, 97 + notes % 26);
                notes = notes + 1;
                verse_on(ctx)
            }
        } else if (k == 68 && ctx.lay_orig) {
            // A psalm's title in the original: its words, a paragraph of
            // their own (shown whatever the headings' switch says).
            if (open && words) lay_para_end(ctx);
            lay_para_open(ctx);
            lay_orig_words(ctx, p + 1, e, PARA_PROSE, true);
            lay_para_end(ctx);
            open = false;
            words = false;
            gap = false;
            headed = true
        } else {
            // A heading of some kind, on a line of its own.
            style: int = if (k == 83) STYLE_HEAD else if (k == 115) STYLE_SUBHEAD else if (k == 82) STYLE_REF else if (k == 68) STYLE_TITLE else if (k == 77) STYLE_MAJOR else if (k == 109) STYLE_RANGE else if (k == 65) STYLE_ACROSTIC else -1;
            if (style >= 0 && (ctx.lay_headings || !is_heading_line(k))) {
                if (open && words) lay_para_end(ctx);
                open = false;
                words = false;
                gap = false;
                headed = true;
                lay_begin(ctx, style, if (style == STYLE_MAJOR || style == STYLE_RANGE) PARA_CENTER else PARA_PROSE,
                    0);
                if (style == STYLE_REF) lay_refs(ctx, p + 1, e) else lay_bytes(ctx,
                    p + 1, e);
                // (A title's line ends after any footnote in it.)
                if (style == STYLE_TITLE) in_title = true else lay_byte(ctx, 10)
            } else if (style == STYLE_TITLE) in_title = true
        }
        p = e + 1
    }
    if (in_title && ctx.lay_headings) lay_byte(ctx, 10);
    if (open && words) lay_para_end(ctx)
}

// The first word at or after record p of chapter c.
og_word_at(ctx: *ChapterLayout, c: int, p: int): int {
    w: int = og_ch_first[c];
    q: int = ctx.source.starts[c];
    while (q < p && q < ctx.source.ends[c]) {
        e: int = record_line_end(ctx.source.data, ctx.source.size, q);
        if (og_words_line(ctx.source.data[q] as int)) w = w + record_og_count(ctx.source.data,
            q + 1, e, w);
        q = e + 1
    }
    w
}

// A paragraph of the original begins.
lay_para_open(ctx: *ChapterLayout) {
    ctx.ap_n = 0;
    ctx.ap_run0 = ctx.runs;
    if (ctx.lay_orig) ctx.lay_fresh = true
}

// A paragraph ends: its line, then (in the original) its apparatus.
lay_para_end(ctx: *ChapterLayout) {
    lay_byte(ctx, 10);
    if (ctx.lay_orig && ctx.ap_n > 0) lay_apparatus(ctx);
    ctx.ap_run0 = -1
}

// The apparatus: the paragraph set close above it (TIGHT), then each
// glossed word "form gloss", " · " between them, each a link to the word.
lay_apparatus(ctx: *ChapterLayout) {
    if (ctx.ap_run0 >= 0) {
        for r in ctx.ap_run0..ctx.runs
            if (ctx.run_para[r] < TIGHT) ctx.run_para[r] = ctx.run_para[r] + TIGHT
    }
    ctx.lay_fresh = true;
    for i in 0..ctx.ap_n {
        w: int = ctx.ap_w[i];
        // (A no-break space before the dot and between a form and its
        // gloss: a line ends after a dot, and the next entry starts the
        // next one whole; review r11-1.)
        if (i > 0) {
            lay_begin(ctx, STYLE_APPARATUS, PARA_PROSE, 0);
            lay_byte(ctx, 194);
            lay_byte(ctx, 160);
            lay_byte(ctx, 194);
            lay_byte(ctx, 183);
            lay_str(ctx, " ")
        }
        lay_begin(ctx, STYLE_APP_ENTRY, PARA_PROSE, w + 1);
        og_form_lay(ctx, w, ctx.ap_p[i], ctx.ap_e[i]);
        lay_byte(ctx, 194);
        lay_byte(ctx, 160);
        j: int = w - og_gl_first;
        for q in og_gt_b[j]..og_gt_e[j] lay_byte(ctx, og_gt[q] as int)
    }
    lay_begin(ctx, STYLE_APPARATUS, PARA_PROSE, 0);
    lay_byte(ctx, 10);
    ctx.ap_n = 0
}

// Word w's form (its letters, the source's p to e), the Hebrew isolated right to
// left (U+2067 ... U+2069).
og_form_lay(
    ctx: *ChapterLayout,
    w: int,
    p: int,
    e: int
) {
    if (!og_greek(w)) {
        lay_byte(ctx, 226);
        lay_byte(ctx, 129);
        lay_byte(ctx, 167)
    }
    lay_bytes(ctx, p, e);
    if (!og_greek(w)) {
        lay_byte(ctx, 226);
        lay_byte(ctx, 129);
        lay_byte(ctx, 169)
    }
}

// The words of a record of the original, the source's p to e, in a paragraph of
// kind para (a psalm's title's, if title): each its letters (glossed or
// not), its punctuation, a Qere's faint °; its letters kept in ow_b to
// ow_e; a word glossed onto the paragraph's apparatus, a lemma once.
lay_orig_words(
    ctx: *ChapterLayout,
    p: int,
    e: int,
    para: int,
    title: bool
) {
    plain: int = if (title) STYLE_OTITLE else STYLE_ORIG;
    glossy: int = if (title) STYLE_OTITLE_GL else STYLE_ORIG_GL;
    i: int = p;
    while (i < e) {
        if (ctx.source.data[i] as int == 32) {
            lay_begin(ctx, plain, para, 0);
            lay_byte(ctx, 32);
            i = i + 1
        } else {
            w: int = ctx.lay_ow;
            n: int = if (w < og_n) og_len(w) else e - i;
            if (n <= 0) n = e - i;
            we: int = if (i + n < e) i + n else e;
            le: int = letters_end_of(ctx.source.data, i, we);
            gl: bool = og_glossed(w);
            lay_begin(ctx, if (gl) glossy else plain, para, 0);
            b0: int = ctx.out_n;
            if (ctx.lay_accents && !og_greek(w) && og_acc_n > 0) og_lay_accented(ctx,
                i, le) else lay_bytes(ctx, i, le);
            if (ctx.ow_n < OW_MOST) {
                ctx.ow_b[ctx.ow_n] = b0;
                ctx.ow_e[ctx.ow_n] = ctx.out_n;
                ctx.ow_w[ctx.ow_n] = w;
                ctx.ow_gl[ctx.ow_n] = gl;
                ctx.ow_n = ctx.ow_n + 1
            }
            if (le < we) {
                lay_begin(ctx, plain, para, 0);
                lay_bytes(ctx, le, we)
            }
            if (w < og_n && (og_flags(w) & OG_QERE) != 0) {
                lay_begin(ctx, STYLE_QERE, para, 0);
                lay_byte(ctx, 194);
                lay_byte(ctx, 176)
            }
            if (gl) {
                // (With its neighbour whose English is its own too, as in
                // the text: "μὴ ἀπόληται shall not perish".)
                sh: int = og_sh[w - og_gl_first];
                ap_b: int = if ((sh & 1) != 0 && ctx.lay_prev_w == w - 1) ctx.lay_prev_i else i;
                ap_end: int = le;
                if ((sh & 2) != 0) {
                    nb: int = we;
                    while (nb < e && ctx.source.data[nb] as int == 32) nb = nb + 1;
                    if (nb < e) ap_end = letters_end_of(ctx.source.data, nb, if (nb + og_len(w + 1) < e) nb + og_len(w + 1) else e)
                }
                ap_add(ctx, w, ap_b, ap_end)
            }
            ctx.lay_prev_w = w;
            ctx.lay_prev_i = i;
            ctx.lay_ow = ctx.lay_ow + 1;
            i = we
        }
    }
}

ap_add(
    ctx: *ChapterLayout,
    w: int,
    p: int,
    e: int
) {
    j: int = w - og_gl_first;
    if (og_gt_e[j] <= og_gt_b[j]) return;
    for i in 0..ctx.ap_n
        if (og_gk[ctx.ap_w[i] - og_gl_first] == og_gk[j] && og_gk[j] != 0) return;
    if (ctx.ap_n < len(ctx.ap_w)) {
        ctx.ap_w[ctx.ap_n] = w;
        ctx.ap_p[ctx.ap_n] = p;
        ctx.ap_e[ctx.ap_n] = e;
        ctx.ap_n = ctx.ap_n + 1
    }
}

og_lay_accented(ctx: *ChapterLayout, p: int, e: int) {
    w: int = ctx.lay_ow;
    // (To word w's line, from the line kept, or from its chapter's.)
    if (ctx.og_acc_w > w || ctx.og_acc_line < 0 || w - ctx.og_acc_w > 64) {
        c: int = og_chapter_of(w);
        if (c < 0 || og_acc_ch[c] < 0) {
            lay_bytes(ctx, p, e);
            return
        }
        ctx.og_acc_line = og_acc_ch[c];
        ctx.og_acc_w = og_ch_first[c]
    }
    while (ctx.og_acc_w < w && ctx.og_acc_line < og_acc_n) {
        while (ctx.og_acc_line < og_acc_n && og_acc[ctx.og_acc_line] as int != 10) ctx.og_acc_line = ctx.og_acc_line + 1;
        ctx.og_acc_line = ctx.og_acc_line + 1;
        ctx.og_acc_w = ctx.og_acc_w + 1
    }
    q: int = ctx.og_acc_line;
    while (q < og_acc_n && og_acc[q] as int != 10) q = q + 1;
    // (Its sof pasuq is the text's punctuation, laid after.)
    if (q - 2 >= ctx.og_acc_line && (og_acc[q - 2] as int & 255) == 215 && (og_acc[q - 1] as int & 255) == 131) q = q - 2;
    for x in ctx.og_acc_line..q lay_byte(ctx, og_acc[x] as int)
}

xnum(ctx: *ChapterLayout, i: int, e: int): int {
    n: int = 0;
    j: int = i;
    while (j < e && is_digit(ctx.source.data[j] as int) && j - i < 6) {
        n = n * 10 + ctx.source.data[j] as int - 48;
        j = j + 1
    }
    ctx.xn_end = j;
    n
}

// A dash at the source's byte i (-, or an en or em dash): its length, or 0.
bsb_dash_at(ctx: *ChapterLayout, i: int, e: int): int {
    if (i < e && ctx.source.data[i] as int == 45) return 1;
    if (i + 2 < e && ub(ctx.source.data, i) == 226 && ub(ctx.source.data, i + 1) == 128 && (ub(ctx.source.data,
        i + 2) == 147 || ub(ctx.source.data, i + 2) == 148)) return 3;
    0
}

layout_xref_scan(ctx: *ChapterLayout, p: int, e: int): bool {
    ctx.xr_book = -1;
    // The book's name: up to the space before its chapter's number.
    q: int = p;
    name_e: int = -1;
    while (q < e && name_e < 0) {
        if (ctx.source.data[q] as int == 32 && q + 1 < e && is_digit(ctx.source.data[q + 1] as int) && q > p && is_letter(ctx.source.data[q - 1] as int)) name_e = q;
        q = q + 1
    }
    if (name_e < 0 || name_e - p >= 96) return false;
    b: int = heading_book(ctx.source.data, p, name_e);
    if (b < 0) return false;
    i: int = name_e + 1;
    c: int = xnum(ctx, i, e);
    i = ctx.xn_end;
    v: int = 0;
    ce: int = 0;
    ve: int = 0;
    if (i + 1 < e && ctx.source.data[i] as int == 58 && is_digit(ctx.source.data[i + 1] as int)) {
        v = xnum(ctx, i + 1, e);
        i = ctx.xn_end
    }
    d: int = bsb_dash_at(ctx, i, e);
    if (d > 0 && i + d < e && is_digit(ctx.source.data[i + d] as int)) {
        n: int = xnum(ctx, i + d, e);
        i = ctx.xn_end;
        if (i + 1 < e && ctx.source.data[i] as int == 58 && is_digit(ctx.source.data[i + 1] as int)) {
            ce = n;
            ve = xnum(ctx, i + 1, e);
            i = ctx.xn_end
        } else if (v > 0) {
            ce = c;
            ve = n
        } else ce = n
    }
    if (i != e) return false;
    if (c < 1 || c > book_count[b]) return false;
    // (A text of some books holds no verses of the others: their numbers
    // are taken as written.)
    some: bool = ctx.source.some;
    if (!some && v > ctx.source.verses[book_first[b] + c - 1]) return false;
    if (ce > 0) {
        if (ce < c || ce > book_count[b]) return false;
        if (!some && ve > ctx.source.verses[book_first[b] + ce - 1]) return false;
        if (ce == c && ve <= v) {
            ce = 0;
            ve = 0
        }
    }
    ctx.xr_book = b;
    ctx.xr_c = c;
    ctx.xr_v = v;
    ctx.xr_ce = ce;
    ctx.xr_ve = ve;
    true
}

// An R line's passages, from the source's p to e: "(John 1:1–5; Hebrews 11:1–3)",
// each reference a run of its own (STYLE_XREF), the rest STYLE_REF.
lay_refs(ctx: *ChapterLayout, p: int, e: int) {
    i: int = p;
    while (i < e) {
        // A part: to the next "; ", or the closing parenthesis.
        a: int = i;
        while (a < e && (ctx.source.data[a] as int == 40 || ctx.source.data[a] as int == 32 || ctx.source.data[a] as int == 59)) a = a + 1;
        z: int = a;
        while (z < e && ctx.source.data[z] as int != 59 && ctx.source.data[z] as int != 41) z = z + 1;
        if (a > i) {
            lay_begin(ctx, STYLE_REF, PARA_PROSE, 0);
            lay_bytes(ctx, i, a)
        }
        if (z > a && layout_xref_scan(ctx, a, z)) {
            lay_begin(ctx, STYLE_XREF, PARA_PROSE, ctx.xr_book * 16777216 + ctx.xr_c * 4096 + ctx.xr_v);
            ctx.run_arg2[ctx.runs - 1] = (if (ctx.xr_ce == 0) 0 else ctx.xr_ce * 4096 + ctx.xr_ve);
            lay_bytes(ctx, a, z)
        } else if (z > a) {
            lay_begin(ctx, STYLE_REF, PARA_PROSE, 0);
            lay_bytes(ctx, a, z)
        }
        // (The ; or ) after it.)
        if (z < e) {
            lay_begin(ctx, STYLE_REF, PARA_PROSE, 0);
            lay_byte(ctx, ctx.source.data[z] as int);
            z = z + 1
        }
        i = z
    }
}

// The first row keyed as verse v, or -1 when this version omits it.
layout_verse_find(ctx: *ChapterLayout, v: int): int {
    for i in 0..ctx.verse_count
        if (ctx.verse_num[i] == v) return i;
    -1
}
