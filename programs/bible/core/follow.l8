tag bible;

use_tag std;

// Following (SKINS.md, Panes: Linked): which of the two panes moves, and
// to where, so that what the top pane shows at its top edge has what is
// linked with it in sight in the bottom pane. The rules are the skins'
// (each moves its own panes), written here once: the L8 skins (the
// iPhone's, the terminal's) call them, and tools/link_cases.l8 writes cases
// from them that the others' tests must match. Nothing here knows a
// platform: positions are numbers down each pane's own content, in its own
// unit.
//
// The page is the top pane (beside the panel, the left one), the panel the
// bottom. A chapter's link map ties sections of one to sections of the
// other: a verse to the other version's verse; a verse to each comment on
// it, a comment to the run of verses it is on, and a chapter's top (above
// its first anchor) to the other's. It is symmetric: whichever
// pane a hand moves, and whatever either reads, the one rule holds: the
// section under the top pane's top edge (or, if nothing is linked with it,
// the linked section nearest the edge) has a section linked with it as
// much in sight in the bottom pane as can be (wholly, if it is shorter than
// the pane; filling the pane, if it is taller). While it does, nothing
// moves. When it doesn't, the pane the hand isn't moving moves by as
// little as makes it so (follow_bottom_move, follow_top_move), gliding
// there (follow_glide).

// The two panes: the page (the top one) and the panel's reader (the bottom
// one).
PANE_PAGE: int = 0;

PANE_PANEL: int = 1;

PANES: int = 2;

// How a pane moved, as the rules take it: by the app (a jump, a scroll of
// its own), by a finger or a key, or gliding after a finger.
PANE_MOVED_BY_APP: int = 0;

PANE_DRAGGED: int = 1;

PANE_GLIDING: int = 2;

// How a chapter's anchors go with the other pane's (`link C MODE`): verse
// by verse (two versions), or comment by comment (a commentary in either).
LINK_BY_VERSE: int = 0;

LINK_BY_COMMENT: int = 1;

// A chapter's link map (core's `link C MODE COMMENTS` and its `match I0
// I1 J` lines): by verse, the page's anchors i0 (i1 the same) go with the
// panel's anchor j; by comment, the version's anchors i0 to i1 go with the
// commentary's anchor j (the commentary in pane comments), in order.
type LinkMap = {
    mode: int;
    comments: int;
    i0: []int;
    i1: []int;
    j: []int
}

// One pane's chapter as it is laid out: where each of its anchors begins
// (known: whether it is laid out, or where it would be guessed), where the
// chapter begins and ends (each, known or not), and its em. A
// commentary's chapter in its run of chapters without comments (one part
// for them all) is that part, top to end.
type ChapterShape = {
    starts: []f64;
    known: []bool;
    top: f64;
    top_known: bool;
    end: f64;
    end_known: bool;
    em: f64
}

// The links following goes by: pairs of a section of the top pane (from
// its start to where the next begins) and a section of the bottom pane
// linked with it, in the order the maps give them.
type FollowLinks = {
    top_from: []f64;
    top_to: []f64;
    bottom_from: []f64;
    bottom_to: []f64;
    n: int
}

// Room for the links of chapters whose maps make most in all.
follow_links_new(most: int): FollowLinks@new {
    FollowLinks {
        top_from: new f64[most](0.0f64),
        top_to: new f64[most](0.0f64),
        bottom_from: new f64[most](0.0f64),
        bottom_to: new f64[most](0.0f64),
        n: 0
    }
}

// How many links a chapter's map can make: a match each, or, a version on
// the page beside a commentary, one for each verse of each comment's run
// (and one for a chapter without comments); and one for the chapters'
// tops.
follow_links_room(map: *LinkMap): int {
    if (map.mode != LINK_BY_COMMENT || map.comments != PANE_PANEL) return len(map.j) + 2;
    n: int = 2;
    for k in 0..len(map.j)
        if (map.i1[k] >= map.i0[k]) n = n + map.i1[k] - map.i0[k] + 1;
    n
}

// A chapter's links added, from both panes' shapes of it (each where both
// sections are laid out or guessed). By verse, each match's two verses. By
// comment, a version on the page: each verse a comment is on with that
// comment (a verse a commentator comes back to, with each comment on it); a
// commentary on the page: each comment with the run of verses it is on. A
// chapter of a commentary's run without comments: the version's chapter
// with the run's part. Either way, the chapters' tops (above their first
// anchors: a chapter's number and headings, a psalm's title, a
// commentary's introduction) with each other.
follow_links_add(
    links: *FollowLinks,
    map: *LinkMap,
    page: *ChapterShape,
    panel: *ChapterShape
) {
    if (map.mode == LINK_BY_COMMENT && len(map.j) == 0) {
        if (page.top_known && page.end_known && panel.top_known && panel.end_known && page.end > page.top && panel.end > panel.top) follow_link_put(links,
            page.top, page.end, panel.top, panel.end);
        return
    }
    top: FollowSection = follow_top_section(page);
    bottom: FollowSection = follow_top_section(panel);
    if (top.known && bottom.known) follow_link_put(links, top.from, top.to, bottom.from,
        bottom.to);
    if (map.mode == LINK_BY_VERSE) {
        for k in 0..len(map.j) follow_link_add(links, page, map.i0[k], map.i0[k],
            panel, map.j[k], map.j[k]);
        return
    }
    version_on_page: bool = map.comments == PANE_PANEL;
    for k in 0..len(map.j) {
        if (version_on_page) {
            for i in map.i0[k]..map.i1[k] + 1 follow_link_add(links, page, i, i, panel,
                map.j[k], map.j[k])
        } else follow_link_add(links, page, map.j[k], map.j[k], panel, map.i0[k],
            map.i1[k])
    }
}

// The link of the page's anchors i0 to i1 with the panel's j0 to j1, if
// both are known.
follow_link_add(
    links: *FollowLinks,
    page: *ChapterShape,
    i0: int,
    i1: int,
    panel: *ChapterShape,
    j0: int,
    j1: int
) {
    top: FollowSection = follow_section(page, i0, i1);
    bottom: FollowSection = follow_section(panel, j0, j1);
    if (top.known && bottom.known) follow_link_put(links, top.from, top.to, bottom.from,
        bottom.to)
}

follow_link_put(
    links: *FollowLinks,
    top_from: f64,
    top_to: f64,
    bottom_from: f64,
    bottom_to: f64
) {
    n: int = links.n;
    if (n >= len(links.top_from)) return;
    links.top_from[n] = top_from;
    links.top_to[n] = top_to;
    links.bottom_from[n] = bottom_from;
    links.bottom_to[n] = bottom_to;
    links.n = n + 1
}

// A section of a pane: anchors i0 to i1, from the first's start to where
// the one after the last begins (the chapter's end, after its last); known:
// whether both are.
type FollowSection = {
    from: f64;
    to: f64;
    known: bool
}

follow_section(shape: *ChapterShape, i0: int, i1: int): FollowSection {
    n: int = len(shape.starts);
    none: FollowSection = FollowSection { from: 0.0f64, to: 0.0f64, known: false };
    if (i0 < 0 || i1 < i0 || i1 >= n || !shape.known[i0]) return none;
    to_known: bool = if (i1 + 1 < n) shape.known[i1 + 1] else shape.end_known;
    to: f64 = if (i1 + 1 < n) shape.starts[i1 + 1] else shape.end;
    if (!to_known || to <= shape.starts[i0]) return none;
    FollowSection { from: shape.starts[i0], to: to, known: true }
}

// A chapter's top: from its top to its first anchor (known: whether both
// are, and it has height).
follow_top_section(shape: *ChapterShape): FollowSection {
    if (len(shape.starts) == 0 || !shape.top_known || !shape.known[0] || shape.starts[0] <= shape.top) return FollowSection { from: 0.0f64, to: 0.0f64, known: false };
    FollowSection { from: shape.top, to: shape.starts[0], known: true }
}

// ---- which pane moves, and to where ----
// What following does: nothing, or the pane that is to move scrolled so
// that the top of what of it is in sight is at top.
type FollowMove =
    | Stay
    | ScrollTo { top: f64 }

// How far from where it should be a pane may be and still count as there
// (half a point, as offsets round); and how near two sections' distances
// from the edge are to be the same section's.
FOLLOW_SLACK: f64 = 0.5f64;

FOLLOW_SAME: f64 = 0.001f64;

// The tops of a pane's sight, height tall, that show a section from to to
// as much as can be (wholly, if it is shorter; filling the sight, if it is
// taller): from least to most.
type FollowRange = {
    least: f64;
    most: f64
}

follow_range(from: f64, to: f64, height: f64): FollowRange {
    a: f64 = to - height;
    if (a < from) FollowRange { least: a, most: from } else FollowRange { least: from, most: a }
}

// Top, moved as little as puts it in range.
follow_clamp(top: f64, range: FollowRange): f64 {
    if (top < range.least) range.least else if (top > range.most) range.most else top
}

// The links of the top pane's section at its top edge (or, if none is
// linked with what is there, of the linked section nearest the edge): how
// far that section is from the edge (0: under it).
follow_nearest(links: *FollowLinks, edge: f64): f64 {
    best: f64 = -1.0f64;
    for k in 0..links.n {
        d: f64 = follow_distance(links.top_from[k], links.top_to[k], edge);
        if (best < 0.0f64 || d < best) best = d
    }
    best
}

follow_distance(from: f64, to: f64, at: f64): f64 {
    if (at < from) from - at else if (at >= to) at - to + FOLLOW_SLACK else 0.0f64
}

// The top pane moved by a hand (or a jump): where the bottom pane goes,
// its sight bottom_height tall, its top now at bottom_top. Of the sections
// linked with the top pane's section at its edge (top_edge), the one the
// bottom pane needs to move least for; nothing if that is not at all.
follow_bottom_move(
    links: *FollowLinks,
    top_edge: f64,
    bottom_top: f64,
    bottom_height: f64
): FollowMove {
    nearest: f64 = follow_nearest(links, top_edge);
    if (nearest < 0.0f64) return FollowMove.Stay;
    best: f64 = bottom_top;
    found: bool = false;
    for k in 0..links.n {
        if (follow_distance(links.top_from[k], links.top_to[k], top_edge) <= nearest + FOLLOW_SAME) {
            to: f64 = follow_clamp(bottom_top, follow_range(links.bottom_from[k],
                links.bottom_to[k], bottom_height));
            if (!found || follow_abs(to - bottom_top) < follow_abs(best - bottom_top)) best = to;
            found = true
        }
    }
    if (follow_abs(best - bottom_top) <= FOLLOW_SLACK) FollowMove.Stay else FollowMove.ScrollTo { top: best }
}

// The bottom pane moved by a hand: where the top pane goes, its sight
// top_height tall and its top (its edge) at top_top. Nowhere while its
// section at the edge has one linked with it in sight below as it should
// be; else the least move that puts at its edge a section with one linked
// in sight below (its start at the edge, if it is shorter than the pane;
// the pane filled with it, if it is taller); none being so, one whose
// linked section shows most below; none showing at all, nowhere.
follow_top_move(
    links: *FollowLinks,
    top_top: f64,
    top_height: f64,
    bottom_top: f64,
    bottom_height: f64
): FollowMove {
    nearest: f64 = follow_nearest(links, top_top);
    if (nearest < 0.0f64) return FollowMove.Stay;
    for k in 0..links.n {
        if (follow_distance(links.top_from[k], links.top_to[k], top_top) <= nearest + FOLLOW_SAME && follow_in_sight(links,
            k, bottom_top, bottom_height)) return FollowMove.Stay
    }
    best: f64 = top_top;
    found: bool = false;
    for k in 0..links.n {
        if (follow_in_sight(links, k, bottom_top, bottom_height)) {
            to: f64 = follow_top_for(links, k, top_top, top_height);
            if (!found || follow_abs(to - top_top) < follow_abs(best - top_top)) best = to;
            found = true
        }
    }
    if (!found) {
        // (None as it should be: of those showing most below, the nearest.)
        most: f64 = 0.0f64;
        for k in 0..links.n {
            shown: f64 = follow_overlap(links.bottom_from[k], links.bottom_to[k],
                bottom_top, bottom_top + bottom_height);
            if (shown > most) most = shown
        }
        for k in 0..links.n {
            shown: f64 = follow_overlap(links.bottom_from[k], links.bottom_to[k],
                bottom_top, bottom_top + bottom_height);
            if (most > 0.0f64 && shown >= most - FOLLOW_SLACK) {
                to: f64 = follow_top_for(links, k, top_top, top_height);
                if (!found || follow_abs(to - top_top) < follow_abs(best - top_top)) best = to;
                found = true
            }
        }
    }
    if (!found || follow_abs(best - top_top) <= FOLLOW_SLACK) FollowMove.Stay else FollowMove.ScrollTo { top: best }
}

// Whether link k's bottom section is in the bottom pane's sight as it
// should be.
follow_in_sight(
    links: *FollowLinks,
    k: int,
    bottom_top: f64,
    bottom_height: f64
): bool {
    to: f64 = follow_clamp(bottom_top, follow_range(links.bottom_from[k], links.bottom_to[k],
        bottom_height));
    follow_abs(to - bottom_top) <= FOLLOW_SLACK
}

// The top pane's top moved as little as puts link k's top section at its
// edge and as much of it in sight as can be.
follow_top_for(
    links: *FollowLinks,
    k: int,
    top_top: f64,
    top_height: f64
): f64 {
    from: f64 = links.top_from[k];
    to: f64 = links.top_to[k];
    most: f64 = if (to - top_height > from) to - top_height else from;
    follow_clamp(top_top, FollowRange { least: from, most: most })
}

follow_overlap(
    a: f64,
    b: f64,
    c: f64,
    d: f64
): f64 {
    low: f64 = if (a > c) a else c;
    high: f64 = if (b < d) b else d;
    if (high > low) high - low else 0.0f64
}

follow_abs(x: f64): f64 {
    if (x < 0.0f64) -x else x
}

// ---- gliding ----
// A pane gliding to its place, as a critically damped spring (the form of
// Unity's SmoothDamp, stable however long a frame is): from at, moving at
// velocity (points a second), toward to. From rest it eases in (never a
// kick of speed in its first frame), closes most of the way in about
// FOLLOW_GLIDE_SECONDS times three, and slows to its place without passing
// it. A new place mid-glide is glided to from where the pane is, at the
// speed it has, so a place that moves frame by frame (the leader still
// moving) is followed as one smooth motion, not a step for each. The last
// half point at once.
FOLLOW_GLIDE_SECONDS: f64 = 0.1f64;

// Where a glide is after a frame, and how fast it is going.
type FollowGlide = {
    at: f64;
    velocity: f64
}

follow_glide(
    at: f64,
    to: f64,
    velocity: f64,
    seconds: f64
): FollowGlide {
    dt: f64 = if (seconds < 0.0f64) 0.0f64 else seconds;
    omega: f64 = 2.0f64 / FOLLOW_GLIDE_SECONDS;
    x: f64 = omega * dt;
    // (e^-x, near enough for any frame's x.)
    decay: f64 = 1.0f64 / (1.0f64 + x + 0.48f64 * x * x + 0.235f64 * x * x * x);
    change: f64 = at - to;
    pull: f64 = (velocity + omega * change) * dt;
    next_velocity: f64 = (velocity - omega * pull) * decay;
    next: f64 = to + (change + pull) * decay;
    // (Never past its place: there, and still.)
    if (change > 0.0f64 && next < to || change < 0.0f64 && next > to || follow_abs(next - to) <= FOLLOW_SLACK) return FollowGlide { at: to, velocity: 0.0f64 };
    FollowGlide { at: next, velocity: next_velocity }
}

// ---- a pane's place ----
// A place (SKINS.md, Panes: `C I FRAC`) and the reading line's position in
// a pane's chapter, each way, as every skin turns them (a `go` puts the
// line where the place is; `at` names the place the line is at), so that a
// pane sent somewhere tells that same place back, and two Swap Panes leave
// each document where it was. Anchor i's span runs from its start to the
// next's (the chapter's top before the first; its end after the last).

// How far below the line an anchor's start may be and still be the one
// the line is at: a fraction of a point, as a pane's offset moves when
// parts come in above it.
FOLLOW_PLACE_SLACK: f64 = 1.0f64;

// The position of anchor i's span frac thousandths through it (i -1: the
// span above the chapter's first anchor).
follow_place_y(shape: *ChapterShape, i: int, frac: int): f64 {
    a: f64 = if (i < 0) shape.top else shape.starts[i];
    b: f64 = if (i + 1 < len(shape.starts)) shape.starts[i + 1] else shape.end;
    a + (b - a) * frac as f64 / 1000.0f64
}

// The place at position line: its anchor (-1: above the first) and how
// far through its span, in thousandths, rounded.
type LinePlace = {
    i: int;
    frac: int
}

follow_line_place(shape: *ChapterShape, line: f64): LinePlace {
    i: int = -1;
    for k in 0..len(shape.starts)
        if (shape.starts[k] <= line + FOLLOW_PLACE_SLACK) i = k;
    a: f64 = if (i < 0) shape.top else shape.starts[i];
    b: f64 = if (i + 1 < len(shape.starts)) shape.starts[i + 1] else shape.end;
    frac: int = if (b - a < 1.0f64) 0 else ((line - a) / (b - a) * 1000.0f64 + 0.5f64) as int;
    LinePlace { i: i, frac: if (frac < 0) 0 else if (frac > 999) 999 else frac }
}
