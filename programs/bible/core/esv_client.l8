tag bible;

use_tag std;

// Asking for the ESV's chapters (DESIGN.md ยง9.4.11), apart from any
// platform: each chapter's state while it is not here, one request at a
// time (a newer one waiting replaces the one waiting), the client's own
// limit (past 20 requests in 60 s, only a chapter on the screen is asked
// for), holding off after a busy or daily-limit answer, and the reader's
// window (the chapter the reader lands in, L: the chapters wanted are L -
// 1 to L + 2, asked for L, L + 1, L + 2, then L - 1; a chapter on the
// screen first). The host makes each request (sk_host.fetch, SK_FETCH_ESV:
// the chapter, how many) and gives the answer back; the clock is the
// host's (seconds).
import "skin.l8";

SK_FETCH_ESV: int = 0;

// Each chapter's state (ESV_), and when it began loading (for a spinner's
// delay); chapters asked for Memory's pins alone (not the reader's).
esv_state: []int = static_buffer([1200]int);

esv_since: []f64 = static_buffer([1200]f64);

esv_pin_only: []bool = static_buffer([1200]bool);

// Not to ask again before this (busy, resting for today).
esv_hold_until: f64 = 0.0f64;

// The request running (its chapter, -1: none), and the one waiting.
esv_inflight: int = -1;

esv_queued: int = -1;

esv_queued_count: int = 1;

// The starts of the last 20 requests; the landing chapter (-1: none).
esv_req_t: []f64 = static_buffer([20]f64, -1000.0f64);

esv_req_i: int = 0;

esv_win_l: int = -1;

// Chapter c wanted (and count chapters from it): asked for, or queued.
esv_want_now(c: int, count: int, now: f64) {
    if (c < 0 || c >= chapters) return;
    // (The reader wants it too now: held as any other.)
    esv_pin_only[c] = false;
    if (!esv_wanted(c, time(0)) && (count < 2 || c + 1 >= chapters || !esv_wanted(c + 1,
        time(0)))) return;
    if (esv_inflight == c) return;
    if (now < esv_hold_until) return;
    if (esv_inflight >= 0) {
        // (The one it replaces is no longer on its way.)
        if (esv_queued >= 0 && esv_queued != c && esv_state[esv_queued] == ESV_LOADING) esv_state[esv_queued] = 0;
        esv_queued = c;
        esv_queued_count = count;
        esv_mark_loading(c, now);
        return
    }
    esv_ask(c, count, now)
}

esv_mark_loading(c: int, now: f64) {
    if (esv_state[c] != ESV_LOADING) {
        esv_state[c] = ESV_LOADING;
        esv_since[c] = now
    }
}

// The request made (the host's), counted for the client's limit.
esv_ask(c: int, count: int, now: f64) {
    esv_inflight = c;
    esv_mark_loading(c, now);
    esv_req_t[esv_req_i % len(esv_req_t)] = now;
    esv_req_i = esv_req_i + 1;
    f: ?fn(what: int, a: int, b: int): bool = sk_host.fetch;
    if (f == null) {
        esv_inflight = -1;
        esv_fail_states(c, count, ESV_OFFLINE, 0, now);
        return
    }
    _ok: bool = f(SK_FETCH_ESV, c, count)
}

// The next request: one asked for directly (whether there was one; else
// the host pumps the reader's next).
esv_next_queued(now: f64): bool {
    if (esv_inflight >= 0) return true;
    if (esv_queued < 0) return false;
    c: int = esv_queued;
    esv_queued = -1;
    esv_ask(c, esv_queued_count, now);
    true
}

esv_rate_ok(now: f64): bool {
    oldest: f64 = esv_req_t[esv_req_i % len(esv_req_t)];
    now - oldest >= 60.0f64
}

// Whether chapter c is the reader's to ask for now: wanted, not on its way
// or failed, and, if it is not on the screen, small enough and with room
// to be held ahead, within the client's limit.
esv_askable(c: int, on_screen: bool, now: f64): bool {
    if (c < 0 || c >= chapters || !esv_wanted(c, time(0)) || c == esv_inflight) return false;
    st: int = esv_state[c];
    if (st >= ESV_OFFLINE) return false;
    if (on_screen) return true;
    !esv_too_big(c) && esv_rate_ok(now) && esv_room_for(c)
}

// The client idle: the reader's next chapter asked for: the chapter being
// read (cur), then a placeholder on the screen (vis_lo to vis_hi), then
// the window's.
esv_pump_reader(
    now: f64,
    cur: int,
    vis_lo: int,
    vis_hi: int
) {
    if (esv_inflight >= 0 || now < esv_hold_until) return;
    if (cur >= 0 && esv_askable(cur, true, now)) {
        esv_ask(cur, if (esv_askable(cur + 1, true, now)) 2 else 1, now);
        return
    }
    if (vis_lo >= 0) {
        for c in vis_lo..vis_hi + 1 {
            if (esv_askable(c, true, now)) {
                esv_ask(c, if (esv_askable(c + 1, c + 1 <= vis_hi || c + 1 == esv_win_l || c + 1 == esv_win_l + 1,
                    now)) 2 else 1, now);
                return
            }
        }
    }
    l: int = esv_win_l;
    if (l < 0) return;
    for d in [0, 1, 2, -1] {
        c: int = l + d;
        if (esv_askable(c, false, now)) {
            esv_ask(c, if (d >= 0 && d < 2 && esv_askable(c + 1, false, now)) 2 else 1,
                now);
            return
        }
    }
}

// A plan's day (ยง16.6): one of its chapters on the screen not here (its
// rows lo to hi), else the day's first not here (by the cache's rules).
esv_pump_day(now: f64, lo: int, hi: int) {
    if (esv_inflight >= 0 || now < esv_hold_until) return;
    for r in lo..hi + 1 {
        if (r >= 0 && r < dy_n && esv_askable(dy_c[r], true, now)) {
            esv_ask(dy_c[r], 1, now);
            return
        }
    }
    for r in 0..dy_n {
        if (esv_askable(dy_c[r], false, now)) {
            esv_ask(dy_c[r], 1, now);
            return
        }
    }
}

// An answer that brought no chapters: their states (those not held), and,
// busy or at the daily limit, a rest (the server's, else a minute).
esv_fail_states(
    c: int,
    count: int,
    state: int,
    retry: int,
    now: f64
) {
    for x in c..c + count {
        if (x < chapters && !esv_held(x)) esv_state[x] = state
    }
    if (state == ESV_BUSY || state == ESV_DAILY) esv_hold_until = now + (if (retry > 0) retry as f64 else 60.0f64)
}

// Whether chapter c, on the screen and not here, is asked for again (every
// 30 s while one is: one that could not come; busy or the daily limit,
// once the rest is over).
ESV_RETRY_EVERY: f64 = 30.0f64;

// The ESV's line under a chapter that could not come: its actions (Try
// Again; Read in the BSB, or in a plan's day Change Version; esv.org).
ESV_TRY: int = 1;

ESV_BSB: int = 2;

ESV_SITE: int = 3;

ESV_VERSION: int = 4;

// Try Again: chapter c asked for now, whatever held it back.
esv_try_again(c: int, now: f64) {
    if (c < 0 || c >= chapters) return;
    esv_state[c] = 0;
    esv_hold_until = 0.0f64;
    esv_want_now(c, 1, now)
}

// The chapters on the screen, c0 to c1, asked again where they are due
// (every ESV_RETRY_EVERY while one is there, and when the app is back):
// whether any was, to try again later.
esv_retry_rows(c0: int, c1: int, now: f64): bool {
    any: bool = false;
    for c in c0..c1 + 1 {
        if (esv_retry_due(c, now)) {
            any = true;
            esv_want_now(c, 1, now)
        }
    }
    any
}

esv_retry_due(c: int, now: f64): bool {
    if (c < 0 || c >= chapters || esv_held(c)) return false;
    st: int = esv_state[c];
    st == ESV_OFFLINE || st == ESV_UNAVAILABLE || (st == ESV_BUSY || st == ESV_DAILY) && now >= esv_hold_until
}

// ---- the answers ----
// Chapter c's records came (b, n bytes; the server's own lines), now:
// Memory's pinned verses of it kept first (ยง13.6: whether any were, for
// the host to keep its pins); a chapter asked for the pins alone goes no
// further; else held (inserted, used now) and here (the host writes it to
// disk if it is held there).
esv_came_pins: bool = false;

// (A chapter's records may end with the next chapter's headings, the
// proxy's split: they are taken off, and put back at the next chapter's
// start when it comes in the same answer, starting with none of its own.)
esv_carry: []i8 = static_buffer([4096]i8);

esv_carry_n: int = 0;

esv_carry_c: int = -1;

esv_join: []i8 = static_buffer([262144]i8);

esv_came(
    c: int,
    b_in: []i8,
    n_in: int,
    now: int
) {
    b: []i8 = b_in;
    n: int = n_in;
    if (esv_carry_c == c && esv_carry_n > 0 && !esv_heading_at(b, 0, n) && esv_carry_n + n <= len(esv_join)) {
        for i in 0..esv_carry_n esv_join[i] = esv_carry[i];
        for i in 0..n esv_join[esv_carry_n + i] = b[i];
        b = esv_join;
        n = esv_carry_n + n
    }
    esv_carry_c = -1;
    esv_carry_n = 0;
    t: int = esv_tail_headings(b, n);
    if (t < n && n - t <= len(esv_carry)) {
        for i in t..n esv_carry[i - t] = b[i];
        esv_carry_n = n - t;
        esv_carry_c = c + 1;
        n = t
    }
    esv_came_pins = esv_pin_fill(c, b, n, now) > 0;
    if (esv_pin_only[c]) {
        esv_pin_only[c] = false;
        if (esv_state[c] == ESV_LOADING) esv_state[c] = 0;
        return
    }
    esv_insert(c, b, n, now);
    esv_touch(c, now);
    esv_state[c] = ESV_HERE
}

// Whether the record at p (to n) is a heading's (S, M, D, A or s).
esv_heading_at(b: []i8, p: int, n: int): bool {
    if (p >= n) return false;
    k: int = b[p] as int;
    k == 83 || k == 77 || k == 68 || k == 65 || k == 115
}

// Where the records' trailing headings begin (n: none).
esv_tail_headings(b: []i8, n: int): int {
    e: int = n;
    while (e > 0 && b[e - 1] as int == 10) e = e - 1;
    t: int = n;
    while (e > 0) {
        s: int = e;
        while (s > 0 && b[s - 1] as int != 10) s = s - 1;
        if (!esv_heading_at(b, s, e)) return t;
        t = s;
        e = s;
        while (e > 0 && b[e - 1] as int == 10) e = e - 1
    }
    t
}

// ---- Memory's ESV passages (ยง13.6) ----
// The ESV passages' ids, for the pins file's reading (those of no passage
// left out).
mp_keep: []int = static_buffer([256]int);

mp_keep_n: int = 0;

mp_keep_ids() {
    mp_keep_n = 0;
    for i in 0..mq_n {
        if (mq_ver[i] == TEXT_ESV && mp_keep_n < len(mp_keep)) {
            mp_keep[mp_keep_n] = mq_id[i];
            mp_keep_n = mp_keep_n + 1
        }
    }
}

// The pins read from fbuf (the host's file), and an ESV passage without
// its pins (its file gone) pinned again, to be fetched.
mp_load() {
    mp_keep_ids();
    parse_pins(mp_keep, mp_keep_n);
    for i in 0..mq_n {
        if (mq_ver[i] == TEXT_ESV && !mp_pinned(mq_id[i])) _a: bool = esv_pin_add(mq_id[i],
            mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i])
    }
}

mp_pinned(id: int): bool {
    for k in 0..pn_n
        if (pn_id[k] == id) return true;
    false
}

// Passage i's chapters its pins want (missing, or fetched over 30 days
// ago), now: each kept from the cache if it is held fresh (whether any
// was: mp_from_cache, the pins to be kept), else asked for (by the host,
// through esv_want; a chapter not held asked for the pins alone).
mp_from_cache: bool = false;

mp_fetch(i: int, now: int, now_s: f64) {
    mp_from_cache = false;
    if (i < 0 || i >= mq_n || mq_ver[i] != TEXT_ESV || !sk_esv_listed) return;
    for c in mq_c1[i]..mq_c2[i] + 1 {
        if (esv_pin_wants(c, now)) {
            if (esv_pin_from_cache(c, now) > 0) mp_from_cache = true else {
                held: bool = esv_find(c) >= 0;
                esv_want_now(c, 1, now_s);
                if (!held) esv_pin_only[c] = true
            }
        }
    }
}

// An ESV passage added: its id (0: refused, its words in fbuf and a
// toast); pinned and kept, its verses fetched (the host's).
mp_add(
    c1: int,
    v1: int,
    c2: int,
    v2: int,
    now: int
): int {
    if (mm_esv_refusal_words(c1, v1, c2, v2) != 0) {
        ui_toast(TOAST_BRAIN);
        return 0
    }
    id: int = memory_add(TEXT_ESV, c1, v1, c2, v2, now);
    if (id == 0) return 0;
    _p: bool = esv_pin_add(id, c1, v1, c2, v2);
    sk_kept(SK_KEPT_MEMORY);
    sk_pins_changed();
    sk_mm_fetch(mem_index(id));
    id
}

// ---- for a skin whose host only makes the requests ----
// (Android's, the web's: core asks for the chapters the reader wants, draws
// one that has not come as its line, and takes the host's answers. The
// iPhone does these its own way.) The host's clock is the wall's here.
ew_now(): f64 {
    time(0) as f64
}

// Chapter c wanted by the reader in the ESV (with the one after it, if
// that isn't here either).
ew_want(c: int) {
    if (c < 0 || c >= chapters || esv_held(c)) return;
    esv_want_now(c, if (c + 1 < chapters && !esv_held(c + 1)) 2 else 1, ew_now())
}

// Chapter c's records came (b, n bytes): held, the ESV's text made again,
// and the chapter drawn again if it is being read.
sk_esv_came(c: int, b: []i8, n: int) {
    if (c < 0 || c >= chapters) return;
    esv_came(c, b, n, time(0));
    // (Memory's verses of it filled: kept; the chapter kept.)
    if (esv_came_pins) kept_save(SK_KEPT_PINS);
    kept_esv_came(c);
    esv_build();
    if (text_cur == TEXT_ESV) sk_write_chapter(c)
}

// The request's answer all in: the next asked for, what shows the ESV
// made again.
sk_esv_done() {
    esv_inflight = -1;
    ew_pump();
    sk_update_all()
}

// The request for count chapters from c failed (status 0: no answer;
// daily: the daily limit; retry: when to, seconds): their lines drawn.
sk_esv_failed(
    c: int,
    count: int,
    status: int,
    daily: bool,
    retry: int
) {
    esv_inflight = -1;
    esv_fail_states(c, count, esv_state_for(status, daily), retry, ew_now());
    if (text_cur == TEXT_ESV) {
        for x in c..c + count
            if (x < chapters) sk_write_chapter(x)
    }
    sk_update_all()
}

// The client idle: one asked for directly, else the reader's next.
ew_pump() {
    now: f64 = ew_now();
    if (!esv_next_queued(now)) esv_pump_reader(now, sk_c, sk_c, sk_c + 1)
}

// A tap on a chapter's line (ESV_TRY, ESV_BSB, ESV_SITE).
sk_esv_act(what: int, c: int) {
    if (what == ESV_TRY) {
        esv_try_again(c, ew_now());
        if (text_cur == TEXT_ESV) sk_write_chapter(c)
    } else if (what == ESV_BSB) sk_use_version(TEXT_BSB) else if (what == ESV_SITE) {
        fput_esv_url(c);
        ui_effect_fbuf("url")
    }
}

// The server said whether it gives the ESV (status 0: no answer); the
// ESV read last read again, once it can be.
sk_esv_status(status: int, esv: bool) {
    l: int = esv_status_listed(status, esv);
    if (l < 0) return;
    on: bool = l == 1;
    if (on == sk_esv_listed) return;
    sk_esv_listed = on;
    // (Memory's ESV passages' verses fetched where missing or stale.)
    if (on) {
        for i in 0..mq_n
            if (mq_ver[i] == TEXT_ESV) sk_mm_fetch(i)
    }
    if (on && sk_started && pref_get("version") == TEXT_ESV && text_cur != TEXT_ESV) sk_use_version(TEXT_ESV);
    sk_update_all()
}

// The reader at rest in chapter c (its last chapter whose end shows,
// ends_hi): what shows held, the window there, the next asked for.
ew_rest(c: int, ends_hi: int) {
    if (c < 0) return;
    esv_set_visible(c, if (ends_hi > c) ends_hi + 1 else c + 1);
    esv_win_l = c;
    ew_pump()
}

// Chapter c not here, drawn as its line: its title, the ESV's state
// (loading, or why it cannot come), then Try Again (if it can help) and
// Read in the BSB, links of KIND 3 (their ARG ESV_TRY, ESV_BSB).
sk_write_esv_wait(c: int) {
    st: int = esv_state[c];
    fbuf_n = 0;
    fput_title(c);
    t1: int = fbuf_n;
    fput(10);
    if (st == ESV_HERE || st == ESV_LOADING) fput_str("Loading the ESV\โ\€\ฆ") else fput_str(esv_line(st,
        false));
    t2: int = fbuf_n;
    try_b: int = -1;
    try_e: int = -1;
    bsb_b: int = -1;
    bsb_e: int = -1;
    if (st >= ESV_OFFLINE) {
        fput(10);
        if (esv_can_try(st)) {
            try_b = fbuf_n;
            fput_str(esv_try_title);
            try_e = fbuf_n;
            fput_str("   ")
        }
        bsb_b = fbuf_n;
        fput_str(esv_other_title(false));
        bsb_e = fbuf_n
    }
    n: int = fbuf_n;
    ui_str("chapter ");
    ui_int(c);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, n);
    ui_byte(10);
    ew_span(0, t1, STYLE_HEAD);
    ew_span(t1, t2 + (if (n > t2) 1 else 0), RUN_FAINT);
    if (n > t2 + 1) ew_span(t2 + 1, n, RUN_ACCENT);
    if (try_b >= 0) ew_link(try_b, try_e, ESV_TRY);
    if (bsb_b >= 0) ew_link(bsb_b, bsb_e, ESV_BSB);
    ui_str("end\n")
}

ew_span(b: int, e: int, style: int) {
    if (e <= b) return;
    ui_str("span ");
    ui_int(ui_utf16(fbuf, 0, b));
    ui_byte(32);
    ui_int(ui_utf16(fbuf, 0, e));
    ui_byte(32);
    ui_int(style);
    ui_str(" 0\n")
}

ew_link(b: int, e: int, what: int) {
    ui_str("link ");
    ui_int(ui_utf16(fbuf, 0, b));
    ui_byte(32);
    ui_int(ui_utf16(fbuf, 0, e));
    ui_str(" 3 ");
    ui_int(what);
    ui_byte(10)
}

// An ESV chapter's last line, into fbuf: "(ESV) ยท esv.org"; its runs and
// its link (KIND 3, ESV_SITE), from base (UTF-16, the chapter's end).
ew_tail() {
    fbuf_n = 0;
    fput(10);
    fput_str(esv_footer_words());
    fput_str(esv_site_title)
}

ew_tail_runs(base: int) {
    ew_tail();
    words: int = 1 + len(esv_footer_words());
    a: int = base + ui_utf16(fbuf, 0, words);
    e: int = base + ui_utf16(fbuf, 0, fbuf_n);
    ui_str("span ");
    ui_int(base);
    ui_byte(32);
    ui_int(a);
    ui_byte(32);
    ui_int(RUN_SMALL);
    ui_str("""
 0
span """);
    ui_int(a);
    ui_byte(32);
    ui_int(e);
    ui_byte(32);
    ui_int(RUN_ACCENT);
    ui_str("""
 0
link """);
    ui_int(a);
    ui_byte(32);
    ui_int(e);
    ui_str(" 3 ");
    ui_int(ESV_SITE);
    ui_byte(10)
}
