tag bible;

use_tag std;

// The panel beside the page (SKINS.md, group 1): what is read with the
// Bible, kept beside it while the page is read. A skin lays it out where
// it fits (`panelfits`): at the page's right on a wide window, under it on
// a phone; others open its screens over the page as any other's.
//
// Its screens, bottom to top: the Bookshelf; the document being read
// beside the page, if one is (a version of the Bible or a commentary,
// following the page; a book at its part; a dictionary's entries or entry;
// a devotional at today's); Study, if a verse is being studied. Back goes
// down them; its close (or the bar's Bookshelf, or âŒ¥âŒ˜I) puts it away, and
// it opens again as it was left: whether it is open (besideOpen), the
// document beside the page (a version, besideVersion, its text plus one;
// else a module, besideSlot, its shelf slot plus one; 0 none: at most one
// is set, by sk_beside_keep) and Study's verse (studyBeside,
// studyBesideChapter as the chapter plus one, studyBesideVerse).
//
// The panel may fill the screen instead (`tap full`: besideFull), what it
// reads read on its own over the Bible. Beside the Bible, the Bible leads:
// a commentary follows the page. Filling the screen, what it reads leads:
// the Bible under it follows a commentary's chapter, so that it is there
// as the panel goes beside it again. A reference tapped in what the panel
// reads is shown in the Bible (the panel beside it again, if it filled the
// screen), a commentary staying where it is. Study, opened from the Bible,
// goes on the panel's screens.
//
// Core says whether it is wanted open and whether it fills the screen
// (`beside OPEN FULL`); a skin opening it asks for its screens
// (`panelmake`), which come as the panel's (`panel` its first, `push` the
// rest, each a screen of group 1); a skin closing it says so (`closegroup
// 1`).
import "skin.l8";

// Whether the skin's panel fits now (`panelfits`: a skin without one never
// says).
sk_panel_fits: bool = false;

// A commentary beside the page follows it: it shows the chapter at the
// page's top when the page rests, at the comment on its verse. Stepped to
// another chapter by its own buttons, it stays there until the page rests
// in a chapter other than the one it was in then (sk_beside_held_c; -1
// following).
sk_beside_held_c: int = -1;

// The verse whose comment a commentary beside the page shows first (its
// section the focus), as its screen is made; -1 none.
sk_beside_focus_v: int = -1;

sk_beside_open(): bool {
    pref_on("besideOpen", false)
}

// Whether the panel fills the screen.
sk_beside_full(): bool {
    sk_beside_open() && pref_on("besideFull", false)
}

// How many of the screens are the panel's (they are first).
sk_beside_count(): int {
    n: int = 0;
    while (n < sk_n && sk_groups[n] == 1) n = n + 1;
    n
}

// The panel's top screen (-1: none).
sk_beside_top(): int {
    sk_beside_count() - 1
}

// `beside OPEN FULL`: whether the panel is wanted open, whether it fills
// the screen; at `start` and as they change.
sk_write_beside() {
    ui_str("beside ");
    ui_int(if (sk_beside_open()) 1 else 0);
    ui_byte(32);
    ui_int(if (sk_beside_full()) 1 else 0);
    ui_byte(10)
}

// `tap full`: the panel filling the screen, or beside the Bible again.
sk_beside_full_toggle() {
    if (sk_beside_full()) sk_beside_unfill() else if (sk_beside_open()) {
        set_pref_on("besideFull", true);
        sk_save();
        sk_write_beside();
        sk_beside_lead()
    }
}

// The panel beside the Bible again, a commentary staying where it is until
// the page moves to another chapter.
sk_beside_unfill() {
    set_pref_on("besideFull", false);
    sk_save();
    sk_write_beside();
    sk_beside_held_c = sk_c
}

// A commentary (or a version) filling the screen leading the Bible: the
// Bible under it to its chapter, there as the panel goes beside it again.
sk_beside_lead() {
    top: int = sk_beside_top();
    if (!sk_beside_full() || top < 0 || !sk_beside_follows(sk_kinds[top])) return;
    c: int = sk_args[top] % SHELF_PLACE;
    if (c == sk_c || c < 0 || c >= chapters) return;
    ui_effect("jump", c, 0)
}

// Reference ref (packed) tapped in what the panel reads: the Bible there;
// a commentary staying where it is until the page moves to another
// chapter.
sk_beside_reference(ref: int) {
    xref_unpack(ref);
    c: int = xref_chapter();
    if (c < 0 || c >= chapters) return;
    // (Held first: the jump doesn't move what the panel reads.)
    v: int = xr_v;
    sk_beside_held_c = c;
    sk_beside_bible_to(c, v)
}

// The Bible to chapter c, verse v, from what the panel reads (a reference,
// a comment's verses): the panel beside it again if it fills the screen.
sk_beside_bible_to(c: int, v: int) {
    if (sk_beside_full()) sk_beside_unfill();
    sk_goto(c, v)
}

// The bar's Bookshelf (`tap shelf`), âŒ¥âŒ˜I: the panel put away if it is
// open, else opened as it was left. Without a panel that fits, the
// Bookshelf over the page.
sk_beside_toggle() {
    if (sk_beside_open()) {
        sk_beside_closed();
        sk_close_group(1);
        sk_write_beside();
        return
    }
    if (!sk_panel_fits) {
        sk_open(SCR_SHELF, 0, false);
        return
    }
    set_pref_on("besideOpen", true);
    sk_save();
    sk_write_beside()
}

// Module in slot read beside the page, chosen over it (in Go To, the
// Library): the panel opened at it, or, open, made again with it on top,
// Study let go.
sk_beside_read(slot: int) {
    sk_beside_keep(PanelDocument.Module { slot: slot });
    bb_reader_begin();
    sk_beside_show_kept()
}

// Version t read beside the page, chosen over it or in the panel: the
// panel opened at it, or made again with it on top, Study let go. Without
// a panel that fits, the version over the page (not following it).
sk_beside_read_version(t: int) {
    if (!sk_panel_fits) {
        sk_open(SCR_BESIDE_BIBLE, t * SHELF_PLACE + (if (sk_c >= 0 && sk_c < chapters) sk_c else 0),
            true);
        return
    }
    sk_beside_keep(PanelDocument.Version { text: t });
    bb_reader_begin();
    sk_beside_show_kept()
}

// The panel shown with the document kept on top, Study let go: made again
// if it is open, else opened (the skin then asks for its screens).
sk_beside_show_kept() {
    set_pref_on("studyBeside", false);
    if (sk_beside_open() && sk_beside_count() > 0) {
        sk_save();
        sk_beside_make();
        return
    }
    set_pref_on("besideOpen", true);
    sk_save();
    sk_write_beside()
}

// What the panel reads beside the page, as it is kept: a version, a
// Bookshelf module, or neither.
type PanelDocument =
    | NoDocument
    | Version { text: int }
    | Module { slot: int }

sk_beside_kept(): PanelDocument {
    t: int = pref_get("besideVersion") - 1;
    if (t >= 0) return PanelDocument.Version { text: t };
    slot: int = pref_get("besideSlot") - 1;
    if (slot >= 0) return PanelDocument.Module { slot: slot };
    PanelDocument.NoDocument
}

// The document the panel reads kept (not saved: the caller saves).
sk_beside_keep(document: PanelDocument) {
    match document {
        NoDocument -> {
            set_pref("besideVersion", 0);
            set_pref("besideSlot", 0)
        }
        Version v -> {
            set_pref("besideVersion", v.text + 1);
            set_pref("besideSlot", 0)
        }
        Module m -> {
            set_pref("besideVersion", 0);
            set_pref("besideSlot", m.slot + 1)
        }
    }
}

// Whether the panel reads version t, or the module in slot.
sk_beside_reads_version(t: int): bool {
    match sk_beside_kept() {
        Version v -> v.text == t;
        _ -> false
    }
}

sk_beside_reads_module(slot: int): bool {
    match sk_beside_kept() {
        Module m -> m.slot == slot;
        _ -> false
    }
}

// Whether a panel screen of kind follows the page by chapter and verse (a
// version, a commentary).
sk_beside_follows(kind: int): bool {
    kind == SCR_BESIDE_BIBLE || kind == SCR_SHELF_COMMENTARY
}

// `panelmake`: the panel's screens made as it was left (the skin opening
// it): the Bookshelf, the module read beside the page, Study at its verse.
sk_beside_make() {
    sk_close_group(1);
    sk_open_panel(SCR_SHELF, 0);
    match sk_beside_kept() {
        Version v -> {
            bb_reader_begin();
            if (sk_beside_can_read(v.text)) sk_beside_push(SCR_BESIDE_BIBLE, v.text * SHELF_PLACE + (if (sk_c >= 0 && sk_c < chapters) sk_c else 0)) else sk_beside_keep(PanelDocument.NoDocument)
        }
        Module m -> {
            bb_reader_begin();
            i: int = shelf_find_slot(m.slot);
            if (i >= 0 && shelf_ready_at(i) && shelf_kind_at(i) != SHELF_KIND_BIBLE) shelf_open_reading(i,
                true) else sk_beside_keep(PanelDocument.NoDocument)
        }
        NoDocument -> { }
    }
    if (pref_on("studyBeside", false)) {
        c: int = pref_get("studyBesideChapter") - 1;
        v: int = pref_get("studyBesideVerse");
        if (c >= 0 && c < chapters) sk_beside_push(SCR_VERSE_STUDY, (c * 1000 + v) * 4)
    }
}

// A screen pushed on the panel's (after its last, under any sheet's).
sk_beside_push(kind: int, arg: int) {
    n: int = sk_beside_count();
    if (n == 0) {
        sk_open_panel(kind, arg);
        return
    }
    if (sk_n >= SK_SCREENS_MOST) return;
    sk_verse_study_opening(kind, arg);
    sk_shelf_opening(kind, arg);
    j: int = sk_n;
    while (j > n) {
        sk_ids[j] = sk_ids[j - 1];
        sk_kinds[j] = sk_kinds[j - 1];
        sk_args[j] = sk_args[j - 1];
        sk_groups[j] = sk_groups[j - 1];
        j = j - 1
    }
    sk_ids[n] = sk_next_id;
    sk_kinds[n] = kind;
    sk_args[n] = arg;
    sk_groups[n] = 1;
    sk_next_id = sk_next_id + 1;
    sk_n = sk_n + 1;
    sk_beside_follow(n);
    sk_build(n);
    ui_effect("push", sk_ids[n], -1)
}

// The panel closed (its close, the bar's Bookshelf, the skin's): what it
// read beside the page kept for the next time; Study not.
sk_beside_closed() {
    set_pref_on("besideOpen", false);
    set_pref_on("besideFull", false);
    set_pref_on("studyBeside", false);
    sk_save()
}

// Screens from at on let go by the skin's Back: the panel's Study, or the
// module it read beside the page, no longer wanted there when it opens.
sk_beside_popped(at: int) {
    for j in at..sk_n {
        if (sk_groups[j] != 1) return;
        k: int = sk_kinds[j];
        if (k == SCR_VERSE_STUDY) set_pref_on("studyBeside", false) else if (k >= SCR_SHELF_COMMENTARY && k <= SCR_SHELF_BOOK || k == SCR_BESIDE_BIBLE) sk_beside_keep(PanelDocument.NoDocument)
    }
}

// `panelanchor ID`: the panel shows screen id on top now (its Back, a
// swipe): the panel's screens above it let go, any sheet's kept.
sk_beside_anchor(id: int) {
    at: int = sk_find(id);
    count: int = sk_beside_count();
    if (at < 0 || at >= count || at == count - 1) return;
    sk_beside_popped(at + 1);
    n: int = at + 1;
    for j in count..sk_n {
        sk_ids[n] = sk_ids[j];
        sk_kinds[n] = sk_kinds[j];
        sk_args[n] = sk_args[j];
        sk_groups[n] = sk_groups[j];
        n = n + 1
    }
    sk_n = n
}

// Screen at, the panel's, shown now: what it reads kept as the panel's
// (Study's verse; the module read beside the page, and its place).
sk_beside_follow(at: int) {
    if (at < 0 || at >= sk_n || sk_groups[at] != 1) return;
    k: int = sk_kinds[at];
    if (k == SCR_VERSE_STUDY) {
        cv: int = sk_args[at] / 4;
        set_pref_on("studyBeside", true);
        set_pref("studyBesideChapter", cv / 1000 + 1);
        set_pref("studyBesideVerse", cv % 1000);
        sk_save()
    } else if (k == SCR_BESIDE_BIBLE) {
        sk_beside_keep(PanelDocument.Version { text: sk_args[at] / SHELF_PLACE });
        sk_save();
        if (at == sk_beside_top()) sk_beside_lead()
    } else if (k >= SCR_SHELF_COMMENTARY && k <= SCR_SHELF_BOOK) {
        slot: int = if (k == SCR_SHELF_ENTRIES) sk_args[at] else sk_args[at] / SHELF_PLACE;
        sk_beside_keep(PanelDocument.Module { slot: slot });
        sk_save();
        // (A commentary opened filling the screen: the Bible to its
        // chapter.)
        if (at == sk_beside_top()) sk_beside_lead()
    }
}

// Whether Study shows in the panel now (its top, the panel in sight).
sk_beside_studying(): bool {
    top: int = sk_beside_top();
    sk_panel_shown && top >= 0 && sk_kinds[top] == SCR_VERSE_STUDY
}

// The panel's Study screen (its index; -1: none).
sk_beside_at(): int {
    for j in 0..sk_beside_count()
        if (sk_kinds[j] == SCR_VERSE_STUDY) return j;
    -1
}

// The tray's Study where the panel fits: Study pushed on the panel at the
// verse (or, there already, showing it); the panel opened if it is away.
sk_beside_study(c: int, v: int) {
    set_pref_on("studyBeside", true);
    set_pref("studyBesideChapter", c + 1);
    set_pref("studyBesideVerse", v);
    if (!sk_beside_open() || sk_beside_count() == 0) {
        set_pref("studySegment", 0);
        set_pref_on("besideOpen", true);
        sk_save();
        sk_write_beside();
        return
    }
    sk_save();
    at: int = sk_beside_at();
    if (at < 0) {
        set_pref("studySegment", 0);
        sk_beside_push(SCR_VERSE_STUDY, (c * 1000 + v) * 4);
        // (The tray's Study reading Studying now.)
        if (sk_sel_n > 0) {
            sk_build_tray();
            ui_write();
            ui_effect("tray", -1, -1)
        }
        return
    }
    sk_vs_show(sk_ids[at], c, v);
    ui_effect("refill", sk_ids[at], 1)
}

// Verses selected while the panel shows Study (the first shown there), a
// commentary (the first's comment shown there) or a version (the first's
// paragraph shown there).
sk_beside_select() {
    if (sk_sel_n == 0 || sk_sheet_top() >= 0) return;
    top: int = sk_beside_top();
    if (top < 0) return;
    if (sk_kinds[top] == SCR_VERSE_STUDY) {
        if (!sk_panel_shown) return;
        cv: int = sk_args[top] / 4;
        if (cv / 1000 == sk_sel_c && cv % 1000 == sk_sel_v[0]) return;
        sk_vs_show(sk_ids[top], sk_sel_c, sk_sel_v[0]);
        sk_beside_follow(top);
        ui_effect("refill", sk_ids[top], 1);
        return
    }
    if (bb_reader_at() == top) {
        sk_beside_held_c = -1;
        bb_reader_jump_to(top, sk_sel_c, sk_sel_v[0])
    } else if (sk_kinds[top] == SCR_SHELF_COMMENTARY) {
        sk_beside_held_c = -1;
        sk_beside_commentary_to(top, sk_sel_c, sk_sel_v[0])
    } else if (sk_kinds[top] == SCR_BESIDE_BIBLE) {
        sk_beside_held_c = -1;
        sk_beside_version_to(top, sk_sel_c, sk_sel_v[0])
    }
}

// The page at rest at chapter c, verse v: a commentary or a version on top
// of the panel following it.
sk_beside_rest(c: int, v: int) {
    top: int = sk_beside_top();
    // (The Bible leads only beside the panel.)
    if (sk_beside_full() || top < 0 || !sk_beside_follows(sk_kinds[top]) || c < 0 || c >= chapters) return;
    if (sk_beside_held_c >= 0) {
        if (c == sk_beside_held_c) return;
        sk_beside_held_c = -1
    }
    if (bb_reader_at() == top) bb_reader_follow(top, c, v) else if (sk_kinds[top] == SCR_BESIDE_BIBLE) sk_beside_version_to(top,
        c, v) else sk_beside_commentary_to(top, c, v)
}

// The commentary at screen at shown at chapter c, its comment on verse v
// first (made again only if either changes what it shows).
sk_beside_commentary_to(at: int, c: int, v: int) {
    slot: int = sk_args[at] / SHELF_PLACE;
    was_c: int = sk_args[at] % SHELF_PLACE;
    if (was_c == c && v == sk_beside_shown_v) return;
    if (was_c == c && sk_beside_same_section(slot, c, v, sk_beside_shown_v)) {
        sk_beside_shown_v = v;
        return
    }
    sk_args[at] = slot * SHELF_PLACE + c;
    sk_beside_focus_v = (if (v > 0) v else 0);
    sk_build(at);
    sk_beside_focus_v = -1;
    sk_beside_shown_v = v;
    ui_effect("update", sk_ids[at], -1);
    ui_effect("focus", sk_ids[at], -1)
}

// The verse a commentary beside the page was last shown at.
sk_beside_shown_v: int = -1;

// Whether verses a and b of chapter c have the same comment in the
// commentary in slot (so moving between them moves nothing).
sk_beside_same_section(
    slot: int,
    c: int,
    a: int,
    b: int
): bool {
    if (a < 0 || b < 0 || !shelf_open_is(SHELF_USE_STUDY, slot)) return false;
    same: bool = false;
    borrow shelf_open[SHELF_USE_STUDY] as open {
        match open.reader {
            Document d -> {
                match shelf_folio_chapter(slot, d.folio, c) {
                    ChapterRecords r -> same = comment_on(r.data, a).start == comment_on(r.data,
                        b).start;
                    _ -> { }
                }
            }
            _ -> { }
        }
    }
    same
}

// A commentary or a version beside the page stepped to another chapter by
// its own buttons: it stays there until the page moves to another chapter
// (stepped back to the page's own, it follows it again). Filling the
// screen, the Bible follows it.
sk_beside_stepped(at: int) {
    if (at < 0 || at >= sk_n || sk_groups[at] != 1) return;
    if (sk_beside_full()) {
        sk_beside_lead();
        return
    }
    // (Stepped back to the page's own chapter: following it again.)
    sk_beside_held_c = (if (sk_args[at] % SHELF_PLACE == sk_c) -1 else sk_c)
}

// ---- a version beside the page ----
// A version of the Bible read in the panel (its argument its text times
// SHELF_PLACE plus the chapter): the chapter laid out as the reader lays it
// out, a row each paragraph, made first at the paragraph of the page's
// verse; Previous and Next Chapter. It follows the page as a commentary
// does. The ESV, read only where the reader asks for its chapters, isn't
// read here.
SCR_BESIDE_BIBLE: int = 67;

// Previous or Next Chapter (arg -1, 1).
ACT_BESIDE_STEP: int = 330;

// Go To's Read Beside on a version (arg its text).
ACT_BESIDE_VERSION: int = 331;

// Whether version t can be read beside the page: one offered here.
sk_beside_can_read(t: int): bool {
    if (t == TEXT_ESV || t < 0) return false;
    if (t == TEXT_ORIG) return sk_has_orig;
    t < TEXT_ESV || text_is_version(t)
}

bb_layout: ChapterLayout = chapter_layout();

// The version's chapter shown, by paragraph: each verse's row (-1: not
// shown), for whether the page moving moves it.
bb_verse_row: []int = new int[BB_VERSES_MOST](-1);

BB_VERSES_MOST: int = 256;

bb_shown_t: int = -1;

bb_shown_c: int = -1;

sk_build_beside_bible(id: int, arg: int) {
    t: int = arg / SHELF_PLACE;
    c: int = arg % SHELF_PLACE;
    // (In the panel of a skin that draws a reader there: read as the page
    // is.)
    at_built: int = sk_find(id);
    if (sk_has_panel_reader && at_built >= 0 && sk_groups[at_built] == 1) {
        bb_build_reader(id, arg);
        return
    }
    fbuf_n = 0;
    fput_title(c);
    ui_begin(id, SCR_BESIDE_BIBLE, arg, "");
    ui_set_screen_title_fbuf();
    fbuf_n = 0;
    fput_text_name(t);
    ui_set_subtitle_fbuf();
    ui_page = true;
    ui_plain = true;
    ui_tool("", "chevron.left", ACT_BESIDE_STEP, -1, if (c > 0) UI_TOOL_PLAIN else UI_TOOL_OFF,
        0);
    fbuf_n = 0;
    fput_str("Previous Chapter");
    ui_set_tool_label_fbuf();
    ui_tool("", "chevron.right", ACT_BESIDE_STEP, 1, if (c + 1 < chapters) UI_TOOL_PLAIN else UI_TOOL_OFF,
        2);
    fbuf_n = 0;
    fput_str("Next Chapter");
    ui_set_tool_label_fbuf();
    bb_shown_t = -1;
    if (!sk_beside_can_read(t) || c < 0 || c >= chapters) {
        ui_set_empty("books.vertical", "Not Here", "");
        return
    }
    // (Not read yet: asked for, and made again when it has come.)
    if (t != text_cur && !text_ready(t) && sk_num_of(SK_NUM_TEXT, t) != 1) {
        ui_section("", "");
        ui_row(UI_ITEM, 0, 0);
        fbuf_n = 0;
        fput_str("Opening ");
        fput_text_abbr(t);
        fput_str("\â\€\¦");
        ui_set_title_fbuf();
        ui_set_busy();
        ui_set_faint();
        return
    }
    // (Beside the page, made first at the page's verse.)
    at: int = sk_find(id);
    focus_v: int = sk_beside_focus_v;
    if (focus_v < 0 && at >= 0 && sk_groups[at] == 1 && c == sk_c) focus_v = sk_v;
    sk_apply_prefs();
    ctx: *ChapterLayout = &bb_layout;
    ctx.lay_verse_numbers = lay_verse_numbers;
    ctx.lay_headings = lay_headings;
    ctx.lay_notes = false;
    ctx.lay_verse_lines = lay_verse_lines;
    ctx.lay_accents = lay_accents;
    // (Its title names the chapter: laid out without its opener.)
    ctx.lay_v1 = 0;
    ctx.lay_v2 = 0;
    ctx.lay_passage = true;
    borrow texts[t] as source {
        layout_chapter_from(source, ctx, c)
    }
    ctx.lay_passage = false;
    bb_rows(ctx, c, focus_v);
    bb_shown_t = t;
    bb_shown_c = c;
    ui_section("", "");
    fbuf_n = 0;
    fput_text_name(t);
    ui_set_footer_fbuf()
}

// The chapter laid out, a row each paragraph (split where the layout ends
// a line; where a module marks no paragraphs, so that one would hold more
// than BB_PARAGRAPH_VERSES_MOST verses, a row each verse), without the
// chapter's number (the title says it). The row holding verse focus_v is
// focused, or the headings just before it; each verse's row is noted.
bb_rows(ctx: *ChapterLayout, c: int, focus_v: int) {
    for k in 0..BB_VERSES_MOST bb_verse_row[k] = -1;
    focus_at: int = -1;
    for k in 0..ctx.verse_count
        if (ctx.verse_num[k] == focus_v) focus_at = ctx.verse_begin[k];
    starts: []int = bb_row_starts(ctx);
    ui_section("", "");
    shown: int = 0;
    // (The first of the headings just before the row being made, as the ui
    // numbers rows; -1: it follows none.)
    headings_from: int = -1;
    for i in 0..len(starts) {
        from: int = starts[i];
        end: int = if (i + 1 < len(starts)) starts[i + 1] else ctx.out_n;
        // (A line's end isn't the row's: rows are apart already.)
        if (end > from && ctx.out[end - 1] as int == 10) end = end - 1;
        heading: bool = true;
        made: bool = false;
        p: int = 0;
        for r in 0..ctx.runs {
            run_from: int = if (p > from) p else from;
            run_end: int = if (ctx.run_end[r] < end) ctx.run_end[r] else end;
            style: int = ctx.run_style[r];
            if (run_end > run_from && style != STYLE_NUMERAL && style != STYLE_NUMERAL1) {
                if (!made) {
                    ui_row(UI_TEXT, 0, c);
                    // (Its value: whether its words are the original's (1),
                    // and the Hebrew's, right to left (2), for a skin's face
                    // and direction.)
                    ui_rows[ui_last()].value = (if (ctx.lay_orig) BB_ORIGINAL else 0) + (if (ctx.lay_rtl) BB_RIGHT_TO_LEFT else 0);
                    ui_rich_begin();
                    made = true
                }
                fput_bytes(ctx.out, run_from, run_end);
                ui_rich(style);
                if (!bb_heading_style(style)) heading = false
            }
            p = ctx.run_end[r]
        }
        if (made) {
            ui_rich_title();
            for k in 0..ctx.verse_count {
                b: int = ctx.verse_begin[k];
                v: int = ctx.verse_num[k];
                if (b >= from && b < end && v >= 0 && v < BB_VERSES_MOST) bb_verse_row[v] = shown
            }
            // (No verse to show, the page at the chapter's top or the
            // chapter stepped to: its first row.)
            if (focus_at >= from && focus_at < end || focus_at < 0 && shown == 0) {
                ui_set_focus();
                if (headings_from >= 0) ui_focus = headings_from
            }
            if (!heading) headings_from = -1 else if (headings_from < 0) headings_from = ui_last();
            shown = shown + 1
        }
    }
}

// A paragraph row's value, as bits: its words the original's, the
// Hebrew's right to left.
BB_ORIGINAL: int = 1;

BB_RIGHT_TO_LEFT: int = 2;

// More verses than a paragraph has in a module that marks them; past it,
// a module is read as marking none.
BB_PARAGRAPH_VERSES_MOST: int = 12;

// Where each of the chapter's rows begins in its layout: after each line's
// end; where a line would hold more than BB_PARAGRAPH_VERSES_MOST verses,
// at each verse too.
bb_row_starts(ctx: *ChapterLayout): []int@new {
    lines: int = 1;
    for x in 0..ctx.out_n
        if (ctx.out[x] as int == 10) lines = lines + 1;
    starts: []int = new int[lines](0);
    n: int = 1;
    for x in 0..ctx.out_n {
        if (ctx.out[x] as int == 10) {
            starts[n] = x + 1;
            n = n + 1
        }
    }
    // (The most verses any line holds.)
    most: int = 0;
    for i in 0..lines {
        line_end: int = if (i + 1 < lines) starts[i + 1] else ctx.out_n;
        held: int = 0;
        for k in 0..ctx.verse_count
            if (ctx.verse_begin[k] >= starts[i] && ctx.verse_begin[k] < line_end) held = held + 1;
        if (held > most) most = held
    }
    if (most <= BB_PARAGRAPH_VERSES_MOST) return starts;
    // (Each line's start and each verse's, in order, each once.)
    merged: []int = new int[lines + ctx.verse_count](0);
    m: int = 0;
    i: int = 0;
    k: int = 0;
    while (i < lines || k < ctx.verse_count) {
        next: int = if (k >= ctx.verse_count || i < lines && starts[i] <= ctx.verse_begin[k]) starts[i] else ctx.verse_begin[k];
        if (i < lines && starts[i] == next) i = i + 1;
        if (k < ctx.verse_count && ctx.verse_begin[k] == next) k = k + 1;
        if (m == 0 || merged[m - 1] != next) {
            merged[m] = next;
            m = m + 1
        }
    }
    result: []int = new int[m](0);
    for x in 0..m result[x] = merged[x];
    result
}

// Whether a run of style is a heading's (a row of them goes with the
// paragraph after it).
bb_heading_style(style: int): bool {
    style == STYLE_HEAD || style == STYLE_SUBHEAD || style == STYLE_REF || style == STYLE_TITLE || style == STYLE_MAJOR || style == STYLE_RANGE || style == STYLE_ACROSTIC || style == STYLE_PASSAGE
}

// The version at screen at shown at chapter c, the paragraph of verse v
// in sight (made again only if that moves what it shows).
sk_beside_version_to(at: int, c: int, v: int) {
    if (sk_has_panel_reader) {
        bb_reader_follow(at, c, v);
        return
    }
    t: int = sk_args[at] / SHELF_PLACE;
    was_c: int = sk_args[at] % SHELF_PLACE;
    if (was_c == c && bb_shown_t == t && bb_shown_c == c && v == sk_beside_shown_v) return;
    if (was_c == c && bb_shown_t == t && bb_shown_c == c && bb_same_row(v, sk_beside_shown_v)) {
        sk_beside_shown_v = v;
        return
    }
    sk_args[at] = t * SHELF_PLACE + c;
    sk_beside_focus_v = (if (v > 0) v else 0);
    sk_build(at);
    sk_beside_focus_v = -1;
    sk_beside_shown_v = v;
    ui_effect("update", sk_ids[at], -1);
    ui_effect("focus", sk_ids[at], -1)
}

// Whether verses a and b are in the same paragraph of the chapter shown.
bb_same_row(a: int, b: int): bool {
    if (a < 0 || b < 0 || a >= BB_VERSES_MOST || b >= BB_VERSES_MOST) return false;
    bb_verse_row[a] >= 0 && bb_verse_row[a] == bb_verse_row[b]
}

// Previous or Next Chapter (direction -1, 1): it stays there until the
// page moves to another chapter; filling the screen, the Bible follows it.
sk_beside_bible_step(at: int, direction: int) {
    t: int = sk_args[at] / SHELF_PLACE;
    c: int = sk_args[at] % SHELF_PLACE + direction;
    if (c < 0 || c >= chapters) return;
    sk_args[at] = t * SHELF_PLACE + c;
    sk_beside_stepped(at);
    sk_build(at);
    ui_effect("update", sk_ids[at], -1);
    ui_effect("focus", sk_ids[at], -1)
}

// ---- the panel's reader ----
// A skin that draws a reader in the panel (`panelreader 1`) reads a
// version there as the page is read: every chapter in turn, as it is
// scrolled to (`besidewant C`: core's `besidechapter` lines, as `chapter`'s
// for the page), its top told back (`besideplace C V FRAC`). Linked with
// the page (besideLinked, the default), the two move together: the page
// resting or jumping moves the reader there (`besidejump C V`), and the
// reader moved by a hand (`besidemoving`, then its places) moves the page
// (until the page is moved by a hand, or jumps). Unlinked, neither moves
// the other; linked again, the reader comes to the page's place. Its foot's
// button links and unlinks them.

// The panel's reader's place (its chapter, -1 none yet, and verse), and
// whether a hand has moved it since the page was last moved (it leads).
bb_reader_c: int = -1;

bb_reader_v: int = 0;

bb_hand: bool = false;

// Link or Unlink.
ACT_BESIDE_LINK: int = 332;

// Whether the panel's reader is linked with the page.
sk_beside_linked(): bool {
    pref_on("besideLinked", true)
}

// The reader's screen: its title the chapter at its top, its subtitle the
// version; at its foot, the button that links or unlinks it (filled while
// linked). The version not read yet: a row that says it is opening (made
// again when it has come).
bb_build_reader(id: int, arg: int) {
    t: int = arg / SHELF_PLACE;
    bb_reader_title(id, SCR_BESIDE_BIBLE, arg);
    fbuf_n = 0;
    fput_text_name(t);
    ui_set_subtitle_fbuf();
    if (!sk_beside_can_read(t)) {
        ui_set_empty("books.vertical", "Not Here", "");
        return
    }
    if (t != text_cur && !text_ready(t) && sk_num_of(SK_NUM_TEXT, t) != 1) {
        ui_section("", "");
        ui_row(UI_ITEM, 0, 0);
        fbuf_n = 0;
        fput_str("Opening ");
        fput_text_abbr(t);
        fput_str("\â\€\¦");
        ui_set_title_fbuf();
        ui_set_busy();
        ui_set_faint();
        return
    }
    bb_reader_link(ReaderFollows.ByVerse)
}

// A commentary read beside the page as the page is (its arg its slot times
// SHELF_PLACE plus its chapter): its comments a chapter at a time, every
// chapter in turn, following by comment. The module not open yet: a row
// that says it is opening.
bb_build_commentary_reader(id: int, arg: int) {
    slot: int = arg / SHELF_PLACE;
    i: int = shelf_find_slot(slot);
    bb_reader_title(id, SCR_SHELF_COMMENTARY, arg);
    sk_shelf_subtitle(i);
    if (i < 0) {
        ui_set_empty("books.vertical", "Not on Your Bookshelf", "");
        return
    }
    if (!shelf_ensure_open(slot)) {
        shelf_opening_rows(slot, i);
        return
    }
    bb_reader_link(ReaderFollows.ByComment)
}

// A reader's screen begun: its title the chapter at its top; a plain page,
// as the page is (no list's insets at its sides).
bb_reader_title(id: int, kind: int, arg: int) {
    if (bb_reader_c < 0 || bb_reader_c >= chapters) {
        bb_reader_c = (if (sk_c >= 0 && sk_c < chapters) sk_c else 0);
        bb_reader_v = sk_v
    }
    fbuf_n = 0;
    fput_title(bb_reader_c);
    ui_begin(id, kind, arg, "");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_page = true
}

// The reader's place, how it follows the page, and its link button
// (filled while linked).
bb_reader_link(follows: ReaderFollows) {
    linked: bool = sk_beside_linked();
    ui_set_reader(bb_reader_c, bb_reader_v, linked, follows);
    ui_tool("", "link", ACT_BESIDE_LINK, 0, if (linked) UI_TOOL_PROMINENT else UI_TOOL_PLAIN,
        2);
    fbuf_n = 0;
    fput_str(if (linked) "Linked with the Page" else "Not Linked");
    ui_set_tool_label_fbuf()
}

// The panel's reader's screen (its index; -1: none).
bb_reader_at(): int {
    top: int = sk_beside_top();
    if (!sk_has_panel_reader || top < 0 || sk_kinds[top] != SCR_BESIDE_BIBLE && sk_kinds[top] != SCR_SHELF_COMMENTARY) return -1;
    top
}

// `besidewant C`: chapter c of what the panel reads, as its reader's lines:
// a version's; a commentary's comments, or, not here yet, a line that says
// it is coming (the chapter told again when it has come).
sk_beside_want(c: int) {
    at: int = bb_reader_at();
    if (at < 0 || c < 0 || c >= chapters) return;
    if (sk_kinds[at] == SCR_SHELF_COMMENTARY) {
        bb_write_comments(sk_args[at] / SHELF_PLACE, c);
        return
    }
    t: int = sk_args[at] / SHELF_PLACE;
    if (t != text_cur && !text_ready(t)) return;
    sk_write_chapter_as(t, c, "besidechapter ")
}

// The commentary chapters told as coming, to be told again as they come
// (a flag each chapter of the Bible's).
bb_coming: []bool = new bool[len(ch_num)](false);

bb_write_comments(slot: int, c: int) {
    if (shelf_lay_commentary(slot, c, &sk_layout)) {
        bb_coming[c] = false;
        measure_chapter(&sk_layout, &sk_ranges, c);
        sk_write_laid(c, "besidechapter ", LaidText.Comments);
        return
    }
    bb_coming[c] = true;
    layout_begin(&sk_layout);
    lay_begin(&sk_layout, STYLE_REF, PARA_PROSE, 0);
    lay_str(&sk_layout, "Opening\â\€\¦");
    measure_chapter(&sk_layout, &sk_ranges, c);
    sk_write_laid(c, "besidechapter ", LaidText.Comments)
}

// A commentary's text come (shelf_screens_changed): the chapters told as
// coming told again, those that have come, and the reader told to show
// them (`besidechapterready C`).
bb_comments_came() {
    at: int = bb_reader_at();
    if (at < 0 || sk_kinds[at] != SCR_SHELF_COMMENTARY) return;
    slot: int = sk_args[at] / SHELF_PLACE;
    for c in 0..chapters {
        if (bb_coming[c] && shelf_lay_commentary(slot, c, &sk_layout)) {
            bb_coming[c] = false;
            measure_chapter(&sk_layout, &sk_ranges, c);
            sk_write_laid(c, "besidechapter ", LaidText.Comments);
            ui_effect("besidechapterready", c, -1)
        }
    }
}

// `besideplace C V`: the panel's reader's top. Its title made again as its
// chapter changes; moved by a hand while linked (or filling the screen,
// leading), the page follows it.
sk_beside_placed(c: int, v: int) {
    at: int = bb_reader_at();
    if (at < 0 || c < 0 || c >= chapters) return;
    was: int = bb_reader_c;
    bb_reader_c = c;
    bb_reader_v = v;
    if (c != was) bb_remake(at);
    // (A skin that links them as they scroll has moved the page already.)
    leads: bool = sk_beside_linked() && !sk_panel_links_live && (bb_hand || sk_beside_full());
    if (leads && (c != sk_c || v != sk_v)) ui_effect("jump", c, v)
}

// `besidemoving`: the panel's reader moved by a hand: it leads, until the
// page is moved by a hand or jumps.
sk_beside_hand() {
    if (bb_reader_at() >= 0) bb_hand = true
}

// The page moved by a hand (`moving`), or jumped: it leads again.
sk_beside_page_hand() {
    bb_hand = false
}

// The page at rest at chapter c, verse v: the panel's reader moved there,
// linked (not while it leads: the page is following it; nor where the
// skin keeps them linked as they scroll).
bb_reader_follow(at: int, c: int, v: int) {
    if (sk_panel_links_live) return;
    bb_reader_jump_to(at, c, v)
}

// The page jumped to chapter c, verse v (or at rest there): the panel's
// reader moved there, linked (not while it leads).
bb_reader_jump_to(at: int, c: int, v: int) {
    if (!sk_beside_linked() || bb_hand) return;
    // (A commentary's reader goes to the latest of its verses at or
    // before v: a comment's first, or a verse its author labelled in it.)
    was: int = bb_reader_c;
    bb_reader_c = c;
    bb_reader_v = v;
    if (c != was) bb_remake(at);
    ui_effect("besidejump", c, v)
}

// Link or Unlink: linked again, the reader comes to the page's place.
sk_beside_link_toggle(at: int) {
    linked: bool = !sk_beside_linked();
    set_pref_on("besideLinked", linked);
    sk_save();
    bb_hand = false;
    if (linked) {
        bb_reader_c = sk_c;
        bb_reader_v = sk_v
    }
    bb_remake(at);
    if (linked) ui_effect("besidejump", sk_c, sk_v)
}

// The panel's reader's screen made again (its title, its button).
bb_remake(at: int) {
    sk_build(at);
    ui_effect("update", sk_ids[at], -1)
}

// Every chapter laid out again (the look or the settings changed): the
// panel's reader's too, at its place.
sk_beside_relayout() {
    if (bb_reader_at() < 0) return;
    ui_effect("besiderelayout", -1, -1);
    ui_effect("besidejump", bb_reader_c, bb_reader_v)
}

// The page jumped to chapter c, verse v (Go To, a link, a ribbon): what
// the panel reads follows it there, a version's reader as a jump.
sk_beside_jumped(c: int, v: int) {
    at: int = bb_reader_at();
    if (at < 0) {
        sk_beside_rest(c, v);
        return
    }
    if (sk_beside_held_c >= 0 && c == sk_beside_held_c) return;
    sk_beside_held_c = -1;
    bb_reader_jump_to(at, c, v)
}

// A version or a commentary opened beside the page anew: at the page's
// place, the page leading, no chapter waited for.
bb_reader_begin() {
    bb_hand = false;
    for c in 0..len(bb_coming) bb_coming[c] = false;
    bb_reader_c = (if (sk_c >= 0 && sk_c < chapters) sk_c else 0);
    bb_reader_v = sk_v
}
