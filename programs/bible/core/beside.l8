tag bible;

use_tag std;

// The panel beside the page (SKINS.md, group 1): what is read with the
// Bible, kept beside it while the page is read. A skin lays it out where
// it fits (`panelfits`): at the page's right on a wide window, under it on
// a phone; others open its screens over the page as any other's.
//
// Its screens, bottom to top: its reader, the document read beside the
// page (a version of the Bible or a commentary, following the page), if
// one is; Study over it, if a verse is being studied (its Back goes to the
// reader). Nothing else stacks in it: the reader's name opens Go To aimed
// at the panel (core/documents.l8), as a sheet, to read another there. Its
// close (or the bar's panel button, or ⌥⌘I) puts it away, and it opens
// again as it was left: whether it is open (besideOpen), the document
// beside the page (a version, besideVersion, its text plus one; else a
// commentary, besideSlot, its shelf slot plus one; 0 none: at most one is
// set, by sk_beside_keep) and Study's verse (studyBeside,
// studyBesideChapter as the chapter plus one, studyBesideVerse). With
// nothing read there yet, the bar's panel button opens Go To aimed at the
// panel instead, and the panel opens once something is picked.
//
// The panel may fill the screen instead (`tap full`: besideFull), what it
// reads read on its own over the Bible. Beside the Bible, the Bible leads:
// a commentary follows the page. Filling the screen, what it reads leads:
// the Bible under it follows a commentary's chapter, so that it is there
// as the panel goes beside it again. A reference tapped in what the panel
// reads is shown in the Bible (the panel beside it again, if it filled the
// screen), a commentary staying where it is. Study, opened from the Bible,
// goes on the panel's screens.
//
// Core says whether it is wanted open and whether it fills the screen
// (`beside OPEN FULL`); a skin opening it asks for its screens
// (`panelmake`), which come as the panel's (`panel` its first, `push`
// Study, each a screen of group 1); a skin closing it says so
// (`closegroup 1`).
import "skin.l8";

// Whether the skin's panel fits now (`panelfits`: a skin without one never
// says).
sk_panel_fits: bool = false;

sk_beside_open(): bool {
    pref_on("besideOpen", false)
}

// Whether the panel fills the screen.
sk_beside_full(): bool {
    sk_beside_open() && pref_on("besideFull", false)
}

// How many of the screens are the panel's (they are first).
sk_beside_count(): int {
    n: int = 0;
    while (n < sk_n && sk_groups[n] == 1) n = n + 1;
    n
}

// The panel's top screen (-1: none).
sk_beside_top(): int {
    sk_beside_count() - 1
}

// `beside OPEN FULL`: whether the panel is wanted open, whether it fills
// the screen; at `start` and as they change.
sk_write_beside() {
    ui_str("beside ");
    ui_int(if (sk_beside_open()) 1 else 0);
    ui_byte(32);
    ui_int(if (sk_beside_full()) 1 else 0);
    ui_byte(10)
}

// `tap full`: the panel filling the screen, or beside the Bible again.
sk_beside_full_toggle() {
    if (sk_beside_full()) sk_beside_unfill() else if (sk_beside_open()) {
        set_pref_on("besideFull", true);
        sk_save();
        sk_write_beside();
        bb_reader_remade();
        // (The page stays where it is under the panel: a round trip to
        // Full Screen leaves it there; read on in the panel, the page
        // follows by the rule once the panel is beside it again.)
        pane_leader = PANE_PANEL
    }
}

// The panel beside the Bible again.
sk_beside_unfill() {
    set_pref_on("besideFull", false);
    sk_save();
    sk_write_beside();
    bb_reader_remade()
}

// The panel's reader's screen made again, if it shows (its menu names
// what Full Screen would do now).
bb_reader_remade() {
    at: int = bb_reader_at();
    if (at >= 0) bb_remake(at)
}

// The panel's reader filling the screen leads the Bible: the Bible under
// it to its place, there as the panel goes beside it again.
sk_beside_lead() {
    if (!sk_beside_full() || bb_reader_at() < 0) return;
    pane_leader = PANE_PANEL;
    pane_go_verse(PANE_PAGE, bb_reader_c, bb_reader_v, 0, PANE_GO_AT_ONCE)
}

// Reference ref (packed) tapped in what the panel reads: the Bible there,
// what the panel reads staying where it is (it leads, until a hand moves
// the page).
sk_beside_reference(ref: int) {
    xref_unpack(ref);
    c: int = xref_chapter();
    if (c < 0 || c >= chapters) return;
    sk_beside_bible_to(c, xr_v)
}

// The Bible to chapter c, verse v, from what the panel reads (a reference,
// a comment's verses): the panel beside it again if it fills the screen,
// and what it reads staying where it is.
sk_beside_bible_to(c: int, v: int) {
    if (sk_beside_full()) sk_beside_unfill();
    sk_goto_beside_staying(c, v)
}

// The bar's panel button (`tap shelf`), ⌥⌘I: the panel put away if it is
// open, else opened as it was left; with nothing to read there, Go To
// aimed at the panel (the panel opens once something is picked). Without
// a panel that fits, Go To aimed at the page.
sk_beside_toggle() {
    if (sk_beside_open()) {
        doc_arrival_end(PANE_PANEL);
        sk_beside_closed();
        sk_close_group(1);
        sk_write_beside();
        return
    }
    if (!sk_panel_fits) {
        sk_open(SCR_GOTO, GOTO_PAGE, false);
        return
    }
    if (!sk_beside_has_document()) {
        sk_open(SCR_GOTO, GOTO_PANEL, false);
        return
    }
    set_pref_on("besideOpen", true);
    sk_save();
    sk_write_beside()
}

// Whether the panel has a document to read: a version it can read, or a
// commentary here; or one on its way to it (core/documents.l8's arrival:
// "Opening…" in its place until it comes).
sk_beside_has_document(): bool {
    match sk_beside_kept() {
        NoDocument -> false;
        Version v -> sk_beside_can_read(v.text) || sk_beside_awaits_kept();
        Module m -> {
            i: int = shelf_find_slot(m.slot);
            i >= 0 && shelf_kind_at(i) == SHELF_KIND_COMMENTARY && (shelf_here_at(i) || sk_beside_awaits_kept())
        }
    }
}

// Whether what the panel keeps is the module on its way to it.
sk_beside_awaits_kept(): bool {
    doc_panel_keeps(doc_arriving_slot(PANE_PANEL))
}

// A commentary in slot read beside the page, chosen over it (Go To's): the
// panel opened at it, or, open, made again with it on top, Study let go.
sk_beside_read(slot: int) {
    sk_beside_keep(PanelDocument.Module { slot: slot });
    bb_reader_begin();
    sk_beside_show_kept()
}

// A document picked in Go To aimed at the panel, read there at the
// panel's place (unlinked, the chapter and verse at its reading line; else
// the page's), Study let go; the panel opened at it if it was away.
sk_beside_read_in_place(document: PanelDocument) {
    stays: bool = bb_reader_at() >= 0 && !sk_beside_linked();
    c: int = bb_reader_c;
    v: int = bb_reader_v;
    sk_beside_keep(document);
    bb_reader_begin();
    if (stays) {
        bb_reader_c = c;
        bb_reader_v = v
    }
    sk_beside_show_kept();
    if (stays) pane_go_verse(PANE_PANEL, c, v, 0, PANE_GO_AT_ONCE)
}

// A passage picked in Go To aimed at the panel while it is unlinked: only
// the panel's reader goes there (a commentary to the comment on its verse,
// or its part for a run of chapters it says nothing on), the sheets put
// away.
sk_beside_go(c: int, v: int) {
    if (c < 0 || c >= chapters) return;
    sk_dismiss();
    pane_go_verse(PANE_PANEL, c, v, 0, PANE_GO_AT_ONCE);
    bb_reader_placed(c, v)
}

// The panel shown with the document kept on top, Study let go: made again
// if it is open, else opened (the skin then asks for its screens).
sk_beside_show_kept() {
    set_pref_on("studyBeside", false);
    if (sk_beside_open() && sk_beside_count() > 0) {
        sk_save();
        sk_beside_make();
        return
    }
    set_pref_on("besideOpen", true);
    sk_save();
    sk_write_beside()
}

// What the panel reads beside the page, as it is kept: a version, a
// commentary (a Bookshelf module, by its slot), or neither.
type PanelDocument =
    | NoDocument
    | Version { text: int }
    | Module { slot: int }

sk_beside_kept(): PanelDocument {
    t: int = pref_get("besideVersion") - 1;
    if (t >= 0) return PanelDocument.Version { text: t };
    slot: int = pref_get("besideSlot") - 1;
    if (slot >= 0) return PanelDocument.Module { slot: slot };
    PanelDocument.NoDocument
}

// The document the panel reads kept (not saved: the caller saves).
sk_beside_keep(document: PanelDocument) {
    match document {
        NoDocument -> {
            set_pref("besideVersion", 0);
            set_pref("besideSlot", 0)
        }
        Version v -> {
            set_pref("besideVersion", v.text + 1);
            set_pref("besideSlot", 0)
        }
        Module m -> {
            set_pref("besideVersion", 0);
            set_pref("besideSlot", m.slot + 1)
        }
    }
}

// Whether the panel reads version t, or the module in slot.
sk_beside_reads_version(t: int): bool {
    match sk_beside_kept() {
        Version v -> v.text == t;
        _ -> false
    }
}

sk_beside_reads_module(slot: int): bool {
    match sk_beside_kept() {
        Module m -> m.slot == slot;
        _ -> false
    }
}

// `panelmake`: the panel's screens made as it was left (the skin opening
// it): the reader of what it reads beside the page, Study at its verse.
// With neither (what it read removed), it is closed again.
sk_beside_make() {
    sk_close_group(1);
    if (sk_beside_has_document()) {
        bb_reader_begin();
        match sk_beside_kept() {
            Version v -> sk_beside_push(SCR_BESIDE_BIBLE, v.text * SHELF_PLACE);
            Module m -> shelf_open_reading(shelf_find_slot(m.slot), true);
            NoDocument -> { }
        }
    } else sk_beside_keep(PanelDocument.NoDocument);
    if (pref_on("studyBeside", false)) {
        c: int = pref_get("studyBesideChapter") - 1;
        v: int = pref_get("studyBesideVerse");
        if (c >= 0 && c < chapters) sk_beside_push(SCR_VERSE_STUDY, (c * 1000 + v) * 4)
    }
    if (sk_beside_count() == 0) {
        sk_beside_closed();
        sk_write_beside()
    }
}

// A screen pushed on the panel's (after its last, under any sheet's).
sk_beside_push(kind: int, arg: int) {
    n: int = sk_beside_count();
    if (n == 0) {
        sk_open_panel(kind, arg);
        return
    }
    if (sk_n >= SK_SCREENS_MOST) return;
    sk_verse_study_opening(kind, arg);
    sk_shelf_opening(kind, arg);
    j: int = sk_n;
    while (j > n) {
        sk_ids[j] = sk_ids[j - 1];
        sk_kinds[j] = sk_kinds[j - 1];
        sk_args[j] = sk_args[j - 1];
        sk_groups[j] = sk_groups[j - 1];
        j = j - 1
    }
    sk_ids[n] = sk_next_id;
    sk_kinds[n] = kind;
    sk_args[n] = arg;
    sk_groups[n] = 1;
    sk_next_id = sk_next_id + 1;
    sk_n = sk_n + 1;
    sk_beside_follow(n);
    sk_build(n);
    ui_effect("push", sk_ids[n], -1)
}

// The panel closed (its close, the bar's panel button, the skin's): what it
// read beside the page kept for the next time; Study not.
sk_beside_closed() {
    set_pref_on("besideOpen", false);
    set_pref_on("besideFull", false);
    set_pref_on("studyBeside", false);
    sk_save()
}

// Screens from at on let go by the skin's Back: the panel's Study, no
// longer wanted there when it opens.
sk_beside_popped(at: int) {
    for j in at..sk_n {
        if (sk_groups[j] != 1) return;
        if (sk_kinds[j] == SCR_VERSE_STUDY) set_pref_on("studyBeside", false)
    }
}

// `panelanchor ID`: the panel shows screen id on top now (its Back, a
// swipe): the panel's screens above it let go, any sheet's kept.
sk_beside_anchor(id: int) {
    at: int = sk_find(id);
    count: int = sk_beside_count();
    if (at < 0 || at >= count || at == count - 1) return;
    sk_beside_popped(at + 1);
    n: int = at + 1;
    for j in count..sk_n {
        sk_ids[n] = sk_ids[j];
        sk_kinds[n] = sk_kinds[j];
        sk_args[n] = sk_args[j];
        sk_groups[n] = sk_groups[j];
        n = n + 1
    }
    sk_n = n
}

// Screen at, the panel's, shown now: what it reads kept as the panel's
// (Study's verse; the module read beside the page, and its place).
sk_beside_follow(at: int) {
    if (at < 0 || at >= sk_n || sk_groups[at] != 1) return;
    k: int = sk_kinds[at];
    if (k == SCR_VERSE_STUDY) {
        cv: int = sk_args[at] / 4;
        set_pref_on("studyBeside", true);
        set_pref("studyBesideChapter", cv / 1000 + 1);
        set_pref("studyBesideVerse", cv % 1000);
        sk_save()
    } else if (k == SCR_BESIDE_BIBLE) {
        sk_beside_keep(PanelDocument.Version { text: sk_args[at] / SHELF_PLACE });
        sk_save();
        if (at == sk_beside_top()) sk_beside_lead()
    } else if (k == SCR_SHELF_COMMENTARY) {
        slot: int = sk_args[at] / SHELF_PLACE;
        // (Not what it read: its reader begun anew, at the page's place.)
        if (!sk_beside_reads_module(slot)) bb_reader_begin();
        sk_beside_keep(PanelDocument.Module { slot: slot });
        sk_save();
        // (A commentary opened filling the screen: the Bible to its
        // chapter.)
        if (at == sk_beside_top()) sk_beside_lead()
    }
}

// Whether Study shows in the panel now (its top, the panel in sight).
sk_beside_studying(): bool {
    top: int = sk_beside_top();
    sk_panel_shown && top >= 0 && sk_kinds[top] == SCR_VERSE_STUDY
}

// The panel's Study screen (its index; -1: none).
sk_beside_at(): int {
    for j in 0..sk_beside_count()
        if (sk_kinds[j] == SCR_VERSE_STUDY) return j;
    -1
}

// The tray's Study where the panel fits: Study pushed on the panel at the
// verse (or, there already, showing it); the panel opened if it is away.
sk_beside_study(c: int, v: int) {
    set_pref_on("studyBeside", true);
    set_pref("studyBesideChapter", c + 1);
    set_pref("studyBesideVerse", v);
    if (!sk_beside_open() || sk_beside_count() == 0) {
        set_pref("studySegment", 0);
        set_pref_on("besideOpen", true);
        sk_save();
        sk_write_beside();
        return
    }
    sk_save();
    at: int = sk_beside_at();
    if (at < 0) {
        set_pref("studySegment", 0);
        sk_beside_push(SCR_VERSE_STUDY, (c * 1000 + v) * 4);
        // (The tray's Study reading Studying now.)
        if (sk_sel_n > 0) {
            sk_build_tray();
            ui_write();
            ui_effect("tray", -1, -1)
        }
        return
    }
    sk_vs_show(sk_ids[at], c, v);
    ui_effect("refill", sk_ids[at], 1)
}

// Verses selected while the panel shows Study (the first shown there), a
// commentary (the first's comment shown there) or a version (the first's
// paragraph shown there).
sk_beside_select() {
    if (sk_sel_n == 0 || sk_sheet_top() >= 0) return;
    top: int = sk_beside_top();
    if (top < 0) return;
    if (sk_kinds[top] == SCR_VERSE_STUDY) {
        if (!sk_panel_shown) return;
        cv: int = sk_args[top] / 4;
        if (cv / 1000 == sk_sel_c && cv % 1000 == sk_sel_v[0]) return;
        sk_vs_show(sk_ids[top], sk_sel_c, sk_sel_v[0]);
        sk_beside_follow(top);
        ui_effect("refill", sk_ids[top], 1);
        return
    }
    // (The panel's reader, linked: to the first verse selected, the page
    // leading.)
    if (bb_reader_at() == top && sk_beside_linked()) pane_panel_to(sk_sel_c, sk_sel_v[0],
        0)
}

// ---- the panel's reader ----
// A version or a commentary read beside the page (SCR_BESIDE_BIBLE: its
// arg its text times SHELF_PLACE; SCR_SHELF_COMMENTARY: its slot times
// SHELF_PLACE) is read in the panel's reader, pane 1 of core/panes.l8, as
// the page is: every chapter in turn, a part at a time. Linked with the
// page (besideLinked, the default), the two move together, whichever a
// hand moved last leading; unlinked, neither moves the other, and linked
// again the reader comes to the page's place. Its foot's button links and
// unlinks them. The ESV, read only where the page asks for its chapters,
// isn't read here.
SCR_BESIDE_BIBLE: int = 67;

// Link or Unlink.
ACT_BESIDE_LINK: int = 332;

// Swap Panes.
ACT_BESIDE_SWAP: int = 334;

// The reader's menu (its "…"), arg what its item does.
ACT_BESIDE_MENU: int = 335;

BESIDE_MENU_SWAP: int = 0;

BESIDE_MENU_FULL: int = 1;

BESIDE_MENU_CLOSE: int = 2;

// The reader's document's name, at the left of its bar: Go To aimed at the
// panel, to read another there.
ACT_BESIDE_GOTO: int = 336;

// Whether version t can be read beside the page: one offered here.
sk_beside_can_read(t: int): bool {
    if (t == TEXT_ESV || t < 0) return false;
    if (t == TEXT_ORIG) return sk_has_orig;
    t < TEXT_ESV || text_is_version(t)
}

// The panel's reader's place as its title names it: the chapter and verse
// at its reading line (-1: none yet).
bb_reader_c: int = -1;

bb_reader_v: int = 0;

// Whether the panel's reader is linked with the page.
sk_beside_linked(): bool {
    pref_on("besideLinked", true)
}

// A version read in the panel's reader (its arg its text times
// SHELF_PLACE), named by its name (filling the screen, its abbreviation,
// before the chapter).
sk_build_beside_bible(id: int, arg: int) {
    t: int = arg / SHELF_PLACE;
    bb_reader_title(id, SCR_BESIDE_BIBLE, arg);
    fbuf_n = 0;
    if (doc_arriving_slot(PANE_PANEL) >= 0) fput_doc_arriving_name(PANE_PANEL) else if (sk_beside_full()) fput_text_abbr(t) else fput_text_name(t);
    bb_reader_name_fbuf();
    // (On its way: "Opening…" in its place, a pane's one part.)
    if (sk_beside_awaits_kept() && !text_ready(t)) {
        bb_reader_link();
        return
    }
    if (!sk_beside_can_read(t)) {
        ui_set_empty("books.vertical", "Not Here", "");
        return
    }
    // (Not read yet: a row that says it is opening, the screen made again
    // when it has come.)
    if (t != text_cur && !text_ready(t) && sk_num_of(SK_NUM_TEXT, t) != 1) {
        ui_section("", "");
        ui_row(UI_ITEM, 0, 0);
        fbuf_n = 0;
        fput_str("Opening ");
        fput_text_abbr(t);
        fput_str("...");
        ui_set_title_fbuf();
        ui_set_busy();
        ui_set_faint();
        return
    }
    bb_reader_link()
}

// A commentary read in the panel's reader (its arg its slot times
// SHELF_PLACE), named by its short title (Spurgeon's Treasury of David;
// filling the screen, the bar's name, Spurgeon, before the chapter). The
// module not open yet: a row that says it is opening.
bb_build_commentary_reader(id: int, arg: int) {
    slot: int = arg / SHELF_PLACE;
    i: int = shelf_find_slot(slot);
    bb_reader_title(id, SCR_SHELF_COMMENTARY, arg);
    fbuf_n = 0;
    if (doc_arriving_slot(PANE_PANEL) >= 0) fput_doc_arriving_name(PANE_PANEL) else if (sk_beside_full()) fput_shelf_bar_name_shortened(i) else fput_shelf_short_title(i);
    bb_reader_name_fbuf();
    if (i < 0) {
        ui_set_empty("books.vertical", "Not Available", "");
        return
    }
    // (On its way: "Opening…" in its place, a pane's one part.)
    if (sk_beside_awaits_kept() && !shelf_open_is(SHELF_USE_STUDY, slot)) {
        bb_reader_link();
        return
    }
    if (!shelf_ensure_open(slot)) {
        shelf_opening_rows(slot, i);
        return
    }
    bb_reader_link()
}

// A reader's screen begun: its title the chapter at its reading line while
// that isn't the page's (the bar above names the page's) or the panel
// fills the screen, else none (skins draw it after the name, a faint
// middot between: "Spurgeon · Psalm 147"); a plain page, as the page is
// (no list's insets at its sides).
bb_reader_title(id: int, kind: int, arg: int) {
    if (bb_reader_c < 0 || bb_reader_c >= chapters) {
        bb_reader_c = (if (sk_c >= 0 && sk_c < chapters) sk_c else 0);
        bb_reader_v = sk_v
    }
    fbuf_n = 0;
    // (Filling the screen, always: the page's bar, which names it, is
    // under the panel.)
    if (bb_reader_c != sk_c || sk_beside_full()) fput_title(bb_reader_c);
    bb_reader_titled_c = sk_c;
    ui_begin(id, kind, arg, "");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_page = true
}

// The page's chapter as the reader's title was made for it (the title made
// again as the page's chapter comes to the reader's or leaves it).
bb_reader_titled_c: int = -1;

// The reader's document named (fbuf's words) at the left of its bar, in
// place of Back: a tap opens Go To aimed at the panel, to read another.
bb_reader_name_fbuf() {
    ui_set_left("", "chevron.down", ACT_BESIDE_GOTO, UI_TOOL_PLAIN);
    ui_set_left_title_fbuf()
}

// The screen a reader, and its buttons at the right: Link (prominent while
// linked) and a menu (Swap Panes, Full Screen or Beside the Page, Close
// Panel); the reader to the page's place, if it has none yet.
bb_reader_link() {
    linked: bool = sk_beside_linked();
    ui_set_reader(linked);
    ui_tool("", "link", ACT_BESIDE_LINK, 0, if (linked) UI_TOOL_PROMINENT else UI_TOOL_PLAIN,
        2);
    fbuf_n = 0;
    fput_str(if (linked) "Linked with the Page" else "Not Linked");
    ui_set_tool_label_fbuf();
    ui_tool("", "ellipsis", ACT_BESIDE_MENU, 0, UI_TOOL_PLAIN, 2);
    fbuf_n = 0;
    if (sk_beside_can_swap()) {
        fput_int(BESIDE_MENU_SWAP);
        fput_str(":Swap Panes|")
    }
    fput_int(BESIDE_MENU_FULL);
    fput(58);
    fput_str(if (sk_beside_full()) w_unfull_beside else w_full_beside);
    fput(124);
    fput_int(BESIDE_MENU_CLOSE);
    fput(58);
    fput_str(w_close_beside);
    ui_set_tool_menu_fbuf();
    fbuf_n = 0;
    fput_str("More");
    ui_set_tool_label_fbuf();
    pane_panel_shown()
}

// The reader's menu's item arg done.
bb_reader_menu(arg: int) {
    if (arg == BESIDE_MENU_SWAP) sk_beside_swap() else if (arg == BESIDE_MENU_FULL) sk_beside_full_toggle() else if (arg == BESIDE_MENU_CLOSE && sk_beside_open()) sk_beside_toggle()
}

// The panel's reader's screen (its index; -1: none).
bb_reader_at(): int {
    top: int = sk_beside_top();
    if (top < 0 || sk_groups[top] != 1 || sk_kinds[top] != SCR_BESIDE_BIBLE && sk_kinds[top] != SCR_SHELF_COMMENTARY) return -1;
    top
}

// The panel's reader's place (pane_at): its title made again as its
// chapter changes.
bb_reader_placed(c: int, v: int) {
    was: int = bb_reader_c;
    bb_reader_c = c;
    bb_reader_v = v;
    at: int = bb_reader_at();
    if (c != was && at >= 0) bb_title_remake(at)
}

// The page's chapter changed: the reader's title made again if the page's
// chapter came to the reader's or left it.
bb_page_placed() {
    at: int = bb_reader_at();
    if (at < 0 || bb_reader_titled_c == sk_c) return;
    on_page: bool = bb_reader_c == sk_c;
    was_on_page: bool = bb_reader_c == bb_reader_titled_c;
    if (on_page != was_on_page) bb_title_remake(at) else bb_reader_titled_c = sk_c
}

// The reader's title made again for its chapter, but not while a hand
// moves the linked panes: the two cross a chapter's border a frame or a
// line apart, and its chapter would come and go in the title. It is made
// again when the hand lets them rest (bb_reader_rested).
bb_title_due: bool = false;

bb_title_remake(at: int) {
    if (pane_linked() && pane_hand_moving) bb_title_due = true else bb_remake(at)
}

bb_reader_rested() {
    if (!bb_title_due) return;
    bb_title_due = false;
    at: int = bb_reader_at();
    if (at >= 0) bb_remake(at)
}

// Link or Unlink: linked again, the reader comes to the page's place, the
// page leading.
sk_beside_link_toggle(at: int) {
    linked: bool = !sk_beside_linked();
    set_pref_on("besideLinked", linked);
    sk_save();
    bb_remake(at);
    if (linked) pane_panel_to(sk_c, sk_v, sk_frac)
}

// Whether the page and the panel's reader can trade what they read: the
// page's version one the panel reads (not the ESV), and not a commentary
// on both.
sk_beside_can_swap(): bool {
    match page_document() {
        Bible -> sk_beside_can_read(text_cur);
        Module _m -> !sk_beside_reads_commentary()
    }
}

sk_beside_reads_commentary(): bool {
    at: int = bb_reader_at();
    at >= 0 && sk_kinds[at] == SCR_SHELF_COMMENTARY
}

// Swap Panes: what the page reads read in the panel, and what the panel
// reads on the page, each document at its own place in the other pane:
// the same anchor and as far through it at the pane's reading line, so
// that two swaps leave each where it was (a commentary's place kept by
// its comment, not by its verse: a commentator may go through the verses
// again).
sk_beside_swap() {
    at: int = bb_reader_at();
    if (at < 0 || !sk_beside_can_swap()) return;
    // (What was on its way to either no longer waited for.)
    doc_arrival_end(PANE_PAGE);
    doc_arrival_end(PANE_PANEL);
    page_c: int = sk_c;
    page_v: int = sk_v;
    page_f: int = sk_frac;
    panel_c: int = bb_reader_c;
    panel_v: int = bb_reader_v;
    page_at: PanePlace = pane_places[PANE_PAGE];
    panel_at: PanePlace = pane_places[PANE_PANEL];
    was_page: PlaceDocument = page_document();
    was_text: int = text_cur;
    panel: PanelDocument = sk_beside_kept();
    // (The panel to what the page read.)
    sk_beside_keep(match was_page {
        Bible -> PanelDocument.Version { text: was_text };
        Module m -> PanelDocument.Module { slot: m.slot }
    });
    // (The page to what the panel read.)
    match panel {
        Version v -> {
            page_read(PlaceDocument.Bible);
            if (v.text != text_cur) sk_use_version(v.text)
        }
        Module m -> page_read(PlaceDocument.Module { slot: m.slot });
        NoDocument -> { }
    }
    sk_save();
    bb_reader_begin();
    sk_beside_show_kept();
    // (Each at its own place, in the other pane; by its verse only where
    // a pane hasn't said its place yet.)
    sk_c = panel_c;
    sk_v = panel_v;
    sk_frac = (if (panel_at.c == panel_c) panel_at.frac else 0);
    if (panel_at.c == panel_c) {
        pane_go(PANE_PAGE, panel_at.c, panel_at.i, panel_at.frac, PANE_GO_AT_ONCE);
        pane_leader = PANE_PAGE
    } else pane_page_jump_alone(panel_c, panel_v, 0);
    if (page_at.c == page_c) pane_go(PANE_PANEL, page_at.c, page_at.i, page_at.frac,
        PANE_GO_AT_ONCE) else pane_go_verse(PANE_PANEL, page_c, page_v, page_f, PANE_GO_AT_ONCE);
    bb_reader_c = page_c;
    bb_reader_v = page_v;
    sk_write_title();
    sk_keep_place();
    sk_save()
}

// The panel's reader's screen made again (its title, its button): sent
// only if it changed, so that a skin's bar stays as it is.
bb_remake(at: int) {
    sk_build_sent_if_changed(at)
}

// A version or a commentary opened beside the page anew: at the page's
// place, the page leading.
bb_reader_begin() {
    bb_reader_c = (if (sk_c >= 0 && sk_c < chapters) sk_c else 0);
    bb_reader_v = sk_v;
    pane_panel_begun()
}
