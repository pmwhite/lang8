tag bible;

use_tag std;

// A data file's bytes as a dataset of their own (the plans', the
// recordings' paths, the original's words): in an arena of their own, held
// by an owner the file's module keeps, replaced whole when the file comes
// again, the one before let go. Its readers take the file they are given,
// borrowed for what they do.
type DataFile = {
    // Its bytes (size of them, a zero after), and whether they have come
    // (an empty file holds none).
    bytes: []i8;
    size: int;
    ready: bool
}

// A file holding nothing, until its bytes come.
data_file_empty(): owned *DataFile {
    own {
        new DataFile { bytes: new i8[1](0i8), size: 0, ready: false }
    }
}

// A file of n bytes read by the host (read: file id's bytes into the
// buffer given, n long and a zero after).
data_file_read(id: int, n: int, read: fn(id: int, out: []i8)): owned *DataFile {
    own {
        file: *DataFile = new DataFile { bytes: new i8[n + 1](0i8), size: n, ready: true };
        read(id, file.bytes);
        file
    }
}
