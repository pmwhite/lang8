tag bible;

use_tag std;

// The verses shared as an image (DESIGN.md ยง10.5), apart from any
// platform: whether they fit a card (at most 8 verses and 700 characters),
// their words as the card sets them, a piece at a time (words, the words
// the translation supplies, His words, both, a verse's number; poetry's
// lines kept, each piece with its paragraph's kind), and the reference and
// version under them. A skin draws the card in its own type and colors.
import "skin.l8";

// The card (pixels): a square, or (shape 1) a portrait; its margins, the
// space between the text and the reference, the reference's and the
// version's type sizes; the text set at the largest size from
// SC_SIZE_MOST down to SC_SIZE_LEAST, by SC_SIZE_STEP, that fits.
SC_SIDE: f64 = 1080.0f64;

SC_TALL: f64 = 1350.0f64;

SC_MARGIN: f64 = 110.0f64;

SC_GAP: f64 = 44.0f64;

SC_REF_SIZE: f64 = 34.0f64;

SC_VERSION_SIZE: f64 = 30.0f64;

SC_SIZE_MOST: f64 = 64.0f64;

SC_SIZE_LEAST: f64 = 34.0f64;

SC_SIZE_STEP: f64 = 2.0f64;

sc_card_height(shape: int): f64 {
    if (shape == 1) SC_TALL else SC_SIDE
}

// The card of height h laid out, its reference ref_h tall, the text's
// height at a size measured by the skin: the size (sc_size), the text's
// height then (sc_text_h; the last measured) and the block's top (sc_top:
// centered, not above the margin).
sc_size: f64 = 0.0f64;

sc_text_h: f64 = 0.0f64;

sc_top: f64 = 0.0f64;

sc_layout(h: f64, ref_h: f64, measure: fn(size: f64): f64) {
    room: f64 = h - 2.0f64 * SC_MARGIN - SC_GAP - ref_h;
    size: f64 = SC_SIZE_MOST;
    th: f64 = measure(size);
    while (size > SC_SIZE_LEAST && th > room) {
        size = size - SC_SIZE_STEP;
        th = measure(size)
    }
    sc_size = size;
    sc_text_h = th;
    sc_top = (h - th - SC_GAP - ref_h) / 2.0f64;
    if (sc_top < SC_MARGIN) sc_top = SC_MARGIN
}

SC_WORDS: int = 0;

SC_SUPPLIED: int = 1;

SC_JESUS: int = 2;

SC_JESUS_SUPPLIED: int = 3;

SC_NUMBER: int = 4;

// The pieces: their words (scw, to each scr_end), their kind (SC_) and
// paragraph's kind (text.l8's PARA_); whether the words are the
// original's, and right to left (the Hebrew).
scw: []i8 = new i8[16384](0i8);

scw_n: int = 0;

scr_end: []int = new int[2048](0);

scr_kind: []int = new int[2048](0);

scr_para: []int = new int[2048](0);

scr_n: int = 0;

sc_orig: bool = false;

sc_rtl: bool = false;

// Whether verses vs (n of them) of chapter c fit a card.
sc_fits(c: int, vs: []int, n: int): bool {
    if (c < 0 || n <= 0 || n > 8) return false;
    chars: int = 0;
    for i in 0..n {
        verse_text(c, vs[i]);
        for x in 0..vt_n {
            k: int = vt[x] as int & 255;
            if (k < 128 || k >= 192) chars = chars + 1
        }
    }
    chars <= 700
}

sc_piece(
    b: []i8,
    from: int,
    to: int,
    kind: int,
    para: int
) {
    for q in from..to {
        if (scw_n < len(scw)) {
            scw[scw_n] = b[q];
            scw_n = scw_n + 1
        }
    }
    if (scr_n < len(scr_end)) {
        scr_end[scr_n] = scw_n;
        scr_kind[scr_n] = kind;
        scr_para[scr_n] = para;
        scr_n = scr_n + 1
    }
}

sc_piece_str(s: str, kind: int, para: int) {
    for c in s {
        if (scw_n < len(scw)) {
            scw[scw_n] = c;
            scw_n = scw_n + 1
        }
    }
    if (scr_n < len(scr_end)) {
        scr_end[scr_n] = scw_n;
        scr_kind[scr_n] = kind;
        scr_para[scr_n] = para;
        scr_n = scr_n + 1
    }
}

// The card's words for verses vs of chapter c: the version read, or the
// BSB's where its chapter is not here; a verse's number (with a narrow
// space after it) where there are several; a space between verses, a line
// break where a paragraph or line breaks.
sc_card(c: int, vs: []int, n: int) {
    scw_n = 0;
    scr_n = 0;
    source: TextSource = text_source(text_cur);
    if (source.starts[c] < 0) source = text_source(TEXT_BSB);
    sc_orig = source.version == TEXT_ORIG;
    sc_rtl = sc_orig && ch_book[c] < 39;
    kind: int = PARA_PROSE;
    p: int = source.starts[c];
    e_ch: int = source.ends[c];
    inside: bool = false;
    words: bool = false;
    broke: bool = false;
    done: int = 0;
    while (p < e_ch) {
        e: int = record_line_end(source.data, source.size, p);
        k: int = source.data[p] as int;
        if (k == 86) {
            v: int = record_key_at(source.data, source.size, p + 1);
            was_in: bool = inside;
            inside = false;
            for i in 0..n
                if (vs[i] == v) inside = true;
            if (inside && !was_in && done > 0 && words) broke = true;
            if (inside) {
                if (words && !broke) sc_piece_str(" ", SC_WORDS, kind);
                if (broke && words) sc_piece_str("\n", SC_WORDS, kind);
                if (broke) broke = false;
                if (n > 1) {
                    fbuf_n = 0;
                    fput_int(record_number_at(source.data, source.size, p + 1));
                    fput_str("\โ\€\ฏ");
                    sc_piece(fbuf, 0, fbuf_n, SC_NUMBER, kind)
                }
                done = done + 1;
                words = true
            }
        } else if (k == 80) {
            m: int = source.data[p + 1] as int;
            kind = (if (m == 49) PARA_Q1 else if (m == 50) PARA_Q2 else if (m == 108) PARA_L1 else if (m == 76) PARA_L2 else PARA_PROSE);
            if (inside && words) broke = true
        } else if (inside && (k == 84 || k == 87 || k == 73 || k == 74 || k == 72 || k == 88)) {
            if (broke) {
                sc_piece_str("\n", SC_WORDS, kind);
                broke = false
            }
            sc_piece(source.data, p + 1, e, if (k == 74) SC_JESUS_SUPPLIED else if (k == 73) SC_SUPPLIED else if (k == 87) SC_JESUS else SC_WORDS,
                kind);
            words = true
        } else if (inside && k != 70 && k != 95) broke = true;
        p = e + 1
    }
}

// "John 3:16" into fbuf; then its version's short name ("BSB": the BSB's
// where the version's chapter is not here).
sc_ref(c: int, vs: []int, n: int) {
    fbuf_n = 0;
    put_ref(c, vs, n)
}

sc_version(c: int) {
    fbuf_n = 0;
    fput_version_short(if (ch_start[c] < 0) TEXT_BSB else text_cur, c)
}

// ---- the composer (a skin that draws cards: sk_has_card) ----
// Share from the tray opens it where the verses fit a card: the card
// (CUSTOM_CARD), its shape (the segments: Square, Portrait), its
// background (the five themes' swatches), Share Image (share_image: the
// skin draws the card it was last given and shares it, its platform's
// way) and Share Text (the words, as Share without a card).
SCR_SHARE: int = 49;

ACT_SH_SHAPE: int = 183;

ACT_SH_THEME: int = 184;

ACT_SH_IMAGE: int = 185;

ACT_SH_TEXT: int = 186;

// The card's words as runs (CUSTOM_CARD's detail): RUN_CARD plus the
// piece's kind (SC_), 8 if its line is indented (poetry's second level),
// 16 the Greek, 32 the Hebrew (right to left), 64 a divine name's letters
// after its first (small capitals). His words are SC_WORDS where the
// reader doesn't have them in red.
RUN_CARD: int = 300;

// The verses being shared.
scs_c: int = -1;

scs_v: []int = new int[8](0);

scs_n: int = 0;

// Share chosen for verses vs of chapter c: the composer, if the skin draws
// cards and they fit one (whether it opened).
sk_share_card(c: int, vs: []int, n: int): bool {
    if (!sk_has_card || !sc_fits(c, vs, n)) return false;
    scs_c = c;
    scs_n = n;
    for i in 0..n scs_v[i] = vs[i];
    sk_open(SCR_SHARE, 0, false);
    true
}

// The background chosen (a theme, 1 to 5): at first the reader's (Auto's
// being Paper or Night now).
sc_theme(): int {
    t: int = pref_get("shareTheme");
    if (t >= 1 && t <= 5) return t;
    th: int = theme_now(clamp_index(pref_get("theme"), len(t_bg)), sk_dark);
    if (th < 1 || th > 5) 1 else th
}

sk_build_share(id: int) {
    ui_begin(id, SCR_SHARE, 0, share_image_title);
    shape: int = pref_get("shareShape");
    t: int = sc_theme();
    ui_set_segments("Square|Portrait", shape, ACT_SH_SHAPE);
    if (scs_c < 0 || scs_n == 0) return;
    ui_section("", "");
    ui_row(UI_CUSTOM, 0, 0);
    ui_set_custom(CUSTOM_CARD);
    ui_rows[ui_last()].value = shape;
    sc_ref(scs_c, scs_v, scs_n);
    ui_set_title_fbuf();
    sc_version(scs_c);
    ui_set_suffix_fbuf();
    // (Its colors: the page's, the words', the faint's, the accent's.)
    fbuf_n = 0;
    fput_str(t_bg[t]);
    fput(124);
    fput_str(t_ink[t]);
    fput(124);
    fput_str(t_faint[t]);
    fput(124);
    fput_str(t_accent[t]);
    ui_rows[ui_last()].options = ui_put_fbuf();
    // (Core's measures: the card's width and height, its margin, the gap
    // over the reference, the reference's and version's sizes, and the
    // words' sizes, most to least, by a step; lines 1.35 high (1.5 in
    // Hebrew), poetry's second level 40 in.)
    fbuf_n = 0;
    fput_int(SC_SIDE as int);
    fput(32);
    fput_int(sc_card_height(shape) as int);
    fput(32);
    fput_int(SC_MARGIN as int);
    fput(32);
    fput_int(SC_GAP as int);
    fput(32);
    fput_int(SC_REF_SIZE as int);
    fput(32);
    fput_int(SC_VERSION_SIZE as int);
    fput(32);
    fput_int(SC_SIZE_MOST as int);
    fput(32);
    fput_int(SC_SIZE_LEAST as int);
    fput(32);
    fput_int(SC_SIZE_STEP as int);
    ui_set_trailing_fbuf();
    sc_card_runs();
    ui_set_detail_fbuf();
    for x in 0..sk_runs_n ui_add_run(sk_run_end[x], sk_run_style[x]);
    // (Said: the verses' words and their reference.)
    fbuf_n = 0;
    for i in 0..scs_n {
        if (i > 0) fput(32);
        verse_text(scs_c, scs_v[i]);
        for x in 0..vt_n fput(vt[x] as int)
    }
    fput_str(", ");
    put_ref(scs_c, scs_v, scs_n);
    ui_set_label_fbuf();
    ui_section("Background", "");
    ui_row(UI_CUSTOM, ACT_SH_THEME, 0);
    ui_set_custom(CUSTOM_SWATCHES);
    fbuf_n = 0;
    for j in 1..6 {
        if (j > 1) fput(124);
        fput_str(t_bg[j])
    }
    ui_rows[ui_last()].options = ui_put_fbuf();
    fbuf_n = 0;
    for j in 0..5 {
        if (j > 0) fput(124);
        fput_str(share_backgrounds[j])
    }
    ui_set_detail_fbuf();
    ui_rows[ui_last()].value = t - 1;
    ui_section("", "");
    ui_row(UI_ITEM, ACT_SH_IMAGE, 0);
    ui_set_title(share_image_title);
    ui_set_icon("square.and.arrow.up");
    ui_set_tinted();
    ui_row(UI_ITEM, ACT_SH_TEXT, 0);
    ui_set_title("Share Text");
    ui_set_icon("text.quote")
}

// The card's words into fbuf, its runs sk_run_end/sk_run_style.
sc_card_runs() {
    sc_card(scs_c, scs_v, scs_n);
    red: bool = pref_is("redLetter");
    script: int = if (sc_rtl) 32 else if (sc_orig) 16 else 0;
    fbuf_n = 0;
    sk_runs_n = 0;
    sk_run_u = 0;
    p: int = 0;
    for r in 0..scr_n {
        e: int = scr_end[r];
        k: int = scr_kind[r];
        if (!red && k == SC_JESUS) k = SC_WORDS;
        if (!red && k == SC_JESUS_SUPPLIED) k = SC_SUPPLIED;
        para: int = scr_para[r];
        style: int = RUN_CARD + k + script + (if (para == PARA_Q2 || para == PARA_L2) 8 else 0);
        at: int = fbuf_n;
        i: int = p;
        while (i < e) {
            d: int = if (sc_orig || k == SC_NUMBER) 0 else record_divine_at(scw, i,
                e);
            if (d > 0) {
                fput(scw[i] as int);
                sk_cmp_run(at, style);
                at = fbuf_n;
                for q in i + 1..i + d fput(scw[q] as int);
                sk_cmp_run(at, style + 64);
                at = fbuf_n;
                i = i + d
            } else {
                fput(scw[i] as int);
                i = i + 1
            }
        }
        sk_cmp_run(at, style);
        p = e
    }
}

sk_share_act(action: int, value: int) {
    if (action == ACT_SH_SHAPE) {
        set_pref("shareShape", if (value == 1) 1 else 0);
        sk_save();
        sk_update_all();
        return
    }
    if (action == ACT_SH_THEME) {
        set_pref("shareTheme", if (value < 0) 1 else if (value > 4) 5 else value + 1);
        sk_save();
        sk_update_all();
        return
    }
    if (scs_c < 0 || scs_n == 0) return;
    // (The words with it, and the card's name: "John 3:16 BSB.png".)
    fbuf_n = 0;
    put_quote(scs_c, scs_v, scs_n);
    if (action == ACT_SH_IMAGE) ui_effect_fbuf("share_image") else ui_effect_fbuf("share");
    sk_dismiss();
    sk_sel_clear()
}
