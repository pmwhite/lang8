tag bible;

use_tag std, sword;

// What can be read, as Go To lists it (core's screen, every skin's): the
// documents wherever they are kept (the bundled versions, the Hebrew and
// Greek, the ESV, the Bookshelf's modules from CrossWire's library, and the
// library's catalog), each a row of one model; how a query finds them; and
// opening one, which reads it at once if it is on the device, else fetches
// and makes it while the pane goes on showing what it shows, then changes
// to it at the same place (an arrival).
//
//   Go To (SCR_GOTO, core/skin.l8) is one screen wherever it opens. Its
//   argument says only where a pick lands: the page (GOTO_PAGE: the bar's
//   title) or the panel (GOTO_PANEL: the panel's name). What is picked in
//   it, or in a screen pushed over it, is read there (sk_aims_panel).
//
// Whether a document is on the device is never shown: Go To lists what can
// open now (online, the catalog's documents too; offline, those here), and
// a pick of one not here opens it all the same.
//
// A query finds a document by the beginning of a word, in any case, of its
// title, its short name or abbreviation, its module's name, its language's
// English name or its own name, or a word for its kind ("commentaries",
// "lexicon": three letters begun are enough); a query of several words
// finds what every one of them finds ("commentaries franÃ§ais").
GOTO_PAGE: int = 0;

GOTO_PANEL: int = 1;

// Go To's Show All (arg the section: a kind's group, or DOC_SECTION_*): its
// section made again with every row, in place.
ACT_DOC_SHOW_ALL: int = 302;

// A language's row (arg the document it was counted by: doc_ref): its name
// put in the field; refining a kind's query, the kind's word and its name
// ("Commentaries Deutsch").
ACT_DOC_LANGUAGE: int = 303;

ACT_DOC_LANGUAGE_REFINE: int = 306;

// The catalog's document not on the device opened (arg its place in the
// catalog).
ACT_DOC_OPEN_ENTRY: int = 305;

// A Browse row (arg a kind's group, or DOC_SECTION_LANGUAGES): its word put
// in the field, as if it was typed.
ACT_DOC_BROWSE: int = 314;

// A bundled version's â“˜ (arg its text): its page.
ACT_DOC_VERSION_INFO: int = 323;

// ---- which pane a screen serves ----
// Whether what is picked in screen at is read in the panel: the Go To it
// is in (at, or under it in its group) is aimed at the panel; without one,
// whether it is the panel's own.
sk_aims_panel(at: int): bool {
    if (at < 0 || at >= sk_n) return false;
    group: int = sk_groups[at];
    j: int = at;
    while (j >= 0 && sk_groups[j] == group) {
        if (sk_kinds[j] == SCR_GOTO) return sk_args[j] == GOTO_PANEL;
        j = j - 1
    }
    group == 1
}

// The sheet put away, if screen at is the sheet's (a pick read in the
// panel from Study's own list leaves the panel's screens).
doc_leave_sheet(at: int) {
    if (at >= 0 && at < sk_n && sk_groups[at] == 0) sk_dismiss()
}

// Version t read from screen at: in the panel if it is aimed there (at the
// panel's place, linked the page's), else on the page; the sheet put away,
// and anything on its way to that pane no longer waited for.
doc_read_version(at: int, t: int) {
    doc_note_version_read(t);
    if (sk_aims_panel(at)) {
        doc_leave_sheet(at);
        doc_arrival_end(PANE_PANEL);
        sk_beside_read_in_place(PanelDocument.Version { text: t });
        return
    }
    doc_arrival_end(PANE_PAGE);
    sk_use_version(t);
    doc_leave_sheet(at)
}

// ---- the kinds ----
// The kinds a list groups documents in, in order: Bibles, Commentaries,
// Dictionaries (glossaries among them), Devotionals and Books.
DOC_GROUPS: int = 5;

DOC_GROUP_BIBLES: int = 0;

DOC_GROUP_COMMENTARIES: int = 1;

doc_group_titles: []str = ["Bibles", "Commentaries", "Dictionaries", "Devotionals",
    "Books"];

// The group a module's kind is listed in (-1: none: pictures, others).
doc_group_of(kind: ModuleKind): int {
    match kind {
        Bible -> 0;
        Commentary -> 1;
        Dictionary -> 2;
        Glossary -> 2;
        Devotional -> 3;
        Book -> 4;
        _ -> -1
    }
}

// The words a query names a group by (doc_kind_word_groups: each word's),
// whole or begun with at least DOC_KIND_LETTERS_LEAST letters.
doc_kind_words: []str = ["bible", "bibles", "commentary", "commentaries", "dictionary",
    "dictionaries", "lexicon", "lexicons", "glossary", "glossaries", "devotional",
    "devotionals", "book", "books"];

doc_kind_word_groups: []int = [0, 0, 1, 1, 2, 2, 2, 2, 2, 2, 3, 3, 4, 4];

DOC_KIND_LETTERS_LEAST: int = 3;

// Whether a word of a query (folded) names group g by one of its words.
doc_query_names_group(query: []i8, query_n: int, g: int): bool {
    if (query_n < DOC_KIND_LETTERS_LEAST) return false;
    for w in 0..len(doc_kind_words) {
        word: str = doc_kind_words[w];
        if (doc_kind_word_groups[w] == g && query_n <= len(word)) {
            same: bool = true;
            for k in 0..query_n
                if ((word[k] as int & 255) != (query[k] as int & 255)) same = false;
            if (same) return true
        }
    }
    false
}

// The group a word of a query names by one of its words whole
// ("commentaries", "lexicon"; -1: none).
doc_word_kind_group(word: []i8): int {
    for w in 0..len(doc_kind_words)
        if (folded_word_is(doc_kind_words[w], word)) return doc_kind_word_groups[w];
    -1
}

// Whether text, folded as a query is, is word (folded) whole.
folded_word_is(text: str, word: []i8): bool {
    if (len(text) != len(word)) return false;
    for k in 0..len(word)
        if (fold_text_byte(text, k) != (word[k] as int & 255)) return false;
    true
}

// ---- languages' own names ----
// The common languages' names in themselves, by code (as language_name's
// codes); another language is named only in English.
language_endonym_codes: []str = ["en", "fr", "de", "es", "pt", "it", "nl", "ru", "uk",
    "pl", "cs", "sk", "hu", "ro", "bg", "sr", "hr", "sl", "sv", "da", "nb", "no",
    "nn", "fi", "et", "lv", "lt", "el", "grc", "he", "hbo", "ar", "fa", "tr", "vi",
    "zh", "ja", "ko", "th", "id", "ms", "sw", "af", "la", "eo", "hi", "hy", "ka",
    "sq", "cy", "ga", "gd", "eu", "ca", "is", "ht", "be", "mk", "ur", "ta", "my",
    "km", "mi", "tl"];

language_endonyms: []str = ["English", "Fran\Ã\§ais", "Deutsch", "Espa\Ã\±ol", "Portugu\Ã\ªs",
    "Italiano", "Nederlands", "\Ð\ \Ñ\ƒ\Ñ\\Ñ\\Ð\º\Ð\¸\Ð\¹", "\Ð\£\Ð\º\Ñ\€\Ð\°\Ñ\—\Ð\½\Ñ\\Ñ\Œ\Ð\º\Ð\°",
    "Polski", "\Ä\Œe\Å\¡tina", "Sloven\Ä\ina", "Magyar", "Rom\Ã\¢n\Ä\ƒ", "\Ð\‘\Ñ\Š\Ð\»\Ð\³\Ð\°\Ñ\€\Ñ\\Ð\º\Ð\¸",
    "\Ð\¡\Ñ\€\Ð\¿\Ñ\\Ð\º\Ð\¸", "Hrvatski", "Sloven\Å\¡\Ä\ina", "Svenska", "Dansk",
    "Norsk bokm\Ã\¥l", "Norsk", "Norsk nynorsk", "Suomi", "Eesti", "Latvie\Å\¡u",
    "Lietuvi\Å\³", "\Î\•\Î\»\Î\»\Î\·\Î\½\Î\¹\Î\º\Î\¬", "\Î\•\Î\»\Î\»\Î\·\Î\½\Î\¹\Î\º\Î\¬ (\Î\±\Ï\\Ï\‡\Î\±\Î\¯\Î\±)",
    "\×\¢\×\‘\×\¨\×\™\×\ª", "\×\¢\×\‘\×\¨\×\™\×\ª (\×\ž\×\§\×\¨\×\\×\™\×\ª)", "\Ø\§\Ù\„\Ø\¹\Ø\±\Ø\¨\Ù\Š\Ø\©",
    "\Ù\\Ø\§\Ø\±\Ø\³\Û\Œ", "T\Ã\¼rk\Ã\§e", "Ti\á\º\¿ng Vi\á\»\‡t", "\ä\¸\­\æ\–\‡",
    "\æ\—\¥\æ\œ\¬\è\ª\ž", "\í\•\œ\ê\µ\­\ì\–\´", "\à\¹\„\à\¸\—\à\¸\¢", "Bahasa Indonesia",
    "Bahasa Melayu", "Kiswahili", "Afrikaans", "Latina", "Esperanto", "\à\¤\¹\à\¤\¿\à\¤\¨\à\¥\\à\¤\¦\à\¥\€",
    "\Õ\€\Õ\¡\Õ\µ\Õ\¥\Ö\€\Õ\¥\Õ\¶", "\á\ƒ\¥\á\ƒ\\á\ƒ\ \á\ƒ\—\á\ƒ\£\á\ƒ\š\á\ƒ\˜",
    "Shqip", "Cymraeg", "Gaeilge", "G\Ã\ idhlig", "Euskara", "Catal\Ã\ ", "\Ã\slenska",
    "Krey\Ã\²l ayisyen", "\Ð\‘\Ð\µ\Ð\»\Ð\°\Ñ\€\Ñ\ƒ\Ñ\\Ð\º\Ð\°\Ñ\", "\Ð\œ\Ð\°\Ð\º\Ð\µ\Ð\´\Ð\¾\Ð\½\Ñ\\Ð\º\Ð\¸",
    "\Ø\§\Ø\±\Ø\¯\Ù\ˆ", "\à\®\¤\à\®\®\à\®\¿\à\®\´\à\¯\", "\á\€\™\á\€\¼\á\€\”\á\€\º\á\€\™\á\€\¬",
    "\á\ž\\á\Ÿ\’\á\ž\˜\á\Ÿ\‚\á\ž\š", "M\Ä\ori", "Tagalog"];

// A code's language in itself ("": not known), its first part read (zh of
// zh-Hant).
language_endonym(code: str): str {
    first: int = 0;
    while (first < len(code) && code[first] as int != 45) first = first + 1;
    for i in 0..len(language_endonym_codes) {
        known: str = language_endonym_codes[i];
        if (len(known) == first) {
            same: bool = true;
            for k in 0..first
                if (known[k] != code[k]) same = false;
            if (same) return language_endonyms[i]
        }
    }
    ""
}

// A language's name as a list shows it to its readers: its own, else
// English's, onto fbuf.
fput_language_own_name(code: str) {
    own: str = language_endonym(code);
    fput_str(if (len(own) > 0) own else language_name(code))
}

// Whether a language's English name or its own holds the query.
language_holds_query(code: str, query: []i8, query_n: int): bool {
    text_holds_query(language_name(code), query, query_n) || text_holds_query(language_endonym(code),
        query, query_n)
}

// ---- matching without regard to case ----
// Whether a word of text begins with query's first query_n bytes (folded:
// fold_query), the text's capitals read as small letters: "rom" finds
// Romans and Romanian, not "from"; "espaÃ±ol" finds EspaÃ±ol. A word begins
// the text or follows a byte that is neither a letter nor a digit (a byte
// past ASCII is part of a word's letter). Every text holds an empty query.
text_holds_query(text: str, query: []i8, query_n: int): bool {
    if (query_n == 0) return true;
    for start in 0..len(text) - query_n + 1 {
        same: bool = start == 0 || !text_word_byte(text[start - 1] as int & 255);
        k: int = 0;
        while (same && k < query_n) {
            if (fold_text_byte(text, start + k) != (query[k] as int & 255)) same = false;
            k = k + 1
        }
        if (same) return true
    }
    false
}

// Whether byte x is part of a word: a letter, a digit, or a byte of a
// letter past ASCII.
text_word_byte(x: int): bool {
    x >= 'a' as int && x <= 'z' as int || x >= 'A' as int && x <= 'Z' as int || x >= '0' as int && x <= '9' as int || x >= 128
}

// A query's bytes (buf's from up to to) folded as text is compared: its
// capitals as small letters.
fold_query(buf: []i8, from: int, to: int): []i8@new {
    n: int = to - from;
    query: []i8 = new i8[n](0i8);
    for k in 0..n {
        x: int = buf[from + k] as int & 255;
        folded: int = if (x < 128) fold_ascii(x) else if (x >= 192) if (k + 1 < n) fold_lead(x,
            buf[from + k + 1] as int & 255) else x else if (k > 0) fold_next(buf[from + k - 1] as int & 255,
            x) else x;
        query[k] = folded trunc i8
    }
    query
}

// Text's byte at k as a query compares it: a capital's as its small
// letter's. ASCII's capitals, and the two-byte capitals of Latin-1 (Ã€ to
// Ãž), Greek (Î‘ to Î©) and Cyrillic (Ð€ to Ð¯), whose small letters are two
// bytes too, so that folding keeps every byte's place.
fold_text_byte(text: str, k: int): int {
    x: int = text[k] as int & 255;
    if (x < 128) return fold_ascii(x);
    if (x >= 192) return if (k + 1 < len(text)) fold_lead(x, text[k + 1] as int & 255) else x;
    if (k > 0) fold_next(text[k - 1] as int & 255, x) else x
}

fold_ascii(x: int): int {
    if (x >= 'A' as int && x <= 'Z' as int) x + 32 else x
}

// A two-byte character's first byte (lead, its second next), folded.
fold_lead(lead: int, next: int): int {
    // (Greek's Î  to Î©: Ï€ to Ï‰ are CF 80 to 89.)
    if (lead == 206 && next >= 160 && next <= 169) return 207;
    // (Cyrillic's Ð€ to Ð and Ð  to Ð¯: their small letters are D1's.)
    if (lead == 208 && (next >= 128 && next <= 143 || next >= 160 && next <= 175)) return 209;
    lead
}

// A two-byte character's second byte (next, its first lead), folded.
fold_next(lead: int, next: int): int {
    // (Latin-1's Ã€ to Ãž, but Ã—.)
    if (lead == 195 && next >= 128 && next <= 158 && next != 151) return next + 32;
    if (lead == 206 && next >= 145 && next <= 159) return next + 32;
    if (lead == 206 && next >= 160 && next <= 169) return next - 32;
    if (lead == 208 && next >= 128 && next <= 143) return next + 16;
    if (lead == 208 && next >= 144 && next <= 159) return next + 32;
    if (lead == 208 && next >= 160 && next <= 175) return next - 32;
    next
}

// ---- what can be read ----
// A document: a version that isn't the Bookshelf's (a bundled one, the
// Hebrew and Greek, the ESV), by its text; the Bookshelf's module (a
// downloaded Bible among them, or one asked for and still coming), by its
// item; or the catalog's entry not on the Bookshelf, by its place in the
// catalog.
type Document =
    | Version { text: int }
    | Module { item: int }
    | Entry { at: int }

type DocumentList = {
    documents: []Document;
    count: int
}

// Whether a document not on the device can be opened now: fetched, online.
doc_online(): bool {
    shelf_can_fetch() && hd_network != NET_NONE
}

// The documents that can be opened now, in no order: the versions; the
// Bookshelf's modules of a kind listed (those not here yet only when
// online); and, online, the catalog's other entries listed (doc_entry_listed).
doc_candidates(online: bool): DocumentList@new {
    count: int = shelf_count();
    room: int = len(sk_versions) + 2 + count + shelf_catalog_count();
    list: []Document = new Document[room](Document.Version { text: 0 });
    n: int = 0;
    for t in sk_versions {
        list[n] = Document.Version { text: t };
        n = n + 1
    }
    if (sk_has_orig) {
        list[n] = Document.Version { text: TEXT_ORIG };
        n = n + 1
    }
    if (sk_esv_listed) {
        list[n] = Document.Version { text: TEXT_ESV };
        n = n + 1
    }
    for i in 0..count {
        if (doc_group_of(shelf_kind_of(shelf_kind_at(i))) >= 0 && (shelf_here_at(i) || online)) {
            list[n] = Document.Module { item: i };
            n = n + 1
        }
    }
    if (online && shelf_catalog != null) {
        borrow shelf_catalog as catalog {
            for at in 0..catalog.count {
                if (doc_entry_listed(&catalog.entries[at])) {
                    list[n] = Document.Entry { at: at };
                    n = n + 1
                }
            }
        }
    }
    DocumentList { documents: list, count: n }
}

// Whether Go To lists the catalog's entry as a document of its own: one
// this app can read (one it can't is never offered), of a kind it lists,
// not a bundled version's own edition, and not on the Bookshelf (listed
// as its module then).
doc_entry_listed(entry: *CatalogEntry): bool {
    readable: bool = match entry.support {
        Readable -> true;
        Unreadable _ -> false
    };
    readable && doc_group_of(entry.info.kind) >= 0 && !shelf_bundled(&entry.info) && shelf_find(entry.info.name) < 0
}

// A document as a number, for a row's argument: the catalog's entry its
// place; a module DOC_REF_MODULES less its item; a version -1 less its
// text (a version's text is below -1 - DOC_REF_MODULES).
DOC_REF_MODULES: int = -100;

doc_ref(d: Document): int {
    match d {
        Version v -> -1 - v.text;
        Module m -> DOC_REF_MODULES - m.item;
        Entry e -> e.at
    }
}

doc_of_ref(ref: int): Document {
    if (ref >= 0) return Document.Entry { at: ref };
    if (ref <= DOC_REF_MODULES) return Document.Module { item: DOC_REF_MODULES - ref };
    Document.Version { text: -1 - ref }
}

// ---- what a list orders them by ----
// A query as Go To matches it: its bytes folded, without the spaces around
// it, and its words (split at spaces).
type QueryWords = {
    query: []i8;
    words: [][]i8;
    count: int
}

query_words(folded: []i8): QueryWords@new {
    first: int = 0;
    last: int = len(folded);
    while (first < last && folded[first] as int == 32) first = first + 1;
    while (last > first && folded[last - 1] as int == 32) last = last - 1;
    query: []i8 = new i8[last - first](0i8);
    for x in first..last query[x - first] = folded[x];
    count: int = 0;
    k: int = 0;
    while (k < len(query)) {
        while (k < len(query) && query[k] as int == 32) k = k + 1;
        if (k < len(query)) count = count + 1;
        while (k < len(query) && query[k] as int != 32) k = k + 1
    }
    words: [][]i8 = new []i8[count](new i8[0](0i8));
    w: int = 0;
    k = 0;
    while (k < len(query)) {
        while (k < len(query) && query[k] as int == 32) k = k + 1;
        from: int = k;
        while (k < len(query) && query[k] as int != 32) k = k + 1;
        if (k > from) {
            word: []i8 = new i8[k - from](0i8);
            for x in from..k word[x - from] = query[x];
            words[w] = word;
            w = w + 1
        }
    }
    QueryWords { query: query, words: words, count: count }
}

// What a document is ordered by: its kind's group, whether it is in the
// reader's language (English), when it was last read (seconds; 0 never),
// whether it comes with the app, and how well it holds the query
// (doc_rank_of: -1 not at all; 0 with none).
type DocumentFacts = {
    group: int;
    english: bool;
    read_at: int;
    bundled: bool;
    rank: int
}

doc_facts(d: Document, q: *QueryWords): DocumentFacts {
    match d {
        Version v -> doc_version_facts(v.text, q);
        Module m -> doc_item_facts(m.item, q);
        Entry e -> doc_entry_facts(e.at, q)
    }
}

// (The Hebrew and Greek found by either language's names.)
doc_version_facts(t: int, q: *QueryWords): DocumentFacts {
    rank: int = doc_rank_of(text_names[t], text_abbrs[t], "", if (t == TEXT_ORIG) "he" else "en",
        DOC_GROUP_BIBLES, q);
    if (rank < 0 && t == TEXT_ORIG) rank = doc_rank_of(text_names[t], text_abbrs[t],
        "", "el", DOC_GROUP_BIBLES, q);
    DocumentFacts {
        group: DOC_GROUP_BIBLES,
        english: t != TEXT_ORIG,
        read_at: doc_version_read_at(t),
        bundled: t != TEXT_ESV,
        rank: rank
    }
}

doc_item_facts(i: int, q: *QueryWords): DocumentFacts {
    facts: DocumentFacts = DocumentFacts {
        group: -1,
        english: true,
        read_at: 0,
        bundled: false,
        rank: -1
    };
    if (i < 0 || shelf_list == null) return facts;
    borrow shelf_list as list {
        if (i < list.count) {
            item: *ShelfItem = &list.items[i];
            group: int = doc_group_of(item.kind);
            facts = DocumentFacts {
                group: group,
                english: language_is_english(item.language),
                read_at: item.used,
                bundled: false,
                rank: doc_rank_of(item.title, item.abbreviation, item.name, item.language,
                    group, q)
            }
        }
    }
    facts
}

doc_entry_facts(at: int, q: *QueryWords): DocumentFacts {
    facts: DocumentFacts = DocumentFacts {
        group: -1,
        english: true,
        read_at: 0,
        bundled: false,
        rank: -1
    };
    if (at < 0 || shelf_catalog == null) return facts;
    borrow shelf_catalog as catalog {
        if (at < catalog.count) {
            info: *ModuleInfo = &catalog.entries[at].info;
            group: int = doc_group_of(info.kind);
            facts = DocumentFacts {
                group: group,
                english: language_is_english(info.language),
                read_at: 0,
                bundled: false,
                rank: doc_rank_of(info.description, info.abbreviation, info.name,
                    info.language, group, q)
            }
        }
    }
    facts
}

// How well a document's words hold the query: -1 not every word of it; 0
// its title begins with the whole query; 1 every word begins a word of its
// title, short name or module's name; 2 a word only by its language (its
// English name or its own) or its kind. A word that is a kind's or a
// language's whole ("Commentaries", "EspaÃ±ol") is taken as that alone,
// not also as a word of a title: Browse â†’ Commentaries lists in title
// order, not Calvin's Collected Commentaries first.
doc_rank_of(
    title: str,
    abbreviation: str,
    name: str,
    code: str,
    group: int,
    q: *QueryWords
): int {
    if (q.count == 0) return 0;
    by_names: bool = true;
    for w in 0..q.count {
        word: []i8 = q.words[w];
        n: int = len(word);
        if (doc_word_kind_group(word) >= 0 || doc_word_is_language(word)) {
            if (!(language_holds_query(code, word, n) || doc_query_names_group(word,
                n, group))) return -1;
            by_names = false
        } else if (!(text_holds_query(title, word, n) || text_holds_query(abbreviation,
            word, n) || text_holds_query(name, word, n))) {
            if (!(language_holds_query(code, word, n) || doc_query_names_group(word,
                n, group))) return -1;
            by_names = false
        }
    }
    if (by_names && text_begins_query(title, q.query)) 0 else if (by_names) 1 else 2
}

// Whether text begins with the query (folded, as text is compared).
text_begins_query(text: str, query: []i8): bool {
    if (len(query) == 0 || len(query) > len(text)) return false;
    for k in 0..len(query)
        if (fold_text_byte(text, k) != (query[k] as int & 255)) return false;
    true
}

// What a query names besides titles: a kind (kind_only, its group: every
// word a kind's word whole, of one group; kind: a group a word names whole,
// the others naming a language), a language by its name whole (every other
// word a kind's), or the languages themselves ("languages", or its first
// three letters or more).
type QueryNames = {
    kind_only: int;
    kind: int;
    language: bool;
    languages: bool
}

doc_query_names(q: *QueryWords): QueryNames {
    kind: int = -1;
    kind_words: int = 0;
    language_words: int = 0;
    for w in 0..q.count {
        g: int = doc_word_kind_group(q.words[w]);
        if (g >= 0 && (kind < 0 || kind == g)) {
            kind = g;
            kind_words = kind_words + 1
        } else if (doc_word_is_language(q.words[w])) language_words = language_words + 1
    }
    others: int = q.count - kind_words - language_words;
    QueryNames {
        kind_only: if (q.count > 0 && kind_words == q.count) kind else -1,
        kind: if (others == 0) kind else -1,
        language: language_words > 0 && others == 0,
        languages: q.count == 1 && doc_word_begins("languages", q.words[0])
    }
}

// Whether a word (folded) is a language's English name or its own, whole.
doc_word_is_language(word: []i8): bool {
    for name in module_language_names
        if (folded_word_is(name, word)) return true;
    for name in language_endonyms
        if (folded_word_is(name, word)) return true;
    false
}

// Whether a word (folded) begins text with three letters or more.
doc_word_begins(text: str, word: []i8): bool {
    if (len(word) < DOC_KIND_LETTERS_LEAST || len(word) > len(text)) return false;
    for k in 0..len(word)
        if (fold_text_byte(text, k) != (word[k] as int & 255)) return false;
    true
}

// ---- the documents read ----
// When each bundled version (by its text) was last chosen to read, kept as
// a setting (seconds; 0 never); a Bookshelf module's is its own (used).
version_read_prefs: []str = ["readBSB", "readKJV", "readWEB", "readASV", "readYLT",
    "readESV", "readOriginal"];

doc_version_read_at(t: int): int {
    if (t >= 0 && t < len(version_read_prefs)) pref_get(version_read_prefs[t]) else 0
}

// Version t chosen to read now (its time kept, or a Bookshelf Bible's).
doc_note_version_read(t: int) {
    if (t >= 0 && t < len(version_read_prefs)) {
        set_pref(version_read_prefs[t], time(0));
        sk_save()
    } else if (t >= TEXT_SHELF_FIRST) shelf_note_read(shelf_find_text(t), -1)
}

// ---- which pane names a document ----
// Whether pane p shows document d, or d is on its way there (its name
// names it); the panel only while it is open.
doc_pane_names(p: int, d: Document): bool {
    slot: int = doc_arriving_slot(p);
    if (slot >= 0) return match d {
        Module m -> shelf_slot_at(m.item) == slot;
        _ -> false
    };
    if (p == PANE_PANEL && !sk_beside_open()) return false;
    match d {
        Version v -> doc_pane_reads_text(p, v.text);
        Module m -> if (shelf_kind_at(m.item) == SHELF_KIND_BIBLE) doc_pane_reads_text(p,
            shelf_text_of(m.item)) else doc_pane_reads_slot(p, shelf_slot_at(m.item));
        Entry _e -> false
    }
}

doc_pane_reads_text(p: int, t: int): bool {
    if (p == PANE_PAGE) page_reads_bible() && text_cur == t else sk_beside_reads_version(t)
}

doc_pane_reads_slot(p: int, slot: int): bool {
    if (p == PANE_PAGE) page_reads_module(slot) else sk_beside_reads_module(slot)
}

// Whether a pane (the page or the panel) shows document d: its row checked,
// the same whichever pane Go To was opened from.
doc_open_in_pane(d: Document): bool {
    doc_pane_names(PANE_PAGE, d) || doc_pane_names(PANE_PANEL, d)
}

// ---- a document's row ----
// One model in every list: no icon; the title whole (two lines at most);
// a small line under it (a Bible's short name and what it is, then its
// language if not the reader's; another's language if not the reader's,
// its kind first in a list of mixed kinds); checked if a pane shows it;
// its â“˜ its page; a tap opens it, wherever it is kept. Nothing says where
// it is kept or how large it is.
doc_row(d: Document, mixed: bool) {
    match d {
        Version v -> doc_version_row(v.text);
        Module m -> doc_module_row(m.item, mixed);
        Entry e -> doc_entry_row(e.at, mixed)
    }
    if (doc_open_in_pane(d)) ui_set_acc(ACC_CHECK)
}

// A version's row: its name, its line.
doc_version_row(t: int) {
    ui_row(UI_ITEM, ACT_VERSION, t);
    fbuf_n = 0;
    fput_text_name(t);
    ui_set_title_fbuf();
    ui_set_title_lines(2);
    fbuf_n = 0;
    fput_version_line(t);
    ui_set_detail_fbuf();
    doc_row_line();
    ui_set_info(ACT_DOC_VERSION_INFO);
    // (Read as it is shown, its dots as pauses: the line put past the
    // label, then copied down to it with " Â· " as ", ".)
    fbuf_n = 0;
    fput_text_name(t);
    fput_str(", ");
    label_n: int = fbuf_n;
    line_at: int = label_n + TEXT_NAMES_MOST;
    fbuf_n = line_at;
    fput_version_line(t);
    line_end: int = fbuf_n;
    fbuf_n = label_n;
    i: int = line_at;
    while (i < line_end) {
        k: int = fbuf[i] as int & 255;
        if (k == 194 && i + 1 < line_end && (fbuf[i + 1] as int & 255) == 183) {
            if (fbuf_n > 0 && fbuf[fbuf_n - 1] as int == 32) fbuf_n = fbuf_n - 1;
            fput(44);
            i = i + 2
        } else {
            fput(k);
            i = i + 1
        }
    }
    ui_set_label_fbuf()
}

// A row's line: small, one line.
doc_row_line() {
    ui_set_small();
    ui_set_lines(1)
}

// A row's line onto fbuf: a Bible's short name, or (mixed) another's kind;
// then its language, if not English (" Â· Romanian").
fput_doc_line(
    kind: int,
    abbreviation: str,
    code: str,
    mixed: bool
) {
    if (kind == SHELF_KIND_BIBLE) fput_str(abbreviation) else if (mixed) fput_str(shelf_kind_words[kind]);
    if (!language_is_english(code)) {
        if (fbuf_n > 0) fput_str(" \Â\· ");
        fput_str(language_name(code))
    }
}

// The row's line from fbuf, if it has one.
doc_row_detail_fbuf() {
    if (fbuf_n == 0) return;
    ui_set_detail_fbuf();
    doc_row_line()
}

// A Bookshelf module's row (here, or still coming: the same).
doc_module_row(i: int, mixed: bool) {
    ui_row(UI_ITEM, ACT_SHELF_READ, shelf_slot_at(i));
    fbuf_n = 0;
    fput_shelf_title(i);
    ui_set_title_fbuf();
    ui_set_title_lines(2);
    fbuf_n = 0;
    if (shelf_list != null) {
        borrow shelf_list as list {
            if (i >= 0 && i < list.count) fput_doc_line(shelf_kind_code(list.items[i].kind),
                list.items[i].abbreviation, list.items[i].language, mixed)
        }
    }
    if (shelf_is_bundled_edition(i)) fput_str(" \Â\· CrossWire edition");
    doc_row_detail_fbuf();
    ui_set_info(ACT_SHELF_INFO)
}

// The catalog's document's row.
doc_entry_row(at: int, mixed: bool) {
    if (shelf_catalog == null) return;
    borrow shelf_catalog as catalog {
        if (at >= 0 && at < catalog.count) {
            info: *ModuleInfo = &catalog.entries[at].info;
            ui_row(UI_ITEM, ACT_DOC_OPEN_ENTRY, at);
            ui_set_title(info.description);
            ui_set_title_lines(2);
            fbuf_n = 0;
            fput_doc_line(shelf_kind_code(info.kind), shelf_short_name(info), info.language,
                mixed);
            doc_row_detail_fbuf();
            ui_set_info(ACT_SHELF_ITEM)
        }
    }
}

// A document's title onto fbuf.
fput_doc_title(d: Document) {
    match d {
        Version v -> fput_text_name(v.text);
        Module m -> fput_shelf_title(m.item);
        Entry e -> {
            if (shelf_catalog != null) {
                borrow shelf_catalog as catalog {
                    if (e.at >= 0 && e.at < catalog.count) fput_str(catalog.entries[e.at].info.description)
                }
            }
        }
    }
}

// A document's title as a string of the region it is made in.
doc_title_text(d: Document): str@new {
    fbuf_n = 0;
    fput_doc_title(d);
    shelf_bytes_text(fbuf, 0, fbuf_n)
}

// "Show All 41": a section's other rows shown in place (no chevron).
doc_show_all_row(section: int, total: int) {
    ui_row(UI_ITEM, ACT_DOC_SHOW_ALL, section);
    fbuf_n = 0;
    fput_str("Show All ");
    fput_int(total);
    ui_set_title_fbuf();
    ui_set_tinted()
}

// ---- Go To's documents ----
// Go To's sections whose Show All shows every row: each kind's (its
// group), the languages, and a kind's other languages; collapsed again as
// Go To opens and as its query changes.
DOC_SECTION_LANGUAGES: int = 5;

DOC_SECTION_KIND_LANGUAGES: int = 6;

DOC_SECTIONS: int = 7;

goto_all: []bool = new bool[DOC_SECTIONS](false);

goto_sections_collapsed() {
    for s in 0..DOC_SECTIONS goto_all[s] = false
}

// Rows a typed section shows before its Show All: an ordinary query's, a
// language's (each kind's), a kind's (that kind's alone).
DOC_SHOWN_ORDINARY: int = 3;

DOC_SHOWN_LANGUAGE: int = 5;

DOC_SHOWN_KIND: int = 12;

// Documents, with nothing typed: what is read, by recency, at most this
// many.
DOC_RECENT_MOST: int = 6;

// A list's documents and what each is ordered by (facts; open: shown in a
// pane), for the sections made from it.
type ScoredDocuments = {
    list: DocumentList;
    facts: []DocumentFacts;
    open: []bool
}

doc_scored(list: DocumentList@new, q: *QueryWords): ScoredDocuments@new {
    facts: []DocumentFacts = new DocumentFacts[list.count](DocumentFacts {
        group: -1,
        english: true,
        read_at: 0,
        bundled: false,
        rank: -1
    });
    open: []bool = new bool[list.count](false);
    for k in 0..list.count {
        facts[k] = doc_facts(list.documents[k], q);
        open[k] = doc_open_in_pane(list.documents[k])
    }
    ScoredDocuments { list: list, facts: facts, open: open }
}

// Documents, as Go To opens: the page's document, then the panel's, then
// the others read, the latest first; up to six with the Bibles that come
// with the app (all of them, for a reader who has read nothing yet: the
// BSB, KJV, WEB, ASV, YLT, and the Hebrew and Greek). Rows of mixed kinds.
goto_recent_documents() {
    region {
        q: QueryWords = query_words(new i8[0](0i8));
        scored: ScoredDocuments = doc_scored(doc_candidates(false), &q);
        n: int = scored.list.count;
        chosen: []bool = new bool[n](false);
        order: []int = new int[DOC_RECENT_MOST](0);
        m: int = 0;
        for pass in 0..2 {
            for k in 0..n {
                if (m < DOC_RECENT_MOST && !chosen[k] && doc_pane_names(pass, scored.list.documents[k])) {
                    chosen[k] = true;
                    order[m] = k;
                    m = m + 1
                }
            }
        }
        going: bool = true;
        while (going && m < DOC_RECENT_MOST) {
            best: int = -1;
            for k in 0..n {
                if (!chosen[k] && scored.facts[k].read_at > 0 && (best < 0 || scored.facts[k].read_at > scored.facts[best].read_at)) best = k
            }
            if (best < 0) going = false else {
                chosen[best] = true;
                order[m] = best;
                m = m + 1
            }
        }
        for k in 0..n {
            bundled: bool = match scored.list.documents[k] {
                Version v -> v.text != TEXT_ESV;
                _ -> false
            };
            if (m < DOC_RECENT_MOST && !chosen[k] && bundled) {
                chosen[k] = true;
                order[m] = k;
                m = m + 1
            }
        }
        if (m > 0) ui_section("Documents", "");
        for o in 0..m doc_row(scored.list.documents[order[o]], true)
    }
}

// Browse: a row for each kind with documents, and one for the languages,
// each with how many there are of them that can be opened now; a tap puts
// its word in the field ("Commentaries"), as if it was typed. While the
// first catalog is on its way, every kind (those it will bring without a
// count yet), so that Go To's rows stay where they are as it comes.
goto_browse_section() {
    region {
        q: QueryWords = query_words(new i8[0](0i8));
        scored: ScoredDocuments = doc_scored(doc_candidates(doc_online()), &q);
        counts: []int = new int[DOC_GROUPS](0);
        for k in 0..scored.list.count {
            g: int = scored.facts[k].group;
            if (g >= 0 && g < DOC_GROUPS) counts[g] = counts[g] + 1
        }
        tally: LanguageTally = doc_language_tally(&scored, -1, false);
        awaited: bool = shelf_catalog_awaited();
        ui_section("Browse", "");
        for g in 0..DOC_GROUPS {
            if (counts[g] > 0 || awaited) goto_browse_row(g, doc_group_titles[g],
                counts[g])
        }
        if (tally.count > 0) goto_browse_row(DOC_SECTION_LANGUAGES, "Languages", tally.count)
    }
}

goto_browse_row(arg: int, title: str, count: int) {
    ui_row(UI_ITEM, ACT_DOC_BROWSE, arg);
    ui_set_title(title);
    if (count == 0) return;
    fbuf_n = 0;
    fput_int(count);
    ui_set_detail_fbuf();
    ui_set_value_detail()
}

// Whether the query last made matched nothing that can be opened now but
// would match online (the empty state says so), and the first document it
// matched (Return opens it): Go To's, kept from one making of its rows to
// the next.
type GotoFound = {
    more_online: bool;
    first: FirstDocument
}

type FirstDocument =
    | NoDocumentFound
    | DocumentFound { ref: int }

goto_found: GotoFound = GotoFound { more_online: false, first: FirstDocument.NoDocumentFound };

goto_found_reset() {
    goto_found = GotoFound { more_online: false, first: FirstDocument.NoDocumentFound }
}

// Go To's documents for a query (folded): a section for each kind that has
// matches, in order (Bibles, Commentaries, Dictionaries, Devotionals,
// Books), each ordered: open in a pane; read before, the latest first;
// coming with the app; in the reader's language; the others. Within each,
// the titles the query begins, then those whose words it begins, then
// those it finds by language or kind, each in title order. Three rows
// each, then Show All; five each for a language named; for a kind named
// alone, twelve of that kind in the reader's language, then its other
// languages, each a row refining the query. Then, for "languages", every
// language. How many rows it matched.
goto_query_documents(folded: []i8): int {
    matched: int = 0;
    goto_found_reset();
    region {
        q: QueryWords = query_words(folded);
        names: QueryNames = doc_query_names(&q);
        online: bool = doc_online();
        scored: ScoredDocuments = doc_scored(doc_candidates(online), &q);
        shown: int = if (names.kind_only >= 0) DOC_SHOWN_KIND else if (names.language) if (names.kind >= 0) DOC_SHOWN_KIND else DOC_SHOWN_LANGUAGE else DOC_SHOWN_ORDINARY;
        for g in 0..DOC_GROUPS matched = matched + goto_kind_section(&scored, g, shown,
            names.kind_only == g);
        if (names.kind_only >= 0) goto_kind_languages_section(&scored, names.kind_only);
        if (names.languages) {
            tally: LanguageTally = doc_language_tally(&scored, -1, false);
            goto_language_rows(&tally, "Languages", DOC_SECTION_LANGUAGES, ACT_DOC_LANGUAGE);
            matched = matched + tally.count
        }
        // (Offline: whether the catalog kept would have found some.)
        if (matched == 0 && !online && shelf_can_fetch()) goto_found.more_online = doc_scored_matches(doc_scored(doc_candidates(true),
            &q))
    }
    matched
}

// Whether any of a list's documents holds the query.
doc_scored_matches(scored: ScoredDocuments): bool {
    for k in 0..scored.list.count
        if (scored.facts[k].rank >= 0 && scored.facts[k].group >= 0) return true;
    false
}

// A kind's section (group g) of the documents that hold the query, ordered
// (doc_listed_before), shown rows then Show All; for its kind named alone
// (by_language), only those in the reader's language, open or read. How
// many matched.
goto_kind_section(
    scored: *ScoredDocuments,
    g: int,
    shown: int,
    by_language: bool
): int {
    n: int = scored.list.count;
    picked: []int = new int[n](0);
    tiers: []int = new int[n](0);
    m: int = 0;
    for k in 0..n {
        facts: DocumentFacts = scored.facts[k];
        if (facts.group == g && facts.rank >= 0 && (!by_language || facts.english || scored.open[k] || facts.read_at > 0)) {
            picked[m] = k;
            tiers[m] = (if (scored.open[k]) 0 else if (facts.read_at > 0) 1 else if (facts.bundled) 2 else if (facts.english) 3 else 4);
            m = m + 1
        }
    }
    if (m == 0) return 0;
    titles: []str = new str[m]("");
    for j in 0..m titles[j] = doc_title_text(scored.list.documents[picked[j]]);
    order: []int = new int[m](0);
    for j in 0..m {
        k: int = j;
        while (k > 0 && doc_listed_before(scored, picked, tiers, titles, j, order[k - 1])) {
            order[k] = order[k - 1];
            k = k - 1
        }
        order[k] = j
    }
    ui_section(doc_group_titles[g], "");
    rows: int = if (m > shown && !goto_all[g]) shown else m;
    for o in 0..rows {
        d: Document = scored.list.documents[picked[order[o]]];
        match goto_found.first {
            NoDocumentFound -> goto_found.first = FirstDocument.DocumentFound { ref: doc_ref(d) };
            DocumentFound _f -> { }
        }
        doc_row(d, false)
    }
    if (rows < m) doc_show_all_row(g, m);
    m
}

// Whether the a'th document picked comes before the b'th: by its tier,
// those read by when (the latest first), then how well it holds the query,
// then by title, past a leading year and article (title_compare).
doc_listed_before(
    scored: *ScoredDocuments,
    picked: []int,
    tiers: []int,
    titles: []str,
    a: int,
    b: int
): bool {
    if (tiers[a] != tiers[b]) return tiers[a] < tiers[b];
    fa: DocumentFacts = scored.facts[picked[a]];
    fb: DocumentFacts = scored.facts[picked[b]];
    if (tiers[a] == 1 && fa.read_at != fb.read_at) return fa.read_at > fb.read_at;
    if (fa.rank != fb.rank) return fa.rank < fb.rank;
    title_compare(titles[a], titles[b]) < 0
}

// A kind named alone: its documents' other languages, a row each refining
// the query ("Commentaries Deutsch").
goto_kind_languages_section(scored: *ScoredDocuments, g: int) {
    tally: LanguageTally = doc_language_tally(scored, g, true);
    goto_language_rows(&tally, "Languages", DOC_SECTION_KIND_LANGUAGES, ACT_DOC_LANGUAGE_REFINE)
}

// The languages of a list's documents (those of group g; -1 every kind;
// others: English left out), each its English name, a document of it (its
// doc_ref, for its row) and how many it has; the most first, as many by
// English name. (The Hebrew and Greek, two languages, is counted in
// neither.)
type LanguageTally = {
    names: []str;
    refs: []int;
    counts: []int;
    count: int
}

doc_language_tally(scored: *ScoredDocuments, g: int, others: bool): LanguageTally@new {
    n: int = scored.list.count;
    names: []str = new str[n]("");
    refs: []int = new int[n](0);
    counts: []int = new int[n](0);
    m: int = 0;
    for k in 0..n {
        d: Document = scored.list.documents[k];
        facts: DocumentFacts = scored.facts[k];
        if (facts.group >= 0 && (g < 0 || facts.group == g) && !(others && facts.english)) {
            fbuf_n = 0;
            fput_doc_language(d);
            if (fbuf_n > 0) {
                found: int = -1;
                for j in 0..m
                    if (found < 0 && doc_fbuf_is(names[j])) found = j;
                if (found < 0) {
                    names[m] = shelf_bytes_text(fbuf, 0, fbuf_n);
                    refs[m] = doc_ref(d);
                    counts[m] = 1;
                    m = m + 1
                } else counts[found] = counts[found] + 1
            }
        }
    }
    order: []int = new int[m](0);
    for j in 0..m {
        k: int = j;
        while (k > 0 && (counts[j] > counts[order[k - 1]] || counts[j] == counts[order[k - 1]] && text_compare_folded(names[j],
            names[order[k - 1]]) < 0)) {
            order[k] = order[k - 1];
            k = k - 1
        }
        order[k] = j
    }
    sorted_names: []str = new str[m]("");
    sorted_refs: []int = new int[m](0);
    sorted_counts: []int = new int[m](0);
    for o in 0..m {
        sorted_names[o] = names[order[o]];
        sorted_refs[o] = refs[order[o]];
        sorted_counts[o] = counts[order[o]]
    }
    LanguageTally {
        names: sorted_names,
        refs: sorted_refs,
        counts: sorted_counts,
        count: m
    }
}

// Whether fbuf holds text.
doc_fbuf_is(text: str): bool {
    if (len(text) != fbuf_n) return false;
    for k in 0..fbuf_n
        if (fbuf[k] != text[k]) return false;
    true
}

// A document's language's English name onto fbuf (none: the Hebrew and
// Greek's two, or a code that names no language, "zxx" or "und").
fput_doc_language(d: Document) {
    match d {
        Version v -> if (v.text != TEXT_ORIG) fput_str("English");
        Module m -> {
            if (shelf_list != null) {
                borrow shelf_list as list {
                    if (m.item >= 0 && m.item < list.count) fput_language_tallied(list.items[m.item].language)
                }
            }
        }
        Entry e -> {
            if (shelf_catalog != null) {
                borrow shelf_catalog as catalog {
                    if (e.at >= 0 && e.at < catalog.count) fput_language_tallied(catalog.entries[e.at].info.language)
                }
            }
        }
    }
}

fput_language_tallied(code: str) {
    if (code != "zxx" && code != "und") fput_str(language_name(code))
}

// A document's language's code, as a string of the region it is made in.
doc_language_code(d: Document): str@new {
    fbuf_n = 0;
    match d {
        Version _v -> fput_str("en");
        Module m -> {
            if (shelf_list != null) {
                borrow shelf_list as list {
                    if (m.item >= 0 && m.item < list.count) fput_str(list.items[m.item].language)
                }
            }
        }
        Entry e -> {
            if (shelf_catalog != null) {
                borrow shelf_catalog as catalog {
                    if (e.at >= 0 && e.at < catalog.count) fput_str(catalog.entries[e.at].info.language)
                }
            }
        }
    }
    shelf_bytes_text(fbuf, 0, fbuf_n)
}

// A tally's languages as rows under header (its section's Show All
// section): each its own name ("FranÃ§ais"), under it its English name and
// how many ("French Â· 32"; none of its own: "32 documents"); a tap does
// action with the document it was counted by. Twelve, then Show All.
goto_language_rows(
    tally: *LanguageTally,
    header: str,
    section: int,
    action: int
) {
    if (tally.count == 0) return;
    ui_section(header, "");
    rows: int = if (tally.count > DOC_SHOWN_KIND && !goto_all[section]) DOC_SHOWN_KIND else tally.count;
    for o in 0..rows {
        ui_row(UI_ITEM, action, tally.refs[o]);
        doc_language_row_words(doc_language_code(doc_of_ref(tally.refs[o])), tally.counts[o])
    }
    if (rows < tally.count) doc_show_all_row(section, tally.count)
}

// A language's row's words (code's language, count documents of it).
doc_language_row_words(code: str, count: int) {
    fbuf_n = 0;
    fput_language_own_name(code);
    ui_set_title_fbuf();
    fbuf_n = 0;
    // (Its own name other than its English one: English's is "English".)
    own: bool = len(language_endonym(code)) > 0 && language_endonym(code) != language_name(code);
    if (own) {
        fput_str(language_name(code));
        fput_str(" \Â\· ")
    }
    fput_int(count);
    if (!own) fput_str(if (count == 1) " document" else " documents");
    ui_set_detail_fbuf();
    doc_row_line()
}

// ---- what Go To's rows do ----
// Whether action is one of Go To's documents' own (doc_act's).
doc_action(action: int): bool {
    action == ACT_DOC_SHOW_ALL || action == ACT_DOC_BROWSE || action == ACT_DOC_LANGUAGE || action == ACT_DOC_LANGUAGE_REFINE || action == ACT_DOC_OPEN_ENTRY || action == ACT_DOC_VERSION_INFO
}

doc_act(at: int, action: int, arg: int) {
    if (action == ACT_DOC_SHOW_ALL) {
        if (arg >= 0 && arg < DOC_SECTIONS) goto_all[arg] = true;
        sk_build(at);
        ui_effect("refill", sk_ids[at], 0);
        return
    }
    if (action == ACT_DOC_BROWSE) {
        words: str = if (arg >= 0 && arg < DOC_GROUPS) doc_group_titles[arg] else "Languages";
        // (From elsewhere, Study's More Commentaries: Go To opened with
        // them, a pick read in the panel where it fits.)
        if (sk_kinds[at] != SCR_GOTO) {
            goto_open_with(if (sk_panel_fits) GOTO_PANEL else GOTO_PAGE, words);
            return
        }
        fbuf_n = 0;
        fput_str(words);
        goto_field_from_fbuf(at);
        return
    }
    if (action == ACT_DOC_LANGUAGE || action == ACT_DOC_LANGUAGE_REFINE) {
        region {
            code: str = doc_language_code(doc_of_ref(arg));
            fbuf_n = 0;
            // (Refining: the kind's words typed, then the language's.)
            if (action == ACT_DOC_LANGUAGE_REFINE) {
                for x in 0..sk_q_n fput(sk_q[x] as int & 255);
                while (fbuf_n > 0 && fbuf[fbuf_n - 1] as int == 32) fbuf_n = fbuf_n - 1;
                fput(32)
            }
            fput_language_own_name(code)
        }
        goto_field_from_fbuf(at);
        return
    }
    if (action == ACT_DOC_OPEN_ENTRY) {
        doc_open_entry(at, arg);
        return
    }
    if (action == ACT_DOC_VERSION_INFO && arg >= 0 && arg < TEXTS) sk_open(SCR_VERSION_DETAILS,
        arg, true)
}

// Go To's field (screen at) holding fbuf's words, as if they were typed:
// its rows made again for them, and the field showing them.
goto_field_from_fbuf(at: int) {
    if (at < 0 || at >= sk_n || sk_kinds[at] != SCR_GOTO) return;
    sk_q_n = (if (fbuf_n < len(sk_q)) fbuf_n else len(sk_q));
    for x in 0..sk_q_n sk_q[x] = fbuf[x];
    if (sk_has_shelf) shelf_want_catalog();
    goto_sections_collapsed();
    sk_build(at);
    ui_effect("refill", sk_ids[at], -1);
    ui_effect("retext", sk_ids[at], -1)
}

// Go To opened (where a pick lands: aim) with words in its field
// (Study's More Commentaries: "Commentaries").
goto_open_with(aim: int, words: str) {
    sk_open(SCR_GOTO, aim, false);
    at: int = sk_top();
    if (at < 0 || sk_kinds[at] != SCR_GOTO) return;
    fbuf_n = 0;
    fput_str(words);
    goto_field_from_fbuf(at)
}

// Return in Go To's field with no reference or book: the first document
// its query matched opened (from screen at); whether there was one.
goto_open_first_document(at: int): bool {
    match goto_found.first {
        NoDocumentFound -> false;
        DocumentFound f -> {
            doc_open(at, doc_of_ref(f.ref));
            true
        }
    }
}

// ---- opening a document ----
// Document d opened from screen at (a Go To's, or a screen over it), where
// a pick there lands.
doc_open(at: int, d: Document) {
    match d {
        Version v -> doc_read_version(at, v.text);
        Module m -> doc_open_module(at, m.item);
        Entry e -> doc_open_entry(at, e.at)
    }
}

// The catalog's entry at (not on the Bookshelf) opened from screen at: put
// on the Bookshelf (room made for a Bible, if every Bible's place is taken,
// by letting go of the one read longest ago that no pane shows), then
// opened as a module coming.
doc_open_entry(at: int, entry_at: int) {
    if (entry_at < 0 || entry_at >= shelf_catalog_count()) return;
    i: int = -1;
    borrow shelf_catalog as catalog {
        entry: *CatalogEntry = &catalog.entries[entry_at];
        i = shelf_find(entry.info.name);
        if (i < 0 && (!shelf_full_for(entry.info.kind) || shelf_free_bible_slot())) {
            shelf_add(entry);
            i = shelf_find(entry.info.name)
        }
        if (i < 0) {
            fbuf_n = 0;
            fput_str("Couldn\â\€\™t open ");
            fput_short_title(entry.info.description);
            fput(46);
            ui_toast(TOAST_WARNING)
        }
    }
    if (i >= 0) doc_open_module(at, i)
}

// Module i opened from screen at: read at once if it is here (one that
// couldn't be opened, fetched anew); else on its way to the pane it lands
// in (doc_arrive), the sheet put away; or, a dictionary or a book, its
// screen pushed, saying it is opening until it has come.
doc_open_module(at: int, i: int) {
    item: int = if (shelf_broken_at(i)) shelf_fetch_again(i) else i;
    if (item < 0) return;
    if (shelf_here_at(item)) {
        shelf_read(at, item);
        return
    }
    // (Tapped again after it failed: fetched again.)
    if (shelf_failed_slot == shelf_slot_at(item)) shelf_failed_slot = -1;
    pane: int = doc_landing(at, item);
    if (pane < 0) {
        shelf_pump();
        shelf_open_reading(item, false);
        return
    }
    doc_leave_sheet(at);
    doc_arrive(pane, item)
}

// The pane module i read from screen at lands in: a Bible as a version
// (the panel's, aimed there, else the page's); a commentary in the panel,
// aimed there or where the panel fits, else on the page; -1 none (a
// dictionary's or a book's screens, over the sheet).
doc_landing(at: int, i: int): int {
    k: int = shelf_kind_at(i);
    if (k == SHELF_KIND_BIBLE) return if (sk_aims_panel(at)) PANE_PANEL else PANE_PAGE;
    if (k == SHELF_KIND_COMMENTARY) return if (sk_aims_panel(at) || sk_panel_fits) PANE_PANEL else PANE_PAGE;
    -1
}

// ---- a document on its way to a pane ----
// A pane sent a document not on the device yet goes on showing what it
// shows (scrolled, read, followed by the link map) while the document is
// fetched and made: its name names the new one at once, and a hairline
// under its bar fills as it comes (`arriving P THOUSANDTHS`). Once it can
// be read there at once (made, open, and its parts at the pane's place
// read), the pane changes to it there as for any pick (`forget P -1`, then
// `go`), and the hairline goes (`arrived P`). Failed, its name is said as
// it was, the hairline goes, and a toast says so. Picked again for the
// pane meanwhile, the newer pick wins; the earlier goes on coming, unsaid.
// The panel sent one while it showed none (closed, or nothing read there)
// keeps it now and opens, "Openingâ€¦" in its place (doc_pane_opening).
type PaneArrival =
    | Idle
    | Coming { slot: int, told: int }

doc_arrivals: []PaneArrival = [PaneArrival.Idle, PaneArrival.Idle];

// How much more must come before the skin is told again (thousandths).
ARRIVAL_TOLD_STEP: int = 20;

// The slot of the module on its way to pane p (-1: none).
doc_arriving_slot(p: int): int {
    match doc_arrivals[p] {
        Coming c -> c.slot;
        Idle -> -1
    }
}

// Whether the module in slot is on its way to either pane.
doc_arriving_any(slot: int): bool {
    slot >= 0 && (doc_arriving_slot(PANE_PAGE) == slot || doc_arriving_slot(PANE_PANEL) == slot)
}

// Module i (not here yet) sent to pane p: fetched first of what is wanted,
// the pane named for it, and the skin told how much has come.
doc_arrive(p: int, i: int) {
    doc_arrivals[p] = PaneArrival.Coming { slot: shelf_slot_at(i), told: -1 };
    shelf_pump();
    if (p == PANE_PAGE) sk_write_title() else doc_panel_names_arriving(i);
    doc_arrivals_check()
}

// The panel named for module i on its way: its reader's bar made again;
// showing none (closed, or nothing read there), it keeps the module now and
// opens with it, "Openingâ€¦" in its place.
doc_panel_names_arriving(i: int) {
    reader: int = bb_reader_at();
    if (sk_beside_open() && reader >= 0 && !doc_panel_keeps(shelf_slot_at(i))) {
        bb_remake(reader);
        return
    }
    sk_beside_keep(if (shelf_kind_at(i) == SHELF_KIND_BIBLE) PanelDocument.Version { text: shelf_text_of(i) } else PanelDocument.Module { slot: shelf_slot_at(i) });
    bb_reader_begin();
    sk_beside_show_kept()
}

// Whether the panel keeps the module in slot as what it reads (a Bible as
// its version).
doc_panel_keeps(slot: int): bool {
    match sk_beside_kept() {
        Module m -> m.slot == slot;
        Version v -> v.text == TEXT_SHELF_FIRST + slot;
        NoDocument -> false
    }
}

// Whether pane p shows "Openingâ€¦" in place of a document: the panel sent a
// module while it showed none, which can't be read yet.
doc_pane_opening(p: int): bool {
    slot: int = doc_arriving_slot(p);
    if (slot < 0 || p != PANE_PANEL || !doc_panel_keeps(slot)) return false;
    !pane_anchors_knowable(p)
}

// The name of the module on its way to pane p, where the pane's name goes
// onto fbuf: the page's bar's (a Bible's short name; a commentary's first
// word), the panel's (a Bible's title; a commentary's short title; filling
// the screen, as the page's bar).
fput_doc_arriving_name(p: int) {
    i: int = shelf_find_slot(doc_arriving_slot(p));
    short: bool = p == PANE_PAGE || sk_beside_full();
    bible: bool = shelf_kind_at(i) == SHELF_KIND_BIBLE;
    if (short) {
        if (bible) fput_shelf_abbreviation(i) else fput_shelf_bar_name_shortened(i)
    } else if (bible) fput_shelf_title(i) else fput_shelf_short_title(i)
}

// Each arrival looked at as the Bookshelf moves (a fetch's bytes, a step of
// making, a module made, opened or read): failed, arrived, or how far it
// has come told, once it has come further.
doc_arrivals_check() {
    for p in 0..PANES {
        match doc_arrivals[p] {
            Coming c -> doc_arrival_look(p, c.slot, c.told);
            Idle -> { }
        }
    }
}

doc_arrival_look(p: int, slot: int, told: int) {
    i: int = shelf_find_slot(slot);
    if (i < 0 || slot == shelf_failed_slot || shelf_broken_at(i)) {
        doc_arrival_failed(p, i);
        return
    }
    if (doc_arrival_ready(p, i)) {
        doc_arrival_done(p, i);
        return
    }
    progress: int = shelf_progress(slot);
    if (progress < 0) progress = (if (shelf_here_at(i)) 1000 else 0);
    if (told >= 0 && progress < told + ARRIVAL_TOLD_STEP && !(progress == 1000 && told < 1000)) return;
    doc_arrivals[p] = PaneArrival.Coming { slot: slot, told: progress };
    ui_str("arriving ");
    ui_int(p);
    ui_byte(32);
    ui_int(progress);
    ui_byte(10)
}

// Whether module i can be shown in pane p at once: here, and a Bible's text
// read, or a commentary open with its parts at the pane's place read (what
// is missing asked for, as the Bookshelf rests).
doc_arrival_ready(p: int, i: int): bool {
    if (!shelf_here_at(i)) return false;
    if (shelf_kind_at(i) == SHELF_KIND_BIBLE) {
        t: int = shelf_text_of(i);
        if (text_ready(t)) return true;
        shelf_ask_text(t);
        return false
    }
    cv: int = doc_landing_verse(p);
    shelf_comment_verse_ready(shelf_slot_at(i), cv / 1000, cv % 1000)
}

// Where a document sent to pane p goes in it (chapter * 1000 + verse): the
// panel's own place while it is unlinked and shows a document, else the
// page's.
doc_landing_verse(p: int): int {
    if (p == PANE_PANEL && bb_reader_at() >= 0 && !sk_beside_linked() && !doc_pane_opening(PANE_PANEL)) return bb_reader_c * 1000 + bb_reader_v;
    sk_c * 1000 + sk_v
}

// Module i arrived for pane p: the pane changes to it at its place, as a
// pick of it here would; then the hairline goes.
doc_arrival_done(p: int, i: int) {
    doc_arrivals[p] = PaneArrival.Idle;
    slot: int = shelf_slot_at(i);
    shelf_note_read(i, -1);
    if (shelf_kind_at(i) == SHELF_KIND_BIBLE) {
        t: int = shelf_text_of(i);
        if (p == PANE_PAGE) sk_use_version(t) else sk_beside_read_in_place(PanelDocument.Version { text: t })
    } else if (p == PANE_PAGE) {
        page_read(PlaceDocument.Module { slot: slot });
        pane_go_verse(PANE_PAGE, sk_c, sk_v, 0, PANE_GO_AT_ONCE);
        sk_save()
    } else sk_beside_read_in_place(PanelDocument.Module { slot: slot });
    doc_write_arrived(p)
}

// Module i couldn't come for pane p (item -1: gone): the pane named for
// what it shows again (the panel closed, if it showed none), the hairline
// gone, and a toast.
doc_arrival_failed(p: int, i: int) {
    slot: int = doc_arriving_slot(p);
    nothing: bool = p == PANE_PANEL && doc_panel_keeps(slot);
    doc_arrivals[p] = PaneArrival.Idle;
    if (p == PANE_PAGE) sk_write_title() else if (nothing) {
        sk_beside_keep(PanelDocument.NoDocument);
        sk_beside_closed();
        sk_close_group(1);
        sk_write_beside()
    } else bb_reader_remade();
    doc_write_arrived(p);
    fbuf_n = 0;
    fput_str("Couldn\â\€\™t open ");
    if (i >= 0) fput_shelf_short_title(i) else fput_str("it");
    fput(46);
    ui_toast(TOAST_WARNING)
}

// Pane p no longer waits for what was on its way (another pick for it, the
// panel closed, Swap Panes): named for what it shows, the hairline gone.
// What was coming goes on coming, unsaid.
doc_arrival_end(p: int) {
    if (doc_arriving_slot(p) < 0) return;
    doc_arrivals[p] = PaneArrival.Idle;
    if (p == PANE_PAGE) sk_write_title() else bb_reader_remade();
    doc_write_arrived(p)
}

// The connection lost: each arrival not here yet failed.
doc_arrivals_offline() {
    for p in 0..PANES {
        i: int = shelf_find_slot(doc_arriving_slot(p));
        if (doc_arriving_slot(p) >= 0 && !shelf_here_at(i)) doc_arrival_failed(p,
            i)
    }
}

doc_write_arrived(p: int) {
    ui_str("arrived ");
    ui_int(p);
    ui_byte(10)
}

// ---- updates ----
// Item i's catalog entry, if it is a newer version of it than the one
// here (-1: none, or no catalog read).
shelf_update_entry(i: int): int {
    if (!shelf_here_at(i) || shelf_list == null) return -1;
    at: int = shelf_catalog_find_item(i);
    if (at < 0) return -1;
    newer: bool = false;
    borrow shelf_list as list {
        borrow shelf_catalog as catalog {
            newer = version_newer(catalog.entries[at].info.version, list.items[i].version)
        }
    }
    if (newer) at else -1
}

// Whether version a is newer than b: their dotted numbers compared in
// turn ("1.10" after "1.9"); one with no number, never.
version_newer(a: str, b: str): bool {
    if (len(a) == 0 || len(b) == 0) return false;
    ia: int = 0;
    ib: int = 0;
    while (ia < len(a) || ib < len(b)) {
        na: int = 0;
        while (ia < len(a) && a[ia] as int >= '0' as int && a[ia] as int <= '9' as int) {
            na = na * 10 + (a[ia] as int - '0' as int);
            ia = ia + 1
        }
        nb: int = 0;
        while (ib < len(b) && b[ib] as int >= '0' as int && b[ib] as int <= '9' as int) {
            nb = nb * 10 + (b[ib] as int - '0' as int);
            ib = ib + 1
        }
        if (na != nb) return na > nb;
        // (Past the separator: a dot, or anything else.)
        if (ia < len(a)) ia = ia + 1;
        if (ib < len(b)) ib = ib + 1
    }
    false
}
