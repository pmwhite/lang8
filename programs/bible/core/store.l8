tag bible;

use_tag std;

// What the reader keeps, apart from any platform: highlights, bookmarks,
// notes (on verses, and on whole chapters) and history, held in sorted
// arrays; their files' lines (tab-separated, as DESIGN.md Â§4.3 has them)
// written into fbuf and read back from it, a bad line skipped rather than
// believed; and everything kept, as Markdown to export. ios_store.l8 reads
// and writes the files themselves.
import "text.l8";

extern time(t: int): int;

// A verse as one number: its chapter (through the Bible) and its verse (0
// for the chapter as a whole: a chapter's note).
verse_key(c: int, v: int): int {
    c * 1000 + v
}

key_chapter(k: int): int {
    k / 1000
}

key_verse(k: int): int {
    k % 1000
}

// Highlights' colors: their names (as stored), and as shown.
hl_names: []str = ["yellow", "green", "blue", "pink", "purple"];

hl_titles: []str = ["Yellow", "Green", "Blue", "Pink", "Purple"];

// ---- highlights: a verse each, sorted ----
type Highlight = {
    key: int;
    color: int;
    time: int
}

hl_n: int = 0;

highlights: []Highlight = new Highlight[32768](Highlight { key: 0, color: 0, time: 0 });

// ---- bookmarks ----
type Bookmark = {
    key: int;
    time: int
}

bm_n: int = 0;

bookmarks: []Bookmark = new Bookmark[8192](Bookmark { key: 0, time: 0 });

// ---- notes: on their first verse, to their last (a chapter's note on
// verse 0, to 0); their text in a pool ----
type Note = {
    key: int;
    end: int;
    time: int;
    // Its text: text_n bytes of nt_pool from text_at.
    text_at: int;
    text_n: int
}

nt_n: int = 0;

kept_notes: []Note = new Note[4096](Note {
    key: 0,
    end: 0,
    time: 0,
    text_at: 0,
    text_n: 0
});

nt_pool: []i8 = new i8[1048576](0i8);

nt_pool_n: int = 0;

// ---- history: a trail of chapters read (each its verse, how far into it,
// whether the verse was exact, and when), newest last ----
HISTORY_MOST: int = 200;

type Visit = {
    chapter: int;
    verse: int;
    frac: int;
    exact: bool;
    time: int
}

hs_n: int = 0;

visits: []Visit = new Visit[201](Visit {
    chapter: 0,
    verse: 0,
    frac: 0,
    exact: false,
    time: 0
});

// Where key k is (or would go) among the highlights, bookmarks or notes,
// each sorted by key.
highlight_find(k: int): int {
    lo: int = 0;
    hi: int = hl_n;
    while (lo < hi) {
        mid: int = (lo + hi) / 2;
        if (highlights[mid].key < k) lo = mid + 1 else hi = mid
    }
    lo
}

bookmark_find(k: int): int {
    lo: int = 0;
    hi: int = bm_n;
    while (lo < hi) {
        mid: int = (lo + hi) / 2;
        if (bookmarks[mid].key < k) lo = mid + 1 else hi = mid
    }
    lo
}

note_find(k: int): int {
    lo: int = 0;
    hi: int = nt_n;
    while (lo < hi) {
        mid: int = (lo + hi) / 2;
        if (kept_notes[mid].key < k) lo = mid + 1 else hi = mid
    }
    lo
}

// The color (0 to 4) of verse v of chapter c's highlight, or -1.
highlight_of(c: int, v: int): int {
    k: int = verse_key(c, v);
    i: int = highlight_find(k);
    if (i < hl_n && highlights[i].key == k) highlights[i].color else -1
}

set_highlight(c: int, v: int, color: int) {
    set_highlight_at(c, v, color, time(0))
}

// Color (-1: none) on verse v of chapter c, made at time t.
set_highlight_at(
    c: int,
    v: int,
    color: int,
    t: int
) {
    k: int = verse_key(c, v);
    i: int = highlight_find(k);
    if (i < hl_n && highlights[i].key == k) {
        if (color < 0) {
            for j in i..hl_n - 1 highlights[j] = highlights[j + 1];
            hl_n = hl_n - 1
        } else {
            highlights[i].color = color;
            highlights[i].time = t
        }
        return
    }
    if (color < 0 || hl_n >= len(highlights)) return;
    j: int = hl_n;
    while (j > i) {
        highlights[j] = highlights[j - 1];
        j = j - 1
    }
    highlights[i] = Highlight { key: k, color: color, time: t };
    hl_n = hl_n + 1
}

is_bookmarked(c: int, v: int): bool {
    k: int = verse_key(c, v);
    i: int = bookmark_find(k);
    i < bm_n && bookmarks[i].key == k
}

set_bookmark(c: int, v: int, on: bool) {
    set_bookmark_at(c, v, on, time(0))
}

set_bookmark_at(
    c: int,
    v: int,
    on: bool,
    t: int
) {
    k: int = verse_key(c, v);
    i: int = bookmark_find(k);
    here: bool = i < bm_n && bookmarks[i].key == k;
    if (here && !on) {
        for j in i..bm_n - 1 bookmarks[j] = bookmarks[j + 1];
        bm_n = bm_n - 1
    }
    if (!here && on && bm_n < len(bookmarks)) {
        j: int = bm_n;
        while (j > i) {
            bookmarks[j] = bookmarks[j - 1];
            j = j - 1
        }
        bookmarks[i] = Bookmark { key: k, time: t };
        bm_n = bm_n + 1
    }
}

// The note on verse v of chapter c (one that begins there; verse 0, the
// chapter's own), or -1.
note_of(c: int, v: int): int {
    k: int = verse_key(c, v);
    i: int = note_find(k);
    if (i < nt_n && kept_notes[i].key == k) i else -1
}

// The note on verses v to last of chapter c: its text the first n bytes of
// b (none, if n is 0).
set_note(
    c: int,
    v: int,
    last: int,
    b: []i8,
    n: int
) {
    set_note_at(c, v, last, b, n, time(0))
}

set_note_at(
    c: int,
    v: int,
    last: int,
    b: []i8,
    n: int,
    t: int
) {
    k: int = verse_key(c, v);
    i: int = note_find(k);
    here: bool = i < nt_n && kept_notes[i].key == k;
    if (n == 0) {
        if (here) {
            for j in i..nt_n - 1 kept_notes[j] = kept_notes[j + 1];
            nt_n = nt_n - 1
        }
        return
    }
    if (!here) {
        if (nt_n >= len(kept_notes)) return;
        j: int = nt_n;
        while (j > i) {
            kept_notes[j] = kept_notes[j - 1];
            j = j - 1
        }
        nt_n = nt_n + 1;
        kept_notes[i].key = k
    }
    if (nt_pool_n + n > len(nt_pool)) compact_notes();
    m: int = if (nt_pool_n + n > len(nt_pool)) len(nt_pool) - nt_pool_n else n;
    for x in 0..m nt_pool[nt_pool_n + x] = b[x];
    kept_notes[i].text_at = nt_pool_n;
    kept_notes[i].text_n = m;
    nt_pool_n = nt_pool_n + m;
    kept_notes[i].end = last;
    kept_notes[i].time = t
}

// The notes' texts moved together (the pool's old texts let go).
compact_buf: []i8 = new i8[1048576](0i8);

compact_notes() {
    n: int = 0;
    for i in 0..nt_n {
        for x in 0..kept_notes[i].text_n compact_buf[n + x] = nt_pool[kept_notes[i].text_at + x];
        kept_notes[i].text_at = n;
        n = n + kept_notes[i].text_n
    }
    for x in 0..n nt_pool[x] = compact_buf[x];
    nt_pool_n = n
}

// ---- history ----
// A place read (chapter c, verse v, frac thousandths of em into it, the
// verse exact or not), at time t: the newest entry replaced if it is of the
// same chapter (history is a trail of chapters, not of every scroll), else
// added, the oldest let go past HISTORY_MOST.
history_add(
    c: int,
    v: int,
    frac: int,
    exact: bool,
    t: int
) {
    if (c < 0 || c >= chapters) return;
    i: int = hs_n;
    if (hs_n > 0 && visits[hs_n - 1].chapter == c) i = hs_n - 1 else {
        if (hs_n >= HISTORY_MOST) {
            history_delete(0);
            i = hs_n
        }
        hs_n = hs_n + 1
    }
    visits[i] = Visit {
        chapter: c,
        verse: v,
        frac: frac,
        exact: exact,
        time: t
    }
}

history_delete(i: int) {
    if (i < 0 || i >= hs_n) return;
    for j in i..hs_n - 1 visits[j] = visits[j + 1];
    hs_n = hs_n - 1
}

// ---- writing: into fbuf ----
fbuf: []i8 = new i8[2097152](0i8);

fbuf_n: int = 0;

fput(k: int) {
    if (fbuf_n < len(fbuf)) {
        fbuf[fbuf_n] = k trunc i8;
        fbuf_n = fbuf_n + 1
    }
}

fput_str(s: str) {
    for k in s fput(k as int)
}

fput_int(n: int) {
    if (n < 0) {
        fput(45);
        fput_int(-n);
        return
    }
    if (n >= 10) fput_int(n / 10);
    fput(48 + n % 10)
}

fput_bytes(b: []i8, from: int, to: int) {
    for i in from..to fput(b[i] as int)
}

// A book's code (GEN), then a tab.
fput_book(b: int) {
    for i in 0..3 fput(bsb[book_line[b] + 1 + i] as int);
    fput(9)
}

fput_place(c: int, v: int) {
    fput_book(ch_book[c]);
    fput_int(ch_num[c]);
    fput(9);
    fput_int(v);
    fput(9)
}

format_highlights() {
    fbuf_n = 0;
    for i in 0..hl_n {
        fput_place(key_chapter(highlights[i].key), key_verse(highlights[i].key));
        fput_str(hl_names[highlights[i].color]);
        fput(9);
        fput_int(highlights[i].time);
        fput(10)
    }
}

format_bookmarks() {
    fbuf_n = 0;
    for i in 0..bm_n {
        fput_place(key_chapter(bookmarks[i].key), key_verse(bookmarks[i].key));
        fput_int(bookmarks[i].time);
        fput(10)
    }
}

format_notes() {
    fbuf_n = 0;
    for i in 0..nt_n {
        fput_place(key_chapter(kept_notes[i].key), key_verse(kept_notes[i].key));
        fput_int(kept_notes[i].end);
        fput(9);
        fput_int(kept_notes[i].time);
        fput(9);
        for x in 0..kept_notes[i].text_n {
            k: int = nt_pool[kept_notes[i].text_at + x] as int;
            if (k == 92) fput_str("\\\\") else if (k == 10) fput_str("\\n") else if (k == 9) fput_str("\\t") else fput(k)
        }
        fput(10)
    }
}

format_history() {
    fbuf_n = 0;
    for i in 0..hs_n {
        fput_place(visits[i].chapter, visits[i].verse);
        fput_int(visits[i].time);
        // (Beyond the four columns: how far into the verse, and whether the
        // place was a verse.)
        fput(9);
        fput_int(visits[i].frac);
        fput(9);
        fput_int(if (visits[i].exact) 1 else 0);
        fput(10)
    }
}

// ---- reading: from fbuf, a line at a time ----
fpos: int = 0;

line_e: int = 0;

begin_lines() {
    fpos = 0;
    line_e = -1
}

// The next line (false at the end): fpos is its start, line_e its end.
next_line(): bool {
    fpos = line_e + 1;
    if (fpos >= fbuf_n) return false;
    line_e = fpos;
    while (line_e < fbuf_n && fbuf[line_e] as int != 10) line_e = line_e + 1;
    // (A carriage return before the newline is not part of the line.)
    true
}

// The field after the one at p (past its tab): where it starts, or past
// the line's end if there is none.
field_after(p: int): int {
    if (p > line_e) return line_e + 1;
    q: int = p;
    while (q < line_e && fbuf[q] as int != 9) q = q + 1;
    q + 1
}

// Where the field at p ends (its tab, or the line's end, less a carriage
// return).
field_end(p: int): int {
    q: int = p;
    while (q < line_e && fbuf[q] as int != 9) q = q + 1;
    if (q > p && q == line_e && fbuf[q - 1] as int == 13) q = q - 1;
    q
}

// The field at p as a whole number (a minus first, if signed): -1 if it is
// missing or not a number through and through (so a signed field reads
// as missing_num).
missing_num: int = -1000000000;

field_num(p: int, signed: bool): int {
    if (p > line_e) return missing_num;
    e: int = field_end(p);
    q: int = p;
    neg: bool = false;
    if (signed && q < e && fbuf[q] as int == 45) {
        neg = true;
        q = q + 1
    }
    if (q >= e || e - q > 12) return missing_num;
    n: int = 0;
    while (q < e) {
        k: int = fbuf[q] as int;
        if (k < 48 || k > 57) return missing_num;
        n = n * 10 + k - 48;
        q = q + 1
    }
    if (neg) -n else n
}

// The chapter a line's first two fields name (GEN, 1), or -1: an unknown
// book's code, or a chapter it does not have, is none.
field_chapter(p: int): int {
    if (p + 3 >= line_e || fbuf[p + 3] as int != 9) return -1;
    for b in 0..books {
        same: bool = true;
        for i in 0..3
            if (bsb[book_line[b] + 1 + i] != fbuf[p + i]) same = false;
        if (same) {
            n: int = field_num(field_after(p), false);
            if (n < 1 || n > book_count[b]) return -1;
            return book_first[b] + n - 1
        }
    }
    -1
}

field_is(p: int, word: str): bool {
    e: int = field_end(p);
    if (p > line_e || e - p != len(word)) return false;
    for i in 0..len(word)
        if (fbuf[p + i] != word[i]) return false;
    true
}

// A verse field of chapter c: its number, or -1 if it is not one of the
// chapter's verses in any bundled version (ref_last: a mark made in the WEB
// on Romans 14:25, past the BSB's last, is kept; 0 allowed only if
// zero_ok).
field_verse(p: int, c: int, zero_ok: bool): int {
    v: int = field_num(p, false);
    if (v == 0 && zero_ok) return 0;
    if (v < 1 || v > ref_last(c)) return -1;
    v
}

// A time field: its number (0 if it is missing or bad, which costs only
// the time).
field_time(p: int): int {
    t: int = field_num(p, false);
    if (t < 0) 0 else t
}

// How many lines were read, and how many skipped as bad (each file's).
lines_read: int = 0;

lines_skipped: int = 0;

skip_line() {
    lines_skipped = lines_skipped + 1
}

// The highlights' file (in fbuf): BOOK C V COLOR TIME a line.
parse_highlights() {
    begin_lines();
    hl_n = 0;
    lines_read = 0;
    lines_skipped = 0;
    while (next_line()) {
        if (line_e > fpos) {
            lines_read = lines_read + 1;
            c: int = field_chapter(fpos);
            f3: int = field_after(field_after(fpos));
            f4: int = field_after(f3);
            f5: int = field_after(f4);
            v: int = if (c >= 0) field_verse(f3, c, false) else -1;
            color: int = -1;
            for i in 0..5
                if (field_is(f4, hl_names[i])) color = i;
            if (c >= 0 && v > 0 && color >= 0) set_highlight_at(c, v, color, field_time(f5)) else skip_line()
        }
    }
}

// BOOK C V TIME.
parse_bookmarks() {
    begin_lines();
    bm_n = 0;
    lines_read = 0;
    lines_skipped = 0;
    while (next_line()) {
        if (line_e > fpos) {
            lines_read = lines_read + 1;
            c: int = field_chapter(fpos);
            f3: int = field_after(field_after(fpos));
            v: int = if (c >= 0) field_verse(f3, c, false) else -1;
            if (c >= 0 && v > 0) set_bookmark_at(c, v, true, field_time(field_after(f3))) else skip_line()
        }
    }
}

note_buf: []i8 = new i8[65536](0i8);

// BOOK C V VERSE_END TIME TEXT (the text's \, newline and tab escaped; a
// chapter's note on verse 0, to 0).
parse_notes() {
    begin_lines();
    nt_n = 0;
    nt_pool_n = 0;
    lines_read = 0;
    lines_skipped = 0;
    while (next_line()) {
        if (line_e > fpos) {
            lines_read = lines_read + 1;
            c: int = field_chapter(fpos);
            f3: int = field_after(field_after(fpos));
            f4: int = field_after(f3);
            f5: int = field_after(f4);
            f6: int = field_after(f5);
            v: int = if (c >= 0) field_verse(f3, c, true) else -1;
            last: int = field_num(f4, false);
            if (v == 0) {
                if (last != 0) v = -1
            } else if (v > 0 && last < 0) v = -1 else if (v > 0) {
                if (last < v) last = v;
                if (last > ref_last(c)) last = ref_last(c)
            }
            n: int = 0;
            q: int = f6;
            e: int = if (f6 <= line_e) field_end_text(f6) else f6;
            while (q < e && n < len(note_buf)) {
                k: int = fbuf[q] as int;
                if (k == 92 && q + 1 < e) {
                    q = q + 1;
                    m: int = fbuf[q] as int;
                    k = (if (m == 110) 10 else if (m == 116) 9 else m)
                }
                note_buf[n] = k trunc i8;
                n = n + 1;
                q = q + 1
            }
            if (c >= 0 && v >= 0 && n > 0) set_note_at(c, v, last, note_buf, n, field_time(f5)) else skip_line()
        }
    }
}

// The end of a note's text: the line's (less a carriage return; a tab in it
// would have been escaped).
field_end_text(p: int): int {
    q: int = line_e;
    if (q > p && fbuf[q - 1] as int == 13) q = q - 1;
    q
}

// BOOK C V TIME [FRAC EXACT], oldest first.
parse_history() {
    begin_lines();
    hs_n = 0;
    lines_read = 0;
    lines_skipped = 0;
    while (next_line()) {
        if (line_e > fpos) {
            lines_read = lines_read + 1;
            c: int = field_chapter(fpos);
            f3: int = field_after(field_after(fpos));
            f4: int = field_after(f3);
            f5: int = field_after(f4);
            f6: int = field_after(f5);
            v: int = if (c >= 0) field_verse(f3, c, true) else -1;
            frac: int = field_num(f5, true);
            if (frac == missing_num) frac = 0;
            if (c >= 0 && v >= 0) history_add(c, v, frac, field_num(f6, false) == 1,
                field_time(f4)) else skip_line()
        }
    }
}

// ---- which version a verse is quoted from (DESIGN.md Â§9.1.3) ----
// The Library, export, history and notes quote a verse from the current
// version if it is one on the phone and has it; else the BSB if it has it;
// else the first version loaded that has it, in the Versions' order (its
// abbreviation then shown after the reference). Never the ESV: these are
// lists and files that outlast a page. -1 if none has it.
quote_text(c: int, v: int): int {
    if (text_cur != TEXT_ESV && text_has(text_cur, c, v)) return text_cur;
    if (text_has(TEXT_BSB, c, v)) return TEXT_BSB;
    for t in 1..TEXT_ESV
        if (text_has(t, c, v)) return t;
    -1
}

// A version's short name where one passage is named: the Hebrew and
// Greek's language, by the chapter's testament ("Psalm 23 Â· Hebrew",
// Â§14.11.2); the others' abbreviations.
fput_version_short(t: int, c: int) {
    if (t == TEXT_ORIG) fput_str(if (c >= 0 && c < chapters && ch_book[c] < 39) "Hebrew" else "Greek") else fput_str(text_abbrs[t])
}

// The version quotes are given in when nothing says otherwise: the current
// one, but the BSB for the ESV.
quote_base(): int {
    if (text_cur == TEXT_ESV) TEXT_BSB else text_cur
}

// The first words of verse v of chapter c (the first verse, for 0), at
// most about most bytes (cut at a word, with an ellipsis), onto fbuf: the
// current version's, or the BSB's under the ESV.
fput_opening_words(c: int, v: int, most: int) {
    _n: int = verse_text_of(quote_base(), c, if (v > 0) v else 1);
    n: int = vt_n;
    if (n > most) {
        n = most;
        while (n > 0 && vt[n] as int != 32) n = n - 1;
        if (n == 0) n = most
    }
    for i in 0..n fput(vt[i] as int);
    if (n < vt_n) fput_str("\â\€\¦")
}

// A time of day (seconds since midnight, local) as a clock says it: 3:24 PM.
fput_clock(t: int) {
    s: int = (t % 86400 + 86400) % 86400;
    h: int = s / 3600;
    m: int = s / 60 % 60;
    fput_int(if (h % 12 == 0) 12 else h % 12);
    fput(58);
    if (m < 10) fput(48);
    fput_int(m);
    fput_str(if (h < 12) " AM" else " PM")
}

// ---- references and dates, as text ----
// A chapter's name (Genesis 1, Psalm 23), its verses v to last after it
// (none for v 0): John 3:16, John 3:16â€“17; Jude 3.
fput_title(c: int) {
    source: TextSource = text_source(text_cur);
    fput_title_from(&source, c)
}

// A reference label must not overwrite a chapter's layout buffers.
fput_title_from(source: *TextSource, c: int) {
    b: int = ch_book[c];
    if (source_book_is(source, b, "PSA")) fput_str("Psalm") else fput_bytes(source.data,
        source_book_name_start(source, b), source_book_name_end(source, b));
    if (book_count[b] > 1) {
        fput(32);
        fput_int(ch_num[c])
    }
}

fput_ref(c: int, v: int, last: int) {
    fput_title(c);
    if (v <= 0) return;
    fput(if (book_count[ch_book[c]] > 1) 58 else 32);
    fput_int(v);
    if (last > v) {
        fput_str("\â\€\“");
        fput_int(last)
    }
}

// A chapter's name as it is said before it is read aloud: "John, chapter
// 4", "Psalm 23", "Jude".
fput_spoken_title(c: int) {
    b: int = ch_book[c];
    if (book_is(b, "PSA")) {
        fput_str("Psalm ");
        fput_int(ch_num[c]);
        return
    }
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    if (book_count[b] > 1) {
        fput_str(", chapter ");
        fput_int(ch_num[c])
    }
}

month_names: []str = ["January", "February", "March", "April", "May", "June", "July",
    "August", "September", "October", "November", "December"];

weekday_names: []str = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday",
    "Saturday"];

// A day (counted from 1 January 1970) as its year, month (1 to 12) and day
// of the month: date_y, date_m, date_d.
date_y: int = 1970;

date_m: int = 1;

date_d: int = 1;

civil_date(days: int) {
    z: int = days + 719468;
    era: int = (if (z >= 0) z else z - 146096) / 146097;
    doe: int = z - era * 146097;
    yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    y: int = yoe + era * 400;
    doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100);
    mp: int = (5 * doy + 2) / 153;
    date_d = doy - (153 * mp + 2) / 5 + 1;
    date_m = (if (mp < 10) mp + 3 else mp - 9);
    date_y = (if (date_m <= 2) y + 1 else y)
}

// The day of a time (seconds since 1970, already in local time).
day_of(t: int): int {
    if (t >= 0) t / 86400 else (t - 86399) / 86400
}

// 0 Sunday to 6 Saturday.
weekday_of(days: int): int {
    w: int = (days + 4) % 7;
    if (w < 0) w + 7 else w
}

// "18 October 2026".
fput_date(days: int) {
    civil_date(days);
    fput_int(date_d);
    fput(32);
    fput_str(month_names[date_m - 1]);
    fput(32);
    fput_int(date_y)
}

// "2026-10-18".
fput_iso_date(days: int) {
    civil_date(days);
    fput_int(date_y);
    fput(45);
    if (date_m < 10) fput(48);
    fput_int(date_m);
    fput(45);
    if (date_d < 10) fput(48);
    fput_int(date_d)
}

// ---- export: everything kept, as Markdown (DESIGN.md Â§8.5) ----
// The verse's words, verses v to last joined (no footnotes; LORD as it is
// written).
fput_quote(c: int, v: int, last: int) {
    fput_str("> ");
    x: int = v;
    t: int = quote_text(c, v);
    while (x <= last) {
        if (x > v) fput(32);
        if (t >= 0) {
            _n: int = verse_text_of(t, c, x);
            fput_bytes(vt, 0, vt_n)
        }
        x = x + 1
    }
    fput(10)
}

fput_note_text(i: int) {
    fput_bytes(nt_pool, kept_notes[i].text_at, kept_notes[i].text_at + kept_notes[i].text_n)
}

// Whether there is anything to export.
anything_kept(): bool {
    hl_n > 0 || bm_n > 0 || nt_n > 0
}

// Every highlight, bookmark and note into fbuf, by book and chapter in
// the Bible's order and each chapter's verses in order, the export made on
// day `today` (local). A verse with several marks is one entry (Highlight,
// Bookmark, Note); verses highlighted alike one after another, with no
// other mark, are one entry.
export_notes(today: int) {
    fbuf_n = 0;
    fput_str("# Smooth Bible \â\€\” Notes and Highlights\n");
    fput_str(text_names[quote_base()]);
    fput_str(" \Â\· exported ");
    fput_date(today);
    fput(10);
    ih: int = 0;
    ib: int = 0;
    in_: int = 0;
    last_book: int = -1;
    last_c: int = -1;
    big: int = 2000000000;
    more: bool = true;
    while (more) {
        kh: int = if (ih < hl_n) highlights[ih].key else big;
        kb: int = if (ib < bm_n) bookmarks[ib].key else big;
        kn: int = if (in_ < nt_n) kept_notes[in_].key else big;
        k: int = kh;
        if (kb < k) k = kb;
        if (kn < k) k = kn;
        if (k == big) more = false else {
            c: int = key_chapter(k);
            v: int = key_verse(k);
            if (c != last_c) {
                b: int = ch_book[c];
                if (b != last_book) {
                    fput_str("""

## """);
                    fput_bytes(bsb, book_name_start(b), book_name_end(b));
                    fput(10);
                    last_book = b
                }
                fput_str("""

### """);
                fput_title(c);
                fput(10);
                last_c = c
            }
            if (v == 0) {
                // The chapter's own note.
                if (kn == k) {
                    fput_str("*Chapter note:* ");
                    fput_note_text(in_);
                    fput(10);
                    in_ = in_ + 1
                }
                if (kh == k) ih = ih + 1;
                if (kb == k) ib = ib + 1
            } else {
                h: int = if (kh == k) highlights[ih].color else -1;
                marked: bool = kb == k;
                n: int = if (kn == k) in_ else -1;
                last: int = v;
                if (marked || n >= 0) {
                    if (n >= 0 && kept_notes[n].end > last) last = kept_notes[n].end
                } else {
                    // (A run of verses highlighted alike.)
                    while (last < ch_verses[c] && highlight_of(c, last + 1) == h && !is_bookmarked(c,
                        last + 1) && note_of(c, last + 1) < 0) last = last + 1
                }
                fput_str("""

**""");
                fput_ref(c, v, last);
                fput_str("**");
                // (Quoted from a version other than the export's: which.)
                qt: int = quote_text(c, v);
                if (qt >= 0 && qt != quote_base()) {
                    fput_str(" \Â\· ");
                    fput_str(text_abbrs[qt])
                }
                if (h >= 0) {
                    fput_str(" \Â\· Highlight (");
                    fput_str(hl_names[h]);
                    fput(41)
                }
                if (marked) fput_str(" \Â\· Bookmark");
                if (n >= 0) fput_str(" \Â\· Note");
                fput(10);
                fput_quote(c, v, last);
                if (n >= 0) {
                    fput(10);
                    fput_note_text(n);
                    fput(10)
                }
                // (Past this entry's verses: a run's highlights; the verse's
                // bookmark and note.)
                to: int = verse_key(c, if (marked || n >= 0) v else last);
                while (ih < hl_n && highlights[ih].key <= to) ih = ih + 1;
                if (kb == k) ib = ib + 1;
                if (kn == k) in_ = in_ + 1
            }
        }
    }
}
