tag bible;

use_tag std;

import "chapter_ranges.l8";

// A reader owns both the chapter it rendered and the coordinates measured
// from it. The opener cache belongs to that same reader, across chapters.
type ReaderRendering = {
    layout: ChapterLayout;
    ranges: ChapterRanges;
    // Where each chapter's opener ends (its numeral, UTF-16), once laid out.
    openers: [1200]int
}

reader_rendering(): ReaderRendering@new {
    ReaderRendering { layout: chapter_layout(), ranges: chapter_ranges(), openers: zeroed([1200]int) }
}
