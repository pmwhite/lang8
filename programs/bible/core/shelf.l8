tag bible;

use_tag std, sword, builder;

// The Bookshelf: Bibles, commentaries, dictionaries, devotionals and books
// from CrossWire's SWORD library (https://crosswire.org/sword/), fetched
// when one is first opened and kept on the device to read offline. It has
// no screen of its own: Go To lists its modules with the catalog's others,
// as documents wherever they are kept (core/documents.l8). (Not the
// reader's Library of highlights, notes, bookmarks and Memory.) Core keeps
// what is installed,
// fetches each module's package with the platform's HostIO.fetch and reads
// it back with HostIO.read_kept, as it needs it:
//
//   shelf.tsv             what is installed or asked for, a line each
//   shelf-catalog.tar.gz  the library's catalog (its mods.d.tar.gz)
//   shelf-NAME.zip        a module's package, as the library serves it
//   shelf-NAME.folio      a module made (a Bible's version, another's
//   shelf-NAME.2.folio    folio): one of the two, its line says which
//   shelf-NAME.next.zip   an update's package, while it is made
//
// An update is downloaded and made beside the copy read (into the other
// of its two names), and the module's line switched to it once it is
// kept: what reads the module reads the copy before until then, and is
// sent to the same place in the new one (shelf_update_swap).
//
// What is installed is a dataset (its own arena, made again whole from
// shelf.tsv's lines when it changes); so are the catalog and each module
// open. Nothing the bookshelf does allocates beyond them, so it can run
// wherever core's lines are handled. A Bible becomes a version (core/
// shelf_bible.l8: its slot is TEXT_SHELF_FIRST plus its slot number, at
// most TEXT_SHELF_MOST of them); a commentary, dictionary or book is opened
// while one of its screens or Study shows it. Downloads go one at a time,
// in the order they were asked for, and go on when the app opens again.
import "../../sword/sword.l8";

import "../../folio/folio.l8";

import "shelf_bible.l8";

import "shelf_folio.l8";

import "shelf_screens.l8";

// Where modules come from: CrossWire's main repository.
SHELF_SOURCE: str = "https://www.crosswire.org/ftpmirror/pub/sword/";

SHELF_CATALOG_PATH: str = "raw/mods.d.tar.gz";

SHELF_PACKAGES_PATH: str = "packages/rawzip/";

SHELF_LIST_FILE: str = "shelf.tsv";

SHELF_CATALOG_FILE: str = "shelf-catalog.tar.gz";

// The library's name, as the screens credit it.
SHELF_SOURCE_NAME: str = "CrossWire Bible Society";

SHELF_SOURCE_SHORT_NAME: str = "CrossWire";

// The ids of its fetches and reads (apart from the host's own and held.l8's).
SHELF_FETCH_ID_FIRST: int = 1000000;

SHELF_READ_CATALOG_ID: int = 1999999;

SHELF_READ_ID_FIRST: int = 2000000;

// ---- what is installed ----
// A module installed or asked for. Its slot number is its own while it is
// installed (a Bible's is below TEXT_SHELF_MOST: its text slot follows).
type ShelfItem = {
    name: str;
    slot: int;
    kind: ModuleKind;
    // Its package is here (else it is wanted: downloading, or waiting to).
    ready: bool;
    // Its package's size in bytes (the catalog's while wanted).
    size: int;
    version: str;
    language: str;
    abbreviation: str;
    title: str;
    // When it was asked for (seconds).
    added: int;
    // What it is kept as, once here.
    form: ShelfForm;
    // It could not be opened (until it is downloaded again).
    broken: bool;
    // A Bible's, once opened: whether it marks the words of Jesus, and
    // what of it could not be shown (its verses -1 until then).
    red: bool;
    report: BibleReport;
    // When it was last read (seconds; 0 never), and where in it: a book's
    // part (its node), a dictionary's entry (its index); 0 its start.
    used: int;
    place: int;
    // Which of its two names its made file has (shelf_copy_ending).
    copy: int;
    // Its update, as it goes (this session's: not kept in shelf.tsv).
    update: ShelfUpdate
}

// An update of a module here: none asked for; its package wanted
// (waiting its turn or downloading); downloaded, being made beside the
// copy read (or waiting its turn); failed, the copy before kept (not
// tried again this session, unless for want of a connection); or done,
// the module up to date. An update the app closes
// before it is made is let go: the copy before is read, and the catalog
// still says there is one (what came of it is replaced by the next
// update's, or deleted with the module).
type ShelfUpdate =
    | Current
    | Wanted
    | Fetched
    | Failed { offline: bool }
    | Done

// A made file's two names: shelf-NAME.folio (copy 0) and
// shelf-NAME.2.folio (copy 1), by their ending after shelf-NAME. (as a
// span of a file read names it: TextSpan's).
SHELF_COPIES: int = 2;

shelf_copy_endings: []str = ["folio", "2.folio"];

shelf_copy_ending(copy: int): str {
    shelf_copy_endings[if (copy > 0 && copy < SHELF_COPIES) copy else 0]
}

// The other copy (an update's).
shelf_other_copy(copy: int): int {
    if (copy == 0) 1 else 0
}

// An update's package, as it is fetched and until it is made.
SHELF_UPDATE_PACKAGE: str = ".next.zip";

// What a module downloaded is kept as: its package as it came (packaged:
// the library's zip), or made: a Bible a version (its folio read as a
// bundled version's is), any other module a folio (read a chapter, an
// entry or a part at a time: core/shelf_folio.l8). Unpacked: its SWORD
// files kept apart, as an earlier build kept modules (now let go, and the
// module downloaded and made again, when it is next opened).
type ShelfForm =
    | Packaged
    | Unpacked
    | Made
    | Folio

type ShelfList = {
    items: []ShelfItem;
    count: int
}

no_report: BibleReport = BibleReport {
    missing_books: -1,
    outside_chapters: -1,
    extra_books: -1,
    verses: -1
};

shelf_list: ?owned *ShelfList = null;

// shelf.tsv's fields: name, slot, state, kind, size, version, language,
// added, abbreviation, title; then a made Bible's red letters (1) and
// report (missing books, chapters outside, extra books, verses), zeros for
// another; then when it was last read and its place there; then which of
// its made file's names it has (none: the first).
SHELF_FIELDS: int = 18;

shelf_loaded: bool = false;

// A module's kind as the shelf keeps it (shelf_kind_code: ModuleKind's
// order), and its name in shelf.tsv.
SHELF_KIND_BIBLE: int = 0;

SHELF_KIND_COMMENTARY: int = 1;

SHELF_KIND_DICTIONARY: int = 2;

SHELF_KIND_GLOSSARY: int = 3;

SHELF_KIND_DEVOTIONAL: int = 4;

SHELF_KIND_BOOK: int = 5;

SHELF_KIND_IMAGES: int = 6;

SHELF_KIND_OTHER: int = 7;

shelf_kind_names: []str = ["bible", "commentary", "dictionary", "glossary", "devotional",
    "book", "images", "other"];

shelf_kind_code(kind: ModuleKind): int {
    match kind {
        Bible -> SHELF_KIND_BIBLE;
        Commentary -> SHELF_KIND_COMMENTARY;
        Dictionary -> SHELF_KIND_DICTIONARY;
        Glossary -> SHELF_KIND_GLOSSARY;
        Devotional -> SHELF_KIND_DEVOTIONAL;
        Book -> SHELF_KIND_BOOK;
        Images -> SHELF_KIND_IMAGES;
        Other -> SHELF_KIND_OTHER
    }
}

shelf_kind_of(code: int): ModuleKind {
    if (code == SHELF_KIND_BIBLE) ModuleKind.Bible else if (code == SHELF_KIND_COMMENTARY) ModuleKind.Commentary else if (code == SHELF_KIND_DICTIONARY) ModuleKind.Dictionary else if (code == SHELF_KIND_GLOSSARY) ModuleKind.Glossary else if (code == SHELF_KIND_DEVOTIONAL) ModuleKind.Devotional else if (code == SHELF_KIND_BOOK) ModuleKind.Book else if (code == SHELF_KIND_IMAGES) ModuleKind.Images else ModuleKind.Other
}

// A label's (a title's): each run of spaces one, as SWORD's descriptions
// are read now (a shelf written before kept two).
shelf_label_text(source: []i8, from: int, to: int): str@new {
    out: []i8 = new i8[to - from](0i8);
    n: int = 0;
    for i in from..to {
        k: int = source[i] as int;
        if (k != 0 && (k != 32 || n > 0 && out[n - 1] as int != 32)) {
            out[n] = source[i];
            n = n + 1
        }
    }
    if (n > 0 && out[n - 1] as int == 32) n = n - 1;
    shelf_bytes_text(out, 0, n)
}

// Bytes from up to to as a string (a NUL among them, which a string
// can't hold, left out).
shelf_bytes_text(source: []i8, from: int, to: int): str@new {
    count: int = 0;
    for i in from..to
        if (source[i] as int != 0) count = count + 1;
    out: []i8 = new i8[count](0i8);
    n: int = 0;
    for i in from..to {
        if (source[i] as int != 0) {
            out[n] = source[i];
            n = n + 1
        }
    }
    cstr(out)
}

shelf_ends_with(text: str, end: str): bool {
    if (len(text) < len(end)) return false;
    from: int = len(text) - len(end);
    for i in 0..len(end)
        if (text[from + i] != end[i]) return false;
    true
}

// ---- reading the list: what callers see (each borrows it) ----
shelf_count(): int {
    if (shelf_list == null) return 0;
    n: int = 0;
    borrow shelf_list as list {
        n = list.count
    }
    n
}

// Item i's slot, kind (its code), whether it is here, its size, whether it
// is being read, could not be opened; -1 or false for no such item.
shelf_slot_at(i: int): int {
    if (i < 0 || shelf_list == null) return -1;
    slot: int = -1;
    borrow shelf_list as list {
        if (i < list.count) slot = list.items[i].slot
    }
    slot
}

shelf_kind_at(i: int): int {
    if (i < 0 || shelf_list == null) return -1;
    kind: int = -1;
    borrow shelf_list as list {
        if (i < list.count) kind = shelf_kind_code(list.items[i].kind)
    }
    kind
}

shelf_ready_at(i: int): bool {
    if (i < 0 || shelf_list == null) return false;
    ready: bool = false;
    borrow shelf_list as list {
        if (i < list.count) ready = list.items[i].ready
    }
    ready
}

shelf_size_at(i: int): int {
    if (i < 0 || shelf_list == null) return 0;
    size: int = 0;
    borrow shelf_list as list {
        if (i < list.count) size = list.items[i].size
    }
    size
}

// When item i was last read (seconds; 0 never), and its place there.
shelf_used_at(i: int): int {
    if (i < 0 || shelf_list == null) return 0;
    used: int = 0;
    borrow shelf_list as list {
        if (i < list.count) used = list.items[i].used
    }
    used
}

shelf_place_at(i: int): int {
    if (i < 0 || shelf_list == null) return 0;
    place: int = 0;
    borrow shelf_list as list {
        if (i < list.count) place = list.items[i].place
    }
    place
}

// Item i read now, at place (a book's part, a dictionary's entry; -1 as
// it was): kept, so that it opens there again and is listed among the
// latest read. (Kept only as either changes: reading on within a minute
// writes nothing.)
shelf_note_read(i: int, place: int) {
    if (i < 0 || shelf_list == null) return;
    now: int = time(0);
    changed: bool = false;
    borrow shelf_list as list {
        if (i < list.count) {
            if (place >= 0 && list.items[i].place != place) {
                list.items[i].place = place;
                changed = true
            }
            if (now - list.items[i].used >= 60) {
                list.items[i].used = now;
                changed = true
            }
        }
    }
    if (!changed) return;
    shelf_format(0 - 1);
    shelf_keep_fbuf()
}

shelf_form_at(i: int): ShelfForm {
    if (i < 0 || shelf_list == null) return ShelfForm.Packaged;
    form: ShelfForm = ShelfForm.Packaged;
    borrow shelf_list as list {
        if (i < list.count) form = list.items[i].form
    }
    form
}

shelf_broken_at(i: int): bool {
    if (i < 0 || shelf_list == null) return false;
    broken: bool = false;
    borrow shelf_list as list {
        if (i < list.count) broken = list.items[i].broken
    }
    broken
}

shelf_report_at(i: int): BibleReport {
    if (i < 0 || shelf_list == null) return no_report;
    report: BibleReport = no_report;
    borrow shelf_list as list {
        if (i < list.count) report = list.items[i].report
    }
    report
}

// Which of its made file's names item i's has (0 no such item).
shelf_copy_at(i: int): int {
    if (i < 0 || shelf_list == null) return 0;
    copy: int = 0;
    borrow shelf_list as list {
        if (i < list.count) copy = list.items[i].copy
    }
    copy
}

// Item i's update, as it goes (Current: no such item).
shelf_update_at(i: int): ShelfUpdate {
    if (i < 0 || shelf_list == null) return ShelfUpdate.Current;
    update: ShelfUpdate = ShelfUpdate.Current;
    borrow shelf_list as list {
        if (i < list.count) update = list.items[i].update
    }
    update
}

shelf_set_update(i: int, update: ShelfUpdate) {
    if (i < 0 || shelf_list == null) return;
    borrow shelf_list as list {
        if (i < list.count) list.items[i].update = update
    }
}

// Whether item i's update is coming: its package wanted or being made.
shelf_updating_at(i: int): bool {
    match shelf_update_at(i) {
        Wanted -> true;
        Fetched -> true;
        _ -> false
    }
}

// Item i's short name, title (its description), name, onto fbuf.
fput_shelf_abbreviation(i: int) {
    if (i < 0 || shelf_list == null) return;
    borrow shelf_list as list {
        if (i < list.count) fput_str(list.items[i].abbreviation)
    }
}

fput_shelf_title(i: int) {
    if (i < 0 || shelf_list == null) return;
    borrow shelf_list as list {
        if (i < list.count) fput_str(list.items[i].title)
    }
}

// Item i's title made short for a bar (the panel's reader's), onto fbuf:
// an author's first names and initials left out, the surname kept as its
// possessive within the first three words ("C. H. Spurgeon's Treasury of
// David": Spurgeon's Treasury of David; Matthew Henry's: Henry's), and
// what follows a comma, a parenthesis or " on the " ("Henry's Concise
// Commentary on the Whole Bible": Henry's Concise Commentary). A title
// beginning "The" keeps its words. Go To's rows and a module's page show
// the whole.
fput_shelf_short_title(i: int) {
    if (i < 0 || shelf_list == null) return;
    borrow shelf_list as list {
        if (i < list.count) fput_short_title(list.items[i].title)
    }
}

fput_short_title(title: str) {
    n: int = len(title);
    from: int = 0;
    // (The first three words' possessive, unless it begins "The ".)
    if (!(n > 4 && title[0] as int == 'T' as int && title[1] as int == 'h' as int && title[2] as int == 'e' as int && title[3] as int == 32)) {
        word: int = 0;
        at: int = 0;
        found: bool = false;
        while (!found && word < 3 && at < n) {
            end: int = at;
            while (end < n && title[end] as int != 32) end = end + 1;
            possessive: bool = end - at >= 3 && (title[end - 2] as int == 39 && title[end - 1] as int == 's' as int || title[end - 2] as int == 's' as int && title[end - 1] as int == 39);
            if (possessive && end < n) {
                from = at;
                found = true
            }
            at = end + 1;
            word = word + 1
        }
    }
    to: int = n;
    k: int = from + 1;
    while (k < to) {
        if (title[k] as int == 44 || title[k] as int == 40 && title[k - 1] as int == 32 || shelf_text_at(title,
            k, " on the ")) to = k;
        k = k + 1
    }
    while (to > from && (title[to - 1] as int == 32 || title[to - 1] as int == 46)) to = to - 1;
    for x in from..to fput(title[x] as int & 255)
}

// Item i's name for the reader's bar after the chapter, where a version's
// short name goes, onto fbuf: its short title's first word (its second
// after "The"), a possessive dropped ("Spurgeon", "Henry", "Barnes"),
// shortened to 10 letters with an ellipsis.
fput_shelf_bar_name_shortened(i: int) {
    if (i < 0 || shelf_list == null) return;
    from: int = fbuf_n;
    fput_shelf_short_title(i);
    end: int = fbuf_n;
    b: int = from;
    // (Past "The ".)
    if (end - b > 4 && fbuf[b] as int == 'T' as int && fbuf[b + 1] as int == 'h' as int && fbuf[b + 2] as int == 'e' as int && fbuf[b + 3] as int == 32) b = b + 4;
    e: int = b;
    while (e < end && fbuf[e] as int != 32) e = e + 1;
    if (e - b > 2 && fbuf[e - 2] as int == 39 && fbuf[e - 1] as int == 's' as int) e = e - 2 else if (e - b > 1 && fbuf[e - 1] as int == 39) e = e - 1;
    n: int = e - b;
    shortened: bool = n > SHELF_BAR_NAME_MOST;
    if (shortened) n = SHELF_BAR_NAME_MOST - 1;
    for k in 0..n fbuf[from + k] = fbuf[b + k];
    fbuf_n = from + n;
    if (shortened) fput_str("\‚\Ä\¶")
}

SHELF_BAR_NAME_MOST: int = 10;

// Whether text holds part at byte at.
shelf_text_at(text: str, at: int, part: str): bool {
    if (at + len(part) > len(text)) return false;
    for j in 0..len(part)
        if (text[at + j] != part[j]) return false;
    true
}

// Item i's language, its name, onto fbuf.
fput_shelf_language(i: int) {
    if (i < 0 || shelf_list == null) return;
    borrow shelf_list as list {
        if (i < list.count) fput_str(language_name(list.items[i].language))
    }
}

// The item named (-1: none).
shelf_find(name: str): int {
    if (shelf_list == null) return -1;
    found: int = -1;
    borrow shelf_list as list {
        for i in 0..list.count
            if (list.items[i].name == name) found = i
    }
    found
}

// The item named by data's from to to (-1: none).
shelf_find_bytes(data: []i8, from: int, to: int): int {
    if (shelf_list == null) return -1;
    found: int = -1;
    borrow shelf_list as list {
        for i in 0..list.count {
            name: str = list.items[i].name;
            if (len(name) == to - from) {
                same: bool = true;
                for k in 0..len(name)
                    if (name[k] != data[from + k]) same = false;
                if (same) found = i
            }
        }
    }
    found
}

// Item i's name (its module's: KJV, TDavid), onto fbuf.
fput_shelf_name(i: int) {
    if (i < 0 || shelf_list == null) return;
    borrow shelf_list as list {
        if (i < list.count) fput_str(list.items[i].name)
    }
}

// The item in slot (-1: none).
shelf_find_slot(slot: int): int {
    if (shelf_list == null || slot < 0) return -1;
    found: int = -1;
    borrow shelf_list as list {
        for i in 0..list.count
            if (list.items[i].slot == slot) found = i
    }
    found
}

// The Bible whose text slot is t (-1: none).
shelf_find_text(t: int): int {
    if (t < TEXT_SHELF_FIRST) return -1;
    i: int = shelf_find_slot(t - TEXT_SHELF_FIRST);
    if (shelf_kind_at(i) == SHELF_KIND_BIBLE) i else -1
}

shelf_text_of(i: int): int {
    TEXT_SHELF_FIRST + shelf_slot_at(i)
}

// Item i's form, kept in shelf.tsv (made as part of its download: no
// longer coming).
shelf_save_form(i: int, form: ShelfForm) {
    if (shelf_list != null) {
        borrow shelf_list as list {
            if (i >= 0 && i < list.count) list.items[i].form = form
        }
    }
    shelf_format(-1);
    shelf_keep_fbuf();
    if (shelf_slot_at(i) == shelf_making_download) {
        match form {
            Packaged -> { }
            _ -> shelf_making_download = -1
        }
    }
}

shelf_set_broken(i: int, broken: bool) {
    if (i < 0 || shelf_list == null) return;
    borrow shelf_list as list {
        if (i < list.count) list.items[i].broken = broken
    }
}

shelf_set_opened(i: int, red: bool, report: BibleReport) {
    if (i < 0 || shelf_list == null) return;
    borrow shelf_list as list {
        if (i < list.count) {
            list.items[i].red = red;
            list.items[i].report = report;
            list.items[i].broken = false
        }
    }
}

// ---- shelf.tsv ----
// NAME SLOT STATE KIND SIZE VERSION LANG ADDED ABBREVIATION TITLE,
// tab-separated; STATE ready or wanted, KIND a shelf_kind_names.
shelf_load() {
    if (shelf_loaded) return;
    shelf_loaded = true;
    shelf_kjv_prepare();
    kp_set(SHELF_LIST_FILE);
    kp_read();
    shelf_list_from_fbuf();
    shelf_name_versions()
}

// The list made again of fbuf's lines (shelf.tsv's), each item's own state
// kept from the list before (by slot), in place of it.
shelf_list_from_fbuf() {
    next: owned *ShelfList = own {
        shelf_list_made()
    };
    if (shelf_list != null) {
        borrow shelf_list as old {
            borrow next as fresh {
                for i in 0..fresh.count {
                    for k in 0..old.count {
                        if (old.items[k].slot == fresh.items[i].slot) {
                            fresh.items[i].broken = old.items[k].broken;
                            fresh.items[i].update = old.items[k].update;
                            // (A Bible opened this time, not made: what it said.)
                            if (old.items[k].report.verses >= 0) {
                                fresh.items[i].red = old.items[k].red;
                                fresh.items[i].report = old.items[k].report
                            }
                        }
                    }
                }
            }
        }
    }
    drop shelf_list;
    shelf_list = move next
}

shelf_list_made(): *ShelfList@new {
    lines: int = 0;
    for i in 0..fbuf_n
        if (fbuf[i] as int == 10) lines = lines + 1;
    items: []ShelfItem = new ShelfItem[lines](ShelfItem {
        name: "",
        slot: 0,
        kind: ModuleKind.Other,
        ready: false,
        size: 0,
        version: "",
        language: "",
        abbreviation: "",
        title: "",
        added: 0,
        form: ShelfForm.Packaged,
        broken: false,
        red: false,
        report: no_report,
        used: 0,
        place: 0,
        copy: 0,
        update: ShelfUpdate.Current
    });
    count: int = 0;
    fields: []int = new int[SHELF_FIELDS](0);
    ends: []int = new int[SHELF_FIELDS](0);
    begin_lines();
    while (next_line()) {
        at: int = fpos;
        for f in 0..SHELF_FIELDS {
            fields[f] = at;
            end: int = at;
            while (end < line_e && fbuf[end] as int != 9) end = end + 1;
            ends[f] = end;
            at = (if (end < line_e) end + 1 else line_e)
        }
        if (ends[9] > fields[9] && ends[0] > fields[0] && count < lines) {
            kind: int = 7;
            for k in 0..len(shelf_kind_names)
                if (sk_word_is(fbuf, fields[3], ends[3], shelf_kind_names[k])) kind = k;
            wanted: bool = sk_word_is(fbuf, fields[2], ends[2], "wanted");
            // (A Bible made a version: what it said, kept after its title.)
            made: bool = sk_word_is(fbuf, fields[2], ends[2], "made") && ends[14] > fields[14];
            items[count] = ShelfItem {
                name: shelf_bytes_text(fbuf, fields[0], ends[0]),
                slot: sk_num(fbuf, fields[1], ends[1]),
                kind: shelf_kind_of(kind),
                ready: !wanted,
                size: sk_num(fbuf, fields[4], ends[4]),
                version: shelf_bytes_text(fbuf, fields[5], ends[5]),
                language: shelf_bytes_text(fbuf, fields[6], ends[6]),
                added: sk_num(fbuf, fields[7], ends[7]),
                abbreviation: shelf_bytes_text(fbuf, fields[8], ends[8]),
                title: shelf_label_text(fbuf, fields[9], ends[9]),
                form: if (made) ShelfForm.Made else if (sk_word_is(fbuf, fields[2],
                    ends[2], "unpacked")) ShelfForm.Unpacked else if (sk_word_is(fbuf,
                    fields[2], ends[2], "folio")) ShelfForm.Folio else ShelfForm.Packaged,
                broken: false,
                red: made && sk_num(fbuf, fields[10], ends[10]) == 1,
                report: if (made) BibleReport {
                    missing_books: sk_num(fbuf, fields[11], ends[11]),
                    outside_chapters: sk_num(fbuf, fields[12], ends[12]),
                    extra_books: sk_num(fbuf, fields[13], ends[13]),
                    verses: sk_num(fbuf, fields[14], ends[14])
                } else no_report,
                used: sk_num(fbuf, fields[15], ends[15]),
                place: sk_num(fbuf, fields[16], ends[16]),
                copy: if (sk_num(fbuf, fields[17], ends[17]) == 1) 1 else 0,
                update: ShelfUpdate.Current
            };
            count = count + 1
        }
    }
    new ShelfList { items: items, count: count }
}

// The list as shelf.tsv's lines, into fbuf (all but item skip: -1 none).
shelf_format(skip: int) {
    fbuf_n = 0;
    if (shelf_list == null) return;
    borrow shelf_list as list {
        for i in 0..list.count {
            if (i != skip) shelf_format_item(&list.items[i])
        }
    }
}

shelf_format_item(item: *ShelfItem) {
    shelf_format_line(item, item.size, item.version, item.language, item.abbreviation,
        item.title)
}

// Item's line, with these words for its version (its size, version,
// language, short name and title).
shelf_format_line(
    item: *ShelfItem,
    size: int,
    version: str,
    language: str,
    abbreviation: str,
    title: str
) {
    fput_tsv(item.name);
    fput(9);
    fput_int(item.slot);
    fput(9);
    fput_str(if (!item.ready) "wanted" else match item.form {
        Packaged -> "ready";
        Unpacked -> "unpacked";
        Made -> "made";
        Folio -> "folio"
    });
    fput(9);
    fput_str(shelf_kind_names[shelf_kind_code(item.kind)]);
    fput(9);
    fput_int(size);
    fput(9);
    fput_tsv(version);
    fput(9);
    fput_tsv(language);
    fput(9);
    fput_int(item.added);
    fput(9);
    fput_tsv(abbreviation);
    fput(9);
    fput_tsv(title);
    // (A Bible made a version: what it said; another module's, zeros.)
    made: bool = match item.form {
        Made -> true;
        _ -> false
    };
    report: BibleReport = item.report;
    for value in [if (item.red) 1 else 0, report.missing_books, report.outside_chapters,
        report.extra_books, report.verses] {
        fput(9);
        fput_int(if (made) value else 0)
    }
    fput(9);
    fput_int(item.used);
    fput(9);
    fput_int(item.place);
    fput(9);
    fput_int(item.copy);
    fput(10)
}

// Words for a field of shelf.tsv: its tabs and line breaks as spaces.
fput_tsv(text: str) {
    for c in text {
        k: int = c as int;
        fput(if (k == 9 || k == 10 || k == 13) 32 else k)
    }
}

// fbuf's lines kept as shelf.tsv, and the list made of them again.
shelf_keep_fbuf() {
    kp_set(SHELF_LIST_FILE);
    kp_write();
    shelf_list_from_fbuf();
    shelf_name_versions()
}

// The list kept as it is, item i made ready or wanted (and its size).
shelf_save_with(i: int, ready: bool, size: int) {
    if (shelf_list != null) {
        borrow shelf_list as list {
            if (i >= 0 && i < list.count) {
                list.items[i].ready = ready;
                list.items[i].size = size;
                list.items[i].form = ShelfForm.Packaged
            }
        }
    }
    shelf_format(-1);
    shelf_keep_fbuf()
}

// ---- the bookshelf's Bibles, as versions ----
// Every installed Bible named for core/text.l8 (in its pool), the others'
// slots let go: whenever the list changes or a Bible is opened (whether it
// marks the words of Jesus is known then).
shelf_name_versions() {
    for k in 0..TEXT_SHELF_MOST text_unname_version(TEXT_SHELF_FIRST + k);
    if (shelf_list == null) return;
    borrow shelf_list as list {
        for i in 0..list.count {
            item: *ShelfItem = &list.items[i];
            if (item.ready && shelf_kind_code(item.kind) == SHELF_KIND_BIBLE && item.slot < TEXT_SHELF_MOST) {
                region {
                    line: *ByteBuilder = builder_new(64);
                    builder_str(line, language_name(item.language));
                    builder_str(line, " \¬\∑ From ");
                    builder_str(line, SHELF_SOURCE_SHORT_NAME);
                    _named: bool = text_name_version(TEXT_SHELF_FIRST + item.slot,
                        item.abbreviation, shelf_short_title(item.title), builder_text(line,
                        0, line.size), item.red)
                }
            }
        }
    }
}

// A title at most 400 bytes (cut at a space, with an ellipsis): text.l8's
// pool holds a version's names in 768 bytes.
shelf_short_title(title: str): str@new {
    cut: int = len(title);
    if (cut > 400) {
        cut = 397;
        while (cut > 0 && title[cut] as int != 32) cut = cut - 1;
        if (cut == 0) cut = 397
    }
    ellipsis: str = "\‚\Ä\¶";
    extra: int = if (cut < len(title)) len(ellipsis) else 0;
    raw: []i8 = new i8[cut + extra](0i8);
    for i in 0..cut raw[i] = title[i];
    for i in 0..extra raw[cut + i] = ellipsis[i];
    cstr(raw)
}

// ---- the catalog ----
type CatalogEntry = {
    info: ModuleInfo;
    support: ModuleSupport
}

type ShelfCatalog = {
    entries: []CatalogEntry;
    count: int
}

shelf_catalog: ?owned *ShelfCatalog = null;

// Its state: none read yet, being fetched or read, here, or it could not
// come (why, for the screens).
type CatalogState =
    | Unread
    | Coming
    | Here
    | Failed { offline: bool }

shelf_catalog_state: CatalogState = CatalogState.Unread;

// The catalog's day (days since 1970, as the settings keep it:
// shelfCatalogDay), 0 never fetched.
shelf_catalog_day(): int {
    pref_get("shelfCatalogDay")
}

// The catalog wanted (Go To opened, a screen that lists it open): read
// from where it is kept, or fetched if it is not, or, online, if it wasn't
// fetched today: checked quietly at most once a day.
shelf_want_catalog() {
    match shelf_catalog_state {
        Coming -> return;
        _ -> { }
    }
    day: int = sk_local_day(time(0));
    old: bool = shelf_catalog_day() <= 0 || day != shelf_catalog_day();
    if (shelf_catalog != null && !(old && hd_network != NET_NONE && shelf_fetch_id < 0)) return;
    if (shelf_catalog == null && shelf_catalog_day() > 0 && !old) {
        shelf_read_catalog();
        return
    }
    if (old && hd_network != NET_NONE) {
        shelf_fetch_catalog();
        return
    }
    if (shelf_catalog_day() > 0) shelf_read_catalog() else shelf_catalog_state = CatalogState.Failed { offline: true }
}

// Whether the first catalog is on its way (being fetched or read, or
// waiting to be fetched), none here yet.
shelf_catalog_awaited(): bool {
    if (shelf_catalog != null) return false;
    match shelf_catalog_state {
        Coming -> true;
        _ -> shelf_catalog_wanted
    }
}

shelf_read_catalog() {
    shelf_catalog_state = CatalogState.Coming;
    shelf_read_kept(SHELF_READ_CATALOG_ID, SHELF_CATALOG_FILE)
}

// The catalog's bytes (a tar.gz of confs) made into a catalog of its own:
// its modules sorted by kind, then language (English first), then name.
// Whether it could be read.
shelf_catalog_came(data: []i8, size: int): bool {
    try {
        next: owned *ShelfCatalog = own {
            catalog_made(data, size)
        };
        borrow next as fresh {
            shelf_catalog_renumber(fresh)
        }
        drop shelf_catalog;
        shelf_catalog = move next;
        shelf_catalog_state = CatalogState.Here;
        true
    } with archive::ArchiveError _error -> {
        false
    } with deflate::DeflateError _error -> {
        false
    }
}

// A Details screen's argument for a module neither listed nor installed:
// past any catalog's entries, so it shows that it is gone.
SHELF_ITEM_GONE: int = 1000000000;

// The Details screens open, named by their place in the catalog before,
// renamed by their place in the one that follows it (or by their slot if
// it no longer lists them; a screen of a module neither lists nor has
// installed shows that it is gone).
shelf_catalog_renumber(fresh: *ShelfCatalog) {
    if (shelf_catalog == null) return;
    for k in 0..sk_n {
        if (sk_kinds[k] == SCR_SHELF_ITEM && sk_args[k] >= 0) {
            at: int = -1;
            slot: int = -1;
            borrow shelf_catalog as old {
                if (sk_args[k] < old.count) {
                    name: str = old.entries[sk_args[k]].info.name;
                    slot = shelf_slot_at(shelf_find(name));
                    for j in 0..fresh.count
                        if (fresh.entries[j].info.name == name) at = j
                }
            }
            sk_args[k] = (if (at >= 0) at else if (slot >= 0) -1 - slot else SHELF_ITEM_GONE)
        }
    }
}

catalog_made(data: []i8, size: int) raises archive::ArchiveError, deflate::DeflateError: *ShelfCatalog@new {
    tar: []i8 = deflate::gzip_decompress(data, 0, size);
    members: []archive::TarEntry = archive::tar_entries(tar, len(tar));
    entries: []CatalogEntry = new CatalogEntry[len(members)](CatalogEntry { info: catalog_empty_info(), support: ModuleSupport.Readable });
    count: int = 0;
    for m in 0..len(members) {
        member: archive::TarEntry = members[m];
        if (shelf_ends_with(member.name, ".conf")) {
            // (A conf that cannot be read is left out, not the catalog.)
            try {
                conf_bytes: []i8 = new i8[member.size](0i8);
                memcpy(conf_bytes, 0, tar, member.offset, member.size);
                conf: *ModuleConf = conf_parse(conf_bytes, member.size);
                info: ModuleInfo = module_info(conf);
                // (A module listed once, by its name, as SWORD's installers
                // key them: where two confs name one module (CrossWire's
                // lists BulCarigradNT twice), the one whose file is named
                // for it, else the first.)
                same: int = -1;
                for j in 0..count
                    if (entries[j].info.name == info.name) same = j;
                at: int = if (same < 0) count else if (conf_named_for(member.name,
                    info.name)) same else -1;
                if (at >= 0) {
                    entries[at].info = info;
                    entries[at].support = module_support(&entries[at].info);
                    if (at == count) count = count + 1
                }
            } with SwordError _error -> { }
        }
    }
    // (In order: insertion, as the catalog is a few hundred.)
    for i in 1..count {
        j: int = i;
        while (j > 0 && catalog_before(&entries[j], &entries[j - 1])) {
            swapped: CatalogEntry = entries[j];
            entries[j] = entries[j - 1];
            entries[j - 1] = swapped;
            j = j - 1
        }
    }
    new ShelfCatalog { entries: entries, count: count }
}

// Whether a catalog's member at path is module name's own conf:
// mods.d/NAME.conf, its name in lower case as the catalog writes it.
conf_named_for(path: str, name: str): bool {
    folder: str = "mods.d/";
    end: str = ".conf";
    if (len(path) != len(folder) + len(name) + len(end) || !shelf_ends_with(path,
        end)) return false;
    for i in 0..len(folder)
        if (path[i] != folder[i]) return false;
    for i in 0..len(name) {
        x: int = path[len(folder) + i] as int & 255;
        y: int = name[i] as int & 255;
        if (y >= 'A' as int && y <= 'Z' as int) y = y + 32;
        if (x != y) return false
    }
    true
}

catalog_empty_info(): ModuleInfo {
    ModuleInfo {
        name: "",
        description: "",
        abbreviation: "",
        kind: ModuleKind.Other,
        storage: ModuleStorage.ByTree,
        blocks: BlockSize.ChapterBlocks,
        compression: Compression.Uncompressed,
        markup: Markup.Plain,
        utf8: true,
        versification: "",
        language: "",
        right_to_left: false,
        data_path: "",
        install_size: 0,
        version: "",
        date: "",
        about: "",
        license: "",
        copyright: "",
        locked: false,
        words_of_christ: false,
        strongs: false,
        footnotes: false,
        greek_definitions: false,
        hebrew_definitions: false,
        questionable: false
    }
}

catalog_group(kind: ModuleKind): int {
    group: int = doc_group_of(kind);
    if (group >= 0) group else DOC_GROUPS + shelf_kind_code(kind)
}

// Whether a comes before b: by the group its kind is listed in (the kinds
// not listed after, by kind), then English before other languages, then
// language name, then description (its title, as titles sort:
// title_compare).
catalog_before(a: *CatalogEntry, b: *CatalogEntry): bool {
    ka: int = catalog_group(a.info.kind);
    kb: int = catalog_group(b.info.kind);
    if (ka != kb) return ka < kb;
    ea: bool = language_is_english(a.info.language);
    eb: bool = language_is_english(b.info.language);
    if (ea != eb) return ea;
    c: int = text_compare_folded(language_name(a.info.language), language_name(b.info.language));
    if (c != 0) return c < 0;
    title_compare(a.info.description, b.info.description) < 0
}

// Two texts compared as a reader would sort them: letters without regard
// to case (bytes past ASCII as they are).
text_compare_folded(a: str, b: str): int {
    text_compare_folded_from(a, 0, b, 0)
}

// a from a_from and b from b_from compared as text_compare_folded does.
text_compare_folded_from(
    a: str,
    a_from: int,
    b: str,
    b_from: int
): int {
    na: int = len(a) - a_from;
    nb: int = len(b) - b_from;
    n: int = if (na < nb) na else nb;
    for i in 0..n {
        x: int = a[a_from + i] as int & 255;
        y: int = b[b_from + i] as int & 255;
        if (x >= 65 && x <= 90) x = x + 32;
        if (y >= 65 && y <= 90) y = y + 32;
        if (x != y) return x - y
    }
    na - nb
}

// Two titles compared as a list of titles sorts them: from the words
// that name each (title_sort_start), then whole, so that "1949/1964 Bible
// in Basic English" sorts as "Bible in Basic English" and "A Faithful
// Version" as "Faithful Version". The titles are shown as they are.
title_compare(a: str, b: str): int {
    c: int = text_compare_folded_from(a, title_sort_start(a), b, title_sort_start(b));
    if (c != 0) c else text_compare_folded(a, b)
}

// Where a title's sorting words begin: past a leading number or year (a
// run of digits not followed by a letter: "1770", "1949/1964", but not
// "1st"), any punctuation and spaces after it, and a leading article (A,
// An, The); its start if that would leave nothing.
title_sort_start(title: str): int {
    n: int = len(title);
    at: int = 0;
    digits: int = 0;
    while (digits < n && title_digit(title[digits] as int)) digits = digits + 1;
    if (digits > 0 && !(digits < n && title_letter(title[digits] as int))) {
        at = digits;
        // (Its punctuation and spaces, and the years that run on: "/1964".)
        while (at < n && !title_letter(title[at] as int) && (title[at] as int & 255) < 128) at = at + 1
    }
    skipped: bool = false;
    for article in ["A ", "An ", "The "] {
        k: int = len(article);
        if (!skipped && at + k < n) {
            same: bool = true;
            for j in 0..k {
                x: int = title[at + j] as int;
                if (x >= 65 && x <= 90) x = x + 32;
                y: int = article[j] as int;
                if (y >= 65 && y <= 90) y = y + 32;
                if (x != y) same = false
            }
            if (same) {
                at = at + k;
                skipped = true
            }
        }
    }
    if (at >= n) 0 else at
}

title_digit(x: int): bool {
    x >= 48 && x <= 57
}

title_letter(x: int): bool {
    x >= 65 && x <= 90 || x >= 97 && x <= 122 || (x & 255) >= 128
}

// The catalog's entry named (-1: none; no catalog).
shelf_catalog_find(name: str): int {
    if (shelf_catalog == null) return -1;
    found: int = -1;
    borrow shelf_catalog as catalog {
        for i in 0..catalog.count
            if (catalog.entries[i].info.name == name) found = i
    }
    found
}

// Item i's catalog entry (-1: none).
shelf_catalog_find_item(i: int): int {
    if (i < 0 || shelf_list == null) return -1;
    found: int = -1;
    borrow shelf_list as list {
        if (i < list.count) found = shelf_catalog_find(list.items[i].name)
    }
    found
}

// ---- fetching: the catalog and packages, one at a time ----
type ShelfFetch =
    | Idle
    | FetchingCatalog { id: int }
    | FetchingPackage { id: int, slot: int }
    // An update's package (SHELF_UPDATE_PACKAGE), its module read meanwhile.
    | FetchingUpdate { id: int, slot: int }

shelf_fetch: ShelfFetch = ShelfFetch.Idle;

shelf_fetch_id: int = -1;

shelf_fetch_next_id: int = SHELF_FETCH_ID_FIRST;

// How much of the package fetching has come, and its whole (bytes).
shelf_fetch_got: int = 0;

shelf_fetch_total: int = 0;

// The share last shown (hundredths), so the screens follow it a twentieth
// at a time.
shelf_fetch_shown: int = 0;

// The last fetch that failed (its slot, -1 none), so it is not tried
// again until asked (opened again, or the connection back).
shelf_failed_slot: int = -1;

shelf_catalog_wanted: bool = false;

// A fetch's address: the repository's, a path and a module's name (a kept
// file's name holds at most 64 bytes, so a module's name does too).
shelf_url: []i8 = new i8[512](0i8);

shelf_url_n: int = 0;

// Text added to the address; whether it fit.
shelf_url_add(text: str): bool {
    if (shelf_url_n + len(text) > len(shelf_url)) return false;
    for c in text {
        shelf_url[shelf_url_n] = c;
        shelf_url_n = shelf_url_n + 1
    }
    true
}

shelf_can_fetch(): bool {
    sk_has_shelf
}

// A fetch begun (its id shelf_fetch_id) of the repository's path then
// name (and .zip), into the kept file kp_name names; whether it could be
// (its address fit).
shelf_fetch_start(path: str, name: str, zip: bool): bool {
    shelf_url_n = 0;
    if (!shelf_url_add(SHELF_SOURCE) || !shelf_url_add(path) || !shelf_url_add(name) || zip && !shelf_url_add(".zip")) return false;
    shelf_fetch_id = shelf_fetch_next_id;
    shelf_fetch_next_id = shelf_fetch_next_id + 1;
    shelf_fetch_got = 0;
    shelf_fetch_shown = 0;
    f: ?fn(id: int, url: []i8, url_n: int, name: []i8, name_n: int) = host_io.fetch;
    if (f != null) f(shelf_fetch_id, shelf_url, shelf_url_n, kp_name, kp_name_n);
    true
}

shelf_fetch_catalog() {
    if (!shelf_can_fetch()) {
        shelf_catalog_state = CatalogState.Failed { offline: false };
        return
    }
    match shelf_fetch {
        Idle -> { }
        _ -> {
            // (After the package coming: shelf_pump fetches it next.)
            shelf_catalog_wanted = true;
            return
        }
    }
    shelf_catalog_wanted = false;
    shelf_catalog_state = CatalogState.Coming;
    kp_set(SHELF_CATALOG_FILE);
    _started: bool = shelf_fetch_start(SHELF_CATALOG_PATH, "", false);
    shelf_fetch = ShelfFetch.FetchingCatalog { id: shelf_fetch_id };
    shelf_fetch_total = 0
}

// The next wanted package fetched, if nothing is coming.
shelf_pump() {
    match shelf_fetch {
        Idle -> { }
        _ -> return
    }
    if (!shelf_can_fetch() || hd_network == NET_NONE) return;
    if (shelf_catalog_wanted) {
        shelf_fetch_catalog();
        return
    }
    // (What is on its way to a pane first: core/documents.l8's arrivals.)
    for pass in 0..2 {
        for i in 0..shelf_count() {
            slot: int = shelf_slot_at(i);
            update_wanted: bool = match shelf_update_at(i) {
                Wanted -> true;
                _ -> false
            };
            if (pass == 0 && !doc_arriving_any(slot))
                continue;
            if (!shelf_ready_at(i) && slot != shelf_failed_slot || update_wanted) {
                source: MakingSource = if (update_wanted) MakingSource.Update else MakingSource.Download;
                started: bool = false;
                if (shelf_kept_package_at(i, source) && shelf_list != null) {
                    borrow shelf_list as list {
                        started = shelf_fetch_start(SHELF_PACKAGES_PATH, list.items[i].name,
                            true)
                    }
                }
                if (!started) {
                    // (A name too long to keep: it can't be downloaded.)
                    if (update_wanted) shelf_update_failed(i, false) else shelf_failed_slot = slot;
                    shelf_screens_changed();
                    return
                }
                if (update_wanted) {
                    shelf_fetch = ShelfFetch.FetchingUpdate { id: shelf_fetch_id, slot: slot };
                    at: int = shelf_catalog_find_item(i);
                    shelf_fetch_total = shelf_size_at(i);
                    if (at >= 0) {
                        borrow shelf_catalog as catalog {
                            shelf_fetch_total = catalog.entries[at].info.install_size
                        }
                    }
                } else {
                    shelf_fetch = ShelfFetch.FetchingPackage { id: shelf_fetch_id, slot: slot };
                    shelf_fetch_total = shelf_size_at(i)
                }
                shelf_screens_changed();
                return
            }
        }
    }
}

// The platform's lines about a fetch (core/held.l8's, for ids of ours):
// what is on its way to a pane told how far it has come (no screen shows
// a fetch's progress).
shelf_fetching(id: int, got: int, total: int) {
    if (id != shelf_fetch_id) return;
    shelf_fetch_got = got;
    if (total > 0) shelf_fetch_total = total;
    if (shelf_fetch_total <= 0) return;
    shown: int = got * 100 / shelf_fetch_total;
    if (shown < shelf_fetch_shown + 2) return;
    shelf_fetch_shown = shown;
    doc_arrivals_check()
}

shelf_fetched(id: int, status: int, bytes: int) {
    if (id != shelf_fetch_id) return;
    shelf_fetch_id = -1;
    fetch: ShelfFetch = shelf_fetch;
    shelf_fetch = ShelfFetch.Idle;
    ok: bool = status == 200 && bytes > 0;
    match fetch {
        FetchingCatalog _f -> {
            if (ok) {
                set_pref("shelfCatalogDay", sk_local_day(time(0)));
                sk_save();
                shelf_read_catalog()
            } else {
                // (The one kept, if there is one, still serves.)
                if (shelf_catalog == null && shelf_catalog_day() > 0) shelf_read_catalog() else if (shelf_catalog == null) shelf_catalog_state = CatalogState.Failed { offline: status == 0 } else shelf_catalog_state = CatalogState.Here
            }
        }
        FetchingPackage p -> {
            i: int = shelf_find_slot(p.slot);
            if (i >= 0) {
                if (ok) {
                    shelf_save_with(i, true, bytes);
                    shelf_to_make_add(p.slot);
                    shelf_prepare_next()
                } else shelf_failed_slot = p.slot
            }
        }
        FetchingUpdate p -> {
            i: int = shelf_find_slot(p.slot);
            if (i >= 0) {
                if (ok) {
                    shelf_set_update(i, ShelfUpdate.Fetched);
                    shelf_to_make_add(p.slot);
                    shelf_prepare_next()
                } else shelf_update_failed(i, status == 0)
            }
        }
        Idle -> { }
    }
    shelf_screens_changed();
    shelf_pump()
}

// A Bible that couldn't be made a version: marked broken (until it is
// fetched again, or the app opens again), the version asked for no longer
// waited for, and the reader told (by core/documents.l8's arrival, if it
// was on its way to a pane).
shelf_bible_failed(i: int, t: int) {
    shelf_set_broken(i, true);
    hs_missing(t);
    if (doc_arriving_any(shelf_slot_at(i))) return;
    fbuf_n = 0;
    fput_str("Couldn\‚\Ä\ôt open ");
    fput_shelf_short_title(i);
    fput(46);
    ui_toast(TOAST_WARNING)
}

// The network came back (or changed): a failed fetch tried again, and an
// update that failed for want of a connection. Lost: what is on its way to
// a pane and not here failed (doc_arrivals_offline).
shelf_network_changed() {
    if (hd_network != NET_NONE) {
        shelf_failed_slot = -1;
        for i in 0..shelf_count() {
            match shelf_update_at(i) {
                Failed f -> if (f.offline) shelf_set_update(i, ShelfUpdate.Wanted);
                _ -> { }
            }
        }
    } else doc_arrivals_offline();
    shelf_pump()
}

// The modules here whose catalog entry is newer begun updating, quietly,
// while the connection isn't metered (the catalog read again, at most once
// a day): one that failed this session isn't tried again until the app
// opens again.
shelf_updates_begin() {
    if (hd_network != NET_FREE) return;
    for i in 0..shelf_count() {
        current: bool = match shelf_update_at(i) {
            Current -> true;
            _ -> false
        };
        if (current && shelf_update_entry(i) >= 0) shelf_set_update(i, ShelfUpdate.Wanted)
    }
    shelf_pump()
}

// ---- asking and removing ----
// The lowest slot number free (for a Bible: below TEXT_SHELF_MOST; -1 if
// none is).
shelf_free_slot(bible: bool): int {
    if (bible) {
        for s in 0..TEXT_SHELF_MOST
            if (shelf_find_slot(s) < 0) return s;
        return -1
    }
    slot: int = 0;
    while (shelf_find_slot(slot) >= 0) slot = slot + 1;
    slot
}

// Whether an entry of kind can't be added now: a Bible when every
// Bible's slot is taken.
shelf_full_for(kind: ModuleKind): bool {
    shelf_kind_code(kind) == SHELF_KIND_BIBLE && shelf_free_slot(true) < 0
}

// A Bible's slot made free, every one being taken: the Bible here read
// longest ago that no pane shows nor waits for let go (it is a copy of
// what is online, fetched again when it is next opened). Whether one is
// free now.
shelf_free_bible_slot(): bool {
    if (shelf_free_slot(true) >= 0) return true;
    oldest: int = -1;
    for i in 0..shelf_count() {
        if (shelf_kind_at(i) == SHELF_KIND_BIBLE && shelf_here_at(i) && !shelf_doc_shown(i) && (oldest < 0 || shelf_used_at(i) < shelf_used_at(oldest))) oldest = i
    }
    if (oldest < 0) return false;
    shelf_remove(oldest);
    shelf_free_slot(true) >= 0
}

// Item i, which couldn't be opened, fetched anew: let go and asked for
// again from the catalog (its new item; i itself where the catalog read
// doesn't have it, which then says it couldn't be opened).
shelf_fetch_again(i: int): int {
    at: int = shelf_catalog_find_item(i);
    if (at < 0 || shelf_doc_shown(i)) return i;
    shelf_remove(i);
    again: int = -1;
    borrow shelf_catalog as catalog {
        shelf_add(&catalog.entries[at]);
        again = shelf_find(catalog.entries[at].info.name)
    }
    again
}

// The catalog's entry asked for (not if the shelf has no room for it:
// shelf_full_for, which Details shows): on the shelf, wanted, its download begun
// (or waiting its turn).
shelf_add(entry: *CatalogEntry) {
    info: *ModuleInfo = &entry.info;
    if (shelf_find(info.name) >= 0) return;
    slot: int = shelf_free_slot(shelf_kind_code(info.kind) == SHELF_KIND_BIBLE);
    if (slot < 0) return;
    shelf_format(-1);
    fput_tsv(info.name);
    fput(9);
    fput_int(slot);
    fput(9);
    fput_str("wanted");
    fput(9);
    fput_str(shelf_kind_names[shelf_kind_code(info.kind)]);
    fput(9);
    fput_int(info.install_size);
    fput(9);
    fput_tsv(info.version);
    fput(9);
    fput_tsv(info.language);
    fput(9);
    fput_int(time(0));
    fput(9);
    fput_tsv(shelf_short_name(info));
    fput(9);
    fput_tsv(info.description);
    fput(10);
    shelf_keep_fbuf();
    shelf_failed_slot = -1;
    shelf_pump();
    shelf_screens_changed()
}

// A module's short name: its Abbreviation, else its name.
shelf_short_name(info: *ModuleInfo): str@info {
    if (len(info.abbreviation) > 0) info.abbreviation else info.name
}

// Item i removed: its download stopped, its package deleted, and anything
// open of it let go (the reader leaves a Bible removed for the BSB).
// Every file kept of item i: its package, its unpacked files and their
// list, its conf, a Bible's records.
shelf_remove_kept(i: int) {
    f: fn() = kept_store.remove;
    if (shelf_kept_at(i, ".files")) {
        kp_read();
        region {
            list: []i8 = new i8[fbuf_n](0i8);
            memcpy(list, 0, fbuf, 0, fbuf_n);
            at: int = 0;
            while (at < len(list)) {
                end: int = at;
                while (end < len(list) && list[end] as int != 10) end = end + 1;
                // (A line: its kind, its ending, its size.)
                from: int = at;
                while (from < end && list[from] as int != 9) from = from + 1;
                to: int = from + 1;
                while (to < end && list[to] as int != 9) to = to + 1;
                if (to < end && shelf_kept_file_at(i, list, from + 1, to)) f();
                at = end + 1
            }
        }
    }
    for suffix in [".files", ".conf", ".zip", SHELF_UPDATE_PACKAGE, ".txt"]
        if (shelf_kept_at(i, suffix)) f();
    for copy in 0..SHELF_COPIES
        if (shelf_kept_copy_at(i, copy)) f()
}

shelf_remove(i: int) {
    if (i < 0 || i >= shelf_count()) return;
    slot: int = shelf_slot_at(i);
    kind: int = shelf_kind_at(i);
    match shelf_fetch {
        FetchingPackage p -> {
            if (p.slot == slot) {
                // (Its fetch's end is ignored; the file the platform may
                // keep of it is deleted below.)
                shelf_fetch = ShelfFetch.Idle;
                shelf_fetch_id = -1
            }
        }
        FetchingUpdate p -> {
            if (p.slot == slot) {
                shelf_fetch = ShelfFetch.Idle;
                shelf_fetch_id = -1
            }
        }
        _ -> { }
    }
    if (shelf_rereading == slot) shelf_rereading = -1;
    // (What is kept of it deleted first: its files are named after it.)
    shelf_remove_kept(i);
    shelf_format(i);
    shelf_keep_fbuf();
    shelf_close_slot(slot);
    if (kind == SHELF_KIND_BIBLE) shelf_text_let_go(slot);
    if (pref_get("studyCommentary") == slot + 1) set_pref("studyCommentary", 0);
    sk_save();
    shelf_pump();
    shelf_prepare_next();
    shelf_screens_changed();
    sk_update_all()
}

// The version a Bible in slot was made, let go (removed, or downloaded
// again): the reader in the BSB if it read it.
shelf_text_let_go(slot: int) {
    t: int = TEXT_SHELF_FIRST + slot;
    if (text_cur == t) sk_use_version(TEXT_BSB);
    if (t < len(texts)) {
        drop texts[t];
        texts[t] = text_empty(t)
    }
    if (pref_get("version") == t) set_pref("version", TEXT_BSB)
}

// Item i's update failed (offline: for want of a connection): what came
// of it deleted, the copy read kept; tried again when the app next opens
// (or, for want of a connection, once it is back).
shelf_update_failed(i: int, offline: bool) {
    shelf_set_update(i, ShelfUpdate.Failed { offline: offline });
    f: fn() = kept_store.remove;
    if (shelf_kept_at(i, SHELF_UPDATE_PACKAGE)) f();
    if (shelf_kept_copy_at(i, shelf_other_copy(shelf_copy_at(i)))) f()
}

// Item i's update kept as its other copy, made as form (a Bible's what
// it said as it was made): its line switched to that copy, with the
// catalog's words for it now (its version, size, title), kept first; then
// the copy before and the update's package deleted (so that, stopped
// between, the line names a copy that is there); up to date. The caller
// lets go of what read the copy before and sends what reads the module to
// the same place in the new one.
shelf_update_swap(i: int, form: ShelfForm, opened: BibleOpened) {
    slot: int = shelf_slot_at(i);
    old_copy: int = shelf_copy_at(i);
    made: bool = match form {
        Made -> true;
        _ -> false
    };
    if (shelf_list != null) {
        borrow shelf_list as list {
            if (i < list.count) {
                item: *ShelfItem = &list.items[i];
                item.copy = shelf_other_copy(old_copy);
                item.form = form;
                item.ready = true;
                item.broken = false;
                item.red = made && opened.red;
                item.report = (if (made) opened.report else no_report)
            }
        }
    }
    shelf_format_updated(i, shelf_catalog_find_item(i));
    shelf_keep_fbuf();
    j: int = shelf_find_slot(slot);
    f: fn() = kept_store.remove;
    // (The copy before: its made file, a package not yet made, or records
    // kept before folios.)
    if (shelf_kept_copy_at(j, old_copy)) f();
    for suffix in [".zip", SHELF_UPDATE_PACKAGE, ".txt"]
        if (shelf_kept_at(j, suffix)) f();
    shelf_set_update(j, ShelfUpdate.Done)
}

// The list as shelf.tsv's lines, into fbuf, item i's with the catalog's
// entry at's words (its version, size, title; -1: its own kept).
shelf_format_updated(i: int, at: int) {
    fbuf_n = 0;
    if (shelf_list == null) return;
    borrow shelf_list as list {
        for k in 0..list.count {
            item: *ShelfItem = &list.items[k];
            if (k == i && at >= 0) {
                borrow shelf_catalog as catalog {
                    info: *ModuleInfo = &catalog.entries[at].info;
                    shelf_format_line(item, info.install_size, info.version, info.language,
                        shelf_short_name(info), info.description)
                }
            } else shelf_format_item(item)
        }
    }
}

// The module (its slot) whose new copy what reads it is to be sent to,
// once the copy is open and the parts at their places are here (-1:
// none): until then it shows the copy before, so no pane is ever empty.
shelf_rereading: int = -1;

// What reads the module shelf_rereading names sent to its new copy, at
// the same places (pane_reread), once every pane reading it can be shown
// there at once: the copy opened, then the parts at each pane's place,
// and those beside them, read (each asked for in turn, as the bookshelf
// rests).
shelf_reread_when_ready() {
    slot: int = shelf_rereading;
    if (slot < 0 || shelf_busy()) return;
    // (A new copy that can't be opened: shown now, saying so, not waited
    // for.)
    i: int = shelf_find_slot(slot);
    if (i >= 0 && !shelf_broken_at(i)) {
        for p in 0..PANES {
            if (pane_reads_commentary(p, slot) && pane_places[p].c >= 0 && !shelf_comment_place_ready(slot,
                pane_places[p].c, pane_places[p].i)) return
        }
    }
    shelf_rereading = -1;
    for p in 0..PANES
        if (pane_reads_commentary(p, slot)) pane_reread(p)
}

// ---- reading what is kept ----
// (Without read_kept the bookshelf is not offered: nothing is read.)
shelf_read_kept(id: int, kept: str) {
    f: ?fn(id: int, name: []i8, name_n: int) = host_io.read_kept;
    kp_set(kept);
    if (f != null) f(id, kp_name, kp_name_n)
}

// ---- what is kept of a module: names ----
// A kept name of item i's: shelf-NAME then suffix (".zip", ".txt"), into
// kp_name; false if it is too long to keep.
shelf_kept_at(i: int, suffix: str): bool {
    if (i < 0 || shelf_list == null) return false;
    ok: bool = false;
    borrow shelf_list as list {
        if (i < list.count) ok = shelf_kept_name_with(list.items[i].name, suffix)
    }
    ok
}

// Item i's made file's name, copy's (shelf_copy_ending), into kp_name.
shelf_kept_copy_at(i: int, copy: int): bool {
    if (!shelf_kept_at(i, ".")) return false;
    ending: str = shelf_copy_ending(copy);
    if (kp_name_n + len(ending) > len(kp_name)) return false;
    for c in ending {
        kp_name[kp_name_n] = c;
        kp_name_n = kp_name_n + 1
    }
    true
}

// Item i's made file read now (the copy its line names), into kp_name.
shelf_kept_made_at(i: int): bool {
    shelf_kept_copy_at(i, shelf_copy_at(i))
}

shelf_kept_name_with(name: str, suffix: str): bool {
    if (6 + len(name) + len(suffix) > len(kp_name)) return false;
    kp_set("shelf-");
    for c in name {
        kp_name[kp_name_n] = c;
        kp_name_n = kp_name_n + 1
    }
    for c in suffix {
        kp_name[kp_name_n] = c;
        kp_name_n = kp_name_n + 1
    }
    true
}

// An unpacked file's kept name: shelf-NAME. then its ending (a dot it
// begins with left out, its slashes as _), into kp_name.
shelf_kept_file_at(
    i: int,
    ending: []i8,
    from: int,
    to: int
): bool {
    if (!shelf_kept_at(i, ".")) return false;
    start: int = if (to > from && ending[from] == '.') from + 1 else from;
    if (kp_name_n + to - start > len(kp_name)) return false;
    for k in start..to {
        kp_name[kp_name_n] = (if (ending[k] == '/') '_' else ending[k]);
        kp_name_n = kp_name_n + 1
    }
    true
}

// ---- asking the platform ----
// What the bookshelf reads and keeps goes by its item's slot's id; one
// thing is done at a time, so its answer is the work's.
shelf_item_id(i: int): int {
    SHELF_READ_ID_FIRST + shelf_slot_at(i)
}

// The kept file named in kp_name read back as item i's (`got`).
shelf_read_named(i: int) {
    f: ?fn(id: int, name: []i8, name_n: int) = host_io.read_kept;
    if (f != null) f(shelf_item_id(i), kp_name, kp_name_n)
}

// count bytes from offset of the kept file named in kp_name, read as item
// i's (`got`).
shelf_read_named_range(i: int, offset: int, count: int) {
    f: ?fn(id: int, name: []i8, name_n: int, offset: int, count: int) = host_io.read_kept_range;
    if (f != null) f(shelf_item_id(i), kp_name, kp_name_n, offset, count)
}

// count bytes of data kept as the file named in kp_name, as item i's
// (`kept`).
shelf_keep_named(i: int, data: []i8, count: int) {
    f: ?fn(id: int, name: []i8, name_n: int, data: []i8, count: int) = host_io.keep;
    if (f != null) f(shelf_item_id(i), kp_name, kp_name_n, data, count)
}

// A file read back that nothing waits for (its work given up): taken, so
// that the platform lets it go.
shelf_got_unwanted(id: int, size: int) {
    if (size <= 0) return;
    region {
        data: []i8 = new i8[size](0i8);
        hs_file(id, data)
    }
}

// A bookshelf Bible wanted as text t (host.l8's hs_ask_version): read back
// (made as a version first, if it is not yet), once the bookshelf rests
// from what it is doing.
shelf_ask_text(t: int) {
    i: int = shelf_find_text(t);
    if (i < 0 || !shelf_ready_at(i)) {
        hs_missing(t);
        return
    }
    if (text_ready(t)) {
        hs_version_arrived(t);
        return
    }
    if (shelf_busy()) {
        shelf_text_waiting = t;
        return
    }
    match shelf_form_at(i) {
        Made -> shelf_bible_load(i, t);
        _ -> shelf_bible_make(i, t, MakingSource.Download)
    }
}

// The platform's `got` for one of ours: the catalog, or what the work in
// hand asked for.
shelf_got(id: int, size: int) {
    if (id == SHELF_READ_CATALOG_ID) {
        came: bool = false;
        if (size > 0) {
            region {
                data: []i8 = new i8[size](0i8);
                hs_file(id, data);
                came = shelf_catalog_came(data, size)
            }
        }
        if (came) shelf_updates_begin();
        if (!came) {
            // (What is kept is damaged or gone: fetched again, online.)
            set_pref("shelfCatalogDay", 0);
            if (shelf_catalog == null) shelf_catalog_state = (if (hd_network != NET_NONE) CatalogState.Unread else CatalogState.Failed { offline: true }) else shelf_catalog_state = CatalogState.Here;
            if (hd_network != NET_NONE) shelf_fetch_catalog()
        }
        shelf_screens_changed();
        return
    }
    i: int = shelf_find_slot(id - SHELF_READ_ID_FIRST);
    if (i < 0 || shelf_work_slot() != id - SHELF_READ_ID_FIRST) {
        shelf_got_unwanted(id, size);
        return
    }
    match shelf_work {
        MakingBible w -> shelf_bible_got(i, id, size, w.t, w.source);
        MakingDocument w -> shelf_document_got(i, id, size, w.source);
        OpeningFolio w -> shelf_folio_got(i, id, size, w.use, w.head);
        LoadingBible w -> shelf_bible_loaded(i, id, size, w.t, w.kept);
        ReadingText _w -> shelf_text_got(i, id, size);
        _ -> shelf_got_unwanted(id, size)
    }
}

// The platform's `kept` for one of ours: a file of the work in hand kept
// (or not).
shelf_kept(id: int, ok: bool) {
    i: int = shelf_find_slot(id - SHELF_READ_ID_FIRST);
    if (i < 0 || shelf_work_slot() != id - SHELF_READ_ID_FIRST) return;
    match shelf_work {
        MakingBible w -> shelf_bible_kept(i, ok, w.t, w.source);
        MakingDocument w -> shelf_document_kept(i, ok, w.source);
        LoadingBible w -> shelf_bible_records_packed(i, ok, w.t);
        _ -> { }
    }
}

// What a work's file read back said when it is gone: the module is wanted
// again (downloaded when online), its work given up.
shelf_file_gone(i: int) {
    shelf_save_with(i, false, shelf_size_at(i));
    shelf_close_slot(shelf_slot_at(i));
    shelf_pump();
    shelf_work_rests()
}

// ---- work done a step at a time ----
// What the bookshelf is doing, one thing at a time, so that the app
// answers its reader however slowly it runs (interpreted, as hot reload
// runs it): a step each time the skin says `next` (it asks for one after
// each step), or as what it asked the platform for comes. A module
// downloaded is made once (a Bible a version, any other a folio), then
// opened from what is kept: a file, or a span of one, at a time.
type ShelfWork =
    | Resting
    // Its package read and taken out, a chapter of records made each
    // step, the records kept.
    | MakingBible { slot: int, t: int, source: MakingSource }
    // Its package read and taken out, a commentary's chapters made into
    // a folio some each step, the folio kept.
    | MakingDocument { slot: int, source: MakingSource }
    // Its folio's head read: the first bytes, which say how long it is
    // (head 0), then the head (head its size).
    | OpeningFolio { slot: int, use: int, head: int }
    // Its folio read back (or its records, kept before folios, then
    // packed and kept as one).
    | LoadingBible { slot: int, t: int, kept: KeptBible }
    // A span of a text file read (shelf_held).
    | ReadingText { slot: int }

shelf_work: ShelfWork = ShelfWork.Resting;

// What a making reads and where it keeps what it makes: a download's
// package (shelf-NAME.zip), made into the copy the module's line names;
// or an update's (SHELF_UPDATE_PACKAGE), made into the other copy while
// the one before is read, the line switched to it once it is kept.
type MakingSource =
    | Download
    | Update

// The package a making reads, into kp_name.
shelf_kept_package_at(i: int, source: MakingSource): bool {
    match source {
        Download -> shelf_kept_at(i, ".zip");
        Update -> shelf_kept_at(i, SHELF_UPDATE_PACKAGE)
    }
}

// The file a making keeps what it made as, into kp_name.
shelf_kept_making_at(i: int, source: MakingSource): bool {
    match source {
        Download -> shelf_kept_made_at(i);
        Update -> shelf_kept_copy_at(i, shelf_other_copy(shelf_copy_at(i)))
    }
}

// How much of it is done, in thousandths, as the screens show it.
shelf_work_done: int = 0;

// About how many bytes a step decodes.
SHELF_STEP_BYTES: int = 262144;

// Of a work, the share that taking its package out is (the rest: keeping
// its files, or making its records), in thousandths.
SHELF_PACKAGE_SHARE: int = 300;

// A version asked for while the bookshelf was busy (-1: none), asked for
// again once it rests.
shelf_text_waiting: int = -1;

shelf_busy(): bool {
    match shelf_work {
        Resting -> false;
        _ -> true
    }
}

// The slot of the module being worked on (-1: none).
shelf_work_slot(): int {
    match shelf_work {
        Resting -> -1;
        MakingBible w -> w.slot;
        MakingDocument w -> w.slot;
        OpeningFolio w -> w.slot;
        LoadingBible w -> w.slot;
        ReadingText w -> w.slot
    }
}

// Work begun or going on a step at a time: the skin asked for a turn.
shelf_work_next() {
    ui_effect("next", -1, -1)
}

// The skin's `next`: a step of what the bookshelf is doing.
shelf_work_step() {
    stepping: bool = true;
    match shelf_work {
        MakingBible w -> shelf_bible_step(w.slot, w.t, w.source);
        MakingDocument w -> shelf_document_step(w.source);
        _ -> stepping = false
    }
    if (!stepping) return;
    match shelf_work {
        MakingBible _w -> if (shelf_bible_stepping()) shelf_work_next();
        MakingDocument _w -> if (shelf_document_stepping()) shelf_work_next();
        _ -> { }
    }
}

// How far it has come (thousandths): what is on its way to a pane told,
// at each percent more. (Never less: a work's measure of itself
// may step back a little, as a large block's decoding gives way to the
// comments made from it.)
shelf_work_shown(done: int) {
    if (done / 10 <= shelf_work_done / 10) return;
    shelf_work_done = done;
    doc_arrivals_check()
}

// The work done (or given up): what waited for it asked for again.
shelf_work_rests() {
    shelf_work = ShelfWork.Resting;
    shelf_work_done = 0;
    t: int = shelf_text_waiting;
    shelf_text_waiting = -1;
    if (t >= 0) shelf_ask_text(t);
    shelf_open_settled();
    shelf_making_download = -1;
    // (An update swapped in shown before another module is made.)
    shelf_reread_when_ready();
    shelf_prepare_next()
}

// ---- a module made as it downloads ----
// A module downloaded is made (a Bible a version, any other a folio) as
// part of its download: still coming until it is made (a pane it is on its
// way to changes to it then), so that it opens quickly. Those downloaded
// this session wait
// here (their slots, in the order they came) while the bookshelf is busy,
// and are made one after another as it rests. (Not across launches: one
// that couldn't be made isn't tried each time the app opens; it is made
// when it is opened. So is one downloaded while SHELF_TO_MAKE_MOST wait.)
SHELF_TO_MAKE_MOST: int = 32;

shelf_to_make: []int = new int[SHELF_TO_MAKE_MOST](0);

shelf_to_make_n: int = 0;

// The slot being made as part of its download (-1: none): coming until it
// is made.
shelf_making_download: int = -1;

// Of a download's progress, the share that fetching its package is (the
// rest: making it), in thousandths.
SHELF_DOWNLOAD_SHARE: int = 250;

shelf_to_make_add(slot: int) {
    if (shelf_to_make_has(slot) || shelf_to_make_n == SHELF_TO_MAKE_MOST) return;
    shelf_to_make[shelf_to_make_n] = slot;
    shelf_to_make_n = shelf_to_make_n + 1
}

shelf_to_make_has(slot: int): bool {
    for k in 0..shelf_to_make_n
        if (shelf_to_make[k] == slot) return true;
    false
}

// The first slot waiting taken from the queue (-1: none).
shelf_to_make_take(): int {
    if (shelf_to_make_n == 0) return -1;
    slot: int = shelf_to_make[0];
    for k in 1..shelf_to_make_n shelf_to_make[k - 1] = shelf_to_make[k];
    shelf_to_make_n = shelf_to_make_n - 1;
    slot
}

// Whether slot is being made now (a Bible a version, or a folio).
shelf_making_slot(slot: int): bool {
    match shelf_work {
        MakingBible w -> w.slot == slot;
        MakingDocument w -> w.slot == slot;
        _ -> false
    }
}

// Whether item i is still coming: downloading or waiting to, or
// downloaded and being made (or waiting its turn) as part of its download.
shelf_coming_at(i: int): bool {
    if (i < 0 || i >= shelf_count()) return false;
    if (!shelf_ready_at(i) || shelf_broken_at(i)) return !shelf_ready_at(i);
    slot: int = shelf_slot_at(i);
    match shelf_form_at(i) {
        Packaged -> shelf_to_make_has(slot) && !shelf_updating_at(i) || shelf_making_slot(slot) && shelf_making_download == slot;
        _ -> false
    }
}

// Whether item i is here to read: downloaded, and made if it was
// downloaded this session.
shelf_here_at(i: int): bool {
    shelf_ready_at(i) && !shelf_coming_at(i)
}

// The next module downloaded and waiting begun being made, if the
// bookshelf rests: an update's package beside the copy read, else a
// download (those removed, broken or made already let go).
shelf_prepare_next() {
    while (!shelf_busy() && shelf_to_make_n > 0) {
        slot: int = shelf_to_make_take();
        i: int = shelf_find_slot(slot);
        updating: bool = match shelf_update_at(i) {
            Fetched -> true;
            _ -> false
        };
        if (updating) {
            if (shelf_kind_at(i) == SHELF_KIND_BIBLE) shelf_bible_make(i, shelf_text_of(i),
                MakingSource.Update) else shelf_document_make(i, MakingSource.Update)
        } else if (i >= 0 && shelf_ready_at(i) && !shelf_broken_at(i)) {
            match shelf_form_at(i) {
                Packaged -> {
                    shelf_making_download = slot;
                    if (shelf_kind_at(i) == SHELF_KIND_BIBLE) shelf_bible_make(i,
                        shelf_text_of(i), MakingSource.Download) else shelf_document_make(i,
                        MakingSource.Download)
                }
                _ -> { }
            }
        }
    }
}

// ---- a Bible made a version ----
// What a Bible's module said as it was made a version: whether it marks
// the words of Jesus, and what of it could not be shown.
type BibleOpened = {
    red: bool;
    report: BibleReport
}

// A Bible being made: its package's bytes and their opening, then its
// module, where making its records is (core/shelf_bible.l8), what it
// said, how far it has come, and its folio being packed.
type BibleJob = {
    data: []i8;
    opening: *PackageOpening;
    module: ?*VerseModule;
    place: BibleBook;
    opened: BibleOpened;
    making: BibleMaking;
    writer: *folio::FolioWriter
}

// How far a Bible's making has come: its records being made; packed into
// its folio, those before at already in it; or the folio being kept.
type BibleMaking =
    | Making
    | Packing { at: int }
    | Keeping

shelf_bible_job: ?owned *BibleJob = null;

// The version being made (core/shelf_bible.l8's bible_text_).
shelf_bible_next: ?owned *TextData = null;

shelf_bible_make(i: int, t: int, source: MakingSource) {
    // (A slot past the versions' (a damaged shelf.tsv): damaged too.)
    if (t >= len(texts) || !shelf_kept_package_at(i, source)) {
        shelf_making_failed(i, t, source);
        shelf_open_settled();
        return
    }
    shelf_work = ShelfWork.MakingBible { slot: shelf_slot_at(i), t: t, source: source };
    shelf_work_done = 0;
    shelf_read_named(i)
}

// A Bible that couldn't be made: a download's marked broken
// (shelf_bible_failed); an update's let go, the copy before still read.
shelf_making_failed(i: int, t: int, source: MakingSource) {
    match source {
        Download -> shelf_bible_failed(i, t);
        Update -> shelf_update_failed(i, false)
    }
}

shelf_bible_got(
    i: int,
    id: int,
    size: int,
    t: int,
    source: MakingSource
) {
    if (size <= 0) {
        match source {
            Download -> {
                hs_missing(t);
                shelf_file_gone(i)
            }
            Update -> {
                shelf_update_failed(i, false);
                shelf_work_rests()
            }
        }
        return
    }
    try {
        next: owned *BibleJob = own {
            shelf_bible_job_made(id, size)
        };
        drop shelf_bible_job;
        shelf_bible_job = move next;
        shelf_work_next()
    } with SwordError _error -> {
        shelf_making_failed(i, t, source);
        shelf_work_rests()
    }
}

shelf_bible_job_made(id: int, size: int) raises SwordError: *BibleJob@new {
    data: []i8 = new i8[size](0i8);
    hs_file(id, data);
    new BibleJob {
        data: data,
        opening: package_begin(data, size),
        module: null,
        place: bible_book_new(),
        opened: BibleOpened { red: false, report: BibleReport {
            missing_books: 0,
            outside_chapters: 0,
            extra_books: 0,
            verses: 0
        } },
        making: BibleMaking.Making,
        writer: folio::folio_writer_new()
    }
}

// Whether it is still being made (stepped; then its records are kept).
shelf_bible_stepping(): bool {
    if (shelf_bible_job == null) return false;
    stepping: bool = false;
    borrow shelf_bible_job as job {
        stepping = (match job.making {
            Keeping -> false;
            _ -> true
        })
    }
    stepping
}

// A step of a Bible's making: its package's files taken out, then a
// chapter of its records made, then a part of them packed into its folio;
// at the end, the folio kept.
shelf_bible_step(slot: int, t: int, source: MakingSource) {
    i: int = shelf_find_slot(slot);
    if (i < 0 || shelf_bible_job == null) {
        shelf_bible_given_up();
        return
    }
    packing: bool = false;
    borrow shelf_bible_job as job {
        match job.making {
            Packing _p -> packing = true;
            _ -> { }
        }
    }
    if (packing) {
        shelf_bible_pack_step(i, t, source);
        return
    }
    done: bool = false;
    progress: int = 0;
    try {
        borrow shelf_bible_job as job {
            module: ?*VerseModule = job.module;
            if (module == null) {
                whole: bool = false;
                allocate job {
                    whole = package_step(job.opening, SHELF_STEP_BYTES)
                }
                progress = package_progress(job.opening) * SHELF_PACKAGE_SHARE / 1000;
                if (whole) {
                    opened: ?*VerseModule = null;
                    allocate job {
                        opened = verse_module_open(package_opened(job.opening))
                    }
                    job.module = opened;
                    if (opened != null) {
                        job.opened.red = verse_module_info(opened).words_of_christ;
                        bible_text_begin(t, opened, &job.opened.report)
                    }
                }
            } else {
                allocate job {
                    done = bible_text_step(module, &job.place, &job.opened.report)
                }
                progress = SHELF_PACKAGE_SHARE + (SHELF_PACKING_FROM - SHELF_PACKAGE_SHARE) * job.place.book / books
            }
            if (done) job.making = BibleMaking.Packing { at: 0 }
        }
    } with SwordError _error -> {
        shelf_bible_given_up();
        shelf_making_failed(i, t, source);
        return
    }
    if (done) bible_text_finish();
    shelf_work_shown(if (done) SHELF_PACKING_FROM else progress)
}

// Of a Bible's making, where packing its records begins, in thousandths.
SHELF_PACKING_FROM: int = 900;

// About how many bytes of records a step packs.
SHELF_PACK_BYTES: int = 262144;

// A step of packing a made Bible's records into its folio (whole records
// each step); the last keeps the folio, to be read back as a bundled
// version's is.
shelf_bible_pack_step(i: int, t: int, source: MakingSource) {
    if (shelf_bible_next == null) {
        shelf_bible_given_up();
        shelf_making_failed(i, t, source);
        return
    }
    finished: bool = false;
    unkept: bool = false;
    progress: int = SHELF_PACKING_FROM;
    try {
        borrow shelf_bible_job as job {
            at: int = 0;
            match job.making {
                Packing p -> at = p.at;
                _ -> { }
            }
            borrow shelf_bible_next as text {
                end: int = if (text.size - at > SHELF_PACK_BYTES) at + SHELF_PACK_BYTES else text.size;
                while (end < text.size && text.data[end - 1] as int != 10) end = end + 1;
                allocate job {
                    folio::folio_append_records(job.writer, text.data, at, end)
                }
                progress = SHELF_PACKING_FROM + (1000 - SHELF_PACKING_FROM) * end / (if (text.size > 0) text.size else 1);
                if (end < text.size) job.making = BibleMaking.Packing { at: end } else {
                    job.making = BibleMaking.Keeping;
                    finished = true;
                    allocate job {
                        packed: []i8 = folio::folio_finish(job.writer);
                        if (shelf_kept_making_at(i, source)) shelf_keep_named(i, packed,
                            len(packed)) else unkept = true
                    }
                }
            }
        }
    } with folio::FolioError _error -> {
        shelf_bible_given_up();
        shelf_making_failed(i, t, source);
        return
    }
    if (unkept) shelf_bible_kept(i, false, t, source) else if (!finished) shelf_work_shown(progress)
}

// Its records kept (or not): a download's version in its slot's place
// (not kept, made again when it is next opened); an update's swapped in
// for the version read (shelf_update_swap), or, not kept, let go.
shelf_bible_kept(
    i: int,
    ok: bool,
    t: int,
    source: MakingSource
) {
    opened: BibleOpened = BibleOpened { red: false, report: no_report };
    if (shelf_bible_job != null) {
        borrow shelf_bible_job as job {
            opened = job.opened
        }
    }
    match source {
        Update -> {
            if (!ok) {
                shelf_update_failed(i, false);
                shelf_bible_given_up();
                return
            }
            shelf_update_swap(i, ShelfForm.Made, opened);
            // (In place of the version before, let go: what reads it is
            // sent its parts again.)
            drop texts[t];
            texts[t] = move shelf_bible_next;
            drop shelf_bible_job;
            shelf_work_rests();
            hs_version_arrived(t);
            pane_reread_version(t);
            return
        }
        Download -> { }
    }
    shelf_set_opened(i, opened.red, opened.report);
    if (ok) {
        if (shelf_kept_at(i, ".zip")) {
            f: fn() = kept_store.remove;
            f()
        }
        shelf_save_form(i, ShelfForm.Made)
    }
    shelf_name_versions();
    // (In place of the slot's text before, let go.)
    drop texts[t];
    texts[t] = move shelf_bible_next;
    drop shelf_bible_job;
    shelf_work_rests();
    hs_version_arrived(t)
}

// A Bible's making let go (its slot removed, or it could not be made).
shelf_bible_given_up() {
    drop shelf_bible_job;
    drop shelf_bible_next;
    shelf_work_rests()
}

// A made Bible's folio read back, as a bundled version's is.
shelf_bible_load(i: int, t: int) {
    if (!shelf_kept_made_at(i)) {
        hs_missing(t);
        return
    }
    shelf_work = ShelfWork.LoadingBible { slot: shelf_slot_at(i), t: t, kept: KeptBible.AsFolio };
    shelf_work_done = 0;
    shelf_read_named(i)
}

shelf_bible_loaded(
    i: int,
    id: int,
    size: int,
    t: int,
    kept: KeptBible
) {
    match kept {
        AsFolio -> {
            if (size <= 0) {
                // (None: perhaps its records, as a Bible made before
                // folios was kept.)
                if (shelf_kept_at(i, ".txt")) {
                    shelf_work = ShelfWork.LoadingBible { slot: shelf_slot_at(i), t: t, kept: KeptBible.AsRecords };
                    shelf_read_named(i)
                } else {
                    hs_missing(t);
                    shelf_file_gone(i)
                }
                return
            }
            if (!text_read(t, id, size, &hs_file)) {
                hs_missing(t);
                shelf_file_gone(i);
                return
            }
            shelf_bible_in_place(t)
        }
        AsRecords -> {
            if (size <= 0) {
                hs_missing(t);
                shelf_file_gone(i);
                return
            }
            shelf_bible_records_read(i, id, size, t)
        }
    }
}

// A Bible read back: the version in its slot's place.
shelf_bible_in_place(t: int) {
    shelf_name_versions();
    shelf_work_rests();
    hs_version_arrived(t)
}

// How a made Bible is kept: as a folio, or (made before folios) as its
// records, which are packed into a folio when they are first read back.
// (AsRecords can go once no installation keeps a Bible's records.)
type KeptBible =
    | AsFolio
    | AsRecords

// A Bible's records read back: made a version, then packed into a folio
// and kept as one (all at once: it happens once), the records' file let
// go once it is. Records that do not begin with a book are not a Bible's:
// nothing is made of them, and nothing let go.
shelf_bible_records_read(
    i: int,
    id: int,
    size: int,
    t: int
) {
    next: owned *TextData = own {
        text: *TextData = text_made(t, size);
        hs_file(id, text.data);
        text_index(text);
        text
    };
    records: bool = false;
    borrow next as text {
        records = text.size > 0 && text.data[0] == 'B' as i8
    }
    if (!records) {
        drop next;
        hs_missing(t);
        shelf_work_rests();
        return
    }
    kept: bool = false;
    region {
        try {
            writer: *folio::FolioWriter = folio::folio_writer_new();
            borrow next as text {
                folio::folio_append_records(writer, text.data, 0, text.size)
            }
            packed: []i8 = folio::folio_finish(writer);
            if (shelf_kept_made_at(i)) {
                shelf_keep_named(i, packed, len(packed));
                kept = true
            }
        } with folio::FolioError _error -> { }
    }
    text_replace(t, move next);
    // (Not packed, its records stay as they are: read so again.)
    if (!kept) shelf_bible_in_place(t)
}

// Its folio kept (or not): its records' file let go, and the version in
// its slot's place.
shelf_bible_records_packed(i: int, ok: bool, t: int) {
    if (ok && shelf_kept_at(i, ".txt")) {
        f: fn() = kept_store.remove;
        f()
    }
    shelf_bible_in_place(t)
}

// ---- modules open for reading (commentaries, dictionaries, books) ----
// Each open module's folio's head, read into an arena of its own (its
// content read a span of blocks at a time, as it is wanted: shelf_held):
// one for each use at a time (Study's commentary, a dictionary, a book),
// let go when another is opened for that use or it is removed.
type OpenReader =
    | Document { folio: *folio::Folio }

type OpenModule = {
    slot: int;
    reader: OpenReader
}

SHELF_USES: int = 3;

// The uses: Study's commentary (and a Bible's), a dictionary's entries
// (a glossary's, a devotional's), a book.
SHELF_USE_STUDY: int = 0;

SHELF_USE_ENTRIES: int = 1;

SHELF_USE_BOOK: int = 2;

shelf_open: []?owned *OpenModule = new ?owned *OpenModule[SHELF_USES](null);

// Each use's slot open (-1 none).
shelf_open_slots: []int = new int[SHELF_USES](-1);

// The use a module's kind (its code) is opened for.
shelf_use_of(kind: int): int {
    if (kind <= SHELF_KIND_COMMENTARY) SHELF_USE_STUDY else if (kind <= SHELF_KIND_DEVOTIONAL) SHELF_USE_ENTRIES else SHELF_USE_BOOK
}

// Whether slot is open (its module readable now); if not, it is made a
// folio (once) and opened, once the bookshelf rests from what it is doing.
shelf_ensure_open(slot: int): bool {
    i: int = shelf_find_slot(slot);
    if (i < 0 || !shelf_ready_at(i)) return false;
    use: int = shelf_use_of(shelf_kind_at(i));
    if (shelf_open_slots[use] == slot && shelf_open[use] != null) return true;
    if (shelf_broken_at(i) || shelf_busy()) return false;
    match shelf_form_at(i) {
        Folio -> shelf_folio_open(i, use);
        Unpacked -> {
            // (Unpacked by an earlier build, before modules were made
            // folios: its files let go, and it downloaded and made again.)
            shelf_remove_kept(i);
            shelf_file_gone(i)
        }
        _ -> shelf_document_make(i, MakingSource.Download)
    }
    false
}

// A module opened, or found it could not be: the screens that wait for
// it told.
shelf_open_settled() {
    shelf_screens_changed();
    sk_update_all()
}

shelf_close_slot(slot: int) {
    for use in 0..SHELF_USES {
        if (shelf_open_slots[use] == slot) {
            drop shelf_open[use];
            shelf_open_slots[use] = -1
        }
    }
    shelf_held_close(slot);
    // (What was being done for it, let go.)
    if (shelf_work_slot() == slot) {
        drop shelf_document_job;
        drop shelf_bible_job;
        drop shelf_bible_next;
        shelf_work = ShelfWork.Resting;
        shelf_work_done = 0
    }
}

// The use's open module is slot's.
shelf_open_is(use: int, slot: int): bool {
    shelf_open_slots[use] == slot && shelf_open[use] != null
}

// ---- a module's text, a span at a time ----
// The spans of open modules' text files last read (a commentary's folio's
// blocks holding a chapter; a dictionary's block; a book's part), each in
// an arena of its own: a few, so that screens over one another each keep
// theirs and a commentary read beside the page has the chapters on either
// side of its reader's read ahead, the one used longest ago let go for the
// next wanted.
type HeldText = {
    slot: int;
    ending: str;
    offset: int;
    count: int;
    // Its bytes, once read; it could not be (its parts say they are damaged).
    bytes: []i8;
    read: bool;
    failed: bool
}

SHELF_HELD_MOST: int = 6;

shelf_held: []?owned *HeldText = new ?owned *HeldText[SHELF_HELD_MOST](null);

// When each was last used (a count of uses), and which is being read or
// decoded (-1: none).
shelf_held_used: []int = new int[SHELF_HELD_MOST](0);

shelf_held_uses: int = 0;

shelf_held_at: int = -1;

// Slot's spans let go (it is closed or removed).
shelf_held_close(slot: int) {
    for k in 0..SHELF_HELD_MOST {
        mine: bool = false;
        if (shelf_held[k] != null) {
            borrow shelf_held[k] as held {
                mine = held.slot == slot
            }
        }
        if (mine)
            drop shelf_held[k]
    }
}

// Which of what is held is the span (all of it, read), or could not be
// read (-1: none); marked used.
shelf_holds(slot: int, span: TextSpan): int {
    for k in 0..SHELF_HELD_MOST {
        if (shelf_held[k] != null) {
            holds: bool = false;
            borrow shelf_held[k] as held {
                holds = held.slot == slot && held.ending == span.ending && (held.failed || held.read && held.offset <= span.offset && span.offset + span.count <= held.offset + held.count)
            }
            if (holds) {
                shelf_held_uses = shelf_held_uses + 1;
                shelf_held_used[k] = shelf_held_uses;
                return k
            }
        }
    }
    -1
}

// Whether the span of slot's text is held; if not, it is asked for (once
// the bookshelf rests), and the screens made again when it comes.
shelf_span_ready(slot: int, span: TextSpan): bool {
    if (shelf_holds(slot, span) >= 0) return true;
    if (shelf_busy()) return false;
    i: int = shelf_find_slot(slot);
    region {
        ending: []i8 = bytes(span.ending);
        if (i < 0 || !shelf_kept_file_at(i, ending, 0, len(ending))) return true
    }
    // (In the place of the one used longest ago.)
    at: int = 0;
    for k in 0..SHELF_HELD_MOST {
        if (shelf_held[k] == null) {
            at = k;
            shelf_held_used[k] = -1
        } else if (shelf_held_used[k] < shelf_held_used[at]) at = k
    }
    drop shelf_held[at];
    next: owned *HeldText = own {
        new HeldText {
            slot: slot,
            ending: shelf_bytes_text(bytes(span.ending), 0, len(span.ending)),
            offset: span.offset,
            count: span.count,
            bytes: new i8[0](0i8),
            read: false,
            failed: false
        }
    };
    shelf_held[at] = move next;
    shelf_held_uses = shelf_held_uses + 1;
    shelf_held_used[at] = shelf_held_uses;
    shelf_held_at = at;
    shelf_work = ShelfWork.ReadingText { slot: slot };
    shelf_work_done = 0;
    shelf_read_named_range(i, span.offset, span.count);
    false
}

shelf_text_got(_i: int, id: int, size: int) {
    at: int = shelf_held_at;
    shelf_held_at = -1;
    if (at < 0 || shelf_held[at] == null) {
        shelf_got_unwanted(id, size);
        shelf_work_rests();
        return
    }
    borrow shelf_held[at] as held {
        if (size != held.count) {
            held.failed = true;
            shelf_got_unwanted(id, size)
        } else {
            allocate held {
                data: []i8 = new i8[size](0i8);
                hs_file(id, data);
                held.bytes = data
            }
            held.read = true
        }
    }
    shelf_work_rests()
}

// ---- references in a module's text ----
// The KJV's books (the app's 66, in order), from the library's tables: a
// dataset read when the shelf is (shelf_load; its table is part of the
// library, so it reads).
shelf_kjv: ?owned *Versification = null;

shelf_kjv_prepare() {
    if (shelf_kjv != null) return;
    try {
        next: owned *Versification = own {
            versification_named("KJV")
        };
        drop shelf_kjv;
        shelf_kjv = move next
    } with SwordError _error -> {
        // (Only a broken library table fails here. Then nothing has the
        // KJV's books: modules' references aren't linked, and a
        // commentary has no verses, as for a numbering not known.)
        drop shelf_kjv;
        shelf_kjv = null
    }
}

// The app's book whose OSIS name is bytes from up to to of osis (-1:
// none).
shelf_osis_book(osis: []i8, from: int, to: int): int {
    if (shelf_kjv == null) return -1;
    found: int = -1;
    borrow shelf_kjv as kjv {
        for k in 0..books {
            if (k < len(kjv.books)) {
                name: str = kjv.books[k].osis;
                if (len(name) == to - from) {
                    same: bool = true;
                    for x in 0..len(name)
                        if (name[x] != osis[from + x]) same = false;
                    if (same) found = k
                }
            }
        }
    }
    found
}

// An OSIS reference (Gen.1.1, Gen.1.1-Gen.1.3, Ps.23, John.3.16-18) as a
// packed reference (core/text.l8's xref_unpack), -1 if it names nothing
// in the 66 books.
shelf_osis_ref(text: []i8, from: int, to: int): int {
    // (Its first reference, if it has several.)
    end: int = from;
    while (end < to && text[end] as int != 32 && text[end] as int != 59) end = end + 1;
    dash: int = from;
    while (dash < end && text[dash] as int != 45) dash = dash + 1;
    book_end: int = from;
    while (book_end < dash && text[book_end] as int != 46) book_end = book_end + 1;
    b: int = shelf_osis_book(text, from, book_end);
    if (b < 0) return -1;
    c: int = osis_number(text, book_end + 1, dash, 0);
    v: int = osis_number(text, book_end + 1, dash, 1);
    if (c <= 0 || c > book_count[b]) return -1;
    ce: int = c;
    ve: int = v;
    if (dash < end) {
        // (Its end: Book.C.V, C.V, or V.)
        tail: int = dash + 1;
        parts: int = 0;
        for x in tail..end
            if (text[x] == '.') parts = parts + 1;
        if (parts == 2) {
            // (Past its book's name, to its chapter.)
            book_dot: int = tail;
            while (book_dot < end && text[book_dot] != '.') book_dot = book_dot + 1;
            ce = osis_number(text, book_dot + 1, end, 0);
            ve = osis_number(text, book_dot + 1, end, 1)
        } else if (parts == 1) {
            ce = osis_number(text, tail, end, 0);
            ve = osis_number(text, tail, end, 1)
        } else ve = osis_number(text, tail, end, 0);
        if (ce < c || ce > book_count[b]) ce = c
    }
    start: int = xref_place(b, c, if (v > 0) v else 0);
    finish: int = if (ce == c && ve == v) 0 else xref_place(0, ce, if (ve > 0) ve else 0);
    xref_pair(start, finish)
}

// Number part (0 the first) of the dot-separated numbers from up to to.
osis_number(
    text: []i8,
    from: int,
    to: int,
    part: int
): int {
    at: int = from;
    for _skip in 0..part {
        while (at < to && text[at] != '.') at = at + 1;
        at = at + 1
    }
    n: int = 0;
    while (at < to && is_digit(text[at] as int)) {
        n = n * 10 + text[at] as int - 48;
        at = at + 1
    }
    n
}

// A reference as a reader writes it (a ThML passage: "Ge 1:1; Ro 5:8"),
// its first one, as a packed reference (-1: none), by the reference
// parser Go To uses.
shelf_passage_ref(text: []i8, from: int, to: int): int {
    end: int = from;
    while (end < to && text[end] != ';' && text[end] != ',') end = end + 1;
    if (end - from <= 0 || end - from > 200) return -1;
    room: []i8 = new i8[end - from](0i8);
    for x in from..end room[x - from] = text[x];
    if (!parse_ref(room, end - from) || ref_book < 0) return -1;
    c: int = if (ref_chapter > 0) ref_chapter else 1;
    v: int = if (ref_verse > 0) ref_verse else 0;
    xref_pair(xref_place(ref_book, c, v), 0)
}

