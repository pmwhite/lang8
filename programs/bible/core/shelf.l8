// A code's language (none known: the code itself).
language_name(code: str): str@code {
    // (Its first part: zh of zh-Hant.)
    first: int = 0;
    while (first < len(code) && code[first] as int != 45) first = first + 1;
    for i in 0..len(module_language_codes) {
        known: str = module_language_codes[i];
        if (len(known) == first) {
            same: bool = true;
            for k in 0..first
                if (known[k] != code[k]) same = false;
            if (same) return module_language_names[i]
        }
    }
    code
}

language_is_english(code: str): bool {
    len(code) >= 2 && code[0] == 'e' && code[1] == 'n' && (len(code) == 2 || code[2] == '-')
}
