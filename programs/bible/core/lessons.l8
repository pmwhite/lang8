tag bible;

use_tag std;

// Learning Greek and Hebrew as a course of lessons, apart from any
// platform. A language's course (data/lang/lessons-greek.txt, read and
// checked here) is a sequence of lessons, each a few letters: an
// explanation, the letters with their names and sounds, then exercises,
// one at a time: a letter's name chosen from four, and a word written in
// English letters. A lesson finished is kept (lessons.tsv) and the next one
// offered. Its screens are core's: a language's lessons, a lesson, and its
// exercises.
import "skin.l8";

SCR_COURSE: int = 30;

SCR_LESSON: int = 31;

SCR_EXERCISE: int = 32;

// A practice round: questions of one kind (arg lang * LESSONS_MOST + the
// kind: EX_NAME, EX_SOUND, EX_READ) from the lessons finished.
SCR_PRACTICE_ROUND: int = 33;

// A lesson opened (arg its number in the course); its exercises begun; a
// name chosen (arg the choice); the answer typed (text); the answer checked;
// the next exercise; the next lesson, from a lesson's end; back to the
// language's lessons.
ACT_LESSON_OPEN: int = 400;

ACT_LESSON_BEGIN: int = 401;

ACT_EXERCISE_CHOOSE: int = 402;

ACT_EXERCISE_TYPED: int = 403;

ACT_EXERCISE_CHECK: int = 404;

ACT_EXERCISE_NEXT: int = 405;

ACT_LESSON_NEXT: int = 406;

ACT_LESSON_DONE: int = 407;

// A practice round begun (arg its kind).
ACT_PRACTICE_BEGIN: int = 408;

// A word's sound: a unit tapped to choose for (arg the unit); an option
// picked for it (arg the option).
ACT_SOUND_UNIT: int = 409;

ACT_SOUND_OPTION: int = 410;

// The lessons finished changed: core's kept.l8 keeps them (lessons.tsv).
SK_KEPT_LESSONS: int = 12;

// A lesson's screen and its exercises' are of language lang's lesson:
// their arg is lang * LESSONS_MOST + the lesson's number.
LESSONS_MOST: int = 1000;

// ---- a course: its file read, line by line ----
// A lesson: its id (what keeps its progress) and title, and its
// paragraphs, letters and signs (items), and words, each a run of the
// course's lists.
type CourseLesson = {
    id_b: int;
    id_e: int;
    title_b: int;
    title_e: int;
    first_para: int;
    para_count: int;
    first_item: int;
    item_count: int;
    first_word: int;
    word_count: int
}

// What a lesson teaches: a letter (asked for by name) or a sign (a mark or
// a pair of letters, only shown). Its forms as shown (a letter's capital
// first, then its small forms), name, what it is typed as, its sound, how
// it is said in a word's pronunciation ("ah"; empty if the course doesn't
// say), and what it is likely to be mistaken for, said so (by spaces).
ITEM_LETTER: int = 0;

ITEM_SIGN: int = 1;

type CourseItem = {
    kind: int;
    forms_b: int;
    forms_e: int;
    name_b: int;
    name_e: int;
    typed_b: int;
    typed_e: int;
    sound_b: int;
    sound_e: int;
    said_b: int;
    said_e: int;
    mistaken_b: int;
    mistaken_e: int
}

// A word to read: as written, what it may be typed as (the first as it is
// written in English letters; the others, split by |, accepted too), what
// it means, and how it is said (respelled, its stress in capitals; empty
// if the course doesn't say).
type CourseWord = {
    word_b: int;
    word_e: int;
    typed_b: int;
    typed_e: int;
    meaning_b: int;
    meaning_e: int;
    said_b: int;
    said_e: int;
    line: int
}

type CoursePara = {
    b: int;
    e: int
}

// A language's course: its file's text and what is read from it (byte
// ranges into the text); what is wrong with it, a line each
// ("lessons-greek.txt:12: ..."), the first COURSE_PROBLEMS_SHOWN bytes of
// them and how many there are. A line with a problem is left out.
type Course = {
    lang: int;
    ready: bool;
    text: []i8;
    size: int;
    lessons: []CourseLesson;
    lesson_count: int;
    items: []CourseItem;
    item_count: int;
    words: []CourseWord;
    word_count: int;
    paras: []CoursePara;
    para_count: int;
    problems: []i8;
    problems_n: int;
    problem_count: int;
    // The line being read (for its problems).
    line: int
}

COURSE_PROBLEMS_SHOWN: int = 4096;

// Each language's course file, by its name among the data's ("": none
// yet).
course_files: []str = ["lang/lessons-greek.txt", ""];

// The courses, Greek's and Hebrew's: each a dataset of its own, empty
// (not ready) until its file comes, then replaced whole as it comes again.
courses: []?owned *Course = courses_begin();

courses_begin(): []?owned *Course@new {
    slots: []?owned *Course = new ?owned *Course[2](null);
    for lang in 0..2 slots[lang] = course_empty(lang);
    slots
}

course_empty(lang: int): owned *Course {
    own {
        course_made(lang, 0, 0)
    }
}

// A course of language lang for a file of n bytes and lines lines (its
// lists as long as it has lines; its text, all 0, to be written).
course_made(lang: int, n: int, lines: int): *Course@new {
    new Course {
        lang: lang,
        ready: false,
        text: new i8[n + 1](0i8),
        size: n,
        lessons: new CourseLesson[lines](course_no_lesson()),
        lesson_count: 0,
        items: new CourseItem[lines](course_no_item()),
        item_count: 0,
        words: new CourseWord[lines](CourseWord {
            word_b: 0,
            word_e: 0,
            typed_b: 0,
            typed_e: 0,
            meaning_b: 0,
            meaning_e: 0,
            said_b: 0,
            said_e: 0,
            line: 0
        }),
        word_count: 0,
        paras: new CoursePara[lines](CoursePara { b: 0, e: 0 }),
        para_count: 0,
        problems: new i8[COURSE_PROBLEMS_SHOWN](0i8),
        problems_n: 0,
        problem_count: 0,
        line: 0
    }
}

course_no_lesson(): CourseLesson {
    CourseLesson {
        id_b: 0,
        id_e: 0,
        title_b: 0,
        title_e: 0,
        first_para: 0,
        para_count: 0,
        first_item: 0,
        item_count: 0,
        first_word: 0,
        word_count: 0
    }
}

course_no_item(): CourseItem {
    CourseItem {
        kind: ITEM_LETTER,
        forms_b: 0,
        forms_e: 0,
        name_b: 0,
        name_e: 0,
        typed_b: 0,
        typed_e: 0,
        sound_b: 0,
        sound_e: 0,
        said_b: 0,
        said_e: 0,
        mistaken_b: 0,
        mistaken_e: 0
    }
}

// Language lang's course file came (source's first n bytes): read into a
// course of its own, in place of the one before (let go); the screens
// showing it made again.
course_came(lang: int, source: []i8, n: int) {
    if (lang < 0 || lang >= len(courses)) return;
    next: owned *Course = course_read(lang, source, n);
    drop courses[lang];
    courses[lang] = move next;
    sk_update_all()
}

course_read(lang: int, source: []i8, n: int): owned *Course {
    lines: int = 1;
    for p in 0..n
        if (source[p] as int == 10) lines = lines + 1;
    own {
        c: *Course = course_made(lang, n, lines);
        memcpy(c.text, 0, source, 0, n);
        course_index(c);
        c.ready = true;
        c
    }
}

// Whether language lang has a course with lessons.
course_has_lessons(lang: int): bool {
    if (lang < 0 || lang >= len(courses)) return false;
    borrow courses[lang] as c {
        c.lesson_count > 0
    }
}

// ---- its problems ----
cp_put_problem(c: *Course, k: int) {
    if (c.problems_n < len(c.problems)) {
        c.problems[c.problems_n] = k trunc i8;
        c.problems_n = c.problems_n + 1
    }
}

cp_str(c: *Course, s: str) {
    for k in s cp_put_problem(c, k as int)
}

cp_int(c: *Course, n: int) {
    if (n >= 10) cp_int(c, n / 10);
    cp_put_problem(c, 48 + n % 10)
}

cp_bytes(c: *Course, b: int, e: int) {
    for i in b..e cp_put_problem(c, c.text[i] as int)
}

// A problem with the line being read: "lessons-greek.txt:12: " and words.
course_problem(c: *Course, words: str) {
    c.problem_count = c.problem_count + 1;
    cp_str(c, course_files[c.lang]);
    cp_put_problem(c, 58);
    cp_int(c, c.line);
    cp_str(c, ": ");
    cp_str(c, words)
}

course_problem_end(c: *Course) {
    cp_put_problem(c, 10)
}

// ---- reading it ----
// The fields of a line split by tabs: where each begins and ends.
crs_field_b: []int = new int[8](0);

crs_field_e: []int = new int[8](0);

crs_field_n: int = 0;

course_fields(c: *Course, b: int, e: int) {
    crs_field_n = 0;
    p: int = b;
    more: bool = true;
    while (more && crs_field_n < len(crs_field_b)) {
        q: int = p;
        while (q < e && c.text[q] as int != 9) q = q + 1;
        crs_field_b[crs_field_n] = p;
        crs_field_e[crs_field_n] = q;
        crs_field_n = crs_field_n + 1;
        if (q >= e) more = false else p = q + 1
    }
}

course_is(
    c: *Course,
    b: int,
    e: int,
    s: str
): bool {
    if (e - b != len(s)) return false;
    for i in 0..len(s)
        if (c.text[b + i] != s[i]) return false;
    true
}

course_same(
    c: *Course,
    b1: int,
    e1: int,
    b2: int,
    e2: int
): bool {
    if (e1 - b1 != e2 - b2) return false;
    for i in 0..e1 - b1
        if (c.text[b1 + i] != c.text[b2 + i]) return false;
    true
}

// Its lessons, paragraphs, items and words read from its text, each line
// checked as it is: a word's letters must all be taught by its lesson or
// one before it.
course_index(c: *Course) {
    taught: []bool = new bool[COURSE_LETTERS](false);
    p: int = 0;
    c.line = 0;
    while (p < c.size) {
        e: int = p;
        while (e < c.size && c.text[e] as int != 10) e = e + 1;
        c.line = c.line + 1;
        course_line(c, p, e, taught);
        p = e + 1
    }
    for l in 0..c.lesson_count {
        lesson: CourseLesson = c.lessons[l];
        // (Each word's pronunciation, as its lesson teaches its letters to
        // be read: the sounds of its tiles.)
        for w in lesson.first_word..lesson.first_word + lesson.word_count {
            word: CourseWord = c.words[w];
            if (word.said_e > word.said_b) {
                n: int = word_units(c, w, lesson.first_item + lesson.item_count);
                if (n == 0 || !said_spells_units(c, w, n)) {
                    c.line = word.line;
                    course_problem(c, "the word ");
                    cp_bytes(c, word.word_b, word.word_e);
                    cp_str(c, " is said ");
                    cp_bytes(c, word.said_b, word.said_e);
                    cp_str(c, ", which is not the sounds of its letters");
                    course_problem_end(c)
                }
            }
        }
        if (lesson.item_count + lesson.word_count == 0) {
            c.line = 0;
            course_problem(c, "lesson ");
            cp_bytes(c, lesson.id_b, lesson.id_e);
            cp_str(c, " has no letters and no words");
            course_problem_end(c)
        }
    }
}

course_line(
    c: *Course,
    b: int,
    e: int,
    taught: []bool
) {
    if (e == b || c.text[b] as int == 35) return;
    course_fields(c, b, e);
    if (e - b >= 2 && c.text[b] as int == 61 && c.text[b + 1] as int == 32) {
        course_lesson_line(c, b + 2, e);
        return
    }
    if (c.lesson_count == 0) {
        course_problem(c, "a line before the first lesson");
        course_problem_end(c);
        return
    }
    if (course_is(c, crs_field_b[0], crs_field_e[0], "letter") || course_is(c, crs_field_b[0],
        crs_field_e[0], "sign")) {
        course_item_line(c, taught);
        return
    }
    if (course_is(c, crs_field_b[0], crs_field_e[0], "word")) {
        course_word_line(c, taught);
        return
    }
    if (crs_field_n > 1) {
        course_problem(c, "a line with tabs that is not a letter, sign or word");
        course_problem_end(c);
        return
    }
    c.paras[c.para_count] = CoursePara { b: b, e: e };
    c.para_count = c.para_count + 1;
    c.lessons[c.lesson_count - 1].para_count = c.lessons[c.lesson_count - 1].para_count + 1
}

// "= ID<TAB>Title": a lesson begun.
course_lesson_line(c: *Course, b: int, e: int) {
    t: int = b;
    while (t < e && c.text[t] as int != 9) t = t + 1;
    if (t == b || t >= e) {
        course_problem(c, "a lesson needs an id and a title");
        course_problem_end(c);
        return
    }
    for l in 0..c.lesson_count {
        if (course_same(c, c.lessons[l].id_b, c.lessons[l].id_e, b, t)) {
            course_problem(c, "two lessons ");
            cp_bytes(c, b, t);
            course_problem_end(c);
            return
        }
    }
    c.lessons[c.lesson_count] = CourseLesson {
        id_b: b,
        id_e: t,
        title_b: t + 1,
        title_e: e,
        first_para: c.para_count,
        para_count: 0,
        first_item: c.item_count,
        item_count: 0,
        first_word: c.word_count,
        word_count: 0
    };
    c.lesson_count = c.lesson_count + 1
}

// "letter" or "sign", FORMS, Name, TYPED, Sound[, Said[, Mistaken]]: a letter's forms must
// each be a letter of the course's script (the same one), and it must say
// what it is typed as; it is taught from here on.
course_item_line(c: *Course, taught: []bool) {
    if (crs_field_n < 5 || crs_field_n > 7) {
        course_problem(c, "a letter or sign needs its forms, name, typed letters and sound");
        course_problem_end(c);
        return
    }
    sign: bool = course_is(c, crs_field_b[0], crs_field_e[0], "sign");
    if (!sign) {
        letter: int = 0;
        p: int = crs_field_b[1];
        while (p < crs_field_e[1]) {
            cp: int = cp_at(c.text, p, crs_field_e[1]);
            p = p + cp_len;
            if (cp != 32) {
                k: int = course_letter(c.lang, cp);
                if (k == 0 || letter != 0 && k != letter) {
                    course_problem(c, "a letter's forms must be one letter of the course's script");
                    course_problem_end(c);
                    return
                }
                letter = k
            }
        }
        if (letter == 0 || crs_field_e[3] == crs_field_b[3]) {
            course_problem(c, "a letter needs its forms and what it is typed as");
            course_problem_end(c);
            return
        }
        taught[letter] = true
    }
    c.items[c.item_count] = CourseItem {
        kind: if (sign) ITEM_SIGN else ITEM_LETTER,
        forms_b: crs_field_b[1],
        forms_e: crs_field_e[1],
        name_b: crs_field_b[2],
        name_e: crs_field_e[2],
        typed_b: crs_field_b[3],
        typed_e: crs_field_e[3],
        sound_b: crs_field_b[4],
        sound_e: crs_field_e[4],
        said_b: if (crs_field_n >= 6) crs_field_b[5] else 0,
        said_e: if (crs_field_n >= 6) crs_field_e[5] else 0,
        mistaken_b: if (crs_field_n == 7) crs_field_b[6] else 0,
        mistaken_e: if (crs_field_n == 7) crs_field_e[6] else 0
    };
    c.item_count = c.item_count + 1;
    c.lessons[c.lesson_count - 1].item_count = c.lessons[c.lesson_count - 1].item_count + 1
}

// "word", WORD, TYPED[|TYPED...], Meaning[, Said]: each of its letters
// taught.
course_word_line(c: *Course, taught: []bool) {
    if (crs_field_n < 4 || crs_field_n > 5 || crs_field_e[1] == crs_field_b[1] || crs_field_e[2] == crs_field_b[2]) {
        course_problem(c, "a word needs itself, what it is typed as, and its meaning");
        course_problem_end(c);
        return
    }
    p: int = crs_field_b[1];
    while (p < crs_field_e[1]) {
        cp: int = cp_at(c.text, p, crs_field_e[1]);
        k: int = course_letter(c.lang, cp);
        if (k != 0 && !taught[k]) {
            course_problem(c, "the word ");
            cp_bytes(c, crs_field_b[1], crs_field_e[1]);
            cp_str(c, " has ");
            cp_bytes(c, p, p + cp_len);
            cp_str(c, ", a letter not taught yet");
            course_problem_end(c);
            return
        }
        p = p + cp_len
    }
    c.words[c.word_count] = CourseWord {
        word_b: crs_field_b[1],
        word_e: crs_field_e[1],
        typed_b: crs_field_b[2],
        typed_e: crs_field_e[2],
        meaning_b: crs_field_b[3],
        meaning_e: crs_field_e[3],
        said_b: if (crs_field_n == 5) crs_field_b[4] else 0,
        said_e: if (crs_field_n == 5) crs_field_e[4] else 0,
        line: c.line
    };
    c.word_count = c.word_count + 1;
    c.lessons[c.lesson_count - 1].word_count = c.lessons[c.lesson_count - 1].word_count + 1
}

// ---- the letters of the scripts ----
// A code point's letter: Greek's 1 (alpha) to 24 (omega), whatever its
// case, accents and breathing (lang.l8's greek_info); Hebrew's 101 (alef)
// to 122 (tav), a final form as its letter; 0 for anything else (a mark,
// a space, a Latin letter).
COURSE_LETTERS: int = 128;

HEBREW_ALEF: int = 1488;

HEBREW_TAV: int = 1514;

hebrew_finals: []int = [1498, 1501, 1503, 1507, 1509];

course_letter(lang: int, cp: int): int {
    if (lang == 0) return greek_info(cp) & 31;
    if (cp < HEBREW_ALEF || cp > HEBREW_TAV) return 0;
    // (A final form comes just before its letter: ך כ, ם מ, ן נ, ף פ, ץ צ.)
    letter: int = cp;
    for f in hebrew_finals
        if (cp == f) letter = cp + 1;
    finals_before: int = 0;
    for f in hebrew_finals
        if (f < letter) finals_before = finals_before + 1;
    101 + letter - HEBREW_ALEF - finals_before
}

// The script a language's words are set in.
course_script(lang: int): int {
    sk_script(lang == 0, false)
}

// ---- what is kept: the lessons finished (lessons.tsv) ----
// A line each: the language (greek, hebrew), the lesson's id, the day it
// was first finished (days since 1970).
course_lang_ids: []str = ["greek", "hebrew"];

LESSONS_KEPT_MOST: int = 512;

lk_lang: []int = new int[512](0);

lk_id_b: []int = new int[512](0);

lk_id_e: []int = new int[512](0);

lk_day: []int = new int[512](0);

lk_pool: []i8 = new i8[16384](0i8);

lk_pool_n: int = 0;

lk_n: int = 0;

// Whether lesson l of course c has been finished.
lesson_done(c: *Course, l: int): bool {
    lesson_kept_at(c, l) >= 0
}

lesson_kept_at(c: *Course, l: int): int {
    lesson: CourseLesson = c.lessons[l];
    for k in 0..lk_n {
        if (lk_lang[k] == c.lang && lk_id_e[k] - lk_id_b[k] == lesson.id_e - lesson.id_b) {
            same: bool = true;
            for i in 0..lesson.id_e - lesson.id_b
                if (lk_pool[lk_id_b[k] + i] != c.text[lesson.id_b + i]) same = false;
            if (same) return k
        }
    }
    -1
}

// Lesson l finished today, if it was not before: kept.
lesson_mark_done(c: *Course, l: int) {
    if (lesson_done(c, l)) return;
    lesson: CourseLesson = c.lessons[l];
    n: int = lesson.id_e - lesson.id_b;
    if (lk_n >= LESSONS_KEPT_MOST || lk_pool_n + n > len(lk_pool)) return;
    lk_lang[lk_n] = c.lang;
    lk_id_b[lk_n] = lk_pool_n;
    for i in 0..n lk_pool[lk_pool_n + i] = c.text[lesson.id_b + i];
    lk_pool_n = lk_pool_n + n;
    lk_id_e[lk_n] = lk_pool_n;
    lk_day[lk_n] = sk_today_now();
    lk_n = lk_n + 1;
    sk_kept(SK_KEPT_LESSONS)
}

// The lessons finished, as lessons.tsv's lines, into fbuf.
format_lessons() {
    fbuf_n = 0;
    for k in 0..lk_n {
        fput_str(course_lang_ids[lk_lang[k]]);
        fput(9);
        fput_bytes(lk_pool, lk_id_b[k], lk_id_e[k]);
        fput(9);
        fput_int(lk_day[k]);
        fput(10)
    }
}

// lessons.tsv's lines, read from fbuf (a line it can't read skipped).
parse_lessons() {
    lk_n = 0;
    lk_pool_n = 0;
    p: int = 0;
    while (p < fbuf_n) {
        e: int = p;
        while (e < fbuf_n && fbuf[e] as int != 10) e = e + 1;
        t1: int = p;
        while (t1 < e && fbuf[t1] as int != 9) t1 = t1 + 1;
        t2: int = if (t1 < e) t1 + 1 else e;
        while (t2 < e && fbuf[t2] as int != 9) t2 = t2 + 1;
        lang: int = -1;
        for l in 0..len(course_lang_ids)
            if (bytes_are(fbuf, p, t1, course_lang_ids[l])) lang = l;
        n: int = t2 - t1 - 1;
        if (lang >= 0 && t2 < e && n > 0 && lk_n < LESSONS_KEPT_MOST && lk_pool_n + n <= len(lk_pool)) {
            lk_lang[lk_n] = lang;
            lk_id_b[lk_n] = lk_pool_n;
            for i in 0..n lk_pool[lk_pool_n + i] = fbuf[t1 + 1 + i];
            lk_pool_n = lk_pool_n + n;
            lk_id_e[lk_n] = lk_pool_n;
            day: int = 0;
            for i in t2 + 1..e
                if (is_digit(fbuf[i] as int)) day = day * 10 + fbuf[i] as int - 48;
            lk_day[lk_n] = day;
            lk_n = lk_n + 1
        }
        p = e + 1
    }
}

bytes_are(
    b: []i8,
    from: int,
    to: int,
    s: str
): bool {
    if (to - from != len(s)) return false;
    for i in 0..len(s)
        if (b[from + i] != s[i]) return false;
    true
}

// The first lesson of course c not finished (-1: every one is).
lesson_next(c: *Course): int {
    for l in 0..c.lesson_count
        if (!lesson_done(c, l)) return l;
    -1
}

// "2 of 6 lessons", "Not started", "Finished": where a language's course
// stands (the Library's Learn, the Bookshelf), into fbuf.
fput_course_summary(lang: int) {
    if (lang < 0 || lang >= len(courses)) return;
    borrow courses[lang] as c {
        done: int = 0;
        for l in 0..c.lesson_count
            if (lesson_done(c, l)) done = done + 1;
        if (done == 0) fput_str("The alphabet, a few letters at a time") else if (done == c.lesson_count) fput_str("Every lesson finished") else {
            fput_int(done);
            fput_str(" of ");
            fput_int(c.lesson_count);
            fput_str(" lessons finished")
        }
    }
}

// The course of language lang opened (pushed).
course_open(lang: int) {
    if (course_has_lessons(lang)) sk_open(SCR_COURSE, lang, true)
}

// ---- a lesson's exercises ----
// A letter shown, its name chosen from four; a letter shown, its sound
// chosen from four; a word shown, written in English letters.
EX_NAME: int = 0;

EX_READ: int = 1;

EX_SOUND: int = 2;

// Being answered; answered right; answered wrong.
ANSWER_NONE: int = 0;

ANSWER_RIGHT: int = 1;

ANSWER_WRONG: int = 2;

EXERCISES_MOST: int = 64;

CHOICES: int = 4;

// The exercises being done: which (language, and a lesson's, its practice
// -1; or a practice round of one kind of question, its lesson -1), which
// letters may be offered as names (those before taught_end) and which are
// shown small (from small_from: a lesson's own; those before, either way),
// the words a letter's sound may be asked in (those before words_end),
// each exercise's kind and what it asks for (an item's index, or a word's,
// in the course's lists) and whether it is shown a second time (answered
// wrong before), how many there are and the one shown. A letter's name:
// its form shown (the capital, or the small forms), and the four names
// offered (items) and the one chosen. A letter's sound: a word with it
// (sound_word, a course word; -1: none would do, its sounds offered as
// they are written), said a sound at a time: its units (a letter, a pair
// said as one; unit_b to unit_e in the course's text), each said four ways
// (option o of unit u: choice_b[u * CHOICES + o] to choice_e in
// choice_text), the right one and the one chosen (-1: none yet), and the
// unit being chosen for (-1: none). A word: what has been typed. Then how the one
// shown was answered. Practice's words from the New Testament (a read's
// ask -1 - k for the k-th): each one's form, transliteration and meaning
// in nt_text.
type LessonSession = {
    lang: int;
    lesson: int;
    practice: int;
    taught_end: int;
    small_from: int;
    words_end: int;
    kinds: []int;
    asks: []int;
    again: []bool;
    count: int;
    first_count: int;
    at: int;
    capital: bool;
    choices: []int;
    chosen: int;
    typed: []i8;
    typed_n: int;
    answer: int;
    sound_word: int;
    unit_b: []int;
    unit_e: []int;
    unit_right: []int;
    unit_chosen: []int;
    unit_n: int;
    unit_at: int;
    choice_text: []i8;
    choice_n: int;
    choice_b: []int;
    choice_e: []int;
    nt_form_b: []int;
    nt_form_e: []int;
    nt_typed_b: []int;
    nt_typed_e: []int;
    nt_mean_b: []int;
    nt_mean_e: []int;
    nt_n: int;
    nt_text: []i8;
    nt_text_n: int;
    seed: int
}

lesson_session: LessonSession = LessonSession {
    lang: -1,
    lesson: -1,
    practice: -1,
    taught_end: 0,
    small_from: 0,
    words_end: 0,
    kinds: new int[64](0),
    asks: new int[64](0),
    again: new bool[64](false),
    count: 0,
    first_count: 0,
    at: 0,
    capital: false,
    choices: new int[4](0),
    chosen: -1,
    typed: new i8[256](0i8),
    typed_n: 0,
    answer: 0,
    sound_word: -1,
    unit_b: new int[16](0),
    unit_e: new int[16](0),
    unit_right: new int[16](0),
    unit_chosen: new int[16](-1),
    unit_n: 0,
    unit_at: -1,
    choice_text: new i8[2048](0i8),
    choice_n: 0,
    choice_b: new int[64](0),
    choice_e: new int[64](0),
    nt_form_b: new int[16](0),
    nt_form_e: new int[16](0),
    nt_typed_b: new int[16](0),
    nt_typed_e: new int[16](0),
    nt_mean_b: new int[16](0),
    nt_mean_e: new int[16](0),
    nt_n: 0,
    nt_text: new i8[4096](0i8),
    nt_text_n: 0,
    seed: 1
};

// A number from 0 to n - 1, the session's own (an exercise's order, the
// names offered).
ls_random(n: int): int {
    lesson_session.seed = lesson_session.seed * 1103515245 + 12345 & 2147483647;
    if (n <= 0) 0 else (lesson_session.seed >> 8) % n
}

ls_add(kind: int, ask: int) {
    if (lesson_session.count >= EXERCISES_MOST) return;
    lesson_session.kinds[lesson_session.count] = kind;
    lesson_session.asks[lesson_session.count] = ask;
    lesson_session.again[lesson_session.count] = false;
    lesson_session.count = lesson_session.count + 1
}

// Exercises from..count shuffled.
ls_shuffle(from: int) {
    i: int = lesson_session.count - 1;
    while (i > from) {
        j: int = from + ls_random(i - from + 1);
        k: int = lesson_session.kinds[i];
        a: int = lesson_session.asks[i];
        lesson_session.kinds[i] = lesson_session.kinds[j];
        lesson_session.asks[i] = lesson_session.asks[j];
        lesson_session.kinds[j] = k;
        lesson_session.asks[j] = a;
        i = i - 1
    }
}

// How many letters' sounds a lesson asks in words, and a practice round.
SOUND_WORDS: int = 4;

PRACTICE_SOUND_WORDS: int = 5;

// How many earlier letters a lesson asks for again: enough to make eight
// names with its own, and at least three.
REVIEW_NAMES: int = 8;

REVIEW_LEAST: int = 3;

// Lesson l of course c begun: its letters' names (its own, then some of
// those before), then the same letters' sounds, then its words, each part
// in an order of its own.
lesson_begin(c: *Course, l: int) {
    lesson: CourseLesson = c.lessons[l];
    ls_reset(c.lang, l, -1, lesson.first_item + lesson.item_count, lesson.first_item,
        lesson.first_word + lesson.word_count);
    own_names: int = 0;
    for i in lesson.first_item..lesson.first_item + lesson.item_count {
        if (c.items[i].kind == ITEM_LETTER) {
            ls_add(EX_NAME, i);
            own_names = own_names + 1
        }
    }
    ls_shuffle(0);
    // (Some of the letters taught before, picked at random.)
    earlier: int = 0;
    for i in 0..lesson.first_item
        if (c.items[i].kind == ITEM_LETTER) earlier = earlier + 1;
    review: int = REVIEW_NAMES - own_names;
    if (review < REVIEW_LEAST) review = REVIEW_LEAST;
    if (review > earlier) review = earlier;
    while (review > 0) {
        k: int = ls_random(earlier);
        i: int = 0;
        while (k > 0 || c.items[i].kind != ITEM_LETTER) {
            if (c.items[i].kind == ITEM_LETTER) k = k - 1;
            i = i + 1
        }
        if (!ls_asks(EX_NAME, i)) {
            ls_add(EX_NAME, i);
            review = review - 1
        }
    }
    // (Some of the same letters again, for their sounds in words: the
    // lesson's own first, a word being a pick for each of its sounds.)
    names_end: int = lesson_session.count;
    for x in 0..names_end
        if (x < SOUND_WORDS) ls_add(EX_SOUND, lesson_session.asks[x]);
    ls_shuffle(names_end);
    words_from: int = lesson_session.count;
    for w in lesson.first_word..lesson.first_word + lesson.word_count ls_add(EX_READ,
        w);
    ls_shuffle(words_from);
    lesson_session.first_count = lesson_session.count;
    exercise_show(c)
}

// A session of language lang begun, empty: a lesson's or a practice
// round's, the letters taught and those shown small.
ls_reset(
    lang: int,
    lesson: int,
    practice: int,
    taught_end: int,
    small_from: int,
    words_end: int
) {
    lesson_session.words_end = words_end;
    lesson_session.nt_n = 0;
    lesson_session.nt_text_n = 0;
    lesson_session.lang = lang;
    lesson_session.lesson = lesson;
    lesson_session.practice = practice;
    lesson_session.taught_end = taught_end;
    lesson_session.small_from = small_from;
    lesson_session.count = 0;
    lesson_session.at = 0;
    lesson_session.seed = time(0) & 2147483647 | 1
}

// ---- practice: questions of one kind from the lessons finished ----
// How many a round asks (fewer if fewer have been taught).
PRACTICE_ROUND: int = 10;

practice_kinds: []int = [EX_NAME, EX_SOUND, EX_READ];

practice_titles: []str = ["Letter Names", "Letter Sounds", "Transliteration"];

// The kind's place in practice_kinds (-1: not one).
practice_index(kind: int): int {
    for x in 0..len(practice_kinds)
        if (practice_kinds[x] == kind) return x;
    -1
}

// Whether course c has a lesson finished (practice has something to ask).
course_any_done(c: *Course): bool {
    practice_lessons(c) > 0
}

// The lessons practice is of: those up to the furthest one finished (a
// lesson skipped before it is practised too), how many.
practice_lessons(c: *Course): int {
    n: int = 0;
    for l in 0..c.lesson_count
        if (lesson_done(c, l)) n = l + 1;
    n
}

// A practice round of kind begun: the letters of the lessons practised
// (practice_lessons'), or their words with words of the New Testament made
// only of what they teach (most of a round, once the language data has
// come), a round's worth in an order of their own; names offered from all
// the letters they teach.
practice_begin(c: *Course, language: *LanguageData, kind: int) {
    upto: int = practice_lessons(c);
    last: CourseLesson = c.lessons[if (upto > 0) upto - 1 else 0];
    ls_reset(c.lang, -1, kind, if (upto > 0) last.first_item + last.item_count else 0,
        c.item_count, if (upto > 0) last.first_word + last.word_count else 0);
    for l in 0..upto {
        lesson: CourseLesson = c.lessons[l];
        if (kind == EX_READ) {
            for w in lesson.first_word..lesson.first_word + lesson.word_count ls_add(EX_READ,
                w)
        } else {
            for i in lesson.first_item..lesson.first_item + lesson.item_count
                if (c.items[i].kind == ITEM_LETTER) ls_add(kind, i)
        }
    }
    ls_shuffle(0);
    if (kind == EX_READ) {
        // (A few of the course's words, the rest the New Testament's.)
        if (lesson_session.count > PRACTICE_COURSE_WORDS) lesson_session.count = PRACTICE_COURSE_WORDS;
        nt_words_add(c, language, PRACTICE_ROUND - lesson_session.count);
        ls_shuffle(0)
    }
    most: int = if (kind == EX_SOUND) PRACTICE_SOUND_WORDS else PRACTICE_ROUND;
    if (lesson_session.count > most) lesson_session.count = most;
    lesson_session.first_count = lesson_session.count;
    exercise_show(c)
}

// How many of a transliteration round are the course's own words.
PRACTICE_COURSE_WORDS: int = 3;

// ---- practice's words from the New Testament ----
// The first word of each distinct Greek form of the language data's text,
// made once for the data (nt_made_for: its word count; -1, not yet). The
// New Testament has about 20,000 forms; past NT_FORMS_MOST, practice
// draws from the first ones only.
NT_FORMS_MOST: int = 32768;

nt_firsts: []int = new int[32768](0);

nt_firsts_n: int = 0;

nt_made_for: int = -1;

nt_firsts_ensure(language: *LanguageData) {
    if (!language.ready || nt_made_for == language.word_count) return;
    nt_firsts_n = 0;
    region {
        seen: []bool = new bool[language.form_count + 1](false);
        for w in 0..language.word_count {
            if (w_greek(language, w)) {
                f: int = w_form(language, w);
                if (f >= 0 && f < language.form_count && !seen[f] && nt_firsts_n < NT_FORMS_MOST) {
                    seen[f] = true;
                    nt_firsts[nt_firsts_n] = w;
                    nt_firsts_n = nt_firsts_n + 1
                }
            }
        }
    }
    nt_made_for = language.word_count
}

// What the lessons finished teach, for choosing words of the New
// Testament: their letters, and whether the rough breathing (a sign shown
// with it) and γ said as n (a sign shown as γγ) are taught.
nt_taught: []bool = new bool[128](false);

nt_rough: bool = false;

nt_nasal: bool = false;

nt_taught_make(c: *Course) {
    for k in 0..len(nt_taught) nt_taught[k] = false;
    nt_rough = false;
    nt_nasal = false;
    for l in 0..practice_lessons(c) {
        lesson: CourseLesson = c.lessons[l];
        for i in lesson.first_item..lesson.first_item + lesson.item_count {
            item: CourseItem = c.items[i];
            last: int = 0;
            p: int = item.forms_b;
            while (p < item.forms_e) {
                cp: int = cp_at(c.text, p, item.forms_e);
                k: int = course_letter(c.lang, cp);
                if (item.kind == ITEM_LETTER && k > 0) nt_taught[k] = true;
                if (item.kind == ITEM_SIGN && (greek_info(cp) & GREEK_ROUGH) != 0) nt_rough = true;
                if (item.kind == ITEM_SIGN && k == GREEK_GAMMA && last == GREEK_GAMMA) nt_nasal = true;
                last = k;
                p = p + cp_len
            }
        }
    }
}

GREEK_ROUGH: int = 32;

// Whether a code point has an iota written under it (ᾳ ῃ ῳ, with their
// breathings and accents; the combining mark): not said, and left out of
// a transliteration, which no lesson teaches yet, so such forms are not
// practised.
greek_iota_under(cp: int): bool {
    cp == 837 || cp >= 8064 && cp <= 8111 || cp >= 8114 && cp <= 8116 || cp == 8119 || cp == 8124 || cp >= 8130 && cp <= 8132 || cp == 8135 || cp == 8140 || cp >= 8178 && cp <= 8180 || cp == 8183 || cp == 8188
}

GREEK_GAMMA: int = 3;

// Whether a form (language.forms from b to e) is made only of what is
// taught: its letters, a rough breathing, a γ before γ, κ, ξ or χ.
nt_form_taught(language: *LanguageData, b: int, e: int): bool {
    last: int = 0;
    p: int = b;
    while (p < e) {
        cp: int = cp_at(language.forms, p, e);
        k: int = course_letter(0, cp);
        if (k > 0 && !nt_taught[k]) return false;
        if ((greek_info(cp) & GREEK_ROUGH) != 0 && !nt_rough) return false;
        if (greek_iota_under(cp)) return false;
        if (last == GREEK_GAMMA && (k == 3 || k == 10 || k == 14 || k == 22) && !nt_nasal) return false;
        if (k > 0) last = k;
        p = p + cp_len
    }
    true
}

// Up to n words of the New Testament added to the round, picked from its
// distinct forms made only of what is taught, each with its
// transliteration and its lemma's meaning (copied into the session).
nt_words_add(c: *Course, language: *LanguageData, n: int) {
    if (c.lang != 0 || n <= 0 || !language.ready) return;
    nt_firsts_ensure(language);
    if (nt_firsts_n == 0) return;
    nt_taught_make(c);
    added: int = 0;
    tries: int = 0;
    while (added < n && tries < 4000 && lesson_session.nt_n < len(lesson_session.nt_form_b)) {
        tries = tries + 1;
        w: int = nt_firsts[ls_random(nt_firsts_n)];
        form_of(language, w);
        if (wt_e > wt_b && nt_form_taught(language, wf_b, wf_e) && !nt_has_form(language,
            wf_b, wf_e) && nt_copy(language, w)) {
            ls_add(EX_READ, -1 - (lesson_session.nt_n - 1));
            added = added + 1
        }
    }
}

// Whether the round has the form language.forms[b..e) already.
nt_has_form(language: *LanguageData, b: int, e: int): bool {
    for k in 0..lesson_session.nt_n {
        if (lesson_session.nt_form_e[k] - lesson_session.nt_form_b[k] == e - b) {
            same: bool = true;
            for x in 0..e - b
                if (lesson_session.nt_text[lesson_session.nt_form_b[k] + x] != language.forms[b + x]) same = false;
            if (same) return true
        }
    }
    false
}

// Word w's form, transliteration (form_of's) and meaning (its lemma's
// gloss, before any colon) copied into the session: whether they fit.
nt_copy(language: *LanguageData, w: int): bool {
    k: int = lesson_session.nt_n;
    at: int = lesson_session.nt_text_n;
    gb: int = 0;
    ge: int = 0;
    p: int = lex_first(language, true, w_strongs(language, w));
    if (p >= 0) {
        lex_field(language, p, 3);
        gb = lf_b;
        ge = lf_b;
        while (ge < lf_e && language.lexicon[ge] as int != 58) ge = ge + 1;
        while (ge > gb && language.lexicon[ge - 1] as int == 32) ge = ge - 1
    }
    if (at + (wf_e - wf_b) + (wt_e - wt_b) + (ge - gb) > len(lesson_session.nt_text)) return false;
    lesson_session.nt_form_b[k] = lesson_session.nt_text_n;
    nt_put(language.forms, wf_b, wf_e);
    lesson_session.nt_form_e[k] = lesson_session.nt_text_n;
    lesson_session.nt_typed_b[k] = lesson_session.nt_text_n;
    nt_put(language.forms, wt_b, wt_e);
    lesson_session.nt_typed_e[k] = lesson_session.nt_text_n;
    lesson_session.nt_mean_b[k] = lesson_session.nt_text_n;
    nt_put(language.lexicon, gb, ge);
    lesson_session.nt_mean_e[k] = lesson_session.nt_text_n;
    lesson_session.nt_n = k + 1;
    true
}

nt_put(b: []i8, from: int, to: int) {
    for x in from..to {
        lesson_session.nt_text[lesson_session.nt_text_n] = b[x];
        lesson_session.nt_text_n = lesson_session.nt_text_n + 1
    }
}

// ---- a letter's sound asked in a word: how the word is said ----
// A word read as the units of its sound, each a reading's decision: a
// letter, or a pair taught as said as one (ου, γγ: a sign with a Said),
// with a rough breathing (once taught) said before it. Each unit is asked
// four ways: its Said; its letter's likely mistakes (its Mistaken); then
// other letters' sounds of its kind (a vowel's for a vowel, those taught
// first); a rough breathing's unit also without its h, an initial vowel
// with one it hasn't (once the breathings are taught).
UNITS_MOST: int = 16;

// Whether item i's sound is a vowel's (its Said begins with one, an h
// aside).
said_vowel(c: *Course, b: int, e: int): bool {
    p: int = b;
    if (p < e && ascii_lower(c.text[p] as int) == 104 && e - p > 1) p = p + 1;
    if (p >= e) return false;
    k: int = ascii_lower(c.text[p] as int);
    k == 97 || k == 101 || k == 105 || k == 111 || k == 117 || k == 121
}

ascii_lower(k: int): int {
    if (k >= 65 && k <= 90) k + 32 else k
}

// The letter item i teaches (its first form's).
item_letter(c: *Course, i: int): int {
    course_letter(c.lang, cp_at(c.text, c.items[i].forms_b, c.items[i].forms_e))
}

// The letter item teaching letter k among those before end (-1: none).
letter_item_before(c: *Course, k: int, end: int): int {
    for i in 0..end
        if (c.items[i].kind == ITEM_LETTER && item_letter(c, i) == k) return i;
    -1
}

// The sign said as one pair (before end) whose letters are k1 then k2
// (-1: none), and whether a rough breathing is taught before end (its
// sign's index; -1 none).
pair_item_before(
    c: *Course,
    k1: int,
    k2: int,
    end: int
): int {
    for i in 0..end {
        item: CourseItem = c.items[i];
        if (item.kind == ITEM_SIGN && item.said_e > item.said_b) {
            a: int = cp_at(c.text, item.forms_b, item.forms_e);
            n: int = cp_len;
            if (item.forms_b + n < item.forms_e && course_letter(c.lang, a) == k1 && course_letter(c.lang,
                cp_at(c.text, item.forms_b + n, item.forms_e)) == k2 && item.forms_b + n + cp_len == item.forms_e) return i
        }
    }
    -1
}

rough_item_before(c: *Course, end: int): int {
    for i in 0..end {
        item: CourseItem = c.items[i];
        if (item.kind == ITEM_SIGN && item.said_e > item.said_b && (greek_info(cp_at(c.text,
            item.forms_b, item.forms_e)) & GREEK_ROUGH) != 0) return i
    }
    -1
}

// Word w's units into the session (unit_b, unit_e), each with its item
// (unit_item) and whether it takes a rough breathing (unit_h), as the
// items before end teach it to be read: how many, or 0 if a letter of it
// has no sound to offer.
unit_at_b: []int = new int[16](0);

unit_at_e: []int = new int[16](0);

unit_item: []int = new int[16](0);

unit_h: []bool = new bool[16](false);

word_units(c: *Course, w: int, end: int): int {
    word: CourseWord = c.words[w];
    rough: int = rough_item_before(c, end);
    n: int = 0;
    p: int = word.word_b;
    while (p < word.word_e) {
        cp: int = cp_at(c.text, p, word.word_e);
        len1: int = cp_len;
        k: int = course_letter(c.lang, cp);
        if (k == 0) p = p + len1 else {
            if (n >= UNITS_MOST) return 0;
            q: int = p + len1;
            has_rough: bool = (greek_info(cp) & GREEK_ROUGH) != 0;
            item: int = -1;
            if (q < word.word_e) {
                cp2: int = cp_at(c.text, q, word.word_e);
                len2: int = cp_len;
                k2: int = course_letter(c.lang, cp2);
                if (k2 != 0 && (greek_info(cp2) & GREEK_DIAERESIS) == 0) {
                    pair: int = pair_item_before(c, k, k2, end);
                    if (pair >= 0) {
                        item = pair;
                        if ((greek_info(cp2) & GREEK_ROUGH) != 0) has_rough = true;
                        q = q + len2
                    }
                }
            }
            if (item < 0) item = letter_item_before(c, k, end);
            if (item < 0 || c.items[item].said_e <= c.items[item].said_b) return 0;
            unit_at_b[n] = p;
            unit_at_e[n] = q;
            unit_item[n] = item;
            unit_h[n] = has_rough && rough >= 0;
            n = n + 1;
            p = q
        }
    }
    n
}

GREEK_DIAERESIS: int = 64;

// The end of item i's first spelling in its Said (the sound on its tile;
// the others, ones a word's pronunciation may use: epsilon's "e" beside "eh").
said_first_end(c: *Course, i: int): int {
    f: int = c.items[i].said_b;
    while (f < c.items[i].said_e && c.text[f] as int != 32) f = f + 1;
    f
}

// Whether word w's pronunciation (its Said, hyphens and case aside) is its
// n units' sounds (word_units'), each one of its item's spellings, after
// an h for a rough breathing.
said_spells_units(c: *Course, w: int, n: int): bool {
    word: CourseWord = c.words[w];
    p: int = word.said_b;
    for u in 0..n {
        p = said_skip_hyphens(c, p, word.said_e);
        if (unit_h[u]) {
            if (p >= word.said_e || ascii_lower(c.text[p] as int) != 104) return false;
            p = said_skip_hyphens(c, p + 1, word.said_e)
        }
        // (The longest of its spellings that is there.)
        item: CourseItem = c.items[unit_item[u]];
        best: int = -1;
        q: int = item.said_b;
        while (q < item.said_e) {
            f: int = q;
            while (f < item.said_e && c.text[f] as int != 32) f = f + 1;
            e: int = said_match_at(c, p, word.said_e, q, f);
            if (e > best) best = e;
            q = f + 1
        }
        if (best < 0) return false;
        p = best
    }
    said_skip_hyphens(c, p, word.said_e) == word.said_e
}

said_skip_hyphens(c: *Course, p: int, e: int): int {
    q: int = p;
    while (q < e && c.text[q] as int == 45) q = q + 1;
    q
}

// Where spelling text[b..f) ends if the pronunciation has it at p (any
// case, hyphens between its letters allowed), else -1.
said_match_at(
    c: *Course,
    p: int,
    e: int,
    b: int,
    f: int
): int {
    q: int = p;
    for x in b..f {
        q = said_skip_hyphens(c, q, e);
        if (q >= e || ascii_lower(c.text[q] as int) != ascii_lower(c.text[x] as int)) return -1;
        q = q + 1
    }
    q
}

// Option o of unit u in choice_text: the h first if with_h, then text
// b..e; whether it is new among the unit's options before it.
unit_option(
    c: *Course,
    u: int,
    o: int,
    with_h: bool,
    b: int,
    e: int
): bool {
    x: int = u * CHOICES + o;
    at: int = lesson_session.choice_n;
    n: int = at;
    if (n + (e - b) + 1 > len(lesson_session.choice_text)) return false;
    // (A breathing's h: on the right one (a rho's too: hr), and on a
    // vowel's sound among the wrong ones; not a consonant's, as "hn".)
    if (with_h && (o == 0 || said_vowel(c, b, e))) {
        lesson_session.choice_text[n] = 104i8;
        n = n + 1
    }
    for q in b..e {
        lesson_session.choice_text[n] = c.text[q];
        n = n + 1
    }
    for y in u * CHOICES..x {
        if (lesson_session.choice_e[y] - lesson_session.choice_b[y] == n - at) {
            same: bool = true;
            for q in 0..n - at
                if (lesson_session.choice_text[lesson_session.choice_b[y] + q] != lesson_session.choice_text[at + q]) same = false;
            if (same) return false
        }
    }
    lesson_session.choice_b[x] = at;
    lesson_session.choice_e[x] = n;
    lesson_session.choice_n = n;
    true
}

// Unit u's four options made, in an order of their own: false if four
// can't be found.
unit_options(c: *Course, u: int): bool {
    item: CourseItem = c.items[unit_item[u]];
    said_e: int = said_first_end(c, unit_item[u]);
    h: bool = unit_h[u];
    n: int = 0;
    if (unit_option(c, u, n, h, item.said_b, said_e)) n = n + 1;
    // (The breathing's branch: without its h; or, with one taught, an
    // initial vowel with an h it hasn't.)
    rough_taught: bool = rough_item_before(c, lesson_session.taught_end) >= 0;
    first: bool = lesson_session.unit_b[u] == c.words[lesson_session.sound_word].word_b;
    vowel: bool = said_vowel(c, item.said_b, said_e);
    if (h && unit_option(c, u, n, false, item.said_b, said_e)) n = n + 1;
    if (!h && rough_taught && first && vowel && unit_option(c, u, n, true, item.said_b,
        said_e)) n = n + 1;
    // (Its likely mistakes.)
    q: int = item.mistaken_b;
    while (q < item.mistaken_e && n < CHOICES) {
        f: int = q;
        while (f < item.mistaken_e && c.text[f] as int != 32) f = f + 1;
        if (unit_option(c, u, n, h, q, f)) n = n + 1;
        q = f + 1
    }
    // (Other letters' sounds of its kind, those taught first.)
    tries: int = 0;
    while (n < CHOICES && tries < 400) {
        pool: int = if (tries < 200) lesson_session.taught_end else c.item_count;
        j: int = ls_random(pool);
        other: CourseItem = c.items[j];
        if (other.kind == ITEM_LETTER && j != unit_item[u] && other.said_e > other.said_b && said_vowel(c,
            other.said_b, said_first_end(c, j)) == vowel && unit_option(c, u, n, h,
            other.said_b, said_first_end(c, j))) n = n + 1;
        tries = tries + 1
    }
    if (n < CHOICES) return false;
    // (The right one, option 0, put in a place of its own.)
    x: int = ls_random(CHOICES);
    b: int = lesson_session.choice_b[u * CHOICES];
    e: int = lesson_session.choice_e[u * CHOICES];
    lesson_session.choice_b[u * CHOICES] = lesson_session.choice_b[u * CHOICES + x];
    lesson_session.choice_e[u * CHOICES] = lesson_session.choice_e[u * CHOICES + x];
    lesson_session.choice_b[u * CHOICES + x] = b;
    lesson_session.choice_e[u * CHOICES + x] = e;
    lesson_session.unit_right[u] = x;
    lesson_session.unit_chosen[u] = -1;
    true
}

// Whether word w has letter k.
word_has_letter(c: *Course, w: int, k: int): bool {
    word: CourseWord = c.words[w];
    p: int = word.word_b;
    while (p < word.word_e) {
        if (course_letter(c.lang, cp_at(c.text, p, word.word_e)) == k) return true;
        p = p + cp_len
    }
    false
}

// Letter item target's sound asked in a word: one of the words taught
// with the letter (and a pronunciation to show), its units each asked
// four ways, the first chosen for first. False if no word will do.
said_question(c: *Course, target: int): bool {
    k: int = item_letter(c, target);
    fits: int = 0;
    for w in 0..lesson_session.words_end
        if (c.words[w].said_e > c.words[w].said_b && word_has_letter(c, w, k)) fits = fits + 1;
    tries: int = 0;
    while (fits > 0 && tries < 8) {
        tries = tries + 1;
        pick: int = ls_random(fits);
        w: int = 0;
        while (pick > 0 || !(c.words[w].said_e > c.words[w].said_b && word_has_letter(c,
            w, k))) {
            if (c.words[w].said_e > c.words[w].said_b && word_has_letter(c, w, k)) pick = pick - 1;
            w = w + 1
        }
        lesson_session.sound_word = w;
        lesson_session.unit_n = word_units(c, w, lesson_session.taught_end);
        for u in 0..lesson_session.unit_n {
            lesson_session.unit_b[u] = unit_at_b[u];
            lesson_session.unit_e[u] = unit_at_e[u]
        }
        lesson_session.choice_n = 0;
        ok: bool = lesson_session.unit_n > 0;
        for u in 0..lesson_session.unit_n
            if (ok && !unit_options(c, u)) ok = false;
        if (ok) {
            lesson_session.unit_at = 0;
            return true
        }
    }
    lesson_session.sound_word = -1;
    false
}

// A unit's option picked: the next unit without one chosen for (-1: every
// one has one).
unit_picked(o: int) {
    u: int = lesson_session.unit_at;
    if (u < 0 || u >= lesson_session.unit_n || o < 0 || o >= CHOICES) return;
    lesson_session.unit_chosen[u] = o;
    lesson_session.unit_at = -1;
    for d in 1..lesson_session.unit_n + 1 {
        v: int = (u + d) % lesson_session.unit_n;
        if (lesson_session.unit_at < 0 && lesson_session.unit_chosen[v] < 0) lesson_session.unit_at = v
    }
}

// Whether every unit has an option chosen.
units_chosen(): bool {
    for u in 0..lesson_session.unit_n
        if (lesson_session.unit_chosen[u] < 0) return false;
    true
}

// Whether every unit's chosen option is right.
units_right(): bool {
    for u in 0..lesson_session.unit_n
        if (lesson_session.unit_chosen[u] != lesson_session.unit_right[u]) return false;
    true
}

// The exercise at lesson_session.at made ready to be answered: a letter's
// form chosen and its names offered (it and three others, those taught by
// this lesson or before it first), or the typing begun.
exercise_show(c: *Course) {
    lesson_session.answer = ANSWER_NONE;
    lesson_session.chosen = -1;
    lesson_session.typed_n = 0;
    lesson_session.sound_word = -1;
    if (lesson_session.at >= lesson_session.count) return;
    if (lesson_session.kinds[lesson_session.at] == EX_READ) return;
    target: int = lesson_session.asks[lesson_session.at];
    if (lesson_session.kinds[lesson_session.at] == EX_SOUND && said_question(c, target)) return;
    // (A lesson's own letter is shown small; one from before, either way.)
    lesson_session.capital = target < lesson_session.small_from && ls_random(2) == 0;
    taught_end: int = lesson_session.taught_end;
    lesson_session.choices[0] = target;
    n: int = 1;
    tries: int = 0;
    while (n < CHOICES && tries < 1000) {
        // (Letters taught so far, while there are enough of them; then any.)
        pool: int = if (ls_letters_before(c, taught_end) >= CHOICES) taught_end else c.item_count;
        i: int = ls_random(pool);
        if (c.items[i].kind == ITEM_LETTER && !ls_offered(i, n)) {
            lesson_session.choices[n] = i;
            n = n + 1
        }
        tries = tries + 1
    }
    // (The answer in a place of its own.)
    k: int = ls_random(n);
    lesson_session.choices[0] = lesson_session.choices[k];
    lesson_session.choices[k] = target
}

// Whether the session has an exercise of kind asking for ask.
ls_asks(kind: int, ask: int): bool {
    for x in 0..lesson_session.count
        if (lesson_session.kinds[x] == kind && lesson_session.asks[x] == ask) return true;
    false
}

ls_letters_before(c: *Course, end: int): int {
    n: int = 0;
    for i in 0..end
        if (c.items[i].kind == ITEM_LETTER) n = n + 1;
    n
}

ls_offered(item: int, n: int): bool {
    for x in 0..n
        if (lesson_session.choices[x] == item) return true;
    false
}

// The exercise shown's number among those asked the first time.
ls_first_number(): int {
    n: int = 0;
    for x in 0..lesson_session.at + 1
        if (!lesson_session.again[x]) n = n + 1;
    n
}

// Whether the session is the one screen at shows (a lesson's exercises,
// or a practice round), and going.
ls_shows(at: int): bool {
    lang: int = sk_args[at] / LESSONS_MOST;
    n: int = sk_args[at] % LESSONS_MOST;
    if (lesson_session.lang != lang || lesson_session.count == 0) return false;
    if (sk_kinds[at] == SCR_PRACTICE_ROUND) lesson_session.practice == n else lesson_session.lesson == n && lesson_session.practice < 0
}

// An exercise answered: right, or wrong (then it comes again, once: a
// letter's name before the words begin, a word at the end, so that the
// typing goes on with the keyboard up).
exercise_answered(right: bool) {
    lesson_session.answer = (if (right) ANSWER_RIGHT else ANSWER_WRONG);
    at: int = lesson_session.at;
    if (right || lesson_session.again[at] || lesson_session.count >= EXERCISES_MOST) return;
    kind: int = lesson_session.kinds[at];
    place: int = lesson_session.count;
    if (kind != EX_READ) {
        place = at + 1;
        while (place < lesson_session.count && lesson_session.kinds[place] == kind) place = place + 1
    }
    x: int = lesson_session.count;
    while (x > place) {
        lesson_session.kinds[x] = lesson_session.kinds[x - 1];
        lesson_session.asks[x] = lesson_session.asks[x - 1];
        lesson_session.again[x] = lesson_session.again[x - 1];
        x = x - 1
    }
    lesson_session.kinds[place] = kind;
    lesson_session.asks[place] = lesson_session.asks[at];
    lesson_session.again[place] = true;
    lesson_session.count = lesson_session.count + 1
}

// ---- a word's answer ----
// What was typed matches one of what the word may be typed as: letters
// compared without their case, a line over a vowel (ē, ō) not needed,
// spaces, hyphens and apostrophes left out.
typed_matches(c: *Course, w: int): bool {
    if (w < 0) {
        k: int = -1 - w;
        return letters_match(lesson_session.typed, 0, lesson_session.typed_n, lesson_session.nt_text,
            lesson_session.nt_typed_b[k], lesson_session.nt_typed_e[k])
    }
    word: CourseWord = c.words[w];
    p: int = word.typed_b;
    while (p <= word.typed_e) {
        e: int = p;
        while (e < word.typed_e && c.text[e] as int != 124) e = e + 1;
        if (letters_match(lesson_session.typed, 0, lesson_session.typed_n, c.text,
            p, e)) return true;
        p = e + 1
    }
    false
}

// Whether a[ab..ae) and b[bb..be) are the same letters (as typed_matches
// compares them).
letters_match(
    a: []i8,
    ab: int,
    ae: int,
    b: []i8,
    bb: int,
    be: int
): bool {
    p: int = ab;
    q: int = bb;
    more: bool = true;
    while (more) {
        x: int = 0;
        while (p < ae && x == 0) {
            x = typed_fold(cp_at(a, p, ae));
            p = p + cp_len
        }
        y: int = 0;
        while (q < be && y == 0) {
            y = typed_fold(cp_at(b, q, be));
            q = q + cp_len
        }
        if (x != y) return false;
        if (x == 0) more = false
    }
    true
}

// A typed code point as compared: a Latin letter lower case, a vowel
// without its line (ā ē ī ō ū ȳ, either case), y as u (υ is written y
// alone, u in a pair: either is accepted), 0 for what is left out (a
// space, a hyphen, an apostrophe, a full stop); anything else as it is.
typed_fold(cp: int): int {
    if (cp == 89 || cp == 121) return 117;
    if (cp >= 65 && cp <= 90) return cp + 32;
    if (cp == 32 || cp == 45 || cp == 39 || cp == 46 || cp == 8217) return 0;
    if (cp == 256 || cp == 257) return 97;
    if (cp == 274 || cp == 275) return 101;
    if (cp == 298 || cp == 299) return 105;
    if (cp == 332 || cp == 333) return 111;
    if (cp == 362 || cp == 363) return 117;
    if (cp == 562 || cp == 563) return 117;
    cp
}

// A word's first typed form (as it is written in English letters), into
// fbuf.
fput_word_typed(c: *Course, w: int) {
    if (w < 0) {
        k: int = -1 - w;
        fput_bytes(lesson_session.nt_text, lesson_session.nt_typed_b[k], lesson_session.nt_typed_e[k]);
        return
    }
    word: CourseWord = c.words[w];
    e: int = word.typed_b;
    while (e < word.typed_e && c.text[e] as int != 124) e = e + 1;
    fput_bytes(c.text, word.typed_b, e)
}

// ---- the screens ----
// A screen of the course (skin.l8's sk_build): language lang's lessons; a
// lesson; its exercises.
sk_build_lessons_screen(
    language: *LanguageData,
    id: int,
    kind: int,
    arg: int
) {
    lang: int = if (kind == SCR_COURSE) arg else arg / LESSONS_MOST;
    if (lang < 0 || lang >= len(courses)) {
        ui_begin(id, kind, arg, "");
        return
    }
    borrow courses[lang] as c {
        l: int = arg % LESSONS_MOST;
        if (kind == SCR_COURSE) sk_build_course(c, id) else if (kind == SCR_PRACTICE_ROUND) sk_build_practice_round(c,
            language, id, l) else if (l >= c.lesson_count) ui_begin(id, kind, arg,
            "") else if (kind == SCR_LESSON) sk_build_lesson(c, id, l) else sk_build_exercise(c,
            id, l)
    }
}

// The language's name, as its screen's title.
course_names: []str = ["Greek", "Hebrew"];

// Its lessons, each its title over the letters it teaches; those finished
// say so; the next one stressed, and begun from the foot.
sk_build_course(c: *Course, id: int) {
    ui_begin(id, SCR_COURSE, c.lang, course_names[c.lang]);
    fbuf_n = 0;
    fput_str("Learn to read ");
    fput_str(course_names[c.lang]);
    fput_str(" a few letters at a time. Each lesson explains its letters, asks their names and sounds, then has you write words in English letters.");
    ui_set_intro_fbuf();
    next: int = lesson_next(c);
    ui_section("The Alphabet", "");
    for l in 0..c.lesson_count {
        lesson: CourseLesson = c.lessons[l];
        ui_row(UI_ITEM, ACT_LESSON_OPEN, l);
        fbuf_n = 0;
        fput_bytes(c.text, lesson.title_b, lesson.title_e);
        ui_set_title_fbuf();
        ui_rich_begin();
        fput_lesson_letters(c, l);
        ui_rich(course_script(c.lang));
        ui_rich_detail();
        if (lesson_done(c, l)) {
            fbuf_n = 0;
            fput_str("Done");
            ui_set_trailing_fbuf()
        }
        if (l == next) ui_set_strong();
        ui_set_acc(ACC_MORE);
        // "Lesson 1, Six Familiar Letters: α ε ι ο κ τ. Done."
        fbuf_n = 0;
        fput_str("Lesson ");
        fput_int(l + 1);
        fput_str(", ");
        fput_bytes(c.text, lesson.title_b, lesson.title_e);
        fput_str(": ");
        fput_lesson_letters(c, l);
        fput(46);
        if (lesson_done(c, l)) fput_str(" Done.");
        ui_set_label_fbuf()
    }
    // (Practice: a round of one kind of question, once a lesson is
    // finished.)
    any: bool = course_any_done(c);
    ui_section("Practice", if (any) "Questions from the lessons you have finished." else "After your first lesson, practise what it taught here.");
    for x in 0..len(practice_kinds) {
        ui_row(UI_ITEM, if (any) ACT_PRACTICE_BEGIN else 0, practice_kinds[x]);
        ui_set_title(practice_titles[x]);
        if (any) ui_set_acc(ACC_MORE) else ui_set_disabled(true)
    }
    if (next >= 0) {
        ui_tool("", "", ACT_LESSON_OPEN, next, UI_TOOL_PROMINENT, 1);
        fbuf_n = 0;
        fput_str(if (next == 0) "Begin with Lesson " else "Go On to Lesson ");
        fput_int(next + 1);
        ui_set_tool_title_fbuf()
    }
}

// What lesson l teaches, as the course's list shows it: each letter's
// small forms and each sign, by spaces ("α ε ι ο κ τ"), into fbuf.
fput_lesson_letters(c: *Course, l: int) {
    lesson: CourseLesson = c.lessons[l];
    for i in lesson.first_item..lesson.first_item + lesson.item_count {
        if (i > lesson.first_item) fput(32);
        fput_item_small(c, i)
    }
}

// An item's small forms (a letter's: those after its capital), or a
// sign as it is shown.
fput_item_small(c: *Course, i: int) {
    item: CourseItem = c.items[i];
    b: int = item.forms_b;
    if (item.kind == ITEM_LETTER) {
        while (b < item.forms_e && c.text[b] as int != 32) b = b + 1;
        if (b < item.forms_e) b = b + 1 else b = item.forms_b
    }
    fput_bytes(c.text, b, item.forms_e)
}

// An item's capital (a letter's first form), into fbuf.
fput_item_capital(c: *Course, i: int) {
    item: CourseItem = c.items[i];
    e: int = item.forms_b;
    while (e < item.forms_e && c.text[e] as int != 32) e = e + 1;
    fput_bytes(c.text, item.forms_b, e)
}

// Its explanation, its letters (each its forms, name, sound and what it
// is typed as) and its signs; its exercises begun from the foot.
sk_build_lesson(c: *Course, id: int, l: int) {
    lesson: CourseLesson = c.lessons[l];
    ui_begin(id, SCR_LESSON, c.lang * LESSONS_MOST + l, "");
    fbuf_n = 0;
    fput_bytes(c.text, lesson.title_b, lesson.title_e);
    ui_set_screen_title_fbuf();
    fbuf_n = 0;
    fput_str("Lesson ");
    fput_int(l + 1);
    fput_str(" of ");
    fput_int(c.lesson_count);
    ui_set_subtitle_fbuf();
    ui_section("", "");
    for a in lesson.first_para..lesson.first_para + lesson.para_count sk_course_para(c,
        a);
    letters: bool = false;
    signs: bool = false;
    for i in lesson.first_item..lesson.first_item + lesson.item_count {
        if (c.items[i].kind == ITEM_LETTER) letters = true else signs = true
    }
    if (letters) {
        ui_section("Letters", "");
        for i in lesson.first_item..lesson.first_item + lesson.item_count
            if (c.items[i].kind == ITEM_LETTER) sk_item_row(c, i)
    }
    if (signs) {
        ui_section("Marks and Pairs", "");
        for i in lesson.first_item..lesson.first_item + lesson.item_count
            if (c.items[i].kind == ITEM_SIGN) sk_item_row(c, i)
    }
    ui_tool("", "", ACT_LESSON_BEGIN, l, UI_TOOL_PROMINENT, 1);
    fbuf_n = 0;
    fput_str(if (lesson_done(c, l)) "Practise Again" else "Begin the Exercises");
    ui_set_tool_title_fbuf()
}

// A paragraph of the explanation: its _italic_ words in italic, its Greek
// or Hebrew in the script's face.
sk_course_para(c: *Course, a: int) {
    para: CoursePara = c.paras[a];
    ui_row(UI_TEXT, 0, a);
    ui_rich_begin();
    italic: bool = false;
    style: int = RUN_PLAIN;
    p: int = para.b;
    while (p < para.e) {
        cp: int = cp_at(c.text, p, para.e);
        n: int = cp_len;
        if (cp == 95) {
            if (fbuf_n > 0) ui_rich(style);
            italic = !italic;
            style = (if (italic) RUN_ITALIC else RUN_PLAIN)
        } else {
            // (A run of the script's letters and the marks on them; a space
            // or punctuation goes with the words around it.)
            want: int = if (course_letter(c.lang, cp) != 0) course_script(c.lang) else if (cp == 32 || cp < 128 && !is_letter(cp)) style else if (italic) RUN_ITALIC else RUN_PLAIN;
            if (want != style) {
                ui_rich(style);
                style = want
            }
            fbuf_n = cp_put(fbuf, fbuf_n, cp)
        }
        p = p + n
    }
    ui_rich(style);
    ui_rich_title()
}

// A letter's or sign's row: its forms in a column of their own, its name
// over its sound, and what it is typed as at its end.
sk_item_row(c: *Course, i: int) {
    item: CourseItem = c.items[i];
    ui_row(UI_ITEM, 0, i);
    fbuf_n = 0;
    fput_bytes(c.text, item.forms_b, item.forms_e);
    ui_set_lead_fbuf(course_script(c.lang));
    fbuf_n = 0;
    fput_bytes(c.text, item.name_b, item.name_e);
    ui_set_title_fbuf();
    fbuf_n = 0;
    fput_bytes(c.text, item.sound_b, item.sound_e);
    ui_set_detail_fbuf();
    if (item.typed_e > item.typed_b) {
        ui_rich_begin();
        fput_bytes(c.text, item.typed_b, item.typed_e);
        ui_rich(RUN_TRANSLIT);
        ui_rich_side()
    }
    // "Alpha, written a: a as in father."
    fbuf_n = 0;
    fput_bytes(c.text, item.name_b, item.name_e);
    if (item.typed_e > item.typed_b) {
        fput_str(", written ");
        fput_bytes(c.text, item.typed_b, item.typed_e)
    }
    fput_str(": ");
    fput_bytes(c.text, item.sound_b, item.sound_e);
    fput(46);
    ui_set_label_fbuf()
}

// The exercise shown (a session of this lesson begun, if none is), or the
// lesson's end.
sk_build_exercise(c: *Course, id: int, l: int) {
    if (!(lesson_session.lang == c.lang && lesson_session.lesson == l && lesson_session.practice < 0 && lesson_session.count > 0)) lesson_begin(c,
        l);
    lesson: CourseLesson = c.lessons[l];
    ui_begin(id, SCR_EXERCISE, c.lang * LESSONS_MOST + l, "");
    fbuf_n = 0;
    fput_bytes(c.text, lesson.title_b, lesson.title_e);
    ui_set_screen_title_fbuf();
    if (lesson_session.at >= lesson_session.count) {
        sk_build_lesson_end(c, l);
        return
    }
    sk_build_question(c)
}

// A practice round's question (a round of its kind begun, if none is), or
// its end: Practise Again.
sk_build_practice_round(
    c: *Course,
    language: *LanguageData,
    id: int,
    kind: int
) {
    x: int = practice_index(kind);
    if (x < 0) {
        ui_begin(id, SCR_PRACTICE_ROUND, c.lang * LESSONS_MOST + kind, "");
        return
    }
    if (!(lesson_session.lang == c.lang && lesson_session.practice == kind && lesson_session.count > 0)) practice_begin(c,
        language, kind);
    ui_begin(id, SCR_PRACTICE_ROUND, c.lang * LESSONS_MOST + kind, practice_titles[x]);
    if (lesson_session.first_count == 0) {
        ui_set_empty("checkmark.circle", "Nothing to Practise Yet", "The lessons you have finished teach no letters of this kind.");
        return
    }
    if (lesson_session.at >= lesson_session.count) {
        fbuf_n = 0;
        fput_str("You answered ");
        fput_int(lesson_session.first_count);
        fput_str(if (lesson_session.first_count == 1) " question." else " questions.");
        ui_set_empty("checkmark.circle", "Practice Finished", "");
        ui_empty_line = ui_put_fbuf();
        ui_tool("Practise Again", "", ACT_PRACTICE_BEGIN, kind, UI_TOOL_PROMINENT,
            1);
        return
    }
    sk_build_question(c)
}

// The question shown: its count ("3 of 14", or "Once more" for one
// answered wrong before), then a letter's choice or a word to write.
sk_build_question(c: *Course) {
    fbuf_n = 0;
    if (lesson_session.again[lesson_session.at]) fput_str("Once more") else fput_count_of(ls_first_number(),
        lesson_session.first_count);
    ui_set_subtitle_fbuf();
    if (lesson_session.kinds[lesson_session.at] == EX_READ) sk_build_read_exercise(c) else sk_build_choice_exercise(c)
}

// The exercise's button, a row under what it asks (where a keyboard can't
// cover it): a word's Check, then Next (Finish, the last). A word's field's
// Return does the same (sk_lessons_submit), the keyboard kept up.
sk_exercise_button() {
    ui_row(UI_BUTTON, exercise_button_action(), 0);
    ui_set_title(if (lesson_session.answer == ANSWER_NONE) "Check" else if (lesson_session.at + 1 >= lesson_session.count) "Finish" else "Next");
    ui_set_tinted()
}

exercise_button_action(): int {
    if (lesson_session.answer == ANSWER_NONE) ACT_EXERCISE_CHECK else ACT_EXERCISE_NEXT
}

// The exercise screen at screen i submitted (its field's Return): its
// button's action.
sk_lessons_submit(i: int) {
    if (lesson_session.at >= lesson_session.count) return;
    borrow language_data {
        sk_lessons_act(language_data, i, exercise_button_action(), 0)
    }
}

// A letter as the heading, and four names (or sounds) to choose from;
// chosen, the right one checked, and the wrong one chosen marked.
sk_build_choice_exercise(c: *Course) {
    if (lesson_session.sound_word >= 0) {
        sk_build_said_exercise(c);
        return
    }
    target: int = lesson_session.asks[lesson_session.at];
    sound: bool = lesson_session.kinds[lesson_session.at] == EX_SOUND;
    fbuf_n = 0;
    if (lesson_session.capital) fput_item_capital(c, target) else fput_item_small(c,
        target);
    ui_set_hero(fbuf_n, course_script(c.lang), fbuf_n);
    ui_set_hero_large();
    answered: bool = lesson_session.answer != ANSWER_NONE;
    ui_section(if (sound) "What sound does it make?" else "What is this letter called?",
        "");
    for x in 0..CHOICES {
        i: int = lesson_session.choices[x];
        ui_row(UI_ITEM, if (answered) 0 else ACT_EXERCISE_CHOOSE, x);
        fbuf_n = 0;
        if (sound) fput_bytes(c.text, c.items[i].sound_b, c.items[i].sound_e) else fput_bytes(c.text,
            c.items[i].name_b, c.items[i].name_e);
        ui_set_title_fbuf();
        if (answered) {
            if (i == target) {
                ui_set_acc(ACC_CHECK);
                ui_set_strong()
            } else if (x == lesson_session.chosen) ui_set_destructive() else ui_set_faint()
        }
    }
    if (answered) {
        ui_section("", "");
        sk_exercise_button()
    }
}

// A letter's sound asked in a word: the word as the heading and what it
// means; the word as tiles, a unit each, the sound chosen for it over it
// ("?" until one is), the one being chosen for marked; its four options as
// tiles under them; Check once each has one. Checked: the right sound over
// each tile, a wrong one in red over what was chosen, the word's
// pronunciation, and Next.
sk_build_said_exercise(c: *Course) {
    word: CourseWord = c.words[lesson_session.sound_word];
    done: bool = lesson_session.answer != ANSWER_NONE;
    // (The tiles are the word: what it means under them, as a gloss;
    // checked, how it is said too, its stress in capitals.)
    fbuf_n = 0;
    fput_bytes(c.text, word.meaning_b, word.meaning_e);
    if (done) {
        fput_str(" \�\� said ");
        fput_bytes(c.text, word.said_b, word.said_e)
    }
    ui_section(if (lesson_session.answer == ANSWER_RIGHT) "Right" else if (lesson_session.answer == ANSWER_WRONG) "Not quite" else "How is it said?",
        "");
    if (fbuf_n > 0) ui_set_footer_fbuf();
    ui_row(UI_TILES, 0, 0);
    ui_rows[ui_last()].value = UI_TILES_LARGE;
    for u in 0..lesson_session.unit_n {
        fbuf_n = 0;
        fput_bytes(c.text, lesson_session.unit_b[u], lesson_session.unit_e[u]);
        ui_cell_fbuf(course_script(c.lang), if (done) 0 else ACT_SOUND_UNIT, u);
        chosen: int = lesson_session.unit_chosen[u];
        right: int = lesson_session.unit_right[u];
        shown: int = if (done) right else chosen;
        fbuf_n = 0;
        if (shown >= 0) fput_unit_option(u, shown) else fput(63);
        ui_set_cell_sub_fbuf();
        if (done && chosen != right) {
            fbuf_n = 0;
            fput_unit_option(u, chosen);
            ui_set_cell_tr_fbuf()
        }
        flags: int = 0;
        if (!done && u == lesson_session.unit_at) flags = flags | UI_TILE_SELECTED;
        if (!done && chosen < 0) flags = flags | UI_TILE_FAINT_SUB;
        if (done && chosen != right) flags = flags | UI_TILE_WRONG;
        ui_set_cell_flags(flags);
        // (What a screen reader says: the unit and its sound; not chosen;
        // or, answered wrong, the one chosen and the right one.)
        fbuf_n = 0;
        fput_bytes(c.text, lesson_session.unit_b[u], lesson_session.unit_e[u]);
        fput_str(": ");
        if (done && chosen != right) {
            fput_unit_option(u, chosen);
            fput_str(" chosen; it is ");
            fput_unit_option(u, right)
        } else if (shown >= 0) fput_unit_option(u, shown) else fput_str("not chosen");
        fput(46);
        ui_set_cell_label_fbuf()
    }
    if (!done && lesson_session.unit_at >= 0) {
        ui_section("", "");
        ui_row(UI_TILES, 0, 0);
        ui_rows[ui_last()].value = UI_TILES_LARGE;
        u: int = lesson_session.unit_at;
        for o in 0..CHOICES {
            fbuf_n = 0;
            ui_cell_fbuf(0, ACT_SOUND_OPTION, o);
            fbuf_n = 0;
            fput_unit_option(u, o);
            ui_set_cell_sub_fbuf();
            ui_set_cell_label_fbuf();
            ui_set_cell_flags(UI_TILE_OPTION | (if (lesson_session.unit_chosen[u] == o) UI_TILE_SELECTED else 0))
        }
    }
    ui_section("", "");
    sk_exercise_button();
    if (!done && !units_chosen()) ui_set_disabled(true)
}

fput_unit_option(u: int, o: int) {
    x: int = u * CHOICES + o;
    fput_bytes(lesson_session.choice_text, lesson_session.choice_b[x], lesson_session.choice_e[x])
}

// A word as the heading (the course's, or the New Testament's), what it
// means, and a field to write it in English letters; checked, how it went,
// how it is written and said, and if it was wrong, its letters.
sk_build_read_exercise(c: *Course) {
    w: int = lesson_session.asks[lesson_session.at];
    answered: bool = lesson_session.answer != ANSWER_NONE;
    fbuf_n = 0;
    fput_read_word(c, w);
    at: int = fbuf_n;
    if (answered) fput_word_typed(c, w);
    ui_set_hero(at, course_script(c.lang), fbuf_n);
    ui_set_hero_large();
    // (What it means shown from the start: it isn't what is asked. How it
    // is said (the course's words), once it is written.)
    ui_rich_begin();
    if (w < 0) fput_bytes(lesson_session.nt_text, lesson_session.nt_mean_b[-1 - w],
        lesson_session.nt_mean_e[-1 - w]) else fput_bytes(c.text, c.words[w].meaning_b,
        c.words[w].meaning_e);
    ui_rich(RUN_PLAIN);
    if (answered && w >= 0 && c.words[w].said_e > c.words[w].said_b) {
        fput_str(" \�\� said ");
        ui_rich(RUN_FAINT);
        fput_bytes(c.text, c.words[w].said_b, c.words[w].said_e);
        ui_rich(RUN_PLAIN)
    }
    ui_rich_hero_line();
    // (Checked, how it went, over the field: in sight above a keyboard.)
    fbuf_n = 0;
    if (lesson_session.answer == ANSWER_RIGHT) fput_str("Right") else if (lesson_session.answer == ANSWER_WRONG) {
        fput_str("Not quite: it is ");
        fput_word_typed(c, w)
    } else fput_str("What is the English transliteration?");
    ui_section("", "");
    ui_set_header_fbuf();
    ui_row(UI_FIELD, ACT_EXERCISE_TYPED, 0);
    ui_set_title("Type here");
    fbuf_n = 0;
    fput_bytes(lesson_session.typed, 0, lesson_session.typed_n);
    ui_set_detail_fbuf();
    // (Its words to core as they are typed: Check, tapped while the field
    // is still being typed in, has them.)
    ui_set_field_live(UI_FIELD_LETTERS);
    ui_set_field_keeps();
    ui_set_focus();
    sk_exercise_button();
    if (lesson_session.answer != ANSWER_WRONG) return;
    // (Wrong: its letters, each once, as the lesson pages show them.)
    ui_section("Its Letters", "");
    fbuf_n = 0;
    fput_read_word(c, w);
    n: int = fbuf_n;
    for x in 0..n read_letters[x] = fbuf[x];
    p: int = 0;
    while (p < n) {
        k: int = course_letter(c.lang, cp_at(read_letters, p, n));
        at_letter: int = p;
        p = p + cp_len;
        if (k != 0 && !letters_have(c.lang, read_letters, at_letter, k)) {
            i: int = course_item_of_letter(c, k);
            if (i >= 0) sk_item_row(c, i)
        }
    }
}

// A word read (its own bytes, as the letters are listed).
read_letters: []i8 = new i8[512](0i8);

// A word to read, as written, into fbuf: the course's (w), or the New
// Testament's (-1 - its place in the session).
fput_read_word(c: *Course, w: int) {
    if (w < 0) fput_bytes(lesson_session.nt_text, lesson_session.nt_form_b[-1 - w],
        lesson_session.nt_form_e[-1 - w]) else fput_bytes(c.text, c.words[w].word_b,
        c.words[w].word_e)
}

// Whether letters b[0..e) have letter k.
letters_have(
    lang: int,
    b: []i8,
    e: int,
    k: int
): bool {
    p: int = 0;
    while (p < e) {
        if (course_letter(lang, cp_at(b, p, e)) == k) return true;
        p = p + cp_len
    }
    false
}

// The letter item that teaches letter k (-1: none).
course_item_of_letter(c: *Course, k: int): int {
    for i in 0..c.item_count {
        item: CourseItem = c.items[i];
        if (item.kind == ITEM_LETTER && course_letter(c.lang, cp_at(c.text, item.forms_b,
            item.forms_e)) == k) return i
    }
    -1
}

// The lesson's end: how it went, and on to the next lesson (or back to
// the lessons).
sk_build_lesson_end(c: *Course, l: int) {
    names: int = 0;
    said: int = 0;
    reads: int = 0;
    for x in 0..lesson_session.count {
        if (!lesson_session.again[x]) {
            k: int = lesson_session.kinds[x];
            if (k == EX_NAME) names = names + 1 else if (k == EX_SOUND) said = said + 1 else reads = reads + 1
        }
    }
    // "You named 6 letters, said 4 words a sound at a time, and wrote 7."
    fbuf_n = 0;
    fput_str("You named ");
    fput_int(names);
    fput_str(if (names == 1) " letter, said " else " letters, said ");
    fput_int(said);
    fput_str(if (said == 1) " word a sound at a time, and wrote " else " words a sound at a time, and wrote ");
    fput_int(reads);
    fput(46);
    ui_set_empty("checkmark.circle", "Lesson Finished", "");
    ui_empty_line = ui_put_fbuf();
    if (l + 1 < c.lesson_count) {
        ui_tool("", "", ACT_LESSON_NEXT, l + 1, UI_TOOL_PROMINENT, 1);
        fbuf_n = 0;
        fput_str("Next: ");
        fput_bytes(c.text, c.lessons[l + 1].title_b, c.lessons[l + 1].title_e);
        ui_set_tool_title_fbuf()
    } else ui_tool("All Lessons", "", ACT_LESSON_DONE, 0, UI_TOOL_PROMINENT, 1)
}

// ---- what they do (skin.l8's sk_act and sk_text) ----
sk_lessons_act(
    language: *LanguageData,
    at: int,
    action: int,
    arg: int
) {
    kind: int = sk_kinds[at];
    lang: int = if (kind == SCR_COURSE) sk_args[at] else sk_args[at] / LESSONS_MOST;
    if (lang < 0 || lang >= len(courses)) return;
    borrow courses[lang] as c {
        lesson_act(c, language, at, action, arg)
    }
}

lesson_act(
    c: *Course,
    language: *LanguageData,
    at: int,
    action: int,
    arg: int
) {
    id: int = sk_ids[at];
    if (action == ACT_LESSON_OPEN) {
        if (arg >= 0 && arg < c.lesson_count) sk_open(SCR_LESSON, c.lang * LESSONS_MOST + arg,
            true);
        return
    }
    if (action == ACT_LESSON_BEGIN) {
        if (arg < 0 || arg >= c.lesson_count) return;
        lesson_begin(c, arg);
        sk_open(SCR_EXERCISE, c.lang * LESSONS_MOST + arg, true);
        return
    }
    if (action == ACT_PRACTICE_BEGIN) {
        if (practice_index(arg) < 0 || !course_any_done(c)) return;
        practice_begin(c, language, arg);
        // (Again, from a round's end: the same screen, begun again.)
        if (sk_kinds[at] == SCR_PRACTICE_ROUND) {
            sk_build(at);
            ui_effect("update", id, -1);
            ui_effect("retext", id, -1)
        } else sk_open(SCR_PRACTICE_ROUND, c.lang * LESSONS_MOST + arg, true);
        return
    }
    if (action == ACT_LESSON_NEXT || action == ACT_LESSON_DONE) {
        // (Back to the lessons, then the next one opened.)
        course: int = -1;
        for j in 0..at
            if (sk_kinds[j] == SCR_COURSE) course = j;
        if (course >= 0) {
            sk_n = course + 1;
            ui_effect("pop_to", sk_ids[course], -1);
            sk_build(course);
            ui_effect("update", sk_ids[course], -1)
        } else ui_effect("pop", -1, -1);
        if (action == ACT_LESSON_NEXT && arg >= 0 && arg < c.lesson_count) sk_open(SCR_LESSON,
            c.lang * LESSONS_MOST + arg, true);
        return
    }
    if (!ls_shows(at) || lesson_session.at >= lesson_session.count) return;
    if (action == ACT_EXERCISE_CHOOSE) {
        if (lesson_session.answer != ANSWER_NONE || lesson_session.kinds[lesson_session.at] == EX_READ || arg < 0 || arg >= CHOICES) return;
        lesson_session.chosen = arg;
        exercise_answered(lesson_session.choices[arg] == lesson_session.asks[lesson_session.at]);
        exercise_felt();
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_SOUND_UNIT || action == ACT_SOUND_OPTION) {
        // (A unit chosen for, or an option picked for it.)
        if (lesson_session.answer != ANSWER_NONE || lesson_session.sound_word < 0) return;
        if (action == ACT_SOUND_UNIT && arg >= 0 && arg < lesson_session.unit_n) lesson_session.unit_at = arg else if (action == ACT_SOUND_OPTION) unit_picked(arg);
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_EXERCISE_CHECK && lesson_session.sound_word >= 0) {
        if (lesson_session.answer != ANSWER_NONE || !units_chosen()) return;
        exercise_answered(units_right());
        exercise_felt();
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_EXERCISE_CHECK) {
        if (lesson_session.answer != ANSWER_NONE || lesson_session.kinds[lesson_session.at] != EX_READ) return;
        // (Nothing typed: nothing to check.)
        if (letters_match(lesson_session.typed, 0, lesson_session.typed_n, lesson_session.typed,
            0, 0)) return;
        exercise_answered(typed_matches(c, lesson_session.asks[lesson_session.at]));
        exercise_felt();
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_EXERCISE_NEXT) {
        if (lesson_session.answer == ANSWER_NONE) return;
        lesson_session.at = lesson_session.at + 1;
        exercise_show(c);
        if (lesson_session.at >= lesson_session.count && lesson_session.lesson >= 0) {
            // (Finished: the lesson and the lessons say so.)
            lesson_mark_done(c, lesson_session.lesson);
            sk_update_all();
            return
        }
        sk_build(at);
        ui_effect("update", id, -1);
        // (The field empty again for the next word.)
        ui_effect("retext", id, -1)
    }
}

// What was typed in the exercise's field (kept until it is checked).
sk_lessons_text(
    at: int,
    action: int,
    buf: []i8,
    b: int,
    e: int
) {
    if (action != ACT_EXERCISE_TYPED || !ls_shows(at) || lesson_session.answer != ANSWER_NONE) return;
    n: int = 0;
    for x in b..e {
        if (n < len(lesson_session.typed)) {
            lesson_session.typed[n] = buf[x];
            n = n + 1
        }
    }
    lesson_session.typed_n = n
}

// An answer felt (a tap the platform's way), wrong ones as Practice's
// wrong letter is.
exercise_felt() {
    ui_effect("felt", if (lesson_session.answer == ANSWER_RIGHT) PX_FELT_GRADE else PX_FELT_WRONG,
        -1)
}
