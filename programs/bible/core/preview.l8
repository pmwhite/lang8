tag bible;

use_tag std;

// A reference's preview (DESIGN.md §8.1), apart from any platform: its
// verses (each chapter's first and last), at most PREVIEW_MOST, then a line
// saying the reader has the rest; a later chapter's label between
// chapters; Open in Reader: core's screen (SCR_PASSAGE).
import "skin.l8";

SCR_PASSAGE: int = 45;

ACT_PV_OPEN: int = 175;

// The most verses a preview shows; past them, the reader.
PREVIEW_MOST: int = 80;

pv_more: str = "Continues in the reader";

pv_open: str = "Open in Reader";

// The verses: chapter pvp_c[x], verses pvp_a[x] to pvp_z[x], pvp_n of
// them; whether the cap cut them short.
pvp_c: []int = new int[128](0);

pvp_a: []int = new int[128](0);

pvp_z: []int = new int[128](0);

pvp_n: int = 0;

pvp_capped: bool = false;

// Reference ref's verses in source, planned.
pv_plan(source: *TextData, ref: int) {
    pvp_n = 0;
    pvp_capped = false;
    xref_unpack(ref);
    c0: int = xref_chapter();
    c1: int = xref_last_chapter();
    if (c0 < 0 || c1 < c0) return;
    from_v: int = if (xr_v > 0) xr_v else 1;
    to_v: int = xr_ve;
    whole_end: bool = xr_ve == 0;
    shown: int = 0;
    c: int = c0;
    while (c <= c1 && !pvp_capped && pvp_n < len(pvp_c)) {
        a: int = if (c == c0) from_v else 1;
        z: int = if (c == c1 && !whole_end) to_v else tx_ch_verses[source.version][c];
        if (z > tx_ch_verses[source.version][c]) z = tx_ch_verses[source.version][c];
        if (z < a) z = a;
        if (shown + z - a + 1 > PREVIEW_MOST) {
            z = a + PREVIEW_MOST - shown - 1;
            pvp_capped = true
        }
        pvp_c[pvp_n] = c;
        pvp_a[pvp_n] = a;
        pvp_z[pvp_n] = z;
        pvp_n = pvp_n + 1;
        shown = shown + z - a + 1;
        c = c + 1
    }
}

// A chapter's label where a preview goes on into it (JOHN; PSALM), into
// fbuf.
pv_label(source: *TextData, c: int) {
    fbuf_n = 0;
    b: int = ch_book[c];
    if (book_code(b) == "PSA") {
        fput_str("PSALM");
        return
    }
    for c in book_name(b) {
        k: int = c as int;
        fput(if (k >= 97 && k <= 122) k - 32 else k)
    }
}

// Under the ESV without its verses: the BSB's, saying so, and why if the
// reader can do something about it (1 offline, 2 busy), into fbuf.
pv_bsb_note(why: int) {
    fbuf_n = 0;
    fput_str("Shown in the BSB.");
    if (why == 1) fput_str(" The ESV needs a connection.") else if (why == 2) fput_str(" The ESV is busy just now.")
}

// Under the ESV: whether every chapter of reference ref is held; those
// that aren't asked for (two at a time where it goes on), the first kept
// while they come (ec_hold_c), by the host's fetch.
pv_esv_held(ref: int): bool {
    xref_unpack(ref);
    c1: int = xref_last_chapter();
    for c in xref_chapter()..c1 + 1
        if (!esv_held(c)) return false;
    true
}

pv_esv_ask(ref: int, now: f64) {
    xref_unpack(ref);
    c0: int = xref_chapter();
    c1: int = xref_last_chapter();
    ec_hold_c = c0;
    for c in c0..c1 + 1
        if (!esv_held(c)) esv_want_now(c, if (c1 > c) 2 else 1, now)
}

// ---- opening one ----
// Reference ref's preview: core's screen, pushed over the sheet up (else
// presented).
sk_preview(ref: int) {
    sk_open(SCR_PASSAGE, ref, sk_n > 0)
}

// ---- core's screen of it ----
pv_layout: ChapterLayout = chapter_layout();

// Its title the reference; a page, a paragraph each chapter's verses (in
// the reader's styles), a chapter's label and number before a later one's;
// the cap's line; Open in Reader.
sk_build_passage(id: int, ref: int) {
    fbuf_n = 0;
    fput_xref(ref);
    ui_begin(id, SCR_PASSAGE, ref, "");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_page = true;
    ui_tool(pv_open, "", ACT_PV_OPEN, ref, UI_TOOL_PROMINENT, 1);
    borrow texts[if (text_cur == TEXT_ESV) TEXT_BSB else text_cur] as source {
        pv_plan(source, ref);
        ui_section("", "");
        if (text_cur == TEXT_ESV) {
            pv_bsb_note(0);
            ui_row(UI_TEXT, 0, 0);
            ui_rich_begin();
            ui_rich(RUN_SMALL);
            ui_rich_title()
        }
        sk_apply_prefs();
        ctx: *ChapterLayout = &pv_layout;
        ctx.lay_verse_numbers = lay_verse_numbers;
        ctx.lay_headings = lay_headings;
        ctx.lay_notes = false;
        ctx.lay_verse_lines = lay_verse_lines;
        ctx.lay_accents = lay_accents;
        for x in 0..pvp_n {
            c: int = pvp_c[x];
            if (x > 0) {
                ui_row(UI_TEXT, 0, c);
                ui_rich_begin();
                pv_label(source, c);
                ui_rich(RUN_SMALL);
                fput(10);
                fput_int(ch_num[c]);
                ui_rich(RUN_ACCENT);
                ui_rich_title();
                ui_set_heading()
            }
            ctx.lay_v1 = pvp_a[x];
            ctx.lay_v2 = pvp_z[x];
            ctx.lay_passage = true;
            layout_chapter_from(source, ctx, c);
            ui_row(UI_TEXT, 0, c);
            ui_rich_begin();
            p: int = 0;
            for r in 0..ctx.runs {
                e: int = ctx.run_end[r];
                if (e > p) {
                    fput_bytes(ctx.out, p, e);
                    ui_rich(ctx.run_style[r])
                }
                p = e
            }
            ui_rich_title()
        }
        ctx.lay_v1 = 0;
        ctx.lay_v2 = 0;
        ctx.lay_passage = false;
        if (pvp_capped) {
            ui_row(UI_TEXT, 0, 0);
            ui_rich_begin();
            fput_str(pv_more);
            ui_rich(RUN_FAINT);
            ui_rich_title()
        }
    }
    // (Its verses only, as a plan's day lays a chapter out in part.)
}

// Open in Reader: there, the sheets away.
sk_pv_act(action: int, arg: int) {
    if (action != ACT_PV_OPEN) return;
    xref_unpack(arg);
    sk_goto(xref_chapter(), if (xr_v > 0) xr_v else 1)
}
