tag bible;

use_tag std;

// The keyboard's commands (DESIGN.md ยง17.4), apart from any platform: each
// one's title, its key and modifiers, the menu it is in (the menu bar's Go
// or View, or none), and when it acts. A skin makes them its platform's
// way, and does each.
import "skin.l8";

KC_GOTO: int = 0;

KC_SEARCH: int = 1;

KC_NEXT_CHAPTER: int = 2;

KC_PREVIOUS_CHAPTER: int = 3;

KC_BACK: int = 4;

KC_LIBRARY: int = 5;

KC_SETTINGS: int = 6;

KC_LISTEN: int = 7;

KC_STUDY: int = 8;

KC_PAGE_DOWN: int = 9;

KC_PAGE_UP: int = 10;

KC_MARK_READ: int = 11;

KC_PRACTICE_MAIN: int = 12;

KC_NOT_YET: int = 13;

KC_KNEW: int = 14;

KC_PREVIOUS_VERSE: int = 15;

KC_NEXT_VERSE: int = 16;

KC_COUNT: int = 17;

// Its title (none: Space's), the menu (0 Go, 1 View, 2 none).
kc_titles: []str = ["Go To\โ\€\ฆ", "Search\โ\€\ฆ", "Next Chapter", "Previous Chapter",
    "Back", "Library", "Reading Settings", "Listen / Pause", "Show Bookshelf", "",
    "", "Mark Read", "Check or Next", "Not Yet", "Knew It", "Previous Verse", "Next Verse"];

kc_menus: []int = [0, 0, 0, 0, 0, 0, 1, 1, 1, 2, 2, 2, 2, 2, 2, 2, 2];

// Its key: a character, or an arrow ("left", "up", "down").
kc_keys: []str = ["l", "f", "]", "[", "left", "b", ",", "p", "i", " ", " ", "d", "\r",
    "1", "2", "up", "down"];

// Its modifiers: KM_ bits.
KM_CMD: int = 1;

KM_SHIFT: int = 2;

KM_ALT: int = 4;

kc_mods: []int = [1, 1, 1, 1, 1, 3, 1, 3, 5, 0, 2, 1, 0, 1, 1, 1, 1];

// The Bookshelf's title while the panel is open.
kc_title(k: int, panel_open: bool): str {
    if (k == KC_STUDY && panel_open) "Hide Bookshelf" else kc_titles[k]
}

// Whether command k acts now, at core's screens: Practice's on Practice
// (Check or Next, the grades); Mark Read and Next Chapter on a plan's
// day; with no screen over the reader, the reader's (Back while its
// capsule shows; Study where its panel fits beside the reader; Study's
// verses while it shows there); else none.
kc_acts(k: int): bool {
    t: int = sk_sheet_top();
    top: int = if (t >= 0) sk_kinds[t] else -1;
    if (top == SCR_PRACTICE) return k == KC_PRACTICE_MAIN || k == KC_NOT_YET || k == KC_KNEW;
    if (top == SCR_DAY) return k == KC_MARK_READ || k == KC_NEXT_CHAPTER;
    if (t >= 0) return false;
    if (k == KC_BACK) return bk_n > 0;
    if (k == KC_MARK_READ || k == KC_PRACTICE_MAIN || k == KC_NOT_YET || k == KC_KNEW) return false;
    if (k == KC_PREVIOUS_VERSE || k == KC_NEXT_VERSE) return sk_panel_shown && sk_beside_at() >= 0;
    true
}

// ---- the commands, for a skin to offer its platform's way ----
// command K MENU NAME MODS TITLE: command K (KC_), its menu (0 Go, 1 View,
// 2 none), its key (kc_name's) and modifiers (KM_ bits), and its title
// (none: Space's), at `start` and again as its title changes (Show
// Bookshelf, Hide Bookshelf: the panel beside the page); commands MASK: those that act now (bit K), as that changes.
// A skin sends a command as its key (`key NAME MODS`).
sk_commands_acting: int = -1;

sk_commands_panel_open: bool = false;

sk_write_commands() {
    sk_commands_panel_open = sk_beside_open();
    for k in 0..KC_COUNT sk_write_command(k);
    sk_commands_acting = -1;
    sk_write_commands_changed()
}

sk_write_command(k: int) {
    ui_str("command ");
    ui_int(k);
    ui_byte(32);
    ui_int(kc_menus[k]);
    ui_byte(32);
    ui_str(kc_name(k));
    ui_byte(32);
    ui_int(kc_mods[k]);
    ui_byte(9);
    ui_str(kc_title(k, sk_commands_panel_open));
    ui_byte(10)
}

sk_write_commands_changed() {
    open: bool = sk_beside_open();
    if (open != sk_commands_panel_open) {
        sk_commands_panel_open = open;
        sk_write_command(KC_STUDY)
    }
    acting: int = 0;
    for k in 0..KC_COUNT
        if (kc_acts(k)) acting = acting | 1 << k;
    if (acting == sk_commands_acting) return;
    sk_commands_acting = acting;
    ui_str("commands ");
    ui_int(acting);
    ui_byte(10)
}

// ---- a key pressed ----
// (key NAME MODS: NAME its character or left, up, down, space, return;
// MODS its KM_ bits.) The command it is (-1, none).
kc_of(
    line: []i8,
    b: int,
    e: int,
    mods: int
): int {
    for k in 0..KC_COUNT
        if (kc_mods[k] == mods && sk_word_is(line, b, e, kc_name(k))) return k;
    -1
}

kc_name(k: int): str {
    key: str = kc_keys[k];
    if (key == " ") "space" else if (key == "\r") "return" else key
}

// Command k done, where it acts (kc_acts). Whether it acted. (Space's
// page: page 1 down, page 0 up, the skin's.)
sk_key(k: int): bool {
    if (!kc_acts(k)) return false;
    t: int = sk_sheet_top();
    top: int = if (t >= 0) sk_kinds[t] else -1;
    if (top == SCR_PRACTICE) {
        borrow language_data {
            if (k == KC_PRACTICE_MAIN) sk_px_act(language_data, t, ACT_PX_MAIN, 0,
                0) else sk_px_act(language_data, t, ACT_PX_GRADE, if (k == KC_NOT_YET) G_NOTYET else G_KNEW,
                0)
        }
        return true
    }
    if (top == SCR_DAY) {
        if (k == KC_MARK_READ) sk_dd_act(t, ACT_DD_MARK, 0) else if (k == KC_NEXT_CHAPTER) sk_dd_act(t,
            ACT_DD_NEXT, 0) else return false;
        return true
    }
    if (k == KC_STUDY) sk_beside_toggle() else if (k == KC_PREVIOUS_VERSE) sk_beside_step(-1) else if (k == KC_NEXT_VERSE) sk_beside_step(1) else if (k == KC_GOTO) sk_open(SCR_GOTO,
        0, false) else if (k == KC_SEARCH) sk_open(SCR_SEARCH, 0, false) else if (k == KC_LIBRARY) sk_open(SCR_LIBRARY,
        0, false) else if (k == KC_SETTINGS) sk_open(SCR_SETTINGS, 0, false) else if (k == KC_NEXT_CHAPTER) sk_goto(sk_c + 1,
        0) else if (k == KC_PREVIOUS_CHAPTER) sk_goto(sk_c - 1, 0) else if (k == KC_BACK) sk_back() else if (k == KC_LISTEN) sk_listen_toggle() else if (k == KC_PAGE_DOWN) ui_effect("page",
        1, -1) else if (k == KC_PAGE_UP) ui_effect("page", 0, -1) else return false;
    true
}

