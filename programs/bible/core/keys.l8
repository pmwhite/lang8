tag bible;

use_tag std;

// The keyboard's commands (DESIGN.md ยง17.4), apart from any platform: each
// one's title, its key and modifiers, the menu it is in (the menu bar's Go
// or View, or none), and when it acts. A skin makes them its platform's
// way, and does each.
import "skin.l8";

KC_GOTO: int = 0;

KC_SEARCH: int = 1;

KC_NEXT_CHAPTER: int = 2;

KC_PREVIOUS_CHAPTER: int = 3;

KC_BACK: int = 4;

KC_LIBRARY: int = 5;

KC_SETTINGS: int = 6;

KC_LISTEN: int = 7;

KC_STUDY: int = 8;

KC_PAGE_DOWN: int = 9;

KC_PAGE_UP: int = 10;

KC_MARK_READ: int = 11;

KC_PRACTICE_MAIN: int = 12;

KC_NOT_YET: int = 13;

KC_MOSTLY: int = 14;

KC_KNEW: int = 15;

KC_PREVIOUS_VERSE: int = 16;

KC_NEXT_VERSE: int = 17;

KC_COUNT: int = 18;

// Its title (none: Space's), the menu (0 Go, 1 View, 2 none).
kc_titles: []str = ["Go To\โ\€\ฆ", "Search\โ\€\ฆ", "Next Chapter", "Previous Chapter",
    "Back", "Library", "Reading Settings", "Listen / Pause", "Show Study", "", "",
    "Mark Read", "Check or Next", "Not Yet", "Mostly", "Knew It", "Previous Verse",
    "Next Verse"];

kc_menus: []int = [0, 0, 0, 0, 0, 0, 1, 1, 1, 2, 2, 2, 2, 2, 2, 2, 2, 2];

// Its key: a character, or an arrow ("left", "up", "down").
kc_keys: []str = ["l", "f", "]", "[", "left", "b", ",", "p", "i", " ", " ", "d", "\r",
    "1", "2", "3", "up", "down"];

// Its modifiers: KM_ bits.
KM_CMD: int = 1;

KM_SHIFT: int = 2;

KM_ALT: int = 4;

kc_mods: []int = [1, 1, 1, 1, 1, 3, 1, 3, 5, 0, 2, 1, 0, 1, 1, 1, 1, 1];

// Study's title while it is open.
kc_title(k: int, study_open: bool): str {
    if (k == KC_STUDY && study_open) "Hide Study" else kc_titles[k]
}

// Whether command k acts now: the reader's while no sheet is over it
// (Previous Chapter not in a plan's day; Back while the capsule shows;
// Study where it fits beside the text; Mark Read in a plan's day with its
// capsule); Practice's while it is the sheet on top; Study beside the
// text's verses while it shows.
kc_allowed(
    k: int,
    reader: bool,
    in_day: bool,
    back_shown: bool,
    study_fits: bool,
    mark_shown: bool,
    practice_top: bool,
    beside_shown: bool
): bool {
    if (k == KC_PREVIOUS_CHAPTER) return reader && !in_day;
    if (k == KC_BACK) return reader && back_shown;
    if (k == KC_STUDY) return reader && study_fits;
    if (k == KC_MARK_READ) return reader && in_day && mark_shown;
    if (k == KC_PRACTICE_MAIN || k == KC_NOT_YET || k == KC_MOSTLY || k == KC_KNEW) return practice_top;
    if (k == KC_PREVIOUS_VERSE || k == KC_NEXT_VERSE) return reader && beside_shown;
    reader
}

// ---- for a skin that hands core its keys ----
// (key NAME MODS: a key pressed, NAME its character or left, up, down,
// space, return; MODS its KM_ bits. The iPhone makes them commands
// itself.) The command it is (-1, none).
kc_of(
    line: []i8,
    b: int,
    e: int,
    mods: int
): int {
    for k in 0..KC_COUNT
        if (kc_mods[k] == mods && sk_word_is(line, b, e, kc_name(k))) return k;
    -1
}

kc_name(k: int): str {
    key: str = kc_keys[k];
    if (key == " ") "space" else if (key == "\r") "return" else key
}

// Command k done, where it acts (kc_allowed's rules, at core's screens:
// Practice's on Practice, a plan's day's on the day, the reader's with no
// screen over it). Whether it acted. (Space's page: page 1 down, page 0
// up, the skin's.)
sk_key(k: int): bool {
    t: int = sk_top();
    top: int = if (t >= 0) sk_kinds[t] else -1;
    if (top == SCR_PRACTICE) {
        if (k != KC_PRACTICE_MAIN && k != KC_NOT_YET && k != KC_MOSTLY && k != KC_KNEW) return false;
        borrow language_data {
            if (k == KC_PRACTICE_MAIN) sk_px_act(language_data, t, ACT_PX_MAIN, 0,
                0) else sk_px_act(language_data, t, ACT_PX_GRADE, k - KC_NOT_YET,
                0)
        }
        return true
    }
    if (top == SCR_DAY) {
        if (k == KC_MARK_READ) sk_dd_act(t, ACT_DD_MARK, 0) else if (k == KC_NEXT_CHAPTER) sk_dd_act(t,
            ACT_DD_NEXT, 0) else return false;
        return true
    }
    if (t >= 0 || !kc_allowed(k, true, false, bk_n > 0, false, false, false, false)) return false;
    if (k == KC_GOTO) sk_open(SCR_GOTO, 0, false) else if (k == KC_SEARCH) sk_open(SCR_SEARCH,
        0, false) else if (k == KC_LIBRARY) sk_open(SCR_LIBRARY, 0, false) else if (k == KC_SETTINGS) sk_open(SCR_SETTINGS,
        0, false) else if (k == KC_NEXT_CHAPTER) sk_goto(sk_c + 1, 0) else if (k == KC_PREVIOUS_CHAPTER) sk_goto(sk_c - 1,
        0) else if (k == KC_BACK) sk_back() else if (k == KC_LISTEN) sk_listen_toggle() else if (k == KC_PAGE_DOWN) ui_effect("page",
        1, -1) else if (k == KC_PAGE_UP) ui_effect("page", 0, -1) else return false;
    true
}

