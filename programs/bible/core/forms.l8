tag bible;

use_tag std;

// A lemma's Forms (Study's): its forms found in the Bible as grids and
// lists, each form's concordance a tap away; and the reader opened in the
// Hebrew and Greek at a place.
import "skin.l8";

import "lang.l8";

SCR_FORMS: int = 37;

// A form's concordance (arg its parsing).
ACT_FORM_CONCORDANCE: int = 100;

// ---- Forms (Â§14.5.3) ----
// The lemma's forms made (lang.l8's fo_ and fs_), if they are another's:
// arg its number, 100000 more if Greek.
sk_forms_for: int = -1;

sk_forms_ready(language: *LanguageData, arg: int) {
    if (sk_forms_for == arg && fo_num == arg % 100000) return;
    forms_of(language, arg >= 100000, arg % 100000);
    forms_layout(language);
    forms_renderings(language);
    sk_forms_for = arg
}

// The lemma (hero size), its transliteration, "Forms found in the Bible Â·
// 143 times"; each section a grid (its columns named over it) or a list.
sk_build_forms(language: *LanguageData, id: int, arg: int) {
    sk_forms_ready(language, arg);
    greek: bool = arg >= 100000;
    ui_begin(id, SCR_FORMS, arg, "Forms");
    p: int = lex_first(language, greek, arg % 100000);
    if (p >= 0) {
        fbuf_n = 0;
        lex_field(language, p, 0);
        fput_bytes(language.lexicon, lf_b, lf_e);
        at: int = fbuf_n;
        lex_field(language, p, 1);
        fput_bytes(language.lexicon, lf_b, lf_e);
        ui_set_hero(at, sk_script(greek, false), fbuf_n);
        ui_rich_begin();
        fput_str("Forms found in the Bible \Â\· ");
        fput_count(fo_total);
        fput_str(if (fo_total == 1) " time" else " times");
        ui_rich(RUN_PLAIN);
        ui_rich_hero_line()
    }
    script: int = sk_script(greek, false);
    for s in 0..fs_n {
        ui_section("", "");
        fbuf_n = 0;
        fput_bytes(fs_pool, fs_title_b[s], fs_title_e[s]);
        ui_set_header_fbuf();
        if (fs_grid[s]) ui_set_columns(if (fs_cols[s] == 1) "Form" else "Singular|Plural");
        for r in 0..fs_rows[s] {
            x: int = fs_row_at(s, r);
            if (x >= 0) {
                if (fs_grid[s]) sk_forms_grid_row(language, s, x, script) else sk_forms_list_row(language,
                    x, script)
            }
        }
    }
}

// A list's row: its form, what it does in italic and its parsing, its
// count; tapped, the concordance of it.
sk_forms_list_row(language: *LanguageData, x: int, script: int) {
    g: int = fr_cell0[x];
    if (g < 0) return;
    ui_row(UI_ITEM, ACT_FORM_CONCORDANCE, g);
    ui_rich_begin();
    frm_put_form(language, g);
    ui_rich(script);
    ui_rich_title();
    ui_rich_begin();
    if (fput_form_rendering(g)) {
        ui_rich(RUN_ITALIC);
        fput_str(" \Â\· ");
        ui_rich(RUN_FAINT)
    }
    frm_put_parsing(language, g);
    ui_rich(RUN_FAINT);
    ui_rich_detail();
    fbuf_n = 0;
    fput_int(fo_count[g]);
    ui_set_trailing_fbuf();
    ui_set_acc(ACC_MORE);
    frm_label(language, g);
    ui_set_label_fbuf()
}

// A grid's row: its label, then a cell each column: the commonest form
// over what it does and its count ("6Ã—"), tapped the concordance of that
// parsing; or a faint "â€”".
sk_forms_grid_row(
    language: *LanguageData,
    s: int,
    x: int,
    script: int
) {
    ui_row(UI_ITEM, 0, x);
    fbuf_n = 0;
    fput_bytes(fs_pool, fr_label_b[x], fr_label_e[x]);
    ui_set_title_fbuf();
    for c in 0..fs_cols[s] {
        g: int = if (c == 0) fr_cell0[x] else fr_cell1[x];
        fbuf_n = 0;
        if (g >= 0) {
            frm_put_form(language, g);
            ui_cell_fbuf(script, ACT_FORM_CONCORDANCE, g);
            fbuf_n = 0;
            if (fput_form_rendering(g)) ui_set_cell_sub_fbuf();
            fbuf_n = 0;
            fput_int(fo_count[g]);
            fput_str("\Ã\—");
            ui_set_cell_count_fbuf();
            frm_label(language, g)
        } else {
            fput_str("\â\€\”");
            ui_cell_fbuf(0, 0, -1);
            fbuf_n = 0;
            fput_bytes(fs_pool, fr_label_b[x], fr_label_e[x]);
            fput_str(if (c == 0) " singular" else " plural");
            fput_str(", none")
        }
        ui_set_cell_label_fbuf()
    }
}

// Parsing g's form (forms.txt's line).
frm_put_form(language: *LanguageData, g: int) {
    if (g < 0 || fo_form[g] < 0) return;
    p: int = language.form_at[fo_form[g]];
    e: int = p;
    while (e < language.forms_size && language.forms[e] as int != 9) e = e + 1;
    fput_bytes(language.forms, p, e)
}

// Its parsing in words: "aorist active indicative 3rd singular" (a
// Greek verb's), else its description's main part, lower case ("qal
// consecutive imperfect third person masculine singular").
frm_put_parsing(language: *LanguageData, g: int) {
    pm_b = fo_code_b[g];
    pm_e = fo_code_e[g];
    at: int = pf_at(language, 1);
    if (fo_greek && pc(language, 0) == 86 && pc(language, 1) == 45 && at >= 0 && pf_len >= 3) {
        t: int = fs_letter_index("PIFARL", language.morph[at] as int);
        voice: int = greek_voice(language, at + 2, pf_len - 2);
        mood: int = language.morph[at + 1] as int;
        if (t >= 0 && voice >= 0) {
            frm_lower(greek_tenses[t]);
            fput(32);
            frm_lower(greek_voices[voice]);
            fput(32);
            md: int = fs_letter_index("ISOMNP", mood);
            if (md >= 0) fput_str(mood_words[md]);
            p: int = pf_at(language, 2);
            if (p >= 0 && pf_len == 2) {
                fput(32);
                fput_str(ord_words[clamp_index(language.morph[p] as int - 49, 3)]);
                fput_str(if (language.morph[p + 1] as int == 80) " plural" else " singular")
            } else if (p >= 0 && pf_len == 3) {
                fput(32);
                fput_str(case_words[clamp_index(fs_letter_index("NGDAV", language.morph[p] as int),
                    5)]);
                fput(32);
                fput_str(gender_words[clamp_index(fs_letter_index("MFN", language.morph[p + 1] as int),
                    3)]);
                fput_str(if (language.morph[p + 2] as int == 80) " plural" else " singular")
            }
            return
        }
    }
    // (The description: " - " a space, lower case, "Verb " left out.)
    a: int = fo_desc_b[g];
    b: int = fo_desc_e[g];
    if (b - a > 7 && language.morph[a] as int == 86 && language.morph[a + 1] as int == 101) a = a + 7;
    last: int = 0;
    i: int = a;
    while (i < b) {
        k: int = language.morph[i] as int;
        if (k == 32 && i + 2 < b && language.morph[i + 1] as int == 45 && language.morph[i + 2] as int == 32) {
            fput(32);
            i = i + 3
        } else {
            if (k >= 65 && k <= 90) k = k + 32;
            if (!(k == 32 && last == 32)) fput(k);
            last = k;
            i = i + 1
        }
    }
}

mood_words: []str = ["indicative", "subjunctive", "optative", "imperative", "infinitive",
    "participle"];

ord_words: []str = ["1st", "2nd", "3rd"];

case_words: []str = ["nominative", "genitive", "dative", "accusative", "vocative"];

gender_words: []str = ["masculine", "feminine", "neuter"];

frm_lower(s: str) {
    for i in 0..len(s) {
        k: int = s[i] as int;
        fput(if (k >= 65 && k <= 90) k + 32 else k)
    }
}

// "Aorist active indicative, 3rd person singular, Ä“gapÄ“sen, loved, 6
// times.", into fbuf.
frm_label(language: *LanguageData, g: int) {
    fbuf_n = 0;
    frm_put_parsing(language, g);
    if (fbuf_n > 0 && fbuf[0] as int >= 97 && fbuf[0] as int <= 122) fbuf[0] = (fbuf[0] as int - 32) trunc i8;
    fput_str(", ");
    if (g >= 0 && fo_form[g] >= 0) {
        p: int = language.form_at[fo_form[g]];
        while (p < language.forms_size && language.forms[p] as int != 9) p = p + 1;
        e: int = p + 1;
        while (e < language.forms_size && language.forms[e] as int != 10) e = e + 1;
        fput_bytes(language.forms, p + 1, e)
    }
    fput_str(", ");
    if (fput_form_rendering(g)) fput_str(", ");
    fput_int(fo_count[g]);
    fput_str(if (fo_count[g] == 1) " time." else " times.")
}

// A form's concordance: the lemma's study's numbers (its header names its
// entry), then the verses of that parsing.
sk_form_concordance(language: *LanguageData, g: int) {
    if (g < 0 || g >= fo_n) return;
    mk_form = g;
    sk_conc_open_form(language, g, fo_greek, fo_num)
}

// The reader in the Hebrew and Greek at c:v (v 0: the chapter), or at
// ribbon i's place (-1: none): the sheets away, the version switched, then
// the ribbon opened or the jump made (none, to the chapter on the screen's
// top).
sk_read_in(c: int, v: int, i: int) {
    if (c < 0 || c >= chapters) return;
    sk_close_group(0);
    ui_effect("dismiss", -1, -1);
    // (The panel beside the reader again, if it filled the screen: the
    // reader is what is opened.)
    if (sk_beside_full()) sk_beside_unfill();
    // (Once the version is read: at once, or when the host has loaded it.)
    sk_ri_c = c;
    sk_ri_v = v;
    sk_ri_i = i;
    sk_use_version(TEXT_ORIG);
    sk_read_in_now()
}

// A read-in waiting for the Hebrew and Greek to be loaded (-1: none).
sk_ri_c: int = -1;

sk_ri_v: int = 0;

sk_ri_i: int = -1;

sk_read_in_now() {
    if (sk_ri_c < 0 || text_cur != TEXT_ORIG) return;
    c: int = sk_ri_c;
    v: int = sk_ri_v;
    i: int = sk_ri_i;
    sk_ri_c = -1;
    if (i >= 0) sk_ribbon_go(i) else if (ri_moves(c, v, sk_c)) sk_goto(c, v)
}

// Whether reading in the original at c:v (v 0: the chapter) moves the
// reader, now in chapter here: to a verse, or another chapter.
ri_moves(c: int, v: int, here: int): bool {
    v > 0 || c != here
}

fput_form_rendering(g: int): bool {
    if (g < 0 || g >= fo_n || fo_rend[g] < 0) return false;
    p: int = fo_rend[g];
    for i in 0..fx_len[p] {
        k: int = fx_pool[fx_at[p] + i] as int;
        fput(if (i == 0 && fx_cap[p] && !fx_low[p] && k >= 97 && k <= 122) k - 32 else k)
    }
    true
}
