tag bible;

use_tag std, sword, builder;

// The bookshelf's screens (core/shelf.l8's modules), as core's screens for
// every skin:
//
//   Bookshelf   by kind (Bibles, Commentaries, Dictionaries, Books): what is
//               on this device (a tap reads it, its â“˜ its details), then
//               the library's catalog, English first, then each language a
//               row of its own (a tap downloads it, its progress in its
//               row); a search field over titles and languages
//   Details     a module: Download (its size) or its progress, Read and
//               Remove; About, its license, and what this app can't show
//   Commentary  a commentary on a chapter, a section a verse or passage
//   Entries     a dictionary's keys (a search field to find one), and an
//               entry; a devotional opens at today's
//   Book        a book's contents: a part's text, then its parts
//
// A module's Details screen names it by its place in the catalog (made
// again when the catalog is: shelf_catalog_renumber), or, installed and
// not in the catalog read, by its slot as -1 - slot.
import "shelf.l8";

SCR_SHELF_BROWSE: int = 61;

SCR_SHELF_ITEM: int = 62;

SCR_SHELF_COMMENTARY: int = 63;

SCR_SHELF_ENTRIES: int = 64;

SCR_SHELF_ENTRY: int = 65;

SCR_SHELF_BOOK: int = 66;

// A row of Bookshelf tapped (arg its item's slot): read it; its â“˜: its
// details. Browse's kind chosen (value), a language shown (arg its row's
// language: interned index; -1 all), a catalog row (arg its name's
// interned index). Details': Download, Stop, Read, Remove (arg the name's
// interned index). Check for Updates. Try Again. An entry or part shown
// (arg slot * SHELF_PLACE + its index), a link in a module's text (arg a
// packed reference: a preview), the entry or part before or after (arg -1,
// 1).
ACT_SHELF_READ: int = 300;

ACT_SHELF_INFO: int = 301;

ACT_SHELF_KIND: int = 302;

ACT_SHELF_LANGUAGE: int = 303;

ACT_SHELF_ITEM: int = 304;

ACT_SHELF_DOWNLOAD: int = 305;

ACT_SHELF_STOP: int = 306;

ACT_SHELF_OPEN: int = 307;

ACT_SHELF_REMOVE: int = 308;

ACT_SHELF_REFRESH: int = 309;

ACT_SHELF_RETRY: int = 310;

ACT_SHELF_ENTRY: int = 311;

ACT_SHELF_LINK: int = 312;

ACT_SHELF_STEP: int = 313;

ACT_SHELF_BROWSE: int = 314;

ACT_SHELF_DELETE: int = 315;

// A commentary's section's verses tapped beside the page (arg chapter *
// 1000 + verse): the page there.
ACT_SHELF_VERSES: int = 316;

// Go To's Show All (what can be downloaded): Bibles and Books searching
// for what Go To's field holds.
ACT_SHELF_SEARCH: int = 317;

// The Library's argument when opened searching for the query already set
// (Go To's Show All), rather than at a segment.
SHELF_BROWSE_SEARCHING: int = -2;

// Go To's Read Beside on a Bookshelf Bible (arg its slot).
ACT_SHELF_BESIDE: int = 318;

// The Library's argument when opened as Settings' Version: the Bibles
// alone, titled Version.
SHELF_BROWSE_VERSIONS: int = -3;

// The Library's argument as the panel's first screen, made under what it
// reads (sk_beside_make): as it was, its catalog read once it is shown
// (not at a launch, under a commentary).
SHELF_BROWSE_UNDER: int = -4;

// Whether the Library shows the Bibles alone (SHELF_BROWSE_VERSIONS).
shelf_browse_versions: bool = false;

// Go To's matches from the catalog, at most.
SHELF_GOTO_MATCHES_MOST: int = 6;

// (An entry's or part's place in a screen's argument.)
SHELF_PLACE: int = 1000000;

// Browse: its kind (0 Bibles, 1 Commentaries, 2 Dictionaries, 3 Books),
// the language it shows (its name's bytes; none: English, then the others'
// rows), and what its field searches for (lower case).
shelf_browse_kind: int = 0;

// The catalog entry whose language Browse shows (-1: English, then the
// others' rows). A catalog made again shows English (shelf_catalog_came).
shelf_browse_language_at: int = -1;

shelf_query: []i8 = new i8[256](0i8);

shelf_query_n: int = 0;

// The Library's segments, the kinds of module each lists
// (shelf_segment_of).
shelf_segment_titles: []str = ["Bibles", "Commentaries", "Dictionaries", "Books"];

SHELF_SEGMENTS: int = 4;

SHELF_SEGMENT_BIBLES: int = 0;

SHELF_SEGMENT_COMMENTARIES: int = 1;

// The Browse segment a module's kind is listed in (-1: none).
shelf_segment_of(kind: ModuleKind): int {
    match kind {
        Bible -> 0;
        Commentary -> 1;
        Dictionary -> 2;
        Glossary -> 2;
        Devotional -> 3;
        Book -> 3;
        _ -> -1
    }
}

// Browse shown in the language of catalog entry at (-1: English, then the
// others' rows).
shelf_browse_language_set(at: int) {
    shelf_browse_language_at = -1;
    if (at < 0 || shelf_catalog == null) return;
    borrow shelf_catalog as catalog {
        if (at < catalog.count) shelf_browse_language_at = at
    }
}

// The Details screen's argument for item i: its catalog place, else -1 -
// its slot.
shelf_item_arg(i: int): int {
    at: int = shelf_catalog_find_item(i);
    if (at >= 0) at else -1 - shelf_slot_at(i)
}

// The item a Details argument names (-1: none on the shelf), and its
// catalog entry (-1: none).
shelf_arg_item(arg: int): int {
    if (arg < 0) return shelf_find_slot(-1 - arg);
    if (shelf_catalog == null) return -1;
    i: int = -1;
    borrow shelf_catalog as catalog {
        if (arg < catalog.count) i = shelf_find(catalog.entries[arg].info.name)
    }
    i
}

shelf_arg_entry(arg: int): int {
    if (arg >= 0) return if (arg < shelf_catalog_count()) arg else -1;
    shelf_catalog_find_item(shelf_find_slot(-1 - arg))
}

shelf_catalog_count(): int {
    if (shelf_catalog == null) return 0;
    n: int = 0;
    borrow shelf_catalog as catalog {
        n = catalog.count
    }
    n
}

// ---- opening ----
// The Library at segment arg (from Go To, the Bookshelf, Study's More
// Commentaries; -1 as it was; searching, with SHELF_BROWSE_SEARCHING; the
// Bibles alone, Settings' Version, with SHELF_BROWSE_VERSIONS), its
// catalog wanted (but SHELF_BROWSE_UNDER's, as it was, until it is shown).
sk_shelf_opening(kind: int, arg: int) {
    if (kind == SCR_SHELF_BROWSE) {
        if (arg >= 0 && arg < SHELF_SEGMENTS) shelf_browse_kind = arg;
        shelf_browse_versions = arg == SHELF_BROWSE_VERSIONS;
        if (shelf_browse_versions) shelf_browse_kind = SHELF_SEGMENT_BIBLES;
        shelf_browse_language_at = -1;
        if (arg != SHELF_BROWSE_SEARCHING) shelf_query_n = 0
    }
    if (kind == SCR_SHELF_ITEM || kind == SCR_SHELF_BROWSE && arg != SHELF_BROWSE_UNDER) shelf_catalog_shown()
}

// A screen that lists the catalog shown: the catalog wanted.
shelf_catalog_shown() {
    if (shelf_can_fetch()) shelf_want_catalog()
}

// The screens that show the shelf made again (a download's progress, the
// catalog come, a module opened; Go To while it searches the catalog); a
// commentary beside the page whose text has come brought to its focus.
shelf_screens_changed() {
    // (A commentary read beside the page: its chapters that were coming.)
    pane_comments_came();
    for i in 0..sk_n {
        k: int = sk_kinds[i];
        if (k >= SCR_SHELF_BROWSE && k <= SCR_SHELF_BOOK || k == SCR_VERSE_STUDY || k == SCR_GOTO && sk_q_n > 0) {
            waited: bool = sk_ids[i] == shelf_refocus_id;
            if (waited) shelf_refocus_id = -1;
            sk_build(i);
            ui_effect("update", sk_ids[i], -1);
            if (waited && shelf_refocus_id != sk_ids[i]) ui_effect("focus", sk_ids[i],
                -1)
        }
    }
}

// A commentary beside the page made while its text was still coming (its
// id; -1 none): brought to its focus when it has come.
shelf_refocus_id: int = -1;

sk_build_shelf_screen(id: int, kind: int, arg: int) {
    if (kind == SCR_SHELF_BROWSE) sk_build_shelf_browse(id) else if (kind == SCR_SHELF_ITEM) sk_build_shelf_item(id,
        arg) else if (kind == SCR_SHELF_COMMENTARY) sk_build_shelf_commentary(id,
        arg) else if (kind == SCR_SHELF_ENTRIES) sk_build_shelf_entries(id, arg) else if (kind == SCR_SHELF_ENTRY) sk_build_shelf_entry(id,
        arg) else if (kind == SCR_SHELF_BOOK) sk_build_shelf_book(id, arg)
}

// ---- a module's row ----
// A module here, a row in a list of screen group group's (0 over the
// reader, 1 the panel): its title, a Bible's short name (and its language,
// when with_language; whether it is a bundled version's CrossWire edition); a
// tap reads it, its â“˜ its details; swiped, it is removed. What that group
// reads is checked; over the reader, a Bible's Read Beside reads it in the
// panel.
shelf_here_row(i: int, with_language: bool, group: int) {
    ui_row(UI_ITEM, ACT_SHELF_READ, shelf_slot_at(i));
    fbuf_n = 0;
    fput_shelf_title(i);
    ui_set_title_fbuf();
    ui_set_title_lines(2);
    bible: bool = shelf_kind_at(i) == SHELF_KIND_BIBLE;
    fbuf_n = 0;
    if (bible) fput_shelf_abbreviation(i);
    if (with_language) {
        if (fbuf_n > 0) fput_str(" \Â\· ");
        fput_shelf_language(i)
    }
    if (shelf_is_bundled_edition(i)) fput_str(" \Â\· CrossWire edition");
    if (fbuf_n > 0) {
        ui_set_detail_fbuf();
        ui_set_small()
    }
    ui_set_delete(ACT_SHELF_DELETE);
    reading: bool = if (group == 1) if (bible) sk_beside_reads_version(shelf_text_of(i)) else sk_beside_reads_module(shelf_slot_at(i)) else bible && shelf_text_of(i) == text_cur;
    // (As a bundled version's row: checked if it is read; its details its
    // own button.)
    ui_set_info(ACT_SHELF_INFO);
    if (reading) ui_set_acc(ACC_CHECK);
    if (bible && group == 0 && sk_panel_fits) ui_row_action("Read Beside", ACT_SHELF_BESIDE)
}

// Whether item i is a bundled version's CrossWire edition (a Bible of the
// same short name: BSB, KJV, WEB, ASV, YLT).
shelf_is_bundled_edition(i: int): bool {
    if (shelf_kind_at(i) != SHELF_KIND_BIBLE || shelf_list == null) return false;
    same: bool = false;
    borrow shelf_list as list {
        if (i < list.count)
            for t in 0..TEXT_ESV
                if (list.items[i].name == text_abbrs[t]) same = true
    }
    same
}

// The first count items' indices by title (as the catalog sorts them).
shelf_by_title(count: int): []int@new {
    order: []int = new int[count](0);
    for i in 0..count {
        k: int = i;
        while (k > 0 && shelf_title_before(i, order[k - 1])) {
            order[k] = order[k - 1];
            k = k - 1
        }
        order[k] = i
    }
    order
}

shelf_title_before(a: int, b: int): bool {
    if (shelf_list == null) return false;
    before: bool = false;
    borrow shelf_list as list {
        if (a < list.count && b < list.count) before = text_compare_folded(list.items[a].title,
            list.items[b].title) < 0
    }
    before
}

// The first count items' indices, the latest read first (those never read
// in the shelf's order, after them).
shelf_by_latest(count: int): []int@new {
    order: []int = new int[count](0);
    for i in 0..count {
        used: int = shelf_used_at(i);
        k: int = i;
        while (k > 0 && shelf_used_at(order[k - 1]) < used) {
            order[k] = order[k - 1];
            k = k - 1
        }
        order[k] = i
    }
    order
}

shelf_bytes(): int {
    n: int = 0;
    for i in 0..shelf_count()
        if (shelf_ready_at(i)) n = n + shelf_size_at(i);
    n
}

// A module downloading or waiting its turn: its progress, else whether it
// waits or why it stopped (a tap tries again).
shelf_downloading_row(i: int) {
    slot: int = shelf_slot_at(i);
    ui_row(UI_ITEM, ACT_SHELF_RETRY, slot);
    fbuf_n = 0;
    fput_shelf_title(i);
    ui_set_title_fbuf();
    ui_set_title_lines(2);
    ui_set_delete(ACT_SHELF_DELETE);
    fbuf_n = 0;
    if (shelf_progress(slot) >= 0) {
        shelf_progress_shown(slot);
        return
    }
    if (slot == shelf_failed_slot) {
        fput_str(if (shelf_failed_offline) "Waiting for a connection \Â\· Tap to Try Again" else "Couldn\â\€\™t download \Â\· Tap to Try Again");
        ui_set_detail_fbuf();
        ui_set_small();
        ui_set_icon("exclamationmark.triangle");
        return
    }
    fput_str(if (hd_network == NET_NONE) "Waiting for a connection" else "Waiting");
    fput_str(" \Â\· ");
    fput_size(shelf_size_at(i));
    ui_set_detail_fbuf();
    ui_set_small();
    ui_set_faint()
}

// The row just begun showing slot's download (coming now): a bar, its
// progress, and under its title the phase it is in.
shelf_progress_shown(slot: int) {
    ui_set_custom(CUSTOM_DOWNLOAD);
    ui_rows[ui_last()].value = shelf_progress(slot);
    fbuf_n = 0;
    fput_str(if (shelf_fetching_slot(slot)) "Downloading" else "Preparing");
    ui_set_detail_fbuf();
    ui_set_small()
}

// Whether slot's package is being fetched now.
shelf_fetching_slot(slot: int): bool {
    match shelf_fetch {
        FetchingPackage p -> p.slot == slot;
        _ -> false
    }
}

// Slot's download's progress in thousandths (-1: not coming now): its
// package fetched (SHELF_DOWNLOAD_SHARE of it), then made.
shelf_progress(slot: int): int {
    match shelf_fetch {
        FetchingPackage p -> {
            if (p.slot == slot) {
                if (shelf_fetch_total <= 0) return 0;
                got: int = shelf_fetch_got * SHELF_DOWNLOAD_SHARE / shelf_fetch_total;
                return if (got > SHELF_DOWNLOAD_SHARE) SHELF_DOWNLOAD_SHARE else got
            }
        }
        _ -> { }
    }
    i: int = shelf_find_slot(slot);
    if (i < 0 || !shelf_ready_at(i) || !shelf_coming_at(i)) return -1;
    if (!shelf_making_slot(slot)) return SHELF_DOWNLOAD_SHARE;
    done: int = SHELF_DOWNLOAD_SHARE + (1000 - SHELF_DOWNLOAD_SHARE) * shelf_work_done / 1000;
    if (done > 999) 999 else done
}

// ---- the Library ----
// Whether the catalog's entry is on the shelf coming (not made yet): its
// item (-1: not).
shelf_catalog_coming(entry: *CatalogEntry): int {
    i: int = shelf_find(entry.info.name);
    if (i >= 0 && shelf_coming_at(i)) i else -1
}

// The Bookshelf: the kind chosen's modules (every kind's that match what is
// typed, when searching). What is on this device first, each a row that
// reads it: the bundled versions, the original languages and the ESV
// among the Bibles, then those downloaded, the latest read first. Then the
// catalog's others, each a row that downloads it (its progress in its
// row while it comes): English first, then each language a row of its
// own. A bundled version's own edition in the catalog isn't listed (the
// bundled one is).
sk_build_shelf_browse(id: int) {
    ui_begin(id, SCR_SHELF_BROWSE, 0, if (shelf_browse_versions) "Version" else "Bookshelf");
    if (!shelf_browse_versions) {
        fbuf_n = 0;
        for segment in 0..SHELF_SEGMENTS {
            if (segment > 0) fput(124);
            fput_str(shelf_segment_titles[segment])
        }
        ui_set_segments_fbuf(shelf_browse_kind, ACT_SHELF_KIND)
    }
    ui_set_search("Titles and Languages");
    ui_set_search_text(shelf_query, shelf_query_n);
    searching: bool = shelf_query_n > 0;
    // (Every kind's matches when searching, but as Version, the Bibles'.)
    every_kind: bool = searching && !shelf_browse_versions;
    shown: int = shelf_document_rows(if (every_kind) -1 else shelf_browse_kind, shelf_query,
        shelf_query_n, DocumentHeading.OnThisDevice, sk_group_of(id));
    if (!shelf_can_fetch()) {
        ui_section("", "Downloads aren\â\€\™t available here.");
        if (searching && shown == 0) shelf_nothing_matches_row();
        return
    }
    if (shelf_catalog == null) {
        match shelf_catalog_state {
            Failed f -> {
                ui_section("", "");
                fbuf_n = 0;
                if (f.offline) {
                    fput_str("The library\â\€\™s list comes from ");
                    fput_str(SHELF_SOURCE_NAME);
                    fput_str(". Connect to the internet, then try again.")
                } else {
                    fput_str(SHELF_SOURCE_SHORT_NAME);
                    fput_str("\â\€\™s library couldn\â\€\™t be reached. Try again in a while.")
                }
                ui_set_footer_fbuf();
                ui_row(UI_ITEM, 0, 0);
                ui_set_title(if (f.offline) "No Connection" else "The Library Didn\â\€\™t Answer");
                ui_set_icon("wifi.exclamationmark");
                ui_row(UI_BUTTON, ACT_SHELF_REFRESH, 0);
                ui_set_title("Try Again")
            }
            _ -> {
                ui_section("", "");
                ui_row(UI_ITEM, 0, 0);
                ui_set_title("Getting the library\â\€\™s list\â\€\¦");
                ui_set_busy();
                ui_set_faint()
            }
        }
        return
    }
    borrow shelf_catalog as catalog {
        section_language: str = "-";
        section_kind: int = -1;
        // (Each kind's matches when searching, the language in each row;
        // else the kind chosen's, a section each language.)
        for i in 0..catalog.count {
            entry: *CatalogEntry = &catalog.entries[i];
            segment: int = shelf_segment_of(entry.info.kind);
            // (The English modules, or the language chosen's, or every match.)
            coming: int = shelf_catalog_coming(entry);
            if (segment >= 0 && (every_kind || segment == shelf_browse_kind) && (coming >= 0 || shelf_catalog_lists(entry)) && shelf_browse_shows(catalog,
                entry, searching)) {
                if (searching) {
                    if (segment != section_kind) {
                        section_kind = segment;
                        ui_section(shelf_segment_titles[segment], "")
                    }
                } else {
                    language: str = language_name(entry.info.language);
                    if (language != section_language) {
                        section_language = language;
                        ui_section(language, "")
                    }
                }
                if (coming >= 0) shelf_downloading_row(coming) else shelf_catalog_row(entry,
                    i, searching, true);
                shown = shown + 1
            }
        }
        if (searching && shown == 0) shelf_nothing_matches_row();
        // (The other languages, a row each with how many it has.)
        if (!searching && shelf_browse_language_at < 0) shelf_language_rows(catalog);
        if (!searching && shelf_browse_language_at >= 0) {
            ui_section("", "");
            ui_row(UI_ITEM, ACT_SHELF_LANGUAGE, -1);
            ui_set_title("All Languages");
            ui_set_tinted()
        }
    }
    ui_section("", "");
    fbuf_n = 0;
    fput_str("From ");
    fput_str(SHELF_SOURCE_NAME);
    fput_str("\â\€\™s SWORD library");
    day: int = shelf_catalog_day();
    today: int = sk_local_day(time(0));
    if (day > 0) {
        fput_str(" \Â\· Updated ");
        if (day == today) fput_str("today") else if (day == today - 1) fput_str("yesterday") else fput_date(day)
    }
    fput(46);
    bytes: int = shelf_bytes();
    if (bytes > 0) {
        fput_str(" Downloads kept on this ");
        fput_str(sk_device_prose);
        fput_str(": ");
        fput_size(bytes);
        fput(46)
    }
    ui_set_footer_fbuf();
    match shelf_catalog_state {
        Coming -> {
            ui_row(UI_ITEM, 0, 0);
            ui_set_title("Checking for Updates\â\€\¦");
            ui_set_busy();
            ui_set_faint()
        }
        _ -> {
            ui_row(UI_ITEM, ACT_SHELF_REFRESH, 0);
            ui_set_title("Check for Updates");
            ui_set_tinted()
        }
    }
}

// Whether a Bible in the catalog is one that comes with the app (by its
// module's name: BSB, KJV, WEB, ASV, YLT).
shelf_bundled(info: *ModuleInfo): bool {
    match info.kind {
        Bible -> { }
        _ -> return false
    }
    for t in 0..TEXT_ESV
        if (info.name == text_abbrs[t]) return true;
    false
}

// Whether Browse lists the entry: when searching, if its title, short
// name or language holds what is typed; else if it is in the language
// shown (English when none is chosen).
shelf_browse_shows(catalog: *ShelfCatalog, entry: *CatalogEntry, searching: bool): bool {
    if (searching) return shelf_matches(entry.info.description) || shelf_matches(entry.info.name) || shelf_matches(language_name(entry.info.language));
    if (shelf_browse_language_at < 0 || shelf_browse_language_at >= catalog.count) return language_is_english(entry.info.language);
    language_name(entry.info.language) == language_name(catalog.entries[shelf_browse_language_at].info.language)
}

shelf_matches(text: str): bool {
    text_holds_query(text, shelf_query, shelf_query_n)
}

// Whether text holds query's first query_n bytes (in lower case), its
// capitals read as lower case. Every text holds an empty query.
text_holds_query(text: str, query: []i8, query_n: int): bool {
    if (query_n == 0) return true;
    for start in 0..len(text) - query_n + 1 {
        same: bool = true;
        k: int = 0;
        while (same && k < query_n) {
            x: int = text[start + k] as int & 255;
            if (x >= 'A' as int && x <= 'Z' as int) x = x + 32;
            if (x != (query[k] as int & 255)) same = false;
            k = k + 1
        }
        if (same) return true
    }
    false
}

// Whether the catalog's entry is listed among those to download: not on
// the Bookshelf already (here or coming), nor a bundled version's own
// edition.
shelf_catalog_lists(entry: *CatalogEntry): bool {
    shelf_find(entry.info.name) < 0 && !shelf_bundled(&entry.info)
}

// The Library's search found nothing: a faint row says so.
shelf_nothing_matches_row() {
    ui_section("", "");
    ui_row(UI_ITEM, 0, 0);
    fbuf_n = 0;
    fput_str("Nothing matches \â\€\œ");
    fput_bytes(shelf_query, 0, shelf_query_n);
    fput_str("\â\€\");
    ui_set_title_fbuf();
    ui_set_faint()
}

// The catalog's entries to download whose title, short name or language
// holds the query (Go To's, in lower case), the first few a row each, then
// Show All (in Bibles and Books) if there are more.
shelf_catalog_matches(query: []i8, query_n: int) {
    if (query_n == 0 || shelf_catalog == null) return;
    shown: int = 0;
    more: bool = false;
    borrow shelf_catalog as catalog {
        for i in 0..catalog.count {
            entry: *CatalogEntry = &catalog.entries[i];
            if (!more && shelf_segment_of(entry.info.kind) >= 0 && shelf_catalog_lists(entry) && (text_holds_query(entry.info.description,
                query, query_n) || text_holds_query(entry.info.name, query, query_n) || text_holds_query(language_name(entry.info.language),
                query, query_n))) {
                if (shown == SHELF_GOTO_MATCHES_MOST) more = true else {
                    if (shown == 0) ui_section("To Download", "");
                    shelf_catalog_row(entry, i, true, false);
                    shown = shown + 1
                }
            }
        }
    }
    if (!more) return;
    ui_row(UI_ITEM, ACT_SHELF_SEARCH, 0);
    ui_set_title("Show All to Download");
    ui_set_tinted();
    ui_set_acc(ACC_MORE)
}

// ---- the documents here ----
// How a list of the documents on this device is headed: one section, "On
// This iPhone" (the Library's), or a section each kind, named for it (Go
// To's).
type DocumentHeading =
    | OnThisDevice
    | ByKind

// The documents on this device of Library segment (-1: every kind) whose
// names hold query's first query_n bytes (in lower case; none: every
// one), a row each, under heading; how many. Among the Bibles, the
// bundled versions, the original languages and the ESV (where they are
// offered), then the Bookshelf's; of the others, the Bookshelf's. The
// Bookshelf's are listed the latest read first.
shelf_document_rows(
    segment: int,
    query: []i8,
    query_n: int,
    heading: DocumentHeading,
    group: int
): int {
    count: int = shelf_count();
    latest: []int = shelf_by_latest(count);
    by_title: []int = shelf_by_title(count);
    shown: int = 0;
    for s in 0..SHELF_SEGMENTS {
        if (segment < 0 || segment == s) {
            in_segment: int = 0;
            // (Bibles, the versions to choose among, by title; the others
            // the latest read first.)
            order: []int = if (s == SHELF_SEGMENT_BIBLES) by_title else latest;
            if (s == SHELF_SEGMENT_BIBLES) {
                for j in 0..shelf_offered_places() {
                    t: int = shelf_offered_version(j);
                    // (The panel reads only what it can: not the ESV.)
                    if (t >= 0 && (group == 0 || sk_beside_can_read(t)) && shelf_version_matches(t,
                        query, query_n)) {
                        shelf_document_heading(heading, s, shown + in_segment, in_segment);
                        sk_version_row(t, group);
                        in_segment = in_segment + 1
                    }
                }
            }
            for k in 0..count {
                i: int = order[k];
                // (A bundled version's own edition only in the Library,
                // where it can be removed: the bundled one is read.)
                listed: bool = match heading {
                    OnThisDevice -> true;
                    ByKind -> !shelf_is_bundled_edition(i)
                };
                if (listed && shelf_here_at(i) && shelf_segment_of(shelf_kind_of(shelf_kind_at(i))) == s && shelf_item_matches(i,
                    query, query_n)) {
                    shelf_document_heading(heading, s, shown + in_segment, in_segment);
                    shelf_here_row(i, query_n > 0, group);
                    in_segment = in_segment + 1
                }
            }
            shown = shown + in_segment
        }
    }
    shown
}

// The first document here whose name holds the query, in the order Go To
// lists them, read from screen at (Return in Go To's field); whether there
// was one.
shelf_read_first_document(at: int, query: []i8, query_n: int): bool {
    for j in 0..shelf_offered_places() {
        t: int = shelf_offered_version(j);
        if (t >= 0 && shelf_version_matches(t, query, query_n)) {
            sk_use_version(t);
            sk_dismiss();
            return true
        }
    }
    count: int = shelf_count();
    order: []int = shelf_by_latest(count);
    for s in 0..SHELF_SEGMENTS {
        for k in 0..count {
            i: int = order[k];
            if (shelf_here_at(i) && shelf_segment_of(shelf_kind_of(shelf_kind_at(i))) == s && shelf_item_matches(i,
                query, query_n)) {
                shelf_read(at, i);
                return true
            }
        }
    }
    false
}

// The section a document's row goes in begun, if it is the first of its
// list (shown, the rows before it) or of its kind's (in_segment).
shelf_document_heading(
    heading: DocumentHeading,
    segment: int,
    shown: int,
    in_segment: int
) {
    match heading {
        OnThisDevice -> {
            if (shown > 0) return;
            ui_section("", "");
            fbuf_n = 0;
            fput_str("On This ");
            fput_str(sk_device);
            ui_set_header_fbuf()
        }
        ByKind -> {
            if (in_segment == 0) ui_section(shelf_segment_titles[segment], "")
        }
    }
}

// The versions offered that aren't the Bookshelf's, j their place: those
// a skin bundles, then the original languages', then the ESV; -1 for one
// not offered (or past them).
shelf_offered_places(): int {
    len(sk_versions) + 2
}

shelf_offered_version(j: int): int {
    bundled: int = len(sk_versions);
    if (j < bundled) return sk_versions[j];
    if (j == bundled) return if (sk_has_orig) TEXT_ORIG else -1;
    if (j == bundled + 1) return if (sk_esv_listed) TEXT_ESV else -1;
    -1
}

// Whether version t's name, short name or language holds the query.
shelf_version_matches(t: int, query: []i8, query_n: int): bool {
    if (text_holds_query(text_names[t], query, query_n) || text_holds_query(text_abbrs[t],
        query, query_n)) return true;
    if (t == TEXT_ORIG) text_holds_query("Hebrew", query, query_n) || text_holds_query("Greek",
        query, query_n) else text_holds_query("English", query, query_n)
}

// Whether item i's title, short name, module name or language holds the
// query.
shelf_item_matches(i: int, query: []i8, query_n: int): bool {
    if (query_n == 0) return true;
    if (i < 0 || shelf_list == null) return false;
    holds: bool = false;
    borrow shelf_list as list {
        if (i < list.count) {
            item: *ShelfItem = &list.items[i];
            holds = text_holds_query(item.title, query, query_n) || text_holds_query(item.abbreviation,
                query, query_n) || text_holds_query(item.name, query, query_n) || text_holds_query(language_name(item.language),
                query, query_n)
        }
    }
    holds
}

// A row of the catalog: its title, its size (a Bible's short name before
// it; its language, with_language; why it can't be read, if it can't). A
// tap downloads it where downloads (the Bookshelf's: its â“˜ its details,
// its progress in its row once it comes); else, and for one that can't be
// read or a Bible with the shelf full, its details (and Download).
shelf_catalog_row(
    entry: *CatalogEntry,
    at_catalog: int,
    with_language: bool,
    downloads: bool
) {
    readable: bool = match entry.support {
        Readable -> true;
        Unreadable _ -> false
    };
    fetches: bool = downloads && readable && !shelf_full_for(entry.info.kind);
    ui_row(UI_ITEM, if (fetches) ACT_SHELF_DOWNLOAD else ACT_SHELF_ITEM, at_catalog);
    ui_set_title(entry.info.description);
    ui_set_title_lines(2);
    fbuf_n = 0;
    if (shelf_kind_code(entry.info.kind) == SHELF_KIND_BIBLE) {
        fput_str(shelf_short_name(&entry.info));
        fput_str(" \Â\· ")
    }
    if (with_language) {
        fput_str(language_name(entry.info.language));
        fput_str(" \Â\· ")
    }
    fput_size(entry.info.install_size);
    if (!readable) fput_str(" \Â\· Can\â\€\™t be read here");
    ui_set_detail_fbuf();
    ui_set_small();
    if (fetches) {
        ui_set_icon("arrow.down.circle");
        ui_set_info(ACT_SHELF_ITEM)
    } else ui_set_acc(ACC_MORE);
    if (!readable) ui_set_faint()
}

// The languages other than English with modules of the kind shown, a row
// each: its name, how many.
shelf_language_rows(catalog: *ShelfCatalog) {
    header: bool = false;
    last: str = "";
    last_at: int = -1;
    count: int = 0;
    for i in 0..catalog.count + 1 {
        language: str = "";
        listed: bool = false;
        if (i < catalog.count) {
            entry: *CatalogEntry = &catalog.entries[i];
            listed = shelf_segment_of(entry.info.kind) == shelf_browse_kind && !language_is_english(entry.info.language) && shelf_catalog_lists(entry);
            if (listed) language = language_name(entry.info.language)
        }
        if (i == catalog.count || listed && language != last) {
            if (count > 0) {
                if (!header) {
                    ui_section("Other Languages", "");
                    header = true
                }
                ui_row(UI_ITEM, ACT_SHELF_LANGUAGE, last_at);
                ui_set_title(last);
                fbuf_n = 0;
                fput_int(count);
                ui_set_detail_fbuf();
                ui_set_value_detail();
                ui_set_acc(ACC_MORE)
            }
            last = language;
            last_at = i;
            count = 0
        }
        if (listed) count = count + 1
    }
}

// ---- a module's details ----
shelf_kind_words: []str = ["Bible", "Commentary", "Dictionary", "Glossary", "Devotional",
    "Book", "Pictures", "Other"];

sk_build_shelf_item(id: int, arg: int) {
    i: int = shelf_arg_item(arg);
    at: int = shelf_arg_entry(arg);
    if (at < 0 && i < 0) {
        ui_begin(id, SCR_SHELF_ITEM, arg, "");
        ui_set_empty("books.vertical", "Not in the Library", "");
        return
    }
    if (at < 0) {
        // (Installed, but not in the catalog read: what the shelf keeps.)
        ui_begin(id, SCR_SHELF_ITEM, arg, "");
        fbuf_n = 0;
        if (shelf_kind_at(i) == SHELF_KIND_BIBLE) fput_shelf_abbreviation(i);
        ui_set_screen_title_fbuf();
        ui_section("", "");
        ui_row(UI_TEXT, 0, 0);
        ui_rich_begin();
        fput_shelf_title(i);
        ui_rich(RUN_STRONG);
        ui_rich_title();
        shelf_item_actions(i, arg, true, false, 0);
        shelf_item_report(i);
        return
    }
    borrow shelf_catalog as catalog {
        entry: *CatalogEntry = &catalog.entries[at];
        info: *ModuleInfo = &entry.info;
        // (Titled by a Bible's short name, as KJV; another's is a module's
        // name, as CalvinCommentaries, its title in full below.)
        ui_begin(id, SCR_SHELF_ITEM, arg, if (shelf_kind_code(info.kind) == SHELF_KIND_BIBLE) shelf_short_name(info) else "");
        ui_page = true;
        ui_section("", "");
        ui_row(UI_TEXT, 0, 0);
        ui_rich_begin();
        fput_str(info.description);
        ui_rich(RUN_STRONG);
        fput(10);
        fput_str(shelf_kind_words[shelf_kind_code(info.kind)]);
        fput_str(" \Â\· ");
        fput_str(language_name(info.language));
        if (len(info.version) > 0) {
            fput_str(" \Â\· Version ");
            fput_str(info.version)
        }
        ui_rich(RUN_SMALL);
        ui_rich_title();
        readable: bool = true;
        why: str = "";
        match entry.support {
            Unreadable u -> {
                readable = false;
                why = shelf_unreadable_words(u.reason)
            }
            Readable -> { }
        }
        shelf_item_actions(i, arg, readable, shelf_full_for(info.kind), info.install_size);
        if (!readable) {
            ui_row(UI_TEXT, 0, 0);
            ui_rich_begin();
            fput_str(why);
            ui_rich(RUN_FAINT);
            ui_rich_title()
        }
        if (shelf_bundled(info)) {
            ui_row(UI_TEXT, 0, 0);
            ui_rich_begin();
            fput_str("Smooth Bible comes with its own ");
            fput_str(info.name);
            fput_str(". This is CrossWire\â\€\™s edition of it.");
            ui_rich(RUN_FAINT);
            ui_rich_title()
        }
        if (info.questionable) {
            ui_row(UI_TEXT, 0, 0);
            ui_rich_begin();
            fput_str(SHELF_SOURCE_SHORT_NAME);
            fput_str(" lists this among works whose teaching is outside mainstream Christianity.");
            ui_rich(RUN_FAINT);
            ui_rich_title()
        }
        if (i >= 0) shelf_item_report(i);
        about: []str = about_paragraphs(info.about);
        if (len(about) > 0) {
            ui_section("About", "");
            for p in about shelf_text_row(p)
        }
        ui_section("Details", "");
        shelf_detail_row("Size", "");
        fbuf_n = 0;
        fput_size(info.install_size);
        ui_set_detail_fbuf();
        if (len(info.date) > 0) shelf_detail_row("Updated", info.date);
        match info.storage {
            ByVerse _ -> shelf_detail_row("Verse Numbering", info.versification);
            _ -> { }
        }
        shelf_detail_row("Format", shelf_markup_words(info.markup));
        shelf_detail_row("Module", info.name);
        if (len(info.license) > 0 || len(info.copyright) > 0) {
            ui_section("License", "");
            if (len(info.license) > 0)
                for p in about_paragraphs(info.license) shelf_text_row(p);
            if (len(info.copyright) > 0)
                for p in about_paragraphs(info.copyright) shelf_text_row(p)
        }
        ui_section("", "");
        fbuf_n = 0;
        fput_str("From ");
        fput_str(SHELF_SOURCE_NAME);
        fput_str("\â\€\™s SWORD library.");
        ui_set_footer_fbuf()
    }
}

shelf_text_row(text: str) {
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    fput_str(text);
    ui_rich(RUN_PLAIN);
    ui_rich_title()
}

shelf_detail_row(title: str, value: str) {
    ui_row(UI_ITEM, 0, 0);
    ui_set_title(title);
    ui_set_detail(value);
    ui_set_value_detail()
}

shelf_markup_words(markup: Markup): str {
    match markup {
        Osis -> "OSIS";
        Thml -> "ThML";
        Gbf -> "GBF";
        Tei -> "TEI";
        Plain -> "Plain text"
    }
}

shelf_unreadable_words(reason: UnsupportedReason): str {
    match reason {
        Locked -> "Its publisher locks it with a key it sells, which this app can\â\€\™t use yet.";
        Storage _ -> "It\â\€\™s stored in a way this app can\â\€\™t read yet.";
        Compressed _ -> "It\â\€\™s compressed in a way this app can\â\€\™t read yet.";
        Numbering _ -> "Its verses are numbered in a way this app doesn\â\€\™t know yet.";
        Pictures -> "It\â\€\™s a collection of maps or pictures, which this app can\â\€\™t show yet."
    }
}

// Details' buttons: Download (its size) for one not on the shelf (not
// while the shelf has no room for it: full); its progress and Stop
// Download while it comes; Read and Remove once here.
shelf_item_actions(
    i: int,
    arg: int,
    readable: bool,
    full: bool,
    size: int
) {
    ui_section("", "");
    if (i < 0) {
        if (full) {
            fbuf_n = 0;
            fput_str("Your bookshelf has room for ");
            fput_int(TEXT_SHELF_MOST);
            fput_str(" Bibles. Remove one to download another.");
            ui_set_footer_fbuf()
        }
        ui_row(UI_BUTTON, ACT_SHELF_DOWNLOAD, arg);
        fbuf_n = 0;
        fput_str("Download \Â\· ");
        fput_size(size);
        ui_set_title_fbuf();
        if (!readable || full) ui_set_disabled(true);
        return
    }
    slot: int = shelf_slot_at(i);
    if (shelf_coming_at(i)) {
        shelf_downloading_row(i);
        ui_row(UI_BUTTON, ACT_SHELF_STOP, slot);
        ui_set_title("Stop Download");
        ui_set_destructive();
        return
    }
    bible: bool = shelf_kind_at(i) == SHELF_KIND_BIBLE;
    ui_row(UI_BUTTON, ACT_SHELF_OPEN, slot);
    ui_set_title(if (bible) if (shelf_text_of(i) == text_cur) "Reading Now" else "Read" else "Open");
    if (bible && shelf_text_of(i) == text_cur) ui_set_disabled(true);
    ui_row(UI_BUTTON, ACT_SHELF_REMOVE, slot);
    ui_set_title("Remove from Bookshelf");
    ui_set_destructive()
}

// A Bible's report, once it has been opened: what it lacks, and what of
// it this app can't show.
shelf_item_report(i: int) {
    if (shelf_kind_at(i) != SHELF_KIND_BIBLE) return;
    report: BibleReport = shelf_report_at(i);
    if (report.verses < 0) return;
    if (report.missing_books == 0 && report.outside_chapters <= 0 && report.extra_books == 0) return;
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    if (report.missing_books == 39) fput_str("It has the New Testament only.") else if (report.missing_books == 27) fput_str("It has the Old Testament only.") else if (report.missing_books > 0) {
        fput_str("It has ");
        fput_int(66 - report.missing_books);
        fput_str(" of the 66 books.")
    }
    if (report.extra_books > 0) {
        if (fbuf_n > 0) fput(32);
        fput_int(report.extra_books);
        fput_str(if (report.extra_books == 1) " book beyond the 66 isn\â\€\™t shown yet." else " books beyond the 66 aren\â\€\™t shown yet.")
    }
    if (report.outside_chapters > 0) {
        if (fbuf_n > 0) fput(32);
        fput_int(report.outside_chapters);
        fput_str(if (report.outside_chapters == 1) " chapter numbered differently from this app\â\€\™s isn\â\€\™t shown." else " chapters numbered differently from this app\â\€\™s aren\â\€\™t shown.")
    }
    ui_rich(RUN_FAINT);
    ui_rich_title()
}

// ---- a module's text as rows ----
// What a folio's records make as page paragraphs (core/shelf_folio.l8's
// records_rows): a row each paragraph, at most SHELF_RUNS_MOST runs and
// SHELF_LINKS_MOST links a row; at the rows' limit, a last row says the
// rest isn't shown.
SHELF_RUNS_MOST: int = 240;

SHELF_LINKS_MOST: int = 120;

type RichRows = {
    // The paragraph being made: its runs and links so far.
    open: bool;
    heading: bool;
    runs: int;
    link_from: []int;
    link_to: []int;
    link_ref: []int;
    links: int;
    // The link open: where it began (UTF-16) and where it goes (-1: not
    // a reference this app can show).
    link_at: int;
    link_target: int;
    stopped: bool
}

rich_rows_new(): RichRows@new {
    RichRows {
        open: false,
        heading: false,
        runs: 0,
        link_from: new int[SHELF_LINKS_MOST](0),
        link_to: new int[SHELF_LINKS_MOST](0),
        link_ref: new int[SHELF_LINKS_MOST](0),
        links: 0,
        link_at: -1,
        link_target: -1,
        stopped: false
    }
}

rich_rows_end(rows: *RichRows, link_action: int) {
    if (!rows.open) return;
    ui_rich_title();
    if (rows.heading) ui_set_heading();
    for l in 0..rows.links ui_add_link(rows.link_from[l], rows.link_to[l], link_action,
        rows.link_ref[l]);
    rows.open = false;
    rows.runs = 0;
    rows.links = 0
}

rich_rows_begin(rows: *RichRows, heading: bool) {
    if (rows.open || rows.stopped) return;
    // (Room for the paragraph and what says the rest isn't shown.)
    if (ui_rows_n + 2 >= UI_ROWS_MOST || ui_pool_n > len(ui_pool) - 65536 || ui_runs_n + 2 * SHELF_RUNS_MOST + 4 > len(ui_runs) || ui_links_n + SHELF_LINKS_MOST > len(ui_links)) {
        rows.stopped = true;
        ui_row(UI_TEXT, 0, 0);
        ui_rich_begin();
        fput_str("The rest is too long to show here.");
        ui_rich(RUN_FAINT);
        ui_rich_title();
        return
    }
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    rows.open = true;
    rows.heading = heading;
    rows.runs = 0;
    rows.links = 0
}

// ---- a commentary on a chapter (from Bookshelf) ----
// Its arg: slot * SHELF_PLACE + the chapter (through the Bible).
// A reading's subtitle: the module it is of, by its title (the shelf's
// item i).
sk_shelf_subtitle(i: int) {
    if (i < 0) return;
    fbuf_n = 0;
    fput_shelf_title(i);
    ui_set_subtitle_fbuf()
}

sk_build_shelf_commentary(id: int, arg: int) {
    // (In the panel of a skin that draws a reader there: read as the page
    // is, every chapter in turn.)
    at_built: int = sk_find(id);
    if (at_built >= 0 && sk_groups[at_built] == 1) {
        bb_build_commentary_reader(id, arg);
        return
    }
    slot: int = arg / SHELF_PLACE;
    c: int = arg % SHELF_PLACE;
    i: int = shelf_find_slot(slot);
    fbuf_n = 0;
    fput_title(c);
    ui_begin(id, SCR_SHELF_COMMENTARY, arg, "");
    ui_set_screen_title_fbuf();
    sk_shelf_subtitle(i);
    ui_page = true;
    ui_tool("", "chevron.up", ACT_SHELF_STEP, -1, if (c > 0) UI_TOOL_PLAIN else UI_TOOL_OFF,
        0);
    fbuf_n = 0;
    fput_str("Previous Chapter");
    ui_set_tool_label_fbuf();
    ui_tool("", "chevron.down", ACT_SHELF_STEP, 1, if (c + 1 < chapters) UI_TOOL_PLAIN else UI_TOOL_OFF,
        2);
    fbuf_n = 0;
    fput_str("Next Chapter");
    ui_set_tool_label_fbuf();
    if (i < 0) {
        ui_set_empty("books.vertical", "Not on Your Bookshelf", "");
        return
    }
    if (!shelf_ensure_open(slot)) {
        shelf_opening_rows(slot, i);
        return
    }
    shown: int = 0;
    waiting: bool = false;
    damaged: bool = false;
    // (Made first at the comment on the page's verse, in its chapter.)
    focus_v: int = if (c == sk_c) sk_v else -1;
    borrow shelf_open[SHELF_USE_STUDY] as open {
        match open.reader {
            Document d -> {
                match shelf_folio_chapter(slot, d.folio, c) {
                    ChapterWaiting -> waiting = true;
                    ChapterDamaged -> damaged = true;
                    ChapterNone -> { }
                    ChapterRecords r -> shown = shelf_commentary_rows(r.data, c, focus_v)
                }
            }
            _ -> { }
        }
    }
    if (damaged) {
        ui_set_empty("exclamationmark.triangle", "Can\â\€\™t Read This Chapter", "");
        fbuf_n = 0;
        fput_str("This part of ");
        fput_shelf_title(i);
        fput_str(" is damaged. Remove it, then download it again.");
        ui_empty_line = ui_put_fbuf();
        return
    }
    if (waiting) {
        // (Brought to its focus once its text has come.)
        shelf_refocus_id = id;
        shelf_opening_rows(slot, i);
        return
    }
    if (shown == 0) {
        // (Only what it says: the credit under it would keep it from
        // being empty.)
        fbuf_n = 0;
        fput_shelf_title(i);
        fput_str(" has no comment on ");
        fput_title(c);
        fput(46);
        ui_set_empty("text.book.closed", "No Commentary Here", "");
        ui_empty_line = ui_put_fbuf();
        return
    }
    ui_section("", "");
    shelf_credit_row(i)
}

// A module being opened (or one that could not be): a row that says so.
shelf_opening_rows(slot: int, i: int) {
    ui_section("", "");
    ui_row(UI_ITEM, 0, 0);
    fbuf_n = 0;
    if (shelf_broken_at(i)) {
        fput_shelf_abbreviation(i);
        fput_str(" couldn\â\€\™t be opened. Remove it, then download it again.");
        ui_set_title_fbuf();
        ui_set_icon("exclamationmark.triangle");
        return
    }
    // (Still coming: its download's bar, and the phase it is in.)
    if (shelf_progress(slot) >= 0) {
        fput_shelf_abbreviation(i);
        ui_set_title_fbuf();
        shelf_progress_shown(slot);
        return
    }
    fput_str("Opening ");
    fput_shelf_abbreviation(i);
    fput_str("\â\€\¦");
    ui_set_title_fbuf();
    // (Being opened now: how far it has come, as a bar.)
    if (shelf_work_slot() == slot) {
        ui_set_custom(CUSTOM_DOWNLOAD);
        ui_rows[ui_last()].value = shelf_work_done;
        return
    }
    ui_set_busy();
    ui_set_faint()
}

shelf_credit_row(i: int) {
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    fput_shelf_title(i);
    fput_str(" \Â\· ");
    fput_str(SHELF_SOURCE_SHORT_NAME);
    ui_rich(RUN_SMALL);
    ui_rich_title()
}

// The chapter whose sections are being made (their verses a way to take
// the page there; -1 none).
commentary_verses_c: int = -1;

// Whether a chapter's layout is nearly full, with room left for a long
// paragraph or so (a comment is cut where a paragraph ends, if it is).
shelf_layout_nearly_full(ctx: *ChapterLayout): bool {
    ctx.out_n >= len(ctx.out) - 16384 || ctx.runs >= len(ctx.run_end) - 512 || ctx.verse_count >= len(ctx.verse_num) - 2
}

// Whether a layout has been filled (what was laid out after cut short):
// its text or its runs or its verses at their most, less room for the
// line that says so.
shelf_layout_full(ctx: *ChapterLayout): bool {
    ctx.out_n >= len(ctx.out) - 256 || ctx.runs >= len(ctx.run_end) - 4 || ctx.verse_count >= len(ctx.verse_num) - 1
}

// A line ended, if one is open; none is now.
shelf_lay_line_end(ctx: *ChapterLayout, open: bool): bool {
    if (open) lay_byte(ctx, 10);
    false
}

// "Verses 14â€“16" (or "Introduction" for a chapter's verse 0) heading a
// section of its own; in a commentary by chapter, a tap takes the page
// there.
commentary_section_label(from: int, through: int) {
    ui_section("", "");
    if (commentary_verses_c >= 0 && from > 0) ui_row(UI_TEXT, ACT_SHELF_VERSES, commentary_verses_c * 1000 + from) else ui_row(UI_TEXT,
        0, 0);
    ui_rich_begin();
    if (from == 0 && through == 0) fput_str("Introduction") else if (through > from) {
        fput_str("Verses ");
        fput_int(if (from == 0) 1 else from);
        fput_str("\â\€\“");
        fput_int(through)
    } else {
        fput_str("Verse ");
        fput_int(from)
    }
    ui_rich(RUN_SMALL);
    ui_rich_title();
    ui_set_heading()
}

// ---- what they do ----
sk_shelf_act(
    at: int,
    action: int,
    arg: int,
    value: int
) {
    id: int = sk_ids[at];
    a: int = sk_args[at];
    if (action == ACT_SHELF_BROWSE) {
        sk_open(SCR_SHELF_BROWSE, arg, true);
        return
    }
    if (action == ACT_SHELF_KIND) {
        shelf_browse_kind = clamp_index(value, SHELF_SEGMENTS);
        shelf_browse_language_at = -1;
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_SHELF_LANGUAGE) {
        shelf_browse_language_set(arg);
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_SHELF_ITEM) {
        sk_open(SCR_SHELF_ITEM, arg, true);
        return
    }
    if (action == ACT_SHELF_INFO) {
        i: int = shelf_find_slot(arg);
        if (i >= 0) sk_open(SCR_SHELF_ITEM, shelf_item_arg(i), true);
        return
    }
    if (action == ACT_SHELF_REFRESH) {
        shelf_refresh_catalog();
        shelf_screens_changed();
        return
    }
    if (action == ACT_SHELF_RETRY) {
        if (arg == shelf_failed_slot) shelf_failed_slot = -1;
        shelf_pump();
        shelf_screens_changed();
        return
    }
    if (action == ACT_SHELF_DOWNLOAD) {
        if (shelf_catalog == null || arg < 0 || arg >= shelf_catalog_count()) return;
        borrow shelf_catalog as catalog {
            shelf_add(&catalog.entries[arg])
        }
        return
    }
    if (action == ACT_SHELF_STOP || action == ACT_SHELF_REMOVE) {
        shelf_remove(shelf_find_slot(arg));
        return
    }
    if (action == ACT_SHELF_DELETE) {
        shelf_remove(shelf_find_slot(arg));
        return
    }
    if (action == ACT_SHELF_OPEN || action == ACT_SHELF_READ) {
        i: int = shelf_find_slot(arg);
        if (i >= 0) shelf_read(at, i);
        return
    }
    if (action == ACT_SHELF_BESIDE) {
        i: int = shelf_find_slot(arg);
        if (i < 0 || !shelf_here_at(i)) return;
        sk_dismiss();
        if (shelf_kind_at(i) == SHELF_KIND_BIBLE) sk_beside_read_version(shelf_text_of(i)) else sk_beside_read(arg);
        return
    }
    if (action == ACT_SHELF_SEARCH) {
        // (Both fields keep 256 bytes; a longer query couldn't have been
        // typed in Go To's.)
        query: []i8 = sk_folded_query();
        shelf_query_n = (if (len(query) < len(shelf_query)) len(query) else len(shelf_query));
        for x in 0..shelf_query_n shelf_query[x] = query[x];
        sk_open(SCR_SHELF_BROWSE, SHELF_BROWSE_SEARCHING, true);
        return
    }
    if (action == ACT_SHELF_ENTRY) {
        kind: int = sk_kinds[at];
        if (kind == SCR_SHELF_BOOK) sk_open(SCR_SHELF_BOOK, arg, true) else sk_open(SCR_SHELF_ENTRY,
            arg, true);
        shelf_note_place(arg);
        return
    }
    if (action == ACT_SHELF_VERSES) {
        // (Read in the panel: in the Bible beside it.)
        if (sk_groups[at] == 1) sk_beside_bible_to(arg / 1000, arg % 1000) else sk_goto(arg / 1000,
            arg % 1000);
        return
    }
    if (action == ACT_SHELF_LINK) {
        // (Read in the panel: in the Bible.)
        if (sk_groups[at] == 1) sk_beside_reference(arg) else sk_preview(arg);
        return
    }
    if (action == ACT_SHELF_STEP) {
        shelf_step(at, a, if (arg < 0) -1 else 1);
        return
    }
    _v: int = value
}

// Module i read from screen at: a Bible chosen in the panel, beside the
// page; else as the version (from Go To or its details, put away to read
// it; a list stays, the Bible checked). Any
// other at its place (shelf_open_reading): chosen over the page where the
// panel fits, beside the page, the sheets put away; else pushed where it
// was chosen (the panel's, or a sheet's).
shelf_read(at: int, i: int) {
    if (!shelf_here_at(i)) return;
    if (shelf_kind_at(i) == SHELF_KIND_BIBLE) {
        // (Chosen in the panel: read there.)
        if (sk_groups[at] == 1) {
            sk_beside_read_version(shelf_text_of(i));
            return
        }
        sk_use_version(shelf_text_of(i));
        if (sk_kinds[at] == SCR_GOTO || sk_kinds[at] == SCR_SHELF_ITEM) sk_dismiss();
        return
    }
    if (sk_groups[at] == 0 && sk_panel_fits) {
        sk_dismiss();
        sk_beside_read(shelf_slot_at(i));
        return
    }
    shelf_open_reading(i, false)
}

// Module i's screens pushed (beside: on the panel's, as it is made again;
// else over the screen acted on), and it noted as read.
shelf_open_reading(i: int, beside: bool) {
    k: int = shelf_kind_at(i);
    slot: int = shelf_slot_at(i);
    place: int = shelf_place_at(i);
    shelf_note_read(i, -1);
    if (k == SHELF_KIND_COMMENTARY) {
        shelf_push(SCR_SHELF_COMMENTARY, slot * SHELF_PLACE + (if (sk_c >= 0 && sk_c < chapters) sk_c else 0),
            beside);
        return
    }
    if (k == SHELF_KIND_BOOK) {
        shelf_push(SCR_SHELF_BOOK, slot * SHELF_PLACE, beside);
        if (place > 0) shelf_push(SCR_SHELF_BOOK, slot * SHELF_PLACE + place, beside);
        return
    }
    shelf_query_n = 0;
    shelf_push(SCR_SHELF_ENTRIES, slot, beside);
    entry: int = if (k == SHELF_KIND_DEVOTIONAL) shelf_devotional_today(slot) else if (place > 0) place else -1;
    if (entry >= 0 && entry < shelf_entry_count(slot)) shelf_push(SCR_SHELF_ENTRY,
        slot * SHELF_PLACE + entry, beside)
}

shelf_push(kind: int, arg: int, beside: bool) {
    if (beside) sk_beside_push(kind, arg) else sk_open(kind, arg, true)
}

// The commentary's chapter, the entry or the book's part before or after
// the one shown.
shelf_step(at: int, a: int, direction: int) {
    kind: int = sk_kinds[at];
    slot: int = a / SHELF_PLACE;
    place: int = a % SHELF_PLACE;
    if (kind == SCR_SHELF_COMMENTARY) {
        c: int = place + direction;
        if (c < 0 || c >= chapters) return;
        sk_args[at] = slot * SHELF_PLACE + c
    } else if (kind == SCR_SHELF_ENTRY) {
        index: int = place + direction;
        if (index < 0 || index >= shelf_entry_count(slot)) return;
        sk_args[at] = slot * SHELF_PLACE + index
    } else if (kind == SCR_SHELF_BOOK) {
        // (Its parts are in reading order: the one before or after, not the
        // whole book.)
        if (!shelf_open_is(SHELF_USE_BOOK, slot)) return;
        count: int = 0;
        borrow shelf_open[SHELF_USE_BOOK] as open {
            match open.reader {
                Document d -> count = folio::folio_division_count(d.folio);
                _ -> { }
            }
        }
        next: int = place + direction;
        if (next < 1 || next > count) return;
        sk_args[at] = slot * SHELF_PLACE + next
    } else return;
    if (kind != SCR_SHELF_COMMENTARY) shelf_note_place(sk_args[at]);
    sk_build(at);
    ui_effect("update", sk_ids[at], -1)
}

// A book's part or a dictionary's entry shown (arg slot * SHELF_PLACE +
// its index): kept as where its module is read.
shelf_note_place(arg: int) {
    shelf_note_read(shelf_find_slot(arg / SHELF_PLACE), arg % SHELF_PLACE)
}

// What a Bookshelf screen's field holds (lower case), its screen made again.
sk_shelf_typed(
    at: int,
    buf: []i8,
    b: int,
    e: int
) {
    // (Longer than the field keeps: up to its last whole character, which
    // the field then shows.)
    end: int = e;
    if (end - b > len(shelf_query)) {
        end = b + len(shelf_query);
        while (end > b && (buf[end] as int & 192) == 128) end = end - 1
    }
    shelf_query_n = 0;
    for x in b..end {
        k: int = buf[x] as int;
        shelf_query[shelf_query_n] = (if (k >= 'A' as int && k <= 'Z' as int) k + 32 else k) trunc i8;
        shelf_query_n = shelf_query_n + 1
    }
    sk_build(at);
    ui_effect("refill", sk_ids[at], 0)
}
