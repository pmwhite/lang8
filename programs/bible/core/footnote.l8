tag bible;

use_tag std;

// A footnote (DESIGN.md Â§3.1.5), apart from any platform: its title
// ("Footnote Â· John 3:16"), its words, and the references in them with a
// verse ("Cited in 2 Corinthians 4:6"), each a preview. A skin with its own
// (the iPhone's popover; SK_NUM_OWN_VIEW of SCR_FOOTNOTE) draws these;
// any other gets core's screen. A footnote is known by where its F line is
// in the BSB's text (the reader's run_arg).
import "skin.l8";

SCR_FOOTNOTE: int = 46;

ACT_FN_REF: int = 176;

// The verse the footnote at p is on (in chapter c), and its title into
// fbuf.
fn_title(c: int, p: int) {
    fbuf_n = 0;
    fput_str("Footnote \Â\· ");
    fput_ref(c, verse_at(c, p), 0)
}

// Its words into fbuf; then its references with a verse (lang.l8's nr_*:
// their places in the words, nr_b to nr_e) and each one's reference
// (fn_ref, xref_both's).
fn_ref: []int = static_buffer([64]int);

fn_text(p: int) {
    fbuf_n = 0;
    e: int = line_end(p);
    for i in p + 1..e fput(bsb[i] as int);
    note_refs(fbuf, fbuf_n);
    for r in 0..nr_n {
        fn_ref[r] = 0;
        if (nr_v[r] > 0) {
            xr_book = nr_book[r];
            xr_c = nr_c[r];
            xr_v = nr_v[r];
            xr_ce = (if (nr_ve[r] > 0) nr_c[r] else 0);
            xr_ve = (if (nr_ve[r] > 0) nr_ve[r] else 0);
            fn_ref[r] = xref_both()
        }
    }
}

// The footnote at p of chapter c shown: the host's own, or core's screen
// (presented, or pushed over the sheet up).
sk_footnote(c: int, p: int) {
    if (c < 0 || c >= chapters || p <= 0) return;
    if (sk_num_of(SK_NUM_OWN_VIEW, SCR_FOOTNOTE) == 1) {
        ui_effect("footnote", c, p);
        return
    }
    sk_open(SCR_FOOTNOTE, p, sk_n > 0)
}

// Core's screen: its title, its words (a reference with a verse a link to
// its preview).
sk_build_footnote(id: int, p: int) {
    c: int = chapter_at_offset(p);
    if (c >= 0) fn_title(c, p) else fbuf_n = 0;
    ui_begin(id, SCR_FOOTNOTE, p, "");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_page = true;
    ui_section("", "");
    fn_text(p);
    ui_row(UI_TEXT, 0, p);
    // (The places, UTF-16, before fbuf is made again by the runs.)
    for i in 0..fbuf_n fn_words[i] = fbuf[i];
    n: int = fbuf_n;
    ui_rich_begin();
    q: int = 0;
    for r in 0..nr_n {
        if (fn_ref[r] != 0) {
            fput_bytes(fn_words, q, nr_b[r]);
            ui_rich(RUN_SCRIPTURE);
            fput_bytes(fn_words, nr_b[r], nr_e[r]);
            ui_rich(RUN_ACCENT);
            q = nr_e[r]
        }
    }
    fput_bytes(fn_words, q, n);
    ui_rich(RUN_SCRIPTURE);
    ui_rich_title();
    for r in 0..nr_n
        if (fn_ref[r] != 0) ui_add_link(ui_utf16(fn_words, 0, nr_b[r]), ui_utf16(fn_words,
            0, nr_e[r]), ACT_FN_REF, fn_ref[r])
}

fn_words: []i8 = static_buffer([4096]i8)
