tag bible;

use_tag std;

// A footnote (DESIGN.md Â§3.1.5), apart from any platform: its title
// ("Footnote Â· John 3:16"), its words, and the references in them with a
// verse ("Cited in 2 Corinthians 4:6"), each a preview: core's screen (a
// phone's popover). A footnote is known by where its F line is in the
// BSB's text (the reader's run_arg).
import "skin.l8";

SCR_FOOTNOTE: int = 46;

ACT_FN_REF: int = 176;

// The verse the footnote at p is on (in chapter c), and its title into
// fbuf.
fn_title(c: int, p: int) {
    fbuf_n = 0;
    fput_str("Footnote \Â\· ");
    v: int = 0;
    borrow texts[text_cur] as text {
        v = verse_at(text, c, p)
    }
    fput_ref(c, v, 0)
}

// Its words into fbuf; then its references with a verse (lang.l8's nr_*:
// their places in the words, nr_b to nr_e) and each one's reference
// (fn_ref, xref_both's).
fn_ref: []int = new int[64](0);

fn_text(p: int) {
    fbuf_n = 0;
    // (p from a layout of the current text: if that text has been replaced
    // since, p may no longer be a footnote's line; then no words.)
    borrow texts[text_cur] as text {
        if (p >= 0 && p < text.size && text.data[p] as int == 70) {
            e: int = record_line_end(text.data, text.size, p);
            for i in p + 1..e fput(text.data[i] as int)
        }
    }
    note_refs(fbuf, fbuf_n);
    for r in 0..nr_n {
        fn_ref[r] = 0;
        if (nr_v[r] > 0) {
            xr_book = nr_book[r];
            xr_c = nr_c[r];
            xr_v = nr_v[r];
            xr_ce = (if (nr_ve[r] > 0) nr_c[r] else 0);
            xr_ve = (if (nr_ve[r] > 0) nr_ve[r] else 0);
            fn_ref[r] = xref_both()
        }
    }
}

// The footnote at p of chapter c shown: core's screen (presented, or
// pushed over the sheet up).
sk_footnote(c: int, p: int) {
    if (c < 0 || c >= chapters || p <= 0) return;
    sk_open(SCR_FOOTNOTE, p, sk_n > 0)
}

// Core's screen: its title, its words (a reference with a verse a link to
// its preview).
sk_build_footnote(id: int, p: int) {
    c: int = -1;
    borrow texts[text_cur] as text {
        c = chapter_at_offset(text, p)
    }
    if (c >= 0) fn_title(c, p) else fbuf_n = 0;
    ui_begin(id, SCR_FOOTNOTE, p, "");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_page = true;
    ui_section("", "");
    fn_text(p);
    ui_row(UI_TEXT, 0, p);
    // (The places, UTF-16, before fbuf is made again by the runs.)
    for i in 0..fbuf_n fn_words[i] = fbuf[i];
    n: int = fbuf_n;
    ui_rich_begin();
    q: int = 0;
    for r in 0..nr_n {
        if (fn_ref[r] != 0) {
            fput_bytes(fn_words, q, nr_b[r]);
            ui_rich(RUN_SCRIPTURE);
            fput_bytes(fn_words, nr_b[r], nr_e[r]);
            ui_rich(RUN_ACCENT);
            q = nr_e[r]
        }
    }
    fput_bytes(fn_words, q, n);
    ui_rich(RUN_SCRIPTURE);
    ui_rich_title();
    for r in 0..nr_n
        if (fn_ref[r] != 0) ui_add_link(ui_utf16(fn_words, 0, nr_b[r]), ui_utf16(fn_words,
            0, nr_e[r]), ACT_FN_REF, fn_ref[r])
}

fn_words: []i8 = new i8[4096](0i8)
