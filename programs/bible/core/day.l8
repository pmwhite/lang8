tag bible;

use_tag std;

// The day's reader (DESIGN.md Â§16), apart from any platform: the day shown
// (its plan and number: plans.l8's day_rows lays out its rows, dy_*), the
// passage under the bar and the title's words, Mark Read's state and words
// and the marking itself, where the day opens, and the words of the day's
// end. A skin draws the rows as its reader does, and the bar, the capsule
// and the end its own way.
import "skin.l8";

import "plans.l8";

// The day shown (its plan, -1 none; its number, from 1), and the passage
// under the bar (its index among the plans', -1 none yet).
dd_plan: int = -1;

dd_num: int = 0;

dd_k: int = -1;

// Day d of plan p shown: its rows laid out.
dd_show(p: int, d: int) {
    dd_plan = p;
    dd_num = d;
    dd_k = -1;
    day_rows(p, d)
}

// Whether the day is of a plan followed (a day of another plan is read,
// not marked).
dd_followed(): bool {
    dd_plan >= 0 && plan_slot(dd_plan) >= 0
}

// The row the day opens at: passage k's, else (k -1) its first unread
// passage's (a plan not followed: its first passage's); (k -2, Next) the
// top.
dd_open_row(k: int): int {
    if (k == -2 || dy_di < 0) return 0;
    kk: int = if (k >= 0) k else day_first_unread(dy_di);
    if (!dd_followed() && k < 0) kk = pl_r0[dy_di];
    for x in 0..dy_n
        if (dy_k[x] == kk) return x;
    0
}

// The passage under the bar is row r's: whether that changed it.
dd_at_row(r: int): bool {
    if (r < 0 || r >= dy_n || dy_k[r] == dd_k) return false;
    dd_k = dy_k[r];
    true
}

// ---- the title: the passage under the bar, and the day ----
// "Psalm 105".
dd_title() {
    fbuf_n = 0;
    if (dd_k >= 0) fput_reading(dd_k, false)
}

// "Day 32 Â· Chronological".
dd_title_line() {
    fbuf_n = 0;
    fput_str("Day ");
    fput_int(dd_num);
    fput_str(" \Â\· ");
    fput_plan_name(dd_plan)
}

// What a screen reader says of the title, one element: "Psalm 105, Day
// 32, Chronological" (Â§16.7); its hint.
dd_title_label() {
    fbuf_n = 0;
    if (dd_k >= 0) fput_reading(dd_k, false);
    fput_str(", Day ");
    fput_int(dd_num);
    fput_str(", ");
    fput_plan_name(dd_plan)
}

dd_title_hint: str = "Shows the plan\â\€\™s days";

// ---- Mark Read (Â§16.13) ----
// Whether the day is read (every passage), the capsule's title, and what a
// screen reader says of it ("Mark Day 32 as read"; "Day 32, read") and
// adds.
dd_read(): bool {
    dy_di >= 0 && day_state(dy_di) == 2
}

dd_mark_title(): str {
    if (dd_read()) "Read" else "Mark Read"
}

dd_mark_label() {
    fbuf_n = 0;
    if (dd_read()) {
        fput_str("Day ");
        fput_int(dd_num);
        fput_str(", read")
    } else {
        fput_str("Mark Day ");
        fput_int(dd_num);
        fput_str(" as read")
    }
}

dd_mark_hint(): str {
    if (dd_read()) "Double-tap to mark it unread." else ""
}

// Mark Read tapped: the whole day read, or (read) not. The only way a day
// is marked in its reader: nothing marks itself (owner, 2026-10-21). The
// host keeps the plan, says Day Done if it finished today's day, and
// schedules the reminders again ("marked").
dd_mark() {
    if (!dd_followed() || dy_di < 0) return;
    mark_day(dy_di, !dd_read(), time(0));
    ui_effect("marked", plan_slot(dd_plan), dd_num)
}

// ---- the day's end (Â§16.3.2) ----
// "End of Day 32"; "Day 32 is read" (a followed plan's, read); Next's
// "Day 33 Â· Psalm 106â€“107", else "The last day of Chronological"; and each
// other plan followed whose today isn't read, "Also today: M'Cheyne Â· Day
// 32" (dd_also_n of them, the slots al_slot).
dd_end_title() {
    fbuf_n = 0;
    fput_str("End of Day ");
    fput_int(dd_num)
}

dd_end_read(): bool {
    if (!dd_followed() || !dd_read()) return false;
    fbuf_n = 0;
    fput_str("Day ");
    fput_int(dd_num);
    fput_str(" is read");
    true
}

// Whether there is a next day (its words), else the last day's words.
dd_end_next(): bool {
    fbuf_n = 0;
    if (dd_plan >= 0 && dd_num < plan_lengths[dd_plan]) {
        fput_str("Day ");
        fput_int(dd_num + 1);
        fput_str(" \Â\· ");
        fput_day(plan_day(dd_plan, dd_num + 1));
        return true
    }
    fput_str("The last day of ");
    fput_plan_name(dd_plan);
    false
}

dd_also_n(): int {
    also_today(dd_plan, sk_today_now());
    al_n
}

dd_also(j: int) {
    fbuf_n = 0;
    if (j < 0 || j >= al_n) return;
    i: int = al_slot[j];
    fput_str("Also today: ");
    fput_plan_name(fw_plan[i]);
    fput_str(" \Â\· Day ");
    fput_int(plan_today_of(i, sk_today_now()))
}

// ---- Listen through the day (Â§16.3.3) ----
// The reading settings' button: "Listen to Day 32", from the passage under
// the bar if it isn't the first ("from Psalm 105"), row r's.
dd_listen_button(r: int) {
    fput_str("Listen to Day ");
    fput_int(dd_num);
    if (r > 0 && r < dy_n && dy_k[r] != dy_k[0]) {
        fput_str(" from ");
        fput_reading(dy_k[r], false)
    }
}

// The player's first line in a day: the passage heard (row r's) and the
// day ("Psalm 105 Â· Day 32"), into fbuf.
dd_listen_name(r: int) {
    fbuf_n = 0;
    if (r >= 0 && r < dy_n) fput_reading(dy_k[r], false);
    fput_str(" u00b7 Day ");
    fput_int(dd_num)
}

// ---- the plans followed (Â§16.11) ----
// The day slot i's days open at, from its row's â“˜: the first unfinished
// day, if one is (as Catch Up did); else today, once today is past the
// first screen (day 8 on: review r6-1); else their top (0: the Daily
// Reminder in sight early in a plan).
dd_details_day(i: int, today: int): int {
    if (i < 0 || i >= fw_n) return 0;
    td: int = plan_today_of(i, today);
    if (plan_behind_of(i, today) > 0) pl_first_behind else if (td > 7) td else 0
}

// "Started Chronological", into fbuf.
dd_started(p: int) {
    fbuf_n = 0;
    fput_str("Started ");
    fput_plan_name(p)
}

// Whether any plan's reminder is on; every plan's off (the phone's
// Settings turned notifications off): the slots changed, for the host to
// keep, in dd_changed.
reminders_any(): bool {
    for i in 0..fw_n
        if (fw_remind[i]) return true;
    false
}

dd_changed: []bool = new bool[16](false);

reminders_all_off() {
    for i in 0..fw_n {
        dd_changed[i] = fw_remind[i];
        fw_remind[i] = false
    }
}

// The reminders scheduled ahead: a day each, RM_DAYS of them, from today
// (tomorrow once today's time, at minutes past midnight, has passed).
RM_DAYS: int = 30;

rm_first_day(today: int, now_minutes: int, at_minutes: int): int {
    if (now_minutes >= at_minutes) today + 1 else today
}
