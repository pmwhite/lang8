tag bible;

use_tag std;

// The day's reader (DESIGN.md Â§16), apart from any platform: the day shown
// (its plan and number: plans.l8's day_rows lays out its rows, dy_*), the
// passage under the bar and the title's words, Mark Read's state and words
// and the marking itself, where the day opens, and the words of the day's
// end. A skin draws the rows as its reader does, and the bar, the capsule
// and the end its own way.
import "skin.l8";

import "plans.l8";

// The day shown (its plan, -1 none; its number, from 1), and the passage
// under the bar (its index among the plans', -1 none yet).
dd_plan: int = -1;

dd_num: int = 0;

dd_k: int = -1;

// Day d of plan p shown: its rows laid out (the plans made first, if no
// host has: a host with plans of its own files sets them before).
dd_show(p: int, d: int) {
    plans_make();
    dd_plan = p;
    dd_num = d;
    dd_k = -1;
    day_rows(p, d)
}

// Whether the day is of a plan followed (a day of another plan is read,
// not marked).
dd_followed(): bool {
    dd_plan >= 0 && plan_slot(dd_plan) >= 0
}

// The row the day opens at: passage k's, else (k -1) its first unread
// passage's (a plan not followed: its first passage's); (k -2, Next) the
// top.
dd_open_row(k: int): int {
    if (k == -2 || dy_di < 0) return 0;
    kk: int = if (k >= 0) k else day_first_unread(dy_di);
    if (!dd_followed() && k < 0) kk = pl_r0[dy_di];
    for x in 0..dy_n
        if (dy_k[x] == kk) return x;
    0
}

// The passage under the bar is row r's: whether that changed it.
dd_at_row(r: int): bool {
    if (r < 0 || r >= dy_n || dy_k[r] == dd_k) return false;
    dd_k = dy_k[r];
    true
}

// ---- the title: the passage under the bar, and the day ----
// "Psalm 105".
dd_title() {
    fbuf_n = 0;
    if (dd_k >= 0) fput_reading(dd_k, false)
}

// "Day 32 Â· Chronological".
dd_title_line() {
    fbuf_n = 0;
    fput_str("Day ");
    fput_int(dd_num);
    fput_str(" \Â\· ");
    fput_plan_name(dd_plan)
}

// What a screen reader says of the title, one element: "Psalm 105, Day
// 32, Chronological" (Â§16.7); its hint.
dd_title_label() {
    fbuf_n = 0;
    if (dd_k >= 0) fput_reading(dd_k, false);
    fput_str(", Day ");
    fput_int(dd_num);
    fput_str(", ");
    fput_plan_name(dd_plan)
}

dd_title_hint: str = "Shows the plan\â\€\™s days";

// ---- Mark Read (Â§16.13) ----
// Whether the day is read (every passage), the capsule's title, and what a
// screen reader says of it ("Mark Day 32 as read"; "Day 32, read") and
// adds.
dd_read(): bool {
    dy_di >= 0 && day_state(dy_di) == 2
}

dd_mark_title(): str {
    if (dd_read()) "Read" else "Mark Read"
}

dd_mark_label() {
    fbuf_n = 0;
    if (dd_read()) {
        fput_str("Day ");
        fput_int(dd_num);
        fput_str(", read")
    } else {
        fput_str("Mark Day ");
        fput_int(dd_num);
        fput_str(" as read")
    }
}

dd_mark_hint(): str {
    if (dd_read()) "Double-tap to mark it unread." else ""
}

// Mark Read tapped: the whole day read, or (read) not. The only way a day
// is marked in its reader: nothing marks itself (owner, 2026-10-21). The
// host keeps the plan, says Day Done if it finished today's day, and
// schedules the reminders again ("marked").
dd_mark() {
    if (!dd_followed() || dy_di < 0) return;
    mark_day(dy_di, !dd_read(), time(0));
    sk_marked(plan_slot(dd_plan), dd_num)
}

// ---- the day's end (Â§16.3.2) ----
// "End of Day 32"; "Day 32 is read" (a followed plan's, read); Next's
// "Day 33 Â· Psalm 106â€“107", else "The last day of Chronological"; and each
// other plan followed whose today isn't read, "Also today: M'Cheyne Â· Day
// 32" (dd_also_n of them, the slots al_slot).
dd_end_title() {
    fbuf_n = 0;
    fput_str("End of Day ");
    fput_int(dd_num)
}

dd_end_read(): bool {
    if (!dd_followed() || !dd_read()) return false;
    fbuf_n = 0;
    fput_str("Day ");
    fput_int(dd_num);
    fput_str(" is read");
    true
}

// Whether there is a next day (its words), else the last day's words.
dd_end_next(): bool {
    fbuf_n = 0;
    if (dd_plan >= 0 && dd_num < plan_lengths[dd_plan]) {
        fput_str("Day ");
        fput_int(dd_num + 1);
        fput_str(" \Â\· ");
        fput_day(plan_day(dd_plan, dd_num + 1));
        return true
    }
    fput_str("The last day of ");
    fput_plan_name(dd_plan);
    false
}

dd_also_n(): int {
    also_today(dd_plan, sk_today_now());
    al_n
}

dd_also(j: int) {
    fbuf_n = 0;
    if (j < 0 || j >= al_n) return;
    i: int = al_slot[j];
    fput_str("Also today: ");
    fput_plan_name(fw_plan[i]);
    fput_str(" \Â\· Day ");
    fput_int(plan_today_of(i, sk_today_now()))
}

// ---- Listen through the day (Â§16.3.3) ----
// The reading settings' button: "Listen to Day 32", from the passage under
// the bar if it isn't the first ("from Psalm 105"), row r's.
dd_listen_button(r: int) {
    fput_str("Listen to Day ");
    fput_int(dd_num);
    if (r > 0 && r < dy_n && dy_k[r] != dy_k[0]) {
        fput_str(" from ");
        fput_reading(dy_k[r], false)
    }
}

// The player's first line in a day: the passage heard (row r's) and the
// day ("Psalm 105 Â· Day 32"), into fbuf.
dd_listen_name(r: int) {
    fbuf_n = 0;
    if (r >= 0 && r < dy_n) fput_reading(dy_k[r], false);
    fput_str(" \Â\· Day ");
    fput_int(dd_num)
}

// ---- the plans followed (Â§16.11) ----
// The day slot i's days open at, from its row's â“˜: the first unfinished
// day, if one is (as Catch Up did); else today, once today is past the
// first screen (day 8 on: review r6-1); else their top (0: the Daily
// Reminder in sight early in a plan).
dd_details_day(i: int, today: int): int {
    if (i < 0 || i >= fw_n) return 0;
    td: int = plan_today_of(i, today);
    if (plan_behind_of(i, today) > 0) pl_first_behind else if (td > 7) td else 0
}

// "Started Chronological", into fbuf.
dd_started(p: int) {
    fbuf_n = 0;
    fput_str("Started ");
    fput_plan_name(p)
}

// Whether any plan's reminder is on; every plan's off (the phone's
// Settings turned notifications off): the slots changed, for the host to
// keep, in dd_changed.
reminders_any(): bool {
    for i in 0..fw_n
        if (fw_remind[i]) return true;
    false
}

dd_changed: []bool = new bool[16](false);

reminders_all_off() {
    for i in 0..fw_n {
        dd_changed[i] = fw_remind[i];
        fw_remind[i] = false
    }
}

rm_off(who: int) {
    for i in 0..fw_n dd_changed[i] = false;
    if (who == 0) set_pref_on("memoryReminder", false) else if (who - 1 < fw_n && who >= 1) {
        fw_remind[who - 1] = false;
        dd_changed[who - 1] = true
    }
}

rm_answer(who: int, granted: bool) {
    for i in 0..fw_n dd_changed[i] = false;
    if (granted) {
        if (who == 0) set_pref_on("memoryReminder", true) else if (who >= 1 && who - 1 < fw_n) {
            fw_remind[who - 1] = true;
            dd_changed[who - 1] = true
        }
        return
    }
    set_pref_on("memoryReminder", false);
    reminders_all_off()
}

// The reminders' time (minutes past midnight: 7:00 at first).
RM_TIME_FIRST: int = 420;

rm_time_ok(m: int): int {
    if (m < 0 || m >= 1440) RM_TIME_FIRST else m
}

// The reminders scheduled ahead: a day each, RM_DAYS of them, from today
// (tomorrow once today's time, at minutes past midnight, has passed).
RM_DAYS: int = 30;

rm_first_day(today: int, now_minutes: int, at_minutes: int): int {
    if (now_minutes >= at_minutes) today + 1 else today
}

// Day d's reminder, if it has one (memory_on: Memory's switch): its words
// in fbuf (its title to rm_title, its body after), the plans it names
// (rmp_slot, rmp_n), and whether Memory's passages are in it (rm_memory).
rm_memory: bool = false;

rm_day(d: int, memory_on: bool): bool {
    rm_memory = memory_on && memory_due_on(d) > 0;
    fput_reminder_all(d, rm_memory)
}

// ---- the plans, for a skin without its own day's reader ----
// (SK_NUM_OWN_VIEW of SCR_DAY: the iPhone's reader in a mode, which keeps
// the plans' files and starts, stops and marks them itself, told by the
// effects plan_start, plan_stop, plan_today, plan_details, marked and open
// OPEN_DAY. Any other skin: core does it, and its screen is the day's
// reader.)
SCR_DAY: int = 47;

ACT_DD_MARK: int = 177;

ACT_DD_NEXT: int = 178;

ACT_DD_ALSO: int = 179;

ACT_DD_DONE: int = 180;

// The plans followed changed (one started, stopped or marked): the host
// keeps them all.
SK_KEPT_PLANS: int = 9;

dd_own(): bool {
    sk_num_of(SK_NUM_OWN_VIEW, SCR_DAY) == 1
}

// A plan followed from today (A Chapter a Day from chapter c), its file's
// number the next (planNext): its plan (-1: it is followed already).
dd_follow(p_in: int, c: int): int {
    plans_make();
    p: int = if (plan_is_day1(p_in)) plan_day1_choose(c) else p_in;
    if (p < 0 || plan_slot(p) >= 0) return -1;
    n: int = pref("planNext", 1);
    if (n < 1) n = 1;
    set_pref("planNext", n + 1);
    f: fn() = sk_host.save_prefs;
    prefs_format();
    f();
    i: int = plan_begin(p, sk_today_now(), n);
    if (i < 0) return -1;
    sk_kept(SK_KEPT_PLANS);
    p
}

// Start Plan: followed, the toast, and its first day.
sk_plan_start(p_in: int, c: int) {
    if (dd_own()) {
        ui_effect("plan_start", p_in, -1);
        return
    }
    p: int = dd_follow(p_in, c);
    if (p < 0) return;
    dd_started(p);
    ui_toast(TOAST_CHECK);
    sk_open_day(p, 1)
}

// Stop Plan: no longer followed (a day of it shown is read, not marked).
sk_plan_stop(p: int) {
    if (dd_own()) {
        ui_effect("plan_stop", p, -1);
        return
    }
    plan_end(plan_slot(p));
    sk_kept(SK_KEPT_PLANS);
    sk_update_all()
}

// A day marked (its circle, or Mark Read): kept, and Day Done's toast if
// it finished today's day.
sk_marked(i: int, d: int) {
    if (dd_own()) {
        ui_effect("marked", i, d);
        return
    }
    if (i < 0 || i >= fw_n) return;
    sk_kept(SK_KEPT_PLANS);
    if (dd_done_now(i, d)) {
        sk_kept(SK_KEPT_PLANS);
        ui_toast(TOAST_CHECK)
    }
}

// Day d of slot i marked: if it finished today's day, once a day (Day
// Done), noted, and its words in fbuf.
dd_done_now(i: int, d: int): bool {
    td: int = sk_today_now();
    if (i < 0 || i >= fw_n || day_state(plan_day(fw_plan[i], d)) != 2 || d != plan_today_of(i,
        td) || !plan_day_done_due(i, td)) return false;
    fw_doneday[i] = td;
    fbuf_n = 0;
    fput_day_done(i, td);
    true
}

// Day d of plan p in core's day's reader (over the sheet up, else
// presented).
sk_open_day(p: int, d: int) {
    if (p < 0 || d < 1 || d > plan_lengths[p]) return;
    if (dd_own()) {
        ui_effect("open", OPEN_DAY, p * 1000 + d);
        return
    }
    sk_open(SCR_DAY, p * 1000 + d, sk_n > 0)
}

// Slot i's today, and its days (at the day its â“˜ opens).
sk_plan_today(i: int) {
    if (dd_own()) {
        ui_effect("plan_today", i, -1);
        return
    }
    if (i >= 0 && i < fw_n) sk_open_day(fw_plan[i], plan_today_of(i, sk_today_now()))
}

sk_plan_details(i: int) {
    if (dd_own()) {
        ui_effect("plan_details", i, -1);
        return
    }
    if (i >= 0 && i < fw_n) sk_open_plan(fw_plan[i], dd_details_day(i, sk_today_now()),
        false, sk_n > 0)
}

dd_layout: ChapterLayout = chapter_layout();

// Core's day's reader: its title the day; a page, each row's words in the
// reader's styles (the day's heading, each passage's); Mark Read (a plan
// followed); the day's end: whether it is read, Next or the last day's
// words, the other plans' days.
sk_build_day(id: int, arg: int) {
    p: int = arg / 1000;
    d: int = arg % 1000;
    ui_begin(id, SCR_DAY, arg, "");
    if (p < 0 || p >= len(plan_lengths) || d < 1 || d > plan_lengths[p]) return;
    dd_show(p, d);
    if (dy_n > 0) dd_k = dy_k[0];
    dd_title_line();
    ui_set_screen_title_fbuf();
    ui_set_confirm("Done", ACT_DD_DONE);
    ui_plain = true;
    ui_page = true;
    if (dd_followed()) ui_tool(dd_mark_title(), if (dd_read()) "checkmark.circle.fill" else "circle",
        ACT_DD_MARK, 0, if (dd_read()) UI_TOOL_PROMINENT else UI_TOOL_PLAIN, 2);
    ui_section("", "");
    sk_apply_prefs();
    ctx: *ChapterLayout = &dd_layout;
    ctx.lay_verse_numbers = lay_verse_numbers;
    ctx.lay_headings = lay_headings;
    ctx.lay_notes = false;
    ctx.lay_verse_lines = lay_verse_lines;
    ctx.lay_accents = lay_accents;
    ctx.source = text_source(if (text_cur == TEXT_ESV) TEXT_BSB else text_cur);
    for r in 0..dy_n {
        fbuf_n = 0;
        layout_day_row(ctx, r);
        ui_row(UI_TEXT, 0, r);
        ui_rich_begin();
        q: int = 0;
        for x in 0..ctx.runs {
            e: int = ctx.run_end[x];
            if (e > q) {
                fput_bytes(ctx.out, q, e);
                ui_rich(ctx.run_style[x])
            }
            q = e
        }
        ui_rich_title()
    }
    ctx.lay_v1 = 0;
    ctx.lay_v2 = 0;
    ctx.lay_passage = false;
    // (The day's end.)
    ui_section("", "");
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    dd_end_title();
    ui_rich(RUN_FAINT);
    ui_rich_title();
    ui_rich_begin();
    if (dd_end_read()) {
        ui_row(UI_TEXT, 0, 0);
        ui_rich(RUN_ACCENT);
        ui_rich_title()
    }
    ui_rich_begin();
    if (dd_end_next()) {
        ui_row(UI_ITEM, ACT_DD_NEXT, 0);
        ui_set_title("Next");
        ui_set_detail_fbuf();
        ui_set_acc(ACC_MORE)
    } else {
        ui_row(UI_TEXT, 0, 0);
        ui_rich(RUN_FAINT);
        ui_rich_title()
    }
    for j in 0..dd_also_n() {
        dd_also(j);
        ui_row(UI_ITEM, ACT_DD_ALSO, al_slot[j]);
        ui_set_title_fbuf();
        ui_set_tinted()
    }
}

sk_dd_act(at: int, action: int, arg: int) {
    id: int = sk_ids[at];
    if (action == ACT_DD_DONE) {
        sk_n = at;
        ui_effect("close", id, -1);
        sk_update_all();
        return
    }
    a: int = sk_args[at];
    p: int = a / 1000;
    d: int = a % 1000;
    if (action == ACT_DD_MARK) {
        dd_show(p, d);
        dd_mark()
    } else if (action == ACT_DD_NEXT) {
        if (d < plan_lengths[p]) sk_args[at] = p * 1000 + d + 1
    } else if (action == ACT_DD_ALSO) {
        if (arg >= 0 && arg < fw_n) sk_args[at] = fw_plan[arg] * 1000 + plan_today_of(arg,
            sk_today_now())
    }
    sk_build(at);
    ui_effect("update", id, -1)
}
