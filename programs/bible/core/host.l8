tag bible;

use_tag std;

// The host, for any platform that only gives core its primitives (SKINS.md,
// a skin's interface): every skin's. It asks for the data files (the
// reader's version and the plans first, then the language data and the
// Manual), each read into the dataset it is part of (its own arena,
// replaced whole when the file comes again), keeps the settings and what
// is kept (core/kept.l8, by the platform's kept_store), makes the ESV's
// requests to the site's Worker and reads their answers (core/json.l8),
// and hands every other line to core. A platform gives it HostIO and its
// lines, from a loop that waits for them or from its callbacks alike:
//
//   kept_store = ...; host_io = HostIO { ... };
//   hs_start();
//   ... n: int = take(hs_inbox); hs_lines(n); hs_after() ...
//
// Its lines to core, besides the wire: `got ID SIZE` (data file ID came, or
// -1), `http ID STATUS SIZE` (a request's answer, its body file ID's), `api
// BASE` (where the site's /api/v1/ is), and core/held.l8's `fetching`,
// `fetched` and `network` (also core/shelf.l8's, for its fetches' ids).
// To the skin, besides core's lines: `ready` once the reader's version
// and what is kept are read.
import "skin.l8";

import "json.l8";

import "held.l8";

import "shelf.l8";

type HostIO = {
    // Data file name asked for as id (it comes as `got ID SIZE`).
    ask: fn(id: int, name: str);
    // A GET of the address (b's first n bytes) as id (its answer comes as
    // `http ID STATUS SIZE`). Consume or copy b before returning.
    http: fn(id: int, b: []i8, n: int);
    // File or answer id, as it came, into out: its whole length.
    file: fn(id: int, out: []i8): int;
    // A GET of the address (url's first url_n bytes) as id, into the kept
    // file named (name's first name_n bytes): written whole once the answer
    // is 200, else not at all; a copy of what is online, so the platform
    // may keep it out of backups. It says `fetching ID GOT TOTAL` as it
    // comes (if it can) and `fetched ID STATUS BYTES` at its end. Consume
    // or copy url and name before returning. None: the platform cannot
    // keep recordings (Downloads is not offered).
    fetch: ?fn(id: int, url: []i8, url_n: int, name: []i8, name_n: int);
    // The kept file named (name's first name_n bytes: one fetch kept) read
    // as id: it comes as `got ID SIZE` (-1: there is no such file), its
    // bytes by file(id). Consume or copy name before returning. None: the
    // platform cannot read back what it fetches (the bookshelf is not
    // offered).
    read_kept: ?fn(id: int, name: []i8, name_n: int);
    // Lines to the skin: n bytes of b from start.
    say: fn(b: []i8, start: int, n: int)
}

hs_no_ask(_id: int, _name: str) { }

hs_no_http(_id: int, _b: []i8, _n: int) { }

hs_no_file(_id: int, _out: []i8): int {
    0
}

hs_no_say(_b: []i8, _s: int, _n: int) { }

host_io: HostIO = HostIO {
    ask: &hs_no_ask,
    http: &hs_no_http,
    file: &hs_no_file,
    fetch: null,
    read_kept: null,
    say: &hs_no_say
};

// Whether this host is core's (a wire skin's): its ESV, search and
// Compare's chapters asked for here.
hs_on: bool = false;

hs_ask(id: int, name: str) {
    f: fn(id: int, name: str) = host_io.ask;
    f(id, name)
}

hs_file(id: int, out: []i8) {
    f: fn(id: int, out: []i8): int = host_io.file;
    _n: int = f(id, out)
}

hs_said(s: str) {
    hs_say_buf_n = 0;
    for c in s {
        hs_say_buf[hs_say_buf_n] = c;
        hs_say_buf_n = hs_say_buf_n + 1
    }
    f: fn(b: []i8, start: int, n: int) = host_io.say;
    f(hs_say_buf, 0, hs_say_buf_n)
}

hs_say_buf: []i8 = new i8[64](0i8);

hs_say_buf_n: int = 0;

// ---- the data files ----
// Their ids: a version's (core's TEXT_), the plans', the Manual's, the
// language data's (from HS_LANG_ID, as hs_lang_files), the original's.
HS_PLAN_M_ID: int = 10;

HS_PLAN_C_ID: int = 11;

HS_HELP_ID: int = 12;

HS_LANG_ID: int = 20;

HS_ORIG_WORDS_ID: int = 50;

HS_ORIG_KETIV_ID: int = 51;

HS_ORIG_ACCENTS_ID: int = 52;

hs_version_files: []str = ["bsb", "kjv", "web", "asv", "ylt", "", "orig.txt"];

hs_lang_files: []str = ["lang/words.bin", "lang/verses.bin", "lang/supplied.bin",
    "lang/forms.txt", "lang/morph.txt", "lang/conc.bin", "lang/lexicon.txt", "lang/grammar.txt",
    "lang/senses.bin", "lang/related.bin", "xref_index.bin", "xrefs.bin", "mhcc.txt",
    "lang/meanings.bin", "lang/meanings.txt", "lang/vocab.bin", "lang/letters.txt"];

// The version the reader opens in, and whether it and the plans have come
// (then what is kept is read, and the page told).
hs_start_t: int = 0;

hs_plans_got: int = 0;

hs_start_came: bool = false;

hs_begun: bool = false;

// A version asked for (core's sk_want_text), until it comes.
hs_asked_t: int = -1;

hs_ask_version(t: int) {
    if (t >= TEXT_SHELF_FIRST) {
        shelf_ask_text(t);
        return
    }
    if (t < 0 || t >= len(hs_version_files) || len(hs_version_files[t]) == 0) return;
    if (t == TEXT_ORIG) {
        // (Its words, Ketiv and accents, then its text: those come before
        // let go.)
        drop orig_coming;
        drop orig_text_coming;
        hs_ask(HS_ORIG_WORDS_ID, "lang/orig-words.bin");
        hs_ask(HS_ORIG_KETIV_ID, "lang/orig-ketiv.txt");
        hs_ask(HS_ORIG_ACCENTS_ID, "lang/orig-accents.txt")
    }
    hs_ask(t, hs_version_files[t])
}

// File id came, size bytes (-1: it could not): read into the dataset it
// is part of (its arena), or into scratch that dataset is made from.
hs_got(id: int, size: int) {
    // (The bookshelf's: its catalog and packages, read back.)
    if (id >= SHELF_READ_CATALOG_ID) {
        shelf_got(id, size);
        return
    }
    if (size < 0) {
        hs_missing(id);
        return
    }
    // (A dataset of its own: read into its arena, or into scratch and made
    // in its arena.)
    if (id >= 0 && id < TEXTS && id != TEXT_ORIG) {
        text_read(id, id, size, &hs_file);
        hs_version_arrived(id);
        return
    }
    if (id >= HS_LANG_ID && id < HS_LANG_ID + len(hs_lang_files)) {
        language_file_read(id - HS_LANG_ID, id, size, &hs_file);
        return
    }
    if (id == HS_PLAN_M_ID || id == HS_PLAN_C_ID) {
        plan_file_read(hs_plan_of(id), id, size, &hs_file);
        hs_plan_arrived();
        return
    }
    if (id >= HS_ORIG_WORDS_ID && id <= HS_ORIG_ACCENTS_ID) {
        orig_file_read(id - HS_ORIG_WORDS_ID, id, size, &hs_file);
        hs_orig_ready();
        return
    }
    if (id == TEXT_ORIG) {
        drop orig_text_coming;
        orig_text_coming = data_file_read(id, size, &hs_file);
        hs_orig_ready();
        return
    }
    // (Read into scratch: what is kept of them is made from it.)
    if (id >= HS_TIM_ID && id < HS_TIM_ID + 4 || id == HS_PATHS_ID) {
        region {
            source: []i8 = new i8[size + 1](0i8);
            hs_file(id, source);
            if (id == HS_PATHS_ID) henson_paths_came(source, size) else timings_came(id - HS_TIM_ID,
                source, size)
        }
        // (Their chapters known now: a download left unfinished goes on.)
        held_pump();
        return
    }
    if (id == HS_HELP_ID) {
        region {
            source: []i8 = new i8[size + 1](0i8);
            hs_file(id, source);
            manual_came(source, size)
        }
        return
    }
}

// The plan whose file id is.
hs_plan_of(id: int): int {
    if (id == HS_PLAN_M_ID) PLAN_MCHEYNE else PLAN_CHRONO
}

// A plan's file in place: the reader begun once both have come.
hs_plan_arrived() {
    hs_plans_got = hs_plans_got + 1;
    hs_begin()
}

// File id could not come: a version kept that isn't here gives way to the
// BSB; one asked for is no longer waited for.
hs_missing(id: int) {
    if (id == hs_start_t && !hs_start_came && id != 0) {
        // (The version kept couldn't come: the BSB.)
        hs_start_t = 0;
        hs_ask_version(0)
    } else if (id == hs_asked_t) hs_asked_t = -1
}

// Version t's text in place: the reader begun, if it was waited for, or
// switched to it, if it was asked for.
hs_version_arrived(t: int) {
    if (!hs_start_came && t == hs_start_t) {
        hs_start_came = true;
        text_use(t);
        hs_begin()
    } else if (t == hs_asked_t) {
        hs_asked_t = -1;
        if (t < len(hs_loading)) hs_loading[t] = false;
        sk_use_version(t)
    } else if (t < len(hs_loading) && hs_loading[t]) {
        hs_loading[t] = false;
        sk_update_all()
    } else if (t >= TEXT_SHELF_FIRST) sk_update_all()
}

// Versions read for core's own use (Compare's, a passage's in Practice),
// not to read in: asked for once each, the screens made again as each
// comes. Whether version t is here now (1), else 0, asked for.
hs_loading: []bool = new bool[8](false);

hs_text_ready(t: int): int {
    if (t >= TEXT_SHELF_FIRST && text_is_version(t)) {
        if (text_ready(t)) return 1;
        shelf_ask_text(t);
        return 0
    }
    if (t < 0 || t >= TEXT_PIN || t == TEXT_ESV) return 0;
    if (text_ready(t)) return 1;
    if (!hs_loading[t] && t != hs_asked_t) {
        hs_loading[t] = true;
        hs_ask_version(t)
    }
    0
}

// The original's text read once its words, Ketiv and accents are.
hs_orig_ready() {
    if (!orig_whole()) return;
    og_setting = clamp_index(pref_get("origGlosses"), 4) - 1;
    lay_accents = pref_is("origAccents");
    orig_complete();
    hs_version_arrived(TEXT_ORIG)
}

// The reader's version and the plans here: what is kept read, the page
// told, and the language data asked for (Study and Learn once it comes).
hs_begin() {
    if (hs_begun || !hs_start_came || hs_plans_got < 2) return;
    hs_begun = true;
    kept_load();
    kept_esv_load();
    held_load();
    for i in 0..len(hs_lang_files) hs_ask(HS_LANG_ID + i, hs_lang_files[i]);
    hs_ask(HS_HELP_ID, "help.txt");
    for s in 0..len(hs_tim_files) hs_ask(HS_TIM_ID + s, hs_tim_files[s]);
    hs_ask(HS_PATHS_ID, "audio/henson.paths");
    // (Whether the site gives the ESV.)
    hs_get_path(HS_STATUS, "status");
    hs_said("ready\n")
}

// (The host's numbers: whether the language data is here; the device's
// own voice reads aloud; the ESV's search's state.)
hs_num(what: int, _a: int): int {
    if (what == SK_NUM_LANG || what == SK_NUM_LEARN) return if (language_ready()) 1 else 0;
    if (what == SK_NUM_AUDIO_SOURCE) return hs_source(_a);
    if (what == SK_NUM_VOICE_SEEN || what == SK_NUM_BETTER_VOICE) return 1;
    if (what == SK_NUM_ESV_SEARCH) return hs_esr_state;
    if (what == SK_NUM_PRACTICE_AUDIO || what == SK_NUM_PRACTICE_KEYS) return 1;
    if (what == SK_NUM_REMIND) return if (_a == 0) hs_remind_minutes() else if (_a == 1) if (hs_denied) 1 else 0 else if (pref_is("memoryReminder")) 1 else 0;
    if (what == SK_NUM_ESV_AUDIO) return if (hs_esv_audio_ok) 1 else 0;
    // (Compare's ESV chapter: here, coming, or it can't come.)
    if (what == SK_NUM_ESV_STATE) return if (esv_held(_a)) 0 else if (_a >= 0 && _a < chapters && esv_state[_a] >= ESV_OFFLINE) 2 else 1;
    // (Leave Here: whether chapter a's end showed at the last rest.)
    if (what == SK_NUM_END_SEEN) return if (_a == rd_rest_c && rd_rest_end) 1 else 0;
    if (what == SK_NUM_MEMORY_TEXT) return hs_memory_text(_a);
    if (what == SK_NUM_TEXT) return hs_text_ready(_a);
    if (what == SK_NUM_CELLULAR) return if (pref_is("downloadAheadCellular")) 1 else 0;
    if (what == SK_NUM_DOWNLOADED) return held_downloaded_bytes();
    if (what == SK_NUM_DOWNLOAD) return held_progress(_a);
    -1
}

// Passage i's words laid out (Practice's): an ESV passage's from its
// pinned verses, once they have come; any other's core's own (-1).
hs_memory_text(i: int): int {
    if (i < 0 || i >= mq_n) return -1;
    // (Another version's: core's own, once its version is here.)
    if (mq_ver[i] != TEXT_ESV) return if (hs_text_ready(mq_ver[i]) == 1) -1 else 0;
    mt_n = 0;
    mw_n = 0;
    mv_n = 0;
    mpt_n = 0;
    if (!esv_pin_ready(mq_id[i])) return 0;
    esv_pin_build(mq_id[i]);
    if (!text_ready(TEXT_PIN)) return 0;
    borrow texts[TEXT_PIN] as text {
        memory_layout_from(text, mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i], mq_id[i])
    }
    if (mw_n > 0) 1 else 0
}

// Text t's chosen reader (its setting's, else the version's own).
hs_source(t: int): int {
    name: str = src_setting(t);
    if (len(name) == 0) return SRC_VOICE;
    k: int = pref_get(name) - 1;
    if (k < 0 || k >= SOURCES || k != SRC_VOICE && src_texts[k] != t) text_default_src(t) else k
}

// ---- the device's voices (the skin says them: voices Q:LANG:NAME ...) ----
// Each one's name and core's place for it (voice_score: English only,
// better first), the chosen one's name (voice.txt; none: the best), and
// whether the ESV's recording is offered (its status).
HV_MOST: int = 64;

hv_n: int = 0;

hv_at: []int = new int[64](0);

hv_len: []int = new int[64](0);

hv_q: []int = new int[64](0);

hv_score: []int = new int[64](0);

hv_pool: []i8 = new i8[8192](0i8);

hv_pool_n: int = 0;

hv_chosen: []i8 = new i8[256](0i8);

hv_chosen_n: int = 0;

hs_esv_audio_ok: bool = false;

// The voices line read (each field Q:LANG:NAME), kept in core's order.
sk_voices_said(line: []i8, b: int, e: int) {
    hv_n = 0;
    hv_pool_n = 0;
    p: int = b;
    while (p < e) {
        q: int = p;
        while (q < e && line[q] as int != 9) q = q + 1;
        hs_voice_field(line, p, q);
        p = q + 1
    }
    // (Better first: insertion, as few as they are.)
    for i in 1..hv_n {
        j: int = i;
        while (j > 0 && hv_score[j - 1] < hv_score[j]) {
            hs_voice_swap(j - 1, j);
            j = j - 1
        }
    }
}

hs_voice_field(b: []i8, p: int, e: int) {
    if (hv_n >= HV_MOST) return;
    q: int = sk_num(b, p, e);
    c1: int = sk_num_end;
    if (c1 >= e || b[c1] as int != 58) return;
    c2: int = c1 + 1;
    while (c2 < e && b[c2] as int != 58) c2 = c2 + 1;
    if (c2 >= e) return;
    english: bool = c2 - c1 > 2 && b[c1 + 1] as int == 101 && b[c1 + 2] as int == 110;
    us: bool = c2 - c1 == 6 && english && b[c1 + 4] as int == 85 && b[c1 + 5] as int == 83;
    score: int = voice_score(english, false, q, us);
    if (score < 0 || hv_pool_n + e - c2 > len(hv_pool)) return;
    hv_at[hv_n] = hv_pool_n;
    for i in c2 + 1..e {
        hv_pool[hv_pool_n] = b[i];
        hv_pool_n = hv_pool_n + 1
    }
    hv_len[hv_n] = e - c2 - 1;
    hv_q[hv_n] = q;
    hv_score[hv_n] = score;
    hv_n = hv_n + 1
}

hs_voice_swap(i: int, j: int) {
    a: int = hv_at[i];
    hv_at[i] = hv_at[j];
    hv_at[j] = a;
    l: int = hv_len[i];
    hv_len[i] = hv_len[j];
    hv_len[j] = l;
    q: int = hv_q[i];
    hv_q[i] = hv_q[j];
    hv_q[j] = q;
    s: int = hv_score[i];
    hv_score[i] = hv_score[j];
    hv_score[j] = s
}

// Whether voice i is the chosen one.
hv_is_chosen(i: int): bool {
    if (hv_chosen_n != hv_len[i]) return false;
    for k in 0..hv_len[i]
        if (hv_pool[hv_at[i] + k] != hv_chosen[k]) return false;
    true
}

// The voice heard: the chosen one, if the device has it, else the best.
hv_heard(): int {
    for i in 0..hv_n
        if (hv_is_chosen(i)) return i;
    if (hv_n > 0) 0 else -1
}

// Its name into fbuf (none: the device's own choice).
fput_voice_heard() {
    i: int = hv_heard();
    if (i >= 0) fput_bytes(hv_pool, hv_at[i], hv_at[i] + hv_len[i])
}

// The Voices screen's list (SK_ITEMS_VOICES): each its name, quality, and
// whether it is the one chosen.
hs_fill(what: int) {
    if (what != SK_ITEMS_VOICES) return;
    for i in 0..hv_n {
        fbuf_n = 0;
        fput_bytes(hv_pool, hv_at[i], hv_at[i] + hv_len[i]);
        sk_item_fbuf(hv_q[i], if (hv_is_chosen(i)) 1 else 0)
    }
}

// Voice i chosen (-1: the best available), kept (voice.txt).
hs_voice_chosen(i: int) {
    hv_chosen_n = 0;
    if (i >= 0 && i < hv_n) {
        for k in 0..hv_len[i] {
            if (hv_chosen_n < len(hv_chosen)) {
                hv_chosen[hv_chosen_n] = hv_pool[hv_at[i] + k];
                hv_chosen_n = hv_chosen_n + 1
            }
        }
    }
    fbuf_n = 0;
    fput_bytes(hv_chosen, 0, hv_chosen_n);
    kp_set("voice.txt");
    kp_write();
    sk_update_all()
}

hs_voice_load() {
    kp_set("voice.txt");
    kp_read();
    hv_chosen_n = 0;
    for i in 0..fbuf_n {
        k: int = fbuf[i] as int;
        if (k != 10 && hv_chosen_n < len(hv_chosen)) {
            hv_chosen[hv_chosen_n] = fbuf[i];
            hv_chosen_n = hv_chosen_n + 1
        }
    }
}

// The platform's words, as core's host has them: who reads aloud (the
// voice heard), the app's version, where notifications are turned back on
// (the platform's, hs_notify_off; none: its Settings).
hs_notify_off: str = "";

// The ESV's words of the range parsed (Add Passage's; text.l8's rg_*):
// its chapters' held now, as much as fits.
hs_range_words() {
    for c in rg_c1..rg_c2 + 1
        if (!esv_held(c)) return;
    esv_build();
    borrow texts[TEXT_ESV] as text {
        memory_layout_from(text, rg_c1, rg_v1, rg_c2, rg_v2, 1)
    }
    fbuf_n = 0;
    if (mt_n > 0) fput_first_words(2000)
}

hs_say_words(what: int) {
    fbuf_n = 0;
    if (what == SK_WORDS_RANGE_TEXT) hs_range_words() else if (what == SK_WORDS_VOICE) fput_voice_heard() else if (what == SK_WORDS_APP_VERSION) fput_str("Smooth Bible") else if (what == SK_WORDS_NOTIFY_OFF) fput_str(hs_notify_off)
}

// ---- reminders (DESIGN.md §13.5): a notification a day, its words core's ----
// (To the skin: notify_ask WHO, its answer notifyok WHO GRANTED; then
// notify_clear and a notify AT PLAN MEMORY TITLE BODY a day, AT seconds
// since 1970, PLAN the file of the first plan it names (0 none), MEMORY 1
// if Memory's passages are in it; the skin schedules them its platform's
// way, and one opened is reminded PLAN MEMORY.) The time is the setting
// reminderTime (minutes past midnight; 0, 7:00); whether the platform has
// turned them off, its last answer.
hs_denied: bool = false;

hs_remind_minutes(): int {
    m: int = pref_get("reminderTime");
    if (m == 0) RM_TIME_FIRST else rm_time_ok(m)
}

hs_notify_schedule() {
    ui_str("notify_clear\n");
    memory_on: bool = pref_is("memoryReminder");
    if (!reminders_any() && !memory_on) return;
    now: int = time(0);
    minutes: int = hs_remind_minutes();
    first: int = rm_first_day(sk_today_now(), (now + sk_tz) % 86400 / 60, minutes);
    for k in 0..RM_DAYS {
        d: int = first + k;
        if (rm_day(d, memory_on)) {
            ui_str("notify ");
            ui_int(d * 86400 + minutes * 60 - sk_tz);
            ui_byte(32);
            ui_int(if (rmp_n > 0) fw_num[rmp_slot[0]] else 0);
            ui_byte(32);
            ui_int(if (rm_memory) 1 else 0);
            ui_byte(9);
            ui_field_bytes(fbuf, 0, rm_title);
            ui_byte(9);
            ui_field_bytes(fbuf, rm_title, fbuf_n);
            ui_byte(10)
        }
    }
}

// A reminder's switch (who: 0 Memory's, else a plan's slot plus 1): on asks
// the platform first; off now.
hs_remind(who: int, on: bool) {
    if (on) {
        ui_effect("notify_ask", who, -1);
        return
    }
    rm_off(who);
    hs_reminders_kept()
}

// A reminder opened: the first plan it names, at today in its day's
// reader; else the Library on Memory.
hs_reminded(num: int, memory: bool) {
    i: int = rm_opened(num, false, memory);
    if (i >= 0) {
        sk_dismiss();
        sk_plan_today(i)
    } else if (rm_opened_memory) {
        set_pref("librarySegment", 3);
        sk_open(SCR_LIBRARY, 0, false)
    }
}

// The platform's answer.
hs_notify_answer(who: int, granted: bool) {
    hs_denied = !granted;
    rm_answer(who, granted);
    hs_reminders_kept()
}

hs_reminders_kept() {
    sk_save();
    kept_save(SK_KEPT_PLANS);
    sk_update_all()
}

// ---- the network: the site's Worker (/api/v1/) ----
// Its address (`api BASE`, the skin's: /api/v1/ on the site), and each
// request's id: the ESV's status, chapters, a search.
hs_api: []i8 = new i8[256](0i8);

hs_api_n: int = 0;

HS_STATUS: int = 1000;

HS_CHAPTERS: int = 1001;

HS_SEARCH: int = 1002;

HS_AUDIO: int = 1003;

// The recordings' verse timings and the WEB's paths (data/audio/).
HS_TIM_ID: int = 60;

HS_PATHS_ID: int = 64;

hs_tim_files: []str = ["audio/souer.tim", "audio/hays.tim", "audio/gilbert.tim", "audio/henson.tim"];

type HsRequest = {
    id: int;
    url: []i8;
    byte_count: int
}

hs_url_byte(request: *HsRequest, k: int) {
    if (request.byte_count < len(request.url)) request.url[request.byte_count] = k trunc i8;
    request.byte_count = request.byte_count + 1
}

hs_url_str(request: *HsRequest, s: str) {
    for c in s hs_url_byte(request, c as int)
}

hs_url_int(request: *HsRequest, n: int) {
    if (n >= 10) hs_url_int(request, n / 10);
    hs_url_byte(request, 48 + n % 10)
}

// Bytes b to e as a query's words (each byte not plain escaped).
hs_url_query(
    request: *HsRequest,
    b: []i8,
    s: int,
    e: int
) {
    for i in s..e {
        k: int = b[i] as int & 255;
        plain: bool = k >= 48 && k <= 57 || k >= 65 && k <= 90 || k >= 97 && k <= 122 || k == 45 || k == 46 || k == 95 || k == 126;
        if (plain) hs_url_byte(request, k) else {
            hs_url_byte(request, 37);
            hs_url_byte(request, hs_hex(k / 16));
            hs_url_byte(request, hs_hex(k % 16))
        }
    }
}

hs_hex(d: int): int {
    if (d < 10) 48 + d else 55 + d
}

// Construction storage belongs to the caller's request region. HTTP hosts
// consume or copy its bytes during the call, before that region ends.
hs_request(id: int, path: str): HsRequest@new {
    request: HsRequest = HsRequest { id: id, url: new i8[2048](0i8), byte_count: 0 };
    for i in 0..hs_api_n hs_url_byte(&request, hs_api[i] as int);
    hs_url_str(&request, path);
    request
}

hs_get(request: HsRequest): bool {
    if (request.byte_count > len(request.url)) return false;
    f: fn(id: int, b: []i8, n: int) = host_io.http;
    f(request.id, request.url, request.byte_count);
    true
}

hs_get_path(id: int, path: str) {
    sent: bool = false;
    region {
        sent = hs_get(hs_request(id, path))
    }
    if (!sent) hs_answer(id, 414, 0)
}

// The ESV's chapters (core/esv_client.l8 asks: count from c).
hs_esv_c: int = -1;

hs_esv_count: int = 0;

hs_fetch(what: int, c: int, count: int): bool {
    if (what != SK_FETCH_ESV || c < 0 || c >= chapters || hs_api_n == 0) return false;
    hs_esv_c = c;
    hs_esv_count = count;
    sent: bool = false;
    region {
        request: HsRequest = hs_request(HS_CHAPTERS, "esv/chapters?book=");
        for x in 0..3 hs_url_byte(&request, book_code_byte(ch_book[c], x));
        hs_url_str(&request, "&chapter=");
        hs_url_int(&request, ch_num[c]);
        hs_url_str(&request, "&count=");
        hs_url_int(&request, count);
        sent = hs_get(request)
    }
    if (!sent) hs_answer(HS_CHAPTERS, 414, 0);
    true
}

// The ESV searched for what Search holds (page, from 1): its results
// core's (sk_esr_), its state while they come (SK_NUM_ESV_SEARCH).
hs_esr_state: int = 0;

hs_esv_search(page: int) {
    if (hs_api_n == 0) return;
    hs_esr_state = ESV_LOADING;
    sent: bool = false;
    region {
        request: HsRequest = hs_request(HS_SEARCH, "esv/search?q=");
        hs_url_query(&request, sk_sq, 0, sk_sq_n);
        hs_url_str(&request, "&page=");
        hs_url_int(&request, page);
        sent = hs_get(request)
    }
    if (!sent) hs_answer(HS_SEARCH, 414, 0);
    sk_update_all()
}

// The ESV's recording of chapter c: its address asked of the Worker
// (core/listen.l8 plays it).
hs_esv_audio(c: int) {
    if (hs_api_n == 0) {
        lw_esv_url(hs_words, 0);
        return
    }
    sent: bool = false;
    region {
        request: HsRequest = hs_request(HS_AUDIO, "esv/audio?book=");
        for x in 0..3 hs_url_byte(&request, book_code_byte(ch_book[c], x));
        hs_url_str(&request, "&chapter=");
        hs_url_int(&request, ch_num[c]);
        sent = hs_get(request)
    }
    if (!sent) hs_answer(HS_AUDIO, 414, 0)
}

// ---- answers ----
hs_body: []i8 = new i8[1](0i8);

hs_words: []i8 = new i8[262144](0i8);

// The book whose code is at b's p (3 bytes), or -1.
hs_book_at(b: []i8, p: int, e: int): int {
    if (e - p < 3) return -1;
    for k in 0..books {
        same: bool = true;
        for x in 0..3
            if (book_code_byte(k, x) != b[p + x] as int) same = false;
        if (same) return k
    }
    -1
}

// A request's answer (status, its body n bytes).
hs_answer(id: int, status: int, n: int) {
    body: []i8 = new i8[if (n > 0) n + 1 else 1](0i8);
    if (n > 0) hs_file(id, body);
    m: int = if (n > 0) n else 0;
    if (id == HS_STATUS) {
        hs_esv_audio_ok = status == 200 && json_true(body, json_get(body, 0, m, "esvAudio"),
            m);
        sk_esv_status(status, status == 200 && json_true(body, json_get(body, 0, m,
            "esv"), m));
        return
    }
    if (id == HS_SEARCH) {
        hs_search_came(status, body, m);
        return
    }
    if (id == HS_AUDIO) {
        w: int = if (status == 200) json_str(body, json_get(body, 0, m, "url"), m,
            hs_words) else 0;
        lw_esv_url(hs_words, if (w <= len(hs_words)) w else 0);
        return
    }
    if (id != HS_CHAPTERS) return;
    list: int = if (status == 200) json_get(body, 0, m, "chapters") else -1;
    if (list < 0) {
        err: int = json_get(body, 0, m, "error");
        en: int = json_str(body, err, m, hs_words);
        daily_limit: str = "daily_limit";
        daily: bool = en == len(daily_limit) && sk_word_is(hs_words, 0, en, daily_limit);
        sk_esv_failed(hs_esv_c, hs_esv_count, status, daily, json_int(body, json_get(body,
            0, m, "retry"), m));
        return
    }
    chapter_position: int = json_first(body, list, m);
    while (chapter_position >= 0) {
        book_position: int = json_get(body, chapter_position, m, "book");
        book_index: int = if (book_position >= 0) hs_book_at(body, book_position + 1,
            m) else -1;
        chapter_number: int = json_int(body, json_get(body, chapter_position, m, "chapter"),
            m);
        record_byte_count: int = json_str(body, json_get(body, chapter_position, m,
            "records"), m, hs_words);
        if (record_byte_count >= len(hs_words)) {
            // Include capacity for the record separator in the response.
            sk_esv_failed(hs_esv_c, hs_esv_count, 502, false, 0);
            return
        }
        if (book_index >= 0 && chapter_number >= 1 && chapter_number <= book_count[book_index]) {
            if (record_byte_count < len(hs_words)) {
                hs_words[record_byte_count] = 10i8;
                record_byte_count = record_byte_count + 1
            }
            sk_esv_came(book_first[book_index] + chapter_number - 1, hs_words, record_byte_count)
        }
        chapter_position = json_next(body, chapter_position, m)
    }
    sk_esv_done()
}

hs_search_came(status: int, body: []i8, m: int) {
    if (status != 200) {
        hs_esr_state = esv_state_for(status, false);
        sk_update_all();
        return
    }
    sk_esr_begin(json_int(body, json_get(body, 0, m, "total"), m), json_int(body,
        json_get(body, 0, m, "page"), m), json_int(body, json_get(body, 0, m, "pages"),
        m));
    p: int = json_first(body, json_get(body, 0, m, "results"), m);
    while (p >= 0) {
        bp: int = json_get(body, p, m, "book");
        k: int = if (bp >= 0) hs_book_at(body, bp + 1, m) else -1;
        num: int = json_int(body, json_get(body, p, m, "chapter"), m);
        key: int = json_int(body, json_get(body, p, m, "key"), m);
        w: int = json_str(body, json_get(body, p, m, "text"), m, hs_words);
        if (w > len(hs_words)) {
            hs_esr_state = esv_state_for(502, false);
            sk_update_all();
            return
        }
        if (k >= 0 && num >= 1 && num <= book_count[k] && w > 0) sk_esr_add(book_first[k] + num - 1,
            key, hs_words, w);
        p = json_next(body, p, m)
    }
    hs_esr_state = 0;
    // (Shown in place of Search's own.)
    sk_esv_results = true;
    sk_update_all()
}

// ---- the lines ----
hs_inbox: []i8 = new i8[1048576](0i8);

// What the app said, sent on whole, at most a megabyte at a time (at a
// line's end).
hs_flush() {
    p: int = 0;
    f: fn(b: []i8, start: int, n: int) = host_io.say;
    while (p < ui_out_n) {
        e: int = if (ui_out_n - p > 1048576) p + 1048576 else ui_out_n;
        while (e > p + 1 && ui_out[e - 1] as int != 10) e = e - 1;
        f(ui_out, p, e - p);
        p = e
    }
    ui_out_n = 0
}

hs_lines(n: int) {
    p: int = 0;
    for i in 0..n {
        if (hs_inbox[i] as int == 10) {
            hs_line(p, i);
            p = i + 1
        }
    }
}

// The line of the inbox from p to e: a file come, a request's answer, the
// site's address, or core's. (Any of them, from any callback: what is kept
// of a file is made in its own arena.)
hs_line(p: int, e: int) {
    if (e - p > 4 && sk_word_is(hs_inbox, p, e, "got")) {
        id: int = sk_num(hs_inbox, p + 4, e);
        hs_got(id, sk_num(hs_inbox, sk_num_end, e))
    } else if (e - p > 5 && sk_word_is(hs_inbox, p, e, "http")) {
        id: int = sk_num(hs_inbox, p + 5, e);
        st: int = sk_num(hs_inbox, sk_num_end, e);
        hs_answer(id, st, sk_num(hs_inbox, sk_num_end, e))
    } else if (sk_word_is(hs_inbox, p, e, "fetching")) {
        id: int = sk_num(hs_inbox, p + 9, e);
        got: int = sk_num(hs_inbox, sk_num_end, e);
        total: int = sk_num(hs_inbox, sk_num_end, e);
        if (id >= SHELF_FETCH_ID_FIRST) shelf_fetching(id, got, total) else held_fetching(id,
            got, total)
    } else if (sk_word_is(hs_inbox, p, e, "fetched")) {
        id: int = sk_num(hs_inbox, p + 8, e);
        st: int = sk_num(hs_inbox, sk_num_end, e);
        bytes_came: int = sk_num(hs_inbox, sk_num_end, e);
        if (id >= SHELF_FETCH_ID_FIRST) shelf_fetched(id, st, bytes_came) else held_fetched(id,
            st, bytes_came)
    } else if (sk_word_is(hs_inbox, p, e, "network")) {
        held_network(sk_num(hs_inbox, p + 8, e));
        shelf_network_changed()
    } else if (e - p > 4 && sk_word_is(hs_inbox, p, e, "api")) {
        hs_api_n = 0;
        for x in p + 4..e {
            if (hs_api_n < len(hs_api)) {
                hs_api[hs_api_n] = hs_inbox[x];
                hs_api_n = hs_api_n + 1
            }
        }
    } else sk_line(hs_inbox, p, e)
}

// After the lines: a version core wants asked for, and what it said sent.
hs_after() {
    t: int = sk_want_text;
    if (t >= 0) {
        sk_want_text = -1;
        if (t != hs_asked_t) {
            hs_asked_t = t;
            hs_ask_version(t)
        }
    }
    hs_flush()
}

// The host hs_begun: core's host its own, the settings read, the version
// read last asked for (or the BSB), and the plans.
hs_stream(data: []i8, start: int, count: int) {
    send: fn(data: []i8, start: int, count: int) = host_io.say;
    send(data, start, count)
}

hs_start() {
    ui_sender = &hs_stream;
    hs_on = true;
    sk_host = SkinHost {
        save_prefs: &kept_save_prefs,
        save_kept: &kept_save,
        words: &hs_say_words,
        switch_version: null,
        num: &hs_num,
        fill: &hs_fill,
        fetch: &hs_fetch
    };
    sk_has_ribbons = true;
    sk_has_listen = true;
    sk_has_keep_on = true;
    sk_has_reminders = true;
    sk_has_card = true;
    sk_has_orig = true;
    sk_has_manual = true;
    sk_has_acknowledgements = true;
    sk_has_downloads = host_io.fetch != null;
    sk_has_shelf = host_io.fetch != null && host_io.read_kept != null;
    kept_load_prefs();
    // (The bookshelf read now: the version kept may be one of its Bibles.)
    if (sk_has_shelf) shelf_load();
    hs_voice_load();
    hs_start_t = launch_version(pref_get("version"), false);
    if (hs_start_t >= TEXT_SHELF_FIRST && !text_is_version(hs_start_t) || hs_start_t < TEXT_SHELF_FIRST && (hs_start_t < 0 || hs_start_t >= len(hs_version_files) || len(hs_version_files[hs_start_t]) == 0)) hs_start_t = 0;
    hs_ask_version(hs_start_t);
    hs_ask(HS_PLAN_M_ID, "plans/mcheyne.txt");
    hs_ask(HS_PLAN_C_ID, "plans/chrono.txt")
}
