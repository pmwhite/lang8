tag bible;

use_tag std;

// Practice (DESIGN.md Â§13.3), apart from any platform: a session of
// passages (and cards, and words to read: a skin's), one at a time.
// Learning goes a part at a time (a warm-up of the parts learned at
// Letters, the new part from Full to Blank, then joined to the one before);
// review is the whole at its level, then Not Yet, Mostly or Knew It, one
// suggested. Type takes first letters, each word's key letter, one retry,
// then a miss. What a skin draws is the state here: the step, the level,
// the words practised (px_a0 to px_a1) and how each shows (px_hidden, the
// helps and misses, the word being typed, the verse heard). Each action
// says what changed in px_changed (PX_CH_), for the skin to show.
import "skin.l8";

import "memory.l8";

// The session: its entries, in order (a passage's id; a card as -1 - its
// index; a word to read as -1000000 - its index), the one shown, and
// whether each has come back once (a Not Yet's).
px_q: []int = new int[512](0);

px_qn: int = 0;

px_at: int = 0;

px_back: []bool = new bool[512](false);

// The passage a one-passage session is of (its id; 0: a session of
// Today's), for the end's next review; and the next session's.
px_one: int = 0;

px_one_next: int = 0;

// The one-time line (memorySeen), on the session's first passage.
px_first_line: bool = false;

// The steps.
PX_WARMUP: int = 0;

PX_WARMUP_DONE: int = 1;

PX_NEW: int = 2;

PX_NEW_DONE: int = 3;

PX_JOINED: int = 4;

PX_JOINED_DONE: int = 5;

PX_REVIEW: int = 6;

PX_REVIEW_DONE: int = 7;

PX_END: int = 8;

PX_WAIT: int = 9;

// A card (a skin's): its front, checked, a new one's first showing; a word
// read, checked; Practise Reading's end.
PX_CARD: int = 10;

PX_CARD_DONE: int = 11;

PX_CARD_NEW: int = 12;

PX_READ: int = 13;

PX_READ_DONE: int = 14;

PX_READ_END: int = 15;

px_step_names: []str = ["warm-up", "warm-up checked", "new part", "new part checked",
    "joined", "joined checked", "review", "review checked", "end", "waiting"];

// The passage shown (its index), its step, its level, the words practised
// now (a0 to a1; those before faint, those after unseen), the part being
// learned.
px_i: int = -1;

px_step: int = 8;

px_level: int = 0;

px_a0: int = 0;

px_a1: int = 0;

px_part: int = 0;

// Each word: shown (by a tap, typing or Check), helped, missed, and wrong
// once while typed; the word being typed (-1: none), and whether typing is
// on (memoryType: the keys up as a passage begins).
px_shown: []bool = new bool[4096](false);

px_help: []bool = new bool[4096](false);

px_miss: []bool = new bool[4096](false);

px_wrong: []bool = new bool[4096](false);

px_cur: int = -1;

px_typing: bool = false;

// Whether the keys are up now (the skin's), the verse washed (heard), and
// the verse in Echo's pause (-1: none: the skin's playback sets them).
px_keys_up: bool = false;

px_wash: int = -1;

px_turn: int = -1;

// What an action changed, for the skin: the words' looks; the buttons; a
// passage begun (its text laid out anew); the end; a card begun (a
// skin's); the keys put away; playback stopped; the words practised to be
// brought into sight; the word typed kept in sight; a felt tick.
PX_CH_PAINT: int = 1;

PX_CH_TOOLS: int = 2;

PX_CH_BEGIN: int = 4;

PX_CH_END: int = 8;

PX_CH_CARD: int = 16;

PX_CH_KEYS_DOWN: int = 32;

PX_CH_STOP: int = 64;

PX_CH_SCROLL: int = 128;

PX_CH_SCROLL_CUR: int = 256;

PX_CH_HAPTIC: int = 512;

PX_CH_WRONG: int = 1024;

// (A word missed while typed: its words in fbuf, "Missed: everyone".)
PX_CH_MISS: int = 2048;

// A card's answer shown (its words cross-fading in), and a word read
// spoken (a skin that speaks).
PX_CH_ANSWER: int = 4096;

PX_CH_SPEAK: int = 8192;

px_changed: int = 0;

px_ch(bits: int) {
    px_changed = px_changed | bits
}

// The text of passage i ready (memory.l8's mt: the host's version's words,
// an ESV passage's once it has come): 1 if it is.
SK_NUM_MEMORY_TEXT: int = 14;

// ---- a session begun, by any of its openers ----
// Today's (the Library's Practice), one passage (its index), a language's
// cards due, Practise Reading (a language), the cards just added (Learn 8
// Letters: sk_pq's).
PXS_TODAY: int = 0;

PXS_ONE: int = 1;

PXS_CARDS: int = 2;

PXS_READING: int = 3;

PXS_NEW: int = 4;

// Whether a session is going (until its skin says it is gone: px_closed).
px_live: bool = false;

px_start(how: int, arg: int) {
    if (px_live) return;
    n: int = if (how == PXS_ONE) px_queue_one(arg) else if (how == PXS_CARDS) px_queue_cards(arg) else if (how == PXS_READING) px_queue_reading(arg) else if (how == PXS_NEW) px_queue_new() else px_queue_today();
    if ((how == PXS_ONE || how == PXS_NEW) && n == 0) return;
    // (None at all: the end's words at once. The host's own sheet, or
    // core's screen.)
    // (SK_NUM_OWN_VIEW: the iPhone's sheet, ios/practice.l8, drawn from
    // this state.)
    if (sk_num_of(SK_NUM_OWN_VIEW, SCR_PRACTICE) == 1) {
        ui_effect("practice_session", n, how);
        return
    }
    px_session(n);
    px_changed = 0;
    sk_open(SCR_PRACTICE, 0, false)
}

px_closed() {
    px_live = false;
    crd_reading = -1;
    px_step = PX_END;
    px_i = -1
}

// Whether the host plays a passage (Listen, Echo) and speaks a card, and
// whether it takes typed letters (Type): 1 if it does.
SK_NUM_PRACTICE_AUDIO: int = 16;

SK_NUM_PRACTICE_KEYS: int = 17;

// Passage i's words laid out in mt (memory.l8's): the host's answer (an
// ESV passage's, once its verses have come), else core's own, from a
// version loaded; whether they are.
px_text(i: int): bool {
    v: int = sk_num_of(SK_NUM_MEMORY_TEXT, i);
    if (v >= 0) return v == 1;
    if (i < 0 || i >= mq_n) return false;
    t: int = mq_ver[i];
    if (t < 0 || t >= len(tx_ready) || t == TEXT_ESV || t == TEXT_PIN || !tx_ready[t]) return false;
    memory_layout_from(text_source(t), mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i], mq_id[i]);
    mw_n > 0
}

// ---- a queue's entries ----
READ_CODE: int = 1000000;

px_entry_card(e: int): int {
    if (e < 0 && -e - 1 < READ_CODE) -e - 1 else -1
}

px_entry_word(e: int): int {
    if (e <= -READ_CODE) -e - READ_CODE else -1
}

px_entry_ok(e: int): bool {
    if (e >= 0) return mem_index(e) >= 0;
    k: int = px_entry_card(e);
    if (k >= 0) return k < cd_n;
    px_entry_word(e) >= 0
}

// ---- a session ----
// A session of the first n of px_q (with px_back) begun; first line
// whether the one-time line shows.
px_session(n: int) {
    px_live = true;
    px_qn = n;
    px_at = 0;
    px_one = px_one_next;
    px_one_next = 0;
    // (The one-time line, once ever; typing as it was left.)
    px_first_line = !pref_on("memorySeen", false);
    if (px_first_line) set_pref_on("memorySeen", true);
    px_typing = pref_on("memoryType", false);
    px_keys_up = false;
    crd_ask_at = -1;
    for x in 0..n
        if (x < len(crd_ret)) crd_ret[x] = RET_FIRST;
    px_changed = 0;
    px_begin()
}

// Today's passages (the Library's Practice), into px_q (the host adds its
// cards after them); how many.
px_queue_today(): int {
    crd_reading = -1;
    memory_today(sk_today_now(), 0);
    n: int = 0;
    for k in 0..td_today {
        px_q[n] = mq_id[td[k]];
        px_back[n] = false;
        n = n + 1
    }
    // (Then today's cards: Â§14.3.1.)
    if (cd_n == 0) return n;
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    cd_today(sk_today_now());
    for x in 0..ct_n {
        if (n < len(px_q)) {
            px_q[n] = -ct[x] - 1;
            px_back[n] = false;
            n = n + 1
        }
    }
    n
}

// One passage (a row, or Memorizing), whatever its state.
px_queue_one(i: int): int {
    crd_reading = -1;
    if (i < 0 || i >= mq_n) return 0;
    px_q[0] = mq_id[i];
    px_back[0] = false;
    px_one_next = mq_id[i];
    1
}

// The cards just added (Learn 8 Letters: sk_pq's).
px_queue_new(): int {
    crd_reading = -1;
    n: int = 0;
    for x in 0..sk_pq_n {
        if (n < len(px_q)) {
            px_q[n] = -sk_pq[x] - 1;
            px_back[n] = false;
            n = n + 1
        }
    }
    n
}

// "2 of 3": the session's entry shown and its entries, each once (a Not
// Yet's second try, or a new card back for its judgement, is not counted
// again); n 0 or 1, no count.
px_count_at: int = 0;

px_count_n: int = 0;

px_count_find() {
    n: int = 0;
    at: int = 0;
    for x in 0..px_qn {
        if (!px_back[x] && (x >= len(crd_ret) || crd_ret[x] == RET_FIRST)) {
            n = n + 1;
            if (x <= px_at) at = n
        }
    }
    px_count_at = at;
    px_count_n = (if (px_at < px_qn) n else 0)
}

// ---- a passage begun ----
px_begin() {
    px_ch(PX_CH_STOP | PX_CH_BEGIN | PX_CH_TOOLS);
    px_turn = -1;
    px_wash = -1;
    while (px_at < px_qn && !px_entry_ok(px_q[px_at])) px_at = px_at + 1;
    if (px_at >= px_qn) {
        px_finish();
        return
    }
    // (A card, or a word to read.)
    if (px_q[px_at] < 0) {
        px_i = -1;
        px_card_begin(px_q[px_at]);
        px_ch(PX_CH_CARD);
        return
    }
    i: int = mem_index(px_q[px_at]);
    px_i = i;
    if (mq_state[i] == MS_NEW) {
        memory_open(i, sk_today_now());
        sk_kept(SK_KEPT_MEMORY)
    }
    if (!px_text(i)) {
        px_step = PX_WAIT;
        return
    }
    if (mq_state[i] == MS_LEARNING) {
        k: int = mq_learned[i];
        if (k >= mpt_n) k = mpt_n - 1;
        if (k > 0) px_set(PX_WARMUP, LV_LETTERS, 0, mpt_w0[k], k) else px_set(PX_NEW,
            LV_FULL, mpt_w0[0], mpt_w1[0], 0)
    } else px_set(PX_REVIEW, mq_level[i], 0, mw_n, 0);
    px_ch(PX_CH_PAINT)
}

// The step set: its level, its words, the part; nothing shown yet.
px_set(
    step: int,
    level: int,
    a0: int,
    a1: int,
    part: int
) {
    px_step = step;
    px_level = level;
    px_a0 = a0;
    px_a1 = a1;
    px_part = part;
    for w in 0..mw_n {
        px_shown[w] = false;
        px_help[w] = false;
        px_miss[w] = false;
        px_wrong[w] = false
    }
    px_cur = -1;
    if (px_typing && px_typing_allowed()) px_cur = px_next_word(a0)
}

// How word w shows now: 0 whole, 1 its key letter, 2 none.
px_hidden(w: int): int {
    if (w < px_a0 || w >= px_a1 || px_shown[w]) return 0;
    memory_hidden(w, px_level)
}

// Word w shown (a help).
px_show_word(w: int) {
    if (w < 0 || w >= mw_n || px_hidden(w) == 0) return;
    px_shown[w] = true;
    px_help[w] = true;
    if (w == px_cur) px_cur = px_next_word(w + 1);
    px_ch(PX_CH_PAINT)
}

// Verse x's hidden words shown (each a help); whether it had any.
px_show_verse(x: int): bool {
    if (x < 0 || x >= mv_n) return false;
    any: bool = false;
    for w in mv_w0[x]..mv_w1[x] {
        if (px_hidden(w) > 0) {
            px_shown[w] = true;
            px_help[w] = true;
            any = true
        }
    }
    if (!any) return false;
    if (px_cur >= 0 && px_shown[px_cur]) px_cur = px_next_word(px_cur);
    px_ch(PX_CH_PAINT);
    true
}

// The helps and misses seen in the words practised.
px_helps(): int {
    n: int = 0;
    for w in px_a0..px_a1
        if (px_help[w]) n = n + 1;
    n
}

px_misses(): int {
    n: int = 0;
    for w in px_a0..px_a1
        if (px_miss[w]) n = n + 1;
    n
}

// ---- the level ----
px_set_level(lv: int) {
    if (lv < 0 || lv > 3 || lv == px_level) return;
    px_level = lv;
    // (A review's level is kept for next time.)
    if (px_step == PX_REVIEW && px_i >= 0) {
        mq_level[px_i] = lv;
        sk_kept(SK_KEPT_MEMORY)
    }
    px_ch(PX_CH_PAINT | PX_CH_TOOLS)
}

// ---- the main button ----
// What its next press does, as its title.
px_main_title(): str {
    if (px_step == PX_NEW && px_level < LV_BLANK || px_step == PX_WARMUP_DONE) return "Next";
    if (px_step == PX_NEW_DONE || px_step == PX_JOINED_DONE) {
        k: int = px_part;
        last: bool = k + 1 >= mpt_n;
        if (!last) return "Next Verse";
        if (px_at + 1 < px_qn) return "Next Passage";
        return "Done"
    }
    "Check"
}

// Next (a level on), Check, or what comes after Check.
px_main() {
    // (A card: Next after a new one's first showing or a word read, else
    // Check.)
    if (px_step == PX_CARD_NEW || px_step == PX_READ_DONE) {
        px_card_next();
        return
    }
    if (px_step == PX_CARD || px_step == PX_READ) {
        px_card_check();
        return
    }
    if (px_step == PX_NEW && px_level < LV_BLANK) {
        px_set_level(px_level + 1);
        return
    }
    if (px_step == PX_WARMUP || px_step == PX_NEW || px_step == PX_JOINED || px_step == PX_REVIEW) {
        px_check();
        return
    }
    if (px_step == PX_WARMUP_DONE) {
        k: int = px_part;
        px_set(PX_NEW, LV_FULL, mpt_w0[k], mpt_w1[k], k);
        px_after_step();
        return
    }
    if (px_step == PX_NEW_DONE) {
        // Next Verse (or Done): the part learned; joined to the one before.
        k: int = px_part;
        last: bool = k + 1 >= mpt_n;
        memory_part_checked(px_i, mpt_n, sk_today_now(), time(0));
        sk_kept(SK_KEPT_MEMORY);
        if (k >= 1) {
            px_set(PX_JOINED, LV_BLANK, mpt_w0[k - 1], mpt_w1[k], k);
            px_after_step();
            return
        }
        if (last) {
            px_next_passage();
            return
        }
        px_set(PX_NEW, LV_FULL, mpt_w0[k + 1], mpt_w1[k + 1], k + 1);
        px_after_step();
        return
    }
    if (px_step == PX_JOINED_DONE) {
        k: int = px_part;
        if (k + 1 >= mpt_n) {
            px_next_passage();
            return
        }
        px_set(PX_NEW, LV_FULL, mpt_w0[k + 1], mpt_w1[k + 1], k + 1);
        px_after_step()
    }
}

// Again: this part from Some.
px_again() {
    if (px_step != PX_NEW_DONE) return;
    k: int = px_part;
    px_set(PX_NEW, LV_SOME, mpt_w0[k], mpt_w1[k], k);
    px_after_step()
}

px_after_step() {
    px_ch(PX_CH_PAINT | PX_CH_TOOLS);
    // (A new part, or the two joined, brought into sight.)
    if ((px_step == PX_NEW || px_step == PX_JOINED) && px_a1 > px_a0) px_ch(PX_CH_SCROLL)
}

// Check: every word practised shown; then the judgement (review), Again
// and Next Verse (a new part), or Next.
px_check() {
    if (px_step == PX_CARD || px_step == PX_READ) {
        px_card_check();
        return
    }
    for w in px_a0..px_a1 px_shown[w] = true;
    px_cur = -1;
    if (px_step == PX_WARMUP) px_step = PX_WARMUP_DONE else if (px_step == PX_NEW) px_step = PX_NEW_DONE else if (px_step == PX_JOINED) px_step = PX_JOINED_DONE else if (px_step == PX_REVIEW) px_step = PX_REVIEW_DONE;
    if (px_step == PX_WARMUP_DONE) px_part = mq_learned[px_i];
    px_ch(PX_CH_KEYS_DOWN | PX_CH_STOP | PX_CH_PAINT | PX_CH_TOOLS)
}

px_suggested(): int {
    memory_suggest(px_helps(), px_misses(), px_a1 - px_a0)
}

// A grade: kept, and on to the next passage (a Not Yet comes once more at
// the end).
px_grade(g: int) {
    if (px_step == PX_CARD_DONE) {
        px_card_grade(g);
        return
    }
    if (px_step != PX_REVIEW_DONE || px_i < 0) return;
    // (A Not Yet's second try, at the session's end: nothing changes.)
    if (px_back[px_at]) memory_grade_again(px_i, g, px_helps(), px_misses(), time(0)) else _c: bool = memory_grade(px_i,
        g, sk_today_now(), px_helps(), px_misses(), time(0));
    sk_kept(SK_KEPT_MEMORY);
    px_ch(PX_CH_HAPTIC);
    if (g == G_NOTYET && !px_back[px_at] && px_qn < len(px_q)) {
        px_q[px_qn] = mq_id[px_i];
        px_back[px_qn] = true;
        px_qn = px_qn + 1
    }
    px_next_passage()
}

// On: the next passage, or the end.
px_next_passage() {
    px_at = px_at + 1;
    px_first_line = false;
    px_begin()
}

// The end: "That's all for today." and the next review.
px_finish() {
    px_ch(PX_CH_END | PX_CH_KEYS_DOWN | PX_CH_STOP | PX_CH_TOOLS);
    px_step = PX_END;
    px_i = -1
}

// The end's words into fbuf: its first line ("That's all for today.";
// Practise Reading's "That's 10 words. Again?"), or the line under it.
px_end_first() {
    fbuf_n = 0;
    if (px_step == PX_READ_END) {
        fput_str("That\â\€\™s ");
        fput_int(px_qn);
        fput_str(if (px_qn == 1) " word. Again?" else " words. Again?")
    } else fput_str("That\â\€\™s all for today.")
}

px_end_words() {
    fbuf_n = 0;
    if (px_step == PX_READ_END) return;
    // (A session of one passage: its own next review, whatever came after
    // a Not Yet.)
    single: int = if (px_one > 0) mem_index(px_one) else -1;
    td: int = sk_today_now();
    if (single >= 0 && mq_due[single] >= 0) {
        fput_str("Next review: ");
        if (mq_due[single] <= td) fput_str("Today") else fput_day_word(mq_due[single],
            td)
    } else _n: bool = fput_next_review(td)
}

// ---- Type: first letters (Â§13.3.6) ----
px_typing_allowed(): bool {
    px_step == PX_WARMUP || px_step == PX_NEW || px_step == PX_JOINED || px_step == PX_REVIEW
}

// Typing on or off (memoryType, kept): the keys up as each passage begins.
px_typing_set(on: bool) {
    px_typing = on;
    set_pref_on("memoryType", on)
}

// The keys up or down (the skin's): the word to type the next not shown.
px_keys_set(up: bool) {
    px_keys_up = up;
    if (up && px_cur < 0) px_cur = px_next_word(px_a0);
    if (!up) px_cur = -1;
    px_ch(PX_CH_PAINT | PX_CH_TOOLS)
}

// The first word practised from w not shown yet (-1: none).
px_next_word(w: int): int {
    x: int = if (w < px_a0) px_a0 else w;
    while (x < px_a1) {
        if (!px_shown[x]) return x;
        x = x + 1
    }
    -1
}

// A key typed (a code point): the current word's key letter shows it; a
// wrong one once fades its underline; twice, it shows as a miss (its
// words in fbuf: "Missed: everyone"). After the last, Check.
px_type(k: int) {
    if (px_cur < 0 || !px_typing_allowed()) return;
    letter: bool = k >= 48 && k <= 57 || k >= 65 && k <= 90 || k >= 97 && k <= 122 || is_orig_letter(k);
    if (!letter) return;
    w: int = px_cur;
    if (memory_key_is(w, k)) {
        px_shown[w] = true;
        px_cur = px_next_word(w + 1)
    } else if (!px_wrong[w]) {
        px_wrong[w] = true;
        px_ch(PX_CH_WRONG);
        return
    } else {
        px_shown[w] = true;
        px_miss[w] = true;
        px_cur = px_next_word(w + 1);
        fbuf_n = 0;
        fput_str("Missed: ");
        for q in mw_k[w]..mw_h2[w] fput(mt[q] as int);
        px_ch(PX_CH_MISS)
    }
    if (px_cur < 0) {
        px_check();
        return
    }
    px_ch(PX_CH_PAINT | PX_CH_SCROLL_CUR)
}

// ---- cards and words to read (Â§14.3), in a session ----
// The card shown (its index; -1: a word read), its language, whether this
// is a new card's first showing, whether its answer shows, and its verse
// and word in context; Practise Reading's language (-1: none), its round
// of ten and the word read; whether the one-time line shows; where Your
// Words' question was asked (its place in the queue; -1 none yet); each
// entry's kind of return (RET_), set as it is queued.
crd_k: int = -1;

crd_lang: int = 0;

crd_first: bool = false;

crd_checked: bool = false;

crd_vi: int = -1;

crd_w: int = -1;

crd_reading: int = -1;

crd_round: int = 0;

crd_read_w: int = -1;

crd_hint: bool = false;

crd_ask_at: int = -1;

crd_ret: []int = new int[512](0);

// A language's cards due today (from its page, its Today row, Your Words).
px_queue_cards(lang: int): int {
    crd_reading = -1;
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    cd_today(sk_today_now());
    n: int = 0;
    for x in 0..ct_n {
        k: int = ct[x];
        if (cd_lang[k] == lang && n < len(px_q)) {
            px_q[n] = -k - 1;
            px_back[n] = false;
            n = n + 1
        }
    }
    n
}

// Practise Reading: ten words (Â§14.3.3), a round at a time.
px_queue_reading(lang: int): int {
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    crd_reading = lang;
    crd_round = 0;
    px_reading_words()
}

px_reading_words(): int {
    learn_reading_words(crd_reading, crd_round * 10, time(0));
    if (pr_n == 0 && crd_round > 0) {
        crd_round = 0;
        learn_reading_words(crd_reading, 0, time(0))
    }
    for x in 0..pr_n {
        px_q[x] = -pr_w[x] - READ_CODE;
        px_back[x] = false;
        crd_ret[x] = RET_FIRST
    }
    pr_n
}

// Again (at Practise Reading's end): the next ten.
px_reading_again() {
    if (px_step != PX_READ_END) return;
    crd_round = crd_round + 1;
    px_qn = px_reading_words();
    px_at = 0;
    px_begin()
}

// Entry e begun: a card (its context found; a new one back once more at
// the end, hidden, for a judgement), or a word to read.
px_card_begin(e: int) {
    if (crd_reading >= 0) {
        crd_read_w = px_entry_word(e);
        crd_k = -1;
        crd_lang = crd_reading;
        crd_first = false;
        crd_checked = false;
        crd_vi = -1;
        crd_w = crd_read_w;
        // (Its one-time line, the first word ever read.)
        if (!pref_on("learnReadSeen", false)) {
            crd_hint = true;
            set_pref_on("learnReadSeen", true)
        }
        px_step = PX_READ;
        return
    }
    k: int = px_entry_card(e);
    crd_k = k;
    crd_lang = cd_lang[k];
    crd_first = cd_state[k] == MS_NEW;
    crd_checked = crd_first;
    // (The one-time line, the first time a new letter or joined word is
    // seen; a word card asks its question instead.)
    if (crd_first && cd_kind[k] != CK_WORD && !pref_on("learnSeen", false)) {
        crd_hint = true;
        set_pref_on("learnSeen", true)
    }
    learn_shown(k, sk_today_now());
    if (crd_first && px_qn < len(px_q)) {
        px_q[px_qn] = -k - 1;
        px_back[px_qn] = false;
        crd_ret[px_qn] = RET_NEW;
        px_qn = px_qn + 1
    }
    _c: bool = learn_context(k, time(0));
    crd_vi = ctx_vi;
    crd_w = ctx_w;
    if (crd_ask_at < 0 && cd_kind[k] == CK_WORD) crd_ask_at = px_at;
    px_step = (if (crd_first) PX_CARD_NEW else PX_CARD);
    sk_kept(SK_KEPT_CARDS)
}

// The session's title while a card shows: "Greek Words" ("Greek Letters"
// while only letters are in it); "Practise Reading".
px_card_title(): str {
    if (crd_reading >= 0) return "Practise Reading";
    letters: bool = true;
    for x in px_at..px_qn {
        c: int = px_entry_card(px_q[x]);
        if (c >= 0 && c < cd_n && cd_kind[c] != CK_LETTER) letters = false;
        if (px_q[x] > 0) letters = false
    }
    if (crd_lang == 0 && letters) return "Greek Letters";
    if (crd_lang == 0) return "Greek Words";
    if (letters) "Hebrew Letters" else "Hebrew Words"
}

// The main button's title while a card shows.
px_card_main_title(): str {
    if (px_step == PX_CARD_NEW || px_step == PX_READ_DONE) "Next" else "Check"
}

// Check: the answer shown; then the judgement (reading: the
// transliteration, and Next; nothing said).
px_card_check() {
    if (px_step != PX_CARD && px_step != PX_READ) return;
    crd_checked = true;
    if (px_step == PX_READ) {
        px_step = PX_READ_DONE;
        px_ch(PX_CH_SPEAK)
    } else px_step = PX_CARD_DONE;
    px_ch(PX_CH_ANSWER | PX_CH_TOOLS)
}

// A judgement: kept; Not Yet's card once more at the end.
px_card_grade(g: int) {
    if (px_step != PX_CARD_DONE || crd_k < 0) return;
    k: int = crd_k;
    ret: int = if (px_back[px_at]) RET_RETRY else crd_ret[px_at];
    next: int = learn_judged(k, g, ret, sk_today_now(), time(0), crd_vi);
    sk_kept(SK_KEPT_CARDS);
    px_ch(PX_CH_HAPTIC);
    if (next == RET_RETRY && px_qn < len(px_q)) {
        px_q[px_qn] = -k - 1;
        px_back[px_qn] = true;
        crd_ret[px_qn] = RET_RETRY;
        px_qn = px_qn + 1
    }
    px_card_next()
}

// On: the next entry (a passage, a card, a word), or the end (Practise
// Reading's: "That's 10 words. Again?").
px_card_next() {
    crd_hint = false;
    if (crd_reading >= 0 && px_at + 1 >= px_qn) {
        px_step = PX_READ_END;
        px_ch(PX_CH_END | PX_CH_TOOLS);
        return
    }
    px_next_passage()
}

// ---- how each word looks (Â§13.3.4): the text as a skin paints it ----
// The passage's text (mt) in runs, each to its end (a byte of mt) with its
// look: a color (PXL_), an underline (PXU_, times 4) and the verse heard
// washed (PXL_WASH). The words practised in ink, those learned faint,
// those not reached not at all (each word with what follows it, to the
// next); the verses' numbers faint where the verse is reached; a hidden
// word's hidden letters clear and the word underlined (the word to type
// in the accent, the verse in Echo's pause half the accent); a word shown
// marked (helped, half the accent; missed, dotted).
PXL_CLEAR: int = 0;

PXL_INK: int = 1;

PXL_LEARNED: int = 2;

PXL_FAINT: int = 3;

PXU_NONE: int = 0;

PXU_RULE: int = 1;

PXU_ACCENT: int = 2;

PXU_HALF: int = 3;

PXU_DOTTED: int = 4;

PXL_WASH: int = 32;

pxl_color: []i8 = new i8[65536](0i8);

pxl_under: []i8 = new i8[65536](0i8);

pxl_end: []int = new int[16384](0);

pxl_look: []int = new int[16384](0);

pxl_n: int = 0;

pxl_paint(b: int, e: int, color: int) {
    for q in b..e pxl_color[q] = color trunc i8
}

pxl_line(b: int, e: int, under: int) {
    for q in b..e pxl_under[q] = under trunc i8
}

// The runs, with cur the word marked to type (-1: none; a skin's keys up).
px_looks(cur: int) {
    pxl_n = 0;
    if (px_i < 0 || mw_n == 0) return;
    pxl_paint(0, mt_n, PXL_CLEAR);
    pxl_line(0, mt_n, PXU_NONE);
    for w in 0..px_a1 {
        e: int = if (w + 1 < mw_n) mw_b[w + 1] else mt_n;
        pxl_paint(mw_b[w], e, if (w < px_a0) PXL_LEARNED else PXL_INK)
    }
    for x in 0..mv_n {
        if (mv_num_b[x] >= 0) {
            reached: bool = mv_w0[x] < px_a1;
            e: int = mv_num_e[x];
            if (e < 0) e = mv_num_b[x];
            q: int = e;
            while (q < mt_n && mt_vn[q]) q = q + 1;
            pxl_paint(mv_num_b[x], q, if (!reached) PXL_CLEAR else if (mv_w1[x] <= px_a0) PXL_LEARNED else PXL_FAINT)
        }
    }
    for w in px_a0..px_a1 {
        h: int = px_hidden(w);
        x: int = mw_vi[w];
        if (h > 0) {
            from: int = if (h == 2) mw_k[w] else mw_k2[w];
            q: int = from;
            while (q < mw_h2[w]) {
                cp: int = mt_cp(q);
                n: int = mt_cl;
                if (mem_hideable(cp)) pxl_paint(q, q + n, PXL_CLEAR);
                q = q + n
            }
            pxl_line(from, mw_h2[w], if (w == cur) PXU_ACCENT else if (x == px_turn) PXU_HALF else PXU_RULE)
        } else if (x == px_turn) pxl_line(mw_k[w], mw_h2[w], PXU_HALF) else if (px_miss[w]) pxl_line(mw_k[w],
            mw_h2[w], PXU_DOTTED) else if (px_help[w]) pxl_line(mw_k[w], mw_h2[w],
            PXU_HALF) else if (w == cur) pxl_line(mw_k[w], mw_h2[w], PXU_ACCENT)
    }
    wb: int = if (px_wash >= 0 && px_wash < mv_n) mv_b[px_wash] else -1;
    we: int = if (wb >= 0) mv_e[px_wash] else -1;
    for q in 0..mt_n {
        look: int = pxl_color[q] as int + pxl_under[q] as int * 4 + (if (q >= wb && q < we) PXL_WASH else 0);
        if (pxl_n > 0 && pxl_look[pxl_n - 1] == look) pxl_end[pxl_n - 1] = q + 1 else if (pxl_n < len(pxl_end)) {
            pxl_end[pxl_n] = q + 1;
            pxl_look[pxl_n] = look;
            pxl_n = pxl_n + 1
        }
    }
}

// ---- a card's face (Â§14.3.2), part by part, as a skin lays it out ----
// "New" and the one-time line; the word (the lemma, the letter, the
// joined word, or the word to read); its transliteration; the verse's
// reference; the verse window (a letter's example); the question; the
// answer; the sense here and its meaning; the verse in the BSB; the
// lemma's line; related words known.
PXC_TOP: int = 0;

PXC_WORD: int = 1;

PXC_TR: int = 2;

PXC_CAP: int = 3;

PXC_WINDOW: int = 4;

PXC_ASK: int = 5;

PXC_ANSWER: int = 6;

PXC_HERE: int = 7;

PXC_VERSE: int = 8;

PXC_META: int = 9;

PXC_RELATED: int = 10;

// A part's stressed bytes of fbuf (the window's form, the example's
// letter, the verse's English for the word; the sense here's meaning from
// pxc_b on), -1 none; and the related words' lemmas (in their script).
pxc_b: int = -1;

pxc_e: int = -1;

pxc_ob: []int = new int[2](0);

pxc_oe: []int = new int[2](0);

pxc_on: int = 0;

// Part's words into fbuf.
px_card_part(part: int) {
    fbuf_n = 0;
    pxc_b = -1;
    pxc_e = -1;
    pxc_on = 0;
    lang: int = crd_lang;
    k: int = crd_k;
    letter: bool = k >= 0 && cd_kind[k] != CK_WORD;
    word: bool = k >= 0 && !letter;
    reading: bool = crd_reading >= 0;
    i: int = if (letter) cd_key[k] else -1;
    if (part == PXC_TOP) {
        // (Its line's space kept on every card, so the word sits in one
        // place; the reading's, only the first time.)
        if (!reading) fput_str("New");
        if (crd_hint && (crd_first || reading)) {
            if (!reading) fput_str("\n");
            if (reading) fput_str("Read it to yourself, then Check.") else fput_str(if (cd_kind[k] == CK_LETTER) "Say its name and sound, then Check." else "Say what it means, then Check.")
        }
    } else if (part == PXC_WORD) {
        if (reading) {
            form_of(crd_read_w);
            fput_bytes(lforms, wf_b, wf_e)
        } else if (letter) fput_lt(i, LF_GLYPH) else if (word) fput_lemma(lang, cd_key[k],
            0)
    } else if (part == PXC_TR) {
        if (reading) {
            form_of(crd_read_w);
            fput_bytes(lforms, wt_b, wt_e)
        } else if (word) fput_lemma(lang, cd_key[k], 1)
    } else if (part == PXC_CAP) {
        if (crd_vi >= 0 && !reading) fput_ref(v_chapter(crd_vi), v_num(crd_vi), 0)
    } else if (part == PXC_WINDOW) {
        if (letter) {
            lt_example(i);
            fput_bytes(exm, 0, exm_n);
            pxc_b = exm_b;
            pxc_e = exm_e
        } else if (word && crd_vi >= 0 && crd_w >= 0) {
            // (Up to 12 words around the form, in the original's order;
            // "â€¦" where cut.)
            learn_window(crd_vi, crd_w);
            if (ow_from > 0) fput_str("\â\€\¦ ");
            for o in ow_from..ow_to {
                w: int = word_at_order(crd_vi, o);
                if (w >= 0) {
                    form_of(w);
                    if (o > ow_from) fput(32);
                    if (w == crd_w) pxc_b = fbuf_n;
                    fput_bytes(lforms, wf_b, wf_e);
                    if (w == crd_w) pxc_e = fbuf_n
                }
            }
            if (ow_to < v_end(crd_vi) - v_first(crd_vi)) fput_str(" \â\€\¦")
        }
    } else if (part == PXC_ASK) {
        if (word && px_at == crd_ask_at) fput_str("What does it mean here?")
    } else if (part == PXC_ANSWER) {
        // (A word: the BSB's words for it in this verse, else its gloss; a
        // letter: its name and sound.)
        if (letter) {
            fput_lt(i, LF_NAME);
            if (cd_kind[k] == CK_LETTER) {
                fput_str(" \Â\· ");
                fput_lt_sound(i, sk_ln_pron(lang))
            }
        } else if (word && !fput_words_here(crd_vi, crd_w)) {
            fbuf_n = 0;
            px_card_gloss()
        }
    } else if (part == PXC_HERE) {
        // (The sense here, as part of the answer; then UBS's meaning here,
        // quieter: "Here:" and the definition.)
        if (word) {
            _h: bool = fput_sense_here(crd_vi, crd_w);
            had: bool = fbuf_n > 0;
            m: int = w_meaning(crd_w);
            if (m > 0) {
                pxc_b = fbuf_n;
                if (had) fput(10) else fput_str("Here: ");
                fput_meaning(m)
            }
        }
    } else if (part == PXC_VERSE) {
        if (!reading && crd_vi >= 0) {
            study_load(crd_vi);
            a: int = if (st_title > 0) st_title + 1 else 0;
            fput_bytes(st, a, st_n);
            if (crd_w >= 0) {
                chunk_of(crd_w);
                if (ch_e > ch_b && ch_b >= a) {
                    pxc_b = ch_b - a;
                    pxc_e = ch_e - a
                }
            }
        }
    } else if (part == PXC_META) {
        if (reading) fput_str("transliteration, a guide to the letters") else if (letter && cd_kind[k] == CK_JOINED) fput_str(if (lt_part[i] < 6) "joined to the front of a word" else "joined to the end of a word") else if (letter) {
            // (Its example, transliterated, and its meaning.)
            if (crd_w >= 0) {
                form_of(crd_w);
                fput_bytes(lforms, wt_b, wt_e);
                fput_str(": ")
            }
            fput_lemma(lang, lt_key[i], 3)
        } else if (word) fput_card_meta(lang, cd_key[k])
    } else if (part == PXC_RELATED) {
        // ("Related: Ï†Î¹Î»Î­Ï‰ to love, á¼€Î³Î¬Ï€Î· love": up to two words of its
        // family known, Â§10.4's list.)
        if (!word) return;
        learn_related_known(lang, cd_key[k]);
        if (rk_n == 0) return;
        fput_str("Related: ");
        for x in 0..rk_n {
            if (x > 0) fput_str(", ");
            if (x < len(pxc_ob)) pxc_ob[x] = fbuf_n;
            if (lang == 1) fput_rli();
            fput_lemma(lang, rk_num[x], 0);
            if (lang == 1) fput_pdi();
            if (x < len(pxc_oe)) {
                pxc_oe[x] = fbuf_n;
                pxc_on = x + 1
            }
            fput(32);
            fput_lemma(lang, rk_num[x], 3)
        }
    }
}

// Whether part shows now (its space kept while it does not: clear).
px_card_part_shown(part: int): bool {
    reading: bool = crd_reading >= 0;
    if (part == PXC_TOP) return crd_first || reading;
    if (part == PXC_TR) return if (reading) crd_checked else !(kn_alpha[crd_lang] && !crd_checked);
    if (part == PXC_ANSWER || part == PXC_HERE || part == PXC_VERSE || part == PXC_META || part == PXC_RELATED) return crd_checked;
    true
}

// The lemma's gloss (its sense's, in this verse): where the verse has no
// English for it.
px_card_gloss() {
    k: int = crd_k;
    greek: bool = cd_lang[k] == 0;
    e: int = if (crd_w >= 0) meaning_entry(greek, cd_key[k], w_sense(crd_w)) else -1;
    if (e < 0) e = lex_first(greek, cd_key[k]);
    if (e < 0) return;
    lex_field(e, 3);
    fput_gloss(lf_b, lf_e)
}

// ---- the buttons at the foot (Â§13.3.5), as a skin lays them out ----
// Listen, Echo, Type, Again, the main button (px_main_title; a card's,
// px_card_main_title), the grades (one suggested: px_grade_suggested),
// Speak (a card), Practise Reading's Again, and Done.
PXT_LISTEN: int = 1;

PXT_ECHO: int = 2;

PXT_TYPE: int = 3;

PXT_AGAIN: int = 4;

PXT_MAIN: int = 5;

PXT_GRADES: int = 6;

PXT_SPEAK: int = 7;

PXT_READ_AGAIN: int = 8;

PXT_DONE: int = 9;

pxt: []int = new int[8](0);

pxt_n: int = 0;

pxt_add(kind: int) {
    if (pxt_n < len(pxt)) {
        pxt[pxt_n] = kind;
        pxt_n = pxt_n + 1
    }
}

// The step's buttons, in order, into pxt (none at the end, or waiting).
px_tools() {
    pxt_n = 0;
    if (px_step == PX_READ_END) {
        pxt_add(PXT_READ_AGAIN);
        pxt_add(PXT_DONE);
        return
    }
    if (px_step == PX_CARD_DONE || px_step == PX_REVIEW_DONE) {
        pxt_add(PXT_GRADES);
        return
    }
    if (px_step == PX_CARD || px_step == PX_CARD_NEW || px_step == PX_READ || px_step == PX_READ_DONE) {
        pxt_add(PXT_SPEAK);
        pxt_add(PXT_MAIN);
        return
    }
    if (px_step == PX_END || px_step == PX_WAIT || px_i < 0) return;
    pxt_add(PXT_LISTEN);
    pxt_add(PXT_ECHO);
    if (px_typing_allowed()) pxt_add(PXT_TYPE);
    if (px_step == PX_NEW_DONE) pxt_add(PXT_AGAIN);
    pxt_add(PXT_MAIN)
}

// The main button's title now.
px_main_now(): str {
    if (px_step >= PX_CARD && px_step <= PX_READ_DONE) px_card_main_title() else px_main_title()
}

// The grade suggested (a card's: nothing typed to judge by, so none).
px_grade_suggested(): int {
    if (px_step == PX_REVIEW_DONE) px_suggested() else -1
}

// (No recording of the original yet, and no voice for it: Â§14.10b.1.)
px_listen_off(): bool {
    mt_orig
}

px_grade_titles: []str = ["Not Yet", "Mostly", "Knew It"];

// ---- core's screen of it (SCR_PRACTICE: a skin without its own) ----
SCR_PRACTICE: int = 44;

ACT_PX_LEVEL: int = 160;

ACT_PX_MAIN: int = 161;

ACT_PX_AGAIN: int = 162;

ACT_PX_GRADE: int = 163;

ACT_PX_WORD: int = 164;

ACT_PX_VERSE: int = 165;

ACT_PX_DONE: int = 166;

ACT_PX_READ_AGAIN: int = 167;

ACT_PX_TYPE: int = 168;

ACT_PX_KEY: int = 169;

ACT_PX_LISTEN: int = 170;

ACT_PX_ECHO: int = 171;

ACT_PX_SPEAK: int = 172;

// Each byte of mt's UTF-16 place (for the links).
pxl_u16: []int = new int[65537](0);

sk_build_practice(id: int) {
    ui_begin(id, SCR_PRACTICE, 0, "");
    ui_set_confirm("Done", ACT_PX_DONE);
    if (px_i >= 0) _t: bool = px_text(px_i);
    // ("2 of 3" at the bar's left, while there is more than one.)
    px_count_find();
    if (px_count_n > 1 && px_step != PX_END && px_step != PX_READ_END) {
        fbuf_n = 0;
        fput_int(px_count_at);
        fput_str(" of ");
        fput_int(px_count_n);
        ui_left = ui_put_fbuf();
        ui_left_style = UI_TOOL_OFF
    }
    if (px_step == PX_END || px_step == PX_READ_END) {
        px_end_first();
        ui_empty_title = ui_put_fbuf();
        px_end_words();
        ui_empty_line = ui_put_fbuf()
    } else if (px_step >= PX_CARD && px_step <= PX_READ_DONE) sk_px_card() else if (px_i >= 0) sk_px_passage();
    px_tools();
    audio: bool = sk_num_of(SK_NUM_PRACTICE_AUDIO, 0) == 1;
    keys: bool = sk_num_of(SK_NUM_PRACTICE_KEYS, 0) == 1;
    for t in 0..pxt_n {
        k: int = pxt[t];
        if (k == PXT_LISTEN && audio && !px_listen_off()) {
            ui_tool("", "play.fill", ACT_PX_LISTEN, 0, UI_TOOL_PLAIN, 0);
            fbuf_n = 0;
            fput_str("Listen");
            ui_set_tool_label_fbuf()
        } else if (k == PXT_ECHO && audio && !px_listen_off()) {
            ui_tool("", "repeat", ACT_PX_ECHO, 0, UI_TOOL_PLAIN, 0);
            fbuf_n = 0;
            fput_str("Echo, plays a verse then pauses for you to say it.");
            ui_set_tool_label_fbuf()
        } else if (k == PXT_SPEAK && audio) ui_tool("", "speaker.wave.2", ACT_PX_SPEAK,
            0, UI_TOOL_PLAIN, 0) else if (k == PXT_TYPE && keys) ui_tool("", if (px_keys_up) "keyboard.chevron.compact.down" else "keyboard",
            ACT_PX_TYPE, 0, UI_TOOL_PLAIN, 1) else if (k == PXT_AGAIN) ui_tool("Again",
            "", ACT_PX_AGAIN, 0, UI_TOOL_PLAIN, 2) else if (k == PXT_MAIN) ui_tool(px_main_now(),
            "", ACT_PX_MAIN, 0, UI_TOOL_PROMINENT, 2) else if (k == PXT_READ_AGAIN) ui_tool("Again",
            "", ACT_PX_READ_AGAIN, 0, UI_TOOL_PLAIN, 0) else if (k == PXT_DONE) ui_tool("Done",
            "", ACT_PX_DONE, 0, UI_TOOL_PROMINENT, 2) else if (k == PXT_GRADES) {
            s: int = px_grade_suggested();
            for g in 0..3 ui_tool(px_grade_titles[g], "", ACT_PX_GRADE, g, if (g == s) UI_TOOL_PROMINENT else UI_TOOL_PLAIN,
                1)
        }
    }
}

// A passage: its caption and the one-time line; the level; its words as a
// page's paragraph, each run's look (RUN_PRACTICE plus px_looks' look,
// plus 64 Greek, 128 Hebrew), a hidden word's tap showing it, a verse
// number's its verse.
sk_px_passage() {
    fbuf_n = 0;
    fput_passage(px_i);
    ui_set_screen_title_fbuf();
    if (px_step == PX_WAIT) {
        px_wait_words();
        ui_set_intro_fbuf();
        return
    }
    ui_set_segments("Full|Some|Letters|Blank", px_level, ACT_PX_LEVEL);
    ui_rich_begin();
    fput_caption(px_i);
    ui_rich(RUN_SMALL);
    if (px_first_line) {
        fput(10);
        fput_str(px_first_words);
        ui_rich(RUN_FAINT)
    }
    ui_rich_intro();
    ui_plain = true;
    ui_page = true;
    ui_section("", "");
    ui_row(UI_TEXT, 0, px_i);
    px_looks(if (px_keys_up) px_cur else -1);
    script: int = if (!mt_orig) 0 else if (mt_rtl) 128 else 64;
    ui_rich_begin();
    p: int = 0;
    for r in 0..pxl_n {
        fput_bytes(mt, p, pxl_end[r]);
        ui_rich(RUN_PRACTICE + pxl_look[r] + script);
        p = pxl_end[r]
    }
    ui_rich_title();
    n: int = 0;
    for q in 0..mt_n {
        pxl_u16[q] = n;
        k: int = mt[q] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    pxl_u16[mt_n] = n;
    for w in px_a0..px_a1
        if (px_hidden(w) > 0) ui_add_link(pxl_u16[mw_k[w]], pxl_u16[mw_h2[w]], ACT_PX_WORD,
            w);
    for x in 0..mv_n {
        if (mv_num_b[x] >= 0 && mv_w0[x] < px_a1) {
            e: int = if (mv_num_e[x] >= 0) mv_num_e[x] else mv_num_b[x];
            if (e > mv_num_b[x]) ui_add_link(pxl_u16[mv_num_b[x]], pxl_u16[e], ACT_PX_VERSE,
                x)
        }
    }
}

// An ESV passage whose verses have not come: Â§9.4.6's words, into fbuf.
px_wait_words() {
    fbuf_n = 0;
    fput_str(if (sk_esv_listed) "Waiting for the ESV\â\€\¦" else "The ESV isn\â\€\™t available. Change this passage\â\€\™s version in its details.")
}

// A card: its word as the heading (its transliteration under it, once it
// shows), "New" and the one-time line above; then its parts, each a
// paragraph, the answer's once checked.
sk_px_card() {
    ui_title = ui_put(px_card_title());
    script: int = if (crd_lang == 0) RUN_GREEK else RUN_HEBREW;
    px_card_part(PXC_WORD);
    ui_hero = ui_put_fbuf();
    ui_hero_script = script;
    px_card_part(PXC_TR);
    if (px_card_part_shown(PXC_TR)) ui_hero_sub = ui_put_fbuf();
    px_card_part(PXC_TOP);
    if (fbuf_n > 0 && px_card_part_shown(PXC_TOP)) ui_set_intro_fbuf();
    ui_plain = true;
    ui_page = true;
    ui_section("", "");
    faint: int = if (crd_lang == 0) RUN_GREEK_FAINT else RUN_HEBREW_FAINT;
    letter: bool = crd_k >= 0 && cd_kind[crd_k] != CK_WORD;
    sk_px_part(PXC_CAP, RUN_FAINT, RUN_FAINT);
    sk_px_part(PXC_WINDOW, if (letter) script else faint, if (letter) RUN_ACCENT else script);
    sk_px_part(PXC_ASK, RUN_FAINT, RUN_FAINT);
    if (!crd_checked) return;
    sk_px_part(PXC_ANSWER, RUN_STRONG, RUN_STRONG);
    sk_px_part(PXC_HERE, RUN_PLAIN, RUN_FAINT);
    sk_px_part(PXC_VERSE, RUN_SCRIPTURE, RUN_STRONG);
    sk_px_part(PXC_META, RUN_FAINT, RUN_FAINT);
    sk_px_part(PXC_RELATED, RUN_FAINT, script)
}

// A card's part as a paragraph: its words in style, its stressed bytes in
// stress (the sense here: its meaning from there on; related words: their
// lemmas).
sk_px_part(part: int, style: int, stress: int) {
    px_card_part(part);
    if (fbuf_n == 0) return;
    n: int = fbuf_n;
    for q in 0..n ui_pool_scratch[q] = fbuf[q];
    b: int = pxc_b;
    e: int = if (part == PXC_HERE) n else pxc_e;
    ui_row(UI_TEXT, 0, part);
    ui_rich_begin();
    if (part == PXC_RELATED) {
        p: int = 0;
        for x in 0..pxc_on {
            fput_bytes(ui_pool_scratch, p, pxc_ob[x]);
            ui_rich(style);
            fput_bytes(ui_pool_scratch, pxc_ob[x], pxc_oe[x]);
            ui_rich(stress);
            p = pxc_oe[x]
        }
        fput_bytes(ui_pool_scratch, p, n);
        ui_rich(style)
    } else if (b >= 0 && e > b) {
        fput_bytes(ui_pool_scratch, 0, b);
        ui_rich(style);
        fput_bytes(ui_pool_scratch, b, e);
        ui_rich(stress);
        fput_bytes(ui_pool_scratch, e, n);
        ui_rich(style)
    } else {
        fput_bytes(ui_pool_scratch, 0, n);
        ui_rich(style)
    }
    ui_rich_title()
}

// (A part's words, while fbuf is made again from them.)
ui_pool_scratch: []i8 = new i8[65536](0i8);

// What a skin's tap on core's screen does.
sk_px_act(
    at: int,
    action: int,
    arg: int,
    value: int
) {
    id: int = sk_ids[at];
    if (action == ACT_PX_DONE) {
        sk_n = at;
        px_closed();
        ui_effect("close", id, -1);
        sk_update_all();
        return
    }
    if (px_i >= 0) _t: bool = px_text(px_i);
    if (action == ACT_PX_LEVEL) px_set_level(value) else if (action == ACT_PX_MAIN) px_main() else if (action == ACT_PX_AGAIN) px_again() else if (action == ACT_PX_GRADE) px_grade(arg) else if (action == ACT_PX_WORD) px_show_word(arg) else if (action == ACT_PX_VERSE) _v: bool = px_show_verse(arg) else if (action == ACT_PX_READ_AGAIN) px_reading_again() else if (action == ACT_PX_TYPE) {
        px_typing_set(!px_keys_up);
        px_keys_set(!px_keys_up)
    } else if (action == ACT_PX_KEY) px_type(arg) else ui_effect("practice_audio",
        action, arg);
    // (What changed: all of it, made again.)
    px_changed = 0;
    sk_build(at);
    ui_effect("update", id, -1)
}

// ---- a passage's words, for its row and details ----
// Passage i's first words (most bytes), into fbuf (none if its text isn't
// here).
mm_words(i: int, most: int) {
    ok: bool = px_text(i);
    fbuf_n = 0;
    if (ok) fput_first_words(most)
}

// The verses its learned parts cover.
mm_learned(i: int): int {
    if (i < 0 || i >= mq_n || mq_state[i] != MS_LEARNING || !px_text(i)) return 0;
    memory_verses_learned(mq_learned[i])
}

// Its state line, into fbuf: an ESV passage whose verses haven't come, the
// wait's words; else where it stands.
mm_state(i: int) {
    if (mq_ver[i] == TEXT_ESV && !esv_pin_ready(mq_id[i])) {
        px_wait_words();
        return
    }
    learned: int = mm_learned(i);
    fbuf_n = 0;
    fput_memory_state(i, sk_today_now(), learned, mem_verses(i))
}

// Version ver's words of the range parsed (rg_*), as much as fits, into
// fbuf: the ESV's the host's (its verses held); any other's here, if it is
// loaded.
mm_range_words(ver: int) {
    if (ver == TEXT_ESV) {
        sk_words_of(SK_WORDS_RANGE_TEXT, ver);
        return
    }
    fbuf_n = 0;
    if (ver < 0 || ver >= len(tx_ready) || !tx_ready[ver]) return;
    memory_layout_from(text_source(ver), rg_c1, rg_v1, rg_c2, rg_v2, 1);
    fbuf_n = 0;
    if (mt_n > 0) fput_first_words(2000)
}

// Passage i deleted (an ESV passage's pins let go: the host keeps them).
mm_delete_now(i: int) {
    if (i < 0 || i >= mq_n) return;
    id: int = mq_id[i];
    was_esv: bool = mq_ver[i] == TEXT_ESV;
    memory_delete(i, time(0));
    sk_kept(SK_KEPT_MEMORY);
    if (was_esv) {
        esv_pin_remove(id);
        ui_effect("pins_changed", -1, -1)
    }
}

// Passage id read in version ver: refused if the ESV can't keep it (a
// toast); its learned verses kept as parts of the new version's; the
// ESV's pins kept, and its verses fetched (the host's).
mm_set_version(id: int, ver: int) {
    i: int = mem_index(id);
    if (i < 0 || ver == mq_ver[i]) return;
    if (ver == TEXT_ESV && mm_esv_refusal_words(mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i]) != 0) {
        ui_toast(TOAST_BRAIN);
        return
    }
    learned_v: int = mm_learned(i);
    old: int = mq_ver[i];
    mq_ver[i] = ver;
    k: int = 0;
    if (mq_state[i] == MS_LEARNING && ver != TEXT_ESV && px_text(i)) k = memory_parts_for_verses(learned_v);
    mq_ver[i] = old;
    memory_set_version(i, ver, k);
    if (old == TEXT_ESV) esv_pin_remove(mq_id[i]);
    if (ver == TEXT_ESV) _p: bool = esv_pin_add(mq_id[i], mq_c1[i], mq_v1[i], mq_c2[i],
        mq_v2[i]);
    if (old == TEXT_ESV || ver == TEXT_ESV) ui_effect("pins_changed", -1, -1);
    if (ver == TEXT_ESV) ui_effect("mm_fetch", i, -1);
    sk_kept(SK_KEPT_MEMORY)
}
