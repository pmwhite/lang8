tag bible;

use_tag std;

// Practice (DESIGN.md Â§13.3), apart from any platform: a session of
// passages, one at a time.
// Learning goes a part at a time (a warm-up of the parts learned at
// Letters, the new part from Full to Blank, then joined to the one before);
// review is the whole at its level, then Not Yet or Knew It, one
// suggested (Knew It after helps or misses keeps a passage where it is). Type takes first letters, each word's key letter, one retry,
// then a miss. What a skin draws is the state here: the step, the level,
// the words practised (px_a0 to px_a1) and how each shows (px_hidden, the
// helps and misses, the word being typed, the verse heard). A grade is
// felt (`felt 0`), a wrong letter too (`felt 1`), a miss announced to a
// screen reader (`announce` WORDS).
import "skin.l8";

import "memory.l8";

// The session: its entries, in order (a passage's id), the one shown, and
// whether each has come back once (a Not Yet's).
px_q: []int = new int[512](0);

px_qn: int = 0;

px_at: int = 0;

px_back: []bool = new bool[512](false);

// The passage a one-passage session is of (its id; 0: a session of
// Today's), for the end's next review; and the next session's.
px_one: int = 0;

px_one_next: int = 0;

// The one-time line (memorySeen), on the session's first passage.
px_first_line: bool = false;

// The steps.
PX_WARMUP: int = 0;

PX_WARMUP_DONE: int = 1;

PX_NEW: int = 2;

PX_NEW_DONE: int = 3;

PX_JOINED: int = 4;

PX_JOINED_DONE: int = 5;

PX_REVIEW: int = 6;

PX_REVIEW_DONE: int = 7;

PX_END: int = 8;

PX_WAIT: int = 9;

px_step_names: []str = ["warm-up", "warm-up checked", "new part", "new part checked",
    "joined", "joined checked", "review", "review checked", "end", "waiting"];

// The passage shown (its index), its step, its level, the words practised
// now (a0 to a1; those before faint, those after unseen), the part being
// learned.
px_i: int = -1;

px_step: int = 8;

px_level: int = 0;

px_a0: int = 0;

px_a1: int = 0;

px_part: int = 0;

// Each word: shown (by a tap, typing or Check), helped, missed, and wrong
// once while typed; the word being typed (-1: none), and whether typing is
// on (memoryType: the keys up as a passage begins).
px_shown: []bool = new bool[4096](false);

px_help: []bool = new bool[4096](false);

px_miss: []bool = new bool[4096](false);

px_wrong: []bool = new bool[4096](false);

px_cur: int = -1;

px_typing: bool = false;

// Whether the keys are up now (the skin's), the verse washed (heard), and
// the verse in Echo's pause (-1: none: the skin's playback sets them).
px_keys_up: bool = false;

px_wash: int = -1;

px_turn: int = -1;

// What the skin makes felt (`felt KIND`): a grade given, a wrong letter.
PX_FELT_GRADE: int = 0;

PX_FELT_WRONG: int = 1;

// The text of passage i ready (memory.l8's mt: the host's version's words,
// an ESV passage's once it has come): 1 if it is.
SK_NUM_MEMORY_TEXT: int = 14;

// ---- a session begun, by any of its openers ----
// Today's (the Library's Practice), or one passage (its index).
PXS_TODAY: int = 0;

PXS_ONE: int = 1;

// Whether a session is going (until its skin says it is gone: px_closed).
px_live: bool = false;

// How the session began (a PXS_): its end says "for today" only for
// what was due.
px_how: int = PXS_TODAY;

px_start(how: int, arg: int) {
    if (px_live) return;
    px_how = how;
    n: int = if (how == PXS_ONE) px_queue_one(arg) else px_queue_today();
    if (how == PXS_ONE && n == 0) return;
    // (None at all: the end's words at once, on core's screen.)
    px_session(n);
    sk_open(SCR_PRACTICE, 0, false)
}

px_closed() {
    pxw_stop();
    px_live = false;
    px_step = PX_END;
    px_i = -1
}

// Whether the host plays a passage (Listen, Echo), and whether it takes
// typed letters (Type): 1 if it does.
SK_NUM_PRACTICE_AUDIO: int = 16;

SK_NUM_PRACTICE_KEYS: int = 17;

// Passage i's words laid out in mt (memory.l8's): the host's answer (an
// ESV passage's, once its verses have come), else core's own, from a
// version loaded; whether they are.
px_text(i: int): bool {
    v: int = sk_num_of(SK_NUM_MEMORY_TEXT, i);
    if (v >= 0) return v == 1;
    if (i < 0 || i >= mq_n) return false;
    t: int = mq_ver[i];
    if (t == TEXT_ESV || t == TEXT_PIN || !text_ready(t)) return false;
    borrow texts[t] as text {
        memory_layout_from(text, mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i], mq_id[i])
    }
    mw_n > 0
}

// ---- a session ----
// A session of the first n of px_q (with px_back) begun; first line
// whether the one-time line shows.
px_session(n: int) {
    px_live = true;
    px_qn = n;
    px_at = 0;
    px_one = px_one_next;
    px_one_next = 0;
    // (The one-time line, once ever; typing as it was left.)
    px_first_line = !pref_is("memorySeen");
    if (px_first_line) set_pref_on("memorySeen", true);
    px_typing = pref_is("memoryType");
    px_keys_up = false;
    px_begin()
}

// Today's passages (the Library's Practice), into px_q; how many.
px_queue_today(): int {
    memory_today(sk_today_now(), 0);
    n: int = 0;
    for k in 0..td_today {
        px_q[n] = mq_id[td[k]];
        px_back[n] = false;
        n = n + 1
    }
    n
}

// One passage (a row, or Memorizing), whatever its state.
px_queue_one(i: int): int {
    if (i < 0 || i >= mq_n) return 0;
    px_q[0] = mq_id[i];
    px_back[0] = false;
    px_one_next = mq_id[i];
    1
}

// "2 of 3": the session's entry shown and its entries, each once (a Not
// Yet's second try is not counted again); n 0 or 1, no count.
px_count_at: int = 0;

px_count_n: int = 0;

px_count_find() {
    n: int = 0;
    at: int = 0;
    for x in 0..px_qn {
        if (!px_back[x]) {
            n = n + 1;
            if (x <= px_at) at = n
        }
    }
    px_count_at = at;
    px_count_n = (if (px_at < px_qn) n else 0)
}

// The count, "2 of 3", into fbuf (spoken: "Passage 2 of 3"); whether it
// shows (while there is more than one).
px_count_words(spoken: bool): bool {
    px_count_find();
    // (Coming back to those missed, after every one has been seen: how
    // many are left, so the end can be seen coming.)
    back: bool = px_at < px_qn && px_back[px_at];
    if (back) {
        left: int = px_qn - px_at;
        fbuf_n = 0;
        fput_int(left);
        fput_str(if (spoken) if (left == 1) " passage left" else " passages left" else " left");
        return true
    }
    if (px_count_n <= 1) return false;
    if (spoken) fput_count_label("Passage", px_count_at, px_count_n) else fput_count_of(px_count_at,
        px_count_n);
    true
}

// ---- a passage begun ----
px_begin() {
    pxw_stop();
    px_turn = -1;
    px_wash = -1;
    while (px_at < px_qn && mem_index(px_q[px_at]) < 0) px_at = px_at + 1;
    if (px_at >= px_qn) {
        px_finish();
        return
    }
    i: int = mem_index(px_q[px_at]);
    px_i = i;
    if (mq_state[i] == MS_NEW) {
        memory_open(i, sk_today_now());
        sk_kept(SK_KEPT_MEMORY)
    }
    if (!px_text(i)) {
        px_step = PX_WAIT;
        return
    }
    if (mq_state[i] == MS_LEARNING) {
        k: int = mq_learned[i];
        if (k >= mpt_n) k = mpt_n - 1;
        if (k > 0) px_set(PX_WARMUP, LV_LETTERS, 0, mpt_w0[k], k) else px_set(PX_NEW,
            LV_FULL, mpt_w0[0], mpt_w1[0], 0)
    } else px_set(PX_REVIEW, mq_level[i], 0, mw_n, 0)
}

// The step set: its level, its words, the part; nothing shown yet.
px_set(
    step: int,
    level: int,
    a0: int,
    a1: int,
    part: int
) {
    px_step = step;
    px_level = level;
    px_a0 = a0;
    px_a1 = a1;
    px_part = part;
    for w in 0..mw_n {
        px_shown[w] = false;
        px_help[w] = false;
        px_miss[w] = false;
        px_wrong[w] = false
    }
    px_cur = -1;
    if (px_typing && px_typing_allowed()) px_cur = px_next_word(a0)
}

// How word w shows now: 0 whole, 1 its key letter, 2 none.
px_hidden(w: int): int {
    if (w < px_a0 || w >= px_a1 || px_shown[w]) return 0;
    memory_hidden(w, px_level)
}

// Word w shown (a help).
px_show_word(w: int) {
    if (w < 0 || w >= mw_n || px_hidden(w) == 0) return;
    px_shown[w] = true;
    px_help[w] = true;
    if (w == px_cur) px_cur = px_next_word(w + 1)
}

// Verse x's hidden words shown (each a help); whether it had any.
// What is at byte p of the passage's text (mt): a verse's number (its
// verse, -1 none; one of the part's), or a word of the part (-1 none). A
// tap on either shows what it hides.
px_verse_at(p: int): int {
    for x in 0..mv_n {
        b: int = mv_num_b[x];
        if (b >= 0 && mv_w0[x] < px_a1) {
            e: int = if (mv_num_e[x] > b) mv_num_e[x] else b + 1;
            if (p >= b && p < e) return x
        }
    }
    -1
}

// Part k's first hidden word (-1 none): what its Show Next Word shows, and
// whose verse its Show Verse shows (a screen reader's actions on it).
px_part_hidden(k: int): int {
    if (k < 0 || k >= mpt_n) return -1;
    for w in mpt_w0[k]..mpt_w1[k]
        if (px_hidden(w) > 0) return w;
    -1
}

px_word_at(p: int): int {
    for w in px_a0..px_a1
        if (p >= mw_b[w] && p < mw_e[w]) return w;
    -1
}

px_show_verse(x: int): bool {
    if (x < 0 || x >= mv_n) return false;
    any: bool = false;
    for w in mv_w0[x]..mv_w1[x] {
        if (px_hidden(w) > 0) {
            px_shown[w] = true;
            px_help[w] = true;
            any = true
        }
    }
    if (!any) return false;
    if (px_cur >= 0 && px_shown[px_cur]) px_cur = px_next_word(px_cur);
    true
}

// The helps and misses seen in the words practised.
px_helps(): int {
    n: int = 0;
    for w in px_a0..px_a1
        if (px_help[w]) n = n + 1;
    n
}

px_misses(): int {
    n: int = 0;
    for w in px_a0..px_a1
        if (px_miss[w]) n = n + 1;
    n
}

// ---- the level ----
px_set_level(lv: int) {
    if (lv < 0 || lv > 3 || lv == px_level) return;
    px_level = lv;
    // (A review's level is kept for next time.)
    if (px_step == PX_REVIEW && px_i >= 0) {
        mq_level[px_i] = lv;
        sk_kept(SK_KEPT_MEMORY)
    }
}

// ---- the main button ----
// What its next press does, as its title.
px_main_title(): str {
    if (px_step == PX_NEW && px_level < LV_BLANK || px_step == PX_WARMUP_DONE) return "Next";
    if (px_step == PX_NEW_DONE || px_step == PX_JOINED_DONE) {
        k: int = px_part;
        last: bool = k + 1 >= mpt_n;
        if (!last) return "Next Verse";
        if (px_at + 1 < px_qn) return "Next Passage";
        return "Done"
    }
    "Check"
}

// Next (a level on), Check, or what comes after Check.
px_main() {
    if (px_step == PX_NEW && px_level < LV_BLANK) {
        px_set_level(px_level + 1);
        return
    }
    if (px_step == PX_WARMUP || px_step == PX_NEW || px_step == PX_JOINED || px_step == PX_REVIEW) {
        px_check();
        return
    }
    if (px_step == PX_WARMUP_DONE) {
        k: int = px_part;
        px_set(PX_NEW, LV_FULL, mpt_w0[k], mpt_w1[k], k);
        return
    }
    if (px_step == PX_NEW_DONE) {
        // Next Verse (or Done): the part learned; joined to the one before.
        k: int = px_part;
        last: bool = k + 1 >= mpt_n;
        memory_part_checked(px_i, mpt_n, sk_today_now(), time(0));
        sk_kept(SK_KEPT_MEMORY);
        if (k >= 1) {
            px_set(PX_JOINED, LV_BLANK, mpt_w0[k - 1], mpt_w1[k], k);
            return
        }
        if (last) {
            px_next_passage();
            return
        }
        px_set(PX_NEW, LV_FULL, mpt_w0[k + 1], mpt_w1[k + 1], k + 1);
        return
    }
    if (px_step == PX_JOINED_DONE) {
        k: int = px_part;
        if (k + 1 >= mpt_n) {
            px_next_passage();
            return
        }
        px_set(PX_NEW, LV_FULL, mpt_w0[k + 1], mpt_w1[k + 1], k + 1)
    }
}

// Again: this part from Some.
px_again() {
    if (px_step != PX_NEW_DONE) return;
    k: int = px_part;
    px_set(PX_NEW, LV_SOME, mpt_w0[k], mpt_w1[k], k)
}

// Check: every word practised shown; then the judgement (review), Again
// and Next Verse (a new part), or Next.
px_check() {
    for w in px_a0..px_a1 px_shown[w] = true;
    px_cur = -1;
    if (px_step == PX_WARMUP) px_step = PX_WARMUP_DONE else if (px_step == PX_NEW) px_step = PX_NEW_DONE else if (px_step == PX_JOINED) px_step = PX_JOINED_DONE else if (px_step == PX_REVIEW) px_step = PX_REVIEW_DONE;
    if (px_step == PX_WARMUP_DONE) px_part = mq_learned[px_i];
    pxw_stop()
}

px_suggested(): int {
    memory_suggest(px_helps(), px_misses(), px_a1 - px_a0)
}

// A grade: kept, and on to the next passage (a Not Yet comes once more at
// the end).
px_grade(g: int) {
    if (px_step != PX_REVIEW_DONE || px_i < 0) return;
    // (A Not Yet's second try, at the session's end: nothing changes.)
    seen: int = memory_grade_seen(g, px_helps(), px_misses());
    if (px_back[px_at]) memory_grade_again(px_i, seen, px_helps(), px_misses(), time(0)) else _c: bool = memory_grade(px_i,
        seen, sk_today_now(), px_helps(), px_misses(), time(0));
    sk_kept(SK_KEPT_MEMORY);
    ui_effect("felt", PX_FELT_GRADE, -1);
    if (g == G_NOTYET && !px_back[px_at] && px_qn < len(px_q)) {
        px_q[px_qn] = mq_id[px_i];
        px_back[px_qn] = true;
        px_qn = px_qn + 1
    }
    px_next_passage()
}

// On: the next passage, or the end.
px_next_passage() {
    px_at = px_at + 1;
    px_first_line = false;
    px_begin()
}

// The end: "That's all for today." and the next review.
px_finish() {
    pxw_stop();
    px_step = PX_END;
    px_i = -1
}

// The end's words into fbuf: its first line ("That's all for today."), or
// the line under it.
px_end_first() {
    fbuf_n = 0;
    fput_str(if (px_how != PXS_TODAY) "That\â\€\™s all of them." else "That\â\€\™s all for today.")
}

px_end_words() {
    fbuf_n = 0;
    // (A session of one passage: its own next review, whatever came after
    // a Not Yet.)
    single: int = if (px_one > 0) mem_index(px_one) else -1;
    td: int = sk_today_now();
    if (single >= 0 && mq_due[single] >= 0) {
        if (mq_due[single] <= td) fput_str("It comes back later today.") else {
            fput_str("Next review: ");
            fput_day_word(mq_due[single], td)
        }
    } else _n: bool = fput_next_review(td)
}

// ---- Type: first letters (Â§13.3.6) ----
px_typing_allowed(): bool {
    px_step == PX_WARMUP || px_step == PX_NEW || px_step == PX_JOINED || px_step == PX_REVIEW
}

// Typing on or off (memoryType, kept): the keys up as each passage begins.
px_typing_set(on: bool) {
    px_typing = on;
    set_pref_on("memoryType", on)
}

// The keys up or down (the skin's): the word to type the next not shown.
px_keys_set(up: bool) {
    px_keys_up = up;
    if (up && px_cur < 0) px_cur = px_next_word(px_a0);
    if (!up) px_cur = -1
}

// The first word practised from w not shown yet (-1: none).
px_next_word(w: int): int {
    x: int = if (w < px_a0) px_a0 else w;
    while (x < px_a1) {
        if (!px_shown[x]) return x;
        x = x + 1
    }
    -1
}

// A key typed (a code point): the current word's key letter shows it; a
// wrong one once fades its underline; twice, it shows as a miss (its
// words in fbuf: "Missed: everyone"). After the last, Check.
px_type(k: int) {
    if (px_cur < 0 || !px_typing_allowed()) return;
    letter: bool = k >= 48 && k <= 57 || k >= 65 && k <= 90 || k >= 97 && k <= 122 || is_orig_letter(k);
    if (!letter) return;
    w: int = px_cur;
    if (memory_key_is(w, k)) {
        px_shown[w] = true;
        px_cur = px_next_word(w + 1)
    } else if (!px_wrong[w]) {
        px_wrong[w] = true;
        ui_effect("felt", PX_FELT_WRONG, -1);
        return
    } else {
        px_shown[w] = true;
        px_miss[w] = true;
        px_cur = px_next_word(w + 1);
        fbuf_n = 0;
        fput_str("Missed: ");
        for q in mw_k[w]..mw_h2[w] fput(mt[q] as int);
        ui_effect_fbuf("announce")
    }
    if (px_cur < 0) px_check()
}

// ---- how each word looks (Â§13.3.4): the text as a skin paints it ----
// The passage's text (mt) in runs, each to its end (a byte of mt) with its
// look: a color (PXL_), an underline (PXU_, times 4) and the verse heard
// washed (PXL_WASH). The words practised in ink, those learned faint,
// those not reached not at all (each word with what follows it, to the
// next); the verses' numbers faint where the verse is reached; a hidden
// word's hidden letters clear and the word underlined (the word to type
// in the accent, the verse in Echo's pause half the accent); a word shown
// marked (helped, half the accent; missed, dotted).
PXL_CLEAR: int = 0;

PXL_INK: int = 1;

PXL_LEARNED: int = 2;

PXL_FAINT: int = 3;

PXU_NONE: int = 0;

PXU_RULE: int = 1;

PXU_ACCENT: int = 2;

PXU_HALF: int = 3;

PXU_DOTTED: int = 4;

PXL_WASH: int = 32;

pxl_color: []i8 = new i8[65536](0i8);

pxl_under: []i8 = new i8[65536](0i8);

pxl_end: []int = new int[16384](0);

pxl_look: []int = new int[16384](0);

pxl_n: int = 0;

pxl_paint(b: int, e: int, color: int) {
    for q in b..e pxl_color[q] = color trunc i8
}

pxl_line(b: int, e: int, under: int) {
    for q in b..e pxl_under[q] = under trunc i8
}

// The runs, with cur the word marked to type (-1: none; a skin's keys up).
px_looks(cur: int) {
    pxl_n = 0;
    if (px_i < 0 || mw_n == 0) return;
    pxl_paint(0, mt_n, PXL_CLEAR);
    pxl_line(0, mt_n, PXU_NONE);
    for w in 0..px_a1 {
        e: int = if (w + 1 < mw_n) mw_b[w + 1] else mt_n;
        pxl_paint(mw_b[w], e, if (w < px_a0) PXL_LEARNED else PXL_INK)
    }
    for x in 0..mv_n {
        if (mv_num_b[x] >= 0) {
            reached: bool = mv_w0[x] < px_a1;
            e: int = mv_num_e[x];
            if (e < 0) e = mv_num_b[x];
            q: int = e;
            while (q < mt_n && mt_vn[q]) q = q + 1;
            pxl_paint(mv_num_b[x], q, if (!reached) PXL_CLEAR else if (mv_w1[x] <= px_a0) PXL_LEARNED else PXL_FAINT)
        }
    }
    for w in px_a0..px_a1 {
        h: int = px_hidden(w);
        x: int = mw_vi[w];
        if (h > 0) {
            from: int = if (h == 2) mw_k[w] else mw_k2[w];
            q: int = from;
            while (q < mw_h2[w]) {
                cp: int = mt_cp(q);
                n: int = mt_cl;
                if (mem_hideable(cp)) pxl_paint(q, q + n, PXL_CLEAR);
                q = q + n
            }
            pxl_line(from, mw_h2[w], if (w == cur) PXU_ACCENT else if (x == px_turn) PXU_HALF else PXU_RULE)
        } else if (x == px_turn) pxl_line(mw_k[w], mw_h2[w], PXU_HALF) else if (px_miss[w]) pxl_line(mw_k[w],
            mw_h2[w], PXU_DOTTED) else if (px_help[w]) pxl_line(mw_k[w], mw_h2[w],
            PXU_HALF) else if (w == cur) pxl_line(mw_k[w], mw_h2[w], PXU_ACCENT)
    }
    wb: int = if (px_wash >= 0 && px_wash < mv_n) mv_b[px_wash] else -1;
    we: int = if (wb >= 0) mv_e[px_wash] else -1;
    for q in 0..mt_n {
        look: int = pxl_color[q] as int + pxl_under[q] as int * 4 + (if (q >= wb && q < we) PXL_WASH else 0);
        if (pxl_n > 0 && pxl_look[pxl_n - 1] == look) pxl_end[pxl_n - 1] = q + 1 else if (pxl_n < len(pxl_end)) {
            pxl_end[pxl_n] = q + 1;
            pxl_look[pxl_n] = look;
            pxl_n = pxl_n + 1
        }
    }
}

// ---- the buttons at the foot (Â§13.3.5), as a skin lays them out ----
// Listen, Echo, Type, Again, the main button (px_main_title), and the
// grades (one suggested: px_suggested).
PXT_LISTEN: int = 1;

PXT_ECHO: int = 2;

PXT_TYPE: int = 3;

PXT_AGAIN: int = 4;

PXT_MAIN: int = 5;

PXT_GRADES: int = 6;

pxt: []int = new int[8](0);

pxt_n: int = 0;

pxt_add(kind: int) {
    if (pxt_n < len(pxt)) {
        pxt[pxt_n] = kind;
        pxt_n = pxt_n + 1
    }
}

// The step's buttons, in order, into pxt (none at the end, or waiting).
px_tools() {
    pxt_n = 0;
    if (px_step == PX_REVIEW_DONE) {
        pxt_add(PXT_GRADES);
        return
    }
    if (px_step == PX_END || px_step == PX_WAIT || px_i < 0) return;
    pxt_add(PXT_LISTEN);
    pxt_add(PXT_ECHO);
    if (px_typing_allowed()) pxt_add(PXT_TYPE);
    if (px_step == PX_NEW_DONE) pxt_add(PXT_AGAIN);
    pxt_add(PXT_MAIN)
}

// (No recording of the original yet, and no voice for it: Â§14.10b.1.)
px_listen_off(): bool {
    mt_orig
}

// The grades offered, by their codes (G_MOSTLY is none of them).
px_grades: []int = [G_NOTYET, G_KNEW];

px_grade_titles: []str = ["Not Yet", "", "Knew It"];

// ---- core's screen of it (SCR_PRACTICE: a skin without its own) ----
SCR_PRACTICE: int = 44;

ACT_PX_LEVEL: int = 160;

ACT_PX_MAIN: int = 161;

ACT_PX_AGAIN: int = 162;

ACT_PX_GRADE: int = 163;

ACT_PX_WORD: int = 164;

ACT_PX_VERSE: int = 165;

ACT_PX_DONE: int = 166;

ACT_PX_TYPE: int = 168;

ACT_PX_KEY: int = 169;

ACT_PX_LISTEN: int = 170;

ACT_PX_ECHO: int = 171;

// Each byte of mt's UTF-16 place (for the links).
pxl_u16: []int = new int[65537](0);

sk_build_practice(id: int) {
    ui_begin(id, SCR_PRACTICE, 0, "");
    ui_set_confirm("Done", ACT_PX_DONE);
    if (px_i >= 0) _t: bool = px_text(px_i);
    // ("2 of 3" at the bar's left, while there is more than one.)
    if (px_step != PX_END && px_count_words(false)) {
        ui_left = ui_put_fbuf();
        ui_left_style = UI_TOOL_OFF
    }
    if (px_step == PX_END) {
        px_end_first();
        ui_empty_title = ui_put_fbuf();
        px_end_words();
        ui_empty_line = ui_put_fbuf()
    } else if (px_i >= 0) sk_px_passage();
    px_tools();
    audio: bool = sk_num_of(SK_NUM_PRACTICE_AUDIO, 0) == 1;
    keys: bool = sk_num_of(SK_NUM_PRACTICE_KEYS, 0) == 1;
    for t in 0..pxt_n {
        k: int = pxt[t];
        if (k == PXT_LISTEN && audio && !px_listen_off()) {
            ui_tool("", "play.fill", ACT_PX_LISTEN, 0, UI_TOOL_PLAIN, 0);
            fbuf_n = 0;
            fput_str("Listen");
            ui_set_tool_label_fbuf()
        } else if (k == PXT_ECHO && audio && !px_listen_off()) {
            ui_tool("", "repeat", ACT_PX_ECHO, 0, UI_TOOL_PLAIN, 0);
            fbuf_n = 0;
            fput_str("Echo, plays a verse then pauses for you to say it.");
            ui_set_tool_label_fbuf()
        } else if (k == PXT_TYPE && keys) ui_tool("", if (px_keys_up) "keyboard.chevron.compact.down" else "keyboard",
            ACT_PX_TYPE, 0, UI_TOOL_PLAIN, 1) else if (k == PXT_AGAIN) ui_tool("Again",
            "", ACT_PX_AGAIN, 0, UI_TOOL_PLAIN, 2) else if (k == PXT_MAIN) ui_tool(px_main_title(),
            "", ACT_PX_MAIN, 0, UI_TOOL_PROMINENT, 2) else if (k == PXT_GRADES) {
            s: int = px_suggested();
            for g in px_grades ui_tool(px_grade_titles[g], "", ACT_PX_GRADE, g, if (g == s) UI_TOOL_PROMINENT else UI_TOOL_PLAIN,
                1)
        }
    }
}

// A passage: its caption and the one-time line; the level; its words as a
// page's paragraph, each run's look (RUN_PRACTICE plus px_looks' look,
// plus 64 Greek, 128 Hebrew), a hidden word's tap showing it, a verse
// number's its verse.
sk_px_passage() {
    fbuf_n = 0;
    fput_passage(px_i);
    ui_set_screen_title_fbuf();
    if (px_step == PX_WAIT) {
        k: int = mem_index(px_i);
        px_wait_words(k >= 0 && mq_ver[k] == TEXT_ESV);
        ui_set_intro_fbuf();
        return
    }
    ui_set_segments("Full|Some|Letters|Blank", px_level, ACT_PX_LEVEL);
    ui_rich_begin();
    fput_caption(px_i);
    ui_rich(RUN_SMALL);
    if (px_first_line) {
        fput(10);
        fput_str(px_first_words);
        ui_rich(RUN_FAINT)
    }
    ui_rich_intro();
    ui_plain = true;
    ui_page = true;
    ui_section("", "");
    ui_row(UI_TEXT, 0, px_i);
    px_looks(if (px_keys_up) px_cur else -1);
    // (Typing on: the letters typed are core's.)
    if (px_keys_up) ui_keys = ACT_PX_KEY;
    script: int = if (!mt_orig) 0 else if (mt_rtl) 128 else 64;
    ui_rich_begin();
    p: int = 0;
    for r in 0..pxl_n {
        fput_bytes(mt, p, pxl_end[r]);
        ui_rich(RUN_PRACTICE + pxl_look[r] + script);
        p = pxl_end[r]
    }
    ui_rich_title();
    n: int = 0;
    for q in 0..mt_n {
        pxl_u16[q] = n;
        k: int = mt[q] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    pxl_u16[mt_n] = n;
    for w in px_a0..px_a1
        if (px_hidden(w) > 0) ui_add_link(pxl_u16[mw_k[w]], pxl_u16[mw_h2[w]], ACT_PX_WORD,
            w);
    for x in 0..mv_n {
        b: int = mv_num_b[x];
        if (b >= 0 && mv_w0[x] < px_a1) {
            e: int = if (mv_num_e[x] > b) mv_num_e[x] else b + 1;
            ui_add_link(pxl_u16[b], pxl_u16[e], ACT_PX_VERSE, x)
        }
    }
    // (In sight: the word being typed, else the words practised.)
    if (px_keys_up && px_cur >= 0) ui_set_focus_words(pxl_u16[mw_b[px_cur]], pxl_u16[mw_e[px_cur]]) else if (px_a1 > px_a0) ui_set_focus_words(pxl_u16[mw_b[px_a0]],
        pxl_u16[mw_e[px_a1 - 1]])
}

px_loading: str = "Loading\â\€\¦";

// A passage whose words have not come, into fbuf: an ESV passage's,
// Â§9.4.6's words; another's, its version being read.
px_wait_words(esv: bool) {
    fbuf_n = 0;
    if (!esv) {
        fput_str(px_loading);
        return
    }
    fput_str(if (sk_esv_listed) "Waiting for the ESV\â\€\¦" else "The ESV isn\â\€\™t available. Change this passage\â\€\™s version in its details.")
}

// What a skin's tap on core's screen does.
sk_px_act(
    at: int,
    action: int,
    arg: int,
    value: int
) {
    id: int = sk_ids[at];
    if (action == ACT_PX_DONE) {
        sk_n = at;
        px_closed();
        ui_effect("close", id, -1);
        sk_update_all();
        return
    }
    if (px_i >= 0) _t: bool = px_text(px_i);
    if (action == ACT_PX_LEVEL) px_set_level(value) else if (action == ACT_PX_MAIN) px_main() else if (action == ACT_PX_AGAIN) px_again() else if (action == ACT_PX_GRADE) px_grade(arg) else if (action == ACT_PX_WORD) px_show_word(arg) else if (action == ACT_PX_VERSE) _v: bool = px_show_verse(arg) else if (action == ACT_PX_TYPE) {
        px_typing_set(!px_keys_up);
        px_keys_set(!px_keys_up)
    } else if (action == ACT_PX_KEY) px_type(arg) else if (hs_on && (action == ACT_PX_LISTEN || action == ACT_PX_ECHO)) pxw_press(if (action == ACT_PX_LISTEN) 1 else 2) else ui_effect("practice_audio",
        action, arg);
    // (What changed: all of it, made again; the words practised in sight.)
    sk_build(at);
    ui_effect("update", id, -1);
    ui_effect("reveal", id, -1)
}

// ---- a passage's words, for its row and details ----
// Passage i's first words (most bytes), into fbuf (none if its text isn't
// here).
mm_words(i: int, most: int) {
    ok: bool = px_text(i);
    fbuf_n = 0;
    if (ok) fput_first_words(most)
}

// The verses its learned parts cover.
mm_learned(i: int): int {
    if (i < 0 || i >= mq_n || mq_state[i] != MS_LEARNING || !px_text(i)) return 0;
    memory_verses_learned(mq_learned[i])
}

// Its state line, into fbuf: an ESV passage whose verses haven't come, the
// wait's words; else where it stands.
mm_state(i: int) {
    if (mq_ver[i] == TEXT_ESV && !esv_pin_ready(mq_id[i])) {
        px_wait_words(true);
        return
    }
    learned: int = mm_learned(i);
    fbuf_n = 0;
    fput_memory_state(i, sk_today_now(), learned, mem_verses(i))
}

// Version ver's words of the range parsed (rg_*), as much as fits, into
// fbuf: the ESV's the host's (its verses held); any other's here, if it is
// loaded.
mm_range_words(ver: int) {
    if (ver == TEXT_ESV) {
        sk_words_of(SK_WORDS_RANGE_TEXT, ver);
        return
    }
    fbuf_n = 0;
    if (!text_ready(ver)) return;
    borrow texts[ver] as text {
        memory_layout_from(text, rg_c1, rg_v1, rg_c2, rg_v2, 1)
    }
    fbuf_n = 0;
    if (mt_n > 0) fput_first_words(2000)
}

// Passage i deleted (an ESV passage's pins let go: the host keeps them).
mm_delete_now(i: int) {
    if (i < 0 || i >= mq_n) return;
    id: int = mq_id[i];
    was_esv: bool = mq_ver[i] == TEXT_ESV;
    memory_delete(i, time(0));
    sk_kept(SK_KEPT_MEMORY);
    if (was_esv) {
        esv_pin_remove(id);
        sk_pins_changed()
    }
}

// Passage id read in version ver: refused if the ESV can't keep it (a
// toast); its learned verses kept as parts of the new version's; the
// ESV's pins kept, and its verses fetched (the host's).
mm_set_version(id: int, ver: int) {
    i: int = mem_index(id);
    if (i < 0 || ver == mq_ver[i]) return;
    if (ver == TEXT_ESV && mm_esv_refusal_words(mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i]) != 0) {
        ui_toast(TOAST_BRAIN);
        return
    }
    learned_v: int = mm_learned(i);
    old: int = mq_ver[i];
    mq_ver[i] = ver;
    k: int = 0;
    if (mq_state[i] == MS_LEARNING && ver != TEXT_ESV && px_text(i)) k = memory_parts_for_verses(learned_v);
    mq_ver[i] = old;
    memory_set_version(i, ver, k);
    if (old == TEXT_ESV) esv_pin_remove(mq_id[i]);
    if (ver == TEXT_ESV) _p: bool = esv_pin_add(mq_id[i], mq_c1[i], mq_v1[i], mq_c2[i],
        mq_v2[i]);
    if (old == TEXT_ESV || ver == TEXT_ESV) sk_pins_changed();
    if (ver == TEXT_ESV) sk_mm_fetch(i);
    sk_kept(SK_KEPT_MEMORY)
}

// ---- Listen and Echo (Â§13.3.7) ----
// The verses heard (the passage's, or the parts practised now: pxa_x0 to
// pxa_x1, its mv_ indices), the one now (pxa_x), the mode (1 Listen, 2
// Echo, 0 none), its source, and whether the recording plays it (each
// verse timed in it, and to be had: avail) rather than the voice.
pxa_mode: int = 0;

pxa_x0: int = 0;

pxa_x1: int = 0;

pxa_x: int = 0;

pxa_src: int = 0;

pxa_player: bool = false;

// The verses for mode, from source s; avail: whether s can be had for
// chapter c (the host's: audio_effective's answer). False: nothing to hear
// (the original's words have no recording or voice yet).
pxa_plan(mode: int, s: int, avail: fn(s: int, c: int): bool): bool {
    if (mt_orig || px_i < 0 || mw_n == 0 || px_a1 <= px_a0) return false;
    pxa_x0 = mw_vi[px_a0];
    pxa_x1 = mw_vi[px_a1 - 1];
    pxa_x = pxa_x0;
    pxa_mode = mode;
    pxa_src = s;
    pxa_player = src_timed(s);
    for x in pxa_x0..pxa_x1 + 1 {
        ch: int = mv_c[x];
        if (!pxa_player || !follows_verses(s, ch) || !avail(s, ch)) pxa_player = false
    }
    true
}

// Verse x's clip in its chapter's recording (centiseconds): from its start
// less 0.3 s; to the next verse's start, or the chapter's last verse's end
// of speech plus 0.3 s.
pxa_from(x: int): int {
    n: int = tim_starts(pxa_src, mv_c[x]);
    v: int = mv_v[x];
    if (n < 2 || v < 1 || v > n - 1) return 0;
    t: int = ts[v - 1] - 30;
    if (t < 0) 0 else t
}

pxa_to(x: int): int {
    n: int = tim_starts(pxa_src, mv_c[x]);
    v: int = mv_v[x];
    if (n < 2) return 0;
    if (v < n - 1) return ts[v];
    ts[n - 1] + 30
}

// Listen plays on to the passage's last verse in verse x's chapter.
pxa_last_in_chapter(x: int): int {
    last: int = x;
    while (last + 1 <= pxa_x1 && mv_c[last + 1] == mv_c[x]) last = last + 1;
    last
}

// Echo's pause after verse x was heard (it lasted cs centiseconds): its
// length again and a second, for saying it (centiseconds).
pxa_pause(cs: int): int {
    cs + 100
}

// Listen or Echo (mode) pressed: PXA_NONE nothing to hear (the
// original's words, no passage); PXA_STOP the one playing stopped (pressed
// again); PXA_START any playing stopped and mode begun (pxa_plan's).
PXA_NONE: int = 0;

PXA_STOP: int = 1;

PXA_START: int = 2;

pxa_press(mode: int): int {
    if (mt_orig || px_i < 0 || mw_n == 0) return PXA_NONE;
    if (pxa_mode == mode) PXA_STOP else PXA_START
}

// Listen's recording at verse x's chapter's end: the first verse of the
// next chapter's part (-1: the end).
pxa_next_chapter(x: int): int {
    n: int = pxa_last_in_chapter(x) + 1;
    if (n <= pxa_x1) n else -1
}

// Echo's next verse after the pause (-1: the end, playback stopped).
pxa_next(): int {
    if (pxa_x + 1 > pxa_x1) -1 else pxa_x + 1
}

// ---- Listen and Echo, for a skin without its own Practice audio ----
// (Core plays them through the skin's primitives, as Listen does: a
// recording's clip (audio_play), or the voice (say), and Echo's pause
// (timer TOKEN MS, the skin's answer timer TOKEN). Their tokens are
// PXW_TOK and up, and the voice's verses PXW_SAY plus the verse's place.)
PXW_TOK: int = 1000000;

PXW_SAY: int = 100000;

pxw_tok: int = PXW_TOK;

pxw_avail(s: int, c: int): bool {
    audio_effective(s, c, false, true, lw_failed_at[s], ew_now()) == s
}

// Listen (1) or Echo (2) pressed.
pxw_press(mode: int) {
    k: int = pxa_press(mode);
    if (k == PXA_NONE) return;
    if (pxa_mode != 0) pxw_stop();
    if (k == PXA_STOP) return;
    if (lw_on) lw_stop();
    s: int = clamp_index(sk_num_of(SK_NUM_AUDIO_SOURCE, mq_ver[px_i]), SOURCES);
    if (!pxa_plan(mode, s, &pxw_avail)) return;
    pxw_verse(pxa_x0)
}

// Verse x heard: Listen's to the passage's last verse in its chapter (or,
// by the voice, to its end), Echo's alone.
pxw_verse(x: int) {
    pxa_x = x;
    px_wash = x;
    px_turn = -1;
    pxw_paint();
    listen: bool = pxa_mode == 1;
    if (pxa_player) {
        c: int = mv_c[x];
        last: int = if (listen) pxa_last_in_chapter(x) else x;
        audio_address(pxa_src, c);
        if (au_n > 0) {
            pxw_tok = pxw_tok + 1;
            ui_effect("speech_stop", -1, -1);
            ui_str("audio_play ");
            ui_int(pxw_tok);
            ui_byte(32);
            ui_int(c);
            ui_byte(32);
            ui_int(pxa_from(x));
            ui_byte(32);
            ui_int(pxa_to(last));
            ui_byte(32);
            ui_int((lw_rate() * 1000.0f64) as int);
            ui_byte(9);
            ui_field_bytes(au, 0, au_n);
            ui_byte(10);
            return
        }
        pxa_player = false
    }
    // (The voice: its verses said in turn.)
    ui_effect("audio_stop", -1, -1);
    ui_effect("speech_stop", -1, -1);
    last: int = if (listen) pxa_x1 else x;
    t: int = mq_ver[px_i];
    if (t == TEXT_ESV) {
        esv_pin_build(mq_id[px_i]);
        t = TEXT_PIN
    }
    borrow texts[text_or_current(t)] as source {
        for y in x..last + 1 {
            _n: int = source_speak_text(source, mv_c[y], mv_v[y]);
            fbuf_n = 0;
            fput_bytes(vt, 0, vt_n);
            lw_say(PXW_SAY + y, mv_v[y])
        }
    }
}

// The clip's place: the verse being heard washed.
pxw_time(tok: int, t: int) {
    if (tok != pxw_tok || pxa_mode != 1) return;
    c: int = mv_c[pxa_x];
    v: int = audio_verse_at(pxa_src, c, t);
    for x in pxa_x..pxa_x1 + 1 {
        if (mv_c[x] == c && mv_v[x] == v && x != px_wash) {
            px_wash = x;
            pxw_paint()
        }
    }
}

// The clip's end: Listen on to the next chapter's part; Echo's pause.
pxw_ended(tok: int) {
    if (tok != pxw_tok || pxa_mode == 0) return;
    if (pxa_mode == 1) {
        n: int = pxa_next_chapter(pxa_x);
        if (n >= 0) pxw_verse(n) else pxw_stop();
        return
    }
    pxw_pause(pxa_to(pxa_x) - pxa_from(pxa_x))
}

// A verse said by the voice (y its place): Listen washes the next; Echo
// pauses after it (its length guessed by its words).
pxw_spoken(y: int) {
    if (pxa_mode == 0 || y < pxa_x0 || y > pxa_x1) return;
    if (pxa_mode == 1) {
        if (y >= pxa_x1) {
            pxw_stop();
            return
        }
        px_wash = y + 1;
        pxw_paint();
        return
    }
    words: int = 1;
    for w in 0..mw_n
        if (mw_vi[w] == y) words = words + 1;
    pxw_pause(words * 40)
}

// Echo's turn: the verse's length again and a second, its words
// underlined, then the next.
pxw_pause(cs: int) {
    px_wash = -1;
    px_turn = pxa_x;
    pxw_paint();
    pxw_tok = pxw_tok + 1;
    ui_effect("timer", pxw_tok, pxa_pause(cs) * 10)
}

pxw_timer(tok: int) {
    if (tok != pxw_tok || pxa_mode != 2) return;
    n: int = pxa_next();
    if (n < 0) pxw_stop() else pxw_verse(n)
}

pxw_stop() {
    if (pxa_mode == 0 && px_wash < 0 && px_turn < 0) return;
    pxa_mode = 0;
    px_wash = -1;
    px_turn = -1;
    pxw_tok = pxw_tok + 1;
    ui_effect("audio_stop", -1, -1);
    ui_effect("speech_stop", -1, -1);
    pxw_paint()
}

// Practice's screen made again (its words' looks, its buttons).
pxw_paint() {
    for i in 0..sk_n {
        if (sk_kinds[i] == SCR_PRACTICE) {
            sk_build(i);
            ui_effect("update", sk_ids[i], -1)
        }
    }
}
