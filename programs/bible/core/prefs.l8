tag bible;

use_tag std;

// The settings, apart from any platform (SKINS.md): whole numbers by name,
// the names the iPhone's defaults use (sizeStep, theme, showVerseNumbers,
// ...), a setting not yet given its default. A skin keeps them as text,
// `name value` lines (prefs_format, prefs_parse), or in its platform's own
// store under the same names.
import "store.l8";

PREFS_MOST: int = 64;

pref_names: []str = new str[PREFS_MOST]("");

pref_values: []int = new int[PREFS_MOST](0);

prefs_n: int = 0;

pref_index(name: str): int {
    for i in 0..prefs_n
        if (pref_names[i] == name) return i;
    -1
}

// Setting name's value, or dflt if it has none.
pref(name: str, dflt: int): int {
    i: int = pref_index(name);
    if (i < 0) dflt else pref_values[i]
}

pref_on(name: str, dflt: bool): bool {
    pref(name, if (dflt) 1 else 0) != 0
}

set_pref(name: str@immortal, value: int) {
    i: int = pref_index(name);
    if (i < 0) {
        if (prefs_n >= PREFS_MOST) return;
        i = prefs_n;
        pref_names[i] = name;
        prefs_n = prefs_n + 1
    }
    pref_values[i] = value
}

set_pref_on(name: str@immortal, on: bool) {
    set_pref(name, if (on) 1 else 0)
}

// Every setting, a line each, into fbuf.
prefs_format() {
    fbuf_n = 0;
    for i in 0..prefs_n {
        fput_str(pref_names[i]);
        fput(32);
        fput_int(pref_values[i]);
        fput(10)
    }
}

// Lines of fbuf (prefs_format's) read into the settings; a line that is
// not a name and a number is skipped. Names are kept only as the program
// spells them: a name read is matched against prefs_known.
prefs_parse() {
    begin_lines();
    while (next_line()) {
        sp: int = fpos;
        while (sp < line_e && fbuf[sp] as int != 32) sp = sp + 1;
        if (sp < line_e) {
            k: int = prefs_known_at(fpos, sp);
            neg: bool = sp + 1 < line_e && fbuf[sp + 1] as int == 45;
            n: int = 0;
            ok: bool = sp + 1 < line_e;
            for q in if (neg) sp + 2 else sp + 1..line_e {
                d: int = fbuf[q] as int;
                if (d < 48 || d > 57) ok = false else n = n * 10 + d - 48
            }
            if (k >= 0 && ok) set_pref(prefs_known[k].name, if (neg) -n else n)
        }
    }
}

// The settings there are, each its name (as the iPhone's defaults spell
// it), its default and its most (0 to it; -1, any): what a skin starts with
// and what it keeps a value to, the same everywhere. (The chapter's
// default, John 1, is the reader's own.) A name read from a file must be
// one of these, so that a str kept is the program's own.
type KnownPref = {
    name: str;
    dflt: int;
    most: int
}

prefs_known: []KnownPref = [KnownPref { name: "sizeStep", dflt: 2, most: 7 }, KnownPref { name: "theme", dflt: 0, most: 5 },
    KnownPref { name: "font", dflt: 0, most: 4 }, KnownPref { name: "spacing", dflt: 1, most: 2 },
    KnownPref { name: "margins", dflt: 1, most: 2 }, KnownPref { name: "showVerseNumbers", dflt: 1, most: 1 },
    KnownPref { name: "showHeadings", dflt: 1, most: 1 }, KnownPref { name: "showNotes", dflt: 1, most: 1 },
    KnownPref { name: "verseLines", dflt: 0, most: 1 }, KnownPref { name: "redLetter", dflt: 0, most: 1 },
    KnownPref { name: "keepScreenOn", dflt: 0, most: 1 }, KnownPref { name: "version", dflt: 0, most: -1 },
    KnownPref { name: "chapter", dflt: 0, most: -1 }, KnownPref { name: "verse", dflt: 0, most: -1 },
    KnownPref { name: "verseOffset", dflt: 0, most: -1 }, KnownPref { name: "listenRate", dflt: 1, most: 2 },
    KnownPref { name: "origAccents", dflt: 0, most: 1 }, KnownPref { name: "origGlosses", dflt: 0, most: 3 },
    KnownPref { name: "librarySegment", dflt: 0, most: 3 }, KnownPref { name: "librarySort", dflt: 0, most: 1 },
    KnownPref { name: "studySegment", dflt: 0, most: 2 }, KnownPref { name: "interlinearOrder", dflt: 0, most: 1 },
    KnownPref { name: "memorySeen", dflt: 0, most: 1 }, KnownPref { name: "memoryType", dflt: 0, most: 1 },
    KnownPref { name: "lastHighlight", dflt: 0, most: 4 }, KnownPref { name: "planNext", dflt: 1, most: -1 },
    KnownPref { name: "memoryReminder", dflt: 0, most: 1 }, KnownPref { name: "shareShape", dflt: 0, most: 1 },
    KnownPref { name: "listenSourceBSB", dflt: 0, most: -1 }, KnownPref { name: "listenSourceWEB", dflt: 0, most: -1 },
    KnownPref { name: "listenSourceESV", dflt: 0, most: -1 }, KnownPref { name: "reminderTime", dflt: 0, most: 1439 },
    KnownPref { name: "shareTheme", dflt: 0, most: 5 }, KnownPref { name: "studyBeside", dflt: 0, most: 1 },
    KnownPref { name: "studyBesideChapter", dflt: 0, most: -1 }, KnownPref { name: "studyBesideVerse", dflt: 0, most: -1 },
    KnownPref { name: "downloadAheadCellular", dflt: 0, most: 1 }, KnownPref { name: "besideOpen", dflt: 0, most: 1 },
    KnownPref { name: "besideSlot", dflt: 0, most: -1 }, KnownPref { name: "besideFull", dflt: 0, most: 1 },
    KnownPref { name: "pageSlot", dflt: 0, most: -1 }, KnownPref { name: "besideVersion", dflt: 0, most: -1 },
    KnownPref { name: "shelfCatalogDay", dflt: 0, most: -1 }, KnownPref { name: "besideLinked", dflt: 1, most: 1 }];

prefs_known_at(b: int, e: int): int {
    for k in 0..len(prefs_known) {
        name: str = prefs_known[k].name;
        if (len(name) == e - b) {
            same: bool = true;
            for i in 0..len(name)
                if (fbuf[b + i] != name[i]) same = false;
            if (same) return k
        }
    }
    -1
}

prefs_known_index(name: str): int {
    for k in 0..len(prefs_known)
        if (prefs_known[k].name == name) return k;
    -1
}

// Setting name's value as it is used: its default if it has none, and
// kept within its range.
pref_get(name: str): int {
    k: int = prefs_known_index(name);
    if (k < 0) return pref(name, 0);
    pref_fit(name, pref(name, prefs_known[k].dflt))
}

pref_is(name: str): bool {
    pref_get(name) != 0
}

// A value of setting name, kept within its range.
pref_fit(name: str, v: int): int {
    k: int = prefs_known_index(name);
    most: int = if (k < 0) -1 else prefs_known[k].most;
    if (most < 0) return v;
    if (v < 0) 0 else if (v > most) most else v
}
