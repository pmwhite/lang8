tag bible;

use_tag std;

// Learning Greek and Hebrew's lists (DESIGN.md Â§14.3, Â§14.5.3), as core's
// screens (SKINS.md): the language page and what it pushes (Sounds Written
// As, the Alphabet, Your Words, Add Words and its preview, Verses You Can
// Read), and a lemma's Forms. What they do that only a platform can (its
// Practice, its toasts, the reader in the Hebrew and Greek) is an effect.
import "skin.l8";

import "learn.l8";

import "lang.l8";

SCR_LANGUAGE: int = 30;

SCR_PRON: int = 31;

SCR_ALPHABET: int = 32;

SCR_YOUR_WORDS: int = 33;

SCR_ADD_WORDS: int = 34;

SCR_PREVIEW: int = 35;

SCR_READABLE: int = 36;

SCR_FORMS: int = 37;

// Practice of the language's cards (cards LANG); a screen of kind arg of
// the language pushed; the reader in the Hebrew and Greek (read_in);
// Hide What I Know; a pronunciation chosen; Practise Reading.
ACT_LN_PRACTICE: int = 86;

ACT_LN_OPEN: int = 87;

ACT_LN_READ_IN: int = 88;

ACT_LN_HIDE: int = 89;

ACT_LN_PRON: int = 90;

ACT_LN_READING: int = 91;

// Learn 8 Letters (practice_new N, of sk_pq's cards); I Know These (arg
// the kind); a word's study (arg a card's code); Mark as Known (a card's
// code, or a word's: word_code); Delete; a preview of Add Words' row (arg
// where from: ADW_); its Add; a verse readable; a form's concordance.
ACT_LN_LETTERS: int = 92;

ACT_LN_KNOW_ALL: int = 93;

ACT_LN_WORD: int = 94;

ACT_LN_KNOWN: int = 95;

ACT_LN_DELETE: int = 96;

ACT_LN_PREVIEW: int = 97;

ACT_LN_ADD: int = 98;

ACT_LN_VERSE: int = 99;

ACT_LN_FORM: int = 100;

// The cards changed (added, marked known, deleted): the host keeps them
// (cards.tsv), and what follows from them (its reminders).
SK_KEPT_CARDS: int = 8;

// The language shown last (the demos' pages open in it).
sk_lg: int = 0;

// The language's data, made ready (the host's).
sk_ln_ready() {
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    _c: int = sk_num_of(SK_NUM_LEARN, 0)
}

// The settings (Â§14.1.9): hide what is known; the sounds written in.
sk_ln_hide(): bool {
    pref_on("learnHideKnown", false)
}

sk_ln_pron(lang: int): int {
    clamp_index(pref(if (lang == 0) "learnPronGreek" else "learnPronHebrew", 0), pron_count[lang])
}

// A card by its code (language, kind and key, as a row's argument), or -1.
card_code(k: int): int {
    cd_lang[k] * 1000000 + cd_kind[k] * 100000 + cd_key[k]
}

card_by_code(code: int): int {
    for k in 0..cd_n
        if (card_code(k) == code) return k;
    -1
}

// A word's code with no card yet (a preview's row): its number, negative,
// less the language's million.
word_code(lang: int, num: int): int {
    -(lang * 1000000 + num) - 1
}

// ---- built and acted on (skin.l8's sk_build, sk_act and sk_open) ----
sk_build_learn(id: int, kind: int, arg: int) {
    sk_ln_ready();
    if (kind == SCR_LANGUAGE) sk_build_language(id, arg) else if (kind == SCR_PRON) sk_build_pron(id,
        arg) else if (kind == SCR_ALPHABET) sk_build_alphabet(id, arg) else if (kind == SCR_YOUR_WORDS) sk_build_your_words(id,
        arg) else if (kind == SCR_ADD_WORDS) sk_build_add_words(id, arg) else if (kind == SCR_PREVIEW) sk_build_preview(id,
        arg) else if (kind == SCR_READABLE) sk_build_readable(id, arg) else sk_build_forms(id,
        arg)
}

// What a screen needs as it opens (its words to learn, its verses).
sk_learn_opening(kind: int, arg: int) {
    if (kind < SCR_LANGUAGE || kind > SCR_FORMS) return;
    sk_ln_ready();
    if (kind == SCR_LANGUAGE) sk_lg = arg;
    if (kind == SCR_YOUR_WORDS) {
        sk_yq_n = 0;
        sk_yraw_n = 0
    }
    if (kind == SCR_ADD_WORDS) adw_make(arg);
    if (kind == SCR_PREVIEW) wpv_make(arg / 16, arg % 16 - 2);
    if (kind == SCR_READABLE) {
        learn_readable(arg, time(0));
        sk_crv_lang = arg
    }
    if (kind == SCR_FORMS) sk_forms_ready(arg)
}

sk_ln_act(
    at: int,
    action: int,
    arg: int,
    value: int
) {
    lang: int = sk_args[at];
    kind: int = sk_kinds[at];
    if (action == ACT_LN_PRACTICE) {
        px_start(PXS_CARDS, lang);
        return
    }
    if (action == ACT_LN_READING) {
        px_start(PXS_READING, lang);
        return
    }
    if (action == ACT_LN_OPEN) {
        sk_open(arg, lang, true);
        return
    }
    if (action == ACT_LN_READ_IN) {
        read_in_target(lang);
        sk_read_in(ri_c, 0, ri_ribbon);
        return
    }
    if (action == ACT_LN_VERSE) {
        if (arg >= 0 && arg < lv_n) sk_read_in(v_chapter(arg), v_num(arg), -1);
        return
    }
    if (action == ACT_LN_HIDE) {
        set_pref_on("learnHideKnown", value != 0);
        ui_effect("settings", -1, -1);
        return
    }
    if (action == ACT_LN_PRON) {
        if (arg < 0 || arg >= pron_count[lang]) return;
        set_pref(if (lang == 0) "learnPronGreek" else "learnPronHebrew", arg);
        ui_effect("settings", -1, -1);
        // (Chosen, and back to the Alphabet.)
        sk_n = at;
        ui_effect("pop", -1, -1);
        sk_update_all();
        return
    }
    if (action == ACT_LN_LETTERS) {
        alp_next_make(lang);
        sk_pq_n = 0;
        for x in 0..alp_next_n {
            k: int = learn_add_letter(alp_next[x], FROM_ALPHABET, sk_today_now(),
                time(0));
            if (k >= 0) {
                sk_pq[sk_pq_n] = k;
                sk_pq_n = sk_pq_n + 1
            }
        }
        sk_kept(SK_KEPT_CARDS);
        sk_update_all();
        px_start(PXS_NEW, 0);
        return
    }
    if (action == ACT_LN_KNOW_ALL) {
        if (arg != CK_LETTER && arg != CK_JOINED) return;
        for i in 0..lt_n {
            if (lt_lang[i] == lang && lt_kind[i] == arg && !cd_known(cl_of[i])) {
                k: int = if (cl_of[i] >= 0) cl_of[i] else learn_add_letter(i, FROM_KNOWN,
                    sk_today_now(), time(0));
                if (k >= 0) learn_mark_known(k, sk_today_now(), time(0))
            }
        }
        sk_kept(SK_KEPT_CARDS);
        sk_update_all();
        return
    }
    if (action == ACT_LN_WORD) {
        k: int = card_by_code(arg);
        if (k >= 0) sk_study_open(-1, -1, cd_lang[k] == 0, cd_key[k], false, true);
        return
    }
    if (action == ACT_LN_KNOWN) {
        k: int = -1;
        if (arg < -1) {
            c: int = -arg - 1;
            l: int = c / 1000000;
            num: int = c % 1000000;
            k = card_of_word(l, num);
            if (k < 0) k = learn_add_word(l, num, FROM_KNOWN, sk_today_now(), time(0));
            // (It goes from the preview.)
            if (kind == SCR_PREVIEW) wpv_drop(num)
        } else k = card_by_code(arg);
        if (k < 0) return;
        learn_mark_known(k, sk_today_now(), time(0));
        sk_kept(SK_KEPT_CARDS);
        sk_update_all();
        return
    }
    if (action == ACT_LN_DELETE) {
        k: int = card_by_code(arg);
        if (k < 0) return;
        learn_delete(k, time(0));
        sk_kept(SK_KEPT_CARDS);
        sk_update_all();
        return
    }
    if (action == ACT_LN_PREVIEW) {
        sk_open(SCR_PREVIEW, lang * 16 + arg + 2, true);
        return
    }
    if (action == ACT_LN_ADD) {
        // (The set's cards made, due today; back to the language page,
        // and a toast.)
        l: int = lang / 16;
        n: int = 0;
        from: int = if (wpv_from == WPV_MOST) FROM_FREQ else if (wpv_from == WPV_RELATED) FROM_RELATED else FROM_PASSAGE;
        for x in 0..wpv_n {
            if (n < 20 && learn_add_word(l, wpv_num[x], from, sk_today_now(), time(0)) >= 0) n = n + 1
        }
        sk_kept(SK_KEPT_CARDS);
        page: int = -1;
        for j in 0..at
            if (sk_kinds[j] == SCR_LANGUAGE) page = j;
        if (page >= 0) {
            sk_n = page + 1;
            ui_effect("pop_to", sk_ids[page], -1)
        }
        sk_update_all();
        fbuf_n = 0;
        fput_int(n);
        fput_str(if (n == 1) " word added" else " words added");
        ui_toast(TOAST_PLUS);
        return
    }
    if (action == ACT_LN_FORM) {
        sk_form_concordance(arg);
        return
    }
}

// The cards just added (Learn 8 Letters'), for the host's Practice.
sk_pq: []int = new int[8](0);

sk_pq_n: int = 0;

// ---- the language page (Â§14.3.2) ----
// Its sections' kinds, in order.
LG_PRACTICE: int = 0;

LG_ALPHABET: int = 1;

LG_WORDS: int = 2;

LG_READING: int = 3;

LG_HIDE: int = 4;

// The verses readable, counted as the cards were (cd_gen) last time.
sk_lg_readable: []int = new int[2](0);

sk_lg_gen: []int = new int[2](-1);

sk_build_language(id: int, lang: int) {
    ui_begin(id, SCR_LANGUAGE, lang, language_names[lang]);
    // The header: the language's sentence, and (faint) the chapters read
    // this month's; no bar, ring or chart.
    ui_rich_begin();
    fput_language_header(lang);
    ui_rich(RUN_PLAIN);
    at: int = fbuf_n;
    fput_str("""


""");
    if (fput_language_recent(lang, time(0))) ui_rich(RUN_FAINT) else fbuf_n = at;
    ui_rich_intro();
    cd_count_today(lang, sk_today_now());
    if (cd_new_n + cd_review_n > 0) {
        ui_section("", "");
        ui_row(UI_ITEM, ACT_LN_PRACTICE, lang);
        ui_set_title("Practice");
        ui_set_tinted();
        fbuf_n = 0;
        fput_cards_due(lang, sk_today_now());
        ui_set_detail_fbuf();
        ui_set_value_detail()
    }
    // (Verses You Can Read first once the alphabet is known, Â§14.10b.2.)
    if (kn_alpha[lang]) sk_lg_section(lang, LG_READING);
    sk_lg_section(lang, LG_ALPHABET);
    sk_lg_section(lang, LG_WORDS);
    if (!kn_alpha[lang]) sk_lg_section(lang, LG_READING);
    sk_lg_section(lang, LG_HIDE)
}

sk_lg_section(lang: int, k: int) {
    if (k == LG_ALPHABET) {
        ui_section("Alphabet", "");
        ui_row(UI_ITEM, ACT_LN_OPEN, SCR_ALPHABET);
        ui_set_title("The Alphabet");
        fbuf_n = 0;
        fput_alphabet_row(lang);
        ui_set_detail_fbuf();
        ui_set_acc(ACC_MORE)
    } else if (k == LG_WORDS) {
        ui_section("Words", "");
        ui_row(UI_ITEM, ACT_LN_OPEN, SCR_YOUR_WORDS);
        ui_set_title("Your Words");
        fbuf_n = 0;
        fput_count(words_carded(lang));
        ui_set_detail_fbuf();
        ui_set_value_detail();
        ui_set_acc(ACC_MORE);
        ui_row(UI_ITEM, ACT_LN_OPEN, SCR_ADD_WORDS);
        ui_set_title("Add Words\â\€\¦");
        ui_set_acc(ACC_MORE)
    } else if (k == LG_READING) {
        ui_section("Reading", "");
        ui_row(UI_ITEM, ACT_LN_OPEN, SCR_READABLE);
        ui_set_title("Verses You Can Read");
        fbuf_n = 0;
        if (kn_alpha[lang]) {
            if (sk_lg_gen[lang] != cd_gen) {
                learn_readable(lang, time(0));
                sk_crv_lang = lang;
                sk_lg_readable[lang] = crv_readable;
                sk_lg_gen[lang] = cd_gen
            }
            fput_count(sk_lg_readable[lang]);
            ui_set_detail_fbuf();
            ui_set_value_detail()
        } else ui_set_detail("After the alphabet");
        ui_set_acc(ACC_MORE);
        // (Read in Greek: where it will open, Â§14.11.6.)
        ui_row(UI_ITEM, ACT_LN_READ_IN, lang);
        ui_set_title(if (lang == 0) "Read in Greek" else "Read in Hebrew");
        fbuf_n = 0;
        fput_read_in(lang);
        ui_set_detail_fbuf()
    } else {
        ui_section("Settings", if (lang == 0) "In Greek order, the interlinear hides the English under words you know, and the transliteration once you know the alphabet. Tap a word to show it." else "In Hebrew order, the interlinear hides the English under words you know, and the transliteration once you know the alphabet. Tap a word to show it.");
        ui_row(UI_TOGGLE, ACT_LN_HIDE, 0);
        ui_set_title("Hide What I Know");
        ui_set_on(sk_ln_hide())
    }
}

// ---- Read in Greek (Hebrew), Â§14.11.6 ----
// Where it opens: the reader's place, if it is in the language's
// testament; else a ribbon there (its first); else Matthew 1 (Genesis 1).
// ri_c the chapter, ri_ribbon the ribbon's index (-1 none).
ri_c: int = 0;

ri_ribbon: int = -1;

read_in_target(lang: int) {
    ri_ribbon = -1;
    in_nt: bool = lang == 0;
    if (sk_c >= 0 && sk_c < chapters && ch_book[sk_c] >= 39 == in_nt) {
        ri_c = sk_c;
        return
    }
    for i in 0..rb_n {
        if (ri_ribbon < 0 && rb_c[i] >= 0 && rb_c[i] < chapters && ch_book[rb_c[i]] >= 39 == in_nt) ri_ribbon = i
    }
    if (ri_ribbon >= 0) ri_c = rb_c[ri_ribbon] else ri_c = (if (in_nt) book_first[39] else 0)
}

// "John 3, where you are" (or "Romans 8, at your ribbon", "Matthew 1").
fput_read_in(lang: int) {
    read_in_target(lang);
    fput_title(ri_c);
    if (ri_c == sk_c && ri_ribbon < 0) fput_str(", where you are") else if (ri_ribbon >= 0) fput_str(", at your ribbon")
}

// ---- Sounds Written As (Â§14.3.2, Â§14.10b.1): the pronunciation the
// Alphabet's sounds and letter cards are written in; a choice goes back
// to it ----
sk_build_pron(id: int, lang: int) {
    ui_begin(id, SCR_PRON, lang, "Sounds Written As");
    ui_section("", "Changes the sounds in the letter table and on letter cards. Words keep one transliteration.");
    chosen: int = sk_ln_pron(lang);
    for r in 0..pron_count[lang] {
        ui_row(UI_ITEM, ACT_LN_PRON, r);
        ui_set_title(pron_names[pron_first[lang] + r]);
        ui_set_detail(pron_lines[pron_first[lang] + r]);
        if (r == chosen) {
            ui_set_acc(ACC_CHECK);
            ui_set_focus()
        }
    }
}

// ---- the Alphabet (Â§14.3.3) ----
// The language's sections of letters.txt (ltsec_*); then, once 8 letters
// are known, Practise Reading's; then Sounds Written As's.
sk_build_alphabet(id: int, lang: int) {
    ui_begin(id, SCR_ALPHABET, lang, "Alphabet");
    pron: int = sk_ln_pron(lang);
    last: int = -1;
    for x in 0..ltsec_n
        if (ltsec_lang[x] == lang) last = x;
    for x in 0..ltsec_n {
        if (ltsec_lang[x] == lang) {
            ui_section("", if (x != last) "" else if (lang == 0) "Greek has 24 letters. Words also carry breathing marks and accents; only the rough breathing (\Ê\½, an h sound) changes how a word sounds." else "Hebrew is read right to left. Its 22 letters are consonants; the vowels are the dots and dashes added under, over or beside them.");
            fbuf_n = 0;
            fput_bytes(llet, ltsec_b[x], ltsec_e[x]);
            ui_set_header_fbuf();
            for i in 0..lt_n
                if (lt_sec[i] == x) sk_letter_row(i, pron)
        }
    }
    if (letters_known(lang) >= 8) {
        ui_section("", "");
        ui_row(UI_ITEM, ACT_LN_READING, lang);
        ui_set_title("Practise Reading");
        ui_set_tinted()
    }
    ui_section("", "How the table writes each sound. There are no recordings yet.");
    ui_row(UI_ITEM, ACT_LN_OPEN, SCR_PRON);
    ui_set_title("Sounds Written As");
    ui_set_detail(pron_names[pron_first[lang] + pron]);
    ui_set_value_detail();
    ui_set_acc(ACC_MORE);
    sk_alphabet_tools(lang)
}

// A letter's row: the glyph at its start, its name over its sound in the
// chosen pronunciation, and its example (the letter stressed) over its
// gloss at its end; known, a faint check.
sk_letter_row(i: int, pron: int) {
    lang: int = lt_lang[i];
    ui_row(UI_ITEM, 0, i);
    fbuf_n = 0;
    fput_bytes(llet, lt_fb[i * 9 + LF_GLYPH], lt_fe[i * 9 + LF_GLYPH]);
    ui_set_lead_fbuf(sk_script(lang == 0, false));
    fbuf_n = 0;
    fput_bytes(llet, lt_fb[i * 9 + LF_NAME], lt_fe[i * 9 + LF_NAME]);
    ui_set_title_fbuf();
    fbuf_n = 0;
    fput_lt_sound(i, pron);
    ui_set_detail_fbuf();
    lt_example(i);
    ui_rich_begin();
    fput_bytes(exm, 0, exm_b);
    ui_rich(RUN_PLAIN);
    fput_bytes(exm, exm_b, exm_e);
    ui_rich(RUN_ACCENT);
    fput_bytes(exm, exm_e, exm_n);
    ui_rich(RUN_PLAIN);
    ui_rich_side();
    fbuf_n = 0;
    fput_lemma(lang, lt_key[i], 3);
    ui_set_side_note_fbuf();
    known: bool = cd_known(cl_of[i]);
    if (known) ui_set_acc(ACC_DONE);
    // "Beta: b as in bat. Example: basileia, kingdom."
    fbuf_n = 0;
    fput_lt(i, LF_NAME);
    fput_str(": ");
    fput_lt_sound(i, pron);
    fput_str(". Example: ");
    w: int = example_word(i);
    if (w >= 0) {
        form_of(w);
        for x in wt_b..wt_e fput(lforms[x] as int)
    }
    fput_str(", ");
    fput_lemma(lang, lt_key[i], 3);
    fput(46);
    if (known) fput_str(" Known.");
    ui_set_label_fbuf()
}

// The next set to learn: up to 8 lines of one kind with no card, in table
// order (letters, then joined words): their lines (alp_next), and how
// many of that kind are left.
alp_next: []int = new int[8](0);

alp_next_n: int = 0;

alp_left: int = 0;

alp_kind: int = 0;

alp_next_make(lang: int) {
    alp_next_n = 0;
    alp_left = 0;
    alp_kind = CK_LETTER;
    for pass in 0..2 {
        kind: int = if (pass == 0) CK_LETTER else CK_JOINED;
        if (alp_next_n == 0) {
            for i in 0..lt_n {
                if (lt_lang[i] == lang && lt_kind[i] == kind && cl_of[i] < 0) {
                    alp_kind = kind;
                    alp_left = alp_left + 1;
                    if (alp_next_n < 8) {
                        alp_next[alp_next_n] = i;
                        alp_next_n = alp_next_n + 1
                    }
                }
            }
        }
    }
}

letters_count_kind(lang: int, kind: int): int {
    n: int = 0;
    for i in 0..lt_n
        if (lt_lang[i] == lang && lt_kind[i] == kind) n = n + 1;
    n
}

// Its tools (while some have no card): I Know These (its menu the
// confirmation) at the left; Learn 8 Letters in the middle.
sk_alphabet_tools(lang: int) {
    alp_next_make(lang);
    if (alp_next_n == 0) return;
    ui_tool("I Know These", "", ACT_LN_KNOW_ALL, 0, UI_TOOL_PLAIN, 0);
    fbuf_n = 0;
    for kind in [CK_LETTER, CK_JOINED] {
        total: int = 0;
        unknown: int = 0;
        for i in 0..lt_n {
            if (lt_lang[i] == lang && lt_kind[i] == kind) {
                total = total + 1;
                if (!cd_known(cl_of[i])) unknown = unknown + 1
            }
        }
        if (unknown > 0) {
            if (fbuf_n > 0) fput(124);
            fput_int(kind);
            fput_str(":Mark All ");
            fput_int(total);
            fput_str(if (kind == CK_LETTER) " as Known" else " Joined Words as Known")
        }
    }
    ui_set_tool_menu_fbuf();
    fbuf_n = 0;
    if (alp_left == letters_count_kind(lang, alp_kind)) {
        fput_str("Learn ");
        fput_int(alp_next_n);
        fput_str(if (alp_kind == CK_LETTER) " Letters" else " Joined Words")
    } else if (alp_left <= 8) {
        fput_str("Learn the Last ");
        fput_int(alp_left)
    } else fput_str("Learn the Next 8");
    ui_tool("", "", ACT_LN_LETTERS, 0, UI_TOOL_PROMINENT, 1);
    ui_tools[ui_tools_n - 1].title = ui_put_fbuf()
}

// ---- Your Words (Â§14.3.4) ----
// What is typed (as it is, and folded).
sk_yraw: []i8 = new i8[256](0i8);

sk_yraw_n: int = 0;

sk_yq: []i8 = new i8[256](0i8);

sk_yq_n: int = 0;

// Typed (skin.l8's sk_query).
sk_your_words_typed(buf: []i8, b: int, e: int) {
    sk_yraw_n = 0;
    for x in b..e {
        if (sk_yraw_n < len(sk_yraw)) {
            sk_yraw[sk_yraw_n] = buf[x];
            sk_yraw_n = sk_yraw_n + 1
        }
    }
    ln_fold_into(buf, b, e);
    sk_yq_n = (if (lf_n > len(sk_yq)) len(sk_yq) else lf_n);
    for i in 0..sk_yq_n sk_yq[i] = lf_buf[i]
}

ywd_names: []str = ["Today", "New", "Later"];

ywd_row: []int = new int[16384](0);

// Word cards by section (Today, New, Later), then Letters and Joined
// Words, a row.
sk_build_your_words(id: int, lang: int) {
    ui_begin(id, SCR_YOUR_WORDS, lang, "Your Words");
    ui_set_search("Search Words");
    ui_set_search_text(sk_yraw, sk_yraw_n);
    if (sk_yq_n > 0) ui_set_empty("magnifyingglass", "No Results", "") else ui_set_empty("character.book.closed",
        "No Words Yet", "Add words to learn them, most common first or from your reading.");
    td: int = sk_today_now();
    for sec in 0..3 {
        n: int = 0;
        for k in 0..cd_n {
            if (cd_lang[k] == lang && cd_kind[k] == CK_WORD && ywd_in(k, sec, td) && ywd_matches(k) && n < len(ywd_row)) {
                ywd_row[n] = k;
                n = n + 1
            }
        }
        // (Today's: Â§14.1.8's order; New's as added; Later's soonest
        // first.)
        for x in 1..n {
            j: int = x;
            while (j > 0 && cd_before(ywd_row[j], ywd_row[j - 1])) {
                t: int = ywd_row[j];
                ywd_row[j] = ywd_row[j - 1];
                ywd_row[j - 1] = t;
                j = j - 1
            }
        }
        if (n > 0) {
            ui_section(ywd_names[sec], "");
            for x in 0..n sk_card_row(ywd_row[x], td)
        }
    }
    if (sk_yq_n == 0 && letters_carded(lang, CK_LETTER) + letters_carded(lang, CK_JOINED) > 0) {
        ui_section("Letters and Joined Words", "");
        ui_row(UI_ITEM, ACT_LN_OPEN, SCR_ALPHABET);
        fbuf_n = 0;
        fput_int(letters_of(lang));
        fput_str(" letters \Â\· ");
        if (kn_alpha[lang]) fput_str("known") else {
            fput_int(letters_known(lang));
            fput_str(" known")
        }
        ui_set_title_fbuf();
        ui_set_acc(ACC_MORE)
    }
    // Its tools: Practice (while some are due) in the middle, plus at the
    // right (Add Words).
    cd_count_today(lang, td);
    if (cd_new_n + cd_review_n > 0) ui_tool("Practice", "", ACT_LN_PRACTICE, lang,
        UI_TOOL_PROMINENT, 1);
    ui_tool("", "plus", ACT_LN_OPEN, SCR_ADD_WORDS, UI_TOOL_PLAIN, 2);
    fbuf_n = 0;
    fput_str("Add Words");
    ui_set_tool_label_fbuf()
}

ywd_in(k: int, sec: int, d: int): bool {
    if (sec == 1) return cd_state[k] == MS_NEW;
    if (cd_state[k] == MS_NEW) return false;
    if (sec == 0) cd_due[k] <= d else cd_due[k] > d
}

// Whether card k's lemma, transliteration or gloss has what is typed.
ywd_matches(k: int): bool {
    if (sk_yq_n == 0) return true;
    p: int = lex_first(cd_lang[k] == 0, cd_key[k]);
    if (p < 0) return false;
    for f in [0, 1, 3] {
        lex_field(p, f);
        ln_fold_into(llex, lf_b, lf_e);
        if (lf_has(sk_yq, sk_yq_n)) return true
    }
    false
}

// A word's row (Your Words, the preview): "á¼€Î³Î±Ï€Î¬Ï‰  agapaÅ" over its gloss.
sk_word_row(
    action: int,
    arg: int,
    lang: int,
    num: int
) {
    ui_row(UI_ITEM, action, arg);
    ui_rich_begin();
    if (lang == 1) fput_rli();
    fput_lemma(lang, num, 0);
    if (lang == 1) fput_pdi();
    ui_rich(sk_script(lang == 0, false));
    fput_str("  ");
    fput_lemma(lang, num, 1);
    ui_rich(RUN_TRANSLIT);
    ui_rich_title();
    ui_rich_begin();
    fput_lemma(lang, num, 3);
    ui_rich(RUN_PLAIN);
    ui_rich_detail()
}

// Its words for a screen reader: "á¼€Î³Î±Ï€Î¬Ï‰, agapaÅ: to love. Known, next
// review 2 November." (the line, fbuf's bytes from b).
sk_word_label(lang: int, num: int, b: int) {
    n: int = fbuf_n - b;
    for i in 0..n sk_note[i] = fbuf[b + i];
    fbuf_n = 0;
    fput_lemma(lang, num, 1);
    fput_str(": ");
    fput_lemma(lang, num, 3);
    fput_str(". ");
    if (n > 0) {
        fput_bytes(sk_note, 0, n);
        fput(46)
    }
    ui_set_label_fbuf()
}

// A word's card: its state and count under it, its menu (Mark as Known,
// unless it is; Delete), swiped away deleted.
sk_card_row(k: int, td: int) {
    code: int = card_code(k);
    lang: int = cd_lang[k];
    sk_word_row(ACT_LN_WORD, code, lang, cd_key[k]);
    fbuf_n = 0;
    fput_card_state(k, td);
    fput_str(" \Â\· ");
    fput_count(vk_count_of(lang, cd_key[k]));
    fput_str(" times");
    ui_set_note_fbuf();
    sk_word_label(lang, cd_key[k], 0);
    if (!cd_known(k)) ui_row_action_icon("Mark as Known", "checkmark.circle", ACT_LN_KNOWN);
    ui_row_action_icon("Delete", "trash", ACT_LN_DELETE);
    ui_set_delete(ACT_LN_DELETE);
    ui_set_menu()
}

// ---- searching what is typed, folded ----
// A code point folded: a Greek letter its base (lower case), Latin's
// without its marks, Hebrew's points dropped (-1), a final form as the
// letter.
ln_fold(cp: int): int {
    info: int = greek_info(cp);
    if (info != 0) return 944 + (info & 31);
    if (cp >= 1425 && cp <= 1479 && cp != 1470) return -1;
    if (cp >= 768 && cp <= 879) return -1;
    if (cp == 1498) return 1499;
    if (cp == 1501) return 1502;
    if (cp == 1503) return 1504;
    if (cp == 1507) return 1508;
    if (cp == 1509) return 1510;
    mem_fold(cp)
}

// Bytes a to b of x folded into lf_buf.
lf_buf: []i8 = new i8[1024](0i8);

lf_n: int = 0;

ln_fold_into(x: []i8, a: int, b: int) {
    lf_n = 0;
    p: int = a;
    while (p < b) {
        cp: int = cp_at(x, p, b);
        p = p + cp_len;
        f: int = ln_fold(cp);
        if (f >= 0 && lf_n + 4 <= len(lf_buf)) lf_n = cp_put(lf_buf, lf_n, f)
    }
}

// Whether lf_buf has q's n bytes.
lf_has(q: []i8, n: int): bool {
    for i in 0..lf_n - n + 1 {
        same: bool = true;
        j: int = 0;
        while (same && j < n) {
            if (lf_buf[i + j] != q[j]) same = false;
            j = j + 1
        }
        if (same) return true
    }
    false
}

// ---- Add Words (Â§14.3.5) ----
// From Your Reading's rows: each one's range, its title (adw_pool) and
// its words to learn. (A ninth slot, ADW_OTHER: a range previewed from
// elsewhere, a Memory passage's details.)
ADW_MOST: int = 8;

ADW_OTHER: int = 8;

adw_n: int = 0;

adw_c1: []int = new int[9](0);

adw_v1: []int = new int[9](0);

adw_c2: []int = new int[9](0);

adw_v2: []int = new int[9](0);

adw_left: []int = new int[9](0);

adw_title_b: []int = new int[9](0);

adw_title_e: []int = new int[9](0);

adw_pool: []i8 = new i8[2048](0i8);

adw_pool_n: int = 0;

// Related to Words You Know's words to learn (Â§14.10b.2).
adw_related: int = 0;

adw_lang: int = 0;

// A row of From Your Reading (if it has a word to learn, and is not one
// already): its title fbuf's bytes from b.
adw_add(
    c1: int,
    v1: int,
    c2: int,
    v2: int,
    b: int
) {
    if (adw_n >= ADW_MOST || c1 < 0 || ch_lang(c1) != adw_lang) {
        fbuf_n = b;
        return
    }
    for x in 0..adw_n {
        if (adw_c1[x] == c1 && adw_v1[x] == v1 && adw_c2[x] == c2 && adw_v2[x] == v2) {
            fbuf_n = b;
            return
        }
    }
    learn_words_of(c1, v1, c2, v2);
    if (wu_n == 0) {
        fbuf_n = b;
        return
    }
    i: int = adw_n;
    adw_c1[i] = c1;
    adw_v1[i] = v1;
    adw_c2[i] = c2;
    adw_v2[i] = v2;
    adw_left[i] = wu_n;
    adw_title_b[i] = adw_pool_n;
    for x in b..fbuf_n {
        if (adw_pool_n < len(adw_pool)) {
            adw_pool[adw_pool_n] = fbuf[x];
            adw_pool_n = adw_pool_n + 1
        }
    }
    adw_title_e[i] = adw_pool_n;
    adw_n = adw_n + 1;
    fbuf_n = b
}

// Its rows: the chapter read, each ribbon's, each Memory passage, then the
// newest highlighted or noted chapters.
adw_make(lang: int) {
    adw_lang = lang;
    learn_related_words(lang);
    adw_related = rel_new_n;
    adw_n = 0;
    adw_pool_n = 0;
    adw_skipped_n = 0;
    fbuf_n = 0;
    if (sk_c >= 0 && sk_c < chapters) {
        fput_title(sk_c);
        adw_add(sk_c, 1, sk_c, bsb_verses(sk_c), 0)
    }
    for i in 0..rb_n {
        c: int = rb_c[i];
        if (c >= 0 && c < chapters) {
            fbuf_n = 0;
            for x in 0..rb_name_n[i] fput(rb_name[i * RB_NAME_BYTES + x] as int);
            fput_str(" \Â\· ");
            fput_title(c);
            adw_add(c, 1, c, bsb_verses(c), 0)
        }
    }
    for i in 0..mq_n {
        fbuf_n = 0;
        fput_passage(i);
        fput_str(" (memorizing)");
        adw_add(mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i], 0)
    }
    seen: int = 0;
    while (adw_n < ADW_MOST && seen < 40) {
        best: int = -1;
        best_t: int = -1;
        for i in 0..hl_n {
            c: int = key_chapter(highlights[i].key);
            if (highlights[i].time > best_t && !adw_has_chapter(c)) {
                best = c;
                best_t = highlights[i].time
            }
        }
        for i in 0..nt_n {
            c: int = key_chapter(kept_notes[i].key);
            if (kept_notes[i].time > best_t && !adw_has_chapter(c)) {
                best = c;
                best_t = kept_notes[i].time
            }
        }
        if (best < 0) seen = 40 else {
            fbuf_n = 0;
            fput_title(best);
            n0: int = adw_n;
            adw_add(best, 1, best, bsb_verses(best), 0);
            if (adw_n == n0) adw_skip(best);
            seen = seen + 1
        }
    }
}

// The chapters passed over (no words to learn, or the other testament).
adw_skipped: []int = new int[64](0);

adw_skipped_n: int = 0;

adw_skip(c: int) {
    if (adw_skipped_n < len(adw_skipped)) {
        adw_skipped[adw_skipped_n] = c;
        adw_skipped_n = adw_skipped_n + 1
    }
}

adw_has_chapter(c: int): bool {
    for x in 0..adw_n
        if (adw_c1[x] == c && adw_c2[x] == c && adw_v1[x] == 1) return true;
    for x in 0..adw_skipped_n
        if (adw_skipped[x] == c) return true;
    false
}

// Its sections: Most Common; Related to Words You Know (a row, once a
// known word has a neighbour to learn); From Your Reading; From Study.
sk_build_add_words(id: int, lang: int) {
    ui_begin(id, SCR_ADD_WORDS, lang, "Add Words");
    if (adw_lang != lang) adw_make(lang);
    ui_section("Most Common", "");
    ui_row(UI_ITEM, ACT_LN_PREVIEW, WPV_MOST);
    ui_set_title("The Next 10 Most Common");
    learn_next(lang, 5);
    ui_rich_begin();
    for x in 0..ln_next_n {
        if (x > 0) fput_str(", ");
        if (lang == 1) fput_rli();
        fput_lemma(lang, ln_next[x], 0);
        if (lang == 1) fput_pdi()
    }
    if (ln_next_n > 0) fput_str(" \â\€\¦");
    ui_rich(sk_script(lang == 0, true));
    ui_rich_detail();
    ui_set_acc(ACC_MORE);
    if (adw_related > 0) {
        ui_section("", "");
        ui_row(UI_ITEM, ACT_LN_PREVIEW, WPV_RELATED);
        ui_set_title("Related to Words You Know");
        fbuf_n = 0;
        fput_count(adw_related);
        fput_str(if (adw_related == 1) " word" else " words");
        ui_set_detail_fbuf();
        ui_set_acc(ACC_MORE)
    }
    if (adw_n > 0) {
        ui_section("From Your Reading", "");
        for r in 0..adw_n {
            ui_row(UI_ITEM, ACT_LN_PREVIEW, r);
            fbuf_n = 0;
            fput_bytes(adw_pool, adw_title_b[r], adw_title_e[r]);
            ui_set_title_fbuf();
            fbuf_n = 0;
            fput_int(adw_left[r]);
            fput_str(if (adw_left[r] == 1) " word to learn" else " words to learn");
            ui_set_detail_fbuf();
            ui_set_acc(ACC_MORE)
        }
    }
    ui_section("From Study", "In a word study, tap Learn This Word to add it.")
}

// A range's preview (a Memory passage's, Â§14.3.6), its title fbuf's.
sk_preview_range(
    lang: int,
    c1: int,
    v1: int,
    c2: int,
    v2: int
) {
    i: int = ADW_OTHER;
    adw_c1[i] = c1;
    adw_v1[i] = v1;
    adw_c2[i] = c2;
    adw_v2[i] = v2;
    // (Its title at the pool's end, after Add Words' own.)
    at: int = adw_pool_n;
    if (at + fbuf_n > len(adw_pool)) at = 0;
    adw_title_b[i] = at;
    for x in 0..fbuf_n
        if (at + x < len(adw_pool)) adw_pool[at + x] = fbuf[x];
    adw_title_e[i] = at + fbuf_n;
    sk_open(SCR_PREVIEW, lang * 16 + ADW_OTHER + 2, true)
}

// ---- the preview (Â§14.3.5) ----
// Its words: each one's number, and its count in the passage (-1: the
// most common's or related words' preview); and where they came from
// (wpv_from: a row of Add Words, or WPV_MOST, WPV_RELATED).
WPV_MOST: int = -1;

WPV_RELATED: int = -2;

wpv_num: []int = new int[1024](0);

wpv_count: []int = new int[1024](0);

wpv_n: int = 0;

wpv_from: int = -1;

wpv_make(lang: int, from: int) {
    wpv_from = from;
    wpv_n = 0;
    if (from == WPV_MOST) {
        learn_next(lang, 10);
        for x in 0..ln_next_n {
            wpv_num[x] = ln_next[x];
            wpv_count[x] = -1
        }
        wpv_n = ln_next_n
    } else if (from == WPV_RELATED) {
        learn_related_words(lang);
        for x in 0..rel_new_n {
            if (x < len(wpv_num)) {
                wpv_num[x] = rel_new[x];
                wpv_count[x] = -1;
                wpv_n = x + 1
            }
        }
    } else if (from >= 0 && from <= ADW_OTHER) {
        learn_words_of(adw_c1[from], adw_v1[from], adw_c2[from], adw_v2[from]);
        for x in 0..wu_n {
            if (x < len(wpv_num)) {
                wpv_num[x] = wu_num[x];
                wpv_count[x] = wu_count[x];
                wpv_n = x + 1
            }
        }
    }
}

// A word marked known: gone from it.
wpv_drop(num: int) {
    at: int = -1;
    for x in 0..wpv_n
        if (wpv_num[x] == num) at = x;
    if (at < 0) return;
    for x in at..wpv_n - 1 {
        wpv_num[x] = wpv_num[x + 1];
        wpv_count[x] = wpv_count[x + 1]
    }
    wpv_n = wpv_n - 1
}

// "These 10 words make up 37% of the New Testament." "These 23 words are
// the words of John 3 you haven't learned, most common first." "These 24
// words are related to words you know, most common first." Then the
// words, each its count in the testament and its menu (Mark as Known);
// Add 10 Words (the most common's), Add All 23 (20 or fewer), Add the
// First 20: a set is never more than 20.
sk_build_preview(id: int, arg: int) {
    lang: int = arg / 16;
    from: int = wpv_from;
    fbuf_n = 0;
    if (from == WPV_MOST) fput_str("Most Common") else if (from == WPV_RELATED) fput_str("Related") else fput_bytes(adw_pool,
        adw_title_b[from], adw_title_e[from]);
    ui_begin(id, SCR_PREVIEW, arg, "");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_rich_begin();
    fput_str("These ");
    fput_int(wpv_n);
    fput_str(if (wpv_n == 1) " word " else " words ");
    if (from == WPV_RELATED) fput_str(if (wpv_n == 1) "is related to words you know." else "are related to words you know, most common first.") else if (from < 0) {
        fput_str(if (wpv_n == 1) "makes up " else "make up ");
        fput_int(learn_set_coverage(lang, wpv_num, wpv_n));
        fput_str("% of the ");
        fput_str(testament_names[lang]);
        fput(46)
    } else {
        fput_str(if (wpv_n == 1) "is the word of " else "are the words of ");
        fput_bytes(adw_pool, adw_title_b[from], adw_title_e[from]);
        fput_str(" you haven\â\€\™t learned, most common first.")
    }
    ui_rich(RUN_PLAIN);
    ui_rich_intro();
    ui_section("", "");
    for r in 0..wpv_n {
        num: int = wpv_num[r];
        sk_word_row(0, word_code(lang, num), lang, num);
        if (wpv_count[r] >= 0) {
            fbuf_n = 0;
            fput_str("\Ã\— ");
            fput_int(wpv_count[r]);
            ui_set_note_fbuf()
        }
        fbuf_n = 0;
        fput_count(vk_count_of(lang, num));
        ui_set_trailing_fbuf();
        fbuf_n = 0;
        fput_count(vk_count_of(lang, num));
        fput_str(" times in the ");
        fput_str(testament_names[lang]);
        sk_word_label(lang, num, 0);
        ui_row_action_icon("Mark as Known", "checkmark.circle", ACT_LN_KNOWN);
        ui_set_menu()
    }
    if (wpv_n == 0) return;
    fbuf_n = 0;
    if (from == WPV_MOST) {
        fput_str("Add ");
        fput_int(wpv_n);
        fput_str(if (wpv_n == 1) " Word" else " Words")
    } else if (wpv_n <= 20) {
        fput_str("Add All ");
        fput_int(wpv_n)
    } else fput_str("Add the First 20");
    ui_tool("", "", ACT_LN_ADD, 0, UI_TOOL_PROMINENT, 1);
    ui_tools[ui_tools_n - 1].title = ui_put_fbuf()
}

// ---- Verses You Can Read (Â§14.3.7) ----
// The language learn_readable's verses (crv_) are of.
sk_crv_lang: int = -1;

vcr_names: []str = ["From Your Memory Verses", "From Your Highlights and Notes", "From What You\â\€\™ve Read",
    "Elsewhere", "One Word to Learn"];

sk_build_readable(id: int, lang: int) {
    if (sk_crv_lang != lang) {
        learn_readable(lang, time(0));
        sk_crv_lang = lang
    }
    ui_begin(id, SCR_READABLE, lang, "Verses You Can Read");
    ui_plain = true;
    ui_set_empty("text.book.closed", "No Verses Yet", "As you learn words, verses where you know every word appear here.");
    at: int = 0;
    for s in 0..5 {
        if (crv_count[s] > 0) {
            ui_section(vcr_names[s], "");
            for x in at..at + crv_count[s] sk_readable_row(x)
        }
        at = at + crv_count[s]
    }
}

// A verse: its reference (and the word to learn, named), over its
// original text in the original order; in the reader, in the Hebrew and
// Greek, as it is tapped (Â§14.11.6).
sk_readable_row(x: int) {
    vi: int = crv_vi[x];
    ui_row(UI_ITEM, ACT_LN_VERSE, vi);
    ui_set_custom(CUSTOM_HIT);
    fbuf_n = 0;
    fput_ref(v_chapter(vi), v_num(vi), 0);
    w: int = crv_word[x];
    if (w >= 0) {
        // (The word to learn named: "Ï€ÏÏŒÏƒÏ‰Ï€Î¿Î½, face".)
        fput_str(" \Â\· ");
        lang: int = word_lang(w);
        if (lang == 1) fput_rli();
        fput_lemma(lang, w_strongs(w), 0);
        if (lang == 1) fput_pdi();
        fput_str(", ");
        fput_lemma(lang, w_strongs(w), 3)
    }
    ui_set_title_fbuf();
    lang: int = word_lang(v_first(vi));
    ui_rich_begin();
    for o in 0..v_end(vi) - v_first(vi) {
        w2: int = word_at_order(vi, o);
        if (w2 >= 0) {
            if (o > 0) fput(32);
            form_of(w2);
            fput_bytes(lforms, wf_b, wf_e)
        }
    }
    ui_rich(sk_script(lang == 0, false));
    ui_rich_detail()
}

// ---- Forms (Â§14.5.3) ----
// The lemma's forms made (lang.l8's fo_ and fs_), if they are another's:
// arg its number, 100000 more if Greek.
sk_forms_for: int = -1;

sk_forms_ready(arg: int) {
    if (sk_forms_for == arg && fo_num == arg % 100000) return;
    forms_of(arg >= 100000, arg % 100000);
    forms_layout();
    forms_renderings();
    sk_forms_for = arg
}

// The lemma (hero size), its transliteration, "Forms found in the Bible Â·
// 143 times"; each section a grid (its columns named over it) or a list.
sk_build_forms(id: int, arg: int) {
    sk_forms_ready(arg);
    greek: bool = arg >= 100000;
    ui_begin(id, SCR_FORMS, arg, "Forms");
    p: int = lex_first(greek, arg % 100000);
    if (p >= 0) {
        fbuf_n = 0;
        lex_field(p, 0);
        fput_bytes(llex, lf_b, lf_e);
        at: int = fbuf_n;
        lex_field(p, 1);
        fput_bytes(llex, lf_b, lf_e);
        ui_set_hero(at, sk_script(greek, false), fbuf_n);
        ui_rich_begin();
        fput_str("Forms found in the Bible \Â\· ");
        fput_count(fo_total);
        fput_str(if (fo_total == 1) " time" else " times");
        ui_rich(RUN_PLAIN);
        ui_rich_hero_line()
    }
    script: int = sk_script(greek, false);
    for s in 0..fs_n {
        ui_section("", "");
        fbuf_n = 0;
        fput_bytes(fs_pool, fs_title_b[s], fs_title_e[s]);
        ui_set_header_fbuf();
        if (fs_grid[s]) ui_set_columns(if (fs_cols[s] == 1) "Form" else "Singular|Plural");
        for r in 0..fs_rows[s] {
            x: int = fs_row_at(s, r);
            if (x >= 0) {
                if (fs_grid[s]) sk_forms_grid_row(s, x, script) else sk_forms_list_row(x,
                    script)
            }
        }
    }
}

// A list's row: its form, what it does in italic and its parsing, its
// count; tapped, the concordance of it.
sk_forms_list_row(x: int, script: int) {
    g: int = fr_cell0[x];
    if (g < 0) return;
    ui_row(UI_ITEM, ACT_LN_FORM, g);
    ui_rich_begin();
    frm_put_form(g);
    ui_rich(script);
    ui_rich_title();
    ui_rich_begin();
    if (fput_form_rendering(g)) {
        ui_rich(RUN_ITALIC);
        fput_str(" \Â\· ");
        ui_rich(RUN_FAINT)
    }
    frm_put_parsing(g);
    ui_rich(RUN_FAINT);
    ui_rich_detail();
    fbuf_n = 0;
    fput_int(fo_count[g]);
    ui_set_trailing_fbuf();
    ui_set_acc(ACC_MORE);
    frm_label(g);
    ui_set_label_fbuf()
}

// A grid's row: its label, then a cell each column: the commonest form
// over what it does and its count ("6Ã—"), tapped the concordance of that
// parsing; or a faint "â€”".
sk_forms_grid_row(s: int, x: int, script: int) {
    ui_row(UI_ITEM, 0, x);
    fbuf_n = 0;
    fput_bytes(fs_pool, fr_label_b[x], fr_label_e[x]);
    ui_set_title_fbuf();
    for c in 0..fs_cols[s] {
        g: int = if (c == 0) fr_cell0[x] else fr_cell1[x];
        fbuf_n = 0;
        if (g >= 0) {
            frm_put_form(g);
            ui_cell_fbuf(script, ACT_LN_FORM, g);
            fbuf_n = 0;
            if (fput_form_rendering(g)) ui_set_cell_sub_fbuf();
            fbuf_n = 0;
            fput_int(fo_count[g]);
            fput_str("\Ã\—");
            ui_set_cell_count_fbuf();
            frm_label(g)
        } else {
            fput_str("\â\€\”");
            ui_cell_fbuf(0, 0, -1);
            fbuf_n = 0;
            fput_bytes(fs_pool, fr_label_b[x], fr_label_e[x]);
            fput_str(if (c == 0) " singular" else " plural");
            fput_str(", none")
        }
        ui_set_cell_label_fbuf()
    }
}

// Parsing g's form (forms.txt's line).
frm_put_form(g: int) {
    if (g < 0 || fo_form[g] < 0) return;
    p: int = form_at[fo_form[g]];
    e: int = p;
    while (e < lforms_len && lforms[e] as int != 9) e = e + 1;
    fput_bytes(lforms, p, e)
}

// Its parsing in words: "aorist active indicative 3rd singular" (a
// Greek verb's), else its description's main part, lower case ("qal
// consecutive imperfect third person masculine singular"); an ending
// named ("his").
frm_put_parsing(g: int) {
    pm_b = fo_code_b[g];
    pm_e = fo_code_e[g];
    at: int = pf_at(1);
    if (fo_greek && pc(0) == 86 && pc(1) == 45 && at >= 0 && pf_len >= 3) {
        t: int = fs_letter_index("PIFARL", lmorph[at] as int);
        voice: int = greek_voice(at + 2, pf_len - 2);
        mood: int = lmorph[at + 1] as int;
        if (t >= 0 && voice >= 0) {
            frm_lower(greek_tenses[t]);
            fput(32);
            frm_lower(greek_voices[voice]);
            fput(32);
            md: int = fs_letter_index("ISOMNP", mood);
            if (md >= 0) fput_str(mood_words[md]);
            p: int = pf_at(2);
            if (p >= 0 && pf_len == 2) {
                fput(32);
                fput_str(ord_words[clamp_index(lmorph[p] as int - 49, 3)]);
                fput_str(if (lmorph[p + 1] as int == 80) " plural" else " singular")
            } else if (p >= 0 && pf_len == 3) {
                fput(32);
                fput_str(case_words[clamp_index(fs_letter_index("NGDAV", lmorph[p] as int),
                    5)]);
                fput(32);
                fput_str(gender_words[clamp_index(fs_letter_index("MFN", lmorph[p + 1] as int),
                    3)]);
                fput_str(if (lmorph[p + 2] as int == 80) " plural" else " singular")
            }
            frm_put_ending(g);
            return
        }
    }
    // (The description: " - " a space, lower case, "Verb " left out.)
    a: int = fo_desc_b[g];
    b: int = fo_desc_e[g];
    if (b - a > 7 && lmorph[a] as int == 86 && lmorph[a + 1] as int == 101) a = a + 7;
    last: int = 0;
    i: int = a;
    while (i < b) {
        k: int = lmorph[i] as int;
        if (k == 32 && i + 2 < b && lmorph[i + 1] as int == 45 && lmorph[i + 2] as int == 32) {
            fput(32);
            i = i + 3
        } else {
            if (k >= 65 && k <= 90) k = k + 32;
            if (!(k == 32 && last == 32)) fput(k);
            last = k;
            i = i + 1
        }
    }
    frm_put_ending(g)
}

mood_words: []str = ["indicative", "subjunctive", "optative", "imperative", "infinitive",
    "participle"];

ord_words: []str = ["1st", "2nd", "3rd"];

case_words: []str = ["nominative", "genitive", "dative", "accusative", "vocative"];

gender_words: []str = ["masculine", "feminine", "neuter"];

frm_lower(s: str) {
    for i in 0..len(s) {
        k: int = s[i] as int;
        fput(if (k >= 65 && k <= 90) k + 32 else k)
    }
}

// A parsing's ending, named from its joined word's card: " + his, him".
frm_put_ending(g: int) {
    if (fo_end_e[g] <= fo_end_b[g]) return;
    j: int = jp_of_code(fo_end_b[g], fo_end_e[g]);
    if (j < 0 || jp_lt[j] < 0) return;
    fput_str(" + ");
    fput_lt(jp_lt[j], LF_NAME)
}

// "Aorist active indicative, 3rd person singular, Ä“gapÄ“sen, loved, 6
// times.", into fbuf.
frm_label(g: int) {
    fbuf_n = 0;
    frm_put_parsing(g);
    if (fbuf_n > 0 && fbuf[0] as int >= 97 && fbuf[0] as int <= 122) fbuf[0] = (fbuf[0] as int - 32) trunc i8;
    fput_str(", ");
    if (g >= 0 && fo_form[g] >= 0) {
        p: int = form_at[fo_form[g]];
        while (p < lforms_len && lforms[p] as int != 9) p = p + 1;
        e: int = p + 1;
        while (e < lforms_len && lforms[e] as int != 10) e = e + 1;
        fput_bytes(lforms, p + 1, e)
    }
    fput_str(", ");
    if (fput_form_rendering(g)) fput_str(", ");
    fput_int(fo_count[g]);
    fput_str(if (fo_count[g] == 1) " time." else " times.")
}

// A form's concordance: the lemma's study's numbers (its header names its
// entry), then the verses of that parsing.
sk_form_concordance(g: int) {
    if (g < 0 || g >= fo_n) return;
    if (ws_num != fo_num || ws_greek != fo_greek) {
        ws_num = fo_num;
        ws_greek = fo_greek;
        ws_lex = lex_first(fo_greek, fo_num);
        ws_entry = ws_lex;
        ws_sense = 0;
        ws_set = false
    }
    mk_form = g;
    conc_form = g;
    conc_r = -1;
    conc_by_sense = false;
    conc_sensed = false;
    cq_n = 0;
    sk_open(SCR_CONCORDANCE, -1, true)
}

// The reader in the Hebrew and Greek at c:v (v 0: the chapter), or at
// ribbon i's place (-1: none): the host's where it jumps its own way; else
// the sheets away, the version switched, then the ribbon opened or the
// jump made (none, to the chapter on the screen's top).
sk_read_in(c: int, v: int, i: int) {
    if (c < 0 || c >= chapters) return;
    if (jp_own()) {
        ui_effect("read_in", c * 1000 + v, i);
        return
    }
    sk_n = 0;
    ui_effect("dismiss", -1, -1);
    // (Once the version is read: at once, or when the host has loaded it.)
    sk_ri_c = c;
    sk_ri_v = v;
    sk_ri_i = i;
    sk_use_version(TEXT_ORIG);
    sk_read_in_now()
}

// A read-in waiting for the Hebrew and Greek to be loaded (-1: none).
sk_ri_c: int = -1;

sk_ri_v: int = 0;

sk_ri_i: int = -1;

sk_read_in_now() {
    if (sk_ri_c < 0 || text_cur != TEXT_ORIG) return;
    c: int = sk_ri_c;
    v: int = sk_ri_v;
    i: int = sk_ri_i;
    sk_ri_c = -1;
    if (i >= 0) sk_ribbon_go(i) else if (v > 0 || c != sk_c) sk_goto(c, v)
}
