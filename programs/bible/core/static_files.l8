tag bible;

import "static_storage.l8";

// Retained data files share a declared 96 MiB pool. Each file id owns its
// first reservation until process exit; loading that id again reuses it.
// Returned slices expire when the same id is loaded again.
const BIBLE_FILE_BYTES: int = 100663296;

bible_file_data: []i8 = static_buffer([100663296]i8);

bible_file_next: int = 0;

bible_file_offsets: []int = static_buffer([128]int, -1);

bible_file_caps: []int = static_buffer([128]int);

extern bible_file_count_at(p: *i8): *int = l8_as_int;

bible_file_take(id: int, size: int): []i8 {
    if (id < 0 || id >= 128 || size < 0 || size >= BIBLE_FILE_BYTES) bible_storage_full();
    n: int = size + 1;
    offset: int = bible_file_offsets[id];
    if (offset < 0) {
        span: int = (n + 7) / 8 * 8 + 8;
        if (span > BIBLE_FILE_BYTES - bible_file_next) bible_storage_full();
        offset = bible_file_next;
        bible_file_next = offset + span;
        bible_file_offsets[id] = offset;
        bible_file_caps[id] = n
    }
    if (n > bible_file_caps[id]) bible_storage_full();
    bible_file_count_at(&bible_file_data[offset]).* = n;
    out: []i8 = bible_bytes_at(&bible_file_data[offset + 8]);
    out[n - 1] = 0i8;
    out
}
