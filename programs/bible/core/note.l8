tag bible;

use_tag std;

// A note (DESIGN.md Â§7.9), as core's screen (SKINS.md): the verse quoted,
// then the note to be read (its references links to their passages), or
// written (a field of many lines); kept through the host as it is written
// (save_kept SK_KEPT_NOTES). Over the reader, or over a sheet (the
// Library's): then closing it leaves the sheet under it.
import "skin.l8";

SCR_NOTE: int = 42;

// Edit; Done (kept: back to reading it if it was being read); Cancel;
// Delete Note; the words written (the field's); Done while reading.
ACT_NOTE_EDIT: int = 140;

ACT_NOTE_DONE: int = 141;

ACT_NOTE_CANCEL: int = 142;

ACT_NOTE_DELETE: int = 143;

ACT_NOTE_TEXT: int = 144;

ACT_NOTE_CLOSE: int = 145;

// Its verses (chapter, first verse (0: the chapter's note), last), whether
// it is being read, whether it was opened to be read, and the words in its
// field.
sk_nt_c: int = -1;

sk_nt_v: int = 0;

sk_nt_last: int = 0;

sk_nt_reading: bool = false;

sk_nt_from_read: bool = false;

sk_nt_text: []i8 = static_buffer([65536]i8);

sk_nt_n: int = 0;

// The note of verses v to last of chapter c opened (an existing note to be
// read, unless edit; a new one, or one added to, to be written): over a
// sheet if one is up, else over the reader.
sk_note_open(
    c: int,
    v: int,
    last: int,
    edit: bool
) {
    if (c < 0 || c >= chapters) return;
    i: int = note_of(c, v);
    sk_nt_c = c;
    sk_nt_v = v;
    sk_nt_last = (if (i >= 0) kept_notes[i].end else last);
    sk_nt_reading = i >= 0 && !edit;
    sk_nt_from_read = sk_nt_reading;
    sk_nt_n = 0;
    if (i >= 0) {
        for x in 0..kept_notes[i].text_n {
            if (sk_nt_n < len(sk_nt_text)) {
                sk_nt_text[sk_nt_n] = nt_pool[kept_notes[i].text_at + x];
                sk_nt_n = sk_nt_n + 1
            }
        }
    }
    sheet: bool = false;
    for j in 0..sk_n
        if (sk_groups[j] == 0) sheet = true;
    if (sheet) sk_open_over(SCR_NOTE, 0) else sk_open(SCR_NOTE, 0, false)
}

sk_build_note(id: int) {
    c: int = sk_nt_c;
    fbuf_n = 0;
    if (c >= 0) fput_ref(c, sk_nt_v, sk_nt_last);
    ui_begin(id, SCR_NOTE, 0, "");
    ui_set_screen_title_fbuf();
    if (c < 0) return;
    ui_plain = true;
    ui_page = true;
    // The verse, quoted (a chapter's note: its first heading over its first
    // verse).
    ui_rich_begin();
    if (sk_nt_v == 0) {
        p: int = ch_start[c];
        found: bool = false;
        while (p < ch_end[c] && !found) {
            e: int = line_end(p);
            if (bsb[p] as int == 83) {
                fput_bytes(bsb, p + 1, e);
                found = true
            }
            p = e + 1
        }
        if (!found) fput_title(c);
        fput(10);
        ui_rich(RUN_STRONG);
        verse_text(c, 1);
        fput_bytes(vt, 0, vt_n)
    } else {
        for x in sk_nt_v..sk_nt_last + 1 {
            if (x > sk_nt_v) fput(32);
            verse_text(c, x);
            fput_bytes(vt, 0, vt_n)
        }
    }
    ui_rich(RUN_SCRIPTURE);
    ui_rich_intro();
    ui_intro_quote = true;
    ui_section("", "");
    if (sk_nt_reading) {
        // Read: Done, Edit; its paragraphs, its references links.
        ui_set_left("Done", "", ACT_NOTE_CLOSE, UI_TOOL_PLAIN);
        ui_set_confirm("Edit", ACT_NOTE_EDIT);
        note_refs(sk_nt_text, sk_nt_n);
        a: int = 0;
        while (a < sk_nt_n) {
            e: int = a;
            while (e < sk_nt_n && sk_nt_text[e] as int != 10) e = e + 1;
            ui_row(UI_TEXT, 0, 0);
            ui_set_scripture();
            fbuf_n = 0;
            fput_bytes(sk_nt_text, a, e);
            ui_set_title_fbuf();
            for r in 0..nr_n {
                if (nr_b[r] >= a && nr_e[r] <= e) {
                    xr_book = nr_book[r];
                    xr_c = nr_c[r];
                    xr_v = (if (nr_v[r] > 0) nr_v[r] else 0);
                    xr_ce = (if (nr_ve[r] > 0) nr_c[r] else 0);
                    xr_ve = (if (nr_ve[r] > 0) nr_ve[r] else 0);
                    b: int = sk_utf16(sk_nt_text, a, nr_b[r]);
                    ui_add_link(b, b + sk_utf16(sk_nt_text, nr_b[r], nr_e[r]), ACT_VS_PREVIEW,
                        xref_both())
                }
            }
            a = e + 1
        }
        return
    }
    // Written: Done; Cancel (a new one) or Delete Note.
    ui_set_confirm("Done", ACT_NOTE_DONE);
    if (note_of(c, sk_nt_v) >= 0) ui_set_left("Delete Note", "trash", ACT_NOTE_DELETE,
        UI_TOOL_DESTRUCTIVE) else ui_set_left("Cancel", "", ACT_NOTE_CANCEL, UI_TOOL_PLAIN);
    ui_row(UI_FIELD, ACT_NOTE_TEXT, 0);
    ui_set_title("Write a note\â\€\¦");
    fbuf_n = 0;
    fput_bytes(sk_nt_text, 0, sk_nt_n);
    ui_set_detail_fbuf();
    ui_rows[ui_last()].field_kind = 2;
    ui_set_focus()
}

// The words written, as the field's editing ends: kept.
sk_note_text(buf: []i8, b: int, e: int) {
    if (sk_nt_c < 0) return;
    sk_nt_n = 0;
    for x in b..e {
        if (sk_nt_n < len(sk_nt_text)) {
            sk_nt_text[sk_nt_n] = buf[x];
            sk_nt_n = sk_nt_n + 1
        }
    }
    sk_note_save()
}

// The note as it is written, kept (none, if empty; trailing spaces and
// lines let go).
sk_note_save() {
    c: int = sk_nt_c;
    if (c < 0) return;
    n: int = sk_nt_n;
    while (n > 0 && (sk_nt_text[n - 1] as int == 32 || sk_nt_text[n - 1] as int == 10)) n = n - 1;
    old: int = note_of(c, sk_nt_v);
    same: bool = old >= 0 && kept_notes[old].text_n == n;
    if (same) {
        for i in 0..n
            if (nt_pool[kept_notes[old].text_at + i] != sk_nt_text[i]) same = false
    }
    if (same || old < 0 && n == 0) return;
    set_note(c, sk_nt_v, sk_nt_last, sk_nt_text, n);
    sk_kept_c = c;
    sk_kept(SK_KEPT_NOTES)
}

sk_note_act(at: int, action: int) {
    id: int = sk_ids[at];
    if (action == ACT_NOTE_EDIT) {
        sk_nt_reading = false;
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_NOTE_DONE) {
        sk_note_save();
        // (Opened to be read: back to reading it, unless it is gone.)
        if (sk_nt_from_read && note_of(sk_nt_c, sk_nt_v) >= 0) {
            sk_nt_reading = true;
            sk_build(at);
            ui_effect("update", id, -1);
            return
        }
    }
    if (action == ACT_NOTE_DELETE) {
        set_note(sk_nt_c, sk_nt_v, 0, sk_nt_text, 0);
        sk_kept_c = sk_nt_c;
        sk_kept(SK_KEPT_NOTES)
    }
    // (Done, Cancel, Delete: closed; what is typed after, not kept.)
    sk_nt_c = -1;
    sk_n = at;
    ui_effect("close", id, -1);
    sk_update_all()
}

// A screen of kind and arg presented over the sheet up (a note over the
// Library), which stays.
sk_open_over(kind: int, arg: int) {
    if (sk_n >= SK_SCREENS_MOST) return;
    sk_ids[sk_n] = sk_next_id;
    sk_kinds[sk_n] = kind;
    sk_args[sk_n] = arg;
    sk_groups[sk_n] = 0;
    sk_next_id = sk_next_id + 1;
    sk_n = sk_n + 1;
    sk_build(sk_top());
    ui_effect("present_over", sk_ids[sk_top()], -1)
}
