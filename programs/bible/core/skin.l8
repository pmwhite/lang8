// Screens a platform still makes itself, opened from core's (the open
// effect's argument).
OPEN_VERSIONS: int = 1;

OPEN_GLOSSES: int = 2;

OPEN_VOICE: int = 3;

OPEN_MANUAL: int = 4;

OPEN_ACKNOWLEDGEMENTS: int = 5;

OPEN_HISTORY: int = 6;

