        if (action == ACT_LEARN_WORD) {
            sk_study_ready(language_data, sk_args[at]);
            lang: int = if (ws_greek) 0 else 1;
            if (learn_add_word(language_data, lang, ws_num, FROM_STUDY, sk_today_now(),
                time(0)) < 0) return;
            sk_kept(SK_KEPT_CARDS);
            fbuf_n = 0;
            fput_str(if (lang == 0) "Added to Greek Words" else "Added to Hebrew Words");
            ui_toast(TOAST_PLUS);
            sk_update_all();
            return
        }
        if (action == ACT_STUDY_FORMS) {
            sk_study_ready(language_data, sk_args[at]);
            sk_open(SCR_FORMS, (if (ws_greek) 100000 else 0) + ws_num, true);
            return
        }
        if (action == ACT_INTERLINEAR) {
            sk_study_ready(language_data, sk_args[at]);
            if (ws_vi >= 0) sk_open(SCR_VERSE_STUDY, (v_chapter(language_data, ws_vi) * 1000 + v_num(language_data,
                ws_vi)) * 4 + 1, true);
            return
        }
        if (action == ACT_ADD_TO_NOTE) {
            sk_study_ready(language_data, sk_args[at]);
            if (ws_vi < 0 || ws_w < 0) return;
            c: int = v_chapter(language_data, ws_vi);
            v: int = v_num(language_data, ws_vi);
            i: int = note_of(c, v);
            last: int = if (i >= 0) kept_notes[i].end else v;
            sk_note_open(c, v, last, true);
            if (sk_nt_n > 0 && sk_nt_n < len(sk_nt_text)) {
                sk_nt_text[sk_nt_n] = 10i8;
                sk_nt_n = sk_nt_n + 1
            }
            fbuf_n = 0;
            if (ws_lex >= 0) {
                lex_field(language_data, ws_lex, 0);
                fput_bytes(language_data.lexicon, lf_b, lf_e);
                fput_str(" (");
                lex_field(language_data, ws_lex, 1);
                fput_bytes(language_data.lexicon, lf_b, lf_e);
                fput_str(", ")
            } else fput_str("(");
            fput_key(w_greek(language_data, ws_w), w_strongs(language_data, ws_w));
            fput_str(")");
            if (ws_lex >= 0) {
                fput_str(": ");
                lex_field(language_data, ws_lex, 3);
                fput_bytes(language_data.lexicon, lf_b, lf_e)
            }
            for x in 0..fbuf_n {
                if (sk_nt_n < len(sk_nt_text)) {
                    sk_nt_text[sk_nt_n] = fbuf[x];
                    sk_nt_n = sk_nt_n + 1
                }
            }
            sk_note_save();
            sk_build(sk_top());
            ui_effect("update", sk_ids[sk_top()], -1);
            return
        }
        if (action == ACT_CONC_SENSE) {
            sk_conc_choose_sense(value);
            sk_update_all();
            return
        }
        if (action == ACT_CONC_VERSE) {
            sk_goto(v_chapter(language_data, arg), v_num(language_data, arg));
            return
        }
        if (action == ACT_CREDIT) {
            if (arg >= 0 && arg < len(ack_links) && len(ack_links[arg]) > 0) ui_effect_url(ack_links[arg]);
            return
        }
        if (action == ACT_CHANGES) {
            sk_open(SCR_CHANGES, 0, true);
            return
        }
        if (action == ACT_COMPARE_STEP) {
            sk_cmp_step(arg);
            sk_update_all();
            return
        }
        if (action == ACT_COMPARE_READ) {
            c: int = sk_cmp_c;
            v: int = sk_cmp_vs[0];
            sk_use_version(arg);
            sk_goto(c, v);
            return
        }
        if (action == ACT_GLOSS) {
            if (arg < 0 || arg >= len(gloss_names)) return;
            og_setting = arg;
            set_pref("origGlosses", arg + 1);
            orig_forget();
            sk_save();
            sk_relayout();
            sk_update_all();
            return
        }
        if (action == ACT_HELP_PAGE) {
            t: int = arg % 1000 - 1;
            sk_open(SCR_HELP_PAGE, arg / 1000 * 2000 + (t + 1) * 2 + (if (t >= 0) 1 else 0),
                true);
            return
        }
        if (action == ACT_HELP_LINK) {
            if (manual == null) return;
            g: int = -1;
            borrow manual {
                if (arg >= 0 && arg < manual.part_count) g = manual.parts[arg].page
            }
            if (g < 0) return;
            a: int = (g * 1000 + arg + 1) * 2 + 1;
            if (sk_kinds[at] == SCR_HELP_PAGE && sk_args[at] / 2000 == g) {
                sk_args[at] = a;
                sk_build(at);
                ui_effect("focus", id, -1)
            } else sk_open(SCR_HELP_PAGE, a, true);
            return
        }
        if (action == ACT_VOICE_CHOSEN && hs_on) {
            hs_voice_chosen(arg);
            return
        }
        if (action == ACT_AUDIO_SOURCE && hs_on) {
            tx: int = arg / 16;
            src: int = arg % 16;
            if (len(src_setting(tx)) > 0) set_pref(src_setting(tx), src + 1);
            sk_save();
            if (lw_on && tx == text_cur) {
                lw_chosen = src;
                lw_standing_in = false;
                lw_go(lw_c, if (lw_v > 0) lw_v else 1)
            }
            sk_update_all();
            return
        }
        if (hs_on && (action == ACT_CELLULAR || action == ACT_DOWNLOAD || action == ACT_DOWNLOAD_DELETE)) {
            if (action == ACT_CELLULAR) {
                set_pref_on("downloadAheadCellular", value == 1);
                sk_save();
                held_pump();
                sk_update_all()
            } else if (action == ACT_DOWNLOAD) held_download(arg) else held_delete(arg);
            return
        }
        if (action == ACT_AUDIO_SOURCE || action == ACT_VOICE_CHOSEN || action == ACT_CELLULAR || action == ACT_DOWNLOAD || action == ACT_DOWNLOAD_DELETE) {
            ui_effect(if (action == ACT_AUDIO_SOURCE) "audio_source" else if (action == ACT_VOICE_CHOSEN) "voice" else if (action == ACT_CELLULAR) "cellular" else if (action == ACT_DOWNLOAD) "download" else "download_delete",
                if (action == ACT_AUDIO_SOURCE) arg / 16 else if (action == ACT_CELLULAR) value else arg,
                if (action == ACT_AUDIO_SOURCE) arg % 16 else -1);
            ui_effect("refresh", -1, -1);
            return
        }
        if (action == ACT_DAY1_START) {
            if (day1_days(bg_c) > 0) sk_plan_start(PLAN_DAY1, bg_c);
            return
        }
        if (action == ACT_PLAN_START || action == ACT_PLAN_STOP) {
            if (action == ACT_PLAN_START) sk_plan_start(arg, sk_c) else sk_plan_stop(arg);
            return
        }
        if (action == ACT_CHAPTER) {
            sk_goto(arg, 0);
            return
        }
        if (action == ACT_VISIT) {
            if (arg >= 0 && arg < hs_n) sk_goto(visits[arg].chapter, if (visits[arg].exact) visits[arg].verse else 0);
            return
        }
        if (action == ACT_VISIT_DELETE || action == ACT_HISTORY_CLEAR) {
            if (action == ACT_VISIT_DELETE) history_delete(arg) else hs_n = 0;
            kept: fn(what: int) = sk_host.save_kept;
            kept(SK_KEPT_HISTORY);
            sk_update_all();
            return
        }
        if (action == ACT_VERSION) {
            sk_use_version(arg);
            return
        }
        if (action == ACT_OPEN) {
            if (arg == OPEN_VERSIONS) sk_open(SCR_VERSIONS, 0, true) else if (arg == OPEN_HISTORY) sk_open(SCR_HISTORY,
                0, true) else if (arg == OPEN_GLOSSES) sk_open(SCR_GLOSSES, 0, true) else if (arg == OPEN_VOICES) sk_open(SCR_VOICES,
                0, true) else if (arg == OPEN_ACKNOWLEDGEMENTS) sk_open(SCR_ACKNOWLEDGEMENTS,
                0, true) else if (arg == OPEN_DOWNLOADS) sk_open(SCR_DOWNLOADS, 0,
                true) else if (arg == OPEN_DOWNLOAD_BOOKS) sk_open(SCR_DOWNLOAD_BOOKS,
                0, true) else if (arg == OPEN_SHELF) sk_open(SCR_SHELF, 0, true) else if (arg == OPEN_SHELF_BROWSE) sk_open(SCR_SHELF_BROWSE,
                value, true) else sk_open_kind(arg, -1);
            return
        }
        if (action == ACT_LISTEN) {
            sk_listen_toggle();
            return
        }
        if (action == ACT_LISTEN_RATE || action == ACT_KEEP_ON) {
            if (action == ACT_LISTEN_RATE) set_pref("listenRate", value) else set_pref_on("keepScreenOn",
                value != 0);
            sk_save();
            sk_setting_changed();
            return
        }
        if (action == ACT_SIZE) set_pref("sizeStep", value) else if (action == ACT_THEME) set_pref("theme",
            value) else if (action == ACT_SPACING) set_pref("spacing", value) else if (action == ACT_MARGINS) set_pref("margins",
            value) else if (action == ACT_SHOW) set_pref_on(sk_show_names[arg], value != 0) else if (action == ACT_FONT) set_pref("font",
            arg) else if (action == ACT_ACCENTS) set_pref_on("origAccents", value != 0) else return;
        sk_save();
        sk_relayout();
        sk_update_all()
    }
    // (The screens over it have gone: it is acted on.)
    // (Core's own host searches; else the platform's.)
    // (The ribbon made, the placeholder's name if none is typed; the
    // reader goes there, picks it up and says so.)
    // (Core's host: the switch and the time kept, scheduled again.)
    // (The host's: on asks the phone first; it keeps the switch and
    // the time, schedules, and says the screens have changed.)
    // (Today's reading in the day's reader; its days; marked, as its
    // days' circle marks it; stopped, as Stop Plan stops it.)
    // (Deleted, and popped: the screen under it made again.)
    // (The rows faded out and in.)
    // (The segment and sort kept as the platform keeps settings.)
    // (The chapter's note at the top of the reader.)
    // (Add Passage, over the Library.)
    // (Chosen, and back: Add Passage's, or the passage's own, the
    // host's: the ESV's pins.)
    // (An ESV passage with its pins. Then back to the Library.)
    // (Its words to learn, as Add Words previews them.)
    // (The verse's interlinear: its Study, at Words.)
    // Add to Note: "á¼€Î³Î±Ï€Î¬Ï‰ (agapaÅ, G25): to love" on a line of its own
    // at the end of the verse's note, which opens to be written.
    // (The reader in that version, at these verses.)
    // (Kept, the glosses made again, the reader laid out again.)
    // (A page, at its part washed if a part was chosen.)
    // (A part of this page: scrolled to and washed; another's: pushed.)
    // (Core's host: the reader kept; Listen goes on with it, from the
    // verse being heard.)
    // (Core's host: core/held.l8's.)
    // (The platform's: its recordings, voices and files. The screens
    // made again once it has done it.)
    // (The host's, where it has its own day's reader: a plan's file,
    // its reminder, the day's reader; else core's.)
    // (Versions is core's; the others, the platform's own.)
}

// The reader at chapter c, verse v, the screens put away (goto: the
// platform's own jump, which may put a sheet away its way).
sk_goto(c: int, v: int) {
    if (c < 0 || c >= chapters) return;
    // (What a jump does: history, the way back and its capsule.)
    jp_here();
    jp_jump(c, v, jp_oc, jp_ov, jp_of, jp_oe);
    jp_capsule();
    jp_arrived_c = c;
    jp_arrived_v = v;
    sk_c = c;
    sk_v = v;
    sk_frac = 0;
    sk_n = 0;
    ui_effect("goto", c, v);
    sk_write_title();
    sk_keep_place();
    sk_save()
}

sk_keep_place() {
    set_pref("chapter", sk_c);
    set_pref("verse", sk_v);
    set_pref("verseOffset", sk_frac)
}

// Version t read, if it is loaded or can be.
sk_use_version(t: int) {
    if (t == text_cur) return;
    host_switch: ?fn(t: int): bool = sk_host.switch_version;
    if (host_switch != null) {
        if (!host_switch(t)) return
    } else if (!sk_switch_version(t)) return;
    sk_v = sw_nearest(sk_c, sk_v);
    set_pref("version", t);
    sk_save();
    ui_effect("reader", chapters, -1);
    sk_relayout();
    sk_write_title();
    sk_update_all();
    // (A read-in waiting for it.)
    sk_read_in_now()
}

// Version t read: loaded, if it is not, and made the current one.
// A link into the app (bsb://JHN/3/16: a book's code in any case, a
// chapter, perhaps a verse), b's first n bytes: its chapter (-1: not one)
// and verse (sk_link_v).
sk_link_v: int = 0;

sk_link_buf: []i8 = new i8[256](0i8);

link_parse(b: []i8, n: int): int {
    p: int = 6;
    sk_link_v = 0;
    if (n < p || b[0] as int != 98) return -1;
    w: int = p;
    while (w < n && b[w] as int != 47) w = w + 1;
    num: int = 0;
    second: bool = false;
    for i in w + 1..n {
        k: int = b[i] as int;
        if (k == 47) second = true;
        if (k >= 48 && k <= 57) {
            if (second) sk_link_v = sk_link_v * 10 + k - 48 else num = num * 10 + k - 48
        }
    }
    if (w - p != 3) return -1;
    for bk in 0..books {
        same: bool = true;
        for i in 0..3 {
            k: int = b[p + i] as int;
            if (k >= 97 && k <= 122) k = k - 32;
            if (book_codes[bk][i] as int != k) same = false
        }
        if (same) return chapter_of(bk, num)
    }
    -1
}

// esv.org's page of chapter c (John+3), into fbuf; its home page.
fput_esv_url(c: int) {
    fbuf_n = 0;
    fput_str("https://www.esv.org/");
    if (c < 0 || c >= chapters) return;
    b: int = ch_book[c];
    if (book_code(b) == "PSA") fput_str("Psalm") else {
        for c in book_name(b) {
            k: int = c as int;
            fput(if (k == 32) 43 else k)
        }
    }
    if (book_count[b] > 1) {
        fput(43);
        fput_int(ch_num[c])
    }
    fput(47)
}

esv_home: str = "https://www.esv.org";

// A verse the version now read lacks: the nearest before it that it has
// (0: the chapter's top).
sw_nearest(c: int, v: int): int {
    if (v <= 0 || c < 0 || c >= chapters || !text_holds(text_cur, c) || has_verse(c,
        v)) return v;
    x: int = v - 1;
    while (x > 0 && !has_verse(c, x)) x = x - 1;
    x
}

sk_switch_version(t: int): bool {
    if ((t < 0 || t >= TEXT_PIN) && !text_is_version(t)) return false;
    if (t == TEXT_ESV) {
        // (The ESV: its text made of the chapters held; the others come
        // as the reader wants them.)
        if (!sk_esv_listed) return false;
        esv_build();
        text_use(TEXT_ESV);
        return true
    }
    if (t != text_cur && !text_ready(t)) {
        sk_want_text = t;
        return false
    }
    text_use(t);
    true
}

// The version read at launch: the one read last, but the BSB for the ESV
// while it is not to be had.
launch_version(t: int, esv_listed: bool): int {
    if (t == TEXT_ESV && !esv_listed) TEXT_BSB else t
}

// ---- the skin's lines ----
// The app begun: the settings (prefs_parse'd by the host) applied, the
// version read and the place kept, the look, the reader and its place.
sk_started: bool = false;

sk_start() {
    sk_started = true;
    t: int = launch_version(pref_get("version"), sk_esv_listed);
    if (t != text_cur && (t >= 0 && t < TEXT_PIN || text_is_version(t))) {
        if (text_ready(t)) text_use(t) else sk_want_text = t
    }
    sk_apply_prefs();
    // (Genesis 1, the first time: DESIGN.md's 01-genesis-1.)
    sk_c = pref_get("chapter");
    if (sk_c < 0 || sk_c >= chapters) sk_c = 0;
    sk_v = pref_get("verse");
    sk_frac = pref_get("verseOffset");
    sk_write_look();
    ui_effect("reader", chapters, -1);
    sk_write_place(sk_c, sk_v, sk_frac);
    sk_write_beside();
    sk_write_title();
    sk_write_commands();
    sk_write_credits();
    sk_write_chrome_words();
    // (The day known now, by the skin's time zone: core's host schedules
    // the reminders.)
    if (hs_on) hs_notify_schedule()
}

// A field's number at b in line (to e): where it ends, in sk_num_end.
sk_num_end: int = 0;

sk_num(line: []i8, b: int, e: int): int {
    i: int = b;
    while (i < e && line[i] as int == 32) i = i + 1;
    neg: bool = i < e && line[i] as int == 45;
    if (neg) i = i + 1;
    n: int = 0;
    while (i < e && line[i] as int >= 48 && line[i] as int <= 57) {
        n = n * 10 + line[i] as int - 48;
        i = i + 1
    }
    sk_num_end = i;
    if (neg) -n else n
}

sk_word_is(
    line: []i8,
    b: int,
    e: int,
    word: str
): bool {
    if (e - b < len(word)) return false;
    for i in 0..len(word)
        if (line[b + i] != word[i]) return false;
    // (Its words end at a space, or at the tab before its fields.)
    e - b == len(word) || line[b + len(word)] as int == 32 || line[b + len(word)] as int == 9
}

// Words a skin sent unescaped where they are (\n a newline, \t a tab,
// \\ a backslash: SKINS.md's wire): their new end.
sk_unescape(line: []i8, b: int, e: int): int {
    o: int = b;
    i: int = b;
    while (i < e) {
        k: int = line[i] as int;
        if (k == 92 && i + 1 < e) {
            n: int = line[i + 1] as int;
            line[o] = (if (n == 110) 10 else if (n == 116) 9 else n) trunc i8;
            i = i + 2
        } else {
            line[o] = line[i];
            i = i + 1
        }
        o = o + 1
    }
    o
}

// One line the skin sent (bytes b to e of line, without its newline).
// A line of the skin's done, then the keyboard's commands said again if
// what acts changed (keys.l8).
sk_line(line: []i8, b: int, e: int) {
    sk_take(line, b, e);
    if (sk_started) sk_write_commands_changed()
}

sk_take(line: []i8, b: int, e: int) {
    if (sk_word_is(line, b, e, "windowrows")) ui_windowed_rows = sk_num(line, b + 10,
        e) != 0 else if (sk_word_is(line, b, e, "model")) {
        index: int = sk_find(sk_num(line, b + 5, e));
        if (sk_num_end < e) {
            ui_window_section = sk_num(line, sk_num_end, e);
            ui_window_row = sk_num(line, sk_num_end, e)
        }
        if (index >= 0) sk_build(index);
        ui_window_section = -1;
        ui_window_row = -1
    } else if (sk_word_is(line, b, e, "open")) {
        kind: int = sk_num(line, b + 4, e);
        arg: int = sk_num(line, sk_num_end, e);
        push: bool = sk_num(line, sk_num_end, e) != 0;
        if (kind >= SCR_GOTO && kind <= SCR_SHARE) sk_open(kind, arg, push)
    } else if (sk_word_is(line, b, e, "panelvisible")) {
        sk_studying = sk_num(line, b + 12, e) != 0;
        if (sk_sel_n > 0) {
            sk_build_tray();
            ui_write();
            ui_effect("tray", -1, -1)
        }
    } else if (sk_word_is(line, b, e, "panelfits")) sk_panel_fits = sk_num(line, b + 9,
        e) != 0 else if (sk_word_is(line, b, e, "panel")) {
        kind: int = sk_num(line, b + 5, e);
        arg: int = sk_num(line, sk_num_end, e);
        if (kind >= SCR_GOTO && kind <= SCR_SHARE) sk_open_panel(kind, arg)
    } else if (sk_word_is(line, b, e, "openplan")) {
        plan: int = sk_num(line, b + 8, e);
        day: int = sk_num(line, sk_num_end, e);
        selected: bool = sk_num(line, sk_num_end, e) != 0;
        push: bool = sk_num(line, sk_num_end, e) != 0;
        sk_open_plan(plan, day, selected, push)
    } else if (sk_word_is(line, b, e, "anchor")) {
        index: int = sk_find(sk_num(line, b + 6, e));
        if (index >= 0) sk_closing(index + 1)
    } else if (sk_word_is(line, b, e, "closegroup")) {
        group: int = sk_num(line, b + 10, e);
        if (group == 1) sk_beside_closed();
        if (group == 0 || group == 1) sk_close_group(group)
    } else if (sk_word_is(line, b, e, "studyable")) {
        // (studyable C A B: whether the words at UTF-16 A to B of chapter
        // C's text have a word to study, said as studyable 1|0; studyat
        // C A B: its Study opened.)
        yc: int = sk_num(line, b + 9, e);
        ya: int = sk_num(line, sk_num_end, e);
        ui_effect("studyable", if (sk_study_pick(yc, ya, sk_num(line, sk_num_end,
            e))) 1 else 0, -1)
    } else if (sk_word_is(line, b, e, "studyat")) {
        yc: int = sk_num(line, b + 7, e);
        ya: int = sk_num(line, sk_num_end, e);
        if (sk_study_pick(yc, ya, sk_num(line, sk_num_end, e))) {
            borrow language_data {
                sk_study_open(pick_vi, pick_word, w_greek(language_data, pick_word),
                    w_strongs(language_data, pick_word), false, false)
            }
        }
    } else if (sk_word_is(line, b, e, "editmenu")) em_act(sk_num(line, b + 8, e)) else if (sk_word_is(line,
        b, e, "link")) {
        // (link ADDRESS: a link into the app opened, bsb://JHN/3/16.)
        at: int = if (b + 5 < e) b + 5 else e;
        le: int = sk_unescape(line, at, e);
        if (le - at <= len(sk_link_buf)) {
            for i in at..le sk_link_buf[i - at] = line[i];
            lc: int = link_parse(sk_link_buf, le - at);
            if (lc >= 0) sk_goto(lc, sk_link_v)
        }
    } else if (sk_word_is(line, b, e, "start")) {
        sk_width = sk_num(line, b + 5, e);
        sk_height = sk_num(line, sk_num_end, e);
        sk_density = sk_num(line, sk_num_end, e);
        sk_dark = sk_num(line, sk_num_end, e) != 0;
        // (Its time zone, seconds east of UTC, where it says: the day
        // turns at its midnight.)
        if (sk_num_end < e) sk_tz = sk_num(line, sk_num_end, e);
        sk_start()
    } else if (sk_word_is(line, b, e, "want")) {
        wc: int = sk_num(line, b + 4, e);
        // (In the ESV, one not here asked for, near the place:
        // core/esv_client.l8.)
        if (text_cur == TEXT_ESV && wc >= sk_c - 1 && wc <= sk_c + 2) ew_want(wc);
        sk_write_chapter(wc)
    } else if (sk_word_is(line, b, e, "esvact")) {
        // (esvact WHAT C: a tap on chapter C's ESV line; esvstatus STATUS
        // ESV: the server's answer, whether it gives the ESV.)
        what: int = sk_num(line, b + 7, e);
        sk_esv_act(what, sk_num(line, sk_num_end, e))
    } else if (sk_word_is(line, b, e, "notifyok")) {
        // (notifyok WHO GRANTED: the platform's answer to notify_ask.)
        nw: int = sk_num(line, b + 9, e);
        hs_notify_answer(nw, sk_num(line, sk_num_end, e) != 0);
        hs_notify_schedule()
    } else if (sk_word_is(line, b, e, "reminded")) {
        // (reminded PLAN MEMORY: a reminder opened.)
        rp: int = sk_num(line, b + 9, e);
        hs_reminded(rp, sk_num(line, sk_num_end, e) != 0)
    } else if (sk_word_is(line, b, e, "esvstatus")) {
        st: int = sk_num(line, b + 10, e);
        sk_esv_status(st, sk_num(line, sk_num_end, e) != 0)
    } else if (sk_word_is(line, b, e, "place")) {
        c: int = sk_num(line, b + 5, e);
        v: int = sk_num(line, sk_num_end, e);
        f: int = sk_num(line, sk_num_end, e);
        if (c >= 0 && c < chapters) {
            was: int = sk_c;
            sk_c = c;
            sk_v = v;
            sk_frac = f;
            sk_keep_place();
            if (c != was) sk_write_title()
        }
    } else if (sk_word_is(line, b, e, "act")) {
        id: int = sk_num(line, b + 3, e);
        action: int = sk_num(line, sk_num_end, e);
        arg: int = sk_num(line, sk_num_end, e);
        value: int = sk_num(line, sk_num_end, e);
        sk_act(id, action, arg, value)
    } else if (sk_word_is(line, b, e, "query")) {
        id: int = sk_num(line, b + 5, e);
        at: int = if (sk_num_end < e) sk_num_end + 1 else e;
        sk_query(id, line, at, sk_unescape(line, at, e))
    } else if (sk_word_is(line, b, e, "text")) {
        id: int = sk_num(line, b + 4, e);
        action: int = sk_num(line, sk_num_end, e);
        arg: int = sk_num(line, sk_num_end, e);
        at: int = if (sk_num_end < e) sk_num_end + 1 else e;
        sk_text(id, action, arg, line, at, sk_unescape(line, at, e))
    } else if (sk_word_is(line, b, e, "submit")) sk_submit(sk_num(line, b + 6, e)) else if (sk_word_is(line,
        b, e, "scope")) {
        id: int = sk_num(line, b + 5, e);
        sk_scope_chosen(id, sk_num(line, sk_num_end, e))
    } else if (sk_word_is(line, b, e, "tap")) {
        if (sk_word_is(line, b + 4, e, "goto")) sk_open(SCR_GOTO, 0, false) else if (sk_word_is(line,
            b + 4, e, "versions")) sk_open(SCR_VERSIONS, 0, false) else if (sk_word_is(line,
            b + 4, e, "study")) sk_beside_toggle() else if (sk_word_is(line, b + 4,
            e, "settings")) sk_open(SCR_SETTINGS, 0, false) else if (sk_word_is(line,
            b + 4, e, "history")) sk_open(SCR_HISTORY, 0, false) else if (sk_word_is(line,
            b + 4, e, "search")) sk_open(SCR_SEARCH, 0, false) else if (sk_word_is(line,
            b + 4, e, "library")) sk_open(SCR_LIBRARY, 0, false)
    } else if (sk_word_is(line, b, e, "closed")) {
        i: int = sk_find(sk_num(line, b + 6, e));
        if (i >= 0) sk_closing(i)
    } else if (sk_word_is(line, b, e, "dark")) {
        sk_dark = sk_num(line, b + 4, e) != 0;
        sk_write_look();
        ui_effect("relayout", -1, -1);
        ui_effect("jump", sk_c, sk_v)
    } else if (sk_word_is(line, b, e, "select")) {
        // (select C V...: the verses selected, in order (none: the tray
        // away); the tray's model written as screen 0.)
        sk_sel_c = sk_num(line, b + 6, e);
        sk_sel_n = 0;
        while (sk_num_end < e && sk_sel_n < len(sk_sel_v)) {
            sk_sel_v[sk_sel_n] = sk_num(line, sk_num_end, e);
            sk_sel_n = sk_sel_n + 1
        }
        if (sk_sel_n > 0 && sk_sel_v[sk_sel_n - 1] <= 0) sk_sel_n = sk_sel_n - 1;
        sk_awake();
        sk_build_tray();
        ui_write();
        ui_effect(if (sk_sel_n > 0) "tray" else "tray_away", -1, -1);
        sk_beside_select()
    } else if (sk_word_is(line, b, e, "version")) {
        // (version ABBR: the version an address names, read: before
        // start, the one it opens in.)
        for t in 0..TEXT_ESV + 1 {
            if (sk_word_is(line, b + 8, e, text_abbrs[t])) {
                if (sk_started) sk_use_version(t) else set_pref("version", t)
            }
        }
    } else if (sk_word_is(line, b, e, "tapverse")) {
        // (tapverse C V: verse C:V tapped, its selection toggled by core's
        // rule; tapnone: a tap elsewhere in the reader, the selection let
        // go. The skin paints what selection says.)
        tc: int = sk_num(line, b + 8, e);
        tv: int = sk_num(line, sk_num_end, e);
        if (tc >= 0 && tc < chapters && tv > 0) {
            sel_toggle(tc, tv);
            sk_awake();
            sk_sel_said();
            sk_build_tray();
            ui_write();
            ui_effect(if (sk_sel_n > 0) "tray" else "tray_away", -1, -1)
        }
    } else if (sk_word_is(line, b, e, "tapnone")) {
        sk_awake();
        if (sk_sel_n > 0) {
            sk_sel_n = 0;
            sk_sel_said();
            ui_effect("tray_away", -1, -1)
        }
    } else if (sk_word_is(line, b, e, "versestudy")) {
        // (versestudy C V: verse C:V's Study, for a skin that shows it as
        // core's screen: the tray's Study.)
        // (A sheet: the selection let go, as the iPhone's.)
        sc: int = sk_num(line, b + 10, e);
        sv: int = sk_num(line, sk_num_end, e);
        if (sc >= 0 && sc < chapters && sv > 0) {
            if (sk_sel_n > 0) sk_sel_clear();
            sk_open(SCR_VERSE_STUDY, (sc * 1000 + sv) * 4, false)
        }
    } else if (sk_word_is(line, b, e, "footnote")) {
        // (footnote C P: the footnote at P of chapter C, a link's; preview
        // REF: a reference's.)
        fc: int = sk_num(line, b + 8, e);
        sk_footnote(fc, sk_num(line, sk_num_end, e))
    } else if (sk_word_is(line, b, e, "word")) sk_word(sk_num(line, b + 4, e)) else if (sk_word_is(line,
        b, e, "preview")) sk_preview(sk_num(line, b + 7, e)) else if (sk_word_is(line,
        b, e, "rest")) {
        // (rest C V FRAC END ENDS_HI MS: the reader at rest; moving MS,
        // tick MS, jumped KIND: core/reading.l8's; MS the skin's clock.)
        rc: int = sk_num(line, b + 4, e);
        rv: int = sk_num(line, sk_num_end, e);
        rf: int = sk_num(line, sk_num_end, e);
        re: int = sk_num(line, sk_num_end, e);
        rh: int = sk_num(line, sk_num_end, e);
        rt: f64 = sk_num(line, sk_num_end, e) as f64 / 1000.0f64;
        rd_rest(rc, rv, rf, re != 0, rh, rt);
        // (Reading the ESV: the chapters around the place asked for.)
        if (text_cur == TEXT_ESV) ew_rest(rc, rh);
        lw_dragged(false, rt);
        sk_wake();
        sk_awake()
    } else if (sk_word_is(line, b, e, "moving")) {
        rd_scroll(sk_num(line, b + 6, e) as f64 / 1000.0f64);
        lw_dragged(true, 0.0f64);
        sk_wake()
    } else if (sk_word_is(line, b, e, "tick")) {
        rd_tick(sk_num(line, b + 4, e) as f64 / 1000.0f64);
        sk_wake()
    } else if (sk_word_is(line, b, e, "spoke")) {
        // (spoke C V, spoken C V, listenstop: the skin's voice, as core's
        // session asked: core/listen.l8's lw_.)
        // (spoke C V MS: MS the skin's clock, for following's wait.)
        sc: int = sk_num(line, b + 5, e);
        sv: int = sk_num(line, sk_num_end, e);
        if (sc < PXW_SAY) lw_spoke(sc, sv, if (sk_num_end < e) sk_num(line, sk_num_end,
            e) as f64 / 1000.0f64 else -1.0f64)
    } else if (sk_word_is(line, b, e, "spoken")) {
        sc: int = sk_num(line, b + 6, e);
        // (A verse Practice's voice said: its place, PXW_SAY on.)
        if (sc >= PXW_SAY) pxw_spoken(sc - PXW_SAY) else lw_spoken(sc, sk_num(line,
            sk_num_end, e))
    } else if (sk_word_is(line, b, e, "timer")) pxw_timer(sk_num(line, b + 6, e)) else if (sk_word_is(line,
        b, e, "voices")) {
        // (voices Q:LANG:NAME ...: the device's voices, a field each.)
        sk_voices_said(line, if (b + 7 < e) b + 7 else e, e);
        sk_update_all()
    } else if (sk_word_is(line, b, e, "listenstop")) lw_stop() else if (sk_word_is(line,
        b, e, "listenpause")) lw_pause() else if (sk_word_is(line, b, e, "listenplay")) lw_resume() else if (sk_word_is(line,
        b, e, "listennext")) lw_next() else if (sk_word_is(line, b, e, "listenprev")) lw_previous() else if (sk_word_is(line,
        b, e, "audiotime")) {
        // (audiotime TOKEN CS DURATION, audioended TOKEN, audiofailed
        // TOKEN: the skin's player, as core/listen.l8 asked.)
        tk: int = sk_num(line, b + 10, e);
        tt: int = sk_num(line, sk_num_end, e);
        if (tk >= PXW_TOK) pxw_time(tk, tt) else lw_time(tk, tt, sk_num(line, sk_num_end,
            e))
    } else if (sk_word_is(line, b, e, "audioended")) {
        ta: int = sk_num(line, b + 11, e);
        if (ta >= PXW_TOK) pxw_ended(ta) else lw_ended(ta)
    } else if (sk_word_is(line, b, e, "audiofailed")) {
        tf: int = sk_num(line, b + 12, e);
        // (Practice's clip that can't be had: the voice says it.)
        if (tf >= PXW_TOK) {
            if (tf == pxw_tok && pxa_mode != 0) {
                pxa_player = false;
                pxw_verse(pxa_x)
            }
        } else lw_failed(tf)
    } else if (sk_word_is(line, b, e, "jumped")) rd_jump(sk_num(line, b + 6, e)) else if (sk_word_is(line,
        b, e, "back")) sk_back() else if (sk_word_is(line, b, e, "titlemenu")) {
        // (titlemenu: the title's menu's model written as screen 0.)
        sk_build_title_menu();
        ui_write()
    } else if (sk_word_is(line, b, e, "menuact")) {
        action: int = sk_num(line, b + 7, e);
        sk_title_act(action, sk_num(line, sk_num_end, e))
    } else if (sk_word_is(line, b, e, "trayact")) {
        action: int = sk_num(line, b + 7, e);
        sk_tray_act(action, sk_num(line, sk_num_end, e))
    } else if (sk_word_is(line, b, e, "key")) {
        // (key NAME MODS: core/keys.l8's.)
        ne: int = b + 4;
        while (ne < e && line[ne] as int != 32) ne = ne + 1;
        kk: int = kc_of(line, b + 4, ne, sk_num(line, ne, e));
        if (kk >= 0) _k: bool = sk_key(kk)
    } else if (sk_word_is(line, b, e, "away")) sk_save() else if (sk_word_is(line,
        b, e, "refresh")) sk_update_all()
}

// The selection, said: its chapter (-1 none) and verses.
sk_sel_said() {
    fbuf_n = 0;
    fput_int(if (sk_sel_n > 0) sk_sel_c else -1);
    for i in 0..sk_sel_n {
        fput(32);
        fput_int(sk_sel_v[i])
    }
    ui_effect_fbuf("selection")
}

// When the skin is to say "tick" (its clock, ms: wake MS), if a rest is
// being timed.
sk_wake() {
    if (rd_wake > 0.0f64) ui_effect("wake", (rd_wake * 1000.0f64) as int, -1)
}

// Each line of bytes b to e (newline-ended), in turn.
sk_lines(buf: []i8, b: int, e: int) {
    p: int = b;
    for i in b..e {
        if (buf[i] as int == 10) {
            sk_line(buf, p, i);
            p = i + 1
        }
    }
}
