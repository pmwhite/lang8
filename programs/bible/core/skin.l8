                sk_words(SK_WORDS_APP_VERSION);
                ui_set_footer_fbuf()
            }
            n: int = ack_counts[k];
            if (k == 2 && sk_num_of(SK_NUM_ESV_AUDIO, 0) != 1) n = 1;
            for r in 0..n {
                i: int = ack_first[k] + r;
                ui_row(UI_ITEM, if (len(ack_links[i]) > 0) ACT_CREDIT else 0, i);
                ui_set_title(ack_titles[i]);
                if (len(ack_lines[i]) > 0) ui_set_detail(ack_lines[i]);
