            }
            if (k == 4) {
                ui_row(UI_ITEM, ACT_CHANGES, 0);
                ui_set_title("Changes to the Lexicon Data");
                ui_set_acc(ACC_MORE)
            }
        }
    }
}

// The changes made to the lexicons' and others' data.
change_lines: []str = ["STEP Bible\â\€\™s HTML was converted to plain styled text: bold, italic, paragraphs and references kept; other markup dropped, and entities decoded.",
    "Entries were grouped by base Strong\â\€\™s number, the sense matching the word\â\€\™s part of speech first.",
    "Hebrew cantillation and paragraph marks were removed for display; vowel points kept.",
    "Psalm titles were mapped to verse 1, as the BSB\â\€\™s tables have them.", "Transliterations of Hebrew lemmas are the tables\â\€\™ own, or made in their style.",
    "Cross references to 3 John 1:15 are given at 1:14, as the BSB numbers it.", "The commentary\â\€\™s markup was converted to plain styled text.",
    "Each word\â\€\™s sense is STEP\â\€\™s disambiguated Strong\â\€\™s number in TAHOT and TAGNT, matched to the BSB\â\€\™s words of the verse by base number, in the original order.",
    "MACULA\â\€\™s Proximity pairs were reduced to base Strong\â\€\™s numbers (Aramaic as Hebrew), each word\â\€\™s ten nearest kept.",
    "Recordings are played as published. Verse timings for them were computed by forced alignment.",
    "The Hebrew and Greek is TAHOT\â\€\™s Leningrad text with the Qere read (its cantillation and paseq removed, kept for Show Accents) and TAGNT\â\€\™s NA28 words with their punctuation, each verse keyed by the BSB\â\€\™s numbers; words restored from the Septuagint are left out.",
    "Each word\â\€\™s meaning is the UBS dictionaries\â\€\™ meaning listed for its place in its verse, or, where the places differ, for its Strong\â\€\™s number in order."];

sk_build_changes(id: int) {
