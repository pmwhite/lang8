SCR_GOTO: int = 1;

SCR_CHAPTERS: int = 2;

SCR_VERSIONS: int = 3;

SCR_SETTINGS: int = 4;

SCR_HISTORY: int = 5;

SCR_SEARCH: int = 6;

SCR_PLANS: int = 7;

SCR_PLAN: int = 8;

