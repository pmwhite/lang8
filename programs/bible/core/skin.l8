tag bible;

use_tag std;

// The app for a skin (SKINS.md): its state, its screens and what their
// actions do, and the reader's chapters, as the wire's lines into ui_out.
// A skin's host (in L8, on its platform) loads the texts and the settings,
// passes each line the skin sends to sk_line, and sends ui_out's lines on.
// What only the host can do (read a version's file, keep the settings) it
// gives here as functions: sk_host.
import "ui.l8";

import "prefs.l8";

import "look.l8";

import "chapter_ranges.l8";

import "orig.l8";

// ---- what the host does for the app ----
type SkinHost = {
    // The settings kept (prefs_format into fbuf, then kept).
    save_prefs: fn();
    // What is kept (SK_KEPT_HISTORY, ...) changed: kept now, the platform's
    // way (store.l8's lines in its files).
    save_kept: fn(what: int);
    // Words only the platform knows (SK_WORDS_...), onto fbuf (from 0).
    words: fn(what: int);
    // The reader switched to version t, as the platform does it (none:
    // core's own, sk_switch_version); whether it was.
    switch_version: ?fn(t: int): bool
}

// A version wanted that is not loaded (-1: none): the host loads it (it
// keeps the text for good, which only its own loop can), then calls
// sk_use_version(t) again.
sk_want_text: int = -1;

sk_no_save() { }

sk_no_save_kept(_what: int) { }

sk_no_words(_what: int) {
    fbuf_n = 0
}

// The platform's words (SkinHost.words): who reads the version aloud; the
// Listen section's footer, if it has one now.
SK_WORDS_VOICE: int = 1;

SK_WORDS_LISTEN_FOOTER: int = 2;

// Under "Search the ESV for ...": why it isn't shown yet (Searching...,
// No connection), or nothing.
SK_WORDS_ESV_SEARCH: int = 3;

sk_words(what: int) {
    fbuf_n = 0;
    f: fn(what: int) = sk_host.words;
    f(what)
}

// What the platform has (its host says): Listen, a Manual,
// Acknowledgements, keeping the screen on, and its fonts (by name, in the
// settings' order: none, no Font section).
sk_has_listen: bool = false;

sk_has_manual: bool = false;

sk_has_acknowledgements: bool = false;

sk_has_keep_on: bool = false;

sk_fonts: []str = new str[0]("");

SK_KEPT_HISTORY: int = 1;

SK_KEPT_SEARCHES: int = 2;

// The ribbons changed (made, renamed, colored, deleted): the host keeps
// them (store.l8's lines), and its menus follow.
SK_KEPT_RIBBONS: int = 3;

// The local time's offset from UTC (seconds), as the host says.
sk_tz: int = 0;

// Today (a day number), as the host says (its demo's day); -1: the
// clock's.
sk_today: int = -1;

sk_today_now(): int {
    if (sk_today >= 0) sk_today else sk_local_day(time(0))
}

sk_local_day(t: int): int {
    day_of(t + sk_tz)
}

sk_host: SkinHost = SkinHost {
    save_prefs: &sk_no_save,
    save_kept: &sk_no_save_kept,
    words: &sk_no_words,
    switch_version: null
};

// What the platform has, as its host says: the Hebrew and Greek's data,
// and the ESV (listed once our server has said it can give it), and what
// it calls itself (On This iPhone).
sk_has_orig: bool = false;

sk_esv_listed: bool = false;

sk_device: str = "Phone";

// Sections only the host has (in Go To, before Recent): its ribbons and
// its reading plan (HOST_); and the chapters they show, which Recent
// leaves out.
sk_has_ribbons: bool = false;

HOST_RIBBONS: int = 1;

HOST_PLAN: int = 2;

// The ESV's own search results (the host's, from its server), shown in
// place of Search's once asked for (sk_esv_results, as the host says).
HOST_ESV_RESULTS: int = 3;

// A plan's reminder (its switch and time: the host's notifications),
// first in a plan followed's days, where the host has reminders.
HOST_REMINDER: int = 4;

sk_has_reminders: bool = false;

sk_esv_results: bool = false;

sk_listed_c: []int = new int[16](0);

sk_listed_n: int = 0;

// ---- the screens, and their actions ----
SCR_GOTO: int = 1;

SCR_CHAPTERS: int = 2;

SCR_VERSIONS: int = 3;

SCR_SETTINGS: int = 4;

SCR_HISTORY: int = 5;

SCR_SEARCH: int = 6;

SCR_PLANS: int = 7;

SCR_PLAN: int = 8;

SCR_DAY1: int = 9;

SCR_BEGIN_BOOKS: int = 10;

SCR_BEGIN_CHAPTERS: int = 11;

SCR_NEW_RIBBON: int = 12;

SCR_RIBBON: int = 13;

ACT_BOOK: int = 1;

ACT_CHAPTER: int = 2;

ACT_VERSION: int = 3;

ACT_SIZE: int = 4;

ACT_THEME: int = 5;

ACT_SPACING: int = 6;

ACT_MARGINS: int = 7;

ACT_SHOW: int = 8;

ACT_VISIT: int = 9;

ACT_VISIT_DELETE: int = 10;

ACT_HISTORY_CLEAR: int = 11;

ACT_OPEN: int = 12;

ACT_FONT: int = 13;

ACT_ACCENTS: int = 14;

ACT_LISTEN: int = 15;

ACT_LISTEN_RATE: int = 16;

ACT_KEEP_ON: int = 17;

ACT_PLACE: int = 18;

ACT_GOTO_REF: int = 19;

ACT_HIT: int = 20;

ACT_SEARCH_REF: int = 21;

ACT_RECENT_SEARCH: int = 22;

ACT_SEARCHES_CLEAR: int = 23;

ACT_ESV_SEARCH: int = 24;

ACT_PLAN: int = 25;

ACT_DAY: int = 26;

ACT_DAY_MARK: int = 27;

ACT_PLAN_START: int = 28;

ACT_PLAN_STOP: int = 29;

ACT_BEGIN_BOOK: int = 30;

ACT_BEGIN_CHAPTER: int = 31;

ACT_BEGIN_CHOSEN_BOOK: int = 32;

ACT_BEGIN_CHOSEN_CHAPTER: int = 33;

ACT_DAY1_START: int = 34;

ACT_NR_NAME: int = 35;

ACT_NR_COLOR: int = 36;

ACT_NR_ADD: int = 37;

ACT_RIBBON_RENAME: int = 38;

ACT_RIBBON_COLOR: int = 39;

ACT_RIBBON_OPEN: int = 40;

ACT_RIBBON_DELETE: int = 41;

// Screens a platform still makes itself, opened from core's (the open
// effect's argument).
OPEN_VERSIONS: int = 1;

OPEN_GLOSSES: int = 2;

OPEN_VOICE: int = 3;

OPEN_MANUAL: int = 4;

OPEN_ACKNOWLEDGEMENTS: int = 5;

OPEN_HISTORY: int = 6;

// A plan's days (the effect's second number: the plan), and A Chapter a
// Day's Begin At.
OPEN_PLAN: int = 7;

OPEN_DAY1: int = 8;

// A plan's day, read (the effect's second number: plan * 1000 + day).
OPEN_DAY: int = 9;

// A row's own presentation, where a skin has one (none: its kind's).
CUSTOM_LISTEN: int = 1;

CUSTOM_SIZE: int = 2;

CUSTOM_THEMES: int = 3;

CUSTOM_FONT: int = 4;

// A verse a search found: its reference small, its words as the reader's
// with the matches stressed (the row's marks), up to four lines.
CUSTOM_HIT: int = 5;

// The ribbons' colors to choose from: VALUE the one chosen, OPTIONS their
// colors in the theme now (hex, split by |), DETAIL their names; a tap
// is the row's action with the color.
CUSTOM_SWATCHES: int = 6;

// The versions offered: those a skin bundles (not the ESV, nor the
// original's, yet).
sk_versions: []int = [0, 1, 2, 3, 4];

// The screens shown, bottom to top: their ids, kinds and arguments.
SK_SCREENS_MOST: int = 16;

sk_ids: []int = new int[SK_SCREENS_MOST](0);

sk_kinds: []int = new int[SK_SCREENS_MOST](0);

sk_args: []int = new int[SK_SCREENS_MOST](0);

sk_n: int = 0;

sk_next_id: int = 1;

// The reader's place: its top (chapter, verse, and thousandths of an em
// into the verse), as the skin says it is.
sk_c: int = 0;

sk_v: int = 0;

sk_frac: int = 0;

// The skin's window, for what depends on it.
sk_width: int = 0;

sk_height: int = 0;

sk_density: int = 100;

// ---- settings into the layout ----
// The Show settings, in show_titles' order (the iPhone's).
sk_show_names: []str = ["showVerseNumbers", "showHeadings", "showNotes", "redLetter",
    "verseLines"];

sk_show_titles: []str = ["Verse Numbers", "Section Headings", "Footnote Marks", "Words of Jesus in Red",
    "One Verse per Line"];

sk_show_default: []bool = [true, true, true, false, false];

sk_show(i: int): bool {
    pref_on(sk_show_names[i], sk_show_default[i])
}

// The layout's flags from the settings.
sk_apply_prefs() {
    lay_verse_numbers = sk_show(0);
    lay_headings = sk_show(1);
    lay_notes = sk_show(2);
    lay_verse_lines = sk_show(4)
}

// The look, as a line, worked out so that a skin needs none of look.l8's
// tables: the text's size and its line spacing (thousandths of the
// default), the margins (points), whether the theme is dark, whether the
// words of Jesus are red, then the theme's colors as hex: the page, the
// ink, headings, faint text, the accent, rules.
sk_write_look() {
    size: int = clamp_index(pref("sizeStep", 2), len(size_steps));
    spacing: int = clamp_index(pref("spacing", 1), len(spacings));
    margin: int = clamp_index(pref("margins", 1), len(margins));
    th: int = theme_now(clamp_index(pref("theme", 0), len(t_bg)), sk_dark);
    ui_str("look ");
    ui_int((size_steps[size] * 1000.0f64) as int);
    ui_byte(32);
    ui_int((spacings[spacing] * 1000.0f64) as int);
    ui_byte(32);
    ui_int(margins[margin] as int);
    ui_byte(32);
    ui_int(if (theme_dark(th, sk_dark)) 1 else 0);
    ui_byte(32);
    ui_int(if (sk_show(3)) 1 else 0);
    for color in [t_bg[th], t_ink[th], t_heading[th], t_faint[th], t_accent[th], t_rule[th]] {
        ui_byte(32);
        ui_str(color)
    }
    ui_byte(10)
}

clamp_index(i: int, n: int): int {
    if (i < 0) 0 else if (i >= n) n - 1 else i
}

// Whether the system is in its dark appearance (for Auto), as the skin
// says.
sk_dark: bool = false;

// ---- the reader ----
sk_layout: ChapterLayout = chapter_layout();

sk_ranges: ChapterRanges = chapter_ranges();

// Chapter c of the version read, as lines: its text, its runs (UTF-16
// places, as Java and JavaScript count), its verses, end.
sk_write_chapter(c: int) {
    if (c < 0 || c >= chapters) return;
    sk_apply_prefs();
    ctx: *ChapterLayout = &sk_layout;
    ctx.lay_verse_numbers = lay_verse_numbers;
    ctx.lay_headings = lay_headings;
    ctx.lay_notes = lay_notes;
    ctx.lay_verse_lines = lay_verse_lines;
    ctx.lay_accents = lay_accents;
    ctx.source = text_source(text_cur);
    layout_chapter_from(ctx.source, ctx, c);
    measure_chapter(ctx, &sk_ranges, c);
    u: []int = sk_ranges.u16_at;
    ui_str("chapter ");
    ui_int(c);
    ui_byte(9);
    ui_field_bytes(ctx.out, 0, ctx.out_n);
    ui_byte(10);
    p: int = 0;
    for r in 0..ctx.runs {
        e: int = ctx.run_end[r];
        if (e > p) {
            ui_str("span ");
            ui_int(u[p]);
            ui_byte(32);
            ui_int(u[e]);
            ui_byte(32);
            ui_int(ctx.run_style[r]);
            ui_byte(32);
            ui_int(ctx.run_para[r]);
            ui_byte(10)
        }
        p = e
    }
    for i in 0..ctx.verse_count {
        if (ctx.verse_begin[i] >= 0) {
            ui_str("verse ");
            ui_int(ctx.verse_num[i]);
            ui_byte(32);
            ui_int(u[ctx.verse_begin[i]]);
            ui_byte(32);
            ui_int(u[ctx.verse_end[i]]);
            ui_byte(10)
        }
    }
    ui_str("end\n")
}

// The bar's title (the chapter at the top) and the version read.
sk_write_title() {
    fbuf_n = 0;
    fput_title(sk_c);
    ui_line_fbuf("title");
    fbuf_n = 0;
    fput_str(text_abbrs[text_cur]);
    ui_line_fbuf("version")
}

// The reader to be made again (a setting or the version changed), at its
// place.
sk_relayout() {
    sk_write_look();
    ui_effect("relayout", -1, -1);
    ui_effect("jump", sk_c, sk_v)
}

// ---- screens ----
sk_top(): int {
    sk_n - 1
}

sk_find(id: int): int {
    for i in 0..sk_n
        if (sk_ids[i] == id) return i;
    -1
}

// Screen i (of those shown) built, and written.
sk_build(i: int) {
    k: int = sk_kinds[i];
    a: int = sk_args[i];
    if (k == SCR_GOTO) sk_build_goto(sk_ids[i]) else if (k == SCR_CHAPTERS) sk_build_chapters(sk_ids[i],
        a) else if (k == SCR_VERSIONS) sk_build_versions(sk_ids[i]) else if (k == SCR_SETTINGS) sk_build_settings(sk_ids[i]) else if (k == SCR_HISTORY) sk_build_history(sk_ids[i]) else if (k == SCR_SEARCH) sk_build_search(sk_ids[i]) else if (k == SCR_PLANS) sk_build_plans(sk_ids[i]) else if (k == SCR_PLAN) sk_build_plan(sk_ids[i],
        a) else if (k == SCR_DAY1) sk_build_day1(sk_ids[i]) else if (k == SCR_BEGIN_BOOKS) sk_build_begin_books(sk_ids[i]) else if (k == SCR_BEGIN_CHAPTERS) sk_build_begin_chapters(sk_ids[i],
        a) else if (k == SCR_NEW_RIBBON) sk_build_new_ribbon(sk_ids[i]) else if (k == SCR_RIBBON) sk_build_ribbon(sk_ids[i],
        a);
    ui_write()
}

// A screen of kind and arg shown: pushed over the one on top, or presented
// (over the reader, the others closed).
sk_open(kind: int, arg: int, push: bool) {
    if (!push) sk_n = 0;
    if (sk_n >= SK_SCREENS_MOST) return;
    if (kind == SCR_GOTO) {
        sk_q_n = 0;
        sk_goto_recent()
    }
    if (kind == SCR_DAY1) {
        // (Begin At the reader's chapter.)
        bg_c = (if (sk_c >= 0 && sk_c < chapters) sk_c else 0);
        bg_v = 0;
        bg_f = 0;
        bg_owner = 2
    }
    if (kind == SCR_SEARCH) {
        sk_search_book = (if (sk_c >= 0 && sk_c < chapters) ch_book[sk_c] else 0);
        sk_run_search();
        sk_search_shown = (if (sk_sq_n == 0) 2 else 1)
    }
    sk_ids[sk_n] = sk_next_id;
    sk_kinds[sk_n] = kind;
    sk_args[sk_n] = arg;
    sk_next_id = sk_next_id + 1;
    sk_n = sk_n + 1;
    sk_build(sk_top());
    ui_effect(if (push) "push" else "present", sk_ids[sk_top()], -1)
}

// Every screen shown made again (a setting changed what they say).
sk_update_all() {
    for i in 0..sk_n {
        sk_build(i);
        ui_effect("update", sk_ids[i], -1)
    }
}

// The screens from i up let go (closed by the skin, or the sheet gone):
// what Search searched for kept first among the recent searches.
sk_closing(i: int) {
    for j in i..sk_n
        if (sk_kinds[j] == SCR_SEARCH) sk_remember_search();
    sk_n = i
}

sk_dismiss() {
    sk_n = 0;
    ui_effect("dismiss", -1, -1)
}

// Go To (DESIGN.md Â§3.2, Â§11.2.1): the host's ribbons and plan, the
// places read lately (not the chapter read, nor one a ribbon shows) and
// Show All, then the books by testament, opened at the one read. With a
// query typed: the reference it is (a row to go there) and the books whose
// names it begins.
sk_build_goto(id: int) {
    ui_begin(id, SCR_GOTO, 0, "Go To");
    ui_set_search("Book, chapter or verse \â\€\” \â\€\œjn 3:16\â\€\");
    if (sk_q_n > 0) {
        sk_build_goto_query();
        return
    }
    if (sk_has_ribbons) {
        ui_host_section(HOST_RIBBONS);
        ui_host_section(HOST_PLAN)
    }
    n: int = sk_recent_n;
    if (n > 0) {
        ui_section("Recent", "");
        for j in 0..n {
            c: int = sk_recent_c[j];
            v: int = sk_recent_v[j];
            ui_row(UI_ITEM, ACT_PLACE, c * 1000 + v);
            fbuf_n = 0;
            fput_ref(c, v, v);
            ui_set_title_fbuf();
            fbuf_n = 0;
            fput_opening_words(c, v, 40);
            ui_set_detail_fbuf();
            ui_set_scripture();
            ui_set_icon("clock.arrow.circlepath");
            ui_set_icon_faint()
        }
        if (sk_recent_more) {
            ui_row(UI_ITEM, ACT_OPEN, OPEN_HISTORY);
            ui_set_title("Show All");
            ui_set_tinted();
            ui_set_acc(ACC_MORE)
        }
    }
    here: int = if (sk_c >= 0 && sk_c < chapters) ch_book[sk_c] else -1;
    for b in 0..books {
        if (b == 0) ui_section("Old Testament", "");
        if (b == 39) ui_section("New Testament", "");
        sk_book_row(b, here);
        // (Not when Recent shows and the book is near the top.)
        if (b == here && !(n > 0 && b < 6)) ui_set_focus()
    }
}

// Go To's Recent, as it opens (kept while it is shown, as its rows are
// changed under it only by what it says: a ribbon deleted, say, doesn't
// bring one back): the places, and whether History has more.
sk_recent_c: []int = new int[4](0);

sk_recent_v: []int = new int[4](0);

sk_recent_n: int = 0;

sk_recent_more: bool = false;

sk_goto_recent() {
    n: int = 0;
    i: int = hs_n - 1;
    while (i >= 0 && n < len(sk_recent_c)) {
        c: int = visits[i].chapter;
        seen: bool = c == sk_c;
        for k in 0..sk_listed_n
            if (sk_listed_c[k] == c) seen = true;
        for j in 0..n
            if (sk_recent_c[j] == c) seen = true;
        if (!seen) {
            sk_recent_c[n] = c;
            sk_recent_v[n] = (if (visits[i].exact) visits[i].verse else 0);
            n = n + 1
        }
        i = i - 1
    }
    sk_recent_n = n;
    sk_recent_more = hs_n > 4 && n > 0
}

// What is typed in Go To's field.
sk_q: []i8 = new i8[256](0i8);

sk_q_n: int = 0;

// A book's row: its name and chapters (the one read, stronger).
sk_book_row(b: int, here: int) {
    ui_row(UI_ITEM, ACT_BOOK, b);
    fbuf_n = 0;
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    ui_set_title_fbuf();
    fput_str(", ");
    fput_int(book_count[b]);
    fput_str(if (book_count[b] == 1) " chapter" else " chapters");
    ui_set_label_fbuf();
    fbuf_n = 0;
    fput_int(book_count[b]);
    ui_set_detail_fbuf();
    ui_set_value_detail();
    if (b == here) {
        ui_set_strong();
        ui_set_tinted()
    }
    if (book_count[b] > 1) ui_set_acc(ACC_MORE)
}

// The books whose names the query begins (exact short names first), into
// sk_found; with parse_ref's reference made again after (book_begins uses
// its buffer), the reference's own book left out if it is the book alone.
sk_found: []int = new int[8](0);

sk_found_n: int = 0;

sk_ref: bool = false;

sk_query_books() {
    sk_ref = parse_ref(sk_q, sk_q_n);
    sk_found_n = 0;
    // (The name typed, before its numbers.)
    name_n: int = sk_q_n;
    seen_letter: bool = false;
    for i in 0..sk_q_n {
        k: int = sk_q[i] as int;
        if (is_letter(k)) seen_letter = true;
        if (seen_letter && is_digit(k) && name_n == sk_q_n) name_n = i
    }
    for pass in 0..2 {
        for b in 0..books {
            if (sk_found_n < len(sk_found) && book_begins(b, sk_q, name_n)) {
                if (book_alias_exact(b) == (pass == 0)) {
                    sk_found[sk_found_n] = b;
                    sk_found_n = sk_found_n + 1
                }
            }
        }
    }
    if (sk_ref && ref_chapter < 0 && sk_found_n == 1 && sk_found[0] == ref_book) sk_found_n = 0;
    sk_ref = parse_ref(sk_q, sk_q_n)
}

sk_build_goto_query() {
    sk_query_books();
    ui_set_empty("magnifyingglass", "No Matches", "");
    here: int = if (sk_c >= 0 && sk_c < chapters) ch_book[sk_c] else -1;
    if (sk_ref) {
        ui_section("Go To", "");
        ui_row(UI_ITEM, ACT_GOTO_REF, 0);
        ui_set_icon("arrow.right.circle.fill");
        ui_set_strong();
        b: int = ref_book;
        if (ref_chapter < 0) {
            fbuf_n = 0;
            fput_bytes(bsb, book_name_start(b), book_name_end(b));
            ui_set_title_fbuf();
            fbuf_n = 0;
            fput_int(book_count[b]);
            fput_str(if (book_count[b] == 1) " chapter" else " chapters");
            ui_set_detail_fbuf();
            ui_set_acc(ACC_MORE)
        } else {
            c: int = chapter_of(b, ref_chapter);
            fbuf_n = 0;
            if (ref_verse > 0) {
                fput_ref(c, ref_verse, if (ref_verse_end > 0) ref_verse_end else ref_verse);
                ui_set_title_fbuf();
                fbuf_n = 0;
                fput_opening_words(c, ref_verse, 60);
                ui_set_detail_fbuf();
                ui_set_scripture()
            } else {
                fput_ref(c, 0, 0);
                ui_set_title_fbuf();
                fbuf_n = 0;
                fput_str("Chapter ");
                fput_int(ref_chapter);
                fput_str(" \Â\· ");
                fput_int(ch_verses[c]);
                fput_str(" verses");
                ui_set_detail_fbuf()
            }
        }
    }
    if (sk_found_n > 0) {
        ui_section("Books", "");
        for j in 0..sk_found_n sk_book_row(sk_found[j], here)
    }
}

// The query typed in screen id's field (bytes b to e of buf): the screen
// made again as it is typed.
sk_query(
    id: int,
    buf: []i8,
    b: int,
    e: int
) {
    i: int = sk_find(id);
    if (i < 0) return;
    if (sk_kinds[i] == SCR_SEARCH) {
        sk_search_typed(id, buf, b, e);
        return
    }
    sk_q_n = 0;
    for x in b..e {
        if (sk_q_n < len(sk_q)) {
            sk_q[sk_q_n] = buf[x];
            sk_q_n = sk_q_n + 1
        }
    }
    sk_build(i);
    ui_effect("refill", id, -1)
}

// Return in screen id's field: its first suggestion (the reference, else
// the first book).
sk_submit(id: int) {
    i: int = sk_find(id);
    if (i >= 0 && sk_kinds[i] == SCR_SEARCH) {
        // (Kept as a recent search; the keyboard put away.)
        sk_remember_search();
        ui_effect("blur", id, -1);
        return
    }
    if (i < 0 || sk_q_n == 0) return;
    sk_query_books();
    if (sk_ref) sk_go_ref() else if (sk_found_n > 0) sk_pick_book(sk_found[0])
}

// The reference typed, gone to (a book alone: its chapters).
sk_go_ref() {
    if (!sk_ref) return;
    if (ref_chapter < 0) sk_pick_book(ref_book) else sk_goto(chapter_of(ref_book,
        ref_chapter), if (ref_verse > 0) ref_verse else 0)
}

// ---- Reading Plans (DESIGN.md Â§16.11.2) ----
// The plans followed (in the order started; only with one), each its day
// today and what it reads, checked once today's is read; the plans not
// followed, in Reading Plans' order (a listed one whose file is missing
// left out), each its length; and From a Book's A Chapter a Day. (The
// host makes the plans: plans.l8's plans_make.)
sk_build_plans(id: int) {
    ui_begin(id, SCR_PLANS, 0, "Reading Plans");
    today: int = sk_today_now();
    if (fw_n > 0) ui_section("Following", "");
    for r in 0..fw_n {
        p: int = fw_plan[r];
        ui_row(UI_ITEM, ACT_PLAN, p);
        fbuf_n = 0;
        fput_plan_name(p);
        ui_set_title_fbuf();
        n: int = plan_today_of(r, today);
        fbuf_n = 0;
        fput_str("Day ");
        fput_int(n);
        fput_str(" \Â\· ");
        fput_day(plan_day(p, n));
        ui_set_detail_fbuf();
        ui_set_lines(1);
        ui_set_acc(if (day_state(plan_day(p, n)) == 2) ACC_DONE else ACC_MORE)
    }
    ui_section("", "");
    for i in 0..PLANS {
        p: int = plan_order[i];
        if (plan_lengths[p] > 0 && plan_slot(p) < 0) {
            ui_row(UI_ITEM, ACT_PLAN, p);
            fbuf_n = 0;
            fput_plan_name(p);
            ui_set_title_fbuf();
            fbuf_n = 0;
            fput_int(plan_lengths[p]);
            fput_str(" days \Â\· about ");
            fput_int(plan_per_day(p));
            fput_str(if (plan_per_day(p) == 1) " chapter a day" else " chapters a day");
            ui_set_detail_fbuf();
            ui_set_lines(1);
            ui_set_acc(ACC_MORE)
        }
    }
    ui_section("From a Book", "");
    ui_row(UI_ITEM, ACT_OPEN, OPEN_DAY1);
    ui_set_title("A Chapter a Day");
    ui_set_detail("One chapter a day through a book you choose");
    ui_set_lines(1);
    ui_set_acc(ACC_MORE)
}

// ---- a plan's days (DESIGN.md Â§16.11.3) ----
// Its description; Start Plan or Stop Plan at its foot; a plan followed's
// reminder; then its days by week (A Chapter a Day's, Days), each a
// circle (read, partly, not; a plan not followed, dimmed and inert), its
// passages, and Today. Opened at day sk_plan_focus (0: the top), selected
// if sk_plan_select.
sk_plan_focus: int = 0;

sk_plan_select: bool = false;

sk_build_plan(id: int, p: int) {
    fbuf_n = 0;
    fput_plan_name(p);
    ui_begin(id, SCR_PLAN, p, "");
    ui_set_screen_title_fbuf();
    fbuf_n = 0;
    fput_plan_blurb(p);
    ui_set_intro_fbuf();
    i: int = plan_slot(p);
    following: bool = i >= 0;
    if (following) ui_set_toolbar("Stop Plan", ACT_PLAN_STOP, p, UI_TOOL_DESTRUCTIVE) else ui_set_toolbar("Start Plan",
        ACT_PLAN_START, p, UI_TOOL_PROMINENT);
    if (following && sk_has_reminders) ui_host_section(HOST_REMINDER);
    today: int = if (following) plan_today_p(p, sk_today_now()) else -1;
    n: int = plan_lengths[p];
    for d in 1..n + 1 {
        if (p == PLAN_DAY1 && d == 1) ui_section("Days", "") else if (p != PLAN_DAY1 && d % 7 == 1) {
            ui_section("", "");
            fbuf_n = 0;
            fput_str("Week ");
            fput_int(d / 7 + 1);
            ui_set_header_fbuf()
        }
        di: int = plan_day(p, d);
        state: int = if (following) day_state(di) else 0;
        ui_row(UI_ITEM, ACT_DAY, d);
        fbuf_n = 0;
        fput_str("Day ");
        fput_int(d);
        ui_set_title_fbuf();
        fbuf_n = 0;
        fput_day(di);
        ui_set_detail_fbuf();
        ui_set_circle(state, ACT_DAY_MARK, !following);
        if (d == today) {
            fbuf_n = 0;
            fput_str("Today");
            ui_set_trailing_fbuf();
            ui_set_trailing_tinted()
        }
        fbuf_n = 0;
        fput_str("Day ");
        fput_int(d);
        fput_str(", ");
        fput_day_spoken(di);
        if (d == today) fput_str(", Today");
        fput_str(", ");
        fput_str(if (state == 2) "read" else if (state == 1) "partly read" else "not read");
        ui_set_label_fbuf();
        if (d == sk_plan_focus) {
            if (sk_plan_select) ui_set_focus_selected() else ui_set_focus()
        }
    }
}

// Plan p's days shown (at day d; selected, select): pushed, or presented.
sk_open_plan(
    p: int,
    d: int,
    select: bool,
    push: bool
) {
    sk_plan_focus = d;
    sk_plan_select = select;
    sk_open(SCR_PLAN, p, push)
}

// Day d of plan p marked read, or not (its circle): the host keeps it
// (marked: the plan's slot and the day) and the screens are made again.
sk_day_mark(p: int, d: int) {
    i: int = plan_slot(p);
    if (i < 0 || d < 1 || d > plan_lengths[p]) return;
    di: int = plan_day(p, d);
    mark_day(di, day_state(di) != 2, time(0));
    ui_effect("marked", i, d);
    sk_update_all()
}

// ---- Begin At (New Ribbon's Place, A Chapter a Day's Begin At) ----
// The chapter chosen, the verse and how far into it while neither row has
// changed (else 0), and whose rows they are (1 New Ribbon, 2 A Chapter a
// Day).
bg_c: int = 0;

bg_v: int = 0;

bg_f: int = 0;

bg_owner: int = 0;

// Book and Chapter: the values chosen ("1:21" with a verse kept); a
// one-chapter book's Chapter dimmed, with nothing to choose.
sk_begin_rows() {
    b: int = ch_book[bg_c];
    ui_row(UI_ITEM, ACT_BEGIN_BOOK, 0);
    ui_set_title("Book");
    fbuf_n = 0;
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    ui_set_detail_fbuf();
    ui_set_value_detail();
    ui_set_acc(ACC_MORE);
    ui_row(UI_ITEM, ACT_BEGIN_CHAPTER, 0);
    ui_set_title("Chapter");
    fbuf_n = 0;
    fput_int(ch_num[bg_c]);
    if (bg_v >= 2) {
        fput(58);
        fput_int(bg_v)
    }
    ui_set_detail_fbuf();
    ui_set_value_detail();
    if (book_count[b] == 1) ui_set_disabled(true) else ui_set_acc(ACC_MORE)
}

// Begin At's Book: Go To's books by testament, the one chosen checked and
// shown first; a tap chooses it (at its chapter 1).
sk_build_begin_books(id: int) {
    ui_begin(id, SCR_BEGIN_BOOKS, 0, "Book");
    here: int = ch_book[bg_c];
    for b in 0..books {
        if (b == 0) ui_section("Old Testament", "");
        if (b == 39) ui_section("New Testament", "");
        ui_row(UI_ITEM, ACT_BEGIN_CHOSEN_BOOK, b);
        fbuf_n = 0;
        fput_bytes(bsb, book_name_start(b), book_name_end(b));
        ui_set_title_fbuf();
        fbuf_n = 0;
        fput_int(book_count[b]);
        ui_set_detail_fbuf();
        ui_set_value_detail();
        if (b == here) {
            ui_set_acc(ACC_CHECK);
            ui_set_focus_middle()
        }
    }
}

// Begin At's Chapter: book b's chapters, the one chosen checked (on an
// iPhone, its grid).
sk_build_begin_chapters(id: int, b: int) {
    ui_begin(id, SCR_BEGIN_CHAPTERS, b, "Chapter");
    for n in 1..book_count[b] + 1 {
        c: int = book_first[b] + n - 1;
        ui_row(UI_ITEM, ACT_BEGIN_CHOSEN_CHAPTER, c);
        fbuf_n = 0;
        fput_str(if (book_is(b, "PSA")) "Psalm " else "Chapter ");
        fput_int(n);
        ui_set_title_fbuf();
        if (c == bg_c) {
            ui_set_acc(ACC_CHECK);
            ui_set_focus()
        }
    }
}

// A chapter chosen in Begin At (its top): the chooser put away, the screen
// under it made again ("chosen": New Ribbon's name to follow it).
sk_begin_chosen(at: int, c: int) {
    if (c < 0 || c >= chapters) return;
    bg_c = c;
    bg_v = 0;
    bg_f = 0;
    sk_n = at;
    ui_effect("chosen", bg_owner, -1);
    ui_effect("pop", -1, -1);
    sk_update_all()
}

// A Chapter a Day (DESIGN.md Â§11.3.3): Begin At, the plan it makes
// ("Romans, a Chapter a Day", "Romans 3â€“16 Â· 14 days"), and Start Plan
// (off with fewer than 2 days left in the book, or that one followed
// already: another book's is a plan of its own, Â§16.11.1).
sk_build_day1(id: int) {
    ui_begin(id, SCR_DAY1, 0, "A Chapter a Day");
    ui_section("Begin At", "");
    sk_begin_rows();
    ui_section("", "");
    b: int = ch_book[bg_c];
    ui_row(UI_ITEM, 0, 0);
    fbuf_n = 0;
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    fput_str(if (book_is(b, "PSA")) ", a Psalm a Day" else ", a Chapter a Day");
    ui_set_title_fbuf();
    fbuf_n = 0;
    n: int = day1_days(bg_c);
    if (n == 0) fput_str("Choose an earlier chapter.") else {
        fput_bytes(bsb, book_name_start(b), book_name_end(b));
        fput(32);
        fput_int(ch_num[bg_c]);
        fput_str("\â\€\“");
        fput_int(book_count[b]);
        fput_str(" \Â\· ");
        fput_int(n);
        fput_str(" days")
    }
    ui_set_detail_fbuf();
    followed: bool = false;
    for i in 0..fw_n
        if (plan_is_day1(fw_plan[i]) && pl_day1_c[fw_plan[i]] == bg_c) followed = true;
    ui_set_toolbar("Start Plan", ACT_DAY1_START, 0, if (n > 0 && !followed) UI_TOOL_PROMINENT else UI_TOOL_OFF)
}

// ---- New Ribbon (DESIGN.md Â§11.2.3) and a ribbon's own (Â§11.2.4) ----
// New Ribbon's name as typed, and its color.
sk_nr_name: []i8 = new i8[160](0i8);

sk_nr_name_n: int = 0;

sk_nr_color: int = 0;

// New Ribbon at chapter c, verse v and f thousandths of an em into it:
// pushed over the screen up (in Go To), or presented (from the title).
sk_new_ribbon(
    c: int,
    v: int,
    f: int,
    push: bool
) {
    if (c < 0 || c >= chapters || rb_n >= RB_MOST) return;
    bg_c = c;
    bg_v = v;
    bg_f = f;
    bg_owner = 1;
    sk_nr_name_n = 0;
    sk_nr_color = color_default();
    sk_open(SCR_NEW_RIBBON, 0, push)
}

// The ribbons' colors as a row (the screen's theme's), color k chosen.
sk_swatches_row(action: int, arg: int, k: int) {
    ui_row(UI_CUSTOM, action, arg);
    ui_set_custom(CUSTOM_SWATCHES);
    fbuf_n = 0;
    th: int = theme_now(clamp_index(pref("theme", 0), len(t_bg)), sk_dark);
    for j in 0..RB_COLORS {
        if (j > 0) fput(124);
        fput_str(ribbon_hex(j, th, theme_dark(th, sk_dark)))
    }
    ui_rows[ui_last()].options = ui_put_fbuf();
    fbuf_n = 0;
    for j in 0..RB_COLORS {
        if (j > 0) fput(124);
        fput_str(rb_color_names[j])
    }
    ui_set_detail_fbuf();
    ui_rows[ui_last()].value = k
}

// Its name (the place's default as the placeholder: "Mark", "Romans
// (2)"), Color, and Place (Begin At's rows); Add.
sk_build_new_ribbon(id: int) {
    ui_begin(id, SCR_NEW_RIBBON, 0, "New Ribbon");
    ui_set_confirm("Add", ACT_NR_ADD);
    ui_section("", "A ribbon keeps your place, and moves on as you read from it.");
    ui_row(UI_FIELD, ACT_NR_NAME, 0);
    name_default(bg_c);
    fbuf_n = 0;
    fput_bytes(nm_buf, 0, nm_n);
    ui_set_title_fbuf();
    fbuf_n = 0;
    fput_bytes(sk_nr_name, 0, sk_nr_name_n);
    ui_set_detail_fbuf();
    fbuf_n = 0;
    fput_str("Name");
    ui_set_label_fbuf();
    ui_set_field_go();
    ui_set_focus();
    ui_section("Color", "");
    sk_swatches_row(ACT_NR_COLOR, 0, sk_nr_color);
    ui_section("Place", "");
    sk_begin_rows()
}

// A ribbon's own (rid, its id): Name, Color, Place (where it is, and when
// it was read there; a tap opens it) and Delete Ribbon.
sk_build_ribbon(id: int, rid: int) {
    ui_begin(id, SCR_RIBBON, rid, "");
    i: int = rb_index(rid);
    if (i < 0) return;
    fbuf_n = 0;
    fput_ribbon_name(i);
    ui_set_screen_title_fbuf();
    ui_section("Name", "");
    ui_row(UI_FIELD, ACT_RIBBON_RENAME, rid);
    ui_set_detail_fbuf();
    fbuf_n = 0;
    fput_str("Name");
    ui_set_label_fbuf();
    ui_section("Color", "");
    sk_swatches_row(ACT_RIBBON_COLOR, rid, rb_color[i]);
    ui_section("Place", "");
    ui_row(UI_ITEM, ACT_RIBBON_OPEN, rid);
    fbuf_n = 0;
    fput_ribbon_place(i);
    ui_set_title_fbuf();
    fbuf_n = 0;
    fput_ribbon_read(i, time(0), sk_tz);
    ui_set_detail_fbuf();
    ui_section("", "");
    ui_row(UI_BUTTON, ACT_RIBBON_DELETE, rid);
    ui_set_title("Delete Ribbon");
    ui_set_destructive()
}

sk_ribbons_kept() {
    kept: fn(what: int) = sk_host.save_kept;
    kept(SK_KEPT_RIBBONS)
}

// Words typed in screen id's field, its editing ended (bytes b to e of
// buf): the field's action with them.
sk_text(
    id: int,
    action: int,
    arg: int,
    buf: []i8,
    b: int,
    e: int
) {
    at: int = sk_find(id);
    if (at < 0) return;
    if (action == ACT_NR_NAME) {
        sk_nr_name_n = 0;
        for x in b..e {
            if (sk_nr_name_n < len(sk_nr_name)) {
                sk_nr_name[sk_nr_name_n] = buf[x];
                sk_nr_name_n = sk_nr_name_n + 1
            }
        }
        return
    }
    if (action == ACT_RIBBON_RENAME) {
        // (An empty name gives the old one back; the title follows.)
        n: int = 0;
        for x in b..e {
            if (n < len(sk_nr_name)) {
                sk_rename_buf[n] = buf[x];
                n = n + 1
            }
        }
        if (ribbon_rename(arg, sk_rename_buf, n)) sk_ribbons_kept();
        sk_update_all()
    }
}

sk_rename_buf: []i8 = new i8[160](0i8);

// ---- Search (DESIGN.md Â§5) ----
// What is searched for (kept for the next time), in which scope (0 all, 1
// the Old Testament, 2 the New, 3 the book read as Search opened), whether
// it is a reference too (a row to go there), whether it was searched, and
// what was shown (1 results, 2 recent searches: a change cross-fades).
sk_sq: []i8 = new i8[256](0i8);

sk_sq_n: int = 0;

sk_scope: int = 0;

sk_search_book: int = 0;

sk_search_ref: bool = false;

sk_search_done: bool = false;

sk_search_shown: int = 0;

// The recent searches, newest first (8 kept; the host keeps them:
// SK_KEPT_SEARCHES).
SK_SEARCHES_MOST: int = 8;

sk_searches: []i8 = new i8[2048](0i8);

sk_search_len: []int = new int[8](0);

sk_searches_n: int = 0;

// (Search i's words into fbuf, for the host to keep.)
sk_search_words(i: int) {
    fbuf_n = 0;
    if (i >= 0 && i < sk_searches_n) fput_bytes(sk_searches, i * 256, i * 256 + sk_search_len[i])
}

// A search kept, last (the host's, as it begins).
sk_searches_add(b: []i8, n: int) {
    if (sk_searches_n >= SK_SEARCHES_MOST) return;
    sk_search_set(sk_searches_n, b, 0, n);
    sk_searches_n = sk_searches_n + 1
}

sk_search_set(
    i: int,
    b: []i8,
    from: int,
    n: int
) {
    m: int = if (n > 256) 256 else n;
    for x in 0..m sk_searches[i * 256 + x] = b[from + x];
    sk_search_len[i] = m
}

sk_search_is(i: int): bool {
    if (sk_search_len[i] != sk_sq_n) return false;
    for x in 0..sk_sq_n
        if (sk_searches[i * 256 + x] != sk_sq[x]) return false;
    true
}

// What was searched for, first among the recent searches.
sk_remember_search() {
    if (sk_sq_n == 0 || !sk_search_done) return;
    at: int = -1;
    for i in 0..sk_searches_n
        if (at < 0 && sk_search_is(i)) at = i;
    if (at < 0) at = (if (sk_searches_n < SK_SEARCHES_MOST) sk_searches_n else SK_SEARCHES_MOST - 1);
    if (at >= sk_searches_n) sk_searches_n = at + 1;
    i: int = at;
    while (i > 0) {
        sk_search_set(i, sk_searches, (i - 1) * 256, sk_search_len[i - 1]);
        i = i - 1
    }
    sk_search_set(0, sk_sq, 0, sk_sq_n);
    kept: fn(what: int) = sk_host.save_kept;
    kept(SK_KEPT_SEARCHES)
}

// The search, in its scope: the verses found (text.l8's hit_chapter and
// the rest), and whether it is a reference. (The version read; the BSB's
// under the ESV, at once, the ESV itself a tap away; the Hebrew and Greek
// by its letters, or Latin letters against each word's transliteration.)
sk_run_search() {
    sk_search_ref = false;
    sk_search_done = false;
    sk_esv_results = false;
    hit_count = 0;
    hit_more = false;
    if (sk_sq_n > 0) {
        sk_search_ref = parse_ref(sk_sq, sk_sq_n) && ref_chapter > 0;
        from: int = if (sk_scope == 2) 39 else if (sk_scope == 3) sk_search_book else 0;
        last: int = if (sk_scope == 1) 38 else if (sk_scope == 3) sk_search_book else 65;
        source: TextSource = ready_source(quote_base());
        if (text_cur == TEXT_ORIG) og_search(sk_sq, sk_sq_n, from, last) else source_search(&source,
            sk_sq, sk_sq_n, from, last);
        sk_search_done = true
    }
    // (A platform's results for what was searched before are gone.)
    ui_effect("searched", -1, -1)
}

// Whether the results end with "Search the ESV for ..." (or, under No
// Results, are it): under the ESV, once it is listed.
sk_esv_search_row(): bool {
    text_cur == TEXT_ESV && sk_esv_listed && sk_sq_n > 0 && sk_search_done
}

sk_build_search(id: int) {
    ui_begin(id, SCR_SEARCH, 0, "Search");
    ui_set_search("Search the Bible");
    ui_set_search_text(sk_sq, sk_sq_n);
    ui_search_wait = 200;
    ui_search_focus = true;
    ui_plain = true;
    // (Short titles, so none is cut off; the full names for VoiceOver.)
    b: int = sk_search_book;
    fbuf_n = 0;
    fput_str("All|OT|NT|");
    if (book_name_end(b) - book_name_start(b) > 10) {
        book_short(b);
        fput_bytes(short_name, 0, short_n)
    } else fput_bytes(bsb, book_name_start(b), book_name_end(b));
    at: int = fbuf_n;
    fput_str("All|Old Testament|New Testament|");
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    ui_set_scopes_fbuf(at, sk_scope);
    if (sk_sq_n == 0) {
        if (sk_searches_n == 0) {
            ui_set_empty("magnifyingglass", "Search the Bible", "Find words and phrases across all 66 books.");
            return
        }
        ui_section("Recent Searches", "");
        ui_set_section_button("Clear", ACT_SEARCHES_CLEAR);
        for i in 0..sk_searches_n {
            ui_row(UI_ITEM, ACT_RECENT_SEARCH, i);
            sk_search_words(i);
            ui_set_title_fbuf();
            ui_set_icon("clock.arrow.circlepath");
            ui_set_icon_faint()
        }
        return
    }
    if (sk_search_ref && parse_ref(sk_sq, sk_sq_n)) {
        ui_section("", "");
        ui_row(UI_ITEM, ACT_SEARCH_REF, 0);
        ui_set_icon("arrow.right.circle.fill");
        ui_set_strong();
        c: int = chapter_of(ref_book, ref_chapter);
        fbuf_n = 0;
        fput_str("Go to ");
        fput_ref(c, if (ref_verse > 0) ref_verse else 0, if (ref_verse_end > 0) ref_verse_end else ref_verse);
        ui_set_title_fbuf();
        fbuf_n = 0;
        fput_opening_words(c, ref_verse, 60);
        ui_set_detail_fbuf();
        ui_set_scripture()
    }
    if (sk_esv_results) {
        ui_host_section(HOST_ESV_RESULTS);
        return
    }
    esv_row: bool = sk_esv_search_row();
    if (hit_count > 0 || esv_row) {
        ui_section("", "");
        fbuf_n = 0;
        if (hit_count == 0) fput_str("No Results") else {
            fput_int(hit_count);
            if (hit_more) fput(43);
            fput_str(if (hit_count == 1) " verse in the " else " verses in the ");
            fput_str(text_abbrs[quote_base()])
        }
        ui_set_header_fbuf();
        source: TextSource = ready_source(quote_base());
        for i in 0..hit_count sk_hit_row(&source, i);
        if (esv_row) {
            ui_row(UI_ITEM, ACT_ESV_SEARCH, 0);
            fbuf_n = 0;
            fput_str("Search the ESV for \â\€\œ");
            fput_bytes(sk_sq, 0, sk_sq_n);
            fput_str("\â\€\");
            ui_set_title_fbuf();
            ui_set_tinted();
            ui_set_icon("globe");
            sk_words(SK_WORDS_ESV_SEARCH);
            if (fbuf_n > 0) ui_set_detail_fbuf()
        }
    }
    if (hit_count == 0 && !sk_search_ref && !esv_row) {
        fbuf_n = 0;
        fput_str("No Results for \â\€\œ");
        fput_bytes(sk_sq, 0, sk_sq_n);
        fput_str("\â\€\");
        ui_set_empty("magnifyingglass", "", "Check the spelling or try fewer words.");
        ui_set_empty_title_fbuf()
    }
}

// A verse found: its reference, and its words with what was searched for
// marked (begun nearer the first match, eight words before it, if it is
// far in).
sk_hit_row(source: *TextSource, i: int) {
    c: int = hit_chapter[i];
    v: int = hit_verse[i];
    ui_row(UI_ITEM, ACT_HIT, c * 1000 + v);
    ui_set_custom(CUSTOM_HIT);
    fbuf_n = 0;
    fput_ref(c, v, v);
    ui_set_title_fbuf();
    if (text_cur == TEXT_ORIG) og_match_ranges(c, v) else source_match_ranges(source,
        c, v);
    start: int = 0;
    if (mr_count > 0 && mr_begin[0] > 170) {
        words: int = 0;
        start = mr_begin[0];
        while (start > 0 && words < 9) {
            start = start - 1;
            if (vt[start] as int == 32) words = words + 1
        }
        if (vt[start] as int == 32) start = start + 1
    }
    fbuf_n = 0;
    lead: int = 0;
    if (start > 0) {
        fput_str("\â\€\¦ ");
        lead = 2
    }
    fput_bytes(vt, start, vt_n);
    ui_set_detail_fbuf();
    ui_set_scripture();
    for m in 0..mr_count {
        if (mr_begin[m] >= start) {
            b: int = lead + sk_utf16(vt, start, mr_begin[m]);
            ui_add_mark(b, b + sk_utf16(vt, mr_begin[m], mr_end[m]))
        }
    }
}

// How many UTF-16 units bytes p to e of s are.
sk_utf16(s: []i8, p: int, e: int): int {
    n: int = 0;
    for i in p..e {
        k: int = s[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    n
}

// Search's field typed in (as it rests): searched again; cleared, what was
// searched for kept first among the recent searches.
sk_search_typed(
    id: int,
    buf: []i8,
    b: int,
    e: int
) {
    i: int = sk_find(id);
    if (i < 0) return;
    if (e == b && sk_sq_n > 0) sk_remember_search();
    sk_sq_n = 0;
    for x in b..e {
        if (sk_sq_n < len(sk_sq)) {
            sk_sq[sk_sq_n] = buf[x];
            sk_sq_n = sk_sq_n + 1
        }
    }
    sk_search_again(i, false)
}

// Search made again for its query and scope (retext: its field to show
// the query, a recent search chosen).
sk_search_again(i: int, retext: bool) {
    sk_run_search();
    sk_build(i);
    if (retext) ui_effect("retext", sk_ids[i], -1);
    shown: int = if (sk_sq_n == 0) 2 else 1;
    ui_effect("refill", sk_ids[i], if (shown != sk_search_shown) 1 else 0);
    sk_search_shown = shown
}

// A scope chosen in screen id's field.
sk_scope_chosen(id: int, scope: int) {
    i: int = sk_find(id);
    if (i < 0 || sk_kinds[i] != SCR_SEARCH) return;
    sk_scope = (if (scope < 0 || scope > 3) 0 else scope);
    sk_search_again(i, false)
}

// A book chosen: its chapters (one: the reader there).
sk_pick_book(b: int) {
    if (b < 0 || b >= books) return;
    if (book_count[b] == 1) sk_goto(book_first[b], 0) else sk_open(SCR_CHAPTERS, b,
        true)
}

// A book's chapters: each its number and verses.
sk_build_chapters(id: int, b: int) {
    source: TextSource = text_source(text_cur);
    ui_begin(id, SCR_CHAPTERS, b, "");
    fbuf_n = 0;
    fput_bytes(source.data, source_book_name_start(&source, b), source_book_name_end(&source,
        b));
    ui_set_screen_title_fbuf();
    for n in 1..book_count[b] + 1 {
        c: int = book_first[b] + n - 1;
        ui_row(UI_ITEM, ACT_CHAPTER, c);
        fbuf_n = 0;
        fput_str(if (source_book_is(&source, b, "PSA")) "Psalm " else "Chapter ");
        fput_int(n);
        ui_set_title_fbuf();
        fbuf_n = 0;
        fput_int(ch_verses[c]);
        fput_str(if (ch_verses[c] == 1) " verse" else " verses");
        ui_set_detail_fbuf();
        ui_set_value_detail();
        if (c == sk_c) ui_set_acc(ACC_CHECK)
    }
}

// The versions: each its name, the one read checked.
// The versions (DESIGN.md Â§9.3.2): on this device, the original languages
// (the Hebrew and Greek, Â§14.11.2) and online (the ESV), each its name and
// a line about it, the one read checked.
sk_build_versions(id: int) {
    ui_begin(id, SCR_VERSIONS, 0, "Version");
    fbuf_n = 0;
    fput_str("On This ");
    fput_str(sk_device);
    ui_section("", "");
    ui_set_header_fbuf();
    for i in 0..len(sk_versions) sk_version_row(sk_versions[i]);
    if (sk_has_orig) {
        ui_section("Original Languages", "");
        sk_version_row(TEXT_ORIG)
    }
    if (sk_esv_listed) {
        ui_section("Online", "");
        fbuf_n = 0;
        fput_str("The ESV comes from Crossway\â\€\™s ESV API. Only the chapters you\â\€\™re reading are kept on this ");
        fput_str(sk_device);
        fput(46);
        ui_set_footer_fbuf();
        sk_version_row(TEXT_ESV)
    }
}

sk_version_row(t: int) {
    ui_row(UI_ITEM, ACT_VERSION, t);
    ui_set_title(text_names[t]);
    ui_set_detail(version_lines[t]);
    ui_set_small();
    if (t == text_cur) ui_set_acc(ACC_CHECK);
    // (Read as it is shown, its dots as pauses.)
    fbuf_n = 0;
    fput_str(text_names[t]);
    fput_str(", ");
    line: str = version_lines[t];
    i: int = 0;
    while (i < len(line)) {
        k: int = line[i] as int & 255;
        if (k == 194 && i + 1 < len(line) && (line[i + 1] as int & 255) == 183) {
            // (" Â· " as ", ".)
            if (fbuf_n > 0 && fbuf[fbuf_n - 1] as int == 32) fbuf_n = fbuf_n - 1;
            fput(44);
            i = i + 2
        } else {
            fput(k);
            i = i + 1
        }
    }
    ui_set_label_fbuf()
}

// History (DESIGN.md Â§8.3): the trail of chapters read (store.l8 keeps it),
// newest first, a section a day (Today, Yesterday, a weekday, then a date),
// each row its place, its first words and when; a row goes there, swiped
// away is deleted; Clear's menu clears it all.
sk_build_history(id: int) {
    ui_begin(id, SCR_HISTORY, 0, "History");
    ui_set_empty("clock.arrow.circlepath", "No History", "Places you read will appear here.");
    if (hs_n > 0) {
        ui_set_button("Clear");
        ui_command("Clear History", ACT_HISTORY_CLEAR, 0, true)
    }
    today: int = sk_local_day(time(0));
    day: int = -1;
    i: int = hs_n - 1;
    while (i >= 0) {
        d: int = sk_local_day(visits[i].time);
        if (d != day) {
            day = d;
            ui_section("", "");
            fbuf_n = 0;
            if (d == today) fput_str("Today") else if (d == today - 1) fput_str("Yesterday") else if (d > today - 7 && d < today) fput_str(weekday_names[weekday_of(d)]) else fput_date(d);
            ui_set_header_fbuf()
        }
        c: int = visits[i].chapter;
        v: int = if (visits[i].exact) visits[i].verse else 0;
        ui_row(UI_ITEM, ACT_VISIT, i);
        fbuf_n = 0;
        fput_ref(c, v, v);
        ui_set_title_fbuf();
        fbuf_n = 0;
        fput_opening_words(c, if (visits[i].verse > 0) visits[i].verse else 1, 50);
        ui_set_detail_fbuf();
        ui_set_scripture();
        fbuf_n = 0;
        fput_clock(visits[i].time + sk_tz);
        ui_set_trailing_fbuf();
        ui_set_delete(ACT_VISIT_DELETE);
        i = i - 1
    }
}

// The reading settings (DESIGN.md Â§6, as the iPhone has them): the
// version (and the Hebrew and Greek's own: its glosses and accents),
// Listen, the text's size, the theme, the font, the layout, what is shown,
// Help, while reading, and the acknowledgements. Rows a platform can't
// have (its host says) are left out; rows that open a screen still the
// platform's own say so (an open effect).
sk_build_settings(id: int) {
    ui_begin(id, SCR_SETTINGS, 0, "Reading");
    orig: bool = text_cur == TEXT_ORIG;
    ui_section("", "");
    ui_row(UI_ITEM, ACT_OPEN, OPEN_VERSIONS);
    ui_set_title("Version");
    ui_set_detail(text_abbrs[text_cur]);
    ui_set_value_detail();
    ui_set_acc(ACC_MORE);
    fbuf_n = 0;
    fput_str("Version, ");
    fput_str(text_names[text_cur]);
    ui_set_label_fbuf();
    ui_set_hint("Choose a translation");
    if (orig) {
        ui_row(UI_ITEM, ACT_OPEN, OPEN_GLOSSES);
        ui_set_title("Glosses");
        ui_set_detail(gloss_names[og_mode(if (sk_c >= 0 && sk_c < chapters && ch_book[sk_c] < 39) 1 else 0)]);
        ui_set_value_detail();
        ui_set_acc(ACC_MORE);
        ui_row(UI_TOGGLE, ACT_ACCENTS, 0);
        ui_set_title("Show Accents");
        ui_set_on(pref_on("origAccents", false))
    }
    fbuf_n = 0;
    fput_str(if (orig) "A word you haven\â\€\™t learned is glossed under its paragraph with the BSB\â\€\™s words for it there. Tap a gloss for the word." else "Study, the interlinear and the concordance always use the BSB.");
    ui_set_footer_fbuf();
    if (sk_has_listen) {
        ui_section("", "");
        ui_row(UI_BUTTON, ACT_LISTEN, 0);
        ui_set_custom(CUSTOM_LISTEN);
        ui_row(UI_CHOICE, ACT_LISTEN_RATE, 0);
        ui_set_title("Speed");
        ui_set_options("Slower|Normal|Faster", pref("listenRate", 1));
        ui_row(UI_ITEM, ACT_OPEN, OPEN_VOICE);
        ui_set_title("Voice");
        sk_words(SK_WORDS_VOICE);
        ui_set_detail_fbuf();
        ui_set_value_detail();
        if (orig) ui_set_faint() else ui_set_acc(ACC_MORE);
        sk_words(SK_WORDS_LISTEN_FOOTER);
        ui_set_footer_fbuf()
    }
    ui_section("", "");
    ui_row(UI_SLIDER, ACT_SIZE, 0);
    ui_set_title("Text Size");
    ui_set_range(0, len(size_steps) - 1, pref("sizeStep", 2));
    ui_set_custom(CUSTOM_SIZE);
    fbuf_n = 0;
    fput_str("Also follows the ");
    fput_str(sk_device);
    fput_str(" text size.");
    ui_set_detail_fbuf();
    ui_section("Theme", "");
    ui_row(UI_CHOICE, ACT_THEME, 0);
    ui_set_title("Theme");
    ui_set_options("Auto|Paper|White|Sepia|Night|Black", pref("theme", 0));
    ui_set_custom(CUSTOM_THEMES);
    if (len(sk_fonts) > 0) {
        ui_section("Font", "");
        for i in 0..len(sk_fonts) {
            ui_row(UI_ITEM, ACT_FONT, i);
            ui_set_title(sk_fonts[i]);
            ui_set_custom(CUSTOM_FONT);
            if (i == pref("font", 0)) ui_set_acc(ACC_CHECK)
        }
    }
    ui_section("Layout", "");
    ui_row(UI_CHOICE, ACT_SPACING, 0);
    ui_set_title("Line Spacing");
    ui_set_options("Compact|Normal|Relaxed", pref("spacing", 1));
    ui_row(UI_CHOICE, ACT_MARGINS, 0);
    ui_set_title("Margins");
    ui_set_options("Narrow|Normal|Wide", pref("margins", 1));
    ui_section("Show", "");
    for i in 0..len(sk_show_names) {
        ui_row(UI_TOGGLE, ACT_SHOW, i);
        ui_set_title(sk_show_titles[i]);
        ui_set_on(sk_show(i))
    }
    // (What the version can't show.)
    fbuf_n = 0;
    if (orig) fput_str("The Hebrew and Greek has no headings or footnotes, and doesn\â\€\™t mark the words of Jesus.") else if (!version_red[text_cur]) {
        fput_str("The ");
        fput_str(text_abbrs[text_cur]);
        fput_str(" doesn\â\€\™t mark the words of Jesus.")
    }
    ui_set_footer_fbuf();
    if (sk_has_manual) {
        ui_section("Help", "");
        ui_row(UI_ITEM, ACT_OPEN, OPEN_MANUAL);
        ui_set_title("Manual");
        ui_set_icon("book.closed");
        ui_set_acc(ACC_MORE)
    }
    if (sk_has_keep_on) {
        ui_section("While Reading", "The screen stays on while you read. It turns off as usual after 10 minutes without scrolling.");
        ui_row(UI_TOGGLE, ACT_KEEP_ON, 0);
        ui_set_title("Keep Screen On");
        ui_set_on(pref_on("keepScreenOn", false))
    }
    if (sk_has_acknowledgements) {
        ui_section("", "Berean Standard Bible \Â\· Public Domain");
        ui_row(UI_ITEM, ACT_OPEN, OPEN_ACKNOWLEDGEMENTS);
        ui_set_title("Acknowledgements");
        ui_set_acc(ACC_MORE)
    }
}

// ---- actions ----
sk_save() {
    f: fn() = sk_host.save_prefs;
    f()
}

sk_act(
    id: int,
    action: int,
    arg: int,
    value: int
) {
    at: int = sk_find(id);
    if (at < 0) return;
    // (The screens over it have gone: it is acted on.)
    sk_n = at + 1;
    if (action == ACT_BOOK) {
        sk_pick_book(arg);
        return
    }
    if (action == ACT_PLACE) {
        sk_goto(arg / 1000, arg % 1000);
        return
    }
    if (action == ACT_GOTO_REF) {
        sk_query_books();
        sk_go_ref();
        return
    }
    if (action == ACT_HIT) {
        sk_remember_search();
        sk_goto(arg / 1000, arg % 1000);
        return
    }
    if (action == ACT_SEARCH_REF) {
        sk_remember_search();
        if (parse_ref(sk_sq, sk_sq_n) && ref_chapter > 0) sk_goto(chapter_of(ref_book,
            ref_chapter), if (ref_verse > 0) ref_verse else 0);
        return
    }
    if (action == ACT_RECENT_SEARCH) {
        if (arg < 0 || arg >= sk_searches_n) return;
        sk_sq_n = sk_search_len[arg];
        for x in 0..sk_sq_n sk_sq[x] = sk_searches[arg * 256 + x];
        sk_search_again(at, true);
        return
    }
    if (action == ACT_SEARCHES_CLEAR) {
        sk_searches_n = 0;
        kept: fn(what: int) = sk_host.save_kept;
        kept(SK_KEPT_SEARCHES);
        sk_search_again(at, false);
        return
    }
    if (action == ACT_ESV_SEARCH) {
        ui_effect("esv_search", 1, -1);
        return
    }
    if (action == ACT_PLAN) {
        ui_effect("open", OPEN_PLAN, arg);
        return
    }
    if (action == ACT_DAY) {
        ui_effect("open", OPEN_DAY, sk_args[at] * 1000 + arg);
        return
    }
    if (action == ACT_DAY_MARK) {
        sk_day_mark(sk_args[at], arg);
        return
    }
    if (action == ACT_BEGIN_BOOK) {
        sk_open(SCR_BEGIN_BOOKS, 0, true);
        return
    }
    if (action == ACT_BEGIN_CHAPTER) {
        if (book_count[ch_book[bg_c]] > 1) sk_open(SCR_BEGIN_CHAPTERS, ch_book[bg_c],
            true);
        return
    }
    if (action == ACT_BEGIN_CHOSEN_BOOK) {
        if (arg >= 0 && arg < books) sk_begin_chosen(at, book_first[arg]);
        return
    }
    if (action == ACT_BEGIN_CHOSEN_CHAPTER) {
        sk_begin_chosen(at, arg);
        return
    }
    if (action == ACT_NR_COLOR) {
        if (value >= 0 && value < RB_COLORS) sk_nr_color = value;
        sk_build(at);
        ui_effect("refill", id, 0);
        return
    }
    if (action == ACT_NR_ADD) {
        // (The ribbon made, the placeholder's name if none is typed; the
        // host goes there, picks it up and says so.)
        rid: int = ribbon_make(sk_nr_name, sk_nr_name_n, bg_c, bg_v, bg_f, time(0));
        if (rid == 0) return;
        _k: bool = ribbon_set_color(rid, sk_nr_color);
        ui_effect("ribbon_added", rid, -1);
        return
    }
    if (action == ACT_RIBBON_COLOR) {
        if (ribbon_set_color(arg, value)) {
            sk_ribbons_kept();
            ui_effect("ribbon_color", arg, -1)
        }
        sk_update_all();
        return
    }
    if (action == ACT_RIBBON_OPEN) {
        i: int = rb_index(arg);
        if (i >= 0) ui_effect("ribbon_open", i, -1);
        return
    }
    if (action == ACT_RIBBON_DELETE) {
        // (Deleted, and popped: the screen under it made again.)
        ribbon_delete(arg);
        sk_ribbons_kept();
        sk_n = at;
        ui_effect("pop", -1, -1);
        sk_update_all();
        return
    }
    if (action == ACT_DAY1_START) {
        if (day1_days(bg_c) > 0) ui_effect("plan_start", PLAN_DAY1, -1);
        return
    }
    if (action == ACT_PLAN_START || action == ACT_PLAN_STOP) {
        // (The host's: a plan's file, its reminder, the day's reader.)
        ui_effect(if (action == ACT_PLAN_START) "plan_start" else "plan_stop", arg,
            -1);
        return
    }
    if (action == ACT_CHAPTER) {
        sk_goto(arg, 0);
        return
    }
    if (action == ACT_VISIT) {
        if (arg >= 0 && arg < hs_n) sk_goto(visits[arg].chapter, if (visits[arg].exact) visits[arg].verse else 0);
        return
    }
    if (action == ACT_VISIT_DELETE || action == ACT_HISTORY_CLEAR) {
        if (action == ACT_VISIT_DELETE) history_delete(arg) else hs_n = 0;
        kept: fn(what: int) = sk_host.save_kept;
        kept(SK_KEPT_HISTORY);
        sk_update_all();
        return
    }
    if (action == ACT_VERSION) {
        sk_use_version(arg);
        return
    }
    if (action == ACT_OPEN) {
        // (Versions is core's; the others, the platform's own.)
        if (arg == OPEN_VERSIONS) sk_open(SCR_VERSIONS, 0, true) else if (arg == OPEN_HISTORY) sk_open(SCR_HISTORY,
            0, true) else ui_effect("open", arg, -1);
        return
    }
    if (action == ACT_LISTEN) {
        ui_effect("listen", -1, -1);
        return
    }
    if (action == ACT_LISTEN_RATE || action == ACT_KEEP_ON) {
        if (action == ACT_LISTEN_RATE) set_pref("listenRate", value) else set_pref_on("keepScreenOn",
            value != 0);
        sk_save();
        ui_effect("settings", -1, -1);
        return
    }
    if (action == ACT_SIZE) set_pref("sizeStep", value) else if (action == ACT_THEME) set_pref("theme",
        value) else if (action == ACT_SPACING) set_pref("spacing", value) else if (action == ACT_MARGINS) set_pref("margins",
        value) else if (action == ACT_SHOW) set_pref_on(sk_show_names[arg], value != 0) else if (action == ACT_FONT) set_pref("font",
        arg) else if (action == ACT_ACCENTS) set_pref_on("origAccents", value != 0) else return;
    sk_save();
    sk_relayout();
    sk_update_all()
}

// The reader at chapter c, verse v, the screens put away (goto: the
// platform's own jump, which may put a sheet away its way).
sk_goto(c: int, v: int) {
    if (c < 0 || c >= chapters) return;
    sk_c = c;
    sk_v = v;
    sk_frac = 0;
    sk_n = 0;
    ui_effect("goto", c, v);
    sk_write_title();
    sk_keep_place();
    sk_save()
}

sk_keep_place() {
    set_pref("chapter", sk_c);
    set_pref("verse", sk_v);
    set_pref("verseOffset", sk_frac)
}

// Version t read, if it is loaded or can be.
sk_use_version(t: int) {
    if (t == text_cur) return;
    host_switch: ?fn(t: int): bool = sk_host.switch_version;
    if (host_switch != null) {
        if (!host_switch(t)) return
    } else if (!sk_switch_version(t)) return;
    set_pref("version", t);
    sk_save();
    ui_effect("reader", chapters, -1);
    sk_relayout();
    sk_write_title();
    sk_update_all()
}

// Version t read: loaded, if it is not, and made the current one.
sk_switch_version(t: int): bool {
    if (t < 0 || t >= TEXT_PIN) return false;
    if (t != text_cur && !tx_ready[t]) {
        sk_want_text = t;
        return false
    }
    text_use(t);
    true
}

// ---- the skin's lines ----
// The app begun: the settings (prefs_parse'd by the host) applied, the
// version read and the place kept, the look, the reader and its place.
sk_start() {
    t: int = pref("version", 0);
    if (t != text_cur && t >= 0 && t < TEXT_PIN) {
        if (tx_ready[t]) text_use(t) else sk_want_text = t
    }
    sk_apply_prefs();
    sk_c = pref("chapter", book_first[42]);
    if (sk_c < 0 || sk_c >= chapters) sk_c = 0;
    sk_v = pref("verse", 0);
    sk_frac = pref("verseOffset", 0);
    sk_write_look();
    ui_effect("reader", chapters, -1);
    ui_effect("jump", sk_c, sk_v);
    sk_write_title()
}

// A field's number at b in line (to e): where it ends, in sk_num_end.
sk_num_end: int = 0;

sk_num(line: []i8, b: int, e: int): int {
    i: int = b;
    while (i < e && line[i] as int == 32) i = i + 1;
    neg: bool = i < e && line[i] as int == 45;
    if (neg) i = i + 1;
    n: int = 0;
    while (i < e && line[i] as int >= 48 && line[i] as int <= 57) {
        n = n * 10 + line[i] as int - 48;
        i = i + 1
    }
    sk_num_end = i;
    if (neg) -n else n
}

sk_word_is(
    line: []i8,
    b: int,
    e: int,
    word: str
): bool {
    if (e - b < len(word)) return false;
    for i in 0..len(word)
        if (line[b + i] != word[i]) return false;
    e - b == len(word) || line[b + len(word)] as int == 32
}

// One line the skin sent (bytes b to e of line, without its newline).
sk_line(line: []i8, b: int, e: int) {
    if (sk_word_is(line, b, e, "start")) {
        sk_width = sk_num(line, b + 5, e);
        sk_height = sk_num(line, sk_num_end, e);
        sk_density = sk_num(line, sk_num_end, e);
        sk_dark = sk_num(line, sk_num_end, e) != 0;
        sk_start()
    } else if (sk_word_is(line, b, e, "want")) sk_write_chapter(sk_num(line, b + 4,
        e)) else if (sk_word_is(line, b, e, "place")) {
        c: int = sk_num(line, b + 5, e);
        v: int = sk_num(line, sk_num_end, e);
        f: int = sk_num(line, sk_num_end, e);
        if (c >= 0 && c < chapters) {
            was: int = sk_c;
            sk_c = c;
            sk_v = v;
            sk_frac = f;
            sk_keep_place();
            if (c != was) sk_write_title()
        }
    } else if (sk_word_is(line, b, e, "act")) {
        id: int = sk_num(line, b + 3, e);
        action: int = sk_num(line, sk_num_end, e);
        arg: int = sk_num(line, sk_num_end, e);
        value: int = sk_num(line, sk_num_end, e);
        sk_act(id, action, arg, value)
    } else if (sk_word_is(line, b, e, "query")) {
        id: int = sk_num(line, b + 5, e);
        at: int = if (sk_num_end < e) sk_num_end + 1 else e;
        sk_query(id, line, at, e)
    } else if (sk_word_is(line, b, e, "text")) {
        id: int = sk_num(line, b + 4, e);
        action: int = sk_num(line, sk_num_end, e);
        arg: int = sk_num(line, sk_num_end, e);
        at: int = if (sk_num_end < e) sk_num_end + 1 else e;
        sk_text(id, action, arg, line, at, e)
    } else if (sk_word_is(line, b, e, "submit")) sk_submit(sk_num(line, b + 6, e)) else if (sk_word_is(line,
        b, e, "scope")) {
        id: int = sk_num(line, b + 5, e);
        sk_scope_chosen(id, sk_num(line, sk_num_end, e))
    } else if (sk_word_is(line, b, e, "tap")) {
        if (sk_word_is(line, b + 4, e, "goto")) sk_open(SCR_GOTO, 0, false) else if (sk_word_is(line,
            b + 4, e, "versions")) sk_open(SCR_VERSIONS, 0, false) else if (sk_word_is(line,
            b + 4, e, "settings")) sk_open(SCR_SETTINGS, 0, false) else if (sk_word_is(line,
            b + 4, e, "history")) sk_open(SCR_HISTORY, 0, false) else if (sk_word_is(line,
            b + 4, e, "search")) sk_open(SCR_SEARCH, 0, false)
    } else if (sk_word_is(line, b, e, "closed")) {
        i: int = sk_find(sk_num(line, b + 6, e));
        if (i >= 0) sk_closing(i)
    } else if (sk_word_is(line, b, e, "dark")) {
        sk_dark = sk_num(line, b + 4, e) != 0;
        sk_write_look();
        ui_effect("relayout", -1, -1);
        ui_effect("jump", sk_c, sk_v)
    } else if (sk_word_is(line, b, e, "away")) sk_save()
}

// Each line of bytes b to e (newline-ended), in turn.
sk_lines(buf: []i8, b: int, e: int) {
    p: int = b;
    for i in b..e {
        if (buf[i] as int == 10) {
            sk_line(buf, p, i);
            p = i + 1
        }
    }
}
