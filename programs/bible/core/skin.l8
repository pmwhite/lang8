    }
}

// ---- Memory's lists (DESIGN.md Â§13.2.2, Â§13.4.1) ----
// Add Passage: the reference typed (parsed as it is typed: the footer says
// what it is, and Add is on once it may be added), its version, and its
// words.
sk_mm_add_text: []i8 = new i8[256](0i8);

sk_mm_add_n: int = 0;

sk_mm_add_ver: int = 0;

sk_mm_parsed: bool = false;

sk_mm_ok: bool = false;

sk_mm_parse() {
    sk_mm_parsed = sk_mm_add_n > 0 && parse_range(sk_mm_add_text, sk_mm_add_n);
    sk_mm_ok = sk_mm_parsed && rg_verses <= MEM_VERSES
}

sk_build_mm_add(id: int) {
    ui_begin(id, SCR_MM_ADD, 0, "Add Passage");
    sk_mm_parse();
    ui_set_confirm("Add", ACT_MM_ADD_DONE);
    // (Why the ESV can't keep it, if it can't.)
    refusal: bool = false;
    if (sk_mm_ok && sk_mm_add_ver == TEXT_ESV) {
        refusal = mm_esv_refusal_words(rg_c1, rg_v1, rg_c2, rg_v2) != 0;
        if (!refusal) fbuf_n = 0;
        sk_note_n = fbuf_n;
        for x in 0..fbuf_n sk_note[x] = fbuf[x];
        if (refusal) sk_mm_ok = false
    }
    if (!sk_mm_ok) ui_set_confirm_off();
    fbuf_n = 0;
    if (!sk_mm_parsed) fput_str("Not a passage yet.") else {
        sk_mm_parse();
        fput_range(rg_c1, rg_v1, rg_c2, rg_v2);
        fput_str(" \Â\· ");
        fput_int(rg_verses);
        fput_str(if (rg_verses == 1) " verse" else " verses");
        if (rg_verses > MEM_VERSES) fput_str(". A passage is up to 40 verses.");
        if (refusal) {
            fput_str(". ");
            fput_bytes(sk_note, 0, sk_note_n);
            fput(46)
        }
    }
    ui_section("", "");
    ui_set_footer_fbuf();
    ui_row(UI_FIELD, ACT_MM_ADD_TEXT, 0);
    ui_set_title("Psalm 23, Romans 8:28\â\€\“39");
    fbuf_n = 0;
    fput_bytes(sk_mm_add_text, 0, sk_mm_add_n);
    ui_set_detail_fbuf();
    fbuf_n = 0;
    fput_str("Passage");
    ui_set_label_fbuf();
    ui_set_field_live(1);
    ui_set_field_go();
    ui_set_focus();
    ui_section("Version", "");
    ui_row(UI_ITEM, ACT_MM_ADD_VERSION, 0);
    fbuf_n = 0;
    fput_text_name(sk_mm_add_ver);
    ui_set_title_fbuf();
    ui_set_acc(ACC_MORE);
    ui_section("Text", "");
    ui_row(UI_ITEM, 0, 0);
    fbuf_n = 0;
    sk_mm_parse();
    if (sk_mm_parsed) mm_range_words(sk_mm_add_ver);
    if (fbuf_n == 0) fput(32);
    sk_reading_title(8)
}

// The title fbuf's words, to read (the reader's face), at most lines.
sk_reading_title(lines: int) {
    ui_rich_from = 0;
    ui_rich_n = 0;
    ui_rich_u = 0;
    ui_rich(RUN_READING);
    ui_rich_title();
    ui_set_title_lines(lines)
}

// A version for a passage (owner 1 Add Passage's, 2 a passage's, its id
// in mm_vl_id): the five, and the ESV when it can be had; the one chosen
