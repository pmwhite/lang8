tag bible;

use_tag std;

// The app for a skin (SKINS.md): its state, its screens and what their
// actions do, and the reader's chapters, as the wire's lines into ui_out.
// A skin's host (in L8, on its platform) loads the texts and the settings,
// passes each line the skin sends to sk_line, and sends ui_out's lines on.
// What only the host can do (read a version's file, keep the settings) it
// gives here as functions: sk_host.
import "ui.l8";

import "prefs.l8";

import "look.l8";

import "chapter_ranges.l8";

import "orig.l8";

import "help.l8";

import "audio.l8";

// ---- what the host does for the app ----
type SkinHost = {
    // The settings kept (prefs_format into fbuf, then kept).
    save_prefs: fn();
    // What is kept (SK_KEPT_HISTORY, ...) changed: kept now, the platform's
    // way (store.l8's lines in its files).
    save_kept: fn(what: int);
    // Words only the platform knows (SK_WORDS_...), onto fbuf (from 0).
    words: fn(what: int);
    // The reader switched to version t, as the platform does it (none:
    // core's own, sk_switch_version); whether it was.
    switch_version: ?fn(t: int): bool;
    // A number only the platform knows (SK_NUM_...; a its argument), or -1.
    num: fn(what: int, a: int): int;
    // A list only the platform has (SK_ITEMS_...), into sk_items.
    fill: fn(what: int)
}

// A version wanted that is not loaded (-1: none): the host loads it (it
// keeps the text for good, which only its own loop can), then calls
// sk_use_version(t) again.
sk_want_text: int = -1;

sk_no_save() { }

sk_no_save_kept(_what: int) { }

sk_no_words(_what: int) {
    fbuf_n = 0
}

sk_no_num(_what: int, _a: int): int {
    -1
}

sk_no_fill(_what: int) {
    sk_items_n = 0
}

// The host's numbers (SkinHost.num): text a's chosen reader (an audio.l8
// SRC_); whether the ESV's recording is offered (1); download ahead on
// cellular (1); the bytes downloaded; book a's download (-1 none, 0 to
// 999 thousandths, 1000 whole); whether a better voice is installed.
SK_NUM_AUDIO_SOURCE: int = 1;

SK_NUM_ESV_AUDIO: int = 2;

SK_NUM_CELLULAR: int = 3;

SK_NUM_DOWNLOADED: int = 4;

SK_NUM_DOWNLOAD: int = 5;

SK_NUM_BETTER_VOICE: int = 6;

// Ready the versions the marks are quoted in (1 when done); ready the
// languages' words (1 if there are any).
SK_NUM_QUOTABLE: int = 7;

SK_NUM_LEARN: int = 8;

sk_num_of(what: int, a: int): int {
    f: fn(what: int, a: int): int = sk_host.num;
    f(what, a)
}

// The host's lists (SkinHost.fill): its voices (each its name; value its
// quality, 3 Premium, 2 Enhanced, 1 Standard; flag 1 the one chosen).
SK_ITEMS_VOICES: int = 1;

SK_ITEMS_MOST: int = 256;

sk_items_n: int = 0;

sk_item_at: []int = new int[SK_ITEMS_MOST](0);

sk_item_len: []int = new int[SK_ITEMS_MOST](0);

sk_item_value: []int = new int[SK_ITEMS_MOST](0);

sk_item_flag: []int = new int[SK_ITEMS_MOST](0);

sk_item_pool: []i8 = new i8[16384](0i8);

sk_item_pool_n: int = 0;

// An item, its words fbuf's (the host's, as it fills).
sk_item_fbuf(value: int, flag: int) {
    if (sk_items_n >= SK_ITEMS_MOST) return;
    sk_item_at[sk_items_n] = sk_item_pool_n;
    for i in 0..fbuf_n {
        if (sk_item_pool_n < len(sk_item_pool)) {
            sk_item_pool[sk_item_pool_n] = fbuf[i];
            sk_item_pool_n = sk_item_pool_n + 1
        }
    }
    sk_item_len[sk_items_n] = sk_item_pool_n - sk_item_at[sk_items_n];
    sk_item_value[sk_items_n] = value;
    sk_item_flag[sk_items_n] = flag;
    sk_items_n = sk_items_n + 1
}

sk_fill(what: int) {
    sk_items_n = 0;
    sk_item_pool_n = 0;
    f: fn(what: int) = sk_host.fill;
    f(what)
}

// The platform's words (SkinHost.words): who reads the version aloud; the
// Listen section's footer, if it has one now.
SK_WORDS_VOICE: int = 1;

SK_WORDS_LISTEN_FOOTER: int = 2;

// Under "Search the ESV for ...": why it isn't shown yet (Searching...,
// No connection), or nothing.
SK_WORDS_ESV_SEARCH: int = 3;

// The app's version and build, under the Manual's pages; how to get a
// better voice (the iPhone's Settings).
SK_WORDS_APP_VERSION: int = 4;

SK_WORDS_VOICE_TIP: int = 5;

// Passage sk_words_arg's first words; its state line; its whole text (to
// search).
SK_WORDS_PASSAGE: int = 6;

SK_WORDS_PASSAGE_STATE: int = 7;

SK_WORDS_PASSAGE_TEXT: int = 8;

sk_words_arg: int = 0;

sk_words_of(what: int, arg: int) {
    sk_words_arg = arg;
    sk_words(what)
}

sk_words(what: int) {
    fbuf_n = 0;
    f: fn(what: int) = sk_host.words;
    f(what)
}

// What the platform has (its host says): Listen, a Manual,
// Acknowledgements, keeping the screen on, and its fonts (by name, in the
// settings' order: none, no Font section).
sk_has_listen: bool = false;

sk_has_manual: bool = false;

sk_has_acknowledgements: bool = false;

sk_has_keep_on: bool = false;

sk_fonts: []str = new str[0]("");

SK_KEPT_HISTORY: int = 1;

SK_KEPT_SEARCHES: int = 2;

// The ribbons changed (made, renamed, colored, deleted): the host keeps
// them (store.l8's lines), and its menus follow.
SK_KEPT_RIBBONS: int = 3;

// The highlights, notes or bookmarks changed (each kept as the host keeps
// it); the chapter they are in to be laid out again: sk_kept_c.
SK_KEPT_HIGHLIGHTS: int = 4;

SK_KEPT_NOTES: int = 5;

SK_KEPT_BOOKMARKS: int = 6;

sk_kept_c: int = -1;

// The local time's offset from UTC (seconds), as the host says.
sk_tz: int = 0;

// Today (a day number), as the host says (its demo's day); -1: the
// clock's.
sk_today: int = -1;

sk_today_now(): int {
    if (sk_today >= 0) sk_today else sk_local_day(time(0))
}

sk_local_day(t: int): int {
    day_of(t + sk_tz)
}

sk_host: SkinHost = SkinHost {
    save_prefs: &sk_no_save,
    save_kept: &sk_no_save_kept,
    words: &sk_no_words,
    switch_version: null,
    num: &sk_no_num,
    fill: &sk_no_fill
};

// What the platform has, as its host says: the Hebrew and Greek's data,
// and the ESV (listed once our server has said it can give it), and what
// it calls itself (On This iPhone).
sk_has_orig: bool = false;

sk_esv_listed: bool = false;

sk_device: str = "Phone";

// Sections only the host has (in Go To, before Recent): its ribbons and
// its reading plan (HOST_); and the chapters they show, which Recent
// leaves out.
sk_has_ribbons: bool = false;

HOST_RIBBONS: int = 1;

HOST_PLAN: int = 2;

// The ESV's own search results (the host's, from its server), shown in
// place of Search's once asked for (sk_esv_results, as the host says).
HOST_ESV_RESULTS: int = 3;

// A plan's reminder (its switch and time: the host's notifications),
// first in a plan followed's days, where the host has reminders.
HOST_REMINDER: int = 4;

// Memory's daily reminder (its switch and time), in the Library.
HOST_MEMORY_REMINDER: int = 5;

sk_has_reminders: bool = false;

sk_esv_results: bool = false;

sk_listed_c: []int = new int[16](0);

sk_listed_n: int = 0;

