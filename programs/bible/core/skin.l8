    "Read by Bob Souer, Barry Hays and Jordan Gilbert. Dedicated to the public domain (CC0 1.0). Streamed from OpenBible.com.",
    "Read by Winfred W. Henson. Public domain. Streamed from eBible.org.", "Computed by Smooth Bible from these recordings. They may be a moment early or late.",
    "", "Read by David Cochran Heath. Provided by the ESV API from Crossway.", "Hebrew and Greek words, transliterations, parsing and Strong\‚\Ä\ôs numbers aligned to the BSB. Public domain.",
    "Definitions from STEP Bible\‚\Ä\ôs brief Hebrew and Greek lexicons (TBESH, TBESG), and the senses of words from their Translators Amalgamated Hebrew OT and Greek NT (TAHOT, TAGNT), licensed CC BY 4.0 (creativecommons.org/licenses/by/4.0).",
    "Meanings in context and semantic domains: UBS Dictionary of the Greek New Testament, \¬\© United Bible Societies 2023 (after Louw and Nida\‚\Ä\ôs lexicon), and UBS Dictionary of Biblical Hebrew, \¬\© United Bible Societies 2023 (from SDBH), from github.com/ubsicap/ubs-open-license. Licensed CC BY-SA 4.0 (creativecommons.org/licenses/by-sa/4.0); changed: the dictionaries\‚\Ä\ô meanings given to each word by Smooth Bible, which shares them under the same licence.",
    "From OpenBible.info, licensed CC BY 4.0 (creativecommons.org/licenses/by/4.0). Ranked by votes; those without a positive vote are left out.",
    "From the Christian Classics Ethereal Library. Public domain.", "From MACULA Greek Linguistic Datasets, available at https://github.com/Clear-Bible/macula-greek/ (Clear Bible / Biblica), licensed CC BY 4.0 (creativecommons.org/licenses/by/4.0).",
    ""];

ack_links: []str = ["https://bereanbible.com", "https://ebible.org/eng-kjv2006/",
    "https://ebible.org/engwebp/", "https://ebible.org/eng-asv/", "https://ebible.org/engylt/",
    "https://github.com/STEPBible/STEPBible-Data", "https://bereanbible.com/audio/",
    "https://ebible.org/eng-web/audio/", "", "https://www.esv.org", "https://www.esv.org",
    "https://bereanbible.com", "https://www.STEPBible.org", "https://github.com/ubsicap/ubs-open-license",
    "https://www.openbible.info/labs/cross-references/", "https://ccel.org/ccel/henry/mhcc",
    "https://github.com/Clear-Bible/macula-greek/", "https://smoothbible.com/privacy/"];

// Where each section's credits begin, and its header.
ack_first: []int = [0, 6, 9, 11, 12, 14, 17];

ack_counts: []int = [6, 3, 2, 1, 2, 3, 1];

ack_headers: []str = ["Text", "Audio", "English Standard Version", "Original Languages",
    "Lexicons", "Study", ""];

sk_build_acknowledgements(id: int) {
    ui_begin(id, SCR_ACKNOWLEDGEMENTS, 0, "Acknowledgements");
    for k in 0..7 {
        if (k != 2 || sk_esv_listed) {
            ui_section(ack_headers[k], "");
            if (k == 2) ui_sections[ui_sections_n - 1].footer = ui_put("Scripture quotations marked \‚\Ä\úESV\‚\Ä\ù are from the ESV\¬\Æ Bible (The Holy Bible, English Standard Version\¬\Æ), \¬\© 2001 by Crossway, a publishing ministry of Good News Publishers. Used by permission. All rights reserved. The ESV text may not be quoted in any publication made available to the public by a Creative Commons license. The ESV may not be translated into any other language. Users may not copy or download more than 500 verses of the ESV Bible or more than one half of any book of the ESV Bible.");
            if (k == 6) {
                sk_words(SK_WORDS_APP_VERSION);
                ui_set_footer_fbuf()
            }
            n: int = ack_counts[k];
            if (k == 2 && sk_num_of(SK_NUM_ESV_AUDIO, 0) != 1) n = 1;
            for r in 0..n {
                i: int = ack_first[k] + r;
                ui_row(UI_ITEM, if (len(ack_links[i]) > 0) ACT_CREDIT else 0, i);
                ui_set_title(ack_titles[i]);
                if (len(ack_lines[i]) > 0) ui_set_detail(ack_lines[i]);
                if (len(ack_links[i]) > 0) ui_set_acc(ACC_LINK)
            }
            if (k == 4) {
                ui_row(UI_ITEM, ACT_CHANGES, 0);
                ui_set_title("Changes to the Lexicon Data");
                ui_set_acc(ACC_MORE)
            }
        }
    }
}

// The changes made to the lexicons' and others' data.
change_lines: []str = ["STEP Bible\‚\Ä\ôs HTML was converted to plain styled text: bold, italic, paragraphs and references kept; other markup dropped, and entities decoded.",
    "Entries were grouped by base Strong\‚\Ä\ôs number, the sense matching the word\‚\Ä\ôs part of speech first.",
    "Hebrew cantillation and paragraph marks were removed for display; vowel points kept.",
    "Psalm titles were mapped to verse 1, as the BSB\‚\Ä\ôs tables have them.", "Transliterations of Hebrew lemmas are the tables\‚\Ä\ô own, or made in their style.",
    "Cross references to 3 John 1:15 are given at 1:14, as the BSB numbers it.", "The commentary\‚\Ä\ôs markup was converted to plain styled text.",
    "Each word\‚\Ä\ôs sense is STEP\‚\Ä\ôs disambiguated Strong\‚\Ä\ôs number in TAHOT and TAGNT, matched to the BSB\‚\Ä\ôs words of the verse by base number, in the original order.",
    "MACULA\‚\Ä\ôs Proximity pairs were reduced to base Strong\‚\Ä\ôs numbers (Aramaic as Hebrew), each word\‚\Ä\ôs ten nearest kept.",
    "Recordings are played as published. Verse timings for them were computed by forced alignment.",
    "The Hebrew and Greek is TAHOT\‚\Ä\ôs Leningrad text with the Qere read (its cantillation and paseq removed, kept for Show Accents) and TAGNT\‚\Ä\ôs NA28 words with their punctuation, each verse keyed by the BSB\‚\Ä\ôs numbers; words restored from the Septuagint are left out.",
    "Each word\‚\Ä\ôs meaning is the UBS dictionaries\‚\Ä\ô meaning listed for its place in its verse, or, where the places differ, for its Strong\‚\Ä\ôs number in order."];

sk_build_changes(id: int) {
    ui_begin(id, SCR_CHANGES, 0, "Changes");
    ui_section("", "");
    for i in 0..len(change_lines) {
        ui_row(UI_ITEM, 0, i);
        ui_set_title(change_lines[i])
    }
}

// ---- the word study (DESIGN.md ¬ß7.5, ¬ß10, ¬ß14.5) ----
// Each study's subject (a screen's arg): the verse and word (a lemma's:
// -1), its language and number, and whether it came from the interlinear.
SK_SUBJECTS: int = 16;

sk_sub_vi: []int = new int[16](0);

sk_sub_w: []int = new int[16](0);

sk_sub_greek: []bool = new bool[16](false);

sk_sub_num: []int = new int[16](0);

sk_sub_il: []bool = new bool[16](false);

sk_sub_next: int = 0;

// A word's study (word w of verse vi; a lemma's, w -1), pushed or
// presented.
sk_study_open(
    vi: int,
    w: int,
    greek: bool,
    num: int,
    from_il: bool,
    push: bool
) {
    s: int = sk_sub_next % SK_SUBJECTS;
    sk_sub_next = sk_sub_next + 1;
    sk_sub_vi[s] = vi;
    sk_sub_w[s] = w;
    sk_sub_greek[s] = greek;
    sk_sub_num[s] = num;
    sk_sub_il[s] = from_il;
    sk_open(SCR_STUDY, s, push)
}

// Subject s's numbers made, if another's are.
sk_study_ready(s: int) {
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    if (s < 0 || s >= SK_SUBJECTS) return;
    if (ws_vi == sk_sub_vi[s] && ws_w == sk_sub_w[s] && ws_greek == sk_sub_greek[s] && ws_num == sk_sub_num[s] && ws_set) return;
    study_set(sk_sub_vi[s], sk_sub_w[s], sk_sub_greek[s], sk_sub_num[s]);
    ws_set = true
}

ws_set: bool = false;

ws_vi: int = 0;

ws_w: int = 0;

// The number studied (the word's, or a lemma's: ws_lemma, with no verse).
ws_greek: bool = false;

ws_num: int = 0;

ws_lemma: bool = false;

// How many times the word studied occurs (in its sense, if counted so).
ws_words: int = 0;

// The word's lexicon entries (where the first is, and how many).
ws_lex: int = -1;

// Its sense (DESIGN.md ¬ß10.3): which entry (from 1; 0 not known), the
// entry's line (else the first's), and whether it is counted by sense (the
// number has more than one sense in use): then how often in it, and in all.
ws_sense: int = 0;

ws_entry: int = -1;

ws_by_sense: bool = false;

ws_all: int = 0;

// Related words (¬ß10.4): up to 5 of its language, and 3 of the other, each
// its number and how often it occurs.
ws_rel_n: int = 0;

ws_rel_greek: []bool = new bool[5](false);

ws_rel_num: []int = new int[5](0);

ws_rel_count: []int = new int[5](0);

ws_far_n: int = 0;

ws_far_num: []int = new int[3](0);

// The word's meaning here (UBS's; 0 none) and the words of its domain.
ws_mean: int = 0;

ws_dom_n: int = 0;

ws_dom_num: []int = new int[5](0);

ws_dom_count: []int = new int[5](0);

ws_far_count: []int = new int[3](0);

// Its distinct forms (0: no Forms row), and whether it may be a card.
ws_forms: int = 0;

ws_learnable: bool = false;

// Section 1's rows (¬ß7.5, ¬ß14.5.2): Dictionary Form, Meaning, (a lemma's
// Forms), Strong's, (a word's Grammar, Forms), Your Words.
WR_DICT: int = 0;

WR_MEANING: int = 1;

WR_STRONGS: int = 2;

WR_GRAMMAR: int = 3;

WR_FORMS: int = 4;

WR_YOURS: int = 5;

ws_row_kinds: []int = new int[8](0);

ws_row_n: int = 0;

ws_rows_make() {
    ws_row_n = 0;
    ws_row_add(WR_DICT);
    ws_row_add(WR_MEANING);
    if (ws_lemma && ws_forms > 0) ws_row_add(WR_FORMS);
    ws_row_add(WR_STRONGS);
    if (!ws_lemma) ws_row_add(WR_GRAMMAR);
    if (!ws_lemma && ws_forms > 0) ws_row_add(WR_FORMS);
    if (ws_learnable) ws_row_add(WR_YOURS)
}

ws_row_add(k: int) {
    ws_row_kinds[ws_row_n] = k;
    ws_row_n = ws_row_n + 1
}

// The study's numbers made (for word w of verse vi, or a lemma's with no
// word: w -1): its entries, its sense, its counts and renderings, and its
// related words.
study_set(
    vi: int,
    w: int,
    greek: bool,
    num: int
) {
    ws_vi = vi;
    ws_w = w;
    ws_lemma = w < 0;
    ws_greek = greek;
    ws_num = num;
    ws_lex = lex_first(greek, num);
    ws_sense = (if (w >= 0) w_sense(w) else 0);
    ws_entry = sense_entry(greek, num, ws_sense);
    if (ws_entry < 0) {
        ws_entry = ws_lex;
        ws_sense = 0
    }
    _ok: bool = conc_load(greek, num);
    ws_all = cc_words;
    ws_by_sense = ws_sense > 0 && senses_in_use() > 1;
    if (ws_by_sense) conc_sense(ws_sense);
    ws_words = cc_words;
    renderings();
    // (Then the related words, and how often each occurs.)
    related_load(greek, num);
    ws_rel_n = 0;
    ws_far_n = 0;
    for i in 0..rl_n {
        if (rl_greek[i] == greek && ws_rel_n < 5) {
            ws_rel_greek[ws_rel_n] = rl_greek[i];
            ws_rel_num[ws_rel_n] = rl_num[i];
            ws_rel_n = ws_rel_n + 1
        } else if (rl_greek[i] != greek && ws_far_n < 3) {
            ws_far_num[ws_far_n] = rl_num[i];
            ws_far_n = ws_far_n + 1
        }
    }
    for i in 0..ws_rel_n ws_rel_count[i] = occurrences(greek, ws_rel_num[i]);
    for i in 0..ws_far_n ws_far_count[i] = occurrences(!greek, ws_far_num[i]);
    // (And its meaning here, UBS's, with the words of its domain: the
    // commonest five not related above.)
    ws_mean = (if (w >= 0) w_meaning(w) else 0);
    ws_dom_n = 0;
    if (ws_mean > 0) {
        domain_words(ws_mean);
        for i in 0..dm_n {
            num_d: int = dm_num[i] & 32767;
            listed: bool = num_d == num;
            for x in 0..ws_rel_n
                if (ws_rel_num[x] == num_d) listed = true;
            n_d: int = if (listed) 0 else occurrences(greek, num_d);
            if (n_d > 0) {
                // (Kept, the commonest five, most first.)
                at: int = ws_dom_n;
                while (at > 0 && ws_dom_count[at - 1] < n_d) at = at - 1;
                if (at < 5) {
                    y: int = if (ws_dom_n < 5) ws_dom_n else 4;
                    while (y > at) {
                        ws_dom_num[y] = ws_dom_num[y - 1];
                        ws_dom_count[y] = ws_dom_count[y - 1];
                        y = y - 1
                    }
                    ws_dom_num[at] = num_d;
                    ws_dom_count[at] = n_d;
                    if (ws_dom_n < 5) ws_dom_n = ws_dom_n + 1
                }
            }
        }
    }
    // Its forms (¬ß14.5.3: a verb's, noun's, adjective's, pronoun's or the
    // article's; not a name's), counted for the Forms row; and whether it
    // may be learned (its Your Words row).
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    ws_learnable = learnable(if (greek) 0 else 1, num);
    ws_forms = 0;
    if ((vk_flags_of(if (greek) 0 else 1, num) & FL_NAME) == 0) {
        forms_of(greek, num);
        forms_layout();
        if (fs_n > 0) ws_forms = forms_count()
    }
    // (The number's own verses loaded again, as the concordance has them.)
    _again: bool = conc_load(greek, num);
    if (ws_by_sense) conc_sense(ws_sense)
}

// The definition's first words, plain: an outline's top senses joined
// with " ¬∑ ", or its paragraphs run together (lang.l8).
sk_definition_preview() {
    fbuf_n = 0;
    if (ws_lex < 0) {
        fput_str("No definition.");
        return
    }
    n_: int = lex_count(ws_lex);
    if (!ws_lemma && ws_sense == 0 && n_ > 1) {
        // A sense not known: which senses it may be, none first.
        fbuf_n = 0;
        fput_str("One of ");
        fput_int(n_);
        fput_str(" senses, not tagged in this verse: ");
        for x in 0..n_ {
            lex_field(lex_line(ws_lex, x), 3);
            b: int = lf_b;
            e: int = lf_e;
            dup: bool = false;
            for y in 0..x {
                lex_field(lex_line(ws_lex, y), 3);
                if (lf_e - lf_b == e - b) {
                    same: bool = true;
                    for i in 0..e - b
                        if (llex[lf_b + i] != llex[b + i]) same = false;
                    if (same) dup = true
                }
            }
            if (!dup) {
                if (x > 0) fput_str(" \¬\∑ ");
                for i in b..e fput(llex[i] as int)
            }
        }
        return
    }
    definition_preview_of(ws_entry);
    // (Up to 600 bytes, stopping between characters.)
    n: int = pv_n;
    if (n > 600) {
        n = 600;
        while (n > 0 && byte_of(pv, n) >= 128 && byte_of(pv, n) < 192) n = n - 1
    }
    fbuf_n = 0;
    fput_bytes(pv, 0, n)
}

// The sense's code (H430G), or the number's (H430).
fput_sense_code() {
    if (ws_sense > 0 && ws_entry >= 0) {
        lex_code(ws_entry);
        if (lf_e > lf_b) {
            for x in lf_b..lf_e fput(llex[x] as int);
            return
        }
    }
    fput_key(ws_greek, ws_num)
}

forms_count(): int {
    n: int = 0;
    for p in 0..fp_n {
        dup: bool = false;
        for q in 0..p
            if (fp_form[q] == fp_form[p]) dup = true;
        if (!dup) n = n + 1
    }
    n
}

fput_key(greek: bool, num: int) {
    fput(if (greek) 71 else 72);
    fput_int(num)
}

// The word studied in its script (rich: RUN_GREEK or RUN_HEBREW).
sk_script(greek: bool, faint: bool): int {
    if (greek)
        if (faint) RUN_GREEK_FAINT else RUN_GREEK else if (faint) RUN_HEBREW_FAINT else RUN_HEBREW
}

sk_build_study(id: int, s: int) {
    sk_study_ready(s);
    ui_begin(id, SCR_STUDY, s, "");
    w: int = ws_w;
    // The title: the lemma's transliteration (or the form's).
    fbuf_n = 0;
    if (ws_entry >= 0) {
        lex_field(ws_entry, 1);
        fput_bytes(llex, lf_b, lf_e)
    } else if (w >= 0) {
        form_of(w);
        fput_bytes(lforms, wt_b, wt_e)
    }
    ui_set_screen_title_fbuf();
    // The heading: the form as it is in the verse (or the lemma), its
    // transliteration, and ‚Äúloved‚Äù in John 3:16 (or "143 times").
    fbuf_n = 0;
    if (ws_lemma) {
        lex_field(ws_lex, 0);
        fput_bytes(llex, lf_b, lf_e);
        at: int = fbuf_n;
        lex_field(ws_lex, 1);
        fput_bytes(llex, lf_b, lf_e);
        ui_set_hero(at, sk_script(ws_greek, false), fbuf_n);
        ui_rich_begin();
        fput_int(ws_all);
        fput_str(if (ws_all == 1) " time" else " times");
        ui_rich(RUN_PLAIN);
        ui_rich_hero_line()
    } else {
        study_load(ws_vi);
        form_of(w);
        fput_bytes(lforms, wf_b, wf_e);
        at: int = fbuf_n;
        fput_bytes(lforms, wt_b, wt_e);
        ui_set_hero(at, sk_script(w_greek(w), false), fbuf_n);
        ui_rich_begin();
        chunk_of(w);
        if (ch_e > ch_b) {
            fput_str("\‚\Ä\ú");
            ui_rich(RUN_PLAIN);
            fput_bytes(st, ch_b, ch_e);
            ui_rich(RUN_STRONG);
            fput_str("\‚\Ä\ù in ");
            ui_rich(RUN_PLAIN)
        } else {
            fput_str("Not translated in ");
            ui_rich(RUN_PLAIN)
        }
        fput_ref(v_chapter(ws_vi), v_num(ws_vi), v_num(ws_vi));
        ui_rich(RUN_PLAIN);
        ui_rich_hero_line();
        // (At its foot: Add to Note, and the interlinear unless it came
        // from there.)
        ui_tool("Add to Note", "", ACT_ADD_TO_NOTE, 0, UI_TOOL_PLAIN, 0);
        if (!sk_sub_il[s]) ui_tool("Interlinear", "", ACT_INTERLINEAR, 0, UI_TOOL_PLAIN,
            2)
    }
    ui_section("", "");
    ws_rows_make();
    for r in 0..ws_row_n sk_study_row(ws_row_kinds[r]);
    ui_section("Definition", if (ws_lex >= 0) "From STEP Bible" else "");
    ui_row(UI_ITEM, if (ws_lex >= 0) ACT_STUDY_DEFINITION else 0, 0);
    sk_definition_preview();
    ui_rich_from = 0;
    ui_rich_n = 0;
    ui_rich_u = 0;
    ui_rich(RUN_READING);
    ui_rich_title();
    ui_set_title_lines(5);
    if (ws_lex >= 0) ui_set_acc(ACC_MORE);
    ui_section("Occurrences", "");
    ui_row(UI_ITEM, ACT_STUDY_CONC, if (ws_by_sense) 1 else 0);
    ui_set_title("Concordance");
    fbuf_n = 0;
    fput_int(ws_words);
    if (ws_by_sense) fput_str(" in this sense") else fput_str(if (ws_words == 1) " time" else " times");
    ui_set_detail_fbuf();
    ui_set_value_detail();
    ui_set_acc(ACC_MORE);
    if (ws_by_sense) {
        ui_row(UI_ITEM, ACT_STUDY_CONC, 0);
        ui_set_title("All Senses");
        fbuf_n = 0;
        fput_int(ws_all);
        ui_set_detail_fbuf();
        ui_set_value_detail();
        ui_set_acc(ACC_MORE)
    }
    if (rd_n > 0) {
        ui_section("Translated As", if (ws_by_sense) "In this sense" else "");
        for r in 0..if (rd_n > 6) 6 else rd_n {
            ui_row(UI_ITEM, ACT_STUDY_CONC, (r + 1) * 2 + (if (ws_by_sense) 1 else 0));
            fbuf_n = 0;
            fput_bytes(rd_pool, rd_at[r], rd_at[r] + rd_len[r]);
            ui_set_title_fbuf();
            fbuf_n = 0;
            fput_int(rd_count[r]);
            ui_set_detail_fbuf();
            ui_set_value_detail()
        }
    }
    macula: str = "Words used in similar contexts, from MACULA.";
    if (ws_rel_n > 0) {
        ui_section("Related Words", if (ws_far_n == 0 && ws_dom_n == 0 || ws_far_n == 0 && ws_dom_n > 0) macula else "");
        for r in 0..ws_rel_n sk_related_row(ws_greek, ws_rel_num[r], ws_rel_count[r])
    }
    if (ws_far_n > 0) {
        ui_section(if (ws_greek) "In the Old Testament" else "In the New Testament",
            macula);
        for r in 0..ws_far_n sk_related_row(!ws_greek, ws_far_num[r], ws_far_count[r])
    }
    if (ws_dom_n > 0) {
        ui_section("In the Same Domain", "");
        fbuf_n = 0;
        fput_str("Words with a meaning in ");
        mean_field(ws_mean, 3);
        fput_bytes(lmeant, mf_b, mf_e);
        fput_str(", as here; from the UBS dictionaries.");
        ui_set_footer_fbuf();
        for r in 0..ws_dom_n sk_related_row(ws_greek, ws_dom_num[r], ws_dom_count[r])
    }
}

// A row of the study's first section, of kind k (WR_).
sk_study_row(k: int) {
    w: int = ws_w;
    if (k == WR_DICT) {
        ui_row(UI_ITEM, 0, 0);
        ui_set_title("Dictionary Form");
        if (ws_entry >= 0) {
            ui_rich_begin();
            // (Left to right, though it begins in Hebrew.)
            fput_str("\‚\Ä\é");
            ui_rich(RUN_FAINT);
            lex_field(ws_entry, 0);
            fput_bytes(llex, lf_b, lf_e);
            ui_rich(sk_script(ws_greek, true));
            fput_str(" (");
            ui_rich(RUN_FAINT);
            lex_field(ws_entry, 1);
            fput_bytes(llex, lf_b, lf_e);
            ui_rich(RUN_TRANSLIT);
            fput_str(")");
            ui_rich(RUN_FAINT);
            ui_rich_detail()
        }
        ui_set_value_detail()
    } else if (k == WR_MEANING) {
        ui_row(UI_ITEM, 0, 0);
        ui_set_title("Meaning");
        // (A sense not known among differing entries shows none of them.)
        me: int = if (ws_lemma) ws_entry else meaning_entry(ws_greek, ws_num, ws_sense);
        if (ws_mean > 0) {
            // (UBS's meaning here under the gloss.)
            ui_rich_begin();
            if (me >= 0) {
                lex_field(me, 3);
                fput_bytes(llex, lf_b, lf_e);
                ui_rich(RUN_PLAIN)
            }
            ui_rich_detail();
            fbuf_n = 0;
            fput_str("Here: ");
            fput_meaning(ws_mean);
            ui_set_note_fbuf()
        } else {
            ui_rich_begin();
            if (me >= 0) {
                lex_field(me, 3);
                fput_bytes(llex, lf_b, lf_e);
                ui_rich(RUN_PLAIN)
            } else if (ws_lex >= 0) {
                fput_str("Sense not tagged");
                ui_rich(RUN_FAINT)
            }
            ui_rich_detail();
            ui_set_value_detail()
        }
    } else if (k == WR_FORMS) {
        ui_row(UI_ITEM, ACT_STUDY_FORMS, 0);
        ui_set_title("Forms");
        fbuf_n = 0;
        fput_int(ws_forms);
        fput_str(if (ws_forms == 1) " form" else " forms");
        ui_set_detail_fbuf();
        ui_set_value_detail();
        ui_set_acc(ACC_MORE)
    } else if (k == WR_STRONGS) {
        ui_row(UI_ITEM, 0, 0);
        ui_set_title("Strong\‚\Ä\ôs");
        ui_rich_begin();
        fput_sense_code();
        ui_rich(RUN_CODE);
        ui_rich_detail();
        ui_set_value_detail();
        // (Read as "Strong's H 430 G".)
        at: int = fbuf_n;
        fput_str("Strong\‚\Ä\ôs ");
        for i in 0..at {
            x: int = fbuf[i] as int;
            if (i > 0 && is_digit(x) != is_digit(fbuf[i - 1] as int)) fput(32);
            fput(x)
        }
        for i in 0..fbuf_n - at fbuf[i] = fbuf[at + i];
        fbuf_n = fbuf_n - at;
        ui_set_label_fbuf()
    } else if (k == WR_GRAMMAR) {
        ui_row(UI_ITEM, ACT_STUDY_GRAMMAR, 0);
        ui_set_title("Grammar");
        plain_parsing(w_morph(w));
        fbuf_n = 0;
        fput_bytes(pl, 0, pl_n);
        ui_set_detail_fbuf();
        ui_set_lines(2);
        ui_set_acc(ACC_MORE)
    } else if (k == WR_YOURS) {
        lang: int = if (ws_greek) 0 else 1;
        c: int = card_of_word(lang, ws_num);
        if (c < 0) {
            ui_row(UI_BUTTON, ACT_LEARN_WORD, 0);
            ui_set_title("Learn This Word");
            ui_set_tinted();
            ui_rows[ui_last()].strong = false
        } else {
            ui_row(UI_ITEM, 0, 0);
            ui_set_title("Your Words");
            fbuf_n = 0;
            if (cd_state[c] == MS_NEW) fput_str("New \¬\∑ in your next practice") else fput_card_state(c,
                sk_today_now());
            ui_set_detail_fbuf();
            ui_set_value_detail();
            ui_set_lines(2)
        }
    }
}

// A related word's row: its lemma and transliteration, gloss, and how
// often it occurs (a word known: checked).
sk_related_row(greek: bool, num: int, count: int) {
    ui_row(UI_ITEM, ACT_STUDY_LEMMA, (if (greek) 100000 else 0) + num);
    p: int = lex_first(greek, num);
    ui_rich_begin();
    if (p >= 0) {
        // (Left to right, a Hebrew lemma held in its place by the marks.)
        fput_str("\‚\Ä\é");
        ui_rich(RUN_PLAIN);
        lex_field(p, 0);
        fput_bytes(llex, lf_b, lf_e);
        ui_rich(sk_script(greek, false));
        fput_str("\‚\Ä\é  ");
        ui_rich(RUN_PLAIN);
        lex_field(p, 1);
        fput_bytes(llex, lf_b, lf_e);
        ui_rich(RUN_TRANSLIT);
        ui_rich_title();
        fbuf_n = 0;
        lex_field(p, 3);
        fput_bytes(llex, lf_b, lf_e);
        ui_set_detail_fbuf()
    } else {
        fput_key(greek, num);
        ui_rich(RUN_CODE);
        ui_rich_title()
    }
    fbuf_n = 0;
    fput_int(count);
    ui_set_trailing_fbuf();
    ui_set_acc(ACC_MORE);
    known: bool = learn_ready && word_card_known(if (greek) 0 else 1, num);
    ui_set_on(known);
    if (known && p >= 0) {
        fbuf_n = 0;
        lex_field(p, 1);
        fput_bytes(llex, lf_b, lf_e);
        fput_str(", ");
        lex_field(p, 3);
        fput_bytes(llex, lf_b, lf_e);
        fput_str(", ");
        fput_int(count);
        fput_str(" times, known");
        ui_set_label_fbuf()
    }
}

// ---- grammar (DESIGN.md ¬ß7.5.3) ----
// The word's parsing, a section a part (prefix, word, suffix), each term
// and what it means; a Hebrew word's joined words' cards under its prefix
// and suffix.
sk_build_grammar(id: int, s: int) {
    sk_study_ready(s);
    ui_begin(id, SCR_GRAMMAR, s, "Grammar");
    morph: int = w_morph(ws_w);
    // The heading: the form and its code.
    ui_rich_begin();
    form_of(ws_w);
    fput_bytes(lforms, wf_b, wf_e);
    ui_rich(sk_script(w_greek(ws_w), false));
    fput_str(" \¬\∑ ");
    ui_rich(RUN_FAINT);
    morph_of(morph);
    fput_bytes(lmorph, mc_b, mc_e);
    ui_rich(RUN_CODE);
    ui_rich_intro();
    parse_terms(morph);
    parts: int = 0;
    for part in 0..3 {
        any: bool = false;
        for t in 0..pt_n
            if (pt_part[t] == part) any = true;
        if (any) parts = parts + 1
    }
    for part in 0..3 {
        parse_terms(morph);
        any: bool = false;
        for t in 0..pt_n
            if (pt_part[t] == part) any = true;
        if (any) {
            ui_section(if (parts < 2) "" else if (part == 0) "Prefix" else if (part == 1) "Word" else "Suffix",
                "");
            sk_grammar_footer(part);
            if (fbuf_n > 0) ui_set_footer_fbuf();
            parse_terms(morph);
            for t in 0..pt_n {
                if (pt_part[t] == part) {
                    // The term, each word capitalized ("3rd Person"), and
                    // what it means.
                    ui_row(UI_ITEM, 0, t);
                    fbuf_n = 0;
                    cap: bool = true;
                    for i in pt_b[t]..pt_e[t] {
                        c: int = pt_buf[i] as int;
                        if (cap && c >= 97 && c <= 122) c = c - 32;
                        cap = c == 32;
                        fput(c)
                    }
                    ui_set_title_fbuf();
                    ui_set_strong();
                    if (pt_gram[t] >= 0) {
                        gram_parts(pt_gram[t]);
                        fbuf_n = 0;
                        fput_bytes(lgram, gx_b, gx_e);
                        ui_set_detail_fbuf()
                    }
                }
            }
        }
    }
}

// A Hebrew word's Prefix and Suffix sections name its joined words' cards
// (¬ß14.5.2): "Joined word: ◊ï÷∞ and ¬∑ known".
sk_grammar_footer(part: int) {
    fbuf_n = 0;
    if (w_greek(ws_w) || !learn_ready || part == 1) return;
    bits: int = word_parts(ws_w);
    for j in 0..len(jp_ids) {
        mine: bool = if (part == 0) j < 6 else j >= 6;
        i: int = jp_lt[j];
        if (mine && (bits & 1 << j) != 0 && i >= 0) {
            if (fbuf_n > 0) fput_str("; ");
            fput_str("Joined word: \‚\Å\ß");
            // (Its glyph without the dotted circle.)
            x: int = lt_fb[i * 9 + LF_GLYPH];
            e: int = lt_fe[i * 9 + LF_GLYPH];
            while (x < e) {
                cp: int = cp_at(llet, x, e);
                if (cp != 9676) fbuf_n = cp_put(fbuf, fbuf_n, cp);
                x = x + cp_len
            }
            fput_str("\‚\Å\© ");
            fput_lt(i, LF_NAME);
            k: int = cl_of[i];
            if (cd_known(k)) fput_str(" \¬\∑ known") else if (k >= 0) fput_str(" \¬\∑ learning")
        }
    }
}

// ---- the concordance (DESIGN.md ¬ß7.5.4) ----
// Its verses: all the number's, or (conc_r >= 0) those where it is
// rendered so; in its sense only (conc_by_sense; This Sense and All above
// it, when it was asked for from "in this sense"); or a parsing's
// (conc_form, the Forms'). By book, filtered by what is typed.
conc_by_sense: bool = false;

conc_r: int = -1;

conc_form: int = -1;

// Whether This Sense and All are offered.
conc_sensed: bool = false;

cs_n: int = 0;

cs_book: []int = new int[66](0);

cs_start: []int = new int[66](0);

cs_count: []int = new int[66](0);

cf: []int = new int[8192](0);

cf_n: int = 0;

cq: []i8 = new i8[256](0i8);

cq_n: int = 0;

conc_reload_data() {
    _ok: bool = conc_load(ws_greek, ws_num);
    if (conc_by_sense) conc_sense(ws_sense);
    if (conc_r >= 0) conc_only(conc_r);
    if (conc_form >= 0) conc_of_form(conc_form);
    conc_sections()
}

conc_sections() {
    cf_n = 0;
    for i in 0..cc_n {
        if (cq_n == 0 || conc_matches(cc_vi[i])) {
            cf[cf_n] = i;
            cf_n = cf_n + 1
        }
    }
    cs_n = 0;
    for i in 0..cf_n {
        b: int = ch_book[v_chapter(cc_vi[cf[i]])];
        if (cs_n == 0 || cs_book[cs_n - 1] != b) {
            cs_book[cs_n] = b;
            cs_start[cs_n] = i;
            cs_count[cs_n] = 0;
            cs_n = cs_n + 1
        }
        cs_count[cs_n - 1] = cs_count[cs_n - 1] + 1
    }
}

// Whether verse vi's words or reference have the filter's (case aside).
conc_matches(vi: int): bool {
    study_load(vi);
    if (has_lower(st, st_n)) return true;
    fbuf_n = 0;
    fput_ref(v_chapter(vi), v_num(vi), v_num(vi));
    has_lower(fbuf, fbuf_n)
}

has_lower(b: []i8, n: int): bool {
    for i in 0..n - cq_n + 1 {
        same: bool = true;
        j: int = 0;
        while (same && j < cq_n) {
            k: int = b[i + j] as int;
            if (k >= 65 && k <= 90) k = k + 32;
            if (k != cq[j] as int) same = false;
            j = j + 1
        }
        if (same) return true
    }
    false
}

// The concordance (of the word studied) shown: its verses (rendering r,
// or -1 all; in its sense, if sensed: then This Sense and All above them
// when all were asked for).
sk_conc_open(s: int, r: int, sensed: bool) {
    conc_r = r;
    conc_by_sense = sensed;
    conc_sensed = sensed && r < 0;
    conc_form = -1;
    cq_n = 0;
    sk_open(SCR_CONCORDANCE, s, true)
}

// (A parsing's form and parsing, onto fbuf.)
sk_conc_form_words() {
    frm_put_form(conc_form);
    fput_str(" \¬\∑ ");
    frm_put_parsing(conc_form)
}

sk_conc_header() {
    fbuf_n = 0;
    // (Left to right, though it may begin in Hebrew.)
    fput_str("\‚\Ä\é");
    r: int = conc_r;
    if (r >= 0) {
        if (ws_entry >= 0) {
            lex_field(ws_entry, 1);
            for x in lf_b..lf_e fput(llex[x] as int)
        } else fput_key(ws_greek, ws_num);
        fput_str(" translated \‚\Ä\ú");
        for x in 0..rd_len[r] fput(rd_pool[rd_at[r] + x] as int);
        fput_str("\‚\Ä\ù \‚\Ä\î ");
        fput_int(cc_words);
        fput_str(if (cc_words == 1) " time" else " times")
    } else if (conc_form >= 0) {
        // "·º†Œ≥Œ¨œÄŒ∑œÉŒµŒΩ ¬∑ aorist active indicative 3rd singular ‚Äî 6 times".
        sk_conc_form_words();
        fput_str(" \¬\∑ ");
        fput_str(" \‚\Ä\î ");
        fput_int(cc_words);
        fput_str(if (cc_words == 1) " time" else " times")
    } else {
        if (ws_entry >= 0) {
            lex_field(ws_entry, 0);
            for x in lf_b..lf_e fput(llex[x] as int);
            fput_str(" \¬\∑ ");
            lex_field(ws_entry, 1);
            for x in lf_b..lf_e fput(llex[x] as int);
            fput_str(" \¬\∑ ")
        }
        if (conc_by_sense) fput_sense_code() else fput_key(ws_greek, ws_num);
        fput_str(" \‚\Ä\î ");
        fput_int(cc_words);
        fput_str(if (cc_words == 1) " time in " else " times in ");
        fput_int(cc_n);
        fput_str(if (cc_n == 1) " verse" else " verses")
    }
    n: int = fbuf_n;
    for i in 0..n sk_note[i] = fbuf[i];
    ui_rich_begin();
    fput_bytes(sk_note, 0, n);
    ui_rich(RUN_SMALL);
    ui_rich_intro()
}

sk_build_concordance(id: int, s: int) {
    if (conc_form < 0) sk_study_ready(s);
    ui_begin(id, SCR_CONCORDANCE, s, "");
    conc_reload_data();
    fbuf_n = 0;
    if (conc_r >= 0) {
        fput_str("\‚\Ä\ú");
        fput_bytes(rd_pool, rd_at[conc_r], rd_at[conc_r] + rd_len[conc_r]);
        fput_str("\‚\Ä\ù")
    } else fput_str("Concordance");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_set_search("Filter Verses");
    ui_set_search_text(cq, cq_n);
    if (conc_sensed) {
        fbuf_n = 0;
        fput_str("This Sense (");
        fput_int(ws_words);
        fput_str(")|All (");
        fput_int(ws_all);
        fput_str(")");
        ui_segments = ui_put_fbuf();
        ui_segment = (if (conc_by_sense) 0 else 1);
        ui_segments_action = ACT_CONC_SENSE
    }
    sk_conc_header();
    if (cs_n > 8) {
        fbuf_n = 0;
        for x in 0..cs_n {
            if (x > 0) fput(124);
            book_short(cs_book[x]);
            fput_bytes(short_name, 0, short_n)
        }
        ui_set_index_fbuf()
    }
    ui_set_empty("magnifyingglass", "No Matches", "");
    // (Its verses made as they are wanted: a book's can be thousands.)
    ui_lazy_fn = &sk_conc_lazy;
    for x in 0..cs_n {
        ui_section("", "");
        ui_set_lazy(cs_count[x]);
        fbuf_n = 0;
        b: int = cs_book[x];
        fput_bytes(bsb, book_name_start(b), book_name_end(b));
        fput_str(" \¬\∑ ");
        fput_int(cs_count[x]);
        ui_set_header_fbuf()
    }
}

sk_conc_lazy(s: int, r: int) {
    if (s >= 0 && s < cs_n && r < cs_count[s]) sk_conc_row(cc_vi[cf[cs_start[s] + r]])
}

// A verse of the concordance: its reference (" ¬∑ not translated"), its
// words, the number's English marked (begun nearer it if far in).
sk_conc_row(vi: int) {
    ui_row(UI_ITEM, ACT_CONC_VERSE, vi);
    ui_set_custom(CUSTOM_HIT);
    fbuf_n = 0;
    fput_ref(v_chapter(vi), v_num(vi), v_num(vi));
    ui_set_title_fbuf();
    conc_marks(vi);
    if (mk_untranslated) {
        fbuf_n = 0;
        fput_str(" \¬\∑ not translated");
        ui_set_suffix_fbuf()
    }
    start: int = 0;
    if (mk_n > 0 && mk_b[0] > 170) {
        words: int = 0;
        start = mk_b[0];
        while (start > 0 && words < 9) {
            start = start - 1;
            if (st[start] as int == 32) words = words + 1
        }
        if (st[start] as int == 32) start = start + 1
    }
    fbuf_n = 0;
    lead: int = 0;
    if (start > 0) {
        fput_str("\‚\Ä\¶ ");
        lead = 2
    }
    fput_bytes(st, start, st_n);
    ui_set_detail_fbuf();
    ui_set_scripture();
    for i in 0..mk_n {
        if (mk_b[i] >= start) {
            b: int = lead + sk_utf16(st, start, mk_b[i]);
            ui_add_mark(b, b + sk_utf16(st, mk_b[i], mk_e[i]))
        }
    }
}

// ---- Memory's lists (DESIGN.md ¬ß13.2.2, ¬ß13.4.1) ----
// Add Passage: the reference typed (parsed as it is typed: the footer says
// what it is, and Add is on once it may be added), its version, and its
// words.
sk_mm_add_text: []i8 = new i8[256](0i8);

sk_mm_add_n: int = 0;

sk_mm_add_ver: int = 0;

sk_mm_parsed: bool = false;

sk_mm_ok: bool = false;

sk_mm_parse() {
    sk_mm_parsed = sk_mm_add_n > 0 && parse_range(sk_mm_add_text, sk_mm_add_n);
    sk_mm_ok = sk_mm_parsed && rg_verses <= MEM_VERSES
}

sk_build_mm_add(id: int) {
    ui_begin(id, SCR_MM_ADD, 0, "Add Passage");
    sk_mm_parse();
    ui_set_confirm("Add", ACT_MM_ADD_DONE);
    // (Why the ESV can't keep it, if it can't.)
    refusal: bool = false;
    if (sk_mm_ok && sk_mm_add_ver == TEXT_ESV) {
        sk_words_of(SK_WORDS_ESV_REFUSAL, sk_mm_add_ver);
        refusal = fbuf_n > 0;
        sk_note_n = fbuf_n;
        for x in 0..fbuf_n sk_note[x] = fbuf[x];
        if (refusal) sk_mm_ok = false
    }
    if (!sk_mm_ok) ui_set_confirm_off();
    fbuf_n = 0;
    if (!sk_mm_parsed) fput_str("Not a passage yet.") else {
        sk_mm_parse();
        fput_range(rg_c1, rg_v1, rg_c2, rg_v2);
        fput_str(" \¬\∑ ");
        fput_int(rg_verses);
        fput_str(if (rg_verses == 1) " verse" else " verses");
        if (rg_verses > MEM_VERSES) fput_str(". A passage is up to 40 verses.");
        if (refusal) {
            fput_str(". ");
            fput_bytes(sk_note, 0, sk_note_n);
            fput(46)
        }
    }
    ui_section("", "");
    ui_set_footer_fbuf();
    ui_row(UI_FIELD, ACT_MM_ADD_TEXT, 0);
    ui_set_title("Psalm 23, Romans 8:28\‚\Ä\ì39");
    fbuf_n = 0;
    fput_bytes(sk_mm_add_text, 0, sk_mm_add_n);
    ui_set_detail_fbuf();
    fbuf_n = 0;
    fput_str("Passage");
    ui_set_label_fbuf();
    ui_set_field_live(1);
    ui_set_field_go();
    ui_set_focus();
    ui_section("Version", "");
    ui_row(UI_ITEM, ACT_MM_ADD_VERSION, 0);
    ui_set_title(text_names[sk_mm_add_ver]);
    ui_set_acc(ACC_MORE);
    ui_section("Text", "");
    ui_row(UI_ITEM, 0, 0);
    fbuf_n = 0;
    sk_mm_parse();
    if (sk_mm_parsed) sk_words_of(SK_WORDS_RANGE_TEXT, sk_mm_add_ver);
    if (fbuf_n == 0) fput(32);
    sk_reading_title(8)
}

// The title fbuf's words, to read (the reader's face), at most lines.
sk_reading_title(lines: int) {
    ui_rich_from = 0;
    ui_rich_n = 0;
    ui_rich_u = 0;
    ui_rich(RUN_READING);
    ui_rich_title();
    ui_set_title_lines(lines)
}

// A version for a passage (owner 1 Add Passage's, 2 a passage's, its id
// in mm_vl_id): the five, and the ESV when it can be had; the one chosen
// checked.
sk_mm_vl_owner: int = 0;

sk_mm_vl_ver: int = 0;

sk_mm_vl_id: int = 0;

sk_build_mm_versions(id: int) {
    ui_begin(id, SCR_MM_VERSIONS, 0, "Version");
    ui_section("", "");
    n: int = if (sk_esv_listed || sk_mm_vl_ver == TEXT_ESV) 6 else 5;
    for r in 0..n {
        ui_row(UI_ITEM, ACT_MM_VERSION, r);
        ui_set_title(text_names[r]);
        ui_set_detail(text_abbrs[r]);
        if (r == sk_mm_vl_ver) ui_set_acc(ACC_CHECK)
    }
}

// A passage (its id): its words, its version, its Greek or Hebrew words
// (¬ß14.3.6), its schedule, Open in Reader, Start Over, Delete Passage.
sk_build_mm_passage(id: int, pid: int) {
    i: int = mem_index(pid);
    fbuf_n = 0;
    if (i >= 0) fput_passage(i);
    ui_begin(id, SCR_MM_PASSAGE, pid, "");
    ui_set_screen_title_fbuf();
    if (i < 0) return;
    ui_section(text_names[mq_ver[i]], "");
    ui_row(UI_ITEM, 0, 0);
    sk_words_of(SK_WORDS_PASSAGE_TEXT, i);
    if (fbuf_n == 0) sk_words_of(SK_WORDS_PASSAGE_STATE, i);
    sk_reading_title(12);
    ui_section("Version", "");
    ui_row(UI_ITEM, ACT_MM_PS_VERSION, 0);
    ui_set_title("Version");
    ui_set_detail(text_abbrs[mq_ver[i]]);
    ui_set_value_detail();
    ui_set_acc(ACC_MORE);
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    if (learn_ready) {
        learn_words_of(mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i]);
        lang: int = ch_lang(mq_c1[i]);
        ui_section("", "");
        ui_row(UI_ITEM, ACT_MM_PS_WORDS, 0);
        ui_set_title(if (lang == 0) "Greek Words" else "Hebrew Words");
        fbuf_n = 0;
        if (wu_n == 0) fput_str("All learned") else {
            fput_int(wu_n);
            fput_str(" to learn")
        }
        ui_set_detail_fbuf();
        ui_set_value_detail();
        ui_set_acc(ACC_MORE);
        fbuf_n = 0;
        fput_str(if (lang == 0) "Greek words in this passage, " else "Hebrew words in this passage, ");
        if (wu_n == 0) fput_str("all learned") else {
            fput_int(wu_n);
            fput_str(" to learn")
        }
        fput(46);
        ui_set_label_fbuf()
    }
    ui_section("Schedule", "");
    ui_row(UI_ITEM, 0, 0);
    sk_words_of(SK_WORDS_PASSAGE_STATE, i);
    ui_set_title_fbuf();
    fbuf_n = 0;
    fput_str("Added ");
    d: int = sk_local_day(mq_added[i]);
    fput_day_word(d, d);
    ui_set_detail_fbuf();
    ui_section("", "");
    ui_row(UI_BUTTON, ACT_MM_PS_READ, 0);
    ui_set_title("Open in Reader");
    ui_set_tinted();
    ui_rows[ui_last()].strong = false;
    ui_section("", "");
    ui_row(UI_BUTTON, ACT_MM_PS_START_OVER, 0);
    ui_set_title("Start Over");
    ui_set_tinted();
    ui_section("", "");
    ui_row(UI_BUTTON, ACT_MM_PS_DELETE, 0);
    ui_set_title("Delete Passage");
    ui_set_destructive()
}

// ---- Search (DESIGN.md ¬ß5) ----
// What is searched for (kept for the next time), in which scope (0 all, 1
// the Old Testament, 2 the New, 3 the book read as Search opened), whether
// it is a reference too (a row to go there), whether it was searched, and
// what was shown (1 results, 2 recent searches: a change cross-fades).
sk_sq: []i8 = new i8[256](0i8);

sk_sq_n: int = 0;

sk_scope: int = 0;

sk_search_book: int = 0;

sk_search_ref: bool = false;

sk_search_done: bool = false;

sk_search_shown: int = 0;

// The recent searches, newest first (8 kept; the host keeps them:
// SK_KEPT_SEARCHES).
SK_SEARCHES_MOST: int = 8;

sk_searches: []i8 = new i8[2048](0i8);

sk_search_len: []int = new int[8](0);

sk_searches_n: int = 0;

// (Search i's words into fbuf, for the host to keep.)
sk_search_words(i: int) {
    fbuf_n = 0;
    if (i >= 0 && i < sk_searches_n) fput_bytes(sk_searches, i * 256, i * 256 + sk_search_len[i])
}

// A search kept, last (the host's, as it begins).
sk_searches_add(b: []i8, n: int) {
    if (sk_searches_n >= SK_SEARCHES_MOST) return;
    sk_search_set(sk_searches_n, b, 0, n);
    sk_searches_n = sk_searches_n + 1
}

sk_search_set(
    i: int,
    b: []i8,
    from: int,
    n: int
) {
    m: int = if (n > 256) 256 else n;
    for x in 0..m sk_searches[i * 256 + x] = b[from + x];
    sk_search_len[i] = m
}

sk_search_is(i: int): bool {
    if (sk_search_len[i] != sk_sq_n) return false;
    for x in 0..sk_sq_n
        if (sk_searches[i * 256 + x] != sk_sq[x]) return false;
    true
}

// What was searched for, first among the recent searches.
sk_remember_search() {
    if (sk_sq_n == 0 || !sk_search_done) return;
    at: int = -1;
    for i in 0..sk_searches_n
        if (at < 0 && sk_search_is(i)) at = i;
    if (at < 0) at = (if (sk_searches_n < SK_SEARCHES_MOST) sk_searches_n else SK_SEARCHES_MOST - 1);
    if (at >= sk_searches_n) sk_searches_n = at + 1;
    i: int = at;
    while (i > 0) {
        sk_search_set(i, sk_searches, (i - 1) * 256, sk_search_len[i - 1]);
        i = i - 1
    }
    sk_search_set(0, sk_sq, 0, sk_sq_n);
    kept: fn(what: int) = sk_host.save_kept;
    kept(SK_KEPT_SEARCHES)
}

// The search, in its scope: the verses found (text.l8's hit_chapter and
// the rest), and whether it is a reference. (The version read; the BSB's
// under the ESV, at once, the ESV itself a tap away; the Hebrew and Greek
// by its letters, or Latin letters against each word's transliteration.)
sk_run_search() {
    sk_search_ref = false;
    sk_search_done = false;
    sk_esv_results = false;
    hit_count = 0;
    hit_more = false;
    if (sk_sq_n > 0) {
        sk_search_ref = parse_ref(sk_sq, sk_sq_n) && ref_chapter > 0;
        from: int = if (sk_scope == 2) 39 else if (sk_scope == 3) sk_search_book else 0;
        last: int = if (sk_scope == 1) 38 else if (sk_scope == 3) sk_search_book else 65;
        source: TextSource = ready_source(quote_base());
        if (text_cur == TEXT_ORIG) og_search(sk_sq, sk_sq_n, from, last) else source_search(&source,
            sk_sq, sk_sq_n, from, last);
        sk_search_done = true
    }
    // (A platform's results for what was searched before are gone.)
    ui_effect("searched", -1, -1)
}

// Whether the results end with "Search the ESV for ..." (or, under No
// Results, are it): under the ESV, once it is listed.
sk_esv_search_row(): bool {
    text_cur == TEXT_ESV && sk_esv_listed && sk_sq_n > 0 && sk_search_done
}

sk_build_search(id: int) {
    ui_begin(id, SCR_SEARCH, 0, "Search");
    ui_set_search("Search the Bible");
    ui_set_search_text(sk_sq, sk_sq_n);
    ui_search_wait = 200;
    ui_search_focus = true;
    ui_plain = true;
    // (Short titles, so none is cut off; the full names for VoiceOver.)
    b: int = sk_search_book;
    fbuf_n = 0;
    fput_str("All|OT|NT|");
    if (book_name_end(b) - book_name_start(b) > 10) {
        book_short(b);
        fput_bytes(short_name, 0, short_n)
    } else fput_bytes(bsb, book_name_start(b), book_name_end(b));
    at: int = fbuf_n;
    fput_str("All|Old Testament|New Testament|");
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    ui_set_scopes_fbuf(at, sk_scope);
    if (sk_sq_n == 0) {
        if (sk_searches_n == 0) {
            ui_set_empty("magnifyingglass", "Search the Bible", "Find words and phrases across all 66 books.");
            return
        }
        ui_section("Recent Searches", "");
        ui_set_section_button("Clear", ACT_SEARCHES_CLEAR);
        for i in 0..sk_searches_n {
            ui_row(UI_ITEM, ACT_RECENT_SEARCH, i);
            sk_search_words(i);
            ui_set_title_fbuf();
            ui_set_icon("clock.arrow.circlepath");
            ui_set_icon_faint()
        }
        return
    }
    if (sk_search_ref && parse_ref(sk_sq, sk_sq_n)) {
        ui_section("", "");
        ui_row(UI_ITEM, ACT_SEARCH_REF, 0);
        ui_set_icon("arrow.right.circle.fill");
        ui_set_strong();
        c: int = chapter_of(ref_book, ref_chapter);
        fbuf_n = 0;
        fput_str("Go to ");
        fput_ref(c, if (ref_verse > 0) ref_verse else 0, if (ref_verse_end > 0) ref_verse_end else ref_verse);
        ui_set_title_fbuf();
        fbuf_n = 0;
        fput_opening_words(c, ref_verse, 60);
        ui_set_detail_fbuf();
        ui_set_scripture()
    }
    if (sk_esv_results) {
        sk_esv_section();
        return
    }
    esv_row: bool = sk_esv_search_row();
    if (hit_count > 0 || esv_row) {
        ui_section("", "");
        fbuf_n = 0;
        if (hit_count == 0) fput_str("No Results") else {
            fput_int(hit_count);
            if (hit_more) fput(43);
            fput_str(if (hit_count == 1) " verse in the " else " verses in the ");
            fput_str(text_abbrs[quote_base()])
        }
        ui_set_header_fbuf();
        source: TextSource = ready_source(quote_base());
        for i in 0..hit_count sk_hit_row(&source, i);
        if (esv_row) {
            ui_row(UI_ITEM, ACT_ESV_SEARCH, 0);
            fbuf_n = 0;
            fput_str("Search the ESV for \‚\Ä\ú");
            fput_bytes(sk_sq, 0, sk_sq_n);
            fput_str("\‚\Ä\ù");
            ui_set_title_fbuf();
            ui_set_tinted();
            ui_set_icon("globe");
            sk_words(SK_WORDS_ESV_SEARCH);
            if (fbuf_n > 0) ui_set_detail_fbuf()
        }
    }
    if (hit_count == 0 && !sk_search_ref && !esv_row) {
        fbuf_n = 0;
        fput_str("No Results for \‚\Ä\ú");
        fput_bytes(sk_sq, 0, sk_sq_n);
        fput_str("\‚\Ä\ù");
        ui_set_empty("magnifyingglass", "", "Check the spelling or try fewer words.");
        ui_set_empty_title_fbuf()
    }
}

// Search's verse found i: its matches found, then its row.
sk_hit_row(source: *TextSource, i: int) {
    c: int = hit_chapter[i];
    v: int = hit_verse[i];
    if (text_cur == TEXT_ORIG) og_match_ranges(c, v) else source_match_ranges(source,
        c, v);
    sk_hit_marked(c, v)
}

// A verse found, its words in vt and the matches found (mr_begin‚Ä¶): its
// reference, and its words with them marked (begun nearer the first match,
// eight words before it, if it is far in).
sk_hit_marked(c: int, v: int) {
    ui_row(UI_ITEM, ACT_HIT, c * 1000 + v);
    ui_set_custom(CUSTOM_HIT);
    fbuf_n = 0;
    fput_ref(c, v, v);
    ui_set_title_fbuf();
    start: int = 0;
    if (mr_count > 0 && mr_begin[0] > 170) {
        words: int = 0;
        start = mr_begin[0];
        while (start > 0 && words < 9) {
            start = start - 1;
            if (vt[start] as int == 32) words = words + 1
        }
        if (vt[start] as int == 32) start = start + 1
    }
    fbuf_n = 0;
    lead: int = 0;
    if (start > 0) {
        fput_str("\‚\Ä\¶ ");
        lead = 2
    }
    fput_bytes(vt, start, vt_n);
    ui_set_detail_fbuf();
    ui_set_scripture();
    for m in 0..mr_count {
        if (mr_begin[m] >= start) {
            b: int = lead + sk_utf16(vt, start, mr_begin[m]);
            ui_add_mark(b, b + sk_utf16(vt, mr_begin[m], mr_end[m]))
        }
    }
}

// How many UTF-16 units bytes p to e of s are.
sk_utf16(s: []i8, p: int, e: int): int {
    n: int = 0;
    for i in p..e {
        k: int = s[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    n
}

// Search's field typed in (as it rests): searched again; cleared, what was
// searched for kept first among the recent searches.
sk_search_typed(
    id: int,
    buf: []i8,
    b: int,
    e: int
) {
    i: int = sk_find(id);
    if (i < 0) return;
    if (e == b && sk_sq_n > 0) sk_remember_search();
    sk_sq_n = 0;
    for x in b..e {
        if (sk_sq_n < len(sk_sq)) {
            sk_sq[sk_sq_n] = buf[x];
            sk_sq_n = sk_sq_n + 1
        }
    }
    sk_search_again(i, false)
}

// Search made again for its query and scope (retext: its field to show
// the query, a recent search chosen).
sk_search_again(i: int, retext: bool) {
    sk_run_search();
    sk_build(i);
    if (retext) ui_effect("retext", sk_ids[i], -1);
    shown: int = if (sk_sq_n == 0) 2 else 1;
    ui_effect("refill", sk_ids[i], if (shown != sk_search_shown) 1 else 0);
    sk_search_shown = shown
}

// A scope chosen in screen id's field.
sk_scope_chosen(id: int, scope: int) {
    i: int = sk_find(id);
    if (i < 0 || sk_kinds[i] != SCR_SEARCH) return;
    sk_scope = (if (scope < 0 || scope > 3) 0 else scope);
    sk_search_again(i, false)
}

// A book chosen: its chapters (one: the reader there).
sk_pick_book(b: int) {
    if (b < 0 || b >= books) return;
    if (book_count[b] == 1) sk_goto(book_first[b], 0) else sk_open(SCR_CHAPTERS, b,
        true)
}

// A book's chapters: each its number and verses.
sk_build_chapters(id: int, b: int) {
    source: TextSource = text_source(text_cur);
    ui_begin(id, SCR_CHAPTERS, b, "");
    fbuf_n = 0;
    fput_bytes(source.data, source_book_name_start(&source, b), source_book_name_end(&source,
        b));
    ui_set_screen_title_fbuf();
    for n in 1..book_count[b] + 1 {
        c: int = book_first[b] + n - 1;
        ui_row(UI_ITEM, ACT_CHAPTER, c);
        fbuf_n = 0;
        fput_str(if (source_book_is(&source, b, "PSA")) "Psalm " else "Chapter ");
        fput_int(n);
        ui_set_title_fbuf();
        fbuf_n = 0;
        fput_int(ch_verses[c]);
        fput_str(if (ch_verses[c] == 1) " verse" else " verses");
        ui_set_detail_fbuf();
        ui_set_value_detail();
        if (c == sk_c) ui_set_acc(ACC_CHECK)
    }
}

// The versions: each its name, the one read checked.
// The versions (DESIGN.md ¬ß9.3.2): on this device, the original languages
// (the Hebrew and Greek, ¬ß14.11.2) and online (the ESV), each its name and
// a line about it, the one read checked.
sk_build_versions(id: int) {
    ui_begin(id, SCR_VERSIONS, 0, "Version");
    fbuf_n = 0;
    fput_str("On This ");
    fput_str(sk_device);
    ui_section("", "");
    ui_set_header_fbuf();
    for i in 0..len(sk_versions) sk_version_row(sk_versions[i]);
    if (sk_has_orig) {
        ui_section("Original Languages", "");
        sk_version_row(TEXT_ORIG)
    }
    if (sk_esv_listed) {
        ui_section("Online", "");
        fbuf_n = 0;
        fput_str("The ESV comes from Crossway\‚\Ä\ôs ESV API. Only the chapters you\‚\Ä\ôre reading are kept on this ");
        fput_str(sk_device);
        fput(46);
        ui_set_footer_fbuf();
        sk_version_row(TEXT_ESV)
    }
}

sk_version_row(t: int) {
    ui_row(UI_ITEM, ACT_VERSION, t);
    ui_set_title(text_names[t]);
    ui_set_detail(version_lines[t]);
    ui_set_small();
    if (t == text_cur) ui_set_acc(ACC_CHECK);
    // (Read as it is shown, its dots as pauses.)
    fbuf_n = 0;
    fput_str(text_names[t]);
    fput_str(", ");
    line: str = version_lines[t];
    i: int = 0;
    while (i < len(line)) {
        k: int = line[i] as int & 255;
        if (k == 194 && i + 1 < len(line) && (line[i + 1] as int & 255) == 183) {
            // (" ¬∑ " as ", ".)
            if (fbuf_n > 0 && fbuf[fbuf_n - 1] as int == 32) fbuf_n = fbuf_n - 1;
            fput(44);
            i = i + 2
        } else {
            fput(k);
            i = i + 1
        }
    }
    ui_set_label_fbuf()
}

// History (DESIGN.md ¬ß8.3): the trail of chapters read (store.l8 keeps it),
// newest first, a section a day (Today, Yesterday, a weekday, then a date),
// each row its place, its first words and when; a row goes there, swiped
// away is deleted; Clear's menu clears it all.
sk_build_history(id: int) {
    ui_begin(id, SCR_HISTORY, 0, "History");
    ui_set_empty("clock.arrow.circlepath", "No History", "Places you read will appear here.");
    if (hs_n > 0) {
        ui_set_button("Clear");
        ui_command("Clear History", ACT_HISTORY_CLEAR, 0, true)
    }
    today: int = sk_local_day(time(0));
    day: int = -1;
    i: int = hs_n - 1;
    while (i >= 0) {
        d: int = sk_local_day(visits[i].time);
        if (d != day) {
            day = d;
            ui_section("", "");
            fbuf_n = 0;
            if (d == today) fput_str("Today") else if (d == today - 1) fput_str("Yesterday") else if (d > today - 7 && d < today) fput_str(weekday_names[weekday_of(d)]) else fput_date(d);
            ui_set_header_fbuf()
        }
        c: int = visits[i].chapter;
        v: int = if (visits[i].exact) visits[i].verse else 0;
        ui_row(UI_ITEM, ACT_VISIT, i);
        fbuf_n = 0;
        fput_ref(c, v, v);
        ui_set_title_fbuf();
        fbuf_n = 0;
        fput_opening_words(c, if (visits[i].verse > 0) visits[i].verse else 1, 50);
        ui_set_detail_fbuf();
        ui_set_scripture();
        fbuf_n = 0;
        fput_clock(visits[i].time + sk_tz);
        ui_set_trailing_fbuf();
        ui_set_delete(ACT_VISIT_DELETE);
        i = i - 1
    }
}

// The reading settings (DESIGN.md ¬ß6, as the iPhone has them): the
// version (and the Hebrew and Greek's own: its glosses and accents),
// Listen, the text's size, the theme, the font, the layout, what is shown,
// Help, while reading, and the acknowledgements. Rows a platform can't
// have (its host says) are left out; rows that open a screen still the
// platform's own say so (an open effect).
sk_build_settings(id: int) {
    ui_begin(id, SCR_SETTINGS, 0, "Reading");
    orig: bool = text_cur == TEXT_ORIG;
    ui_section("", "");
    ui_row(UI_ITEM, ACT_OPEN, OPEN_VERSIONS);
    ui_set_title("Version");
    ui_set_detail(text_abbrs[text_cur]);
    ui_set_value_detail();
    ui_set_acc(ACC_MORE);
    fbuf_n = 0;
    fput_str("Version, ");
    fput_str(text_names[text_cur]);
    ui_set_label_fbuf();
    ui_set_hint("Choose a translation");
    if (orig) {
        ui_row(UI_ITEM, ACT_OPEN, OPEN_GLOSSES);
        ui_set_title("Glosses");
        ui_set_detail(gloss_names[og_mode(if (sk_c >= 0 && sk_c < chapters && ch_book[sk_c] < 39) 1 else 0)]);
        ui_set_value_detail();
        ui_set_acc(ACC_MORE);
        ui_row(UI_TOGGLE, ACT_ACCENTS, 0);
        ui_set_title("Show Accents");
        ui_set_on(pref_on("origAccents", false))
    }
    fbuf_n = 0;
    fput_str(if (orig) "A word you haven\‚\Ä\ôt learned is glossed under its paragraph with the BSB\‚\Ä\ôs words for it there. Tap a gloss for the word." else "Study, the interlinear and the concordance always use the BSB.");
    ui_set_footer_fbuf();
    if (sk_has_listen) {
        ui_section("", "");
        ui_row(UI_BUTTON, ACT_LISTEN, 0);
        ui_set_custom(CUSTOM_LISTEN);
        ui_row(UI_CHOICE, ACT_LISTEN_RATE, 0);
        ui_set_title("Speed");
        ui_set_options("Slower|Normal|Faster", pref("listenRate", 1));
        ui_row(UI_ITEM, ACT_OPEN, OPEN_VOICE);
        ui_set_title("Voice");
        sk_words(SK_WORDS_VOICE);
        ui_set_detail_fbuf();
        ui_set_value_detail();
        if (orig) ui_set_faint() else ui_set_acc(ACC_MORE);
        sk_words(SK_WORDS_LISTEN_FOOTER);
        ui_set_footer_fbuf()
    }
    ui_section("", "");
    ui_row(UI_SLIDER, ACT_SIZE, 0);
    ui_set_title("Text Size");
    ui_set_range(0, len(size_steps) - 1, pref("sizeStep", 2));
    ui_set_custom(CUSTOM_SIZE);
    fbuf_n = 0;
    fput_str("Also follows the ");
    fput_str(sk_device);
    fput_str(" text size.");
    ui_set_detail_fbuf();
    ui_section("Theme", "");
    ui_row(UI_CHOICE, ACT_THEME, 0);
    ui_set_title("Theme");
    ui_set_options("Auto|Paper|White|Sepia|Night|Black", pref("theme", 0));
    ui_set_custom(CUSTOM_THEMES);
    if (len(sk_fonts) > 0) {
        ui_section("Font", "");
        for i in 0..len(sk_fonts) {
            ui_row(UI_ITEM, ACT_FONT, i);
            ui_set_title(sk_fonts[i]);
            ui_set_custom(CUSTOM_FONT);
            if (i == pref("font", 0)) ui_set_acc(ACC_CHECK)
        }
    }
    ui_section("Layout", "");
    ui_row(UI_CHOICE, ACT_SPACING, 0);
    ui_set_title("Line Spacing");
    ui_set_options("Compact|Normal|Relaxed", pref("spacing", 1));
    ui_row(UI_CHOICE, ACT_MARGINS, 0);
    ui_set_title("Margins");
    ui_set_options("Narrow|Normal|Wide", pref("margins", 1));
    ui_section("Show", "");
    for i in 0..len(sk_show_names) {
        ui_row(UI_TOGGLE, ACT_SHOW, i);
        ui_set_title(sk_show_titles[i]);
        ui_set_on(sk_show(i))
    }
    // (What the version can't show.)
    fbuf_n = 0;
    if (orig) fput_str("The Hebrew and Greek has no headings or footnotes, and doesn\‚\Ä\ôt mark the words of Jesus.") else if (!version_red[text_cur]) {
        fput_str("The ");
        fput_str(text_abbrs[text_cur]);
        fput_str(" doesn\‚\Ä\ôt mark the words of Jesus.")
    }
    ui_set_footer_fbuf();
    if (sk_has_manual) {
        ui_section("Help", "");
        ui_row(UI_ITEM, ACT_OPEN, OPEN_MANUAL);
        ui_set_title("Manual");
        ui_set_icon("book.closed");
        ui_set_acc(ACC_MORE)
    }
    if (sk_has_keep_on) {
        ui_section("While Reading", "The screen stays on while you read. It turns off as usual after 10 minutes without scrolling.");
        ui_row(UI_TOGGLE, ACT_KEEP_ON, 0);
        ui_set_title("Keep Screen On");
        ui_set_on(pref_on("keepScreenOn", false))
    }
    if (sk_has_acknowledgements) {
        ui_section("", "Berean Standard Bible \¬\∑ Public Domain");
        ui_row(UI_ITEM, ACT_OPEN, OPEN_ACKNOWLEDGEMENTS);
        ui_set_title("Acknowledgements");
        ui_set_acc(ACC_MORE)
    }
}

// ---- actions ----
sk_save() {
    f: fn() = sk_host.save_prefs;
    f()
}

sk_act(
    id: int,
    action: int,
    arg: int,
    value: int
) {
    at: int = sk_find(id);
    if (at < 0) return;
    // (The screens over it have gone: it is acted on.)
    sk_n = at + 1;
    if (action >= ACT_LN_PRACTICE && action <= ACT_LN_FORM) {
        sk_ln_act(at, action, arg, value);
        return
    }
    if (action == ACT_DEF_SOURCE) {
        ui_effect_url("https://www.STEPBible.org");
        return
    }
    if (action == ACT_STUDY_DEFINITION) {
        sk_open(SCR_DEFINITION, sk_args[at], true);
        return
    }
    if (action >= ACT_VS_SEGMENT && action <= ACT_VS_ALL) {
        sk_vs_act(at, action, arg, value);
        return
    }
    if (action == ACT_BOOK) {
        sk_pick_book(arg);
        return
    }
    if (action == ACT_PLACE) {
        sk_goto(arg / 1000, arg % 1000);
        return
    }
    if (action == ACT_GOTO_REF) {
        sk_query_books();
        sk_go_ref();
        return
    }
    if (action == ACT_HIT) {
        sk_remember_search();
        sk_goto(arg / 1000, arg % 1000);
        return
    }
    if (action == ACT_SEARCH_REF) {
        sk_remember_search();
        if (parse_ref(sk_sq, sk_sq_n) && ref_chapter > 0) sk_goto(chapter_of(ref_book,
            ref_chapter), if (ref_verse > 0) ref_verse else 0);
        return
    }
    if (action == ACT_RECENT_SEARCH) {
        if (arg < 0 || arg >= sk_searches_n) return;
        sk_sq_n = sk_search_len[arg];
        for x in 0..sk_sq_n sk_sq[x] = sk_searches[arg * 256 + x];
        sk_search_again(at, true);
        return
    }
    if (action == ACT_SEARCHES_CLEAR) {
        sk_searches_n = 0;
        kept: fn(what: int) = sk_host.save_kept;
        kept(SK_KEPT_SEARCHES);
        sk_search_again(at, false);
        return
    }
    if (action == ACT_ESV_SEARCH || action == ACT_ESV_PAGE) {
        ui_effect("esv_search", if (action == ACT_ESV_SEARCH) 1 else arg, -1);
        return
    }
    if (action == ACT_PLAN) {
        ui_effect("open", OPEN_PLAN, arg);
        return
    }
    if (action == ACT_DAY) {
        ui_effect("open", OPEN_DAY, sk_args[at] * 1000 + arg);
        return
    }
    if (action == ACT_DAY_MARK) {
        sk_day_mark(sk_args[at], arg);
        return
    }
    if (action == ACT_BEGIN_BOOK) {
        sk_open(SCR_BEGIN_BOOKS, 0, true);
        return
    }
    if (action == ACT_BEGIN_CHAPTER) {
        if (book_count[ch_book[bg_c]] > 1) sk_open(SCR_BEGIN_CHAPTERS, ch_book[bg_c],
            true);
        return
    }
    if (action == ACT_BEGIN_CHOSEN_BOOK) {
        if (arg >= 0 && arg < books) sk_begin_chosen(at, book_first[arg]);
        return
    }
    if (action == ACT_BEGIN_CHOSEN_CHAPTER) {
        sk_begin_chosen(at, arg);
        return
    }
    if (action == ACT_NR_COLOR) {
        if (value >= 0 && value < RB_COLORS) sk_nr_color = value;
        sk_build(at);
        ui_effect("refill", id, 0);
        return
    }
    if (action == ACT_NR_ADD) {
        // (The ribbon made, the placeholder's name if none is typed; the
        // host goes there, picks it up and says so.)
        rid: int = ribbon_make(sk_nr_name, sk_nr_name_n, bg_c, bg_v, bg_f, time(0));
        if (rid == 0) return;
        _k: bool = ribbon_set_color(rid, sk_nr_color);
        ui_effect("ribbon_added", rid, -1);
        return
    }
    if (action == ACT_RIBBON_COLOR) {
        if (ribbon_set_color(arg, value)) {
            sk_ribbons_kept();
            ui_effect("ribbon_color", arg, -1)
        }
        sk_update_all();
        return
    }
    if (action == ACT_RIBBON_OPEN) {
        i: int = rb_index(arg);
        if (i >= 0) ui_effect("ribbon_open", i, -1);
        return
    }
    if (action == ACT_REMIND || action == ACT_REMIND_TIME || action == ACT_REMIND_SETTINGS) {
        // (The host's: on asks the phone first; it keeps the switch and
        // the time, schedules, and says the screens have changed.)
        ui_effect(if (action == ACT_REMIND) "remind" else if (action == ACT_REMIND_TIME) "remind_time" else "open_settings",
            if (action == ACT_REMIND) arg + 1 else value, if (action == ACT_REMIND) value else -1);
        return
    }
    if (action == ACT_RIBBON_DETAILS) {
        if (rb_index(arg) >= 0) sk_open(SCR_RIBBON, arg, true);
        return
    }
    if (action == ACT_GT_RIBBON_DELETE) {
        ribbon_delete(arg);
        sk_ribbons_kept();
        sk_update_all();
        return
    }
    if (action == ACT_GT_NEW_RIBBON) {
        sk_new_ribbon(sk_c, sk_v, sk_frac, true);
        return
    }
    if (action == ACT_GT_PLANS) {
        sk_open(SCR_PLANS, 0, true);
        return
    }
    if (action >= ACT_GT_PLAN_TODAY && action <= ACT_GT_PLAN_DETAILS) {
        if (arg < 0 || arg >= fw_n) return;
        // (Today's reading in the day's reader; its days; marked, as its
        // days' circle marks it; stopped, as Stop Plan stops it.)
        if (action == ACT_GT_PLAN_MARK) sk_day_mark(fw_plan[arg], plan_today_of(arg,
            sk_today_now())) else if (action == ACT_GT_PLAN_REMOVE) ui_effect("plan_stop",
            fw_plan[arg], -1) else ui_effect(if (action == ACT_GT_PLAN_TODAY) "plan_today" else "plan_details",
            arg, -1);
        return
    }
    if (action == ACT_RIBBON_DELETE) {
        // (Deleted, and popped: the screen under it made again.)
        ribbon_delete(arg);
        sk_ribbons_kept();
        sk_n = at;
        ui_effect("pop", -1, -1);
        sk_update_all();
        return
    }
    if (action == ACT_LIB_SEGMENT || action == ACT_LIB_SORT || action == ACT_LIB_FILTER) {
        // (The rows faded out and in.)
        if (action == ACT_LIB_SEGMENT) {
            sk_lib_seg = (if (value < 0 || value > 3) 0 else value);
            set_pref("librarySegment", sk_lib_seg)
        } else if (action == ACT_LIB_SORT) {
            sk_lib_sort = (if (value == 1) 1 else 0);
            set_pref("librarySort", sk_lib_sort)
        } else sk_lib_filter = (if (value < 0 || value == sk_lib_filter) -1 else value);
        sk_save();
        // (The segment and sort kept as the platform keeps settings.)
        ui_effect("settings", -1, -1);
        sk_update_all();
        return
    }
    if (action == ACT_LIB_ROW) {
        if (arg < 0 || arg >= sk_lr_n) return;
        if (sk_lib_seg == 1) ui_effect("note", sk_lr_c[arg], sk_lr_v[arg] * 1000 + sk_lr_last[arg]) else sk_goto(sk_lr_c[arg],
            sk_lr_v[arg]);
        return
    }
    if (action == ACT_LIB_DELETE) {
        sk_lib_delete(arg);
        sk_update_all();
        return
    }
    if (action == ACT_LIB_EXPORT || action == ACT_LIB_COMPOSE || action == ACT_MM_PRACTICE_ALL || action == ACT_MM_ADD) {
        ui_effect(if (action == ACT_LIB_EXPORT) "export" else if (action == ACT_MM_PRACTICE_ALL) "practice_all" else if (action == ACT_MM_ADD) "mm_add" else "note",
            if (action == ACT_LIB_COMPOSE) sk_c else -1, if (action == ACT_LIB_COMPOSE) 0 else -1);
        return
    }
    if (action == ACT_MM_LANGUAGE) {
        sk_open(SCR_LANGUAGE, arg, true);
        return
    }
    if (action == ACT_MM_PRACTICE || action == ACT_MM_CARDS || action == ACT_MM_DETAILS) {
        ui_effect(if (action == ACT_MM_PRACTICE) "practice" else if (action == ACT_MM_CARDS) "cards" else "passage",
            arg, -1);
        return
    }
    if (action == ACT_MM_DELETE) {
        ui_effect("mm_delete", arg, -1);
        ui_effect("refresh", -1, -1);
        return
    }
    if (action == ACT_MM_ADD_VERSION) {
        sk_mm_vl_owner = 1;
        sk_mm_vl_ver = sk_mm_add_ver;
        sk_open(SCR_MM_VERSIONS, 0, true);
        return
    }
    if (action == ACT_MM_PS_VERSION) {
        i: int = mem_index(sk_args[at]);
        if (i < 0) return;
        sk_mm_vl_owner = 2;
        sk_mm_vl_ver = mq_ver[i];
        sk_mm_vl_id = sk_args[at];
        sk_open(SCR_MM_VERSIONS, 0, true);
        return
    }
    if (action == ACT_MM_VERSION) {
        // (Chosen, and back: Add Passage's, or the passage's own, the
        // host's: the ESV's pins.)
        if (arg < 0 || arg > 5) return;
        sk_mm_vl_ver = arg;
        if (sk_mm_vl_owner == 1) sk_mm_add_ver = arg else ui_effect("mm_version",
            sk_mm_vl_id, arg);
        sk_n = at;
        ui_effect("pop", -1, -1);
        ui_effect("refresh", -1, -1);
        return
    }
    if (action == ACT_MM_ADD_DONE) {
        sk_mm_parse();
        if (!sk_mm_ok) return;
        // (The host makes it: its ESV pins, then back to the Library.)
        ui_effect("mm_added", sk_mm_add_ver, -1);
        sk_n = at;
        ui_effect("pop", -1, -1);
        ui_effect("refresh", -1, -1);
        return
    }
    if (action == ACT_MM_PS_WORDS) {
        i: int = mem_index(sk_args[at]);
        if (i < 0) return;
        // (Its words to learn, as Add Words previews them.)
        sk_ln_ready();
        fbuf_n = 0;
        fput_passage(i);
        sk_preview_range(ch_lang(mq_c1[i]), mq_c1[i], mq_v1[i], mq_c2[i], mq_v2[i]);
        return
    }
    if (action == ACT_MM_PS_READ) {
        i: int = mem_index(sk_args[at]);
        if (i >= 0) sk_goto(mq_c1[i], mq_v1[i]);
        return
    }
    if (action == ACT_MM_PS_START_OVER) {
        i: int = mem_index(sk_args[at]);
        if (i < 0) return;
        memory_start_over(i, sk_today_now(), time(0));
        sk_kept(SK_KEPT_MEMORY);
        sk_update_all();
        return
    }
    if (action == ACT_MM_PS_DELETE) {
        i: int = mem_index(sk_args[at]);
        if (i < 0) return;
        ui_effect("mm_delete", i, -1);
        sk_n = at;
        ui_effect("pop", -1, -1);
        ui_effect("refresh", -1, -1);
        return
    }
    if (action == ACT_STUDY_GRAMMAR) {
        sk_open(SCR_GRAMMAR, sk_args[at], true);
        return
    }
    if (action == ACT_STUDY_CONC) {
        sk_study_ready(sk_args[at]);
        sk_conc_open(sk_args[at], arg / 2 - 1, arg % 2 == 1);
        return
    }
    if (action == ACT_STUDY_LEMMA) {
        sk_study_open(-1, -1, arg >= 100000, arg % 100000, false, true);
        return
    }
    if (action == ACT_LEARN_WORD) {
        sk_study_ready(sk_args[at]);
        lang: int = if (ws_greek) 0 else 1;
        if (learn_add_word(lang, ws_num, FROM_STUDY, sk_today_now(), time(0)) < 0) return;
        ui_effect("learned", lang, -1);
        sk_update_all();
        return
    }
    if (action == ACT_STUDY_FORMS) {
        sk_study_ready(sk_args[at]);
        sk_open(SCR_FORMS, (if (ws_greek) 100000 else 0) + ws_num, true);
        return
    }
    if (action == ACT_INTERLINEAR) {
        // (The verse's interlinear: its Study, at Words.)
        sk_study_ready(sk_args[at]);
        if (ws_vi >= 0) sk_open(SCR_VERSE_STUDY, (v_chapter(ws_vi) * 1000 + v_num(ws_vi)) * 4 + 1,
            true);
        return
    }
    if (action == ACT_ADD_TO_NOTE) {
        // (The app's own: the note's editor.)
        sk_study_ready(sk_args[at]);
        ui_effect("add_to_note", ws_vi, -1);
        return
    }
    if (action == ACT_CONC_SENSE) {
        conc_by_sense = value == 0;
        sk_update_all();
        return
    }
    if (action == ACT_CONC_VERSE) {
        sk_goto(v_chapter(arg), v_num(arg));
        return
    }
    if (action == ACT_CREDIT) {
        if (arg >= 0 && arg < len(ack_links) && len(ack_links[arg]) > 0) ui_effect_url(ack_links[arg]);
        return
    }
    if (action == ACT_CHANGES) {
        sk_open(SCR_CHANGES, 0, true);
        return
    }
    if (action == ACT_COMPARE_STEP) {
        sk_cmp_step(arg);
        sk_update_all();
        return
    }
    if (action == ACT_COMPARE_READ) {
        // (The reader in that version, at these verses.)
        c: int = sk_cmp_c;
        v: int = sk_cmp_vs[0];
        sk_use_version(arg);
        sk_goto(c, v);
        return
    }
    if (action == ACT_GLOSS) {
        // (Kept, the glosses made again, the reader laid out again.)
        if (arg < 0 || arg >= len(gloss_names)) return;
        og_setting = arg;
        set_pref("origGlosses", arg + 1);
        orig_forget();
        sk_save();
        sk_relayout();
        sk_update_all();
        return
    }
    if (action == ACT_HELP_PAGE) {
        // (A page, at its part washed if a part was chosen.)
        t: int = arg % 1000 - 1;
        sk_open(SCR_HELP_PAGE, arg / 1000 * 2000 + (t + 1) * 2 + (if (t >= 0) 1 else 0),
            true);
        return
    }
    if (action == ACT_HELP_LINK) {
        // (A part of this page: scrolled to and washed; another's: pushed.)
        if (arg < 0 || arg >= hpt_n) return;
        g: int = hpt_page[arg];
        a: int = (g * 1000 + arg + 1) * 2 + 1;
        if (sk_kinds[at] == SCR_HELP_PAGE && sk_args[at] / 2000 == g) {
            sk_args[at] = a;
            sk_build(at);
            ui_effect("focus", id, -1)
        } else sk_open(SCR_HELP_PAGE, a, true);
        return
    }
    if (action == ACT_AUDIO_SOURCE || action == ACT_VOICE_CHOSEN || action == ACT_CELLULAR || action == ACT_DOWNLOAD || action == ACT_DOWNLOAD_DELETE) {
        // (The platform's: its recordings, voices and files. The screens
        // made again once it has done it.)
        ui_effect(if (action == ACT_AUDIO_SOURCE) "audio_source" else if (action == ACT_VOICE_CHOSEN) "voice" else if (action == ACT_CELLULAR) "cellular" else if (action == ACT_DOWNLOAD) "download" else "download_delete",
            if (action == ACT_AUDIO_SOURCE) arg / 16 else if (action == ACT_CELLULAR) value else arg,
            if (action == ACT_AUDIO_SOURCE) arg % 16 else -1);
        ui_effect("refresh", -1, -1);
        return
    }
    if (action == ACT_DAY1_START) {
        if (day1_days(bg_c) > 0) ui_effect("plan_start", PLAN_DAY1, -1);
        return
    }
    if (action == ACT_PLAN_START || action == ACT_PLAN_STOP) {
        // (The host's: a plan's file, its reminder, the day's reader.)
        ui_effect(if (action == ACT_PLAN_START) "plan_start" else "plan_stop", arg,
            -1);
        return
    }
    if (action == ACT_CHAPTER) {
        sk_goto(arg, 0);
        return
    }
    if (action == ACT_VISIT) {
        if (arg >= 0 && arg < hs_n) sk_goto(visits[arg].chapter, if (visits[arg].exact) visits[arg].verse else 0);
        return
    }
    if (action == ACT_VISIT_DELETE || action == ACT_HISTORY_CLEAR) {
        if (action == ACT_VISIT_DELETE) history_delete(arg) else hs_n = 0;
        kept: fn(what: int) = sk_host.save_kept;
        kept(SK_KEPT_HISTORY);
        sk_update_all();
        return
    }
    if (action == ACT_VERSION) {
        sk_use_version(arg);
        return
    }
    if (action == ACT_OPEN) {
        // (Versions is core's; the others, the platform's own.)
        if (arg == OPEN_VERSIONS) sk_open(SCR_VERSIONS, 0, true) else if (arg == OPEN_HISTORY) sk_open(SCR_HISTORY,
            0, true) else if (arg == OPEN_GLOSSES) sk_open(SCR_GLOSSES, 0, true) else if (arg == OPEN_VOICES) sk_open(SCR_VOICES,
            0, true) else if (arg == OPEN_ACKNOWLEDGEMENTS) sk_open(SCR_ACKNOWLEDGEMENTS,
            0, true) else if (arg == OPEN_DOWNLOADS) sk_open(SCR_DOWNLOADS, 0, true) else if (arg == OPEN_DOWNLOAD_BOOKS) sk_open(SCR_DOWNLOAD_BOOKS,
            0, true) else ui_effect("open", arg, -1);
        return
    }
    if (action == ACT_LISTEN) {
        ui_effect("listen", -1, -1);
        return
    }
    if (action == ACT_LISTEN_RATE || action == ACT_KEEP_ON) {
        if (action == ACT_LISTEN_RATE) set_pref("listenRate", value) else set_pref_on("keepScreenOn",
            value != 0);
        sk_save();
        ui_effect("settings", -1, -1);
        return
    }
    if (action == ACT_SIZE) set_pref("sizeStep", value) else if (action == ACT_THEME) set_pref("theme",
        value) else if (action == ACT_SPACING) set_pref("spacing", value) else if (action == ACT_MARGINS) set_pref("margins",
        value) else if (action == ACT_SHOW) set_pref_on(sk_show_names[arg], value != 0) else if (action == ACT_FONT) set_pref("font",
        arg) else if (action == ACT_ACCENTS) set_pref_on("origAccents", value != 0) else return;
    sk_save();
    sk_relayout();
    sk_update_all()
}

// The reader at chapter c, verse v, the screens put away (goto: the
// platform's own jump, which may put a sheet away its way).
sk_goto(c: int, v: int) {
    if (c < 0 || c >= chapters) return;
    sk_c = c;
    sk_v = v;
    sk_frac = 0;
    sk_n = 0;
    ui_effect("goto", c, v);
    sk_write_title();
    sk_keep_place();
    sk_save()
}

sk_keep_place() {
    set_pref("chapter", sk_c);
    set_pref("verse", sk_v);
    set_pref("verseOffset", sk_frac)
}

// Version t read, if it is loaded or can be.
sk_use_version(t: int) {
    if (t == text_cur) return;
    host_switch: ?fn(t: int): bool = sk_host.switch_version;
    if (host_switch != null) {
        if (!host_switch(t)) return
    } else if (!sk_switch_version(t)) return;
    set_pref("version", t);
    sk_save();
    ui_effect("reader", chapters, -1);
    sk_relayout();
    sk_write_title();
    sk_update_all()
}

// Version t read: loaded, if it is not, and made the current one.
sk_switch_version(t: int): bool {
    if (t < 0 || t >= TEXT_PIN) return false;
    if (t != text_cur && !tx_ready[t]) {
        sk_want_text = t;
        return false
    }
    text_use(t);
    true
}

// ---- the skin's lines ----
// The app begun: the settings (prefs_parse'd by the host) applied, the
// version read and the place kept, the look, the reader and its place.
sk_start() {
    t: int = pref("version", 0);
    if (t != text_cur && t >= 0 && t < TEXT_PIN) {
        if (tx_ready[t]) text_use(t) else sk_want_text = t
    }
    sk_apply_prefs();
    sk_c = pref("chapter", book_first[42]);
    if (sk_c < 0 || sk_c >= chapters) sk_c = 0;
    sk_v = pref("verse", 0);
    sk_frac = pref("verseOffset", 0);
    sk_write_look();
    ui_effect("reader", chapters, -1);
    ui_effect("jump", sk_c, sk_v);
    sk_write_title()
}

// A field's number at b in line (to e): where it ends, in sk_num_end.
sk_num_end: int = 0;

sk_num(line: []i8, b: int, e: int): int {
    i: int = b;
    while (i < e && line[i] as int == 32) i = i + 1;
    neg: bool = i < e && line[i] as int == 45;
    if (neg) i = i + 1;
    n: int = 0;
    while (i < e && line[i] as int >= 48 && line[i] as int <= 57) {
        n = n * 10 + line[i] as int - 48;
        i = i + 1
    }
    sk_num_end = i;
    if (neg) -n else n
}

sk_word_is(
    line: []i8,
    b: int,
    e: int,
    word: str
): bool {
    if (e - b < len(word)) return false;
    for i in 0..len(word)
        if (line[b + i] != word[i]) return false;
    e - b == len(word) || line[b + len(word)] as int == 32
}

// One line the skin sent (bytes b to e of line, without its newline).
sk_line(line: []i8, b: int, e: int) {
    if (sk_word_is(line, b, e, "start")) {
        sk_width = sk_num(line, b + 5, e);
        sk_height = sk_num(line, sk_num_end, e);
        sk_density = sk_num(line, sk_num_end, e);
        sk_dark = sk_num(line, sk_num_end, e) != 0;
        sk_start()
    } else if (sk_word_is(line, b, e, "want")) sk_write_chapter(sk_num(line, b + 4,
        e)) else if (sk_word_is(line, b, e, "place")) {
        c: int = sk_num(line, b + 5, e);
        v: int = sk_num(line, sk_num_end, e);
        f: int = sk_num(line, sk_num_end, e);
        if (c >= 0 && c < chapters) {
            was: int = sk_c;
            sk_c = c;
            sk_v = v;
            sk_frac = f;
            sk_keep_place();
            if (c != was) sk_write_title()
        }
    } else if (sk_word_is(line, b, e, "act")) {
        id: int = sk_num(line, b + 3, e);
        action: int = sk_num(line, sk_num_end, e);
        arg: int = sk_num(line, sk_num_end, e);
        value: int = sk_num(line, sk_num_end, e);
        sk_act(id, action, arg, value)
    } else if (sk_word_is(line, b, e, "query")) {
        id: int = sk_num(line, b + 5, e);
        at: int = if (sk_num_end < e) sk_num_end + 1 else e;
        sk_query(id, line, at, e)
    } else if (sk_word_is(line, b, e, "text")) {
        id: int = sk_num(line, b + 4, e);
        action: int = sk_num(line, sk_num_end, e);
        arg: int = sk_num(line, sk_num_end, e);
        at: int = if (sk_num_end < e) sk_num_end + 1 else e;
        sk_text(id, action, arg, line, at, e)
    } else if (sk_word_is(line, b, e, "submit")) sk_submit(sk_num(line, b + 6, e)) else if (sk_word_is(line,
        b, e, "scope")) {
        id: int = sk_num(line, b + 5, e);
        sk_scope_chosen(id, sk_num(line, sk_num_end, e))
    } else if (sk_word_is(line, b, e, "tap")) {
        if (sk_word_is(line, b + 4, e, "goto")) sk_open(SCR_GOTO, 0, false) else if (sk_word_is(line,
            b + 4, e, "versions")) sk_open(SCR_VERSIONS, 0, false) else if (sk_word_is(line,
            b + 4, e, "settings")) sk_open(SCR_SETTINGS, 0, false) else if (sk_word_is(line,
            b + 4, e, "history")) sk_open(SCR_HISTORY, 0, false) else if (sk_word_is(line,
            b + 4, e, "search")) sk_open(SCR_SEARCH, 0, false) else if (sk_word_is(line,
            b + 4, e, "library")) sk_open(SCR_LIBRARY, 0, false)
    } else if (sk_word_is(line, b, e, "closed")) {
        i: int = sk_find(sk_num(line, b + 6, e));
        if (i >= 0) sk_closing(i)
    } else if (sk_word_is(line, b, e, "dark")) {
        sk_dark = sk_num(line, b + 4, e) != 0;
        sk_write_look();
        ui_effect("relayout", -1, -1);
        ui_effect("jump", sk_c, sk_v)
    } else if (sk_word_is(line, b, e, "away")) sk_save() else if (sk_word_is(line,
        b, e, "refresh")) sk_update_all()
}

// Each line of bytes b to e (newline-ended), in turn.
sk_lines(buf: []i8, b: int, e: int) {
    p: int = b;
    for i in b..e {
        if (buf[i] as int == 10) {
            sk_line(buf, p, i);
            p = i + 1
        }
    }
}
