// The screen one of OPEN_PLAN, OPEN_DAY1, OPEN_MANUAL, OPEN_VOICE opens,
// pushed (any other: none).
sk_open_kind(what: int, arg: int) {
    kind: int = if (what == OPEN_PLAN) SCR_PLAN else if (what == OPEN_DAY1) SCR_DAY1 else if (what == OPEN_MANUAL) SCR_MANUAL else if (what == OPEN_VOICE) SCR_VOICE else -1;
    if (kind < 0) return;
    if (what == OPEN_PLAN) sk_open_plan(arg, 0, false, true) else sk_open(kind, 0,
        true)
}

