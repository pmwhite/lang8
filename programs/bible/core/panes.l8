tag bible;

use_tag std;

// The two panes a document is read in: the page (pane 0) and the panel's
// reader beside it (pane 1, core/beside.l8's reader screen), read the same
// way on every skin (SKINS.md, Panes). Core keeps what is the documents':
// their parts (`want P C K` answered by `part P C K N`, with every anchor of
// the chapter), which place in one is which in the other (a chapter's link
// map, `link C MODE`), where each pane is read (`at`, in places: a chapter,
// an anchor, how far through its span), and where a jump takes each (`go`).
// The skin keeps what is the platform's: laying parts out, scrolling, and
// following frame by frame by the link map (core/follow.l8's rules, for
// the skins in L8 to call).
import "skin.l8";

import "follow.l8";

PANE_PAGE: int = 0;

PANE_PANEL: int = 1;

PANES: int = 2;

// Each pane's reading line, thousandths of the way down what of it is in
// sight: where its place is read, and where a jump puts a verse (the
// page's a third of the way down; the panel's, often short, at its top).
pane_reading_lines: []int = [333, 0];

// How a pane goes to a place (`go`): there at once (a jump), or brought
// there (the skin glides if it is near).
PANE_GO_AT_ONCE: int = 0;

PANE_GO_BROUGHT: int = 1;

// How a chapter's anchors go with the other pane's (`link C MODE`): verse
// by verse (two versions), or comment by comment (a commentary in either).
LINK_BY_VERSE: int = 0;

LINK_BY_COMMENT: int = 1;

// What a pane reads: the page, the version read; the panel's reader, a
// version or a commentary (nothing while the panel shows no reader).
type PaneDocument =
    | Nothing
    | Version { text: int }
    | Commentary { slot: int }

pane_document(p: int): PaneDocument {
    if (p == PANE_PAGE) {
        match page_document() {
            Module m -> return PaneDocument.Commentary { slot: m.slot };
            Bible -> return PaneDocument.Version { text: text_cur }
        }
    }
    at: int = bb_reader_at();
    if (at < 0) return PaneDocument.Nothing;
    if (sk_kinds[at] == SCR_SHELF_COMMENTARY) PaneDocument.Commentary { slot: sk_args[at] / SHELF_PLACE } else PaneDocument.Version { text: sk_args[at] / SHELF_PLACE }
}

pane_by_comment(p: int): bool {
    match pane_document(p) {
        Commentary _c -> true;
        _ -> false
    }
}

// ---- the page's document ----
// What a place is in (the page's, the history's, a ribbon's, the way
// back's): the Bible, in whichever version is read (a place in it is a
// reference, the same in every version), or a Bookshelf module, by its
// slot (in kept files, by its name: core/store.l8's).
type PlaceDocument =
    | Bible
    | Module { slot: int }

// The page's document: the Bible, or a commentary on the Bookshelf, ready
// to read (pageSlot, its slot plus one; any other, the Bible).
page_document(): PlaceDocument {
    slot: int = pref_get("pageSlot") - 1;
    if (slot < 0) return PlaceDocument.Bible;
    i: int = shelf_find_slot(slot);
    if (i < 0 || !shelf_ready_at(i) || shelf_kind_at(i) != SHELF_KIND_COMMENTARY) return PlaceDocument.Bible;
    PlaceDocument.Module { slot: slot }
}

page_reads_bible(): bool {
    match page_document() {
        Bible -> true;
        Module _m -> false
    }
}

place_documents_same(a: PlaceDocument, b: PlaceDocument): bool {
    place_document_slot(a) == place_document_slot(b)
}

// A document's Bookshelf slot (-1: the Bible).
place_document_slot(d: PlaceDocument): int {
    match d {
        Bible -> -1;
        Module m -> m.slot
    }
}

// The page to read document d (not saved: the caller saves): its parts
// asked for again and its title said; the caller says where it goes.
page_read(d: PlaceDocument) {
    if (place_documents_same(d, page_document())) return;
    match d {
        Bible -> set_pref("pageSlot", 0);
        Module m -> {
            // (Its folio opened, for its parts: Study's use, as beside.)
            set_pref("pageSlot", m.slot + 1);
            i: int = shelf_find_slot(m.slot);
            if (i >= 0) _open: bool = shelf_ensure_open(m.slot)
        }
    }
    pane_forget(PANE_PAGE, -1);
    sk_write_title()
}

// A place's document in a kept file's field: the module's name (none: the
// Bible), onto fbuf; read back from fbuf's from to to (a name no longer on
// the Bookshelf: the Bible).
fput_place_document(d: PlaceDocument) {
    match d {
        Bible -> { }
        Module m -> fput_shelf_name(shelf_find_slot(m.slot))
    }
}

place_document_of_field(from: int, to: int): PlaceDocument {
    if (to <= from) return PlaceDocument.Bible;
    i: int = shelf_find_bytes(fbuf, from, to);
    if (i < 0) return PlaceDocument.Bible;
    PlaceDocument.Module { slot: shelf_slot_at(i) }
}

// ---- where each is read ----
// Each pane's reading line's place as the skin last said (`at`): its
// chapter (-1: not said yet), the anchor there (-1: above the first) and
// thousandths through its span.
type PanePlace = {
    c: int;
    i: int;
    frac: int
}

pane_places: []PanePlace = [PanePlace { c: -1, i: -1, frac: 0 }, PanePlace { c: -1, i: -1, frac: 0 }];

// Which pane a finger last moved (`moving`): for the skin it leads, linked;
// core keeps it to know which is followed when the panel is filled.
pane_leader: int = PANE_PAGE;

// ---- a chapter's anchors ----
// Chapter c's anchors in a pane's document: how many parts it is in (0:
// not known yet, a commentary still opening), each anchor's verse and the
// part it is in, in order, and each anchor's reach (the verse of the first
// anchor after it whose verse is greater; PANE_REACH_END past the last),
// for whether a comment is on a verse. A commentary's chapter it says
// nothing on is in a run of such chapters (gap_from to gap_to, -1 none),
// all shown as one part, chapter gap_from's.
type ChapterAnchors = {
    parts: int;
    verses: []int;
    verse_parts: []int;
    reach: []int;
    gap_from: int;
    gap_to: int
}

PANE_REACH_END: int = 1000000;

// A few chapters' anchors kept for each pane (those used latest).
PANE_ANCHORED_MOST: int = 6;

pane_anchors: []?owned *ChapterAnchors = new ?owned *ChapterAnchors[PANES * PANE_ANCHORED_MOST](null);

pane_anchors_c: []int = new int[PANES * PANE_ANCHORED_MOST](-1);

pane_anchors_used: []int = new int[PANES * PANE_ANCHORED_MOST](0);

pane_clock: int = 0;

// Pane p's chapters' anchors let go (its document changed, or its
// chapters' parts).
pane_anchors_forget(p: int) {
    for s in p * PANE_ANCHORED_MOST..(p + 1) * PANE_ANCHORED_MOST {
        drop pane_anchors[s];
        pane_anchors_c[s] = -1
    }
}

// The slot holding chapter c's anchors for pane p, made if they are not
// kept (-1: they can't be known yet).
pane_anchored(p: int, c: int): int {
    if (c < 0 || c >= chapters) return -1;
    base: int = p * PANE_ANCHORED_MOST;
    oldest: int = base;
    for s in base..base + PANE_ANCHORED_MOST {
        if (pane_anchors_c[s] == c) {
            pane_clock = pane_clock + 1;
            pane_anchors_used[s] = pane_clock;
            return s
        }
        if (pane_anchors_used[s] < pane_anchors_used[oldest]) oldest = s
    }
    if (!pane_anchors_knowable(p)) return -1;
    drop pane_anchors[oldest];
    pane_anchors[oldest] = pane_anchors_made(p, c);
    pane_anchors_c[oldest] = c;
    pane_clock = pane_clock + 1;
    pane_anchors_used[oldest] = pane_clock;
    oldest
}

// Whether chapter c's parts can be known now: a version's text is here; a
// commentary is open.
pane_anchors_knowable(p: int): bool {
    match pane_document(p) {
        Nothing -> false;
        Version v -> v.text == text_cur || text_ready(v.text);
        Commentary m -> shelf_open_is(SHELF_USE_STUDY, m.slot)
    }
}

pane_anchors_made(p: int, c: int): owned *ChapterAnchors {
    own {
        made: *ChapterAnchors = new ChapterAnchors {
            parts: 1,
            verses: new int[0](0),
            verse_parts: new int[0](0),
            reach: new int[0](0),
            gap_from: -1,
            gap_to: -1
        };
        match pane_document(p) {
            Version v -> {
                borrow texts[v.text] as source {
                    parts: VersionParts = pane_version_parts(source, v.text, c);
                    made.parts = len(parts.firsts);
                    made.verses = parts.verses;
                    made.verse_parts = parts.verse_parts
                }
            }
            Commentary m -> {
                parts: CommentParts = shelf_comment_parts(m.slot, c);
                made.parts = (if (parts.division == -2) 0 else len(parts.starts));
                made.verses = parts.verses;
                made.verse_parts = parts.verse_parts;
                made.gap_from = parts.gap_from;
                made.gap_to = parts.gap_to
            }
            Nothing -> { }
        }
        made.reach = pane_reaches(made.verses);
        made
    }
}

// Each anchor's reach: from the last back, keeping the indices of those
// not yet passed by a greater verse.
pane_reaches(verses: []int): []int@new {
    n: int = len(verses);
    reach: []int = new int[n](PANE_REACH_END);
    stack: []int = new int[n](0);
    depth: int = 0;
    for k in 0..n {
        i: int = n - 1 - k;
        while (depth > 0 && verses[stack[depth - 1]] <= verses[i]) depth = depth - 1;
        reach[i] = (if (depth == 0) PANE_REACH_END else verses[stack[depth - 1]]);
        stack[depth] = i;
        depth = depth + 1
    }
    reach
}

pane_part_count(p: int, c: int): int {
    s: int = pane_anchored(p, c);
    if (s < 0) return 0;
    borrow pane_anchors[s] as a {
        a.parts
    }
}

pane_anchor_count(p: int, c: int): int {
    s: int = pane_anchored(p, c);
    if (s < 0) return 0;
    borrow pane_anchors[s] as a {
        len(a.verses)
    }
}

// Anchor i's verse (-1: none) and part (0: none).
pane_anchor_verse(p: int, c: int, i: int): int {
    s: int = pane_anchored(p, c);
    if (s < 0) return -1;
    borrow pane_anchors[s] as a {
        if (i < 0 || i >= len(a.verses)) -1 else a.verses[i]
    }
}

pane_anchor_part(p: int, c: int, i: int): int {
    s: int = pane_anchored(p, c);
    if (s < 0) return 0;
    borrow pane_anchors[s] as a {
        if (i < 0 || i >= len(a.verses)) 0 else a.verse_parts[i]
    }
}

// The index of chapter c's first anchor in part k or after (its count, if
// none): anchors are in their parts' order.
pane_part_first_anchor(p: int, c: int, k: int): int {
    s: int = pane_anchored(p, c);
    if (s < 0) return 0;
    borrow pane_anchors[s] as a {
        low: int = 0;
        high: int = len(a.verses);
        while (low < high) {
            mid: int = (low + high) / 2;
            if (a.verse_parts[mid] < k) low = mid + 1 else high = mid
        }
        low
    }
}

// The index of chapter c's first anchor of verse v (-1: none).
pane_anchor_of(p: int, c: int, v: int): int {
    for i in 0..pane_anchor_count(p, c)
        if (pane_anchor_verse(p, c, i) == v) return i;
    -1
}

// Whether anchor i of chapter c is where verse v is commented on: its
// verse at or before v, and no later anchor going further than it before
// v. (A commentator going back a verse or two, or through the verses
// again, doesn't end the run.)
pane_covers(
    p: int,
    c: int,
    i: int,
    v: int
): bool {
    s: int = pane_anchored(p, c);
    if (s < 0) return false;
    borrow pane_anchors[s] as a {
        i >= 0 && i < len(a.verses) && a.verses[i] > 0 && a.verses[i] <= v && a.reach[i] > v
    }
}

// The first anchor of chapter c commenting on verse v (-1: none).
pane_comment_first(p: int, c: int, v: int): int {
    for i in 0..pane_anchor_count(p, c)
        if (pane_covers(p, c, i, v)) return i;
    -1
}

// The run of chapters without comments chapter c is in, as its first
// (-1: not in one); its last.
pane_gap_from(p: int, c: int): int {
    s: int = pane_anchored(p, c);
    if (s < 0) return -1;
    borrow pane_anchors[s] as a {
        a.gap_from
    }
}

pane_gap_to(p: int, c: int): int {
    s: int = pane_anchored(p, c);
    if (s < 0) return -1;
    borrow pane_anchors[s] as a {
        a.gap_to
    }
}

// The chapter whose parts hold chapter c's place: a run's first, in one.
pane_part_chapter(p: int, c: int): int {
    from: int = pane_gap_from(p, c);
    if (from >= 0) from else c
}

// ---- a version's chapter in parts ----
// Each part is its verses from one that begins a paragraph (or a heading,
// a stanza) PANE_VERSION_PART_BYTES or more of the chapter's records past
// the part's first, so that a reader lays out only the parts near what it
// shows, however long the chapter. (The ESV, whose chapters come one at a
// time from the site, is a part a chapter.)
PANE_VERSION_PART_BYTES: int = 1536;

// Chapter c's parts in version source: each part's first verse (0: the
// chapter's start), and every verse, in order, with the part it is in.
type VersionParts = {
    firsts: []int;
    verses: []int;
    verse_parts: []int
}

pane_version_parts(source: *TextData, t: int, c: int): VersionParts@new {
    if (c < 0 || c >= len(source.starts) || source.starts[c] < 0) return VersionParts { firsts: new int[1](0), verses: new int[0](0), verse_parts: new int[0](0) };
    whole: bool = t == TEXT_ESV;
    // (Counted, then placed.)
    parts: int = 1;
    verses: int = 0;
    for pass in 0..2 {
        made: VersionParts = VersionParts { firsts: new int[if (pass == 0) 0 else parts](0), verses: new int[if (pass == 0) 0 else verses](0), verse_parts: new int[if (pass == 0) 0 else verses](0) };
        part: int = 0;
        verse: int = 0;
        began: int = source.starts[c];
        opens: bool = false;
        p: int = source.starts[c];
        while (p < source.ends[c]) {
            k: int = source.data[p] as int;
            if (k == 'V' as int) {
                n: int = record_key_at(source.data, source.size, p + 1);
                if (!whole && opens && verse > 0 && p - began >= PANE_VERSION_PART_BYTES) {
                    part = part + 1;
                    if (pass == 1) made.firsts[part] = n;
                    began = p
                }
                if (pass == 1) {
                    made.verses[verse] = n;
                    made.verse_parts[verse] = part
                }
                verse = verse + 1;
                opens = false
            } else if (k == 'P' as int || k == 'S' as int || k == 's' as int || k == '_' as int) opens = true else if (k == 'T' as int || k == 'W' as int || k == 'I' as int || k == 'J' as int || k == 'U' as int) opens = false;
            p = record_line_end(source.data, source.size, p) + 1
        }
        if (pass == 1) return made;
        parts = part + 1;
        verses = verse
    }
    VersionParts { firsts: new int[1](0), verses: new int[0](0), verse_parts: new int[0](0) }
}

// ---- parts, as lines ----
// `want P C K`: part k of chapter c of pane p's document, as its lines.
pane_want(p: int, c: int, k: int) {
    if (c < 0 || c >= chapters) return;
    match pane_document(p) {
        Nothing -> { }
        Version v -> {
            if (p == PANE_PAGE && v.text == TEXT_ESV) {
                // (In the ESV, a chapter not here asked for, near the
                // place: core/esv_client.l8.)
                if (c >= sk_c - 1 && c <= sk_c + 2) ew_want(c);
                if (!esv_held(c)) {
                    sk_write_esv_wait(c);
                    return
                }
            }
            if (v.text != text_cur && !text_ready(v.text)) return;
            pane_write_version_part(p, v.text, c, k)
        }
        Commentary m -> pane_write_comment_part(p, m.slot, c, k)
    }
}

// How a pane heads a chapter: the page as a book's page (a rule, the
// book's name or label, the number); the panel, whose title names the
// chapter, in a narrower column, by its number alone.
pane_head(p: int): ChapterHead {
    if (p == PANE_PAGE) ChapterHead.Whole else ChapterHead.NumberOnly
}

// The word a pane's part line begins with (`part P `).
pane_part_word(p: int) {
    ui_str("part ");
    ui_int(p);
    ui_byte(32)
}

// Part k of chapter c of version t as pane p's lines (`part P C K N`),
// marked as the page's verses are, with every verse of the chapter and the
// part it is in.
pane_write_version_part(
    p: int,
    t: int,
    c: int,
    k: int
) {
    region {
        parts: VersionParts = VersionParts { firsts: new int[1](0), verses: new int[0](0), verse_parts: new int[0](0) };
        borrow texts[t] as source {
            parts = pane_version_parts(source, t, c)
        }
        n: int = len(parts.firsts);
        part: int = if (k < 0) 0 else if (k >= n) n - 1 else k;
        // (Its verses: from its first to the one before the next part's.)
        v1: int = parts.firsts[part];
        v2: int = if (part + 1 < n) parts.firsts[part + 1] - 1 else 0;
        sk_lay_part(t, c, pane_head(p), part, v1, v2);
        sk_write_laid(c, p, LaidPart {
            coming: false,
            marked: true,
            esv: t == TEXT_ESV,
            part: part,
            parts: n,
            verses: parts.verses,
            verse_parts: parts.verse_parts,
            gap_from: -1,
            gap_to: -1
        })
    }
}

// Part k of chapter c of the page laid out (into sk_layout and
// sk_ranges), as its part lines say it.
pane_lay_page_part(c: int, k: int) {
    region {
        parts: VersionParts = VersionParts { firsts: new int[1](0), verses: new int[0](0), verse_parts: new int[0](0) };
        borrow texts[text_cur] as source {
            parts = pane_version_parts(source, text_cur, c)
        }
        n: int = len(parts.firsts);
        part: int = if (k < 0) 0 else if (k >= n) n - 1 else k;
        sk_lay_part(text_cur, c, ChapterHead.Whole, part, parts.firsts[part], if (part + 1 < n) parts.firsts[part + 1] - 1 else 0)
    }
}

// The commentaries' parts told as coming (pane, chapter and part), to be
// told again as they come.
PANE_PARTS_COMING_MOST: int = 64;

pane_coming_p: []int = new int[PANE_PARTS_COMING_MOST](0);

pane_coming_c: []int = new int[PANE_PARTS_COMING_MOST](-1);

pane_coming_k: []int = new int[PANE_PARTS_COMING_MOST](-1);

// Part k of chapter c of the commentary in slot as pane p's lines (N 0
// while the commentary is opening): its comments, or a line saying they are
// coming, with every verse the chapter's comments begin and the part each
// is in. A chapter in a run without comments: the run's one part, as its
// first chapter's. Laid out, the parts beside it read ahead; coming,
// noted.
pane_write_comment_part(
    p: int,
    slot: int,
    c: int,
    k: int
) {
    region {
        parts: CommentParts = shelf_comment_parts(slot, c);
        at_c: int = if (parts.gap_from >= 0) parts.gap_from else c;
        part: int = if (k < 0) 0 else if (k >= len(parts.starts)) len(parts.starts) - 1 else k;
        laid: bool = shelf_lay_comment_part(slot, c, part, &sk_layout);
        if (!laid) {
            layout_begin(&sk_layout);
            lay_begin(&sk_layout, STYLE_REF, PARA_PROSE, 0);
            lay_str(&sk_layout, "Opening...")
        }
        measure_chapter(&sk_layout, &sk_ranges, at_c);
        sk_write_laid(at_c, p, LaidPart {
            coming: !laid,
            marked: false,
            esv: false,
            part: part,
            parts: if (parts.division == -2) 0 else len(parts.starts),
            verses: parts.verses,
            verse_parts: parts.verse_parts,
            gap_from: parts.gap_from,
            gap_to: parts.gap_to
        });
        if (laid) {
            pane_part_coming_done(p, at_c, part);
            _held: bool = shelf_comment_part_ahead(slot, at_c, part)
        } else pane_part_coming(p, at_c, part)
    }
}

pane_part_coming(p: int, c: int, k: int) {
    free: int = -1;
    for s in 0..PANE_PARTS_COMING_MOST {
        if (pane_coming_c[s] == c && pane_coming_k[s] == k && pane_coming_p[s] == p) return;
        if (pane_coming_c[s] < 0 && free < 0) free = s
    }
    // (Full: the oldest let go; the skin asks again as it shows it.)
    if (free < 0) free = 0;
    pane_coming_p[free] = p;
    pane_coming_c[free] = c;
    pane_coming_k[free] = k
}

pane_part_coming_done(p: int, c: int, k: int) {
    for s in 0..PANE_PARTS_COMING_MOST {
        if (pane_coming_c[s] == c && pane_coming_k[s] == k && pane_coming_p[s] == p) pane_coming_c[s] = -1
    }
}

// A commentary's text come (shelf_screens_changed): its chapters' parts
// known now, and each part told as coming told again, in whichever pane
// reads it.
pane_comments_came() {
    for p in 0..PANES {
        match pane_document(p) {
            Commentary m -> {
                pane_anchors_forget(p);
                pane_links_forget();
                for s in 0..PANE_PARTS_COMING_MOST {
                    c: int = pane_coming_c[s];
                    if (c >= 0 && pane_coming_p[s] == p) {
                        pane_coming_c[s] = -1;
                        pane_write_comment_part(p, m.slot, c, pane_coming_k[s])
                    }
                }
                // (Its maps, now its anchors are known.)
                for q in 0..PANES
                    if (pane_places[q].c >= 0) pane_links_near(pane_places[q].c)
            }
            _ -> { }
        }
    }
}

// ---- the skin's lines ----
// `at P C I FRAC`: pane p's reading line's place: the page's kept as the
// reading place (its verse, how far through it), the panel's chapter named
// in its title; the link maps of the chapters near it sent.
pane_at(
    p: int,
    c: int,
    i: int,
    frac: int
) {
    if (p < 0 || p >= PANES || c < 0 || c >= chapters) return;
    pane_places[p].c = c;
    pane_places[p].i = i;
    pane_places[p].frac = (if (frac < 0) 0 else if (frac > 999) 999 else frac);
    v: int = if (i < 0) 0 else pane_anchor_verse(p, c, i);
    if (v < 0) v = 0;
    if (p == PANE_PAGE) {
        was: int = sk_c;
        sk_c = c;
        sk_v = v;
        sk_frac = pane_places[p].frac;
        sk_keep_place();
        if (c != was) sk_write_title()
    } else bb_reader_placed(pane_place_chapter(p, c), v);
    pane_links_near(c)
}

// A place's chapter: in a run of chapters a commentary says nothing on,
// the page's if it is in the run (wherever the page is in a run, the run's
// one part shows it), else the run's first.
pane_place_chapter(p: int, c: int): int {
    to: int = pane_gap_to(p, c);
    if (to >= 0 && sk_c >= c && sk_c <= to) sk_c else c
}

// `rest P ENDS_HI MS`: pane p at rest: the page's counted as read
// (core/reading.l8).
pane_rest(p: int, ends_hi: int, ms: int) {
    // (Reading counted in the Bible alone: a commentary on the page isn't
    // its chapter read.)
    if (p != PANE_PAGE || pane_places[p].c < 0 || !page_reads_bible()) return;
    now: f64 = ms as f64 / 1000.0f64;
    rd_rest(sk_c, sk_v, sk_frac, ends_hi >= sk_c, ends_hi, now);
    // (Reading the ESV: the chapters around the place asked for.)
    if (text_cur == TEXT_ESV) ew_rest(sk_c, ends_hi);
    lw_dragged(false, now);
    sk_wake();
    sk_awake()
}

// `moving P MS`: a finger on pane p: it leads, and the other's glide is
// stopped (`halt`), so that it can be held still.
pane_moving(p: int, ms: int) {
    if (p < 0 || p >= PANES) return;
    pane_leader = p;
    pane_write_pane_line("halt ", 1 - p);
    if (p == PANE_PAGE) {
        rd_scroll(ms as f64 / 1000.0f64);
        lw_dragged(true, 0.0f64);
        sk_wake()
    }
}

pane_write_pane_line(word: str, p: int) {
    ui_str(word);
    ui_int(p);
    ui_byte(10)
}

// ---- telling a pane where to go ----
// `go P C I FRAC MODE`: pane p's reading line to anchor i of chapter c (-1:
// the chapter's top), frac thousandths through its span; the link maps
// near it sent first.
pane_go(
    p: int,
    c: int,
    i: int,
    frac: int,
    mode: int
) {
    if (p < 0 || p >= PANES || c < 0 || c >= chapters) return;
    pane_links_near(c);
    ui_str("go ");
    ui_int(p);
    ui_byte(32);
    ui_int(c);
    ui_byte(32);
    ui_int(if (i < 0) -1 else i);
    ui_byte(32);
    ui_int(if (frac < 0) 0 else if (frac > 999) 999 else frac);
    ui_byte(32);
    ui_int(mode);
    ui_byte(10);
    pane_places[p].c = c;
    pane_places[p].i = i;
    pane_places[p].frac = frac
}

// Pane p to verse v of chapter c (0: its top), frac through it: its first
// anchor of the verse (a commentary's: the first comment on it).
pane_go_verse(
    p: int,
    c: int,
    v: int,
    frac: int,
    mode: int
) {
    if (c < 0 || c >= chapters) return;
    gap: int = pane_gap_from(p, c);
    if (gap >= 0) {
        pane_go(p, gap, -1, 0, mode);
        return
    }
    i: int = if (v <= 0) -1 else if (pane_by_comment(p)) pane_comment_first(p, c,
        v) else pane_anchor_of(p, c, v);
    pane_go(p, c, i, if (i < 0 || pane_by_comment(p)) 0 else frac, mode)
}

// `forget P C`: pane p's parts of chapter c (-1: every chapter) to be
// asked for again; what core knows of them let go.
pane_forget(p: int, c: int) {
    if (c < 0) pane_anchors_forget(p);
    pane_links_forget();
    ui_str("forget ");
    ui_int(p);
    ui_byte(32);
    ui_int(c);
    ui_byte(10)
}

// ---- the link maps ----
// The chapters whose link maps were sent latest, since the panel's
// document (or either's parts) last changed: each sent again once it has
// left them, as it comes near again, so that a skin need keep only the
// maps of the PANE_LINKS_KEPT + 2 chapters said latest (SKINS.md).
PANE_LINKS_KEPT: int = 6;

pane_linked_sent: []int = new int[PANE_LINKS_KEPT](-1);

pane_linked_next: int = 0;

pane_links_forget() {
    for k in 0..PANE_LINKS_KEPT pane_linked_sent[k] = -1
}

pane_link_sent(c: int): bool {
    for k in 0..PANE_LINKS_KEPT
        if (pane_linked_sent[k] == c) return true;
    false
}

// Whether the panel's reader is linked with the page.
pane_linked(): bool {
    bb_reader_at() >= 0 && sk_beside_linked()
}

// The link maps of chapter c and those either side of it, each once, while
// the panel shows a reader.
pane_links_near(c: int) {
    if (bb_reader_at() < 0) return;
    for x in c - 1..c + 2 {
        if (x >= 0 && x < chapters && !pane_link_sent(x)) pane_write_link(x)
    }
}

// `link C MODE COMMENTS`, its `match I0 I1 J` lines, `end`: which anchors
// of chapter c go with which. Two versions, verse by verse: the page's
// anchor I0 (I1 the same) with the panel's J (a verse one lacks, none). A
// version and a commentary (COMMENTS the pane the commentary is in): the
// version's verses I0 to I1 with the comment J that covers them. Two
// commentaries: none. Not sent while either's anchors can't be known (a
// commentary opening, a version still to come): sent once they can be.
pane_write_link(c: int) {
    if (pane_anchored(PANE_PAGE, c) < 0 || pane_anchored(PANE_PANEL, c) < 0) return;
    comments: int = if (pane_by_comment(PANE_PANEL)) PANE_PANEL else if (pane_by_comment(PANE_PAGE)) PANE_PAGE else -1;
    if (comments >= 0 && pane_by_comment(1 - comments)) return;
    pane_linked_sent[pane_linked_next] = c;
    pane_linked_next = (pane_linked_next + 1) % PANE_LINKS_KEPT;
    mode: int = if (comments >= 0) LINK_BY_COMMENT else LINK_BY_VERSE;
    ui_str("link ");
    ui_int(c);
    ui_byte(32);
    ui_int(mode);
    ui_byte(32);
    ui_int(if (comments >= 0) comments else PANE_PANEL);
    ui_byte(10);
    if (mode == LINK_BY_VERSE) {
        for i in 0..pane_anchor_count(PANE_PAGE, c) {
            j: int = pane_anchor_of(PANE_PANEL, c, pane_anchor_verse(PANE_PAGE, c,
                i));
            if (j >= 0) pane_write_match(i, i, j)
        }
    } else {
        // (A comment covers the verses from its own to the one before the
        // next comment that goes further: pane_covers.)
        verses: int = 1 - comments;
        n: int = pane_anchor_count(verses, c);
        for j in 0..pane_anchor_count(comments, c) {
            first: int = -1;
            last: int = -1;
            for i in 0..n {
                if (pane_covers(comments, c, j, pane_anchor_verse(verses, c, i))) {
                    if (first < 0) first = i;
                    last = i
                }
            }
            if (first >= 0) pane_write_match(first, last, j)
        }
    }
    ui_str("end\n")
}

pane_write_match(i0: int, i1: int, j: int) {
    ui_str("match ");
    ui_int(i0);
    ui_byte(32);
    ui_int(i1);
    ui_byte(32);
    ui_int(j);
    ui_byte(10)
}

// ---- jumps ----
// The page jumped to chapter c, verse v, frac through it (Go To, a link,
// a ribbon, the way back): there at once, and the panel's reader, linked,
// there too (a commentary at the first comment on the verse).
pane_page_jump(c: int, v: int, frac: int) {
    pane_go_verse(PANE_PAGE, c, v, frac, PANE_GO_AT_ONCE);
    pane_leader = PANE_PAGE;
    if (pane_linked()) pane_go_verse(PANE_PANEL, c, v, frac, PANE_GO_AT_ONCE)
}

// The page to chapter c, verse v, frac through it, at once, the panel's
// reader left where it is (core moves it itself: Swap Panes).
pane_page_jump_alone(c: int, v: int, frac: int) {
    pane_go_verse(PANE_PAGE, c, v, frac, PANE_GO_AT_ONCE);
    pane_leader = PANE_PAGE
}

// The panel's reader to the page's chapter c, verse v, brought there
// (relinked; verses selected).
pane_panel_to(c: int, v: int, frac: int) {
    pane_leader = PANE_PAGE;
    pane_go_verse(PANE_PANEL, c, v, frac, PANE_GO_BROUGHT)
}

// The panel's reader begun anew (opened, or its document changed): its
// parts and link maps forgotten; it opens at the page's place.
pane_panel_begun() {
    pane_forget(PANE_PANEL, -1);
    pane_places[PANE_PANEL].c = -1;
    pane_leader = PANE_PAGE;
    for s in 0..PANE_PARTS_COMING_MOST {
        if (pane_coming_p[s] == PANE_PANEL) pane_coming_c[s] = -1
    }
}

// The panel's reader's screen shown (made, or made again): to the page's
// place if it has none yet, else staying where it is.
pane_panel_shown() {
    if (pane_places[PANE_PANEL].c >= 0) return;
    pane_go_verse(PANE_PANEL, sk_c, sk_v, sk_frac, PANE_GO_AT_ONCE)
}

// Every chapter laid out again (the look, the settings, the version): both
// panes' parts asked for again, each at its place.
pane_relayout() {
    pane_forget(PANE_PAGE, -1);
    pane_go_verse(PANE_PAGE, sk_c, sk_v, sk_frac, PANE_GO_AT_ONCE);
    if (bb_reader_at() < 0) return;
    pane_forget(PANE_PANEL, -1);
    place: PanePlace = pane_places[PANE_PANEL];
    if (place.c >= 0) pane_go(PANE_PANEL, place.c, place.i, place.frac, PANE_GO_AT_ONCE)
}

// `line P THOUSANDTHS` for each pane: where its reading line is (at
// `start`).
pane_write_lines() {
    for p in 0..PANES {
        ui_str("line ");
        ui_int(p);
        ui_byte(32);
        ui_int(pane_reading_lines[p]);
        ui_byte(10)
    }
}
