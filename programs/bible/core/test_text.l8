find(q: str, from: int, last: int) raises IoError {
    b: []i8 = bytes(q);
    search(b, len(b), from, last);
    write(1, q);
    write(1, ": ");
    write_int(1, hit_count);
    if (hit_more) write(1, "+");
    for i in 0..mini(hit_count, 4) {
        write(1, " ");
        title_of(hit_chapter[i]);
        print_out(0, out_n);
        write(1, ":");
        write_int(1, hit_verse[i])
    }
    print("")
}

