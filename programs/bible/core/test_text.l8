// 3 John 1 with a verse 15 keyed as 14 (as the ESV's), as text 5.
load_merged() noregion {
    load();
    c: int = book_first[63];
    e: int = ch_end[c];
    add: str = """
V15>14
TPeace to you.
""";
    buf: []i8 = new i8[bsb_n + len(add)](0i8);
    for i in 0..e buf[i] = bsb[i];
    for i in 0..len(add) buf[e + i] = add[i] as i8;
    for i in e..bsb_n buf[i + len(add)] = bsb[i];
    tx_ready[5] = false;
    text_load(5, buf, bsb_n + len(add))
}

test "two verses keyed as one" {
    load_merged();
    text_use(5);
    c: int = book_first[63];
    layout_chapter(c);
    i: int = verse_count - 1;
    write_int(1, verse_shown[i]);
    write(1, " keyed ");
    write_int(1, verse_num[i]);
    write(1, ", ");
    write_int(1, ch_verses[c]);
    write(1, " verses, shown to ");
    write_int(1, verse_shown_last(c, 14));
    print("");
    _n: int = verse_text(c, 14);
    print_vt();
    text_use(0);
    expect {|
        15 keyed 14, 14 verses, shown to 15
        Instead, I hope to see you soon and speak with you face to face. Peace to you. The friends here send you greetings. Greet each of our friends there by name. Peace to you.|
    |}
}

test "switching texts leaves the BSB's layout as it was" {
    load();
    load_version(1, "programs/bible/data/kjv.txt");
    c: int = book_first[42] + 2;
    layout_chapter(c);
    n: int = out_n;
    r: int = runs;
    sum: int = 0;
    for i in 0..out_n sum = (sum * 31 + out[i] as int) % 1000000007;
    text_use(1);
    layout_chapter(c);
    text_use(0);
    layout_chapter(c);
    same: bool = out_n == n && runs == r;
    sum2: int = 0;
    for i in 0..out_n sum2 = (sum2 * 31 + out[i] as int) % 1000000007;
    print(if (same && sum == sum2) "the same" else "changed");
    expect {|
        the same
    |}
}

range(s: str) raises IoError {
    b: []i8 = bytes(s);
    write(1, s);
    write(1, " = ");
    if (!parse_range(b, len(b))) {
        print("none");
        return
    }
    write_bytes_n(1, slice_bsb(book_name_start(ref_book), book_name_end(ref_book)),
        book_name_end(ref_book) - book_name_start(ref_book));
    write(1, " ");
    write_int(1, ch_num[rg_c1]);
    write(1, ":");
    write_int(1, rg_v1);
    write(1, "-");
    write_int(1, ch_num[rg_c2]);
    write(1, ":");
    write_int(1, rg_v2);
    write(1, ", ");
    write_int(1, rg_verses);
    print(" verses")
}

test "passages typed, across chapters and whole" {
    load();
    for s in ["isa 52:13-53:12", "isa 52:13\�\�\�53:12", "ps 23", "ps 117", "rom 8:28-39",
        "rom 8-9", "jn 3:16", "john 3:16-17", "jude 3-5", "jude", "jude 1:3", "rom 8-9:5",
        "rom 8:28-9", "ps", "rom 8:30-99", "xyz 3", "phil 4:6-7"] range(s);
    expect {|
        isa 52:13-53:12 = Isaiah 52:13-53:12, 15 verses
        isa 52:13–53:12 = Isaiah 52:13-53:12, 15 verses
        ps 23 = Psalms 23:1-23:6, 6 verses
        ps 117 = Psalms 117:1-117:2, 2 verses
        rom 8:28-39 = Romans 8:28-8:39, 12 verses
        rom 8-9 = Romans 8:1-9:33, 72 verses
        jn 3:16 = John 3:16-3:16, 1 verses
        john 3:16-17 = John 3:16-3:17, 2 verses
        jude 3-5 = Jude 1:3-1:5, 3 verses
        jude = Jude 1:1-1:25, 25 verses
        jude 1:3 = Jude 1:3-1:3, 1 verses
        rom 8-9:5 = Romans 8:1-9:5, 44 verses
        rom 8:28-9 = none
        ps = none
        rom 8:30-99 = Romans 8:30-8:39, 10 verses
        xyz 3 = none
        phil 4:6-7 = Philippians 4:6-4:7, 2 verses
    |}
}

// The web's first paint (WEB.md §W1.8): John's lines alone, held with every
// other book's chapters empty, give John 3 the same number, keys and layout
// as the whole version.
whole_out: []i8 = new i8[262144](0i8);

whole_runs: []int = new int[8192](0);

test "a chapter from its book alone" {
    load();
    c: int = book_first[42] + 2;
    layout_chapter(c);
    n: int = out_n;
    r: int = runs;
    vc: int = verse_count;
    for i in 0..n whole_out[i] = out[i];
    for i in 0..r whole_runs[i] = run_end[i] * 64 + run_style[i];
    // (John's lines, from its B line to the next.)
    p: int = book_line[42];
    e: int = book_line[43];
    john: []i8 = new i8[e - p](0i8);
    for i in p..e john[i - p] = bsb[i];
    room: []i8 = new i8[text_book_room(42, e - p)](0i8);
    text_load_book(1, 42, john, e - p, room);
    text_use(1);
    write_int(1, chapters);
    write(1, " chapters, John 3 is ");
    write_int(1, book_first[42] + 2);
    write(1, ", Genesis 1 has ");
    write_int(1, ch_verses[0]);
    write(1, " verses, John 3 ");
    write_int(1, ch_verses[c]);
    print("");
    layout_chapter(c);
    same: bool = out_n == n && runs == r && verse_count == vc;
    if (same) {
        for i in 0..n
            if (out[i] != whole_out[i]) same = false;
        for i in 0..r
            if (run_end[i] * 64 + run_style[i] != whole_runs[i]) same = false
    }
    print(if (same) "laid out the same" else "laid out otherwise");
    expect {|
        1189 chapters, John 3 is 999, Genesis 1 has 0 verses, John 3 36
        laid out the same
    |}
}

// The page's column (DESIGN.md §17.2.1): an iPhone's width less its
// margins, never capped; a wide window's at most 34 em, whatever the size;
// and a place the same verse and fraction at another width (§17.2.2).
test "the column, and the place at any width" {
    print_fixed(column_width(393.0f64, 28.0f64, 19.0f64), 1);
    print_fixed(column_width(440.0f64, 20.0f64, 19.0f64), 1);
    print_fixed(column_width(1366.0f64, 28.0f64, 19.0f64), 1);
    print_fixed(column_width(1366.0f64, 28.0f64, 19.0f64) / 19.0f64, 1);
    print_fixed(column_width(1366.0f64, 28.0f64, 30.0f64) / 30.0f64, 1);
    print_fixed(column_width(1032.0f64 - 391.0f64, 28.0f64, 19.0f64) / 19.0f64, 1);
    load();
    c: int = book_first[42] + 2;
    layout_chapter(c);
    // (A column of 337 points, two characters an em of 19: 35 a line; of
    // 646, 68.)
    narrow: int = (column_width(393.0f64, 28.0f64, 19.0f64) / 9.5f64) as int;
    broad: int = (column_width(1024.0f64, 28.0f64, 19.0f64) / 9.5f64) as int;
    y: f64 = wp_y(16, 0.42f64, narrow);
    wp_at(y, narrow);
    write_int(1, wp_v);
    write(1, " +");
    print_fixed(wp_em, 2);
    y2: f64 = wp_y(wp_v, wp_em, broad);
    wp_at(y2, broad);
    write_int(1, wp_v);
    write(1, " +");
    print_fixed(wp_em, 2);
    print(if (y2 < y) "higher on the page at 1024" else "not higher");
    expect {|
        337.0
        400.0
        646.0
        34.0
        34.0
        30.8
        16 +0.42
        16 +0.42
        higher on the page at 1024
    |}
}
