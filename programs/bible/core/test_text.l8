test "the KJV, laid out as the BSB is" {
    load();
    load_version(1, "programs/bible/data/kjv.txt");
    text_use(1);
    c: int = book_first[42] + 2;
    layout_chapter(c);
    show_verses(15, 16);
    _n: int = verse_text(c, 16);
    print_vt();
    // (Genesis 1:4's words the translators supplied, a run of their own.)
    layout_chapter(0);
    p: int = 0;
    for r in 0..runs {
        if (run_style[r] == STYLE_SUPPLIED && p < verse_end[3] && run_end[r] > verse_begin[3]) {
            print_out(p, run_end[r]);
            print("|")
        }
        p = run_end[r]
    }
    text_use(0);
    expect {|
        16: 16 For God…ng life.|
        For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have everlasting life.|
         it was|
    |}
}

test "a verse the BSB gives in a footnote" {
    load();
    load_version(1, "programs/bible/data/kjv.txt");
    c: int = book_first[39] + 16;
    layout_chapter(c);
    write_int(1, verse_find(21));
    print(" in the BSB");
    text_use(1);
    layout_chapter(c);
    show_verses(verse_find(21), verse_find(21) + 1);
    text_use(0);
    write(1, "KJV has it: ");
    print(if (text_has(1, c, 21)) "yes" else "no");
    write(1, "BSB has it: ");
    print(if (text_has(0, c, 21)) "yes" else "no");
    expect {|
        -1 in the BSB
        21: 21 Howbeit…fasting.|
        KJV has it: yes
        BSB has it: no
    |}
}

