// The verse table: each verse's number and its text in out, from its number
// to its end.
show_verses(from: int, to: int) raises IoError {
    for i in from..mini(to, verse_count) {
        write_int(1, verse_num[i]);
        write(1, ": ");
        k: int = verse_begin[i];
        e: int = verse_end[i];
        // (Its first 12 and last 8 bytes.)
        if (e - k <= 24) print_out(k, e) else {
            print_out(k, k + 12);
            write(1, "\�\�\�");
            print_out(e - 8, e)
        }
        print("|")
    }
}

