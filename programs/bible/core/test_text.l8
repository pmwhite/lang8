tag bible_tests;

use_tag std, bible;

// The text's index, and chapters laid out as runs (what the iPhone app makes
// attributed strings of), read from data/bsb.txt.
import "../../../stdlib/print.l8";

import "text.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

load() noregion {
    fd: int = open("programs/bible/data/bsb.txt", 0, 0);
    n: int = 8388608;
    bsb = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, bsb, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    text_use(0);
    text_load(0, bsb, got)
}

// Another version (data/kjv.txt and the rest) as text t, once.
read_into(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    n: int = 8388608;
    buf: []i8 = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, buf, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    read_n = got;
    buf
}

read_n: int = 0;

load_version(t: int, path: str) noregion {
    if (tx_ready[t]) return;
    buf: []i8 = read_into(path);
    text_load(t, buf, read_n)
}

print_out(p: int, e: int) raises IoError {
    write_bytes_n(1, slice_of(p, e), e - p)
}

slice_buf: []i8 = new i8[262144](0i8);

slice_of(p: int, e: int): []i8 {
    for i in p..e slice_buf[i - p] = out[i];
    slice_buf
}

// The runs, one a line: style, paragraph kind, and the text (newlines as /).
show_runs(most: int) raises IoError {
    p: int = 0;
    for r in 0..mini(runs, most) {
        write_int(1, run_style[r]);
        write(1, " ");
        write_int(1, run_para[r]);
        write(1, " ");
        for i in p..run_end[r] {
            k: int = out[i] as int;
            if (k == 10) write(1, "/") else write_byte(1, out[i])
        }
        print("");
        p = run_end[r]
    }
}

mini(a: int, b: int): int {
    if (a < b) a else b
}

test "the index" {
    load();
    write_int(1, books);
    write(1, " books, ");
    write_int(1, chapters);
    print(" chapters");
    for b in [0, 18, 21, 30, 39, 56, 65] {
        print_title(book_first[b]);
        write(1, " to ");
        print_title(book_first[b] + book_count[b] - 1);
        print("")
    }
    expect {|
        66 books, 1189 chapters
        Genesis 1 to Genesis 50
        Psalm 1 to Psalm 150
        Song of Solomon 1 to Song of Solomon 8
        Obadiah to Obadiah
        Matthew 1 to Matthew 28
        Philemon to Philemon
        Revelation 1 to Revelation 22
    |}
}

print_title(c: int) raises IoError {
    title_of(c);
    print_out(0, out_n)
}

