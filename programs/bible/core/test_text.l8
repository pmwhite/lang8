// The runs, one a line, each cut after n bytes.
show_runs_cut(most: int, n: int) raises IoError {
    p: int = 0;
    for r in 0..mini(runs, most) {
        write_int(1, run_style[r]);
        write(1, " ");
        write_int(1, run_para[r]);
        write(1, " ");
        e: int = mini(run_end[r], p + n);
        for i in p..e {
            k: int = out[i] as int;
            if (k == 10) write(1, "/") else write_byte(1, out[i])
        }
        if (e < run_end[r]) write(1, "\�\�\�");
        print("");
        p = run_end[r]
    }
}

