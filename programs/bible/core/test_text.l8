        11 c|
        16 ”|
    |}
}

show_xref(s: str) raises IoError {
    fbuf_t_n = 0;
    for k in s fbuf_t[fbuf_t_n] = k;
    // (Copied into bsb's end, past the text, to be scanned there.)
    base: int = bsb_n + 16;
    for i in 0..len(s) bsb[base + i] = s[i];
    if (xref_scan(base, base + len(s))) {
        write_int(1, xr_book);
        write(1, " ");
        write_int(1, xr_c);
        write(1, ":");
        write_int(1, xr_v);
        write(1, " to ");
        write_int(1, xr_ce);
        write(1, ":");
        write_int(1, xr_ve);
        both: int = xref_both();
        xref_unpack(both);
        write(1, " = ");
        write_int(1, xr_book);
        write(1, " ");
        write_int(1, xr_c);
        write(1, ":");
        write_int(1, xr_v);
        write(1, " to ");
        write_int(1, xr_ce);
        write(1, ":");
        write_int(1, xr_ve);
        print("")
    } else print("none")
}

fbuf_t: []i8 = new i8[64](0i8);

fbuf_t_n: int = 0;

