tag bible_study_internal;

use_tag bible, std;

import "skin.l8";

// Owns study subjects, derived lexical data and concordance filtering.
// The coordinator readies a subject before reading its shared study values.

// ---- the word study (DESIGN.md ¬ß7.5, ¬ß10, ¬ß14.5) ----
// Each study's subject (a screen's arg): the verse and word (a lemma's:
// -1), its language and number, and whether it came from the interlinear.
SK_SUBJECTS: int = 16;

sk_sub_vi: []int = new int[16](0);

sk_sub_w: []int = new int[16](0);

sk_sub_greek: []bool = new bool[16](false);

sk_sub_num: []int = new int[16](0);

sk_sub_il: []bool = new bool[16](false);

sk_sub_next: int = 0;

// A word's study (word w of verse vi; a lemma's, w -1), pushed or
// presented.
tag bible
sk_study_open(
    vi: int,
    w: int,
    greek: bool,
    num: int,
    from_il: bool,
    push: bool
) {
    s: int = sk_sub_next % SK_SUBJECTS;
    sk_sub_next = sk_sub_next + 1;
    sk_sub_vi[s] = vi;
    sk_sub_w[s] = w;
    sk_sub_greek[s] = greek;
    sk_sub_num[s] = num;
    sk_sub_il[s] = from_il;
    sk_open(SCR_STUDY, s, push)
}

// The Grammar of word w of verse vi (its parsing's terms, and the notes
// on them), pushed or presented: a practice card's About This Form.
tag bible
sk_grammar_open(
    vi: int,
    w: int,
    greek: bool,
    num: int,
    push: bool
) {
    s: int = sk_sub_next % SK_SUBJECTS;
    sk_sub_next = sk_sub_next + 1;
    sk_sub_vi[s] = vi;
    sk_sub_w[s] = w;
    sk_sub_greek[s] = greek;
    sk_sub_num[s] = num;
    sk_sub_il[s] = false;
    sk_open(SCR_GRAMMAR, s, push)
}

// Subject s's numbers made, if another's are.
tag bible
sk_study_ready(language: *LanguageData, s: int) {
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    if (s < 0 || s >= SK_SUBJECTS) return;
    if (ws_vi == sk_sub_vi[s] && ws_w == sk_sub_w[s] && ws_greek == sk_sub_greek[s] && ws_num == sk_sub_num[s] && ws_set) return;
    study_set(language, sk_sub_vi[s], sk_sub_w[s], sk_sub_greek[s], sk_sub_num[s]);
    ws_set = true
}

ws_set: bool = false;

tag bible
ws_vi: int = 0;

tag bible
ws_w: int = 0;

// The number studied (the word's, or a lemma's: ws_lemma, with no verse).
tag bible
ws_greek: bool = false;

tag bible
ws_num: int = 0;

tag bible
ws_lemma: bool = false;

// How many times the word studied occurs (in its sense, if counted so).
ws_words: int = 0;

// The word's lexicon entries (where the first is, and how many).
tag bible
ws_lex: int = -1;

// Its sense (DESIGN.md ¬ß10.3): which entry (from 1; 0 not known), the
// entry's line (else the first's), and whether it is counted by sense (the
// number has more than one sense in use): then how often in it, and in all.
tag bible
ws_sense: int = 0;

ws_entry: int = -1;

tag bible
ws_by_sense: bool = false;

ws_all: int = 0;

// Related words (¬ß10.4): up to 5 of its language, and 3 of the other, each
// its number and how often it occurs.
tag bible
ws_rel_n: int = 0;

ws_rel_greek: []bool = new bool[5](false);

tag bible
ws_rel_num: []int = new int[5](0);

ws_rel_count: []int = new int[5](0);

ws_far_n: int = 0;

ws_far_num: []int = new int[3](0);

// The word's meaning here (UBS's; 0 none) and the words of its domain.
ws_mean: int = 0;

ws_dom_n: int = 0;

ws_dom_num: []int = new int[5](0);

ws_dom_count: []int = new int[5](0);

ws_far_count: []int = new int[3](0);

// Its distinct forms (0: no Forms row), and whether it may be a card.
ws_forms: int = 0;

ws_learnable: bool = false;

// Section 1's rows (¬ß7.5, ¬ß14.5.2): Dictionary Form, Meaning, (a lemma's
// Forms), Strong's, (a word's Grammar, Forms), Your Words.
WR_DICT: int = 0;

WR_MEANING: int = 1;

WR_STRONGS: int = 2;

WR_GRAMMAR: int = 3;

WR_FORMS: int = 4;

WR_YOURS: int = 5;

ws_row_kinds: []int = new int[8](0);

ws_row_n: int = 0;

ws_rows_make() {
    ws_row_n = 0;
    ws_row_add(WR_DICT);
    ws_row_add(WR_MEANING);
    if (ws_lemma && ws_forms > 0) ws_row_add(WR_FORMS);
    ws_row_add(WR_STRONGS);
    if (!ws_lemma) ws_row_add(WR_GRAMMAR);
    if (!ws_lemma && ws_forms > 0) ws_row_add(WR_FORMS);
    if (ws_learnable) ws_row_add(WR_YOURS)
}

ws_row_add(k: int) {
    ws_row_kinds[ws_row_n] = k;
    ws_row_n = ws_row_n + 1
}

// The study's numbers made (for word w of verse vi, or a lemma's with no
// word: w -1): its entries, its sense, its counts and renderings, and its
// related words.
study_set(
    language: *LanguageData,
    vi: int,
    w: int,
    greek: bool,
    num: int
) {
    ws_vi = vi;
    ws_w = w;
    ws_lemma = w < 0;
    ws_greek = greek;
    ws_num = num;
    ws_lex = lex_first(language, greek, num);
    ws_sense = (if (w >= 0) w_sense(language, w) else 0);
    ws_entry = sense_entry(language, greek, num, ws_sense);
    if (ws_entry < 0) {
        ws_entry = ws_lex;
        ws_sense = 0
    }
    _ok: bool = conc_load(language, greek, num);
    ws_all = cc_words;
    ws_by_sense = ws_sense > 0 && senses_in_use(language) > 1;
    if (ws_by_sense) conc_sense(language, ws_sense);
    ws_words = cc_words;
    renderings(language);
    // (Then the related words, and how often each occurs.)
    related_load(language, greek, num);
    ws_rel_n = 0;
    ws_far_n = 0;
    for i in 0..rl_n {
        if (rl_greek[i] == greek && ws_rel_n < 5) {
            ws_rel_greek[ws_rel_n] = rl_greek[i];
            ws_rel_num[ws_rel_n] = rl_num[i];
            ws_rel_n = ws_rel_n + 1
        } else if (rl_greek[i] != greek && ws_far_n < 3) {
            ws_far_num[ws_far_n] = rl_num[i];
            ws_far_n = ws_far_n + 1
        }
    }
    for i in 0..ws_rel_n ws_rel_count[i] = occurrences(language, greek, ws_rel_num[i]);
    for i in 0..ws_far_n ws_far_count[i] = occurrences(language, !greek, ws_far_num[i]);
    // (And its meaning here, UBS's, with the words of its domain: the
    // commonest five not related above.)
    ws_mean = (if (w >= 0) w_meaning(language, w) else 0);
    ws_dom_n = 0;
    if (ws_mean > 0) {
        domain_words(language, ws_mean);
        for i in 0..dm_n {
            num_d: int = dm_num[i] & 32767;
            listed: bool = num_d == num;
            for x in 0..ws_rel_n
                if (ws_rel_num[x] == num_d) listed = true;
            n_d: int = if (listed) 0 else occurrences(language, greek, num_d);
            if (n_d > 0) {
                // (Kept, the commonest five, most first.)
                at: int = ws_dom_n;
                while (at > 0 && ws_dom_count[at - 1] < n_d) at = at - 1;
                if (at < 5) {
                    y: int = if (ws_dom_n < 5) ws_dom_n else 4;
                    while (y > at) {
                        ws_dom_num[y] = ws_dom_num[y - 1];
                        ws_dom_count[y] = ws_dom_count[y - 1];
                        y = y - 1
                    }
                    ws_dom_num[at] = num_d;
                    ws_dom_count[at] = n_d;
                    if (ws_dom_n < 5) ws_dom_n = ws_dom_n + 1
                }
            }
        }
    }
    // Its forms (¬ß14.5.3: a verb's, noun's, adjective's, pronoun's or the
    // article's; not a name's), counted for the Forms row; and whether it
    // may be learned (its Your Words row).
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    ws_learnable = learnable(if (greek) 0 else 1, num);
    ws_forms = 0;
    if ((vk_flags_of(if (greek) 0 else 1, num) & FL_NAME) == 0) {
        forms_of(language, greek, num);
        forms_layout(language);
        if (fs_n > 0) ws_forms = forms_count()
    }
    // (The number's own verses loaded again, as the concordance has them.)
    _again: bool = conc_load(language, greek, num);
    if (ws_by_sense) conc_sense(language, ws_sense)
}

// The definition's first words, plain: an outline's top senses joined
// with " ¬∑ ", or its paragraphs run together (lang.l8).
sk_definition_preview(language: *LanguageData) {
    fbuf_n = 0;
    if (ws_lex < 0) {
        fput_str("No definition.");
        return
    }
    n_: int = lex_count(language, ws_lex);
    if (!ws_lemma && ws_sense == 0 && n_ > 1) {
        // A sense not known: which senses it may be, none first.
        fbuf_n = 0;
        fput_str("One of ");
        fput_int(n_);
        fput_str(" senses, not tagged in this verse: ");
        for x in 0..n_ {
            lex_field(language, lex_line(language, ws_lex, x), 3);
            b: int = lf_b;
            e: int = lf_e;
            dup: bool = false;
            for y in 0..x {
                lex_field(language, lex_line(language, ws_lex, y), 3);
                if (lf_e - lf_b == e - b) {
                    same: bool = true;
                    for i in 0..e - b
                        if (language.lexicon[lf_b + i] != language.lexicon[b + i]) same = false;
                    if (same) dup = true
                }
            }
            if (!dup) {
                if (x > 0) fput_str(" \¬\∑ ");
                for i in b..e fput(language.lexicon[i] as int)
            }
        }
        return
    }
    definition_preview_of(language, ws_entry);
    // (Up to 600 bytes, stopping between characters.)
    n: int = pv_n;
    if (n > 600) {
        n = 600;
        while (n > 0 && byte_of(pv, n) >= 128 && byte_of(pv, n) < 192) n = n - 1
    }
    fbuf_n = 0;
    fput_bytes(pv, 0, n)
}

// The sense's code (H430G), or the number's (H430).
tag bible
fput_sense_code(language: *LanguageData) {
    if (ws_sense > 0 && ws_entry >= 0) {
        lex_code(language, ws_entry);
        if (lf_e > lf_b) {
            for x in lf_b..lf_e fput(language.lexicon[x] as int);
            return
        }
    }
    fput_key(ws_greek, ws_num)
}

forms_count(): int {
    n: int = 0;
    for p in 0..fp_n {
        dup: bool = false;
        for q in 0..p
            if (fp_form[q] == fp_form[p]) dup = true;
        if (!dup) n = n + 1
    }
    n
}

tag bible
fput_key(greek: bool, num: int) {
    fput(if (greek) 71 else 72);
    fput_int(num)
}

// The word studied in its script (rich: RUN_GREEK or RUN_HEBREW).
tag bible
sk_script(greek: bool, faint: bool): int {
    if (greek)
        if (faint) RUN_GREEK_FAINT else RUN_GREEK else if (faint) RUN_HEBREW_FAINT else RUN_HEBREW
}

tag bible
sk_build_study(language: *LanguageData, id: int, s: int) {
    sk_study_ready(language, s);
    ui_begin(id, SCR_STUDY, s, "");
    w: int = ws_w;
    // The title: the lemma's transliteration (or the form's).
    fbuf_n = 0;
    if (ws_entry >= 0) {
        lex_field(language, ws_entry, 1);
        fput_bytes(language.lexicon, lf_b, lf_e)
    } else if (w >= 0) {
        form_of(language, w);
        fput_bytes(language.forms, wt_b, wt_e)
    }
    ui_set_screen_title_fbuf();
    // The heading: the form as it is in the verse (or the lemma), its
    // transliteration, and ‚Äúloved‚Äù in John 3:16 (or "143 times").
    fbuf_n = 0;
    if (ws_lemma) {
        lex_field(language, ws_lex, 0);
        fput_bytes(language.lexicon, lf_b, lf_e);
        at: int = fbuf_n;
        lex_field(language, ws_lex, 1);
        fput_bytes(language.lexicon, lf_b, lf_e);
        ui_set_hero(at, sk_script(ws_greek, false), fbuf_n);
        ui_rich_begin();
        fput_int(ws_all);
        fput_str(if (ws_all == 1) " time" else " times");
        ui_rich(RUN_PLAIN);
        ui_rich_hero_line()
    } else {
        study_load(language, ws_vi);
        form_of(language, w);
        fput_bytes(language.forms, wf_b, wf_e);
        at: int = fbuf_n;
        fput_bytes(language.forms, wt_b, wt_e);
        ui_set_hero(at, sk_script(w_greek(language, w), false), fbuf_n);
        ui_rich_begin();
        chunk_of(language, w);
        if (ch_e > ch_b) {
            fput_str("\‚\Ä\ú");
            ui_rich(RUN_PLAIN);
            fput_bytes(st, ch_b, ch_e);
            ui_rich(RUN_STRONG);
            fput_str("\‚\Ä\ù in ");
            ui_rich(RUN_PLAIN)
        } else {
            fput_str("Not translated in ");
            ui_rich(RUN_PLAIN)
        }
        fput_ref(v_chapter(language, ws_vi), v_num(language, ws_vi), v_num(language,
            ws_vi));
        ui_rich(RUN_PLAIN);
        ui_rich_hero_line();
        // (At its foot: Add to Note, and the interlinear unless it came
        // from there.)
        ui_tool("Add to Note", "", ACT_ADD_TO_NOTE, 0, UI_TOOL_PLAIN, 0);
        if (!sk_sub_il[s]) ui_tool("Interlinear", "", ACT_INTERLINEAR, 0, UI_TOOL_PLAIN,
            2)
    }
    ui_section("", "");
    ws_rows_make();
    for r in 0..ws_row_n sk_study_row(language, ws_row_kinds[r]);
    ui_section("Definition", if (ws_lex >= 0) "From STEP Bible" else "");
    ui_row(UI_ITEM, if (ws_lex >= 0) ACT_STUDY_DEFINITION else 0, 0);
    sk_definition_preview(language);
    ui_rich_from = 0;
    ui_rich_n = 0;
    ui_rich_u = 0;
    ui_rich(RUN_READING);
    ui_rich_title();
    ui_set_title_lines(5);
    if (ws_lex >= 0) ui_set_acc(ACC_MORE);
    ui_section("Occurrences", "");
    ui_row(UI_ITEM, ACT_STUDY_CONC, if (ws_by_sense) 1 else 0);
    ui_set_title("Concordance");
    fbuf_n = 0;
    fput_int(ws_words);
    if (ws_by_sense) fput_str(" in this sense") else fput_str(if (ws_words == 1) " time" else " times");
    ui_set_detail_fbuf();
    ui_set_value_detail();
    ui_set_acc(ACC_MORE);
    if (ws_by_sense) {
        ui_row(UI_ITEM, ACT_STUDY_CONC, 0);
        ui_set_title("All Senses");
        fbuf_n = 0;
        fput_int(ws_all);
        ui_set_detail_fbuf();
        ui_set_value_detail();
        ui_set_acc(ACC_MORE)
    }
    if (rd_n > 0) {
        ui_section("Translated As", if (ws_by_sense) "In this sense" else "");
        for r in 0..if (rd_n > 6) 6 else rd_n {
            ui_row(UI_ITEM, ACT_STUDY_CONC, (r + 1) * 2 + (if (ws_by_sense) 1 else 0));
            fbuf_n = 0;
            fput_bytes(rd_pool, rd_at[r], rd_at[r] + rd_len[r]);
            ui_set_title_fbuf();
            fbuf_n = 0;
            fput_int(rd_count[r]);
            ui_set_detail_fbuf();
            ui_set_value_detail()
        }
    }
    macula: str = "Words used in similar contexts, from MACULA.";
    if (ws_rel_n > 0) {
        ui_section("Related Words", if (ws_far_n == 0 && ws_dom_n == 0 || ws_far_n == 0 && ws_dom_n > 0) macula else "");
        for r in 0..ws_rel_n sk_related_row(language, ws_greek, ws_rel_num[r], ws_rel_count[r])
    }
    if (ws_far_n > 0) {
        ui_section(if (ws_greek) "In the Old Testament" else "In the New Testament",
            macula);
        for r in 0..ws_far_n sk_related_row(language, !ws_greek, ws_far_num[r], ws_far_count[r])
    }
    if (ws_dom_n > 0) {
        ui_section("In the Same Domain", "");
        fbuf_n = 0;
        fput_str("Words with a meaning in ");
        mean_field(language, ws_mean, 3);
        fput_bytes(language.meaning_text, mf_b, mf_e);
        fput_str(", as here; from the UBS dictionaries.");
        ui_set_footer_fbuf();
        for r in 0..ws_dom_n sk_related_row(language, ws_greek, ws_dom_num[r], ws_dom_count[r])
    }
}

// A row of the study's first section, of kind k (WR_).
sk_study_row(language: *LanguageData, k: int) {
    w: int = ws_w;
    if (k == WR_DICT) {
        ui_row(UI_ITEM, 0, 0);
        ui_set_title("Dictionary Form");
        if (ws_entry >= 0) {
            ui_rich_begin();
            // (Left to right, though it begins in Hebrew.)
            fput_str("\‚\Ä\é");
            ui_rich(RUN_FAINT);
            lex_field(language, ws_entry, 0);
            fput_bytes(language.lexicon, lf_b, lf_e);
            ui_rich(sk_script(ws_greek, true));
            fput_str(" (");
            ui_rich(RUN_FAINT);
            lex_field(language, ws_entry, 1);
            fput_bytes(language.lexicon, lf_b, lf_e);
            ui_rich(RUN_TRANSLIT);
            fput_str(")");
            ui_rich(RUN_FAINT);
            ui_rich_detail()
        }
        ui_set_value_detail()
    } else if (k == WR_MEANING) {
        ui_row(UI_ITEM, 0, 0);
        ui_set_title("Meaning");
        // (A sense not known among differing entries shows none of them.)
        me: int = if (ws_lemma) ws_entry else meaning_entry(language, ws_greek, ws_num,
            ws_sense);
        if (ws_mean > 0) {
            // (UBS's meaning here under the gloss.)
            ui_rich_begin();
            if (me >= 0) {
                lex_field(language, me, 3);
                fput_bytes(language.lexicon, lf_b, lf_e);
                ui_rich(RUN_PLAIN)
            }
            ui_rich_detail();
            fbuf_n = 0;
            fput_str("Here: ");
            fput_meaning(language, ws_mean);
            ui_set_note_fbuf()
        } else {
            ui_rich_begin();
            if (me >= 0) {
                lex_field(language, me, 3);
                fput_bytes(language.lexicon, lf_b, lf_e);
                ui_rich(RUN_PLAIN)
            } else if (ws_lex >= 0) {
                fput_str("Sense not tagged");
                ui_rich(RUN_FAINT)
            }
            ui_rich_detail();
            ui_set_value_detail()
        }
    } else if (k == WR_FORMS) {
        ui_row(UI_ITEM, ACT_STUDY_FORMS, 0);
        ui_set_title("Forms");
        fbuf_n = 0;
        fput_int(ws_forms);
        fput_str(if (ws_forms == 1) " form" else " forms");
        ui_set_detail_fbuf();
        ui_set_value_detail();
        ui_set_acc(ACC_MORE)
    } else if (k == WR_STRONGS) {
        ui_row(UI_ITEM, 0, 0);
        ui_set_title("Strong\‚\Ä\ôs");
        ui_rich_begin();
        fput_sense_code(language);
        ui_rich(RUN_CODE);
        ui_rich_detail();
        ui_set_value_detail();
        // (Read as "Strong's H 430 G".)
        at: int = fbuf_n;
        fput_str("Strong\‚\Ä\ôs ");
        for i in 0..at {
            x: int = fbuf[i] as int;
            if (i > 0 && is_digit(x) != is_digit(fbuf[i - 1] as int)) fput(32);
            fput(x)
        }
        for i in 0..fbuf_n - at fbuf[i] = fbuf[at + i];
        fbuf_n = fbuf_n - at;
        ui_set_label_fbuf()
    } else if (k == WR_GRAMMAR) {
        ui_row(UI_ITEM, ACT_STUDY_GRAMMAR, 0);
        ui_set_title("Grammar");
        plain_parsing(language, w_morph(language, w));
        fbuf_n = 0;
        fput_bytes(pl, 0, pl_n);
        ui_set_detail_fbuf();
        ui_set_lines(2);
        ui_set_acc(ACC_MORE)
    } else if (k == WR_YOURS) {
        lang: int = if (ws_greek) 0 else 1;
        c: int = card_of_word(lang, ws_num);
        if (c < 0) {
            ui_row(UI_BUTTON, ACT_LEARN_WORD, 0);
            ui_set_title("Learn This Word");
            ui_set_tinted();
            ui_rows[ui_last()].strong = false
        } else {
            ui_row(UI_ITEM, 0, 0);
            ui_set_title("Your Words");
            fbuf_n = 0;
            if (cd_state[c] == MS_NEW) fput_str("New \¬\∑ in your next practice") else fput_card_state(c,
                sk_today_now());
            ui_set_detail_fbuf();
            ui_set_value_detail();
            ui_set_lines(2)
        }
    }
}

// A related word's row: its lemma and transliteration, gloss, and how
// often it occurs (a word known: checked).
sk_related_row(
    language: *LanguageData,
    greek: bool,
    num: int,
    count: int
) {
    ui_row(UI_ITEM, ACT_STUDY_LEMMA, (if (greek) 100000 else 0) + num);
    p: int = lex_first(language, greek, num);
    ui_rich_begin();
    if (p >= 0) {
        // (Left to right, a Hebrew lemma held in its place by the marks.)
        fput_str("\‚\Ä\é");
        ui_rich(RUN_PLAIN);
        lex_field(language, p, 0);
        fput_bytes(language.lexicon, lf_b, lf_e);
        ui_rich(sk_script(greek, false));
        fput_str("\‚\Ä\é  ");
        ui_rich(RUN_PLAIN);
        lex_field(language, p, 1);
        fput_bytes(language.lexicon, lf_b, lf_e);
        ui_rich(RUN_TRANSLIT);
        ui_rich_title();
        fbuf_n = 0;
        lex_field(language, p, 3);
        fput_bytes(language.lexicon, lf_b, lf_e);
        ui_set_detail_fbuf()
    } else {
        fput_key(greek, num);
        ui_rich(RUN_CODE);
        ui_rich_title()
    }
    fbuf_n = 0;
    fput_int(count);
    ui_set_trailing_fbuf();
    ui_set_acc(ACC_MORE);
    known: bool = learn_ready && word_card_known(if (greek) 0 else 1, num);
    ui_set_on(known);
    if (known && p >= 0) {
        fbuf_n = 0;
        lex_field(language, p, 1);
        fput_bytes(language.lexicon, lf_b, lf_e);
        fput_str(", ");
        lex_field(language, p, 3);
        fput_bytes(language.lexicon, lf_b, lf_e);
        fput_str(", ");
        fput_int(count);
        fput_str(" times, known");
        ui_set_label_fbuf()
    }
}

// ---- grammar (DESIGN.md ¬ß7.5.3) ----
// The word's parsing, a section a part (prefix, word, suffix), each term
// and what it means; a Hebrew word's joined words' cards under its prefix
// and suffix.
tag bible
sk_build_grammar(language: *LanguageData, id: int, s: int) {
    sk_study_ready(language, s);
    ui_begin(id, SCR_GRAMMAR, s, "Grammar");
    morph: int = w_morph(language, ws_w);
    // The heading: the form and its code.
    ui_rich_begin();
    form_of(language, ws_w);
    fput_bytes(language.forms, wf_b, wf_e);
    ui_rich(sk_script(w_greek(language, ws_w), false));
    fput_str(" \¬\∑ ");
    ui_rich(RUN_FAINT);
    morph_of(language, morph);
    fput_bytes(language.morph, mc_b, mc_e);
    ui_rich(RUN_CODE);
    ui_rich_intro();
    parse_terms(language, morph);
    parts: int = 0;
    for part in 0..3 {
        any: bool = false;
        for t in 0..pt_n
            if (pt_part[t] == part) any = true;
        if (any) parts = parts + 1
    }
    for part in 0..3 {
        parse_terms(language, morph);
        any: bool = false;
        for t in 0..pt_n
            if (pt_part[t] == part) any = true;
        if (any) {
            ui_section(if (parts < 2) "" else if (part == 0) "Prefix" else if (part == 1) "Word" else "Suffix",
                "");
            sk_grammar_footer(language, part);
            if (fbuf_n > 0) ui_set_footer_fbuf();
            parse_terms(language, morph);
            for t in 0..pt_n {
                if (pt_part[t] == part) {
                    // The term, each word capitalized ("3rd Person"), and
                    // what it means; tapped, its note, if it has one.
                    note: int = -1;
                    if (pt_gram[t] >= 0) {
                        gram_parts(language, pt_gram[t]);
                        note = gn_for_term(language, gn_b, gn_e, if (w_greek(language,
                            ws_w)) 0 else 1)
                    }
                    ui_row(UI_ITEM, if (note >= 0) ACT_GN_OPEN else 0, if (note >= 0) note else t);
                    if (note >= 0) ui_set_acc(ACC_MORE);
                    fbuf_n = 0;
                    cap: bool = true;
                    for i in pt_b[t]..pt_e[t] {
                        c: int = pt_buf[i] as int;
                        if (cap && c >= 97 && c <= 122) c = c - 32;
                        cap = c == 32;
                        fput(c)
                    }
                    ui_set_title_fbuf();
                    ui_set_strong();
                    if (pt_gram[t] >= 0) {
                        gram_parts(language, pt_gram[t]);
                        fbuf_n = 0;
                        fput_bytes(language.grammar, gx_b, gx_e);
                        ui_set_detail_fbuf()
                    }
                }
            }
        }
    }
    gn_list_row(language, if (w_greek(language, ws_w)) 0 else 1)
}

// A Hebrew word's Prefix and Suffix sections name its joined words' cards
// (¬ß14.5.2): "Joined word: ◊ï÷∞ and ¬∑ known".
sk_grammar_footer(language: *LanguageData, part: int) {
    fbuf_n = 0;
    if (w_greek(language, ws_w) || !learn_ready || part == 1) return;
    bits: int = word_parts(language, ws_w);
    for j in 0..len(jp_ids) {
        mine: bool = if (part == 0) j < 6 else j >= 6;
        i: int = jp_lt[j];
        if (mine && (bits & 1 << j) != 0 && i >= 0) {
            if (fbuf_n > 0) fput_str("; ");
            fput_str("Joined word: \‚\Å\ß");
            // (Its glyph without the dotted circle.)
            x: int = lt_fb[i * 9 + LF_GLYPH];
            e: int = lt_fe[i * 9 + LF_GLYPH];
            while (x < e) {
                cp: int = cp_at(language.letters, x, e);
                if (cp != 9676) fbuf_n = cp_put(fbuf, fbuf_n, cp);
                x = x + cp_len
            }
            fput_str("\‚\Å\© ");
            fput_lt(language, i, LF_NAME);
            k: int = cl_of[i];
            if (cd_known(k)) fput_str(" \¬\∑ known") else if (k >= 0) fput_str(" \¬\∑ learning")
        }
    }
}

// ---- the concordance (DESIGN.md ¬ß7.5.4) ----
// Its verses: all the number's, or (conc_r >= 0) those where it is
// rendered so; in its sense only (conc_by_sense; This Sense and All above
// it, when it was asked for from "in this sense"); or a parsing's
// (conc_form, the Forms'). By book, filtered by what is typed.
conc_by_sense: bool = false;

conc_r: int = -1;

conc_form: int = -1;

// Whether This Sense and All are offered.
conc_sensed: bool = false;

cs_n: int = 0;

cs_book: []int = new int[66](0);

cs_start: []int = new int[66](0);

cs_count: []int = new int[66](0);

cf: []int = new int[8192](0);

cf_n: int = 0;

cq: []i8 = new i8[256](0i8);

cq_n: int = 0;

conc_reload_data(language: *LanguageData) {
    _ok: bool = conc_load(language, ws_greek, ws_num);
    if (conc_by_sense) conc_sense(language, ws_sense);
    if (conc_r >= 0) conc_only(language, conc_r);
    if (conc_form >= 0) conc_of_form(language, conc_form);
    conc_sections(language)
}

conc_sections(language: *LanguageData) {
    cf_n = 0;
    for i in 0..cc_n {
        if (cq_n == 0 || conc_matches(language, cc_vi[i])) {
            cf[cf_n] = i;
            cf_n = cf_n + 1
        }
    }
    cs_n = 0;
    for i in 0..cf_n {
        b: int = ch_book[v_chapter(language, cc_vi[cf[i]])];
        if (cs_n == 0 || cs_book[cs_n - 1] != b) {
            cs_book[cs_n] = b;
            cs_start[cs_n] = i;
            cs_count[cs_n] = 0;
            cs_n = cs_n + 1
        }
        cs_count[cs_n - 1] = cs_count[cs_n - 1] + 1
    }
}

// Whether verse vi's words or reference have the filter's (case aside).
conc_matches(language: *LanguageData, vi: int): bool {
    study_load(language, vi);
    if (has_lower(st, st_n)) return true;
    fbuf_n = 0;
    fput_ref(v_chapter(language, vi), v_num(language, vi), v_num(language, vi));
    has_lower(fbuf, fbuf_n)
}

has_lower(b: []i8, n: int): bool {
    for i in 0..n - cq_n + 1 {
        same: bool = true;
        j: int = 0;
        while (same && j < cq_n) {
            k: int = b[i + j] as int;
            if (k >= 65 && k <= 90) k = k + 32;
            if (k != cq[j] as int) same = false;
            j = j + 1
        }
        if (same) return true
    }
    false
}

// The concordance (of the word studied) shown: its verses (rendering r,
// or -1 all; in its sense, if sensed: then This Sense and All above them
// when all were asked for).
tag bible
sk_conc_filter(buf: []i8, b: int, e: int) {
    cq_n = 0;
    for x in b..e {
        if (cq_n < len(cq)) {
            k: int = buf[x] as int;
            cq[cq_n] = (if (k >= 65 && k <= 90) k + 32 else k) trunc i8;
            cq_n = cq_n + 1
        }
    }
}

tag bible
sk_conc_choose_sense(value: int) {
    conc_by_sense = value == 0
}

tag bible
sk_conc_open_form(
    language: *LanguageData,
    form: int,
    greek: bool,
    number: int
) {
    if (ws_num != number || ws_greek != greek) {
        ws_num = number;
        ws_greek = greek;
        ws_lex = lex_first(language, greek, number);
        ws_entry = ws_lex;
        ws_sense = 0;
        ws_set = false
    }
    conc_form = form;
    conc_r = -1;
    conc_by_sense = false;
    conc_sensed = false;
    cq_n = 0;
    sk_open(SCR_CONCORDANCE, -1, true)
}

tag bible
sk_conc_open(s: int, r: int, sensed: bool) {
    conc_r = r;
    conc_by_sense = sensed;
    conc_sensed = sensed && r < 0;
    conc_form = -1;
    cq_n = 0;
    sk_open(SCR_CONCORDANCE, s, true)
}

// (A parsing's form and parsing, onto fbuf.)
sk_conc_form_words(language: *LanguageData) {
    frm_put_form(language, conc_form);
    fput_str(" \¬\∑ ");
    frm_put_parsing(language, conc_form)
}

sk_conc_header(language: *LanguageData) {
    fbuf_n = 0;
    // (Left to right, though it may begin in Hebrew.)
    fput_str("\‚\Ä\é");
    r: int = conc_r;
    if (r >= 0) {
        if (ws_entry >= 0) {
            lex_field(language, ws_entry, 1);
            for x in lf_b..lf_e fput(language.lexicon[x] as int)
        } else fput_key(ws_greek, ws_num);
        fput_str(" translated \‚\Ä\ú");
        for x in 0..rd_len[r] fput(rd_pool[rd_at[r] + x] as int);
        fput_str("\‚\Ä\ù \‚\Ä\î ");
        fput_int(cc_words);
        fput_str(if (cc_words == 1) " time" else " times")
    } else if (conc_form >= 0) {
        // "·º†Œ≥Œ¨œÄŒ∑œÉŒµŒΩ ¬∑ aorist active indicative 3rd singular ‚Äî 6 times".
        sk_conc_form_words(language);
        fput_str(" \¬\∑ ");
        fput_str(" \‚\Ä\î ");
        fput_int(cc_words);
        fput_str(if (cc_words == 1) " time" else " times")
    } else {
        if (ws_entry >= 0) {
            lex_field(language, ws_entry, 0);
            for x in lf_b..lf_e fput(language.lexicon[x] as int);
            fput_str(" \¬\∑ ");
            lex_field(language, ws_entry, 1);
            for x in lf_b..lf_e fput(language.lexicon[x] as int);
            fput_str(" \¬\∑ ")
        }
        if (conc_by_sense) fput_sense_code(language) else fput_key(ws_greek, ws_num);
        fput_str(" \‚\Ä\î ");
        fput_int(cc_words);
        fput_str(if (cc_words == 1) " time in " else " times in ");
        fput_int(cc_n);
        fput_str(if (cc_n == 1) " verse" else " verses")
    }
    n: int = fbuf_n;
    for i in 0..n sk_note[i] = fbuf[i];
    ui_rich_begin();
    fput_bytes(sk_note, 0, n);
    ui_rich(RUN_SMALL);
    ui_rich_intro()
}

tag bible
sk_build_concordance(language: *LanguageData, id: int, s: int) {
    if (conc_form < 0) sk_study_ready(language, s);
    ui_begin(id, SCR_CONCORDANCE, s, "");
    conc_reload_data(language);
    fbuf_n = 0;
    if (conc_r >= 0) {
        fput_str("\‚\Ä\ú");
        fput_bytes(rd_pool, rd_at[conc_r], rd_at[conc_r] + rd_len[conc_r]);
        fput_str("\‚\Ä\ù")
    } else fput_str("Concordance");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_set_search("Filter Verses");
    ui_set_search_text(cq, cq_n);
    if (conc_sensed) {
        fbuf_n = 0;
        fput_str("This Sense (");
        fput_int(ws_words);
        fput_str(")|All (");
        fput_int(ws_all);
        fput_str(")");
        ui_segments = ui_put_fbuf();
        ui_segment = (if (conc_by_sense) 0 else 1);
        ui_segments_action = ACT_CONC_SENSE
    }
    sk_conc_header(language);
    if (cs_n > 8) {
        fbuf_n = 0;
        for x in 0..cs_n {
            if (x > 0) fput(124);
            book_short(cs_book[x]);
            fput_bytes(short_name, 0, short_n)
        }
        ui_set_index_fbuf()
    }
    ui_set_empty("magnifyingglass", "No Matches", "");
    // (Its verses made as they are wanted: a book's can be thousands.)
    ui_lazy_fn = &sk_conc_lazy;
    for x in 0..cs_n {
        ui_section("", "");
        ui_set_lazy(cs_count[x]);
        fbuf_n = 0;
        b: int = cs_book[x];
        fput_str(book_name(b));
        fput_str(" \¬\∑ ");
        fput_int(cs_count[x]);
        ui_set_header_fbuf()
    }
}

sk_conc_lazy(s: int, r: int) {
    borrow language_data {
        if (s >= 0 && s < cs_n && r < cs_count[s]) sk_conc_row(language_data, cc_vi[cf[cs_start[s] + r]])
    }
}

// A verse of the concordance: its reference (" ¬∑ not translated"), its
// words, the number's English marked (begun nearer it if far in).
sk_conc_row(language: *LanguageData, vi: int) {
    ui_row(UI_ITEM, ACT_CONC_VERSE, vi);
    ui_set_custom(CUSTOM_HIT);
    fbuf_n = 0;
    fput_ref(v_chapter(language, vi), v_num(language, vi), v_num(language, vi));
    ui_set_title_fbuf();
    conc_marks(language, vi);
    if (mk_untranslated) {
        fbuf_n = 0;
        fput_str(" \¬\∑ not translated");
        ui_set_suffix_fbuf()
    }
    start: int = 0;
    if (mk_n > 0 && mk_b[0] > 170) {
        words: int = 0;
        start = mk_b[0];
        while (start > 0 && words < 9) {
            start = start - 1;
            if (st[start] as int == 32) words = words + 1
        }
        if (st[start] as int == 32) start = start + 1
    }
    fbuf_n = 0;
    lead: int = 0;
    if (start > 0) {
        fput_str("\‚\Ä\¶ ");
        lead = 2
    }
    fput_bytes(st, start, st_n);
    ui_set_detail_fbuf();
    ui_set_scripture();
    for i in 0..mk_n {
        if (mk_b[i] >= start) {
            b: int = lead + sk_utf16(st, start, mk_b[i]);
            ui_add_mark(b, b + sk_utf16(st, mk_b[i], mk_e[i]))
        }
    }
}
