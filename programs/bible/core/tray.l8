tag bible;

use_tag std;

// The tray (DESIGN.md Â§13.2.1), as core's model (SKINS.md): the verses
// selected (the host's: of one chapter, in order) as a reference, the
// highlights' colors (the one they all share chosen; None if any is
// highlighted), and what can be done with them (Copy, Share, Bookmark,
// Note, Study, Compare, Memorize, each its state's words). It isn't a
// screen of the stack: a skin builds it (sk_build_tray) as the selection
// changes, draws it its own way, and gives its actions to sk_tray_act.
import "skin.l8";

import "memory.l8";

SCR_TRAY: int = 41;

// A color chosen (value its index; 5 None), Copy, Share, Bookmark, Note,
// Study, Compare, Memorize, and the tray closed.
ACT_TRAY_COLOR: int = 130;

ACT_TRAY_COPY: int = 131;

ACT_TRAY_SHARE: int = 132;

ACT_TRAY_BOOKMARK: int = 133;

ACT_TRAY_NOTE: int = 134;

ACT_TRAY_STUDY: int = 135;

ACT_TRAY_COMPARE: int = 136;

ACT_TRAY_MEMORIZE: int = 137;

ACT_TRAY_CLOSE: int = 138;

// The selection (the host's), and whether Study is open beside the text
// (its action reads Studying).
sk_sel_c: int = -1;

sk_sel_v: []int = new int[200](0);

sk_sel_n: int = 0;

sk_studying: bool = false;

// The tray's model: its title the reference; a row of the colors (its
// options their hexes, a sixth, empty, None while any verse is
// highlighted; its detail their spoken names; its value the one they all
// have, else -1); then the actions.
// ---- the text's own menu (a long press's: Â§3.1.4) ----
// Its commands, the app's before the system's: Study (where the words
// selected can be studied: em_study_version, and the skin's pick of a
// word there), Highlight (in the color last used: hl_last), Note.
EM_STUDY: int = 0;

EM_HIGHLIGHT: int = 1;

EM_NOTE: int = 2;

em_titles: []str = ["Study", "Highlight", "Note"];

// Whether version t's words can be studied from the text (only the BSB's
// and the original's words are the original's).
em_study_version(t: int): bool {
    t == TEXT_BSB || t == TEXT_ORIG
}

// The highlight's color used last (the tray's or the menu's).
hl_last(): int {
    clamp_index(pref("lastHighlight", 0), 5)
}

// The buttons' titles a skin sizes its titles by (one size for all of
// them, whatever state each is in).
tray_fit_titles: []str = ["Copy", "Share", "Bookmark", "Note", "Study", "Compare",
    "Memorize"];

sk_build_tray() {
    c: int = sk_sel_c;
    n: int = sk_sel_n;
    fbuf_n = 0;
    if (c >= 0 && n > 0) put_ref(c, sk_sel_v, n);
    ui_begin(0, SCR_TRAY, 0, "");
    ui_set_screen_title_fbuf();
    if (c < 0 || n == 0) return;
    shared: int = -2;
    any: bool = false;
    for i in 0..n {
        h: int = highlight_of(c, sk_sel_v[i]);
        if (h >= 0) any = true;
        if (shared == -2) shared = h else if (shared != h) shared = -1
    }
    ui_section("", "");
    ui_row(UI_CUSTOM, ACT_TRAY_COLOR, 0);
    ui_set_custom(CUSTOM_SWATCHES);
    fbuf_n = 0;
    for j in 0..5 {
        if (j > 0) fput(124);
        fput_str(hl_swatch[j])
    }
    if (any) fput(124);
    ui_rows[ui_last()].options = ui_put_fbuf();
    fbuf_n = 0;
    for j in 0..5 {
        if (j > 0) fput(124);
        fput_str("Highlight ");
        fput_str(hl_titles[j])
    }
    if (any) fput_str("|Remove Highlight");
    ui_set_detail_fbuf();
    ui_rows[ui_last()].value = (if (shared >= 0) shared else -1);
    ui_section("", "");
    sk_tray_row(ACT_TRAY_COPY, "Copy", "doc.on.doc");
    sk_tray_row(ACT_TRAY_SHARE, "Share", "square.and.arrow.up");
    marked: bool = is_bookmarked(c, sk_sel_v[0]);
    sk_tray_row(ACT_TRAY_BOOKMARK, if (marked) "Bookmarked" else "Bookmark", if (marked) "bookmark.fill" else "bookmark");
    noted: bool = note_of(c, sk_sel_v[0]) >= 0;
    sk_tray_row(ACT_TRAY_NOTE, if (noted) "Edit Note" else "Note", if (noted) "note.text" else "square.and.pencil");
    // (Study beside the text open: Studying, in the accent.)
    sk_tray_row(ACT_TRAY_STUDY, if (sk_studying) "Studying" else "Study", "character.book.closed");
    if (sk_studying) ui_set_tinted();
    sk_tray_row(ACT_TRAY_COMPARE, "Compare", "books.vertical");
    fbuf_n = 0;
    fput_str("Compare Versions");
    ui_set_label_fbuf();
    // Memorize, or Memorizing (accent) when a passage holds every verse.
    holding: int = memory_holding(c, sk_sel_v[0], sk_sel_v[n - 1]);
    ok: bool = holding >= 0 || sk_sel_v[n - 1] - sk_sel_v[0] + 1 <= MEM_VERSES;
    sk_tray_row(ACT_TRAY_MEMORIZE, if (holding >= 0) "Memorizing" else "Memorize",
        "brain");
    if (holding >= 0) ui_set_tinted();
    ui_set_disabled(!ok);
    ui_set_hint(if (holding >= 0) "Practises this passage." else if (ok) "Adds these verses to Memory in the Library." else "Memory passages are up to 40 verses.")
}

sk_tray_row(action: int, title: str, icon: str) {
    ui_row(UI_ITEM, action, 0);
    ui_set_title(title);
    ui_set_icon(icon)
}

// The tray's action done (value: a color's index, 5 None).
sk_tray_act(action: int, value: int) {
    c: int = sk_sel_c;
    n: int = sk_sel_n;
    if (c < 0 || n == 0) {
        ui_effect("clear_selection", -1, -1);
        return
    }
    if (action == ACT_TRAY_COLOR) {
        // (Its color on every verse; off, if they all had it.)
        color: int = if (value >= 5 || value < 0) -1 else value;
        if (color >= 0) {
            all: bool = true;
            for x in 0..n
                if (highlight_of(c, sk_sel_v[x]) != color) all = false;
            if (all) color = -1
        }
        for x in 0..n set_highlight(c, sk_sel_v[x], color);
        if (color >= 0) set_pref("lastHighlight", color);
        sk_kept_c = c;
        sk_kept(SK_KEPT_HIGHLIGHTS);
        ui_effect("highlighted", color, -1);
        ui_effect("clear_selection", -1, -1);
        return
    }
    if (action == ACT_TRAY_COPY || action == ACT_TRAY_SHARE) {
        // (The verses' words, quoted, and their reference.)
        fbuf_n = 0;
        put_quote(c, sk_sel_v, n);
        ui_effect_fbuf(if (action == ACT_TRAY_COPY) "copy" else "share");
        if (action == ACT_TRAY_COPY) ui_effect("clear_selection", -1, -1);
        return
    }
    if (action == ACT_TRAY_BOOKMARK) {
        on: bool = !is_bookmarked(c, sk_sel_v[0]);
        set_bookmark(c, sk_sel_v[0], on);
        sk_kept_c = c;
        sk_kept(SK_KEPT_BOOKMARKS);
        ui_effect("bookmarked", if (on) 1 else 0, -1);
        ui_effect("clear_selection", -1, -1);
        return
    }
    if (action == ACT_TRAY_NOTE) {
        ui_effect("clear_selection", -1, -1);
        sk_note_open(c, sk_sel_v[0], sk_sel_v[n - 1], false);
        return
    }
    if (action == ACT_TRAY_STUDY) {
        // (The host's: a sheet, or beside the text where it fits.)
        ui_effect("study_verse", c, sk_sel_v[0]);
        return
    }
    if (action == ACT_TRAY_COMPARE) {
        for x in 0..n sk_tray_vs[x] = sk_sel_v[x];
        ui_effect("clear_selection", -1, -1);
        sk_open_compare(c, sk_tray_vs, n);
        return
    }
    if (action == ACT_TRAY_MEMORIZE) {
        holding: int = memory_holding(c, sk_sel_v[0], sk_sel_v[n - 1]);
        if (holding < 0 && sk_sel_v[n - 1] - sk_sel_v[0] + 1 > MEM_VERSES) return;
        ui_effect("clear_selection", -1, -1);
        // (Its practice; else the passage added: the ESV's by the host,
        // which keeps its verses; any other version's here.)
        if (holding >= 0) {
            px_start(PXS_ONE, holding);
            return
        }
        if (text_cur == TEXT_ESV) {
            ui_effect("memorize", c, sk_sel_v[0] * 1000 + sk_sel_v[n - 1]);
            return
        }
        id: int = memory_add(text_cur, c, sk_sel_v[0], c, sk_sel_v[n - 1], time(0));
        if (id != 0) {
            sk_kept(SK_KEPT_MEMORY);
            ui_effect("memorized", id, -1)
        }
        return
    }
    ui_effect("clear_selection", -1, -1)
}

sk_tray_vs: []int = new int[200](0);

// ---- references and text, for the tray, copies and the library ----
// A reference into fbuf: the chapter's name, then its verses (16â€“18, or 16,
// 18), from the first n of vs.
put_ref(c: int, vs: []int, n: int) {
    source: TextSource = text_source(text_cur);
    put_ref_from(&source, c, vs, n)
}

put_ref_from(
    source: *TextSource,
    c: int,
    vs: []int,
    n: int
) {
    fput_title_from(source, c);
    if (n == 0) return;
    fput(if (book_count[ch_book[c]] > 1) 58 else 32);
    i: int = 0;
    while (i < n) {
        j: int = i;
        while (j + 1 < n && vs[j + 1] == vs[j] + 1) j = j + 1;
        if (i > 0) fput_str(", ");
        fput_int(vs[i]);
        // (In the version's own numbers: the ESV's 3 John 1:14 is shown as
        // 14 and 15.)
        last: int = source_verse_shown_last(source, c, vs[j]);
        if (last > vs[i]) {
            fput_str("\â\€\“");
            fput_int(last)
        }
        i = j + 1
    }
}

// The verses' words, quoted, and their reference: what a copy or a share
// is (â€œâ€¦â€ John 3:16 BSB, or KJV, or the version read).
put_quote(c: int, vs: []int, n: int) {
    fput_str("\â\€\œ");
    for i in 0..n {
        if (i > 0) fput(32);
        if (lay_verse_lines && n > 1) {
            fput_int(vs[i]);
            fput(32)
        }
        // (The original's as shown: its accents with Show Accents on.)
        if (text_cur == TEXT_ORIG) _n: int = og_verse_text_shown(c, vs[i]) else verse_text(c,
            vs[i]);
        for x in 0..vt_n fput(vt[x] as int)
    }
    fput_str("\â\€\\n");
    put_ref(c, vs, n);
    fput(32);
    fput_version_short(text_cur, c)
}

// ---- the reader's title: its menu (Â§11.2.2) ----
// Its model, like the tray's: a menu's title ("Reading with Morning"),
// its items (rows: Leave Morning Here, New Ribbon Hereâ€¦ with where it is),
// and a submenu (a section, its header the submenu's title: Move Ribbon
// Here, each ribbon with its place). A skin draws it as its menus are;
// its items' actions go to sk_title_act.
SCR_TITLE_MENU: int = 43;

ACT_TM_LEAVE: int = 150;

ACT_TM_NEW: int = 151;

ACT_TM_MOVE: int = 152;

// Whether the end of the reader's chapter is in sight (the host's), as a
// ribbon left there remembers.
SK_NUM_END_SEEN: int = 13;

sk_build_title_menu() {
    k: int = rb_carried_i();
    fbuf_n = 0;
    if (k >= 0) {
        fput_str("Reading with ");
        fput_ribbon_name(k)
    }
    ui_begin(0, SCR_TITLE_MENU, 0, "");
    ui_set_screen_title_fbuf();
    th: int = theme_now(clamp_index(pref("theme", 0), len(t_bg)), sk_dark);
    dark: bool = theme_dark(th, sk_dark);
    ui_section("", "");
    if (k >= 0) {
        ui_row(UI_ITEM, ACT_TM_LEAVE, 0);
        fbuf_n = 0;
        fput_str("Leave ");
        fput_ribbon_name(k);
        fput_str(" Here");
        ui_set_title_fbuf();
        ui_set_icon("ribbon");
        ui_set_icon_color(ribbon_hex(rb_color[k], th, dark))
    }
    ui_row(UI_ITEM, ACT_TM_NEW, 0);
    ui_set_title("New Ribbon Here\â\€\¦");
    ui_set_icon("ribbon");
    fbuf_n = 0;
    fput_ref(sk_c, if (sk_v >= 2) sk_v else 0, if (sk_v >= 2) sk_v else 0);
    ui_set_detail_fbuf();
    ui_set_disabled(rb_n >= RB_MOST);
    if (rb_n > (if (k >= 0) 1 else 0)) {
        ui_section("Move Ribbon Here", "");
        now: int = time(0);
        for i in 0..rb_n {
            if (i != k) {
                ui_row(UI_ITEM, ACT_TM_MOVE, rb_id[i]);
                fbuf_n = 0;
                fput_ribbon_name(i);
                ui_set_title_fbuf();
                fbuf_n = 0;
                fput_ribbon_line(i, now, sk_tz);
                ui_set_detail_fbuf();
                ui_set_icon("ribbon");
                ui_set_icon_color(ribbon_hex(rb_color[i], th, dark))
            }
        }
    }
}

// An item of the title's menu, at the reader's place (sk_c, sk_v,
// sk_frac, as the host has just measured it).
sk_title_act(action: int, arg: int) {
    if (action == ACT_TM_NEW) {
        sk_new_ribbon(sk_c, sk_v, sk_frac, false);
        return
    }
    if (action == ACT_TM_LEAVE) {
        // (Put down here; the toast "Morning left at Romans 8:20".)
        k: int = rb_carried_i();
        if (k < 0) return;
        _r: bool = ribbon_leave_here(sk_c, sk_v, sk_frac, sk_num_of(SK_NUM_END_SEEN,
            sk_c) == 1, time(0));
        sk_ribbons_kept();
        fbuf_n = 0;
        fput_ribbon_name(k);
        fput_str(" left at ");
        fput_ribbon_place(k);
        ui_effect_fbuf("ribbon_toast");
        ui_effect("ribbon_toast_of", k, -1);
        return
    }
    if (action == ACT_TM_MOVE) {
        // (It takes the place, and is picked up.)
        if (rb_index(arg) < 0) return;
        ribbon_move_here(arg, sk_c, sk_v, sk_frac, time(0));
        sk_ribbons_kept();
        if (jp_own()) ui_effect("ribbon_moved", arg, -1) else {
            rd_scrolled = false;
            i: int = rb_index(arg);
            if (i >= 0) {
                fput_reading_with(i);
                ui_toast(TOAST_RIBBON)
            }
        }
    }
}
