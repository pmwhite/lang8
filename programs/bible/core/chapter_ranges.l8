tag bible;

use_tag std;

import "store.l8";

// UTF-16 ranges and inserted marks for one laid-out chapter. These are
// separate from the byte layout so a platform can keep its own measurement.
type ChapterRanges = {
    storage_slot: int;
    // For each byte of the layout's out (and its end), how many UTF-16
    // units come before it.
    u16_at: []int;
    // The verses of chapter rv_c: their numbers, and where each is in its
    // text (UTF-16), from its number to its end, with the marks put in.
    rv_c: int;
    rv_count: int;
    rv_num: []int;
    rv_b: []int;
    rv_e: []int;
    // Whether a verse's wash goes on over the space after it (to the next).
    rv_joins: []bool;
    // The marks put in: where (before them), how many units, and what (0 a
    // bookmark, 1 a note, 2 the chapter's note, after its label), for which
    // verse.
    ev_n: int;
    ev_pos: []int;
    ev_len: []int;
    ev_kind: []int;
    ev_verse: []int;
    // The glossed words: their letters (UTF-16, the marks put in counted),
    // for their dotted lines after the washes are painted.
    gw_n: int;
    gw_b: []int;
    gw_e: []int;
    // Where the chapter's opener ends (its numeral, UTF-16).
    opener16: int
}

chapter_ranges(): ChapterRanges@new {
    slot: int = cr_reserve();
    ChapterRanges {
        storage_slot: slot,
        u16_at: bible_ints_at(&cr_slots[slot].u16_at_data[0]),
        rv_c: -1,
        rv_count: 0,
        rv_num: bible_ints_at(&cr_slots[slot].rv_num_data[0]),
        rv_b: bible_ints_at(&cr_slots[slot].rv_b_data[0]),
        rv_e: bible_ints_at(&cr_slots[slot].rv_e_data[0]),
        rv_joins: bible_bools_at(&cr_slots[slot].rv_joins_data[0]),
        ev_n: 0,
        ev_pos: bible_ints_at(&cr_slots[slot].ev_pos_data[0]),
        ev_len: bible_ints_at(&cr_slots[slot].ev_len_data[0]),
        ev_kind: bible_ints_at(&cr_slots[slot].ev_kind_data[0]),
        ev_verse: bible_ints_at(&cr_slots[slot].ev_verse_data[0]),
        gw_n: 0,
        gw_b: bible_ints_at(&cr_slots[slot].gw_b_data[0]),
        gw_e: bible_ints_at(&cr_slots[slot].gw_e_data[0]),
        opener16: 0
    }
}

measure_chapter(ctx: *ChapterLayout, ranges: *ChapterRanges, c: int) {
    n: int = 0;
    for i in 0..ctx.out_n {
        ranges.u16_at[i] = n;
        k: int = ctx.out[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    ranges.u16_at[ctx.out_n] = n;
    ranges.opener16 = ranges.u16_at[ctx.opener_at];
    ranges.rv_c = c;
    ranges.rv_count = ctx.verse_count;
    ranges.ev_n = 0;
    // (The chapter's own note: its mark after the chapter's label.)
    if (note_of(c, 0) >= 0 && ctx.label_end > 0) ranges_add_event(ranges, ranges.u16_at[ctx.label_end],
        2, 2, 0);
    for i in 0..ctx.verse_count {
        b: int = ctx.verse_begin[i];
        e: int = ctx.verse_end[i];
        if (e < 0) e = (if (b >= 0) b else 0);
        if (b < 0) b = e;
        v: int = ctx.verse_num[i];
        ranges.rv_num[i] = v;
        ranges.rv_b[i] = ranges.u16_at[b];
        ranges.rv_e[i] = ranges.u16_at[e];
        ranges.rv_joins[i] = e < ctx.out_n && ctx.out[e] as int == 32;
        if (is_bookmarked(c, v)) ranges_add_event(ranges, ranges.rv_b[i], 3, 0, v);
        if (note_of(c, v) >= 0) ranges_add_event(ranges, ranges.rv_e[i], 2, 1, v)
    }
    // (Each verse's place, past the marks put in before it: a bookmark
    // before its number is not in it, nor its note after its end.)
    shift: int = 0;
    j: int = 0;
    for i in 0..ranges.rv_count {
        b: int = ranges.rv_b[i];
        while (j < ranges.ev_n && ranges.ev_pos[j] <= b) {
            shift = shift + ranges.ev_len[j];
            j = j + 1
        }
        ranges.rv_b[i] = b + shift;
        e: int = ranges.rv_e[i];
        while (j < ranges.ev_n && ranges.ev_pos[j] < e) {
            shift = shift + ranges.ev_len[j];
            j = j + 1
        }
        ranges.rv_e[i] = e + shift
    }
    ranges_glosses(ctx, ranges)
}

ranges_add_event(
    ranges: *ChapterRanges,
    pos: int,
    n: int,
    kind: int,
    v: int
) {
    if (ranges.ev_n >= len(ranges.ev_pos)) return;
    ranges.ev_pos[ranges.ev_n] = pos;
    ranges.ev_len[ranges.ev_n] = n;
    ranges.ev_kind[ranges.ev_n] = kind;
    ranges.ev_verse[ranges.ev_n] = v;
    ranges.ev_n = ranges.ev_n + 1
}

ranges_index(ranges: *ChapterRanges, v: int): int {
    for i in 0..ranges.rv_count
        if (ranges.rv_num[i] == v) return i;
    -1
}

ranges_at(ranges: *ChapterRanges, k: int): int {
    for i in 0..ranges.rv_count
        if (k >= ranges.rv_b[i] && k < ranges.rv_e[i]) return i;
    -1
}

ranges_glosses(ctx: *ChapterLayout, ranges: *ChapterRanges) {
    ranges.gw_n = 0;
    if (!ctx.lay_orig) return;
    for i in 0..ctx.ow_n {
        if (ctx.ow_gl[i]) {
            ranges.gw_b[ranges.gw_n] = ranges_shifted(ranges, ranges.u16_at[ctx.ow_b[i]],
                true);
            ranges.gw_e[ranges.gw_n] = ranges_shifted(ranges, ranges.u16_at[ctx.ow_e[i]],
                false);
            ranges.gw_n = ranges.gw_n + 1
        }
    }
}

ranges_shifted(ranges: *ChapterRanges, u: int, begin: bool): int {
    s: int = 0;
    for j in 0..ranges.ev_n
        if (ranges.ev_pos[j] < u || begin && ranges.ev_pos[j] == u) s = s + ranges.ev_len[j];
    u + s
}

type ChapterRangesStorage = {
    u16_at_count: int;
    u16_at_data: [262145]int;
    rv_num_count: int;
    rv_num_data: [200]int;
    rv_b_count: int;
    rv_b_data: [200]int;
    rv_e_count: int;
    rv_e_data: [200]int;
    rv_joins_count: int;
    rv_joins_data: [200]bool;
    ev_pos_count: int;
    ev_pos_data: [400]int;
    ev_len_count: int;
    ev_len_data: [400]int;
    ev_kind_count: int;
    ev_kind_data: [400]int;
    ev_verse_count: int;
    ev_verse_data: [400]int;
    gw_b_count: int;
    gw_b_data: [4096]int;
    gw_e_count: int;
    gw_e_data: [4096]int
}

cr_slots: []ChapterRangesStorage = static_buffer([16]ChapterRangesStorage);

cr_used: []bool = static_buffer([16]bool);

cr_reserve(): int {
    slot: int = 0;
    while (slot < 16 && cr_used[slot]) slot = slot + 1;
    if (slot == 16) bible_storage_exit(1);
    cr_used[slot] = true;
    cr_slots[slot].u16_at_count = 262145;
    for k in 0..262145 cr_slots[slot].u16_at_data[k] = 0;
    cr_slots[slot].rv_num_count = 200;
    for k in 0..200 cr_slots[slot].rv_num_data[k] = 0;
    cr_slots[slot].rv_b_count = 200;
    for k in 0..200 cr_slots[slot].rv_b_data[k] = 0;
    cr_slots[slot].rv_e_count = 200;
    for k in 0..200 cr_slots[slot].rv_e_data[k] = 0;
    cr_slots[slot].rv_joins_count = 200;
    for k in 0..200 cr_slots[slot].rv_joins_data[k] = false;
    cr_slots[slot].ev_pos_count = 400;
    for k in 0..400 cr_slots[slot].ev_pos_data[k] = 0;
    cr_slots[slot].ev_len_count = 400;
    for k in 0..400 cr_slots[slot].ev_len_data[k] = 0;
    cr_slots[slot].ev_kind_count = 400;
    for k in 0..400 cr_slots[slot].ev_kind_data[k] = 0;
    cr_slots[slot].ev_verse_count = 400;
    for k in 0..400 cr_slots[slot].ev_verse_data[k] = 0;
    cr_slots[slot].gw_b_count = 4096;
    for k in 0..4096 cr_slots[slot].gw_b_data[k] = 0;
    cr_slots[slot].gw_e_count = 4096;
    for k in 0..4096 cr_slots[slot].gw_e_data[k] = 0;
    slot
}

chapter_ranges_release(ctx: *ChapterRanges) {
    if (ctx.storage_slot >= 0) {
        cr_used[ctx.storage_slot] = false;
        ctx.storage_slot = -1
    }
}
