tag bible_wire_internal;

use_tag std, bible;

import "ui.l8";

// A skin owns its decoded screen independently of core's construction buffers.
tag bible_wire
type WireScreen = {
    window_section: int;
    window_row: int;
    rows: []UiRow;
    rows_n: int;
    sections: []UiSection;
    sections_n: int;
    pool: []i8;
    pool_n: int;
    id: int;
    kind: int;
    arg: int;
    group: int;
    title: UiText;
    search: UiText;
    focus: int;
    search_text: UiText;
    search_wait: int;
    search_go: bool;
    search_focus: bool;
    scopes: UiText;
    scope_labels: UiText;
    scope: int;
    plain: bool;
    focus_select: bool;
    focus_middle: bool;
    intro: UiText;
    subtitle: UiText;
    toolbar: UiText;
    toolbar_action: int;
    toolbar_arg: int;
    toolbar_style: int;
    confirm: UiText;
    confirm_action: int;
    confirm_off: bool;
    intro_runs: int;
    intro_runs_n: int;
    hero: UiText;
    hero_script: int;
    hero_sub: UiText;
    hero_line: UiText;
    hero_runs: int;
    hero_runs_n: int;
    index: UiText;
    segments: UiText;
    segment: int;
    segments_action: int;
    filter_colors: UiText;
    filter_labels: UiText;
    filter: int;
    filter_action: int;
    sorts: UiText;
    sort: int;
    sort_action: int;
    marks: []int;
    marks_n: int;
    empty_symbol: UiText;
    empty_title: UiText;
    empty_line: UiText;
    button: UiText;
    commands: []UiCommand;
    commands_n: int;
    runs: []int;
    runs_n: int;
    actions: []UiAction;
    actions_n: int;
    cells: []UiCell;
    cells_n: int;
    links: []UiLink;
    links_n: int;
    page: bool;
    keys: int;
    intro_quote: bool;
    grid: bool;
    left: UiText;
    left_icon: UiText;
    left_action: int;
    left_style: int;
    focus_wash: bool;
    focus_from: int;
    focus_to: int;
    segments_title: bool;
    tools: []UiTool;
    tools_n: int
}

tag bible_wire
wire_screen(): WireScreen@new {
    WireScreen {
        window_section: -1,
        window_row: -1,
        rows: new UiRow[UI_ROWS_MOST](ui_empty_row()),
        rows_n: 0,
        sections: new UiSection[UI_SECTIONS_MOST](UiSection {
            header: no_text,
            footer: no_text,
            first: 0,
            n: 0,
            button: no_text,
            button_action: 0,
            header_suffix: no_text,
            credit: 0,
            lazy: false,
            columns: no_text
        }),
        sections_n: 0,
        pool: new i8[1048576](0i8),
        pool_n: 0,
        id: 0,
        kind: 0,
        arg: 0,
        group: 0,
        title: UiText { at: 0, n: 0 },
        search: UiText { at: 0, n: 0 },
        focus: -1,
        search_text: UiText { at: 0, n: 0 },
        search_wait: 0,
        search_go: false,
        search_focus: false,
        scopes: UiText { at: 0, n: 0 },
        scope_labels: UiText { at: 0, n: 0 },
        scope: 0,
        plain: false,
        focus_select: false,
        focus_middle: false,
        intro: UiText { at: 0, n: 0 },
        subtitle: UiText { at: 0, n: 0 },
        toolbar: UiText { at: 0, n: 0 },
        toolbar_action: 0,
        toolbar_arg: 0,
        toolbar_style: 0,
        confirm: UiText { at: 0, n: 0 },
        confirm_action: 0,
        confirm_off: false,
        intro_runs: 0,
        intro_runs_n: 0,
        hero: UiText { at: 0, n: 0 },
        hero_script: 0,
        hero_sub: UiText { at: 0, n: 0 },
        hero_line: UiText { at: 0, n: 0 },
        hero_runs: 0,
        hero_runs_n: 0,
        index: UiText { at: 0, n: 0 },
        segments: UiText { at: 0, n: 0 },
        segment: 0,
        segments_action: 0,
        filter_colors: UiText { at: 0, n: 0 },
        filter_labels: UiText { at: 0, n: 0 },
        filter: -1,
        filter_action: 0,
        sorts: UiText { at: 0, n: 0 },
        sort: 0,
        sort_action: 0,
        marks: new int[16384](0),
        marks_n: 0,
        empty_symbol: UiText { at: 0, n: 0 },
        empty_title: UiText { at: 0, n: 0 },
        empty_line: UiText { at: 0, n: 0 },
        button: UiText { at: 0, n: 0 },
        commands: new UiCommand[16](UiCommand {
            title: UiText { at: 0, n: 0 },
            action: 0,
            arg: 0,
            destructive: false
        }),
        commands_n: 0,
        runs: new int[16384](0),
        runs_n: 0,
        actions: new UiAction[1024](UiAction { title: UiText { at: 0, n: 0 }, action: 0, icon: UiText { at: 0, n: 0 } }),
        actions_n: 0,
        cells: new UiCell[1024](UiCell {
            text: UiText { at: 0, n: 0 },
            sub: UiText { at: 0, n: 0 },
            count: UiText { at: 0, n: 0 },
            label: UiText { at: 0, n: 0 },
            script: 0,
            action: 0,
            arg: 0,
            tr: UiText { at: 0, n: 0 },
            flags: 0,
            actions: 0,
            actions_n: 0
        }),
        cells_n: 0,
        links: new UiLink[2048](UiLink {
            b: 0,
            e: 0,
            action: 0,
            arg: 0
        }),
        links_n: 0,
        page: false,
        keys: 0,
        intro_quote: false,
        grid: false,
        left: UiText { at: 0, n: 0 },
        left_icon: UiText { at: 0, n: 0 },
        left_action: 0,
        left_style: 0,
        focus_wash: false,
        focus_from: -1,
        focus_to: -1,
        segments_title: false,
        tools: new UiTool[8](UiTool {
            title: UiText { at: 0, n: 0 },
            icon: UiText { at: 0, n: 0 },
            label: UiText { at: 0, n: 0 },
            action: 0,
            arg: 0,
            style: 0,
            place: 0,
            menu: UiText { at: 0, n: 0 }
        }),
        tools_n: 0
    }
}

// Field spans stay borrowed from the input. Only decoded text enters the model.
tag bible_wire
type WireLine = {
    data: []i8;
    starts: []int;
    ends: []int;
    count: int;
    end: int
}

tag bible_wire
wire_line(line: *WireLine, start: int, end: int) {
    data: []i8 = line.data;
    begin: int = start;
    for at in start..end + 1 {
        if (at == end || data[at] == 9i8) {
            if (line.count >= len(line.starts)) return;
            line.starts[line.count] = begin;
            line.ends[line.count] = at;
            line.count += 1;
            begin = at + 1
        }
    }
}

tag bible_wire
wire_is(line: WireLine, name: str): bool {
    begin: int = line.starts[0];
    if (begin + len(name) > line.ends[0]) return false;
    for index in 0..len(name)
        if (line.data[begin + index] != name[index]) return false;
    begin + len(name) == line.ends[0] || line.data[begin + len(name)] == 32i8
}

tag bible_wire
wire_integer(data: []i8, start: int, end: int): int {
    at: int = start;
    negative: bool = at < end && data[at] == 45i8;
    if (negative) at += 1;
    value: int = 0;
    while (at < end && data[at] >= 48i8 && data[at] <= 57i8) {
        value = value * 10 + data[at] as int - 48;
        at += 1
    }
    if (negative) -value else value
}

tag bible_wire
wire_number(line: WireLine, field: int): int {
    if (field >= line.count) 0 else wire_integer(line.data, line.starts[field], line.ends[field])
}

tag bible_wire
wire_word_number(line: WireLine, word: int): int {
    at: int = line.starts[0];
    for _index in 0..word {
        while (at < line.ends[0] && line.data[at] != 32i8) at += 1;
        if (at < line.ends[0]) at += 1
    }
    wire_integer(line.data, at, line.ends[0])
}

wire_flag(line: WireLine, field: int, flag: i8): bool {
    if (field >= line.count) return false;
    for at in line.starts[field]..line.ends[field]
        if (line.data[at] == flag) return true;
    false
}

// Empty fields and escaped separators retain their exact byte lengths.
wire_text(screen: *WireScreen, line: WireLine, field: int): UiText {
    start: int = screen.pool_n;
    if (field >= line.count) return no_text;
    at: int = line.starts[field];
    while (at < line.ends[field]) {
        value: i8 = line.data[at];
        if (value == 92i8 && at + 1 < line.ends[field]) {
            at += 1;
            value = line.data[at];
            if (value == 110i8) value = 10i8 else if (value == 116i8) value = 9i8
        }
        if (screen.pool_n < len(screen.pool)) screen.pool[screen.pool_n] = value;
        screen.pool_n += 1;
        at += 1
    }
    UiText { at: start, n: screen.pool_n - start }
}

wire_pairs(screen: *WireScreen, line: WireLine, field: int): int {
    start: int = screen.runs_n;
    if (field >= line.count) return start;
    at: int = line.starts[field];
    while (at < line.ends[field]) {
        begin: int = at;
        while (at < line.ends[field] && line.data[at] != 58i8 && line.data[at] != 32i8) at += 1;
        end: int = wire_integer(line.data, begin, at);
        if (at < line.ends[field]) at += 1;
        begin = at;
        while (at < line.ends[field] && line.data[at] != 32i8) at += 1;
        style: int = wire_integer(line.data, begin, at);
        if (screen.runs_n + 2 <= len(screen.runs)) {
            screen.runs[screen.runs_n] = end;
            screen.runs[screen.runs_n + 1] = style
        }
        screen.runs_n += 2;
        at += 1
    }
    start
}

// A field's numbers split by spaces (UTF-16 places, in pairs) added to the
// screen's marks: where they begin.
wire_places(screen: *WireScreen, line: WireLine, field: int): int {
    start: int = screen.marks_n;
    if (field >= line.count) return start;
    at: int = line.starts[field];
    while (at < line.ends[field]) {
        begin: int = at;
        while (at < line.ends[field] && line.data[at] != 32i8) at += 1;
        if (screen.marks_n < len(screen.marks)) screen.marks[screen.marks_n] = wire_integer(line.data,
            begin, at);
        screen.marks_n += 1;
        at += 1
    }
    start
}

wire_actions(screen: *WireScreen, line: WireLine, field: int): int {
    start: int = screen.actions_n;
    if (field >= line.count) return start;
    at: int = line.starts[field];
    while (at < line.ends[field]) {
        begin: int = at;
        while (at < line.ends[field] && line.data[at] != 58i8) at += 1;
        action: int = wire_integer(line.data, begin, at);
        if (at < line.ends[field]) at += 1;
        begin = at;
        while (at < line.ends[field] && line.data[at] != 124i8) at += 1;
        original_start: int = line.starts[field];
        original_end: int = line.ends[field];
        line.starts[field] = begin;
        line.ends[field] = at;
        title: UiText = wire_text(screen, line, field);
        line.starts[field] = original_start;
        line.ends[field] = original_end;
        if (screen.actions_n < len(screen.actions)) screen.actions[screen.actions_n] = UiAction { title: title, action: action, icon: no_text };
        screen.actions_n += 1;
        at += 1
    }
    start
}

wire_reset(screen: *WireScreen) {
    screen.window_section = -1;
    screen.window_row = -1;
    screen.rows_n = 0;
    screen.sections_n = 0;
    screen.pool_n = 0;
    screen.marks_n = 0;
    screen.runs_n = 0;
    screen.actions_n = 0;
    screen.cells_n = 0;
    screen.links_n = 0;
    screen.tools_n = 0;
    screen.commands_n = 0;
    screen.title = no_text;
    screen.search = no_text;
    screen.focus = -1;
    screen.search_text = no_text;
    screen.search_wait = 0;
    screen.search_go = false;
    screen.search_focus = false;
    screen.scopes = no_text;
    screen.scope_labels = no_text;
    screen.scope = 0;
    screen.plain = false;
    screen.page = false;
    screen.keys = 0;
    screen.grid = false;
    screen.focus_select = false;
    screen.focus_middle = false;
    screen.focus_wash = false;
    screen.focus_from = -1;
    screen.focus_to = -1;
    screen.intro = no_text;
    screen.subtitle = no_text;
    screen.intro_runs = 0;
    screen.intro_runs_n = 0;
    screen.intro_quote = false;
    screen.hero = no_text;
    screen.hero_script = 0;
    screen.hero_sub = no_text;
    screen.hero_line = no_text;
    screen.hero_runs = 0;
    screen.hero_runs_n = 0;
    screen.index = no_text;
    screen.left = no_text;
    screen.left_icon = no_text;
    screen.left_action = 0;
    screen.left_style = 0;
    screen.confirm = no_text;
    screen.confirm_action = 0;
    screen.confirm_off = false;
    screen.segments = no_text;
    screen.segment = 0;
    screen.segments_action = 0;
    screen.segments_title = false;
    screen.filter_colors = no_text;
    screen.filter_labels = no_text;
    screen.filter = -1;
    screen.filter_action = 0;
    screen.sorts = no_text;
    screen.sort = 0;
    screen.sort_action = 0;
    screen.empty_symbol = no_text;
    screen.empty_title = no_text;
    screen.empty_line = no_text;
    screen.button = no_text;
    screen.toolbar = no_text;
    screen.toolbar_action = 0;
    screen.toolbar_arg = 0;
    screen.toolbar_style = 0
}

wire_row(screen: *WireScreen, line: WireLine): bool {
    if (screen.rows_n >= len(screen.rows) || screen.sections_n == 0) return false;
    row: UiRow = ui_empty_row();
    for kind in 1..len(ui_kind_names) {
        field: int = 1;
        name: str = ui_kind_names[kind];
        same: bool = line.ends[field] - line.starts[field] == len(name);
        for at in 0..len(name)
            if (same && line.data[line.starts[field] + at] != name[at]) same = false;
        if (same) row.kind = kind
    }
    if (row.kind == 0) return false;
    row.action = wire_number(line, 2);
    row.arg = wire_number(line, 3);
    row.title = wire_text(screen, line, 4);
    row.detail = wire_text(screen, line, 5);
    row.icon = wire_text(screen, line, 6);
    for accessory in 0..len(ui_acc_names) {
        name: str = ui_acc_names[accessory];
        same: bool = line.ends[7] - line.starts[7] == len(name);
        for at in 0..len(name)
            if (same && line.data[line.starts[7] + at] != name[at]) same = false;
        if (same) row.acc = accessory
    }
    row.disabled = wire_flag(line, 8, 'd');
    row.destructive = wire_flag(line, 8, 'x');
    row.on = wire_flag(line, 8, 'o');
    row.value_detail = wire_flag(line, 8, 'v');
    row.scripture = wire_flag(line, 8, 's');
    row.faint = wire_flag(line, 8, 'f');
    row.strong = wire_flag(line, 8, 'b');
    row.tinted = wire_flag(line, 8, 't');
    row.icon_faint = wire_flag(line, 8, 'g');
    row.small = wire_flag(line, 8, 'm');
    row.circle_off = wire_flag(line, 8, 'k');
    row.trailing_tinted = wire_flag(line, 8, 'a');
    row.field_go = wire_flag(line, 8, 'r');
    row.query_marks = wire_flag(line, 8, 'q');
    row.busy = wire_flag(line, 8, 'w');
    row.field_live = wire_flag(line, 8, 'l');
    row.menu = wire_flag(line, 8, 'u');
    row.heading = wire_flag(line, 8, 'h');
    row.value = wire_number(line, 9);
    row.options = wire_text(screen, line, 10);
    row.lo = wire_number(line, 11);
    row.hi = wire_number(line, 12);
    row.label = wire_text(screen, line, 13);
    row.trailing = wire_text(screen, line, 14);
    row.delete_action = wire_number(line, 15);
    row.custom = wire_number(line, 16);
    row.hint = wire_text(screen, line, 17);
    row.marks = wire_places(screen, line, 18);
    row.marks_n = (screen.marks_n - row.marks) / 2;
    row.lines = wire_number(line, 19);
    row.circle = wire_number(line, 20);
    row.circle_action = wire_number(line, 21);
    row.suffix = wire_text(screen, line, 22);
    row.icon_color = wire_text(screen, line, 23);
    row.note = wire_text(screen, line, 24);
    row.info_action = wire_number(line, 25);
    row.actions = wire_actions(screen, line, 26);
    row.actions_n = screen.actions_n - row.actions;
    row.runs = wire_pairs(screen, line, 27);
    row.runs_n = (screen.runs_n - row.runs) / 2;
    row.truns = wire_pairs(screen, line, 28);
    row.truns_n = (screen.runs_n - row.truns) / 2;
    row.title_lines = wire_number(line, 29);
    row.field_kind = wire_number(line, 30);
    row.lead = wire_text(screen, line, 31);
    row.lead_style = wire_number(line, 32);
    row.side = wire_text(screen, line, 33);
    row.sruns = wire_pairs(screen, line, 34);
    row.sruns_n = (screen.runs_n - row.sruns) / 2;
    row.side_note = wire_text(screen, line, 35);
    if (line.count > 36) {
        at: int = line.starts[36];
        for index in 0..row.actions_n {
            begin: int = at;
            while (at < line.ends[36] && line.data[at] != 124i8) at += 1;
            original_start: int = line.starts[36];
            original_end: int = line.ends[36];
            line.starts[36] = begin;
            line.ends[36] = at;
            icon: UiText = wire_text(screen, line, 36);
            line.starts[36] = original_start;
            line.ends[36] = original_end;
            if (row.actions + index < len(screen.actions)) screen.actions[row.actions + index].icon = icon;
            at += 1
        }
    }
    row.links = screen.links_n;
    if (line.count > 37) {
        at: int = line.starts[37];
        while (at < line.ends[37]) {
            values: []int = new int[4](0);
            for index in 0..4 {
                begin: int = at;
                while (at < line.ends[37] && line.data[at] != 58i8 && line.data[at] != 124i8) at += 1;
                values[index] = wire_integer(line.data, begin, at);
                at += 1
            }
            if (screen.links_n < len(screen.links)) screen.links[screen.links_n] = UiLink {
                b: values[0],
                e: values[1],
                action: values[2],
                arg: values[3]
            };
            screen.links_n += 1
        }
    }
    row.links_n = screen.links_n - row.links;
    row.caps = wire_places(screen, line, 38);
    row.caps_n = (screen.marks_n - row.caps) / 2;
    row.cells = screen.cells_n;
    screen.rows[screen.rows_n] = row;
    screen.rows_n += 1;
    if (!screen.sections[screen.sections_n - 1].lazy) screen.sections[screen.sections_n - 1].n += 1;
    true
}

wire_screen_line(screen: *WireScreen, line: WireLine): bool {
    if (wire_is(line, "screen")) {
        wire_reset(screen);
        screen.id = wire_word_number(line, 1);
        screen.kind = wire_word_number(line, 2);
        screen.arg = wire_word_number(line, 3);
        screen.group = wire_word_number(line, 4);
        screen.title = wire_text(screen, line, 1);
        screen.search = wire_text(screen, line, 2)
    } else if (wire_is(line, "row")) return wire_row(screen, line) else if (wire_is(line,
        "section")) {
        if (screen.sections_n >= len(screen.sections)) return false;
        screen.sections[screen.sections_n] = UiSection {
            header: wire_text(screen, line, 1),
            footer: wire_text(screen, line, 2),
            first: screen.rows_n,
            n: 0,
            button: wire_text(screen, line, 3),
            button_action: wire_number(line, 4),
            header_suffix: wire_text(screen, line, 5),
            credit: wire_number(line, 6),
            lazy: false,
            columns: wire_text(screen, line, 7)
        };
        screen.sections_n += 1
    } else if (wire_is(line, "lazy")) {
        if (screen.sections_n == 0) return false;
        section: int = screen.sections_n - 1;
        screen.sections[section].lazy = true;
        screen.sections[section].n = wire_word_number(line, 1);
        row: int = wire_word_number(line, 2);
        if (row >= 0) {
            screen.window_section = section;
            screen.window_row = row
        }
    } else if (wire_is(line, "cell")) {
        if (screen.cells_n >= len(screen.cells) || screen.rows_n == 0) return false;
        start: int = wire_actions(screen, line, 10);
        screen.cells[screen.cells_n] = UiCell {
            action: wire_number(line, 1),
            arg: wire_number(line, 2),
            script: wire_number(line, 3),
            text: wire_text(screen, line, 4),
            sub: wire_text(screen, line, 5),
            count: wire_text(screen, line, 6),
            label: wire_text(screen, line, 7),
            tr: wire_text(screen, line, 8),
            flags: wire_number(line, 9),
            actions: start,
            actions_n: screen.actions_n - start
        };
        screen.cells_n += 1;
        screen.rows[screen.rows_n - 1].cells_n += 1
    } else if (wire_is(line, "focus")) {
        screen.focus = wire_word_number(line, 1);
        mode: int = wire_word_number(line, 2);
        screen.focus_select = mode == 1;
        screen.focus_middle = mode == 2;
        screen.focus_wash = mode == 3;
        if (mode == 4) {
            screen.focus_from = wire_word_number(line, 3);
            screen.focus_to = wire_word_number(line, 4)
        }
    } else if (wire_is(line, "subtitle")) screen.subtitle = wire_text(screen, line,
        1) else if (wire_is(line, "intro")) {
        screen.intro = wire_text(screen, line, 1);
        screen.intro_runs = wire_pairs(screen, line, 2);
        screen.intro_runs_n = (screen.runs_n - screen.intro_runs) / 2;
        screen.intro_quote = wire_number(line, 3) == 1
    } else if (wire_is(line, "hero")) {
        screen.hero = wire_text(screen, line, 1);
        screen.hero_script = wire_number(line, 2);
        screen.hero_sub = wire_text(screen, line, 3);
        screen.hero_line = wire_text(screen, line, 4);
        screen.hero_runs = wire_pairs(screen, line, 5);
        screen.hero_runs_n = (screen.runs_n - screen.hero_runs) / 2
    } else if (wire_is(line, "left")) {
        screen.left_action = wire_number(line, 1);
        screen.left = wire_text(screen, line, 2);
        screen.left_icon = wire_text(screen, line, 3);
        screen.left_style = wire_number(line, 4)
    } else if (wire_is(line, "confirm")) {
        screen.confirm_action = wire_number(line, 1);
        screen.confirm = wire_text(screen, line, 2);
        screen.confirm_off = wire_number(line, 3) == 1
    } else if (wire_is(line, "tool")) {
        if (screen.tools_n >= len(screen.tools)) return false;
        screen.tools[screen.tools_n] = UiTool {
            action: wire_number(line, 1),
            arg: wire_number(line, 2),
            title: wire_text(screen, line, 3),
            icon: wire_text(screen, line, 4),
            label: wire_text(screen, line, 5),
            style: wire_number(line, 6),
            place: wire_number(line, 7),
            menu: wire_text(screen, line, 8)
        };
        screen.tools_n += 1
    } else if (wire_is(line, "segments")) {
        screen.segments_action = wire_number(line, 1);
        screen.segment = wire_number(line, 2);
        screen.segments = wire_text(screen, line, 3);
        screen.segments_title = wire_number(line, 4) == 1
    } else if (wire_is(line, "filter")) {
        screen.filter_action = wire_number(line, 1);
        screen.filter = wire_number(line, 2);
        screen.filter_colors = wire_text(screen, line, 3);
        screen.filter_labels = wire_text(screen, line, 4)
    } else if (wire_is(line, "sort")) {
        screen.sort_action = wire_number(line, 1);
        screen.sort = wire_number(line, 2);
        screen.sorts = wire_text(screen, line, 3)
    } else if (wire_is(line, "field")) {
        screen.search_text = wire_text(screen, line, 1);
        screen.search_wait = wire_number(line, 2);
        screen.search_go = wire_flag(line, 3, 'g');
        screen.search_focus = wire_flag(line, 3, 'f')
    } else if (wire_is(line, "scopes")) {
        screen.scope = wire_number(line, 1);
        screen.scopes = wire_text(screen, line, 2);
        screen.scope_labels = wire_text(screen, line, 3)
    } else if (wire_is(line, "empty")) {
        screen.empty_symbol = wire_text(screen, line, 1);
        screen.empty_title = wire_text(screen, line, 2);
        screen.empty_line = wire_text(screen, line, 3)
    } else if (wire_is(line, "button")) screen.button = wire_text(screen, line, 1) else if (wire_is(line,
        "command")) {
        if (screen.commands_n >= len(screen.commands)) return false;
        screen.commands[screen.commands_n] = UiCommand {
            action: wire_number(line, 1),
            arg: wire_number(line, 2),
            title: wire_text(screen, line, 3),
            destructive: wire_flag(line, 4, 'x')
        };
        screen.commands_n += 1
    } else if (wire_is(line, "index")) screen.index = wire_text(screen, line, 1) else if (wire_is(line,
        "plain")) screen.plain = true else if (wire_is(line, "page")) screen.page = true else if (wire_is(line,
        "grid")) screen.grid = true else if (wire_is(line, "keys")) screen.keys = wire_word_number(line,
        1);
    screen.pool_n <= len(screen.pool) && screen.runs_n <= len(screen.runs) && screen.marks_n <= len(screen.marks) && screen.actions_n <= len(screen.actions) && screen.links_n <= len(screen.links)
}

// Decode a complete screen. False reports malformed framing or capacity failure.
tag bible_wire
wire_decode_span(
    screen: *WireScreen,
    data: []i8,
    start: int,
    count: int
): bool {
    if (start < 0 || count < start || count > len(data)) return false;
    begin: int = start;
    started: bool = false;
    ended: bool = false;
    for at in start..count {
        if (data[at] == 10i8) {
            region {
                line: WireLine = WireLine {
                    data: data,
                    starts: new int[40](at),
                    ends: new int[40](at),
                    count: 0,
                    end: at
                };
                wire_line(&line, begin, at);
                if (!started) {
                    if (!wire_is(line, "screen")) return false;
                    started = true
                } else if (wire_is(line, "screen") || ended) return false;
                if (wire_is(line, "end")) ended = true;
                if (!wire_screen_line(screen, line)) return false
            }
            begin = at + 1
        }
    }
    started && ended && begin == count
}

tag bible_wire
wire_decode(screen: *WireScreen, data: []i8, count: int): bool {
    wire_decode_span(screen, data, 0, count)
}
