tag bible;

use_tag std;

// The ESV's chapters the reader holds (DESIGN.md §9.4.5), apart from any
// platform: never more than Crossway's terms allow. Each chapter's records
// (the bsb.txt format, as the proxy sends them) are kept in a pool; the
// ESV's text (text 5, text.l8) is made of them; and what is kept on disk is
// said by index.tsv's lines (BOOK C VERSES FETCHED USED). ios_esv.l8 reads
// and writes the files, and fetches.
//
// The rules, checked after every insert: at most 500 verses held in all
// (on disk and in memory); at most half a book's verses held of any book; a
// chapter that is more than half its book even alone (Jude, Philemon,
// Haggai 2) is held in memory only, never on disk, and only while it is on
// screen; the least recently used go first, but never one on screen (nor
// its neighbours, for the 500); a chapter fetched more than 30 days ago is
// fetched again.
import "text.l8";

import "store.l8";

ESV_MOST: int = 500;

// ---- a chapter's state, while it is not here (§9.4.6) ----
ESV_HERE: int = 0;

ESV_LOADING: int = 1;

ESV_OFFLINE: int = 2;

ESV_BUSY: int = 3;

ESV_DAILY: int = 4;

ESV_UNAVAILABLE: int = 5;

// The server's answer as a state: its HTTP status (0: no answer), and
// whether it said its daily limit is reached.
esv_state_for(status: int, daily: bool): int {
    if (status == 200) return ESV_HERE;
    if (status == 0 || status == 504) return ESV_OFFLINE;
    if (status == 429) return ESV_BUSY;
    if (status == 503 && daily) return ESV_DAILY;
    ESV_UNAVAILABLE
}

// The reader's calm line for a chapter that cannot come now (in a plan's
// day, the passage's), whether Try Again can help, and the way to read on
// (in a plan's day, Change Version; else Read in the BSB).
esv_line(st: int, in_day: bool): str {
    if (st == ESV_OFFLINE && in_day) return "This passage needs a connection in the ESV.";
    if (st == ESV_OFFLINE) return "The ESV needs an internet connection.";
    if (st == ESV_BUSY) return "Many people are reading the ESV just now. It will try again in a minute.";
    if (st == ESV_DAILY) return "The ESV has reached its daily limit for Smooth Bible. It will be back tomorrow.";
    "The ESV isn\�\�\�t available right now."
}

esv_can_try(st: int): bool {
    st == ESV_OFFLINE || st == ESV_UNAVAILABLE
}

esv_try_title: str = "Try Again";

esv_other_title(in_day: bool): str {
    if (in_day) "Change Version" else "Read in the BSB"
}

// The line ending an ESV chapter: the notice the server sent (else this),
// and the link to its site.
esv_notice_default: str = "(ESV)";

esv_site_title: str = "esv.org";

ESV_STALE: int = 2592000;

// The chapters held, in no order: chapter (through the Bible), verses,
// when fetched and last shown, whether on disk; their records in the pool.
EC_MOST: int = 256;

ec_n: int = 0;

ec_c: []int = new int[256](0);

ec_verses: []int = new int[256](0);

ec_fetched: []int = new int[256](0);

ec_used: []int = new int[256](0);

ec_disk: []bool = new bool[256](false);

ec_at: []int = new int[256](0);

ec_len: []int = new int[256](0);

ec_pool: []i8 = new i8[2097152](0i8);

ec_pool_n: int = 0;

ec_spare: []i8 = new i8[2097152](0i8);

// What the reader shows now: chapters vis_lo to vis_hi (-1: none).
ec_vis_lo: int = -1;

ec_vis_hi: int = -1;

// What eviction let go, for the platform to delete from disk: chapters.
ec_gone_n: int = 0;

ec_gone: []int = new int[256](0);

// Where chapter c is held (-1: not).
esv_find(c: int): int {
    for i in 0..ec_n
        if (ec_c[i] == c) return i;
    -1
}

esv_held(c: int): bool {
    esv_find(c) >= 0
}

// The verses of book b (the BSB's numbering, as the proxy's limits count
// them, with the ESV's own two: 3 John 1:15 and Revelation 12:18).
esv_book_verses(b: int): int {
    n: int = 0;
    for c in book_first[b]..book_first[b] + book_count[b] n = n + esv_chapter_verses(c);
    n
}

esv_chapter_verses(c: int): int {
    base: int = if (tx_ready[0]) tx_ch_verses[0][c] else ch_verses[c];
    b: int = ch_book[c];
    // (3JN 1 and REV 12: one more each in the ESV.)
    if (book_is_code(b, 51, 74, 78) && ch_num[c] == 1 || book_is_code(b, 82, 69, 86) && ch_num[c] == 12) base + 1 else base
}

// Whether book b's code is the three letters k1 k2 k3.
book_is_code(
    b: int,
    k1: int,
    k2: int,
    k3: int
): bool {
    src: TextSource = ready_source(TEXT_BSB);
    p: int = src.book_lines[b] + 1;
    same: bool = src.data[p] as int == k1 && src.data[p + 1] as int == k2 && src.data[p + 2] as int == k3;
    same
}

// How many verses may be held of book b: half of them.
esv_book_most(b: int): int {
    esv_book_verses(b) / 2
}

// Whether chapter c is too big for its book to be kept on disk at all.
esv_too_big(c: int): bool {
    esv_chapter_verses(c) > esv_book_most(ch_book[c])
}

esv_total(): int {
    n: int = 0;
    for i in 0..ec_n n = n + ec_verses[i];
    n
}

esv_book_total(b: int): int {
    n: int = 0;
    for i in 0..ec_n
        if (ch_book[ec_c[i]] == b) n = n + ec_verses[i];
    n
}

esv_visible(c: int): bool {
    c == ec_hold_c || ec_vis_lo >= 0 && c >= ec_vis_lo && c <= ec_vis_hi
}

// A chapter shown elsewhere than the reader (Compare's, a preview's),
// held as if on screen (-1: none).
ec_hold_c: int = -1;

// On screen, or in the window around it (DESIGN.md §9.4.11): the one
// before, and the two after.
esv_pinned(c: int): bool {
    ec_vis_lo >= 0 && c >= ec_vis_lo - 1 && c <= ec_vis_hi + 2
}

// Whether chapter c (not on screen) may be fetched ahead: held, under the
// rules, it would stay, and would put out none of the chapters on screen
// or beside it (vis_lo - 1 to vis_hi + 1). A trial: c inserted (its verses
// as the BSB counts them), the rules run, what is held put back.
esv_room_for(c: int): bool {
    if (esv_held(c)) return true;
    if (esv_too_big(c) || ec_n >= EC_MOST) return false;
    n: int = ec_n;
    for i in 0..n {
        er_c[i] = ec_c[i];
        er_verses[i] = ec_verses[i];
        er_fetched[i] = ec_fetched[i];
        er_used[i] = ec_used[i];
        er_disk[i] = ec_disk[i];
        er_at[i] = ec_at[i];
        er_len[i] = ec_len[i]
    }
    gone: int = ec_gone_n;
    newest: int = 0;
    for i in 0..n
        if (ec_used[i] > newest) newest = ec_used[i];
    ec_c[n] = c;
    ec_verses[n] = esv_chapter_verses(c);
    ec_fetched[n] = newest + 1;
    ec_used[n] = newest + 1;
    ec_disk[n] = true;
    ec_at[n] = 0;
    ec_len[n] = 0;
    ec_n = n + 1;
    esv_keep_rules();
    ok: bool = esv_held(c);
    for i in 0..n {
        x: int = er_c[i];
        if (ec_vis_lo >= 0 && x >= ec_vis_lo - 1 && x <= ec_vis_hi + 1 && !esv_held(x)) ok = false
    }
    ec_n = n;
    for i in 0..n {
        ec_c[i] = er_c[i];
        ec_verses[i] = er_verses[i];
        ec_fetched[i] = er_fetched[i];
        ec_used[i] = er_used[i];
        ec_disk[i] = er_disk[i];
        ec_at[i] = er_at[i];
        ec_len[i] = er_len[i]
    }
    ec_gone_n = gone;
    ok
}

er_c: []int = new int[256](0);

er_verses: []int = new int[256](0);

er_fetched: []int = new int[256](0);

er_used: []int = new int[256](0);

er_disk: []bool = new bool[256](false);

er_at: []int = new int[256](0);

er_len: []int = new int[256](0);

// Chapter c's records, the first n bytes of b, fetched at time t: held
// (in place of any it had), and the rules kept.
esv_insert(
    c: int,
    b: []i8,
    n: int,
    t: int
) {
    i: int = esv_find(c);
    if (i >= 0) esv_drop(i);
    if (ec_n >= EC_MOST) return;
    if (ec_pool_n + n > len(ec_pool)) esv_compact();
    if (ec_pool_n + n > len(ec_pool)) return;
    for x in 0..n ec_pool[ec_pool_n + x] = b[x];
    k: int = ec_n;
    ec_c[k] = c;
    ec_at[k] = ec_pool_n;
    ec_len[k] = n;
    ec_pool_n = ec_pool_n + n;
    ec_verses[k] = esv_count_verses(b, n);
    ec_fetched[k] = t;
    ec_used[k] = t;
    ec_disk[k] = !esv_too_big(c);
    ec_n = ec_n + 1;
    esv_keep_rules()
}

// The verse lines of records (V15>14 counts: it is a verse shown).
esv_count_verses(b: []i8, n: int): int {
    v: int = 0;
    start: bool = true;
    for i in 0..n {
        if (start && b[i] as int == 86) v = v + 1;
        start = b[i] as int == 10
    }
    v
}

// Chapter c shown now (at time t): its use is newest.
esv_touch(c: int, t: int) {
    i: int = esv_find(c);
    if (i >= 0) ec_used[i] = t
}

// What the reader shows now: chapters lo to hi. Memory-only chapters it
// has left are let go.
esv_set_visible(lo: int, hi: int) {
    ec_vis_lo = lo;
    ec_vis_hi = hi;
    esv_keep_rules()
}

// Entry i let go (its disk file, for the platform, in ec_gone).
esv_drop(i: int) {
    if (ec_disk[i] && ec_gone_n < len(ec_gone)) {
        ec_gone[ec_gone_n] = ec_c[i];
        ec_gone_n = ec_gone_n + 1
    }
    for j in i..ec_n - 1 {
        ec_c[j] = ec_c[j + 1];
        ec_verses[j] = ec_verses[j + 1];
        ec_fetched[j] = ec_fetched[j + 1];
        ec_used[j] = ec_used[j + 1];
        ec_disk[j] = ec_disk[j + 1];
        ec_at[j] = ec_at[j + 1];
        ec_len[j] = ec_len[j + 1]
    }
    ec_n = ec_n - 1
}

// The pool's records moved together (those let go given back).
esv_compact() {
    n: int = 0;
    for i in 0..ec_n {
        for x in 0..ec_len[i] ec_spare[n + x] = ec_pool[ec_at[i] + x];
        ec_at[i] = n;
        n = n + ec_len[i]
    }
    for x in 0..n ec_pool[x] = ec_spare[x];
    ec_pool_n = n
}

// The least recently used entry (of book b, or any, if b is -1) that may
// go: not on screen; and, if pins, not a neighbour of it. -1: none.
esv_oldest(b: int, pins: bool): int {
    best: int = -1;
    for i in 0..ec_n {
        c: int = ec_c[i];
        ok: bool = (b < 0 || ch_book[c] == b) && !esv_visible(c) && !(pins && esv_pinned(c));
        if (ok && (best < 0 || ec_used[i] < ec_used[best])) best = i
    }
    best
}

esv_keep_rules() {
    // A memory-only chapter, only while it is on screen.
    i: int = 0;
    while (i < ec_n) {
        if (!ec_disk[i] && !esv_visible(ec_c[i])) esv_drop(i) else i = i + 1
    }
    // Half a book at most, of each book held (Memory's pinned verses
    // counted with it, §13.6).
    for b in 0..books {
        more: bool = true;
        while (more && esv_book_total(b) + esv_pin_book(b) > esv_book_most(b)) {
            j: int = esv_oldest(b, false);
            if (j < 0) more = false else esv_drop(j)
        }
    }
    // 500 verses at most, Memory's pinned among them: the neighbours kept
    // while anything else can go.
    more: bool = true;
    while (more && esv_total() + esv_pin_total() > ESV_MOST) {
        j: int = esv_oldest(-1, true);
        if (j < 0) j = esv_oldest(-1, false);
        if (j < 0) more = false else esv_drop(j)
    }
}

// Whether chapter c is to be fetched (again): not held, or held from more
// than 30 days before t.
esv_wanted(c: int, t: int): bool {
    i: int = esv_find(c);
    i < 0 || t - ec_fetched[i] > ESV_STALE
}

// ---- the ESV as a text ----
// Text 5 made of the chapters held: every book's B line (its name from the
// BSB, so the openers read the same), then each chapter held after its C
// line. A chapter not held has ch_start = ch_end = -1: its opener alone is
// laid out (lay_placeholder).
ec_text: []i8 = new i8[2621440](0i8);

ec_text_n: int = 0;

ect_put(k: int) {
    if (ec_text_n < len(ec_text)) {
        ec_text[ec_text_n] = k trunc i8;
        ec_text_n = ec_text_n + 1
    }
}

esv_build() {
    was: int = text_cur;
    text_use(TEXT_BSB);
    ec_text_n = 0;
    lines: []int = esv_lines;
    for b in 0..books {
        lines[b] = ec_text_n;
        for x in book_line[b]..line_end(book_line[b]) ect_put(bsb[x] as int);
        ect_put(10)
    }
    base_verses: []int = ch_verses;
    text_begin(TEXT_ESV);
    for b in 0..books book_line[b] = lines[b];
    for c in 0..chapters {
        ch_start[c] = -1;
        ch_end[c] = -1;
        ch_verses[c] = base_verses[c]
    }
    for i in 0..ec_n {
        c: int = ec_c[i];
        ect_put(67);
        esv_put_int(ch_num[c]);
        ect_put(10);
        ch_start[c] = ec_text_n;
        for x in 0..ec_len[i] ect_put(ec_pool[ec_at[i] + x] as int);
        if (ec_text_n > 0 && ec_text[ec_text_n - 1] as int != 10) ect_put(10);
        ch_end[c] = ec_text_n
    }
    text_done(TEXT_ESV, ec_text, ec_text_n);
    // (Each chapter's last verse, by its keys.)
    for i in 0..ec_n {
        c: int = ec_c[i];
        last: int = 0;
        p: int = ch_start[c];
        while (p < ch_end[c]) {
            e: int = line_end(p);
            if (bsb[p] as int == 86 && key_at(p + 1) > last) last = key_at(p + 1);
            p = e + 1
        }
        if (last > 0) ch_verses[c] = last
    }
    text_use(was)
}

esv_lines: []int = new int[66](0);

esv_put_int(n: int) {
    if (n >= 10) esv_put_int(n / 10);
    ect_put(48 + n % 10)
}

// ---- index.tsv, in fbuf ----
// BOOK C VERSES FETCHED USED, a line for each chapter kept on disk.
format_esv_index() {
    fbuf_n = 0;
    for i in 0..ec_n {
        if (ec_disk[i]) {
            c: int = ec_c[i];
            fput_book(ch_book[c]);
            fput_int(ch_num[c]);
            fput(9);
            fput_int(ec_verses[i]);
            fput(9);
            fput_int(ec_fetched[i]);
            fput(9);
            fput_int(ec_used[i]);
            fput(10)
        }
    }
}

// The index's lines (in fbuf): for each, its chapter, and when fetched and
// used, into ix_c and the rest (ix_n of them). The platform then reads each
// chapter's file and inserts it with esv_restore.
ix_n: int = 0;

ix_c: []int = new int[256](0);

ix_fetched: []int = new int[256](0);

ix_used: []int = new int[256](0);

parse_esv_index() {
    begin_lines();
    ix_n = 0;
    while (next_line()) {
        if (line_e > fpos && ix_n < len(ix_c)) {
            c: int = field_chapter(fpos);
            f3: int = field_after(field_after(fpos));
            f4: int = field_after(f3);
            f5: int = field_after(f4);
            if (c >= 0 && field_num(f3, false) > 0) {
                ix_c[ix_n] = c;
                ix_fetched[ix_n] = field_time(f4);
                ix_used[ix_n] = field_time(f5);
                ix_n = ix_n + 1
            }
        }
    }
}

// A chapter read back from disk: held as fetched then, used then.
esv_restore(
    c: int,
    b: []i8,
    n: int,
    fetched: int,
    used: int
) {
    esv_insert(c, b, n, fetched);
    i: int = esv_find(c);
    if (i >= 0) ec_used[i] = used;
    ec_gone_n = 0
}

// "bible: esv cache 64 verses (JHN 3, JHN 4)" into fbuf, for the demo's
// log.
format_esv_summary() {
    fbuf_n = 0;
    fput_str("bible: esv cache ");
    fput_int(esv_total());
    fput_str(" verses (");
    for i in 0..ec_n {
        if (i > 0) fput_str(", ");
        c: int = ec_c[i];
        for x in 0..3 fput(bsb_code_byte(ch_book[c], x));
        fput(32);
        fput_int(ch_num[c]);
        if (!ec_disk[i]) fput_str(" in memory")
    }
    fput_str(")\n")
}

bsb_code_byte(b: int, x: int): int {
    src: TextSource = ready_source(TEXT_BSB);
    k: int = src.data[src.book_lines[b] + 1 + x] as int;
    k
}

// ---- Memory's ESV passages: pinned verses (DESIGN.md §13.6) ----
// Each ESV passage's verses, a chapter's run of them a pin: its passage's
// id, chapter, first and last verse (keys), and their records (only those
// verses', with the paragraphs' marks before them) once fetched. They count
// toward the 500 and each book's half, and are never let go while their
// passage is kept: at most 200 verses pinned in all.
PIN_MOST: int = 200;

pn_n: int = 0;

pn_id: []int = new int[128](0);

pn_c: []int = new int[128](0);

pn_v1: []int = new int[128](0);

pn_v2: []int = new int[128](0);

pn_fetched: []int = new int[128](0);

pn_at: []int = new int[128](0);

pn_len: []int = new int[128](-1);

pn_pool: []i8 = new i8[262144](0i8);

pn_pool_n: int = 0;

esv_pin_total(): int {
    n: int = 0;
    for i in 0..pn_n n = n + pn_v2[i] - pn_v1[i] + 1;
    n
}

esv_pin_book(b: int): int {
    n: int = 0;
    for i in 0..pn_n
        if (ch_book[pn_c[i]] == b) n = n + pn_v2[i] - pn_v1[i] + 1;
    n
}

// Whether c1:v1 to c2:v2 (one book) may be pinned: 0 it may; 1, it would
// pass 200 verses; 2, half its book.
esv_pin_check(
    c1: int,
    v1: int,
    c2: int,
    v2: int
): int {
    n: int = range_verses(c1, v1, c2, v2);
    if (esv_pin_total() + n > PIN_MOST) return 1;
    // (No room for its chapters' runs in the table: refused as the 200
    // are, never dropped without a word.)
    if (pn_n + c2 - c1 + 1 > len(pn_id)) return 1;
    if (esv_pin_book(ch_book[c1]) + n > esv_book_most(ch_book[c1])) return 2;
    0
}

// Passage id's verses, c1:v1 to c2:v2, pinned (nothing held of them yet);
// the cache's rules kept. False if they may not be.
esv_pin_add(
    id: int,
    c1: int,
    v1: int,
    c2: int,
    v2: int
): bool {
    if (esv_pin_check(c1, v1, c2, v2) != 0) return false;
    for c in c1..c2 + 1 {
        if (pn_n < len(pn_id)) {
            k: int = pn_n;
            pn_id[k] = id;
            pn_c[k] = c;
            pn_v1[k] = (if (c == c1) v1 else 1);
            pn_v2[k] = (if (c == c2) v2 else esv_chapter_verses(c));
            pn_fetched[k] = 0;
            pn_at[k] = 0;
            pn_len[k] = -1;
            pn_n = pn_n + 1
        }
    }
    esv_keep_rules();
    true
}

// Passage id's pins let go (deleted, or its version changed).
esv_pin_remove(id: int) {
    i: int = 0;
    while (i < pn_n) {
        if (pn_id[i] == id) {
            for j in i..pn_n - 1 {
                pn_id[j] = pn_id[j + 1];
                pn_c[j] = pn_c[j + 1];
                pn_v1[j] = pn_v1[j + 1];
                pn_v2[j] = pn_v2[j + 1];
                pn_fetched[j] = pn_fetched[j + 1];
                pn_at[j] = pn_at[j + 1];
                pn_len[j] = pn_len[j + 1]
            }
            pn_n = pn_n - 1
        } else i = i + 1
    }
    pin_compact()
}

// The pool's records moved together.
pin_compact() {
    n: int = 0;
    for i in 0..pn_n {
        if (pn_len[i] > 0) {
            for x in 0..pn_len[i] ec_spare[n + x] = pn_pool[pn_at[i] + x];
            pn_at[i] = n;
            n = n + pn_len[i]
        }
    }
    for x in 0..n pn_pool[x] = ec_spare[x];
    pn_pool_n = n
}

// Whether passage id's verses are all here.
esv_pin_ready(id: int): bool {
    any: bool = false;
    for i in 0..pn_n {
        if (pn_id[i] == id) {
            any = true;
            if (pn_len[i] < 0) return false
        }
    }
    any
}

// Whether any pin of chapter c wants its records (missing, or fetched
// more than 30 days before t).
esv_pin_wants(c: int, t: int): bool {
    for i in 0..pn_n
        if (pn_c[i] == c && (pn_len[i] < 0 || t - pn_fetched[i] > ESV_STALE)) return true;
    false
}

// Whether the pins of chapter c were fetched before and are now stale
// (older than 30 days at t): fetched again when online (§13.6).
esv_pin_stale(c: int, t: int): bool {
    for i in 0..pn_n
        if (pn_c[i] == c && pn_len[i] >= 0 && t - pn_fetched[i] > ESV_STALE) return true;
    false
}

// Chapter c's pins filled from the reading cache, when it holds the
// chapter fresh at t (so it isn't fetched twice): how many took it.
esv_pin_from_cache(c: int, t: int): int {
    k: int = esv_find(c);
    if (k < 0 || t - ec_fetched[k] > ESV_STALE) return 0;
    n: int = ec_len[k];
    if (n > len(pin_tmp)) return 0;
    for x in 0..n pin_tmp[x] = ec_pool[ec_at[k] + x];
    esv_pin_fill(c, pin_tmp, n, ec_fetched[k])
}

pin_tmp: []i8 = new i8[262144](0i8);

// Chapter c's records came (the first n bytes of b, at t): each pin of it
// keeps its verses' records. How many pins took them.
esv_pin_fill(
    c: int,
    b: []i8,
    n: int,
    t: int
): int {
    got: int = 0;
    for i in 0..pn_n {
        if (pn_c[i] == c) {
            pin_take(i, b, n);
            pn_fetched[i] = t;
            got = got + 1
        }
    }
    if (got > 0) pin_compact();
    got
}

// Pin i's records from b: its verses' lines, and the paragraph's and
// stanza's marks just before its first.
pin_take(i: int, b: []i8, n: int) {
    if (pn_pool_n + n > len(pn_pool)) pin_compact();
    at: int = pn_pool_n;
    p: int = 0;
    key: int = 0;
    // (Where the marks before the next verse began, -1: none since words.)
    marks: int = -1;
    while (p < n) {
        e: int = p;
        while (e < n && b[e] as int != 10) e = e + 1;
        k: int = b[p] as int;
        if (k == 86) {
            key = pin_key(b, p + 1, e);
            if (key >= pn_v1[i] && key <= pn_v2[i] && marks >= 0)
                for q in marks..p pin_put(b[q] as int);
            marks = -1
        }
        inside: bool = key >= pn_v1[i] && key <= pn_v2[i];
        if (inside) {
            for q in p..e pin_put(b[q] as int);
            pin_put(10)
        } else if (k == 80 || k == 95) {
            if (marks < 0) marks = p
        } else if (k != 86) marks = -1;
        p = e + 1
    }
    pn_at[i] = at;
    pn_len[i] = pn_pool_n - at
}

pin_put(k: int) {
    if (pn_pool_n < len(pn_pool)) {
        pn_pool[pn_pool_n] = k trunc i8;
        pn_pool_n = pn_pool_n + 1
    }
}

// A verse's key at b[p] (V15>14: 14).
pin_key(b: []i8, p: int, e: int): int {
    n: int = 0;
    q: int = p;
    while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
        n = n * 10 + b[q] as int - 48;
        q = q + 1
    }
    if (q < e && b[q] as int == 62) {
        m: int = 0;
        q = q + 1;
        while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
            m = m * 10 + b[q] as int - 48;
            q = q + 1
        }
        return m
    }
    n
}

// Text TEXT_PIN made of passage id's pinned verses: every book's B line,
// then each of its chapters' records after their C line; other chapters
// have none. The current text kept.
pin_text: []i8 = new i8[524288](0i8);

pin_text_n: int = 0;

pin_text_put(k: int) {
    if (pin_text_n < len(pin_text)) {
        pin_text[pin_text_n] = k trunc i8;
        pin_text_n = pin_text_n + 1
    }
}

pin_lines: []int = new int[66](0);

esv_pin_build(id: int) {
    was: int = text_cur;
    text_use(TEXT_BSB);
    pin_text_n = 0;
    for b in 0..books {
        pin_lines[b] = pin_text_n;
        for x in book_line[b]..line_end(book_line[b]) pin_text_put(bsb[x] as int);
        pin_text_put(10)
    }
    base_verses: []int = ch_verses;
    text_begin(TEXT_PIN);
    for b in 0..books book_line[b] = pin_lines[b];
    for c in 0..chapters {
        ch_start[c] = -1;
        ch_end[c] = -1;
        ch_verses[c] = base_verses[c]
    }
    for i in 0..pn_n {
        if (pn_id[i] == id && pn_len[i] >= 0) {
            c: int = pn_c[i];
            pin_text_put(67);
            n: int = ch_num[c];
            if (n >= 100) pin_text_put(48 + n / 100);
            if (n >= 10) pin_text_put(48 + n / 10 % 10);
            pin_text_put(48 + n % 10);
            pin_text_put(10);
            ch_start[c] = pin_text_n;
            for x in 0..pn_len[i] pin_text_put(pn_pool[pn_at[i] + x] as int);
            ch_end[c] = pin_text_n
        }
    }
    text_done(TEXT_PIN, pin_text, pin_text_n);
    text_use(was)
}

// memory.txt, in fbuf: a PIN ID BOOK C V1 V2 FETCHED BYTES line for each
// pin, its records' bytes after it (none until they have come).
format_pins() {
    fbuf_n = 0;
    for i in 0..pn_n {
        fput_str("PIN\t");
        fput_int(pn_id[i]);
        fput(9);
        for x in 0..3 fput(bsb_code_byte(ch_book[pn_c[i]], x));
        fput(9);
        fput_int(ch_num[pn_c[i]]);
        fput(9);
        fput_int(pn_v1[i]);
        fput(9);
        fput_int(pn_v2[i]);
        fput(9);
        fput_int(pn_fetched[i]);
        fput(9);
        fput_int(pn_len[i]);
        fput(10);
        if (pn_len[i] > 0)
            for x in 0..pn_len[i] fput(pn_pool[pn_at[i] + x] as int)
    }
}

// memory.txt read back (in fbuf): the pins of passages that exist (keep,
// their ids, keep_n of them; any id, however large); a bad line ends the
// reading.
parse_pins(keep: []int, keep_n: int) {
    pn_n = 0;
    pn_pool_n = 0;
    begin_lines();
    while (next_line()) {
        if (!field_is(fpos, "PIN") || pn_n >= len(pn_id)) return;
        f2: int = field_after(fpos);
        f3: int = field_after(f2);
        f5: int = field_after(field_after(f3));
        f6: int = field_after(f5);
        f7: int = field_after(f6);
        f8: int = field_after(f7);
        id: int = field_num(f2, false);
        c: int = field_chapter(f3);
        v1: int = field_num(f5, false);
        v2: int = field_num(f6, false);
        t: int = field_num(f7, false);
        nb: int = field_num(f8, true);
        if (id <= 0 || c < 0 || v1 < 1 || v2 < v1 || t < 0 || nb == missing_num || nb < -1) return;
        at: int = line_e + 1;
        if (nb > 0 && at + nb > fbuf_n) return;
        kept: bool = false;
        for j in 0..keep_n
            if (keep[j] == id) kept = true;
        if (kept) {
            k: int = pn_n;
            pn_id[k] = id;
            pn_c[k] = c;
            pn_v1[k] = v1;
            pn_v2[k] = v2;
            pn_fetched[k] = t;
            pn_at[k] = pn_pool_n;
            pn_len[k] = nb;
            if (nb > 0)
                for x in 0..nb pin_put(fbuf[at + x] as int);
            pn_n = pn_n + 1
        }
        if (nb > 0) line_e = at + nb - 1
    }
}
