tag bible;

use_tag std;

// The stream: what is new comes by itself, a few a day (as a flashcard
// deck brings its new cards), into a language's Practice with what is
// due. Its order: the letters (then Hebrew's joined words), and once a
// few letters are met, the most common words alongside them, one of each
// in turn. Its pace is the person's (learnNewGreek, learnNewHebrew: new a
// day, counting any they add themselves that day; 0, only what they add).
// Practiceâ€¦ takes the next in line at once, any time (lc_next_add).
import "skin.l8";

import "learn_screens.l8";

// The pace's screen (from the language page), and a pace chosen (arg).
SCR_PACE: int = 53;

ACT_LC_PACE: int = 339;

ACT_LC_PACE_SET: int = 340;

lc_paces: []int = [0, 3, 5, 10, 20];

tag bible
lc_pace(lang: int): int {
    pref_get(if (lang == 0) "learnNewGreek" else "learnNewHebrew")
}

// Language lang's cards added today (forms aside: Practise Forms has its
// own), and of them its letters (and joined words) and its words.
lc_today_letters: int = 0;

lc_today_words: int = 0;

lc_added_today(lang: int, today: int): int {
    lc_today_letters = 0;
    lc_today_words = 0;
    for k in 0..cd_n {
        if (cd_lang[k] == lang && sk_local_day(cd_added[k]) == today) {
            if (cd_kind[k] == CK_WORD) lc_today_words = lc_today_words + 1 else if (cd_kind[k] != CK_FORM) lc_today_letters = lc_today_letters + 1
        }
    }
    lc_today_letters + lc_today_words
}

// The next letter in line (letters.txt's line: the letters, then the
// joined words), or -1.
lc_next_letter(lang: int): int {
    for kind in [CK_LETTER, CK_JOINED] {
        for i in 0..lt_n
            if (lt_lang[i] == lang && lt_kind[i] == kind && cl_of[i] < 0) return i
    }
    -1
}

// The next word in line (the most common with no card), or -1.
lc_next_word(lang: int): int {
    learn_next(lang, 1);
    if (ln_next_n > 0) ln_next[0] else -1
}

// How many letters are met before words come alongside them.
LC_LETTERS_FIRST: int = 5;

// The stream's next, added (a card, new, due today): a letter while fewer
// than a few are met, else a letter and a word in turn (whichever today
// has had fewer of); its card, or -1 (none left).
lc_stream_add(
    language: *LanguageData,
    lang: int,
    today: int,
    now: int
): int {
    letter: int = lc_next_letter(lang);
    word: int = lc_next_word(lang);
    met: int = letters_carded(lang, CK_LETTER);
    _n: int = lc_added_today(lang, today);
    take_letter: bool = letter >= 0 && (word < 0 || met < LC_LETTERS_FIRST || lc_today_letters <= lc_today_words);
    if (take_letter) return learn_add_letter(language, letter, FROM_STREAM, today,
        now);
    if (word >= 0) return learn_add_word(language, lang, word, FROM_STREAM, today,
        now);
    -1
}

// Today's new topped up to the pace, as a session begins (the language's
// Practice, Today's): how many were added.
tag bible
lc_stream_top_up(language: *LanguageData, lang: int): int {
    today: int = sk_today_now();
    now: int = time(0);
    added: int = 0;
    while (lc_added_today(lang, today) < lc_pace(lang)) {
        if (lc_stream_add(language, lang, today, now) < 0)
            break;
        added = added + 1
    }
    if (added > 0) {
        learn_refresh();
        sk_kept(SK_KEPT_CARDS)
    }
    added
}

// How many new the stream would bring today (none added yet).
tag bible
lc_stream_pending(lang: int): int {
    n: int = lc_pace(lang) - lc_added_today(lang, sk_today_now());
    if (n <= 0 || lc_next_letter(lang) < 0 && lc_next_word(lang) < 0) 0 else n
}

// "5 new Â· 12 to review": language lang's Practice, with what the stream
// brings today.
tag bible
fput_practice_due(lang: int) {
    cd_count_today(lang, sk_today_now());
    new_n: int = cd_new_n + lc_stream_pending(lang);
    if (new_n > 0) {
        fput_int(new_n);
        fput_str(" new");
        if (cd_review_n > 0) fput_str(" \Â\· ")
    }
    if (cd_review_n > 0 || new_n == 0) {
        fput_int(cd_review_n);
        fput_str(" to review")
    }
}

// The next n in line of kind, added now (Practiceâ€¦'s Next in Line): into
// sk_pq; how many.
tag bible
lc_next_add(
    language: *LanguageData,
    lang: int,
    kind: int,
    n: int
): int {
    today: int = sk_today_now();
    now: int = time(0);
    sk_pq_n = 0;
    while (sk_pq_n < n && sk_pq_n < len(sk_pq)) {
        k: int = -1;
        if (kind == CK_WORD) {
            w: int = lc_next_word(lang);
            if (w >= 0) k = learn_add_word(language, lang, w, FROM_STREAM, today,
                now)
        } else if (kind == CK_FORM) {
            for i in 0..len(fc_terms[lang]) {
                g: int = fc_line_cache(language, lang, i);
                if (k < 0 && g >= 0 && fc_card_of(lang, g) < 0) k = fc_add(language,
                    lang, g, today, now)
            }
        } else {
            for i in 0..lt_n
                if (k < 0 && lt_lang[i] == lang && lt_kind[i] == kind && cl_of[i] < 0) k = learn_add_letter(language,
                    i, FROM_STREAM, today, now)
        }
        if (k < 0)
            break;
        // (Each made known to the next one's search: a word's card, a
        // letter's line.)
        learn_refresh();
        sk_pq[sk_pq_n] = k;
        sk_pq_n = sk_pq_n + 1
    }
    if (sk_pq_n > 0) sk_kept(SK_KEPT_CARDS);
    sk_pq_n
}

// How many of kind are still in line (no card yet).
tag bible
lc_in_line(language: *LanguageData, lang: int, kind: int): int {
    n: int = 0;
    if (kind == CK_WORD) {
        for k in 0..vl_n[lang]
            if (card_of_word(lang, vl_num(lang, k)) < 0) n = n + 1
    } else if (kind == CK_FORM) {
        for i in 0..len(fc_terms[lang]) {
            g: int = fc_line_cache(language, lang, i);
            if (g >= 0 && fc_card_of(lang, g) < 0) n = n + 1
        }
    } else {
        for i in 0..lt_n
            if (lt_lang[i] == lang && lt_kind[i] == kind && cl_of[i] < 0) n = n + 1
    }
    n
}

// New Each Day: the pace, chosen (a choice goes back).
tag bible
sk_build_pace(id: int, lang: int) {
    ui_begin(id, SCR_PACE, lang, "New Each Day");
    ui_section("", "New letters and words come into Practice each day, the letters first. Any you add yourself that day count among them. Practice\â\€\¦ brings more whenever you want them.");
    for p in 0..len(lc_paces) {
        ui_row(UI_ITEM, ACT_LC_PACE_SET, lc_paces[p]);
        fbuf_n = 0;
        if (lc_paces[p] == 0) fput_str("None: Only What I Add") else fput_int(lc_paces[p]);
        ui_set_title_fbuf();
        if (lc_paces[p] == lc_pace(lang)) ui_set_acc(ACC_CHECK)
    }
}

// The language page's New Each Day row.
tag bible
lc_pace_row(lang: int) {
    ui_row(UI_ITEM, ACT_LC_PACE, lang);
    ui_set_title("New Each Day");
    fbuf_n = 0;
    p: int = lc_pace(lang);
    if (p == 0) fput_str("None") else fput_int(p);
    ui_set_detail_fbuf();
    ui_set_value_detail();
    ui_set_acc(ACC_MORE)
}

tag bible
sk_pace_act(at: int, action: int, arg: int) {
    lang: int = sk_args[at];
    if (action == ACT_LC_PACE) {
        sk_open(SCR_PACE, arg, true);
        return
    }
    set_pref(if (lang == 0) "learnNewGreek" else "learnNewHebrew", arg);
    sk_save();
    // (Chosen, and back to the language page.)
    sk_n = at;
    ui_effect("pop", -1, -1);
    sk_update_all()
}
