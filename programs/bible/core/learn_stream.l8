tag bible;

use_tag std;

// What is next in line to learn, and the person taking it, one at a time,
// when they choose (nothing is added by itself): Learn Something New on a
// language's page practises the next one, and Learn Another at its end the
// one after, for as long as they like; Practice…'s Next in Line takes
// several at once. The line: the letters (then Hebrew's joined words), and
// once a few letters are met, the most common words alongside them, one
// of each in turn.
import "skin.l8";

import "learn_screens.l8";

// Learn Something New (a language's page; arg the language), and Learn
// Another (a learning session's end).
ACT_LC_NEW: int = 339;

// One word of a list learned now, on its own (arg its word_code).
ACT_LC_LEARN_ONE: int = 341;

// A letter of the Alphabet (arg its line of letters.txt), learned or
// practised now.
ACT_LC_LETTER: int = 342;

// The language a session of the next in line is learning (-1: none), for
// its Learn Another.
tag bible
lc_learning_lang: int = -1;

// Language lang's cards added today (forms aside: Practise Forms has its
// own), and of them its letters (and joined words) and its words: the
// line takes a letter and a word in turn.
lc_today_letters: int = 0;

lc_today_words: int = 0;

lc_added_today(lang: int, today: int): int {
    lc_today_letters = 0;
    lc_today_words = 0;
    for k in 0..cd_n {
        if (cd_lang[k] == lang && sk_local_day(cd_added[k]) == today) {
            if (cd_kind[k] == CK_WORD) lc_today_words = lc_today_words + 1 else if (cd_kind[k] != CK_FORM) lc_today_letters = lc_today_letters + 1
        }
    }
    lc_today_letters + lc_today_words
}

// The next letter in line (letters.txt's line: the letters, then the
// joined words), or -1.
lc_next_letter(lang: int): int {
    for kind in [CK_LETTER, CK_JOINED] {
        for i in 0..lt_n
            if (lt_lang[i] == lang && lt_kind[i] == kind && cl_of[i] < 0) return i
    }
    -1
}

// The next word in line (the most common with no card), or -1.
lc_next_word(lang: int): int {
    learn_next(lang, 1);
    if (ln_next_n > 0) ln_next[0] else -1
}

// How many letters are met before words come alongside them.
LC_LETTERS_FIRST: int = 5;

// The stream's next, added (a card, new, due today): a letter while fewer
// than a few are met, else a letter and a word in turn (whichever today
// has had fewer of); its card, or -1 (none left).
lc_stream_add(
    language: *LanguageData,
    lang: int,
    today: int,
    now: int
): int {
    letter: int = lc_next_letter(lang);
    word: int = lc_next_word(lang);
    met: int = letters_carded(lang, CK_LETTER);
    _n: int = lc_added_today(lang, today);
    take_letter: bool = letter >= 0 && (word < 0 || met < LC_LETTERS_FIRST || lc_today_letters <= lc_today_words);
    if (take_letter) return learn_add_letter(language, letter, FROM_STREAM, today,
        now);
    if (word >= 0) return learn_add_word(language, lang, word, FROM_STREAM, today,
        now);
    -1
}

// The next one in line, added and made known (its card, -1 none left).
tag bible
lc_next_one(language: *LanguageData, lang: int): int {
    k: int = lc_stream_add(language, lang, sk_today_now(), time(0));
    if (k >= 0) {
        learn_refresh();
        sk_kept(SK_KEPT_CARDS)
    }
    k
}

// The next letter (word: false) or the next word in line, added and made
// known (its card, -1 none left).
tag bible
lc_next_of(language: *LanguageData, lang: int, word: bool): int {
    today: int = sk_today_now();
    k: int = -1;
    if (word) {
        w: int = lc_next_word(lang);
        if (w >= 0) k = learn_add_word(language, lang, w, FROM_STREAM, today, time(0))
    } else {
        i: int = lc_next_letter(lang);
        if (i >= 0) k = learn_add_letter(language, i, FROM_STREAM, today, time(0))
    }
    if (k >= 0) {
        learn_refresh();
        sk_kept(SK_KEPT_CARDS)
    }
    k
}

// "Next letter: β, beta · next word: ὁ, the" (a learning session's end),
// into fbuf.
tag bible
fput_next_both(language: *LanguageData, lang: int) {
    letter: int = lc_next_letter(lang);
    word: int = lc_next_word(lang);
    if (letter >= 0) {
        fput_str("Next letter: ");
        if (lang == 1) fput_rli();
        fput_lt(language, letter, LF_GLYPH);
        if (lang == 1) fput_pdi();
        fput_str(", ");
        fput_lt(language, letter, LF_NAME)
    }
    if (word >= 0) {
        fput_str(if (letter >= 0) " \�\� next word: " else "Next word: ");
        if (lang == 1) fput_rli();
        fput_lemma(language, lang, word, 0);
        if (lang == 1) fput_pdi();
        fput_str(", ");
        fput_lemma(language, lang, word, 3)
    }
}

// Learn Something New: a session of the next one in line.
tag bible
lc_learn_new(language: *LanguageData, lang: int) {
    k: int = lc_next_one(language, lang);
    if (k < 0) return;
    sk_pq[0] = k;
    sk_pq_n = 1;
    lc_learning_lang = lang;
    px_start(language, PXS_NEW, 0)
}

// A word of a list (Add Words' preview) learned now: its card made, it
// gone from the list, and practised at once, Learn Another after it.
tag bible
lc_learn_one(language: *LanguageData, code: int) {
    if (code >= -1) return;
    c: int = -code - 1;
    lang: int = c / 1000000;
    num: int = c % 1000000;
    k: int = card_of_word(lang, num);
    if (k < 0) k = learn_add_word(language, lang, num, FROM_PASSAGE, sk_today_now(),
        time(0));
    if (k < 0) return;
    wpv_drop(num);
    learn_refresh();
    sk_kept(SK_KEPT_CARDS);
    sk_pq[0] = k;
    sk_pq_n = 1;
    lc_learning_lang = lang;
    px_start(language, PXS_NEW, 0)
}

// A letter tapped in the Alphabet: its card (made, if it has none),
// practised at once, Learn Another after it.
tag bible
lc_learn_letter(language: *LanguageData, i: int) {
    if (i < 0 || i >= lt_n) return;
    k: int = cl_of[i];
    if (k < 0) {
        k = learn_add_letter(language, i, FROM_ALPHABET, sk_today_now(), time(0));
        if (k < 0) return;
        learn_refresh();
        sk_kept(SK_KEPT_CARDS)
    }
    sk_pq[0] = k;
    sk_pq_n = 1;
    lc_learning_lang = lt_lang[i];
    px_start(language, PXS_NEW, 0)
}

// "Next in line: β, beta", into fbuf (none left: nothing).
tag bible
fput_next_in_line(language: *LanguageData, lang: int) {
    letter: int = lc_next_letter(lang);
    word: int = lc_next_word(lang);
    met: int = letters_carded(lang, CK_LETTER);
    _n: int = lc_added_today(lang, sk_today_now());
    take_letter: bool = letter >= 0 && (word < 0 || met < LC_LETTERS_FIRST || lc_today_letters <= lc_today_words);
    if (!take_letter && word < 0) return;
    fput_str("Next in line: ");
    if (lang == 1) fput_rli();
    if (take_letter) fput_lt(language, letter, LF_GLYPH) else fput_lemma(language,
        lang, word, 0);
    if (lang == 1) fput_pdi();
    fput_str(", ");
    if (take_letter) fput_lt(language, letter, LF_NAME) else fput_lemma(language,
        lang, word, 3)
}

// The language page's Learn Something New row: what is next, named.
tag bible
lc_new_row(language: *LanguageData, lang: int) {
    fbuf_n = 0;
    fput_next_in_line(language, lang);
    if (fbuf_n == 0) return;
    ui_row(UI_ITEM, ACT_LC_NEW, lang);
    ui_set_title("Learn Something New");
    ui_set_detail_fbuf();
    ui_set_acc(ACC_MORE)
}

// The next n in line of kind, added now (Practice…'s Next in Line): into
// sk_pq; how many.
tag bible
lc_next_add(
    language: *LanguageData,
    lang: int,
    kind: int,
    n: int
): int {
    today: int = sk_today_now();
    now: int = time(0);
    sk_pq_n = 0;
    while (sk_pq_n < n && sk_pq_n < len(sk_pq)) {
        k: int = -1;
        if (kind == CK_WORD) {
            w: int = lc_next_word(lang);
            if (w >= 0) k = learn_add_word(language, lang, w, FROM_STREAM, today,
                now)
        } else if (kind == CK_FORM) {
            for i in 0..len(fc_terms[lang]) {
                g: int = fc_line_cache(language, lang, i);
                if (k < 0 && g >= 0 && fc_card_of(lang, g) < 0) k = fc_add(language,
                    lang, g, today, now)
            }
        } else {
            for i in 0..lt_n
                if (k < 0 && lt_lang[i] == lang && lt_kind[i] == kind && cl_of[i] < 0) k = learn_add_letter(language,
                    i, FROM_STREAM, today, now)
        }
        if (k < 0)
            break;
        // (Each made known to the next one's search: a word's card, a
        // letter's line.)
        learn_refresh();
        sk_pq[sk_pq_n] = k;
        sk_pq_n = sk_pq_n + 1
    }
    if (sk_pq_n > 0) sk_kept(SK_KEPT_CARDS);
    sk_pq_n
}

// How many of kind are still in line (no card yet).
tag bible
lc_in_line(language: *LanguageData, lang: int, kind: int): int {
    n: int = 0;
    if (kind == CK_WORD) {
        for k in 0..vl_n[lang]
            if (card_of_word(lang, vl_num(lang, k)) < 0) n = n + 1
    } else if (kind == CK_FORM) {
        for i in 0..len(fc_terms[lang]) {
            g: int = fc_line_cache(language, lang, i);
            if (g >= 0 && fc_card_of(lang, g) < 0) n = n + 1
        }
    } else {
        for i in 0..lt_n
            if (lt_lang[i] == lang && lt_kind[i] == kind && cl_of[i] < 0) n = n + 1
    }
    n
}
