tag bible;

use_tag std;

// A row's menu (SKINS.md, Screens as data: a row's actions): what a long
// press on a row offers on an iPhone, a screen reader's actions on it, and
// what its swipe does (its delete_action, the last of them). The tap stays
// the row's way to open what it names, so a menu never repeats it: it
// offers what a tap can't do (the place or document in the panel, a
// verse's words to copy or share, the row's About, its ⓘ), then taking the
// row away.
//
// Rows with menus: History's places; Go To's recent places, ribbons and
// documents; the verses Search and Go To find.
import "skin.l8";

// Actions that carry a number of their own past their base (the row's
// argument says the rest), each base ACT_ENCODED_SPAN apart:
// - ACT_IN_PANEL plus the tap's action: the row's tap done for the panel,
//   as a Go To aimed at the panel does it (one Go To, the same wherever it
//   opens): a place goes to the panel alone (offered only while the panes
//   are unlinked: linked, the tap itself moves both); a Bible or a
//   commentary is read in the panel;
// - ACT_HIT_COPY_IN and ACT_HIT_SHARE_IN plus a version: a verse found
//   (arg chapter * 1000 + verse) quoted in the version its row shows.
ACT_ENCODED_SPAN: int = 1000000;

ACT_IN_PANEL: int = 1000000;

ACT_HIT_COPY_IN: int = 2000000;

ACT_HIT_SHARE_IN: int = 3000000;

// History's place shared (arg the visit); a recent place taken from
// History (arg chapter * 1000 + verse; Recent is History's latest places).
ACT_VISIT_SHARE: int = 190;

ACT_RECENT_REMOVE: int = 193;

// The menus' words and symbols (SF Symbols' names, SKINS.md: Icons); the
// panel's, its button's own.
ROW_IN_PANEL: str = "Open in Panel";

ROW_READ_IN_PANEL: str = "Read in Panel";

ROW_PANEL_ICON: str = "text.book.closed";

// Whether rows of screen at offer their place or document in the panel:
// the panel shows a reader, and a tap there doesn't already land in it
// (a Go To aimed at the panel, or a screen pushed over one).
sk_rows_offer_panel(at: int): bool {
    bb_reader_at() >= 0 && !sk_aims_panel(at)
}

// While a row's tap is done for the panel (ACT_IN_PANEL): the screen it
// came from counts as aimed at the panel (sk_aims_panel).
sk_picking_for_panel: bool = false;

// Whether a row's tap goes to a place (not a document read).
sk_tap_is_place(tap: int): bool {
    tap == ACT_VISIT || tap == ACT_PLACE || tap == ACT_RIBBON_OPEN || tap == ACT_HIT || tap == ACT_GT_HIT
}

// Whether an action is one of the encoded ones (sk_act_encoded's).
sk_menu_encoded(action: int): bool {
    action >= ACT_IN_PANEL && action < ACT_HIT_SHARE_IN + ACT_ENCODED_SPAN
}

sk_act_encoded(
    id: int,
    at: int,
    action: int,
    arg: int
) {
    if (action >= ACT_HIT_SHARE_IN) sk_menu_quote(action - ACT_HIT_SHARE_IN, arg / 1000,
        arg % 1000, "share") else if (action >= ACT_HIT_COPY_IN) sk_menu_quote(action - ACT_HIT_COPY_IN,
        arg / 1000, arg % 1000, "copy") else sk_act_in_panel(id, at, action - ACT_IN_PANEL,
        arg)
}

// A row's Open in Panel done (action the tap's, arg the row's): as the
// tap is, the screen counted as aimed at the panel. A verse found goes as
// Go To's do (its own tap goes to the page); a place in History or a
// ribbon's goes to the panel's own Bible. (A place while linked: nothing,
// as it is not offered then.)
sk_act_in_panel(
    id: int,
    at: int,
    action: int,
    arg: int
) {
    if (!sk_rows_offer_panel(at) || sk_tap_is_place(action) && sk_beside_linked()) return;
    sk_picking_for_panel = true;
    if (action == ACT_VISIT) {
        if (arg >= 0 && arg < hs_n) sk_goto_from(at, visits[arg].chapter, if (visits[arg].exact) visits[arg].verse else 0)
    } else if (action == ACT_RIBBON_OPEN) {
        i: int = rb_index(arg);
        if (i >= 0) sk_goto_from(at, rb_c[i], rb_v[i])
    } else sk_act(id, if (action == ACT_HIT) ACT_GT_HIT else action, arg, 0);
    sk_picking_for_panel = false
}

// ---- the rows' menus, added to the row just made ----
// Whether the screen being made offers the panel (sk_rows_offer_panel).
sk_building_offers_panel(): bool {
    sk_rows_offer_panel(sk_find(ui_id))
}

// A place's Open in Panel, if the screen offers the panel, the panel
// reads the place's document, and the panes are unlinked (linked, the
// tap moves both: the item would repeat it) (tap: the place's tap).
sk_menu_place_in_panel(panel_reads: bool, tap: int) {
    if (panel_reads && !sk_beside_linked() && sk_building_offers_panel()) ui_row_action_icon(ROW_IN_PANEL,
        ROW_PANEL_ICON, ACT_IN_PANEL + tap)
}

// History's visit i: Open in Panel (a place in the Bible: the panel reads
// a Bible), Share, Delete (its swipe).
sk_menu_visit(i: int) {
    sk_menu_place_in_panel(place_document_is_bible(visits[i].document), ACT_VISIT);
    ui_row_action_icon("Share", "square.and.arrow.up", ACT_VISIT_SHARE);
    ui_row_action_icon("Delete", "trash", ACT_VISIT_DELETE);
    ui_set_delete(ACT_VISIT_DELETE)
}

// Go To's recent place: Open in Panel, Remove (its swipe: from History,
// which Recent shows the latest of).
sk_menu_recent() {
    sk_menu_place_in_panel(true, ACT_PLACE);
    ui_row_action_icon("Remove", "minus.circle", ACT_RECENT_REMOVE);
    ui_set_delete(ACT_RECENT_REMOVE)
}

// A ribbon (i): Open in Panel (a ribbon in the Bible), Ribbon Details (its
// ⓘ), Delete (its swipe).
sk_menu_ribbon(i: int) {
    sk_menu_place_in_panel(place_document_is_bible(rb_document[i]), ACT_RIBBON_OPEN);
    ui_row_action_icon("Ribbon Details", "info.circle", ACT_RIBBON_DETAILS);
    ui_row_action_icon("Delete", "trash", ACT_GT_RIBBON_DELETE);
    ui_set_delete(ACT_GT_RIBBON_DELETE)
}

// A document's row (its tap, tap; its ⓘ, info): Read in Panel, if the
// panel reads its kind (a Bible or a commentary) and isn't reading it now
// (linked or not: it differs from the tap either way), and About.
sk_menu_document(
    panel_reads: bool,
    panel_has_it: bool,
    tap: int,
    info: int
) {
    if (panel_reads && !panel_has_it && sk_building_offers_panel()) ui_row_action_icon(ROW_READ_IN_PANEL,
        ROW_PANEL_ICON, ACT_IN_PANEL + tap);
    ui_row_action_icon("About", "info.circle", info)
}

// A verse found in version t (its tap, tap): Open in Panel, Copy, Share
// (the words its row shows: version t's).
sk_menu_hit(tap: int, t: int) {
    sk_menu_place_in_panel(true, tap);
    ui_row_action_icon("Copy", "doc.on.doc", ACT_HIT_COPY_IN + t);
    ui_row_action_icon("Share", "square.and.arrow.up", ACT_HIT_SHARE_IN + t)
}

// ---- what the menus' own actions do ----
// Whether action is one of the menus' own (sk_menu_act's).
sk_menu_action(action: int): bool {
    action == ACT_VISIT_SHARE || action == ACT_RECENT_REMOVE
}

sk_menu_verse: []int = new int[1](0);

sk_menu_act(action: int, arg: int) {
    if (action == ACT_VISIT_SHARE) {
        if (arg < 0 || arg >= hs_n) return;
        c: int = visits[arg].chapter;
        v: int = if (visits[arg].exact) visits[arg].verse else 0;
        // (A verse of the Bible quoted in the version read; a chapter, its
        // reference; a place in another document, its reference and the
        // document's short name.)
        document: PlaceDocument = visits[arg].document;
        bible: bool = place_document_is_bible(document);
        if (bible && v > 0) {
            sk_menu_quote(quote_base(), c, v, "share");
            return
        }
        if (!bible) {
            fbuf_n = 0;
            fput_place_ref(document, c, v, v);
            match document {
                Module m -> {
                    fput(32);
                    fput_shelf_abbreviation(shelf_find_slot(m.slot))
                }
                Away a -> {
                    // (Named by its title already, read in its own
                    // divisions.)
                    if (!place_document_by_divisions(document)) {
                        fput(32);
                        fput_place_away_abbreviation(a.module)
                    }
                }
                Bible -> { }
            }
            ui_effect_fbuf("share");
            return
        }
        fbuf_n = 0;
        fput_ref(c, 0, 0);
        ui_effect_fbuf("share");
        return
    }
    if (action == ACT_RECENT_REMOVE) {
        sk_recent_remove(arg / 1000);
        kept: fn(what: int) = sk_host.save_kept;
        kept(SK_KEPT_HISTORY);
        sk_update_all()
    }
}

// Verse v of chapter c in version t, quoted with its reference and t's
// short name (as the tray's Copy and Share are), as effect (copy or share);
// nothing if t can't be read now (never another version's words instead).
sk_menu_quote(
    t: int,
    c: int,
    v: int,
    effect: str
) {
    if (c < 0 || c >= chapters || v <= 0) return;
    sk_menu_verse[0] = v;
    fbuf_n = 0;
    if (put_quote_in(t, c, sk_menu_verse, 1)) ui_effect_fbuf(effect)
}

// Chapter c taken from Recent: every visit to it taken from History
// (Recent is History's latest chapters, so a visit left would bring it
// back), and its row from the list Go To shows (kept while it is shown).
sk_recent_remove(c: int) {
    i: int = hs_n - 1;
    while (i >= 0) {
        // (Recent's chapters are the Bible's: a place a document numbers by
        // its own divisions is not one.)
        if (visits[i].chapter == c && !place_document_by_divisions(visits[i].document)) history_delete(i);
        i = i - 1
    }
    n: int = 0;
    for j in 0..sk_recent_n {
        if (sk_recent_c[j] != c) {
            sk_recent_c[n] = sk_recent_c[j];
            sk_recent_v[n] = sk_recent_v[j];
            n = n + 1
        }
    }
    sk_recent_n = n;
    if (n == 0) sk_recent_more = false
}
