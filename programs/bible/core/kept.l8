tag bible;

use_tag std;

// What is kept (SKINS.md), apart from any platform: the files core keeps
// (by the names the iPhone's files have), what goes in each, and when; a
// host keeps them where its platform keeps things (its files, a browser's
// storage), reading, writing, adding to and deleting one by name (kp_name,
// its first kp_name_n bytes) to or from fbuf. The iPhone keeps its own
// files its own way; any other host gives core its store and lets core
// save and load.
import "skin.l8";

type KeptStore = {
    // The file named read into fbuf (fbuf_n 0: none); fbuf written as it,
    // or added to its end; it deleted.
    read: fn();
    write: fn();
    append: fn();
    remove: fn()
}

kp_none() { }

// Memory's ESV passages' verses (core/esv_cache.l8's pins), kept by core
// for a skin whose host is core's (the iPhone keeps them its own way).
SK_KEPT_PINS: int = 11;

kept_store: KeptStore = KeptStore {
    read: &kp_none,
    write: &kp_none,
    append: &kp_none,
    remove: &kp_none
};

kp_name: []i8 = new i8[64](0i8);

kp_name_n: int = 0;

kp_set(name: str) {
    kp_name_n = 0;
    for c in name {
        if (kp_name_n < len(kp_name)) {
            kp_name[kp_name_n] = c;
            kp_name_n = kp_name_n + 1
        }
    }
}

// "plan-N.tsv": a plan followed's file (its number N), fbuf left as it is.
kp_set_plan(n: int) {
    kp_set("plan-");
    d: int = 1;
    while (d * 10 <= n) d = d * 10;
    while (d > 0) {
        kp_name[kp_name_n] = (48 + n / d % 10) trunc i8;
        kp_name_n = kp_name_n + 1;
        d = d / 10
    }
    for c in ".tsv" {
        kp_name[kp_name_n] = c;
        kp_name_n = kp_name_n + 1
    }
}

kp_read() {
    f: fn() = kept_store.read;
    fbuf_n = 0;
    f()
}

kp_write() {
    f: fn() = kept_store.write;
    f()
}

// ---- the settings (settings.txt: prefs_format's lines) ----
kept_save_prefs() {
    prefs_format();
    kp_set("settings.txt");
    kp_write()
}

kept_load_prefs() {
    kp_set("settings.txt");
    kp_read();
    if (fbuf_n == 0) kept_import_legacy() else prefs_parse()
}

// ---- what an older build kept its own way (legacy.txt) ----
// A platform whose older builds kept settings in a store of its own writes
// them once, while no settings.txt is kept, as lines: `NAME VALUE` for a
// setting (the chapter as its number plus one; lastHighlight a color's
// name), `voice NAME` (the voice chosen), `search WORDS` (a recent search,
// newest first) and `planReminder 0|1` (1.0's plan's reminder). Core makes
// them its own files, its plans' list too, and deletes it.
kept_import_legacy() {
    kp_set("legacy.txt");
    kp_read();
    if (fbuf_n == 0) return;
    remind: bool = false;
    begin_lines();
    while (next_line()) {
        sp: int = fpos;
        while (sp < line_e && fbuf[sp] as int != 32) sp = sp + 1;
        k: int = prefs_known_at(fpos, sp);
        if (k >= 0 && prefs_known[k] == "lastHighlight") {
            for i in 0..len(hl_names)
                if (kp_legacy_value_is(sp + 1, hl_names[i])) set_pref("lastHighlight",
                    i)
        } else if (k >= 0) {
            v: int = kp_legacy_number(sp + 1);
            if (kp_legacy_ok) set_pref(prefs_known[k], if (prefs_known[k] == "chapter") v - 1 else v)
        } else if (kp_legacy_name_is(sp, "planReminder")) remind = kp_legacy_number(sp + 1) == 1 && kp_legacy_ok
    }
    kept_save_prefs();
    kp_legacy_values("voice");
    if (fbuf_n > 0) {
        kp_set("voice.txt");
        kp_write()
    }
    kp_legacy_values("search");
    if (fbuf_n > 0) {
        kp_set("searches.txt");
        kp_write()
    }
    kept_import_plans(remind);
    kp_set("legacy.txt");
    gone: fn() = kept_store.remove;
    gone()
}

// Whether the line's name (fpos to e) is name.
kp_legacy_name_is(e: int, name: str): bool {
    if (e - fpos != len(name)) return false;
    for i in 0..len(name)
        if (fbuf[fpos + i] != name[i]) return false;
    true
}

// Whether the line's value (from p) is s.
kp_legacy_value_is(p: int, s: str): bool {
    if (line_e - p != len(s)) return false;
    for i in 0..len(s)
        if (fbuf[p + i] != s[i]) return false;
    true
}

// The line's value (from p) as a whole number; kp_legacy_ok if it is one.
kp_legacy_ok: bool = false;

kp_legacy_number(p: int): int {
    neg: bool = p < line_e && fbuf[p] as int == 45;
    q: int = if (neg) p + 1 else p;
    kp_legacy_ok = q < line_e;
    n: int = 0;
    for x in q..line_e {
        d: int = fbuf[x] as int;
        if (d < 48 || d > 57) kp_legacy_ok = false else n = n * 10 + d - 48
    }
    if (neg) -n else n
}

// legacy.txt read again, and the values of its lines named name kept in
// fbuf, a line each (each no longer than its line, so written over it).
kp_legacy_values(name: str) {
    kp_set("legacy.txt");
    kp_read();
    w: int = 0;
    begin_lines();
    while (next_line()) {
        sp: int = fpos;
        while (sp < line_e && fbuf[sp] as int != 32) sp = sp + 1;
        if (kp_legacy_name_is(sp, name) && sp + 1 < line_e) {
            for x in sp + 1..line_e {
                fbuf[w] = fbuf[x];
                w = w + 1
            }
            fbuf[w] = 10i8;
            w = w + 1
        }
    }
    fbuf_n = w
}

// The plans followed, as plans.txt lists them, when it isn't kept yet:
// 1.0's plan.tsv first made plan-1.tsv (with its reminder), then each
// plan-N.tsv there (an older build found them by name).
KP_PLANS_PROBED: int = 64;

kept_import_plans(remind: bool) {
    kp_set("plans.txt");
    kp_read();
    if (fbuf_n > 0) return;
    kp_set("plan.tsv");
    kp_read();
    if (fbuf_n > 0) {
        plan_migrate(remind);
        kp_set_plan(1);
        kp_write();
        kp_set("plan.tsv");
        gone: fn() = kept_store.remove;
        gone();
        if (pref_get("planNext") < 2) {
            set_pref("planNext", 2);
            kept_save_prefs()
        }
    }
    // (As many as kept_load_plans reads.)
    n: int = 0;
    for p in 1..KP_PLANS_PROBED + 1 {
        kp_set_plan(p);
        kp_read();
        if (fbuf_n > 0 && n < len(kp_nums)) {
            kp_nums[n] = p;
            n = n + 1
        }
    }
    if (n == 0) return;
    fbuf_n = 0;
    for j in 0..n {
        fput_int(kp_nums[j]);
        fput(10)
    }
    kp_set("plans.txt");
    kp_write()
}

// ---- saving ----
// A change core made (SK_KEPT_), written: each its file; the plans each
// followed its own (plan-N.tsv) and plans.txt their numbers; a plan
// stopped added to plans-done.tsv (its lines in fbuf), its file deleted.
kept_save(what: int) {
    kept_write(what);
    // (What the reminders say changed: scheduled again, by core's host.)
    if (hs_on && hs_begun && (what == SK_KEPT_PLANS || what == SK_KEPT_MEMORY || what == SK_KEPT_CARDS)) hs_notify_schedule()
}

kept_write(what: int) {
    if (what == SK_KEPT_HIGHLIGHTS) {
        format_highlights();
        kp_set("highlights.tsv");
        kp_write()
    } else if (what == SK_KEPT_BOOKMARKS) {
        format_bookmarks();
        kp_set("bookmarks.tsv");
        kp_write()
    } else if (what == SK_KEPT_NOTES) {
        format_notes();
        kp_set("notes.tsv");
        kp_write()
    } else if (what == SK_KEPT_HISTORY) {
        format_history();
        kp_set("history.tsv");
        kp_write()
    } else if (what == SK_KEPT_RIBBONS) {
        format_ribbons();
        kp_set("ribbons.tsv");
        kp_write()
    } else if (what == SK_KEPT_MEMORY) {
        format_memory();
        kp_set("memory.tsv");
        kp_write();
        // (What memory.l8 logs, not kept.)
        mev_n = 0;
        mlog_n = 0
    } else if (what == SK_KEPT_CARDS) {
        // (The cards are read only once the language data is here, so
        // none can have changed before it: nothing written, rather than no
        // cards over those kept.)
        if (!language_ready()) return;
        borrow language_data {
            format_cards(language_data)
        }
        kp_set("cards.tsv");
        kp_write();
        mev_n = 0;
        cdl_n = 0
    } else if (what == SK_KEPT_PLANS) {
        for i in 0..fw_n {
            format_plan(i);
            kp_set_plan(fw_num[i]);
            kp_write()
        }
        fbuf_n = 0;
        for i in 0..fw_n {
            fput_int(fw_num[i]);
            fput(10)
        }
        kp_set("plans.txt");
        kp_write()
    } else if (what == SK_KEPT_SEARCHES) {
        fbuf_n = 0;
        for i in 0..sk_searches_n {
            fput_bytes(sk_searches, i * 256, i * 256 + sk_search_len[i]);
            fput(10)
        }
        kp_set("searches.txt");
        kp_write()
    } else if (what == SK_KEPT_PINS) {
        format_pins();
        kp_set("esv-pins.txt");
        kp_write()
    } else if (what == SK_KEPT_PLAN_DONE) {
        kp_set("plans-done.tsv");
        add: fn() = kept_store.append;
        add();
        kp_set_plan(dd_done_num);
        gone: fn() = kept_store.remove;
        gone()
    }
}

// ---- loading ----
// Everything kept, read (a bad line skipped): the plans followed once the
// plans are made (their days: plan_file_read's first); the cards once Learn
// has its data (kept_load_cards, then).
kept_load() {
    kp_set("highlights.tsv");
    kp_read();
    parse_highlights();
    kp_set("bookmarks.tsv");
    kp_read();
    parse_bookmarks();
    kp_set("notes.tsv");
    kp_read();
    parse_notes();
    kp_set("history.tsv");
    kp_read();
    parse_history();
    kp_set("ribbons.tsv");
    kp_read();
    if (fbuf_n == 0) kept_migrate_readings() else parse_ribbons();
    kp_set("memory.tsv");
    kp_read();
    parse_memory();
    mev_n = 0;
    mlog_n = 0;
    // (Memory's ESV passages' verses, once their passages are read.)
    kp_set("esv-pins.txt");
    kp_read();
    mp_load();
    kp_set("searches.txt");
    kp_read();
    kp_searches();
    kept_load_cards();
    kept_load_plans()
}

// Round 6's readings (readings.tsv, an iPhone's), made ribbons once when
// there are no ribbons yet; the file kept as readings-r6.tsv.
kept_migrate_readings() {
    kp_set("readings.tsv");
    kp_read();
    if (fbuf_n == 0) return;
    kp_set("readings-r6.tsv");
    kp_write();
    _made: int = migrate_readings(time(0));
    format_ribbons();
    kp_set("ribbons.tsv");
    kp_write();
    kp_set("readings.tsv");
    gone: fn() = kept_store.remove;
    gone()
}

kp_line: []i8 = new i8[256](0i8);

kp_searches() {
    sk_searches_n = 0;
    begin_lines();
    while (next_line()) {
        n: int = 0;
        for q in fpos..line_e {
            if (n < len(kp_line)) {
                kp_line[n] = fbuf[q];
                n = n + 1
            }
        }
        if (n > 0) sk_searches_add(kp_line, n)
    }
}

// Memory's ESV pins changed: kept (by core's host; else the platform's).
sk_pins_changed() {
    if (hs_on) kept_save(SK_KEPT_PINS) else ui_effect("pins_changed", -1, -1)
}

// Passage i's ESV verses asked for, or taken from the chapters held.
sk_mm_fetch(i: int) {
    if (!hs_on) {
        ui_effect("mm_fetch", i, -1);
        return
    }
    mp_fetch(i, time(0), ew_now());
    if (mp_from_cache) kept_save(SK_KEPT_PINS)
}

kept_load_cards() {
    if (!language_ready()) return;
    kp_set("cards.tsv");
    kp_read();
    if (fbuf_n > 0) {
        borrow language_data {
            parse_cards(language_data, sk_today_now())
        }
    }
    mev_n = 0;
    cdl_n = 0
}

kp_nums: []int = new int[16](0);

kept_load_plans() {
    plans_make();
    kp_set("plans.txt");
    kp_read();
    n: int = 0;
    begin_lines();
    while (next_line()) {
        x: int = 0;
        for q in fpos..line_e {
            d: int = fbuf[q] as int;
            if (d >= 48 && d <= 57) x = x * 10 + d - 48
        }
        if (x > 0 && n < len(kp_nums)) {
            kp_nums[n] = x;
            n = n + 1
        }
    }
    for j in 0..n {
        kp_set_plan(kp_nums[j]);
        kp_read();
        if (fbuf_n > 0) _i: int = parse_plan(kp_nums[j])
    }
}

// ---- a file to save (savefile NAME CONTENT: the skin offers it as its
// platform saves or shares a file) ----
kp_export_name: []i8 = new i8[128](0i8);

// The notes and highlights, exported.
sk_export() {
    if (!anything_kept()) return;
    today: int = sk_today_now();
    export_name(today);
    n: int = if (fbuf_n < len(kp_export_name)) fbuf_n else len(kp_export_name);
    for i in 0..n kp_export_name[i] = fbuf[i];
    _q: int = sk_num_of(SK_NUM_QUOTABLE, 0);
    export_notes(today);
    ui_str("savefile\t");
    ui_field_bytes(kp_export_name, 0, n);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, fbuf_n);
    ui_byte(10)
}

// ---- the ESV's chapters held (core/esv_cache.l8's, by its rules: at most
// 500 verses, 30 days), for a skin whose host is core's, as the iPhone
// keeps them: esv-index.tsv (format_esv_index's lines) and a file each
// chapter (esv-JHN-3.txt, its records) ----
kp_set_esv(c: int) {
    kp_set("esv-");
    for x in 0..3 {
        kp_name[kp_name_n] = book_code_byte(ch_book[c], x) trunc i8;
        kp_name_n = kp_name_n + 1
    }
    kp_name[kp_name_n] = 45i8;
    kp_name_n = kp_name_n + 1;
    n: int = ch_num[c];
    d: int = 1;
    while (d * 10 <= n) d = d * 10;
    while (d > 0) {
        kp_name[kp_name_n] = (48 + n / d % 10) trunc i8;
        kp_name_n = kp_name_n + 1;
        d = d / 10
    }
    for k in ".txt" {
        kp_name[kp_name_n] = k;
        kp_name_n = kp_name_n + 1
    }
}

// Chapter c come: its file written (if it is kept), and the index (those
// let go deleted).
kept_esv_came(c: int) {
    i: int = esv_find(c);
    if (i >= 0 && ec_disk[i]) {
        fbuf_n = 0;
        for x in 0..ec_len[i] fput(ec_pool[ec_at[i] + x] as int);
        kp_set_esv(c);
        kp_write()
    }
    for g in 0..ec_gone_n {
        if (esv_find(ec_gone[g]) < 0) {
            kp_set_esv(ec_gone[g]);
            f: fn() = kept_store.remove;
            f()
        }
    }
    ec_gone_n = 0;
    format_esv_index();
    kp_set("esv-index.tsv");
    kp_write()
}

kp_esv_buf: []i8 = new i8[262144](0i8);

// What was kept held again (a chapter whose file is gone left out).
kept_esv_load() {
    kp_set("esv-index.tsv");
    kp_read();
    parse_esv_index();
    for i in 0..ix_n {
        c: int = ix_c[i];
        kp_set_esv(c);
        kp_read();
        n: int = if (fbuf_n > len(kp_esv_buf)) len(kp_esv_buf) else fbuf_n;
        for x in 0..n kp_esv_buf[x] = fbuf[x];
        if (n > 0) esv_restore(c, kp_esv_buf, n, ix_fetched[i], ix_used[i])
    }
    if (ec_n > 0) esv_build()
}
