tag bible;

use_tag std;

// Grammar notes (data/lang/notes.txt, written for this app): short notes
// on Greek and Hebrew grammar, each opened from a term of a word's
// Grammar, from a practice card's About This Form, or from a language's
// Grammar Notes. The file:
//
//   # a comment
//   = ID<TAB>Title<TAB>greek|hebrew    a note begins
//   a paragraph                       (**bold**, _italic_; Greek and
//                                     Hebrew written as they are)
//   | head | head | head |            a table, its first line the header
//   | cell | cell | cell |
//   @forms NUMBER<TAB>words           a row: every form of word NUMBER
//   @see ID<TAB>words                 a row: another note
//   ~ TERM<TAB>ID                     (after the notes) grammar.txt's term
//                                     TERM explained further by note ID
//
// A note's place in the file (its index among the notes) is its screen's
// argument; the file is read again as each screen is made (a few dozen
// kilobytes, one pass), so no index outlives the language data.
import "skin.l8";

import "lang.l8";

SCR_GRAMMAR_NOTES: int = 50;

SCR_GRAMMAR_NOTE: int = 51;

// A note opened (arg its index); every form of a word (arg its number,
// 100000 more if Greek, as Forms takes it).
ACT_GN_OPEN: int = 320;

ACT_GN_FORMS: int = 321;

// A language's Grammar Notes (arg 0 Greek, 1 Hebrew).
ACT_GN_LIST: int = 322;

GN_MOST: int = 256;

// The notes, as the last scan found them: each one's header line and its
// body's lines (from after the header to the next note), and its language
// (0 Greek, 1 Hebrew).
gn_n: int = 0;

gn_head_b: []int = new int[256](0);

gn_head_e: []int = new int[256](0);

gn_body_b: []int = new int[256](0);

gn_body_e: []int = new int[256](0);

gn_lang: []int = new int[256](0);

// Where the term map begins (the first `~` line; the file's end if none).
gn_map_b: int = 0;

gn_scan(language: *LanguageData) {
    gn_n = 0;
    n: int = language.notes_size;
    b: []i8 = language.notes;
    gn_map_b = n;
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && b[e] as int != 10) e = e + 1;
        k: int = if (e > p) b[p] as int else 0;
        if (k == 61 && gn_n < GN_MOST) {
            if (gn_n > 0) gn_body_e[gn_n - 1] = p;
            gn_head_b[gn_n] = p;
            gn_head_e[gn_n] = e;
            gn_body_b[gn_n] = (if (e < n) e + 1 else e);
            gn_body_e[gn_n] = n;
            gn_lang[gn_n] = (if (gn_field_is(language, p, e, 2, "hebrew")) 1 else 0);
            gn_n = gn_n + 1
        } else if (k == 126 && gn_map_b == n) {
            gn_map_b = p;
            if (gn_n > 0) gn_body_e[gn_n - 1] = p
        }
        p = e + 1
    }
}

// Field f (from 0, split by tabs) of the line from b to e: gf_b, gf_e
// (the header's first field without its "= ").
gf_b: int = 0;

gf_e: int = 0;

gn_field(
    language: *LanguageData,
    b: int,
    e: int,
    f: int
): bool {
    s: []i8 = language.notes;
    p: int = b;
    if (p + 1 < e && (s[p] as int == 61 || s[p] as int == 126 || s[p] as int == 64)) {
        // ("= ", "~ ", "@forms ", "@see ": the first field after them.)
        while (p < e && s[p] as int != 32) p = p + 1;
        if (p < e) p = p + 1
    }
    for _x in 0..f {
        while (p < e && s[p] as int != 9) p = p + 1;
        if (p >= e) return false;
        p = p + 1
    }
    q: int = p;
    while (q < e && s[q] as int != 9) q = q + 1;
    gf_b = p;
    gf_e = q;
    true
}

gn_field_is(
    language: *LanguageData,
    b: int,
    e: int,
    f: int,
    word: str
): bool {
    if (!gn_field(language, b, e, f) || gf_e - gf_b != len(word)) return false;
    for i in 0..len(word)
        if (language.notes[gf_b + i] != word[i] as i8) return false;
    true
}

// The note whose id is bytes a to b of src (of the scan), or -1.
gn_by_id(
    language: *LanguageData,
    src: []i8,
    a: int,
    b: int
): int {
    for x in 0..gn_n {
        if (gn_field(language, gn_head_b[x], gn_head_e[x], 0) && gf_e - gf_b == b - a) {
            same: bool = true;
            for i in 0..b - a
                if (language.notes[gf_b + i] != src[a + i]) same = false;
            if (same) return x
        }
    }
    -1
}

// A row to the language's Grammar Notes, at a screen's end (a word's
// Grammar), if it has any.
tag bible
gn_list_row(language: *LanguageData, lang: int) {
    if (!gn_any(language, lang)) return;
    ui_section("", "");
    ui_row(UI_ITEM, ACT_GN_LIST, lang);
    ui_set_title("Grammar Notes");
    ui_set_icon("text.book.closed");
    ui_set_acc(ACC_MORE)
}

// The note explaining grammar.txt's term named by bytes a to b of
// language.grammar, in language lang (0 Greek, 1 Hebrew), or -1; a term
// with a note only in the other language, that one.
tag bible
gn_for_term(
    language: *LanguageData,
    a: int,
    b: int,
    lang: int
): int {
    if (language.notes_size == 0) return -1;
    gn_scan(language);
    n: int = language.notes_size;
    other: int = -1;
    p: int = gn_map_b;
    while (p < n) {
        e: int = p;
        while (e < n && language.notes[e] as int != 10) e = e + 1;
        if (e > p && language.notes[p] as int == 126 && gn_field(language, p, e, 0) && gf_e - gf_b == b - a) {
            same: bool = true;
            for i in 0..b - a
                if (lower(language.notes[gf_b + i] as int) != lower(language.grammar[a + i] as int)) same = false;
            if (same && gn_field(language, p, e, 1)) {
                x: int = gn_by_id(language, language.notes, gf_b, gf_e);
                if (x >= 0 && gn_lang[x] == lang) return x;
                if (x >= 0 && other < 0) other = x
            }
        }
        p = e + 1
    }
    other
}

// Whether the language has notes (its file came, with any).
tag bible
gn_any(language: *LanguageData, lang: int): bool {
    if (language.notes_size == 0) return false;
    gn_scan(language);
    for x in 0..gn_n
        if (gn_lang[x] == lang) return true;
    false
}

// ---- the screens ----
// Grammar Notes: the language's notes, in the file's order.
tag bible
sk_build_grammar_notes(language: *LanguageData, id: int, lang: int) {
    ui_begin(id, SCR_GRAMMAR_NOTES, lang, "Grammar Notes");
    gn_scan(language);
    ui_section("", "");
    for x in 0..gn_n {
        if (gn_lang[x] == lang && gn_field(language, gn_head_b[x], gn_head_e[x], 1)) {
            ui_row(UI_ITEM, ACT_GN_OPEN, x);
            fbuf_n = 0;
            fput_bytes(language.notes, gf_b, gf_e);
            ui_set_title_fbuf();
            ui_set_acc(ACC_MORE)
        }
    }
    if (ui_rows_n == 0) ui_set_empty("text.book.closed", "No Notes Yet", "")
}

// A note: its paragraphs as a page's, its tables, its rows to the forms of
// a word and to other notes.
tag bible
sk_build_grammar_note(language: *LanguageData, id: int, x: int) {
    ui_begin(id, SCR_GRAMMAR_NOTE, x, "");
    gn_scan(language);
    if (x < 0 || x >= gn_n) {
        ui_set_empty("text.book.closed", "No Note", "");
        return
    }
    if (gn_field(language, gn_head_b[x], gn_head_e[x], 1)) {
        fbuf_n = 0;
        fput_bytes(language.notes, gf_b, gf_e);
        ui_set_screen_title_fbuf()
    }
    ui_page = true;
    s: []i8 = language.notes;
    // (What the section open now holds: paragraphs, a table, rows.)
    open: int = 0;
    p: int = gn_body_b[x];
    end: int = gn_body_e[x];
    while (p < end) {
        e: int = p;
        while (e < end && s[e] as int != 10) e = e + 1;
        k: int = if (e > p) s[p] as int else 0;
        if (k == 124) {
            // (A table: a section of its own, its header's cells its
            // columns' names after the first.)
            head: bool = open != 2;
            if (head) {
                ui_section("", "");
                gn_cells(language, p, e);
                fbuf_n = 0;
                for c in 1..gc_n {
                    if (c > 1) fput(124);
                    fput_bytes(s, gc_b[c], gc_e[c])
                }
                ui_set_columns_fbuf();
                if (gc_n > 0) {
                    fbuf_n = 0;
                    fput_bytes(s, gc_b[0], gc_e[0]);
                    ui_set_header_fbuf()
                }
                open = 2
            } else gn_table_row(language, p, e)
        } else if (k == 64) {
            if (open != 3) {
                ui_section("", "");
                open = 3
            }
            gn_link_row(language, p, e)
        } else if (k != 0 && k != 35) {
            if (open != 1) {
                ui_section("", "");
                open = 1
            }
            gn_paragraph(language, p, e)
        }
        p = e + 1
    }
}

// A table line's cells (between its bars, trimmed): gc_b, gc_e.
gc_b: []int = new int[12](0);

gc_e: []int = new int[12](0);

gc_n: int = 0;

gn_cells(language: *LanguageData, b: int, e: int) {
    s: []i8 = language.notes;
    gc_n = 0;
    p: int = b + 1;
    while (p < e && gc_n < len(gc_b)) {
        q: int = p;
        while (q < e && s[q] as int != 124) q = q + 1;
        a: int = p;
        z: int = q;
        while (a < z && s[a] as int == 32) a = a + 1;
        while (z > a && s[z - 1] as int == 32) z = z - 1;
        if (q < e) {
            gc_b[gc_n] = a;
            gc_e[gc_n] = z;
            gc_n = gc_n + 1
        }
        p = q + 1
    }
}

// A table's row: its first cell its title, the rest its cells, each in
// its script.
gn_table_row(language: *LanguageData, b: int, e: int) {
    s: []i8 = language.notes;
    gn_cells(language, b, e);
    if (gc_n == 0) return;
    ui_row(UI_ITEM, 0, 0);
    fbuf_n = 0;
    fput_bytes(s, gc_b[0], gc_e[0]);
    ui_set_title_fbuf();
    for c in 1..gc_n {
        fbuf_n = 0;
        fput_bytes(s, gc_b[c], gc_e[c]);
        ui_cell_fbuf(gn_script_of(s, gc_b[c], gc_e[c]), 0, -1);
        fbuf_n = 0;
        fput_bytes(s, gc_b[0], gc_e[0]);
        fput_str(", ");
        fput_bytes(s, gc_b[c], gc_e[c]);
        ui_set_cell_label_fbuf()
    }
}

// "@forms G3056<TAB>Every form of λόγος", "@see greek-cases<TAB>The cases".
gn_link_row(language: *LanguageData, b: int, e: int) {
    s: []i8 = language.notes;
    forms: bool = b + 6 < e && s[b + 1] as int == 102;
    if (!gn_field(language, b, e, 0)) return;
    kb: int = gf_b;
    ke: int = gf_e;
    if (!gn_field(language, b, e, 1)) return;
    wb: int = gf_b;
    we: int = gf_e;
    if (forms) {
        // (G3588, H1697, perhaps a letter after: its digits.)
        if (ke - kb < 2) return;
        greek: bool = s[kb] as int == 71;
        num: int = 0;
        for i in kb + 1..ke {
            d: int = s[i] as int - 48;
            if (d >= 0 && d <= 9) num = num * 10 + d
        }
        if (num <= 0) return;
        ui_row(UI_ITEM, ACT_GN_FORMS, num + (if (greek) 100000 else 0))
    } else {
        y: int = gn_by_id(language, s, kb, ke);
        if (y < 0) return;
        ui_row(UI_ITEM, ACT_GN_OPEN, y)
    }
    fbuf_n = 0;
    fput_bytes(s, wb, we);
    ui_set_title_fbuf();
    ui_set_acc(ACC_MORE)
}

// A paragraph: its words in runs, **bold** strong, _italic_ italic, Greek
// and Hebrew in their scripts (Hebrew isolated right to left).
gn_paragraph(language: *LanguageData, b: int, e: int) {
    s: []i8 = language.notes;
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    bold: bool = false;
    italic: bool = false;
    run: int = RUN_PLAIN;
    p: int = b;
    gn_run_from = fbuf_n;
    while (p < e) {
        k: int = s[p] as int & 255;
        if (k == 42 && p + 1 < e && s[p + 1] as int == 42) {
            gn_run_end(run);
            bold = !bold;
            run = gn_style(bold, italic);
            p = p + 2
        } else if (k == 95) {
            gn_run_end(run);
            italic = !italic;
            run = gn_style(bold, italic);
            p = p + 1
        } else {
            n: int = gn_utf8_len(k);
            cp: int = gn_utf8_at(s, p, e);
            script: int = gn_script(cp);
            // (A space between two words of one script stays in its run.)
            want: int = if (script != 0) script else if (k == 32 && (run == RUN_GREEK || run == RUN_HEBREW) && gn_next_script(s,
                p + 1, e) == run) run else gn_style(bold, italic);
            if (want != run) {
                gn_run_end(run);
                run = want
            }
            if (run == RUN_HEBREW && fbuf_n == gn_run_from) fput_rli();
            fput_bytes(s, p, p + n);
            p = p + n
        }
    }
    gn_run_end(run);
    ui_rich_title()
}

// Where the run being made began in fbuf.
gn_run_from: int = 0;

gn_run_end(run: int) {
    if (fbuf_n > gn_run_from) {
        if (run == RUN_HEBREW) fput_pdi();
        ui_rich(run)
    }
    gn_run_from = fbuf_n
}

gn_style(bold: bool, italic: bool): int {
    if (bold) RUN_STRONG else if (italic) RUN_ITALIC else RUN_PLAIN
}

// A code point's script: RUN_GREEK, RUN_HEBREW, or 0.
gn_script(cp: int): int {
    if (cp >= 880 && cp <= 1023 || cp >= 7936 && cp <= 8191) RUN_GREEK else if (cp >= 1424 && cp <= 1535 || cp >= 64285 && cp <= 64335) RUN_HEBREW else 0
}

// The script of the next letter at or after p (spaces passed over).
gn_next_script(s: []i8, p: int, e: int): int {
    q: int = p;
    while (q < e && s[q] as int == 32) q = q + 1;
    if (q >= e) 0 else gn_script(gn_utf8_at(s, q, e))
}

// A cell's script: its first letter's.
gn_script_of(s: []i8, b: int, e: int): int {
    p: int = b;
    while (p < e) {
        sc: int = gn_script(gn_utf8_at(s, p, e));
        if (sc != 0) return sc;
        p = p + gn_utf8_len(s[p] as int & 255)
    }
    0
}

// A UTF-8 sequence's length from its first byte, and its code point.
gn_utf8_len(k: int): int {
    if (k < 128) 1 else if (k >= 240) 4 else if (k >= 224) 3 else if (k >= 192) 2 else 1
}

gn_utf8_at(s: []i8, p: int, e: int): int {
    k: int = s[p] as int & 255;
    n: int = gn_utf8_len(k);
    if (n == 1 || p + n > e) return k;
    cp: int = k & (if (n == 2) 31 else if (n == 3) 15 else 7);
    for i in 1..n cp = cp * 64 + (s[p + i] as int & 63);
    cp
}

// A tap on a note's screen.
tag bible
sk_grammar_note_act(at: int, action: int, arg: int) {
    if (action == ACT_GN_OPEN) sk_open(SCR_GRAMMAR_NOTE, arg, true) else if (action == ACT_GN_FORMS) sk_open(SCR_FORMS,
        arg, true) else if (action == ACT_GN_LIST) sk_open(SCR_GRAMMAR_NOTES, arg,
        true)
}
