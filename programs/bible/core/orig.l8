tag bible;

use_tag std;

// The Hebrew and Greek in the reader (DESIGN.md §14.11), apart from any
// platform: which words are glossed (by what you know, or the rare ones)
// and each one's gloss, the BSB's words for it in its verse; a verse's
// words, its Hebrew number, a Qere's Ketiv; what a word's popover says; the
// word picked in the text; search by Greek, Hebrew or Latin letters, their
// accents, breathings and points folded. text.l8 lays the text out (its
// words from orig-words.bin, tools/orig.py's).
import "text.l8";

import "store.l8";

import "lang.l8";

import "learn.l8";

// ---- the Ketiv (OrigWords' ketiv: WORD<TAB>QERE<TAB>KETIV a line, by
// word) ----
// The Ketiv of word w (a Qere) onto fbuf; false (and nothing put) if it
// has none.
fput_og_ketiv(w: int): bool {
    borrow orig_words as od {
        lo: int = 0;
        hi: int = od.ketiv_lines;
        while (lo < hi) {
            mid: int = (lo + hi) / 2;
            if (ket_word(od, mid) < w) lo = mid + 1 else hi = mid
        }
        if (lo >= od.ketiv_lines || ket_word(od, lo) != w) return false;
        p: int = od.ketiv_at[lo];
        e: int = od.ketiv_at[lo + 1] - 1;
        tabs: int = 0;
        while (p < e && tabs < 2) {
            if (od.ketiv[p] as int == 9) tabs = tabs + 1;
            p = p + 1
        }
        if (e <= p) return false;
        for i in p..e fput(od.ketiv[i] as int);
        true
    }
}

// The word line i of the Ketiv is for.
ket_word(od: *OrigWords, i: int): int {
    n: int = 0;
    p: int = od.ketiv_at[i];
    while (p < od.ketiv_size && is_digit(od.ketiv[p] as int)) {
        n = n * 10 + od.ketiv[p] as int - 48;
        p = p + 1
    }
    n
}

// ---- which words are glossed (§14.11.4) ----
// Reading settings → Glosses: Words I Haven't Learned, Rare Words, None;
// -1 (not chosen): words not learned once the language has a card, rare
// words before.
OG_UNLEARNED: int = 0;

OG_RARE: int = 1;

OG_NONE: int = 2;

og_setting: int = -1;

og_lang(w: int): int {
    if (og_greek(w)) 0 else 1
}

// The glosses' modes, as the settings name them.
gloss_names: []str = ["Words I Haven\�\�\�t Learned", "Rare Words", "None"];

og_mode(lang: int): int {
    if (og_setting >= 0) return og_setting;
    if (learn_started(lang)) OG_UNLEARNED else OG_RARE
}

// The printed reader's editions' rule: Greek words used 30 times or fewer,
// Hebrew fewer than 100.
og_rare(lang: int, num: int): bool {
    n: int = vk_count_of(lang, num);
    if (lang == 0) n <= 30 else n < 100
}

// Whether word w of the text is known (§14.1.3): as its words.bin word is;
// a variant the tables lack, by its own number and parsing.
og_known(language: *LanguageData, w: int): bool {
    j: int = og_join(w);
    if (j >= 0 && learn_lang_ready) return word_known(language, j);
    lang: int = og_lang(w);
    num: int = og_strongs(w);
    if ((og_flags(w) & OG_ARAMAIC) != 0) return false;
    if (num > 0) {
        fl: int = vk_flags_of(lang, num);
        if ((fl & FL_ARAMAIC) != 0) return false;
        if (!(word_card_known(lang, num) || (fl & FL_NAME) != 0 && kn_alpha[lang])) return false
    }
    if (lang == 1 && learn_lang_ready) {
        m: int = og_morph(w);
        bits: int = if (m >= 0 && m < len(mp_bits)) mp_bits[m] & 65535 else 0;
        for k in 0..len(jp_ids)
            if ((bits & 1 << k) != 0 && !kn_part[k]) return false
    }
    true
}

// Whether word w is glossed in a mode: names only before the alphabet is
// known (decision 12); Aramaic always, until its cards (Round 14).
og_wanted(language: *LanguageData, w: int, mode: int): bool {
    if (mode == OG_NONE) return false;
    lang: int = og_lang(w);
    num: int = og_strongs(w);
    name: bool = (og_flags(w) & OG_NAME) != 0 || num > 0 && (vk_flags_of(lang, num) & FL_NAME) != 0;
    if (name) return !kn_alpha[lang] && (mode == OG_UNLEARNED || og_rare(lang, num));
    if (mode == OG_UNLEARNED) return !og_known(language, w);
    num > 0 && og_rare(lang, num)
}

// The glosses made for chapter c (text.l8's og_gl and the rest), unless
// they are already, for the cards and the mode now: how many of its words
// are glossed, of how many.
og_gl_gen: int = -1;

og_gl_mode: int = -1;

og_prep_glossed: int = 0;

og_prep_words: int = 0;

orig_prepare(language: *LanguageData, c: int) {
    if (c < 0 || c >= chapters) return;
    lang: int = if (ch_book[c] < 39) 1 else 0;
    mode: int = og_mode(lang);
    if (og_gl_c == c && og_gl_gen == cd_gen && og_gl_mode == mode) return;
    og_gl_c = c;
    og_gl_gen = cd_gen;
    og_gl_mode = mode;
    first: int = og_ch_first[c];
    last: int = if (c + 1 < chapters) og_ch_first[c + 1] else og_n;
    n: int = last - first;
    if (n > OW_MOST) n = OW_MOST;
    og_gl_first = first;
    og_gl_n = n;
    og_gt_n = 0;
    og_prep_glossed = 0;
    og_prep_words = n;
    for i in 0..n {
        w: int = first + i;
        og_gk[i] = og_strongs(w) | (if (og_greek(w)) 32768 else 0);
        og_gt_b[i] = og_gt_n;
        if (og_wanted(language, w, mode)) og_gloss_into_gt(language, w);
        og_gt_e[i] = og_gt_n;
        og_gl[i] = og_gt_e[i] > og_gt_b[i];
        og_sh[i] = (if (og_gl[i]) (if (og_shares_before(language, w)) 1 else 0) | (if (og_shares_after(language,
            w)) 2 else 0) else 0);
        if (og_gl[i]) og_prep_glossed = og_prep_glossed + 1
    }
}

// Made again at the next layout (a card changed; the mode chosen).
orig_forget() {
    og_gl_c = -1
}

og_gt_put(k: int) {
    if (og_gt_n < len(og_gt)) {
        og_gt[og_gt_n] = k trunc i8;
        og_gt_n = og_gt_n + 1
    }
}

// Word w's gloss onto og_gt (fbuf untouched: a layout may come in the
// middle of a line being made there).
og_into_gt: bool = false;

og_gloss_into_gt(language: *LanguageData, w: int) {
    og_into_gt = true;
    fput_og_gloss(language, w);
    og_into_gt = false
}

og_put(k: int) {
    if (og_into_gt) og_gt_put(k) else fput(k)
}

// ---- a word's gloss: the BSB's words for it in its verse ----
// Word w's gloss into fbuf: the BSB's rendering of it in that verse
// (through words.bin, its join), its first letter lower case where it
// begins a sentence (but I, and God and names); without one, the gloss of
// its sense in the lexicon (before a colon, as lists show it).
fput_og_gloss(language: *LanguageData, w: int) {
    j: int = og_join(w);
    if (j >= 0) {
        vi: int = word_verse(language, j);
        if (vi >= 0) {
            study_load(language, vi);
            chunk_of(language, j);
            if (ch_e > ch_b) {
                low: bool = sentence_start(ch_b) && !keeps_capital(w, ch_b, ch_e) && lower_in_chapter(v_chapter(language,
                    vi), ch_b);
                for x in ch_b..ch_e {
                    k: int = st[x] as int;
                    if (x == ch_b && low && k >= 65 && k <= 90) k = k + 32;
                    og_put(k)
                }
                return
            }
        }
    }
    greek: bool = og_greek(w);
    num: int = og_strongs(w);
    if (num <= 0) return;
    e: int = meaning_entry(language, greek, num, if (j >= 0) w_sense(language, j) else og_sense(w));
    if (e < 0) e = lex_first(language, greek, num);
    if (e < 0) return;
    lex_field(language, e, 3);
    // (A split sense's part before its colon, as lists show it.)
    x: int = lf_b;
    while (x < lf_e && language.lexicon[x] as int != 58) x = x + 1;
    while (x > lf_b && language.lexicon[x - 1] as int == 32) x = x - 1;
    if (x == lf_b) x = lf_e;
    for i in lf_b..x og_put(language.lexicon[i] as int)
}

// Whether st[b] begins a sentence: the verse's (or its title's) first
// word, or after . ! ? or an opening quotation mark.
sentence_start(b: int): bool {
    x: int = b;
    while (x > 0) {
        k: int = st[x - 1] as int & 255;
        if (k == 32) x = x - 1 else if (k == 156 || k == 152) {
            // (“ or ‘: the last byte of its three.)
            return true
        } else return k == 46 || k == 33 || k == 63 || x == st_title + 1 && st_title > 0
    }
    true
}

// Whether a gloss keeps its capital: "I" and "O" (I am, O king), a word in
// capitals throughout (LORD), a name, God.
keeps_capital(w: int, b: int, e: int): bool {
    x: int = b;
    caps: bool = true;
    while (x < e && is_ascii_letter(st[x] as int)) {
        if (st[x] as int >= 97) caps = false;
        x = x + 1
    }
    if (x - b == 1 && (st[b] as int == 73 || st[b] as int == 79)) return true;
    if (x - b > 1 && caps) return true;
    if ((og_flags(w) & OG_NAME) != 0) return true;
    num: int = og_strongs(w);
    if (og_greek(w)) num == 2316 || num == 2424 || num == 5547 else num == 430 || num == 410
}

is_ascii_letter(k: int): bool {
    k >= 65 && k <= 90 || k >= 97 && k <= 122
}

// Whether the BSB writes the word at st[b] (its letters) in lower case
// somewhere in chapter c's verses: only then is a sentence's first word
// lowered ("The" as "the"; "He makes me lie down" stays, as Psalm 23 has
// "He" throughout; review r11-1).
lower_in_chapter(c: int, b: int): bool {
    n: int = 0;
    while (b + n < st_n && is_ascii_letter(st[b + n] as int)) n = n + 1;
    if (n == 0 || c < 0) return false;
    borrow texts[text_or_current(TEXT_BSB)] as src {
        found: bool = false;
        p: int = src.starts[c];
        e_ch: int = src.ends[c];
        while (p < e_ch && !found) {
            e: int = record_line_end(src.data, src.size, p);
            k: int = src.data[p] as int;
            if (k == 84 || k == 87 || k == 68 || k == 100) {
                x: int = p + 1;
                while (x + n <= e && !found) {
                    if ((x == p + 1 || !is_ascii_letter(src.data[x - 1] as int)) && (x + n == e || !is_ascii_letter(src.data[x + n] as int))) {
                        same: bool = true;
                        for i in 0..n {
                            a: int = src.data[x + i] as int;
                            s: int = st[b + i] as int;
                            if (i == 0) {
                                if (a != s + 32 && !(s >= 97 && a == s)) same = false
                            } else if (a != s) same = false
                        }
                        if (same) found = true
                    }
                    x = x + 1
                }
            }
            p = e + 1
        }
        found
    }
}

// The verse (verses.bin's index) word j of words.bin is in (-1: none).
word_verse(language: *LanguageData, j: int): int {
    if (j < 0 || language.verse_count == 0) return -1;
    lo: int = 0;
    hi: int = language.verse_count;
    while (lo + 1 < hi) {
        mid: int = (lo + hi) / 2;
        if (v_first(language, mid) <= j) lo = mid else hi = mid
    }
    if (j >= v_end(language, lo)) -1 else lo
}

// ---- a verse of the original (the text current the Hebrew and Greek's) ----
// Verse v's words (keyed as the BSB's; 0, its psalm's title) of chapter c:
// og_vb to og_ve; and its Hebrew number where it differs (og_hn_c,
// og_hn_v; 0 none).
og_vb: int = 0;

og_ve: int = 0;

og_hn_c: int = 0;

og_hn_v: int = 0;

og_verse(c: int, v: int): bool {
    borrow texts[TEXT_ORIG] as orig {
        og_vb = 0;
        og_ve = 0;
        og_hn_c = 0;
        og_hn_v = 0;
        if (c < 0 || c >= chapters || orig.starts[c] < 0) return false;
        w: int = og_ch_first[c];
        p: int = orig.starts[c];
        cur: int = -1;
        hc: int = 0;
        hv: int = 0;
        found: bool = false;
        while (p < orig.ends[c]) {
            e: int = record_line_end(orig.data, orig.size, p);
            k: int = orig.data[p] as int;
            if (k == 78) {
                hc = record_number_at(orig.data, orig.size, p + 1);
                q: int = p + 1;
                while (q < e && orig.data[q] as int != 58) q = q + 1;
                hv = record_number_at(orig.data, orig.size, q + 1)
            } else if (k == 86 || k == 68) {
                if (found) return true;
                cur = (if (k == 68) 0 else record_key_at(orig.data, orig.size, p + 1));
                if (cur == v) {
                    found = true;
                    og_vb = w;
                    og_ve = w;
                    og_hn_c = hc;
                    og_hn_v = hv
                }
                hc = 0;
                hv = 0
            }
            if (og_words_line(k)) {
                n: int = record_og_count(orig.data, p + 1, e, w);
                w = w + n;
                if (found) og_ve = w
            }
            p = e + 1
        }
        found
    }
}

osq_tmp: []int = new int[256](0);

// The verse word w is in: og_wc, og_wv (0: its psalm's title); false if
// none.
og_wc: int = -1;

og_wv: int = 0;

og_where(w: int): bool {
    borrow texts[TEXT_ORIG] as orig {
        c: int = og_chapter_of(w);
        og_wc = c;
        og_wv = 0;
        if (c < 0) return false;
        k: int = og_ch_first[c];
        p: int = orig.starts[c];
        v: int = 0;
        while (p < orig.ends[c]) {
            e: int = record_line_end(orig.data, orig.size, p);
            x: int = orig.data[p] as int;
            if (x == 86) v = record_key_at(orig.data, orig.size, p + 1) else if (x == 68) v = 0;
            if (og_words_line(x)) {
                n: int = record_og_count(orig.data, p + 1, e, k);
                if (w < k + n) {
                    og_wv = v;
                    return true
                }
                k = k + n
            }
            p = e + 1
        }
        false
    }
}

// Word w's letters into fbuf (its punctuation and maqaf left out).
// (With the word beside it whose English is its own too, as in the text:
// "μὴ ἀπόληται", whose "shall not perish" the BSB gives the two together;
// review r11-1.)
fput_og_form(language: *LanguageData, w: int) {
    borrow texts[TEXT_ORIG] as orig {
        p: int = og_text_at(orig, if (og_shares_before(language, w)) w - 1 else w);
        if (p < 0) return;
        last: int = if (og_shares_after(language, w)) w + 1 else w;
        q: int = og_text_at(orig, last);
        if (q < 0) return;
        e: int = letters_end_of(orig.data, q, q + og_len(last));
        for i in p..e fput(orig.data[i] as int)
    }
}

// Whether the word before w has no English of its own, the BSB rendering
// it with w ("with next" in the tables: μὴ before ἀπόληται); and the word
// after, with w ("with previous").
og_shares_before(language: *LanguageData, w: int): bool {
    if (w <= 0 || !language.ready) return false;
    j: int = og_join(w - 1);
    j >= 0 && og_join(w) == j + 1 && (w_flags(language, j) & 10) == 2 && w_ntok(language,
        j) == 0
}

og_shares_after(language: *LanguageData, w: int): bool {
    if (w + 1 >= og_n || !language.ready) return false;
    j: int = og_join(w + 1);
    j > 0 && og_join(w) == j - 1 && (w_flags(language, j) & 10) == 10 && w_ntok(language,
        j) == 0
}

// Its transliteration (the BSB's tables', through its join), into fbuf;
// false if it has none.
fput_og_translit(language: *LanguageData, w: int): bool {
    borrow texts[TEXT_ORIG] as orig {
        j: int = og_join(w);
        if (j < 0) return false;
        form_of(language, j);
        if (wt_e <= wt_b) return false;
        p: int = og_text_at(orig, w);
        if (p >= 0) {
            script_fold(language.forms, wf_b, wf_e);
            n: int = fo_len;
            for i in 0..n osq_tmp[i] = fo_cp[i];
            script_fold(orig.data, p, letters_end_of(orig.data, p, p + og_len(w)));
            if (fo_len != n) return false;
            for i in 0..n
                if (fo_cp[i] != osq_tmp[i]) return false
        }
        for i in wt_b..wt_e fput(language.forms[i] as int);
        true
    }
    // (Not the tables' where their form is another spelling, as for a
    // Qere whose tables have its Ketiv.)
}

// Its meaning here (UBS's: "to have love for someone … · Love, Affection,
// Compassion") into fbuf; false if none known.
fput_og_meaning(language: *LanguageData, w: int): bool {
    j: int = og_join(w);
    m: int = if (j >= 0) w_meaning(language, j) else 0;
    if (m <= 0) return false;
    fput_meaning(language, m);
    true
}

// A meaning's definition (or its glosses) and its domain.
fput_meaning(language: *LanguageData, m: int) {
    mean_field(language, m, 4);
    if (mf_e <= mf_b) mean_field(language, m, 5);
    for i in mf_b..mf_e fput(language.meaning_text[i] as int);
    mean_field(language, m, 3);
    if (mf_e > mf_b) {
        fput_str(" \�\� ");
        for i in mf_b..mf_e fput(language.meaning_text[i] as int)
    }
}

// ---- the word picked in the text (the edit menu's Study) ----
// The word whose letters are at or after byte b of the chapter laid out
// (ow_b to ow_e): pick_word (words.bin's; -1 if it has none) and pick_vi;
// the original's word in og_picked. False if no word is.
og_picked: int = -1;

og_pick(language: *LanguageData, ctx: *ChapterLayout, b: int): bool {
    og_picked = -1;
    pick_word = -1;
    pick_vi = -1;
    for i in 0..ctx.ow_n {
        if (og_picked < 0 && b < ctx.ow_e[i]) og_picked = ctx.ow_w[i]
    }
    if (og_picked < 0) return false;
    pick_word = og_join(og_picked);
    pick_vi = word_verse(language, pick_word);
    pick_word >= 0 && pick_vi >= 0
}

// ---- search by Greek, Hebrew or Latin letters (§14.11.7) ----
// The words searched for, folded: Greek or Hebrew as letter_fold folds them
// (accents, breathings, points and final forms gone); Latin letters as a
// transliteration is folded (latin_fold), to be found in each word's;
// each a run of osq (from osq_at, osq_len long), whether it is Latin, and
// whether it may begin a longer word (* after it); and whether they are a
// phrase (in quotes: together, in order).
osq: []int = new int[512](0);

osq_n: int = 0;

osq_words: int = 0;

osq_at: []int = new int[16](0);

osq_len: []int = new int[16](0);

osq_latin: []bool = new bool[16](false);

osq_prefix: []bool = new bool[16](false);

osq_phrase: bool = false;

// A run of code points folded into fo_cp (fo_len), from a word's bytes.
fo_cp: []int = new int[256](0);

fo_len: int = 0;

fo_put(cp: int) {
    if (fo_len < len(fo_cp)) {
        fo_cp[fo_len] = cp;
        fo_len = fo_len + 1
    }
}

// Latin Extended Additional (U+1E00 on): each pair's base letter, a to y.
latin_ext_bases: str = "aabbbbbbccddddddddddeeeeeeeeeeffgghhhhhhhhhhiiiikkkkkkllllllllmmmmmmnnnnnnnnoooooooopppprrrrrrrrssssssssssttttttttuuuuuuuuuuvvvvwwwwwwwwwwxxxxyyzzzzzzhtwyasssd";

// A transliteration's letter, folded: lower case, its marks gone (ā a, ə
// e, š s, ḥ h); 0 for what is no letter (· ‘ ’ ʾ ʿ, marks, hyphens).
latin_base(cp: int): int {
    if (cp >= 65 && cp <= 90) return cp + 32;
    if (cp >= 97 && cp <= 122) return cp;
    if (cp == 601 || cp == 603 || cp == 477) return 101;
    if (cp >= 7680 && cp < 7680 + len(latin_ext_bases)) return latin_ext_bases[cp - 7680] as int;
    if (cp >= 7840 && cp <= 7929) return if (cp < 7864) 97 else if (cp < 7880) 101 else if (cp < 7884) 105 else if (cp < 7908) 111 else if (cp < 7922) 117 else 121;
    if (cp >= 192 && cp <= 383) {
        f: int = mem_fold(cp);
        if (f >= 97 && f <= 122) return f
    }
    0
}

// Bytes b[p..e] of a transliteration (or a Latin query) folded into fo_cp: its
// letters as latin_base folds them; a w after ō before a consonant (a
// vowel's letter: lō·wm) left out; then sh s, ch h, kh k, th t, ph p (so
// "shalom" is šā·lō·wm's "salom", "theos" θεός's "teos").
latin_fold(b: []i8, p: int, e: int) {
    fo_len = 0;
    q: int = p;
    prev_o: bool = false;
    while (q < e) {
        cp: int = utf8_at(b, q, e);
        q = q + cp_n;
        x: int = latin_base(cp);
        if (x == 119 && prev_o) {
            // (Its next letter: a consonant, or none.)
            r: int = q;
            nx: int = 0;
            while (r < e && nx == 0) {
                c2: int = utf8_at(b, r, e);
                r = r + cp_n;
                nx = latin_base(c2)
            }
            if (nx == 0 || !is_vowel_letter(nx)) x = 0
        }
        if (x != 0) {
            prev_o = cp == 333;
            if (x == 104 && fo_len > 0 && (fo_cp[fo_len - 1] == 115 || fo_cp[fo_len - 1] == 99 || fo_cp[fo_len - 1] == 107 || fo_cp[fo_len - 1] == 116 || fo_cp[fo_len - 1] == 112)) {
                // (A digraph: its h dropped; ch as h.)
                if (fo_cp[fo_len - 1] == 99) fo_cp[fo_len - 1] = 104
            } else fo_put(x)
        }
    }
}

// A transliteration's first letter as latin_fold would make it (ch as h).
latin_first(b: []i8, p: int, e: int): int {
    q: int = p;
    first: int = 0;
    while (q < e) {
        cp: int = utf8_at(b, q, e);
        q = q + cp_n;
        x: int = latin_base(cp);
        if (x != 0) {
            if (first == 0) {
                if (x != 99) return x;
                first = x
            } else return if (x == 104) 104 else first
        }
    }
    first
}

is_vowel_letter(k: int): bool {
    k == 97 || k == 101 || k == 105 || k == 111 || k == 117 || k == 121
}

// Bytes b[p..e] of Greek or Hebrew folded into fo_cp: their letters, as
// letter_fold folds them, marks and punctuation gone.
script_fold(b: []i8, p: int, e: int) {
    fo_len = 0;
    q: int = p;
    while (q < e) {
        cp: int = utf8_at(b, q, e);
        q = q + cp_n;
        if (is_orig_letter(cp)) fo_put(letter_fold(cp))
    }
}

// Whether bytes p..e hold a Greek or Hebrew letter.
has_script(b: []i8, p: int, e: int): bool {
    q: int = p;
    while (q < e) {
        cp: int = utf8_at(b, q, e);
        q = q + cp_n;
        if (is_orig_letter(cp)) return true
    }
    false
}

// The query (the first n bytes of s) as words to search for.
og_search_words(s: []i8, n: int) {
    osq_n = 0;
    osq_words = 0;
    osq_phrase = false;
    i: int = 0;
    while (i < n) {
        k: int = s[i] as int & 255;
        if (k == 34 || k == 226 && i + 2 < n && (s[i + 2] as int & 255) >= 156 && (s[i + 2] as int & 255) <= 157) osq_phrase = true;
        sep: bool = k == 32 || k == 34 || k == 42 || k == 44 || k == 46 || k == 59 || k == 226 && i + 2 < n && (s[i + 1] as int & 255) == 128;
        if (sep) {
            if (k == 42 && osq_words > 0) osq_prefix[osq_words - 1] = true;
            i = i + (if (k == 226) 3 else 1)
        } else {
            b: int = i;
            while (i < n && !(s[i] as int == 32 || s[i] as int == 34 || s[i] as int == 42 || s[i] as int == 44 || (s[i] as int & 255) == 226 && i + 1 < n && (s[i + 1] as int & 255) == 128)) i = i + 1;
            if (osq_words < len(osq_at)) {
                latin: bool = !has_script(s, b, i);
                if (latin) latin_fold(s, b, i) else script_fold(s, b, i);
                if (fo_len > 0) {
                    osq_at[osq_words] = osq_n;
                    osq_len[osq_words] = fo_len;
                    osq_latin[osq_words] = latin;
                    osq_prefix[osq_words] = false;
                    for x in 0..fo_len {
                        if (osq_n < len(osq)) {
                            osq[osq_n] = fo_cp[x];
                            osq_n = osq_n + 1
                        }
                    }
                    osq_words = osq_words + 1
                }
            }
        }
    }
    if (osq_words < 2) osq_phrase = false
}

// The Strong's numbers whose lemma a search word names (§14.11.7): a bit
// per search word (osq's k), Greek and Hebrew. "agape" names ἀγάπη, so it
// finds ἀγάπην and ἀγάπης; "shalom" and "שלום" name שָׁלוֹם, so they find
// בְּשָׁלוֹם. A form that is no lemma ("agapen") finds only itself.
osq_lem_g: []int = new int[STRONGS_MAX](0);

osq_lem_h: []int = new int[STRONGS_MAX](0);

// Each search word marks the numbers whose lemma (Latin: its
// transliteration; else its letters) folds to it: every entry of every
// number, each of a field's lemmas apart ("α, Ἀλφα").
og_search_lemmas(language: *LanguageData) {
    if (!language.ready) return;
    for i in 0..STRONGS_MAX {
        osq_lem_g[i] = 0;
        osq_lem_h[i] = 0
    }
    for g in 0..2 {
        for num in 1..STRONGS_MAX {
            p: int = lex_first(language, g == 0, num);
            if (p >= 0) {
                n: int = lex_count(language, p);
                for i in 0..n {
                    q: int = lex_line(language, p, i);
                    for k in 0..osq_words {
                        lex_field(language, q, if (osq_latin[k]) 1 else 0);
                        if (og_lemma_is(language, k, lf_b, lf_e)) {
                            if (g == 0) osq_lem_g[num] = osq_lem_g[num] | 1 << k else osq_lem_h[num] = osq_lem_h[num] | 1 << k
                        }
                    }
                }
            }
        }
    }
}

// Whether a lexicon field (llex[b..e]) holds search word k as one of its
// lemmas (split at commas).
og_lemma_is(
    language: *LanguageData,
    k: int,
    b: int,
    e: int
): bool {
    q: int = b;
    while (q < e) {
        r: int = q;
        while (r < e && language.lexicon[r] as int != 44) r = r + 1;
        if (osq_latin[k]) {
            if (latin_first(language.lexicon, q, r) == osq[osq_at[k]]) {
                latin_fold(language.lexicon, q, r);
                if (og_folded_is(k)) return true
            }
        } else {
            script_fold(language.lexicon, q, r);
            if (og_folded_is(k)) return true
        }
        q = r + 1
    }
    false
}

// Whether fo_cp (fo_len) is search word k (or begins it, for a k with *).
og_folded_is(k: int): bool {
    n: int = osq_len[k];
    if (fo_len < n || fo_len > n && !osq_prefix[k]) return false;
    for i in 0..n
        if (fo_cp[i] != osq[osq_at[k] + i]) return false;
    true
}

// Whether word w (its letters bsb's... b[p..e]) is search word k: its
// lemma's named, or its form is.
og_word_is(
    language: *LanguageData,
    k: int,
    w: int,
    b: []i8,
    p: int,
    e: int
): bool {
    num: int = og_strongs(w);
    if (num > 0 && num < STRONGS_MAX && ((if (og_greek(w)) osq_lem_g[num] else osq_lem_h[num]) & 1 << k) != 0) return true;
    if (osq_latin[k]) {
        j: int = og_join(w);
        if (j < 0) return false;
        form_of(language, j);
        // (Its first letter first: most words go there, unfolded.)
        if (latin_first(language.forms, wt_b, wt_e) != osq[osq_at[k]]) return false;
        latin_fold(language.forms, wt_b, wt_e)
    } else script_fold(b, p, e);
    og_folded_is(k)
}

// The verses of books from to last (inclusive) the query finds (every
// word somewhere in the verse; a phrase's words together, in order), in
// order: text.l8's hit_chapter and the rest. The text current is the
// original's.
og_search(
    language: *LanguageData,
    q: []i8,
    n: int,
    from: int,
    last: int
) {
    hit_count = 0;
    hit_more = false;
    og_search_words(q, n);
    if (osq_words == 0) return;
    og_search_lemmas(language);
    c: int = book_first[from];
    e_c: int = book_first[last] + book_count[last];
    borrow texts[TEXT_ORIG] as orig {
        while (c < e_c && !hit_more) {
            og_search_chapter(orig, language, c);
            c = c + 1
        }
    }
}

// Per verse: the words found (a bit each), and the phrase's place in it.
os_found: int = 0;

os_run: int = 0;

og_search_chapter(orig: *TextData, language: *LanguageData, c: int) {
    if (orig.starts[c] < 0) return;
    w: int = og_ch_first[c];
    p: int = orig.starts[c];
    v: int = 0;
    os_found = 0;
    os_run = 0;
    while (p < orig.ends[c]) {
        e: int = record_line_end(orig.data, orig.size, p);
        k: int = orig.data[p] as int;
        if (k == 86) {
            nv: int = record_key_at(orig.data, orig.size, p + 1);
            if (nv != v) {
                if (v > 0) og_search_verse(c, v);
                v = nv;
                os_found = 0;
                os_run = 0
            }
        } else if (k == 68) {
            // (A title: its words are its verse 1's, as words.bin has them.)
            os_found = 0;
            os_run = 0;
            v = 1
        }
        if (og_words_line(k)) {
            x: int = p + 1;
            while (x < e) {
                if (orig.data[x] as int == 32) x = x + 1 else {
                    we: int = x + og_len(w);
                    le: int = letters_end_of(orig.data, x, we);
                    og_search_word(language, w, orig.data, x, le);
                    w = w + 1;
                    x = we
                }
            }
        }
        p = e + 1
    }
    if (v > 0) og_search_verse(c, v)
}

// A word of the verse searched: the words it is (or the phrase's next).
og_search_word(
    language: *LanguageData,
    w: int,
    b: []i8,
    p: int,
    e: int
) {
    if (osq_phrase) {
        if (os_run < osq_words && og_word_is(language, os_run, w, b, p, e)) os_run = os_run + 1 else if (os_run < osq_words) os_run = (if (og_word_is(language,
            0, w, b, p, e)) 1 else 0);
        if (os_run == osq_words) os_found = 1;
        return
    }
    for k in 0..osq_words
        if ((os_found & 1 << k) == 0 && og_word_is(language, k, w, b, p, e)) os_found = os_found | 1 << k
}

og_search_verse(c: int, v: int) {
    all: bool = if (osq_phrase) os_found == 1 else os_found == (1 << osq_words) - 1;
    // (A title's verse 1 is searched once more with its verse: the same
    // verse, kept once.)
    if (!all || hit_count > 0 && hit_chapter[hit_count - 1] == c && hit_verse[hit_count - 1] == v) return;
    if (hit_count >= len(hit_chapter)) {
        hit_more = true;
        return
    }
    hit_chapter[hit_count] = c;
    hit_verse[hit_count] = v;
    hit_count = hit_count + 1
}

// Where the query is in verse v of chapter c: its text in vt (verse_text),
// and each word it finds there in mr_begin to mr_end (text.l8's), its
// letters; for a phrase, only its words together ("ho logos" names every
// article, but only the one before λόγος is the phrase's).
om_w: []int = new int[512](0);

om_b: []int = new int[512](0);

om_e: []int = new int[512](0);

og_match_ranges(language: *LanguageData, c: int, v: int) {
    verse_text(c, v);
    mr_count = 0;
    og_verse(c, v);
    w: int = og_vb;
    x: int = 0;
    n: int = 0;
    while (x < vt_n && w < og_ve) {
        if (vt[x] as int == 32) x = x + 1 else {
            we: int = x + og_len(w);
            if (we > vt_n) we = vt_n;
            if (n < len(om_w)) {
                om_w[n] = w;
                om_b[n] = x;
                om_e[n] = letters_end_of(vt, x, we);
                n = n + 1
            }
            w = w + 1;
            x = we
        }
    }
    for i in 0..n {
        if (osq_phrase) {
            run: bool = i + osq_words <= n;
            for k in 0..osq_words
                if (run && !og_word_is(language, k, om_w[i + k], vt, om_b[i + k],
                    om_e[i + k])) run = false;
            if (run)
                for k in 0..osq_words mr_add(om_b[i + k], om_e[i + k])
        } else {
            hit: bool = false;
            for k in 0..osq_words
                if (!hit && og_word_is(language, k, om_w[i], vt, om_b[i], om_e[i])) hit = true;
            if (hit) mr_add(om_b[i], om_e[i])
        }
    }
}

// ---- copied as shown (§14.11.7) ----
// Verse v of chapter c into vt as the reader shows it: with its
// cantillation when Show Accents is on (the Hebrew's), else its text.
og_verse_text_shown(c: int, v: int): int {
    if (!lay_accents || c < 0 || ch_book[c] >= 39 || !og_accents_of(c)) return verse_text(c,
        v);
    if (!og_verse(c, v)) return verse_text(c, v);
    vt_n = 0;
    borrow orig_words as od {
        acc: []i8 = od.accents;
        n: int = od.accents_size;
        line: int = od.accents_chapter[c];
        w: int = og_ch_first[c];
        while (w < og_vb && line < n) {
            while (line < n && acc[line] as int != 10) line = line + 1;
            line = line + 1;
            w = w + 1
        }
        while (w < og_ve && line < n) {
            e: int = line;
            while (e < n && acc[e] as int != 10) e = e + 1;
            for x in line..e vt_add(acc[x] as int);
            if ((og_flags(w) & OG_MAQAF) != 0) {
                vt_add(214);
                vt_add(190)
            } else if (w + 1 < og_ve) vt_add(32);
            line = e + 1;
            w = w + 1
        }
    }
    // (Word og_vb's line: from the chapter's first word's.)
    vt_n
}

// Whether chapter c's cantillated forms are here.
og_accents_of(c: int): bool {
    borrow orig_words as od {
        od.accents_size > 0 && od.accents_chapter[c] >= 0
    }
}
