tag bible;

use_tag std;

// The Study sheet (DESIGN.md Â§9.6.2), as core's screen (SKINS.md): the
// tray's Study opens a verse's screen whose bar's title is its segments,
// Words Â· References Â· Commentary. Words is the interlinear (its words as
// tiles, the English order or the original's, what is known hidden: Â§14.5.1);
// References the verse's cross references from OpenBible.info, most votes
// first, each one's passage a preview; Commentary Matthew Henry's Concise
// Commentary on the section the verse is in, its references previews too.
// Each begins with the verse's reference and words; its foot has the verse
// before and after. The segment last shown is kept (studySegment). Verses
// are the BSB's numbering.
import "skin.l8";

import "lang.l8";

import "learn.l8";

// Its arg: the verse (chapter * 1000 + verse) * 4, plus its segment plus
// one if it opens at one (the interlinear pushed from a word's study), else
// the one kept.
SCR_VERSE_STUDY: int = 39;

// A segment chosen (value its index); the verse before or after (arg -1,
// 1); the order chosen (value 1: the original's); a tile tapped (arg its
// word: shown if it hides something, else studied); its Word Study; a
// reference's passage previewed (arg the reference); Show All (the
// references past twelve); another verse shown (arg chapter * 1000 +
// verse: a panel beside the text following the selection); the reader
// taken to the verse (a panel's Show in Text).
ACT_VS_SEGMENT: int = 120;

ACT_VS_STEP: int = 121;

ACT_VS_ORDER: int = 122;

ACT_VS_TILE: int = 123;

ACT_VS_WORD: int = 124;

ACT_VS_PREVIEW: int = 125;

ACT_VS_ALL: int = 126;

ACT_VS_SHOW: int = 187;

ACT_VS_TEXT: int = 188;

// The commentary shown chosen (value: its place among the choices,
// Matthew Henry's Concise first, then the bookshelf's commentaries).
ACT_VS_COMMENTARY: int = 189;

// Hide What I Know, under the interlinear in the original's order.
ACT_VS_HIDE: int = 190;

// Whether every reference shows (Show All tapped), and the words a tap has
// shown (by their place in the verse); both for the verse shown.
sk_xr_all: bool = false;

sk_il_shown: []bool = new bool[300](false);

sk_vs_c: int = -1;

sk_vs_v: int = -1;

// (As it opens: what a tap showed, and Show All, forgotten.)
sk_verse_study_opening(kind: int, arg: int) {
    if (kind != SCR_VERSE_STUDY) return;
    // (Over the reader: its verse a jump's origin.)
    if (sk_n == 0) {
        jp_sheet_c = arg / 4 / 1000;
        jp_sheet_v = arg / 4 % 1000
    }
    sk_vs_forget()
}

// ---- Study in the panel beside the page (core/beside.l8) ----
// Study in the panel moved a verse back or on (âŒ˜â†‘, âŒ˜â†“).
sk_beside_step(d: int) {
    at: int = sk_beside_at();
    if (at >= 0) sk_act(sk_ids[at], ACT_VS_STEP, d, 0)
}

sk_vs_forget() {
    sk_xr_all = false;
    for x in 0..len(sk_il_shown) sk_il_shown[x] = false
}

// The segment shown: the arg's, else the one kept.
sk_vs_segment(arg: int): int {
    if (arg % 4 > 0) arg % 4 - 1 else clamp_index(pref_get("studySegment"), 3)
}

sk_build_verse_study(language: *LanguageData, id: int, arg: int) {
    _l: int = sk_num_of(SK_NUM_LANG, 0);
    cv: int = arg / 4;
    c: int = cv / 1000;
    v: int = cv % 1000;
    if (c != sk_vs_c || v != sk_vs_v) {
        sk_vs_c = c;
        sk_vs_v = v;
        sk_vs_forget()
    }
    seg: int = sk_vs_segment(arg);
    fbuf_n = 0;
    fput_ref(c, v, v);
    ui_begin(id, SCR_VERSE_STUDY, arg, "");
    ui_set_screen_title_fbuf();
    // (The panel's first: Show in Text, the reader to its verse; over
    // another of the panel's, its Back.)
    at: int = sk_find(id);
    if (at == 0 && sk_groups[at] == 1) ui_set_left("Show in Text", "text.magnifyingglass",
        ACT_VS_TEXT, UI_TOOL_PLAIN);
    ui_set_segments("Words|References|Commentary", seg, ACT_VS_SEGMENT);
    ui_segments_title = true;
    ui_plain = true;
    vi: int = lang_verse(language, c, v);
    // Its foot: the verse before, (Words: the order,) the verse after.
    ui_tool("", "chevron.up", ACT_VS_STEP, -1, UI_TOOL_PLAIN, 0);
    fbuf_n = 0;
    fput_str("Previous Verse");
    ui_set_tool_label_fbuf();
    ui_tool("", "chevron.down", ACT_VS_STEP, 1, UI_TOOL_PLAIN, 2);
    fbuf_n = 0;
    fput_str("Next Verse");
    ui_set_tool_label_fbuf();
    if (seg == 0) sk_vs_words(language, c, v, vi) else if (seg == 1) sk_vs_references(language,
        c, v, vi) else sk_vs_commentary(language, c, v)
}

// The verse at the top: its reference, small, then its words as the reader
// sets them (in version t; another than the reader's says which).
sk_vs_header(c: int, v: int, t: int) {
    ui_rich_begin();
    fput_ref(c, v, v);
    ui_rich(RUN_SMALL);
    fput_str("\n");
    ui_rich(RUN_PLAIN);
    if (t >= 0) {
        _n: int = verse_text_of(t, c, v);
        fput_bytes(vt, 0, vt_n);
        ui_rich(RUN_SCRIPTURE);
        if (t != text_cur) {
            fput(32);
            fput_version_short(t, c);
            ui_rich(RUN_SMALL)
        }
    }
    ui_rich_intro()
}

// ---- Words: the interlinear (Â§9.6.2, Â§14.5.1) ----
sk_vs_words(
    language: *LanguageData,
    c: int,
    v: int,
    vi: int
) {
    if (!v_studyable(language, vi)) {
        // (A verse the BSB gives in a footnote, or not aligned.)
        sk_vs_header(c, v, quote_text(c, v));
        fbuf_n = 0;
        if (vi < 0) {
            fput_str("The BSB gives ");
            fput_ref(c, v, v);
            fput_str(" in a footnote. The interlinear follows the BSB.")
        } else {
            fput_ref(c, v, v);
            fput_str(" isn\â\€\™t aligned with the original words.")
        }
        ui_set_empty("character.book.closed", if (vi < 0) "Not in the BSB" else "No Interlinear",
            "");
        ui_empty_line = ui_put_fbuf();
        return
    }
    // (The interlinear is the BSB's: asked for, if it is not the version
    // read and has not come; the screens made again as it does.)
    _b: int = if (text_cur != TEXT_BSB && !text_ready(TEXT_BSB)) sk_num_of(SK_NUM_TEXT,
        TEXT_BSB) else 1;
    sk_vs_header(c, v, TEXT_BSB);
    original: bool = pref_get("interlinearOrder") == 1;
    greek: bool = w_greek(language, v_first(language, vi));
    ui_tool("", "", ACT_VS_ORDER, if (original) 1 else 0, UI_TOOL_SEGMENTS, 1);
    fbuf_n = 0;
    fput_str("0:English Order|1:");
    fput_str(if (greek) "Greek Order" else "Hebrew Order");
    ui_set_tool_menu_fbuf();
    // (What is known hidden, in the original order, Hide What I Know on.)
    hide: bool = false;
    if (original && pref_is("learnHideKnown")) {
        _k: int = sk_num_of(SK_NUM_LEARN, 0);
        hide = learn_ready
    }
    ui_section("", if (text_cur != TEXT_BSB) "The interlinear follows the Berean Standard Bible." else "");
    ui_row(UI_TILES, 0, vi);
    if (original && !greek) ui_rows[ui_last()].value = 1;
    interlinear_tiles(language, vi, original);
    for i in 0..tile_n sk_vs_tile(language, vi, i, hide);
    // The link to the language's page: Learn Greek (or, once started,
    // Greek); none in an Aramaic verse.
    aramaic: bool = false;
    for w in v_first(language, vi)..v_end(language, vi)
        if (word_aramaic(language, w)) aramaic = true;
    if (!aramaic) {
        _k: int = sk_num_of(SK_NUM_LEARN, 0);
        lang: int = if (greek) 0 else 1;
        // (Where it acts: in the original's order, once the language is
        // begun.)
        if (original && learn_started(lang)) {
            ui_section("", "Hides the English under words you know, and the transliteration once you know the alphabet. Tap a word to show it.");
            ui_row(UI_TOGGLE, ACT_VS_HIDE, 0);
            ui_set_title("Hide What I Know");
            ui_set_on(pref_is("learnHideKnown"));
            ui_section("", "")
        }
        ui_row(UI_BUTTON, ACT_MM_LANGUAGE, lang);
        ui_set_title(if (learn_started(lang)) language_names[lang] else if (lang == 0) "Learn Greek" else "Learn Hebrew");
        ui_set_tinted()
    }
}

// Tile i: its English (or, not translated, a faint word), the original
// form, its transliteration, its code and parsing; what it hides (the
// English of a word known, the transliteration once the alphabet is), unless
// a tap has shown it (then the helped mark); a tap shows, then studies.
sk_vs_tile(
    language: *LanguageData,
    vi: int,
    i: int,
    hide: bool
) {
    w: int = tile_word[i];
    if (w < 0) {
        // (Words the translation adds.)
        fbuf_n = 0;
        ui_cell_fbuf(0, 0, -1);
        fbuf_n = 0;
        fput_bytes(st, tok_b[tile_t0[i]], tok_e[tile_t0[i] + tile_tn[i] - 1]);
        ui_set_cell_sub_fbuf();
        ui_set_cell_flags(UI_TILE_ADDED);
        return
    }
    form_of(language, w);
    fbuf_n = 0;
    fput_bytes(language.forms, wf_b, wf_e);
    ui_cell_fbuf(sk_script(w_greek(language, w), false), ACT_VS_TILE, w);
    fbuf_n = 0;
    fput_bytes(language.forms, wt_b, wt_e);
    ui_set_cell_tr_fbuf();
    flags: int = 0;
    fl: int = w_flags(language, w);
    fbuf_n = 0;
    if (tile_tn[i] > 0) fput_bytes(st, tok_b[tile_t0[i]], tok_e[tile_t0[i] + tile_tn[i] - 1]) else if ((fl & 2) != 0) {
        fput_str(if ((fl & 8) != 0) "(with previous)" else "(with next)");
        flags = flags | UI_TILE_FAINT_SUB
    } else {
        fput_str("\â\€\”");
        flags = flags | UI_TILE_FAINT_SUB
    }
    ui_set_cell_sub_fbuf();
    fbuf_n = 0;
    if (w_strongs(language, w) > 0) {
        fput_key(w_greek(language, w), w_strongs(language, w));
        fput_str(" \Â\· ")
    }
    morph_of(language, w_morph(language, w));
    fput_bytes(language.morph, mc_b, mc_e);
    ui_set_cell_count_fbuf();
    shown: bool = sk_il_shown[w - v_first(language, vi)];
    hid_sub: bool = hide && !shown && word_known(language, w);
    hid_tr: bool = hide && !shown && kn_alpha[word_lang(language, w)];
    if (hid_sub) flags = flags | UI_TILE_HIDE_SUB;
    if (hid_tr) flags = flags | UI_TILE_HIDE_TR;
    if (hide && shown && word_known(language, w)) flags = flags | UI_TILE_HELPED;
    ui_set_cell_flags(flags);
    // "loved, Greek Ä“gapÄ“sen, verb, aorist â€¦"; its meaning hidden, "Greek
    // Ä“gapÄ“sen, verb, aorist â€¦, meaning hidden", Show Meaning and Word Study.
    fbuf_n = 0;
    if (!hid_sub) {
        if (tile_tn[i] > 0) fput_bytes(st, tok_b[tile_t0[i]], tok_e[tile_t0[i] + tile_tn[i] - 1]) else fput_str("not translated");
        fput_str(", ")
    }
    fput_str(if (w_greek(language, w)) "Greek " else "Hebrew ");
    form_of(language, w);
    fput_bytes(language.forms, wt_b, wt_e);
    fput_str(", ");
    plain_parsing(language, w_morph(language, w));
    fput_bytes(pl, 0, pl_n);
    if (hid_sub) fput_str(", meaning hidden");
    ui_set_cell_label_fbuf();
    if (hid_sub || hid_tr) {
        ui_cell_action("Show Meaning", ACT_VS_TILE);
        ui_cell_action("Word Study", ACT_VS_WORD)
    }
}

// ---- References (Â§9.6.3) ----
sk_vs_references(
    language: *LanguageData,
    c: int,
    v: int,
    vi: int
) {
    sk_vs_header(c, v, quote_text(c, v));
    total: int = if (vi >= 0) xref_count(language, vi) else 0;
    if (total == 0) {
        fbuf_n = 0;
        fput_str("OpenBible.info lists none for ");
        fput_ref(c, v, v);
        fput(46);
        ui_set_empty("arrow.triangle.branch", "No Cross References", "");
        ui_empty_line = ui_put_fbuf();
        return
    }
    shown: int = if (sk_xr_all || total <= 13) total else 12;
    ui_section("", if (text_cur == TEXT_ESV) "From OpenBible.info, ranked by readers\â\€\™ votes. Verses shown in the BSB." else "From OpenBible.info, ranked by readers\â\€\™ votes.");
    for r in 0..shown {
        xref_at(language, vi, r);
        ref: int = xref_both();
        ui_row(UI_ITEM, ACT_VS_PREVIEW, ref);
        ui_set_custom(CUSTOM_HIT);
        fbuf_n = 0;
        fput_xref(ref);
        ui_set_title_fbuf();
        // (Its first verse: the version read, if here, else the BSB.)
        xref_unpack(ref);
        rc: int = xref_chapter();
        rv: int = if (xr_v > 0) xr_v else 1;
        t: int = quote_text(rc, rv);
        fbuf_n = 0;
        if (t >= 0) {
            _n: int = verse_text_of(t, rc, rv);
            fput_bytes(vt, 0, vt_n)
        }
        ui_set_detail_fbuf();
        ui_set_scripture();
        ui_set_lines(3);
        fbuf_n = 0;
        fput_xref(ref);
        fput_str(". ");
        if (t >= 0) fput_bytes(vt, 0, vt_n);
        ui_set_label_fbuf();
        ui_set_hint("Shows the passage")
    }
    if (shown < total) {
        ui_row(UI_BUTTON, ACT_VS_ALL, 0);
        fbuf_n = 0;
        fput_str("Show All ");
        fput_int(total);
        ui_set_title_fbuf();
        ui_set_tinted()
    }
}

// The reference's name into fbuf: John 1:1â€“5, 2 Corinthians 4:6, Matthew
// 5:1â€“7:29, Psalm 23.
fput_xref(ref: int) {
    xref_unpack(ref);
    c: int = xref_chapter();
    fput_title(c);
    single: bool = book_count[xr_book] == 1;
    if (xr_v > 0) {
        fput(if (single) 32 else 58);
        fput_int(xr_v);
        if (xr_ce != xr_c) {
            fput_str("\â\€\“");
            fput_int(xr_ce);
            fput(58);
            fput_int(xr_ve)
        } else if (xr_ve > xr_v) {
            fput_str("\â\€\“");
            fput_int(xr_ve)
        }
    } else if (xr_ce != xr_c) {
        fput_str("\â\€\“");
        fput_int(xr_ce)
    }
}

// ---- Commentary (Â§9.7.2) ----
// The section the verse is in: "Verses 16â€“21", the commentary's paragraphs
// (their references previews), its name. Matthew Henry's Concise is
// bundled; a commentary from the bookshelf may be chosen in its place
// (studyCommentary: its slot plus one, 0 Henry's), a choice above it.
sk_vs_commentary(language: *LanguageData, c: int, v: int) {
    sk_vs_header(c, v, quote_text(c, v));
    slot: int = sk_vs_commentary_choices();
    if (slot >= 0) {
        sk_vs_shelf_commentary(slot, c, v);
        return
    }
    if (!mhcc_section(language, c, v)) {
        fbuf_n = 0;
        fput_str("Matthew Henry\â\€\™s Concise Commentary has no comment on ");
        fput_ref(c, v, v);
        fput(46);
        ui_set_empty("text.book.closed", "No Commentary Here", "");
        ui_empty_line = ui_put_fbuf();
        return
    }
    ui_page = true;
    ui_section("", "");
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    if (mh_c1 != mh_c2) {
        fput_str("Verses ");
        fput_int(mh_c1);
        fput(58);
        fput_int(mh_v1);
        fput_str("\â\€\“");
        fput_int(mh_c2);
        fput(58);
        fput_int(mh_v2)
    } else if (mh_v2 > mh_v1) {
        fput_str("Verses ");
        fput_int(mh_v1);
        fput_str("\â\€\“");
        fput_int(mh_v2)
    } else {
        fput_str("Verse ");
        fput_int(mh_v1)
    }
    ui_rich(RUN_SMALL);
    ui_rich_title();
    p: int = mh_p;
    while (p < mh_e) {
        e: int = p;
        while (e < language.commentary_size && language.commentary[e] as int != 10) e = e + 1;
        mh_markup(language, p + 1, e);
        ui_row(UI_TEXT, 0, 0);
        ui_set_scripture();
        ui_rich_begin();
        sk_hl_n = 0;
        q: int = 0;
        for r in 0..mo_runs {
            z: int = mo_end[r];
            b: int = ui_rich_u;
            fput_bytes(mo, q, z);
            kind: int = mo_kind[r];
            ui_rich(if (kind == MH_ITALIC) RUN_ITALIC else if (kind == MH_REF) RUN_ACCENT else RUN_PLAIN);
            if (kind == MH_REF && sk_hl_n < len(sk_hl_b)) {
                sk_hl_b[sk_hl_n] = b;
                sk_hl_e[sk_hl_n] = ui_rich_u;
                sk_hl_to[sk_hl_n] = mo_ref[r];
                sk_hl_n = sk_hl_n + 1
            }
            q = z
        }
        ui_rich_title();
        for l in 0..sk_hl_n ui_add_link(sk_hl_b[l], sk_hl_e[l], ACT_VS_PREVIEW, sk_hl_to[l]);
        p = e + 1
    }
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    fput_str("Matthew Henry, Concise Commentary on the Whole Bible (1706\â\€\“1721)");
    ui_rich(RUN_SMALL);
    ui_rich_title();
    sk_vs_more_commentaries()
}

// The bookshelf's commentaries, a choice among them and Henry's (if there
// are any): the slot of the one chosen (-1: Henry's).
sk_vs_commentary_choices(): int {
    if (!sk_has_shelf) return -1;
    chosen: int = pref_get("studyCommentary") - 1;
    fbuf_n = 0;
    fput_str("Matthew Henry\â\€\™s Concise");
    at: int = 0;
    k: int = 0;
    found: int = -1;
    for i in 0..shelf_count() {
        if (shelf_ready_at(i) && shelf_kind_at(i) == SHELF_KIND_COMMENTARY) {
            k = k + 1;
            fput(124);
            fput_shelf_abbreviation(i);
            if (shelf_slot_at(i) == chosen) {
                at = k;
                found = chosen
            }
        }
    }
    if (k == 0) return -1;
    ui_section("", "");
    ui_row(UI_CHOICE, ACT_VS_COMMENTARY, 0);
    ui_set_title("Commentary");
    ui_rows[ui_last()].options = ui_put_fbuf();
    ui_rows[ui_last()].value = at;
    found
}

// Study's More Commentaries: the bookshelf's library at its commentaries.
sk_vs_more_commentaries() {
    if (!sk_has_shelf) return;
    ui_section("", "");
    ui_row(UI_ITEM, ACT_OPEN, OPEN_SHELF_BROWSE);
    ui_rows[ui_last()].value = 1;
    ui_set_title("More Commentaries\â\€\¦");
    ui_set_tinted();
    ui_set_acc(ACC_MORE)
}

// The bookshelf commentary in slot on verse v of chapter c: its section's
// verses, paragraphs and credit (it opened as needed; a row says so while
// it opens).
sk_vs_shelf_commentary(slot: int, c: int, v: int) {
    i: int = shelf_find_slot(slot);
    if (!shelf_ensure_open(slot)) {
        shelf_opening_rows(slot, i);
        sk_vs_more_commentaries();
        return
    }
    shown: bool = false;
    waiting: bool = false;
    borrow shelf_open[SHELF_USE_STUDY] as open {
        match open.reader {
            Verses r -> {
                found: CommentaryFound = commentary_on(r.module, c, v);
                if (found.from >= 0 && !commentary_found_ready(slot, r.module, found)) waiting = true else if (found.from >= 0) {
                    ui_page = true;
                    shown = commentary_section(slot, r.module, found.entry, found.from,
                        found.through, ACT_VS_PREVIEW)
                }
            }
            _ -> { }
        }
    }
    if (waiting) {
        shelf_opening_rows(slot, i);
        sk_vs_more_commentaries();
        return
    }
    if (!shown) {
        ui_section("", "");
        ui_row(UI_TEXT, 0, 0);
        ui_rich_begin();
        fput_shelf_abbreviation(i);
        fput_str(" has no comment on ");
        fput_ref(c, v, v);
        fput(46);
        ui_rich(RUN_FAINT);
        ui_rich_title()
    }
    ui_section("", "");
    shelf_credit_row(i);
    sk_vs_more_commentaries()
}

// ---- what it does ----
sk_vs_act(
    language: *LanguageData,
    at: int,
    action: int,
    arg: int,
    value: int
) {
    id: int = sk_ids[at];
    a: int = sk_args[at];
    cv: int = a / 4;
    c: int = cv / 1000;
    v: int = cv % 1000;
    if (action == ACT_VS_SEGMENT) {
        // (Kept; the verse's screen made again in it, cross-fading.)
        seg: int = clamp_index(value, 3);
        set_pref("studySegment", seg);
        sk_args[at] = cv * 4;
        sk_setting_changed();
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_VS_COMMENTARY) {
        // (The value's place among the choices: 0 Henry's, then the
        // bookshelf's commentaries in their order.)
        chosen: int = 0;
        k: int = 0;
        for i in 0..shelf_count() {
            if (shelf_ready_at(i) && shelf_kind_at(i) == SHELF_KIND_COMMENTARY) {
                k = k + 1;
                if (k == value) chosen = shelf_slot_at(i) + 1
            }
        }
        set_pref("studyCommentary", chosen);
        sk_save();
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_VS_HIDE) {
        set_pref_on("learnHideKnown", value != 0);
        sk_setting_changed();
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_VS_ORDER) {
        set_pref("interlinearOrder", if (value == 1) 1 else 0);
        sk_setting_changed();
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
    if (action == ACT_VS_SHOW) {
        sk_vs_show(id, arg / 1000, arg % 1000);
        sk_beside_follow(sk_find(id));
        ui_effect("refill", id, 1);
        return
    }
    if (action == ACT_VS_TEXT) {
        sk_goto(c, v);
        return
    }
    if (action == ACT_VS_STEP) {
        // (Verse by verse, the BSB's, across chapters; in Words, past those
        // that cannot be studied.)
        vi: int = lang_verse(language, c, v);
        d: int = if (arg < 0) -1 else 1;
        if (vi < 0) {
            // (A verse the BSB lacks: from the one before it.)
            x: int = v - 1;
            while (x > 0 && lang_verse(language, c, x) < 0) x = x - 1;
            vi = lang_verse(language, c, x);
            if (d < 0) d = 0
        }
        vi = vi + d;
        if (sk_vs_segment(a) == 0) {
            while (vi >= 0 && vi < language.verse_count && !v_studyable(language,
                vi)) vi = vi + d
        }
        if (vi < 0 || vi >= language.verse_count || d == 0 && vi == lang_verse(language,
            c, v)) return;
        sk_args[at] = (v_chapter(language, vi) * 1000 + v_num(language, vi)) * 4 + a % 4;
        sk_beside_follow(at);
        sk_build(at);
        ui_effect("update", id, -1);
        ui_effect("study_moved", v_chapter(language, vi), v_num(language, vi));
        return
    }
    if (action == ACT_VS_TILE || action == ACT_VS_WORD) {
        // (A tile hiding something: shown; else, or Word Study, its word
        // studied.)
        vi: int = lang_verse(language, c, v);
        if (vi < 0 || arg < v_first(language, vi) || arg >= v_end(language, vi)) return;
        if (action == ACT_VS_TILE && sk_vs_hides(language, vi, arg)) {
            sk_il_shown[arg - v_first(language, vi)] = true;
            sk_build(at);
            ui_effect("update", id, -1);
            return
        }
        sk_study_open(vi, arg, w_greek(language, arg), w_strongs(language, arg), true,
            true);
        return
    }
    if (action == ACT_VS_PREVIEW) {
        sk_preview(arg);
        return
    }
    if (action == ACT_VS_ALL) {
        sk_xr_all = true;
        sk_build(at);
        ui_effect("update", id, -1);
        return
    }
}

// Whether word w's tile hides something now.
sk_vs_hides(language: *LanguageData, vi: int, w: int): bool {
    if (pref_get("interlinearOrder") != 1 || !pref_is("learnHideKnown") || sk_il_shown[w - v_first(language,
        vi)]) return false;
    _k: int = sk_num_of(SK_NUM_LEARN, 0);
    learn_ready && (word_known(language, w) || kn_alpha[word_lang(language, w)])
}

// Screen id shown at verse v of chapter c (its segment kept): the panel's,
// as a verse is chosen while it is open.
sk_vs_show(id: int, c: int, v: int) {
    i: int = sk_find(id);
    if (i < 0 || sk_kinds[i] != SCR_VERSE_STUDY) return;
    sk_args[i] = (c * 1000 + v) * 4 + sk_args[i] % 4;
    sk_n = i + 1;
    sk_build(i)
}

// ---- a word's definition (Â§9.5) ----
// Its arg: the word study's subject (skin.l8's sk_study_ready).
SCR_DEFINITION: int = 40;

// Its source's link: STEP Bible's site.
ACT_DEF_SOURCE: int = 127;

// The lexicon's entry: the verse's sense first (captioned "In John 3:16"),
// the lemma, its transliteration and code, its gloss; then the entry's
// paragraphs as their markup sets them (a sense hung past its label, an
// outline's line indented a level), its references previews; then the
// other entries of the number ("Also: ..."); then the source, linked.
sk_build_definition(language: *LanguageData, id: int, s: int) {
    sk_study_ready(language, s);
    ui_begin(id, SCR_DEFINITION, s, "Definition");
    ui_plain = true;
    ui_page = true;
    n: int = lex_count(language, ws_lex);
    first: int = if (ws_sense > 0 && !ws_lemma) ws_sense - 1 else 0;
    ui_section("", "");
    for e in 0..n {
        x: int = if (e == 0) first else if (e <= first) e - 1 else e;
        p: int = lex_line(language, ws_lex, x);
        if (e == 0) {
            fbuf_n = 0;
            lex_field(language, p, 0);
            fput_bytes(language.lexicon, lf_b, lf_e);
            at: int = fbuf_n;
            lex_field(language, p, 1);
            fput_bytes(language.lexicon, lf_b, lf_e);
            ui_set_hero(at, sk_script(ws_greek, false), fbuf_n);
            ui_rich_begin();
            if (ws_sense > 0 && !ws_lemma && n > 1) {
                fput_str("In ");
                fput_ref(v_chapter(language, ws_vi), v_num(language, ws_vi), v_num(language,
                    ws_vi));
                fput_str("\n");
                ui_rich(RUN_SMALL)
            }
            if (ws_sense > 0 && !ws_lemma) fput_sense_code(language) else fput_key(ws_greek,
                ws_num);
            ui_rich(RUN_CODE);
            fput_str("\n");
            lex_field(language, p, 3);
            fput_bytes(language.lexicon, lf_b, lf_e);
            ui_rich(RUN_STRONG);
            ui_rich_hero_line()
        } else {
            ui_row(UI_TEXT, 0, 0);
            ui_rich_begin();
            fput_str("Also: ");
            lex_field(language, p, 0);
            fput_bytes(language.lexicon, lf_b, lf_e);
            lex_field(language, p, 3);
            fput_str(" \Â\· ");
            fput_bytes(language.lexicon, lf_b, lf_e);
            ui_rich(RUN_STRONG);
            ui_rich_title();
            ui_set_heading()
        }
        lex_field(language, p, 4);
        lex_markup(language, lf_b, lf_e);
        sk_def_paragraphs()
    }
    // The credit (CC BY): STEP Bible, linked.
    ui_row(UI_TEXT, 0, 0);
    ui_rich_begin();
    fput_str("Source: ");
    ui_rich(RUN_FAINT);
    b: int = ui_rich_u;
    fput_str("STEP Bible");
    ui_rich(RUN_ACCENT);
    ui_rich_title();
    ui_add_link(b, ui_rich_u, ACT_DEF_SOURCE, 0)
}

// The entry's markup (lx, its runs) as paragraphs, a row each: split at
// its line breaks, each set by its first run's indent.
sk_def_paragraphs() {
    a: int = 0;
    open: bool = false;
    for r in 0..lx_runs {
        st: int = lx_style[r];
        style: int = if ((st & LX_REF) != 0) RUN_ACCENT else if ((st & LX_HEBREW) != 0) RUN_HEBREW else if ((st & LX_BOLD) != 0) RUN_STRONG else if ((st & LX_ITALIC) != 0) RUN_ITALIC else if ((st & LX_LABEL) != 0) RUN_FAINT else RUN_PLAIN;
        x: int = a;
        while (x < lx_end[r]) {
            e: int = x;
            while (e < lx_end[r] && lx[e] as int != 10) e = e + 1;
            if (e > x) {
                if (!open) {
                    ui_row(UI_TEXT, 0, 0);
                    ui_set_scripture();
                    // (A sense hung past its label; an outline's line a
                    // level in, 1.2 em a level, hung 1.4 em.)
                    if (lx_level[r] > 0) {
                        ui_rows[ui_last()].value = (lx_level[r] - 1) * 12;
                        ui_rows[ui_last()].lo = 14
                    } else if (lx_sense[r]) ui_rows[ui_last()].lo = 14;
                    ui_rich_begin();
                    sk_hl_n = 0;
                    open = true
                }
                b: int = ui_rich_u;
                fput_bytes(lx, x, e);
                ui_rich(style);
                if ((st & LX_REF) != 0 && lx_book[r] >= 0 && sk_hl_n < len(sk_hl_b)) {
                    xr_book = lx_book[r];
                    xr_c = lx_ch[r];
                    xr_v = lx_verse[r];
                    xr_ce = 0;
                    xr_ve = 0;
                    sk_hl_b[sk_hl_n] = b;
                    sk_hl_e[sk_hl_n] = ui_rich_u;
                    sk_hl_to[sk_hl_n] = xref_both();
                    sk_hl_n = sk_hl_n + 1
                }
            }
            if (e < lx_end[r]) {
                // (A line's end: its paragraph done.)
                if (open) sk_def_close();
                open = false;
                e = e + 1
            }
            x = e
        }
        a = lx_end[r]
    }
    if (open) sk_def_close()
}

sk_def_close() {
    ui_rich_title();
    for l in 0..sk_hl_n ui_add_link(sk_hl_b[l], sk_hl_e[l], ACT_VS_PREVIEW, sk_hl_to[l])
}
