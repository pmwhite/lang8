tag bible;

use_tag std;

// Listening's words and rules (DESIGN.md Â§8.7, Â§12), apart from any
// platform: what the small player says (the verse, or the chapter before
// its first verse; in a plan's day, the passage and the day), its second
// line (the reader, the voice standing in, Loadingâ€¦, Paused), the play
// button's words, the reading settings' Listen button, and where Next and
// Previous go. The engines (a recording, the voice), the lock screen's
// controls and the drawing are a skin's.
import "skin.l8";

import "audio.l8";

// The player's first line: verse v of chapter c (v 0: the chapter's
// title), into fbuf.
lp_title(c: int, v: int) {
    fbuf_n = 0;
    if (v > 0) fput_ref(c, v, 0) else fput_title(c)
}

// Its second line, after what is in fbuf: Paused; the voice standing in
// for a recording that cannot be had; Loadingâ€¦; else the reader of source
// s (a recording's reader, or "iPhone Voice").
lp_state(
    playing: bool,
    standing_in: bool,
    loading: bool,
    s: int
) {
    if (!playing) fput_str("Paused") else if (standing_in) {
        fput_str(sk_device);
        fput_str(" Voice \Â\· Offline")
    } else if (loading) fput_str("Loading\â\€\¦") else if (s == SRC_VOICE) {
        fput_str(sk_device);
        fput_str(" Voice")
    } else fput_str(src_readers[s])
}

// The play button's spoken label, and its symbol.
lp_play_label(playing: bool): str {
    if (playing) "Pause" else "Play"
}

lp_play_symbol(playing: bool): str {
    if (playing) "pause.fill" else "play.fill"
}

// The reading settings' Listen button: Stop Listening; in a plan's day,
// the day's ("Listen to Day 32 from Psalm 105"); else "Listen from John
// 3:16" (the verse at the top, v), into fbuf.
lp_button(
    listening: bool,
    in_day: bool,
    row_at_bar: int,
    c: int,
    v: int
) {
    fbuf_n = 0;
    if (listening) fput_str("Stop Listening") else if (in_day) dd_listen_button(row_at_bar) else {
        fput_str("Listen from ");
        fput_ref(c, v, 0)
    }
}

// Next: the next chapter (-1: none after Revelation 22).
lp_next(c: int): int {
    if (c < 0 || c + 1 >= chapters) -1 else c + 1
}

// Previous: this chapter's start if it is under way (into: more than 3 s
// of a recording, or past its first verse), else the chapter before.
lp_previous(c: int, into: bool): int {
    if (c < 0) return -1;
    if (!into && c > 0) c - 1 else c
}

// Whether verse v of chapter c is the Bible's last (listening done).
lp_last(c: int, v: int): bool {
    c == chapters - 1 && v == ch_verses[chapters - 1]
}

// ---- listening through a plan's day (Â§16.3.3) ----
// Whether Listen reads the day's rows (its passages, each its chapters'
// parts), and the row being heard.
ls_day: bool = false;

ls_row: int = -1;

// Where Listen begins in the day: the passage at the bar (row r_bar's, from
// its first row), or the verse at the top (top_c:top_v) if that is further
// into the same passage: ls_row, and its place lp_c:lp_v.
lp_c: int = 0;

lp_v: int = 1;

lp_day_from(r_bar: int, top_c: int, top_v: int) {
    r: int = if (r_bar < 0) 0 else r_bar;
    k: int = dy_k[r];
    while (r > 0 && dy_k[r - 1] == k) r = r - 1;
    lp_c = dy_c[r];
    lp_v = dy_v1[r];
    rt: int = day_row_of(top_c, top_v);
    if (rt >= 0 && dy_k[rt] == k && (rt > r || top_v > lp_v)) {
        r = rt;
        lp_c = top_c;
        lp_v = top_v
    }
    ls_day = true;
    ls_row = r
}

// The last verse to hear of chapter c (in the day, its row's).
lp_last_of(c: int): int {
    if (!ls_day || ls_row < 0 || ls_row >= dy_n || dy_c[ls_row] != c) return ch_verses[c];
    if (dy_v2[ls_row] > 0) dy_v2[ls_row] else ch_verses[c]
}

lp_next_row(): int {
    if (ls_row + 1 < dy_n) ls_row + 1 else -1
}

lp_row_last(r: int): int {
    if (dy_v2[r] > 0) dy_v2[r] else ch_verses[dy_c[r]]
}

// Verse c:v heard: its row the one heard.
lp_day_at(c: int, v: int) {
    r: int = day_row_of(c, v);
    if (r >= 0) ls_row = r
}

// The source for c:v in the day (s, a recording; follows: whether its
// timings follow verses): a part of a chapter is read by the voice unless
// the recording can be sought into and stopped in.
lp_day_source(
    s: int,
    c: int,
    v: int,
    follows: bool
): int {
    if (!ls_day || s == SRC_VOICE) return s;
    r: int = day_row_of(c, v);
    if (r >= 0) ls_row = r;
    if (r >= 0 && (dy_v1[r] > 1 || dy_v2[r] > 0) && (s == SRC_ESV || !follows)) SRC_VOICE else s
}

// Next or Previous by passage (d 1 or -1), heard now at sc:sv: the row to
// hear from (ls_row; whether there is one). Previous goes to the passage's
// start, or more than a verse into it, the one before's.
lp_day_step(d: int, sc: int, sv: int): bool {
    if (ls_row < 0) return false;
    k: int = dy_k[ls_row];
    r: int = ls_row;
    if (d > 0) {
        while (r < dy_n && dy_k[r] == k) r = r + 1;
        if (r >= dy_n) return false
    } else {
        while (r > 0 && dy_k[r - 1] == k) r = r - 1;
        if (sc == dy_c[r] && sv <= dy_v1[r] + 1 && r > 0) {
            r = r - 1;
            k2: int = dy_k[r];
            while (r > 0 && dy_k[r - 1] == k2) r = r - 1
        }
    }
    ls_row = r;
    true
}

// A recording's chapter c begun in the day: its row (from the one heard).
lp_day_row(c: int) {
    if (!ls_day) return;
    for r in 0..dy_n {
        if (dy_c[r] == c && r >= ls_row) {
            ls_row = r;
            return
        }
    }
}

// Whether row r, heard to its end, ends a passage (said so).
lp_row_heard(r: int): bool {
    ls_day && r >= 0 && r < dy_n && day_row_ends(r)
}

// ---- the session: what comes next ----
// Whether version t can be listened to (no recording of the original, nor
// a voice for it, yet: Â§14.10b.1).
lp_can_listen(t: int): bool {
    t != TEXT_ORIG
}

// What the voice does as verse v of chapter c begins (the chapter queued
// last: queued_c; the voice standing in for a recording: standing_in;
// that recording can be had for the next chapter: rec_next): 0 nothing; 1
// queue lp_c from lp_v to lp_to; 2 go back to the recording at chapter
// lp_c once this one is said.
lp_to: int = 0;

LP_NOTHING: int = 0;

LP_QUEUE: int = 1;

LP_RETURN: int = 2;

LP_STOP: int = 3;

LP_RESTART: int = 4;

lp_began(
    c: int,
    v: int,
    queued_c: int,
    standing_in: bool,
    rec_next: bool
): int {
    if (v <= 0) return LP_NOTHING;
    if (ls_day) {
        lp_day_at(c, v);
        if (v == lp_last_of(c) && queued_c == c) {
            nr: int = lp_next_row();
            if (nr >= 0) {
                lp_c = dy_c[nr];
                lp_v = dy_v1[nr];
                lp_to = lp_row_last(nr);
                return LP_QUEUE
            }
        }
        return LP_NOTHING
    }
    if (v == ch_verses[c] && queued_c == c && c + 1 < chapters) {
        lp_c = c + 1;
        lp_v = 1;
        lp_to = ch_verses[c + 1];
        if (standing_in && rec_next) return LP_RETURN;
        return LP_QUEUE
    }
    LP_NOTHING
}

// What the voice does as verse v of chapter c has been said (the chapter
// to go back to the recording at: return_c): in a day, its row's last verse
// heard, then the next row, or the end (stop); else the chapter's last
// verse heard (read: lp_heard), Revelation 22's the end; the recording
// taken up again at the next chapter (restart at lp_c).
lp_heard: bool = false;

lp_finished(c: int, v: int, return_c: int): int {
    lp_heard = false;
    if (ls_day) {
        if (v > 0 && v == lp_last_of(c) && lp_next_row() < 0) return LP_STOP;
        return LP_NOTHING
    }
    lp_heard = v > 0 && v == ch_verses[c];
    if (lp_last(c, v)) return LP_STOP;
    if (lp_heard && return_c == c + 1) {
        lp_c = c + 1;
        lp_v = 1;
        return LP_RESTART
    }
    LP_NOTHING
}

// A recording's chapter c played to its end (not in a day): read, and
// Revelation 22's the end.
lp_item_ended(c: int): int {
    if (c == chapters - 1) LP_STOP else LP_NOTHING
}

// The verse the voice stands in from when a recording fails: the one being
// heard, else the one asked for, else the first.
lp_fail_verse(heard_v: int, asked_v: int): int {
    if (heard_v > 0) heard_v else if (asked_v > 0) asked_v else 1
}

// ---- Listen by the device's voice, for a skin without its own ----
// (SK_NUM_OWN_LISTEN: the iPhone's own engines, recordings and voice,
// following the rules above. Any other: core runs the session and the
// skin's voice says what core gives it: say C V WORDS, an utterance each,
// the chapter's title as verse 0; it tells core as each begins (spoke C
// V) and ends (spoken C V). The small player's words: player TITLE STATE;
// the reader follows: follow C V; listen_stop.)
SK_NUM_OWN_LISTEN: int = 22;

lw_on: bool = false;

lw_c: int = -1;

lw_v: int = 0;

lw_queued_c: int = -1;

lw_own(): bool {
    sk_num_of(SK_NUM_OWN_LISTEN, 0) == 1
}

// Chapter c's verses first to last queued, its title first from verse 1.
lw_queue(c: int, first: int, last: int) {
    lw_queued_c = c;
    if (first <= 1) {
        fbuf_n = 0;
        fput_spoken_title(c);
        lw_say(c, 0)
    }
    for v in first..last + 1 {
        _n: int = speak_text(c, v);
        fbuf_n = 0;
        fput_bytes(vt, 0, vt_n);
        lw_say(c, v)
    }
}

lw_say(c: int, v: int) {
    ui_effect_words_n = 0;
    if (!ui_wire) return;
    ui_str("say ");
    ui_int(c);
    ui_byte(32);
    ui_int(v);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, fbuf_n);
    ui_byte(10)
}

// The player's words: the verse (or chapter) and its state.
lw_player() {
    lp_title(lw_c, lw_v);
    t: int = fbuf_n;
    lp_state(true, false, false, SRC_VOICE);
    ui_str("player");
    ui_byte(9);
    ui_field_bytes(fbuf, 0, t);
    ui_byte(9);
    ui_field_bytes(fbuf, t, fbuf_n);
    ui_byte(10)
}

// Listen begun at c:v (v 0: the chapter's start), or stopped.
lw_start(c: int, v: int) {
    if (c < 0 || c >= chapters || !lp_can_listen(text_cur)) return;
    lw_on = true;
    lw_c = c;
    lw_v = (if (v < 1) 0 else v);
    ls_day = false;
    lw_queue(c, if (v < 1) 1 else v, ch_verses[c]);
    lw_player()
}

lw_stop() {
    if (!lw_on) return;
    lw_on = false;
    lw_queued_c = -1;
    ui_effect("listen_stop", -1, -1)
}

// The settings' Listen button.
sk_listen_toggle() {
    if (lw_on) lw_stop() else {
        sk_n = 0;
        ui_effect("dismiss", -1, -1);
        lw_start(sk_c, sk_v)
    }
}

// Verse v of chapter c begun: followed, the player's words, and at a
// chapter's last verse the next one queued (core's rules).
lw_spoke(c: int, v: int, now: f64) {
    if (!lw_on) return;
    if (v > 0) {
        lw_c = c;
        lw_v = v;
        if (now < 0.0f64 || now >= lw_follow_after) ui_effect("follow", c, v);
        lw_player()
    }
    k: int = lp_began(c, v, lw_queued_c, false, false);
    if (k == LP_QUEUE) lw_queue(lp_c, lp_v, lp_to)
}

// Following waits while a finger moves the reader, and LP_FOLLOW_WAIT_S
// after it rests (the skin's clock, seconds).
LP_FOLLOW_WAIT_S: f64 = 8.0f64;

lw_follow_after: f64 = 0.0f64;

lw_dragged(moving: bool, now: f64) {
    if (moving) lw_follow_after = 1.0e18f64 else if (lw_follow_after > 1.0e17f64) lw_follow_after = now + LP_FOLLOW_WAIT_S
}

// Verse v of chapter c said: a chapter heard is read (the carried ribbon
// moves on); Revelation 22's end, listening done.
lw_spoken(c: int, v: int) {
    if (!lw_on) return;
    k: int = lp_finished(c, v, -1);
    if (lp_heard) rd_read(c);
    if (k == LP_STOP) lw_stop()
}
