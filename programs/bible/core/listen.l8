tag bible;

use_tag std;

// Listening's words and rules (DESIGN.md Â§8.7, Â§12), apart from any
// platform: what the small player says (the verse, or the chapter before
// its first verse; in a plan's day, the passage and the day), its second
// line (the reader, the voice standing in, Loadingâ€¦, Paused), the play
// button's words, the reading settings' Listen button, and where Next and
// Previous go. The engines (a recording, the voice), the lock screen's
// controls and the drawing are a skin's.
import "skin.l8";

import "audio.l8";

// The player's first line: verse v of chapter c (v 0: the chapter's
// title), into fbuf.
lp_title(c: int, v: int) {
    fbuf_n = 0;
    if (v > 0) fput_ref(c, v, 0) else fput_title(c)
}

// Its second line, after what is in fbuf: Paused; the voice standing in
// for a recording that cannot be had; Loadingâ€¦; else the reader of source
// s (a recording's reader, or "iPhone Voice").
lp_state(
    playing: bool,
    standing_in: bool,
    loading: bool,
    s: int
) {
    if (!playing) fput_str("Paused") else if (standing_in) {
        fput_str(sk_device);
        fput_str(" Voice \Â\· Offline")
    } else if (loading) fput_str("Loading\â\€\¦") else fput_reader(s)
}

// The play button's spoken label, and its symbol.
lp_play_label(playing: bool): str {
    if (playing) "Pause" else "Play"
}

lp_play_symbol(playing: bool): str {
    if (playing) "pause.fill" else "play.fill"
}

// The reading settings' Listen button: Stop Listening; in a plan's day,
// the day's ("Listen to Day 32 from Psalm 105"); else "Listen from John
// 3:16" (the verse at the top, v), into fbuf.
lp_button(
    listening: bool,
    in_day: bool,
    row_at_bar: int,
    c: int,
    v: int
) {
    fbuf_n = 0;
    if (listening) fput_str("Stop Listening") else if (in_day) dd_listen_button(row_at_bar) else {
        fput_str("Listen from ");
        fput_ref(c, v, 0)
    }
}

// Next: the next chapter (-1: none after Revelation 22).
lp_next(c: int): int {
    if (c < 0 || c + 1 >= chapters) -1 else c + 1
}

// Previous: this chapter's start if it is under way (into: more than 3 s
// of a recording, or past its first verse), else the chapter before.
lp_previous(c: int, into: bool): int {
    if (c < 0) return -1;
    if (!into && c > 0) c - 1 else c
}

// Whether verse v of chapter c is the Bible's last (listening done).
lp_last(c: int, v: int): bool {
    c == chapters - 1 && v == ch_verses[chapters - 1]
}

// ---- listening through a plan's day (Â§16.3.3) ----
// Whether Listen reads the day's rows (its passages, each its chapters'
// parts), and the row being heard.
ls_day: bool = false;

ls_row: int = -1;

// Where Listen begins in the day: the passage at the bar (row r_bar's, from
// its first row), or the verse at the top (top_c:top_v) if that is further
// into the same passage: ls_row, and its place lp_c:lp_v.
lp_c: int = 0;

lp_v: int = 1;

lp_day_from(r_bar: int, top_c: int, top_v: int) {
    r: int = if (r_bar < 0) 0 else r_bar;
    k: int = dy_k[r];
    while (r > 0 && dy_k[r - 1] == k) r = r - 1;
    lp_c = dy_c[r];
    lp_v = dy_v1[r];
    rt: int = day_row_of(top_c, top_v);
    if (rt >= 0 && dy_k[rt] == k && (rt > r || top_v > lp_v)) {
        r = rt;
        lp_c = top_c;
        lp_v = top_v
    }
    ls_day = true;
    ls_row = r
}

// The last verse to hear of chapter c (in the day, its row's).
lp_last_of(c: int): int {
    if (!ls_day || ls_row < 0 || ls_row >= dy_n || dy_c[ls_row] != c) return ch_verses[c];
    if (dy_v2[ls_row] > 0) dy_v2[ls_row] else ch_verses[c]
}

lp_next_row(): int {
    if (ls_row + 1 < dy_n) ls_row + 1 else -1
}

lp_row_last(r: int): int {
    if (dy_v2[r] > 0) dy_v2[r] else ch_verses[dy_c[r]]
}

// Verse c:v heard: its row the one heard.
lp_day_at(c: int, v: int) {
    r: int = day_row_of(c, v);
    if (r >= 0) ls_row = r
}

// The source for c:v in the day (s, a recording; follows: whether its
// timings follow verses): a part of a chapter is read by the voice unless
// the recording can be sought into and stopped in.
lp_day_source(
    s: int,
    c: int,
    v: int,
    follows: bool
): int {
    if (!ls_day || s == SRC_VOICE) return s;
    r: int = day_row_of(c, v);
    if (r >= 0) ls_row = r;
    if (r >= 0 && (dy_v1[r] > 1 || dy_v2[r] > 0) && (s == SRC_ESV || !follows)) SRC_VOICE else s
}

// Next or Previous by passage (d 1 or -1), heard now at sc:sv: the row to
// hear from (ls_row; whether there is one). Previous goes to the passage's
// start, or more than a verse into it, the one before's.
lp_day_step(d: int, sc: int, sv: int): bool {
    if (ls_row < 0) return false;
    k: int = dy_k[ls_row];
    r: int = ls_row;
    if (d > 0) {
        while (r < dy_n && dy_k[r] == k) r = r + 1;
        if (r >= dy_n) return false
    } else {
        while (r > 0 && dy_k[r - 1] == k) r = r - 1;
        if (sc == dy_c[r] && sv <= dy_v1[r] + 1 && r > 0) {
            r = r - 1;
            k2: int = dy_k[r];
            while (r > 0 && dy_k[r - 1] == k2) r = r - 1
        }
    }
    ls_row = r;
    true
}

// A recording's chapter c begun in the day: its row (from the one heard).
lp_day_row(c: int) {
    if (!ls_day) return;
    for r in 0..dy_n {
        if (dy_c[r] == c && r >= ls_row) {
            ls_row = r;
            return
        }
    }
}

// Whether row r, heard to its end, ends a passage (said so).
lp_row_heard(r: int): bool {
    ls_day && r >= 0 && r < dy_n && day_row_ends(r)
}

// ---- the session: what comes next ----
// Whether version t can be listened to (no recording of the original, nor
// a voice for it, yet: Â§14.10b.1).
lp_can_listen(t: int): bool {
    t != TEXT_ORIG
}

// What the voice does as verse v of chapter c begins (the chapter queued
// last: queued_c; the voice standing in for a recording: standing_in;
// that recording can be had for the next chapter: rec_next): 0 nothing; 1
// queue lp_c from lp_v to lp_to; 2 go back to the recording at chapter
// lp_c once this one is said.
lp_to: int = 0;

LP_NOTHING: int = 0;

LP_QUEUE: int = 1;

LP_RETURN: int = 2;

LP_STOP: int = 3;

LP_RESTART: int = 4;

lp_began(
    c: int,
    v: int,
    queued_c: int,
    standing_in: bool,
    rec_next: bool
): int {
    if (v <= 0) return LP_NOTHING;
    if (ls_day) {
        lp_day_at(c, v);
        if (v == lp_last_of(c) && queued_c == c) {
            nr: int = lp_next_row();
            if (nr >= 0) {
                lp_c = dy_c[nr];
                lp_v = dy_v1[nr];
                lp_to = lp_row_last(nr);
                return LP_QUEUE
            }
        }
        return LP_NOTHING
    }
    if (v == ch_verses[c] && queued_c == c && c + 1 < chapters) {
        lp_c = c + 1;
        lp_v = 1;
        lp_to = ch_verses[c + 1];
        if (standing_in && rec_next) return LP_RETURN;
        return LP_QUEUE
    }
    LP_NOTHING
}

// What the voice does as verse v of chapter c has been said (the chapter
// to go back to the recording at: return_c): in a day, its row's last verse
// heard, then the next row, or the end (stop); else the chapter's last
// verse heard (read: lp_heard), Revelation 22's the end; the recording
// taken up again at the next chapter (restart at lp_c).
lp_heard: bool = false;

lp_finished(c: int, v: int, return_c: int): int {
    lp_heard = false;
    if (ls_day) {
        if (v > 0 && v == lp_last_of(c) && lp_next_row() < 0) return LP_STOP;
        return LP_NOTHING
    }
    lp_heard = v > 0 && v == ch_verses[c];
    if (lp_last(c, v)) return LP_STOP;
    if (lp_heard && return_c == c + 1) {
        lp_c = c + 1;
        lp_v = 1;
        return LP_RESTART
    }
    LP_NOTHING
}

// A recording's chapter c played to its end (not in a day): read, and
// Revelation 22's the end.
lp_item_ended(c: int): int {
    if (c == chapters - 1) LP_STOP else LP_NOTHING
}

// The verse the voice stands in from when a recording fails: the one being
// heard, else the one asked for, else the first.
lp_fail_verse(heard_v: int, asked_v: int): int {
    if (heard_v > 0) heard_v else if (asked_v > 0) asked_v else 1
}

// ---- Listen by the device's voice ----
// (Core runs the session and the skin's voice says what core gives it:
// say C V WORDS, an utterance each,
// the chapter's title as verse 0; it tells core as each begins (spoke C
// V) and ends (spoken C V). The small player's words: player TITLE STATE;
// the reader follows: follow C V; listen_stop.)
lw_on: bool = false;

lw_c: int = -1;

lw_v: int = 0;

lw_queued_c: int = -1;

// Chapter c's verses first to last queued, its title first from verse 1.
lw_queue(c: int, first: int, last: int) {
    lw_queued_c = c;
    if (first <= 1) {
        fbuf_n = 0;
        fput_spoken_title(c);
        lw_say(c, 0)
    }
    for v in first..last + 1 {
        _n: int = speak_text(c, v);
        fbuf_n = 0;
        fput_bytes(vt, 0, vt_n);
        lw_say(c, v)
    }
}

lw_say(c: int, v: int) {
    ui_str("say ");
    ui_int(c);
    ui_byte(32);
    ui_int(v);
    ui_byte(32);
    ui_int((lw_rate() * 1000.0f64) as int);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, fbuf_n);
    // (The voice to say it in: the one chosen, or the best; none, the
    // device's own.)
    ui_byte(9);
    fbuf_n = 0;
    fput_voice_heard();
    ui_field_bytes(fbuf, 0, fbuf_n);
    ui_byte(10)
}

// The player's words: the verse (or chapter) and its state; whether it
// plays (its button Pause or Play); who reads, and the version (player
// TITLE STATE PLAYING READER VERSION).
lw_player() {
    lp_title(lw_c, lw_v);
    t: int = fbuf_n;
    lp_state(lw_playing, lw_standing_in, lw_loading, lw_src);
    ui_str("player");
    ui_byte(9);
    ui_field_bytes(fbuf, 0, t);
    ui_byte(9);
    ui_field_bytes(fbuf, t, fbuf_n);
    ui_byte(9);
    ui_int(if (lw_playing) 1 else 0);
    // (Who reads and what, for the platform's own player: a lock screen's.)
    r: int = fbuf_n;
    fput_reader(lw_src);
    ui_byte(9);
    ui_field_bytes(fbuf, r, fbuf_n);
    ui_byte(9);
    ui_str(text_names[text_cur]);
    ui_byte(10);
    // (The verse being heard, washed: hearing C V; the chapter, V 0.)
    ui_str("hearing ");
    ui_int(lw_c);
    ui_byte(32);
    ui_int(lw_v);
    ui_byte(10)
}

// ---- what is heard: a recording, or the device's voice ----
// (The skin plays an address from a time to a time, and says where it is:
// audio_play TOKEN C FROM TO RATE URL; audiotime TOKEN CS DURATION,
// audioended TOKEN, audiofailed TOKEN. Times are centiseconds; the token
// tells the play now from those before.)
lw_player_on: bool = false;

lw_src: int = SRC_VOICE;

lw_chosen: int = SRC_VOICE;

lw_tok: int = 0;

lw_playing: bool = true;

lw_loading: bool = false;

lw_standing_in: bool = false;

lw_hold_v: int = 0;

lw_ask_v: int = 0;

lw_t: int = 0;

lw_return_c: int = -1;

lw_failed_at: []f64 = new f64[6](-1000.0f64);

// The speeds Listen offers (listenRate: slower, normal, faster).
lw_rates: []f64 = [0.85f64, 1.0f64, 1.25f64];

lw_rate(): f64 {
    lw_rates[clamp_index(pref_get("listenRate"), len(lw_rates))]
}

// The source chapter c is heard from now: the version's chosen reader,
// unless it can't be had (then the voice).
lw_effective(c: int): int {
    audio_effective(lw_chosen, c, false, true, lw_failed_at[lw_chosen], ew_now())
}

// Listen begun at c:v (v 0: the chapter's start), or stopped.
lw_start(c: int, v: int) {
    if (c < 0 || c >= chapters || !lp_can_listen(text_cur)) return;
    lw_on = true;
    lw_playing = true;
    lw_standing_in = false;
    lw_return_c = -1;
    ls_day = false;
    lw_chosen = clamp_index(sk_num_of(SK_NUM_AUDIO_SOURCE, text_cur), SOURCES);
    lw_go(c, v)
}

// Heard from c:v by whichever source it is heard from now.
lw_go(c: int, v: int) {
    e: int = lw_effective(c);
    if (e == SRC_VOICE) lw_voice(c, v) else lw_play(e, c, v)
}

// The voice from c:v.
lw_voice(c: int, v: int) {
    if (lw_player_on) ui_effect("audio_stop", -1, -1);
    lw_player_on = false;
    lw_tok = lw_tok + 1;
    lw_src = SRC_VOICE;
    lw_loading = false;
    lw_c = c;
    lw_v = (if (v < 1) 0 else v);
    ui_effect("speech_stop", -1, -1);
    lw_queue(c, if (v < 1) 1 else v, ch_verses[c]);
    lw_player()
}

// Source s's recording of chapter c, from verse v: its address (the
// ESV's asked of the Worker, by the host), from where verse v begins.
lw_play(s: int, c: int, v: int) {
    ui_effect("speech_stop", -1, -1);
    lw_kept = false;
    lw_queued_c = -1;
    lw_player_on = true;
    lw_src = s;
    lw_c = c;
    lw_ask_v = v;
    lw_v = (if (s != SRC_ESV && v > 1) v else 0);
    lw_hold_v = (if (v > 1) v else 0);
    lw_tok = lw_tok + 1;
    lw_t = 0;
    lw_loading = true;
    if (s == SRC_ESV) {
        if (!hs_on) {
            lw_fail();
            return
        }
        hs_esv_audio(c);
        lw_player();
        return
    }
    audio_address(s, c);
    if (au_n == 0) {
        lw_fail();
        return
    }
    lw_kept = audio_cache_find(s, c) >= 0;
    lw_emit(c, if (follows_verses(s, c) && v > 1) audio_time_of(s, c, v) else 0, au,
        au_n);
    lw_player();
    held_played(s, c)
}

// The ESV's recording's address came (b's first n bytes; none: it can't
// be had).
lw_esv_url(b: []i8, n: int) {
    if (!lw_on || !lw_player_on || lw_src != SRC_ESV) return;
    if (n <= 0) {
        lw_fail();
        return
    }
    lw_emit(lw_c, 0, b, n)
}

lw_emit(
    c: int,
    from: int,
    b: []i8,
    n: int
) {
    ui_str("audio_play ");
    ui_int(lw_tok);
    ui_byte(32);
    ui_int(c);
    ui_byte(32);
    ui_int(from);
    ui_str(" -1 ");
    ui_int((lw_rate() * 1000.0f64) as int);
    ui_byte(9);
    ui_field_bytes(b, 0, n);
    ui_byte(10)
}

// Where the recording is (t into chapter, of duration): the verse it is
// at followed, the one asked for held until it is reached.
lw_time(tok: int, t: int, duration: int) {
    if (!lw_on || !lw_player_on || tok != lw_tok) return;
    if (lw_loading) {
        lw_loading = false;
        lw_player()
    }
    lw_t = t;
    if (!follows_verses(lw_src, lw_c)) return;
    v: int = audio_verse_shown(lw_src, lw_c, t, lw_hold_v);
    if (v < 0) return;
    if (lw_hold_v > 0 && audio_hold_ended(lw_src, lw_c, t, lw_hold_v)) lw_hold_v = 0;
    if (v != lw_v) lw_at(lw_c, v)
}

lw_at(c: int, v: int) {
    lw_c = c;
    lw_v = v;
    if (v > 0 && ew_now() >= lw_follow_after) ui_effect("follow", c, v);
    lw_player()
}

// The recording's chapter heard to its end: read, and on to the next.
lw_ended(tok: int) {
    if (!lw_on || !lw_player_on || tok != lw_tok) return;
    c: int = lw_c;
    rd_read(c);
    if (lp_item_ended(c) == LP_STOP || c + 1 >= chapters) {
        lw_stop();
        return
    }
    lw_go(c + 1, 0)
}

// The recording failed: the voice stands in from the verse being heard.
// Whether the recording playing is a held chapter's file (core/held.l8).
lw_kept: bool = false;

lw_failed(tok: int) {
    if (!lw_on || !lw_player_on || tok != lw_tok) return;
    // (Its file held gone: played from online instead.)
    if (lw_kept) {
        lw_kept = false;
        held_lost(lw_src, lw_c);
        lw_play(lw_src, lw_c, lw_ask_v);
        return
    }
    lw_fail()
}

lw_fail() {
    lw_failed_at[lw_src] = ew_now();
    lw_standing_in = true;
    lw_voice(lw_c, lp_fail_verse(lw_v, lw_ask_v))
}

// Pause and Play, Next and Previous (the player's buttons).
lw_pause() {
    if (!lw_on || !lw_playing) return;
    lw_playing = false;
    ui_effect("listen_pause", -1, -1);
    lw_player()
}

lw_resume() {
    if (!lw_on || lw_playing) return;
    lw_playing = true;
    ui_effect("listen_resume", -1, -1);
    lw_player()
}

lw_next() {
    if (!lw_on) return;
    n: int = lp_next(lw_c);
    if (n >= 0) {
        lw_playing = true;
        lw_standing_in = false;
        lw_go(n, 0)
    }
}

lw_previous() {
    if (!lw_on) return;
    into: bool = if (lw_player_on) lw_t > LP_PREVIOUS_INTO else lw_v > 1;
    p: int = lp_previous(lw_c, into);
    if (p >= 0) {
        lw_playing = true;
        lw_standing_in = false;
        lw_go(p, 0)
    }
}

lw_stop() {
    if (!lw_on) return;
    lw_on = false;
    lw_queued_c = -1;
    lw_player_on = false;
    lw_tok = lw_tok + 1;
    ui_effect("listen_stop", -1, -1);
    ui_str("hearing -1 0\n")
}

// The settings' Listen button.
sk_listen_toggle() {
    if (lw_on) lw_stop() else {
        sk_n = 0;
        ui_effect("dismiss", -1, -1);
        lw_start(sk_c, sk_v)
    }
}

// Verse v of chapter c begun: followed, the player's words, and at a
// chapter's last verse the next one queued (core's rules).
lw_spoke(c: int, v: int, now: f64) {
    if (!lw_on) return;
    if (v > 0) {
        lw_c = c;
        lw_v = v;
        if (now < 0.0f64 || now >= lw_follow_after) ui_effect("follow", c, v);
        lw_player()
    }
    k: int = lp_began(c, v, lw_queued_c, lw_standing_in, c + 1 < chapters && lw_effective(c + 1) != SRC_VOICE);
    if (k == LP_QUEUE) lw_queue(lp_c, lp_v, lp_to) else if (k == LP_RETURN) lw_return_c = lp_c
}

// Following waits while a finger moves the reader, and LP_FOLLOW_WAIT_S
// after it rests (the skin's clock, seconds).
LP_FOLLOW_WAIT_S: f64 = 8.0f64;

lw_follow_after: f64 = 0.0f64;

lw_dragged(moving: bool, now: f64) {
    if (moving) lw_follow_after = 1.0e18f64 else if (lw_follow_after > 1.0e17f64) lw_follow_after = now + LP_FOLLOW_WAIT_S
}

// Verse v of chapter c said: a chapter heard is read (the carried ribbon
// moves on); Revelation 22's end, listening done.
lw_spoken(c: int, v: int) {
    if (!lw_on || lw_player_on) return;
    k: int = lp_finished(c, v, lw_return_c);
    if (lp_heard) rd_read(c);
    if (k == LP_STOP) lw_stop() else if (k == LP_RESTART) {
        // (The recording taken up again at the next chapter.)
        lw_standing_in = false;
        lw_return_c = -1;
        lw_go(lp_c, 1)
    }
}
