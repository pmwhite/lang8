tag bible;

import "../../../stdlib/raw_write.l8";

extern bible_storage_exit(code: int): noreturn = l8_exit;

bible_storage_full(): noreturn {
    raw::raw_write(2, "bible: static storage exhausted\n");
    bible_storage_exit(1)
}

extern bible_ints_at(p: *int): []int = l8_as_int;

extern bible_bytes_at(p: *i8): []i8 = l8_as_int;

extern bible_bools_at(p: *bool): []bool = l8_as_int;

type BibleEmpty = {
    count: int;
    data: [8]i8
}

bible_empty: BibleEmpty = BibleEmpty { count: 0, data: zeroed([8]i8) };

extern bible_empty_ints_at(p: *i8): []int = l8_as_int;

extern bible_empty_strs_at(p: *i8): []str = l8_as_int;

bible_empty_ints: []int = bible_empty_ints_at(&bible_empty.data[0]);

bible_empty_strs: []str = bible_empty_strs_at(&bible_empty.data[0])
