tag bible;

use_tag std;

// The Bible as the app reads it: data/bsb.txt (made by tools/usfm.py), or
// another version in its format (kjv.txt and the rest; the ESV's chapters,
// as they come), held whole, indexed by book and chapter, and a chapter laid
// out as runs of text, each in one style, for the platform to draw (on an
// iPhone, ios/app.l8 makes each run an attributed string).
//
// The text is one record a line, its first letter saying what it is (see
// tools/usfm.py): B a book, C a chapter, S s headings, R the passages a
// heading points to, D a psalm's title, M m a major section and its range,
// A an acrostic letter, P a paragraph (and its kind), _ a break between
// stanzas, V a verse (V15>14: verse 15, keyed as 14), T words (W the words
// of Jesus, laid out as T; I and J words supplied, in italic), F a footnote
// (d: a psalm's title going on after a footnote in it).
//
// Each version is a dataset of its own (TextData, below): its records and
// where each chapter's are, in an arena of its own, replaced whole when
// the version comes again. Books and chapters are numbered alike in every
// version (DESIGN.md §9.1), so book_first, book_count, ch_book and ch_num
// are the same for all, made from book_chapters (bible_numbering).
//
// Books: their first chapter (counting through the Bible from 0), and how
// many chapters each has.
books: int = 66;

book_first: []int = new int[66](0);

book_count: []int = new int[66](0);

// Chapters: their book, and their number in it.
chapters: int = 0;

ch_book: []int = new int[1189](0);

ch_num: []int = new int[1189](0);

// How many verses each chapter has (its last verse's number) in the text
// current (text_use points it at that text's tx_ch_verses).
ch_verses: []int = new int[1189](0);

// ---- several texts (DESIGN.md §9.1.4) ----
// 0 the BSB, 1 the KJV, 2 the WEB, 3 the ASV, 4 the YLT, 5 the ESV, 6 the
// Hebrew and Greek (§14.11).
TEXTS: int = 7;

TEXT_BSB: int = 0;

TEXT_ESV: int = 5;

TEXT_ORIG: int = 6;

// The ESV passages kept for Memory (DESIGN.md §13.6): a text of their verses
// only, made for one passage at a time (esv_cache.l8). Not a version.
TEXT_PIN: int = 7;

text_cur: int = 0;

// Each text's verses a chapter (its last verse's number): plain numbers,
// kept per text (each process-long), so they are read without the text.
tx_ch_verses: [][]int = new []int[8](new int[0](0));

// Their names, short and in full.
text_abbrs: []str = ["BSB", "KJV", "WEB", "ASV", "YLT", "ESV", "Hebrew and Greek"];

text_names: []str = ["Berean Standard Bible", "King James Version", "World English Bible",
    "American Standard Version", "Young's Literal Translation", "English Standard Version",
    "Hebrew and Greek"];

version_lines: []str = ["BSB \�\� Modern, word-for-word and readable", "KJV \�\� 1769 \�\� The Authorized Version",
    "WEB \�\� Modern, public domain", "ASV \�\� 1901", "YLT \�\� 1898 \�\� Very literal",
    "ESV \�\� Needs an internet connection", "The Hebrew Bible (Leningrad Codex) and the Greek New Testament, word by word from STEP Bible"];

// Whether a version marks the words of Jesus (W records): the ASV and the
// YLT do not.
version_red: []bool = [true, true, true, false, false, true, false];

// ---- each text: a dataset of its own ----
// A version's records (the format above) and where each chapter's are:
// from after its C line to the next C or B line (-1: not held, as the
// ESV's chapters not fetched). Its readers take the text they are given,
// borrowed for what they do; positions are byte offsets into its records.
type TextData = {
    version: int;
    // Whether its records have come (an empty text holds no chapter).
    ready: bool;
    data: []i8;
    size: int;
    starts: []int;
    ends: []int
}

// The renderer takes a TextData, so load it after this type.
import "layout.l8";

import "datafile.l8";

// ---- the books (the same in every version) ----
// Every book's code, name and chapters: each version's B lines are these.
book_codes: []str = ["GEN", "EXO", "LEV", "NUM", "DEU", "JOS", "JDG", "RUT", "1SA",
    "2SA", "1KI", "2KI", "1CH", "2CH", "EZR", "NEH", "EST", "JOB", "PSA", "PRO", "ECC",
    "SNG", "ISA", "JER", "LAM", "EZK", "DAN", "HOS", "JOL", "AMO", "OBA", "JON", "MIC",
    "NAM", "HAB", "ZEP", "HAG", "ZEC", "MAL", "MAT", "MRK", "LUK", "JHN", "ACT", "ROM",
    "1CO", "2CO", "GAL", "EPH", "PHP", "COL", "1TH", "2TH", "1TI", "2TI", "TIT", "PHM",
    "HEB", "JAS", "1PE", "2PE", "1JN", "2JN", "3JN", "JUD", "REV"];

book_names_all: []str = ["Genesis", "Exodus", "Leviticus", "Numbers", "Deuteronomy",
    "Joshua", "Judges", "Ruth", "1 Samuel", "2 Samuel", "1 Kings", "2 Kings", "1 Chronicles",
    "2 Chronicles", "Ezra", "Nehemiah", "Esther", "Job", "Psalms", "Proverbs", "Ecclesiastes",
    "Song of Solomon", "Isaiah", "Jeremiah", "Lamentations", "Ezekiel", "Daniel",
    "Hosea", "Joel", "Amos", "Obadiah", "Jonah", "Micah", "Nahum", "Habakkuk", "Zephaniah",
    "Haggai", "Zechariah", "Malachi", "Matthew", "Mark", "Luke", "John", "Acts", "Romans",
    "1 Corinthians", "2 Corinthians", "Galatians", "Ephesians", "Philippians", "Colossians",
    "1 Thessalonians", "2 Thessalonians", "1 Timothy", "2 Timothy", "Titus", "Philemon",
    "Hebrews", "James", "1 Peter", "2 Peter", "1 John", "2 John", "3 John", "Jude",
    "Revelation"];

book_chapters: []int = [50, 40, 27, 36, 34, 24, 21, 4, 31, 24, 22, 25, 29, 36, 10,
    13, 10, 42, 150, 31, 12, 8, 66, 52, 5, 48, 12, 14, 3, 9, 1, 4, 7, 3, 3, 3, 2,
    14, 4, 28, 16, 24, 21, 28, 16, 16, 13, 6, 6, 4, 4, 5, 3, 6, 4, 3, 1, 13, 5, 5,
    3, 5, 1, 1, 1, 22];

// The texts: each version's (TEXTS), and Memory's passage (TEXT_PIN); an
// empty one, holding no chapter, until its records come.
texts: []?owned *TextData = texts_begin();

texts_begin() noregion: []?owned *TextData@new {
    bible_numbering();
    slots: []?owned *TextData = new ?owned *TextData[TEXT_PIN + 1](null);
    for t in 0..len(slots) {
        slots[t] = text_empty(t);
        tx_ch_verses[t] = new int[chapters](0)
    }
    ch_verses = tx_ch_verses[TEXT_BSB];
    slots
}

// The books' and chapters' numbers, from book_chapters.
bible_numbering() {
    chapters = 0;
    for b in 0..books {
        book_first[b] = chapters;
        book_count[b] = book_chapters[b];
        for n in 1..book_chapters[b] + 1 {
            ch_book[chapters] = b;
            ch_num[chapters] = n;
            chapters = chapters + 1
        }
    }
}

text_empty(t: int): owned *TextData {
    own {
        new TextData {
            version: t,
            ready: false,
            data: new i8[1](0i8),
            size: 0,
            starts: new int[chapters](-1),
            ends: new int[chapters](-1)
        }
    }
}

// Whether text t's records have come.
text_ready(t: int): bool {
    if (t < 0 || t > TEXT_PIN) return false;
    borrow texts[t] as text {
        text.ready
    }
}

// Whether text t holds chapter c's records (the ESV's: once fetched).
text_holds(t: int, c: int): bool {
    if (t < 0 || t > TEXT_PIN || c < 0 || c >= chapters) return false;
    borrow texts[t] as text {
        text.starts[c] >= 0
    }
}

// Text t if its records have come, else the current text: what is read
// after text_use(t), which does nothing for a text that hasn't.
text_or_current(t: int): int {
    if (text_ready(t)) t else text_cur
}

// The text t made the current one (if its records have come).
text_use(t: int) {
    if (!text_ready(t)) return;
    ch_verses = tx_ch_verses[t];
    text_cur = t
}

// Text t's records (source's first n bytes) copied into a text of its own,
// indexed, in place of the one before (let go).
text_came(t: int, source: []i8, n: int) {
    next: owned *TextData = own {
        text: *TextData = text_made(t, n);
        memcpy(text.data, 0, source, 0, n);
        text_index(text);
        text
    };
    text_replace(t, move next)
}

// The same, read by the host into the text's own arena (read: file id's
// bytes into the buffer given, n long).
text_read(
    t: int,
    id: int,
    n: int,
    read: fn(id: int, out: []i8)
) {
    next: owned *TextData = own {
        text: *TextData = text_made(t, n);
        read(id, text.data);
        text_index(text);
        text
    };
    text_replace(t, move next)
}

// A text of n bytes of records (all 0), to be written, in the arena being
// made.
text_made(t: int, n: int): *TextData@new {
    new TextData {
        version: t,
        ready: true,
        data: new i8[n + 1](0i8),
        size: n,
        starts: new int[chapters](-1),
        ends: new int[chapters](-1)
    }
}

text_replace(t: int, next: owned *TextData) {
    drop texts[t];
    texts[t] = move next
}

// Whether text t has verse v of chapter c (scanned, as verse_text does).
text_has(t: int, c: int, v: int): bool {
    if (t < 0 || t > TEXT_PIN) return false;
    if (!text_ready(t)) return false;
    borrow texts[t] as source {
        source_has_verse(source, c, v)
    }
}

has_verse(c: int, v: int): bool {
    borrow texts[text_cur] as source {
        source_has_verse(source, c, v)
    }
}

source_has_verse(source: *TextData, c: int, v: int): bool {
    if (c < 0 || c >= chapters || source.starts[c] < 0) return false;
    if (v <= 0 || v > tx_ch_verses[source.version][c]) return false;
    p: int = source.starts[c];
    while (p < source.ends[c]) {
        e: int = record_line_end(source.data, source.size, p);
        if (source.data[p] as int == 86 && record_key_at(source.data, source.size,
            p + 1) == v) return true;
        p = e + 1
    }
    false
}

// The highest verse any bundled version has in chapter c: the BSB's, or
// past it where refs.txt says (ROM 14 26: the WEB's doxology). A mark on a
// verse up to it is kept (store.l8).
refs_last: []int = new int[1200](0);

ref_last(c: int): int {
    if (c < 0 || c >= chapters) return 0;
    base: int = tx_ch_verses[text_or_current(TEXT_BSB)][c];
    if (refs_last[c] > base) refs_last[c] else base
}

// refs.txt (its first n bytes in b): BOOK, chapter and verse a line, by
// the BSB's book codes.
refs_read(b: []i8, n: int) {
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && b[e] as int != 10) e = e + 1;
        if (e - p > 5 && b[p + 3] as int == 9) {
            bk: int = -1;
            for x in 0..books {
                same: bool = true;
                for i in 0..3
                    if (book_codes[x][i] != b[p + i]) same = false;
                if (same) bk = x
            }
            q: int = p + 4;
            cn: int = 0;
            while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
                cn = cn * 10 + b[q] as int - 48;
                q = q + 1
            }
            q = q + 1;
            vn: int = 0;
            while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
                vn = vn * 10 + b[q] as int - 48;
                q = q + 1
            }
            if (bk >= 0 && cn >= 1 && cn <= book_count[bk]) refs_last[book_first[bk] + cn - 1] = vn
        }
        p = e + 1
    }
}

// Where the line at p of data's first size bytes ends (its newline, or
// the end).
record_line_end(data: []i8, size: int, p: int): int {
    e: int = p;
    while (e < size && data[e] as int != 10) e = e + 1;
    e
}

// Where each line of the first n bytes of b starts, and where the last
// ends after them (as many places as lines, and one).
line_places(b: []i8, n: int): []int@new {
    lines: int = 0;
    for i in 0..n
        if (b[i] as int == 10) lines = lines + 1;
    at: []int = new int[lines + 1](0);
    _n: int = line_starts(b, n, at);
    at
}

// The lines of the first n bytes of b: where each starts, into at (and
// where the last ends after them); how many.
line_starts(b: []i8, n: int, at: []int): int {
    k: int = 0;
    start: int = 0;
    for i in 0..n {
        if (b[i] as int == 10 && k + 1 < len(at)) {
            at[k] = start;
            k = k + 1;
            start = i + 1
        }
    }
    at[k] = n;
    k
}

// A verse's key at p (its V line's number, or the number after > in
// V15>14).
record_key_at(data: []i8, size: int, p: int): int {
    n: int = record_number_at(data, size, p);
    i: int = p;
    while (i < size && data[i] as int >= 48 && data[i] as int <= 57) i = i + 1;
    if (i < size && data[i] as int == 62) record_number_at(data, size, i + 1) else n
}

// The highest number shown for the verse keyed k in chapter c (k itself,
// but for the ESV's merged verses: 3 John 1:14 is shown as 14 and 15).
verse_shown_last(c: int, k: int): int {
    borrow texts[text_cur] as source {
        source_verse_shown_last(source, c, k)
    }
}

source_verse_shown_last(source: *TextData, c: int, k: int): int {
    best: int = k;
    if (c < 0 || c >= chapters || source.starts[c] < 0) return best;
    p: int = source.starts[c];
    while (p < source.ends[c]) {
        e: int = record_line_end(source.data, source.size, p);
        if (source.data[p] as int == 86 && record_key_at(source.data, source.size,
            p + 1) == k && record_number_at(source.data, source.size, p + 1) > best) best = record_number_at(source.data,
            source.size, p + 1);
        p = e + 1
    }
    best
}

// The number at p, up to the line's end.
record_number_at(data: []i8, size: int, p: int): int {
    n: int = 0;
    i: int = p;
    while (i < size && data[i] as int >= 48 && data[i] as int <= 57) {
        n = n * 10 + data[i] as int - 48;
        i = i + 1
    }
    n
}

// Where each chapter's records are in text's (from after its C line to
// the next C or B line), and how many verses each has (into its version's
// tx_ch_verses); the original's words counted by chapter too.
text_index(text: *TextData) {
    verses: []int = tx_ch_verses[text.version];
    for c in 0..chapters verses[c] = 0;
    data: []i8 = text.data;
    n: int = text.size;
    c: int = -1;
    p: int = 0;
    while (p < n) {
        e: int = record_line_end(data, n, p);
        k: int = data[p] as int;
        if ((k == 66 || k == 67) && c >= 0) text.ends[c] = p;
        if (k == 67 && c + 1 < chapters) {
            c = c + 1;
            text.starts[c] = e + 1;
            text.ends[c] = n
        }
        if (k == 86 && c >= 0) {
            v: int = record_key_at(data, n, p + 1);
            if (v > verses[c]) verses[c] = v
        }
        p = e + 1
    }
    if (text.version == TEXT_ORIG) og_index(text)
}

// Book b's name ("Genesis") and code ("GEN"): the same in every version
// (each one's B lines are these), so no text is read for them.
book_name(b: int): str {
    book_names_all[b]
}

book_code(b: int): str {
    book_codes[b]
}

// Byte x of book b's code.
book_code_byte(b: int, x: int): int {
    book_codes[b][x] as int
}

// ---- a chapter as runs ----
// Each run is text in out, in one style, in a paragraph of one kind.
STYLE_BODY: int = 0;

STYLE_VERSE: int = 1;

// A book's name, heading its first chapter.
STYLE_BOOK: int = 2;

// A chapter's number (but chapter 1's, STYLE_NUMERAL1).
STYLE_NUMERAL: int = 3;

STYLE_HEAD: int = 4;

STYLE_SUBHEAD: int = 5;

STYLE_REF: int = 6;

STYLE_TITLE: int = 7;

STYLE_MAJOR: int = 8;

STYLE_RANGE: int = 9;

STYLE_ACROSTIC: int = 10;

STYLE_NOTE: int = 11;

// The chapter's label over its number: the book's name in capitals (JOHN),
// or PSALM.
STYLE_BOOKLABEL: int = 12;

// The capitals after the first of LORD and GOD (the divine name, in the
// BSB's capitals), set as small capitals.
STYLE_CAPS: int = 13;

// The divider between chapters: one object replacement character (U+FFFC),
// which the platform draws as a short hairline.
STYLE_RULE: int = 14;

// Chapter 1's number, under its book's name (smaller than the others).
STYLE_NUMERAL1: int = 15;

// The words of Jesus (W records), and LORD within them: laid out as body
// and small capitals are, and colored when the reader asks (DESIGN.md §8.8).
STYLE_JESUS: int = 16;

STYLE_JESUS_CAPS: int = 17;

// A reference in a heading's passages (an R line): run_arg its start
// (xref_code), run_arg2 its end; the line's punctuation stays STYLE_REF.
STYLE_XREF: int = 18;

// Words the translators supplied (I records; J inside the words of Jesus),
// in italic as printed KJVs set them.
STYLE_SUPPLIED: int = 19;

STYLE_JESUS_SUPPLIED: int = 20;

// A passage's heading in a plan's day (DESIGN.md §16.2.1): "Genesis
// 12–14", a step larger than a section's, run_arg and run_arg2 its
// reference (as STYLE_XREF's), to preview.
STYLE_PASSAGE: int = 21;

// The Hebrew and Greek (§14.11.3): its words (their font the chapter's
// language's), a word glossed (a dotted underline), a psalm's title in it
// and a word glossed there, the faint ° after a Qere word, a paragraph's
// apparatus (its glosses, faint) and an entry in it (a link to the word's
// popover: run_arg the word plus one).
STYLE_ORIG: int = 22;

STYLE_ORIG_GL: int = 23;

STYLE_OTITLE: int = 24;

STYLE_OTITLE_GL: int = 25;

STYLE_QERE: int = 26;

STYLE_APPARATUS: int = 27;

STYLE_APP_ENTRY: int = 28;

STYLES: int = 29;

// Paragraph kinds: prose, poetry's two indents, a list's two, centered and
// to the right, and a verse on a line of its own; with a stanza's break
// before it, the kind plus KINDS; followed by its apparatus (the Hebrew and
// Greek's glosses), plus TIGHT.
PARA_PROSE: int = 0;

PARA_Q1: int = 1;

PARA_Q2: int = 2;

PARA_L1: int = 3;

PARA_L2: int = 4;

PARA_CENTER: int = 5;

PARA_RIGHT: int = 6;

PARA_VERSE: int = 7;

KINDS: int = 8;

TIGHT: int = 16;

// What the layout shows: verses' numbers, headings (S s R D M m),
// footnotes' marks, and each verse on a line of its own.
lay_verse_numbers: bool = true;

lay_headings: bool = true;

lay_notes: bool = true;

lay_verse_lines: bool = false;

// How long the divine name at i is (LORD or GOD as a word of its own, or
// before 'S), or 0 if it is not there.
record_divine_at(data: []i8, i: int, e: int): int {
    if (i > 0 && is_letter(data[i - 1] as int)) return 0;
    n: int = 0;
    if (record_matches_at(data, i, e, "LORD")) n = 4 else if (record_matches_at(data,
        i, e, "GOD")) n = 3;
    if (n == 0 || i + n < e && is_letter(data[i + n] as int)) return 0;
    n
}

record_matches_at(
    data: []i8,
    i: int,
    e: int,
    word: str
): bool {
    if (i + len(word) > e) return false;
    for k in 0..len(word)
        if (data[i + k] != word[k]) return false;
    true
}

is_letter(k: int): bool {
    k >= 65 && k <= 90 || k >= 97 && k <= 122
}

// The byte at b[i], 0 to 255.
ub(b: []i8, i: int): int {
    b[i] as int & 255
}

is_digit(k: int): bool {
    k >= 48 && k <= 57
}

is_heading_line(k: int): bool {
    k == 83 || k == 115 || k == 82 || k == 68 || k == 77 || k == 109
}

// ---- the Hebrew and Greek (DESIGN.md §14.11) ----
// The text's companion, a dataset of its own (OrigWords): its words
// (orig-words.bin, 12 bytes a word, in reading order: tools/orig.py), the
// Ketiv of its Qere (orig-ketiv.txt: WORD<TAB>QERE<TAB>KETIV a line, by
// word) and its cantillated forms (orig-accents.txt, a line a Hebrew word,
// read only for Show Accents). Made when its files and the text have come
// (orig_complete), and replaced whole when they come again. Each chapter's
// first word (og_ch_first) is counted as the text is read; og_n is how many
// words there are.
type OrigWords = {
    words: []i8;
    ketiv: []i8;
    ketiv_size: int;
    // Where each of the Ketiv's lines begins (and the last ends).
    ketiv_at: []int;
    ketiv_lines: int;
    accents: []i8;
    accents_size: int;
    // Where each Hebrew chapter's first word's line is in accents (-1:
    // none).
    accents_chapter: []int;
    // How many of its files have come.
    files_come: int
}

ORIG_FILES: int = 3;

// The words (none until they and the text have come), the files coming,
// and the text, waiting for them.
orig_words: ?owned *OrigWords = orig_words_empty();

orig_coming: ?owned *OrigWords = null;

orig_text_coming: ?owned *DataFile = null;

og_n: int = 0;

og_ch_first: []int = new int[1189](0);

lay_accents: bool = false;

orig_words_empty(): owned *OrigWords {
    own {
        none: []i8 = new i8[1](0i8);
        new OrigWords {
            words: none,
            ketiv: none,
            ketiv_size: 0,
            ketiv_at: new int[1](0),
            ketiv_lines: 0,
            accents: none,
            accents_size: 0,
            accents_chapter: new int[chapters](-1),
            files_come: 0
        }
    }
}

// The words coming, made (empty) if none are.
orig_coming_ensure() {
    if (orig_coming != null) return;
    // (It is empty: dropping it lets nothing go, but says so.)
    drop orig_coming;
    orig_coming = orig_words_empty()
}

// One of its files came (HS_ORIG_*'s order: 0 the words, 1 the Ketiv, 2
// the accents): its first n bytes, read by the host into its arena (read:
// file id's bytes into the buffer given).
orig_file_read(
    k: int,
    id: int,
    n: int,
    read: fn(id: int, out: []i8)
) {
    orig_coming_ensure();
    borrow orig_coming as coming {
        allocate coming {
            buf: []i8 = new i8[(if (n < 0) 0 else n) + 1](0i8);
            if (n > 0) read(id, buf);
            orig_file_set(coming, k, buf, if (n < 0) 0 else n)
        }
    }
}

orig_file_set(
    od: *OrigWords@new,
    k: int,
    buf: []i8@od,
    n: int
) {
    if (k == 0) od.words = buf else if (k == 1) {
        od.ketiv = buf;
        od.ketiv_size = n;
        od.ketiv_at = line_places(buf, n);
        od.ketiv_lines = len(od.ketiv_at) - 1
    } else {
        od.accents = buf;
        od.accents_size = n
    }
    od.files_come = od.files_come + 1
}

// Whether its files and the text have all come.
orig_whole(): bool {
    if (orig_coming == null || orig_text_coming == null) return false;
    whole: bool = false;
    borrow orig_coming as coming {
        whole = coming.files_come >= ORIG_FILES
    }
    whole
}

// Its files and the text all come: the words in place of those before
// (let go), then the text read (each chapter's first word counted), then
// where each Hebrew chapter's accents begin.
orig_complete() {
    if (!orig_whole()) return;
    drop orig_words;
    orig_words = move orig_coming;
    borrow orig_words as od {
        og_n = len(od.words) / 12
    }
    borrow orig_text_coming as file {
        text_came(TEXT_ORIG, file.bytes, file.size)
    }
    drop orig_text_coming;
    borrow orig_words as od {
        allocate od {
            od.accents_chapter = og_acc_index(od)
        }
    }
}

// Whether the cantillated forms have come.
og_accents_here(): bool {
    borrow orig_words as od {
        od.accents_size > 0
    }
}

og_strongs(w: int): int {
    borrow orig_words as od {
        (od.words[w * 12] as int & 255 | (od.words[w * 12 + 1] as int & 255) << 8) & 32767
    }
}

og_greek(w: int): bool {
    borrow orig_words as od {
        (od.words[w * 12 + 1] as int & 128) != 0
    }
}

og_morph(w: int): int {
    borrow orig_words as od {
        od.words[w * 12 + 2] as int & 255 | (od.words[w * 12 + 3] as int & 255) << 8
    }
}

og_sense(w: int): int {
    borrow orig_words as od {
        od.words[w * 12 + 4] as int & 255
    }
}

// 1 a name, 2 Aramaic, 4 Qere, 8 joined by maqaf to the next.
OG_NAME: int = 1;

OG_ARAMAIC: int = 2;

OG_QERE: int = 4;

OG_MAQAF: int = 8;

og_flags(w: int): int {
    borrow orig_words as od {
        od.words[w * 12 + 5] as int & 255
    }
}

// Its length in the text's bytes (its punctuation, and a maqaf after it).
og_len(w: int): int {
    borrow orig_words as od {
        od.words[w * 12 + 6] as int & 255 | (od.words[w * 12 + 7] as int & 255) << 8
    }
}

// The same word in words.bin (-1: the BSB's tables have none).
og_join(w: int): int {
    n: int = 0;
    borrow orig_words as od {
        b: []i8 = od.words;
        n = b[w * 12 + 8] as int & 255 | (b[w * 12 + 9] as int & 255) << 8 | (b[w * 12 + 10] as int & 255) << 16 | (b[w * 12 + 11] as int & 255) << 24
    }
    if (n == 4294967295) -1 else n
}

// Whether a record of kind k holds the original's words (H Hebrew, X
// Aramaic, T Greek, D a psalm's title).
og_words_line(k: int): bool {
    k == 72 || k == 88 || k == 84 || k == 68
}

// How many words the records from p to e hold (by their lengths, from word
// w).
record_og_count(
    data: []i8,
    p: int,
    e: int,
    w: int
): int {
    n: int = 0;
    q: int = p;
    while (q < e) {
        if (data[q] as int == 32) q = q + 1 else {
            if (w + n >= og_n) return n;
            q = q + og_len(w + n);
            n = n + 1
        }
    }
    n
}

// Each chapter's first word (text the Hebrew and Greek's).
og_index(text: *TextData) {
    w: int = 0;
    for c in 0..chapters {
        og_ch_first[c] = w;
        p: int = text.starts[c];
        while (p < text.ends[c]) {
            e: int = record_line_end(text.data, text.size, p);
            if (og_words_line(text.data[p] as int)) w = w + record_og_count(text.data,
                p + 1, e, w);
            p = e + 1
        }
    }
}

// Where each Hebrew chapter's first word's line is in od's accents (the
// Hebrew's words are the text's first, so a word's line is its number):
// made once the text has counted each chapter's first word.
og_acc_index(od: *OrigWords): []int@new {
    at: []int = new int[chapters](-1);
    acc: []i8 = od.accents;
    n: int = od.accents_size;
    line: int = 0;
    c: int = 0;
    p: int = 0;
    while (c < chapters && c < 929 && og_ch_first[c] == 0 && c > 0) c = c + 1;
    while (p < n && c < chapters) {
        while (c < chapters && og_ch_first[c] == line) {
            at[c] = p;
            c = c + 1
        }
        while (p < n && acc[p] as int != 10) p = p + 1;
        p = p + 1;
        line = line + 1
    }
    at
}

// What the layout of the original makes besides runs: each word's letters
// in out (ow_b to ow_e, the word ow_w), for a word picked or read aloud.
OW_MOST: int = 4096;

// The glosses (given by the platform for chapter og_gl_c, from its first
// word og_gl_first): whether each word is glossed (og_gl), and its gloss
// (og_gt from og_gt_b to og_gt_e), a lemma's key to list it once a
// paragraph (og_gk).
og_gl_c: int = -1;

og_gl_first: int = 0;

og_gl_n: int = 0;

og_gl: []bool = new bool[OW_MOST](false);

og_gk: []int = new int[OW_MOST](0);

// Each word's neighbours whose English is its own too (orig.l8's
// og_shares_before and _after): 1 the one before, 2 the one after.
og_sh: []int = new int[OW_MOST](0);

og_gt: []i8 = new i8[131072](0i8);

og_gt_n: int = 0;

og_gt_b: []int = new int[OW_MOST](0);

og_gt_e: []int = new int[OW_MOST](0);

og_glossed(w: int): bool {
    i: int = w - og_gl_first;
    og_gl_c >= 0 && i >= 0 && i < og_gl_n && og_gl[i]
}

// Where word w's text begins in source's records (the original's), or
// -1: found from its chapter's records.
og_text_c: int = -1;

og_text_at(source: *TextData, w: int): int {
    c: int = og_chapter_of(w);
    if (c < 0) return -1;
    k: int = og_ch_first[c];
    p: int = source.starts[c];
    while (p < source.ends[c]) {
        e: int = record_line_end(source.data, source.size, p);
        if (og_words_line(source.data[p] as int)) {
            q: int = p + 1;
            while (q < e) {
                if (source.data[q] as int == 32) q = q + 1 else {
                    if (k == w) return q;
                    q = q + og_len(k);
                    k = k + 1
                }
            }
        }
        p = e + 1
    }
    -1
}

// The chapter word w is in (-1: none).
og_chapter_of(w: int): int {
    lo: int = 0;
    hi: int = chapters;
    while (lo + 1 < hi) {
        mid: int = (lo + hi) / 2;
        if (og_ch_first[mid] <= w) lo = mid else hi = mid
    }
    if (w < 0 || w >= og_n) -1 else lo
}

// The end of a word's letters at p to e: before its punctuation (, . · ;
// sof pasuq, a maqaf).
letters_end_of(b: []i8, p: int, e: int): int {
    x: int = e;
    more: bool = true;
    while (more && x > p) {
        k: int = b[x - 1] as int & 255;
        j: int = if (x - 2 >= p) b[x - 2] as int & 255 else 0;
        if (k == 44 || k == 46 || k == 59 || k == 58 || k == 33 || k == 63) x = x - 1 else if (j == 215 && k == 131 || j == 214 && k == 190 || j == 206 && k == 135 || j == 194 && k == 183 || j == 205 && k == 190) x = x - 2 else more = false
    }
    x
}

// Where verse v of chapter c (the first keyed v or after) begins, with the
// headings and paragraph before it: the first record after the last
// verse's words; the chapter's end if it has none.
verse_block(c: int, v: int): int {
    borrow texts[text_cur] as source {
        source_verse_block(source, c, v)
    }
}

source_verse_block(source: *TextData, c: int, v: int): int {
    p: int = source.starts[c];
    blk: int = -1;
    while (p < source.ends[c]) {
        k: int = source.data[p] as int;
        if (k == 86) {
            if (record_key_at(source.data, source.size, p + 1) >= v) return if (blk >= 0) blk else p;
            blk = -1
        } else if (k == 84 || k == 87 || k == 73 || k == 74 || k == 70 || k == 100) blk = -1 else if (blk < 0) blk = p;
        p = record_line_end(source.data, source.size, p) + 1
    }
    source.ends[c]
}

// The chapter of book b numbered n (or its first or last, past either end).
chapter_of(b: int, n: int): int {
    if (n < 1) return book_first[b];
    if (n > book_count[b]) return book_first[b] + book_count[b] - 1;
    book_first[b] + n - 1
}

// ---- verses as plain text ----
// The verse a record of a chapter is in (its V line before p; 0 before
// the first).
verse_at(source: *TextData, c: int, p: int): int {
    v: int = 0;
    q: int = source.starts[c];
    while (q < p && q < source.ends[c]) {
        e: int = record_line_end(source.data, source.size, q);
        if (source.data[q] as int == 86) v = record_key_at(source.data, source.size,
            q + 1);
        q = e + 1
    }
    v
}

// A verse's words, without its notes: its lines joined (with a space where
// a line of poetry or a paragraph broke them).
vt: []i8 = new i8[16384](0i8);

vt_n: int = 0;

vt_add(k: int) {
    if (vt_n < len(vt)) {
        vt[vt_n] = k trunc i8;
        vt_n = vt_n + 1
    }
}

// Verse v of chapter c into vt: how long it is.
verse_text(c: int, v: int): int {
    borrow texts[text_cur] as source {
        source_verse_text(source, c, v)
    }
}

// Verse v of chapter c into vt, from text t, without switching versions.
// An unavailable version has no words; never quote the current one instead.
verse_text_of(t: int, c: int, v: int): int {
    vt_n = 0;
    if (t < 0 || t > TEXT_PIN) return 0;
    if (!text_ready(t)) return 0;
    borrow texts[t] as source {
        source_verse_text(source, c, v)
    }
}

// Verse words into vt, using an explicit source. Like verse_text, this
// replaces vt only; it leaves the current version and layout untouched.
source_verse_text(source: *TextData, c: int, v: int): int {
    vt_n = 0;
    if (c < 0 || c >= chapters || source.starts[c] < 0 || v <= 0) return 0;
    p: int = source.starts[c];
    e_ch: int = source.ends[c];
    inside: bool = false;
    broke: bool = false;
    while (p < e_ch) {
        e: int = record_line_end(source.data, source.size, p);
        k: int = source.data[p] as int;
        if (k == 86) {
            n: int = record_key_at(source.data, source.size, p + 1);
            if (inside && n != v) {
                // The verse after it: done (a verse keyed alike goes on).
                e = e_ch;
                inside = false
            } else if (n == v) {
                if (inside) broke = true;
                inside = true
            }
        } else if (inside) {
            if (is_words(k)) {
                vt_words_from(source.data, p + 1, e, broke);
                broke = false
            } else if (k != 70) broke = true
        }
        p = e + 1
    }
    vt_n
}

// ---- letters folded (DESIGN.md §14.11.5, §14.11.7) ----
// A Greek or Hebrew letter as compared: its base letter, lower case, with
// no accent, breathing, iota subscript or point (those are marks of their
// own here: is_mark), a final form as the letter (ς σ, ך כ, ם מ, ן נ, ף
// פ, ץ צ); any other code point itself.
letter_fold(cp: int): int {
    if (cp >= 913 && cp <= 937) return if (cp == 930) 963 else cp + 32;
    if (cp == 962) return 963;
    if (cp >= 940 && cp <= 974) {
        if (cp == 940) return 945;
        if (cp == 941) return 949;
        if (cp == 942) return 951;
        if (cp == 943 || cp == 970) return 953;
        if (cp == 944 || cp == 971 || cp == 973) return 965;
        if (cp == 972) return 959;
        if (cp == 974) return 969;
        return cp
    }
    if (cp == 902) return 945;
    if (cp == 904) return 949;
    if (cp == 905) return 951;
    if (cp == 906 || cp == 912) return 953;
    if (cp == 908) return 959;
    if (cp == 910) return 965;
    if (cp == 911) return 969;
    if (cp >= 7936 && cp <= 8191) return greek_ext_fold(cp - 7936);
    // (Hebrew's final forms.)
    if (cp == 1498) return 1499;
    if (cp == 1501) return 1502;
    if (cp == 1503) return 1504;
    if (cp == 1507) return 1508;
    if (cp == 1509) return 1510;
    cp
}

// Greek Extended (U+1F00 on, its offset x): each block's base letter.
greek_ext_fold(x: int): int {
    if (x < 16) return 945;
    if (x < 32) return 949;
    if (x < 48) return 951;
    if (x < 64) return 953;
    if (x < 80) return 959;
    if (x < 96) return 965;
    if (x < 112) return 969;
    if (x < 126) return greek_ext_pair(x - 112);
    if (x < 144) return 945;
    if (x < 160) return 951;
    if (x < 176) return 969;
    if (x < 189) return 945;
    if (x < 194) return 7936 + x;
    if (x < 200) return 951;
    if (x < 202) return 949;
    if (x < 205) return 951;
    if (x < 208) return 7936 + x;
    if (x < 220) return 953;
    if (x < 224) return 7936 + x;
    if (x == 228 || x == 229 || x == 236) return 961;
    if (x < 237) return 965;
    if (x < 242) return 7936 + x;
    if (x < 248) return 969;
    if (x < 250) return 959;
    if (x < 253) return 969;
    7936 + x
}

// U+1F70 to U+1F7D: ὰ ά ὲ έ ὴ ή ὶ ί ὸ ό ὺ ύ ὼ ώ.
greek_ext_pair(x: int): int {
    if (x < 2) 945 else if (x < 4) 949 else if (x < 6) 951 else if (x < 8) 953 else if (x < 10) 959 else if (x < 12) 965 else 969
}

// Whether a code point is a mark on a letter: combining accents and
// breathings (U+0300 to U+036F), Hebrew's points and accents (U+0591 to
// U+05C7, but maqaf, paseq, sof pasuq and nun hafukha), or Greek's
// spacing breathings and accents.
is_mark(cp: int): bool {
    if (cp >= 768 && cp <= 879) return true;
    if (cp >= 1425 && cp <= 1479) return cp != 1470 && cp != 1472 && cp != 1475 && cp != 1478;
    cp == 8125 || cp == 8127 || cp == 8128 || cp == 8129 || cp >= 8141 && cp <= 8143 || cp >= 8157 && cp <= 8159 || cp >= 8173 && cp <= 8175 || cp == 8189 || cp == 8190
}

// Whether a code point is a Greek or Hebrew letter.
is_orig_letter(cp: int): bool {
    cp >= 913 && cp <= 1023 || cp == 902 || cp >= 904 && cp <= 911 || cp >= 1488 && cp <= 1514 || cp >= 7936 && cp <= 8188 && !is_mark(cp)
}

// The code point at b[p] (UTF-8), its length in cp_n.
cp_n: int = 1;

utf8_at(b: []i8, p: int, e: int): int {
    k: int = b[p] as int & 255;
    cp_n = 1;
    if (k < 128) return k;
    if (k < 224 && p + 1 < e) {
        cp_n = 2;
        return (k & 31) * 64 + (b[p + 1] as int & 63)
    }
    if (k < 240 && p + 2 < e) {
        cp_n = 3;
        return (k & 15) * 4096 + (b[p + 1] as int & 63) * 64 + (b[p + 2] as int & 63)
    }
    if (p + 3 < e) {
        cp_n = 4;
        return (k & 7) * 262144 + (b[p + 1] as int & 63) * 4096 + (b[p + 2] as int & 63) * 64 + (b[p + 3] as int & 63)
    }
    k
}

// Whether a record of kind k is words (T W I J; the original's H and X).
is_words(k: int): bool {
    k == 84 || k == 87 || k == 73 || k == 74 || k == 72 || k == 88
}

// A T line's words onto vt (after a space, if a line broke before them).
vt_words_from(
    data: []i8,
    p: int,
    e: int,
    broke: bool
) {
    if (broke && vt_n > 0 && vt[vt_n - 1] as int != 32 && p < e && data[p] as int != 32) vt_add(32);
    for i in p..e vt_add(data[i] as int)
}

// ---- references: "jn 3:16" ----
// The books' names and short names: a line each, in the books' order, the
// first its full name (lower case, no spaces), the rest what else it may be
// called.
aliases: str = """
genesis gen gn ge
exodus exo ex exod
leviticus lev lv le
numbers num nm nu nb
deuteronomy deut deu dt de
joshua josh jos js
judges judg jdg jg jgs
ruth rut ru rth
1samuel 1sam 1sa 1sm 1s
2samuel 2sam 2sa 2sm 2s
1kings 1kgs 1ki 1kg 1k
2kings 2kgs 2ki 2kg 2k
1chronicles 1chr 1ch 1chron
2chronicles 2chr 2ch 2chron
ezra ezr
nehemiah neh ne
esther est esth es
job jb
psalms psalm psa ps pss
proverbs prov pro prv pr
ecclesiastes eccl ecc ec qoh
songofsolomon songofsongs song sos sng ss canticles
isaiah isa is
jeremiah jer je jr
lamentations lam la
ezekiel ezek ezk eze
daniel dan da dn
hosea hos ho
joel joe jl jol
amos amo am
obadiah obad oba ob
jonah jon jnh
micah mic mi
nahum nah nam na
habakkuk hab hb
zephaniah zeph zep zp
haggai hag hg
zechariah zech zec zc
malachi mal ml
matthew matt mat mt
mark mrk mk mr
luke luk lk
john jhn jn joh
acts act ac
romans rom ro rm
1corinthians 1cor 1co
2corinthians 2cor 2co
galatians gal ga
ephesians eph ep
philippians phil php pp
colossians col
1thessalonians 1thess 1thes 1th
2thessalonians 2thess 2thes 2th
1timothy 1tim 1ti 1tm
2timothy 2tim 2ti 2tm
titus tit ti
philemon philem phm pm
hebrews heb he
james jas jm
1peter 1pet 1pe 1pt
2peter 2pet 2pe 2pt
1john 1jn 1jo 1jhn 1joh
2john 2jn 2jo 2jhn 2joh
3john 3jn 3jo 3jhn 3joh
jude jd
revelation rev re rv revelations
""";

// Where each book's line of aliases starts (made once).
alias_line: []int = new int[67](0);

alias_ready: bool = false;

alias_index() {
    if (alias_ready) return;
    alias_ready = true;
    b: int = 0;
    alias_line[0] = 0;
    for i in 0..len(aliases) {
        if (aliases[i] as int == 10 && b < 66) {
            b = b + 1;
            alias_line[b] = i + 1
        }
    }
}

// What parse_ref found: the book (an index), chapter, verse and last verse
// (numbers; -1 where not given).
ref_book: int = -1;

ref_chapter: int = -1;

ref_verse: int = -1;

ref_verse_end: int = -1;

// Where the book's name ended in rq (the numbers after it: parse_range).
ref_name_end: int = 0;

// The text being parsed, made plain: lower case, single spaces.
rq: []i8 = new i8[256](0i8);

rq_n: int = 0;

rq_add(k: int) {
    if (rq_n < len(rq)) {
        rq[rq_n] = k trunc i8;
        rq_n = rq_n + 1
    }
}

// The book's name as typed (no spaces).
rname: []i8 = new i8[64](0i8);

rname_n: int = 0;

// s's first n bytes as plain text in rq: lower case; periods as spaces; a
// dash of any length as -; spaces single, and none at either end.
ref_plain(s: []i8, n: int) {
    rq_n = 0;
    i: int = 0;
    while (i < n) {
        k: int = ub(s, i);
        if (k == 226 && i + 2 < n && ub(s, i + 1) == 128 && (ub(s, i + 2) == 147 || ub(s,
            i + 2) == 148)) {
            k = 45;
            i = i + 2
        }
        if (k >= 65 && k <= 90) k = k + 32;
        if (k == 46 || k == 44 || k == 9) k = 32;
        if (k == 32) {
            if (rq_n > 0 && rq[rq_n - 1] as int != 32) rq_add(32)
        } else rq_add(k);
        i = i + 1
    }
    if (rq_n > 0 && rq[rq_n - 1] as int == 32) rq_n = rq_n - 1
}

// Whether rq begins with word (then a space).
rq_starts(word: str): bool {
    if (rq_n <= len(word)) return false;
    for i in 0..len(word)
        if (rq[i] != word[i]) return false;
    rq[len(word)] as int == 32
}

// Whether the alias at aliases[a] (to a space or newline) is rname.
alias_is(a: int): bool {
    for i in 0..rname_n
        if (a + i >= len(aliases) || aliases[a + i] != rname[i]) return false;
    k: int = if (a + rname_n < len(aliases)) aliases[a + rname_n] as int else 10;
    k == 32 || k == 10
}

// Whether rname begins the alias at aliases[a].
alias_begins(a: int): bool {
    for i in 0..rname_n {
        if (a + i >= len(aliases)) return false;
        k: int = aliases[a + i] as int;
        if (k == 32 || k == 10 || k != rname[i] as int) return false
    }
    true
}

// The book rname names: an alias of it exactly, or else the first book whose
// full name begins with it (-1 if none).
book_named(): int {
    alias_index();
    if (rname_n == 0) return -1;
    b: int = 0;
    at_word: bool = true;
    for a in 0..len(aliases) {
        if (at_word && alias_is(a)) return b;
        k: int = aliases[a] as int;
        if (k == 10) b = b + 1;
        at_word = k == 32 || k == 10
    }
    for x in 0..66
        if (alias_begins(alias_line[x])) return x;
    -1
}

// Whether book b's name, or one of its short names, begins with the first n
// bytes of s (case and spaces aside): "1 c" is 1 Chronicles and 1
// Corinthians.
book_begins(b: int, s: []i8, n: int): bool {
    alias_index();
    rname_n = 0;
    for i in 0..n {
        k: int = s[i] as int;
        if (k >= 65 && k <= 90) k = k + 32;
        if (k != 32 && k != 46 && rname_n < len(rname)) {
            rname[rname_n] = k trunc i8;
            rname_n = rname_n + 1
        }
    }
    if (rname_n == 0) return false;
    alias_begins(alias_line[b]) || book_alias_exact(b)
}

// Whether rname (as book_begins left it) is one of book b's short names
// exactly.
book_alias_exact(b: int): bool {
    a: int = alias_line[b];
    e: int = if (b == 65) len(aliases) else alias_line[b + 1];
    at_word: bool = true;
    while (a < e) {
        if (at_word && alias_is(a)) return true;
        k: int = aliases[a] as int;
        at_word = k == 32;
        a = a + 1
    }
    false
}

// A short name for book b, for a narrow place (its first short name of
// six letters or fewer, as "1 Thess", "Song"), into short_name.
short_name: []i8 = new i8[16](0i8);

short_n: int = 0;

book_short(b: int) {
    alias_index();
    a: int = alias_line[b];
    e: int = if (b == 65) len(aliases) else alias_line[b + 1];
    // (Past the full name.)
    while (a < e && aliases[a] as int != 32) a = a + 1;
    short_n = 0;
    while (a < e && short_n == 0) {
        a = a + 1;
        w: int = a;
        while (w < e && aliases[w] as int != 32 && aliases[w] as int != 10) w = w + 1;
        if (w - a <= 6 && w > a) {
            for i in a..w {
                k: int = aliases[i] as int;
                first: bool = i == a || i == a + 1 && is_digit(aliases[a] as int);
                if (i == a + 1 && is_digit(aliases[a] as int)) {
                    short_name[short_n] = 32i8;
                    short_n = short_n + 1
                }
                short_name[short_n] = (if (first && k >= 97) k - 32 else k) trunc i8;
                short_n = short_n + 1
            }
        }
        a = w
    }
}

// A reference typed freely ("jn 3:16", "1 cor 13", "psa23", "gen 1:1-3"),
// the first n bytes of s: ref_book and the rest, and whether it named a
// book. A chapter past the book's end is its last; a verse past the
// chapter's, its last; a book of one chapter takes a lone number as a verse.
parse_ref(s: []i8, n: int): bool {
    ref_book = -1;
    ref_chapter = -1;
    ref_verse = -1;
    ref_verse_end = -1;
    ref_plain(s, n);
    i: int = 0;
    rname_n = 0;
    // "first", "ii" and so on before the book's name.
    lead: int = 0;
    if (rq_starts("first") || rq_starts("1st")) {
        lead = 1;
        i = (if (rq_starts("first")) 6 else 4)
    } else if (rq_starts("second") || rq_starts("2nd")) {
        lead = 2;
        i = (if (rq_starts("second")) 7 else 4)
    } else if (rq_starts("third") || rq_starts("3rd")) {
        lead = 3;
        i = (if (rq_starts("third")) 6 else 4)
    } else if (rq_starts("iii")) {
        lead = 3;
        i = 4
    } else if (rq_starts("ii")) {
        lead = 2;
        i = 3
    } else if (rq_starts("i")) {
        lead = 1;
        i = 2
    } else if (rq_n >= 2 && rq[0] as int >= 49 && rq[0] as int <= 51 && (is_letter(rq[1] as int) || rq_n >= 3 && rq[1] as int == 32 && is_letter(rq[2] as int))) {
        lead = rq[0] as int - 48;
        i = (if (rq[1] as int == 32) 2 else 1)
    }
    if (lead > 0) {
        rname[0] = (48 + lead) trunc i8;
        rname_n = 1
    }
    // The name: letters (and the spaces between its words), to a number.
    while (i < rq_n && (is_letter(rq[i] as int) || rq[i] as int == 32 && i + 1 < rq_n && is_letter(rq[i + 1] as int))) {
        if (rq[i] as int != 32 && rname_n < len(rname)) {
            rname[rname_n] = rq[i];
            rname_n = rname_n + 1
        }
        i = i + 1
    }
    if (rname_n == 0 || rname_n == 1 && lead > 0) return false;
    b: int = book_named();
    if (b < 0) return false;
    ref_book = b;
    ref_name_end = i;
    // Up to three numbers, and whether a dash came before each.
    nums: int = 0;
    n1: int = -1;
    n2: int = -1;
    n3: int = -1;
    dash2: bool = false;
    dash: bool = false;
    while (i < rq_n) {
        k: int = rq[i] as int;
        if (k == 45) dash = true;
        if (is_digit(k)) {
            v: int = 0;
            while (i < rq_n && is_digit(rq[i] as int)) {
                if (v < 100000) v = v * 10 + rq[i] as int - 48;
                i = i + 1
            }
            if (nums == 0) n1 = v else if (nums == 1) {
                n2 = v;
                dash2 = dash
            } else if (nums == 2) n3 = v;
            nums = nums + 1;
            dash = false
        } else i = i + 1
    }
    single: bool = book_count[b] == 1;
    if (nums == 0) return true;
    if (single && (nums == 1 || dash2)) {
        // A lone number in a book of one chapter is a verse (and a dash
        // after it, a range of verses).
        ref_chapter = 1;
        ref_verse = n1;
        if (dash2) ref_verse_end = n2
    } else {
        ref_chapter = n1;
        if (nums >= 2 && !dash2) {
            ref_verse = n2;
            if (nums >= 3) ref_verse_end = n3
        }
    }
    if (ref_chapter < 1) ref_chapter = 1;
    if (ref_chapter > book_count[b]) ref_chapter = book_count[b];
    if (ref_verse >= 0) {
        last: int = ch_verses[book_first[b] + ref_chapter - 1];
        if (ref_verse < 1) ref_verse = 1;
        if (ref_verse > last) ref_verse = last;
        if (ref_verse_end > last) ref_verse_end = last;
        if (ref_verse_end <= ref_verse) ref_verse_end = -1
    }
    true
}

// ---- a passage typed (DESIGN.md §13.2.2) ----
// "ps 23" (the chapter's verses: Psalm 23:1–6), "rom 8:28-39", "isa
// 52:13–53:12", "rom 8-9" (the chapters whole), "jn 3:16", "jude 3-5":
// its book's chapters and verses (the BSB's numbering), first to last,
// and how many verses. False if it names no verse or chapter, or ends
// before it begins. A chapter or verse past the book's or chapter's end is
// its last.
rg_c1: int = -1;

rg_v1: int = 0;

rg_c2: int = -1;

rg_v2: int = 0;

rg_verses: int = 0;

rg_nums: []int = new int[4](0);

rg_dash: []bool = new bool[4](false);

// Chapter c's verses in the BSB.
bsb_verses(c: int): int {
    tx_ch_verses[text_or_current(TEXT_BSB)][c]
}

parse_range(s: []i8, n: int): bool {
    rg_verses = 0;
    if (!parse_ref(s, n)) return false;
    b: int = ref_book;
    k: int = 0;
    dash: bool = false;
    i: int = ref_name_end;
    while (i < rq_n) {
        x: int = rq[i] as int;
        if (x == 45) dash = true;
        if (is_digit(x)) {
            v: int = 0;
            while (i < rq_n && is_digit(rq[i] as int)) {
                if (v < 100000) v = v * 10 + rq[i] as int - 48;
                i = i + 1
            }
            if (k < 4) {
                rg_nums[k] = v;
                rg_dash[k] = dash
            }
            k = k + 1;
            dash = false
        } else i = i + 1
    }
    if (k > 4) return false;
    single: bool = book_count[b] == 1;
    c1: int = 1;
    v1: int = 1;
    c2: int = 1;
    v2: int = 100000;
    if (k == 0) {
        if (!single) return false
    } else if (single && (k == 1 || k == 2 && rg_dash[1])) {
        v1 = rg_nums[0];
        v2 = (if (k == 2) rg_nums[1] else v1)
    } else if (k == 1) {
        c1 = rg_nums[0];
        c2 = c1
    } else if (k == 2 && rg_dash[1]) {
        c1 = rg_nums[0];
        c2 = rg_nums[1]
    } else if (k == 2) {
        c1 = rg_nums[0];
        c2 = c1;
        v1 = rg_nums[1];
        v2 = v1
    } else if (k == 3 && rg_dash[1] && !rg_dash[2]) {
        c1 = rg_nums[0];
        c2 = rg_nums[1];
        v2 = rg_nums[2]
    } else if (k == 3 && rg_dash[2] && !rg_dash[1]) {
        c1 = rg_nums[0];
        c2 = c1;
        v1 = rg_nums[1];
        v2 = rg_nums[2]
    } else if (k == 4 && rg_dash[2] && !rg_dash[1] && !rg_dash[3]) {
        c1 = rg_nums[0];
        v1 = rg_nums[1];
        c2 = rg_nums[2];
        v2 = rg_nums[3]
    } else return false;
    if (c1 < 1 || c2 < 1 || v1 < 1 || v2 < 1) return false;
    if (c1 > book_count[b]) c1 = book_count[b];
    if (c2 > book_count[b]) c2 = book_count[b];
    rg_c1 = book_first[b] + c1 - 1;
    rg_c2 = book_first[b] + c2 - 1;
    if (v1 > bsb_verses(rg_c1)) v1 = bsb_verses(rg_c1);
    if (v2 > bsb_verses(rg_c2)) v2 = bsb_verses(rg_c2);
    rg_v1 = v1;
    rg_v2 = v2;
    if (rg_c2 < rg_c1 || rg_c2 == rg_c1 && v2 < v1) return false;
    rg_verses = range_verses(rg_c1, v1, rg_c2, v2);
    true
}

// How many verses from c1:v1 to c2:v2 (the BSB's numbering).
range_verses(
    c1: int,
    v1: int,
    c2: int,
    v2: int
): int {
    if (c1 == c2) return v2 - v1 + 1;
    n: int = bsb_verses(c1) - v1 + 1 + v2;
    for c in c1 + 1..c2 n = n + bsb_verses(c);
    n
}

// ---- search ----
// The words searched for (lower case, ’ as '), each with whether it may be
// the start of a longer word (typed with * after it); and whether they are a
// phrase (typed in quotes), to be found together and in order.
sq: []i8 = new i8[512](0i8);

sq_n: int = 0;

sq_words: int = 0;

sq_start: []int = new int[16](0);

sq_len: []int = new int[16](0);

sq_prefix: []bool = new bool[16](false);

sq_phrase: bool = false;

// The verses found (chapter and verse), as many as fit, and whether there
// were more.
hit_chapter: []int = new int[1000](0);

hit_verse: []int = new int[1000](0);

hit_count: int = 0;

hit_more: bool = false;

// The words of the first n bytes of s, to search for.
search_words(s: []i8, n: int) {
    sq_n = 0;
    sq_words = 0;
    sq_phrase = false;
    i: int = 0;
    in_word: bool = false;
    while (i < n) {
        k: int = ub(s, i);
        step: int = 1;
        if (k == 226 && i + 2 < n && ub(s, i + 1) == 128) {
            m: int = ub(s, i + 2);
            step = 3;
            k = (if (m == 152 || m == 153) 39 else if (m == 156 || m == 157) 34 else 32)
        }
        if (k == 34) sq_phrase = true;
        if (k >= 65 && k <= 90) k = k + 32;
        word: bool = is_letter(k) || is_digit(k) || k == 39 || k >= 128;
        if (word) {
            if (!in_word && sq_words < len(sq_start) && sq_n < len(sq)) {
                sq_start[sq_words] = sq_n;
                sq_len[sq_words] = 0;
                sq_prefix[sq_words] = false;
                sq_words = sq_words + 1;
                in_word = true
            }
            if (in_word && sq_n < len(sq)) {
                sq[sq_n] = k trunc i8;
                sq_n = sq_n + 1;
                sq_len[sq_words - 1] = sq_len[sq_words - 1] + 1
            }
        } else {
            if (k == 42 && in_word) sq_prefix[sq_words - 1] = true;
            in_word = false
        }
        i = i + step
    }
    // (A word of apostrophes alone is none.)
    if (sq_words == 1 && sq_phrase) sq_phrase = false
}

// Whether the byte at vt[i] begins a character of a word (a letter or a
// digit; not punctuation, as ’ and “).
vt_wordy(i: int): bool {
    if (i < 0 || i >= vt_n) return false;
    k: int = ub(vt, i);
    if (k < 128) return is_letter(k) || is_digit(k);
    if (k >= 128 && k < 192) {
        // (Part of a character: the character it is part of.)
        j: int = i;
        while (j > 0 && ub(vt, j) >= 128 && ub(vt, j) < 192) j = j - 1;
        return vt_wordy(j) && j != i
    }
    k != 226
}

// Whether the character before vt[i] is of a word.
vt_wordy_before(i: int): bool {
    if (i <= 0) return false;
    j: int = i - 1;
    while (j > 0 && ub(vt, j) >= 128 && ub(vt, j) < 192) j = j - 1;
    vt_wordy(j)
}

// Search word w at vt[i]: where it ends in vt, or -1 if it is not there (a
// whole word, unless it may begin one).
word_at(w: int, i: int): int {
    if (vt_wordy_before(i)) return -1;
    j: int = i;
    s: int = sq_start[w];
    for x in 0..sq_len[w] {
        q: int = sq[s + x] as int;
        if (j >= vt_n) return -1;
        k: int = ub(vt, j);
        if (q == 39 && k == 226 && j + 2 < vt_n && ub(vt, j + 2) == 153) j = j + 3 else {
            if (k >= 65 && k <= 90) k = k + 32;
            if (k != q) return -1;
            j = j + 1
        }
    }
    if (!sq_prefix[w] && vt_wordy(j)) return -1;
    // (A word typed with * goes on to its end.)
    while (sq_prefix[w] && vt_wordy(j)) j = j + 1;
    j
}

// Past what is not a word, from vt[i]: where the next word begins.
skip_unwordy(i: int): int {
    j: int = i;
    while (j < vt_n && !vt_wordy(j)) j = j + 1;
    j
}

// The phrase at vt[i]: where it ends, or -1.
phrase_at(i: int): int {
    j: int = i;
    for w in 0..sq_words {
        if (w > 0) {
            k: int = skip_unwordy(j);
            if (k == j) return -1;
            j = k
        }
        j = word_at(w, j);
        if (j < 0) return -1
    }
    j
}

// Where the search (one word, or the phrase) is in vt at or after i: its
// start, or -1; and its end, in found_end.
found_end: int = 0;

find_from(w: int, i: int): int {
    for j in i..vt_n {
        e: int = if (sq_phrase) phrase_at(j) else word_at(w, j);
        if (e >= 0) {
            found_end = e;
            return j
        }
    }
    -1
}

// Whether the verse in vt is one the search finds.
vt_found(): bool {
    if (sq_words == 0) return false;
    if (sq_phrase) return find_from(0, 0) >= 0;
    for w in 0..sq_words
        if (find_from(w, 0) < 0) return false;
    true
}

// The verses of books from to last (inclusive) with every word of query (the
// first n bytes of q) in version source, in order: hit_chapter and the rest.
source_search(
    source: *TextData,
    q: []i8,
    n: int,
    from: int,
    last: int
) {
    hit_count = 0;
    hit_more = false;
    search_words(q, n);
    if (sq_words == 0) return;
    c: int = book_first[from];
    e_c: int = book_first[last] + book_count[last];
    while (c < e_c && !hit_more) {
        source_search_chapter(source, c);
        c = c + 1
    }
}

// The verses of chapter c the search finds, onto the hits.
source_search_chapter(source: *TextData, c: int) {
    data: []i8 = source.data;
    p: int = source.starts[c];
    e_ch: int = source.ends[c];
    v: int = 0;
    broke: bool = false;
    vt_n = 0;
    while (p < e_ch) {
        e: int = record_line_end(data, source.size, p);
        k: int = data[p] as int;
        if (k == 86 && record_key_at(data, source.size, p + 1) == v) broke = true else if (k == 86) {
            if (v > 0) search_verse(c, v);
            v = record_key_at(data, source.size, p + 1);
            vt_n = 0;
            broke = false
        } else if (is_words(k)) {
            vt_words_from(data, p + 1, e, broke);
            broke = false
        } else if (k != 70) broke = true;
        p = e + 1
    }
    if (v > 0) search_verse(c, v)
}

search_verse(c: int, v: int) {
    if (!vt_found()) return;
    if (hit_count >= len(hit_chapter)) {
        hit_more = true;
        return
    }
    hit_chapter[hit_count] = c;
    hit_verse[hit_count] = v;
    hit_count = hit_count + 1
}

// Where the search is found in verse v of chapter c: its text in vt
// (verse_text), and each place a word (or the phrase) is, in mr_begin and
// mr_end (bytes of vt), in order.
mr_count: int = 0;

mr_begin: []int = new int[64](0);

mr_end: []int = new int[64](0);

source_match_ranges(source: *TextData, c: int, v: int) {
    _n: int = source_verse_text(source, c, v);
    match_in_vt()
}

// The places the search is in vt (its words as they are now there).
match_in_vt() {
    mr_count = 0;
    words: int = if (sq_phrase) 1 else sq_words;
    for w in 0..words {
        i: int = 0;
        while (i >= 0 && i < vt_n) {
            j: int = find_from(w, i);
            if (j >= 0) {
                mr_add(j, found_end);
                i = found_end
            } else i = -1
        }
    }
}

// A place found, kept in order (and not twice).
mr_add(b: int, e: int) {
    if (mr_count >= len(mr_begin)) return;
    at: int = mr_count;
    while (at > 0 && mr_begin[at - 1] > b) at = at - 1;
    if (at > 0 && mr_begin[at - 1] == b) return;
    i: int = mr_count;
    while (i > at) {
        mr_begin[i] = mr_begin[i - 1];
        mr_end[i] = mr_end[i - 1];
        i = i - 1
    }
    mr_begin[at] = b;
    mr_end[at] = e;
    mr_count = mr_count + 1
}

// ---- references in headings, to preview (DESIGN.md §8.1) ----
// A reference as numbers: its start, book·2^24 | chapter·2^12 | verse (the
// chapter's number in its book; verse 0 for the chapter as a whole), and
// its end, chapter·2^12 | verse (0: the start alone). Both in one number
// (start·2^24 | end) where one is wanted, as a text attribute's value.
xr_book: int = -1;

xr_c: int = 0;

xr_v: int = 0;

xr_ce: int = 0;

xr_ve: int = 0;

xref_start(): int {
    xr_book * 16777216 + xr_c * 4096 + xr_v
}

xref_end(): int {
    if (xr_ce == 0) 0 else xr_ce * 4096 + xr_ve
}

xref_both(): int {
    xref_start() * 16777216 + xref_end()
}

// A reference from its numbers (both in one, or start and end): xr_book
// and the rest.
xref_unpack(both: int) {
    xref_unpack2(both / 16777216, both % 16777216)
}

xref_unpack2(start: int, end: int) {
    xr_book = start / 16777216;
    xr_c = start / 4096 % 4096;
    xr_v = start % 4096;
    xr_ce = end / 4096;
    xr_ve = end % 4096;
    if (xr_ce == 0) {
        xr_ce = xr_c;
        xr_ve = xr_v
    }
}

// The chapter (through the Bible) of the reference's start, and of its end.
xref_chapter(): int {
    chapter_of(xr_book, xr_c)
}

xref_last_chapter(): int {
    chapter_of(xr_book, xr_ce)
}

// The chapter a place in source's records is in (its offset), or -1.
chapter_at_offset(source: *TextData, p: int): int {
    lo: int = 0;
    hi: int = chapters;
    while (lo < hi) {
        mid: int = (lo + hi) / 2;
        if (source.starts[mid] <= p) lo = mid + 1 else hi = mid
    }
    c: int = lo - 1;
    if (c >= 0 && source.starts[c] >= 0 && p < source.ends[c]) return c;
    // (A text of some chapters, the ESV's: those not here have no place,
    // so the chapter holding p is looked for.)
    for k in 0..chapters
        if (source.starts[k] >= 0 && source.starts[k] <= p && p < source.ends[k]) return k;
    c
}

// ---- a verse to be spoken ----
// Verse v of chapter c into vt as it is said aloud: its words (no notes),
// the divine name in small capitals said as a name (LORD as Lord, GOD as
// God). How long it is.
speak_text(c: int, v: int): int {
    _n: int = verse_text(c, v);
    vt_speak()
}

// The same, from version source.
source_speak_text(source: *TextData, c: int, v: int): int {
    _n: int = source_verse_text(source, c, v);
    vt_speak()
}

// The words in vt made as they are said: LORD as Lord, GOD as God. How
// long they are.
vt_speak(): int {
    i: int = 0;
    while (i < vt_n) {
        n: int = 0;
        if (i == 0 || !is_letter(ub(vt, i - 1))) {
            if (vt_word(i, "LORD")) n = 4 else if (vt_word(i, "GOD")) n = 3
        }
        if (n > 0) {
            for j in i + 1..i + n vt[j] = (ub(vt, j) + 32) trunc i8;
            i = i + n
        } else i = i + 1
    }
    vt_n
}

// Whether word (in capitals) is a word of its own at vt[i].
vt_word(i: int, word: str): bool {
    if (i + len(word) > vt_n) return false;
    for k in 0..len(word)
        if (vt[i + k] != word[k]) return false;
    i + len(word) == vt_n || !is_letter(ub(vt, i + len(word)))
}

// ---- the page's column (DESIGN.md §17.2.1) ----
// A view w wide shows its text w less its margins m wide, but never more
// than 34 em (about 70 characters a line in every font and size), centred:
// so a wider window has wider margins, and a larger text size a wider
// column, not longer lines. (A skin's to lay out: the look line says it.)
COLUMN_EM: f64 = 34.0f64;

// ---- a place across widths (§17.2.2) ----
// A place is kept as its chapter, its verse and how far into the verse
// (in em), never as points, so it is the same at any width: here, the
// chapter laid out in ctx is set in lines of n characters, 1.5
// em each, a verse's top where its number falls, to find the place at a
// height (em from the chapter's top) and a place's height at a width.
wp_v: int = 0;

wp_em: f64 = 0.0f64;

wp_top(ctx: *ChapterLayout, i: int, n: int): f64 {
    ctx.verse_begin[i] as f64 / n as f64 * 1.5f64
}

// The place at y em down the chapter, set n characters a line.
wp_at(ctx: *ChapterLayout, y: f64, n: int) {
    wp_v = 0;
    wp_em = y;
    for i in 0..ctx.verse_count {
        if (ctx.verse_begin[i] >= 0 && wp_top(ctx, i, n) <= y) {
            wp_v = ctx.verse_num[i];
            wp_em = y - wp_top(ctx, i, n)
        }
    }
}

// How far down the chapter (em) verse v and em into it are, set n
// characters a line.
wp_y(
    ctx: *ChapterLayout,
    v: int,
    frac: f64,
    n: int
): f64 {
    for i in 0..ctx.verse_count
        if (ctx.verse_num[i] == v && ctx.verse_begin[i] >= 0) return wp_top(ctx, i,
            n) + frac;
    frac
}
