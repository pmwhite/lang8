tag bible;

use_tag std;

// The look, apart from any platform (SKINS.md): the text's sizes, line
// spacings and margins the settings step through, the themes' colors (as
// hex), and the highlights'. A skin turns them into its own colors and
// fonts; the fonts themselves are each platform's.
size_steps: []f64 = [0.82f64, 0.9f64, 1.0f64, 1.1f64, 1.2f64, 1.32f64, 1.46f64, 1.62f64];

spacings: []f64 = [1.18f64, 1.32f64, 1.48f64];

margins: []f64 = [20.0f64, 28.0f64, 40.0f64];

theme_names: []str = ["Auto", "Paper", "White", "Sepia", "Night", "Black"];

// ---- the themes' colors (index: the theme, 1 to 5; 0 is Paper's) ----
t_bg: []str = ["FBF8F2", "FBF8F2", "FFFFFF", "F4ECDD", "1B1A18", "000000"];

t_ink: []str = ["1E1C19", "1E1C19", "161616", "3A2E21", "E6E1D7", "D6D1C7"];

t_heading: []str = ["4F4943", "4F4943", "48484A", "5C4A36", "BDB6AA", "A9A399"];

t_faint: []str = ["8A8378", "8A8378", "8E8E93", "927F66", "8C857A", "77716A"];

t_accent: []str = ["9C3A2C", "9C3A2C", "9C3A2C", "8E4426", "DC8873", "D4806C"];

t_rule: []str = ["1E1C19", "1E1C19", "000000", "3A2E21", "FFFFFF", "FFFFFF"];

// A glossed word's underline in the original: the rule's color, so strong
// (theme th).
gloss_line_alpha(th: int): f64 {
    if (th >= 4) 0.4f64 else 0.32f64
}

t_rule_alpha: []f64 = [0.12f64, 0.12f64, 0.1f64, 0.14f64, 0.12f64, 0.1f64];

t_sel_alpha: []f64 = [0.1f64, 0.1f64, 0.09f64, 0.11f64, 0.18f64, 0.18f64];

// (Empty: the system's grouped colors.)
t_sheet: []str = ["F3EFE7", "F3EFE7", "", "ECE2D0", "", "000000"];

t_cell: []str = ["FFFDF9", "FFFDF9", "", "F8F1E4", "", "1A1A1A"];

// Highlights (their names are store.l8's): washes for light themes and
// dark, and their swatches.
hl_light: []str = ["FFD84D", "8FD694", "8CC4F2", "F5A3C0", "C2A9F0"];

hl_light_alpha: []f64 = [0.42f64, 0.4f64, 0.42f64, 0.42f64, 0.42f64];

hl_dark: []str = ["E9C440", "5DB466", "4E97DA", "D9668F", "8F72D6"];

hl_dark_alpha: []f64 = [0.3f64, 0.3f64, 0.32f64, 0.32f64, 0.34f64];

hl_swatch: []str = ["F5CD3D", "6CC072", "5AA6E6", "EE84AA", "A889E8"];

// Whether theme (sizes and themes are the settings' numbers: sizeStep,
// theme) is a dark one, Auto following the system.
theme_dark(theme: int, system_dark: bool): bool {
    if (theme == 0) system_dark else theme >= 4
}

// Auto's theme now: Paper by day, Night at night.
theme_now(theme: int, system_dark: bool): int {
    if (theme != 0) theme else if (system_dark) 4 else 1
}

// The ribbons' colors (owner, 2026-10-19).
// Like a printed Bible's ribbons: red, gold, navy, green, purple, brown and
// slate, solid and deep on the light pages (a little deeper on Sepia's),
// lighter on the dark ones, so that each reads on its page; a narrow strip
// of a solid color, never a highlight's pale wash.
rc_light: []str = ["B03A2E", "B07D12", "2D4C80", "3A7A4C", "6F4C94", "7C5434", "5C6670"];

rc_sepia: []str = ["A3352A", "96680C", "2A4574", "346C43", "634387", "6A4628", "525A63"];

rc_dark: []str = ["E8806F", "E0B651", "86A8E0", "82C292", "BB9CE0", "CFA27A", "A8B0BA"];

// Ribbon color k in theme th (on the dark themes, their own).
ribbon_hex(k_in: int, th: int, dark: bool): str {
    k: int = if (k_in >= 0 && k_in < len(rc_light)) k_in else 0;
    if (dark) rc_dark[k] else if (th == 3) rc_sepia[k] else rc_light[k]
}
