tag bible;

use_tag std;

// The way back (DESIGN.md §3.1.6, the back capsule), apart from any
// platform: the places jumped from, newest last, apart from the history's
// trail; the capsule goes back to the newest, and says where. A skin
// pushes as it jumps, and draws the capsule its own way.
import "skin.l8";

bk_n: int = 0;

bk_c: []int = new int[50](0);

bk_v: []int = new int[50](0);

bk_frac: []int = new int[50](0);

bk_exact: []bool = new bool[50](false);

// (A way back to a plan's day: its plan and day, from 1; 0 for a place.)
bk_plan: []int = new int[50](0);

bk_day: []int = new int[50](0);

back_push(
    c: int,
    v: int,
    frac: int,
    exact: bool
) {
    if (bk_n >= len(bk_c)) {
        for i in 0..bk_n - 1 {
            bk_c[i] = bk_c[i + 1];
            bk_v[i] = bk_v[i + 1];
            bk_frac[i] = bk_frac[i + 1];
            bk_exact[i] = bk_exact[i + 1];
            bk_plan[i] = bk_plan[i + 1];
            bk_day[i] = bk_day[i + 1]
        }
        bk_n = bk_n - 1
    }
    bk_c[bk_n] = c;
    bk_v[bk_n] = v;
    bk_frac[bk_n] = frac;
    bk_exact[bk_n] = exact;
    bk_plan[bk_n] = 0;
    bk_day[bk_n] = 0;
    bk_n = bk_n + 1
}

// The way back to day d of plan p (the day's reader left for a
// reference): the capsule reads "Day 32".
back_push_day(p: int, d: int) {
    back_push(0, 0, 0, false);
    bk_plan[bk_n - 1] = p;
    bk_day[bk_n - 1] = d
}

// The capsule's words: "Day 32" (back to a plan's day), else the place
// (its verse, if the jump was to one), into fbuf; and what a screen reader
// adds.
bk_title() {
    fbuf_n = 0;
    if (bk_n == 0) return;
    i: int = bk_n - 1;
    if (bk_day[i] > 0) {
        fput_str("Day ");
        fput_int(bk_day[i])
    } else fput_ref(bk_c[i], if (bk_exact[i]) bk_v[i] else 0, 0)
}

bk_hint: str = "Go back";

// When the capsule shows: while there is a way back, and not over the
// tray, the player or a plan's day (each has its own place there). It
// goes after BK_SHOW_MS (milliseconds), or once the reader has moved
// BK_SCREENS screens from where it arrived: the skin's to time and
// measure, as the back line says.
bk_may_show(tray: bool, player: bool, day: bool): bool {
    bk_n > 0 && !tray && !player && !day
}

BK_SHOW_MS: int = 12000;

BK_SCREENS: int = 2
