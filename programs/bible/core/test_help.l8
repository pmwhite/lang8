tag bible_help_tests;

use_tag std, bible;

// The Manual (help.l8, DESIGN.md §15.6, §15.7; the quick tips removed,
// §15.11): data/help.txt read and checked (links, anchors, symbols, ids, the
// house style), a file with every fault the checks find, a paragraph's
// markup, and the Manual's search.
need "libc.so.6";

import "../../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "help.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

scratch: []i8 = new i8[262144](0i8);

// The real file.
load() noregion {
    fd: int = open("programs/bible/data/help.txt", 0, 0);
    got: int = 0;
    more: bool = fd >= 0;
    while (more && got < len(scratch)) {
        r: int = read(fd, scratch, got, len(scratch) - got);
        if (r <= 0) more = false else got = got + r
    }
    if (fd >= 0) close(fd);
    hlp = new i8[got + 1](0i8);
    for i in 0..got hlp[i] = scratch[i];
    hlp_n = got;
    help_index()
}

// A file of the test's own.
load_own(s: str) noregion {
    hlp = new i8[len(s) + 1](0i8);
    for i in 0..len(s) hlp[i] = s[i];
    hlp_n = len(s);
    help_index()
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

show_bytes(b: int, e: int) raises IoError {
    write_bytes_n_at(b, e)
}

write_bytes_n_at(b: int, e: int) raises IoError {
    fbuf_n = 0;
    fput_bytes(hlp, b, e);
    show_fbuf()
}

problems() raises IoError {
    write_bytes_n(1, hlog, hlog_n);
    if (he_n == 0) print("no problems")
}

test "help.txt: its pages, parts and paragraphs, and nothing wrong" {
    load();
    problems();
    write(1, "pages ");
    write_int(1, hpg_n);
    write(1, ", parts ");
    write_int(1, hpt_n);
    write(1, ", paragraphs ");
    write_int(1, hpa_n);
    print("");
    for g in 0..hpg_n {
        show_bytes(hpg_title_b[g], hpg_title_e[g]);
        write(1, " (");
        write(1, hsym_names[hpg_sym[g]]);
        write(1, "):");
        for t in hpg_part0[g]..hpg_part0[g] + hpg_parts[g] {
            write(1, " ");
            show_bytes(hpt_id_b[t], hpt_id_e[t])
        }
        print("")
    }
    expect {|
        no problems
        pages 12, parts 58, paragraphs 67
        Reading (book): bar footnotes headings place keys
        Going Places (arrow.right.circle): goto back history previews search
        Selecting Verses (hand.tap): select highlight actions words
        Notes, Highlights and Bookmarks (note.text): notes chapternotes library export versions
        Ribbons (bookmark.fill): about making carry edit
        Reading Plans (calendar): about today mark listen reminder
        Versions and Compare (books.vertical): choose esv compare
        Listening (headphones): listen readers offline speed
        Study (character.book.closed): interlinear wordstudy grammar related references beside
        Memory (brain): adding practice parts schedule hearing reminder
        Greek and Hebrew (textformat.abc): start alphabet words reading original forms
        Reading Settings (textformat.size): text show screen help about
    |}
}

test "the checks: what each finds" {
    load_own("""
# a comment
= one	One	book
A paragraph before any part.
== a	A
Fine, with **bold**, a {sym:bookmark} and [[one#b|a link]].
A {sym:nonesuch}, [[one#zz|nowhere]], [[two#a|another page]] and [[one#a]].
**Left open.
== a	Again
The same part again.
== b	Empty
= one	One again	book
= two	Two	sparkles
== c	C
Words.
Exciting!
Pro tip: tap here.
Did you know there are books here.
You can easily go anywhere.
Simply tap the title.
Just tap the title.
Justice and adjust are words, and so is awesomeness.
= three	Three	book
tip	early	1	-	-	one#a	A tip, from before they were removed.
""");
    problems();
    expect {|
        help.txt:3: a paragraph outside any part
        help.txt:8: two parts a in one page
        help.txt:11: two pages one
        help.txt:12: page two: no symbol, or one not in help.l8's list
        help.txt:23: a tip: the quick tips were removed
        help.txt:0: page one has no part
        help.txt:0: page three has no part
        help.txt:0: part one#b has no paragraph
        help.txt:0: part one#a: a symbol not in help.l8's list: nonesuch
        help.txt:0: part one#a: a link to nowhere: nowhere
        help.txt:0: part one#a: a link to nowhere: another page
        help.txt:0: part one#a: markup not closed: [[one#a]].
        help.txt:0: part one#a: ** or _ not closed
        help.txt:0: part two#c: an exclamation mark
        help.txt:0: part two#c: a word the style forbids
        help.txt:0: part two#c: a word the style forbids
        help.txt:0: part two#c: a word the style forbids
        help.txt:0: part two#c: a word the style forbids
        help.txt:0: part two#c: a word the style forbids
    |}
}

// A paragraph's runs: k kind, b bold, i italic.
show_runs(a: int) raises IoError {
    help_runs(a);
    for r in 0..hrun_n {
        write(1, if (hrun_kind[r] == HRUN_TEXT) "text" else if (hrun_kind[r] == HRUN_SYM) "symbol" else if (hrun_kind[r] == HRUN_LINK) "link" else "bad");
        if (hrun_bold[r]) write(1, " bold");
        if (hrun_italic[r]) write(1, " italic");
        write(1, " [");
        show_bytes(hrun_b[r], hrun_e[r]);
        write(1, "]");
        if (hrun_kind[r] == HRUN_LINK) {
            write(1, " \�\�\� ");
            fbuf_n = 0;
            help_fput_anchor(hrun_link[r]);
            show_fbuf()
        }
        print("")
    }
}

plain(a: int, spoken: bool) raises IoError {
    help_plain(a, spoken);
    write_bytes_n(1, hx, hx_n);
    print("")
}

test "a paragraph's markup, and its words plain" {
    load_own("""
= p	P	book
== a	A
Tap **Edit**, or _here_; {sym:bookmark} opens the Library ([[p#b|More]]).
== b	B
Words.
""");
    problems();
    show_runs(0);
    plain(0, false);
    plain(0, true);
    expect {|
        no problems
        text [Tap ]
        text bold [Edit]
        text [, or ]
        text italic [here]
        text [; ]
        symbol [bookmark]
        text [ opens the Library (]
        link [More] → p#b
        text [).]
        Tap Edit, or here; opens the Library (More).
        Tap Edit, or here; the bookmark button opens the Library (More).
    |}
    // The real file's: Selecting Verses' actions.
    load();
    t: int = help_part_of("tray#actions");
    plain(hpt_para0[t], true);
    expect {|
        Copy the Copy button copies the verses with their reference. Share the Share button sends them on, and Share as Image in the share sheet makes a picture of them. Bookmark the bookmark button keeps the verse in the Library. Note the pencil button writes a note on it. Study the Study button opens the original words (Study). Compare shows the verses in every version (Compare). Memorize the Memorize button adds them to Memory (Memory).
    |}
}

help_part_of(s: str): int {
    for t in 0..hpt_n {
        fbuf_n = 0;
        help_fput_anchor(t);
        if (fbuf_n == len(s)) {
            same: bool = true;
            for i in 0..len(s)
                if (fbuf[i] != s[i]) same = false;
            if (same) return t
        }
    }
    -1
}

// The Manual's search: each part found, and its snippet (the matches in
// [brackets], "… " where it starts after the paragraph's start).
find(q: str) raises IoError {
    b: []i8 = new i8[256](0i8);
    for i in 0..len(q) b[i] = q[i];
    help_search(b, len(q));
    write(1, q);
    write(1, ": ");
    write_int(1, hm_n);
    print("");
    for m in 0..hm_n {
        t: int = hm_part[m];
        fbuf_n = 0;
        fput_str("  ");
        help_fput_anchor(t);
        fput_str(": ");
        help_snippet(t);
        if (hsn_from > 0) fput_str("\�\�\� ");
        p: int = hsn_from;
        for k in 0..hsn_n {
            fput_bytes(hx, p, hsn_mb[k]);
            fput(91);
            fput_bytes(hx, hsn_mb[k], hsn_me[k]);
            fput(93);
            p = hsn_me[k]
        }
        e: int = if (hx_n - p > 30) p + 30 else hx_n;
        fput_bytes(hx, p, e);
        if (e < hx_n) fput_str("\�\�\�");
        show_fbuf();
        print("")
    }
}

test "the Manual's search (§15.7)" {
    load();
    find("ribbon");
    expect {|
        ribbon: 6
          going#goto: Go To also holds your [ribbons] ([Ribbons]), your reading plan (Reading …
          ribbons#about: A [ribbon] keeps a place you’re reading from, like the [ribbons] in a printed Bible: one for y…
          ribbons#making: In Go To, tap New [Ribbon]…, or touch and hold the title in the bar and choose New [Ribbon] Here…. Give it a name and a…
          ribbons#carry: Tap a [ribbon] in Go To to open it. You’re taken to its place, and the [ribbon] is carried: it moves on as you read, and its glyph shows beside the title. When you jump somewhere else, the [ribbon] stays where you were. Touch and hold the title to leave it at a place, or to move another [ribbon] here.
          ribbons#edit: beside a [ribbon] in Go To renames it, changes …
          languages#original: … your highlights, notes, [ribbons] and plans are all there.
    |}
    find("born again");
    find("Born AGAIN");
    expect {|
        born again: 1
          going#search: … find a phrase, “[born] [again]”, and end a word with * to …
        Born AGAIN: 1
          going#search: … find a phrase, “[born] [again]”, and end a word with * to …
    |}
    find("you've");
    find("bless*");
    find("nothing here at all");
    find("");
    expect {|
        you've: 2
          going#back: … by itself once [you’ve] read on.
          plans#reminder: … names each plan [you’ve] turned it on for, and opens t…
        bless*: 1
          going#search: … beginning with it, “[bless]*”. The buttons under the fi…
        nothing here at all: 0
        : 0
    |}
}
