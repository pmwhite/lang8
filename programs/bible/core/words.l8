tag bible;

use_tag std;

// Words the app says that belong to no one screen (SKINS.md): Practice's
// levels and what a screen reader says of its parts, the counts ("Passage
// 2 of 3"), the ribbon's toast and title actions, Memory's limits under
// the ESV, the share card's choices, downloads, the voice's sample, the
// export's name. Any skin says them so.
import "skin.l8";

// ---- Practice ----
px_level_names: []str = ["Full", "Some", "Letters", "Blank"];

px_first_words: str = "Read it aloud a few times. Then hide a little more each time.";

px_suggested_hint: str = "Suggested.";

// "Passage 2 of 3", "Card 2 of 3" (what a screen reader says of the
// count), into fbuf.
fput_count_label(what: str, at: int, n: int) {
    fbuf_n = 0;
    fput_str(what);
    fput(32);
    fput_int(at);
    fput_str(" of ");
    fput_int(n)
}

// What a screen reader says of part k of the passage practised (mt's),
// into fbuf: at Blank, "Verse 3 to 4, hidden" (a verse split in two, which
// half); at Letters, "First letters: I, a, t"; else its words, a hidden one
// "blank", a key letter for its word.
px_part_label(k: int) {
    fbuf_n = 0;
    any_hidden: bool = false;
    any_shown: bool = false;
    for w in mpt_w0[k]..mpt_w1[k]
        if (px_hidden(w) > 0) any_hidden = true else any_shown = true;
    if (any_hidden && !any_shown && px_level == LV_BLANK) {
        fput_str("Verse ");
        fput_int(mv_v[mpt_v0[k]]);
        if (mpt_v1[k] != mpt_v0[k]) {
            fput_str(" to ");
            fput_int(mv_v[mpt_v1[k]])
        } else {
            x: int = mpt_v0[k];
            if (mpt_w0[k] > mv_w0[x]) fput_str(", second half") else if (mpt_w1[k] < mv_w1[x]) fput_str(", first half")
        }
        fput_str(", hidden");
        return
    }
    if (any_hidden && !any_shown && px_level == LV_LETTERS) {
        fput_str("First letters: ");
        for w in mpt_w0[k]..mpt_w1[k] {
            if (w > mpt_w0[k]) fput_str(", ");
            fput_bytes(mt, mw_k[w], mw_k2[w])
        }
        return
    }
    for w in mpt_w0[k]..mpt_w1[k] {
        if (w > mpt_w0[k]) fput(32);
        if (px_hidden(w) == 2) fput_str("blank") else if (px_hidden(w) == 1) fput_bytes(mt,
            mw_k[w], mw_k2[w]) else fput_bytes(mt, mw_b[w], mw_e[w])
    }
}

// ---- ribbons ----
// "Reading with Morning" (ribbon i's toast, and the title's value while it
// is carried); "Leave Morning Here"; "New Ribbon Here".
fput_reading_with(i: int) {
    fbuf_n = 0;
    fput_str("Reading with ");
    fput_ribbon_name(i)
}

fput_leave_here(i: int) {
    fbuf_n = 0;
    fput_str("Leave ");
    fput_ribbon_name(i);
    fput_str(" Here")
}

new_ribbon_here_words: str = "New Ribbon Here";

// ---- Memory under the ESV ----
// Why an ESV passage would not fit (0: it fits), its words into fbuf: at
// most 200 verses, or half of its book.
mm_esv_refusal_words(
    c1: int,
    v1: int,
    c2: int,
    v2: int
): int {
    k: int = esv_pin_check(c1, v1, c2, v2);
    if (k == 0) return 0;
    fbuf_n = 0;
    if (k == 1) fput_str("ESV passages are limited to 200 verses") else {
        fput_str("ESV passages are limited to half of ");
        fput_bytes(bsb, book_name_start(ch_book[c1]), book_name_end(ch_book[c1]))
    }
    k
}

// ---- the share card ----
share_as_image_words: str = "Share as Image";

