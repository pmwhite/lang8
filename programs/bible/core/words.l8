    "Night Background", "Black Background"];

// ---- downloads, the voice ----
// "Downloading John"; "Stop Downloading John?"; its button.
fput_downloading(b: int, stop: bool) {
    fbuf_n = 0;
    fput_str(if (stop) "Stop Downloading " else "Downloading ");
    fput_bytes(bsb, book_name_start(b), book_name_end(b));
    if (stop) fput_str("?")
}

stop_downloading_words: str = "Stop Downloading";

// What a voice says when it is tried.
voice_sample_words: str = "The Lord is my shepherd; I shall not want.";

// ---- the export ----
// Its file's name (Smooth Bible Notes 2026-10-18.md), into fbuf.
export_name(today: int) {
    fbuf_n = 0;
    fput_str("Smooth Bible Notes ");
    fput_iso_date(today);
    fput_str(".md")
}

// The app's name and version line's start ("Smooth Bible 1.0 (21)").
