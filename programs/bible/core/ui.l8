tag bible;

use_tag std;

// Screens as data (SKINS.md): what core builds for a skin to draw. A screen
// is built row by row (ui_begin, ui_section, ui_row and the ui_set_ calls on
// the row just made), held here until the next is built, and written out
// as lines (ui_write) for a skin in another language; an L8 skin reads the
// records. Words go into a pool, so a label formatted in fbuf (store.l8)
// can be kept with ui_set_title_fbuf.
import "store.l8";

// ---- rows ----
UI_ITEM: int = 1;

UI_TOGGLE: int = 2;

UI_CHOICE: int = 3;

UI_SLIDER: int = 4;

UI_FIELD: int = 5;

UI_BUTTON: int = 6;

UI_CUSTOM: int = 7;

// A time of day (its value minutes past midnight: a reminder's), chosen
// as the platform chooses one; its action has the minutes as its value.
UI_TIME: int = 8;

// A paragraph of a page (the Manual's, a commentary's): its title its
// words (by its runs), selectable; links in it (ui_add_link) doing their
// actions; a heading (ui_set_heading) a part's.
UI_TEXT: int = 9;

// The interlinear's words: its cells tiles (UI_TILE_), laid out in lines
// as wide as the list (its value 1: right to left, the Hebrew's order).
UI_TILES: int = 10;

ui_kind_names: []str = ["", "item", "toggle", "choice", "slider", "field", "button",
    "custom", "time", "text", "tiles"];

// An item's accessory.
ACC_NONE: int = 0;

ACC_MORE: int = 1;

ACC_CHECK: int = 2;

ACC_INFO: int = 3;

// Done: a faint check (today's reading read), not to be chosen.
ACC_DONE: int = 4;

// A link: a page outside the app (an arrow up and away).
ACC_LINK: int = 5;

ui_acc_names: []str = ["", "more", "check", "info", "done", "link"];

// Words: from at, n bytes, in ui_pool.
type UiText = {
    at: int;
    n: int
}

type UiRow = {
    kind: int;
    action: int;
    arg: int;
    title: UiText;
    detail: UiText;
    icon: UiText;
    // For a choice, its options' labels split by |.
    options: UiText;
    // What VoiceOver (or TalkBack) says for it, if not its words.
    label: UiText;
    // Words at its end (a time), besides a value or a subtitle.
    trailing: UiText;
    // Its subtitle is the Bible's words (the divine name in small capitals).
    scripture: bool;
    // Swiped away: this action (0: it can't be).
    delete_action: int;
    // Its own presentation, where a skin has one (core/skin.l8's CUSTOM_;
    // 0: its kind's), and what VoiceOver adds as a hint.
    custom: int;
    hint: UiText;
    // Its words faint (shown, but nothing to do).
    faint: bool;
    // Its title stronger (the row to go to, or the one where the reader
    // is), in the accent's color (a link: Show All), and its icon faint.
    strong: bool;
    tinted: bool;
    icon_faint: bool;
    // Places in its detail to stress (the words a search found): pairs of
    // UTF-16 offsets (as Java, JavaScript and NSString count), ui_marks
    // from marks, marks_n pairs.
    marks: int;
    marks_n: int;
    // Its detail in a smaller face (a note about it: Versions' lines), and
    // at most this many lines of it (0: as many as it needs).
    small: bool;
    lines: int;
    // A circle at its start (0 none; 1 empty, 2 half, 3 full: a day not
    // read, partly, read), which does circle_action (with the row's
    // argument); dimmed and inert, circle_off. Its trailing words in the
    // accent (Today).
    circle: int;
    circle_action: int;
    circle_off: bool;
    trailing_tinted: bool;
    // A field's Return does the screen's confirm (New Ribbon's Add), not
    // just end the editing.
    field_go: bool;
    // Faint words after its title (the version quoted: " · KJV"); its
    // icon's color (hex: a highlight's; empty, the accent); a second line
    // under its detail, small and faint (a passage's state); the words
    // the screen's field searches for marked in it; its ⓘ's action (with
    // its argument); and the actions a screen reader offers on it
    // (ui_actions from actions, actions_n of them).
    suffix: UiText;
    icon_color: UiText;
    note: UiText;
    query_marks: bool;
    info_action: int;
    actions: int;
    actions_n: int;
    // Its detail set as the reader sets its words: runs (ui_runs from runs,
    // runs_n pairs: where each ends, UTF-16, and its STYLE_ (text.l8's, or
    // RUN_NUMBER, RUN_MISSING)); and whether it is waiting (a spinner).
    runs: int;
    runs_n: int;
    busy: bool;
    // Its title's runs (as its detail's), and the most lines of its title
    // (0: as many as it needs).
    truns: int;
    truns_n: int;
    title_lines: int;
    // A field whose words go to core as they are typed (not only as its
    // editing ends), and what it takes (0 a name; 1 a reference: each
    // word capitalized, no corrections).
    field_live: bool;
    field_kind: int;
    // A glyph in a column of its own at its start, in a script (RUN_GREEK,
    // RUN_HEBREW: a letter of the Alphabet); words at its end (side, set
    // by its runs: an example, its letter stressed) and a small faint line
    // under them (its gloss).
    lead: UiText;
    lead_style: int;
    side: UiText;
    sruns: int;
    sruns_n: int;
    side_note: UiText;
    // Its actions also as a menu, a button at its end (a word's Mark as
    // Known and Delete: the one that is its delete_action destructive);
    // and a grid's cells (ui_cells from cells, cells_n of them: a lemma's
    // forms), its title their row's label.
    menu: bool;
    cells: int;
    cells_n: int;
    // A page's paragraph: a heading (a part's: a screen reader's headings
    // go by them), and its links (ui_links from links, links_n of them).
    heading: bool;
    links: int;
    links_n: int;
    acc: int;
    // A value shown on the right (not under the title).
    value_detail: bool;
    disabled: bool;
    destructive: bool;
    on: bool;
    value: int;
    lo: int;
    hi: int
}

type UiSection = {
    header: UiText;
    footer: UiText;
    // Its rows: ui_rows from first, n of them.
    first: int;
    n: int;
    // A button in its header (Recent Searches' Clear), and its action.
    button: UiText;
    button_action: int;
    // Faint words after its header (" · Reading"), and a credit under it
    // (1: the ESV's, "(ESV) · esv.org", a link).
    header_suffix: UiText;
    credit: int;
    // Its rows made only as they are wanted (a concordance's thousands):
    // n of them, each by ui_lazy_fn.
    lazy: bool;
    // Over a grid's cells, its columns' names (split by |: Singular,
    // Plural).
    columns: UiText
}

no_text: UiText = UiText { at: 0, n: 0 };

UI_ROWS_MOST: int = 2048;

UI_SECTIONS_MOST: int = 128;

ui_rows: []UiRow = new UiRow[UI_ROWS_MOST](UiRow {
    kind: 0,
    action: 0,
    arg: 0,
    title: no_text,
    detail: no_text,
    icon: no_text,
    options: no_text,
    label: no_text,
    trailing: no_text,
    scripture: false,
    delete_action: 0,
    custom: 0,
    hint: no_text,
    faint: false,
    strong: false,
    tinted: false,
    icon_faint: false,
    marks: 0,
    marks_n: 0,
    small: false,
    lines: 0,
    circle: 0,
    circle_action: 0,
    circle_off: false,
    trailing_tinted: false,
    field_go: false,
    suffix: no_text,
    icon_color: no_text,
    note: no_text,
    query_marks: false,
    info_action: 0,
    actions: 0,
    actions_n: 0,
    runs: 0,
    runs_n: 0,
    busy: false,
    truns: 0,
    truns_n: 0,
    title_lines: 0,
    field_live: false,
    field_kind: 0,
    lead: no_text,
    lead_style: 0,
    side: no_text,
    sruns: 0,
    sruns_n: 0,
    side_note: no_text,
    menu: false,
    cells: 0,
    cells_n: 0,
    heading: false,
    links: 0,
    links_n: 0,
    acc: 0,
    value_detail: false,
    disabled: false,
    destructive: false,
    on: false,
    value: 0,
    lo: 0,
    hi: 0
});

ui_rows_n: int = 0;

ui_sections: []UiSection = new UiSection[UI_SECTIONS_MOST](UiSection {
    header: no_text,
    footer: no_text,
    first: 0,
    n: 0,
    button: no_text,
    button_action: 0,
    header_suffix: no_text,
    credit: 0,
    lazy: false,
    columns: no_text
});

ui_sections_n: int = 0;

ui_pool: []i8 = new i8[1048576](0i8);

ui_pool_n: int = 0;

// ---- the screen being built ----
ui_id: int = 0;

ui_kind: int = 0;

ui_arg: int = 0;

ui_title: UiText = UiText { at: 0, n: 0 };

ui_search: UiText = UiText { at: 0, n: 0 };

// The row shown first, as the screen opens (-1: its top).
ui_focus: int = -1;

// The search field's words as the screen is built (put in the field when
// it is made, or when a retext effect says), and how long typing rests
// before it is sent (ms; 0: at once, as Go To's is).
ui_search_text: UiText = UiText { at: 0, n: 0 };

ui_search_wait: int = 0;

// Its Return goes (Go To's: a reference, not words to search for); and it
// takes the keys as the screen appears.
ui_search_go: bool = false;

ui_search_focus: bool = false;

// The field's scopes (titles split by |, and what a screen reader says
// for each), and the one chosen.
ui_scopes: UiText = UiText { at: 0, n: 0 };

ui_scope_labels: UiText = UiText { at: 0, n: 0 };

ui_scope: int = 0;

// A plain list (search's results), not grouped.
ui_plain: bool = false;

ui_focus_select: bool = false;

ui_focus_middle: bool = false;

ui_intro: UiText = UiText { at: 0, n: 0 };

ui_toolbar: UiText = UiText { at: 0, n: 0 };

ui_toolbar_action: int = 0;

ui_toolbar_arg: int = 0;

ui_toolbar_style: int = 0;

ui_confirm: UiText = UiText { at: 0, n: 0 };

ui_confirm_action: int = 0;

ui_confirm_off: bool = false;

ui_intro_runs: int = 0;

ui_intro_runs_n: int = 0;

ui_hero: UiText = UiText { at: 0, n: 0 };

ui_hero_script: int = 0;

ui_hero_sub: UiText = UiText { at: 0, n: 0 };

ui_hero_line: UiText = UiText { at: 0, n: 0 };

ui_hero_runs: int = 0;

ui_hero_runs_n: int = 0;

ui_index: UiText = UiText { at: 0, n: 0 };

ui_segments: UiText = UiText { at: 0, n: 0 };

ui_segment: int = 0;

ui_segments_action: int = 0;

ui_filter_colors: UiText = UiText { at: 0, n: 0 };

ui_filter_labels: UiText = UiText { at: 0, n: 0 };

ui_filter: int = -1;

ui_filter_action: int = 0;

ui_sorts: UiText = UiText { at: 0, n: 0 };

ui_sort: int = 0;

ui_sort_action: int = 0;

// The marks' offsets, for the rows' marks.
ui_marks: []int = new int[16384](0);

ui_marks_n: int = 0;

// What the screen shows with no rows: a symbol, a title, a line.
ui_empty_symbol: UiText = UiText { at: 0, n: 0 };

ui_empty_title: UiText = UiText { at: 0, n: 0 };

ui_empty_line: UiText = UiText { at: 0, n: 0 };

// A button at the top (beside Done): its title, and the commands its menu
// offers (none: no button; one, destructive: the menu its confirmation).
ui_button: UiText = UiText { at: 0, n: 0 };

type UiCommand = {
    title: UiText;
    action: int;
    arg: int;
    destructive: bool
}

ui_commands: []UiCommand = new UiCommand[16](UiCommand {
    title: UiText { at: 0, n: 0 },
    action: 0,
    arg: 0,
    destructive: false
});

ui_commands_n: int = 0;

ui_put_bytes(b: []i8, from: int, to: int): UiText {
    at: int = ui_pool_n;
    for i in from..to {
        if (ui_pool_n < len(ui_pool)) {
            ui_pool[ui_pool_n] = b[i];
            ui_pool_n = ui_pool_n + 1
        }
    }
    UiText { at: at, n: ui_pool_n - at }
}

ui_put(s: str): UiText {
    at: int = ui_pool_n;
    for c in s {
        if (ui_pool_n < len(ui_pool)) {
            ui_pool[ui_pool_n] = c;
            ui_pool_n = ui_pool_n + 1
        }
    }
    UiText { at: at, n: ui_pool_n - at }
}

// (What fbuf holds now.)
ui_put_fbuf(): UiText {
    ui_put_bytes(fbuf, 0, fbuf_n)
}

ui_begin(
    id: int,
    kind: int,
    arg: int,
    title: str
) {
    ui_id = id;
    ui_kind = kind;
    ui_arg = arg;
    ui_rows_n = 0;
    ui_sections_n = 0;
    ui_pool_n = 0;
    ui_lazy_fn = &ui_no_lazy;
    ui_title = ui_put(title);
    ui_search = no_text;
    ui_focus = -1;
    ui_search_text = no_text;
    ui_search_wait = 0;
    ui_search_go = false;
    ui_search_focus = false;
    ui_scopes = no_text;
    ui_scope_labels = no_text;
    ui_scope = 0;
    ui_plain = false;
    ui_marks_n = 0;
    ui_focus_select = false;
    ui_focus_middle = false;
    ui_intro = no_text;
    ui_toolbar = no_text;
    ui_toolbar_action = 0;
    ui_toolbar_arg = 0;
    ui_toolbar_style = 0;
    ui_confirm = no_text;
    ui_confirm_action = 0;
    ui_confirm_off = false;
    ui_segments = no_text;
    ui_segment = 0;
    ui_segments_action = 0;
    ui_filter_colors = no_text;
    ui_filter_labels = no_text;
    ui_filter = -1;
    ui_filter_action = 0;
    ui_sorts = no_text;
    ui_sort = 0;
    ui_sort_action = 0;
    ui_tools_n = 0;
    ui_actions_n = 0;
    ui_cells_n = 0;
    ui_links_n = 0;
    ui_segments_title = false;
    ui_page = false;
    ui_focus_wash = false;
    ui_intro_quote = false;
    ui_grid = false;
    ui_left = no_text;
    ui_left_icon = no_text;
    ui_left_action = 0;
    ui_left_style = 0;
    ui_runs_n = 0;
    ui_intro_runs_n = 0;
    ui_hero = no_text;
    ui_hero_sub = no_text;
    ui_hero_line = no_text;
    ui_hero_runs_n = 0;
    ui_index = no_text;
    ui_empty_symbol = no_text;
    ui_empty_title = no_text;
    ui_empty_line = no_text;
    ui_button = no_text;
    ui_commands_n = 0
}

ui_set_empty(symbol: str, title: str, line: str) {
    ui_empty_symbol = ui_put(symbol);
    ui_empty_title = ui_put(title);
    ui_empty_line = ui_put(line)
}

ui_set_empty_title_fbuf() {
    ui_empty_title = ui_put_fbuf()
}

ui_set_button(title: str) {
    ui_button = ui_put(title)
}

ui_command(
    title: str,
    action: int,
    arg: int,
    destructive: bool
) {
    if (ui_commands_n >= len(ui_commands)) return;
    ui_commands[ui_commands_n] = UiCommand {
        title: ui_put(title),
        action: action,
        arg: arg,
        destructive: destructive
    };
    ui_commands_n = ui_commands_n + 1
}

ui_set_screen_title_fbuf() {
    ui_title = ui_put_fbuf()
}

ui_set_search(placeholder: str) {
    ui_search = ui_put(placeholder)
}

ui_set_search_text(b: []i8, n: int) {
    ui_search_text = ui_put_bytes(b, 0, n)
}

// (A scope's title and label made in fbuf: the book's, say.)
ui_set_scopes_fbuf(titles_end: int, chosen: int) {
    ui_scopes = ui_put_bytes(fbuf, 0, titles_end);
    ui_scope_labels = ui_put_bytes(fbuf, titles_end, fbuf_n);
    ui_scope = chosen
}

// A place in the last row's detail to stress: UTF-16 offsets b to e.
ui_add_mark(b: int, e: int) {
    if (ui_rows_n == 0 || ui_marks_n + 2 > len(ui_marks)) return;
    i: int = ui_last();
    if (ui_rows[i].marks_n == 0) ui_rows[i].marks = ui_marks_n;
    ui_marks[ui_marks_n] = b;
    ui_marks[ui_marks_n + 1] = e;
    ui_marks_n = ui_marks_n + 2;
    ui_rows[i].marks_n = ui_rows[i].marks_n + 1
}

ui_section(header: str, footer: str) {
    if (ui_sections_n >= UI_SECTIONS_MOST) return;
    ui_sections[ui_sections_n] = UiSection {
        header: ui_put(header),
        footer: ui_put(footer),
        first: ui_rows_n,
        n: 0,
        button: no_text,
        button_action: 0,
        header_suffix: no_text,
        credit: 0,
        lazy: false,
        columns: no_text
    };
    ui_sections_n = ui_sections_n + 1
}

// A button in the last section's header, doing action.
ui_set_section_button(title: str, action: int) {
    if (ui_sections_n == 0) return;
    ui_sections[ui_sections_n - 1].button = ui_put(title);
    ui_sections[ui_sections_n - 1].button_action = action
}

// ---- rows made as they are wanted ----
// The last section's n rows made only when wanted: by ui_lazy_fn(section,
// row), which makes the one row (ui_row and the rest, as ever).
ui_set_lazy(n: int) {
    if (ui_sections_n == 0) return;
    ui_sections[ui_sections_n - 1].lazy = true;
    ui_sections[ui_sections_n - 1].n = n
}

ui_no_lazy(_s: int, _r: int) { }

ui_lazy_fn: fn(s: int, r: int) = &ui_no_lazy;

// Making a wanted row (ui_row then leaves the sections as they are), and
// where the screen's own records end (a wanted row is made after them,
// and gone when the next is).
ui_lazy_on: bool = false;

ui_fixed_rows: int = 0;

ui_fixed_pool: int = 0;

ui_fixed_runs: int = 0;

ui_fixed_marks: int = 0;

ui_fixed_actions: int = 0;

// (The screen made: its records' ends kept.)
ui_fixed() {
    ui_fixed_rows = ui_rows_n;
    ui_fixed_pool = ui_pool_n;
    ui_fixed_runs = ui_runs_n;
    ui_fixed_marks = ui_marks_n;
    ui_fixed_actions = ui_actions_n
}

// Row r of lazy section s made: its record's index (-1: none).
ui_lazy_row(s: int, r: int): int {
    if (s < 0 || s >= ui_sections_n || !ui_sections[s].lazy || r < 0 || r >= ui_sections[s].n) return -1;
    ui_rows_n = ui_fixed_rows;
    ui_pool_n = ui_fixed_pool;
    ui_runs_n = ui_fixed_runs;
    ui_marks_n = ui_fixed_marks;
    ui_actions_n = ui_fixed_actions;
    ui_lazy_on = true;
    f: fn(s: int, r: int) = ui_lazy_fn;
    f(s, r);
    ui_lazy_on = false;
    if (ui_rows_n > ui_fixed_rows) ui_rows_n - 1 else -1
}

ui_set_header_suffix(s: str) {
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].header_suffix = ui_put(s)
}

ui_set_credit(credit: int) {
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].credit = credit
}

ui_set_header_fbuf() {
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].header = ui_put_fbuf()
}

ui_set_footer_fbuf() {
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].footer = ui_put_fbuf()
}

// A row of kind, its action and argument, in the last section (one made,
// headerless, if none is): later ui_set_ calls are on it.
ui_row(kind: int, action: int, arg: int) {
    if (ui_sections_n == 0) ui_section("", "");
    if (ui_rows_n >= UI_ROWS_MOST) return;
    ui_rows[ui_rows_n] = UiRow {
        kind: kind,
        action: action,
        arg: arg,
        title: no_text,
        detail: no_text,
        icon: no_text,
        options: no_text,
        label: no_text,
        trailing: no_text,
        scripture: false,
        delete_action: 0,
        custom: 0,
        hint: no_text,
        faint: false,
        strong: false,
        tinted: false,
        icon_faint: false,
        marks: 0,
        marks_n: 0,
        small: false,
        lines: 0,
        circle: 0,
        circle_action: 0,
        circle_off: false,
        trailing_tinted: false,
        field_go: false,
        suffix: no_text,
        icon_color: no_text,
        note: no_text,
        query_marks: false,
        info_action: 0,
        actions: 0,
        actions_n: 0,
        runs: 0,
        runs_n: 0,
        busy: false,
        truns: 0,
        truns_n: 0,
        title_lines: 0,
        field_live: false,
        field_kind: 0,
        lead: no_text,
        lead_style: 0,
        side: no_text,
        sruns: 0,
        sruns_n: 0,
        side_note: no_text,
        menu: false,
        cells: 0,
        cells_n: 0,
        heading: false,
        links: 0,
        links_n: 0,
        acc: ACC_NONE,
        value_detail: false,
        disabled: false,
        destructive: false,
        on: false,
        value: 0,
        lo: 0,
        hi: 0
    };
    ui_rows_n = ui_rows_n + 1;
    if (!ui_lazy_on) ui_sections[ui_sections_n - 1].n = ui_sections[ui_sections_n - 1].n + 1
}

ui_last(): int {
    ui_rows_n - 1
}

ui_set_title(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].title = ui_put(s)
}

ui_set_title_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].title = ui_put_fbuf()
}

ui_set_detail(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].detail = ui_put(s)
}

ui_set_detail_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].detail = ui_put_fbuf()
}

// The detail as a value on the right.
ui_set_trailing_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].trailing = ui_put_fbuf()
}

ui_set_custom(custom: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].custom = custom
}

ui_set_hint(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].hint = ui_put(s)
}

ui_set_faint() {
    if (ui_rows_n > 0) ui_rows[ui_last()].faint = true
}

ui_set_strong() {
    if (ui_rows_n > 0) ui_rows[ui_last()].strong = true
}

ui_set_tinted() {
    if (ui_rows_n > 0) ui_rows[ui_last()].tinted = true
}

ui_set_icon_faint() {
    if (ui_rows_n > 0) ui_rows[ui_last()].icon_faint = true
}

ui_set_small() {
    if (ui_rows_n > 0) ui_rows[ui_last()].small = true
}

ui_set_lines(n: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].lines = n
}

ui_set_circle(state: int, action: int, off: bool) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].circle = state + 1;
    ui_rows[ui_last()].circle_action = action;
    ui_rows[ui_last()].circle_off = off
}

ui_set_trailing_tinted() {
    if (ui_rows_n > 0) ui_rows[ui_last()].trailing_tinted = true
}

// A field (a UI_FIELD row: its title the placeholder, its detail the
// words in it; what is typed comes back as its action's text, when the
// editing ends) whose Return does the screen's confirm.
ui_set_field_go() {
    if (ui_rows_n > 0) ui_rows[ui_last()].field_go = true
}

ui_set_suffix_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].suffix = ui_put_fbuf()
}

ui_set_icon_color(hex: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].icon_color = ui_put(hex)
}

ui_set_note_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].note = ui_put_fbuf()
}

// Runs of a row's detail besides the reader's: a verse's number (small,
// faint), a verse a version hasn't (italic, faint).
RUN_NUMBER: int = 100;

RUN_MISSING: int = 101;

// Words in Greek or Hebrew (their faces; _FAINT, faint), a
// transliteration (italic, faint), a code (Strong's: fixed width), faint
// words, strong words, plain words (the place's own face, in ink), small
// faint words (a footnote's), and words to read (the reader's face).
RUN_GREEK: int = 102;

RUN_HEBREW: int = 103;

RUN_TRANSLIT: int = 104;

RUN_CODE: int = 105;

RUN_FAINT: int = 106;

RUN_STRONG: int = 107;

RUN_PLAIN: int = 108;

RUN_SMALL: int = 109;

RUN_GREEK_FAINT: int = 110;

RUN_HEBREW_FAINT: int = 111;

RUN_READING: int = 112;

// Words in italic, in ink (what a form does: "loved"); words in the
// accent's color, in the face given (an example's letter).
RUN_ITALIC: int = 113;

RUN_ACCENT: int = 114;

// A symbol (its words are its name, as SF Symbols name it), drawn at the
// text's size, in ink; _BOLD, heavier. A skin without the symbol leaves it
// out.
RUN_SYMBOL: int = 115;

RUN_SYMBOL_BOLD: int = 116;

// The Bible's words, in the reader's face, the divine name in small
// capitals (a verse at the top of Study).
RUN_SCRIPTURE: int = 117;

// A Practice passage's words (core/practice.l8's px_looks): RUN_PRACTICE
// plus a look (a color, 0 clear, 1 ink, 2 learned, 3 faint; an underline
// times 4, 0 none, 1 the rule, 2 the accent, 3 half the accent, 4 the
// accent dotted; 32 the verse heard, washed) plus its script (64 Greek,
// 128 Hebrew).
RUN_PRACTICE: int = 200;

// The last row's title runs on to UTF-16 place end in style.
ui_add_title_run(end: int, style: int) {
    if (ui_rows_n == 0 || ui_runs_n + 2 > len(ui_runs)) return;
    i: int = ui_last();
    if (ui_rows[i].truns_n == 0) ui_rows[i].truns = ui_runs_n;
    ui_runs[ui_runs_n] = end;
    ui_runs[ui_runs_n + 1] = style;
    ui_runs_n = ui_runs_n + 2;
    ui_rows[i].truns_n = ui_rows[i].truns_n + 1
}

ui_set_field_live(kind: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].field_live = true;
    ui_rows[ui_last()].field_kind = kind
}

// The confirming button there but off (Add, before a passage is typed).
ui_set_confirm_off() {
    ui_confirm_off = true
}

ui_set_title_lines(n: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].title_lines = n
}

// Rich words in fbuf, built a run at a time: ui_rich_begin, then
// ui_rich(style) after each run's words; then ui_rich_title, _detail or
// _intro.
ui_rich_n: int = 0;

ui_rich_u: int = 0;

ui_rich_from: int = 0;

ui_rich_end: []int = new int[256](0);

ui_rich_style: []int = new int[256](0);

ui_rich_begin() {
    fbuf_n = 0;
    ui_rich_n = 0;
    ui_rich_u = 0;
    ui_rich_from = 0
}

// (The words since the last run: a run of style.)
ui_rich(style: int) {
    if (fbuf_n <= ui_rich_from || ui_rich_n >= len(ui_rich_end)) return;
    ui_rich_u = ui_rich_u + ui_utf16(fbuf, ui_rich_from, fbuf_n);
    ui_rich_end[ui_rich_n] = ui_rich_u;
    ui_rich_style[ui_rich_n] = style;
    ui_rich_n = ui_rich_n + 1;
    ui_rich_from = fbuf_n
}

ui_rich_title() {
    ui_set_title_fbuf();
    for x in 0..ui_rich_n ui_add_title_run(ui_rich_end[x], ui_rich_style[x])
}

ui_rich_detail() {
    ui_set_detail_fbuf();
    for x in 0..ui_rich_n ui_add_run(ui_rich_end[x], ui_rich_style[x])
}

// The screen's intro, rich.
ui_rich_intro() {
    ui_intro = ui_put_fbuf();
    ui_intro_runs = ui_runs_n;
    for x in 0..ui_rich_n {
        if (ui_runs_n + 2 <= len(ui_runs)) {
            ui_runs[ui_runs_n] = ui_rich_end[x];
            ui_runs[ui_runs_n + 1] = ui_rich_style[x];
            ui_runs_n = ui_runs_n + 2
        }
    }
    ui_intro_runs_n = ui_rich_n
}

// How many UTF-16 units bytes p to e of s are.
ui_utf16(s: []i8, p: int, e: int): int {
    n: int = 0;
    for i in p..e {
        k: int = s[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    n
}

// A word as the screen's heading (a word study's): the word large in its
// script (RUN_GREEK or RUN_HEBREW), its transliteration, and a line (rich:
// ui_rich_hero's).
ui_set_hero(word_end: int, script: int, translit_end: int) {
    ui_hero = ui_put_bytes(fbuf, 0, word_end);
    ui_hero_script = script;
    ui_hero_sub = ui_put_bytes(fbuf, word_end, translit_end)
}

ui_rich_hero_line() {
    ui_hero_line = ui_put_fbuf();
    ui_hero_runs = ui_runs_n;
    for x in 0..ui_rich_n {
        if (ui_runs_n + 2 <= len(ui_runs)) {
            ui_runs[ui_runs_n] = ui_rich_end[x];
            ui_runs[ui_runs_n + 1] = ui_rich_style[x];
            ui_runs_n = ui_runs_n + 2
        }
    }
    ui_hero_runs_n = ui_rich_n
}

// Short titles of the sections, for an index beside the list (split by
// |), when there are many.
ui_set_index_fbuf() {
    ui_index = ui_put_fbuf()
}

ui_runs: []int = new int[16384](0);

ui_runs_n: int = 0;

// The last row's detail runs on to UTF-16 place end in style.
ui_add_run(end: int, style: int) {
    if (ui_rows_n == 0 || ui_runs_n + 2 > len(ui_runs)) return;
    i: int = ui_last();
    if (ui_rows[i].runs_n == 0) ui_rows[i].runs = ui_runs_n;
    ui_runs[ui_runs_n] = end;
    ui_runs[ui_runs_n + 1] = style;
    ui_runs_n = ui_runs_n + 2;
    ui_rows[i].runs_n = ui_rows[i].runs_n + 1
}

ui_set_busy() {
    if (ui_rows_n > 0) ui_rows[ui_last()].busy = true
}

ui_set_query_marks() {
    if (ui_rows_n > 0) ui_rows[ui_last()].query_marks = true
}

// Its ⓘ (ACC_INFO) does action, with the row's argument.
ui_set_info(action: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].info_action = action;
    ui_rows[ui_last()].acc = ACC_INFO
}

// An action a screen reader offers on the last row (VoiceOver's custom
// actions; elsewhere, its long press's menu), with the row's argument.
type UiAction = {
    title: UiText;
    action: int;
    // Its icon in a menu (a symbol's name), if it has one.
    icon: UiText
}

ui_actions: []UiAction = new UiAction[1024](UiAction { title: UiText { at: 0, n: 0 }, action: 0, icon: UiText { at: 0, n: 0 } });

ui_actions_n: int = 0;

ui_row_action(title: str, action: int) {
    ui_row_action_icon(title, "", action)
}

ui_row_action_icon(title: str, icon: str, action: int) {
    if (ui_rows_n == 0 || ui_actions_n >= len(ui_actions)) return;
    i: int = ui_last();
    if (ui_rows[i].actions_n == 0) ui_rows[i].actions = ui_actions_n;
    ui_actions[ui_actions_n] = UiAction { title: ui_put(title), action: action, icon: ui_put(icon) };
    ui_actions_n = ui_actions_n + 1;
    ui_rows[i].actions_n = ui_rows[i].actions_n + 1
}

// The last row's actions shown as a menu at its end, too.
ui_set_menu() {
    if (ui_rows_n > 0) ui_rows[ui_last()].menu = true
}

// The last row's glyph at its start (fbuf's), in a script.
ui_set_lead_fbuf(style: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].lead = ui_put_fbuf();
    ui_rows[ui_last()].lead_style = style
}

// Its words at its end, rich (ui_rich's runs), and the line under them.
ui_rich_side() {
    if (ui_rows_n == 0) return;
    i: int = ui_last();
    ui_rows[i].side = ui_put_fbuf();
    ui_rows[i].sruns = ui_runs_n;
    for x in 0..ui_rich_n {
        if (ui_runs_n + 2 <= len(ui_runs)) {
            ui_runs[ui_runs_n] = ui_rich_end[x];
            ui_runs[ui_runs_n + 1] = ui_rich_style[x];
            ui_runs_n = ui_runs_n + 2
        }
    }
    ui_rows[i].sruns_n = ui_rich_n
}

ui_set_side_note_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].side_note = ui_put_fbuf()
}

// A grid's cell: its words in a script (a form), what it does under them
// (italic), its count (smaller), what a screen reader says, and what a
// tap does (0: nothing, a cell with no form).
type UiCell = {
    text: UiText;
    sub: UiText;
    count: UiText;
    label: UiText;
    script: int;
    action: int;
    arg: int;
    // A tile's (the interlinear's) transliteration, what it hides and how
    // (UI_TILE_), and what a screen reader offers on it (ui_actions from
    // actions, actions_n of them, each with its arg).
    tr: UiText;
    flags: int;
    actions: int;
    actions_n: int
}

// A tile's words: its English hidden (a word known), its transliteration
// hidden (the alphabet known), the helped mark under its English (shown by
// a tap), its English faint and italic (not translated), and no original
// (words the translation adds: only its English, faint and italic).
UI_TILE_HIDE_SUB: int = 1;

UI_TILE_HIDE_TR: int = 2;

UI_TILE_HELPED: int = 4;

UI_TILE_FAINT_SUB: int = 8;

UI_TILE_ADDED: int = 16;

ui_cells: []UiCell = new UiCell[1024](UiCell {
    text: UiText { at: 0, n: 0 },
    sub: UiText { at: 0, n: 0 },
    count: UiText { at: 0, n: 0 },
    label: UiText { at: 0, n: 0 },
    script: 0,
    action: 0,
    arg: 0,
    tr: UiText { at: 0, n: 0 },
    flags: 0,
    actions: 0,
    actions_n: 0
});

ui_cells_n: int = 0;

// A cell on the last row, its words fbuf's.
ui_cell_fbuf(script: int, action: int, arg: int) {
    if (ui_rows_n == 0 || ui_cells_n >= len(ui_cells)) return;
    i: int = ui_last();
    if (ui_rows[i].cells_n == 0) ui_rows[i].cells = ui_cells_n;
    ui_cells[ui_cells_n] = UiCell {
        text: ui_put_fbuf(),
        sub: no_text,
        count: no_text,
        label: no_text,
        script: script,
        action: action,
        arg: arg,
        tr: no_text,
        flags: 0,
        actions: 0,
        actions_n: 0
    };
    ui_cells_n = ui_cells_n + 1;
    ui_rows[i].cells_n = ui_rows[i].cells_n + 1
}

ui_set_cell_sub_fbuf() {
    if (ui_cells_n > 0) ui_cells[ui_cells_n - 1].sub = ui_put_fbuf()
}

ui_set_cell_count_fbuf() {
    if (ui_cells_n > 0) ui_cells[ui_cells_n - 1].count = ui_put_fbuf()
}

ui_set_cell_label_fbuf() {
    if (ui_cells_n > 0) ui_cells[ui_cells_n - 1].label = ui_put_fbuf()
}

ui_set_cell_tr_fbuf() {
    if (ui_cells_n > 0) ui_cells[ui_cells_n - 1].tr = ui_put_fbuf()
}

ui_set_cell_flags(flags: int) {
    if (ui_cells_n > 0) ui_cells[ui_cells_n - 1].flags = flags
}

// An action a screen reader offers on the last cell (with its arg).
ui_cell_action(title: str, action: int) {
    if (ui_cells_n == 0 || ui_actions_n >= len(ui_actions)) return;
    c: int = ui_cells_n - 1;
    if (ui_cells[c].actions_n == 0) ui_cells[c].actions = ui_actions_n;
    ui_actions[ui_actions_n] = UiAction { title: ui_put(title), action: action, icon: no_text };
    ui_actions_n = ui_actions_n + 1;
    ui_cells[c].actions_n = ui_cells[c].actions_n + 1
}

// A link in a page's paragraph: UTF-16 places b to e of its words (as its
// runs count), doing action with arg.
type UiLink = {
    b: int;
    e: int;
    action: int;
    arg: int
}

ui_links: []UiLink = new UiLink[2048](UiLink {
    b: 0,
    e: 0,
    action: 0,
    arg: 0
});

ui_links_n: int = 0;

ui_add_link(
    b: int,
    e: int,
    action: int,
    arg: int
) {
    if (ui_rows_n == 0 || ui_links_n >= len(ui_links)) return;
    i: int = ui_last();
    if (ui_rows[i].links_n == 0) ui_rows[i].links = ui_links_n;
    ui_links[ui_links_n] = UiLink {
        b: b,
        e: e,
        action: action,
        arg: arg
    };
    ui_links_n = ui_links_n + 1;
    ui_rows[i].links_n = ui_rows[i].links_n + 1
}

ui_set_heading() {
    if (ui_rows_n > 0) ui_rows[ui_last()].heading = true
}

// The screen a page (its rows paragraphs: no lines between them, the
// page's color), and its focus row washed as it is shown (a Manual's
// part, gone to by a link).
ui_page: bool = false;

// Its intro a quote (a note's verse: faint, an accent's bar beside it).
ui_intro_quote: bool = false;

// Its rows drawn as a grid of their numbers (each row's value), the one
// with a check chosen: a book's chapters.
ui_grid: bool = false;

// A button at the left of its bar (a note's Cancel, Delete Note), its
// symbol (if any), its action and style (UI_TOOL_PLAIN, _DESTRUCTIVE).
ui_left: UiText = UiText { at: 0, n: 0 };

ui_left_icon: UiText = UiText { at: 0, n: 0 };

ui_left_action: int = 0;

ui_left_style: int = 0;

ui_set_left(
    title: str,
    icon: str,
    action: int,
    style: int
) {
    ui_left = ui_put(title);
    ui_left_icon = ui_put(icon);
    ui_left_action = action;
    ui_left_style = style
}

ui_focus_wash: bool = false;

// The last section's columns' names (split by |).
ui_set_columns(names: str) {
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].columns = ui_put(names)
}

// Its segments (the Library's Highlights, Notes, ...: labels split by |),
// the one shown; choosing one does action with its index.
ui_set_segments(labels: str, chosen: int, action: int) {
    ui_segments = ui_put(labels);
    ui_segment = chosen;
    ui_segments_action = action
}

// The segments in the bar, in place of the title (the Study sheet's
// Words, References, Commentary); the title still the screen's name (a
// back button's).
ui_segments_title: bool = false;

// A filter by color under them (All, then a circle each color: hex and
// spoken labels split by |), the one chosen (-1 All); choosing does action
// with its index (-1 All).
ui_set_filter_fbuf(colors_end: int, chosen: int, action: int) {
    ui_filter_colors = ui_put_bytes(fbuf, 0, colors_end);
    ui_filter_labels = ui_put_bytes(fbuf, colors_end, fbuf_n);
    ui_filter = chosen;
    ui_filter_action = action
}

// How its rows are sorted (titles split by |, the one in force): a menu
// beside its title; choosing does action with its index.
ui_set_sort(titles: str, chosen: int, action: int) {
    ui_sorts = ui_put(titles);
    ui_sort = chosen;
    ui_sort_action = action
}

// A button at the screen's foot: its title (or an icon, and a spoken
// label), its action and argument, style (UI_TOOL_), and place (0 at
// the left, 1 the middle, 2 the right).
type UiTool = {
    title: UiText;
    icon: UiText;
    label: UiText;
    action: int;
    arg: int;
    style: int;
    place: int;
    // Its menu, instead of doing its action at once: the items, each its
    // argument and title (ARG:TITLE, split by |), each doing the action
    // with its own (I Know These' Mark All 24 as Known).
    menu: UiText
}

ui_tools: []UiTool = new UiTool[8](UiTool {
    title: UiText { at: 0, n: 0 },
    icon: UiText { at: 0, n: 0 },
    label: UiText { at: 0, n: 0 },
    action: 0,
    arg: 0,
    style: 0,
    place: 0,
    menu: UiText { at: 0, n: 0 }
});

ui_tools_n: int = 0;

ui_tool(
    title: str,
    icon: str,
    action: int,
    arg: int,
    style: int,
    place: int
) {
    if (ui_tools_n >= len(ui_tools)) return;
    ui_tools[ui_tools_n] = UiTool {
        title: ui_put(title),
        icon: ui_put(icon),
        label: no_text,
        action: action,
        arg: arg,
        style: style,
        place: place,
        menu: no_text
    };
    ui_tools_n = ui_tools_n + 1
}

// (The last tool's menu, fbuf's: ARG:TITLE items split by |.)
ui_set_tool_menu_fbuf() {
    if (ui_tools_n > 0) ui_tools[ui_tools_n - 1].menu = ui_put_fbuf()
}

// (The last tool's spoken label, fbuf's.)
ui_set_tool_label_fbuf() {
    if (ui_tools_n > 0) ui_tools[ui_tools_n - 1].label = ui_put_fbuf()
}

// The screen's confirming button at the top (New Ribbon's Add, in place
// of Done; Cancel then beside it, on a sheet of its own).
ui_set_confirm(title: str, action: int) {
    ui_confirm = ui_put(title);
    ui_confirm_action = action
}

// The focus row also selected (the day the plan's days were opened for),
// in the middle.
ui_set_focus_selected() {
    ui_set_focus();
    ui_focus_select = true
}

// The focus row in the middle, not at the top (a chooser's choice).
ui_set_focus_middle() {
    ui_set_focus();
    ui_focus_middle = true
}

// Words above the first section (a plan's description).
ui_set_intro_fbuf() {
    ui_intro = ui_put_fbuf()
}

// A button at the screen's foot (Start Plan), doing action with arg:
// prominent, destructive (Stop Plan), or off.
ui_set_toolbar(
    title: str,
    action: int,
    arg: int,
    style: int
) {
    ui_toolbar = ui_put(title);
    ui_toolbar_action = action;
    ui_toolbar_arg = arg;
    ui_toolbar_style = style;
    ui_tool(title, "", action, arg, style, 1)
}

UI_TOOL_PLAIN: int = 0;

UI_TOOL_PROMINENT: int = 1;

UI_TOOL_DESTRUCTIVE: int = 2;

UI_TOOL_OFF: int = 3;

// Segments at the foot (the interlinear's order): its menu's items the
// segments (ARG:TITLE), its arg the one chosen; choosing does its action
// with the item's.
UI_TOOL_SEGMENTS: int = 4;

// The row just made, shown first.
ui_set_focus() {
    if (ui_rows_n > 0) ui_focus = ui_last()
}

ui_set_scripture() {
    if (ui_rows_n > 0) ui_rows[ui_last()].scripture = true
}

// Swiping the row away does action (with the row's argument).
ui_set_delete(action: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].delete_action = action
}

ui_set_label_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].label = ui_put_fbuf()
}

ui_set_value_detail() {
    if (ui_rows_n > 0) ui_rows[ui_last()].value_detail = true
}

ui_set_icon(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].icon = ui_put(s)
}

ui_set_acc(acc: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].acc = acc
}

ui_set_on(on: bool) {
    if (ui_rows_n > 0) ui_rows[ui_last()].on = on
}

ui_set_disabled(off: bool) {
    if (ui_rows_n > 0) ui_rows[ui_last()].disabled = off
}

ui_set_destructive() {
    if (ui_rows_n > 0) ui_rows[ui_last()].destructive = true
}

// A choice's options (labels split by |) and the one chosen.
ui_set_options(labels: str, chosen: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].options = ui_put(labels);
    ui_rows[ui_last()].value = chosen
}

// A slider's range and value.
ui_set_range(lo: int, hi: int, value: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].lo = lo;
    ui_rows[ui_last()].hi = hi;
    ui_rows[ui_last()].value = value
}

// ---- the wire (SKINS.md): the screen as lines ----
// Lines for the skin, into ui_out from ui_out_n; the skin's host sends
// them and sets ui_out_n to 0. A skin in L8 (the iPhone's) has none
// (ui_wire false): it reads the records, and the effects from ui_effects.
ui_wire: bool = true;

ui_out: []i8 = new i8[1048576](0i8);

ui_out_n: int = 0;

ui_byte(k: int) {
    if (!ui_wire) return;
    if (ui_out_n < len(ui_out)) {
        ui_out[ui_out_n] = k trunc i8;
        ui_out_n = ui_out_n + 1
    }
}

ui_str(s: str) {
    for c in s ui_byte(c as int)
}

ui_int(n: int) {
    if (n < 0) {
        ui_byte(45);
        ui_int(-n);
        return
    }
    if (n >= 10) ui_int(n / 10);
    ui_byte(48 + n % 10)
}

// Bytes as a field: a tab, a newline or a backslash escaped.
ui_field_bytes(b: []i8, from: int, to: int) {
    for i in from..to {
        k: int = b[i] as int & 255;
        if (k == 9) ui_str("\\t") else if (k == 10) ui_str("\\n") else if (k == 92) ui_str("\\\\") else ui_byte(k)
    }
}

ui_field(t: UiText) {
    ui_byte(9);
    ui_field_bytes(ui_pool, t.at, t.at + t.n)
}

ui_field_str(s: str) {
    ui_byte(9);
    for c in s {
        k: int = c as int & 255;
        if (k == 9) ui_str("\\t") else if (k == 10) ui_str("\\n") else if (k == 92) ui_str("\\\\") else ui_byte(k)
    }
}

ui_field_int(n: int) {
    ui_byte(9);
    ui_int(n)
}

// Runs as a field: END:STYLE pairs split by spaces.
ui_wire_runs(at: int, n: int) {
    ui_byte(9);
    for x in 0..n {
        if (x > 0) ui_byte(32);
        ui_int(ui_runs[at + x * 2]);
        ui_byte(58);
        ui_int(ui_runs[at + x * 2 + 1])
    }
}

// The screen built, as lines: screen, its sections and rows, end.
ui_write() {
    ui_str("screen ");
    ui_int(ui_id);
    ui_byte(32);
    ui_int(ui_kind);
    ui_byte(32);
    ui_int(ui_arg);
    ui_field(ui_title);
    ui_field(ui_search);
    ui_byte(10);
    if (ui_focus >= 0) {
        ui_str("focus ");
        ui_int(ui_focus);
        if (ui_focus_select) ui_str(" 1") else if (ui_focus_middle) ui_str(" 2") else if (ui_focus_wash) ui_str(" 3");
        ui_byte(10)
    }
    if (ui_intro.n > 0) {
        ui_str("intro");
        ui_field(ui_intro);
        ui_wire_runs(ui_intro_runs, ui_intro_runs_n);
        ui_field_int(if (ui_intro_quote) 1 else 0);
        ui_byte(10)
    }
    if (ui_left.n > 0) {
        ui_str("left");
        ui_field_int(ui_left_action);
        ui_field(ui_left);
        ui_field(ui_left_icon);
        ui_field_int(ui_left_style);
        ui_byte(10)
    }
    if (ui_hero.n > 0) {
        ui_str("hero");
        ui_field(ui_hero);
        ui_field_int(ui_hero_script);
        ui_field(ui_hero_sub);
        ui_field(ui_hero_line);
        ui_wire_runs(ui_hero_runs, ui_hero_runs_n);
        ui_byte(10)
    }
    if (ui_index.n > 0) {
        ui_str("index");
        ui_field(ui_index);
        ui_byte(10)
    }
    if (ui_confirm.n > 0) {
        ui_str("confirm");
        ui_field_int(ui_confirm_action);
        ui_field(ui_confirm);
        ui_field_int(if (ui_confirm_off) 1 else 0);
        ui_byte(10)
    }
    for i in 0..ui_tools_n {
        ui_str("tool");
        ui_field_int(ui_tools[i].action);
        ui_field_int(ui_tools[i].arg);
        ui_field(ui_tools[i].title);
        ui_field(ui_tools[i].icon);
        ui_field(ui_tools[i].label);
        ui_field_int(ui_tools[i].style);
        ui_field_int(ui_tools[i].place);
        ui_field(ui_tools[i].menu);
        ui_byte(10)
    }
    if (ui_segments.n > 0) {
        ui_str("segments");
        ui_field_int(ui_segments_action);
        ui_field_int(ui_segment);
        ui_field(ui_segments);
        ui_field_int(if (ui_segments_title) 1 else 0);
        ui_byte(10)
    }
    if (ui_filter_colors.n > 0) {
        ui_str("filter");
        ui_field_int(ui_filter_action);
        ui_field_int(ui_filter);
        ui_field(ui_filter_colors);
        ui_field(ui_filter_labels);
        ui_byte(10)
    }
    if (ui_sorts.n > 0) {
        ui_str("sort");
        ui_field_int(ui_sort_action);
        ui_field_int(ui_sort);
        ui_field(ui_sorts);
        ui_byte(10)
    }
    if (ui_search.n > 0) {
        ui_str("field");
        ui_field(ui_search_text);
        ui_field_int(ui_search_wait);
        ui_byte(9);
        if (ui_search_go) ui_byte(103);
        if (ui_search_focus) ui_byte(102);
        ui_byte(10)
    }
    if (ui_scopes.n > 0) {
        ui_str("scopes");
        ui_field_int(ui_scope);
        ui_field(ui_scopes);
        ui_field(ui_scope_labels);
        ui_byte(10)
    }
    if (ui_plain) ui_str("plain\n");
    if (ui_page) ui_str("page\n");
    if (ui_grid) ui_str("grid\n");
    if (ui_empty_title.n > 0) {
        ui_str("empty");
        ui_field(ui_empty_symbol);
        ui_field(ui_empty_title);
        ui_field(ui_empty_line);
        ui_byte(10)
    }
    if (ui_button.n > 0) {
        ui_str("button");
        ui_field(ui_button);
        ui_byte(10);
        for i in 0..ui_commands_n {
            ui_str("command");
            ui_field_int(ui_commands[i].action);
            ui_field_int(ui_commands[i].arg);
            ui_field(ui_commands[i].title);
            ui_byte(9);
            if (ui_commands[i].destructive) ui_byte(120);
            ui_byte(10)
        }
    }
    for s in 0..ui_sections_n {
        ui_str("section");
        ui_field(ui_sections[s].header);
        ui_field(ui_sections[s].footer);
        ui_field(ui_sections[s].button);
        ui_field_int(ui_sections[s].button_action);
        ui_field(ui_sections[s].header_suffix);
        ui_field_int(ui_sections[s].credit);
        ui_field(ui_sections[s].columns);
        ui_byte(10);
        first: int = ui_sections[s].first;
        for x in 0..ui_sections[s].n {
            // (A lazy section's rows made one by one as they are written.)
            r: int = if (ui_sections[s].lazy) ui_lazy_row(s, x) else first + x;
            if (r < 0) r = 0;
            row: UiRow = ui_rows[r];
            ui_str("row");
            ui_field_str(ui_kind_names[row.kind]);
            ui_field_int(row.action);
            ui_field_int(row.arg);
            ui_field(row.title);
            ui_field(row.detail);
            ui_field(row.icon);
            ui_field_str(ui_acc_names[row.acc]);
            ui_byte(9);
            if (row.disabled) ui_byte(100);
            if (row.destructive) ui_byte(120);
            if (row.on) ui_byte(111);
            if (row.value_detail) ui_byte(118);
            if (row.scripture) ui_byte(115);
            if (row.faint) ui_byte(102);
            if (row.strong) ui_byte(98);
            if (row.tinted) ui_byte(116);
            if (row.icon_faint) ui_byte(103);
            if (row.small) ui_byte(109);
            if (row.circle_off) ui_byte(107);
            if (row.trailing_tinted) ui_byte(97);
            if (row.field_go) ui_byte(114);
            if (row.query_marks) ui_byte(113);
            if (row.busy) ui_byte(119);
            if (row.field_live) ui_byte(108);
            if (row.menu) ui_byte(117);
            if (row.heading) ui_byte(104);
            ui_field_int(row.value);
            ui_field(row.options);
            ui_field_int(row.lo);
            ui_field_int(row.hi);
            ui_field(row.label);
            ui_field(row.trailing);
            ui_field_int(row.delete_action);
            ui_field_int(row.custom);
            ui_field(row.hint);
            ui_byte(9);
            for m in 0..row.marks_n {
                if (m > 0) ui_byte(32);
                ui_int(ui_marks[row.marks + m * 2]);
                ui_byte(32);
                ui_int(ui_marks[row.marks + m * 2 + 1])
            }
            ui_field_int(row.lines);
            ui_field_int(row.circle);
            ui_field_int(row.circle_action);
            ui_field(row.suffix);
            ui_field(row.icon_color);
            ui_field(row.note);
            ui_field_int(row.info_action);
            ui_byte(9);
            for a in 0..row.actions_n {
                if (a > 0) ui_byte(124);
                ui_int(ui_actions[row.actions + a].action);
                ui_byte(58);
                ui_field_bytes(ui_pool, ui_actions[row.actions + a].title.at, ui_actions[row.actions + a].title.at + ui_actions[row.actions + a].title.n)
            }
            ui_wire_runs(row.runs, row.runs_n);
            ui_wire_runs(row.truns, row.truns_n);
            ui_field_int(row.title_lines);
            ui_field_int(row.field_kind);
            ui_field(row.lead);
            ui_field_int(row.lead_style);
            ui_field(row.side);
            ui_wire_runs(row.sruns, row.sruns_n);
            ui_field(row.side_note);
            ui_byte(9);
            for a in 0..row.actions_n {
                if (a > 0) ui_byte(124);
                ui_field_bytes(ui_pool, ui_actions[row.actions + a].icon.at, ui_actions[row.actions + a].icon.at + ui_actions[row.actions + a].icon.n)
            }
            ui_byte(9);
            for l in 0..row.links_n {
                if (l > 0) ui_byte(124);
                lk: UiLink = ui_links[row.links + l];
                ui_int(lk.b);
                ui_byte(58);
                ui_int(lk.e);
                ui_byte(58);
                ui_int(lk.action);
                ui_byte(58);
                ui_int(lk.arg)
            }
            ui_byte(10);
            // (A grid's cells, a line each, after their row.)
            for c in 0..row.cells_n {
                cell: UiCell = ui_cells[row.cells + c];
                ui_str("cell");
                ui_field_int(cell.action);
                ui_field_int(cell.arg);
                ui_field_int(cell.script);
                ui_field(cell.text);
                ui_field(cell.sub);
                ui_field(cell.count);
                ui_field(cell.label);
                ui_field(cell.tr);
                ui_field_int(cell.flags);
                ui_byte(9);
                for a in 0..cell.actions_n {
                    if (a > 0) ui_byte(124);
                    ui_int(ui_actions[cell.actions + a].action);
                    ui_byte(58);
                    ui_field_bytes(ui_pool, ui_actions[cell.actions + a].title.at,
                        ui_actions[cell.actions + a].title.at + ui_actions[cell.actions + a].title.n)
                }
                ui_byte(10)
            }
        }
    }
    ui_str("end\n")
}

// The effects not yet carried out, for a skin in L8 (SKINS.md: present,
// push, update, pop, dismiss, jump, ...), oldest first.
type UiEffect = {
    word: str;
    a: int;
    b: int;
    // Words with it (a page's address: url).
    text: str
}

ui_effects: []UiEffect = new UiEffect[256](UiEffect {
    word: "",
    a: 0,
    b: 0,
    text: ""
});

ui_effects_n: int = 0;

// An effect, as a line: the word and up to two numbers (-1: none); or,
// with no wire, kept in ui_effects.
ui_effect(word: str@immortal, a: int, b: int) {
    if (!ui_wire) {
        if (ui_effects_n < len(ui_effects)) {
            ui_effects[ui_effects_n] = UiEffect {
                word: word,
                a: a,
                b: b,
                text: ""
            };
            ui_effects_n = ui_effects_n + 1
        }
        return
    }
    ui_str(word);
    if (a >= 0) {
        ui_byte(32);
        ui_int(a)
    }
    if (b >= 0) {
        ui_byte(32);
        ui_int(b)
    }
    ui_byte(10)
}

// Words with an effect (a copy's, a share's: copy WORDS), fbuf's: on
// the wire, after a tab; for a skin in L8, in ui_effect_words (its own,
// till the next).
ui_effect_words: []i8 = new i8[65536](0i8);

ui_effect_words_n: int = 0;

// A toast: its words (fbuf's) and its symbol (TOAST_), as an effect
// ("toast SYMBOL" with its words; a skin shows it its own way).
TOAST_PLUS: int = 0;

TOAST_CHECK: int = 1;

TOAST_BRAIN: int = 2;

// (The carried ribbon's glyph, in its color: the skin's.)
TOAST_RIBBON: int = 3;

toast_symbols: []str = ["plus", "checkmark", "brain", "ribbon"];

ui_toast(symbol: int) {
    ui_effect_words_n = 0;
    for i in 0..fbuf_n {
        if (ui_effect_words_n < len(ui_effect_words)) {
            ui_effect_words[ui_effect_words_n] = fbuf[i];
            ui_effect_words_n = ui_effect_words_n + 1
        }
    }
    if (!ui_wire) {
        ui_effect("toast", symbol, -1);
        return
    }
    ui_str("toast ");
    ui_int(symbol);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, fbuf_n);
    ui_byte(10)
}

ui_effect_fbuf(word: str@immortal) {
    ui_effect_words_n = 0;
    for i in 0..fbuf_n {
        if (ui_effect_words_n < len(ui_effect_words)) {
            ui_effect_words[ui_effect_words_n] = fbuf[i];
            ui_effect_words_n = ui_effect_words_n + 1
        }
    }
    if (!ui_wire) {
        ui_effect(word, -1, -1);
        return
    }
    ui_str(word);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, fbuf_n);
    ui_byte(10)
}

// A page outside the app to open (url ADDRESS).
ui_effect_url(url: str@immortal) {
    if (!ui_wire) {
        if (ui_effects_n < len(ui_effects)) {
            ui_effects[ui_effects_n] = UiEffect {
                word: "url",
                a: -1,
                b: -1,
                text: url
            };
            ui_effects_n = ui_effects_n + 1
        }
        return
    }
    ui_str("url");
    ui_field_str(url);
    ui_byte(10)
}

// A line of a word and a field of fbuf's words (title John 3).
ui_line_fbuf(word: str) {
    ui_str(word);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, fbuf_n);
    ui_byte(10)
}
