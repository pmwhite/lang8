tag bible;

use_tag std;

// Screens as data (SKINS.md): what core builds for a skin to draw. A screen
// is built row by row (ui_begin, ui_section, ui_row and the ui_set_ calls on
// the row just made), held here until the next is built, and written out
// as lines (ui_write) for a skin in another language; an L8 skin reads the
// records. Words go into a pool, so a label formatted in fbuf (store.l8)
// can be kept with ui_set_title_fbuf.
import "store.l8";

// ---- rows ----
UI_ITEM: int = 1;

UI_TOGGLE: int = 2;

UI_CHOICE: int = 3;

UI_SLIDER: int = 4;

UI_FIELD: int = 5;

UI_BUTTON: int = 6;

UI_CUSTOM: int = 7;

ui_kind_names: []str = ["", "item", "toggle", "choice", "slider", "field", "button",
    "custom"];

// An item's accessory.
ACC_NONE: int = 0;

ACC_MORE: int = 1;

ACC_CHECK: int = 2;

ACC_INFO: int = 3;

ui_acc_names: []str = ["", "more", "check", "info"];

// Words: from at, n bytes, in ui_pool.
type UiText = {
    at: int;
    n: int
}

type UiRow = {
    kind: int;
    action: int;
    arg: int;
    title: UiText;
    detail: UiText;
    icon: UiText;
    // For a choice, its options' labels split by |.
    options: UiText;
    acc: int;
    // A value shown on the right (not under the title).
    value_detail: bool;
    disabled: bool;
    destructive: bool;
    on: bool;
    value: int;
    lo: int;
    hi: int
}

type UiSection = {
    header: UiText;
    footer: UiText;
    // Its rows: ui_rows from first, n of them.
    first: int;
    n: int
}

no_text: UiText = UiText { at: 0, n: 0 };

UI_ROWS_MOST: int = 2048;

UI_SECTIONS_MOST: int = 128;

ui_rows: []UiRow = new UiRow[UI_ROWS_MOST](UiRow {
    kind: 0,
    action: 0,
    arg: 0,
    title: no_text,
    detail: no_text,
    icon: no_text,
    options: no_text,
    acc: 0,
    value_detail: false,
    disabled: false,
    destructive: false,
    on: false,
    value: 0,
    lo: 0,
    hi: 0
});

ui_rows_n: int = 0;

ui_sections: []UiSection = new UiSection[UI_SECTIONS_MOST](UiSection {
    header: no_text,
    footer: no_text,
    first: 0,
    n: 0
});

ui_sections_n: int = 0;

ui_pool: []i8 = new i8[262144](0i8);

ui_pool_n: int = 0;

// ---- the screen being built ----
ui_id: int = 0;

ui_kind: int = 0;

ui_arg: int = 0;

ui_title: UiText = UiText { at: 0, n: 0 };

ui_search: UiText = UiText { at: 0, n: 0 };

ui_put_bytes(b: []i8, from: int, to: int): UiText {
    at: int = ui_pool_n;
    for i in from..to {
        if (ui_pool_n < len(ui_pool)) {
            ui_pool[ui_pool_n] = b[i];
            ui_pool_n = ui_pool_n + 1
        }
    }
    UiText { at: at, n: ui_pool_n - at }
}

ui_put(s: str): UiText {
    at: int = ui_pool_n;
    for c in s {
        if (ui_pool_n < len(ui_pool)) {
            ui_pool[ui_pool_n] = c;
            ui_pool_n = ui_pool_n + 1
        }
    }
    UiText { at: at, n: ui_pool_n - at }
}

// (What fbuf holds now.)
ui_put_fbuf(): UiText {
    ui_put_bytes(fbuf, 0, fbuf_n)
}

ui_begin(
    id: int,
    kind: int,
    arg: int,
    title: str
) {
    ui_id = id;
    ui_kind = kind;
    ui_arg = arg;
    ui_rows_n = 0;
    ui_sections_n = 0;
    ui_pool_n = 0;
    ui_title = ui_put(title);
    ui_search = no_text
}

ui_set_screen_title_fbuf() {
    ui_title = ui_put_fbuf()
}

ui_set_search(placeholder: str) {
    ui_search = ui_put(placeholder)
}

ui_section(header: str, footer: str) {
    if (ui_sections_n >= UI_SECTIONS_MOST) return;
    ui_sections[ui_sections_n] = UiSection {
        header: ui_put(header),
        footer: ui_put(footer),
        first: ui_rows_n,
        n: 0
    };
    ui_sections_n = ui_sections_n + 1
}

ui_set_footer_fbuf() {
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].footer = ui_put_fbuf()
}

// A row of kind, its action and argument, in the last section (one made,
// headerless, if none is): later ui_set_ calls are on it.
ui_row(kind: int, action: int, arg: int) {
    if (ui_sections_n == 0) ui_section("", "");
    if (ui_rows_n >= UI_ROWS_MOST) return;
    ui_rows[ui_rows_n] = UiRow {
        kind: kind,
        action: action,
        arg: arg,
        title: no_text,
        detail: no_text,
        icon: no_text,
        options: no_text,
        acc: ACC_NONE,
        value_detail: false,
        disabled: false,
        destructive: false,
        on: false,
        value: 0,
        lo: 0,
        hi: 0
    };
    ui_rows_n = ui_rows_n + 1;
    ui_sections[ui_sections_n - 1].n = ui_sections[ui_sections_n - 1].n + 1
}

ui_last(): int {
    ui_rows_n - 1
}

ui_set_title(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].title = ui_put(s)
}

ui_set_title_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].title = ui_put_fbuf()
}

ui_set_detail(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].detail = ui_put(s)
}

ui_set_detail_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].detail = ui_put_fbuf()
}

// The detail as a value on the right.
ui_set_value_detail() {
    if (ui_rows_n > 0) ui_rows[ui_last()].value_detail = true
}

ui_set_icon(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].icon = ui_put(s)
}

ui_set_acc(acc: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].acc = acc
}

ui_set_on(on: bool) {
    if (ui_rows_n > 0) ui_rows[ui_last()].on = on
}

ui_set_disabled(off: bool) {
    if (ui_rows_n > 0) ui_rows[ui_last()].disabled = off
}

ui_set_destructive() {
    if (ui_rows_n > 0) ui_rows[ui_last()].destructive = true
}

// A choice's options (labels split by |) and the one chosen.
ui_set_options(labels: str, chosen: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].options = ui_put(labels);
    ui_rows[ui_last()].value = chosen
}

// A slider's range and value.
ui_set_range(lo: int, hi: int, value: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].lo = lo;
    ui_rows[ui_last()].hi = hi;
    ui_rows[ui_last()].value = value
}

// ---- the wire (SKINS.md): the screen as lines ----
// Lines for the skin, into ui_out from ui_out_n; the skin's host sends
// them and sets ui_out_n to 0.
ui_out: []i8 = new i8[1048576](0i8);

ui_out_n: int = 0;

ui_byte(k: int) {
    if (ui_out_n < len(ui_out)) {
        ui_out[ui_out_n] = k trunc i8;
        ui_out_n = ui_out_n + 1
    }
}

ui_str(s: str) {
    for c in s ui_byte(c as int)
}

ui_int(n: int) {
    if (n < 0) {
        ui_byte(45);
        ui_int(-n);
        return
    }
    if (n >= 10) ui_int(n / 10);
    ui_byte(48 + n % 10)
}

// Bytes as a field: a tab, a newline or a backslash escaped.
ui_field_bytes(b: []i8, from: int, to: int) {
    for i in from..to {
        k: int = b[i] as int & 255;
        if (k == 9) ui_str("\\t") else if (k == 10) ui_str("\\n") else if (k == 92) ui_str("\\\\") else ui_byte(k)
    }
}

ui_field(t: UiText) {
    ui_byte(9);
    ui_field_bytes(ui_pool, t.at, t.at + t.n)
}

ui_field_str(s: str) {
    ui_byte(9);
    for c in s {
        k: int = c as int & 255;
        if (k == 9) ui_str("\\t") else if (k == 10) ui_str("\\n") else if (k == 92) ui_str("\\\\") else ui_byte(k)
    }
}

ui_field_int(n: int) {
    ui_byte(9);
    ui_int(n)
}

// The screen built, as lines: screen, its sections and rows, end.
ui_write() {
    ui_str("screen ");
    ui_int(ui_id);
    ui_byte(32);
    ui_int(ui_kind);
    ui_byte(32);
    ui_int(ui_arg);
    ui_field(ui_title);
    ui_field(ui_search);
    ui_byte(10);
    for s in 0..ui_sections_n {
        ui_str("section");
        ui_field(ui_sections[s].header);
        ui_field(ui_sections[s].footer);
        ui_byte(10);
        first: int = ui_sections[s].first;
        for r in first..first + ui_sections[s].n {
            row: UiRow = ui_rows[r];
            ui_str("row");
            ui_field_str(ui_kind_names[row.kind]);
            ui_field_int(row.action);
            ui_field_int(row.arg);
            ui_field(row.title);
            ui_field(row.detail);
            ui_field(row.icon);
            ui_field_str(ui_acc_names[row.acc]);
            ui_byte(9);
            if (row.disabled) ui_byte(100);
            if (row.destructive) ui_byte(120);
            if (row.on) ui_byte(111);
            if (row.value_detail) ui_byte(118);
            ui_field_int(row.value);
            ui_field(row.options);
            ui_field_int(row.lo);
            ui_field_int(row.hi);
            ui_byte(10)
        }
    }
    ui_str("end\n")
}

// An effect, as a line: the word and up to two numbers (-1: none).
ui_effect(word: str, a: int, b: int) {
    ui_str(word);
    if (a >= 0) {
        ui_byte(32);
        ui_int(a)
    }
    if (b >= 0) {
        ui_byte(32);
        ui_int(b)
    }
    ui_byte(10)
}

// A line of a word and a field of fbuf's words (title John 3).
ui_line_fbuf(word: str) {
    ui_str(word);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, fbuf_n);
    ui_byte(10)
}
