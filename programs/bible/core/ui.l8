tag bible;

use_tag std;

// Screens as data (SKINS.md): what core builds for a skin to draw. A screen
// is built row by row (ui_begin, ui_section, ui_row and the ui_set_ calls on
// the row just made), held here until the next is built, and written out
// as lines (ui_write) for a skin in another language; an L8 skin reads the
// records. Words go into a pool, so a label formatted in fbuf (store.l8)
// can be kept with ui_set_title_fbuf.
import "store.l8";

// ---- rows ----
UI_ITEM: int = 1;

UI_TOGGLE: int = 2;

UI_CHOICE: int = 3;

UI_SLIDER: int = 4;

UI_FIELD: int = 5;

UI_BUTTON: int = 6;

UI_CUSTOM: int = 7;

ui_kind_names: []str = ["", "item", "toggle", "choice", "slider", "field", "button",
    "custom"];

// An item's accessory.
ACC_NONE: int = 0;

ACC_MORE: int = 1;

ACC_CHECK: int = 2;

ACC_INFO: int = 3;

// Done: a faint check (today's reading read), not to be chosen.
ACC_DONE: int = 4;

ui_acc_names: []str = ["", "more", "check", "info", "done"];

// Words: from at, n bytes, in ui_pool.
type UiText = {
    at: int;
    n: int
}

type UiRow = {
    kind: int;
    action: int;
    arg: int;
    title: UiText;
    detail: UiText;
    icon: UiText;
    // For a choice, its options' labels split by |.
    options: UiText;
    // What VoiceOver (or TalkBack) says for it, if not its words.
    label: UiText;
    // Words at its end (a time), besides a value or a subtitle.
    trailing: UiText;
    // Its subtitle is the Bible's words (the divine name in small capitals).
    scripture: bool;
    // Swiped away: this action (0: it can't be).
    delete_action: int;
    // Its own presentation, where a skin has one (core/skin.l8's CUSTOM_;
    // 0: its kind's), and what VoiceOver adds as a hint.
    custom: int;
    hint: UiText;
    // Its words faint (shown, but nothing to do).
    faint: bool;
    // Its title stronger (the row to go to, or the one where the reader
    // is), in the accent's color (a link: Show All), and its icon faint.
    strong: bool;
    tinted: bool;
    icon_faint: bool;
    // Places in its detail to stress (the words a search found): pairs of
    // UTF-16 offsets (as Java, JavaScript and NSString count), ui_marks
    // from marks, marks_n pairs.
    marks: int;
    marks_n: int;
    // Its detail in a smaller face (a note about it: Versions' lines), and
    // at most this many lines of it (0: as many as it needs).
    small: bool;
    lines: int;
    // A circle at its start (0 none; 1 empty, 2 half, 3 full: a day not
    // read, partly, read), which does circle_action (with the row's
    // argument); dimmed and inert, circle_off. Its trailing words in the
    // accent (Today).
    circle: int;
    circle_action: int;
    circle_off: bool;
    trailing_tinted: bool;
    acc: int;
    // A value shown on the right (not under the title).
    value_detail: bool;
    disabled: bool;
    destructive: bool;
    on: bool;
    value: int;
    lo: int;
    hi: int
}

type UiSection = {
    header: UiText;
    footer: UiText;
    // Its rows: ui_rows from first, n of them.
    first: int;
    n: int;
    // A section the platform makes itself, rows and all (core/skin.l8's
    // HOST_; 0: core's), where a host has one.
    host: int;
    // A button in its header (Recent Searches' Clear), and its action.
    button: UiText;
    button_action: int
}

no_text: UiText = UiText { at: 0, n: 0 };

UI_ROWS_MOST: int = 2048;

UI_SECTIONS_MOST: int = 128;

ui_rows: []UiRow = new UiRow[UI_ROWS_MOST](UiRow {
    kind: 0,
    action: 0,
    arg: 0,
    title: no_text,
    detail: no_text,
    icon: no_text,
    options: no_text,
    label: no_text,
    trailing: no_text,
    scripture: false,
    delete_action: 0,
    custom: 0,
    hint: no_text,
    faint: false,
    strong: false,
    tinted: false,
    icon_faint: false,
    marks: 0,
    marks_n: 0,
    small: false,
    lines: 0,
    circle: 0,
    circle_action: 0,
    circle_off: false,
    trailing_tinted: false,
    acc: 0,
    value_detail: false,
    disabled: false,
    destructive: false,
    on: false,
    value: 0,
    lo: 0,
    hi: 0
});

ui_rows_n: int = 0;

ui_sections: []UiSection = new UiSection[UI_SECTIONS_MOST](UiSection {
    header: no_text,
    footer: no_text,
    first: 0,
    n: 0,
    host: 0,
    button: no_text,
    button_action: 0
});

ui_sections_n: int = 0;

ui_pool: []i8 = new i8[1048576](0i8);

ui_pool_n: int = 0;

// ---- the screen being built ----
ui_id: int = 0;

ui_kind: int = 0;

ui_arg: int = 0;

ui_title: UiText = UiText { at: 0, n: 0 };

ui_search: UiText = UiText { at: 0, n: 0 };

// The row shown first, as the screen opens (-1: its top).
ui_focus: int = -1;

// The search field's words as the screen is built (put in the field when
// it is made, or when a retext effect says), and how long typing rests
// before it is sent (ms; 0: at once, as Go To's is).
ui_search_text: UiText = UiText { at: 0, n: 0 };

ui_search_wait: int = 0;

// Its Return goes (Go To's: a reference, not words to search for); and it
// takes the keys as the screen appears.
ui_search_go: bool = false;

ui_search_focus: bool = false;

// The field's scopes (titles split by |, and what a screen reader says
// for each), and the one chosen.
ui_scopes: UiText = UiText { at: 0, n: 0 };

ui_scope_labels: UiText = UiText { at: 0, n: 0 };

ui_scope: int = 0;

// A plain list (search's results), not grouped.
ui_plain: bool = false;

ui_focus_select: bool = false;

ui_focus_middle: bool = false;

ui_intro: UiText = UiText { at: 0, n: 0 };

ui_toolbar: UiText = UiText { at: 0, n: 0 };

ui_toolbar_action: int = 0;

ui_toolbar_arg: int = 0;

ui_toolbar_style: int = 0;

// The marks' offsets, for the rows' marks.
ui_marks: []int = new int[16384](0);

ui_marks_n: int = 0;

// What the screen shows with no rows: a symbol, a title, a line.
ui_empty_symbol: UiText = UiText { at: 0, n: 0 };

ui_empty_title: UiText = UiText { at: 0, n: 0 };

ui_empty_line: UiText = UiText { at: 0, n: 0 };

// A button at the top (beside Done): its title, and the commands its menu
// offers (none: no button; one, destructive: the menu its confirmation).
ui_button: UiText = UiText { at: 0, n: 0 };

type UiCommand = {
    title: UiText;
    action: int;
    arg: int;
    destructive: bool
}

ui_commands: []UiCommand = new UiCommand[16](UiCommand {
    title: UiText { at: 0, n: 0 },
    action: 0,
    arg: 0,
    destructive: false
});

ui_commands_n: int = 0;

ui_put_bytes(b: []i8, from: int, to: int): UiText {
    at: int = ui_pool_n;
    for i in from..to {
        if (ui_pool_n < len(ui_pool)) {
            ui_pool[ui_pool_n] = b[i];
            ui_pool_n = ui_pool_n + 1
        }
    }
    UiText { at: at, n: ui_pool_n - at }
}

ui_put(s: str): UiText {
    at: int = ui_pool_n;
    for c in s {
        if (ui_pool_n < len(ui_pool)) {
            ui_pool[ui_pool_n] = c;
            ui_pool_n = ui_pool_n + 1
        }
    }
    UiText { at: at, n: ui_pool_n - at }
}

// (What fbuf holds now.)
ui_put_fbuf(): UiText {
    ui_put_bytes(fbuf, 0, fbuf_n)
}

ui_begin(
    id: int,
    kind: int,
    arg: int,
    title: str
) {
    ui_id = id;
    ui_kind = kind;
    ui_arg = arg;
    ui_rows_n = 0;
    ui_sections_n = 0;
    ui_pool_n = 0;
    ui_title = ui_put(title);
    ui_search = no_text;
    ui_focus = -1;
    ui_search_text = no_text;
    ui_search_wait = 0;
    ui_search_go = false;
    ui_search_focus = false;
    ui_scopes = no_text;
    ui_scope_labels = no_text;
    ui_scope = 0;
    ui_plain = false;
    ui_marks_n = 0;
    ui_focus_select = false;
    ui_focus_middle = false;
    ui_intro = no_text;
    ui_toolbar = no_text;
    ui_toolbar_action = 0;
    ui_toolbar_arg = 0;
    ui_toolbar_style = 0;
    ui_empty_symbol = no_text;
    ui_empty_title = no_text;
    ui_empty_line = no_text;
    ui_button = no_text;
    ui_commands_n = 0
}

ui_set_empty(symbol: str, title: str, line: str) {
    ui_empty_symbol = ui_put(symbol);
    ui_empty_title = ui_put(title);
    ui_empty_line = ui_put(line)
}

ui_set_empty_title_fbuf() {
    ui_empty_title = ui_put_fbuf()
}

ui_set_button(title: str) {
    ui_button = ui_put(title)
}

ui_command(
    title: str,
    action: int,
    arg: int,
    destructive: bool
) {
    if (ui_commands_n >= len(ui_commands)) return;
    ui_commands[ui_commands_n] = UiCommand {
        title: ui_put(title),
        action: action,
        arg: arg,
        destructive: destructive
    };
    ui_commands_n = ui_commands_n + 1
}

ui_set_screen_title_fbuf() {
    ui_title = ui_put_fbuf()
}

ui_set_search(placeholder: str) {
    ui_search = ui_put(placeholder)
}

ui_set_search_text(b: []i8, n: int) {
    ui_search_text = ui_put_bytes(b, 0, n)
}

// (A scope's title and label made in fbuf: the book's, say.)
ui_set_scopes_fbuf(titles_end: int, chosen: int) {
    ui_scopes = ui_put_bytes(fbuf, 0, titles_end);
    ui_scope_labels = ui_put_bytes(fbuf, titles_end, fbuf_n);
    ui_scope = chosen
}

// A place in the last row's detail to stress: UTF-16 offsets b to e.
ui_add_mark(b: int, e: int) {
    if (ui_rows_n == 0 || ui_marks_n + 2 > len(ui_marks)) return;
    i: int = ui_last();
    if (ui_rows[i].marks_n == 0) ui_rows[i].marks = ui_marks_n;
    ui_marks[ui_marks_n] = b;
    ui_marks[ui_marks_n + 1] = e;
    ui_marks_n = ui_marks_n + 2;
    ui_rows[i].marks_n = ui_rows[i].marks_n + 1
}

ui_section(header: str, footer: str) {
    if (ui_sections_n >= UI_SECTIONS_MOST) return;
    ui_sections[ui_sections_n] = UiSection {
        header: ui_put(header),
        footer: ui_put(footer),
        first: ui_rows_n,
        n: 0,
        host: 0,
        button: no_text,
        button_action: 0
    };
    ui_sections_n = ui_sections_n + 1
}

// A button in the last section's header, doing action.
ui_set_section_button(title: str, action: int) {
    if (ui_sections_n == 0) return;
    ui_sections[ui_sections_n - 1].button = ui_put(title);
    ui_sections[ui_sections_n - 1].button_action = action
}

// A section of the platform's own (its rows, header and footer its own).
ui_host_section(host: int) {
    ui_section("", "");
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].host = host
}

ui_set_header_fbuf() {
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].header = ui_put_fbuf()
}

ui_set_footer_fbuf() {
    if (ui_sections_n > 0) ui_sections[ui_sections_n - 1].footer = ui_put_fbuf()
}

// A row of kind, its action and argument, in the last section (one made,
// headerless, if none is): later ui_set_ calls are on it.
ui_row(kind: int, action: int, arg: int) {
    if (ui_sections_n == 0) ui_section("", "");
    if (ui_rows_n >= UI_ROWS_MOST) return;
    ui_rows[ui_rows_n] = UiRow {
        kind: kind,
        action: action,
        arg: arg,
        title: no_text,
        detail: no_text,
        icon: no_text,
        options: no_text,
        label: no_text,
        trailing: no_text,
        scripture: false,
        delete_action: 0,
        custom: 0,
        hint: no_text,
        faint: false,
        strong: false,
        tinted: false,
        icon_faint: false,
        marks: 0,
        marks_n: 0,
        small: false,
        lines: 0,
        circle: 0,
        circle_action: 0,
        circle_off: false,
        trailing_tinted: false,
        acc: ACC_NONE,
        value_detail: false,
        disabled: false,
        destructive: false,
        on: false,
        value: 0,
        lo: 0,
        hi: 0
    };
    ui_rows_n = ui_rows_n + 1;
    ui_sections[ui_sections_n - 1].n = ui_sections[ui_sections_n - 1].n + 1
}

ui_last(): int {
    ui_rows_n - 1
}

ui_set_title(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].title = ui_put(s)
}

ui_set_title_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].title = ui_put_fbuf()
}

ui_set_detail(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].detail = ui_put(s)
}

ui_set_detail_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].detail = ui_put_fbuf()
}

// The detail as a value on the right.
ui_set_trailing_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].trailing = ui_put_fbuf()
}

ui_set_custom(custom: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].custom = custom
}

ui_set_hint(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].hint = ui_put(s)
}

ui_set_faint() {
    if (ui_rows_n > 0) ui_rows[ui_last()].faint = true
}

ui_set_strong() {
    if (ui_rows_n > 0) ui_rows[ui_last()].strong = true
}

ui_set_tinted() {
    if (ui_rows_n > 0) ui_rows[ui_last()].tinted = true
}

ui_set_icon_faint() {
    if (ui_rows_n > 0) ui_rows[ui_last()].icon_faint = true
}

ui_set_small() {
    if (ui_rows_n > 0) ui_rows[ui_last()].small = true
}

ui_set_lines(n: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].lines = n
}

ui_set_circle(state: int, action: int, off: bool) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].circle = state + 1;
    ui_rows[ui_last()].circle_action = action;
    ui_rows[ui_last()].circle_off = off
}

ui_set_trailing_tinted() {
    if (ui_rows_n > 0) ui_rows[ui_last()].trailing_tinted = true
}

// The focus row also selected (the day the plan's days were opened for),
// in the middle.
ui_set_focus_selected() {
    ui_set_focus();
    ui_focus_select = true
}

// The focus row in the middle, not at the top (a chooser's choice).
ui_set_focus_middle() {
    ui_set_focus();
    ui_focus_middle = true
}

// Words above the first section (a plan's description).
ui_set_intro_fbuf() {
    ui_intro = ui_put_fbuf()
}

// A button at the screen's foot (Start Plan), doing action with arg:
// prominent, destructive (Stop Plan), or off.
ui_set_toolbar(
    title: str,
    action: int,
    arg: int,
    style: int
) {
    ui_toolbar = ui_put(title);
    ui_toolbar_action = action;
    ui_toolbar_arg = arg;
    ui_toolbar_style = style
}

UI_TOOL_PLAIN: int = 0;

UI_TOOL_PROMINENT: int = 1;

UI_TOOL_DESTRUCTIVE: int = 2;

UI_TOOL_OFF: int = 3;

// The row just made, shown first.
ui_set_focus() {
    if (ui_rows_n > 0) ui_focus = ui_last()
}

ui_set_scripture() {
    if (ui_rows_n > 0) ui_rows[ui_last()].scripture = true
}

// Swiping the row away does action (with the row's argument).
ui_set_delete(action: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].delete_action = action
}

ui_set_label_fbuf() {
    if (ui_rows_n > 0) ui_rows[ui_last()].label = ui_put_fbuf()
}

ui_set_value_detail() {
    if (ui_rows_n > 0) ui_rows[ui_last()].value_detail = true
}

ui_set_icon(s: str) {
    if (ui_rows_n > 0) ui_rows[ui_last()].icon = ui_put(s)
}

ui_set_acc(acc: int) {
    if (ui_rows_n > 0) ui_rows[ui_last()].acc = acc
}

ui_set_on(on: bool) {
    if (ui_rows_n > 0) ui_rows[ui_last()].on = on
}

ui_set_disabled(off: bool) {
    if (ui_rows_n > 0) ui_rows[ui_last()].disabled = off
}

ui_set_destructive() {
    if (ui_rows_n > 0) ui_rows[ui_last()].destructive = true
}

// A choice's options (labels split by |) and the one chosen.
ui_set_options(labels: str, chosen: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].options = ui_put(labels);
    ui_rows[ui_last()].value = chosen
}

// A slider's range and value.
ui_set_range(lo: int, hi: int, value: int) {
    if (ui_rows_n == 0) return;
    ui_rows[ui_last()].lo = lo;
    ui_rows[ui_last()].hi = hi;
    ui_rows[ui_last()].value = value
}

// ---- the wire (SKINS.md): the screen as lines ----
// Lines for the skin, into ui_out from ui_out_n; the skin's host sends
// them and sets ui_out_n to 0. A skin in L8 (the iPhone's) has none
// (ui_wire false): it reads the records, and the effects from ui_effects.
ui_wire: bool = true;

ui_out: []i8 = new i8[1048576](0i8);

ui_out_n: int = 0;

ui_byte(k: int) {
    if (!ui_wire) return;
    if (ui_out_n < len(ui_out)) {
        ui_out[ui_out_n] = k trunc i8;
        ui_out_n = ui_out_n + 1
    }
}

ui_str(s: str) {
    for c in s ui_byte(c as int)
}

ui_int(n: int) {
    if (n < 0) {
        ui_byte(45);
        ui_int(-n);
        return
    }
    if (n >= 10) ui_int(n / 10);
    ui_byte(48 + n % 10)
}

// Bytes as a field: a tab, a newline or a backslash escaped.
ui_field_bytes(b: []i8, from: int, to: int) {
    for i in from..to {
        k: int = b[i] as int & 255;
        if (k == 9) ui_str("\\t") else if (k == 10) ui_str("\\n") else if (k == 92) ui_str("\\\\") else ui_byte(k)
    }
}

ui_field(t: UiText) {
    ui_byte(9);
    ui_field_bytes(ui_pool, t.at, t.at + t.n)
}

ui_field_str(s: str) {
    ui_byte(9);
    for c in s {
        k: int = c as int & 255;
        if (k == 9) ui_str("\\t") else if (k == 10) ui_str("\\n") else if (k == 92) ui_str("\\\\") else ui_byte(k)
    }
}

ui_field_int(n: int) {
    ui_byte(9);
    ui_int(n)
}

// The screen built, as lines: screen, its sections and rows, end.
ui_write() {
    ui_str("screen ");
    ui_int(ui_id);
    ui_byte(32);
    ui_int(ui_kind);
    ui_byte(32);
    ui_int(ui_arg);
    ui_field(ui_title);
    ui_field(ui_search);
    ui_byte(10);
    if (ui_focus >= 0) {
        ui_str("focus ");
        ui_int(ui_focus);
        if (ui_focus_select) ui_str(" 1") else if (ui_focus_middle) ui_str(" 2");
        ui_byte(10)
    }
    if (ui_intro.n > 0) {
        ui_str("intro");
        ui_field(ui_intro);
        ui_byte(10)
    }
    if (ui_toolbar.n > 0) {
        ui_str("toolbar");
        ui_field_int(ui_toolbar_action);
        ui_field_int(ui_toolbar_arg);
        ui_field(ui_toolbar);
        ui_field_int(ui_toolbar_style);
        ui_byte(10)
    }
    if (ui_search.n > 0) {
        ui_str("field");
        ui_field(ui_search_text);
        ui_field_int(ui_search_wait);
        ui_byte(9);
        if (ui_search_go) ui_byte(103);
        if (ui_search_focus) ui_byte(102);
        ui_byte(10)
    }
    if (ui_scopes.n > 0) {
        ui_str("scopes");
        ui_field_int(ui_scope);
        ui_field(ui_scopes);
        ui_field(ui_scope_labels);
        ui_byte(10)
    }
    if (ui_plain) ui_str("plain\n");
    if (ui_empty_title.n > 0) {
        ui_str("empty");
        ui_field(ui_empty_symbol);
        ui_field(ui_empty_title);
        ui_field(ui_empty_line);
        ui_byte(10)
    }
    if (ui_button.n > 0) {
        ui_str("button");
        ui_field(ui_button);
        ui_byte(10);
        for i in 0..ui_commands_n {
            ui_str("command");
            ui_field_int(ui_commands[i].action);
            ui_field_int(ui_commands[i].arg);
            ui_field(ui_commands[i].title);
            ui_byte(9);
            if (ui_commands[i].destructive) ui_byte(120);
            ui_byte(10)
        }
    }
    for s in 0..ui_sections_n {
        ui_str("section");
        ui_field(ui_sections[s].header);
        ui_field(ui_sections[s].footer);
        ui_field_int(ui_sections[s].host);
        ui_field(ui_sections[s].button);
        ui_field_int(ui_sections[s].button_action);
        ui_byte(10);
        first: int = ui_sections[s].first;
        for r in first..first + ui_sections[s].n {
            row: UiRow = ui_rows[r];
            ui_str("row");
            ui_field_str(ui_kind_names[row.kind]);
            ui_field_int(row.action);
            ui_field_int(row.arg);
            ui_field(row.title);
            ui_field(row.detail);
            ui_field(row.icon);
            ui_field_str(ui_acc_names[row.acc]);
            ui_byte(9);
            if (row.disabled) ui_byte(100);
            if (row.destructive) ui_byte(120);
            if (row.on) ui_byte(111);
            if (row.value_detail) ui_byte(118);
            if (row.scripture) ui_byte(115);
            if (row.faint) ui_byte(102);
            if (row.strong) ui_byte(98);
            if (row.tinted) ui_byte(116);
            if (row.icon_faint) ui_byte(103);
            if (row.small) ui_byte(109);
            if (row.circle_off) ui_byte(107);
            if (row.trailing_tinted) ui_byte(97);
            ui_field_int(row.value);
            ui_field(row.options);
            ui_field_int(row.lo);
            ui_field_int(row.hi);
            ui_field(row.label);
            ui_field(row.trailing);
            ui_field_int(row.delete_action);
            ui_field_int(row.custom);
            ui_field(row.hint);
            ui_byte(9);
            for m in 0..row.marks_n {
                if (m > 0) ui_byte(32);
                ui_int(ui_marks[row.marks + m * 2]);
                ui_byte(32);
                ui_int(ui_marks[row.marks + m * 2 + 1])
            }
            ui_field_int(row.lines);
            ui_field_int(row.circle);
            ui_field_int(row.circle_action);
            ui_byte(10)
        }
    }
    ui_str("end\n")
}

// The effects not yet carried out, for a skin in L8 (SKINS.md: present,
// push, update, pop, dismiss, jump, ...), oldest first.
type UiEffect = {
    word: str;
    a: int;
    b: int
}

ui_effects: []UiEffect = new UiEffect[256](UiEffect { word: "", a: 0, b: 0 });

ui_effects_n: int = 0;

// An effect, as a line: the word and up to two numbers (-1: none); or,
// with no wire, kept in ui_effects.
ui_effect(word: str@immortal, a: int, b: int) {
    if (!ui_wire) {
        if (ui_effects_n < len(ui_effects)) {
            ui_effects[ui_effects_n] = UiEffect { word: word, a: a, b: b };
            ui_effects_n = ui_effects_n + 1
        }
        return
    }
    ui_str(word);
    if (a >= 0) {
        ui_byte(32);
        ui_int(a)
    }
    if (b >= 0) {
        ui_byte(32);
        ui_int(b)
    }
    ui_byte(10)
}

// A line of a word and a field of fbuf's words (title John 3).
ui_line_fbuf(word: str) {
    ui_str(word);
    ui_byte(9);
    ui_field_bytes(fbuf, 0, fbuf_n);
    ui_byte(10)
}
