tag bible;

use_tag std;

// Jumps (DESIGN.md §3.1.6, §6.4, §11.1.3), apart from any platform: what a
// jump does before and after the reader moves. The place left goes onto
// the way back and the history (an origin: where the reader was, or the
// verse a sheet was opened on), the carried ribbon is put down, and the
// place arrived at goes onto the history. A jump from a plan's day leaves
// the day as the way back. The capsule goes back to the newest place left
// (or day), leaving this one in turn, and picks up again the ribbon the
// jump it undoes put down. Opening a ribbon is a jump to its place (none,
// in the chapter on the screen) that picks it up. A skin measures the
// origin and moves the reader.
import "skin.l8";

// Where the reader is, as a jump's origin (jp_o*): chapter c's verse it
// arrived at (arrived_v), if it hasn't moved since, else its place (v,
// frac); from a sheet opened on a verse of this chapter (sheet_c,
// sheet_v), that verse, exactly.
jp_oc: int = -1;

jp_ov: int = 0;

jp_of: int = 0;

jp_oe: bool = false;

jp_pick(
    c: int,
    v: int,
    frac: int,
    arrived_v: int,
    sheet_c: int,
    sheet_v: int
) {
    jp_oc = c;
    jp_ov = (if (arrived_v > 0) arrived_v else v);
    jp_of = frac;
    jp_oe = arrived_v > 0;
    if (sheet_v > 0 && sheet_c == c) {
        jp_ov = sheet_v;
        jp_of = 0;
        jp_oe = true
    }
}

// The place left (an origin): onto the way back and the history.
jp_origin(
    c: int,
    v: int,
    frac: int,
    exact: bool
) {
    back_push(c, v, frac, exact);
    history_add(c, v, frac, exact, time(0));
    sk_kept(SK_KEPT_HISTORY)
}

// The place arrived at (v 0: the chapter), onto the history.
jp_arrived(c: int, v: int) {
    history_add(c, v, 0, v > 0, time(0));
    sk_kept(SK_KEPT_HISTORY)
}

// A jump to c:v from the origin given: the carried ribbon put down, the
// origin left, the destination arrived at.
jp_jump(
    c: int,
    v: int,
    oc: int,
    ov: int,
    of: int,
    oexact: bool
) {
    rd_jump(0);
    if (oc >= 0) jp_origin(oc, ov, of, oexact);
    jp_arrived(c, v)
}

// A jump to c:v out of day d of plan p: the way back is the day.
jp_jump_day(
    c: int,
    v: int,
    p: int,
    d: int
) {
    back_push_day(p, d);
    jp_arrived(c, v)
}

// The capsule tapped, from the origin given: 0 nothing to go back to; 1 a
// place (jp_to_c, jp_to_v, jp_to_f, jp_to_exact: the skin goes there, then
// says jp_back_arrived); 2 a plan's day (jp_to_c its plan, jp_to_v its
// day: the skin opens it).
jp_to_c: int = 0;

jp_to_v: int = 0;

jp_to_f: int = 0;

jp_to_exact: bool = false;

jp_back(
    oc: int,
    ov: int,
    of: int,
    oexact: bool
): int {
    if (bk_n == 0) return 0;
    i: int = bk_n - 1;
    bk_n = bk_n - 1;
    if (bk_day[i] > 0) {
        jp_to_c = bk_plan[i];
        jp_to_v = bk_day[i];
        return 2
    }
    jp_to_c = bk_c[i];
    jp_to_v = bk_v[i];
    jp_to_f = bk_frac[i];
    jp_to_exact = bk_exact[i];
    // (A jump, so the carried ribbon is put down; the one the jump it
    // undoes put down picked up again once there: P4.)
    rd_jump(1);
    if (oc >= 0) jp_origin(oc, ov, of, oexact);
    jp_arrived(jp_to_c, if (jp_to_exact) jp_to_v else 0);
    1
}

jp_back_arrived() {
    rd_capsule_arrived()
}

// Ribbon i opened from the origin given: its place (jp_to_*; the skin goes
// there); whether it is in the chapter on the screen (no way back, no
// history: review r6-1). Then it is carried, with its toast.
jp_ribbon(
    i: int,
    oc: int,
    ov: int,
    of: int,
    oexact: bool
): bool {
    if (i < 0 || i >= rb_n) return false;
    jp_to_c = rb_c[i];
    jp_to_v = rb_v[i];
    jp_to_f = rb_frac[i];
    jp_to_exact = false;
    here: bool = rb_c[i] == oc;
    rd_jump(if (here) 2 else 0);
    if (!here) {
        if (oc >= 0) jp_origin(oc, ov, of, oexact);
        history_add(rb_c[i], rb_v[i], rb_frac[i], false, time(0));
        sk_kept(SK_KEPT_HISTORY)
    }
    ribbon_pick_up(rb_id[i], false);
    rd_ribbons_changed();
    fput_reading_with(i);
    ui_toast(TOAST_RIBBON);
    here
}

// ---- for a skin without jumps of its own ----
// (The verse arrived at, until the reader is moved; a verse Study was
// opened on over the reader, until the next jump.)
jp_arrived_c: int = -1;

jp_arrived_v: int = 0;

jp_sheet_c: int = -1;

jp_sheet_v: int = 0;

jp_here() {
    jp_pick(sk_c, sk_v, sk_frac, if (jp_arrived_c == sk_c) jp_arrived_v else 0, jp_sheet_c,
        jp_sheet_v);
    jp_sheet_v = 0
}

// (SK_NUM_OWN_JUMPS: the iPhone measures its origins and does these
// itself. Any other: core does them at its place, sk_c, sk_v, sk_frac, and
// says where the reader goes (place C V FRAC) and what the capsule reads
// (back WORDS; none, its words empty).)
SK_NUM_OWN_JUMPS: int = 19;

jp_own(): bool {
    sk_num_of(SK_NUM_OWN_JUMPS, 0) == 1
}

// The capsule's words, said (or none: not to show, bk_may_show).
jp_capsule() {
    t: int = sk_top();
    if (bk_may_show(sk_sel_n > 0, lw_on, t >= 0 && sk_kinds[t] == SCR_DAY)) bk_title() else fbuf_n = 0;
    ui_effect_fbuf("back")
}

// The reader to chapter c's verse v, frac into it.
jp_place(c: int, v: int, frac: int) {
    jp_arrived_c = c;
    jp_arrived_v = (if (frac == 0) v else 0);
    ui_effect("place", c, v * 1000 + frac)
}

// The capsule tapped.
sk_back() {
    jp_here();
    k: int = jp_back(jp_oc, jp_ov, jp_of, jp_oe);
    if (k == 2) {
        jp_capsule();
        sk_open_day(jp_to_c, jp_to_v);
        return
    }
    if (k == 0) return;
    jp_place(jp_to_c, jp_to_v, if (jp_to_exact) 0 else jp_to_f);
    // (The skin's place line, once there, moves sk_c and the title.)
    jp_back_arrived();
    jp_capsule()
}

// Ribbon i opened (or made, and picked up): there, carried.
sk_ribbon_go(i: int) {
    jp_here();
    here: bool = jp_ribbon(i, jp_oc, jp_ov, jp_of, jp_oe);
    sk_n = 0;
    ui_effect("dismiss", -1, -1);
    jp_place(jp_to_c, jp_to_v, jp_to_f);
    // (A ribbon's place is not a verse arrived at.)
    jp_arrived_v = 0;
    if (!here) jp_capsule()
}
