tag bible;

use_tag std;

// A word of the Hebrew and Greek tapped in the reader (DESIGN.md Â§14.11.4),
// apart from any platform: what its popover says, part by part (where it
// is, the Hebrew's own numbering where it differs; its form; its
// transliteration; its gloss; its meaning here; its parsing; the Qere and
// Ketiv), whether it has a Word Study, and Learn This Word or how its card
// stands. A skin lays them out in its own type.
import "skin.l8";

WP_WHERE: int = 0;

WP_FORM: int = 1;

WP_TR: int = 2;

WP_GLOSS: int = 3;

WP_MEANING: int = 4;

WP_PARSING: int = 5;

WP_QERE: int = 6;

// Part of word w's popover into fbuf (empty: the part is not there).
wp_part(w: int, part: int) {
    fbuf_n = 0;
    if (w < 0 || w >= og_n) return;
    if (part == WP_WHERE) {
        og_where(w);
        og_verse(og_wc, og_wv);
        fput_ref(og_wc, if (og_wv > 0) og_wv else 1, 0);
        if (og_wv == 0) fput_str(", title");
        if (og_hn_c > 0) {
            fput_str(" \Â\· Hebrew ");
            fput_int(og_hn_c);
            fput_str(":");
            fput_int(og_hn_v)
        }
    } else if (part == WP_FORM) fput_og_form(w) else if (part == WP_TR) {
        if (!fput_og_translit(w)) fbuf_n = 0
    } else if (part == WP_GLOSS) fput_og_gloss(w) else if (part == WP_MEANING) {
        if (!fput_og_meaning(w)) fbuf_n = 0
    } else if (part == WP_PARSING) {
        plain_parsing(og_morph(w));
        for i in 0..pl_n fput(pl[i] as int)
    } else if (part == WP_QERE) {
        if ((og_flags(w) & OG_QERE) != 0 && og_ketiv(w)) {
            fput_str("Read as shown (Qere); written ");
            fput_rli();
            for i in kt_b..kt_e fput(lket[i] as int);
            fput_pdi();
            fput_str(" (Ketiv)")
        }
    }
}

// Whether word w has a Word Study (the BSB's tables have it).
wp_has_study(w: int): bool {
    w >= 0 && w < og_n && og_join(w) >= 0
}

// Word w's card: -1 none to be had (not a word Learn teaches), -2 none yet
// (Learn This Word), else its card.
wp_card(w: int): int {
    if (w < 0 || w >= og_n) return -1;
    num: int = og_strongs(w);
    if (num <= 0 || !learnable(og_lang(w), num)) return -1;
    k: int = card_of_word(og_lang(w), num);
    if (k < 0) -2 else k
}

wp_learn_title: str = "Learn This Word";

wp_study_title: str = "Word Study";

// How card k stands, in Learn This Word's place: "Learning Â· next review
// Thursday", into fbuf.
fput_wp_card(k: int) {
    td: int = sk_today_now();
    if (cd_known(k)) fput_str("Known") else fput_str("Learning");
    fput_str(" \Â\· ");
    if (cd_state[k] == MS_NEW) fput_str("in your next practice") else if (cd_due[k] <= td) fput_str("to review today") else {
        fput_str("next review ");
        fput_day_word(cd_due[k], td)
    }
}

// Learn This Word: word w's card made (-1: it could not be); the toast's
// words then are wp_added's.
wp_learn_word(w: int): int {
    if (w < 0 || w >= og_n) return -1;
    k: int = learn_add_word(og_lang(w), og_strongs(w), FROM_STUDY, sk_today_now(),
        time(0));
    if (k >= 0) sk_kept(SK_KEPT_CARDS);
    k
}

wp_added(w: int): str {
    if (og_lang(w) == 0) "Added to Greek Words" else "Added to Hebrew Words"
}

// ---- core's screen of it (a skin without its own popover) ----
// (word W, a link of KIND 2's: word W of the original tapped.)
SCR_WORD: int = 48;

ACT_WP_STUDY: int = 181;

ACT_WP_LEARN: int = 182;

sk_word(w: int) {
    if (w < 0 || w >= og_n) return;
    sk_open(SCR_WORD, w, sk_n > 0)
}

// Its title the word's form; its parts a paragraph each; its card's line,
// or Learn This Word; Word Study.
wp_shown: []int = [WP_WHERE, WP_TR, WP_GLOSS, WP_MEANING, WP_PARSING, WP_QERE];

wp_styles: []int = [RUN_SMALL, RUN_TRANSLIT, RUN_STRONG, RUN_PLAIN, RUN_FAINT, RUN_FAINT];

sk_build_word(id: int, w: int) {
    wp_part(w, WP_FORM);
    ui_begin(id, SCR_WORD, w, "");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_page = true;
    ui_section("", "");
    for i in 0..len(wp_shown) {
        wp_part(w, wp_shown[i]);
        if (fbuf_n > 0) {
            ui_row(UI_TEXT, 0, wp_shown[i]);
            ui_rich_begin();
            wp_part(w, wp_shown[i]);
            ui_rich(wp_styles[i]);
            ui_rich_title()
        }
    }
    k: int = wp_card(w);
    if (k >= 0) {
        ui_row(UI_TEXT, 0, 9);
        ui_rich_begin();
        fbuf_n = 0;
        fput_wp_card(k);
        ui_rich(RUN_FAINT);
        ui_rich_title()
    }
    if (k == -2) ui_tool(wp_learn_title, "", ACT_WP_LEARN, w, UI_TOOL_PLAIN, 0);
    if (wp_has_study(w)) ui_tool(wp_study_title, "", ACT_WP_STUDY, w, UI_TOOL_PROMINENT,
        2)
}

sk_wp_act(at: int, action: int, w: int) {
    if (action == ACT_WP_STUDY) {
        j: int = og_join(w);
        if (j < 0) return;
        sk_study_open(word_verse(j), j, w_greek(j), w_strongs(j), false, true);
        return
    }
    if (wp_learn_word(w) < 0) return;
    fbuf_n = 0;
    fput_str(wp_added(w));
    ui_toast(TOAST_PLUS);
    sk_build(at);
    ui_effect("update", sk_ids[at], -1)
}
