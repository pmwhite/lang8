tag bible;

use_tag std;

// A word of the Hebrew and Greek tapped in the reader (DESIGN.md ยง14.11.4),
// apart from any platform: what its popover says, part by part (where it
// is, the Hebrew's own numbering where it differs; its form; its
// transliteration; its gloss; its meaning here; its parsing; the Qere and
// Ketiv), and whether it has a Word Study. A skin lays them out in its own
// type.
import "skin.l8";

WP_WHERE: int = 0;

WP_FORM: int = 1;

WP_TR: int = 2;

WP_GLOSS: int = 3;

WP_MEANING: int = 4;

WP_PARSING: int = 5;

WP_QERE: int = 6;

// Part of word w's popover into fbuf (empty: the part is not there).
wp_part(language: *LanguageData, w: int, part: int) {
    fbuf_n = 0;
    if (w < 0 || w >= og_n) return;
    if (part == WP_WHERE) {
        og_where(w);
        og_verse(og_wc, og_wv);
        fput_ref(og_wc, if (og_wv > 0) og_wv else 1, 0);
        if (og_wv == 0) fput_str(", title");
        if (og_hn_c > 0) {
            fput_str(" \ย\ท Hebrew ");
            fput_int(og_hn_c);
            fput_str(":");
            fput_int(og_hn_v)
        }
    } else if (part == WP_FORM) fput_og_form(language, w) else if (part == WP_TR) {
        if (!fput_og_translit(language, w)) fbuf_n = 0
    } else if (part == WP_GLOSS) fput_og_gloss(language, w) else if (part == WP_MEANING) {
        if (!fput_og_meaning(language, w)) fbuf_n = 0
    } else if (part == WP_PARSING) {
        plain_parsing(language, og_morph(w));
        for i in 0..pl_n fput(pl[i] as int)
    } else if (part == WP_QERE) {
        if ((og_flags(w) & OG_QERE) != 0) {
            fput_str("Read as shown (Qere); written ");
            fput_rli();
            had: bool = fput_og_ketiv(w);
            fput_pdi();
            fput_str(" (Ketiv)");
            if (!had) fbuf_n = 0
        }
    }
}

// Whether word w has a Word Study (the BSB's tables have it).
wp_has_study(w: int): bool {
    w >= 0 && w < og_n && og_join(w) >= 0
}

wp_study_title: str = "Word Study";

// ---- core's screen of it (a skin without its own popover) ----
// (word W, a link of KIND 2's: word W of the original tapped.)
SCR_WORD: int = 48;

ACT_WP_STUDY: int = 181;

// About This Form (the word's Grammar).
ACT_WP_FORM: int = 337;

sk_word(w: int) {
    if (w < 0 || w >= og_n) return;
    sk_open(SCR_WORD, w, sk_n > 0)
}

// Its title the word's form; its parts a paragraph each; About This Form;
// Word Study.
wp_shown: []int = [WP_WHERE, WP_TR, WP_GLOSS, WP_MEANING, WP_PARSING, WP_QERE];

wp_styles: []int = [RUN_SMALL, RUN_TRANSLIT, RUN_STRONG, RUN_PLAIN, RUN_FAINT, RUN_FAINT];

sk_build_word(language: *LanguageData, id: int, w: int) {
    wp_part(language, w, WP_FORM);
    ui_begin(id, SCR_WORD, w, "");
    ui_set_screen_title_fbuf();
    ui_plain = true;
    ui_page = true;
    ui_section("", "");
    for i in 0..len(wp_shown) {
        wp_part(language, w, wp_shown[i]);
        if (fbuf_n > 0) {
            ui_row(UI_TEXT, 0, wp_shown[i]);
            ui_rich_begin();
            wp_part(language, w, wp_shown[i]);
            ui_rich(wp_styles[i]);
            ui_rich_title()
        }
    }
    // (The form explained: what may be wanted of a word met in reading.)
    j: int = og_join(w);
    if (j >= 0) {
        ui_section("", "");
        ui_row(UI_ITEM, ACT_WP_FORM, w);
        ui_set_title("About This Form");
        ui_set_icon("text.book.closed");
        ui_set_acc(ACC_MORE)
    }
    if (wp_has_study(w)) ui_tool(wp_study_title, "", ACT_WP_STUDY, w, UI_TOOL_PROMINENT,
        2)
}

sk_wp_act(language: *LanguageData, action: int, w: int) {
    j: int = og_join(w);
    if (j < 0) return;
    if (action == ACT_WP_FORM) sk_grammar_open(word_verse(language, j), j, w_greek(language,
        j), w_strongs(language, j), true) else sk_study_open(word_verse(language,
        j), j, w_greek(language, j), w_strongs(language, j), false, true)
}
