tag bible;

use_tag std;

// Platform-independent Manual data: data/help.txt is parsed into pages,
// parts and paragraphs. Validation reports invalid links, anchors, symbols,
// identifiers and house style in the Manual's problems. Markup becomes
// display runs or plain words for search and VoiceOver, with symbols
// expanded to their names.
//
// The Manual is a dataset of its own: its words and what is read from them
// built in an arena of their own (manual_read), held by `manual`, and
// replaced whole when the file comes again (manual_came), the old one let
// go. Its readers take the Manual they are given, borrowed for what they
// do; positions are byte offsets into its text.
import "store.l8";

// A page: its id and title (byte ranges in the text), its symbol (an index
// of hsym_names, -1 none) and its parts (part_count of them from
// first_part).
type ManualPage = {
    id_b: int;
    id_e: int;
    title_b: int;
    title_e: int;
    symbol: int;
    first_part: int;
    part_count: int
}

// A part: its page, id, heading and paragraphs.
type ManualPart = {
    page: int;
    id_b: int;
    id_e: int;
    heading_b: int;
    heading_e: int;
    first_para: int;
    para_count: int
}

// A paragraph: its bytes and its part.
type ManualPara = {
    b: int;
    e: int;
    part: int
}

type Manual = {
    // The platform's Manual: help.txt with the lines for other platforms
    // left out and {device} said as this one says it.
    text: []i8;
    size: int;
    pages: []ManualPage;
    page_count: int;
    parts: []ManualPart;
    part_count: int;
    paras: []ManualPara;
    para_count: int;
    // What is wrong, a line each ("help.txt:12: ..."): the first
    // MANUAL_PROBLEMS_SHOWN bytes of them, and how many there are.
    problems: []i8;
    problems_n: int;
    problem_count: int;
    // The line being read (for its problems' lines).
    line: int
}

MANUAL_PROBLEMS_SHOWN: int = 16384;

// The Manual (none until help.txt has come).
manual: ?owned *Manual = null;

// ---- the closed lists ----
// The SF Symbols the manual may draw, each with what VoiceOver says for it.
hsym_names: []str = ["magnifyingglass", "bookmark", "textformat.size", "xmark", "circle.slash",
    "doc.on.doc", "square.and.arrow.up", "square.and.pencil", "character.book.closed",
    "brain", "note.text", "arrow.up.arrow.down", "info.circle", "chevron.up", "chevron.down",
    "plus", "keyboard", "book", "arrow.right.circle", "hand.tap", "bookmark.fill",
    "calendar", "books.vertical", "headphones", "textformat.abc"];

hsym_spoken: []str = ["the Search button", "the bookmark button", "the Reading Settings button",
    "the Close button", "the Remove Highlight button", "the Copy button", "the Share button",
    "the pencil button", "the Study button", "the Memorize button", "the note mark",
    "the Sort button", "the More Info button", "the up arrow", "the down arrow", "the Add button",
    "the keyboard button", "a book", "an arrow", "a hand", "a ribbon", "a calendar",
    "books", "headphones", "letters"];

// ---- its problems ----
hl_put(m: *Manual, k: int) {
    if (m.problems_n < len(m.problems)) {
        m.problems[m.problems_n] = k trunc i8;
        m.problems_n = m.problems_n + 1
    }
}

hl_str(m: *Manual, s: str) {
    for k in s hl_put(m, k as int)
}

hl_int(m: *Manual, n: int) {
    if (n >= 10) hl_int(m, n / 10);
    hl_put(m, 48 + n % 10)
}

hl_bytes(m: *Manual, b: int, e: int) {
    for i in b..e hl_put(m, m.text[i] as int)
}

he_begin(m: *Manual) {
    m.problem_count = m.problem_count + 1;
    hl_str(m, "help.txt:");
    hl_int(m, m.line);
    hl_str(m, ": ")
}

he_end(m: *Manual) {
    hl_put(m, 10)
}

// ---- bytes ----
hlb(m: *Manual, i: int): int {
    m.text[i] as int & 255
}

hlp_is(
    m: *Manual,
    b: int,
    e: int,
    s: str
): bool {
    if (e - b != len(s)) return false;
    for i in 0..len(s)
        if (m.text[b + i] != s[i]) return false;
    true
}

hlp_same(
    m: *Manual,
    b1: int,
    e1: int,
    b2: int,
    e2: int
): bool {
    if (e1 - b1 != e2 - b2) return false;
    for i in 0..e1 - b1
        if (m.text[b1 + i] != m.text[b2 + i]) return false;
    true
}

hlp_starts(
    m: *Manual,
    b: int,
    e: int,
    s: str
): bool {
    if (e - b < len(s)) return false;
    for i in 0..len(s)
        if (m.text[b + i] != s[i]) return false;
    true
}

// The next tab at or after p (or e).
hlp_tab(m: *Manual, p: int, e: int): int {
    q: int = p;
    while (q < e && hlb(m, q) != 9) q = q + 1;
    q
}

// The index of the name text[b..e) in a list, or -1.
help_name_in(
    m: *Manual,
    b: int,
    e: int,
    names: []str
): int {
    for i in 0..len(names)
        if (hlp_is(m, b, e, names[i])) return i;
    -1
}

// The part named by the anchor text[b..e) ("page#part"), or -1.
help_anchor(m: *Manual, b: int, e: int): int {
    h: int = b;
    while (h < e && hlb(m, h) != 35) h = h + 1;
    if (h >= e) return -1;
    for g in 0..m.page_count {
        page: ManualPage = m.pages[g];
        if (hlp_same(m, page.id_b, page.id_e, b, h)) {
            for t in page.first_part..page.first_part + page.part_count
                if (hlp_same(m, m.parts[t].id_b, m.parts[t].id_e, h + 1, e)) return t
        }
    }
    -1
}

// ---- reading it ----
// help.txt's bytes (source's first n) read into a Manual of its own: the
// platform's lines, then its pages, parts and paragraphs, then checked.
manual_read(source: []i8, n: int): owned *Manual {
    own {
        m: *Manual = manual_platform(source, n);
        manual_index(m);
        m
    }
}

// The Manual come (again): the one there was replaced, and let go; the
// screens showing it made again.
manual_came(source: []i8, n: int) {
    next: owned *Manual = manual_read(source, n);
    drop manual;
    manual = move next;
    sk_update_all()
}

// A line beginning ?FLAG (?!FLAG) is kept only where the platform has it
// (hasn't): ios, downloads (sk_has_downloads), textsize
// (sk_follows_text_size); {device} is the name it calls itself in prose
// (sk_device_prose: "iPhone").
help_has(source: []i8, b: int, e: int): bool {
    if (source_is(source, b, e, "ios")) return sk_is_ios;
    if (source_is(source, b, e, "downloads")) return sk_has_downloads;
    if (source_is(source, b, e, "textsize")) return sk_follows_text_size;
    false
}

source_is(
    source: []i8,
    b: int,
    e: int,
    s: str
): bool {
    if (e - b != len(s)) return false;
    for i in 0..len(s)
        if (source[b + i] != s[i]) return false;
    true
}

DEVICE_WORD: str = "{device}";

// A Manual whose text is the platform's lines of source's first n bytes
// (its lists still empty).
manual_platform(source: []i8, n: int): *Manual@new {
    // (Room: the source, and the device's name for each {device}.)
    devices: int = 0;
    for q in 0..n
        if (source_is(source, q, if (q + len(DEVICE_WORD) <= n) q + len(DEVICE_WORD) else n,
            DEVICE_WORD)) devices = devices + 1;
    text: []i8 = new i8[n + 1 + devices * len(sk_device_prose)](0i8);
    size: int = 0;
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && source[e] as int != 10) e = e + 1;
        s: int = p;
        keep: bool = true;
        if (e > p && source[p] as int == 63) {
            not: bool = p + 1 < e && source[p + 1] as int == 33;
            f: int = if (not) p + 2 else p + 1;
            w: int = f;
            while (w < e && source[w] as int != 32) w = w + 1;
            keep = help_has(source, f, w) != not;
            s = (if (w < e) w + 1 else e)
        }
        if (keep) {
            q: int = s;
            while (q < e) {
                if (source_is(source, q, if (q + len(DEVICE_WORD) <= e) q + len(DEVICE_WORD) else e,
                    DEVICE_WORD)) {
                    for k in sk_device_prose {
                        text[size] = k;
                        size = size + 1
                    }
                    q = q + len(DEVICE_WORD)
                } else {
                    text[size] = source[q];
                    size = size + 1;
                    q = q + 1
                }
            }
            text[size] = 10i8;
            size = size + 1
        }
        p = e + 1
    }
    new Manual {
        text: text,
        size: size,
        pages: new ManualPage[0](manual_no_page()),
        page_count: 0,
        parts: new ManualPart[0](manual_no_part()),
        part_count: 0,
        paras: new ManualPara[0](ManualPara { b: 0, e: 0, part: 0 }),
        para_count: 0,
        problems: new i8[MANUAL_PROBLEMS_SHOWN](0i8),
        problems_n: 0,
        problem_count: 0,
        line: 0
    }
}

manual_no_page(): ManualPage {
    ManualPage {
        id_b: 0,
        id_e: 0,
        title_b: 0,
        title_e: 0,
        symbol: -1,
        first_part: 0,
        part_count: 0
    }
}

manual_no_part(): ManualPart {
    ManualPart {
        page: 0,
        id_b: 0,
        id_e: 0,
        heading_b: 0,
        heading_e: 0,
        first_para: 0,
        para_count: 0
    }
}

// Its pages, parts and paragraphs read from its text (as many of each as
// it has lines for), then checked.
manual_index(m: *Manual@new) {
    pages: int = 0;
    parts: int = 0;
    paras: int = 0;
    p: int = 0;
    while (p < m.size) {
        e: int = p;
        while (e < m.size && hlb(m, e) != 10) e = e + 1;
        if (e > p && hlb(m, p) != 35) {
            if (hlp_starts(m, p, e, "== ")) parts = parts + 1 else if (hlp_starts(m,
                p, e, "= ")) pages = pages + 1 else paras = paras + 1
        }
        p = e + 1
    }
    m.pages = new ManualPage[pages](manual_no_page());
    m.parts = new ManualPart[parts](manual_no_part());
    m.paras = new ManualPara[paras](ManualPara { b: 0, e: 0, part: 0 });
    p = 0;
    m.line = 0;
    while (p < m.size) {
        e: int = p;
        while (e < m.size && hlb(m, e) != 10) e = e + 1;
        m.line = m.line + 1;
        if (e > p && hlb(m, p) != 35) help_line(m, p, e);
        p = e + 1
    }
    m.line = 0;
    help_check(m)
}

help_line(m: *Manual, b: int, e: int) {
    if (hlp_starts(m, b, e, "== ")) {
        if (m.page_count == 0) {
            he_begin(m);
            hl_str(m, "a part before any page");
            he_end(m);
            return
        }
        t: int = hlp_tab(m, b + 3, e);
        page: int = m.page_count - 1;
        // (Two parts of a page with one id.)
        for x in m.pages[page].first_part..m.part_count {
            if (hlp_same(m, m.parts[x].id_b, m.parts[x].id_e, b + 3, t)) {
                he_begin(m);
                hl_str(m, "two parts ");
                hl_bytes(m, b + 3, t);
                hl_str(m, " in one page");
                he_end(m)
            }
        }
        m.parts[m.part_count] = ManualPart {
            page: page,
            id_b: b + 3,
            id_e: t,
            heading_b: if (t < e) t + 1 else e,
            heading_e: e,
            first_para: m.para_count,
            para_count: 0
        };
        m.pages[page].part_count = m.pages[page].part_count + 1;
        m.part_count = m.part_count + 1;
        return
    }
    if (hlp_starts(m, b, e, "= ")) {
        t1: int = hlp_tab(m, b + 2, e);
        t2: int = hlp_tab(m, t1 + 1, e);
        symbol: int = if (t2 < e) help_name_in(m, t2 + 1, e, hsym_names) else -1;
        if (symbol < 0) {
            he_begin(m);
            hl_str(m, "page ");
            hl_bytes(m, b + 2, t1);
            hl_str(m, ": no symbol, or one not in help.l8's list");
            he_end(m)
        }
        for g in 0..m.page_count {
            if (hlp_same(m, m.pages[g].id_b, m.pages[g].id_e, b + 2, t1)) {
                he_begin(m);
                hl_str(m, "two pages ");
                hl_bytes(m, b + 2, t1);
                he_end(m)
            }
        }
        m.pages[m.page_count] = ManualPage {
            id_b: b + 2,
            id_e: t1,
            title_b: if (t1 < e) t1 + 1 else e,
            title_e: if (t1 < e) t2 else e,
            symbol: symbol,
            first_part: m.part_count,
            part_count: 0
        };
        m.page_count = m.page_count + 1;
        return
    }
    // The Manual accepts pages, parts and paragraphs, not tip directives.
    if (hlp_starts(m, b, e, "tip\t")) {
        he_begin(m);
        hl_str(m, "tip directives are unsupported; use a paragraph in a Manual part");
        he_end(m);
        return
    }
    // A paragraph of the part last begun (in its page).
    if (m.part_count == 0 || m.page_count == 0 || m.pages[m.page_count - 1].part_count == 0) {
        he_begin(m);
        hl_str(m, "a paragraph outside any part");
        he_end(m);
        return
    }
    m.paras[m.para_count] = ManualPara { b: b, e: e, part: m.part_count - 1 };
    m.parts[m.part_count - 1].para_count = m.parts[m.part_count - 1].para_count + 1;
    m.para_count = m.para_count + 1
}

// ---- Manual validation ----
help_check(m: *Manual) {
    for g in 0..m.page_count {
        if (m.pages[g].part_count == 0) {
            he_begin(m);
            hl_str(m, "page ");
            hl_bytes(m, m.pages[g].id_b, m.pages[g].id_e);
            hl_str(m, " has no part");
            he_end(m)
        }
    }
    for t in 0..m.part_count {
        if (m.parts[t].para_count == 0) {
            he_begin(m);
            hl_str(m, "part ");
            help_hl_anchor(m, t);
            hl_str(m, " has no paragraph");
            he_end(m)
        }
    }
    // Each paragraph's markup: its symbols known, its links' anchors there.
    for a in 0..m.para_count {
        help_runs(m, a);
        for r in 0..hrun_n {
            if (hrun_kind[r] == HRUN_SYM && hrun_sym[r] < 0 || hrun_kind[r] == HRUN_LINK && hrun_link[r] < 0 || hrun_kind[r] == HRUN_BAD) {
                he_begin(m);
                hl_str(m, "part ");
                help_hl_anchor(m, m.paras[a].part);
                hl_str(m, if (hrun_kind[r] == HRUN_SYM) ": a symbol not in help.l8's list: " else if (hrun_kind[r] == HRUN_LINK) ": a link to nowhere: " else ": markup not closed: ");
                hl_bytes(m, hrun_b[r], hrun_e[r]);
                he_end(m)
            }
        }
        if (hrun_open) {
            he_begin(m);
            hl_str(m, "part ");
            help_hl_anchor(m, m.paras[a].part);
            hl_str(m, ": ** or _ not closed");
            he_end(m)
        }
    }
    for a in 0..m.para_count help_style(m, a)
}

help_hl_anchor(m: *Manual, t: int) {
    g: int = m.parts[t].page;
    hl_bytes(m, m.pages[g].id_b, m.pages[g].id_e);
    hl_put(m, 35);
    hl_bytes(m, m.parts[t].id_b, m.parts[t].id_e)
}

// The house style: no exclamation mark, none of the words the style
// forbids.
hstyle_words: []str = ["pro tip", "did you know", "awesome", "easily", "simply", "just"];

help_style(m: *Manual, a: int) {
    b: int = m.paras[a].b;
    e: int = m.paras[a].e;
    why: str = "";
    for x in b..e
        if (hlb(m, x) == 33) why = "an exclamation mark";
    for w in 0..len(hstyle_words) {
        word: str = hstyle_words[w];
        for x in b..e - len(word) + 1 {
            if (help_word_here(m, x, b, e, word)) why = "a word the style forbids"
        }
    }
    if (len(why) == 0) return;
    he_begin(m);
    hl_str(m, "part ");
    help_hl_anchor(m, m.paras[a].part);
    hl_str(m, ": ");
    hl_str(m, why);
    he_end(m)
}

// Whether word (lower case) is at text[x], whole, in b..e, whatever its
// case.
help_word_here(
    m: *Manual,
    x: int,
    b: int,
    e: int,
    word: str
): bool {
    if (x > b && help_wordy(hlb(m, x - 1))) return false;
    if (x + len(word) > e) return false;
    for i in 0..len(word)
        if (help_lower(hlb(m, x + i)) != word[i] as int) return false;
    x + len(word) >= e || !help_wordy(hlb(m, x + len(word)))
}

help_lower(k: int): int {
    if (k >= 65 && k <= 90) k + 32 else k
}

help_wordy(k: int): bool {
    k >= 48 && k <= 57 || k >= 65 && k <= 90 || k >= 97 && k <= 122
}

// ---- a paragraph's markup, as runs ----
// Kinds: text (bold, italic as they are there), a symbol (hrun_sym, -1
// unknown), a link (its words hrun_b..hrun_e, its part hrun_link, -1 none),
// and markup not closed. hrun_open: ** or _ left open at the end. (The
// paragraph last made runs of; byte offsets into its Manual's text.)
HRUN_TEXT: int = 0;

HRUN_SYM: int = 1;

HRUN_LINK: int = 2;

HRUN_BAD: int = 3;

hrun_n: int = 0;

hrun_kind: []int = new int[64](0);

hrun_b: []int = new int[64](0);

hrun_e: []int = new int[64](0);

hrun_bold: []bool = new bool[64](false);

hrun_italic: []bool = new bool[64](false);

hrun_sym: []int = new int[64](-1);

hrun_link: []int = new int[64](-1);

hrun_open: bool = false;

hrun_add(
    kind: int,
    b: int,
    e: int,
    bold: bool,
    italic: bool
) {
    if (hrun_n >= len(hrun_kind) || kind == HRUN_TEXT && e <= b) return;
    hrun_kind[hrun_n] = kind;
    hrun_b[hrun_n] = b;
    hrun_e[hrun_n] = e;
    hrun_bold[hrun_n] = bold;
    hrun_italic[hrun_n] = italic;
    hrun_sym[hrun_n] = -1;
    hrun_link[hrun_n] = -1;
    hrun_n = hrun_n + 1
}

help_runs(m: *Manual, a: int) {
    hrun_n = 0;
    b: int = m.paras[a].b;
    e: int = m.paras[a].e;
    bold: bool = false;
    italic: bool = false;
    s: int = b;
    i: int = b;
    while (i < e) {
        k: int = hlb(m, i);
        if (k == 42 && i + 1 < e && hlb(m, i + 1) == 42) {
            hrun_add(HRUN_TEXT, s, i, bold, italic);
            bold = !bold;
            i = i + 2;
            s = i
        } else if (k == 95 && (italic || i + 1 < e && hlb(m, i + 1) != 32)) {
            hrun_add(HRUN_TEXT, s, i, bold, italic);
            italic = !italic;
            i = i + 1;
            s = i
        } else if (k == 123 && hlp_starts(m, i, e, "{sym:")) {
            hrun_add(HRUN_TEXT, s, i, bold, italic);
            c: int = i + 5;
            while (c < e && hlb(m, c) != 125) c = c + 1;
            if (c >= e) {
                hrun_add(HRUN_BAD, i, e, bold, italic);
                i = e
            } else {
                hrun_add(HRUN_SYM, i + 5, c, bold, italic);
                if (hrun_n > 0) hrun_sym[hrun_n - 1] = help_name_in(m, i + 5, c, hsym_names);
                i = c + 1
            }
            s = i
        } else if (k == 91 && i + 1 < e && hlb(m, i + 1) == 91) {
            hrun_add(HRUN_TEXT, s, i, bold, italic);
            bar: int = i + 2;
            while (bar < e && hlb(m, bar) != 124 && hlb(m, bar) != 93) bar = bar + 1;
            c: int = bar;
            while (c + 1 < e && !(hlb(m, c) == 93 && hlb(m, c + 1) == 93)) c = c + 1;
            if (bar >= e || hlb(m, bar) != 124 || c + 1 >= e) {
                hrun_add(HRUN_BAD, i, e, bold, italic);
                i = e
            } else {
                hrun_add(HRUN_LINK, bar + 1, c, bold, italic);
                if (hrun_n > 0) hrun_link[hrun_n - 1] = help_anchor(m, i + 2, bar);
                i = c + 2
            }
            s = i
        } else i = i + 1
    }
    hrun_add(HRUN_TEXT, s, e, bold, italic);
    hrun_open = bold || italic
}

// ---- words plain ----
// A paragraph's words without its markup into hx (a symbol by its name
// when spoken, for VoiceOver; else left out, with one space kept).
hx: []i8 = new i8[4096](0i8);

hx_n: int = 0;

hx_put(k: int) {
    if (hx_n < len(hx)) {
        hx[hx_n] = k trunc i8;
        hx_n = hx_n + 1
    }
}

help_plain(m: *Manual, a: int, spoken: bool) {
    hx_n = 0;
    help_runs(m, a);
    for r in 0..hrun_n {
        if (hrun_kind[r] == HRUN_SYM) {
            if (spoken && hrun_sym[r] >= 0)
                for k in hsym_spoken[hrun_sym[r]] hx_put(k as int)
        } else
            for x in hrun_b[r]..hrun_e[r] hx_put(hlb(m, x))
    }
    // (Two spaces, where a symbol was left out, made one.)
    if (!spoken) {
        n: int = 0;
        for x in 0..hx_n {
            if (!(hx[x] as int == 32 && n > 0 && hx[n - 1] as int == 32)) {
                hx[n] = hx[x];
                n = n + 1
            }
        }
        hx_n = n;
        s: int = if (hx_n > 0 && hx[0] as int == 32) 1 else 0;
        if (s > 0) {
            for x in 1..hx_n hx[x - 1] = hx[x];
            hx_n = hx_n - 1
        }
    }
}

// A part's anchor ("ribbons#making").
help_fput_anchor(m: *Manual, t: int) {
    if (t < 0 || t >= m.part_count) return;
    g: int = m.parts[t].page;
    fput_bytes(m.text, m.pages[g].id_b, m.pages[g].id_e);
    fput(35);
    fput_bytes(m.text, m.parts[t].id_b, m.parts[t].id_e)
}

// ---- the Manual's search: every word, whole, whatever its
// case (an apostrophe either way; a plural's s or es too; a word ending in
// * the start of one), over a part's heading and paragraphs ----
hq_b: []int = new int[8](0);

hq_e: []int = new int[8](0);

hq_prefix: []bool = new bool[8](false);

hq_n: int = 0;

hq: []i8 = new i8[256](0i8);

hq_len: int = 0;

// The query: its words, lower case.
help_query(b: []i8, n: int) {
    hq_n = 0;
    hq_len = 0;
    p: int = 0;
    while (p < n && hq_n < len(hq_b)) {
        while (p < n && !hq_wordy(b, p, n)) p = p + 1;
        if (p < n) {
            hq_b[hq_n] = hq_len;
            while (p < n && hq_wordy(b, p, n) && hq_len < len(hq)) {
                k: int = b[p] as int & 255;
                // (’ as ', so either matches either.)
                if (k == 226 && p + 2 < n && (b[p + 1] as int & 255) == 128 && (b[p + 2] as int & 255) == 153) {
                    hq[hq_len] = 39i8;
                    p = p + 3
                } else {
                    hq[hq_len] = help_lower(k) trunc i8;
                    p = p + 1
                }
                hq_len = hq_len + 1
            }
            hq_e[hq_n] = hq_len;
            hq_prefix[hq_n] = p < n && b[p] as int == 42;
            hq_n = hq_n + 1
        }
    }
}

// Whether the byte at p of b begins or continues a word (a letter, a
// digit, an apostrophe inside a word; a letter beyond ASCII, but not
// the punctuation of U+2000–U+206F).
hq_wordy(b: []i8, p: int, n: int): bool {
    k: int = b[p] as int & 255;
    if (help_wordy(k)) return true;
    if (k < 128) return k == 39 && p > 0 && p + 1 < n && help_wordy(b[p - 1] as int & 255) && help_wordy(b[p + 1] as int & 255);
    // (The lead byte of its character.)
    s: int = p;
    while (s > 0 && (b[s] as int & 192) == 128) s = s - 1;
    lead: int = b[s] as int & 255;
    if (lead == 226 && s + 2 < n && (b[s + 1] as int & 255) == 128) {
        // (’ inside a word is a letter's apostrophe.)
        return (b[s + 2] as int & 255) == 153 && s > 0 && help_wordy(b[s - 1] as int & 255) && s + 3 < n && help_wordy(b[s + 3] as int & 255)
    }
    lead >= 192
}

// Where query word w ends in t[0..n] if it begins whole at p (-1 if not).
hq_match(
    t: []i8,
    n: int,
    p: int,
    w: int
): int {
    if (p > 0 && hq_wordy(t, p - 1, n)) return -1;
    x: int = p;
    for j in hq_b[w]..hq_e[w] {
        if (x >= n) return -1;
        want: int = hq[j] as int & 255;
        k: int = t[x] as int & 255;
        if (want == 39 && k == 226 && x + 2 < n && (t[x + 1] as int & 255) == 128 && (t[x + 2] as int & 255) == 153) x = x + 3 else {
            if (help_lower(k) != want) return -1;
            x = x + 1
        }
    }
    if (hq_prefix[w]) {
        while (x < n && hq_wordy(t, x, n)) x = x + 1;
        return x
    }
    if (x < n && hq_wordy(t, x, n)) {
        // (A plural's s or es.)
        if (help_lower(t[x] as int & 255) == 115 && (x + 1 >= n || !hq_wordy(t, x + 1,
            n))) return x + 1;
        if (help_lower(t[x] as int & 255) == 101 && x + 1 < n && help_lower(t[x + 1] as int & 255) == 115 && (x + 2 >= n || !hq_wordy(t,
            x + 2, n))) return x + 2;
        return -1
    }
    x
}

// The first place query word w is in t[0..n] (-1: none); its end in
// hq_at_end.
hq_at_end: int = 0;

hq_find(
    t: []i8,
    n: int,
    from: int,
    w: int
): int {
    for p in from..n {
        e: int = hq_match(t, n, p, w);
        if (e >= 0) {
            hq_at_end = e;
            return p
        }
    }
    -1
}

// The heading's words, plain, into hx.
help_heading_plain(m: *Manual, t: int) {
    hx_n = 0;
    for x in m.parts[t].heading_b..m.parts[t].heading_e hx_put(hlb(m, x))
}

// Whether part t has every word of the query.
help_part_matches(m: *Manual, t: int): bool {
    if (hq_n == 0) return false;
    for w in 0..hq_n {
        found: bool = false;
        help_heading_plain(m, t);
        if (hq_find(hx, hx_n, 0, w) >= 0) found = true;
        for a in m.parts[t].first_para..m.parts[t].first_para + m.parts[t].para_count {
            if (!found) {
                help_plain(m, a, false);
                if (hq_find(hx, hx_n, 0, w) >= 0) found = true
            }
        }
        if (!found) return false
    }
    true
}

// A matching part's snippet: the first paragraph with a word of the query
// (else its first), plain in hx from hsn_from, "… " before it when it
// starts after the paragraph's start (a few words before the first
// match); and every match in it from there (hsn_mb, hsn_me).
hsn_pa: int = 0;

hsn_from: int = 0;

hsn_n: int = 0;

hsn_mb: []int = new int[32](0);

hsn_me: []int = new int[32](0);

help_snippet(m: *Manual, t: int) {
    hsn_pa = m.parts[t].first_para;
    first: int = -1;
    for a in m.parts[t].first_para..m.parts[t].first_para + m.parts[t].para_count {
        if (first < 0) {
            help_plain(m, a, false);
            for w in 0..hq_n {
                p: int = hq_find(hx, hx_n, 0, w);
                if (p >= 0 && (first < 0 || p < first)) {
                    first = p;
                    hsn_pa = a
                }
            }
        }
    }
    help_plain(m, hsn_pa, false);
    hsn_from = 0;
    if (first > 60) {
        // (Four words back.)
        s: int = first;
        words: int = 0;
        while (s > 0 && words < 4) {
            s = s - 1;
            if (hx[s] as int == 32) words = words + 1
        }
        hsn_from = (if (words == 4) s + 1 else 0)
    }
    hsn_n = 0;
    p: int = hsn_from;
    while (p < hx_n && hsn_n < len(hsn_mb)) {
        best: int = -1;
        best_e: int = 0;
        for w in 0..hq_n {
            q: int = hq_find(hx, hx_n, p, w);
            if (q >= 0 && (best < 0 || q < best)) {
                best = q;
                best_e = hq_at_end
            }
        }
        if (best < 0) p = hx_n else {
            hsn_mb[hsn_n] = best;
            hsn_me[hsn_n] = best_e;
            hsn_n = hsn_n + 1;
            p = best_e
        }
    }
}
