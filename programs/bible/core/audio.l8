tag bible;

import "static_storage.l8";

use_tag std;

// Recorded readings (DESIGN.md §12.1), apart from any platform: the
// sources (the BSB's three readers on openbible.com, the WEB's on
// eBible.org, the ESV's through our Worker, and the iPhone's voice), each
// one's address for a chapter, its verse timings (data/audio/<id>.tim,
// made by tools/align.py) and what is looked up in them, which source a
// chapter is heard from, and the rules of the cache of chapters fetched
// ahead. ios_listen.l8 and ios_audio.l8 play and fetch.
import "text.l8";

import "store.l8";

// ---- the sources ----
SRC_SOUER: int = 0;

SRC_HAYS: int = 1;

SRC_GILBERT: int = 2;

SRC_HENSON: int = 3;

SRC_ESV: int = 4;

SRC_VOICE: int = 5;

SOURCES: int = 6;

src_ids: []str = ["souer", "hays", "gilbert", "henson", "esv", "voice"];

src_readers: []str = ["Bob Souer", "Barry Hays", "Jordan Gilbert", "Winfred Henson",
    "David Cochran Heath", "iPhone Voice"];

// Each one's version (a text, text.l8's numbering).
src_texts: []int = [0, 0, 0, 2, 5, -1];

// Whether its chapters may be kept (fetched ahead, downloaded): not the
// ESV's, and the voice has none.
src_cacheable(s: int): bool {
    s >= SRC_SOUER && s <= SRC_HENSON
}

// Whether it has a timing file.
src_timed(s: int): bool {
    s >= SRC_SOUER && s <= SRC_HENSON
}

// The default reader of each version (the BSB's is one constant to change:
// DESIGN.md §12.9 question 1); the KJV, ASV and YLT are always the voice.
DEFAULT_BSB: int = 0;

text_default_src(t: int): int {
    if (t == 0) return DEFAULT_BSB;
    if (t == 2) return SRC_HENSON;
    if (t == 5) return SRC_ESV;
    SRC_VOICE
}

// The sources text t may be read by, in the Voice screen's order (into
// src_list, how many).
src_list: []int = static_buffer([6]int);

text_sources(t: int): int {
    n: int = 0;
    for s in 0..SRC_VOICE {
        if (src_texts[s] == t) {
            src_list[n] = s;
            n = n + 1
        }
    }
    src_list[n] = SRC_VOICE;
    n + 1
}

// The source text t's chosen setting names (its value in the defaults is
// the source's id).
src_setting(t: int): str {
    if (t == 0) "listenSourceBSB" else if (t == 2) "listenSourceWEB" else if (t == 5) "listenSourceESV" else ""
}

// A source by its id (as kept), or -1.
src_of_id(b: []i8, n: int): int {
    src_of_id_at(b, 0, n)
}

// ---- addresses ----
// openbible.com's books' names (DESIGN.md §12.0.1), in book order.
ob_abbrs: []str = ["Gen", "Exo", "Lev", "Num", "Deu", "Jos", "Jdg", "Rut", "1Sa",
    "2Sa", "1Ki", "2Ki", "1Ch", "2Ch", "Ezr", "Neh", "Est", "Job", "Psa", "Pro", "Ecc",
    "Sng", "Isa", "Jer", "Lam", "Ezk", "Dan", "Hos", "Jol", "Amo", "Oba", "Jon", "Mic",
    "Nam", "Hab", "Zep", "Hag", "Zec", "Mal", "Mat", "Mrk", "Luk", "Jhn", "Act", "Rom",
    "1Co", "2Co", "Gal", "Eph", "Php", "Col", "1Th", "2Th", "1Ti", "2Ti", "Tts", "Phm",
    "Heb", "Jas", "1Pe", "2Pe", "1Jn", "2Jn", "3Jn", "Jud", "Rev"];

ob_suffix: []str = ["", "_H", "_G"];

HENSON_BASE: str = "https://ebible.org/eng-web/audio/";

// The address being made.
au: []i8 = static_buffer([512]i8);

au_n: int = 0;

au_byte(k: int) {
    if (au_n < len(au)) {
        au[au_n] = k trunc i8;
        au_n = au_n + 1
    }
}

au_str(s: str) {
    for k in s au_byte(k as int)
}

au_digits(n: int, width: int) {
    if (width > 1 || n >= 10) au_digits(n / 10, width - 1);
    au_byte(48 + n % 10)
}

// An openbible.com file's name: BSB_43_Jhn_003.mp3 (Souer), _H, _G.
ob_name(s: int, c: int) {
    b: int = ch_book[c];
    au_str("BSB_");
    au_digits(b + 1, 2);
    au_byte(95);
    au_str(ob_abbrs[b]);
    au_byte(95);
    au_digits(ch_num[c], 3);
    au_str(ob_suffix[s]);
    au_str(".mp3")
}

// Chapter c's address for source s into au (au_n 0 if it has none here:
// the ESV's is asked of the Worker, the voice has none, and Henson's comes
// from henson.paths).
audio_url(s: int, c: int) {
    au_n = 0;
    if (c < 0 || c >= chapters) return;
    if (s >= SRC_SOUER && s <= SRC_GILBERT) {
        au_str("https://openbible.com/audio/");
        au_str(src_ids[s]);
        au_byte(47);
        ob_name(s, c)
    } else if (s == SRC_HENSON && hp_n > c && hp_at[c] >= 0) {
        au_str(HENSON_BASE);
        for i in hp_at[c]..hp_end[c] au_byte(hp_buf[i] as int)
    }
}

// The name a chapter's file is kept under: BOOK-C.mp3 (JHN-3.mp3).
audio_file_name(c: int) {
    au_n = 0;
    p: int = book_line[ch_book[c]] + 1;
    for i in 0..3 au_byte(bsb[p + i] as int);
    au_byte(45);
    au_digits(ch_num[c], 1);
    au_str(".mp3")
}

// ---- eBible.org's paths (data/audio/henson.paths): BOOK C PATH SIZE a
// line, in Bible order ----
hp_buf: []i8 = static_buffer([1]i8);

hp_n: int = 0;

hp_at: []int = static_buffer([1200]int, -1);

hp_end: []int = static_buffer([1200]int);

// The paths file indexed (how many chapters it has; each line's book and
// chapter checked against the BSB's).
henson_paths_load(buf: []i8@immortal, n: int): int {
    hp_buf = buf;
    hp_n = 0;
    for c in 0..1200 hp_at[c] = -1;
    p: int = 0;
    c: int = 0;
    while (p < n && c < chapters) {
        e: int = p;
        while (e < n && buf[e] as int != 10) e = e + 1;
        // BOOK, tab, chapter, tab, path, tab, size.
        f2: int = au_tab_after(buf, p, e);
        f3: int = au_tab_after(buf, f2, e);
        f4: int = au_tab_after(buf, f3, e);
        if (f4 <= e && au_same_book(buf, p, c) && au_num_at(buf, f2, f3 - 1) == ch_num[c]) {
            hp_at[c] = f3;
            // (Two paths: the first, the one align.py kept.)
            q: int = f3;
            while (q < f4 - 1 && buf[q] as int != 32) q = q + 1;
            hp_end[c] = q;
            c = c + 1
        }
        p = e + 1
    }
    hp_n = c;
    c
}

au_tab_after(b: []i8, p: int, e: int): int {
    q: int = p;
    while (q < e && b[q] as int != 9) q = q + 1;
    q + 1
}

au_same_book(b: []i8, p: int, c: int): bool {
    q: int = book_line[ch_book[c]] + 1;
    for i in 0..3
        if (b[p + i] != bsb[q + i]) return false;
    b[p + 3] as int == 9
}

// The number in b from p to e (-1 if none).
au_num_at(b: []i8, p: int, e: int): int {
    if (p >= e) return -1;
    n: int = 0;
    for i in p..e {
        k: int = b[i] as int;
        if (k < 48 || k > 57) return -1;
        n = n * 10 + k - 48
    }
    n
}

// ---- verse timings (data/audio/<id>.tim, DESIGN.md §12.2.1) ----
// Each timed source's file, and each chapter's line in it: where its
// numbers start (-1: no line), its flag, duration (centiseconds) and size
// (bytes).
TIM_OK: int = 0;

TIM_CHAPTER: int = 1;

TIM_MISSING: int = 2;

tim_buf: [][]i8 = static_buffer([4][]i8, "");

tim_ready: []bool = static_buffer([4]bool);

tim_nums: [][]int = static_buffer([4][]int, bible_empty_ints);

tim_flag_of: [][]int = static_buffer([4][]int, bible_empty_ints);

tim_dur: [][]int = static_buffer([4][]int, bible_empty_ints);

tim_size: [][]int = static_buffer([4][]int, bible_empty_ints);

tim_end: [][]int = static_buffer([4][]int, bible_empty_ints);

// Each source's own arrays, made with the program, so that loading
// allocates nothing.
tm0a: []int = static_buffer([1200]int, -1);

tm0b: []int = static_buffer([1200]int, 2);

tm0c: []int = static_buffer([1200]int);

tm0d: []int = static_buffer([1200]int);

tm0e: []int = static_buffer([1200]int);

tm1a: []int = static_buffer([1200]int, -1);

tm1b: []int = static_buffer([1200]int, 2);

tm1c: []int = static_buffer([1200]int);

tm1d: []int = static_buffer([1200]int);

tm1e: []int = static_buffer([1200]int);

tm2a: []int = static_buffer([1200]int, -1);

tm2b: []int = static_buffer([1200]int, 2);

tm2c: []int = static_buffer([1200]int);

tm2d: []int = static_buffer([1200]int);

tm2e: []int = static_buffer([1200]int);

tm3a: []int = static_buffer([1200]int, -1);

tm3b: []int = static_buffer([1200]int, 2);

tm3c: []int = static_buffer([1200]int);

tm3d: []int = static_buffer([1200]int);

tm3e: []int = static_buffer([1200]int);

tim_arrays(s: int) {
    if (s == 0) {
        tim_nums[0] = tm0a;
        tim_flag_of[0] = tm0b;
        tim_dur[0] = tm0c;
        tim_size[0] = tm0d;
        tim_end[0] = tm0e
    } else if (s == 1) {
        tim_nums[1] = tm1a;
        tim_flag_of[1] = tm1b;
        tim_dur[1] = tm1c;
        tim_size[1] = tm1d;
        tim_end[1] = tm1e
    } else if (s == 2) {
        tim_nums[2] = tm2a;
        tim_flag_of[2] = tm2b;
        tim_dur[2] = tm2c;
        tim_size[2] = tm2d;
        tim_end[2] = tm2e
    } else {
        tim_nums[3] = tm3a;
        tim_flag_of[3] = tm3b;
        tim_dur[3] = tm3c;
        tim_size[3] = tm3d;
        tim_end[3] = tm3e
    }
}

// Source s's timing file indexed: a line a chapter (in any order; a line
// for a book or chapter the text has not is skipped). How many chapters
// had lines.
tim_load(s: int, buf: []i8@immortal, n: int): int {
    if (s < 0 || s > 3) return 0;
    tim_arrays(s);
    tim_buf[s] = buf;
    nums: []int = tim_nums[s];
    flags: []int = tim_flag_of[s];
    for c in 0..1200 {
        nums[c] = -1;
        flags[c] = TIM_MISSING;
        tim_dur[s][c] = 0;
        tim_size[s][c] = 0
    }
    tim_ready[s] = true;
    tim_lines(s, buf, n, false)
}

// Lines of another file over source s's (a test's, CI's fixture): theirs
// win, their numbers read from buf; a size of 0 keeps the one there was.
tim_alt: [][]i8 = static_buffer([4][]i8, "");

TIM_ALT: int = 1099511627776;

tim_overlay(s: int, buf: []i8@immortal, n: int): int {
    if (s < 0 || s > 3 || !tim_ready[s]) return 0;
    tim_alt[s] = buf;
    ts_s = -1;
    tim_lines(s, buf, n, true)
}

tim_lines(
    s: int,
    buf: []i8,
    n: int,
    alt: bool
): int {
    nums: []int = tim_nums[s];
    flags: []int = tim_flag_of[s];
    got: int = 0;
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && buf[e] as int != 10) e = e + 1;
        if (e - p > 5 && buf[p] as int != 35) {
            c: int = au_line_chapter(buf, p, e);
            f2: int = au_tab_after(buf, p, e);
            f3: int = au_tab_after(buf, f2, e);
            f4: int = au_tab_after(buf, f3, e);
            f5: int = au_tab_after(buf, f4, e);
            f6: int = au_tab_after(buf, f5, e);
            if (c >= 0 && f5 <= e) {
                fe: int = if (f6 <= e) f6 - 1 else e;
                flag: int = if (au_word_at(buf, f5, fe, "ok")) TIM_OK else if (au_word_at(buf,
                    f5, fe, "chapter")) TIM_CHAPTER else TIM_MISSING;
                flags[c] = flag;
                tim_dur[s][c] = au_num_at(buf, f3, f4 - 1);
                size: int = au_num_at(buf, f4, f5 - 1);
                if (size > 0 || !alt) tim_size[s][c] = size;
                nums[c] = -1;
                if (flag != TIM_MISSING && f6 <= e) {
                    nums[c] = (if (alt) f6 + TIM_ALT else f6);
                    tim_end[s][c] = e
                }
                got = got + 1
            }
        }
        p = e + 1
    }
    got
}

au_word_at(
    b: []i8,
    p: int,
    e: int,
    w: str
): bool {
    if (e - p != len(w)) return false;
    for i in 0..len(w)
        if (b[p + i] != w[i]) return false;
    true
}

// A line's chapter from its first two fields (BOOK, C), or -1.
au_line_chapter(b: []i8, p: int, e: int): int {
    if (p + 4 > e || b[p + 3] as int != 9) return -1;
    for bk in 0..books {
        q: int = book_line[bk] + 1;
        same: bool = true;
        for i in 0..3
            if (b[p + i] != bsb[q + i]) same = false;
        if (same) {
            f2: int = p + 4;
            f3: int = au_tab_after(b, f2, e);
            n: int = au_num_at(b, f2, f3 - 1);
            if (n < 1 || n > book_count[bk]) return -1;
            return book_first[bk] + n - 1
        }
    }
    -1
}

// Chapter c's flag for source s (missing, for a source without timings or
// a chapter without a line).
tim_flag(s: int, c: int): int {
    if (s < 0 || s > 3 || !tim_ready[s] || c < 0 || c >= chapters) return TIM_MISSING;
    tim_flag_of[s][c]
}

tim_duration(s: int, c: int): int {
    if (tim_flag(s, c) == TIM_MISSING) 0 else tim_dur[s][c]
}

tim_bytes(s: int, c: int): int {
    if (tim_flag(s, c) == TIM_MISSING) 0 else tim_size[s][c]
}

// Chapter c's starts (absolute centiseconds) into ts: ts[0] verse 1's,
// ts[v - 1] verse v's, and ts[ts_n - 1] the end of the last verse's
// speech. ts_n 0 if there are none.
ts: []int = static_buffer([1024]int);

ts_n: int = 0;

ts_s: int = -1;

ts_c: int = -1;

tim_starts(s: int, c: int): int {
    if (s == ts_s && c == ts_c) return ts_n;
    ts_s = s;
    ts_c = c;
    ts_n = 0;
    if (tim_flag(s, c) == TIM_MISSING || tim_nums[s][c] < 0) return 0;
    b: []i8 = if (tim_nums[s][c] >= TIM_ALT) tim_alt[s] else tim_buf[s];
    p: int = tim_nums[s][c] % TIM_ALT;
    e: int = tim_end[s][c];
    acc: int = 0;
    while (p < e && ts_n < len(ts)) {
        q: int = p;
        while (q < e && b[q] as int != 32) q = q + 1;
        n: int = au_num_at(b, p, q);
        if (n < 0) {
            ts_n = 0;
            return 0
        }
        acc = (if (ts_n == 0) n else acc + n);
        ts[ts_n] = acc;
        ts_n = ts_n + 1;
        p = q + 1
    }
    ts_n
}

// The verse being read at t centiseconds into chapter c: the last whose
// start is at or before t + 0.15 s; 0 before verse 1 (a psalm's title, an
// announcement), and the last verse past the end. -1 if the chapter has no
// timings.
audio_verse_at(s: int, c: int, t: int): int {
    n: int = tim_starts(s, c);
    if (n < 2) return -1;
    verses: int = n - 1;
    at: int = t + 15;
    if (at < ts[0]) return 0;
    lo: int = 0;
    hi: int = verses;
    // (The last start at or before at.)
    while (hi - lo > 1) {
        mid: int = (lo + hi) / 2;
        if (ts[mid] <= at) lo = mid else hi = mid
    }
    // (Verses that start together, as one left out does, go to the last.)
    while (lo + 1 < verses && ts[lo + 1] <= at) lo = lo + 1;
    lo + 1
}

// Where verse v of chapter c begins, less 0.3 s, clamped at 0 (verse 1, or
// a chapter without timings, begins at 0, so that what comes before verse
// 1 is heard).
audio_time_of(s: int, c: int, v: int): int {
    if (v <= 1) return 0;
    n: int = tim_starts(s, c);
    if (n < 2) return 0;
    k: int = if (v - 1 < n - 1) v - 1 else n - 2;
    t: int = ts[k] - 30;
    if (t < 0) 0 else t
}

// The verse shown at t when playing from verse hold (0: no hold): the seek
// lands 0.3 s before hold's start and the look-ahead is 0.15 s, so until
// hold begins the verse found would be the one before it; the verse asked
// for is shown instead (review r7-1). Whether the hold still stands is
// audio_hold_ended.
audio_verse_shown(
    s: int,
    c: int,
    t: int,
    hold: int
): int {
    v: int = audio_verse_at(s, c, t);
    if (hold > 1 && v >= 0 && v < hold && !audio_hold_ended(s, c, t, hold)) hold else v
}

audio_hold_ended(
    s: int,
    c: int,
    t: int,
    hold: int
): bool {
    n: int = tim_starts(s, c);
    if (hold <= 1 || n < 2 || hold > n - 1) return true;
    t + 15 >= ts[hold - 1]
}

// ---- a verse's place in a chapter without timings, by its words ----
// chars[i] is verse i + 1's spoken length (n verses): verse v's estimated
// start is its words' share before it, of the chapter's duration
// (centiseconds); and the verse estimated to be heard at t is the last
// whose estimated start is at or before it. A narrator or version changed
// mid-listen continues from the same verse this way when the new source
// has no timings for the chapter (owner, 2026-10-19).
audio_estimate_start(
    chars: []int,
    n: int,
    v: int,
    duration: int
): int {
    all: int = 0;
    before: int = 0;
    for i in 0..n {
        all = all + chars[i];
        if (i + 1 < v) before = before + chars[i]
    }
    if (all <= 0 || duration <= 0 || v <= 1) return 0;
    before * duration / all
}

audio_estimate_verse(
    chars: []int,
    n: int,
    t: int,
    duration: int
): int {
    if (n <= 0) return 0;
    v: int = 1;
    while (v < n && audio_estimate_start(chars, n, v + 1, duration) <= t) v = v + 1;
    v
}

// ---- which source a chapter is heard from ----
// Source s, for chapter c: s itself if its chapter is kept here, or the
// network is up and s has not failed in the last 60 s; else the voice. A
// chapter its timings say is missing is the voice's; so is everything of a
// source without recordings.
audio_effective(
    s: int,
    c: int,
    kept: bool,
    online: bool,
    failed_at: f64,
    now: f64
): int {
    if (s < 0 || s >= SRC_VOICE) return SRC_VOICE;
    if (src_timed(s) && tim_flag(s, c) == TIM_MISSING) return SRC_VOICE;
    if (kept && src_cacheable(s)) return s;
    if (online && (failed_at <= 0.0f64 || now - failed_at >= 60.0f64)) return s;
    SRC_VOICE
}

// Whether a chapter of source s is followed verse by verse (else by
// chapter).
follows_verses(s: int, c: int): bool {
    src_timed(s) && tim_flag(s, c) == TIM_OK && tim_starts(s, c) >= 2
}

// Where verse v of a chapter heard without timings is, estimated: its
// share of the chapter's spoken words before it (chars_before of
// chars_all), times the duration, less 3 s, clamped at 0 (centiseconds).
estimate_time(chars_before: int, chars_all: int, duration: int): int {
    if (chars_all <= 0 || chars_before <= 0) return 0;
    t: int = chars_before * duration / chars_all - 300;
    if (t < 0) 0 else t
}

// ---- the cache of chapters fetched ahead (index.tsv) ----
// Each chapter kept: its source, chapter, size and when it was last played
// (or fetched); at most 500 MB in all, the least recently played let go
// first; the chapter playing and the two after it never.
AC_MOST: int = 4096;

AC_LIMIT: int = 524288000;

ac_n: int = 0;

ac_src: []int = static_buffer([4096]int);

ac_c: []int = static_buffer([4096]int);

ac_bytes: []int = static_buffer([4096]int);

ac_used: []int = static_buffer([4096]int);

audio_cache_find(s: int, c: int): int {
    for i in 0..ac_n
        if (ac_src[i] == s && ac_c[i] == c) return i;
    -1
}

// A chapter kept (or kept again: its size and time made new).
audio_cache_add(
    s: int,
    c: int,
    bytes: int,
    t: int
) {
    i: int = audio_cache_find(s, c);
    if (i < 0) {
        if (ac_n >= AC_MOST) return;
        i = ac_n;
        ac_n = ac_n + 1
    }
    ac_src[i] = s;
    ac_c[i] = c;
    ac_bytes[i] = bytes;
    ac_used[i] = t
}

audio_cache_touch(s: int, c: int, t: int) {
    i: int = audio_cache_find(s, c);
    if (i >= 0) ac_used[i] = t
}

audio_cache_remove(i: int) {
    if (i < 0 || i >= ac_n) return;
    for j in i..ac_n - 1 {
        ac_src[j] = ac_src[j + 1];
        ac_c[j] = ac_c[j + 1];
        ac_bytes[j] = ac_bytes[j + 1];
        ac_used[j] = ac_used[j + 1]
    }
    ac_n = ac_n - 1
}

audio_cache_total(): int {
    n: int = 0;
    for i in 0..ac_n n = n + ac_bytes[i];
    n
}

// Whether entry i is pinned: the chapter playing (of source s) or one of
// the two after it.
audio_cache_pinned(i: int, s: int, playing: int): bool {
    ac_src[i] == s && playing >= 0 && ac_c[i] >= playing && ac_c[i] <= playing + 2
}

// The entry to let go next (the least recently played not pinned) while
// the total passes limit, or -1 if it is within it (or only pinned ones
// are left).
audio_cache_victim(limit: int, s: int, playing: int): int {
    if (audio_cache_total() <= limit) return -1;
    best: int = -1;
    for i in 0..ac_n {
        if (!audio_cache_pinned(i, s, playing) && (best < 0 || ac_used[i] < ac_used[best])) best = i
    }
    best
}

// The index as lines into fbuf-like bytes (SRC BOOK C BYTES USED), and read
// back from them (a bad line skipped).
audio_cache_format(out: []i8): int {
    n: int = 0;
    for i in 0..ac_n {
        for k in src_ids[ac_src[i]] n = au_put_byte(out, n, k as int);
        n = au_put_byte(out, n, 9);
        q: int = book_line[ch_book[ac_c[i]]] + 1;
        for x in 0..3 n = au_put_byte(out, n, bsb[q + x] as int);
        n = au_put_byte(out, n, 9);
        n = au_put_num(out, n, ch_num[ac_c[i]]);
        n = au_put_byte(out, n, 9);
        n = au_put_num(out, n, ac_bytes[i]);
        n = au_put_byte(out, n, 9);
        n = au_put_num(out, n, ac_used[i]);
        n = au_put_byte(out, n, 10)
    }
    n
}

au_put_byte(out: []i8, n: int, k: int): int {
    if (n >= len(out)) return n;
    out[n] = k trunc i8;
    n + 1
}

au_put_num(out: []i8, n: int, x: int): int {
    m: int = n;
    if (x >= 10) m = au_put_num(out, m, x / 10);
    au_put_byte(out, m, 48 + x % 10)
}

audio_cache_parse(b: []i8, n: int): int {
    ac_n = 0;
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && b[e] as int != 10) e = e + 1;
        f2: int = au_tab_after(b, p, e);
        f3: int = au_tab_after(b, f2, e);
        f4: int = au_tab_after(b, f3, e);
        f5: int = au_tab_after(b, f4, e);
        s: int = if (f2 <= e) src_of_id_at(b, p, f2 - 1) else -1;
        c: int = if (f2 <= e) au_line_chapter(b, f2, e) else -1;
        bytes: int = if (f5 <= e) au_num_at(b, f4, f5 - 1) else -1;
        used: int = if (f5 <= e) au_num_at(b, f5, e) else -1;
        if (s >= 0 && src_cacheable(s) && c >= 0 && bytes >= 0 && used >= 0) audio_cache_add(s,
            c, bytes, used);
        p = e + 1
    }
    ac_n
}

src_of_id_at(b: []i8, p: int, e: int): int {
    for s in 0..SOURCES {
        if (au_word_at(b, p, e, src_ids[s])) return s
    }
    -1
}

// ---- downloads: a book's size for a reader (its chapters' bytes) ----
book_bytes(s: int, b: int): int {
    n: int = 0;
    for c in book_first[b]..book_first[b] + book_count[b] n = n + tim_bytes(s, c);
    n
}

// A size as the screens say it: "96 MB", "1.2 GB", "None" for 0.
fput_size(bytes: int) {
    if (bytes <= 0) {
        fput_str("None");
        return
    }
    mb: int = (bytes + 524288) / 1048576;
    if (mb < 1) mb = 1;
    if (mb < 1000) {
        fput_int(mb);
        fput_str(" MB");
        return
    }
    tenths: int = bytes / 107374182 + 0;
    fput_int(tenths / 10);
    fput(46);
    fput_int(tenths % 10);
    fput_str(" GB")
}

// Fetch-ahead (§12.3.3): while a recording that can be kept plays, how
// many chapters after it are fetched: 10 on Wi-Fi, 1 on cellular (cellular
// is always treated as constrained), unless Download Ahead on Cellular is
// on.
audio_ahead_most(cellular: bool, ahead_on_cellular: bool): int {
    if (cellular && !ahead_on_cellular) 1 else 10
}

// Fetch-ahead's next chapter: the first of the most chapters after c
// that source s has (not one its timings say is missing) and the host
// does not hold (have), -1 none.
audio_ahead_next(
    s: int,
    c: int,
    most: int,
    have: fn(s: int, c: int): bool
): int {
    for k in 1..most + 1 {
        x: int = c + k;
        if (x < chapters && tim_flag(s, x) != TIM_MISSING && !have(s, x)) return x
    }
    -1
}

// ---- the device's voices ----
// A voice's place among those offered (-1: not offered): English only, no
// novelty or personal voices; better quality first (1 standard, 2
// Enhanced, 3 Premium), en-US first at equal quality. A better voice than
// the standard one is installed when the best scores VOICE_BETTER.
VOICE_BETTER: int = 20;

voice_score(
    english: bool,
    special: bool,
    quality: int,
    en_us: bool
): int {
    if (!english || special) -1 else quality * 10 + (if (en_us) 1 else 0)
}

// ---- downloads: books, by reader (§12.3.3) ----
// The books asked for (downloads.tsv: SRC BOOK a line, the reader's id and
// the book's code), each one's chapters fetched one at a time (the host's).
DL_MOST: int = 264;

dl_n: int = 0;

dl_src: []int = static_buffer([264]int);

dl_book: []int = static_buffer([264]int);

// The next chapter to download (dl_next_s, dl_next_c), downloads in their
// order, each book's chapters in turn: the first the host does not hold
// (have) that its timings don't say is missing; whether there is one.
dl_next_s: int = 0;

dl_next_c: int = -1;

dl_next(have: fn(s: int, c: int): bool): bool {
    for i in 0..dl_n {
        s: int = dl_src[i];
        b: int = dl_book[i];
        for c in book_first[b]..book_first[b] + book_count[b] {
            if (tim_flag(s, c) != TIM_MISSING && !have(s, c)) {
                dl_next_s = s;
                dl_next_c = c;
                return true
            }
        }
    }
    false
}

dl_index(s: int, b: int): int {
    for i in 0..dl_n
        if (dl_src[i] == s && dl_book[i] == b) return i;
    -1
}

// The list read from fbuf's lines (a bad line skipped).
downloads_parse() {
    dl_n = 0;
    begin_lines();
    while (next_line()) {
        e: int = field_end(fpos);
        s: int = src_of_id_at(fbuf, fpos, e);
        b: int = dl_book_at(field_after(fpos));
        if (s >= 0 && src_cacheable(s) && b >= 0 && dl_n < DL_MOST && dl_index(s,
            b) < 0) {
            dl_src[dl_n] = s;
            dl_book[dl_n] = b;
            dl_n = dl_n + 1
        }
    }
}

// A book's code at p (its line's field), or -1.
dl_book_at(p: int): int {
    if (p + 3 > line_e) return -1;
    for b in 0..books {
        same: bool = true;
        for i in 0..3
            if (bsb[book_line[b] + 1 + i] != fbuf[p + i]) same = false;
        if (same) return b
    }
    -1
}

// The list into fbuf, for the host to keep.
downloads_format() {
    fbuf_n = 0;
    for i in 0..dl_n {
        fput_str(src_ids[dl_src[i]]);
        fput(9);
        for x in 0..3 fput(bsb[book_line[dl_book[i]] + 1 + x] as int);
        fput(10)
    }
}

// A book asked for, or let go: whether the list changed.
dl_add(s: int, b: int): bool {
    if (!src_cacheable(s) || b < 0 || b >= books || dl_index(s, b) >= 0 || dl_n >= DL_MOST) return false;
    dl_src[dl_n] = s;
    dl_book[dl_n] = b;
    dl_n = dl_n + 1;
    true
}

dl_remove(s: int, b: int): bool {
    i: int = dl_index(s, b);
    if (i < 0) return false;
    for j in i..dl_n - 1 {
        dl_src[j] = dl_src[j + 1];
        dl_book[j] = dl_book[j + 1]
    }
    dl_n = dl_n - 1;
    true
}

// What the books asked for take (bytes).
downloaded_total(): int {
    n: int = 0;
    for i in 0..dl_n n = n + book_bytes(dl_src[i], dl_book[i]);
    n
}

// Book b's progress for reader s, in thousandths (have: its chapters here;
// part: how much of the one coming has come, 0 to 1): -1 not asked for;
// 1000 whole.
dl_progress(
    s: int,
    b: int,
    have: int,
    part: f64
): int {
    if (b < 0 || b >= books || dl_index(s, b) < 0) return -1;
    if (have >= book_count[b]) return 1000;
    p: f64 = if (part > 1.0f64) 1.0f64 else if (part < 0.0f64) 0.0f64 else part;
    n: int = ((have as f64 + p) * 1000.0f64 / book_count[b] as f64) as int;
    if (n > 999) 999 else n
}

// Text t's chosen source: the reader kept by its id (b's first n bytes; n
// 0: none chosen) if it reads t, or the voice; else t's default; the voice
// for the KJV, ASV and YLT, and for the ESV unless its recording is
// offered (esv_audio).
audio_source_of(
    t: int,
    b: []i8,
    n: int,
    esv_audio: bool
): int {
    if (len(src_setting(t)) == 0) return SRC_VOICE;
    if (t == TEXT_ESV && !esv_audio) return SRC_VOICE;
    if (n == 0) return text_default_src(t);
    s: int = src_of_id(b, n);
    if (s == SRC_VOICE || s >= 0 && src_texts[s] == t) s else text_default_src(t)
}

// Verse v's estimated time in chapter c's recording (centiseconds; its
// length duration): its share of the chapter's spoken words.
audio_estimate_verse_time(c: int, v: int, duration: int): int {
    if (duration <= 0 || ch_start[c] < 0) return 0;
    before: int = 0;
    all: int = 0;
    for x in 1..ch_verses[c] + 1 {
        n: int = speak_text(c, x);
        if (x < v) before = before + n;
        all = all + n
    }
    estimate_time(before, all, duration)
}

// The verse of chapter c being read t into a recording of it that has no
// timings (the ESV's), by the same estimate (1 if not known).
audio_estimate_verse_at(c: int, t: int, duration: int): int {
    v: int = 1;
    if (duration > 0 && t > 0) {
        while (v < ch_verses[c] && audio_estimate_verse_time(c, v + 1, duration) <= t) v = v + 1
    }
    v
}

// Previous on a recording: this chapter's start once more than this far
// into it (centiseconds), else the chapter before.
LP_PREVIOUS_INTO: int = 300
