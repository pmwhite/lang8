tag bible;

use_tag std;

// JSON read where it lies (the answers of the site's Worker: SKINS.md, the
// host), apart from any platform: a value is found by its key in an object,
// or in turn in an array, and read as a number, a truth or a string (its
// escapes undone, as UTF-8). Places are bytes of b, a value's first; -1 for
// none.
import "store.l8";

// The first byte of b from p (to e) that isn't white space.
json_ws(b: []i8, p: int, e: int): int {
    q: int = p;
    while (q < e && (b[q] as int == 32 || b[q] as int == 10 || b[q] as int == 13 || b[q] as int == 9)) q = q + 1;
    q
}

// Where the value at p ends.
json_skip(b: []i8, p_in: int, e: int): int {
    p: int = json_ws(b, p_in, e);
    if (p >= e) return e;
    k: int = b[p] as int;
    if (k == 34) {
        q: int = p + 1;
        while (q < e && b[q] as int != 34) q = q + (if (b[q] as int == 92) 2 else 1);
        return if (q < e) q + 1 else e
    }
    if (k == 123 || k == 91) {
        depth: int = 0;
        q: int = p;
        while (q < e) {
            c: int = b[q] as int;
            if (c == 34) q = json_skip(b, q, e) - 1 else if (c == 123 || c == 91) depth = depth + 1 else if (c == 125 || c == 93) {
                depth = depth - 1;
                if (depth == 0) return q + 1
            }
            q = q + 1
        }
        return e
    }
    q: int = p;
    while (q < e && b[q] as int != 44 && b[q] as int != 125 && b[q] as int != 93) q = q + 1;
    q
}

// The value of key in the object at p (-1: none).
json_get(
    b: []i8,
    p_in: int,
    e: int,
    key: str
): int {
    p: int = json_ws(b, p_in, e);
    if (p >= e || b[p] as int != 123) return -1;
    q: int = json_ws(b, p + 1, e);
    while (q < e && b[q] as int == 34) {
        ke: int = json_skip(b, q, e);
        same: bool = ke - q - 2 == len(key);
        if (same) {
            for i in 0..len(key)
                if (b[q + 1 + i] != key[i]) same = false
        }
        v: int = json_ws(b, ke, e);
        if (v < e && b[v] as int == 58) v = json_ws(b, v + 1, e);
        if (same) return v;
        q = json_ws(b, json_skip(b, v, e), e);
        if (q < e && b[q] as int == 44) q = json_ws(b, q + 1, e)
    }
    -1
}

// The array at p's first value, and the one after the value at p (-1: no
// more).
json_first(b: []i8, p_in: int, e: int): int {
    p: int = json_ws(b, p_in, e);
    if (p >= e || b[p] as int != 91) return -1;
    q: int = json_ws(b, p + 1, e);
    if (q >= e || b[q] as int == 93) -1 else q
}

json_next(b: []i8, p: int, e: int): int {
    q: int = json_ws(b, json_skip(b, p, e), e);
    if (q >= e || b[q] as int != 44) return -1;
    json_ws(b, q + 1, e)
}

json_int(b: []i8, p: int, e: int): int {
    if (p < 0) return 0;
    q: int = json_ws(b, p, e);
    neg: bool = q < e && b[q] as int == 45;
    if (neg) q = q + 1;
    n: int = 0;
    while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
        n = n * 10 + b[q] as int - 48;
        q = q + 1
    }
    if (neg) -n else n
}

json_true(b: []i8, p: int, e: int): bool {
    p >= 0 && p < e && b[p] as int == 116
}

// Decode into out and return the required byte count (0 for a non-string).
// A count greater than len(out) means exhaustion: out is incomplete and
// must not be consumed, including when it ends inside a UTF-8 character.
json_str(
    b: []i8,
    p: int,
    e: int,
    out: []i8
): int {
    if (p < 0 || p >= e || b[p] as int != 34) return 0;
    n: int = 0;
    q: int = p + 1;
    while (q < e && b[q] as int != 34) {
        k: int = b[q] as int & 255;
        if (k == 92 && q + 1 < e) {
            x: int = b[q + 1] as int;
            q = q + 2;
            if (x == 117) {
                u: int = json_hex4(b, q, e);
                q = q + 4;
                // (A surrogate pair: one character.)
                if (u >= 55296 && u < 56320 && q + 5 < e && b[q] as int == 92 && b[q + 1] as int == 117) {
                    lo: int = json_hex4(b, q + 2, e);
                    if (lo >= 56320 && lo < 57344) {
                        u = 65536 + (u - 55296) * 1024 + lo - 56320;
                        q = q + 6
                    }
                }
                n = json_put_utf8(out, n, u)
            } else n = json_put(out, n, if (x == 110) 10 else if (x == 116) 9 else if (x == 114) 13 else if (x == 98) 8 else if (x == 102) 12 else x)
        } else {
            n = json_put(out, n, k);
            q = q + 1
        }
    }
    n
}

json_put(out: []i8, n: int, k: int): int {
    if (n < len(out)) out[n] = k trunc i8;
    n + 1
}

json_put_utf8(out: []i8, n_in: int, u: int): int {
    n: int = n_in;
    if (u < 128) return json_put(out, n, u);
    if (u < 2048) {
        n = json_put(out, n, 192 + u / 64);
        return json_put(out, n, 128 + u % 64)
    }
    if (u < 65536) {
        n = json_put(out, n, 224 + u / 4096);
        n = json_put(out, n, 128 + u / 64 % 64);
        return json_put(out, n, 128 + u % 64)
    }
    n = json_put(out, n, 240 + u / 262144);
    n = json_put(out, n, 128 + u / 4096 % 64);
    n = json_put(out, n, 128 + u / 64 % 64);
    json_put(out, n, 128 + u % 64)
}

json_hex4(b: []i8, p: int, e: int): int {
    n: int = 0;
    for i in 0..4 {
        if (p + i >= e) return n;
        k: int = b[p + i] as int;
        d: int = if (k >= 48 && k <= 57) k - 48 else if (k >= 97 && k <= 102) k - 87 else if (k >= 65 && k <= 70) k - 55 else 0;
        n = n * 16 + d
    }
    n
}
