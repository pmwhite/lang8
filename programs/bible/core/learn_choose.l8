tag bible;

use_tag std;

// Practice chosen (Â§14.3, a buffet rather than a course): a language's
// cards picked by what they are (letters, words, Hebrew's joined words,
// forms), where from (those due, those struggling, new, known, all, or the
// words of the chapter being read) and how many; and the language page's
// Struggling rows, which practise those of a kind at once. Practising a
// card before it is due changes nothing unless it is answered Not Yet
// (memory.l8's schedule); either answer marks its misses.
import "skin.l8";

import "learn_screens.l8";

SCR_PRACTICE_CHOOSE: int = 52;

// The language page's Struggling rows (arg the kind), the chooser's
// choices (what: its segment's index as value; from and how many: arg),
// and its Practise.
ACT_LC_WEAK: int = 330;

ACT_LC_WHAT: int = 331;

ACT_LC_FROM: int = 332;

ACT_LC_MANY: int = 333;

ACT_LC_GO: int = 334;

// Practise Forms (the language page's).
ACT_LC_FORMS: int = 335;

// Your Words' filter (its segment's index as value).
ACT_LC_YW: int = 336;

// Your Words' filter: 0 all, 1 those struggling, 2 those known.
lc_yw_filter: int = 0;

tag bible
lc_yw_takes(k: int): bool {
    if (lc_yw_filter == 1) cd_struggling(k) else if (lc_yw_filter == 2) cd_known(k) else true
}

// Where from.
LC_DUE: int = 0;

LC_STRUGGLING: int = 1;

LC_NEW: int = 2;

LC_KNOWN: int = 3;

LC_ALL: int = 4;

LC_CHAPTER: int = 5;

LC_NEXT: int = 6;

lc_from_titles: []str = ["Due Today", "Struggling", "New", "Known", "All", "This Chapter\â\€\™s Words",
    "Next in Line"];

lc_from_lines: []str = ["What the schedule has for today.", "Those you have answered Not Yet more often than Knew It lately.",
    "Added, not yet practised.", "Answered Knew It, and not sent back since.", "Every one of the kind.",
    "Your cards for the words of the chapter you are reading.", "New ones, added now: the next letters, the words most common first, the forms."];

// How many (0: all).
lc_many_counts: []int = [5, 10, 20, 0];

// The choices, kept while the app runs: the kind (a CK_), where from, how
// many (lc_many_counts' index).
lc_kind: int = CK_WORD;

lc_from: int = LC_DUE;

lc_many: int = 1;

// The kinds offered for language lang, in the segments' order.
lc_kinds_n(lang: int): int {
    if (lang == 1) 4 else 3
}

lc_kind_at(lang: int, i: int): int {
    if (i == 0) CK_WORD else if (i == 1) CK_LETTER else if (i == 2) CK_FORM else CK_JOINED
}

lc_kind_titles(lang: int): str {
    if (lang == 1) "Words|Letters|Forms|Joined" else "Words|Letters|Forms"
}

// Whether card k is one the choices take.
lc_takes(
    k: int,
    lang: int,
    kind: int,
    from: int,
    today: int
): bool {
    if (cd_lang[k] != lang || cd_kind[k] != kind) return false;
    if (from == LC_DUE) return cd_due_by(k, today);
    if (from == LC_STRUGGLING) return cd_struggling(k);
    if (from == LC_NEW) return cd_state[k] == MS_NEW;
    if (from == LC_KNOWN) return cd_known(k);
    if (from == LC_CHAPTER) return kind == CK_WORD && lc_in_chapter(cd_key[k]);
    true
}

// The words of the chapter being read (learn_words_of's wo_num), made
// for the choosing.
lc_in_chapter(num: int): bool {
    for x in 0..wo_n
        if (wo_num[x] == num) return true;
    false
}

// The cards the choices take, into sk_pq (the struggling first, the most
// missed first; else as they come), at most how many: how many.
lc_pick(
    language: *LanguageData,
    lang: int,
    kind: int,
    from: int,
    most: int
): int {
    // (Next in line: new cards made, as many as asked for, all if none.)
    if (from == LC_NEXT) return lc_next_add(language, lang, kind, if (most == 0) len(sk_pq) else most);
    today: int = sk_today_now();
    if (from == LC_CHAPTER) learn_words_of(language, sk_c, 1, sk_c, 999);
    sk_pq_n = 0;
    for m in [CD_MISSES_MOST, 4, 3, 2, 1, 0] {
        for k in 0..cd_n {
            if (cd_misses[k] == m && lc_takes(k, lang, kind, from, today) && sk_pq_n < len(sk_pq) && (most == 0 || sk_pq_n < most)) {
                sk_pq[sk_pq_n] = k;
                sk_pq_n = sk_pq_n + 1
            }
        }
    }
    sk_pq_n
}

// How many the choices take (all of them).
lc_count(
    language: *LanguageData,
    lang: int,
    kind: int,
    from: int
): int {
    // (Next in line: how many are, none made.)
    if (from == LC_NEXT) return lc_in_line(language, lang, kind);
    n: int = lc_pick(language, lang, kind, from, 0);
    sk_pq_n = 0;
    n
}

// How many of language lang's cards of kind are struggling.
tag bible
lc_struggling(lang: int, kind: int): int {
    n: int = 0;
    for k in 0..cd_n
        if (cd_lang[k] == lang && cd_kind[k] == kind && cd_struggling(k)) n = n + 1;
    n
}

// A Struggling row of the language page (none while there are none):
// "Struggling Words Â· 4", practising them at once.
tag bible
lc_weak_row(lang: int, kind: int, title: str) {
    n: int = lc_struggling(lang, kind);
    if (n == 0) return;
    ui_row(UI_ITEM, ACT_LC_WEAK, kind);
    ui_set_title(title);
    fbuf_n = 0;
    fput_count(n);
    ui_set_detail_fbuf();
    ui_set_value_detail();
    ui_set_acc(ACC_MORE)
}

// Practise Forms' session, into sk_pq: the forms due, then those
// struggling, then up to FC_NEW terms not met yet (in the list's order,
// added), then others met before, to FC_SESSION in all: how many.
FC_SESSION: int = 10;

FC_NEW: int = 3;

fc_session(language: *LanguageData, lang: int): int {
    today: int = sk_today_now();
    sk_pq_n = 0;
    for pass in 0..2 {
        for k in 0..cd_n {
            if (cd_kind[k] == CK_FORM && cd_lang[k] == lang && sk_pq_n < FC_SESSION && !lc_queued(k) && (if (pass == 0) cd_due_by(k,
                today) else cd_struggling(k))) {
                sk_pq[sk_pq_n] = k;
                sk_pq_n = sk_pq_n + 1
            }
        }
    }
    added: int = 0;
    for i in 0..len(fc_terms[lang]) {
        g: int = fc_line_cache(language, lang, i);
        if (g >= 0 && added < FC_NEW && sk_pq_n < FC_SESSION && fc_card_of(lang, g) < 0) {
            k: int = fc_add(language, lang, g, today, time(0));
            if (k >= 0) {
                sk_pq[sk_pq_n] = k;
                sk_pq_n = sk_pq_n + 1;
                added = added + 1
            }
        }
    }
    if (added > 0) {
        learn_refresh();
        sk_kept(SK_KEPT_CARDS)
    }
    for k in 0..cd_n {
        if (cd_kind[k] == CK_FORM && cd_lang[k] == lang && sk_pq_n < FC_SESSION && !lc_queued(k)) {
            sk_pq[sk_pq_n] = k;
            sk_pq_n = sk_pq_n + 1
        }
    }
    sk_pq_n
}

// Whether card k is in sk_pq already.
lc_queued(k: int): bool {
    for x in 0..sk_pq_n
        if (sk_pq[x] == k) return true;
    false
}

// ---- Practiceâ€¦ ----
tag bible
sk_build_practice_choose(language: *LanguageData, id: int, lang: int) {
    ui_begin(id, SCR_PRACTICE_CHOOSE, lang, "Practice");
    // (What: a kind this language has.)
    if (lc_kind == CK_JOINED && lang == 0) lc_kind = CK_WORD;
    at: int = 0;
    for i in 0..lc_kinds_n(lang)
        if (lc_kind_at(lang, i) == lc_kind) at = i;
    ui_set_segments(lc_kind_titles(lang), at, ACT_LC_WHAT);
    ui_section("From", "");
    for f in 0..len(lc_from_titles) {
        if (f != LC_CHAPTER || lc_kind == CK_WORD) {
            ui_row(UI_ITEM, ACT_LC_FROM, f);
            ui_set_title(lc_from_titles[f]);
            ui_set_detail(lc_from_lines[f]);
            fbuf_n = 0;
            fput_count(if (f == LC_NEXT) lc_in_line(language, lang, lc_kind) else lc_count(language,
                lang, lc_kind, f));
            ui_set_trailing_fbuf();
            if (f == lc_from) ui_set_acc(ACC_CHECK)
        }
    }
    if (lc_from == LC_CHAPTER && lc_kind != CK_WORD) lc_from = LC_ALL;
    ui_section("How Many", "");
    for m in 0..len(lc_many_counts) {
        ui_row(UI_ITEM, ACT_LC_MANY, m);
        fbuf_n = 0;
        if (lc_many_counts[m] == 0) fput_str("All") else fput_int(lc_many_counts[m]);
        ui_set_title_fbuf();
        if (m == lc_many) ui_set_acc(ACC_CHECK)
    }
    n: int = lc_count(language, lang, lc_kind, lc_from);
    most: int = lc_many_counts[lc_many];
    if (most > 0 && n > most) n = most;
    ui_tool("", "", ACT_LC_GO, 0, if (n == 0) UI_TOOL_OFF else UI_TOOL_PROMINENT,
        1);
    fbuf_n = 0;
    if (n == 0) fput_str("Nothing to Practise") else {
        fput_str("Practise ");
        fput_int(n)
    }
    ui_set_tool_title_fbuf()
}

tag bible
sk_lc_act(
    language: *LanguageData,
    at: int,
    action: int,
    arg: int,
    value: int
) {
    lang: int = sk_args[at];
    if (action == ACT_LC_WEAK) {
        // (From the language page: those struggling of the kind, at once.)
        if (lc_pick(language, lang, arg, LC_STRUGGLING, 20) > 0) px_start(language,
            PXS_NEW, 0);
        return
    }
    if (action == ACT_LC_FORMS) {
        if (fc_session(language, lang) > 0) px_start(language, PXS_NEW, 0);
        return
    }
    if (action == ACT_LC_GO) {
        if (lc_pick(language, lang, lc_kind, lc_from, lc_many_counts[lc_many]) > 0) px_start(language,
            PXS_NEW, 0);
        return
    }
    if (action == ACT_LC_YW) lc_yw_filter = (if (value < 0 || value > 2) 0 else value) else if (action == ACT_LC_WHAT) lc_kind = lc_kind_at(lang,
        value) else if (action == ACT_LC_FROM) lc_from = arg else if (action == ACT_LC_MANY) lc_many = arg;
    sk_build(at);
    ui_effect("update", sk_ids[at], -1)
}
