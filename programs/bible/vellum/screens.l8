    add_method2(list, sel("searchBar:textDidChange:"), &search_typed, "v@:@@");
    add_method1(list, sel("searchBarSearchButtonClicked:"), &search_returned, "v@:@");
    add_method2(list, sel("searchBar:selectedScopeButtonIndexDidChange:"), &search_scope_chosen,
        "v@:@q");
    add_method5(list, sel("textView:shouldInteractWithURL:inRange:interaction:"),
        &text_link, "B@:@@{_NSRange=QQ}q");
