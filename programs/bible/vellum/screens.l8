    add_protocol(list, "UICollectionViewDelegate");
    add_protocol(list, "UISearchBarDelegate");
    add_protocol(list, "UITextFieldDelegate");
    add_protocol(list, "UITextViewDelegate");
    delegate: int = class_make(cls("NSObject"), "VellumScreens");
    add_method3(delegate, sel("navigationController:didShowViewController:animated:"),
        &nav_showed, "v@:@@B");
