}

// (The panel's navigation laid out: where its sheet's top is, whatever
// screen it shows.)
nav_laid_out(self: int, cmd: int): int {
    _r: int = super1(self, cls("VellumNav"), cmd, 0);
    if (self == panel.nav && self != 0) panel_top_measure();
    0
}

nav_status_top(self: int, _cmd: int): int {
    msg(self, sel("topViewController"))
}

// (The list kept the view's size; the panel's reader laid out.)
list_will_layout(self: int, _cmd: int): int {
    s: int = slot_of_controller(self);
    if (s >= 0 && slots[s].list == 0) panel_reader_layout(self);
    0
}
