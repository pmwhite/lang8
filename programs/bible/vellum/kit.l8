tag vellum;

use_tag std, ios;

// UIKit from L8, as Vellum uses it: the shapes of message it sends beyond
// programs/ios/objc.l8's, frames and geometry read into one scratch array,
// colors, fonts and symbols, objects held by globals, timers, haptics, and
// animations whose blocks are made once a build (each animation names what
// it lays out: anim_run's kinds).
import "../../ios/objc.l8";

import "../../ios/block.l8";

extern CACurrentMediaTime(): f64;

extern UIAccessibilityIsReduceMotionEnabled(): int;

extern UIAccessibilityIsVoiceOverRunning(): int;

extern UIAccessibilityPostNotification(kind: int, argument: int): int;

// ---- shapes of message ----
extern msg_f4(
    receiver: int,
    selector: int,
    t: f64,
    a: int,
    b: int,
    c: int,
    d: int
): int = objc_msgSend;

extern msg_set_f32(receiver: int, selector: int, value: f32): int = objc_msgSend;

extern msg_rect1(
    receiver: int,
    selector: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    a: int
): int = objc_msgSend;

// A rectangle and a double (a corner's radius: bezierPathWithRoundedRect:).
extern msg_rect_f(
    receiver: int,
    selector: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    r: f64
): int = objc_msgSend;

// Four doubles (UIEdgeInsets) and nothing else.
extern msg_insets(
    receiver: int,
    selector: int,
    top: f64,
    left: f64,
    bottom: f64,
    right: f64
): int = objc_msgSend;

// A spring's animation (iOS 17): its duration, bounce, initial speed and
// delay, its options, and its blocks.
extern msg_spring(
    receiver: int,
    selector: int,
    duration: f64,
    bounce: f64,
    velocity: f64,
    delay: f64,
    options: int,
    animations: int,
    completion: int
): int = objc_msgSend;

// A plain animation: duration, delay, options and its blocks.
extern msg_animate(
    receiver: int,
    selector: int,
    duration: f64,
    delay: f64,
    options: int,
    animations: int,
    completion: int
): int = objc_msgSend;

// An object then a double (a color's alpha, a font's size).
extern msg1_ff(
    receiver: int,
    selector: int,
    a: int,
    x: f64,
    y: f64
): int = objc_msgSend;

extern msg_f_ret_f(receiver: int, selector: int, x: f64): f64 = objc_msgSend;

extern msg_f_obj_kit(receiver: int, selector: int, x: f64): int = objc_msgSend;

extern msg1_ret_f(receiver: int, selector: int, a: int): f64 = objc_msgSend;

// ---- geometry ----
// Four doubles a message returned (a rectangle, insets, a point, a size),
// read by geo_*: a scratch, as every callback's.
geo: []f64 = new f64[4](0.0f64);

geo_of(object: int, name: str) {
    l8_msg_hfa(geo, object, sel(name), 0, 0, 0)
}

geo_of1(object: int, name: str, a: int) {
    l8_msg_hfa(geo, object, sel(name), a, 0, 0)
}

// A rectangle: its origin and size.
type Rect = {
    x: f64;
    y: f64;
    w: f64;
    h: f64
}

// Insets: top, left, bottom, right.
type Insets = {
    top: f64;
    left: f64;
    bottom: f64;
    right: f64
}

bounds_of(view: int): Rect {
    geo_of(view, "bounds");
    Rect {
        x: geo[0],
        y: geo[1],
        w: geo[2],
        h: geo[3]
    }
}

frame_of(view: int): Rect {
    geo_of(view, "frame");
    Rect {
        x: geo[0],
        y: geo[1],
        w: geo[2],
        h: geo[3]
    }
}

safe_insets(view: int): Insets {
    geo_of(view, "safeAreaInsets");
    Insets {
        top: geo[0],
        left: geo[1],
        bottom: geo[2],
        right: geo[3]
    }
}

set_frame(view: int, r: Rect) {
    msg_rect(view, sel("setFrame:"), r.x, r.y, r.w, r.h)
}

set_frame4(
    view: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64
) {
    msg_rect(view, sel("setFrame:"), x, y, w, h)
}

// A view's own size (a label's: its preferredMaxLayoutWidth set for
// several lines), as UIKit measures it.
intrinsic_size(view: int): Rect {
    geo_of(view, "intrinsicContentSize");
    Rect {
        x: 0.0f64,
        y: 0.0f64,
        w: geo[0],
        h: geo[1]
    }
}

point_in(gesture: int, view: int): Rect {
    geo_of1(gesture, "locationInView:", view);
    Rect {
        x: geo[0],
        y: geo[1],
        w: 0.0f64,
        h: 0.0f64
    }
}

offset_y(sv: int): f64 {
    geo_of(sv, "contentOffset");
    geo[1]
}

set_offset_y(sv: int, y: f64) {
    msg_ff(sv, sel("setContentOffset:"), 0.0f64, y)
}

content_insets(sv: int): Insets {
    geo_of(sv, "adjustedContentInset");
    Insets {
        top: geo[0],
        left: geo[1],
        bottom: geo[2],
        right: geo[3]
    }
}

clamp_f(x: f64, lo: f64, hi: f64): f64 {
    if (x < lo) lo else if (x > hi) hi else x
}

clamp_i(x: int, lo: int, hi: int): int {
    if (x < lo) lo else if (x > hi) hi else x
}

abs_f(x: f64): f64 {
    if (x < 0.0f64) -x else x
}

// ---- objects held ----
release(object: int) {
    if (object != 0) msg(object, sel("release"))
}

retain(object: int): int {
    if (object != 0) msg(object, sel("retain"));
    object
}

// An object held in place of the one before (which is let go).
held(old: int, object: int): int {
    _kept: int = retain(object);
    release(old);
    object
}

autoreleased(object: int): int {
    if (object != 0) msg(object, sel("autorelease"));
    object
}

// An object of class name, made with alloc and init, autoreleased.
fresh(name: str): int {
    autoreleased(make(name))
}

is_kind(object: int, name: str): bool {
    object != 0 && (msg1(object, sel("isKindOfClass:"), cls(name)) & 255) != 0
}

responds(object: int, name: str): bool {
    object != 0 && (msg1(object, sel("respondsToSelector:"), sel(name)) & 255) != 0
}

truth(answer: int): bool {
    (answer & 255) != 0
}

nsnumber_int(n: int): int {
    msg1(cls("NSNumber"), sel("numberWithLong:"), n)
}

ns_equal(a: int, b: int): bool {
    if (a == 0 || b == 0) return a == b;
    truth(msg1(a, sel("isEqual:"), b))
}

ns_length(s: int): int {
    if (s == 0) 0 else msg(s, sel("length"))
}

// The characters cp (and cp2, if not 0) as an NSString (autoreleased).
char_buf: []i8 = new i8[8](0i8);

char_string(cp: int, cp2: int): int {
    n: int = utf8_write(char_buf, 0, cp);
    if (cp2 != 0) n = utf8_write(char_buf, n, cp2);
    nsstring_of(char_buf, n)
}

utf8_write(out: []i8, at: int, cp: int): int {
    if (cp < 128) {
        out[at] = cp trunc i8;
        return at + 1
    }
    if (cp < 2048) {
        out[at] = (192 + cp / 64) trunc i8;
        out[at + 1] = (128 + cp % 64) trunc i8;
        return at + 2
    }
    out[at] = (224 + cp / 4096) trunc i8;
    out[at + 1] = (128 + cp / 64 % 64) trunc i8;
    out[at + 2] = (128 + cp % 64) trunc i8;
    at + 3
}

// ---- a scratch of words: the skin's own text, never core's ----
words_buf: []i8 = new i8[65536](0i8);

words_n: int = 0;

words_begin() {
    words_n = 0
}

words_add(s: str) {
    for c in s {
        if (words_n < len(words_buf)) {
            words_buf[words_n] = c;
            words_n = words_n + 1
        }
    }
}

words_add_int(n: int) {
    if (n < 0) {
        words_add("-");
        words_add_int(-n);
        return
    }
    if (n >= 10) words_add_int(n / 10);
    if (words_n < len(words_buf)) {
        words_buf[words_n] = (48 + n % 10) trunc i8;
        words_n = words_n + 1
    }
}

words_ns_scratch: []i8 = new i8[8192](0i8);

words_add_ns(s: int) {
    if (s == 0) return;
    n: int = nsstring_into(s, words_ns_scratch);
    for i in 0..n {
        if (words_n < len(words_buf)) {
            words_buf[words_n] = words_ns_scratch[i];
            words_n = words_n + 1
        }
    }
}

words_ns(): int {
    nsstring_of(words_buf, words_n)
}

// ---- colors ----
// A color of 0xRRGGBB at alpha (autoreleased).
rgb(hex: int, alpha: f64): int {
    msg_rect(cls("UIColor"), sel("colorWithRed:green:blue:alpha:"), (hex / 65536 % 256) as f64 / 255.0f64,
        (hex / 256 % 256) as f64 / 255.0f64, (hex % 256) as f64 / 255.0f64, alpha)
}

with_alpha(color: int, alpha: f64): int {
    if (color == 0) 0 else msg_set_f(color, sel("colorWithAlphaComponent:"), alpha)
}

system_color(name: str): int {
    msg(cls("UIColor"), sel(name))
}

clear_color(): int {
    system_color("clearColor")
}

// Hex a over b at t (0xRRGGBB each).
mix_hex(a: int, b: int, t: f64): int {
    r: int = ((a / 65536 % 256) as f64 * (1.0f64 - t) + (b / 65536 % 256) as f64 * t + 0.5f64) as int;
    g: int = ((a / 256 % 256) as f64 * (1.0f64 - t) + (b / 256 % 256) as f64 * t + 0.5f64) as int;
    bl: int = ((a % 256) as f64 * (1.0f64 - t) + (b % 256) as f64 * t + 0.5f64) as int;
    r * 65536 + g * 256 + bl
}

// ---- fonts and symbols ----
font_system(size: f64, weight: f64): int {
    msg_ff(cls("UIFont"), sel("systemFontOfSize:weight:"), size, weight)
}

// The system's rounded design at size and weight (the dock's words).
font_rounded(size: f64, weight: f64): int {
    f: int = font_system(size, weight);
    d: int = msg1(msg(f, sel("fontDescriptor")), sel("fontDescriptorWithDesign:"),
        objc_const("UIFontDescriptorSystemDesignRounded"));
    if (d == 0) f else msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

font_monospaced_digits(size: f64, weight: f64): int {
    msg_ff(cls("UIFont"), sel("monospacedDigitSystemFontOfSize:weight:"), size, weight)
}

// A text style's font, as Dynamic Type sizes it now.
font_style(style: str): int {
    msg1(cls("UIFont"), sel("preferredFontForTextStyle:"), objc_const(style))
}

// An SF Symbol's image (autoreleased; 0: no such symbol), at point size and
// weight (UIImageSymbolWeight: 4 regular, 5 medium, 6 semibold, 7 bold).
symbol_image(name: int, size: f64, weight: int): int {
    if (name == 0) return 0;
    config: int = msg1_f(cls("UIImageSymbolConfiguration"), sel("configurationWithPointSize:weight:"),
        weight, size);
    image: int = msg1(cls("UIImage"), sel("systemImageNamed:"), name);
    if (image == 0) return 0;
    msg1(image, sel("imageWithConfiguration:"), config)
}

symbol(name: str, size: f64, weight: int): int {
    symbol_image(nsstring(name), size, weight)
}

// ---- views ----
view_new(): int {
    msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"), 0.0f64, 0.0f64,
        0.0f64, 0.0f64)
}

add_sub(parent: int, child: int) {
    msg1(parent, sel("addSubview:"), child)
}

set_hidden(view: int, hidden: bool) {
    msg1(view, sel("setHidden:"), if (hidden) 1 else 0)
}

set_alpha(view: int, alpha: f64) {
    msg_set_f(view, sel("setAlpha:"), alpha)
}

set_background(view: int, color: int) {
    msg1(view, sel("setBackgroundColor:"), color)
}

// Corners rounded to radius r, continuous (the system's squircle); a
// glass view's by its corner configuration (iOS 26), which its glass
// follows.
set_corners(view: int, r: f64) {
    corners: int = cls("UICornerConfiguration");
    radii: int = cls("UICornerRadius");
    if (corners != 0 && radii != 0 && responds(corners, "configurationWithUniformRadius:") && responds(radii,
        "fixedRadius:") && is_kind(view, "UIVisualEffectView") && responds(view, "setCornerConfiguration:")) {
        radius: int = msg_f_obj_kit(radii, sel("fixedRadius:"), r);
        if (radius != 0) {
            config: int = msg1(corners, sel("configurationWithUniformRadius:"), radius);
            if (config != 0) msg1(view, sel("setCornerConfiguration:"), config)
        }
    }
    layer: int = msg(view, sel("layer"));
    msg_set_f(layer, sel("setCornerRadius:"), r);
    msg1(layer, sel("setCornerCurve:"), objc_const("kCACornerCurveContinuous"))
}

// A view's transform: a CGAffineTransform's six doubles (a, b, c, d, tx,
// ty). Larger than four doubles, arm64 passes it in memory, its address
// as the argument: the slice's.
extern msg_affine(receiver: int, selector: int, t: []f64): int = objc_msgSend;

affine: []f64 = new f64[6](0.0f64);

set_transform(
    view: int,
    sx: f64,
    sy: f64,
    dx: f64,
    dy: f64
) {
    affine[0] = sx;
    affine[1] = 0.0f64;
    affine[2] = 0.0f64;
    affine[3] = sy;
    affine[4] = dx;
    affine[5] = dy;
    _r: int = msg_affine(view, sel("setTransform:"), affine)
}

set_transform_identity(view: int) {
    set_transform(view, 1.0f64, 1.0f64, 0.0f64, 0.0f64)
}

// A label (autoreleased) in font and color, its lines (0: any).
label_new(font: int, color: int, lines: int): int {
    l: int = autoreleased(view_label());
    msg1(l, sel("setFont:"), font);
    msg1(l, sel("setTextColor:"), color);
    msg1(l, sel("setNumberOfLines:"), lines);
    l
}

view_label(): int {
    msg_rect(msg(cls("UILabel"), sel("alloc")), sel("initWithFrame:"), 0.0f64, 0.0f64,
        0.0f64, 0.0f64)
}

// ---- liquid glass (iOS 26) ----
// A view of glass (UIGlassEffect, regular; interactive: it answers a touch
// as the system's buttons do), autoreleased; its content view is where
// what it shows goes. (Before iOS 26, the system's thin material.)
glass_view(interactive: bool): int {
    effect: int = 0;
    glass: int = cls("UIGlassEffect");
    if (glass != 0) {
        effect = msg(glass, sel("new"));
        if (interactive && responds(effect, "setInteractive:")) msg1(effect, sel("setInteractive:"),
            1);
        _a: int = autoreleased(effect)
    } else effect = msg1(cls("UIBlurEffect"), sel("effectWithStyle:"), 8);
    autoreleased(msg1(msg(cls("UIVisualEffectView"), sel("alloc")), sel("initWithEffect:"),
        effect))
}

// A container whose glass views merge as they come near one another
// (UIGlassContainerEffect), spacing apart: autoreleased. (Before iOS 26, a
// plain view.)
glass_container(spacing: f64): int {
    container: int = cls("UIGlassContainerEffect");
    if (container == 0) return autoreleased(view_new());
    effect: int = autoreleased(msg(container, sel("new")));
    if (responds(effect, "setSpacing:")) msg_set_f(effect, sel("setSpacing:"), spacing);
    autoreleased(msg1(msg(cls("UIVisualEffectView"), sel("alloc")), sel("initWithEffect:"),
        effect))
}

// A glass view's tint (its effect's), so its words read over any words
// passing under it.
glass_tint(glass: int, color: int) {
    if (!is_kind(glass, "UIVisualEffectView")) return;
    effect: int = msg(glass, sel("effect"));
    if (effect == 0 || !responds(effect, "setTintColor:")) return;
    tinted: int = msg(effect, sel("copy"));
    msg1(tinted, sel("setTintColor:"), color);
    msg1(glass, sel("setEffect:"), tinted);
    release(tinted)
}

// A glass view's glass made or taken away (its effect set or let go: in
// an animation, iOS 26 materializes the glass, or dissolves it, as its own
// controls do), its contents shown with it. A glass view faded by its
// alpha draws no glass, only its contents, bare: hence this. Nothing done
// if it is already as asked.
glass_shown(
    glass: int,
    shown: bool,
    interactive: bool,
    tint: int
) {
    if (!is_kind(glass, "UIVisualEffectView") || cls("UIGlassEffect") == 0) {
        set_alpha(glass, if (shown) 1.0f64 else 0.0f64);
        return
    }
    has: bool = msg(glass, sel("effect")) != 0;
    if (has != shown) {
        effect: int = 0;
        if (shown) {
            effect = autoreleased(msg(cls("UIGlassEffect"), sel("new")));
            if (interactive && responds(effect, "setInteractive:")) msg1(effect, sel("setInteractive:"),
                1);
            if (tint != 0 && responds(effect, "setTintColor:")) msg1(effect, sel("setTintColor:"),
                tint)
        }
        msg1(glass, sel("setEffect:"), effect)
    }
    set_alpha(glass, 1.0f64);
    set_alpha(glass_content(glass), if (shown) 1.0f64 else 0.0f64)
}

glass_content(glass: int): int {
    if (is_kind(glass, "UIVisualEffectView")) msg(glass, sel("contentView")) else glass
}

// ---- motion ----
reduce_motion(): bool {
    truth(UIAccessibilityIsReduceMotionEnabled())
}

voice_over(): bool {
    truth(UIAccessibilityIsVoiceOverRunning())
}

// Animations, a block each kind made once a build: the handler lays out
// what the kind names (anim_run, in app.l8, by kind), inside UIKit's
// animation; Reduce Motion lays it out at once, or cross-fades.
ANIM_KINDS: int = 32;

anim_blocks: []int = new int[32](0);

anim_done_blocks: []int = new int[32](0);

anim_block(kind: int): int {
    if (anim_blocks[kind] == 0) anim_blocks[kind] = block0(&anim_entered, kind, "v8@?0");
    anim_blocks[kind]
}

anim_done_block(kind: int): int {
    if (anim_done_blocks[kind] == 0) anim_done_blocks[kind] = block1(&anim_finished,
        kind, "v12@?0B8");
    anim_done_blocks[kind]
}

anim_entered(kind: int): int {
    anim_run(kind);
    0
}

anim_finished(kind: int, _finished: int): int {
    anim_ended(kind);
    0
}

// Kind laid out with a spring of duration seconds and bounce (0 none),
// allowing touches and starting from where it is; its end said
// (anim_ended).
spring(kind: int, duration: f64, bounce: f64) {
    if (reduce_motion()) {
        anim_run(kind);
        anim_ended(kind);
        return
    }
    // (UIViewAnimationOptionAllowUserInteraction | BeginFromCurrentState.)
    _r: int = msg_spring(cls("UIView"), sel("animateWithSpringDuration:bounce:initialSpringVelocity:delay:options:animations:completion:"),
        duration, bounce, 0.0f64, 0.0f64, 2 | 4, anim_block(kind), anim_done_block(kind))
}

// Kind laid out over duration seconds, eased in and out.
ease(kind: int, duration: f64) {
    if (reduce_motion()) {
        anim_run(kind);
        anim_ended(kind);
        return
    }
    _r: int = msg_animate(cls("UIView"), sel("animateWithDuration:delay:options:animations:completion:"),
        duration, 0.0f64, 2 | 4, anim_block(kind), anim_done_block(kind))
}

// Kind laid out over duration seconds after delay, eased in and out.
ease_after(kind: int, duration: f64, delay: f64) {
    if (reduce_motion()) {
        anim_run(kind);
        anim_ended(kind);
        return
    }
    _r: int = msg_animate(cls("UIView"), sel("animateWithDuration:delay:options:animations:completion:"),
        duration, delay, 2 | 4, anim_block(kind), anim_done_block(kind))
}

// A view's next change of contents cross-faded over seconds.
cross_fade(view: int, seconds: f64) {
    if (view == 0 || reduce_motion()) return;
    t: int = make("CATransition");
    msg1(t, sel("setType:"), objc_const("kCATransitionFade"));
    msg_set_f(t, sel("setDuration:"), seconds);
    msg2(msg(view, sel("layer")), sel("addAnimation:forKey:"), t, nsstring("fade"));
    release(t)
}

// ---- timers ----
// A timer sending selector name to target after t seconds, in the run
// loop's common modes (it fires while a finger scrolls).
timer_after(target: int, t: f64, name: str): int {
    timer: int = msg_f4(cls("NSTimer"), sel("timerWithTimeInterval:target:selector:userInfo:repeats:"),
        t, target, sel(name), 0, 0);
    msg2(msg(cls("NSRunLoop"), sel("mainRunLoop")), sel("addTimer:forMode:"), timer,
        l8_run_loop_common_modes());
    timer
}

timer_stop(timer: int): int {
    if (timer != 0) msg(timer, sel("invalidate"));
    0
}

// ---- touch's feedback ----
haptic_generators: []int = new int[4](0);

// A selection's tick.
haptic_tick() {
    if (haptic_generators[0] == 0) haptic_generators[0] = make("UISelectionFeedbackGenerator");
    msg(haptic_generators[0], sel("selectionChanged"))
}

// An impact: 0 light, 1 medium, 2 soft.
haptic_impact(style: int) {
    k: int = 1 + clamp_i(style, 0, 2);
    if (haptic_generators[k] == 0) haptic_generators[k] = msg1(msg(cls("UIImpactFeedbackGenerator"),
        sel("alloc")), sel("initWithStyle:"), if (style == 2) 3 else style);
    msg(haptic_generators[k], sel("impactOccurred"))
}
