tag vellum;

use_tag std, ios, bible, bible_wire;

// The look as core says it (its `look`, `highlights` and `themes` lines)
// and the reader's type made from it. Colors are kept as core gives them,
// numbers (0xRRGGBB), and made into UIColors as the views are dressed.
// Each pane has a type set of its own (the panel's a little smaller than
// the page's beside it): every style's font at its em, and each style's
// attributes in each kind of paragraph, made as they are first wanted.
import "../../ios/objc.l8";

import "../core/text.l8";

import "kit.l8";

// ---- the look ----
type Look = {
    // The text's size (a multiple of the system's), its lines' height (a
    // multiple), its margins (points) and its widest column (em).
    size: f64;
    spacing: f64;
    margin: f64;
    column: f64;
    dark: bool;
    // The words of Jesus in the accent.
    red: bool;
    page: int;
    ink: int;
    heading: int;
    faint: int;
    accent: int;
    rule: int;
    // Strengths (0 to 1): a glossed word's dotted line, a hairline, a
    // selection's wash.
    gloss: f64;
    hairline: f64;
    selection: f64;
    // A sheet's and its rows' colors (-1: the system's grouped ones).
    sheet: int;
    cell: int;
    // The font chosen (of sk_fonts), the theme it is and the one chosen.
    font: int;
    theme: int;
    chosen: int
}

look: Look = Look {
    size: 1.0f64,
    spacing: 1.5f64,
    margin: 24.0f64,
    column: 34.0f64,
    dark: false,
    red: false,
    page: 16777215,
    ink: 1710618,
    heading: 1710618,
    faint: 8421504,
    accent: 12729122,
    rule: 1710618,
    gloss: 0.32f64,
    hairline: 0.12f64,
    selection: 0.12f64,
    sheet: -1,
    cell: -1,
    font: 0,
    theme: 1,
    chosen: 0
};

// Whether core has said its look yet (the views are made before it, in
// the system's colors).
look_said: bool = false;

LOOK_FONT_NAMES: []str = ["New York", "Iowan", "Charter", "Georgia", "San Francisco"];

LOOK_FONT_FACES: []str = ["", "IowanOldStyle-Roman", "Charter-Roman", "Georgia", ""];

// look SIZE SPACING MARGIN DARK RED BG INK HEADING FAINT ACCENT RULE GLOSS
// FONT THEME CHOSEN HAIRLINE SELECTION SHEET CELL COLUMN: kept; whether
// what the text is laid out by changed (its size, lines, margins, font).
look_line(line: WireLine): LookChange {
    was: Look = look;
    look = Look {
        size: word_n(line, 1) as f64 / 1000.0f64,
        spacing: word_n(line, 2) as f64 / 1000.0f64,
        margin: word_n(line, 3) as f64,
        column: word_n(line, 20) as f64 / 1000.0f64,
        dark: word_n(line, 4) == 1,
        red: word_n(line, 5) == 1,
        page: hex_or(word_hex(line, 6), was.page),
        ink: hex_or(word_hex(line, 7), was.ink),
        heading: hex_or(word_hex(line, 8), was.heading),
        faint: hex_or(word_hex(line, 9), was.faint),
        accent: hex_or(word_hex(line, 10), was.accent),
        rule: hex_or(word_hex(line, 11), was.rule),
        gloss: word_n(line, 12) as f64 / 1000.0f64,
        font: clamp_i(word_n(line, 13), 0, len(LOOK_FONT_NAMES) - 1),
        theme: word_n(line, 14),
        chosen: word_n(line, 15),
        hairline: word_n(line, 16) as f64 / 1000.0f64,
        selection: word_n(line, 17) as f64 / 1000.0f64,
        sheet: word_hex(line, 18),
        cell: word_hex(line, 19)
    };
    if (look.column <= 0.0f64) look.column = 34.0f64;
    first: bool = !look_said;
    look_said = true;
    laid: bool = first || look.size != was.size || look.spacing != was.spacing || look.margin != was.margin || look.column != was.column || look.font != was.font;
    colored: bool = first || look.page != was.page || look.ink != was.ink || look.accent != was.accent || look.dark != was.dark || look.red != was.red || look.faint != was.faint || look.heading != was.heading;
    if (laid) LookChange.Layout else if (colored) LookChange.Colors else LookChange.None
}

type LookChange =
    | None
    | Colors
    | Layout

hex_or(hex: int, otherwise: int): int {
    if (hex < 0) otherwise else hex
}

// The highlights: the color core's `mark` lines name each by, its wash
// in the text and its swatch.
HIGHLIGHTS: int = 5;

highlight_named: []int = new int[5](-1);

highlight_wash: []int = new int[5](0);

highlight_swatch: []int = new int[5](0);

// highlights SWATCH WASH STRENGTH... (five).
highlights_line(line: WireLine) {
    for i in 0..HIGHLIGHTS {
        highlight_named[i] = word_hex(line, 1 + 3 * i);
        swatch: int = word_hex(line, 1 + 3 * i);
        wash: int = word_hex(line, 2 + 3 * i);
        strength: f64 = word_n(line, 3 + 3 * i) as f64 / 1000.0f64;
        highlight_swatch[i] = held(highlight_swatch[i], if (swatch >= 0) rgb(swatch,
            1.0f64) else 0);
        highlight_wash[i] = held(highlight_wash[i], if (wash >= 0) rgb(wash, strength) else 0)
    }
}

// The highlight core names by hex (-1: none).
highlight_index(hex: int): int {
    if (hex < 0) return -1;
    for i in 0..HIGHLIGHTS
        if (highlight_named[i] == hex) return i;
    -1
}

// The themes Auto follows by day and at night, and each theme's page and
// ink (the Theme setting's swatches).
THEMES_MOST: int = 8;

theme_pages: []int = new int[8](-1);

theme_inks: []int = new int[8](-1);

auto_day: int = 1;

auto_night: int = 4;

themes_line(line: WireLine) {
    auto_day = clamp_i(word_n(line, 1), 0, THEMES_MOST - 1);
    auto_night = clamp_i(word_n(line, 2), 0, THEMES_MOST - 1);
    for t in 0..THEMES_MOST {
        theme_pages[t] = (if (has_word(line, 3 + 2 * t)) word_hex(line, 3 + 2 * t) else -1);
        theme_inks[t] = (if (has_word(line, 4 + 2 * t)) word_hex(line, 4 + 2 * t) else -1)
    }
}

// ---- the colors now (UIColors, kept) ----
type Palette = {
    page: int;
    ink: int;
    heading: int;
    faint: int;
    accent: int;
    rule: int;
    selection: int;
    flash: int;
    underline: int;
    gloss_line: int;
    // The panel's ground: the page's, a little toward the ink.
    panel: int;
    // A sheet's ground and its rows'.
    sheet: int;
    cell: int
}

colors: Palette = Palette {
    page: 0,
    ink: 0,
    heading: 0,
    faint: 0,
    accent: 0,
    rule: 0,
    selection: 0,
    flash: 0,
    underline: 0,
    gloss_line: 0,
    panel: 0,
    sheet: 0,
    cell: 0
};

colors_make() {
    colors = Palette {
        page: held(colors.page, rgb(look.page, 1.0f64)),
        ink: held(colors.ink, rgb(look.ink, 1.0f64)),
        heading: held(colors.heading, rgb(look.heading, 1.0f64)),
        faint: held(colors.faint, rgb(look.faint, 1.0f64)),
        accent: held(colors.accent, rgb(look.accent, 1.0f64)),
        rule: held(colors.rule, rgb(look.rule, look.hairline)),
        selection: held(colors.selection, rgb(look.accent, look.selection)),
        flash: held(colors.flash, rgb(look.ink, if (look.dark) 0.14f64 else 0.09f64)),
        underline: held(colors.underline, rgb(look.accent, 0.7f64)),
        gloss_line: held(colors.gloss_line, rgb(look.rule, look.gloss)),
        panel: held(colors.panel, rgb(mix_hex(look.page, look.ink, if (look.dark) 0.05f64 else 0.03f64),
            1.0f64)),
        sheet: held(colors.sheet, if (look.sheet >= 0) rgb(look.sheet, 1.0f64) else grouped_color("systemGroupedBackgroundColor")),
        cell: held(colors.cell, if (look.cell >= 0) rgb(look.cell, 1.0f64) else grouped_color("secondarySystemGroupedBackgroundColor"))
    }
}

// The system's grouped color for the look's lightness, opaque.
grouped_color(name: str): int {
    traits: int = msg1(cls("UITraitCollection"), sel("traitCollectionWithUserInterfaceStyle:"),
        if (look.dark) 2 else 1);
    resolved: int = msg1(system_color(name), sel("resolvedColorWithTraitCollection:"),
        traits);
    msg1(cls("UIColor"), sel("colorWithCGColor:"), msg(resolved, sel("CGColor")))
}

// The interface style the look is (1 light, 2 dark).
look_style(): int {
    if (look.dark) 2 else 1
}

// ---- the reader's type ----
// The body's size (em) for the system's text size now: 19 points at the
// default, times the look's size, to the half point.
page_em(): f64 {
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    scaled: f64 = msg_f_ret_f(metrics, sel("scaledValueForValue:"), 19.0f64) * look.size;
    (scaled * 2.0f64 + 0.5f64) as int as f64 / 2.0f64
}

// A pane's type: its em, the body's face, a font each style, and each
// style's attributes in each kind of paragraph (made as wanted: 0 until).
// The original's chapters (LAY_ORIG) and right to left ones (LAY_RTL) and
// those set a verse a line (LAY_LINES) have sets of their own.
LAY_ORIG: int = 1;

LAY_RTL: int = 2;

LAY_LINES: int = 4;

// Core's runs of its own (the ESV's notice): faint, the accent, small.
TYPE_SLOTS: int = 34;

TYPE_SET: int = 34 * 32;

type TypeSet = {
    em: f64;
    face: int;
    // Small capitals made by hand (smaller capitals): a face without its
    // own.
    caps_by_hand: bool;
    fonts: []int;
    verse_lines_font: int;
    hebrew: int;
    hebrew_title: int;
    attrs: []int;
    paras: []int
}

type_set_new(): TypeSet@new {
    TypeSet {
        em: 19.0f64,
        face: 0,
        caps_by_hand: false,
        fonts: new int[STYLES](0),
        verse_lines_font: 0,
        hebrew: 0,
        hebrew_title: 0,
        attrs: new int[34 * 32 * 6](0),
        paras: new int[34 * 32 * 6](0)
    }
}

// The page's and the panel's.
page_type: TypeSet = type_set_new();

panel_type: TypeSet = type_set_new();

// The panel's words beside the page are this share of the page's.
PANEL_TEXT_SCALE: f64 = 0.9f64;

type_of(p: int): *TypeSet {
    if (p == PANE_PANEL) &panel_type else &page_type
}

// Both sets made again for the look and the text size now.
types_make() {
    em: f64 = page_em();
    type_make(&page_type, em);
    type_make(&panel_type, (em * PANEL_TEXT_SCALE * 2.0f64 + 0.5f64) as int as f64 / 2.0f64)
}

type_make(t: *TypeSet, em: f64) {
    t.em = em;
    t.face = held(t.face, body_face());
    t.caps_by_hand = look.font > 0 && look.font < 4;
    for i in 0..STYLES t.fonts[i] = held(t.fonts[i], style_font(t, i));
    t.verse_lines_font = held(t.verse_lines_font, font_monospaced_digits(em * 0.62f64,
        0.3f64));
    t.hebrew = held(t.hebrew, font_system(em * 1.15f64, 0.0f64));
    t.hebrew_title = held(t.hebrew_title, font_system(em * 1.15f64 * 0.92f64, 0.0f64));
    for i in 0..len(t.attrs) {
        t.attrs[i] = held(t.attrs[i], 0);
        t.paras[i] = held(t.paras[i], 0)
    }
}

// The face chosen's descriptor (New York where it isn't on the phone).
body_face(): int {
    body: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
        objc_const("UIFontTextStyleBody"));
    serif: int = msg1(body, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
    if (look.font == 4) return body;
    if (look.font > 0) {
        named: int = msg1_f(cls("UIFont"), sel("fontWithName:size:"), nsstring(LOOK_FONT_FACES[look.font]),
            17.0f64);
        if (named != 0) return msg(named, sel("fontDescriptor"))
    }
    if (serif != 0) serif else body
}

face_font(t: *TypeSet, size: f64): int {
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), t.face, size)
}

// The face with traits (1 italic, 2 bold), or plain if it has none.
face_traits(t: *TypeSet, size: f64, traits: int): int {
    d: int = msg1(t.face, sel("fontDescriptorWithSymbolicTraits:"), traits);
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), if (d != 0) d else t.face,
        size)
}

// The face light (New York's light weight; another face as it is).
face_light(t: *TypeSet, size: f64): int {
    if (look.font != 0) return face_font(t, size);
    keys: []int = dict_keys;
    values: []int = dict_values;
    keys[0] = objc_const("UIFontWeightTrait");
    values[0] = nsnumber_f(-0.3f64);
    traits: int = nsdictionary(keys, values, 1);
    keys[0] = objc_const("UIFontDescriptorTraitsAttribute");
    values[0] = traits;
    d: int = msg1(t.face, sel("fontDescriptorByAddingAttributes:"), nsdictionary(keys,
        values, 1));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

dict_keys: []int = new int[12](0);

dict_values: []int = new int[12](0);

// A font with an OpenType feature (type, selector) on: small capitals.
with_feature(font: int, feature_type: int, feature_selector: int): int {
    keys: []int = dict_keys;
    values: []int = dict_values;
    keys[0] = objc_const("UIFontFeatureTypeIdentifierKey");
    values[0] = nsnumber_int(feature_type);
    keys[1] = objc_const("UIFontFeatureSelectorIdentifierKey");
    values[1] = nsnumber_int(feature_selector);
    setting: []int = one_object;
    setting[0] = nsdictionary(keys, values, 2);
    keys[0] = objc_const("UIFontDescriptorFeatureSettingsAttribute");
    values[0] = nsarray(setting, 1);
    d: int = msg1(msg(font, sel("fontDescriptor")), sel("fontDescriptorByAddingAttributes:"),
        nsdictionary(keys, values, 1));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, msg_f(font, sel("pointSize")))
}

one_object: []int = new int[1](0);

// The New York serif at size, whatever face is chosen (the Greek's).
new_york(size: f64): int {
    body: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
        objc_const("UIFontTextStyleBody"));
    serif: int = msg1(body, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), if (serif != 0) serif else body,
        size)
}

// Each style's font. A chapter's number stands large and light over its
// first lines; headings are the system's sans, small and firm; notes and
// labels smaller still.
style_font(t: *TypeSet, style: int): int {
    em: f64 = t.em;
    if (style == STYLE_VERSE) return font_monospaced_digits(em * 0.58f64, 0.3f64);
    if (style == STYLE_BOOK) return face_font(t, em * 2.0f64);
    if (style == STYLE_NUMERAL) return face_light(t, em * 2.8f64);
    if (style == STYLE_NUMERAL1) return face_light(t, em * 2.0f64);
    if (style == STYLE_HEAD) return font_system(em * 0.84f64, 0.4f64);
    if (style == STYLE_SUBHEAD) return font_system(em * 0.78f64, 0.23f64);
    if (style == STYLE_REF || style == STYLE_XREF) return face_traits(t, em * 0.76f64,
        1);
    if (style == STYLE_TITLE) return face_traits(t, em * 0.92f64, 1);
    if (style == STYLE_MAJOR) return font_system(em * 0.62f64, 0.3f64);
    if (style == STYLE_RANGE) return face_traits(t, em * 0.78f64, 1);
    if (style == STYLE_ACROSTIC) return font_system(em * 0.7f64, 0.3f64);
    if (style == STYLE_NOTE) return font_system(em * 0.56f64, 0.3f64);
    if (style == STYLE_BOOKLABEL) return font_system(em * 0.62f64, 0.3f64);
    if (style == STYLE_CAPS || style == STYLE_JESUS_CAPS) return if (t.caps_by_hand) face_font(t,
        em * 0.8f64) else with_feature(face_font(t, em), 38, 1);
    if (style == STYLE_PASSAGE) return font_system(em, 0.4f64);
    if (style == STYLE_SUPPLIED || style == STYLE_JESUS_SUPPLIED) return face_traits(t,
        em, 1);
    if (style == STYLE_RULE) return font_system(em * 0.5f64, 0.0f64);
    if (style == STYLE_ORIG || style == STYLE_ORIG_GL) return new_york(em);
    if (style == STYLE_OTITLE || style == STYLE_OTITLE_GL) return new_york(em * 0.92f64);
    if (style == STYLE_QERE) return font_system(em * 0.6f64, 0.0f64);
    if (style == STYLE_APPARATUS || style == STYLE_APP_ENTRY || style == STYLE_LABEL) return font_system(em * 0.78f64,
        if (style == STYLE_LABEL) 0.23f64 else 0.0f64);
    if (style == STYLE_COMMENT) return with_feature(font_system(em * 0.8f64, 0.3f64),
        37, 1);
    face_font(t, em)
}

// The font of a style's run in a chapter laid out by flags.
run_font(t: *TypeSet, flags: int, style: int): int {
    rtl: bool = (flags & LAY_RTL) != 0;
    if (rtl && (style == STYLE_ORIG || style == STYLE_ORIG_GL)) return t.hebrew;
    if (rtl && (style == STYLE_OTITLE || style == STYLE_OTITLE_GL)) return t.hebrew_title;
    if (style == STYLE_VERSE && (flags & LAY_LINES) != 0) return t.verse_lines_font;
    if (style == RUN_SMALL) return t.fonts[STYLE_NOTE];
    if (style < 0 || style >= STYLES) return t.fonts[STYLE_BODY];
    t.fonts[style]
}

is_orig_style(style: int): bool {
    style == STYLE_ORIG || style == STYLE_ORIG_GL || style == STYLE_OTITLE || style == STYLE_OTITLE_GL || style == STYLE_QERE
}

is_heading_style(style: int): bool {
    style == STYLE_XREF || style == STYLE_BOOK || style == STYLE_NUMERAL || style == STYLE_NUMERAL1 || style == STYLE_HEAD || style == STYLE_SUBHEAD || style == STYLE_REF || style == STYLE_TITLE || style == STYLE_MAJOR || style == STYLE_RANGE || style == STYLE_ACROSTIC || style == STYLE_BOOKLABEL || style == STYLE_RULE || style == STYLE_PASSAGE || style == STYLE_COMMENT
}

// The color of a style's words.
style_color(style: int): int {
    if (style == RUN_ACCENT || style == STYLE_XREF) return colors.accent;
    if (style == STYLE_BODY || style == STYLE_CAPS || style == STYLE_BOOK || style == STYLE_SUPPLIED || style == STYLE_ORIG || style == STYLE_ORIG_GL) return colors.ink;
    if (style == STYLE_JESUS || style == STYLE_JESUS_CAPS || style == STYLE_JESUS_SUPPLIED) return if (look.red) colors.accent else colors.ink;
    if (style == STYLE_HEAD || style == STYLE_SUBHEAD || style == STYLE_PASSAGE || style == STYLE_OTITLE || style == STYLE_OTITLE_GL) return colors.heading;
    if (style == STYLE_NUMERAL || style == STYLE_NUMERAL1 || style == STYLE_NOTE || style == STYLE_ACROSTIC) return colors.accent;
    colors.faint
}

// Where a style's attributes are kept in a set: its slot (core's runs of
// its own past the styles), its paragraph and its layout's set.
attrs_index(flags: int, style: int, para: int): int {
    slot: int = if (style == RUN_FAINT) STYLES else if (style == RUN_ACCENT) STYLES + 1 else if (style == RUN_SMALL) STYLES + 2 else if (style < 0 || style >= STYLES) STYLE_BODY else style;
    set: int = (if ((flags & LAY_RTL) != 0) 2 else if ((flags & LAY_ORIG) != 0) 1 else 0) + (if ((flags & LAY_LINES) != 0) 3 else 0);
    set * TYPE_SET + slot * 32 + para % 32
}

// A run's attributes (an NSDictionary, kept by the set).
run_attrs(
    t: *TypeSet,
    flags: int,
    style: int,
    para: int
): int {
    at: int = attrs_index(flags, style, para);
    if (t.attrs[at] != 0) return t.attrs[at];
    keys: []int = dict_keys;
    values: []int = dict_values;
    n: int = 0;
    keys[n] = objc_const("NSFontAttributeName");
    values[n] = run_font(t, flags, style);
    n = n + 1;
    keys[n] = objc_const("NSForegroundColorAttributeName");
    values[n] = style_color(style);
    n = n + 1;
    keys[n] = objc_const("NSParagraphStyleAttributeName");
    values[n] = para_for(t, flags, style, para);
    n = n + 1;
    if (style == STYLE_VERSE && (flags & LAY_LINES) == 0 || style == STYLE_NOTE) {
        keys[n] = objc_const("NSBaselineOffsetAttributeName");
        values[n] = nsnumber_f(t.em * (if (style == STYLE_VERSE) 0.36f64 else 0.38f64));
        n = n + 1
    }
    kern: f64 = if (style == STYLE_BOOKLABEL) 0.16f64 else if (style == STYLE_COMMENT) 0.07f64 else if (style == STYLE_MAJOR) 0.14f64 else if (style == STYLE_ACROSTIC) 0.12f64 else if ((style == STYLE_CAPS || style == STYLE_JESUS_CAPS) && t.caps_by_hand) 0.02f64 else 0.0f64;
    if (kern > 0.0f64) {
        keys[n] = objc_const("NSKernAttributeName");
        values[n] = nsnumber_f(t.em * kern);
        n = n + 1
    }
    if (is_orig_style(style) || style == STYLE_APP_ENTRY) {
        keys[n] = objc_const("UIAccessibilitySpeechAttributeLanguage");
        values[n] = nsstring(if (style == STYLE_APP_ENTRY) "en" else if ((flags & LAY_RTL) != 0) "he" else "el");
        n = n + 1
    }
    t.attrs[at] = retain(nsdictionary(keys, values, n));
    t.attrs[at]
}

// A paragraph style: alignment (0 left, 1 centered, 2 right), the first
// line's indent and the others', space before and after, lines' height.
para_style(
    align: int,
    first: f64,
    head: f64,
    before: f64,
    after: f64,
    lines: f64
): int {
    p: int = fresh("NSMutableParagraphStyle");
    msg1(p, sel("setAlignment:"), align);
    msg_set_f(p, sel("setFirstLineHeadIndent:"), first);
    msg_set_f(p, sel("setHeadIndent:"), head);
    msg_set_f(p, sel("setParagraphSpacingBefore:"), before);
    msg_set_f(p, sel("setParagraphSpacing:"), after);
    msg_set_f(p, sel("setLineHeightMultiple:"), lines);
    if (align == 0) msg_set_f32(p, sel("setHyphenationFactor:"), 0.3f64 as f32);
    p
}

// A line exactly h tall.
para_fixed(p: int, h: f64): int {
    msg_set_f(p, sel("setMinimumLineHeight:"), h);
    msg_set_f(p, sel("setMaximumLineHeight:"), h);
    p
}

extern msg_tab(
    receiver: int,
    selector: int,
    alignment: int,
    location: f64,
    options: int
): int = objc_msgSend;

tab_pair: []int = new int[2](0);

// The paragraph style of a style's runs in a paragraph of kind para.
para_for(
    t: *TypeSet,
    flags: int,
    style_in: int,
    para: int
): int {
    style: int = if (style_in == STYLE_XREF) STYLE_REF else if (style_in < 0 || style_in >= STYLES) STYLE_BODY else style_in;
    rtl_layout: bool = (flags & LAY_RTL) != 0;
    lines_layout: bool = (flags & LAY_LINES) != 0;
    apparatus: bool = style == STYLE_APPARATUS || style == STYLE_APP_ENTRY;
    rtl: bool = rtl_layout && !apparatus;
    base: int = if (is_heading_style(style) || style == STYLE_LABEL) style else if (apparatus) STYLE_APPARATUS else if (style == STYLE_OTITLE || style == STYLE_OTITLE_GL) STYLE_OTITLE else if (is_orig_style(style) || (flags & LAY_ORIG) != 0) STYLE_ORIG else STYLE_BODY;
    at: int = attrs_index(flags, base, para);
    if (t.paras[at] != 0) return t.paras[at];
    em: f64 = t.em;
    kind: int = para % KINDS;
    gap: f64 = if ((para & KINDS) != 0) em * 0.8f64 else 0.0f64;
    // (Hebrew's points need room: 1.5, whatever the spacing.)
    lh: f64 = if (rtl_layout && !is_heading_style(style) && !apparatus) 1.5f64 else look.spacing;
    p: int = 0;
    if (apparatus) {
        p = para_style(0, 0.0f64, 0.0f64, 0.0f64, em * 0.55f64, 1.15f64);
        msg_set_f32(p, sel("setHyphenationFactor:"), 0.0)
    } else if (base == STYLE_OTITLE) p = para_style(0, 0.0f64, 0.0f64, em * 0.2f64,
        em * 0.6f64, lh) else if (style == STYLE_RULE) p = para_fixed(para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 1.85f64, 1.0f64), 2.0f64) else if (style == STYLE_COMMENT) {
        // (A comment's label: well apart from the comment before, its own
        // close under it. The room above it is in its line's height: TextKit
        // drops space before at a text view's top, where a part may begin.)
        p = para_fixed(para_style(0, 0.0f64, 0.0f64, 0.0f64, em * 0.25f64, 1.0f64),
            em * 0.8f64 * 1.2f64 + em * 1.3f64)
    } else if (style == STYLE_LABEL) p = para_style(0, 0.0f64, 0.0f64, gap + em * 0.6f64,
        em * 0.55f64, lh) else if (style == STYLE_BOOK) p = para_style(1, 0.0f64,
        0.0f64, em * 1.6f64, em * 0.15f64, 1.0f64) else if (style == STYLE_BOOKLABEL) p = para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 0.05f64, 1.0f64) else if (style == STYLE_NUMERAL || style == STYLE_NUMERAL1) p = para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 0.9f64, 1.0f64) else if (style == STYLE_HEAD && kind == PARA_CENTER) p = para_style(1,
        0.0f64, 0.0f64, em * 0.25f64, em * 0.35f64, 1.15f64) else if (style == STYLE_HEAD) p = para_style(0,
        0.0f64, 0.0f64, em * 1.5f64, em * 0.35f64, 1.15f64) else if (style == STYLE_PASSAGE) p = para_style(0,
        0.0f64, 0.0f64, 0.0f64, em * 0.6f64, 1.1f64) else if (style == STYLE_SUBHEAD) p = para_style(0,
        0.0f64, 0.0f64, em * 1.1f64, em * 0.3f64, 1.15f64) else if (style == STYLE_REF) p = para_style(if (kind == PARA_CENTER) 1 else 0,
        0.0f64, 0.0f64, 0.0f64, em * 0.7f64, 1.1f64) else if (style == STYLE_TITLE) p = para_style(0,
        0.0f64, 0.0f64, em * 0.2f64, em * 0.6f64, 1.15f64) else if (style == STYLE_MAJOR) p = para_style(1,
        0.0f64, 0.0f64, em * 1.4f64, em * 0.1f64, 1.0f64) else if (style == STYLE_RANGE) p = para_style(1,
        0.0f64, 0.0f64, 0.0f64, em * 0.6f64, 1.0f64) else if (style == STYLE_ACROSTIC) p = para_style(0,
        0.0f64, 0.0f64, em * 1.2f64, em * 0.3f64, 1.0f64) else if (kind == PARA_VERSE) {
        // (The number right-aligned at 1.3 em, the words from 1.6 em.)
        p = para_style(0, 0.0f64, em * 1.6f64, gap, em * 0.3f64, lh);
        tab_pair[0] = autoreleased(msg_tab(msg(cls("NSTextTab"), sel("alloc")), sel("initWithTextAlignment:location:options:"),
            2, em * 1.3f64, msg(cls("NSDictionary"), sel("dictionary"))));
        tab_pair[1] = autoreleased(msg_tab(msg(cls("NSTextTab"), sel("alloc")), sel("initWithTextAlignment:location:options:"),
            0, em * 1.6f64, msg(cls("NSDictionary"), sel("dictionary"))));
        msg1(p, sel("setTabStops:"), nsarray(tab_pair, 2));
        msg_set_f(p, sel("setDefaultTabInterval:"), em * 1.6f64)
    } else if (lines_layout && (kind == PARA_Q1 || kind == PARA_Q2)) {
        first: f64 = em * (if (kind == PARA_Q1) 1.6f64 else 2.8f64);
        p = para_style(0, first, first + em * 1.2f64, gap, 0.0f64, lh)
    } else if (kind == PARA_Q1) p = para_style(0, 0.0f64, em * 2.4f64, gap, 0.0f64,
        lh) else if (kind == PARA_Q2) p = para_style(0, em * 1.2f64, em * 2.4f64,
        gap, 0.0f64, lh) else if (kind == PARA_L1) p = para_style(0, em, em * 2.0f64,
        gap, 0.0f64, lh) else if (kind == PARA_L2) p = para_style(0, em * 2.0f64,
        em * 3.0f64, gap, 0.0f64, lh) else if (kind == PARA_CENTER) p = para_style(1,
        0.0f64, 0.0f64, gap, em * 0.55f64, lh) else if (kind == PARA_RIGHT) p = para_style(2,
        0.0f64, 0.0f64, gap, em * 0.55f64, lh) else p = para_style(0, 0.0f64, 0.0f64,
        gap, em * 0.55f64, lh);
    // (No hyphens in the original: Koine isn't modern Greek.)
    if (base == STYLE_ORIG || base == STYLE_OTITLE) msg_set_f32(p, sel("setHyphenationFactor:"),
        0.0);
    if ((para & TIGHT) != 0 && !apparatus) msg_set_f(p, sel("setParagraphSpacing:"),
        6.0f64);
    if (rtl) {
        msg1(p, sel("setBaseWritingDirection:"), 1);
        if (kind != PARA_CENTER && kind != PARA_RIGHT && !is_heading_style(style)) msg1(p,
            sel("setAlignment:"), 4)
    }
    t.paras[at] = retain(p);
    p
}

// The text's side margins in a view w wide: the look's, or wider, so that
// the column is at most the look's width in em.
text_margin(t: *TypeSet, w: f64): f64 {
    m: f64 = look.margin;
    column: f64 = w - 2.0f64 * m;
    widest: f64 = look.column * t.em;
    if (column > widest) (w - widest) / 2.0f64 else m
}
