tag vellum;

use_tag std, ios, bible, bible_wire;

// The chrome over the page: Liquid Glass that floats near the thumb and
// gets out of the way of the words.
//
// The dock, at the foot: the chapter read (and, small under it, what the
// page reads) in a capsule in its middle, whose tap is Go To and whose long
// press is core's title menu; at its left, a pair of what is read and
// kept (the panel beside the page, the Library), at its right a pair of
// how (Listen, the reading settings). The two pairs are alike, so the
// chapter's name is in the middle of the screen, and stays there as the
// dock changes. Read on (the words moved up), it draws in: the pairs melt
// into the capsule's ends, which narrows about its middle to the chapter's
// name, and the status bar goes; moving back, a tap on
// it, a jump or a selection brings it out again. Its glass shapes are in
// one container (UIGlassContainerEffect), so they merge and part as
// liquid does.
//
// Verses selected, the capsule becomes the tray: it grows up out of the
// dock into a panel of core's tray (the reference, the highlights' colors,
// what can be done), and goes back into the capsule as they are let go.
//
// At the top, under the status bar: the way back after a jump (core's
// `back`), a capsule of glass, and the toasts core says, dropping in where
// it is.
import "../../ios/objc.l8";

import "../core/wire.l8";

import "../core/tray.l8";

import "kit.l8";

import "look.l8";

DOCK_EXPANDED: int = 0;

DOCK_COMPACT: int = 1;

DOCK_TRAY: int = 2;

type Dock = {
    mode: int;
    // The glass views' container, and its shapes: the panel's button, the
    // capsule, the right pair, the tray.
    container: int;
    left_glass: int;
    title_glass: int;
    right_glass: int;
    tray_glass: int;
    panel_button: int;
    title_button: int;
    title_label: int;
    // The chapter's name smaller, as the drawn-in capsule shows it (the
    // two cross-fade as the glass reshapes: a font can't animate).
    compact_label: int;
    version_label: int;
    library_button: int;
    listen_button: int;
    settings_button: int;
    // The tray's contents: its reference, its close, the swatches, its
    // actions (a stack of buttons).
    tray_label: int;
    tray_close: int;
    swatches: []int;
    actions: []int;
    // The panel's button lit (the panel shown).
    panel_lit: bool;
    // The page's offset where the last change of mode began, for the
    // scroll's hysteresis.
    turned_at: f64
}

dock: Dock = Dock {
    mode: 0,
    container: 0,
    left_glass: 0,
    title_glass: 0,
    right_glass: 0,
    tray_glass: 0,
    panel_button: 0,
    title_button: 0,
    title_label: 0,
    compact_label: 0,
    version_label: 0,
    library_button: 0,
    listen_button: 0,
    settings_button: 0,
    tray_label: 0,
    tray_close: 0,
    swatches: new int[6](0),
    actions: new int[8](0),
    panel_lit: false,
    turned_at: 0.0f64
};

// Its sizes.
DOCK_H: f64 = 54.0f64;

DOCK_COMPACT_H: f64 = 36.0f64;

DOCK_SIDE: f64 = 16.0f64;

DOCK_GAP: f64 = 10.0f64;

DOCK_PAIR_W: f64 = 96.0f64;

TRAY_H: f64 = 170.0f64;

// How far the words must move on (or back) before it draws in (or out).
DOCK_TRAVEL: f64 = 60.0f64;

// ---- made ----
// A plain button (autoreleased) whose touch up inside sends selector to
// the chrome's target.
chrome_button(selector: str): int {
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg3(b, sel("addTarget:action:forControlEvents:"), chrome_target, sel(selector),
        64);
    b
}

// A button's image: a symbol in the ink.
button_symbol(b: int, name: str, size: f64) {
    msg2(b, sel("setImage:forState:"), symbol(name, size, 5), 0);
    msg1(b, sel("setTintColor:"), colors.ink)
}

chrome_target: int = 0;

dock_make(parent: int) {
    container: int = glass_container(14.0f64);
    dock.container = retain(container);
    add_sub(dock_window_make(), container);
    content: int = glass_content(container);
    dock.left_glass = retain(glass_view(true));
    dock.title_glass = retain(glass_view(true));
    dock.right_glass = retain(glass_view(true));
    dock.tray_glass = retain(glass_view(false));
    add_sub(content, dock.tray_glass);
    add_sub(content, dock.left_glass);
    add_sub(content, dock.title_glass);
    add_sub(content, dock.right_glass);
    set_alpha(dock.tray_glass, 0.0f64);
    set_hidden(dock.tray_glass, true);
    dock.panel_button = retain(chrome_button("vellumPanelTapped:"));
    button_symbol(dock.panel_button, "rectangle.bottomhalf.inset.filled", 18.0f64);
    msg1(dock.panel_button, sel("setAccessibilityLabel:"), nsstring("Panel"));
    add_sub(glass_content(dock.left_glass), dock.panel_button);
    dock.title_button = retain(chrome_button("vellumTitleTapped:"));
    add_sub(glass_content(dock.title_glass), dock.title_button);
    dock.title_label = retain(label_new(font_rounded(17.0f64, 0.4f64), colors.ink,
        1));
    dock.version_label = retain(label_new(font_rounded(11.5f64, 0.0f64), colors.faint,
        1));
    msg1(dock.title_label, sel("setTextAlignment:"), 1);
    msg1(dock.title_label, sel("setAdjustsFontSizeToFitWidth:"), 1);
    msg_set_f(dock.title_label, sel("setMinimumScaleFactor:"), 0.75f64);
    msg1(dock.version_label, sel("setLineBreakMode:"), 4);
    dock.compact_label = retain(label_new(font_rounded(15.0f64, 0.4f64), colors.ink,
        1));
    msg1(dock.compact_label, sel("setTextAlignment:"), 1);
    msg1(dock.compact_label, sel("setUserInteractionEnabled:"), 0);
    add_sub(dock.title_button, dock.compact_label);
    msg1(dock.version_label, sel("setTextAlignment:"), 1);
    msg1(dock.title_label, sel("setUserInteractionEnabled:"), 0);
    msg1(dock.version_label, sel("setUserInteractionEnabled:"), 0);
    add_sub(dock.title_button, dock.title_label);
    add_sub(dock.title_button, dock.version_label);
    title_menu_attach(dock.title_button);
    dock.library_button = retain(chrome_button("vellumLibraryTapped:"));
    button_symbol(dock.library_button, "books.vertical", 18.0f64);
    msg1(dock.library_button, sel("setAccessibilityLabel:"), nsstring("Library"));
    dock.settings_button = retain(chrome_button("vellumSettingsTapped:"));
    button_symbol(dock.settings_button, "textformat.size", 18.0f64);
    msg1(dock.settings_button, sel("setAccessibilityLabel:"), nsstring("Reading Settings"));
    add_sub(glass_content(dock.left_glass), dock.library_button);
    dock.listen_button = retain(chrome_button("vellumListenTapped:"));
    button_symbol(dock.listen_button, "headphones", 18.0f64);
    msg1(dock.listen_button, sel("setAccessibilityLabel:"), nsstring("Listen"));
    add_sub(glass_content(dock.right_glass), dock.listen_button);
    add_sub(glass_content(dock.right_glass), dock.settings_button);
    tray_make();
    player_make(content);
    capsule_make(parent);
    toast_make(parent)
}

// ---- the dock's window ----
// The dock floats over everything of the app's, the panel's sheet too: in
// a window of its own above the app's (a scene's windows, UIKit's), as
// large as the dock and moved and sized with it, so that a touch beside
// the dock reaches what is under it. Kept across a hot reload.
persistent vellum_dock_window: int = 0;

// Its root (holding the dock's container in its view).
dock_root: int = 0;

// The dock's window made (once), a root new to it: the view the dock goes in.
dock_window_make(): int {
    if (vellum_dock_window == 0 && scene_obj != 0) {
        w: int = msg1(msg(cls("UIWindow"), sel("alloc")), sel("initWithWindowScene:"),
            scene_obj);
        msg_set_f(w, sel("setWindowLevel:"), 1.0f64);
        vellum_dock_window = w
    }
    if (vellum_dock_window == 0) return root_view;
    dock_root = held(dock_root, autoreleased(make("UIViewController")));
    view: int = msg(dock_root, sel("view"));
    msg1(view, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(vellum_dock_window, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("clearColor")));
    msg1(vellum_dock_window, sel("setRootViewController:"), dock_root);
    msg1(vellum_dock_window, sel("setOverrideUserInterfaceStyle:"), if (look_said) look_style() else 0);
    msg1(vellum_dock_window, sel("setHidden:"), 0);
    view
}

// The old build's dock let go of (hot reload): its window kept, emptied.
dock_window_empty() {
    if (vellum_dock_window == 0) return;
    old: int = msg(vellum_dock_window, sel("rootViewController"));
    if (old != 0) emptied(msg(old, sel("view")));
    msg1(vellum_dock_window, sel("setRootViewController:"), 0)
}

// ---- the dock under a sheet ----
// A sheet of a task (Go To, the Library, Reading, Share, a page of the
// web) has the screen: the dock's glass dissolves as it comes and forms
// again as it goes, in its transition's animation (a hand's swipe's too,
// given up or not). The panel's sheet isn't one: the dock stays over it.
dock_covered: bool = false;

// Whether a sheet of a task is shown (other than except, which is going).
dock_sheet_shown(except: int): bool {
    if (root_vc == 0) return false;
    vc: int = msg(root_vc, sel("presentedViewController"));
    steps: int = 0;
    while (vc != 0 && steps < 8) {
        if (vc != panel.nav && vc != except && !truth(msg(vc, sel("isBeingDismissed")))) return true;
        vc = msg(vc, sel("presentedViewController"));
        steps = steps + 1
    }
    false
}

dock_along_block: int = 0;

dock_along_done_block: int = 0;

// Whether the dock is being covered (or uncovered) in a transition.
dock_covering: bool = false;

// controller just presented or dismissed: the dock covered or not along
// its transition (at once, eased, without one).
dock_along(controller: int, covered: bool) {
    coordinator: int = if (controller != 0) msg(controller, sel("transitionCoordinator")) else 0;
    if (coordinator == 0) {
        dock_cover(covered);
        return
    }
    if (dock_along_block == 0) {
        dock_along_block = block1(&dock_along_animated, 0, "v16@?0@8");
        dock_along_done_block = block1(&dock_along_ended, 0, "v16@?0@8")
    }
    dock_covering = covered;
    if (!truth(msg2(coordinator, sel("animateAlongsideTransition:completion:"), dock_along_block,
        dock_along_done_block))) dock_cover(covered)
}

dock_along_animated(_context: int, _transition: int): int {
    dock_covered = dock_covering;
    dock_layout();
    0
}

// Done; or a hand's swipe given up, covered again.
dock_along_ended(_context: int, transition: int): int {
    if (transition != 0 && truth(msg(transition, sel("isCancelled")))) {
        dock_covered = !dock_covering;
        dock_layout()
    }
    dock_sheets_check();
    0
}

// The dock covered or not, its glass eased.
dock_cover(covered: bool) {
    if (dock_covered != covered) {
        dock_covered = covered;
        ease(ANIM_DOCK, 0.25f64)
    }
    dock_sheets_watch()
}

// Whether the dock should be covered now (a sheet may go of itself, as
// Share's does once shared: while covered, looked at now and then).
dock_sheets_check() {
    dock_cover(dock_sheet_shown(0))
}

dock_sheets_due: bool = false;

dock_sheets_watch() {
    if (!dock_covered || dock_sheets_due || app_obj == 0) return;
    dock_sheets_due = true;
    _t: int = timer_after(app_obj, 0.5f64, "vellumDockSheets:")
}

dock_sheets_fired(_self: int, _cmd: int, _timer: int): int {
    dock_sheets_due = false;
    dock_sheets_check();
    0
}

// A sheet's swipe away begun: the dock formed along it, if no other
// sheet of a task stays.
dock_sheet_will_go(presentation: int) {
    vc: int = msg(presentation, sel("presentedViewController"));
    if (vc == 0 || vc == panel.nav || dock_sheet_shown(vc)) return;
    dock_along(vc, false)
}

// ---- laid out ----
// The chrome's frames for the root's bounds and safe area now, for the
// dock's mode (called inside the animations of a change of mode too).
chrome_bounds: Rect = Rect {
    x: 0.0f64,
    y: 0.0f64,
    w: 0.0f64,
    h: 0.0f64
};

chrome_safe: Insets = Insets {
    top: 0.0f64,
    left: 0.0f64,
    bottom: 0.0f64,
    right: 0.0f64
};

// The dock's foot: a little into the home indicator's room, as the
// system's own floating bars sit.
dock_foot(): f64 {
    gap: f64 = if (chrome_safe.bottom > 20.0f64) chrome_safe.bottom - 10.0f64 else 12.0f64;
    foot: f64 = chrome_bounds.h - gap;
    foot
}

// Whether the dock shows: not under a sheet of a task.
dock_visible(): bool {
    !dock_covered
}

// What of the page the chrome covers at its top and foot (the expanded
// dock's, whatever its mode: the words never move as it draws in).
chrome_top_cover(): f64 {
    chrome_safe.top + 8.0f64
}

chrome_bottom_cover(): f64 {
    chrome_bounds.h - dock_foot() + DOCK_H + 8.0f64
}

dock_layout() {
    if (dock.container == 0) return;
    left: f64 = chrome_safe.left + DOCK_SIDE;
    right: f64 = chrome_bounds.w - chrome_safe.right - DOCK_SIDE;
    // (Everything about one middle: the chapter's name never moves
    // sideways.)
    middle: f64 = (left + right) / 2.0f64;
    foot: f64 = dock_foot();
    expanded_top: f64 = foot - DOCK_H;
    title_x: f64 = left + DOCK_PAIR_W + DOCK_GAP;
    title_w: f64 = right - DOCK_PAIR_W - DOCK_GAP - title_x;
    // (The player, while one listens, a pill above the rest.)
    above: f64 = if (player.shown) PLAYER_H + DOCK_GAP else 0.0f64;
    // (The container is as large as the shapes that show, so that it takes
    // no touch meant for the page around them.)
    if (dock.mode == DOCK_EXPANDED) {
        dock_container_at(left, expanded_top - above, right - left, DOCK_H + above);
        dock_place(dock.left_glass, left, expanded_top, DOCK_PAIR_W, DOCK_H, 1.0f64);
        dock_place(dock.title_glass, title_x, expanded_top, title_w, DOCK_H, 1.0f64);
        dock_place(dock.right_glass, right - DOCK_PAIR_W, expanded_top, DOCK_PAIR_W,
            DOCK_H, 1.0f64);
        tray_place_folded(title_x, expanded_top, title_w, DOCK_H);
        player_place_at(left, expanded_top, right - left, title_x, title_w, DOCK_H)
    } else if (dock.mode == DOCK_COMPACT) {
        cw: f64 = compact_width();
        cx: f64 = middle - cw / 2.0f64;
        top: f64 = foot - DOCK_COMPACT_H + 6.0f64;
        pw: f64 = if (player.shown) clamp_f(right - left, cw, 360.0f64) else cw;
        px: f64 = middle - pw / 2.0f64;
        dock_container_at(px, top - above, pw, DOCK_COMPACT_H + above);
        // (The pairs drawn into the capsule's ends, alike.)
        dock_place(dock.left_glass, cx, top, DOCK_COMPACT_H, DOCK_COMPACT_H, 0.0f64);
        dock_place(dock.title_glass, cx, top, cw, DOCK_COMPACT_H, 1.0f64);
        dock_place(dock.right_glass, cx + cw - DOCK_COMPACT_H, top, DOCK_COMPACT_H,
            DOCK_COMPACT_H, 0.0f64);
        tray_place_folded(cx, top, cw, DOCK_COMPACT_H);
        player_place_at(px, top, pw, cx, cw, DOCK_COMPACT_H)
    } else {
        tray_w: f64 = right - left + 16.0f64;
        tray_x: f64 = left - 8.0f64;
        tray_top: f64 = foot - TRAY_H;
        dock_container_at(tray_x, tray_top - above, tray_w, TRAY_H + above);
        dock_place(dock.left_glass, left, foot - DOCK_H, DOCK_PAIR_W, DOCK_H, 0.0f64);
        dock_place(dock.title_glass, title_x, foot - DOCK_H, title_w, DOCK_H, 0.0f64);
        dock_place(dock.right_glass, right - DOCK_PAIR_W, foot - DOCK_H, DOCK_PAIR_W,
            DOCK_H, 0.0f64);
        dock_place(dock.tray_glass, tray_x, tray_top, tray_w, TRAY_H, 1.0f64);
        tray_layout(tray_w);
        player_place_at(tray_x, tray_top, tray_w, title_x, title_w, DOCK_H)
    }
    title_contents_layout();
    set_alpha(dock.container, 1.0f64);
    msg1(dock.container, sel("setUserInteractionEnabled:"), if (dock_visible()) 1 else 0);
    msg1(dock.container, sel("setAccessibilityElementsHidden:"), if (dock_visible()) 0 else 1)
}

// The player above the shapes whose top is top (x, w its width there),
// or folded into the capsule (at fx, fw, fh tall) while it isn't shown.
player_place_at(
    x: f64,
    top: f64,
    w: f64,
    fx: f64,
    fw: f64,
    fh: f64
) {
    if (player.shown) player_place(x, top - PLAYER_H - DOCK_GAP, w) else player_place(fx,
        top, fw);
    _h: f64 = fh
}

// Where the container is: the shapes are placed in the root's
// coordinates, less its origin.
dock_origin_x: f64 = 0.0f64;

dock_origin_y: f64 = 0.0f64;

dock_container_at(
    x: f64,
    y: f64,
    w: f64,
    h: f64
) {
    dock_origin_x = x;
    dock_origin_y = y;
    if (vellum_dock_window != 0 && msg(dock.container, sel("window")) == vellum_dock_window) {
        set_frame4(vellum_dock_window, x, y, w, h);
        set_frame4(dock.container, 0.0f64, 0.0f64, w, h)
    } else set_frame4(dock.container, x, y, w, h)
}

// A glass shape placed (in the root's coordinates), capsule-cornered (the
// tray a rounded panel), at alpha (taking no touch, and hidden, when clear
// at the end of its animation: dock_animation_ended).
TRAY_CORNER: f64 = 30.0f64;

dock_place(
    glass: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    alpha: f64
) {
    set_frame4(glass, x - dock_origin_x, y - dock_origin_y, w, h);
    set_corners(glass, if (h > DOCK_H) TRAY_CORNER else h / 2.0f64);
    glass_shown(glass, alpha > 0.5f64 && dock_visible(), glass != dock.tray_glass,
        dock_tint());
    msg1(glass, sel("setUserInteractionEnabled:"), if (alpha > 0.5f64) 1 else 0);
    // (A pair's two buttons share it; the capsule's button fills it.)
    if (glass == dock.left_glass) dock_pair_place(dock.panel_button, dock.library_button,
        w, h) else if (glass == dock.right_glass) dock_pair_place(dock.listen_button,
        dock.settings_button, w, h) else if (glass == dock.title_glass) set_frame4(dock.title_button,
        0.0f64, 0.0f64, w, h)
}

dock_pair_place(
    first: int,
    second: int,
    w: f64,
    h: f64
) {
    set_frame4(first, 0.0f64, 0.0f64, w / 2.0f64, h);
    set_frame4(second, w / 2.0f64, 0.0f64, w / 2.0f64, h)
}

// The tray folded into the capsule (where it grows from and goes back
// to), clear.
tray_place_folded(
    x: f64,
    y: f64,
    w: f64,
    h: f64
) {
    set_frame4(dock.tray_glass, x - dock_origin_x, y - dock_origin_y, w, h);
    set_corners(dock.tray_glass, h / 2.0f64);
    glass_shown(dock.tray_glass, false, false, dock_tint());
    msg1(dock.tray_glass, sel("setUserInteractionEnabled:"), 0);
    tray_layout(w)
}

// The capsule's words: the chapter, and what is read under it (expanded),
// or the chapter alone, smaller (drawn in).
title_contents_layout() {
    frame: Rect = frame_of(dock.title_glass);
    w: f64 = frame.w;
    h: f64 = frame.h;
    compact: bool = dock.mode == DOCK_COMPACT;
    // (Each name at its own width, about the capsule's middle, which is the
    // dock's middle in every state: as the capsule grows or narrows the
    // words stay where they are, never laid out again at another width.
    // The two names go up and down together, one dissolving into the
    // other.)
    room: f64 = title_room();
    full_w: f64 = clamp_f(intrinsic_size(dock.title_label).w, 0.0f64, room);
    small_w: f64 = intrinsic_size(dock.compact_label).w;
    version_w: f64 = clamp_f(intrinsic_size(dock.version_label).w, 0.0f64, room);
    name_y: f64 = if (compact) h / 2.0f64 - 11.0f64 else h / 2.0f64 - 18.0f64;
    set_frame4(dock.title_label, (w - full_w) / 2.0f64, name_y, full_w, 22.0f64);
    set_frame4(dock.compact_label, (w - small_w) / 2.0f64, name_y + 1.0f64, small_w,
        20.0f64);
    set_frame4(dock.version_label, (w - version_w) / 2.0f64, h / 2.0f64 + (if (compact) 0.0f64 else 3.0f64),
        version_w, 15.0f64);
    set_alpha(dock.title_label, if (compact) 0.0f64 else 1.0f64);
    set_alpha(dock.version_label, if (compact) 0.0f64 else 1.0f64);
    set_alpha(dock.compact_label, if (compact) 1.0f64 else 0.0f64)
}

// The widest the names may be: the expanded capsule's width less its
// insets.
title_room(): f64 {
    left: f64 = chrome_safe.left + DOCK_SIDE;
    right: f64 = chrome_bounds.w - chrome_safe.right - DOCK_SIDE;
    right - left - 2.0f64 * (DOCK_PAIR_W + DOCK_GAP) - 28.0f64
}

// The drawn-in capsule's width: its chapter's name and room either side.
compact_width(): f64 {
    text_w: f64 = intrinsic_size(dock.compact_label).w;
    clamp_f(text_w + 40.0f64, 110.0f64, chrome_bounds.w - 80.0f64)
}

// The dock's mode changed, with a spring (the glass merging and parting).
dock_mode_set(mode: int) {
    if (dock.mode == mode) return;
    dock.mode = mode;
    if (mode == DOCK_TRAY) {
        set_hidden(dock.tray_glass, false);
        tray_contents_alpha(0.0f64)
    }
    spring(ANIM_DOCK, if (mode == DOCK_TRAY) 0.5f64 else 0.42f64, if (mode == DOCK_TRAY) 0.18f64 else 0.12f64);
    // (The tray's words come once its glass has mostly grown, and go before
    // it folds: never over the dock's.)
    if (mode == DOCK_TRAY) ease_after(ANIM_TRAY_WORDS, 0.2f64, 0.18f64) else ease(ANIM_TRAY_WORDS,
        0.1f64);
    status_bar_update()
}

// (The dock's animation: laid out in its mode; the tray's words come in
// as it opens.)
dock_animated() {
    dock_layout()
}

tray_words_animated() {
    tray_contents_alpha(if (dock.mode == DOCK_TRAY) 1.0f64 else 0.0f64)
}

dock_animation_ended() {
    if (dock.mode != DOCK_TRAY) set_hidden(dock.tray_glass, true);
    if (!player.shown && player.glass != 0) set_hidden(player.glass, true)
}

// Drawn in or out (the development wire's `!dock`; a tap).
dock_set_compact(compact: bool) {
    if (dock.mode == DOCK_TRAY) return;
    dock_mode_set(if (compact) DOCK_COMPACT else DOCK_EXPANDED)
}

// The page moved by a hand to offset y: read on far enough, the dock
// draws in; back far enough, out. (Not while the tray shows.)
dock_page_moved(y: f64, by_hand: bool) {
    if (dock.mode == DOCK_TRAY || !by_hand) {
        dock.turned_at = y;
        return
    }
    d: f64 = y - dock.turned_at;
    if (dock.mode == DOCK_EXPANDED) {
        if (d > DOCK_TRAVEL) {
            dock.turned_at = y;
            dock_mode_set(DOCK_COMPACT)
        } else if (d < 0.0f64) dock.turned_at = y
    } else {
        if (d < -DOCK_TRAVEL) {
            dock.turned_at = y;
            dock_mode_set(DOCK_EXPANDED)
        } else if (d > 0.0f64) dock.turned_at = y
    }
}

// A jump, a sheet: the dock out.
dock_expand() {
    if (dock.mode == DOCK_COMPACT) dock_mode_set(DOCK_EXPANDED);
    dock.turned_at = (if (page_pane.scroll != 0) pane_offset(&page_pane) else 0.0f64)
}

// ---- its words ----
// The chapter's name (the page's named chapter's, as its part names it;
// before that, core's title line) and what the page reads.
title_shown_c: int = -2;

title_line_words: int = 0;

version_words: int = 0;

title_update() {
    if (dock.title_label == 0) return;
    c: int = page_named();
    if (c == title_shown_c && c >= 0) return;
    name: int = if (c >= 0) chapter_name(c) else 0;
    if (name == 0) name = title_line_words;
    if (name == 0) return;
    if (title_shown_c >= -1) {
        cross_fade(dock.title_label, 0.18f64);
        cross_fade(dock.compact_label, 0.18f64)
    }
    title_shown_c = c;
    title_label_set(dock.title_label, name);
    title_label_set(dock.compact_label, name);
    msg1(dock.title_button, sel("setAccessibilityLabel:"), name);
    msg1(dock.title_button, sel("setAccessibilityHint:"), nsstring("Opens Go To"));
    if (dock.mode == DOCK_COMPACT) spring(ANIM_DOCK, 0.3f64, 0.0f64) else title_contents_layout()
}

// Chapter c's name as its first part on the page says it (0: unknown).
chapter_name(c: int): int {
    s: int = part_slot(PANE_PAGE, c, 0);
    if (s < 0) s = part_need(PANE_PAGE, c, 0);
    if (s < 0) return 0;
    name: int = 0;
    borrow parts[s] as part {
        name = part.name
    }
    name
}

// `carried HEX WORDS`: the ribbon carried ("Reading with Morning"), its
// glyph in its color before the chapter's name (`-`: none).
carried_color: int = 0;

carried_line(line: WireLine) {
    hex: int = word_hex(line, 1);
    carried_color = held(carried_color, if (hex >= 0) rgb(hex, 1.0f64) else 0);
    msg1(dock.title_button, sel("setAccessibilityValue:"), if (hex >= 0) field_ns(line,
        1) else version_words);
    title_shown_c = -2;
    title_update()
}

// The chapter's name as the capsule shows it: after the carried ribbon's
// glyph, if one is carried.
title_words_shown(name: int): int {
    if (carried_color == 0) return name;
    a: int = fresh("NSMutableAttributedString");
    glyph: int = msg2(symbol("bookmark.fill", 13.0f64, 6), sel("imageWithTintColor:renderingMode:"),
        carried_color, 1);
    attachment: int = msg1(cls("NSTextAttachment"), sel("textAttachmentWithImage:"),
        glyph);
    msg1(a, sel("appendAttributedString:"), msg1(cls("NSAttributedString"), sel("attributedStringWithAttachment:"),
        attachment));
    msg1(a, sel("appendAttributedString:"), autoreleased(msg1(msg(cls("NSAttributedString"),
        sel("alloc")), sel("initWithString:"), nsstring(" "))));
    msg1(a, sel("appendAttributedString:"), autoreleased(msg1(msg(cls("NSAttributedString"),
        sel("alloc")), sel("initWithString:"), name)));
    a
}

// ---- a document arriving: a hairline along the foot of its pane's bar
// (the page's capsule; the panel's bar), ink at 30%, as far as it has come
// ----
arrive_views: []int = new int[2](0);

arrive_shares: []f64 = new f64[2](-1.0f64);

arriving_line(p: int, thousandths: int) {
    if (p < 0 || p > 1) return;
    arrive_shares[p] = clamp_f(thousandths as f64 / 1000.0f64, 0.0f64, 1.0f64);
    arrive_place(p)
}

arrived_line(p: int) {
    if (p < 0 || p > 1) return;
    arrive_shares[p] = -1.0f64;
    if (arrive_views[p] != 0) ease(ANIM_ARRIVED, 0.2f64)
}

// The bar a pane's hairline is along.
arrive_bar(p: int): int {
    if (p == PANE_PAGE) return glass_content(dock.title_glass);
    if (panel.nav == 0) 0 else msg(panel.nav, sel("navigationBar"))
}

arrive_place(p: int) {
    if (arrive_shares[p] < 0.0f64) return;
    bar: int = arrive_bar(p);
    if (bar == 0) return;
    v: int = arrive_views[p];
    if (v == 0 || msg(v, sel("superview")) != bar) {
        if (v != 0) msg(v, sel("removeFromSuperview"));
        v = view_new();
        msg1(v, sel("setUserInteractionEnabled:"), 0);
        add_sub(bar, v);
        arrive_views[p] = held(arrive_views[p], v);
        release(v)
    }
    set_background(v, rgb(look.ink, 0.3f64));
    set_alpha(v, 1.0f64);
    box: Rect = bounds_of(bar);
    inset: f64 = if (p == PANE_PAGE) box.h / 2.0f64 else 0.0f64;
    set_frame4(v, inset, box.h - 1.0f64, (box.w - 2.0f64 * inset) * arrive_shares[p],
        1.0f64)
}

// (Its fade, and its end.)
arrived_faded() {
    for p in 0..2
        if (arrive_shares[p] < 0.0f64 && arrive_views[p] != 0) set_alpha(arrive_views[p],
            0.0f64)
}

title_label_set(label: int, name: int) {
    if (carried_color != 0) msg1(label, sel("setAttributedText:"), title_words_shown(name)) else msg1(label,
        sel("setText:"), name)
}

// `title WORDS`: core's for the place (kept for before a part names it).
title_line(words: int) {
    title_line_words = held(title_line_words, words);
    if (title_shown_c < 0) {
        title_shown_c = -2;
        title_update()
    }
}

// `version WORDS`: what the page reads, under the chapter.
version_line(words: int) {
    if (ns_equal(words, version_words)) return;
    version_words = held(version_words, words);
    if (dock.version_label != 0) {
        cross_fade(dock.version_label, 0.18f64);
        msg1(dock.version_label, sel("setText:"), words);
        title_contents_layout();
        msg1(dock.title_button, sel("setAccessibilityValue:"), words)
    }
}

// The chrome dressed in the look's colors.
chrome_dress() {
    if (dock.container == 0) return;
    for b in [dock.panel_button, dock.library_button, dock.listen_button, dock.settings_button] msg1(b,
        sel("setTintColor:"), colors.ink);
    msg1(dock.title_label, sel("setTextColor:"), colors.ink);
    msg1(dock.compact_label, sel("setTextColor:"), colors.ink);
    msg1(dock.version_label, sel("setTextColor:"), colors.faint);
    msg1(dock.tray_label, sel("setTextColor:"), colors.ink);
    msg1(dock.tray_close, sel("setTintColor:"), colors.faint);
    tint: int = dock_tint();
    for g in [dock.left_glass, dock.title_glass, dock.right_glass, dock.tray_glass,
        capsule.glass, toast.glass] glass_tint(g, tint);
    panel_button_light(dock.panel_lit);
    player_dress();
    capsule_dress();
    tray_dress()
}

// The glass's tint: the page's color, so the words over it read whatever
// passes under it.
dock_tint(): int {
    rgb(look.page, 0.62f64)
}

// The panel's button lit while the panel shows: the accent.
panel_button_light(lit: bool) {
    dock.panel_lit = lit;
    if (dock.panel_button == 0) return;
    msg1(dock.panel_button, sel("setTintColor:"), if (lit) colors.accent else colors.ink);
    msg1(dock.panel_button, sel("setAccessibilityValue:"), nsstring(if (lit) "Shown" else "Hidden"))
}

// ---- the title's menu: core's (titlemenu), made as it opens ----
title_menu_block: int = 0;

// The menu, made as it opens (0: it can't be).
title_menu_make(): int {
    if (title_menu_block == 0) title_menu_block = block1(&title_menu_provide, 0, "v16@?0@?8");
    if (title_menu_block == 0) return 0;
    deferred: int = msg1(cls("UIDeferredMenuElement"), sel("elementWithUncachedProvider:"),
        title_menu_block);
    one_item[0] = deferred;
    msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""), nsarray(one_item,
        1))
}

title_menu_attach(b: int) {
    menu: int = title_menu_make();
    if (menu == 0) return;
    msg1(b, sel("setMenu:"), menu);
    msg1(b, sel("setShowsMenuAsPrimaryAction:"), 0);
    msg1(b, sel("setContextMenuInteractionEnabled:"), 1)
}

one_item: []int = new int[1](0);

// The menu's model, for the place now (its place told first).
menu_screen: WireScreen = wire_screen();

title_menu_provide(_context: int, completion: int): int {
    page_pane.said_c = -1;
    pane_tell(PANE_PAGE, true);
    items: int = fresh("NSMutableArray");
    ask_begin();
    out_word("titlemenu");
    out_end();
    if (ask_end("screen") && wire_decode_span(&menu_screen, answer_buf, 0, answer_n)) menu_items_add(&menu_screen,
        items);
    _r: int = l8_block_invoke(completion, items, 0, 0);
    0
}

// A screen's sections as menu items: the first's rows as commands, each
// other a submenu under its header.
menu_items_add(screen: *WireScreen, items: int) {
    for s in 0..screen.sections_n {
        section: UiSection = screen.sections[s];
        kids: int = if (s == 0) items else fresh("NSMutableArray");
        for r in section.first..section.first + section.n msg1(kids, sel("addObject:"),
            menu_command(screen, screen.rows[r]));
        if (s > 0) msg1(items, sel("addObject:"), msg5(cls("UIMenu"), sel("menuWithTitle:image:identifier:options:children:"),
            screen_text(screen, section.header), 0, 0, 0, kids))
    }
}

extern msg5(
    receiver: int,
    selector: int,
    a: int,
    b: int,
    c: int,
    d: int,
    e: int
): int = objc_msgSend;

// A row as a command: its words, its symbol (in its color), where it is
// (a subtitle), off if it can't be done; its action and argument its
// property list, done by vellumMenuItem: up the responder chain.
menu_command(screen: *WireScreen, row: UiRow): int {
    image: int = if (row.icon.n > 0) symbol_image(screen_text(screen, row.icon), 17.0f64,
        4) else 0;
    if (image != 0 && row.icon_color.n > 0) image = msg2(image, sel("imageWithTintColor:renderingMode:"),
        screen_color(screen, row.icon_color), 1);
    command: int = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
        screen_text(screen, row.title), image, sel("vellumMenuItem:"), nsnumber_int(row.action * 1000000 + row.arg));
    if (row.detail.n > 0 && responds(command, "setSubtitle:")) msg1(command, sel("setSubtitle:"),
        screen_text(screen, row.detail));
    if (row.disabled) msg1(command, sel("setAttributes:"), 1);
    if (row.destructive) msg1(command, sel("setAttributes:"), 2);
    command
}

// A menu's item chosen (the title's): core's, at the place measured now.
menu_item_chosen(_self: int, _cmd: int, sender: int): int {
    if (sender == 0 || !responds(sender, "propertyList")) return 0;
    number: int = msg(sender, sel("propertyList"));
    if (number == 0) return 0;
    k: int = msg(number, sel("longValue"));
    page_pane.said_c = -1;
    pane_tell(PANE_PAGE, true);
    send2("menuact", k / 1000000, k % 1000000);
    0
}

// ---- the tray ----
tray_screen: WireScreen = wire_screen();

tray_make() {
    content: int = glass_content(dock.tray_glass);
    dock.tray_label = retain(label_new(font_rounded(15.0f64, 0.5f64), colors.ink,
        1));
    add_sub(content, dock.tray_label);
    dock.tray_close = retain(chrome_button("vellumTrayClose:"));
    button_symbol(dock.tray_close, "xmark", 14.0f64);
    msg1(dock.tray_close, sel("setAccessibilityLabel:"), nsstring("Close"));
    add_sub(content, dock.tray_close);
    for i in 0..len(dock.swatches) {
        b: int = chrome_button("vellumTraySwatch:");
        msg1(b, sel("setTag:"), i);
        set_corners(b, 15.0f64);
        layer: int = msg(b, sel("layer"));
        msg_set_f(layer, sel("setBorderWidth:"), 1.0f64);
        dock.swatches[i] = retain(b);
        add_sub(content, b)
    }
    for i in 0..len(dock.actions) {
        b: int = chrome_button("vellumTrayAction:");
        msg1(b, sel("setTag:"), i);
        dock.actions[i] = retain(b);
        add_sub(content, b)
    }
}

tray_contents_alpha(alpha: f64) {
    set_alpha(dock.tray_label, alpha);
    set_alpha(dock.tray_close, alpha);
    for b in dock.swatches set_alpha(b, alpha);
    for b in dock.actions set_alpha(b, alpha)
}

// The tray's contents laid out for its width w: the reference and close
// along its top, the swatches under them, the actions along its foot.
tray_layout(w: f64) {
    if (dock.tray_label == 0) return;
    pad: f64 = 14.0f64;
    set_frame4(dock.tray_label, pad + 4.0f64, 16.0f64, w - pad * 2.0f64 - 36.0f64,
        22.0f64);
    set_frame4(dock.tray_close, w - pad - 30.0f64, 10.0f64, 30.0f64, 30.0f64);
    shown: int = tray_swatches_shown();
    size: f64 = 30.0f64;
    gap: f64 = 14.0f64;
    x: f64 = pad + 4.0f64;
    for i in 0..len(dock.swatches) {
        b: int = dock.swatches[i];
        if (i < shown) {
            set_frame4(b, x, 50.0f64, size, size);
            x = x + size + gap
        }
        set_hidden(b, i >= shown)
    }
    n: int = tray_actions_shown();
    if (n == 0) return;
    aw: f64 = (w - pad * 2.0f64) / n as f64;
    for i in 0..len(dock.actions) {
        b: int = dock.actions[i];
        if (i < n) set_frame4(b, pad + aw * i as f64, 96.0f64, aw, 62.0f64);
        set_hidden(b, i >= n)
    }
}

tray_swatches_shown(): int {
    if (tray_screen.sections_n < 1 || tray_screen.sections[0].n < 1) return 0;
    row: UiRow = tray_screen.rows[tray_screen.sections[0].first];
    n: int = 1;
    for x in row.options.at..row.options.at + row.options.n
        if (tray_screen.pool[x] as int == 124) n = n + 1;
    if (row.options.n == 0) 0 else clamp_i(n, 0, len(dock.swatches))
}

tray_actions_shown(): int {
    if (tray_screen.sections_n < 2) 0 else clamp_i(tray_screen.sections[1].n, 0, len(dock.actions))
}

// The tray dressed as core's model says (core/tray.l8): the reference,
// each color (the chosen ringed), each action's words, symbol and state.
tray_dress() {
    if (dock.tray_label == 0 || tray_screen.sections_n < 1) return;
    msg1(dock.tray_label, sel("setText:"), screen_text(&tray_screen, tray_screen.title));
    swatch_row: UiRow = tray_screen.rows[tray_screen.sections[0].first];
    labels: int = screen_text(&tray_screen, swatch_row.detail);
    label_parts: int = if (labels != 0) msg1(labels, sel("componentsSeparatedByString:"),
        nsstring("|")) else 0;
    shown: int = tray_swatches_shown();
    for i in 0..shown {
        b: int = dock.swatches[i];
        // (The last, past the five colors: None.)
        fill: int = if (i < HIGHLIGHTS && highlight_swatch[i] != 0) highlight_swatch[i] else colors.page;
        set_background(b, fill);
        layer: int = msg(b, sel("layer"));
        chosen: bool = swatch_row.value == i;
        msg_set_f(layer, sel("setBorderWidth:"), if (chosen) 2.5f64 else 1.0f64);
        msg1(layer, sel("setBorderColor:"), msg(if (chosen) colors.ink else with_alpha(colors.ink,
            0.15f64), sel("CGColor")));
        if (i >= HIGHLIGHTS) button_symbol(b, "circle.slash", 14.0f64) else msg2(b,
            sel("setImage:forState:"), 0, 0);
        if (label_parts != 0 && i < msg(label_parts, sel("count"))) msg1(b, sel("setAccessibilityLabel:"),
            msg1(label_parts, sel("objectAtIndex:"), i))
    }
    n: int = tray_actions_shown();
    for i in 0..n {
        row: UiRow = tray_screen.rows[tray_screen.sections[1].first + i];
        b: int = dock.actions[i];
        config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
        msg1(config, sel("setImage:"), symbol_image(screen_text(&tray_screen, row.icon),
            19.0f64, 5));
        // (Seven across a phone: small titles, no insets, so every word
        // shows whole.)
        keys: []int = dict_keys;
        values: []int = dict_values;
        keys[0] = objc_const("NSFontAttributeName");
        values[0] = font_system(10.0f64, 0.23f64);
        msg1(config, sel("setAttributedTitle:"), autoreleased(msg2(msg(cls("NSAttributedString"),
            sel("alloc")), sel("initWithString:attributes:"), if (row.title.n > 0) screen_text(&tray_screen,
            row.title) else nsstring(""), nsdictionary(keys, values, 1))));
        msg_insets(config, sel("setContentInsets:"), 4.0f64, 0.0f64, 4.0f64, 0.0f64);
        msg1(config, sel("setImagePlacement:"), 1);
        msg_set_f(config, sel("setImagePadding:"), 5.0f64);
        msg1(config, sel("setBaseForegroundColor:"), if (row.tinted) colors.accent else colors.ink);
        msg1(config, sel("setTitleLineBreakMode:"), 4);
        msg1(b, sel("setConfiguration:"), config);
        msg1(b, sel("setEnabled:"), if (row.disabled) 0 else 1);
        msg1(b, sel("setAccessibilityLabel:"), screen_text(&tray_screen, if (row.label.n > 0) row.label else row.title));
        msg1(b, sel("setAccessibilityHint:"), if (row.hint.n > 0) screen_text(&tray_screen,
            row.hint) else 0)
    }
    tray_layout(frame_of(dock.tray_glass).w)
}

// `tray`: the model came (screen 0): the capsule becomes the tray.
tray_shown_now() {
    capsule_away();
    tray_dress();
    if (dock.mode != DOCK_TRAY) {
        tray_return_mode = dock.mode;
        dock_mode_set(DOCK_TRAY)
    }
}

tray_return_mode: int = 0;

// `tray_away`: back into the capsule.
tray_hide() {
    if (dock.mode == DOCK_TRAY) dock_mode_set(DOCK_EXPANDED)
}

tray_close_tapped(_self: int, _cmd: int, _sender: int): int {
    send2("trayact", ACT_TRAY_CLOSE, 0);
    0
}

tray_swatch_tapped(_self: int, _cmd: int, sender: int): int {
    haptic_impact(0);
    send2("trayact", ACT_TRAY_COLOR, msg(sender, sel("tag")));
    0
}

// The button a share's popover points from (the tray's Share).
share_from: int = 0;

tray_action_tapped(_self: int, _cmd: int, sender: int): int {
    i: int = msg(sender, sel("tag"));
    if (tray_screen.sections_n < 2 || i >= tray_screen.sections[1].n) return 0;
    share_from = sender;
    send2("trayact", tray_screen.rows[tray_screen.sections[1].first + i].action, 0);
    share_from = 0;
    0
}

// ---- the way back: a capsule at the top ----
type Capsule = {
    glass: int;
    button: int;
    words: int;
    shown: bool;
    // How long it stays (s), how many screens of reading on let it go, and
    // the page's offset it measures from.
    seconds: f64;
    screens: f64;
    from_y: f64;
    timer: int
}

capsule: Capsule = Capsule {
    glass: 0,
    button: 0,
    words: 0,
    shown: false,
    seconds: 8.0f64,
    screens: 2.0f64,
    from_y: 0.0f64,
    timer: 0
};

capsule_make(parent: int) {
    capsule.glass = retain(glass_view(true));
    add_sub(parent, capsule.glass);
    capsule.button = retain(chrome_button("vellumBackTapped:"));
    add_sub(glass_content(capsule.glass), capsule.button);
    set_alpha(capsule.glass, 0.0f64);
    set_hidden(capsule.glass, true)
}

capsule_dress() {
    if (capsule.button == 0 || capsule.words == 0) return;
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setImage:"), symbol("arrow.uturn.backward", 13.0f64, 6));
    msg1(config, sel("setTitle:"), capsule.words);
    msg_set_f(config, sel("setImagePadding:"), 7.0f64);
    msg1(config, sel("setBaseForegroundColor:"), colors.ink);
    msg1(capsule.button, sel("setConfiguration:"), config)
}

capsule_layout() {
    if (capsule.glass == 0) return;
    w: f64 = clamp_f(intrinsic_size(capsule.button).w + 8.0f64, 120.0f64, chrome_bounds.w - 60.0f64);
    h: f64 = 40.0f64;
    x: f64 = (chrome_bounds.w - w) / 2.0f64;
    y: f64 = chrome_safe.top + 2.0f64;
    set_frame4(capsule.glass, x, if (capsule.shown) y else y - 12.0f64, w, h);
    set_corners(capsule.glass, h / 2.0f64);
    set_frame4(capsule.button, 0.0f64, 0.0f64, w, h);
    set_alpha(capsule.glass, if (capsule.shown) 1.0f64 else 0.0f64)
}

// `back MS SCREENS WORDS HINT`: the capsule's words (none: away).
back_line(line: WireLine) {
    capsule.seconds = word_n(line, 1) as f64 / 1000.0f64;
    capsule.screens = word_n(line, 2) as f64;
    words: int = field_ns(line, 1);
    capsule.words = held(capsule.words, if (ns_length(words) > 0) words else 0);
    if (capsule.button != 0) msg1(capsule.button, sel("setAccessibilityHint:"), field_ns(line,
        2));
    if (capsule.words == 0) {
        capsule_away();
        return
    }
    capsule.from_y = (if (page_pane.scroll != 0) pane_offset(&page_pane) else 0.0f64);
    capsule_dress();
    if (dock.mode != DOCK_TRAY) capsule_show()
}

capsule_show() {
    if (capsule.glass == 0) return;
    set_hidden(capsule.glass, false);
    capsule_layout();
    capsule.shown = true;
    spring(ANIM_CAPSULE, 0.4f64, 0.2f64);
    capsule.timer = timer_stop(capsule.timer);
    capsule.timer = timer_after(chrome_target, if (capsule.seconds > 0.5f64) capsule.seconds else 8.0f64,
        "vellumBackTimeout:")
}

capsule_away() {
    if (!capsule.shown) return;
    capsule.shown = false;
    capsule.timer = timer_stop(capsule.timer);
    ease(ANIM_CAPSULE, 0.2f64)
}

capsule_ended() {
    if (!capsule.shown) set_hidden(capsule.glass, true)
}

// The page read on a while from where the jump left it: the way back goes.
capsule_page_moved(y: f64) {
    if (!capsule.shown) return;
    if (abs_f(y - capsule.from_y) > capsule.screens * chrome_bounds.h) capsule_away()
}

capsule_tapped(_self: int, _cmd: int, _sender: int): int {
    if (capsule.words == 0) return 0;
    send0("back");
    0
}

capsule_timed_out(_self: int, _cmd: int, _timer: int): int {
    capsule.timer = 0;
    capsule_away();
    0
}

// ---- toasts ----
type Toast = {
    glass: int;
    icon: int;
    label: int;
    shown: bool;
    timer: int
}

toast: Toast = Toast {
    glass: 0,
    icon: 0,
    label: 0,
    shown: false,
    timer: 0
};

toast_make(parent: int) {
    toast.glass = retain(glass_view(false));
    add_sub(parent, toast.glass);
    content: int = glass_content(toast.glass);
    toast.icon = retain(autoreleased(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        0)));
    toast.label = retain(label_new(font_rounded(15.0f64, 0.4f64), colors.ink, 2));
    add_sub(content, toast.icon);
    add_sub(content, toast.label);
    msg1(toast.glass, sel("setUserInteractionEnabled:"), 0);
    set_alpha(toast.glass, 0.0f64);
    set_hidden(toast.glass, true)
}

toast_layout() {
    if (toast.glass == 0) return;
    max_w: f64 = chrome_bounds.w - 64.0f64;
    msg_set_f(toast.label, sel("setPreferredMaxLayoutWidth:"), max_w - 64.0f64);
    text: Rect = intrinsic_size(toast.label);
    has_icon: bool = msg(toast.icon, sel("image")) != 0;
    w: f64 = clamp_f(text.w + (if (has_icon) 64.0f64 else 40.0f64), 140.0f64, max_w);
    h: f64 = clamp_f(text.h + 24.0f64, 44.0f64, 90.0f64);
    x: f64 = (chrome_bounds.w - w) / 2.0f64;
    y: f64 = chrome_safe.top + 2.0f64;
    set_frame4(toast.glass, x, if (toast.shown) y else y - 20.0f64, w, h);
    set_corners(toast.glass, if (h < 50.0f64) h / 2.0f64 else 22.0f64);
    left: f64 = if (has_icon) 44.0f64 else 20.0f64;
    set_frame4(toast.icon, 16.0f64, (h - 20.0f64) / 2.0f64, 20.0f64, 20.0f64);
    set_frame4(toast.label, left, 0.0f64, w - left - 20.0f64, h);
    set_alpha(toast.glass, if (toast.shown) 1.0f64 else 0.0f64)
}

// A toast: its words and symbol (0: none), for a moment.
toast_show(words: int, symbol_name: int) {
    if (toast.glass == 0 || words == 0) return;
    msg1(toast.label, sel("setText:"), words);
    msg1(toast.label, sel("setTextColor:"), colors.ink);
    image: int = if (symbol_name != 0 && ns_length(symbol_name) > 0) symbol_image(symbol_name,
        16.0f64, 6) else 0;
    msg1(toast.icon, sel("setImage:"), image);
    msg1(toast.icon, sel("setTintColor:"), colors.accent);
    capsule_away();
    if (!toast.shown) {
        set_hidden(toast.glass, false);
        toast_layout()
    }
    toast.shown = true;
    spring(ANIM_TOAST, 0.45f64, 0.25f64);
    if (voice_over()) UIAccessibilityPostNotification(objc_const("UIAccessibilityAnnouncementNotification"),
        words);
    toast.timer = timer_stop(toast.timer);
    seconds: f64 = 1.4f64 + ns_length(words) as f64 * 0.03f64;
    toast.timer = timer_after(chrome_target, clamp_f(seconds, 1.4f64, 4.0f64), "vellumToastDone:")
}

toast_timed_out(_self: int, _cmd: int, _timer: int): int {
    toast.timer = 0;
    toast.shown = false;
    ease(ANIM_TOAST, 0.25f64);
    0
}

toast_ended() {
    if (!toast.shown) set_hidden(toast.glass, true)
}

// `toast SYMBOL ICON WORDS`: core's (ICON `-`: the carried ribbon's).
toast_line(line: WireLine) {
    icon: int = word_ns_at(line, 2);
    if (icon != 0 && ns_equal(icon, nsstring("-"))) icon = nsstring("bookmark.fill");
    haptic_impact(2);
    toast_show(field_ns(line, 1), icon)
}

// Word w of the first field as an NSString (0: none).
word_ns_at(line: WireLine, w: int): int {
    at: int = field_word_at(line, w);
    e: int = word_end_at(line, at);
    if (e <= at) return 0;
    nsstring_at(bytes_address(line.data) + at, e - at)
}

add_dock_methods(target: int) {
    add_method1(target, sel("vellumPanelTapped:"), &dock_panel_tapped, "v@:@");
    add_method1(target, sel("vellumTitleTapped:"), &dock_title_tapped, "v@:@");
    add_method1(target, sel("vellumLibraryTapped:"), &dock_library_tapped, "v@:@");
    add_method1(target, sel("vellumListenTapped:"), &dock_listen_tapped, "v@:@");
    add_method1(target, sel("vellumSettingsTapped:"), &dock_settings_tapped, "v@:@");
    add_method1(target, sel("vellumTrayClose:"), &tray_close_tapped, "v@:@");
    add_method1(target, sel("vellumTraySwatch:"), &tray_swatch_tapped, "v@:@");
    add_method1(target, sel("vellumTrayAction:"), &tray_action_tapped, "v@:@");
    add_method1(target, sel("vellumBackTapped:"), &capsule_tapped, "v@:@");
    add_method1(target, sel("vellumBackTimeout:"), &capsule_timed_out, "v@:@");
    add_method1(target, sel("vellumToastDone:"), &toast_timed_out, "v@:@");
    add_method1(target, sel("vellumMenuItem:"), &menu_item_chosen, "v@:@")
}

dock_panel_tapped(_self: int, _cmd: int, _sender: int): int {
    haptic_impact(0);
    send0("tap shelf");
    0
}

// The capsule: drawn in, a tap brings the dock out; else Go To.
dock_title_tapped(_self: int, _cmd: int, _sender: int): int {
    if (dock.mode == DOCK_COMPACT) {
        dock_mode_set(DOCK_EXPANDED);
        return 0
    }
    page_pane.said_c = -1;
    pane_tell(PANE_PAGE, true);
    send0("tap goto");
    0
}

// Listen: core's own command (KC_LISTEN, as the keyboard's), started or
// paused where core says it acts.
dock_listen_tapped(_self: int, _cmd: int, _sender: int): int {
    command: KeyCommand = key_commands[KC_LISTEN];
    if (command.name == 0) return 0;
    haptic_impact(0);
    out_word("key ");
    out_ns(command.name);
    out_arg(command.mods);
    out_end();
    0
}

// Listen's button lit while one listens.
listen_button_light(lit: bool) {
    if (dock.listen_button == 0) return;
    msg1(dock.listen_button, sel("setTintColor:"), if (lit) colors.accent else colors.ink);
    msg1(dock.listen_button, sel("setAccessibilityValue:"), if (lit) nsstring("Listening") else 0)
}

dock_library_tapped(_self: int, _cmd: int, _sender: int): int {
    send0("tap library");
    0
}

dock_settings_tapped(_self: int, _cmd: int, _sender: int): int {
    send0("tap settings");
    0
}
