tag vellum;

use_tag std, ios, bible, bible_wire;

// Core's rows that are more than a list's row (SKINS.md: `custom` kinds,
// tiles, a grid's cells), and what any row may have besides its words: a
// circle at its start (a plan's day), a glyph in a column of its own, words
// at its end over a faint note, its actions as a menu at its end, a ring
// of something coming. Each custom row is built anew in its cell's content
// view as the list asks for it; its controls tell their row (and choice)
// by their tags: row * 16 + choice.
import "../../ios/objc.l8";

import "../core/share.l8";

import "kit.l8";

import "look.l8";

ROW_TAG: int = 16;

// A cell of the "custom" kind emptied for a row built in it.
custom_cell_new(list: int, path: int): int {
    cell: int = msg2(list, sel("dequeueReusableCellWithReuseIdentifier:forIndexPath:"),
        nsstring("custom"), path);
    content: int = msg(cell, sel("contentView"));
    subs: int = msg(msg(content, sel("subviews")), sel("copy"));
    for i in 0..msg(subs, sel("count")) msg(msg1(subs, sel("objectAtIndex:"), i),
        sel("removeFromSuperview"));
    release(subs);
    background: int = msg(cls("UIBackgroundConfiguration"), sel(if (ui.page || ui.plain) "listPlainCellConfiguration" else "listGroupedCellConfiguration"));
    msg1(background, sel("setBackgroundColor:"), if (ui.page) colors.page else colors.cell);
    msg1(cell, sel("setBackgroundConfiguration:"), background);
    cell
}

// Whether a row is drawn by a cell of its own here, and that cell.
row_is_custom(row: UiRow): bool {
    row.custom == CUSTOM_SIZE || row.custom == CUSTOM_THEMES || row.custom == CUSTOM_SWATCHES || row.custom == CUSTOM_CARD || row.kind == UI_TILES || row.cells_n > 0
}

custom_cell(
    s: int,
    list: int,
    path: int,
    row: UiRow,
    r: int
): int {
    cell: int = custom_cell_new(list, path);
    content: int = msg(cell, sel("contentView"));
    controller: int = slots[s].controller;
    view: int = if (row.custom == CUSTOM_SIZE) size_row(controller, row, r) else if (row.custom == CUSTOM_THEMES) themes_row(controller,
        row, r) else if (row.custom == CUSTOM_SWATCHES) swatches_row(controller, row,
        r) else if (row.custom == CUSTOM_CARD) card_row(row) else if (row.kind == UI_TILES) tiles_row(controller,
        row, r, list_text_width(list)) else cells_row(controller, row, r);
    msg1(view, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    add_sub(content, view);
    pin_edges(view, msg(content, sel("layoutMarginsGuide")));
    msg1(cell, sel("setTag:"), r);
    cell
}

// The width a row's words have in a list.
list_text_width(list: int): f64 {
    bounds_of(list).w - 2.0f64 * 20.0f64 - (if (ui.page || ui.plain) 0.0f64 else 32.0f64)
}

stack_new(axis: int, spacing: f64): int {
    stack: int = fresh("UIStackView");
    msg1(stack, sel("setAxis:"), axis);
    msg_set_f(stack, sel("setSpacing:"), spacing);
    stack
}

fixed_size(view: int, w: f64, h: f64) {
    msg1(view, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    if (w > 0.0f64) msg1(msg_set_f(msg(view, sel("widthAnchor")), sel("constraintEqualToConstant:"),
        w), sel("setActive:"), 1);
    if (h > 0.0f64) msg1(msg_set_f(msg(view, sel("heightAnchor")), sel("constraintEqualToConstant:"),
        h), sel("setActive:"), 1)
}

// A button of the list's sending selector, tagged.
row_button(controller: int, selector: str, tag: int): int {
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg1(b, sel("setTag:"), tag);
    msg3(b, sel("addTarget:action:forControlEvents:"), controller, sel(selector),
        64);
    b
}

// ---- the text's size: smaller, a slider of steps, larger; its caption ----
size_row(controller: int, row: UiRow, r: int): int {
    column: int = stack_new(1, 6.0f64);
    line: int = stack_new(0, 14.0f64);
    msg1(line, sel("setAlignment:"), 3);
    smaller: int = row_button(controller, "vellumSizeStep:", r * ROW_TAG);
    button_symbol(smaller, "textformat.size.smaller", 17.0f64);
    msg1(smaller, sel("setAccessibilityLabel:"), nsstring("Smaller Text"));
    slider: int = fresh("UISlider");
    msg_set_f32(slider, sel("setMinimumValue:"), row.lo as f32);
    msg_set_f32(slider, sel("setMaximumValue:"), row.hi as f32);
    msg_set_f32(slider, sel("setValue:"), row.value as f32);
    msg1(slider, sel("setMinimumTrackTintColor:"), colors.accent);
    msg1(slider, sel("setTag:"), r * ROW_TAG);
    msg1(slider, sel("setAccessibilityLabel:"), ui_text(row.title));
    msg3(slider, sel("addTarget:action:forControlEvents:"), controller, sel("vellumSizeSlid:"),
        64 | 128);
    larger: int = row_button(controller, "vellumSizeStep:", r * ROW_TAG + 1);
    button_symbol(larger, "textformat.size.larger", 22.0f64);
    msg1(larger, sel("setAccessibilityLabel:"), nsstring("Larger Text"));
    msg1(line, sel("addArrangedSubview:"), smaller);
    msg1(line, sel("addArrangedSubview:"), slider);
    msg1(line, sel("addArrangedSubview:"), larger);
    msg1(column, sel("addArrangedSubview:"), line);
    if (row.detail.n > 0) {
        caption: int = label_new(font_style("UIFontTextStyleFootnote"), colors.faint,
            0);
        msg1(caption, sel("setText:"), ui_text(row.detail));
        msg1(caption, sel("setTextAlignment:"), 1);
        msg1(column, sel("addArrangedSubview:"), caption)
    }
    column
}

size_stepped(self: int, _cmd: int, b: int): int {
    s: int = slot_of_controller(self);
    tag: int = msg(b, sel("tag"));
    r: int = tag / ROW_TAG;
    if (s < 0 || !screen_load(s) || r >= ui.rows_n) return 0;
    row: UiRow = ui.rows[r];
    value: int = row.value + (if (tag % ROW_TAG == 1) 1 else -1);
    if (value < row.lo || value > row.hi) return 0;
    haptic_tick();
    act(s, row.action, row.arg, value);
    0
}

text_size_slid(self: int, _cmd: int, slider: int): int {
    s: int = slot_of_controller(self);
    r: int = msg(slider, sel("tag")) / ROW_TAG;
    if (s < 0 || !screen_load(s) || r >= ui.rows_n) return 0;
    value: int = (msg_ret_f32(slider, sel("value")) as f64 + 0.5f64) as int;
    msg_set_f32(slider, sel("setValue:"), value as f32);
    if (value != ui.rows[r].value) act(s, ui.rows[r].action, ui.rows[r].arg, value);
    0
}

// ---- the themes: a swatch each, its page with its ink's Aa, the chosen
// ringed; Auto its day's and its night's corner to corner ----
themes_row(controller: int, row: UiRow, r: int): int {
    line: int = stack_new(0, 0.0f64);
    msg1(line, sel("setDistribution:"), 1);
    n: int = split_count(&ui, row.options);
    for j in 0..n {
        chosen: bool = j == row.value;
        column: int = stack_new(1, 6.0f64);
        msg1(column, sel("setAlignment:"), 3);
        theme: int = if (j == 0) auto_day else clamp_i(j, 0, THEMES_MOST - 1);
        page: int = theme_pages[theme];
        ink: int = theme_inks[theme];
        b: int = row_button(controller, "vellumPick:", r * ROW_TAG + j);
        fixed_size(b, 46.0f64, 46.0f64);
        set_background(b, if (page >= 0) rgb(page, 1.0f64) else colors.page);
        set_corners(b, 23.0f64);
        layer: int = msg(b, sel("layer"));
        msg_set_f(layer, sel("setBorderWidth:"), if (chosen) 3.0f64 else 1.0f64);
        msg1(layer, sel("setBorderColor:"), msg(if (chosen) colors.accent else colors.rule,
            sel("CGColor")));
        msg1(b, sel("setClipsToBounds:"), 1);
        if (j == 0) auto_split(layer) else {
            keys: []int = dict_keys;
            values: []int = dict_values;
            keys[0] = objc_const("NSFontAttributeName");
            values[0] = face_font(&page_type, 16.0f64);
            keys[1] = objc_const("NSForegroundColorAttributeName");
            values[1] = (if (ink >= 0) rgb(ink, 1.0f64) else colors.ink);
            msg2(b, sel("setAttributedTitle:forState:"), autoreleased(msg2(msg(cls("NSAttributedString"),
                sel("alloc")), sel("initWithString:attributes:"), nsstring("Aa"),
                nsdictionary(keys, values, 2))), 0)
        }
        name: int = split_word(&ui, row.options, j);
        msg1(b, sel("setAccessibilityLabel:"), name);
        if (chosen) msg1(b, sel("setAccessibilityTraits:"), objc_const_int("UIAccessibilityTraitSelected"));
        caption: int = label_new(font_system(11.0f64, if (chosen) 0.3f64 else 0.0f64),
            if (chosen) colors.ink else colors.faint, 1);
        msg1(caption, sel("setText:"), name);
        msg1(column, sel("addArrangedSubview:"), b);
        msg1(column, sel("addArrangedSubview:"), caption);
        msg1(line, sel("addArrangedSubview:"), column)
    }
    line
}

// A data symbol's whole number (an accessibility trait).
objc_const_int(name: str): int {
    p: int = dlsym(-2, name);
    if (p == 0) return 0;
    one: []int = trait_scratch;
    _c: int = memcpy_ints(one, p, 8);
    one[0]
}

trait_scratch: []int = new int[1](0);

// Auto's swatch: the day's page and the night's, split corner to corner.
auto_split(layer: int) {
    gradient: int = fresh("CAGradientLayer");
    four: []int = four_items;
    day: int = rgb(if (theme_pages[auto_day] >= 0) theme_pages[auto_day] else 16777215,
        1.0f64);
    night: int = rgb(if (theme_pages[auto_night] >= 0) theme_pages[auto_night] else 0,
        1.0f64);
    four[0] = msg(day, sel("CGColor"));
    four[1] = four[0];
    four[2] = msg(night, sel("CGColor"));
    four[3] = four[2];
    msg1(gradient, sel("setColors:"), nsarray(four, 4));
    four[0] = nsnumber_f(0.0f64);
    four[1] = nsnumber_f(0.5f64);
    four[2] = nsnumber_f(0.5f64);
    four[3] = nsnumber_f(1.0f64);
    msg1(gradient, sel("setLocations:"), nsarray(four, 4));
    msg_ff(gradient, sel("setStartPoint:"), 0.0f64, 0.0f64);
    msg_ff(gradient, sel("setEndPoint:"), 1.0f64, 1.0f64);
    msg_rect(gradient, sel("setFrame:"), 0.0f64, 0.0f64, 46.0f64, 46.0f64);
    msg2(layer, sel("insertSublayer:atIndex:"), gradient, 0)
}

four_items: []int = new int[4](0);

// A choice of the row's: its action with the choice.
picked(self: int, _cmd: int, b: int): int {
    s: int = slot_of_controller(self);
    tag: int = msg(b, sel("tag"));
    r: int = tag / ROW_TAG;
    if (s < 0 || !screen_load(s) || r >= ui.rows_n) return 0;
    haptic_tick();
    act(s, ui.rows[r].action, ui.rows[r].arg, tag % ROW_TAG);
    0
}

// ---- the ribbons' colors: a circle each, the chosen ringed ----
swatches_row(controller: int, row: UiRow, r: int): int {
    line: int = stack_new(0, 14.0f64);
    msg1(line, sel("setAlignment:"), 3);
    n: int = split_count(&ui, row.options);
    for j in 0..n {
        hex_words: int = split_word(&ui, row.options, j);
        b: int = row_button(controller, "vellumPick:", r * ROW_TAG + j);
        fixed_size(b, 32.0f64, 32.0f64);
        color: int = if (hex_words != 0) hex_color_ns(hex_words) else 0;
        set_background(b, if (color != 0) color else colors.faint);
        set_corners(b, 16.0f64);
        layer: int = msg(b, sel("layer"));
        chosen: bool = j == row.value;
        msg_set_f(layer, sel("setBorderWidth:"), if (chosen) 3.0f64 else 0.0f64);
        msg1(layer, sel("setBorderColor:"), msg(colors.ink, sel("CGColor")));
        msg1(b, sel("setAccessibilityLabel:"), split_word(&ui, row.detail, j));
        msg1(line, sel("addArrangedSubview:"), b)
    }
    spacer: int = fresh("UIView");
    msg1(line, sel("addArrangedSubview:"), spacer);
    line
}

// RRGGBB as a UIColor (0: not that).
hex_color_ns(words: int): int {
    n: int = nsstring_into(words, hex_scratch);
    hex: int = hex_at(hex_scratch, 0, n);
    if (hex < 0) 0 else rgb(hex, 1.0f64)
}

hex_scratch: []i8 = new i8[16](0i8);

// ---- the share card: drawn at its pixels, shown at the list's width ----
// The card last drawn (kept for Share Image).
card_image: int = 0;

// Core's measures: W H MARGIN GAP REF VERSION MOST LEAST STEP.
card_measures: []int = new int[9](0);

card_measures_read(row: UiRow): bool {
    for j in 0..len(card_measures) card_measures[j] = 0;
    j: int = 0;
    n: int = 0;
    digits: bool = false;
    for x in row.trailing.at..row.trailing.at + row.trailing.n + 1 {
        c: int = if (x < row.trailing.at + row.trailing.n) ui.pool[x] as int else 32;
        if (c >= 48 && c <= 57) {
            n = n * 10 + c - 48;
            digits = true
        } else if (digits) {
            if (j < len(card_measures)) card_measures[j] = n;
            j = j + 1;
            n = 0;
            digits = false
        }
    }
    j == len(card_measures)
}

card_color(row: UiRow, j: int): int {
    words: int = split_word(&ui, row.options, j);
    color: int = if (words != 0) hex_color_ns(words) else 0;
    if (color != 0) color else colors.ink
}

card_rtl(row: UiRow): bool {
    for x in 0..row.runs_n
        if ((ui.runs[row.runs + x * 2 + 1] - RUN_CARD & 32) != 0) return true;
    false
}

// Its words at size: each run in its face (Greek New York's, Hebrew the
// system's, larger; supplied words italic; a verse's number small, faint
// and raised; His words in the accent; a divine name in small capitals),
// lines 1.35 high (1.5 in Hebrew), an indented line 40 in.
card_text(row: UiRow, size: f64, rtl: bool): int {
    a: int = fresh("NSMutableAttributedString");
    words: int = ui_text(row.detail);
    if (words == 0) return a;
    ink: int = card_color(row, 1);
    faint: int = card_color(row, 2);
    accent: int = card_color(row, 3);
    from: int = 0;
    total: int = ns_length(words);
    for x in 0..row.runs_n + 1 {
        e: int = clamp_i(if (x < row.runs_n) ui.runs[row.runs + x * 2] else total,
            0, total);
        style: int = if (x < row.runs_n) ui.runs[row.runs + x * 2 + 1] - RUN_CARD else 0;
        if (e > from) {
            k: int = style & 7;
            s: f64 = if ((style & 64) != 0) size * 0.8f64 else size;
            font: int = if (k == 4) font_system(size * 0.6f64, 0.0f64) else if ((style & 32) != 0) font_system(size * 1.15f64,
                0.0f64) else if ((style & 16) != 0) new_york(s) else if (k == 1 || k == 3) face_traits(&page_type,
                s, 1) else face_font(&page_type, s);
            color: int = if (k == 4) faint else if (k == 2 || k == 3) accent else ink;
            indent: f64 = if ((style & 8) != 0) 40.0f64 else 0.0f64;
            para: int = para_style(if (rtl) 2 else 0, indent, indent, 0.0f64, size * 0.25f64,
                if (rtl) 1.5f64 else 1.35f64);
            if (rtl) msg1(para, sel("setBaseWritingDirection:"), 1);
            at: int = msg(a, sel("length"));
            keys: []int = dict_keys;
            values: []int = dict_values;
            keys[0] = objc_const("NSFontAttributeName");
            values[0] = font;
            keys[1] = objc_const("NSForegroundColorAttributeName");
            values[1] = color;
            keys[2] = objc_const("NSParagraphStyleAttributeName");
            values[2] = para;
            piece: int = autoreleased(msg2(msg(cls("NSAttributedString"), sel("alloc")),
                sel("initWithString:attributes:"), msg2(words, sel("substringWithRange:"),
                from, e - from), nsdictionary(keys, values, 3)));
            msg1(a, sel("appendAttributedString:"), piece);
            if (k == 4) msg4(a, sel("addAttribute:value:range:"), objc_const("NSBaselineOffsetAttributeName"),
                nsnumber_f(size * 0.3f64), at, msg(a, sel("length")) - at)
        }
        from = e
    }
    a
}

// The reference (semibold, the accent) then the version (faint).
card_reference(row: UiRow, rtl: bool): int {
    a: int = fresh("NSMutableAttributedString");
    piece_add(a, ui_text(row.title), font_system(card_measures[4] as f64, 0.3f64),
        card_color(row, 3));
    piece_add(a, nsstring(" "), font_system(card_measures[5] as f64, 0.0f64), card_color(row,
        2));
    if (row.suffix.n > 0) piece_add(a, ui_text(row.suffix), font_system(card_measures[5] as f64,
        0.0f64), card_color(row, 2));
    if (rtl) {
        para: int = fresh("NSMutableParagraphStyle");
        msg1(para, sel("setAlignment:"), 2);
        msg4(a, sel("addAttribute:value:range:"), objc_const("NSParagraphStyleAttributeName"),
            para, 0, msg(a, sel("length")))
    }
    a
}

piece_add(
    a: int,
    words: int,
    font: int,
    color: int
) {
    if (words == 0) return;
    keys: []int = dict_keys;
    values: []int = dict_values;
    keys[0] = objc_const("NSFontAttributeName");
    values[0] = font;
    keys[1] = objc_const("NSForegroundColorAttributeName");
    values[1] = color;
    msg1(a, sel("appendAttributedString:"), autoreleased(msg2(msg(cls("NSAttributedString"),
        sel("alloc")), sel("initWithString:attributes:"), words, nsdictionary(keys,
        values, 2))))
}

// The height of words set w wide (a label's, as it would lay them out).
words_height(a: int, w: f64): f64 {
    label: int = label_new(font_system(12.0f64, 0.0f64), colors.ink, 0);
    msg1(label, sel("setAttributedText:"), a);
    msg_set_f(label, sel("setPreferredMaxLayoutWidth:"), w);
    intrinsic_size(label).h
}

// The card drawn (and kept): its words at the largest size from core's
// most to least that fits above the reference.
card_draw(row: UiRow) {
    if (!card_measures_read(row)) return;
    full_w: f64 = card_measures[0] as f64;
    full_h: f64 = card_measures[1] as f64;
    margin: f64 = card_measures[2] as f64;
    gap: f64 = card_measures[3] as f64;
    most: f64 = card_measures[6] as f64;
    least: f64 = card_measures[7] as f64;
    step: f64 = card_measures[8] as f64;
    if (full_w <= 0.0f64 || full_h <= 0.0f64 || step <= 0.0f64) return;
    w: f64 = full_w - 2.0f64 * margin;
    rtl: bool = card_rtl(row);
    reference: int = card_reference(row, rtl);
    reference_h: f64 = words_height(reference, w);
    room: f64 = full_h - 2.0f64 * margin - gap - reference_h;
    size: f64 = most;
    words: int = card_text(row, size, rtl);
    words_h: f64 = words_height(words, w);
    while (size > least && words_h > room) {
        size = size - step;
        words = card_text(row, size, rtl);
        words_h = words_height(words, w)
    }
    top: f64 = (full_h - words_h - gap - reference_h) / 2.0f64;
    if (top < margin) top = margin;
    UIGraphicsBeginImageContextWithOptions(full_w, full_h, 1, 1.0f64);
    msg(card_color(row, 0), sel("setFill"));
    UIRectFill(0.0f64, 0.0f64, full_w, full_h);
    msg_rect(words, sel("drawInRect:"), margin, top, w, words_h + 2.0f64);
    msg_rect(reference, sel("drawInRect:"), margin, top + words_h + gap, w, reference_h + 2.0f64);
    image: int = UIGraphicsGetImageFromCurrentImageContext();
    UIGraphicsEndImageContext();
    card_image = held(card_image, image)
}

card_row(row: UiRow): int {
    card_draw(row);
    view: int = autoreleased(msg1(msg(cls("UIImageView"), sel("alloc")), sel("initWithImage:"),
        card_image));
    msg1(view, sel("setContentMode:"), 1);
    set_corners(view, 14.0f64);
    msg1(view, sel("setClipsToBounds:"), 1);
    msg1(view, sel("setIsAccessibilityElement:"), 1);
    msg1(view, sel("setAccessibilityLabel:"), ui_text(row.label));
    ratio: f64 = if (card_measures[0] > 0) card_measures[1] as f64 / card_measures[0] as f64 else 1.0f64;
    msg1(msg1_f(msg(view, sel("heightAnchor")), sel("constraintEqualToAnchor:multiplier:"),
        msg(view, sel("widthAnchor")), ratio), sel("setActive:"), 1);
    view
}

// `share_image`: the card last drawn, to the share sheet.
share_card() {
    if (card_image == 0) return;
    one_item[0] = card_image;
    share_items(nsarray(one_item, 1))
}

// ---- the interlinear's tiles: a word, its English, its transliteration,
// in lines as wide as the list (right to left for Hebrew; large and
// centred for an exercise's word and its choices) ----
tiles_row(
    controller: int,
    row: UiRow,
    r: int,
    width: f64
): int {
    box: int = fresh("UIView");
    rtl: bool = row.value == 1;
    large: bool = row.value == 2;
    gap: f64 = if (large) 12.0f64 else 8.0f64;
    x: f64 = 0.0f64;
    y: f64 = 0.0f64;
    line_h: f64 = 0.0f64;
    // (A line's tiles, placed as the line is done: centred, or from the
    // right.)
    line_first: int = msg(msg(box, sel("subviews")), sel("count"));
    for k in 0..row.cells_n {
        cell: UiCell = ui.cells[row.cells + k];
        tile: int = tile_view(controller, cell, r * ROW_TAG + clamp_i(k, 0, ROW_TAG - 1),
            large, cell.action != 0);
        size: Rect = Rect {
            x: 0.0f64,
            y: 0.0f64,
            w: tile_w,
            h: tile_h
        };
        if (x > 0.0f64 && x + size.w > width) {
            tiles_line_place(box, line_first, x - gap, width, y, rtl, large);
            line_first = msg(msg(box, sel("subviews")), sel("count"));
            y = y + line_h + gap;
            x = 0.0f64;
            line_h = 0.0f64
        }
        set_frame4(tile, x, y, size.w, size.h);
        add_sub(box, tile);
        x = x + size.w + gap;
        if (size.h > line_h) line_h = size.h
    }
    tiles_line_place(box, line_first, x - gap, width, y, rtl, large);
    fixed_size(box, 0.0f64, y + line_h + 4.0f64);
    box
}

// A line's tiles moved: centred (large), or from the right (Hebrew).
tiles_line_place(
    box: int,
    first: int,
    used: f64,
    width: f64,
    _y: f64,
    rtl: bool,
    large: bool
) {
    subs: int = msg(box, sel("subviews"));
    n: int = msg(subs, sel("count"));
    if (!large && !rtl || used <= 0.0f64) return;
    shift: f64 = if (large) (width - used) / 2.0f64 else 0.0f64;
    for i in first..n {
        v: int = msg1(subs, sel("objectAtIndex:"), i);
        f: Rect = frame_of(v);
        x: f64 = if (rtl && !large) width - (f.x + f.w) else f.x + shift;
        set_frame4(v, x, f.y, f.w, f.h)
    }
}

// A tile: its original (in its script), its English (hidden, faint,
// added, wrong as core says), its transliteration; a button where it does
// something.
// (A tile's size, as tile_view measures it from its words: a stack view
// has no size of its own.)
tile_w: f64 = 0.0f64;

tile_h: f64 = 0.0f64;

tile_measure(label: int) {
    size: Rect = intrinsic_size(label);
    if (size.w > tile_w) tile_w = size.w;
    tile_h = tile_h + size.h + 1.0f64
}

tile_view(
    controller: int,
    cell: UiCell,
    tag: int,
    large: bool,
    acts: bool
): int {
    tile_w = 0.0f64;
    tile_h = 0.0f64;
    column: int = stack_new(1, 1.0f64);
    msg1(column, sel("setAlignment:"), 3);
    option: bool = (cell.flags & UI_TILE_OPTION) != 0;
    added: bool = (cell.flags & UI_TILE_ADDED) != 0;
    size: f64 = if (large) 30.0f64 else 21.0f64;
    if (!added && !option && cell.text.n > 0) {
        word: int = label_new(if (cell.script == RUN_HEBREW) font_system(size * 1.1f64,
            0.0f64) else new_york(size), colors.ink, 1);
        msg1(word, sel("setText:"), ui_text(cell.text));
        tile_measure(word);
        msg1(column, sel("addArrangedSubview:"), word)
    }
    if (cell.sub.n > 0 && (cell.flags & UI_TILE_HIDE_SUB) == 0) {
        wrong: bool = (cell.flags & UI_TILE_WRONG) != 0;
        english: int = label_new(if (option) font_system(19.0f64, 0.3f64) else if (added || (cell.flags & UI_TILE_FAINT_SUB) != 0) face_traits(&page_type,
            13.0f64, 1) else font_system(13.0f64, 0.0f64), if (wrong) system_color("systemRedColor") else if (option) colors.ink else colors.faint,
            1);
        msg1(english, sel("setText:"), ui_text(cell.sub));
        tile_measure(english);
        msg1(column, sel("addArrangedSubview:"), english)
    }
    if (cell.tr.n > 0 && (cell.flags & UI_TILE_HIDE_TR) == 0 && !option) {
        translit: int = label_new(face_traits(&page_type, 12.0f64, 1), colors.faint,
            1);
        msg1(translit, sel("setText:"), ui_text(cell.tr));
        if ((cell.flags & UI_TILE_WRONG) != 0) msg1(translit, sel("setAttributedText:"),
            struck(ui_text(cell.tr)));
        tile_measure(translit);
        msg1(column, sel("addArrangedSubview:"), translit)
    }
    msg_insets(column, sel("setLayoutMargins:"), 6.0f64, 8.0f64, 6.0f64, 8.0f64);
    tile_w = tile_w + 16.0f64;
    tile_h = tile_h + 12.0f64;
    msg1(column, sel("setLayoutMarginsRelativeArrangement:"), 1);
    if ((cell.flags & UI_TILE_SELECTED) != 0 || option) {
        set_background(column, if (option) colors.cell else colors.selection);
        set_corners(column, 12.0f64);
        layer: int = msg(column, sel("layer"));
        msg_set_f(layer, sel("setBorderWidth:"), if (option) 1.0f64 else 2.0f64);
        msg1(layer, sel("setBorderColor:"), msg(if (option) colors.rule else colors.accent,
            sel("CGColor")))
    }
    msg1(column, sel("setIsAccessibilityElement:"), 1);
    if (cell.label.n > 0) msg1(column, sel("setAccessibilityLabel:"), ui_text(cell.label));
    if (!acts) return column;
    // (Its tap: a button over it.)
    b: int = row_button(controller, "vellumTile:", tag);
    msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    add_sub(column, b);
    pin_edges(b, column);
    msg1(b, sel("setAccessibilityLabel:"), if (cell.label.n > 0) ui_text(cell.label) else ui_text(cell.text));
    column
}

struck(words: int): int {
    keys: []int = dict_keys;
    values: []int = dict_values;
    keys[0] = objc_const("NSStrikethroughStyleAttributeName");
    values[0] = nsnumber_int(1);
    autoreleased(msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        words, nsdictionary(keys, values, 1)))
}

// A tile's (or a grid's cell's) tap: its own action.
tile_tapped(self: int, _cmd: int, b: int): int {
    s: int = slot_of_controller(self);
    tag: int = msg(b, sel("tag"));
    r: int = tag / ROW_TAG;
    k: int = tag % ROW_TAG;
    if (s < 0 || !screen_load(s) || r >= ui.rows_n || k >= ui.rows[r].cells_n) return 0;
    cell: UiCell = ui.cells[ui.rows[r].cells + k];
    haptic_tick();
    act(s, cell.action, cell.arg, 0);
    0
}

// ---- a grid's cells (a lemma's forms): its label, then each cell ----
cells_row(controller: int, row: UiRow, r: int): int {
    line: int = stack_new(0, 8.0f64);
    msg1(line, sel("setDistribution:"), 1);
    msg1(line, sel("setAlignment:"), 3);
    if (row.title.n > 0) {
        label: int = label_new(font_style("UIFontTextStyleFootnote"), colors.faint,
            2);
        msg1(label, sel("setText:"), ui_text(row.title));
        msg1(line, sel("addArrangedSubview:"), label)
    }
    for k in 0..row.cells_n {
        cell: UiCell = ui.cells[row.cells + k];
        column: int = stack_new(1, 1.0f64);
        msg1(column, sel("setAlignment:"), 3);
        words: int = label_new(if (cell.script == RUN_HEBREW) font_system(19.0f64,
            0.0f64) else if (cell.script != 0) new_york(18.0f64) else font_system(15.0f64,
            0.0f64), if (cell.script == 0) colors.faint else colors.ink, 1);
        msg1(words, sel("setText:"), if (cell.script == 0 && cell.text.n == 0) nsstring("\â\€\”") else ui_text(cell.text));
        msg1(column, sel("addArrangedSubview:"), words);
        if (cell.sub.n > 0 || cell.count.n > 0) {
            sub: int = label_new(font_system(11.0f64, 0.0f64), colors.faint, 1);
            msg1(sub, sel("setText:"), ui_text(if (cell.sub.n > 0) cell.sub else cell.count));
            msg1(column, sel("addArrangedSubview:"), sub)
        }
        if (cell.label.n > 0) {
            msg1(column, sel("setIsAccessibilityElement:"), 1);
            msg1(column, sel("setAccessibilityLabel:"), ui_text(cell.label))
        }
        if (cell.action != 0) {
            b: int = row_button(controller, "vellumTile:", r * ROW_TAG + clamp_i(k,
                0, ROW_TAG - 1));
            msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
            add_sub(column, b);
            pin_edges(b, column)
        }
        msg1(line, sel("addArrangedSubview:"), column)
    }
    line
}

// ---- what any row may have besides its words ----
// A plan's day's circle (1 empty, 2 half, 3 full), its own tap.
circle_accessory(controller: int, row: UiRow, r: int): int {
    name: str = if (row.circle == 3) "checkmark.circle.fill" else if (row.circle == 2) "circle.lefthalf.filled" else "circle";
    b: int = row_button(controller, "vellumCircle:", r * ROW_TAG);
    msg2(b, sel("setImage:forState:"), symbol(name, 22.0f64, 4), 0);
    msg1(b, sel("setTintColor:"), if (row.circle == 1) colors.faint else colors.accent);
    msg1(b, sel("setEnabled:"), if (row.circle_off || row.circle_action == 0) 0 else 1);
    if (row.circle_off) set_alpha(b, 0.4f64);
    msg1(b, sel("setAccessibilityLabel:"), nsstring(if (row.circle == 3) "Read" else if (row.circle == 2) "Partly Read" else "Not Read"));
    fixed_size(b, 30.0f64, 30.0f64);
    autoreleased(msg2(msg(cls("UICellAccessoryCustomView"), sel("alloc")), sel("initWithCustomView:placement:"),
        b, 0))
}

circle_tapped(self: int, _cmd: int, b: int): int {
    s: int = slot_of_controller(self);
    r: int = msg(b, sel("tag")) / ROW_TAG;
    if (s < 0 || !screen_load(s) || r >= ui.rows_n) return 0;
    haptic_impact(0);
    act(s, ui.rows[r].circle_action, ui.rows[r].arg, 0);
    0
}

// A glyph in a column of its own at the row's start (a letter of the
// Alphabet), in its script.
lead_accessory(row: UiRow): int {
    label: int = label_new(if (row.lead_style == RUN_HEBREW) font_system(28.0f64,
        0.0f64) else new_york(26.0f64), colors.ink, 1);
    msg1(label, sel("setText:"), ui_text(row.lead));
    msg1(label, sel("setTextAlignment:"), 1);
    fixed_size(label, 40.0f64, 0.0f64);
    autoreleased(msg2(msg(cls("UICellAccessoryCustomView"), sel("alloc")), sel("initWithCustomView:placement:"),
        label, 0))
}

// Words at the row's end (by their runs) over a small faint note.
side_accessory(row: UiRow): int {
    column: int = stack_new(1, 1.0f64);
    msg1(column, sel("setAlignment:"), 4);
    words: int = label_new(font_style("UIFontTextStyleBody"), colors.ink, 1);
    msg1(words, sel("setAttributedText:"), rich_text(&ui, row.side, row.sruns, row.sruns_n,
        font_style("UIFontTextStyleBody"), colors.ink));
    msg1(column, sel("addArrangedSubview:"), words);
    if (row.side_note.n > 0) {
        note: int = label_new(font_style("UIFontTextStyleCaption1"), colors.faint,
            1);
        msg1(note, sel("setText:"), ui_text(row.side_note));
        msg1(column, sel("addArrangedSubview:"), note)
    }
    accessory_view(column)
}

// Its actions as a menu at its end (`u`).
menu_accessory(row: UiRow): int {
    kids: int = fresh("NSMutableArray");
    for k in 0..row.actions_n {
        a: UiAction = ui.actions[row.actions + k];
        c: int = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
            ui_text(a.title), if (a.icon.n > 0) symbol_image(ui_text(a.icon), 17.0f64,
            4) else 0, sel("vellumCommand:"), nsnumber_int(a.action * 1000000 + row.arg));
        if (a.action == row.delete_action) msg1(c, sel("setAttributes:"), 2);
        msg1(kids, sel("addObject:"), c)
    }
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg2(b, sel("setImage:forState:"), symbol("ellipsis.circle", 20.0f64, 4), 0);
    msg1(b, sel("setTintColor:"), colors.accent);
    msg1(b, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring(""),
        kids));
    msg1(b, sel("setShowsMenuAsPrimaryAction:"), 1);
    msg1(b, sel("setAccessibilityLabel:"), nsstring("Actions"));
    fixed_size(b, 32.0f64, 32.0f64);
    accessory_view(b)
}

// Something coming: a ring of how much (thousandths) has come.
extern msg_arc(
    receiver: int,
    selector: int,
    x: f64,
    y: f64,
    radius: f64,
    from: f64,
    to: f64,
    clockwise: int
): int = objc_msgSend;

progress_ring(thousandths: int): int {
    size: f64 = 22.0f64;
    UIGraphicsBeginImageContextWithOptions(size, size, 0, 0.0f64);
    track: int = msg_rect(cls("UIBezierPath"), sel("bezierPathWithOvalInRect:"), 2.0f64,
        2.0f64, size - 4.0f64, size - 4.0f64);
    msg_set_f(track, sel("setLineWidth:"), 2.5f64);
    msg(colors.rule, sel("setStroke"));
    msg(track, sel("stroke"));
    share: f64 = clamp_i(thousandths, 0, 1000) as f64 / 1000.0f64;
    if (share > 0.0f64) {
        start: f64 = -1.5707963f64;
        arc: int = msg_arc(cls("UIBezierPath"), sel("bezierPathWithArcCenter:radius:startAngle:endAngle:clockwise:"),
            size / 2.0f64, size / 2.0f64, size / 2.0f64 - 2.0f64, start, start + share * 6.2831853f64,
            1);
        msg_set_f(arc, sel("setLineWidth:"), 2.5f64);
        msg1(arc, sel("setLineCapStyle:"), 1);
        msg(colors.accent, sel("setStroke"));
        msg(arc, sel("stroke"))
    }
    image: int = UIGraphicsGetImageFromCurrentImageContext();
    UIGraphicsEndImageContext();
    image
}

// ---- typed letters (Practice's `keys`): the list takes the keyboard ----
// Whether slot s's screen takes typed letters now.
slot_keys(s: int): int {
    if (s < 0 || !screen_load(s)) 0 else ui.keys
}

list_can_become_first(self: int, _cmd: int): int {
    if (slot_keys(slot_of_controller(self)) != 0) 1 else 0
}

list_has_text(_self: int, _cmd: int): int {
    1
}

// Each letter typed: the screen's keys action with it.
list_insert_text(self: int, _cmd: int, text: int): int {
    s: int = slot_of_controller(self);
    keys: int = slot_keys(s);
    if (keys == 0 || text == 0) return 0;
    n: int = ns_length(text);
    for i in 0..n {
        cp: int = msg1(text, sel("characterAtIndex:"), i);
        if (cp > 32) act(s, keys, cp, 0)
    }
    0
}

list_delete_backward(_self: int, _cmd: int): int {
    0
}

// Letters as typed: no capitals, no corrections.
list_no_correction(_self: int, _cmd: int): int {
    1
}

list_no_capitals(_self: int, _cmd: int): int {
    0
}

// The keyboard up while the screen takes letters, down when it doesn't.
list_keys_check(s: int) {
    controller: int = slots[s].controller;
    if (controller == 0 || msg(controller, sel("view")) == 0 || msg(msg(controller,
        sel("view")), sel("window")) == 0) return;
    wants: bool = ui_slot == s && ui.keys != 0;
    first: bool = truth(msg(controller, sel("isFirstResponder")));
    if (wants && !first) msg(controller, sel("becomeFirstResponder")) else if (!wants && first) msg(controller,
        sel("resignFirstResponder"))
}

add_rows_methods(list: int) {
    add_method1(list, sel("vellumSizeStep:"), &size_stepped, "v@:@");
    add_method1(list, sel("vellumSizeSlid:"), &text_size_slid, "v@:@");
    add_method1(list, sel("vellumPick:"), &picked, "v@:@");
    add_method1(list, sel("vellumTile:"), &tile_tapped, "v@:@");
    add_method1(list, sel("vellumCircle:"), &circle_tapped, "v@:@");
    add_method0(list, sel("canBecomeFirstResponder"), &list_can_become_first, "B@:");
    add_method0(list, sel("hasText"), &list_has_text, "B@:");
    add_method1(list, sel("insertText:"), &list_insert_text, "v@:@");
    add_method0(list, sel("deleteBackward"), &list_delete_backward, "v@:");
    add_method0(list, sel("autocorrectionType"), &list_no_correction, "q@:");
    add_method0(list, sel("autocapitalizationType"), &list_no_capitals, "q@:");
    add_method0(list, sel("spellCheckingType"), &list_no_correction, "q@:");
    add_protocol(list, "UIKeyInput")
}
