tag vellum;

use_tag std, ios, bible, bible_wire;

// The app driven from the development machine (RELOAD.md), where the hot
// reload host has a server set (the Settings app's hot_server, or
// dev-server.txt in the bundle): data files the server has that differ
// from the bundle's are read from it, and lines for core come from it
// (`node web/devctl.mjs wire tap goto`), long-polling GET /wire?since=N.
// A line beginning ! is the skin's own (devwire_own). A build from the App
// Store has no server and asks nothing.
import "../../ios/objc.l8";

import "kit.l8";

// The server's address (http://HOST:PORT), the cursor of its lines, the
// request under way and its body.
dw_url: int = 0;

dw_since: int = 0;

dw_task: int = 0;

dw_body: int = 0;

// (One session through hot reloads.)
persistent vellum_dw_session: int = 0;

dw_on: bool = false;

dw_server(): int {
    defaults: int = msg(cls("NSUserDefaults"), sel("standardUserDefaults"));
    ns: int = msg1(defaults, sel("stringForKey:"), nsstring("hot_server"));
    if (ns == 0 || msg(ns, sel("length")) == 0) {
        path: int = msg2(msg(cls("NSBundle"), sel("mainBundle")), sel("pathForResource:ofType:"),
            nsstring("dev-server"), nsstring("txt"));
        if (path != 0) ns = msg3(cls("NSString"), sel("stringWithContentsOfFile:encoding:error:"),
            path, 4, 0)
    }
    if (ns == 0) return 0;
    ns = msg1(ns, sel("stringByTrimmingCharactersInSet:"), msg(cls("NSCharacterSet"),
        sel("whitespaceAndNewlineCharacterSet")));
    if (msg(ns, sel("length")) == 0) return 0;
    retain(msg1(nsstring("http://"), sel("stringByAppendingString:"), ns))
}

devwire_begin() {
    if (dw_url == 0) dw_url = dw_server();
    if (dw_url == 0) {
        dw_data_state = DW_DATA_READY;
        return
    }
    if (vellum_dw_session == 0) {
        config: int = msg(cls("NSURLSessionConfiguration"), sel("ephemeralSessionConfiguration"));
        msg_set_f(config, sel("setTimeoutIntervalForRequest:"), 40.0f64);
        vellum_dw_session = retain(msg3(cls("NSURLSession"), sel("sessionWithConfiguration:delegate:delegateQueue:"),
            config, fresh("VellumNet"), msg(cls("NSOperationQueue"), sel("mainQueue"))))
    }
    devwire_data_list();
    devwire_ask()
}

// ---- data files from the server ----
DW_DATA_MOST: int = 32;

DW_NAME_MOST: int = 64;

dw_data_names: []i8 = new i8[32 * 64](0i8);

dw_data_name_n: []int = new int[32](0);

dw_data_paths: []int = new int[32](0);

dw_data_n: int = 0;

DW_DATA_LISTING: int = 0;

DW_DATA_FETCHING: int = 1;

DW_DATA_READY: int = 2;

dw_data_state: int = 0;

dw_data_at: int = 0;

dw_data_task: int = 0;

dw_data_body: int = 0;

devwire_data_ready(): bool {
    dw_data_state == DW_DATA_READY
}

devwire_data_get(path: int, body: int) {
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), msg1(dw_url, sel("stringByAppendingString:"),
        path));
    request: int = if (url == 0) 0 else msg1(cls("NSMutableURLRequest"), sel("requestWithURL:"),
        url);
    if (request != 0) _t: int = msg_set_f(request, sel("setTimeoutInterval:"), 3.0f64);
    if (request != 0 && body != 0) {
        msg1(request, sel("setHTTPMethod:"), nsstring("POST"));
        msg1(request, sel("setHTTPBody:"), body)
    }
    task: int = if (request == 0) 0 else msg1(vellum_dw_session, sel("dataTaskWithRequest:"),
        request);
    if (task == 0) {
        devwire_data_done();
        return
    }
    dw_data_task = retain(task);
    dw_data_body = make("NSMutableData");
    msg(task, sel("resume"))
}

devwire_data_list() {
    dw_data_state = DW_DATA_LISTING;
    dw_data_n = 0;
    path: int = msg2(msg(cls("NSBundle"), sel("mainBundle")), sel("pathForResource:ofType:"),
        nsstring("dev-data"), nsstring("txt"));
    bundled: int = if (path == 0) 0 else msg1(cls("NSData"), sel("dataWithContentsOfFile:"),
        path);
    devwire_data_get(nsstring("/data"), bundled)
}

devwire_data_listed(body: int) {
    n: int = msg(body, sel("length"));
    region {
        b: []i8 = new i8[n + 1](0i8);
        if (n > 0) memcpy_from(b, msg(body, sel("bytes")), n);
        at: int = 0;
        while (at < n) {
            e: int = at;
            while (e < n && b[e] as int != 10) e = e + 1;
            tab: int = at;
            while (tab < e && b[tab] as int != 9) tab = tab + 1;
            if (tab > at && tab - at <= DW_NAME_MOST && dw_data_n < DW_DATA_MOST) {
                for i in at..tab dw_data_names[dw_data_n * DW_NAME_MOST + i - at] = b[i];
                dw_data_name_n[dw_data_n] = tab - at;
                dw_data_paths[dw_data_n] = 0;
                dw_data_n = dw_data_n + 1
            }
            at = e + 1
        }
    }
    dw_data_state = DW_DATA_FETCHING;
    dw_data_at = 0;
    devwire_data_next()
}

devwire_data_next() {
    if (dw_data_at >= dw_data_n) {
        devwire_data_done();
        return
    }
    words_begin();
    words_add("/data/");
    k: int = dw_data_at;
    for i in 0..dw_data_name_n[k] {
        words_buf[words_n] = dw_data_names[k * DW_NAME_MOST + i];
        words_n = words_n + 1
    }
    devwire_data_get(words_ns(), 0)
}

devwire_data_fetched(body: int) {
    k: int = dw_data_at;
    dir: int = msg(msg(msg(cls("NSFileManager"), sel("defaultManager")), sel("temporaryDirectory")),
        sel("path"));
    words_begin();
    words_add("vellum-data-");
    words_add_int(k);
    path: int = msg1(dir, sel("stringByAppendingPathComponent:"), words_ns());
    if (truth(msg2(body, sel("writeToFile:atomically:"), path, 1))) dw_data_paths[k] = retain(path);
    dw_data_at = k + 1;
    devwire_data_next()
}

devwire_data_done() {
    dw_data_state = DW_DATA_READY;
    asks_soon()
}

// The file the server gave for ask id in place of the bundle's (0: none).
devwire_data_path(id: int): int {
    if (dw_data_state != DW_DATA_READY) return 0;
    for k in 0..dw_data_n {
        if (dw_data_paths[k] != 0 && dw_data_name_n[k] == ask_name_n[id]) {
            same: bool = true;
            for i in 0..ask_name_n[id]
                if (dw_data_names[k * DW_NAME_MOST + i] != ask_names[id * ASK_NAME_MOST + i]) same = false;
            if (same) return dw_data_paths[k]
        }
    }
    0
}

// ---- lines from the server ----
devwire_ask() {
    if (dw_task != 0 || dw_url == 0) return;
    words_begin();
    words_add("/wire?since=");
    words_add_int(dw_since);
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), msg1(dw_url, sel("stringByAppendingString:"),
        words_ns()));
    if (url == 0) return;
    task: int = msg1(vellum_dw_session, sel("dataTaskWithURL:"), url);
    if (task == 0) return;
    dw_task = retain(task);
    dw_body = make("NSMutableData");
    msg(task, sel("resume"))
}

devwire_received(task: int, data: int): bool {
    if (task != 0 && task == dw_data_task) {
        msg1(dw_data_body, sel("appendData:"), data);
        return true
    }
    if (task == 0 || task != dw_task) return false;
    msg1(dw_body, sel("appendData:"), data);
    true
}

devwire_completed(task: int, error: int): bool {
    if (task != 0 && task == dw_data_task) {
        body: int = dw_data_body;
        dw_data_task = 0;
        dw_data_body = 0;
        ok: bool = error == 0 && msg(msg(task, sel("response")), sel("statusCode")) == 200;
        if (dw_data_state == DW_DATA_LISTING) {
            if (ok) devwire_data_listed(body) else devwire_data_done()
        } else if (ok) devwire_data_fetched(body) else {
            dw_data_at = dw_data_at + 1;
            devwire_data_next()
        }
        release(body);
        release(task);
        return true
    }
    if (task == 0 || task != dw_task) return false;
    body: int = dw_body;
    dw_task = 0;
    dw_body = 0;
    if (error == 0) devwire_lines(body);
    release(body);
    release(task);
    if (error == 0) devwire_ask() else _t: int = timer_after(app_obj, 1.0f64, "vellumWireAgain:");
    true
}

devwire_poll_again(_self: int, _cmd: int, _timer: int): int {
    devwire_ask();
    0
}

devwire_lines(body: int) {
    n: int = msg(body, sel("length"));
    if (n <= 0) return;
    region {
        b: []i8 = new i8[n](0i8);
        memcpy_from(b, msg(body, sel("bytes")), n);
        if (!dw_on) {
            dw_on = true;
            diag_on = true;
            note("vellum: driven from the development server")
        }
        at: int = 0;
        while (at < n) {
            e: int = at;
            while (e < n && b[e] as int != 10) e = e + 1;
            tab: int = at;
            while (tab < e && b[tab] as int != 9) tab = tab + 1;
            id: int = 0;
            for i in at..tab id = id * 10 + (b[i] as int - 48);
            if (id > dw_since) dw_since = id;
            if (tab + 1 < e) devwire_line(b, tab + 1, e);
            at = e + 1
        }
    }
}

// One line: the skin's own (beginning !), else core's.
devwire_line(b: []i8, from: int, to: int) {
    if (to > from && b[from] as int == 33) {
        devwire_own(b, from + 1, to);
        return
    }
    out_text(b, from, to);
    out_end()
}

// Whether b[from..to] begins with word (then a space or its end), and
// the number after it.
dw_is(
    b: []i8,
    from: int,
    to: int,
    word: str
): bool {
    if (to - from < len(word)) return false;
    for i in 0..len(word)
        if (b[from + i] != word[i]) return false;
    to - from == len(word) || b[from + len(word)] as int == 32
}

dw_number(b: []i8, from: int, to: int): int {
    wire_integer(b, from, to)
}

// The skin's own lines: `!state` writes what it shows to the log; `!scroll
// P DY` scrolls a pane as a hand would (its delegate told), `!flick P DY`
// as a finger's fling does (frame by frame, slowing), `!dock open` or
// `close`, `!close` the sheets, `!back` a screen back in the top sheet,
// `!tap WORDS` taps the first row of the top sheet whose title begins with
// WORDS, `!swipe` puts the panel away as a hand's swipe does, `!record on|off` records the screen (ReplayKit; the movie posted
// to the server's /video).
devwire_own(b: []i8, from: int, to: int) {
    if (dw_is(b, from, to, "state")) devwire_state() else if (dw_is(b, from, to, "scroll")) {
        p: int = dw_number(b, from + 7, to);
        at: int = from + 7;
        while (at < to && b[at] as int != 32) at = at + 1;
        devwire_scroll(p, dw_number(b, at + 1, to))
    } else if (dw_is(b, from, to, "flick")) {
        p: int = dw_number(b, from + 6, to);
        at: int = from + 6;
        while (at < to && b[at] as int != 32) at = at + 1;
        flick_begin(p, dw_number(b, at + 1, to))
    } else if (dw_is(b, from, to, "record")) {
        if (dw_is(b, from + 7, to, "on")) record_on() else record_off()
    } else if (dw_is(b, from, to, "dock")) dock_set_compact(dw_is(b, from + 5, to,
        "close")) else if (dw_is(b, from, to, "close")) sheets_close_all() else if (dw_is(b,
        from, to, "back")) sheets_back() else if (dw_is(b, from, to, "tap")) sheets_tap_titled(b,
        from + 4, to) else if (dw_is(b, from, to, "swipe")) devwire_swipe() else if (dw_is(b,
        from, to, "sheetviews")) devwire_sheet_views() else if (dw_is(b, from, to,
        "probe")) probe_begin(dw_number(b, from + 6, to)) else note("vellum: (an unknown ! line)")
}

// The panel's sheet put away as a hand's swipe puts it: dismissed, its
// presentation's delegate told once it has gone.
devwire_swipe() {
    nav: int = panel_nav();
    if (nav == 0 || msg(nav, sel("presentingViewController")) == 0) return;
    presentation: int = msg(nav, sel("presentationController"));
    msg2(msg(nav, sel("presentingViewController")), sel("dismissViewControllerAnimated:completion:"),
        1, block0(&devwire_swiped, retain(presentation), "v8@?0"))
}

devwire_swiped(presentation: int): int {
    _r: int = sheets_swiped(0, 0, presentation);
    release(presentation);
    0
}

// A pane scrolled by dy as a hand would move it: begun, moved, at rest.
devwire_scroll(p: int, dy: int) {
    pane: *Pane = pane_of(p);
    if (pane.scroll == 0) return;
    pane_hand_began(p);
    hand_on_pane(p);
    set_offset_y(pane.scroll, pane_offset(pane) + dy as f64);
    pane_rested(p)
}

devwire_state() {
    for p in 0..PANES {
        pane: *Pane = pane_of(p);
        at: Place = pane_place(p);
        words_begin();
        words_add("vellum: pane ");
        words_add_int(p);
        words_add(" parts ");
        words_add_int(pane.n);
        words_add(" at ");
        words_add_int(at.c);
        words_add(" ");
        words_add_int(at.i);
        words_add(" offset ");
        words_add_int(if (pane.scroll != 0) pane_offset(pane) as int else -1);
        words_add(" chrome ");
        words_add_int(pane.chrome_top as int);
        words_add(" ");
        words_add_int(pane.chrome_bottom as int);
        words_add(" go ");
        words_add_int(pane.go_c);
        words_add(" ready ");
        words_add_int(if (pane_ready(p)) 1 else 0);
        words_add(" chapters ");
        words_add_int(pane_chapters);
        words_add(" cover ");
        words_add_int(if (pane.cover != 0) 1 else 0);
        words_add(" next ");
        words_add_int(next_asked);
        words_add("/");
        words_add_int(next_sent);
        words_add(" timer ");
        words_add_int(if (next_timer != 0) 1 else 0);
        words_add(" coming ");
        coming_n: int = 0;
        for r in 0..pane.n {
            ps: int = part_slot(p, pane.chapter[r], pane.part[r]);
            if (ps >= 0) {
                borrow parts[ps] as part {
                    if (part.coming) coming_n = coming_n + 1
                }
            }
        }
        words_add_int(coming_n);
        words_add(" aim ");
        words_add_int(pane.aim_c);
        words_add(" ");
        words_add_int(pane.aim_i);
        words_add(" unplaced ");
        words_add_int(if (pane.unplaced) 1 else 0);
        note_ns(words_ns())
    }
    words_begin();
    words_begin();
    words_add("vellum: dockwin ");
    words_add_int(if (vellum_dock_window != 0) 1 else 0);
    if (vellum_dock_window != 0) {
        f: Rect = frame_of(vellum_dock_window);
        words_add(" frame ");
        words_add_int(f.x as int);
        words_add(",");
        words_add_int(f.y as int);
        words_add(" ");
        words_add_int(f.w as int);
        words_add("x");
        words_add_int(f.h as int);
        words_add(" hidden ");
        words_add_int(if (truth(msg(vellum_dock_window, sel("isHidden")))) 1 else 0);
        words_add(" alpha ");
        words_add_int((msg_f(vellum_dock_window, sel("alpha")) * 100.0f64) as int);
        words_add(" root ");
        words_add_int(if (msg(vellum_dock_window, sel("rootViewController")) == dock_root && dock_root != 0) 1 else 0);
        words_add(" in ");
        words_add_int(if (msg(dock.container, sel("window")) == vellum_dock_window) 1 else 0);
        words_add(" scene ");
        words_add_int(if (msg(vellum_dock_window, sel("windowScene")) == scene_obj) 1 else 0);
        words_add(" level ");
        words_add_int(msg_f(vellum_dock_window, sel("windowLevel")) as int);
        cf: Rect = frame_of(dock.container);
        words_add(" container ");
        words_add_int(cf.w as int);
        words_add("x");
        words_add_int(cf.h as int);
        words_add(" calpha ");
        words_add_int((msg_f(dock.container, sel("alpha")) * 100.0f64) as int);
        for g in [dock.left_glass, dock.title_glass, dock.right_glass] {
            gf: Rect = frame_of(g);
            words_add(" [");
            words_add_int(gf.x as int);
            words_add(",");
            words_add_int(gf.y as int);
            words_add(" ");
            words_add_int(gf.w as int);
            words_add(" fx ");
            words_add_int(if (msg(g, sel("effect")) != 0) 1 else 0);
            words_add(" a ");
            words_add_int((msg_f(g, sel("alpha")) * 100.0f64) as int);
            words_add(" ca ");
            words_add_int((msg_f(glass_content(g), sel("alpha")) * 100.0f64) as int);
            words_add(" h ");
            words_add_int(if (truth(msg(g, sel("isHidden")))) 1 else 0);
            words_add("]")
        }
        words_add(" mode ");
        words_add_int(dock.mode);
        words_add(" keywin ");
        words_add_int(if (truth(msg(vellum_dock_window, sel("isKeyWindow")))) 1 else 0);
        words_add(" sup ");
        words_add_int(if (msg(dock.container, sel("superview")) == msg(dock_root,
            sel("view"))) 1 else 0);
        words_add(" rootview ");
        rv: Rect = frame_of(msg(dock_root, sel("view")));
        words_add_int(rv.w as int);
        words_add("x");
        words_add_int(rv.h as int)
    }
    note_ns(words_ns());
    words_begin();
    words_add("vellum: follow leader ");
    words_add_int(leader);
    words_add(" linked ");
    words_add_int(if (linked) 1 else 0);
    words_add(" held ");
    words_add_int(if (jump_held) 1 else 0);
    words_add(" ruled ");
    words_add_int(if (ruled) 1 else 0);
    words_add(" can ");
    words_add_int(if (follow_can()) 1 else 0);
    words_add(" pending ");
    words_add_int(if (follow_pending) 1 else 0);
    words_add(" last ");
    words_add_int(follow_last);
    words_add(" edge ");
    words_add_int(edge_chapter(0));
    words_add(" ");
    words_add_int(edge_chapter(1));
    note_ns(words_ns());
    words_add("vellum: panel shown ");
    words_add_int(if (panel.shown) 1 else 0);
    words_add(" top ");
    words_add_int(panel.top as int);
    words_add(" dock y ");
    words_add_int((if (vellum_dock_window != 0) frame_of(vellum_dock_window).y else frame_of(dock.container).y) as int);
    words_add(" covered ");
    words_add_int(if (dock_covered) 1 else 0);
    words_add(" wanted ");
    words_add_int(if (panel.wanted) 1 else 0);
    words_add(" leaving ");
    words_add_int(if (panel.leaving) 1 else 0);
    words_add(" nav ");
    words_add_int(if (panel.nav != 0) 1 else 0);
    words_add(" presented ");
    words_add_int(if (panel.nav != 0 && msg(panel.nav, sel("presentingViewController")) != 0) 1 else 0);
    words_add(" inherited ");
    words_add_int((msg_f(cls("UIView"), sel("inheritedAnimationDuration")) * 1000.0f64) as int);
    nav: int = panel_nav();
    words_add(" toolbar hidden ");
    words_add_int(if (nav != 0 && truth(msg(nav, sel("isToolbarHidden")))) 1 else 0);
    words_add(" items ");
    words_add_int(if (nav != 0 && msg(msg(nav, sel("topViewController")), sel("toolbarItems")) != 0) msg(msg(msg(nav,
        sel("topViewController")), sel("toolbarItems")), sel("count")) else -1);
    if (nav != 0) {
        bar: int = msg(nav, sel("toolbar"));
        f: Rect = frame_of(bar);
        words_add(" bar ");
        words_add_int(f.y as int);
        words_add(",");
        words_add_int(f.h as int);
        words_add(" w ");
        words_add_int(f.w as int);
        words_add(" alpha ");
        words_add_int((msg_f(bar, sel("alpha")) * 100.0f64) as int);
        words_add(" barhidden ");
        words_add_int(if (truth(msg(bar, sel("isHidden")))) 1 else 0);
        words_add(" super ");
        words_add_int(if (msg(bar, sel("superview")) != 0) 1 else 0);
        words_add(" navh ");
        words_add_int(frame_of(msg(nav, sel("view"))).h as int)
    }
    words_add(" root over ");
    words_add_int(if (msg(root_vc, sel("presentedViewController")) != 0) 1 else 0);
    note_ns(words_ns());
    sheets_state()
}

// ---- a finger's fling, simulated ----
// The pane moved frame by frame by DY over FLICK_S, fast then slowing, as
// a finger's glide is (counted as a hand's: it leads), then at rest.
FLICK_S: f64 = 1.2f64;

type Flick = {
    pane: int;
    by: f64;
    went: f64;
    began: f64
}

flick: Flick = Flick {
    pane: -1,
    by: 0.0f64,
    went: 0.0f64,
    began: 0.0f64
};

// (A display link stepping it, made once a build.)
flick_link: int = 0;

flick_begin(p: int, dy: int) {
    if (p < 0 || p >= PANES || pane_of(p).scroll == 0 || flick.pane >= 0) return;
    pane_hand_began(p);
    hand_on_pane(p);
    flick = Flick {
        pane: p,
        by: dy as f64,
        went: 0.0f64,
        began: CACurrentMediaTime()
    };
    if (flick_link == 0) {
        flick_link = retain(msg2(cls("CADisplayLink"), sel("displayLinkWithTarget:selector:"),
            app_obj, sel("vellumFlickStep:")));
        msg2(flick_link, sel("addToRunLoop:forMode:"), msg(cls("NSRunLoop"), sel("mainRunLoop")),
            l8_run_loop_common_modes())
    }
    msg1(flick_link, sel("setPaused:"), 0)
}

// Whether pane p is being flicked so (a hand moves it).
flicking(p: int): bool {
    flick.pane == p && p >= 0
}

flick_step(_self: int, _cmd: int, _link: int): int {
    p: int = flick.pane;
    if (p < 0) {
        msg1(flick_link, sel("setPaused:"), 1);
        return 0
    }
    pane: *Pane = pane_of(p);
    t: f64 = clamp_f((CACurrentMediaTime() - flick.began) / FLICK_S, 0.0f64, 1.0f64);
    u: f64 = 1.0f64 - t;
    went: f64 = flick.by * (1.0f64 - u * u * u);
    set_offset_y(pane.scroll, pane_offset(pane) + went - flick.went);
    flick.went = went;
    if (t < 1.0f64) return 0;
    flick.pane = -1;
    msg1(flick_link, sel("setPaused:"), 1);
    pane_rested(p);
    0
}

// ---- the screen recorded (ReplayKit) ----
record_state: int = 0;

RECORD_NONE: int = 0;

RECORD_ON: int = 1;

RECORD_WRITING: int = 2;

record_stopped: f64 = 0.0f64;

record_size: int = -1;

record_settled: f64 = 0.0f64;

record_poll: int = 0;

recorder(): int {
    if (cls("RPScreenRecorder") == 0) _l: int = msg(msg1(cls("NSBundle"), sel("bundleWithPath:"),
        nsstring("/System/Library/Frameworks/ReplayKit.framework")), sel("load"));
    if (cls("RPScreenRecorder") == 0) 0 else msg(cls("RPScreenRecorder"), sel("sharedRecorder"))
}

record_path(): int {
    msg1(NSHomeDirectory(), sel("stringByAppendingString:"), nsstring("/tmp/vellum-recording.mov"))
}

record_on() {
    r: int = recorder();
    if (r == 0 || record_state != RECORD_NONE) {
        note("vellum: record: can't record now");
        return
    }
    msg1(r, sel("setMicrophoneEnabled:"), 0);
    msg1(r, sel("startRecordingWithHandler:"), 0);
    record_state = RECORD_ON;
    note("vellum: record: on")
}

record_off() {
    r: int = recorder();
    if (r == 0 || record_state != RECORD_ON) return;
    if (!truth(msg(r, sel("isRecording")))) {
        record_state = RECORD_NONE;
        note("vellum: record: it never began (not allowed on the phone?)");
        return
    }
    path: int = record_path();
    msg2(msg(cls("NSFileManager"), sel("defaultManager")), sel("removeItemAtPath:error:"),
        path, 0);
    msg2(r, sel("stopRecordingWithOutputURL:completionHandler:"), msg1(cls("NSURL"),
        sel("fileURLWithPath:"), path), 0);
    record_state = RECORD_WRITING;
    record_stopped = CACurrentMediaTime();
    record_size = -1;
    record_poll = timer_stop(record_poll);
    record_poll = msg_f4(cls("NSTimer"), sel("scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:"),
        0.25f64, app_obj, sel("vellumRecordPoll:"), 0, 1)
}

// The movie looked for as it is written, posted once whole.
record_polled(_self: int, _cmd: int, _timer: int): int {
    now: f64 = CACurrentMediaTime();
    if (record_state != RECORD_WRITING || now - record_stopped > 30.0f64) {
        record_state = RECORD_NONE;
        record_poll = timer_stop(record_poll);
        return 0
    }
    attributes: int = msg2(msg(cls("NSFileManager"), sel("defaultManager")), sel("attributesOfItemAtPath:error:"),
        record_path(), 0);
    size: int = if (attributes == 0) -1 else msg(attributes, sel("fileSize"));
    if (size <= 0) return 0;
    if (size != record_size) {
        record_size = size;
        record_settled = now;
        return 0
    }
    if (now - record_settled < 0.75f64) return 0;
    record_state = RECORD_NONE;
    record_poll = timer_stop(record_poll);
    body: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), record_path());
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), msg1(dw_url, sel("stringByAppendingString:"),
        nsstring("/video")));
    if (url == 0 || body == 0) return 0;
    request: int = msg1(cls("NSMutableURLRequest"), sel("requestWithURL:"), url);
    msg1(request, sel("setHTTPMethod:"), nsstring("POST"));
    msg1(request, sel("setHTTPBody:"), body);
    task: int = msg1(vellum_dw_session, sel("dataTaskWithRequest:"), request);
    if (task != 0) msg(task, sel("resume"));
    0
}

add_devwire_methods(app: int) {
    add_method1(app, sel("vellumFlickStep:"), &flick_step, "v@:@");
    add_method1(app, sel("vellumRecordPoll:"), &record_polled, "v@:@");
    add_method1(app, sel("vellumWireAgain:"), &devwire_poll_again, "v@:@");
    add_method1(app, sel("vellumProbe:"), &probe_frame, "v@:@")
}

// The panel's sheet's views, from the nav's up to the window: each one's
// class, frame and whether it clips.
devwire_sheet_views() {
    nav: int = panel_nav();
    if (nav == 0) return;
    presented: int = msg(msg(nav, sel("presentationController")), sel("presentedView"));
    v: int = msg(nav, sel("view"));
    steps: int = 0;
    while (v != 0 && steps < 12) {
        f: Rect = frame_of(v);
        words_begin();
        words_add("vellum: view ");
        words_add_ns(msg(msg(v, sel("class")), sel("description")));
        words_add(" ");
        words_add_int(f.x as int);
        words_add(",");
        words_add_int(f.y as int);
        words_add(" ");
        words_add_int(f.w as int);
        words_add("x");
        words_add_int(f.h as int);
        words_add(" clips ");
        words_add_int(if (truth(msg(v, sel("clipsToBounds")))) 1 else 0);
        words_add(" masks ");
        words_add_int(if (truth(msg(msg(v, sel("layer")), sel("masksToBounds")))) 1 else 0);
        words_add(" mask ");
        words_add_int(if (msg(msg(v, sel("layer")), sel("mask")) != 0) 1 else 0);
        if (v == presented) words_add(" (presentedView)");
        note_ns(words_ns());
        v = msg(v, sel("superview"));
        steps = steps + 1
    }
}

// ---- where the dock and the panel's sheet are drawn, frame by frame ----
// `!probe N`: for N frames, each frame's drawn top of the dock's
// container and of the panel's sheet (their presentation layers), logged.
probe_link: int = 0;

probe_left: int = 0;

probe_sheet: int = 0;

probe_last_dock: int = 0;

probe_last_sheet: int = 0;

probe_last_page: int = 0;

probe_last_panel: int = 0;

probe_time: f64 = 0.0f64;

probe_begin(frames: int) {
    probe_left = frames;
    nav: int = panel_nav();
    probe_sheet = held(probe_sheet, if (nav != 0) msg(msg(nav, sel("presentationController")),
        sel("presentedView")) else 0);
    if (probe_link == 0) {
        probe_link = retain(msg2(cls("CADisplayLink"), sel("displayLinkWithTarget:selector:"),
            app_obj, sel("vellumProbe:")));
        msg2(probe_link, sel("addToRunLoop:forMode:"), msg(cls("NSRunLoop"), sel("mainRunLoop")),
            l8_run_loop_common_modes())
    }
    msg1(probe_link, sel("setPaused:"), 0)
}

probe_frame(_self: int, _cmd: int, _link: int): int {
    if (probe_left <= 0) {
        msg1(probe_link, sel("setPaused:"), 1);
        return 0
    }
    probe_left = probe_left - 1;
    nav: int = panel_nav();
    if (nav != 0) probe_sheet = held(probe_sheet, msg(msg(nav, sel("presentationController")),
        sel("presentedView")));
    presented: int = probe_sheet;
    d: int = (probe_drawn_top(dock.container) * 10.0f64) as int;
    t: int = if (presented != 0 && msg(presented, sel("window")) != 0) (probe_drawn_top(presented) * 10.0f64) as int else -1;
    // (Pane offsets and the frame's time: a fling's frames, for hitches.)
    now: f64 = CACurrentMediaTime();
    page_y: int = (pane_offset(pane_of(0)) * 10.0f64) as int;
    panel_y: int = if (pane_of(1).scroll != 0) (pane_offset(pane_of(1)) * 10.0f64) as int else 0;
    gap_ms: int = ((now - probe_time) * 1000.0f64) as int;
    probe_time = now;
    // (Only frames where something moved.)
    if (d == probe_last_dock && t == probe_last_sheet && page_y == probe_last_page && panel_y == probe_last_panel) return 0;
    probe_last_page = page_y;
    probe_last_panel = panel_y;
    probe_last_dock = d;
    probe_last_sheet = t;
    words_begin();
    words_add("vellum: probe ms ");
    words_add_int(gap_ms);
    words_add(" page ");
    words_add_int(page_y);
    words_add(" panel ");
    words_add_int(panel_y);
    words_add(" parts ");
    words_add_int(pane_of(0).n);
    words_add("/");
    words_add_int(pane_of(1).n);
    words_add(" coming ");
    words_add_int(probe_coming(0));
    words_add("/");
    words_add_int(probe_coming(1));
    words_add(" cover ");
    words_add_int(if (pane_of(1).cover != 0) 1 else 0);
    words_add(" seen ");
    words_add_int(if (probe_seen_laid(1)) 1 else 0);
    q: *Pane = pane_of(1);
    if (q.n > 0) {
        words_add(" span ");
        words_add_int(q.y[0] as int);
        words_add("-");
        words_add_int((q.y[q.n - 1] + q.h[q.n - 1]) as int);
        words_add(" sight ");
        words_add_int(pane_top(q) as int);
        words_add("-");
        words_add_int(pane_bottom(q) as int);
        words_add(" first ");
        words_add_int(q.chapter[0]);
        words_add(":");
        words_add_int(q.part[0])
    }
    words_add(" dock ");
    words_add_int(d);
    words_add(" sheet ");
    words_add_int(t);
    words_add(" model ");
    words_add_int(if (presented != 0) (frame_of(presented).y * 10.0f64) as int else -1);
    words_add(" h ");
    words_add_int(if (presented != 0) (frame_of(presented).h * 10.0f64) as int else -1);
    words_add(" top ");
    words_add_int((panel.top * 10.0f64) as int);
    words_add(" alpha ");
    words_add_int((msg_f(glass_content(dock.title_glass), sel("alpha")) * 100.0f64) as int);
    note_ns(words_ns());
    0
}

probe_drawn_top(v: int): f64 {
    y: f64 = 0.0f64;
    layer: int = msg(v, sel("layer"));
    top_layer: int = msg(window, sel("layer"));
    steps: int = 0;
    while (layer != 0 && layer != top_layer && steps < 32) {
        geo_of(probe_drawn(layer), "frame");
        y = y + geo[1];
        above: int = msg(layer, sel("superlayer"));
        if (above != 0) {
            geo_of(probe_drawn(above), "bounds");
            y = y - geo[1]
        }
        layer = above;
        steps = steps + 1
    }
    y
}

probe_drawn(layer: int): int {
    drawn: int = msg(layer, sel("presentationLayer"));
    if (drawn != 0) drawn else layer
}

// How many of pane p's rows hold a part still coming.
probe_coming(p: int): int {
    pane: *Pane = pane_of(p);
    n: int = 0;
    for r in 0..pane.n {
        ps: int = part_slot(p, pane.chapter[r], pane.part[r]);
        if (ps >= 0) {
            borrow parts[ps] as part {
                if (part.coming) n = n + 1
            }
        }
    }
    n
}

// Whether what is in sight of pane p is all laid out.
probe_seen_laid(p: int): bool {
    pane: *Pane = pane_of(p);
    if (pane.n == 0 || pane.scroll == 0) return false;
    pane.y[0] <= pane_top(pane) && pane.y[pane.n - 1] + pane.h[pane.n - 1] >= pane_bottom(pane)
}
