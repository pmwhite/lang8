tag vellum;

use_tag std, ios, bible, bible_wire;

// The phone as a platform for core's host (SKINS.md, the contract's
// part 1): data files from the app's bundle (or the development server's,
// devwire.l8), what is kept as files in Application Support/SmoothBible
// (the same files as the other iPhone skin's: the reader's highlights,
// notes and places are one), a GET by NSURLSession, a recording or a
// module's package fetched into a kept file, kept files read back and
// written, and the network's kind as it changes.
import "../../ios/objc.l8";

import "../core/host.l8";

import "kit.l8";

extern NSSearchPathForDirectoriesInDomains(directory: int, mask: int, expand: int): int;

extern add_method5(
    cls: int,
    selector: int,
    imp: fn(self: int, cmd: int, a: int, b: int, c: int, d: int, e: int): int,
    types: str
): int = class_addMethod;

extern SCNetworkReachabilityCreateWithAddress(allocator: int, address: []i8): int;

extern SCNetworkReachabilityGetFlags(target: int, flags: []i8): int;

extern SCNetworkReachabilitySetCallback(target: int, callout: fn(target: int, flags: int, info: int),
    context: int): int;

extern SCNetworkReachabilityScheduleWithRunLoop(target: int, run_loop: int, mode: int): int;

extern CFRunLoopGetMain(): int;

extern open_fd(path: int, flags: int, mode: int): int = open;

extern close_fd(fd: int): int = close;

extern lseek(fd: int, offset: int, whence: int): int;

// ---- what is kept, as files ----
kept_dir: int = 0;

kept_dir_path(): int {
    if (kept_dir != 0) return kept_dir;
    dirs: int = NSSearchPathForDirectoriesInDomains(14, 1, 1);
    base: int = msg(dirs, sel("firstObject"));
    if (base == 0) base = NSHomeDirectory();
    kept_dir = retain(msg1(base, sel("stringByAppendingPathComponent:"), nsstring("SmoothBible")));
    msg4(msg(cls("NSFileManager"), sel("defaultManager")), sel("createDirectoryAtPath:withIntermediateDirectories:attributes:error:"),
        kept_dir, 1, 0, 0);
    kept_dir
}

kept_path_of(name: int): int {
    msg1(kept_dir_path(), sel("stringByAppendingPathComponent:"), name)
}

// The file core names (kp_name), as a path.
kept_path(): int {
    kept_path_of(nsstring_of(kp_name, kp_name_n))
}

// A file at path into fbuf (fbuf_n 0: none). One larger than fbuf is not
// read at all: a part of it would be taken for the whole.
read_into_fbuf(path: int) {
    fbuf_n = 0;
    data: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), path);
    if (data == 0) return;
    n: int = msg(data, sel("length"));
    if (n > len(fbuf)) {
        note_num("vellum: a kept file is too large to read, bytes ", n);
        return
    }
    if (n > 0) memcpy_from(fbuf, msg(data, sel("bytes")), n);
    fbuf_n = n
}

fbuf_written_to(path: int): bool {
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    truth(msg2(data, sel("writeToFile:atomically:"), path, 1))
}

kept_read_now() {
    read_into_fbuf(kept_path())
}

kept_write_now() {
    if (!fbuf_written_to(kept_path())) save_failed()
}

kept_append_now() {
    path: int = kept_path();
    data: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(fbuf),
        fbuf_n);
    handle: int = msg1(cls("NSFileHandle"), sel("fileHandleForWritingAtPath:"), path);
    if (handle == 0) {
        if (!truth(msg2(data, sel("writeToFile:atomically:"), path, 1))) save_failed();
        return
    }
    msg(handle, sel("seekToEndOfFile"));
    msg1(handle, sel("writeData:"), data);
    msg(handle, sel("closeFile"))
}

kept_remove_now() {
    msg2(msg(cls("NSFileManager"), sel("defaultManager")), sel("removeItemAtPath:error:"),
        kept_path(), 0)
}

// A write that failed: said once, a toast that stays a while (the phone
// full).
save_failed_said: bool = false;

save_failed() {
    note("vellum: a kept file could not be written");
    if (save_failed_said) return;
    save_failed_said = true;
    toast_show(nsstring("Couldn\â\€\™t save. Check your iPhone\â\€\™s storage."),
        nsstring("exclamationmark.triangle"))
}

// ---- the data files ----
// Asked for by id (core's names: "bsb.folio", "lang/words.bin"), answered a
// turn of the run loop later, one at a time, so the reader comes up while
// the rest is read. A name is found in the bundle by its last part (its
// resources are flat).
ASKS_MOST: int = 128;

ASK_NAME_MOST: int = 64;

ask_names: []i8 = new i8[128 * 64](0i8);

ask_name_n: []int = new int[128](0);

ask_queue: []int = new int[128](0);

ask_queue_n: int = 0;

data_ask(id: int, name: str) {
    if (id < 0 || id >= ASKS_MOST) link_fail("core asked for a file by an id out of range");
    if (ask_queue_n >= len(ask_queue)) link_fail("core asked for too many files at once");
    if (len(name) > ASK_NAME_MOST) link_fail("core asked for a file by too long a name");
    for i in 0..len(name) ask_names[id * ASK_NAME_MOST + i] = name[i];
    ask_name_n[id] = len(name);
    ask_queue[ask_queue_n] = id;
    ask_queue_n = ask_queue_n + 1;
    asks_soon()
}

// The file ask id is read from: the development server's, where it gave
// one, else the bundle's (0: none).
data_path(id: int): int {
    given: int = devwire_data_path(id);
    if (given != 0) given else bundle_path(id)
}

bundle_path(id: int): int {
    start: int = id * ASK_NAME_MOST;
    end: int = start + ask_name_n[id];
    leaf: int = start;
    for i in start..end
        if (ask_names[i] as int == 47) leaf = i + 1;
    resources: int = msg(msg(cls("NSBundle"), sel("mainBundle")), sel("resourcePath"));
    path: int = msg1(resources, sel("stringByAppendingPathComponent:"), nsstring_at(bytes_address(ask_names) + leaf,
        end - leaf));
    if (truth(msg1(msg(cls("NSFileManager"), sel("defaultManager")), sel("fileExistsAtPath:"),
        path))) path else 0
}

// A file's size (-1: not there), by seeking to its end.
path_bytes(path: int): int {
    fd: int = open_fd(msg(path, sel("fileSystemRepresentation")), 0, 0);
    if (fd < 0) return -1;
    n: int = lseek(fd, 0, 2);
    _c: int = close_fd(fd);
    n
}

// A file read into out from offset (as much as fits).
path_read(path: int, offset: int, out: []i8) {
    fd: int = open_fd(msg(path, sel("fileSystemRepresentation")), 0, 0);
    if (fd < 0) return;
    if (offset > 0 && lseek(fd, offset, 0) != offset) {
        _c: int = close_fd(fd);
        return
    }
    n: int = 0;
    more: bool = true;
    while (more && n < len(out)) {
        got: int = read(fd, out, n, len(out) - n);
        if (got <= 0) more = false else n = n + got
    }
    _c: int = close_fd(fd)
}

// ---- kept files read back (HostIO.read_kept, read_kept_range) ----
KEPT_READS_MOST: int = 32;

KEPT_NAME_MOST: int = 64;

type KeptRead = {
    id: int;
    name_n: int;
    offset: int;
    // How many bytes (-1: to its end).
    count: int
}

kept_reads: []KeptRead = new KeptRead[32](KeptRead {
    id: 0,
    name_n: 0,
    offset: 0,
    count: 0
});

kept_read_names: []i8 = new i8[32 * 64](0i8);

kept_reads_n: int = 0;

kept_reads_said: int = 0;

kept_read_whole(id: int, name: []i8, name_n: int) {
    kept_read_span(id, name, name_n, 0, -1)
}

kept_read_span(
    id: int,
    name: []i8,
    name_n: int,
    offset: int,
    count: int
) {
    if (kept_reads_n >= KEPT_READS_MOST || name_n > KEPT_NAME_MOST) link_fail("core asked to read too many kept files at once");
    kept_reads[kept_reads_n] = KeptRead {
        id: id,
        name_n: name_n,
        offset: offset,
        count: count
    };
    for i in 0..name_n kept_read_names[kept_reads_n * KEPT_NAME_MOST + i] = name[i];
    kept_reads_n = kept_reads_n + 1;
    asks_soon()
}

kept_read_path(k: int): int {
    kept_path_of(nsstring_at(bytes_address(kept_read_names) + k * KEPT_NAME_MOST,
        kept_reads[k].name_n))
}

kept_read_size(k: int): int {
    size: int = path_bytes(kept_read_path(k));
    if (size < 0) return size;
    left: int = size - kept_reads[k].offset;
    if (left < 0) left = 0;
    count: int = kept_reads[k].count;
    if (count >= 0 && count < left) count else left
}

kept_read_find(id: int): int {
    for k in 0..kept_reads_n
        if (kept_reads[k].id == id) return k;
    -1
}

kept_read_forget(k: int) {
    for j in k..kept_reads_n - 1 {
        kept_reads[j] = kept_reads[j + 1];
        for i in 0..KEPT_NAME_MOST kept_read_names[j * KEPT_NAME_MOST + i] = kept_read_names[(j + 1) * KEPT_NAME_MOST + i]
    }
    kept_reads_n = kept_reads_n - 1;
    if (kept_reads_said > k) kept_reads_said = kept_reads_said - 1
}

// count bytes of data kept as the file named, out of backups (a copy of
// what is online): answered `kept ID OK`.
kept_keep(
    id: int,
    name: []i8,
    name_n: int,
    data: []i8,
    count: int
) {
    path: int = kept_path_of(nsstring_at(bytes_address(name), name_n));
    bytes: int = msg2(cls("NSData"), sel("dataWithBytes:length:"), bytes_address(data),
        count);
    ok: bool = truth(msg2(bytes, sel("writeToFile:atomically:"), path, 1));
    if (ok) _b: int = msg3(msg1(cls("NSURL"), sel("fileURLWithPath:"), path), sel("setResourceValue:forKey:error:"),
        nsnumber_int(1), objc_const("NSURLIsExcludedFromBackupKey"), 0) else note("vellum: a module's file could not be kept");
    send2("kept", id, if (ok) 1 else 0)
}

// ---- answering asks, a turn at a time ----
asks_timer: int = 0;

asks_soon() {
    if (asks_timer != 0 || app_obj == 0) return;
    asks_timer = timer_after(app_obj, 0.0f64, "vellumAsks:")
}

asks_fired(_self: int, _cmd: int, _timer: int): int {
    asks_timer = 0;
    if (kept_reads_said < kept_reads_n) {
        k: int = kept_reads_said;
        id: int = kept_reads[k].id;
        size: int = kept_read_size(k);
        // (Nothing to take: forgotten now, so an id asked again is new.)
        if (size <= 0) kept_read_forget(k) else kept_reads_said = kept_reads_said + 1;
        send2("got", id, size);
        asks_soon();
        return 0
    }
    if (ask_queue_n == 0 || !devwire_data_ready()) return 0;
    id: int = ask_queue[0];
    for i in 1..ask_queue_n ask_queue[i - 1] = ask_queue[i];
    ask_queue_n = ask_queue_n - 1;
    path: int = data_path(id);
    size: int = if (path != 0) path_bytes(path) else -1;
    if (size < 0) note("vellum: a data file is not in the bundle");
    send2("got", id, size);
    asks_soon();
    0
}

// A turn core asked for (`next`), on the run loop's next pass, once the
// screen is drawn.
next_timer: int = 0;

core_next_soon() {
    if (next_timer != 0 || app_obj == 0) return;
    next_timer = timer_after(app_obj, 0.0f64, "vellumNext:")
}

core_next_fired(_self: int, _cmd: int, _timer: int): int {
    next_timer = 0;
    send0("next");
    0
}

// ---- a GET ----
HTTP_MOST: int = 8;

type HttpCall = {
    id: int;
    task: int;
    body: int
}

http_calls: []HttpCall = new HttpCall[8](HttpCall { id: -1, task: 0, body: 0 });

// Each answer's body (NSData, kept) until core takes it, by id.
http_answers: []HttpCall = new HttpCall[8](HttpCall { id: -1, task: 0, body: 0 });

net_class: int = 0;

http_session_obj: int = 0;

http_session(): int {
    if (http_session_obj != 0) return http_session_obj;
    config: int = msg(cls("NSURLSessionConfiguration"), sel("ephemeralSessionConfiguration"));
    msg_set_f(config, sel("setTimeoutIntervalForRequest:"), 12.0f64);
    msg1(config, sel("setRequestCachePolicy:"), 1);
    msg1(config, sel("setURLCache:"), 0);
    delegate: int = fresh("VellumNet");
    http_session_obj = retain(msg3(cls("NSURLSession"), sel("sessionWithConfiguration:delegate:delegateQueue:"),
        config, delegate, msg(cls("NSOperationQueue"), sel("mainQueue"))));
    http_session_obj
}

// The app's version and build, as the site's Worker is told them.
app_version(): int {
    info: int = msg(msg(cls("NSBundle"), sel("mainBundle")), sel("infoDictionary"));
    v: int = msg1(info, sel("objectForKey:"), nsstring("CFBundleShortVersionString"));
    b: int = msg1(info, sel("objectForKey:"), nsstring("CFBundleVersion"));
    words_begin();
    words_add_ns(if (v != 0) v else nsstring("1.0"));
    words_add(" (");
    words_add_ns(if (b != 0) b else nsstring("1"));
    words_add(")");
    words_ns()
}

http_get(id: int, b: []i8, n: int) {
    slot: int = -1;
    for i in 0..HTTP_MOST
        if (http_calls[i].task == 0 && slot < 0) slot = i;
    url: int = msg1(cls("NSURL"), sel("URLWithString:"), nsstring_of(b, n));
    if (slot < 0 || url == 0) {
        send3("http", id, 0, 0);
        return
    }
    request: int = msg1(cls("NSMutableURLRequest"), sel("requestWithURL:"), url);
    msg2(request, sel("setValue:forHTTPHeaderField:"), app_version(), nsstring("X-Smooth-Bible"));
    task: int = msg1(http_session(), sel("dataTaskWithRequest:"), request);
    if (task == 0) {
        send3("http", id, 0, 0);
        return
    }
    http_calls[slot] = HttpCall { id: id, task: retain(task), body: make("NSMutableData") };
    msg(task, sel("resume"))
}

http_slot(task: int): int {
    for i in 0..HTTP_MOST
        if (task != 0 && http_calls[i].task == task) return i;
    -1
}

net_received(
    _self: int,
    _cmd: int,
    _session: int,
    task: int,
    data: int
): int {
    if (devwire_received(task, data)) return 0;
    i: int = http_slot(task);
    if (i >= 0) msg1(http_calls[i].body, sel("appendData:"), data);
    0
}

net_completed(
    _self: int,
    _cmd: int,
    _session: int,
    task: int,
    error: int
): int {
    if (task != 0 && task == fetch_task) {
        fetch_completed(error);
        return 0
    }
    if (devwire_completed(task, error)) return 0;
    i: int = http_slot(task);
    if (i < 0) return 0;
    call: HttpCall = http_calls[i];
    status: int = if (error == 0) msg(msg(task, sel("response")), sel("statusCode")) else 0;
    http_calls[i] = HttpCall { id: -1, task: 0, body: 0 };
    release(task);
    // (Its body kept for core, in place of an earlier answer to the id.)
    k: int = -1;
    for j in 0..HTTP_MOST
        if (http_answers[j].id == call.id) k = j;
    if (k < 0) {
        for j in 0..HTTP_MOST
            if (http_answers[j].body == 0 && k < 0) k = j
    }
    size: int = 0;
    if (k >= 0) {
        release(http_answers[k].body);
        http_answers[k] = HttpCall { id: call.id, task: 0, body: call.body };
        size = msg(call.body, sel("length"))
    } else release(call.body);
    send3("http", call.id, status, size);
    0
}

// ---- recordings and packages fetched into kept files ----
// One at a time (core asks so), by a download task: moved to its kept name
// once the answer is 200, out of backups.
fetch_session_obj: int = 0;

fetch_task: int = 0;

fetch_id: int = -1;

fetch_name: int = 0;

fetch_moved: int = 0;

fetch_status: int = 0;

fetch_session(): int {
    if (fetch_session_obj != 0) return fetch_session_obj;
    config: int = msg(cls("NSURLSessionConfiguration"), sel("defaultSessionConfiguration"));
    msg1(config, sel("setWaitsForConnectivity:"), 0);
    msg_set_f(config, sel("setTimeoutIntervalForRequest:"), 30.0f64);
    fetch_session_obj = retain(msg3(cls("NSURLSession"), sel("sessionWithConfiguration:delegate:delegateQueue:"),
        config, fresh("VellumNet"), msg(cls("NSOperationQueue"), sel("mainQueue"))));
    fetch_session_obj
}

fetch_start(
    id: int,
    url: []i8,
    url_n: int,
    name: []i8,
    name_n: int
) {
    address: int = msg1(cls("NSURL"), sel("URLWithString:"), nsstring_of(url, url_n));
    if (fetch_task != 0 || address == 0) {
        send3("fetched", id, 0, 0);
        return
    }
    task: int = msg1(fetch_session(), sel("downloadTaskWithURL:"), address);
    if (task == 0) {
        send3("fetched", id, 0, 0);
        return
    }
    fetch_id = id;
    fetch_task = retain(task);
    fetch_name = retain(nsstring_of(name, name_n));
    fetch_moved = 0;
    fetch_status = 0;
    msg(task, sel("resume"))
}

fetch_finished(
    _self: int,
    _cmd: int,
    _session: int,
    task: int,
    location: int
): int {
    if (task != fetch_task || task == 0) return 0;
    fetch_status = msg(msg(task, sel("response")), sel("statusCode"));
    if (fetch_status != 200) return 0;
    fm: int = msg(cls("NSFileManager"), sel("defaultManager"));
    to: int = kept_path_of(fetch_name);
    msg2(fm, sel("removeItemAtPath:error:"), to, 0);
    to_url: int = msg1(cls("NSURL"), sel("fileURLWithPath:"), to);
    if (!truth(msg3(fm, sel("moveItemAtURL:toURL:error:"), location, to_url, 0))) return 0;
    _b: int = msg3(to_url, sel("setResourceValue:forKey:error:"), nsnumber_int(1),
        objc_const("NSURLIsExcludedFromBackupKey"), 0);
    fetch_moved = path_bytes(to);
    0
}

fetch_wrote(
    _self: int,
    _cmd: int,
    _session: int,
    task: int,
    _wrote: int,
    total: int,
    expected: int
): int {
    if (task != fetch_task || task == 0) return 0;
    send3("fetching", fetch_id, total, if (expected > 0) expected else 0);
    0
}

fetch_completed(error: int) {
    id: int = fetch_id;
    release(fetch_task);
    release(fetch_name);
    fetch_task = 0;
    fetch_name = 0;
    fetch_id = -1;
    network_said();
    ok: bool = error == 0 && fetch_status == 200 && fetch_moved > 0;
    send3("fetched", id, if (error == 0) fetch_status else 0, if (ok) fetch_moved else 0)
}

// ---- the network's kind, said as it changes ----
// (Of the zero address: "any network, and is it cellular", with no host's
// name looked up. Kept through a hot reload: one watcher.)
persistent vellum_reach: int = 0;

reach_flags: []i8 = new i8[8](0i8);

reach_zero: []i8 = new i8[16](0i8);

network_last: int = -1;

network_kind(flags: int): int {
    if ((flags & 2) == 0) NET_NONE else if ((flags & 262144) != 0) NET_METERED else NET_FREE
}

network_tell(kind: int) {
    if (kind == network_last) return;
    network_last = kind;
    send1("network", kind)
}

network_said() {
    if (vellum_reach == 0) return;
    for i in 0..8 reach_flags[i] = 0i8;
    if (!truth(SCNetworkReachabilityGetFlags(vellum_reach, reach_flags))) return;
    flags: int = 0;
    for i in 0..4 flags = flags | (reach_flags[i] as int & 255) << 8 * i;
    network_tell(network_kind(flags))
}

network_changed(_target: int, flags: int, _info: int) {
    network_tell(network_kind(flags & 4294967295))
}

network_watch() {
    if (vellum_reach == 0) {
        reach_zero[0] = 16i8;
        reach_zero[1] = 2i8;
        vellum_reach = SCNetworkReachabilityCreateWithAddress(0, reach_zero);
        if (vellum_reach == 0) return;
        _s: int = SCNetworkReachabilityScheduleWithRunLoop(vellum_reach, CFRunLoopGetMain(),
            objc_const("NSRunLoopCommonModes"))
    }
    _c: int = SCNetworkReachabilitySetCallback(vellum_reach, &network_changed, 0);
    network_said()
}

// ---- a file's bytes for core (HostIO.file) ----
host_file(id: int, out: []i8): int {
    k: int = kept_read_find(id);
    if (k >= 0) {
        path: int = kept_read_path(k);
        offset: int = kept_reads[k].offset;
        size: int = kept_read_size(k);
        kept_read_forget(k);
        if (size > len(out)) link_fail("core's room for a kept file is less than the file");
        if (size > 0) path_read(path, offset, out);
        return size
    }
    if (id >= 0 && id < ASKS_MOST) {
        path: int = data_path(id);
        if (path == 0) return 0;
        path_read(path, 0, out);
        return path_bytes(path)
    }
    data: int = 0;
    for j in 0..HTTP_MOST {
        if (http_answers[j].id == id && http_answers[j].body != 0) {
            data = http_answers[j].body;
            http_answers[j] = HttpCall { id: -1, task: 0, body: 0 }
        }
    }
    if (data == 0) return 0;
    n: int = msg(data, sel("length"));
    if (n > len(out)) link_fail("core's room for a file is less than the file");
    if (n > 0) memcpy_from(out, msg(data, sel("bytes")), n);
    release(data);
    n
}

// ---- begun ----
// Core's host given the platform, and begun.
platform_begin() {
    kept_store = KeptStore {
        read: &kept_read_now,
        write: &kept_write_now,
        append: &kept_append_now,
        remove: &kept_remove_now
    };
    host_io = HostIO {
        ask: &data_ask,
        http: &http_get,
        file: &host_file,
        fetch: &fetch_start,
        read_kept: &kept_read_whole,
        read_kept_range: &kept_read_span,
        keep: &kept_keep,
        say: &from_core
    };
    ipad: bool = is_ipad();
    sk_device = (if (ipad) "iPad" else "iPhone");
    sk_device_prose = sk_device;
    sk_kept_place = (if (ipad) "on this iPad" else "on this iPhone");
    sk_fonts = LOOK_FONT_NAMES;
    sk_is_ios = true;
    hs_start();
    out_word("api https://smoothbible.com/api/v1/");
    out_end();
    network_watch()
}

is_ipad(): bool {
    msg(msg(cls("UIDevice"), sel("currentDevice")), sel("userInterfaceIdiom")) == 1
}

add_platform_methods(app: int) {
    add_method1(app, sel("vellumAsks:"), &asks_fired, "v@:@");
    add_method1(app, sel("vellumNext:"), &core_next_fired, "v@:@")
}

platform_classes_make() {
    net_class = class_make(cls("NSObject"), "VellumNet");
    add_method3(net_class, sel("URLSession:dataTask:didReceiveData:"), &net_received,
        "v@:@@@");
    add_method3(net_class, sel("URLSession:task:didCompleteWithError:"), &net_completed,
        "v@:@@@");
    add_method3(net_class, sel("URLSession:downloadTask:didFinishDownloadingToURL:"),
        &fetch_finished, "v@:@@@");
    add_method5(net_class, sel("URLSession:downloadTask:didWriteData:totalBytesWritten:totalBytesExpectedToWrite:"),
        &fetch_wrote, "v@:@@qqq");
    add_protocol(net_class, "NSURLSessionDownloadDelegate");
    add_protocol(net_class, "NSURLSessionDataDelegate")
}
