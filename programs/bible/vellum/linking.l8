tag vellum;

use_tag std, ios, bible, bible_wire;

// The two panes linked (SKINS.md, Panes: Linked): the pane a hand last
// moved leads, and the other keeps a section linked with the one at the
// top pane's top edge in sight, by core/follow.l8's rules, moving the
// least it must: put there at once, every quarter second while the leader
// moves and as soon as it rests, cross-faded (a jump, near or far, always
// the same).
//
// The links are made from core's link maps (the chapters about the
// leader's place) and the panes' anchors as laid out, kept from frame to
// frame while nothing they depend on changes (follow_links_stale), so that
// a frame of following costs the rule alone. A jump holds both panes until
// a hand moves either; the panel opened, its document come or the app
// restored is placed by the rule at once, and again as parts come, until
// then too.
import "../../ios/objc.l8";

import "../core/follow.l8";

import "kit.l8";

import "pane.l8";

// Whether the panel's reader is linked with the page (its screen's
// `reader 1`), and which pane leads.
linked: bool = false;

leader: int = PANE_PAGE;

// A jump holds both panes (no following) until a hand moves either.
jump_held: bool = false;

// The panel to be placed by the rule at once, again as parts come, until a
// hand moves either pane (`go 1 ... 2`).
ruled: bool = false;

// ---- the maps ----
MAPS_MOST: int = 8;

MATCHES_MOST: int = 2048;

map_c: []int = new int[8](-1);

map_mode: []int = new int[8](0);

map_comments: []int = new int[8](1);

map_n: []int = new int[8](0);

map_i0: []int = new int[8 * 2048](0);

map_i1: []int = new int[8 * 2048](0);

map_j: []int = new int[8 * 2048](0);

map_next: int = 0;

// A `link C MODE COMMENTS` block and its `match I0 I1 J` lines: kept, in
// place of the same chapter's, else the oldest's.
link_map_came(data: []i8, b: int, e: int) {
    first_end: int = part_line_end(data, b, e);
    head: Cursor = Cursor { at: b + len("link"), end: first_end };
    c: int = cursor_number(data, &head);
    mode: int = cursor_number(data, &head);
    comments: int = if (head.at < first_end) cursor_number(data, &head) else PANE_PANEL;
    s: int = map_slot(c);
    if (s < 0) {
        s = map_next;
        map_next = (map_next + 1) % MAPS_MOST
    }
    map_c[s] = c;
    map_mode[s] = mode;
    map_comments[s] = comments;
    n: int = 0;
    at: int = first_end + 1;
    while (at < e) {
        le: int = part_line_end(data, at, e);
        if (line_is(data, at, le, "match") && n < MATCHES_MOST) {
            cur: Cursor = Cursor { at: at + 5, end: le };
            map_i0[s * MATCHES_MOST + n] = cursor_number(data, &cur);
            map_i1[s * MATCHES_MOST + n] = cursor_number(data, &cur);
            map_j[s * MATCHES_MOST + n] = cursor_number(data, &cur);
            n = n + 1
        }
        at = le + 1
    }
    map_n[s] = n;
    follow_links_stale();
    // (The rule may have waited for it: checked again at rest.)
    follow_part_came()
}

map_slot(c: int): int {
    for s in 0..MAPS_MOST
        if (map_c[s] == c && c >= 0) return s;
    -1
}

follow_maps_forget() {
    for s in 0..MAPS_MOST map_c[s] = -1;
    follow_links_stale()
}

map_of(s: int): LinkMap@new {
    n: int = map_n[s];
    map: LinkMap = LinkMap {
        mode: map_mode[s],
        comments: map_comments[s],
        i0: new int[n](0),
        i1: new int[n](0),
        j: new int[n](0)
    };
    for k in 0..n {
        map.i0[k] = map_i0[s * MATCHES_MOST + k];
        map.i1[k] = map_i1[s * MATCHES_MOST + k];
        map.j[k] = map_j[s * MATCHES_MOST + k]
    }
    map
}

// ---- a chapter's shape in a pane, as laid out or guessed ----
// Each anchor's start where its part is in the window; where it isn't,
// guessed (SKINS.md, Panes: Linked): each part between it and one laid out
// as tall for its bytes (`sizes`) as the pane's parts measured so far are
// on average, the anchor as far down its part as its bytes into it. The
// chapter's top and end likewise. A chapter in a run of a commentary's
// without comments is the run's part, top to end. A chapter none of whose
// parts is laid out is placed from the window's nearer end (guessed_top).
shape_of(p: int, c: int): ChapterShape@new {
    pane: *Pane = pane_of(p);
    in_run: bool = c >= 0 && c < CHAPTERS_MOST && facts_of(p).gap_first[c] >= 0;
    n: int = if (in_run) 0 else anchor_count(p, c);
    shape: ChapterShape = ChapterShape {
        starts: new f64[n](0.0f64),
        known: new bool[n](false),
        top: 0.0f64,
        top_known: false,
        end: 0.0f64,
        end_known: false,
        em: type_of(p).em
    };
    first: int = row_chapter(p, c);
    count: int = if (in_run) 1 else part_count(p, first);
    if (count <= 0) return shape;
    // (Each part's top and end, laid out or guessed.)
    tops: []f64 = new f64[count](0.0f64);
    ends: []f64 = new f64[count](0.0f64);
    rows: []int = new int[count](-1);
    any: int = -1;
    for r in 0..pane.n {
        if (pane.chapter[r] <= c && c <= pane.last[r] && pane.part[r] < count) {
            rows[pane.part[r]] = r;
            tops[pane.part[r]] = pane.y[r];
            ends[pane.part[r]] = pane.y[r] + pane.h[r];
            if (any < 0) any = pane.part[r]
        }
    }
    per_byte: f64 = height_per_byte(p);
    // (None laid out: its top guessed from what is, its parts after it.)
    if (any < 0) {
        top: f64 = guessed_top(p, first);
        if (top == GUESS_NONE) return shape;
        tops[0] = top;
        ends[0] = top + parts_guessed(p, first, 0, 1);
        any = 0
    }
    for k in any + 1..count {
        if (rows[k] < 0) {
            tops[k] = ends[k - 1];
            ends[k] = tops[k] + part_bytes(p, first, k) as f64 * per_byte
        }
    }
    k: int = any - 1;
    while (k >= 0) {
        if (rows[k] < 0) {
            ends[k] = tops[k + 1];
            tops[k] = ends[k] - part_bytes(p, first, k) as f64 * per_byte
        }
        k = k - 1
    }
    shape.top = tops[0];
    shape.top_known = true;
    shape.end = ends[count - 1];
    shape.end_known = true;
    if (in_run) return shape;
    for r in 0..pane.n {
        if (pane.chapter[r] == c) {
            for j in 0..pane.anchors[r] {
                i: int = pane.anchor_first[r] + j;
                if (i < n) {
                    shape.starts[i] = pane.y[r] + pane.anchor_y[r * PART_ANCHORS_MOST + j];
                    shape.known[i] = true
                }
            }
        }
    }
    s: int = facts_slot(p, c);
    f: *Facts = facts_of(p);
    for i in 0..n {
        if (!shape.known[i] && s >= 0) {
            part: int = f.anchor_part[s * ANCHORS_MOST + i];
            if (part >= 0 && part < count) {
                shape.starts[i] = tops[part] + part_top_room(p, c, part) + f.anchor_bytes[s * ANCHORS_MOST + i] as f64 * per_byte;
                shape.known[i] = true
            }
        }
    }
    shape
}

// A part's height for a byte of its source, as the pane's parts measured
// so far are on average (a line's worth for every 60 bytes before any).
height_per_byte(p: int): f64 {
    f: *Facts = facts_of(p);
    if (f.measured_bytes > 0) f.measured_height / f.measured_bytes as f64 else type_of(p).em * look.spacing / 60.0f64
}

// ---- where chapters not laid out would be ----
// Chapter c's top down pane p's canvas, none of its parts laid out
// (SKINS.md, Panes: Linked): from the nearer end of what is, each part
// between as tall for its bytes as the parts measured so far are on
// average; a chapter whose sizes aren't known, as tall as a part laid out
// is on average. GUESS_NONE: too far to say (a few hundred chapters).
GUESS_NONE: f64 = -1.0e18f64;

guessed_top(p: int, c: int): f64 {
    pane: *Pane = pane_of(p);
    if (pane.n == 0) return GUESS_NONE;
    last: int = pane.n - 1;
    if (c > pane.last[last]) {
        y: f64 = pane.y[last] + pane.h[last];
        first: int = pane.chapter[last];
        y = y + parts_guessed(p, first, pane.part[last] + 1, part_count(p, first));
        ch: int = pane.last[last] + 1;
        steps: int = 0;
        while (ch < c && steps < 400) {
            y = y + chapter_guessed(p, ch);
            ch = ch + 1;
            steps = steps + 1
        }
        return if (ch < c) GUESS_NONE else y
    }
    if (c < pane.chapter[0]) {
        y: f64 = pane.y[0] - parts_guessed(p, pane.chapter[0], 0, pane.part[0]);
        ch: int = pane.chapter[0] - 1;
        steps: int = 0;
        while (ch >= c && steps < 400) {
            y = y - chapter_guessed(p, ch);
            ch = ch - 1;
            steps = steps + 1
        }
        return if (ch >= c) GUESS_NONE else y
    }
    GUESS_NONE
}

// Parts from to to of chapter c, guessed.
parts_guessed(
    p: int,
    c: int,
    from: int,
    to: int
): f64 {
    h: f64 = 0.0f64;
    known: bool = facts_slot(p, c) >= 0;
    per_byte: f64 = height_per_byte(p);
    for k in from..to h = h + (if (known) part_bytes(p, c, k) as f64 * per_byte else part_height_average(p));
    h
}

// Chapter c, guessed: a run's part counts once, at its first chapter.
chapter_guessed(p: int, c: int): f64 {
    if (c < 0 || c >= CHAPTERS_MOST) return 0.0f64;
    f: *Facts = facts_of(p);
    if (f.gap_first[c] >= 0 && f.gap_first[c] != c) return 0.0f64;
    if (facts_slot(p, c) < 0) return part_height_average(p);
    parts_guessed(p, c, 0, part_count(p, c))
}

// A part laid out in pane p, on average.
part_height_average(p: int): f64 {
    pane: *Pane = pane_of(p);
    if (pane.n == 0) return pane_screen(pane);
    h: f64 = 0.0f64;
    for r in 0..pane.n h = h + pane.h[r];
    h / pane.n as f64
}

// The part guessed to hold y down pane p's canvas, beyond its window (by
// the same guesses as guessed_top): its chapter (a run's first), part, and
// where its top would be.
type GuessAt = {
    c: int;
    k: int;
    top: f64;
    ok: bool
}

guessed_part_at(p: int, y: f64): GuessAt {
    pane: *Pane = pane_of(p);
    none: GuessAt = GuessAt {
        c: -1,
        k: 0,
        top: 0.0f64,
        ok: false
    };
    if (pane.n == 0) return none;
    last: int = pane.n - 1;
    steps: int = 0;
    if (y >= pane.y[last] + pane.h[last]) {
        at: f64 = pane.y[last] + pane.h[last];
        next: PartAt = part_after(p, pane.chapter[last], pane.part[last]);
        while (next.c >= 0 && steps < 4000) {
            h: f64 = part_guessed(p, next.c, next.k);
            if (y < at + h) return GuessAt {
                c: next.c,
                k: next.k,
                top: at,
                ok: true
            };
            at = at + h;
            next = part_after(p, next.c, next.k);
            steps = steps + 1
        }
        return none
    }
    if (y < pane.y[0]) {
        at: f64 = pane.y[0];
        before: PartAt = part_before(p, pane.chapter[0], pane.part[0]);
        while (before.c >= 0 && steps < 4000) {
            h: f64 = part_guessed(p, before.c, before.k);
            at = at - h;
            if (y >= at) return GuessAt {
                c: before.c,
                k: before.k,
                top: at,
                ok: true
            };
            before = part_before(p, before.c, before.k);
            steps = steps + 1
        }
    }
    none
}

// Part k of chapter c, guessed: as tall for its bytes as those measured,
// or, its chapter's sizes not known, as a part laid out on average.
part_guessed(p: int, c: int, k: int): f64 {
    if (facts_slot(p, c) < 0) return part_height_average(p);
    part_bytes(p, c, k) as f64 * height_per_byte(p)
}

// ---- the links, kept ----
LINKS_MOST: int = 8192;

links: ?owned *FollowLinks = null;

links_stale: bool = true;

// The chapter the links were made about.
links_about: int = -1;

follow_links_stale() {
    links_stale = true
}

// The links of the chapters about chapter c (two either side), made
// again if stale or made about another.
links_make(c: int) {
    if (!links_stale && links_about == c && links != null) return;
    drop links;
    links = own {
        made: *FollowLinks = new FollowLinks {
            top_from: new f64[LINKS_MOST](0.0f64),
            top_to: new f64[LINKS_MOST](0.0f64),
            bottom_from: new f64[LINKS_MOST](0.0f64),
            bottom_to: new f64[LINKS_MOST](0.0f64),
            n: 0
        };
        region {
            for d in 0..5 {
                ch: int = c - 2 + d;
                s: int = map_slot(ch);
                if (s >= 0) {
                    map: LinkMap = map_of(s);
                    page: ChapterShape = shape_of(PANE_PAGE, ch);
                    panel: ChapterShape = shape_of(PANE_PANEL, ch);
                    follow_links_add(made, &map, &page, &panel)
                }
            }
        }
        made
    };
    links_stale = false;
    links_about = c
}

// ---- following ----
// Whether the panes can follow now: linked, both laid out, no jump
// holding them, the panel in sight.
follow_can(): bool {
    linked && !jump_held && page_pane.n > 0 && panel_pane.n > 0 && panel_pane.scroll != 0 && panel_shown()
}

// The chapter at pane p's top edge (-1: none).
edge_chapter(p: int): int {
    pane: *Pane = pane_of(p);
    r: int = row_at(pane, pane_top(pane));
    if (r < 0) -1 else pane.chapter[r]
}

// Where the follower is to go for the leader now (the top of its sight),
// or nowhere.
follow_target(lead: int): FollowMove {
    c: int = edge_chapter(lead);
    if (c < 0) return FollowMove.Stay;
    // (The sections it is about known first: the other pane's anchors of
    // the edge's chapter, asked for if not.)
    s: int = map_slot(c);
    // (Its chapter's map not come yet (core sends those about the places
    // it is told): the rule checked again when it comes.)
    if (s < 0) {
        follow_pending = true;
        return FollowMove.Stay
    }
    if (map_n[s] > 0 && !anchors_known(1 - lead, c)) {
        follow_pending = true;
        return FollowMove.Stay
    }
    links_make(c);
    page: *Pane = pane_of(PANE_PAGE);
    panel: *Pane = pane_of(PANE_PANEL);
    move: FollowMove = FollowMove.Stay;
    borrow links as made {
        move = (if (lead == PANE_PAGE) follow_bottom_move(made, pane_top(page), pane_top(panel),
            pane_seen(panel)) else follow_top_move(made, pane_top(page), pane_seen(page),
            pane_top(panel), pane_seen(panel)))
    }
    move
}

// The leader moved (a hand, its fling): the other put where the rule
// says, at most every FOLLOW_EVERY seconds (the last move in each told at
// its end).
FOLLOW_EVERY: f64 = 0.25f64;

follow_time: f64 = 0.0f64;

follow_moved(p: int) {
    if (!follow_can() || p != leader) return;
    since: f64 = CACurrentMediaTime() - follow_time;
    if (since >= FOLLOW_EVERY) {
        follow_time = CACurrentMediaTime();
        follow_apply(p)
    } else follow_tick_soon(FOLLOW_EVERY - since)
}

follow_tick_due: bool = false;

follow_tick_soon(after: f64) {
    if (follow_tick_due || pane_delegate == 0) return;
    follow_tick_due = true;
    _t: int = timer_after(pane_delegate, after, "vellumFollowTick:")
}

follow_tick_fired(_self: int, _cmd: int, _timer: int): int {
    follow_tick_due = false;
    if (!follow_can()) return 0;
    follow_time = CACurrentMediaTime();
    follow_apply(leader);
    0
}

// (The rule's last word, for the development wire: 0 stay, 1 move.)
follow_last: int = -1;

follow_apply(lead: int) {
    match follow_target(lead) {
        Stay -> follow_last = 0;
        ScrollTo target -> {
            follow_last = 1;
            other: int = 1 - lead;
            to: f64 = target.top - pane_of(other).chrome_top;
            // (A move of more than a couple of points cross-faded: what it
            // showed laid over it as it moves, fading in a fifth of a
            // second, within the quarter before the next.)
            far: bool = follow_far(other, target.top);
            faded: bool = (far || abs_f(to - pane_offset(pane_of(other))) > 2.0f64) && !reduce_motion() && pane_of(other).cover == 0;
            if (faded) pane_cover(other);
            // (More than a screen past what it has laid out (a Bible flung
            // beside a commentary's long comments): its window made anew at
            // the part guessed to hold the rule's place, there, and the rule
            // asked again of what is laid out now, until it is near (a few
            // times at most); then taken.)
            if (far) {
                // (Each time the window is made anew the pane is at the
                // place guessed; the rule's place after is of the new
                // window, and taken once near.)
                place: f64 = target.top;
                tries: int = 0;
                while (tries < 3) {
                    follow_window_anew_at(other, place, lead);
                    tries = tries + 1;
                    match follow_target(lead) {
                        Stay -> tries = 3;
                        ScrollTo again -> {
                            place = again.top;
                            if (!follow_far(other, place)) {
                                follow_place(other, place - pane_of(other).chrome_top);
                                tries = 3
                            }
                        }
                    }
                }
                _seen: bool = pane_fill(other, 0.0f64, 12)
            } else follow_place(other, to);
            if (faded) pane_uncover(other)
        }
    }
}

// Whether top is more than a screen past what pane p has laid out.
follow_far(p: int, top: f64): bool {
    pane: *Pane = pane_of(p);
    if (pane.n == 0) return false;
    screen: f64 = pane_screen(pane);
    top < pane.y[0] - screen || top > pane.y[pane.n - 1] + pane.h[pane.n - 1] + screen
}

// Pane p's window made anew at the part guessed to hold top (its canvas
// moved so that the place stays where it was guessed to be), else at its
// first section on the verse at the leader's reading line.
follow_window_anew_at(p: int, top: f64, lead: int) {
    g: GuessAt = guessed_part_at(p, top);
    if (!g.ok) {
        follow_window_anew(p, lead);
        return
    }
    pane: *Pane = pane_of(p);
    pane_window_at(p, g.c, g.k);
    pane_set_offset(p, PANE_MIDDLE + (top - g.top) - pane.chrome_top);
    follow_links_stale()
}

// Pane p's window made anew at its first section on the verse at the
// leader's reading line (its chapter's top, if it has none on it).
follow_window_anew(p: int, lead: int) {
    at: Place = pane_place(lead);
    c: int = if (at.ok) at.c else edge_chapter(lead);
    if (c < 0) return;
    v: int = if (at.ok && at.i >= 0) anchor_verse(lead, c, at.i) else 0;
    i: int = if (v > 0) anchor_of_verse(p, c, v) else -1;
    pane_put(p, c, i, 0, false);
    follow_links_stale()
}

// The follower put at offset to, its window filled about it.
follow_place(p: int, to: f64) {
    pane: *Pane = pane_of(p);
    pane_aim_let_go(p);
    pane_set_offset(p, to);
    // (Gone past what it had laid out: parts made toward its sight, enough
    // to cover it now, a margin about it later.)
    _seen: bool = pane_fill(p, 0.0f64, 12);
    _full: bool = pane_fill(p, pane_seen(pane), 2);
    pane_tell(p, false)
}

// A hand took pane p: it leads.
follow_lead(p: int) {
    leader = p;
    jump_held = false;
    ruled = false
}

// Pane p at rest: once both rest, the rule checked again.
follow_rested(_p: int) {
    if (!follow_can() || pane_in_motion(PANE_PAGE) || pane_in_motion(PANE_PANEL)) return;
    follow_apply(leader)
}

// A jump (`go`): MODE 2, the panel to be placed by the rule; else both
// held where their jumps put them.
follow_jumped(p: int, mode: int) {
    if (p == PANE_PANEL && mode == 2) {
        ruled = true;
        jump_held = false;
        leader = PANE_PAGE;
        if (follow_can()) follow_apply(PANE_PAGE);
        return
    }
    jump_held = true;
    ruled = false
}

// Between frames, at rest: the panel placed by the rule while it is ruled
// (parts come in and tell where sections are better).
follow_settled() {
    if (ruled && linked && page_pane.n > 0 && panel_pane.n > 0 && panel_shown()) {
        follow_apply(PANE_PAGE);
        return
    }
    // (What the rule waited for came, or parts came of themselves, as a
    // commentary's still opening come once read: the rule checked again.)
    if (!follow_pending || !follow_can() || pane_in_motion(PANE_PAGE) || pane_in_motion(PANE_PANEL)) return;
    follow_pending = false;
    follow_apply(leader)
}

// Whether the rule is to be checked again once the panes rest.
follow_pending: bool = false;

// A part came that wasn't asked for (sent again, once read): the rule
// checked again at rest.
follow_part_came() {
    if (!linked) return;
    follow_pending = true;
    pane_settle_soon()
}

add_linking_methods(delegate: int) {
    add_method1(delegate, sel("vellumFollowTick:"), &follow_tick_fired, "v@:@")
}
