tag bible_ios;

use_tag std, ios, bible;

// The sheets over the reader: the passage picker (books, chapters, a
// reference typed), search, the library (highlights, notes, bookmarks), the
// reading settings, and the note editor. Their tables' data come from the
// app's object, as the reader's do; each table is told apart by which it is.
import "../ios/objc.l8";

import "text.l8";

books_class: int = 0;

search_class: int = 0;

note_class: int = 0;

// The sheets' tables (0 when not shown).
picker_table: int = 0;

lib_table: int = 0;

search_table: int = 0;

settings_table: int = 0;

// The controllers of the library and search (for their empty states).
lib_vc: int = 0;

search_vc: int = 0;

settings_nav: int = 0;

// ---- sheets ----
// A navigation controller of root, as a sheet with a grabber: detents
// (0 large, 1 medium and large starting large, 2 medium only).
sheet_of(root: int, detents: int): int {
    sheet_nav: int = msg1(msg(sheet_nav_class, sel("alloc")), sel("initWithRootViewController:"),
        root);
    sheet: int = msg(sheet_nav, sel("sheetPresentationController"));
    if (sheet != 0) {
        msg1(sheet, sel("setPrefersGrabberVisible:"), 1);
        det: int = cls("UISheetPresentationControllerDetent");
        if (detents == 1) {
            one[0] = msg(det, sel("mediumDetent"));
            one[1] = msg(det, sel("largeDetent"));
            msg1(sheet, sel("setDetents:"), nsarray(one, 2));
            msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierLarge"))
        } else if (detents == 2) {
            one[0] = msg(det, sel("mediumDetent"));
            msg1(sheet, sel("setDetents:"), nsarray(one, 1));
            msg1(sheet, sel("setLargestUndimmedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierMedium"));
            msg1(sheet, sel("setPrefersScrollingExpandsWhenScrolledToEdge:"), 0)
        }
    }
    msg1(msg(sheet_nav, sel("presentationController")), sel("setDelegate:"), app_obj);
    msg(sheet_nav, sel("autorelease"))
}

// A system bar button (0 Done, 1 Cancel, 16 Trash) sending action to the app.
system_item(kind: int, action: str): int {
    msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        kind, app_obj, sel(action)), sel("autorelease"))
}

// A sheet over the reader, its bar expanding alongside (never a sheet
// over a collapsed bar).
present(vc: int) {
    // (A sheet over the reader is a rest of its: DESIGN.md Â§11.1.1.)
    reading_rest_now();
    bar_expand();
    keep_screen_release();
    msg3(nav, sel("presentViewController:animated:completion:"), vc, 1, 0)
}

close_sheet(_self: int, _cmd: int, _sender: int): int {
    dismiss_sheets();
    0
}

dismiss_sheets() {
    if (presented() != 0) {
        sheet_gone();
        msg2(nav, sel("dismissViewControllerAnimated:completion:"), 1, 0)
    }
}

// A sheet swiped away (or closed): what it held let go, and a note saved.
sheet_dismissed(_self: int, _cmd: int, controller: int): int {
    // (Practice swiped away: its playback and keyboard stopped.)
    if (practice_is(controller)) {
        practice_close(false);
        return 0
    }
    if (note_tv != 0) {
        save_note_editor();
        note_tv = 0
    }
    // (A sheet over another swiped away: the one under it stays.)
    if (presented() != 0 && (msg(presented(), sel("isBeingDismissed")) & 255) == 0) {
        if (lib_table != 0) {
            lib_build();
            lib_reload(false)
        }
        return 0
    }
    sheet_gone();
    0
}

sheet_gone() {
    if (note_tv != 0) {
        save_note_editor();
        note_tv = 0
    }
    if (search_table != 0) remember_search();
    picker_table = 0;
    lib_table = 0;
    search_table = 0;
    settings_table = 0;
    lib_vc = 0;
    lib_header_gone();
    lib_search = 0;
    lib_sort_button = 0;
    search_vc = 0;
    settings_nav = 0;
    study_table = held(study_table, 0);
    grammar_table = held(grammar_table, 0);
    conc_table = held(conc_table, 0);
    conc_search = 0;
    release(ack_table);
    ack_table = 0;
    changes_table = held(changes_table, 0);
    il_scroll = 0;
    il_vi = -1;
    search_bar = 0;
    picker_search = 0;
    hist_table = held(hist_table, 0);
    hist_vc = held(hist_vc, 0);
    lib_filter_row = 0;
    daily_sheet_gone();
    ribbons_sheet_gone();
    lib_all_button = 0;
    release(versions_table);
    versions_table = 0;
    versions_vc = 0;
    compare_gone();
    xref_table = held(xref_table, 0);
    study_sheet_gone();
    memory_sheet_gone();
    learn_sheet_gone();
    if (px_nav != 0) practice_gone();
    origin_v = 0
}

// A table for a sheet (style 0 plain, 2 inset grouped), its data from the
// app; its controller, of class c.
sheet_table(c: int, style: int, title: str): int {
    vc: int = msg(msg1(msg(c, sel("alloc")), sel("initWithStyle:"), style), sel("autorelease"));
    msg1(vc, sel("setTitle:"), nsstring(title));
    t: int = msg(vc, sel("tableView"));
    msg1(t, sel("setDataSource:"), app_obj);
    msg1(t, sel("setDelegate:"), app_obj);
    msg1(msg(vc, sel("navigationItem")), sel("setRightBarButtonItem:"), system_item(0,
        "closeSheet:"));
    vc
}

// The theme's colors on a sheet's table.
style_table(t: int, grouped: bool) {
    if (t == 0) return;
    msg1(t, sel("setBackgroundColor:"), if (grouped) sheet_bg() else c_bg)
}

style_sheets() {
    style_table(picker_table, true);
    style_table(lib_table, true);
    style_table(search_table, false);
    style_table(settings_table, true);
    style_table(detail_table, true);
    for t in [picker_table, lib_table, search_table, settings_table, detail_table]
        if (t != 0) msg(t, sel("reloadData"));
    style_ribbon_sheets();
    style_memory_sheets();
    style_learn_sheets();
    style_practice();
    for t in [plans_table, day1_table] {
        if (t != 0) {
            style_table(t, true);
            msg(t, sel("reloadData"))
        }
    }
    // (Round 4's lists, open when Auto turns to Night: Compare, Versions,
    // the acknowledgements.)
    for t in [compare_table, versions_table, ack_table] {
        if (t != 0) {
            style_table(t, true);
            msg(t, sel("reloadData"))
        }
    }
}

// A list cell (UIListContentConfiguration: 0 cell, 1 value, 2 subtitle).
list_cell(t: int, id: str, _kind: int): int {
    cell: int = msg1(t, sel("dequeueReusableCellWithIdentifier:"), nsstring(id));
    if (cell == 0) cell = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, nsstring(id)), sel("autorelease"));
    msg1(cell, sel("setAccessoryType:"), 0);
    msg1(cell, sel("setAccessoryView:"), 0);
    msg1(cell, sel("setBackgroundColor:"), if (t == search_table || t == conc_table && t != 0) c_bg else cell_bg());
    cell
}

list_config(kind: int): int {
    u: int = cls("UIListContentConfiguration");
    if (kind == 1) return msg(u, sel("valueCellConfiguration"));
    if (kind == 2) return msg(u, sel("subtitleCellConfiguration"));
    msg(u, sel("cellConfiguration"))
}

text_props(config: int): int {
    msg(config, sel("textProperties"))
}

detail_props(config: int): int {
    msg(config, sel("secondaryTextProperties"))
}

// A config's image: a symbol, tinted. A row's own icon (17 points, the
// body's size) follows the body text style, so it grows with Dynamic
// Type as system lists' do (review r6-1).
config_image(
    config: int,
    name: str,
    size: f64,
    color: int
) {
    if (size == 17.0f64) {
        sc: int = msg1(cls("UIImageSymbolConfiguration"), sel("configurationWithTextStyle:"),
            objc_const("UIFontTextStyleBody"));
        image: int = msg2(cls("UIImage"), sel("systemImageNamed:withConfiguration:"),
            nsstring(name), sc);
        if (image != 0 && color != 0) image = msg2(image, sel("imageWithTintColor:renderingMode:"),
            color, 1);
        msg1(config, sel("setImage:"), image)
    } else msg1(config, sel("setImage:"), symbol(name, size, 4, color));
    msg1(msg(config, sel("imageProperties")), sel("setTintColor:"), color)
}

book_name(b: int): int {
    nsstring_at(bytes_address(bsb) + book_name_start(b), book_name_end(b) - book_name_start(b))
}

// The empty state of a controller: a symbol, a title and a line (none, if
// name is empty).
empty_state(
    vc: int,
    t: int,
    name: str,
    title: int,
    line: str
) {
    u: int = cls("UIContentUnavailableConfiguration");
    if (u != 0) {
        if (len(name) == 0) {
            msg1(vc, sel("setContentUnavailableConfiguration:"), 0);
            return
        }
        config: int = msg(u, sel("emptyConfiguration"));
        msg1(config, sel("setImage:"), symbol(name, 40.0f64, 4, 0));
        msg1(config, sel("setText:"), title);
        msg1(config, sel("setSecondaryText:"), nsstring(line));
        msg1(vc, sel("setContentUnavailableConfiguration:"), config);
        return
    }
    if (len(name) == 0) {
        msg1(t, sel("setBackgroundView:"), 0);
        return
    }
    label: int = make("UILabel");
    msg1(label, sel("setText:"), title);
    msg1(label, sel("setTextAlignment:"), 1);
    msg1(label, sel("setTextColor:"), c_faint);
    msg1(t, sel("setBackgroundView:"), label);
    release(label)
}

// ---- the passage picker ----
show_picker(_self: int, _cmd: int, _sender: int): int {
    open_picker();
    0
}

picker_search: int = 0;

// What is typed in the picker's search field.
pq: []i8 = new i8[256](0i8);

pq_n: int = 0;

// The picker's recent places (chapters, newest first), and with a query:
// whether it is a reference, and the books it begins.
pk_recent: int = 0;

pk_recent_c: []int = new int[4](0);

pk_recent_v: []int = new int[4](0);

// Whether Recent ends with Show All (history has more than 4 entries).
pk_show_all: bool = false;

pk_ref: bool = false;

pk_books: int = 0;

pk_book: []int = new int[8](0);

open_picker() {
    if (presented() != 0) return;
    vc: int = sheet_table(books_class, 2, "Go To");
    picker_table = msg(vc, sel("tableView"));
    style_table(picker_table, true);
    item: int = msg(vc, sel("navigationItem"));
    sc: int = msg1(msg(cls("UISearchController"), sel("alloc")), sel("initWithSearchResultsController:"),
        0);
    msg1(sc, sel("setObscuresBackgroundDuringPresentation:"), 0);
    msg1(sc, sel("setHidesNavigationBarDuringPresentation:"), 0);
    msg1(sc, sel("setSearchResultsUpdater:"), app_obj);
    bar: int = msg(sc, sel("searchBar"));
    msg1(bar, sel("setPlaceholder:"), nsstring("Book, chapter or verse \â\€\” \â\€\œjn 3:16\â\€\"));
    msg1(bar, sel("setAutocorrectionType:"), 1);
    msg1(bar, sel("setAutocapitalizationType:"), 0);
    msg1(bar, sel("setReturnKeyType:"), 1);
    msg1(bar, sel("setDelegate:"), app_obj);
    msg1(item, sel("setSearchController:"), sc);
    msg1(item, sel("setHidesSearchBarWhenScrolling:"), 0);
    picker_search = sc;
    release(sc);
    pq_n = 0;
    picker_appeared = false;
    today_build();
    pk_recent = 0;
    i: int = hs_n - 1;
    while (i >= 0 && pk_recent < 4) {
        c: int = hs_ch[i];
        // (Not the chapter read, nor one a ribbon's row shows: Â§11.2.1.)
        seen: bool = c == cur;
        for k in 0..rb_n
            if (rb_c[k] == c) seen = true;
        for j in 0..pk_recent
            if (pk_recent_c[j] == c) seen = true;
        if (!seen) {
            pk_recent_c[pk_recent] = c;
            pk_recent_v[pk_recent] = (if (hs_exact[i]) hs_v[i] else 0);
            pk_recent = pk_recent + 1
        }
        i = i - 1
    }
    pk_show_all = hs_n > 4 && pk_recent > 0;
    nav_sheet: int = sheet_of(vc, 0);
    msg1(msg(nav_sheet, sel("navigationBar")), sel("setPrefersLargeTitles:"), 1);
    present(nav_sheet)
}

// The picker's sections: 0 recent, 1 Old Testament, 2 New, 3 go to, 4
// books, 5 Ribbons, 6 Reading Plan; which the s-th is.
pk_kind(s_in: int): int {
    if (pq_n == 0) {
        // (Ribbons first, then Reading Plan: Â§11.2.1.)
        if (s_in == GT_RIBBONS_SECTION) return 5;
        if (s_in == GT_PLAN_SECTION) return 6;
        s: int = s_in - 2;
        k: int = if (pk_recent > 0) s else s + 1;
        return k
    }
    if (pk_ref) {
        if (s_in == 0) return 3;
        return 4
    }
    4
}

pk_sections(): int {
    if (pq_n == 0) return (if (pk_recent > 0) 3 else 2) + 2;
    (if (pk_ref) 1 else 0) + (if (pk_books > 0) 1 else 0)
}

// The query typed: the reference it is, and the books it begins.
picker_query(text: int) {
    pq_n = nsstring_into(text, pq);
    pk_ref = pq_n > 0 && parse_ref(pq, pq_n);
    pk_books = 0;
    // (The books begun by the name typed, before its numbers.)
    name_n: int = pq_n;
    seen_letter: bool = false;
    for i in 0..pq_n {
        k: int = pq[i] as int;
        if (is_letter(k)) seen_letter = true;
        if (seen_letter && is_digit(k) && name_n == pq_n) name_n = i
    }
    if (pq_n > 0) {
        // (Exact short names first, then the books whose names begin so.)
        for pass in 0..2 {
            for b in 0..books {
                if (pk_books < 8 && book_begins(b, pq, name_n)) {
                    exact: bool = book_alias_exact(b);
                    if (exact == (pass == 0)) {
                        pk_book[pk_books] = b;
                        pk_books = pk_books + 1
                    }
                }
            }
        }
        // (The reference names its book again: once is enough, unless the
        // reference is the book alone.)
        if (pk_ref && ref_chapter < 0 && pk_books == 1 && pk_book[0] == ref_book) pk_books = 0
    }
    // (parse_ref again, as book_begins used its buffer.)
    if (pq_n > 0) pk_ref = parse_ref(pq, pq_n);
    msg(picker_table, sel("reloadData"));
    if (pq_n > 0 && pk_sections() == 0) empty_state(msg(msg(presented(), sel("viewControllers")),
        sel("firstObject")), picker_table, "magnifyingglass", nsstring("No Matches"),
        "") else empty_state(msg(msg(presented(), sel("viewControllers")), sel("firstObject")),
        picker_table, "", 0, "")
}

// The search controller's text changed: the picker's, or search's.
search_updated(_self: int, _cmd: int, sc: int): int {
    if (ln_search_updated(sc)) return 0;
    text: int = msg(msg(sc, sel("searchBar")), sel("text"));
    if (sc == picker_search && picker_table != 0) picker_query(text) else if (sc == lib_search && lib_table != 0) library_typed(text) else if (sc == conc_search && conc_table != 0) conc_filtered(text) else if (search_table != 0) search_typed(text);
    0
}

// Return in a search field: the picker's first suggestion; search's,
// kept as a recent search.
search_return(_self: int, _cmd: int, bar: int): int {
    if (picker_table != 0 && search_table == 0) {
        if (pk_ref) go_ref() else if (pk_books > 0) pick_book(pk_book[0])
    } else if (search_table != 0) {
        remember_search();
        msg(bar, sel("resignFirstResponder"))
    }
    0
}

scope_changed(
    _self: int,
    _cmd: int,
    _bar: int,
    scope: int
): int {
    sr_scope = scope;
    run_search();
    0
}

// The reference typed, gone to (a book alone: its chapters).
go_ref() {
    if (ref_chapter < 0) {
        pick_book(ref_book);
        return
    }
    jump(chapter_of(ref_book, ref_chapter), if (ref_verse > 0) ref_verse else 0)
}

pick_book(b: int) {
    if (book_count[b] == 1) jump(book_first[b], 0) else show_chapters(b)
}

// The books' list, first laid out: at the book being read.
books_layout(self: int, cmd: int): int {
    super0(self, books_class, cmd);
    list: int = msg(self, sel("tableView"));
    if (msg(list, sel("tag")) != 0) return 0;
    msg1(list, sel("setTag:"), 1);
    // (At the top while there is a ribbon or a plan followed, a tap away;
    // without, at the book being read, as Â§3.2 says: DESIGN.md Â§10.7a-4,
    // Â§11.2.1.)
    if (today_has()) return 0;
    b: int = ch_book[cur];
    // (Not if the recent places are showing and the book is near the top.)
    if (pk_recent > 0 && b < 6) return 0;
    path: int = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), if (b < 39) b else b - 39,
        (if (b < 39) 0 else 1) + (if (pk_recent > 0) 1 else 0) + 2);
    msg3(list, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), path, 2,
        0);
    0
}

picker_rows(s: int): int {
    k: int = pk_kind(s);
    if (k == 5) return ribbons_rows();
    if (k == 6) return plan_rows();
    if (k == 0) return pk_recent + (if (pk_show_all) 1 else 0);
    if (k == 1) return 39;
    if (k == 2) return books - 39;
    if (k == 3) return 1;
    pk_books
}

picker_header(s: int): int {
    k: int = pk_kind(s);
    if (k == 5) return ribbons_header();
    if (k == 6) return plan_header();
    nsstring(if (k == 0) "Recent" else if (k == 1) "Old Testament" else if (k == 2) "New Testament" else if (k == 3) "Go To" else "Books")
}

// ---- LORD and GOD in small capitals, outside the reader too ----
caps_buf: []i8 = new i8[4096](0i8);

caps_n: int = 0;

// The divine name at caps_buf[i] (as divine_at in text.l8): its length,
// or 0.
caps_divine(i: int): int {
    if (i > 0 && is_letter(caps_buf[i - 1] as int)) return 0;
    n: int = 0;
    if (caps_at(i, "LORD")) n = 4 else if (caps_at(i, "GOD")) n = 3;
    if (n == 0 || i + n < caps_n && is_letter(caps_buf[i + n] as int)) return 0;
    n
}

caps_at(i: int, word: str): bool {
    if (i + len(word) > caps_n) return false;
    for k in 0..len(word)
        if (caps_buf[i + k] != word[k]) return false;
    true
}

// The small capitals for a size: of the body (made smaller by hand, for
// fonts without their own), or of the system's font.
caps_font(serif_face: bool, size: f64): int {
    if (serif_face && caps_by_hand) return body(size * 0.8f64);
    if (serif_face) return small_caps(size);
    keys[0] = objc_const("UIFontFeatureTypeIdentifierKey");
    values[0] = msg1(cls("NSNumber"), sel("numberWithLong:"), 38);
    keys[1] = objc_const("UIFontFeatureSelectorIdentifierKey");
    values[1] = msg1(cls("NSNumber"), sel("numberWithLong:"), 1);
    one_object[0] = nsdictionary(keys, values, 2);
    keys[0] = objc_const("UIFontDescriptorFeatureSettingsAttribute");
    values[0] = nsarray(one_object, 1);
    d: int = msg1(msg(sans(size, 0.0f64), sel("fontDescriptor")), sel("fontDescriptorByAddingAttributes:"),
        nsdictionary(keys, values, 1));
    msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), d, size)
}

// LORD and GOD in text (an NSString at UTF-16 base in s) set in small
// capitals after their first letter.
caps_into(
    s: int,
    base: int,
    text: int,
    serif_face: bool,
    size: f64
) {
    caps_n = nsstring_into(text, caps_buf);
    f: int = 0;
    u: int = base;
    i: int = 0;
    while (i < caps_n) {
        d: int = caps_divine(i);
        if (d > 0) {
            if (f == 0) f = caps_font(serif_face, size);
            msg4(s, sel("addAttribute:value:range:"), k_font, f, u + 1, d - 1);
            if (serif_face && caps_by_hand) msg4(s, sel("addAttribute:value:range:"),
                k_kern, nsnumber_f(size * 0.02f64), u + 1, d - 1);
            i = i + d;
            u = u + d
        } else {
            k: int = caps_buf[i] as int & 255;
            if (k < 128 || k >= 192) u = u + 1;
            if (k >= 240) u = u + 1;
            i = i + 1
        }
    }
}

// Text with attributes, its divine names in small capitals.
with_caps(
    text: int,
    attributes: int,
    serif_face: bool,
    size: f64
): int {
    s: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        text, attributes), sel("autorelease"));
    caps_into(s, 0, text, serif_face, size);
    s
}

// A verse's words for a list's second line: in the body's face or the
// system's, at a size and color.
// A Library row's size: size points at the default text size, scaled as
// the Subheadline style is (so the rows grow with Dynamic Type, in step
// with their state lines and headers).
lib_pt(size: f64): f64 {
    m: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleSubheadline"));
    if (m == 0) return size;
    msg_f(msg1(m, sel("scaledFontForFont:"), sans(size, 0.0f64)), sel("pointSize"))
}

preview(
    text: int,
    serif_face: bool,
    size: f64,
    color: int
): int {
    keys[0] = k_font;
    values[0] = (if (serif_face) body(size) else sans(size, 0.0f64));
    keys[1] = k_color;
    values[1] = color;
    with_caps(text, nsdictionary(keys, values, 2), serif_face, size)
}

// The first words of a verse (about 40 characters) as an NSString.
opening_words(c: int, v: int, most: int): int {
    // (The current version's, or the BSB's under the ESV.)
    _n: int = verse_text_of(quote_base(), c, if (v > 0) v else 1);
    n: int = vt_n;
    if (n > most) {
        n = most;
        while (n > 0 && vt[n] as int != 32) n = n - 1;
        if (n == 0) n = most;
        fbuf_n = 0;
        for i in 0..n fput(vt[i] as int);
        fput_str("\â\€\¦");
        return fstring()
    }
    nsstring_of(vt, n)
}

// A chapter (and verse) as an NSString: John 3:16.
place_name(c: int, v: int): int {
    fbuf_n = 0;
    if (v > 0) {
        one_verse[0] = v;
        put_ref(c, one_verse, 1)
    } else put_ref(c, one_verse, 0);
    fstring()
}

one_verse: []int = new int[1](0);

picker_cell(t: int, path: int): int {
    s: int = msg(path, sel("section"));
    r: int = msg(path, sel("row"));
    k: int = pk_kind(s);
    if (k == 5) return ribbons_cell(t, r);
    if (k == 6) return plan_cell(t, r);
    if (k == 0 && r == pk_recent) {
        // Show All: the history.
        cell: int = list_cell(t, "showall", 0);
        config: int = list_config(0);
        msg1(config, sel("setText:"), nsstring("Show All"));
        msg1(text_props(config), sel("setColor:"), c_accent);
        msg1(cell, sel("setContentConfiguration:"), config);
        msg1(cell, sel("setAccessoryType:"), 1);
        return cell
    }
    if (k == 0) {
        cell: int = list_cell(t, "recent", 2);
        config: int = list_config(2);
        c: int = pk_recent_c[r];
        v: int = pk_recent_v[r];
        msg1(config, sel("setText:"), place_name(c, v));
        msg1(config, sel("setSecondaryAttributedText:"), preview(opening_words(c,
            v, 40), false, 15.0f64, c_faint));
        msg1(text_props(config), sel("setColor:"), c_ink);
        msg1(detail_props(config), sel("setColor:"), c_faint);
        msg1(detail_props(config), sel("setNumberOfLines:"), 1);
        config_image(config, "clock.arrow.circlepath", 17.0f64, c_faint);
        msg1(cell, sel("setContentConfiguration:"), config);
        return cell
    }
    if (k == 3) {
        cell: int = list_cell(t, "goto", 2);
        config: int = list_config(2);
        b: int = ref_book;
        if (ref_chapter < 0) {
            msg1(config, sel("setText:"), book_name(b));
            fbuf_n = 0;
            fput_int(book_count[b]);
            fput_str(if (book_count[b] == 1) " chapter" else " chapters");
            msg1(config, sel("setSecondaryText:"), fstring());
            msg1(cell, sel("setAccessoryType:"), 1)
        } else {
            c: int = chapter_of(b, ref_chapter);
            if (ref_verse > 0) {
                fbuf_n = 0;
                put_range_ref(c, ref_verse, if (ref_verse_end > 0) ref_verse_end else ref_verse);
                msg1(config, sel("setText:"), fstring());
                msg1(config, sel("setSecondaryAttributedText:"), preview(opening_words(c,
                    ref_verse, 60), false, 15.0f64, c_faint))
            } else {
                msg1(config, sel("setText:"), place_name(c, 0));
                fbuf_n = 0;
                fput_str("Chapter ");
                fput_int(ref_chapter);
                fput_str(" \Â\· ");
                fput_int(ch_verses[c]);
                fput_str(" verses");
                msg1(config, sel("setSecondaryText:"), fstring())
            }
        }
        msg1(text_props(config), sel("setFont:"), sans(17.0f64, 0.3f64));
        msg1(text_props(config), sel("setColor:"), c_ink);
        msg1(detail_props(config), sel("setColor:"), c_faint);
        msg1(detail_props(config), sel("setNumberOfLines:"), 2);
        config_image(config, "arrow.right.circle.fill", 22.0f64, c_accent);
        msg1(cell, sel("setContentConfiguration:"), config);
        return cell
    }
    b: int = if (k == 1) r else if (k == 2) r + 39 else pk_book[r];
    cell: int = list_cell(t, "book", 1);
    config: int = list_config(1);
    msg1(config, sel("setText:"), book_name(b));
    msg1(config, sel("setSecondaryText:"), nsnumber_text(book_count[b]));
    here: bool = b == ch_book[cur];
    msg1(text_props(config), sel("setColor:"), if (here) c_accent else c_ink);
    if (here) msg1(text_props(config), sel("setFont:"), sans(17.0f64, 0.3f64));
    msg1(detail_props(config), sel("setColor:"), c_faint);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryType:"), if (book_count[b] > 1) 1 else 0);
    cell
}

number_buf: []i8 = new i8[24](0i8);

// A number as an NSString.
nsnumber_text(n: int): int {
    fbuf_n = 0;
    fput_int(n);
    fstring()
}

picker_picked(s: int, r: int) {
    k: int = pk_kind(s);
    if (k == 5) {
        ribbons_picked(r);
        return
    }
    if (k == 6) {
        plan_picked(r);
        return
    }
    if (k == 0 && r == pk_recent) {
        open_history();
        return
    }
    if (k == 0) {
        jump(pk_recent_c[r], pk_recent_v[r]);
        return
    }
    if (k == 3) {
        go_ref();
        return
    }
    pick_book(if (k == 1) r else if (k == 2) r + 39 else pk_book[r])
}

// ---- the chapters of a book, as a grid ----
picker_book: int = 0;

show_chapters(b: int) {
    show_chapters_mode(b, false)
}

// The grid of book b's chapters: Go To's (a tap goes there), or Begin At's
// (choosing, for New Ribbon or A Chapter a Day: a tap chooses it and pops,
// the chapter chosen filled). Its view's tag is the book (plus one), 1000
// more when choosing.
show_chapters_mode(b: int, choosing: bool) {
    picker_book = b;
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    width: f64 = view_width(msg(sheet_nav, sel("view")));
    cols: int = ((width - 40.0f64 + 10.0f64) / 66.0f64) as int;
    if (cols < 1) cols = 1;
    side: f64 = ((width - 40.0f64 - (cols - 1) as f64 * 10.0f64) / cols as f64) as int as f64;
    layout: int = make("UICollectionViewFlowLayout");
    msg_ff(layout, sel("setItemSize:"), side, side);
    msg_set_f(layout, sel("setMinimumInteritemSpacing:"), 9.0f64);
    msg_set_f(layout, sel("setMinimumLineSpacing:"), 10.0f64);
    msg_rect(layout, sel("setSectionInset:"), 20.0f64, 20.0f64, 32.0f64, 20.0f64);
    grid: int = msg1(msg(cls("UICollectionViewController"), sel("alloc")), sel("initWithCollectionViewLayout:"),
        layout);
    release(layout);
    msg1(grid, sel("setTitle:"), if (choosing) nsstring("Chapter") else book_name(b));
    msg1(msg(grid, sel("navigationItem")), sel("setLargeTitleDisplayMode:"), if (choosing) 2 else 0);
    msg1(msg(grid, sel("navigationItem")), sel("setRightBarButtonItem:"), system_item(0,
        "closeSheet:"));
    view: int = msg(grid, sel("collectionView"));
    msg1(view, sel("setTag:"), b + 1 + (if (choosing) 1000 else 0));
    msg1(view, sel("setBackgroundColor:"), sheet_bg());
    msg2(view, sel("registerClass:forCellWithReuseIdentifier:"), cls("UICollectionViewCell"),
        nsstring("chapter"));
    msg1(view, sel("setDataSource:"), app_obj);
    msg1(view, sel("setDelegate:"), app_obj);
    msg2(sheet_nav, sel("pushViewController:animated:"), grid, 1);
    release(grid)
}

// A grid's book, and whether it is choosing (its view's tag).
grid_book(view: int): int {
    k: int = msg(view, sel("tag"));
    if (k <= 0) return picker_book;
    (k - 1) % 1000
}

grid_choosing(view: int): bool {
    msg(view, sel("tag")) > 1000
}

grid_items(
    _self: int,
    _cmd: int,
    view: int,
    _section: int
): int {
    book_count[grid_book(view)]
}

grid_cell(
    _self: int,
    _cmd: int,
    view: int,
    path: int
): int {
    cell: int = msg2(view, sel("dequeueReusableCellWithReuseIdentifier:forIndexPath:"),
        nsstring("chapter"), path);
    content: int = msg(cell, sel("contentView"));
    label: int = msg1(content, sel("viewWithTag:"), 7);
    if (label == 0) {
        l8_msg_hfa(hfa, content, sel("bounds"), 0, 0, 0);
        label = msg_rect(msg(cls("UILabel"), sel("alloc")), sel("initWithFrame:"),
            hfa[0], hfa[1], hfa[2], hfa[3]);
        msg1(label, sel("setTag:"), 7);
        msg1(label, sel("setAutoresizingMask:"), 18);
        msg1(label, sel("setTextAlignment:"), 1);
        msg1(content, sel("addSubview:"), label);
        release(label);
        layer: int = msg(content, sel("layer"));
        msg_set_f(layer, sel("setCornerRadius:"), 14.0f64);
        curve: int = objc_const("kCACornerCurveContinuous");
        if (curve != 0) msg1(layer, sel("setCornerCurve:"), curve);
        msg1(content, sel("setClipsToBounds:"), 1)
    }
    n: int = msg(path, sel("item"));
    here: bool = book_first[grid_book(view)] + n == (if (grid_choosing(view)) bg_c else cur);
    msg1(label, sel("setText:"), nsnumber_text(n + 1));
    msg1(label, sel("setFont:"), sans(19.0f64, 0.23f64));
    msg1(label, sel("setTextColor:"), if (here) on_accent() else c_ink);
    msg1(content, sel("setBackgroundColor:"), if (here) c_accent else cell_bg());
    cell
}

grid_picked(
    _self: int,
    _cmd: int,
    view: int,
    path: int
): int {
    c: int = book_first[grid_book(view)] + msg(path, sel("item"));
    if (grid_choosing(view)) bg_choose_chapter(c) else jump(c, 0);
    0
}

// ---- search ----
show_search(_self: int, _cmd: int, _sender: int): int {
    open_search();
    0
}

search_bar: int = 0;

// What was searched for (kept, for the next time), and in which scope (0
// all, 1 Old Testament, 2 New, 3 the book being read).
sr: []i8 = new i8[256](0i8);

sr_n: int = 0;

sr_scope: int = 0;

sr_book: int = 0;

// Whether the query is a reference (to go to), and what was searched.
sr_ref: bool = false;

sr_done: bool = false;

sr_timer: int = 0;

// What search shows now (1 results, 2 recent searches).
sr_shown_kind: int = 0;

open_search() {
    if (presented() != 0) return;
    vc: int = sheet_table(search_class, 0, "Search");
    search_vc = vc;
    search_table = msg(vc, sel("tableView"));
    style_table(search_table, false);
    l8_msg_hfa(hfa, search_table, sel("separatorInset"), 0, 0, 0);
    msg_rect(search_table, sel("setSeparatorInset:"), 0.0f64, 20.0f64, 0.0f64, 0.0f64);
    msg_set_f(search_table, sel("setSectionHeaderHeight:"), objc_const_f("UITableViewAutomaticDimension"));
    msg_set_f(search_table, sel("setEstimatedSectionHeaderHeight:"), 36.0f64);
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    sc: int = msg1(msg(cls("UISearchController"), sel("alloc")), sel("initWithSearchResultsController:"),
        0);
    msg1(sc, sel("setObscuresBackgroundDuringPresentation:"), 0);
    msg1(sc, sel("setHidesNavigationBarDuringPresentation:"), 0);
    msg1(sc, sel("setSearchResultsUpdater:"), app_obj);
    if ((msg1(sc, sel("respondsToSelector:"), sel("setScopeBarActivation:")) & 255) != 0) msg1(sc,
        sel("setScopeBarActivation:"), 1);
    msg1(sc, sel("setAutomaticallyShowsScopeBar:"), 0);
    // (The sheet has Done: no Cancel button popping in beside the field.)
    msg1(sc, sel("setAutomaticallyShowsCancelButton:"), 0);
    bar: int = msg(sc, sel("searchBar"));
    search_bar = bar;
    msg1(bar, sel("setPlaceholder:"), nsstring("Search the Bible"));
    msg1(bar, sel("setDelegate:"), app_obj);
    msg1(bar, sel("setAutocorrectionType:"), 1);
    sr_book = ch_book[cur];
    // (Short titles, so none is cut off; the full names for VoiceOver.)
    one[0] = nsstring("All");
    one[1] = scope_title("OT", "Old Testament");
    one[2] = scope_title("NT", "New Testament");
    one[3] = book_name(sr_book);
    if (book_name_end(sr_book) - book_name_start(sr_book) > 10) {
        book_short(sr_book);
        one[3] = nsstring_of(short_name, short_n);
        msg1(one[3], sel("setAccessibilityLabel:"), book_name(sr_book))
    }
    msg1(bar, sel("setScopeButtonTitles:"), nsarray(one, 4));
    msg1(bar, sel("setSelectedScopeButtonIndex:"), sr_scope);
    msg1(bar, sel("setShowsScopeBar:"), 1);
    msg1(bar, sel("setText:"), nsstring_of(sr, sr_n));
    msg1(item, sel("setSearchController:"), sc);
    msg1(item, sel("setHidesSearchBarWhenScrolling:"), 0);
    release(sc);
    // (Results scrolled away drag the keyboard down with them.)
    msg1(search_table, sel("setKeyboardDismissMode:"), 1);
    sr_shown_kind = 0;
    run_search();
    present(sheet_of(vc, 0))
}

// Search coming on screen: its field active, ready to type in, as the sheet
// rises (so the keyboard, the field's clear button and the scopes come with
// it, rather than popping in after).
search_appeared(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, search_class, cmd, animated);
    sc: int = msg(msg(self, sel("navigationItem")), sel("searchController"));
    if (sc != 0) msg(msg(sc, sel("searchBar")), sel("becomeFirstResponder"));
    0
}

// A scope's title (a new string, its full name for VoiceOver).
scope_title(title: str, full: str): int {
    t: int = msg1(msg(cls("NSString"), sel("alloc")), sel("initWithString:"), nsstring(title));
    msg1(t, sel("setAccessibilityLabel:"), nsstring(full));
    msg(t, sel("autorelease"))
}

// Typing: the search a moment after it stops.
search_typed(text: int) {
    n: int = nsstring_into(text, sr);
    if (n == 0 && sr_n > 0) remember_search();
    sr_n = n;
    sr_timer = stop_timer(sr_timer);
    if (sr_n == 0) run_search() else sr_timer = after(0.2f64, "searchFire:")
}

search_fire(_self: int, _cmd: int, _timer: int): int {
    sr_timer = 0;
    run_search();
    0
}

// The search, in its scope: the hits, the reference, and the empty state.
run_search() {
    sr_ref = false;
    sr_done = false;
    if (sr_n > 0) {
        sr_ref = parse_ref(sr, sr_n) && ref_chapter > 0;
        from: int = if (sr_scope == 2) 39 else if (sr_scope == 3) sr_book else 0;
        last: int = if (sr_scope == 1) 38 else if (sr_scope == 3) sr_book else 65;
        // (The version read, offline; the BSB's under the ESV, at once,
        // and the ESV itself a tap away.)
        was: int = text_cur;
        text_use(quote_base());
        search(sr, sr_n, from, last);
        text_use(was);
        sr_done = true
    }
    esv_sr_reset();
    if (search_table == 0) return;
    // (Recent searches giving way to results, or results to recent
    // searches: a cross-fade, not a jump.)
    kind: int = if (sr_n == 0) 2 else 1;
    if (kind != sr_shown_kind) fade_layer(msg(search_table, sel("layer")), 0.2f64);
    sr_shown_kind = kind;
    msg(search_table, sel("reloadData"));
    if (sr_n == 0) {
        if (recent_count() == 0) empty_state(search_vc, search_table, "magnifyingglass",
            nsstring("Search the Bible"), "Find words and phrases across all 66 books.") else empty_state(search_vc,
            search_table, "", 0, "")
    } else if (hit_count == 0 && !sr_ref && !esv_search_row()) {
        fbuf_n = 0;
        fput_str("No Results for \â\€\œ");
        for i in 0..sr_n fput(sr[i] as int);
        fput_str("\â\€\");
        empty_state(search_vc, search_table, "magnifyingglass", fstring(), "Check the spelling or try fewer words.")
    } else empty_state(search_vc, search_table, "", 0, "")
}

// ---- recent searches (in the defaults) ----
recent_list(): int {
    a: int = msg1(defaults(), sel("arrayForKey:"), nsstring("recentSearches"));
    if (a == 0) a = msg(cls("NSArray"), sel("array"));
    a
}

recent_count(): int {
    msg(recent_list(), sel("count"))
}

// The query searched for, first among the recent searches (8 kept).
remember_search() {
    if (sr_n == 0 || !sr_done) return;
    q: int = nsstring_of(sr, sr_n);
    a: int = msg(recent_list(), sel("mutableCopy"));
    msg1(a, sel("removeObject:"), q);
    msg2(a, sel("insertObject:atIndex:"), q, 0);
    while (msg(a, sel("count")) > 8) msg(a, sel("removeLastObject"));
    msg2(defaults(), sel("setObject:forKey:"), a, nsstring("recentSearches"));
    release(a)
}

clear_recent(_self: int, _cmd: int, _sender: int): int {
    msg1(defaults(), sel("removeObjectForKey:"), nsstring("recentSearches"));
    run_search();
    0
}

// Search's sections: 0 go to, 1 results, 2 recent searches, 3 the ESV's
// results (in place of 1, once asked for).
sr_kind(s: int): int {
    if (sr_n == 0) return 2;
    if (sr_ref && s == 0) return 0;
    if (esv_sr_on) 3 else 1
}

search_sections(): int {
    if (sr_n == 0) return if (recent_count() > 0) 1 else 0;
    (if (sr_ref) 1 else 0) + (if (hit_count > 0 || esv_search_row() || esv_sr_on) 1 else 0)
}

search_rows(s: int): int {
    k: int = sr_kind(s);
    if (k == 0) return 1;
    if (k == 2) return recent_count();
    if (k == 3) return esv_sr_prev() + esv_sr_n + esv_sr_more() + 1;
    hit_count + (if (esv_search_row()) 1 else 0)
}

// Whether the results end with "Search the ESV for â€¦" (or, under "No
// Results", are it): under the ESV, once it is listed.
esv_search_row(): bool {
    text_cur == TEXT_ESV && esv_listed() && sr_n > 0 && sr_done
}

search_header(s: int): int {
    k: int = sr_kind(s);
    if (k != 1 && k != 3) return 0;
    fbuf_n = 0;
    if (k == 1 && hit_count == 0) return nsstring("No Results");
    fput_int(if (k == 3) esv_sr_total else hit_count);
    if (k == 1 && hit_more) fput(43);
    fput_str(if ((if (k == 3) esv_sr_total else hit_count) == 1) " verse in the " else " verses in the ");
    fput_str(text_abbrs[if (k == 3) TEXT_ESV else quote_base()]);
    fstring()
}

// ---- the ESV's results (Â§9.4.8) ----
// Shown in place of the BSB's once asked for, one page of the server's at
// a time (at most 100, Â§9.4.1): each one's verse and words (the server's),
// the matches bold as ours are; and the request's state (0 none, 1 asking,
// else ios_esv.l8's) on the row that asks. The section's rows: "Previous
// Results" (after the first page), the results, "Show More" (before the
// last), and "(ESV) Â· esv.org".
esv_sr_on: bool = false;

esv_sr_state: int = 0;

esv_sr_n: int = 0;

esv_sr_total: int = 0;

esv_sr_page: int = 0;

esv_sr_pages: int = 0;

esv_sr_c: []int = new int[100](0);

esv_sr_v: []int = new int[100](0);

esv_sr_texts: int = 0;

esv_sr_prev(): int {
    if (esv_sr_page > 1) 1 else 0
}

esv_sr_more(): int {
    if (esv_sr_page < esv_sr_pages) 1 else 0
}

// What row r of the ESV's section is: -1 "Previous Results", a result's
// index, esv_sr_n "Show More", or esv_sr_n + 1 the ESV's line.
esv_sr_row(r: int): int {
    i: int = r - esv_sr_prev();
    if (i == esv_sr_n && esv_sr_more() == 0) esv_sr_n + 1 else i
}

esv_sr_reset() {
    esv_sr_on = false;
    esv_sr_state = 0;
    esv_sr_n = 0;
    esv_sr_page = 0;
    esv_sr_pages = 0;
    if (esv_sr_texts != 0) msg(esv_sr_texts, sel("removeAllObjects"))
}

// The ESV asked (page p of it).
esv_search_ask(p: int) {
    esv_sr_state = 1;
    esv_search(nsstring_of(sr, sr_n), p);
    if (search_table != 0) msg(search_table, sel("reloadData"))
}

// Its answer: the results on, or the row's line saying why not.
esv_search_answered(state: int, json: int) {
    if (search_table == 0) return;
    if (state != ESV_HERE || json == 0) {
        esv_sr_state = state;
        msg(search_table, sel("reloadData"));
        return
    }
    if (esv_sr_texts == 0) esv_sr_texts = keep(make("NSMutableArray"));
    // (A page in place of the one before it: never more shown at once.)
    esv_sr_n = 0;
    msg(esv_sr_texts, sel("removeAllObjects"));
    esv_sr_total = msg(msg1(json, sel("objectForKey:"), nsstring("total")), sel("longValue"));
    esv_sr_page = msg(msg1(json, sel("objectForKey:"), nsstring("page")), sel("longValue"));
    esv_sr_pages = msg(msg1(json, sel("objectForKey:"), nsstring("pages")), sel("longValue"));
    list: int = msg1(json, sel("objectForKey:"), nsstring("results"));
    if (list != 0) {
        for i in 0..msg(list, sel("count")) {
            r: int = msg1(list, sel("objectAtIndex:"), i);
            b: int = esv_book_of(msg1(r, sel("objectForKey:"), nsstring("book")));
            cn: int = msg(msg1(r, sel("objectForKey:"), nsstring("chapter")), sel("longValue"));
            k: int = msg(msg1(r, sel("objectForKey:"), nsstring("key")), sel("longValue"));
            text: int = msg1(r, sel("objectForKey:"), nsstring("text"));
            if (b >= 0 && cn >= 1 && cn <= book_count[b] && esv_sr_n < len(esv_sr_c) && text != 0) {
                esv_sr_c[esv_sr_n] = book_first[b] + cn - 1;
                esv_sr_v[esv_sr_n] = k;
                msg1(esv_sr_texts, sel("addObject:"), text);
                esv_sr_n = esv_sr_n + 1
            }
        }
    }
    esv_sr_on = true;
    esv_sr_state = 0;
    note_num("bible: esv search shown ", esv_sr_n);
    fade_layer(msg(search_table, sel("layer")), 0.2f64);
    msg(search_table, sel("reloadData"));
    // (The page from its top.)
    msg3(search_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"), msg2(cls("NSIndexPath"),
        sel("indexPathForRow:inSection:"), 0, if (sr_ref) 1 else 0), 1, 0)
}

// The row that asks: "Search the ESV for â€œborn againâ€", and why it could
// not, faint, under it.
esv_ask_cell(t: int): int {
    cell: int = list_cell(t, "esvask", 2);
    config: int = list_config(2);
    fbuf_n = 0;
    fput_str("Search the ESV for \â\€\œ");
    for i in 0..sr_n fput(sr[i] as int);
    fput_str("\â\€\");
    msg1(config, sel("setText:"), fstring());
    msg1(text_props(config), sel("setColor:"), c_accent);
    config_image(config, "globe", 17.0f64, c_accent);
    st: int = esv_sr_state;
    if (st >= ESV_OFFLINE || st == 1) {
        msg1(config, sel("setSecondaryText:"), nsstring(if (st == 1) "Searching\â\€\¦" else if (st == ESV_OFFLINE) "No connection" else if (st == ESV_BUSY) "Busy, try again in a minute" else if (st == ESV_DAILY) "Resting for today" else "Not available right now"));
        msg1(detail_props(config), sel("setColor:"), c_faint)
    }
    msg1(cell, sel("setContentConfiguration:"), config);
    cell
}

// An ESV result: its verse, and the server's words with ours bold; or the
// section's other rows.
esv_result_cell(t: int, row: int): int {
    r: int = esv_sr_row(row);
    if (r > esv_sr_n) {
        // (The ESV's line, a row after the last result: it scrolls with
        // them, never over them.)
        cell: int = fresh_cell(t);
        msg1(cell, sel("setBackgroundColor:"), c_bg);
        // (VoiceOver reaches its link.)
        msg1(cell, sel("setIsAccessibilityElement:"), 0);
        b: int = esv_footer_view();
        cv: int = msg(cell, sel("contentView"));
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(cv, sel("addSubview:"), b);
        for edge in ["leadingAnchor", "trailingAnchor", "topAnchor", "bottomAnchor"] pin(b,
            cv, edge);
        pin_size(b, "heightAnchor", 44.0f64);
        return cell
    }
    cell: int = list_cell(t, "hit", 2);
    config: int = list_config(2);
    if (r < 0 || r == esv_sr_n) {
        config2: int = list_config(0);
        msg1(config2, sel("setText:"), nsstring(if (r < 0) "Previous Results" else "Show More"));
        msg1(text_props(config2), sel("setColor:"), c_accent);
        msg1(text_props(config2), sel("setAlignment:"), 1);
        msg1(cell, sel("setContentConfiguration:"), config2);
        return cell
    }
    keys[0] = k_font;
    values[0] = sans(13.0f64, 0.3f64);
    keys[1] = k_color;
    values[1] = c_accent;
    a: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        place_name(esv_sr_c[r], esv_sr_v[r]), nsdictionary(keys, values, 2));
    msg1(config, sel("setAttributedText:"), a);
    release(a);
    vt_n = nsstring_into(msg1(esv_sr_texts, sel("objectAtIndex:"), r), vt);
    match_in_vt();
    msg1(config, sel("setSecondaryAttributedText:"), result_text_vt());
    msg1(detail_props(config), sel("setNumberOfLines:"), 4);
    msg1(detail_props(config), sel("setLineBreakMode:"), 4);
    msg_set_f(config, sel("setTextToSecondaryTextVerticalPadding:"), 3.0f64);
    msg_rect(config, sel("setDirectionalLayoutMargins:"), 12.0f64, 20.0f64, 12.0f64,
        20.0f64);
    msg1(cell, sel("setContentConfiguration:"), config);
    cell
}

// The recent searches' header: its title, and Clear.
search_header_view(s: int): int {
    if (sr_kind(s) != 2) return 0;
    v: int = msg(make("UIView"), sel("autorelease"));
    label: int = make("UILabel");
    msg1(label, sel("setText:"), nsstring("Recent Searches"));
    msg1(label, sel("setFont:"), sans(15.0f64, 0.4f64));
    msg1(label, sel("setTextColor:"), c_ink);
    msg1(label, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), label);
    release(label);
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setTitle:"), nsstring("Clear"));
    msg1(config, sel("setBaseForegroundColor:"), c_accent);
    b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("clearRecent:"),
        64);
    msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(v, sel("addSubview:"), b);
    pin_by(label, v, "leadingAnchor", 20.0f64);
    pin_by(label, v, "topAnchor", 14.0f64);
    pin_by(label, v, "bottomAnchor", -6.0f64);
    pin_by(b, v, "trailingAnchor", -8.0f64);
    pin_to(b, "centerYAnchor", label, "centerYAnchor", 0.0f64);
    msg1(v, sel("setBackgroundColor:"), c_bg);
    v
}

// A verse found: its words, the words searched for in full ink and bold
// (and washed), the rest softer; begun nearer the first if it is far in.
result_text(c: int, v: int): int {
    match_ranges(c, v);
    result_text_vt()
}

// The verse in vt, its matches found (mr_beginâ€¦): as result_text sets it.
result_text_vt(): int {
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    size: f64 = msg_f_f(metrics, sel("scaledValueForValue:"), 16.0f64);
    start: int = 0;
    if (mr_count > 0 && mr_begin[0] > 170) {
        // (Eight words before the first.)
        words: int = 0;
        start = mr_begin[0];
        while (start > 0 && words < 9) {
            start = start - 1;
            if (vt[start] as int == 32) words = words + 1
        }
        if (vt[start] as int == 32) start = start + 1
    }
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    keys[0] = k_font;
    values[0] = body(size);
    keys[1] = k_color;
    values[1] = msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64);
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.25f64), sel("autorelease"));
    msg1(values[2], sel("setLineBreakMode:"), 4);
    plain: int = nsdictionary(keys, values, 3);
    if (start > 0) {
        a: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
            nsstring("\â\€\¦ "), plain);
        msg1(s, sel("appendAttributedString:"), a);
        release(a)
    }
    lead: int = msg(s, sel("length"));
    a: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        nsstring_at(bytes_address(vt) + start, vt_n - start), plain);
    msg1(s, sel("appendAttributedString:"), a);
    release(a);
    caps_into(s, lead, nsstring_at(bytes_address(vt) + start, vt_n - start), true,
        size);
    bold_font: int = bold(size);
    for i in 0..mr_count {
        if (mr_begin[i] >= start) {
            b: int = lead + utf16_of(start, mr_begin[i]);
            n: int = utf16_of(mr_begin[i], mr_end[i]);
            msg4(s, sel("addAttribute:value:range:"), k_font, bold_font, b, n);
            msg4(s, sel("addAttribute:value:range:"), k_color, c_ink, b, n);
            msg4(s, sel("addAttribute:value:range:"), k_background, c_sel, b, n)
        }
    }
    s
}

// How many UTF-16 units vt's bytes p to e are.
utf16_of(p: int, e: int): int {
    n: int = 0;
    for i in p..e {
        k: int = vt[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    n
}

search_cell(t: int, path: int): int {
    // (Under the ESV, the BSB's words: what was searched.)
    was: int = text_cur;
    text_use(quote_base());
    cell: int = search_cell_in(t, path);
    text_use(was);
    cell
}

search_cell_in(t: int, path: int): int {
    s: int = msg(path, sel("section"));
    r: int = msg(path, sel("row"));
    k: int = sr_kind(s);
    if (k == 3) return esv_result_cell(t, r);
    if (k == 1 && r >= hit_count) return esv_ask_cell(t);
    if (k == 2) {
        cell: int = list_cell(t, "recent", 0);
        config: int = list_config(0);
        msg1(config, sel("setText:"), msg1(recent_list(), sel("objectAtIndex:"), r));
        msg1(text_props(config), sel("setColor:"), c_ink);
        config_image(config, "clock.arrow.circlepath", 17.0f64, c_faint);
        msg1(cell, sel("setContentConfiguration:"), config);
        return cell
    }
    if (k == 0) {
        cell: int = list_cell(t, "goto", 2);
        config: int = list_config(2);
        c: int = chapter_of(ref_book, ref_chapter);
        fbuf_n = 0;
        fput_str("Go to ");
        if (ref_verse > 0) put_range_ref(c, ref_verse, if (ref_verse_end > 0) ref_verse_end else ref_verse) else put_ref(c,
            one_verse, 0);
        msg1(config, sel("setText:"), fstring());
        msg1(config, sel("setSecondaryAttributedText:"), preview(opening_words(c,
            ref_verse, 60), false, 15.0f64, c_faint));
        msg1(text_props(config), sel("setFont:"), sans(17.0f64, 0.3f64));
        msg1(text_props(config), sel("setColor:"), c_ink);
        msg1(detail_props(config), sel("setColor:"), c_faint);
        config_image(config, "arrow.right.circle.fill", 22.0f64, c_accent);
        msg1(cell, sel("setContentConfiguration:"), config);
        return cell
    }
    cell: int = list_cell(t, "hit", 2);
    config: int = list_config(2);
    c: int = hit_chapter[r];
    v: int = hit_verse[r];
    keys[0] = k_font;
    values[0] = sans(13.0f64, 0.3f64);
    keys[1] = k_color;
    values[1] = c_accent;
    a: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        place_name(c, v), nsdictionary(keys, values, 2));
    msg1(config, sel("setAttributedText:"), a);
    release(a);
    msg1(config, sel("setSecondaryAttributedText:"), result_text(c, v));
    msg1(detail_props(config), sel("setNumberOfLines:"), 4);
    msg1(detail_props(config), sel("setLineBreakMode:"), 4);
    msg_set_f(config, sel("setTextToSecondaryTextVerticalPadding:"), 3.0f64);
    msg_rect(config, sel("setDirectionalLayoutMargins:"), 12.0f64, 20.0f64, 12.0f64,
        20.0f64);
    msg1(cell, sel("setContentConfiguration:"), config);
    cell
}

search_picked(s: int, r: int) {
    k: int = sr_kind(s);
    if (k == 2) {
        q: int = msg1(recent_list(), sel("objectAtIndex:"), r);
        msg1(search_bar, sel("setText:"), q);
        sr_n = nsstring_into(q, sr);
        run_search();
        return
    }
    if (k == 1 && r >= hit_count) {
        if (esv_sr_state != 1) esv_search_ask(1);
        return
    }
    if (k == 3 && esv_sr_row(r) < 0) {
        if (esv_sr_state != 1) esv_search_ask(esv_sr_page - 1);
        return
    }
    if (k == 3 && esv_sr_row(r) >= esv_sr_n) {
        if (esv_sr_state != 1 && esv_sr_row(r) == esv_sr_n) esv_search_ask(esv_sr_page + 1);
        return
    }
    remember_search();
    if (k == 0) {
        go_search_ref();
        return
    }
    if (k == 3) {
        jump(esv_sr_c[esv_sr_row(r)], esv_sr_v[esv_sr_row(r)]);
        return
    }
    jump(hit_chapter[r], hit_verse[r])
}

go_search_ref() {
    parse_ref(sr, sr_n);
    jump(chapter_of(ref_book, ref_chapter), if (ref_verse > 0) ref_verse else 0)
}

// ---- the library ----
show_library(_self: int, _cmd: int, _sender: int): int {
    open_library();
    0
}

lib_seg: int = 0;

seg_control: int = 0;

// The library's rows (for the segment shown): chapter, first and last
// verse, color, note, and when it was made; and its sections (a book each,
// or one of them all, newest first): first row and count.
lr_n: int = 0;

lr_c: []int = new int[32768](0);

lr_v: []int = new int[32768](0);

lr_last: []int = new int[32768](0);

lr_color: []int = new int[32768](0);

lr_note: []int = new int[32768](0);

lr_time: []int = new int[32768](0);

ls_n: int = 0;

ls_book: []int = new int[66](0);

ls_start: []int = new int[66](0);

ls_count: []int = new int[66](0);

// How many sections the table shows now (for a fade from them).
ls_shown: int = 0;

// The library's search (what is typed, lower case) and sort (0 Bible
// order, 1 newest first).
lq: []i8 = new i8[256](0i8);

lq_n: int = 0;

lib_sort: int = 0;

lib_search: int = 0;

lib_sort_button: int = 0;

lib_row(
    c: int,
    v: int,
    last: int,
    color: int,
    n: int,
    t: int
) {
    if (lr_n >= len(lr_c)) return;
    if (lq_n > 0 && !lib_matches(c, v, last, n)) return;
    lr_c[lr_n] = c;
    lr_v[lr_n] = v;
    lr_last[lr_n] = last;
    lr_color[lr_n] = color;
    lr_note[lr_n] = n;
    lr_time[lr_n] = t;
    lr_n = lr_n + 1
}

// Whether a row has the search's words: in its book's name, its verses'
// words or its note (case aside).
lm: []i8 = new i8[8192](0i8);

lm_n: int = 0;

lm_add(k: int) {
    if (lm_n < len(lm)) {
        lm[lm_n] = (if (k >= 65 && k <= 90) k + 32 else k) trunc i8;
        lm_n = lm_n + 1
    }
}

lib_matches(
    c: int,
    v: int,
    last: int,
    n: int
): bool {
    lm_n = 0;
    b: int = ch_book[c];
    for i in book_name_start(b)..book_name_end(b) lm_add(bsb[i] as int);
    lm_add(10);
    x: int = v;
    qt: int = quote_text(c, v);
    while (x <= last && lm_n < 6000 && qt >= 0) {
        _k: int = verse_text_of(qt, c, x);
        for i in 0..vt_n lm_add(vt[i] as int);
        lm_add(32);
        x = x + 1
    }
    if (n >= 0) {
        lm_add(10);
        for i in 0..nt_len[n] lm_add(nt_pool[nt_at[n] + i] as int)
    }
    for i in 0..lm_n - lq_n + 1 {
        same: bool = true;
        j: int = 0;
        while (same && j < lq_n) {
            if (lm[i + j] != lq[j]) same = false;
            j = j + 1
        }
        if (same) return true
    }
    false
}

lib_build() {
    lr_n = 0;
    ls_n = 0;
    // (Memory's segment: its own sections, ios_memory.l8.)
    if (lib_seg == 3) {
        mm_lib_build();
        return
    }
    ensure_quotable();
    if (lib_seg == 0) {
        i: int = 0;
        while (i < hl_n) {
            j: int = i;
            t: int = hl_time[i];
            while (j + 1 < hl_n && hl_key[j + 1] == hl_key[j] + 1 && hl_color[j + 1] == hl_color[i]) {
                j = j + 1;
                if (hl_time[j] > t) t = hl_time[j]
            }
            if (lib_filter < 0 || hl_color[i] == lib_filter) lib_row(key_chapter(hl_key[i]),
                key_verse(hl_key[i]), key_verse(hl_key[j]), hl_color[i], -1, t);
            i = j + 1
        }
    } else if (lib_seg == 1) {
        for i in 0..nt_n lib_row(key_chapter(nt_key[i]), key_verse(nt_key[i]), nt_end[i],
            -1, i, nt_time[i])
    } else {
        for i in 0..bm_n lib_row(key_chapter(bm_key[i]), key_verse(bm_key[i]), key_verse(bm_key[i]),
            -1, -1, bm_time[i])
    }
    if (lib_sort == 1) {
        // Newest first, in one section (insertion, stable).
        for i in 1..lr_n {
            j: int = i;
            while (j > 0 && lr_time[j - 1] < lr_time[j]) {
                for a in [lr_c, lr_v, lr_last, lr_color, lr_note, lr_time] swap(a,
                    j);
                j = j - 1
            }
        }
        if (lr_n > 0) {
            ls_book[0] = -1;
            ls_start[0] = 0;
            ls_count[0] = lr_n;
            ls_n = 1
        }
        return
    }
    for r in 0..lr_n {
        b: int = ch_book[lr_c[r]];
        if (ls_n == 0 || ls_book[ls_n - 1] != b) {
            ls_book[ls_n] = b;
            ls_start[ls_n] = r;
            ls_count[ls_n] = 0;
            ls_n = ls_n + 1
        }
        ls_count[ls_n - 1] = ls_count[ls_n - 1] + 1
    }
}

lib_placeholders: []str = ["Search Highlights", "Search Notes", "Search Bookmarks",
    "Search Memory"];

open_library() {
    if (presented() != 0) return;
    lib_seg = clamp(def_int("librarySegment"), 0, 3);
    lib_sort = clamp(def_int("librarySort"), 0, 1);
    lq_n = 0;
    lib_filter = -1;
    vc: int = sheet_table(cls("UITableViewController"), 2, "Library");
    lib_vc = vc;
    lib_table = msg(vc, sel("tableView"));
    style_table(lib_table, true);
    one[0] = nsstring("Highlights");
    one[1] = nsstring("Notes");
    one[2] = nsstring("Bookmarks");
    one[3] = nsstring("Memory");
    seg_control = msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
        nsarray(one, 4));
    msg1(seg_control, sel("setSelectedSegmentIndex:"), lib_seg);
    msg3(seg_control, sel("addTarget:action:forControlEvents:"), app_obj, sel("librarySegment:"),
        4096);
    // (The segments on a row of their own, under the bar: lib_header.)
    item: int = msg(vc, sel("navigationItem"));
    lib_header_gone();
    // Search: the rows filtered as they are typed for.
    sc: int = msg1(msg(cls("UISearchController"), sel("alloc")), sel("initWithSearchResultsController:"),
        0);
    msg1(sc, sel("setObscuresBackgroundDuringPresentation:"), 0);
    msg1(sc, sel("setHidesNavigationBarDuringPresentation:"), 0);
    msg1(sc, sel("setSearchResultsUpdater:"), app_obj);
    msg1(msg(sc, sel("searchBar")), sel("setPlaceholder:"), nsstring(lib_placeholders[lib_seg]));
    msg1(item, sel("setSearchController:"), sc);
    msg1(item, sel("setHidesSearchBarWhenScrolling:"), 1);
    lib_search = sc;
    release(sc);
    // Sort: the system's "Sort By" menu, its commands answered by the app
    // (through the responder chain).
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setImage:"), symbol("arrow.up.arrow.down", 17.0f64, 4, 0));
    lib_sort_button = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(lib_sort_button, sel("setShowsMenuAsPrimaryAction:"), 1);
    msg1(lib_sort_button, sel("setAccessibilityLabel:"), nsstring("Sort"));
    lib_sort_menu();
    sort_item: int = msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
        lib_sort_button);
    msg1(item, sel("setLeftBarButtonItem:"), sort_item);
    release(sort_item);
    lib_build();
    ls_shown = ls_n;
    lib_header();
    release(seg_control);
    lib_empty_state();
    // The toolbar: Export, and on Notes, compose a chapter's note.
    sheet_nav: int = sheet_of(vc, 1);
    msg2(sheet_nav, sel("setToolbarHidden:animated:"), 0, 0);
    msg1(msg(sheet_nav, sel("toolbar")), sel("setTintColor:"), c_icon);
    lib_toolbar(vc, false);
    present(sheet_nav)
}

sort_titles: []str = ["Bible Order", "Newest First"];

sort_sels: []str = ["librarySortBible:", "librarySortNewest:"];

lib_sort_menu() {
    for i in 0..2 {
        one[i] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
            nsstring(sort_titles[i]), 0, sel(sort_sels[i]), 0);
        msg1(one[i], sel("setState:"), if (i == lib_sort) 1 else 0)
    }
    m: int = msg2(cls("UIMenu"), sel("menuWithTitle:children:"), nsstring("Sort By"),
        nsarray(one, 2));
    msg1(lib_sort_button, sel("setMenu:"), m)
}

library_sorted(n: int) {
    lib_sort = n;
    set_def_int("librarySort", n);
    if (lib_table == 0) return;
    lib_sort_menu();
    lib_build();
    lib_reload(true)
}

library_sort_bible(_self: int, _cmd: int, _sender: int): int {
    library_sorted(0);
    0
}

library_sort_newest(_self: int, _cmd: int, _sender: int): int {
    library_sorted(1);
    0
}

// What is typed in the library's search, lower case.
library_typed(text: int) {
    lq_n = nsstring_into(text, lq);
    for i in 0..lq_n {
        k: int = lq[i] as int;
        if (k >= 65 && k <= 90) lq[i] = (k + 32) trunc i8
    }
    lib_build();
    lib_reload(false)
}

// The table shown anew: its sections faded out and in (a change of
// segment or sort), or at once (typing).
lib_reload(fade: bool) {
    if (lib_table == 0) return;
    if (fade) {
        msg(lib_table, sel("beginUpdates"));
        if (ls_shown > 0) msg2(lib_table, sel("deleteSections:withRowAnimation:"),
            msg2(cls("NSIndexSet"), sel("indexSetWithIndexesInRange:"), 0, ls_shown),
            0);
        if (ls_n > 0) msg2(lib_table, sel("insertSections:withRowAnimation:"), msg2(cls("NSIndexSet"),
            sel("indexSetWithIndexesInRange:"), 0, ls_n), 0);
        ls_shown = ls_n;
        msg(lib_table, sel("endUpdates"))
    } else {
        ls_shown = ls_n;
        msg(lib_table, sel("reloadData"))
    }
    lib_empty_state();
    if (lib_export_item != 0) msg1(lib_export_item, sel("setEnabled:"), if (anything_kept()) 1 else 0)
}

lib_empty_state() {
    if (lib_vc == 0) return;
    if (lr_n == 0 && lq_n == 0 && lib_seg == 0 && lib_filter >= 0) {
        fbuf_n = 0;
        fput_str("No ");
        fput_str(hl_titles[lib_filter]);
        fput_str(" Highlights");
        empty_state(lib_vc, lib_table, "highlighter", fstring(), "");
        return
    }
    if (lib_seg == 3 && mq_n == 0 && lq_n == 0) {
        mm_lib_empty();
        return
    }
    if (lr_n > 0 || lib_seg == 3 && ls_n > 0) empty_state(lib_vc, lib_table, "", 0,
        "") else if (lq_n > 0) empty_state(lib_vc, lib_table, "magnifyingglass", nsstring("No Results"),
        "Try other words.") else if (lib_seg == 0) empty_state(lib_vc, lib_table,
        "highlighter", nsstring("No Highlights"), "Tap a verse while reading and choose a color.") else if (lib_seg == 1) empty_state(lib_vc,
        lib_table, "note.text", nsstring("No Notes"), "Tap a verse and choose Note to write one.") else empty_state(lib_vc,
        lib_table, "bookmark", nsstring("No Bookmarks"), "Tap a verse and choose Bookmark.")
}

library_segment(_self: int, _cmd: int, control: int): int {
    lib_seg = msg(control, sel("selectedSegmentIndex"));
    set_def_int("librarySegment", lib_seg);
    if (lib_search != 0) msg1(msg(lib_search, sel("searchBar")), sel("setPlaceholder:"),
        nsstring(lib_placeholders[lib_seg]));
    lib_header();
    lib_toolbar(lib_vc, true);
    lib_build();
    lib_reload(true);
    0
}

// The words of verses v to last of chapter c (some of them, if long).
range_words(c: int, v: int, last: int): int {
    fbuf_n = 0;
    x: int = v;
    t: int = quote_text(c, v);
    while (x <= last && fbuf_n < 600 && t >= 0) {
        _n: int = verse_text_of(t, c, x);
        if (x > v) fput(32);
        for i in 0..vt_n fput(vt[i] as int);
        x = x + 1
    }
    fstring()
}

lib_cell(t: int, path: int): int {
    if (lib_seg == 3) return mm_lib_cell(t, path);
    s: int = msg(path, sel("section"));
    r: int = ls_start[s] + msg(path, sel("row"));
    cell: int = list_cell(t, "mark", 2);
    // (15 points at the default text size, growing with it: review r9-1
    // Minor 3.)
    pt: f64 = lib_pt(15.0f64);
    config: int = list_config(2);
    c: int = lr_c[r];
    fbuf_n = 0;
    fput_ref(c, lr_v[r], lr_last[r]);
    // (Quoted from a version other than the one read: which, in faint.)
    qt: int = quote_text(c, lr_v[r]);
    if (qt >= 0 && qt != quote_base()) {
        keys[0] = k_font;
        values[0] = sans(pt, 0.3f64);
        keys[1] = k_color;
        values[1] = c_ink;
        title: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
        msg1(title, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
            values, 2)));
        values[1] = c_faint;
        fbuf_n = 0;
        fput_str(" \Â\· ");
        fput_str(text_abbrs[qt]);
        msg1(title, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
            values, 2)));
        msg1(config, sel("setAttributedText:"), title)
    } else msg1(config, sel("setText:"), fstring());
    msg1(text_props(config), sel("setFont:"), sans(pt, 0.3f64));
    msg1(text_props(config), sel("setColor:"), c_ink);
    soft: int = msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64);
    if (lib_seg == 0) {
        config_image(config, "circle.fill", 12.0f64, c_swatch[lr_color[r]]);
        msg1(config, sel("setSecondaryAttributedText:"), preview(range_words(c, lr_v[r],
            lr_last[r]), true, pt, soft));
        msg1(detail_props(config), sel("setFont:"), body(pt));
        msg1(detail_props(config), sel("setNumberOfLines:"), 3)
    } else if (lib_seg == 1) {
        config_image(config, "note.text", pt, c_accent);
        msg1(config, sel("setSecondaryText:"), note_string(lr_note[r]));
        msg1(detail_props(config), sel("setFont:"), sans(pt, 0.0f64));
        msg1(detail_props(config), sel("setNumberOfLines:"), 3)
    } else {
        config_image(config, "bookmark.fill", pt, c_accent);
        msg1(config, sel("setSecondaryAttributedText:"), preview(range_words(c, lr_v[r],
            lr_last[r]), true, pt, soft));
        msg1(detail_props(config), sel("setFont:"), body(pt));
        msg1(detail_props(config), sel("setNumberOfLines:"), 2)
    }
    msg1(detail_props(config), sel("setColor:"), soft);
    msg_set_f(config, sel("setTextToSecondaryTextVerticalPadding:"), 3.0f64);
    // The words searched for, semibold where they are.
    if (lq_n > 0) {
        if (lib_seg == 1) msg1(config, sel("setSecondaryAttributedText:"), preview(note_string(lr_note[r]),
            false, pt, soft));
        q: int = nsstring_of(lq, lq_n);
        for k in [0, 1] {
            a: int = msg(msg(config, sel(if (k == 0) "attributedText" else "secondaryAttributedText")),
                sel("mutableCopy"));
            if (a != 0) {
                f: int = if (k == 0 || lib_seg == 1) sans(pt, 0.4f64) else bold(pt);
                bold_matches(a, q, f);
                msg1(config, sel(if (k == 0) "setAttributedText:" else "setSecondaryAttributedText:"),
                    a);
                release(a)
            }
        }
    }
    // Newest first: when each was made, as the row's value.
    if (lib_sort == 1) {
        l: int = msg(make("UILabel"), sel("autorelease"));
        msg1(l, sel("setText:"), relative_date(lr_time[r]));
        msg1(l, sel("setFont:"), sans(pt, 0.0f64));
        msg1(l, sel("setTextColor:"), c_faint);
        msg(l, sel("sizeToFit"));
        msg1(cell, sel("setAccessoryView:"), l)
    }
    msg1(cell, sel("setContentConfiguration:"), config);
    cell
}

// Each place q is in a (case aside), in font f, in ink.
bold_matches(a: int, q: int, f: int) {
    text: int = msg(a, sel("string"));
    n: int = msg(text, sel("length"));
    ql: int = msg(q, sel("length"));
    at: int = 0;
    more: bool = ql > 0;
    while (more && at < n) {
        loc: int = msg4(text, sel("rangeOfString:options:range:"), q, 1, at, n - at);
        if (loc < 0 || loc >= n) more = false else {
            msg4(a, sel("addAttribute:value:range:"), k_font, f, loc, ql);
            msg4(a, sel("addAttribute:value:range:"), k_color, c_ink, loc, ql);
            at = loc + ql
        }
    }
}

// "Today", "Yesterday", or the date (medium), of a time (seconds since
// 1970).
relative_date(t: int): int {
    f: int = msg(make("NSDateFormatter"), sel("autorelease"));
    msg1(f, sel("setDateStyle:"), 2);
    msg1(f, sel("setTimeStyle:"), 0);
    msg1(f, sel("setDoesRelativeDateFormatting:"), 1);
    msg1(f, sel("stringFromDate:"), msg_set_f(cls("NSDate"), sel("dateWithTimeIntervalSince1970:"),
        t as f64))
}

lib_picked(s: int, row: int) {
    if (lib_seg == 3) {
        mm_lib_picked(s, row);
        return
    }
    r: int = ls_start[s] + row;
    if (lib_seg == 1) {
        open_note(lr_c[r], lr_v[r], lr_last[r]);
        return
    }
    jump(lr_c[r], lr_v[r])
}

// A row swiped away: its marks deleted.
lib_delete(path: int) {
    if (lib_seg == 3) {
        mm_lib_delete(path);
        return
    }
    s: int = msg(path, sel("section"));
    r: int = ls_start[s] + msg(path, sel("row"));
    c: int = lr_c[r];
    if (lib_seg == 0) {
        for v in lr_v[r]..lr_last[r] + 1 set_highlight(c, v, -1);
        save_highlights()
    } else if (lib_seg == 1) {
        set_note(c, lr_v[r], 0, note_buf, 0);
        save_notes()
    } else {
        set_bookmark(c, lr_v[r], false);
        save_bookmarks()
    }
    had: int = ls_count[s];
    lib_build();
    one[0] = path;
    if (had == 1) msg2(lib_table, sel("deleteSections:withRowAnimation:"), msg1(cls("NSIndexSet"),
        sel("indexSetWithIndex:"), s), 100) else msg2(lib_table, sel("deleteRowsAtIndexPaths:withRowAnimation:"),
        nsarray(one, 1), 100);
    ls_shown = ls_n;
    lib_empty_state();
    remake(c)
}

// ---- the reading settings ----
show_settings(_self: int, _cmd: int, _sender: int): int {
    open_settings();
    0
}

open_settings() {
    if (presented() != 0) return;
    // (Whether our server gives the ESV, asked quietly as the sheet opens.)
    esv_check(true);
    vc: int = sheet_table(cls("UITableViewController"), 2, "Reading");
    settings_table = msg(vc, sel("tableView"));
    style_table(settings_table, true);
    msg1(msg(vc, sel("navigationItem")), sel("setLargeTitleDisplayMode:"), 2);
    settings_nav = sheet_of(vc, 2);
    present(settings_nav)
}

// The settings' sections: 0 the version, then (s - 1 below) 0 Listen, 1
// the text's size, 2 theme, 3 font, 4 layout, 5 what is shown, 6 while
// reading, 7 acknowledgements.
settings_rows(s_in: int): int {
    if (s_in == 0) return 1;
    s: int = s_in - 1;
    if (s == 0) return 3;
    if (s == 1 || s == 2 || s == 6 || s == 7) return 1;
    if (s == 3) return 5;
    if (s == 4) return 2;
    5
}

settings_header(s_in: int): int {
    if (s_in == 0) return 0;
    s: int = s_in - 1;
    if (s <= 1 || s == 7) return 0;
    nsstring(if (s == 2) "Theme" else if (s == 3) "Font" else if (s == 4) "Layout" else if (s == 5) "Show" else "While Reading")
}

settings_footer(s_in: int): int {
    if (s_in == 0) return version_footer();
    s: int = s_in - 1;
    if (s == 0) return listen_footer();
    if (s == 5) return show_footer();
    if (s == 6) return nsstring("The screen stays on while you read. It turns off as usual after 10 minutes without scrolling.");
    if (s != 7) return 0;
    nsstring("Berean Standard Bible \Â\· Public Domain")
}

slider: int = 0;

// A plain cell with nothing reused in it.
fresh_cell(_t: int): int {
    cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, 0), sel("autorelease"));
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    msg1(cell, sel("setSelectionStyle:"), 0);
    cell
}

symbol_button(name: str, action: str, label: str): int {
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg2(b, sel("setImage:forState:"), symbol(name, 17.0f64, 4, 0), 0);
    msg1(b, sel("setTintColor:"), c_ink);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel(action), 64);
    msg1(b, sel("setAccessibilityLabel:"), nsstring(label));
    b
}

size_cell(t: int): int {
    cell: int = fresh_cell(t);
    content: int = msg(cell, sel("contentView"));
    column: int = stack(1, 6.0f64);
    row: int = stack(0, 12.0f64);
    msg1(row, sel("setAlignment:"), 3);
    msg1(row, sel("addArrangedSubview:"), symbol_button("textformat.size.smaller",
        "sizeSmaller:", "Smaller Text"));
    slider = make("UISlider");
    msg_set_f32(slider, sel("setMinimumValue:"), 0.0f64 as f32);
    msg_set_f32(slider, sel("setMaximumValue:"), 7.0f64 as f32);
    msg_set_f32(slider, sel("setValue:"), set_size as f64 as f32);
    msg1(slider, sel("setMinimumTrackTintColor:"), c_accent);
    msg3(slider, sel("addTarget:action:forControlEvents:"), app_obj, sel("sizeSlid:"),
        4096);
    msg1(slider, sel("setAccessibilityLabel:"), nsstring("Text Size"));
    msg1(row, sel("addArrangedSubview:"), slider);
    release(slider);
    msg1(row, sel("addArrangedSubview:"), symbol_button("textformat.size.larger",
        "sizeLarger:", "Larger Text"));
    msg1(column, sel("addArrangedSubview:"), row);
    caption: int = make("UILabel");
    msg1(caption, sel("setText:"), nsstring("Also follows the iPhone text size."));
    msg1(caption, sel("setFont:"), sans(12.0f64, 0.0f64));
    msg1(caption, sel("setTextColor:"), c_faint);
    msg1(caption, sel("setTextAlignment:"), 1);
    msg1(column, sel("addArrangedSubview:"), caption);
    release(caption);
    msg1(content, sel("addSubview:"), column);
    pin_by(column, content, "leadingAnchor", 16.0f64);
    pin_by(column, content, "trailingAnchor", -16.0f64);
    pin_by(column, content, "topAnchor", 10.0f64);
    pin_by(column, content, "bottomAnchor", -10.0f64);
    cell
}

theme_cell(t: int): int {
    cell: int = fresh_cell(t);
    content: int = msg(cell, sel("contentView"));
    row: int = stack(0, 0.0f64);
    msg1(row, sel("setDistribution:"), 1);
    for i in 0..6 {
        column: int = stack(1, 6.0f64);
        msg1(column, sel("setAlignment:"), 3);
        // The ring (when chosen), around the swatch.
        ring: int = make("UIView");
        msg1(ring, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        pin_size(ring, "widthAnchor", 55.0f64);
        pin_size(ring, "heightAnchor", 55.0f64);
        rl: int = msg(ring, sel("layer"));
        msg_set_f(rl, sel("setCornerRadius:"), 27.5f64);
        msg_set_f(rl, sel("setBorderWidth:"), 2.5f64);
        msg1(rl, sel("setBorderColor:"), msg(if (i == set_theme) c_accent else msg(cls("UIColor"),
            sel("clearColor")), sel("CGColor")));
        tt: int = if (i == 0) 1 else i;
        b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
        msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
        msg1(b, sel("setTag:"), i);
        msg1(b, sel("setBackgroundColor:"), color_hex(t_bg[tt], 1.0f64));
        bl: int = msg(b, sel("layer"));
        msg_set_f(bl, sel("setCornerRadius:"), 22.0f64);
        msg_set_f(bl, sel("setBorderWidth:"), 1.0f64);
        msg1(bl, sel("setBorderColor:"), msg(c_rule, sel("CGColor")));
        msg1(b, sel("setClipsToBounds:"), 1);
        if (i == 0) {
            // Auto: Paper and Night, split corner to corner.
            g: int = make("CAGradientLayer");
            one[0] = msg(color_hex(t_bg[1], 1.0f64), sel("CGColor"));
            one[1] = one[0];
            one[2] = msg(color_hex(t_bg[4], 1.0f64), sel("CGColor"));
            one[3] = one[2];
            msg1(g, sel("setColors:"), nsarray(one, 4));
            one[0] = nsnumber_f(0.0f64);
            one[1] = nsnumber_f(0.5f64);
            one[2] = nsnumber_f(0.5f64);
            one[3] = nsnumber_f(1.0f64);
            msg1(g, sel("setLocations:"), nsarray(one, 4));
            msg_ff(g, sel("setStartPoint:"), 0.0f64, 0.0f64);
            msg_ff(g, sel("setEndPoint:"), 1.0f64, 1.0f64);
            msg_rect(g, sel("setFrame:"), 0.0f64, 0.0f64, 44.0f64, 44.0f64);
            msg2(bl, sel("insertSublayer:atIndex:"), g, 0);
            release(g)
        }
        keys[0] = k_font;
        values[0] = body(15.0f64);
        keys[1] = k_color;
        values[1] = color_hex(t_ink[if (i == 0) 1 else tt], 1.0f64);
        a: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
            nsstring(if (i == 0) "" else "Aa"), nsdictionary(keys, values, 2));
        msg2(b, sel("setAttributedTitle:forState:"), a, 0);
        release(a);
        msg1(b, sel("setAccessibilityLabel:"), nsstring(theme_names[i]));
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("themePicked:"),
            64);
        msg1(ring, sel("addSubview:"), b);
        pin_size(b, "widthAnchor", 44.0f64);
        pin_size(b, "heightAnchor", 44.0f64);
        pin_to(b, "centerXAnchor", ring, "centerXAnchor", 0.0f64);
        pin_to(b, "centerYAnchor", ring, "centerYAnchor", 0.0f64);
        msg1(column, sel("addArrangedSubview:"), ring);
        release(ring);
        caption: int = make("UILabel");
        msg1(caption, sel("setText:"), nsstring(theme_names[i]));
        msg1(caption, sel("setFont:"), sans(11.0f64, if (i == set_theme) 0.3f64 else 0.0f64));
        msg1(caption, sel("setTextColor:"), if (i == set_theme) c_ink else c_faint);
        msg1(column, sel("addArrangedSubview:"), caption);
        release(caption);
        msg1(row, sel("addArrangedSubview:"), column)
    }
    msg1(content, sel("addSubview:"), row);
    pin_by(row, content, "leadingAnchor", 8.0f64);
    pin_by(row, content, "trailingAnchor", -8.0f64);
    pin_by(row, content, "topAnchor", 12.0f64);
    pin_by(row, content, "bottomAnchor", -10.0f64);
    cell
}

// Font i's face at 17 points, for its name in the list.
font_sample(i: int): int {
    if (i == 4) return sans(17.0f64, 0.0f64);
    if (i == 0) {
        d: int = msg1(cls("UIFontDescriptor"), sel("preferredFontDescriptorWithTextStyle:"),
            objc_const("UIFontTextStyleBody"));
        s: int = msg1(d, sel("fontDescriptorWithDesign:"), objc_const("UIFontDescriptorSystemDesignSerif"));
        return msg1_f(cls("UIFont"), sel("fontWithDescriptor:size:"), if (s != 0) s else d,
            17.0f64)
    }
    f: int = msg1_f(cls("UIFont"), sel("fontWithName:size:"), nsstring(font_names_ps[i]),
        17.0f64);
    if (f == 0) sans(17.0f64, 0.0f64) else f
}

segmented(
    a: str,
    b: str,
    c: str,
    at: int,
    action: str
): int {
    one[0] = nsstring(a);
    one[1] = nsstring(b);
    one[2] = nsstring(c);
    s: int = msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
        nsarray(one, 3));
    msg1(s, sel("setSelectedSegmentIndex:"), at);
    msg3(s, sel("addTarget:action:forControlEvents:"), app_obj, sel(action), 4096);
    msg_rect(s, sel("setFrame:"), 0.0f64, 0.0f64, 220.0f64, 32.0f64);
    msg(s, sel("autorelease"))
}

show_titles: []str = ["Verse Numbers", "Section Headings", "Footnote Marks", "Words of Jesus in Red",
    "One Verse per Line"];

settings_cell(t: int, path: int): int {
    if (msg(path, sel("section")) == 0) return version_cell(t);
    s: int = msg(path, sel("section")) - 1;
    r: int = msg(path, sel("row"));
    if (s == 0) return if (r == 0) listen_cell(t) else if (r == 1) speed_cell(t) else voice_row_cell(t);
    if (s == 1) return size_cell(t);
    if (s == 2) return theme_cell(t);
    cell: int = fresh_cell(t);
    if (s == 7) {
        config: int = list_config(0);
        msg1(config, sel("setText:"), nsstring("Acknowledgements"));
        msg1(text_props(config), sel("setColor:"), c_ink);
        msg1(cell, sel("setContentConfiguration:"), config);
        msg1(cell, sel("setAccessoryType:"), 1);
        msg1(cell, sel("setSelectionStyle:"), 3);
        return cell
    }
    config: int = list_config(0);
    msg1(text_props(config), sel("setColor:"), c_ink);
    if (s == 3) {
        msg1(config, sel("setText:"), nsstring(font_names[r]));
        msg1(text_props(config), sel("setFont:"), font_sample(r));
        msg1(cell, sel("setAccessoryType:"), if (r == set_font) 3 else 0);
        msg1(cell, sel("setSelectionStyle:"), 3)
    } else if (s == 4) {
        control: int = if (r == 0) segmented("Compact", "Normal", "Relaxed", set_spacing,
            "spacingPicked:") else segmented("Narrow", "Normal", "Wide", set_margins,
            "marginsPicked:");
        if (ax_size()) return segment_row(t, if (r == 0) "Line Spacing" else "Margins",
            control);
        msg1(config, sel("setText:"), nsstring(if (r == 0) "Line Spacing" else "Margins"));
        msg1(cell, sel("setAccessoryView:"), control)
    } else if (s == 6) {
        msg1(config, sel("setText:"), nsstring("Keep Screen On"));
        sw: int = make("UISwitch");
        msg1(sw, sel("setOn:"), if (keep_on) 1 else 0);
        msg1(sw, sel("setOnTintColor:"), c_accent);
        msg3(sw, sel("addTarget:action:forControlEvents:"), app_obj, sel("keepOnSwitched:"),
            4096);
        msg1(cell, sel("setAccessoryView:"), sw);
        release(sw)
    } else {
        msg1(config, sel("setText:"), nsstring(show_titles[r]));
        sw: int = make("UISwitch");
        on: bool = if (r == 0) lay_verse_numbers else if (r == 1) lay_headings else if (r == 2) lay_notes else if (r == 3) red_letter else lay_verse_lines;
        msg1(sw, sel("setOn:"), if (on) 1 else 0);
        msg1(sw, sel("setOnTintColor:"), c_accent);
        msg1(sw, sel("setTag:"), r);
        msg3(sw, sel("addTarget:action:forControlEvents:"), app_obj, sel("showSwitched:"),
            4096);
        msg1(cell, sel("setAccessoryView:"), sw);
        release(sw)
    }
    msg1(cell, sel("setContentConfiguration:"), config);
    cell
}

// Listen (DESIGN.md Â§8.7): a wide button, "Listen from John 3:14" (the
// verse at the top of the reader), or Stop Listening while it reads.
listen_cell(t: int): int {
    cell: int = fresh_cell(t);
    content: int = msg(cell, sel("contentView"));
    playing: bool = ls_active;
    config: int = msg(cls("UIButtonConfiguration"), sel(if (playing) "grayButtonConfiguration" else "filledButtonConfiguration"));
    if (!playing) {
        msg1(config, sel("setBaseBackgroundColor:"), c_accent);
        msg1(config, sel("setBaseForegroundColor:"), on_accent())
    }
    msg1(config, sel("setCornerStyle:"), 4);
    msg1(config, sel("setImage:"), symbol(if (playing) "stop.fill" else "play.fill",
        15.0f64, 6, 0));
    msg_set_f(config, sel("setImagePadding:"), 8.0f64);
    fbuf_n = 0;
    if (playing) fput_str("Stop Listening") else {
        v: int = listen_top_verse();
        fbuf_n = 0;
        fput_str("Listen from ");
        fput_ref(cur, v, 0)
    }
    keys[0] = k_font;
    values[0] = sans(17.0f64, 0.3f64);
    title: int = msg2(msg(cls("NSAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        fstring(), nsdictionary(keys, values, 1));
    msg1(config, sel("setAttributedTitle:"), title);
    release(title);
    b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(b, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("listenButton:"),
        64);
    msg1(content, sel("addSubview:"), b);
    pin_by(b, content, "leadingAnchor", 16.0f64);
    pin_by(b, content, "trailingAnchor", -16.0f64);
    pin_by(b, content, "topAnchor", 12.0f64);
    pin_by(b, content, "bottomAnchor", -12.0f64);
    pin_size(b, "heightAnchor", 50.0f64);
    cell
}

// Whether the phone's text size is one of the accessibility sizes.
extern UIContentSizeCategoryIsAccessibilityCategory(category: int): int;

ax_size(): bool {
    (UIContentSizeCategoryIsAccessibilityCategory(msg(msg(cls("UIApplication"), sel("sharedApplication")),
        sel("preferredContentSizeCategory"))) & 255) != 0
}

// A row of a title and a segmented control, the control under the title
// (at the accessibility sizes, where they do not fit side by side).
segment_row(t: int, title: str, control: int): int {
    cell: int = fresh_cell(t);
    content: int = msg(cell, sel("contentView"));
    column: int = stack(1, 10.0f64);
    label: int = make("UILabel");
    msg1(label, sel("setText:"), nsstring(title));
    msg1(label, sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleBody")));
    msg1(label, sel("setTextColor:"), c_ink);
    msg1(label, sel("setNumberOfLines:"), 0);
    msg1(column, sel("addArrangedSubview:"), label);
    release(label);
    msg1(column, sel("addArrangedSubview:"), control);
    msg1(content, sel("addSubview:"), column);
    pin_by(column, content, "leadingAnchor", 16.0f64);
    pin_by(column, content, "trailingAnchor", -16.0f64);
    pin_by(column, content, "topAnchor", 12.0f64);
    pin_by(column, content, "bottomAnchor", -12.0f64);
    cell
}

speed_cell(t: int): int {
    control: int = segmented("Slower", "Normal", "Faster", clamp(def_int("listenRate"),
        0, 2), "listenSpeed:");
    if (ax_size()) return segment_row(t, "Speed", control);
    cell: int = fresh_cell(t);
    config: int = list_config(0);
    msg1(config, sel("setText:"), nsstring("Speed"));
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryView:"), control);
    cell
}

// The Listen section's third row (Â§12.4.1): Voice, the current version's
// reader.
voice_row_cell(t: int): int {
    audio_load();
    cell: int = list_cell(t, "voice", 1);
    config: int = list_config(1);
    msg1(config, sel("setText:"), nsstring("Voice"));
    msg1(config, sel("setSecondaryText:"), nsstring(src_readers[audio_source(text_cur)]));
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(detail_props(config), sel("setColor:"), c_faint);
    msg1(cell, sel("setContentConfiguration:"), config);
    msg1(cell, sel("setAccessoryType:"), 1);
    msg1(cell, sel("setSelectionStyle:"), 3);
    cell
}

// Its footer, only while it applies: the version read by the iPhone's
// voice, no Enhanced or Premium voice installed, and Voice never opened.
listen_footer(): int {
    if (def_bool("voiceScreenSeen") || audio_source(text_cur) != SRC_VOICE || better_voice_installed()) return 0;
    nsstring("This version is read by the iPhone\â\€\™s voice. A more natural voice can be downloaded in Voice.")
}

// A setting changed: kept, and the reader made again (its place kept).
settings_changed(theme_too: bool) {
    save_settings();
    if (theme_too) apply_theme(true) else make_look();
    relayout();
    if (settings_table != 0) msg(settings_table, sel("reloadData"))
}

set_size_step(n: int) {
    m: int = clamp(n, 0, 7);
    if (m == set_size) return;
    set_size = m;
    save_settings();
    make_look();
    relayout();
    if (slider != 0) msg_set_f32(slider, sel("setValue:"), m as f64 as f32)
}

size_slid(_self: int, _cmd: int, s: int): int {
    v: f64 = msg_f32(s, sel("value")) as f64;
    n: int = (v + 0.5f64) as int;
    msg_set_f32(s, sel("setValue:"), n as f64 as f32);
    set_size_step(n);
    0
}

size_smaller(_self: int, _cmd: int, _b: int): int {
    set_size_step(set_size - 1);
    0
}

size_larger(_self: int, _cmd: int, _b: int): int {
    set_size_step(set_size + 1);
    0
}

theme_picked(_self: int, _cmd: int, b: int): int {
    set_theme = msg(b, sel("tag"));
    haptic_select();
    settings_changed(true);
    0
}

spacing_picked(_self: int, _cmd: int, s: int): int {
    set_spacing = msg(s, sel("selectedSegmentIndex"));
    save_settings();
    make_look();
    relayout();
    0
}

margins_picked(_self: int, _cmd: int, s: int): int {
    set_margins = msg(s, sel("selectedSegmentIndex"));
    save_settings();
    make_look();
    relayout();
    0
}

show_switched(_self: int, _cmd: int, sw: int): int {
    on: bool = (msg(sw, sel("isOn")) & 255) != 0;
    r: int = msg(sw, sel("tag"));
    if (r == 3) {
        set_red_letter(on);
        return 0
    }
    if (r == 0) lay_verse_numbers = on else if (r == 1) lay_headings = on else if (r == 2) lay_notes = on else lay_verse_lines = on;
    save_settings();
    make_look();
    relayout();
    0
}

// The words of Jesus in red, or not: the rows seen made again (a short
// cross-fade), the place kept.
set_red_letter(on: bool) {
    red_letter = on;
    save_settings();
    make_look();
    fade_layer(msg(table, sel("layer")), 0.2f64);
    relayout()
}

settings_picked(s_in: int, r: int) {
    if (s_in == 0) {
        open_versions();
        return
    }
    s: int = s_in - 1;
    if (s == 7) {
        open_acknowledgements();
        return
    }
    if (s == 0 && r == 2) {
        open_voice();
        return
    }
    if (s != 3) return;
    set_font = r;
    settings_changed(false)
}

// ---- the note editor ----
note_tv: int = 0;

note_placeholder: int = 0;

// The note's chapter, first verse and last.
ne_c: int = 0;

ne_v: int = 0;

ne_last: int = 0;

open_note(c: int, v: int, last: int) {
    clear_selection();
    existing: int = note_of(c, v);
    ne_c = c;
    ne_v = v;
    ne_last = (if (existing >= 0) nt_end[existing] else last);
    vc: int = msg(make_note_vc(), sel("autorelease"));
    view: int = msg(vc, sel("view"));
    msg1(view, sel("setBackgroundColor:"), c_bg);
    fbuf_n = 0;
    fput_ref(c, v, ne_last);
    msg1(vc, sel("setTitle:"), fstring());
    item: int = msg(vc, sel("navigationItem"));
    note_item = item;
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    // An existing note opens to be read (Done on the left, Edit on the
    // right); a new one, or one being added to, to be written.
    note_reading = existing >= 0 && !note_force_edit;
    note_from_read = note_reading;
    note_force_edit = false;
    if (note_reading) note_read_items(false) else note_edit_items(existing >= 0, false);
    // The verse, quoted, with an accent bar beside it.
    bar: int = make("UIView");
    msg1(bar, sel("setBackgroundColor:"), c_accent);
    msg_set_f(msg(bar, sel("layer")), sel("setCornerRadius:"), 1.5f64);
    msg1(bar, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    quote: int = make("UILabel");
    msg1(quote, sel("setNumberOfLines:"), 4);
    msg1(quote, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    keys[0] = k_font;
    values[0] = body(em * 0.85f64);
    keys[1] = k_color;
    values[1] = c_faint;
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.25f64), sel("autorelease"));
    msg1(values[2], sel("setLineBreakMode:"), 4);
    if (v == 0) {
        // A chapter's note: the chapter's first heading over its first
        // verse (two lines of it).
        msg1(quote, sel("setNumberOfLines:"), 3);
        msg1(quote, sel("setAttributedText:"), chapter_quote(c, nsdictionary(keys,
            values, 3)))
    } else msg1(quote, sel("setAttributedText:"), with_caps(range_words(c, v, ne_last),
        nsdictionary(keys, values, 3), true, em * 0.85f64));
    rule: int = make("UIView");
    msg1(rule, sel("setBackgroundColor:"), c_rule);
    msg1(rule, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    note_tv = make("UITextView");
    msg1(note_tv, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(note_tv, sel("setFont:"), body(em));
    msg1(note_tv, sel("setTextColor:"), c_ink);
    msg1(note_tv, sel("setBackgroundColor:"), c_bg);
    msg1(note_tv, sel("setTintColor:"), c_accent);
    msg_rect(note_tv, sel("setTextContainerInset:"), 12.0f64, 20.0f64, 20.0f64, 20.0f64);
    msg_set_f(msg(note_tv, sel("textContainer")), sel("setLineFragmentPadding:"),
        0.0f64);
    if (existing >= 0) msg1(note_tv, sel("setText:"), note_string(existing));
    msg1(note_tv, sel("setDelegate:"), app_obj);
    tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("noteTapped:"));
    msg1(tap, sel("setDelegate:"), app_obj);
    msg1(note_tv, sel("addGestureRecognizer:"), tap);
    release(tap);
    if (note_reading) note_show_read(existing);
    note_placeholder = make("UILabel");
    msg1(note_placeholder, sel("setText:"), nsstring("Write a note\â\€\¦"));
    msg1(note_placeholder, sel("setFont:"), body(em));
    msg1(note_placeholder, sel("setTextColor:"), c_faint);
    msg1(note_placeholder, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(note_placeholder, sel("setHidden:"), if (existing >= 0) 1 else 0);
    for x in [bar, quote, rule, note_tv, note_placeholder] {
        msg1(view, sel("addSubview:"), x);
        release(x)
    }
    guide: int = msg(view, sel("safeAreaLayoutGuide"));
    pin_to(quote, "topAnchor", guide, "topAnchor", 16.0f64);
    pin_to(quote, "leadingAnchor", view, "leadingAnchor", 33.0f64);
    pin_to(quote, "trailingAnchor", view, "trailingAnchor", -20.0f64);
    pin_to(bar, "leadingAnchor", view, "leadingAnchor", 20.0f64);
    pin_size(bar, "widthAnchor", 3.0f64);
    pin_to(bar, "topAnchor", quote, "topAnchor", 0.0f64);
    pin_to(bar, "bottomAnchor", quote, "bottomAnchor", 0.0f64);
    pin_to(rule, "topAnchor", quote, "bottomAnchor", 16.0f64);
    pin_to(rule, "leadingAnchor", view, "leadingAnchor", 20.0f64);
    pin_to(rule, "trailingAnchor", view, "trailingAnchor", -20.0f64);
    pin_size(rule, "heightAnchor", 1.0f64);
    pin_to(note_tv, "topAnchor", rule, "bottomAnchor", 0.0f64);
    pin_to(note_tv, "leadingAnchor", view, "leadingAnchor", 0.0f64);
    pin_to(note_tv, "trailingAnchor", view, "trailingAnchor", 0.0f64);
    kb: int = if ((msg1(view, sel("respondsToSelector:"), sel("keyboardLayoutGuide")) & 255) != 0) msg(view,
        sel("keyboardLayoutGuide")) else guide;
    pin_to(note_tv, "bottomAnchor", kb, "topAnchor", 0.0f64);
    pin_to(note_placeholder, "topAnchor", note_tv, "topAnchor", 12.0f64);
    pin_to(note_placeholder, "leadingAnchor", note_tv, "leadingAnchor", 20.0f64);
    sheet_nav: int = sheet_of(vc, 1);
    // (Over the library, if it is open.)
    over: int = presented();
    if (over != 0) msg3(over, sel("presentViewController:animated:completion:"), sheet_nav,
        1, 0) else present(sheet_nav)
}

// A chapter's note's quote: its first section heading (or its name), then
// its first verse, in attributes.
chapter_quote(c: int, attributes: int): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    fbuf_n = 0;
    p: int = ch_start[c];
    found: bool = false;
    while (p < ch_end[c] && !found) {
        e: int = line_end(p);
        if (bsb[p] as int == 83) {
            fput_bytes(bsb, p + 1, e);
            found = true
        }
        p = e + 1
    }
    if (!found) fput_title(c);
    fput(10);
    keys[0] = k_font;
    values[0] = sans(15.0f64, 0.4f64);
    keys[1] = k_color;
    values[1] = c_heading;
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 4.0f64, 1.0f64), sel("autorelease"));
    msg1(s, sel("appendAttributedString:"), msg(msg2(msg(cls("NSAttributedString"),
        sel("alloc")), sel("initWithString:attributes:"), fstring(), nsdictionary(keys,
        values, 3)), sel("autorelease")));
    msg1(s, sel("appendAttributedString:"), with_caps(range_words(c, 1, 1), attributes,
        true, em * 0.85f64));
    s
}

make_note_vc(): int {
    make("L8Note")
}

// The editor on screen: the keyboard up (not while it is being read), the
// cursor at the end.
note_appeared(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, note_class, cmd, animated);
    if (note_tv != 0 && !note_reading && !demo_no_keyboard) {
        msg(note_tv, sel("becomeFirstResponder"));
        msg2(note_tv, sel("setSelectedRange:"), msg(msg(note_tv, sel("text")), sel("length")),
            0)
    }
    0
}

// ---- the note, read (DESIGN.md Â§7.9) ----
note_item: int = 0;

note_reading: bool = false;

// Whether the editor was opened to read (so Done goes back to reading).
note_from_read: bool = false;

// The next note opened to be written even if it exists (Add to Note).
note_force_edit: bool = false;

note_read_items(animated: bool) {
    msg2(note_item, sel("setLeftBarButtonItem:animated:"), system_item(0, "noteClose:"),
        if (animated) 1 else 0);
    msg2(note_item, sel("setRightBarButtonItem:animated:"), system_item(2, "noteEdit:"),
        if (animated) 1 else 0)
}

note_edit_items(existing: bool, animated: bool) {
    done: int = system_item(0, "noteDone:");
    msg1(done, sel("setStyle:"), 2);
    msg2(note_item, sel("setRightBarButtonItem:animated:"), done, if (animated) 1 else 0);
    left: int = 0;
    if (existing) {
        left = system_item(16, "noteTrash:");
        msg1(left, sel("setTintColor:"), msg(cls("UIColor"), sel("systemRedColor")));
        msg1(left, sel("setAccessibilityLabel:"), nsstring("Delete Note"))
    } else left = system_item(1, "noteCancel:");
    msg2(note_item, sel("setLeftBarButtonItem:animated:"), left, if (animated) 1 else 0)
}

// Note i in the text view, to be read: its references to verses links, in
// the accent.
note_show_read(i: int) {
    msg1(note_tv, sel("setEditable:"), 0);
    msg1(note_tv, sel("setSelectable:"), 1);
    n: int = nt_len[i];
    for x in 0..n note_buf[x] = nt_pool[nt_at[i] + x];
    keys[0] = k_font;
    values[0] = body(em);
    keys[1] = k_color;
    values[1] = c_ink;
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.25f64), sel("autorelease"));
    a: int = msg(msg2(msg(cls("NSMutableAttributedString"), sel("alloc")), sel("initWithString:attributes:"),
        nsstring_of(note_buf, n), nsdictionary(keys, values, 3)), sel("autorelease"));
    note_refs(note_buf, n);
    for r in 0..nr_n {
        b: int = units_of(note_buf, 0, nr_b[r]);
        u: int = units_of(note_buf, nr_b[r], nr_e[r]);
        msg4(a, sel("addAttribute:value:range:"), k_color, c_accent, b, u);
        xr_book = nr_book[r];
        xr_c = nr_c[r];
        xr_v = (if (nr_v[r] > 0) nr_v[r] else 0);
        xr_ce = (if (nr_ve[r] > 0) nr_c[r] else 0);
        xr_ve = (if (nr_ve[r] > 0) nr_ve[r] else 0);
        msg4(a, sel("addAttribute:value:range:"), nsstring(k_xref), nsnumber_int(xref_both()),
            b, u)
    }
    msg1(note_tv, sel("setAttributedText:"), a)
}

// How many UTF-16 units bytes a to b of x are.
units_of(x: []i8, a: int, b: int): int {
    n: int = 0;
    for i in a..b {
        k: int = x[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    n
}

// A tap on the note read: a reference's preview, pushed in the note's
// sheet (DESIGN.md Â§8.1).
note_tapped(_self: int, _cmd: int, tap: int): int {
    if (!note_reading) return 0;
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    ref_tap_at(tv, hfa[0], hfa[1]);
    0
}

// A tap at (x, y) on text with references (a note's, a definition's): the
// reference's preview pushed.
ref_tap_at(tv: int, x: f64, y: f64) {
    ref: int = link_at(tv, x, y, k_xref);
    if (ref > 0) push_preview(ref)
}

// Edit: the editor in place, the keyboard up.
note_edit(_self: int, _cmd: int, _b: int): int {
    if (note_tv == 0) return 0;
    note_reading = false;
    fade_layer(msg(note_tv, sel("layer")), 0.2f64);
    i: int = note_of(ne_c, ne_v);
    msg1(note_tv, sel("setText:"), if (i >= 0) note_string(i) else nsstring(""));
    msg1(note_tv, sel("setFont:"), body(em));
    msg1(note_tv, sel("setTextColor:"), c_ink);
    msg1(note_tv, sel("setEditable:"), 1);
    note_edit_items(true, true);
    if (!demo_no_keyboard) msg(note_tv, sel("becomeFirstResponder"));
    msg2(note_tv, sel("setSelectedRange:"), msg(msg(note_tv, sel("text")), sel("length")),
        0);
    0
}

note_close(_self: int, _cmd: int, _b: int): int {
    close_note();
    0
}

demo_no_keyboard: bool = false;

// The text typed: the placeholder shown only while there is none.
text_changed(_self: int, _cmd: int, tv: int): int {
    if (tv == note_tv && note_placeholder != 0) msg1(note_placeholder, sel("setHidden:"),
        if (msg(msg(tv, sel("text")), sel("length")) > 0) 1 else 0);
    0
}

// The note as it is in the editor, kept (none, if empty).
save_note_editor() {
    if (note_tv == 0) return;
    n: int = nsstring_into(msg(note_tv, sel("text")), note_buf);
    // (Trailing spaces and lines let go.)
    while (n > 0 && (note_buf[n - 1] as int == 32 || note_buf[n - 1] as int == 10)) n = n - 1;
    old: int = note_of(ne_c, ne_v);
    same: bool = old >= 0 && nt_len[old] == n;
    if (same) {
        for i in 0..n
            if (nt_pool[nt_at[old] + i] != note_buf[i]) same = false
    }
    if (!same && !(old < 0 && n == 0)) {
        set_note(ne_c, ne_v, ne_last, note_buf, n);
        save_notes();
        remake(ne_c)
    }
}

// Closes the editor (over the library, or the reader).
close_note() {
    note_tv = 0;
    top: int = presented();
    if (top == 0) return;
    inner: int = msg(top, sel("presentedViewController"));
    if (inner != 0) {
        msg2(top, sel("dismissViewControllerAnimated:completion:"), 1, 0);
        if (lib_table != 0) {
            lib_build();
            lib_reload(false)
        }
    } else dismiss_sheets()
}

note_done(_self: int, _cmd: int, _sender: int): int {
    save_note_editor();
    // (Opened to be read: back to reading it, unless it is gone.)
    i: int = note_of(ne_c, ne_v);
    if (note_from_read && i >= 0 && note_tv != 0) {
        msg(note_tv, sel("resignFirstResponder"));
        fade_layer(msg(note_tv, sel("layer")), 0.2f64);
        note_reading = true;
        note_show_read(i);
        note_read_items(true);
        return 0
    }
    close_note();
    0
}

note_cancel(_self: int, _cmd: int, _sender: int): int {
    close_note();
    0
}

note_trash(_self: int, _cmd: int, _sender: int): int {
    set_note(ne_c, ne_v, 0, note_buf, 0);
    save_notes();
    remake(ne_c);
    close_note();
    0
}

// ---- the tables' data, for every table ----
table_sections(_self: int, _cmd: int, t: int): int {
    if (is_reader(t)) return 1;
    if (mm_is_table(t)) return mm_sections(t);
    if (ln_is_table(t)) return ln_sections(t);
    if (t == picker_table) return pk_sections();
    if (t == lib_table) return ls_n;
    if (t == search_table) return search_sections();
    if (t == settings_table) return 9;
    if (t == detail_table && t != 0) return detail_sections();
    if (t == plans_table && t != 0) return 2;
    if (t == day1_table && t != 0) return 2;
    if (t == nr_table && t != 0) return 3;
    if (t == rbs_table && t != 0) return 4;
    if (t == bg_books_table && t != 0) return 2;
    if (t == versions_table && t != 0) return versions_sections();
    if (t == compare_table && t != 0) return compare_sections();
    if (t == xref_table && t != 0) return 1;
    if (t == study_table && t != 0) return study_sections();
    if (t == grammar_table && t != 0) return gr_n;
    if (t == conc_table && t != 0) return cs_n;
    if (t == ack_table && t != 0) return ack_sections();
    if (t == voice_table && t != 0) return voice_sections();
    if (t == vlist_table && t != 0) return vlist_sections();
    if (t == dl_table && t != 0) return dl_sections();
    if (t == dlb_table && t != 0) return 2;
    if (t == changes_table && t != 0) return 1;
    if (t == hist_table && t != 0) return hd_n;
    0
}

table_rows(
    _self: int,
    _cmd: int,
    t: int,
    section: int
): int {
    if (is_reader(t)) return chapters;
    if (mm_is_table(t)) return mm_rows(t, section);
    if (ln_is_table(t)) return ln_rows(t, section);
    if (t == picker_table) return picker_rows(section);
    if (t == lib_table) return if (section < ls_n) ls_count[section] else 0;
    if (t == search_table) return search_rows(section);
    if (t == settings_table) return settings_rows(section);
    if (t == detail_table && t != 0) return detail_rows(section);
    if (t == plans_table && t != 0) return plans_rows(section);
    if (t == day1_table && t != 0) return day1_rows(section);
    if (t == nr_table && t != 0) return nr_rows(section);
    if (t == rbs_table && t != 0) return rbs_rows(section);
    if (t == bg_books_table && t != 0) return bg_books_rows(section);
    if (t == versions_table && t != 0) return versions_rows(section);
    if (t == compare_table && t != 0) return compare_rows(section);
    if (t == xref_table && t != 0) return xref_rows();
    if (t == study_table && t != 0) return study_rows(section);
    if (t == grammar_table && t != 0) return grammar_rows(section);
    if (t == conc_table && t != 0) return cs_count[section];
    if (t == ack_table && t != 0) return ack_rows(section);
    if (t == voice_table && t != 0) return voice_rows(section);
    if (t == vlist_table && t != 0) return vlist_rows(section);
    if (t == dl_table && t != 0) return dl_rows(section);
    if (t == dlb_table && t != 0) return dlb_rows(section);
    if (t == changes_table && t != 0) return len(change_lines);
    if (t == hist_table && t != 0) return if (section < hd_n) hd_count[section] else 0;
    0
}

table_header(
    _self: int,
    _cmd: int,
    t: int,
    section: int
): int {
    if (t == picker_table) return picker_header(section);
    if (t == lib_table && lib_seg == 3) return mm_lib_header(section);
    if (t == lib_table) return if (section < ls_n && ls_book[section] >= 0) book_name(ls_book[section]) else 0;
    if (mm_is_table(t)) return mm_header(t, section);
    if (ln_is_table(t)) return ln_header(t, section);
    if (t == search_table) return search_header(section);
    if (t == settings_table) return settings_header(section);
    if (t == detail_table && t != 0) return detail_header_title(section);
    if (t == plans_table && t != 0) return plans_header(section);
    if (t == day1_table && t != 0) return day1_header(section);
