    if (t == rbs_table && t != 0) return rbs_header(section);
    if (t == bg_books_table && t != 0) return nsstring(if (section == 0) "Old Testament" else "New Testament");
    if (t == versions_table && t != 0) return versions_header(section);
    if (t == study_table && t != 0) return study_header_title(section);
    if (t == grammar_table && t != 0) return grammar_header(section);
    if (t == conc_table && t != 0) return conc_header(section);
