// "(ESV) Â· esv.org" under ESV text in a list (the link to esv.org).
esv_footer_view(): int {
    b: int = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    keys[0] = k_font;
    values[0] = sans(13.0f64, 0.0f64);
    keys[1] = k_color;
    values[1] = c_faint;
    msg1(s, sel("appendAttributedString:"), attributed_str(nsstring("(ESV) \Â\· "),
        nsdictionary(keys, values, 2)));
    values[1] = c_accent;
    msg1(s, sel("appendAttributedString:"), attributed_str(nsstring("esv.org"), nsdictionary(keys,
        values, 2)));
    msg2(b, sel("setAttributedTitle:forState:"), s, 0);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("esvOrg:"), 64);
    msg1(b, sel("setAccessibilityLabel:"), nsstring("ESV. Link: esv.org"));
    msg_rect(b, sel("setFrame:"), 0.0f64, 0.0f64, 300.0f64, 44.0f64);
    b
}

esv_org(_self: int, _cmd: int, _b: int): int {
    open_web_ns(nsstring("https://www.esv.org"));
    0
}

table_cell(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    if (is_reader(t)) return chapter_cell(t, path);
    if (mm_is_table(t)) return mm_cell(t, path);
    if (ln_is_table(t)) return ln_cell(t, path);
    if (t == picker_table) return picker_cell(t, path);
    if (t == detail_table && t != 0) return detail_cell(t, path);
    if (t == plans_table && t != 0) return plans_cell(t, path);
    if (t == day1_table && t != 0) return day1_cell(t, path);
    if (t == nr_table && t != 0) return nr_cell_at(t, path);
    if (t == rbs_table && t != 0) return rbs_cell_at(t, path);
    if (t == bg_books_table && t != 0) return bg_books_cell(t, path);
    if (t == lib_table) return lib_cell(t, path);
    if (t == search_table) return search_cell(t, path);
    if (t == study_table && t != 0) return study_cell(t, path);
    if (t == versions_table && t != 0) return versions_cell(t, path);
    if (t == compare_table && t != 0) return compare_cell(t, path);
    if (t == xref_table && t != 0) return xref_cell(t, path);
    if (t == grammar_table && t != 0) return grammar_cell(t, path);
    if (t == conc_table && t != 0) return conc_cell(t, path);
    if (t == ack_table && t != 0) return ack_cell(t, path);
    if (t == voice_table && t != 0) return voice_cell(t, path);
    if (t == vlist_table && t != 0) return vlist_cell(t, path);
    if (t == dl_table && t != 0) return dl_cell(t, path);
    if (t == dlb_table && t != 0) return dlb_cell(t, path);
    if (t == changes_table && t != 0) return changes_cell(t, path);
    if (t == hist_table && t != 0) return hist_cell(t, path);
    settings_cell(t, path)
}

table_picked(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    if (is_reader(t)) return 0;
    msg2(t, sel("deselectRowAtIndexPath:animated:"), path, 1);
    s: int = msg(path, sel("section"));
    r: int = msg(path, sel("row"));
    if (ln_is_table(t)) ln_picked(t, s, r) else if (mm_is_table(t)) mm_picked(t, s,
        r) else if (t == plans_table && t != 0) plans_picked(s, r) else if (t == day1_table && t != 0) day1_picked(s,
        r) else if (t == nr_table && t != 0) nr_picked(s, r) else if (t == rbs_table && t != 0) rbs_picked(s,
        r) else if (t == bg_books_table && t != 0) bg_books_picked(s, r) else if (t == detail_table && t != 0) detail_picked(s,
        r) else if (t == picker_table) picker_picked(s, r) else if (t == lib_table) lib_picked(s,
        r) else if (t == search_table) search_picked(s, r) else if (t == settings_table) settings_picked(s,
        r) else if (t == study_table) study_picked(s, r) else if (t == conc_table) conc_picked(s,
        r) else if (t == ack_table) ack_picked(s, r) else if (t == hist_table && t != 0) hist_picked(s,
        r) else if (t == versions_table && t != 0) versions_picked(s, r) else if (t == compare_table && t != 0) compare_picked(s,
        r) else if (t == xref_table && t != 0) xref_picked(r) else if (t == voice_table && t != 0) voice_picked(s,
        r) else if (t == vlist_table && t != 0) vlist_picked(s, r) else if (t == dl_table && t != 0) dl_picked(s,
        r) else if (t == dlb_table && t != 0) dlb_picked(s, r);
    0
}

table_can_edit(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    if (t == lib_table && lib_seg == 3) return if (mm_lib_index(path) >= 0) 1 else 0;
    if (ln_is_table(t)) return if (ln_can_edit(t, path)) 1 else 0;
    if (t == lib_table || t == hist_table && t != 0) return 1;
    // (Downloaded Books: Delete.)
    if (t == dl_table && t != 0 && msg(path, sel("section")) == 0) return 1;
    // (Go To's ribbons, Delete; the plan's row, Remove.)
    if (t == picker_table && t != 0 && pq_n == 0) {
        k: int = pk_kind(msg(path, sel("section")));
        r: int = msg(path, sel("row"));
        if (k == 5 && r < gt_rb || k == 6 && gt_plan && r == 0) return 1
    }
    0
}

table_commit(
    _self: int,
    _cmd: int,
    t: int,
    style: int,
    path: int
): int {
    if (t == lib_table && style == 1) lib_delete(path);
    if (ln_is_table(t) && style == 1) ln_commit(t, path);
    if (t == hist_table && t != 0 && style == 1) hist_delete(path);
    if (t == picker_table && t != 0 && style == 1 && pq_n == 0) {
        k: int = pk_kind(msg(path, sel("section")));
        if (k == 5) today_delete_ribbon(msg(path, sel("row"))) else if (k == 6) today_remove_plan()
    }
    if (t == dl_table && t != 0 && style == 1) {
        dl_delete(path);
        msg(t, sel("reloadData"))
    }
    0
}

// The swipe's word: Remove for the plan (nothing is lost: Â§11.3.1), Delete
// elsewhere (a ribbon too: History keeps its places).
table_delete_title(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    if (t == picker_table && t != 0 && pq_n == 0 && pk_kind(msg(path, sel("section"))) == 6) nsstring("Remove") else nsstring("Delete")
}

// A row's â“˜: a ribbon's screen, or the plan followed's days.
table_accessory(
    _self: int,
    _cmd: int,
    t: int,
    path: int
): int {
    if (t == picker_table && t != 0 && pq_n == 0) {
        k: int = pk_kind(msg(path, sel("section")));
        r: int = msg(path, sel("row"));
        if (k == 5 && r < rb_n) open_ribbon_screen(r) else if (k == 6) plan_row_details()
    }
    if (t == lib_table && t != 0 && lib_seg == 3) mm_lib_accessory(path);
    0
}

// A sheet's navigation controller: once it has gone (its dismissal
// finished), the back capsule of a jump made from it comes up.
sheet_nav_class: int = 0;

sheet_disappeared(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, sheet_nav_class, cmd, animated);
    if (back_after_sheet && presented() == 0) {
        back_after_sheet = false;
        show_back()
    }
    0
}

// ---- iOS 26: a sheet's edges (DESIGN.md Â§2.9) ----
// The scroll view a sheet's screen shows its content in: its view, or the
// first found in it (a text view, the interlinear's, a list in a box).
content_scroll(view: int, depth: int): int {
    if (view == 0) return 0;
    if ((msg1(view, sel("isKindOfClass:"), cls("UIScrollView")) & 255) != 0) return view;
    if (depth == 0) return 0;
    subs: int = msg(view, sel("subviews"));
    n: int = msg(subs, sel("count"));
    for i in 0..n {
        f: int = content_scroll(msg1(subs, sel("objectAtIndex:"), i), depth - 1);
        if (f != 0) return f
    }
    0
}

// A view's top, from its window's: its frame's, up through each view it is
// in, less each one's scroll.
window_top(v: int): f64 {
    y: f64 = 0.0f64;
    while (v != 0) {
        l8_msg_hfa(hfa, v, sel("frame"), 0, 0, 0);
        y = y + hfa[1];
        up: int = msg(v, sel("superview"));
        if (up != 0) {
            l8_msg_hfa(hfa, up, sel("bounds"), 0, 0, 0);
            y = y - hfa[1]
        }
        v = up
    }
    y
}

// A sheet's screen, made ready before it is seen (as it is pushed, as the
// sheet rises, as its toolbar comes or goes): the bar and the toolbar told
// which scroll view is under them, so the system's edge effect is drawn
// there (a text view or a list in a box is not found by itself); on iOS 26,
// the top edge's effect the hard one, nearly opaque under the title, so no
// words scrolled up show through it; and its bottom inset at least what
// the toolbar's floating buttons cover, so the last row scrolls clear of
// them.
sheet_edges(vc: int) {
    if (vc == 0 || !responds(vc, "setContentScrollView:forEdge:")) return;
    sv: int = content_scroll(msg(vc, sel("view")), 3);
    if (sv == 0) return;
    if (msg1(vc, sel("contentScrollViewForEdge:"), 1) != sv) msg2(vc, sel("setContentScrollView:forEdge:"),
        sv, 1);
    if (msg1(vc, sel("contentScrollViewForEdge:"), 4) != sv) msg2(vc, sel("setContentScrollView:forEdge:"),
        sv, 4);
    if (responds(sv, "topEdgeEffect")) {
        hard: int = msg(cls("UIScrollEdgeEffectStyle"), sel("hardStyle"));
        edge: int = msg(sv, sel("topEdgeEffect"));
        if (hard != 0 && msg(edge, sel("style")) != hard) msg1(edge, sel("setStyle:"),
            hard)
    }
    sheet_nav: int = msg(vc, sel("navigationController"));
    if (sheet_nav == 0 || (msg(sheet_nav, sel("isToolbarHidden")) & 255) != 0) return;
    if (msg(sv, sel("window")) == 0) return;
    bar: int = msg(sheet_nav, sel("toolbar"));
    if (bar == 0 || view_height(bar) <= 0.0f64) return;
    covered: f64 = window_top(sv) + view_height(sv) - window_top(bar);
    if (covered <= 0.0f64 || covered > 160.0f64) return;
    l8_msg_hfa(hfa, sv, sel("adjustedContentInset"), 0, 0, 0);
    if (hfa[2] >= covered) return;
    short: f64 = covered - hfa[2];
    l8_msg_hfa(hfa, sv, sel("contentInset"), 0, 0, 0);
    msg_rect(sv, sel("setContentInset:"), hfa[0], hfa[1], hfa[2] + short, hfa[3]);
    note_num("bible: sheet bottom inset raised by ", short as int)
}

sheet_top(sheet_nav: int): int {
    msg(sheet_nav, sel("topViewController"))
}

sheet_will_appear(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, sheet_nav_class, cmd, animated);
    sheet_edges(sheet_top(self));
    0
}

sheet_laid_out(self: int, cmd: int): int {
    super0(self, sheet_nav_class, cmd);
    sheet_edges(sheet_top(self));
    0
}

extern msg_super2(
    sup: *ObjcSuper,
    selector: int,
    a: int,
    b: int
): int = objc_msgSendSuper;

sheet_pushed(
    self: int,
    cmd: int,
    vc: int,
    animated: int
): int {
    sup: ObjcSuper = ObjcSuper { receiver: self, super_class: class_getSuperclass(sheet_nav_class) };
    msg_super2(&sup, cmd, vc, animated);
    sheet_edges(vc);
    0
}

make_sheet_classes() {
    sheet_nav_class = objc_allocateClassPair(cls("UINavigationController"), "L8Sheet",
        0);
    add_method1(sheet_nav_class, sel("viewDidDisappear:"), &sheet_disappeared, "v@:B");
    add_method1(sheet_nav_class, sel("viewWillAppear:"), &sheet_will_appear, "v@:B");
    add_method0(sheet_nav_class, sel("viewDidLayoutSubviews"), &sheet_laid_out, "v@:");
    add_method2(sheet_nav_class, sel("pushViewController:animated:"), &sheet_pushed,
        "v@:@B");
    objc_registerClassPair(sheet_nav_class);
    books_class = objc_allocateClassPair(cls("UITableViewController"), "L8Books",
        0);
    add_method0(books_class, sel("viewDidLayoutSubviews"), &books_layout, "v@:");
    add_method1(books_class, sel("viewWillAppear:"), &books_will_appear, "v@:B");
    objc_registerClassPair(books_class);
    search_class = objc_allocateClassPair(cls("UITableViewController"), "L8Search",
        0);
    add_method1(search_class, sel("viewWillAppear:"), &search_appeared, "v@:B");
    objc_registerClassPair(search_class);
    note_class = objc_allocateClassPair(cls("UIViewController"), "L8Note", 0);
    add_method1(note_class, sel("viewDidAppear:"), &note_appeared, "v@:B");
    objc_registerClassPair(note_class)
}

