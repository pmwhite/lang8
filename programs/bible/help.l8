tag bible;

use_tag std;

// The manual and the quick tips (DESIGN.md §15), apart from any platform:
// data/help.txt read into pages, their parts and paragraphs, and the tips;
// what is wrong with it (links, anchors, conditions, actions, symbols, ids,
// the house style), said in hlog; a paragraph's markup as runs; its words
// plain (for search, and for VoiceOver with each symbol's name); the tips'
// order and the rule that picks today's (help_tip_for); the conditions that
// skip a tip, and the used flags among them; and the Manual's search.
// test_help.l8 tests it; ios_help.l8 shows it.
import "store.l8";

// ---- the file, given by the platform ----
hlp: []i8 = new i8[1](0i8);

hlp_n: int = 0;

help_ready: bool = false;

// ---- what it holds ----
// Pages: their id, title and symbol (byte ranges in hlp), and their parts
// (hpg_part0, hpg_parts of them). Parts: their page, id, heading, and
// paragraphs. Paragraphs: their bytes, their part.
hpg_n: int = 0;

hpg_id_b: []int = new int[32](0);

hpg_id_e: []int = new int[32](0);

hpg_title_b: []int = new int[32](0);

hpg_title_e: []int = new int[32](0);

hpg_sym: []int = new int[32](-1);

hpg_part0: []int = new int[32](0);

hpg_parts: []int = new int[32](0);

hpt_n: int = 0;

hpt_page: []int = new int[256](0);

hpt_id_b: []int = new int[256](0);

hpt_id_e: []int = new int[256](0);

hpt_head_b: []int = new int[256](0);

hpt_head_e: []int = new int[256](0);

hpt_para0: []int = new int[256](0);

hpt_paras: []int = new int[256](0);

hpa_n: int = 0;

hpa_b: []int = new int[1024](0);

hpa_e: []int = new int[1024](0);

hpa_part: []int = new int[1024](0);

// Tips: their id, level (1 to 3), condition (UNLESS, -1 none), action (-1
// none) and its title, the part More opens (-1 if it names none), and
// their words.
htp_n: int = 0;

htp_id_b: []int = new int[128](0);

htp_id_e: []int = new int[128](0);

htp_level: []int = new int[128](1);

htp_unless: []int = new int[128](-1);

htp_action: []int = new int[128](-1);

htp_act_b: []int = new int[128](0);

htp_act_e: []int = new int[128](0);

htp_more: []int = new int[128](-1);

htp_text_b: []int = new int[128](0);

htp_text_e: []int = new int[128](0);

// The order (§15.2.1): by level, then the file's; and each tip's place in
// it.
htp_order: []int = new int[128](0);

htp_pos: []int = new int[128](0);

// ---- the closed lists ----
// The conditions a tip may name (§15.2.2): true from the app's data, or a
// used flag, set by the feature's own code the first time it is used.
// unbuilt is always true: a tip written ahead of its feature. (§16's used
// flags come after it: a plan's day opened, Mark Read, a day listened to.)
hc_names: []str = ["highlight", "note", "bookmark", "chapter-note", "ribbon", "plan",
    "memory", "practice", "reminder", "greek", "hebrew", "hide-known", "library",
    "capsule", "search", "preview", "title-menu", "listen", "voice", "download", "compare",
    "study", "wordstudy", "concordance", "export", "share-image", "version", "theme",
    "size", "red-letters", "keep-awake", "unbuilt", "plan-day", "plan-mark", "plan-listen"];

HC_UNBUILT: int = 31;

// Whether each is true now (the data's, set by the platform), and the used
// flags (helpUsed).
hc_on: []bool = new bool[40](false);

hu_used: []bool = new bool[40](false);

// The actions a tip may carry (§15.1.2).
ha_names: []str = ["new-ribbon", "plans", "search", "memory", "greek", "hebrew", "history",
    "versions", "voice"];

// The SF Symbols the manual may draw, each with what VoiceOver says for it.
hsym_names: []str = ["magnifyingglass", "bookmark", "textformat.size", "xmark", "circle.slash",
    "doc.on.doc", "square.and.arrow.up", "square.and.pencil", "character.book.closed",
    "brain", "note.text", "arrow.up.arrow.down", "info.circle", "chevron.up", "chevron.down",
    "plus", "keyboard", "book", "arrow.right.circle", "hand.tap", "bookmark.fill",
    "calendar", "books.vertical", "headphones", "textformat.abc"];

hsym_spoken: []str = ["the Search button", "the bookmark button", "the Reading Settings button",
    "the Close button", "the Remove Highlight button", "the Copy button", "the Share button",
    "the pencil button", "the Study button", "the Memorize button", "the note mark",
    "the Sort button", "the More Info button", "the up arrow", "the down arrow", "the Add button",
    "the keyboard button", "a book", "an arrow", "a hand", "a ribbon", "a calendar",
    "books", "headphones", "letters"];

// ---- what is wrong, a line each ("help.txt:12: ...") ----
hlog: []i8 = new i8[16384](0i8);

hlog_n: int = 0;

he_n: int = 0;

hl_put(k: int) {
    if (hlog_n < len(hlog)) {
        hlog[hlog_n] = k trunc i8;
        hlog_n = hlog_n + 1
    }
}

hl_str(s: str) {
    for k in s hl_put(k as int)
}

hl_int(n: int) {
    if (n >= 10) hl_int(n / 10);
    hl_put(48 + n % 10)
}

hl_bytes(b: int, e: int) {
    for i in b..e hl_put(hlp[i] as int)
}

he_line: int = 0;

he_begin() {
    he_n = he_n + 1;
    hl_str("help.txt:");
    hl_int(he_line);
    hl_str(": ")
}

he_end() {
    hl_put(10)
}

// ---- bytes ----
hlb(i: int): int {
    hlp[i] as int & 255
}

hlp_is(b: int, e: int, s: str): bool {
    if (e - b != len(s)) return false;
    for i in 0..len(s)
        if (hlp[b + i] != s[i]) return false;
    true
}

hlp_same(
    b1: int,
    e1: int,
    b2: int,
    e2: int
): bool {
    if (e1 - b1 != e2 - b2) return false;
    for i in 0..e1 - b1
        if (hlp[b1 + i] != hlp[b2 + i]) return false;
    true
}

hlp_starts(b: int, e: int, s: str): bool {
    if (e - b < len(s)) return false;
    for i in 0..len(s)
        if (hlp[b + i] != s[i]) return false;
    true
}

// The next tab at or after p (or e).
hlp_tab(p: int, e: int): int {
    q: int = p;
    while (q < e && hlb(q) != 9) q = q + 1;
    q
}

// The index of the name hlp[b..e) in a list, or -1.
help_name_in(b: int, e: int, names: []str): int {
    for i in 0..len(names)
        if (hlp_is(b, e, names[i])) return i;
    -1
}

// The part named by the anchor hlp[b..e) ("page#part"), or -1.
help_anchor(b: int, e: int): int {
    h: int = b;
    while (h < e && hlb(h) != 35) h = h + 1;
    if (h >= e) return -1;
    for g in 0..hpg_n {
        if (hlp_same(hpg_id_b[g], hpg_id_e[g], b, h)) {
            for t in hpg_part0[g]..hpg_part0[g] + hpg_parts[g]
                if (hlp_same(hpt_id_b[t], hpt_id_e[t], h + 1, e)) return t
        }
    }
    -1
}

// ---- reading it ----
help_clear() {
    hpg_n = 0;
    hpt_n = 0;
    hpa_n = 0;
    htp_n = 0;
    he_n = 0;
    hlog_n = 0
}

// help.txt (hlp, hlp_n) read: its pages, parts, paragraphs and tips, then
// checked; what is wrong in hlog (he_n lines).
help_index() {
    help_clear();
    p: int = 0;
    line: int = 0;
    while (p < hlp_n) {
        e: int = p;
        while (e < hlp_n && hlb(e) != 10) e = e + 1;
        line = line + 1;
        he_line = line;
        if (e > p && hlb(p) != 35) help_line(p, e);
        p = e + 1
    }
    he_line = 0;
    help_order();
    help_check();
    help_ready = true
}

help_line(b: int, e: int) {
    if (hlp_starts(b, e, "== ")) {
        if (hpg_n == 0 || hpt_n >= len(hpt_page)) {
            he_begin();
            hl_str("a part before any page");
            he_end();
            return
        }
        t: int = hlp_tab(b + 3, e);
        hpt_page[hpt_n] = hpg_n - 1;
        hpt_id_b[hpt_n] = b + 3;
        hpt_id_e[hpt_n] = t;
        hpt_head_b[hpt_n] = (if (t < e) t + 1 else e);
        hpt_head_e[hpt_n] = e;
        hpt_para0[hpt_n] = hpa_n;
        hpt_paras[hpt_n] = 0;
        // (Two parts of a page with one id.)
        for x in hpg_part0[hpg_n - 1]..hpt_n {
            if (hlp_same(hpt_id_b[x], hpt_id_e[x], b + 3, t)) {
                he_begin();
                hl_str("two parts ");
                hl_bytes(b + 3, t);
                hl_str(" in one page");
                he_end()
            }
        }
        hpg_parts[hpg_n - 1] = hpg_parts[hpg_n - 1] + 1;
        hpt_n = hpt_n + 1;
        return
    }
    if (hlp_starts(b, e, "= ")) {
        if (hpg_n >= len(hpg_id_b)) return;
        t1: int = hlp_tab(b + 2, e);
        t2: int = hlp_tab(t1 + 1, e);
        hpg_id_b[hpg_n] = b + 2;
        hpg_id_e[hpg_n] = t1;
        hpg_title_b[hpg_n] = (if (t1 < e) t1 + 1 else e);
        hpg_title_e[hpg_n] = (if (t1 < e) t2 else e);
        hpg_sym[hpg_n] = (if (t2 < e) help_name_in(t2 + 1, e, hsym_names) else -1);
        if (hpg_sym[hpg_n] < 0) {
            he_begin();
            hl_str("page ");
            hl_bytes(b + 2, t1);
            hl_str(": no symbol, or one not in help.l8's list");
            he_end()
        }
        for g in 0..hpg_n {
            if (hlp_same(hpg_id_b[g], hpg_id_e[g], b + 2, t1)) {
                he_begin();
                hl_str("two pages ");
                hl_bytes(b + 2, t1);
                he_end()
            }
        }
        hpg_part0[hpg_n] = hpt_n;
        hpg_parts[hpg_n] = 0;
        hpg_n = hpg_n + 1;
        return
    }
    if (hlp_starts(b, e, "tip\t")) {
        help_tip_line(b, e);
        return
    }
    // A paragraph of the part last begun (in its page).
    if (hpt_n == 0 || hpg_n == 0 || hpg_parts[hpg_n - 1] == 0 || hpa_n >= len(hpa_b)) {
        he_begin();
        hl_str("a paragraph outside any part");
        he_end();
        return
    }
    hpa_b[hpa_n] = b;
    hpa_e[hpa_n] = e;
    hpa_part[hpa_n] = hpt_n - 1;
    hpt_paras[hpt_n - 1] = hpt_paras[hpt_n - 1] + 1;
    hpa_n = hpa_n + 1
}

// The tip anchors are read after every page is (a tip may come first).
htp_more_b: []int = new int[128](0);

htp_more_e: []int = new int[128](0);

htp_line: []int = new int[128](0);

help_tip_line(b: int, e: int) {
    if (htp_n >= len(htp_id_b)) return;
    n: int = 0;
    p: int = b;
    while (p <= e && n < 8) {
        q: int = hlp_tab(p, e);
        hf_at[n * 2] = p;
        hf_at[n * 2 + 1] = q;
        n = n + 1;
        p = q + 1
    }
    if (n != 7) {
        he_begin();
        hl_str("a tip needs 7 fields, not ");
        hl_int(n);
        he_end();
        return
    }
    i: int = htp_n;
    htp_line[i] = he_line;
    htp_id_b[i] = hf_at[2];
    htp_id_e[i] = hf_at[3];
    for x in 0..i {
        if (hlp_same(htp_id_b[x], htp_id_e[x], hf_at[2], hf_at[3])) {
            he_begin();
            hl_str("two tips ");
            hl_bytes(hf_at[2], hf_at[3]);
            he_end()
        }
    }
    lv: int = if (hf_at[5] == hf_at[4] + 1) hlb(hf_at[4]) - 48 else 0;
    if (lv < 1 || lv > 3) {
        he_begin();
        hl_str("tip ");
        hl_bytes(hf_at[2], hf_at[3]);
        hl_str(": its level is not 1, 2 or 3");
        he_end();
        lv = 3
    }
    htp_level[i] = lv;
    htp_unless[i] = -1;
    if (!hlp_is(hf_at[6], hf_at[7], "-")) {
        htp_unless[i] = help_name_in(hf_at[6], hf_at[7], hc_names);
        if (htp_unless[i] < 0) {
            he_begin();
            hl_str("tip ");
            hl_bytes(hf_at[2], hf_at[3]);
            hl_str(": unknown condition ");
            hl_bytes(hf_at[6], hf_at[7]);
            he_end()
        }
    }
    htp_action[i] = -1;
    htp_act_b[i] = hf_at[9];
    htp_act_e[i] = hf_at[9];
    if (!hlp_is(hf_at[8], hf_at[9], "-")) {
        c: int = hf_at[8];
        while (c < hf_at[9] && hlb(c) != 58) c = c + 1;
        htp_action[i] = help_name_in(hf_at[8], c, ha_names);
        if (htp_action[i] < 0 || c + 1 >= hf_at[9]) {
            he_begin();
            hl_str("tip ");
            hl_bytes(hf_at[2], hf_at[3]);
            hl_str(": unknown action, or no title: ");
            hl_bytes(hf_at[8], hf_at[9]);
            he_end();
            htp_action[i] = -1
        } else {
            htp_act_b[i] = c + 1;
            htp_act_e[i] = hf_at[9]
        }
    }
    htp_more_b[i] = hf_at[10];
    htp_more_e[i] = hf_at[11];
    htp_text_b[i] = hf_at[12];
    htp_text_e[i] = hf_at[13];
    htp_n = htp_n + 1
}

hf_at: []int = new int[16](0);

// ---- the order ----
help_order() {
    k: int = 0;
    for lv in 1..4 {
        for i in 0..htp_n {
            if (htp_level[i] == lv) {
                htp_order[k] = i;
                htp_pos[i] = k;
                k = k + 1
            }
        }
    }
}

// ---- the checks (§15.6) ----
help_check() {
    for g in 0..hpg_n {
        if (hpg_parts[g] == 0) {
            he_begin();
            hl_str("page ");
            hl_bytes(hpg_id_b[g], hpg_id_e[g]);
            hl_str(" has no part");
            he_end()
        }
    }
    for t in 0..hpt_n {
        if (hpt_paras[t] == 0) {
            he_begin();
            hl_str("part ");
            help_hl_anchor(t);
            hl_str(" has no paragraph");
            he_end()
        }
    }
    // Each paragraph's markup: its symbols known, its links' anchors there.
    for a in 0..hpa_n {
        help_runs(a);
        for r in 0..hrun_n {
            if (hrun_kind[r] == HRUN_SYM && hrun_sym[r] < 0 || hrun_kind[r] == HRUN_LINK && hrun_link[r] < 0 || hrun_kind[r] == HRUN_BAD) {
                he_begin();
                hl_str("part ");
                help_hl_anchor(hpa_part[a]);
                hl_str(if (hrun_kind[r] == HRUN_SYM) ": a symbol not in help.l8's list: " else if (hrun_kind[r] == HRUN_LINK) ": a link to nowhere: " else ": markup not closed: ");
                hl_bytes(hrun_b[r], hrun_e[r]);
                he_end()
            }
        }
        if (hrun_open) {
            he_begin();
            hl_str("part ");
            help_hl_anchor(hpa_part[a]);
            hl_str(": ** or _ not closed");
            he_end()
        }
    }
    for i in 0..htp_n {
        he_line = htp_line[i];
        htp_more[i] = help_anchor(htp_more_b[i], htp_more_e[i]);
        if (htp_more[i] < 0) {
            he_begin();
            hl_str("tip ");
            hl_bytes(htp_id_b[i], htp_id_e[i]);
            hl_str(": More names no part: ");
            hl_bytes(htp_more_b[i], htp_more_e[i]);
            he_end()
        }
        help_style(i)
    }
    he_line = 0
}

help_hl_anchor(t: int) {
    g: int = hpt_page[t];
    hl_bytes(hpg_id_b[g], hpg_id_e[g]);
    hl_put(35);
    hl_bytes(hpt_id_b[t], hpt_id_e[t])
}

// The house style: one sentence (no ". " inside), at most 140 letters, no
// exclamation mark, none of the words the style forbids.
hstyle_words: []str = ["pro tip", "did you know", "awesome", "easily", "simply", "just"];

help_style(i: int) {
    b: int = htp_text_b[i];
    e: int = htp_text_e[i];
    letters: int = 0;
    for x in b..e
        if ((hlb(x) & 192) != 128) letters = letters + 1;
    why: str = "";
    if (letters > 140) why = "longer than 140 letters";
    for x in b..e {
        if (hlb(x) == 33) why = "an exclamation mark";
        if (hlb(x) == 46 && x + 1 < e && hlb(x + 1) == 32) why = "more than one sentence"
    }
    if (e == b) why = "no words";
    for w in 0..len(hstyle_words) {
        word: str = hstyle_words[w];
        for x in b..e - len(word) + 1 {
            if (help_word_here(x, b, e, word)) why = "a word the style forbids"
        }
    }
    if (len(why) == 0) return;
    he_begin();
    hl_str("tip ");
    hl_bytes(htp_id_b[i], htp_id_e[i]);
    hl_str(": ");
    hl_str(why);
    he_end()
}

// Whether word (lower case) is at hlp[x], whole, in b..e, whatever its case.
help_word_here(
    x: int,
    b: int,
    e: int,
    word: str
): bool {
    if (x > b && help_wordy(hlb(x - 1))) return false;
    if (x + len(word) > e) return false;
    for i in 0..len(word)
        if (help_lower(hlb(x + i)) != word[i] as int) return false;
    x + len(word) >= e || !help_wordy(hlb(x + len(word)))
}

help_lower(k: int): int {
    if (k >= 65 && k <= 90) k + 32 else k
}

help_wordy(k: int): bool {
    k >= 48 && k <= 57 || k >= 65 && k <= 90 || k >= 97 && k <= 122
}

// ---- a paragraph's markup, as runs ----
// Kinds: text (bold, italic as they are there), a symbol (hrun_sym, -1
// unknown), a link (its words hrun_b..hrun_e, its part hrun_link, -1 none),
// and markup not closed. hrun_open: ** or _ left open at the end.
HRUN_TEXT: int = 0;

HRUN_SYM: int = 1;

HRUN_LINK: int = 2;

HRUN_BAD: int = 3;

hrun_n: int = 0;

hrun_kind: []int = new int[64](0);

hrun_b: []int = new int[64](0);

hrun_e: []int = new int[64](0);

hrun_bold: []bool = new bool[64](false);

hrun_italic: []bool = new bool[64](false);

hrun_sym: []int = new int[64](-1);

hrun_link: []int = new int[64](-1);

hrun_open: bool = false;

hrun_add(
    kind: int,
    b: int,
    e: int,
    bold: bool,
    italic: bool
) {
    if (hrun_n >= len(hrun_kind) || kind == HRUN_TEXT && e <= b) return;
    hrun_kind[hrun_n] = kind;
    hrun_b[hrun_n] = b;
    hrun_e[hrun_n] = e;
    hrun_bold[hrun_n] = bold;
    hrun_italic[hrun_n] = italic;
    hrun_sym[hrun_n] = -1;
    hrun_link[hrun_n] = -1;
    hrun_n = hrun_n + 1
}

help_runs(a: int) {
    hrun_n = 0;
    b: int = hpa_b[a];
    e: int = hpa_e[a];
    bold: bool = false;
    italic: bool = false;
    s: int = b;
    i: int = b;
    while (i < e) {
        k: int = hlb(i);
        if (k == 42 && i + 1 < e && hlb(i + 1) == 42) {
            hrun_add(HRUN_TEXT, s, i, bold, italic);
            bold = !bold;
            i = i + 2;
            s = i
        } else if (k == 95 && (italic || i + 1 < e && hlb(i + 1) != 32)) {
            hrun_add(HRUN_TEXT, s, i, bold, italic);
            italic = !italic;
            i = i + 1;
            s = i
        } else if (k == 123 && hlp_starts(i, e, "{sym:")) {
            hrun_add(HRUN_TEXT, s, i, bold, italic);
            c: int = i + 5;
            while (c < e && hlb(c) != 125) c = c + 1;
            if (c >= e) {
                hrun_add(HRUN_BAD, i, e, bold, italic);
                i = e
            } else {
                hrun_add(HRUN_SYM, i + 5, c, bold, italic);
                if (hrun_n > 0) hrun_sym[hrun_n - 1] = help_name_in(i + 5, c, hsym_names);
                i = c + 1
            }
            s = i
        } else if (k == 91 && i + 1 < e && hlb(i + 1) == 91) {
            hrun_add(HRUN_TEXT, s, i, bold, italic);
            bar: int = i + 2;
            while (bar < e && hlb(bar) != 124 && hlb(bar) != 93) bar = bar + 1;
            c: int = bar;
            while (c + 1 < e && !(hlb(c) == 93 && hlb(c + 1) == 93)) c = c + 1;
            if (bar >= e || hlb(bar) != 124 || c + 1 >= e) {
                hrun_add(HRUN_BAD, i, e, bold, italic);
                i = e
            } else {
                hrun_add(HRUN_LINK, bar + 1, c, bold, italic);
                if (hrun_n > 0) hrun_link[hrun_n - 1] = help_anchor(i + 2, bar);
                i = c + 2
            }
            s = i
        } else i = i + 1
    }
    hrun_add(HRUN_TEXT, s, e, bold, italic);
    hrun_open = bold || italic
}

// ---- words plain ----
// A paragraph's words without its markup into hx (a symbol by its name
// when spoken, for VoiceOver; else left out, with one space kept).
hx: []i8 = new i8[4096](0i8);

hx_n: int = 0;

hx_put(k: int) {
    if (hx_n < len(hx)) {
        hx[hx_n] = k trunc i8;
        hx_n = hx_n + 1
    }
}

help_plain(a: int, spoken: bool) {
    hx_n = 0;
    help_runs(a);
    for r in 0..hrun_n {
        if (hrun_kind[r] == HRUN_SYM) {
            if (spoken && hrun_sym[r] >= 0)
                for k in hsym_spoken[hrun_sym[r]] hx_put(k as int)
        } else
            for x in hrun_b[r]..hrun_e[r] hx_put(hlb(x))
    }
    // (Two spaces, where a symbol was left out, made one.)
    if (!spoken) {
        m: int = 0;
        for x in 0..hx_n {
            if (!(hx[x] as int == 32 && m > 0 && hx[m - 1] as int == 32)) {
                hx[m] = hx[x];
                m = m + 1
            }
        }
        hx_n = m;
        s: int = if (hx_n > 0 && hx[0] as int == 32) 1 else 0;
        if (s > 0) {
            for x in 1..hx_n hx[x - 1] = hx[x];
            hx_n = hx_n - 1
        }
    }
}

// ---- which tip, and when (§15.2.3) ----
// The tip current (-1 none), the day it became so, and the tips seen.
ht_cur: int = -1;

ht_day: int = 0;

ht_seen: []bool = new bool[128](false);

help_state_clear() {
    ht_cur = -1;
    ht_day = 0;
    for i in 0..len(ht_seen) ht_seen[i] = false;
    for c in 0..len(hu_used) {
        hu_used[c] = false;
        hc_on[c] = false
    }
}

// Whether tip i is skipped: its condition true (unbuilt always).
help_skipped(i: int): bool {
    u: int = htp_unless[i];
    u >= 0 && (u == HC_UNBUILT || hc_on[u] || hu_used[u])
}

// The first tip after tip cur in the order (from the start with none),
// wrapping, not skipped and not seen; or, every one seen, not skipped; -1
// if every tip is skipped.
help_after(cur: int): int {
    start: int = if (cur >= 0 && cur < htp_n) htp_pos[cur] else -1;
    for pass in 0..2 {
        for k in 0..htp_n {
            i: int = htp_order[(start + 1 + k) % htp_n];
            if (!help_skipped(i) && (pass == 1 || !ht_seen[i])) return i
        }
    }
    -1
}

help_make_current(i: int, today: int) {
    if (i < 0) return;
    ht_cur = i;
    ht_day = today;
    ht_seen[i] = true
}

// Today's tip (Go To opening): the current one, if it became so today and
// isn't skipped; else the next (made current today).
help_tip_for(today: int): int {
    if (htp_n == 0) return -1;
    if (ht_cur >= 0 && ht_day == today && !help_skipped(ht_cur)) return ht_cur;
    i: int = help_after(ht_cur);
    help_make_current(i, today);
    i
}

// Next: the one after the current, made current today.
help_next(today: int): int {
    if (htp_n == 0) return -1;
    i: int = help_after(ht_cur);
    help_make_current(i, today);
    i
}

// ---- the state's words (NSUserDefaults' strings: tipCurrent, tipSeen,
// helpUsed) ----
// The tip of id b[0..n] (-1: none, as for one removed in an update).
help_tip_named(b: []i8, n: int): int {
    for i in 0..htp_n {
        if (htp_id_e[i] - htp_id_b[i] == n) {
            same: bool = true;
            for x in 0..n
                if (hlp[htp_id_b[i] + x] != b[x]) same = false;
            if (same) return i
        }
    }
    -1
}

// tipSeen read: its ids, a space between (an unknown one passed over).
help_read_seen(b: []i8, n: int) {
    for i in 0..len(ht_seen) ht_seen[i] = false;
    p: int = 0;
    while (p < n) {
        q: int = p;
        while (q < n && b[q] as int != 32) q = q + 1;
        if (q > p) {
            for x in p..q hw[x - p] = b[x];
            i: int = help_tip_named(hw, q - p);
            if (i >= 0) ht_seen[i] = true
        }
        p = q + 1
    }
}

hw: []i8 = new i8[256](0i8);

// helpUsed read: its conditions' names, a space between.
help_read_used(b: []i8, n: int) {
    for c in 0..len(hu_used) hu_used[c] = false;
    p: int = 0;
    while (p < n) {
        q: int = p;
        while (q < n && b[q] as int != 32) q = q + 1;
        for c in 0..len(hc_names) {
            name: str = hc_names[c];
            if (len(name) == q - p) {
                same: bool = true;
                for x in 0..len(name)
                    if (b[p + x] != name[x]) same = false;
                if (same) hu_used[c] = true
            }
        }
        p = q + 1
    }
}

// The condition named name (-1: none).
help_condition(name: str): int {
    for c in 0..len(hc_names) {
        other: str = hc_names[c];
        if (len(other) == len(name)) {
            same: bool = true;
            for x in 0..len(name)
                if (other[x] != name[x]) same = false;
            if (same) return c
        }
    }
    -1
}

// tipSeen's and helpUsed's words, into fbuf.
help_fput_seen() {
    fbuf_n = 0;
    for i in 0..htp_n {
        if (ht_seen[i]) {
            if (fbuf_n > 0) fput(32);
            fput_bytes(hlp, htp_id_b[i], htp_id_e[i])
        }
    }
}

help_fput_used() {
    fbuf_n = 0;
    for c in 0..len(hc_names) {
        if (hu_used[c]) {
            if (fbuf_n > 0) fput(32);
            fput_str(hc_names[c])
        }
    }
}

help_fput_id(i: int) {
    if (i >= 0 && i < htp_n) fput_bytes(hlp, htp_id_b[i], htp_id_e[i])
}

// A part's anchor ("ribbons#making").
help_fput_anchor(t: int) {
    if (t < 0 || t >= hpt_n) return;
    g: int = hpt_page[t];
    fput_bytes(hlp, hpg_id_b[g], hpg_id_e[g]);
    fput(35);
    fput_bytes(hlp, hpt_id_b[t], hpt_id_e[t])
}

// ---- the Manual's search (§15.3.2): every word, whole, whatever its
// case (an apostrophe either way; a plural's s or es too; a word ending in
// * the start of one), over a part's heading and paragraphs ----
hq_b: []int = new int[8](0);

hq_e: []int = new int[8](0);

hq_prefix: []bool = new bool[8](false);

hq_n: int = 0;

hq: []i8 = new i8[256](0i8);

hq_len: int = 0;

// The query: its words, lower case.
help_query(b: []i8, n: int) {
    hq_n = 0;
    hq_len = 0;
    p: int = 0;
    while (p < n && hq_n < len(hq_b)) {
        while (p < n && !hq_wordy(b, p, n)) p = p + 1;
        if (p < n) {
            hq_b[hq_n] = hq_len;
            while (p < n && hq_wordy(b, p, n) && hq_len < len(hq)) {
                k: int = b[p] as int & 255;
                // (’ as ', so either matches either.)
                if (k == 226 && p + 2 < n && (b[p + 1] as int & 255) == 128 && (b[p + 2] as int & 255) == 153) {
                    hq[hq_len] = 39i8;
                    p = p + 3
                } else {
                    hq[hq_len] = help_lower(k) trunc i8;
                    p = p + 1
                }
                hq_len = hq_len + 1
            }
            hq_e[hq_n] = hq_len;
            hq_prefix[hq_n] = p < n && b[p] as int == 42;
            hq_n = hq_n + 1
        }
    }
}

// Whether the byte at p of b begins or continues a word (a letter, a
// digit, an apostrophe inside a word; a letter beyond ASCII, but not
// the punctuation of U+2000–U+206F).
hq_wordy(b: []i8, p: int, n: int): bool {
    k: int = b[p] as int & 255;
    if (help_wordy(k)) return true;
    if (k < 128) return k == 39 && p > 0 && p + 1 < n && help_wordy(b[p - 1] as int & 255) && help_wordy(b[p + 1] as int & 255);
    // (The lead byte of its character.)
    s: int = p;
    while (s > 0 && (b[s] as int & 192) == 128) s = s - 1;
    lead: int = b[s] as int & 255;
    if (lead == 226 && s + 2 < n && (b[s + 1] as int & 255) == 128) {
        // (’ inside a word is a letter's apostrophe.)
        return (b[s + 2] as int & 255) == 153 && s > 0 && help_wordy(b[s - 1] as int & 255) && s + 3 < n && help_wordy(b[s + 3] as int & 255)
    }
    lead >= 192
}

// Where query word w ends in t[0..n] if it begins whole at p (-1 if not).
hq_match(
    t: []i8,
    n: int,
    p: int,
    w: int
): int {
    if (p > 0 && hq_wordy(t, p - 1, n)) return -1;
    x: int = p;
    for j in hq_b[w]..hq_e[w] {
        if (x >= n) return -1;
        want: int = hq[j] as int & 255;
        k: int = t[x] as int & 255;
        if (want == 39 && k == 226 && x + 2 < n && (t[x + 1] as int & 255) == 128 && (t[x + 2] as int & 255) == 153) x = x + 3 else {
            if (help_lower(k) != want) return -1;
            x = x + 1
        }
    }
    if (hq_prefix[w]) {
        while (x < n && hq_wordy(t, x, n)) x = x + 1;
        return x
    }
    if (x < n && hq_wordy(t, x, n)) {
        // (A plural's s or es.)
        if (help_lower(t[x] as int & 255) == 115 && (x + 1 >= n || !hq_wordy(t, x + 1,
            n))) return x + 1;
        if (help_lower(t[x] as int & 255) == 101 && x + 1 < n && help_lower(t[x + 1] as int & 255) == 115 && (x + 2 >= n || !hq_wordy(t,
            x + 2, n))) return x + 2;
        return -1
    }
    x
}

// The first place query word w is in t[0..n] (-1: none); its end in
// hq_at_end.
hq_at_end: int = 0;

hq_find(
    t: []i8,
    n: int,
    from: int,
    w: int
): int {
    for p in from..n {
        e: int = hq_match(t, n, p, w);
        if (e >= 0) {
            hq_at_end = e;
            return p
        }
    }
    -1
}

// The heading's words, plain, into hx.
help_heading_plain(t: int) {
    hx_n = 0;
    for x in hpt_head_b[t]..hpt_head_e[t] hx_put(hlb(x))
}

// Whether part t has every word of the query.
help_part_matches(t: int): bool {
    if (hq_n == 0) return false;
    for w in 0..hq_n {
        found: bool = false;
        help_heading_plain(t);
        if (hq_find(hx, hx_n, 0, w) >= 0) found = true;
        for a in hpt_para0[t]..hpt_para0[t] + hpt_paras[t] {
            if (!found) {
                help_plain(a, false);
                if (hq_find(hx, hx_n, 0, w) >= 0) found = true
            }
        }
        if (!found) return false
    }
    true
}

// The parts that match, in the file's order.
hm_n: int = 0;

hm_part: []int = new int[256](0);

help_search(b: []i8, n: int) {
    help_query(b, n);
    hm_n = 0;
    for t in 0..hpt_n {
        if (help_part_matches(t)) {
            hm_part[hm_n] = t;
            hm_n = hm_n + 1
        }
    }
}

// A matching part's snippet: the first paragraph with a word of the query
// (else its first), plain in hx from hsn_from, "… " before it when it
// starts after the paragraph's start (a few words before the first
// match); and every match in it from there (hsn_mb, hsn_me).
hsn_pa: int = 0;

hsn_from: int = 0;

hsn_n: int = 0;

hsn_mb: []int = new int[32](0);

hsn_me: []int = new int[32](0);

help_snippet(t: int) {
    hsn_pa = hpt_para0[t];
    first: int = -1;
    for a in hpt_para0[t]..hpt_para0[t] + hpt_paras[t] {
        if (first < 0) {
            help_plain(a, false);
            for w in 0..hq_n {
                p: int = hq_find(hx, hx_n, 0, w);
                if (p >= 0 && (first < 0 || p < first)) {
                    first = p;
                    hsn_pa = a
                }
            }
        }
    }
    help_plain(hsn_pa, false);
    hsn_from = 0;
    if (first > 60) {
        // (Four words back.)
        s: int = first;
        words: int = 0;
        while (s > 0 && words < 4) {
            s = s - 1;
            if (hx[s] as int == 32) words = words + 1
        }
        hsn_from = (if (words == 4) s + 1 else 0)
    }
    hsn_n = 0;
    p: int = hsn_from;
    while (p < hx_n && hsn_n < len(hsn_mb)) {
        best: int = -1;
        best_e: int = 0;
        for w in 0..hq_n {
            q: int = hq_find(hx, hx_n, p, w);
            if (q >= 0 && (best < 0 || q < best)) {
                best = q;
                best_e = hq_at_end
            }
        }
        if (best < 0) p = hx_n else {
            hsn_mb[hsn_n] = best;
            hsn_me[hsn_n] = best_e;
            hsn_n = hsn_n + 1;
            p = best_e
        }
    }
}
