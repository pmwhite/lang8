tag bible_ios;

use_tag std, ios, bible;

// The reader's bar (DESIGN.md §3.1.4), as Safari's address bar: the
// navigation controller's own bar is hidden for good, and this one, drawn
// from real buttons in a view pinned to the top, collapses in step with the
// scroll to the chapter's name in small type under the status bar, and
// expands again the same way. The table's top inset stays the expanded
// bar's, so the bar overlays the text and never moves it: collapsing only
// uncovers the lines under it.
import "../ios/objc.l8";

import "text.l8";

extern CACurrentMediaTime(): f64;

extern UIAccessibilityIsVoiceOverRunning(): int;

// The bar's heights: expanded and compact (below the status bar).
BAR_E: f64 = 44.0f64;

BAR_C: f64 = 20.0f64;

// How much scroll collapses it all, and how far back up before it
// begins to come back.
BAR_TRAVEL: f64 = 48.0f64;

BAR_HYSTERESIS: f64 = 12.0f64;

// The view holding it all, its buttons (search, library, the settings),
// and the chapter's name in small type.
rbar: int = 0;

bar_buttons: []int = new int[3](0);

compact_button: int = 0;

// How collapsed it is (0 expanded, 1 collapsed), and the status bar's
// height.
bar_p: f64 = 0.0f64;

bar_s: f64 = 0.0f64;

// The opener's fade (1 once the chapter's opener is under the bar): both
// titles obey it.
bar_f: f64 = 0.0f64;

// The scroll last seen, the way it last went (1 down the text, -1 back
// up), and how far it has gone back up without a stop.
last_scroll_y: f64 = 0.0f64;

last_dir: int = 1;

up_travel: f64 = 0.0f64;

// A drag began (so the deceleration after it moves the bar too).
drag_seen: bool = false;

// The demo's steps of the offset count as a finger's.
demo_tracking: bool = false;

bar_button(name: str, action: str, label: str): int {
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setImage:"), symbol(name, 17.0f64, 4, 0));
    b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel(action), 64);
    msg1(b, sel("setAccessibilityLabel:"), nsstring(label));
    // (Shown large by a long press at the largest text sizes.)
    msg1(b, sel("setShowsLargeContentViewer:"), 1);
    msg1(b, sel("setLargeContentTitle:"), nsstring(label));
    msg1(b, sel("setLargeContentImage:"), symbol(name, 17.0f64, 4, 0));
    msg_rect(b, sel("setBounds:"), 0.0f64, 0.0f64, 44.0f64, 44.0f64);
    msg1(rbar, sel("addSubview:"), b);
    b
}

// The bar, made once (over the chapters, in the navigation controller's
// view).
make_bar() {
    root: int = msg(nav, sel("view"));
    rbar = make("UIView");
    msg1(rbar, sel("setClipsToBounds:"), 0);
    backdrop = make("UIView");
    msg1(backdrop, sel("setUserInteractionEnabled:"), 0);
    backdrop_fade = make("UIView");
    msg1(backdrop_fade, sel("setUserInteractionEnabled:"), 0);
    backdrop_gradient = make("CAGradientLayer");
    msg1(msg(backdrop_fade, sel("layer")), sel("addSublayer:"), backdrop_gradient);
    msg1(rbar, sel("addSubview:"), backdrop);
    msg1(rbar, sel("addSubview:"), backdrop_fade);
    bar_buttons[0] = bar_button("magnifyingglass", "showSearch:", "Search");
    bar_buttons[1] = bar_button("bookmark", "showLibrary:", "Library");
    bar_buttons[2] = bar_button("textformat.size", "showSettings:", "Reading Settings");
    msg1(rbar, sel("addSubview:"), title_view);
    compact_button = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration")), 0);
    msg3(compact_button, sel("addTarget:action:forControlEvents:"), app_obj, sel("barCompactTapped:"),
        64);
    msg1(compact_button, sel("setAccessibilityHint:"), nsstring("Shows the toolbar"));
    msg1(rbar, sel("addSubview:"), compact_button);
    // (The large content viewer, for its buttons and title, as system bars
    // have.)
    msg1(rbar, sel("addInteraction:"), msg(make("UILargeContentViewerInteraction"),
        sel("autorelease")));
    msg1(root, sel("addSubview:"), rbar);
    if (responds(table, "topEdgeEffect")) msg1(msg(table, sel("topEdgeEffect")), sel("setHidden:"),
        1)
}

// The status bar's height now.
status_height(): f64 {
    l8_msg_hfa(hfa, msg(nav, sel("view")), sel("safeAreaInsets"), 0, 0, 0);
    hfa[0]
}

// The table's insets: the expanded bar's at the top, whatever the bar does
// (made again only when the safe area or the text's size changes).
set_insets() {
    if (table == 0 || nav == 0) return;
    bar_s = status_height();
    l8_msg_hfa(hfa, msg(nav, sel("view")), sel("safeAreaInsets"), 0, 0, 0);
    bottom: f64 = hfa[2];
    msg1(table, sel("setContentInsetAdjustmentBehavior:"), 2);
    l8_msg_hfa(hfa, table, sel("contentInset"), 0, 0, 0);
    if (hfa[0] == bar_s + BAR_E && hfa[2] == bottom) return;
    msg_rect(table, sel("setContentInset:"), bar_s + BAR_E, 0.0f64, bottom, 0.0f64);
    msg_rect(table, sel("setVerticalScrollIndicatorInsets:"), bar_s + BAR_E, 0.0f64,
        bottom, 0.0f64);
    note_num("bible: bar S ", bar_s as int)
}

reader_safe_area(self: int, cmd: int): int {
    super0(self, reader_class, cmd);
    set_insets();
    layout_bar();
    0
}

// The bar's bottom now (from the screen's top).
bar_bottom(): f64 {
    bar_s + BAR_E - (BAR_E - BAR_C) * bar_p
}

clamp01(x: f64): f64 {
    if (x < 0.0f64) 0.0f64 else if (x > 1.0f64) 1.0f64 else x
}

// Everything in the bar placed and faded for bar_p (no implicit
// animations: it follows the finger).
layout_bar() {
    if (rbar == 0) return;
    root: int = msg(nav, sel("view"));
    W: f64 = view_width(root);
    s: f64 = status_height();
    if (s > 0.0f64) bar_s = s;
    p: f64 = bar_p;
    h: f64 = bar_bottom();
    msg(cls("CATransaction"), sel("begin"));
    msg1(cls("CATransaction"), sel("setDisableActions:"), 1);
    msg_rect(rbar, sel("setFrame:"), 0.0f64, 0.0f64, W, h);
    msg_rect(backdrop, sel("setFrame:"), 0.0f64, 0.0f64, W, h);
    msg_rect(backdrop_fade, sel("setFrame:"), 0.0f64, h, W, 18.0f64);
    msg_rect(backdrop_gradient, sel("setFrame:"), 0.0f64, 0.0f64, W, 18.0f64);
    // The row's middle, going up with the bar to the compact band's.
    cy: f64 = bar_s + (h - bar_s) / 2.0f64;
    // The buttons shrink as they fade, and grow as they come back; the
    // title is the one thing that stays, shrinking to the compact band's
    // type (12 pt for 17) and growing back, never swapped for another.
    fade: f64 = clamp01(1.0f64 - 1.6f64 * p);
    scale: f64 = 1.0f64 - 0.5f64 * p;
    xs: []f64 = bar_xs;
    xs[0] = 30.0f64;
    xs[1] = W - 74.0f64;
    xs[2] = W - 30.0f64;
    for i in 0..3 {
        b: int = bar_buttons[i];
        msg_ff(b, sel("setCenter:"), xs[i], cy);
        msg_set_f(b, sel("setAlpha:"), fade);
        msg2(msg(b, sel("layer")), sel("setValue:forKeyPath:"), nsnumber_f(scale),
            nsstring("transform.scale"));
        msg1(b, sel("setUserInteractionEnabled:"), if (p <= 0.5f64) 1 else 0)
    }
    msg_ff(title_view, sel("setCenter:"), W / 2.0f64, cy);
    msg2(msg(title_view, sel("layer")), sel("setValue:forKeyPath:"), nsnumber_f(1.0f64 - 5.0f64 / 17.0f64 * p),
        nsstring("transform.scale"));
    msg_set_f(title_fader, sel("setAlpha:"), title_alpha());
    msg1(title_button, sel("setUserInteractionEnabled:"), if (p <= 0.5f64) 1 else 0);
    // The compact band's whole width a tap that expands the bar (over the
    // title, small in it).
    msg_rect(compact_button, sel("setBounds:"), 0.0f64, 0.0f64, W, bar_s + BAR_C);
    msg_ff(compact_button, sel("setCenter:"), W / 2.0f64, (bar_s + BAR_C) / 2.0f64);
    msg1(compact_button, sel("setUserInteractionEnabled:"), if (p > 0.5f64) 1 else 0);
    msg(cls("CATransaction"), sel("commit"))
}

bar_xs: []f64 = new f64[3](0.0f64);

// The title's alpha: the opener's fade, and ink at 75% once small.
title_alpha(): f64 {
    bar_f * (1.0f64 - 0.25f64 * bar_p)
}

// The compact band's name for VoiceOver (it shows nothing of its own: the
// title shrinks into it).
set_compact_title(name: int) {
    if (compact_button == 0) return;
    msg1(compact_button, sel("setAccessibilityLabel:"), name)
}

// The bar's colors, for the theme.
style_bar() {
    if (rbar == 0) return;
    for i in 0..3 msg1(bar_buttons[i], sel("setTintColor:"), c_icon);
    msg1(backdrop, sel("setBackgroundColor:"), c_bg);
    msg(cls("CATransaction"), sel("begin"));
    msg1(cls("CATransaction"), sel("setDisableActions:"), 1);
    one[0] = msg(c_bg, sel("CGColor"));
    one[1] = msg(msg_set_f(c_bg, sel("colorWithAlphaComponent:"), 0.0f64), sel("CGColor"));
    msg1(backdrop_gradient, sel("setColors:"), nsarray(one, 2));
    msg(cls("CATransaction"), sel("commit"));
    layout_bar()
}

// (Where the old bar's backdrop was placed: the bar is laid out.)
place_backdrop() {
    layout_bar()
}

// ---- following the scroll ----
voice_over(): bool {
    (UIAccessibilityIsVoiceOverRunning() & 255) != 0
}

bar_set(p: f64) {
    q: f64 = clamp01(p);
    if (voice_over()) q = 0.0f64;
    if (q == bar_p) return;
    bar_p = q;
    bars_hidden = q >= 1.0f64;
    title_fade();
    layout_bar()
}

// The scroll moved (the table's delegate): the bar in step with it, while a
// finger moves it or it glides on after one.
bar_scrolled(sv: int) {
    y: f64 = offset_y(sv);
    dy: f64 = y - last_scroll_y;
    last_scroll_y = y;
    rest: f64 = -(bar_s + BAR_E);
    l8_msg_hfa(hfa, sv, sel("contentSize"), 0, 0, 0);
    most: f64 = hfa[1] + bottom_inset(sv) - view_height(sv);
    moving: bool = (msg(sv, sel("isTracking")) & 255) != 0 || demo_tracking || drag_seen && (msg(sv,
        sel("isDecelerating")) & 255) != 0;
    p: f64 = bar_p;
    if (moving && y >= rest && y <= most && bar_anim_link == 0) {
        if (dy > 0.0f64) {
            up_travel = 0.0f64;
            last_dir = 1;
            p = p + dy / BAR_TRAVEL
        } else if (dy < 0.0f64) {
            before: f64 = up_travel;
            up_travel = up_travel - dy;
            last_dir = -1;
            if (up_travel > BAR_HYSTERESIS) {
                by: f64 = up_travel - (if (before > BAR_HYSTERESIS) before else BAR_HYSTERESIS);
                p = p - by / BAR_TRAVEL
            }
        }
    }
    // (Near the top, never more collapsed than the text is down from it.)
    cap: f64 = (y - rest) / BAR_TRAVEL;
    if (p > cap) p = cap;
    if (p != bar_p) {
        bar_stop();
        bar_set(p)
    }
}

bar_drag_began() {
    drag_seen = true;
    up_travel = 0.0f64
}

// Scrolling stopped: a bar half collapsed goes on the way it last went.
bar_settle() {
    drag_seen = false;
    if (bar_p > 0.0f64 && bar_p < 1.0f64) bar_animate_to(if (last_dir > 0) 1.0f64 else 0.0f64)
}

// ---- animating it (0.25 s, easing out; a cross-fade with Reduce Motion) ----
bar_anim_link: int = 0;

bar_from: f64 = 0.0f64;

bar_to: f64 = 0.0f64;

bar_t0: f64 = 0.0f64;

bar_stop() {
    if (bar_anim_link != 0) {
        msg(bar_anim_link, sel("invalidate"));
        bar_anim_link = 0
    }
}

bar_animate_to(p: f64) {
    to: f64 = if (voice_over()) 0.0f64 else p;
    bars_hidden = to >= 1.0f64;
    if (to == bar_p) {
        bar_stop();
        return
    }
    if (reduce_motion() || rbar == 0) {
        bar_stop();
        if (rbar != 0) fade_layer(msg(rbar, sel("layer")), 0.15f64);
        bar_set(to);
        return
    }
    if (bar_anim_link != 0 && bar_to == to) return;
    bar_stop();
    bar_from = bar_p;
    bar_to = to;
    bar_t0 = CACurrentMediaTime();
    bar_anim_link = keep(msg2(cls("CADisplayLink"), sel("displayLinkWithTarget:selector:"),
        app_obj, sel("barTick:")));
    msg2(bar_anim_link, sel("addToRunLoop:forMode:"), msg(cls("NSRunLoop"), sel("mainRunLoop")),
        l8_run_loop_common_modes())
}

bar_tick(_self: int, _cmd: int, _link: int): int {
    t: f64 = (CACurrentMediaTime() - bar_t0) / 0.25f64;
    if (t >= 1.0f64) {
        link: int = bar_anim_link;
        bar_anim_link = 0;
        if (link != 0) {
            msg(link, sel("invalidate"));
            release(link)
        }
        bar_set(bar_to);
        return 0
    }
    u: f64 = 1.0f64 - t;
    bar_set(bar_from + (bar_to - bar_from) * (1.0f64 - u * u * u));
    0
}

// Expanded (a sheet opening, a jump), or collapsed.
bar_expand() {
    bar_animate_to(0.0f64)
}

bar_compact_tapped(_self: int, _cmd: int, _b: int): int {
    bar_expand();
    0
}

add_bar_methods(app: int) {
    add_method1(app, sel("barTick:"), &bar_tick, "v@:@");
    add_method1(app, sel("barCompactTapped:"), &bar_compact_tapped, "v@:@")
}
