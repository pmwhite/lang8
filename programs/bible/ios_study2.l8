tag bible_ios;

use_tag std, ios, bible;

// The Study sheet (DESIGN.md Â§9.6.2): the tray's Study opens a verse's
// sheet whose bar's title is a segmented control, Words Â· References Â·
// Commentary. Words is the interlinear (ios_study.l8); References the
// verse's cross references from OpenBible.info, most votes first, each one
// a preview pushed when tapped; Commentary Matthew Henry's Concise
// Commentary on the section the verse is in, its references previews too.
// Each begins with the verse's reference and words. The segment last shown
// is kept (studySegment), and set before the sheet comes up. Verses are the
// BSB's numbering: in another version, the words shown are its own where it
// is on the phone, else the BSB's.
import "../ios/objc.l8";

import "text.l8";

import "lang.l8";

extern msg_rect1(
    receiver: int,
    selector: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    a: int
): int = objc_msgSend;

sv_class: int = 0;

sv_vc: int = 0;

sv_seg: int = 0;

// The content's box (each segment's view in it, one at a time).
sv_box: int = 0;

sv_view: int = 0;

// The verse studied (chapter and verse, the BSB's numbering), and the
// segment shown.
sv_c: int = 0;

sv_v: int = 0;

sv_segment: int = 0;

sv_width: f64 = 0.0f64;

// The Study sheet of verse v of chapter c, from the tray.
open_study_verse(c: int, v: int) {
    if (presented() != 0) return;
    lang_load();
    if (!lang_ready) return;
    sv_c = c;
    sv_v = v;
    origin_c = c;
    origin_v = v;
    sv_segment = clamp(def_int("studySegment"), 0, 2);
    vc: int = msg(msg(msg(sv_class, sel("alloc")), sel("init")), sel("autorelease"));
    sv_vc = vc;
    view: int = msg(vc, sel("view"));
    msg1(view, sel("setBackgroundColor:"), c_bg);
    sv_box = make("UIView");
    msg1(sv_box, sel("setAutoresizingMask:"), 18);
    l8_msg_hfa(hfa, view, sel("bounds"), 0, 0, 0);
    msg_rect(sv_box, sel("setFrame:"), 0.0f64, 0.0f64, hfa[2], hfa[3]);
    msg1(view, sel("addSubview:"), sv_box);
    release(sv_box);
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    msg1(item, sel("setRightBarButtonItem:"), system_item(0, "closeSheet:"));
    one[0] = nsstring("Words");
    one[1] = nsstring("References");
    one[2] = nsstring("Commentary");
    sv_seg = msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
        nsarray(one, 3));
    msg1(sv_seg, sel("setSelectedSegmentIndex:"), sv_segment);
    msg3(sv_seg, sel("addTarget:action:forControlEvents:"), app_obj, sel("studySegment:"),
        4096);
    msg_rect(sv_seg, sel("setFrame:"), 0.0f64, 0.0f64, 300.0f64, 32.0f64);
    msg1(item, sel("setTitleView:"), sv_seg);
    release(sv_seg);
    sv_back_title();
    sv_width = 0.0f64;
    sv_show(false);
    sheet_nav: int = sheet_of(vc, 1);
    sheet: int = msg(sheet_nav, sel("sheetPresentationController"));
    if (sheet != 0) msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const("UISheetPresentationControllerDetentIdentifierMedium"));
    msg2(sheet_nav, sel("setToolbarHidden:animated:"), 0, 0);
    msg1(msg(sheet_nav, sel("toolbar")), sel("setTintColor:"), c_icon);
    present(sheet_nav)
}

// The interlinear of a verse (the study group's demo, the Words segment).
open_interlinear(c: int, v: int) {
    set_def_int("studySegment", 0);
    open_study_verse(c, v)
}

// What a push from the sheet goes back to: "John 3:16".
sv_back_title() {
    if (sv_vc == 0) return;
    fbuf_n = 0;
    one_verse[0] = sv_v;
    put_ref(sv_c, one_verse, 1);
    msg1(msg(sv_vc, sel("navigationItem")), sel("setBackButtonTitle:"), fstring())
}

study_sheet_gone() {
    sv_vc = 0;
    sv_box = 0;
    sv_view = 0;
    cm_tv = 0;
    xref_table = held(xref_table, 0)
}

// The segment's view made, in the box (the last one's let go), and its
// toolbar.
sv_show(animated: bool) {
    if (sv_box == 0) return;
    if (sv_view != 0) msg(sv_view, sel("removeFromSuperview"));
    sv_view = 0;
    il_scroll = 0;
    xref_table = held(xref_table, 0);
    cm_tv = 0;
    msg1(sv_vc, sel("setContentUnavailableConfiguration:"), 0);
    l8_msg_hfa(hfa, sv_box, sel("bounds"), 0, 0, 0);
    W: f64 = hfa[2];
    H: f64 = hfa[3];
    if (sv_segment == 0) {
        vi: int = lang_verse(sv_c, sv_v);
        il_vc = 0;
        if (vi >= 0 && v_aligned(vi) && v_end(vi) > v_first(vi)) {
            il_setup(sv_box, vi);
            sv_view = il_scroll;
            il_width = W;
            if (W > 0.0f64) il_build();
            il_toolbar(sv_vc, animated)
        } else {
            sv_words_empty(vi);
            sv_chevrons(animated)
        }
    } else {
        if (sv_segment == 1) sv_view = make_xrefs(W) else sv_view = make_commentary(W,
            H);
        msg1(sv_box, sel("addSubview:"), sv_view);
        sv_chevrons(animated)
    }
    // (The bar and toolbar told of the new scroll view, iOS 26's edges.)
    sheet_edges(sv_vc)
}

// The toolbar of References and Commentary: the verse before, and after.
sv_chevrons(animated: bool) {
    if (sv_vc != 0) {
        prev: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
            symbol("chevron.up", 17.0f64, 4, 0), 0, app_obj, sel("studyPrevious:")),
            sel("autorelease"));
        msg1(prev, sel("setAccessibilityLabel:"), nsstring("Previous Verse"));
        next: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
            symbol("chevron.down", 17.0f64, 4, 0), 0, app_obj, sel("studyNext:")),
            sel("autorelease"));
        msg1(next, sel("setAccessibilityLabel:"), nsstring("Next Verse"));
        bar_items[0] = prev;
        bar_items[1] = msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
            5, 0, 0), sel("autorelease"));
        bar_items[2] = next;
        msg1(prev, sel("setTintColor:"), c_icon);
        msg1(next, sel("setTintColor:"), c_icon);
        msg2(sv_vc, sel("setToolbarItems:animated:"), nsarray(bar_items, 3), if (animated) 1 else 0)
    }
}

// Words for a verse with no interlinear: absent from the BSB (KJV Matthew
// 17:21), or not aligned with the original's words.
sv_words_empty(vi: int) {
    fbuf_n = 0;
    one_verse[0] = sv_v;
    put_ref(sv_c, one_verse, 1);
    where: int = fstring();
    fbuf_n = 0;
    if (vi < 0) {
        fput_str("The BSB gives ");
        n: int = nsstring_into(where, sv_name);
        for i in 0..n fput(sv_name[i] as int);
        fput_str(" in a footnote. The interlinear follows the BSB.")
    } else {
        n: int = nsstring_into(where, sv_name);
        for i in 0..n fput(sv_name[i] as int);
        fput_str(" isn\â\€\™t aligned with the original words.")
    }
    empty_state(sv_vc, 0, "character.book.closed", nsstring(if (vi < 0) "Not in the BSB" else "No Interlinear"),
        "");
    config: int = msg(sv_vc, sel("contentUnavailableConfiguration"));
    if (config != 0) {
        c2: int = msg(config, sel("copy"));
        msg1(c2, sel("setSecondaryText:"), fstring());
        msg1(sv_vc, sel("setContentUnavailableConfiguration:"), c2);
        release(c2)
    }
}

sv_name: []i8 = new i8[128](0i8);

// The sheet laid out (as its width is known, or changes): the segment's
// view made again for it.
sv_layout(self: int, cmd: int): int {
    super0(self, sv_class, cmd);
    if (sv_box == 0) return 0;
    w: f64 = view_width(sv_box);
    if (w != sv_width && w > 0.0f64) {
        sv_width = w;
        if (sv_segment == 0 && il_scroll != 0) {
            il_width = w;
            il_build()
        } else if (sv_segment != 0) sv_show(false)
    }
    0
}

// A segment chosen: kept, and the box cross-fading to it (0.2 s), the
// toolbar's items fading.
study_segment(_self: int, _cmd: int, seg: int): int {
    sv_segment = msg(seg, sel("selectedSegmentIndex"));
    set_def_int("studySegment", sv_segment);
    fade_layer(msg(sv_box, sel("layer")), 0.2f64);
    sv_show(true);
    0
}

// The interlinear moved on (its chevrons): the sheet's verse with it.
study_verse_moved(c: int, v: int) {
    if (sv_vc == 0) return;
    sv_c = c;
    sv_v = v;
    sv_back_title()
}

// The chevrons of References and Commentary: the verse before or after,
// verse by verse (the BSB's), across chapters.
study_step(d: int) {
    vi: int = lang_verse(sv_c, sv_v);
    if (vi < 0) {
        // (A verse the BSB lacks: from the one before it.)
        x: int = sv_v - 1;
        while (x > 0 && lang_verse(sv_c, x) < 0) x = x - 1;
        vi = lang_verse(sv_c, x);
        if (d < 0) d = 0
    }
    vi = vi + d;
    if (vi < 0 || vi >= lv_n) return;
    was_k: int = mh_k;
    sv_c = v_chapter(vi);
    sv_v = v_num(vi);
    sv_back_title();
    if (sv_segment == 1) {
        fade_layer(msg(sv_box, sel("layer")), 0.2f64);
        sv_show(false)
    } else if (cm_tv != 0) commentary_moved(was_k)
}

study_previous(_self: int, _cmd: int, _b: int): int {
    study_step(-1);
    0
}

study_next(_self: int, _cmd: int, _b: int): int {
    study_step(1);
    0
}

// ---- the verse's header (Â§9.6.2) ----
// The reference (SF 13 semibold, faint), then the verse in the reader's
// body font at 0.9 em, 16 pt below: as a view W wide; its height in hfa[1].
verse_header(W: f64): int {
    v: int = msg(msg_rect(msg(cls("UIView"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, W, 100.0f64), sel("autorelease"));
    fbuf_n = 0;
    one_verse[0] = sv_v;
    put_ref(sv_c, one_verse, 1);
    where: int = label_of(attributed(fstring(), sans(13.0f64, 0.3f64), c_faint));
    msg1(where, sel("setTextAlignment:"), 0);
    label_size(where, W - 40.0f64);
    h1: f64 = hfa[1];
    msg_rect(where, sel("setFrame:"), 20.0f64, 16.0f64, W - 40.0f64, h1);
    msg1(v, sel("addSubview:"), where);
    t: int = quote_text(sv_c, sv_v);
    size: f64 = em * 0.9f64;
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    if (t >= 0) {
        _n: int = verse_text_of(t, sv_c, sv_v);
        text: int = nsstring_of(vt, vt_n);
        append(s, text, body(size), c_ink);
        caps_into(s, 0, text, true, size);
        if (t != text_cur) {
            fbuf_n = 0;
            fput(32);
            fput_str(text_abbrs[t]);
            append(s, fstring(), sans(size * 0.62f64, 0.3f64), c_faint)
        }
    }
    p: int = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 0.0f64, 1.3f64), sel("autorelease"));
    msg4(s, sel("addAttribute:value:range:"), k_para, p, 0, msg(s, sel("length")));
    verse: int = msg(make("UILabel"), sel("autorelease"));
    msg1(verse, sel("setNumberOfLines:"), 0);
    msg1(verse, sel("setAttributedText:"), s);
    label_size(verse, W - 40.0f64);
    h2: f64 = hfa[1];
    msg_rect(verse, sel("setFrame:"), 20.0f64, 16.0f64 + h1 + 16.0f64, W - 40.0f64,
        h2);
    msg1(v, sel("addSubview:"), verse);
    h: f64 = 16.0f64 + h1 + 16.0f64 + h2 + 8.0f64;
    msg_rect(v, sel("setFrame:"), 0.0f64, 0.0f64, W, h);
    hfa[1] = h;
    v
}

// ---- References (Â§9.6.3) ----
xref_table: int = 0;

// The verse's targets, and how many are shown (12, until Show All).
xr_vi: int = -1;

xr_total: int = 0;

xr_shown: int = 0;

make_xrefs(W: f64): int {
    l8_msg_hfa(hfa, sv_box, sel("bounds"), 0, 0, 0);
    t: int = msg(msg_rect1(msg(cls("UITableView"), sel("alloc")), sel("initWithFrame:style:"),
        0.0f64, 0.0f64, hfa[2], hfa[3], 2), sel("autorelease"));
    msg1(t, sel("setAutoresizingMask:"), 18);
    xref_table = held(xref_table, t);
    xr_vi = lang_verse(sv_c, sv_v);
    xr_total = (if (xr_vi >= 0) xref_count(xr_vi) else 0);
    xr_shown = (if (xr_total > 13) 12 else xr_total);
    msg1(t, sel("setDataSource:"), app_obj);
    msg1(t, sel("setDelegate:"), app_obj);
    style_table(t, true);
    msg_set_f(t, sel("setRowHeight:"), objc_const_f("UITableViewAutomaticDimension"));
    msg_set_f(t, sel("setEstimatedRowHeight:"), 72.0f64);
    msg1(t, sel("setTableHeaderView:"), verse_header(W));
    if (xr_total == 0) {
        fbuf_n = 0;
        fput_str("OpenBible.info lists none for ");
        one_verse[0] = sv_v;
        put_ref(sv_c, one_verse, 1);
        fput(46);
        empty_state(sv_vc, 0, "arrow.triangle.branch", nsstring("No Cross References"),
            "");
        sv_secondary(fstring())
    }
    t
}

// The empty state's second line (made of fbuf, not a literal).
sv_secondary(line: int) {
    config: int = msg(sv_vc, sel("contentUnavailableConfiguration"));
    if (config == 0) return;
    c2: int = msg(config, sel("copy"));
    msg1(c2, sel("setSecondaryText:"), line);
    msg1(sv_vc, sel("setContentUnavailableConfiguration:"), c2);
    release(c2)
}

xref_rows(): int {
    xr_shown + (if (xr_shown < xr_total) 1 else 0)
}

xref_footer(): int {
    if (xr_total == 0) return 0;
    nsstring(if (text_cur == TEXT_ESV) "From OpenBible.info, ranked by readers\â\€\™ votes. Verses shown in the BSB." else "From OpenBible.info, ranked by readers\â\€\™ votes.")
}

xref_cell(_tv: int, path: int): int {
    r: int = msg(path, sel("row"));
    cell: int = msg(msg2(msg(cls("UITableViewCell"), sel("alloc")), sel("initWithStyle:reuseIdentifier:"),
        0, 0), sel("autorelease"));
    msg1(cell, sel("setBackgroundColor:"), cell_bg());
    if (r >= xr_shown) {
        config: int = list_config(0);
        fbuf_n = 0;
        fput_str("Show All ");
        fput_int(xr_total);
        msg1(config, sel("setText:"), fstring());
        msg1(text_props(config), sel("setColor:"), c_accent);
        msg1(text_props(config), sel("setAlignment:"), 1);
        msg1(cell, sel("setContentConfiguration:"), config);
        return cell
    }
    xref_at(xr_vi, r);
    ref: int = xref_both();
    content: int = msg(cell, sel("contentView"));
    column: int = stack(1, 3.0f64);
    name: int = make("UILabel");
    fbuf_n = 0;
    fput_xref(ref);
    msg1(name, sel("setText:"), fstring());
    msg1(name, sel("setFont:"), sans(15.0f64, 0.4f64));
    msg1(name, sel("setTextColor:"), c_accent);
    msg1(column, sel("addArrangedSubview:"), name);
    release(name);
    // (Its first verse: the version read, if on the phone, else the BSB.)
    xref_unpack(ref);
    c: int = xref_chapter();
    v: int = if (xr_v > 0) xr_v else 1;
    t: int = quote_text(c, v);
    words: int = make("UILabel");
    metrics: int = msg1(cls("UIFontMetrics"), sel("metricsForTextStyle:"), objc_const("UIFontTextStyleBody"));
    size: f64 = msg_f_f(metrics, sel("scaledValueForValue:"), 16.0f64);
    if (t >= 0) {
        _n: int = verse_text_of(t, c, v);
        msg1(words, sel("setAttributedText:"), preview(nsstring_of(vt, vt_n), true,
            size, msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.8f64)))
    }
    msg1(words, sel("setNumberOfLines:"), 3);
    msg1(words, sel("setLineBreakMode:"), 4);
    msg1(column, sel("addArrangedSubview:"), words);
    release(words);
    msg1(content, sel("addSubview:"), column);
    pin_by(column, content, "leadingAnchor", 16.0f64);
    pin_by(column, content, "trailingAnchor", -16.0f64);
    pin_by(column, content, "topAnchor", 12.0f64);
    pin_by(column, content, "bottomAnchor", -12.0f64);
    fbuf_n = 0;
    fput_xref(ref);
    fput_str(". ");
    if (t >= 0) {
        _n2: int = verse_text_of(t, c, v);
        for i in 0..vt_n fput(vt[i] as int)
    }
    msg1(cell, sel("setAccessibilityLabel:"), fstring());
    msg1(cell, sel("setAccessibilityHint:"), nsstring("Shows the passage"));
    msg1(cell, sel("setSelectionStyle:"), 3);
    cell
}

// A row: its passage previewed (pushed on the sheet, the back button the
// verse's reference); or Show All, the rest faded in and the row gone.
xref_picked(r: int) {
    if (r >= xr_shown) {
        was: int = xr_shown;
        xr_shown = xr_total;
        msg(xref_table, sel("beginUpdates"));
        one[0] = msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), was,
            0);
        msg2(xref_table, sel("deleteRowsAtIndexPaths:withRowAnimation:"), nsarray(one,
            1), 0);
        paths: int = make("NSMutableArray");
        for i in was..xr_total msg1(paths, sel("addObject:"), msg2(cls("NSIndexPath"),
            sel("indexPathForRow:inSection:"), i, 0));
        msg2(xref_table, sel("insertRowsAtIndexPaths:withRowAnimation:"), paths, 0);
        release(paths);
        msg(xref_table, sel("endUpdates"));
        return
    }
    xref_at(xr_vi, r);
    push_preview(xref_both())
}

// ---- Commentary (Â§9.7.2) ----
cm_tv: int = 0;

make_commentary(W: f64, H: f64): int {
    tv: int = msg(make("UITextView"), sel("autorelease"));
    cm_tv = tv;
    msg1(tv, sel("setEditable:"), 0);
    msg1(tv, sel("setSelectable:"), 1);
    msg1(tv, sel("setBackgroundColor:"), c_bg);
    msg1(tv, sel("setTintColor:"), c_accent);
    msg1(tv, sel("setAlwaysBounceVertical:"), 1);
    msg1(tv, sel("setAutoresizingMask:"), 18);
    msg_rect(tv, sel("setFrame:"), 0.0f64, 0.0f64, W, H);
    msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
    // (Long-press: the system's own menu, as the text has no chapter.)
    msg1(tv, sel("setDelegate:"), app_obj);
    tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("commentaryTapped:"));
    msg1(tap, sel("setDelegate:"), app_obj);
    msg1(tv, sel("addGestureRecognizer:"), tap);
    release(tap);
    commentary_fill(W);
    tv
}

// The header (the verse) over the text, in the text view, and the text
// under it: the section's verses, Henry's paragraphs, his name.
commentary_fill(W: f64) {
    if (cm_tv == 0) return;
    head: int = msg1(cm_tv, sel("viewWithTag:"), 5150);
    if (head != 0) msg(head, sel("removeFromSuperview"));
    hv: int = verse_header(W);
    hh: f64 = hfa[1];
    msg1(hv, sel("setTag:"), 5150);
    msg1(cm_tv, sel("addSubview:"), hv);
    m: f64 = side_margin();
    // (The text under the header's own margins, its range 20 pt under the
    // verse, Â§9.7.2: the header's own 8, and 12; a first paragraph's space
    // before it would not be kept.)
    msg_rect(cm_tv, sel("setTextContainerInset:"), hh + 12.0f64, 20.0f64, 28.0f64,
        20.0f64);
    _m: f64 = m;
    if (!mhcc_section(sv_c, sv_v)) {
        msg1(cm_tv, sel("setAttributedText:"), attributed_str(nsstring(""), 0));
        fbuf_n = 0;
        fput_str("Matthew Henry\â\€\™s Concise Commentary has no comment on ");
        one_verse[0] = sv_v;
        put_ref(sv_c, one_verse, 1);
        fput(46);
        empty_state(sv_vc, 0, "text.book.closed", nsstring("No Commentary Here"),
            "");
        sv_secondary(fstring());
        return
    }
    msg1(sv_vc, sel("setContentUnavailableConfiguration:"), 0);
    msg1(cm_tv, sel("setAttributedText:"), commentary_text())
}

// The section found (mhcc_section): "Verses 16â€“21", then its paragraphs,
// then the attribution.
commentary_text(): int {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    fbuf_n = 0;
    if (mh_c1 != mh_c2) {
        fput_str("Verses ");
        fput_int(mh_c1);
        fput(58);
        fput_int(mh_v1);
        fput_str("\â\€\“");
        fput_int(mh_c2);
        fput(58);
        fput_int(mh_v2)
    } else if (mh_v2 > mh_v1) {
        fput_str("Verses ");
        fput_int(mh_v1);
        fput_str("\â\€\“");
        fput_int(mh_v2)
    } else {
        fput_str("Verse ");
        fput_int(mh_v1)
    }
    fput(10);
    keys[0] = k_font;
    values[0] = sans(13.0f64, 0.3f64);
    keys[1] = k_color;
    values[1] = c_faint;
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 8.0f64, 1.0f64), sel("autorelease"));
    msg1(s, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
        values, 3)));
    size: f64 = em * 0.95f64;
    pp: int = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 12.0f64, 1.4f64), sel("autorelease"));
    p: int = mh_p;
    while (p < mh_e) {
        e: int = p;
        while (e < lmh_n && lmh[e] as int != 10) e = e + 1;
        mh_markup(p + 1, e);
        q: int = 0;
        for r in 0..mo_runs {
            z: int = mo_end[r];
            text: int = nsstring_at(bytes_address(mo) + q, z - q);
            q = z;
            kind: int = mo_kind[r];
            keys[0] = k_font;
            values[0] = (if (kind == MH_ITALIC) italic(size) else body(size));
            keys[1] = k_color;
            values[1] = (if (kind == MH_REF) c_accent else c_ink);
            keys[2] = k_para;
            values[2] = pp;
            n: int = 3;
            if (kind == MH_REF) {
                keys[3] = nsstring(k_xref);
                values[3] = msg1(cls("NSNumber"), sel("numberWithLong:"), mo_ref[r]);
                n = 4
            }
            msg1(s, sel("appendAttributedString:"), attributed_str(text, nsdictionary(keys,
                values, n)))
        }
        keys[0] = k_font;
        values[0] = body(size);
        keys[1] = k_color;
        values[1] = c_ink;
        keys[2] = k_para;
        values[2] = pp;
        msg1(s, sel("appendAttributedString:"), attributed_str(nsstring("\n"), nsdictionary(keys,
            values, 3)));
        p = e + 1
    }
    keys[0] = k_font;
    values[0] = body(em * 0.75f64);
    keys[1] = k_color;
    values[1] = c_faint;
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 8.0f64, 0.0f64, 1.2f64), sel("autorelease"));
    msg1(s, sel("appendAttributedString:"), attributed_str(nsstring("Matthew Henry, Concise Commentary on the Whole Bible (1706\â\€\“1721)"),
        nsdictionary(keys, values, 3)));
    s
}

// The chevrons in Commentary: the same section, only the header changes
// (a 0.15 s fade); another, the text cross-fades and goes to its top.
commentary_moved(was_k: int) {
    W: f64 = view_width(cm_tv);
    found: bool = mhcc_section(sv_c, sv_v);
    if (found && mh_k == was_k) {
        head: int = msg1(cm_tv, sel("viewWithTag:"), 5150);
        if (head != 0) fade_layer(msg(head, sel("layer")), 0.15f64);
        commentary_fill(W);
        return
    }
    fade_layer(msg(cm_tv, sel("layer")), 0.2f64);
    commentary_fill(W);
    msg_ff1(cm_tv, sel("setContentOffset:animated:"), 0.0f64, -top_inset(cm_tv), 0)
}

// A tap in the commentary: on a reference, its preview pushed.
commentary_tapped(_self: int, _cmd: int, tap: int): int {
    tv: int = msg(tap, sel("view"));
    l8_msg_hfa(hfa, tap, sel("locationInView:"), tv, 0, 0);
    x: f64 = hfa[0];
    y: f64 = hfa[1];
    range: int = msg(tv, sel("selectedTextRange"));
    if (range != 0 && (msg(range, sel("isEmpty")) & 255) == 0) return 0;
    ref: int = link_at_within(tv, x, y, k_xref, 12.0f64);
    if (ref > 0) push_preview(ref);
    0
}

// ---- classes and methods ----
make_study2_class() {
    sv_class = objc_allocateClassPair(cls("UIViewController"), "L8StudySheet", 0);
    add_method0(sv_class, sel("viewDidLayoutSubviews"), &sv_layout, "v@:");
    objc_registerClassPair(sv_class)
}

add_study2_methods(app: int) {
    add_method1(app, sel("studySegment:"), &study_segment, "v@:@");
    add_method1(app, sel("studyPrevious:"), &study_previous, "v@:@");
    add_method1(app, sel("studyNext:"), &study_next, "v@:@");
    add_method1(app, sel("commentaryTapped:"), &commentary_tapped, "v@:@")
}
