tag bible_memory_tests;

use_tag std, bible;

// Memory (memory.l8, DESIGN.md §13.1): words and their key letters, parts,
// what each level hides, the schedule's every row, Today, New and Later,
// the reminder's words, and memory.tsv read back. Every day is fixed: D0
// is 2026-10-19.
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "plans.l8";

import "memory.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

loaded: bool = false;

read_into(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    n: int = 8388608;
    buf: []i8 = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, buf, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    read_n = got;
    buf
}

read_n: int = 0;

load() noregion {
    if (loaded) return;
    loaded = true;
    bsb = read_into("programs/bible/data/bsb.txt");
    bible_index(read_n);
    text_load(TEXT_BSB, bsb, read_n);
    kjv: []i8 = read_into("programs/bible/data/kjv.txt");
    text_load(1, kjv, read_n);
    text_use(TEXT_BSB)
}

D0: int = 20745;

T0: int = 1792396800;

fresh() noregion {
    load();
    text_use(TEXT_BSB);
    memory_clear();
    mev_n = 0;
    mlog_n = 0
}

ch(code: str, n: int): int {
    book_first[book_coded(code)] + n - 1
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

events() raises IoError {
    write_bytes_n(1, mev, mev_n);
    mev_n = 0
}

// Passage text t's words laid out: each word with its key (and its spoken
// letter), / at a line's start; the parts as | between words.
lay(
    t: int,
    code: str,
    c1: int,
    v1: int,
    c2: int,
    v2: int
) {
    text_use(t);
    memory_layout(ch(code, c1), v1, ch(code, c2), v2, 1);
    text_use(TEXT_BSB)
}

show_words() raises IoError {
    fbuf_n = 0;
    for w in 0..mw_n {
        if (w > 0 && mw_part[w] != mw_part[w - 1]) fput_str(" |");
        if (w > 0) fput(32);
        if (mw_line[w]) fput(47);
        fput_bytes(mt, mw_b[w], mw_e[w]);
        fput(61);
        fput(mw_key[w]);
        if (mw_alt[w] != 0) fput(mw_alt[w])
    }
    fput(10);
    show_fbuf()
}

// The parts: each one's verses (by number) and words.
show_parts() raises IoError {
    fbuf_n = 0;
    fput_int(mpt_n);
    fput_str(" parts:");
    for k in 0..mpt_n {
        fput(32);
        fput_int(mv_v[mpt_v0[k]]);
        if (mpt_v1[k] != mpt_v0[k]) {
            fput(45);
            fput_int(mv_v[mpt_v1[k]])
        }
        fput(40);
        fput_int(mpt_w1[k] - mpt_w0[k]);
        fput(41)
    }
    fput(10);
    show_fbuf()
}

// The passage at a level, as it would look: hidden letters as _ .
show_level(level: int) raises IoError {
    fbuf_n = 0;
    p: int = 0;
    for w in 0..mw_n {
        fput_bytes(mt, p, mw_b[w]);
        h: int = memory_hidden(w, level);
        q: int = mw_b[w];
        while (q < mw_e[w]) {
            cp: int = mt_cp(q);
            n: int = mt_cl;
            hide: bool = h == 2 && mem_hideable(cp) || h == 1 && q >= mw_k2[w] && mem_hideable(cp);
            if (hide) fput(95) else fput_bytes(mt, q, q + n);
            q = q + n
        }
        p = mw_e[w]
    }
    fput_bytes(mt, p, mt_n);
    fput(10);
    for i in 0..fbuf_n
        if (fbuf[i] as int == 10 && i + 1 < fbuf_n) fbuf[i] = 47i8;
    show_fbuf()
}

test "words and their key letters" {
    fresh();
    lay(TEXT_BSB, "JHN", 3, 16, 3, 16);
    show_words();
    lay(TEXT_BSB, "PSA", 23, 1, 23, 2);
    show_words();
    // Dashes part words, hyphens don't; God’s, LORD; numbers and their
    // spoken letters.
    lay(TEXT_BSB, "JHN", 1, 18, 1, 18);
    show_words();
    lay(TEXT_BSB, "MAT", 15, 38, 15, 38);
    show_words();
    lay(TEXT_BSB, "REV", 7, 4, 7, 4);
    show_words();
    lay(1, "PSA", 23, 1, 23, 1);
    show_words();
    lay(TEXT_BSB, "ROM", 12, 1, 12, 1);
    show_words();
    for n in [1, 4, 12, 40, 99, 100, 4000, 5000, 12000, 1000000, 0, 1000001] write_byte(1,
        if (number_letter(n) == 0) 63i8 else number_letter(n) trunc i8);
    print("");
    expect {|
        /For=f God=g so=s loved=l the=t world=w that=t He=h gave=g His=h one=o and=a only=o Son,=s that=t everyone=e who=w believes=b in=i Him=h shall=s not=n perish=p but=b have=h eternal=e life.=l
        /The=t LORD=l is=i my=m shepherd;=s /I=i shall=s not=n want.=w /He=h makes=m me=m lie=l down=d in=i green=g pastures;=p /He=h leads=l me=m beside=b quiet=q waters.=w
        /No=n one=o has=h ever=e seen=s God,=g but=b the=t one=o and=a only=o Son,=s who=w is=i Himself=h God=g and=a is=i at=a the=t Father’s=f side,=s has=h made=m Him=h known.=k
        /A=a total=t of=o four=f thousand=t men=m were=w fed,=f besides=b women=w and=a children.=c
        /And=a I=i heard=h the=t number=n of=o those=t who=w were=w sealed,=s 144,000=1o from=f all=a the=t tribes=t of=o Israel:=i
        /The=t LORD=l is=i my=m shepherd;=s I=i shall=s not=n want.=w
        /Therefore=t I=i urge=u you,=y brothers,=b on=o account=a of=o God’s=g mercy,=m to=t offer=o your=y bodies=b as=a living=l sacrifices,=s holy=h and=a pleasing=p to=t God,=g which=w is=i your=y spiritual=s service=s of=o worship.=w
        oftfnoffto??
    |}
}

test "parts" {
    fresh();
    lay(TEXT_BSB, "JHN", 3, 16, 3, 16);
    show_parts();
    lay(TEXT_BSB, "JHN", 3, 16, 3, 17);
    show_parts();
    lay(TEXT_BSB, "PSA", 23, 1, 23, 6);
    show_parts();
    lay(TEXT_BSB, "ROM", 8, 28, 8, 39);
    show_parts();
    lay(TEXT_BSB, "EST", 8, 9, 8, 9);
    show_parts();
    // In the KJV.
    lay(1, "PSA", 23, 1, 23, 6);
    show_parts();
    lay(1, "JHN", 3, 16, 3, 17);
    show_parts();
    // Verses learned: Esther 8:9's halves count once both are.
    lay(TEXT_BSB, "EST", 8, 9, 8, 10);
    show_parts();
    for k in 0..mpt_n + 1 write_int(1, memory_verses_learned(k));
    print("");
    lay(TEXT_BSB, "ROM", 8, 28, 8, 39);
    write_int(1, memory_verses_learned(4));
    write(1, " ");
    write_int(1, memory_parts_for_verses(5));
    print("");
    expect {|
        1 parts: 16(27)
        2 parts: 16(27) 17(21)
        6 parts: 1(9) 2(14) 3(18) 4(30) 5(21) 6(24)
        12 parts: 28(24) 29(26) 30(19) 31(20) 32(28) 33(13) 34(32) 35(23) 36(21) 37(15) 38(22) 39(28)
        2 parts: 9(44) 9(25)
        6 parts: 1(9) 2(16) 3(16) 4(30) 5(22) 6(25)
        2 parts: 16(25) 17(22)
        3 parts: 9(44) 9(25) 10(32)
        0012
        4 5
    |}
}

test "what each level hides" {
    fresh();
    lay(TEXT_BSB, "JHN", 3, 16, 3, 16);
    for lv in 0..4 show_level(lv);
    // The same words for the same id, others for another; and a poem's
    // lines never begin with two hidden words.
    lay(TEXT_BSB, "PSA", 23, 1, 23, 6);
    show_level(LV_SOME);
    text_use(TEXT_BSB);
    memory_layout(ch("PSA", 23), 1, ch("PSA", 23), 6, 2);
    show_level(LV_SOME);
    bad: int = 0;
    for w in 0..mw_n - 1
        if (mw_line[w] && !mw_line[w + 1] && mw_some[w] && mw_some[w + 1]) bad = bad + 1;
    some: int = 0;
    for w in 0..mw_n
        if (mw_some[w]) some = some + 1;
    write(1, "lines beginning with two hidden: ");
    write_int(1, bad);
    write(1, "; hidden at Some: ");
    write_int(1, some);
    write(1, " of ");
    write_int(1, mw_n);
    print("");
    // Some's words keep their first letter at Letters (hiding only grows).
    grows: bool = true;
    for w in 0..mw_n
        for lv in 0..3
            if (memory_hidden(w, lv + 1) < memory_hidden(w, lv) && !(lv == 1 && memory_hidden(w,
                2) == 1)) grows = false;
    write(1, "grows: ");
    print(if (grows) "yes" else "no");
    expect {|
        16 For God so loved the world that He gave His one and only Son, that everyone who believes in Him shall not perish but have eternal life.
        16 For God so _____ the world that He ____ His ___ ___ only ___, that everyone ___ ________ __ Him shall ___ perish but ____ _______ life.
        16 F__ G__ s_ l____ t__ w____ t___ H_ g___ H__ o__ a__ o___ S__, t___ e_______ w__ b_______ i_ H__ s____ n__ p_____ b__ h___ e______ l___.
        16 ___ ___ __ _____ ___ _____ ____ __ ____ ___ ___ ___ ____ ___, ____ ________ ___ ________ __ ___ _____ ___ ______ ___ ____ _______ ____.
        1 The ____ __ __ ________;/_ shall not ____./2 He makes me lie ____ __ green pastures;/He _____ me beside _____ ______./3 He ________ my soul;/He ______ me in the paths of righteousness/for ___ sake of ___ name./4 ____ though I walk _______ the valley of ___ ______ __ death,/I will fear no ____,/for ___ are ____ me;/Your ___ ___ ____ staff, ____ comfort __./5 You _______ a table ______ me/__ the presence __ my _______./You ______ my ____ ____ ___;/my cup overflows./6 ______ goodness and mercy ____ follow me/all ___ days __ my ____,/and I will _____ __ the _____ of the ____/forever.
        1 ___ LORD is my shepherd;/_ shall not ____./2 He makes me ___ down __ green pastures;/He _____ me beside quiet waters./3 __ restores my ____;/__ guides me in the _____ of righteousness/___ the ____ __ His ____./4 ____ though I walk _______ the valley of ___ ______ of _____,/I will ____ no ____,/___ You are with me;/Your rod and ____ staff, ____ comfort __./5 ___ prepare a table ______ __/in ___ presence of __ enemies./___ anoint __ head ____ ___;/__ cup _________./6 ______ goodness ___ mercy ____ ______ me/___ the days __ my life,/___ I ____ dwell in the house of ___ ____/forever.
        lines beginning with two hidden: 0; hidden at Some: 46 of 116
        grows: yes
    |}
}

// A passage added in version ver: its index.
add(
    ver: int,
    code: str,
    c1: int,
    v1: int,
    c2: int,
    v2: int
): int {
    id: int = memory_add(ver, ch(code, c1), v1, ch(code, c2), v2, T0);
    mem_index(id)
}

show_one(i: int) raises IoError {
    fbuf_n = 0;
    fput_passage(i);
    fput_str(" \�\� ");
    fput_str(mem_state_ids[mq_state[i]]);
    fput_str(" box ");
    fput_int(mq_box[i]);
    fput_str(" due ");
    if (mq_due[i] >= 0) fput_iso_date(mq_due[i]) else fput(45);
    fput(10);
    show_fbuf()
}

test "adding" {
    fresh();
    a: int = add(0, "JHN", 3, 16, 3, 17);
    b: int = add(1, "PSA", 23, 1, 23, 6);
    c: int = add(0, "ISA", 52, 13, 53, 12);
    // Over 40 verses, across books, backwards: none.
    write_int(1, memory_add(0, ch("ROM", 8), 1, ch("ROM", 9), 33, T0));
    write_int(1, memory_add(0, ch("ROM", 16), 27, ch("1CO", 1), 1, T0));
    write_int(1, memory_add(0, ch("ROM", 8), 9, ch("ROM", 8), 3, T0));
    print("");
    events();
    for i in [a, b, c] show_one(i);
    fbuf_n = 0;
    for i in [a, b, c] {
        fput_caption(i);
        fput(10)
    }
    show_fbuf();
    // The tray's Memorizing: a verse inside, the newest holding it.
    d: int = add(0, "JHN", 3, 14, 3, 16);
    write_int(1, memory_holding(ch("JHN", 3), 16, 16));
    write_int(1, memory_holding(ch("JHN", 3), 16, 17));
    write_int(1, memory_holding(ch("JHN", 3), 18, 18));
    write_int(1, memory_holding(ch("ISA", 53), 1, 5));
    print("");
    _u: int = d;
    mev_n = 0;
    expect {|
        000
        memory added: JHN 3:16-17 bsb (id 1)
        memory added: PSA 23:1-6 kjv (id 2)
        memory added: ISA 52:13-53:12 bsb (id 3)
        John 3:16–17 · new box 0 due -
        Psalm 23 · new box 0 due -
        Isaiah 52:13–53:12 · new box 0 due -
        John 3:16–17 · BSB
        Psalm 23:1–6 · KJV
        Isaiah 52:13–53:12 · BSB
        30-12
    |}
}

test "the schedule" {
    fresh();
    i: int = add(0, "PHP", 4, 6, 4, 7);
    memory_open(i, D0);
    show_one(i);
    // Learning: a part, then the last.
    memory_part_checked(i, 2, D0, T0);
    show_one(i);
    memory_part_checked(i, 2, D0 + 1, T0);
    show_one(i);
    // Review, due: Knew It; Mostly; Not Yet; box 8 stays 8; Not Yet from 1
    // stays 1.
    _a: bool = memory_grade(i, G_KNEW, D0 + 2, 0, 0, T0);
    show_one(i);
    _b: bool = memory_grade(i, G_MOSTLY, D0 + 5, 0, 0, T0);
    show_one(i);
    _c: bool = memory_grade(i, G_NOTYET, D0 + 8, 2, 1, T0);
    show_one(i);
    mq_box[i] = 8;
    mq_due[i] = D0;
    _d: bool = memory_grade(i, G_KNEW, D0, 0, 0, T0);
    show_one(i);
    mq_box[i] = 1;
    _e: bool = memory_grade(i, G_NOTYET, D0, 0, 0, T0);
    show_one(i);
    // Early: Knew It and Mostly change nothing; Not Yet does.
    mq_box[i] = 3;
    mq_due[i] = D0 + 4;
    _f: bool = memory_grade(i, G_KNEW, D0, 0, 0, T0);
    _g: bool = memory_grade(i, G_MOSTLY, D0, 0, 0, T0);
    show_one(i);
    // 30 days missed, then Knew It at box 4: box 5, due today + 30.
    mq_box[i] = 4;
    mq_due[i] = D0 - 30;
    _h: bool = memory_grade(i, G_KNEW, D0, 0, 0, T0);
    show_one(i);
    // Start Over.
    memory_start_over(i, D0, T0);
    show_one(i);
    events();
    write_bytes_n(1, mlog, mlog_n);
    expect "Philippians 4:6–7 · learning box 0 due 2026-10-19\nPhilippians 4:6–7 · learning box 0 due 2026-10-20\nPhilippians 4:6–7 · review box 1 due 2026-10-21\nPhilippians 4:6–7 · review box 2 due 2026-10-24\nPhilippians 4:6–7 · review box 2 due 2026-10-27\nPhilippians 4:6–7 · review box 1 due 2026-10-28\nPhilippians 4:6–7 · review box 8 due 2027-04-17\nPhilippians 4:6–7 · review box 1 due 2026-10-20\nPhilippians 4:6–7 · review box 3 due 2026-10-23\nPhilippians 4:6–7 · review box 5 due 2026-11-18\nPhilippians 4:6–7 · learning box 0 due 2026-10-19\nmemory added: PHP 4:6-7 bsb (id 1)\nmemory started: PHP 4:6-7\nmemory part: PHP 4:6-7 1 of 2\nmemory part: PHP 4:6-7 2 of 2\nmemory learned: PHP 4:6-7 box 1 due 2026-10-21\nmemory graded: PHP 4:6-7 knew box 1→2 due 2026-10-24\nmemory graded: PHP 4:6-7 mostly box 2→2 due 2026-10-27\nmemory graded: PHP 4:6-7 notyet box 2→1 due 2026-10-28\nmemory graded: PHP 4:6-7 knew box 8→8 due 2027-04-17\nmemory graded: PHP 4:6-7 notyet box 1→1 due 2026-10-20\nmemory graded: PHP 4:6-7 knew early, nothing changed\nmemory graded: PHP 4:6-7 mostly early, nothing changed\nmemory graded: PHP 4:6-7 knew box 4→5 due 2026-11-18\nmemory start-over: PHP 4:6-7\n1\t1792396800\tpart\t0\t0\t0\t0\n1\t1792396800\tpart\t0\t0\t0\t0\n1\t1792396800\tlearned\t0\t1\t0\t0\n1\t1792396800\tknew\t1\t2\t0\t0\n1\t1792396800\tmostly\t2\t2\t0\t0\n1\t1792396800\tnotyet\t2\t1\t2\t1\n1\t1792396800\tknew\t8\t8\t0\t0\n1\t1792396800\tnotyet\t1\t1\t0\t0\n1\t1792396800\tknew\t3\t3\t0\t0\n1\t1792396800\tmostly\t3\t3\t0\t0\n1\t1792396800\tknew\t4\t5\t0\t0\n1\t1792396800\tstart-over\t5\t0\t0\t0\n"
}

// A Not Yet's second try at the session's end changes nothing, whatever
// its grade (review r9-1 Minor 12): box 5, Not Yet, then Not Yet again,
// stays at box 3, due tomorrow.
test "a second try in the same session" {
    fresh();
    i: int = add(0, "PHP", 4, 6, 4, 7);
    memory_open(i, D0);
    memory_part_checked(i, 2, D0, T0);
    memory_part_checked(i, 2, D0, T0);
    mq_box[i] = 5;
    mq_due[i] = D0;
    _a: bool = memory_grade(i, G_NOTYET, D0, 1, 3, T0);
    show_one(i);
    memory_grade_again(i, G_NOTYET, 0, 2, T0);
    show_one(i);
    memory_grade_again(i, G_KNEW, 0, 0, T0);
    show_one(i);
    events();
    expect {|
        Philippians 4:6–7 · review box 3 due 2026-10-20
        Philippians 4:6–7 · review box 3 due 2026-10-20
        Philippians 4:6–7 · review box 3 due 2026-10-20
        memory added: PHP 4:6-7 bsb (id 1)
        memory started: PHP 4:6-7
        memory part: PHP 4:6-7 1 of 2
        memory part: PHP 4:6-7 2 of 2
        memory learned: PHP 4:6-7 box 1 due 2026-10-20
        memory graded: PHP 4:6-7 notyet box 5→3 due 2026-10-20
        memory graded: PHP 4:6-7 notyet again, nothing changed
        memory graded: PHP 4:6-7 knew again, nothing changed
    |}
}

test "Today, New and Later" {
    fresh();
    // The demo's: Philippians due yesterday, Romans learning (due today),
    // Psalm 23 later, John new; and more.
    php: int = add(0, "PHP", 4, 6, 4, 7);
    rom: int = add(0, "ROM", 8, 28, 8, 39);
    psa: int = add(1, "PSA", 23, 1, 23, 6);
    jhn: int = add(0, "JHN", 3, 16, 3, 17);
    gen: int = add(0, "GEN", 1, 1, 1, 3);
    isa: int = add(0, "ISA", 53, 1, 53, 6);
    mq_added[jhn] = T0 + 100;
    mq_state[php] = MS_REVIEW;
    mq_box[php] = 3;
    mq_due[php] = D0 - 1;
    mq_state[rom] = MS_LEARNING;
    mq_learned[rom] = 4;
    mq_due[rom] = D0;
    mq_state[psa] = MS_REVIEW;
    mq_box[psa] = 4;
    mq_due[psa] = D0 + 14;
    mq_state[isa] = MS_REVIEW;
    mq_box[isa] = 2;
    mq_due[isa] = D0 - 1;
    // Genesis: learning, practised today (so later).
    mq_state[gen] = MS_LEARNING;
    mq_due[gen] = D0 + 1;
    for sort in [0, 1, 2] {
        memory_today(D0, sort);
        fbuf_n = 0;
        for k in 0..td_today + td_new + td_later {
            if (k == 0) fput_str("Today: ");
            if (k == td_today) fput_str(" New: ");
            if (k == td_today + td_new) fput_str(" Later: ");
            fput_passage(td[k]);
            fput_str(" (");
            fput_memory_state(td[k], D0, 4, 12);
            fput_str(") ")
        }
        fput(10);
        show_fbuf()
    }
    for d in [D0 - 2, D0, D0 + 1, D0 + 14, D0 + 30] {
        write_int(1, memory_due_on(d));
        write(1, " ")
    }
    print("");
    fbuf_n = 0;
    _n: bool = fput_next_review(D0);
    fput(10);
    for g in [G_NOTYET, G_MOSTLY, G_KNEW] {
        fput_would(php, g, D0);
        fput(10)
    }
    fput_would(psa, G_KNEW, D0);
    fput(10);
    show_fbuf();
    for hm in [0, 1, 3, 4] {
        write_int(1, memory_suggest(hm, hm / 2, 26));
        write(1, " ")
    }
    print("");
    mev_n = 0;
    expect "Today: Isaiah 53:1–6 (To review) Philippians 4:6–7 (To review) Romans 8:28–39 (Learning · 4 of 12 verses)  New: John 3:16–17 (New)  Later: Genesis 1:1–3 (Learning · 4 of 12 verses · tomorrow) Psalm 23 (Next review 2 November) \nToday: Isaiah 53:1–6 (To review) Philippians 4:6–7 (To review) Romans 8:28–39 (Learning · 4 of 12 verses)  New: John 3:16–17 (New)  Later: Genesis 1:1–3 (Learning · 4 of 12 verses · tomorrow) Psalm 23 (Next review 2 November) \nToday: Isaiah 53:1–6 (To review) Philippians 4:6–7 (To review) Romans 8:28–39 (Learning · 4 of 12 verses)  New: John 3:16–17 (New)  Later: Psalm 23 (Next review 2 November) Genesis 1:1–3 (Learning · 4 of 12 verses · tomorrow) \n0 3 4 5 5 \nNext review: Today\nAgain tomorrow\nNext review 26 October\nNext review 2 November\nNo change: next review 2 November\n2 1 0 0 \n"
}

test "the reminder's words" {
    fresh();
    plans_make();
    a: int = add(1, "PSA", 23, 1, 23, 6);
    b: int = add(0, "JHN", 3, 16, 3, 17);
    for i in [a, b] {
        mq_state[i] = MS_REVIEW;
        mq_box[i] = 1;
        mq_due[i] = D0
    }
    for both in 0..3 {
        if (fput_reminder_both(0, if (both == 1) -1 else 3, both != 0, D0)) {
            for x in 0..fbuf_n
                if (fbuf[x] as int == 10) fbuf[x] = 47i8;
            write_bytes_n(1, fbuf, rm_title);
            write(1, " | ");
            write_bytes_n(1, slice(rm_title), fbuf_n - rm_title);
            print("")
        }
    }
    write(1, "nothing: ");
    print(if (fput_reminder_both(0, -1, false, D0)) "yes" else "no");
    // Cut at 178 characters.
    for k in 0..20 {
        i: int = add(0, "PSA", 100 + k, 1, 100 + k, 2);
        mq_state[i] = MS_REVIEW;
        mq_box[i] = 1;
        mq_due[i] = D0
    }
    fbuf_n = 0;
    fput_memory_body(D0);
    fput(10);
    show_fbuf();
    write_int(1, utf8_chars(fbuf, 0, fbuf_n - 1));
    print("");
    mev_n = 0;
    expect {|
        Bible in a Year | Today’s reading: Genesis 12–15
        Memory | To review: Psalm 23, John 3:16–17
        Bible in a Year | Today’s reading: Genesis 12–15/To review: Psalm 23, John 3:16–17
        nothing: no
        To review: Psalm 23, Psalm 100:1–2, Psalm 101:1–2, Psalm 102:1–2, Psalm 103:1–2, Psalm 104:1–2, Psalm 105:1–2, Psalm 106:1–2, Psalm 107:1–2, Psalm 108:1–2 … and 12 more
        168
    |}
}

slice_buf: []i8 = new i8[4096](0i8);

slice(from: int): []i8 {
    for i in from..fbuf_n slice_buf[i - from] = fbuf[i];
    slice_buf
}

feed(s: str) {
    fbuf_n = 0;
    fput_str(s)
}

test "memory.tsv read back" {
    fresh();
    a: int = add(0, "PHP", 4, 6, 4, 7);
    b: int = add(1, "PSA", 23, 1, 23, 6);
    c: int = add(0, "ISA", 52, 13, 53, 12);
    memory_open(a, D0);
    memory_part_checked(a, 1, D0, T0);
    mq_level[b] = LV_LETTERS;
    memory_delete(c, T0);
    format_memory();
    show_fbuf();
    parse_memory();
    format_memory();
    show_fbuf();
    write_int(1, lines_read);
    write(1, " ");
    write_int(1, lines_skipped);
    print("");
    // Malformed lines, over 40 verses, across books, a second id, NEXT.
    feed("""
PASSAGE	4	bsb	JHN	3	16	3	17	1792396800	new	0	0	-	full
PASSAGE	4	kjv	JHN	3	1	3	2	1792396800	new	0	0	-	full
PASSAGE	5	bsb	ROM	8	1	9	33	1792396800	new	0	0	-	full
PASSAGE	6	bsb	ROM	16	27	17	1	1792396800	new	0	0	-	full
PASSAGE	7	xyz	JHN	3	16	3	17	1792396800	new	0	0	-	full
PASSAGE	8	bsb	JHN	3	16	3	17	1792396800	review	0	0	-	full
PASSAGE	9	bsb	JHN	3	16	3	17	1792396800	review	0	3	2026-13-01	blank
PASSAGE	10	web	JHN	3	16	3	17	1792396800	learning	2	0	2026-10-19	some
JUNK
NEXT	12
""");
    parse_memory();
    format_memory();
    show_fbuf();
    write_int(1, lines_read);
    write(1, " ");
    write_int(1, lines_skipped);
    print("");
    mev_n = 0;
    mlog_n = 0;
    expect "PASSAGE\t1\tbsb\tPHP\t4\t6\t4\t7\t1792396800\treview\t0\t1\t2026-10-20\tblank\nPASSAGE\t2\tkjv\tPSA\t23\t1\t23\t6\t1792396800\tnew\t0\t0\t-\tletters\nNEXT\t4\nPASSAGE\t1\tbsb\tPHP\t4\t6\t4\t7\t1792396800\treview\t0\t1\t2026-10-20\tblank\nPASSAGE\t2\tkjv\tPSA\t23\t1\t23\t6\t1792396800\tnew\t0\t0\t-\tletters\nNEXT\t4\n3 0\nPASSAGE\t4\tbsb\tJHN\t3\t16\t3\t17\t1792396800\tnew\t0\t0\t-\tfull\nPASSAGE\t10\tweb\tJHN\t3\t16\t3\t17\t1792396800\tlearning\t2\t0\t2026-10-19\tsome\nNEXT\t12\n10 6\n"
}

test "the reminder with several plans and Memory (§16.11.5)" {
    fresh();
    plans_make();
    plans_clear();
    a: int = add(1, "PSA", 23, 1, 23, 6);
    mq_state[a] = MS_REVIEW;
    mq_box[a] = 1;
    mq_due[a] = D0;
    y: int = plan_begin(PLAN_YEAR, D0, 1);
    p: int = plan_begin(PLAN_PSPR, D0, 2);
    fw_remind[y] = true;
    fw_remind[p] = true;
    for memory in [false, true] {
        if (fput_reminder_all(D0, memory)) {
            for x in 0..fbuf_n
                if (fbuf[x] as int == 10) fbuf[x] = 47i8;
            write_bytes_n(1, fbuf, rm_title);
            write(1, " | ");
            write_bytes_n(1, slice(rm_title), fbuf_n - rm_title);
            print("")
        }
    }
    // (One plan's switch off: its name; both off, Memory's alone.)
    fw_remind[y] = false;
    _r: bool = fput_reminder_all(D0, false);
    write_bytes_n(1, fbuf, rm_title);
    print("");
    fw_remind[p] = false;
    _s: bool = fput_reminder_all(D0, true);
    write_bytes_n(1, fbuf, fbuf_n);
    print("");
    plans_clear();
    mev_n = 0;
    expect {|
        Today’s Reading | Bible in a Year: Genesis 1–3/Psalms and Proverbs in a Month: Psalms 1–8; Proverbs 1
        Today’s Reading | Bible in a Year: Genesis 1–3/Psalms and Proverbs in a Month: Psalms 1–8; Proverbs 1/To review: Psalm 23
        Psalms and Proverbs in a Month
        MemoryTo review: Psalm 23
    |}
}
