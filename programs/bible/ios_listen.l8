tag bible_ios;

use_tag std, ios, bible;

// Reading aloud (DESIGN.md §8.7, and §12: recorded readings), and keeping
// the screen on while reading (§8.2).
//
// Listen reads the Bible from the verse at the top of the reader, on into
// the next chapter, to Revelation 22, by one of two engines: the player (a
// recording, an AVQueuePlayer of a chapter an item, the next queued as each
// begins: KVO by observeValueForKeyPath:, notifications by selector, its
// time polled ten times a second, so no blocks), or the voice
// (AVSpeechSynthesizer, an utterance a verse, its delegate saying which
// verse is spoken). Which one, and whose recording, audio.l8 decides; a
// recording that cannot be reached is stood in for by the voice from the
// same verse, until the next chapter can be had. The verse being read is
// washed in the reader, followed down the page, and named in a small
// floating player (play or pause, its name and the reader, stop). The audio
// session is for spoken audio and goes on with the screen locked; the lock
// screen's controls come through MPRemoteCommandCenter's target-action, and
// what it shows from MPNowPlayingInfoCenter. AVFoundation and MediaPlayer
// are loaded at the first Listen, not linked, so launching loads nothing
// more.
import "../ios/objc.l8";

import "text.l8";

// ---- keeping the screen on (§8.2) ----
keep_on: bool = false;

idle_disabled: bool = false;

idle_timer: int = 0;

set_idle_disabled(on: bool) {
    if (on == idle_disabled) return;
    idle_disabled = on;
    msg1(msg(cls("UIApplication"), sel("sharedApplication")), sel("setIdleTimerDisabled:"),
        if (on) 1 else 0);
    note(if (on) "bible: idle timer off" else "bible: idle timer on")
}

// The reader touched (a scroll ended, a tap): with the setting on, the
// screen kept on for 10 minutes more.
keep_screen_touched() {
    if (!keep_on || presented() != 0) return;
    set_idle_disabled(true);
    idle_timer = stop_timer(idle_timer);
    idle_timer = after(600.0f64, "idleTimeout:")
}

// A sheet over the reader, the app gone to the background, or the setting
// off: the screen turns off as usual again, at once.
keep_screen_release() {
    idle_timer = stop_timer(idle_timer);
    if (idle_disabled) set_idle_disabled(false)
}

idle_timeout(_self: int, _cmd: int, _timer: int): int {
    idle_timer = 0;
    set_idle_disabled(false);
    0
}

keep_on_switched(_self: int, _cmd: int, sw: int): int {
    keep_on = (msg(sw, sel("isOn")) & 255) != 0;
    set_def_bool("keepScreenOn", keep_on);
    if (!keep_on) keep_screen_release();
    0
}

// ---- the engine ----
ls_synth: int = 0;

// Listening at all (playing or paused), and playing now.
ls_active: bool = false;

ls_playing: bool = false;

// Which engine reads now, and the source it reads (audio.l8's; the voice's
// is SRC_VOICE); the source chosen for the version (what the voice stands
// in for after a failure).
ENGINE_VOICE: int = 0;

ENGINE_PLAYER: int = 1;

ls_engine: int = 0;

ls_src: int = 5;

ls_chosen: int = 5;

// The voice standing in for a recording that could not be reached, and the
// chapter it hands back at (-1: none).
ls_fallback: bool = false;

ls_return_c: int = -1;

// When each source last failed (CACurrentMediaTime; 0: never).
ls_failed_at: []f64 = new f64[6](0.0f64);

// The chapter queued last (the voice's).
ls_queued_c: int = -1;

// The utterances queued (a ring): each one's object, chapter and verse (0:
// the chapter's name).
ls_ring: int = 512;

ls_utt: []int = new int[512](0);

ls_uc: []int = new int[512](0);

ls_uv: []int = new int[512](0);

ls_un: int = 0;

ls_voice: int = 0;

ls_ready: bool = false;

// The speed (0 slower, 1 normal, 2 faster), and its rates: the voice's,
// and a recording's (§12.0.2 decision 9).
ls_speed: int = 1;

ls_rates: []f64 = [0.42f64, 0.5f64, 0.56f64];

ap_rates: []f64 = [0.85f64, 1.0f64, 1.25f64];

// When a verse last began (CACurrentMediaTime), and following paused until
// (after a drag).
ls_began_at: f64 = 0.0f64;

ls_follow_after: f64 = 0.0f64;

ls_demo_timer: int = 0;

// (The demo's recording: each verse cut to a few words, so the wash moves
// on every two seconds or so.)
ls_demo_fast: bool = false;

// The frameworks: once.
listen_frameworks() {
    if (cls("AVSpeechSynthesizer") == 0) _h: int = dlopen("/System/Library/Frameworks/AVFAudio.framework/AVFAudio",
        1);
    if (cls("AVQueuePlayer") == 0) _h2: int = dlopen("/System/Library/Frameworks/AVFoundation.framework/AVFoundation",
        1);
    if (cls("MPRemoteCommandCenter") == 0) _h3: int = dlopen("/System/Library/Frameworks/MediaPlayer.framework/MediaPlayer",
        1)
}

// The frameworks, the lock screen's commands and the notifications: once.
listen_load() {
    if (ls_ready) return;
    ls_ready = true;
    listen_frameworks();
    audio_load();
    // The lock screen's controls, by target and action.
    cc: int = msg(cls("MPRemoteCommandCenter"), sel("sharedCommandCenter"));
    if (cc != 0) {
        msg2(msg(cc, sel("playCommand")), sel("addTarget:action:"), app_obj, sel("remotePlay:"));
        msg2(msg(cc, sel("pauseCommand")), sel("addTarget:action:"), app_obj, sel("remotePause:"));
        msg2(msg(cc, sel("togglePlayPauseCommand")), sel("addTarget:action:"), app_obj,
            sel("remoteToggle:"));
        msg2(msg(cc, sel("nextTrackCommand")), sel("addTarget:action:"), app_obj,
            sel("remoteNext:"));
        msg2(msg(cc, sel("previousTrackCommand")), sel("addTarget:action:"), app_obj,
            sel("remotePrevious:"));
        msg2(msg(cc, sel("changePlaybackPositionCommand")), sel("addTarget:action:"),
            app_obj, sel("remotePosition:"));
        // (Chapter skips on the lock screen, not 15-second ones.)
        msg1(msg(cc, sel("skipForwardCommand")), sel("setEnabled:"), 0);
        msg1(msg(cc, sel("skipBackwardCommand")), sel("setEnabled:"), 0)
    }
    center: int = msg(cls("NSNotificationCenter"), sel("defaultCenter"));
    // Interruptions (a call): paused, not resumed by itself; headphones
    // unplugged: paused.
    for k in 0..5 {
        name: int = objc_const(ls_note_names[k]);
        if (name != 0) msg4(center, sel("addObserver:selector:name:object:"), app_obj,
            sel(ls_note_sels[k]), name, 0)
    }
}

ls_note_names: []str = ["AVAudioSessionInterruptionNotification", "AVAudioSessionRouteChangeNotification",
    "AVPlayerItemDidPlayToEndTimeNotification", "AVPlayerItemFailedToPlayToEndTimeNotification",
    "AVPlayerItemPlaybackStalledNotification"];

ls_note_sels: []str = ["listenInterrupted:", "listenRouteChanged:", "listenItemEnded:",
    "listenItemFailed:", "listenItemStalled:"];

listen_session_on() {
    listen_frameworks();
    session: int = msg(cls("AVAudioSession"), sel("sharedInstance"));
    if (session != 0) {
        msg4(session, sel("setCategory:mode:options:error:"), objc_const("AVAudioSessionCategoryPlayback"),
            objc_const("AVAudioSessionModeSpokenAudio"), 0, 0);
        msg3(session, sel("setActive:withOptions:error:"), 1, 0, 0)
    }
}

// The source chapter c is heard from now: the chosen one, unless it cannot
// be had (audio.l8's rules), and never the ESV's recording unless the
// ESV's own text is current.
listen_effective(s: int, c: int): int {
    kept: bool = src_cacheable(s) && kept_file(s, c) != 0;
    online: bool = net_reachable();
    audio_effective(s, c, kept, online, ls_failed_at[s], CACurrentMediaTime())
}

// Listening, from verse v of chapter c.
listen_start(c: int, v: int) {
    listen_load();
    if (cls("AVSpeechSynthesizer") == 0) return;
    preview_stop();
    listen_stop_engine();
    ls_speed = clamp(def_int("listenRate"), 0, 2);
    listen_session_on();
    ls_active = true;
    ls_playing = true;
    ls_fallback = false;
    ls_return_c = -1;
    first: int = if (v < 1) 1 else v;
    ls_chosen = audio_source(text_cur);
    s: int = listen_effective(ls_chosen, c);
    if (s == SRC_VOICE) voice_start(c, first) else player_start(s, c, first);
    listen_show();
    dl_pump()
}

// The engine stopped and the source chosen again, at verse v of chapter c
// (a new reader, a new version, a fallback's end), the player staying up.
listen_restart_at(c: int, v: int) {
    if (!ls_active) {
        listen_start(c, v);
        return
    }
    listen_stop_engine();
    ls_fallback = false;
    ls_return_c = -1;
    ls_playing = true;
    ls_chosen = audio_source(text_cur);
    s: int = listen_effective(ls_chosen, c);
    if (s == SRC_VOICE) voice_start(c, if (v < 1) 1 else v) else player_start(s, c,
        if (v < 1) 1 else v);
    listen_label();
    listen_symbol();
    dl_pump()
}

// A new reader chosen in Voice while listening: heard at once, from the
// verse being read.
listen_reader_changed() {
    c: int = speak_c;
    v: int = if (speak_v > 0) speak_v else 1;
    if (c < 0) return;
    fbuf_n = 0;
    fput_str("bible: listen switched to ");
    fput_str(src_ids[audio_source(text_cur)]);
    fput_str(" at ");
    fput_code_ref(c, v);
    note_ns(fstring());
    listen_restart_at(c, v)
}

// "JHN 3:5".
fput_code_ref(c: int, v: int) {
    fput_bytes(bsb, book_line[ch_book[c]] + 1, book_line[ch_book[c]] + 4);
    fput(32);
    fput_int(ch_num[c]);
    if (v > 0) {
        fput(58);
        fput_int(v)
    }
}

// ---- the voice engine (§8.7) ----
voice_start(c: int, first: int) {
    ls_engine = ENGINE_VOICE;
    ls_src = SRC_VOICE;
    if (ls_synth == 0) {
        ls_synth = make("AVSpeechSynthesizer");
        msg1(ls_synth, sel("setDelegate:"), app_obj)
    }
    if (ls_voice == 0) ls_voice = keep(chosen_voice());
    ls_un = 0;
    listen_queue(c, first);
    // (The verse washed at once; the synthesizer says when it is begun.)
    listen_at(c, first);
    now_playing();
    if (demo_on) {
        ls_demo_timer = stop_timer(ls_demo_timer);
        ls_demo_timer = msg_f4(cls("NSTimer"), sel("scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:"),
            0.5f64, app_obj, sel("listenDemoTick:"), 0, 1)
    }
}

// Chapter c queued, from verse first: its name (from its first verse), then
// a verse an utterance.
listen_queue(c: int, first: int) {
    ls_queued_c = c;
    // (An ESV chapter not here: asked for, and queued when it comes.)
    if (text_cur == TEXT_ESV && ch_start[c] < 0) {
        ls_esv_c = c;
        ls_esv_first = first;
        esv_want(c, 1);
        return
    }
    if (first <= 1) {
        fbuf_n = 0;
        fput_spoken_title(c);
        listen_say(fstring(), c, 0)
    }
    for v in first..ch_verses[c] + 1 {
        _n: int = speak_text(c, v);
        n: int = vt_n;
        // (The demo's verses short: a few words each, so the wash moves on
        // every two seconds or so.)
        if (demo_on && ls_demo_fast) {
            words: int = 0;
            i: int = 0;
            while (i < n && words < 7) {
                if (vt[i] as int == 32) words = words + 1;
                i = i + 1
            }
            n = i
        }
        listen_say(nsstring_of(vt, n), c, v)
    }
}

listen_say(text: int, c: int, v: int) {
    u: int = msg1(cls("AVSpeechUtterance"), sel("speechUtteranceWithString:"), text);
    if (u == 0) return;
    msg_set_f32(u, sel("setRate:"), ls_rates[ls_speed] as f32);
    if (ls_voice != 0) msg1(u, sel("setVoice:"), ls_voice);
    msg_set_f(u, sel("setPostUtteranceDelay:"), if (demo_on && ls_demo_fast) 0.0f64 else if (v == 0) 0.35f64 else 0.12f64);
    i: int = ls_un % ls_ring;
    ls_utt[i] = u;
    ls_uc[i] = c;
    ls_uv[i] = v;
    ls_un = ls_un + 1;
    msg1(ls_synth, sel("speakUtterance:"), u)
}

// Which utterance u is (-1 if none known).
listen_find(u: int): int {
    k: int = ls_un - 1;
    while (k >= 0 && k >= ls_un - ls_ring) {
        if (ls_utt[k % ls_ring] == u) return k % ls_ring;
        k = k - 1
    }
    -1
}

// The synthesizer began an utterance: its verse washed and followed, and at
// a chapter's last verse, the next chapter queued (or, the voice standing
// in, the recording taken up again there if it can be had).
listen_began(
    _self: int,
    _cmd: int,
    _synth: int,
    u: int
): int {
    i: int = listen_find(u);
    if (i < 0 || !ls_active || ls_engine != ENGINE_VOICE) return 0;
    c: int = ls_uc[i];
    v: int = ls_uv[i];
    if (v == 0) {
        now_playing();
        return 0
    }
    listen_at(c, v);
    if (v == ch_verses[c] && ls_queued_c == c && c + 1 < chapters) {
        if (ls_fallback && listen_effective(ls_chosen, c + 1) != SRC_VOICE) ls_return_c = c + 1 else listen_queue(c + 1,
            1)
    }
    0
}

listen_finished(
    _self: int,
    _cmd: int,
    _synth: int,
    u: int
): int {
    i: int = listen_find(u);
    if (i < 0 || !ls_active || ls_engine != ENGINE_VOICE) return 0;
    c: int = ls_uc[i];
    v: int = ls_uv[i];
    // (A chapter's last verse said: read, for a plan, DESIGN.md §10.1.2.)
    if (v > 0 && v == ch_verses[c]) chapter_heard(c);
    // (Revelation 22's last verse said: done.)
    if (c == chapters - 1 && v == ch_verses[chapters - 1]) {
        listen_stop();
        return 0
    }
    if (v > 0 && v == ch_verses[c] && ls_return_c == c + 1) {
        fbuf_n = 0;
        fput_str("bible: listen back to ");
        fput_str(src_ids[ls_chosen]);
        fput_str(" at ");
        fput_code_ref(c + 1, 0);
        note_ns(fstring());
        listen_restart_at(c + 1, 1)
    }
    0
}

// A chapter heard to its end: read, for a plan and a reading.
chapter_heard(c: int) {
    fbuf_n = 0;
    fput_str("bible: chapter heard ");
    fput_code_ref(c, 0);
    note_ns(fstring());
    plan_heard(c)
}

// ---- the player engine (§12.3.1) ----
ap_player: int = 0;

// The items queued: each one's object, source and chapter.
PL_MOST: int = 8;

pi_item: []int = new int[8](0);

pi_src: []int = new int[8](0);

pi_c: []int = new int[8](0);

// The current item's chapter (-1: none), and whether it is ready (its
// status said so).
ap_c: int = -1;

ap_cur: int = 0;

// Where to go in it once it is ready (centiseconds, -1: nowhere; -2: the
// ESV's estimate of verse ap_seek_v), and whether it has begun playing.
ap_seek: int = -1;

ap_seek_v: int = 1;

ap_begun: bool = false;

// The 10 Hz poll, and when waiting began (0: not waiting), when Loading…
// was shown (0: not shown).
ap_poll: int = 0;

ap_wait_since: f64 = 0.0f64;

ap_loading_at: f64 = 0.0f64;

ap_stall_timer: int = 0;

ap_last_t: int = -1;

ap_slow_timer: int = 0;

ap_slow_c: int = -1;

// (KVO's context, and the CMTime read and passed: value, timescale | flags
// << 32, epoch.)
cm: []int = new int[3](0);

cm0: []int = new int[3](0);

make_player() {
    if (ap_player != 0) return;
    ap_player = make("AVQueuePlayer");
    msg1(ap_player, sel("setAutomaticallyWaitsToMinimizeStalling:"), 1);
    msg1(ap_player, sel("setActionAtItemEnd:"), 0);
    msg1(ap_player, sel("setAllowsExternalPlayback:"), 0);
    msg4(ap_player, sel("addObserver:forKeyPath:options:context:"), app_obj, nsstring("currentItem"),
        1, 0);
    msg4(ap_player, sel("addObserver:forKeyPath:options:context:"), app_obj, nsstring("timeControlStatus"),
        1, 0)
}

// Chapter c of source s played from verse v (its time in s's timings, or
// for the ESV, an estimate once its length is known).
player_start(s: int, c: int, v: int) {
    make_player();
    ls_engine = ENGINE_PLAYER;
    ls_src = s;
    ap_items_clear();
    ap_c = c;
    ap_begun = false;
    ap_last_t = -1;
    ap_heard_c = -1;
    ap_wait_since = CACurrentMediaTime();
    // (Named at once, by its chapter until its verse is heard; the wash
    // before let go, the page not moved.)
    old: int = speak_c;
    speak_c = c;
    speak_v = 0;
    if (old >= 0) listen_repaint(old);
    if (old != c) listen_repaint(c);
    ap_seek_v = v;
    ap_hold_v = (if (v > 1) v else 0);
    ap_seek = (if (s == SRC_ESV) if (v > 1) -2 else -1 else audio_time_of(s, c, v));
    if (ap_seek == 0) ap_seek = -1;
    if (s == SRC_ESV || !follows_verses(s, c)) {
        fbuf_n = 0;
        fput_str("bible: listen ");
        fput_str(src_ids[s]);
        fput(32);
        fput_code_ref(c, 0);
        fput_str(" by chapter, from ");
        fput_int(ch_num[c]);
        fput(58);
        fput_int(v);
        note_ns(fstring())
    } else {
        // bible: listen souer JHN 3 from 3:14 at 15.70 s
        fbuf_n = 0;
        fput_str("bible: listen ");
        fput_str(src_ids[s]);
        fput(32);
        fput_code_ref(c, 0);
        fput_str(" from ");
        fput_int(ch_num[c]);
        fput(58);
        fput_int(v);
        fput_str(" at ");
        t: int = if (ap_seek > 0) ap_seek else 0;
        fput_int(t / 100);
        fput(46);
        fput(48 + t / 10 % 10);
        fput(48 + t % 10);
        fput_str(" s");
        note_ns(fstring())
    }
    // (The fixture's slow mode: the item comes after 2 s, Loading… meanwhile.)
    if (au_fixture_dir() != 0 && au_fixture_mode == 2) {
        ap_slow_c = c;
        ap_slow_timer = stop_timer(ap_slow_timer);
        ap_slow_timer = after(6.0f64, "listenSlowItem:");
        ap_poll_start();
        listen_label();
        now_playing();
        return
    }
    ap_enqueue(s, c);
    ap_poll_start();
    listen_label();
    now_playing()
}

listen_slow_item(_self: int, _cmd: int, _timer: int): int {
    ap_slow_timer = 0;
    if (!ls_active || ls_engine != ENGINE_PLAYER || ap_slow_c != ap_c) return 0;
    ap_enqueue(ls_src, ap_c);
    0
}

// Chapter c's item made and queued (and, for the ESV, its address asked of
// the Worker first; it is queued when it comes).
ap_enqueue(s: int, c: int) {
    if (c < 0 || c >= chapters || ap_index_of_c(c) >= 0) return;
    url: int = recording_url(s, c);
    if (au_fixture_dir() != 0 && au_fixture_mode == 1) url = msg1(cls("NSURL"), sel("fileURLWithPath:"),
        au_fixture_file("offline.mp3"));
    if (url == 0) {
        if (s == SRC_ESV) esv_audio_ask(c);
        return
    }
    slot: int = -1;
    for i in 0..PL_MOST
        if (slot < 0 && pi_item[i] == 0) slot = i;
    if (slot < 0) return;
    item: int = msg1(cls("AVPlayerItem"), sel("playerItemWithURL:"), url);
    if (item == 0) return;
    msg1(item, sel("setAudioTimePitchAlgorithm:"), objc_const("AVAudioTimePitchAlgorithmTimeDomain"));
    msg_set_f(item, sel("setPreferredForwardBufferDuration:"), 60.0f64);
    pi_item[slot] = keep(item);
    pi_src[slot] = s;
    pi_c[slot] = c;
    msg4(item, sel("addObserver:forKeyPath:options:context:"), app_obj, nsstring("status"),
        1, 0);
    msg2(ap_player, sel("insertItem:afterItem:"), item, 0);
    if (msg(ap_player, sel("currentItem")) == item) ap_cur = item
}

ap_index(item: int): int {
    for i in 0..PL_MOST
        if (item != 0 && pi_item[i] == item) return i;
    -1
}

ap_index_of_c(c: int): int {
    for i in 0..PL_MOST
        if (pi_item[i] != 0 && pi_c[i] == c) return i;
    -1
}

// An item let go: its observer removed first.
ap_release(i: int) {
    if (pi_item[i] == 0) return;
    msg2(pi_item[i], sel("removeObserver:forKeyPath:"), app_obj, nsstring("status"));
    release(pi_item[i]);
    pi_item[i] = 0
}

ap_resetting: bool = false;

// The verse asked for, held on screen until playback reaches it (0: none).
ap_hold_v: int = 0;

// The chapter last heard to its end (one notice a chapter).
ap_heard_c: int = -1;

ap_items_clear() {
    ap_slow_timer = stop_timer(ap_slow_timer);
    if (ap_player != 0) {
        ap_resetting = true;
        msg(ap_player, sel("pause"));
        msg(ap_player, sel("removeAllItems"));
        ap_resetting = false
    }
    for i in 0..PL_MOST ap_release(i);
    ap_cur = 0
}

// The player's time (centiseconds into its current item; -1 if none).
ap_time(): int {
    if (ap_player == 0 || msg(ap_player, sel("currentItem")) == 0) return -1;
    val: int = msg1(ap_player, sel("valueForKey:"), nsstring("currentTime"));
    if (val == 0) return -1;
    cm_read(val)
}

// A CMTime in an NSValue, as centiseconds (-1 if it is not a valid time).
cm_read(val: int): int {
    cm[0] = 0;
    cm[1] = 0;
    cm[2] = 0;
    msg2(val, sel("getValue:size:"), ints_address(cm), 24);
    scale: int = cm[1] & 4294967295;
    flags: int = cm[1] >> 32 & 4294967295;
    if (scale <= 0 || (flags & 1) == 0 || (flags & 16) != 0) return -1;
    cm[0] * 100 / scale
}

// The current item's length (centiseconds, -1 until it is known).
ap_duration(): int {
    item: int = if (ap_player != 0) msg(ap_player, sel("currentItem")) else 0;
    if (item == 0) return -1;
    val: int = msg1(item, sel("valueForKey:"), nsstring("duration"));
    if (val == 0) -1 else cm_read(val)
}

// A seek in flight: its target (centiseconds, -1: none), which is the
// elapsed time Now Playing gives until the player's own time reaches it
// (review r7-1).
ap_seek_target: int = -1;

// To t centiseconds into the current item, exactly.
ap_seek_to(t: int) {
    ap_seek_target = t;
    cm[0] = t;
    cm[1] = 100 | 1 << 32;
    cm[2] = 0;
    cm0[0] = 0;
    cm0[1] = 1 | 1 << 32;
    cm0[2] = 0;
    // (Three CMTimes, each over 16 bytes: by address, on arm64.)
    msg3(ap_player, sel("seekToTime:toleranceBefore:toleranceAfter:"), ints_address(cm),
        ints_address(cm0), ints_address(cm0))
}

ap_rate() {
    if (ap_player == 0 || !ls_playing) return;
    r: f64 = ap_rates[ls_speed];
    if (responds(ap_player, "setDefaultRate:")) msg_set_f32(ap_player, sel("setDefaultRate:"),
        r as f32);
    msg_set_f32(ap_player, sel("setRate:"), r as f32)
}

// KVO: a new current item (a chapter begun), the player waiting or
// playing, an item ready or failed.
listen_observed(
    _self: int,
    _cmd: int,
    path: int,
    object: int,
    _change: int,
    _context: int
): int {
    if (ap_resetting || path == 0) return 0;
    if (object == ap_player && (msg1(path, sel("isEqualToString:"), nsstring("currentItem")) & 255) != 0) {
        ap_item_changed();
        return 0
    }
    if (object == ap_player) {
        ap_waiting_check();
        return 0
    }
    i: int = ap_index(object);
    if (i < 0) return 0;
    status: int = msg(object, sel("status"));
    if (status == 1 && object == msg(ap_player, sel("currentItem"))) ap_ready();
    if (status == 2) ap_failed(pi_src[i], pi_c[i], "failed");
    0
}

// The current item ready: to its verse, and playing at the speed's rate.
ap_ready() {
    if (ap_begun || !ls_active) return;
    ap_begun = true;
    t: int = ap_seek;
    if (t == -2) {
        // (The ESV: the verse's share of the chapter's spoken words, of its
        // length, less 3 s; §12.3.5.)
        d: int = ap_duration();
        t = esv_estimate(ap_c, ap_seek_v, d);
        note_num("bible: esv audio seek estimate cs ", t)
    }
    ap_seek = -1;
    if (t > 0) ap_seek_to(t);
    if (ls_playing) {
        msg(ap_player, sel("play"));
        ap_rate()
    }
    now_playing()
}

// Verse v's estimated time in chapter c of the ESV (centiseconds).
esv_estimate(c: int, v: int, duration: int): int {
    if (duration <= 0 || ch_start[c] < 0) return 0;
    before: int = 0;
    all: int = 0;
    for x in 1..ch_verses[c] + 1 {
        n: int = speak_text(c, x);
        if (x < v) before = before + n;
        all = all + n
    }
    estimate_time(before, all, duration)
}

// A chapter begun by the queue: named, followed, Now Playing, and the one
// after it queued.
ap_item_changed() {
    item: int = msg(ap_player, sel("currentItem"));
    ap_cur = item;
    if (item == 0) return;
    i: int = ap_index(item);
    if (i < 0) return;
    c: int = pi_c[i];
    // (The items more than a chapter behind it let go: the one just ended
    // is kept, for its end's notification.)
    for x in 0..PL_MOST
        if (pi_item[x] != 0 && pi_c[x] < c - 1) ap_release(x);
    if (c != ap_c) {
        ap_c = c;
        ap_begun = msg(item, sel("status")) == 1;
        ap_seek = -1;
        ap_hold_v = 0;
        ap_seek_target = -1;
        fbuf_n = 0;
        fput_str("bible: listen next ");
        fput_code_ref(c, 0);
        note_ns(fstring());
        listen_at(c, 0);
        now_playing();
        dl_pump()
    } else if (msg(item, sel("status")) == 1) ap_ready();
    // (The chapter after it, queued at once: the queue joins them.)
    if (c + 1 < chapters) ap_enqueue(ls_src, c + 1)
}

// An item played to its end: a chapter heard (Revelation 22's: done).
listen_item_ended(_self: int, _cmd: int, note_obj: int): int {
    i: int = ap_index(msg(note_obj, sel("object")));
    if (i < 0 || !ls_active || pi_c[i] == ap_heard_c) return 0;
    c: int = pi_c[i];
    ap_heard_c = c;
    chapter_heard(c);
    if (c == chapters - 1) listen_stop();
    0
}

listen_item_failed(_self: int, _cmd: int, note_obj: int): int {
    i: int = ap_index(msg(note_obj, sel("object")));
    if (i >= 0) ap_failed(pi_src[i], pi_c[i], "failed to play");
    0
}

// A stall: if there is still no progress after 10 s, the source has failed.
listen_item_stalled(_self: int, _cmd: int, _note: int): int {
    if (!ls_active || ls_engine != ENGINE_PLAYER) return 0;
    ap_last_t = ap_time();
    ap_stall_timer = stop_timer(ap_stall_timer);
    ap_stall_timer = after(10.0f64, "listenStallCheck:");
    0
}

listen_stall_check(_self: int, _cmd: int, _timer: int): int {
    ap_stall_timer = 0;
    if (!ls_active || ls_engine != ENGINE_PLAYER || !ls_playing) return 0;
    if (ap_time() <= ap_last_t + 10 && msg(ap_player, sel("timeControlStatus")) != 2) ap_failed(ls_src,
        ap_c, "stalled");
    0
}

// The recording could not be had (§12.3.4): the voice from the same verse,
// the recording tried again at the next chapter.
ap_failed(s: int, c: int, why: str) {
    if (!ls_active || ls_engine != ENGINE_PLAYER) return;
    ls_failed_at[s] = CACurrentMediaTime();
    // (A chapter queued ahead that failed: only the playing one matters
    // now.)
    if (c != ap_c) return;
    // (The verse being read, or the one asked for if none has been yet.)
    v: int = if (speak_v > 0) speak_v else if (ap_seek_v > 0) ap_seek_v else 1;
    if (s == SRC_ESV && ap_begun) {
        d: int = ap_duration();
        t: int = ap_time();
        // (Where the ESV was, by the same estimate backwards.)
        v = 1;
        if (d > 0 && t > 0) {
            while (v < ch_verses[c] && esv_estimate(c, v + 1, d) <= t) v = v + 1
        }
    }
    fbuf_n = 0;
    fput_str("bible: listen fell back to voice at ");
    fput_code_ref(c, v);
    fput_str(" (");
    fput_str(src_ids[s]);
    fput_str(": ");
    fput_str(if (s == SRC_ESV) "unavailable" else "offline");
    fput_str(")");
    note_ns(fstring());
    note(why);
    ap_poll_stop();
    ap_items_clear();
    ls_fallback = s != SRC_ESV;
    voice_start(c, v);
    listen_label()
}

// ---- polling the time (10 Hz, in the foreground, while playing) ----
ap_poll_start() {
    if (ap_poll != 0 || !app_foreground) return;
    ap_poll = keep(msg_f4(cls("NSTimer"), sel("timerWithTimeInterval:target:selector:userInfo:repeats:"),
        0.1f64, app_obj, sel("listenPoll:"), 0, 1));
    msg2(msg(cls("NSRunLoop"), sel("mainRunLoop")), sel("addTimer:forMode:"), ap_poll,
        l8_run_loop_common_modes())
}

ap_poll_stop() {
    if (ap_poll == 0) return;
    msg(ap_poll, sel("invalidate"));
    release(ap_poll);
    ap_poll = 0
}

listen_poll(_self: int, _cmd: int, _timer: int): int {
    ap_poll_once();
    0
}

ap_poll_once() {
    if (!ls_active || ls_engine != ENGINE_PLAYER || ap_c < 0) return;
    ap_waiting_check();
    t: int = ap_time();
    if (t < 0 || !ap_begun) return;
    // (A seek landed: the lock screen told the time from here.)
    if (ap_seek_target >= 0 && t >= ap_seek_target - 5) {
        ap_seek_target = -1;
        now_playing()
    }
    if (demo_on && t != ap_demo_t && t > 0) ap_demo_moved = true;
    ap_demo_t = t;
    if (!follows_verses(ls_src, ap_c)) return;
    // (The verse asked for held until playback reaches it: review r7-1.)
    v: int = audio_verse_shown(ls_src, ap_c, t, ap_hold_v);
    if (v < 0) return;
    if (ap_hold_v > 0 && audio_hold_ended(ls_src, ap_c, t, ap_hold_v)) ap_hold_v = 0;
    if (v != speak_v || speak_c != ap_c) listen_at(ap_c, v)
}

// (The demo: whether the simulator's player ever moved on.)
ap_demo_t: int = -1;

ap_demo_moved: bool = false;

// Waiting for data: Loading… after 0.5 s of it, and kept at least 0.5 s
// (never a flicker).
ap_waiting_check() {
    if (!ls_active || ls_engine != ENGINE_PLAYER) return;
    now: f64 = CACurrentMediaTime();
    status: int = if (ap_player != 0) msg(ap_player, sel("timeControlStatus")) else 0;
    waiting: bool = ls_playing && (status == 1 || !ap_begun);
    if (waiting) {
        if (ap_wait_since <= 0.0f64) ap_wait_since = now;
        if (ap_loading_at <= 0.0f64 && now - ap_wait_since >= 0.5f64) {
            ap_loading_at = now;
            listen_label()
        }
    } else {
        ap_wait_since = 0.0f64;
        if (ap_loading_at > 0.0f64 && now - ap_loading_at >= 0.5f64) {
            ap_loading_at = 0.0f64;
            listen_label()
        }
    }
}

// In the background nothing is drawn: the poll stops (the queue still
// moves on, and its KVO keeps Now Playing right); back, it runs at once.
app_foreground: bool = true;

listen_backgrounded() {
    app_foreground = false;
    ap_poll_stop()
}

listen_foregrounded() {
    app_foreground = true;
    if (!ls_active || ls_engine != ENGINE_PLAYER) return;
    ap_poll_once();
    if (ls_playing) ap_poll_start()
}

// ---- the ESV's recording: its address asked of our server (§12.3.5) ----
esv_au_url: []int = new int[1200](0);

esv_au_asking: int = -1;

esv_audio_url(c: int): int {
    if (c < 0 || c >= chapters) return 0;
    esv_au_url[c]
}

esv_audio_ask(c: int) {
    if (esv_au_url[c] != 0 || esv_au_asking == c) return;
    // The fixture's answer: esv-audio-JHN-3.json, its file: address the
    // fixture's own.
    if (au_fixture_dir() != 0) {
        fbuf_n = 0;
        fput_str("esv-audio-");
        fput_bytes(bsb, book_line[ch_book[c]] + 1, book_line[ch_book[c]] + 4);
        fput(45);
        fput_int(ch_num[c]);
        fput_str(".json");
        data: int = msg1(cls("NSData"), sel("dataWithContentsOfFile:"), msg1(au_fixture_dir(),
            sel("stringByAppendingPathComponent:"), fstring()));
        json: int = if (data != 0) msg3(cls("NSJSONSerialization"), sel("JSONObjectWithData:options:error:"),
            data, 0, 0) else 0;
        fbuf_n = 0;
        fput_str("bible: esv audio ");
        fput_code_ref(c, 0);
        fput_str(" (fixture)");
        note_ns(fstring());
        esv_audio_answered(c, if (json != 0) 200 else 404, json);
        return
    }
    esv_au_asking = c;
    fbuf_n = 0;
    fput_str("esv/audio?book=");
    fput_bytes(bsb, book_line[ch_book[c]] + 1, book_line[ch_book[c]] + 4);
    fput_str("&chapter=");
    fput_int(ch_num[c]);
    if (net_get_ns(fstring(), NET_AUDIO, c, 1) == 0) esv_audio_answered(c, 0, 0)
}

// The Worker's answer: the address kept for the session, and the item
// queued; or the voice.
esv_audio_answered(c: int, status: int, json: int) {
    if (esv_au_asking == c) esv_au_asking = -1;
    url: int = 0;
    if (status == 200 && json != 0) {
        u: int = msg1(json, sel("objectForKey:"), nsstring("url"));
        if (u != 0 && (msg1(u, sel("hasPrefix:"), nsstring("https://audio.esv.org/")) & 255) != 0) url = msg1(cls("NSURL"),
            sel("URLWithString:"), u);
        // (The fixture's: a file beside it.)
        if (u != 0 && au_fixture_dir() != 0 && (msg1(u, sel("hasPrefix:"), nsstring("file:")) & 255) != 0) url = msg1(cls("NSURL"),
            sel("fileURLWithPath:"), au_fixture_file("tone.mp3"))
    }
    if (url != 0) {
        esv_au_url[c] = keep(url);
        if (ls_active && ls_engine == ENGINE_PLAYER && ls_src == SRC_ESV) ap_enqueue(SRC_ESV,
            c);
        return
    }
    note_num("bible: esv audio unavailable, status ", status);
    if (ls_active && ls_engine == ENGINE_PLAYER && ls_src == SRC_ESV && c == ap_c) ap_failed(SRC_ESV,
        c, "the Worker")
}

// ---- following ----
// The verse being read now: washed (a short cross-fade from the last),
// named in the player, and followed down the page.
listen_at(c: int, v: int) {
    ls_began_at = CACurrentMediaTime();
    old: int = speak_c;
    old_v: int = speak_v;
    speak_c = c;
    speak_v = v;
    if (old >= 0 && old != c) listen_repaint(old);
    if (old != c || old_v != v) listen_repaint(c);
    listen_label();
    // (A new chapter begun by the queue: its opener to the top, so the
    // title moves with it, through the reader's own scroll; §12.3.2.)
    if (old >= 0 && old != c && v == 0) listen_follow_chapter(c) else if (v > 0) listen_follow(false)
}

listen_follow_chapter(c: int) {
    if (CACurrentMediaTime() < ls_follow_after || reader_moving()) return;
    if (view_of(c) == 0) {
        go_top(c);
        return
    }
    to: f64 = row_y(c) - top_inset(table);
    l8_msg_hfa(hfa, table, sel("contentSize"), 0, 0, 0);
    most: f64 = hfa[1] + bottom_inset(table) - view_height(table);
    if (to > most) to = most;
    reading_scrolled();
    if (reduce_motion()) {
        fade_layer(msg(table, sel("layer")), 0.15f64);
        set_offset(to)
    } else set_offset_animated(to)
}

// The verse spoken kept in sight: when its first line falls below 70% of
// what is seen, or up under the bar, it is scrolled to a third of the way
// down (not while a drag's pause lasts, unless asked).
listen_follow(forced: bool) {
    if (speak_c < 0) return;
    if (!forced && CACurrentMediaTime() < ls_follow_after) return;
    // (Never while the reader moves: a finger on it, or a glide; review
    // r5-1. Asked for, it waits for rest.)
    if (reader_moving()) {
        if (forced) ls_follow_due = true;
        return
    }
    tv: int = view_of(speak_c);
    if (tv == 0) {
        if (forced || speak_v == 0) go_verse(speak_c, if (speak_v > 0) speak_v else 1);
        return
    }
    y: f64 = verse_y(speak_c, speak_v) - offset_y(table);
    H: f64 = view_height(table);
    if (!forced && y <= 0.7f64 * H && y >= bar_bottom()) return;
    seen: f64 = H - top_inset(table) - bottom_inset(table);
    to: f64 = verse_y(speak_c, speak_v) - top_inset(table) - seen / 3.0f64;
    l8_msg_hfa(hfa, table, sel("contentSize"), 0, 0, 0);
    most: f64 = hfa[1] + bottom_inset(table) - H;
    if (to > most) to = most;
    if (to < -top_inset(table)) to = -top_inset(table);
    // (Listen's scroll moves a reading, as the finger's does: §11.1.1.)
    reading_scrolled();
    if (reduce_motion()) {
        fade_layer(msg(table, sel("layer")), 0.15f64);
        set_offset(to)
    } else set_offset_animated(to)
}

// A follow asked for while the reader moved (Listen's name), made at rest.
ls_follow_due: bool = false;

listen_repaint(c: int) {
    tv: int = view_of(c);
    if (tv == 0) return;
    fade_layer(msg(tv, sel("layer")), 0.2f64);
    repaint(c)
}

// A drag in the reader: following waits while it lasts, and until 8 s
// after it ends.
listen_drag_began() {
    if (ls_active) ls_follow_after = CACurrentMediaTime() + 100000.0f64
}

listen_dragged() {
    if (ls_active) ls_follow_after = CACurrentMediaTime() + 8.0f64;
    if (ls_follow_due) {
        ls_follow_due = false;
        listen_follow(true)
    }
}

// ---- pausing, resuming, stopping ----
listen_pause() {
    if (!ls_active || !ls_playing) return;
    ls_playing = false;
    if (ls_engine == ENGINE_PLAYER) {
        if (ap_player != 0) msg(ap_player, sel("pause"));
        ap_poll_stop()
    } else if (ls_synth != 0) msg1(ls_synth, sel("pauseSpeakingAtBoundary:"), 0);
    listen_label();
    listen_symbol();
    now_playing()
}

listen_resume() {
    if (!ls_active || ls_playing) return;
    ls_playing = true;
    listen_session_on();
    ls_began_at = CACurrentMediaTime();
    // (Resuming asks again which source may be heard: the voice standing in
    // gives way to the recording, a recording gone to the voice.)
    if (speak_c >= 0) {
        want: int = listen_effective(ls_chosen, speak_c);
        if (want != ls_src && (ls_engine == ENGINE_PLAYER || ls_fallback)) {
            listen_restart_at(speak_c, if (speak_v > 0) speak_v else 1);
            return
        }
    }
    if (ls_engine == ENGINE_PLAYER) {
        if (ap_player != 0 && ap_begun) {
            msg(ap_player, sel("play"));
            ap_rate()
        }
        ap_poll_start()
    } else if (ls_synth != 0) msg(ls_synth, sel("continueSpeaking"));
    listen_label();
    listen_symbol();
    now_playing()
}

listen_stop_engine() {
    ls_demo_timer = stop_timer(ls_demo_timer);
    if (ls_synth != 0) msg1(ls_synth, sel("stopSpeakingAtBoundary:"), 0);
    ls_un = 0;
    ap_poll_stop();
    ap_stall_timer = stop_timer(ap_stall_timer);
    ap_items_clear();
    ap_c = -1;
    ap_begun = false;
    ap_loading_at = 0.0f64;
    ap_wait_since = 0.0f64;
    ls_esv_c = -1
}

// Listening stopped: the speech or the recording, the wash, the player,
// the session.
listen_stop() {
    if (!ls_active) return;
    ls_active = false;
    ls_playing = false;
    ls_fallback = false;
    listen_stop_engine();
    session: int = msg(cls("AVAudioSession"), sel("sharedInstance"));
    if (session != 0) msg3(session, sel("setActive:withOptions:error:"), 0, 1, 0);
    c: int = speak_c;
    speak_c = -1;
    speak_v = 0;
    tv: int = view_of(c);
    if (tv != 0) {
        fade_layer(msg(tv, sel("layer")), 0.2f64);
        repaint(c)
    }
    center: int = msg(cls("MPNowPlayingInfoCenter"), sel("defaultCenter"));
    if (center != 0) msg1(center, sel("setNowPlayingInfo:"), 0);
    listen_hide();
    if (settings_table != 0) msg(settings_table, sel("reloadData"))
}

// The demo: the wash moves on every 2 s should the simulator's synthesizer
// say nothing (it may have no voice to speak with).
listen_demo_tick(_self: int, _cmd: int, _timer: int): int {
    if (!ls_active || !ls_playing || ls_engine != ENGINE_VOICE) return 0;
    if (CACurrentMediaTime() - ls_began_at < (if (ls_demo_fast) 2.0f64 else 6.0f64)) return 0;
    c: int = speak_c;
    v: int = speak_v + 1;
    if (c < 0) return 0;
    if (v > ch_verses[c]) {
        if (c + 1 >= chapters) return 0;
        c = c + 1;
        v = 1
    }
    listen_at(c, v);
    0
}

listen_interrupted(_self: int, _cmd: int, notification: int): int {
    info: int = msg(notification, sel("userInfo"));
    if (info == 0) return 0;
    kind: int = msg1(info, sel("objectForKey:"), objc_const("AVAudioSessionInterruptionTypeKey"));
    if (kind != 0 && msg(kind, sel("integerValue")) == 1) listen_pause();
    0
}

// Headphones unplugged (the old device unavailable, reason 2): paused, so
// the speaker does not start.
listen_route_changed(_self: int, _cmd: int, notification: int): int {
    info: int = msg(notification, sel("userInfo"));
    if (info == 0) return 0;
    r: int = msg1(info, sel("objectForKey:"), objc_const("AVAudioSessionRouteChangeReasonKey"));
    if (r != 0 && msg(r, sel("integerValue")) == 2) listen_pause();
    0
}

// ---- the lock screen's commands (§12.3.7) ----
remote_play(_self: int, _cmd: int, _event: int): int {
    listen_resume();
    0
}

remote_pause(_self: int, _cmd: int, _event: int): int {
    listen_pause();
    0
}

remote_toggle(_self: int, _cmd: int, _event: int): int {
    if (ls_playing) listen_pause() else listen_resume();
    0
}

// The next chapter.
remote_next(_self: int, _cmd: int, _event: int): int {
    if (!ls_active || speak_c < 0 || speak_c + 1 >= chapters) return 0;
    listen_restart_at(speak_c + 1, 1);
    0
}

// This chapter's start if more than 3 s into it, else the chapter before.
remote_previous(_self: int, _cmd: int, _event: int): int {
    if (!ls_active || speak_c < 0) return 0;
    c: int = speak_c;
    into: bool = if (ls_engine == ENGINE_PLAYER) ap_time() > 300 else speak_v > 1;
    if (!into && c > 0) c = c - 1;
    listen_restart_at(c, 1);
    0
}

// Scrubbing (recordings only).
remote_position(_self: int, _cmd: int, event: int): int {
    if (!ls_active || ls_engine != ENGINE_PLAYER || event == 0) return 0;
    t: f64 = msg_f(event, sel("positionTime"));
    ap_hold_v = 0;
    ap_seek_to((t * 100.0f64) as int);
    ap_poll_once();
    now_playing();
    0
}

// What the lock screen shows (§12.3.7): the chapter, the reader, the
// version, the artwork; for recordings, the length and the time; the rate.
np_keys: []int = new int[8](0);

np_values: []int = new int[8](0);

np_artwork: int = 0;

np_artwork_px: int = 0;

now_playing() {
    center: int = msg(cls("MPNowPlayingInfoCenter"), sel("defaultCenter"));
    if (center == 0 || speak_c < 0) return;
    c: int = speak_c;
    n: int = 0;
    fbuf_n = 0;
    fput_title(c);
    np_keys[n] = objc_const("MPMediaItemPropertyTitle");
    np_values[n] = fstring();
    n = n + 1;
    reader: str = src_readers[ls_src];
    np_keys[n] = objc_const("MPMediaItemPropertyArtist");
    np_values[n] = nsstring(reader);
    n = n + 1;
    np_keys[n] = objc_const("MPMediaItemPropertyAlbumTitle");
    np_values[n] = nsstring(text_names[text_cur]);
    n = n + 1;
    duration: int = -1;
    elapsed: int = -1;
    if (ls_engine == ENGINE_PLAYER) {
        duration = ap_duration();
        elapsed = ap_time();
        if (ap_seek_target >= 0 && elapsed < ap_seek_target - 5) elapsed = ap_seek_target;
        if (duration > 0) {
            np_keys[n] = objc_const("MPMediaItemPropertyPlaybackDuration");
            np_values[n] = nsnumber_f(duration as f64 / 100.0f64);
            n = n + 1
        }
        if (elapsed >= 0) {
            np_keys[n] = objc_const("MPNowPlayingInfoPropertyElapsedPlaybackTime");
            np_values[n] = nsnumber_f(elapsed as f64 / 100.0f64);
            n = n + 1
        }
    }
    rate: f64 = if (!ls_playing) 0.0f64 else if (ls_engine == ENGINE_PLAYER) ap_rates[ls_speed] else 1.0f64;
    np_keys[n] = objc_const("MPNowPlayingInfoPropertyPlaybackRate");
    np_values[n] = nsnumber_f(rate);
    n = n + 1;
    np_keys[n] = objc_const("MPNowPlayingInfoPropertyDefaultPlaybackRate");
    np_values[n] = nsnumber_f(1.0f64);
    n = n + 1;
    if (np_artwork == 0) {
        bundle: int = msg(cls("NSBundle"), sel("mainBundle"));
        path: int = msg2(bundle, sel("pathForResource:ofType:"), nsstring("nowplaying"),
            nsstring("png"));
        img: int = if (path != 0) msg1(cls("UIImage"), sel("imageWithContentsOfFile:"),
            path) else 0;
        if (img != 0) {
            // (The deprecated initializer: it takes no block.)
            np_artwork = msg1(msg(cls("MPMediaItemArtwork"), sel("alloc")), sel("initWithImage:"),
                img);
            l8_msg_hfa(hfa, img, sel("size"), 0, 0, 0);
            np_artwork_px = (hfa[0] * msg_f(img, sel("scale"))) as int;
            note("bible: now playing artwork by initWithImage: (deprecated, no block)")
        }
    }
    if (np_artwork != 0) {
        np_keys[n] = objc_const("MPMediaItemPropertyArtwork");
        np_values[n] = np_artwork;
        n = n + 1
    }
    for k in 0..n
        if (np_keys[k] == 0) return;
    msg1(center, sel("setNowPlayingInfo:"), nsdictionary(np_keys, np_values, n));
    // Scrubbing for recordings only.
    cc: int = msg(cls("MPRemoteCommandCenter"), sel("sharedCommandCenter"));
    if (cc != 0) msg1(msg(cc, sel("changePlaybackPositionCommand")), sel("setEnabled:"),
        if (ls_engine == ENGINE_PLAYER) 1 else 0);
    if (!diag_on) return;
    // bible: now playing {title: John 3, artist: Bob Souer, album: …}
    fbuf_n = 0;
    fput_str("bible: now playing {title: ");
    fput_title(c);
    fput_str(", artist: ");
    fput_str(reader);
    fput_str(", album: ");
    fput_str(text_names[text_cur]);
    if (duration > 0) {
        fput_str(", duration: ");
        fput_tenths(duration)
    }
    if (elapsed >= 0) {
        fput_str(", elapsed: ");
        fput_tenths(elapsed)
    }
    fput_str(", rate: ");
    fput_tenths((rate * 100.0f64 + 0.5f64) as int);
    fput_str(", artwork: ");
    fput_int(np_artwork_px);
    fput_str("}");
    note_ns(fstring())
}

// Centiseconds as seconds to a tenth ("15.7"; rates as "1.25" would be
// "1.2": a rate's hundredths shown whole).
fput_tenths(cs: int) {
    fput_int(cs / 100);
    fput(46);
    fput(48 + cs / 10 % 10);
    if (cs % 10 != 0) fput(48 + cs % 10)
}

// ---- the player: a floating capsule at the bottom ----
mp: int = 0;

mp_effect: int = 0;

mp_play: int = 0;

mp_title: int = 0;

mp_state: int = 0;

mp_name: int = 0;

mp_close: int = 0;

listen_shown: bool = false;

mp_timer: int = 0;

MP_H: f64 = 48.0f64;

make_player_view() {
    if (mp != 0) return;
    mp = make("UIView");
    layer: int = msg(mp, sel("layer"));
    msg1(layer, sel("setShadowColor:"), msg(msg(cls("UIColor"), sel("blackColor")),
        sel("CGColor")));
    msg_set_f32(layer, sel("setShadowOpacity:"), 0.15f64 as f32);
    msg_set_f(layer, sel("setShadowRadius:"), 16.0f64);
    msg_ff(layer, sel("setShadowOffset:"), 0.0f64, 4.0f64);
    glass: int = cls("UIGlassEffect");
    effect: int = if (glass != 0) make("UIGlassEffect") else msg1(cls("UIBlurEffect"),
        sel("effectWithStyle:"), 9);
    mp_effect = msg1(msg(cls("UIVisualEffectView"), sel("alloc")), sel("initWithEffect:"),
        effect);
    el: int = msg(mp_effect, sel("layer"));
    msg_set_f(el, sel("setCornerRadius:"), MP_H / 2.0f64);
    curve: int = objc_const("kCACornerCurveContinuous");
    if (curve != 0) msg1(el, sel("setCornerCurve:"), curve);
    msg1(mp_effect, sel("setClipsToBounds:"), 1);
    msg1(mp, sel("addSubview:"), mp_effect);
    content: int = msg(mp_effect, sel("contentView"));
    mp_play = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg3(mp_play, sel("addTarget:action:forControlEvents:"), app_obj, sel("listenPlayPause:"),
        64);
    msg1(content, sel("addSubview:"), mp_play);
    // The name and the state, over a button that goes to the verse.
    mp_name = msg1(cls("UIButton"), sel("buttonWithType:"), 0);
    msg3(mp_name, sel("addTarget:action:forControlEvents:"), app_obj, sel("listenNameTapped:"),
        64);
    msg1(mp_name, sel("setAccessibilityHint:"), nsstring("Shows the verse being read"));
    msg1(content, sel("addSubview:"), mp_name);
    mp_title = make("UILabel");
    msg1(mp_title, sel("setFont:"), sans(15.0f64, 0.3f64));
    msg1(mp_title, sel("setUserInteractionEnabled:"), 0);
    msg1(mp_name, sel("addSubview:"), mp_title);
    release(mp_title);
    mp_state = make("UILabel");
    msg1(mp_state, sel("setFont:"), sans(12.0f64, 0.0f64));
    msg1(mp_state, sel("setUserInteractionEnabled:"), 0);
    msg1(mp_name, sel("addSubview:"), mp_state);
    release(mp_state);
    mp_close = msg1(cls("UIButton"), sel("buttonWithType:"), 1);
    msg2(mp_close, sel("setImage:forState:"), symbol("xmark", 13.0f64, 6, 0), 0);
    msg1(mp_close, sel("setAccessibilityLabel:"), nsstring("Stop Listening"));
    msg3(mp_close, sel("addTarget:action:forControlEvents:"), app_obj, sel("listenClose:"),
        64);
    msg1(content, sel("addSubview:"), mp_close);
    msg1(mp, sel("setHidden:"), 1);
    msg1(window, sel("addSubview:"), mp)
}

// Its place (bottom center, 12 points above the safe area), its colors.
layout_player() {
    if (mp == 0) return;
    root: int = window;
    W: f64 = view_width(root);
    H: f64 = view_height(root);
    l8_msg_hfa(hfa, root, sel("safeAreaInsets"), 0, 0, 0);
    bottom: f64 = hfa[2];
    w: f64 = W - 32.0f64;
    if (w > 360.0f64) w = 360.0f64;
    msg_rect(mp, sel("setFrame:"), (W - w) / 2.0f64, H - bottom - 12.0f64 - MP_H,
        w, MP_H);
    msg_rect(mp_effect, sel("setFrame:"), 0.0f64, 0.0f64, w, MP_H);
    msg_rect(mp_play, sel("setFrame:"), 8.0f64, (MP_H - 36.0f64) / 2.0f64, 36.0f64,
        36.0f64);
    msg_rect(mp_close, sel("setFrame:"), w - 10.0f64 - 28.0f64, (MP_H - 28.0f64) / 2.0f64,
        28.0f64, 28.0f64);
    msg_rect(mp_name, sel("setFrame:"), 52.0f64, 0.0f64, w - 52.0f64 - 46.0f64, MP_H);
    msg_rect(mp_title, sel("setFrame:"), 0.0f64, 6.0f64, w - 52.0f64 - 46.0f64, 20.0f64);
    msg_rect(mp_state, sel("setFrame:"), 0.0f64, 26.0f64, w - 52.0f64 - 46.0f64, 16.0f64);
    msg1(mp_play, sel("setTintColor:"), c_ink);
    msg1(mp_close, sel("setTintColor:"), c_ink);
    msg1(mp_close, sel("setBackgroundColor:"), msg(cls("UIColor"), sel("systemFillColor")));
    msg_set_f(msg(mp_close, sel("layer")), sel("setCornerRadius:"), 14.0f64);
    msg1(mp_title, sel("setTextColor:"), c_ink);
    msg1(mp_state, sel("setTextColor:"), c_faint)
}

// The second line (§12.4.4): the reader, the voice, the voice standing
// in, Loading…, or Paused.
ls_state_buf: []i8 = new i8[96](0i8);

ls_state_n: int = 0;

fput_listen_state() {
    if (!ls_playing) fput_str("Paused") else if (ls_engine == ENGINE_VOICE && ls_fallback) fput_str("iPhone Voice \�\� Offline") else if (ls_engine == ENGINE_PLAYER && ap_loading_at > 0.0f64) fput_str("Loading\�\�\�") else fput_str(src_readers[ls_src])
}

listen_label() {
    if (mp == 0 || speak_c < 0) return;
    fbuf_n = 0;
    // (The verse; before verse 1, and for the ESV, the chapter.)
    if (speak_v > 0) fput_ref(speak_c, speak_v, 0) else fput_title(speak_c);
    msg1(mp_title, sel("setText:"), fstring());
    title_n: int = fbuf_n;
    fput_listen_state();
    // (A change of state cross-fades.)
    changed: bool = fbuf_n - title_n != ls_state_n;
    for i in title_n..fbuf_n
        if (!changed && fbuf[i] != ls_state_buf[i - title_n]) changed = true;
    if (changed) {
        ls_state_n = fbuf_n - title_n;
        for i in title_n..fbuf_n ls_state_buf[i - title_n] = fbuf[i];
        if (listen_shown) fade_layer(msg(mp_state, sel("layer")), 0.2f64);
        msg1(mp_state, sel("setText:"), nsstring_at(bytes_address(fbuf) + title_n,
            ls_state_n));
        if (demo_on) {
            note_ns(nsstring_at(bytes_address(fbuf) + title_n, ls_state_n));
            note("bible: listen state (above)")
        }
    }
    // "John 3:14, Bob Souer"
    fbuf_n = 0;
    if (speak_v > 0) fput_ref(speak_c, speak_v, 0) else fput_title(speak_c);
    fput_str(", ");
    fput_listen_state();
    msg1(mp_name, sel("setAccessibilityLabel:"), fstring())
}

// The play or pause symbol (a short cross-fade between them).
listen_symbol() {
    if (mp == 0) return;
    fade_layer(msg(mp_play, sel("layer")), 0.15f64);
    msg2(mp_play, sel("setImage:forState:"), symbol(if (ls_playing) "pause.fill" else "play.fill",
        20.0f64, 6, 0), 0);
    msg1(mp_play, sel("setAccessibilityLabel:"), nsstring(if (ls_playing) "Pause" else "Play"))
}

// The player rising (as the tray does), the capsule back out of its way,
// and the tray above it.
listen_show() {
    make_player_view();
    layout_player();
    ls_state_n = 0;
    listen_label();
    msg2(mp_play, sel("setImage:forState:"), symbol(if (ls_playing) "pause.fill" else "play.fill",
        20.0f64, 6, 0), 0);
    msg1(mp_play, sel("setAccessibilityLabel:"), nsstring(if (ls_playing) "Pause" else "Play"));
    if (listen_shown) return;
    listen_shown = true;
    hide_back();
    tray_raise(true);
    mp_timer = stop_timer(mp_timer);
    msg1(mp, sel("setHidden:"), 0);
    msg1(window, sel("bringSubviewToFront:"), mp);
    layer: int = msg(mp, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 1.0f64 as f32);
    if (reduce_motion()) {
        animate(layer, "opacity", 0.0f64, 1.0f64, false, 0.15f64);
        return
    }
    animate(layer, "transform.translation.y", MP_H + 24.0f64, 0.0f64, true, 0.0f64);
    animate(layer, "opacity", 0.0f64, 1.0f64, false, 0.18f64)
}

listen_hide() {
    if (!listen_shown) return;
    listen_shown = false;
    tray_raise(false);
    layer: int = msg(mp, sel("layer"));
    msg_set_f32(layer, sel("setOpacity:"), 0.0f64 as f32);
    if (!reduce_motion()) animate(layer, "transform.translation.y", 0.0f64, MP_H + 24.0f64,
        false, 0.2f64);
    animate(layer, "opacity", 1.0f64, 0.0f64, false, 0.2f64);
    mp_timer = stop_timer(mp_timer);
    mp_timer = after(0.22f64, "listenHidden:")
}

listen_hidden(_self: int, _cmd: int, _timer: int): int {
    mp_timer = 0;
    if (!listen_shown && mp != 0) msg1(mp, sel("setHidden:"), 1);
    0
}

// The tray's place: 60 points higher while the player is up (moved with
// the tray's spring, if it is showing).
tray_raise(up: bool) {
    if (tray_bottom == 0) return;
    msg_set_f(tray_bottom, sel("setConstant:"), if (up) -68.0f64 else -8.0f64);
    msg(window, sel("layoutIfNeeded"));
    if (tray_shown && !reduce_motion()) animate(msg(tray, sel("layer")), "transform.translation.y",
        if (up) 60.0f64 else -60.0f64, 0.0f64, true, 0.0f64)
}

listen_play_pause(_self: int, _cmd: int, _b: int): int {
    if (ls_playing) listen_pause() else listen_resume();
    0
}

listen_close(_self: int, _cmd: int, _b: int): int {
    listen_stop();
    0
}

listen_name_tapped(_self: int, _cmd: int, _b: int): int {
    ls_follow_after = 0.0f64;
    stop_moving();
    listen_follow(true);
    0
}

// The settings' Listen button: listening from the verse at the top (the
// sheet put away), or stopped.
listen_button_tapped(_self: int, _cmd: int, _b: int): int {
    if (ls_active) {
        listen_stop();
        return 0
    }
    v: int = listen_top_verse();
    c: int = cur;
    dismiss_sheets();
    listen_start(c, v);
    0
}

// The verse at the top of the reader, to listen from: the one the top
// line ends in (a verse begun on that line, not the one ending there).
listen_top_verse(): int {
    measure_place();
    v: int = if (place_v > 0) place_v else 1;
    tv: int = current_view();
    if (tv == 0) return v;
    pos: int = msg_ff(tv, sel("closestPositionToPoint:"), view_width(tv) - side_margin() - 2.0f64,
        cur_y + 4.0f64);
    if (pos == 0) return v;
    k: int = msg2(tv, sel("offsetFromPosition:toPosition:"), msg(tv, sel("beginningOfDocument")),
        pos);
    compute_ranges(cur);
    for x in 0..rv_count
        if (rv_b[x] <= k) v = rv_num[x];
    if (v < 1) 1 else v
}

// Speed: at once (the player's rate; the voice's next utterances).
listen_speed_picked(_self: int, _cmd: int, s: int): int {
    ls_speed = msg(s, sel("selectedSegmentIndex"));
    set_def_int("listenRate", ls_speed);
    if (ls_active && ls_engine == ENGINE_PLAYER) {
        ap_rate();
        now_playing()
    }
    fbuf_n = 0;
    fput_str("bible: listen rate ");
    r: f64 = if (ls_active && ls_engine == ENGINE_VOICE) ls_rates[ls_speed] else ap_rates[ls_speed];
    cs: int = (r * 100.0f64 + 0.5f64) as int;
    fput_int(cs / 100);
    fput(46);
    fput(48 + cs / 10 % 10);
    if (cs % 10 != 0) fput(48 + cs % 10);
    note_ns(fstring());
    0
}

add_listen_methods(app: int) {
    add_method1(app, sel("idleTimeout:"), &idle_timeout, "v@:@");
    add_method1(app, sel("keepOnSwitched:"), &keep_on_switched, "v@:@");
    add_method2(app, sel("speechSynthesizer:didStartSpeechUtterance:"), &listen_began,
        "v@:@@");
    add_method2(app, sel("speechSynthesizer:didFinishSpeechUtterance:"), &listen_finished,
        "v@:@@");
    add_method4(app, sel("observeValueForKeyPath:ofObject:change:context:"), &listen_observed,
        "v@:@@@^v");
    add_method1(app, sel("listenDemoTick:"), &listen_demo_tick, "v@:@");
    add_method1(app, sel("listenInterrupted:"), &listen_interrupted, "v@:@");
    add_method1(app, sel("listenRouteChanged:"), &listen_route_changed, "v@:@");
    add_method1(app, sel("listenItemEnded:"), &listen_item_ended, "v@:@");
    add_method1(app, sel("listenItemFailed:"), &listen_item_failed, "v@:@");
    add_method1(app, sel("listenItemStalled:"), &listen_item_stalled, "v@:@");
    add_method1(app, sel("listenStallCheck:"), &listen_stall_check, "v@:@");
    add_method1(app, sel("listenPoll:"), &listen_poll, "v@:@");
    add_method1(app, sel("listenSlowItem:"), &listen_slow_item, "v@:@");
    add_method1(app, sel("remotePlay:"), &remote_play, "q@:@");
    add_method1(app, sel("remotePause:"), &remote_pause, "q@:@");
    add_method1(app, sel("remoteToggle:"), &remote_toggle, "q@:@");
    add_method1(app, sel("remoteNext:"), &remote_next, "q@:@");
    add_method1(app, sel("remotePrevious:"), &remote_previous, "q@:@");
    add_method1(app, sel("remotePosition:"), &remote_position, "q@:@");
    add_method1(app, sel("listenPlayPause:"), &listen_play_pause, "v@:@");
    add_method1(app, sel("listenClose:"), &listen_close, "v@:@");
    add_method1(app, sel("listenNameTapped:"), &listen_name_tapped, "v@:@");
    add_method1(app, sel("listenHidden:"), &listen_hidden, "v@:@");
    add_method1(app, sel("listenButton:"), &listen_button_tapped, "v@:@");
    add_method1(app, sel("listenSpeed:"), &listen_speed_picked, "v@:@");
    add_protocol(app, "AVSpeechSynthesizerDelegate")
}

// ---- the ESV's text, listened to by the voice ----
// The ESV chapter Listen waits for (-1: none), and from which verse.
ls_esv_c: int = -1;

ls_esv_first: int = 1;

listen_esv_arrived(c: int) {
    if (!ls_active || ls_esv_c != c || ls_engine != ENGINE_VOICE) return;
    ls_esv_c = -1;
    listen_queue(c, ls_esv_first)
}

// The ESV's next chapter could not come: paused, the player saying so.
ls_offline: bool = false;

listen_esv_failed(c: int) {
    if (!ls_active || ls_esv_c != c || ls_engine != ENGINE_VOICE) return;
    ls_esv_c = -1;
    listen_pause();
    ls_fallback = false;
    msg1(mp_state, sel("setText:"), nsstring("Paused \�\� Offline"))
}
