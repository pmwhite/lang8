tag bible_ios;

use_tag std, ios, bible;

// History (DESIGN.md §8.3): the trail of chapters read (store.l8 keeps it),
// pushed from the passage picker's Recent section by Show All. Its sections
// are days (Today, Yesterday, a weekday, then a date), newest first; a row
// goes there; a row swiped away is deleted; Clear's menu clears it all.
import "../ios/objc.l8";

import "text.l8";

hist_table: int = 0;

hist_vc: int = 0;

hist_clear_button: int = 0;

// The rows, newest first (history's indexes), and the sections: each a day
// (local), its first row and how many.
hr_n: int = 0;

hr_i: []int = new int[201](0);

hd_n: int = 0;

hd_day: []int = new int[201](0);

hd_start: []int = new int[201](0);

hd_count: []int = new int[201](0);

// The local time's offset from UTC, in seconds (now).
local_offset(): int {
    msg(msg(cls("NSTimeZone"), sel("localTimeZone")), sel("secondsFromGMT"))
}

// The day (local) of a time.
local_day(t: int): int {
    day_of(t + local_offset())
}

hist_build() {
    hr_n = 0;
    hd_n = 0;
    i: int = hs_n - 1;
    while (i >= 0) {
        d: int = local_day(hs_time[i]);
        if (hd_n == 0 || hd_day[hd_n - 1] != d) {
            hd_day[hd_n] = d;
            hd_start[hd_n] = hr_n;
            hd_count[hd_n] = 0;
            hd_n = hd_n + 1
        }
        hr_i[hr_n] = i;
        hr_n = hr_n + 1;
        hd_count[hd_n - 1] = hd_count[hd_n - 1] + 1;
        i = i - 1
    }
}

open_history() {
    sheet_nav: int = presented();
    if (sheet_nav == 0) return;
    vc: int = msg(msg1(msg(cls("UITableViewController"), sel("alloc")), sel("initWithStyle:"),
        2), sel("autorelease"));
    hist_vc = held(hist_vc, vc);
    msg1(vc, sel("setTitle:"), nsstring("History"));
    msg1(msg(vc, sel("navigationItem")), sel("setLargeTitleDisplayMode:"), 2);
    hist_table = held(hist_table, msg(vc, sel("tableView")));
    msg1(hist_table, sel("setDataSource:"), app_obj);
    msg1(hist_table, sel("setDelegate:"), app_obj);
    style_table(hist_table, true);
    // Clear: a menu of one destructive command, the menu its confirmation
    // (as Safari's).
    config: int = msg(cls("UIButtonConfiguration"), sel("plainButtonConfiguration"));
    msg1(config, sel("setTitle:"), nsstring("Clear"));
    msg1(config, sel("setBaseForegroundColor:"), c_accent);
    hist_clear_button = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
        config, 0);
    msg1(hist_clear_button, sel("setShowsMenuAsPrimaryAction:"), 1);
    one[0] = msg4(cls("UICommand"), sel("commandWithTitle:image:action:propertyList:"),
        nsstring("Clear History"), 0, sel("historyClear:"), 0);
    msg1(one[0], sel("setAttributes:"), 2);
    msg1(hist_clear_button, sel("setMenu:"), msg2(cls("UIMenu"), sel("menuWithTitle:children:"),
        nsstring(""), nsarray(one, 1)));
    item: int = msg(msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
        hist_clear_button), sel("autorelease"));
    msg1(msg(vc, sel("navigationItem")), sel("setRightBarButtonItem:"), item);
    hist_build();
    hist_empty_state(false);
    msg2(sheet_nav, sel("pushViewController:animated:"), vc, 1)
}

hist_empty_state(fade: bool) {
    if (hist_vc == 0) return;
    msg1(hist_clear_button, sel("setEnabled:"), if (hs_n > 0) 1 else 0);
    if (hs_n > 0) {
        empty_state(hist_vc, hist_table, "", 0, "");
        return
    }
    if (fade) fade_layer(msg(msg(hist_vc, sel("view")), sel("layer")), 0.25f64);
    empty_state(hist_vc, hist_table, "clock.arrow.circlepath", nsstring("No History"),
        "Places you read will appear here.")
}

// A day's name: Today, Yesterday, a weekday (the week past), or the date.
hist_header(s: int): int {
    d: int = hd_day[s];
    today: int = local_day(time(0));
    if (d == today) return nsstring("Today");
    if (d == today - 1) return nsstring("Yesterday");
    if (d > today - 7 && d < today) return nsstring(weekday_names[weekday_of(d)]);
    fbuf_n = 0;
    fput_date(d);
    fstring()
}

// A time of day, as the phone writes it (3:24 PM).
time_text(t: int): int {
    f: int = msg(make("NSDateFormatter"), sel("autorelease"));
    msg1(f, sel("setDateStyle:"), 0);
    msg1(f, sel("setTimeStyle:"), 1);
    msg1(f, sel("stringFromDate:"), msg_set_f(cls("NSDate"), sel("dateWithTimeIntervalSince1970:"),
        t as f64))
}

hist_cell(t: int, path: int): int {
    s: int = msg(path, sel("section"));
    i: int = hr_i[hd_start[s] + msg(path, sel("row"))];
    c: int = hs_ch[i];
    v: int = if (hs_exact[i]) hs_v[i] else 0;
    cell: int = list_cell(t, "history", 2);
    config: int = list_config(2);
    msg1(config, sel("setText:"), place_name(c, v));
    msg1(config, sel("setSecondaryAttributedText:"), preview(opening_words(c, if (hs_v[i] > 0) hs_v[i] else 1,
        50), false, 15.0f64, c_faint));
    msg1(text_props(config), sel("setColor:"), c_ink);
    msg1(detail_props(config), sel("setColor:"), c_faint);
    msg1(detail_props(config), sel("setNumberOfLines:"), 1);
    msg1(cell, sel("setContentConfiguration:"), config);
    l: int = msg(make("UILabel"), sel("autorelease"));
    msg1(l, sel("setText:"), time_text(hs_time[i]));
    msg1(l, sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleBody")));
    msg1(l, sel("setTextColor:"), c_faint);
    msg(l, sel("sizeToFit"));
    msg1(cell, sel("setAccessoryView:"), l);
    cell
}

// A row: the picker away, the reader there (the way back shown).
hist_picked(s: int, r: int) {
    i: int = hr_i[hd_start[s] + r];
    jump(hs_ch[i], if (hs_exact[i]) hs_v[i] else 0)
}

// A row swiped away: deleted (its day's section with it, if it was the
// last).
hist_delete(path: int) {
    s: int = msg(path, sel("section"));
    i: int = hr_i[hd_start[s] + msg(path, sel("row"))];
    had: int = hd_count[s];
    history_delete(i);
    save_history();
    hist_build();
    one[0] = path;
    if (had == 1) msg2(hist_table, sel("deleteSections:withRowAnimation:"), msg1(cls("NSIndexSet"),
        sel("indexSetWithIndex:"), s), 100) else msg2(hist_table, sel("deleteRowsAtIndexPaths:withRowAnimation:"),
        nsarray(one, 1), 100);
    hist_empty_state(true)
}

// Clear History, chosen from Clear's menu: every row faded out, then the
// empty state faded in.
history_clear(_self: int, _cmd: int, _sender: int): int {
    sections: int = hd_n;
    hs_n = 0;
    save_history();
    hist_build();
    if (hist_table != 0 && sections > 0) msg2(hist_table, sel("deleteSections:withRowAnimation:"),
        msg2(cls("NSIndexSet"), sel("indexSetWithIndexesInRange:"), 0, sections),
        0);
    _t: int = after(0.3f64, "historyCleared:");
    0
}

history_cleared(_self: int, _cmd: int, _timer: int): int {
    hist_empty_state(true);
    0
}

add_history_methods(app: int) {
    add_method1(app, sel("historyClear:"), &history_clear, "v@:@");
    add_method1(app, sel("historyCleared:"), &history_cleared, "v@:@")
}
