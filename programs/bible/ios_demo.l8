tag bible_ios;

use_tag std, ios, bible;

// The demo, for the simulator in CI: with L8_DEMO=1 in the environment, the
// app takes step N when told by the Darwin notification
// space.trailingwhite.smoothbible.demoN (sent with `notifyutil -p` by
// programs/bible/ios/simulate.sh, which takes a screenshot after each).
// Each step does what the reader's own taps would, through the same
// functions. Once a step has settled (no sheet coming or going, no
// animation of the bar's, nothing more to do a moment later), the app says
// so with the notification space.trailingwhite.smoothbible.done, which the
// script waits for (rather than sleeping).
import "../ios/objc.l8";

import "text.l8";

extern CFNotificationCenterGetDarwinNotifyCenter(): int;

extern CFNotificationCenterAddObserver(
    center: int,
    observer: int,
    callback: fn(center: int, observer: int, name: int, object: int, info: int): int,
    name: int,
    object: int,
    behavior: int
): int;

extern notify_register_check(name: str, token: []i8): int;

extern notify_set_state(token: int, state: int): int;

extern notify_post(name: str): int;

extern msg1_rect(
    receiver: int,
    selector: int,
    a: int,
    x: f64,
    y: f64,
    w: f64,
    h: f64
): int = objc_msgSend;

demo_name: str = "space.trailingwhite.smoothbible.demo";

demo_buf: []i8 = new i8[128](0i8);

demo_listen() {
    center: int = CFNotificationCenterGetDarwinNotifyCenter();
    n: int = len(demo_name);
    for i in 0..n demo_buf[i] = demo_name[i];
    for step in 1..270 {
        m: int = n;
        if (step >= 100) {
            demo_buf[m] = (48 + step / 100) trunc i8;
            m = m + 1
        }
        if (step >= 10) {
            demo_buf[m] = (48 + step / 10 % 10) trunc i8;
            m = m + 1
        }
        demo_buf[m] = (48 + step % 10) trunc i8;
        CFNotificationCenterAddObserver(center, 0, &demo_note, nsstring_at(bytes_address(demo_buf),
            m + 1), 0, 4)
    }
}

demo_note(
    _center: int,
    _observer: int,
    name: int,
    _object: int,
    _info: int
): int {
    n: int = nsstring_into(name, demo_buf);
    k: int = len(demo_name);
    step: int = 0;
    for i in k..n {
        d: int = demo_buf[i] as int;
        if (d >= 48 && d <= 57) step = step * 10 + d - 48
    }
    note_num("bible: demo step ", step);
    demo_state = step;
    demo_do(step);
    demo_settle_start();
    0
}

// The settled notification's state (the script reads it with `notifyutil
// -g`, should it have missed the notification itself): the step settled, or
// 1000 and how many other settlings (launch, the phone's appearance or text
// size) there have been.
demo_state: int = 0;

demo_events: int = 0;

demo_token: []i8 = new i8[8](0i8);

demo_token_made: bool = false;

// ---- saying a step has settled ----
// When the step began, and how many checks in a row found all still.
demo_t0: f64 = 0.0f64;

demo_quiet: int = 0;

demo_checking: bool = false;

// A settling not asked for by a step.
demo_event() {
    if (!demo_on) return;
    demo_events = demo_events + 1;
    demo_state = 1000 + demo_events;
    demo_settle_start()
}

demo_settle_start() {
    if (!demo_on) return;
    demo_t0 = CACurrentMediaTime();
    demo_quiet = 0;
    if (!demo_checking) {
        demo_checking = true;
        _t: int = after(0.1f64, "demoCheck:")
    }
}

// Whether a controller is being shown or put away.
moving_vc(vc: int): bool {
    if (vc == 0) return false;
    if (msg(vc, sel("transitionCoordinator")) != 0) return true;
    (msg(vc, sel("isBeingPresented")) & 255) != 0 || (msg(vc, sel("isBeingDismissed")) & 255) != 0
}

demo_check(_self: int, _cmd: int, _timer: int): int {
    still: bool = demo_next == 0 && demo_seq5_timer == 0 && demo_link == 0 && bar_anim_link == 0 && !moving_vc(nav) && !moving_vc(presented()) && !moving_vc(top_presented());
    top: int = top_presented();
    if (top != 0 && responds(top, "topViewController") && moving_vc(msg(top, sel("topViewController")))) still = false;
    if (still) demo_quiet = demo_quiet + 1 else demo_quiet = 0;
    // (Still for 0.4 s, and at least 0.7 s after the step: animations of
    // Core Animation's own, a keyboard, have ended.)
    if (demo_quiet >= 4 && CACurrentMediaTime() - demo_t0 >= 0.7f64) {
        demo_checking = false;
        if (!demo_token_made) {
            demo_token_made = true;
            _r: int = notify_register_check("space.trailingwhite.smoothbible.done",
                demo_token)
        }
        tk: int = byte_of(demo_token, 0) | byte_of(demo_token, 1) << 8 | byte_of(demo_token,
            2) << 16 | byte_of(demo_token, 3) << 24;
        notify_set_state(tk, demo_state);
        notify_post("space.trailingwhite.smoothbible.done");
        note_num("bible: demo settled ", demo_state);
        return 0
    }
    _t: int = after(0.1f64, "demoCheck:");
    0
}

// What is presented, put away at once (no animation, so that the next
// sheet can come up).
demo_dismiss() {
    if (presented() != 0) {
        note_tv = 0;
        sheet_gone();
        msg2(nav, sel("dismissViewControllerAnimated:completion:"), 0, 0)
    }
}

// John 3, John 4, Psalm 23.
john3(): int {
    book_first[42] + 2
}

psalm23(): int {
    book_first[18] + 22
}

demo_verses: []int = new int[4](0);

// The edit menu's text: where its words are, and how long.
demo_loc: int = 0;

demo_len: int = 0;

demo_tv: int = 0;

demo_c: int = 0;

demo_v: int = 0;

// The table stepped by dy points, as a finger would (the bar following).
demo_drag(dy: f64) {
    demo_tracking = true;
    set_offset(offset_y(table) + dy);
    demo_tracking = false
}

demo_do(t: int) {
    if (t == 2) {
        // The end of Genesis 1 and the start of Genesis 2, mid-screen.
        set_offset(row_y(1) - view_height(table) * 0.45f64);
        find_place()
    }
    if (t == 3) open_picker();
    if (t == 4) {
        q: int = nsstring("jn 3:16");
        msg1(msg(picker_search, sel("searchBar")), sel("setText:"), q);
        picker_query(q)
    }
    if (t == 5) {
        q: int = nsstring("");
        msg1(msg(picker_search, sel("searchBar")), sel("setText:"), q);
        picker_query(q);
        show_chapters(18)
    }
    if (t == 6) jump(psalm23(), 0);
    if (t == 7) demo_footnote();
    if (t == 8) {
        demo_dismiss();
        q: []i8 = demo_buf;
        n: int = nsstring_into(nsstring("jn 3:16"), q);
        if (parse_ref(q, n)) jump(chapter_of(ref_book, ref_chapter), ref_verse)
    }
    if (t == 9) toggle_verse(john3(), 16);
    if (t == 10) toggle_verse(john3(), 17);
    if (t == 11) demo_marks();
    if (t == 12) go_place(john3(), 14, -1200);
    if (t == 13) {
        go_place(john3(), 3, -3000);
        demo_select(john3(), "born again")
    }
    if (t == 14) {
        demo_menu_away();
        note_force_edit = true;
        open_note(john3(), 5, 5)
    }
    if (t == 17) {
        // (Search, open from the step before.)
        if (search_table == 0) {
            demo_dismiss();
            open_search()
        }
        q: int = nsstring("born again");
        msg1(search_bar, sel("setText:"), q);
        sr_n = nsstring_into(q, sr);
        sr_timer = stop_timer(sr_timer);
        run_search()
    }
    if (t == 18) {
        msg1(search_bar, sel("setSelectedScopeButtonIndex:"), 1);
        sr_scope = 1;
        run_search()
    }
    if (t == 19) {
        msg1(search_bar, sel("setText:"), nsstring(""));
        search_typed(nsstring(""))
    }
    if (t == 20) {
        dismiss_sheets();
        sr_scope = 0;
        set_def_int("librarySegment", 0);
        demo_later_do(1)
    }
    if (t == 21 || t == 22) {
        msg1(seg_control, sel("setSelectedSegmentIndex:"), t - 20);
        library_segment(0, 0, seg_control)
    }
    if (t == 23) {
        dismiss_sheets();
        go_place(john3(), 14, -1200);
        demo_later_do(2)
    }
    if (t == 24) {
        set_theme = 3;
        set_font = 1;
        settings_changed(true)
    }
    if (t == 25) demo_dismiss();
    if (t == 26) {
        set_theme = 5;
        set_font = 0;
        set_spacing = 2;
        set_size = 4;
        settings_changed(true)
    }
    if (t == 27) {
        lay_verse_lines = true;
        lay_headings = false;
        settings_changed(false)
    }
    if (t == 28) {
        set_theme = 0;
        set_font = 0;
        set_spacing = 1;
        set_size = 2;
        set_margins = 1;
        lay_verse_numbers = true;
        lay_headings = true;
        lay_notes = true;
        lay_verse_lines = false;
        settings_changed(true)
    }
    if (t == 30) open_link_text("bsb://ROM/8");
    if (t == 31) {
        // The bar at rest over the page: a point down and back.
        y: f64 = offset_y(table);
        set_offset(y + 1.0f64);
        set_offset(y)
    }
    // ---- the collapsing bar (DESIGN.md, "Collapsing-bar evidence") ----
    if (t == 15) {
        // John 3 with 3:14 near the top, the bar expanded, all still.
        note_done(0, 0, 0);
        demo_dismiss();
        clear_selection();
        hide_back();
        go_place(john3(), 14, -600);
        bar_stop();
        bar_set(0.0f64)
    }
    if (t == 16) {
        // The same place, collapsed without a scroll.
        bar_set(1.0f64);
        note_num("bible: p x100 ", (bar_p * 100.0f64) as int)
    }
    if (t == 32) bar_set(0.5f64);
    if (t == 33) {
        // Collapsed, John 4's opener mid-screen: the band still says
        // John 3 (John 4's opener has not gone under it: no name twice).
        bar_set(1.0f64);
        set_offset(row_y(john3() + 1) - top_inset(table) + 14.0f64);
        find_place();
        layout_bar()
    }
    if (t == 34) {
        // Back up 8 points (still collapsed), then 60 more (expanded).
        bar_set(1.0f64);
        set_offset(row_y(john3()) + 1200.0f64);
        last_scroll_y = offset_y(table);
        up_travel = 0.0f64;
        for _i in 0..2 demo_drag(-4.0f64);
        note_num("bible: after 8 points up, p x100 ", (bar_p * 100.0f64) as int);
        for _i in 0..15 demo_drag(-4.0f64);
        note_num("bible: after 68 points up, p x100 ", (bar_p * 100.0f64) as int);
        bar_settle()
    }
    if (t == 35) {
        bar_stop();
        bar_set(1.0f64);
        bar_compact_tapped(0, 0, 0)
    }
    if (t == 36) {
        bar_stop();
        bar_set(1.0f64);
        open_search()
    }
    // ---- Round 2: study (DESIGN.md Â§7.10) ----
    if (t == 40) {
        demo_dismiss();
        bar_set(0.0f64);
        set_def_int("interlinearOrder", 0);
        go_verse(john3(), 16);
        toggle_verse(john3(), 16)
    }
    if (t == 41) tray_action(0, 0, tray_actions[4]);
    if (t == 42) {
        msg1(il_seg, sel("setSelectedSegmentIndex:"), 1);
        il_order(0, 0, il_seg);
        demo_detent(true)
    }
    if (t == 43) {
        demo_order(false);
        demo_study(true, 25)
    }
    if (t == 44) open_grammar();
    if (t == 45) {
        demo_pop();
        open_definition();
        demo_later_do(5)
    }
    if (t == 46) {
        demo_pop();
        open_concordance(-1)
    }
    if (t == 47) {
        // The "loved" rendering's concordance.
        demo_pop();
        r: int = demo_rendering("loved");
        if (r >= 0) open_concordance(r)
    }
    if (t == 48) {
        // All the verses, filtered to "neighbor".
        demo_pop();
        open_concordance(-1);
        msg1(conc_search, sel("setActive:"), 1);
        msg1(msg(conc_search, sel("searchBar")), sel("setText:"), nsstring("neighbor"));
        conc_filtered(nsstring("neighbor"))
    }
    if (t == 49) conc_picked(0, 0);
    if (t == 50) {
        // Psalm 23:1, "shepherd" selected, and its edit menu.
        demo_dismiss();
        go_verse(psalm23(), 1);
        demo_select(psalm23(), "shepherd")
    }
    if (t == 51) {
        demo_menu_away();
        em_tv = demo_tv;
        em_loc = demo_loc;
        em_len = demo_len;
        command_study(0, 0, 0)
    }
    if (t == 52) open_definition();
    if (t == 53) {
        // Interlinear from the toolbar, in Hebrew order.
        demo_pop();
        set_def_int("interlinearOrder", 1);
        study_interlinear(0, 0, 0)
    }
    if (t == 54) {
        demo_dismiss();
        set_def_int("interlinearOrder", 0);
        demo_c = psalm23();
        demo_v = 2;
        demo_later_do(17)
    }
    if (t == 55) {
        demo_dismiss();
        set_def_int("interlinearOrder", 0);
        demo_c = 0;
        demo_v = 1;
        demo_later_do(6)
    }
    if (t == 56) {
        demo_dismiss();
        set_theme = 4;
        settings_changed(true);
        demo_c = 0;
        demo_v = 1;
        demo_later_do(7)
    }
    if (t == 57) {
        demo_dismiss();
        set_theme = 0;
        settings_changed(true);
        demo_later_do(8)
    }
    if (t == 58) open_changes();
    // ---- notes and the library (DESIGN.md Â§7.9) ----
    if (t == 60) {
        // The John 3:5 note, read.
        demo_dismiss();
        go_place(john3(), 3, -3000);
        open_note(john3(), 5, 5)
    }
    if (t == 61) note_edit(0, 0, 0);
    if (t == 62) {
        // Done; Add to Note from the word study of John 3:16 "loved".
        note_done(0, 0, 0);
        demo_dismiss();
        demo_later_do(18)
    }
    if (t == 63) {
        save_note_editor();
        demo_dismiss();
        set_def_int("librarySegment", 1);
        demo_later_do(11)
    }
    if (t == 64) {
        msg1(msg(lib_search, sel("searchBar")), sel("setText:"), nsstring(""));
        library_typed(nsstring(""));
        msg1(lib_search, sel("setActive:"), 0);
        demo_sort_menu()
    }
    if (t == 65) {
        demo_dismiss_menu();
        library_sort_newest(0, 0, 0)
    }
    // ---- the screen recording's sequences (DESIGN.md, "Transitions") ----
    if (t == 70) {
        // Setup: John 3 from its top, the bar expanded, nothing open.
        demo_dismiss();
        library_sorted(0);
        clear_selection();
        hide_back();
        go_top(john3());
        bar_stop();
        bar_set(0.0f64);
        last_scroll_y = offset_y(table)
    }
    if (t == 71) demo_sequence(1);
    if (t == 72) {
        bar_animate_to(1.0f64);
        demo_later_at(0.8f64, 12)
    }
    if (t == 73) {
        sr_n = nsstring_into(nsstring("born again"), sr);
        open_search();
        demo_later_at(1.2f64, 13)
    }
    if (t == 74) {
        open_picker();
        demo_later_at(1.2f64, 13)
    }
    if (t == 75) {
        toggle_verse(john3(), 3);
        demo_later_at(1.2f64, 14)
    }
    if (t == 76) {
        go_top(john3());
        bar_stop();
        bar_set(0.0f64);
        last_scroll_y = offset_y(table);
        demo_sequence(6)
    }
    if (t >= 77 && t <= 79) demo_sequence3(t);
    if (t >= 100 && t < 135) demo_do3(t);
    if (t >= 135 && t < 240) demo_do4(t);
    if (t >= 240) demo_do5(t)
}

// The marks of step 11: Yellow on 16â€“17 (selected), Green on 3:3, a
// bookmark on 3:1, a note on 3:5; John 3:1â€“8 shown.
demo_marks() {
    c: int = john3();
    apply_highlight(sel_c, sel_v, sel_n, 0);
    clear_selection();
    if (highlight_of(c, 16) < 0) {
        demo_verses[0] = 16;
        demo_verses[1] = 17;
        apply_highlight(c, demo_verses, 2, 0)
    }
    demo_verses[0] = 3;
    apply_highlight(c, demo_verses, 1, 1);
    set_bookmark(c, 1, true);
    save_bookmarks();
    text: int = nsstring("Water and Spirit: compare Ezekiel 36:25\â\€\“27.");
    n: int = nsstring_into(text, note_buf);
    set_note(c, 5, 5, note_buf, n);
    save_notes();
    remake(c);
    go_place(c, 1, -5200)
}

// The words in chapter c selected as a long press would, and its edit menu
// shown a moment later.
demo_select(c: int, words: str) {
    tv: int = view_of(c);
    demo_tv = tv;
    demo_len = len(words);
    if (tv != 0) {
        demo_loc = msg1(msg(tv, sel("text")), sel("rangeOfString:"), nsstring(words));
        msg(tv, sel("becomeFirstResponder"));
        msg2(tv, sel("setSelectedRange:"), demo_loc, demo_len)
    }
    demo_later_at(0.6f64, 3)
}

// The edit menu put away, and the text's selection.
demo_menu_away() {
    if (demo_interaction != 0) {
        msg(demo_interaction, sel("dismissMenu"));
        msg1(demo_tv, sel("removeInteraction:"), demo_interaction);
        release(demo_interaction);
        demo_interaction = 0
    }
    if (demo_found != 0) msg(demo_found, sel("dismissMenu"));
    if (demo_tv != 0) {
        msg2(demo_tv, sel("setSelectedRange:"), demo_loc, 0);
        msg(demo_tv, sel("resignFirstResponder"))
    }
}

// Back one screen in the sheet.
demo_pop() {
    top: int = top_presented();
    if (top != 0) msg1(top, sel("popViewControllerAnimated:"), 0)
}

// The rendering whose words are s (-1 if none).
demo_rendering(s: str): int {
    for r in 0..rd_n {
        if (rd_len[r] == len(s)) {
            same: bool = true;
            for i in 0..len(s)
                if (rd_pool[rd_at[r] + i] != s[i]) same = false;
            if (same) return r
        }
    }
    -1
}

// The library's sort menu, open (as a tap on its button would).
demo_sort_menu() {
    b: int = lib_sort_button;
    if (b == 0) return;
    if (responds(b, "performPrimaryAction")) msg(b, sel("performPrimaryAction"));
    demo_later_at(0.5f64, 15)
}

demo_dismiss_menu() {
    b: int = lib_sort_button;
    if (b == 0) return;
    i: int = msg(b, sel("contextMenuInteraction"));
    if (i != 0) msg(i, sel("dismissMenu"))
}

// The interlinear's sheet at its large detent, or its medium.
demo_detent(large: bool) {
    nav_sheet: int = presented();
    if (nav_sheet == 0) return;
    sheet: int = msg(nav_sheet, sel("sheetPresentationController"));
    if (sheet != 0) msg1(sheet, sel("setSelectedDetentIdentifier:"), objc_const(if (large) "UISheetPresentationControllerDetentIdentifierLarge" else "UISheetPresentationControllerDetentIdentifierMedium"))
}

demo_order(original: bool) {
    il_original = original;
    set_def_int("interlinearOrder", if (original) 1 else 0)
}

// The study of the interlinear's word of number num (Greek or Hebrew).
demo_study(greek: bool, num: int) {
    if (il_vi < 0) return;
    for w in v_first(il_vi)..v_end(il_vi) {
        if (w_greek(w) == greek && w_strongs(w) == num) {
            open_study(il_vi, w);
            return
        }
    }
}

// What comes a moment after a step, once what was before it has gone (or
// come up): demo_later's kinds.
demo_next: int = 0;

demo_later_do(d: int) {
    demo_later_at(0.8f64, d)
}

demo_later_at(t: f64, d: int) {
    demo_next = d;
    _t: int = after(t, "demoLater:")
}

demo_later(_self: int, _cmd: int, _timer: int): int {
    d: int = demo_next;
    demo_next = 0;
    // (What opens a sheet waits until no sheet is left going away.)
    opens: bool = d == 1 || d == 2 || d == 6 || d == 7 || d == 8 || d == 11 || d == 17 || d == 18 || d == 30 || d == 33 || d == 35 || d == 37 || d == 39;
    if (opens && presented() != 0) {
        demo_later_at(0.3f64, d);
        return 0
    }
    if (d == 1) open_library() else if (d == 2) open_settings() else if (d == 3) demo_edit_menu() else if (d == 4 && !menu_asked) demo_menu_items() else if (d == 5) {
        // The definition, at its end (its credit).
        if (def_tv != 0) {
            n: int = msg(msg(def_tv, sel("textStorage")), sel("length"));
            msg2(def_tv, sel("scrollRangeToVisible:"), n - 1, 1)
        }
    } else if (d == 6) open_interlinear(demo_c, demo_v) else if (d == 17) {
        open_interlinear(demo_c, demo_v);
        demo_detent(true)
    } else if (d == 7) {
        open_interlinear(demo_c, demo_v);
        demo_study(false, 1254)
    } else if (d == 8) {
        open_settings();
        demo_later_do(9)
    } else if (d == 9) open_acknowledgements() else if (d == 18) {
        // The word study of John 3:16 "loved", then Add to Note.
        if (can_study(john3(), 16)) {
            vi: int = lang_verse(john3(), 16);
            found: int = -1;
            for w in v_first(vi)..v_end(vi)
                if (found < 0 && w_greek(w) && w_strongs(w) == 25) found = w;
            if (found >= 0) open_study_sheet(vi, found)
        }
        demo_later_do(10)
    } else if (d == 10) add_to_note(0, 0, 0) else if (d == 11) {
        open_library();
        demo_later_do(16)
    } else if (d == 16) {
        msg1(lib_search, sel("setActive:"), 1);
        msg1(msg(lib_search, sel("searchBar")), sel("setText:"), nsstring("agap"));
        library_typed(nsstring("agap"))
    } else if (d >= 300) demo_later5(d) else if (d >= 100) demo_later4(d) else if (d >= 30 && d < 99) demo_later3(d) else if (d == 12) bar_animate_to(0.0f64) else if (d == 13) dismiss_sheets() else if (d == 14) clear_selection() else if (d == 15) {
        // (If the button would not open its menu: through its interaction.)
        i: int = msg(lib_sort_button, sel("contextMenuInteraction"));
        if (i != 0 && responds(i, "_presentMenuAtLocation:")) {
            l8_msg_hfa(hfa, lib_sort_button, sel("bounds"), 0, 0, 0);
            msg_ff(i, sel("_presentMenuAtLocation:"), hfa[2] / 2.0f64, hfa[3] / 2.0f64);
            note("bible: sort menu through its interaction")
        }
    }
    0
}

// ---- sequences driven a frame at a time ----
demo_link: int = 0;

demo_seq: int = 0;

demo_frame: int = 0;

demo_y0: f64 = 0.0f64;

demo_sequence(k: int) {
    demo_seq = k;
    demo_frame = 0;
    demo_y0 = offset_y(table);
    demo_link = keep(msg2(cls("CADisplayLink"), sel("displayLinkWithTarget:selector:"),
        app_obj, sel("demoTick:")));
    msg2(demo_link, sel("addToRunLoop:forMode:"), msg(cls("NSRunLoop"), sel("mainRunLoop")),
        l8_run_loop_common_modes())
}

demo_tick(_self: int, _cmd: int, _link: int): int {
    f: int = demo_frame;
    demo_frame = f + 1;
    done: bool = false;
    if (demo_seq == 1) {
        // 600 points down over a second, then back up.
        if (f < 60) demo_drag(10.0f64) else if (f < 120) demo_drag(-10.0f64) else if (f == 120) bar_settle() else if (f > 140) done = true
    } else if (demo_seq == 6) {
        // Down 4 points a frame for 30 frames; lift; up 2 a frame for 6
        // (no reveal), then 4 a frame for 15 (reveal); lift; collapse, then
        // a tap on the compact title.
        if (f < 30) demo_drag(4.0f64) else if (f == 30) bar_settle() else if (f >= 40 && f < 46) demo_drag(-2.0f64) else if (f >= 46 && f < 61) demo_drag(-4.0f64) else if (f == 61) bar_settle() else if (f == 85) bar_animate_to(1.0f64) else if (f == 115) bar_compact_tapped(0,
            0, 0) else if (f > 145) done = true
    } else if (demo_seq == 7) done = demo_glide_frame(f) else done = true;
    if (demo_seq == 6 && f < 61) note_num("bible: seq6 p x1000 ", (bar_p * 1000.0f64) as int);
    if (done) {
        link: int = demo_link;
        demo_link = 0;
        msg(link, sel("invalidate"));
        release(link)
    }
    0
}

// Psalm 23:1's footnote, as if its mark were tapped.
demo_footnote() {
    c: int = psalm23();
    tv: int = view_of(c);
    if (tv == 0) return;
    compute_ranges(c);
    at: int = -1;
    p: int = 0;
    for r in 0..runs {
        if (at < 0 && run_style[r] == STYLE_NOTE) at = u16_at[p];
        p = run_end[r]
    }
    if (at < 0 || !range_rect(tv, at, 1)) return;
    x: f64 = hfa[0] + hfa[2] * 0.5f64;
    y: f64 = hfa[1] + hfa[3] * 0.5f64;
    link: int = link_at(tv, x, y, k_link);
    if (link > 0) show_footnote(tv, c, link, x, y)
}

// (If the text view's own menu, shown by the demo, did not ask for the
// app's commands: an edit menu interaction of the demo's own on the text
// view, with the same menu.)
demo_interaction: int = 0;

demo_found: int = 0;

demo_menu_items() {
    note("bible: edit menu by the demo's interaction");
    if (demo_tv == 0 || !range_rect(demo_tv, demo_loc, demo_len)) return;
    x: f64 = hfa[0] + hfa[2] * 0.5f64;
    y: f64 = hfa[1];
    em_tv = demo_tv;
    em_loc = demo_loc;
    em_len = demo_len;
    demo_interaction = msg1(msg(cls("UIEditMenuInteraction"), sel("alloc")), sel("initWithDelegate:"),
        app_obj);
    msg1(demo_tv, sel("addInteraction:"), demo_interaction);
    config: int = msg1_ff(cls("UIEditMenuConfiguration"), sel("configurationWithIdentifier:sourcePoint:"),
        0, x, y);
    msg1(demo_interaction, sel("presentEditMenuWithConfiguration:"), config)
}

demo_menu(
    _self: int,
    _cmd: int,
    _interaction: int,
    _config: int,
    suggested: int
): int {
    app_menu(suggested)
}

// The words selected, as a long press would, and their edit menu shown.
demo_edit_menu() {
    tv: int = demo_tv;
    if (tv == 0) return;
    if (!range_rect(tv, demo_loc, demo_len)) return;
    x: f64 = hfa[0] + hfa[2] * 0.5f64;
    y: f64 = hfa[1];
    rx: f64 = hfa[0];
    rw: f64 = hfa[2];
    rh: f64 = hfa[3];
    // The text view's own edit menu interaction, asked to show its menu;
    // or else the older menu controller.
    list: int = msg(tv, sel("interactions"));
    menu_cls: int = cls("UIEditMenuInteraction");
    found: int = 0;
    for i in 0..msg(list, sel("count")) {
        x_: int = msg1(list, sel("objectAtIndex:"), i);
        if (menu_cls != 0 && (msg1(x_, sel("isKindOfClass:"), menu_cls) & 255) != 0) found = x_
    }
    demo_found = found;
    if (found != 0) {
        menu_asked = false;
        config: int = msg1_ff(cls("UIEditMenuConfiguration"), sel("configurationWithIdentifier:sourcePoint:"),
            0, x, y);
        msg1(found, sel("presentEditMenuWithConfiguration:"), config);
        note("bible: edit menu by interaction");
        demo_later_at(0.6f64, 4)
    } else {
        mc: int = msg(cls("UIMenuController"), sel("sharedMenuController"));
        msg1_rect(mc, sel("showMenuFromView:rect:"), tv, rx, y, rw, rh);
        note("bible: edit menu by menu controller")
    }
}
