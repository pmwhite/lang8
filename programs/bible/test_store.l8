tag bible_store_tests;

use_tag std, bible;

// What the reader keeps (store.l8): its files' lines read back, bad lines
// skipped; history's trail of chapters; and the Markdown export.
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

import "esv_cache.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

load() noregion {
    fd: int = open("programs/bible/data/bsb.txt", 0, 0);
    n: int = 8388608;
    bsb = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, bsb, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    bible_index(got)
}

// fbuf holds s (its lines, as a file would).
feed(s: str) {
    fbuf_n = 0;
    fput_str(s)
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

john3(): int {
    book_first[42] + 2
}

clear_all() {
    hl_n = 0;
    bm_n = 0;
    nt_n = 0;
    nt_pool_n = 0;
    hs_n = 0
}

