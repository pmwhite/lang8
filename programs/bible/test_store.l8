// A mark made in the WEB on Romans 14:25 (past the BSB's 23, within the
// 26 refs.txt gives) is kept through a reload; one on 14:27 is not.
test "a mark past the BSB's last verse" {
    load();
    clear_all();
    fd: int = open("programs/bible/data/refs.txt", 0, 0);
    nb: []i8 = new i8[4096](0i8);
    n: int = read(fd, nb, 0, 4096);
    close(fd);
    refs_read(nb, n);
    feed("""
ROM	14	25	1792252800
ROM	14	27	1792252800
""");
    parse_bookmarks();
    write_int(1, lines_skipped);
    print(" skipped");
    format_bookmarks();
    parse_bookmarks();
    format_bookmarks();
    show_fbuf();
    expect "1 skipped\nROM\t14\t25\t1792252800\n"
}

// ---- the ESV's chapters held (DESIGN.md Â§9.4.5) ----
// Chapter c as the ESV's records would be (the BSB's, which have as many
// verses), held at time t.
esv_visit(c: int, t: int) {
    esv_set_visible(c, c);
    n: int = ch_end[c] - ch_start[c];
    for i in 0..n note_buf[i] = bsb[ch_start[c] + i];
    esv_insert(c, note_buf, n, t);
    esv_touch(c, t)
}

// Chapter c's records held at time t, whatever is on screen.
esv_hold(c: int, t: int) {
    n: int = ch_end[c] - ch_start[c];
    for i in 0..n note_buf[i] = bsb[ch_start[c] + i];
    esv_insert(c, note_buf, n, t)
}

test "the ESV held never passes the terms" {
    load();
    ec_n = 0;
    ec_pool_n = 0;
    // Fourteen chapters of the Gospels in a row (Matthew 1 to 14).
    most: int = 0;
    for i in 0..14 {
        esv_visit(book_first[39] + i, 1000 + i);
        if (esv_total() > most) most = esv_total()
    }
    write(1, "Matthew 1-14: at most ");
    write_int(1, most);
    write(1, ", Matthew 14 held: ");
    print(if (esv_held(book_first[39] + 13)) "yes" else "no");
    // Jude: held while it is read, never on disk; gone once left.
    jude: int = book_first[64];
    esv_visit(jude, 2000);
    write(1, "Jude on disk: ");
    print(if (esv_held(jude) && ec_disk[esv_find(jude)]) "yes" else "no");
    format_esv_index();
    write(1, "Jude in the index: ");
    print(if (fbuf_n > 0 && esv_index_has(jude)) "yes" else "no");
    esv_visit(book_first[65], 2001);
    write(1, "Jude held after: ");
    print(if (esv_held(jude)) "yes" else "no");
    // Ruth: never more than half its 85 verses.
    ruth: int = book_first[7];
    most = 0;
    for i in 0..4 {
        esv_visit(ruth + i, 3000 + i);
        if (esv_book_total(7) > most) most = esv_book_total(7)
    }
    write(1, "Ruth: at most ");
    write_int(1, most);
    print("");
    // The chapters on screen and beside it stay, whatever else goes.
    ec_n = 0;
    ec_pool_n = 0;
    john: int = book_first[42];
    esv_set_visible(john + 1, john + 1);
    for i in 0..3 esv_hold(john + i, 4000 + i);
    // (Luke fetched while John 2 is read: more than 500 in all.)
    for i in 0..12 esv_hold(book_first[41] + i, 5000 + i);
    write(1, "John 1-3 held: ");
    print(if (esv_held(john) && esv_held(john + 1) && esv_held(john + 2)) "yes" else "no");
    write(1, "at most 500: ");
    print(if (esv_total() <= 500) "yes" else "no");
    expect {|
        Matthew 1-14: at most 489, Matthew 14 held: yes
        Jude on disk: no
        Jude in the index: no
        Jude held after: no
        Ruth: at most 41
        John 1-3 held: yes
        at most 500: yes
    |}
}

// Whether the index (in fbuf) has a line for chapter c.
esv_index_has(c: int): bool {
    parse_esv_index();
    for i in 0..ix_n
        if (ix_c[i] == c) return true;
    false
}

// Chapter c read (on screen), and its window fetched ahead where there is
// room (DESIGN.md Â§9.4.11): c + 1, c + 2, c - 1.
esv_read_ahead(c: int, t: int) {
    esv_visit(c, t);
    for d in [1, 2, -1] {
        x: int = c + d;
        if (x >= 0 && x < chapters && !esv_held(x) && esv_room_for(x)) esv_hold(x,
            t)
    }
}

test "fetching ahead keeps the terms" {
    load();
    ec_n = 0;
    ec_pool_n = 0;
    // Fourteen chapters of John, each read with its window ahead.
    john: int = book_first[42];
    most: int = 0;
    for i in 0..14 {
        esv_read_ahead(john + i, 6000 + i);
        if (esv_total() > most) most = esv_total()
    }
    write(1, "John 1-14 ahead: at most ");
    write_int(1, most);
    write(1, ", John 15 and 16 held: ");
    print(if (esv_held(john + 14) && esv_held(john + 15)) "yes" else "no");
    // Ruth 2 on screen: Ruth 3 may come, not Ruth 4; Ruth 2 stays.
    ec_n = 0;
    ec_pool_n = 0;
    ruth: int = book_first[7];
    esv_visit(ruth + 1, 7000);
    write(1, "Ruth 3: ");
    print(if (esv_room_for(ruth + 2)) "room" else "none");
    esv_hold(ruth + 2, 7001);
    write(1, "Ruth 4: ");
    print(if (esv_room_for(ruth + 3)) "room" else "none");
    write(1, "Ruth 2 held: ");
    print(if (esv_held(ruth + 1)) "yes" else "no");
    // A two-chapter book: Haggai 1 on screen, Haggai 2 never fetched ahead.
    ec_n = 0;
    ec_pool_n = 0;
    haggai: int = book_first[36];
    esv_visit(haggai, 7100);
    write(1, "Haggai 2: ");
    print(if (esv_room_for(haggai + 1)) "room" else "none");
    // The window (John 2 on screen: 1 to 4) survives the 500's eviction.
    ec_n = 0;
    ec_pool_n = 0;
    esv_set_visible(john + 1, john + 1);
    for i in 0..4 esv_hold(john + i, 8000 + i);
    for i in 0..12 esv_hold(book_first[41] + i, 9000 + i);
    write(1, "John 1-4 held: ");
    print(if (esv_held(john) && esv_held(john + 1) && esv_held(john + 2) && esv_held(john + 3)) "yes" else "no");
    write(1, "at most 500: ");
    print(if (esv_total() <= 500) "yes" else "no");
    expect {|
        John 1-14 ahead: at most 489, John 15 and 16 held: yes
        Ruth 3: room
        Ruth 4: none
        Ruth 2 held: yes
        Haggai 2: none
        John 1-4 held: yes
        at most 500: yes
    |}
}

// Chapter c's records, as the ESV's answer would bring them, into pins.
pin_arrive(c: int, t: int): int {
    n: int = ch_end[c] - ch_start[c];
    for i in 0..n note_buf[i] = bsb[ch_start[c] + i];
    esv_pin_fill(c, note_buf, n, t)
}

pin_keep: []int = new int[4](0);

test "Memory's ESV passages pinned within the terms" {
    load();
    if (!tx_ready[0]) text_load(TEXT_BSB, bsb, bsb_n);
    ec_n = 0;
    ec_pool_n = 0;
    pn_n = 0;
    pn_pool_n = 0;
    john: int = book_first[42];
    rom: int = book_first[44];
    // Romans 8:28-39 and John 3:16-17 pinned: 14 verses.
    write(1, "pinned: ");
    write_int(1, if (esv_pin_add(1, rom + 7, 28, rom + 7, 39)) 1 else 0);
    write_int(1, if (esv_pin_add(2, john + 2, 16, john + 2, 17)) 1 else 0);
    write(1, ", total ");
    write_int(1, esv_pin_total());
    write(1, ", ready ");
    write_int(1, if (esv_pin_ready(2)) 1 else 0);
    print("");
    // Their records come with the chapters: only their verses kept.
    write_int(1, pin_arrive(john + 2, 100));
    write(1, " pin took John 3, ready ");
    write_int(1, if (esv_pin_ready(2)) 1 else 0);
    write(1, "; ");
    write_int(1, pn_len[1]);
    print(" bytes");
    write_bytes_n(1, pn_pool, pn_pool_n);
    print("");
    // A text of the passage alone: John 3:16 and 17 there, 15 and 18 not.
    esv_pin_build(2);
    text_use(TEXT_PIN);
    write(1, "pin text: 15 ");
    write_int(1, if (has_verse(john + 2, 15)) 1 else 0);
    write(1, ", 16 ");
    write_int(1, if (has_verse(john + 2, 16)) 1 else 0);
    write(1, ", 17 ");
    write_int(1, if (has_verse(john + 2, 17)) 1 else 0);
    write(1, ", 18 ");
    write_int(1, if (has_verse(john + 2, 18)) 1 else 0);
    write(1, ", Romans 8 ");
    write_int(1, if (ch_start[rom + 7] >= 0) 1 else 0);
    print("");
    text_use(TEXT_BSB);
    // 200 at most: four 40-verse passages more, then 26 fit, not 27.
    write(1, "200: ");
    write_int(1, esv_pin_check(book_first[18] + 118, 1, book_first[18] + 118, 40));
    _x: bool = esv_pin_add(3, book_first[18] + 118, 1, book_first[18] + 118, 40);
    _y: bool = esv_pin_add(4, book_first[18] + 118, 41, book_first[18] + 118, 80);
    _z: bool = esv_pin_add(5, book_first[18] + 118, 81, book_first[18] + 118, 120);
    _w: bool = esv_pin_add(6, book_first[18] + 118, 121, book_first[18] + 118, 160);
    write(1, " then ");
    write_int(1, esv_pin_total());
    write(1, ", 26 more ");
    write_int(1, esv_pin_check(book_first[18] + 118, 161, book_first[18] + 118, 186));
    write(1, ", 27 more ");
    write_int(1, esv_pin_check(book_first[18] + 118, 161, book_first[18] + 118, 187));
    print("");
    // Half a book: Jude's 25 verses, 12 at most.
    write(1, "Jude: 12 ");
    esv_pin_remove(3);
    write_int(1, esv_pin_check(book_first[64], 1, book_first[64], 12));
    write(1, ", 13 ");
    write_int(1, esv_pin_check(book_first[64], 1, book_first[64], 13));
    print("");
    // Pinned verses count toward the 500 and the book's half: reading keeps
    // what is left.
    ec_n = 0;
    for i in 0..14 esv_visit(book_first[39] + i, 1000 + i);
    write(1, "reading with ");
    write_int(1, esv_pin_total());
    write(1, " pinned: ");
    write_int(1, esv_total());
    write(1, ", together at most 500: ");
    print(if (esv_total() + esv_pin_total() <= 500) "yes" else "no");
    // Romans: 8:28-39 pinned (12 of 433's half, 216): Romans 1-9 read.
    ec_n = 0;
    for i in 0..9 esv_visit(rom + i, 2000 + i);
    write(1, "Romans held ");
    write_int(1, esv_book_total(44));
    write(1, " + pinned ");
    write_int(1, esv_pin_book(44));
    write(1, " <= ");
    write_int(1, esv_book_most(44));
    print("");
    // Deleted: unpinned at once; memory.txt read back keeps the kept.
    esv_pin_remove(4);
    format_pins();
    pin_keep[0] = 1;
    pin_keep[1] = 2;
    parse_pins(pin_keep, 2);
    write(1, "read back: ");
    write_int(1, pn_n);
    write(1, " pins, ");
    write_int(1, esv_pin_total());
    write(1, " verses, ready ");
    write_int(1, if (esv_pin_ready(2)) 1 else 0);
    write_int(1, if (esv_pin_ready(1)) 1 else 0);
    print("");
    expect {|
        pinned: 11, total 14, ready 0
        1 pin took John 3, ready 1; 298 bytes
        Pm
        V16
        WFor God so loved the world that He gave His one and only
        FOr only begotten or unique; also in verse 18
        W Son, that everyone who believes in Him shall not perish but have eternal life.
        V17
        WFor God did not send His Son into the world to condemn the world, but to save the world through Him.

        pin text: 15 0, 16 1, 17 1, 18 0, Romans 8 0
        200: 0 then 174, 26 more 0, 27 more 1
        Jude: 12 0, 13 2
        reading with 134 pinned: 351, together at most 500: yes
        Romans held 197 + pinned 12 <= 216
        read back: 2 pins, 14 verses, ready 10
    |}
}

test "ESV pins: their age, a full table, an id past 4096" {
    load();
    if (!tx_ready[0]) text_load(TEXT_BSB, bsb, bsb_n);
    ec_n = 0;
    ec_pool_n = 0;
    pn_n = 0;
    pn_pool_n = 0;
    john: int = book_first[42];
    day: int = 86400;
    // John 3:16 pinned, its records come at day 0: fresh at 30 days, stale
    // (fetched again when online) after.
    _a: bool = esv_pin_add(5000, john + 2, 16, john + 2, 16);
    write(1, "wants before: ");
    write_int(1, if (esv_pin_wants(john + 2, 0)) 1 else 0);
    _t: int = pin_arrive(john + 2, 0);
    write(1, ", at 30 days: ");
    write_int(1, if (esv_pin_wants(john + 2, 30 * day)) 1 else 0);
    write_int(1, if (esv_pin_stale(john + 2, 30 * day)) 1 else 0);
    write(1, ", at 31 days: ");
    write_int(1, if (esv_pin_wants(john + 2, 31 * day)) 1 else 0);
    write_int(1, if (esv_pin_stale(john + 2, 31 * day)) 1 else 0);
    print("");
    // Filled again from the reading cache, when it holds the chapter fresh:
    // the pin's age is then the chapter's.
    n: int = ch_end[john + 2] - ch_start[john + 2];
    for i in 0..n note_buf[i] = bsb[ch_start[john + 2] + i];
    esv_insert(john + 2, note_buf, n, 31 * day);
    write(1, "from the cache: ");
    write_int(1, esv_pin_from_cache(john + 2, 32 * day));
    write(1, ", stale ");
    write_int(1, if (esv_pin_stale(john + 2, 32 * day)) 1 else 0);
    print("");
    // An id past 4096 read back.
    format_pins();
    pin_keep[0] = 5000;
    parse_pins(pin_keep, 1);
    write(1, "id 5000 read back: ");
    write_int(1, pn_n);
    write_int(1, if (esv_pin_ready(5000)) 1 else 0);
    print("");
    // The table full (128 runs): refused as the 200 verses are.
    pn_n = 0;
    k: int = 0;
    ok: bool = true;
    while (ok && k < 200) {
        ok = esv_pin_add(10 + k, book_first[k % 60] + 0, 1, book_first[k % 60] + 0,
            1);
        if (ok) k = k + 1
    }
    write(1, "one-verse passages pinned: ");
    write_int(1, k);
    write(1, ", the next refused as ");
    write_int(1, esv_pin_check(john, 1, john, 1));
    print("");
    expect {|
        wants before: 1, at 30 days: 00, at 31 days: 11
        from the cache: 1, stale 0
        id 5000 read back: 11
        one-verse passages pinned: 128, the next refused as 1
    |}
}
