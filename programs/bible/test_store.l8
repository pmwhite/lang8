tag bible_store_tests;

use_tag std, bible;

// What the reader keeps (store.l8): its files' lines read back, bad lines
// skipped; history's trail of chapters; and the Markdown export.
need "libc.so.6";

import "../../stdlib/print.l8";

import "text.l8";

import "store.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

load() noregion {
    fd: int = open("programs/bible/data/bsb.txt", 0, 0);
    n: int = 8388608;
    bsb = new i8[n](0i8);
    got: int = 0;
    more: bool = true;
    while (more && got < n) {
        r: int = read(fd, bsb, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    close(fd);
    bible_index(got)
}

// fbuf holds s (its lines, as a file would).
feed(s: str) {
    fbuf_n = 0;
    fput_str(s)
}

show_fbuf() raises IoError {
    write_bytes_n(1, fbuf, fbuf_n)
}

john3(): int {
    book_first[42] + 2
}

clear_all() {
    hl_n = 0;
    bm_n = 0;
    nt_n = 0;
    nt_pool_n = 0;
    hs_n = 0
}

test "bad highlight lines are skipped" {
    load();
    clear_all();
    feed("""
JHN	3	16	yellow	1792252800
JHN	3	17	yellow	1792252801
XYZ	3	16	yellow	1792252800
JHN	99	1	yellow	1792252800
JHN	3	999	green	1792252800
JHN	3	0	green	1792252800
JHN	3	3	mauve	1792252800
JHN	3
garbage line with no tabs

JHN	3	x5	green	1792252800
PSA	23	1	blue	1792252900
JHN	3	3	green
""");
    parse_highlights();
    write_int(1, lines_read);
    write(1, " lines, ");
    write_int(1, lines_skipped);
    print(" skipped");
    format_highlights();
    show_fbuf();
    expect "12 lines, 8 skipped\nPSA\t23\t1\tblue\t1792252900\nJHN\t3\t3\tgreen\t0\nJHN\t3\t16\tyellow\t1792252800\nJHN\t3\t17\tyellow\t1792252801\n"
}

test "bad bookmark, note and history lines are skipped" {
    load();
    clear_all();
    feed("""
JHN	3	1	1792252800
JHN	3		1
GEN	1	32	5
JN	3	1	5
""");
    parse_bookmarks();
    format_bookmarks();
    show_fbuf();
    feed("""
JHN	3	5	5	1792252800	Water and Spirit:\\ncompare Ezekiel 36:25â€“27.
JHN	3	0	0	1792252801	Born from above.
JHN	3	0	4	1792252801	A chapter's note must end at 0.
JHN	3	7	2	1792252802	An end before the start is the start.
JHN	3	8
JHN	3	9	9	1792252803
QQQ	1	1	1	1	Unknown book.
JHN	3	36	99	1792252804	The end past the chapter's is its last.
""");
    parse_notes();
    write_int(1, lines_skipped);
    print(" notes skipped");
    format_notes();
    show_fbuf();
    feed("""
JHN	3	16	100	-250	1
JHN	3	abc	5
PSA	23	0	200
PSA	151	1	300
GEN	1	3	400	0	1
""");
    parse_history();
    write_int(1, lines_skipped);
    print(" history lines skipped");
    format_history();
    show_fbuf();
    expect "JHN\t3\t1\t1792252800\n4 notes skipped\nJHN\t3\t0\t0\t1792252801\tBorn from above.\nJHN\t3\t5\t5\t1792252800\tWater and Spirit:\\ncompare Ezekiel 36:25â€“27.\nJHN\t3\t7\t7\t1792252802\tAn end before the start is the start.\nJHN\t3\t36\t36\t1792252804\tThe end past the chapter's is its last.\n2 history lines skipped\nJHN\t3\t16\t100\t-250\t1\nPSA\t23\t0\t200\t0\t0\nGEN\t1\t3\t400\t0\t1\n"
}

test "history is a trail of chapters" {
    load();
    clear_all();
    c: int = john3();
    history_add(c, 3, 0, true, 100);
    history_add(c, 16, 0, true, 200);
    history_add(c + 1, 0, 0, false, 300);
    history_add(c, 5, 0, false, 400);
    history_add(c, 7, 0, true, 500);
    format_history();
    show_fbuf();
    // (No more than 200 kept, the oldest let go.)
    clear_all();
    for i in 0..250 history_add(i, 1, 0, true, i);
    write_int(1, hs_n);
    write(1, " kept, from ");
    write_int(1, hs_ch[0]);
    write(1, " to ");
    write_int(1, hs_ch[hs_n - 1]);
    print("");
    history_delete(0);
    write_int(1, hs_n);
    write(1, " kept, from ");
    write_int(1, hs_ch[0]);
    print("");
    expect "JHN\t3\t16\t200\t0\t1\nJHN\t4\t0\t300\t0\t0\nJHN\t3\t7\t500\t0\t1\n200 kept, from 50 to 249\n199 kept, from 51\n"
}

test "dates" {
    for d in [0, 20744, 20745, 11016, -1] {
        fbuf_n = 0;
        fput_date(d);
        fput_str(" ");
        fput_iso_date(d);
        fput_str(" ");
        fput_str(weekday_names[weekday_of(d)]);
        fput(10);
        show_fbuf()
    }
    write_int(1, day_of(1792252800));
    write(1, " ");
    write_int(1, day_of(-1));
    print("");
    expect {|
        1 January 1970 1970-01-01 Thursday
        18 October 2026 2026-10-18 Sunday
        19 October 2026 2026-10-19 Monday
        29 February 2000 2000-02-29 Tuesday
        31 December 1969 1969-12-31 Wednesday
        20743 -1
    |}
}

