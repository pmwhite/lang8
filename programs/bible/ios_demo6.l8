tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 6 steps, as revised (DESIGN.md §11.6): the `ribbons`
// group, shots 160 to 182, on the demo clock, from a 1.0 (15) readings.tsv
// and history simulate.sh wrote before the first launch: three readings
// made ribbons; the title's menu, New Ribbon Here… and Add; a carried
// ribbon following rests either way, and a read chapter's end; a jump
// putting it down, the capsule picking it up; sheets and a preview not;
// another ribbon opened; Listen carrying it; Leave Here; Move Ribbon Here;
// the Ribbon screen, a rename and a deletion; New Ribbon… in Go To with a
// book chosen; the largest text; Reading Plans, A Chapter a Day started;
// and the recording's sequence 13. Each step does what the reader's own
// taps would, through the same functions.
import "../ios/objc.l8";

import "text.l8";

// Book code's chapter n.
dch(code: str, n: int): int {
    book_first[book_coded(code)] + n - 1
}

// The rest a finger's scroll would end in, at verse v of chapter c.
demo_scroll_rest(c: int, v: int) {
    go_place(c, v, 0);
    bar_set(0.0f64);
    reading_scrolled();
    save_place();
    reader_rested();
    note_num("bible: demo rest at ", cur);
    note_num("bible:   verse ", place_v)
}

// The ribbons, logged in order (the carried one marked).
demo_ribbons_note() {
    note_num("bible: ribbons now ", rb_n);
    for i in 0..rb_n {
        fbuf_n = 0;
        fput_str("bible:   ");
        fput_ribbon_name(i);
        fput_str(" at ");
        fput_code_place(rb_c[i], rb_v[i]);
        if (rb_id[i] == rb_carried) fput_str(" (carried)");
        note_ns(fstring())
    }
}

// The ribbon named name's index (-1 if none).
demo_ribbon(name: str): int {
    for i in 0..rb_n {
        if (rb_name_n[i] == len(name)) {
            same: bool = true;
            for k in 0..len(name)
                if (rb_name[i * RB_NAME_BYTES + k] != name[k]) same = false;
            if (same) return i
        }
    }
    -1
}

// The title's menu, logged: its header, and each child ("New Ribbon Here…
// · Mark 1", "Move Ribbon Here: Romans, Acts, John").
demo_menu_note() {
    b: int = title_btn[0];
    m: int = msg(b, sel("menu"));
    if (m == 0) return;
    fbuf_n = 0;
    fput_str("bible: title menu: ");
    demo_put_ns(msg(m, sel("title")));
    kids: int = msg(m, sel("children"));
    n: int = if (kids == 0) 0 else msg(kids, sel("count"));
    for i in 0..n {
        e: int = msg1(kids, sel("objectAtIndex:"), i);
        fput_str(if (i == 0) " [" else " / ");
        demo_put_ns(msg(e, sel("title")));
        if ((msg1(e, sel("isKindOfClass:"), cls("UIMenu")) & 255) != 0) {
            fput_str(": ");
            sub: int = msg(e, sel("children"));
            for j in 0..msg(sub, sel("count")) {
                if (j > 0) fput_str(", ");
                demo_put_ns(msg(msg1(sub, sel("objectAtIndex:"), j), sel("title")))
            }
        } else if (responds(e, "subtitle") && msg(e, sel("subtitle")) != 0) {
            fput_str(" \�\� ");
            demo_put_ns(msg(e, sel("subtitle")))
        }
        if (responds(e, "attributes") && (msg(e, sel("attributes")) & 1) != 0) fput_str(" (disabled)")
    }
    if (n > 0) fput(93);
    note_ns(fstring())
}

demo_put_ns(s: int) {
    if (s == 0) return;
    n: int = nsstring_into(s, link_buf);
    for i in 0..n fput(link_buf[i] as int)
}

// The title long-pressed: its menu through its interaction (if the
// simulator lets it be opened), and logged.
demo_title_menu() {
    demo_menu_note();
    b: int = title_btn[0];
    i: int = msg(b, sel("contextMenuInteraction"));
    if (i != 0 && responds(i, "_presentMenuAtLocation:")) {
        l8_msg_hfa(hfa, b, sel("bounds"), 0, 0, 0);
        msg_ff(i, sel("_presentMenuAtLocation:"), hfa[2] / 2.0f64, hfa[3] / 2.0f64);
        note("bible: title menu through its interaction")
    } else note("bible: title menu not opened (no interaction)")
}

// The title's menu put away.
demo_title_menu_away() {
    b: int = title_btn[0];
    i: int = msg(b, sel("contextMenuInteraction"));
    if (i != 0) msg(i, sel("dismissMenu"))
}

// How many lines of a kept file begin with word.
demo_lines(name: str, word: str): int {
    read_file(name);
    n: int = 0;
    begin_lines();
    while (next_line())
        if (field_is(fpos, word)) n = n + 1;
    n
}

// Go To's commit of a row (as the swipe's Delete or Remove).
demo_commit(s: int, r: int) {
    if (picker_table != 0) _r: int = table_commit(0, 0, picker_table, 1, msg2(cls("NSIndexPath"),
        sel("indexPathForRow:inSection:"), r, s))
}

demo_do6(t: int) {
    if (t == 290) {
        // 160: Go To, the readings made ribbons.
        demo_ribbons_note();
        note_num("bible: readings-r6.tsv READING lines ", demo_lines("readings-r6.tsv",
            "READING"));
        open_picker()
    }
    if (t == 291) {
        // 161: to Mark 1 by Go To's grid; the title long-pressed.
        demo_dismiss();
        open_picker();
        demo_later_at(0.8f64, 400)
    }
    if (t == 292) {
        // 162: its New Ribbon Here… chosen: the menu away, the sheet.
        demo_title_menu_away();
        demo_later_at(0.5f64, 403)
    }
    if (t == 293) {
        // 163: "Morning" typed; Add.
        if (nr_field != 0) msg1(nr_field, sel("setText:"), nsstring("Morning"));
        nr_add();
        demo_ribbons_note()
    }
    if (t == 294) {
        // 164: the title long-pressed again.
        demo_later_at(0.4f64, 402)
    }
    if (t == 295) {
        // 165: rests at Mark 1:21 and 2:5 (the finger's); Go To.
        demo_title_menu_away();
        hide_back();
        demo_later_at(0.5f64, 404)
    }
    if (t == 296) {
        // 166: back a little, to Mark 2:3; Go To.
        demo_dismiss();
        demo_scroll_rest(dch("MRK", 2), 3);
        demo_ribbons_note();
        demo_later_at(0.4f64, 401)
    }
    if (t == 297) {
        // 167: a rest at Mark 2's end, the chapter read; Go To (a sheet's
        // rest there again).
        demo_dismiss();
        c: int = dch("MRK", 2);
        demo_scroll_rest(c, ch_verses[c]);
        demo_read(c);
        demo_ribbons_note();
        demo_later_at(0.4f64, 401)
    }
    if (t == 298) {
        // 168: search "love", its 1 Corinthians 13 result; a rest at 13:4;
        // Go To.
        demo_dismiss();
        hide_back();
        open_search();
        demo_search("love");
        demo_later_at(0.8f64, 405)
    }
    if (t == 299) {
        // 169: the capsule tapped.
        demo_dismiss();
        demo_later_at(0.4f64, 407)
    }
    if (t == 300) {
        // 170: a cross reference's preview, closed; the Library, Done; a rest
        // at Mark 3:7; Go To.
        demo_dismiss();
        hide_back();
        demo_later_at(0.4f64, 408)
    }
    if (t == 301) {
        // 171: Acts's row tapped.
        i: int = demo_ribbon("Acts");
        if (i >= 0) ribbons_picked(i)
    }
    if (t == 302) {
        // 172: Listen; Acts 10's end heard; Listen stopped; Go To.
        demo_dismiss();
        hide_back();
        listen_start(dch("ACT", 10), 9);
        demo_later_at(1.2f64, 412)
    }
    if (t == 303) {
        // 173: Leave Acts Here (the title's menu); a rest at Acts 11:5; Go
        // To.
        demo_dismiss();
        demo_later_at(0.4f64, 414)
    }
    if (t == 304) {
        // 174: to Romans 8 by the grid; Move Ribbon Here › Romans.
        demo_dismiss();
        hide_back();
        open_picker();
        demo_later_at(0.8f64, 416)
    }
    if (t == 305) {
        // 175: Go To; Morning's ⓘ.
        demo_dismiss();
        hide_back();
        demo_later_at(0.4f64, 419)
    }
    if (t == 306) {
        // 176: renamed "With Anna" (the editing ended); back.
        if (rbs_field != 0) {
            msg1(rbs_field, sel("setText:"), nsstring("With Anna"));
            rbs_rename()
        }
        demo_pop()
    }
    if (t == 307) {
        // 177: John deleted (its row's commit).
        i: int = demo_ribbon("John");
        if (i >= 0) demo_commit(GT_RIBBONS_SECTION, i);
        demo_ribbons_note()
    }
    if (t == 308) {
        // 178a: New Ribbon… (pushed, at Romans 8); Book → Jude.
        ribbons_picked(gt_rb);
        demo_later_at(0.8f64, 421)
    }
    if (t == 309) {
        // 178: Add, the field empty.
        nr_add();
        demo_ribbons_note()
    }
    if (t == 310) {
        // 179 (the largest text): Go To.
        demo_dismiss();
        hide_back();
        demo_later_at(0.4f64, 401)
    }
    if (t == 311) {
        // 180: Reading Plans.
        plan_picked(plan_rows() - 1)
    }
    if (t == 312) {
        // 181: A Chapter a Day; Book → Hebrews.
        plans_picked(1, 0);
        demo_later_at(0.8f64, 423)
    }
    if (t == 313) {
        // 182: Start Plan; Go To.
        _r: int = day1_start(0, 0, 0);
        demo_ribbons_note();
        demo_later_at(1.2f64, 401)
    }
    if (t == 314) demo_sequence6();
    if (t == 315) {
        // (Logged only: twelve ribbons, Go To's limit; then one deleted.)
        demo_dismiss();
        hide_back();
        while (rb_n < RB_MOST) _id: int = ribbon_make(nm_in, 0, dch("GEN", rb_n + 1),
            0, 0, time(0));
        ribbons_changed();
        demo_menu_note();
        demo_later_at(0.4f64, 440)
    }
}

// Go To's limit, as the log tells it: the footer, and whether New Ribbon…
// takes a tap.
demo_limit_note(what: str) {
    fbuf_n = 0;
    fput_str("bible: limit ");
    fput_str(what);
    fput_str(": ribbons ");
    fput_int(rb_n);
    fput_str(", footer ");
    f: int = ribbons_footer();
    if (f == 0) fput_str("none") else demo_put_ns(f);
    cell: int = if (picker_table != 0) msg1(picker_table, sel("cellForRowAtIndexPath:"),
        msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), gt_rb, GT_RIBBONS_SECTION)) else 0;
    fput_str(", New Ribbon\�\�\� enabled ");
    fput_int(if (cell == 0) -1 else msg(cell, sel("isUserInteractionEnabled")) & 255);
    v: int = if (picker_table != 0) msg1(picker_table, sel("footerViewForSection:"),
        GT_RIBBONS_SECTION) else 0;
    if (v != 0) {
        fput_str(", footer height ");
        fput_int(view_height(v) as int)
    }
    note_ns(fstring())
}

// The later parts of the steps (demo_later's kinds 400 and up).
demo6_waits: int = 0;

demo_later6(d: int) {
    // (What opens a sheet waits until no sheet is left, for 5 s at most.)
    opens: bool = d == 401 || d == 402 || d == 403 || d == 404 || d == 407 || d == 408 || d == 409 || d == 414 || d == 415 || d == 419 || d == 430 || d == 438 || d == 440;
    if (opens && presented() != 0 && demo6_waits < 16) {
        demo6_waits = demo6_waits + 1;
        demo_later_at(0.3f64, d);
        return
    }
    demo6_waits = 0;
    if (d == 401) open_picker() else if (d == 400) {
        show_chapters(book_coded("MRK"));
        demo_later_at(0.8f64, 406)
    } else if (d == 406) {
        // (Mark 1 tapped in the grid: its jump.)
        jump(dch("MRK", 1), 0);
        demo_later_at(1.0f64, 402)
    } else if (d == 402) demo_title_menu() else if (d == 403) _r: int = new_ribbon_here(0,
        0, 0) else if (d == 404) {
        demo_scroll_rest(dch("MRK", 1), 21);
        demo_scroll_rest(dch("MRK", 2), 5);
        demo_ribbons_note();
        open_picker()
    } else if (d == 405) {
        // (The first result in 1 Corinthians 13, tapped.)
        c: int = dch("1CO", 13);
        found: int = -1;
        for i in 0..hit_count
            if (found < 0 && hit_chapter[i] == c) found = i;
        note_num("bible: search result in 1CO 13 ", found);
        if (found >= 0) search_picked(if (sr_ref) 1 else 0, found);
        demo_later_at(1.0f64, 409)
    } else if (d == 409) {
        demo_scroll_rest(dch("1CO", 13), 4);
        demo_ribbons_note();
        open_picker()
    } else if (d == 407) {
        _r: int = back_tapped(0, 0, 0);
        demo_ribbons_note()
    } else if (d == 408) {
        // (Isaiah 40:3, Mark 1:3's, previewed.)
        xr_book = 22;
        xr_c = 40;
        xr_v = 3;
        xr_ce = 40;
        xr_ve = 3;
        open_preview(xref_both());
        demo_later_at(1.0f64, 410)
    } else if (d == 410) {
        demo_dismiss();
        open_library();
        demo_later_at(1.0f64, 411)
    } else if (d == 411) {
        demo_dismiss();
        demo_scroll_rest(dch("MRK", 3), 7);
        demo_ribbons_note();
        demo_later_at(0.4f64, 401)
    } else if (d == 412) {
        // (Listen's following at Acts 10's end, then its chapter's end.)
        c: int = dch("ACT", 10);
        go_place(c, ch_verses[c], 0);
        bar_set(0.0f64);
        reading_scrolled();
        save_place();
        reader_rested();
        demo_heard = true;
        chapter_heard(c);
        demo_heard = false;
        listen_stop();
        demo_ribbons_note();
        demo_later_at(0.8f64, 401)
    } else if (d == 414) {
        demo_title_menu_note_leave();
        demo_later_at(0.6f64, 415)
    } else if (d == 415) {
        demo_scroll_rest(dch("ACT", 11), 5);
        demo_ribbons_note();
        open_picker()
    } else if (d == 416) {
        show_chapters(book_coded("ROM"));
        demo_later_at(0.8f64, 417)
    } else if (d == 417) {
        jump(dch("ROM", 8), 0);
        demo_later_at(1.0f64, 418)
    } else if (d == 418) {
        i: int = demo_ribbon("Romans");
        demo_menu_note();
        if (i >= 0) ribbon_move_here_now(rb_id[i]);
        demo_ribbons_note()
    } else if (d == 419) {
        open_picker();
        demo_later_at(0.8f64, 420)
    } else if (d == 420) {
        i: int = demo_ribbon("Morning");
        if (i >= 0) open_ribbon_screen(i)
    } else if (d == 421) {
        bg_open_books();
        demo_later_at(0.8f64, 422)
    } else if (d == 422) bg_choose_book(book_coded("JUD")) else if (d == 423) {
        bg_open_books();
        demo_later_at(0.8f64, 424)
    } else if (d == 424) bg_choose_book(book_coded("HEB")) else if (d == 430) {
        // (Sequence 13's start: Go To with four ribbons.)
        hide_back();
        open_picker()
    } else if (d == 431) {
        // The second ribbon's row swiped away.
        demo_commit(GT_RIBBONS_SECTION, 1);
        demo_ribbons_note()
    } else if (d == 432) {
        if (rb_n > 0) open_ribbon_screen(0)
    } else if (d == 433) demo_pop_animated() else if (d == 434) {
        if (gt_rb > 0) ribbons_picked(0)
    } else if (d == 435) demo_title_menu() else if (d == 436) {
        // (The menu away first: what opens the sheet waits for it to go.)
        demo_title_menu_away();
        demo_later_at(0.4f64, 438)
    } else if (d == 438) _r: int = new_ribbon_here(0, 0, 0) else if (d == 437) dismiss_sheets() else if (d == 440) {
        open_picker();
        demo_later_at(1.0f64, 443)
    } else if (d == 443) {
        // (New Ribbon… brought into sight, below the twelve.)
        if (picker_table != 0) msg3(picker_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
            msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), gt_rb, GT_RIBBONS_SECTION),
            3, 0);
        demo_later_at(0.6f64, 441)
    } else if (d == 441) {
        demo_limit_note("at 12");
        demo_commit(GT_RIBBONS_SECTION, rb_n - 1);
        demo_later_at(1.0f64, 442)
    } else if (d == 442) {
        demo_limit_note("after a delete");
        demo_menu_note()
    }
}

// Leave … Here, as the title's menu gives it (logged first).
demo_title_menu_note_leave() {
    demo_menu_note();
    ribbon_leave_now();
    demo_ribbons_note()
}

// The recording's sequence 13 (DESIGN.md §11.6): in Go To with four
// ribbons, the second swiped away; ⓘ on one, and back; one tapped (the
// sheet away, the reader there, the capsule, the toast); then the title's
// menu, New Ribbon Here… (the sheet rising with its keyboard), Cancel.
demo_seq6_at: int = 0;

demo_seq6_timer: int = 0;

demo_seq6_steps: []int = [431, 432, 433, 434, 435, 436, 437];

// (Its setup, step 342, before the recording's mark: review r6-1.)
demo_sequence6_setup() {
    demo_dismiss();
    demo_later_at(0.3f64, 430)
}

demo_sequence6() {
    demo_seq6_at = 0;
    demo_seq6_timer = after(0.6f64, "demoSeq6:")
}

demo_seq6(_self: int, _cmd: int, _timer: int): int {
    demo_seq6_timer = 0;
    if (demo_seq6_at >= len(demo_seq6_steps)) return 0;
    d: int = demo_seq6_steps[demo_seq6_at];
    demo_seq6_at = demo_seq6_at + 1;
    demo_next = 0;
    demo_later6(d);
    demo_settle_start();
    demo_seq6_timer = after(if (d == 434 || d == 436) 2.4f64 else 1.6f64, "demoSeq6:");
    0
}

add_demo6_methods(app: int) {
    add_method1(app, sel("demoSeq6:"), &demo_seq6, "v@:@")
}
