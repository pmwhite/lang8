tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 6 steps (DESIGN.md ยง11.4): the `reading` group, shots
// 160 to 182, on the demo clock, from a history simulate.sh wrote before
// the first launch (Acts 9:1 and 10:9, Psalm 23, yesterday): the readings
// seeded from it; one started by a book's first chapter, none by casual
// visits; moved by reading on and by a rest, not by a jump; two in a row;
// a reading's row returning to its place exactly; a plan's chapters
// starting none; Show All and Reading; readings that meet; across books;
// Remove; the largest text; the title's menu, Start Reading and its toast;
// the grid's toolbar, A Chapter a Day, a plan's preview, a plan removed;
// Jude by choice; and the recording's sequence 13. Each step does what the
// reader's own taps would, through the same functions.
import "../ios/objc.l8";

import "text.l8";

// Book code's chapter n.
dch(code: str, n: int): int {
    book_first[book_coded(code)] + n - 1
}

// The rest a finger's scroll would end in, at verse v of chapter c.
demo_scroll_rest(c: int, v: int) {
    go_place(c, v, 0);
    bar_set(0.0f64);
    reading_scrolled();
    save_place();
    reader_rested();
    note_num("bible: demo rest at ", cur);
    note_num("bible:   verse ", place_v)
}

// Go To's row of the reading at chapter c (-1 if it shows none).
demo_reading_row(c: int): int {
    i: int = rg_find(c);
    if (i < 0) -1 else today_row_of(i)
}

// The readings, logged (newest first).
demo_readings_note() {
    note_num("bible: readings now ", rg_n);
    for i in 0..rg_n {
        fbuf_n = 0;
        fput_str("bible:   ");
        fput_code_place(rg_c[i], rg_v[i]);
        note_ns(fstring())
    }
}

// A reading at chapter c, made by the demo (LAST at t).
demo_seed_reading(c: int, t: int) {
    if (rg_find(c) >= 0) return;
    _i: int = rg_add(c, 0, 0, t, t);
    rg_sort();
    save_readings();
    title_menus_refresh();
    fbuf_n = 0;
    fput_str("bible: demo reading at ");
    fput_code_place(c, 0);
    note_ns(fstring())
}

// The title's command (its menu's one child).
demo_title_command(): int {
    b: int = title_btn[title_settled()];
    m: int = msg(b, sel("menu"));
    if (m == 0) return 0;
    kids: int = msg(m, sel("children"));
    if (kids == 0 || msg(kids, sel("count")) == 0) return 0;
    msg1(kids, sel("objectAtIndex:"), 0)
}

// How many lines of a kept file begin with word.
demo_lines(name: str, word: str): int {
    read_file(name);
    n: int = 0;
    begin_lines();
    while (next_line())
        if (field_is(fpos, word)) n = n + 1;
    n
}

demo_do6(t: int) {
    if (t == 290) {
        demo_readings_note();
        open_picker()
    }
    if (t == 291) {
        demo_dismiss();
        jump(dch("ROM", 1), 0);
        demo_read(dch("ROM", 1));
        demo_later_at(0.8f64, 401)
    }
    if (t == 292) {
        // Search "love", and a result in 1 Corinthians 13.
        demo_dismiss();
        hide_back();
        open_search();
        demo_search("love");
        demo_later_at(0.8f64, 402)
    }
    if (t == 293) {
        // Romans 2's row tapped.
        row: int = demo_reading_row(dch("ROM", 2));
        if (row >= 0) today_picked(row);
        demo_later_at(1.0f64, 406)
    }
    if (t == 294) {
        // To Romans 8 by Go To's grid.
        demo_dismiss();
        open_picker();
        demo_later_at(0.8f64, 408)
    }
    if (t == 295) {
        demo_dismiss();
        jump(dch("JHN", 13), 0);
        demo_read(dch("JHN", 13));
        demo_read(dch("JHN", 14));
        demo_later_at(0.8f64, 401)
    }
    if (t == 296) {
        // Romans 3:9's row tapped.
        row: int = demo_reading_row(dch("ROM", 3));
        if (row >= 0) today_picked(row)
    }
    if (t == 297) {
        demo_dismiss();
        open_picker();
        demo_later_at(0.8f64, 410)
    }
    if (t == 298) {
        // Readings at John 17 and Philippians 4, older than Acts's.
        demo_dismiss();
        a: int = rg_find(dch("ACT", 10));
        last: int = if (a >= 0) rg_last[a] else time(0) - 86400;
        demo_seed_reading(dch("JHN", 17), last - 3600);
        demo_seed_reading(dch("PHP", 4), last - 7200);
        demo_later_at(0.4f64, 401)
    }
    if (t == 299) open_reading_list();
    if (t == 300) {
        demo_dismiss();
        jump(dch("JHN", 15), 0);
        demo_read(dch("JHN", 15));
        demo_read(dch("JHN", 16));
        demo_later_at(0.8f64, 401)
    }
    if (t == 301) {
        // Philippians 4's row tapped, and read.
        row: int = demo_reading_row(dch("PHP", 4));
        if (row >= 0) today_picked(row);
        demo_later_at(1.0f64, 414)
    }
    if (t == 302) {
        // Acts 10:9 removed (its row's commit, as the swipe's Remove).
        row: int = demo_reading_row(dch("ACT", 10));
        if (row >= 0 && picker_table != 0) _r: int = table_commit(0, 0, picker_table,
            1, msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), row, 0));
        note_num("bible: readings.tsv CLEARED lines ", demo_lines("readings.tsv",
            "CLEARED"));
        demo_readings_note()
    }
    if (t == 303) {
        demo_dismiss();
        demo_later_at(0.4f64, 401)
    }
    if (t == 304) {
        demo_dismiss();
        hide_back();
        jump(dch("MRK", 1), 0);
        demo_later_at(0.8f64, 415)
    }
    if (t == 305) {
        // Its command chosen: the menu away, the sheet.
        demo_title_menu_away();
        demo_later_at(0.5f64, 416)
    }
    if (t == 306) sta_start();
    if (t == 307) {
        demo_dismiss();
        demo_later_at(0.4f64, 401)
    }
    if (t == 308) show_chapters(book_coded("HEB"));
    if (t == 309) {
        // The grid's toolbar item, tapped; then A Chapter a Day.
        top: int = top_presented();
        grid: int = if (top != 0) msg(top, sel("topViewController")) else 0;
        items: int = if (grid != 0) msg(grid, sel("toolbarItems")) else 0;
        if (items != 0 && msg(items, sel("count")) >= 2) grid_start_reading(0, 0,
            msg1(items, sel("objectAtIndex:"), 1));
        demo_later_at(0.8f64, 417)
    }
    if (t == 310) sta_accessory(PLAN_GOSPELS);
    if (t == 311) {
        demo_pop();
        demo_later_at(0.6f64, 418)
    }
    if (t == 312) {
        // The plan's row removed (its commit).
        if (picker_table != 0 && td_n > 0 && td_kind[0] == 1) _r: int = table_commit(0,
            0, picker_table, 1, msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"),
            0, 0));
        note_num("bible: plan after removing its row ", pl_active);
        note_num("bible: reminder on ", if (nt_on) 1 else 0)
    }
    if (t == 313) {
        // Start Reading Here at Jude (the sheet opened there), Start.
        demo_dismiss();
        open_start(dch("JUD", 1), false);
        demo_later_at(1.0f64, 420)
    }
    if (t == 314) demo_sequence6()
}

// The title's menu put away.
demo_title_menu_away() {
    b: int = title_btn[title_settled()];
    i: int = msg(b, sel("contextMenuInteraction"));
    if (i != 0) msg(i, sel("dismissMenu"))
}

// The later parts of the steps (demo_later's kinds 400 and up).
demo_later6(d: int) {
    // (What opens a sheet waits until no sheet is left.)
    opens: bool = d == 401 || d == 404 || d == 405 || d == 407 || d == 419 || d == 430;
    if (opens && presented() != 0) {
        demo_later_at(0.3f64, d);
        return
    }
    if (d == 401) open_picker() else if (d == 402) {
        // (The first result in 1 Corinthians 13, tapped.)
        c: int = dch("1CO", 13);
        found: int = -1;
        for i in 0..hit_count
            if (found < 0 && hit_chapter[i] == c) found = i;
        note_num("bible: search result in 1CO 13 ", found);
        if (found >= 0) search_picked(if (sr_ref) 1 else 0, found);
        demo_later_at(1.0f64, 403)
    } else if (d == 403) {
        demo_read(dch("1CO", 13));
        // (A preview of Isaiah 53:5, Open in Reader: preview_open's jump.)
        jump(dch("ISA", 53), 5);
        demo_later_at(0.8f64, 404)
    } else if (d == 404) {
        one_verse[0] = 16;
        open_compare(john3(), one_verse, 1);
        demo_later_at(1.0f64, 405)
    } else if (d == 405) {
        demo_dismiss();
        demo_readings_note();
        demo_later_at(0.4f64, 401)
    } else if (d == 406) {
        note_num("bible: at the reading's place ", cur);
        demo_read(dch("ROM", 2));
        demo_scroll_rest(dch("ROM", 3), 9);
        demo_readings_note();
        demo_later_at(0.6f64, 401)
    } else if (d == 408) {
        show_chapters(book_coded("ROM"));
        demo_later_at(0.8f64, 409)
    } else if (d == 409) {
        // (Romans 8 tapped: the grid's jump; then 25 s of rest there, as
        // the demo counts it: no scroll since the jump, so nothing moves.)
        jump(dch("ROM", 8), 0);
        pr_dwell[cur] = pr_dwell[cur] + 25.0f64;
        _r: int = reading_dwelt(0, 0, 0);
        demo_readings_note();
        demo_later_at(0.6f64, 401)
    } else if (d == 410) {
        for row in 0..td_n
            if (td_kind[row] == 4) today_picked(row);
        demo_later_at(0.8f64, 411)
    } else if (d == 411) {
        sta_choose(2);
        demo_later_at(0.6f64, 412)
    } else if (d == 412) {
        sta_start();
        demo_later_at(1.2f64, 413)
    } else if (d == 413) {
        demo_read(dch("GEN", 1));
        demo_read(dch("GEN", 2));
        demo_readings_note();
        demo_later_at(0.4f64, 401)
    } else if (d == 414) {
        demo_read(dch("PHP", 4));
        demo_readings_note();
        demo_later_at(0.6f64, 401)
    } else if (d == 415) {
        // The title long-pressed: its menu (through its interaction, if the
        // simulator lets it be opened), and its items logged.
        cmd: int = demo_title_command();
        if (cmd != 0) {
            fbuf_n = 0;
            fput_str("bible: title menu: ");
            n: int = nsstring_into(msg(cmd, sel("title")), link_buf);
            for i in 0..n fput(link_buf[i] as int);
            fput_str(" \ย\ท ");
            if (responds(cmd, "subtitle")) {
                n = nsstring_into(msg(cmd, sel("subtitle")), link_buf);
                for i in 0..n fput(link_buf[i] as int)
            }
            note_ns(fstring())
        }
        b: int = title_btn[title_settled()];
        i: int = msg(b, sel("contextMenuInteraction"));
        if (i != 0 && responds(i, "_presentMenuAtLocation:")) {
            l8_msg_hfa(hfa, b, sel("bounds"), 0, 0, 0);
            msg_ff(i, sel("_presentMenuAtLocation:"), hfa[2] / 2.0f64, hfa[3] / 2.0f64);
            note("bible: title menu through its interaction")
        } else note("bible: title menu not opened (no interaction)")
    } else if (d == 416) {
        cmd: int = demo_title_command();
        if (cmd != 0) _r: int = start_reading_here(0, 0, cmd) else open_start(cur,
            false)
    } else if (d == 417) sta_choose(1) else if (d == 418) {
        sta_start();
        note_num("bible: plans-done.tsv PLAN lines ", demo_lines("plans-done.tsv",
            "PLAN"));
        note_num("bible: plans-done.tsv END lines ", demo_lines("plans-done.tsv",
            "END"));
        demo_later_at(1.2f64, 419)
    } else if (d == 419) open_picker() else if (d == 420) {
        sta_start();
        demo_later_at(1.2f64, 419)
    } else if (d == 430) {
        // (Sequence 13's start: a plan followed, and six readings.)
        hide_back();
        if (pl_active < 0) plan_follow(PLAN_NT90, cur);
        demo_seed_reading(dch("GEN", 30), time(0) - 9 * 86400);
        open_picker()
    } else if (d == 431) {
        // The second reading's row swiped away.
        row: int = today_row_of(1);
        if (row >= 0) today_remove(row);
        demo_readings_note()
    } else if (d == 432) open_reading_list() else if (d == 433) demo_pop() else if (d == 434) {
        row: int = today_row_of(1);
        if (row >= 0) today_remove(row)
    } else if (d == 435) {
        row: int = today_row_of(0);
        if (row >= 0) today_picked(row)
    } else if (d == 436) {
        cmd: int = demo_title_command();
        if (cmd != 0) _r: int = start_reading_here(0, 0, cmd)
    } else if (d == 437) sta_choose(2) else if (d == 438) sta_choose(0) else if (d == 439) sta_open_books() else if (d == 440) sta_choose_book(book_coded("JUD")) else if (d == 441) dismiss_sheets()
}

// The recording's sequence 13 (DESIGN.md ยง11.4): in Go To, the second
// reading removed twice (the fifth in as the fourth, Show All's count, then
// Show All gone), Reading pushed and popped between, a reading tapped; then
// Start Reading from the title's menu: a plan chosen (Begin At dims, the
// footer comes), At My Own Pace (it undims, the footer goes), Book changed
// to Jude (A Chapter a Day goes), Cancel.
demo_seq6_at: int = 0;

demo_seq6_timer: int = 0;

demo_seq6_steps: []int = [431, 432, 433, 434, 435, 436, 437, 438, 439, 440, 441];

demo_sequence6() {
    demo_dismiss();
    demo_seq6_at = 0;
    demo_later_at(0.3f64, 430);
    demo_seq6_timer = after(2.0f64, "demoSeq6:")
}

demo_seq6(_self: int, _cmd: int, _timer: int): int {
    demo_seq6_timer = 0;
    if (demo_seq6_at >= len(demo_seq6_steps)) return 0;
    d: int = demo_seq6_steps[demo_seq6_at];
    demo_seq6_at = demo_seq6_at + 1;
    demo_next = 0;
    demo_later6(d);
    demo_settle_start();
    demo_seq6_timer = after(if (d == 435 || d == 441) 1.8f64 else 1.5f64, "demoSeq6:");
    0
}

add_demo6_methods(app: int) {
    add_method1(app, sel("demoSeq6:"), &demo_seq6, "v@:@")
}
