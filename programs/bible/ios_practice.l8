tag bible_ios;

use_tag std, ios, bible;

// Practice (DESIGN.md Â§13.3): a sheet of one passage at a time, from the
// Library's Practice (today's), a row, or the tray's Memorizing. The
// passage is one attributed string laid out once (the reader's font and
// size, memory.l8's words); every level, word shown and Check only sets
// its colors and underlines again (a hidden letter drawn in the clear
// color keeps its width), so the text never moves. Learning goes a part
// at a time (a warm-up of the parts learned at Letters, the new part from
// Full to Blank, then joined to the one before); review is the whole at
// its level, then Not Yet, Mostly or Knew It, one suggested. Type takes
// first letters (a view of UIKeyInput's), each word's key letter, one
// retry, then a miss. Listen and Echo play the passage from the
// recordings' verse timings (an AVPlayer polled, no blocks), or the
// iPhone's voice (an utterance a verse); the verse heard is washed, and in
// Echo's pause its underlines turn accent: your turn.
import "../ios/objc.l8";

import "text.l8";

import "memory.l8";

// ---- the sheet ----
px_class: int = 0;

px_keys_class: int = 0;

px_el_class: int = 0;

px_nav: int = 0;

px_vc: int = 0;

px_tv: int = 0;

px_seg: int = 0;

px_end: int = 0;

px_end_top: int = 0;

px_end_bottom: int = 0;

px_count: int = 0;

px_line: int = 0;

px_keys: int = 0;

px_kb_bar: int = 0;

px_judge: int = 0;

// The session: the passages' ids, in order, the one shown, and whether
// each has come back once (a Not Yet's).
px_q: []int = new int[512](0);

px_qn: int = 0;

px_at: int = 0;

px_back: []bool = new bool[512](false);

// The passage shown (its index), and where it is: its step, its level, the
// words practised now (a0 to a1; those before faint, those after unseen),
// the part being learned.
PX_WARMUP: int = 0;

PX_WARMUP_DONE: int = 1;

PX_NEW: int = 2;

PX_NEW_DONE: int = 3;

PX_JOINED: int = 4;

PX_JOINED_DONE: int = 5;

PX_REVIEW: int = 6;

PX_REVIEW_DONE: int = 7;

PX_END: int = 8;

PX_WAIT: int = 9;

// A card (ios_cards.l8): its front, checked, a new one's first showing;
// a word read, checked; Practise Reading's end.
PX_CARD: int = 10;

PX_CARD_DONE: int = 11;

PX_CARD_NEW: int = 12;

PX_READ: int = 13;

PX_READ_DONE: int = 14;

PX_READ_END: int = 15;

px_i: int = -1;

px_step: int = 8;

px_level: int = 0;

px_a0: int = 0;

px_a1: int = 0;

px_part: int = 0;

// Each word: shown (by a tap, typing or Check), helped, missed, and wrong
// once while typed; the word being typed (-1: none).
px_shown: []bool = new bool[4096](false);

px_help: []bool = new bool[4096](false);

px_miss: []bool = new bool[4096](false);

px_wrong: []bool = new bool[4096](false);

px_cur: int = -1;

px_typing: bool = false;

// UTF-16 units before each byte of mt (and its end), and before mt in
// the text (the caption's).
px_u16: []int = new int[65537](0);

px_base: int = 0;

// The verse washed (heard), and the verse in Echo's pause (-1: none).
px_wash: int = -1;

px_turn: int = -1;

// The grade under the finger's line shown (whether).
px_line_on: bool = false;

// ---- opening ----
// Today's passages (the Library's Practice).
practice_open_today() {
    memory_today(today(), 0);
    n: int = 0;
    for k in 0..td_today {
        px_q[n] = mq_id[td[k]];
        px_back[n] = false;
        n = n + 1
    }
    // (Then today's cards: Â§14.3.1.)
    n = practice_add_cards(n);
    // (None: the end's words at once.)
    px_open(n)
}

// One passage (a row, or Memorizing), whatever its state.
practice_open_one(i: int) {
    if (i < 0 || i >= mq_n) return;
    px_q[0] = mq_id[i];
    px_back[0] = false;
    px_one_next = mq_id[i];
    px_open(1)
}

// The passage a one-passage session is of (its id; 0: a session of
// Today's), for the end's next review: review r9-1 Minor 13.
px_one: int = 0;

px_one_next: int = 0;

// The one-time line (memorySeen): on this sheet's first passage, kept
// when its text is made again (a theme or size changed).
px_first_line: bool = false;

px_open(n: int) {
    if (px_nav != 0) return;
    crd_open(n);
    listen_stop();
    px_first_line = !def_bool("memorySeen");
    if (px_first_line) set_def_bool("memorySeen", true);
    px_qn = n;
    px_at = 0;
    px_one = px_one_next;
    px_one_next = 0;
    // (Memory's ESV verses fetched if missing or stale: Â§13.6.)
    memory_esv_refresh();
    vc: int = msg(make("L8Practice"), sel("autorelease"));
    px_vc = held(px_vc, vc);
    view: int = msg(vc, sel("view"));
    msg1(view, sel("setBackgroundColor:"), c_bg);
    item: int = msg(vc, sel("navigationItem"));
    msg1(item, sel("setLargeTitleDisplayMode:"), 2);
    msg1(item, sel("setRightBarButtonItem:"), msg(msg3(msg(cls("UIBarButtonItem"),
        sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"), 0, app_obj,
        sel("practiceDone:")), sel("autorelease")));
    // "2 of 3", faint, while there is more than one.
    px_count = held(px_count, msg(make("UILabel"), sel("autorelease")));
    msg1(px_count, sel("setFont:"), px_scaled(sans(15.0f64, 0.0f64)));
    msg1(px_count, sel("setTextColor:"), c_faint);
    // (Plain text, not in a glass capsule on iOS 26; and no item at all
    // with one passage, so no empty button shows: review r9-1 Major 1.)
    count_item: int = msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
        px_count);
    if (responds(count_item, "setHidesSharedBackground:")) msg1(count_item, sel("setHidesSharedBackground:"),
        1);
    px_count_item = held(px_count_item, count_item);
    release(count_item);
    // The levels, on a row of their own.
    one[0] = nsstring("Full");
    one[1] = nsstring("Some");
    one[2] = nsstring("Letters");
    one[3] = nsstring("Blank");
    seg: int = msg1(msg(cls("UISegmentedControl"), sel("alloc")), sel("initWithItems:"),
        nsarray(one, 4));
    msg3(seg, sel("addTarget:action:forControlEvents:"), app_obj, sel("practiceLevel:"),
        4096);
    msg1(seg, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(view, sel("addSubview:"), seg);
    px_seg = held(px_seg, seg);
    release(seg);
    // The passage: a text view, not editable or selectable.
    tv: int = make("UITextView");
    msg1(tv, sel("setEditable:"), 0);
    msg1(tv, sel("setSelectable:"), 0);
    msg1(tv, sel("setBackgroundColor:"), c_bg);
    msg1(tv, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg_set_f(msg(tv, sel("textContainer")), sel("setLineFragmentPadding:"), 0.0f64);
    msg1(tv, sel("setAdjustsFontForContentSizeCategory:"), 0);
    // (TextKit 1 from the start: the words' places are read from its
    // layout, which then never changes under them.)
    _lm: int = msg(tv, sel("layoutManager"));
    tap: int = msg2(msg(cls("UITapGestureRecognizer"), sel("alloc")), sel("initWithTarget:action:"),
        app_obj, sel("practiceTapped:"));
    msg1(tv, sel("addGestureRecognizer:"), tap);
    release(tap);
    msg1(view, sel("addSubview:"), tv);
    px_tv = held(px_tv, tv);
    release(tv);
    // (A card's view, over the text's place: ios_cards.l8.)
    crd_make(view);
    // The end: two lines, centred.
    end: int = stack(1, 6.0f64);
    msg1(end, sel("setAlignment:"), 3);
    px_end_top = held(px_end_top, msg(make("UILabel"), sel("autorelease")));
    px_end_bottom = held(px_end_bottom, msg(make("UILabel"), sel("autorelease")));
    for l in [px_end_top, px_end_bottom] {
        msg1(l, sel("setNumberOfLines:"), 0);
        msg1(l, sel("setTextAlignment:"), 1);
        msg1(l, sel("setAdjustsFontForContentSizeCategory:"), 1);
        msg1(end, sel("addArrangedSubview:"), l)
    }
    msg1(view, sel("addSubview:"), end);
    msg1(end, sel("setHidden:"), 1);
    px_end = held(px_end, end);
    // What a grade would do, under the finger.
    px_line = held(px_line, msg(make("UILabel"), sel("autorelease")));
    msg1(px_line, sel("setFont:"), msg1(cls("UIFont"), sel("preferredFontForTextStyle:"),
        objc_const("UIFontTextStyleFootnote")));
    msg1(px_line, sel("setAdjustsFontForContentSizeCategory:"), 1);
    msg1(px_line, sel("setTextColor:"), c_faint);
    msg1(px_line, sel("setTextAlignment:"), 1);
    msg1(px_line, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    msg1(view, sel("addSubview:"), px_line);
    // The keyboard's view (first letters), and the bar over its keys.
    keys: int = make("L8Keys");
    msg_rect(keys, sel("setFrame:"), 0.0f64, 0.0f64, 1.0f64, 1.0f64);
    msg1(view, sel("addSubview:"), keys);
    px_keys = held(px_keys, keys);
    release(keys);
    px_kb_bar = held(px_kb_bar, px_make_kb_bar());
    // At the accessibility sizes: the judgement's buttons above the
    // toolbar, one under another.
    judge: int = stack(1, 8.0f64);
    msg1(judge, sel("setHidden:"), 1);
    msg1(view, sel("addSubview:"), judge);
    px_judge = held(px_judge, judge);
    guide: int = msg(view, sel("safeAreaLayoutGuide"));
    pin_to(px_seg, "topAnchor", guide, "topAnchor", 8.0f64);
    pin_to(px_seg, "leadingAnchor", view, "leadingAnchor", 16.0f64);
    pin_to(px_seg, "trailingAnchor", view, "trailingAnchor", -16.0f64);
    pin_size(px_seg, "heightAnchor", 32.0f64);
    pin_to(px_tv, "topAnchor", px_seg, "bottomAnchor", 6.0f64);
    pin_to(px_tv, "leadingAnchor", view, "leadingAnchor", 0.0f64);
    pin_to(px_tv, "trailingAnchor", view, "trailingAnchor", 0.0f64);
    kb: int = if (responds(view, "keyboardLayoutGuide")) msg(view, sel("keyboardLayoutGuide")) else guide;
    pin_to(px_tv, "bottomAnchor", kb, "topAnchor", 0.0f64);
    msg1(end, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    pin_to(end, "centerYAnchor", guide, "centerYAnchor", -20.0f64);
    pin_to(end, "leadingAnchor", view, "leadingAnchor", 32.0f64);
    pin_to(end, "trailingAnchor", view, "trailingAnchor", -32.0f64);
    pin_to(px_line, "bottomAnchor", guide, "bottomAnchor", -6.0f64);
    pin_to(px_line, "leadingAnchor", view, "leadingAnchor", 16.0f64);
    pin_to(px_line, "trailingAnchor", view, "trailingAnchor", -16.0f64);
    msg1(judge, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 0);
    // (To the sheet's edges, on the page's color; its margins, which take
    // in the safe area, put the buttons where they were.)
    pin_to(judge, "bottomAnchor", view, "bottomAnchor", 0.0f64);
    pin_to(judge, "leadingAnchor", view, "leadingAnchor", 0.0f64);
    pin_to(judge, "trailingAnchor", view, "trailingAnchor", 0.0f64);
    // The first passage, all set before the sheet rises.
    px_typing = def_bool("memoryType");
    px_begin();
    sheet_form(700.0f64, 900.0f64);
    sheet_nav: int = sheet_of(vc, 0);
    msg2(sheet_nav, sel("setToolbarHidden:animated:"), 0, 0);
    msg1(msg(sheet_nav, sel("toolbar")), sel("setTintColor:"), c_icon);
    px_nav = held(px_nav, sheet_nav);
    px_toolbar(false);
    note_num("bible: practice opened, passages ", px_qn);
    over: int = presented();
    if (over != 0) msg3(over, sel("presentViewController:animated:completion:"), sheet_nav,
        1, 0) else present(sheet_nav)
}

// A font as the phone's text size scales it.
px_scaled(font: int): int {
    m: int = msg(cls("UIFontMetrics"), sel("defaultMetrics"));
    if (m == 0) font else msg1(m, sel("scaledFontForFont:"), font)
}

// On the screen: the keyboard back, if typing was on last time.
px_appeared(self: int, cmd: int, animated: int): int {
    _r: int = super1(self, px_class, cmd, animated);
    if (px_typing && px_typing_allowed() && !demo_no_keyboard) px_keyboard(true);
    // (A hardware keyboard on an iPad: the keys Practice's, Â§17.4.1.)
    if (!demo_no_keyboard) px_key_appeared();
    0
}

// ---- the count ----
px_count_item: int = 0;

// "2 of 3" (VoiceOver "Passage 2 of 3"): the session's passages, each
// once (a Not Yet's second try is not counted again: review r9-1 Minor
// 14). With one, no item on the bar's left at all.
px_count_update(passages: bool) {
    if (px_vc == 0) return;
    n: int = 0;
    at: int = 0;
    for x in 0..px_qn {
        if (!px_back[x]) {
            n = n + 1;
            if (x <= px_at) at = n
        }
    }
    if (n > 1 && px_at < px_qn) {
        if (passages) {
            fbuf_n = 0;
            fput_int(at);
            fput_str(" of ");
            fput_int(n);
            msg1(px_count, sel("setText:"), fstring());
            fbuf_n = 0;
            fput_str("Passage ");
            fput_int(at);
            fput_str(" of ");
            fput_int(n);
            msg1(px_count, sel("setAccessibilityLabel:"), fstring());
            msg(px_count, sel("sizeToFit"))
        }
    } else msg1(px_count, sel("setText:"), 0);
    px_count_sync()
}

// The count's item on the bar while it has words, else none (whoever set
// them: a passage, a card, an end).
px_count_sync() {
    if (px_vc == 0 || px_count == 0) return;
    item: int = msg(px_vc, sel("navigationItem"));
    t: int = msg(px_count, sel("text"));
    has: bool = t != 0 && msg(t, sel("length")) > 0;
    left: int = msg(item, sel("leftBarButtonItem"));
    if (has && left != px_count_item) msg2(item, sel("setLeftBarButtonItem:animated:"),
        px_count_item, 0) else if (!has && left != 0) msg2(item, sel("setLeftBarButtonItem:animated:"),
        0, 0);
    if (has && responds(px_count_item, "setHidden:")) msg1(px_count_item, sel("setHidden:"),
        0)
}

// ---- a passage begun ----
px_begin() {
    px_au_stop();
    px_turn = -1;
    px_wash = -1;
    px_line_on = false;
    while (px_at < px_qn && !px_entry_ok(px_q[px_at])) px_at = px_at + 1;
    if (px_at >= px_qn) {
        px_finish();
        return
    }
    // (A card, or a word to read: ios_cards.l8.)
    if (px_q[px_at] < 0) {
        px_i = -1;
        crd_begin(px_q[px_at]);
        return
    }
    if (crd_active) crd_hide();
    i: int = mem_index(px_q[px_at]);
    px_i = i;
    if (mq_state[i] == MS_NEW) {
        memory_open(i, today());
        memory_changed()
    }
    fbuf_n = 0;
    fput_passage(i);
    msg1(px_vc, sel("setTitle:"), fstring());
    px_count_update(true);
    msg1(px_end, sel("setHidden:"), 1);
    msg1(px_tv, sel("setHidden:"), 0);
    msg1(px_seg, sel("setHidden:"), 0);
    if (!mm_text(i)) {
        px_step = PX_WAIT;
        px_wait_text();
        return
    }
    if (mq_state[i] == MS_LEARNING) {
        k: int = mq_learned[i];
        if (k >= mpt_n) k = mpt_n - 1;
        if (k > 0) px_set(PX_WARMUP, LV_LETTERS, 0, mpt_w0[k], k) else px_set(PX_NEW,
            LV_FULL, mpt_w0[0], mpt_w1[0], 0)
    } else px_set(PX_REVIEW, mq_level[i], 0, mw_n, 0);
    px_build();
    px_paint(false);
    px_log_step()
}

// The step set: its level, its words, the part; nothing shown yet.
px_set(
    step: int,
    level: int,
    a0: int,
    a1: int,
    part: int
) {
    px_step = step;
    px_level = level;
    px_a0 = a0;
    px_a1 = a1;
    px_part = part;
    for w in 0..mw_n {
        px_shown[w] = false;
        px_help[w] = false;
        px_miss[w] = false;
        px_wrong[w] = false
    }
    px_cur = -1;
    if (px_typing && px_typing_allowed()) px_cur = px_next_word(a0);
    msg1(px_seg, sel("setSelectedSegmentIndex:"), level)
}

px_log_step() {
    if (!diag_on) return;
    fbuf_n = 0;
    fput_str("bible: practice ");
    fput_str(px_step_names[px_step]);
    fput(32);
    mev_n = 0;
    me_ref(px_i);
    for k in 0..mev_n fput(mev[k] as int);
    mev_n = 0;
    fput_str(" words ");
    fput_int(px_a0);
    fput(45);
    fput_int(px_a1);
    fput_str(" at ");
    fput_str(mem_level_ids[px_level]);
    note_ns(fstring())
}

px_step_names: []str = ["warm-up", "warm-up checked", "new part", "new part checked",
    "joined", "joined checked", "review", "review checked", "end", "waiting"];

// An ESV passage whose verses have not come: Â§9.4.6's words.
px_wait_text() {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    keys[0] = k_font;
    values[0] = px_scaled(sans(15.0f64, 0.0f64));
    keys[1] = k_color;
    values[1] = c_faint;
    msg1(s, sel("appendAttributedString:"), attributed_str(nsstring(if (esv_listed()) "Waiting for the ESV\â\€\¦" else "The ESV isn\â\€\™t available. Change this passage\â\€\™s version in its details."),
        nsdictionary(keys, values, 2)));
    msg1(px_tv, sel("setAttributedText:"), s);
    msg1(px_seg, sel("setHidden:"), 1);
    if (px_i >= 0) mm_fetch(px_i);
    px_toolbar(false)
}

// The ESV's verses came: a passage waiting for them shown.
practice_esv_came() {
    if (px_nav == 0 || px_step != PX_WAIT) return;
    px_begin();
    px_toolbar(true)
}

// ---- the text, laid out once ----
px_margin(): f64 {
    // (The sheet's width: the window's on an iPhone; a form sheet's on an
    // iPad, its text at the reader's column, Â§17.3.5.)
    w: f64 = if (px_vc != 0) view_width(msg(px_vc, sel("view"))) else 0.0f64;
    if (w <= 0.0f64) w = view_width(window);
    margin_for(w)
}

px_build() {
    s: int = msg(make("NSMutableAttributedString"), sel("autorelease"));
    // The caption, the version always named; the one-time line under it.
    fbuf_n = 0;
    fput_caption(px_i);
    fput(10);
    keys[0] = k_font;
    values[0] = px_scaled(sans(13.0f64, 0.3f64));
    keys[1] = k_color;
    values[1] = c_faint;
    keys[2] = k_para;
    values[2] = msg(para_style(0, 0.0f64, 0.0f64, 0.0f64, 10.0f64, 1.0f64), sel("autorelease"));
    msg1(s, sel("appendAttributedString:"), attributed_str(fstring(), nsdictionary(keys,
        values, 3)));
    if (px_first_line) {
        values[0] = px_scaled(sans(13.0f64, 0.0f64));
        msg1(s, sel("appendAttributedString:"), attributed_str(nsstring("Read it aloud a few times. Then hide a little more each time.\n"),
            nsdictionary(keys, values, 3)))
    }
    px_base = msg(s, sel("length"));
    // The words, in the reader's styles (no red letters, notes or marks).
    base: int = bytes_address(mt);
    p: int = 0;
    for r in 0..mx_n {
        e: int = mx_end[r];
        if (e > p) {
            style: int = mx_style[r];
            if (style == STYLE_JESUS) style = STYLE_BODY;
            if (style == STYLE_JESUS_CAPS) style = STYLE_CAPS;
            if (style == STYLE_JESUS_SUPPLIED) style = STYLE_SUPPLIED;
            msg1(s, sel("appendAttributedString:"), attributed_str(nsstring_at(base + p,
                e - p), attrs_sp(style, mx_para[r], 0)));
            p = e
        }
    }
    // (Each byte's UTF-16 place.)
    n: int = 0;
    for i in 0..mt_n {
        px_u16[i] = n;
        k: int = mt[i] as int & 255;
        if (k < 128 || k >= 192) n = n + 1;
        if (k >= 240) n = n + 1
    }
    px_u16[mt_n] = n;
    m: f64 = px_margin();
    msg_rect(px_tv, sel("setTextContainerInset:"), 14.0f64, m, 60.0f64, m);
    msg1(px_tv, sel("setAttributedText:"), s);
    msg1_ff(px_tv, sel("setContentOffset:animated:"), 0, 0.0f64, 0.0f64)
}

// ---- colors and underlines: every level, word shown and Check ----
px_clear: int = 0;

px_at16(p: int): int {
    px_base + px_u16[p]
}

px_color(
    storage: int,
    p: int,
    e: int,
    color: int
) {
    if (e > p) msg4(storage, sel("addAttribute:value:range:"), k_color, color, px_at16(p),
        px_at16(e) - px_at16(p))
}

// A solid underline is a thin view of its own under the word, not the
// text's underline: the text's skips the descenders of the letters it
// runs under, clear or not, so a hidden "everyone" or "only" showed a
// gap where its y was. A dotted one (a miss, its word shown) is the text's.
px_underline(
    storage: int,
    p: int,
    e: int,
    color: int,
    dotted: bool
) {
    if (e <= p) return;
    if (!dotted) {
        if (px_ul_n < len(px_ul_b)) {
            px_ul_b[px_ul_n] = p;
            px_ul_e[px_ul_n] = e;
            px_ul_c[px_ul_n] = keep(color);
            px_ul_n = px_ul_n + 1
        }
        return
    }
    msg4(storage, sel("addAttribute:value:range:"), k_underline, nsnumber_int(257),
        px_at16(p), px_at16(e) - px_at16(p));
    msg4(storage, sel("addAttribute:value:range:"), k_underline_color, color, px_at16(p),
        px_at16(e) - px_at16(p))
}

// ---- the underlines' views ----
px_ul_b: []int = new int[8192](0);

px_ul_e: []int = new int[8192](0);

px_ul_c: []int = new int[8192](0);

px_ul_n: int = 0;

// The views, px_ul_tv's subviews (made as wanted, kept while it is).
px_ul_views: []int = new int[8192](0);

px_ul_made: int = 0;

px_ul_tv: int = 0;

px_ul_reset() {
    for k in 0..px_ul_n release(px_ul_c[k]);
    px_ul_n = 0
}

// (The sheet gone: its views let go, before its text view's address can
// be another's.)
px_ul_forget() {
    px_ul_reset();
    px_ul_drop();
    px_ul_tv = 0
}

px_ul_drop() {
    for j in 0..px_ul_made {
        msg(px_ul_views[j], sel("removeFromSuperview"));
        release(px_ul_views[j])
    }
    px_ul_made = 0
}

px_ul_view(k: int): int {
    if (k < 0 || k >= len(px_ul_views)) return 0;
    if (px_ul_tv != px_tv) {
        px_ul_drop();
        px_ul_tv = px_tv
    }
    while (px_ul_made <= k) {
        v: int = make("UIView");
        msg1(v, sel("setUserInteractionEnabled:"), 0);
        msg1(v, sel("setHidden:"), 1);
        msg1(px_tv, sel("addSubview:"), v);
        px_ul_views[px_ul_made] = v;
        px_ul_made = px_ul_made + 1
    }
    px_ul_views[k]
}

px_line_rect: []f64 = new f64[4](0.0f64);

px_glyph_at: []f64 = new f64[4](0.0f64);

// Each underline put under its letters as the text is laid out now (after
// a paint, and whenever the text view's width changes): 1 point thick,
// a tenth of the text's size under the baseline, a line each where a word
// is broken across two.
px_ul_place() {
    // (Not before the text view has its width: laid out at none, every
    // letter would be a line, and a piece.)
    if (px_tv == 0 || view_width(px_tv) < 100.0f64) return;
    lm: int = msg(px_tv, sel("layoutManager"));
    container: int = msg(px_tv, sel("textContainer"));
    msg1(lm, sel("ensureLayoutForTextContainer:"), container);
    l8_msg_hfa(hfa, px_tv, sel("textContainerInset"), 0, 0, 0);
    top: f64 = hfa[0];
    left: f64 = hfa[1];
    below: f64 = em * 0.1f64;
    if (below < 2.0f64) below = 2.0f64;
    n: int = 0;
    glyphs: int = msg(lm, sel("numberOfGlyphs"));
    for k in 0..px_ul_n {
        g: int = px_at16(px_ul_b[k]);
        g1: int = px_at16(px_ul_e[k]);
        if (g1 > glyphs) g1 = g;
        while (g < g1) {
            // (This line's part of it.)
            l8_msg_hfa(px_line_rect, lm, sel("lineFragmentRectForGlyphAtIndex:effectiveRange:"),
                g, 0, 0);
            y0: f64 = px_line_rect[1];
            e: int = g + 1;
            same: bool = true;
            while (same && e < g1) {
                l8_msg_hfa(hfa, lm, sel("lineFragmentRectForGlyphAtIndex:effectiveRange:"),
                    e, 0, 0);
                if (hfa[1] != y0) same = false else e = e + 1
            }
            l8_msg_hfa(px_glyph_at, lm, sel("locationForGlyphAtIndex:"), g, 0, 0);
            l8_msg_hfa(hfa, lm, sel("boundingRectForGlyphRange:inTextContainer:"),
                g, e - g, container);
            v: int = px_ul_view(n);
            msg_rect(v, sel("setFrame:"), left + hfa[0], top + y0 + px_glyph_at[1] + below,
                hfa[2], 1.0f64);
            msg1(v, sel("setBackgroundColor:"), px_ul_c[k]);
            msg1(v, sel("setHidden:"), 0);
            n = n + 1;
            g = e
        }
    }
    for j in n..px_ul_made msg1(px_ul_views[j], sel("setHidden:"), 1)
}

// The sheet laid out: the underlines under their words again.
px_laid_out(self: int, cmd: int): int {
    super0(self, px_class, cmd);
    crd_laid_out();
    px_ul_place();
    0
}

// How word w shows now: 0 whole, 1 its key letter, 2 none.
px_hidden(w: int): int {
    if (w < px_a0 || w >= px_a1 || px_shown[w]) return 0;
    memory_hidden(w, px_level)
}

// The passage's words in mt again, if a list's row laid out another's
// since (the same layout, so every word where it was).
px_sync() {
    if (px_i >= 0 && px_i < mq_n && mm_text_id != mq_id[px_i]) _t: bool = mm_text(px_i)
}

px_paint(fade: bool) {
    px_sync();
    if (px_tv == 0 || px_i < 0 || mw_n == 0) return;
    if (px_clear == 0) px_clear = keep(msg(cls("UIColor"), sel("clearColor")));
    if (fade && !reduce_motion()) fade_layer(msg(px_tv, sel("layer")), 0.2f64);
    storage: int = msg(px_tv, sel("textStorage"));
    msg(storage, sel("beginEditing"));
    all: int = px_at16(mt_n) - px_base;
    msg3(storage, sel("removeAttribute:range:"), k_underline, px_base, all);
    msg3(storage, sel("removeAttribute:range:"), k_underline_color, px_base, all);
    msg3(storage, sel("removeAttribute:range:"), k_background, px_base, all);
    px_ul_reset();
    px_color(storage, 0, mt_n, px_clear);
    learned: int = msg_set_f(c_ink, sel("colorWithAlphaComponent:"), 0.35f64);
    rule: int = msg_set_f(color_hex(t_rule[theme], 1.0f64), sel("colorWithAlphaComponent:"),
        t_rule_alpha[theme] * 2.5f64);
    accent_half: int = msg_set_f(c_accent, sel("colorWithAlphaComponent:"), 0.5f64);
    // The words practised in ink, those learned faint, those not reached
    // not at all (each word with what follows it, to the next).
    for w in 0..px_a1 {
        e: int = if (w + 1 < mw_n) mw_b[w + 1] else mt_n;
        px_color(storage, mw_b[w], e, if (w < px_a0) learned else c_ink)
    }
    // The verses' numbers: faint where the verse is reached.
    for x in 0..mv_n {
        if (mv_num_b[x] >= 0) {
            reached: bool = mv_w0[x] < px_a1;
            e: int = mv_num_e[x];
            if (e < 0) e = mv_num_b[x];
            q: int = e;
            while (q < mt_n && mt_vn[q]) q = q + 1;
            px_color(storage, mv_num_b[x], q, if (!reached) px_clear else if (mv_w1[x] <= px_a0) learned else c_faint)
        }
    }
    // Hidden letters clear, each hidden word underlined; shown ones marked.
    // (The word to type marked only while the keys are up.)
    cur: int = if (px_keyboard_up() || demo_no_keyboard) px_cur else -1;
    for w in px_a0..px_a1 {
        h: int = px_hidden(w);
        x: int = mw_vi[w];
        if (h > 0) {
            from: int = if (h == 2) mw_k[w] else mw_k2[w];
            q: int = from;
            while (q < mw_h2[w]) {
                cp: int = mt_cp(q);
                n: int = mt_cl;
                if (mem_hideable(cp)) px_color(storage, q, q + n, px_clear);
                q = q + n
            }
            color: int = if (w == cur) c_accent else if (x == px_turn) accent_half else rule;
            px_underline(storage, from, mw_h2[w], color, false)
        } else if (x == px_turn) px_underline(storage, mw_k[w], mw_h2[w], accent_half,
            false) else if (px_miss[w]) px_underline(storage, mw_k[w], mw_h2[w], c_accent,
            true) else if (px_help[w]) px_underline(storage, mw_k[w], mw_h2[w], accent_half,
            false) else if (w == cur) px_underline(storage, mw_k[w], mw_h2[w], c_accent,
            false)
    }
    // The verse heard, washed.
    if (px_wash >= 0 && px_wash < mv_n) msg4(storage, sel("addAttribute:value:range:"),
        k_background, c_sel, px_at16(mv_b[px_wash]), px_at16(mv_e[px_wash]) - px_at16(mv_b[px_wash]));
    msg(storage, sel("endEditing"));
    px_ul_place();
    px_access()
}

// ---- taps: a word shown ----
practice_tapped(_self: int, _cmd: int, tap: int): int {
    if (px_tv == 0 || px_step == PX_END || px_step == PX_WAIT || crd_active) return 0;
    l8_msg_hfa(hfa, tap, sel("locationInView:"), px_tv, 0, 0);
    x: f64 = hfa[0];
    y: f64 = hfa[1];
    // (The word under the finger, or one within 6 points.)
    for d in [0.0f64, -6.0f64, 6.0f64] {
        if (px_tap_at(x + d, y)) return 0;
        if (px_tap_at(x, y + d)) return 0
    }
    0
}

px_tap_at(x: f64, y: f64): bool {
    px_sync();
    k: int = char_at(px_tv, x, y) - px_base;
    if (k < 0) return false;
    p: int = px_byte_of(k);
    if (p < 0) return false;
    // A verse's number: its hidden words.
    for v in 0..mv_n {
        if (mv_num_b[v] >= 0 && p >= mv_num_b[v] && p < mv_num_b[v] + 4 && mt_vn[p]) {
            any: bool = false;
            for w in mv_w0[v]..mv_w1[v]
                if (px_hidden(w) > 0) any = true;
            if (any) {
                memory_show_verse(v);
                return true
            }
        }
    }
    for w in px_a0..px_a1 {
        if (p >= mw_b[w] && p < mw_e[w]) {
            if (px_hidden(w) == 0) return false;
            memory_show_word(w);
            return true
        }
    }
    false
}

// The byte of mt at UTF-16 unit k of it (-1: past it).
px_byte_of(k: int): int {
    if (k >= px_u16[mt_n]) return -1;
    lo: int = 0;
    hi: int = mt_n;
    while (hi - lo > 1) {
        mid: int = (lo + hi) / 2;
        if (px_u16[mid] <= k) lo = mid else hi = mid
    }
    lo
}

// Word w shown (a help).
memory_show_word(w: int) {
    if (w < 0 || w >= mw_n || px_hidden(w) == 0) return;
    px_shown[w] = true;
    px_help[w] = true;
    if (w == px_cur) px_cur = px_next_word(w + 1);
    note_num("bible: practice word shown ", w);
    px_paint(true)
}

// Verse x's hidden words shown (each a help).
memory_show_verse(x: int) {
    for w in mv_w0[x]..mv_w1[x] {
        if (px_hidden(w) > 0) {
            px_shown[w] = true;
            px_help[w] = true
        }
    }
    if (px_cur >= 0 && px_shown[px_cur]) px_cur = px_next_word(px_cur);
    px_paint(true)
}

// The helps and misses seen in the words practised.
px_helps(): int {
    n: int = 0;
    for w in px_a0..px_a1
        if (px_help[w]) n = n + 1;
    n
}

px_misses(): int {
    n: int = 0;
    for w in px_a0..px_a1
        if (px_miss[w]) n = n + 1;
    n
}

// ---- the level ----
practice_level(_self: int, _cmd: int, control: int): int {
    px_set_level(msg(control, sel("selectedSegmentIndex")));
    0
}

px_set_level(lv: int) {
    if (lv < 0 || lv > 3 || lv == px_level) return;
    px_level = lv;
    msg1(px_seg, sel("setSelectedSegmentIndex:"), lv);
    // (A review's level is kept for next time.)
    if (px_step == PX_REVIEW && px_i >= 0) {
        mq_level[px_i] = lv;
        save_memory()
    }
    px_paint(true);
    if (px_step == PX_NEW) px_toolbar(true);
    note_num("bible: practice level ", lv)
}

// ---- the main button ----
practice_main(_self: int, _cmd: int, _b: int): int {
    memory_main();
    0
}

// Next (a level on), Check, or what comes after Check.
memory_main() {
    if (crd_active) {
        crd_main();
        return
    }
    px_sync();
    if (px_step == PX_NEW && px_level < LV_BLANK) {
        px_set_level(px_level + 1);
        px_toolbar(true);
        return
    }
    if (px_step == PX_WARMUP || px_step == PX_NEW || px_step == PX_JOINED || px_step == PX_REVIEW) {
        memory_check();
        return
    }
    if (px_step == PX_WARMUP_DONE) {
        k: int = px_part;
        px_set(PX_NEW, LV_FULL, mpt_w0[k], mpt_w1[k], k);
        px_after_step(false);
        return
    }
    if (px_step == PX_NEW_DONE) {
        // Next Verse (or Done): the part learned; joined to the one before.
        k: int = px_part;
        last: bool = k + 1 >= mpt_n;
        memory_part_checked(px_i, mpt_n, today(), time(0));
        memory_changed();
        if (k >= 1) {
            px_set(PX_JOINED, LV_BLANK, mpt_w0[k - 1], mpt_w1[k], k);
            px_after_step(false);
            return
        }
        if (last) {
            px_next_passage();
            return
        }
        px_set(PX_NEW, LV_FULL, mpt_w0[k + 1], mpt_w1[k + 1], k + 1);
        px_after_step(false);
        return
    }
    if (px_step == PX_JOINED_DONE) {
        k: int = px_part;
        if (k + 1 >= mpt_n) {
            px_next_passage();
            return
        }
        px_set(PX_NEW, LV_FULL, mpt_w0[k + 1], mpt_w1[k + 1], k + 1);
        px_after_step(false)
    }
}

// Again: this part from Some.
practice_again(_self: int, _cmd: int, _b: int): int {
    memory_again();
    0
}

memory_again() {
    if (px_step != PX_NEW_DONE) return;
    k: int = px_part;
    px_set(PX_NEW, LV_SOME, mpt_w0[k], mpt_w1[k], k);
    px_after_step(false)
}

px_after_step(_passage: bool) {
    px_paint(true);
    px_toolbar(true);
    // (A new part, or the two joined, brought into sight: it may begin
    // low on the page, under the toolbar.)
    if ((px_step == PX_NEW || px_step == PX_JOINED) && px_a1 > px_a0) msg2(px_tv,
        sel("scrollRangeToVisible:"), px_at16(mw_b[px_a0]), px_at16(mw_e[px_a1 - 1]) - px_at16(mw_b[px_a0]));
    px_log_step()
}

// Check: every word practised shown; then the judgement (review), Again
// and Next Verse (a new part), or Next.
memory_check() {
    if (crd_active) {
        crd_check();
        return
    }
    px_sync();
    for w in px_a0..px_a1 px_shown[w] = true;
    px_cur = -1;
    if (px_step == PX_WARMUP) px_step = PX_WARMUP_DONE else if (px_step == PX_NEW) px_step = PX_NEW_DONE else if (px_step == PX_JOINED) px_step = PX_JOINED_DONE else if (px_step == PX_REVIEW) px_step = PX_REVIEW_DONE;
    if (px_step == PX_WARMUP_DONE) px_part = mq_learned[px_i];
    px_keyboard(false);
    px_au_stop();
    px_paint(true);
    px_toolbar(true);
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: practice checked, helps ");
        fput_int(px_helps());
        fput_str(", misses ");
        fput_int(px_misses());
        if (px_step == PX_REVIEW_DONE) {
            fput_str(", suggested ");
            fput_str(mem_grade_ids[px_suggested()])
        }
        note_ns(fstring())
    }
}

px_suggested(): int {
    memory_suggest(px_helps(), px_misses(), px_a1 - px_a0)
}

// A grade: kept, and on to the next passage (a Not Yet comes once more at
// the end).
practice_grade(_self: int, _cmd: int, b: int): int {
    memory_grade_now(msg(b, sel("tag")));
    0
}

memory_grade_now(g: int) {
    if (crd_active) {
        crd_grade(g);
        return
    }
    if (px_step != PX_REVIEW_DONE || px_i < 0) return;
    // (A Not Yet's second try, at the session's end: nothing changes.)
    if (px_back[px_at]) {
        memory_grade_again(px_i, g, px_helps(), px_misses(), time(0));
        memory_flush()
    } else {
        _c: bool = memory_grade(px_i, g, today(), px_helps(), px_misses(), time(0));
        memory_changed()
    }
    haptic_select();
    if (g == G_NOTYET && !px_back[px_at] && px_qn < len(px_q)) {
        px_q[px_qn] = mq_id[px_i];
        px_back[px_qn] = true;
        px_qn = px_qn + 1
    }
    px_next_passage()
}

// The grade's line, on touch-down: what it would do.
practice_touch(_self: int, _cmd: int, b: int): int {
    memory_touch(msg(b, sel("tag")));
    0
}

memory_touch(g: int) {
    if (crd_active) {
        crd_touch(g);
        return
    }
    if (px_i < 0) return;
    fbuf_n = 0;
    fput_would(px_i, g, today());
    msg1(px_line, sel("setText:"), fstring());
    if (!reduce_motion()) fade_layer(msg(px_line, sel("layer")), 0.15f64);
    px_line_on = true;
    note_ns(fstring())
}

practice_touch_up(_self: int, _cmd: int, _b: int): int {
    msg1(px_line, sel("setText:"), 0);
    px_line_on = false;
    0
}

// On: the next passage cross-fades in, or the end.
px_next_passage() {
    px_at = px_at + 1;
    px_first_line = false;
    if (!reduce_motion()) fade_layer(msg(msg(px_vc, sel("view")), sel("layer")), 0.25f64);
    if (px_nav != 0 && !reduce_motion()) fade_layer(msg(msg(px_nav, sel("navigationBar")),
        sel("layer")), 0.25f64);
    msg1(px_line, sel("setText:"), 0);
    px_begin();
    // (From the judgement row: the items swapped at once, the toolbar
    // cross-faded, rather than the bar's slow morph; review r9-2.)
    if (px_tb_judge) {
        px_tb_judge = false;
        if (px_nav != 0 && !reduce_motion()) fade_layer(msg(msg(px_nav, sel("toolbar")),
            sel("layer")), 0.2f64);
        px_toolbar(false)
    } else px_toolbar(true)
}

// Whether the toolbar holds the judgement row now.
px_tb_judge: bool = false;

// The end: "That's all for today." and the next review.
px_finish() {
    crd_hide();
    px_au_stop();
    px_keyboard(false);
    px_step = PX_END;
    px_i = -1;
    msg1(px_tv, sel("setHidden:"), 1);
    msg1(px_seg, sel("setHidden:"), 1);
    msg1(px_count, sel("setText:"), 0);
    px_count_sync();
    msg1(px_vc, sel("setTitle:"), 0);
    msg1(px_end, sel("setHidden:"), 0);
    msg1(px_end_top, sel("setFont:"), body(em));
    msg1(px_end_top, sel("setTextColor:"), c_ink);
    msg1(px_end_top, sel("setText:"), nsstring("That\â\€\™s all for today."));
    msg1(px_end_bottom, sel("setFont:"), body(em * 0.85f64));
    msg1(px_end_bottom, sel("setTextColor:"), c_faint);
    fbuf_n = 0;
    // (A session of one passage: its own next review, whatever came
    // after a Not Yet.)
    single: int = if (px_one > 0) mem_index(px_one) else -1;
    if (single >= 0 && mq_due[single] >= 0) {
        fput_str("Next review: ");
        if (mq_due[single] <= today()) fput_str("Today") else fput_day_word(mq_due[single],
            today())
    } else _n: bool = fput_next_review(today());
    msg1(px_end_bottom, sel("setText:"), fstring());
    note("bible: practice end");
    note_ns(fstring())
}

// ---- the toolbar ----
px_items: []int = new int[8](0);

px_item(title: str, action: str, done: bool): int {
    b: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithTitle:style:target:action:"),
        nsstring(title), if (done) 2 else 0, app_obj, sel(action)), sel("autorelease"));
    b
}

px_image_item(name: str, action: str, label: str): int {
    b: int = msg(msg4(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithImage:style:target:action:"),
        symbol(name, 17.0f64, 4, 0), 0, app_obj, sel(action)), sel("autorelease"));
    msg1(b, sel("setAccessibilityLabel:"), nsstring(label));
    b
}

px_flex(): int {
    msg(msg3(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithBarButtonSystemItem:target:action:"),
        5, 0, 0), sel("autorelease"))
}

// What the next press of the main button does, as its title.
px_main_title(): str {
    if (px_step == PX_NEW && px_level < LV_BLANK || px_step == PX_WARMUP_DONE) return "Next";
    if (px_step == PX_NEW_DONE || px_step == PX_JOINED_DONE) {
        k: int = px_part;
        last: bool = k + 1 >= mpt_n;
        if (!last) return "Next Verse";
        if (px_at + 1 < px_qn) return "Next Passage";
        return "Done"
    }
    "Check"
}

px_toolbar(animated: bool) {
    if (px_vc == 0) return;
    px_count_sync();
    n: int = 0;
    msg1(px_judge, sel("setHidden:"), 1);
    if (crd_active || px_step == PX_READ_END) {
        crd_toolbar(animated);
        return
    }
    if (px_step == PX_END || px_step == PX_WAIT) {
        msg2(px_vc, sel("setToolbarItems:animated:"), nsarray(px_items, 0), if (animated) 1 else 0);
        return
    }
    if (px_step == PX_REVIEW_DONE) {
        px_judgement(animated);
        return
    }
    playing: bool = px_au_mode != 0;
    px_items[n] = px_image_item(if (px_au_mode == 1) "pause.fill" else "play.fill",
        "practiceListen:", "Listen");
    n = n + 1;
    px_items[n] = px_image_item(if (px_au_mode == 2) "pause.fill" else "repeat", "practiceEcho:",
        "Echo, plays a verse then pauses for you to say it.");
    n = n + 1;
    px_items[n] = px_flex();
    n = n + 1;
    if (px_typing_allowed()) {
        up: bool = px_keyboard_up();
        px_items[n] = px_image_item(if (up) "keyboard.chevron.compact.down" else "keyboard",
            "practiceType:", if (up) "Hide Keyboard" else "Type");
        n = n + 1
    }
    px_items[n] = px_flex();
    n = n + 1;
    if (px_step == PX_NEW_DONE) {
        px_items[n] = px_item("Again", "practiceAgain:", false);
        n = n + 1
    }
    px_items[n] = px_item(px_main_title(), "practiceMain:", true);
    n = n + 1;
    _p: bool = playing;
    msg2(px_vc, sel("setToolbarItems:animated:"), nsarray(px_items, n), if (animated) 1 else 0)
}

// The judgement: Not Yet, Mostly, Knew It, the suggestion tinted; in the
// toolbar's middle, or (the accessibility sizes) stacked above it.
px_judge_titles: []str = ["Not Yet", "Mostly", "Knew It"];

px_judgement(animated: bool) {
    // (A card's: nothing typed to judge by, so none suggested.)
    s: int = if (crd_active) -1 else px_suggested();
    big: bool = ax_size();
    row: int = if (big) px_judge else stack(0, 8.0f64);
    if (big) {
        subs: int = msg(px_judge, sel("arrangedSubviews"));
        while (msg(subs, sel("count")) > 0) {
            v: int = msg(subs, sel("firstObject"));
            msg(v, sel("removeFromSuperview"));
            subs = msg(px_judge, sel("arrangedSubviews"))
        }
    } else msg1(row, sel("setDistribution:"), 1);
    for g in 0..3 {
        config: int = msg(cls("UIButtonConfiguration"), sel(if (g == s) "tintedButtonConfiguration" else "grayButtonConfiguration"));
        msg1(config, sel("setTitle:"), nsstring(px_judge_titles[g]));
        if (g == s) msg1(config, sel("setBaseForegroundColor:"), c_accent) else msg1(config,
            sel("setBaseForegroundColor:"), c_ink);
        if (g == s) msg1(config, sel("setBaseBackgroundColor:"), c_accent);
        b: int = msg2(cls("UIButton"), sel("buttonWithConfiguration:primaryAction:"),
            config, 0);
        msg1(b, sel("setTag:"), g);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("practiceGrade:"),
            64);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("practiceTouch:"),
            1);
        msg3(b, sel("addTarget:action:forControlEvents:"), app_obj, sel("practiceTouchUp:"),
            256 | 128);
        if (g == s) msg1(b, sel("setAccessibilityHint:"), nsstring("Suggested."));
        msg1(row, sel("addArrangedSubview:"), b)
    }
    if (big) {
        // (On the page's color, so that the text under it doesn't show
        // through the buttons' fills.)
        msg1(px_judge, sel("setBackgroundColor:"), c_bg);
        msg1(px_judge, sel("setLayoutMarginsRelativeArrangement:"), 1);
        msg_rect(px_judge, sel("setLayoutMargins:"), 12.0f64, 20.0f64, 8.0f64, 20.0f64);
        msg1(px_judge, sel("setHidden:"), 0);
        msg2(px_vc, sel("setToolbarItems:animated:"), nsarray(px_items, 0), if (animated) 1 else 0);
        // (The text clear of the stack.)
        msg_rect(px_tv, sel("setContentInset:"), 0.0f64, 0.0f64, 220.0f64, 0.0f64);
        return
    }
    w: f64 = (if (px_vc != 0 && view_width(msg(px_vc, sel("view"))) > 0.0f64) view_width(msg(px_vc,
        sel("view"))) else view_width(window)) - 40.0f64;
    if (w > 420.0f64) w = 420.0f64;
    msg_rect(row, sel("setFrame:"), 0.0f64, 0.0f64, w, 36.0f64);
    msg1(row, sel("setTranslatesAutoresizingMaskIntoConstraints:"), 1);
    item: int = msg(msg1(msg(cls("UIBarButtonItem"), sel("alloc")), sel("initWithCustomView:"),
        row), sel("autorelease"));
    if (responds(item, "setHidesSharedBackground:")) msg1(item, sel("setHidesSharedBackground:"),
        1);
    px_items[0] = px_flex();
    px_items[1] = item;
    px_items[2] = px_flex();
    // (Swapped in at once and the row faded in over 0.2 s, so it is there
    // as soon as Check is: the bar's own animation left the toolbar empty
    // for most of a second; review r9-2.)
    msg2(px_vc, sel("setToolbarItems:animated:"), nsarray(px_items, 3), 0);
    if (animated && !reduce_motion()) animate(msg(row, sel("layer")), "opacity", 0.0f64,
        1.0f64, false, 0.2f64);
    px_tb_judge = true
}

// ---- closing ----
practice_done(_self: int, _cmd: int, _b: int): int {
    practice_close(true);
    0
}

// Closed (Done, or swiped away when swiped is false: already going):
// playback and the keyboard stopped; the Library under it shown afresh.
practice_close(dismiss: bool) {
    if (px_nav == 0) return;
    px_au_stop();
    px_keyboard(false);
    sheet_nav: int = px_nav;
    under: int = msg(sheet_nav, sel("presentingViewController"));
    if (dismiss && under != 0) msg2(under, sel("dismissViewControllerAnimated:completion:"),
        1, 0);
    practice_gone();
    if (lib_table != 0) {
        lib_build();
        lib_reload(false);
        lib_toolbar(lib_vc, true)
    }
    learn_pages_refresh();
    note("bible: practice closed")
}

practice_gone() {
    px_au_stop();
    px_ul_forget();
    crd_forget();
    px_nav = held(px_nav, 0);
    px_vc = held(px_vc, 0);
    px_tv = held(px_tv, 0);
    px_seg = held(px_seg, 0);
    px_end = held(px_end, 0);
    px_end_top = held(px_end_top, 0);
    px_end_bottom = held(px_end_bottom, 0);
    px_count = held(px_count, 0);
    px_line = held(px_line, 0);
    px_keys = held(px_keys, 0);
    px_kb_bar = held(px_kb_bar, 0);
    px_judge = held(px_judge, 0);
    px_i = -1;
    px_step = PX_END
}

// Whether the sheet swiped away was Practice's.
practice_is(controller: int): bool {
    px_nav != 0 && controller != 0 && msg(controller, sel("presentedViewController")) == px_nav
}

style_practice() {
    if (px_vc == 0) return;
    msg1(msg(px_vc, sel("view")), sel("setBackgroundColor:"), c_bg);
    msg1(px_tv, sel("setBackgroundColor:"), c_bg);
    msg1(px_count, sel("setTextColor:"), c_faint);
    msg1(px_line, sel("setTextColor:"), c_faint);
    style_cards();
    if (!crd_active && px_i >= 0 && mw_n > 0 && px_step != PX_WAIT) {
        _t: bool = mm_text(px_i);
        px_build();
        px_paint(false)
    }
    if (px_step == PX_END) {
        msg1(px_end_top, sel("setTextColor:"), c_ink);
        msg1(px_end_bottom, sel("setTextColor:"), c_faint)
    }
    px_toolbar(false)
}

// ---- Type: first letters (Â§13.3.6) ----
px_typing_allowed(): bool {
    px_step == PX_WARMUP || px_step == PX_NEW || px_step == PX_JOINED || px_step == PX_REVIEW
}

px_keyboard_up(): bool {
    px_keys != 0 && (msg(px_keys, sel("isFirstResponder")) & 255) != 0
}

practice_type(_self: int, _cmd: int, _b: int): int {
    up: bool = px_keyboard_up();
    px_typing = !up;
    set_def_bool("memoryType", px_typing);
    px_keyboard(!up);
    0
}

px_keyboard(on: bool) {
    if (px_keys == 0) return;
    if (on) {
        if (px_cur < 0) px_cur = px_next_word(px_a0);
        msg(px_keys, sel("becomeFirstResponder"));
        px_paint(false)
    } else if (px_keyboard_up()) {
        msg(px_keys, sel("resignFirstResponder"));
        px_cur = -1;
        if (px_step != PX_END) px_paint(false)
    }
    px_toolbar(true)
}

// The first word practised from w not shown yet (-1: none).
px_next_word(w: int): int {
    x: int = if (w < px_a0) px_a0 else w;
    while (x < px_a1) {
        if (!px_shown[x]) return x;
        x = x + 1
    }
    -1
}

// A key typed: the current word's key letter shows it; a wrong one once
// fades its underline; twice, it shows as a miss. After the last, Check.
memory_type(k: int) {
    px_sync();
    if (px_cur < 0 || !px_typing_allowed()) return;
    letter: bool = k >= 48 && k <= 57 || k >= 65 && k <= 90 || k >= 97 && k <= 122;
    if (!letter) return;
    w: int = px_cur;
    if (memory_key_is(w, k)) {
        px_shown[w] = true;
        px_cur = px_next_word(w + 1)
    } else if (!px_wrong[w]) {
        px_wrong[w] = true;
        if (!reduce_motion()) fade_layer(msg(px_tv, sel("layer")), 0.15f64);
        return
    } else {
        px_shown[w] = true;
        px_miss[w] = true;
        px_cur = px_next_word(w + 1);
        fbuf_n = 0;
        fput_str("Missed: ");
        for q in mw_k[w]..mw_h2[w] fput(mt[q] as int);
        if ((UIAccessibilityIsVoiceOverRunning() & 255) != 0) UIAccessibilityPostNotification(objc_const("UIAccessibilityAnnouncementNotification"),
            fstring());
        note_ns(fstring())
    }
    if (px_cur < 0) {
        memory_check();
        return
    }
    px_paint(false);
    // (The word being typed kept in sight.)
    msg2(px_tv, sel("scrollRangeToVisible:"), px_at16(mw_b[px_cur]), px_at16(mw_e[px_cur]) - px_at16(mw_b[px_cur]))
}

// The key view's methods (UIKeyInput, and its traits).
keys_insert(_self: int, _cmd: int, text: int): int {
    n: int = nsstring_into(text, link_buf);
    for i in 0..n memory_type(link_buf[i] as int);
    0
}

keys_delete(_self: int, _cmd: int): int {
    0
}

keys_has_text(_self: int, _cmd: int): int {
    0
}

keys_yes(_self: int, _cmd: int): int {
    1
}

keys_ascii(_self: int, _cmd: int): int {
    1
}

keys_no_caps(_self: int, _cmd: int): int {
    0
}

keys_bar(_self: int, _cmd: int): int {
    px_kb_bar
}

// The bar over the keys: the keyboard away.
px_make_kb_bar(): int {
    bar: int = msg_rect(msg(cls("UIToolbar"), sel("alloc")), sel("initWithFrame:"),
        0.0f64, 0.0f64, 320.0f64, 44.0f64);
    px_items[0] = px_flex();
    px_items[1] = px_image_item("keyboard.chevron.compact.down", "practiceType:",
        "Hide Keyboard");
    msg1(bar, sel("setItems:"), nsarray(px_items, 2));
    msg(bar, sel("sizeToFit"));
    msg1(bar, sel("setTintColor:"), c_icon);
    msg(bar, sel("autorelease"))
}

// ---- VoiceOver: a part an element (Â§13.3.8) ----
px_els: []int = new int[128](0);

px_el_next: []int = new int[128](0);

px_el_verse: []int = new int[128](0);

px_el_n: int = 0;

px_rect: []f64 = new f64[4](0.0f64);

px_access() {
    if (px_tv == 0 || (UIAccessibilityIsVoiceOverRunning() & 255) == 0 && !demo_on) return;
    arr: int = msg(cls("NSMutableArray"), sel("array"));
    px_el_n = 0;
    lm: int = msg(px_tv, sel("layoutManager"));
    container: int = msg(px_tv, sel("textContainer"));
    l8_msg_hfa(hfa, px_tv, sel("textContainerInset"), 0, 0, 0);
    top_in: f64 = hfa[0];
    left_in: f64 = hfa[1];
    for k in 0..mpt_n {
        if (mpt_w0[k] < px_a1 && px_el_n < len(px_els)) {
            el: int = msg1(msg(px_el_class, sel("alloc")), sel("initWithAccessibilityContainer:"),
                px_tv);
            px_part_label(k);
            msg1(el, sel("setAccessibilityLabel:"), fstring());
            // (From its verse's number when it begins the verse; a split
            // verse's second half from its own first word.)
            b: int = px_at16(if (mpt_w0[k] == mv_w0[mpt_v0[k]]) mv_b[mpt_v0[k]] else mw_b[mpt_w0[k]]);
            e: int = px_at16(mw_e[mpt_w1[k] - 1]);
            // (Glyphs as characters: the passage has no ligature that
            // matters here, and no attachment.)
            l8_msg_hfa(px_rect, lm, sel("boundingRectForGlyphRange:inTextContainer:"),
                b, e - b, container);
            msg_rect(el, sel("setAccessibilityFrameInContainerSpace:"), px_rect[0] + left_in,
                px_rect[1] + top_in, px_rect[2], px_rect[3]);
            a1: int = custom_action("Show Next Word", "practiceAxNext:");
            a2: int = custom_action("Show Verse", "practiceAxVerse:");
            px_els[px_el_n] = el;
            px_el_next[px_el_n] = a1;
            px_el_verse[px_el_n] = a2;
            one[0] = a1;
            one[1] = a2;
            msg1(el, sel("setAccessibilityCustomActions:"), nsarray(one, 2));
            msg1(arr, sel("addObject:"), el);
            release(el);
            px_el_n = px_el_n + 1
        }
    }
    msg1(px_tv, sel("setAccessibilityElements:"), arr)
}

// Part k's label at the level: the text; "blank" for each hidden word;
// "First letters: T, L, i, m, s"; "Verse 1, hidden".
px_part_label(k: int) {
    fbuf_n = 0;
    any_hidden: bool = false;
    any_shown: bool = false;
    for w in mpt_w0[k]..mpt_w1[k]
        if (px_hidden(w) > 0) any_hidden = true else any_shown = true;
    if (any_hidden && !any_shown && px_level == LV_BLANK) {
        fput_str("Verse ");
        fput_int(mv_v[mpt_v0[k]]);
        if (mpt_v1[k] != mpt_v0[k]) {
            fput_str(" to ");
            fput_int(mv_v[mpt_v1[k]])
        } else {
            // (A verse split in two: which half.)
            x: int = mpt_v0[k];
            if (mpt_w0[k] > mv_w0[x]) fput_str(", second half") else if (mpt_w1[k] < mv_w1[x]) fput_str(", first half")
        }
        fput_str(", hidden");
        return
    }
    if (any_hidden && !any_shown && px_level == LV_LETTERS) {
        fput_str("First letters: ");
        for w in mpt_w0[k]..mpt_w1[k] {
            if (w > mpt_w0[k]) fput_str(", ");
            fput_bytes(mt, mw_k[w], mw_k2[w])
        }
        return
    }
    for w in mpt_w0[k]..mpt_w1[k] {
        if (w > mpt_w0[k]) fput(32);
        if (px_hidden(w) == 2) fput_str("blank") else if (px_hidden(w) == 1) fput_bytes(mt,
            mw_k[w], mw_k2[w]) else fput_bytes(mt, mw_b[w], mw_e[w])
    }
}

// Which part an element or action is (-1: none).
px_el_part(x: int, kind: int): int {
    for k in 0..px_el_n {
        if (kind == 0 && px_els[k] == x || kind == 1 && px_el_next[k] == x || kind == 2 && px_el_verse[k] == x) return k
    }
    -1
}

// Show Next Word in part k (activating its element does too).
px_ax_next_in(k: int): bool {
    if (k < 0) return false;
    for w in mpt_w0[k]..mpt_w1[k] {
        if (px_hidden(w) > 0) {
            memory_show_word(w);
            px_ax_focus(k);
            return true
        }
    }
    false
}

// After a reveal the elements are made again: VoiceOver told, and kept on
// part k's new element (review r9-1 Minor 15).
px_ax_focus(k: int) {
    if (k < 0 || k >= px_el_n) return;
    if ((UIAccessibilityIsVoiceOverRunning() & 255) != 0) UIAccessibilityPostNotification(objc_const("UIAccessibilityLayoutChangedNotification"),
        px_els[k]);
    note_num("bible: practice voiceover focus, part ", k)
}

practice_ax_next(_self: int, _cmd: int, a: int): int {
    if (px_ax_next_in(px_el_part(a, 1))) 1 else 0
}

practice_ax_verse(_self: int, _cmd: int, a: int): int {
    k: int = px_el_part(a, 2);
    if (k < 0) return 0;
    for w in mpt_w0[k]..mpt_w1[k] {
        if (px_hidden(w) > 0) {
            memory_show_verse(mw_vi[w]);
            px_ax_focus(k);
            return 1
        }
    }
    0
}

px_el_activate(self: int, _cmd: int): int {
    if (px_ax_next_in(px_el_part(self, 0))) 1 else 0
}

// ---- Listen and Echo (Â§13.3.7) ----
// What plays: 0 nothing, 1 Listen, 2 Echo; by the player (a recording with
// timings) or the voice; the verses (passage verse indices x0 to x1), the
// one playing, and the source.
px_au_mode: int = 0;

px_au_player: bool = false;

px_au_src: int = 0;

px_au_x0: int = 0;

px_au_x1: int = 0;

px_au_x: int = 0;

// The player: its item's chapter (-1: none), whether it has begun, where
// it is to stop (centiseconds), and the poll.
px_ap: int = 0;

px_ap_c: int = -1;

px_ap_begun: bool = false;

px_ap_from: int = 0;

px_ap_to: int = 0;

px_ap_poll: int = 0;

px_pause_timer: int = 0;

// The voice: its synthesizer and delegate, and when the verse began.
px_synth: int = 0;

px_voice_obj: int = 0;

px_said_at: f64 = 0.0f64;

px_utt: []int = new int[64](0);

practice_listen(_self: int, _cmd: int, _b: int): int {
    memory_listen(1);
    0
}

practice_echo(_self: int, _cmd: int, _b: int): int {
    memory_listen(2);
    0
}

// Listen (1) or Echo (2): started, or (pressed again) stopped.
memory_listen(mode: int) {
    px_sync();
    if (px_i < 0 || mw_n == 0) return;
    if (px_au_mode != 0) {
        was: int = px_au_mode;
        px_au_stop();
        if (was == mode) return
    }
    listen_stop();
    listen_load();
    listen_session_on();
    // The verses: the passage's, or the parts practised now.
    px_au_x0 = mw_vi[px_a0];
    px_au_x1 = mw_vi[px_a1 - 1];
    px_au_x = px_au_x0;
    px_au_mode = mode;
    px_au_src = audio_source(mq_ver[px_i]);
    px_au_player = src_timed(px_au_src);
    for x in px_au_x0..px_au_x1 + 1 {
        c: int = mv_c[x];
        if (!px_au_player || !follows_verses(px_au_src, c) || listen_effective(px_au_src,
            c) != px_au_src) px_au_player = false
    }
    px_now_playing();
    if (px_au_player) px_play_verse(px_au_x0, mode == 1) else px_say_verse(px_au_x0,
        mode == 1);
    px_toolbar(true)
}

px_au_stop() {
    if (px_au_mode == 0 && px_wash < 0 && px_turn < 0) return;
    px_au_mode = 0;
    px_pause_timer = stop_timer(px_pause_timer);
    if (px_ap_poll != 0) {
        msg(px_ap_poll, sel("invalidate"));
        release(px_ap_poll);
        px_ap_poll = 0
    }
    if (px_ap != 0) msg(px_ap, sel("pause"));
    if (px_synth != 0) msg1(px_synth, sel("stopSpeakingAtBoundary:"), 0);
    px_wash = -1;
    px_turn = -1;
    center: int = msg(cls("MPNowPlayingInfoCenter"), sel("defaultCenter"));
    if (center != 0 && !ls_active) msg1(center, sel("setNowPlayingInfo:"), 0);
    if (px_tv != 0 && px_i >= 0) px_paint(false);
    if (px_vc != 0) px_toolbar(true)
}

// A verse's start in its chapter's recording, less 0.3 s; its end (the
// next verse's start, or the chapter's last's end of speech, plus 0.3 s).
px_start(x: int): int {
    n: int = tim_starts(px_au_src, mv_c[x]);
    v: int = mv_v[x];
    if (n < 2 || v < 1 || v > n - 1) return 0;
    t: int = ts[v - 1] - 30;
    if (t < 0) 0 else t
}

px_end_of(x: int): int {
    n: int = tim_starts(px_au_src, mv_c[x]);
    v: int = mv_v[x];
    if (n < 2) return 0;
    if (v < n - 1) return ts[v];
    ts[n - 1] + 30
}

// Verse x played (and, for Listen, on to the passage's end in its
// chapter).
px_play_verse(x: int, on: bool) {
    px_au_x = x;
    c: int = mv_c[x];
    px_ap_from = px_start(x);
    // (Listen: to the last verse of the passage in this chapter.)
    last: int = x;
    if (on) {
        while (last + 1 <= px_au_x1 && mv_c[last + 1] == c) last = last + 1
    }
    px_ap_to = px_end_of(last);
    if (px_ap == 0) {
        px_ap = keep(make("AVPlayer"));
        msg1(px_ap, sel("setAllowsExternalPlayback:"), 0)
    }
    if (px_ap_c != c) {
        url: int = recording_url(px_au_src, c);
        if (url == 0) {
            px_au_player = false;
            px_say_verse(x, on);
            return
        }
        item: int = msg1(cls("AVPlayerItem"), sel("playerItemWithURL:"), url);
        msg1(px_ap, sel("replaceCurrentItemWithPlayerItem:"), item);
        px_ap_c = c
    }
    px_ap_begun = false;
    px_wash = x;
    px_turn = -1;
    px_paint(false);
    fbuf_n = 0;
    fput_str(if (px_au_mode == 1) "bible: memory listen " else "bible: memory echo verse ");
    fput_code_ref(c, mv_v[x]);
    if (on && last > x) {
        fput(45);
        fput_int(mv_v[last])
    }
    fput(32);
    fput_str(src_ids[px_au_src]);
    fput_str(" from ");
    px_put_secs(px_ap_from);
    fput_str(" to ");
    px_put_secs(px_ap_to);
    note_ns(fstring());
    if (px_ap_poll == 0) {
        px_ap_poll = keep(msg_f4(cls("NSTimer"), sel("timerWithTimeInterval:target:selector:userInfo:repeats:"),
            0.1f64, app_obj, sel("practicePoll:"), 0, 1));
        msg2(msg(cls("NSRunLoop"), sel("mainRunLoop")), sel("addTimer:forMode:"),
            px_ap_poll, l8_run_loop_common_modes())
    }
    px_poll_once()
}

px_put_secs(cs: int) {
    fput_int(cs / 100);
    fput(46);
    fput(48 + cs / 10 % 10);
    fput(48 + cs % 10);
    fput_str(" s")
}

practice_poll(_self: int, _cmd: int, _timer: int): int {
    px_poll_once();
    0
}

px_poll_once() {
    if (px_au_mode == 0 || !px_au_player || px_ap == 0) return;
    item: int = msg(px_ap, sel("currentItem"));
    if (item == 0) return;
    if (!px_ap_begun) {
        st: int = msg(item, sel("status"));
        if (st == 2) {
            // (Failed: the voice from this verse.)
            px_au_player = false;
            px_say_verse(px_au_x, px_au_mode == 1);
            return
        }
        if (st != 1) return;
        px_ap_begun = true;
        cm[0] = px_ap_from;
        cm[1] = 100 | 1 << 32;
        cm[2] = 0;
        cm0[0] = 0;
        cm0[1] = 1 | 1 << 32;
        cm0[2] = 0;
        msg3(px_ap, sel("seekToTime:toleranceBefore:toleranceAfter:"), ints_address(cm),
            ints_address(cm0), ints_address(cm0));
        msg(px_ap, sel("play"));
        r: f64 = ap_rates[clamp(def_int("listenRate"), 0, 2)];
        msg_set_f32(px_ap, sel("setRate:"), r as f32);
        return
    }
    val: int = msg1(px_ap, sel("valueForKey:"), nsstring("currentTime"));
    t: int = if (val != 0) cm_read(val) else -1;
    if (t < 0) return;
    // (The verse heard, washed.)
    v: int = audio_verse_at(px_au_src, px_ap_c, t);
    for x in px_au_x0..px_au_x1 + 1 {
        if (mv_c[x] == px_ap_c && mv_v[x] == v && x != px_wash && x >= px_au_x) {
            px_wash = x;
            px_paint(false)
        }
    }
    if (t < px_ap_to) return;
    msg(px_ap, sel("pause"));
    if (px_au_mode == 1) {
        // Listen: the next chapter's part, or the end.
        x: int = px_au_x;
        while (x <= px_au_x1 && mv_c[x] == px_ap_c) x = x + 1;
        if (x <= px_au_x1) {
            px_play_verse(x, true);
            return
        }
        px_au_stop();
        return
    }
    // Echo: the pause, as long as the verse plus 1 s; then the next.
    px_echo_pause(px_ap_to - px_ap_from)
}

// Echo's pause after verse px_au_x (it took cs centiseconds): its
// underlines accent, no wash.
px_echo_pause(cs: int) {
    if (px_ap_poll != 0) {
        msg(px_ap_poll, sel("invalidate"));
        release(px_ap_poll);
        px_ap_poll = 0
    }
    px_wash = -1;
    px_turn = px_au_x;
    px_paint(false);
    secs: f64 = cs as f64 / 100.0f64 + 1.0f64;
    fbuf_n = 0;
    fput_str("bible: memory echo pause ");
    fput_code_ref(mv_c[px_au_x], mv_v[px_au_x]);
    fput_str(" pause ");
    px_put_secs(cs + 100);
    note_ns(fstring());
    px_pause_timer = stop_timer(px_pause_timer);
    px_pause_timer = after_common(secs, "practiceEchoNext:")
}

practice_echo_next(_self: int, _cmd: int, _timer: int): int {
    px_pause_timer = 0;
    if (px_au_mode != 2) return 0;
    px_turn = -1;
    if (px_au_x + 1 > px_au_x1) {
        px_au_stop();
        return 0
    }
    if (px_au_player) px_play_verse(px_au_x + 1, false) else px_say_verse(px_au_x + 1,
        false);
    0
}

// The voice: verse x said (Listen: and the rest after it), in the
// passage's version.
px_say_verse(x: int, on: bool) {
    if (px_synth == 0) {
        listen_frameworks();
        px_synth = make("AVSpeechSynthesizer");
        px_voice_obj = make("L8MemoryVoice");
        msg1(px_synth, sel("setDelegate:"), px_voice_obj)
    }
    msg1(px_synth, sel("stopSpeakingAtBoundary:"), 0);
    px_au_x = x;
    last: int = if (on) px_au_x1 else x;
    was: int = text_cur;
    t: int = mq_ver[px_i];
    if (t == TEXT_ESV) {
        esv_pin_build(mq_id[px_i]);
        t = TEXT_PIN
    }
    text_use(t);
    voice: int = chosen_voice();
    rate: f64 = ls_rates[clamp(def_int("listenRate"), 0, 2)];
    for y in x..last + 1 {
        _n: int = speak_text(mv_c[y], mv_v[y]);
        u: int = msg1(cls("AVSpeechUtterance"), sel("speechUtteranceWithString:"),
            nsstring_of(vt, vt_n));
        if (u != 0) {
            msg_set_f32(u, sel("setRate:"), rate as f32);
            if (voice != 0) msg1(u, sel("setVoice:"), voice);
            msg_set_f(u, sel("setPostUtteranceDelay:"), 0.12f64);
            if (y < len(px_utt)) px_utt[y] = u;
            msg1(px_synth, sel("speakUtterance:"), u)
        }
    }
    text_use(was);
    px_wash = x;
    px_turn = -1;
    px_paint(false);
    fbuf_n = 0;
    fput_str(if (px_au_mode == 1) "bible: memory listen " else "bible: memory echo verse ");
    fput_code_ref(mv_c[x], mv_v[x]);
    if (last > x) {
        fput(45);
        fput_int(mv_v[last])
    }
    fput_str(" voice");
    note_ns(fstring())
}

px_utt_verse(u: int): int {
    for y in px_au_x0..px_au_x1 + 1
        if (y < len(px_utt) && px_utt[y] == u) return y;
    -1
}

voice_began(
    _self: int,
    _cmd: int,
    _synth: int,
    u: int
): int {
    y: int = px_utt_verse(u);
    if (y < 0 || px_au_mode == 0) return 0;
    px_au_x = y;
    px_said_at = CACurrentMediaTime();
    px_wash = y;
    px_turn = -1;
    px_paint(false);
    0
}

voice_finished(
    _self: int,
    _cmd: int,
    _synth: int,
    u: int
): int {
    y: int = px_utt_verse(u);
    if (y < 0 || px_au_mode == 0) return 0;
    if (px_au_mode == 2) {
        took: int = ((CACurrentMediaTime() - px_said_at) * 100.0f64) as int;
        px_echo_pause(took);
        return 0
    }
    if (y >= px_au_x1) px_au_stop();
    0
}

// Now Playing: the passage, its reader and version.
px_now_playing() {
    center: int = msg(cls("MPNowPlayingInfoCenter"), sel("defaultCenter"));
    if (center == 0 || px_i < 0) return;
    fbuf_n = 0;
    fput_caption(px_i);
    // (The caption's reference, without the version.)
    while (fbuf_n > 0 && fbuf[fbuf_n - 1] as int != 32) fbuf_n = fbuf_n - 1;
    if (fbuf_n >= 3) fbuf_n = fbuf_n - 3;
    np_keys[0] = objc_const("MPMediaItemPropertyTitle");
    np_values[0] = fstring();
    np_keys[1] = objc_const("MPMediaItemPropertyArtist");
    np_values[1] = nsstring(src_readers[if (px_au_player) px_au_src else SRC_VOICE]);
    np_keys[2] = objc_const("MPMediaItemPropertyAlbumTitle");
    np_values[2] = nsstring(text_names[mq_ver[px_i]]);
    msg1(center, sel("setNowPlayingInfo:"), nsdictionary(np_keys, np_values, 3));
    if (diag_on) {
        fbuf_n = 0;
        fput_str("bible: memory now playing ");
        n: int = nsstring_into(np_values[0], link_buf);
        for i in 0..n fput(link_buf[i] as int);
        fput_str(", ");
        fput_str(src_readers[if (px_au_player) px_au_src else SRC_VOICE]);
        note_ns(fstring())
    }
}

// The app gone to the background: Practice's audio stops.
practice_backgrounded() {
    if (px_au_mode != 0) px_au_stop()
}

// ---- classes ----
make_practice_classes() {
    px_class = objc_allocateClassPair(cls("UIViewController"), "L8Practice", 0);
    add_method1(px_class, sel("viewDidAppear:"), &px_appeared, "v@:B");
    add_method0(px_class, sel("viewDidLayoutSubviews"), &px_laid_out, "v@:");
    objc_registerClassPair(px_class);
    px_keys_class = objc_allocateClassPair(cls("UIView"), "L8Keys", 0);
    add_method1(px_keys_class, sel("insertText:"), &keys_insert, "v@:@");
    add_method0(px_keys_class, sel("deleteBackward"), &keys_delete, "v@:");
    add_method0(px_keys_class, sel("hasText"), &keys_has_text, "B@:");
    add_method0(px_keys_class, sel("canBecomeFirstResponder"), &keys_yes, "B@:");
    add_method0(px_keys_class, sel("keyboardType"), &keys_ascii, "q@:");
    add_method0(px_keys_class, sel("autocorrectionType"), &keys_ascii, "q@:");
    add_method0(px_keys_class, sel("spellCheckingType"), &keys_ascii, "q@:");
    add_method0(px_keys_class, sel("autocapitalizationType"), &keys_no_caps, "q@:");
    add_method0(px_keys_class, sel("inputAccessoryView"), &keys_bar, "@@:");
    add_protocol(px_keys_class, "UIKeyInput");
    objc_registerClassPair(px_keys_class);
    px_el_class = objc_allocateClassPair(cls("UIAccessibilityElement"), "L8PracticePart",
        0);
    add_method0(px_el_class, sel("accessibilityActivate"), &px_el_activate, "B@:");
    objc_registerClassPair(px_el_class);
    k: int = objc_allocateClassPair(cls("NSObject"), "L8MemoryVoice", 0);
    add_method2(k, sel("speechSynthesizer:didStartSpeechUtterance:"), &voice_began,
        "v@:@@");
    add_method2(k, sel("speechSynthesizer:didFinishSpeechUtterance:"), &voice_finished,
        "v@:@@");
    add_protocol(k, "AVSpeechSynthesizerDelegate");
    objc_registerClassPair(k)
}

add_practice_methods(app: int) {
    add_method1(app, sel("practiceDone:"), &practice_done, "v@:@");
    add_method1(app, sel("practiceLevel:"), &practice_level, "v@:@");
    add_method1(app, sel("practiceTapped:"), &practice_tapped, "v@:@");
    add_method1(app, sel("practiceMain:"), &practice_main, "v@:@");
    add_method1(app, sel("practiceAgain:"), &practice_again, "v@:@");
    add_method1(app, sel("practiceGrade:"), &practice_grade, "v@:@");
    add_method1(app, sel("practiceTouch:"), &practice_touch, "v@:@");
    add_method1(app, sel("practiceTouchUp:"), &practice_touch_up, "v@:@");
    add_method1(app, sel("practiceType:"), &practice_type, "v@:@");
    add_method1(app, sel("practiceListen:"), &practice_listen, "v@:@");
    add_method1(app, sel("practiceEcho:"), &practice_echo, "v@:@");
    add_method1(app, sel("practicePoll:"), &practice_poll, "v@:@");
    add_method1(app, sel("practiceEchoNext:"), &practice_echo_next, "v@:@");
    add_method1(app, sel("practiceAxNext:"), &practice_ax_next, "B@:@");
    add_method1(app, sel("practiceAxVerse:"), &practice_ax_verse, "B@:@")
}
