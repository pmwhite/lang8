tag bible;

use_tag std;

// A chapter's height estimated from its records (WEB.md §W3.3, §W1.8),
// without laying it out: its blocks as html.l8 writes them (layout_chapter's
// paragraphs, headings and openers), each one's words broken into lines as
// the browser does, with constants the web measures in the page (calibrate,
// web/table.l8): each kind of block's heights and line widths, and its
// font's characters' widths.
//
// The same scan counts instead (agg mode): each kind's blocks and
// characters in a chapter, the sizes table (tools/sizes.l8) the web
// estimates from before the whole text has come.
import "../core/text.l8";

need "libm.so.6";

// Blocks as html.l8 writes them: the paragraph kinds (PARA_PROSE to
// PARA_VERSE: p.p, q1, q2, l1, l2, c, rt, vl), then h3.s, h4.ss, p.r, p.d,
// p.m, p.mr, p.ac.
K_S: int = 8;

K_SS: int = 9;

K_R: int = 10;

K_D: int = 11;

K_M: int = 12;

K_MR: int = 13;

K_AC: int = 14;

KS: int = 15;

kind_classes: []str = ["p", "q1", "q2", "l1", "l2", "c", "rt", "vl", "s", "ss", "r",
    "d", "m", "mr", "ac"];

// Each kind's height with one line (its padding included), its line
// height and margin below, the widths its lines have (the first, which a
// hanging indent makes wider, and the rest), and its characters' widths.
k_one: []f64 = new f64[15](0.0f64);

k_lh: []f64 = new f64[15](0.0f64);

k_mb: []f64 = new f64[15](0.0f64);

k_w1: []f64 = new f64[15](300.0f64);

k_w: []f64 = new f64[15](300.0f64);

// The kinds set in the body font share kind 0's widths; the others have
// their own (their fonts and sizes differ).
k_font(k: int): int {
    if (k < K_S) 0 else k
}

// Characters measured: printable ASCII, then the typography the texts use.
EXTRA: []int = [8220, 8221, 8216, 8217, 8212, 8211, 8230, 233, 239, 235, 228, 246,
    252, 225, 237];

NCH: int = 110;

// Widths by font (a kind) and character, in px.
cw_tab: []f64 = new f64[1650](8.0f64);

// A code point's index in a font's widths (-1: not measured).
ch_index(cp: int): int {
    if (cp >= 32 && cp < 127) return cp - 32;
    for i in 0..len(EXTRA)
        if (EXTRA[i] == cp) return 95 + i;
    -1
}

// A gap (a stanza's break, the gap class's padding).
gap_px: f64 = 0.0f64;

// Openers: a chapter's label and number (after the divider), a book's
// first chapter, a book of one chapter, Genesis 1.
O_LABEL: int = 0;

O_FIRST: int = 1;

O_SINGLE: int = 2;

O_GEN: int = 3;

o_h: []f64 = new f64[4](0.0f64);

// ---- breaking a block's words into lines, as the browser does ----
// The block being set: its kind, its lines so far, the width of its line
// so far, and of the word being read (a word joins the line if it fits,
// else starts the next).
e_kind: int = 0;

e_lines: int = 0;

e_line: f64 = 0.0f64;

e_word: f64 = 0.0f64;

e_any: bool = false;

e_start(k: int) {
    e_kind = k;
    e_lines = 0;
    e_line = 0.0f64;
    e_word = 0.0f64;
    e_any = false
}

// Counting instead of setting (agg): a block's characters, each 1.
agg: bool = false;

// What a count found: each kind's blocks and characters, and stanza
// breaks (at GAPS).
GAPS: int = 15;

ag_n: []int = new int[16](0);

ag_ch: []f64 = new f64[16](0.0f64);

e_width(cp: int): f64 {
    if (agg) return 1.0f64;
    i: int = ch_index(cp);
    f: int = k_font(e_kind);
    if (i < 0) cw_tab[f * NCH + 78] else cw_tab[f * NCH + i]
}

// The word read so far onto the line (or the next).
e_commit() {
    if (e_word == 0.0f64) return;
    room: f64 = if (agg) 1000000000.0f64 else if (e_lines == 0) k_w1[e_kind] else k_w[e_kind];
    space: f64 = if (e_line == 0.0f64) 0.0f64 else if (agg) 1.0f64 else cw_tab[k_font(e_kind) * NCH];
    if (e_line > 0.0f64 && e_line + space + e_word > room + 0.5f64) {
        e_lines = e_lines + 1;
        e_line = e_word
    } else e_line = e_line + space + e_word;
    e_word = 0.0f64;
    e_any = true
}

// Text from b's p to e into the block, a width scale for small or capital
// text (a verse's number, LORD).
e_text(
    b: []i8,
    p: int,
    e: int,
    scale: f64
) {
    i: int = p;
    while (i < e) {
        k: int = b[i] as int & 255;
        cp: int = k;
        n: int = 1;
        if (k >= 240) {
            cp = 0;
            n = 4
        } else if (k >= 224) {
            cp = (k & 15) << 12 | (b[i + 1] as int & 63) << 6 | b[i + 2] as int & 63;
            n = 3
        } else if (k >= 192) {
            cp = (k & 31) << 6 | b[i + 1] as int & 63;
            n = 2
        }
        if (cp == 32) e_commit() else {
            // (LORD and GOD set in small capitals after their first letter.)
            d: int = divine_at(i, e);
            if (d > 0) {
                e_word = e_word + e_width(cp) * scale;
                for j in i + 1..i + d e_word = e_word + 0.78f64 * scale * e_width(b[j] as int);
                i = i + d - 1;
                n = 1
            } else e_word = e_word + e_width(cp) * scale
        }
        i = i + n
    }
}

// The block's height (a stanza's break above it if gap).
e_end(gap: bool): f64 {
    e_commit();
    if (agg) {
        ag_n[e_kind] = ag_n[e_kind] + 1;
        ag_ch[e_kind] = ag_ch[e_kind] + e_line;
        if (gap) ag_n[GAPS] = ag_n[GAPS] + 1;
        return 0.0f64
    }
    lines: int = e_lines + 1;
    (if (gap) gap_px else 0.0f64) + k_one[e_kind] + (lines - 1) as f64 * k_lh[e_kind] + k_mb[e_kind]
}

// A block of one record's text, b's p to e.
block_of(k: int, p: int, e: int): f64 {
    e_start(k);
    e_text(bsb, p, e, 1.0f64);
    e_end(false)
}

// A verse's number into the block: small (0.58 em) and joined to the
// word after it.
num_buf: []i8 = new i8[8](0i8);

e_number(v: int) {
    n: int = 0;
    x: int = v;
    while (x > 0) {
        num_buf[n] = (48 + x % 10) trunc i8;
        n = n + 1;
        x = x / 10
    }
    for i in 0..n e_word = e_word + e_width(num_buf[i] as int) * 0.58f64;
    e_word = e_word + e_width(32) * 0.3f64
}

// Chapter c's estimated height, verses on lines of their own if lines: its
// records set as layout_chapter lays them out, their words broken into
// lines with the measured widths.
est_chapter(c: int, lines: bool): f64 {
    b: int = ch_book[c];
    first: bool = ch_num[c] == 1;
    single: bool = book_count[b] == 1;
    h: f64 = o_h[if (c == 0) O_GEN else if (first && single) O_SINGLE else if (first) O_FIRST else O_LABEL];
    p: int = ch_start[c];
    e_ch: int = ch_end[c];
    if (p < 0) return h;
    while (p < e_ch && (bsb[p] as int == 77 || bsb[p] as int == 109)) {
        e: int = line_end(p);
        h = h + block_of(if (bsb[p] as int == 77) K_M else K_MR, p + 1, e);
        p = e + 1
    }
    open: bool = false;
    words: bool = false;
    kind: int = PARA_PROSE;
    gap: bool = false;
    para_gap: bool = false;
    headed: bool = true;
    in_title: bool = false;
    while (p < e_ch) {
        e: int = line_end(p);
        k: int = bsb[p] as int;
        if (k == 87 || k == 73 || k == 74) k = 84;
        if (in_title && k != 70 && k != 100) {
            h = h + e_end(false);
            in_title = false
        }
        if (in_title) {
            if (k == 70) e_word = e_word + e_width(97) * 0.56f64 else e_text(bsb,
                p + 1, e, 1.0f64)
        } else if (k == 80) {
            m: int = bsb[p + 1] as int;
            pk: int = if (m == 49) PARA_Q1 else if (m == 50) PARA_Q2 else if (m == 108) PARA_L1 else if (m == 76) PARA_L2 else if (m == 99) PARA_CENTER else if (m == 114) PARA_RIGHT else PARA_PROSE;
            if (!lines || pk >= PARA_Q1 && pk <= PARA_L2) {
                if (open && words) h = h + e_end(para_gap);
                open = true;
                words = false;
                kind = pk;
                e_start(kind)
            } else if (open && words) e_commit()
        } else if (k == 95) {
            if (!headed) gap = true
        } else if (k == 86 || k == 84 || k == 70) {
            if (!open) {
                open = true;
                words = false;
                e_start(kind)
            }
            if (k == 86) {
                v: int = number_at(p + 1);
                if (lines) {
                    if (words) h = h + e_end(para_gap);
                    words = false;
                    kind = PARA_VERSE;
                    e_start(kind)
                }
                if (!words) para_gap = gap;
                if (words) e_commit();
                if (!lines && v != 1) e_number(v)
            } else if (k == 84) {
                if (!words) para_gap = gap;
                e_text(bsb, p + 1, e, 1.0f64);
                words = true;
                gap = false;
                headed = false
            } else e_word = e_word + e_width(97) * 0.56f64
        } else {
            kk: int = if (k == 83) K_S else if (k == 115) K_SS else if (k == 82) K_R else if (k == 68) K_D else if (k == 77) K_M else if (k == 109) K_MR else if (k == 65) K_AC else -1;
            if (kk >= 0) {
                if (open && words) h = h + e_end(para_gap);
                open = false;
                words = false;
                gap = false;
                headed = true;
                if (kk == K_D) {
                    in_title = true;
                    e_start(K_D);
                    e_text(bsb, p + 1, e, 1.0f64)
                } else h = h + block_of(kk, p + 1, e)
            }
        }
        p = e + 1
    }
    if (in_title) h = h + e_end(false);
    if (open && words) h = h + e_end(para_gap);
    h
}

// Chapter c counted (agg): ag_n and ag_ch.
count_chapter(c: int, lines: bool) {
    for k in 0..16 {
        ag_n[k] = 0;
        ag_ch[k] = 0.0f64
    }
    agg = true;
    _h: f64 = est_chapter(c, lines);
    agg = false
}

// ---- the sizes table (tools/sizes.l8; the web's first estimates) ----
// A line a chapter, in order: "k n chars" for each kind it has, joined by
// commas (kind 15 the stanza breaks, with no characters).
sz_n: []int = new int[19024](0);

sz_ch: []int = new int[19024](0);

sz_ready: bool = false;

// The table read from b's first n bytes.
sizes_read(b: []i8, n: int) {
    c: int = 0;
    p: int = 0;
    while (p < n && c < 1189) {
        e: int = p;
        while (e < n && b[e] as int != 10) e = e + 1;
        q: int = p;
        while (q < e) {
            k: int = 0;
            while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
                k = k * 10 + b[q] as int - 48;
                q = q + 1
            }
            q = q + 1;
            nb: int = 0;
            while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
                nb = nb * 10 + b[q] as int - 48;
                q = q + 1
            }
            q = q + 1;
            ch: int = 0;
            while (q < e && b[q] as int >= 48 && b[q] as int <= 57) {
                ch = ch * 10 + b[q] as int - 48;
                q = q + 1
            }
            q = q + 1;
            if (k < 16) {
                sz_n[c * 16 + k] = nb;
                sz_ch[c * 16 + k] = ch
            }
        }
        c = c + 1;
        p = e + 1
    }
    sz_ready = true
}

// Each kind's average character width (for estimating from counts), set by
// the calibration; and how full a wrapped line is, on average.
avg_cw: []f64 = new f64[15](8.0f64);

WRAP_FILL: f64 = 0.95f64;

extern l8_ceil_e(x: f64): f64 = ceil;

// Chapter c's height from the sizes table alone: each kind's blocks as if
// each had its average length.
est_from_sizes(c: int): f64 {
    b: int = ch_book[c];
    first: bool = ch_num[c] == 1;
    single: bool = book_count[b] == 1;
    h: f64 = o_h[if (c == 0) O_GEN else if (first && single) O_SINGLE else if (first) O_FIRST else O_LABEL];
    for k in 0..KS {
        nb: int = sz_n[c * 16 + k];
        if (nb > 0) {
            wid: f64 = sz_ch[c * 16 + k] as f64 / nb as f64 * avg_cw[k];
            lines: f64 = if (wid <= k_w1[k]) 1.0f64 else 1.0f64 + l8_ceil_e((wid - k_w1[k] * WRAP_FILL) / (k_w[k] * WRAP_FILL));
            h = h + nb as f64 * (k_one[k] + (lines - 1.0f64) * k_lh[k] + k_mb[k])
        }
    }
    h + sz_n[c * 16 + GAPS] as f64 * gap_px
}
