tag bible_web;

use_tag std, bible;

// Smooth Bible on the web (SKINS.md): the app (core) in WebAssembly, under
// the page's skin (web/page/skin.js), which draws what it says. Built with
// `l8 wasm --async bw_wait`: main waits for the page (bw_wait) as Android's
// waits for its Java side, so what core keeps is made outside any callback.
// The host is core's (core/host.l8); this gives it the page's primitives:
// a data file (the site's data/HASH/NAME.gz, fetched by the page), a GET
// (the site's Worker), the browser's storage for what is kept, and the
// lines to and from the skin.
import "../core/host.l8";

// The page waits for what to send (a pause: the module unwinds to it).
extern bw_wait(): int;

// What it has sent, into buf (at most cap bytes, whole lines).
extern bw_take(buf: []i8, cap: int): int;

// Lines to it: n bytes of b from start.
extern bw_say(b: []i8, start: int, n: int): int;

// Data file name (b, start to end) asked for, as ID.
extern bw_ask(id: int, b: str): int;

// File ID, as it came, into out (its whole length).
extern bw_file(id: int, out: []i8): int;

// The browser's storage, by name (b, start to end): read into out (its
// whole length, -1 none), written, deleted.
extern bw_store_get(
    b: []i8,
    start: int,
    end: int,
    out: []i8
): int;

extern bw_store_set(
    b: []i8,
    start: int,
    end: int,
    v: []i8,
    n: int
): int;

extern bw_store_remove(b: []i8, start: int, end: int): int;

// A GET of the address (b's first n bytes), as id: its answer comes as
// `http ID STATUS SIZE`, its body file ID's.
extern bw_http(id: int, b: []i8, n: int): int;

// ---- what is kept (core/kept.l8's), a key each ----
web_read() {
    n: int = bw_store_get(kp_name, 0, kp_name_n, fbuf);
    fbuf_n = (if (n < 0) 0 else if (n > len(fbuf)) len(fbuf) else n)
}

web_write() {
    _n: int = bw_store_set(kp_name, 0, kp_name_n, fbuf, fbuf_n)
}

// (Added to: what is there read, fbuf's put after it, written. fbuf is
// the store's only room, so what is added goes first, then is moved.)
web_append() {
    add: int = fbuf_n;
    if (add <= 0) return;
    k: []i8 = new i8[add](0i8);
    for i in 0..add k[i] = fbuf[i];
    web_read();
    for i in 0..add {
        if (fbuf_n < len(fbuf)) {
            fbuf[fbuf_n] = k[i];
            fbuf_n = fbuf_n + 1
        }
    }
    web_write()
}

web_remove() {
    _n: int = bw_store_remove(kp_name, 0, kp_name_n)
}

// ---- the primitives core's host asks for ----
web_ask(id: int, name: str) {
    _a: int = bw_ask(id, name)
}

web_http(id: int, b: []i8, n: int) {
    _h: int = bw_http(id, b, n)
}

web_file(id: int, out: []i8): int {
    bw_file(id, out)
}

web_say(b: []i8, start: int, n: int) {
    _s: int = bw_say(b, start, n)
}

main() noregion: int {
    kept_store = KeptStore {
        read: &web_read,
        write: &web_write,
        append: &web_append,
        remove: &web_remove
    };
    host_io = HostIO {
        ask: &web_ask,
        http: &web_http,
        file: &web_file,
        say: &web_say
    };
    hs_start();
    sk_device = "Device";
    sk_follows_text_size = false;
    hs_notify_off = "Notifications are blocked for this site. Allow them in your browser\â\€\™s site settings, then turn this on again.";
    while (true) {
        _w: int = bw_wait();
        n: int = bw_take(hs_inbox, len(hs_inbox));
        if (n > 0) {
            hs_lines(n);
            hs_after()
        }
    }
    0
}
