tag bible_html_tests;

use_tag std, bible;

// The text as HTML (html.l8): chapters' markup, every chapter of every
// bundled version well formed, every verse there, escaping, and the
// reader's addresses.
import "../../../stdlib/print.l8";

import "../core/text.l8";

import "html.l8";

import "estimate.l8";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

read_n: int = 0;

read_into(path: str): []i8@new {
    fd: int = open(path, 0, 0);
    n: int = 8388608;
    buf: []i8 = new i8[n](0i8);
    got: int = 0;
    more: bool = fd >= 0;
    while (more && got < n) {
        r: int = read(fd, buf, got, n - got);
        if (r <= 0) more = false else got = got + r
    }
    if (fd >= 0) close(fd);
    read_n = got;
    buf
}

load_version(t: int, path: str) noregion {
    if (tx_ready[t]) {
        text_use(t);
        return
    }
    buf: []i8 = read_into(path);
    if (t == 0) {
        bsb = buf;
        text_use(0)
    }
    text_load(t, buf, read_n);
    text_use(t)
}

load() noregion {
    load_version(0, "programs/bible/data/bsb.txt")
}

// hb from p to e, as it is.
show(p: int, e: int) raises IoError {
    write_bytes_n(1, part(p, e), e - p)
}

part_buf: []i8 = new i8[1048576](0i8);

part(p: int, e: int): []i8 {
    for i in p..e part_buf[i - p] = hb[i];
    part_buf
}

// The first n lines of hb.
lines(n: int) raises IoError {
    e: int = 0;
    k: int = 0;
    while (e < hb_n && k < n) {
        if (hb[e] as int == 10) k = k + 1;
        e = e + 1
    }
    show(0, e)
}

// The lines of hb that contain s (the first most of them).
grep(s: str, most: int) raises IoError {
    p: int = 0;
    shown: int = 0;
    while (p < hb_n && shown < most) {
        e: int = p;
        while (e < hb_n && hb[e] as int != 10) e = e + 1;
        if (has(p, e, s)) {
            show(p, e);
            print("");
            shown = shown + 1
        }
        p = e + 1
    }
}

has(p: int, e: int, s: str): bool {
    for i in p..e - len(s) + 1 {
        same: bool = true;
        for k in 0..len(s)
            if (hb[i + k] != s[k]) same = false;
        if (same) return true
    }
    false
}

chapter(c: int) {
    hb_n = 0;
    html_chapter(0, c, false)
}

test "John 3" {
    load();
    chapter(book_first[42] + 2);
    lines(3);
    expect {|
        <article class="ch" data-c="999" data-b="JHN" data-n="3" aria-labelledby="h999">
        <hr class="div">
        <h2 class="op" id="h999"><span class="lb">John</span> <span class="nm">3</span></h2>
    |}
    grep("Nicodemus", 2);
    expect {|
        <h3 class="s">Jesus and Nicodemus</h3>
        <p class="p"><span class="v" data-v="1">Now there was a man of the Pharisees named Nicodemus, a leader of the Jews.</span> <span class="v" data-v="2"><span class="vn">2 </span>He came to Jesus at night and said, “Rabbi, we know that You are a teacher who has come from God. For no one could perform the signs You are doing if God were not with him.”</span></p>
    |}
    grep("class=\"r\"", 1);
    expect {|
        <p class="r">(<a class="ref" href="/read/bsb/genesis/22#1-10" data-act="ref">Genesis 22:1–10</a>; <a class="ref" href="/read/bsb/romans/5#6-11" data-act="ref">Romans 5:6–11</a>)</p>
    |}
    grep("data-v=\"16\"", 1);
    expect {|
        <p class="p"><span class="v" data-v="16"><span class="vn">16 </span><span class="j">For God so loved the world that He gave His one and only</span><a class="fn" href="#f999-5" data-act="fn" data-f="5" role="button" aria-label="Footnote">e</a> <span class="j">Son, that everyone who believes in Him shall not perish but have eternal life.</span></span> <span class="v" data-v="17"><span class="vn">17 </span><span class="j">For God did not send His Son into the world to condemn the world, but to save the world through Him.</span></span> <span class="v" data-v="18"><span class="vn">18 </span><span class="j">Whoever believes in Him is not condemned, but whoever does not believe has already been condemned, because he has not believed in the name of God’s one and only Son.</span></span></p>
    |}
    grep("<li", 3);
    expect {|
        <li id="f999-1"><b class="fl">a</b> John 3:3 Or born from above; also in verse 7.</li>
        <li id="f999-2"><b class="fl">b</b> John 3:7 The Greek word for you is plural; also in verse 12.</li>
        <li id="f999-3"><b class="fl">c</b> John 3:13 BYZ and TR include who is in heaven.</li>
    |}
}

test "openers" {
    load();
    for c in [0, book_first[18], book_first[18] + 41, book_first[64], book_first[18] + 2] {
        chapter(c);
        grep("class=\"op\"", 1);
        grep("class=\"m", 2)
    }
    expect {|
        <h2 class="op" id="h0"><span class="bk">Genesis</span> <span class="nm one">1</span></h2>
        <h2 class="op" id="h478"><span class="bk">Psalms</span> <span class="nm one">1</span></h2>
        <p class="m">BOOK I</p>
        <p class="mr">Psalms 1–41</p>
        <h2 class="op" id="h519"><span class="lb">Psalm</span> <span class="nm">42</span></h2>
        <p class="m">BOOK II</p>
        <p class="mr">Psalms 42–72</p>
        <h2 class="op" id="h1166"><span class="bk">Jude</span></h2>
        <h2 class="op" id="h480"><span class="lb">Psalm</span> <span class="nm">3</span></h2>
    |}
}

test "poetry, a psalm's title and the divine name" {
    load();
    chapter(book_first[18] + 22);
    grep("class=\"d\"", 1);
    grep("shepherd", 1);
    expect {|
        <p class="d">A Psalm of David.</p>
        <p class="q1"><span class="v" data-v="1">The L<span class="sc">ORD</span> is my shepherd;<a class="fn" href="#f500-1" data-act="fn" data-f="1" role="button" aria-label="Footnote">a</a></span></p>
    |}
    chapter(book_first[18] + 2);
    grep("class=\"d\"", 1);
    grep("gap", 1);
    expect {|
        <p class="d">A Psalm of David, when he fled from his son Absalom.</p>
        <p class="q1 gap"><span class="v" data-v="7"><span class="vn">7 </span>Arise, O L<span class="sc">ORD</span>!</span></p>
    |}
}

test "verse on a line of its own" {
    load();
    hb_n = 0;
    html_chapter(0, book_first[42] + 2, true);
    grep("data-v=\"16\"", 1);
    expect {|
        <p class="vl"><span class="v" data-v="16"><span class="vn">16</span><span class="j">For God so loved the world that He gave His one and only</span><a class="fn" href="#f999-5" data-act="fn" data-f="5" role="button" aria-label="Footnote">e</a> <span class="j">Son, that everyone who believes in Him shall not perish but have eternal life.</span></span></p>
    |}
}

// Whether hb is well formed: every element closed in order (but hr), and
// every verse of the chapter there. The count of elements, or -1.
elements: int = 0;

stack: []int = new int[64](0);

well_formed(c: int): bool {
    depth: int = 0;
    i: int = 0;
    elements = 0;
    while (i < hb_n) {
        if (hb[i] as int == 60) {
            closing: bool = hb[i + 1] as int == 47;
            n0: int = if (closing) i + 2 else i + 1;
            n1: int = n0;
            while (n1 < hb_n && hb[n1] as int != 32 && hb[n1] as int != 62) n1 = n1 + 1;
            tag: int = name_code(n0, n1);
            if (closing) {
                if (depth == 0 || stack[depth - 1] != tag) return false;
                depth = depth - 1
            } else if (tag != name_code_s("hr")) {
                if (depth >= len(stack)) return false;
                stack[depth] = tag;
                depth = depth + 1;
                elements = elements + 1
            }
            while (i < hb_n && hb[i] as int != 62) i = i + 1
        } else if (hb[i] as int == 38) {
            // (An entity: one of ours.)
            if (!(has(i, i + 5, "&amp;") || has(i, i + 4, "&lt;") || has(i, i + 4,
                "&gt;") || has(i, i + 6, "&quot;") || has(i, i + 5, "&#39;"))) return false
        }
        i = i + 1
    }
    if (depth != 0) return false;
    for v in 1..ch_verses[c] + 1 {
        if (text_has(text_cur, c, v) && !has_verse_key(v)) return false
    }
    true
}

has_verse_key(v: int): bool {
    for k in 0..verse_count
        if (verse_num[k] == v) return true;
    false
}

name_code(p: int, e: int): int {
    n: int = 0;
    for i in p..e n = n * 128 + (hb[i] as int & 127);
    n
}

name_code_s(s: str): int {
    n: int = 0;
    for c in s n = n * 128 + (c as int & 127);
    n
}

test "every chapter of every version, well formed" {
    load();
    load_version(1, "programs/bible/data/kjv.txt");
    load_version(2, "programs/bible/data/web.txt");
    load_version(3, "programs/bible/data/asv.txt");
    load_version(4, "programs/bible/data/ylt.txt");
    for t in 0..5 {
        text_use(t);
        bad: int = 0;
        most: int = 0;
        total: int = 0;
        for c in 0..chapters {
            for lines in [false, true] {
                hb_n = 0;
                html_chapter(t, c, lines);
                if (!well_formed(c)) {
                    if (bad < 3) {
                        write(1, "bad: ");
                        write_int(1, c);
                        print("")
                    }
                    bad = bad + 1
                }
                if (hb_n > most) most = hb_n;
                if (!lines) total = total + hb_n
            }
        }
        write(1, text_abbrs[t]);
        write(1, ": ");
        write_int(1, bad);
        write(1, " bad, largest ");
        write_int(1, most / 1024);
        write(1, " KB, all ");
        write_int(1, total / 1048576);
        print(" MB")
    }
    text_use(0);
    expect {|
        BSB: 0 bad, largest 37 KB, all 8 MB
        KJV: 0 bad, largest 35 KB, all 8 MB
        WEB: 0 bad, largest 36 KB, all 7 MB
        ASV: 0 bad, largest 38 KB, all 6 MB
        YLT: 0 bad, largest 26 KB, all 6 MB
    |}
}

test "escaping" {
    hb_n = 0;
    h_text_s("<img src=x onerror=alert(1)> & \"><script>'");
    show(0, hb_n);
    print("");
    expect {|
        &lt;img src=x onerror=alert(1)&gt; &amp; &quot;&gt;&lt;script&gt;&#39;
    |}
}

test "addresses" {
    load();
    hb_n = 0;
    h_chapter_url(0, book_first[61] + 2, 16, 0);
    h_byte(32);
    h_chapter_url(2, book_first[21], 1, 3);
    h_byte(32);
    h_chapter_url(4, book_first[0] + 49, 0, 0);
    show(0, hb_n);
    print("");
    expect {|
        /read/bsb/1-john/3#16 /read/web/song-of-solomon/1#1-3 /read/ylt/genesis/50
    |}
    slug: []i8 = new i8[32](0i8);
    for s in ["1-john", "Song-of-Solomon", "john", "jn"] {
        for i in 0..len(s) slug[i] = s[i];
        write(1, " ");
        write_int(1, book_of_slug(slug, 0, len(s)))
    }
    print("");
    expect {|
         61 21 42 -1
    |}
}

test "the book index" {
    load();
    hb_n = 0;
    html_books(0);
    grep("Obadiah", 1);
    write_int(1, hb_n / 1024);
    print(" KB");
    expect {|
        <section><h2>Obadiah</h2><ol><li><a href="/read/bsb/obadiah/1">1</a></li></ol></section>
        55 KB
    |}
}

// The sizes table's counts (estimate.l8, tools/sizes.l8): each kind's
// blocks, as counted from the records, are the elements html.l8 writes for
// the chapter laid out, in every chapter of the BSB.
count_class(cls: str): int {
    // (Opening tags with exactly this class: <p class="q1"> or "q1 gap".)
    n: int = 0;
    for i in 0..hb_n - len(cls) - 10 {
        if (hb[i] as int == 60 && has(i, i + 10 + len(cls), "class=\"")) {
            at: int = i;
            while (at < hb_n && hb[at] as int != 34) at = at + 1;
            if (at + 1 + len(cls) < hb_n && has(at + 1, at + 1 + len(cls), cls)) {
                k: int = hb[at + 1 + len(cls)] as int;
                if (k == 34 || k == 32) n = n + 1
            }
        }
    }
    n
}

test "the sizes table counts what is laid out" {
    load();
    bad: int = 0;
    for c in 0..chapters {
        hb_n = 0;
        html_chapter(0, c, false);
        count_chapter(c, false);
        for k in 0..KS {
            // (The headings' tags differ: h3.s, h4.ss.)
            got: int = count_class(kind_classes[k]);
            if (got != ag_n[k]) {
                if (bad < 5) {
                    write_int(1, c);
                    write(1, " ");
                    write(1, kind_classes[k]);
                    write(1, " ");
                    write_int(1, got);
                    write(1, " ");
                    write_int(1, ag_n[k]);
                    print("")
                }
                bad = bad + 1
            }
        }
    }
    write_int(1, bad);
    print(" kinds counted otherwise");
    expect {|
        0 kinds counted otherwise
    |}
}
