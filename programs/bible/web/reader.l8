tag bible_web;

use_tag std, bible, dom;

// The reader on the web (WEB.md ยงW3): the scroller, the window of
// chapters, the bar, the place, the title and address, and footnotes.
//
// The document scrolls, and holds the whole Bible (ยงW3.3): a spacer as tall
// as the height table says, each chapter near the place written as an
// <article> at its place in it (html.l8's), the rest shown by placeholders
// (each chapter's opener on ruled lines). Nothing is ever moved to make up
// for content: content is put where the scroll position says it is, and a
// measured height moves only chapters away from the place. The scroll
// position is written only at the first placement, a jump, a relayout and
// trimming the slack above Genesis 1, each logged.
import "../core/text.l8";

import "html.l8";

import "../../web/dom.l8";

import "table.l8";

// The page's parts.
r_main: int = 0;

r_bar: int = 0;

r_title: int = 0;

// The title's two texts, one shown (r_t_on), for the cross-fade.
r_t: []int = new int[2](0);

r_t_on: int = 0;

// The text read (TEXT_BSB ...), and its verses on lines of their own.
r_text: int = 0;

r_lines: bool = false;

// ---- a writer for addresses, titles and states ----
wb: []i8 = new i8[1024](0i8);

wb_n: int = 0;

w_byte(c: int) {
    if (wb_n < len(wb)) {
        wb[wb_n] = c trunc i8;
        wb_n = wb_n + 1
    }
}

w_str(s: str) {
    for c in s w_byte(c as int)
}

w_int(n: int) {
    if (n < 0) {
        w_byte(45);
        w_int(0 - n);
        return
    }
    if (n >= 10) w_int(n / 10);
    w_byte(48 + n % 10)
}

// x with three decimals (0.250).
w_f3(x: f64) {
    if (x < 0.0f64) {
        w_byte(45);
        w_f3(0.0f64 - x);
        return
    }
    m: int = (x * 1000.0f64 + 0.5f64) as int;
    w_int(m / 1000);
    w_byte(46);
    w_byte(48 + m / 100 % 10);
    w_byte(48 + m / 10 % 10);
    w_byte(48 + m % 10)
}

// Chapter c's name: John 3, Psalm 23, Jude.
w_title(c: int) {
    b: int = ch_book[c];
    if (book_is(b, "PSA")) w_str("Psalm") else {
        for i in book_name_start(b)..book_name_end(b) w_byte(bsb[i] as int)
    }
    if (book_count[b] > 1) {
        w_byte(32);
        w_int(ch_num[c])
    }
}

// Chapter c's address: /read/bsb/john/3, and #v if v > 0.
w_url(c: int, v: int) {
    w_str("/read/");
    for k in text_abbrs[r_text] w_byte(lower(k as int));
    w_byte(47);
    b: int = ch_book[c];
    for i in book_name_start(b)..book_name_end(b) {
        k: int = bsb[i] as int;
        w_byte(if (k == 32) 45 else lower(k))
    }
    w_byte(47);
    w_int(ch_num[c]);
    if (v > 0) {
        w_byte(35);
        w_int(v)
    }
}

// A number from b's p on (its digits), and where they end (num_end).
num_end: int = 0;

num_at(b: []i8, p: int, e: int): int {
    n: int = 0;
    i: int = p;
    while (i < e && b[i] as int >= 48 && b[i] as int <= 57) {
        n = n * 10 + b[i] as int - 48;
        i = i + 1
    }
    num_end = i;
    n
}

// A fraction (0.250) from b's p on.
frac_at(b: []i8, p: int, e: int): f64 {
    whole: int = num_at(b, p, e);
    x: f64 = whole as f64;
    i: int = num_end;
    if (i < e && b[i] as int == 46) {
        scale: f64 = 0.1f64;
        i = i + 1;
        while (i < e && b[i] as int >= 48 && b[i] as int <= 57) {
            x = x + scale * (b[i] as int - 48) as f64;
            scale = scale / 10.0f64;
            i = i + 1
        }
    }
    num_end = i;
    x
}

// ---- measures ----
box: []f64 = new f64[8](0.0f64);

rects: []f64 = new f64[8192](0.0f64);

abuf: []i8 = new i8[256](0i8);

scroll_y: f64 = 0.0f64;

view_w: f64 = 0.0f64;

view_h: f64 = 0.0f64;

// The expanded bar's height (with the top safe area): the reading line is
// just under it.
bar_h: f64 = 44.0f64;

measure() {
    dom_scroll(DOM_WINDOW, box);
    scroll_y = box[1];
    view_w = box[4];
    view_h = box[5];
    bar_h = dom_get_prop(r_bar, "offsetHeight")
}

reading_y(): f64 {
    bar_h + 1.0f64
}

// px into wb (for a style).
w_px(x: f64) {
    wb_n = 0;
    w_f3(x);
    w_str("px")
}

// ---- writing the scroll position (ยงW3.3 item 6) ----
// Only at the first placement, a jump, a relayout and trimming the slack above
// Genesis 1; each logged with its reason (the CI fails on one made while
// a finger is down or the page moves), and seen by the bar as its own, not
// the reader's.
writes: int = 0;

scroll_write(y: f64, reason: str) {
    dom_scroll(DOM_WINDOW, box);
    y0: f64 = box[1];
    if (y == y0) return;
    dom_scroll_to(DOM_WINDOW, 0.0f64, y, 0);
    dom_scroll(DOM_WINDOW, box);
    last_y = last_y + box[1] - y0;
    scroll_y = box[1];
    writes = writes + 1;
    wb_n = 0;
    w_str("scroll write: ");
    w_str(reason);
    w_str(if (finger_down) " (finger down)" else "");
    dom_log_of(wb, 0, wb_n);
    dom_set_prop(DOM_WINDOW, "sbWrites", writes as f64);
    dom_set_prop_of(DOM_WINDOW, "sbLastWrite", wb, 14, wb_n)
}

// ---- the scroller (ยงW3.3) ----
// The chapters this scroller holds (the whole Bible, or a testament or a
// book past the size limit), its spacer, the placeholders' layer, the
// links across its ends and at the window's ends.
sc_first: int = 0;

sc_last: int = 0;

r_bible: int = 0;

r_phs: int = 0;

r_cont_up: int = 0;

r_cont_down: int = 0;

r_across: int = 0;

// The space after Revelation 22 (DESIGN.md ยง2.4), and after a scroller's
// last chapter otherwise (for its link across).
END_PAD: f64 = 120.0f64;

// Browsers cap an element's height; past this the scroller holds less.
MOST_PX: f64 = 12000000.0f64;

// Where the scroller's top is in the document.
sp_top: f64 = 0.0f64;

measure_sp() {
    dom_rect(r_bible, box);
    sp_top = box[1] + scroll_y
}

// A place in the view as a place in the scroller.
table_y(view_y: f64): f64 {
    scroll_y + view_y - sp_top
}

// The chapter at table position y (the nearest at either end).
chapter_at_t(y: f64): int {
    lo: int = sc_first;
    hi: int = sc_last;
    while (lo < hi) {
        mid: int = (lo + hi + 1) / 2;
        if (pos[mid] <= y) lo = mid else hi = mid - 1
    }
    lo
}

// The chapter at y in the view.
chapter_at(y: f64): int {
    chapter_at_t(table_y(y))
}

// Every chapter's top from its height, from the scroller's first (whose
// top is the slack above it).
pos_from(slack: f64) {
    pos[sc_first] = slack;
    for c in sc_first..sc_last + 1 pos[c + 1] = pos[c] + ht[c]
}

// The scroller's range for chapter c: the whole Bible, or under the size
// limit its testament, or its book.
choose_range(c: int) {
    total: f64 = 0.0f64;
    for k in 0..chapters total = total + ht[k];
    sc_first = 0;
    sc_last = chapters - 1;
    if (total <= MOST_PX) return;
    nt: int = book_first[39];
    sc_first = (if (c >= nt) nt else 0);
    sc_last = (if (c >= nt) chapters - 1 else nt - 1);
    t: f64 = 0.0f64;
    for k in sc_first..sc_last + 1 t = t + ht[k];
    if (t <= MOST_PX) return;
    b: int = ch_book[c];
    sc_first = book_first[b];
    sc_last = book_first[b] + book_count[b] - 1
}

pxs: []f64 = new f64[1200](0.0f64);

// Placeholders and the spacer's height made to agree with pos, for
// chapters lo to hi (the window's articles separately).
ph_lo: int = 1200;

ph_hi: int = -1;

ph_dirty(lo: int, hi: int) {
    if (lo < ph_lo) ph_lo = lo;
    if (hi > ph_hi) ph_hi = hi
}

ph_flush() {
    if (ph_hi < ph_lo) return;
    if (!phs_now) {
        ph_lo = 1200;
        ph_hi = -1
    }
    lo: int = if (ph_lo < sc_first) sc_first else ph_lo;
    hi: int = if (ph_hi > sc_last) sc_last else ph_hi;
    for c in lo..hi + 1 pxs[c - lo] = pos[c];
    if (hi >= lo) dom_children_px(r_phs, lo - sc_first, "top", pxs, hi - lo + 1);
    ph_lo = 1200;
    ph_hi = -1;
    // (The space left above the scroller's first chapter, at its least: a
    // check that the corrections above never use it all, ยงW3.3.)
    if (!trimming && pos[sc_first] < slack_least) slack_least = pos[sc_first];
    dom_set_prop(DOM_WINDOW, "sbSlackLeast", slack_least);
    w_px(pos[sc_last + 1] + END_PAD);
    dom_set_style_of(r_bible, "height", wb, 0, wb_n);
    if (r_across != 0) {
        w_px(pos[sc_last + 1] + 24.0f64);
        dom_set_style_of(r_across, "top", wb, 0, wb_n)
    }
}

// The scroller made for the current range: its spacer's placeholders (each
// chapter's opener at its place, on ruled lines), its links across.
build_scroller() {
    if (r_bible != 0) {
        dom_remove(r_bible);
        dom_free_tree(r_bible)
    }
    for c in 0..chapters art_h[c] = 0;
    w_first = -1;
    w_last = -1;
    hb_n = 0;
    h_str("<div class=\"bible\"><div class=\"phs\" aria-hidden=\"true\">");
    // (The placeholders come just after the first text is painted:
    // write_placeholders.)
    for c in sc_first..if (phs_now) sc_last + 1 else sc_first {
        h_str("<div class=\"ph\" style=\"top:");
        h_int(pos[c] as int);
        h_str("px\"><span>");
        b: int = ch_book[c];
        if (book_is(b, "PSA")) h_str("Psalm") else h_text(bsb, book_name_start(b),
            book_name_end(b));
        h_str("</span>");
        if (book_count[b] > 1) {
            h_str("<b>");
            h_int(ch_num[c]);
            h_str("</b>")
        }
        h_str("</div>")
    }
    h_str("</div><a class=\"cont vh\" data-act=\"ref\" href=\"#\"></a><a class=\"cont vh\" data-act=\"ref\" href=\"#\"></a>");
    if (sc_last + 1 < chapters) {
        h_str("<p class=\"across\"><a data-act=\"ref\" href=\"");
        h_chapter_url(r_text, sc_last + 1, 0, 0);
        h_str("\">");
        h_title_of(sc_last + 1);
        h_str(" \โ\€\บ</a></p>")
    }
    if (sc_first > 0) {
        h_str("<p class=\"across up\"><a data-act=\"ref\" href=\"");
        h_chapter_url(r_text, sc_first - 1, 0, 0);
        h_str("\">\โ\€\น ");
        h_title_of(sc_first - 1);
        h_str("</a></p>")
    }
    h_str("</div>");
    r_bible = dom_insert_html_of(r_main, 1, hb, 0, hb_n);
    sp_off = dom_get_prop(r_bible, "offsetTop");
    r_phs = dom_query(r_bible, ".phs");
    r_cont_up = dom_query(r_bible, ".cont");
    r_cont_down = dom_prop_handle(r_cont_up, "nextElementSibling");
    r_across = dom_query(r_bible, ".across:not(.up)");
    if (phs_now) ph_dirty(sc_first, sc_last);
    ph_flush()
}

// Whether build_scroller writes the placeholders (not for the first paint).
phs_now: bool = true;

phs_timer: int = 0;

// Each chapter's opener drawn at its place, for the whole scroller (after
// the first paint: it is only seen once the reader moves).
write_placeholders(_data: int) {
    if (r_phs == 0) return;
    hb_n = 0;
    for c in sc_first..sc_last + 1 {
        h_str("<div class=\"ph\" style=\"top:");
        h_int(pos[c] as int);
        h_str("px\"><span>");
        b: int = ch_book[c];
        if (book_is(b, "PSA")) h_str("Psalm") else h_text(bsb, book_name_start(b),
            book_name_end(b));
        h_str("</span>");
        if (book_count[b] > 1) {
            h_str("<b>");
            h_int(ch_num[c]);
            h_str("</b>")
        }
        h_str("</div>")
    }
    dom_set_html_of(r_phs, hb, 0, hb_n);
    phs_now = true;
    ph_dirty(sc_first, sc_last);
    ph_flush()
}

// A chapter's name into hb.
h_title_of(c: int) {
    b: int = ch_book[c];
    if (book_is(b, "PSA")) h_str("Psalm") else h_text(bsb, book_name_start(b), book_name_end(b));
    if (book_count[b] > 1) {
        h_byte(32);
        h_int(ch_num[c])
    }
}

// ---- the window: the chapters written in the page ----
art_h: []int = new int[1200](0);

w_first: int = -1;

w_last: int = -1;

// (Chapters are <main>'s children, placed from its padding box: the
// spacer's offset in it, then their place.)
sp_off: f64 = 0.0f64;

set_top(c: int) {
    w_px(sp_off + pos[c]);
    dom_set_style_of(art_h[c], "top", wb, 0, wb_n)
}

// A measured height for chapter c (d more than it was): the anchor never
// moves. Above it, the chapter keeps its bottom and those above move up
// (the slack above Genesis 1 takes it); below, it keeps its top and those
// after move down.
correct(c: int, hgt: f64, anchor: int) {
    d: f64 = hgt - ht[c];
    ht[c] = hgt;
    measured[c] = true;
    if (d == 0.0f64) return;
    if (c < anchor) {
        for k in sc_first..c + 1 pos[k] = pos[k] - d;
        ph_dirty(sc_first, c);
        if (w_first >= 0) {
            for k in w_first..w_last + 1 {
                if (k <= c) set_top(k)
            }
        }
    } else {
        for k in c + 1..sc_last + 2 pos[k] = pos[k] + d;
        ph_dirty(c + 1, sc_last);
        if (w_first >= 0) {
            for k in w_first..w_last + 1 {
                if (k > c) set_top(k)
            }
        }
    }
    heights_changed = true
}

heights_changed: bool = false;

slack_least: f64 = 1000000000.0f64;

// (Set while the slack is trimmed on purpose.)
trimming: bool = false;

// Chapter c written into the page at its place, in the window's order (it
// joins either end), measured at once, before it is painted.
write_ch(c: int, anchor: int) {
    hb_n = 0;
    html_chapter(r_text, c, r_lines);
    a: int = 0;
    if (w_first >= 0 && c < w_first) a = dom_insert_html_of(art_h[w_first], 0, hb,
        0, hb_n) else if (w_first >= 0) a = dom_insert_html_of(art_h[w_last], 3, hb,
        0, hb_n) else a = dom_insert_html_of(r_bible, 3, hb, 0, hb_n);
    art_h[c] = a;
    dom_add_class(a, "placed");
    if (w_first < 0 || c < w_first) w_first = c;
    if (c > w_last) w_last = c;
    set_top(c);
    dom_rect(a, box);
    correct(c, box[3], anchor)
}

drop(c: int) {
    dom_remove(art_h[c]);
    dom_free_tree(art_h[c]);
    art_h[c] = 0
}

// The window cleared (a jump far off, a relayout).
clear_window() {
    if (w_first >= 0) {
        for k in w_first..w_last + 1 {
            if (art_h[k] != 0) drop(k)
        }
    }
    w_first = -1;
    w_last = -1
}

// Whether the selection is in chapter c (it keeps it written).
sel4: []int = new int[4](0);

holds_selection(c: int): bool {
    if (dom_selection(sel4) != 2) return false;
    sel4[0] == art_h[c] || sel4[2] == art_h[c]
}

// The page's speed (px a ms, down positive), for reaching ahead.
speed: f64 = 0.0f64;

last_t: f64 = 0.0f64;

last_frame_y: f64 = 0.0f64;

// The window kept: what overlaps two screens above the view and three
// below (and, while the page moves fast, as far again as it will go in
// 0.4 s), at most two chapters written a frame; chapters four screens
// away taken out. It changes nothing else's layout, so it can run at any
// time, mid-fling or mid-drag.
keep_window(): bool {
    measure_sp();
    top: f64 = table_y(0.0f64);
    bottom: f64 = top + view_h;
    lo: f64 = top - 2.0f64 * view_h;
    hi: f64 = bottom + 3.0f64 * view_h;
    ahead: f64 = speed * 400.0f64;
    if (ahead > 0.0f64) hi = hi + ahead else lo = lo + ahead;
    a: int = chapter_at_t(lo);
    b: int = chapter_at_t(hi);
    anchor: int = chapter_at(reading_y());
    // (Nothing written near here: start again from the anchor.)
    if (w_first >= 0 && (w_last < a || w_first > b)) clear_window();
    n: int = 0;
    if (w_first < 0) {
        if (ch_verses[anchor] == 0) {
            want_book(anchor);
            ph_flush();
            return false
        }
        write_ch(anchor, anchor);
        n = 1
    }
    // (Only chapters whose text is held: a book not held yet is asked for,
    // and its chapters stay placeholders till it comes.)
    up_first: bool = speed < 0.0f64;
    can_up: bool = true;
    can_down: bool = true;
    while (n < 2 && (can_up && w_first > a || can_down && w_last < b)) {
        up: bool = can_up && w_first > a && (up_first || !(can_down && w_last < b));
        c: int = if (up) w_first - 1 else w_last + 1;
        if (ch_verses[c] > 0) {
            write_ch(c, anchor);
            n = n + 1
        } else {
            want_book(c);
            if (up) can_up = false else can_down = false
        }
    }
    // (Far ones out, unless they hold the selection.)
    far_lo: f64 = top - 4.0f64 * view_h;
    far_hi: f64 = bottom + 4.0f64 * view_h;
    more: bool = true;
    while (more && w_first < w_last) {
        more = false;
        if (pos[w_first + 1] < far_lo && !holds_selection(w_first)) {
            drop(w_first);
            w_first = w_first + 1;
            more = true
        } else if (pos[w_last] > far_hi && !holds_selection(w_last)) {
            drop(w_last);
            w_last = w_last - 1;
            more = true
        }
    }
    ph_flush();
    cont_links();
    can_up && w_first > a || can_down && w_last < b
}

// The book holding chapter c asked for (the web's: web/app.l8).
want_book(c: int) {
    fetch_book(book_of_chapter(c))
}

cont_at: []int = new int[2](-2);

// The hidden links past the window's ends ("Continue to John 5"), for
// keyboards and screen readers: following one is a jump.
cont_links() {
    for side in 0..2 {
        c: int = if (side == 0) w_first - 1 else w_last + 1;
        h: int = if (side == 0) r_cont_up else r_cont_down;
        if (cont_at[side] != c) {
            cont_at[side] = c;
            if (c < sc_first || c > sc_last) dom_set_attr(h, "hidden", "") else {
                dom_remove_attr(h, "hidden");
                wb_n = 0;
                w_url(c, 0);
                dom_set_attr_of(h, "href", wb, 0, wb_n);
                wb_n = 0;
                w_str("Continue to ");
                w_title(c);
                dom_set_text_of(h, wb, 0, wb_n);
                w_px(if (side == 0) pos[w_first] else pos[w_last + 1]);
                dom_set_style_of(h, "top", wb, 0, wb_n)
            }
        }
    }
}

// ---- measuring in the background (ยงW3.3 item 2) ----
// One chapter after another into the hidden box, outward from the place,
// in slices of at most 8 ms, only while nothing moves and no finger or
// button is down; the heights kept now and then.
bg_timer: int = 0;

bg_step: int = 0;

bg_since_save: int = 0;

bg_schedule(ms: f64) {
    dom_cancel(bg_timer);
    bg_timer = dom_timeout(ms, &on_bg, 0)
}

on_bg(_data: int) {
    bg_timer = 0;
    if (r_bible == 0) return;
    if (finger_down || pointer_down || dom_now() - moved_at < 300.0f64) {
        bg_schedule(300.0f64);
        return
    }
    measure();
    measure_sp();
    anchor: int = chapter_at(reading_y());
    t0: f64 = dom_now();
    done: bool = false;
    while (!done && dom_now() - t0 < 8.0f64) {
        c: int = next_unmeasured(anchor);
        if (c < 0) done = true else {
            correct(c, measure_one(c, r_lines), anchor);
            bg_since_save = bg_since_save + 1
        }
    }
    ph_flush();
    if (bg_since_save >= 60 || done && bg_since_save > 0) {
        save_heights();
        bg_since_save = 0
    }
    if (!done) bg_schedule(16.0f64) else {
        dom_set_prop(DOM_WINDOW, "sbAllMeasured", 1.0f64);
        trim_slack()
    }
}

// The unmeasured chapter nearest the anchor (-1 if none), alternately
// below and above.
next_unmeasured(anchor: int): int {
    for d in 0..sc_last - sc_first + 1 {
        // (Only chapters whose text is held.)
        if (anchor + d <= sc_last && !measured[anchor + d] && ch_verses[anchor + d] > 0) return anchor + d;
        if (anchor - d >= sc_first && !measured[anchor - d] && ch_verses[anchor - d] > 0) return anchor - d
    }
    -1
}

// ---- the slack above Genesis 1 (ยงW3.3 item 6.4) ----
// Taken up only when it is more than half a screen off, every chapter above
// the anchor is measured, and the reader is truly at rest (no finger or
// button down, nothing moved for 500 ms); in one frame, everything and the
// scroll move by it.
trim_slack() {
    if (finger_down || pointer_down || dom_now() - moved_at < 500.0f64) {
        bg_schedule(500.0f64);
        return
    }
    measure();
    measure_sp();
    anchor: int = chapter_at(reading_y());
    s: f64 = pos[sc_first];
    if (s <= view_h / 2.0f64 && s >= 0.0f64) return;
    for c in sc_first..anchor
        if (!measured[c]) return;
    for k in sc_first..sc_last + 2 pos[k] = pos[k] - s;
    ph_dirty(sc_first, sc_last);
    if (w_first >= 0) {
        for k in w_first..w_last + 1 set_top(k)
    }
    trimming = true;
    ph_flush();
    trimming = false;
    scroll_write(scroll_y - s, "slack")
}

// ---- the place (ยงW3.5) ----
// The chapter, the verse and how far through it, at the reading line (verse
// 0 the chapter's opener; -1, a chapter not written, how far through it).
pl_c: int = 0;

pl_v: int = 1;

pl_f: f64 = 0.0f64;

// Verse v's spans in chapter c's article: their top and bottom in the view
// (v_top, v_bottom); false if it has none. Verse 0 is the chapter's opener:
// from the article's top to its first verse.
v_top: f64 = 0.0f64;

v_bottom: f64 = 0.0f64;

verse_box(c: int, v: int): bool {
    if (c < sc_first || c > sc_last || art_h[c] == 0) return false;
    if (v == 0) {
        n0: int = dom_rects_all(art_h[c], "[data-v]", rects);
        dom_rect(art_h[c], box);
        v_top = box[1];
        v_bottom = (if (n0 > 0) rects[1] else box[1] + box[3]);
        return true
    }
    wb_n = 0;
    w_str("[data-v=\"");
    w_int(v);
    w_str("\"]");
    n: int = dom_rects_all_of(art_h[c], wb, 0, wb_n, rects);
    if (n <= 0) return false;
    if (n > len(rects) / 4) n = len(rects) / 4;
    v_top = rects[1];
    v_bottom = rects[1] + rects[3];
    for i in 1..n {
        if (rects[4 * i + 1] < v_top) v_top = rects[4 * i + 1];
        if (rects[4 * i + 1] + rects[4 * i + 3] > v_bottom) v_bottom = rects[4 * i + 1] + rects[4 * i + 3]
    }
    true
}

// The verse key of a node with data-v (0 if none).
verse_of(h: int): int {
    n: int = dom_get_attr(h, "data-v", abuf);
    if (n <= 0) return 0;
    num_at(abuf, 0, n)
}

// Where the text's column is in the view: its left and width.
col_x: f64 = 0.0f64;

col_w: f64 = 0.0f64;

place_now() {
    if (r_bible == 0) return;
    measure();
    measure_sp();
    dom_rect(r_main, box);
    col_x = box[0];
    col_w = box[2];
    y: f64 = reading_y();
    pl_c = chapter_at(y);
    if (art_h[pl_c] == 0) {
        pl_v = -1;
        pl_f = (table_y(y) - pos[pl_c]) / ht[pl_c];
        return
    }
    // (A point a quarter across the column, clear of a popover on the
    // right; in a gap or a heading, the nearest verse above.)
    x: f64 = col_x + col_w * 0.25f64;
    v: int = 0;
    k: f64 = y;
    dom_rect(art_h[pl_c], box);
    top: f64 = box[1];
    while (v == 0 && k > y - 240.0f64 && k > top) {
        h: int = dom_point(x, k, "[data-v]");
        if (h != 0) {
            v = verse_of(h);
            dom_free(h)
        }
        k = k - 6.0f64
    }
    // (None above the line in this chapter: the line is in its opener.)
    if (!verse_box(pl_c, v) || v > 0 && v_top > y) {
        v = 0;
        _b: bool = verse_box(pl_c, 0)
    }
    pl_v = v;
    pl_f = (if (v_bottom > v_top) (y - v_top) / (v_bottom - v_top) else 0.0f64);
    if (pl_f < 0.0f64) pl_f = 0.0f64;
    // (Past 1 when the line is in a heading after the verse.)
    if (pl_f > 4.0f64) pl_f = 4.0f64
}

// The scroll position that puts the place at the reading line: the
// window made around it first (the chapter written and measured, keeping
// its top).
place_y(): f64 {
    measure();
    measure_sp();
    if (pl_c < sc_first || pl_c > sc_last) {
        choose_range(pl_c);
        pos_from(slack_for(pl_c));
        build_scroller();
        measure_sp()
    }
    if (art_h[pl_c] == 0) {
        if (w_first >= 0 && (pl_c < w_first - 1 || pl_c > w_last + 1)) clear_window();
        if (w_first >= 0 && pl_c == w_first - 1 || w_first >= 0 && pl_c == w_last + 1 || w_first < 0) write_ch(pl_c,
            pl_c)
    }
    ph_flush();
    if (pl_v >= 0 && verse_box(pl_c, pl_v)) return scroll_y + v_top + pl_f * (v_bottom - v_top) - reading_y();
    if (pl_v >= 0) {
        dom_rect(art_h[pl_c], box);
        return scroll_y + box[1] - reading_y()
    }
    sp_top + pos[pl_c] + pl_f * ht[pl_c] - reading_y()
}

// The place put back at the reading line (a jump, Back, a relayout).
restore_place(reason: str) {
    if (r_bible == 0) return;
    scroll_write(place_y(), reason);
    fill_now()
}

// The window filled at once (after a write), then by frames.
fill_now() {
    more: bool = true;
    k: int = 0;
    while (more && k < 6) {
        more = keep_window();
        k = k + 1
    }
    if (more) ask_frame()
}

// The slack above a chapter at the start: 5% of the estimate above it and
// a screen, so corrections above never reach past the top.
slack_for(c: int): f64 {
    above: f64 = 0.0f64;
    for k in sc_first..c above = above + ht[k];
    above * 0.05f64 + view_h
}

// The place as a state for history and storage: "c v f".
w_place() {
    w_int(pl_c);
    w_byte(32);
    w_int(pl_v);
    w_byte(32);
    w_f3(pl_f)
}

// A place read back from b's first n bytes; false if it is not one.
read_place(b: []i8, n: int): bool {
    c: int = num_at(b, 0, n);
    if (num_end == 0 || num_end >= n) return false;
    neg: bool = b[num_end + 1] as int == 45;
    v: int = num_at(b, num_end + (if (neg) 2 else 1), n);
    if (num_end + 1 >= n) return false;
    f: f64 = frac_at(b, num_end + 1, n);
    if (c < 0 || c >= chapters) return false;
    pl_c = c;
    pl_v = (if (neg) 0 - v else v);
    pl_f = f;
    true
}

// The place kept: localStorage (sb.place: its address, then the place) and
// the history entry's state. (The entry keeps the address the title gave
// it; sb.place names the place's own chapter, which /read/ opens.)
save_place() {
    if (r_bible == 0) return;
    wb_n = 0;
    w_url(pl_c, 0);
    w_byte(32);
    state_at: int = wb_n;
    w_place();
    dom_store_set("sb.place", wb, wb_n);
    n: int = wb_n - state_at;
    for i in 0..n sb_state[i] = wb[state_at + i];
    wb_n = 0;
    w_url(if (title_c >= 0) title_c else pl_c, 0);
    dom_replace(wb, wb_n, sb_state, n)
}

sb_state: []i8 = new i8[64](0i8);

// The place kept in storage and the entry's state, its address as it is.
keep_place() {
    wb_n = 0;
    w_url(pl_c, 0);
    w_byte(32);
    state_at: int = wb_n;
    w_place();
    dom_store_set("sb.place", wb, wb_n);
    n: int = wb_n - state_at;
    for i in 0..n sb_state[i] = wb[state_at + i];
    k: int = dom_get_prop_s(DOM_LOCATION, "href", abuf);
    if (k > 0 && k <= len(abuf)) dom_replace(abuf, k, sb_state, n)
}

// ---- the title and the address (ยงW3.4, ยงW2.3) ----
title_c: int = -1;

// The chapter named: the one under the bar's bottom edge. The address and
// the page's title follow it (replaceState: reading on is not a jump).
set_title(c: int, address: bool) {
    if (c == title_c) return;
    title_c = c;
    wb_n = 0;
    w_title(c);
    off: int = r_t_on;
    on: int = 1 - r_t_on;
    dom_set_text_of(r_t[on], wb, 0, wb_n);
    dom_toggle_class(r_t[on], "out", 0);
    dom_toggle_class(r_t[off], "out", 1);
    r_t_on = on;
    dom_set_attr_of(r_title, "aria-label", wb, 0, wb_n);
    w_str(" \ย\ท ");
    w_str(text_abbrs[r_text]);
    w_str(" \ย\ท Smooth Bible");
    dom_set_prop_of(DOM_DOCUMENT, "title", wb, 0, wb_n);
    if (!address) return;
    wb_n = 0;
    w_url(c, 0);
    url_n: int = wb_n;
    n: int = dom_state(sb_state);
    dom_replace(wb, url_n, sb_state, if (n < 0 || n > len(sb_state)) 0 else n)
}

// ---- the bar (DESIGN.md ยง3.1.4) ----
bar_p: f64 = 0.0f64;

last_y: f64 = 0.0f64;

up_travel: f64 = 0.0f64;

// The last movement: down (1) or up (0).
last_down: bool = true;

set_p(p: f64) {
    bar_p = p;
    wb_n = 0;
    w_f3(p);
    dom_set_style_of(r_bar, "--p", wb, 0, wb_n);
    dom_toggle_class(r_bar, "tucked", if (p > 0.5f64) 1 else 0)
}

// The bar followed the scroll from last_y to scroll_y.
follow_scroll() {
    y: f64 = scroll_y;
    dy: f64 = y - last_y;
    last_y = y;
    if (y < 0.0f64) return;
    p: f64 = bar_p;
    if (dy > 0.0f64) {
        up_travel = 0.0f64;
        last_down = true;
        p = p + dy / 48.0f64
    } else if (dy < 0.0f64) {
        before: f64 = up_travel;
        up_travel = up_travel - dy;
        last_down = false;
        if (up_travel > 12.0f64) {
            past: f64 = if (before >= 12.0f64) 0.0f64 - dy else up_travel - 12.0f64;
            p = p - past / 48.0f64
        }
    }
    if (p > y / 48.0f64) p = y / 48.0f64;
    if (bar_focus) p = 0.0f64;
    if (p < 0.0f64) p = 0.0f64;
    if (p > 1.0f64) p = 1.0f64;
    if (p != bar_p) set_p(p)
}

settle_timer: int = 0;

// At rest, a bar between its states eases to the nearer end of the last
// movement (0.25 s).
settle_bar() {
    if (bar_p <= 0.0f64 || bar_p >= 1.0f64) return;
    dom_add_class(r_bar, "settle");
    set_p(if (last_down) 1.0f64 else 0.0f64);
    dom_cancel(settle_timer);
    settle_timer = dom_timeout(300.0f64, &on_settled, 0)
}

on_settled(_data: int) {
    dom_remove_class(r_bar, "settle")
}

// The bar expanded, eased (on a jump, a dialog, a click on the title).
expand_bar() {
    if (bar_p == 0.0f64) return;
    dom_add_class(r_bar, "settle");
    set_p(0.0f64);
    up_travel = 0.0f64;
    dom_cancel(settle_timer);
    settle_timer = dom_timeout(300.0f64, &on_settled, 0)
}

// Focus in the bar (Tab from the page, or a screen reader's): expanded,
// and kept so while it is there.
bar_focus: bool = false;

on_bar_focus(_data: int) {
    bar_focus = dom_event_is("focusin");
    if (bar_focus) expand_bar()
}

// ---- moving through the page ----
frame_asked: bool = false;

rest_timer: int = 0;

has_scrollend: bool = false;

// A finger on the screen, a button down; when the page last moved.
finger_down: bool = false;

pointer_down: bool = false;

moved_at: f64 = -1000000.0f64;

// Whether the reader has scrolled since the last rest (the place kept then
// is no longer where they are).
moved_since_rest: bool = false;

ask_frame() {
    if (!frame_asked) {
        frame_asked = true;
        dom_frame(&on_frame, 0)
    }
}

// A rest is 100 ms with no scroll after scrollend, or 120 ms with none
// where the browser has no scrollend; never while a finger is down.
on_scroll(_data: int) {
    moved_since_rest = true;
    moved_at = dom_now();
    ask_frame();
    dom_cancel(rest_timer);
    rest_timer = (if (has_scrollend) 0 else dom_timeout(120.0f64, &on_rest, 0))
}

on_scrollend(_data: int) {
    dom_cancel(rest_timer);
    rest_timer = dom_timeout(100.0f64, &on_rest, 0)
}

on_touch(_data: int) {
    finger_down = dom_event_is("touchstart") || dom_event_is("touchmove");
    if (finger_down) moved_at = dom_now();
    dom_cancel(rest_timer);
    rest_timer = (if (finger_down) 0 else dom_timeout(120.0f64, &on_rest, 0))
}

on_pointer(_data: int) {
    pointer_down = dom_event_is("pointerdown")
}

// Each frame while the page moves: the bar, the title and address (from
// the table, so right over placeholders too), the window, the footnote.
on_frame(_data: int) {
    frame_asked = false;
    // (Printing lays the page out for paper, and the scroll moves with it:
    // nothing follows it then.)
    if (r_bible == 0 || printing) return;
    measure();
    now: f64 = dom_now();
    if (last_t > 0.0f64 && now > last_t) speed = (scroll_y - last_frame_y) / (now - last_t);
    last_t = now;
    last_frame_y = scroll_y;
    follow_scroll();
    measure_sp();
    set_title(chapter_at(bar_h - 24.0f64 * bar_p + 1.0f64), true);
    more: bool = keep_window();
    fn_follow();
    if (more) ask_frame()
}

// At rest: the bar settled, the place kept, measuring in the background.
// Set from a new width or fonts arriving until the relayout: the text has
// reflowed under the old places, so no rest may read the place from it.
stale: bool = false;

on_rest(_data: int) {
    if (finger_down || r_bible == 0 || stale || printing) return;
    moved_since_rest = false;
    speed = 0.0f64;
    last_t = 0.0f64;
    settle_bar();
    place_now();
    set_title(chapter_at(bar_h - 24.0f64 * bar_p + 1.0f64), true);
    save_place();
    if (heights_changed) {
        save_heights();
        heights_changed = false
    }
    bg_schedule(300.0f64)
}

// ---- relayout (ยงW3.3 item 6.3) ----
// After a change of anything the heights depend on (the width, a setting,
// fonts arriving): the table estimated again (or taken from storage), the
// page rebuilt, and the place put back; the write waits until no finger is
// down and nothing has moved for 300 ms (a setting's change needs no wait:
// the reader is at the sheet, not scrolling).
relayout_timer: int = 0;

relayout(now: bool) {
    if (r_bible == 0) return;
    if (!now && (finger_down || pointer_down || dom_now() - moved_at < 300.0f64)) {
        dom_cancel(relayout_timer);
        relayout_timer = dom_timeout(300.0f64, &on_relayout, 0);
        return
    }
    stale = false;
    measure();
    calibrate();
    make_key();
    estimate_all(r_lines);
    clear_window();
    choose_range(pl_c);
    pos_from(slack_for(pl_c));
    build_scroller();
    restore_place("relayout");
    save_place();
    bg_schedule(300.0f64)
}

on_relayout(_data: int) {
    relayout(false)
}

// The heights' key: the version, the column's width, the settings they
// depend on (html's data- attributes and --step) and the browser's text
// size.
make_key() {
    key_n = 0;
    k_str(text_abbrs[r_text]);
    k_byte(124);
    dom_rect(r_main, box);
    k_int((box[2] - 2.0f64 * dom_style_num(r_main, "padding-left")) as int);
    k_byte(124);
    k_int((dom_style_num(DOM_ROOT, "font-size") * 100.0f64) as int);
    k_byte(124);
    k_int((dom_style_num(r_main, "font-size") * 100.0f64) as int);
    for a in ["data-font", "data-spacing", "data-margins", "data-vn", "data-heads",
        "data-fns"] {
        k_byte(124);
        n: int = dom_get_attr(DOM_ROOT, a, abuf);
        for i in 0..n k_byte(abuf[i] as int)
    }
    k_byte(124);
    k_byte(if (r_lines) 49 else 48)
}

k_byte(c: int) {
    if (key_n < len(key)) {
        key[key_n] = c trunc i8;
        key_n = key_n + 1
    }
}

k_str(s: str) {
    for c in s k_byte(c as int)
}

k_int(n: int) {
    if (n >= 10) k_int(n / 10);
    k_byte(48 + n % 10)
}

// Fonts (document.fonts), to tell whether some are still coming.
fonts_h: int = 0;

// ---- estimates made better as text comes (ยงW1.8) ----
// Each chapter not measured estimated again, from its text if it is held
// (else from the sizes table): the anchor never moves (those above keep
// their bottoms, those below their tops).
refine_estimates() {
    if (r_bible == 0) return;
    measure();
    measure_sp();
    anchor: int = chapter_at(reading_y());
    for c in sc_first..sc_last + 1 {
        if (!measured[c]) {
            e: f64 = if (ch_verses[c] > 0) est_chapter(c, r_lines) else est_from_sizes(c);
            est_h[c] = e;
            ht[c] = e
        }
    }
    // (From the anchor's top, which stays: down, then up.)
    for k in anchor..sc_last + 1 pos[k + 1] = pos[k] + ht[k];
    k: int = anchor - 1;
    while (k >= sc_first) {
        pos[k] = pos[k + 1] - ht[k];
        k = k - 1
    }
    ph_dirty(sc_first, sc_last);
    if (w_first >= 0) {
        for c in w_first..w_last + 1 set_top(c)
    }
    ph_flush()
}

// ---- jumps ----
// A jump (ยงW2.3): the place before kept in its entry, then a new entry for
// chapter c, verse v placed a third of the way down the space under the
// bar and flashed (or, for v 0, the chapter's opener under the bar).
jump(c: int, v: int) {
    go(c, v, false)
}

// A jump that takes the current entry's place (one from a dialog, whose
// entry it replaces: ยงW2.3).
go(c: int, v: int, replace: bool) {
    place_now();
    if (!replace) save_place();
    pl_c = c;
    pl_v = 0;
    pl_f = 0.0f64;
    y: f64 = place_y();
    if (v > 0 && verse_box(c, v)) y = scroll_y + v_top - reading_y() - (view_h - bar_h) / 3.0f64 else y = y + h2_offset(c);
    scroll_write(y, "jump");
    if (v > 0) flash(c, v);
    fill_now();
    expand_bar();
    place_now();
    wb_n = 0;
    w_place();
    n: int = wb_n;
    for i in 0..n sb_state[i] = wb[i];
    wb_n = 0;
    w_url(c, v);
    if (replace) dom_replace(wb, wb_n, sb_state, n) else dom_push(wb, wb_n, sb_state,
        n);
    title_c = -1;
    set_title(c, false);
    save_place()
}

// How far below the article's top its opener's heading is, less 12 px
// (a chapter is placed with its opener just under the bar).
h2_offset(c: int): f64 {
    if (art_h[c] == 0) return 0.0f64;
    n: int = dom_rects_all(art_h[c], "h2.op", rects);
    dom_rect(art_h[c], box);
    if (n > 0) rects[1] - box[1] - 12.0f64 else 0.0f64
}

// Verse v of chapter c flashed (every span of it: a verse can cross
// paragraphs); one flashing before is stopped, so this one runs again.
flash(c: int, v: int) {
    dom_class_all(r_main, ".flash", "flash", 0);
    _w: f64 = dom_get_prop(r_main, "offsetWidth");
    wb_n = 0;
    w_str("[data-v=\"");
    w_int(v);
    w_str("\"]");
    dom_class_all_of(art_h[c], wb, 0, wb_n, "flash", 1)
}

// The top of the chapter read, or the one before's if already there (Home;
// DESIGN.md ยง3.1.4's status bar tap): a scroll, not a jump (no entry),
// smooth but under reduced motion; the bar expanded with it.
home() {
    place_now();
    measure();
    measure_sp();
    c: int = pl_c;
    top: f64 = sp_top + pos[c] + h2_offset(c) - reading_y();
    if (top >= scroll_y - 13.0f64 && c > sc_first) {
        c = c - 1;
        top = sp_top + pos[c] + h2_offset(c) - reading_y()
    }
    expand_bar();
    smooth: int = if (dom_media("(prefers-reduced-motion: reduce)") == 1) 0 else 1;
    dom_scroll_to(DOM_WINDOW, 0.0f64, top, smooth)
}

// ---- footnotes (ยงW3.6) ----
fn_pop: int = 0;

fn_head: int = 0;

fn_body: int = 0;

fn_mark: int = 0;

fn_keyboard: bool = false;

fn_make() {
    hb_n = 0;
    h_str("<div class=\"fnpop\" popover=\"auto\" role=\"dialog\" aria-labelledby=\"fnpop-h\" tabindex=\"-1\"><h2 id=\"fnpop-h\"></h2><p></p></div>");
    fn_pop = dom_insert_html_of(DOM_BODY, 2, hb, 0, hb_n);
    fn_head = dom_query(fn_pop, "h2");
    fn_body = dom_query(fn_pop, "p");
    dom_listen(fn_pop, "toggle", 0, &on_fn_toggle, 0)
}

// A footnote's mark was clicked: its note in the popover beside it.
fn_open(c: int, v: int, at: int) {
    if (fn_mark != 0) dom_free(fn_mark);
    fn_mark = dom_event_closest("a.fn");
    fn_keyboard = dom_ev[DE_DETAIL] == 0;
    wb_n = 0;
    w_str("Footnote \ย\ท ");
    w_title(c);
    if (v > 0) {
        w_byte(if (book_count[ch_book[c]] > 1) 58 else 32);
        w_int(v)
    }
    dom_set_text_of(fn_head, wb, 0, wb_n);
    if (at >= 0 && at < bsb_n) dom_set_text_of(fn_body, bsb, at + 1, line_end(at));
    dom_call(fn_pop, "showPopover");
    fn_place();
    if (fn_keyboard) dom_call(fn_pop, "focus")
}

// Above the mark if there is room, else below; 16 px from the edges.
fn_place() {
    if (fn_mark == 0) return;
    measure();
    dom_rect(fn_mark, box);
    mx: f64 = box[0] + box[2] / 2.0f64;
    mt: f64 = box[1];
    mb: f64 = box[1] + box[3];
    dom_rect(fn_pop, box);
    w: f64 = box[2];
    h: f64 = box[3];
    x: f64 = mx - w / 2.0f64;
    if (x > view_w - 16.0f64 - w) x = view_w - 16.0f64 - w;
    if (x < 16.0f64) x = 16.0f64;
    y: f64 = if (mt - h - 8.0f64 >= bar_h + 8.0f64) mt - h - 8.0f64 else mb + 8.0f64;
    wb_n = 0;
    w_f3(x);
    w_str("px");
    dom_set_style_of(fn_pop, "--x", wb, 0, wb_n);
    wb_n = 0;
    w_f3(y);
    w_str("px");
    dom_set_style_of(fn_pop, "--y", wb, 0, wb_n)
}

fn_open_now(): bool {
    fn_pop != 0 && dom_call_s(fn_pop, "matches", ":popover-open") == 1.0f64
}

// While it is open: closed once its mark scrolls off the screen.
fn_follow() {
    if (fn_mark == 0 || !fn_open_now()) return;
    dom_rect(fn_mark, box);
    if (box[1] + box[3] < bar_h || box[1] > view_h) dom_call(fn_pop, "hidePopover")
}

on_fn_toggle(_data: int) {
    if (fn_open_now()) return;
    if (fn_keyboard && fn_mark != 0) dom_call(fn_mark, "focus");
    if (fn_mark != 0) dom_free(fn_mark);
    fn_mark = 0
}
