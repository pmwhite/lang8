tag bible_ios;

use_tag std, ios, bible;

// The demo's Round 5 steps (DESIGN.md §10.6): the `plans` group, shots 140
// to 158, with the demo clock (today() is 2026-10-19 08:00): Today in Go
// To, the plans, a plan started and read (by the reader's rest, as a demo
// hook), Day Done, Catch Up three days on; the Verse of the Day's setting,
// its authorization alert, the Time row (the shim's answer forced), a
// notification opened; Share as Image; exact senses and related words; the
// largest text; the recording's sequence 12; and a regression step for the
// lists popped under a theme's change (TestFlight 1.0 (11)'s crash). Each
// step does what the reader's own taps would, through the same functions.
import "../ios/objc.l8";

import "../ios/block.l8";

import "text.l8";

genesis(n: int): int {
    book_first[0] + n - 1
}

// A chapter read as the reader would: its end shown, and 20 s of rest
// counted (the demo hook for the dwell).
demo_read(c: int) {
    go_place(c, ch_verses[c], 0);
    bar_set(0.0f64);
    pr_end[c] = true;
    pr_dwell[c] = 20.0f64;
    plan_check(c)
}

// A completion handler of our own (a block), called as UIKit's would be:
// the path a notification's opening takes.
demo_handler_block: int = 0;

demo_handler(_block: int): int {
    note("bible: completion handler called");
    0
}

demo_do5(t: int) {
    if (t == 240) {
        demo_dismiss();
        // (A place read before, for Recent.)
        history_here(john3(), 16);
        go_top(genesis(1));
        bar_set(0.0f64)
    }
    if (t == 241) open_picker();
    if (t == 242) open_plans();
    if (t == 243) open_plan(PLAN_YEAR, 0);
    if (t == 244) {
        plan_start(0, 0, 0);
        demo_later_at(0.8f64, 300)
    }
    if (t == 245) {
        demo_dismiss();
        demo_read(genesis(1));
        demo_later_at(0.6f64, 301)
    }
    if (t == 246) {
        demo_dismiss();
        demo_read(genesis(2));
        demo_read(genesis(3))
    }
    if (t == 247) {
        demo_dismiss();
        demo_day_shift = 3;
        demo_later_at(0.4f64, 301)
    }
    if (t == 248) {
        demo_dismiss();
        demo_day_shift = 0;
        demo_later_at(0.4f64, 303)
    }
    if (t == 249) {
        // Daily Notification turned on: the system's alert (the shim's
        // call). Last in the group: the alert outlives the app, and the
        // simulator cannot answer it.
        demo_dismiss();
        demo_later_at(0.4f64, 330)
    }
    if (t == 250) {
        // (The shim's answer, granted, as the demo gives it.)
        demo_dismiss();
        demo_grant();
        demo_later_at(0.6f64, 303)
    }
    if (t == 251) {
        demo_dismiss();
        go_top(genesis(1));
        if (demo_handler_block == 0) demo_handler_block = global_block0(&demo_handler);
        notify_open_ref(nsstring("JHN.3.16"));
        call_block(demo_handler_block)
    }
    if (t == 252) {
        demo_dismiss();
        hide_back();
        go_verse(john3(), 16);
        bar_set(0.0f64);
        toggle_verse(john3(), 16);
        demo_later_at(0.5f64, 304)
    }
    if (t == 253) {
        // (The share sheet's action chosen: the composer UIKit would show.)
        demo_dismiss();
        demo_later_at(0.4f64, 332)
    }
    if (t == 254) {
        if (sh_seg != 0) {
            msg1(sh_seg, sel("setSelectedSegmentIndex:"), 1);
            share_shape(0, 0, sh_seg)
        }
        share_pick_theme(4)
    }
    if (t == 255) {
        // Genesis 1:1's "God".
        share_finish(false);
        demo_dismiss();
        clear_selection();
        demo_later_at(0.5f64, 305)
    }
    if (t == 256) {
        // "N in this sense".
        study_picked(2, 0)
    }
    if (t == 257) {
        demo_dismiss();
        demo_later_at(0.5f64, 306)
    }
    if (t == 258) {
        // φιλέω.
        for i in 0..ws_rel_n
            if (ws_rel_num[i] == 5368) open_lemma(ws_greek, 5368)
    }
    if (t == 259) {
        demo_dismiss();
        demo_later_at(0.5f64, 307)
    }
    if (t == 260) demo_sequence5();
    if (t == 261) {
        // The lists popped, then the theme and the ESV changed under them.
        demo_dismiss();
        demo_later_at(0.4f64, 309)
    }
}

// The later parts of the steps (demo_later's kinds 300 and up).
demo_later5(d: int) {
    // (What opens a sheet waits until no sheet is left.)
    opens: bool = d == 301 || d == 303 || d == 305 || d == 306 || d == 307 || d == 309 || d == 320 || d == 325 || d == 330 || d == 332;
    if (opens && presented() != 0) {
        demo_later_at(0.3f64, d);
        return
    }
    if (d == 300) {
        demo_dismiss();
        demo_later_at(0.5f64, 301)
    } else if (d == 301) open_picker() else if (d == 302) settings_to_votd() else if (d == 303) {
        open_settings();
        demo_later_at(0.6f64, 302)
    } else if (d == 304) share_verses(sel_c, sel_v, sel_n, 0) else if (d == 305) {
        lang_load();
        vi: int = lang_verse(genesis(1), 1);
        for w in v_first(vi)..v_end(vi)
            if (!w_greek(w) && w_strongs(w) == 430 && presented() == 0) open_study_sheet(vi,
                w)
    } else if (d == 306) {
        lang_load();
        vi: int = lang_verse(john3(), 16);
        found: int = -1;
        for w in v_first(vi)..v_end(vi)
            if (found < 0 && w_greek(w) && w_strongs(w) == 25) found = w;
        if (found >= 0) open_study_sheet(vi, found);
        demo_later_at(0.8f64, 308)
    } else if (d == 307) open_picker() else if (d == 308) {
        // (Scrolled down to the related words, their header in sight.)
        if (study_table != 0) {
            s: int = 0;
            for i in 0..study_sections()
                if (study_kind(i) == 4) s = i;
            msg3(study_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
                msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0, s),
                1, 0);
            msg_ff1(study_table, sel("setContentOffset:animated:"), 0.0f64, offset_y(study_table) - 44.0f64,
                0)
        }
    } else if (d == 309) {
        open_settings();
        demo_later_at(0.8f64, 310)
    } else if (d == 310) {
        open_versions();
        demo_later_at(0.8f64, 311)
    } else if (d == 311) {
        demo_pop();
        demo_later_at(0.6f64, 312)
    } else if (d == 312) {
        open_acknowledgements();
        demo_later_at(0.8f64, 313)
    } else if (d == 313) {
        demo_pop();
        demo_later_at(0.6f64, 314)
    } else if (d == 314) {
        // (TestFlight 1.0 (11)'s crash: a theme picked after the lists
        // were popped; and the ESV listed, then not, under them.)
        listed: bool = def_bool("esvAvailable");
        esv_set_listed(!listed);
        esv_set_listed(listed);
        set_theme = 3;
        settings_changed(true);
        set_theme = 0;
        settings_changed(true);
        note("bible: popped lists survived the theme and the ESV")
    } else if (d == 320) {
        open_picker();
        demo_later_at(1.0f64, 321)
    } else if (d == 321) {
        // A Today circle tapped (the symbol cross-fades).
        for row in 0..td_n
            if (td_kind[row] == 1) {
                today_toggle(td_arg[row]);
                return
            }
    } else if (d == 322) open_plans() else if (d == 323) demo_pop() else if (d == 324) {
        demo_dismiss();
        demo_later_at(0.4f64, 325)
    } else if (d == 325) {
        open_settings();
        demo_later_at(0.6f64, 302)
    } else if (d == 326) {
        // On (the answer forced) and the Time row fading in; then off.
        if (daily_switch != 0 && settings_table != 0) msg2(daily_switch, sel("setOn:animated:"),
            1, 1);
        demo_grant()
    } else if (d == 327) {
        if (daily_switch != 0 && settings_table != 0) {
            msg2(daily_switch, sel("setOn:animated:"), 0, 1);
            daily_switched(0, 0, daily_switch)
        }
    } else if (d == 330) {
        open_settings();
        demo_later_at(0.6f64, 331)
    } else if (d == 331) {
        settings_to_votd();
        if (daily_switch != 0) msg2(daily_switch, sel("setOn:animated:"), 1, 1);
        notify_ask(1)
    } else if (d == 332) {
        sh_by_demo = true;
        msg3(nav, sel("presentViewController:animated:completion:"), make_composer(),
            1, 0);
        share_card_save("share-card.png")
    }
}

// The reading settings scrolled to the Verse of the Day.
settings_to_votd() {
    if (settings_table != 0) msg3(settings_table, sel("scrollToRowAtIndexPath:atScrollPosition:animated:"),
        msg2(cls("NSIndexPath"), sel("indexPathForRow:inSection:"), 0, VOTD_SECTION + 1),
        2, 0)
}

// The recording's sequence 12: a Today circle, Plans pushed and popped, and
// Daily Notification on and off (the Time row fading in and out).
demo_seq5_at: int = 0;

demo_sequence5() {
    demo_dismiss();
    demo_seq5_at = 0;
    demo_later_at(0.3f64, 320);
    demo_seq5_timer = after(2.2f64, "demoSeq5:")
}

demo_seq5_timer: int = 0;

demo_seq5_steps: []int = [322, 323, 324, 326, 327];

demo_seq5(_self: int, _cmd: int, _timer: int): int {
    demo_seq5_timer = 0;
    if (demo_seq5_at >= len(demo_seq5_steps)) return 0;
    d: int = demo_seq5_steps[demo_seq5_at];
    demo_seq5_at = demo_seq5_at + 1;
    demo_next = 0;
    demo_later5(d);
    demo_settle_start();
    demo_seq5_timer = after(if (d == 324) 1.4f64 else 1.6f64, "demoSeq5:");
    0
}

add_demo5_methods(app: int) {
    add_method1(app, sel("demoSeq5:"), &demo_seq5, "v@:@")
}
