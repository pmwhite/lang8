tag bible_prerender;

use_tag std, bible;

// The web reader's pages, made at build time (WEB.md ยงW1.8): every chapter
// of every bundled version, each version's book index, the About page and
// the app's shell, each the page template with its fields filled.
//
//   prerender TEMPLATE DATA OUT ABOUT
//
// TEMPLATE is web/bible/page.html with its assets' names in (build.py makes
// it); DATA is programs/bible/data; OUT the site's read/ directory; ABOUT
// the About page's content. A chapter's text is html.l8's, the same as the
// app writes, so the app takes it as its own.
//
// Fields: {{title}} {{description}} {{canonical}} {{og_title}} {{robots}}
// {{bar_title}} {{index}} {{version_name}} {{v}} {{c}} {{article}}
// {{pager}} {{credit}}.
import "../../stdlib/print.l8";

import "text.l8";

import "html.l8";

need "libc.so.6";

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

extern mkdir(path: str, mode: int): int;

read_n: int = 0;

read_into(path: str, most: int): []i8@new {
    fd: int = open(path, 0, 0);
    buf: []i8 = new i8[most](0i8);
    got: int = 0;
    more: bool = fd >= 0;
    while (more && got < most) {
        r: int = read(fd, buf, got, most - got);
        if (r <= 0) more = false else got = got + r
    }
    if (fd >= 0) close(fd);
    read_n = got;
    buf
}

// ---- paths ----
path: []i8 = new i8[1024](0i8);

path_n: int = 0;

p_str(s: str) {
    for c in s p_byte(c as int)
}

p_bytes(b: []i8, p: int, e: int) {
    for i in p..e p_byte(b[i] as int)
}

p_byte(c: int) {
    if (path_n < len(path)) {
        path[path_n] = c trunc i8;
        path_n = path_n + 1
    }
}

// The path as a str.
path_str(): str@new {
    b: []i8 = new i8[path_n](0i8);
    for i in 0..path_n b[i] = path[i];
    cstr(b)
}

out_dir: str = "";

// OUT/rest, made a directory (if it is not one).
make_dir() {
    _r: int = mkdir(path_str(), 493)
}

// ---- the page ----
template: []i8 = new i8[1](0i8);

template_n: int = 0;

// The fields, as ranges of hb: their names and where each is.
FIELDS: int = 13;

field_names: []str = ["title", "description", "canonical", "og_title", "robots", "bar_title",
    "index", "version_name", "v", "c", "article", "pager", "credit"];

field_start: []int = new int[13](0);

field_end: []int = new int[13](0);

field_at: int = 0;

// The next field's value is written from here.
begin(k: int) {
    field_start[k] = hb_n;
    field_at = k
}

end() {
    field_end[field_at] = hb_n
}

page: []i8 = new i8[2097152](0i8);

page_n: int = 0;

pg_byte(c: int) {
    if (page_n < len(page)) {
        page[page_n] = c trunc i8;
        page_n = page_n + 1
    }
}

// The template with its fields filled, into page.
fill() {
    page_n = 0;
    i: int = 0;
    while (i < template_n) {
        k: int = -1;
        if (i + 1 < template_n && template[i] as int == 123 && template[i + 1] as int == 123) k = field_here(i + 2);
        if (k >= 0) {
            for j in field_start[k]..field_end[k] pg_byte(hb[j] as int);
            i = i + 2 + len(field_names[k]) + 2
        } else {
            pg_byte(template[i] as int);
            i = i + 1
        }
    }
}

// The field whose name (and }}) is at template[i], or -1.
field_here(i: int): int {
    for k in 0..len(field_names) {
        field: str = field_names[k];
        n: int = len(field);
        if (i + n + 1 < template_n && template[i + n] as int == 125 && template[i + n + 1] as int == 125) {
            same: bool = true;
            for j in 0..n
                if (template[i + j] != field[j]) same = false;
            if (same) return k
        }
    }
    -1
}

pages: int = 0;

// page written to the path.
write_page() raises IoError {
    fd: int = open(path_str(), 577, 420);
    if (fd < 0) {
        write(2, "prerender: cannot write ");
        write_bytes_n(2, path, path_n);
        print("");
        return
    }
    write_bytes_n(fd, page, page_n);
    close(fd);
    pages = pages + 1
}

// ---- the fields ----
SITE: str = "https://smoothbible.com";

// Chapter c's name (John 3, Psalm 23, Jude).
h_title_of(c: int) {
    b: int = ch_book[c];
    if (book_is(b, "PSA")) h_str("Psalm") else h_text(bsb, book_name_start(b), book_name_end(b));
    if (book_count[b] > 1) {
        h_byte(32);
        h_int(ch_num[c])
    }
}

h_abbr(t: int) {
    h_str(text_abbrs[t])
}

credit(t: int) {
    begin(12);
    h_str(text_names[t]);
    h_str(" \ย\ท Public Domain");
    end()
}

// The fields every page of text t has alike.
common(t: int) {
    begin(4);
    end();
    begin(7);
    h_str(text_names[t]);
    end();
    begin(8);
    h_version(t);
    end();
    begin(6);
    h_str("/read/");
    h_version(t);
    h_byte(47);
    end();
    credit(t)
}

chapter_page(t: int, c: int) raises IoError {
    hb_n = 0;
    common(t);
    begin(0);
    h_title_of(c);
    h_str(" \ย\ท ");
    h_abbr(t);
    h_str(" \ย\ท Smooth Bible");
    end();
    begin(1);
    n: int = verse_text(c, 1);
    h_text(vt, 0, n);
    end();
    begin(2);
    h_str(SITE);
    h_chapter_url(t, c, 0, 0);
    end();
    begin(3);
    h_title_of(c);
    h_str(" \ย\ท ");
    h_str(text_names[t]);
    end();
    begin(5);
    h_title_of(c);
    end();
    begin(9);
    h_int(c);
    end();
    begin(11);
    if (c > 0) {
        h_str("<a rel=\"prev\" href=\"");
        h_chapter_url(t, c - 1, 0, 0);
        h_str("\">\โ\€\น ");
        h_title_of(c - 1);
        h_str("</a>")
    }
    if (c + 1 < chapters) {
        h_str("<a rel=\"next\" href=\"");
        h_chapter_url(t, c + 1, 0, 0);
        h_str("\">");
        h_title_of(c + 1);
        h_str(" \โ\€\บ</a>")
    }
    end();
    begin(10);
    html_chapter(t, c, false);
    end();
    fill();
    path_n = 0;
    p_str(out_dir);
    p_byte(47);
    p_version(t);
    p_byte(47);
    b: int = ch_book[c];
    for i in book_name_start(b)..book_name_end(b) {
        k: int = bsb[i] as int;
        p_byte(if (k == 32) 45 else lower(k))
    }
    if (ch_num[c] == 1) make_dir();
    p_byte(47);
    p_int(ch_num[c]);
    p_str(".html");
    write_page()
}

p_version(t: int) {
    for c in text_abbrs[t] p_byte(lower(c as int))
}

p_int(n: int) {
    if (n >= 10) p_int(n / 10);
    p_byte(48 + n % 10)
}

// Text t's books (/read/bsb/, and /read/ for the BSB).
index_page(t: int) raises IoError {
    hb_n = 0;
    common(t);
    begin(0);
    h_str(text_names[t]);
    h_str(" \ย\ท Smooth Bible");
    end();
    begin(1);
    h_str("The ");
    h_str(text_names[t]);
    h_str(", every book and chapter.");
    end();
    begin(2);
    h_str(SITE);
    h_str("/read/");
    h_version(t);
    h_byte(47);
    end();
    begin(3);
    h_str(text_names[t]);
    end();
    begin(5);
    h_str("Books");
    end();
    begin(9);
    end();
    begin(11);
    end();
    begin(10);
    html_books(t);
    end();
    fill();
    path_n = 0;
    p_str(out_dir);
    p_byte(47);
    p_version(t);
    make_dir();
    p_str("/index.html");
    write_page();
    if (t == TEXT_BSB) {
        path_n = 0;
        p_str(out_dir);
        p_str("/index.html");
        write_page()
    }
}

// A page of the site's own (About; the app's shell): its title, its
// content, its file.
own_page(
    title: str,
    content: []i8,
    n: int,
    file: str,
    robots: bool
) raises IoError {
    hb_n = 0;
    common(TEXT_BSB);
    begin(4);
    if (robots) h_str("<meta name=\"robots\" content=\"noindex\">");
    end();
    begin(0);
    h_str(title);
    h_str(" \ย\ท Smooth Bible");
    end();
    begin(1);
    h_str("Smooth Bible: the Bible to read, on the web and the iPhone.");
    end();
    begin(2);
    h_str(SITE);
    h_str("/read/");
    h_str(file);
    end();
    begin(3);
    h_str(title);
    end();
    begin(5);
    h_str(title);
    end();
    begin(9);
    end();
    begin(11);
    end();
    begin(10);
    for i in 0..n h_byte(content[i] as int);
    end();
    fill();
    path_n = 0;
    p_str(out_dir);
    p_byte(47);
    p_str(file);
    p_str(".html");
    write_page()
}

version_files: []str = ["bsb", "kjv", "web", "asv", "ylt"];

main(argc: int, args: []str@immortal) noregion raises IoError: int {
    if (argc < 5) {
        print("usage: prerender TEMPLATE DATA OUT ABOUT");
        return 2
    }
    template = read_into(args[1], 65536);
    template_n = read_n;
    out_dir = args[3];
    about: []i8 = read_into(args[4], 262144);
    about_n: int = read_n;
    for t in 0..5 {
        path_n = 0;
        p_str(args[2]);
        p_byte(47);
        p_str(version_files[t]);
        p_str(".txt");
        buf: []i8 = read_into(path_str(), 8388608);
        if (read_n == 0) {
            print("prerender: no text");
            return 1
        }
        if (t == 0) bsb = buf;
        text_load(t, buf, read_n);
        text_use(t);
        path_n = 0;
        p_str(out_dir);
        p_byte(47);
        p_version(t);
        make_dir();
        for c in 0..chapters chapter_page(t, c);
        index_page(t)
    }
    text_use(TEXT_BSB);
    own_page("About", about, about_n, "about", false);
    empty: []i8 = new i8[1](0i8);
    own_page("Smooth Bible", empty, 0, "shell", true);
    write_int(1, pages);
    print(" pages");
    0
}
