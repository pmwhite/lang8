tag skate;

use_tag std;

use_tag gl, x11;

// Breathing. Building a place takes a while (see go_to, in main.l8), and
// on a page nothing else moves while the game works: not the page, nor
// what shows that it is loading. So the long work stops every few
// milliseconds to let a frame go by, wherever it calls breathe(): the
// picture is left as it was, and the page stays awake. Only on a page (see
// breathe_on, which main sets): a window of its own does not need it.
extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int
}

mono_ns(): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    ts.sec * 1000000000 + ts.nsec
}

// How long it works between frames.
const BREATH_NS: int = 8000000;

breathe_on: bool = false;

breathe_dpy: ?*i8 = null;

breathe_win: int = 0;

breathe_ns: int = 0;

// The longest it has gone without one, and at which stage of the work
// (see go_to), for L8_TRACE.
breathe_longest: int = 0;

breathe_stage: int = 0;

breathe_worst: int = 0;

breathe() {
    if (!breathe_on) return;
    now: int = mono_ns();
    if (now - breathe_ns < BREATH_NS) return;
    if (now - breathe_ns > breathe_longest) {
        breathe_longest = now - breathe_ns;
        breathe_worst = breathe_stage
    }
    d: ?*i8 = breathe_dpy;
    if (d == null) return;
    dpy: *i8 = d;
    glXSwapBuffers(dpy, breathe_win);
    breathe_ns = mono_ns()
}

// The work starts now: a full breath before the first frame.
breathe_begin() {
    breathe_ns = mono_ns();
    breathe_longest = 0
}
