const ARENA_W: int = 44;

const ARENA_H: int = 40;

const LEVEL: f32 = 0.5;

// The level of the grass around the arena, and of most of its paving.
const BASE_LEVEL: int = 2;

const CELL_PAVED: int = 0;

const CELL_GRASS: int = 1;

const CELL_TREE: int = 2;

const CELL_RAMP: int = 3;

const CELL_QUARTER: int = 4;

// A planter on the paving, in the way like a tree; or a lamp post, a thin
// pole standing in the middle of its cell (see poles).
const CELL_PROP: int = 5;

// A pool: a floor with curved walls on some of its sides, as in a bowl or a
// halfpipe. The walls are quarter circles, n cells wide and n levels high,
// steepening toward their lips. A point's height comes from how far it lies
// outside the floor, so a bowl's corners are round.
type Pool = {
    x0: f32;
    z0: f32;
    x1: f32;
    z1: f32;
    // Which sides have walls: the floor's -x, +x, -z, +z sides.
    walls_x: bool;
    walls_z: bool;
    n: f32;
    level: int
}

const MAX_POOLS: int = 4;

pools: []Pool = new Pool[MAX_POOLS](Pool {
    x0: 0.0,
    z0: 0.0,
    x1: 0.0,
    z1: 0.0,
    walls_x: false,
    walls_z: false,
    n: 1.0,
    level: 0
});

npools: int = 0;

add_pool(
    x0: int,
    z0: int,
    x1: int,
    z1: int,
    walls_x: bool,
    walls_z: bool,
    n: int,
    level: int
) {
    pools[npools] = Pool {
        x0: x0 as f32,
        z0: z0 as f32,
        x1: x1 as f32,
        z1: z1 as f32,
        walls_x: walls_x,
        walls_z: walls_z,
        n: n as f32,
        level: level
    };
    npools = npools + 1
}

// How far a point lies outside pool p's floor, across its walls, and the
// direction away from the floor.
pool_out(
    p: Pool,
    x: f32,
    z: f32,
    dir: *V3
): f32 {
    ux: f32 = 0.0;
    uz: f32 = 0.0;
    if (p.walls_x) ux = maxf(maxf(p.x0 - x, x - p.x1), 0.0) * signf(x - (p.x0 + p.x1) * 0.5);
    if (p.walls_z) uz = maxf(maxf(p.z0 - z, z - p.z1), 0.0) * signf(z - (p.z0 + p.z1) * 0.5);
    u: f32 = sqrtf(ux * ux + uz * uz);
    if (u > 0.0001) dir.* = v3(ux / u, 0.0, uz / u) else dir.* = v3(0.0, 0.0, 0.0);
    minf(u, p.n)
}

// A wall's height above the floor u out from it: a quarter circle of radius
// 1.25 n meets the floor flat and rises n levels.
pool_rise(p: Pool, u: f32): f32 {
    r: f32 = 1.25 * p.n;
    r - sqrtf(r * r - u * u)
}

pool_height(p: Pool, x: f32, z: f32): f32 {
    d: V3 = v3(0.0, 0.0, 0.0);
    p.level as f32 * LEVEL + pool_rise(p, pool_out(p, x, z, &d))
}

// Directions: 0 +x, 1 +z, 2 -x, 3 -z.
dir_dx(d: int): int {
    if (d == 0) return 1;
    if (d == 2) return -1;
    0
}

dir_dz(d: int): int {
    if (d == 1) return 1;
    if (d == 3) return -1;
    0
}

dir_vec(d: int): V3 {
    v3(dir_dx(d) as f32, 0.0, dir_dz(d) as f32)
}

cell_kind: []int = new int[ARENA_W * ARENA_H](0);

cell_level: []int = new int[ARENA_W * ARENA_H](0);

// A ramp's rising direction.
cell_rise: []int = new int[ARENA_W * ARENA_H](0);

// The pool a quarter's wall belongs to.
cell_pool: []int = new int[ARENA_W * ARENA_H](0);

// Whether a paved cell is a ledge with steel edges.
cell_ledge: []bool = new bool[ARENA_W * ARENA_H](false);

// The nth non-newline byte of a map.
map_byte(m: str, n: int): i8 {
    k: int = 0;
    for c in m {
        if (c != '\n') {
            if (k == n) return c;
            k = k + 1
        }
    }
    'g'
}

load_arena() {
    npools = 0;
    // The bowl, and the halfpipe running along z.
    add_pool(30, 5, 36, 11, true, true, 2, 0);
    add_pool(8, 22, 14, 34, true, false, 2, 2);
    for j in 0..ARENA_H {
        for i in 0..ARENA_W {
            k: int = j * ARENA_W + i;
            c: i8 = map_byte(arena_features, k);
            cell_level[k] = map_byte(arena_heights, k) as int - '0' as int;
            cell_kind[k] = CELL_PAVED;
            if (c == 'g') cell_kind[k] = CELL_GRASS;
            if (c == 't') cell_kind[k] = CELL_TREE;
            if (c == 'p' || c == 'l') cell_kind[k] = CELL_PROP;
            if (c == 'l') cell_rise[k] = 1;
            if (c == '>' || c == 'v' || c == '<' || c == '^') cell_kind[k] = CELL_RAMP;
            if (c == '>') cell_rise[k] = 0;
            if (c == 'v') cell_rise[k] = 1;
            if (c == '<') cell_rise[k] = 2;
            if (c == '^') cell_rise[k] = 3;
            // A prop's kind: 0 planter, 1 lamp post.
            if (c == 'p') cell_rise[k] = 0;
            cell_ledge[k] = c == 'L';
            if (c == 'Q') {
                cell_kind[k] = CELL_QUARTER;
                cell_pool[k] = pool_at(i as f32 + 0.5, j as f32 + 0.5)
            }
        }
    }
    find_poles()
}

// The pool whose walls surround a point, the nearest floor.
pool_at(x: f32, z: f32): int {
    best: int = 0;
    best_d: f32 = 1000.0;
    for k in 0..npools {
        p: Pool = pools[k];
        dx: f32 = maxf(maxf(p.x0 - x, x - p.x1), 0.0);
        dz: f32 = maxf(maxf(p.z0 - z, z - p.z1), 0.0);
        if (dx + dz < best_d) {
            best = k;
            best_d = dx + dz
        }
    }
    best
}

in_arena(i: int, j: int): bool {
    i >= 0 && j >= 0 && i < ARENA_W && j < ARENA_H
}

kind_at(i: int, j: int): int {
    if (!in_arena(i, j)) return CELL_TREE;
    cell_kind[j * ARENA_W + i]
}

level_at(i: int, j: int): int {
    if (!in_arena(i, j)) return 0;
    cell_level[j * ARENA_W + i]
}

rise_at(i: int, j: int): int {
    cell_rise[j * ARENA_W + i]
}

// The ground's height at a point in cell (i, j).
surface_in(
    i: int,
    j: int,
    x: f32,
    z: f32
): f32 {
    l: f32 = level_at(i, j) as f32;
    k: int = kind_at(i, j);
    if (k == CELL_QUARTER) return pool_height(pools[cell_pool[j * ARENA_W + i]], x,
        z);
    if (k != CELL_RAMP) return l * LEVEL;
    r: int = rise_at(i, j);
    fx: f32 = x - i as f32;
    fz: f32 = z - j as f32;
    t: f32 = fx;
    if (r == 1) t = fz;
    if (r == 2) t = 1.0 - fx;
    if (r == 3) t = 1.0 - fz;
    (l + clampf(t, 0.0, 1.0)) * LEVEL
}

cell_of(x: f32): int {
    floorf(x) as int
}

surface_at(x: f32, z: f32): f32 {
    surface_in(cell_of(x), cell_of(z), x, z)
}

// Whether nothing can stand in cell (i, j): beyond the arena, a tree, a
// prop.
blocked_cell(i: int, j: int): bool {
    if (!in_arena(i, j)) return true;
    k: int = kind_at(i, j);
    k == CELL_TREE || k == CELL_PROP && !is_lamp(i, j)
}

is_lamp(i: int, j: int): bool {
    kind_at(i, j) == CELL_PROP && rise_at(i, j) == 1
}

// ---- poles ----
// Lamp posts are poles: thin, so he passes close by them, and something to
// grab and swing around.
const MAX_POLES: int = 64;

const POLE_RADIUS: f32 = 0.1;

pole_x: []f32 = new f32[MAX_POLES](0.0);

pole_z: []f32 = new f32[MAX_POLES](0.0);

npoles: int = 0;

find_poles() {
    npoles = 0;
    for j in 0..ARENA_H {
        for i in 0..ARENA_W {
            if (is_lamp(i, j) && npoles < MAX_POLES) {
                pole_x[npoles] = i as f32 + 0.5;
                pole_z[npoles] = j as f32 + 0.5;
                npoles = npoles + 1
            }
        }
    }
}

// The nearest pole within reach of (x, z), or -1.
pole_near(x: f32, z: f32, reach: f32): int {
    best: int = -1;
    best_d: f32 = reach * reach;
    for k in 0..npoles {
        dx: f32 = x - pole_x[k];
        dz: f32 = z - pole_z[k];
        if (dx * dx + dz * dz < best_d) {
            best = k;
            best_d = dx * dx + dz * dz
        }
    }
    best
}

// The highest ground under a square footprint of half size r at (x, z).
// The cell under its center counts its height there. Each other cell it
// overlaps counts its height at the point nearest the center, if the ground
// steps up there, so he stands on a curb as soon as he is over its edge; a
// cell that meets the center's smoothly, as along a ramp or a pool's wall,
// does not count. Trees and the world beyond the arena are walls.
support_height(x: f32, z: f32, r: f32): f32 {
    ci: int = cell_of(x);
    cj: int = cell_of(z);
    if (blocked_cell(ci, cj)) return 100.0;
    h: f32 = surface_in(ci, cj, x, z);
    for j in cell_of(z - r)..cell_of(z + r) + 1 {
        for i in cell_of(x - r)..cell_of(x + r) + 1 {
            if (blocked_cell(i, j)) return 100.0;
            px: f32 = clampf(x, i as f32, (i + 1) as f32);
            pz: f32 = clampf(z, j as f32, (j + 1) as f32);
            there: f32 = surface_in(i, j, px, pz);
            if (absf(there - surface_in(ci, cj, px, pz)) > 0.05) h = maxf(h, there)
        }
    }
    h
}

// ---- rails ----
// Any edge where the ground steps down a level or more is a rail, and so is
// a pool's lip: an edge along x (axis 0) at z = line, or along z (axis 1) at
// x = line. Rails follow cell edges, so lines are whole numbers.
type Rail = {
    axis: int;
    line: f32;
    h: f32
}

// The top of the step a rail makes at s along its line, or -1 if there is
// none there.
rail_height(axis: int, line: f32, s: f32): f32 {
    k: int = floorf(line + 0.5) as int;
    i0: int = cell_of(s);
    j0: int = k - 1;
    i1: int = cell_of(s);
    j1: int = k;
    px: f32 = s;
    pz: f32 = line;
    if (axis == 1) {
        i0 = k - 1;
        j0 = cell_of(s);
        i1 = k;
        j1 = cell_of(s);
        px = line;
        pz = s
    }
    if (blocked_cell(i0, j0) || blocked_cell(i1, j1)) return -1.0;
    a: f32 = surface_in(i0, j0, px, pz);
    b: f32 = surface_in(i1, j1, px, pz);
    if (absf(a - b) >= 0.45) return maxf(a, b);
    pool_lip(axis, line, s)
}

// A pool's lip along a line: its straight runs beside the floor.
pool_lip(axis: int, line: f32, s: f32): f32 {
    for k in 0..npools {
        p: Pool = pools[k];
        top: f32 = (p.level as f32 + p.n) * LEVEL;
        if (axis == 1 && p.walls_x && s >= p.z0 && s <= p.z1) {
            if (absf(line - (p.x0 - p.n)) < 0.01 || absf(line - (p.x1 + p.n)) < 0.01) return top
        }
        if (axis == 0 && p.walls_z && s >= p.x0 && s <= p.x1) {
            if (absf(line - (p.z0 - p.n)) < 0.01 || absf(line - (p.z1 + p.n)) < 0.01) return top
        }
    }
    -1.0
}

// A rail he could land on: one running the way he moves (d), near enough
// to his feet (x, y, z). Whether there is one; it goes in out.
find_rail(
    x: f32,
    z: f32,
    y: f32,
    d: V3,
    out: *Rail
): bool {
    found: bool = false;
    best: f32 = 0.6;
    for axis in 0..2 {
        along: f32 = d.x;
        across: f32 = z;
        s: f32 = x;
        if (axis == 1) {
            along = d.z;
            across = x;
            s = z
        }
        if (absf(along) > 0.8) {
            // The cell edges either side of him.
            for side in 0..2 {
                line: f32 = floorf(across) + side as f32;
                dist: f32 = absf(across - line);
                h: f32 = rail_height(axis, line, s);
                if (dist < best && h >= 0.0 && y >= h - 0.25 && y <= h + 0.4) {
                    best = dist;
                    out.* = Rail { axis: axis, line: line, h: h };
                    found = true
                }
            }
        }
    }
    found
}
