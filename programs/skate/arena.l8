22222222222222222222222222222222222222222222
22222222222222222222222222222222222222222222
22222222222222222222222222222222222222222222
22222222222222222222222222220000000000222222
22222334444332222222222222220000000000222222
22222334444332222222222222220000000000222222
22222333333332222222222222220000000000222222
22222333333332222222222222220000000000222222
22222333333332222222222222220000000000222222
22222333333332277222222222220000000000222222
22222222222222277222222222220000000000222222
22222222222222222222222222220000000000222222
22222222222222244422222222220000000000222222
22222222222222222222222222222222222222222222
22222222222222222222222222222222222222222222
22222222222222222222222222222222222222222222
22222222222222222222222222222222222222222222
22222222222222222222333333333333222222222222
22222222222222222222222222222222222222222222
22222222222222222222222222222222222222222222
22222222222222222222222222222222222222222222
22222222222222222222222222222222222222222222
22224422222222224422222222222222222222222222
22224422222222224422222222333222222222222222
22224422222222224422223322333222233322222222
22224422222222224422223322222222233322222222
22224422222222224422222222222222233322222222
22224422222222224422222222222222222222222222
22224422222222224422222222222222222222222222
22224422222222224422222222222222222222222222
22224422222222224422225555555552222222222222
22224422222222224422222222222222222222222222
22224422222222224422222222222222222222222222
22224422222222224422222222222222222222222222
