tag skate;

use_tag gl;

// Grass on the course's banks: tufts of blades, drawn as instances of one
// small mesh near the camera, swaying in the wind and fading out with
// distance into the banks' grassy ground. Near the run it is short, as if
// mown; farther up the banks, longer and patchier.
//
// A tuft is three blades, each a quad and a tip; its vertices hold a
// position in the tuft (y from 0 at the root to 1 at the tip) and a normal.
// They are one strip of triangles: five vertices to a blade, and two more
// between one blade and the next, joining them with triangles of no size.
// An instance is six floats: where the tuft stands, how it is turned, how
// tall it is, and a tint (0 lush to 1 dry).
const TUFT_BLADES: int = 3;

const TUFT_VERTS: int = 19;

const GRASS_FLOATS: int = 6;

// Spacing of tufts, how far up the banks they reach, and the length of a
// chunk of them along the run. Only the chunks that could show are drawn
// (see draw_grass, in render.l8): each has the box that its tufts stand
// in. No tuft shows further than GRASS_FAR from the camera
// (the grass's shader shrinks them to nothing by then).
const GRASS_SPACING: f32 = 0.28;

const GRASS_REACH: f32 = 12.5;

const GRASS_CHUNK: f32 = 5.0;

const GRASS_FAR: f32 = 42.0;

const MAX_GRASS_CHUNKS: int = 200;

const MAX_GRASS: int = 140000;

grass_inst: []f32 = static_buffer(MAX_GRASS * GRASS_FLOATS, 0.0);

grass_n: int = 0;

grass_first: []int = static_buffer(MAX_GRASS_CHUNKS, 0);

grass_count: []int = static_buffer(MAX_GRASS_CHUNKS, 0);

// (x from, x to, z from, z to, for each; and y, which close_grass_box finds
// from its tufts.)
grass_box: []f32 = static_buffer(MAX_GRASS_CHUNKS * 6, 0.0);

grass_chunks: int = 0;

tuft_data: []f32 = static_buffer(TUFT_VERTS * 6, 0.0);

tuft_n: int = 0;

put_tuft_vertex(
    x: f32,
    y: f32,
    z: f32,
    n: V3
) {
    i: int = tuft_n * 6;
    tuft_data[i] = x;
    tuft_data[i + 1] = y;
    tuft_data[i + 2] = z;
    tuft_data[i + 3] = n.x;
    tuft_data[i + 4] = n.y;
    tuft_data[i + 5] = n.z;
    tuft_n = tuft_n + 1
}

// The tuft: blades leaning out from its middle, wide at the root and
// pointed at the tip, bending outward as they rise.
build_tuft() {
    tuft_n = 0;
    for b in 0..TUFT_BLADES {
        a: f32 = TAU * (b as f32 + 0.15) / TUFT_BLADES as f32;
        dx: f32 = cosf(a);
        dz: f32 = sinf(a);
        // Across the blade, and out.
        sx: f32 = -dz;
        sz: f32 = dx;
        w: f32 = 0.022;
        o: f32 = 0.03;
        lean: f32 = 0.09;
        n: V3 = v_norm(v3(dx, 0.35, dz));
        x0: f32 = dx * o;
        z0: f32 = dz * o;
        x1: f32 = dx * (o + lean * 0.4);
        z1: f32 = dz * (o + lean * 0.4);
        x2: f32 = dx * (o + lean);
        z2: f32 = dz * (o + lean);
        // (The first of a blade twice, after the last of the one before
        // twice: see TUFT_VERTS.)
        if (b > 0) put_tuft_vertex(x0 - sx * w, 0.0, z0 - sz * w, n);
        put_tuft_vertex(x0 - sx * w, 0.0, z0 - sz * w, n);
        put_tuft_vertex(x0 + sx * w, 0.0, z0 + sz * w, n);
        put_tuft_vertex(x1 - sx * w * 0.75, 0.55, z1 - sz * w * 0.75, n);
        put_tuft_vertex(x1 + sx * w * 0.75, 0.55, z1 + sz * w * 0.75, n);
        put_tuft_vertex(x2, 1.0, z2, n);
        if (b < TUFT_BLADES - 1) put_tuft_vertex(x2, 1.0, z2, n)
    }
}

grass_rng: int = 1;

grass_rand(): f32 {
    grass_rng = (grass_rng * 1103515245 + 12345) % 2147483648;
    (grass_rng / 64 % 100000) as f32 / 100000.0
}

// A smooth bumpy field over the banks, 0 to 1, for patches.
patchy(x: f32, z: f32): f32 {
    0.5 + 0.25 * sinf(x * 0.31 + sinf(z * 0.23) * 1.7) * sinf(z * 0.27 + 0.8) + 0.25 * sinf(x * 0.11 - z * 0.09 + 2.0)
}

add_tuft(x: f32, z: f32, edge: f32) {
    if (grass_n >= MAX_GRASS) return;
    i: int = grass_n * GRASS_FLOATS;
    p: f32 = patchy(x, z);
    // Short near the run, longer up the banks, longer still in patches.
    h: f32 = (0.14 + 0.2 * smoothstepf(0.5, 5.0, edge) + 0.18 * p * smoothstepf(1.0,
        6.0, edge)) * (0.75 + 0.5 * grass_rand());
    grass_inst[i] = x;
    grass_inst[i + 1] = course_height(x, z) - 0.02;
    grass_inst[i + 2] = z;
    grass_inst[i + 3] = grass_rand() * TAU;
    grass_inst[i + 4] = h;
    grass_inst[i + 5] = clampf(p * 1.4 - 0.45 + 0.2 * grass_rand(), 0.0, 1.0);
    grass_n = grass_n + 1
}

// Tufts on a jittered grid over both banks, chunk by chunk down the run.
build_grass() {
    build_tuft();
    grass_n = 0;
    grass_chunks = 0;
    grass_rng = 4711;
    d0: f32 = COURSE_START - 10.0;
    while (grass_chunks < MAX_GRASS_CHUNKS && d0 < COURSE_END) {
        grass_first[grass_chunks] = grass_n;
        d: f32 = d0;
        while (d < d0 + GRASS_CHUNK) {
            e: f32 = 0.6;
            while (e < GRASS_REACH) {
                for side in 0..2 {
                    s: f32 = 1.0;
                    if (side == 0) s = -1.0;
                    jx: f32 = (grass_rand() - 0.5) * GRASS_SPACING;
                    jd: f32 = (grass_rand() - 0.5) * GRASS_SPACING;
                    ee: f32 = e + jx;
                    add_tuft(s * (COURSE_HALF + ee), -(d + jd), ee)
                }
                e = e + GRASS_SPACING
            }
            d = d + GRASS_SPACING
        }
        grass_count[grass_chunks] = grass_n - grass_first[grass_chunks];
        reach: f32 = COURSE_HALF + GRASS_REACH + GRASS_SPACING;
        set_grass_box(grass_chunks, -reach, reach, -(d0 + GRASS_CHUNK) - GRASS_SPACING,
            -d0 + GRASS_SPACING);
        grass_chunks = grass_chunks + 1;
        d0 = d0 + GRASS_CHUNK;
        breathe()
    }
}

set_grass_box(
    k: int,
    x0: f32,
    x1: f32,
    z0: f32,
    z1: f32
) {
    grass_box[k * 6] = x0;
    grass_box[k * 6 + 1] = x1;
    grass_box[k * 6 + 2] = z0;
    grass_box[k * 6 + 3] = z1;
    // How low its tufts' roots, and how high their tips.
    lo: f32 = 1000000.0;
    hi: f32 = -1000000.0;
    for i in grass_first[k]..grass_first[k] + grass_count[k] {
        y: f32 = grass_inst[i * GRASS_FLOATS + 1];
        lo = minf(lo, y);
        hi = maxf(hi, y + grass_inst[i * GRASS_FLOATS + 4])
    }
    grass_box[k * 6 + 4] = lo;
    grass_box[k * 6 + 5] = hi + 0.3
}

// Whether any of chunk k's tufts are near enough the eye to show at all.
grass_near(k: int, eye: V3): bool {
    dx: f32 = eye.x - clampf(eye.x, grass_box[k * 6], grass_box[k * 6 + 1]);
    dz: f32 = eye.z - clampf(eye.z, grass_box[k * 6 + 2], grass_box[k * 6 + 3]);
    dx * dx + dz * dz < GRASS_FAR * GRASS_FAR
}
