tag skate;

// Glows: soft lights added over the scene (halos, fireflies), for when it
// is dark. Each is a little square facing the camera, its light added to
// the scene and falling away from its middle (see GLOW_VS and GLOW_FS in
// render.l8).
//
// A glow's six vertices hold its middle; one corner of the square and its
// size; and its color and, for a firefly, a phase (0 for a halo).
const MAX_GLOWS: int = 800;

glow_data: []f32 = static_buffer(MAX_GLOWS * 6 * VERTEX_FLOATS, 0.0);

glow_n: int = 0;

// By day there are none: no fireflies, and the lamps' lanterns glow
// without halos.
build_course_glows() {
    glow_n = 0
}
