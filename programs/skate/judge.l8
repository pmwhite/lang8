tag skate;

// Judging on the course: taste over mashing. A line is a run of hits: an
// air off a kicker, a rail or a box, a trick off anything else, a manual.
//
// - An air is worth what he did (flips, spins, a grab, more for a flip and
//   a spin together), times how long he was up, times how he landed:
//   stomped in the landing's sweet spot, cased short of it, or overshot.
// - A trick he has already done this run is worth half as much, then a
//   quarter, and so on.
// - Off flat ground or a roller, a trick is worth a quarter, and a manual
//   only keeps the line going.
// - A line scores its points times how many different things he hit in
//   it: a kicker or rail with a trick he had not done yet in the line.
// - A line goes on through airs off kickers and rails, grinds, and
//   manuals, but not through hops off flat ground; and manuals only have
//   so much balance in them, refilled by each new hit.
// - Landing crooked loses the line.
const HIT_AIR: int = 0;

const HIT_FLAT: int = 1;

const HIT_RAIL: int = 2;

const HIT_BOX: int = 3;

const HIT_MANUAL: int = 4;

const LAND_CLEAN: int = 0;

const LAND_STOMPED: int = 1;

const LAND_CASED: int = 2;

const LAND_OVERSHOT: int = 3;

// flips and halves are signed: forward, and to the right; a manual's flips
// is 1 for a nose manual.
type Hit = {
    kind: int;
    flips: int;
    halves: int;
    grab: bool;
    landing: int;
    repeat: int;
    // Whether it added to the line's multiplier.
    fresh: bool;
    points: f32
}

const MAX_HITS: int = 64;

const MAX_KEYS: int = 128;

no_hit(): Hit {
    Hit {
        kind: 0,
        flips: 0,
        halves: 0,
        grab: false,
        landing: 0,
        repeat: 0,
        fresh: false,
        points: 0.0
    }
}

type Run = {
    hits: []Hit;
    n: int;
    points: f32;
    mult: int;
    idle: f32;
    // The last line to end: its hits, score, multiplier, whether it was
    // lost, and how long ago.
    done_hits: []Hit;
    done_n: int;
    done_points: int;
    done_mult: int;
    done_lost: bool;
    done_t: f32;
    // Each kind of trick done this run, and how many times.
    keys: []int;
    key_count: []int;
    nkeys: int;
    total: int;
    best_line: int;
    best_run: int;
    // Since the latest hit, for its call.
    call_t: f32;
    // Seconds of manual left in the line.
    balance: f32
}

run: *Run = new Run {
    hits: new Hit[MAX_HITS](no_hit()),
    n: 0,
    points: 0.0,
    mult: 0,
    idle: 0.0,
    done_hits: new Hit[MAX_HITS](no_hit()),
    done_n: 0,
    done_points: 0,
    done_mult: 0,
    done_lost: false,
    done_t: 100.0,
    keys: new int[MAX_KEYS](0),
    key_count: new int[MAX_KEYS](0),
    nkeys: 0,
    total: 0,
    best_line: 0,
    best_run: 0,
    call_t: 100.0,
    balance: BALANCE
};

const BALANCE: f32 = 3.0;

clear_run() {
    run.n = 0;
    run.points = 0.0;
    run.mult = 0;
    run.idle = 0.0;
    run.done_n = 0;
    run.done_t = 100.0;
    run.nkeys = 0;
    run.total = 0;
    run.best_line = 0;
    run.call_t = 100.0;
    run.balance = BALANCE
}

// What makes a trick the same trick.
hit_key(h: Hit): int {
    g: int = 0;
    if (h.grab) g = 1;
    h.kind * 100000 + (h.flips + 4) * 1000 + (h.halves + 8) * 10 + g
}

// How many times this run he has done it.
times_done(key: int): int {
    for i in 0..run.nkeys {
        if (run.keys[i] == key) return run.key_count[i]
    }
    0
}

count_key(key: int) {
    for i in 0..run.nkeys {
        if (run.keys[i] == key) {
            run.key_count[i] = run.key_count[i] + 1;
            return
        }
    }
    if (run.nkeys < MAX_KEYS) {
        run.keys[run.nkeys] = key;
        run.key_count[run.nkeys] = 1;
        run.nkeys = run.nkeys + 1
    }
}

in_line(key: int): bool {
    for i in 0..run.n {
        if (hit_key(run.hits[i]) == key) return true
    }
    false
}

add_hit(h: Hit) {
    r: Hit = h;
    key: int = hit_key(h);
    r.repeat = times_done(key);
    r.points = h.points * powf(0.5, r.repeat as f32);
    counts: bool = h.kind == HIT_AIR || h.kind == HIT_RAIL || h.kind == HIT_BOX;
    r.fresh = counts && !in_line(key);
    if (r.fresh || run.n == 0) run.balance = BALANCE;
    if (run.n < MAX_HITS) {
        run.hits[run.n] = r;
        run.n = run.n + 1
    }
    count_key(key);
    run.points = run.points + r.points;
    if (r.fresh) run.mult = run.mult + 1;
    run.idle = 0.0;
    run.call_t = 0.0
}

// Points for keeping something up (a grind, a manual), at the latest
// hit's repeat rate.
run_add(points: f32) {
    if (run.n == 0) return;
    k: f32 = powf(0.5, run.hits[run.n - 1].repeat as f32);
    run.points = run.points + points * k;
    run.hits[run.n - 1].points = run.hits[run.n - 1].points + points * k
}

flip_points: []f32 = [0.0, 400.0, 1000.0, 1800.0];

spin_points: []f32 = [0.0, 100.0, 250.0, 450.0, 700.0, 1000.0, 1400.0];

// An air, judged as he lands: kind HIT_AIR off a kicker, else HIT_FLAT;
// what he did, how much of the air he held a grab, how long he was up, and
// how he landed.
judge_air(
    kind: int,
    flips: int,
    halves: int,
    grab: f32,
    air: f32,
    landing: int
) {
    nf: int = mini(absi(flips), 3);
    nh: int = mini(absi(halves), 6);
    grabbed: bool = grab > 0.25;
    if (nf == 0 && nh == 0 && !grabbed) {
        // A straight air off a kicker is a little something; an ollie is
        // nothing.
        if (kind != HIT_AIR || air < 0.6) return
    }
    p: f32 = flip_points[nf] + spin_points[nh];
    if (grabbed) p = p + 150.0 + 200.0 * grab;
    if (p == 0.0) p = 100.0;
    if (nf > 0 && nh > 0) p = p * 1.3;
    if (grabbed && nf + nh > 0) p = p * 1.15;
    p = p * clampf(air / 1.2, 0.5, 1.6);
    if (landing == LAND_STOMPED) p = p * 1.25;
    if (landing == LAND_CASED) p = p * 0.6;
    if (landing == LAND_OVERSHOT) p = p * 0.75;
    if (kind == HIT_FLAT) p = p * 0.25;
    h: Hit = no_hit();
    h.kind = kind;
    h.flips = flips;
    h.halves = halves;
    h.grab = grabbed;
    h.landing = landing;
    h.points = p;
    add_hit(h)
}

judge_grind(box: bool) {
    h: Hit = no_hit();
    h.kind = HIT_RAIL;
    if (box) h.kind = HIT_BOX;
    h.points = 150.0;
    add_hit(h)
}

judge_manual(nose: bool) {
    h: Hit = no_hit();
    h.kind = HIT_MANUAL;
    if (nose) h.flips = 1;
    h.points = 25.0;
    add_hit(h)
}

end_run_line(lost: bool) {
    for i in 0..run.n run.done_hits[i] = run.hits[i];
    run.done_n = run.n;
    run.done_t = 0.0;
    run.done_lost = lost;
    run.done_mult = maxi(run.mult, 1);
    run.done_points = (run.points * run.done_mult as f32) as int;
    if (!lost) {
        run.total = run.total + run.done_points;
        if (run.done_points > run.best_line) run.best_line = run.done_points
    }
    run.n = 0;
    run.points = 0.0;
    run.mult = 0
}

lose_run_line() {
    if (run.n > 0) end_run_line(true)
}

// busy: he is in the air, on a rail, or in a manual.
tick_run(busy: bool, dt: f32) {
    run.done_t = run.done_t + dt;
    run.call_t = run.call_t + dt;
    if (busy) run.idle = 0.0 else run.idle = run.idle + dt;
    if (run.n > 0 && run.idle > COURSE_SETTLE) end_run_line(false)
}
