tag skate;

use_tag std;

import "../../stdlib/print.l8";

import "game.l8";

// The best line down a slopestyle course: where to ride, when to jump, and
// which trick to do in each air, for the most points a run can score in
// one of two styles: wild, doing anything the game allows; or human
// (--human), keeping to what a person could do (see Style).
//
//     skate-route COURSE [--human] [--seconds N] [--out FILE]
//
// It rides the course by the game's own rules (slope.l8, judge.l8), so
// what it finds is a run the game itself scores the same. The run it finds
// is written as a replay, in the form the game reads from watch.txt (and
// checked by reading it back and playing it, as the game would): run the
// game from the same directory and press V to watch it.
//
//     make skate-route && .build/skate-route 7
//
// How it searches. A run is a string of moves, each made on the ground (or
// a rail): ride toward a lane across the run for a while, then either jump
// into a trick, or just go on and choose again. What makes the search
// small is that a trick does not change where he flies: the air is the
// same whatever he does in it. So at each takeoff he lets go with no trick,
// the rest of the air is foreseen, and the tricks that fit it are scored
// as the judge would score them, counting what he has already done this
// run. The runs are kept by how far down the hill they have come, in
// stretches of STRETCH metres; a run is kept on what its last trick should
// score, and its move is made for real only when the search goes on from
// it. In each stretch only the highest-scoring go on, as many as the time
// the search is given (--seconds) pays for, no two too alike (where across
// the run he is, how fast, which way round he stands, whether on a rail).
// It is a beam search, not an exhaustive one: given longer, it searches
// wider.
const STRETCH: f32 = 1.0;

// How many runs are kept in each stretch, at the most; and how long a
// search takes, by default.
const KEEP: int = 64;

const DEFAULT_SECONDS: int = 10;

// How long a move may ride before its ending, in steps (see STEP_DT): the
// steps at which it may jump, and those at which it may stop to choose
// again.
jump_steps: []int = [0, 12, 24, 36, 48, 60, 78, 96, 120];

go_on_steps: []int = [60, 120];

// How far ahead a move looks for things to ride to.
const LANE_REACH: f32 = 60.0;

// How many of the tricks that fit an air are offered, beyond the plain one.
const TRICKS_TRIED: int = 4;

// ---- styles ----
// What a run is held to. A wild run may do anything the game allows. A
// human run keeps to what a person could do:
// - It keeps moving: it comes to each metre down the hill no later than
//   PACE times as long as riding straight down takes, and PACE_SPARE more.
// - It keeps to the run, off the grassy banks.
// - It pops no jump of its own (from the ground or a rail) sooner than
//   SET_UP after coming down. (Riding off a lip or a cliff it may let go
//   at once.)
// - Its tricks finish with SLACK to spare, beyond what the game asks: a
//   person lets go a little early or late.
type Style =
    | Wild
    | Human

const PACE: f32 = 1.25;

const PACE_SPARE: f32 = 2.0;

const SET_UP: f32 = 1.0;

const SLACK: f32 = 0.15;

// ---- moves ----
// A grab: none, held all the air, or taken once the trick has turned all
// it will (so that the grab does not slow it).
type Grab =
    | NoGrab
    | WholeAir
    | AfterTurning

// A trick aimed at: its flips forward and half turns to the right, and its
// grab.
type Trick = {
    flips: int;
    halves: int;
    grab: Grab
}

// How a move ends: he goes on (to choose again), or jumps into a trick.
type Ending =
    | GoOn
    | Jump { trick: Trick }

// A move: ride toward x = lane for `wait` steps (or until the ground
// throws him into the air), and then its ending.
type Move = {
    lane: f32;
    wait: int;
    ending: Ending
}

no_move(): Move {
    Move { lane: 0.0, wait: 0, ending: Ending.GoOn }
}

plain_jump(): Ending {
    Ending.Jump { trick: Trick { flips: 0, halves: 0, grab: Grab.NoGrab } }
}

// The steering thumb, to head him for x = lane: quantized as a replay
// keeps it (see rec_step), so that the replay rides as this did.
steer_toward(m: *Mover, lane: f32): f32 {
    want: f32 = atan2f(lane - m.x, 2.0 + 0.6 * m.speed);
    lean: int = clampi((clampf(want / AIM_MAX, -1.0, 1.0) * 512.0) as int, -512, 512);
    lean as f32 / 512.0
}

// What he is told for a step riding toward the lane, the pad held
// (crouched, ready to jump).
set_ride(m: *Mover, keys: *Keys, lane: f32) {
    keys.stick_on = true;
    keys.stick_x = steer_toward(m, lane);
    keys.pad_press = !keys.pad_held;
    keys.pad_held = true;
    keys.pad_release = false;
    keys.aim_x = 0.0;
    keys.aim_y = 0.0
}

// For the step that lets go of the pad, aimed at a trick: he jumps into
// it.
set_release(keys: *Keys, trick: Trick) {
    keys.pad_press = false;
    keys.pad_held = false;
    keys.pad_release = true;
    keys.aim_x = trick.halves as f32;
    keys.aim_y = trick.flips as f32
}

// For a step in the air: pressing the pad now, to grab, or not.
set_air(keys: *Keys, press: bool) {
    keys.pad_press = press;
    if (press) keys.pad_held = true;
    keys.pad_release = false;
    keys.aim_x = 0.0;
    keys.aim_y = 0.0
}

// For a step past the finish: nothing new.
set_coast(keys: *Keys) {
    keys.pad_press = false;
    keys.pad_release = false
}

// Whether to press the pad to grab, the given step into an air.
grab_now(
    m: *Mover,
    keys: *Keys,
    grab: Grab,
    step: int
): bool {
    turned: bool = m.flip == m.flip_goal && m.spin == m.spin_goal;
    match grab {
        NoGrab -> false;
        WholeAir -> step == 0;
        AfterTurning -> turned && !keys.pad_held
    }
}

// How the steps of a run are taken: quietly, as the search takes them; or
// recorded as a replay, with its hits said as they come (the run found:
// see ride_moves), `said` of them so far.
type Telling = {
    recording: bool;
    said: int
}

quiet(): Telling {
    Telling { recording: false, said: 0 }
}

take_step(m: *Mover, keys: *Keys, told: *Telling) raises IoError {
    if (told.recording) rec_step(keys);
    step_course(m, keys, STEP_DT);
    if (told.recording) {
        rec_note(m);
        say_hits(m, told)
    }
}

// The most steps an air may take; and, after the finish, the most until
// the run scores no more.
const AIR_MOST: int = 1200;

const COAST_MOST: int = 2400;

// Let go into a trick, and fly it out, grabbing as asked: until he is down
// on the ground or a rail.
fly(
    m: *Mover,
    keys: *Keys,
    trick: Trick,
    told: *Telling
) raises IoError {
    set_release(keys, trick);
    take_step(m, keys, told);
    k: int = 0;
    while (m.air && k < AIR_MOST) {
        set_air(keys, grab_now(m, keys, trick.grab, k));
        take_step(m, keys, told);
        k = k + 1
    }
}

// Make a move from where he is.
perform(
    m: *Mover,
    keys: *Keys,
    move: Move,
    told: *Telling
) raises IoError {
    k: int = 0;
    match move.ending {
        GoOn -> {
            while (k < move.wait) {
                set_ride(m, keys, move.lane);
                take_step(m, keys, told);
                k = k + 1
            }
        }
        Jump jump -> {
            while (k < move.wait && !m.air) {
                set_ride(m, keys, move.lane);
                take_step(m, keys, told);
                k = k + 1
            }
            fly(m, keys, jump.trick, told)
        }
    }
}

// Past the finish: on until the run scores no more.
coast_out(m: *Mover, keys: *Keys, told: *Telling) raises IoError {
    k: int = 0;
    while (!run.closed && k < COAST_MOST) {
        set_coast(keys);
        take_step(m, keys, told);
        k = k + 1
    }
}

// ---- kept moments ----
// Where a run stands at a moment, kept to go on from: him, the keys and
// thumbs as they are held, and the run's score so far (what of it the
// judge looks back at: its points, the tricks done and how often, and the
// latest hit, which a grind adds to).
type Planner = {
    style: Style;
    // For a human run: how long it may take to come to each metre down
    // the hill (see PACE).
    pace: []f32;
    keep: int;
    stretches: int;
    // The kept moments: `keep` slots for each stretch, then the scratch
    // slots (see slot_hold).
    movers: []Mover;
    keys: []Keys;
    points: []f32;
    closed: []bool;
    last_hit: []Hit;
    has_hit: []bool;
    trick_kinds: []int;
    trick_keys: []int;
    trick_counts: []int;
    // In each stretch, how many slots are filled; and for each slot, what
    // makes it alike to another (see likeness_of), the move that led to
    // it, the record of the run before that move, and whether the move has
    // been made (if not, the slot holds only what the move should score,
    // and the slot it is made from).
    filled: []int;
    likeness: []int;
    led_by: []Move;
    parent: []int;
    made: []bool;
    made_from: []int;
    // When, in the run, he last came down (see SET_UP).
    landed: []f32;
    // The records of moments gone on from: each the record before it and
    // the move from there to it (the first, the start, has none: -1).
    record_parent: []int;
    record_move: []Move;
    records: int;
    // The best finished run: its points, the record before its last move,
    // and that move.
    best_points: f32;
    best_record: int;
    best_move: Move;
    // The judge's key for every trick an air can score as its own (see
    // air_key_index); and how often each has been done in the run being
    // gone on from.
    air_keys: []int;
    repeats: []int
}

// The two scratch slots past the stretches': where a move stopped to try
// a jump, and the moment just before a jump's release.
slot_hold(p: *Planner): int {
    p.stretches * p.keep
}

slot_release(p: *Planner): int {
    p.stretches * p.keep + 1
}

new_planner(style: Style, pace: []f32@new, keep: int): *Planner@new {
    stretches: int = (course_finish / STRETCH) as int + 2;
    slots: int = stretches * keep + 2;
    records: int = stretches * keep + 1;
    new Planner {
        style: style,
        pace: pace,
        keep: keep,
        stretches: stretches,
        movers: new Mover[slots](new_mover().*),
        keys: new Keys[slots](no_keys()),
        points: new f32[slots](0.0),
        closed: new bool[slots](false),
        last_hit: new Hit[slots](no_hit()),
        has_hit: new bool[slots](false),
        trick_kinds: new int[slots](0),
        trick_keys: new int[slots * MAX_KEYS](0),
        trick_counts: new int[slots * MAX_KEYS](0),
        filled: new int[stretches](0),
        likeness: new int[slots](0),
        led_by: new Move[slots](no_move()),
        parent: new int[slots](-1),
        made: new bool[slots](true),
        made_from: new int[slots](-1),
        landed: new f32[slots](0.0),
        record_parent: new int[records](-1),
        record_move: new Move[records](no_move()),
        records: 0,
        best_points: -1.0,
        best_record: -1,
        best_move: no_move(),
        air_keys: air_keys_all(),
        repeats: new int[AIR_KEYS](0)
    }
}

// Keep the moment in slot.
save_moment(
    p: *Planner,
    slot: int,
    m: *Mover,
    keys: *Keys
) {
    p.movers[slot] = m.*;
    p.keys[slot] = keys.*;
    p.points[slot] = run.points;
    p.closed[slot] = run.closed;
    p.has_hit[slot] = run.n > 0;
    if (run.n > 0) p.last_hit[slot] = run.hits[run.n - 1];
    p.trick_kinds[slot] = run.nkeys;
    for i in 0..run.nkeys {
        p.trick_keys[slot * MAX_KEYS + i] = run.keys[i];
        p.trick_counts[slot * MAX_KEYS + i] = run.key_count[i]
    }
}

// Go back to the moment in slot.
load_moment(
    p: *Planner,
    slot: int,
    m: *Mover,
    keys: *Keys
) {
    m.* = p.movers[slot];
    keys.* = p.keys[slot];
    run.points = p.points[slot];
    run.total = (run.points + 0.5) as int;
    run.closed = p.closed[slot];
    run.n = 0;
    if (p.has_hit[slot]) {
        run.hits[0] = p.last_hit[slot];
        run.n = 1
    }
    run.nkeys = p.trick_kinds[slot];
    for i in 0..run.nkeys {
        run.keys[i] = p.trick_keys[slot * MAX_KEYS + i];
        run.key_count[i] = p.trick_counts[slot * MAX_KEYS + i]
    }
}

// What makes two moments in a stretch too alike to keep both: where
// across the run he is (to 2 m), how fast (to 3 m/s), which way round he
// stands, and whether he is on a rail.
likeness_of(m: *Mover, fakie: bool): int {
    across: int = clampi(floorf((m.x + 20.0) / 2.0) as int, 0, 19);
    fast: int = clampi((m.speed / 3.0) as int, 0, 7);
    k: int = (across * 8 + fast) * 2;
    if (fakie) k = k + 1;
    k = k * 2;
    if (m.grinding) k = k + 1;
    k
}

// Whether he may be at x across the run and d down it at time t in the
// run (a human run keeps to the run, and keeps pace).
keeps_rules(
    p: *Planner,
    x: f32,
    d: f32,
    t: f32
): bool {
    match p.style {
        Wild -> true;
        Human -> absf(x) <= COURSE_HALF && t <= p.pace[clampi(floorf(d) as int, 0,
            len(p.pace) - 1)]
    }
}

// Whether he may pop a jump now, having last come down at `landed`.
may_pop(p: *Planner, m: *Mover, landed: f32): bool {
    match p.style {
        Wild -> true;
        Human -> m.run_t - landed >= SET_UP
    }
}

// How much sooner than the game asks his tricks must finish.
slack_of(p: *Planner): f32 {
    match p.style {
        Wild -> 0.0;
        Human -> SLACK
    }
}

// A slot for a run that has come to d down the hill, with points, alike
// to others as `like` says: in its stretch (after the one it came from),
// if it is among the best there; or -1.
claim_slot(
    p: *Planner,
    from_stretch: int,
    d: f32,
    like: int,
    points: f32
): int {
    at: int = clampi(maxi(floorf(d / STRETCH) as int, from_stretch + 1), 0, p.stretches - 1);
    first: int = at * p.keep;
    alike: int = -1;
    worst: int = -1;
    for i in first..first + p.filled[at] {
        if (p.likeness[i] == like) alike = i;
        if (worst < 0 || p.points[i] < p.points[worst]) worst = i
    }
    if (alike >= 0) {
        if (p.points[alike] >= points) return -1;
        return alike
    }
    if (p.filled[at] < p.keep) {
        p.filled[at] = p.filled[at] + 1;
        return first + p.filled[at] - 1
    }
    if (p.points[worst] >= points) return -1;
    worst
}

// The run, now at this moment, reached by move from record parent: kept
// if it is among the best in its stretch; or, if it is over, as the best
// finished run if it is that.
offer(
    p: *Planner,
    m: *Mover,
    keys: *Keys,
    from_stretch: int,
    parent: int,
    move: Move,
    landed: f32
) raises IoError {
    if (!keeps_rules(p, m.x, -m.z, m.run_t)) return;
    if (m.finished) {
        finish(p, m, keys, parent, move);
        return
    }
    like: int = likeness_of(m, m.fakie);
    slot: int = claim_slot(p, from_stretch, -m.z, like, run.points);
    if (slot < 0) return;
    save_moment(p, slot, m, keys);
    p.likeness[slot] = like;
    p.led_by[slot] = move;
    p.parent[slot] = parent;
    p.made[slot] = true;
    p.landed[slot] = landed
}

// A run not yet made: move, from the moment in slot `from` (of record
// parent), should come down as m does, at m.run_t, but standing as fakie
// says, and with points. Kept, unmade, if that would be among the best in
// its stretch.
offer_unmade(
    p: *Planner,
    m: *Mover,
    fakie: bool,
    points: f32,
    from_stretch: int,
    from: int,
    parent: int,
    move: Move
) {
    if (!keeps_rules(p, m.x, -m.z, m.run_t)) return;
    like: int = likeness_of(m, fakie);
    slot: int = claim_slot(p, from_stretch, -m.z, like, points);
    if (slot < 0) return;
    p.points[slot] = points;
    p.likeness[slot] = like;
    p.led_by[slot] = move;
    p.parent[slot] = parent;
    p.made[slot] = false;
    p.made_from[slot] = from;
    p.landed[slot] = m.run_t
}

// A run over the finish line: the best so far if it is. Past the line, he
// scores only what he is in the air for or grinding (the pad let go there
// starts no trick: see step_course), so the run is ridden on only until he
// is down, and off any rail.
finish(
    p: *Planner,
    m: *Mover,
    keys: *Keys,
    parent: int,
    move: Move
) raises IoError {
    told: Telling = quiet();
    k: int = 0;
    while (!run.closed && (m.air || m.grinding) && k < COAST_MOST) {
        set_coast(keys);
        take_step(m, keys, &told);
        k = k + 1
    }
    if (run.points > p.best_points) {
        p.best_points = run.points;
        p.best_record = parent;
        p.best_move = move
    }
}

// ---- tricks that fit an air ----
// Every trick an air can score as its own (see hit_key): off a feature or
// off flat ground, its flips and half turns, grabbed or not, and switch
// or not; by place, as air_key_index orders them.
const AIR_KEYS: int = 2 * 7 * 13 * 4;

air_key_index(
    flat: bool,
    flips: int,
    halves: int,
    grabbed: bool,
    sw: bool
): int {
    i: int = 0;
    if (flat) i = 1;
    i = (i * 7 + flips + 3) * 13 + halves + 6;
    i = i * 2;
    if (grabbed) i = i + 1;
    i = i * 2;
    if (sw) i = i + 1;
    i
}

// The judge's key for each of them.
air_keys_all(): []int@new {
    keys: []int = new int[AIR_KEYS](0);
    for flat in 0..2 {
        for flips in -3..4 {
            for halves in -6..7 {
                for g in 0..4 {
                    h: Hit = no_hit();
                    h.kind = HIT_AIR;
                    if (flat == 1) h.kind = HIT_FLAT;
                    h.flips = flips;
                    h.halves = halves;
                    h.grab = g % 2 == 1;
                    h.sw = g >= 2;
                    keys[air_key_index(flat == 1, flips, halves, h.grab, h.sw)] = hit_key(h)
                }
            }
        }
    }
    keys
}

// How often each has been done, in the run at the moment in slot.
count_repeats(p: *Planner, slot: int) {
    for i in 0..AIR_KEYS p.repeats[i] = 0;
    for k in 0..p.trick_kinds[slot] {
        key: int = p.trick_keys[slot * MAX_KEYS + k];
        for i in 0..AIR_KEYS {
            if (p.air_keys[i] == key) p.repeats[i] = p.trick_counts[slot * MAX_KEYS + k]
        }
    }
}

// An air, as flown with no trick: what it was off, how he stood, how long
// it was from the release to the landing and in all, and how long the
// game foresaw it as he let go (which the trick is fitted to: see
// start_trick).
type Air = {
    item: int;
    sw: bool;
    after_release: f32;
    total: f32;
    foreseen: f32
}

// A trick worth trying, and what it should score.
type Candidate = {
    trick: Trick;
    key: int;
    points: f32
}

// How long a trick takes to turn all it will, as start_trick paces it;
// and how much of the air a grab would be held, as it is taken.
turning_time(flips: int, halves: int, foreseen: f32): f32 {
    t: f32 = maxf(foreseen - FIT_MARGIN, 0.05);
    fit: f32 = maxf(trick_fit(flips, halves, foreseen), 1.0);
    flip_w: f32 = maxf(absi(flips) as f32 * TAU / t / fit, FLIP_MIN);
    spin_w: f32 = maxf(absi(halves) as f32 * PI / t / fit, SPIN_MIN);
    maxf(absi(flips) as f32 * TAU / flip_w, absi(halves) as f32 * PI / spin_w)
}

grab_share(air: Air, trick: Trick): f32 {
    turning: f32 = turning_time(trick.flips, trick.halves, air.foreseen);
    held: f32 = match trick.grab {
        NoGrab -> 0.0;
        WholeAir -> air.after_release - STEP_DT;
        AfterTurning -> air.after_release - turning - STEP_DT
    };
    maxf(held, 0.0) / maxf(air.total, 0.01)
}

// Whether the trick should land clean: it turns all it must before he is
// down, with `slack` to spare (grabbing all the air, it turns slower).
fits(air: Air, trick: Trick, slack: f32): bool {
    if (trick_fit(trick.flips, trick.halves, air.foreseen - slack) > 1.0) return false;
    match trick.grab {
        WholeAir -> turning_time(trick.flips, trick.halves, air.foreseen) / GRAB_SLOW <= air.after_release - STEP_DT - slack;
        _ -> true
    }
}

// What a trick scores in this air before it is repeated: its flips',
// spins' and grab's points, as the judge would score them (see judge_air).
// Whether its grab counts is `grabbed`, held for `share` of the air.
worth(
    air: Air,
    trick: Trick,
    grabbed: bool,
    share: f32
): f32 {
    gp: f32 = 0.0;
    if (grabbed) gp = 300.0 + 200.0 * share;
    kind: int = HIT_AIR;
    if (air.item < 0) kind = HIT_FLAT;
    // (A plain air scores only off a kicker, and only if long enough.)
    if (trick.flips == 0 && trick.halves == 0 && !grabbed && (kind != HIT_AIR || air.total < 0.6)) return 0.0;
    air_points(kind, air.item, absi(trick.flips), absi(trick.halves), gp, air.total,
        air.sw)
}

// What the trick should score in this air, in the run whose repeats are
// counted.
candidate(p: *Planner, air: Air, trick: Trick): Candidate {
    share: f32 = grab_share(air, trick);
    grabbed: bool = share > 0.25;
    index: int = air_key_index(air.item < 0, trick.flips, trick.halves, grabbed, air.sw);
    Candidate { trick: trick, key: index, points: worth(air, trick, grabbed, share) * powf(0.5,
        p.repeats[index] as f32) }
}

// The best few tricks for this air (but the plain one), best first: no two
// the same trick to the judge. How many there are. (A trick flipped back
// instead of forward, or spun left instead of right, scores the same but
// for repeats: of each shape, the way it has been done least is tried.)
best_tricks(p: *Planner, air: Air, best: []Candidate): int {
    n: int = 0;
    for flips in 0..4 {
        for halves in 0..7 {
            for g in 0..3 {
                grab: Grab = Grab.NoGrab;
                if (g == 1) grab = Grab.WholeAir;
                if (g == 2) grab = Grab.AfterTurning;
                plain: bool = flips == 0 && halves == 0;
                // (Taken after turning, a grab of no turn is one held all
                // the air.)
                shape: Trick = Trick { flips: flips, halves: halves, grab: grab };
                if (!(plain && g != 1) && fits(air, shape, slack_of(p))) {
                    share: f32 = grab_share(air, shape);
                    grabbed: bool = share > 0.25;
                    points: f32 = worth(air, shape, grabbed, share);
                    if (points > 0.0) n = rank(best, n, least_done(p, air, shape,
                        grabbed, points))
                }
            }
        }
    }
    n
}

// Of the ways a trick of this shape can go (flipping forward or back,
// spinning right or left), the one done least in the run, and what it
// should score.
least_done(
    p: *Planner,
    air: Air,
    shape: Trick,
    grabbed: bool,
    points: f32
): Candidate {
    least: Candidate = Candidate { trick: shape, key: -1, points: 0.0 };
    least_times: int = 0;
    flip_ways: int = 1;
    if (shape.flips != 0) flip_ways = 2;
    spin_ways: int = 1;
    if (shape.halves != 0) spin_ways = 2;
    for f in 0..flip_ways {
        for h in 0..spin_ways {
            trick: Trick = shape;
            if (f == 1) trick.flips = -shape.flips;
            if (h == 1) trick.halves = -shape.halves;
            index: int = air_key_index(air.item < 0, trick.flips, trick.halves, grabbed,
                air.sw);
            if (least.key < 0 || p.repeats[index] < least_times) {
                least = Candidate { trick: trick, key: index, points: points * powf(0.5,
                    p.repeats[index] as f32) };
                least_times = p.repeats[index]
            }
        }
    }
    least
}

// best, holding n candidates best first, with c among them if it is good
// enough (and better than one of the same key already there). How many it
// holds now.
rank(best: []Candidate, n: int, c: Candidate): int {
    for i in 0..n {
        if (best[i].key == c.key) {
            if (best[i].points >= c.points) return n;
            // (Out with the worse one; c is ranked below.)
            for j in i..n - 1 best[j] = best[j + 1];
            return rank(best, n - 1, c)
        }
    }
    at: int = n;
    while (at > 0 && best[at - 1].points < c.points) at = at - 1;
    if (at >= len(best)) return n;
    held: int = mini(n + 1, len(best));
    j: int = held - 1;
    while (j > at) {
        best[j] = best[j - 1];
        j = j - 1
    }
    best[at] = c;
    held
}

// ---- the search ----
// The lanes worth riding toward from where he is: where he is now; each
// kicker, gap, rail and box, and each halfpipe's walls, that comes within
// LANE_REACH; and the middle. (On a rail, there is only the rail.) Lanes
// within a metre of one already found are the same lane; past MAX_LANES,
// the rest (the farthest down the hill) are not ridden to.
const MAX_LANES: int = 10;

lanes_from(m: *Mover, lanes: []f32): int {
    n: int = 0;
    n = add_lane(lanes, n, m.x);
    if (m.grinding) return n;
    d: f32 = -m.z;
    for i in 0..nfeatures {
        f: Feature = features[i];
        ahead: bool = feature_to[i] > d && feature_from[i] < d + LANE_REACH;
        if (ahead && (f.kind == FEATURE_KICKER || f.kind == FEATURE_GAP)) n = add_lane(lanes,
            n, f.x);
        if (ahead && f.kind == FEATURE_PIPE) {
            n = add_lane(lanes, n, -pipe_wall(1.0));
            n = add_lane(lanes, n, pipe_wall(1.0))
        }
    }
    for i in 0..ncrails {
        r: CRail = crails[i];
        near: f32 = minf(-r.a.z, -r.b.z);
        far: f32 = maxf(-r.a.z, -r.b.z);
        if (far > d && near < d + LANE_REACH) {
            if (-r.a.z < -r.b.z) n = add_lane(lanes, n, r.a.x) else n = add_lane(lanes,
                n, r.b.x)
        }
    }
    add_lane(lanes, n, 0.0)
}

add_lane(lanes: []f32, n: int, x: f32): int {
    if (n >= len(lanes)) return n;
    for i in 0..n {
        if (absf(lanes[i] - x) < 1.0) return n
    }
    lanes[n] = x;
    n + 1
}

// What a search goes on from, at each moment: the moment's slot and
// stretch, the record of the run up to it, and scratch for the lanes and
// the tricks it tries.
type Going = {
    slot: int;
    // When he last came down, at the moment in slot.
    landed: f32;
    stretch: int;
    record: int;
    lanes: []f32;
    best: []Candidate
}

// How long until he comes down, flying as he is: as predict_air (in
// slope.l8) foresees it, in its steps of a sixtieth of a second, but
// looking at the ground only every FORESEE_STRIDE steps, and then for the
// first step under it between. (Each of its steps is found from the first
// at once: he falls as a stone does.)
const FORESEE_STRIDE: int = 4;

const FORESEE_MOST: int = 300;

foresee(m: *Mover): f32 {
    h: f32 = 1.0 / 60.0;
    after: int = FORESEE_MOST;
    k: int = FORESEE_STRIDE;
    while (k <= FORESEE_MOST) {
        if (down_by(m, k, h)) {
            after = k;
            k = FORESEE_MOST + 1
        } else k = k + FORESEE_STRIDE
    }
    first: int = maxi(after - FORESEE_STRIDE + 1, 1);
    while (first < after && !down_by(m, first, h)) first = first + 1;
    first as f32 * h
}

// Whether he is down on the ground (or under it) k steps of h on.
down_by(m: *Mover, k: int, h: f32): bool {
    t: f32 = k as f32 * h;
    y: f32 = m.y + h * (k as f32 * m.vy - SLOPE_G * h * (k * (k + 1) / 2) as f32);
    y <= course_height(m.x + m.vx * t, m.z + m.vz * t)
}

// From where the run is now, about to let go at the end of a move's ride:
// each jump worth trying, offered. One step is taken, to let go with no
// trick (the air is the same whatever he does in it); the rest of the air
// is foreseen as the game foresees it (see foresee), and each jump is
// kept unmade on where he should come down and what it should score. (Over
// the finish, where the run is done, the jumps are flown.)
try_jumps(
    p: *Planner,
    m: *Mover,
    keys: *Keys,
    going: *Going,
    lane: f32,
    wait: int
) raises IoError {
    // (Letting go changes him and the keys, not the run's score.)
    before: Mover = m.*;
    before_keys: Keys = keys.*;
    points: f32 = run.points;
    told: Telling = quiet();
    plain: Trick = Trick { flips: 0, halves: 0, grab: Grab.NoGrab };
    set_release(keys, plain);
    take_step(m, keys, &told);
    if (!m.air) return;
    ahead: f32 = foresee(m);
    air: Air = Air {
        item: m.air_from,
        sw: m.air_switch,
        after_release: ahead + STEP_DT,
        total: m.air_time + ahead + STEP_DT,
        foreseen: ahead + STEP_DT
    };
    // Where he should come down, how fast, and which way round.
    down: Mover = m.*;
    down.x = clampf(m.x + m.vx * ahead, -COURSE_HALF - 6.0, COURSE_HALF + 6.0);
    down.z = m.z + m.vz * ahead;
    down.speed = sqrtf(m.vx * m.vx + m.vz * m.vz);
    down.grinding = false;
    down.run_t = m.run_t + ahead;
    over: bool = m.finished || -down.z >= course_finish;
    held: int = slot_release(p);
    if (over) {
        save_moment(p, held, m, keys);
        p.movers[held] = before;
        p.keys[held] = before_keys
    }
    n: int = best_tricks(p, air, going.best);
    // (The plain jump too: it may score, off a kicker, and it lands on
    // rails that a trick still turning would miss.)
    for i in 0..n + 1 {
        c: Candidate = candidate(p, air, plain);
        if (i < n) c = going.best[i];
        move: Move = Move { lane: lane, wait: wait, ending: Ending.Jump { trick: c.trick } };
        if (over) {
            load_moment(p, held, m, keys);
            fly(m, keys, c.trick, &told);
            offer(p, m, keys, going.stretch, going.record, move, m.run_t)
        } else offer_unmade(p, &down, down.fakie != (absi(c.trick.halves) % 2 == 1),
            points + c.points, going.stretch, going.slot, going.record, move)
    }
}

// Go on from the moment in going's slot: every move from it, each tried,
// and what it comes to offered. (If the move to it is not yet made, it is
// made first; and if that finishes the run, the run is offered as done.)
go_on_from(
    p: *Planner,
    m: *Mover,
    keys: *Keys,
    going: *Going
) raises IoError {
    slot: int = going.slot;
    told: Telling = quiet();
    if (!p.made[slot]) {
        load_moment(p, p.made_from[slot], m, keys);
        perform(m, keys, p.led_by[slot], &told);
        if (!keeps_rules(p, m.x, -m.z, m.run_t)) return;
        if (m.finished) {
            finish(p, m, keys, p.parent[slot], p.led_by[slot]);
            return
        }
        save_moment(p, slot, m, keys);
        p.made[slot] = true;
        p.landed[slot] = m.run_t
    }
    going.landed = p.landed[slot];
    going.record = p.records;
    p.records = p.records + 1;
    p.record_parent[going.record] = p.parent[slot];
    p.record_move[going.record] = p.led_by[slot];
    count_repeats(p, slot);
    load_moment(p, slot, m, keys);
    nlanes: int = lanes_from(m, going.lanes);
    hold: int = slot_hold(p);
    last: int = jump_steps[len(jump_steps) - 1];
    for l in 0..nlanes {
        lane: f32 = going.lanes[l];
        load_moment(p, slot, m, keys);
        step: int = 0;
        jump_i: int = 0;
        go_on_i: int = 0;
        // (Whether he may pop yet: the moment he first may is a time to try
        // a jump too.)
        ready: bool = may_pop(p, m, going.landed);
        riding: bool = true;
        while (riding) {
            if (m.finished) {
                // (Over the line on the ground: the run is done.)
                offer(p, m, keys, going.stretch, going.record, Move { lane: lane, wait: step, ending: Ending.GoOn },
                    going.landed);
                riding = false
            } else {
                now_ready: bool = may_pop(p, m, going.landed);
                at_step: bool = jump_i < len(jump_steps) && jump_steps[jump_i] == step;
                if (at_step || now_ready && !ready) {
                    if (now_ready) {
                        save_moment(p, hold, m, keys);
                        try_jumps(p, m, keys, going, lane, step);
                        load_moment(p, hold, m, keys)
                    }
                    if (at_step) jump_i = jump_i + 1
                }
                ready = now_ready;
                if (go_on_i < len(go_on_steps) && go_on_steps[go_on_i] == step) {
                    save_moment(p, hold, m, keys);
                    offer(p, m, keys, going.stretch, going.record, Move { lane: lane, wait: step, ending: Ending.GoOn },
                        going.landed);
                    load_moment(p, hold, m, keys);
                    go_on_i = go_on_i + 1
                }
                if (step >= last) riding = false else {
                    set_ride(m, keys, lane);
                    take_step(m, keys, &told);
                    step = step + 1;
                    // (Off the run, or behind pace, a human run goes no
                    // farther this way.)
                    if (!keeps_rules(p, m.x, -m.z, m.run_t)) riding = false;
                    // Thrown into the air by the ground (off a lip, a
                    // cliff, a rail's end): he lets go there, into a trick.
                    if (riding && m.air) {
                        if (!m.finished) try_jumps(p, m, keys, going, lane, step);
                        riding = false
                    }
                }
            }
        }
    }
}

// Search the course as it is laid out, within `budget` nanoseconds; the
// best run's points. Each stretch has an even share of the time left: as
// many of its best runs are gone on from as that pays for, at what one has
// cost so far (all of them, at first; and never more than are kept).
search(
    p: *Planner,
    m: *Mover,
    keys: *Keys,
    budget: int
) raises IoError: f32 {
    going: Going = Going {
        slot: 0,
        landed: 0.0,
        stretch: 0,
        record: -1,
        lanes: new f32[MAX_LANES](0.0),
        best: new Candidate[TRICKS_TRIED](Candidate { trick: Trick { flips: 0, halves: 0, grab: Grab.NoGrab }, key: 0, points: 0.0 })
    };
    enter_course(m);
    keys.* = no_keys();
    save_moment(p, 0, m, keys);
    p.filled[0] = 1;
    p.parent[0] = -1;
    order: []int = new int[p.keep](0);
    started: int = mono_ns();
    gone_on: int = 0;
    report_every: int = (40.0 / STRETCH) as int;
    for at in 0..p.stretches {
        going.stretch = at;
        n: int = best_first(p, at, order);
        spent: int = mono_ns() - started;
        if (gone_on > 0) {
            share: int = (budget - spent) / (p.stretches - at);
            n = clampi(share / (spent / gone_on), 1, n)
        }
        for i in 0..n {
            going.slot = order[i];
            go_on_from(p, m, keys, &going)
        }
        gone_on = gone_on + n;
        if (at % report_every == report_every - 1) {
            write(2, "  ");
            write_int(2, ((at + 1) as f32 * STRETCH) as int);
            write(2, " m down: ");
            top: f32 = 0.0;
            for i in 0..p.filled[at] top = maxf(top, p.points[at * p.keep + i]);
            write_int(2, (top + 0.5) as int);
            write(2, " points so far at best\n")
        }
    }
    write(2, "  ");
    write_int(2, gone_on);
    write(2, " moments gone on from, in ");
    write_int(2, (mono_ns() - started) / 1000000);
    write(2, " ms\n");
    p.best_points
}

// The slots of stretch `at` into order, highest-scoring first; how many.
best_first(p: *Planner, at: int, order: []int): int {
    n: int = p.filled[at];
    for i in 0..n {
        slot: int = at * p.keep + i;
        j: int = i;
        while (j > 0 && p.points[order[j - 1]] < p.points[slot]) {
            order[j] = order[j - 1];
            j = j - 1
        }
        order[j] = slot
    }
    n
}

// The best run's moves, first to last, into moves; how many.
best_moves(p: *Planner, moves: []Move): int {
    before: int = 0;
    r: int = p.best_record;
    while (r >= 0 && p.record_parent[r] >= 0) {
        before = before + 1;
        r = p.record_parent[r]
    }
    moves[before] = p.best_move;
    r = p.best_record;
    i: int = before - 1;
    while (i >= 0) {
        moves[i] = p.record_move[r];
        r = p.record_parent[r];
        i = i - 1
    }
    before + 1
}

// ---- the run found ----
// Ride the moves from the top, recorded as a replay (see replay.l8), each
// hit said as he makes it.
ride_moves(
    m: *Mover,
    keys: *Keys,
    moves: []Move,
    n: int
) raises IoError {
    enter_course(m);
    keys.* = no_keys();
    rec_begin();
    told: Telling = Telling { recording: true, said: 0 };
    for i in 0..n perform(m, keys, moves[i], &told);
    coast_out(m, keys, &told)
}

// Any hits not yet said, a line each: where, off what, the trick, and its
// points.
say_hits(m: *Mover, told: *Telling) raises IoError {
    for i in told.said..run.n {
        h: Hit = run.hits[i];
        write(1, "  ");
        write_int(1, (-m.z + 0.5) as int);
        write(1, " m  ");
        text_len = 0;
        if (h.kind == HIT_AIR || h.kind == HIT_SKETCH) append(item_name(h.item)) else if (h.kind == HIT_FLAT) append("FLAT");
        if (text_len > 0) append(": ");
        hit_text(h);
        if (h.kind == HIT_SKETCH) append("  SKETCHY");
        write_bytes_n(1, text_buf, text_len);
        write(1, "  ");
        write_int(1, (h.points + 0.5) as int);
        write(1, "\n")
    }
    told.said = run.n
}

// The replay written to path, read and played back as the game plays one
// (see read_watch, and the V key in main.l8): what it scores, or -1 if
// the game could not read it.
played_back(m: *Mover, keys: *Keys, path: str): int {
    if (!read_replay_file(path)) return -1;
    play_begin(m, REC_FRIEND);
    keys.* = no_keys();
    while (play_step(keys)) step_course(m, keys, STEP_DT);
    play_which = -1;
    run.total
}

// Ride the course with no hands, for something to measure the best
// against. (Its points are the run's; see finish_time for its time.) When
// he came to each metre down the hill, into reached (and to those past the
// finish, when he stopped).
ride_hands_off(m: *Mover, keys: *Keys, reached: []f32) {
    enter_course(m);
    keys.* = no_keys();
    k: int = 0;
    metre: int = 0;
    while (!run.closed && k < MAX_REC) {
        step_course(m, keys, STEP_DT);
        while (metre < len(reached) && -m.z >= metre as f32) {
            reached[metre] = m.run_t;
            metre = metre + 1
        }
        k = k + 1
    }
    while (metre < len(reached)) {
        reached[metre] = m.run_t;
        metre = metre + 1
    }
}

// How long a human run may take to come to each metre, riding straight
// down having come to them as `reached` says.
pace_from(reached: []f32): []f32@new {
    pace: []f32 = new f32[len(reached)](0.0);
    for i in 0..len(reached) pace[i] = PACE * reached[i] + PACE_SPARE;
    pace
}

// What a style is called in a replay's name, and to people.
style_name(style: Style): str {
    match style {
        Wild -> "WILD_LINE";
        Human -> "HUMAN_LINE"
    }
}

// How long the run just ridden took to the finish line, in seconds.
finish_time(m: *Mover): int {
    (m.run_t - m.finish_t + 0.5) as int
}

// What the run just ridden scored where: off features, off flat ground
// (and rollers), and on rails and boxes; and how long it took.
say_sources(m: *Mover, hands_off_time: int) raises IoError {
    features: f32 = 0.0;
    flat: f32 = 0.0;
    rails: f32 = 0.0;
    for i in 0..run.n {
        h: Hit = run.hits[i];
        if (h.kind == HIT_AIR) features = features + h.points;
        if (h.kind == HIT_FLAT) flat = flat + h.points;
        if (h.kind == HIT_RAIL || h.kind == HIT_BOX) rails = rails + h.points
    }
    write(1, "  off features ");
    write_int(1, (features + 0.5) as int);
    write(1, ", off flat ground ");
    write_int(1, (flat + 0.5) as int);
    write(1, ", on rails and boxes ");
    write_int(1, (rails + 0.5) as int);
    write(1, "; ");
    write_int(1, finish_time(m));
    write(1, " s to the finish (with no hands, ");
    write_int(1, hands_off_time);
    write(1, " s)\n")
}

// Write the replay just ridden to path, as the game reads it from
// watch.txt (see rec_read): its version, course, score, a name, and its
// steps. Whether it could be written.
//
// (Opened to write, made if need be, and emptied: O_WRONLY | O_CREAT |
// O_TRUNC, on Linux; readable by all, writable by its owner: 0644.)
const OPEN_WRITE: int = 577;

const OPEN_MODE: int = 420;

write_replay(path: str, style: Style) raises IoError: bool {
    fd: int = open(path, OPEN_WRITE, OPEN_MODE);
    if (fd < 0) return false;
    write_int(fd, REPLAY_VERSION);
    write(fd, " ");
    write_int(fd, rec_seed[REC_NOW]);
    write(fd, " ");
    write_int(fd, rec_score[REC_NOW]);
    write(fd, " ");
    write(fd, style_name(style));
    write(fd, " ");
    rec_write(fd, REC_NOW);
    write(fd, "\n");
    close(fd);
    true
}

// ---- the command ----
usage() raises IoError {
    eprint("usage: skate-route COURSE [--human] [--seconds N] [--out FILE]");
    eprint("  COURSE  a slopestyle's number, as the game shows it");
    eprint("  --human  keep to what a person could do: keep moving, stay on the run,");
    eprint("           a second to set up each jump, tricks with time to spare");
    eprint("  --seconds  how long to search (default 10): longer searches wider");
    eprint("  --out   where to write the replay (default watch.txt, which the game plays on V)")
}

// A whole number of at least 1 from text, or 0 if it is not one.
count_of(text: str): int {
    if (len(text) == 0 || len(text) > 9) return 0;
    n: int = 0;
    // (48 to 57: the digits 0 to 9.)
    for i in 0..len(text) {
        c: int = text[i] as int;
        if (c < 48 || c > 57) return 0;
        n = n * 10 + c - 48
    }
    n
}

main(argc: int, argv: []str) raises IoError: int {
    course: int = 0;
    seconds: int = DEFAULT_SECONDS;
    style: Style = Style.Wild;
    out: str = "watch.txt";
    i: int = 1;
    while (i < argc) {
        a: str = argv[i];
        if (a == "--seconds" && i + 1 < argc) {
            seconds = count_of(argv[i + 1]);
            if (seconds == 0) {
                eprint("skate-route: --seconds wants a whole number of at least 1");
                return 2
            }
            i = i + 2
        } else if (a == "--human") {
            style = Style.Human;
            i = i + 1
        } else if (a == "--out" && i + 1 < argc) {
            out = argv[i + 1];
            i = i + 2
        } else if (course == 0 && count_of(a) > 0) {
            course = count_of(a);
            i = i + 1
        } else {
            usage();
            return 2
        }
    }
    if (course == 0) {
        usage();
        return 2
    }
    park = false;
    course_seed = course;
    load_course();
    m: *Mover = new_mover();
    keys: Keys = no_keys();
    reached: []f32 = new f32[course_finish as int + 2](0.0);
    ride_hands_off(m, &keys, reached);
    plain: int = run.total;
    plain_time: int = finish_time(m);
    write(1, "course ");
    write_int(1, course);
    write(1, ": ridden with no hands, ");
    write_int(1, plain);
    write(1, " points\n");
    p: *Planner = new_planner(style, pace_from(reached), KEEP);
    found: f32 = search(p, m, &keys, seconds * 1000000000);
    if (p.best_record < 0) {
        eprint("skate-route: no run reached the finish");
        return 1
    }
    moves: []Move = new Move[p.records + 1](no_move());
    n: int = best_moves(p, moves);
    write(1, "the best ");
    match style {
        Wild -> write(1, "line found, anything the game allows:\n");
        Human -> write(1, "line found that a person could ride:\n")
    }
    ride_moves(m, &keys, moves, n);
    write(1, "in all ");
    write_int(1, run.total);
    write(1, " points, in ");
    write_int(1, n);
    write(1, " moves\n");
    say_sources(m, plain_time);
    if (run.total != (found + 0.5) as int) {
        write(1, "(the search counted ");
        write_int(1, (found + 0.5) as int);
        write(1, ": riding it again came out differently)\n")
    }
    found_total: int = run.total;
    if (!write_replay(out, style)) {
        write(2, "skate-route: could not write ");
        write(2, out);
        write(2, "\n");
        return 1
    }
    back: int = played_back(m, &keys, out);
    if (back != found_total) {
        write(2, "skate-route: the replay in ");
        write(2, out);
        write(2, ", played back as the game plays it, scores ");
        write_int(2, back);
        write(2, ", not ");
        write_int(2, found_total);
        write(2, "\n");
        return 1
    }
    write(1, "replay written to ");
    write(1, out);
    if (out == "watch.txt") write(1, ": to watch it, press V in the game run from this directory\n") else write(1,
        ": to watch it, put it in watch.txt where the game runs and press V\n");
    0
}
