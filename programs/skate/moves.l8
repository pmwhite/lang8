tag skate;

use_tag blockguy;

// What he does on his board, as a BoardMove: the body's lean and turn, each
// leg's knee and squash (on the board; and in the air, its hip too), each
// arm, the board's tilt under him, and a hand reaching for the board's
// tail. pose_guy mixes the moves the animation has weights for, and makes a
// GuyPose of the mix (see move_pose).
//
// Sides are his own (side 0 is his -x), but most moves speak of his lead
// side (toward where the board goes: his +x side riding regular, his -x
// riding switch) and his trail side (see Sides).
type BoardMove = {
    pitch: f32;
    roll: f32;
    yaw: f32;
    knee: [2]f32;
    squash: [2]f32;
    hip: [2]f32;
    arms: [2]GuyArm;
    // The board tipped up at his lead end (+), at the middle of it or about
    // the trailing wheels, as much as tail_pivot (0 to 1).
    tilt: f32;
    tail_pivot: f32;
    // The board turned under him about his up (+ as a yaw: see GuyBody),
    // his feet turning with it.
    board_yaw: f32;
    // How far the trail hand reaches for the board's tail (0 to 1).
    grab: f32
}

type Sides = {
    lead: int;
    trail: int;
    // +1 if the lead side is his +x.
    lead_x: f32
}

sides_of(m: *Mover): Sides {
    if (m.fakie) return Sides { lead: 0, trail: 1, lead_x: -1.0 };
    Sides { lead: 1, trail: 0, lead_x: 1.0 }
}

const DEG: f32 = 0.017453292;

// An arm by its flex, abduction and elbow (degrees); its paddle twisting
// as it rises out to the side so that its broad face stays upright (see
// guy_flipper_twist).
arm_deg(flex: f32, abduct: f32, elbow: f32): GuyArm {
    GuyArm {
        flex: flex * DEG,
        abduct: abduct * DEG,
        twist: guy_flipper_twist(abduct * DEG),
        elbow: elbow * DEG,
        forearm_twist: 0.0
    }
}

mix_move(a: BoardMove, b: BoardMove, t: f32): BoardMove {
    if (t <= 0.0) return a;
    r: BoardMove = a;
    r.pitch = lerpf(a.pitch, b.pitch, t);
    r.roll = lerpf(a.roll, b.roll, t);
    r.yaw = lerpf(a.yaw, b.yaw, t);
    for i in 0..2 {
        r.knee[i] = lerpf(a.knee[i], b.knee[i], t);
        r.squash[i] = lerpf(a.squash[i], b.squash[i], t);
        r.hip[i] = lerpf(a.hip[i], b.hip[i], t);
        r.arms[i] = mix_arm(a.arms[i], b.arms[i], t)
    }
    r.tilt = lerpf(a.tilt, b.tilt, t);
    r.tail_pivot = lerpf(a.tail_pivot, b.tail_pivot, t);
    r.board_yaw = lerpf(a.board_yaw, b.board_yaw, t);
    r.grab = lerpf(a.grab, b.grab, t);
    r
}

// ---- riding ----
// Riding: knees and hips a little loose (10), the body a little forward
// (4), the arms out from his sides (40, swaying 5 either way slowly, out
// of step), elbows a little bent.
move_ride(a: *Anim): BoardMove {
    sway: f32 = 5.0 * sinf(a.time * TAU * 0.4);
    BoardMove {
        pitch: 4.0 * DEG,
        roll: 0.0,
        yaw: 0.0,
        knee: [10.0 * DEG, 10.0 * DEG],
        squash: [1.0, 1.0],
        hip: [10.0 * DEG, 10.0 * DEG],
        arms: [arm_deg(10.0, 40.0 + sway, 10.0), arm_deg(10.0, 40.0 - sway, 10.0)],
        tilt: 0.0,
        tail_pivot: 0.0,
        board_yaw: 0.0,
        grab: 0.0
    }
}

// Carving, as far as `toe` (toward his toes, +, to his heels, -; the arms
// follow the lean a moment behind it: see Anim.arm_lean). Toeside, the lead
// arm hangs toward the inside of the turn and the trail arm is out level
// toward the tail; heelside, both arms reach forward to counter him sitting
// back.
move_carve(a: *Anim, st: Sides, toe: f32): BoardMove {
    k: f32 = absf(toe);
    mv: BoardMove = move_ride(a);
    mv.pitch = (4.0 + 10.0 * toe) * DEG;
    for i in 0..2 {
        mv.knee[i] = (10.0 + 8.0 * k) * DEG;
        mv.squash[i] = 1.0 - 0.05 * k
    }
    if (toe > 0.0) {
        mv.arms[st.lead] = arm_deg(20.0, 20.0, 15.0);
        mv.arms[st.trail] = arm_deg(0.0, 95.0, 30.0)
    } else {
        mv.arms[st.lead] = arm_deg(50.0, 50.0, 25.0);
        mv.arms[st.trail] = arm_deg(50.0, 30.0, 25.0)
    }
    mv
}

// Winding up (as far as crouch): sunk, the arms swung back past him, nearly
// straight; aiming a spin, the body turned against it; a flip, leaning
// away from it.
move_windup(m: *Mover): BoardMove {
    mv: BoardMove = BoardMove {
        pitch: 10.0 * DEG,
        roll: 0.0,
        yaw: m.wind_x * 0.7,
        knee: [40.0 * DEG, 40.0 * DEG],
        squash: [0.78, 0.78],
        hip: [40.0 * DEG, 40.0 * DEG],
        arms: [arm_deg(-45.0, 25.0, 10.0), arm_deg(-45.0, 25.0, 10.0)],
        tilt: 0.0,
        tail_pivot: 0.0,
        board_yaw: 0.0,
        grab: 0.0
    };
    back: f32 = 0.22 * m.wind_y;
    if (m.fakie) back = -back;
    mv.roll = -back;
    mv
}

// The pop, its first moment: snapping up tall, legs stretched, the arms
// starting to rise (the lead arm higher); aiming a spin, the lead arm
// opening the way of it and the other across his chest.
move_pop(m: *Mover, st: Sides, ride: BoardMove): BoardMove {
    mv: BoardMove = ride;
    mv.pitch = 2.0 * DEG;
    for i in 0..2 {
        mv.knee[i] = 5.0 * DEG;
        mv.squash[i] = 1.05;
        mv.hip[i] = 5.0 * DEG
    }
    since: f32 = minf(m.since_hop, 1.0);
    mv.arms[st.trail] = arm_deg(5.0, air_arm(since, 1.0, 0.0, TRAIL_ARM_AIR), 10.0);
    mv.arms[st.lead] = arm_deg(5.0, air_arm(since, 1.0, 0.0, LEAD_ARM_AIR), 10.0);
    // (Spinning to the right turns him from his face toward his -x side:
    // that side leads the spin.)
    // (Less as the spin nears its end: not let go of all at once.)
    spinning: f32 = smoothstepf(0.1, 0.5, absf(m.spin_goal - m.spin));
    if (spinning > 0.0) {
        leading: int = 1;
        if (m.spin_goal < m.spin) leading = 0;
        mv.arms[leading] = mix_arm(mv.arms[leading], arm_deg(30.0, 90.0, 15.0), spinning);
        mv.arms[1 - leading] = mix_arm(mv.arms[1 - leading], arm_deg(60.0, 0.0, 90.0),
            spinning)
    }
    mv
}

// In the air, `through` (0 to 1) of it: the knees up, the board with them
// (knees 60, hips 55, the legs squashed to 0.8, so that the shins hang
// near upright over the board); the arms rising to their highest at the
// top of the air (the lead arm higher) and coming down for the landing;
// turning a trick, the arms pulled in to turn, opening as it ends. The
// legs reach down again for the landing over the last quarter.
move_air(
    a: *Anim,
    m: *Mover,
    st: Sides,
    through: f32
): BoardMove {
    tuck: f32 = smoothstepf(0.0, 0.15, through) * (1.0 - smoothstepf(0.75, 1.0, through));
    mv: BoardMove = move_ride(a);
    mv.pitch = 4.0 * DEG;
    for i in 0..2 {
        mv.knee[i] = lerpf(10.0, 60.0, tuck) * DEG;
        mv.hip[i] = lerpf(10.0, 55.0, tuck) * DEG;
        mv.squash[i] = lerpf(1.0, 0.8, tuck)
    }
    since: f32 = through * a.air_total;
    mv.arms[st.trail] = arm_deg(0.0, air_arm(since, a.air_total, through, TRAIL_ARM_AIR),
        10.0);
    mv.arms[st.lead] = arm_deg(0.0, air_arm(since, a.air_total, through, LEAD_ARM_AIR),
        10.0);
    // (Pulled in over its first moment, not at once; opening over the last
    // quarter of the turning: see Anim.tuck.)
    if (a.tuck > 0.001) {
        for i in 0..2 mv.arms[i] = mix_arm(mv.arms[i], mix_arm(arm_deg(40.0, 15.0,
            100.0), arm_deg(0.0, 60.0, 20.0), a.tuck_open), a.tuck)
    }
    mv
}

// The arms' abduction through an ollie's air (degrees), the trail arm's
// and the lead's: at the pop, 0.12 s after it, and at the top of the air.
// The lead (nose) arm goes higher.
TRAIL_ARM_AIR: []f32 = [25.0, 75.0, 90.0];

LEAD_ARM_AIR: []f32 = [50.0, 105.0, 130.0];

// An arm's abduction `since` the pop, in an air `total` long, `through`
// of it: rising quickly through the pop, then to its highest at the top of
// the air, held, and down to 60 over the last quarter.
air_arm(
    since: f32,
    total: f32,
    through: f32,
    keys: []f32
): f32 {
    rise: f32 = 0.12;
    top: f32 = maxf(total * 0.5, rise + 0.01);
    a: f32 = keys[2];
    if (since < rise) a = lerpf(keys[0], keys[1], smoothstepf(0.0, rise, since)) else if (since < top) a = lerpf(keys[1],
        keys[2], smoothstepf(rise, top, since));
    lerpf(a, 60.0, smoothstepf(0.75, 1.0, through))
}

// How far the board turns out under him in a grab, and his body with it
// (degrees).
const GRAB_BOARD_YAW: f32 = 25.0;

const GRAB_BODY_YAW: f32 = 25.0;

// A tail grab: the knees up hard (the trail knee more), the board tipped
// tail up toward his trail hand, which holds the tail's tip; the body
// rolled toward the tail and a little forward; the lead arm out level.
move_grab(st: Sides, air: BoardMove): BoardMove {
    mv: BoardMove = air;
    mv.pitch = 8.0 * DEG;
    mv.roll = -20.0 * st.lead_x * DEG;
    // (The knees pulled up far enough that the board's tail comes up to
    // his hand: a paddle arm is short.)
    mv.knee[st.trail] = 115.0 * DEG;
    mv.knee[st.lead] = 100.0 * DEG;
    mv.hip[st.trail] = 70.0 * DEG;
    mv.hip[st.lead] = 60.0 * DEG;
    mv.squash[st.trail] = 0.75;
    mv.squash[st.lead] = 0.75;
    mv.arms[st.lead] = arm_deg(0.0, 95.0, 15.0);
    mv.arms[st.trail] = arm_deg(30.0, 20.0, 10.0);
    mv.tilt = -18.0 * DEG;
    mv.tail_pivot = 0.0;
    // (Turned out from under him, tail toward his heel side, his body
    // turning a little with it: so that from behind, his hand and the tail
    // are out beside him.)
    mv.board_yaw = GRAB_BOARD_YAW * st.lead_x * DEG;
    mv.yaw = GRAB_BODY_YAW * st.lead_x * DEG;
    mv.grab = 1.0;
    mv
}

// The landing soaked up (the fall's speed, `fall`): knees down and legs
// squashed, more for a bigger fall, the body a little forward, the arms
// coming forward over his toes.
move_land(base: BoardMove, fall: f32): BoardMove {
    mv: BoardMove = base;
    mv.pitch = 6.0 * DEG;
    for i in 0..2 {
        mv.knee[i] = minf(12.0 + 4.8 * fall, 48.0) * DEG;
        mv.squash[i] = maxf(1.0 - 0.025 * fall, 0.8);
        mv.arms[i] = arm_deg(60.0, 30.0, 20.0)
    }
    mv
}

// Landed crooked, `t` seconds ago (see Mover.sketch_t): the arms
// windmilling, out of step, one down as the other goes up (its elbow
// bending as it goes up), the weight rocking from foot to foot. (How much
// of it shows, fading, is the caller's: see pose_guy.)
move_sketch(base: BoardMove, t: f32): BoardMove {
    mv: BoardMove = base;
    for i in 0..2 {
        wave: f32 = sinf(t * 26.0 + i as f32 * PI);
        abduct: f32 = 80.0 + 50.0 * wave;
        mv.arms[i] = arm_deg(10.0, abduct, lerpf(10.0, 60.0, (abduct - 30.0) / 100.0));
        rock: f32 = 0.5 + 0.5 * sinf(t * 13.0 + i as f32 * PI);
        mv.knee[i] = lerpf(8.0, 28.0, rock) * DEG;
        mv.squash[i] = lerpf(1.0, 0.85, rock)
    }
    mv
}

// Grinding: low, the arms low and loose and uneven, swapping slowly as he
// rolls a little from side to side to balance.
move_grind(a: *Anim): BoardMove {
    sway: f32 = sinf(a.time * TAU * 1.2);
    w: f32 = 0.5 + 0.5 * sway;
    BoardMove {
        pitch: 4.0 * DEG,
        roll: 4.0 * sway * DEG,
        yaw: 0.0,
        knee: [24.0 * DEG, 24.0 * DEG],
        squash: [0.9, 0.9],
        hip: [24.0 * DEG, 24.0 * DEG],
        arms: [arm_deg(10.0, lerpf(20.0, 50.0, w), lerpf(40.0, 5.0, w)), arm_deg(10.0,
            lerpf(50.0, 20.0, w), lerpf(5.0, 40.0, w))],
        tilt: 0.0,
        tail_pivot: 0.0,
        board_yaw: 0.0,
        grab: 0.0
    }
}

// Stopping at the finish: dragging the tail, the board nose up about its
// trailing wheels, the trail leg low, leaning toward the tail.
move_stop(st: Sides, base: BoardMove): BoardMove {
    mv: BoardMove = base;
    mv.roll = -10.0 * st.lead_x * DEG;
    mv.knee[st.trail] = 40.0 * DEG;
    mv.squash[st.trail] = 0.85;
    // (The lead foot is up on the nose: squashed, not folded.)
    mv.squash[st.lead] = 0.78;
    for i in 0..2 mv.arms[i] = arm_deg(30.0, 40.0, 20.0);
    mv.tilt = 12.0 * DEG;
    mv.tail_pivot = 1.0;
    mv
}

// ---- the move as a pose ----
// Where his feet stand on the board: over its trucks, under his hips.
const STANCE_X: f32 = 0.2;

// How far his feet turn on the board with his body (winding up, say): the
// hips alone can turn only so far against the feet.
const FEET_TURN: f32 = 0.5;

// How far his lead foot turns toward the nose.
const LEAD_FOOT_YAW: f32 = 15.0;

// The pose of a move, `aloft` (0 to 1) in the air: on the board, his
// ankles over the trucks and his pelvis as low as his knees and squash put
// it; aloft, the legs hang from his hips by their angles (the board comes
// up under them: see pose_board). The board's tilt lifts the foot over the
// tipped end.
move_pose(
    mv: BoardMove,
    st: Sides,
    aloft: f32,
    breath: f32,
    squash: f32
): GuyPose {
    p: GuyPose = guy_stand();
    p.body.pitch = mv.pitch;
    p.body.roll = mv.roll;
    p.body.yaw = mv.yaw;
    p.body.squash = squash;
    p.body.breath = breath;
    // (The pelvis as low as the legs' reach on the board, over their spread
    // feet: the mean of the two.)
    stand: f32 = GUY_PELVIS_Y - GUY_ANKLE_UP;
    spread: f32 = STANCE_X - GUY_HIP_X;
    reach: f32 = 0.0;
    for i in 0..2 {
        r: f32 = guy_leg_reach(mv.knee[i], mv.squash[i]);
        reach = reach + sqrtf(maxf(r * r - spread * spread, 0.0)) * 0.5
    }
    p.body.drop = (stand - reach) * (1.0 - aloft);
    for i in 0..2 {
        s: f32 = guy_side_sign(i);
        // (His feet turn on the board half as far as his body does.)
        on_board: V3 = v3(s * STANCE_X, GUY_ANKLE_UP, GUY_PELVIS_Z);
        on_board = v_add(v_rotate(v_sub(on_board, guy_pelvis()), Y_AXIS, mv.yaw * FEET_TURN),
            guy_pelvis());
        on_board.y = on_board.y + sinf(mv.tilt) * (s * st.lead_x * STANCE_X + mv.tail_pivot * STANCE_X);
        // (Hanging, only as far as he is aloft: on the ground, not worked out.)
        p.ankle[i] = on_board;
        if (aloft > 0.0) p.ankle[i] = v_lerp(on_board, leg_hanging(mv, i), aloft);
        p.leg_squash[i] = mv.squash[i];
        // (The sole lying on the board tipped under it.)
        p.foot_roll[i] = mv.tilt * st.lead_x;
        p.arms[i] = mv.arms[i]
    }
    for i in 0..2 p.foot_yaw[i] = mv.yaw * FEET_TURN;
    p.foot_yaw[st.lead] = p.foot_yaw[st.lead] + st.lead_x * LEAD_FOOT_YAW * DEG;
    p
}

// A leg's ankle hanging from its hip by the move's hip and knee angles,
// over its foot's place on the board (as far out as STANCE_X).
leg_hanging(mv: BoardMove, side: int): V3 {
    upright: GuyBody = guy_stand().body;
    out: f32 = atan2f(STANCE_X - GUY_HIP_X, GUY_THIGH + GUY_SHIN);
    guy_leg_ankle(upright, side, mv.hip[side], mv.knee[side], out, mv.squash[side])
}

// ---- pushing ----
// Pushing, drawn to read from behind him (where the camera is): turned
// half toward the nose, so that the camera sees his back and side; the
// lead leg nearly straight on the bolts; the arm on the pushing leg's side
// swinging forward as that leg sweeps back, the other arm out; elbows
// soft. (The legs' places: see push_feet, in pose.l8.)
move_push(a: *Anim, st: Sides): BoardMove {
    phase: f32 = push_phase(a);
    sweep: f32 = smoothstepf(PUSH_DOWN, PUSH_UP, phase) * (1.0 - smoothstepf(PUSH_UP,
        PUSH_STROKE, phase));
    mv: BoardMove = move_ride(a);
    mv.yaw = 50.0 * st.lead_x * DEG;
    mv.pitch = 8.0 * DEG;
    mv.knee[st.lead] = 16.0 * DEG;
    mv.squash[st.lead] = 0.9;
    mv.knee[st.trail] = 10.0 * DEG;
    mv.squash[st.trail] = 1.0;
    mv.arms[st.trail] = arm_deg(35.0 * sweep, 25.0, 15.0);
    mv.arms[st.lead] = arm_deg(0.0, 50.0, 15.0);
    mv
}

// A stroke: reaching down (to PUSH_DOWN), planted (to PUSH_UP), and
// coming back up onto the board.
const PUSH_STROKE: f32 = 0.5;

const PUSH_DOWN: f32 = 0.1;

const PUSH_UP: f32 = 0.32;

// How low his pelvis sinks pushing, and how far his trail leg stretches
// to reach the ground: the deck is more than half his leg's height, so
// the leg stretches, a toy's, rather than his folding up on the lead leg.
const PUSH_DROP: f32 = 0.04;

const PUSH_STRETCH: f32 = 1.5;

// How his feet turn pushing: the lead foot forward on the bolts, the push
// foot turned toward the way he goes, as far as his hips (which turn with
// him, pushing) let it.
const PUSH_LEAD_YAW: f32 = 60.0;

const PUSH_FOOT_YAW: f32 = 60.0;

// Where the push foot's toe is put down: so far ahead of the hip, and out
// past the board's toe edge; and how far behind the hip it comes up again
// (a sweep of 0.35 m: about 0.12 s at 3 m/s). Planted, the foot is held
// as its shin has it, toe pointed (its ankle at PUSH_POINT, + toe down).
const PUSH_PLANT_AHEAD: f32 = 0.05;

const PUSH_PLANT_OUT: f32 = 0.24;

const PUSH_PLANT_BEHIND: f32 = 0.3;

const PUSH_POINT: f32 = 0.35
