tag skate;

// The guy on his board: where he is and how he moves, what he is doing in
// the air or on a rail, and the keys and thumbs that steer him. How he
// moves is in slope.l8.

// Physics steps at 120 Hz.
const STEP_DT: f32 = 0.008333334;

// How fast his heading turns at the most, for how far he leans into it.
const TURN_RATE: f32 = 4.0;

type Keys = {
    held: [4]bool;
    hop: bool;
    hop_held: bool;
    // X: pressed since the last step, and held now.
    style: bool;
    style_held: bool;
    // The thumbs (see touch.l8): how hard the steering thumb turns him and
    // whether one is down; whether the trick pad is held, pressed or let go
    // since the last step; and the trick it aims at, in half turns to the
    // right and flips forward.
    stick_x: f32;
    stick_on: bool;
    pad_held: bool;
    pad_press: bool;
    pad_release: bool;
    aim_x: f32;
    aim_y: f32
}

no_keys(): Keys {
    Keys {
        held: [false, false, false, false],
        hop: false,
        hop_held: false,
        style: false,
        style_held: false,
        stick_x: 0.0,
        stick_on: false,
        pad_held: false,
        pad_press: false,
        pad_release: false,
        aim_x: 0.0,
        aim_y: 0.0
    }
}

type Mover = {
    x: f32;
    z: f32;
    y: f32;
    prev: V3;
    vx: f32;
    vz: f32;
    // Which way the board points, and its speed along that way.
    heading: f32;
    speed: f32;
    turn_rate: f32;
    air: bool;
    vy: f32;
    since_hop: f32;
    grinding: bool;
    since_grind: f32;
    air_time: f32;
    // The latest landing's and bonk's speeds, for the squash.
    land: f32;
    bonk: f32;
    // How far from straight down the run he heads (see carve_dir); his flip
    // and spin so far in the air, how fast they turn, and where they end
    // up; whether he rides switch; how long he has grabbed; whether he
    // popped; the rail he rides and how far along it; the ground's normal;
    // since a sketchy landing; and the finish.
    carve: f32;
    flip: f32;
    flip_w: f32;
    flip_goal: f32;
    spin: f32;
    spin_w: f32;
    spin_goal: f32;
    fakie: bool;
    grab_t: f32;
    ollied: bool;
    crail: int;
    crail_t: f32;
    ground_n: V3;
    sketch_t: f32;
    finished: bool;
    finish_t: f32;
    // Crouched on the trick pad: the trick aimed at (flips forward, half
    // turns to the right), and eased, for his wind-up; and whether the pad,
    // pressed in the air, is a grab.
    winding: bool;
    aim_flips: int;
    aim_halves: int;
    wind_x: f32;
    wind_y: f32;
    pad_grab: bool;
    // What he flew off, or -1; and how fast his carve turns.
    air_from: int;
    air_feature: bool;
    carve_w: f32;
    // Whether he took off riding switch; off a wall, his carve and speed
    // going up it, and the level way into it; and while aiming, how long
    // he would fly, and off what kind of feature (or -1).
    air_switch: bool;
    pipe_carve: f32;
    pipe_speed: f32;
    pipe_vert: bool;
    pipe_n: V3;
    aim_air: f32;
    aim_item: int;
    // And the next jump on his way, if one is near: how long he would fly
    // letting go at its lip, and off what (0, and -1, with none).
    ahead_air: f32;
    ahead_item: int
}

new_mover(): *Mover@new {
    new Mover {
        x: 0.0,
        z: 0.0,
        y: 0.0,
        prev: v3(0.0, 0.0, 0.0),
        vx: 0.0,
        vz: 0.0,
        heading: PI,
        speed: 0.0,
        turn_rate: 0.0,
        air: false,
        vy: 0.0,
        since_hop: 10.0,
        grinding: false,
        since_grind: 10.0,
        air_time: 0.0,
        land: 0.0,
        bonk: 0.0,
        carve: 0.0,
        flip: 0.0,
        flip_w: 0.0,
        flip_goal: 0.0,
        spin: 0.0,
        spin_w: 0.0,
        spin_goal: 0.0,
        fakie: false,
        grab_t: 0.0,
        ollied: false,
        crail: 0,
        crail_t: 0.0,
        ground_n: v3(0.0, 1.0, 0.0),
        sketch_t: 10.0,
        finished: false,
        finish_t: 0.0,
        winding: false,
        aim_flips: 0,
        aim_halves: 0,
        wind_x: 0.0,
        wind_y: 0.0,
        pad_grab: false,
        air_from: -1,
        air_feature: false,
        carve_w: 0.0,
        air_switch: false,
        pipe_carve: 0.0,
        pipe_speed: 0.0,
        pipe_vert: false,
        pipe_n: v3(0.0, 0.0, 0.0),
        aim_air: 0.0,
        aim_item: -1,
        ahead_air: 0.0,
        ahead_item: -1
    }
}

// As new: at rest, upright, riding forward, with nothing left of the run
// before (so that a run begins the same every time: see replay.l8).
reset_mover(m: *Mover) {
    m.* = fresh_mover.*
}

fresh_mover: *Mover = new_mover()
