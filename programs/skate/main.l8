tag skate;

use_tag std;

use_tag gl, x11;

import "../../stdlib/print.l8";

// A block guy and his skateboard, on a slope course or in a skatepark (see
// park.l8); Tab goes from one to the other.
//
//   .build/skate
//
// Left and right steer (see slope.l8). Space is the trick pad: held, he
// crouches, and each arrow pressed adds a turn that way; let go, he jumps
// into the trick. X grabs. On a phone the screen's left half is a stick
// that steers and its right half the trick pad (see touch.l8). R starts
// over, N lays out a new course; Escape quits.
import "../gl/gl.l8";

import "breathe.l8";

import "math.l8";

import "mover.l8";

import "judge.l8";

import "course.l8";

import "layout.l8";

import "slope.l8";

import "replay.l8";

import "tutorial.l8";

import "park.l8";

import "grass.l8";

import "glow.l8";

import "touch.l8";

import "hud.l8";

import "mesh.l8";

import "pose.l8";

import "render.l8";

extern getenv(name: str): ?*i8;

extern l8_environment(): []str@new;

// The camera follows him from behind.
type Camera = {
    target: V3;
    eye: V3;
    // On the course, the way it looks across the run (as his carve).
    yaw: f32;
    // Its lens, when it is not the usual one (or 0).
    fov: f32
}

// In a replay, cameras stand beside the run, every TV_GAP down it on one
// side and then the other; each watches him come, pass, and go, closing in
// on him as a long lens does.
const TV_GAP: f32 = 46.0;

update_tv_camera(c: *Camera, pos: V3) {
    if (park) {
        update_park_camera(c, pos);
        return
    }
    d: f32 = -pos.z;
    k: f32 = floorf((d + 14.0) / TV_GAP);
    cd: f32 = k * TV_GAP + 22.0;
    side: f32 = 1.0;
    if (k as int % 2 != 0) side = -1.0;
    x: f32 = side * (COURSE_HALF + 2.5);
    c.eye = v3(x, course_height(x, -cd) + 2.6, -cd);
    c.target = v3(pos.x, pos.y + 0.9, pos.z);
    c.fov = clampf(2.0 * atan2f(4.5, v_len(v_sub(c.eye, c.target))), 0.28, 1.0)
}

// In a park, four cameras stand up beyond its deck, at the middle of each
// side; the nearest watches him, and gives him up to another only when
// that one is a good deal nearer.
tv_park: int = 0;

park_camera_at(k: int): V3 {
    reach: f32 = bowl_top() + PARK_DECK + 3.0;
    if (k == 0) return v3(0.0, 7.0, PARK_HZ + reach);
    if (k == 1) return v3(PARK_HX + reach, 7.0, 0.0);
    if (k == 2) return v3(0.0, 7.0, -(PARK_HZ + reach));
    v3(-(PARK_HX + reach), 7.0, 0.0)
}

update_park_camera(c: *Camera, pos: V3) {
    best: int = tv_park;
    for k in 0..4 {
        if (v_len(v_sub(park_camera_at(k), pos)) < v_len(v_sub(park_camera_at(best),
            pos)) - 8.0) best = k
    }
    tv_park = best;
    c.eye = park_camera_at(best);
    c.target = v3(pos.x, pos.y + 0.9, pos.z);
    c.fov = clampf(2.0 * atan2f(5.5, v_len(v_sub(c.eye, c.target))), 0.28, 1.0)
}

// Showing a place off, for the page (which holds a key down while it has
// the place's sheet up: see openPlace, in web/skate/skate.js): the camera
// goes over it, t seconds in. Down a course from above its start to past
// its finish, and round again; round a park, looking in. Where it looks
// from and at, and the middle of what it sees.
fly_eye: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

fly_at: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

fly_over(t: f32): V3 {
    if (park) {
        a: f32 = t * 0.2;
        fly_eye = v3(sinf(a) * (PARK_HX + 17.0), 14.0, cosf(a) * (PARK_HZ + 13.0));
        fly_at = v3(0.0, 0.0, 0.0);
        return fly_at
    }
    span: f32 = COURSE_FINISH + 40.0 - COURSE_START;
    along: f32 = t * 14.0;
    d: f32 = COURSE_START + along - floorf(along / span) * span;
    fly_eye = v3(sinf(t * 0.3) * 6.0, course_base(d - 18.0) + 11.0, -(d - 18.0));
    fly_at = v3(0.0, course_base(d + 10.0) + 1.0, -(d + 10.0));
    fly_at
}

// Watch recording which (see replay.l8), if there is one of this place.
start_replay(m: *Mover, which: int): bool {
    // (The run just finished is the last one.)
    rec_keep();
    if (!can_play(which)) return false;
    play_begin(m, which);
    true
}

// What the page listens for (see web/skate/skate.js): the course he is on,
// each run's score as he finishes it, what he is doing (L8RIDE: see the
// frame loop), and (L8OVER 1, or 0) whether a run is over that can be
// watched again.
say_course() raises IoError {
    write(1, "L8COURSE ");
    write_int(1, run_id());
    print("")
}

// (And the run itself, for the page to pass on: see replay.l8.) A run is
// told of once its score is final: FINISH_TAIL past the line, or when he
// starts over before that.
say_run(which: int) raises IoError {
    write(1, "L8FINISH ");
    write_int(1, rec_seed[which]);
    write(1, " ");
    write_int(1, rec_score[which]);
    print("");
    write(1, "L8REPLAY ");
    write_int(1, REPLAY_VERSION);
    write(1, " ");
    write_int(1, rec_seed[which]);
    write(1, " ");
    write_int(1, rec_score[which]);
    write(1, " ");
    rec_write(which);
    print("")
}

// Tell the page of the run under way, if it has finished and has not been
// told (before it is thrown away).
say_now() raises IoError {
    if (rec_done && !rec_said && rec_n[REC_NOW] > 0 && play_which < 0) {
        say_run(REC_NOW);
        rec_said = true
    }
}

const CAM_FOLLOW: f32 = 0.6;

// It follows from behind him, looking ahead the way he rides, turning
// after him a little late.
update_course_camera(
    c: *Camera,
    pos: V3,
    yaw: f32,
    dt: f32
) {
    // It turns only partway with him, so that the hill stays a steady
    // guide; in the park, all the way, a little sooner.
    follow: f32 = CAM_FOLLOW;
    rate: f32 = 2.0;
    if (park) {
        follow = 1.0;
        rate = 3.0
    }
    c.yaw = approach_angle(c.yaw, yaw * follow, ease(rate, dt));
    f: V3 = carve_dir(c.yaw);
    // (On the flat, looking a little higher, to see across it.)
    lift: f32 = 1.0;
    if (park) lift = 1.8;
    want: V3 = v_madd(v_add(pos, v3(0.0, lift, 0.0)), f, 2.0);
    // Back at the top, it cuts there.
    if (v_len(v_sub(want, c.target)) > 30.0) {
        c.yaw = yaw * follow;
        f = carve_dir(c.yaw);
        want = v_madd(v_add(pos, v3(0.0, lift, 0.0)), f, 2.0);
        c.target = want
    }
    c.target.x = lerpf(c.target.x, want.x, ease(7.0, dt));
    c.target.y = lerpf(c.target.y, want.y, ease(5.0, dt));
    c.target.z = lerpf(c.target.z, want.z, ease(7.0, dt));
    c.eye = v_add(v_madd(c.target, f, -8.5), v3(0.0, 4.2, 0.0))
}

// The camera's vertical field of view: wide enough across that a tall
// window, as on a phone held upright, still sees to the sides.
view_fovy(): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    // tan of the narrowest half angle across.
    across: f32 = 0.4466;
    maxf(0.62, 2.0 * atan2f(across, aspect))
}

// On the course in a tall window, as on a phone held upright, the picture
// moves up, so that he rides above the touch panels in the middle of the
// screen.
view_shift(): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    clampf((1.0 - aspect) * 0.8, 0.0, 0.45)
}

// The report at the finish scrolls with a dragged finger: by how far it
// moved since the last frame, in rows.
drag_b: int = -1;

drag_y: f32 = 0.0;

drag_report() {
    b: int = -1;
    for i in 1..MAX_BUTTONS {
        if (b < 0 && pointers.down[i]) b = i
    }
    if (b < 0 || !hud_finished) {
        drag_b = -1;
        return
    }
    if (b == drag_b && row_h > 0.0) hud_scroll = hud_scroll - (pointers.y[b] - drag_y) / row_h;
    drag_b = b;
    drag_y = pointers.y[b]
}

// L8_SEED=n lays out course n; otherwise each start is a new one.
seed_from_env(): int {
    prefix: str = "L8_SEED=";
    for e in l8_environment() {
        if (len(e) > len(prefix) && starts_with(e, prefix)) {
            n: int = 0;
            for i in len(prefix)..len(e) {
                c: int = e[i] as int;
                if (c >= 48 && c <= 57) n = n * 10 + c - 48
            }
            return n
        }
    }
    mono_ns() / 1000 % 100000
}

// The look's letter, from L8_LOOK (see Look, in render.l8), or 0.
look_from_env(): int {
    prefix: str = "L8_LOOK=";
    for e in l8_environment() {
        if (len(e) > len(prefix) && starts_with(e, prefix)) return e[len(prefix)] as int
    }
    0
}

// Go to place id (a course's number, or a park's, negative: see run_id):
// its ground and its grass built, and him at its start.
go_to(
    m: *Mover,
    r: *Renderer,
    world: *Mesh,
    id: int
) raises IoError {
    // (Another place's replays and best are no use here.)
    if (id != run_id() || !world_built) {
        rec_forget();
        run.best_run = 0
    }
    world_built = true;
    play_which = -1;
    // (The page shows that it is loading, until it is told otherwise; and
    // the work stops for a frame every so often: see breathe.l8.)
    print("L8LOAD 1");
    breathe_begin();
    breathe_stage = 0;
    park = id < 0;
    if (park) {
        park_seed = -id;
        load_park();
        breathe_stage = 1;
        breathe();
        build_park_grass();
        breathe_stage = 2;
        breathe();
        build_park(world)
    } else {
        course_seed = id;
        load_course();
        breathe_stage = 1;
        breathe();
        build_grass();
        breathe_stage = 2;
        breathe();
        build_course(world)
    }
    breathe_stage = 3;
    breathe();
    set_course_mesh(r, world);
    breathe_stage = 4;
    breathe();
    set_course_lamps(r);
    set_course_glows(r);
    set_grass(r);
    start_over(m);
    rec_begin();
    if (getenv("L8_TRACE") != null) {
        write(2, "longest without a frame, ms: ");
        write_int(2, breathe_longest / 1000000);
        write(2, " at stage ");
        write_int(2, breathe_worst);
        write(2, "\n")
    }
    print("L8LOAD 0")
}

world_built: bool = false;

// Where to go next (see go_to), or 0. It is built after a frame that says
// so: it takes a moment.
go_id: int = 0;

// The look by day (its letter: see pick_look), for L to go back to from
// night.
day_look: int = 98;

ask_go(id: int) {
    if (hud_building != 0 || id == 0) return;
    go_id = id;
    hud_building = 1
}

// A place of the same kind as this one, picked at random.
random_place(): int {
    n: int = (absi(run_id()) % 100000 * 48271 + mono_ns() / 1000) % 100000 + 1;
    if (park) return -n;
    n
}

starts_with(s: str, prefix: str): bool {
    for i in 0..len(prefix) {
        if (s[i] != prefix[i]) return false
    }
    true
}

// Keys by direction: arrows and WASD, +x right and +z toward the camera.
key_dir(ks: int): int {
    if (ks == 65363 || ks == 100) return 0;
    if (ks == 65364 || ks == 115) return 1;
    if (ks == 65361 || ks == 97) return 2;
    if (ks == 65362 || ks == 119) return 3;
    -1
}

key_down(keys: *Keys, ks: int) {
    d: int = key_dir(ks);
    if (d >= 0) keys.held[d] = true;
    if (ks == 32) {
        if (!keys.hop_held) keys.hop = true;
        keys.hop_held = true
    }
    if (ks == 120) {
        if (!keys.style_held) keys.style = true;
        keys.style_held = true
    }
}

key_up(keys: *Keys, ks: int) {
    if (ks == 120) keys.style_held = false;
    if (ks == 32) keys.hop_held = false;
    d: int = key_dir(ks);
    if (d >= 0) keys.held[d] = false
}

trace(m: *Mover) raises IoError {
    write(2, "pos ");
    write_int(2, (m.x * 100.0) as int);
    write(2, " ");
    write_int(2, (m.y * 100.0) as int);
    write(2, " ");
    write_int(2, (m.z * 100.0) as int);
    write(2, " speed ");
    write_int(2, (m.speed * 100.0) as int);
    write(2, " air ");
    write_int(2, m.air as int);
    write(2, " grind ");
    write_int(2, m.grinding as int);
    write(2, " wind ");
    write_int(2, (m.wind_x * 100.0) as int);
    write(2, " ");
    write_int(2, (m.wind_y * 100.0) as int);
    write(2, " w ");
    write_int(2, (m.spin_w * 100.0) as int);
    write(2, " ");
    write_int(2, (m.flip_w * 100.0) as int);
    write(2, "\n")
}

main() raises IoError: int {
    // The look first: the meshes take its colors.
    grass_on = getenv("L8_NO_GRASS") == null;
    pick_look(look_from_env());
    if (!look.night && look_from_env() != 0) day_look = look_from_env();
    world: *Mesh = new_mesh(1600000);
    parts: *Mesh = new_mesh(60000);
    build_parts(parts);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    // Keys, buttons, pointer motion, structure, exposure.
    screen_w = 1280;
    screen_h = 720;
    win: int = XCreateWindow(dpy, root, 0, 0, screen_w, screen_h, 0, vis.depth as int,
        1, vis.visual, 10248, &wa);
    if (win == 0) die("XCreateWindow failed");
    XStoreName(dpy, win, "L8 skate");
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    eprint("L8 skate: arrows steer; hold Space, tap arrows, release to jump; Space in the air grabs; R restart, N new course, P replay, L night or day, Escape quits");
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    r: *Renderer = new_renderer(parts);
    m: *Mover = new_mover();
    // On a page (which says so: L8_PAGE), the work of building stops for
    // frames (see breathe.l8).
    breathe_on = getenv("L8_PAGE") != null;
    breathe_dpy = dpy;
    breathe_win = win;
    hud_page = breathe_on;
    // L8_SEED is the course to start on; with L8_PARK, the park.
    first: int = seed_from_env();
    if (getenv("L8_PARK") != null) first = -first;
    go_to(m, r, world, first);
    write(1, "L8VERSION ");
    write_int(1, REPLAY_VERSION);
    print("");
    say_course();
    a: *Anim = new_anim(m.heading, m.y);
    start: V3 = v3(m.x, m.y, m.z);
    cam: *Camera = new Camera {
        target: start,
        eye: start,
        yaw: 0.0,
        fov: 0.0
    };
    // A replay is watched from beside the run, or (C) from behind him as
    // he rode it. A course's number typed (then Enter), and how long ago.
    tv: bool = true;
    hud_touch = getenv("L8_TOUCH") != null;
    // A friend's run to watch, once its course is built.
    watch_pending: bool = false;
    typed: int = -1;
    typed_t: f32 = 0.0;
    was_finished: bool = false;
    said_over: bool = false;
    said_ride: int = -1;
    friend_over: bool = false;
    update_course_camera(cam, start, m.carve, 10.0);
    keys: Keys = no_keys();
    shadows: bool = getenv("L8_NO_SHADOWS") == null;
    tracing: bool = getenv("L8_TRACE") != null;
    trace_ns: int = 0;
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = mono_ns();
    start_ns: int = prev_ns;
    acc: f32 = 0.0;
    // Pause, held: the page holds it while its guide is open. Time stands
    // still, but the frames go on.
    paused: bool = false;
    // And another, held while the page shows a place off (see fly_over),
    // and for how long it has.
    preview: bool = false;
    preview_t: f32 = 0.0;
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65307) running = false;
                    if (ks == 65299) paused = true;
                    if (ks == 65300 && !preview) {
                        preview = true;
                        preview_t = 0.0
                    }
                    // Watching a replay, Backspace goes back from it (as the
                    // page's button does): from a run of his own to its end,
                    // where he was when he asked to watch it; from a
                    // friend's to the top, ready to ride. R starts over from
                    // either; C changes its camera.
                    stopped: bool = false;
                    // Reading a lesson of the tutorial, Space (or Enter) goes
                    // on with it, and nothing else does anything.
                    if (in_tutorial() && tut_state == TUT_READ && (ks == 32 || ks == 65293 || key_dir(ks) >= 0)) {
                        if (tut_waiting() && key_dir(ks) < 0) tut_go();
                        stopped = true
                    }
                    // T: the tutorial.
                    if (ks == 116) ask_go(TUTORIAL);
                    if (play_which >= 0 && (ks == 65288 || ks == 114)) {
                        if (ks == 65288 && play_which != REC_FRIEND) {
                            // (The rest of it, all at once.)
                            while (play_step(&keys)) step_course(m, &keys, STEP_DT);
                            run.closed = true;
                            play_which = -1
                        } else {
                            play_which = -1;
                            start_over(m);
                            rec_begin()
                        }
                        pointers_clear(&keys);
                        for d in 0..4 keys.held[d] = false;
                        keys.hop_held = false;
                        keys.style_held = false;
                        a.y = m.y;
                        cam.target = v3(m.x, m.y, m.z);
                        update_course_camera(cam, cam.target, m.carve, 10.0);
                        stopped = true
                    } else if (play_which < 0 && (ks == 112 || ks == 98)) {
                        // P: watch the last run again; B: the best.
                        which: int = REC_LAST;
                        if (ks == 98) which = REC_BEST;
                        if (start_replay(m, which)) {
                            pointers_clear(&keys);
                            a.y = m.y;
                            cam.target = v3(m.x, m.y, m.z);
                            update_course_camera(cam, cam.target, m.carve, 10.0)
                        }
                    }
                    if (ks == 99) tv = !tv;
                    // V: watch the friend's run the page has handed over, on
                    // its course (going there first, if he is elsewhere).
                    if (ks == 118 && hud_building == 0 && read_watch()) {
                        if (rec_seed[REC_FRIEND] != run_id()) {
                            ask_go(rec_seed[REC_FRIEND]);
                            watch_pending = hud_building != 0
                        } else if (start_replay(m, REC_FRIEND)) {
                            pointers_clear(&keys);
                            a.y = m.y;
                            cam.target = v3(m.x, m.y, m.z);
                            update_course_camera(cam, cam.target, m.carve, 10.0)
                        }
                    }
                    // A number typed, and Enter: that course; and Tab: that
                    // park. [ and ]: the one before, and the next. Tab alone:
                    // from the course to the park, or back.
                    if (ks >= 48 && ks <= 57) {
                        if (typed < 0) typed = 0;
                        typed = mini(typed * 10 + ks - 48, 99999999);
                        typed_t = 0.0
                    }
                    if (ks == 65293 && typed > 0) ask_go(typed);
                    if (ks == 65289) {
                        if (typed > 0) ask_go(-typed) else if (park) ask_go(course_seed) else ask_go(-park_seed)
                    }
                    here: int = absi(run_id());
                    if (ks == 93) {
                        if (in_tutorial()) ask_go(1) else ask_go(signi(run_id()) * (here + 1))
                    }
                    if (ks == 91 && here > 1 && !in_tutorial()) ask_go(signi(run_id()) * (here - 1));
                    if (hud_building != 0) typed = -1;
                    if (ks == 114 && !stopped) {
                        say_now();
                        start_over(m);
                        rec_begin();
                        cam.target = v3(m.x, m.y, m.z);
                        update_course_camera(cam, cam.target, m.carve, 10.0);
                        a.y = m.y
                    }
                    // N: a new course (or park), at random.
                    if (ks == 110) ask_go(random_place());
                    // At the finish, up and down scroll the report.
                    if (m.finished) {
                        if (ks == 65362 || ks == 119) hud_scroll = hud_scroll - 4.0;
                        if (ks == 65364 || ks == 115) hud_scroll = hud_scroll + 4.0
                    }
                    // L: night, or day again. Only the light changes (the
                    // lamps stand by day too, unlit: see place_lamps), so
                    // he rides on through it.
                    if (ks == 108) {
                        if (look.night) pick_look(day_look) else pick_look(110)
                    }
                    // Space is the trick pad, and arrows pressed while it is
                    // held aim the trick.
                    if (keys.hop_held && key_dir(ks) >= 0) aim_key(&keys, key_dir(ks));
                    if (!stopped) {
                        key_down(&keys, ks);
                        if (ks == 32) pad_press(&keys)
                    }
                }
                KeyRelease -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    key_up(&keys, ks);
                    if (ks == 65299) paused = false;
                    if (ks == 65300) preview = false;
                    if (ks == 32) pad_release(&keys)
                }
                ButtonPress b -> {
                    // (A replay takes no notice of a tap.)
                    if (play_which >= 0) { } else if (in_tutorial() && tut_state == TUT_READ) {
                        // (Reading a lesson: a tap goes on with it.)
                        if (tut_waiting()) tut_go()
                    } else pointer_down(&keys, b.button as int, b.x as f32, b.y as f32)
                }
                ButtonRelease b -> pointer_up(&keys, b.button as int);
                MotionNotify mo -> pointer_move(mo.state as int, mo.x as f32, mo.y as f32);
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        screen_w = c.width as int;
                        screen_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        if (running && hud_building == 2) {
            say_now();
            go_to(m, r, world, go_id);
            go_id = 0;
            say_course();
            if (watch_pending) {
                watch_pending = false;
                if (start_replay(m, REC_FRIEND)) pointers_clear(&keys)
            }
            pointers_clear(&keys);
            a.y = m.y;
            cam.target = v3(m.x, m.y, m.z);
            update_course_camera(cam, cam.target, m.carve, 10.0);
            hud_building = 0;
            prev_ns = mono_ns()
        }
        if (hud_building == 1) hud_building = 2;
        if (running) {
            now: int = mono_ns();
            dns: int = now - prev_ns;
            prev_ns = now;
            if (dns < 0) dns = 0;
            if (dns > 100000000) dns = 100000000;
            if (preview) preview_t = preview_t + dns as f32 / 1000000000.0;
            if (paused || preview) dns = 0;
            dt: f32 = dns as f32 / 1000000000.0;
            acc = acc + dt;
            steps: int = 0;
            read_pads(&keys);
            // The tutorial holds the game while he reads.
            tut_frame(m, dt);
            if (tut_holding()) acc = 0.0;
            while (acc >= STEP_DT && steps < 12 && !tut_holding()) {
                // A replay tells him what he was told; otherwise what he is
                // told is recorded.
                if (play_which >= 0) {
                    if (!play_step(&keys)) {
                        // (The run it was is over: it scores no more.)
                        run.closed = true;
                        friend_over = play_which == REC_FRIEND;
                        play_which = -1;
                        pointers_clear(&keys);
                        for d in 0..4 keys.held[d] = false;
                        keys.hop_held = false;
                        keys.style_held = false
                    }
                } else if (!in_tutorial()) rec_step(&keys);
                starts: int = course_starts;
                best: int = run.best_run;
                step_course(m, &keys, STEP_DT);
                // (A friend's run is not his best.)
                if (play_which == REC_FRIEND) run.best_run = best;
                if (in_tutorial()) {
                    // (From the tutorial's finish, on to the first course.)
                    if (course_starts != starts) ask_go(1);
                    tut_step(m, STEP_DT)
                } else if (play_which < 0) {
                    if (course_starts != starts) {
                        rec_drop();
                        rec_begin()
                    } else rec_note(m)
                }
                acc = acc - STEP_DT;
                steps = steps + 1
            }
            // A friend's run, watched to its end: he is back at the top,
            // ready to ride.
            if (friend_over) {
                friend_over = false;
                start_over(m);
                rec_begin();
                pointers_clear(&keys);
                a.y = m.y;
                cam.target = v3(m.x, m.y, m.z);
                update_course_camera(cam, cam.target, m.carve, 10.0)
            }
            // He has been put somewhere by the tutorial: nothing held carries
            // over, and the camera cuts to him.
            if (tut_cut) {
                tut_cut = false;
                pointers_clear(&keys);
                a.y = m.y;
                cam.target = v3(m.x, m.y, m.z);
                update_course_camera(cam, cam.target, m.carve, 10.0)
            }
            if (play_which < 0 && m.finished && m.finish_t > FINISH_TAIL) say_now();
            if (rec_tell >= 0) {
                say_run(rec_tell);
                rec_tell = -1
            }
            was_finished = m.finished;
            typed_t = typed_t + dt;
            if (typed_t > 4.0) typed = -1;
            hud_typed = typed;
            hud_blink = hud_blink + dt;
            hud_replay = play_which;
            hud_can_replay = rec_done || can_play(REC_LAST);
            // The page offers the run again once it is over (and not while
            // it is being watched).
            over: bool = m.finished && m.finish_t > 1.5 && play_which < 0 && hud_can_replay;
            // And what he is doing, for its buttons: riding (0), at the end
            // of a run (1), or watching one, his own (2) or a friend's (3).
            ride: int = 0;
            if (play_which == REC_FRIEND) ride = 3 else if (play_which >= 0) ride = 2 else if (m.finished) ride = 1;
            if (ride != said_ride) {
                said_ride = ride;
                write(1, "L8RIDE ");
                write_int(1, ride);
                print("")
            }
            if (over != said_over) {
                said_over = over;
                if (over) print("L8OVER 1") else print("L8OVER 0")
            }
            if (acc > STEP_DT) acc = 0.0;
            alpha: f32 = acc / STEP_DT;
            pos: V3 = v_lerp(m.prev, v3(m.x, m.y, m.z), alpha);
            update_anim(a, m, dt);
            pose(a, m, pos);
            // Up off a wall in the park, it turns round ahead of him, to the
            // way he will come back down.
            cam_yaw: f32 = m.carve;
            if (park && m.air && m.pipe_vert) cam_yaw = mirror_carve(m.pipe_carve,
                m.pipe_n);
            update_course_camera(cam, pos, cam_yaw, dt);
            cam.fov = 0.0;
            if (play_which >= 0 && tv) update_tv_camera(cam, pos);
            hud_finished = m.finished;
            // At the finish, a finger dragged up or down scrolls the report.
            drag_report();
            if (!hud_finished) hud_scroll = 0.0;
            hud_finish_t = m.finish_t;
            hud_aiming = m.winding;
            hud_carve = m.carve;
            hud_aim_flips = m.aim_flips;
            hud_aim_halves = m.aim_halves;
            hud_aim_air = m.aim_air;
            hud_aim_need = trick_need(m.aim_flips, m.aim_halves);
            // The trick's worth reads for the next jump, if one is near;
            // the bar, for now.
            plan_air: f32 = m.aim_air;
            plan_item: int = m.aim_item;
            if (m.ahead_air > 0.0) {
                plan_air = m.ahead_air;
                plan_item = m.ahead_item
            }
            hud_aim_plan = plan_air;
            hud_aim_on = m.aim_item >= 0;
            hud_aim_ahead = m.ahead_air > 0.0;
            aim_kind: int = HIT_FLAT;
            if (plan_item >= 0) aim_kind = HIT_AIR;
            hud_aim_value = aim_value(aim_kind, plan_item, m.aim_flips, m.aim_halves,
                plan_air, m.fakie);
            hud_aim_repeat = aim_repeats(aim_kind, m.aim_flips, m.aim_halves, m.fakie);
            hud_aim_switch = m.fakie;
            hud_rider_d = -m.z;
            update_marks(m);
            hud_dt = dt;
            find_zones();
            hud_seed = run_id();
            hud_time_left = PARK_TIME - m.run_t;
            view: View = View {
                eye: cam.eye,
                at: cam.target,
                fovy: view_fovy(),
                focus: pos,
                rider: pos,
                time: (now - start_ns) as f32 / 1000000000.0,
                shift: view_shift()
            };
            if (cam.fov > 0.0) {
                // (A tall window sees less across: a wider lens for it.)
                view.fovy = minf(cam.fov / minf(screen_w as f32 / maxf(screen_h as f32,
                    1.0), 1.0), 1.3);
                view.shift = 0.0
            }
            if (preview) {
                view.focus = fly_over(preview_t);
                view.eye = fly_eye;
                view.at = fly_at;
                view.fovy = view_fovy();
                view.shift = view_shift()
            }
            draw_scene(r, view, shadows);
            if (!preview) draw_hud(r);
            if (tracing && now - trace_ns > 250000000) {
                trace_ns = now;
                trace(m)
            }
            glXSwapBuffers(dpy, win)
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}
