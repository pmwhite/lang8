tag skate;

use_tag std;

use_tag gl, x11;

import "../../stdlib/print.l8";

// A block guy and his skateboard, on a slope course or in a small sunny
// park; Tab goes from one to the other.
//
//   .build/skate
//
// On the course (see slope.l8), left and right carve. Space is the trick
// pad: held, he crouches, and each arrow pressed adds a turn that way; let
// go, he jumps into the trick. X grabs. On a phone the screen's left half
// is a stick that steers and its right half the trick pad (see touch.l8).
//
// In the park, the arrows (or WASD) move him the way they point, walking or
// riding.
// Space jumps, pushing off whatever he touches: the ground, a wall, a rail.
// E gets on or off the board, even in the air. X is style: a kickflip (or
// with a side arrow, a spin) in the air, a manual held on the ground; on
// foot, a flip in the air or a roll. R starts over; Escape quits.
import "../gl/gl.l8";

import "math.l8";

import "arena.l8";

import "mover.l8";

import "tricks.l8";

import "judge.l8";

import "course.l8";

import "layout.l8";

import "slope.l8";

import "grass.l8";

import "glow.l8";

import "touch.l8";

import "hud.l8";

import "mesh.l8";

import "pose.l8";

import "render.l8";

extern getenv(name: str): ?*i8;

extern l8_environment(): []str@new;

extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int
}

mono_ns(): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    ts.sec * 1000000000 + ts.nsec
}

// The camera looks down on him from a fixed angle, from the +z side, and
// eases after him.
type Camera = {
    target: V3;
    eye: V3;
    // On the course, the way it looks across the run (as his carve).
    yaw: f32
}

const CAM_PITCH: f32 = 0.8;

const CAM_DIST: f32 = 10.5;

update_camera(c: *Camera, pos: V3, dt: f32) {
    c.target = v_lerp(c.target, v_madd(pos, v3(0.0, 1.0, 0.0), 0.5), ease(5.0, dt));
    c.eye = v_add(c.target, v3(0.0, sinf(CAM_PITCH) * CAM_DIST, cosf(CAM_PITCH) * CAM_DIST))
}

const CAM_FOLLOW: f32 = 0.6;

// On the course it follows lower, from behind him, looking ahead the way
// he rides, turning after him a little late.
update_course_camera(
    c: *Camera,
    pos: V3,
    yaw: f32,
    dt: f32
) {
    // It turns only partway with him, so that the hill stays a steady
    // guide.
    c.yaw = approach_angle(c.yaw, yaw * CAM_FOLLOW, ease(2.0, dt));
    f: V3 = carve_dir(c.yaw);
    want: V3 = v_madd(v_add(pos, v3(0.0, 1.0, 0.0)), f, 2.0);
    // Back at the top, it cuts there.
    if (v_len(v_sub(want, c.target)) > 30.0) {
        c.yaw = yaw * CAM_FOLLOW;
        f = carve_dir(c.yaw);
        want = v_madd(v_add(pos, v3(0.0, 1.0, 0.0)), f, 2.0);
        c.target = want
    }
    c.target.x = lerpf(c.target.x, want.x, ease(7.0, dt));
    c.target.y = lerpf(c.target.y, want.y, ease(5.0, dt));
    c.target.z = lerpf(c.target.z, want.z, ease(7.0, dt));
    c.eye = v_add(v_madd(c.target, f, -8.5), v3(0.0, 4.2, 0.0))
}

// The camera's vertical field of view: wide enough across that a tall
// window, as on a phone held upright, still sees to the sides.
view_fovy(): f32 {
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    // tan of the narrowest half angle across.
    across: f32 = 0.4466;
    maxf(0.62, 2.0 * atan2f(across, aspect))
}

// On the course in a tall window, as on a phone held upright, the picture
// moves up, so that he rides above the touch panels in the middle of the
// screen.
view_shift(course: bool): f32 {
    if (!course) return 0.0;
    aspect: f32 = screen_w as f32 / maxf(screen_h as f32, 1.0);
    clampf((1.0 - aspect) * 0.8, 0.0, 0.45)
}

// The report at the finish scrolls with a dragged finger: by how far it
// moved since the last frame, in rows.
drag_b: int = -1;

drag_y: f32 = 0.0;

drag_report() {
    b: int = -1;
    for i in 1..MAX_BUTTONS {
        if (b < 0 && pointers.down[i]) b = i
    }
    if (b < 0 || !hud_finished) {
        drag_b = -1;
        return
    }
    if (b == drag_b && row_h > 0.0) hud_scroll = hud_scroll - (pointers.y[b] - drag_y) / row_h;
    drag_b = b;
    drag_y = pointers.y[b]
}

// Tab: from the course to the park, or back.
switch_world(m: *Mover) {
    if (m.course) {
        m.spawn = v3(22.5, 0.0, 21.5);
        m.spawn_yaw = PI;
        reset_mover(m);
        line.scoring = false;
        clear_line()
    } else enter_course(m)
}

// L8_SPAWN=col,row,dir starts him in that cell facing dir (0 +x, 1 +z, 2 -x,
// 3 -z): handy for trying a spot over and over.
// L8_SEED=n lays out course n; otherwise each start is a new one.
seed_from_env(): int {
    prefix: str = "L8_SEED=";
    for e in l8_environment() {
        if (len(e) > len(prefix) && starts_with(e, prefix)) {
            n: int = 0;
            for i in len(prefix)..len(e) {
                c: int = e[i] as int;
                if (c >= 48 && c <= 57) n = n * 10 + c - 48
            }
            return n
        }
    }
    mono_ns() / 1000 % 100000
}

// A course laid out from seed: the ground, its grass, and him at the top.
new_course(
    m: *Mover,
    r: *Renderer,
    world: *Mesh,
    seed: int
) {
    course_seed = seed;
    load_course();
    build_grass();
    build_course(world);
    set_course_mesh(r, world);
    set_course_lamps(r);
    set_course_glows(r);
    set_grass(r);
    enter_course(m)
}

spawn_from_env(m: *Mover) {
    prefix: str = "L8_SPAWN=";
    for e in l8_environment() {
        if (len(e) > len(prefix) && starts_with(e, prefix)) {
            nums: [3]int = [0, 0, 3];
            k: int = 0;
            n: int = 0;
            for i in len(prefix)..len(e) {
                c: int = e[i] as int;
                if (c >= 48 && c <= 57) n = n * 10 + c - 48 else if (c == 44 && k < 2) {
                    nums[k] = n;
                    k = k + 1;
                    n = 0
                }
            }
            nums[k] = n;
            m.spawn = v3(nums[0] as f32 + 0.5, 0.0, nums[1] as f32 + 0.5);
            m.spawn_yaw = dir_yaw(dir_vec(nums[2] % 4));
            reset_mover(m);
            line.scoring = false;
            clear_line()
        }
    }
}

starts_with(s: str, prefix: str): bool {
    for i in 0..len(prefix) {
        if (s[i] != prefix[i]) return false
    }
    true
}

// Keys by direction: arrows and WASD, +x right and +z toward the camera.
key_dir(ks: int): int {
    if (ks == 65363 || ks == 100) return 0;
    if (ks == 65364 || ks == 115) return 1;
    if (ks == 65361 || ks == 97) return 2;
    if (ks == 65362 || ks == 119) return 3;
    -1
}

key_down(keys: *Keys, ks: int) {
    d: int = key_dir(ks);
    if (d >= 0) keys.held[d] = true;
    if (ks == 32) {
        if (!keys.hop_held) keys.hop = true;
        keys.hop_held = true
    }
    if (ks == 101) keys.board = true;
    if (ks == 120) {
        if (!keys.style_held) keys.style = true;
        keys.style_held = true
    }
}

key_up(keys: *Keys, ks: int) {
    if (ks == 120) keys.style_held = false;
    if (ks == 32) keys.hop_held = false;
    d: int = key_dir(ks);
    if (d >= 0) keys.held[d] = false
}

trace(m: *Mover) raises IoError {
    write(2, "pos ");
    write_int(2, (m.x * 100.0) as int);
    write(2, " ");
    write_int(2, (m.y * 100.0) as int);
    write(2, " ");
    write_int(2, (m.z * 100.0) as int);
    write(2, " riding ");
    write_int(2, m.riding as int);
    write(2, " speed ");
    write_int(2, (m.speed * 100.0) as int);
    write(2, " air ");
    write_int(2, m.air as int);
    write(2, " grind ");
    write_int(2, m.grinding as int);
    write(2, " wind ");
    write_int(2, (m.wind_x * 100.0) as int);
    write(2, " ");
    write_int(2, (m.wind_y * 100.0) as int);
    write(2, " w ");
    write_int(2, (m.spin_w * 100.0) as int);
    write(2, " ");
    write_int(2, (m.flip_w * 100.0) as int);
    write(2, "\n")
}

main() raises IoError: int {
    load_arena();
    course_seed = seed_from_env();
    load_course();
    build_grass();
    world: *Mesh = new_mesh(1200000);
    build_arena(world);
    parts: *Mesh = new_mesh(60000);
    build_parts(parts);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        eprint("XOpenDisplay failed (need DISPLAY / XWayland)");
        return 1
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 24i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) die("glXChooseVisual failed");
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163919,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    // Keys, buttons, pointer motion, structure, exposure.
    screen_w = 1280;
    screen_h = 720;
    win: int = XCreateWindow(dpy, root, 0, 0, screen_w, screen_h, 0, vis.depth as int,
        1, vis.visual, 10248, &wa);
    if (win == 0) die("XCreateWindow failed");
    XStoreName(dpy, win, "L8 skate");
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, "WM_DELETE_WINDOW", 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    eprint("L8 skate: on the course, left/right carve and spin, up/down lean and flip, Space ollies, X grabs; Tab for the park; R restarts, Escape quits");
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) die("glXCreateContext failed");
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) die("glXMakeCurrent failed");
    glXSwapIntervalEXT(dpy, win, 1);
    r: *Renderer = new_renderer(world, parts);
    build_course(world);
    set_course_mesh(r, world);
    set_course_lamps(r);
    set_park_lamps(r);
    set_course_glows(r);
    set_park_glows(r);
    set_grass(r);
    m: *Mover = new_mover(22.5, 21.5, PI);
    enter_course(m);
    spawn_from_env(m);
    a: *Anim = new_anim(m.facing, m.y);
    start: V3 = v3(m.x, m.y, m.z);
    cam: *Camera = new Camera { target: start, eye: start, yaw: 0.0 };
    if (m.course) update_course_camera(cam, start, m.carve, 10.0) else update_camera(cam,
        start, 10.0);
    keys: Keys = Keys {
        held: [false, false, false, false],
        hop: false,
        hop_held: false,
        board: false,
        style: false,
        style_held: false,
        stick_x: 0.0,
        stick_on: false,
        pad_held: false,
        pad_press: false,
        pad_release: false,
        aim_x: 0.0,
        aim_y: 0.0
    };
    shadows: bool = getenv("L8_NO_SHADOWS") == null;
    grass_on = getenv("L8_NO_GRASS") == null;
    tracing: bool = getenv("L8_TRACE") != null;
    trace_ns: int = 0;
    ev: XEvent = XEvent.Other;
    running: bool = true;
    alive: bool = true;
    prev_ns: int = mono_ns();
    start_ns: int = prev_ns;
    acc: f32 = 0.0;
    // Pause, held: the page holds it while its guide is open. Time stands
    // still, but the frames go on.
    paused: bool = false;
    while (running) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 65307) running = false;
                    if (ks == 65299) paused = true;
                    if (ks == 114) {
                        if (m.course) {
                            enter_course(m);
                            cam.target = v3(m.x, m.y, m.z);
                            update_course_camera(cam, cam.target, m.carve, 10.0)
                        } else reset_mover(m);
                        a.y = m.y
                    }
                    // N: a new course.
                    // (It is laid out after a frame that says so: it takes a
                    // moment.)
                    if (ks == 110 && m.course && hud_building == 0) hud_building = 1;
                    // At the finish, up and down scroll the report.
                    if (m.course && m.finished) {
                        if (ks == 65362 || ks == 119) hud_scroll = hud_scroll - 4.0;
                        if (ks == 65364 || ks == 115) hud_scroll = hud_scroll + 4.0
                    }
                    if (ks == 65289) {
                        switch_world(m);
                        pointers_clear(&keys);
                        a.y = m.y;
                        cam.target = v3(m.x, m.y, m.z);
                        if (m.course) update_course_camera(cam, cam.target, m.carve,
                            10.0) else update_camera(cam, cam.target, 10.0)
                    }
                    // On the course, Space is the trick pad, and arrows
                    // pressed while it is held aim the trick.
                    if (m.course && keys.hop_held && key_dir(ks) >= 0) aim_key(&keys,
                        key_dir(ks));
                    key_down(&keys, ks);
                    if (m.course && ks == 32) pad_press(&keys)
                }
                KeyRelease -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    key_up(&keys, ks);
                    if (ks == 65299) paused = false;
                    if (m.course && ks == 32) pad_release(&keys)
                }
                ButtonPress b -> {
                    if (m.course) pointer_down(&keys, b.button as int, b.x as f32,
                        b.y as f32)
                }
                ButtonRelease b -> pointer_up(&keys, b.button as int);
                MotionNotify mo -> pointer_move(mo.state as int, mo.x as f32, mo.y as f32);
                ConfigureNotify c -> {
                    if (c.width > 0i32 && c.height > 0i32) {
                        screen_w = c.width as int;
                        screen_h = c.height as int
                    }
                }
                DestroyNotify -> {
                    running = false;
                    alive = false
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) running = false
                }
                _ -> { }
            }
        }
        if (running && hud_building == 2) {
            new_course(m, r, world, (course_seed * 48271 + mono_ns() / 1000) % 100000);
            pointers_clear(&keys);
            a.y = m.y;
            cam.target = v3(m.x, m.y, m.z);
            update_course_camera(cam, cam.target, m.carve, 10.0);
            hud_building = 0;
            prev_ns = mono_ns()
        }
        if (hud_building == 1) hud_building = 2;
        if (running) {
            now: int = mono_ns();
            dns: int = now - prev_ns;
            prev_ns = now;
            if (dns < 0) dns = 0;
            if (dns > 100000000) dns = 100000000;
            if (paused) dns = 0;
            dt: f32 = dns as f32 / 1000000000.0;
            acc = acc + dt;
            steps: int = 0;
            read_pads(&keys);
            while (acc >= STEP_DT && steps < 12) {
                if (m.course) step_course(m, &keys, STEP_DT) else step_mover(m, &keys,
                    STEP_DT);
                acc = acc - STEP_DT;
                steps = steps + 1
            }
            if (acc > STEP_DT) acc = 0.0;
            alpha: f32 = acc / STEP_DT;
            pos: V3 = v_lerp(m.prev, v3(m.x, m.y, m.z), alpha);
            update_anim(a, m, dt);
            pose(a, m, pos);
            if (m.course) update_course_camera(cam, pos, m.carve, dt) else update_camera(cam,
                pos, dt);
            show_course = m.course;
            hud_finished = m.course && m.finished;
            // At the finish, a finger dragged up or down scrolls the report.
            drag_report();
            if (!hud_finished) hud_scroll = 0.0;
            hud_finish_t = m.finish_t;
            hud_aiming = m.course && m.winding;
            hud_carve = m.carve;
            hud_aim_flips = m.aim_flips;
            hud_aim_halves = m.aim_halves;
            hud_aim_air = m.aim_air;
            hud_aim_need = trick_need(m.aim_flips, m.aim_halves);
            // The trick's worth reads for the next jump, if one is near;
            // the bar, for now.
            plan_air: f32 = m.aim_air;
            plan_item: int = m.aim_item;
            if (m.ahead_air > 0.0) {
                plan_air = m.ahead_air;
                plan_item = m.ahead_item
            }
            hud_aim_plan = plan_air;
            aim_kind: int = HIT_FLAT;
            if (plan_item >= 0) aim_kind = HIT_AIR;
            hud_aim_value = aim_value(aim_kind, plan_item, m.aim_flips, m.aim_halves,
                plan_air, m.fakie);
            hud_aim_repeat = aim_repeats(aim_kind, m.aim_flips, m.aim_halves, m.fakie);
            hud_aim_switch = m.fakie;
            hud_rider_d = -m.z;
            if (m.course) update_marks(m);
            hud_finished = m.course && m.finished;
            find_zones();
            hud_seed = course_seed;
            view: View = View {
                eye: cam.eye,
                at: cam.target,
                fovy: view_fovy(),
                focus: pos,
                time: (now - start_ns) as f32 / 1000000000.0,
                shift: view_shift(m.course)
            };
            draw_scene(r, view, shadows);
            draw_hud(r);
            if (tracing && now - trace_ns > 250000000) {
                trace_ns = now;
                trace(m)
            }
            glXSwapBuffers(dpy, win)
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive) XDestroyWindow(dpy, win);
    XCloseDisplay(dpy);
    0
}
