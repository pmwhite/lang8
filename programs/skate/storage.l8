tag skate;

import "../../stdlib/raw_write.l8";

extern skate_storage_exit(code: int): noreturn = exit;

skate_storage_full(): noreturn {
    raw::raw_write(2, "skate: static storage exhausted\n");
    skate_storage_exit(1)
}

skate_mover_slots: []i8 = static_buffer([4096]i8);

skate_mover_used: int = 0;

extern skate_mover_at(p: *i8): *Mover = l8_as_int;

skate_take_mover(value: Mover): *Mover {
    i: int = skate_mover_used;
    if (i >= 4 || sizeof(Mover) > 1024) skate_storage_full();
    skate_mover_used = i + 1;
    out: *Mover = skate_mover_at(&skate_mover_slots[i * 1024]);
    out.* = value;
    out
}

skate_anim_slots: []i8 = static_buffer([512]i8);

skate_anim_used: int = 0;

extern skate_anim_at(p: *i8): *Anim = l8_as_int;

skate_take_anim(value: Anim): *Anim {
    i: int = skate_anim_used;
    if (i >= 2 || sizeof(Anim) > 256) skate_storage_full();
    skate_anim_used = i + 1;
    out: *Anim = skate_anim_at(&skate_anim_slots[i * 256]);
    out.* = value;
    out
}

skate_renderer_slots: []i8 = static_buffer([4096]i8);

skate_renderer_used: int = 0;

extern skate_renderer_at(p: *i8): *Renderer = l8_as_int;

skate_take_renderer(value: Renderer): *Renderer {
    i: int = skate_renderer_used;
    if (i >= 1 || sizeof(Renderer) > 4096) skate_storage_full();
    skate_renderer_used = i + 1;
    out: *Renderer = skate_renderer_at(&skate_renderer_slots[i * 4096]);
    out.* = value;
    out
}
