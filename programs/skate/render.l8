tag skate;

use_tag std;

use_tag gl;

// Drawing: a daytime sky, the ground and features lit by a warm sun with a
// shadow map that follows the player, and the guy. Lighting is done in
// linear color, tone mapped and gamma corrected at the end.
const SHADOW_SIZE: int = 2048;

const SHADOW_HALF: f32 = 26.0;

type Renderer = {
    world: int;
    // (See shade_less, and shade_plain.)
    u_less: int;
    u_plain: int;
    shadow: int;
    sky: int;
    u_vp: int;
    u_model: int;
    u_light: int;
    u_sun: int;
    u_cam: int;
    u_texel: int;
    u_blob: int;
    u_shadow_map: int;
    u_smvp: int;
    u_cam_f: int;
    u_cam_r: int;
    u_cam_u: int;
    u_tan: int;
    u_shift: int;
    u_sky_sun: int;
    u_time: int;
    u_world_noise: int;
    u_sky_noise: int;
    noise_tex: u32;
    course_buf: u32;
    course_idx: u32;
    course_n: int;
    // The casters' corners alone (see build_shadow_index).
    shadow_idx: u32;
    part_buf: u32;
    sky_buf: u32;
    shadow_tex: u32;
    shadow_fbo: u32;
    // The scene drawn small, to be stretched over the window (see
    // render_scale): where it is drawn, its picture and depths, how big
    // they are now, and the program that stretches it.
    // (It is drawn with its edges smoothed, several samples to a pixel, in
    // one place, and made a picture of in the other.)
    scene_fbo: u32;
    scene_tex: u32;
    scene_many: u32;
    scene_color: u32;
    scene_depth: u32;
    scene_w: int;
    scene_h: int;
    stretch: int;
    u_stretch_scene: int;
    hud: int;
    u_hud_screen: int;
    u_hud_offset: int;
    u_hud_color: int;
    hud_buf: u32;
    glow: int;
    u_glow_vp: int;
    u_glow_cam: int;
    u_glow_right: int;
    u_glow_up: int;
    u_glow_time: int;
    course_glow_buf: u32;
    course_glow_n: int;
    grass: int;
    u_grass_vp: int;
    u_grass_light: int;
    u_grass_sun: int;
    u_grass_cam: int;
    u_grass_texel: int;
    u_grass_shadow: int;
    u_grass_time: int;
    u_grass_noise: int;
    tuft_buf: u32;
    grass_buf: u32;
    // In each lit program: the sunset's direction, the lamp map, and
    // where it lies; and the lamp maps, the park's and the course's.
    u_dusk: []int;
    u_dusk_flat: []int;
    // The look's uniforms, LOOK_UNIFORMS for each of the world, grass, and
    // sky programs.
    u_look: []int;
    u_lamp_map: []int;
    u_lamp_rect: []int;
    u_near0: int;
    u_near1: int;
    // The marks painted on the jumps ahead (see find_zones, in hud.l8).
    u_marks: []int;
    u_mark_c: []int;
    u_mark_n: int;
    u_mark_time: int;
    u_ready: int;
    u_run_half: int;
    u_park_floor: int;
    course_lamps: u32
}

screen_w: int = 1200;

screen_h: int = 720;

die(msg: str) raises IoError: noreturn {
    eprint(msg);
    exit(1)
}

extern exit(code: int): noreturn;

compile_shader(kind: int, src: []i8) raises IoError: int {
    sh: int = glCreateShader(kind);
    sp: *i8 = src;
    ln: []i32 = new i32[1](len(src) trunc i32);
    glShaderSource(sh, 1, &sp, ln);
    glCompileShader(sh);
    st: []i32 = new i32[1](0i32);
    glGetShaderiv(sh, 35713, st);
    if (st[0] == 0i32) {
        logn: []i32 = new i32[1](0i32);
        glGetShaderiv(sh, 35716, logn);
        n: int = logn[0] as int;
        if (n < 1) n = 1;
        if (n > 4096) n = 4096;
        buf: []i8 = new i8[n](0i8);
        glGetShaderInfoLog(sh, n, null, buf);
        write_bytes_n(2, buf, n);
        write(2, "\n");
        die("shader compile failed")
    }
    sh
}

link_program(vs: []i8, fs: []i8) raises IoError: int {
    prog: int = glCreateProgram();
    glAttachShader(prog, compile_shader(35633, vs));
    glAttachShader(prog, compile_shader(35632, fs));
    glBindAttribLocation(prog, 0, "pos");
    glBindAttribLocation(prog, 1, "nrm");
    glBindAttribLocation(prog, 2, "vcol");
    glBindAttribLocation(prog, 3, "inst");
    glBindAttribLocation(prog, 4, "inst2");
    glLinkProgram(prog);
    st: []i32 = new i32[1](0i32);
    glGetProgramiv(prog, 35714, st);
    if (st[0] == 0i32) die("program link failed");
    prog
}

// The sky's color toward d, without the clouds; the distance fades to it.
// Late afternoon: a soft blue overhead, warming to peach at the horizon,
// most of all toward the sun (sky_sun), low behind him.
SKY_GLSL: str = """
// On a phone (GLSL ES), fragments are shaded at medium precision (see
// fragmentPrecision, in web/game/platform.js), which its GPU does about
// twice as fast: HP marks what must keep full precision there, being
// large (a place in the world, the time) or fine (a shadow map's
// coordinates, a noise lookup's). Desktop GLSL has no such qualifiers.
#ifdef GL_ES
#define HP highp
#else
#define HP
#endif
uniform HP vec3 sky_sun;
// (The way to it across the ground, of length one.)
uniform vec2 sky_sun_flat;
// The look (see Look): the sky overhead, at the horizon away from the sun
// and toward it, and the sun's glow low down; the sun's light, and the
// sky's from above and below; the air (how thick per meter, and at most);
// and the grade (exposure by channel, and color after the curve).
uniform vec3 look_zenith;
uniform vec3 look_away;
uniform vec3 look_toward;
uniform vec3 look_glow;
uniform vec3 look_sun;
uniform vec3 look_sky_up;
uniform vec3 look_sky_down;
uniform vec2 look_haze;
uniform vec4 look_grade;
// The sun's (or the moon's) disc and glow in the sky; and in its alpha,
// how much it is night (stars, dark clouds).
uniform vec4 look_disc;
vec3 sky_base(vec3 d) {
  float up = clamp(d.y, 0.0, 1.0);
  vec2 flat_d = d.xz + vec2(0.0001, 0.0);
  float toward = dot(normalize(flat_d), sky_sun_flat) * 0.5 + 0.5;
  float t2 = toward * toward;
  float t4 = t2 * t2;
  vec3 horizon = mix(look_away, look_toward, t2);
  // (Below the horizon, as most of what haze is asked of is, there is no
  // way up the sky to work out.)
  vec3 c = horizon;
  float glow = t4 * t4 * t2;
  if (up > 0.0) {
    c = mix(horizon, look_zenith, pow(up, 0.45));
    glow *= exp(-up * 8.0);
  }
  c += look_glow * glow;
  // Below the horizon, the far land in haze.
  c = mix(c, horizon * 0.8, clamp(-d.y * 3.0, 0.0, 1.0));
  return c;
}
// The light everything is lit by: the warm low sun, and the sky, blue from
// above with a little warm light back off the ground.
#define SUN_LIGHT look_sun
vec3 sky_light(vec3 n) {
  return mix(look_sky_down, look_sky_up, n.y * 0.5 + 0.5);
}
// Farther off, things fade into the sky's color: little near, more far.
vec3 haze(vec3 col, vec3 V, float dist) {
  // (Near enough, there is none: the sky's color need not be found.)
  if (dist <= 20.0) return col;
  float f = 1.0 - exp(-(dist - 20.0) * look_haze.x);
  return mix(col, sky_base(-V) * 0.95, f * look_haze.y);
}
// Lamps: their light on the ground, every lamp's at once, from a map
// (see lamp_map in render.l8): lamp_rect is its corner and the scale from
// meters to the map.
uniform sampler2D lamp_map;
uniform HP vec4 lamp_rect;
vec3 lamps(HP vec3 p, vec3 n) {
  HP vec2 uv = (p.xz - lamp_rect.xy) * lamp_rect.zw;
  if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return vec3(0.0);
  float v = texture2D(lamp_map, uv).r;
    return vec3(1.0, 0.68, 0.38) * v * v * 5.0 * (0.4 + 0.6 * max(n.y, 0.0));
}
// Exposure, a gentle warm grade, and a filmic curve; then a little more
// color than the curve leaves.
vec3 tone(vec3 c) {
  c *= look_grade.rgb;
  c = (c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14);
  float l = dot(c, vec3(0.3, 0.55, 0.15));
  c = mix(vec3(l), c, look_grade.a);
  return pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2));
}
// Smooth value noise with one lattice cell per unit, from a tiling texture.
uniform sampler2D noise_map;
float vnoise(HP vec2 p) { return texture2D(noise_map, p * 0.015625).r; }
""";

WORLD_VS: str = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec4 vcol;
uniform mat4 vp;
uniform mat4 model;
uniform mat4 light_vp;
varying vec3 vworld;
varying vec3 vnrm;
varying vec4 vcolor;
varying vec4 vlight;
void main() {
  vec4 w = model * vec4(pos, 1.0);
  vworld = w.xyz;
  vnrm = mat3(model[0].xyz, model[1].xyz, model[2].xyz) * nrm;
  // (Its color as light, worked out here once a corner, not once a pixel.)
  vcolor = vec4(pow(vcol.rgb, vec3(2.2)), vcol.a);
  vlight = light_vp * w;
  gl_Position = vp * w;
}
""";

WORLD_FS: str = """
uniform sampler2DShadow shadow_map;
uniform vec3 sun_dir;
uniform HP vec3 cam_pos;
uniform float shadow_texel;
uniform HP vec3 blob;
// (A part of the work left out, to find what it costs: see shade_less.)
uniform float less;
// How plainly surfaces are colored, from 0 to 1: see shade_plain.
uniform float plain;
// The two lamps nearest him (xyz, how bright), to light him by: he is
// warm on the side toward them and cool away.
uniform HP vec4 near0;
uniform HP vec4 near1;
vec3 near_light(HP vec4 lamp, HP vec3 p, vec3 n) {
  vec3 l = lamp.xyz - p;
  float d = max(length(l), 0.3);
  return vec3(1.0, 0.68, 0.38) * lamp.w / (1.0 + 0.3 * d * d) * max(dot(n, l / d) * 0.85 + 0.15, 0.0);
}
varying HP vec3 vworld;
varying vec3 vnrm;
varying vec4 vcolor;
varying HP vec4 vlight;
// Marks painted on the jumps ahead (see find_zones, in hud.l8): over each
// run-up a faint wash, gold where letting go lands the trick he aims,
// brighter toward the lip. Each is two rows: x0, x1 across, the run-up's
// start, and where the gold starts; and where it ends, and the lip (along
// the run: d is -z). mark_n of them.
uniform HP vec4 mark0a;
uniform HP vec4 mark0b;
uniform HP vec4 mark1a;
uniform HP vec4 mark1b;
uniform HP vec4 mark2a;
uniform HP vec4 mark2b;
uniform HP vec4 mark3a;
uniform HP vec4 mark3b;
uniform HP vec4 mark4a;
uniform HP vec4 mark4b;
uniform HP vec4 mark5a;
uniform HP vec4 mark5b;
uniform HP vec4 mark6a;
uniform HP vec4 mark6b;
uniform HP vec4 mark7a;
uniform HP vec4 mark7b;
// A circle round each on the ground (its middle, and its radius squared):
// only inside it is the mark worked out at all, which is most of what a
// mark costs, there being far more ground outside them than in.
uniform HP vec3 mark0c;
uniform HP vec3 mark1c;
uniform HP vec3 mark2c;
uniform HP vec3 mark3c;
uniform HP vec3 mark4c;
uniform HP vec3 mark5c;
uniform HP vec3 mark6c;
uniform HP vec3 mark7c;
uniform float mark_n;
// The park's floor (half its width and length, and its corners' radius),
// for the band up its bowl's walls.
uniform HP vec4 park_floor;
// The run's half width, for the line worn down it (0 in the park).
uniform float run_half;
uniform HP float mark_time;
// How far the ring round him has come up: when letting go now lands the
// trick he aims.
uniform float ready;
// A mark at p: how strongly it glows there (a bold band over where letting
// go lands the trick, strongest toward the lip, or on a wall toward the
// middle of its band, its edges crisp); a bright line across where it
// begins; and how far along it p is, toward the lip (for the pulses that
// run that way).
float park_out(HP vec2 p) {
  HP vec2 q = abs(p) - (park_floor.xy - park_floor.z);
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - park_floor.z;
}
vec3 mark_at(HP vec4 a, HP vec4 b, HP vec3 p) {
  // b.z is its kind (0 a ramp, 1 a wall, 2 the bowl) and, in its fraction,
  // how far it has come up (0.4 is all the way).
  float al = fract(b.z) * 2.5;
  if (b.z > 1.5) {
    // The park's bowl: across the band x0..x1 out up its walls, about where
    // he would ride up them (a.zw), within b.x of it.
    HP float e = park_out(p.xz);
    float near = 1.0 - smoothstep(b.x * 0.5, b.x, distance(p.xz, a.zw));
    float across = smoothstep(a.x - 0.08, a.x + 0.08, e) * (1.0 - smoothstep(a.y - 0.08, a.y + 0.08, e));
    float mid = 1.0 - abs(e - (a.x + a.y) * 0.5) / max((a.y - a.x) * 0.5 + 0.3, 0.3);
    float line = (1.0 - smoothstep(0.03, 0.07, abs(e - a.x))) * near;
    return vec3(near * across * (0.6 + 0.4 * clamp(mid, 0.0, 1.0)) * al, line * al, e);
  }
  // Into the frame of what it lights, turned by its yaw (b.w).
  if (b.w != 0.0) {
    float c = cos(b.w);
    float s = sin(b.w);
    p = vec3(p.x * c + p.z * s, p.y, p.z * c - p.x * s);
  }
  HP float d = -p.z;
  if (b.z > 0.5) {
    // A wall: across the band of heights x0..x1 (by |x|), along d.
    HP float u = abs(p.x);
    HP float lo = min(abs(a.x), abs(a.y));
    HP float hi = max(abs(a.x), abs(a.y));
    float along = smoothstep(a.z, a.z + 3.0, d) * (1.0 - smoothstep(b.x - 3.0, b.x, d));
    float across = smoothstep(lo - 0.08, lo + 0.08, u) * (1.0 - smoothstep(hi - 0.08, hi + 0.08, u));
    float mid = 1.0 - abs(u - (lo + hi) * 0.5) / max((hi - lo) * 0.5 + 0.3, 0.3);
    float line = (1.0 - smoothstep(0.03, 0.07, min(abs(u - lo), abs(u - hi)))) * along;
    return vec3(along * across * (0.6 + 0.4 * clamp(mid, 0.0, 1.0)) * al, line * al, u);
  }
  // A ramp: from where it lands the trick (a.w) on past the lip to its end
  // (b.x), across x0..x1.
  HP float side = min(p.x - a.x, a.y - p.x);
  float across = smoothstep(-0.06, 0.06, side);
  float rise = smoothstep(a.w - 0.05, a.w + 0.05, d);
  float fall = 1.0 - smoothstep(b.x - 0.3, b.x, d);
  float toward = 0.6 + 0.4 * smoothstep(a.w, b.y, d);
  float line = (1.0 - smoothstep(0.04, 0.09, abs(d - a.w))) * smoothstep(-0.1, 0.1, side);
  return vec3(across * rise * fall * toward * al, line * al, d);
}
vec3 brighter(vec3 a, vec3 b) {
  return vec3(a.x > b.x ? a.xz : b.xz, max(a.y, b.y)).xzy;
}
// The brighter of k and the mark (a, b) at p, if p is inside its circle c.
vec3 with_mark(vec3 k, HP vec4 a, HP vec4 b, HP vec3 c, HP vec3 p) {
  HP vec2 q = p.xz - c.xy;
  if (dot(q, q) > c.z) return k;
  return brighter(k, mark_at(a, b, p));
}

float sun_visibility(float ndl) {
  HP vec3 sc = vlight.xyz / vlight.w * 0.5 + 0.5;
  if (sc.x < 0.002 || sc.x > 0.998 || sc.y < 0.002 || sc.y > 0.998 || sc.z > 1.0) return 1.0;
  HP float bias = 0.0004 + 0.0012 * (1.0 - clamp(ndl, 0.0, 1.0));
  HP float t = shadow_texel;
  float v = shadow2D(shadow_map, vec3(sc.xy, sc.z - bias)).r * 0.36;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(t, 0.0), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy - vec2(t, 0.0), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(0.0, t), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy - vec2(0.0, t), sc.z - bias)).r * 0.16;
  // Fade out toward the map's edge.
  vec2 e = abs(sc.xy - 0.5) * 2.0;
  return mix(v, 1.0, smoothstep(0.7, 0.95, max(e.x, e.y)));
}

void main() {
  vec3 n = normalize(vnrm);
  // Ambient occlusion rides in the normal's length (see mesh.l8).
  float ao = clamp(length(vnrm), 0.0, 1.0);
  float mat = vcolor.a;
  vec3 albedo = vcolor.rgb;
  HP vec3 to_cam = cam_pos - vworld;
  HP float dist = length(to_cam);
  vec3 V = to_cam / dist;
  // A lamp's glass glows, by night.
  // (As night falls, or lifts, it comes on or goes off half way.)
  if (mat > 9.5 && look_disc.a > 0.5) {
    gl_FragColor = vec4(tone(haze(albedo * 3.0, V, dist)), 1.0);
    return;
  }
  if (less > 5.5) {
    gl_FragColor = vec4(albedo, 1.0);
    return;
  }
  float spec = 0.0;
  float gloss = 8.0;
  // Light wraps a little round everything, for a soft look.
  float wrap = 0.25;
  float ground = 0.0;
  HP vec2 xz = vworld.xz;
  if (less == 3.0) {
    ground = 1.0;
  } else if (mat < 0.5) {
    // Concrete laid in slabs: each its own shade, a little warmer or
    // cooler; broad warm and cool patches over them; and on the run, a line
    // worn smooth and darker down its middle.
    HP vec2 id = floor(xz / 3.0);
    float t1 = vnoise(id * 7.31 + 0.5);
    albedo *= 0.86 + 0.24 * t1;
    if (run_half > 0.0) {
      float ax = abs(vworld.x);
      albedo *= 1.0 - 0.08 * (1.0 - smoothstep(1.0, 3.0, ax));
    }
    // (Plainly, only that; and the rest's color on the whole. See
    // shade_plain.)
    vec3 fine = vec3(0.99, 0.98, 0.96);
    if (plain < 1.0) {
      float t2 = vnoise(id * 3.17 + 9.5);
      vec3 full = mix(vec3(1.05, 1.0, 0.92), vec3(0.94, 0.99, 1.06), t2);
      float broad = vnoise(xz * 0.035 + 21.0);
      full *= mix(vec3(1.06, 1.0, 0.9), vec3(0.93, 0.97, 1.04), broad);
      float near = 1.0 - smoothstep(40.0, 80.0, dist);
      if (near > 0.0) {
        vec2 j = abs(fract(xz / 3.0 + 0.5) - 0.5) * 3.0;
        float joint = 1.0 - smoothstep(0.015, 0.04, min(j.x, j.y));
        full *= 1.0 - 0.22 * joint * near;
      }
      fine = mix(full, fine, plain);
    }
    albedo *= fine;
    spec = 0.03;
    gloss = 10.0;
    ground = 1.0;
  } else if (mat < 1.5) {
    // Grass: soft, in broad patches a little yellower or deeper.
    // (Plainly, all of one green.)
    if (plain < 1.0) {
      float big = vnoise(xz * 0.07);
      float mid = vnoise(xz * 0.4 + 7.0);
      vec3 full = albedo * (0.9 + 0.14 * big + 0.06 * mid);
      full = mix(full, full * vec3(1.15, 1.08, 0.75), smoothstep(0.55, 0.8, mid) * 0.4);
      albedo = mix(full, albedo, plain);
    }
    wrap = 0.4;
    ground = 1.0;
  } else if (mat < 3.5) {
    // Plywood: sheets with seams and a little grain.
    // (Plainly, with no grain: only the seams.)
    float grain = 0.5;
    if (plain < 1.0) grain = mix(vnoise(vec2(vworld.x * 0.7 + vworld.z * 0.7, vworld.y * 9.0 + vworld.x * 4.0)), 0.5, plain);
    HP float sz = abs(fract(vworld.z / 1.22) - 0.5) * 1.22;
    HP float sy = abs(fract((vworld.y + vworld.x * 0.2) / 0.81) - 0.5) * 0.81;
    float line = 1.0 - smoothstep(0.0, 0.012, min(0.61 - sz, 0.405 - sy));
    albedo *= (0.9 + 0.14 * grain) * (1.0 - 0.25 * line);
    spec = 0.07;
    gloss = 18.0;
    ground = 1.0;
  } else if (mat < 4.5) {
    // Metal: rails.
    spec = 0.35;
    gloss = 40.0;
  } else if (mat < 5.5) {
    // The guy: soft painted block, light wrapping a little around it.
    wrap = 0.35;
    spec = 0.12;
    gloss = 20.0;
  } else if (mat < 7.5) {
    spec = 0.06;
    gloss = 20.0;
    // (A kicker's planks are ground, for the marks.)
    if (mat > 7.15) ground = 1.0;
  } else {
    // Leaves: lumpy color, light coming through.
    float k = 0.5;
    if (plain < 1.0) k = mix(vnoise(vworld.xz * 2.3 + vworld.y * 3.0), 0.5, plain);
    albedo *= 0.85 + 0.3 * k;
    wrap = 0.5;
  }
  // (Plainly, nothing shines but him and the rails.)
  if (mat < 3.5 || mat > 5.5) spec *= 1.0 - plain;
  // Light where a mark is (see mark_at).
  vec3 mk = vec3(0.0);
  // (Only as many as there are, and each only inside its circle.)
  if (mark_n > 0.5 && ground > 0.5) {
    mk = with_mark(mk, mark0a, mark0b, mark0c, vworld);
    if (mark_n > 1.5) mk = with_mark(mk, mark1a, mark1b, mark1c, vworld);
    if (mark_n > 2.5) mk = with_mark(mk, mark2a, mark2b, mark2c, vworld);
    if (mark_n > 3.5) mk = with_mark(mk, mark3a, mark3b, mark3c, vworld);
    if (mark_n > 4.5) mk = with_mark(mk, mark4a, mark4b, mark4c, vworld);
    if (mark_n > 5.5) mk = with_mark(mk, mark5a, mark5b, mark5c, vworld);
    if (mark_n > 6.5) mk = with_mark(mk, mark6a, mark6b, mark6c, vworld);
    if (mark_n > 7.5) mk = with_mark(mk, mark7a, mark7b, mark7c, vworld);
  }
  float ndl = dot(n, sun_dir);
  float diff = max((ndl + wrap) / (1.0 + wrap), 0.0);
  // (What faces away from the sun gets none of its light, in shadow or
  // out: but for him, whose rim the sun lights from behind.)
  float vis = 0.0;
  if (less == 1.0) vis = 1.0; else if (diff > 0.0 || (mat > 4.5 && mat < 5.5)) vis = sun_visibility(ndl);
  vec3 sky = sky_light(n) * ao;
  // Contact darkening on the ground under the player.
  // (Only near him is there any to work out.)
  HP vec2 bq = vworld.xz - blob.xz;
  if (ground > 0.5 && dot(bq, bq) < 0.5625 && less != 5.0) {
    float d = length(bq);
    float near = (1.0 - smoothstep(0.0, 0.75, d)) * (1.0 - smoothstep(0.0, 1.0, abs(vworld.y - blob.y)));
    sky *= 1.0 - 0.5 * near;
  }
  vec3 col = albedo * (SUN_LIGHT * diff * vis * (0.6 + 0.4 * ao) + sky);
  // By night, the lamps: their pools on the ground and what stands in
  // them, and on him, the two nearest.
  // (By how much it is night: all of it, but while night falls or lifts.)
  if (look_disc.a > 0.0) {
    if (mat > 4.5 && mat < 5.5) col += albedo * (near_light(near0, vworld, n) + near_light(near1, vworld, n)) * look_disc.a; else col += albedo * lamps(vworld, n) * ao * look_disc.a;
  }
  // Along his edges, a rim: of the sun when it is behind him, and of the
  // sky.
  if (mat > 4.5 && mat < 5.5) {
    float rim = pow(1.0 - max(dot(n, V), 0.0), 3.0);
    col += (SUN_LIGHT * 0.5 * max(dot(-V, sun_dir), 0.0) * vis + vec3(0.35, 0.42, 0.62) * 0.3) * rim;
  }
  // (What has no shine, as grass and leaves have none, has no highlight to
  // work out.)
  // (Nor has what the sun does not reach.)
  if (spec > 0.0 && vis > 0.0 && ndl >= 0.0 && less != 5.0) {
    vec3 H = normalize(sun_dir + V);
    col += SUN_LIGHT * vis * spec * pow(max(dot(n, H), 0.0), gloss) * (gloss + 8.0) / 60.0 * step(0.0, ndl);
  }
  // The marks' light: a soft pool, and its fine line.
  // The marks: a green glow over where letting go lands the trick, pulses
  // running through it toward the lip, and a bright line where it begins.
  // (By night, half as bright: it is the only thing lit.)
  vec3 go = vec3(0.04, 0.9, 0.3) * mix(1.0, 0.45, look_disc.a);
  if (mk.x + mk.y > 0.0) {
    float pulse = 0.5 + 0.5 * sin((mk.z - mark_time * 3.0) * 5.2);
    col = mix(col, go * (0.9 + 0.6 * pulse), mk.x * (0.7 + 0.2 * pulse));
    col = mix(col, vec3(0.8, 1.6, 1.0) * mix(1.0, 0.5, look_disc.a), mk.y * 0.9);
  }
  // Round him on the ground, when letting go now lands it: a ring.
  HP vec2 rq = vworld.xz - blob.xz;
  if (ready > 0.0 && ground > 0.5 && dot(rq, rq) < 1.6) {
    float rd = length(rq);
    float ring = (1.0 - smoothstep(0.05, 0.11, abs(rd - 0.85 - 0.06 * sin(mark_time * 9.0)))) * (1.0 - smoothstep(0.0, 1.2, abs(vworld.y - blob.y)));
    col = mix(col, vec3(0.6, 1.7, 0.9) * mix(1.0, 0.5, look_disc.a), ring * 0.9 * ready);
  }
  if (less != 4.0) col = haze(col, V, dist);
  if (less != 2.0) col = tone(col);
  gl_FragColor = vec4(col, 1.0);
}
""";

// Grass tufts, instanced (see grass.l8): turned, sized, and swaying in
// the wind; they shrink away into the ground with distance.
GRASS_VS: str = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec4 inst;
attribute vec2 inst2;
uniform mat4 vp;
uniform mat4 light_vp;
uniform vec3 cam_pos;
uniform float time;
varying vec3 vworld;
varying vec3 vnrm;
varying vec4 vlight;
varying float vh;
varying float vtint;
void main() {
  float c = cos(inst.w);
  float s = sin(inst.w);
  vec2 xz = vec2(c * pos.x - s * pos.z, s * pos.x + c * pos.z);
  float d = length(cam_pos.xz - inst.xz);
  float h = pos.y * inst2.x * (1.0 - smoothstep(28.0, 42.0, d));
  // Gusts sweep across the banks; the tips bend most.
  float gust = sin(time * 1.1 + inst.x * 0.23 + inst.z * 0.17) * 0.5 + 0.5;
  float sway = (sin(time * 2.9 + inst.x * 1.7 + inst.z * 1.3) * 0.3 + gust) * 0.5 * inst2.x;
  vec2 bend = vec2(0.8, 0.6) * sway * pos.y * pos.y;
  vec3 w = vec3(inst.x + xz.x + bend.x, inst.y + h, inst.z + xz.y + bend.y);
  vworld = w;
  vh = pos.y;
  vtint = inst2.y;
  vnrm = vec3(c * nrm.x - s * nrm.z, nrm.y, s * nrm.x + c * nrm.z);
  vlight = light_vp * vec4(w, 1.0);
  gl_Position = vp * vec4(w, 1.0);
}
""";

GRASS_FS: str = """
uniform sampler2DShadow shadow_map;
uniform vec3 sun_dir;
uniform HP vec3 cam_pos;
uniform float shadow_texel;
varying HP vec3 vworld;
varying vec3 vnrm;
varying HP vec4 vlight;
varying float vh;
varying float vtint;
float sun_visibility() {
  HP vec3 sc = vlight.xyz / vlight.w * 0.5 + 0.5;
  if (sc.x < 0.002 || sc.x > 0.998 || sc.y < 0.002 || sc.y > 0.998 || sc.z > 1.0) return 1.0;
  HP float t = shadow_texel;
  float v = shadow2D(shadow_map, vec3(sc.xy, sc.z - 0.002)).r * 0.5;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(t, t), sc.z - 0.002)).r * 0.25;
  v += shadow2D(shadow_map, vec3(sc.xy - vec2(t, t), sc.z - 0.002)).r * 0.25;
  return v;
}
void main() {
  vec3 V = normalize(cam_pos - vworld);
  // Darker at the root, lighter and yellower toward the tip; dry patches
  // straw-colored.
  vec3 albedo = mix(vec3(0.04, 0.09, 0.03), vec3(0.13, 0.25, 0.07), vh);
  albedo = mix(albedo, albedo * vec3(1.5, 1.3, 0.8), vtint * 0.5);
  albedo *= 0.9 + 0.2 * vnoise(vworld.xz * 0.4);
  vec3 n = normalize(mix(normalize(vnrm), vec3(0.0, 1.0, 0.0), 0.45));
  if (dot(n, V) < 0.0) n = -n;
  float ndl = dot(n, sun_dir);
  float vis = sun_visibility();
  float diff = max((ndl + 0.5) / 1.5, 0.0);
  // Light through the blades from behind.
  // Against the sun, light comes gold through the tips.
  float back = max(dot(-V, sun_dir), 0.0);
  float through = back * back * vh * vh;
  vec3 sky = sky_light(n) * mix(0.5, 1.0, vh);
  vec3 col = albedo * (SUN_LIGHT * diff * vis + sky) + vec3(0.5, 0.36, 0.12) * SUN_LIGHT * through * vis * 0.18;
  if (look_disc.a > 0.0) col += albedo * lamps(vworld, n) * mix(0.5, 1.0, vh) * look_disc.a;
  gl_FragColor = vec4(tone(haze(col, V, length(cam_pos - vworld))), 1.0);
}
""";

// Glows (see glow.l8): squares facing the camera, a firefly drifting and
// blinking by its phase; light added, falling away from the middle, and
// fading with distance.
GLOW_VS: str = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec4 vcol;
uniform mat4 vp;
uniform vec3 cam_pos;
uniform vec3 cam_right;
uniform vec3 cam_up;
uniform float time;
varying vec2 vuv;
varying vec3 vcolor;
void main() {
  vec3 c = pos;
  float bright = 1.0;
  if (vcol.a > 0.0) {
    float ph = vcol.a * 40.0;
    c += vec3(sin(time * 0.31 + ph), sin(time * 0.47 + ph * 1.3) * 0.5, cos(time * 0.23 + ph * 0.7)) * 0.8;
    bright = pow(0.5 + 0.5 * sin(time * 1.3 + ph * 2.1), 6.0);
  }
  float d = length(cam_pos - c);
  bright *= exp(-d * 0.012);
  vuv = nrm.xy;
  vcolor = vcol.rgb * bright;
  gl_Position = vp * vec4(c + (cam_right * nrm.x + cam_up * nrm.y) * nrm.z, 1.0);
}
""";

GLOW_FS: str = """
#version 120
varying vec2 vuv;
varying vec3 vcolor;
void main() {
  float r2 = dot(vuv, vuv);
  float a = exp(-r2 * 4.0) - 0.018;
  gl_FragColor = vec4(vcolor * max(a, 0.0) * 0.55, 1.0);
}
""";

HUD_VS: str = """
#version 120
attribute vec2 pos;
uniform vec2 screen;
uniform vec2 offset;
void main() {
  vec2 p = pos + offset;
  gl_Position = vec4(p.x / screen.x * 2.0 - 1.0, 1.0 - p.y / screen.y * 2.0, 0.0, 1.0);
}
""";

HUD_FS: str = """
#version 120
uniform vec4 color;
void main() {
  gl_FragColor = color;
}
""";

// Into the shadow map: everything but the open ground (concrete and grass,
// and what is made of them: banks, kickers, a halfpipe's walls). The ground's
// shape shows in its shading; its own shadows would only show the steps of
// its mesh. (What casts is picked out when a place is built, so that the
// ground is not drawn into the map only to be thrown away: see
// build_shadow_index.)
SHADOW_VS: str = """
#version 120
attribute vec3 pos;
uniform mat4 mvp;
void main() {
  gl_Position = mvp * vec4(pos, 1.0);
}
""";

SHADOW_FS: str = """
#version 120
void main() {
  gl_FragColor = vec4(1.0);
}
""";

SKY_VS: str = """
#version 120
attribute vec3 pos;
varying vec2 vscreen;
void main() {
  vscreen = pos.xy;
  // (As far off as anything can be: it is drawn last, where nothing else
  // has been.)
  gl_Position = vec4(pos.xy, 1.0, 1.0);
}
""";

// The scene, drawn small, over the whole window.
STRETCH_FS: str = """
#version 120
#ifdef GL_ES
#define HP highp
#else
#define HP
#endif
uniform sampler2D scene;
// (At full precision: at medium, where a pixel's corner lies in the scene
// would be off by up to a pixel.)
varying HP vec2 vscreen;
void main() {
  gl_FragColor = vec4(texture2D(scene, vscreen * 0.5 + 0.5).rgb, 1.0);
}
""";

SKY_FS: str = """
uniform HP vec3 cam_f;
uniform HP vec3 cam_r;
uniform HP vec3 cam_u;
uniform HP vec2 tan_half;
uniform HP float shift;
uniform vec3 sun_dir;
uniform HP float time;
varying HP vec2 vscreen;
float clouds(HP vec2 p) {
  float v = 0.0;
  float a = 0.5;
  for (int i = 0; i < 4; i++) {
    v += a * vnoise(p);
    p = p * 2.03 + vec2(1.7, 9.2);
    a *= 0.5;
  }
  return v;
}
void main() {
  HP vec3 d = normalize(cam_f + vscreen.x * tan_half.x * cam_r + (vscreen.y - shift) * tan_half.y * cam_u);
  vec3 c = sky_base(d);
  // The sun's glow, and the sun.
  // (The disc is so sharp a power of s that s must be exact.)
  HP float s = max(dot(d, sky_sun), 0.0);
  float night = look_disc.a;
  float s2 = s * s;
  c += look_disc.rgb * (s2 * s2 * s2 * 0.3 + pow(s, mix(400.0, 2500.0, night)) * mix(3.0, 9.0, night));
  if (night > 0.0 && d.y > 0.0) {
    // Stars: one in a few of the sky's cells, small, some brighter, each
    // twinkling a little.
    HP vec2 sp = d.xz / (d.y + 0.35) * 60.0;
    HP vec2 cell = floor(sp);
    HP float h = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453);
    vec2 at = vec2(fract(h * 31.7), fract(h * 57.3)) * 0.6 + 0.2;
    float star = (1.0 - smoothstep(0.0, 0.11, length(fract(sp) - at))) * step(0.9, h);
    float twinkle = 0.75 + 0.25 * sin(time * (1.5 + h * 3.0) + h * 50.0);
    c += vec3(0.8, 0.86, 1.0) * star * (h - 0.9) * 14.0 * twinkle * smoothstep(0.0, 0.25, d.y) * night;
  }
  if (d.y > 0.0) {
    // Soft clouds, lit warm on the sun's side, lilac in their shade.
    HP vec2 p = d.xz / (d.y + 0.1) * 0.9 + vec2(time * 0.01, time * 0.003);
    float k = smoothstep(0.5, 0.7, clouds(p));
    float shade = clouds(p + sky_sun.xz * 0.12);
    float toward = max(dot(normalize(d.xz + vec2(0.0001, 0.0)), sky_sun_flat), 0.0);
    toward *= toward;
    vec3 lit = mix(vec3(1.0, 0.96, 0.98), vec3(1.15, 0.94, 0.8), toward);
    vec3 cloud = mix(lit, vec3(0.74, 0.7, 0.86), smoothstep(0.45, 0.72, shade));
    // (By night, dark shapes against the stars, their edges moonlit.)
    cloud = mix(cloud, cloud * vec3(0.06, 0.075, 0.12) * (1.0 + 2.0 * toward), night);
    c = mix(c, cloud, k * smoothstep(0.0, 0.2, d.y) * 0.8);
  }
  gl_FragColor = vec4(tone(c), 1.0);
}
""";

// GLSL source with a shared prelude after its version line.
with_prelude(src: str): []i8@new {
    head: str = "#version 120\n";
    out: []i8 = new i8[len(head) + len(SKY_GLSL) + len(src)](0i8);
    n: int = 0;
    for c in head {
        out[n] = c;
        n = n + 1
    }
    for c in SKY_GLSL {
        out[n] = c;
        n = n + 1
    }
    for c in src {
        out[n] = c;
        n = n + 1
    }
    out
}

gen_buffer(): u32 {
    ids: []u32 = new u32[1](0u32);
    glGenBuffers(1, ids);
    ids[0]
}

upload(buf: u32, m: *Mesh) {
    glBindBuffer(34962, buf);
    glBufferData(34962, m.n * VERTEX_FLOATS * 4, m.data, 35044)
}

bind_vertices(buf: u32) {
    glBindBuffer(34962, buf);
    glVertexAttribPointer(0, 3, 5126, 0, VERTEX_FLOATS * 4, 0);
    glVertexAttribPointer(1, 3, 5126, 0, VERTEX_FLOATS * 4, 12);
    glVertexAttribPointer(2, 4, 5126, 0, VERTEX_FLOATS * 4, 24)
}

new_renderer(parts: *Mesh) raises IoError: *Renderer@new {
    world: int = link_program(bytes(WORLD_VS), with_prelude(WORLD_FS));
    shadow: int = link_program(bytes(SHADOW_VS), bytes(SHADOW_FS));
    sky: int = link_program(bytes(SKY_VS), with_prelude(SKY_FS));
    hud: int = link_program(bytes(HUD_VS), bytes(HUD_FS));
    stretch: int = link_program(bytes(SKY_VS), bytes(STRETCH_FS));
    glow_prog: int = link_program(bytes(GLOW_VS), bytes(GLOW_FS));
    grass_prog: int = link_program(bytes(GRASS_VS), with_prelude(GRASS_FS));
    va: []u32 = new u32[1](0u32);
    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    for i in 0..3 glEnableVertexAttribArray(i);
    r: *Renderer = new Renderer {
        world: world,
        u_less: glGetUniformLocation(world, "less"),
        u_plain: glGetUniformLocation(world, "plain"),
        shadow: shadow,
        sky: sky,
        u_vp: glGetUniformLocation(world, "vp"),
        u_model: glGetUniformLocation(world, "model"),
        u_light: glGetUniformLocation(world, "light_vp"),
        u_sun: glGetUniformLocation(world, "sun_dir"),
        u_cam: glGetUniformLocation(world, "cam_pos"),
        u_texel: glGetUniformLocation(world, "shadow_texel"),
        u_blob: glGetUniformLocation(world, "blob"),
        u_shadow_map: glGetUniformLocation(world, "shadow_map"),
        u_smvp: glGetUniformLocation(shadow, "mvp"),
        u_cam_f: glGetUniformLocation(sky, "cam_f"),
        u_cam_r: glGetUniformLocation(sky, "cam_r"),
        u_cam_u: glGetUniformLocation(sky, "cam_u"),
        u_tan: glGetUniformLocation(sky, "tan_half"),
        u_shift: glGetUniformLocation(sky, "shift"),
        u_sky_sun: glGetUniformLocation(sky, "sun_dir"),
        u_time: glGetUniformLocation(sky, "time"),
        u_world_noise: glGetUniformLocation(world, "noise_map"),
        u_sky_noise: glGetUniformLocation(sky, "noise_map"),
        noise_tex: make_noise_texture(),
        course_buf: gen_buffer(),
        course_idx: gen_buffer(),
        shadow_idx: gen_buffer(),
        course_n: 0,
        part_buf: gen_buffer(),
        sky_buf: gen_buffer(),
        shadow_tex: 0u32,
        shadow_fbo: 0u32,
        scene_fbo: 0u32,
        scene_tex: 0u32,
        scene_many: 0u32,
        scene_color: 0u32,
        scene_depth: 0u32,
        scene_w: 0,
        scene_h: 0,
        stretch: stretch,
        u_stretch_scene: glGetUniformLocation(stretch, "scene"),
        hud: hud,
        u_hud_screen: glGetUniformLocation(hud, "screen"),
        u_hud_offset: glGetUniformLocation(hud, "offset"),
        u_hud_color: glGetUniformLocation(hud, "color"),
        hud_buf: gen_buffer(),
        glow: glow_prog,
        u_glow_vp: glGetUniformLocation(glow_prog, "vp"),
        u_glow_cam: glGetUniformLocation(glow_prog, "cam_pos"),
        u_glow_right: glGetUniformLocation(glow_prog, "cam_right"),
        u_glow_up: glGetUniformLocation(glow_prog, "cam_up"),
        u_glow_time: glGetUniformLocation(glow_prog, "time"),
        course_glow_buf: gen_buffer(),
        course_glow_n: 0,
        grass: grass_prog,
        u_grass_vp: glGetUniformLocation(grass_prog, "vp"),
        u_grass_light: glGetUniformLocation(grass_prog, "light_vp"),
        u_grass_sun: glGetUniformLocation(grass_prog, "sun_dir"),
        u_grass_cam: glGetUniformLocation(grass_prog, "cam_pos"),
        u_grass_texel: glGetUniformLocation(grass_prog, "shadow_texel"),
        u_grass_shadow: glGetUniformLocation(grass_prog, "shadow_map"),
        u_grass_time: glGetUniformLocation(grass_prog, "time"),
        u_grass_noise: glGetUniformLocation(grass_prog, "noise_map"),
        tuft_buf: gen_buffer(),
        grass_buf: gen_buffer(),
        u_dusk: new int[3](0),
        u_dusk_flat: new int[3](0),
        u_look: new int[3 * LOOK_UNIFORMS](0),
        u_lamp_map: new int[2](0),
        u_lamp_rect: new int[2](0),
        u_near0: glGetUniformLocation(world, "near0"),
        u_near1: glGetUniformLocation(world, "near1"),
        u_marks: new int[MAX_ZONES * 2](0),
        u_mark_c: new int[MAX_ZONES](0),
        u_mark_n: glGetUniformLocation(world, "mark_n"),
        u_mark_time: glGetUniformLocation(world, "mark_time"),
        u_ready: glGetUniformLocation(world, "ready"),
        u_run_half: glGetUniformLocation(world, "run_half"),
        u_park_floor: glGetUniformLocation(world, "park_floor"),
        course_lamps: 0u32
    };
    mark_names: []str = ["mark0a", "mark0b", "mark1a", "mark1b", "mark2a", "mark2b",
        "mark3a", "mark3b", "mark4a", "mark4b", "mark5a", "mark5b", "mark6a", "mark6b",
        "mark7a", "mark7b"];
    for k in 0..MAX_ZONES * 2 r.u_marks[k] = glGetUniformLocation(world, mark_names[k]);
    circle_names: []str = ["mark0c", "mark1c", "mark2c", "mark3c", "mark4c", "mark5c",
        "mark6c", "mark7c"];
    for k in 0..MAX_ZONES r.u_mark_c[k] = glGetUniformLocation(world, circle_names[k]);
    progs: []int = [world, grass_prog, sky];
    for k in 0..3 {
        r.u_dusk[k] = glGetUniformLocation(progs[k], "sky_sun");
        r.u_dusk_flat[k] = glGetUniformLocation(progs[k], "sky_sun_flat");
        for u in 0..LOOK_UNIFORMS r.u_look[k * LOOK_UNIFORMS + u] = glGetUniformLocation(progs[k],
            look_names[u]);
        if (k < 2) {
            r.u_lamp_map[k] = glGetUniformLocation(progs[k], "lamp_map");
            r.u_lamp_rect[k] = glGetUniformLocation(progs[k], "lamp_rect")
        }
    }
    upload(r.part_buf, parts);
    // One triangle over the whole screen.
    tri: []f32 = new f32[30](0.0);
    tri[0] = -1.0;
    tri[1] = -1.0;
    tri[10] = 3.0;
    tri[11] = -1.0;
    tri[20] = -1.0;
    tri[21] = 3.0;
    glBindBuffer(34962, r.sky_buf);
    glBufferData(34962, 120, tri, 35044);
    stex: []u32 = new u32[1](0u32);
    glGenTextures(1, stex);
    glBindTexture(3553, stex[0]);
    // Hardware bilinear PCF: filter depth comparisons, not depth values.
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 34892, 34894);
    glTexParameteri(3553, 34893, 515);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    // (Sixteen bits of depth: the nearest shadow's bias, 0.0004 of the
    // range, is twenty-six of its steps, and the map is half the memory
    // to write and read that twenty-four bits, padded out to thirty-two,
    // would be.)
    glTexImage2D(3553, 0, 33189, SHADOW_SIZE, SHADOW_SIZE, 0, 6402, 5123, null);
    fbo: []u32 = new u32[1](0u32);
    glGenFramebuffers(1, fbo);
    glBindFramebuffer(36160, fbo[0]);
    glFramebufferTexture2D(36160, 36096, 3553, stex[0], 0);
    glDrawBuffer(0);
    glReadBuffer(0);
    if (glCheckFramebufferStatus(36160) != 36053) die("shadow framebuffer incomplete");
    glBindFramebuffer(36160, 0u32);
    r.shadow_tex = stex[0];
    r.shadow_fbo = fbo[0];
    glEnable(2929);
    r
}

set_course_mesh(r: *Renderer, m: *Mesh) {
    // (Its corners by number: see index_mesh.)
    index_mesh(m);
    glBindBuffer(34962, r.course_buf);
    glBufferData(34962, mesh_distinct * VERTEX_FLOATS * 4, m.data, 35044);
    glBindBuffer(34963, r.course_idx);
    glNamedBufferData(r.course_idx, m.n * 4, mesh_index, 35044);
    r.course_n = m.n;
    build_shadow_index(m);
    glBindBuffer(34963, r.shadow_idx);
    glNamedBufferData(r.shadow_idx, shadow_n * 4, shadow_index, 35044)
}

// The triangles that cast shadows, by their corners' numbers, chunk by
// chunk: those not of the open ground (concrete or grass, or a blend of
// them), which is most of the mesh and casts none (see SHADOW_VS). The
// sun's pass draws these alone: see draw_casters.
const MAX_SHADOW_INDEX: int = 400000;

shadow_index: []i32 = new i32[MAX_SHADOW_INDEX](0i32);

shadow_n: int = 0;

shadow_first: []int = new int[MAX_CHUNKS](0);

shadow_count: []int = new int[MAX_CHUNKS](0);

build_shadow_index(m: *Mesh) {
    d: []f32 = m.data;
    n: int = 0;
    for c in 0..nchunks {
        shadow_first[c] = n;
        t: int = chunk_first[c];
        end: int = mini(chunk_first[c] + chunk_count[c], MAX_INDEX);
        while (t + 3 <= end && n + 3 <= MAX_SHADOW_INDEX) {
            if (casts(d, mesh_index[t] as int) && casts(d, mesh_index[t + 1] as int) && casts(d,
                mesh_index[t + 2] as int)) {
                shadow_index[n] = mesh_index[t];
                shadow_index[n + 1] = mesh_index[t + 1];
                shadow_index[n + 2] = mesh_index[t + 2];
                n = n + 3
            }
            t = t + 3
        }
        shadow_count[c] = n - shadow_first[c];
        breathe()
    }
    shadow_n = n
}

casts(d: []f32, corner: int): bool {
    d[corner * VERTEX_FLOATS + 9] >= 1.5
}

// Into the shadow map: the casters of the chunks from d0 to d1 down the
// course (or, in the park, of its squares) that the sun's picture `seen`
// holds.
draw_casters(
    r: *Renderer,
    seen: []f32,
    d0: f32,
    d1: f32
) {
    bind_vertices(r.course_buf);
    glBindBuffer(34963, r.shadow_idx);
    if (park) {
        k: int = 0;
        while (k < nchunks) {
            if (shadow_count[k] > 0 && chunk_in_view(seen, chunk_box, k)) {
                first: int = shadow_first[k];
                count: int = 0;
                while (k < nchunks && shadow_first[k] == first + count && chunk_in_view(seen,
                    chunk_box, k)) {
                    count = count + shadow_count[k];
                    k = k + 1
                }
                glDrawElements(4, count, 5125, first * 4)
            } else k = k + 1
        }
        return
    }
    a: int = chunk_index(d0);
    b: int = chunk_index(d1);
    while (a <= b && !chunk_in_view(seen, chunk_box, a)) a = a + 1;
    while (b >= a && !chunk_in_view(seen, chunk_box, b)) b = b - 1;
    if (a <= b) glDrawElements(4, shadow_first[b] + shadow_count[b] - shadow_first[a],
        5125, shadow_first[a] * 4)
}

// On the course, only the part from d0 to d1 down it: in full up to
// d_far, coarsely beyond.
draw_world(
    r: *Renderer,
    seen: []f32,
    d0: f32,
    d_far: f32,
    d1: f32
) {
    bind_vertices(r.course_buf);
    // (By their corners' numbers, four bytes each: see index_mesh.)
    glBindBuffer(34963, r.course_idx);
    if (park) {
        // The park's chunks are squares of it (see sort_park): those in
        // the picture `seen` makes, each run of them that lie together
        // drawn as one.
        k: int = 0;
        while (k < nchunks) {
            if (chunk_in_view(seen, chunk_box, k)) {
                first: int = chunk_first[k];
                count: int = 0;
                while (k < nchunks && chunk_first[k] == first + count && chunk_in_view(seen,
                    chunk_box, k)) {
                    count = count + chunk_count[k];
                    k = k + 1
                }
                glDrawElements(4, count, 5125, first * 4)
            } else k = k + 1
        }
        if (d1 > d_far) glDrawElements(4, backdrop_count, 5125, backdrop_first * 4);
        return
    }
    // The chunks from d0 to d_far: but not those at either end that are
    // out of the picture `seen` makes (behind the camera, say).
    a: int = chunk_index(d0);
    b: int = chunk_index(d_far);
    while (a <= b && !chunk_in_view(seen, chunk_box, a)) a = a + 1;
    while (b >= a && !chunk_in_view(seen, chunk_box, b)) b = b - 1;
    if (a <= b) glDrawElements(4, chunk_first[b] + chunk_count[b] - chunk_first[a],
        5125, chunk_first[a] * 4);
    if (d1 > d_far) {
        a = chunk_index(d_far + CHUNK_LEN);
        b = chunk_index(d1);
        while (a <= b && !chunk_in_view(seen, far_box, a)) a = a + 1;
        while (b >= a && !chunk_in_view(seen, far_box, b)) b = b - 1;
        if (a <= b) glDrawElements(4, far_first[b] + far_count[b] - far_first[a],
            5125, far_first[a] * 4);
        glDrawElements(4, backdrop_count, 5125, backdrop_first * 4)
    }
}

chunk_in_view(seen: []f32, boxes: []f32, k: int): bool {
    b: int = k * 6;
    // (A chunk with nothing in it has nothing to show.)
    boxes[b] <= boxes[b + 1] && box_in_view(seen, boxes[b], boxes[b + 1], boxes[b + 2],
        boxes[b + 3], boxes[b + 4], boxes[b + 5])
}

// Whether to draw the grass (L8_NO_GRASS turns it off, to compare).
grass_on: bool = true;

// The grass's tuft and tufts, once built.
set_grass(r: *Renderer) {
    glBindBuffer(34962, r.tuft_buf);
    glBufferData(34962, tuft_n * 24, tuft_data, 35044);
    glBindBuffer(34962, r.grass_buf);
    glBufferData(34962, grass_n * GRASS_FLOATS * 4, grass_inst, 35044)
}

// The tufts near him, with the world's shadows.
grass_shows(k: int, eye: V3): bool {
    b: int = k * 6;
    grass_near(k, eye) && box_in_view(vp_m, grass_box[b], grass_box[b + 1], grass_box[b + 4],
        grass_box[b + 5], grass_box[b + 2], grass_box[b + 3])
}

draw_grass(r: *Renderer, view: View) {
    glUseProgram(r.grass);
    glUniformMatrix4fv(r.u_grass_vp, 1, 0, vp_m);
    glUniformMatrix4fv(r.u_grass_light, 1, 0, light_vp);
    sun: V3 = v_norm(look.sun);
    glUniform3f(r.u_grass_sun, sun.x, sun.y, sun.z);
    glUniform3f(r.u_grass_cam, view.eye.x, view.eye.y, view.eye.z);
    glUniform1f(r.u_grass_texel, 1.0 / SHADOW_SIZE as f32);
    glUniform1i(r.u_grass_shadow, 0);
    glUniform1f(r.u_grass_time, view.time);
    glUniform1i(r.u_grass_noise, 1);
    set_lights(r, 1);
    glBindBuffer(34962, r.tuft_buf);
    glVertexAttribPointer(0, 3, 5126, 0, 24, 0);
    glVertexAttribPointer(1, 3, 5126, 0, 24, 12);
    glDisableVertexAttribArray(2);
    glBindBuffer(34962, r.grass_buf);
    glEnableVertexAttribArray(3);
    glEnableVertexAttribArray(4);
    glVertexAttribDivisor(3, 1);
    glVertexAttribDivisor(4, 1);
    // The chunks that could show (near enough, and in the picture), each
    // run of them that lie together drawn as one.
    k: int = 0;
    while (k < grass_chunks) {
        if (grass_shows(k, view.eye)) {
            first: int = grass_first[k];
            count: int = 0;
            while (k < grass_chunks && grass_first[k] == first + count && grass_shows(k,
                view.eye)) {
                count = count + grass_count[k];
                k = k + 1
            }
            glVertexAttribPointer(3, 4, 5126, 0, GRASS_FLOATS * 4, first * GRASS_FLOATS * 4);
            glVertexAttribPointer(4, 2, 5126, 0, GRASS_FLOATS * 4, first * GRASS_FLOATS * 4 + 16);
            // (A tuft is one strip of triangles.)
            glDrawArraysInstanced(5, 0, tuft_n, count)
        } else k = k + 1
    }
    glDisableVertexAttribArray(3);
    glDisableVertexAttribArray(4);
    glEnableVertexAttribArray(2)
}

// ---- lamps ----
// The lamps' light is worked out once, for every lamp, into a map of the
// ground: a byte a texel (its square root, so that dim light keeps its
// steps fine), half a meter apart. The shaders read it where they are.
const LAMP_TEXEL: f32 = 0.5;

// A map's corner, in meters, and its size in texels.
type LampMap = {
    x0: f32;
    z0: f32;
    w: int;
    h: int
}

course_map: LampMap = LampMap {
    x0: -28.0,
    z0: -400.0,
    w: 112,
    h: 860
};

// The park's lamps lie round its middle.
park_map: LampMap = LampMap {
    x0: -28.0,
    z0: -52.0,
    w: 112,
    h: 208
};

lamp_map_now(): LampMap {
    if (park) return park_map;
    course_map
}

lamp_bytes: []i8 = new i8[112 * 860](0i8);

// (The light itself, summed, before it is made bytes.)
lamp_light: []f32 = new f32[112 * 860](0.0);

// Light at distance d (in the ground's plane) from a lamp `height` up.
lamp_fall(d2: f32, height: f32, power: f32): f32 {
    power / (1.0 + 0.3 * (d2 + height * height)) * (1.0 - smoothstepf(60.0, 196.0,
        d2))
}

// The map of lamps at (xs[i], zs[i]), `height` up, as a texture.
make_lamp_map(
    old: u32,
    map: LampMap,
    xs: []f32,
    zs: []f32,
    n: int,
    height: f32,
    power: f32
): u32 {
    for i in 0..map.w * map.h lamp_light[i] = 0.0;
    // Each lamp's light, onto the texels it reaches (14 meters round it).
    reach: int = (14.0 / LAMP_TEXEL) as int + 1;
    for k in 0..n {
        ci: int = floorf((xs[k] - map.x0) / LAMP_TEXEL) as int;
        cj: int = floorf((zs[k] - map.z0) / LAMP_TEXEL) as int;
        for j in maxi(cj - reach, 0)..mini(cj + reach + 1, map.h) {
            for i in maxi(ci - reach, 0)..mini(ci + reach + 1, map.w) {
                dx: f32 = map.x0 + (i as f32 + 0.5) * LAMP_TEXEL - xs[k];
                dz: f32 = map.z0 + (j as f32 + 0.5) * LAMP_TEXEL - zs[k];
                d2: f32 = dx * dx + dz * dz;
                if (d2 < 196.0) lamp_light[j * map.w + i] = lamp_light[j * map.w + i] + lamp_fall(d2,
                    height, power)
            }
        }
    }
    for i in 0..map.w * map.h {
        v: f32 = sqrtf(clampf(lamp_light[i] / 5.0, 0.0, 1.0));
        lamp_bytes[i] = (v * 255.0) as int trunc i8
    }
    tex: []u32 = new u32[1](old);
    if (old == 0u32) glGenTextures(1, tex);
    glBindTexture(3553, tex[0]);
    glPixelStorei(3317, 1);
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 6409, map.w, map.h, 0, 6409, 5121, lamp_bytes);
    tex[0]
}

// The course's, again for each course (into the same texture).
set_course_lamps(r: *Renderer) {
    r.course_lamps = make_lamp_map(r.course_lamps, lamp_map_now(), lamp_x, lamp_z,
        nlamps, LAMP_HEIGHT, COURSE_LAMP_POWER)
}

// How bright the lamps are.
const COURSE_LAMP_POWER: f32 = 3.2;

// The sunset's direction, and the lamp map in use, into a program's
// uniforms (set k of the renderer's lit programs: world, grass, sky).
set_lights(r: *Renderer, k: int) {
    sun: V3 = v_norm(look.sun);
    glUniform3f(r.u_dusk[k], sun.x, sun.y, sun.z);
    flat: f32 = sqrtf(sun.x * sun.x + sun.z * sun.z);
    glUniform2f(r.u_dusk_flat[k], sun.x / flat, sun.z / flat);
    u: []int = r.u_look;
    b: int = k * LOOK_UNIFORMS;
    set3(u[b], look.zenith);
    set3(u[b + 1], look.away);
    set3(u[b + 2], look.toward);
    set3(u[b + 3], look.glow);
    set3(u[b + 4], look.sun_light);
    set3(u[b + 5], look.sky_up);
    set3(u[b + 6], look.sky_down);
    glUniform2f(u[b + 7], look.haze, look.haze_max);
    glUniform4f(u[b + 8], look.grade.x, look.grade.y, look.grade.z, look.sat);
    glUniform4f(u[b + 9], look.disc.x, look.disc.y, look.disc.z, look_night_now);
    if (k == 2) return;
    map: LampMap = lamp_map_now();
    glUniform1i(r.u_lamp_map[k], 2);
    glUniform4f(r.u_lamp_rect[k], map.x0, map.z0, 1.0 / (map.w as f32 * LAMP_TEXEL),
        1.0 / (map.h as f32 * LAMP_TEXEL))
}

// The two lamps nearest p, for lighting him.
set_near_lamps(r: *Renderer, p: V3) {
    b0: V3 = v3(0.0, -1000.0, 0.0);
    b1: V3 = b0;
    d0: f32 = 1000000.0;
    d1: f32 = 1000000.0;
    for i in 0..nlamps {
        l: V3 = v3(lamp_x[i], course_height(lamp_x[i], lamp_z[i]) + LAMP_HEIGHT, lamp_z[i]);
        d: f32 = v_len(v_sub(l, p));
        if (d < d0) {
            d1 = d0;
            b1 = b0;
            d0 = d;
            b0 = l
        } else if (d < d1) {
            d1 = d;
            b1 = l
        }
    }
    power: f32 = COURSE_LAMP_POWER;
    glUniform4f(r.u_near0, b0.x, b0.y, b0.z, power);
    glUniform4f(r.u_near1, b1.x, b1.y, b1.z, power)
}

// The glows (again for each course).
glows_on: bool = true;

set_course_glows(r: *Renderer) {
    build_course_glows();
    glBindBuffer(34962, r.course_glow_buf);
    glBufferData(34962, glow_n * VERTEX_FLOATS * 4, glow_data, 35044);
    r.course_glow_n = glow_n
}

draw_glows(r: *Renderer, view: View) {
    glUseProgram(r.glow);
    glUniformMatrix4fv(r.u_glow_vp, 1, 0, vp_m);
    glUniform3f(r.u_glow_cam, view.eye.x, view.eye.y, view.eye.z);
    f: V3 = v_norm(v_sub(view.at, view.eye));
    rt: V3 = v_norm(v_cross(f, v3(0.0, 1.0, 0.0)));
    up: V3 = v_cross(rt, f);
    glUniform3f(r.u_glow_right, rt.x, rt.y, rt.z);
    glUniform3f(r.u_glow_up, up.x, up.y, up.z);
    glUniform1f(r.u_glow_time, view.time);
    glDepthMask(0);
    glEnable(3042);
    glBlendFunc(1, 1);
    bind_vertices(r.course_glow_buf);
    glDrawArrays(4, 0, r.course_glow_n);
    glDisable(3042);
    glDepthMask(1)
}

// Value noise for the shaders: a 64-cell lattice of random values over 256
// texels, smoothly interpolated, wrapping, with its mipmaps so distant
// detail does not shimmer.
const NOISE_SIZE: int = 256;

const NOISE_CELLS: int = 64;

make_noise_texture(): u32 {
    lattice: []f32 = new f32[NOISE_CELLS * NOISE_CELLS](0.0);
    rng: int = 99991;
    for i in 0..NOISE_CELLS * NOISE_CELLS {
        rng = (rng * 1103515245 + 12345) % 2147483648;
        if (rng < 0) rng = -rng;
        lattice[i] = (rng / 65536 % 32768) as f32 / 32767.0
    }
    level: []i8 = new i8[NOISE_SIZE * NOISE_SIZE](0i8);
    k: int = NOISE_SIZE / NOISE_CELLS;
    for y in 0..NOISE_SIZE {
        for x in 0..NOISE_SIZE {
            cx: int = x / k;
            cy: int = y / k;
            fx: f32 = (x % k) as f32 / k as f32;
            fy: f32 = (y % k) as f32 / k as f32;
            fx = fx * fx * (3.0 - 2.0 * fx);
            fy = fy * fy * (3.0 - 2.0 * fy);
            x1: int = (cx + 1) % NOISE_CELLS;
            y1: int = (cy + 1) % NOISE_CELLS;
            a: f32 = lerpf(lattice[cy * NOISE_CELLS + cx], lattice[cy * NOISE_CELLS + x1],
                fx);
            b: f32 = lerpf(lattice[y1 * NOISE_CELLS + cx], lattice[y1 * NOISE_CELLS + x1],
                fx);
            level[y * NOISE_SIZE + x] = (lerpf(a, b, fy) * 255.0) as int trunc i8
        }
    }
    tex: []u32 = new u32[1](0u32);
    glGenTextures(1, tex);
    glBindTexture(3553, tex[0]);
    glPixelStorei(3317, 1);
    glTexParameteri(3553, 10241, 9987);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 10497);
    glTexParameteri(3553, 10243, 10497);
    size: int = NOISE_SIZE;
    lod: int = 0;
    next: []i8 = new i8[NOISE_SIZE * NOISE_SIZE / 4](0i8);
    while (size >= 1) {
        glTexImage2D(3553, lod, 6409, size, size, 0, 6409, 5121, level);
        if (size > 1) {
            half: int = size / 2;
            for y in 0..half {
                for x in 0..half {
                    sum: int = byte_value(level[2 * y * size + 2 * x]) + byte_value(level[2 * y * size + 2 * x + 1]) + byte_value(level[(2 * y + 1) * size + 2 * x]) + byte_value(level[(2 * y + 1) * size + 2 * x + 1]);
                    next[y * half + x] = (sum / 4) trunc i8
                }
            }
            for i in 0..half * half level[i] = next[i]
        }
        size = size / 2;
        lod = lod + 1
    }
    tex[0]
}

byte_value(b: i8): int {
    v: int = b as int;
    if (v < 0) v = v + 256;
    v
}

// What a frame needs from the game.
type View = {
    eye: V3;
    at: V3;
    fovy: f32;
    // What the picture is of (the ground round it is drawn, and shadowed),
    // and where he is (his own shadow, and the lamps on him): the same
    // place, but when a place is being shown off (see fly_over, in main.l8).
    focus: V3;
    rider: V3;
    time: f32;
    // How far up the picture moves, in screen heights times two (so that
    // what the camera looks at sits above the middle).
    shift: f32
}

// ---- looks ----
// How the world looks: where the sun is and its light, the sky and its
// light, the air, the grade, and the colors of things. A few to compare;
// L8_LOOK picks one by its letter.
type Look = {
    sun: V3;
    sun_light: V3;
    sky_up: V3;
    sky_down: V3;
    zenith: V3;
    away: V3;
    toward: V3;
    glow: V3;
    haze: f32;
    haze_max: f32;
    grade: V3;
    sat: f32;
    run: V3;
    kicker: V3;
    grass: V3;
    hill_low: V3;
    hill_high: V3;
    leaf: V3;
    // Whether the banks have grass tufts.
    tufts: bool;
    // The sun's (or moon's) disc in the sky; and whether it is night: stars,
    // and the lamps lit.
    disc: V3;
    night: bool
}

const LOOK_UNIFORMS: int = 10;

look_names: []str = ["look_zenith", "look_away", "look_toward", "look_glow", "look_sun",
    "look_sky_up", "look_sky_down", "look_haze", "look_grade", "look_disc"];

// a: a clear day, crisp, the sun from the side, deep greens.
look_clear: Look = Look {
    sun: v3(-0.5, 0.75, 0.42),
    sun_light: v3(2.4, 2.28, 2.06),
    sky_up: v3(0.27, 0.37, 0.61),
    sky_down: v3(0.29, 0.26, 0.22),
    zenith: v3(0.14, 0.34, 0.8),
    away: v3(0.62, 0.78, 0.95),
    toward: v3(0.92, 0.9, 0.86),
    glow: v3(0.2, 0.19, 0.17),
    haze: 0.0012,
    haze_max: 0.55,
    grade: v3(0.62, 0.62, 0.6),
    sat: 1.12,
    run: v3(0.82, 0.76, 0.68),
    kicker: v3(0.92, 0.58, 0.36),
    grass: v3(0.26, 0.5, 0.24),
    hill_low: v3(0.2, 0.42, 0.22),
    hill_high: v3(0.42, 0.62, 0.3),
    leaf: v3(0.22, 0.48, 0.2),
    tufts: false,
    disc: v3(1.0, 0.9, 0.75),
    night: false
};

// b: late golden light, low ahead of him, its glow in the sky.
look_golden: Look = Look {
    sun: v3(-0.55, 0.3, -0.78),
    sun_light: v3(2.6, 1.92, 1.2),
    sky_up: v3(0.24, 0.32, 0.53),
    sky_down: v3(0.27, 0.22, 0.18),
    zenith: v3(0.16, 0.3, 0.62),
    away: v3(0.64, 0.62, 0.8),
    toward: v3(1.1, 0.8, 0.66),
    glow: v3(0.5, 0.36, 0.25),
    haze: 0.0024,
    haze_max: 0.75,
    grade: v3(0.66, 0.62, 0.56),
    sat: 1.08,
    run: v3(0.74, 0.68, 0.6),
    kicker: v3(0.88, 0.6, 0.4),
    grass: v3(0.3, 0.48, 0.22),
    hill_low: v3(0.3, 0.5, 0.26),
    hill_high: v3(0.58, 0.7, 0.38),
    leaf: v3(0.27, 0.48, 0.17),
    tufts: true,
    disc: v3(1.0, 0.78, 0.55),
    night: false
};

// c: soft and pastel, like a toy: a high gentle sun, a strong sky fill,
// mint grass, coral kickers.
look_toy: Look = Look {
    sun: v3(-0.35, 0.85, 0.35),
    sun_light: v3(1.5, 1.44, 1.35),
    sky_up: v3(0.54, 0.6, 0.77),
    sky_down: v3(0.42, 0.36, 0.35),
    zenith: v3(0.45, 0.62, 0.9),
    away: v3(0.85, 0.82, 0.92),
    toward: v3(0.98, 0.88, 0.84),
    glow: v3(0.15, 0.14, 0.13),
    haze: 0.0018,
    haze_max: 0.6,
    grade: v3(0.7, 0.69, 0.68),
    sat: 1.05,
    run: v3(0.92, 0.84, 0.78),
    kicker: v3(0.96, 0.62, 0.52),
    grass: v3(0.5, 0.74, 0.48),
    hill_low: v3(0.45, 0.66, 0.45),
    hill_high: v3(0.68, 0.82, 0.58),
    leaf: v3(0.4, 0.7, 0.42),
    tufts: false,
    disc: v3(1.0, 0.92, 0.8),
    night: false
};

// n: night. A bright moon, high to one side, on a clear starry sky; cool
// and dim, with the lamps' warm pools down the run.
look_night: Look = Look {
    sun: v3(0.5, 0.62, -0.42),
    sun_light: v3(0.2, 0.27, 0.46),
    sky_up: v3(0.028, 0.042, 0.095),
    sky_down: v3(0.016, 0.017, 0.028),
    zenith: v3(0.008, 0.014, 0.045),
    away: v3(0.03, 0.045, 0.1),
    toward: v3(0.05, 0.07, 0.14),
    glow: v3(0.06, 0.08, 0.14),
    haze: 0.003,
    haze_max: 0.85,
    grade: v3(0.9, 0.92, 1.0),
    sat: 1.0,
    run: v3(0.74, 0.68, 0.6),
    kicker: v3(0.88, 0.6, 0.4),
    grass: v3(0.3, 0.48, 0.22),
    hill_low: v3(0.3, 0.5, 0.26),
    hill_high: v3(0.58, 0.7, 0.38),
    leaf: v3(0.27, 0.48, 0.17),
    tufts: true,
    disc: v3(0.75, 0.82, 1.0),
    night: true
};

look: Look = look_golden;

// How much it is night, from 0 by day to 1: in between only while one look
// turns into another (see turn_look).
look_night_now: f32 = 0.0;

// Choose the look by its letter (or keep the first).
pick_look(c: int) {
    if (c == 97) look = look_clear;
    if (c == 98) look = look_golden;
    if (c == 99) look = look_toy;
    if (c == 110) look = look_night;
    look_night_now = 0.0;
    if (look.night) look_night_now = 1.0;
    look_turn = 1.0;
    grass_color = look.grass;
    if (!look.tufts) grass_on = false
}

// One look turns into another over a moment (night falling, or lifting),
// not all at once: from the look as it was, to the one chosen, look_turn
// of the way (1 when it is done). `look` is at once the chosen one's in
// what is not a matter of light (whether it is night, for one).
const LOOK_TURN: f32 = 0.9;

look_from: Look = look_golden;

look_to: Look = look_golden;

look_turn: f32 = 1.0;

// (How much it was night, and is to be.)
look_night_from: f32 = 0.0;

look_night_to: f32 = 0.0;

turn_look(c: int) {
    look_from = look;
    look_night_from = look_night_now;
    pick_look(c);
    look_to = look;
    look_night_to = look_night_now;
    look_turn = 0.0;
    turn_looks(0.0)
}

// Carry the turning on by dt seconds.
turn_looks(dt: f32) {
    if (look_turn >= 1.0) return;
    look_turn = minf(look_turn + dt / LOOK_TURN, 1.0);
    k: f32 = look_turn * look_turn * (3.0 - 2.0 * look_turn);
    a: Look = look_from;
    b: Look = look_to;
    look.sun = v_lerp(a.sun, b.sun, k);
    look.sun_light = v_lerp(a.sun_light, b.sun_light, k);
    look.sky_up = v_lerp(a.sky_up, b.sky_up, k);
    look.sky_down = v_lerp(a.sky_down, b.sky_down, k);
    look.zenith = v_lerp(a.zenith, b.zenith, k);
    look.away = v_lerp(a.away, b.away, k);
    look.toward = v_lerp(a.toward, b.toward, k);
    look.glow = v_lerp(a.glow, b.glow, k);
    look.haze = lerpf(a.haze, b.haze, k);
    look.haze_max = lerpf(a.haze_max, b.haze_max, k);
    look.grade = v_lerp(a.grade, b.grade, k);
    look.sat = lerpf(a.sat, b.sat, k);
    look.disc = v_lerp(a.disc, b.disc, k);
    look_night_now = lerpf(look_night_from, look_night_to, k)
}

// The circle on the ground that zone k lies inside (see mark_at, in the
// world's shader, for what its numbers are): its middle, and its radius
// squared, into a uniform.
set_zone_circle(loc: int, k: int) {
    z: int = k * 8;
    kind: f32 = floorf(zone_rect[z + 6] + 0.001);
    if (kind > 1.5) {
        // The bowl: within reach of where he would ride up it.
        glUniform3f(loc, zone_rect[z + 2], zone_rect[z + 3], zone_rect[z + 4] * zone_rect[z + 4]);
        return
    }
    // In its own frame (turned by its yaw): a wall's bands either side of
    // the middle, from where it starts down the run to where it ends; or a
    // ramp's, across it, from where it lands the trick to its end.
    x: f32 = 0.0;
    half_x: f32 = maxf(absf(zone_rect[z]), absf(zone_rect[z + 1]));
    d0: f32 = zone_rect[z + 2];
    if (kind < 0.5) {
        x = (zone_rect[z] + zone_rect[z + 1]) * 0.5;
        half_x = absf(zone_rect[z + 1] - zone_rect[z]) * 0.5;
        d0 = zone_rect[z + 3]
    }
    d1: f32 = zone_rect[z + 4];
    half_d: f32 = absf(d1 - d0) * 0.5;
    r: f32 = sqrtf(half_x * half_x + half_d * half_d) + 0.6;
    // Back into the world's frame.
    c: f32 = cosf(zone_rect[z + 7]);
    sn: f32 = sinf(zone_rect[z + 7]);
    lz: f32 = -(d0 + d1) * 0.5;
    glUniform3f(loc, x * c - lz * sn, x * sn + lz * c, r * r)
}

// Whether any of a box (x0..x1, y0..y1, z0..z1) could be in the picture
// that the matrix m makes (the camera's, vp_m, once the frame's camera is
// set; or the sun's, light_vp, of what casts the shadows): by its sides
// and its near end. For each, the box's corner furthest in is tried: if
// that is out, all of it is.
box_in_view(
    m: []f32,
    x0: f32,
    x1: f32,
    y0: f32,
    y1: f32,
    z0: f32,
    z1: f32
): bool {
    for side in 0..5 {
        // w + x, w - x, w + y, w - y, w + z: rows of the matrix.
        row: int = side / 2;
        sign: f32 = 1.0;
        if (side % 2 == 1) sign = -1.0;
        a: f32 = m[3] + sign * m[row];
        b: f32 = m[7] + sign * m[4 + row];
        c: f32 = m[11] + sign * m[8 + row];
        d: f32 = m[15] + sign * m[12 + row];
        x: f32 = x0;
        if (a > 0.0) x = x1;
        y: f32 = y0;
        if (b > 0.0) y = y1;
        z: f32 = z0;
        if (c > 0.0) z = z1;
        if (a * x + b * y + c * z + d < 0.0) return false
    }
    true
}

set3(loc: int, v: V3) {
    glUniform3f(loc, v.x, v.y, v.z)
}

view_m: []f32 = new f32[16](0.0);

proj_m: []f32 = new f32[16](0.0);

vp_m: []f32 = new f32[16](0.0);

light_view: []f32 = new f32[16](0.0);

light_proj: []f32 = new f32[16](0.0);

light_vp: []f32 = new f32[16](0.0);

mvp_m: []f32 = new f32[16](0.0);

ident_m: []f32 = new f32[16](0.0);

part_tmp: []f32 = new f32[16](0.0);

// The sun's view: an orthographic box around the focus, moved in whole
// shadow texels so shadows do not crawl as it follows.
fit_shadow(focus: V3) {
    sun: V3 = v_norm(look.sun);
    mat_look(light_view, v_scale(sun, 200.0), v3(0.0, 0.0, 0.0), v3(0.0, 1.0, 0.0));
    c: V3 = mat_point(light_view, focus);
    texel: f32 = 2.0 * SHADOW_HALF / SHADOW_SIZE as f32;
    cx: f32 = floorf(c.x / texel) * texel;
    cy: f32 = floorf(c.y / texel) * texel;
    mat_ortho(light_proj, cx - SHADOW_HALF, cx + SHADOW_HALF, cy - SHADOW_HALF, cy + SHADOW_HALF,
        -c.z - 90.0, -c.z + 90.0);
    mat_mul(light_vp, light_proj, light_view)
}

draw_shadow_mesh(r: *Renderer, model: []f32) {
    mat_mul(mvp_m, light_vp, model);
    glUniformMatrix4fv(r.u_smvp, 1, 0, mvp_m)
}

// Parts of a frame, as GL debug groups: GPU debuggers show them, and the
// web page times them (?gputime). frame_phase ends the previous part and
// starts the next.
frame_phase_open: bool = false;

frame_phase(name: str) {
    if (frame_phase_open) glPopDebugGroup();
    // GL_DEBUG_SOURCE_APPLICATION
    glPushDebugGroup(33354, 0, len(name), name);
    frame_phase_open = true
}

frame_phase_end() {
    if (frame_phase_open) glPopDebugGroup();
    frame_phase_open = false
}

// How big the scene is drawn, of the window's size each way: at less than
// 1, it is drawn small and stretched over the window, with the words and
// marks over it then drawn at the window's own size, as sharp as ever. (The
// page makes its whole picture smaller first, down to half: see setScale,
// in its skate.js. This is for smaller still.)
render_scale: f32 = 1.0;

// How many samples each of its pixels is made of, drawn small, so that
// its edges are smooth (the fewer the pixels, the more it shows where they
// are not).
const SCENE_SAMPLES: int = 4;

// Somewhere to draw the scene at render_scale, if that is small: whether
// it is.
fit_scene(r: *Renderer): bool {
    if (render_scale > 0.995) return false;
    w: int = maxi((screen_w as f32 * render_scale + 0.5) as int, 1);
    h: int = maxi((screen_h as f32 * render_scale + 0.5) as int, 1);
    if (r.scene_fbo == 0u32) {
        one: []u32 = new u32[1](0u32);
        glGenTextures(1, one);
        r.scene_tex = one[0];
        glBindTexture(3553, r.scene_tex);
        glTexParameteri(3553, 10241, 9729);
        glTexParameteri(3553, 10240, 9729);
        glTexParameteri(3553, 10242, 33071);
        glTexParameteri(3553, 10243, 33071);
        glGenRenderbuffers(1, one);
        r.scene_depth = one[0];
        glGenRenderbuffers(1, one);
        r.scene_color = one[0];
        glGenFramebuffers(1, one);
        r.scene_fbo = one[0];
        glGenFramebuffers(1, one);
        r.scene_many = one[0];
        r.scene_w = 0
    }
    if (w != r.scene_w || h != r.scene_h) {
        r.scene_w = w;
        r.scene_h = h;
        glBindTexture(3553, r.scene_tex);
        glTexImage2D(3553, 0, 32856, w, h, 0, 6408, 5121, null);
        glBindFramebuffer(36160, r.scene_fbo);
        glFramebufferTexture2D(36160, 36064, 3553, r.scene_tex, 0);
        glBindRenderbuffer(36161, r.scene_color);
        glRenderbufferStorageMultisample(36161, SCENE_SAMPLES, 32856, w, h);
        glBindRenderbuffer(36161, r.scene_depth);
        glRenderbufferStorageMultisample(36161, SCENE_SAMPLES, 33190, w, h);
        glBindFramebuffer(36160, r.scene_many);
        glFramebufferRenderbuffer(36160, 36064, 36161, r.scene_color);
        glFramebufferRenderbuffer(36160, 36096, 36161, r.scene_depth)
    }
    true
}

// A part of the work of coloring the world's pixels left out, to find what
// each costs on a device (the page's ?probe steps through them with F9):
// 0 none, 1 the sun's shadows, 2 the grade and curve at the end, 3 what
// each stuff is given (its slabs, grain, patches), 4 the haze, 5 the
// highlights and what is under him, 6 all of it but the stuff's plain
// color.
shade_less: int = 0;

const SHADE_LESS: int = 7;

// How plainly surfaces are colored, from 0 (in full) to 1: without the
// warm and cool of the concrete's slabs, their joints, and its broad
// patches; the grass's patches; the wood's grain and the leaves' lumps;
// and with no shine on any of them. Each has its color on the whole, and
// the slabs their shades, so the ground still moves under him. It is for a
// device that cannot keep up even with the picture at its smallest (the
// page asks for it then: see pace, in its skate.js), and comes and goes
// over a moment: where it is, and where it is going.
shade_plain: f32 = 0.0;

shade_plain_to: f32 = 0.0;

draw_scene(r: *Renderer, view: View, shadows: bool) {
    mat_identity(ident_m);
    fit_shadow(view.focus);
    frame_phase("shadow");
    glBindFramebuffer(36160, r.shadow_fbo);
    glViewport(0, 0, SHADOW_SIZE, SHADOW_SIZE);
    glClear(256);
    if (shadows) {
        glUseProgram(r.shadow);
        glEnable(32823);
        glPolygonOffset(1.5, 2.0);
        draw_shadow_mesh(r, ident_m);
        // Only what is near enough to cast a shadow he could see.
        draw_casters(r, light_vp, -view.focus.z - 40.0, -view.focus.z + 40.0);
        bind_vertices(r.part_buf);
        for i in 0..ndraw {
            for k in 0..16 part_tmp[k] = draw_m[i * 16 + k];
            mat_mul(mvp_m, light_vp, part_tmp);
            glUniformMatrix4fv(r.u_smvp, 1, 0, mvp_m);
            glDrawArrays(4, part_first[draw_part[i]], part_count[draw_part[i]])
        }
        glDisable(32823)
    }
    small: bool = fit_scene(r);
    if (small) {
        glBindFramebuffer(36160, r.scene_many);
        glViewport(0, 0, r.scene_w, r.scene_h)
    } else {
        glBindFramebuffer(36160, 0u32);
        glViewport(0, 0, screen_w, screen_h)
    }
    glClear(16640);
    // Camera.
    aspect: f32 = screen_w as f32 / screen_h as f32;
    mat_persp(proj_m, view.fovy, aspect, 0.1, 2500.0);
    proj_m[9] = -view.shift;
    mat_look(view_m, view.eye, view.at, v3(0.0, 1.0, 0.0));
    mat_mul(vp_m, proj_m, view_m);
    sun: V3 = v_norm(look.sun);
    // The lamp map, on texture unit 2.
    glActiveTexture(33986);
    glBindTexture(3553, r.course_lamps);
    // (The noise, on texture unit 1, for the world and the sky.)
    glActiveTexture(33985);
    glBindTexture(3553, r.noise_tex);
    frame_phase("world");
    glUseProgram(r.world);
    set_lights(r, 0);
    glUniform1f(r.u_less, shade_less as f32);
    glUniform1f(r.u_plain, shade_plain);
    glUniformMatrix4fv(r.u_vp, 1, 0, vp_m);
    glUniformMatrix4fv(r.u_light, 1, 0, light_vp);
    glUniform3f(r.u_sun, sun.x, sun.y, sun.z);
    glUniform3f(r.u_cam, view.eye.x, view.eye.y, view.eye.z);
    glUniform1f(r.u_texel, 1.0 / SHADOW_SIZE as f32);
    glUniform3f(r.u_blob, view.rider.x, view.rider.y, view.rider.z);
    // Where the top of his cap is on the screen, for the words over him.
    cx: f32 = view.rider.x;
    cy: f32 = view.rider.y + 1.6;
    cz: f32 = view.rider.z;
    cw: f32 = vp_m[3] * cx + vp_m[7] * cy + vp_m[11] * cz + vp_m[15];
    hud_rider_seen = cw > 0.1;
    if (hud_rider_seen) {
        hud_rider_x = ((vp_m[0] * cx + vp_m[4] * cy + vp_m[8] * cz + vp_m[12]) / cw * 0.5 + 0.5) * screen_w as f32;
        hud_rider_y = (0.5 - (vp_m[1] * cx + vp_m[5] * cy + vp_m[9] * cz + vp_m[13]) / cw * 0.5) * screen_h as f32
    }
    glUniform1f(r.u_mark_n, nzones as f32);
    glUniform1f(r.u_mark_time, view.time);
    glUniform1f(r.u_ready, ready_fade);
    if (park) glUniform1f(r.u_run_half, 0.0) else glUniform1f(r.u_run_half, COURSE_HALF);
    glUniform4f(r.u_park_floor, PARK_HX, PARK_HZ, PARK_CORNER, 0.0);
    for k in 0..MAX_ZONES * 2 glUniform4f(r.u_marks[k], zone_rect[k * 4], zone_rect[k * 4 + 1],
        zone_rect[k * 4 + 2], zone_rect[k * 4 + 3]);
    for k in 0..nzones set_zone_circle(r.u_mark_c[k], k);
    glActiveTexture(33984);
    glBindTexture(3553, r.shadow_tex);
    glUniform1i(r.u_shadow_map, 0);
    glUniform1i(r.u_world_noise, 1);
    glUniformMatrix4fv(r.u_model, 1, 0, ident_m);
    draw_world(r, vp_m, -view.focus.z - 40.0, -view.focus.z + 110.0, -view.focus.z + 600.0);
    if (grass_on) {
        frame_phase("grass");
        draw_grass(r, view)
    }
    frame_phase("guy");
    glUseProgram(r.world);
    set_near_lamps(r, view.rider);
    bind_vertices(r.part_buf);
    for i in 0..ndraw {
        glUniformMatrix4fv(r.u_model, 1, 0, &draw_m[i * 16]);
        glDrawArrays(4, part_first[draw_part[i]], part_count[draw_part[i]])
    }
    // The sky last of what is solid, and only where nothing else is: at
    // the far end of the depth, which it passes by being no further.
    frame_phase("sky");
    glDepthMask(0);
    glDepthFunc(515);
    glUseProgram(r.sky);
    f: V3 = v_norm(v_sub(view.at, view.eye));
    rt: V3 = v_norm(v_cross(f, v3(0.0, 1.0, 0.0)));
    up: V3 = v_cross(rt, f);
    glUniform3f(r.u_cam_f, f.x, f.y, f.z);
    glUniform3f(r.u_cam_r, rt.x, rt.y, rt.z);
    glUniform3f(r.u_cam_u, up.x, up.y, up.z);
    th: f32 = sinf(view.fovy * 0.5) / cosf(view.fovy * 0.5);
    glUniform2f(r.u_tan, th * aspect, th);
    glUniform1f(r.u_shift, view.shift);
    glUniform3f(r.u_sky_sun, sun.x, sun.y, sun.z);
    glUniform1f(r.u_time, view.time);
    set_lights(r, 2);
    glUniform1i(r.u_sky_noise, 1);
    bind_vertices(r.sky_buf);
    glDrawArrays(4, 0, 3);
    glDepthFunc(513);
    glDepthMask(1);
    if (glows_on) {
        frame_phase("glow");
        draw_glows(r, view)
    }
    if (small) {
        // The scene, stretched over the window.
        frame_phase("stretch");
        // (Its samples made into pixels, first.)
        glBindFramebuffer(36008, r.scene_many);
        glBindFramebuffer(36009, r.scene_fbo);
        glBlitFramebuffer(0, 0, r.scene_w, r.scene_h, 0, 0, r.scene_w, r.scene_h,
            16384, 9728);
        glBindFramebuffer(36160, 0u32);
        glViewport(0, 0, screen_w, screen_h);
        glDisable(2929);
        glUseProgram(r.stretch);
        glActiveTexture(33984);
        glBindTexture(3553, r.scene_tex);
        glUniform1i(r.u_stretch_scene, 0);
        bind_vertices(r.sky_buf);
        glDrawArrays(4, 0, 3);
        glEnable(2929)
    }
    frame_phase_end()
}

// The trick feed over the scene: each run of text with a soft shadow.
draw_hud(r: *Renderer) {
    build_hud(screen_w);
    if (hud_n == 0) return;
    frame_phase("hud");
    glDisable(2929);
    glEnable(3042);
    glBlendFunc(770, 771);
    glUseProgram(r.hud);
    glUniform2f(r.u_hud_screen, screen_w as f32, screen_h as f32);
    glBindBuffer(34962, r.hud_buf);
    glBufferData(34962, hud_n * 4, hud_verts, 35048);
    glDisableVertexAttribArray(1);
    glDisableVertexAttribArray(2);
    glVertexAttribPointer(0, 2, 5126, 0, 8, 0);
    for i in 0..nruns {
        a: f32 = run_rgba[i * 4 + 3];
        // A soft shadow below, and a fine dark edge to keep its pixels
        // crisp (but for a plain shape: see run_plain).
        if (!run_plain[i]) {
            glUniform2f(r.u_hud_offset, hud_px * 0.8, hud_px * 0.8);
            glUniform4f(r.u_hud_color, 0.0, 0.0, 0.02, 0.4 * a);
            glDrawArrays(4, run_first[i], run_count[i]);
            o: f32 = maxf(1.0, hud_px * 0.4);
            glUniform4f(r.u_hud_color, 0.03, 0.03, 0.05, 0.6 * a);
            for k in 0..4 {
                t: f32 = TAU * k as f32 / 4.0;
                glUniform2f(r.u_hud_offset, cosf(t) * o, sinf(t) * o);
                glDrawArrays(4, run_first[i], run_count[i])
            }
        }
        glUniform2f(r.u_hud_offset, 0.0, 0.0);
        glUniform4f(r.u_hud_color, run_rgba[i * 4], run_rgba[i * 4 + 1], run_rgba[i * 4 + 2],
            a);
        glDrawArrays(4, run_first[i], run_count[i])
    }
    glEnableVertexAttribArray(1);
    glEnableVertexAttribArray(2);
    glDisable(3042);
    glEnable(2929);
    frame_phase_end()
}
