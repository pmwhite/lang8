tag skate;

use_tag std;

use_tag gl;

// Drawing: a daytime sky, the ground and features lit by a warm sun with a
// shadow map that follows the player, and the guy. Lighting is done in
// linear color, tone mapped and gamma corrected at the end.
const SHADOW_SIZE: int = 2048;

const SHADOW_HALF: f32 = 26.0;

type Renderer = {
    world: int;
    shadow: int;
    sky: int;
    u_vp: int;
    u_model: int;
    u_light: int;
    u_sun: int;
    u_cam: int;
    u_texel: int;
    u_blob: int;
    u_pool_lip: int;
    u_shadow_map: int;
    u_smvp: int;
    u_cam_f: int;
    u_cam_r: int;
    u_cam_u: int;
    u_tan: int;
    u_shift: int;
    u_sky_sun: int;
    u_time: int;
    u_world_noise: int;
    u_sky_noise: int;
    noise_tex: u32;
    world_buf: u32;
    world_n: int;
    course_buf: u32;
    course_n: int;
    part_buf: u32;
    sky_buf: u32;
    shadow_tex: u32;
    shadow_fbo: u32;
    hud: int;
    u_hud_screen: int;
    u_hud_offset: int;
    u_hud_color: int;
    hud_buf: u32
}

screen_w: int = 1200;

screen_h: int = 720;

die(msg: str) raises IoError: noreturn {
    eprint(msg);
    exit(1)
}

extern exit(code: int): noreturn;

compile_shader(kind: int, src: []i8) raises IoError: int {
    sh: int = glCreateShader(kind);
    sp: *i8 = src;
    ln: []i32 = new i32[1](len(src) trunc i32);
    glShaderSource(sh, 1, &sp, ln);
    glCompileShader(sh);
    st: []i32 = new i32[1](0i32);
    glGetShaderiv(sh, 35713, st);
    if (st[0] == 0i32) {
        logn: []i32 = new i32[1](0i32);
        glGetShaderiv(sh, 35716, logn);
        n: int = logn[0] as int;
        if (n < 1) n = 1;
        if (n > 4096) n = 4096;
        buf: []i8 = new i8[n](0i8);
        glGetShaderInfoLog(sh, n, null, buf);
        write_bytes_n(2, buf, n);
        write(2, "\n");
        die("shader compile failed")
    }
    sh
}

link_program(vs: []i8, fs: []i8) raises IoError: int {
    prog: int = glCreateProgram();
    glAttachShader(prog, compile_shader(35633, vs));
    glAttachShader(prog, compile_shader(35632, fs));
    glBindAttribLocation(prog, 0, "pos");
    glBindAttribLocation(prog, 1, "nrm");
    glBindAttribLocation(prog, 2, "vcol");
    glLinkProgram(prog);
    st: []i32 = new i32[1](0i32);
    glGetProgramiv(prog, 35714, st);
    if (st[0] == 0i32) die("program link failed");
    prog
}

// The sky's color toward d, without the sun and clouds; fog fades to it.
SKY_GLSL: str = """
vec3 sky_base(vec3 d) {
  float up = clamp(d.y, 0.0, 1.0);
  vec3 zenith = vec3(0.16, 0.36, 0.78);
  vec3 horizon = vec3(0.62, 0.76, 0.92);
  vec3 c = mix(horizon, zenith, pow(up, 0.55));
  // Below the horizon, a hazy ground glow.
  c = mix(c, vec3(0.55, 0.62, 0.62), clamp(-d.y * 3.0, 0.0, 1.0));
  return c;
}
vec3 tone(vec3 c) {
  c *= 0.5;
  c = (c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14);
  return pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2));
}
// Smooth value noise with one lattice cell per unit, from a tiling texture.
uniform sampler2D noise_map;
float vnoise(vec2 p) { return texture2D(noise_map, p * 0.015625).r; }
""";

WORLD_VS: str = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec4 vcol;
uniform mat4 vp;
uniform mat4 model;
uniform mat4 light_vp;
varying vec3 vworld;
varying vec3 vnrm;
varying vec4 vcolor;
varying vec4 vlight;
void main() {
  vec4 w = model * vec4(pos, 1.0);
  vworld = w.xyz;
  vnrm = mat3(model[0].xyz, model[1].xyz, model[2].xyz) * nrm;
  vcolor = vcol;
  vlight = light_vp * w;
  gl_Position = vp * w;
}
""";

WORLD_FS: str = """
uniform sampler2DShadow shadow_map;
uniform vec3 sun_dir;
uniform vec3 cam_pos;
uniform float shadow_texel;
uniform vec3 blob;
uniform float pool_lip;
varying vec3 vworld;
varying vec3 vnrm;
varying vec4 vcolor;
varying vec4 vlight;

float sun_visibility(float ndl) {
  vec3 sc = vlight.xyz / vlight.w * 0.5 + 0.5;
  if (sc.x < 0.002 || sc.x > 0.998 || sc.y < 0.002 || sc.y > 0.998 || sc.z > 1.0) return 1.0;
  float bias = 0.0004 + 0.0012 * (1.0 - clamp(ndl, 0.0, 1.0));
  float t = shadow_texel;
  float v = shadow2D(shadow_map, vec3(sc.xy, sc.z - bias)).r * 0.36;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(t, 0.0), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy - vec2(t, 0.0), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy + vec2(0.0, t), sc.z - bias)).r * 0.16;
  v += shadow2D(shadow_map, vec3(sc.xy - vec2(0.0, t), sc.z - bias)).r * 0.16;
  // Fade out toward the map's edge.
  vec2 e = abs(sc.xy - 0.5) * 2.0;
  return mix(v, 1.0, smoothstep(0.7, 0.95, max(e.x, e.y)));
}

void main() {
  vec3 n = normalize(vnrm);
  float mat = vcolor.a;
  vec3 albedo = pow(vcolor.rgb, vec3(2.2));
  vec3 V = normalize(cam_pos - vworld);
  float spec = 0.0;
  float gloss = 8.0;
  float wrap = 0.0;
  float soft = 0.0;
  float ground = 0.0;
  vec2 xz = vworld.xz;
  if (mat < 0.5) {
    // Concrete: speckled, with faint stains.
    float big = vnoise(xz * 0.35);
    float mid = vnoise(xz * 2.1 + 3.0);
    float speck = vnoise(xz * 31.0 + vworld.y * 7.0);
    float stain = smoothstep(0.55, 0.8, vnoise(xz * 0.6 + 11.0));
    albedo *= (0.92 + 0.08 * big + 0.05 * mid + 0.08 * (speck - 0.5)) * (1.0 - 0.1 * stain);
    spec = 0.05;
    gloss = 12.0;
    ground = 1.0;
  } else if (mat < 1.5) {
    // Grass.
    float big = vnoise(xz * 0.13);
    float mid = vnoise(xz * 0.9 + 7.0);
    float fine = vnoise(xz * 6.0);
    albedo *= 0.78 + 0.3 * big + 0.12 * mid + 0.1 * fine;
    albedo = mix(albedo, albedo * vec3(1.15, 1.05, 0.7), smoothstep(0.55, 0.85, mid) * 0.5);
    ground = 1.0;
  } else if (mat > 2.2 && mat < 2.5) {
    // A pool: painted concrete, darker toward the deep end, with a band of
    // blue tiles under the coping.
    float depth = clamp(pool_lip - vworld.y, 0.0, 1.5);
    albedo *= (0.95 + 0.06 * vnoise(xz * 3.0) + 0.06 * (vnoise(xz * 29.0) - 0.5)) * (1.0 - 0.3 * depth);
    if (vworld.y > pool_lip - 0.22) {
      vec2 tp = vec2(xz.x + xz.y, vworld.y * 1.6) / 0.12;
      vec2 tf = abs(fract(tp) - 0.5);
      float grout = 1.0 - smoothstep(0.38, 0.45, max(tf.x, tf.y));
      float tint = vnoise(floor(tp) * vec2(3.1, 7.7) + 0.5);
      albedo = mix(vec3(0.62, 0.66, 0.66), vec3(0.03, 0.14, 0.38) * (0.8 + 0.4 * tint), grout);
    }
    spec = 0.12;
    gloss = 30.0;
    ground = 1.0;
  } else if (mat < 2.5) {
    // Pavers in staggered rows, each a slightly different shade.
    vec2 p = xz / vec2(0.5, 0.25);
    float row = floor(p.y);
    p.x += 0.5 * mod(row, 2.0);
    vec2 id = floor(p);
    vec2 f = fract(p);
    float tint = vnoise(id * vec2(7.31, 3.17) + 0.5);
    vec2 edge = min(f, 1.0 - f) * vec2(0.5, 0.25);
    float mortar = 1.0 - smoothstep(0.006, 0.02, min(edge.x, edge.y));
    albedo *= (0.86 + 0.24 * tint) * (1.0 - 0.3 * mortar) * (0.95 + 0.1 * vnoise(xz * 9.0));
    spec = 0.04;
    gloss = 10.0;
    ground = 1.0;
  } else if (mat < 3.5) {
    // Plywood: sheets with seams and a little grain.
    float grain = vnoise(vec2(vworld.x * 0.7 + vworld.z * 0.7, vworld.y * 9.0 + vworld.x * 4.0));
    float sz = abs(fract(vworld.z / 1.22) - 0.5) * 1.22;
    float sy = abs(fract((vworld.y + vworld.x * 0.2) / 0.81) - 0.5) * 0.81;
    float line = 1.0 - smoothstep(0.0, 0.012, min(0.61 - sz, 0.405 - sy));
    albedo *= (0.9 + 0.14 * grain) * (1.0 - 0.25 * line);
    spec = 0.07;
    gloss = 18.0;
    ground = 1.0;
  } else if (mat < 4.5) {
    spec = 0.7;
    gloss = 60.0;
  } else if (mat < 5.5) {
    // The guy: soft painted block, light wrapping a little around it.
    wrap = 0.3;
    soft = 1.0;
    spec = 0.22;
    gloss = 28.0;
  } else if (mat < 6.5) {
    // Sandstone slabs, staggered, with a little grain.
    vec2 p = xz / vec2(1.0, 0.5);
    float row = floor(p.y);
    p.x += 0.5 * mod(row, 2.0);
    vec2 id = floor(p);
    vec2 f = fract(p);
    float tint = vnoise(id * vec2(5.13, 9.71) + 0.5);
    vec2 edge = min(f, 1.0 - f) * vec2(1.0, 0.5);
    float joint = 1.0 - smoothstep(0.008, 0.024, min(edge.x, edge.y));
    float grain = vnoise(xz * vec2(4.0, 18.0)) * 0.6 + vnoise(xz * 13.0) * 0.4;
    albedo *= (0.88 + 0.16 * tint) * (1.0 - 0.28 * joint) * (0.92 + 0.14 * grain);
    spec = 0.05;
    gloss = 14.0;
    ground = 1.0;
  } else if (mat < 7.5) {
    spec = 0.1;
    gloss = 24.0;
  } else if (mat < 8.5) {
    // Terracotta tiles in pale grout.
    vec2 p = xz / 0.3333;
    vec2 id = floor(p);
    vec2 f = fract(p);
    float tint = vnoise(id * vec2(3.7, 6.1) + 0.5);
    vec2 edge = min(f, 1.0 - f) * 0.3333;
    float grout = 1.0 - smoothstep(0.008, 0.02, min(edge.x, edge.y));
    albedo *= 0.8 + 0.35 * tint;
    albedo = mix(albedo, vec3(0.62, 0.56, 0.47), grout * 0.8);
    spec = 0.12;
    gloss = 30.0;
    ground = 1.0;
  } else {
    // Leaves: lumpy color, light coming through.
    float k = vnoise(vworld.xz * 2.3 + vworld.y * 3.0);
    albedo *= 0.75 + 0.45 * k;
    wrap = 0.35;
    soft = 0.5;
  }
  float ndl = dot(n, sun_dir);
  float vis = sun_visibility(ndl);
  float diff = max((ndl + wrap) / (1.0 + wrap), 0.0);
  vec3 sun = vec3(1.0, 0.91, 0.76) * 2.6;
  vec3 sky = mix(vec3(0.22, 0.19, 0.14), vec3(0.42, 0.56, 0.80), n.y * 0.5 + 0.5);
  // Contact darkening on the ground under the player.
  if (ground > 0.5) {
    float d = length(vworld.xz - blob.xz);
    float near = (1.0 - smoothstep(0.0, 0.75, d)) * (1.0 - smoothstep(0.0, 1.0, abs(vworld.y - blob.y)));
    sky *= 1.0 - 0.5 * near;
  }
  vec3 col = albedo * (sun * diff * vis + sky);
  if (soft > 0.0) {
    float edge = 1.0 - abs(ndl);
    col += albedo * vec3(1.0, 0.45, 0.3) * sun * 0.06 * edge * edge * soft * (0.4 + 0.6 * vis);
    float rim = pow(1.0 - max(dot(n, V), 0.0), 3.0);
    col += sky * rim * 0.2 * soft;
  }
  vec3 H = normalize(sun_dir + V);
  col += sun * vis * spec * pow(max(dot(n, H), 0.0), gloss) * (gloss + 8.0) / 60.0 * step(0.0, ndl);
  float dist = length(cam_pos - vworld);
  float fog = 1.0 - exp(-dist * 0.0028);
  col = mix(col, sky_base(-V) * 1.2, fog * 0.85);
  gl_FragColor = vec4(tone(col), 1.0);
}
""";

HUD_VS: str = """
#version 120
attribute vec2 pos;
uniform vec2 screen;
uniform vec2 offset;
void main() {
  vec2 p = pos + offset;
  gl_Position = vec4(p.x / screen.x * 2.0 - 1.0, 1.0 - p.y / screen.y * 2.0, 0.0, 1.0);
}
""";

HUD_FS: str = """
#version 120
uniform vec4 color;
void main() {
  gl_FragColor = color;
}
""";

SHADOW_VS: str = """
#version 120
attribute vec3 pos;
uniform mat4 mvp;
void main() {
  gl_Position = mvp * vec4(pos, 1.0);
}
""";

SHADOW_FS: str = """
#version 120
void main() {
  gl_FragColor = vec4(1.0);
}
""";

SKY_VS: str = """
#version 120
attribute vec3 pos;
varying vec2 vscreen;
void main() {
  vscreen = pos.xy;
  gl_Position = vec4(pos.xy, 0.9999, 1.0);
}
""";

SKY_FS: str = """
uniform vec3 cam_f;
uniform vec3 cam_r;
uniform vec3 cam_u;
uniform vec2 tan_half;
uniform float shift;
uniform vec3 sun_dir;
uniform float time;
varying vec2 vscreen;
float clouds(vec2 p) {
  float v = 0.0;
  float a = 0.5;
  for (int i = 0; i < 4; i++) {
    v += a * vnoise(p);
    p = p * 2.03 + vec2(1.7, 9.2);
    a *= 0.5;
  }
  return v;
}
void main() {
  vec3 d = normalize(cam_f + vscreen.x * tan_half.x * cam_r + (vscreen.y - shift) * tan_half.y * cam_u);
  vec3 c = sky_base(d) * 1.25;
  float s = max(dot(d, sun_dir), 0.0);
  c += vec3(1.0, 0.85, 0.6) * (pow(s, 6.0) * 0.25 + pow(s, 60.0) * 0.6);
  c += vec3(1.0, 0.95, 0.85) * smoothstep(0.9993, 0.9996, s) * 12.0;
  if (d.y > 0.0) {
    vec2 p = d.xz / (d.y + 0.08) * 1.1 + vec2(time * 0.012, time * 0.004);
    float k = smoothstep(0.44, 0.66, clouds(p));
    float shade = clouds(p + sun_dir.xz * 0.15);
    vec3 cloud = mix(vec3(1.25, 1.22, 1.18), vec3(0.78, 0.82, 0.9), smoothstep(0.4, 0.68, shade));
    c = mix(c, cloud, k * smoothstep(0.0, 0.18, d.y) * 0.9);
  }
  gl_FragColor = vec4(tone(c), 1.0);
}
""";

// GLSL source with a shared prelude after its version line.
with_prelude(src: str): []i8@new {
    head: str = "#version 120\n";
    out: []i8 = new i8[len(head) + len(SKY_GLSL) + len(src)](0i8);
    n: int = 0;
    for c in head {
        out[n] = c;
        n = n + 1
    }
    for c in SKY_GLSL {
        out[n] = c;
        n = n + 1
    }
    for c in src {
        out[n] = c;
        n = n + 1
    }
    out
}

gen_buffer(): u32 {
    ids: []u32 = new u32[1](0u32);
    glGenBuffers(1, ids);
    ids[0]
}

upload(buf: u32, m: *Mesh) {
    glBindBuffer(34962, buf);
    glBufferData(34962, m.n * VERTEX_FLOATS * 4, m.data, 35044)
}

bind_vertices(buf: u32) {
    glBindBuffer(34962, buf);
    glVertexAttribPointer(0, 3, 5126, 0, VERTEX_FLOATS * 4, 0);
    glVertexAttribPointer(1, 3, 5126, 0, VERTEX_FLOATS * 4, 12);
    glVertexAttribPointer(2, 4, 5126, 0, VERTEX_FLOATS * 4, 24)
}

new_renderer(world_mesh: *Mesh, parts: *Mesh) raises IoError: *Renderer@new {
    world: int = link_program(bytes(WORLD_VS), with_prelude(WORLD_FS));
    shadow: int = link_program(bytes(SHADOW_VS), bytes(SHADOW_FS));
    sky: int = link_program(bytes(SKY_VS), with_prelude(SKY_FS));
    hud: int = link_program(bytes(HUD_VS), bytes(HUD_FS));
    va: []u32 = new u32[1](0u32);
    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    for i in 0..3 glEnableVertexAttribArray(i);
    r: *Renderer = new Renderer {
        world: world,
        shadow: shadow,
        sky: sky,
        u_vp: glGetUniformLocation(world, "vp"),
        u_model: glGetUniformLocation(world, "model"),
        u_light: glGetUniformLocation(world, "light_vp"),
        u_sun: glGetUniformLocation(world, "sun_dir"),
        u_cam: glGetUniformLocation(world, "cam_pos"),
        u_texel: glGetUniformLocation(world, "shadow_texel"),
        u_blob: glGetUniformLocation(world, "blob"),
        u_pool_lip: glGetUniformLocation(world, "pool_lip"),
        u_shadow_map: glGetUniformLocation(world, "shadow_map"),
        u_smvp: glGetUniformLocation(shadow, "mvp"),
        u_cam_f: glGetUniformLocation(sky, "cam_f"),
        u_cam_r: glGetUniformLocation(sky, "cam_r"),
        u_cam_u: glGetUniformLocation(sky, "cam_u"),
        u_tan: glGetUniformLocation(sky, "tan_half"),
        u_shift: glGetUniformLocation(sky, "shift"),
        u_sky_sun: glGetUniformLocation(sky, "sun_dir"),
        u_time: glGetUniformLocation(sky, "time"),
        u_world_noise: glGetUniformLocation(world, "noise_map"),
        u_sky_noise: glGetUniformLocation(sky, "noise_map"),
        noise_tex: make_noise_texture(),
        world_buf: gen_buffer(),
        world_n: world_mesh.n,
        course_buf: gen_buffer(),
        course_n: 0,
        part_buf: gen_buffer(),
        sky_buf: gen_buffer(),
        shadow_tex: 0u32,
        shadow_fbo: 0u32,
        hud: hud,
        u_hud_screen: glGetUniformLocation(hud, "screen"),
        u_hud_offset: glGetUniformLocation(hud, "offset"),
        u_hud_color: glGetUniformLocation(hud, "color"),
        hud_buf: gen_buffer()
    };
    upload(r.world_buf, world_mesh);
    upload(r.part_buf, parts);
    // One triangle over the whole screen.
    tri: []f32 = new f32[30](0.0);
    tri[0] = -1.0;
    tri[1] = -1.0;
    tri[10] = 3.0;
    tri[11] = -1.0;
    tri[20] = -1.0;
    tri[21] = 3.0;
    glBindBuffer(34962, r.sky_buf);
    glBufferData(34962, 120, tri, 35044);
    stex: []u32 = new u32[1](0u32);
    glGenTextures(1, stex);
    glBindTexture(3553, stex[0]);
    // Hardware bilinear PCF: filter depth comparisons, not depth values.
    glTexParameteri(3553, 10241, 9729);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 34892, 34894);
    glTexParameteri(3553, 34893, 515);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 33190, SHADOW_SIZE, SHADOW_SIZE, 0, 6402, 5125, null);
    fbo: []u32 = new u32[1](0u32);
    glGenFramebuffers(1, fbo);
    glBindFramebuffer(36160, fbo[0]);
    glFramebufferTexture2D(36160, 36096, 3553, stex[0], 0);
    glDrawBuffer(0);
    glReadBuffer(0);
    if (glCheckFramebufferStatus(36160) != 36053) die("shadow framebuffer incomplete");
    glBindFramebuffer(36160, 0u32);
    r.shadow_tex = stex[0];
    r.shadow_fbo = fbo[0];
    glEnable(2929);
    r
}

// The course's ground and things, drawn instead of the park's while he is
// on it.
show_course: bool = false;

set_course_mesh(r: *Renderer, m: *Mesh) {
    upload(r.course_buf, m);
    r.course_n = m.n
}

// On the course, only the part from d0 to d1 down it.
draw_world(r: *Renderer, d0: f32, d1: f32) {
    if (show_course) {
        first: int = 0;
        count: int = 0;
        course_span(d0, d1, &first, &count);
        bind_vertices(r.course_buf);
        glDrawArrays(4, first, count)
    } else {
        bind_vertices(r.world_buf);
        glDrawArrays(4, 0, r.world_n)
    }
}

// Value noise for the shaders: a 64-cell lattice of random values over 256
// texels, smoothly interpolated, wrapping, with its mipmaps so distant
// detail does not shimmer.
const NOISE_SIZE: int = 256;

const NOISE_CELLS: int = 64;

make_noise_texture(): u32 {
    lattice: []f32 = new f32[NOISE_CELLS * NOISE_CELLS](0.0);
    rng: int = 99991;
    for i in 0..NOISE_CELLS * NOISE_CELLS {
        rng = (rng * 1103515245 + 12345) % 2147483648;
        if (rng < 0) rng = -rng;
        lattice[i] = (rng / 65536 % 32768) as f32 / 32767.0
    }
    level: []i8 = new i8[NOISE_SIZE * NOISE_SIZE](0i8);
    k: int = NOISE_SIZE / NOISE_CELLS;
    for y in 0..NOISE_SIZE {
        for x in 0..NOISE_SIZE {
            cx: int = x / k;
            cy: int = y / k;
            fx: f32 = (x % k) as f32 / k as f32;
            fy: f32 = (y % k) as f32 / k as f32;
            fx = fx * fx * (3.0 - 2.0 * fx);
            fy = fy * fy * (3.0 - 2.0 * fy);
            x1: int = (cx + 1) % NOISE_CELLS;
            y1: int = (cy + 1) % NOISE_CELLS;
            a: f32 = lerpf(lattice[cy * NOISE_CELLS + cx], lattice[cy * NOISE_CELLS + x1],
                fx);
            b: f32 = lerpf(lattice[y1 * NOISE_CELLS + cx], lattice[y1 * NOISE_CELLS + x1],
                fx);
            level[y * NOISE_SIZE + x] = (lerpf(a, b, fy) * 255.0) as int trunc i8
        }
    }
    tex: []u32 = new u32[1](0u32);
    glGenTextures(1, tex);
    glBindTexture(3553, tex[0]);
    glPixelStorei(3317, 1);
    glTexParameteri(3553, 10241, 9987);
    glTexParameteri(3553, 10240, 9729);
    glTexParameteri(3553, 10242, 10497);
    glTexParameteri(3553, 10243, 10497);
    size: int = NOISE_SIZE;
    lod: int = 0;
    next: []i8 = new i8[NOISE_SIZE * NOISE_SIZE / 4](0i8);
    while (size >= 1) {
        glTexImage2D(3553, lod, 6409, size, size, 0, 6409, 5121, level);
        if (size > 1) {
            half: int = size / 2;
            for y in 0..half {
                for x in 0..half {
                    sum: int = byte_value(level[2 * y * size + 2 * x]) + byte_value(level[2 * y * size + 2 * x + 1]) + byte_value(level[(2 * y + 1) * size + 2 * x]) + byte_value(level[(2 * y + 1) * size + 2 * x + 1]);
                    next[y * half + x] = (sum / 4) trunc i8
                }
            }
            for i in 0..half * half level[i] = next[i]
        }
        size = size / 2;
        lod = lod + 1
    }
    tex[0]
}

byte_value(b: i8): int {
    v: int = b as int;
    if (v < 0) v = v + 256;
    v
}

// What a frame needs from the game.
type View = {
    eye: V3;
    at: V3;
    fovy: f32;
    focus: V3;
    time: f32;
    // How far up the picture moves, in screen heights times two (so that
    // what the camera looks at sits above the middle).
    shift: f32
}

SUN: V3 = V3 { x: -0.55, y: 0.72, z: 0.42 };

view_m: []f32 = new f32[16](0.0);

proj_m: []f32 = new f32[16](0.0);

vp_m: []f32 = new f32[16](0.0);

light_view: []f32 = new f32[16](0.0);

light_proj: []f32 = new f32[16](0.0);

light_vp: []f32 = new f32[16](0.0);

mvp_m: []f32 = new f32[16](0.0);

ident_m: []f32 = new f32[16](0.0);

part_tmp: []f32 = new f32[16](0.0);

// The sun's view: an orthographic box around the focus, moved in whole
// shadow texels so shadows do not crawl as it follows.
fit_shadow(focus: V3) {
    sun: V3 = v_norm(SUN);
    mat_look(light_view, v_scale(sun, 200.0), v3(0.0, 0.0, 0.0), v3(0.0, 1.0, 0.0));
    c: V3 = mat_point(light_view, focus);
    texel: f32 = 2.0 * SHADOW_HALF / SHADOW_SIZE as f32;
    cx: f32 = floorf(c.x / texel) * texel;
    cy: f32 = floorf(c.y / texel) * texel;
    mat_ortho(light_proj, cx - SHADOW_HALF, cx + SHADOW_HALF, cy - SHADOW_HALF, cy + SHADOW_HALF,
        -c.z - 90.0, -c.z + 90.0);
    mat_mul(light_vp, light_proj, light_view)
}

draw_shadow_mesh(r: *Renderer, model: []f32) {
    mat_mul(mvp_m, light_vp, model);
    glUniformMatrix4fv(r.u_smvp, 1, 0, mvp_m)
}

draw_scene(r: *Renderer, view: View, shadows: bool) {
    mat_identity(ident_m);
    fit_shadow(view.focus);
    // Shadow pass.
    glBindFramebuffer(36160, r.shadow_fbo);
    glViewport(0, 0, SHADOW_SIZE, SHADOW_SIZE);
    glClear(256);
    if (shadows) {
        glUseProgram(r.shadow);
        glEnable(32823);
        glPolygonOffset(1.5, 2.0);
        draw_shadow_mesh(r, ident_m);
        // Only what is near enough to cast a shadow he could see.
        draw_world(r, -view.focus.z - 40.0, -view.focus.z + 40.0);
        bind_vertices(r.part_buf);
        for i in 0..ndraw {
            for k in 0..16 part_tmp[k] = draw_m[i * 16 + k];
            mat_mul(mvp_m, light_vp, part_tmp);
            glUniformMatrix4fv(r.u_smvp, 1, 0, mvp_m);
            glDrawArrays(4, part_first[draw_part[i]], part_count[draw_part[i]])
        }
        glDisable(32823)
    }
    glBindFramebuffer(36160, 0u32);
    glViewport(0, 0, screen_w, screen_h);
    glClear(16640);
    // Camera.
    aspect: f32 = screen_w as f32 / screen_h as f32;
    mat_persp(proj_m, view.fovy, aspect, 0.1, 600.0);
    proj_m[9] = -view.shift;
    mat_look(view_m, view.eye, view.at, v3(0.0, 1.0, 0.0));
    mat_mul(vp_m, proj_m, view_m);
    sun: V3 = v_norm(SUN);
    // Sky.
    glDepthMask(0);
    glDisable(2929);
    glUseProgram(r.sky);
    f: V3 = v_norm(v_sub(view.at, view.eye));
    rt: V3 = v_norm(v_cross(f, v3(0.0, 1.0, 0.0)));
    up: V3 = v_cross(rt, f);
    glUniform3f(r.u_cam_f, f.x, f.y, f.z);
    glUniform3f(r.u_cam_r, rt.x, rt.y, rt.z);
    glUniform3f(r.u_cam_u, up.x, up.y, up.z);
    th: f32 = sinf(view.fovy * 0.5) / cosf(view.fovy * 0.5);
    glUniform2f(r.u_tan, th * aspect, th);
    glUniform1f(r.u_shift, view.shift);
    glUniform3f(r.u_sky_sun, sun.x, sun.y, sun.z);
    glUniform1f(r.u_time, view.time);
    glActiveTexture(33985);
    glBindTexture(3553, r.noise_tex);
    glUniform1i(r.u_sky_noise, 1);
    bind_vertices(r.sky_buf);
    glDrawArrays(4, 0, 3);
    glDepthMask(1);
    glEnable(2929);
    // World.
    glUseProgram(r.world);
    glUniformMatrix4fv(r.u_vp, 1, 0, vp_m);
    glUniformMatrix4fv(r.u_light, 1, 0, light_vp);
    glUniform3f(r.u_sun, sun.x, sun.y, sun.z);
    glUniform3f(r.u_cam, view.eye.x, view.eye.y, view.eye.z);
    glUniform1f(r.u_texel, 1.0 / SHADOW_SIZE as f32);
    glUniform3f(r.u_blob, view.focus.x, view.focus.y, view.focus.z);
    // The bowl's lip, where its tiles end.
    bowl: Pool = pools[0];
    glUniform1f(r.u_pool_lip, (bowl.level as f32 + bowl.n) * LEVEL);
    glActiveTexture(33984);
    glBindTexture(3553, r.shadow_tex);
    glUniform1i(r.u_shadow_map, 0);
    glUniform1i(r.u_world_noise, 1);
    glUniformMatrix4fv(r.u_model, 1, 0, ident_m);
    draw_world(r, -view.focus.z - 40.0, -view.focus.z + 600.0);
    bind_vertices(r.part_buf);
    for i in 0..ndraw {
        glUniformMatrix4fv(r.u_model, 1, 0, &draw_m[i * 16]);
        glDrawArrays(4, part_first[draw_part[i]], part_count[draw_part[i]])
    }
}

// The trick feed over the scene: each run of text with a soft shadow.
draw_hud(r: *Renderer) {
    build_hud(screen_w);
    if (hud_n == 0) return;
    glDisable(2929);
    glEnable(3042);
    glBlendFunc(770, 771);
    glUseProgram(r.hud);
    glUniform2f(r.u_hud_screen, screen_w as f32, screen_h as f32);
    glBindBuffer(34962, r.hud_buf);
    glBufferData(34962, hud_n * 4, hud_verts, 35048);
    glDisableVertexAttribArray(1);
    glDisableVertexAttribArray(2);
    glVertexAttribPointer(0, 2, 5126, 0, 8, 0);
    for i in 0..nruns {
        a: f32 = run_rgba[i * 4 + 3];
        glUniform2f(r.u_hud_offset, hud_px * 0.6, hud_px * 0.6);
        glUniform4f(r.u_hud_color, 0.1, 0.06, 0.04, 0.45 * a);
        glDrawArrays(4, run_first[i], run_count[i]);
        glUniform2f(r.u_hud_offset, 0.0, 0.0);
        glUniform4f(r.u_hud_color, run_rgba[i * 4], run_rgba[i * 4 + 1], run_rgba[i * 4 + 2],
            a);
        glDrawArrays(4, run_first[i], run_count[i])
    }
    glEnableVertexAttribArray(1);
    glEnableVertexAttribArray(2);
    glDisable(3042);
    glEnable(2929)
}
