tag skate;

// Vectors, 4x4 column-major matrices, and the C math library. y is up; a yaw
// of 0 faces +z and positive yaw turns toward +x, which is the camera's left.
need "libm.so.6";

extern sinf(x: f32): f32;

extern cosf(x: f32): f32;

extern sqrtf(x: f32): f32;

extern atan2f(y: f32, x: f32): f32;

extern expf(x: f32): f32;

extern powf(x: f32, y: f32): f32;

extern floorf(x: f32): f32;

const PI: f32 = 3.1415927;

const TAU: f32 = 6.2831855;

type V3 = {
    x: f32;
    y: f32;
    z: f32
}

v3(x: f32, y: f32, z: f32): V3 {
    V3 { x: x, y: y, z: z }
}

v_add(a: V3, b: V3): V3 {
    V3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

v_sub(a: V3, b: V3): V3 {
    V3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
}

v_scale(a: V3, k: f32): V3 {
    V3 { x: a.x * k, y: a.y * k, z: a.z * k }
}

// a + b * k
v_madd(a: V3, b: V3, k: f32): V3 {
    V3 { x: a.x + b.x * k, y: a.y + b.y * k, z: a.z + b.z * k }
}

v_dot(a: V3, b: V3): f32 {
    a.x * b.x + a.y * b.y + a.z * b.z
}

v_cross(a: V3, b: V3): V3 {
    V3 { x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x }
}

v_len(a: V3): f32 {
    sqrtf(v_dot(a, a))
}

v_norm(a: V3): V3 {
    l: f32 = v_len(a);
    if (l < 0.000001) return v3(0.0, 1.0, 0.0);
    v_scale(a, 1.0 / l)
}

v_lerp(a: V3, b: V3, t: f32): V3 {
    v_madd(a, v_sub(b, a), t)
}

// The part of a that is perpendicular to the unit vector n.
v_reject(a: V3, n: V3): V3 {
    v_madd(a, n, -v_dot(a, n))
}

// Rotate a about the unit axis n by angle (Rodrigues).
v_rotate(a: V3, n: V3, angle: f32): V3 {
    c: f32 = cosf(angle);
    s: f32 = sinf(angle);
    r: V3 = v_add(v_scale(a, c), v_scale(v_cross(n, a), s));
    v_madd(r, n, v_dot(n, a) * (1.0 - c))
}

yaw_dir(yaw: f32): V3 {
    v3(sinf(yaw), 0.0, cosf(yaw))
}

dir_yaw(d: V3): f32 {
    atan2f(d.x, d.z)
}

clampf(x: f32, lo: f32, hi: f32): f32 {
    if (x < lo) return lo;
    if (x > hi) return hi;
    x
}

absf(x: f32): f32 {
    if (x < 0.0) return -x;
    x
}

minf(a: f32, b: f32): f32 {
    if (a < b) return a;
    b
}

maxf(a: f32, b: f32): f32 {
    if (a > b) return a;
    b
}

signf(x: f32): f32 {
    if (x < 0.0) return -1.0;
    1.0
}

lerpf(a: f32, b: f32, t: f32): f32 {
    a + (b - a) * t
}

smoothstepf(a: f32, b: f32, x: f32): f32 {
    t: f32 = clampf((x - a) / (b - a), 0.0, 1.0);
    t * t * (3.0 - 2.0 * t)
}

// An angle in (-PI, PI].
wrap_angle(a: f32): f32 {
    while (a > PI) a = a - TAU;
    while (a <= -PI) a = a + TAU;
    a
}

// Move angle a toward b by the share k of their difference, the short way.
approach_angle(a: f32, b: f32, k: f32): f32 {
    wrap_angle(a + wrap_angle(b - a) * k)
}

// The share of a gap that exponential easing at rate closes in dt.
ease(rate: f32, dt: f32): f32 {
    1.0 - expf(-rate * dt)
}

// ---- matrices (column-major, as GL takes them) ----
mat_identity(m: []f32) {
    for i in 0..16 m[i] = 0.0;
    m[0] = 1.0;
    m[5] = 1.0;
    m[10] = 1.0;
    m[15] = 1.0
}

mat_copy(dst: []f32, src: []f32) {
    for i in 0..16 dst[i] = src[i]
}

mat_tmp: []f32 = new f32[16](0.0);

// out = a * b; out may be a or b.
mat_mul(out: []f32, a: []f32, b: []f32) {
    for c in 0..4 {
        for r in 0..4 {
            s: f32 = 0.0;
            for k in 0..4 s = s + a[k * 4 + r] * b[c * 4 + k];
            mat_tmp[c * 4 + r] = s
        }
    }
    for i in 0..16 out[i] = mat_tmp[i]
}

mat_persp(
    m: []f32,
    fovy: f32,
    aspect: f32,
    near: f32,
    far: f32
) {
    for i in 0..16 m[i] = 0.0;
    f: f32 = 1.0 / (sinf(fovy * 0.5) / cosf(fovy * 0.5));
    m[0] = f / aspect;
    m[5] = f;
    m[10] = (far + near) / (near - far);
    m[11] = -1.0;
    m[14] = 2.0 * far * near / (near - far)
}

mat_ortho(
    m: []f32,
    l: f32,
    r: f32,
    b: f32,
    t: f32,
    n: f32,
    f: f32
) {
    for i in 0..16 m[i] = 0.0;
    m[0] = 2.0 / (r - l);
    m[5] = 2.0 / (t - b);
    m[10] = -2.0 / (f - n);
    m[12] = -(r + l) / (r - l);
    m[13] = -(t + b) / (t - b);
    m[14] = -(f + n) / (f - n);
    m[15] = 1.0
}

mat_look(
    m: []f32,
    eye: V3,
    at: V3,
    up: V3
) {
    f: V3 = v_norm(v_sub(at, eye));
    s: V3 = v_norm(v_cross(f, up));
    u: V3 = v_cross(s, f);
    mat_identity(m);
    m[0] = s.x;
    m[4] = s.y;
    m[8] = s.z;
    m[1] = u.x;
    m[5] = u.y;
    m[9] = u.z;
    m[2] = -f.x;
    m[6] = -f.y;
    m[10] = -f.z;
    m[12] = -v_dot(s, eye);
    m[13] = -v_dot(u, eye);
    m[14] = v_dot(f, eye)
}

// A frame from its axes (columns) and origin.
mat_frame(
    m: []f32,
    x: V3,
    y: V3,
    z: V3,
    o: V3
) {
    m[0] = x.x;
    m[1] = x.y;
    m[2] = x.z;
    m[3] = 0.0;
    m[4] = y.x;
    m[5] = y.y;
    m[6] = y.z;
    m[7] = 0.0;
    m[8] = z.x;
    m[9] = z.y;
    m[10] = z.z;
    m[11] = 0.0;
    m[12] = o.x;
    m[13] = o.y;
    m[14] = o.z;
    m[15] = 1.0
}

mat_point(m: []f32, p: V3): V3 {
    v3(m[0] * p.x + m[4] * p.y + m[8] * p.z + m[12], m[1] * p.x + m[5] * p.y + m[9] * p.z + m[13],
        m[2] * p.x + m[6] * p.y + m[10] * p.z + m[14])
}

mat_vector(m: []f32, p: V3): V3 {
    v3(m[0] * p.x + m[4] * p.y + m[8] * p.z, m[1] * p.x + m[5] * p.y + m[9] * p.z,
        m[2] * p.x + m[6] * p.y + m[10] * p.z)
}

mat_scratch: []f32 = new f32[16](0.0);

// m = m * translate(t)
mat_translate(m: []f32, t: V3) {
    m[12] = m[0] * t.x + m[4] * t.y + m[8] * t.z + m[12];
    m[13] = m[1] * t.x + m[5] * t.y + m[9] * t.z + m[13];
    m[14] = m[2] * t.x + m[6] * t.y + m[10] * t.z + m[14]
}

// m = m * rotate(axis, angle)
mat_rotate(m: []f32, axis: V3, angle: f32) {
    x: V3 = v_rotate(v3(1.0, 0.0, 0.0), axis, angle);
    y: V3 = v_rotate(v3(0.0, 1.0, 0.0), axis, angle);
    z: V3 = v_rotate(v3(0.0, 0.0, 1.0), axis, angle);
    mat_frame(mat_scratch, x, y, z, v3(0.0, 0.0, 0.0));
    mat_mul(m, m, mat_scratch)
}

// m = m * scale(s)
mat_scale(m: []f32, s: V3) {
    for i in 0..3 {
        m[i] = m[i] * s.x;
        m[4 + i] = m[4 + i] * s.y;
        m[8 + i] = m[8 + i] * s.z
    }
}
