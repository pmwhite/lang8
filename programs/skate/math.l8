tag skate_math_internal;

use_tag skate_math;

// Vectors, 4x4 column-major matrices, and the math functions. y is up; a
// yaw of 0 faces +z and positive yaw turns toward +x, which is the camera's
// left.
//
// sin, cos, atan2, exp, and pow are worked out here, in double precision,
// rather than taken from the C library (or, in a browser, from its own):
// those differ in their last digit from one to the next, and a replay (see
// replay.l8) is only the same run if every device computes the same. Square
// roots and floors are exact everywhere, and are the library's.
need "libm.so.6";

tag skate_math, skate
extern sqrtf(x: f32): f32;

tag skate_math, skate
extern floorf(x: f32): f32;

const PI_2: f64 = 1.5707963267948966f64;

const LN_2: f64 = 0.6931471805599453f64;

// The nearest whole number to x (halves away from zero).
round64(x: f64): int {
    if (x < 0.0f64) return (x - 0.5f64) as int;
    (x + 0.5f64) as int
}

// sin and cos of r, within a quarter turn of 0 (|r| <= pi / 4): their
// series, as fdlibm's.
sin_near(r: f64): f64 {
    z: f64 = r * r;
    r + r * z * (-0.16666666666666632f64 + z * (0.008333333333322490f64 + z * (-0.00019841269829857949f64 + z * (0.0000027557313707070068f64 + z * (-0.000000025050760253406863f64 + z * 0.00000000015896909952115501f64)))))
}

cos_near(r: f64): f64 {
    z: f64 = r * r;
    1.0f64 - 0.5f64 * z + z * z * (0.041666666666666602f64 + z * (-0.0013888888888874110f64 + z * (0.000024801587289476729f64 + z * (-0.00000027557314351390663f64 + z * (0.0000000020875723212981748f64 + z * -0.000000000011359647557788195f64)))))
}

// sin of x + q quarter turns: x brought within a quarter turn of 0 by
// whole quarter turns, and the series for where that leaves it.
sin_quarters(x: f64, q: int): f64 {
    if (x > 1000000000.0f64 || x < -1000000000.0f64) return 0.0f64;
    k: int = round64(x * 0.6366197723675814f64);
    // (pi / 2 in two parts, so that taking k of them away loses nothing.)
    kf: f64 = k as f64;
    r: f64 = x - kf * 1.5707963267341256f64 - kf * 0.00000000006077100506506192f64;
    n: int = k + q & 3;
    if (n == 0) return sin_near(r);
    if (n == 1) return cos_near(r);
    if (n == 2) return 0.0f64 - sin_near(r);
    0.0f64 - cos_near(r)
}

tag skate_math, skate
sinf(x: f32): f32 {
    sin_quarters(x as f64, 0) as f32
}

tag skate_math, skate
cosf(x: f32): f32 {
    sin_quarters(x as f64, 1) as f32
}

// The angle whose tangent is t, for |t| <= 1: nearer 1, by the angle whose
// tangent is (t - 1) / (t + 1), an eighth of a turn on; and the series.
atan_unit(t: f64): f64 {
    a: f64 = t;
    add: f64 = 0.0f64;
    if (a > 0.41421356237309503f64) {
        a = (a - 1.0f64) / (a + 1.0f64);
        add = 0.7853981633974483f64
    }
    z: f64 = a * a;
    // (1 - z / 3 + z z / 5 - ..., its fractions written out.)
    sum: f64 = 1.00000000000000000000f64 + z * (-0.33333333333333333333f64 + z * (0.20000000000000000000f64 + z * (-0.14285714285714285714f64 + z * (0.11111111111111111111f64 + z * (-0.09090909090909090909f64 + z * (0.07692307692307692308f64 + z * (-0.06666666666666666667f64 + z * (0.05882352941176470588f64 + z * (-0.05263157894736842105f64 + z * (0.04761904761904761905f64 + z * (-0.04347826086956521739f64 + z * (0.04000000000000000000f64 + z * (-0.03703703703703703704f64 + z * 0.03448275862068965517f64)))))))))))));
    add + a * sum
}

tag skate_math, skate
atan2f(y: f32, x: f32): f32 {
    ay: f64 = y as f64;
    ax: f64 = x as f64;
    if (ay < 0.0f64) ay = 0.0f64 - ay;
    if (ax < 0.0f64) ax = 0.0f64 - ax;
    if (ax == 0.0f64 && ay == 0.0f64) return 0.0;
    r: f64 = 0.0f64;
    if (ay > ax) r = PI_2 - atan_unit(ax / ay) else r = atan_unit(ay / ax);
    if (x < 0.0) r = 2.0f64 * PI_2 - r;
    if (y < 0.0) r = 0.0f64 - r;
    r as f32
}

// 2 to the k, exactly.
pow2(k: int): f64 {
    p: f64 = 1.0f64;
    n: int = k;
    while (n > 0) {
        p = p * 2.0f64;
        n = n - 1
    }
    while (n < 0) {
        p = p * 0.5f64;
        n = n + 1
    }
    p
}

// e to the x: by how many times ln 2 goes into x, and the series for the
// rest.
exp64(x: f64): f64 {
    if (x > 700.0f64) return 1.0e300f64 * 1.0e300f64;
    if (x < -700.0f64) return 0.0f64;
    k: int = round64(x * 1.4426950408889634f64);
    kf: f64 = k as f64;
    r: f64 = x - kf * 0.6931471803691238f64 - kf * 0.00000000019082149292705877f64;
    // (1 + r (1 + r / 2 (1 + r / 3 (...))), its fractions written out.)
    sum: f64 = 1.0f64 + r * 1.00000000000000000000f64 * (1.0f64 + r * 0.50000000000000000000f64 * (1.0f64 + r * 0.33333333333333333333f64 * (1.0f64 + r * 0.25000000000000000000f64 * (1.0f64 + r * 0.20000000000000000000f64 * (1.0f64 + r * 0.16666666666666666667f64 * (1.0f64 + r * 0.14285714285714285714f64 * (1.0f64 + r * 0.12500000000000000000f64 * (1.0f64 + r * 0.11111111111111111111f64 * (1.0f64 + r * 0.10000000000000000000f64 * (1.0f64 + r * 0.09090909090909090909f64 * (1.0f64 + r * 0.08333333333333333333f64 * (1.0f64 + r * 0.07692307692307692308f64 * (1.0f64 + r * 0.07142857142857142857f64 * 1.0f64)))))))))))));
    sum * pow2(k)
}

tag skate_math, skate
expf(x: f32): f32 {
    exp64(x as f64) as f32
}

// The natural logarithm of x (more than 0): x as m times 2 to the k, m near
// 1, and the series for m's.
tag skate_math, skate
log64(x: f64): f64 {
    m: f64 = x;
    k: int = 0;
    while (m > 1.4142135623730951f64) {
        m = m * 0.5f64;
        k = k + 1
    }
    while (m < 0.7071067811865476f64) {
        m = m * 2.0f64;
        k = k - 1
    }
    s: f64 = (m - 1.0f64) / (m + 1.0f64);
    z: f64 = s * s;
    sum: f64 = 0.0f64;
    n: int = 10;
    while (n >= 0) {
        sum = 1.0f64 / (2 * n + 1) as f64 + z * sum;
        n = n - 1
    }
    k as f64 * LN_2 + 2.0f64 * s * sum
}

// x to the y: a whole power by multiplying, exactly; any other, of an x
// more than 0, by its logarithm.
tag skate_math, skate
powf(x: f32, y: f32): f32 {
    whole: f32 = floorf(y);
    if (whole == y && y >= 0.0 && y <= 64.0) {
        p: f64 = 1.0f64;
        for _i in 0..whole as int p = p * x as f64;
        return p as f32
    }
    if (x <= 0.0) return 0.0;
    exp64(y as f64 * log64(x as f64)) as f32
}

tag skate_math, skate
const PI: f32 = 3.1415927;

tag skate_math, skate
const TAU: f32 = 6.2831855;

tag skate_math, skate
type V3 = {
    x: f32;
    y: f32;
    z: f32
}

tag skate_math, skate
v3(x: f32, y: f32, z: f32): V3 {
    V3 { x: x, y: y, z: z }
}

tag skate_math, skate
v_add(a: V3, b: V3): V3 {
    V3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

tag skate_math, skate
v_sub(a: V3, b: V3): V3 {
    V3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
}

tag skate_math, skate
v_scale(a: V3, k: f32): V3 {
    V3 { x: a.x * k, y: a.y * k, z: a.z * k }
}

// a + b * k
tag skate_math, skate
v_madd(a: V3, b: V3, k: f32): V3 {
    V3 { x: a.x + b.x * k, y: a.y + b.y * k, z: a.z + b.z * k }
}

tag skate_math, skate
v_dot(a: V3, b: V3): f32 {
    a.x * b.x + a.y * b.y + a.z * b.z
}

tag skate_math, skate
v_cross(a: V3, b: V3): V3 {
    V3 { x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x }
}

tag skate_math, skate
v_len(a: V3): f32 {
    sqrtf(v_dot(a, a))
}

tag skate_math, skate
v_norm(a: V3): V3 {
    l: f32 = v_len(a);
    if (l < 0.000001) return v3(0.0, 1.0, 0.0);
    v_scale(a, 1.0 / l)
}

tag skate_math, skate
v_lerp(a: V3, b: V3, t: f32): V3 {
    v_madd(a, v_sub(b, a), t)
}

// The part of a that is perpendicular to the unit vector n.
tag skate_math, skate
v_reject(a: V3, n: V3): V3 {
    v_madd(a, n, -v_dot(a, n))
}

// Rotate a about the unit axis n by angle (Rodrigues).
tag skate_math, skate
v_rotate(a: V3, n: V3, angle: f32): V3 {
    c: f32 = cosf(angle);
    s: f32 = sinf(angle);
    r: V3 = v_add(v_scale(a, c), v_scale(v_cross(n, a), s));
    v_madd(r, n, v_dot(n, a) * (1.0 - c))
}

tag skate_math, skate
yaw_dir(yaw: f32): V3 {
    v3(sinf(yaw), 0.0, cosf(yaw))
}

tag skate_math, skate
dir_yaw(d: V3): f32 {
    atan2f(d.x, d.z)
}

tag skate_math, skate
clampf(x: f32, lo: f32, hi: f32): f32 {
    if (x < lo) return lo;
    if (x > hi) return hi;
    x
}

tag skate_math, skate
absf(x: f32): f32 {
    if (x < 0.0) return -x;
    x
}

tag skate_math, skate
minf(a: f32, b: f32): f32 {
    if (a < b) return a;
    b
}

tag skate_math, skate
maxf(a: f32, b: f32): f32 {
    if (a > b) return a;
    b
}

tag skate_math, skate
signf(x: f32): f32 {
    if (x < 0.0) return -1.0;
    1.0
}

tag skate_math, skate
lerpf(a: f32, b: f32, t: f32): f32 {
    a + (b - a) * t
}

tag skate_math, skate
smoothstepf(a: f32, b: f32, x: f32): f32 {
    t: f32 = clampf((x - a) / (b - a), 0.0, 1.0);
    t * t * (3.0 - 2.0 * t)
}

// An angle in (-PI, PI].
tag skate_math, skate
wrap_angle(a: f32): f32 {
    while (a > PI) a = a - TAU;
    while (a <= -PI) a = a + TAU;
    a
}

// Move angle a toward b by the share k of their difference, the short way.
tag skate_math, skate
approach_angle(a: f32, b: f32, k: f32): f32 {
    wrap_angle(a + wrap_angle(b - a) * k)
}

// The share of a gap that exponential easing at rate closes in dt.
tag skate_math, skate
ease(rate: f32, dt: f32): f32 {
    1.0 - expf(-rate * dt)
}

// ---- matrices (column-major, as GL takes them) ----
tag skate_math, skate
mat_identity(m: []f32) {
    for i in 0..16 m[i] = 0.0;
    m[0] = 1.0;
    m[5] = 1.0;
    m[10] = 1.0;
    m[15] = 1.0
}

tag skate_math, skate
mat_copy(dst: []f32, src: []f32) {
    for i in 0..16 dst[i] = src[i]
}

mat_tmp: []f32 = new f32[16](0.0);

// out = a * b; out may be a or b.
tag skate_math, skate
mat_mul(out: []f32, a: []f32, b: []f32) {
    for c in 0..4 {
        for r in 0..4 {
            s: f32 = 0.0;
            for k in 0..4 s = s + a[k * 4 + r] * b[c * 4 + k];
            mat_tmp[c * 4 + r] = s
        }
    }
    for i in 0..16 out[i] = mat_tmp[i]
}

tag skate_math, skate
mat_persp(
    m: []f32,
    fovy: f32,
    aspect: f32,
    near: f32,
    far: f32
) {
    for i in 0..16 m[i] = 0.0;
    f: f32 = 1.0 / (sinf(fovy * 0.5) / cosf(fovy * 0.5));
    m[0] = f / aspect;
    m[5] = f;
    m[10] = (far + near) / (near - far);
    m[11] = -1.0;
    m[14] = 2.0 * far * near / (near - far)
}

tag skate_math, skate
mat_ortho(
    m: []f32,
    l: f32,
    r: f32,
    b: f32,
    t: f32,
    n: f32,
    f: f32
) {
    for i in 0..16 m[i] = 0.0;
    m[0] = 2.0 / (r - l);
    m[5] = 2.0 / (t - b);
    m[10] = -2.0 / (f - n);
    m[12] = -(r + l) / (r - l);
    m[13] = -(t + b) / (t - b);
    m[14] = -(f + n) / (f - n);
    m[15] = 1.0
}

tag skate_math, skate
mat_look(
    m: []f32,
    eye: V3,
    at: V3,
    up: V3
) {
    f: V3 = v_norm(v_sub(at, eye));
    s: V3 = v_norm(v_cross(f, up));
    u: V3 = v_cross(s, f);
    mat_identity(m);
    m[0] = s.x;
    m[4] = s.y;
    m[8] = s.z;
    m[1] = u.x;
    m[5] = u.y;
    m[9] = u.z;
    m[2] = -f.x;
    m[6] = -f.y;
    m[10] = -f.z;
    m[12] = -v_dot(s, eye);
    m[13] = -v_dot(u, eye);
    m[14] = v_dot(f, eye)
}

// A frame from its axes (columns) and origin.
tag skate_math, skate
mat_frame(
    m: []f32,
    x: V3,
    y: V3,
    z: V3,
    o: V3
) {
    m[0] = x.x;
    m[1] = x.y;
    m[2] = x.z;
    m[3] = 0.0;
    m[4] = y.x;
    m[5] = y.y;
    m[6] = y.z;
    m[7] = 0.0;
    m[8] = z.x;
    m[9] = z.y;
    m[10] = z.z;
    m[11] = 0.0;
    m[12] = o.x;
    m[13] = o.y;
    m[14] = o.z;
    m[15] = 1.0
}

tag skate_math, skate
mat_point(m: []f32, p: V3): V3 {
    v3(m[0] * p.x + m[4] * p.y + m[8] * p.z + m[12], m[1] * p.x + m[5] * p.y + m[9] * p.z + m[13],
        m[2] * p.x + m[6] * p.y + m[10] * p.z + m[14])
}

tag skate_math, skate
mat_vector(m: []f32, p: V3): V3 {
    v3(m[0] * p.x + m[4] * p.y + m[8] * p.z, m[1] * p.x + m[5] * p.y + m[9] * p.z,
        m[2] * p.x + m[6] * p.y + m[10] * p.z)
}

mat_scratch: []f32 = new f32[16](0.0);

// m = m * translate(t)
tag skate_math, skate
mat_translate(m: []f32, t: V3) {
    m[12] = m[0] * t.x + m[4] * t.y + m[8] * t.z + m[12];
    m[13] = m[1] * t.x + m[5] * t.y + m[9] * t.z + m[13];
    m[14] = m[2] * t.x + m[6] * t.y + m[10] * t.z + m[14]
}

// m = m * rotate(axis, angle)
tag skate_math, skate
mat_rotate(m: []f32, axis: V3, angle: f32) {
    x: V3 = v_rotate(v3(1.0, 0.0, 0.0), axis, angle);
    y: V3 = v_rotate(v3(0.0, 1.0, 0.0), axis, angle);
    z: V3 = v_rotate(v3(0.0, 0.0, 1.0), axis, angle);
    mat_frame(mat_scratch, x, y, z, v3(0.0, 0.0, 0.0));
    mat_mul(m, m, mat_scratch)
}

// m = m * scale(s)
tag skate_math, skate
mat_scale(m: []f32, s: V3) {
    for i in 0..3 {
        m[i] = m[i] * s.x;
        m[4 + i] = m[4 + i] * s.y;
        m[8 + i] = m[8 + i] * s.z
    }
}
