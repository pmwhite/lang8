tag skate;

// What is written over the game as he rides: the score in the corner, and
// round him the trick card (see put_card), in the game's writing (see
// paint.l8), bold, in capitals, each line with a soft dark halo to be read
// over anything. (Painted with what is over the game: see ui.l8.)

// The HUD's unit, in window pixels: its letters' capitals are about six
// of them tall, and its lines ten apart.
hud_px: f32 = 3.0;

text_buf: []i8 = new i8[1024](0i8);

text_len: int = 0;

// The writing's size, for hud_px.
hud_size(): f32 {
    8.5 * hud_px
}

// The text in text_buf at (x, y), its capitals' top a little below y, in a
// color.
put_text(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    size: f32 = hud_size();
    base: f32 = y + 6.6 * hud_px;
    paint_text(BOLD, size, 0.03, true, x, base + size * 0.05, text_buf, 0, text_len,
        0.12, 0.2, 0.0, 0.0, 0.03, a * 0.7);
    paint_text(BOLD, size, 0.03, true, x, base, text_buf, 0, text_len, 0.0, 0.0, r,
        g, b, a)
}

text_width(): f32 {
    text_wide(BOLD, hud_size(), 0.03, true, text_buf, 0, text_len)
}

append(s: str) {
    for c in s {
        if (text_len < len(text_buf)) {
            text_buf[text_len] = c;
            text_len = text_len + 1
        }
    }
}

append_int(n: int) {
    if (n >= 10) append_int(n / 10);
    if (text_len < len(text_buf)) {
        text_buf[text_len] = (n % 10 + 48) trunc i8;
        text_len = text_len + 1
    }
}

// On the course: whether the run is over, and for how long; and the trick
// he is crouched for, if he is.
hud_finished: bool = false;

hud_finish_t: f32 = 0.0;

hud_aiming: bool = false;

// His carve: which way across the hill he heads.
hud_carve: f32 = 0.0;

hud_aim_flips: int = 0;

hud_aim_halves: int = 0;

// Whether he rides switch now, how long the run has gone, and where he
// stands.
hud_switch: bool = false;

hud_run_t: f32 = 0.0;

hud_rider_at: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

hud_rider_d: f32 = 0.0;

hud_seed: int = 0;

// A course's number being typed (or -1); the replay being watched (which,
// or -1); and whether there is a run to watch again.
hud_typed: int = -1;

// Time, for what blinks.
hud_blink: f32 = 0.0;

hud_replay: int = -1;

hud_can_replay: bool = false;

// On a page, which shows for itself that a place is loading.
hud_page: bool = false;

// A cut (he is somewhere else all at once, or what is watched changes) is
// softened: the picture goes dark with it, and comes up out of the dark
// over a moment. How dark, from 1; main brings it down. And whether only
// that is to be drawn (while a place is shown off).
hud_dip: f32 = 0.0;

hud_bare: bool = false;

// The run's report comes up, however it came to be shown (at the finish,
// or at the end of watching the run again).
results_in: f32 = 0.0;

// Laying out a new course: 1 while the frame saying so is drawn, then 2.
hud_building: int = 0;

item_name(item: int): str {
    if (item == FEATURE_KICKER) return "KICKER";
    if (item == FEATURE_PIPE) return "PIPE";
    if (item == FEATURE_CLIFF) return "CLIFF";
    if (item == FEATURE_GAP) return "GAP";
    if (item == FEATURE_ROLLERS) return "ROLLER";
    "FLAT"
}

// What an item favors, as text.
item_favors(item: int) {
    append(item_name(item));
    if (item == FEATURE_KICKER) append(": FLIPS x2");
    if (item == FEATURE_PIPE) append(": SPINS x2");
    if (item == FEATURE_CLIFF) append(": GRABS x2.5");
    if (item == FEATURE_GAP) append(": FLIP+SPIN x1.5");
    if (item < 0 || item == FEATURE_ROLLERS) append(": x0.25")
}

// A thin ring round (x, y).
put_ring(
    x: f32,
    y: f32,
    r: f32,
    a: f32
) {
    paint_ring(x, y, r, maxf(1.5, hud_px * 0.7), 1.0, 0.98, 0.92, a)
}

// A filled disc at (x, y), of radius r.
put_disc(
    x: f32,
    y: f32,
    r: f32,
    red: f32,
    g: f32,
    b: f32,
    a: f32
) {
    paint_shadow(x - r, y - r, 2.0 * r, 2.0 * r, r, hud_px * 0.6, hud_px * 1.5, 0.35 * a);
    paint_disc(x, y, r, red, g, b, a)
}

// A thick line from (x0, y0) to (x1, y1), w wide, with round ends.
put_segment(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    w: f32,
    red: f32,
    g: f32,
    b: f32,
    a: f32
) {
    paint_line(x0, y0, x1, y1, w, red, g, b, a)
}

// A dot at (x, y): where a thumb is.
put_dot(x: f32, y: f32, a: f32) {
    r: f32 = maxf(8.0, hud_px * 4.0);
    paint_shadow(x - r, y - r, 2.0 * r, 2.0 * r, r, hud_px * 0.6, hud_px * 2.0, 0.35 * a);
    paint_disc(x, y, r, 1.0, 0.98, 0.92, a)
}

// A trick by name: its flip, its spin, and a grab, joined by sep; or
// none if it has none of them.
flip_names: []str = ["FRONTFLIP", "BACKFLIP", "DOUBLE FRONTFLIP", "DOUBLE BACKFLIP",
    "TRIPLE FRONTFLIP", "TRIPLE BACKFLIP"];

spin_names: []str = ["180", "360", "540", "720", "900", "1080"];

trick_text(
    flips: int,
    halves: int,
    grab: bool,
    sep: str,
    none: str
) {
    nf: int = absi(flips);
    if (nf > 0) {
        id: int = (mini(nf, 3) - 1) * 2;
        if (flips < 0) id = id + 1;
        append(flip_names[id])
    }
    nh: int = absi(halves);
    if (nh > 0) {
        if (nf > 0) append(sep);
        append(spin_names[mini(nh, 6) - 1])
    }
    if (grab) {
        if (nf + nh > 0) append(sep);
        append("GRAB")
    }
    if (nf == 0 && nh == 0 && !grab) append(none)
}

hit_text(h: Hit) {
    if (h.sw) append("SWITCH ");
    if (h.kind == HIT_RAIL) append("RAIL") else if (h.kind == HIT_BOX) append("BOX") else trick_text(h.flips,
        h.halves, h.grab, " ", "AIR")
}

// text_buf centered on x at y, in a color.
put_centered_on(
    x: f32,
    y: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    put_text(floorf(x - text_width() * 0.5), floorf(y), r, g, b, a)
}

// The calls on a hit, as lines under its points: flat ground, a repeat,
// what favored it, switch. Call k of them is written into text_buf, and
// its color is kept in call_r, call_g, call_b; false if there is no call
// k.
call_r: f32 = 1.0;

call_g: f32 = 1.0;

call_b: f32 = 1.0;

call_line(h: Hit, k: int): bool {
    n: int = 0;
    text_len = 0;
    if (h.kind == HIT_FLAT) {
        if (n == k) {
            append("FLAT x0.25");
            return call_color(1.0, 0.55, 0.35)
        }
        n = n + 1
    }
    if (h.repeat > 0) {
        if (n == k) {
            append("REPEAT x");
            if (h.repeat == 1) append("0.5") else if (h.repeat == 2) append("0.25") else append("0.1");
            return call_color(1.0, 0.55, 0.35)
        }
        n = n + 1
    }
    // What the feature made of it, if it changed anything.
    favored: bool = h.flips != 0 && item_flips(h.item) != 1.0 || h.halves != 0 && item_spins(h.item) != 1.0 || h.grab && item_grabs(h.item) != 1.0 || item_combo(h.item,
        h.flips, h.halves) != 1.0;
    if (h.kind == HIT_AIR && h.item >= 0 && favored) {
        if (n == k) {
            item_favors(h.item);
            return call_color(0.75, 0.9, 1.0)
        }
        n = n + 1
    }
    if (h.sw) {
        if (n == k) {
            append("SWITCH x1.5");
            return call_color(0.75, 0.9, 1.0)
        }
        n = n + 1
    }
    false
}

call_color(r: f32, g: f32, b: f32): bool {
    call_r = r;
    call_g = g;
    call_b = b;
    true
}

calls_of(h: Hit): int {
    n: int = 0;
    while (call_line(h, n)) n = n + 1;
    n
}

// ---- the trick card ----
// The trick he is about, in three places: over his head, what he aims at;
// near the top of the window, held still there, the trick he has let go
// into and what it came to; and under his feet, how far through it he has
// turned. So in the air only a bar moves with him, to be seen at the edge
// of the eye while he is watched, and what is to be read keeps still and
// out of his way.
//
// Aimed at, while the pad is held: its name, in gold, over his head. Let
// go into: the name rises to its place at the top, going white, and under
// his feet a bar opens out from the middle and fills as he turns through
// it (an ollie has none). A grab, in the air: a small word over the name,
// which nothing else makes way for. The pad held through a grab winds up
// the next trick as he lands: its name, in gold, over his head, where it
// is aimed at once he lands. Landed: under the name at the top come the
// points and then what made them more or less, a moment apart, or why it
// was sketchy; a grab that counted keeps its word. Under his feet the bar
// becomes a green line, clean, or stays as far as he got and turns red,
// sketchy; and soon goes. Then the card fades, drifting up. A grind's (or
// a straight air's) card comes the same way, at the top. The next trick
// let go into, the last one's card fades for it.

// The air, as main sets it each frame: whether he has let go into a trick
// this air, or grabbed; whether into a trick; what it is (flips forward,
// half turns to the right); how much of it he has turned, 0 to 1; whether
// he grabs now, and whether he has this air; and the trick he winds up
// meanwhile (the pad held through a grab), whether he does.
hud_flying: bool = false;

hud_trick_set: bool = false;

// (Whether he flew off a feature.)
hud_off_feature: bool = false;

hud_trick_flips: int = 0;

hud_trick_halves: int = 0;

hud_turned: f32 = 0.0;

hud_grabbing: bool = false;

hud_grabbed: bool = false;

hud_queued: bool = false;

hud_queue_flips: int = 0;

hud_queue_halves: int = 0;

type Card = {
    // Its places with him, where he was last seen: the middle of the top
    // of a name over his head, and of the bar under his feet; and how far
    // a name over his head is lifted over the word SWITCH there, 0 to 1.
    head_x: f32;
    head_y: f32;
    foot_x: f32;
    foot_y: f32;
    switch_a: f32;
    // The trick in the air: how much it shows; how long since he let go
    // into it (-1 while he aims); how far its name has risen from over his
    // head to the top, 0 to 1; how wide its bar is open; how much its
    // grab's word shows; and the trick wound up, and how much that shows.
    shown: f32;
    since_set: f32;
    rise: f32;
    bar_w: f32;
    grab_a: f32;
    queue_a: f32;
    queue_flips: int;
    queue_halves: int;
    // (A trick queued, landed with, until he is seen winding it up: he
    // is, a step after landing; meanwhile, for a frame, the card named
    // nothing and jumped to the top.)
    carried: bool;
    // The latest hit: which (run.n when it came, or 0); how long since;
    // whether it came out of a trick in the air, and how far that's name
    // had risen then, how wide its bar was, and how much its grab's word
    // showed; and how far it has gone for the next trick let go into, 0
    // to 1.
    hit_n: int;
    hit_t: f32;
    from_air: bool;
    from_rise: f32;
    from_w: f32;
    from_grab: f32;
    aside: f32
}

card: *Card = new Card {
    head_x: 0.0,
    head_y: 0.0,
    foot_x: 0.0,
    foot_y: 0.0,
    switch_a: 0.0,
    shown: 0.0,
    since_set: -1.0,
    rise: 0.0,
    bar_w: 0.0,
    grab_a: 0.0,
    queue_a: 0.0,
    queue_flips: 0,
    queue_halves: 0,
    carried: false,
    hit_n: 0,
    hit_t: 0.0,
    from_air: false,
    from_rise: 0.0,
    from_w: 0.0,
    from_grab: 0.0,
    aside: 0.0
};

// How long a landed card shows (from its last points: a grind's go on coming),
// and how long it takes to fade; how long a name takes to rise to the top,
// and how long a landed bar shows under his feet.
const CALL_LINGER: f32 = 2.5;

const CARD_FADE: f32 = 0.6;

const CARD_RISE: f32 = 0.45;

const CARD_BAR_LINGER: f32 = 1.2;

// In hud_px: from one line of writing to the next; the bar's thickness,
// the line's, and its width; how far under the writing at the top the
// card's name is (room for a grab's word over it); how far over his head
// a name's top is (as SWITCH's: see build_hud), and under his feet the
// bar.
const CARD_LINE: f32 = 10.0;

const CARD_BAR: f32 = 1.8;

const CARD_RULE: f32 = 0.9;

const CARD_BAR_W: f32 = 36.0;

const CARD_TOP: f32 = 6.0;

const CARD_HEAD: f32 = 8.0;

const CARD_FEET: f32 = 3.0;

// In metres: how high his head is over his feet, and how far under his
// feet the bar hangs from (about as far as his head goes past his feet,
// upside down in a flip: see set_tumble).
const RIDER_HEAD: f32 = 1.55;

const CARD_BELOW: f32 = 0.3;

// How small a grab's word is written, and how far over the name.
const GRAB_WORD: f32 = 0.72;

// How small a hit's calls are written, and how bright; and the room
// between a name and its points (and, wider, between calls).
const CALL_WORD: f32 = 0.82;

const CALL_A: f32 = 0.8;

const CARD_GAP: f32 = 3.0;

const GRAB_OVER: f32 = 6.0;

// Colors: aiming, gold; let go into, white; the bar's fill, gold; clean,
// green; sketchy, red; a grab's word, pale blue.
const GOLD_TEXT_G: f32 = 0.84;

// The name of a trick, by its flips and half turns (a grab has its own
// word: see put_grab_word).
card_name(flips: int, halves: int) {
    text_len = 0;
    trick_text(flips, halves, false, " ", "OLLIE")
}

// The name of a hit, on its card: a straight air off flat ground is an
// ollie, as it was called in the air (see flying_name).
card_hit_name(h: Hit) {
    text_len = 0;
    none: str = "AIR";
    if (h.kind == HIT_FLAT) none = "OLLIE";
    if (h.kind == HIT_RAIL) append("RAIL") else if (h.kind == HIT_BOX) append("BOX") else trick_text(h.flips,
        h.halves, false, " ", none)
}

// Where the middle of something half wide goes, near x, to be inside a
// window w wide.
inside(x: f32, half: f32, w: int): f32 {
    edge: f32 = 8.0 + 2.0 * hud_px;
    clampf(x, minf(half + edge, w as f32 * 0.5), maxf(w as f32 - half - edge, w as f32 * 0.5))
}

// A bar (or line), its middle at x, top at y, wide and thick, full to
// fill of its width, in a color over a dark track.
put_card_bar(
    x: f32,
    y: f32,
    wide: f32,
    thick: f32,
    fill: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    if (wide < 1.0 || a <= 0.0) return;
    t: f32 = maxf(thick, 1.0);
    x0: f32 = x - wide * 0.5;
    paint_shadow(x0, y, wide, t, t * 0.5, hud_px * 0.4, hud_px * 1.2, 0.3 * a);
    paint_box(x0, y, wide, t, t * 0.5, 0.05, 0.06, 0.1, 0.45 * a);
    fw: f32 = wide * clampf(fill, 0.0, 1.0);
    if (fw > 0.5) paint_box(x0, y, maxf(fw, t), t, t * 0.5, r, g, b, a)
}

// A grab's word, small, over a name whose top's middle is at x, y: coming
// down into place as it shows (a, 0 to 1).
put_grab_word(x: f32, y: f32, a: f32) {
    if (a <= 0.0) return;
    hp: f32 = hud_px;
    hud_px = hp * GRAB_WORD;
    text_len = 0;
    append("GRAB");
    put_centered_on(x, y - GRAB_OVER * hp - (1.0 - smooth(a)) * 2.0 * hp, 0.75, 0.9,
        1.0, a);
    hud_px = hp
}

// How much a card shows at the top, for the corner's lines it could
// reach on a narrow screen (see put_course_score).
card_up: f32 = 0.0;

// Where the card's name was written this frame (its y, as put_text has it),
// or less than 0 if it was not: SWITCH over his head keeps out of its way.
card_name_y: f32 = -1.0;

put_card(w: int, top: f32) {
    hp: f32 = hud_px;
    card_name_y = -1.0;
    // A hit come since the last frame: the card it makes takes over from
    // the trick in the air, in its place. A trick wound up meanwhile
    // becomes the one aimed at, where it is.
    if (run.n > 0 && run.n != card.hit_n && run.call_t < CALL_LINGER) {
        card.hit_n = run.n;
        card.hit_t = 0.0;
        card.from_air = card.shown > 0.5 && card.since_set >= 0.0;
        card.from_rise = card.rise;
        card.from_w = card.bar_w;
        card.from_grab = card.grab_a;
        card.aside = 0.0;
        if (card.queue_a <= 0.5) card.shown = 0.0;
        card.carried = card.queue_a > 0.5;
        card.queue_a = 0.0;
        card.grab_a = 0.0;
        card.bar_w = 0.0;
        card.since_set = -1.0
    }
    if (run.n == 0) card.hit_n = 0;
    flying: bool = hud_flying && !hud_finished;
    if (hud_aiming || flying || card.hit_t > 0.1) card.carried = false;
    aiming: bool = (hud_aiming || card.carried) && !flying && !hud_finished;
    // (A name rises from over his head only if it was aimed at there; a
    // grab with nothing let go into comes at the top.)
    if (flying) {
        if (card.since_set < 0.0) {
            card.since_set = 0.0;
            if (card.shown < 0.5) card.rise = 1.0
        } else card.since_set = card.since_set + hud_dt;
        card.rise = minf(card.rise + hud_dt / CARD_RISE, 1.0)
    } else {
        card.since_set = -1.0;
        if (aiming) card.rise = 0.0
    }
    // (The trick in the air comes over 0.12 s, and goes, an ollie on
    // nothing landing, over 0.2. A grab's word comes over 0.15 s, and
    // stays, quieter, once let go; the trick wound up comes and goes over
    // 0.15.)
    card.shown = fade_toward(card.shown, aiming || flying, 0.12, 0.2);
    grab_to: f32 = 0.0;
    if (flying && hud_grabbing) grab_to = 1.0 else if (flying && hud_grabbed) grab_to = 0.65;
    card.grab_a = lerpf(card.grab_a, grab_to, ease(12.0, hud_dt));
    queued: bool = flying && hud_queued && (hud_queue_flips != 0 || hud_queue_halves != 0);
    if (queued) {
        card.queue_flips = hud_queue_flips;
        card.queue_halves = hud_queue_halves
    }
    card.queue_a = fade_toward(card.queue_a, queued, 0.15, 0.15);
    // The last hit's card fades for the next trick let go into.
    if (flying) card.aside = minf(card.aside + hud_dt / 0.2, 1.0);
    switch_to: f32 = 0.0;
    if (hud_switch) switch_to = 1.0;
    card.switch_a = lerpf(card.switch_a, switch_to, ease(10.0, hud_dt));
    card.hit_t = card.hit_t + hud_dt;
    landed: bool = card.hit_n > 0 && card.hit_n == run.n && run.call_t < CALL_LINGER;
    card_up = fade_toward(card_up, card.shown > 0.0 && !aiming || landed, 0.2, 0.4);
    if (card.shown <= 0.0 && !landed) return;
    if (project(v3(hud_rider_at.x, hud_rider_at.y + RIDER_HEAD, hud_rider_at.z))) {
        card.head_x = proj_x;
        card.head_y = maxf(proj_y - (CARD_HEAD + CARD_LINE * card.switch_a) * hp,
            top)
    }
    if (project(v3(hud_rider_at.x, hud_rider_at.y - CARD_BELOW, hud_rider_at.z))) {
        card.foot_x = proj_x;
        card.foot_y = minf(proj_y + CARD_FEET * hp, screen_h as f32 - 6.0 * hp)
    }
    top_y: f32 = top + CARD_TOP * hp;
    if (landed) put_landed(w, run.hits[card.hit_n - 1], top_y);
    if (card.shown > 0.0) put_flying(w, aiming, top_y)
}

// The name of the trick aimed at, or let go into: with no turning, an
// ollie, or off a feature, an air (as a grab with no trick let go into is).
flying_name(aiming: bool) {
    if (aiming && card.carried) card_name(card.queue_flips, card.queue_halves) else if (aiming) card_name(hud_aim_flips,
        hud_aim_halves) else if (hud_trick_set && (hud_trick_flips != 0 || hud_trick_halves != 0)) card_name(hud_trick_flips,
        hud_trick_halves) else {
        text_len = 0;
        if (hud_trick_set && !hud_off_feature) append("OLLIE") else append("AIR")
    }
}

// Where a name is that has risen k of the way from over his head to the
// top (its top at top_y), in a window w wide: its middle into rise_x, its
// top's into rise_y.
rise_x: f32 = 0.0;

rise_y: f32 = 0.0;

rise_to(k: f32, top_y: f32, w: int) {
    e: f32 = smooth(k);
    rise_x = inside(lerpf(card.head_x, w as f32 * 0.5, e), text_width() * 0.5, w);
    rise_y = lerpf(card.head_y, top_y, e)
}

// The trick aimed at, over his head; or let go into, rising to the top
// (top_y), with its grab's word, and its bar under his feet; and the trick
// wound up, over his head.
put_flying(w: int, aiming: bool, top_y: f32) {
    hp: f32 = hud_px;
    a: f32 = card.shown;
    flying_name(aiming);
    if (aiming) {
        put_centered_on(inside(card.head_x, text_width() * 0.5, w), card.head_y, 1.0,
            GOLD_TEXT_G, 0.32, a);
        card_name_y = card.head_y
    } else {
        // (White, from gold, as it goes.)
        set: f32 = smoothstepf(0.0, 0.2, card.since_set);
        rise_to(card.rise, top_y, w);
        card_name_y = rise_y;
        x: f32 = rise_x;
        put_centered_on(x, rise_y, 1.0, lerpf(GOLD_TEXT_G, 0.98, set), lerpf(0.32,
            0.92, set), a);
        put_grab_word(x, rise_y, a * card.grab_a);
        // Its bar, opening out from the middle.
        if (hud_trick_set && (hud_trick_flips != 0 || hud_trick_halves != 0)) {
            card.bar_w = CARD_BAR_W * hp * ease_out(card.since_set / 0.18);
            put_card_bar(inside(card.foot_x, CARD_BAR_W * hp * 0.5, w), card.foot_y,
                card.bar_w, CARD_BAR * hp, hud_turned, 1.0, GOLD_TEXT_G, 0.32, a)
        }
    }
    if (card.queue_a > 0.0) {
        card_name(card.queue_flips, card.queue_halves);
        put_centered_on(inside(card.head_x, text_width() * 0.5, w), card.head_y + (1.0 - smooth(card.queue_a)) * 2.0 * hp,
            1.0, GOLD_TEXT_G, 0.32, a * card.queue_a)
    }
}

// A hit's card, at the top (its name's top at top_y), in a window w wide;
// and under his feet, its bar's end.
put_landed(w: int, h: Hit, top_y: f32) {
    hp: f32 = hud_px;
    t: f32 = card.hit_t;
    // It fades as it goes, drifting up, or for the next trick let go into.
    out: f32 = smoothstepf(CALL_LINGER - CARD_FADE, CALL_LINGER, run.call_t);
    away: f32 = 1.0 - smooth(card.aside);
    a: f32 = (1.0 - out) * away;
    if (!card.from_air) a = a * smoothstepf(0.0, 0.2, t);
    sketchy: bool = h.kind == HIT_SKETCH;
    // Its name, going on up to the top if it was rising still (come at the
    // top, if it had not been in the air); clean, its points come in beside
    // it, the two kept together in the middle, the name making way.
    rise: f32 = 1.0;
    if (card.from_air) rise = minf(card.from_rise + t / CARD_RISE, 1.0);
    text_len = 0;
    append_int((h.points + 0.5) as int);
    points_w: f32 = text_width() + CARD_GAP * hp;
    k: f32 = ease_out((t - 0.12) / 0.3);
    if (sketchy) k = 0.0;
    card_hit_name(h);
    name_w: f32 = text_width();
    rise_to(rise, top_y, w);
    wide: f32 = name_w + points_w * k;
    x0: f32 = inside(rise_x, wide * 0.5, w) - wide * 0.5;
    y: f32 = rise_y - out * 3.0 * hp;
    put_text(x0, y, 1.0, 0.98, 0.92, a);
    if (a > 0.05) card_name_y = y;
    // A grab that counted keeps its word (or gets it); one that didn't
    // loses it.
    grab: f32 = card.from_grab * (1.0 - smoothstepf(0.0, 0.25, t));
    if (h.grab) grab = maxf(card.from_grab, smoothstepf(0.0, 0.25, t));
    put_grab_word(x0 + name_w * 0.5, y, a * grab);
    if (k > 0.0) {
        text_len = 0;
        append_int((h.points + 0.5) as int);
        put_text(x0 + name_w + CARD_GAP * hp, y + (1.0 - k) * 3.0 * hp, 1.0, GOLD_TEXT_G,
            0.32, a * k)
    }
    // Under it, small and quieter: why it was sketchy, or what made the
    // points more or less.
    put_calls(h, x0 + wide * 0.5, y + CARD_LINE * hp, w, t, a);
    // Under his feet, the bar it had: clean, become a green line, full,
    // thinner, as wide; sketchy, as far as he got, red. Soon gone.
    if (!card.from_air || card.from_w < 0.5) return;
    ba: f32 = (1.0 - smoothstepf(CARD_BAR_LINGER, CARD_BAR_LINGER + 0.4, t)) * away;
    if (ba <= 0.0) return;
    bar: f32 = CARD_BAR_W * hp;
    bx: f32 = inside(card.foot_x, bar * 0.5, w);
    if (sketchy) {
        red: f32 = smoothstepf(0.0, 0.25, t);
        put_card_bar(bx, card.foot_y, lerpf(card.from_w, bar, ease_out(t / 0.3)),
            CARD_BAR * hp, h.turned, 1.0, lerpf(GOLD_TEXT_G, 0.42, red), lerpf(0.32,
            0.36, red), ba)
    } else {
        m: f32 = ease_out(t / 0.3);
        thick: f32 = lerpf(CARD_BAR * hp, maxf(CARD_RULE * hp, 1.0), m);
        put_rule(bx, card.foot_y + (CARD_BAR * hp - thick) * 0.5, lerpf(card.from_w,
            bar, m), thick, m, ba)
    }
}

// A clean trick's bar becoming a green line (k of the way): from gold, its
// track under it, to green.
put_rule(
    x: f32,
    y: f32,
    wide: f32,
    thick: f32,
    k: f32,
    a: f32
) {
    if (wide < 1.0) return;
    x0: f32 = x - wide * 0.5;
    paint_shadow(x0, y, wide, thick, thick * 0.5, hud_px * 0.4, hud_px * 1.2, 0.3 * a);
    paint_box(x0, y, wide, thick, thick * 0.5, 0.05, 0.06, 0.1, 0.45 * a * (1.0 - k));
    paint_box(x0, y, wide, thick, thick * 0.5, lerpf(1.0, 0.5, k), lerpf(GOLD_TEXT_G,
        0.95, k), lerpf(0.32, 0.6, k), a)
}

// A hit's calls (or, sketchy, why), small, in a line under its name, its
// top at y and its middle near x, or as many lines as they need in a
// window w wide: coming in from a little below a moment after the landing
// (t), all together.
put_calls(
    h: Hit,
    x: f32,
    y: f32,
    w: int,
    t: f32,
    a: f32
) {
    k: f32 = ease_out((t - 0.24) / 0.3);
    if (k <= 0.0) return;
    hp: f32 = hud_px;
    hud_px = hp * CALL_WORD;
    gap: f32 = CARD_GAP * 2.2 * hud_px;
    room: f32 = w as f32 - 2.0 * (8.0 + 2.0 * hp);
    line_y: f32 = y + (1.0 - k) * 3.0 * hp;
    if (h.kind == HIT_SKETCH) {
        text_len = 0;
        if (h.short) append("SKETCHY - SHORT OF THE GAP") else append("SKETCHY - NOT FINISHED");
        put_centered_on(inside(x, text_width() * 0.5, w), line_y, 1.0, 0.45, 0.38,
            a * k * CALL_A)
    } else {
        n: int = calls_of(h);
        i: int = 0;
        while (i < n) {
            // As many as fit in a line.
            j: int = i;
            wide: f32 = 0.0;
            full: bool = false;
            while (j < n && !full) {
                call_line(h, j);
                more: f32 = text_width();
                if (j > i) more = more + gap;
                if (j > i && wide + more > room) full = true else {
                    wide = wide + more;
                    j = j + 1
                }
            }
            lx: f32 = inside(x, wide * 0.5, w) - wide * 0.5;
            for c in i..j {
                call_line(h, c);
                put_text(lx, line_y, call_r, call_g, call_b, a * k * CALL_A);
                lx = lx + text_width() + gap
            }
            line_y = line_y + CARD_LINE * hud_px;
            i = j
        }
    }
    hud_px = hp
}

// A filled rectangle (with its corners rounded by radius).
put_rect(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    paint_box(x0, y0, x1 - x0, y1 - y0, 0.0, r, g, b, a)
}

// The thumbs on a touch screen. Steering: a bar along the steering panel
// from its middle out to where he heads now, and the thumb, where he aims. The pad: rings round where its thumb came down, one a
// half turn of spin apart, and the thumb; and the trick it aims at.
put_thumbs(w: int) {
    p: *Pointers = pointers;
    ms: f32 = minf(w as f32, screen_h as f32);
    // Where he heads now, on the steering track, while steering.
    if (p.stick >= 0) {
        ty: f32 = (PANEL_TOP + (PANEL_BOTTOM - PANEL_TOP) * TRACK_AT) * screen_h as f32;
        mid: f32 = steer_middle();
        reach: f32 = (STEER_RIGHT - STEER_LEFT) * 0.5 * w as f32 * STEER_FULL;
        hx: f32 = mid + clampf(hud_carve / AIM_MAX, -1.0, 1.0) * reach;
        t: f32 = maxf(5.0, hud_px * 2.5);
        paint_box(minf(mid, hx) - t, ty - t, absf(hx - mid) + 2.0 * t, 2.0 * t, t,
            1.0, 0.62, 0.25, 0.95);
        put_dot(clampf(p.x[p.stick], STEER_LEFT * w as f32, STEER_RIGHT * w as f32),
            ty, 1.0)
    }
    // The trick thumb: a red disc where it came down, faint rings round
    // that at each half turn's reach, and a bold line out to where it is.
    if (p.trick >= 0) {
        tx: f32 = p.x0[p.trick];
        ty0: f32 = p.y0[p.trick];
        for k in 1..4 put_ring(tx, ty0, SPIN_STEP * ms * k as f32, 0.45 - 0.1 * k as f32);
        put_segment(tx, ty0, p.x[p.trick], p.y[p.trick], maxf(6.0, hud_px * 3.0),
            1.0, 0.62, 0.25, 0.95);
        put_disc(tx, ty0, maxf(12.0, hud_px * 5.0), 0.9, 0.22, 0.18, 0.95);
        put_dot(p.x[p.trick], p.y[p.trick], 1.0)
    }
    // (The trick aimed at is named over his head: see put_card.)
}

// ---- the world, on the screen ----
// Where a point in the world falls on the screen, in window pixels from
// the top left (proj_x, proj_y), if it is in front of the camera.
proj_x: f32 = 0.0;

proj_y: f32 = 0.0;

project(p: V3): bool {
    m: []f32 = vp_m;
    cx: f32 = m[0] * p.x + m[4] * p.y + m[8] * p.z + m[12];
    cy: f32 = m[1] * p.x + m[5] * p.y + m[9] * p.z + m[13];
    cw: f32 = m[3] * p.x + m[7] * p.y + m[11] * p.z + m[15];
    if (cw < 0.5) return false;
    proj_x = (cx / cw * 0.5 + 0.5) * screen_w as f32;
    proj_y = (0.5 - cy / cw * 0.5) * screen_h as f32;
    true
}

// The frame's length, for fading by.
hud_dt: f32 = 0.016;

// f, moved toward 1 (on) or 0 over rise or fall seconds.
fade_toward(
    f: f32,
    on: bool,
    rise: f32,
    fall: f32
): f32 {
    if (on) return minf(f + hud_dt / rise, 1.0);
    maxf(f - hud_dt / fall, 0.0)
}

// How big the HUD's writing is, in a window w pixels wide (see hud_px):
// on a page, by its CSS pixels, as what else is over the game is (see
// ui.l8).
hud_scale(w: int): f32 {
    if (ui_on) return maxf(1.5, 2.0 * ui_k);
    maxf(2.0, floorf(w as f32 / 420.0))
}

// Lay out the feed for a window w pixels wide.
build_hud(w: int) {
    px: f32 = hud_scale(w);
    hud_px = px;
    // Under everything else here, the dark that the picture comes up out
    // of after a cut (see hud_dip).
    if (hud_dip > 0.0) put_rect(0.0, 0.0, w as f32, screen_h as f32, 0.02, 0.03, 0.06,
        hud_dip * hud_dip * (3.0 - 2.0 * hud_dip));
    if (hud_bare) return;
    results_in = fade_toward(results_in, hud_finished && hud_finish_t > 1.0 && hud_replay < 0,
        0.35, 0.001);
    y: f32 = 3.0 * hud_px + 14.0;
    if (hud_building > 0 && !hud_page) {
        hud_px = px * 2.0;
        text_len = 0;
        append("LOADING...");
        put_text(floorf((w as f32 - text_width()) * 0.5), floorf(screen_h as f32 * 0.3),
            1.0, 0.98, 0.92, 1.0);
        hud_px = px
    }
    // A course's number, as it is typed.
    // (Not on a page, which types a place's number for its own reasons.)
    if (hud_typed >= 0 && !hud_page) {
        hud_px = px * 2.0;
        text_len = 0;
        append("SLOPESTYLE ");
        append_int(hud_typed);
        append("_");
        put_text(floorf((w as f32 - text_width()) * 0.5), floorf(screen_h as f32 * 0.3),
            1.0, 0.98, 0.92, 1.0);
        hud_px = px
    }
    // Watching a replay: that it is one, along the bottom.
    if (hud_replay >= 0) {
        text_len = 0;
        if (hud_replay == REC_BEST) append("REPLAY - BEST RUN") else if (hud_replay == REC_FRIEND) {
            append("REPLAY - ");
            for i in 0..friend_len {
                if (text_len < len(text_buf)) {
                    text_buf[text_len] = friend_name[i];
                    text_len = text_len + 1
                }
            }
            append(" ");
            append_int(rec_score[REC_FRIEND])
        } else append("REPLAY");
        // (On a page, its button goes back from it.)
        if (!hud_page) append(" - BACKSPACE TO STOP");
        if (w >= 600) append(" - C FOR CAMERA");
        // (On a narrow screen, above the page's buttons in the corner.)
        lift: f32 = 0.0;
        if (w < 600) lift = 56.0;
        put_text(floorf((w as f32 - text_width()) * 0.5), floorf(screen_h as f32 - 12.0 * px - 14.0 - lift),
            1.0, 0.84, 0.32, 0.75 + 0.25 * sinf(hud_blink * 4.0))
    }
    // At the finish, the run's report, alone.
    if (hud_finished && hud_finish_t > 1.0 && hud_replay < 0) {
        put_results(w, px);
        return
    }
    // On a narrow screen the score has the top to itself.
    if (w < 760) y = 25.0 * hud_px + 14.0;
    // (On a page, below the buttons in the corners and the keys' help; on a
    // narrow screen, below the score too.)
    if (ui_on) {
        y = edge_t() + 2.0 * round_r() + U(10.0);
        if (w as f32 / ui_k < 700.0) y = y + 12.0 * hud_px
    }
    // (The tutorial's words come first, and the feed below them.)
    y = put_tutorial(w, px, y);
    hud_px = px;
    put_card(w, y);
    put_course_score(w, px)
}

// Where the words in the top right corner start (the score, and under it
// the place, a park's time, a round's: see rounds.l8): on a page, below
// its buttons in the corner (larger ones, on a narrow screen, a phone's).
corner_top(px: f32): f32 {
    if (ui_on) return edge_t() + 2.0 * round_r() + U(6.0) - 3.0 * px;
    14.0
}

// The thumbs, the run's score in the corner, and at the end, the finish.
put_course_score(w: int, px: f32) {
    put_thumbs(w);
    top: f32 = corner_top(px);
    text_len = 0;
    append("SCORE ");
    append_int(run.total);
    put_text(w as f32 - text_width() - 3.0 * px - 10.0, 3.0 * px + top, 1.0, 0.98,
        0.92, 0.9);
    // The best run and the place's name only as the run begins, so that
    // they do not clutter it: they fade over its first seconds.
    intro: f32 = smoothstepf(4.5, 3.0, hud_run_t);
    // (On a narrow screen, they make way for a trick's card: see put_card.)
    if (w < 760) intro = intro * (1.0 - card_up);
    if (intro > 0.0 && !hud_finished) {
        // (A lesson has no best to beat: only its name.)
        label_y: f32 = 14.0 * px + top;
        if (!in_tutorial() && !round_on) {
            text_len = 0;
            append("BEST RUN ");
            append_int(run.best_run);
            put_text(w as f32 - text_width() - 3.0 * px - 10.0, label_y, 1.0, 0.98,
                0.92, 0.7 * intro);
            label_y = 25.0 * px + top
        }
        text_len = 0;
        course_label(hud_seed);
        put_text(w as f32 - text_width() - 3.0 * px - 10.0, label_y, 1.0, 0.98, 0.92,
            0.55 * intro)
    }
    // Riding switch: a quiet word over his cap, where he is looked at.
    // (Coming as the name over him makes room for it, and keeping out of
    // the way of a name still near him: landing switch from a short air,
    // they were written over each other.)
    if (card.switch_a > 0.01 && !hud_finished && project(v3(hud_rider_at.x, hud_rider_at.y + RIDER_HEAD,
        hud_rider_at.z))) {
        sy: f32 = floorf(proj_y - 8.0 * hud_px);
        clear: f32 = 1.0;
        if (card_name_y >= 0.0) clear = smoothstepf(CARD_LINE * 0.6, CARD_LINE * 0.9,
            absf(sy - card_name_y) / hud_px);
        text_len = 0;
        append("SWITCH");
        put_text(floorf(proj_x - text_width() * 0.5), sy, 0.65, 0.92, 0.88, 0.6 * card.switch_a * clear)
    }
    // In a park, how long the run has left: larger, and red, at the last.
    if (park && !hud_finished) {
        left: int = maxi((hud_time_left + 0.99) as int, 0);
        text_len = 0;
        append("TIME ");
        append_int(left);
        if (left <= 10) {
            // (Coming up over its first moments, not all at once.)
            hud_px = px * 2.0;
            put_text(floorf((w as f32 - text_width()) * 0.5), floorf(screen_h as f32 * 0.22),
                1.0, 0.45, 0.38, 0.9 * smoothstepf(10.0, 9.5, hud_time_left));
            hud_px = px
        } else put_text(w as f32 - text_width() - 3.0 * px - 10.0, 36.0 * px + top,
            1.0, 0.84, 0.32, 0.9)
    }
}

// How long a park's run has left.
hud_time_left: f32 = 0.0;

// A day's course has its date for its number, as 20261010: whether n is
// one.
daily_course(n: int): bool {
    n >= 20000101 && n <= 29991231
}

month_names: []str = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP",
    "OCT", "NOV", "DEC"];

// The first few slopestyles' and parks' names (as the page has them: see
// SLOPE_NAMES, in skate.js).
slope_names: []str = ["HAYSTACK", "PINEWOOD", "LANTERN", "CLOVER", "FOX RUN"];

park_names: []str = ["PEBBLE", "SUNDIAL", "MOSSY", "BIRDBATH", "THISTLE"];

// What to call board n: its place's name, or its number, or for a day's
// course, its day; and on the moon, so.
course_label(n: int) {
    // (A round's place is one of an endless run: see rounds.l8.)
    if (round_on) {
        append("TOGETHER");
        return
    }
    if (board_on_moon(n)) {
        course_label(board_place(n));
        append(" ON THE MOON");
        return
    }
    if (n >= TUTORIAL && n <= TUTORIAL + LESSONS) {
        if (n > TUTORIAL) {
            append("LESSON ");
            append_int(n - TUTORIAL)
        } else append("TUTORIAL");
        return
    }
    if (n >= BIG_AIR_BASE && n < BIG_AIR_BASE + 100000000) {
        append("BIG AIR");
        // (There is one; any other is numbered.)
        if (n != BIG_AIR_BASE + 1) {
            append(" ");
            append_int(n - BIG_AIR_BASE)
        }
        return
    }
    // (A park's number is negative: see run_id.)
    k: int = absi(n);
    if (n > 0 && n <= len(slope_names)) {
        append(slope_names[n - 1]);
        return
    }
    if (n < 0 && k <= len(park_names)) {
        append(park_names[k - 1]);
        return
    }
    if (!daily_course(k)) {
        if (n < 0) append("PARK ") else append("SLOPESTYLE ");
        append_int(k);
        return
    }
    if (n < 0) append("DAILY PARK ") else append("DAILY SLOPESTYLE ");
    append_int(k % 100);
    append(" ");
    append(month_names[clampi(k / 100 % 100, 1, 12) - 1])
}

// ---- the run's report ----
// At the finish, over the dimmed course: the score, then each trick in
// turn with what it scored and why (or that it was sketchy, and why). It
// scrolls (hud_scroll, in rows) when it is long.
hud_scroll: f32 = 0.0;

// Rows laid out so far, the first shown, how many fit, and where they go.
row_i: int = 0;

row_first: int = 0;

row_fit: int = 0;

row_top: f32 = 0.0;

row_h: f32 = 0.0;

row_w: int = 0;

// How many rows the report has, for scrolling.
results_rows: int = 0;

// The row in text_buf, in a color, indented; and a number at its right
// (or none, if n < 0).
emit_row(
    indent: f32,
    n: int,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) {
    k: int = row_i - row_first;
    row_i = row_i + 1;
    if (k < 0 || k >= row_fit) return;
    y: f32 = row_top + k as f32 * row_h;
    put_text(floorf(20.0 + indent), floorf(y), r, g, b, a);
    if (n >= 0) {
        text_len = 0;
        append_int(n);
        put_text(floorf(row_w as f32 - 20.0 - text_width()), floorf(y), r, g, b, a)
    }
}

// Reasons, gathered and then laid out in as many rows as they need.
reason_buf: []i8 = new i8[512](0i8);

reason_len: int = 0;

// Push text_buf as one reason.
reason_push() {
    for i in 0..text_len {
        if (reason_len < len(reason_buf)) {
            reason_buf[reason_len] = text_buf[i];
            reason_len = reason_len + 1
        }
    }
    if (reason_len < len(reason_buf)) {
        reason_buf[reason_len] = 124i8;
        reason_len = reason_len + 1
    }
    text_len = 0
}

reason_add(s: str) {
    text_len = 0;
    append(s);
    reason_push()
}

// A reason: a label and a factor (to at most two places).
reason_factor(label: str, v: f32) {
    text_len = 0;
    append(label);
    append(" x");
    append_fixed(v);
    reason_push()
}

append_fixed(v: f32) {
    n: int = (v * 100.0 + 0.5) as int;
    append_int(n / 100);
    frac: int = n % 100;
    if (frac != 0) {
        append(".");
        if (text_len < len(text_buf)) {
            text_buf[text_len] = (frac / 10 + 48) trunc i8;
            text_len = text_len + 1
        }
        if (frac % 10 != 0 && text_len < len(text_buf)) {
            text_buf[text_len] = (frac % 10 + 48) trunc i8;
            text_len = text_len + 1
        }
    }
}

flush_reasons(indent: f32) {
    maxc: int = ((row_w as f32 - 40.0 - indent) / (6.0 * hud_px)) as int;
    text_len = 0;
    start: int = 0;
    for i in 0..reason_len {
        if (reason_buf[i] == 124i8) {
            piece: int = i - start;
            if (text_len > 0 && text_len + 2 + piece > maxc) {
                emit_row(indent, -1, 0.72, 0.78, 0.88, 0.85);
                text_len = 0
            }
            if (text_len > 0) append("  ");
            for c in start..i {
                if (text_len < len(text_buf)) {
                    text_buf[text_len] = reason_buf[c];
                    text_len = text_len + 1
                }
            }
            start = i + 1
        }
    }
    if (text_len > 0) emit_row(indent, -1, 0.72, 0.78, 0.88, 0.85);
    reason_len = 0
}

// Why a hit scored what it did.
hit_reasons(h: Hit) {
    reason_len = 0;
    if (h.kind == HIT_SKETCH) {
        if (h.short) reason_add("SHORT OF THE GAP") else reason_add("NOT FINISHED");
        return
    }
    base_reason(h);
    if (h.kind == HIT_AIR || h.kind == HIT_FLAT) {
        if (h.item >= 0) {
            if (h.flips != 0 && item_flips(h.item) != 1.0) item_reason(h.item, " FLIPS",
                item_flips(h.item));
            if (h.halves != 0 && item_spins(h.item) != 1.0) item_reason(h.item, " SPINS",
                item_spins(h.item));
            if (h.grab && item_grabs(h.item) != 1.0) item_reason(h.item, " GRAB",
                item_grabs(h.item));
            if (item_combo(h.item, h.flips, h.halves) != 1.0) item_reason(h.item,
                " FLIP+SPIN", GAP_COMBO)
        }
        reason_factor("AIR", h.amp);
        if (h.kind == HIT_FLAT) reason_factor("FLAT", 0.25)
    }
    if (h.extra > 0.5) {
        text_len = 0;
        append("HELD +");
        append_int((h.extra + 0.5) as int);
        reason_push()
    }
    if (h.sw) reason_factor("SWITCH", 1.5);
    if (h.repeat > 0) {
        f: f32 = 1.0;
        for _k in 0..h.repeat f = f * 0.5;
        reason_factor("REPEAT", f)
    }
}

// What a hit starts from, before anything multiplies it: an air's points
// for its flips, spins, and grab (each multiplied by what the item makes
// of it), or a straight air's; a grind's for getting on.
base_reason(h: Hit) {
    text_len = 0;
    if (h.kind == HIT_RAIL || h.kind == HIT_BOX) {
        append("ENTRY 300");
        reason_push();
        return
    }
    any: bool = false;
    if (h.base_flip > 0.0) {
        append("FLIP ");
        append_int(h.base_flip as int);
        any = true
    }
    if (h.base_spin > 0.0) {
        if (any) append(" + ");
        append("SPIN ");
        append_int(h.base_spin as int);
        any = true
    }
    if (h.base_grab > 0.0) {
        if (any) append(" + ");
        append("GRAB ");
        append_int((h.base_grab + 0.5) as int);
        any = true
    }
    if (!any) append("AIR 100");
    reason_push()
}

item_reason(item: int, what: str, v: f32) {
    text_len = 0;
    append(item_name(item));
    append(what);
    append(" x");
    append_fixed(v);
    reason_push()
}

put_results(w: int, px: f32) {
    k: f32 = smoothstepf(1.0, 1.6, hud_finish_t) * results_in;
    put_rect(0.0, 0.0, w as f32, screen_h as f32, 0.02, 0.03, 0.06, 0.62 * k);
    hud_px = maxf(2.0, px - 1.0);
    row_w = w;
    row_h = 10.0 * hud_px;
    // The score at the top, below the page's button in the corner (a
    // larger one, on a narrow screen: a phone's).
    top: f32 = 66.0;
    if (w < 600) top = 80.0;
    text_len = 0;
    if (park) append("TIME'S UP  ") else append("FINISH  ");
    append_int(run.total);
    hud_px = px;
    put_text(20.0, top, 1.0, 0.84, 0.32, k);
    hud_px = maxf(2.0, px - 1.0);
    // (A round has the standings instead: see rounds.l8.)
    if (!round_on) {
        text_len = 0;
        append("BEST RUN ");
        append_int(run.best_run);
        put_text(20.0, top + 10.0 * px, 1.0, 0.98, 0.92, 0.8 * k)
    }
    // The tricks, in rows below, as many as fit.
    row_top = top + 10.0 * px + 2.0 * row_h;
    // Upright (as on a phone), it keeps above the touch panels: where they
    // still show at the end, as they do not on a page, which has only its
    // buttons along the bottom to clear.
    foot: f32 = screen_h as f32 - 2.0 * row_h;
    if (screen_w < screen_h) {
        if (hud_page) foot = screen_h as f32 - 98.0 else foot = PANEL_TOP * screen_h as f32 - 1.5 * row_h
    }
    bottom: f32 = foot - row_h;
    row_fit = maxi(((bottom - row_top) / row_h) as int, 1);
    hud_scroll = clampf(hud_scroll, 0.0, maxi(results_rows - row_fit, 0) as f32);
    row_first = hud_scroll as int;
    row_i = 0;
    for i in 0..run.n {
        h: Hit = run.hits[i];
        text_len = 0;
        hit_text(h);
        if (h.kind == HIT_SKETCH) {
            append("  SKETCHY");
            emit_row(0.0, 0, 1.0, 0.45, 0.38, k)
        } else emit_row(0.0, (h.points + 0.5) as int, 1.0, 0.98, 0.92, k);
        hit_reasons(h);
        flush_reasons(6.0 * hud_px)
    }
    results_rows = row_i;
    // How to go on, at the foot.
    text_len = 0;
    // (On a narrow screen, a touch one, a drag scrolls. A page has buttons
    // of its own to ride again, and to watch the run: see L8OVER, in
    // main.l8.)
    if (in_tutorial() && !hud_page) append("TUTORIAL DONE - JUMP FOR COURSE 1") else {
        if (!hud_page) append("JUMP TO RESTART");
        if (results_rows > row_fit) {
            if (!hud_page) append(" - ");
            if (w < 600) append("DRAG TO SCROLL") else append("UP/DOWN TO SCROLL")
        }
    }
    // (Along the bottom, it starts past the page's buttons in the corner.)
    foot_x: f32 = 20.0;
    if (screen_w >= screen_h) foot_x = 124.0;
    put_text(foot_x, floorf(foot), 1.0, 0.98, 0.92, smoothstepf(2.0, 2.5, hud_finish_t) * 0.85 * results_in);
    hud_px = px
}
