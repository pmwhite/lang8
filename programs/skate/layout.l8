tag skate;

// Laying out a course: sections down the run, each picked and sized at
// random from the course's seed, so that every course is a little puzzle
// of its own. A section is a line of kickers, a rail garden, a halfpipe, a
// cliff, a gap with a safer kicker beside it, rollers, a wall with a ledge
// across from it, two walls facing, or a kicker up onto a ledge; most
// offer two or three lanes side by side.
course_seed: int = 1;

// Where to go next (see go_to, in main.l8), or 0. It is built after a frame
// that says so: it takes a moment.
go_id: int = 0;

// (Asked while a place is being built, it is kept for when that is done:
// a page may ask for the next place before the first is up.)
go_queued: int = 0;

ask_go(id: int) {
    if (id == 0) return;
    if (hud_building != 0) {
        go_queued = id;
        return
    }
    go_id = id;
    hud_building = 1
}

lay_rng: int = 1;

lay_rand(): f32 {
    lay_rng = (lay_rng * 1103515245 + 12345) % 2147483648;
    if (lay_rng < 0) lay_rng = -lay_rng;
    (lay_rng / 64 % 100000) as f32 / 100000.0
}

lay_pick(n: int): int {
    mini((lay_rand() * n as f32) as int, n - 1)
}

// Rails wait for the hill (and its cliffs) to be known: x, where they run,
// their heights above the hill, and their kind (0 a rail, 1 a box, 2 a
// flat-down rail).
type RailSpec = {
    x: f32;
    d0: f32;
    d1: f32;
    h0: f32;
    h1: f32;
    kind: int
}

const MAX_SPECS: int = 40;

specs: []RailSpec = new RailSpec[MAX_SPECS](RailSpec {
    x: 0.0,
    d0: 0.0,
    d1: 0.0,
    h0: 0.0,
    h1: 0.0,
    kind: 0
});

nspecs: int = 0;

add_spec(
    x: f32,
    d0: f32,
    d1: f32,
    h0: f32,
    h1: f32,
    kind: int
) {
    if (nspecs >= MAX_SPECS) return;
    specs[nspecs] = RailSpec {
        x: x,
        d0: d0,
        d1: d1,
        h0: h0,
        h1: h1,
        kind: kind
    };
    nspecs = nspecs + 1
}

const SECT_KICKERS: int = 0;

const SECT_RAILS: int = 1;

const SECT_PIPE: int = 2;

const SECT_CLIFF: int = 3;

const SECT_GAP: int = 4;

const SECT_ROLLERS: int = 5;

const SECT_WALL: int = 6;

const SECT_WALLS: int = 7;

const SECT_LEDGE: int = 8;

const SECT_KINDS: int = 9;

// The sections laid out: their kinds, where they begin and end, and the
// lanes through them (x of each, up to three), for anyone planning a
// line down the course.
const MAX_SECTS: int = 16;

sect_kind: []int = new int[MAX_SECTS](0);

sect_d0: []f32 = new f32[MAX_SECTS](0.0);

sect_d1: []f32 = new f32[MAX_SECTS](0.0);

sect_nlanes: []int = new int[MAX_SECTS](0);

sect_lane: []f32 = new f32[MAX_SECTS * 3](0.0);

nsects: int = 0;

// Lanes: those of the features (or rails) laid out since first.
note_lanes(s: int, first_feature: int, first_spec: int) {
    n: int = 0;
    for i in first_feature..nfeatures {
        f: Feature = features[i];
        if (n < 3 && (f.kind == FEATURE_KICKER || f.kind == FEATURE_GAP || f.kind == FEATURE_LEDGE)) {
            sect_lane[s * 3 + n] = f.x;
            n = n + 1
        }
    }
    for i in first_spec..nspecs {
        if (n < 3) {
            sect_lane[s * 3 + n] = specs[i].x;
            n = n + 1
        }
    }
    if (n == 0) {
        sect_lane[s * 3] = 0.0;
        n = 1
    }
    sect_nlanes[s] = n
}

kicker_len(h: f32): f32 {
    9.2 + 6.4 * h
}

kicker_heights: []f32 = [1.0, 1.6, 2.2, 2.8];

// Kickers in one, two, or three lanes, of different sizes.
lay_kickers(d: f32, room: f32): f32 {
    lanes: int = 1 + lay_pick(3);
    if (lanes == 1) {
        h: f32 = kicker_heights[1 + lay_pick(3)];
        if (kicker_len(h) > room) return -1.0;
        add_kicker(0.0, d, 3.5, h);
        // Beside it, a box or a rail.
        x: f32 = 8.0;
        if (lay_rand() < 0.5) x = -8.0;
        add_spec(x, d + 1.5, d + kicker_len(h) - 1.5, 0.2, 0.3 + lay_rand() * 0.3,
            lay_pick(2));
        return kicker_len(h)
    }
    if (lanes == 2) {
        a: int = lay_pick(3);
        b: int = (a + 1 + lay_pick(2)) % 3;
        ha: f32 = kicker_heights[a];
        hb: f32 = kicker_heights[b];
        len: f32 = maxf(kicker_len(ha), kicker_len(hb));
        if (len > room) return -1.0;
        side: f32 = 1.0;
        if (lay_rand() < 0.5) side = -1.0;
        add_kicker(-5.5 * side, d, 2.4, ha);
        add_kicker(5.5 * side, d + lay_rand() * 3.0, 2.4, hb);
        // Between them, a low box.
        add_spec(0.0, d + 2.0, d + len - 1.0, 0.2, 0.35, 1);
        return len + 3.0
    }
    len3: f32 = kicker_len(1.6);
    if (len3 > room) return -1.0;
    for k in 0..3 {
        h3: f32 = kicker_heights[lay_pick(2)];
        add_kicker((k - 1) as f32 * 7.0, d + lay_rand() * 2.0, 1.7, h3)
    }
    len3 + 2.0
}

// Two or three lanes of rails and boxes.
lay_rails(d: f32, room: f32): f32 {
    if (room < 20.0) return -1.0;
    lanes: int = 2 + lay_pick(2);
    gap: f32 = 11.0;
    if (lanes == 3) gap = 6.5;
    longest: f32 = 0.0;
    for k in 0..lanes {
        x: f32 = (k as f32 - (lanes - 1) as f32 * 0.5) * gap;
        len: f32 = 11.0 + lay_rand() * 6.0;
        d0: f32 = d + lay_rand() * 2.0;
        kind: int = lay_pick(3);
        if (kind == 1) add_spec(x, d0, d0 + len, 0.2, 0.3 + lay_rand() * 0.2, 1) else if (kind == 2) add_spec(x,
            d0, d0 + len, 0.3, 0.0, 2) else add_spec(x, d0, d0 + len, 0.25, 0.4 + lay_rand() * 0.4,
            0);
        longest = maxf(longest, d0 + len - d)
    }
    // Between two lanes, a small kicker.
    if (lanes == 2) add_kicker(0.0, d + 3.0, 1.7, 1.0);
    longest + 2.0
}

lay_pipe(d: f32, room: f32): f32 {
    len: f32 = 40.0 + lay_rand() * 16.0;
    if (len > room) return -1.0;
    add_feature(FEATURE_PIPE, 0.0, d, COURSE_HALF, pipe_wall(pipe_top()), len, 0.0,
        0.0);
    len
}

lay_cliff(d: f32, room: f32): f32 {
    h: f32 = 2.5 + lay_rand() * 2.0;
    c: f32 = 7.0 + 1.5 * h;
    len: f32 = 0.8 + c + 4.0;
    if (len > room) return -1.0;
    add_feature(FEATURE_CLIFF, 0.0, d, COURSE_HALF + 4.0, h, 0.8, 0.0, c);
    len
}

// A gap in one lane; a small kicker in the other, the safer way.
lay_gap(d: f32, room: f32): f32 {
    h: f32 = 1.8 + lay_rand() * 0.5;
    a: f32 = 2.2 + 1.2 * h;
    b: f32 = 2.5 + lay_rand() * 2.0;
    c: f32 = 6.0 + 4.0 * h;
    len: f32 = a + LIP_GAP + b + GAP_FACE + c;
    if (len > room) return -1.0;
    side: f32 = 1.0;
    if (lay_rand() < 0.5) side = -1.0;
    add_feature(FEATURE_GAP, 5.5 * side, d, 2.4, h, a, b, c);
    add_kicker(-5.5 * side, d + 2.0, 2.4, 1.0);
    len
}

lay_rollers(d: f32, room: f32): f32 {
    wave: f32 = 6.0 + lay_rand() * 1.5;
    n: f32 = (2 + lay_pick(2)) as f32;
    if (wave * n > room) return -1.0;
    add_feature(FEATURE_ROLLERS, 0.0, d, COURSE_HALF + 3.0, 0.4 + lay_rand() * 0.25,
        wave, n, 0.0);
    wave * n
}

// How high a ledge stands: out of reach of an ollie, even one down the
// hill, which falls away under it.
const LEDGE_H: f32 = 2.2;

// A wall up one side of the run, the rest of it open; across from it, a
// ledge to kick off the wall onto.
lay_wall(d: f32, room: f32): f32 {
    len: f32 = 38.0 + lay_rand() * 10.0;
    if (len > room) return -1.0;
    side: f32 = 1.0;
    if (lay_rand() < 0.5) side = -1.0;
    add_feature(FEATURE_WALL, 0.0, d, 3.0, wall_rise(wall_top()), len, side, 0.0);
    ledge: f32 = 15.0 + lay_rand() * 4.0;
    add_feature(FEATURE_LEDGE, -side * 4.5, d + 16.0, 2.0, LEDGE_H, ledge, 0.0, 0.0);
    len
}

// Two walls facing each other across the run, to kick back and forth
// between.
lay_walls(d: f32, room: f32): f32 {
    len: f32 = 40.0 + lay_rand() * 12.0;
    if (len > room) return -1.0;
    add_feature(FEATURE_WALL, 0.0, d, 4.5, wall_rise(wall_top()), len, 0.0, 0.0);
    len
}

// A kicker in one lane, short and steep, up onto a ledge past it; in the
// other, a rail or a box.
lay_ledge(d: f32, room: f32): f32 {
    h: f32 = 1.2 + lay_rand() * 0.4;
    a: f32 = 2.2 + 1.2 * h;
    ledge: f32 = 14.0 + lay_rand() * 4.0;
    from: f32 = a + LIP_GAP + 0.3 + 1.6 + 2.5;
    len: f32 = from + ledge;
    if (len > room) return -1.0;
    side: f32 = 1.0;
    if (lay_rand() < 0.5) side = -1.0;
    add_feature(FEATURE_KICKER, side * 5.0, d, 2.0, h, a, 0.3, 1.6);
    add_feature(FEATURE_LEDGE, side * 5.0, d + from, 2.2, LEDGE_H, ledge, 0.0, 0.0);
    add_spec(-side * 5.0, d + 2.0, d + len - 2.0, 0.25, 0.4 + lay_rand() * 0.3, lay_pick(2));
    len
}

lay_section(kind: int, d: f32, room: f32): f32 {
    if (kind == SECT_WALL) return lay_wall(d, room);
    if (kind == SECT_WALLS) return lay_walls(d, room);
    if (kind == SECT_LEDGE) return lay_ledge(d, room);
    if (kind == SECT_KICKERS) return lay_kickers(d, room);
    if (kind == SECT_RAILS) return lay_rails(d, room);
    if (kind == SECT_PIPE) return lay_pipe(d, room);
    if (kind == SECT_CLIFF) return lay_cliff(d, room);
    if (kind == SECT_GAP) return lay_gap(d, room);
    lay_rollers(d, room)
}

// Big air: one jump, as big as can be. Its places are numbered from
// BIG_AIR_BASE (big air 3 is BIG_AIR_BASE + 3). Down a steep drop-in to a
// kicker far taller and steeper than any on a course, standing on a shelf
// of the hill with its landing; then a short run-out to the finish.
const BIG_AIR_BASE: int = 200000000;

in_big_air(): bool {
    course_seed >= BIG_AIR_BASE && course_seed < BIG_AIR_BASE + 100000000 && !park
}

// Whether this place is big air (set as it is loaded); where its kicker's
// ramp begins, and its lip; the drop-in's grade, the shelf's, and the
// landing hill's; where the landing ends; and its finish.
big_air: bool = false;

const BIG_AIR_KICK: f32 = 84.0;

big_air_lip: f32 = 90.0;

const BIG_AIR_DROP: f32 = 0.6;

const BIG_AIR_SHELF: f32 = 0.05;

const BIG_AIR_LAND: f32 = 0.55;

big_air_out: f32 = 150.0;

const BIG_AIR_FINISH: f32 = 200.0;

lay_big_air() {
    nfeatures = 0;
    ncrails = 0;
    nspecs = 0;
    nsects = 0;
    lay_rng = course_seed * 7919 + 13;
    // The kicker: its lip's height, and a ramp steep for it (see
    // add_kicker for a course's), a short table, and a long landing (which
    // the hill falls away under: see big_air_grade).
    h: f32 = 4.5 + lay_rand() * 1.0;
    ff: int = nfeatures;
    add_feature(FEATURE_KICKER, 0.0, BIG_AIR_KICK, 5.0, h, h * 1.1, 1.0 + h, 14.0 + h * 5.0);
    big_air_lip = BIG_AIR_KICK + h * 1.1;
    big_air_out = BIG_AIR_KICK + feature_len(features[ff]) + 6.0;
    tutorial_section(SECT_KICKERS, BIG_AIR_KICK, BIG_AIR_KICK + feature_len(features[ff]),
        ff, nspecs)
}

// Whether he rides on the moon, where he hangs in the air longer (see
// air_pace, in slope.l8): any place but the tutorial's may be ridden
// there.
moon: bool = false;

// A board: a place, and whether it is ridden on the moon, as one number,
// as the page and the leaderboards number them (see
// web/skate/boards.js): its scores, best lines and replays are the
// board's. On the earth, the place's own number (a course's, or a park's,
// negative); on the moon, that moved MOON_BOARD further from 0 (Haystack
// on the moon is 1000000001, and park 2 there -1000000002). Every place's
// number is less than MOON_BOARD from 0.
const MOON_BOARD: int = 1000000000;

board_of(place: int, on_moon: bool): int {
    if (on_moon) return signi(place) * (MOON_BOARD + absi(place));
    place
}

board_place(board: int): int {
    signi(board) * (absi(board) % MOON_BOARD)
}

board_on_moon(board: int): bool {
    absi(board) >= MOON_BOARD
}

// Lay out the course for course_seed: sections one after another down the
// run, never the same kind twice running and at most one of each of the
// big ones (see sect_once), until the finish; then the hill, and then the
// rails on it.
load_course() {
    big_air = in_big_air();
    course_finish = COURSE_FINISH;
    if (big_air) course_finish = BIG_AIR_FINISH;
    if (in_tutorial()) course_finish = tutorial_finish();
    terrain_finish = course_finish;
    if (in_tutorial()) terrain_finish = COURSE_FINISH;
    if (in_tutorial()) lay_tutorial() else if (big_air) lay_big_air() else lay_sections();
    build_bins();
    load_base();
    place_lamps();
    breathe();
    for i in 0..nspecs {
        r: RailSpec = specs[i];
        if (r.kind == 2) add_kink(r.x, r.d0, r.d0 + 2.5, r.d1, r.h0) else add_rail(r.x,
            r.d0, r.d1, r.h0, r.h1, r.kind == 1)
    }
}

// The kinds of section a course has one of at the most: a halfpipe, a
// cliff, a wall, two walls, a ledge.
sect_once(kind: int): bool {
    kind == SECT_PIPE || kind == SECT_CLIFF || kind == SECT_WALL || kind == SECT_WALLS || kind == SECT_LEDGE
}

// The sections of the course for course_seed, and what is in them (but not
// yet the hill they stand on).
lay_sections() {
    nfeatures = 0;
    ncrails = 0;
    nspecs = 0;
    nsects = 0;
    lay_rng = course_seed * 7919 + 13;
    d: f32 = 26.0;
    last: int = -1;
    laid: []int = new int[SECT_KINDS](0);
    tries: int = 0;
    while (tries < 40 && d < course_finish - 14.0) {
        tries = tries + 1;
        kind: int = lay_pick(SECT_KINDS);
        // The first is something gentle.
        if (last < 0 && kind != SECT_RAILS && kind != SECT_KICKERS) kind = SECT_RAILS;
        ok: bool = kind != last && !(sect_once(kind) && laid[kind] > 0);
        if (ok) {
            ff: int = nfeatures;
            fs: int = nspecs;
            len: f32 = lay_section(kind, d, course_finish - 8.0 - d);
            if (len > 0.0 && nsects < MAX_SECTS) {
                sect_kind[nsects] = kind;
                sect_d0[nsects] = d;
                sect_d1[nsects] = d + len;
                note_lanes(nsects, ff, fs);
                nsects = nsects + 1;
                laid[kind] = laid[kind] + 1;
                last = kind;
                d = d + len + 5.0 + lay_rand() * 4.0
            }
        }
    }
}
