tag skate;

// Replays. A run is the same every time from the same start with the same
// keys, so a replay is only what he was told at each step, played back.
// The run under way is recorded as it goes; when it finishes it is kept as
// the last run, and as the best if it scored most on this course. Either
// can be watched again, from cameras beside the run (see main.l8).
const MAX_REC: int = 18000;

// Three recordings: the run under way, the last finished, and the best.
const REC_NOW: int = 0;

const REC_LAST: int = 1;

const REC_BEST: int = 2;

rec_stick: []f32 = new f32[3 * MAX_REC](0.0);

rec_aim_x: []f32 = new f32[3 * MAX_REC](0.0);

rec_aim_y: []f32 = new f32[3 * MAX_REC](0.0);

// The keys held and the pad's edges, a bit each.
rec_bits: []int = new int[3 * MAX_REC](0);

// How many steps each holds, the course it is of (or -1), and its score.
rec_n: []int = [0, 0, 0];

rec_seed: []int = [-1, -1, -1];

rec_score: []int = [0, 0, 0];

// How he stood when each began.
rec_start: []*Mover = [new_mover(), new_mover(), new_mover()];

// Whether the run under way has finished (and so is worth keeping), and
// how many steps past its finish are recorded.
rec_done: bool = false;

rec_after: int = 0;

// Playing one back: which (or -1), and the step it is at.
play_which: int = -1;

play_i: int = 0;

// A new run begins from how he stands: the one before it, if it finished,
// is kept.
rec_begin(m: *Mover) {
    rec_keep();
    rec_n[REC_NOW] = 0;
    rec_seed[REC_NOW] = course_seed;
    rec_start[REC_NOW].* = m.*;
    rec_done = false;
    rec_after = 0
}

// Keep the run under way, if it finished: as the last, and as the best if
// it is.
rec_keep() {
    if (!rec_done || rec_n[REC_NOW] == 0) return;
    rec_copy(REC_NOW, REC_LAST);
    if (rec_seed[REC_BEST] != rec_seed[REC_NOW] || rec_score[REC_NOW] > rec_score[REC_BEST]) rec_copy(REC_NOW,
        REC_BEST);
    rec_done = false;
    rec_n[REC_NOW] = 0
}

rec_copy(from: int, to: int) {
    n: int = rec_n[from];
    for i in 0..n {
        rec_stick[to * MAX_REC + i] = rec_stick[from * MAX_REC + i];
        rec_aim_x[to * MAX_REC + i] = rec_aim_x[from * MAX_REC + i];
        rec_aim_y[to * MAX_REC + i] = rec_aim_y[from * MAX_REC + i];
        rec_bits[to * MAX_REC + i] = rec_bits[from * MAX_REC + i]
    }
    rec_n[to] = n;
    rec_seed[to] = rec_seed[from];
    rec_score[to] = rec_score[from];
    rec_start[to].* = rec_start[from].*
}

// The recordings of another course are no use on this one.
rec_forget() {
    for k in 0..3 {
        rec_n[k] = 0;
        rec_seed[k] = -1
    }
    rec_done = false;
    play_which = -1
}

// What he is told this step, into the run under way (for a few seconds past
// its finish, to see him stop).
rec_step(m: *Mover, keys: *Keys) {
    if (rec_done) {
        rec_after = rec_after + 1;
        if (rec_after > 120 * 4) return
    }
    n: int = rec_n[REC_NOW];
    if (n >= MAX_REC) return;
    bits: int = 0;
    if (keys.stick_on) bits = bits | 1;
    // (Past the finish the pad is left out: there, it starts him over.)
    if (!rec_done) {
        if (keys.pad_held) bits = bits | 2;
        if (keys.pad_press) bits = bits | 4;
        if (keys.pad_release) bits = bits | 8;
        if (keys.hop_held) bits = bits | 16
    }
    if (keys.style_held) bits = bits | 32;
    for d in 0..4 {
        if (keys.held[d]) bits = bits | 64 << d
    }
    rec_stick[n] = keys.stick_x;
    rec_aim_x[n] = keys.aim_x;
    rec_aim_y[n] = keys.aim_y;
    rec_bits[n] = bits;
    rec_n[REC_NOW] = n + 1
}

// After a step: the run is done once he is past the finish, with its score.
rec_note(m: *Mover) {
    if (m.finished && !rec_done) {
        rec_done = true;
        rec_after = 0
    }
    if (m.finished) rec_score[REC_NOW] = run.total
}

// Whether recording which can be watched: it is of this course.
can_play(which: int): bool {
    rec_n[which] > 0 && rec_seed[which] == course_seed
}

// Start playing recording which back: he stands as he did when it began.
play_begin(m: *Mover, which: int) {
    play_which = which;
    play_i = 0;
    m.* = rec_start[which].*;
    clear_run()
}

// The next step's keys from the recording; false when it has run out.
play_step(keys: *Keys): bool {
    w: int = play_which;
    if (w < 0 || play_i >= rec_n[w]) return false;
    k: int = w * MAX_REC + play_i;
    bits: int = rec_bits[k];
    keys.stick_on = (bits & 1) != 0;
    keys.pad_held = (bits & 2) != 0;
    keys.pad_press = (bits & 4) != 0;
    keys.pad_release = (bits & 8) != 0;
    keys.hop_held = (bits & 16) != 0;
    keys.style_held = (bits & 32) != 0;
    for d in 0..4 keys.held[d] = (bits & 64 << d) != 0;
    keys.stick_x = rec_stick[k];
    keys.aim_x = rec_aim_x[k];
    keys.aim_y = rec_aim_y[k];
    keys.hop = false;
    keys.style = false;
    play_i = play_i + 1;
    true
}
