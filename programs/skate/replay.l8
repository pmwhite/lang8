tag skate;

use_tag std;

// Replays. A run is the same every time, on every device, from the top of
// the same course with the same keys (the math is the game's own: see
// math.l8), so a replay is only what he was told at each step, played
// back. The run under way is recorded as it goes; when it finishes it is
// kept as the last run, and as the best if it scored most on this course.
// Either can be watched again, from cameras beside the run (see main.l8);
// and so can a friend's, which the page hands over as text (see
// web/skate/skate.js, and the leaderboard it keeps them on).
const MAX_REC: int = 18000;

// The recordings: the run under way, the last finished, the best, and a
// friend's.
const REC_NOW: int = 0;

const REC_LAST: int = 1;

const REC_BEST: int = 2;

const REC_FRIEND: int = 3;

const REC_SLOTS: int = 4;

// A replay is only good for the game whose rules it was ridden by: this
// goes up whenever a change to them would make an old one come out
// differently.
const REPLAY_VERSION: int = 3;

// What he was told at each step, packed into a number: the keys held and
// the pad's edges, a bit each (see rec_step); how hard the steering thumb
// leans him, in 512ths, from bit 10; and the trick aimed, its half turns
// from bit 21 and its flips from bit 25.
rec_v: []int = new int[REC_SLOTS * MAX_REC](0);

// How many steps each holds, where it is of (a course's number, or a
// park's, negative: see run_id; or 0), and its score.
rec_n: []int = [0, 0, 0, 0];

rec_seed: []int = [0, 0, 0, 0];

rec_score: []int = [0, 0, 0, 0];

// Whether the run under way has finished (and so is worth keeping), and
// how many steps past its finish are recorded; whether the page has been
// told of it (see rec_tell).
rec_done: bool = false;

rec_after: int = 0;

rec_said: bool = false;

// A finished run the page has yet to be told of: which recording (or -1).
rec_tell: int = -1;

// Nothing is recorded from when a replay starts until his next run does:
// what follows a replay is not a run of his.
rec_off: bool = false;

// Playing one back: which (or -1), and the step it is at.
play_which: int = -1;

play_i: int = 0;

// A new run begins: the one before it, if it finished, is kept.
rec_begin() {
    rec_keep();
    rec_n[REC_NOW] = 0;
    rec_seed[REC_NOW] = run_id();
    rec_done = false;
    rec_said = false;
    rec_off = false;
    rec_after = 0
}

// Keep the run under way, if it finished: as the last, and as the best if
// it is.
rec_keep() {
    if (!rec_done || rec_n[REC_NOW] == 0) return;
    rec_copy(REC_NOW, REC_LAST);
    // (Started over before its score closed: it is as it stood.)
    if (!rec_said) rec_tell = REC_LAST;
    rec_said = true;
    if (rec_seed[REC_BEST] != rec_seed[REC_NOW] || rec_score[REC_NOW] > rec_score[REC_BEST]) rec_copy(REC_NOW,
        REC_BEST);
    rec_done = false;
    rec_n[REC_NOW] = 0
}

rec_copy(from: int, to: int) {
    n: int = rec_n[from];
    for i in 0..n rec_v[to * MAX_REC + i] = rec_v[from * MAX_REC + i];
    rec_n[to] = n;
    rec_seed[to] = rec_seed[from];
    rec_score[to] = rec_score[from]
}

// His own recordings of another course are no use on this one.
rec_forget() {
    for k in 0..REC_FRIEND {
        rec_n[k] = 0;
        rec_seed[k] = 0
    }
    rec_done = false;
    play_which = -1
}

// What he is told this step, into the run under way (for a few seconds past
// its finish, to see him stop).
rec_step(keys: *Keys) {
    if (rec_off) return;
    // (As long as it scores, and a little more: see FINISH_TAIL.)
    if (rec_done) {
        rec_after = rec_after + 1;
        if (rec_after as f32 * STEP_DT > FINISH_TAIL + 0.5) return
    }
    n: int = rec_n[REC_NOW];
    if (n >= MAX_REC) return;
    bits: int = 0;
    if (keys.stick_on) bits = bits | 1;
    if (keys.pad_held) bits = bits | 2;
    if (keys.pad_press) bits = bits | 4;
    if (keys.pad_release) bits = bits | 8;
    if (keys.hop_held) bits = bits | 16;
    if (keys.style_held) bits = bits | 32;
    for d in 0..4 {
        if (keys.held[d]) bits = bits | 64 << d
    }
    lean: int = clampi((keys.stick_x * 512.0) as int, -512, 512) + 512;
    rec_v[n] = bits | lean << 10 | whole_aim(keys.aim_x) + 8 << 21 | whole_aim(keys.aim_y) + 8 << 25;
    rec_n[REC_NOW] = n + 1
}

// The step just recorded started him over instead (a tap at the finish):
// it is no part of the run. (So no recording has such a tap in it, and
// playing one back never starts him over.)
rec_drop() {
    if (rec_n[REC_NOW] > 0 && rec_after as f32 * STEP_DT <= FINISH_TAIL + 0.5) rec_n[REC_NOW] = rec_n[REC_NOW] - 1
}

// The whole turns an aim comes to (all that the pad's aim counts for).
whole_aim(a: f32): int {
    clampi(trunc_toward_zero(a), -7, 7)
}

// After a step: the run is done once he is past the finish, with its score.
rec_note(m: *Mover) {
    if (rec_off) return;
    if (m.finished && !rec_done) {
        rec_done = true;
        rec_after = 0
    }
    if (m.finished) rec_score[REC_NOW] = run.total
}

// Whether recording which can be watched: it is of this course.
can_play(which: int): bool {
    rec_n[which] > 0 && rec_seed[which] == run_id()
}

// Start playing recording which back, from the top.
play_begin(m: *Mover, which: int) {
    play_which = which;
    play_i = 0;
    rec_off = true;
    rec_done = false;
    rec_n[REC_NOW] = 0;
    start_over(m)
}

// The next step's keys from the recording; false when it has run out.
play_step(keys: *Keys): bool {
    w: int = play_which;
    if (w < 0 || play_i >= rec_n[w]) return false;
    v: int = rec_v[w * MAX_REC + play_i];
    keys.stick_on = (v & 1) != 0;
    keys.pad_held = (v & 2) != 0;
    keys.pad_press = (v & 4) != 0;
    keys.pad_release = (v & 8) != 0;
    keys.hop_held = (v & 16) != 0;
    keys.style_held = (v & 32) != 0;
    for d in 0..4 keys.held[d] = (v & 64 << d) != 0;
    keys.stick_x = ((v >> 10 & 2047) - 512) as f32 / 512.0;
    keys.aim_x = ((v >> 21 & 15) - 8) as f32;
    keys.aim_y = ((v >> 25 & 15) - 8) as f32;
    keys.hop = false;
    keys.style = false;
    play_i = play_i + 1;
    true
}

// ---- as text ----
// A recording as text, for the page to keep and pass on: runs of the same
// step, each "count.value" in base 36, one after another.
digits: str = "0123456789abcdefghijklmnopqrstuvwxyz";

text_out: []i8 = new i8[16](0i8);

write_36(n: int) raises IoError {
    k: int = 0;
    v: int = n;
    while (v > 0 || k == 0) {
        text_out[k] = digits[v % 36];
        v = v / 36;
        k = k + 1
    }
    // (Its digits came out backward.)
    for i in 0..k / 2 {
        t: i8 = text_out[i];
        text_out[i] = text_out[k - 1 - i];
        text_out[k - 1 - i] = t
    }
    write_bytes_n(1, text_out, k)
}

// Recording which, written out.
rec_write(which: int) raises IoError {
    n: int = rec_n[which];
    at: int = which * MAX_REC;
    i: int = 0;
    while (i < n) {
        j: int = i;
        while (j < n && rec_v[at + j] == rec_v[at + i]) j = j + 1;
        write_36(j - i);
        write(1, ".");
        write_36(rec_v[at + i]);
        write(1, " ");
        i = j
    }
}

// A friend's recording, from text: "version seed score" in tens, then its
// runs. False if it is not one this game can play. Their name, for the
// replay's banner.
friend_name: []i8 = new i8[16](0i8);

friend_len: int = 0;

rec_read(text: []i8, n: int): bool {
    at: int = 0;
    version: int = read_number(text, n, &at, 10);
    seed: int = read_number(text, n, &at, 10);
    score: int = read_number(text, n, &at, 10);
    if (version != REPLAY_VERSION || seed == 0) return false;
    // Their name, up to the next space.
    while (at < n && text[at] as int == 32) at = at + 1;
    friend_len = 0;
    while (at < n && text[at] as int != 32) {
        if (friend_len < len(friend_name)) {
            c: int = text[at] as int;
            // (An underscore stands for a space in it.)
            if (c == 95) c = 32;
            friend_name[friend_len] = c trunc i8;
            friend_len = friend_len + 1
        }
        at = at + 1
    }
    steps: int = 0;
    while (at < n && steps < MAX_REC) {
        count: int = read_number(text, n, &at, 36);
        if (at >= n || text[at] as int != 46) at = n else {
            at = at + 1;
            v: int = read_number(text, n, &at, 36);
            for _k in 0..count {
                if (steps < MAX_REC) {
                    rec_v[REC_FRIEND * MAX_REC + steps] = v;
                    steps = steps + 1
                }
            }
        }
    }
    if (steps == 0) return false;
    rec_n[REC_FRIEND] = steps;
    rec_seed[REC_FRIEND] = seed;
    rec_score[REC_FRIEND] = score;
    true
}

// The number at text[at.*] in the given base (after any spaces), moving
// at.* past it.
read_number(
    text: []i8,
    n: int,
    at: *int,
    base: int
): int {
    i: int = at.*;
    while (i < n && (text[i] as int == 32 || text[i] as int == 10)) i = i + 1;
    // (A park's number is negative.)
    sign: int = 1;
    if (i < n && text[i] as int == 45 && base == 10) {
        sign = -1;
        i = i + 1
    }
    v: int = 0;
    more: bool = true;
    while (i < n && more) {
        c: int = text[i] as int;
        d: int = -1;
        if (c >= 48 && c <= 57) d = c - 48;
        if (c >= 97 && c <= 122) d = c - 97 + 10;
        if (d < 0 || d >= base) more = false else {
            v = v * base + d;
            i = i + 1
        }
    }
    at.* = i;
    sign * v
}

extern open(path: str, flags: int, mode: int): int;

extern close(fd: int): int;

watch_text: []i8 = new i8[262144](0i8);

// The page has left a friend's run in the file watch.txt (and pressed V):
// read it. True if it is one this game can play.
read_watch(): bool {
    fd: int = open("watch.txt", 0, 0);
    if (fd < 0) return false;
    n: int = 0;
    more: bool = true;
    while (more && n < len(watch_text)) {
        r: int = read(fd, watch_text, n, len(watch_text) - n);
        if (r <= 0) more = false else n = n + r
    }
    close(fd);
    rec_read(watch_text, n)
}
