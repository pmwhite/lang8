tag skate;

// Riding down the slope course, by a few rules:
//
// - Gravity along the way he heads speeds him up downhill and slows him
//   going up; the board's rolling and the air hold him back, more the
//   faster he goes, and turning sheds a little speed. Pointed down the
//   hill he runs fast; across it, he slows. Nearly stopped, he pushes.
// - Left and right turn him across the run, and he keeps going the way he
//   points; the banks turn him back in.
// - The trick pad (see touch.l8) crouches him while held, aiming a trick:
//   flips forward or back, half turns either way. Letting go jumps into
//   it, there and then: off the ground, off a rail, or up a kicker's ramp,
//   best at its lip. In the air, pressed again, it grabs.
// - The trick fits the air: he turns as fast as he must to finish it just
//   before he lands, and if even his fastest is not enough, he doesn't
//   finish it. So a small trick lands from a sloppy jump, and a big one
//   only from a jump timed right.
// - Taking off, only the slope along the run throws him up: riding off the
//   side of a kicker does not.
// - Coming down on a rail or box, or riding into its low end, he grinds it.
// - Landing the trick he went for scores it (see judge.l8); landing
//   crooked is sketchy, and scores nothing. He never falls.
const SLOPE_G: f32 = 16.0;

// What holds him back: rolling, as a fraction of his weight; the air, per
// speed squared; and turning, per radian a second, per speed.
const ROLL_FRICTION: f32 = 0.03;

const AIR_DRAG: f32 = 0.017;

const TURN_DRAG: f32 = 0.12;

// Slower than this, he pushes along; never faster than the top.
const PUSH_SPEED: f32 = 3.0;

const SLOPE_PUSH: f32 = 3.0;

const TOP_SPEED: f32 = 18.0;

// Past the finish, he drags a foot to stop.
const BRAKE: f32 = 4.0;

const LESSON_BRAKE: f32 = 16.0;

// Riding a round together, how far he has fallen behind the pack (m: see
// round_tick, in rounds.l8): he pushes along to catch up, the harder the
// further behind, up to PACE_PUSH.
behind_pace: f32 = 0.0;

const PACE_PUSH: f32 = 3.0;

const PACE_FAR: f32 = 20.0;

// How far he may turn across the run, how fast he turns at the most, and
// how hard the banks turn him back.
const CARVE_LIMIT: f32 = 1.35;

const STEER_RATE: f32 = 2.2;

// How quickly his turning follows the steering (a spring, critically
// damped: half way in an eighth of a second), and the most a turn pulls
// him round (m/s/s, his speed times how fast he turns): as much as
// leaning 50 degrees into it holds him up against SLOPE_G (16 tan 50).
const STEER_OMEGA: f32 = 14.0;

const GRIP_ACCEL: f32 = 19.0;

// How quickly what he feels on the ground settles (/s): the ground's
// heights are a little rough from one step to the next.
const FELT_EASE: f32 = 25.0;

// How far either side of straight down the hill the steering thumb at the
// end of its track aims him.
const AIM_MAX: f32 = 1.2;

// How far out he can go either way: to the fence up each bank (see
// FENCE_OUT: 11 + 3.2), less his half width.
const SIDE_LIMIT: f32 = 13.8;

const OLLIE_SPEED: f32 = 5.0;

// Up a kicker's ramp (or just off its lip), which throws him already, a
// pop adds less.
const LIP_POP: f32 = 2.0;

// In the park, the steepest he rides up (but for the bowl's walls), and
// the steepest that throws him (a kicker's lip is about 1).
const STEEP_FACE: f32 = 1.6;

const STEEP_THROW: f32 = 1.3;

// The slowest he goes on the course, climbing what he can't push up (m/s).
const CLIMB_SPEED: f32 = 2.0;

const LATE_OLLIE: f32 = 0.15;

// How fast he turns, radians a second: at the most, and at the least, so
// that a trick in a big air does not dawdle; and how long before landing
// a trick should be done.
const FLIP_MAX: f32 = 13.0;

const SPIN_MAX: f32 = 16.0;

const FLIP_MIN: f32 = 6.0;

const SPIN_MIN: f32 = 8.0;

const FIT_MARGIN: f32 = 0.15;

// The speed he pumps up to in a halfpipe.
const PIPE_PUMP: f32 = 9.5;

in_pipe(d: f32): bool {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_PIPE && d > f.d + 4.0 && d < f.d + f.a - 4.0) return true
    }
    false
}

// On the moon, time in the air passes at this pace: he flies the same
// arc as here, as slowly, but turns as fast as ever, so a bigger trick
// fits. (As if he fell by MOON_AIR_PACE squared of SLOPE_G, flying at
// MOON_AIR_PACE of his speed.)
const MOON_AIR_PACE: f32 = 0.6;

air_pace(): f32 {
    if (moon) return MOON_AIR_PACE;
    1.0
}

// How much slower he turns while grabbing.
const GRAB_SLOW: f32 = 0.7;

// How near upright (or lined up, for a spin) a landing must be, in radians.
const LAND_TOL: f32 = 0.55;

const RAIL_MAGNET: f32 = 0.4;

const BOX_MAGNET: f32 = 0.55;

// Points a second for a grind.
const GRIND_POINTS: f32 = 150.0;

// From the top of the course, or the park's near end.
start_over(m: *Mover) {
    if (park) enter_park(m) else enter_course(m)
}

// How many times a run has been started (so that who steps him can tell
// when a step started one over).
course_starts: int = 0;

// Start (or start over) at the top of the run.
enter_course(m: *Mover) {
    course_starts = course_starts + 1;
    reset_mover(m);
    m.x = 0.0;
    // (A lesson of the tutorial starts part way down: see lesson_start.)
    start: f32 = COURSE_START;
    if (in_tutorial()) start = tutorial_start();
    m.z = -(start + 7.0);
    m.y = course_height(m.x, m.z);
    m.prev = v3(m.x, m.y, m.z);
    m.carve = 0.0;
    m.speed = PUSH_SPEED;
    m.heading = PI;
    m.finished = false;
    m.finish_t = 0.0;
    m.sketch_t = 10.0;
    m.crail = -1;
    m.pad_grab = false;
    clear_run()
}

key_axis(keys: *Keys, pos: int, neg: int): f32 {
    a: f32 = 0.0;
    if (keys.held[pos]) a = a + 1.0;
    if (keys.held[neg]) a = a - 1.0;
    a
}

carve_dir(c: f32): V3 {
    v3(sinf(c), 0.0, -cosf(c))
}

// The ground's rise along d at (x, z), per unit across the ground.
rise_along(x: f32, z: f32, d: V3): f32 {
    e: f32 = 0.1;
    (course_height(x + d.x * e, z + d.z * e) - course_height(x - d.x * e, z - d.z * e)) / (2.0 * e)
}

step_course(m: *Mover, keys: *Keys, dt: f32) {
    m.prev = v3(m.x, m.y, m.z);
    m.since_hop = m.since_hop + dt;
    m.since_grind = m.since_grind + dt;
    m.sketch_t = m.sketch_t + dt;
    m.run_t = m.run_t + dt;
    if (m.finished) m.finish_t = m.finish_t + dt;
    if (m.finished && m.finish_t > FINISH_TAIL) run.closed = true;
    if (m.air) m.air_time = m.air_time + dt else m.air_time = 0.0;
    // The pad pressed in the air is a grab; otherwise he crouches, aiming.
    if (keys.pad_press) {
        keys.pad_press = false;
        m.pad_grab = m.air
    }
    m.winding = (keys.pad_held || keys.pad_release) && !m.pad_grab;
    if (m.winding) {
        m.aim_flips = aimed_flips(keys);
        m.aim_halves = aimed_halves(keys)
    }
    wx: f32 = 0.0;
    wy: f32 = 0.0;
    if (m.winding) {
        wx = clampf(m.aim_halves as f32 * 0.5, -1.0, 1.0);
        wy = clampf(m.aim_flips as f32, -1.0, 1.0)
    }
    m.wind_x = lerpf(m.wind_x, wx, ease(12.0, dt));
    m.wind_y = lerpf(m.wind_y, wy, ease(12.0, dt));
    if (keys.pad_release) {
        keys.pad_release = false;
        // At the finish a tap goes again; a drag (scrolling the report) does
        // not.
        // (Not in a round, which goes on to the next when it is over.)
        if (m.pad_grab) m.pad_grab = false else if (m.finished && !round_on) {
            if (m.finish_t > 2.0 && !m.air && absf(keys.aim_x) < 1.0 && absf(keys.aim_y) < 1.0) {
                start_over(m);
                return
            }
        } else release_trick(m);
        m.winding = false
    }
    if (m.grinding) step_course_grind(m, dt) else if (m.air) step_course_air(m, keys,
        dt) else step_course_ground(m, keys, dt);
    if (m.air || m.grinding) m.felt_on = false;
    // The run is over past the finish line; in a park, when its time is up.
    if (!m.finished && (!park && -m.z >= course_finish || park && m.run_t >= PARK_TIME)) {
        m.finished = true;
        m.finish_t = 0.0
    }
    tick_run(dt);
    if (m.finished) run.best_run = maxi(run.best_run, run.total);
    keys.hop = false;
    keys.style = false
}

trunc_toward_zero(a: f32): int {
    if (a < 0.0) return -floorf(-a) as int;
    floorf(a) as int
}

// The trick the pad aims at now (see read_aim and aim_key, in touch.l8):
// flips forward, and half turns to the right. (Held through a grab, it is
// the trick he winds up for as he lands.)
aimed_flips(keys: *Keys): int {
    clampi(trunc_toward_zero(keys.aim_y), -3, 3)
}

aimed_halves(keys: *Keys): int {
    clampi(trunc_toward_zero(keys.aim_x), -6, 6)
}

// Letting go of the pad: a jump into the trick aimed at.
release_trick(m: *Mover) {
    nf: int = m.aim_flips;
    nh: int = m.aim_halves;
    if (m.grinding) {
        leave_crail(m, OLLIE_SPEED, 0.0);
        start_trick(m, nf, nh)
    } else if (m.air) {
        late_ollie(m);
        start_trick(m, nf, nh)
    } else {
        pop(m, pop_speed(m.x, -m.z));
        start_trick(m, nf, nh)
    }
}

// How hard he pops at (x, d): up a kicker's ramp, which throws him
// already, less. (So the time to go is at its lip: earlier, the ramp is
// lower and less steep, and later, he has left it without a pop.)
pop_speed(x: f32, d: f32): f32 {
    if (kicker_at(x, d) >= 0) return LIP_POP;
    OLLIE_SPEED
}

// Popping, on top of how fast he was rising: no faster than rising up the
// steepest face that throws him (STEEP_THROW), not up a wall's side.
pop(m: *Mover, speed: f32) {
    m.vy = clampf(m.vy, 0.0, m.speed * STEEP_THROW) + speed;
    take_off(m);
    m.ollied = true;
    m.since_hop = 0.0
}

// Just off a lip, a jump still counts.
late_ollie(m: *Mover) {
    if (m.air_time < LATE_OLLIE && !m.ollied) {
        m.vy = m.vy + LIP_POP;
        m.ollied = true;
        m.since_hop = 0.0
    }
}

// How long until he comes down, flying as he is.
predict_air(m: *Mover): f32 {
    h: f32 = 1.0 / 60.0;
    x: f32 = m.x;
    y: f32 = m.y;
    z: f32 = m.z;
    vy: f32 = m.vy;
    t: f32 = 0.0;
    k: int = 0;
    while (k < 300) {
        vy = vy - SLOPE_G * h;
        x = x + m.vx * h;
        z = z + m.vz * h;
        y = y + vy * h;
        t = t + h;
        if (y <= course_height(x, z)) k = 300 else k = k + 1
    }
    t / air_pace()
}

// Into the air with nf flips (forward) and nh half turns (to the right),
// fitted to the air he has: as many as he can finish before he lands.
//
// He turns as fast as he must to finish just before he lands, but no
// faster than he can: a trick too big for the air does not finish, and he
// lands it sketchy.
//
// Flipping and spinning share him: a trick's flips and spins together must
// fit the air, each taking its share of his fastest turning. They are one
// turning of him, begun and ended together (see trick_share).
start_trick(m: *Mover, nf: int, nh: int) {
    if (!m.air) return;
    m.trick_set = true;
    m.trick_d = trick_time(nf, nh, predict_air(m));
    m.trick_t = 0.0;
    m.flip_from = m.flip;
    m.spin_from = m.spin;
    m.flip_goal = m.flip + nf as f32 * TAU;
    // To the right is clockwise seen from above.
    m.spin_goal = m.spin - nh as f32 * PI;
    // (How fast each turns, on the whole: for copies of him elsewhere, see
    // together.l8.)
    m.flip_w = 0.0;
    m.spin_w = 0.0;
    if (m.trick_d > 0.0) {
        m.flip_w = absi(nf) as f32 * TAU / m.trick_d;
        m.spin_w = absi(nh) as f32 * PI / m.trick_d
    }
}

// How long a trick of nf flips and nh half turns takes to turn, in an air
// `air` long: as long as fits the air (longer, if it is too big for it),
// but no longer than its bigger part, flips or spins, would take at its
// least rate (see FLIP_MIN). (0 if it has no turning.)
trick_time(nf: int, nh: int, air: f32): f32 {
    t: f32 = maxf(air - FIT_MARGIN, 0.05);
    fit: f32 = maxf(trick_fit(nf, nh, air), 1.0);
    minf(t * fit, maxf(absi(nf) as f32 * TAU / FLIP_MIN, absi(nh) as f32 * PI / SPIN_MIN))
}

// How much of a trick's turning is done `u` of the way through its time
// (0 to 1): at an even pace, then slowing to rest over the last
// TRICK_SETTLE of it, as he opens up for the landing. (The pace is
// 1 / (1 - TRICK_SETTLE / 2) of the trick's mean, so that it is done on
// time; the slowing is a smoothstep's fall, whose sum is v - v^3 + v^4 / 2
// that far into it.)
trick_share(u: f32): f32 {
    even: f32 = 1.0 - TRICK_SETTLE;
    v: f32 = clampf((u - even) / TRICK_SETTLE, 0.0, 1.0);
    (minf(clampf(u, 0.0, 1.0), even) + TRICK_SETTLE * (v - v * v * v + 0.5 * v * v * v * v)) / (1.0 - 0.5 * TRICK_SETTLE)
}

const TRICK_SETTLE: f32 = 0.3;

// How much of the trick he went for he has turned, 0 to 1 (all of it, if
// it has no turning).
trick_turned(m: *Mover): f32 {
    goal: f32 = absf(m.flip_goal) + absf(m.spin_goal);
    if (goal < 0.001) return 1.0;
    clampf((absf(m.flip) + absf(m.spin)) / goal, 0.0, 1.0)
}

// How much of an air t long a trick needs, as a fraction of what he can
// turn in it: over 1, it is too big.
trick_fit(nf: int, nh: int, t: f32): f32 {
    tt: f32 = t - FIT_MARGIN;
    if (nf == 0 && nh == 0) return 0.0;
    if (tt <= 0.05) return 9.99;
    (absi(nf) as f32 * TAU / FLIP_MAX + absi(nh) as f32 * PI / SPIN_MAX) / tt
}

// The kind of feature i, or -1.
item_of(i: int): int {
    if (i < 0) return -1;
    // The bowl's walls are a halfpipe's, for what they favor.
    if (features[i].kind == FEATURE_BOWL) return FEATURE_PIPE;
    features[i].kind
}

// Up a wall he may fly straight up and come back down it: a halfpipe's on
// the course, the bowl's in the park. Whether (x, z) is up one, and the
// level way into it there.
wall_at(x: f32, z: f32): bool {
    if (park) return park_out(x, z) > 0.5;
    pipe_at(x, -z) >= 0
}

wall_in(x: f32, z: f32): V3 {
    if (park) return park_normal(x, z);
    v3(signf(x), 0.0, 0.0)
}

// Heading c, turned back off a wall that faces in along -n.
mirror_carve(c: f32, n: V3): f32 {
    d: V3 = carve_dir(c);
    r: V3 = v_madd(d, n, -2.0 * v_dot(d, n));
    atan2f(r.x, -r.z)
}

signi(a: int): int {
    if (a < 0) return -1;
    if (a > 0) return 1;
    0
}

absi(a: int): int {
    if (a < 0) return -a;
    a
}

maxi(a: int, b: int): int {
    if (a > b) return a;
    b
}

take_off(m: *Mover) {
    m.air = true;
    m.air_time = 0.0;
    m.ollied = false;
    m.trick_set = false;
    m.grab_t = 0.0;
    m.flip = 0.0;
    m.flip_w = 0.0;
    m.flip_goal = 0.0;
    m.spin = 0.0;
    m.spin_w = 0.0;
    m.spin_goal = 0.0;
    m.trick_d = 0.0;
    m.trick_t = 0.0;
    // Off a kicker, a pipe's wall, a cliff, or anything else; and how he
    // stood.
    m.air_from = takeoff_feature(m.prev.x, -m.prev.z);
    m.air_feature = m.air_from >= 0;
    m.air_switch = m.fakie;
    d: V3 = carve_dir(m.carve);
    m.vx = d.x * m.speed;
    m.vz = d.z * m.speed;
    // Up and off a halfpipe's wall he goes straight up, drifting back in a
    // little, and will come back down it the other way. (Dropping in off
    // its deck is an ordinary air.)
    n: V3 = wall_in(m.x, m.z);
    // (Up the bowl's walls, at any slant: else he would fly out over the
    // lip.)
    up: f32 = 0.1;
    if (park) up = 0.0;
    m.pipe_vert = item_of(m.air_from) == FEATURE_PIPE && v_dot(d, n) > up;
    if (m.pipe_vert) {
        m.pipe_carve = m.carve;
        m.pipe_speed = m.speed;
        m.pipe_n = n;
        // Along the wall as he was going, and a little back out from it.
        v: V3 = v_madd(v_reject(v3(m.vx, 0.0, m.vz), n), n, -0.5);
        m.vx = v.x;
        m.vz = v.z;
        // As fast up as he was going.
        m.vy = clampf(m.vy, 0.0, m.speed * 1.1)
    } else if (item_of(m.air_from) == FEATURE_PIPE) m.air_from = -1
}

step_course_ground(m: *Mover, keys: *Keys, dt: f32) {
    // Space held, the arrows aim the trick instead of steering.
    arrows: bool = !keys.hop_held;
    // Turning: the steering thumb sets the way he aims, from straight down
    // the hill in the middle out to AIM_MAX either side, and he carves
    // round to it; an arrow held turns him as the thumb at that end of its
    // track would, so that neither turns him further than the other (up a
    // halfpipe's wall, say). Either way he eases into and out of a turn,
    // and keeps his way when let go.
    // (In the park, there is no down the hill: the thumb turns him, as the
    // arrows do, and he may go any way.)
    c0: f32 = m.carve;
    want: f32 = 0.0;
    axis: f32 = 0.0;
    if (arrows) axis = key_axis(keys, 0, 2);
    if (keys.stick_on && park) want = keys.stick_x * STEER_RATE else if (keys.stick_on) want = clampf((keys.stick_x * AIM_MAX - m.carve) * 3.5,
        -STEER_RATE, STEER_RATE) else if (park) want = axis * STEER_RATE else if (axis != 0.0) want = clampf((axis * AIM_MAX - m.carve) * 3.5,
        -STEER_RATE, STEER_RATE);
    // He turns no harder than leaning his most into the turn holds him up
    // at the speed he goes (see GRIP_ACCEL; and pose.l8, where he leans as
    // his turning and the ground have it). His turning eases in and out
    // smoothly, so that his lean does.
    grip: f32 = GRIP_ACCEL / maxf(m.speed, 0.1);
    want = clampf(want, -grip, grip);
    spring_step(&m.carve_w, &m.carve_wv, want, Spring { omega: STEER_OMEGA, damping: 1.0 },
        dt);
    m.carve = m.carve + m.carve_w * dt;
    // (Up a bank he goes the way he steers: across it, or up it and off
    // its side, as he likes; the fence turns him back.)
    if (park && park_out(m.x, m.z) > bowl_top() - 0.1) {
        // Out of the bowl, on its deck, he turns back in to drop in again.
        n: V3 = park_normal(m.x, m.z);
        m.carve = approach_angle(m.carve, atan2f(-n.x, n.z), ease(4.0, dt))
    }
    // Slowing to a stop up a wall, he rolls back down it.
    on_wall: bool = wall_at(m.x, m.z);
    if (on_wall && m.speed < 2.5 && v_dot(carve_dir(m.carve), wall_in(m.x, m.z)) > 0.2) m.carve = mirror_carve(m.carve,
        wall_in(m.x, m.z));
    // Slow along a wall of the bowl, he turns down it, as it falls away
    // under him.
    if (park && on_wall) {
        n: V3 = wall_in(m.x, m.z);
        pull: f32 = clampf(1.0 - m.speed / 6.0, 0.0, 1.0);
        m.carve = approach_angle(m.carve, atan2f(-n.x, n.z), ease(4.0 * pull, dt))
    }
    if (park) m.carve = wrap_angle(m.carve) else m.carve = clampf(m.carve, -CARVE_LIMIT,
        CARVE_LIMIT);
    // As in the park, how fast his heading turns: carving right turns it
    // the other way.
    m.turn_rate = wrap_angle(c0 - m.carve) / dt;
    d: V3 = carve_dir(m.carve);
    // Gravity along the ground, against rolling, the air, and turning.
    rise: f32 = rise_along(m.x, m.z, d);
    a: f32 = -SLOPE_G * rise / (1.0 + rise * rise) - ROLL_FRICTION * SLOPE_G - AIR_DRAG * m.speed * m.speed - TURN_DRAG * absf(m.turn_rate) * m.speed;
    // (A lesson finishes part way down the hill, with more of it ahead: he
    // pulls up short there.)
    m.pushing = false;
    if (m.finished && in_tutorial()) a = a - LESSON_BRAKE else if (m.finished && !(park && on_wall)) a = a - BRAKE else if (park && m.speed < PARK_CRUISE && !on_wall) {
        a = a + PARK_PUSH;
        m.pushing = true
    } else if (m.speed < PUSH_SPEED && !on_wall) {
        a = a + SLOPE_PUSH;
        m.pushing = true
    }
    if (behind_pace > 0.0 && !on_wall) {
        a = a + PACE_PUSH * minf(behind_pace / PACE_FAR, 1.0);
        m.pushing = true
    }
    // In a halfpipe he pumps, keeping up his speed.
    if (!m.finished && in_pipe(-m.z)) a = a + maxf(0.0, PIPE_PUMP - m.speed) * 1.5;
    m.speed = clampf(m.speed + a * dt, 0.0, TOP_SPEED);
    // Too slow to push up a face (from a gap's pit, say, its every side too
    // steep), he climbs it at a walk, not stuck there.
    if (!park && !m.finished && !on_wall) m.speed = maxf(m.speed, CLIMB_SPEED);
    // In the park he may ride at a face too steep to ride up (a gap's lip,
    // from its pit): he bumps off it, turned away, and slowed.
    if (park && !on_wall && rise_along(m.x + d.x * 0.3, m.z + d.z * 0.3, d) > STEEP_FACE) {
        g: V3 = v3(course_height(m.x + d.x * 0.3 + 0.05, m.z + d.z * 0.3) - course_height(m.x + d.x * 0.3 - 0.05,
            m.z + d.z * 0.3), 0.0, course_height(m.x + d.x * 0.3, m.z + d.z * 0.3 + 0.05) - course_height(m.x + d.x * 0.3,
            m.z + d.z * 0.3 - 0.05));
        m.carve = mirror_carve(m.carve, v_norm(g));
        m.bonk = m.speed;
        m.speed = m.speed * 0.5;
        d = carve_dir(m.carve)
    }
    m.x = m.x + d.x * m.speed * dt;
    // The fence up each bank turns him back: he glances off it, heading in.
    if (!park && absf(m.x) > SIDE_LIMIT) {
        m.x = signf(m.x) * SIDE_LIMIT;
        if (m.carve * signf(m.x) > 0.0) {
            m.carve = mirror_carve(m.carve, v3(signf(m.x), 0.0, 0.0));
            m.bonk = m.speed * 0.5;
            m.speed = m.speed * 0.7;
            d = carve_dir(m.carve)
        }
    }
    m.z = m.z + d.z * m.speed * dt;
    m.vx = d.x * m.speed;
    m.vz = d.z * m.speed;
    m.heading = dir_yaw(d);
    m.ground_n = course_normal(m.x, m.z);
    // He stays on the ground unless it falls away faster than he would.
    h: f32 = course_height(m.x, m.z);
    fall: f32 = m.y + m.vy * dt - 0.5 * SLOPE_G * dt * dt;
    if (h >= fall - 0.002) {
        m.vy = (h - m.y) / dt;
        m.y = h;
        // (What he feels: see Mover.felt.)
        vel: V3 = v3(m.vx, m.vy, m.vz);
        // (Just down, not yet known: as if the ground bore him square to
        // it.)
        if (m.felt_on) m.felt = v_lerp(m.felt, v_scale(v_sub(vel, m.felt_vel), 1.0 / dt),
            ease(FELT_EASE, dt)) else m.felt = v_scale(v_sub(m.ground_n, v3(0.0, 1.0,
            0.0)), SLOPE_G);
        m.felt_vel = vel;
        m.felt_on = true
    } else {
        m.y = fall;
        m.vy = m.vy - SLOPE_G * dt;
        // Only the rise along the run throws him up, not across it (a
        // bank's, say), but for off a kicker and up a wall. (In the park,
        // the rise the way he heads.)
        p: V3 = m.prev;
        // (Its rise just behind him: a lip's is the ramp's, not the drop's
        // past it.)
        dh: f32 = minf((course_height(p.x, p.z) - course_height(p.x, p.z + 0.3)) / 0.3,
            STEEP_THROW);
        ahead: f32 = maxf(-m.vz, 0.0);
        // (Off a kicker, the rise the way he goes, however he crosses it: up
        // its side too.)
        if (!park && kicker_at(p.x, -p.z) >= 0) {
            dh = minf((course_height(p.x, p.z) - course_height(p.x - d.x * 0.3, p.z - d.z * 0.3)) / 0.3,
                STEEP_THROW);
            ahead = m.speed
        }
        if (park) {
            // (In the park, the rise along whatever he rides off, the way
            // it faces, as on the course: not across it, nor backward.)
            f: V3 = d;
            k: int = kicker_at(p.x, -p.z);
            if (k >= 0) f = feature_fwd(features[k]);
            dh = minf((course_height(p.x, p.z) - course_height(p.x - f.x * 0.3, p.z - f.z * 0.3)) / 0.3,
                STEEP_THROW);
            ahead = maxf(v_dot(d, f) * m.speed, 0.0)
        }
        if (!wall_at(p.x, p.z) && m.vy > 0.0) m.vy = minf(m.vy, maxf(dh * ahead, 0.0));
        take_off(m)
    }
    try_course_rail(m)
}

step_course_air(m: *Mover, keys: *Keys, dt: f32) {
    // Grabbing, he turns slower.
    grabbing: bool = keys.style_held || m.pad_grab && keys.pad_held;
    slow: f32 = 1.0;
    if (grabbing) {
        m.grab_t = m.grab_t + dt;
        slow = GRAB_SLOW
    }
    if (m.trick_d > 0.0) {
        m.trick_t = m.trick_t + dt * slow;
        if (m.trick_t >= m.trick_d) {
            m.flip = m.flip_goal;
            m.spin = m.spin_goal
        } else {
            k: f32 = trick_share(m.trick_t / m.trick_d);
            m.flip = lerpf(m.flip_from, m.flip_goal, k);
            m.spin = lerpf(m.spin_from, m.spin_goal, k)
        }
    }
    // (He flies at the air's pace; he turns, and grabs, at his own.)
    flown: f32 = dt * air_pace();
    m.x = m.x + m.vx * flown;
    // (Flying at the fence, he bounces off it, back over the course.)
    if (!park && absf(m.x) > SIDE_LIMIT) {
        m.x = signf(m.x) * SIDE_LIMIT;
        if (m.vx * signf(m.x) > 0.0) m.vx = -m.vx * 0.3
    }
    m.z = m.z + m.vz * flown;
    m.vy = m.vy - SLOPE_G * flown;
    m.y = m.y + m.vy * flown;
    v: V3 = v3(m.vx, 0.0, m.vz);
    if (v_len(v) > 0.1) m.heading = dir_yaw(v);
    try_course_rail(m);
    if (m.grinding) return;
    h: f32 = course_height(m.x, m.z);
    if (m.y <= h) course_land(m, h)
}

// Whether he came down, at d, short of a gap's landing: in its pit.
landed_short(f: Feature, x: f32, d: f32): bool {
    f.kind == FEATURE_GAP && feature_local(f, x, d).z < f.d + landing_start(f)
}

// Judge what he did in the air, if he came down clean (see judge.l8);
// otherwise it was sketchy. Either way he comes out of it upright, switch
// after an odd number of half turns. On a rail, there is no landing to
// judge.
land_tricks(m: *Mover, on_rail: bool) {
    flips: f32 = floorf(m.flip / TAU + 0.5);
    halves: f32 = floorf(m.spin / PI + 0.5);
    // Clean only if he finished the trick he started, and came down
    // straight.
    clean: bool = absf(m.flip - flips * TAU) < LAND_TOL && absf(m.spin - halves * PI) < LAND_TOL && absf(m.flip_goal - m.flip) < LAND_TOL && absf(m.spin_goal - m.spin) < LAND_TOL;
    item: int = item_of(m.air_from);
    // Coming up short of a gap is as bad as landing crooked.
    short: bool = m.air_from >= 0 && !on_rail && landed_short(features[m.air_from],
        m.x, -m.z);
    if (short) clean = false;
    if (clean) {
        kind: int = HIT_FLAT;
        if (m.air_from >= 0) kind = HIT_AIR;
        // A spin to the right turns him clockwise, the negative way.
        judge_air(kind, item, flips as int, -halves as int, m.grab_t / maxf(m.air_time,
            0.01), m.air_time, m.air_switch)
    } else {
        // What he went for.
        judge_sketch(item, floorf(m.flip_goal / TAU + 0.5) as int, -floorf(m.spin_goal / PI + 0.5) as int,
            trick_turned(m), short, m.air_switch);
        m.sketch_t = 0.0
    }
    // Half a turn and he rides on the other way round; so does coming back
    // down a halfpipe's wall.
    if (absf(halves) as int % 2 == 1) m.fakie = !m.fakie;
    if (m.pipe_vert && !on_rail) m.fakie = !m.fakie;
    m.flip = 0.0;
    m.flip_w = 0.0;
    m.spin = 0.0;
    m.spin_w = 0.0;
    m.flip_goal = 0.0;
    m.spin_goal = 0.0;
    m.trick_d = 0.0;
    m.trick_t = 0.0;
    m.grab_t = 0.0;
    m.pad_grab = false
}

mini(a: int, b: int): int {
    if (a < b) return a;
    b
}

course_land(m: *Mover, h: f32) {
    land_tricks(m, false);
    m.air = false;
    m.y = h;
    // His speed carries on along the ground, and a landing down a slope
    // turns some of the fall into more.
    v: V3 = v3(m.vx, 0.0, m.vz);
    sp: f32 = v_len(v);
    d: V3 = carve_dir(m.carve);
    if (sp > 0.1) d = v_scale(v, 1.0 / sp);
    s: f32 = rise_along(m.x, m.z, d);
    if (s < 0.0) sp = sp + -m.vy * -s * 0.4;
    m.speed = clampf(sp, 0.0, TOP_SPEED);
    m.carve = atan2f(d.x, -d.z);
    if (!park) m.carve = clampf(m.carve, -CARVE_LIMIT, CARVE_LIMIT);
    // Back down a wall, the way he went up it, mirrored.
    if (m.pipe_vert) {
        m.carve = mirror_carve(m.pipe_carve, m.pipe_n);
        m.speed = m.pipe_speed * 0.96;
        d = carve_dir(m.carve);
        s = rise_along(m.x, m.z, d);
        sp = m.speed
    }
    m.land = -m.vy;
    m.vy = s * sp;
    m.ground_n = course_normal(m.x, m.z)
}

// ---- rails ----
crail_dir(r: CRail): V3 {
    v_norm(v_sub(r.b, r.a))
}

try_course_rail(m: *Mover) {
    if (m.grinding || m.since_grind < 0.3) return;
    for i in 0..ncrails {
        if (!m.grinding) try_one_rail(m, i)
    }
}

try_one_rail(m: *Mover, i: int) {
    r: CRail = crails[i];
    hx: f32 = r.b.x - r.a.x;
    hz: f32 = r.b.z - r.a.z;
    hl2: f32 = hx * hx + hz * hz;
    t: f32 = ((m.x - r.a.x) * hx + (m.z - r.a.z) * hz) / hl2;
    if (t < 0.0 || t > 1.0) return;
    cx: f32 = r.a.x + hx * t;
    cz: f32 = r.a.z + hz * t;
    mag: f32 = RAIL_MAGNET;
    if (r.box) mag = BOX_MAGNET;
    if ((m.x - cx) * (m.x - cx) + (m.z - cz) * (m.z - cz) > mag * mag) return;
    ry: f32 = lerpf(r.a.y, r.b.y, t) + rail_top(r);
    above: f32 = m.y - ry;
    if (m.air) {
        if (m.vy > 0.5 || above > 0.3 || above < -0.3) return;
        // Not in the middle of a trick.
        if (absf(m.flip_goal - m.flip) > LAND_TOL || absf(m.spin_goal - m.spin) > LAND_TOL) return
    } else if (above > 0.1 || above < -0.4) return;
    // Along it, not across.
    v: V3 = v3(m.vx, 0.0, m.vz);
    if (v_len(v) < 0.5 || v_dot(v_norm(v), v_norm(v3(hx, 0.0, hz))) < 0.5) return;
    if (m.air) land_tricks(m, true);
    m.air = false;
    m.grinding = true;
    m.crail = i;
    m.crail_t = t * v_len(v_sub(r.b, r.a));
    m.speed = maxf(v_len(v), PUSH_SPEED);
    m.land = maxf(-m.vy, 0.0) * 0.5;
    m.vy = 0.0;
    place_on_crail(m);
    judge_grind(r.box, m.fakie)
}

place_on_crail(m: *Mover) {
    r: CRail = crails[m.crail];
    u: V3 = crail_dir(r);
    p: V3 = v_madd(r.a, u, m.crail_t);
    m.x = p.x;
    m.y = p.y + rail_top(r);
    m.z = p.z;
    m.vx = u.x * m.speed;
    m.vz = u.z * m.speed;
    m.heading = dir_yaw(v3(u.x, 0.0, u.z));
    m.carve = atan2f(u.x, -u.z);
    m.ground_n = v_norm(v3(0.0, 1.0, 0.0))
}

step_course_grind(m: *Mover, dt: f32) {
    r: CRail = crails[m.crail];
    run_add(GRIND_POINTS * dt);
    m.crail_t = m.crail_t + m.speed * dt;
    len: f32 = v_len(v_sub(r.b, r.a));
    if (m.crail_t > len) {
        if (r.next >= 0) {
            m.crail_t = m.crail_t - len;
            m.crail = r.next
        } else {
            m.crail_t = len;
            place_on_crail(m);
            leave_crail(m, 0.0, 0.0);
            return
        }
    }
    place_on_crail(m)
}

// Off the rail, along it, with a pop of vy and a push to a side.
leave_crail(m: *Mover, vy: f32, side: f32) {
    r: CRail = crails[m.crail];
    u: V3 = crail_dir(r);
    m.grinding = false;
    m.since_grind = 0.0;
    take_off(m);
    m.air_feature = true;
    s: V3 = v_norm(v_cross(u, v3(0.0, 1.0, 0.0)));
    m.vx = u.x * m.speed + s.x * side * 2.0;
    m.vz = u.z * m.speed + s.z * side * 2.0;
    m.vy = u.y * m.speed + vy;
    if (vy > 0.0) {
        m.ollied = true;
        m.since_hop = 0.0
    }
}
