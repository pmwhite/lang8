tag skate;

// Riding down the slope course, by a few rules:
//
// - Gravity along the way he heads speeds him up downhill and slows him
//   going up; the board's rolling and the air hold him back, more the
//   faster he goes, and turning sheds a little speed. Pointed down the
//   hill he runs fast; across it, he slows. Nearly stopped, he pushes.
// - Left and right turn him across the run, and he keeps going the way he
//   points; the banks turn him back in.
// - The trick pad (see touch.l8) crouches him while held, aiming a trick:
//   flips forward or back, half turns either way. Letting go jumps into
//   it, there and then: off the ground, off a rail, or up a kicker's ramp,
//   best at its lip. In the air, pressed again, it grabs.
// - The trick fits the air: he turns as fast as he must to finish it just
//   before he lands, and if even his fastest is not enough, he doesn't
//   finish it. So a small trick lands from a sloppy jump, and a big one
//   only from a jump timed right.
// - Taking off, only the slope along the run throws him up: riding off the
//   side of a kicker does not.
// - Coming down on a rail or box, or riding into its low end, he grinds it.
// - Landing the trick he went for scores it (see judge.l8); landing
//   crooked is sketchy, and scores nothing. He never falls.
const SLOPE_G: f32 = 16.0;

// What holds him back: rolling, as a fraction of his weight; the air, per
// speed squared; and turning, per radian a second, per speed.
const ROLL_FRICTION: f32 = 0.03;

const AIR_DRAG: f32 = 0.017;

const TURN_DRAG: f32 = 0.12;

// Slower than this, he pushes along; never faster than the top.
const PUSH_SPEED: f32 = 3.0;

const SLOPE_PUSH: f32 = 3.0;

const TOP_SPEED: f32 = 18.0;

// Past the finish, he drags a foot to stop.
const BRAKE: f32 = 4.0;

// How far he may turn across the run, how fast he turns at the most, and
// how hard the banks turn him back.
const CARVE_LIMIT: f32 = 1.35;

const STEER_RATE: f32 = 2.2;

// How far either side of straight down the hill the steering thumb at the
// end of its track aims him.
const AIM_MAX: f32 = 1.2;

const BANK_PULL: f32 = 5.5;

const OLLIE_SPEED: f32 = 5.0;

// Up a kicker's ramp (or just off its lip), which throws him already, a
// pop adds less.
const LIP_POP: f32 = 2.0;

const LATE_OLLIE: f32 = 0.15;

// How fast he turns, radians a second: at the most, and at the least, so
// that a trick in a big air does not dawdle; and how long before landing
// a trick should be done.
const FLIP_MAX: f32 = 13.0;

const SPIN_MAX: f32 = 16.0;

const FLIP_MIN: f32 = 6.0;

const SPIN_MIN: f32 = 8.0;

const FIT_MARGIN: f32 = 0.15;

// The speed he pumps up to in a halfpipe.
const PIPE_PUMP: f32 = 9.5;

in_pipe(d: f32): bool {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_PIPE && d > f.d + 4.0 && d < f.d + f.a - 4.0) return true
    }
    false
}

// How much slower he turns while grabbing.
const GRAB_SLOW: f32 = 0.7;

// How near upright (or lined up, for a spin) a landing must be, in radians.
const LAND_TOL: f32 = 0.55;

const RAIL_MAGNET: f32 = 0.4;

const BOX_MAGNET: f32 = 0.55;

// Points a second for a grind.
const GRIND_POINTS: f32 = 150.0;

// Start (or start over) at the top of the run.
enter_course(m: *Mover) {
    reset_mover(m);
    m.course = true;
    m.riding = true;
    m.x = 0.0;
    m.z = -(COURSE_START + 7.0);
    m.y = course_height(m.x, m.z);
    m.prev = v3(m.x, m.y, m.z);
    m.carve = 0.0;
    m.speed = PUSH_SPEED;
    m.heading = PI;
    m.facing = PI;
    m.finished = false;
    m.finish_t = 0.0;
    m.sketch_t = 10.0;
    m.crail = -1;
    m.pad_grab = false;
    line.scoring = true;
    clear_line();
    clear_run()
}

key_axis(keys: *Keys, pos: int, neg: int): f32 {
    a: f32 = 0.0;
    if (keys.held[pos]) a = a + 1.0;
    if (keys.held[neg]) a = a - 1.0;
    a
}

carve_dir(c: f32): V3 {
    v3(sinf(c), 0.0, -cosf(c))
}

// The ground's rise along d at (x, z), per unit across the ground.
rise_along(x: f32, z: f32, d: V3): f32 {
    e: f32 = 0.1;
    (course_height(x + d.x * e, z + d.z * e) - course_height(x - d.x * e, z - d.z * e)) / (2.0 * e)
}

step_course(m: *Mover, keys: *Keys, dt: f32) {
    m.prev = v3(m.x, m.y, m.z);
    m.since_hop = m.since_hop + dt;
    m.since_grind = m.since_grind + dt;
    m.sketch_t = m.sketch_t + dt;
    if (m.finished) m.finish_t = m.finish_t + dt;
    if (m.air) m.air_time = m.air_time + dt else m.air_time = 0.0;
    // The pad pressed in the air is a grab; otherwise he crouches, aiming.
    if (keys.pad_press) {
        keys.pad_press = false;
        m.pad_grab = m.air
    }
    m.winding = (keys.pad_held || keys.pad_release) && !m.pad_grab;
    if (m.winding) {
        m.aim_flips = clampi(trunc_toward_zero(keys.aim_y), -3, 3);
        m.aim_halves = clampi(trunc_toward_zero(keys.aim_x), -6, 6)
    }
    wx: f32 = 0.0;
    wy: f32 = 0.0;
    if (m.winding) {
        wx = clampf(m.aim_halves as f32 * 0.5, -1.0, 1.0);
        wy = clampf(m.aim_flips as f32, -1.0, 1.0)
    }
    m.wind_x = lerpf(m.wind_x, wx, ease(12.0, dt));
    // While he aims, how big an air he would get letting go now.
    if (m.winding) preview_jump(m);
    m.wind_y = lerpf(m.wind_y, wy, ease(12.0, dt));
    if (keys.pad_release) {
        keys.pad_release = false;
        // At the finish a tap goes again; a drag (scrolling the report) does
        // not.
        if (m.pad_grab) m.pad_grab = false else if (m.finished) {
            if (m.finish_t > 2.0 && !m.air && absf(keys.aim_x) < 1.0 && absf(keys.aim_y) < 1.0) {
                enter_course(m);
                return
            }
        } else release_trick(m);
        m.winding = false
    }
    if (m.grinding) step_course_grind(m, dt) else if (m.air) step_course_air(m, keys,
        dt) else step_course_ground(m, keys, dt);
    if (!m.finished && -m.z >= COURSE_FINISH) {
        m.finished = true;
        m.finish_t = 0.0
    }
    tick_run(dt);
    if (m.finished) run.best_run = maxi(run.best_run, run.total);
    keys.hop = false;
    keys.board = false;
    keys.style = false
}

trunc_toward_zero(a: f32): int {
    if (a < 0.0) return -floorf(-a) as int;
    floorf(a) as int
}

// Letting go of the pad: a jump into the trick aimed at.
release_trick(m: *Mover) {
    nf: int = m.aim_flips;
    nh: int = m.aim_halves;
    if (m.grinding) {
        leave_crail(m, OLLIE_SPEED, 0.0);
        start_trick(m, nf, nh)
    } else if (m.air) {
        late_ollie(m);
        start_trick(m, nf, nh)
    } else {
        pop(m, pop_speed(m.x, -m.z));
        start_trick(m, nf, nh)
    }
}

// How hard he pops at (x, d): up a kicker's ramp, which throws him
// already, less. (So the time to go is at its lip: earlier, the ramp is
// lower and less steep, and later, he has left it without a pop.)
pop_speed(x: f32, d: f32): f32 {
    if (kicker_at(x, d) >= 0) return LIP_POP;
    OLLIE_SPEED
}

pop(m: *Mover, speed: f32) {
    m.vy = maxf(m.vy, 0.0) + speed;
    take_off(m);
    m.ollied = true;
    m.since_hop = 0.0
}

// Just off a lip, a jump still counts.
late_ollie(m: *Mover) {
    if (m.air_time < LATE_OLLIE && !m.ollied) {
        m.vy = m.vy + LIP_POP;
        m.ollied = true;
        m.since_hop = 0.0
    }
}

// How long until he comes down, flying as he is.
predict_air(m: *Mover): f32 {
    h: f32 = 1.0 / 60.0;
    x: f32 = m.x;
    y: f32 = m.y;
    z: f32 = m.z;
    vy: f32 = m.vy;
    t: f32 = 0.0;
    k: int = 0;
    while (k < 300) {
        vy = vy - SLOPE_G * h;
        x = x + m.vx * h;
        z = z + m.vz * h;
        y = y + vy * h;
        t = t + h;
        if (y <= course_height(x, z)) k = 300 else k = k + 1
    }
    t
}

// Into the air with nf flips (forward) and nh half turns (to the right),
// fitted to the air he has: as many as he can finish before he lands.
//
// He turns as fast as he must to finish just before he lands, but no
// faster than he can: a trick too big for the air does not finish, and he
// lands it sketchy. (While aiming, the trick shows how much of the air it
// needs: see trick_fit.)
//
// Flipping and spinning share him: a trick's flips and spins together must
// fit the air, each taking its share of his fastest turning.
start_trick(m: *Mover, nf: int, nh: int) {
    if (!m.air) return;
    t: f32 = maxf(predict_air(m) - FIT_MARGIN, 0.05);
    fit: f32 = maxf(trick_fit(nf, nh, predict_air(m)), 1.0);
    m.flip_goal = m.flip + nf as f32 * TAU;
    m.flip_w = maxf(absi(nf) as f32 * TAU / t / fit, FLIP_MIN);
    // To the right is clockwise seen from above.
    m.spin_goal = m.spin - nh as f32 * PI;
    m.spin_w = maxf(absi(nh) as f32 * PI / t / fit, SPIN_MIN)
}

// How much of an air t long a trick needs, as a fraction of what he can
// turn in it: over 1, it is too big.
trick_fit(nf: int, nh: int, t: f32): f32 {
    tt: f32 = t - FIT_MARGIN;
    if (nf == 0 && nh == 0) return 0.0;
    if (tt <= 0.05) return 9.99;
    (absi(nf) as f32 * TAU / FLIP_MAX + absi(nh) as f32 * PI / SPIN_MAX) / tt
}

// How long an air a trick needs, at the least.
trick_need(nf: int, nh: int): f32 {
    if (nf == 0 && nh == 0) return 0.0;
    absi(nf) as f32 * TAU / FLIP_MAX + absi(nh) as f32 * PI / SPIN_MAX + FIT_MARGIN
}

// While he aims, how long he would fly if he let go now, and off what (a
// feature kind, or -1 for the plain hill), sent off as release_trick would
// send him.
preview_jump(m: *Mover) {
    h: f32 = 1.0 / 40.0;
    x: f32 = m.x;
    z: f32 = m.z;
    y: f32 = m.y;
    dir: V3 = carve_dir(m.carve);
    vx: f32 = dir.x * m.speed;
    vz: f32 = dir.z * m.speed;
    vy: f32 = maxf(m.vy, 0.0) + pop_speed(x, -z);
    item: int = item_of(takeoff_feature(x, -z));
    if (m.air) {
        vx = m.vx;
        vz = m.vz;
        vy = m.vy;
        if (m.air_time < LATE_OLLIE && !m.ollied) vy = vy + LIP_POP;
        item = item_of(m.air_from)
    } else if (m.grinding) {
        u: V3 = crail_dir(crails[m.crail]);
        vx = u.x * m.speed;
        vz = u.z * m.speed;
        vy = u.y * m.speed + OLLIE_SPEED
    } else if (pipe_at(x, -z) >= 0 && m.carve * signf(x) > 0.1) {
        vx = -signf(x) * 0.5;
        vy = minf(vy, m.speed * 1.1);
        item = FEATURE_PIPE
    }
    m.aim_air = fly_time(x, y, z, vx, vy, vz);
    m.aim_item = item;
    preview_ahead(m)
}

// How long he flies from (x, y, z) at (vx, vy, vz) before he is down.
fly_time(
    x0: f32,
    y0: f32,
    z0: f32,
    vx: f32,
    vy0: f32,
    vz: f32
): f32 {
    h: f32 = 1.0 / 40.0;
    x: f32 = x0;
    y: f32 = y0;
    z: f32 = z0;
    vy: f32 = vy0;
    t: f32 = 0.0;
    k: int = 0;
    while (k < 160) {
        vy = vy - SLOPE_G * h;
        x = x + vx * h;
        z = z + vz * h;
        y = y + vy * h;
        t = t + h;
        if (y <= course_height(x, z)) k = 160 else k = k + 1
    }
    t
}

// ---- the jumps ahead ----
// For each jump ahead within MARK_AHEAD (a kicker's or a gap's lip, a
// cliff's edge), how long he would fly letting go at each place on his
// way up to it, coming in at the speed the hill would give him by then,
// straight. A trick's worth there, and where to let go for it, read off
// that (see put_marks, in hud.l8). Kept a few times a second.
const MARK_AHEAD: f32 = 60.0;

const MARK_STEP: f32 = 0.5;

const MARK_N: int = 16;

// The run-up a cliff gives to let go on.
const CLIFF_RUN_UP: f32 = 6.0;

mark_on: []bool = new bool[MAX_FEATURES](false);

// Where each one's lip (or edge) is along the run, and across it; where
// its samples start, how many there are, and his speed coming to it.
mark_lip: []f32 = new f32[MAX_FEATURES](0.0);

mark_x: []f32 = new f32[MAX_FEATURES](0.0);

mark_from: []f32 = new f32[MAX_FEATURES](0.0);

mark_count: []int = new int[MAX_FEATURES](0);

mark_speed: []f32 = new f32[MAX_FEATURES](0.0);

mark_air: []f32 = new f32[MAX_FEATURES * MARK_N](0.0);

// His speed at each one's lip, coming in so.
mark_lip_speed: []f32 = new f32[MAX_FEATURES](0.0);

mark_tick: int = 0;

// His speed, rolling straight down the plain hill from d0 to d1, from v.
roll_speed(v: f32, d0: f32, d1: f32): f32 {
    w: f32 = v * v;
    d: f32 = d0;
    while (d < d1) {
        g: f32 = course_grade(d);
        a: f32 = SLOPE_G * (g / sqrtf(1.0 + g * g) - ROLL_FRICTION) - AIR_DRAG * w;
        w = maxf(w + 2.0 * a * 0.5, PUSH_SPEED * PUSH_SPEED);
        d = d + 0.5
    }
    minf(sqrtf(w), TOP_SPEED)
}

update_marks(m: *Mover) {
    mark_tick = mark_tick - 1;
    if (mark_tick > 0) return;
    mark_tick = 20;
    d: f32 = -m.z;
    for i in 0..nfeatures {
        f: Feature = features[i];
        mark_on[i] = false;
        lip: f32 = f.d + f.a;
        run: f32 = f.a;
        x: f32 = f.x;
        if (f.kind == FEATURE_CLIFF) {
            lip = f.d;
            run = CLIFF_RUN_UP;
            x = clampf(m.x, -COURSE_HALF + 1.0, COURSE_HALF - 1.0)
        }
        if ((f.kind == FEATURE_KICKER || f.kind == FEATURE_GAP || f.kind == FEATURE_CLIFF) && lip > d + 1.0 && lip < d + MARK_AHEAD) {
            mark_on[i] = true;
            mark_lip[i] = lip;
            mark_x[i] = x;
            from: f32 = lip - run;
            v: f32 = m.speed;
            if (from > d) v = roll_speed(m.speed, d, from);
            mark_speed[i] = v;
            sample_jump(i, x, from, lip, v)
        }
    }
}

// Ride from from on to the lip at speed v, straight, noting how long he
// would fly letting go every MARK_STEP of the way (as release_trick would
// send him: popping, less up a ramp, and thrown up as steeply as the
// ground rises just behind him).
sample_jump(
    i: int,
    x: f32,
    from: f32,
    lip: f32,
    v: f32
) {
    sp: f32 = v;
    d: f32 = from;
    n: int = 0;
    mark_from[i] = from;
    while (n < MARK_N && d <= lip + 0.01) {
        z: f32 = -d;
        y: f32 = course_height(x, z);
        slope: f32 = (y - course_height(x, z + 0.3)) / 0.3;
        vy: f32 = maxf(sp * slope, 0.0) + pop_speed(x, d);
        mark_air[i * MARK_N + n] = fly_time(x, y, z, 0.0, vy, -sp);
        n = n + 1;
        // On to the next, slowing as he climbs.
        ny: f32 = course_height(x, z - MARK_STEP);
        w: f32 = sp * sp - 2.0 * (SLOPE_G * (ny - y) + (ROLL_FRICTION * SLOPE_G + AIR_DRAG * sp * sp) * MARK_STEP);
        sp = sqrtf(maxf(w, 0.25));
        d = d + MARK_STEP
    }
    mark_count[i] = n;
    mark_lip_speed[i] = sp
}

// How far ahead he looks for the next jump, and how sharply the ground
// must fall away from under him (its slope's drop over one step) to make
// one: a kicker's lip, a gap's, a cliff's edge.
const AHEAD: f32 = 15.0;

const AHEAD_STEP: f32 = 0.25;

const EDGE_DROP: f32 = 0.35;

// The next jump on his way, rolling on to it as he heads (slowing as he
// climbs, rolls, and meets the air), and letting go at its lip.
preview_ahead(m: *Mover) {
    m.ahead_air = 0.0;
    m.ahead_item = -1;
    // (In a halfpipe, its walls are the jumps, and the air now says it.)
    if (m.air || m.grinding || in_pipe(-m.z)) return;
    dir: V3 = carve_dir(m.carve);
    x: f32 = m.x;
    z: f32 = m.z;
    y: f32 = course_height(x, z);
    sp: f32 = m.speed;
    slope: f32 = 0.0;
    k: int = 0;
    while (k < (AHEAD / AHEAD_STEP) as int) {
        nx: f32 = x + dir.x * AHEAD_STEP;
        nz: f32 = z + dir.z * AHEAD_STEP;
        ny: f32 = course_height(nx, nz);
        s: f32 = (ny - y) / AHEAD_STEP;
        if (k > 0 && slope - s > EDGE_DROP && slope > -0.3) {
            vy: f32 = maxf(sp * slope, 0.0) + pop_speed(x, -z);
            m.ahead_air = fly_time(x, y, z, dir.x * sp, vy, dir.z * sp);
            m.ahead_item = item_of(takeoff_feature(x, -z));
            return
        }
        w: f32 = sp * sp - 2.0 * (SLOPE_G * (ny - y) + (ROLL_FRICTION * SLOPE_G + AIR_DRAG * sp * sp) * AHEAD_STEP);
        sp = sqrtf(maxf(w, 0.25));
        x = nx;
        z = nz;
        y = ny;
        slope = s;
        k = k + 1
    }
}

// The kind of feature i, or -1.
item_of(i: int): int {
    if (i < 0) return -1;
    features[i].kind
}

absi(a: int): int {
    if (a < 0) return -a;
    a
}

signi(a: int): int {
    if (a < 0) return -1;
    if (a > 0) return 1;
    0
}

maxi(a: int, b: int): int {
    if (a > b) return a;
    b
}

take_off(m: *Mover) {
    m.air = true;
    m.air_time = 0.0;
    m.ollied = false;
    m.manual = false;
    m.manual_t = 0.0;
    m.air_tricks = 0;
    m.grab_t = 0.0;
    m.flip = 0.0;
    m.flip_w = 0.0;
    m.flip_goal = 0.0;
    m.spin = 0.0;
    m.spin_w = 0.0;
    m.spin_goal = 0.0;
    // Off a kicker, a pipe's wall, a cliff, or anything else; and how he
    // stood.
    m.air_from = takeoff_feature(m.prev.x, -m.prev.z);
    m.air_feature = m.air_from >= 0;
    m.air_switch = m.fakie;
    d: V3 = carve_dir(m.carve);
    m.vx = d.x * m.speed;
    m.vz = d.z * m.speed;
    // Up and off a halfpipe's wall he goes straight up, drifting back in a
    // little, and will come back down it the other way. (Dropping in off
    // its deck is an ordinary air.)
    m.pipe_vert = item_of(m.air_from) == FEATURE_PIPE && m.carve * signf(m.x) > 0.1;
    if (m.pipe_vert) {
        m.pipe_carve = m.carve;
        m.pipe_speed = m.speed;
        m.vx = -signf(m.x) * 0.5;
        // As fast up as he was going.
        m.vy = clampf(m.vy, 0.0, m.speed * 1.1)
    } else if (item_of(m.air_from) == FEATURE_PIPE) m.air_from = -1
}

step_course_ground(m: *Mover, keys: *Keys, dt: f32) {
    // Space held, the arrows aim the trick instead of steering.
    arrows: bool = !keys.hop_held;
    // Turning: the steering thumb sets the way he aims, from straight down
    // the hill in the middle out to AIM_MAX either side, and he carves
    // round to it; the arrows turn him while held. Either way he eases into
    // and out of a turn, and keeps his way when let go.
    c0: f32 = m.carve;
    want: f32 = 0.0;
    if (keys.stick_on) want = clampf((keys.stick_x * AIM_MAX - m.carve) * 3.5, -STEER_RATE,
        STEER_RATE) else if (arrows) want = key_axis(keys, 0, 2) * STEER_RATE;
    m.carve_w = lerpf(m.carve_w, want, ease(8.0, dt));
    m.carve = m.carve + m.carve_w * dt;
    // Up a bank, heading out, he is turned back in, harder than he can
    // steer out.
    e: f32 = 0.1;
    gx: f32 = (course_bank(m.x + e) - course_bank(m.x - e)) / (2.0 * e);
    if (m.carve * signf(m.x) > -0.25) m.carve = m.carve - gx * BANK_PULL * dt;
    // Slowing to a stop up a halfpipe's wall, he rolls back down it.
    on_wall: bool = pipe_at(m.x, -m.z) >= 0;
    if (on_wall && m.speed < 2.5 && m.carve * signf(m.x) > 0.2) m.carve = -m.carve;
    m.carve = clampf(m.carve, -CARVE_LIMIT, CARVE_LIMIT);
    // As in the park, how fast his heading turns: carving right turns it
    // the other way.
    m.turn_rate = (c0 - m.carve) / dt;
    d: V3 = carve_dir(m.carve);
    // Gravity along the ground, against rolling, the air, and turning.
    rise: f32 = rise_along(m.x, m.z, d);
    a: f32 = -SLOPE_G * rise / (1.0 + rise * rise) - ROLL_FRICTION * SLOPE_G - AIR_DRAG * m.speed * m.speed - TURN_DRAG * absf(m.turn_rate) * m.speed;
    if (m.finished) a = a - BRAKE else if (m.speed < PUSH_SPEED && !on_wall) a = a + SLOPE_PUSH;
    // In a halfpipe he pumps, keeping up his speed.
    if (!m.finished && in_pipe(-m.z)) a = a + maxf(0.0, PIPE_PUMP - m.speed) * 1.5;
    m.speed = clampf(m.speed + a * dt, 0.0, TOP_SPEED);
    m.x = clampf(m.x + d.x * m.speed * dt, -COURSE_HALF - 6.0, COURSE_HALF + 6.0);
    m.z = m.z + d.z * m.speed * dt;
    m.vx = d.x * m.speed;
    m.vz = d.z * m.speed;
    m.heading = dir_yaw(d);
    m.ground_n = course_normal(m.x, m.z);
    // He stays on the ground unless it falls away faster than he would.
    h: f32 = course_height(m.x, m.z);
    fall: f32 = m.y + m.vy * dt - 0.5 * SLOPE_G * dt * dt;
    if (h >= fall - 0.002) {
        m.vy = (h - m.y) / dt;
        m.y = h
    } else {
        m.y = fall;
        m.vy = m.vy - SLOPE_G * dt;
        // Only the rise along the run throws him up, not across it, but
        // for up a halfpipe's wall.
        p: V3 = m.prev;
        // (Its rise just behind him: a lip's is the ramp's, not the drop's
        // past it.)
        dh: f32 = (course_height(p.x, p.z) - course_height(p.x, p.z + 0.3)) / 0.3;
        if (pipe_at(p.x, -p.z) < 0 && m.vy > 0.0) m.vy = minf(m.vy, maxf(dh * maxf(-m.vz,
            0.0), 0.0));
        take_off(m)
    }
    try_course_rail(m)
}

// Toward a whole number of turns, at a rate.
turn_toward(
    a: f32,
    goal: f32,
    w: f32,
    dt: f32
): f32 {
    a + clampf(goal - a, -w * dt, w * dt)
}

step_course_air(m: *Mover, keys: *Keys, dt: f32) {
    // Grabbing, he turns slower.
    grabbing: bool = keys.style_held || m.pad_grab && keys.pad_held;
    slow: f32 = 1.0;
    if (grabbing) {
        m.grab_t = m.grab_t + dt;
        slow = GRAB_SLOW
    }
    m.flip = turn_toward(m.flip, m.flip_goal, m.flip_w * slow, dt);
    m.spin = turn_toward(m.spin, m.spin_goal, m.spin_w * slow, dt);
    m.x = clampf(m.x + m.vx * dt, -COURSE_HALF - 6.0, COURSE_HALF + 6.0);
    m.z = m.z + m.vz * dt;
    m.vy = m.vy - SLOPE_G * dt;
    m.y = m.y + m.vy * dt;
    v: V3 = v3(m.vx, 0.0, m.vz);
    if (v_len(v) > 0.1) m.heading = dir_yaw(v);
    try_course_rail(m);
    if (m.grinding) return;
    h: f32 = course_height(m.x, m.z);
    if (m.y <= h) course_land(m, h)
}

// How he landed off a kicker, gap, or cliff, coming down at d: in the sweet
// spot of its landing, short of it (on a table, or in a gap's pit), past
// it on the flat, or in between. In a halfpipe, back down the wall, clean.
landing_on(f: Feature, d: f32): int {
    if (f.kind == FEATURE_PIPE) return LAND_CLEAN;
    u: f32 = (d - (f.d + landing_start(f))) / f.c;
    if (u < 0.0) return LAND_CASED;
    if (u > 1.05) return LAND_OVERSHOT;
    if (u > 0.12 && u < 0.85) return LAND_STOMPED;
    LAND_CLEAN
}

// Judge what he did in the air, if he came down clean (see judge.l8);
// otherwise it was sketchy. Either way he comes out of it upright, switch
// after an odd number of half turns. On a rail, there is no landing to
// judge.
land_tricks(m: *Mover, on_rail: bool) {
    flips: f32 = floorf(m.flip / TAU + 0.5);
    halves: f32 = floorf(m.spin / PI + 0.5);
    // Clean only if he finished the trick he started, and came down
    // straight.
    clean: bool = absf(m.flip - flips * TAU) < LAND_TOL && absf(m.spin - halves * PI) < LAND_TOL && absf(m.flip_goal - m.flip) < LAND_TOL && absf(m.spin_goal - m.spin) < LAND_TOL;
    item: int = item_of(m.air_from);
    landing: int = LAND_CLEAN;
    if (m.air_from >= 0 && !on_rail) landing = landing_on(features[m.air_from], -m.z);
    // Coming up short of a gap is as bad as landing crooked.
    if (item == FEATURE_GAP && landing == LAND_CASED) clean = false;
    if (clean) {
        kind: int = HIT_FLAT;
        if (m.air_from >= 0) kind = HIT_AIR;
        // A spin to the right turns him clockwise, the negative way.
        judge_air(kind, item, flips as int, -halves as int, m.grab_t / maxf(m.air_time,
            0.01), m.air_time, landing, m.air_switch)
    } else {
        // What he went for.
        judge_sketch(item, floorf(m.flip_goal / TAU + 0.5) as int, -floorf(m.spin_goal / PI + 0.5) as int,
            item == FEATURE_GAP && landing == LAND_CASED, m.air_switch);
        m.sketch_t = 0.0
    }
    // Half a turn and he rides on the other way round; so does coming back
    // down a halfpipe's wall.
    if (absf(halves) as int % 2 == 1) m.fakie = !m.fakie;
    if (m.pipe_vert && !on_rail) m.fakie = !m.fakie;
    m.flip = 0.0;
    m.flip_w = 0.0;
    m.spin = 0.0;
    m.spin_w = 0.0;
    m.flip_goal = 0.0;
    m.spin_goal = 0.0;
    m.grab_t = 0.0;
    m.pad_grab = false
}

mini(a: int, b: int): int {
    if (a < b) return a;
    b
}

course_land(m: *Mover, h: f32) {
    land_tricks(m, false);
    m.air = false;
    m.y = h;
    // His speed carries on along the ground, and a landing down a slope
    // turns some of the fall into more.
    v: V3 = v3(m.vx, 0.0, m.vz);
    sp: f32 = v_len(v);
    d: V3 = carve_dir(m.carve);
    if (sp > 0.1) d = v_scale(v, 1.0 / sp);
    s: f32 = rise_along(m.x, m.z, d);
    if (s < 0.0) sp = sp + -m.vy * -s * 0.4;
    m.speed = clampf(sp, 0.0, TOP_SPEED);
    m.carve = clampf(atan2f(d.x, -d.z), -CARVE_LIMIT, CARVE_LIMIT);
    // Back down a halfpipe's wall, the way he went up it, mirrored.
    if (m.pipe_vert) {
        m.carve = -m.pipe_carve;
        m.speed = m.pipe_speed * 0.96;
        d = carve_dir(m.carve);
        s = rise_along(m.x, m.z, d);
        sp = m.speed
    }
    m.land = -m.vy;
    m.vy = s * sp;
    m.ground_n = course_normal(m.x, m.z)
}

// ---- rails ----
crail_dir(r: CRail): V3 {
    v_norm(v_sub(r.b, r.a))
}

try_course_rail(m: *Mover) {
    if (m.grinding || m.since_grind < 0.3) return;
    for i in 0..ncrails {
        if (!m.grinding) try_one_rail(m, i)
    }
}

try_one_rail(m: *Mover, i: int) {
    r: CRail = crails[i];
    hx: f32 = r.b.x - r.a.x;
    hz: f32 = r.b.z - r.a.z;
    hl2: f32 = hx * hx + hz * hz;
    t: f32 = ((m.x - r.a.x) * hx + (m.z - r.a.z) * hz) / hl2;
    if (t < 0.0 || t > 1.0) return;
    cx: f32 = r.a.x + hx * t;
    cz: f32 = r.a.z + hz * t;
    mag: f32 = RAIL_MAGNET;
    if (r.box) mag = BOX_MAGNET;
    if ((m.x - cx) * (m.x - cx) + (m.z - cz) * (m.z - cz) > mag * mag) return;
    ry: f32 = lerpf(r.a.y, r.b.y, t) + rail_top(r);
    above: f32 = m.y - ry;
    if (m.air) {
        if (m.vy > 0.5 || above > 0.3 || above < -0.3) return;
        // Not in the middle of a trick.
        if (absf(m.flip_goal - m.flip) > LAND_TOL || absf(m.spin_goal - m.spin) > LAND_TOL) return
    } else if (above > 0.1 || above < -0.4) return;
    // Along it, not across.
    v: V3 = v3(m.vx, 0.0, m.vz);
    if (v_len(v) < 0.5 || v_dot(v_norm(v), v_norm(v3(hx, 0.0, hz))) < 0.5) return;
    if (m.air) land_tricks(m, true);
    m.air = false;
    m.manual = false;
    m.grinding = true;
    m.crail = i;
    m.crail_t = t * v_len(v_sub(r.b, r.a));
    m.speed = maxf(v_len(v), PUSH_SPEED);
    m.land = maxf(-m.vy, 0.0) * 0.5;
    m.vy = 0.0;
    place_on_crail(m);
    judge_grind(r.box, m.fakie)
}

place_on_crail(m: *Mover) {
    r: CRail = crails[m.crail];
    u: V3 = crail_dir(r);
    p: V3 = v_madd(r.a, u, m.crail_t);
    m.x = p.x;
    m.y = p.y + rail_top(r);
    m.z = p.z;
    m.vx = u.x * m.speed;
    m.vz = u.z * m.speed;
    m.heading = dir_yaw(v3(u.x, 0.0, u.z));
    m.carve = atan2f(u.x, -u.z);
    m.ground_n = v_norm(v3(0.0, 1.0, 0.0))
}

step_course_grind(m: *Mover, dt: f32) {
    r: CRail = crails[m.crail];
    run_add(GRIND_POINTS * dt);
    m.crail_t = m.crail_t + m.speed * dt;
    len: f32 = v_len(v_sub(r.b, r.a));
    if (m.crail_t > len) {
        if (r.next >= 0) {
            m.crail_t = m.crail_t - len;
            m.crail = r.next
        } else {
            m.crail_t = len;
            place_on_crail(m);
            leave_crail(m, 0.0, 0.0);
            return
        }
    }
    place_on_crail(m)
}

// Off the rail, along it, with a pop of vy and a push to a side.
leave_crail(m: *Mover, vy: f32, side: f32) {
    r: CRail = crails[m.crail];
    u: V3 = crail_dir(r);
    m.grinding = false;
    m.since_grind = 0.0;
    take_off(m);
    m.air_feature = true;
    s: V3 = v_norm(v_cross(u, v3(0.0, 1.0, 0.0)));
    m.vx = u.x * m.speed + s.x * side * 2.0;
    m.vz = u.z * m.speed + s.z * side * 2.0;
    m.vy = u.y * m.speed + vy;
    if (vy > 0.0) {
        m.ollied = true;
        m.since_hop = 0.0
    }
}
