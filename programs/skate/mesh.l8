tag skate;

// Vertex arrays for the world and the guy. A vertex is ten floats: position,
// normal, color, and a material code the fragment shader reads (see
// render.l8): 0 to 1 blends concrete into grass, and the codes below. A
// normal's length is how open the sky is over it, for ambient occlusion:
// most are 1, and the course's ground is darker in its folds.
const VERTEX_FLOATS: int = 10;

const MAT_CONCRETE: f32 = 0.0;

const MAT_GRASS: f32 = 1.0;

const MAT_WOOD: f32 = 3.0;

const MAT_METAL: f32 = 4.0;

const MAT_SOFT: f32 = 5.0;

const MAT_PAINT: f32 = 7.0;

// A kicker's planks: painted wood he rides on, so the marks light them as
// they do the ground.
const MAT_DECK: f32 = 7.3;

const MAT_LEAF: f32 = 9.0;

// Glowing: a lamp's glass, unlit by anything else.
const MAT_GLOW: f32 = 10.0;

type Mesh = {
    data: []f32;
    n: int
}

new_mesh(capacity: int): *Mesh@new {
    new Mesh { data: new f32[capacity * VERTEX_FLOATS](0.0), n: 0 }
}

put(
    m: *Mesh,
    p: V3,
    n: V3,
    c: V3,
    mat: f32
) {
    i: int = m.n * VERTEX_FLOATS;
    if (i + VERTEX_FLOATS > len(m.data)) return;
    m.data[i] = p.x;
    m.data[i + 1] = p.y;
    m.data[i + 2] = p.z;
    m.data[i + 3] = n.x;
    m.data[i + 4] = n.y;
    m.data[i + 5] = n.z;
    m.data[i + 6] = c.x;
    m.data[i + 7] = c.y;
    m.data[i + 8] = c.z;
    m.data[i + 9] = mat;
    m.n = m.n + 1
}

// A flat quad a b c d (in order around it).
put_quad(
    m: *Mesh,
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    n: V3,
    col: V3,
    mat: f32
) {
    put(m, a, n, col, mat);
    put(m, b, n, col, mat);
    put(m, c, n, col, mat);
    put(m, a, n, col, mat);
    put(m, c, n, col, mat);
    put(m, d, n, col, mat)
}

// A block: a box with its top edges bevelled, as a brick, a plank, or a
// post is, its middle at c, its axes right, up, and fwd (each of unit
// length, square to one another), its half sizes h; without its bottom,
// which sits on something. Its sides darken toward their feet.
put_block(
    m: *Mesh,
    c: V3,
    right: V3,
    up: V3,
    fwd: V3,
    h: V3,
    bevel: f32,
    col: V3,
    mat: f32
) {
    b: f32 = minf(bevel, minf(h.x, minf(h.y, h.z)) * 0.9);
    // Corners of the top (inset by the bevel), of the bevel's foot, and of
    // the foot of the sides; going round from -x -z.
    sx: []f32 = [-1.0, 1.0, 1.0, -1.0];
    sz: []f32 = [-1.0, -1.0, 1.0, 1.0];
    top: []V3 = block_ring;
    mid: []V3 = block_ring2;
    foot: []V3 = block_ring3;
    for k in 0..4 {
        top[k] = v_add(v_add(c, v_scale(up, h.y)), v_add(v_scale(right, sx[k] * (h.x - b)),
            v_scale(fwd, sz[k] * (h.z - b))));
        mid[k] = v_add(v_add(c, v_scale(up, h.y - b)), v_add(v_scale(right, sx[k] * h.x),
            v_scale(fwd, sz[k] * h.z)));
        foot[k] = v_add(v_add(c, v_scale(up, -h.y)), v_add(v_scale(right, sx[k] * h.x),
            v_scale(fwd, sz[k] * h.z)))
    }
    put_quad(m, top[0], top[3], top[2], top[1], up, col, mat);
    for k in 0..4 {
        n: int = (k + 1) % 4;
        // Outward across this edge.
        out: V3 = v_norm(v_add(v_scale(right, sx[k] + sx[n]), v_scale(fwd, sz[k] + sz[n])));
        put_quad(m, top[k], top[n], mid[n], mid[k], v_norm(v_add(up, out)), col, mat);
        put_quad_n(m, mid[k], mid[n], foot[n], foot[k], out, out, v_scale(out, 0.6),
            v_scale(out, 0.6), col, mat)
    }
}

block_ring: []V3 = new V3[4](V3 { x: 0.0, y: 0.0, z: 0.0 });

block_ring2: []V3 = new V3[4](V3 { x: 0.0, y: 0.0, z: 0.0 });

block_ring3: []V3 = new V3[4](V3 { x: 0.0, y: 0.0, z: 0.0 });

// A quad with a normal at each corner.
put_quad_n(
    m: *Mesh,
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    na: V3,
    nb: V3,
    nc: V3,
    nd: V3,
    col: V3,
    mat: f32
) {
    put(m, a, na, col, mat);
    put(m, b, nb, col, mat);
    put(m, c, nc, col, mat);
    put(m, a, na, col, mat);
    put(m, c, nc, col, mat);
    put(m, d, nd, col, mat)
}

// ---- rounded boxes ----
// Samples along one axis of a box's face, in [-1, 1]: bands of `band` steps
// over the rounded edges and a step either side of the middle.
box_samples(
    out: []f32,
    half: f32,
    r: f32,
    band: int
): int {
    c: f32 = (half - r) / half;
    if (c < 0.0) c = 0.0;
    n: int = 0;
    for i in 0..band + 1 {
        out[n] = -1.0 + (1.0 - c) * i as f32 / band as f32;
        n = n + 1
    }
    if (c > 0.0) {
        out[n] = 0.0;
        n = n + 1;
        for i in 0..band + 1 {
            out[n] = c + (1.0 - c) * i as f32 / band as f32;
            n = n + 1
        }
    } else {
        for i in 1..band + 1 {
            out[n] = (1.0 - c) * i as f32 / band as f32;
            n = n + 1
        }
    }
    n
}

box_point(
    q: V3,
    half: V3,
    r: f32,
    bulge: f32,
    out_n: *V3
): V3 {
    p: V3 = v3(q.x * half.x, q.y * half.y, q.z * half.z);
    inner: V3 = v3(clampf(p.x, -(half.x - r), half.x - r), clampf(p.y, -(half.y - r),
        half.y - r), clampf(p.z, -(half.z - r), half.z - r));
    n: V3 = v_norm(v_sub(p, inner));
    // Faces puff out toward their middles.
    puff: f32 = (1.0 - q.x * q.x * absf(q.x)) * (1.0 - q.y * q.y * absf(q.y)) * (1.0 - q.z * q.z * absf(q.z));
    out_n.* = n;
    v_madd(inner, n, r + bulge * puff * 4.0)
}

box_su: []f32 = new f32[64](0.0);

box_sv: []f32 = new f32[64](0.0);

// A rounded box of half sizes `half` and corner radius r, puffed out by
// bulge, placed by the matrix xf.
put_rounded_box(
    m: *Mesh,
    xf: []f32,
    half: V3,
    r: f32,
    bulge: f32,
    band: int,
    col: V3,
    mat: f32
) {
    for axis in 0..3 {
        for side in 0..2 {
            s: f32 = 1.0;
            if (side == 0) s = -1.0;
            // Axes u and v across the face.
            hu: f32 = half.y;
            hv: f32 = half.z;
            if (axis == 1) {
                hu = half.z;
                hv = half.x
            }
            if (axis == 2) {
                hu = half.x;
                hv = half.y
            }
            nu: int = box_samples(box_su, hu, r, band);
            nv: int = box_samples(box_sv, hv, r, band);
            for i in 0..nu - 1 {
                for j in 0..nv - 1 {
                    a: V3 = face_q(axis, s, box_su[i], box_sv[j]);
                    b: V3 = face_q(axis, s, box_su[i + 1], box_sv[j]);
                    c: V3 = face_q(axis, s, box_su[i + 1], box_sv[j + 1]);
                    d: V3 = face_q(axis, s, box_su[i], box_sv[j + 1]);
                    na: V3 = v3(0.0, 1.0, 0.0);
                    nb: V3 = na;
                    nc: V3 = na;
                    nd: V3 = na;
                    pa: V3 = box_point(a, half, r, bulge, &na);
                    pb: V3 = box_point(b, half, r, bulge, &nb);
                    pc: V3 = box_point(c, half, r, bulge, &nc);
                    pd: V3 = box_point(d, half, r, bulge, &nd);
                    put_quad_n(m, mat_point(xf, pa), mat_point(xf, pb), mat_point(xf,
                        pc), mat_point(xf, pd), v_norm(mat_vector(xf, na)), v_norm(mat_vector(xf,
                        nb)), v_norm(mat_vector(xf, nc)), v_norm(mat_vector(xf, nd)),
                        col, mat)
                }
            }
        }
    }
}

face_q(
    axis: int,
    s: f32,
    u: f32,
    v: f32
): V3 {
    if (axis == 0) return v3(s, u, v);
    if (axis == 1) return v3(v, s, u);
    v3(u, v, s)
}

// A tube from a to b.
put_tube(
    m: *Mesh,
    a: V3,
    b: V3,
    radius: f32,
    col: V3,
    mat: f32
) {
    axis: V3 = v_norm(v_sub(b, a));
    p: V3 = v_norm(v_cross(axis, v3(0.0, 1.0, 0.0)));
    if (absf(axis.y) > 0.9) p = v_norm(v_cross(axis, v3(1.0, 0.0, 0.0)));
    q: V3 = v_cross(axis, p);
    sides: int = 10;
    for i in 0..sides {
        a0: f32 = TAU * i as f32 / sides as f32;
        a1: f32 = TAU * (i + 1) as f32 / sides as f32;
        n0: V3 = v_add(v_scale(p, cosf(a0)), v_scale(q, sinf(a0)));
        n1: V3 = v_add(v_scale(p, cosf(a1)), v_scale(q, sinf(a1)));
        put_quad_n(m, v_madd(a, n0, radius), v_madd(a, n1, radius), v_madd(b, n1,
            radius), v_madd(b, n0, radius), n0, n1, n1, n0, col, mat)
    }
}

// ---- the arena ----
xf: []f32 = new f32[16](0.0);

// Blocks have vertical walls, and their tops round over (radius RIM) along
// edges where they drop to a lower neighbor. Ground at the foot of a wall is
// a little darker. Physics keeps the crisp blocks; the rounding is narrower
// than his footprint. Cells beside a change of height are sampled finely
// near their edges, the rest coarsely; a pool's curved walls, finely all
// over.
const RIM: f32 = 0.1;

// A little variety from cell to cell.
cell_jitter(i: int, j: int): f32 {
    h: int = (i * 73856093 + j * 19349663) % 1000;
    if (h < 0) h = -h;
    h as f32 / 1000.0
}

grass_color: V3 = V3 { x: 0.3, y: 0.48, z: 0.22 };

wood_color: V3 = V3 { x: 0.84, y: 0.66, z: 0.44 };

steps: []int = new int[4](0);

steel: V3 = V3 { x: 0.72, y: 0.74, z: 0.78 };

// ---- grass and flowers ----
meadow_rng: int = 1;

meadow_rand(): f32 {
    meadow_rng = (meadow_rng * 1103515245 + 12345) % 2147483648;
    (meadow_rng % 100000) as f32 / 100000.0
}

// A tuft of grass: a few blades leaning out from a point.
put_tuft(
    m: *Mesh,
    x: f32,
    y: f32,
    z: f32,
    size: f32
) {
    blades: int = 4;
    shade: f32 = 0.8 + 0.4 * meadow_rand();
    for b in 0..blades {
        a: f32 = TAU * (b as f32 + meadow_rand() * 0.6) / blades as f32;
        dx: f32 = cosf(a);
        dz: f32 = sinf(a);
        hgt: f32 = size * (0.7 + 0.6 * meadow_rand());
        lean: f32 = size * 0.45;
        w: f32 = size * 0.12;
        base: V3 = v3(x + dx * 0.02, y, z + dz * 0.02);
        tip: V3 = v3(x + dx * lean, y + hgt, z + dz * lean);
        side: V3 = v3(-dz * w, 0.0, dx * w);
        n: V3 = v_norm(v3(dx * 0.4, 1.0, dz * 0.4));
        dark: V3 = v3(0.22 * shade, 0.42 * shade, 0.16 * shade);
        light: V3 = v3(0.46 * shade, 0.70 * shade, 0.30 * shade);
        put(m, v_add(base, side), n, dark, MAT_LEAF);
        put(m, v_sub(base, side), n, dark, MAT_LEAF);
        put(m, tip, n, light, MAT_LEAF)
    }
}

flower_colors: []f32 = [1.0, 0.97, 0.9, 1.0, 0.85, 0.3, 0.98, 0.6, 0.75, 0.75, 0.7,
    1.0];

// A flower: a little ball of color on a stem.
put_flower(
    m: *Mesh,
    x: f32,
    y: f32,
    z: f32
) {
    k: int = (meadow_rand() * 4.0) as int % 4;
    c: V3 = v3(flower_colors[k * 3], flower_colors[k * 3 + 1], flower_colors[k * 3 + 2]);
    h: f32 = 0.12 + 0.08 * meadow_rand();
    put_tube(m, v3(x, y, z), v3(x, y + h, z), 0.008, v3(0.3, 0.5, 0.2), MAT_LEAF);
    put_blob(m, v3(x, y + h, z), 0.045, c)
}

// An octahedron, rounded by its normals.
put_blob(
    m: *Mesh,
    c: V3,
    r: f32,
    col: V3
) {
    for s in 0..8 {
        sx: f32 = 1.0;
        sy: f32 = 1.0;
        sz: f32 = 1.0;
        if (s % 2 == 1) sx = -1.0;
        if (s / 2 % 2 == 1) sy = -1.0;
        if (s / 4 == 1) sz = -1.0;
        a: V3 = v3(sx, 0.0, 0.0);
        b: V3 = v3(0.0, sy, 0.0);
        d: V3 = v3(0.0, 0.0, sz);
        put(m, v_madd(c, a, r), a, col, MAT_PAINT);
        put(m, v_madd(c, b, r), b, col, MAT_PAINT);
        put(m, v_madd(c, d, r), d, col, MAT_PAINT)
    }
}

// ---- scenery ----
// Trees: broad oaks and pines, each one a little different. A crown is a
// few clumps of small leaves around darker cores, so its edges break up
// and light comes through; a pine is tiers of drooping needle sprays.
put_tree(
    m: *Mesh,
    x: f32,
    z: f32,
    ground: f32,
    size: f32
) {
    meadow_rng = absi_m((x * 73.0) as int * 977 + (z * 31.0) as int * 131 + 7) + 1;
    pine: bool = meadow_rand() < 0.35;
    if (far_lod) put_far_tree(m, x, z, ground - 0.05, size, pine) else if (pine) put_pine(m,
        x, z, ground - 0.05, size * 1.1) else put_oak(m, x, z, ground - 0.05, size)
}

// A tree far away: a trunk and a crown.
put_far_tree(
    m: *Mesh,
    x: f32,
    z: f32,
    y: f32,
    size: f32,
    pine: bool
) {
    shade: f32 = 0.85 + 0.3 * meadow_rand();
    if (pine) {
        s: f32 = size * 1.1;
        put_cone(m, v3(x, y, z), v3(x, y + 4.2 * s, z), 0.16 * s, 0.03 * s, bark);
        put_cone(m, v3(x, y + 0.7 * s, z), v3(x, y + 4.4 * s, z), 1.2 * s, 0.05, v3(0.13 * shade,
            0.3 * shade, 0.17 * shade));
        return
    }
    put_cone(m, v3(x, y, z), v3(x, y + 1.8 * size, z), 0.2 * size, 0.11 * size, bark);
    put_ellipsoid(m, v3(x, y + 2.7 * size, z), v3(1.4 * size, 1.1 * size, 1.4 * size),
        v3(0.27 * shade, 0.48 * shade, 0.17 * shade), MAT_LEAF)
}

absi_m(a: int): int {
    if (a < 0) return -a;
    a
}

bark: V3 = V3 { x: 0.36, y: 0.27, z: 0.2 };

put_oak(
    m: *Mesh,
    x: f32,
    z: f32,
    y: f32,
    size: f32
) {
    base: V3 = v3(x, y, z);
    lean: V3 = v3((meadow_rand() - 0.5) * 0.4, 0.0, (meadow_rand() - 0.5) * 0.4);
    top: V3 = v_add(v3(x, y + 1.7 * size, z), v_scale(lean, size));
    put_cone(m, base, top, 0.2 * size, 0.11 * size, bark);
    shade: f32 = 0.85 + 0.3 * meadow_rand();
    leaf: V3 = v_scale(look.leaf, shade);
    clumps: int = 3 + (meadow_rand() * 2.0) as int;
    for k in 0..clumps {
        a: f32 = TAU * (k as f32 + meadow_rand() * 0.5) / clumps as f32;
        out: f32 = 0.55 * size * (0.6 + 0.6 * meadow_rand());
        c: V3 = v_add(top, v3(cosf(a) * out, (0.7 + 0.6 * meadow_rand()) * size, sinf(a) * out));
        // A branch out to it.
        put_cone(m, v_lerp(base, top, 0.8), v_lerp(top, c, 0.7), 0.08 * size, 0.04 * size,
            bark);
        r: f32 = (0.75 + 0.35 * meadow_rand()) * size;
        put_clump(m, c, v3(r, r * 0.75, r), leaf, 48)
    }
    // And one on top.
    put_clump(m, v_add(top, v3(0.0, 1.5 * size, 0.0)), v3(0.8 * size, 0.6 * size,
        0.8 * size), leaf, 40)
}

// A clump of leaves round c: a dark core, and leaves scattered over it, lit
// as if the clump were round.
put_clump(
    m: *Mesh,
    c: V3,
    r: V3,
    leaf: V3,
    count: int
) {
    put_ellipsoid(m, c, v_scale(r, 0.82), v_scale(leaf, 0.55), MAT_LEAF);
    for _k in 0..count {
        // A direction, mostly up and out.
        u: f32 = meadow_rand() * 2.0 - 1.0;
        a: f32 = meadow_rand() * TAU;
        sq: f32 = sqrtf(maxf(0.0, 1.0 - u * u));
        d: V3 = v3(sq * cosf(a), u * 0.9 + 0.1, sq * sinf(a));
        d = v_norm(d);
        p: V3 = v3(c.x + d.x * r.x, c.y + d.y * r.y, c.z + d.z * r.z);
        p = v_lerp(c, p, 0.88 + 0.22 * meadow_rand());
        // A leaf: a small triangle at a random tilt.
        t1: V3 = v_norm(v_cross(d, v3(meadow_rand() - 0.5, 1.0, meadow_rand() - 0.5)));
        t2: V3 = v_cross(d, t1);
        sz: f32 = (0.22 + 0.14 * meadow_rand()) * maxf(r.x, 0.6);
        k: f32 = 0.8 + 0.4 * meadow_rand();
        // Leaves on the sunny top are a little yellower.
        col: V3 = v3(leaf.x * k * (1.0 + 0.25 * maxf(d.y, 0.0)), leaf.y * k, leaf.z * k);
        n: V3 = v_norm(v_add(d, v_scale(t2, 0.3)));
        put(m, v_madd(p, t1, sz), n, col, MAT_LEAF);
        put(m, v_madd(v_madd(p, t1, -sz * 0.5), t2, sz * 0.8), n, col, MAT_LEAF);
        put(m, v_madd(v_madd(p, t1, -sz * 0.5), t2, -sz * 0.8), n, col, MAT_LEAF)
    }
}

put_pine(
    m: *Mesh,
    x: f32,
    z: f32,
    y: f32,
    size: f32
) {
    h: f32 = 4.2 * size;
    put_cone(m, v3(x, y, z), v3(x, y + h, z), 0.16 * size, 0.03 * size, bark);
    shade: f32 = 0.85 + 0.3 * meadow_rand();
    needle: V3 = v3(0.13 * shade, 0.3 * shade, 0.17 * shade);
    tiers: int = 6;
    for t in 0..tiers {
        f: f32 = t as f32 / tiers as f32;
        ty: f32 = y + h * (0.22 + 0.72 * f);
        reach: f32 = size * (1.25 - 1.0 * f) * (0.85 + 0.3 * meadow_rand());
        sprays: int = 9;
        turn: f32 = meadow_rand() * TAU;
        // A dark core for the tier.
        put_cone(m, v3(x, ty - 0.45 * size, z), v3(x, ty + 0.35 * size, z), reach * 0.7,
            0.05, v_scale(needle, 0.6));
        for k in 0..sprays {
            a: f32 = turn + TAU * (k as f32 + 0.4 * meadow_rand()) / sprays as f32;
            d: V3 = v3(cosf(a), 0.0, sinf(a));
            side: V3 = v3(-d.z, 0.0, d.x);
            root: V3 = v3(x, ty, z);
            tip: V3 = v3(x + d.x * reach, ty - 0.5 * reach, z + d.z * reach);
            w: f32 = reach * 0.42;
            n: V3 = v_norm(v3(d.x * 0.6, 1.0, d.z * 0.6));
            k2: f32 = 0.85 + 0.3 * meadow_rand();
            col: V3 = v_scale(needle, k2);
            put(m, v_madd(root, side, w), n, col, MAT_LEAF);
            put(m, tip, n, v_scale(col, 1.15), MAT_LEAF);
            put(m, v_madd(root, side, -w), n, col, MAT_LEAF);
            // And its underside, darker.
            put(m, v_madd(v_madd(root, side, w * 0.8), v3(0.0, -0.12 * size, 0.0),
                1.0), v3(0.0, -1.0, 0.0), v_scale(col, 0.55), MAT_LEAF);
            put(m, v_madd(root, side, -w * 0.8), v3(0.0, -1.0, 0.0), v_scale(col,
                0.55), MAT_LEAF);
            put(m, tip, v3(0.0, -1.0, 0.0), v_scale(col, 0.55), MAT_LEAF)
        }
    }
}

// A cone from a (radius ra) to b (radius rb), its sides only.
put_cone(
    m: *Mesh,
    a: V3,
    b: V3,
    ra: f32,
    rb: f32,
    col: V3
) {
    axis: V3 = v_norm(v_sub(b, a));
    p: V3 = v_norm(v_cross(axis, v3(0.0, 1.0, 0.0)));
    if (absf(axis.y) > 0.9) p = v_norm(v_cross(axis, v3(1.0, 0.0, 0.0)));
    q: V3 = v_cross(axis, p);
    sides: int = 8;
    slope: f32 = (ra - rb) / maxf(v_len(v_sub(b, a)), 0.01);
    for i in 0..sides {
        a0: f32 = TAU * i as f32 / sides as f32;
        a1: f32 = TAU * (i + 1) as f32 / sides as f32;
        n0: V3 = v_add(v_scale(p, cosf(a0)), v_scale(q, sinf(a0)));
        n1: V3 = v_add(v_scale(p, cosf(a1)), v_scale(q, sinf(a1)));
        m0: V3 = v_norm(v_madd(n0, axis, slope));
        m1: V3 = v_norm(v_madd(n1, axis, slope));
        put_quad_n(m, v_madd(a, n0, ra), v_madd(a, n1, ra), v_madd(b, n1, rb), v_madd(b,
            n0, rb), m0, m1, m1, m0, col, MAT_PAINT)
    }
}

// An ellipsoid round c with radii r, smooth, coarse.
put_ellipsoid(
    m: *Mesh,
    c: V3,
    r: V3,
    col: V3,
    mat: f32
) {
    us: int = 8;
    vs: int = 5;
    for j in 0..vs {
        for i in 0..us {
            p00: V3 = ell_dir(i, j, us, vs);
            p10: V3 = ell_dir(i + 1, j, us, vs);
            p11: V3 = ell_dir(i + 1, j + 1, us, vs);
            p01: V3 = ell_dir(i, j + 1, us, vs);
            put_quad_n(m, ell_at(c, r, p00), ell_at(c, r, p10), ell_at(c, r, p11),
                ell_at(c, r, p01), p00, p10, p11, p01, col, mat)
        }
    }
}

ell_dir(
    i: int,
    j: int,
    us: int,
    vs: int
): V3 {
    a: f32 = TAU * i as f32 / us as f32;
    b: f32 = PI * j as f32 / vs as f32;
    v3(sinf(b) * cosf(a), cosf(b), sinf(b) * sinf(a))
}

ell_at(c: V3, r: V3, d: V3): V3 {
    v3(c.x + d.x * r.x, c.y + d.y * r.y, c.z + d.z * r.z)
}

// ---- the guy and his board ----
// He is one tall block, a third of it split into two halves that walk, with
// little arms. Parts are built in their own frames: the body from its base,
// legs and arms hanging from their hip and shoulder, the board from the
// ground under its wheels, nose toward +z.
const PART_BODY: int = 0;

const PART_LEG: int = 1;

const PART_ARM: int = 2;

const PART_BOARD: int = 3;

const PART_COUNT: int = 4;

part_first: []int = new int[PART_COUNT](0);

part_count: []int = new int[PART_COUNT](0);

const GUY_W: f32 = 0.62;

const GUY_D: f32 = 0.6;

const GUY_H: f32 = 0.93;

const LEG_H: f32 = 0.36;

const LEG_GAP: f32 = 0.035;

const DECK_Y: f32 = 0.17;

const DECK_TOP: f32 = 0.2075;

body_color: V3 = V3 { x: 0.90, y: 0.22, z: 0.18 };

part_begin(m: *Mesh, part: int) {
    part_first[part] = m.n
}

part_end(m: *Mesh, part: int) {
    part_count[part] = m.n - part_first[part]
}

at(x: f32, y: f32, z: f32) {
    mat_identity(xf);
    xf[12] = x;
    xf[13] = y;
    xf[14] = z
}

build_parts(m: *Mesh) {
    m.n = 0;
    part_begin(m, PART_BODY);
    // It reaches down past the hips so its rounded bottom hides behind the
    // legs.
    bottom: f32 = LEG_H - 0.1;
    at(0.0, (bottom + GUY_H) * 0.5, 0.0);
    put_rounded_box(m, xf, v3(GUY_W * 0.5, (GUY_H - bottom) * 0.5, GUY_D * 0.5), 0.1,
        0.01, 3, body_color, MAT_SOFT);
    part_end(m, PART_BODY);
    part_begin(m, PART_LEG);
    lw: f32 = (GUY_W - LEG_GAP) * 0.25;
    at(0.0, -LEG_H * 0.5 + 0.03, 0.0);
    put_rounded_box(m, xf, v3(lw, LEG_H * 0.5 + 0.03, GUY_D * 0.5 - 0.005), 0.07,
        0.004, 2, body_color, MAT_SOFT);
    part_end(m, PART_LEG);
    part_begin(m, PART_ARM);
    // Arms are flat paddles set into his sides, part of the block.
    at(0.0, -0.12, 0.0);
    put_rounded_box(m, xf, v3(0.05, 0.14, 0.15), 0.045, 0.006, 2, body_color, MAT_SOFT);
    part_end(m, PART_ARM);
    part_begin(m, PART_BOARD);
    build_board(m);
    part_end(m, PART_BOARD)
}

// A pudgy board: a thick pill of a deck with a round rim and tips that turn
// up a little, on fat wheels.
build_board(m: *Mesh) {
    deck: V3 = v3(0.98, 0.72, 0.28);
    half_len: f32 = 0.27;
    radius: f32 = 0.17;
    rim: f32 = 0.0375;
    steps: int = 40;
    rings: int = 8;
    points: int = steps + 2;
    for k in 0..points {
        k1: int = (k + 1) % points;
        for r in 0..rings put_deck_quad(m, k, k1, r, steps, rings, half_len, radius,
            rim, deck);
        // Top and bottom: fans from the middle line.
        a0: V3 = deck_outline(k, steps, half_len, radius - rim);
        a1: V3 = deck_outline(k1, steps, half_len, radius - rim);
        for s in 0..2 {
            y: f32 = rim;
            nn: V3 = v3(0.0, 1.0, 0.0);
            if (s == 0) {
                y = -rim;
                nn = v3(0.0, -1.0, 0.0)
            }
            c: V3 = v3(0.0, 0.0, clampf(a0.z, -half_len, half_len));
            c1: V3 = v3(0.0, 0.0, clampf(a1.z, -half_len, half_len));
            put_quad(m, deck_lift(c, y), deck_lift(v3(a0.x, 0.0, a0.z), y), deck_lift(v3(a1.x,
                0.0, a1.z), y), deck_lift(c1, y), nn, deck, MAT_PAINT)
        }
    }
    for e in 0..2 {
        s: f32 = 1.0;
        if (e == 0) s = -1.0;
        at(0.0, 0.115, s * 0.2);
        put_rounded_box(m, xf, v3(0.1, 0.03, 0.035), 0.025, 0.0, 1, v3(0.62, 0.64,
            0.68), MAT_METAL);
        for w in 0..2 {
            sx: f32 = 1.0;
            if (w == 0) sx = -1.0;
            at(sx * 0.13, 0.065, s * 0.2);
            put_rounded_box(m, xf, v3(0.045, 0.065, 0.065), 0.044, 0.004, 2, v3(0.97,
                0.95, 0.88), MAT_PAINT)
        }
    }
}

// The deck's outline, a stadium with its straight sides along z, as a
// closed loop of steps + 2 points: a half circle round the nose, then one
// round the tail. Joining the halves' ends makes the straight sides.
deck_angle(k: int, steps: int): f32 {
    half: int = steps / 2;
    if (k <= half) return PI * k as f32 / half as f32;
    PI + PI * (k - half - 1) as f32 / half as f32
}

deck_outline(
    k: int,
    steps: int,
    half_len: f32,
    r: f32
): V3 {
    a: f32 = deck_angle(k, steps);
    zc: f32 = half_len;
    if (k > steps / 2) zc = -half_len;
    v3(r * cosf(a), 0.0, zc + r * sinf(a))
}

deck_normal(k: int, steps: int): V3 {
    a: f32 = deck_angle(k, steps);
    v3(cosf(a), 0.0, sinf(a))
}

// Raise a deck point to its height, its tips turned up.
deck_lift(p: V3, y: f32): V3 {
    t: f32 = maxf(absf(p.z) - 0.2, 0.0);
    v3(p.x, DECK_Y + y + t * t * 0.9, p.z)
}

put_deck_quad(
    m: *Mesh,
    k: int,
    k1: int,
    r: int,
    steps: int,
    rings: int,
    half_len: f32,
    radius: f32,
    rim: f32,
    col: V3
) {
    b0: V3 = deck_outline(k, steps, half_len, radius - rim);
    b1: V3 = deck_outline(k1, steps, half_len, radius - rim);
    n0: V3 = deck_normal(k, steps);
    n1: V3 = deck_normal(k1, steps);
    f0: f32 = PI * (r as f32 / rings as f32 - 0.5);
    f1: f32 = PI * ((r + 1) as f32 / rings as f32 - 0.5);
    put_quad_n(m, rim_point(b0, n0, rim, f0), rim_point(b1, n1, rim, f0), rim_point(b1,
        n1, rim, f1), rim_point(b0, n0, rim, f1), rim_normal(n0, f0), rim_normal(n1,
        f0), rim_normal(n1, f1), rim_normal(n0, f1), col, MAT_PAINT)
}

rim_point(
    base: V3,
    n: V3,
    rim: f32,
    f: f32
): V3 {
    p: V3 = v_madd(base, n, rim * cosf(f));
    deck_lift(v3(p.x, 0.0, p.z), rim * sinf(f))
}

rim_normal(n: V3, f: f32): V3 {
    v3(n.x * cosf(f), sinf(f), n.z * cosf(f))
}
