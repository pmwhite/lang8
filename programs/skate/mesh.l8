tag skate;

// Vertex arrays for the world and the guy. A vertex is ten floats: position,
// normal, color, and a material code the fragment shader reads (see
// render.l8): 0 to 1 blends concrete into grass, and the codes below.
const VERTEX_FLOATS: int = 10;

const MAT_CONCRETE: f32 = 0.0;

const MAT_GRASS: f32 = 1.0;

const MAT_PAVERS: f32 = 2.0;

// A pool's painted concrete; it shades as a variant of pavers, so the two
// meet crisply at the coping.
const MAT_POOL: f32 = 2.4;

const MAT_WOOD: f32 = 3.0;

const MAT_METAL: f32 = 4.0;

const MAT_SOFT: f32 = 5.0;

const MAT_SLABS: f32 = 6.0;

const MAT_PAINT: f32 = 7.0;

const MAT_TILES: f32 = 8.0;

const MAT_LEAF: f32 = 9.0;

type Mesh = {
    data: []f32;
    n: int
}

new_mesh(capacity: int): *Mesh@new {
    new Mesh { data: new f32[capacity * VERTEX_FLOATS](0.0), n: 0 }
}

put(
    m: *Mesh,
    p: V3,
    n: V3,
    c: V3,
    mat: f32
) {
    i: int = m.n * VERTEX_FLOATS;
    if (i + VERTEX_FLOATS > len(m.data)) return;
    m.data[i] = p.x;
    m.data[i + 1] = p.y;
    m.data[i + 2] = p.z;
    m.data[i + 3] = n.x;
    m.data[i + 4] = n.y;
    m.data[i + 5] = n.z;
    m.data[i + 6] = c.x;
    m.data[i + 7] = c.y;
    m.data[i + 8] = c.z;
    m.data[i + 9] = mat;
    m.n = m.n + 1
}

// A flat quad a b c d (in order around it).
put_quad(
    m: *Mesh,
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    n: V3,
    col: V3,
    mat: f32
) {
    put(m, a, n, col, mat);
    put(m, b, n, col, mat);
    put(m, c, n, col, mat);
    put(m, a, n, col, mat);
    put(m, c, n, col, mat);
    put(m, d, n, col, mat)
}

// A quad with a normal at each corner.
put_quad_n(
    m: *Mesh,
    a: V3,
    b: V3,
    c: V3,
    d: V3,
    na: V3,
    nb: V3,
    nc: V3,
    nd: V3,
    col: V3,
    mat: f32
) {
    put(m, a, na, col, mat);
    put(m, b, nb, col, mat);
    put(m, c, nc, col, mat);
    put(m, a, na, col, mat);
    put(m, c, nc, col, mat);
    put(m, d, nd, col, mat)
}

// ---- rounded boxes ----
// Samples along one axis of a box's face, in [-1, 1]: bands of `band` steps
// over the rounded edges and a step either side of the middle.
box_samples(
    out: []f32,
    half: f32,
    r: f32,
    band: int
): int {
    c: f32 = (half - r) / half;
    if (c < 0.0) c = 0.0;
    n: int = 0;
    for i in 0..band + 1 {
        out[n] = -1.0 + (1.0 - c) * i as f32 / band as f32;
        n = n + 1
    }
    if (c > 0.0) {
        out[n] = 0.0;
        n = n + 1;
        for i in 0..band + 1 {
            out[n] = c + (1.0 - c) * i as f32 / band as f32;
            n = n + 1
        }
    } else {
        for i in 1..band + 1 {
            out[n] = (1.0 - c) * i as f32 / band as f32;
            n = n + 1
        }
    }
    n
}

box_point(
    q: V3,
    half: V3,
    r: f32,
    bulge: f32,
    out_n: *V3
): V3 {
    p: V3 = v3(q.x * half.x, q.y * half.y, q.z * half.z);
    inner: V3 = v3(clampf(p.x, -(half.x - r), half.x - r), clampf(p.y, -(half.y - r),
        half.y - r), clampf(p.z, -(half.z - r), half.z - r));
    n: V3 = v_norm(v_sub(p, inner));
    // Faces puff out toward their middles.
    puff: f32 = (1.0 - q.x * q.x * absf(q.x)) * (1.0 - q.y * q.y * absf(q.y)) * (1.0 - q.z * q.z * absf(q.z));
    out_n.* = n;
    v_madd(inner, n, r + bulge * puff * 4.0)
}

box_su: []f32 = new f32[64](0.0);

box_sv: []f32 = new f32[64](0.0);

// A rounded box of half sizes `half` and corner radius r, puffed out by
// bulge, placed by the matrix xf.
put_rounded_box(
    m: *Mesh,
    xf: []f32,
    half: V3,
    r: f32,
    bulge: f32,
    band: int,
    col: V3,
    mat: f32
) {
    for axis in 0..3 {
        for side in 0..2 {
            s: f32 = 1.0;
            if (side == 0) s = -1.0;
            // Axes u and v across the face.
            hu: f32 = half.y;
            hv: f32 = half.z;
            if (axis == 1) {
                hu = half.z;
                hv = half.x
            }
            if (axis == 2) {
                hu = half.x;
                hv = half.y
            }
            nu: int = box_samples(box_su, hu, r, band);
            nv: int = box_samples(box_sv, hv, r, band);
            for i in 0..nu - 1 {
                for j in 0..nv - 1 {
                    a: V3 = face_q(axis, s, box_su[i], box_sv[j]);
                    b: V3 = face_q(axis, s, box_su[i + 1], box_sv[j]);
                    c: V3 = face_q(axis, s, box_su[i + 1], box_sv[j + 1]);
                    d: V3 = face_q(axis, s, box_su[i], box_sv[j + 1]);
                    na: V3 = v3(0.0, 1.0, 0.0);
                    nb: V3 = na;
                    nc: V3 = na;
                    nd: V3 = na;
                    pa: V3 = box_point(a, half, r, bulge, &na);
                    pb: V3 = box_point(b, half, r, bulge, &nb);
                    pc: V3 = box_point(c, half, r, bulge, &nc);
                    pd: V3 = box_point(d, half, r, bulge, &nd);
                    put_quad_n(m, mat_point(xf, pa), mat_point(xf, pb), mat_point(xf,
                        pc), mat_point(xf, pd), v_norm(mat_vector(xf, na)), v_norm(mat_vector(xf,
                        nb)), v_norm(mat_vector(xf, nc)), v_norm(mat_vector(xf, nd)),
                        col, mat)
                }
            }
        }
    }
}

face_q(
    axis: int,
    s: f32,
    u: f32,
    v: f32
): V3 {
    if (axis == 0) return v3(s, u, v);
    if (axis == 1) return v3(v, s, u);
    v3(u, v, s)
}

// A tube from a to b.
put_tube(
    m: *Mesh,
    a: V3,
    b: V3,
    radius: f32,
    col: V3,
    mat: f32
) {
    axis: V3 = v_norm(v_sub(b, a));
    p: V3 = v_norm(v_cross(axis, v3(0.0, 1.0, 0.0)));
    if (absf(axis.y) > 0.9) p = v_norm(v_cross(axis, v3(1.0, 0.0, 0.0)));
    q: V3 = v_cross(axis, p);
    sides: int = 10;
    for i in 0..sides {
        a0: f32 = TAU * i as f32 / sides as f32;
        a1: f32 = TAU * (i + 1) as f32 / sides as f32;
        n0: V3 = v_add(v_scale(p, cosf(a0)), v_scale(q, sinf(a0)));
        n1: V3 = v_add(v_scale(p, cosf(a1)), v_scale(q, sinf(a1)));
        put_quad_n(m, v_madd(a, n0, radius), v_madd(a, n1, radius), v_madd(b, n1,
            radius), v_madd(b, n0, radius), n0, n1, n1, n0, col, mat)
    }
}

// ---- the arena ----
xf: []f32 = new f32[16](0.0);

// Blocks have vertical walls, and their tops round over (radius RIM) along
// edges where they drop to a lower neighbor. Ground at the foot of a wall is
// a little darker. Physics keeps the crisp blocks; the rounding is narrower
// than his footprint. Cells beside a change of height are sampled finely
// near their edges, the rest coarsely; a pool's curved walls, finely all
// over.
const RIM: f32 = 0.1;

fine_offsets: []f32 = [0.0, 0.025, 0.06, 0.1, 0.25, 0.5, 0.75, 0.9, 0.94, 0.975, 1.0];

curve_offsets: []f32 = [0.0, 0.05, 0.15, 0.3, 0.5, 0.7, 0.85, 0.95, 1.0];

coarse_offsets: []f32 = [0.0, 0.5, 1.0];

shade_offsets: []f32 = [0.0, 0.12, 0.3, 0.5, 0.7, 0.88, 1.0];

// Samples across a cell along one axis, given how it meets its neighbors at
// either end (see edge_step).
axis_offsets(hi: int, lo: int): []f32 {
    if (hi == 1 || lo == 1) return fine_offsets;
    if (hi == -1 || lo == -1) return shade_offsets;
    coarse_offsets
}

// A little variety from cell to cell.
cell_jitter(i: int, j: int): f32 {
    h: int = (i * 73856093 + j * 19349663) % 1000;
    if (h < 0) h = -h;
    h as f32 / 1000.0
}

grass_color: V3 = V3 { x: 0.40, y: 0.60, z: 0.25 };

wood_color: V3 = V3 { x: 0.84, y: 0.66, z: 0.44 };

// Each level is paved differently: a pale blue pool floor, warm gray pavers
// on the plaza, sandstone slabs a level up, terracotta tiles above that.
paving_color(level: int): V3 {
    if (level <= 1) return v3(0.56, 0.72, 0.82);
    if (level == 3) return v3(0.82, 0.72, 0.56);
    if (level >= 4) return v3(0.80, 0.50, 0.38);
    v3(0.66, 0.62, 0.58)
}

paving_mat(level: int): f32 {
    if (level <= 1) return MAT_POOL;
    if (level == 3) return MAT_SLABS;
    if (level >= 4) return MAT_TILES;
    MAT_PAVERS
}

// The height of the ground at a point of cell (i, j)'s edge, seen from the
// neighbor; beyond the arena, the grass around it.
height_in(
    i: int,
    j: int,
    x: f32,
    z: f32
): f32 {
    if (!in_arena(i, j)) return BASE_LEVEL as f32 * LEVEL;
    surface_in(i, j, x, z)
}

// How cell (i, j) meets its neighbor toward d: 1 if it drops to it, -1 if
// it rises to it, 0 if level with it.
edge_step(i: int, j: int, d: int): int {
    v: V3 = dir_vec(d);
    // The edge's midpoint and its two ends.
    mx: f32 = i as f32 + 0.5 + v.x * 0.5;
    mz: f32 = j as f32 + 0.5 + v.z * 0.5;
    ox: f32 = v.z * 0.45;
    oz: f32 = v.x * 0.45;
    mine: f32 = surface_in(i, j, mx + ox, mz + oz) + surface_in(i, j, mx - ox, mz - oz);
    ni: int = i + dir_dx(d);
    nj: int = j + dir_dz(d);
    theirs: f32 = height_in(ni, nj, mx + ox, mz + oz) + height_in(ni, nj, mx - ox,
        mz - oz);
    if (mine > theirs + 0.05) return 1;
    if (mine < theirs - 0.05) return -1;
    0
}

steps: []int = new int[4](0);

// Cell (i, j)'s top at local (u, v): its surface, rounded down near edges
// where it drops.
cell_top(
    i: int,
    j: int,
    u: f32,
    v: f32
): f32 {
    base: f32 = surface_in(i, j, i as f32 + u, j as f32 + v);
    ex: f32 = 10.0;
    ez: f32 = 10.0;
    if (steps[0] == 1) ex = minf(ex, 1.0 - u);
    if (steps[2] == 1) ex = minf(ex, u);
    if (steps[1] == 1) ez = minf(ez, 1.0 - v);
    if (steps[3] == 1) ez = minf(ez, v);
    qx: f32 = maxf(RIM - ex, 0.0);
    qz: f32 = maxf(RIM - ez, 0.0);
    q: f32 = minf(sqrtf(qx * qx + qz * qz), RIM);
    base - (RIM - sqrtf(RIM * RIM - q * q))
}

// How dark the ground is at local (u, v) for being near the foot of a wall.
cell_shade(u: f32, v: f32): f32 {
    e: f32 = 10.0;
    if (steps[0] == -1) e = minf(e, 1.0 - u);
    if (steps[2] == -1) e = minf(e, u);
    if (steps[1] == -1) e = minf(e, 1.0 - v);
    if (steps[3] == -1) e = minf(e, v);
    1.0 - 0.25 * (1.0 - smoothstepf(0.0, 0.5, e))
}

cell_vertex(
    m: *Mesh,
    i: int,
    j: int,
    u: f32,
    v: f32,
    c: V3,
    mat: f32
) {
    e: f32 = 0.004;
    h: f32 = cell_top(i, j, u, v);
    u0: f32 = maxf(u - e, 0.0);
    u1: f32 = minf(u + e, 1.0);
    v0: f32 = maxf(v - e, 0.0);
    v1: f32 = minf(v + e, 1.0);
    gx: f32 = (cell_top(i, j, u1, v) - cell_top(i, j, u0, v)) / (u1 - u0);
    gz: f32 = (cell_top(i, j, u, v1) - cell_top(i, j, u, v0)) / (v1 - v0);
    n: V3 = v_norm(v3(-gx, 1.0, -gz));
    if (mat == MAT_POOL && kind_at(i, j) == CELL_QUARTER) {
        // Beyond a bowl's round lip, its square corners are plaza.
        p: Pool = pools[cell_pool[j * ARENA_W + i]];
        out: V3 = v3(0.0, 0.0, 0.0);
        if (pool_out(p, i as f32 + u, j as f32 + v, &out) >= p.n - 0.001) {
            c = paving_color(p.level + p.n as int);
            mat = MAT_PAVERS
        }
    }
    put(m, v3(i as f32 + u, h, j as f32 + v), n, v_scale(c, cell_shade(u, v)), mat)
}

build_cell(m: *Mesh, i: int, j: int) {
    k: int = kind_at(i, j);
    c: V3 = paving_color(level_at(i, j));
    mat: f32 = paving_mat(level_at(i, j));
    if (k == CELL_GRASS || k == CELL_TREE) {
        c = grass_color;
        mat = MAT_GRASS
    }
    if (k == CELL_RAMP) {
        c = wood_color;
        mat = MAT_WOOD
    }
    if (k == CELL_QUARTER) {
        // The halfpipe is wood; the bowl, painted concrete.
        p: Pool = pools[cell_pool[j * ARENA_W + i]];
        c = wood_color;
        mat = MAT_WOOD;
        if (p.walls_z) {
            c = paving_color(p.level);
            mat = MAT_POOL
        }
    }
    for d in 0..4 steps[d] = edge_step(i, j, d);
    // Sample each axis as finely as it needs: a rounded lip where it drops,
    // a gradual shade where it rises, a curve across a pool's wall.
    xs: []f32 = axis_offsets(steps[0], steps[2]);
    zs: []f32 = axis_offsets(steps[1], steps[3]);
    if (k == CELL_QUARTER) {
        p: Pool = pools[cell_pool[j * ARENA_W + i]];
        if (p.walls_x) xs = curve_offsets;
        if (p.walls_z) zs = curve_offsets
    }
    for b in 0..len(zs) - 1 {
        for a in 0..len(xs) - 1 {
            cell_vertex(m, i, j, xs[a], zs[b], c, mat);
            cell_vertex(m, i, j, xs[a + 1], zs[b], c, mat);
            cell_vertex(m, i, j, xs[a + 1], zs[b + 1], c, mat);
            cell_vertex(m, i, j, xs[a], zs[b], c, mat);
            cell_vertex(m, i, j, xs[a + 1], zs[b + 1], c, mat);
            cell_vertex(m, i, j, xs[a], zs[b + 1], c, mat)
        }
    }
    // Walls down to lower neighbors, under the rounded rim: plain concrete,
    // or the wood of a ramp or halfpipe, or earth under grass.
    side: V3 = v3(0.70, 0.67, 0.63);
    side_mat: f32 = MAT_CONCRETE;
    if (mat == MAT_WOOD) {
        side = v3(0.32, 0.52, 0.74);
        side_mat = MAT_PAINT
    }
    if (mat == MAT_GRASS) side = v3(0.50, 0.38, 0.27);
    for d in 0..4 {
        if (steps[d] == 1) {
            // Along the wall, the other axis's samples.
            ts: []f32 = zs;
            if (d == 1 || d == 3) ts = xs;
            for a in 0..len(ts) - 1 put_wall(m, i, j, d, ts[a], ts[a + 1], side, side_mat)
        }
    }
    if (cell_ledge[j * ARENA_W + i]) {
        for d in 0..4 {
            if (steps[d] == 1) put_ledge_edge(m, i, j, d)
        }
    }
    if (k == CELL_PROP) {
        if (rise_at(i, j) == 1) put_lamp(m, i as f32 + 0.5, j as f32 + 0.5, level_at(i,
            j) as f32 * LEVEL) else put_planter(m, i as f32 + 0.5, j as f32 + 0.5,
            level_at(i, j) as f32 * LEVEL, i * 37 + j)
    }
    if (k == CELL_TREE) put_tree(m, i as f32 + 0.5, j as f32 + 0.5, level_at(i, j) as f32 * LEVEL,
        0.75 + 0.3 * cell_jitter(j, i));
    if (k == CELL_GRASS || k == CELL_TREE) put_meadow(m, i as f32, j as f32, 1.0,
        1.0, level_at(i, j) as f32 * LEVEL, 7, i * 131 + j * 71)
}

// The local (u, v) of the point t along cell (i, j)'s edge toward d.
edge_u(d: int, t: f32): f32 {
    if (d == 0) return 1.0;
    if (d == 2) return 0.0;
    t
}

edge_v(d: int, t: f32): f32 {
    if (d == 1) return 1.0;
    if (d == 3) return 0.0;
    t
}

put_wall(
    m: *Mesh,
    i: int,
    j: int,
    d: int,
    t0: f32,
    t1: f32,
    c: V3,
    mat: f32
) {
    ni: int = i + dir_dx(d);
    nj: int = j + dir_dz(d);
    u0: f32 = edge_u(d, t0);
    v0: f32 = edge_v(d, t0);
    u1: f32 = edge_u(d, t1);
    v1: f32 = edge_v(d, t1);
    x0: f32 = i as f32 + u0;
    z0: f32 = j as f32 + v0;
    x1: f32 = i as f32 + u1;
    z1: f32 = j as f32 + v1;
    put_quad(m, v3(x0, height_in(ni, nj, x0, z0), z0), v3(x1, height_in(ni, nj, x1,
        z1), z1), v3(x1, cell_top(i, j, u1, v1), z1), v3(x0, cell_top(i, j, u0, v0),
        z0), dir_vec(d), c, mat)
}

steel: V3 = V3 { x: 0.72, y: 0.74, z: 0.78 };

// A steel edge along a ledge's top, where it drops.
put_ledge_edge(
    m: *Mesh,
    i: int,
    j: int,
    d: int
) {
    y: f32 = level_at(i, j) as f32 * LEVEL - 0.045;
    inset: f32 = 0.045;
    a: V3 = v3(i as f32 + edge_u(d, 0.0), y, j as f32 + edge_v(d, 0.0));
    b: V3 = v3(i as f32 + edge_u(d, 1.0), y, j as f32 + edge_v(d, 1.0));
    off: V3 = v_scale(dir_vec(d), -inset);
    put_tube(m, v_add(a, off), v_add(b, off), 0.045, steel, MAT_METAL)
}

// Steel coping along a pool's lips: straight runs beside its floor, and
// round its corners where two walls meet.
put_pool_coping(m: *Mesh, p: Pool) {
    r: f32 = p.n - 0.05;
    y: f32 = (p.level as f32 + p.n) * LEVEL - 0.04;
    if (p.walls_x && !p.walls_z) {
        put_tube(m, v3(p.x0 - r, y, p.z0), v3(p.x0 - r, y, p.z1), 0.055, steel, MAT_METAL);
        put_tube(m, v3(p.x1 + r, y, p.z0), v3(p.x1 + r, y, p.z1), 0.055, steel, MAT_METAL);
        return
    }
    put_tube(m, v3(p.x0 - r, y, p.z0), v3(p.x0 - r, y, p.z1), 0.055, steel, MAT_METAL);
    put_tube(m, v3(p.x1 + r, y, p.z0), v3(p.x1 + r, y, p.z1), 0.055, steel, MAT_METAL);
    put_tube(m, v3(p.x0, y, p.z0 - r), v3(p.x1, y, p.z0 - r), 0.055, steel, MAT_METAL);
    put_tube(m, v3(p.x0, y, p.z1 + r), v3(p.x1, y, p.z1 + r), 0.055, steel, MAT_METAL);
    for c in 0..4 {
        cx: f32 = p.x0;
        cz: f32 = p.z0;
        a0: f32 = PI;
        if (c == 1) {
            cx = p.x1;
            a0 = PI * 1.5
        }
        if (c == 2) {
            cx = p.x1;
            cz = p.z1;
            a0 = 0.0
        }
        if (c == 3) {
            cz = p.z1;
            a0 = PI * 0.5
        }
        for k in 0..8 {
            b0: f32 = a0 + PI * 0.5 * k as f32 / 8.0;
            b1: f32 = a0 + PI * 0.5 * (k + 1) as f32 / 8.0;
            put_tube(m, v3(cx + r * cosf(b0), y, cz + r * sinf(b0)), v3(cx + r * cosf(b1),
                y, cz + r * sinf(b1)), 0.055, steel, MAT_METAL)
        }
    }
}

// ---- props ----
// A stone planter with a round bush and a few flowers.
put_planter(
    m: *Mesh,
    x: f32,
    z: f32,
    y: f32,
    seed: int
) {
    at(x, y + 0.2, z);
    put_rounded_box(m, xf, v3(0.4, 0.2, 0.4), 0.06, 0.004, 2, v3(0.78, 0.70, 0.58),
        MAT_PAINT);
    at(x, y + 0.405, z);
    put_rounded_box(m, xf, v3(0.34, 0.01, 0.34), 0.01, 0.0, 1, v3(0.32, 0.24, 0.17),
        MAT_PAINT);
    at(x, y + 0.66, z);
    put_rounded_box(m, xf, v3(0.33, 0.27, 0.33), 0.26, 0.03, 2, v3(0.30, 0.52, 0.22),
        MAT_LEAF);
    meadow_rng = seed * 97 + 11;
    for _k in 0..5 {
        a: f32 = meadow_rand() * TAU;
        r: f32 = 0.26 + 0.06 * meadow_rand();
        put_blob(m, v3(x + cosf(a) * r, y + 0.62 + 0.25 * meadow_rand(), z + sinf(a) * r),
            0.045, v3(1.0, 0.85, 0.3))
    }
}

// A lamp post: a dark green pole on a foot, a lantern on top.
put_lamp(
    m: *Mesh,
    x: f32,
    z: f32,
    y: f32
) {
    post: V3 = v3(0.20, 0.30, 0.26);
    at(x, y + 0.08, z);
    put_rounded_box(m, xf, v3(0.13, 0.08, 0.13), 0.04, 0.0, 1, post, MAT_PAINT);
    put_tube(m, v3(x, y + 0.1, z), v3(x, y + 1.9, z), 0.045, post, MAT_PAINT);
    at(x, y + 2.02, z);
    put_rounded_box(m, xf, v3(0.13, 0.15, 0.13), 0.06, 0.0, 2, v3(1.0, 0.94, 0.78),
        MAT_PAINT);
    at(x, y + 2.2, z);
    put_rounded_box(m, xf, v3(0.17, 0.035, 0.17), 0.03, 0.0, 1, post, MAT_PAINT)
}

// ---- grass and flowers ----
meadow_rng: int = 1;

meadow_rand(): f32 {
    meadow_rng = (meadow_rng * 1103515245 + 12345) % 2147483648;
    (meadow_rng % 100000) as f32 / 100000.0
}

// A tuft of grass: a few blades leaning out from a point.
put_tuft(
    m: *Mesh,
    x: f32,
    y: f32,
    z: f32,
    size: f32
) {
    blades: int = 4;
    shade: f32 = 0.8 + 0.4 * meadow_rand();
    for b in 0..blades {
        a: f32 = TAU * (b as f32 + meadow_rand() * 0.6) / blades as f32;
        dx: f32 = cosf(a);
        dz: f32 = sinf(a);
        hgt: f32 = size * (0.7 + 0.6 * meadow_rand());
        lean: f32 = size * 0.45;
        w: f32 = size * 0.12;
        base: V3 = v3(x + dx * 0.02, y, z + dz * 0.02);
        tip: V3 = v3(x + dx * lean, y + hgt, z + dz * lean);
        side: V3 = v3(-dz * w, 0.0, dx * w);
        n: V3 = v_norm(v3(dx * 0.4, 1.0, dz * 0.4));
        dark: V3 = v3(0.22 * shade, 0.42 * shade, 0.16 * shade);
        light: V3 = v3(0.46 * shade, 0.70 * shade, 0.30 * shade);
        put(m, v_add(base, side), n, dark, MAT_LEAF);
        put(m, v_sub(base, side), n, dark, MAT_LEAF);
        put(m, tip, n, light, MAT_LEAF)
    }
}

flower_colors: []f32 = [1.0, 0.97, 0.9, 1.0, 0.85, 0.3, 0.98, 0.6, 0.75, 0.75, 0.7,
    1.0];

// A flower: a little ball of color on a stem.
put_flower(
    m: *Mesh,
    x: f32,
    y: f32,
    z: f32
) {
    k: int = (meadow_rand() * 4.0) as int % 4;
    c: V3 = v3(flower_colors[k * 3], flower_colors[k * 3 + 1], flower_colors[k * 3 + 2]);
    h: f32 = 0.12 + 0.08 * meadow_rand();
    put_tube(m, v3(x, y, z), v3(x, y + h, z), 0.008, v3(0.3, 0.5, 0.2), MAT_LEAF);
    put_blob(m, v3(x, y + h, z), 0.045, c)
}

// An octahedron, rounded by its normals.
put_blob(
    m: *Mesh,
    c: V3,
    r: f32,
    col: V3
) {
    for s in 0..8 {
        sx: f32 = 1.0;
        sy: f32 = 1.0;
        sz: f32 = 1.0;
        if (s % 2 == 1) sx = -1.0;
        if (s / 2 % 2 == 1) sy = -1.0;
        if (s / 4 == 1) sz = -1.0;
        a: V3 = v3(sx, 0.0, 0.0);
        b: V3 = v3(0.0, sy, 0.0);
        d: V3 = v3(0.0, 0.0, sz);
        put(m, v_madd(c, a, r), a, col, MAT_PAINT);
        put(m, v_madd(c, b, r), b, col, MAT_PAINT);
        put(m, v_madd(c, d, r), d, col, MAT_PAINT)
    }
}

// Tufts and flowers over a patch of grass.
put_meadow(
    m: *Mesh,
    x0: f32,
    z0: f32,
    w: f32,
    h: f32,
    y: f32,
    count: int,
    seed: int
) {
    meadow_rng = seed * 7919 + 17;
    if (meadow_rng < 0) meadow_rng = -meadow_rng;
    for _k in 0..count {
        x: f32 = x0 + 0.08 + meadow_rand() * (w - 0.16);
        z: f32 = z0 + 0.08 + meadow_rand() * (h - 0.16);
        if (meadow_rand() < 0.12) put_flower(m, x, y, z) else put_tuft(m, x, y, z,
            0.16 + 0.08 * meadow_rand())
    }
}

build_arena(m: *Mesh) {
    m.n = 0;
    for j in 0..ARENA_H {
        for i in 0..ARENA_W build_cell(m, i, j)
    }
    for k in 0..npools put_pool_coping(m, pools[k]);
    // Grass all around, with tufts near the arena and trees behind it.
    g: V3 = grass_color;
    w: f32 = ARENA_W as f32;
    h: f32 = ARENA_H as f32;
    e: f32 = 60.0;
    up: V3 = v3(0.0, 1.0, 0.0);
    gy: f32 = BASE_LEVEL as f32 * LEVEL;
    // In tiles, not a few huge triangles, which rasterize with seams.
    t: f32 = 4.0;
    tz: f32 = -e;
    while (tz < h + e) {
        tx: f32 = -e;
        while (tx < w + e) {
            if (tx + t <= 0.0 || tx >= w || tz + t <= 0.0 || tz >= h) put_quad(m,
                v3(tx, gy, tz), v3(tx + t, gy, tz), v3(tx + t, gy, tz + t), v3(tx,
                gy, tz + t), up, g, MAT_GRASS);
            tx = tx + t
        }
        tz = tz + t
    }
    for bz in -3..ARENA_H as int + 3 {
        for bx in -3..ARENA_W as int + 3 {
            if (!in_arena(bx, bz)) put_meadow(m, bx as f32, bz as f32, 1.0, 1.0, gy,
                4, bx * 31 + bz * 977 + 5)
        }
    }
    rng: int = 4242;
    placed: int = 0;
    while (placed < 45) {
        rng = (rng * 1103515245 + 12345) % 2147483648;
        x: f32 = (rng % 10000) as f32 / 10000.0 * (w + 40.0) - 20.0;
        rng = (rng * 1103515245 + 12345) % 2147483648;
        z: f32 = (rng % 10000) as f32 / 10000.0 * (h + 40.0) - 20.0;
        // Only behind the arena, where they cannot hide him.
        if ((x < -3.0 || z < -1.5 || x > w + 3.0) && z < 3.0) {
            put_tree(m, x, z, gy, 0.8 + 0.5 * cell_jitter(placed, 7));
            placed = placed + 1
        }
    }
}

// ---- scenery ----
put_tree(
    m: *Mesh,
    x: f32,
    z: f32,
    ground: f32,
    size: f32
) {
    y: f32 = ground - 0.1;
    yaw: f32 = x * 1.7 + z * 0.3;
    mat_frame(xf, v3(cosf(yaw), 0.0, -sinf(yaw)), v3(0.0, 1.0, 0.0), v3(sinf(yaw),
        0.0, cosf(yaw)), v3(x, y + 0.9 * size, z));
    put_rounded_box(m, xf, v3(0.22 * size, 0.9 * size, 0.22 * size), 0.1 * size, 0.0,
        1, v3(0.45, 0.32, 0.22), MAT_PAINT);
    shade: f32 = 0.85 + 0.3 * absf(sinf(x * 3.1 + z * 1.3));
    leaf: V3 = v3(0.30 * shade, 0.55 * shade, 0.24 * shade);
    mat_frame(xf, v3(cosf(yaw), 0.0, -sinf(yaw)), v3(0.0, 1.0, 0.0), v3(sinf(yaw),
        0.0, cosf(yaw)), v3(x, y + 2.3 * size, z));
    put_rounded_box(m, xf, v3(1.15 * size, 0.85 * size, 1.15 * size), 0.6 * size,
        0.06 * size, 1, leaf, MAT_LEAF);
    mat_frame(xf, v3(cosf(yaw + 0.8), 0.0, -sinf(yaw + 0.8)), v3(0.0, 1.0, 0.0), v3(sinf(yaw + 0.8),
        0.0, cosf(yaw + 0.8)), v3(x + 0.1 * size, y + 3.25 * size, z));
    put_rounded_box(m, xf, v3(0.75 * size, 0.6 * size, 0.75 * size), 0.45 * size,
        0.05 * size, 1, v_scale(leaf, 1.08), MAT_LEAF)
}

// ---- the guy and his board ----
// He is one tall block, a third of it split into two halves that walk, with
// little arms. Parts are built in their own frames: the body from its base,
// legs and arms hanging from their hip and shoulder, the board from the
// ground under its wheels, nose toward +z.
const PART_BODY: int = 0;

const PART_LEG: int = 1;

const PART_ARM: int = 2;

const PART_BOARD: int = 3;

const PART_COUNT: int = 4;

part_first: []int = new int[PART_COUNT](0);

part_count: []int = new int[PART_COUNT](0);

const GUY_W: f32 = 0.62;

const GUY_D: f32 = 0.6;

const GUY_H: f32 = 0.93;

const LEG_H: f32 = 0.36;

const LEG_GAP: f32 = 0.035;

const DECK_Y: f32 = 0.17;

const DECK_TOP: f32 = 0.2075;

body_color: V3 = V3 { x: 0.90, y: 0.22, z: 0.18 };

part_begin(m: *Mesh, part: int) {
    part_first[part] = m.n
}

part_end(m: *Mesh, part: int) {
    part_count[part] = m.n - part_first[part]
}

at(x: f32, y: f32, z: f32) {
    mat_identity(xf);
    xf[12] = x;
    xf[13] = y;
    xf[14] = z
}

build_parts(m: *Mesh) {
    m.n = 0;
    part_begin(m, PART_BODY);
    // It reaches down past the hips so its rounded bottom hides behind the
    // legs.
    bottom: f32 = LEG_H - 0.1;
    at(0.0, (bottom + GUY_H) * 0.5, 0.0);
    put_rounded_box(m, xf, v3(GUY_W * 0.5, (GUY_H - bottom) * 0.5, GUY_D * 0.5), 0.1,
        0.01, 3, body_color, MAT_SOFT);
    part_end(m, PART_BODY);
    part_begin(m, PART_LEG);
    lw: f32 = (GUY_W - LEG_GAP) * 0.25;
    at(0.0, -LEG_H * 0.5 + 0.03, 0.0);
    put_rounded_box(m, xf, v3(lw, LEG_H * 0.5 + 0.03, GUY_D * 0.5 - 0.005), 0.07,
        0.004, 2, body_color, MAT_SOFT);
    part_end(m, PART_LEG);
    part_begin(m, PART_ARM);
    // Arms are flat paddles set into his sides, part of the block.
    at(0.0, -0.12, 0.0);
    put_rounded_box(m, xf, v3(0.05, 0.14, 0.15), 0.045, 0.006, 2, body_color, MAT_SOFT);
    part_end(m, PART_ARM);
    part_begin(m, PART_BOARD);
    build_board(m);
    part_end(m, PART_BOARD)
}

// A pudgy board: a thick pill of a deck with a round rim and tips that turn
// up a little, on fat wheels.
build_board(m: *Mesh) {
    deck: V3 = v3(0.98, 0.72, 0.28);
    half_len: f32 = 0.27;
    radius: f32 = 0.17;
    rim: f32 = 0.0375;
    steps: int = 40;
    rings: int = 8;
    points: int = steps + 2;
    for k in 0..points {
        k1: int = (k + 1) % points;
        for r in 0..rings put_deck_quad(m, k, k1, r, steps, rings, half_len, radius,
            rim, deck);
        // Top and bottom: fans from the middle line.
        a0: V3 = deck_outline(k, steps, half_len, radius - rim);
        a1: V3 = deck_outline(k1, steps, half_len, radius - rim);
        for s in 0..2 {
            y: f32 = rim;
            nn: V3 = v3(0.0, 1.0, 0.0);
            if (s == 0) {
                y = -rim;
                nn = v3(0.0, -1.0, 0.0)
            }
            c: V3 = v3(0.0, 0.0, clampf(a0.z, -half_len, half_len));
            c1: V3 = v3(0.0, 0.0, clampf(a1.z, -half_len, half_len));
            put_quad(m, deck_lift(c, y), deck_lift(v3(a0.x, 0.0, a0.z), y), deck_lift(v3(a1.x,
                0.0, a1.z), y), deck_lift(c1, y), nn, deck, MAT_PAINT)
        }
    }
    for e in 0..2 {
        s: f32 = 1.0;
        if (e == 0) s = -1.0;
        at(0.0, 0.115, s * 0.2);
        put_rounded_box(m, xf, v3(0.1, 0.03, 0.035), 0.025, 0.0, 1, v3(0.62, 0.64,
            0.68), MAT_METAL);
        for w in 0..2 {
            sx: f32 = 1.0;
            if (w == 0) sx = -1.0;
            at(sx * 0.13, 0.065, s * 0.2);
            put_rounded_box(m, xf, v3(0.045, 0.065, 0.065), 0.044, 0.004, 2, v3(0.97,
                0.95, 0.88), MAT_PAINT)
        }
    }
}

// The deck's outline, a stadium with its straight sides along z, as a
// closed loop of steps + 2 points: a half circle round the nose, then one
// round the tail. Joining the halves' ends makes the straight sides.
deck_angle(k: int, steps: int): f32 {
    half: int = steps / 2;
    if (k <= half) return PI * k as f32 / half as f32;
    PI + PI * (k - half - 1) as f32 / half as f32
}

deck_outline(
    k: int,
    steps: int,
    half_len: f32,
    r: f32
): V3 {
    a: f32 = deck_angle(k, steps);
    zc: f32 = half_len;
    if (k > steps / 2) zc = -half_len;
    v3(r * cosf(a), 0.0, zc + r * sinf(a))
}

deck_normal(k: int, steps: int): V3 {
    a: f32 = deck_angle(k, steps);
    v3(cosf(a), 0.0, sinf(a))
}

// Raise a deck point to its height, its tips turned up.
deck_lift(p: V3, y: f32): V3 {
    t: f32 = maxf(absf(p.z) - 0.2, 0.0);
    v3(p.x, DECK_Y + y + t * t * 0.9, p.z)
}

put_deck_quad(
    m: *Mesh,
    k: int,
    k1: int,
    r: int,
    steps: int,
    rings: int,
    half_len: f32,
    radius: f32,
    rim: f32,
    col: V3
) {
    b0: V3 = deck_outline(k, steps, half_len, radius - rim);
    b1: V3 = deck_outline(k1, steps, half_len, radius - rim);
    n0: V3 = deck_normal(k, steps);
    n1: V3 = deck_normal(k1, steps);
    f0: f32 = PI * (r as f32 / rings as f32 - 0.5);
    f1: f32 = PI * ((r + 1) as f32 / rings as f32 - 0.5);
    put_quad_n(m, rim_point(b0, n0, rim, f0), rim_point(b1, n1, rim, f0), rim_point(b1,
        n1, rim, f1), rim_point(b0, n0, rim, f1), rim_normal(n0, f0), rim_normal(n1,
        f0), rim_normal(n1, f1), rim_normal(n0, f1), col, MAT_PAINT)
}

rim_point(
    base: V3,
    n: V3,
    rim: f32,
    f: f32
): V3 {
    p: V3 = v_madd(base, n, rim * cosf(f));
    deck_lift(v3(p.x, 0.0, p.z), rim * sinf(f))
}

rim_normal(n: V3, f: f32): V3 {
    v3(n.x * cosf(f), sinf(f), n.z * cosf(f))
}
