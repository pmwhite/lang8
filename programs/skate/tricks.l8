tag skate;

// The line: the moves he chains together without settling down, named as
// they happen. A line ends once he has been on the ground, doing nothing
// in particular, for a moment, and then lingers on screen a little while.
// In the park nothing is scored: it only shows what he did. On the course
// each trick is worth points, and a line banks its points times how many
// tricks it had; a sketchy landing loses it.
const T_OLLIE: int = 0;

const T_GRIND: int = 1;

const T_COPING: int = 2;

const T_WALLRIDE: int = 3;

const T_WALLRUN: int = 4;

const T_WALL_KICK: int = 5;

const T_CLIMB: int = 6;

const T_POLE: int = 7;

const T_KICKFLIP: int = 8;

const T_FLIP: int = 9;

const T_MANUAL: int = 10;

const T_AIR: int = 11;

const T_POP: int = 12;

const T_DROP_IN: int = 13;

const T_ROLL: int = 14;

const T_180: int = 15;

const T_360: int = 16;

const T_540: int = 17;

const T_720: int = 18;

const T_900: int = 19;

const T_1080: int = 20;

const T_FRONTFLIP: int = 21;

const T_BACKFLIP: int = 22;

const T_DOUBLE_FRONT: int = 23;

const T_DOUBLE_BACK: int = 24;

const T_TRIPLE_FRONT: int = 25;

const T_TRIPLE_BACK: int = 26;

const T_GRAB: int = 27;

const T_RAIL: int = 28;

const T_BOX: int = 29;

const T_NOSE_MANUAL: int = 30;

trick_names: []str = ["OLLIE", "GRIND", "COPING", "WALLRIDE", "WALLRUN", "WALL KICK",
    "CLIMB", "POLE SWING", "KICKFLIP", "FLIP", "MANUAL", "AIR", "POP", "DROP-IN",
    "ROLL", "180", "360", "540", "720", "900", "1080", "FRONTFLIP", "BACKFLIP", "DOUBLE FRONTFLIP",
    "DOUBLE BACKFLIP", "TRIPLE FRONTFLIP", "TRIPLE BACKFLIP", "GRAB", "RAIL", "BOX",
    "NOSE MANUAL"];

trick_points: []int = [0, 100, 100, 100, 100, 100, 50, 100, 100, 100, 100, 100, 100,
    50, 50, 100, 250, 400, 600, 800, 1000, 500, 500, 1200, 1200, 2000, 2000, 150,
    150, 100, 100];

const MAX_LINE: int = 64;

// How long he must be settled for a line to end, and how long an ended line
// stays on screen.
const LINE_SETTLE: f32 = 1.0;

const COURSE_SETTLE: f32 = 0.9;

const LINE_LINGER: f32 = 2.5;

type Line = {
    ids: []int;
    n: int;
    idle: f32;
    // The last line to end, and how long ago.
    done_ids: []int;
    done_n: int;
    done_t: f32;
    // On the course: the line's points so far; the last line's points, its
    // multiplier, and whether it was lost; the run's total and best line,
    // and the best run yet.
    scoring: bool;
    points: f32;
    done_points: int;
    done_mult: int;
    done_lost: bool;
    run_total: int;
    run_best: int;
    best_run: int
}

line: *Line = new Line {
    ids: new int[MAX_LINE](0),
    n: 0,
    idle: 0.0,
    done_ids: new int[MAX_LINE](0),
    done_n: 0,
    done_t: 100.0,
    scoring: false,
    points: 0.0,
    done_points: 0,
    done_mult: 0,
    done_lost: false,
    run_total: 0,
    run_best: 0,
    best_run: 0
};

note(id: int) {
    if (line.n < MAX_LINE) {
        line.ids[line.n] = id;
        line.n = line.n + 1
    }
    if (line.scoring) line.points = line.points + trick_points[id] as f32;
    line.idle = 0.0
}

// Points for keeping something up: a grab, a grind, a manual.
line_add(points: f32) {
    if (line.n > 0) line.points = line.points + points
}

// Show the line as the last one, and start over.
end_line(lost: bool) {
    for i in 0..line.n line.done_ids[i] = line.ids[i];
    line.done_n = line.n;
    line.done_t = 0.0;
    line.done_lost = lost;
    line.done_mult = line.n;
    line.done_points = line.points as int * line.n;
    if (!lost) {
        line.run_total = line.run_total + line.done_points;
        if (line.done_points > line.run_best) line.run_best = line.done_points
    }
    line.n = 0;
    line.points = 0.0
}

// A sketchy landing loses the line.
lose_line() {
    if (line.n > 0) end_line(true)
}

// busy: he is in the middle of something that keeps the line going.
tick_line(busy: bool, dt: f32) {
    line.done_t = line.done_t + dt;
    if (busy) line.idle = 0.0 else line.idle = line.idle + dt;
    settle: f32 = LINE_SETTLE;
    if (line.scoring) settle = COURSE_SETTLE;
    if (line.n > 0 && line.idle > settle) {
        // A lone move is not much of a line; let it pass quietly, unless
        // it scores.
        if (line.n > 1 || line.scoring) end_line(false);
        line.n = 0;
        line.points = 0.0
    }
}

clear_line() {
    line.n = 0;
    line.done_n = 0;
    line.points = 0.0;
    line.run_total = 0;
    line.run_best = 0
}
