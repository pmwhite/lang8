tag skate;

use_tag blockmesh, blockguy;

// The run's bends. A course winds: the run turns this way and that down
// the hill, and he steers to stay on it. All the game is worked out along
// the run and across it, as if it were straight (x across, d along: see
// course.l8); the run's turning shows only in how he goes along it, and in
// where everything is drawn.
//
// - The run's curvature at d (bend_curve), positive turning to the right
//   (toward +x), and so its heading (bend_turn) and the line down its
//   middle (bend_center), as worked out by laying its bends end to end.
// - Going along a bend, the run turns under him: he holds his way, and so
//   turns, against the run, as much as it turns (see step_course_ground,
//   in slope.l8). On its inside, it is shorter (along_scale).
// - Drawn, a point x across the run at d is where the line down its middle
//   is, x to its right, square to it (course_world); further out than
//   BEND_BAND, the ground goes on straight across, so that however tight
//   the bend, the far ground never folds over itself.
bend_k: []f32 = new f32[BASE_N](0.0);

bend_th: []f32 = new f32[BASE_N](0.0);

bend_cx: []f32 = new f32[BASE_N](0.0);

bend_cz: []f32 = new f32[BASE_N](0.0);

// (Its heading's cosine and sine, for drawing many points quickly.)
bend_cos: []f32 = new f32[BASE_N](1.0);

bend_sin: []f32 = new f32[BASE_N](0.0);

bends_on: bool = false;

// How far across the run it is drawn square to its middle (no further
// than the tightest bend's radius, or the ground would fold over).
const BEND_BAND: f32 = 17.0;

// The tightest a bend turns (1 / its radius), how far either way of the
// hill's fall line the run heads at the most, and how long a bend is at
// the least; and in a chute, where the run is narrow and wriggles.
const BEND_MOST: f32 = 0.032;

const BEND_TURN_MOST: f32 = 0.75;

const BEND_LEAST: f32 = 30.0;

const CHUTE_MOST: f32 = 0.05;

const CHUTE_TURN: f32 = 0.5;

// How wide a chute is (half), and how far its narrowing takes, in and
// out.
const CHUTE_HALF: f32 = 3.5;

const CHUTE_EASE: f32 = 10.0;

// The run's shape along it: how wide it is (half), and how much each side
// is a berm, 0 to 1 (see course_bank, in course.l8).
run_half_t: []f32 = new f32[BASE_N](11.0);

// How much d is in a chute, 0 to 1 (its banks steeper: see course_bank).
chute_t: []f32 = new f32[BASE_N](0.0);

berm_l: []f32 = new f32[BASE_N](0.0);

berm_r: []f32 = new f32[BASE_N](0.0);

// Where a bend turns the run fast enough for its outside to be a berm, and
// fully one; and how far from any feature (or start, or finish) a berm
// keeps.
const BERM_FROM: f32 = 0.012;

const BERM_FULL: f32 = 0.026;

const BERM_CLEAR: f32 = 6.0;

// Where the bends begin, and the straight at the top before them.
const BEND_FROM: f32 = 24.0;

bend_rng: int = 1;

bend_rand(): f32 {
    bend_rng = (bend_rng * 1103515245 + 12345) % 2147483648;
    if (bend_rng < 0) bend_rng = -bend_rng;
    (bend_rng / 64 % 100000) as f32 / 100000.0
}

// Lay out the bends for course_seed (by a stream of its own, so that the
// sections laid out are as they were): bends one after another, each from
// the way the run heads to a new way, the other side of the fall line, as
// far as BEND_TURN_MOST; short straights between some. Then the run's
// heading and middle, along it.
lay_bends() {
    for i in 0..BASE_N bend_k[i] = 0.0;
    bends_on = !park && !in_tutorial() && !big_air;
    if (bends_on) {
        bend_rng = course_seed * 104729 + 7;
        th: f32 = 0.0;
        side: f32 = 1.0;
        if (bend_rand() < 0.5) side = -1.0;
        d: f32 = BEND_FROM;
        while (d < course_finish + 20.0) {
            // (In a chute, wriggles one after another, tighter, either side
            // of the way it heads into it; elsewhere, bends from one side
            // of the fall line to the other, sometimes with a straight
            // between.)
            c: int = chute_at(d);
            to: f32 = side * BEND_TURN_MOST * (0.45 + 0.55 * bend_rand());
            most: f32 = BEND_MOST;
            least: f32 = BEND_LEAST;
            if (c >= 0) {
                to = clampf(th + side * CHUTE_TURN * (1.4 + 0.6 * bend_rand()), -BEND_TURN_MOST,
                    BEND_TURN_MOST);
                most = CHUTE_MOST;
                least = 18.0
            } else if (bend_rand() < 0.4) d = d + bend_rand() * 12.0;
            turn: f32 = to - th;
            // (As long as it must be to turn so far no tighter than `most`:
            // its curvature rises and falls as a sine's hump, which turns
            // by its top times 2 / PI of its length.)
            len: f32 = maxf(least, absf(turn) * PI / (2.0 * most)) + bend_rand() * 8.0;
            put_bend(d, len, turn);
            th = to;
            side = -side;
            d = d + len
        }
    }
    lay_run_shape();
    th: f32 = 0.0;
    x: f32 = 0.0;
    z: f32 = -(COURSE_START - 20.0);
    for i in 0..BASE_N {
        bend_th[i] = th;
        bend_cx[i] = x;
        bend_cz[i] = z;
        bend_cos[i] = cosf(th);
        bend_sin[i] = sinf(th);
        // (Midway along the step.)
        mid: f32 = th + 0.5 * bend_k[i] * BASE_STEP;
        x = x + sinf(mid) * BASE_STEP;
        z = z - cosf(mid) * BASE_STEP;
        th = th + bend_k[i] * BASE_STEP
    }
}

// Which chute section d is in, or -1.
chute_at(d: f32): int {
    for k in 0..nsects {
        if (sect_kind[k] == SECT_CHUTE && d >= sect_d0[k] && d < sect_d1[k]) return k
    }
    -1
}

// The run's width along it, and its berms: on each bend's outside, as
// fast as it turns, but not near a feature or a rail (nor the start or the
// finish), easing in and out over a few metres.
lay_run_shape() {
    for i in 0..BASE_N {
        d: f32 = COURSE_START - 20.0 + i as f32 * BASE_STEP;
        narrow: f32 = 0.0;
        for k in 0..nsects {
            if (bends_on && sect_kind[k] == SECT_CHUTE) narrow = maxf(narrow, smoothstepf(sect_d0[k],
                sect_d0[k] + CHUTE_EASE, d) * (1.0 - smoothstepf(sect_d1[k] - CHUTE_EASE,
                sect_d1[k], d)))
        }
        run_half_t[i] = lerpf(COURSE_HALF, CHUTE_HALF, narrow);
        chute_t[i] = narrow;
        k: f32 = bend_k[i];
        b: f32 = 0.0;
        if (bends_on && !berm_kept_off(d)) b = smoothstepf(BERM_FROM, BERM_FULL, absf(k));
        // (A bend to the right has its outside on the left.)
        berm_l[i] = 0.0;
        berm_r[i] = 0.0;
        if (k > 0.0) berm_l[i] = b else berm_r[i] = b
    }
    smooth_steps(berm_l, 24);
    smooth_steps(berm_r, 24)
}

berm_kept_off(d: f32): bool {
    if (d < BEND_FROM + BERM_CLEAR || d > course_finish - BERM_CLEAR) return true;
    for i in 0..nfeatures {
        if (d > feature_from[i] - BERM_CLEAR && d < feature_to[i] + BERM_CLEAR) return true
    }
    for i in 0..nspecs {
        if (d > specs[i].d0 - BERM_CLEAR && d < specs[i].d1 + BERM_CLEAR) return true
    }
    false
}

// a, each value the mean of those r steps either side of it.
smooth_steps(a: []f32, r: int) {
    n: int = len(a);
    tmp: []f32 = new f32[n](0.0);
    for i in 0..n {
        sum: f32 = 0.0;
        for j in maxi(i - r, 0)..mini(i + r + 1, n) sum = sum + a[j];
        tmp[i] = sum / (mini(i + r + 1, n) - maxi(i - r, 0)) as f32
    }
    for i in 0..n a[i] = tmp[i]
}

// How wide the run is at d (half).
run_half(d: f32): f32 {
    if (!bends_on) return COURSE_HALF;
    bend_at(run_half_t, d)
}

// How much d is in a chute.
in_chute(d: f32): f32 {
    if (!bends_on) return 0.0;
    bend_at(chute_t, d)
}

// How much the run's side (-1 its left, 1 its right) is a berm at d.
berm(side: f32, d: f32): f32 {
    if (!bends_on) return 0.0;
    if (side < 0.0) return bend_at(berm_l, d);
    bend_at(berm_r, d)
}

// Where the run's smooth ground ends, on its side toward x, at d: its
// edge, or a berm's top.
run_edge(x: f32, d: f32): f32 {
    run_half(d) + BERM_OUT * berm(signf(x), d)
}

// How far out the fence is, on the side toward x; and how far out he can
// go (less his half width).
fence_out(x: f32, d: f32): f32 {
    run_edge(x, d) + FENCE_OUT
}

side_limit(x: f32, d: f32): f32 {
    fence_out(x, d) - 0.4
}

// A bend from d, len long, turning by `turn`.
put_bend(d: f32, len: f32, turn: f32) {
    top: f32 = turn * PI / (2.0 * len);
    for i in 0..BASE_N {
        s: f32 = COURSE_START - 20.0 + (i as f32 + 0.5) * BASE_STEP - d;
        if (s > 0.0 && s < len) bend_k[i] = bend_k[i] + top * sinf(PI * s / len)
    }
}

bend_at(a: []f32, d: f32): f32 {
    f: f32 = clampf((d - COURSE_START + 20.0) / BASE_STEP, 0.0, (BASE_N - 2) as f32);
    i: int = f as int;
    lerpf(a[i], a[i + 1], f - i as f32)
}

bend_curve(d: f32): f32 {
    if (!bends_on) return 0.0;
    bend_at(bend_k, d)
}

bend_turn(d: f32): f32 {
    if (!bends_on) return 0.0;
    bend_at(bend_th, d)
}

// How long the run is x across it, for each unit along its middle: less
// on a bend's inside.
along_scale(x: f32, d: f32): f32 {
    maxf(1.0 - bend_curve(d) * clampf(x, -BEND_BAND, BEND_BAND), 0.2)
}

// Where the point p (x across the run, y up, z = -d) is drawn.
course_world(p: V3): V3 {
    if (!bends_on || park || stage_on) return p;
    d: f32 = -p.z;
    th: f32 = bend_turn(d);
    t: f32 = clampf(p.x, -BEND_BAND, BEND_BAND);
    v3(bend_at(bend_cx, d) + cosf(th) * t + (p.x - t), p.y, bend_at(bend_cz, d) + sinf(th) * t)
}

// A way v, at d along the run, as drawn (turned with the run).
course_world_dir(v: V3, d: f32): V3 {
    if (!bends_on || park || stage_on) return v;
    th: f32 = bend_turn(d);
    turn_y(v, th)
}

// v turned by a about the up axis, the way the run turns to the right.
turn_y(v: V3, a: f32): V3 {
    c: f32 = cosf(a);
    s: f32 = sinf(a);
    v3(v.x * c - v.z * s, v.y, v.x * s + v.z * c)
}

// The vertices from first on, laid along the run as drawn: each where its
// place is, its normal turned with the run (less, far out past the band,
// where the ground goes on straight).
bend_mesh(m: *Mesh, first: int) {
    if (!bends_on || park) return;
    data: []f32 = m.data;
    top: f32 = (BASE_N - 2) as f32;
    for k in first..m.n {
        i: int = k * VERTEX_FLOATS;
        x: f32 = data[i];
        // (As course_world, its steps worked out here once.)
        f: f32 = clampf((-data[i + 2] - COURSE_START + 20.0) / BASE_STEP, 0.0, top);
        j: int = f as int;
        u: f32 = f - j as f32;
        c: f32 = lerpf(bend_cos[j], bend_cos[j + 1], u);
        s: f32 = lerpf(bend_sin[j], bend_sin[j + 1], u);
        t: f32 = clampf(x, -BEND_BAND, BEND_BAND);
        data[i] = lerpf(bend_cx[j], bend_cx[j + 1], u) + c * t + (x - t);
        data[i + 2] = lerpf(bend_cz[j], bend_cz[j + 1], u) + s * t;
        // (Its normal turned with the run; out past the band, less and
        // less, where the ground goes on straight.)
        e: f32 = absf(x);
        if (e > BEND_BAND) {
            th: f32 = lerpf(bend_th[j], bend_th[j + 1], u) * (1.0 - smoothstepf(BEND_BAND,
                BEND_BAND + 12.0, e));
            c = cosf(th);
            s = sinf(th)
        }
        nx: f32 = data[i + 3];
        nz: f32 = data[i + 5];
        data[i + 3] = nx * c - nz * s;
        data[i + 5] = nx * s + nz * c
    }
}

// Each part drawn (him, the others, the gate), from where it is along the
// run to where it is drawn: about the point it stands on, turned with the
// run there.
bend_draws() {
    if (!bends_on || park || stage_on) return;
    for k in 0..ndraw {
        f: int = draw_first[k];
        n: int = 1;
        // (His bones' matrices are each where it is: all turned about his
        // model's place, as one.)
        if (draw_part[k] == PART_GUY) n = GUY_BONES;
        p: V3 = v3(draw_m[f * 16 + 12], draw_m[f * 16 + 13], draw_m[f * 16 + 14]);
        th: f32 = bend_turn(-p.z);
        w: V3 = course_world(p);
        for j in 0..n bend_matrix((f + j) * 16, p, w, th)
    }
}

// The matrix at `at`, turned by th about p, and p moved to w.
bend_matrix(
    at: int,
    p: V3,
    w: V3,
    th: f32
) {
    for c in 0..3 {
        v: V3 = turn_y(v3(draw_m[at + c * 4], draw_m[at + c * 4 + 1], draw_m[at + c * 4 + 2]),
            th);
        draw_m[at + c * 4] = v.x;
        draw_m[at + c * 4 + 1] = v.y;
        draw_m[at + c * 4 + 2] = v.z
    }
    t: V3 = turn_y(v_sub(v3(draw_m[at + 12], draw_m[at + 13], draw_m[at + 14]), p),
        th);
    draw_m[at + 12] = w.x + t.x;
    draw_m[at + 13] = w.y + t.y;
    draw_m[at + 14] = w.z + t.z
}

// The view, as drawn; and how far along the run what it looks at is (for
// which of the course's chunks to draw).
view_d: f32 = 0.0;

bent_view(v: View): View {
    view_d = -v.focus.z;
    if (!bends_on || park || stage_on) return v;
    View {
        eye: course_world(v.eye),
        at: course_world(v.at),
        fovy: v.fovy,
        focus: course_world(v.focus),
        rider: course_world(v.rider),
        time: v.time,
        shift: v.shift
    }
}
