tag skate;

// The sheets: what is on one, laid out and drawn (see ui.l8 for how the
// page says what that is). A sheet is a pane of frosted glass over the
// game, with its blocks on it, a line of the page's each, top to bottom:
//
//   title  eyebrow, title, and a button beside it (its name, its word)
//   note   a short line (gold, or dim)
//   para   words to read
//   box    a heading, and words under it, boxed
//   item   a row to press: its name, its title, a word at its end, and how
//          it looks (first, done, plain)
//   me     who he is: its name, his
//   head   a heading
//   tabs   which of a few is picked, then each's name and word
//   feed   (to /feed) rows that scroll on their own, so many rows high
//   row    a run: its name, whether it is his, then cells: each a kind
//          (n, who, what, score, when, watch), a name, and a word
//   empty  words where there is nothing
//   card   a card to press: its name, title, a word, whether it is the
//          whole width, and how it looks (daily, past, plain)
//   month  a month: the name of the button before it (or none), its name,
//          and the one after
//   day    a day of it: its name, its date, and what it is (on, off,
//          today, blank)
//   gap    space, so many CSS pixels
//
// What can be pressed is named, and pressing it tells the page its name.
const BK_TITLE: int = 0;

const BK_NOTE: int = 1;

const BK_PARA: int = 2;

const BK_BOX: int = 3;

const BK_ITEM: int = 4;

const BK_ME: int = 5;

const BK_HEAD: int = 6;

const BK_TABS: int = 7;

const BK_FEED: int = 8;

const BK_FEED_END: int = 9;

const BK_ROW: int = 10;

const BK_EMPTY: int = 11;

const BK_CARD: int = 12;

const BK_MONTH: int = 13;

const BK_DAY: int = 14;

const BK_GAP: int = 15;

block_kind(): int {
    if (part_is(0, "title")) return BK_TITLE;
    if (part_is(0, "note")) return BK_NOTE;
    if (part_is(0, "para")) return BK_PARA;
    if (part_is(0, "box")) return BK_BOX;
    if (part_is(0, "item")) return BK_ITEM;
    if (part_is(0, "me")) return BK_ME;
    if (part_is(0, "head")) return BK_HEAD;
    if (part_is(0, "tabs")) return BK_TABS;
    if (part_is(0, "feed")) return BK_FEED;
    if (part_is(0, "/feed")) return BK_FEED_END;
    if (part_is(0, "row")) return BK_ROW;
    if (part_is(0, "empty")) return BK_EMPTY;
    if (part_is(0, "card")) return BK_CARD;
    if (part_is(0, "month")) return BK_MONTH;
    if (part_is(0, "day")) return BK_DAY;
    if (part_is(0, "gap")) return BK_GAP;
    -1
}

// ---- writing on a sheet ----
// The faces: what is read, and what is called out. (What is read is drawn
// a little bolder for a label: SEMI.)
const READ: int = 0;

const BOLD: int = 1;

const SEMI: f32 = 0.05;

// A part's text, written; where the pen ends.
put_part(
    face: int,
    size: f32,
    track: f32,
    even: bool,
    x: f32,
    y: f32,
    f: int,
    weight: f32,
    red: f32,
    g: f32,
    b: f32,
    a: f32
): f32 {
    if (f < 0) return x;
    paint_text(face, size, track, even, x, y, ui_pool, fld_from[f], fld_to[f], weight,
        0.0, red, g, b, a)
}

part_wide(
    face: int,
    size: f32,
    track: f32,
    even: bool,
    f: int
): f32 {
    if (f < 0) return 0.0;
    text_wide(face, size, track, even, ui_pool, fld_from[f], fld_to[f])
}

// A part's text broken into lines no wider than wide: where each ends, and
// where the next starts.
const MAX_WRAP: int = 48;

line_end: []int = new int[MAX_WRAP](0);

line_next: []int = new int[MAX_WRAP](0);

wrap(
    face: int,
    size: f32,
    f: int,
    wide: f32
): int {
    if (f < 0) return 0;
    from: int = fld_from[f];
    to: int = fld_to[f];
    n: int = 0;
    start: int = from;
    while (start < to && n < MAX_WRAP) {
        // The line takes words while they fit (always one).
        end: int = start;
        i: int = start;
        fits: bool = true;
        while (fits && i < to) {
            j: int = i;
            while (j < to && ui_pool[j] == 32i8) j = j + 1;
            while (j < to && ui_pool[j] != 32i8) j = j + 1;
            if (end > start && text_wide(face, size, 0.0, false, ui_pool, start, j) > wide) fits = false else {
                end = j;
                i = j
            }
        }
        line_end[n] = end;
        next: int = end;
        while (next < to && ui_pool[next] == 32i8) next = next + 1;
        line_next[n] = next;
        n = n + 1;
        start = next
    }
    n
}

// The lines of a part, written from (x, y), the first's baseline at y +
// the font's ascent at that size, each line `lead` below the last; how
// tall they are.
put_lines(
    face: int,
    size: f32,
    lead: f32,
    x: f32,
    y: f32,
    f: int,
    wide: f32,
    weight: f32,
    red: f32,
    g: f32,
    b: f32,
    a: f32
): f32 {
    n: int = wrap(face, size, f, wide);
    base: f32 = y + (lead + size * 0.7) * 0.5;
    start: int = fld_from[f];
    for k in 0..n {
        paint_text(face, size, 0.0, false, x, base + lead * k as f32, ui_pool, start,
            line_end[k], weight, 0.0, red, g, b, a);
        start = line_next[k]
    }
    lead * n as f32
}

lines_tall(
    face: int,
    size: f32,
    lead: f32,
    f: int,
    wide: f32
): f32 {
    lead * wrap(face, size, f, wide) as f32
}

// ---- sizes ----
// In CSS pixels, by ui_k: a sheet's padding; and things to press, a
// little bigger on a touch screen.
U(css: f32): f32 {
    css * ui_k
}

touch_or(mouse: f32, finger: f32): f32 {
    if (hud_touch) return finger * ui_k;
    mouse * ui_k
}

const PAD_TOP: f32 = 20.0;

const PAD_SIDE: f32 = 22.0;

const PAD_BOTTOM: f32 = 22.0;

// ---- laying out ----
// The blocks of the sheet s, for its content width wide: each one's top
// (from the content's) and height, and across, for those in a grid; and how
// tall the content is.
layout_page(s: int, wide: f32): f32 {
    y: f32 = 0.0;
    // A grid going on: cards, or days; which column is next.
    col: int = 0;
    row_top: f32 = 0.0;
    in_feed: bool = false;
    feed_y: f32 = 0.0;
    feed_top: f32 = 0.0;
    gap: f32 = U(8.0);
    cell: f32 = (wide - U(4.0) * 6.0) / 7.0;
    for i in 0..nblk[s] {
        b: int = SLOT_BLOCKS * s + i;
        k: int = blk_kind[b];
        blk_feed[b] = in_feed;
        blk_x[b] = 0.0;
        blk_w[b] = wide;
        // (A grid ends where something else comes.)
        if (k != BK_CARD && k != BK_DAY && col > 0) {
            y = row_top + blk_h[b - 1];
            col = 0
        }
        top: f32 = y;
        h: f32 = 0.0;
        if (k == BK_TITLE) {
            h = U(30.0);
            if (block_has(b, 0)) h = h + U(18.0);
            if (block_has(b, 2)) h = maxf(h, touch_or(40.0, 44.0))
        }
        if (k == BK_NOTE) {
            top = y + U(6.0);
            h = lines_tall(READ, U(13.0), U(18.0), part_of(b, 0), wide)
        }
        if (k == BK_PARA) {
            top = y + U(10.0);
            h = lines_tall(READ, U(15.5), U(22.5), part_of(b, 0), wide)
        }
        if (k == BK_BOX) {
            top = y + U(14.0);
            h = U(12.0 + 18.0 + 12.0) + lines_tall(READ, U(15.0), U(21.5), part_of(b,
                1), wide - U(28.0))
        }
        if (k == BK_ITEM || k == BK_ME) {
            top = y + U(8.0);
            h = touch_or(48.0, 52.0)
        }
        if (k == BK_HEAD) {
            top = y + U(18.0);
            h = U(24.0)
        }
        if (k == BK_TABS) {
            top = y + U(12.0);
            h = touch_or(34.0, 38.0)
        }
        if (k == BK_FEED) {
            top = y + U(4.0);
            // (As tall as its rows, to so many of them: the rest scroll.)
            fh: f32 = 0.0;
            j: int = i + 1;
            while (j < nblk[s] && blk_kind[SLOT_BLOCKS * s + j] != BK_FEED_END) {
                if (blk_kind[SLOT_BLOCKS * s + j] == BK_ROW) fh = fh + touch_or(42.0,
                    46.0) else fh = fh + U(38.0);
                j = j + 1
            }
            h = maxf(minf(fh, block_int(b, 0) as f32 * touch_or(42.0, 46.0)), U(38.0));
            feed_view[s] = h;
            feed_top = top;
            in_feed = true;
            feed_y = 0.0
        }
        if (k == BK_ROW) h = touch_or(42.0, 46.0);
        if (k == BK_EMPTY) {
            top = y + U(14.0);
            h = U(24.0)
        }
        if (k == BK_GAP) h = U(block_int(b, 0) as f32);
        if (k == BK_MONTH) {
            top = y + U(8.0);
            h = U(40.0 + 26.0)
        }
        if (k == BK_CARD) {
            h = touch_or(56.0, 60.0);
            whole: bool = block_int(b, 3) == 1;
            if (col == 0) {
                row_top = y + U(10.0);
                if (i > 0 && blk_kind[b - 1] == BK_CARD) row_top = y + gap
            }
            if (whole && col > 0) {
                row_top = row_top + blk_h[b - 1] + gap;
                col = 0
            }
            top = row_top;
            if (whole) {
                y = top + h;
                col = 0
            } else {
                half: f32 = (wide - gap) * 0.5;
                blk_x[b] = col as f32 * (half + gap);
                blk_w[b] = half;
                col = col + 1;
                if (col == 2) {
                    y = top + h;
                    col = 0
                } else y = top
            }
        }
        if (k == BK_DAY) {
            h = cell;
            if (col == 0) {
                row_top = y + U(4.0);
                if (i > 0 && blk_kind[b - 1] == BK_MONTH) row_top = y
            }
            top = row_top;
            blk_x[b] = col as f32 * (cell + U(4.0));
            blk_w[b] = cell;
            col = col + 1;
            if (col == 7) {
                y = top + h;
                col = 0
            } else y = top
        }
        if (in_feed && k != BK_FEED) {
            // (In the feed: from its own top.)
            blk_y[b] = feed_y;
            blk_h[b] = h;
            feed_y = feed_y + h;
            if (k == BK_FEED_END) {
                in_feed = false;
                feed_content[s] = feed_y;
                blk_feed[b] = false
            }
        } else {
            blk_y[b] = top;
            blk_h[b] = h;
            if (k != BK_CARD && k != BK_DAY) y = top + h;
            if (k == BK_FEED_END) feed_content[s] = feed_y
        }
    }
    if (col > 0 && nblk[s] > 0) y = row_top + blk_h[SLOT_BLOCKS * s + nblk[s] - 1];
    y
}

// ---- drawing ----
// The identity of a thing on a sheet (see pressed_by): its sheet, block,
// and which of the block's things.
thing(b: int, k: int): int {
    b * 16 + k
}

// How a thing to press looks with how much it is pressed and pointed at:
// its fill darkens toward the button orange, and it shrinks a little.
press_mix(id: int): f32 {
    pressed_by(id)
}

// The box of a thing to press, drawn: its fill, edge, and (with the keys
// on it) a ring round it. tone: 0 plain, 1 gold, 2 the orange of going on.
put_button(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    radius: f32,
    tone: int,
    id: int,
    lit: f32
) {
    p: f32 = press_mix(id);
    hv: f32 = hovered_by(id);
    // (Pressed, it gives a little.)
    sx: f32 = w * 0.015 * p;
    sy: f32 = h * 0.015 * p;
    x0: f32 = x + sx;
    y0: f32 = y + sy;
    w0: f32 = w - 2.0 * sx;
    h0: f32 = h - 2.0 * sy;
    fr: f32 = INK_R;
    fg: f32 = INK_G;
    fb: f32 = INK_B;
    fa: f32 = 0.07 + 0.07 * hv;
    er: f32 = INK_R;
    eg: f32 = INK_G;
    eb: f32 = INK_B;
    ea: f32 = 0.13 + 0.2 * hv;
    if (tone == 1) {
        fr = GOLD_R;
        fg = GOLD_G;
        fb = GOLD_B;
        fa = 0.13 + 0.07 * hv;
        er = GOLD_R;
        eg = GOLD_G;
        eb = GOLD_B;
        ea = 0.5 + 0.3 * hv
    }
    if (tone == 2) {
        fr = GO_R;
        fg = GO_G;
        fb = GO_B;
        fa = 0.92;
        er = GOLD_R;
        eg = GOLD_G;
        eb = GOLD_B;
        ea = 0.9 + 0.1 * hv
    }
    // Lit (the one picked): as gold.
    if (lit > 0.0) {
        fr = lerpf(fr, GOLD_R, lit);
        fg = lerpf(fg, GOLD_G, lit);
        fb = lerpf(fb, GOLD_B, lit);
        fa = lerpf(fa, 0.18, lit);
        er = lerpf(er, GOLD_R, lit);
        eg = lerpf(eg, GOLD_G, lit);
        eb = lerpf(eb, GOLD_B, lit);
        ea = lerpf(ea, 0.85, lit)
    }
    // Pressed: toward the orange.
    fr = lerpf(fr, 0.94, p);
    fg = lerpf(fg, 0.59, p);
    fb = lerpf(fb, 0.31, p);
    fa = lerpf(fa, 0.6, p);
    if (tone == 2) {
        fr = lerpf(GO_R, 0.78, p);
        fg = lerpf(GO_G, 0.44, p);
        fb = lerpf(GO_B, 0.17, p);
        fa = 0.92;
        paint_shadow(x0, y0, w0, h0, radius, U(3.0), U(8.0), 0.3 * (1.0 - p))
    }
    paint_edge(maxf(1.0, U(1.0)), tone != 0 || lit > 0.5, ea);
    paint_box(x0, y0, w0, h0, radius, fr, fg, fb, fa);
    put_focus(x0, y0, w0, h0, radius, id)
}

// The ring round the thing the keys are on.
focus_id: int = -1;

put_focus(
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    radius: f32,
    id: int
) {
    if (!focus_shown || id != focus_id) return;
    o: f32 = U(3.0);
    paint_outline(x - o, y - o, w + 2.0 * o, h + 2.0 * o, radius + o, U(2.0), GOLD_R,
        GOLD_G, GOLD_B, 0.95)
}

// A chevron pointing right, at (x, y), so big.
put_chevron(
    x: f32,
    y: f32,
    size: f32,
    red: f32,
    g: f32,
    b: f32,
    a: f32
) {
    w: f32 = maxf(1.5, size * 0.16);
    paint_line(x - size * 0.22, y - size * 0.42, x + size * 0.22, y, w, red, g, b,
        a);
    paint_line(x + size * 0.22, y, x - size * 0.22, y + size * 0.42, w, red, g, b,
        a)
}

// A tick, in the box at (x, y), size across.
put_tick(
    x: f32,
    y: f32,
    size: f32,
    red: f32,
    g: f32,
    b: f32,
    a: f32
) {
    w: f32 = maxf(1.5, size * 0.14);
    paint_line(x + size * 0.08, y + size * 0.52, x + size * 0.38, y + size * 0.8,
        w, red, g, b, a);
    paint_line(x + size * 0.38, y + size * 0.8, x + size * 0.92, y + size * 0.22,
        w, red, g, b, a)
}

// Which tabs block of a sheet this is (0 or 1), and where its picked
// one's thumb is drawn, sliding to it.
const MAX_TABS: int = 4;

tab_x: []f32 = new f32[2 * MAX_TABS](0.0);

tab_w: []f32 = new f32[2 * MAX_TABS](0.0);

tab_set: []bool = new bool[2 * MAX_TABS](false);

tabs_fresh(s: int) {
    for k in 0..MAX_TABS tab_set[s * MAX_TABS + k] = false
}

tabs_carry(from: int, to: int) {
    for k in 0..MAX_TABS {
        tab_x[to * MAX_TABS + k] = tab_x[from * MAX_TABS + k];
        tab_w[to * MAX_TABS + k] = tab_w[from * MAX_TABS + k];
        tab_set[to * MAX_TABS + k] = tab_set[from * MAX_TABS + k]
    }
}

// The tabs: a row of words in a pill, the one picked on a thumb that slides
// from one to the next.
put_tabs(
    s: int,
    b: int,
    nth: int,
    x: f32,
    y: f32,
    h: f32,
    live: bool
) {
    n: int = (blk_nf[b] - 1) / 2;
    if (n <= 0) return;
    picked: int = block_int(b, 0);
    size: f32 = touch_or(14.0, 15.0);
    padx: f32 = touch_or(16.0, 18.0);
    inset: f32 = U(3.0);
    total: f32 = inset * 2.0;
    for k in 0..n total = total + part_wide(READ, size, 0.0, false, part_of(b, 2 + k * 2)) + 2.0 * padx;
    radius: f32 = h * 0.5;
    paint_edge(maxf(1.0, U(1.0)), false, 0.16);
    paint_box(x, y, total, h, radius, INK_R, INK_G, INK_B, 0.07);
    // The thumb, under the one picked.
    tx: f32 = x + inset;
    for k in 0..n {
        w: f32 = part_wide(READ, size, 0.0, false, part_of(b, 2 + k * 2)) + 2.0 * padx;
        if (k == picked) {
            j: int = s * MAX_TABS + mini(nth, MAX_TABS - 1);
            if (!tab_set[j]) {
                tab_x[j] = tx - x;
                tab_w[j] = w;
                tab_set[j] = true
            }
            tab_x[j] = ease_to(tab_x[j], tx - x, 18.0);
            tab_w[j] = ease_to(tab_w[j], w, 18.0);
            paint_edge(maxf(1.0, U(1.0)), true, 0.8);
            paint_box(x + tab_x[j], y + inset, tab_w[j], h - 2.0 * inset, radius - inset,
                GOLD_R, GOLD_G, GOLD_B, 0.2)
        }
        tx = tx + w
    }
    tx = x + inset;
    for k in 0..n {
        f: int = part_of(b, 2 + k * 2);
        w: f32 = part_wide(READ, size, 0.0, false, f) + 2.0 * padx;
        id: int = thing(b, k);
        a: f32 = 0.72 + 0.28 * hovered_by(id);
        if (k == picked) a = 1.0;
        p: f32 = pressed_by(id);
        if (p > 0.0) paint_box(tx, y + inset, w, h - 2.0 * inset, radius - inset,
            0.94, 0.59, 0.31, 0.45 * p);
        put_part(READ, size, 0.0, false, tx + padx, y + h * 0.5 + size * 0.36, f,
            SEMI, INK_R, INK_G, INK_B, a);
        put_focus(tx, y + inset, w, h - 2.0 * inset, radius - inset, id);
        if (live) note_hit(tx, y, tx + w, y + h, part_of(b, 1 + k * 2), 0, id, true);
        tx = tx + w
    }
}

// A run: its cells along a row, the one that gives way to the others
// taking what room is left.
put_row(
    b: int,
    x: f32,
    y: f32,
    wide: f32,
    h: f32,
    live: bool
) {
    mine: bool = block_int(b, 1) == 1;
    // The row itself can be pressed (to its place, say).
    row_id: int = thing(b, 15);
    if (block_has(b, 0)) {
        p: f32 = pressed_by(row_id);
        hv: f32 = hovered_by(row_id);
        if (p + hv > 0.0) paint_box(x - U(8.0), y + U(2.0), wide + U(16.0), h - U(4.0),
            U(8.0), lerpf(INK_R, 0.94, p), lerpf(INK_G, 0.59, p), lerpf(INK_B, 0.31,
            p), 0.06 * hv + 0.4 * p);
        put_focus(x - U(8.0), y + U(2.0), wide + U(16.0), h - U(4.0), U(8.0), row_id);
        if (live) note_hit(x - U(8.0), y, x + wide + U(8.0), y + h, part_of(b, 0),
            0, row_id, true)
    }
    // (A line under it.)
    paint_box(x, y + h - maxf(1.0, U(1.0)), wide, maxf(1.0, U(1.0)), 0.0, INK_R, INK_G,
        INK_B, 0.09);
    ncell: int = (blk_nf[b] - 2) / 3;
    size: f32 = touch_or(14.5, 15.0);
    small: f32 = touch_or(13.0, 13.5);
    gap: f32 = U(10.0);
    // How wide each cell is, but the one that gives way.
    flex: int = -1;
    fixed: f32 = 0.0;
    for c in 0..ncell {
        f: int = part_of(b, 2 + c * 3);
        t: int = part_of(b, 4 + c * 3);
        linked: bool = block_has(b, 3 + c * 3);
        cw: f32 = cell_wide(b, c, size, small);
        if (flex < 0 && (block_is(b, 2 + c * 3, "what") || block_is(b, 2 + c * 3,
            "who") && !linked)) flex = c else fixed = fixed + cw;
        if (c > 0) fixed = fixed + gap;
        if (f < 0 || t < 0) fixed = fixed + 0.0
    }
    room: f32 = maxf(wide - fixed, 0.0);
    cx: f32 = x;
    mid: f32 = y + h * 0.5;
    base: f32 = mid + size * 0.36;
    for c in 0..ncell {
        kind_at: int = 2 + c * 3;
        idf: int = part_of(b, 3 + c * 3);
        tf: int = part_of(b, 4 + c * 3);
        linked: bool = block_has(b, 3 + c * 3);
        cw: f32 = cell_wide(b, c, size, small);
        if (c == flex) cw = room;
        // (With nothing to give way, what follows a name to press goes to
        // the row's end.)
        if (flex < 0 && c > 0 && block_is(b, kind_at - 3, "who") && block_has(b, kind_at - 2)) cx = cx + room;
        r: f32 = INK_R;
        g: f32 = INK_G;
        bl: f32 = INK_B;
        a: f32 = 1.0;
        if (mine) {
            r = GOLD_R;
            g = GOLD_G;
            bl = GOLD_B
        }
        id: int = thing(b, c);
        if (block_is(b, kind_at, "n")) put_part(READ, size, 0.0, true, cx, base, tf,
            0.0, 0.6, 0.64, 0.71, 1.0) else if (block_is(b, kind_at, "who") && linked) {
            // A name to press: on a chip of its own.
            ch: f32 = touch_or(30.0, 34.0);
            put_button(cx, mid - ch * 0.5, cw, ch, U(9.0), 0, id, 0.0);
            put_part(READ, size, 0.0, false, cx + U(10.0), base, tf, SEMI, r, g, bl,
                a);
            if (live) note_hit(cx, mid - ch * 0.5, cx + cw, mid + ch * 0.5, idf, 0,
                id, true)
        } else if (block_is(b, kind_at, "who") || block_is(b, kind_at, "what")) put_part(READ,
            size, 0.0, false, cx, base, tf, 0.0, r, g, bl, a) else if (block_is(b,
            kind_at, "score")) put_part(READ, size, 0.0, true, cx, base, tf, SEMI,
            r, g, bl, a) else if (block_is(b, kind_at, "when")) put_part(READ, small,
            0.0, false, cx, mid + small * 0.36, tf, 0.0, 0.6, 0.64, 0.71, 1.0) else if (block_is(b,
            kind_at, "watch")) {
            // A run to watch: a play button.
            ch: f32 = touch_or(28.0, 32.0);
            put_button(cx, mid - ch * 0.5, cw, ch, U(9.0), 0, id, 0.0);
            tri: f32 = ch * 0.36;
            paint_triangle(cx + (cw - tri * 0.86) * 0.5, mid - tri * 0.5, tri * 0.86,
                tri, U(1.0), INK_R, INK_G, INK_B, 0.95);
            if (live) note_hit(cx, mid - ch * 0.5, cx + cw, mid + ch * 0.5, idf, 0,
                id, true)
        }
        cx = cx + cw + gap
    }
}

// How wide a row's cell c is drawn.
cell_wide(
    b: int,
    c: int,
    size: f32,
    small: f32
): f32 {
    kind_at: int = 2 + c * 3;
    tf: int = part_of(b, 4 + c * 3);
    if (block_is(b, kind_at, "n")) return maxf(part_wide(READ, size, 0.0, true, tf),
        U(22.0));
    if (block_is(b, kind_at, "watch")) return touch_or(40.0, 46.0);
    if (block_is(b, kind_at, "who") && block_has(b, kind_at + 1)) return part_wide(READ,
        size, 0.0, false, tf) + U(20.0);
    if (block_is(b, kind_at, "score")) return part_wide(READ, size, 0.0, true, tf);
    if (block_is(b, kind_at, "when")) return part_wide(READ, small, 0.0, false, tf);
    part_wide(READ, size, 0.0, false, tf)
}

// The sheet s's blocks, drawn with the content's top left at (x, y) (the
// scroll already in y), wide across, as much showing as a; and, if it is
// the one up, what can be pressed on it noted. The feed (if any) is drawn
// within the box fx0..fx1, scrolled by its own.
paint_page(
    s: int,
    x: f32,
    y: f32,
    wide: f32,
    a: f32,
    live: bool
) {
    paint_alpha = a;
    // The clip of the sheet's content, to come back to after the feed's.
    cx0: f32 = clip_x0;
    cy0: f32 = clip_y0;
    cx1: f32 = clip_x1;
    cy1: f32 = clip_y1;
    cf: f32 = clip_fade;
    feed_y0: f32 = 0.0;
    nth_tabs: int = 0;
    for i in 0..nblk[s] {
        b: int = SLOT_BLOCKS * s + i;
        k: int = blk_kind[b];
        bx: f32 = x + blk_x[b];
        by: f32 = y + blk_y[b];
        bw: f32 = blk_w[b];
        bh: f32 = blk_h[b];
        if (blk_feed[b]) by = feed_y0 + blk_y[b] - feed_scroll[s];
        if (k == BK_TITLE) {
            ty: f32 = by;
            if (block_has(b, 0)) {
                put_part(BOLD, U(12.0), 0.08, false, bx, ty + U(13.0), part_of(b,
                    0), 0.0, GOLD_R, GOLD_G, GOLD_B, 1.0);
                ty = ty + U(18.0)
            }
            // A button beside the title, to go on.
            right: f32 = bx + bw;
            if (block_has(b, 2)) {
                lf: int = part_of(b, 3);
                lsize: f32 = touch_or(16.0, 17.0);
                pw: f32 = part_wide(BOLD, lsize, 0.0, false, lf) + touch_or(52.0,
                    56.0);
                ph: f32 = touch_or(40.0, 44.0);
                px: f32 = bx + bw - pw;
                py: f32 = by + (bh - ph) * 0.5;
                if (block_has(b, 0)) py = ty + U(15.0) - ph * 0.5;
                id: int = thing(b, 0);
                put_button(px, py, pw, ph, U(12.0), 2, id, 0.0);
                put_part(BOLD, lsize, 0.0, false, px + touch_or(26.0, 28.0), py + ph * 0.5 + lsize * 0.36,
                    lf, 0.0, 1.0, 1.0, 1.0, 1.0);
                if (live) note_hit(px, py, px + pw, py + ph, part_of(b, 2), 0, id,
                    true);
                right = px - U(12.0)
            }
            put_part(BOLD, U(22.0), 0.0, false, bx, ty + U(22.0), part_of(b, 1), 0.0,
                INK_R, INK_G, INK_B, 1.0);
            if (right < 0.0) right = 0.0
        }
        if (k == BK_NOTE) {
            r: f32 = GOLD_R;
            g: f32 = GOLD_G;
            bl: f32 = GOLD_B;
            if (block_is(b, 1, "dim")) {
                r = 0.79;
                g = 0.81;
                bl = 0.86
            }
            put_lines(READ, U(13.0), U(18.0), bx, by, part_of(b, 0), bw, 0.0, r, g,
                bl, 1.0)
        }
        if (k == BK_PARA) {
            a0: f32 = 0.95;
            if (block_is(b, 1, "dim")) a0 = 0.78;
            put_lines(READ, U(15.5), U(22.5), bx, by, part_of(b, 0), bw, 0.0, INK_R,
                INK_G, INK_B, a0)
        }
        if (k == BK_BOX) {
            paint_edge(maxf(1.0, U(1.0)), true, 0.4);
            paint_box(bx, by, bw, bh, U(12.0), GOLD_R, GOLD_G, GOLD_B, 0.08);
            put_part(BOLD, U(12.0), 0.07, false, bx + U(14.0), by + U(12.0 + 11.0),
                part_of(b, 0), 0.0, GOLD_R, GOLD_G, GOLD_B, 1.0);
            put_lines(READ, U(15.0), U(21.5), bx + U(14.0), by + U(12.0 + 18.0), part_of(b,
                1), bw - U(28.0), 0.0, INK_R, INK_G, INK_B, 0.95)
        }
        if (k == BK_ITEM || k == BK_ME) {
            tone: int = 0;
            if (k == BK_ME || block_is(b, 3, "first")) tone = 1;
            id: int = thing(b, 0);
            put_button(bx, by, bw, bh, U(12.0), tone, id, 0.0);
            size: f32 = touch_or(16.0, 17.0);
            base: f32 = by + bh * 0.5 + size * 0.36;
            ta: f32 = 1.0;
            if (block_is(b, 3, "done")) ta = 0.72;
            put_part(READ, size, 0.0, false, bx + U(16.0), base, part_of(b, 1), SEMI + 0.02,
                INK_R, INK_G, INK_B, ta);
            // The word at its end (or a tick, for done), and the chevron.
            ex: f32 = bx + bw - U(16.0);
            put_chevron(ex - U(4.0), by + bh * 0.5, U(14.0), INK_R, INK_G, INK_B,
                0.45);
            ex = ex - U(20.0);
            if (k == BK_ITEM && block_is(b, 3, "done")) put_tick(ex - U(16.0), by + bh * 0.5 - U(8.0),
                U(16.0), 0.56, 0.89, 0.64, 1.0) else if (k == BK_ITEM) {
                bf: int = part_of(b, 2);
                bs: f32 = U(13.0);
                put_part(READ, bs, 0.0, true, ex - part_wide(READ, bs, 0.0, true,
                    bf), by + bh * 0.5 + bs * 0.36, bf, SEMI, GOLD_R, GOLD_G, GOLD_B,
                    1.0)
            }
            if (live) note_hit(bx, by, bx + bw, by + bh, part_of(b, 0), 0, id, true)
        }
        if (k == BK_HEAD) put_part(BOLD, U(15.0), 0.0, false, bx, by + U(17.0), part_of(b,
            0), 0.0, GOLD_R, GOLD_G, GOLD_B, 1.0);
        if (k == BK_TABS) {
            put_tabs(s, b, nth_tabs, bx, by, bh, live);
            nth_tabs = nth_tabs + 1
        }
        if (k == BK_FEED) {
            // From here to its end, within its own box, scrolled by its own.
            feed_y0 = by;
            feed_box[s * 4] = bx - U(10.0);
            feed_box[s * 4 + 1] = by;
            feed_box[s * 4 + 2] = bx + bw + U(10.0);
            feed_box[s * 4 + 3] = by + bh;
            ffade: f32 = 0.0;
            if (feed_content[s] > feed_view[s] + 1.0) ffade = U(14.0);
            paint_clip_within(bx - U(10.0), by, bx + bw + U(10.0), by + bh, ffade)
        }
        if (k == BK_FEED_END) {
            put_bar(feed_box[s * 4 + 2] - U(4.0), feed_box[s * 4 + 1], feed_box[s * 4 + 3] - feed_box[s * 4 + 1],
                feed_scroll[s], feed_content[s], feed_view[s], s);
            paint_clip(cx0, cy0, cx1, cy1, cf)
        }
        if (k == BK_ROW) put_row(b, bx, by, bw, bh, live);
        if (k == BK_EMPTY) put_part(READ, U(15.0), 0.0, false, bx, by + U(16.0), part_of(b,
            0), 0.0, 0.6, 0.64, 0.71, 1.0);
        if (k == BK_CARD) {
            tone: int = 0;
            if (block_is(b, 4, "daily")) tone = 1;
            id: int = thing(b, 0);
            put_button(bx, by, bw, bh, U(12.0), tone, id, 0.0);
            size: f32 = touch_or(17.0, 18.0);
            fa: f32 = 1.0;
            face: int = BOLD;
            if (block_is(b, 4, "past")) {
                size = touch_or(15.0, 16.0);
                fa = 0.8;
                face = READ
            }
            put_part(face, size, 0.0, false, bx + U(14.0), by + bh * 0.5 + size * 0.36,
                part_of(b, 1), SEMI, INK_R, INK_G, INK_B, fa);
            if (block_has(b, 2)) {
                ss: f32 = U(13.0);
                sf: int = part_of(b, 2);
                put_part(READ, ss, 0.0, true, bx + bw - U(14.0) - part_wide(READ,
                    ss, 0.0, true, sf), by + bh * 0.5 + ss * 0.36, sf, SEMI, GOLD_R,
                    GOLD_G, GOLD_B, 1.0)
            } else if (block_is(b, 4, "past")) put_chevron(bx + bw - U(18.0), by + bh * 0.5,
                U(13.0), INK_R, INK_G, INK_B, 0.45);
            if (live) note_hit(bx, by, bx + bw, by + bh, part_of(b, 0), 0, id, true)
        }
        if (k == BK_MONTH) {
            // The month's name between its two buttons, and the days'
            // initials under it.
            bs: f32 = U(36.0);
            for side in 0..2 {
                f: int = part_of(b, side * 2);
                bxs: f32 = bx;
                if (side == 1) bxs = bx + bw - bs;
                id: int = thing(b, side);
                on: bool = block_has(b, side * 2);
                if (on) put_button(bxs, by + U(2.0), bs, bs, bs * 0.5, 0, id, 0.0);
                ca: f32 = 0.25;
                if (on) ca = 0.95;
                if (side == 0) {
                    w: f32 = maxf(1.5, U(2.2));
                    mx: f32 = bxs + bs * 0.5;
                    my: f32 = by + U(2.0) + bs * 0.5;
                    paint_line(mx + U(3.0), my - U(6.0), mx - U(3.0), my, w, INK_R,
                        INK_G, INK_B, ca);
                    paint_line(mx - U(3.0), my, mx + U(3.0), my + U(6.0), w, INK_R,
                        INK_G, INK_B, ca)
                } else put_chevron(bxs + bs * 0.5, by + U(2.0) + bs * 0.5, U(13.0),
                    INK_R, INK_G, INK_B, ca);
                if (live && on) note_hit(bxs, by + U(2.0), bxs + bs, by + U(2.0) + bs,
                    f, 0, id, true)
            }
            lf: int = part_of(b, 1);
            ls: f32 = U(16.0);
            put_part(READ, ls, 0.0, false, bx + (bw - part_wide(READ, ls, 0.0, false,
                lf)) * 0.5, by + U(20.0) + ls * 0.36, lf, SEMI + 0.02, INK_R, INK_G,
                INK_B, 1.0);
            cell: f32 = (bw - U(4.0) * 6.0) / 7.0;
            for d in 0..7 {
                cx: f32 = bx + d as f32 * (cell + U(4.0)) + cell * 0.5;
                ws: f32 = U(12.0);
                put_str_centered(READ, ws, cx, by + U(40.0 + 17.0), weekday(d), 0.6,
                    0.64, 0.71, 1.0)
            }
        }
        if (k == BK_DAY) {
            on: bool = block_is(b, 2, "on");
            today: bool = block_is(b, 2, "today");
            blank: bool = block_is(b, 2, "blank");
            id: int = thing(b, 0);
            d: f32 = minf(bw, U(44.0));
            cx: f32 = bx + bw * 0.5;
            cy: f32 = by + bh * 0.5;
            if (on) {
                p: f32 = pressed_by(id);
                hv: f32 = hovered_by(id);
                paint_disc(cx, cy, d * 0.5 * (1.0 - 0.03 * p), lerpf(INK_R, 0.94,
                    p), lerpf(INK_G, 0.59, p), lerpf(INK_B, 0.31, p), 0.07 + 0.05 * hv + 0.5 * p);
                paint_ring(cx, cy, d * 0.5, maxf(1.0, U(1.0)), INK_R, INK_G, INK_B,
                    0.28);
                put_focus(cx - d * 0.5, cy - d * 0.5, d, d, d * 0.5, id);
                if (live) note_hit(cx - d * 0.5, cy - d * 0.5, cx + d * 0.5, cy + d * 0.5,
                    part_of(b, 0), 0, id, true)
            }
            if (today) paint_ring(cx, cy, d * 0.5, maxf(1.0, U(1.2)), GOLD_R, GOLD_G,
                GOLD_B, 1.0);
            if (!blank) {
                tf: int = part_of(b, 1);
                ts: f32 = U(15.0);
                r: f32 = INK_R;
                g: f32 = INK_G;
                bl: f32 = INK_B;
                ta: f32 = 1.0;
                if (!on && !today) ta = 0.32;
                if (today) {
                    r = GOLD_R;
                    g = GOLD_G;
                    bl = GOLD_B
                }
                put_part(READ, ts, 0.0, true, cx - part_wide(READ, ts, 0.0, true,
                    tf) * 0.5, cy + ts * 0.36, tf, SEMI, r, g, bl, ta)
            }
        }
    }
    paint_alpha = 1.0
}

// A scroll bar, at x, from y down tall: where the view of so much content is
// (it shows while it scrolls, and fades after).
put_bar(
    x: f32,
    y: f32,
    tall: f32,
    at: f32,
    content: f32,
    view: f32,
    s: int
) {
    if (content <= view + 1.0) return;
    a: f32 = 1.0 - smooth((bar_t[s] - 0.6) / 0.5);
    if (a <= 0.0) return;
    inset: f32 = U(6.0);
    room: f32 = tall - 2.0 * inset;
    len: f32 = maxf(room * view / content, U(24.0));
    // (Past an end, it shortens, as the content does.)
    over: f32 = 0.0;
    if (at < 0.0) over = -at;
    if (at > content - view) over = at - (content - view);
    len = maxf(len - over, U(8.0));
    top: f32 = y + inset + (room - len) * clampf(at / (content - view), 0.0, 1.0);
    paint_box(x - U(1.5), top, U(3.0), len, U(1.5), INK_R, INK_G, INK_B, 0.42 * a)
}

weekday(d: int): str {
    if (d == 0 || d == 6) return "S";
    if (d == 1) return "M";
    if (d == 2 || d == 4) return "T";
    if (d == 3) return "W";
    "F"
}

put_str_centered(
    face: int,
    size: f32,
    cx: f32,
    y: f32,
    t: str,
    red: f32,
    g: f32,
    b: f32,
    a: f32
) {
    paint_str(face, size, 0.0, cx - text_wide_str(face, size, 0.0, t) * 0.5, y, t,
        red, g, b, a)
}

// ---- the sheet itself ----
// Where the sheet s goes, for its content height: its box (sheet_x, ..);
// and how much of its content shows (view_h).
sheet_x: f32 = 0.0;

sheet_y: f32 = 0.0;

sheet_w: f32 = 0.0;

sheet_h: f32 = 0.0;

place_sheet(s: int) {
    w: f32 = screen_w as f32;
    h: f32 = screen_h as f32;
    css_w: f32 = w / ui_k;
    css_h: f32 = h / ui_k;
    top: f32 = maxf(U(10.0), safe_t + U(6.0));
    room: f32 = maxf(U(page_room[s]), safe_b + U(page_room[s] - 6.0));
    wide: f32 = minf(U(page_wide[s]), w - U(20.0) - safe_l - safe_r);
    content: f32 = layout_page(s, wide - U(PAD_SIDE) * 2.0);
    content_h[s] = content;
    // (A sheet that ends with the feed ends at the feed's foot, where its
    // rows scroll out under the sheet's edge.)
    foot: f32 = PAD_BOTTOM;
    if (nblk[s] > 0 && blk_kind[SLOT_BLOCKS * s + nblk[s] - 1] == BK_FEED_END) foot = 4.0;
    whole: f32 = content + U(PAD_TOP + foot);
    if (page_place[s] == PLACE_DOCK && css_w >= 820.0) {
        // (Wide: at the right, clear of what lies ahead of him.)
        most: f32 = h - top - room;
        sheet_h = minf(maxf(whole, sticky_h[s]), most);
        sheet_w = wide;
        sheet_x = w - safe_r - U(16.0) - wide;
        sheet_y = top + (most - sheet_h) * 0.5
    } else if (page_place[s] == PLACE_DOCK) {
        // (Tall: along the bottom, the place behind it above.)
        most: f32 = minf(h * 0.6, h - top - room);
        if (css_h < 560.0) most = h - top - room;
        sheet_h = minf(maxf(whole, sticky_h[s]), most);
        sheet_w = wide;
        sheet_x = (w - wide) * 0.5;
        sheet_y = h - room - sheet_h
    } else {
        most: f32 = h - top - room;
        sheet_h = minf(maxf(whole, sticky_h[s]), most);
        sheet_w = wide;
        sheet_x = (w - wide) * 0.5;
        sheet_y = top + (most - sheet_h) * 0.5
    }
    view_h[s] = sheet_h - U(PAD_TOP + foot);
    shown_h[s] = sheet_h
}

// The sheets, coming and going: the pane where the one up is (moving there
// from where the last was), and on it the one up and the one going, each
// sliding and fading.
paint_sheets() {
    s: int = cur;
    target_a: f32 = sheet_target_a();
    // Where the pane goes: where the sheet up is, or (going to none) where
    // the one going is.
    lay: int = s;
    if (page_place[s] == PLACE_NONE && was >= 0) lay = was;
    if (page_place[lay] != PLACE_NONE) {
        place_sheet(lay);
        if (pan_fresh || pan_a < 0.01) {
            pan_x = sheet_x;
            pan_y = sheet_y;
            pan_w = sheet_w;
            pan_h = sheet_h;
            pan_fresh = false
        } else {
            pan_x = ease_to(pan_x, sheet_x, 16.0);
            pan_y = ease_to(pan_y, sheet_y, 16.0);
            pan_w = ease_to(pan_w, sheet_w, 16.0);
            pan_h = ease_to(pan_h, sheet_h, 16.0)
        }
    }
    // (The other, laid out for drawing as it goes.)
    if (was >= 0 && was != lay && page_place[was] != PLACE_NONE) {
        place_sheet(was);
        place_sheet(lay)
    }
    pan_a = step_to(pan_a, target_a, ui_dt / 0.24);
    seen_pan[0] = 0.0;
    seen_pan[1] = 0.0;
    seen_pan[2] = 0.0;
    seen_pan[3] = 0.0;
    feed_box[s * 4 + 2] = 0.0;
    if (pan_a <= 0.002) return;
    // The pane: a soft shadow, frosted glass, and a fine edge; rising a
    // little as it comes, and sinking as it goes.
    k: f32 = ease_out(pan_a);
    rise: f32 = U(14.0) * (1.0 - k);
    x: f32 = pan_x;
    y: f32 = pan_y + rise;
    w: f32 = pan_w;
    h: f32 = pan_h;
    radius: f32 = U(18.0);
    paint_noclip();
    paint_alpha = k;
    paint_shadow_round(x, y, w, h, radius, U(16.0), U(30.0), 0.38);
    paint_edge(maxf(1.0, U(1.0)), false, 0.13);
    paint_frost(x, y, w, h, radius, 0.05, 0.055, 0.072, 0.84);
    paint_alpha = 1.0;
    if (pan_a > 0.5) {
        seen_pan[0] = x;
        seen_pan[1] = y;
        seen_pan[2] = x + w;
        seen_pan[3] = y + h
    }
    // The content, clipped to the pane, fading at its top and bottom where
    // there is more to scroll to.
    fade: f32 = 0.0;
    if (content_h[s] > view_h[s] + 1.0) fade = U(16.0);
    paint_clip(x + 1.0, y + U(3.0), x + w - 1.0, y + h - U(3.0), fade);
    t: f32 = ease_out(trans_t);
    slide: f32 = U(30.0);
    inner: f32 = w - U(PAD_SIDE) * 2.0;
    if (was >= 0 && trans_t < 1.0 && page_place[was] != PLACE_NONE) {
        // The one going: out the way it goes, faster than the other comes.
        out: f32 = 1.0 - minf(trans_t * 1.7, 1.0);
        ox: f32 = x + U(PAD_SIDE) - trans_dir as f32 * slide * t;
        paint_page(was, ox, y + U(PAD_TOP) - scroll[was], inner, out * k, false);
        paint_clip(x + 1.0, y + U(3.0), x + w - 1.0, y + h - U(3.0), fade)
    }
    if (page_place[s] != PLACE_NONE) {
        a: f32 = k;
        dx: f32 = 0.0;
        if (was >= 0 && trans_t < 1.0 && page_place[was] != PLACE_NONE) {
            a = k * smooth((trans_t - 0.12) / 0.88);
            dx = trans_dir as f32 * slide * (1.0 - t)
        }
        focus_id = -1;
        if (focus_shown && focus >= 0) {
            fk: int = sheet_hit(focus);
            if (fk >= 0) focus_id = seen_id[fk]
        }
        paint_page(s, x + U(PAD_SIDE) + dx, y + U(PAD_TOP) - scroll[s], inner, a,
            trans_t > 0.5);
        paint_alpha = a;
        put_bar(x + w - U(5.0), y, h, scroll[s], content_h[s], view_h[s], s);
        paint_alpha = 1.0
    }
    paint_noclip()
}
