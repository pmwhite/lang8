tag skate;

// The slope course: a long concrete run down a grassy hill, with rails,
// rollers, kickers, halfpipes, cliffs, and gaps on the way to a finish
// line, laid out afresh for each course (see layout.l8). Distance down the
// run is d, toward -z; x is across it. The ground is one smooth height
// function: the hill's fall line, banks either side that turn him back in,
// and the features on top.
const COURSE_HALF: f32 = 11.0;

const COURSE_FINISH: f32 = 300.0;

// Where this place's finish is: the course's, or sooner (big air's).
course_finish: f32 = COURSE_FINISH;

// Where the hill itself levels out: this place's finish; but for the
// tutorial's lessons, the whole tutorial's, each lesson being a stretch of
// one hill, built once (see go_to, in main.l8).
terrain_finish: f32 = COURSE_FINISH;

const COURSE_START: f32 = -12.0;

const COURSE_END: f32 = 380.0;

// The hill's height, sampled along d by its grade.
const BASE_STEP: f32 = 0.25;

const BASE_N: int = 1700;

course_base_h: []f32 = static_buffer(BASE_N, 0.0);

course_grade(d: f32): f32 {
    if (big_air) return big_air_grade(d);
    if (d < 0.0) return 0.0;
    if (d < 20.0) return lerpf(0.0, 0.48, smoothstepf(0.0, 4.0, d)) - 0.24 * smoothstepf(10.0,
        20.0, d);
    if (d < terrain_finish) return 0.24;
    if (d < terrain_finish + 35.0) return 0.24 * (1.0 - smoothstepf(terrain_finish,
        terrain_finish + 35.0, d));
    -0.12 * smoothstepf(terrain_finish + 45.0, terrain_finish + 80.0, d)
}

// Big air's hill: a steep drop-in, easing onto a shelf that the kicker
// stands on; from its lip the hill plunges again, under the landing, as a
// mega ramp's does (so that he has far to fall, and lands on a slope as
// steep as he comes down); then it eases to a run-out to the finish.
big_air_grade(d: f32): f32 {
    if (d < 0.0) return 0.0;
    if (d < BIG_AIR_KICK) return lerpf(0.0, BIG_AIR_DROP, smoothstepf(0.0, 8.0, d)) - (BIG_AIR_DROP - BIG_AIR_SHELF) * smoothstepf(BIG_AIR_KICK - 26.0,
        BIG_AIR_KICK - 6.0, d);
    if (d < big_air_out) return lerpf(BIG_AIR_SHELF, BIG_AIR_LAND, smoothstepf(big_air_lip,
        big_air_lip + 4.0, d));
    if (d < terrain_finish) return lerpf(BIG_AIR_LAND, 0.16, smoothstepf(big_air_out,
        big_air_out + 16.0, d));
    if (d < terrain_finish + 35.0) return 0.16 * (1.0 - smoothstepf(terrain_finish,
        terrain_finish + 35.0, d));
    -0.12 * smoothstepf(terrain_finish + 45.0, terrain_finish + 80.0, d)
}

base_index(d: f32): f32 {
    clampf((d - COURSE_START + 20.0) / BASE_STEP, 0.0, (BASE_N - 2) as f32)
}

// The hill, by its grade, and the cliffs down it, which drop all that
// follows.
load_base() {
    h: f32 = 0.0;
    course_base_h[0] = 0.0;
    for i in 1..BASE_N {
        d: f32 = COURSE_START - 20.0 + (i as f32 - 0.5) * BASE_STEP;
        h = h - course_grade(d) * BASE_STEP;
        course_base_h[i] = h - cliffs_below(COURSE_START - 20.0 + i as f32 * BASE_STEP)
    }
}

// How far the cliffs above d have dropped the hill there.
cliffs_below(d: f32): f32 {
    drop: f32 = 0.0;
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_CLIFF) drop = drop + cliff_drop(f, d - f.d)
    }
    drop
}

// A cliff: a face a long falling most of its height h, then a landing c
// long the rest of the way.
cliff_drop(f: Feature, s: f32): f32 {
    if (s <= 0.0) return 0.0;
    if (s < f.a) return 0.75 * f.h * smoothstepf(0.0, f.a, s);
    0.75 * f.h + 0.25 * f.h * smoothstepf(0.0, f.c, s - f.a)
}

course_base(d: f32): f32 {
    f: f32 = base_index(d);
    i: int = f as int;
    lerpf(course_base_h[i], course_base_h[i + 1], f - i as f32)
}

// The banks: the ground rises past the run's edge.
course_bank(x: f32): f32 {
    e: f32 = absf(x) - COURSE_HALF;
    if (e <= 0.0) return 0.0;
    3.2 * smoothstepf(0.0, 5.0, e) + 0.12 * e
}

// ---- features ----
// A kicker: up a ramp of length a to its lip at height h, a table b long a
// little below the lip, and a landing c long back down to the hill, w wide
// (half) before its sides fall away. Rollers: n waves of height h, a apart,
// across the run.
//
// A halfpipe: a stretch a long where the run's sides curve up into walls,
// with a deck along their tops. A cliff: the run drops h (see cliff_drop).
// A gap: a kicker whose table is a pit b long, the landing on its far side.
const FEATURE_KICKER: int = 0;

const FEATURE_ROLLERS: int = 1;

const FEATURE_PIPE: int = 2;

const FEATURE_CLIFF: int = 3;

const FEATURE_GAP: int = 4;

// The park's bowl: its walls all round (see park_ground, in park.l8).
const FEATURE_BOWL: int = 5;

// The halfpipe's flat bottom (half its width), and the radius of its
// walls' curve, which rises to PIPE_STEEP of the way to vertical.
const PIPE_FLAT: f32 = 3.8;

const PIPE_R: f32 = 4.4;

const PIPE_STEEP: f32 = 0.95;

// How deep a gap's pit is below the hill, and its far face, from the pit
// up to the landing.
const GAP_DEPTH: f32 = 1.0;

const GAP_FACE: f32 = 2.0;

type Feature = {
    kind: int;
    x: f32;
    d: f32;
    w: f32;
    h: f32;
    a: f32;
    b: f32;
    c: f32;
    // Which way it faces: 0 down the run, as on the course; in the park,
    // any way (see feature_local).
    yaw: f32
}

const MAX_FEATURES: int = 48;

features: []Feature = static_buffer(MAX_FEATURES, Feature {
    kind: 0,
    x: 0.0,
    d: 0.0,
    w: 0.0,
    h: 0.0,
    a: 0.0,
    b: 0.0,
    c: 0.0,
    yaw: 0.0
});

nfeatures: int = 0;

// The step down from a kicker's lip to its table.
const LIP_DROP: f32 = 0.35;

const LIP_GAP: f32 = 0.5;

add_feature(
    kind: int,
    x: f32,
    d: f32,
    w: f32,
    h: f32,
    a: f32,
    b: f32,
    c: f32
) {
    features[nfeatures] = Feature {
        kind: kind,
        x: x,
        d: d,
        w: w,
        h: h,
        a: a,
        b: b,
        c: c,
        yaw: 0.0
    };
    feature_from[nfeatures] = d;
    feature_to[nfeatures] = d + feature_len(features[nfeatures]);
    feature_straight[nfeatures] = true;
    nfeatures = nfeatures + 1
}

// Where along the run each feature begins and ends, and whether it lies
// straight down it (not turned, as the park's are): so that the ground at
// d need look only at the few features there.
feature_from: []f32 = static_buffer(MAX_FEATURES, 0.0);

feature_to: []f32 = static_buffer(MAX_FEATURES, 0.0);

feature_straight: []bool = static_buffer(MAX_FEATURES, false);

// Whether feature i could reach d.
feature_near(i: int, d: f32): bool {
    !feature_straight[i] || d > feature_from[i] - 0.01 && d < feature_to[i] + 0.01
}

// Where (x, d) is in f's own frame: across it in x, along it in z (its x
// and d as if it lay down the run). Turned by its yaw about the middle of
// the world, so that one facing down the run (yaw 0) has the run's own
// frame. The same turn takes a point back again (see feature_world).
feature_local(f: Feature, x: f32, d: f32): V3 {
    turned(f.yaw, x, d)
}

turned(yaw: f32, x: f32, d: f32): V3 {
    if (yaw == 0.0) return v3(x, 0.0, d);
    c: f32 = cosf(yaw);
    s: f32 = sinf(yaw);
    z: f32 = -d;
    v3(x * c + z * s, 0.0, x * s - z * c)
}

// The ground at (x, d) in f's frame.
feature_world(f: Feature, x: f32, d: f32): V3 {
    c: f32 = cosf(f.yaw);
    s: f32 = sinf(f.yaw);
    wx: f32 = x * c + d * s;
    wz: f32 = x * s - d * c;
    v3(wx, course_height(wx, wz), wz)
}

// Across f, to its right; and along it.
feature_right(f: Feature): V3 {
    v3(cosf(f.yaw), 0.0, sinf(f.yaw))
}

feature_fwd(f: Feature): V3 {
    v3(sinf(f.yaw), 0.0, -cosf(f.yaw))
}

// A kicker sized by its height: the bigger, the longer its table and
// landing.
add_kicker(
    x: f32,
    d: f32,
    w: f32,
    h: f32
) {
    add_feature(FEATURE_KICKER, x, d, w, h, 2.2 + h * 1.2, 0.5 + h * 1.2, 6.0 + h * 4.0)
}

feature_len(f: Feature): f32 {
    if (f.kind == FEATURE_ROLLERS) return f.a * f.b;
    if (f.kind == FEATURE_PIPE) return f.a;
    if (f.kind == FEATURE_CLIFF) return f.a + f.c;
    if (f.kind == FEATURE_GAP) return f.a + LIP_GAP + f.b + GAP_FACE + f.c;
    f.a + LIP_GAP + f.b + f.c
}

// Where a kicker's, gap's, or cliff's landing begins, along it.
landing_start(f: Feature): f32 {
    if (f.kind == FEATURE_GAP) return f.a + LIP_GAP + f.b + GAP_FACE;
    if (f.kind == FEATURE_CLIFF) return f.a;
    f.a + LIP_GAP + f.b
}

// The halfpipe's walls at x, at full height.
pipe_wall(x: f32): f32 {
    u: f32 = clampf(absf(x) - PIPE_FLAT, 0.0, PIPE_R * PIPE_STEEP);
    PIPE_R - sqrtf(PIPE_R * PIPE_R - u * u)
}

// Where the halfpipe's walls end and its deck begins.
pipe_top(): f32 {
    PIPE_FLAT + PIPE_R * PIPE_STEEP
}

pipe_height(f: Feature, x: f32, d: f32): f32 {
    s: f32 = d - f.d;
    if (s <= 0.0 || s >= f.a) return 0.0;
    // Its walls grow from nothing where it begins and sink where it ends.
    e: f32 = smoothstepf(0.0, 7.0, s) * (1.0 - smoothstepf(f.a - 7.0, f.a, s));
    pipe_wall(x) * e
}

// Whether (x, d) is up a halfpipe's wall (or on its deck), and which.
pipe_at(x: f32, d: f32): int {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_PIPE && d > f.d + 5.0 && d < f.d + f.a - 5.0 && absf(x) > PIPE_FLAT + 0.5) return i
    }
    -1
}

// Height of f above the hill at s along it, before its sides fall away.
feature_profile(f: Feature, s: f32): f32 {
    if (s <= 0.0 || s >= feature_len(f)) return 0.0;
    if (f.kind == FEATURE_ROLLERS) return f.h * (0.5 - 0.5 * cosf(TAU * s / f.a));
    if (f.kind == FEATURE_GAP) return gap_profile(f, s);
    if (s < f.a) {
        u: f32 = s / f.a;
        return f.h * u * u
    }
    s = s - f.a;
    top: f32 = f.h - LIP_DROP;
    if (s < LIP_GAP) return f.h - LIP_DROP * smoothstepf(0.0, LIP_GAP, s);
    s = s - LIP_GAP;
    if (s < f.b) return top;
    s = s - f.b;
    top * (0.5 + 0.5 * cosf(PI * s / f.c))
}

// A gap: up its ramp, over the lip into the pit, up the far face to the
// landing, and down it.
gap_profile(f: Feature, s: f32): f32 {
    if (s < f.a) {
        u: f32 = s / f.a;
        return f.h * u * u
    }
    s = s - f.a;
    if (s < LIP_GAP) return lerpf(f.h, -GAP_DEPTH, smoothstepf(0.0, LIP_GAP, s));
    s = s - LIP_GAP;
    if (s < f.b) return -GAP_DEPTH;
    s = s - f.b;
    top: f32 = f.h - LIP_DROP;
    if (s < GAP_FACE) return lerpf(-GAP_DEPTH, top, smoothstepf(0.0, GAP_FACE, s));
    s = s - GAP_FACE;
    top * (0.5 + 0.5 * cosf(PI * s / f.c))
}

feature_across(f: Feature, x: f32): f32 {
    1.0 - smoothstepf(f.w, f.w + 1.6, absf(x - f.x))
}

feature_height(f: Feature, x: f32, d: f32): f32 {
    // A cliff is part of the hill (see load_base), and the park's bowl is
    // part of its ground.
    if (f.kind == FEATURE_CLIFF || f.kind == FEATURE_BOWL) return 0.0;
    l: V3 = feature_local(f, x, d);
    if (f.kind == FEATURE_PIPE) return pipe_height(f, l.x, l.z);
    s: f32 = l.z - f.d;
    if (s <= 0.0 || s >= feature_len(f)) return 0.0;
    a: f32 = feature_across(f, l.x);
    if (a <= 0.0) return 0.0;
    feature_profile(f, s) * a
}

// Everything on top of the hill and banks at (x, d).
features_at(x: f32, d: f32): f32 {
    h: f32 = 0.0;
    if (bins_on) {
        // (Only the few that lie about d: see build_bins.)
        k: int = bin_of(d);
        for j in 0..bin_n[k] {
            i: int = bin_i[k * BIN_MAX + j];
            if (feature_near(i, d)) h = h + feature_height(features[i], x, d)
        }
        return h
    }
    for i in 0..nfeatures {
        if (feature_near(i, d)) h = h + feature_height(features[i], x, d)
    }
    h
}

// The ground's height is asked for a great many times as a place is
// built, and each time of every feature whether it lies about there. Down
// a course the features lie one after another, so the run is cut into
// bins, each with the few features that reach into it (in their own
// order, so that the sums are the same sums). Not in a park, whose
// features lie every way.
const BIN_LEN: f32 = 4.0;

const BIN_MAX: int = 12;

const NBINS: int = 144;

bin_n: []int = static_buffer(NBINS, 0);

bin_i: []int = static_buffer(NBINS * BIN_MAX, 0);

bins_on: bool = false;

bin_of(d: f32): int {
    k: int = ((d - COURSE_START + 40.0) / BIN_LEN) as int;
    if (k < 0) return 0;
    if (k > NBINS - 1) return NBINS - 1;
    k
}

build_bins() {
    bins_on = false;
    for k in 0..NBINS bin_n[k] = 0;
    for i in 0..nfeatures {
        if (!feature_straight[i]) return;
        a: int = bin_of(feature_from[i] - 0.5);
        b: int = bin_of(feature_to[i] + 0.5);
        for k in a..b + 1 {
            if (bin_n[k] >= BIN_MAX) return;
            bin_i[k * BIN_MAX + bin_n[k]] = i;
            bin_n[k] = bin_n[k] + 1
        }
    }
    bins_on = true
}

// Which kicker (or gap) (x, d) is on, or -1.
kicker_at(x: f32, d: f32): int {
    for i in 0..nfeatures {
        if (feature_near(i, d)) {
            f: Feature = features[i];
            if (f.kind == FEATURE_KICKER || f.kind == FEATURE_GAP) {
                if (absf(feature_height(f, x, d)) > 0.02) return i
            }
        }
    }
    -1
}

// What he flies off at (x, d): a kicker or gap, a halfpipe's wall, a
// cliff's edge; or -1, the plain hill.
takeoff_feature(x: f32, d: f32): int {
    k: int = kicker_at(x, d);
    if (k >= 0) return k;
    if (park && park_out(x, -d) > 0.3) return bowl_i;
    p: int = pipe_at(x, d);
    if (p >= 0) return p;
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_CLIFF && d > f.d - 2.0 && d < f.d + f.a + 1.0) return i
    }
    -1
}

course_height(x: f32, z: f32): f32 {
    d: f32 = -z;
    if (park) return park_ground(x, z) + features_at(x, d);
    course_base(d) + course_bank(x) + features_at(x, d)
}

course_normal(x: f32, z: f32): V3 {
    e: f32 = 0.05;
    hx: f32 = (course_height(x + e, z) - course_height(x - e, z)) / (2.0 * e);
    hz: f32 = (course_height(x, z + e) - course_height(x, z - e)) / (2.0 * e);
    v_norm(v3(-hx, 1.0, -hz))
}

// ---- rails ----
// A rail is a straight bar from one point to another, a box a wider one;
// a rail may carry on into the next (a kink).
type CRail = {
    a: V3;
    b: V3;
    box: bool;
    next: int
}

const MAX_RAILS: int = 64;

crails: []CRail = static_buffer(MAX_RAILS, CRail {
    a: V3 { x: 0.0, y: 0.0, z: 0.0 },
    b: V3 { x: 0.0, y: 0.0, z: 0.0 },
    box: false,
    next: -1
});

ncrails: int = 0;

// A rail from d0 to d1 at x, starting h0 above the hill and ending h1
// above it.
add_rail(
    x: f32,
    d0: f32,
    d1: f32,
    h0: f32,
    h1: f32,
    box: bool
): int {
    crails[ncrails] = CRail {
        a: v3(x, course_base(d0) + h0, -d0),
        b: v3(x, course_base(d1) + h1, -d1),
        box: box,
        next: -1
    };
    ncrails = ncrails + 1;
    ncrails - 1
}

// A flat-down rail: level from d0 to dk, then down along the hill to d1.
add_kink(
    x: f32,
    d0: f32,
    dk: f32,
    d1: f32,
    h0: f32
) {
    y: f32 = course_base(d0) + h0;
    first: int = ncrails;
    crails[ncrails] = CRail {
        a: v3(x, y, -d0),
        b: v3(x, y, -dk),
        box: false,
        next: first + 1
    };
    ncrails = ncrails + 1;
    hk: f32 = y - course_base(dk);
    add_rail(x, dk, d1, hk, hk, false)
}

// The top of a rail, where he rides it.
const RAIL_TOP: f32 = 0.05;

const BOX_TOP: f32 = 0.0;

rail_top(r: CRail): f32 {
    if (r.box) return BOX_TOP;
    RAIL_TOP
}

// ---- lamps ----
// Lamp posts stand along the run's edges, and by night light it in pools
// (see lamp_map in render.l8). They stand by day too, unlit, so that night
// can fall without the course being built again.
const MAX_LAMPS: int = 80;

const LAMP_HEIGHT: f32 = 3.0;

const LAMP_SPACING: f32 = 22.0;

// Where each post stands.
lamp_x: []f32 = static_buffer(MAX_LAMPS, 0.0);

lamp_z: []f32 = static_buffer(MAX_LAMPS, 0.0);

nlamps: int = 0;

// A lamp every LAMP_SPACING down the run, on one side and then the other,
// a little up the bank: pools of light with dark between.
place_lamps() {
    nlamps = 0;
    d: f32 = 4.0;
    side: f32 = 1.0;
    while (d < terrain_finish + 50.0 && nlamps < MAX_LAMPS) {
        lamp_x[nlamps] = side * (COURSE_HALF + 1.5);
        lamp_z[nlamps] = -d;
        nlamps = nlamps + 1;
        side = -side;
        d = d + LAMP_SPACING
    }
}

// A lamp post: slender and dark, a lantern on top.
// A lamp post: its light shines down from under a shade, so that what
// shows is the light on the ground, not a bright bulb.
put_lamp_post(m: *Mesh, x: f32, z: f32) {
    y: f32 = course_height(x, z);
    post: V3 = v3(0.12, 0.13, 0.14);
    top: f32 = y + LAMP_HEIGHT;
    put_tube(m, v3(x, y - 0.1, z), v3(x, top + 0.05, z), 0.05, post, MAT_PAINT);
    at(x, top + 0.08, z);
    put_rounded_box(m, xf, v3(0.24, 0.07, 0.24), 0.05, 0.0, 2, post, MAT_PAINT);
    at(x, top, z);
    put_rounded_box(m, xf, v3(0.18, 0.015, 0.18), 0.01, 0.0, 1, v3(1.0, 0.8, 0.52),
        MAT_GLOW)
}

// ---- drawing the course ----
course_mat(x: f32, d: f32): f32 {
    if (park) return park_mat(x, d);
    if (absf(x) > COURSE_HALF + 0.6) return MAT_GRASS;
    // Past the run-out, a meadow.
    if (d > terrain_finish + 55.0) return MAT_GRASS;
    k: int = kicker_at(x, d);
    if (k >= 0) {
        // A gap's pit is bare earth.
        if (feature_height(features[k], x, d) < -0.05) return MAT_ROCK;
        // Its shoulders are packed concrete; only under its planks is it
        // dark.
        if (absf(feature_local(features[k], x, d).x - features[k].x) < features[k].w) return MAT_KICKER
    }
    for i in 0..nfeatures {
        if (feature_near(i, d)) {
            f: Feature = features[i];
            if (f.kind == FEATURE_PIPE && pipe_height(f, x, d) > 0.02) return MAT_PIPE;
            // A cliff's edge is rock.
            if (f.kind == FEATURE_CLIFF && d > f.d + 0.1 && d < f.d + f.a + 0.6) return MAT_ROCK
        }
    }
    if (d < 0.0) return MAT_WOOD;
    MAT_CONCRETE
}

// A halfpipe's walls are smooth, paler concrete; rock is concrete's
// shading in a rock's color.
const MAT_PIPE: f32 = 0.02;

const MAT_ROCK: f32 = 0.03;

// Kickers are concrete too, a warmer shade, so they stand out.
const MAT_KICKER: f32 = 0.01;

course_color(mat: f32): V3 {
    if (mat == MAT_GRASS) return grass_color;
    if (mat == MAT_WOOD) return wood_color;
    // Under its planks, a kicker is darker: so that the gaps between them
    // show.
    if (mat == MAT_KICKER) return v_scale(look.kicker, 0.5);
    // (A halfpipe is the run's own concrete: a color of its own would end
    // in the steps of the mesh.)
    if (mat == MAT_PIPE) return look.run;
    if (mat == MAT_ROCK) return v3(0.62, 0.5, 0.42);
    look.run
}

// The ground's height on a lattice, each point worked out when first asked
// for and kept: for the open sky, which looks at many heights round each
// vertex, most of them shared.
const SOFT_STEP: f32 = 0.25;

const SOFT_NX: int = 256;

const SOFT_NZ: int = 3400;

const SOFT_EMPTY: f32 = -1000000.0;

soft_h: []f32 = static_buffer(SOFT_NX * SOFT_NZ, -1000000.0);

soft_x0: f32 = 0.0;

soft_z0: f32 = 0.0;

// Forget the lattice (the ground has changed), and lay it from (x0, z0).
soft_reset(x0: f32, z0: f32) {
    soft_x0 = x0;
    soft_z0 = z0;
    for k in 0..SOFT_NX * SOFT_NZ soft_h[k] = SOFT_EMPTY
}

soft_at(i: int, j: int): f32 {
    k: int = j * SOFT_NX + i;
    h: f32 = soft_h[k];
    if (h <= SOFT_EMPTY) {
        h = course_height(soft_x0 + i as f32 * SOFT_STEP, soft_z0 + j as f32 * SOFT_STEP);
        soft_h[k] = h
    }
    h
}

// The ground's height at (x, z), between the lattice's points (or, off the
// lattice, itself).
soft_height(x: f32, z: f32): f32 {
    u: f32 = (x - soft_x0) / SOFT_STEP;
    v: f32 = (z - soft_z0) / SOFT_STEP;
    if (u < 0.0 || v < 0.0 || u >= (SOFT_NX - 1) as f32 || v >= (SOFT_NZ - 1) as f32) return course_height(x,
        z);
    i: int = u as int;
    j: int = v as int;
    fu: f32 = u - i as f32;
    fv: f32 = v - j as f32;
    lerpf(lerpf(soft_at(i, j), soft_at(i + 1, j), fu), lerpf(soft_at(i, j + 1), soft_at(i + 1,
        j + 1), fu), fv)
}

// The eight ways it looks for higher ground (round the compass).
ao_dx: []f32 = [1.0, 0.70710677, 0.0, -0.70710677, -1.0, -0.70710677, 0.0, 0.70710677];

ao_dz: []f32 = [0.0, 0.70710677, 1.0, 0.70710677, 0.0, -0.70710677, -1.0, -0.70710677];

// How open the sky is over the ground at (x, z): less at the foot of a
// bank or a kicker, where higher ground nearby hides some of it. Far out on
// the hills, it is all open.
course_ao(x: f32, z: f32): f32 {
    if (!park && absf(x) > COURSE_HALF + 9.0) return 1.0;
    if (park && park_out(x, z) > bowl_top() + PARK_DECK + 4.0) return 1.0;
    // (Heights from the lattice: it looks at two dozen for each vertex.)
    h: f32 = soft_height(x, z);
    hidden: f32 = 0.0;
    for k in 0..8 {
        dx: f32 = ao_dx[k];
        dz: f32 = ao_dz[k];
        rise: f32 = 0.0;
        r: f32 = 0.6;
        while (r < 4.0) {
            rise = maxf(rise, (soft_height(x + dx * r, z + dz * r) - h) / r);
            r = r * 2.2
        }
        hidden = hidden + rise / sqrtf(1.0 + rise * rise)
    }
    clampf(1.0 - 0.75 * hidden / 8.0, 0.35, 1.0)
}

// The ground's normal there, its length the open sky (as the shader reads
// it).
course_normal_ao(x: f32, z: f32): V3 {
    v_scale(course_normal(x, z), course_ao(x, z))
}

course_vertex(x: f32, d: f32): V3 {
    v3(x, course_height(x, -d), -d)
}

// One quad of ground, its material from its middle.
put_ground_quad(
    m: *Mesh,
    x0: f32,
    x1: f32,
    d0: f32,
    d1: f32
) {
    mat: f32 = course_mat((x0 + x1) * 0.5, (d0 + d1) * 0.5);
    c: V3 = course_color(mat);
    a: V3 = course_vertex(x0, d0);
    b: V3 = course_vertex(x1, d0);
    e: V3 = course_vertex(x1, d1);
    f: V3 = course_vertex(x0, d1);
    put_quad_n(m, a, b, e, f, course_normal_ao(a.x, a.z), course_normal_ao(b.x, b.z),
        course_normal_ao(e.x, e.z), course_normal_ao(f.x, f.z), c, mat)
}

// A row of ground quads from d to nd. Each vertex is worked out once: a
// row's far edge is kept, for the next row's near one (when it has the
// same columns).
const MAX_COLS: int = 800;

row_x: []f32 = static_buffer(MAX_COLS, 0.0);

row_near: []V3 = static_buffer(MAX_COLS, V3 { x: 0.0, y: 0.0, z: 0.0 });

row_near_n: []V3 = static_buffer(MAX_COLS, V3 { x: 0.0, y: 0.0, z: 0.0 });

row_far: []V3 = static_buffer(MAX_COLS, V3 { x: 0.0, y: 0.0, z: 0.0 });

row_far_n: []V3 = static_buffer(MAX_COLS, V3 { x: 0.0, y: 0.0, z: 0.0 });

// The far edge kept: where it is, and which columns it has.
row_kept_d: f32 = -1000000.0;

row_kept_fine: bool = false;

row_kept_lod: bool = false;

put_ground_row(
    m: *Mesh,
    d: f32,
    nd: f32,
    fine: bool
) {
    n: int = 0;
    x: f32 = -COURSE_SIDE;
    while (x < COURSE_SIDE && n < MAX_COLS - 1) {
        row_x[n] = x;
        n = n + 1;
        x = x + col_step(x + 0.01, fine)
    }
    row_x[n] = x;
    n = n + 1;
    kept: bool = row_kept_d == d && row_kept_fine == fine && row_kept_lod == far_lod;
    for i in 0..n {
        if (kept) {
            row_near[i] = row_far[i];
            row_near_n[i] = row_far_n[i]
        } else {
            row_near[i] = course_vertex(row_x[i], d);
            row_near_n[i] = course_normal_ao(row_x[i], -d)
        }
        row_far[i] = course_vertex(row_x[i], nd);
        row_far_n[i] = course_normal_ao(row_x[i], -nd)
    }
    row_kept_d = nd;
    row_kept_fine = fine;
    row_kept_lod = far_lod;
    for i in 0..n - 1 {
        mat: f32 = course_mat((row_x[i] + row_x[i + 1]) * 0.5, (d + nd) * 0.5);
        put_quad_n(m, row_near[i], row_near[i + 1], row_far[i + 1], row_far[i], row_near_n[i],
            row_near_n[i + 1], row_far_n[i + 1], row_far_n[i], course_color(mat),
            mat)
    }
}

// Rows of the ground mesh: finer over features, coarse where the hill is
// plain, and coarser past either end.
fine_row(d: f32): bool {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (d > f.d - 1.0 && d < f.d + feature_len(f) + 1.0) return true
    }
    d > -1.0 && d < 22.0
}

row_step(d: f32): f32 {
    if (d > COURSE_END + 10.0 || d < COURSE_START - 10.0) return 4.0;
    if (fine_row(d)) return 0.5;
    1.0
}

// The next row after d: a row falls on each kicker's lip and the foot of
// its drop, so they stay crisp.
next_row(d: f32): f32 {
    if (far_lod) return d + maxf(2.0, row_step(d));
    nd: f32 = d + row_step(d);
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_KICKER) {
            lip: f32 = f.d + f.a;
            if (d < lip - 0.01 && nd > lip + 0.01) nd = lip;
            if (d < lip + LIP_GAP - 0.01 && nd > lip + LIP_GAP + 0.01) nd = lip + LIP_GAP
        }
    }
    nd
}

// Columns: across the plain hill, coarse; finer where it bends into the
// banks, or in a row with features; coarse again far out.
col_step(x: f32, fine: bool): f32 {
    e: f32 = absf(x);
    if (far_lod) {
        if (e < 40.0) return 2.0;
        return 12.0
    }
    if (e < COURSE_HALF - 1.0) {
        if (fine) return 0.5;
        return 1.0
    }
    if (e < COURSE_HALF + 7.0) return 0.5;
    if (e < 40.0) return 4.0;
    12.0
}

const COURSE_SIDE: f32 = 160.0;

// The mesh is built in chunks along the run, each with the ground and
// everything standing on it, so that drawing can skip what is far away.
const CHUNK_LEN: f32 = 20.0;

const CHUNK_FROM: f32 = -72.0;

const MAX_CHUNKS: int = 40;

chunk_first: []int = static_buffer(MAX_CHUNKS, 0);

chunk_count: []int = static_buffer(MAX_CHUNKS, 0);

nchunks: int = 0;

chunk_lo: f32 = 0.0;

chunk_hi: f32 = 0.0;

in_chunk(d: f32): bool {
    d >= chunk_lo && d < chunk_hi
}

// Each chunk is built twice: in full, for near him, and coarsely, for
// far down the run, where small things would be specks: coarser ground,
// simpler trees, no flowers. The full chunks come first, then the coarse.
far_lod: bool = false;

far_first: []int = static_buffer(MAX_CHUNKS, 0);

far_count: []int = static_buffer(MAX_CHUNKS, 0);

// The box each chunk's vertices lie in (x from and to, y, z), fine and
// coarse: a chunk whose box is out of the picture is not drawn (see
// draw_world, in render.l8). One with nothing in it has x from above x to.
chunk_box: []f32 = static_buffer(MAX_CHUNKS * 6, 0.0);

far_box: []f32 = static_buffer(MAX_CHUNKS * 6, 0.0);

mesh_box(
    m: *Mesh,
    first: int,
    count: int,
    boxes: []f32,
    k: int
) {
    for a in 0..3 {
        boxes[k * 6 + a * 2] = 1000000.0;
        boxes[k * 6 + a * 2 + 1] = -1000000.0
    }
    for i in first..first + count {
        for a in 0..3 {
            v: f32 = m.data[i * VERTEX_FLOATS + a];
            boxes[k * 6 + a * 2] = minf(boxes[k * 6 + a * 2], v);
            boxes[k * 6 + a * 2 + 1] = maxf(boxes[k * 6 + a * 2 + 1], v)
        }
    }
}

build_course(m: *Mesh) {
    m.n = 0;
    soft_reset(-32.0, -780.0);
    row_kept_d = -1000000.0;
    for pass in 0..2 {
        far_lod = pass == 1;
        nchunks = 0;
        while (nchunks < MAX_CHUNKS) {
            first: int = m.n;
            build_chunk(m);
            if (far_lod) {
                far_first[nchunks] = first;
                far_count[nchunks] = m.n - first;
                mesh_box(m, first, m.n - first, far_box, nchunks)
            } else {
                chunk_first[nchunks] = first;
                chunk_count[nchunks] = m.n - first;
                mesh_box(m, first, m.n - first, chunk_box, nchunks)
            }
            nchunks = nchunks + 1;
            breathe()
        }
    }
    far_lod = false;
    backdrop_first = m.n;
    put_hills(m, 0.0, -150.0, course_base(320.0) - 20.0);
    backdrop_count = m.n - backdrop_first
}

// Hills all round, far off, blue with haze: a ring of them about the
// course's middle, rising from the valley floor.
backdrop_first: int = 0;

backdrop_count: int = 0;

hill_height(a: f32, ring: f32): f32 {
    n: f32 = 0.55 + 0.25 * sinf(a * 3.0 + 1.3) + 0.15 * sinf(a * 7.0 + 0.4) + 0.08 * sinf(a * 17.0 + 2.1);
    ring * ring * (3.0 - 2.0 * ring) * n * 260.0
}

put_hills(
    m: *Mesh,
    cx: f32,
    cz: f32,
    y0: f32
) {
    steps: int = 120;
    rings: int = 5;
    for i in 0..steps {
        a0: f32 = TAU * i as f32 / steps as f32;
        a1: f32 = TAU * (i + 1) as f32 / steps as f32;
        for j in 0..rings {
            r0: f32 = j as f32 / rings as f32;
            r1: f32 = (j + 1) as f32 / rings as f32;
            p00: V3 = hill_point(cx, cz, y0, a0, r0);
            p10: V3 = hill_point(cx, cz, y0, a1, r0);
            p11: V3 = hill_point(cx, cz, y0, a1, r1);
            p01: V3 = hill_point(cx, cz, y0, a0, r1);
            n: V3 = v_norm(v_cross(v_sub(p01, p00), v_sub(p10, p00)));
            if (n.y < 0.0) n = v_scale(n, -1.0);
            // Forest below, paler grass up top.
            k: f32 = clampf((p00.y - y0) / 180.0, 0.0, 1.0);
            col: V3 = v_lerp(look.hill_low, look.hill_high, k);
            put_quad(m, p00, p10, p11, p01, n, col, MAT_GRASS)
        }
    }
}

hill_point(
    cx: f32,
    cz: f32,
    y0: f32,
    a: f32,
    ring: f32
): V3 {
    r: f32 = 620.0 + ring * 900.0;
    v3(cx + cosf(a) * r, y0 + hill_height(a, ring), cz + sinf(a) * r)
}

build_chunk(m: *Mesh) {
    chunk_lo = CHUNK_FROM + nchunks as f32 * CHUNK_LEN;
    chunk_hi = chunk_lo + CHUNK_LEN;
    d: f32 = chunk_lo;
    while (d < chunk_hi) {
        nd: f32 = minf(next_row(d), chunk_hi);
        fine: bool = fine_row(d) || fine_row(nd);
        put_ground_row(m, d, nd, fine);
        d = nd
    }
    put_lip_stripes(m);
    if (!far_lod) put_edges(m);
    put_copings(m);
    for i in 0..ncrails {
        if (in_chunk(-crails[i].a.z)) put_course_rail(m, crails[i])
    }
    // (The finish's gate is not of the mesh: see PART_GATE, in mesh.l8.)
    put_start(m);
    put_course_scenery(m)
}

chunk_index(d: f32): int {
    clampi(((d - CHUNK_FROM) / CHUNK_LEN) as int, 0, nchunks - 1)
}

// The coarse chunks from d0 to d1: the first vertex and how many.
far_span(
    d0: f32,
    d1: f32,
    first: *int,
    count: *int
) {
    a: int = chunk_index(d0);
    b: int = chunk_index(d1);
    first.* = far_first[a];
    count.* = far_first[b] + far_count[b] - far_first[a]
}

// The part of the mesh from d0 to d1 down the run: its first vertex and
// how many.
course_span(
    d0: f32,
    d1: f32,
    first: *int,
    count: *int
) {
    a: int = clampi(((d0 - CHUNK_FROM) / CHUNK_LEN) as int, 0, nchunks - 1);
    b: int = clampi(((d1 - CHUNK_FROM) / CHUNK_LEN) as int, 0, nchunks - 1);
    first.* = chunk_first[a];
    count.* = chunk_first[b] + chunk_count[b] - chunk_first[a]
}

clampi(x: int, lo: int, hi: int): int {
    if (x < lo) return lo;
    if (x > hi) return hi;
    x
}

// Steel coping along the tops of each halfpipe's walls.
put_copings(m: *Mesh) {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_PIPE) {
            for side in 0..2 {
                sx: f32 = 1.0;
                if (side == 0) sx = -1.0;
                x: f32 = sx * (pipe_top() + 0.06);
                d: f32 = f.d + 7.0;
                while (d < f.d + f.a - 7.0) {
                    nd: f32 = minf(d + 2.0, f.d + f.a - 7.0);
                    if (in_chunk(d)) put_tube(m, v3(x, course_height(x, -d) + 0.02,
                        -d), v3(x, course_height(x, -nd) + 0.02, -nd), 0.06, steel,
                        MAT_METAL);
                    d = nd
                }
            }
        }
    }
}

// Each kicker (and gap) is decked in planks, laid across it up its ramp and
// over its table and landing, with a steel coping along its lip, and a
// little flag either side.
put_lip_stripes(m: *Mesh) {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if ((f.kind == FEATURE_KICKER || f.kind == FEATURE_GAP) && in_chunk(f.d + f.a)) {
            if (!far_lod) put_deck(m, f);
            lip: f32 = f.d + f.a;
            lift: V3 = v3(0.0, 0.025, 0.0);
            put_tube(m, v_add(feature_world(f, f.x - f.w, lip), lift), v_add(feature_world(f,
                f.x + f.w, lip), lift), 0.035, steel, MAT_METAL);
            fl: V3 = feature_world(f, f.x - f.w - 1.9, lip);
            fr: V3 = feature_world(f, f.x + f.w + 1.9, lip);
            put_flag(m, fl.x, -fl.z, v3(0.95, 0.3, 0.25));
            put_flag(m, fr.x, -fr.z, v3(0.25, 0.5, 0.95))
        }
    }
}

// How far apart planks are laid, and the gap between them.
const PLANK_STEP: f32 = 0.26;

const PLANK_GAP: f32 = 0.03;

// f's planks: wherever it stands up off the hill.
put_deck(m: *Mesh, f: Feature) {
    len: f32 = feature_len(f);
    s: f32 = 0.0;
    k: int = 0;
    while (s + PLANK_STEP <= len) {
        d0: f32 = f.d + s;
        d1: f32 = d0 + PLANK_STEP - PLANK_GAP;
        h0: f32 = feature_profile(f, s);
        h1: f32 = feature_profile(f, s + PLANK_STEP - PLANK_GAP);
        if (h0 > 0.03 && h1 > 0.03) {
            p0: V3 = feature_world(f, f.x, d0);
            p1: V3 = feature_world(f, f.x, d1);
            fwd: V3 = v_norm(v_sub(p1, p0));
            right: V3 = feature_right(f);
            up: V3 = v_cross(right, fwd);
            c: V3 = v_madd(v_scale(v_add(p0, p1), 0.5), up, 0.006);
            shade: f32 = 0.86 + 0.26 * cell_jitter(k, i_of(f));
            put_block(m, c, right, up, fwd, v3(f.w * 0.98, 0.012, (d1 - d0) * 0.5),
                0.008, v_scale(look.kicker, shade), MAT_DECK);
            // Under it, a dark joist across the whole step: the gaps show
            // it, and the deck's shadow is solid.
            put_block(m, v_madd(c, up, -0.012), right, up, fwd, v3(f.w * 0.97, 0.008,
                PLANK_STEP * 0.5 + 0.01), 0.0, v_scale(look.kicker, 0.35), MAT_PAINT)
        }
        s = s + PLANK_STEP;
        k = k + 1
    }
}

i_of(f: Feature): int {
    (f.d * 10.0) as int
}

// ---- edges ----
// Stone curbs along both edges of the run, block by block, and a low
// wooden fence up each bank.
const CURB_LEN: f32 = 0.6;

const FENCE_OUT: f32 = 3.2;

const FENCE_STEP: f32 = 2.4;

put_edges(m: *Mesh) {
    for side in 0..2 {
        sg: f32 = 1.0 - 2.0 * side as f32;
        d: f32 = 0.0;
        k: int = 0;
        while (d < COURSE_END) {
            if (in_chunk(d)) put_curb(m, sg * (COURSE_HALF + 0.08), d, k * 2 + side);
            d = d + CURB_LEN + 0.04;
            k = k + 1
        }
        d = -6.0;
        k = 0;
        while (d < COURSE_END) {
            if (in_chunk(d)) put_fence(m, sg * (COURSE_HALF + FENCE_OUT), d, k * 2 + side);
            d = d + FENCE_STEP;
            k = k + 1
        }
    }
}

// A curb stone from d on, at x: if the ground there is not too steep (a
// cliff's face) for one.
put_curb(
    m: *Mesh,
    x: f32,
    d: f32,
    k: int
) {
    y0: f32 = course_height(x, -d);
    y1: f32 = course_height(x, -(d + CURB_LEN));
    if (absf(y1 - y0) > 0.6) return;
    fwd: V3 = v_norm(v3(0.0, y1 - y0, -CURB_LEN));
    right: V3 = v3(1.0, 0.0, 0.0);
    up: V3 = v_cross(right, fwd);
    shade: f32 = 0.82 + 0.3 * cell_jitter(k, 11);
    c: V3 = v_madd(v3(x, (y0 + y1) * 0.5, -(d + CURB_LEN * 0.5)), up, 0.04);
    put_block(m, c, right, up, fwd, v3(0.17, 0.08, CURB_LEN * 0.5), 0.03, v3(0.62 * shade,
        0.58 * shade, 0.52 * shade), MAT_PAINT)
}

// A fence post at (x, d), and its two rails on to the next.
put_fence(
    m: *Mesh,
    x: f32,
    d: f32,
    k: int
) {
    put_fence_to(m, x, -d, x, -(d + FENCE_STEP), k)
}

// A fence post at (x, z), and its two rails on to (nx, nz).
put_fence_to(
    m: *Mesh,
    x: f32,
    z: f32,
    nx: f32,
    nz: f32,
    k: int
) {
    wood: V3 = v_scale(v3(0.56, 0.39, 0.25), 0.85 + 0.25 * cell_jitter(k, 5));
    y: f32 = course_height(x, z);
    put_block(m, v3(x, y + 0.27, z), v3(1.0, 0.0, 0.0), v3(0.0, 1.0, 0.0), v3(0.0,
        0.0, 1.0), v3(0.055, 0.33, 0.055), 0.015, wood, MAT_PAINT);
    ny: f32 = course_height(nx, nz);
    if (absf(ny - y) > 1.2) return;
    a: V3 = v3(x, y, z);
    b: V3 = v3(nx, ny, nz);
    fwd: V3 = v_norm(v_sub(b, a));
    right: V3 = v_norm(v_cross(fwd, v3(0.0, 1.0, 0.0)));
    up: V3 = v_cross(right, fwd);
    half: f32 = v_len(v_sub(b, a)) * 0.5;
    for r in 0..2 {
        lift: f32 = 0.24 + 0.27 * r as f32;
        put_block(m, v_add(v_scale(v_add(a, b), 0.5), v3(0.0, lift, 0.0)), right,
            up, fwd, v3(0.025, 0.035, half), 0.01, v_scale(wood, 0.95), MAT_PAINT)
    }
}

// Between the curb and the fence on each side, every few metres: a bush,
// a bench, a few stones, or a hay bale.
put_edge_props(m: *Mesh) {
    for side in 0..2 {
        sg: f32 = 1.0 - 2.0 * side as f32;
        d: f32 = COURSE_START + 4.0;
        k: int = 0;
        while (d < terrain_finish + 40.0) {
            meadow_rng = k * 4231 + side * 977 + 29;
            x: f32 = sg * (COURSE_HALF + 0.9 + meadow_rand() * 0.8);
            step: f32 = 4.0 + meadow_rand() * 5.0;
            if (in_chunk(d) && prop_room(x, d)) {
                pick: f32 = meadow_rand();
                if (pick < 0.45) put_bush(m, x, d) else if (pick < 0.65) put_bench(m,
                    x, d) else if (pick < 0.85) put_stones(m, x, d) else put_bale(m,
                    x, d)
            }
            d = d + step;
            k = k + 1
        }
    }
}

// Whether the bank at (x, d) is gentle enough for a prop.
prop_room(x: f32, d: f32): bool {
    y0: f32 = course_height(x, -(d - 0.8));
    y1: f32 = course_height(x, -(d + 0.8));
    yi: f32 = course_height(x - 0.6, -d);
    yo: f32 = course_height(x + 0.6, -d);
    absf(y1 - y0) < 0.5 && absf(yo - yi) < 1.2
}

put_bush(m: *Mesh, x: f32, d: f32) {
    leaf: V3 = v_scale(look.leaf, 1.05 + 0.3 * meadow_rand());
    n: int = 2 + (meadow_rand() * 2.0) as int;
    for _i in 0..n {
        bx: f32 = x + (meadow_rand() - 0.5) * 0.9;
        bd: f32 = d + (meadow_rand() - 0.5) * 1.2;
        r: f32 = 0.35 + 0.25 * meadow_rand();
        put_clump(m, v3(bx, course_height(bx, -bd) + r * 0.6, -bd), v3(r, r * 0.8,
            r), leaf, 24)
    }
}

// A bench facing the run: a seat and a back of planks on two stone feet.
put_bench(m: *Mesh, x: f32, d: f32) {
    sg: f32 = 1.0;
    if (x < 0.0) sg = -1.0;
    put_bench_facing(m, x, -d, v3(sg, 0.0, 0.0))
}

// A bench at (x, z), its back toward out.
put_bench_facing(
    m: *Mesh,
    x: f32,
    z: f32,
    out: V3
) {
    // Level with the ground at its front; its feet go down into it.
    y: f32 = course_height(x - out.x * 0.2, z - out.z * 0.2);
    c: V3 = v3(x, y, z);
    up: V3 = v3(0.0, 1.0, 0.0);
    along: V3 = v_cross(out, up);
    stone: V3 = v3(0.6, 0.57, 0.52);
    for e in 0..2 put_block(m, v_add(v_madd(c, along, (2.0 * e as f32 - 1.0) * 0.6),
        v3(0.0, 0.06, 0.0)), out, up, along, v3(0.2, 0.35, 0.06), 0.02, stone, MAT_PAINT);
    wood: V3 = v3(0.6, 0.4, 0.25);
    for p in 0..3 {
        shade: f32 = 0.85 + 0.25 * meadow_rand();
        put_block(m, v_add(v_madd(c, out, (p as f32 - 1.0) * 0.13), v3(0.0, 0.43,
            0.0)), out, up, along, v3(0.055, 0.022, 0.8), 0.01, v_scale(wood, shade),
            MAT_PAINT)
    }
    for p in 0..2 put_block(m, v_add(v_madd(c, out, 0.21), v3(0.0, 0.6 + p as f32 * 0.14,
        0.0)), out, up, along, v3(0.022, 0.05, 0.8), 0.01, v_scale(wood, 0.9), MAT_PAINT);
    put_block(m, v_add(v_madd(c, out, 0.21), v3(0.0, 0.5, 0.0)), out, up, along, v3(0.03,
        0.12, 0.05), 0.01, stone, MAT_PAINT)
}

// A few rounded stones, half sunk.
put_stones(m: *Mesh, x: f32, d: f32) {
    n: int = 2 + (meadow_rand() * 3.0) as int;
    for _i in 0..n {
        sx: f32 = x + (meadow_rand() - 0.5) * 1.0;
        sd: f32 = d + (meadow_rand() - 0.5) * 1.0;
        r: f32 = 0.12 + 0.2 * meadow_rand();
        a: f32 = meadow_rand() * TAU;
        right: V3 = v3(cosf(a), 0.0, sinf(a));
        fwd: V3 = v3(-sinf(a), 0.0, cosf(a));
        shade: f32 = 0.75 + 0.3 * meadow_rand();
        put_block(m, v3(sx, course_height(sx, -sd) + r * 0.3, -sd), right, v3(0.0,
            1.0, 0.0), fwd, v3(r, r * 0.65, r * 0.8), r * 0.5, v3(0.6 * shade, 0.58 * shade,
            0.55 * shade), MAT_PAINT)
    }
}

// A hay bale, its straw bound in two bands.
put_bale(m: *Mesh, x: f32, d: f32) {
    y: f32 = course_height(x, -d);
    a: f32 = (meadow_rand() - 0.5) * 0.6;
    right: V3 = v3(cosf(a), 0.0, sinf(a));
    fwd: V3 = v3(-sinf(a), 0.0, cosf(a));
    up: V3 = v3(0.0, 1.0, 0.0);
    straw: V3 = v_scale(v3(0.86, 0.72, 0.42), 0.9 + 0.15 * meadow_rand());
    c: V3 = v3(x, y + 0.2, -d);
    put_block(m, c, right, up, fwd, v3(0.35, 0.25, 0.55), 0.07, straw, MAT_PAINT);
    for b in 0..2 put_block(m, v_madd(c, fwd, (2.0 * b as f32 - 1.0) * 0.25), right,
        up, fwd, v3(0.36, 0.26, 0.02), 0.01, v_scale(straw, 0.7), MAT_PAINT)
}

put_flag(
    m: *Mesh,
    x: f32,
    d: f32,
    col: V3
) {
    y: f32 = course_height(x, -d);
    top: V3 = v3(x, y + 1.6, -d);
    put_tube(m, v3(x, y - 0.1, -d), top, 0.03, v3(0.9, 0.9, 0.88), MAT_PAINT);
    n: V3 = v3(1.0, 0.0, 0.0);
    a: V3 = v3(x, y + 1.6, -d);
    b: V3 = v3(x, y + 1.15, -d);
    c: V3 = v3(x, y + 1.4, -d + 0.55);
    put(m, a, n, col, MAT_PAINT);
    put(m, b, n, col, MAT_PAINT);
    put(m, c, n, col, MAT_PAINT)
}

rail_frame(r: CRail): V3 {
    v_norm(v_sub(r.b, r.a))
}

// Rails are painted teal and boxes coral, so that they stand out from the
// pale run.
rail_paint: V3 = V3 { x: 0.16, y: 0.56, z: 0.58 };

box_paint: V3 = V3 { x: 0.92, y: 0.45, z: 0.36 };

put_course_rail(m: *Mesh, r: CRail) {
    u: V3 = rail_frame(r);
    len: f32 = v_len(v_sub(r.b, r.a));
    side: V3 = v_norm(v_cross(u, v3(0.0, 1.0, 0.0)));
    up: V3 = v_cross(side, u);
    if (r.box) {
        put_box_boards(m, r, side, up, u, len);
        return
    }
    put_tube(m, r.a, r.b, 0.05, rail_paint, MAT_PAINT);
    // Square posts down to the ground, about every metre and a half, each
    // bolted to a plate.
    k: int = (len / 1.5) as int + 1;
    flat: V3 = v_norm(v3(side.z, 0.0, -side.x));
    for i in 0..k + 1 {
        p: V3 = v_lerp(r.a, r.b, (i as f32 + 0.15) / (k as f32 + 0.3));
        g: f32 = course_height(p.x, p.z);
        h: f32 = (p.y - 0.04 - g) * 0.5 + 0.05;
        put_block(m, v3(p.x, g - 0.05 + h, p.z), side, v3(0.0, 1.0, 0.0), flat, v3(0.035,
            h, 0.035), 0.008, v_scale(rail_paint, 0.8), MAT_PAINT);
        put_block(m, v3(p.x, g + 0.005, p.z), side, v3(0.0, 1.0, 0.0), flat, v3(0.11,
            0.012, 0.11), 0.006, steel, MAT_METAL)
    }
}

// A box: painted boards along its sides and across its ends, round a dark
// core, with steel angle along its top edges and a plate between them.
// Deep enough to reach the ground under its low end.
const BOX_DEPTH: f32 = 0.6;

const BOX_BOARD: f32 = 0.15;

put_box_boards(
    m: *Mesh,
    r: CRail,
    side: V3,
    up: V3,
    u: V3,
    len: f32
) {
    mid: V3 = v_scale(v_add(r.a, r.b), 0.5);
    put_block(m, v_madd(mid, up, -BOX_DEPTH * 0.5), side, up, u, v3(0.26, BOX_DEPTH * 0.5,
        len * 0.5 - 0.01), 0.01, v_scale(box_paint, 0.35), MAT_PAINT);
    nb: int = (BOX_DEPTH / BOX_BOARD) as int;
    for b in 0..nb {
        y: f32 = -0.035 - BOX_BOARD * (b as f32 + 0.5);
        for sd in 0..2 {
            sg: f32 = 2.0 * sd as f32 - 1.0;
            shade: f32 = 0.86 + 0.22 * cell_jitter(b * 2 + sd, (len * 10.0) as int);
            c: V3 = v_madd(v_madd(mid, up, y), side, sg * 0.27);
            put_block(m, c, side, up, u, v3(0.018, BOX_BOARD * 0.5 - 0.008, len * 0.5),
                0.008, v_scale(box_paint, shade), MAT_PAINT)
        }
        for e in 0..2 {
            sg: f32 = 2.0 * e as f32 - 1.0;
            c: V3 = v_madd(v_madd(mid, up, y), u, sg * (len * 0.5 + 0.005));
            put_block(m, c, side, up, u, v3(0.29, BOX_BOARD * 0.5 - 0.008, 0.018),
                0.008, v_scale(box_paint, 0.9), MAT_PAINT)
        }
    }
    for sd in 0..2 {
        sg: f32 = 2.0 * sd as f32 - 1.0;
        put_block(m, v_madd(v_madd(mid, up, -0.015), side, sg * 0.275), side, up,
            u, v3(0.03, 0.03, len * 0.5 + 0.02), 0.006, steel, MAT_METAL)
    }
    put_block(m, v_madd(mid, up, -0.004), side, up, u, v3(0.25, 0.012, len * 0.5),
        0.004, v_scale(steel, 0.9), MAT_METAL)
}

// Two posts and a banner across the run.
put_gate(m: *Mesh, d: f32, banner: V3) {
    if (!in_chunk(d)) return;
    w: f32 = COURSE_HALF + 0.8;
    put_gate_shape(m, d, course_height(-w, -d), course_height(w, -d), banner)
}

// A gate across the run at d, its posts standing on ground y0 and y1 high.
put_gate_shape(
    m: *Mesh,
    d: f32,
    y0: f32,
    y1: f32,
    banner: V3
) {
    w: f32 = COURSE_HALF + 0.8;
    post: V3 = v3(0.95, 0.94, 0.9);
    // High enough for the camera to pass under.
    top: f32 = maxf(y0, y1) + 6.5;
    put_tube(m, v3(-w, y0 - 0.2, -d), v3(-w, top, -d), 0.14, post, MAT_PAINT);
    put_tube(m, v3(w, y1 - 0.2, -d), v3(w, top, -d), 0.14, post, MAT_PAINT);
    at(0.0, top - 0.35, -d);
    put_rounded_box(m, xf, v3(w, 0.42, 0.12), 0.1, 0.0, 2, banner, MAT_PAINT);
    // Checks along the banner.
    k: int = 0;
    x: f32 = -w + 0.2;
    while (x < w - 0.6) {
        if (k % 2 == 0) {
            at(x + 0.2, top - 0.35, -d + 0.125);
            put_rounded_box(m, xf, v3(0.2, 0.2, 0.01), 0.01, 0.0, 1, v3(1.0, 0.98,
                0.94), MAT_PAINT)
        }
        x = x + 0.4;
        k = k + 1
    }
}

put_start(m: *Mesh) {
    put_gate(m, 1.0, v3(0.25, 0.55, 0.9))
}

put_course_scenery(m: *Mesh) {
    rng: int = 777;
    placed: int = 0;
    while (placed < 200) {
        rng = (rng * 1103515245 + 12345) % 2147483648;
        side: f32 = 1.0;
        if (rng % 2 == 0) side = -1.0;
        rng = (rng * 1103515245 + 12345) % 2147483648;
        x: f32 = side * (COURSE_HALF + 3.0 + (rng % 10000) as f32 / 10000.0 * 32.0);
        rng = (rng * 1103515245 + 12345) % 2147483648;
        d: f32 = COURSE_START - 25.0 + (rng % 10000) as f32 / 10000.0 * (COURSE_END - COURSE_START + 40.0);
        if (in_chunk(d)) put_tree(m, x, -d, course_height(x, -d), 0.8 + 0.6 * cell_jitter(placed,
            3));
        placed = placed + 1
    }
    // Tufts and flowers on the banks.
    d: f32 = COURSE_START - 20.0;
    k: int = 0;
    while (d < COURSE_END + 10.0) {
        if (in_chunk(d) && !far_lod)
            for s in 0..2 {
                sg: f32 = -1.0;
                if (s == 1) sg = 1.0;
                meadow_rng = k * 7919 + s * 31 + 17;
                for _i in 0..5 {
                    x: f32 = sg * (COURSE_HALF + 0.9 + meadow_rand() * 9.0);
                    z: f32 = -(d + meadow_rand() * 2.0);
                    y: f32 = course_height(x, z);
                    if (meadow_rand() < 0.15) put_flower(m, x, y, z) else put_tuft(m,
                        x, y, z, 0.18 + 0.1 * meadow_rand())
                }
            }
        d = d + 2.0;
        k = k + 1
    }
    if (!far_lod) put_edge_props(m);
    // The street lamps.
    for i in 0..nlamps {
        if (in_chunk(-lamp_z[i])) put_lamp_post(m, lamp_x[i], lamp_z[i])
    }
}
