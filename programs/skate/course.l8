tag skate;

// The slope course: a long concrete run down a grassy hill, with rails,
// rollers, kickers, halfpipes, cliffs, and gaps on the way to a finish
// line, laid out afresh for each course (see layout.l8). Distance down the
// run is d, toward -z; x is across it. The ground is one smooth height
// function: the hill's fall line, banks either side that turn him back in,
// and the features on top.
const COURSE_HALF: f32 = 11.0;

const COURSE_FINISH: f32 = 300.0;

const COURSE_START: f32 = -12.0;

const COURSE_END: f32 = 380.0;

// The hill's height, sampled along d by its grade.
const BASE_STEP: f32 = 0.25;

const BASE_N: int = 1700;

course_base_h: []f32 = new f32[BASE_N](0.0);

course_grade(d: f32): f32 {
    if (d < 0.0) return 0.0;
    if (d < 20.0) return lerpf(0.0, 0.48, smoothstepf(0.0, 4.0, d)) - 0.24 * smoothstepf(10.0,
        20.0, d);
    if (d < COURSE_FINISH) return 0.24;
    if (d < COURSE_FINISH + 35.0) return 0.24 * (1.0 - smoothstepf(COURSE_FINISH,
        COURSE_FINISH + 35.0, d));
    -0.12 * smoothstepf(COURSE_FINISH + 45.0, COURSE_FINISH + 80.0, d)
}

base_index(d: f32): f32 {
    clampf((d - COURSE_START + 20.0) / BASE_STEP, 0.0, (BASE_N - 2) as f32)
}

// The hill, by its grade, and the cliffs down it, which drop all that
// follows.
load_base() {
    h: f32 = 0.0;
    course_base_h[0] = 0.0;
    for i in 1..BASE_N {
        d: f32 = COURSE_START - 20.0 + (i as f32 - 0.5) * BASE_STEP;
        h = h - course_grade(d) * BASE_STEP;
        course_base_h[i] = h - cliffs_below(COURSE_START - 20.0 + i as f32 * BASE_STEP)
    }
}

// How far the cliffs above d have dropped the hill there.
cliffs_below(d: f32): f32 {
    drop: f32 = 0.0;
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_CLIFF) drop = drop + cliff_drop(f, d - f.d)
    }
    drop
}

// A cliff: a face a long falling most of its height h, then a landing c
// long the rest of the way.
cliff_drop(f: Feature, s: f32): f32 {
    if (s <= 0.0) return 0.0;
    if (s < f.a) return 0.75 * f.h * smoothstepf(0.0, f.a, s);
    0.75 * f.h + 0.25 * f.h * smoothstepf(0.0, f.c, s - f.a)
}

course_base(d: f32): f32 {
    f: f32 = base_index(d);
    i: int = f as int;
    lerpf(course_base_h[i], course_base_h[i + 1], f - i as f32)
}

// The banks: the ground rises past the run's edge.
course_bank(x: f32): f32 {
    e: f32 = absf(x) - COURSE_HALF;
    if (e <= 0.0) return 0.0;
    3.2 * smoothstepf(0.0, 5.0, e) + 0.12 * e
}

// ---- features ----
// A kicker: up a ramp of length a to its lip at height h, a table b long a
// little below the lip, and a landing c long back down to the hill, w wide
// (half) before its sides fall away. Rollers: n waves of height h, a apart,
// across the run.
//
// A halfpipe: a stretch a long where the run's sides curve up into walls,
// with a deck along their tops. A cliff: the run drops h (see cliff_drop).
// A gap: a kicker whose table is a pit b long, the landing on its far side.
const FEATURE_KICKER: int = 0;

const FEATURE_ROLLERS: int = 1;

const FEATURE_PIPE: int = 2;

const FEATURE_CLIFF: int = 3;

const FEATURE_GAP: int = 4;

// The halfpipe's flat bottom (half its width), and the radius of its
// walls' curve, which rises to PIPE_STEEP of the way to vertical.
const PIPE_FLAT: f32 = 3.8;

const PIPE_R: f32 = 4.4;

const PIPE_STEEP: f32 = 0.95;

// How deep a gap's pit is below the hill, and its far face, from the pit
// up to the landing.
const GAP_DEPTH: f32 = 1.0;

const GAP_FACE: f32 = 2.0;

type Feature = {
    kind: int;
    x: f32;
    d: f32;
    w: f32;
    h: f32;
    a: f32;
    b: f32;
    c: f32
}

const MAX_FEATURES: int = 48;

features: []Feature = new Feature[MAX_FEATURES](Feature {
    kind: 0,
    x: 0.0,
    d: 0.0,
    w: 0.0,
    h: 0.0,
    a: 0.0,
    b: 0.0,
    c: 0.0
});

nfeatures: int = 0;

// The step down from a kicker's lip to its table.
const LIP_DROP: f32 = 0.35;

const LIP_GAP: f32 = 0.5;

add_feature(
    kind: int,
    x: f32,
    d: f32,
    w: f32,
    h: f32,
    a: f32,
    b: f32,
    c: f32
) {
    features[nfeatures] = Feature {
        kind: kind,
        x: x,
        d: d,
        w: w,
        h: h,
        a: a,
        b: b,
        c: c
    };
    nfeatures = nfeatures + 1
}

// A kicker sized by its height: the bigger, the longer its table and
// landing.
add_kicker(
    x: f32,
    d: f32,
    w: f32,
    h: f32
) {
    add_feature(FEATURE_KICKER, x, d, w, h, 2.2 + h * 1.2, 0.5 + h * 1.2, 6.0 + h * 4.0)
}

feature_len(f: Feature): f32 {
    if (f.kind == FEATURE_ROLLERS) return f.a * f.b;
    if (f.kind == FEATURE_PIPE) return f.a;
    if (f.kind == FEATURE_CLIFF) return f.a + f.c;
    if (f.kind == FEATURE_GAP) return f.a + LIP_GAP + f.b + GAP_FACE + f.c;
    f.a + LIP_GAP + f.b + f.c
}

// Where a kicker's, gap's, or cliff's landing begins, along it.
landing_start(f: Feature): f32 {
    if (f.kind == FEATURE_GAP) return f.a + LIP_GAP + f.b + GAP_FACE;
    if (f.kind == FEATURE_CLIFF) return f.a;
    f.a + LIP_GAP + f.b
}

// The halfpipe's walls at x, at full height.
pipe_wall(x: f32): f32 {
    u: f32 = clampf(absf(x) - PIPE_FLAT, 0.0, PIPE_R * PIPE_STEEP);
    PIPE_R - sqrtf(PIPE_R * PIPE_R - u * u)
}

// Where the halfpipe's walls end and its deck begins.
pipe_top(): f32 {
    PIPE_FLAT + PIPE_R * PIPE_STEEP
}

pipe_height(f: Feature, x: f32, d: f32): f32 {
    s: f32 = d - f.d;
    if (s <= 0.0 || s >= f.a) return 0.0;
    // Its walls grow from nothing where it begins and sink where it ends.
    e: f32 = smoothstepf(0.0, 7.0, s) * (1.0 - smoothstepf(f.a - 7.0, f.a, s));
    pipe_wall(x) * e
}

// Whether (x, d) is up a halfpipe's wall (or on its deck), and which.
pipe_at(x: f32, d: f32): int {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_PIPE && d > f.d + 5.0 && d < f.d + f.a - 5.0 && absf(x) > PIPE_FLAT + 0.5) return i
    }
    -1
}

// Height of f above the hill at s along it, before its sides fall away.
feature_profile(f: Feature, s: f32): f32 {
    if (s <= 0.0 || s >= feature_len(f)) return 0.0;
    if (f.kind == FEATURE_ROLLERS) return f.h * (0.5 - 0.5 * cosf(TAU * s / f.a));
    if (f.kind == FEATURE_GAP) return gap_profile(f, s);
    if (s < f.a) {
        u: f32 = s / f.a;
        return f.h * u * u
    }
    s = s - f.a;
    top: f32 = f.h - LIP_DROP;
    if (s < LIP_GAP) return f.h - LIP_DROP * smoothstepf(0.0, LIP_GAP, s);
    s = s - LIP_GAP;
    if (s < f.b) return top;
    s = s - f.b;
    top * (0.5 + 0.5 * cosf(PI * s / f.c))
}

// A gap: up its ramp, over the lip into the pit, up the far face to the
// landing, and down it.
gap_profile(f: Feature, s: f32): f32 {
    if (s < f.a) {
        u: f32 = s / f.a;
        return f.h * u * u
    }
    s = s - f.a;
    if (s < LIP_GAP) return lerpf(f.h, -GAP_DEPTH, smoothstepf(0.0, LIP_GAP, s));
    s = s - LIP_GAP;
    if (s < f.b) return -GAP_DEPTH;
    s = s - f.b;
    top: f32 = f.h - LIP_DROP;
    if (s < GAP_FACE) return lerpf(-GAP_DEPTH, top, smoothstepf(0.0, GAP_FACE, s));
    s = s - GAP_FACE;
    top * (0.5 + 0.5 * cosf(PI * s / f.c))
}

feature_across(f: Feature, x: f32): f32 {
    1.0 - smoothstepf(f.w, f.w + 1.6, absf(x - f.x))
}

feature_height(f: Feature, x: f32, d: f32): f32 {
    if (f.kind == FEATURE_PIPE) return pipe_height(f, x, d);
    // A cliff is part of the hill (see load_base).
    if (f.kind == FEATURE_CLIFF) return 0.0;
    s: f32 = d - f.d;
    if (s <= 0.0 || s >= feature_len(f)) return 0.0;
    a: f32 = feature_across(f, x);
    if (a <= 0.0) return 0.0;
    feature_profile(f, s) * a
}

// Everything on top of the hill and banks at (x, d).
features_at(x: f32, d: f32): f32 {
    h: f32 = 0.0;
    for i in 0..nfeatures h = h + feature_height(features[i], x, d);
    h
}

// Which kicker (or gap) (x, d) is on, or -1.
kicker_at(x: f32, d: f32): int {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_KICKER || f.kind == FEATURE_GAP) {
            if (absf(feature_height(f, x, d)) > 0.02) return i
        }
    }
    -1
}

// What he flies off at (x, d): a kicker or gap, a halfpipe's wall, a
// cliff's edge; or -1, the plain hill.
takeoff_feature(x: f32, d: f32): int {
    k: int = kicker_at(x, d);
    if (k >= 0) return k;
    p: int = pipe_at(x, d);
    if (p >= 0) return p;
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_CLIFF && d > f.d - 2.0 && d < f.d + f.a + 1.0) return i
    }
    -1
}

course_height(x: f32, z: f32): f32 {
    d: f32 = -z;
    course_base(d) + course_bank(x) + features_at(x, d)
}

course_normal(x: f32, z: f32): V3 {
    e: f32 = 0.05;
    hx: f32 = (course_height(x + e, z) - course_height(x - e, z)) / (2.0 * e);
    hz: f32 = (course_height(x, z + e) - course_height(x, z - e)) / (2.0 * e);
    v_norm(v3(-hx, 1.0, -hz))
}

// ---- rails ----
// A rail is a straight bar from one point to another, a box a wider one;
// a rail may carry on into the next (a kink).
type CRail = {
    a: V3;
    b: V3;
    box: bool;
    next: int
}

const MAX_RAILS: int = 32;

crails: []CRail = new CRail[MAX_RAILS](CRail {
    a: V3 { x: 0.0, y: 0.0, z: 0.0 },
    b: V3 { x: 0.0, y: 0.0, z: 0.0 },
    box: false,
    next: -1
});

ncrails: int = 0;

// A rail from d0 to d1 at x, starting h0 above the hill and ending h1
// above it.
add_rail(
    x: f32,
    d0: f32,
    d1: f32,
    h0: f32,
    h1: f32,
    box: bool
): int {
    crails[ncrails] = CRail {
        a: v3(x, course_base(d0) + h0, -d0),
        b: v3(x, course_base(d1) + h1, -d1),
        box: box,
        next: -1
    };
    ncrails = ncrails + 1;
    ncrails - 1
}

// A flat-down rail: level from d0 to dk, then down along the hill to d1.
add_kink(
    x: f32,
    d0: f32,
    dk: f32,
    d1: f32,
    h0: f32
) {
    y: f32 = course_base(d0) + h0;
    first: int = ncrails;
    crails[ncrails] = CRail {
        a: v3(x, y, -d0),
        b: v3(x, y, -dk),
        box: false,
        next: first + 1
    };
    ncrails = ncrails + 1;
    hk: f32 = y - course_base(dk);
    add_rail(x, dk, d1, hk, hk, false)
}

// The top of a rail, where he rides it.
const RAIL_TOP: f32 = 0.05;

const BOX_TOP: f32 = 0.0;

rail_top(r: CRail): f32 {
    if (r.box) return BOX_TOP;
    RAIL_TOP
}

// ---- lamps ----
// Lamp posts along both edges of the run, staggered, always lit: at dusk
// they light it in warm pools (see lamp_map in render.l8).
const MAX_LAMPS: int = 80;

const LAMP_SPACING: f32 = 16.0;

const LAMP_HEIGHT: f32 = 3.0;

// Where each post stands.
lamp_x: []f32 = new f32[MAX_LAMPS](0.0);

lamp_z: []f32 = new f32[MAX_LAMPS](0.0);

nlamps: int = 0;

place_lamps() {
    nlamps = 0;
    d: f32 = 2.0;
    side: f32 = -1.0;
    while (d < COURSE_FINISH + 40.0 && nlamps < MAX_LAMPS) {
        lamp_x[nlamps] = side * (COURSE_HALF + 0.6);
        lamp_z[nlamps] = -d;
        nlamps = nlamps + 1;
        side = -side;
        d = d + LAMP_SPACING * 0.5
    }
}

// A lamp post: slender and dark, a lantern on top.
put_lamp_post(m: *Mesh, x: f32, z: f32) {
    y: f32 = course_height(x, z);
    post: V3 = v3(0.12, 0.13, 0.14);
    top: f32 = y + LAMP_HEIGHT;
    put_tube(m, v3(x, y - 0.1, z), v3(x, top - 0.18, z), 0.05, post, MAT_PAINT);
    at(x, top, z);
    put_rounded_box(m, xf, v3(0.12, 0.17, 0.12), 0.07, 0.0, 2, v3(1.0, 0.8, 0.52),
        MAT_GLOW);
    at(x, top + 0.2, z);
    put_rounded_box(m, xf, v3(0.15, 0.03, 0.15), 0.025, 0.0, 1, post, MAT_PAINT)
}

// ---- drawing the course ----
course_mat(x: f32, d: f32): f32 {
    if (absf(x) > COURSE_HALF + 0.6) return MAT_GRASS;
    // Past the run-out, a meadow.
    if (d > COURSE_FINISH + 55.0) return MAT_GRASS;
    k: int = kicker_at(x, d);
    if (k >= 0) {
        // A gap's pit is bare earth.
        if (feature_height(features[k], x, d) < -0.05) return MAT_ROCK;
        return MAT_KICKER
    }
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_PIPE && pipe_height(f, x, d) > 0.02) return MAT_PIPE;
        // A cliff's edge is rock.
        if (f.kind == FEATURE_CLIFF && d > f.d + 0.1 && d < f.d + f.a + 0.6) return MAT_ROCK
    }
    if (d < 0.0) return MAT_WOOD;
    MAT_CONCRETE
}

// A halfpipe's walls are smooth, paler concrete; rock is concrete's
// shading in a rock's color.
const MAT_PIPE: f32 = 0.02;

const MAT_ROCK: f32 = 0.03;

// Kickers are concrete too, a warmer shade, so they stand out.
const MAT_KICKER: f32 = 0.01;

course_color(mat: f32): V3 {
    if (mat == MAT_GRASS) return grass_color;
    if (mat == MAT_WOOD) return wood_color;
    if (mat == MAT_KICKER) return v3(0.68, 0.57, 0.46);
    if (mat == MAT_PIPE) return v3(0.6, 0.62, 0.66);
    if (mat == MAT_ROCK) return v3(0.36, 0.32, 0.28);
    v3(0.55, 0.56, 0.58)
}

// How open the sky is over the ground at (x, z): less at the foot of a
// bank or a kicker, where higher ground nearby hides some of it. Far out on
// the hills, it is all open.
course_ao(x: f32, z: f32): f32 {
    if (absf(x) > COURSE_HALF + 9.0) return 1.0;
    h: f32 = course_height(x, z);
    hidden: f32 = 0.0;
    for k in 0..8 {
        a: f32 = TAU * k as f32 / 8.0;
        dx: f32 = cosf(a);
        dz: f32 = sinf(a);
        rise: f32 = 0.0;
        r: f32 = 0.6;
        while (r < 4.0) {
            rise = maxf(rise, (course_height(x + dx * r, z + dz * r) - h) / r);
            r = r * 2.2
        }
        hidden = hidden + rise / sqrtf(1.0 + rise * rise)
    }
    clampf(1.0 - 0.75 * hidden / 8.0, 0.35, 1.0)
}

// The ground's normal there, its length the open sky (as the shader reads
// it).
course_normal_ao(x: f32, z: f32): V3 {
    v_scale(course_normal(x, z), course_ao(x, z))
}

course_vertex(x: f32, d: f32): V3 {
    v3(x, course_height(x, -d), -d)
}

// One quad of ground, its material from its middle.
put_ground_quad(
    m: *Mesh,
    x0: f32,
    x1: f32,
    d0: f32,
    d1: f32
) {
    mat: f32 = course_mat((x0 + x1) * 0.5, (d0 + d1) * 0.5);
    c: V3 = course_color(mat);
    a: V3 = course_vertex(x0, d0);
    b: V3 = course_vertex(x1, d0);
    e: V3 = course_vertex(x1, d1);
    f: V3 = course_vertex(x0, d1);
    put_quad_n(m, a, b, e, f, course_normal_ao(a.x, a.z), course_normal_ao(b.x, b.z),
        course_normal_ao(e.x, e.z), course_normal_ao(f.x, f.z), c, mat)
}

// Rows of the ground mesh: finer over features, coarse where the hill is
// plain, and coarser past either end.
fine_row(d: f32): bool {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (d > f.d - 1.0 && d < f.d + feature_len(f) + 1.0) return true
    }
    d > -1.0 && d < 22.0
}

row_step(d: f32): f32 {
    if (d > COURSE_END + 10.0 || d < COURSE_START - 10.0) return 4.0;
    if (fine_row(d)) return 0.5;
    1.0
}

// The next row after d: a row falls on each kicker's lip and the foot of
// its drop, so they stay crisp.
next_row(d: f32): f32 {
    if (far_lod) return d + maxf(2.0, row_step(d));
    nd: f32 = d + row_step(d);
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_KICKER) {
            lip: f32 = f.d + f.a;
            if (d < lip - 0.01 && nd > lip + 0.01) nd = lip;
            if (d < lip + LIP_GAP - 0.01 && nd > lip + LIP_GAP + 0.01) nd = lip + LIP_GAP
        }
    }
    nd
}

// Columns: across the plain hill, coarse; finer where it bends into the
// banks, or in a row with features; coarse again far out.
col_step(x: f32, fine: bool): f32 {
    e: f32 = absf(x);
    if (far_lod) {
        if (e < 40.0) return 2.0;
        return 12.0
    }
    if (e < COURSE_HALF - 1.0) {
        if (fine) return 0.5;
        return 1.0
    }
    if (e < COURSE_HALF + 7.0) return 0.5;
    if (e < 40.0) return 4.0;
    12.0
}

const COURSE_SIDE: f32 = 160.0;

// The mesh is built in chunks along the run, each with the ground and
// everything standing on it, so that drawing can skip what is far away.
const CHUNK_LEN: f32 = 20.0;

const CHUNK_FROM: f32 = -72.0;

const MAX_CHUNKS: int = 40;

chunk_first: []int = new int[MAX_CHUNKS](0);

chunk_count: []int = new int[MAX_CHUNKS](0);

nchunks: int = 0;

chunk_lo: f32 = 0.0;

chunk_hi: f32 = 0.0;

in_chunk(d: f32): bool {
    d >= chunk_lo && d < chunk_hi
}

// Each chunk is built twice: in full, for near him, and coarsely, for
// far down the run, where small things would be specks: coarser ground,
// simpler trees, no flowers. The full chunks come first, then the coarse.
far_lod: bool = false;

far_first: []int = new int[MAX_CHUNKS](0);

far_count: []int = new int[MAX_CHUNKS](0);

build_course(m: *Mesh) {
    m.n = 0;
    for pass in 0..2 {
        far_lod = pass == 1;
        nchunks = 0;
        while (nchunks < MAX_CHUNKS) {
            first: int = m.n;
            build_chunk(m);
            if (far_lod) {
                far_first[nchunks] = first;
                far_count[nchunks] = m.n - first
            } else {
                chunk_first[nchunks] = first;
                chunk_count[nchunks] = m.n - first
            }
            nchunks = nchunks + 1
        }
    }
    far_lod = false;
    backdrop_first = m.n;
    put_hills(m);
    backdrop_count = m.n - backdrop_first
}

// Hills all round, far off, blue with haze: a ring of them about the
// course's middle, rising from the valley floor.
backdrop_first: int = 0;

backdrop_count: int = 0;

hill_height(a: f32, ring: f32): f32 {
    n: f32 = 0.55 + 0.25 * sinf(a * 3.0 + 1.3) + 0.15 * sinf(a * 7.0 + 0.4) + 0.08 * sinf(a * 17.0 + 2.1);
    ring * ring * (3.0 - 2.0 * ring) * n * 260.0
}

put_hills(m: *Mesh) {
    cx: f32 = 0.0;
    cz: f32 = -150.0;
    y0: f32 = course_base(320.0) - 20.0;
    steps: int = 120;
    rings: int = 5;
    for i in 0..steps {
        a0: f32 = TAU * i as f32 / steps as f32;
        a1: f32 = TAU * (i + 1) as f32 / steps as f32;
        for j in 0..rings {
            r0: f32 = j as f32 / rings as f32;
            r1: f32 = (j + 1) as f32 / rings as f32;
            p00: V3 = hill_point(cx, cz, y0, a0, r0);
            p10: V3 = hill_point(cx, cz, y0, a1, r0);
            p11: V3 = hill_point(cx, cz, y0, a1, r1);
            p01: V3 = hill_point(cx, cz, y0, a0, r1);
            n: V3 = v_norm(v_cross(v_sub(p01, p00), v_sub(p10, p00)));
            if (n.y < 0.0) n = v_scale(n, -1.0);
            // Forest below, paler grass up top.
            k: f32 = clampf((p00.y - y0) / 180.0, 0.0, 1.0);
            col: V3 = v_lerp(v3(0.16, 0.3, 0.13), v3(0.36, 0.48, 0.24), k);
            put_quad(m, p00, p10, p11, p01, n, col, MAT_GRASS)
        }
    }
}

hill_point(
    cx: f32,
    cz: f32,
    y0: f32,
    a: f32,
    ring: f32
): V3 {
    r: f32 = 620.0 + ring * 900.0;
    v3(cx + cosf(a) * r, y0 + hill_height(a, ring), cz + sinf(a) * r)
}

build_chunk(m: *Mesh) {
    chunk_lo = CHUNK_FROM + nchunks as f32 * CHUNK_LEN;
    chunk_hi = chunk_lo + CHUNK_LEN;
    d: f32 = chunk_lo;
    while (d < chunk_hi) {
        nd: f32 = minf(next_row(d), chunk_hi);
        fine: bool = fine_row(d) || fine_row(nd);
        x: f32 = -COURSE_SIDE;
        while (x < COURSE_SIDE) {
            nx: f32 = x + col_step(x + 0.01, fine);
            put_ground_quad(m, x, nx, d, nd);
            x = nx
        }
        d = nd
    }
    put_lip_stripes(m);
    put_copings(m);
    for i in 0..ncrails {
        if (in_chunk(-crails[i].a.z)) put_course_rail(m, crails[i])
    }
    put_start(m);
    put_finish(m);
    put_course_scenery(m)
}

chunk_index(d: f32): int {
    clampi(((d - CHUNK_FROM) / CHUNK_LEN) as int, 0, nchunks - 1)
}

// The coarse chunks from d0 to d1: the first vertex and how many.
far_span(
    d0: f32,
    d1: f32,
    first: *int,
    count: *int
) {
    a: int = chunk_index(d0);
    b: int = chunk_index(d1);
    first.* = far_first[a];
    count.* = far_first[b] + far_count[b] - far_first[a]
}

// The part of the mesh from d0 to d1 down the run: its first vertex and
// how many.
course_span(
    d0: f32,
    d1: f32,
    first: *int,
    count: *int
) {
    a: int = clampi(((d0 - CHUNK_FROM) / CHUNK_LEN) as int, 0, nchunks - 1);
    b: int = clampi(((d1 - CHUNK_FROM) / CHUNK_LEN) as int, 0, nchunks - 1);
    first.* = chunk_first[a];
    count.* = chunk_first[b] + chunk_count[b] - chunk_first[a]
}

clampi(x: int, lo: int, hi: int): int {
    if (x < lo) return lo;
    if (x > hi) return hi;
    x
}

// Steel coping along the tops of each halfpipe's walls.
put_copings(m: *Mesh) {
    for i in 0..nfeatures {
        f: Feature = features[i];
        if (f.kind == FEATURE_PIPE) {
            for side in 0..2 {
                sx: f32 = 1.0;
                if (side == 0) sx = -1.0;
                x: f32 = sx * (pipe_top() + 0.06);
                d: f32 = f.d + 7.0;
                while (d < f.d + f.a - 7.0) {
                    nd: f32 = minf(d + 2.0, f.d + f.a - 7.0);
                    if (in_chunk(d)) put_tube(m, v3(x, course_height(x, -d) + 0.02,
                        -d), v3(x, course_height(x, -nd) + 0.02, -nd), 0.06, steel,
                        MAT_METAL);
                    d = nd
                }
            }
        }
    }
}

// An orange line along each kicker's lip.
put_lip_stripes(m: *Mesh) {
    orange: V3 = v3(0.98, 0.45, 0.12);
    for i in 0..nfeatures {
        f: Feature = features[i];
        if ((f.kind == FEATURE_KICKER || f.kind == FEATURE_GAP) && in_chunk(f.d + f.a)) {
            d0: f32 = f.d + f.a - 0.3;
            d1: f32 = f.d + f.a - 0.04;
            x: f32 = f.x - f.w;
            while (x < f.x + f.w - 0.01) {
                nx: f32 = minf(x + 0.5, f.x + f.w);
                a: V3 = v_add(course_vertex(x, d0), v3(0.0, 0.012, 0.0));
                b: V3 = v_add(course_vertex(nx, d0), v3(0.0, 0.012, 0.0));
                c: V3 = v_add(course_vertex(nx, d1), v3(0.0, 0.012, 0.0));
                e: V3 = v_add(course_vertex(x, d1), v3(0.0, 0.012, 0.0));
                put_quad(m, a, b, c, e, course_normal(x, -d0), orange, MAT_PAINT);
                x = nx
            }
            // Little flags either side of the lip.
            put_flag(m, f.x - f.w - 1.9, f.d + f.a, v3(0.95, 0.3, 0.25));
            put_flag(m, f.x + f.w + 1.9, f.d + f.a, v3(0.25, 0.5, 0.95))
        }
    }
}

put_flag(
    m: *Mesh,
    x: f32,
    d: f32,
    col: V3
) {
    y: f32 = course_height(x, -d);
    top: V3 = v3(x, y + 1.6, -d);
    put_tube(m, v3(x, y - 0.1, -d), top, 0.03, v3(0.9, 0.9, 0.88), MAT_PAINT);
    n: V3 = v3(1.0, 0.0, 0.0);
    a: V3 = v3(x, y + 1.6, -d);
    b: V3 = v3(x, y + 1.15, -d);
    c: V3 = v3(x, y + 1.4, -d + 0.55);
    put(m, a, n, col, MAT_PAINT);
    put(m, b, n, col, MAT_PAINT);
    put(m, c, n, col, MAT_PAINT)
}

rail_frame(r: CRail): V3 {
    v_norm(v_sub(r.b, r.a))
}

// Rails are painted teal and boxes navy: cool colors that stand out from
// the warm concrete, and from him.
rail_paint: V3 = V3 { x: 0.12, y: 0.42, z: 0.46 };

box_paint: V3 = V3 { x: 0.16, y: 0.27, z: 0.5 };

put_course_rail(m: *Mesh, r: CRail) {
    u: V3 = rail_frame(r);
    len: f32 = v_len(v_sub(r.b, r.a));
    post: V3 = v3(0.2, 0.21, 0.22);
    if (r.box) {
        // A painted box, its top a steel plate.
        side: V3 = v_norm(v_cross(u, v3(0.0, 1.0, 0.0)));
        up: V3 = v_cross(side, u);
        mid: V3 = v_scale(v_add(r.a, r.b), 0.5);
        // Deep enough to reach the ground under its low end.
        depth: f32 = 0.6;
        mat_frame(xf, side, up, u, v_madd(mid, up, -depth * 0.5));
        put_rounded_box(m, xf, v3(0.28, depth * 0.5, len * 0.5), 0.06, 0.0, 1, box_paint,
            MAT_PAINT);
        mat_frame(xf, side, up, u, v_madd(mid, up, 0.004));
        put_rounded_box(m, xf, v3(0.27, 0.012, len * 0.5 - 0.02), 0.01, 0.0, 1, steel,
            MAT_METAL);
        return
    }
    put_tube(m, r.a, r.b, 0.05, rail_paint, MAT_PAINT);
    // Posts down to the ground, about every metre and a half.
    k: int = (len / 1.5) as int + 1;
    for i in 0..k + 1 {
        p: V3 = v_lerp(r.a, r.b, (i as f32 + 0.15) / (k as f32 + 0.3));
        g: f32 = course_height(p.x, p.z);
        put_tube(m, v3(p.x, g - 0.1, p.z), v3(p.x, p.y - 0.04, p.z), 0.035, post,
            MAT_PAINT)
    }
}

// Two posts and a banner across the run.
put_gate(m: *Mesh, d: f32, banner: V3) {
    if (!in_chunk(d)) return;
    w: f32 = COURSE_HALF + 0.8;
    post: V3 = v3(0.95, 0.94, 0.9);
    y0: f32 = course_height(-w, -d);
    y1: f32 = course_height(w, -d);
    // High enough for the camera to pass under.
    top: f32 = maxf(y0, y1) + 6.5;
    put_tube(m, v3(-w, y0 - 0.2, -d), v3(-w, top, -d), 0.14, post, MAT_PAINT);
    put_tube(m, v3(w, y1 - 0.2, -d), v3(w, top, -d), 0.14, post, MAT_PAINT);
    at(0.0, top - 0.35, -d);
    put_rounded_box(m, xf, v3(w, 0.42, 0.12), 0.1, 0.0, 2, banner, MAT_PAINT);
    // Checks along the banner.
    k: int = 0;
    x: f32 = -w + 0.2;
    while (x < w - 0.6) {
        if (k % 2 == 0) {
            at(x + 0.2, top - 0.35, -d + 0.125);
            put_rounded_box(m, xf, v3(0.2, 0.2, 0.01), 0.01, 0.0, 1, v3(1.0, 0.98,
                0.94), MAT_PAINT)
        }
        x = x + 0.4;
        k = k + 1
    }
}

put_start(m: *Mesh) {
    put_gate(m, 1.0, v3(0.25, 0.55, 0.9))
}

put_finish(m: *Mesh) {
    put_gate(m, COURSE_FINISH, v3(0.92, 0.3, 0.22))
}

put_course_scenery(m: *Mesh) {
    rng: int = 777;
    placed: int = 0;
    while (placed < 200) {
        rng = (rng * 1103515245 + 12345) % 2147483648;
        side: f32 = 1.0;
        if (rng % 2 == 0) side = -1.0;
        rng = (rng * 1103515245 + 12345) % 2147483648;
        x: f32 = side * (COURSE_HALF + 3.0 + (rng % 10000) as f32 / 10000.0 * 32.0);
        rng = (rng * 1103515245 + 12345) % 2147483648;
        d: f32 = COURSE_START - 25.0 + (rng % 10000) as f32 / 10000.0 * (COURSE_END - COURSE_START + 40.0);
        if (in_chunk(d)) put_tree(m, x, -d, course_height(x, -d), 0.8 + 0.6 * cell_jitter(placed,
            3));
        placed = placed + 1
    }
    // Tufts and flowers on the banks.
    d: f32 = COURSE_START - 20.0;
    k: int = 0;
    while (d < COURSE_END + 10.0) {
        if (in_chunk(d) && !far_lod)
            for s in 0..2 {
                sg: f32 = -1.0;
                if (s == 1) sg = 1.0;
                meadow_rng = k * 7919 + s * 31 + 17;
                for _i in 0..5 {
                    x: f32 = sg * (COURSE_HALF + 0.9 + meadow_rand() * 9.0);
                    z: f32 = -(d + meadow_rand() * 2.0);
                    y: f32 = course_height(x, z);
                    if (meadow_rand() < 0.15) put_flower(m, x, y, z) else put_tuft(m,
                        x, y, z, 0.18 + 0.1 * meadow_rand())
                }
            }
        d = d + 2.0;
        k = k + 1
    }
    // The street lamps.
    for i in 0..nlamps {
        if (in_chunk(-lamp_z[i])) put_lamp_post(m, lamp_x[i], lamp_z[i])
    }
}
