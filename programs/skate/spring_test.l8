tag spring_test;

use_tag std, skate_math;

// spring_step's contract: a spring behaves alike at any frame rate. A
// landing's soak (skate's: omega 16, damped 0.7) is kicked and stepped for
// 2 s at 60 and at 5 frames a second (a slow phone's worst): its deepest
// and where it ends, in thousandths. Stepped once a frame, the 5 a second
// soak grew without end and the figure vanished.
import "math.l8";

import "../../stdlib/print.l8";

show_soak(frames_per_second: int) raises IoError {
    value: f32 = 0.0;
    speed: f32 = 3.0;
    deepest: f32 = 0.0;
    for _frame in 0..2 * frames_per_second {
        spring_step(&value, &speed, 0.0, Spring { omega: 16.0, damping: 0.7 }, 1.0 / frames_per_second as f32);
        deepest = maxf(deepest, absf(value))
    }
    write_int(1, frames_per_second);
    write(1, " a second: deepest ");
    write_int(1, (deepest * 1000.0) as int);
    write(1, ", at 2 s ");
    print_int((value * 1000.0) as int)
}

test "a landing's soak settles alike at 60 and at 5 frames a second" {
    show_soak(60);
    show_soak(5);
    expect {|
        60 a second: deepest 56, at 2 s 0
        5 a second: deepest 10, at 2 s 0
    |}
}
