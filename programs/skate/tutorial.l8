tag skate;

// The tutorial: a short course of its own, with one of each thing on it.
// The game rides it first, to show how it is done: thumbs of its own on the
// controls, doing what a good rider's do; time slowed wherever there is
// something to decide; and at each such place a line of words on what he
// is thinking there. Nothing is asked of whoever watches. Then he rides it
// himself, with a word before each thing on it, and from its finish goes
// on to the first course.
//
// Its course number, beyond any that can be typed.
const TUTORIAL: int = 100000000;

in_tutorial(): bool {
    course_seed == TUTORIAL && !park
}

// ---- its course ----
// Where down the run each thing is: room to steer, a ramp, a bigger one
// (far enough on that its tag is not up over the first's: see MARK_AHEAD,
// in slope.l8), a box to one side, a halfpipe, and a gap.
const TUT_RAMP: f32 = 50.0;

const TUT_RAMP_H: f32 = 1.6;

const TUT_BIG: f32 = 108.0;

const TUT_BIG_H: f32 = 2.2;

const TUT_BOX: f32 = 152.0;

const TUT_BOX_END: f32 = 168.0;

const TUT_BOX_X: f32 = 3.0;

const TUT_PIPE: f32 = 180.0;

const TUT_PIPE_LEN: f32 = 48.0;

const TUT_GAP: f32 = 246.0;

const TUT_GAP_H: f32 = 2.0;

lay_tutorial() {
    nfeatures = 0;
    ncrails = 0;
    nspecs = 0;
    nsects = 0;
    lay_tutorial_kicker(TUT_RAMP, TUT_RAMP_H);
    lay_tutorial_kicker(TUT_BIG, TUT_BIG_H);
    ff: int = nfeatures;
    fs: int = nspecs;
    add_spec(TUT_BOX_X, TUT_BOX, TUT_BOX_END, 0.2, 0.4, 1);
    tutorial_section(SECT_RAILS, TUT_BOX, TUT_BOX_END, ff, fs);
    ff = nfeatures;
    add_feature(FEATURE_PIPE, 0.0, TUT_PIPE, COURSE_HALF, pipe_wall(pipe_top()), TUT_PIPE_LEN,
        0.0, 0.0);
    tutorial_section(SECT_PIPE, TUT_PIPE, TUT_PIPE + TUT_PIPE_LEN, ff, nspecs);
    ff = nfeatures;
    add_feature(FEATURE_GAP, 0.0, TUT_GAP, 3.5, TUT_GAP_H, ramp_run(TUT_GAP_H), 3.0,
        6.0 + 4.0 * TUT_GAP_H);
    tutorial_section(SECT_GAP, TUT_GAP, TUT_GAP + feature_len(features[ff]), ff, nspecs)
}

// How long the way up a ramp h high is (see add_kicker).
ramp_run(h: f32): f32 {
    2.2 + h * 1.2
}

// A kicker h high in the middle of the run, as a section.
lay_tutorial_kicker(d: f32, h: f32) {
    ff: int = nfeatures;
    add_kicker(0.0, d, 3.5, h);
    tutorial_section(SECT_KICKERS, d, d + kicker_len(h), ff, nspecs)
}

tutorial_section(
    kind: int,
    d0: f32,
    d1: f32,
    first_feature: int,
    first_spec: int
) {
    sect_kind[nsects] = kind;
    sect_d0[nsects] = d0;
    sect_d1[nsects] = d1;
    note_lanes(nsects, first_feature, first_spec);
    nsects = nsects + 1
}

// ---- the run the game rides ----
// Whether it is riding (he watches), and how far through what it does it
// has got: each of these is a thing its thumbs do, or wait for.
demo_on: bool = false;

// Rolling off, before anything.
const DEMO_OFF: int = 0;

// The left thumb to one side, then the other, then back on line.
const DEMO_RIGHT: int = 1;

const DEMO_LEFT: int = 2;

const DEMO_LINE: int = 3;

// The first ramp: the right thumb down, well before it; slid up, for a
// flip; held, up to the ramp; held up it; let go; and down again.
const DEMO_PRESS: int = 4;

const DEMO_SET: int = 5;

const DEMO_HOLD: int = 6;

const DEMO_RAMP: int = 7;

const DEMO_FLY: int = 8;

const DEMO_ROLL: int = 9;

// The bigger one: down, slid down for a backflip, let go; then down again
// in the air, a grab; let go of that; and landed.
const DEMO_PRESS2: int = 10;

const DEMO_SET2: int = 11;

const DEMO_FLY2: int = 12;

const DEMO_GRAB: int = 13;

const DEMO_FALL: int = 14;

// Over to the box's line, and along it.
const DEMO_BOX: int = 15;

const DEMO_GRIND: int = 16;

// The halfpipe: in, and toward its right wall, a half turn set on the way;
// up the wall; off it; across to the left one, a whole turn set; off that;
// and out.
const DEMO_PIPE: int = 17;

const DEMO_WALL: int = 18;

const DEMO_UP: int = 19;

const DEMO_OFF_WALL: int = 20;

const DEMO_ACROSS: int = 21;

const DEMO_OFF_WALL2: int = 22;

const DEMO_OUT: int = 23;

// The gap: down, slid up and across, for a flip with a turn in it; let go;
// and on to the finish.
const DEMO_PRESS3: int = 24;

const DEMO_SET3: int = 25;

const DEMO_FLY3: int = 26;

const DEMO_HOME: int = 27;

demo_phase: int = DEMO_OFF;

// How long it has been doing that, as he counts time.
demo_t: f32 = 0.0;

// Its thumbs. The left: whether it is down, where along the steering track
// it is (-1 to 1, as the game reads it), and where it is going. The right:
// whether it is down, how far it has been slid (in half turns to the
// right, and flips forward: see read_aim, in touch.l8), and how far it is
// to be. (And each as it was a step ago, to draw them between steps.)
demo_steering: bool = false;

demo_steer: f32 = 0.0;

demo_steer_to: f32 = 0.0;

demo_down: bool = false;

demo_ax: f32 = 0.0;

demo_ay: f32 = 0.0;

demo_ax_to: f32 = 0.0;

demo_ay_to: f32 = 0.0;

demo_steer_was: f32 = 0.0;

demo_ax_was: f32 = 0.0;

demo_ay_was: f32 = 0.0;

// How fast its thumbs move: the left along its track, and the right in its
// slide, a second.
const DEMO_STEER_RATE: f32 = 2.2;

const DEMO_SLIDE_RATE: f32 = 4.5;

// How far short of a ramp's top it lets go.
const DEMO_LIP: f32 = 0.7;

// From the top, with nothing done.
demo_begin() {
    demo_on = true;
    demo_phase = DEMO_OFF;
    demo_t = 0.0;
    demo_steering = false;
    demo_steer = 0.0;
    demo_steer_to = 0.0;
    demo_down = false;
    demo_ax = 0.0;
    demo_ay = 0.0;
    demo_ax_to = 0.0;
    demo_ay_to = 0.0;
    demo_steer_was = 0.0;
    demo_ax_was = 0.0;
    demo_ay_was = 0.0;
    demo_beat = -1;
    demo_beat_t = 0.0;
    demo_pace = 0.0;
    demo_touch = 0.0;
    demo_rest = 0.0
}

demo_next() {
    demo_phase = demo_phase + 1;
    demo_t = 0.0
}

// The right thumb down (nothing slid yet), and up.
demo_press(k: *Keys) {
    if (demo_down) return;
    demo_down = true;
    demo_ax = 0.0;
    demo_ay = 0.0;
    demo_ax_to = 0.0;
    demo_ay_to = 0.0;
    k.pad_press = true;
    k.pad_held = true
}

demo_lift(k: *Keys) {
    if (!demo_down) return;
    demo_down = false;
    k.pad_held = false;
    k.pad_release = true
}

// The left thumb to where it steers him onto the line x across the run.
demo_line(m: *Mover, x: f32) {
    demo_steer_to = clampf((x - m.x) * 0.22, -0.8, 0.8)
}

toward(a: f32, b: f32, step: f32): f32 {
    if (a < b) return minf(a + step, b);
    maxf(a - step, b)
}

// One step of it, before one of his: what its thumbs do now, and so what
// the game is told (as a thumb on the glass would tell it: see read_pads).
// It goes by where he is and what he is doing, never by the clock on the
// wall, so that it rides the same however fast or slow it is shown.
demo_step(m: *Mover, k: *Keys, dt: f32) {
    d: f32 = -m.z;
    demo_t = demo_t + dt;
    p: int = demo_phase;
    if (p == DEMO_OFF) {
        if (demo_t > 0.25) {
            demo_steering = true;
            demo_next()
        }
    } else if (p == DEMO_RIGHT) {
        demo_steer_to = 0.5;
        if (demo_t > 1.5) demo_next()
    } else if (p == DEMO_LEFT) {
        demo_steer_to = -0.5;
        if (demo_t > 2.3) demo_next()
    } else if (p == DEMO_LINE) {
        demo_line(m, 0.0);
        if (d > TUT_RAMP - 27.0) {
            demo_press(k);
            demo_next()
        }
    } else if (p == DEMO_PRESS) {
        demo_line(m, 0.0);
        if (demo_t > 0.6) {
            demo_ay_to = 1.3;
            demo_next()
        }
    } else if (p == DEMO_SET) {
        demo_line(m, 0.0);
        if (demo_t > 0.6) demo_next()
    } else if (p == DEMO_HOLD) {
        demo_line(m, 0.0);
        if (d > TUT_RAMP - 2.0) demo_next()
    } else if (p == DEMO_RAMP) {
        demo_line(m, 0.0);
        if (d > TUT_RAMP + ramp_run(TUT_RAMP_H) - DEMO_LIP) {
            demo_lift(k);
            demo_next()
        }
    } else if (p == DEMO_FLY) {
        if (demo_t > 0.2 && !m.air) demo_next()
    } else if (p == DEMO_ROLL) {
        demo_line(m, 0.0);
        if (d > TUT_BIG - 22.0) {
            demo_press(k);
            demo_next()
        }
    } else if (p == DEMO_PRESS2) {
        demo_line(m, 0.0);
        if (demo_t > 0.3) {
            demo_ay_to = -1.3;
            demo_next()
        }
    } else if (p == DEMO_SET2) {
        demo_line(m, 0.0);
        if (d > TUT_BIG + ramp_run(TUT_BIG_H) - DEMO_LIP) {
            demo_lift(k);
            demo_next()
        }
    } else if (p == DEMO_FLY2) {
        if (demo_t > 0.22 && m.air) {
            demo_press(k);
            demo_next()
        }
    } else if (p == DEMO_GRAB) {
        if (demo_t > 0.5 || !m.air) {
            demo_lift(k);
            demo_next()
        }
    } else if (p == DEMO_FALL) {
        if (demo_t > 0.1 && !m.air) demo_next()
    } else if (p == DEMO_BOX) {
        demo_line(m, TUT_BOX_X);
        if (m.grinding) demo_next()
    } else if (p == DEMO_GRIND) {
        demo_steer_to = 0.0;
        if (!m.grinding) demo_next()
    } else if (p == DEMO_PIPE) {
        demo_line(m, 0.0);
        if (d > TUT_PIPE + 3.0) demo_next()
    } else if (p == DEMO_WALL) {
        demo_steer_to = 0.7;
        if (m.x > 1.0 && !m.air) {
            demo_press(k);
            demo_ax_to = 1.3
        }
        if (m.x > 4.6) demo_next()
    } else if (p == DEMO_UP) {
        if (m.x > 6.2) {
            demo_lift(k);
            demo_next()
        }
    } else if (p == DEMO_OFF_WALL) {
        if (demo_t > 0.3 && !m.air) demo_next()
    } else if (p == DEMO_ACROSS) {
        demo_steer_to = -0.7;
        if (m.x < -2.0 && !m.air) {
            demo_press(k);
            demo_ax_to = -2.3
        }
        if (m.x < -6.2) {
            demo_lift(k);
            demo_next()
        }
    } else if (p == DEMO_OFF_WALL2) {
        if (demo_t > 0.3 && !m.air) demo_next()
    } else if (p == DEMO_OUT) {
        demo_line(m, 0.0);
        if (d > TUT_GAP - 22.0) {
            demo_press(k);
            demo_next()
        }
    } else if (p == DEMO_PRESS3) {
        demo_line(m, 0.0);
        if (demo_t > 0.3) {
            demo_ax_to = 1.3;
            demo_ay_to = 1.3;
            demo_next()
        }
    } else if (p == DEMO_SET3) {
        demo_line(m, 0.0);
        if (d > TUT_GAP + ramp_run(TUT_GAP_H) - DEMO_LIP) {
            demo_lift(k);
            demo_next()
        }
    } else if (p == DEMO_FLY3) {
        if (demo_t > 0.2 && !m.air) demo_next()
    } else demo_line(m, 0.0);
    // The thumbs move: there in a moment, not at once.
    demo_steer_was = demo_steer;
    demo_ax_was = demo_ax;
    demo_ay_was = demo_ay;
    demo_steer = toward(demo_steer, demo_steer_to, DEMO_STEER_RATE * dt);
    if (demo_down) {
        demo_ax = toward(demo_ax, demo_ax_to, DEMO_SLIDE_RATE * dt);
        demo_ay = toward(demo_ay, demo_ay_to, DEMO_SLIDE_RATE * dt)
    }
    k.stick_on = demo_steering;
    k.stick_x = floorf(demo_steer * 512.0 + 0.5) / 512.0;
    k.aim_x = demo_ax;
    k.aim_y = demo_ay
}

// ---- how it is shown ----
// What it says, and how slowly time goes while it does. Each line comes up
// when the run gets to what it is about (and the one before has had its
// time), and time goes at its pace for as long as it takes to read; then
// on, as fast as ever, with the line still up.
type Beat = {
    // What its thumbs are doing when it comes up (see DEMO_OFF and the
    // rest).
    at: int;
    // How fast time goes while it is read, of 1; and for how long, in
    // seconds as he who watches counts them.
    pace: f32;
    secs: f32;
    // What it says: of thumbs; and of keys, where that differs.
    thumbs: str;
    keys: str
}

beats: []Beat = [Beat {
    at: DEMO_OFF,
    pace: 0.0,
    secs: 3.4,
    thumbs: "Hold your phone in both hands, with a thumb over each side.",
    keys: "The arrow keys steer. Space does the tricks."
}, Beat {
    at: DEMO_RIGHT,
    pace: 0.55,
    secs: 3.2,
    thumbs: "The left thumb steers. Slide it toward the side you want to go.",
    keys: "Left and Right steer."
}, Beat {
    at: DEMO_PRESS,
    pace: 0.16,
    secs: 3.0,
    thumbs: "A ramp is coming. Put your right thumb down early.",
    keys: "A ramp is coming. Hold Space early."
}, Beat {
    at: DEMO_SET,
    pace: 0.16,
    secs: 3.4,
    thumbs: "Slide it up to set a flip. Nothing happens until you let go.",
    keys: "Tap Up to set a flip. Nothing happens until you let go."
}, Beat {
    at: DEMO_HOLD,
    pace: 0.3,
    secs: 3.0,
    thumbs: "The trick is set. Now there is only steering to think about.",
    keys: ""
}, Beat {
    at: DEMO_RAMP,
    pace: 0.05,
    secs: 4.2,
    thumbs: "The ramp turns green where letting go lands the trick. The later you let go, the more air.",
    keys: ""
}, Beat {
    at: DEMO_FLY,
    pace: 0.35,
    secs: 1.6,
    thumbs: "Let go, and he flips.",
    keys: ""
}, Beat {
    at: DEMO_PRESS2,
    pace: 0.2,
    secs: 3.6,
    thumbs: "The same trick twice scores half, so set another. Down is a backflip.",
    keys: "The same trick twice scores half, so set another. Tap Down for a backflip."
}, Beat {
    at: DEMO_GRAB,
    pace: 0.12,
    secs: 3.6,
    thumbs: "In the air, thumb down again grabs the board. Let go before you land.",
    keys: "In the air, hold Space again to grab the board. Let go before you land."
}, Beat {
    at: DEMO_BOX,
    pace: 0.4,
    secs: 3.0,
    thumbs: "For a box or a rail, line up early and ride straight onto it.",
    keys: ""
}, Beat {
    at: DEMO_WALL,
    pace: 0.2,
    secs: 3.4,
    thumbs: "In a halfpipe, steer up a wall. Slide sideways to set a spin.",
    keys: "In a halfpipe, steer up a wall. Hold Space and tap Right to set a spin."
}, Beat {
    at: DEMO_UP,
    pace: 0.05,
    secs: 2.8,
    thumbs: "Let go on the green again, near the top.",
    keys: ""
}, Beat {
    at: DEMO_ACROSS,
    pace: 0.35,
    secs: 3.6,
    thumbs: "Each kind of jump scores extra for one kind of trick. The tag over it says which.",
    keys: ""
}, Beat {
    at: DEMO_PRESS3,
    pace: 0.2,
    secs: 3.8,
    thumbs: "A big jump has room for more. Slide up and across for a flip and a spin at once.",
    keys: "A big jump has room for more. Tap Up and Right for a flip and a spin at once."
}, Beat {
    at: DEMO_HOME,
    pace: 1.0,
    secs: 0.0,
    thumbs: "Set the trick early, let go late, and mix them up.",
    keys: ""
}];

// The line that is up (or -1), for how long it has been, and how fast
// time goes for it now.
demo_beat: int = -1;

demo_beat_t: f32 = 0.0;

demo_pace: f32 = 0.0;

// How far down the right thumb is drawn, from 0 (lifted) to 1; and the
// left.
demo_touch: f32 = 0.0;

demo_rest: f32 = 0.0;

// Whether the run it rides is over: the last line is up, and he is past
// the finish.
demo_over(m: *Mover): bool {
    demo_on && m.finished && m.finish_t > 0.6
}

// Each frame (dt as he who watches counts it): the next line, when it is
// time; and how fast time goes.
demo_frame(dt: f32) {
    if (!demo_on) return;
    next: int = demo_beat + 1;
    done: bool = demo_beat < 0 || demo_beat_t >= beats[demo_beat].secs;
    if (next < len(beats) && done && demo_phase >= beats[next].at) {
        demo_beat = next;
        demo_beat_t = 0.0;
        done = false
    }
    demo_beat_t = demo_beat_t + dt;
    pace: f32 = 1.0;
    if (!done) pace = beats[demo_beat].pace;
    // (Slowing sooner than it picks up again.)
    if (pace < demo_pace) demo_pace = lerpf(demo_pace, pace, ease(14.0, dt)) else demo_pace = lerpf(demo_pace,
        pace, ease(4.0, dt));
    if (absf(demo_pace - pace) < 0.004) demo_pace = pace;
    demo_touch = toward(demo_touch, demo_down as int as f32, dt / 0.14);
    demo_rest = toward(demo_rest, demo_steering as int as f32, dt / 0.14)
}

// What the line that is up says.
demo_text(): str {
    if (demo_beat < 0) return "";
    b: Beat = beats[demo_beat];
    if (!hud_touch && len(b.keys) > 0) return b.keys;
    b.thumbs
}

// Fingers no mouse or screen has (see pointer_button, in touch.l8): its
// thumbs, where the game draws what thumbs on the glass are doing.
const DEMO_STICK: int = 4;

const DEMO_TRICK: int = 5;

// Where its thumbs are on the screen, a way between the last step and the
// next: the left on the steering panel's track, and the right where it
// came down, in the middle of the other panel, and where it has slid to.
demo_lx: f32 = 0.0;

demo_ly: f32 = 0.0;

demo_rx: f32 = 0.0;

demo_ry: f32 = 0.0;

demo_show(alpha: f32) {
    p: *Pointers = pointers;
    w: f32 = screen_w as f32;
    h: f32 = screen_h as f32;
    s: f32 = lerpf(demo_steer_was, demo_steer, alpha);
    u: f32 = 0.0;
    if (s != 0.0) u = signf(s) * (STEER_DEAD + absf(s) * (STEER_FULL - STEER_DEAD));
    demo_lx = steer_middle() + u * (STEER_RIGHT - STEER_LEFT) * 0.5 * w;
    demo_ly = (PANEL_TOP + (PANEL_BOTTOM - PANEL_TOP) * TRACK_AT) * h;
    x0: f32 = w - steer_middle();
    y0: f32 = (PANEL_TOP + (PANEL_BOTTOM - PANEL_TOP) * PAD_AT) * h;
    demo_rx = x0 + lerpf(demo_ax_was, demo_ax, alpha) * SPIN_STEP * min_side();
    demo_ry = y0 - lerpf(demo_ay_was, demo_ay, alpha) * FLIP_STEP * min_side();
    // (Only a touch screen has thumbs on it to show.)
    if (!hud_touch) return;
    p.down[DEMO_STICK] = demo_steering;
    p.pad[DEMO_STICK] = false;
    p.x[DEMO_STICK] = demo_lx;
    p.y[DEMO_STICK] = demo_ly;
    p.stick = -1;
    if (demo_steering) p.stick = DEMO_STICK;
    p.down[DEMO_TRICK] = demo_down;
    p.pad[DEMO_TRICK] = true;
    p.x0[DEMO_TRICK] = x0;
    p.y0[DEMO_TRICK] = y0;
    p.x[DEMO_TRICK] = demo_rx;
    p.y[DEMO_TRICK] = demo_ry;
    p.trick = -1;
    if (demo_down) p.trick = DEMO_TRICK
}

// What its thumbs are doing, as keys, for a page with a keyboard to light:
// 1 and 2 for Left and Right, 4 for Space, 8 and 16 for Up and Down. (An
// arrow is lit while he steers that way, or while the thumb slides that
// way, which on keys is a tap of it.)
demo_keys(): int {
    if (!demo_on) return 0;
    n: int = 0;
    if (demo_steering && demo_steer_to < -0.25) n = n | 1;
    if (demo_steering && demo_steer_to > 0.25) n = n | 2;
    if (demo_down) {
        n = n | 4;
        if (demo_ax > demo_ax_to + 0.05) n = n | 1;
        if (demo_ax < demo_ax_to - 0.05) n = n | 2;
        if (demo_ay < demo_ay_to - 0.05) n = n | 8;
        if (demo_ay > demo_ay_to + 0.05) n = n | 16
    }
    n
}

// ---- riding it himself ----
// A word before each thing on it, as he comes to it: which (or -1).
cue_from: []f32 = [TUT_RAMP - 34.0, TUT_BIG - 26.0, TUT_BOX - 24.0, TUT_PIPE - 12.0,
    TUT_GAP - 22.0];

cue_to: []f32 = [TUT_RAMP + 2.0, TUT_BIG + 2.0, TUT_BOX + 4.0, TUT_PIPE + 30.0, TUT_GAP + 2.0];

cue_thumbs: []str = ["Right thumb down early, slide up, and let go where the ramp is green.",
    "Set a different trick here. In the air, thumb down again to grab.", "Line up with the box and ride straight onto it.",
    "Steer up a wall, slide sideways for a spin, and let go on the green.", "Slide up and across for a flip and a spin at once."];

cue_keys: []str = ["Hold Space early, tap Up, and let go where the ramp is green.",
    "Set a different trick here. In the air, hold Space again to grab.", "", "Steer up a wall, hold Space, tap Left or Right for a spin, and let go on the green.",
    "Hold Space, tap Up and Right for a flip and a spin at once."];

cue_at(d: f32): int {
    for i in 0..len(cue_from) {
        if (d >= cue_from[i] && d < cue_to[i]) return i
    }
    -1
}

cue_text(i: int): str {
    if (!hud_touch && len(cue_keys[i]) > 0) return cue_keys[i];
    cue_thumbs[i]
}

// What the tutorial has to say now, and of what kind: nothing (0), a line
// of the run the game rides (1), its last, that run being over (2), or a
// word to him as he rides it himself (3).
tut_say_kind: int = 0;

tut_say_text: str = "";

// (And a number that differs whenever either does.)
tut_say_id: int = 0;

tut_say(m: *Mover) {
    tut_say_kind = 0;
    tut_say_text = "";
    tut_say_id = 0;
    if (!in_tutorial()) return;
    if (demo_on) {
        if (demo_beat < 0) return;
        tut_say_kind = 1;
        if (demo_over(m)) tut_say_kind = 2;
        tut_say_text = demo_text();
        tut_say_id = tut_say_kind * 100 + demo_beat;
        return
    }
    if (m.finished) return;
    i: int = cue_at(-m.z);
    if (i < 0) return;
    tut_say_kind = 3;
    tut_say_text = cue_text(i);
    tut_say_id = 300 + i
}

// ---- what it says, where there is no page to say it ----
// On a touch screen the words are of thumbs; otherwise, of keys.
hud_touch: bool = false;

// Where the line of s that starts at i ends, of at most cap letters: at a
// space, or the end.
wrap_end(s: str, i: int, cap: int): int {
    n: int = len(s);
    if (n - i <= cap) return n;
    j: int = i + cap;
    while (j > i && s[j] as int != 32) j = j - 1;
    if (j == i) return i + cap;
    j
}

// How many lines s takes, of at most cap letters each.
wrap_count(s: str, cap: int): int {
    lines: int = 0;
    i: int = 0;
    while (i < len(s)) {
        j: int = wrap_end(s, i, cap);
        lines = lines + 1;
        i = j;
        if (i < len(s) && s[i] as int == 32) i = i + 1
    }
    lines
}

// s (in capitals, as the game's letters are) in lines of at most cap
// letters, each centred on cx, from y down; where the next line would go.
put_wrapped(
    s: str,
    cap: int,
    cx: f32,
    y0: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
): f32 {
    y: f32 = y0;
    i: int = 0;
    while (i < len(s)) {
        j: int = wrap_end(s, i, cap);
        text_len = 0;
        for k in i..j {
            c: int = s[k] as int;
            if (c >= 97 && c <= 122) c = c - 32;
            text_buf[text_len] = c trunc i8;
            text_len = text_len + 1
        }
        put_text(floorf(cx - text_width() * 0.5), floorf(y), r, g, b, a);
        y = y + 10.0 * hud_px;
        i = j;
        if (i < len(s) && s[i] as int == 32) i = i + 1
    }
    y
}

// How many letters fit across a panel in a window w wide.
panel_cap(w: int): int {
    clampi(((w as f32 * 0.84 / hud_px + 1.0) / 6.0) as int, 14, 44)
}

// A dark plate behind lines letters wide and rows lines tall (and extra
// more pixels), centred on cx with its top at y.
put_plate(
    cx: f32,
    y: f32,
    letters: int,
    rows: int,
    extra: f32,
    a: f32
) {
    half: f32 = letters as f32 * 6.0 * hud_px * 0.5 + 4.0 * hud_px;
    put_rect(cx - half, y - 4.0 * hud_px, cx + half, y + rows as f32 * 10.0 * hud_px + extra + 2.0 * hud_px,
        0.04, 0.05, 0.07, a)
}

// The tutorial's words, across the top (a page shows them itself: see
// L8SAY, in main.l8); and its thumbs, over the controls. Where the trick
// feed can go below the words.
put_tutorial(w: int, px: f32, y0: f32): f32 {
    if (!in_tutorial()) return y0;
    if (demo_on && hud_touch) put_demo_thumbs();
    if (hud_page || tut_say_kind == 0) return y0;
    hud_px = px;
    cx: f32 = w as f32 * 0.5;
    cap: int = panel_cap(w);
    y: f32 = y0;
    if (!hud_touch) y = y + 10.0 * px;
    rows: int = wrap_count(tut_say_text, cap);
    more: int = 0;
    if (tut_say_kind != 3) more = 1;
    put_plate(cx, y, cap, rows + more, 2.0 * px, 0.7);
    y = put_wrapped(tut_say_text, cap, cx, y, 1.0, 0.98, 0.92, 1.0);
    // How to go on from the run the game rides: to ride it himself.
    if (more == 1) {
        text_len = 0;
        if (tut_say_kind == 2) append("R TO TRY IT - T TO WATCH AGAIN") else append("R TO SKIP");
        put_text(floorf(cx - text_width() * 0.5), floorf(y), 0.4, 1.0, 0.55, 0.9);
        y = y + 10.0 * px
    }
    y + 6.0 * px
}

// A thumb of the game's own, reaching in from below the screen (out to
// the left, or the right) to (x, y): pale, with an edge, and a ring round
// where it touches when it is down (how far down: 0 to 1); lifted, fainter
// and a little off the glass.
put_demo_thumb(
    x: f32,
    y: f32,
    side: f32,
    down: f32
) {
    if (nruns + 3 > MAX_RUNS) return;
    ms: f32 = min_side();
    r: f32 = ms * 0.058 * (1.12 - 0.12 * down);
    edge: f32 = maxf(2.0, ms * 0.006);
    // (Lifted, it hovers a little way back toward where it comes from.)
    lift: f32 = (1.0 - down) * ms * 0.03;
    ax: f32 = x + side * lift * 0.5;
    ay: f32 = y - lift;
    // The way it reaches: down off the screen, and out to its side.
    ux: f32 = side * 0.32;
    uy: f32 = 0.947;
    nx: f32 = uy;
    ny: f32 = -ux;
    reach: f32 = maxf((screen_h as f32 + 2.0 * r - ay) / uy, r);
    bx: f32 = ax + ux * reach;
    by: f32 = ay + uy * reach;
    first: int = hud_n / 2;
    put_four(ax + nx * r, ay + ny * r, bx + nx * r, by + ny * r, bx - nx * r, by - ny * r,
        ax - nx * r, ay - ny * r);
    // Its round end.
    for i in 0..12 {
        t0: f32 = PI * i as f32 / 12.0;
        t1: f32 = PI * (i + 1) as f32 / 12.0;
        put_corner(ax, ay);
        put_corner(ax + (nx * cosf(t0) - ux * sinf(t0)) * r, ay + (ny * cosf(t0) - uy * sinf(t0)) * r);
        put_corner(ax + (nx * cosf(t1) - ux * sinf(t1)) * r, ay + (ny * cosf(t1) - uy * sinf(t1)) * r)
    }
    end_run(first, 1.0, 0.97, 0.92, 0.16 + 0.2 * down);
    plain_run();
    // Its edge: down each side, and round the end.
    first = hud_n / 2;
    q: f32 = r - edge;
    put_four(ax + nx * r, ay + ny * r, bx + nx * r, by + ny * r, bx + nx * q, by + ny * q,
        ax + nx * q, ay + ny * q);
    put_four(ax - nx * r, ay - ny * r, bx - nx * r, by - ny * r, bx - nx * q, by - ny * q,
        ax - nx * q, ay - ny * q);
    for i in 0..12 {
        t0: f32 = PI * i as f32 / 12.0;
        t1: f32 = PI * (i + 1) as f32 / 12.0;
        c0x: f32 = nx * cosf(t0) - ux * sinf(t0);
        c0y: f32 = ny * cosf(t0) - uy * sinf(t0);
        c1x: f32 = nx * cosf(t1) - ux * sinf(t1);
        c1y: f32 = ny * cosf(t1) - uy * sinf(t1);
        put_four(ax + c0x * r, ay + c0y * r, ax + c1x * r, ay + c1y * r, ax + c1x * q,
            ay + c1y * q, ax + c0x * q, ay + c0y * q)
    }
    end_run(first, 1.0, 0.97, 0.92, 0.45 + 0.45 * down);
    plain_run();
    if (down <= 0.0) return;
    // The ring round where it touches.
    first = hud_n / 2;
    r0: f32 = ms * 0.074;
    r1: f32 = r0 + maxf(3.0, ms * 0.01);
    for i in 0..36 {
        t0: f32 = TAU * i as f32 / 36.0;
        t1: f32 = TAU * (i + 1) as f32 / 36.0;
        put_four(x + cosf(t0) * r0, y + sinf(t0) * r0, x + cosf(t0) * r1, y + sinf(t0) * r1,
            x + cosf(t1) * r1, y + sinf(t1) * r1, x + cosf(t1) * r0, y + sinf(t1) * r0)
    }
    end_run(first, 1.0, 0.83, 0.42, down);
    plain_run()
}

// A shape of four corners, given in order round it.
put_four(
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    x2: f32,
    y2: f32,
    x3: f32,
    y3: f32
) {
    put_corner(x0, y0);
    put_corner(x1, y1);
    put_corner(x2, y2);
    put_corner(x0, y0);
    put_corner(x2, y2);
    put_corner(x3, y3)
}

put_demo_thumbs() {
    put_demo_thumb(demo_lx, demo_ly, -1.0, demo_rest);
    put_demo_thumb(demo_rx, demo_ry, 1.0, demo_touch)
}
