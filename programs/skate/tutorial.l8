tag skate;

// The tutorial: a short course of its own that teaches one thing at a
// time. Each lesson starts him at its place, still, with what to do
// written over the scene until he taps (or presses Space); then he tries
// it. When he has done it he goes on to the next; if he rides past without
// doing it he is put back to try again, with a hint, and after a few tries
// he goes on anyway. After the last he rides on to the finish, and from
// there to the first course.
//
// Its course number, beyond any that can be typed.
const TUTORIAL: int = 100000000;

in_tutorial(): bool {
    course_seed == TUTORIAL && !park
}

// The lessons, in order.
const LESSON_STEER: int = 0;

const LESSON_OLLIE: int = 1;

const LESSON_SPIN: int = 2;

const LESSON_FLIP: int = 3;

const LESSON_GRAB: int = 4;

const LESSON_GRIND: int = 5;

const LESSON_PIPE: int = 6;

const LESSON_DONE: int = 7;

// Where down the run each starts him, and where he has ridden past it.
lesson_from: []f32 = [-5.0, 30.0, 55.0, 98.0, 138.0, 183.0, 217.0, 276.0];

lesson_past: []f32 = [45.0, 70.0, 100.0, 142.0, 186.0, 219.0, 270.0, 1000.0];

// How fast he is rolling when a lesson starts him.
const LESSON_SPEED: f32 = 7.0;

// How many times he may fail a lesson before he goes on anyway.
const LESSON_TRIES: int = 4;

// The course: flat for steering and the first jumps, a kicker to flip off,
// a bigger one to grab off, a box to one side, and a halfpipe.
lay_tutorial() {
    nfeatures = 0;
    ncrails = 0;
    nspecs = 0;
    nsects = 0;
    lay_tutorial_section(SECT_KICKERS, 116.0, 116.0 + kicker_len(1.6), 1.6);
    lay_tutorial_section(SECT_KICKERS, 156.0, 156.0 + kicker_len(2.2), 2.2);
    ff: int = nfeatures;
    fs: int = nspecs;
    add_spec(3.0, 198.0, 214.0, 0.2, 0.4, 1);
    tutorial_section(SECT_RAILS, 198.0, 214.0, ff, fs);
    ff = nfeatures;
    add_feature(FEATURE_PIPE, 0.0, 226.0, COURSE_HALF, pipe_wall(pipe_top()), 48.0,
        0.0, 0.0);
    tutorial_section(SECT_PIPE, 226.0, 274.0, ff, nspecs)
}

// A kicker h high in the middle of the run, as a section.
lay_tutorial_section(
    kind: int,
    d0: f32,
    d1: f32,
    h: f32
) {
    ff: int = nfeatures;
    add_kicker(0.0, d0, 3.5, h);
    tutorial_section(kind, d0, d1, ff, nspecs)
}

tutorial_section(
    kind: int,
    d0: f32,
    d1: f32,
    first_feature: int,
    first_spec: int
) {
    sect_kind[nsects] = kind;
    sect_d0[nsects] = d0;
    sect_d1[nsects] = d1;
    note_lanes(nsects, first_feature, first_spec);
    nsects = nsects + 1
}

// ---- where he is in it ----
// What he is doing: reading a lesson (the game holds until he taps),
// trying it, being told he has done it, or being told to try again (the
// game holds a moment).
const TUT_READ: int = 0;

const TUT_TRY: int = 1;

const TUT_NICE: int = 2;

const TUT_AGAIN: int = 3;

tut_lesson: int = 0;

tut_state: int = TUT_READ;

// How long he has been in that state; how many times he has failed this
// lesson, and which hint he gets (0 for riding past, 1 for a sketchy
// landing).
tut_t: f32 = 0.0;

tut_fails: int = 0;

tut_hint: int = 0;

// The run that this state is for (see course_starts): another has started
// when it differs, and the tutorial starts over.
tut_starts: int = -1;

// What the lesson has seen of him so far: carved to the left and the
// right, how long he has ground, and how many of the run's hits it has
// looked at.
tut_left: bool = false;

tut_right: bool = false;

tut_grind: f32 = 0.0;

tut_seen: int = 0;

// He has been moved: the camera should cut to him.
tut_cut: bool = false;

// Whether the game holds still: while he reads, and for a moment before
// he tries again.
tut_holding(): bool {
    in_tutorial() && (tut_state == TUT_READ || tut_state == TUT_AGAIN)
}

// Whether a tap (or Space) is what it waits for.
tut_waiting(): bool {
    in_tutorial() && tut_state == TUT_READ && tut_t > 0.35
}

// The tap: on with it.
tut_go() {
    tut_state = TUT_TRY;
    tut_t = 0.0
}

// Put him at the start of lesson k, rolling, with nothing of what he was
// doing left over, and the lesson fresh.
tut_place(m: *Mover, k: int) {
    reset_mover(m);
    m.x = 0.0;
    m.z = -lesson_from[k];
    m.y = course_height(m.x, m.z);
    m.prev = v3(m.x, m.y, m.z);
    m.speed = LESSON_SPEED;
    if (k == LESSON_STEER) m.speed = PUSH_SPEED;
    m.heading = PI;
    m.sketch_t = 10.0;
    m.crail = -1;
    clear_run();
    tut_left = false;
    tut_right = false;
    tut_grind = 0.0;
    tut_seen = 0;
    tut_cut = true
}

// On to lesson k: he is put at its start (but for the last, which only has
// something to say), to read it.
tut_begin(m: *Mover, k: int) {
    tut_lesson = k;
    tut_state = TUT_READ;
    tut_t = 0.0;
    tut_fails = 0;
    if (k != LESSON_DONE) tut_place(m, k)
}

// He has done the lesson.
tut_pass() {
    tut_state = TUT_NICE;
    tut_t = 0.0
}

// He has not: back to its start with a hint; or, after enough tries, on to
// the next.
tut_fail(m: *Mover, hint: int) {
    tut_fails = tut_fails + 1;
    if (tut_fails >= LESSON_TRIES) {
        tut_begin(m, tut_lesson + 1);
        return
    }
    tut_hint = hint;
    tut_state = TUT_AGAIN;
    tut_t = 0.0;
    tut_place(m, tut_lesson)
}

// Each frame: a run started over starts the tutorial over; and its states
// that last a moment pass.
tut_frame(m: *Mover, dt: f32) {
    if (!in_tutorial()) return;
    if (tut_starts != course_starts) {
        tut_starts = course_starts;
        tut_lesson = LESSON_STEER;
        tut_state = TUT_READ;
        tut_t = 0.0;
        tut_fails = 0;
        tut_left = false;
        tut_right = false;
        tut_seen = 0;
        tut_cut = true
    }
    tut_t = tut_t + dt;
    if (tut_state == TUT_AGAIN && tut_t > 1.8) tut_go();
    // Told he has done it (and down from any jump), on to the next.
    if (tut_state == TUT_NICE && tut_t > 1.3 && !m.air) tut_begin(m, tut_lesson + 1)
}

// After each step of his: whether he has done what the lesson asks, or
// has ridden past it.
tut_step(m: *Mover, dt: f32) {
    if (!in_tutorial() || tut_state != TUT_TRY || tut_lesson >= LESSON_DONE) return;
    k: int = tut_lesson;
    done: bool = false;
    sketchy: bool = false;
    // What he has landed (or not) since it last looked.
    for i in tut_seen..run.n {
        h: Hit = run.hits[i];
        if (h.kind == HIT_SKETCH) sketchy = true else {
            if (k == LESSON_SPIN && h.halves != 0) done = true;
            if (k == LESSON_FLIP && h.item == FEATURE_KICKER && h.flips != 0) done = true;
            if (k == LESSON_GRAB && h.grab) done = true;
            if (k == LESSON_PIPE && h.item == FEATURE_PIPE && h.halves != 0) done = true
        }
    }
    tut_seen = run.n;
    if (k == LESSON_STEER) {
        if (m.carve > 0.35) tut_right = true;
        if (m.carve < -0.35) tut_left = true;
        done = tut_left && tut_right
    }
    if (k == LESSON_OLLIE) done = m.air && m.ollied;
    if (k == LESSON_GRIND) {
        if (m.grinding) tut_grind = tut_grind + dt;
        done = tut_grind > 0.4
    }
    if (done) {
        tut_pass();
        return
    }
    // A sketchy landing where the lesson is to land one clean (in the
    // halfpipe there is room to go again).
    if (sketchy && (k == LESSON_SPIN || k == LESSON_FLIP)) {
        tut_fail(m, 1);
        return
    }
    if (-m.z > lesson_past[k] && !m.air && !m.grinding) tut_fail(m, 0)
}

// ---- what it says ----
// On a touch screen the words are of thumbs and panels; otherwise, of keys.
hud_touch: bool = false;

lesson_titles: []str = ["STEERING", "JUMPING", "SPINS", "FLIPS", "GRABS", "GRINDS",
    "HALFPIPES", "SCORING"];

// What each lesson says, by the keys; and by the thumbs, where that
// differs.
lesson_keys: []str = ["STEER WITH THE LEFT AND RIGHT ARROWS. TURN ONE WAY, THEN THE OTHER.",
    "HOLD SPACE TO CROUCH. RELEASE TO JUMP.", "HOLD SPACE AND TAP THE RIGHT ARROW FOR A 180. RELEASE TO JUMP.",
    "HOLD SPACE AND TAP UP FOR A FRONTFLIP. RELEASE WHERE THE RAMP GLOWS GREEN.",
    "JUMP OFF THE KICKER, THEN HOLD SPACE IN THE AIR TO GRAB.", "RIDE ONTO THE END OF THE BOX TO GRIND IT.",
    "RIDE UP A WALL. PICK A 180 AND RELEASE WHERE THE WALL GLOWS GREEN.", "THE TAG OVER EACH JUMP SHOWS WHAT SCORES EXTRA THERE. A REPEATED TRICK SCORES HALF. RIDE TO THE FINISH."];

lesson_thumbs: []str = ["SLIDE YOUR THUMB ON THE STEER PANEL. TURN ONE WAY, THEN THE OTHER.",
    "HOLD THE TRICK PANEL TO CROUCH. RELEASE TO JUMP.", "HOLD THE TRICK PANEL AND DRAG SIDEWAYS FOR A 180. RELEASE TO JUMP.",
    "HOLD THE TRICK PANEL AND DRAG UP FOR A FRONTFLIP. RELEASE WHERE THE RAMP GLOWS GREEN.",
    "JUMP OFF THE KICKER, THEN HOLD THE TRICK PANEL IN THE AIR TO GRAB.", "", "",
    ""];

lesson_title(k: int): str {
    lesson_titles[k]
}

lesson_text(k: int): str {
    if (hud_touch && len(lesson_thumbs[k]) > 0) return lesson_thumbs[k];
    lesson_keys[k]
}

// The lesson in a few words, for while he tries it.
lesson_shorts: []str = ["TURN LEFT, THEN RIGHT", "HOLD, THEN RELEASE", "HOLD, PICK A 180, RELEASE",
    "FRONTFLIP: RELEASE ON THE GREEN", "HOLD AGAIN IN THE AIR", "RIDE ONTO THE BOX",
    "180 OFF THE WALL: RELEASE ON THE GREEN", "RIDE TO THE FINISH"];

lesson_short(k: int): str {
    lesson_shorts[k]
}

// What to do differently: having ridden past, or having landed sketchy.
lesson_hints: []str = ["TURN ONE WAY, THEN THE OTHER", "HOLD, THEN RELEASE", "HOLD, PICK A 180, RELEASE",
    "PICK THE FLIP EARLY AND RELEASE ON THE RAMP", "JUMP FIRST, THEN HOLD AGAIN IN THE AIR",
    "LINE UP AND RIDE STRAIGHT ONTO THE BOX", "RELEASE THE 180 WHILE YOU ARE ON THE WALL",
    ""];

lesson_hint(k: int, hint: int): str {
    if (hint == 1 && k == LESSON_SPIN) return "TOO MUCH SPIN FOR THIS JUMP: JUST A 180";
    if (hint == 1 && k == LESSON_FLIP) return "RELEASE LATER, ON THE GREEN";
    lesson_hints[k]
}

// Where the line of s that starts at i ends, of at most cap letters: at a
// space, or the end.
wrap_end(s: str, i: int, cap: int): int {
    n: int = len(s);
    if (n - i <= cap) return n;
    j: int = i + cap;
    while (j > i && s[j] as int != 32) j = j - 1;
    if (j == i) return i + cap;
    j
}

// How many lines s takes, of at most cap letters each.
wrap_count(s: str, cap: int): int {
    lines: int = 0;
    i: int = 0;
    while (i < len(s)) {
        j: int = wrap_end(s, i, cap);
        lines = lines + 1;
        i = j;
        if (i < len(s) && s[i] as int == 32) i = i + 1
    }
    lines
}

// s in lines of at most cap letters, each centred on cx, from y down;
// where the next line would go.
put_wrapped(
    s: str,
    cap: int,
    cx: f32,
    y0: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32
): f32 {
    y: f32 = y0;
    i: int = 0;
    while (i < len(s)) {
        j: int = wrap_end(s, i, cap);
        text_len = 0;
        for k in i..j {
            text_buf[text_len] = s[k];
            text_len = text_len + 1
        }
        put_text(floorf(cx - text_width() * 0.5), floorf(y), r, g, b, a);
        y = y + 10.0 * hud_px;
        i = j;
        if (i < len(s) && s[i] as int == 32) i = i + 1
    }
    y
}

// How many letters fit across a panel in a window w wide.
panel_cap(w: int): int {
    clampi(((w as f32 * 0.84 / hud_px + 1.0) / 6.0) as int, 14, 44)
}

// A dark plate behind lines letters wide and rows lines tall (and extra
// more pixels), centred on cx with its top at y.
put_plate(
    cx: f32,
    y: f32,
    letters: int,
    rows: int,
    extra: f32,
    a: f32
) {
    half: f32 = letters as f32 * 6.0 * hud_px * 0.5 + 4.0 * hud_px;
    put_rect(cx - half, y - 4.0 * hud_px, cx + half, y + rows as f32 * 10.0 * hud_px + extra + 2.0 * hud_px,
        0.04, 0.05, 0.07, a)
}

// The tutorial's words, over the scene: the lesson to read, on a plate in
// the middle; or, across the top, the lesson in short, that he has done
// it, or what to do differently. Where the trick feed can go below it.
put_tutorial(w: int, px: f32, y0: f32): f32 {
    if (!in_tutorial() || hud_finished) return y0;
    hud_px = px;
    cx: f32 = w as f32 * 0.5;
    cap: int = panel_cap(w);
    k: int = tut_lesson;
    if (tut_state == TUT_READ) {
        body: str = lesson_text(k);
        rows: int = wrap_count(body, cap);
        y: f32 = floorf(screen_h as f32 * 0.16);
        fade: f32 = smoothstepf(0.0, 0.3, tut_t);
        put_plate(cx, y, cap, rows + 3, 8.0 * hud_px, 0.8 * fade);
        // Its name, larger; what to do; and how to go on.
        hud_px = px + 1.0;
        text_len = 0;
        append(lesson_title(k));
        put_text(floorf(cx - text_width() * 0.5), y, 1.0, 0.84, 0.32, fade);
        hud_px = px;
        y = put_wrapped(body, cap, cx, y + 16.0 * px, 1.0, 0.98, 0.92, fade);
        text_len = 0;
        if (hud_touch) append("TAP TO START") else append("SPACE TO START");
        put_text(floorf(cx - text_width() * 0.5), y + 6.0 * px, 0.4, 1.0, 0.55, fade * (0.65 + 0.35 * sinf(tut_t * 5.0)));
        return y0
    }
    // (Below the page's line of keys, where there is one.)
    y: f32 = y0;
    if (!hud_touch) y = y + 10.0 * px;
    if (tut_state == TUT_AGAIN) {
        hint: str = lesson_hint(k, tut_hint);
        put_plate(cx, y, cap, wrap_count(hint, cap) + 1, 2.0 * px, 0.7);
        text_len = 0;
        append("TRY AGAIN");
        put_text(floorf(cx - text_width() * 0.5), y, 1.0, 0.45, 0.38, 1.0);
        return put_wrapped(hint, cap, cx, y + 11.0 * px, 1.0, 0.98, 0.92, 1.0) + 6.0 * px
    }
    if (tut_state == TUT_NICE) {
        hud_px = px * 2.0;
        text_len = 0;
        append("NICE!");
        put_text(floorf(cx - text_width() * 0.5), y, 0.4, 1.0, 0.55, 1.0 - smoothstepf(1.0,
            1.3, tut_t));
        hud_px = px;
        return y + 20.0 * px
    }
    short: str = lesson_short(k);
    put_plate(cx, y, mini(cap, len(short)), wrap_count(short, cap), 0.0, 0.55);
    put_wrapped(short, cap, cx, y, 1.0, 0.84, 0.32, 1.0) + 6.0 * px
}
