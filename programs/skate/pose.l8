tag skate;

use_tag std, blockguy;

// The guy's pose each frame, from the mover: he rides sideways on the
// board, crouches to aim a trick, tumbles through it, and squashes when he
// lands or bonks and springs back. Each part's matrix goes in the draw
// list.
type Anim = {
    yaw: f32;
    up: V3;
    y: f32;
    air: f32;
    // (Eased toward in two stages, so that it begins to change gently, not
    // at once at its quickest: the first of them; and so the crouch.)
    air_to: f32;
    squash: f32;
    squash_v: f32;
    board_yaw: f32;
    // (Eased toward in two stages: the first. Onto a rail, it turned a
    // quarter across at once at its quickest.)
    board_yaw_to: f32;
    board_up: V3;
    // How hard he carves (+ turning his way, 1 his hardest), for his arms
    // (see move_carve).
    lean: f32;
    // When he last felt the ground (see feel_ground), and how far the
    // board rolls under him (rad, about the way he goes).
    felt_t: f32;
    felt_along: f32;
    roll: f32;
    grind: f32;
    grab: f32;
    grab_v: f32;
    crouch: f32;
    crouch_to: f32;
    time: f32;
    // The arms' lean into a carve, a moment behind his.
    arm_lean: f32;
    // The landing's soak (a spring, 1 at its deepest) and how fast he fell.
    absorb: f32;
    absorb_v: f32;
    land_fall: f32;
    // (The arms follow the soak a moment behind it: kicked as the legs are,
    // they flew. And how long he has been down.)
    absorb_arms: f32;
    down_t: f32;
    // How long this air is, all told, from its start (see predict_air);
    // whether he was in the air, and had a trick under way.
    air_total: f32;
    was_air: bool;
    was_trick: bool;
    // Dragging the tail to stop (0 to 1).
    stop: f32;
    // Pushing: how long since the mover pushed; how far into it his feet
    // are (0 to 1, stepping off and back on) and his body (turning into its
    // stance); the stroke's clock; and his trail foot: where it is planted
    // in the world, whether it is, and where (in his frame) it came up from
    // the ground, and how it was then (its leg's squash, its pitch).
    push_seen: f32;
    // (Whether he has been up to speed yet this run, and the run's clock
    // when last seen: see update_anim.)
    rolled: bool;
    run_was: f32;
    push_w: f32;
    push_in: f32;
    push_t: f32;
    plant: V3;
    planted: bool;
    plant_done: bool;
    lift: V3;
    plant_squash: f32;
    plant_pitch: f32;
    // (When in its stroke it came up, or -1.)
    lift_at: f32;
    // Which foot leads (see Sides), and how long since that changed (on
    // landing switch); the joints as last shown, which follow the pose's for
    // a moment after, not at once (all that goes with leading went from
    // one leg to the other, and the legs and arms jumped); and the frame's
    // length.
    lead_was: int;
    swap_t: f32;
    // Onto a rail, the mover is put on it at once, up or down and across
    // to it: how far he is drawn from it still (m), let go of quickly; and
    // where he was as of the last two frames, to tell where he would have
    // been.
    rail_fix: V3;
    // How far his arms are pulled in to turn a trick (see move_air), and
    // how far they had opened again as it ended: easing out of it as he
    // lands, not at once (landing short of its end, they flew).
    tuck: f32;
    tuck_open: f32;
    // How far through the air he is, as shown (see pose_guy).
    through: f32;
    // How far a grab is held (see pose_guy); and the board's tip, tail
    // pivot and turn under him, as last shown.
    let_go: f32;
    board_tilt: f32;
    board_pivot: f32;
    board_twist: f32;
    at_was: V3;
    at_was2: V3;
    shown: GuyJoints;
    frame_dt: f32;
    // How he faces and flips, as the mover had them when last posed (with
    // any half turn of riding switch), and how far he is turned and flipped
    // from that still, easing off: when the mover's change at once (as he
    // lands, takes off, or gets on or off a rail), he goes on from where he
    // was. Whether he was on the ground, and whether this air is up a
    // halfpipe's wall (he comes back down it switch: see update_anim). And
    // the way his flip turns about, kept while he flips (see set_tumble).
    // (Easing off on a spring, from as fast as he was turning: landing
    // short of a flip's end, he turned on and back upright, not back at
    // once, the other way, in a frame.)
    face_was: f32;
    face_off: f32;
    flip_was: f32;
    flip_off: f32;
    face_off_v: f32;
    flip_off_v: f32;
    face_rate: f32;
    flip_rate: f32;
    state_was: int;
    flip_axis: V3;
    flip_axis_known: bool;
    vert_air: bool;
    // In the air his middle flies on an arc (see keep_on_arc): where it was
    // from the mover at the arc's start (and when in the air that was), and
    // where it will be at the landing; whether this air's are known; and how
    // far he is moved from where his moves put him to keep it there (let go
    // of once down).
    arc_from: V3;
    arc_start: f32;
    arc_to: V3;
    arc_known: bool;
    arc_fix: V3
}

new_anim(yaw: f32, y: f32): *Anim@new {
    new Anim {
        // (He rides sideways: square to the way he heads, as update_anim
        // keeps him.)
        yaw: yaw - PI * 0.5,
        up: v3(0.0, 1.0, 0.0),
        y: y,
        air: 0.0,
        air_to: 0.0,
        squash: 0.0,
        squash_v: 0.0,
        board_yaw: yaw,
        board_yaw_to: yaw,
        board_up: v3(0.0, 1.0, 0.0),
        lean: 0.0,
        felt_t: -1.0,
        felt_along: 0.0,
        roll: 0.0,
        grind: 0.0,
        grab: 0.0,
        grab_v: 0.0,
        crouch: 0.0,
        crouch_to: 0.0,
        time: 0.0,
        arm_lean: 0.0,
        absorb: 0.0,
        absorb_v: 0.0,
        land_fall: 0.0,
        absorb_arms: 0.0,
        down_t: 10.0,
        air_total: 1.0,
        was_air: false,
        was_trick: false,
        stop: 0.0,
        push_seen: 10.0,
        rolled: false,
        run_was: 0.0,
        push_w: 0.0,
        push_in: 0.0,
        push_t: 0.0,
        plant: v3(0.0, 0.0, 0.0),
        planted: false,
        plant_done: false,
        lift: v3(0.0, 0.0, 0.0),
        plant_squash: 1.0,
        plant_pitch: 0.0,
        lift_at: -1.0,
        lead_was: -1,
        swap_t: 10.0,
        rail_fix: v3(0.0, 0.0, 0.0),
        tuck: 0.0,
        tuck_open: 0.0,
        through: 1.0,
        let_go: 0.0,
        board_tilt: 0.0,
        board_pivot: 0.0,
        board_twist: 0.0,
        at_was: v3(0.0, y, 0.0),
        at_was2: v3(0.0, y, 0.0),
        shown: guy_solve(guy_stand()),
        frame_dt: 0.0,
        face_was: 0.0,
        face_off: 0.0,
        flip_was: 0.0,
        flip_off: 0.0,
        face_off_v: 0.0,
        flip_off_v: 0.0,
        face_rate: 0.0,
        flip_rate: 0.0,
        state_was: -1,
        flip_axis: v3(1.0, 0.0, 0.0),
        flip_axis_known: false,
        vert_air: false,
        arc_from: v3(0.0, 0.0, 0.0),
        arc_start: 0.0,
        arc_to: v3(0.0, 0.0, 0.0),
        arc_known: false,
        arc_fix: v3(0.0, 0.0, 0.0)
    }
}

// The draw list: him, and each other rider with him (see together.l8),
// each a draw of PART_GUY with a matrix for each of his bones and his
// color; the finish's gate; the stage's ground. A draw's matrices are
// draw_m's from its draw_first on (one for a part that is not a guy). It
// has room for all of those at once: more is the program's mistake (see
// draw_list_full).
const MAX_DRAWS: int = 1 + MAX_OTHERS + 2;

const MAX_MATRICES: int = GUY_BONES * (1 + MAX_OTHERS) + 2;

draw_m: []f32 = new f32[MAX_MATRICES * 16](0.0);

draw_part: []int = new int[MAX_DRAWS](0);

draw_first: []int = new int[MAX_DRAWS](0);

draw_tint: []V3 = new V3[MAX_DRAWS](V3 { x: 0.0, y: 0.0, z: 0.0 });

ndraw: int = 0;

nmatrix: int = 0;

// A part drawn where m puts it.
add_draw(part: int, m: []f32) raises IoError {
    if (ndraw >= MAX_DRAWS || nmatrix >= MAX_MATRICES) draw_list_full();
    for i in 0..16 draw_m[nmatrix * 16 + i] = m[i];
    draw_part[ndraw] = part;
    draw_first[ndraw] = nmatrix;
    draw_tint[ndraw] = body_color;
    ndraw = ndraw + 1;
    nmatrix = nmatrix + 1
}

// A guy drawn in a color: room for his bones' matrices, from the matrix
// this gives on.
add_guy_draw(tint: V3) raises IoError: int {
    if (ndraw >= MAX_DRAWS || nmatrix + GUY_BONES > MAX_MATRICES) draw_list_full();
    first: int = nmatrix;
    draw_part[ndraw] = PART_GUY;
    draw_first[ndraw] = first;
    draw_tint[ndraw] = tint;
    ndraw = ndraw + 1;
    nmatrix = nmatrix + GUY_BONES;
    first
}

// More drawn than the draw list was made for: said, and the game stops.
draw_list_full() raises IoError: noreturn {
    write(2, "the draw list is full: it has room for ");
    write_int(2, MAX_DRAWS);
    write(2, " draws and ");
    write_int(2, MAX_MATRICES);
    write(2, " matrices");
    die("")
}

root_m: []f32 = new f32[16](0.0);

part_m: []f32 = new f32[16](0.0);

board_m: []f32 = new f32[16](0.0);

X_AXIS: V3 = V3 { x: 1.0, y: 0.0, z: 0.0 };

Y_AXIS: V3 = V3 { x: 0.0, y: 1.0, z: 0.0 };

Z_AXIS: V3 = V3 { x: 0.0, y: 0.0, z: 1.0 };

// A frame whose y is up and z faces fwd.
frame_m(
    m: []f32,
    fwd: V3,
    up: V3,
    origin: V3
) {
    u: V3 = v_norm(up);
    f: V3 = v_norm(v_reject(fwd, u));
    mat_frame(m, v_cross(u, f), u, f, origin)
}

// The springs (see Spring): the grab's (snapping in, overshooting a
// little), the legs' soak on landing (deepest 0.07 s after, settled by
// 0.35 s) and the body's squash (springing back, ringing a little).
const GRAB_OMEGA: f32 = 14.8;

const GRAB_DAMPING: f32 = 0.54;

const ABSORB_OMEGA: f32 = 16.0;

const ABSORB_DAMPING: f32 = 0.7;

const SQUASH_OMEGA: f32 = 14.1;

const SQUASH_DAMPING: f32 = 0.42;

update_anim(a: *Anim, m: *Mover, dt: f32) {
    a.time = a.time + dt;
    a.frame_dt = dt;
    lead: int = sides_of(m).lead;
    if (a.lead_was >= 0 && lead != a.lead_was) a.swap_t = 0.0 else a.swap_t = a.swap_t + dt;
    a.lead_was = lead;
    at: f32 = 0.0;
    if (m.air) at = 1.0;
    a.air_to = lerpf(a.air_to, at, ease(24.0, dt));
    a.air = lerpf(a.air, a.air_to, ease(24.0, dt));
    if (m.air) a.down_t = 0.0 else a.down_t = a.down_t + dt;
    // (Onto a rail or off it is coming down too, as he stands: off a
    // halfpipe's wall onto one, he stood up from its lean in a few frames.)
    if (a.state_was >= 0 && m.grinding != (a.state_was == 2)) a.down_t = 0.0;
    gt: f32 = 0.0;
    if (m.grinding) gt = 1.0;
    a.grind = lerpf(a.grind, gt, ease(16.0, dt));
    gt2: f32 = 0.0;
    if (m.air && m.grab_t > 0.0) gt2 = 1.0;
    // It snaps in on a spring, overshooting a little, and lets go as
    // quickly.
    spring_step(&a.grab, &a.grab_v, gt2, Spring { omega: GRAB_OMEGA, damping: GRAB_DAMPING },
        dt);
    a.grab = clampf(a.grab, 0.0, 1.2);
    ct2: f32 = 0.0;
    if (m.winding) ct2 = 1.0;
    a.crouch_to = lerpf(a.crouch_to, ct2, ease(28.0, dt));
    a.crouch = lerpf(a.crouch, a.crouch_to, ease(28.0, dt));
    a.lean = lerpf(a.lean, clampf(m.speed * m.turn_rate / GRIP_ACCEL, -1.0, 1.0),
        ease(12.0, dt));
    a.arm_lean = lerpf(a.arm_lean, a.lean, ease(1.0 / 0.15, dt));
    // Landings squash his body a little and kick his legs' soak (see
    // ABSORB_OMEGA); bonks squash him more. The squash springs back.
    if (m.land > 0.0) {
        a.squash_v = a.squash_v - minf(m.land, 12.0) * 0.02;
        a.absorb_v = a.absorb_v + ABSORB_KICK;
        a.land_fall = m.land;
        m.land = 0.0
    }
    spring_step(&a.absorb, &a.absorb_v, 0.0, Spring { omega: ABSORB_OMEGA, damping: ABSORB_DAMPING },
        dt);
    a.absorb_arms = lerpf(a.absorb_arms, a.absorb, ease(20.0, dt));
    tucking: bool = m.air && m.trick_set && absf(m.flip_goal) + absf(m.spin_goal) > 0.1;
    if (tucking) a.tuck_open = smoothstepf(0.75, 1.0, trick_turned(m));
    tk: f32 = 0.0;
    if (tucking) tk = smoothstepf(0.0, 0.12, m.trick_t);
    a.tuck = lerpf(a.tuck, tk, ease(TUCK_EASE, dt));
    // (How long this air will be, from its start.)
    if (m.air && !a.was_air) a.air_total = maxf(m.air_time + predict_air(m), 0.2);
    // (A trick begun in an air already under way, off a lip, say, pops him
    // again, or may: its length foreseen again, and his arc begun afresh.)
    if (m.air && a.was_air && m.trick_set && !a.was_trick) {
        a.air_total = maxf(m.air_time + predict_air(m), 0.2);
        a.arc_known = false
    }
    a.was_air = m.air;
    a.was_trick = m.trick_set;
    // (Down, he is let go of from the arc quickly: see keep_on_arc.)
    if (!m.air) {
        a.arc_known = false;
        a.arc_fix = v_scale(a.arc_fix, 1.0 - ease(ARC_LET_GO, dt))
    }
    st: f32 = 0.0;
    if (m.finished && m.speed > 0.3 && !m.air) st = 1.0;
    a.stop = lerpf(a.stop, st, ease(6.0, dt));
    // Pushing: the mover pushes now and then, as his speed dips under the
    // push's; he pushes on through a stroke from the last time it did.
    // (Rolling away from the start, he stands: what keeps him going there
    // until the hill takes him is not shown as pushing. In the park he
    // pushes off.)
    if (m.run_t < a.run_was) a.rolled = false;
    a.run_was = m.run_t;
    if (m.speed > PUSH_SPEED + 0.5) a.rolled = true;
    if (m.pushing && (park || a.rolled)) a.push_seen = 0.0 else a.push_seen = a.push_seen + dt;
    pt: f32 = 0.0;
    if (a.push_seen < PUSH_STROKE && !m.air && !m.winding && !m.grinding) pt = 1.0;
    // (A push starts afresh, from a stroke's start, its feet in its stance
    // at once, so that its first stroke holds as the rest do (the trail
    // foot starts on the deck), his body turning into it over a moment; it
    // eases out. Off the ground, nothing is planted.)
    if (pt > 0.5) {
        if (a.push_w < 0.5) {
            a.push_t = 0.0;
            a.planted = false;
            a.plant_done = false
        }
        a.push_w = 1.0
    } else a.push_w = lerpf(a.push_w, pt, ease(4.0, dt));
    a.push_in = lerpf(a.push_in, pt, ease(8.0, dt));
    // (Nor does a push go on over an air.)
    if (m.air) {
        a.planted = false;
        a.push_seen = PUSH_STROKE
    }
    if (a.push_w > 0.01) a.push_t = a.push_t + dt else {
        a.push_t = 0.0;
        a.planted = false;
        a.plant_done = false
    }
    if (m.bonk > 0.0) {
        // (A bonk in the air turns his flight: his arc begins afresh.)
        if (m.air) a.arc_known = false;
        a.squash_v = a.squash_v - minf(m.bonk, 6.0) * 0.12;
        m.bonk = 0.0
    }
    spring_step(&a.squash, &a.squash_v, 0.0, Spring { omega: SQUASH_OMEGA, damping: SQUASH_DAMPING },
        dt);
    a.squash = clampf(a.squash, -0.3, 0.25);
    // His height is the mover's, on the ground as in the air (where he is
    // drawn is his place between steps: see pose_guy).
    a.y = m.y;
    at: V3 = v3(m.x, m.y, m.z);
    if (m.grinding && a.state_was >= 0 && a.state_was != 2) a.rail_fix = v_add(a.rail_fix,
        v_sub(v_sub(v_scale(a.at_was, 2.0), a.at_was2), at));
    a.rail_fix = v_scale(a.rail_fix, 1.0 - ease(RAIL_EASE, dt));
    a.at_was2 = a.at_was;
    a.at_was = at;
    // Grinding, he slides the board across the rail, turned a quarter to
    // face the way he goes.
    by: f32 = m.heading;
    if (m.grinding) by = by + PI * 0.5;
    // (Up a halfpipe's wall and back down, he does not turn: his way turns
    // back under him, and he lands riding the other way round, switch.)
    if (m.air && m.pipe_vert) a.vert_air = true;
    state: int = 0;
    if (m.air) state = 1 else if (m.grinding) state = 2;
    if (state != 1 && a.state_was == 1 && a.vert_air) {
        a.board_yaw = a.board_yaw + PI;
        a.board_yaw_to = a.board_yaw_to + PI;
        a.yaw = a.yaw + PI
    }
    if (state != 1) a.vert_air = false;
    if (state != 1 && absf(m.flip + a.flip_off) < 0.001) a.flip_axis_known = false;
    if (!(m.air && a.vert_air)) {
        a.board_yaw_to = approach_angle(a.board_yaw_to, by, ease(28.0, dt));
        a.board_yaw = approach_angle(a.board_yaw, a.board_yaw_to, ease(28.0, dt))
    }
    // The board tilts with the ground under him; level in the air (but up
    // off a halfpipe's wall, as he left it: see feel_ground), until it
    // nears the ground again.
    bu: V3 = m.ground_n;
    near: f32 = 0.0;
    if (m.grinding) bu = Y_AXIS else if (m.air) {
        bu = Y_AXIS;
        if (m.pipe_vert) bu = a.board_up;
        // (Coming down, he lays it to the ground under him, as it nears:
        // else it was laid on a bank's slope, or a wall's steeper than he
        // left it, at once as it touched.)
        // (Not going up: off a gap's lip, the ground under him is the pit's
        // wall.)
        above: f32 = m.y - course_height(m.x, m.z);
        if (m.vy < 0.0) near = 1.0 - smoothstepf(0.15, 1.2, above);
        bu = v_norm(v_lerp(bu, course_normal(m.x, m.z), near))
    }
    // (On the ground at once, nearly, or it lags the ground under it,
    // rising onto a ramp, say.)
    // (Off a lip it comes level slowly, as he flies, his feet on it: all at
    // once, they swapped which was the higher in a few frames. Nearing the
    // ground, quickly again.)
    bk: f32 = 40.0;
    if (m.air) bk = lerpf(BOARD_LEVEL_EASE, 30.0, near);
    if (m.grinding) bk = 14.0;
    // (And no quicker than BOARD_TURN_MOST: crossing a lip, the ground
    // under him is the ramp's one step and the drop's past it the next,
    // tipped the other way, and the board went from the one to level
    // between them at once.)
    was: V3 = a.board_up;
    a.board_up = v_norm(v_lerp(a.board_up, bu, ease(bk, dt)));
    turned: f32 = atan2f(v_len(v_cross(was, a.board_up)), v_dot(was, a.board_up));
    most: f32 = BOARD_TURN_MOST * dt;
    if (turned > most) a.board_up = v_norm(v_lerp(was, a.board_up, most / turned));
    a.yaw = approach_angle(a.yaw, a.board_yaw - PI * 0.5, ease(18.0, dt));
    // (Going on from where he was, as his state changes: see face_off.)
    face: f32 = a.yaw + m.spin;
    if (m.fakie) face = face + PI;
    if (a.state_was >= 0 && state != a.state_was) {
        df: f32 = wrap_angle(face - a.face_was);
        if (absf(df) > SNAP_LEAST) {
            a.face_off = a.face_off - df;
            a.face_off_v = a.face_off_v + clampf(a.face_rate, -SNAP_RATE_MOST, SNAP_RATE_MOST)
        }
        dl: f32 = wrap_angle(m.flip - a.flip_was);
        if (absf(dl) > SNAP_LEAST) {
            a.flip_off = a.flip_off - dl;
            a.flip_off_v = a.flip_off_v + clampf(a.flip_rate, -SNAP_RATE_MOST, SNAP_RATE_MOST)
        }
        // (Down far short of a flip's or spin's end, he crashes: the ground
        // stops him turning at once, as the jank meter is told (see
        // jank_crash).)
        if (state != 1 && maxf(absf(a.flip_off), absf(a.face_off)) > CRASH_LEAST) jank_crash()
    } else if (dt > 0.0001) {
        a.face_rate = wrap_angle(face - a.face_was) / dt;
        a.flip_rate = wrap_angle(m.flip - a.flip_was) / dt
    }
    spring_step(&a.face_off, &a.face_off_v, 0.0, Spring { omega: SNAP_OMEGA, damping: 1.0 },
        dt);
    spring_step(&a.flip_off, &a.flip_off_v, 0.0, Spring { omega: SNAP_OMEGA, damping: 1.0 },
        dt);
    a.face_was = face;
    a.flip_was = m.flip;
    a.state_was = state
}

// A change in how he faces or flips more than so much (rad) at once, as
// his state changes, is eased off on a spring this quick (/s: about a
// quarter of a second), from as fast as he turned, up to so fast (rad/s).
const SNAP_LEAST: f32 = 0.3;

const SNAP_OMEGA: f32 = 14.0;

// (Down further than so far short (rad), he has crashed.)
const CRASH_LEAST: f32 = 0.6;

const SNAP_RATE_MOST: f32 = 15.0;

// He stands as he must not to fall over: along what he feels (gravity,
// and against however he is hurried on, turned or borne up: by the wheels
// and the ground, not gravity, which pulls on all of him alike), not
// square to the ground. Carving, he leans into the turn as far as
// holds him up at his speed; on a slope across his way, going straight, he
// stands upright and the board tips under him; up a halfpipe's wall, the
// wall bearing him round, square to it. His middle goes where the mover
// does, so the board is out from under it as far as he leans: beginning a
// turn, it swings out under him as he leans in. Into a.up (and the board's
// roll, a.roll), from how the mover is hurried, turned and borne up (see
// Mover.felt).
feel_ground(a: *Anim, m: *Mover) {
    dt: f32 = a.time - a.felt_t;
    if (dt <= 0.0001) return;
    a.felt_t = a.time;
    feel: V3 = Y_AXIS;
    n: V3 = a.board_up;
    if (!m.air && !m.grinding) {
        side: V3 = v_cross(Y_AXIS, yaw_dir(m.heading));
        if (m.felt_on) {
            // (How he is hurried on along his way, smoothed more: pushing,
            // the mover speeds him up and leaves off from step to step.)
            way: V3 = yaw_dir(m.heading);
            a.felt_along = lerpf(a.felt_along, v_dot(m.felt, way), ease(ALONG_EASE,
                dt));
            feel = v_madd(v_add(v3(0.0, SLOPE_G, 0.0), m.felt), way, a.felt_along - v_dot(m.felt,
                way))
        } else {
            // (Riding with others, and on the stage, he is not stepped here:
            // only his turning is known, its pull toward his side, and the
            // ground, which he is taken to be square to.)
            feel = v_madd(v_scale(n, SLOPE_G), side, m.speed * m.turn_rate)
        }
        // (He leans no further than the wheels grip (LEAN_MOST_TAN) from
        // square to the ground. And as the ground bears him up less, falling
        // away nearly as fast as he would, he is as good as off it, with
        // nothing to balance on: as in the air, nothing turns him, and he
        // stays as he leans, not square to it (over a kicker's twisted
        // flank, say, that would tip him sideways off it).)
        bears: f32 = v_dot(feel, n);
        up: f32 = maxf(bears, SLOPE_G * 0.3);
        across: V3 = v_madd(feel, n, -bears);
        most: f32 = up * LEAN_MOST_TAN;
        if (v_len(across) > most) across = v_scale(across, most / v_len(across));
        feel = v_norm(v_lerp(a.up, v_norm(v_madd(across, n, up)), clampf(bears / (SLOPE_G * BEARS_LEAST),
            0.0, 1.0)));
        // (Nor further than UPRIGHT_LEAST from upright.)
        if (feel.y < UPRIGHT_LEAST) {
            flat: V3 = v_norm(v3(feel.x, 0.0, feel.z));
            feel = v_madd(v_scale(flat, sqrtf(1.0 - UPRIGHT_LEAST * UPRIGHT_LEAST)),
                Y_AXIS, UPRIGHT_LEAST)
        }
    }
    // In the air nothing turns him: leaning into a turn as he went off,
    // he flies leaning, and rights himself only slowly (AIR_RIGHT), though
    // along his way he stands up quickly (AIR_TIP). (Up off a halfpipe's wall, he
    // stays square to it, as he left it, to come back down it.)
    // (Just down, he comes to stand as he must over a moment, not at once:
    // landing on a bank, he tipped to its lean in a frame.)
    // (The two as far as he is in the air (Anim.air): touching the ground
    // for a step off a lip, he went from the one to the other and back,
    // and shook.)
    if (!(m.air && m.pipe_vert)) {
        ground: V3 = v_norm(v_lerp(a.up, feel, ease(lerpf(UP_LANDING, UP_EASE, smoothstepf(0.0,
            0.3, a.down_t)), dt)));
        way: V3 = yaw_dir(m.heading);
        side: V3 = v_norm(v_cross(Y_AXIS, way));
        lean: f32 = atan2f(v_dot(a.up, side), a.up.y) * (1.0 - ease(AIR_RIGHT, dt));
        tip: f32 = atan2f(v_dot(a.up, way), a.up.y) * (1.0 - ease(AIR_TIP, dt));
        flying: V3 = v_norm(v_add(v_scale(Y_AXIS, cosf(lean) * cosf(tip)), v_add(v_scale(side,
            sinf(lean) * cosf(tip)), v_scale(way, cosf(lean) * sinf(tip)))));
        a.up = v_norm(v_lerp(ground, flying, a.air))
    }
    // (The board rolls onto its edge a share of his lean against it, in the
    // air as on the ground.)
    way2: V3 = yaw_dir(m.heading);
    lean_across: f32 = atan2f(v_dot(a.up, v_cross(way2, n)), v_dot(a.up, n));
    // (Grinding, flat on the rail: as it comes onto it, not at once.)
    roll: f32 = BOARD_ROLL * lean_across;
    if (m.grinding) roll = 0.0;
    a.roll = lerpf(a.roll, roll, ease(ROLL_EASE, dt))
}

// The furthest he leans from square to the ground (tan 50 degrees: as far
// as the wheels grip, see GRIP_ACCEL), and from upright (cos 60 degrees:
// further, nobody balances), how quickly he stands as he feels (/s), how
// far his middle is over the board (m), and how much of his lean the board
// rolls with.
const LEAN_MOST_TAN: f32 = 1.19;

const UPRIGHT_LEAST: f32 = 0.5;

// (Borne up less than so much of his weight, he leans as he balances as
// much less, and holds his lean as much more.)
const BEARS_LEAST: f32 = 0.6;

const UP_EASE: f32 = 40.0;

const UP_LANDING: f32 = 8.0;

// (How quickly he is let go of from where he was as he came onto a rail,
// /s.)
const RAIL_EASE: f32 = 25.0;

// (How quickly how far through the air he is shown follows, /s.)
const THROUGH_EASE: f32 = 25.0;

// (How quickly a grab still held as he comes down is let go of, /s.)
const LET_GO_EASE: f32 = 18.0;

// (How quickly his arms come out of a trick's tuck, landed, /s.)
const TUCK_EASE: f32 = 14.0;

// (How quickly the board comes level in the air, /s.)
const BOARD_LEVEL_EASE: f32 = 5.0;

// (How quickly the board turns at the most, rad/s.)
const BOARD_TURN_MOST: f32 = 10.0;

// (How quickly the board's roll follows, /s.)
const ROLL_EASE: f32 = 12.0;

// (How quickly, flying, he stands up along his way, /s: out of a
// halfpipe's wall, square to it, say.)
const AIR_TIP: f32 = 10.0;

// For how long after his feet swap the joints shown follow the pose's
// (s), and how quickly (/s).
const SWAP_FOR: f32 = 0.3;

const SWAP_EASE: f32 = 18.0;

// Joints a way from a to b (t, 0 to 1).
mix_joints(a: GuyJoints, b: GuyJoints, t: f32): GuyJoints {
    r: GuyJoints = b;
    r.body.pitch = lerpf(a.body.pitch, b.body.pitch, t);
    r.body.roll = lerpf(a.body.roll, b.body.roll, t);
    r.body.yaw = lerpf(a.body.yaw, b.body.yaw, t);
    r.body.drop = lerpf(a.body.drop, b.body.drop, t);
    r.body.shift = lerpf(a.body.shift, b.body.shift, t);
    r.hips_yaw = lerpf(a.hips_yaw, b.hips_yaw, t);
    for side in 0..2 {
        r.legs[side].flex = lerpf(a.legs[side].flex, b.legs[side].flex, t);
        r.legs[side].abduct = lerpf(a.legs[side].abduct, b.legs[side].abduct, t);
        r.legs[side].twist = lerpf(a.legs[side].twist, b.legs[side].twist, t);
        r.legs[side].knee = lerpf(a.legs[side].knee, b.legs[side].knee, t);
        r.legs[side].ankle = lerpf(a.legs[side].ankle, b.legs[side].ankle, t);
        r.legs[side].roll = lerpf(a.legs[side].roll, b.legs[side].roll, t);
        r.legs[side].squash = lerpf(a.legs[side].squash, b.legs[side].squash, t);
        r.arms[side] = mix_arm(a.arms[side], b.arms[side], t)
    }
    r
}

// (How quickly what hurries him on along his way settles, /s.)
const ALONG_EASE: f32 = 6.0;

const BALANCE_H: f32 = 0.65;

const BOARD_ROLL: f32 = 0.3;

// How quickly he rights himself in the air (/s).
const AIR_RIGHT: f32 = 2.5;

// A sketchy landing's windmill: held so long (s), then fading over so long.
const SKETCH_HOLD: f32 = 0.45;

const SKETCH_FADE: f32 = 0.3;

// (A kick to the soak's speed that takes it to 1 at its deepest.)
const ABSORB_KICK: f32 = 34.9;

// On the course, his flip turns him and the board head over heels about
// his middle, across the way he flies.
tumble_m: []f32 = new f32[16](0.0);

tumble_tmp: []f32 = new f32[16](0.0);

tumbling: bool = false;

set_tumble(m: *Mover, a: *Anim, origin: V3) {
    tumbling = absf(m.flip + a.flip_off) > 0.001;
    if (!tumbling) return;
    // (Across the way he flew as the flip began, and across him, leaning
    // as he flew off; kept: a bounce off the fence turns his flight, not
    // his flip.)
    if (!a.flip_axis_known) {
        travel: V3 = v3(m.vx, 0.0, m.vz);
        if (v_len(travel) < 0.1) travel = yaw_dir(m.heading);
        a.flip_axis = v_norm(v_cross(a.up, travel));
        a.flip_axis_known = true
    }
    axis: V3 = a.flip_axis;
    pivot: V3 = v_madd(origin, a.up, 0.5);
    mat_identity(tumble_m);
    mat_translate(tumble_m, pivot);
    mat_rotate(tumble_m, axis, m.flip + a.flip_off);
    mat_translate(tumble_m, v_scale(pivot, -1.0))
}

apply_tumble(mat: []f32) {
    if (!tumbling) return;
    mat_mul(tumble_tmp, tumble_m, mat);
    mat_copy(mat, tumble_tmp)
}

// Start the draw list afresh with him at pos (x, z from it; height from
// the animation), his board, and the finish's gate. (Anyone riding with
// him comes after: see pose_others, in together.l8.)
pose(a: *Anim, m: *Mover, pos: V3) raises IoError {
    ndraw = 0;
    nmatrix = 0;
    pose_guy(a, m, pos, body_color, 1.0);
    // The finish's gate, where this place finishes (see PART_GATE).
    if (!park) {
        mat_identity(part_m);
        mat_translate(part_m, v3(0.0, course_base(course_finish), -course_finish));
        add_draw(PART_GATE, part_m)
    }
}

// Joints held by the stage (see stage.l8): which, and at what angles; the
// rest are as the pose has them.
held_joint: []int = new int[GUY_JOINTS](0);

held_angle: []f32 = new f32[GUY_JOINTS](0.0);

nheld: int = 0;

// (And both legs' squash, if more than 0.)
held_squash: f32 = 0.0;

// The joints of the last guy posed, for the stage's measures.
posed_joints: GuyJoints = guy_solve(guy_stand());

// (And as asked for, before they were kept within their ranges.)
posed_asked: GuyJoints = guy_solve(guy_stand());

// The joints as shown: as asked, but those the stage holds (see
// held_joint), within their ranges. Each guy's, as he is posed, is
// recorded (posed_joints, and posed_asked before the ranges) for the
// stage's measures.
record_shown_joints(asked: GuyJoints): GuyJoints {
    j: GuyJoints = asked;
    for k in 0..nheld {
        for side in 0..2 guy_set_joint(&j, held_joint[k], side, held_angle[k])
    }
    if (held_squash > 0.0) {
        for side in 0..2 j.legs[side].squash = held_squash
    }
    posed_asked = j;
    posed_joints = guy_clamp(j);
    posed_joints
}

// Add a guy at pos and his board to the draw list, in his color (tint),
// and at `size` of his size about his feet (less as he comes or goes):
// the moves the animation has (see moves.l8) mixed into a pose. (Pushing,
// it keeps where his trail foot is planted in the world: see push_foot.)
pose_guy(
    a: *Anim,
    m: *Mover,
    pos: V3,
    tint: V3,
    size: f32
) raises IoError {
    first: int = add_guy_draw(tint);
    feel_ground(a, m);
    feet: V3 = pos;
    feet = v_add(feet, a.rail_fix);
    if (first == 0) jank_root = feet;
    // (The board out from under his middle as far as he leans against it,
    // along the ground: see feel_ground.)
    n: V3 = a.board_up;
    contact: V3 = v_madd(feet, v_madd(a.up, n, -v_dot(a.up, n)), -BALANCE_H);
    // (On the ground there, which curves up from the plane it is out along:
    // up a bank, say, or over a kicker's twisted flank. Not where it falls
    // away under it, as past a lip: it rides over the edge, not down into
    // the pit beyond.)
    if (!m.air && !m.grinding) contact.y = lerpf(contact.y, maxf(contact.y, feet.y + course_height(contact.x,
        contact.z) - course_height(feet.x, feet.z)), 1.0 - a.air);
    origin: V3 = v_madd(contact, n, DECK_TOP);
    // Riding switch, he faces the other way round. (And he goes on from how
    // he faced: see face_off.)
    spin: f32 = m.spin + a.face_off;
    if (m.fakie) spin = spin + PI;
    frame_m(root_m, yaw_dir(a.yaw + spin), a.up, origin);
    set_tumble(m, a, origin);
    apply_tumble(root_m);
    st: Sides = sides_of(m);
    // (Turning his way, the animation's lean is +, and he leans to his
    // heels: a heelside carve.)
    mv: BoardMove = move_ride(a);
    toe: f32 = clampf(-a.arm_lean, -1.0, 1.0);
    mv = mix_move(mv, move_carve(a, st, toe), absf(toe));
    mv = mix_move(mv, move_grind(a), a.grind);
    mv = mix_move(mv, move_windup(m), a.crouch);
    through: f32 = clampf(m.air_time / a.air_total, 0.0, 1.0);
    if (!m.air) through = 1.0;
    // (Following quickly, not at once: down for a moment and off again,
    // the air's pose jumped to its end and back, as much of it as showed.)
    a.through = lerpf(a.through, through, ease(THROUGH_EASE, a.frame_dt));
    through = a.through;
    air: BoardMove = move_air(a, m, st, through);
    mv = mix_move(mv, air, a.air);
    // (The tail let go of over 0.25 s, from 0.3 s before he lands: easing
    // in and out, so the hand never snaps off.)
    leaving: f32 = smoothstepf(0.0, 1.0, (0.3 - (a.air_total - m.air_time)) / 0.25);
    // (And taken over 0.1 s from take-off: a grab still letting go of as
    // he popped again at once snapped back in.)
    let_go: f32 = (1.0 - leaving) * smoothstepf(0.0, 0.1, m.air_time);
    // (Down before it was let go of, as onto a rail sooner than the
    // ground, it is let go of quickly, not at once.)
    if (!m.air) let_go = 0.0;
    if (let_go < a.let_go) let_go = lerpf(a.let_go, let_go, ease(LET_GO_EASE, a.frame_dt));
    a.let_go = let_go;
    mv = mix_move(mv, move_grab(st, air), minf(a.grab, 1.0) * let_go);
    // (Snapping into it over a few frames.)
    pop: f32 = smoothstepf(0.0, 0.1, m.since_hop) * (1.0 - smoothstepf(0.14, 0.27,
        m.since_hop));
    mv = mix_move(mv, move_pop(m, st, mv), pop);
    before: BoardMove = mv;
    mv = mix_move(mv, move_land(mv, a.land_fall), clampf(a.absorb, 0.0, 1.0));
    for i in 0..2 mv.arms[i] = mix_arm(before.arms[i], move_land(before, a.land_fall).arms[i],
        clampf(a.absorb_arms, 0.0, 1.0));
    wobble: f32 = 0.0;
    // (Sketchy: the windmill held a moment, then fading.)
    if (m.sketch_t < SKETCH_HOLD + SKETCH_FADE) {
        k: f32 = smoothstepf(0.0, 0.08, m.sketch_t) * (1.0 - smoothstepf(SKETCH_HOLD,
            SKETCH_HOLD + SKETCH_FADE, m.sketch_t));
        wobble = sinf(m.sketch_t * 26.0) * 0.22 * k;
        mv = mix_move(mv, move_sketch(mv, m.sketch_t), k)
    }
    mv.roll = mv.roll - wobble;
    mv = mix_move(mv, move_stop(st, mv), a.stop);
    mv = mix_move(mv, move_push(a, st), a.push_in);
    p: GuyPose = move_pose(mv, st, a.air, 1.0 + 0.01 * sinf(a.time * 2.1), a.squash);
    if (a.push_w > 0.001) push_feet(a, st, &p);
    on_board(a, m, st, &p);
    // The board: under his feet as they are (up off the ground with them
    // in the air), tipped as the move has it.
    soles: V3 = v_scale(v_add(p.ankle[0], p.ankle[1]), 0.5);
    if (a.push_w > 0.001) soles = v_lerp(soles, p.ankle[st.lead], a.push_w);
    soles.y = soles.y - GUY_ANKLE_UP;
    // (The board turned under him: his feet turn with it, about their
    // middle.)
    if (absf(mv.board_yaw) > 0.0001) {
        middle: V3 = v_scale(v_add(p.ankle[0], p.ankle[1]), 0.5);
        for i in 0..2 {
            p.ankle[i] = v_add(middle, v_rotate(v_sub(p.ankle[i], middle), Y_AXIS,
                mv.board_yaw));
            p.foot_yaw[i] = p.foot_yaw[i] + mv.board_yaw
        }
    }
    // (The board's tip and turn are a grab's, on his lead side or trail:
    // as his feet swap, they follow, as his joints do, not flipped at once.)
    tilt: f32 = mv.tilt * st.lead_x;
    pivot: f32 = mv.tail_pivot;
    twist: f32 = mv.board_yaw;
    if (a.swap_t < SWAP_FOR) {
        k: f32 = ease(SWAP_EASE, a.frame_dt);
        tilt = lerpf(a.board_tilt, tilt, k);
        pivot = lerpf(a.board_pivot, pivot, k);
        twist = lerpf(a.board_twist, twist, k)
    }
    a.board_tilt = tilt;
    a.board_pivot = pivot;
    a.board_twist = twist;
    pose_board(a, m, contact, spin, soles, a.air, tilt, pivot, twist);
    // Grabbing, his trail hand to the tail's tip.
    posed_grab = mv.grab;
    if (mv.grab > 0.001) {
        tip: V3 = mat_point(board_m, v3(0.0, DECK_TOP + 0.036 + GRAB_ABOVE, -GRAB_REACH * st.lead_x));
        posed_tail = tip;
        p.hand[st.trail] = from_root(tip);
        // (All the way to it once the grab is most of the way in, so that
        // the mitt is on the tail, not near it; and let go of as the grab
        // is, over the whole let-go, not the end of it.)
        p.hand_reach[st.trail] = smoothstepf(0.3, 0.85, minf(a.grab, 1.0)) * let_go
    }
    j: GuyJoints = guy_solve(p);
    // (A planted push toe: the ankle moved by however far the toe missed,
    // twice, so that it stays put.)
    if (a.planted && a.push_w > 0.999) {
        for _round in 0..3 {
            missed: V3 = v_sub(from_root(a.plant), guy_point_on(j, guy_foot(st.trail),
                guy_toe_tip()));
            p.ankle[st.trail] = v_add(p.ankle[st.trail], missed);
            hip: V3 = guy_hip(p.body, p.hips_yaw, st.trail);
            p.leg_squash[st.trail] = clampf(v_len(v_sub(p.ankle[st.trail], hip)) / (GUY_THIGH + GUY_SHIN) * 1.004,
                1.0, PUSH_STRETCH);
            j = guy_solve(p)
        }
    }
    // (Following the pose's for a moment after his feet swap: see
    // Anim.shown.)
    if (a.swap_t < SWAP_FOR) j = mix_joints(a.shown, j, ease(SWAP_EASE, a.frame_dt));
    a.shown = j;
    j = record_shown_joints(j);
    guy_bones(j, root_m, draw_m, first);
    // (A planted push foot comes up once his leg cannot reach it.)
    if (a.planted && j.pin_short[st.trail] > 0.003) {
        a.planted = false;
        a.plant_done = true
    }
    if (a.plant_done && a.lift_at < 0.0) a.lift_at = push_phase(a);
    if (!a.plant_done) a.lift_at = -1.0;
    if (a.push_w > 0.001 && !a.plant_done) a.lift = from_root(guy_bone_point(draw_m,
        first, guy_foot(st.trail), v3(0.0, 0.0, 0.0)));
    for k in 0..16 draw_m[(first + GUY_BOARD) * 16 + k] = board_m[k];
    keep_on_arc(a, m, st, pos, first);
    if (size < 0.999) {
        mat_identity(size_m);
        mat_translate(size_m, feet);
        mat_scale(size_m, v3(size, size, size));
        mat_translate(size_m, v_scale(feet, -1.0));
        for b in first..first + GUY_BONES {
            for k in 0..16 part_m[k] = draw_m[b * 16 + k];
            mat_mul(tumble_tmp, size_m, part_m);
            for k in 0..16 draw_m[b * 16 + k] = tumble_tmp[k]
        }
    }
}

// In the air nothing pushes him: his middle (his centre of mass, the
// board's with his) flies on an arc however he moves about it, and every
// turn of a trick is about it. The mover's place flies on such an arc;
// his middle keeps to one beside it, from where it was from the mover at
// the start of the air (or of a trick begun in it: see update_anim) to
// where it will be at the landing (see
// landing_middle), going from the one to the other evenly over the air,
// which keeps it an arc as the mover's is. His moves are of his body
// about its middle, then: tucking up brings the board up and his body
// down to meet it. Each bone (the board's too) is moved by as much as
// keeps it there; once down, by what was left at the landing, let go of
// quickly (see update_anim). (A guy's bones are from matrix `first`.)
keep_on_arc(
    a: *Anim,
    m: *Mover,
    st: Sides,
    pos: V3,
    first: int
) {
    mid: V3 = rider_middle(draw_m, first);
    if (m.air && arc_kept) {
        if (!a.arc_known) {
            a.arc_known = true;
            a.arc_from = v_sub(v_add(mid, a.arc_fix), pos);
            a.arc_start = m.air_time;
            a.arc_to = landing_middle(a, m, st)
        }
        through: f32 = clampf((m.air_time - a.arc_start) / maxf(a.air_total - a.arc_start,
            0.05), 0.0, 1.0);
        a.arc_fix = v_sub(v_add(pos, v_lerp(a.arc_from, a.arc_to, through)), mid)
    }
    if (v_len(a.arc_fix) < 0.0001) return;
    if (posed_grab > 0.001) posed_tail = v_add(posed_tail, a.arc_fix);
    for b in first..first + GUY_BONES {
        draw_m[b * 16 + 12] = draw_m[b * 16 + 12] + a.arc_fix.x;
        draw_m[b * 16 + 13] = draw_m[b * 16 + 13] + a.arc_fix.y;
        draw_m[b * 16 + 14] = draw_m[b * 16 + 14] + a.arc_fix.z
    }
}

// (Whether he is kept on the arc: the stage's L8_FREE turns it off, to
// compare.)
arc_kept: bool = true;

// How quickly he is let go of from the arc once down (/s).
const ARC_LET_GO: f32 = 25.0;

// The board's share of him and it (a board is about a twenty-fifth of a
// skater), and its middle in its frame: halfway up to the deck.
const BOARD_MASS: f32 = 0.04;

// His middle and the board's together, where the bones from matrix
// `first` (the board's too) put them.
rider_middle(bones: []f32, first: int): V3 {
    board: V3 = guy_bone_point(bones, first, GUY_BOARD, v3(0.0, DECK_TOP * 0.5, 0.0));
    v_lerp(guy_middle(bones, first), board, BOARD_MASS)
}

landing_bones: []f32 = new f32[GUY_BONES * 16](0.0);

landing_root: []f32 = new f32[16](0.0);

// Where his middle will be from the mover as he lands: standing tall, his
// legs reaching down for the ground (the air's last pose), turned as his
// trick will leave him, leaning as he will be by then (see AIR_RIGHT).
landing_middle(a: *Anim, m: *Mover, st: Sides): V3 {
    spin: f32 = m.spin;
    if (m.trick_set) spin = m.spin_goal;
    if (m.fakie) spin = spin + PI;
    up: V3 = a.up;
    if (!m.pipe_vert) up = v_norm(v_lerp(Y_AXIS, a.up, expf(-AIR_RIGHT * maxf(a.air_total - m.air_time,
        0.0))));
    frame_m(landing_root, yaw_dir(a.yaw + spin), up, v_scale(up, DECK_TOP));
    p: GuyPose = move_pose(move_air(a, m, st, 1.0), st, 1.0, 1.0, 0.0);
    guy_bones(guy_clamp(guy_solve(p)), landing_root, landing_bones, 0);
    // (The board under his feet, on the ground.)
    mat_identity(part_m);
    for k in 0..16 landing_bones[GUY_BOARD * 16 + k] = part_m[k];
    rider_middle(landing_bones, 0)
}

// Where his trail hand holds the tail: so far along the board from its
// middle (its tip is 0.44), and the mitt's middle so far over the deck.
const GRAB_REACH: f32 = 0.4;

const GRAB_ABOVE: f32 = 0.06;

// (For the stage's measures: how far he is grabbing, and where the tail's
// tip his hand goes for is, in the world.)
posed_grab: f32 = 0.0;

posed_tail: V3 = V3 { x: 0.0, y: 0.0, z: 0.0 };

// His feet flat on the board, which is not square to him as he stands
// (see feel_ground), as far as he is on the ground: each ankle as high as
// the deck under it, and each foot tipped as the deck is.
on_board(
    a: *Anim,
    m: *Mover,
    st: Sides,
    p: *GuyPose
) {
    deck: V3 = root_dir(v_rotate(a.board_up, yaw_dir(m.heading), a.roll));
    // (Less as the deck turns away from under him, as in a flip, and not at
    // all past so far: all at once, his feet jumped.)
    w: f32 = (1.0 - a.air) * smoothstepf(0.3, 0.6, deck.y);
    if (w < 0.001) return;
    pitch: f32 = atan2f(-deck.z, deck.y);
    roll: f32 = atan2f(-deck.x, deck.y);
    for i in 0..2 {
        // (Not a pushing foot, off the deck.)
        wi: f32 = w;
        if (i == st.trail) wi = w * (1.0 - a.push_w);
        ankle: V3 = p.ankle[i];
        p.ankle[i].y = ankle.y + foot_lift(-(deck.x * ankle.x + deck.z * ankle.z) / deck.y) * wi;
        p.foot_pitch[i] = p.foot_pitch[i] + pitch * wi;
        p.foot_roll[i] = p.foot_roll[i] + roll * wi
    }
}

// How far a foot is lifted (or lowered) to lie on a deck tipped so as to
// lift it `lift`: so far, up to LIFT_EASY; past it, less and less, never
// past LIFT_MOST. (Crouched to pop up a kicker's steep ramp, the deck tipped
// steeply under him, the uphill foot was lifted further than his leg could
// bend: knee and ankle at the ends of their ranges, his hip swung about
// from frame to frame, and jumped as he took off.)
foot_lift(lift: f32): f32 {
    a: f32 = absf(lift);
    if (a <= LIFT_EASY) return lift;
    k: f32 = LIFT_MOST - LIFT_EASY;
    signf(lift) * (LIFT_EASY + k * tanhf_((a - LIFT_EASY) / k))
}

tanhf_(x: f32): f32 {
    e: f32 = expf(-2.0 * x);
    (1.0 - e) / (1.0 + e)
}

const LIFT_EASY: f32 = 0.08;

const LIFT_MOST: f32 = 0.2;

// A way in the world in his frame (root_m's: see from_root).
root_dir(w: V3): V3 {
    v3(w.x * root_m[0] + w.y * root_m[1] + w.z * root_m[2], w.x * root_m[4] + w.y * root_m[5] + w.z * root_m[6],
        w.x * root_m[8] + w.y * root_m[9] + w.z * root_m[10])
}

// A place in the world in his frame (root_m's: turned and moved, never
// scaled, so its transpose turns back).
from_root(w: V3): V3 {
    d: V3 = v3(w.x - root_m[12], w.y - root_m[13], w.z - root_m[14]);
    v3(d.x * root_m[0] + d.y * root_m[1] + d.z * root_m[2], d.x * root_m[4] + d.y * root_m[5] + d.z * root_m[6],
        d.x * root_m[8] + d.y * root_m[9] + d.z * root_m[10])
}

// Pushing (as far as a.push_w), drawn to read from behind him: the lead
// foot on the bolts, turned forward; the trail leg one long slab, its foot
// reaching down behind and beside the tail, its toe planted where it comes
// down in the world (the board carrying him on, the heel lifting as the
// leg sweeps back), up when the leg cannot reach it any longer, and back
// onto the board in a quick tuck. Keeps where the toe is planted, in the
// animation.
push_feet(a: *Anim, st: Sides, p: *GuyPose) {
    w: f32 = a.push_w;
    trail: int = st.trail;
    deck: V3 = p.ankle[trail];
    yaw: f32 = PUSH_FOOT_YAW * st.lead_x * DEG;
    // (His hips turn as far as his body: so that the pushing leg, planted
    // toward the tail, reaches out behind them, not in front.)
    p.hips_yaw = lerpf(p.hips_yaw, 1.0, a.push_in);
    // (Planting, he dips and leans a little into it.)
    phase0: f32 = push_phase(a);
    dip: f32 = 0.0;
    if (a.planted || phase0 >= PUSH_DOWN && !a.plant_done) dip = sinf(PI * clampf((phase0 - PUSH_DOWN) / 0.15,
        0.0, 1.0));
    p.body.drop = lerpf(p.body.drop, PUSH_DROP + 0.03 * dip, a.push_in);
    p.body.pitch = p.body.pitch + 6.0 * DEG * dip * a.push_in;
    // (Where the toe comes down: a little ahead of the hip, out past the
    // toe edge.)
    hip: V3 = guy_hip(p.body, p.hips_yaw, trail);
    toe: V3 = v3(hip.x + PUSH_PLANT_AHEAD * st.lead_x, -DECK_TOP, PUSH_PLANT_OUT);
    ankle_down: V3 = push_planted_ankle(toe, yaw);
    phase: f32 = push_phase(a);
    foot: V3 = deck;
    squash: f32 = PUSH_STRETCH;
    if (phase < PUSH_DOWN) {
        a.planted = false;
        a.plant_done = false;
        k: f32 = smoothstepf(0.0, PUSH_DOWN, phase);
        foot = v_lerp(deck, ankle_down, k);
        foot.y = foot.y + 0.05 * sinf(k * PI)
    } else if (!a.plant_done && !a.planted && a.air > 0.3) {
        // (Nothing is planted in the air: the foot reaches down no further.)
        foot = ankle_down
    } else if (!a.plant_done) {
        if (!a.planted) {
            a.planted = true;
            a.plant = mat_point(root_m, toe)
        }
        pinned: V3 = from_root(a.plant);
        // (Up once it is so far behind the hip, or the leg, stretched its
        // most, no longer reaches it.)
        foot = toe_pointed_ankle(pinned, hip, yaw);
        if ((pinned.x - hip.x) * st.lead_x < -PUSH_PLANT_BEHIND || v_len(v_sub(foot,
            hip)) > (GUY_THIGH + GUY_SHIN) * PUSH_STRETCH * 0.98) {
            a.planted = false;
            a.plant_done = true;
            a.lift_at = phase
        } else {
            // (The foot held as its shin has it, toe pointed: see
            // toe_pointed_ankle.)
            p.foot_pitch[trail] = toe_pointed_pitch(foot, hip, yaw);
            a.plant_pitch = p.foot_pitch[trail]
        }
    }
    if (a.plant_done) {
        // (Back up onto the board, over what is left of the stroke, in a
        // quick tuck: the leg squashed and its knee up for a moment.)
        // (The leg as long, and the foot as pointed, as they were as it came
        // up, easing into the tuck.)
        k: f32 = smoothstepf(maxf(a.lift_at, PUSH_DOWN), PUSH_STROKE, phase);
        foot = v_lerp(a.lift, deck, k);
        foot.y = foot.y + 0.12 * sinf(k * PI);
        squash = lerpf(a.plant_squash, lerpf(1.0, 0.75, sinf(k * PI)), smoothstepf(0.0,
            0.3, k));
        p.foot_pitch[trail] = a.plant_pitch * (1.0 - smoothstepf(0.0, 0.5, k))
    } else {
        // (Reaching down, and planted, the leg is one long slab: stretched
        // just as long as it must be to reach, so that its knee stays
        // nearly straight.)
        squash = clampf(v_len(v_sub(foot, hip)) / (GUY_THIGH + GUY_SHIN) * 1.004,
            1.0, PUSH_STRETCH);
        a.plant_squash = squash;
        if (!a.planted) a.plant_pitch = p.foot_pitch[trail]
    }
    p.ankle[trail] = v_lerp(deck, foot, w);
    p.foot_yaw[st.lead] = lerpf(p.foot_yaw[st.lead], PUSH_LEAD_YAW * st.lead_x * DEG,
        w);
    p.foot_yaw[trail] = lerpf(p.foot_yaw[trail], yaw, w);
    p.leg_squash[trail] = lerpf(p.leg_squash[trail], squash, w)
}

// The ankle of a nearly straight leg from `hip` whose toe is at `toe`, the
// foot rigid with the shin, toe pointed (the ankle at PUSH_POINT): so
// that the foot touches by its toe's edge and the shin's end stays inside
// the foot, however far the leg leans. (The shin taken along hip to
// ankle: the knee is all but straight.)
toe_pointed_ankle(toe: V3, hip: V3, yaw: f32): V3 {
    ankle: V3 = push_planted_ankle(toe, yaw);
    for _round in 0..4 {
        down: V3 = v_norm(v_sub(ankle, hip));
        fwd: V3 = v_norm(v_reject(yaw_dir(yaw), down));
        foot: V3 = toe_pointed_foot(down, yaw);
        foot_down: V3 = v_sub(v_scale(down, cosf(PUSH_POINT)), v_scale(fwd, sinf(PUSH_POINT)));
        ankle = v_sub(toe, v_add(v_scale(foot, GUY_FOOT_FRONT), v_scale(foot_down,
            GUY_ANKLE_UP)))
    }
    ankle
}

// The foot's pitch (+ toe up) toe pointed, its ankle at `ankle`, turned
// `yaw`.
toe_pointed_pitch(ankle: V3, hip: V3, yaw: f32): f32 {
    foot: V3 = toe_pointed_foot(v_norm(v_sub(ankle, hip)), yaw);
    atan2f(foot.y, sqrtf(foot.x * foot.x + foot.z * foot.z))
}

// The foot's forward, toe pointed, on a shin pointing `down`: square to it
// (in the plane of the way the foot turns), and turned PUSH_POINT toward
// it.
toe_pointed_foot(down: V3, yaw: f32): V3 {
    fwd: V3 = v_norm(v_reject(yaw_dir(yaw), down));
    v_add(v_scale(fwd, cosf(PUSH_POINT)), v_scale(down, sinf(PUSH_POINT)))
}

// The ankle over a pushing toe planted at `toe` (in his frame), the foot
// turned `yaw`, flat.
push_planted_ankle(toe: V3, yaw: f32): V3 {
    v_madd(v_madd(toe, Y_AXIS, GUY_ANKLE_UP), yaw_dir(yaw), -GUY_FOOT_FRONT)
}

// How far through its stroke a push is (s).
push_phase(a: *Anim): f32 {
    a.push_t - floorf(a.push_t / PUSH_STROKE) * PUSH_STROKE
}

size_m: []f32 = new f32[16](0.0);

// The board under him, at `contact`: on the ground, as the ground has it,
// rolled as he leans (see feel_ground); in the air, up under his soles
// (`soles`, in his frame), as far as `up`. Tipped up at
// its nose (+) by `tilt`, about its middle or (as far as tail_pivot) about
// its trailing wheels.
pose_board(
    a: *Anim,
    m: *Mover,
    contact: V3,
    spin: f32,
    soles: V3,
    up: f32,
    tilt: f32,
    tail_pivot: f32,
    turn: f32
) {
    rfwd: V3 = yaw_dir(a.board_yaw + spin);
    rup: V3 = a.board_up;
    // (Turned under him about his up.)
    if (absf(turn) > 0.0001) rfwd = v_rotate(rfwd, a.up, turn);
    // An ollie pops the nose.
    nose_up: f32 = tilt;
    if (m.since_hop < 0.35) nose_up = nose_up + sinf(m.since_hop / 0.35 * PI) * 0.35;
    if (absf(nose_up) > 0.0001) {
        r: V3 = v_cross(rup, rfwd);
        rfwd = v_rotate(rfwd, r, -nose_up);
        rup = v_rotate(rup, r, -nose_up)
    }
    rup = v_rotate(rup, yaw_dir(m.heading), a.roll);
    rpos: V3 = contact;
    // (Turned about its trailing wheels, it comes up as its middle does.)
    rpos.y = rpos.y + sinf(absf(tilt)) * STANCE_X * tail_pivot;
    frame_m(board_m, rfwd, rup, rpos);
    apply_tumble(board_m);
    // Its place, up with his feet: under his soles, which already turn with
    // any flip.
    if (up > 0.001) {
        under: V3 = mat_point(root_m, v3(0.0, soles.y - DECK_TOP, soles.z));
        board_m[12] = lerpf(board_m[12], under.x, up);
        board_m[13] = lerpf(board_m[13], under.y, up);
        board_m[14] = lerpf(board_m[14], under.z, up)
    }
}
