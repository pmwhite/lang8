tag profile_explorer;

use_tag std;

import "../../stdlib/print.l8";

import "trace.l8";

write_list(b: *ByteList) raises IoError {
    if (b.size <= len(b.data)) write_bytes_n(1, b.data, b.size)
}

// Prints the tracks and the names with the most self time, for scripts and tests.
trace_dump(t: *Trace, top: int) raises IoError {
    b: *ByteList = byte_list(256);
    if (t.perf) byte_text(b, "format: perf script\n") else byte_text(b, "format: trace events\n");
    byte_text(b, "events: ");
    byte_int(b, t.events.size);
    byte_text(b, """

tracks: """);
    byte_int(b, len(t.display));
    byte_text(b, """

duration: """);
    byte_time(b, t.end);
    byte_text(b, "\n");
    write_list(b);
    label: *ByteList = byte_list(64);
    tracks: *TrackList = t.tracks;
    display: []int = t.display;
    for k in 0..len(display) {
        track: int = display[k];
        if (track >= 0 && track < tracks.size && track < len(tracks.data)) {
            trace_track_label(t, track, label);
            b.size = 0;
            byte_text(b, "  ");
            byte_bytes(b, label.data, 0, label.size);
            byte_text(b, ": ");
            byte_int(b, tracks.data[track].events);
            byte_text(b, " events, depth ");
            byte_int(b, tracks.data[track].depth);
            byte_text(b, "\n");
            write_list(b)
        }
    }
    s: *Summary = summary_new(t, top);
    trace_summary(t, 0.0f64, t.end, trace_empty_bools, s);
    b.size = 0;
    byte_text(b, "self time:\n");
    top_names: []int = s.top;
    self: []f64 = s.self;
    for k in 0..s.count {
        if (k < len(top_names)) {
            name: int = top_names[k];
            if (name >= 0 && name < len(self)) {
                byte_text(b, "  ");
                byte_time(b, self[name]);
                byte_text(b, "  ");
                text: []i8 = trace_name(t, name);
                byte_bytes(b, text, 0, len(text));
                byte_text(b, "\n")
            }
        }
    }
    write_list(b)
}
