tag profile_explorer;

extern trace_storage_exit(code: int): noreturn = exit;

trace_storage_full(): noreturn {
    raw::raw_write(2, "profile-explorer: static storage exhausted\n");
    trace_storage_exit(1)
}

extern trace_bytes_at(p: *i8): []i8 = l8_as_int;

extern trace_ints_at(p: *int): []int = l8_as_int;

extern trace_empty_ints_at(p: *i8): []int = l8_as_int;

extern trace_bools_at(p: *i8): []bool = l8_as_int;

extern trace_floats_at(p: *i8): []f32 = l8_as_int;

extern trace_readonly(text: str): []i8 = l8_as_int;

extern trace_at(p: *i8): *Trace = l8_as_int;

extern trace_summary_at(p: *i8): *Summary = l8_as_int;

type TraceEmpty = {
    count: int;
    data: [8]i8
}

trace_empty: TraceEmpty = TraceEmpty { count: 0, data: zeroed([8]i8) };

trace_empty_ints: []int = trace_empty_ints_at(&trace_empty.data[0]);

trace_empty_bools: []bool = trace_bools_at(&trace_empty.data[0]);

trace_empty_floats: []f32 = trace_floats_at(&trace_empty.data[0]);

trace_one_zero: []int = static_buffer([1]int);

trace_owner: []i8 = static_buffer([256]i8);

trace_owner_live: bool = false;

trace_events: []TraceEvent = static_buffer([1048576]TraceEvent);

trace_tracks: []TraceTrack = static_buffer([8192]TraceTrack);

trace_event_value: EventList = EventList { data: trace_events, size: 0 };

trace_track_value: TrackList = TrackList { data: trace_tracks, size: 0 };

trace_string_items: [][]i8 = static_buffer(131072, "");

trace_string_table: []int = static_buffer([262144]int);

trace_strings_value: Strings = Strings { items: trace_string_items, count: 0, table: trace_string_table };

type TraceByteBuffer = {
    count: int;
    data: [65536]i8
}

trace_byte_buffers: []TraceByteBuffer = static_buffer([16]TraceByteBuffer);

trace_byte_lists: []ByteList = static_buffer(16, ByteList { data: "", size: 0 });

trace_byte_used: int = 0;

trace_byte_list(want: int): *ByteList {
    i: int = trace_byte_used;
    if (i >= 16 || want > 65536) trace_storage_full();
    trace_byte_used = i + 1;
    trace_byte_buffers[i].count = 65536;
    trace_byte_lists[i] = ByteList { data: trace_bytes_at(&trace_byte_buffers[i].data[0]), size: 0 };
    &trace_byte_lists[i]
}

type TraceIntBuffer = {
    count: int;
    data: [65536]int
}

trace_int_buffers: []TraceIntBuffer = static_buffer([8]TraceIntBuffer);

trace_int_lists: []IntList = static_buffer(8, IntList { data: trace_empty_ints, size: 0 });

trace_int_used: int = 0;

trace_int_list(want: int): *IntList {
    i: int = trace_int_used;
    if (i >= 8 || want > 65536) trace_storage_full();
    trace_int_used = i + 1;
    trace_int_buffers[i].count = 65536;
    trace_int_lists[i] = IntList { data: trace_ints_at(&trace_int_buffers[i].data[0]), size: 0 };
    &trace_int_lists[i]
}

type TraceWork = {
    count: int;
    data: [1048577]int
}

trace_work: []TraceWork = static_buffer([8]TraceWork);

trace_work_used: int = 0;

trace_work_ints(n: int): []int {
    if (n == 0) return trace_empty_ints;
    i: int = trace_work_used;
    if (i >= 8 || n < 0 || n > 1048577) trace_storage_full();
    trace_work_used = i + 1;
    trace_work[i].count = n;
    out: []int = trace_ints_at(&trace_work[i].data[0]);
    for k in 0..n out[k] = 0;
    out
}

type TraceSource = {
    count: int;
    data: [268435456]i8
}

trace_source: []TraceSource = static_buffer([1]TraceSource);

trace_summary_objects: []i8 = static_buffer([128]i8);

trace_summary_used: int = 0;

type TraceSelf = {
    count: int;
    data: [131072]f64
}

type TraceTop = {
    count: int;
    data: [128]int
}

trace_self_slots: []TraceSelf = static_buffer([2]TraceSelf);

trace_top_slots: []TraceTop = static_buffer([2]TraceTop);

extern trace_self_at(p: *f64): []f64 = l8_as_int;

trace_summary_self(i: int, n: int): []f64 {
    trace_self_slots[i].count = n;
    for k in 0..n trace_self_slots[i].data[k] = 0.0f64;
    trace_self_at(&trace_self_slots[i].data[0])
}

trace_summary_top(i: int, n: int): []int {
    trace_top_slots[i].count = n;
    for k in 0..n trace_top_slots[i].data[k] = 0;
    trace_ints_at(&trace_top_slots[i].data[0])
}

type TraceName32 = {
    count: int;
    data: [32]i8
}

trace_names_32: []TraceName32 = static_buffer([65536]TraceName32);

trace_names_32_used: int = 0;

type TraceName256 = {
    count: int;
    data: [256]i8
}

trace_names_256: []TraceName256 = static_buffer([65536]TraceName256);

trace_names_256_used: int = 0;

type TraceName4096 = {
    count: int;
    data: [4096]i8
}

trace_names_4096: []TraceName4096 = static_buffer([4096]TraceName4096);

trace_names_4096_used: int = 0;

type TraceName65536 = {
    count: int;
    data: [65536]i8
}

trace_names_65536: []TraceName65536 = static_buffer([128]TraceName65536);

trace_names_65536_used: int = 0;

trace_name_bytes(n: int): []i8 {
    if (n < 0) trace_storage_full();
    if (n == 0) return "";
    if (n <= 32) {
        i: int = trace_names_32_used;
        if (i >= 65536) trace_storage_full();
        trace_names_32_used = i + 1;
        trace_names_32[i].count = n;
        return trace_bytes_at(&trace_names_32[i].data[0])
    } else if (n <= 256) {
        i: int = trace_names_256_used;
        if (i >= 65536) trace_storage_full();
        trace_names_256_used = i + 1;
        trace_names_256[i].count = n;
        return trace_bytes_at(&trace_names_256[i].data[0])
    } else if (n <= 4096) {
        i: int = trace_names_4096_used;
        if (i >= 4096) trace_storage_full();
        trace_names_4096_used = i + 1;
        trace_names_4096[i].count = n;
        return trace_bytes_at(&trace_names_4096[i].data[0])
    } else if (n <= 65536) {
        i: int = trace_names_65536_used;
        if (i >= 128) trace_storage_full();
        trace_names_65536_used = i + 1;
        trace_names_65536[i].count = n;
        return trace_bytes_at(&trace_names_65536[i].data[0])
    }
    trace_storage_full()
}

// XStoreName consumes this text during the call; its storage is owned here.
type TraceWindowText = {
    count: int;
    data: [65537]i8
}

trace_window_title: TraceWindowText = TraceWindowText { count: 0, data: zeroed([65537]i8) };

extern trace_window_at(p: *i8): str = l8_as_int;

trace_window_text(bytes: []i8): str {
    n: int = len(bytes);
    if (n > 65536) trace_storage_full();
    trace_window_title.count = n;
    for k in 0..n {
        if (bytes[k] == 0i8) trace_storage_full();
        trace_window_title.data[k] = bytes[k]
    }
    trace_window_title.data[n] = 0i8;
    trace_window_at(&trace_window_title.data[0])
}

// Ends the one trace context. Every view, name and list from it expires here.
trace_release(_t: *Trace) {
    trace_owner_live = false;
    trace_byte_used = 0;
    trace_int_used = 0;
    trace_work_used = 0;
    trace_summary_used = 0;
    trace_names_32_used = 0;
    trace_names_256_used = 0;
    trace_names_4096_used = 0;
    trace_names_65536_used = 0
}
