// Port of blog/block-game.html. One binary, two sub-commands:
//   .build/block-game [play] [path]   play a world or a lone level
//   .build/block-game edit [path]     unified world/level editor
// Default path is programs/gl/world.txt. Arrows move, j picks a visited finish,
// Backspace undoes, Shift+Backspace restarts the room, and q quits.
import "gl.l8";

import "level.l8";

import "ft.l8";

import "block-game-play.l8";

import "block-game-editor.l8";

import "block-game-render.l8";

import "block-game-ui.l8";

main(argc: int, argv: [][z]i8): int {
    edit_mode: int = 0;
    path_i: int = 1;
    if (argc >= 2) {
        if (arg_eq(argv[1], "edit")) {
            edit_mode = 1;
            path_i = 2;
        } else if (arg_eq(argv[1], "play")) {
            path_i = 2;
        }
    }
    path: []i8 = level_path_at(argc, argv, path_i);
    empty: Block = Block {
        id: 0 - 1,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    src: []Block = new Block[2048](empty);
    empty_room: Room = Room {
        x0: 0,
        y0: 0,
        x1: 0,
        y1: 0
    };
    empty_goal: Goal = Goal { column: 0, row: 0 };
    empty_brick: Brick = Brick { column: 0, row: 0 };
    empty_ground: GroundCell = GroundCell {
        column: 0,
        row: 0,
        style: GROUND_DIRT,
        stone: 0
    };
    rooms: []Room = new Room[64](empty_room);
    titles: [][]i8 = new []i8[64](new i8[0](0i8));
    goals: []Goal = new Goal[64](empty_goal);
    bricks: []Brick = new Brick[2048](empty_brick);
    ground_cells: []GroundCell = new GroundCell[LEVEL_MAX_GROUND](empty_ground);
    nroom_slot: []int = new int[1](0);
    ngoal_slot: []int = new int[1](0);
    nbrick_slot: []int = new int[1](0);
    nground_slot: []int = new int[1](0);
    n: int = 0;
    nroom: int = 0;
    ngoal: int = 0;
    nbrick: int = 0;
    nground: int = 0;
    startp: []int = new int[2](0);
    room_sc: []int = new int[LEVEL_MAX_ROOMS](0);
    room_sr: []int = new int[LEVEL_MAX_ROOMS](0);
    room_has: []int = new int[LEVEL_MAX_ROOMS](0);
    is_world: int = 0;
    pnames: [][]i8 = new []i8[64](new i8[0](0i8));
    dones: [][]i8 = new []i8[64](new i8[0](0i8));
    ndone: int = 0;
    ndone_slot: []int = new int[1](0);
    solved: []int = new int[64](0);
    empty_spark: Spark = Spark {
        x: 0.0,
        y: 0.0,
        z: 0.0,
        vx: 0.0,
        vy: 0.0,
        vz: 0.0,
        life: 0.0,
        kind: 0,
        room: 0 - 1,
        blue: 0.0
    };
    sparks: []Spark = new Spark[SPARK_N](empty_spark);
    spark_rng: []int = new int[1](1);
    spark_acc: []f32 = new f32[3](0.0);
    finish_acc: []f32 = new f32[64](0.0);
    spark_xy: []int = new int[2](0);
    spark_last: []int = new int[1](0);
    stream_until: []int = new int[64](0);
    stream_tx: []f32 = new f32[64](0.0);
    stream_tz: []f32 = new f32[64](0.0);
    fd0: int = open_path(path, 0, 0);
    if (fd0 < 0) {
        if (edit_mode == 0) {
            write(2, "cannot load level ", len("cannot load level "));
            write(2, path, len(path));
            write(2, "\n", 1);
            return 1;
        }
        if (titles_eq(path, LEVEL_DEFAULT_PATH)) {
            is_world = 1;
        } else {
            nroom = set_room_size(rooms, titles, 0, 12, 9);
        }
        write(2, "new ", len("new "));
        write(2, path, len(path));
        write(2, "\n", 1);
    } else {
        close(fd0);
        raw: []i8 = slurp_path(path);
        if (looks_like_world(raw)) {
            is_world = 1;
            n = load_unified_world(path, pnames, rooms, titles, nroom_slot, src, goals,
                ngoal_slot, bricks, nbrick_slot, ground_cells, nground_slot, startp,
                dones, ndone_slot);
            if (n < 0) {
                write(2, "cannot load world ", len("cannot load world "));
                write(2, path, len(path));
                write(2, "\n", 1);
                return 1;
            }
            ndone = ndone_slot[0];
            nroom = nroom_slot[0];
            ngoal = ngoal_slot[0];
            nbrick = nbrick_slot[0];
            nground = nground_slot[0];
        } else {
            n = load_any(path, src, rooms, titles, nroom_slot, goals, ngoal_slot,
                bricks, nbrick_slot, ground_cells, nground_slot, startp);
            if (n < 0) {
                write(2, "cannot load level ", len("cannot load level "));
                write(2, path, len(path));
                write(2, "\n", 1);
                return 1;
            }
            nroom = nroom_slot[0];
            ngoal = ngoal_slot[0];
            nbrick = nbrick_slot[0];
            nground = nground_slot[0];
            if (nroom < 1) {
                nroom = set_room_size(rooms, titles, 0, 12, 9);
            }
        }
        apply_gravity(src, n);
        apply_solved(pnames, nroom, dones, ndone, solved, nroom);
    }
    prepare_room_starts(slurp_path(path), rooms, nroom, bricks, nbrick, goals, ngoal,
        room_sc, room_sr, room_has);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        write(2, "XOpenDisplay failed (need DISPLAY / XWayland)\n", len("XOpenDisplay failed (need DISPLAY / XWayland)\n"));
        return 1;
    }
    dpy: *i8 = d0;
    g_dpy = dpy;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 16i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) {
        die("glXChooseVisual failed");
    }
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163843,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    win_w: f32 = 1200.0;
    win_h: f32 = 720.0;
    win: int = XCreateWindow(dpy, root, 0, 0, 1200, 720, 0, vis.depth as int, 1, vis.visual,
        10248, &wa);
    if (win == 0) {
        die("XCreateWindow failed");
    }
    if (edit_mode != 0) {
        XStoreName(dpy, win, cstr("L8 level editor"));
    } else {
        XStoreName(dpy, win, cstr("L8 block game"));
    }
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, cstr("WM_DELETE_WINDOW"), 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    if (edit_mode != 0) {
        write(2, "L8 editor (keys on screen, q quits)\n", len("L8 editor (keys on screen, q quits)\n"));
    } else {
        write(2, "L8 block game (arrows move, j travels, Backspace undoes, Shift+Backspace restarts, q quits)\n",
            len("L8 block game (arrows move, j travels, Backspace undoes, Shift+Backspace restarts, q quits)\n"));
    }
    write(2, "level: ", len("level: "));
    write(2, path, len(path));
    write(2, "\n", 1);
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) {
        die("glXCreateContext failed");
    }
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) {
        die("glXMakeCurrent failed");
    }
    vsync: bool = set_vsync(dpy, win, true);
    vs: []i8 = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec3 vcol;
uniform mat4 vp;
uniform vec3 origin;
uniform vec3 scale;
uniform vec2 lag;
uniform vec2 ramp_up;
varying vec3 vworld;
varying vec3 vnrm;
varying vec3 vvcol;
void main() {
  vec3 lp = pos * scale;
  float sy = max(scale.y, 0.0001);
  float yb = lp.y + 0.5 * sy;
  float t = clamp(yb / sy, 0.0, 1.0);
  float extra = yb - t * sy;
  float L = length(lag);
  vec2 lg = lag * min(1.0, 0.18 / max(L, 0.0001));
  vec2 off = lg * (t * t);
  vec2 slope = lg * (0.7 * t);
  float ytilt = 0.0 - (lp.x * slope.x + lp.z * slope.y) / sy;
  vec3 spine = vec3(2.0 * t * lg.x, sy, 2.0 * t * lg.y);
  vec3 up = spine * inversesqrt(max(dot(spine, spine), 0.00000001));
  vec3 local = vec3(lp.x + off.x, 0.0 - 0.5 * sy + t * sy + ytilt, lp.z + off.y);
  local += up * extra;
  vec3 nn = nrm / scale;
  nn.x = nn.x - nn.y * slope.x / sy;
  nn.z = nn.z - nn.y * slope.y / sy;
  float ru2 = ramp_up.x * ramp_up.x + ramp_up.y * ramp_up.y;
  if (ru2 > 0.0001) {
    float amt = min(1.0, sqrt(ru2));
    vec2 r = ramp_up * inversesqrt(ru2);
    vec3 axis = vec3(0.0 - r.y, 0.0, r.x);
    float ca = cos(0.78539816 * amt);
    float sa = sin(0.78539816 * amt);
    local.y = local.y + 0.5 * sy * amt;
    vec3 v = local;
    local = v * ca + cross(axis, v) * sa + axis * dot(axis, v) * (1.0 - ca);
    vec3 nv = nn;
    nn = nv * ca + cross(axis, nv) * sa + axis * dot(axis, nv) * (1.0 - ca);
  }
  vec3 w = origin + local;
  gl_Position = vp * vec4(w, 1.0);
  vworld = w;
  vnrm = nn;
  vvcol = vcol;
}
""";
    fs: []i8 = """
#version 120
uniform vec3 color;
uniform vec3 light;
uniform mat4 light_vp;
uniform sampler2D shadow_map;
uniform sampler2D check_map;
uniform vec2 mask_origin;
uniform float ground;
uniform float cut;
uniform float brick;
uniform float fade;
varying vec3 vworld;
varying vec3 vnrm;
varying vec3 vvcol;
vec2 hash2(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
float sample_ground(vec2 cell) {
  vec2 tc = (cell - mask_origin + 0.5) / 256.0;
  if (tc.x < 0.0 || tc.x > 1.0 || tc.y < 0.0 || tc.y > 1.0) {
    return 0.0;
  }
  return texture2D(check_map, tc).r;
}
float grass_at(vec2 cell) {
  float r = sample_ground(cell);
  return step(0.15, r) * (1.0 - step(0.50, r)) + step(0.80, r);
}
float stone_at(vec2 cell) {
  return step(0.50, sample_ground(cell));
}
void main() {
  vec3 n = normalize(vnrm);
  vec3 albedo = color;
  if (ground > 0.5) {
    vec2 p = vworld.xz;
    vec2 cell = floor(p);
    vec2 f = fract(p);
    float ground_grass = grass_at(cell);
    float md = 8.0;
    float md2 = 8.0;
    vec2 mr = vec2(0.0);
    vec2 mc = cell;
    int j;
    int i;
    for (j = -1; j <= 1; j++) {
      for (i = -1; i <= 1; i++) {
        vec2 g = vec2(float(i), float(j));
        vec2 o = hash2(cell + g);
        vec2 r = g + o * 0.62 - f;
        float d = dot(r, r);
        if (d < md) {
          md2 = md;
          md = d;
          mr = r;
          mc = cell + g;
        } else if (d < md2) {
          md2 = d;
        }
      }
    }
    vec2 hv = hash2(mc);
    float edge = sqrt(md2) - sqrt(md);
    float stone_m = smoothstep(0.040, 0.155, edge) * stone_at(mc);
    vec3 stone = mix(vec3(0.38, 0.36, 0.33), vec3(0.48, 0.45, 0.41), hv.x);
    vec2 gv = hash2(floor(p * 9.0));
    stone *= 0.94 + 0.06 * gv.x;
    stone = mix(vec3(0.34, 0.36, 0.28), stone, smoothstep(0.08, 0.22, edge));
    vec2 gh = hash2(floor(p * 6.0 + 19.0));
    vec3 grass = mix(vec3(0.26, 0.30, 0.20), vec3(0.32, 0.35, 0.22), gh.x);
    grass *= 0.92 + 0.06 * gh.y;
    grass *= 0.83;
    vec3 dirt = mix(vec3(0.255, 0.205, 0.145), vec3(0.305, 0.250, 0.175), gh.x);
    dirt *= 0.91 + 0.08 * gh.y;
    albedo = dirt;
    if (ground_grass > 0.5) {
      albedo = grass;
    }
    albedo = mix(albedo, stone * mix(0.80, 0.86, stone_m), stone_m);
    n = normalize(mix(n, normalize(vec3(-mr.x, 0.78, -mr.y)), stone_m * 0.32));
  } else if (cut > 0.5) {
    vec3 an = abs(n);
    vec2 uv = vworld.xz;
    if (an.x > an.y && an.x > an.z) {
      uv = vworld.zy;
    } else if (an.z > an.y) {
      uv = vworld.xy;
    }
    float side = smoothstep(0.35, 0.70, 1.0 - an.y);
    float layer = hash2(vec2(floor(uv.y * 15.0), 3.7)).x;
    vec2 hp = hash2(floor(vworld.xy * 22.0) + floor(vworld.z * 22.0));
    vec2 hb = hash2(floor(vworld.xz + 0.02) + floor(vworld.y + 0.02) * 3.1);
    float pit = smoothstep(0.93, 0.99, hp.y);
    albedo = color * (0.93 + 0.08 * hb.x);
    albedo *= 0.94 + 0.06 * hp.x + 0.04 * layer * side;
    albedo *= 1.0 - 0.11 * pit;
    float cham = 1.0 - pow(max(an.x, max(an.y, an.z)), 6.0);
    albedo = mix(albedo, albedo * vec3(0.78, 0.90, 0.64), cham * 0.28);
    n = normalize(n + vec3(hp.x - 0.5, hp.y - 0.5, layer - 0.5) * 0.035);
  } else if (brick > 0.5) {
    vec3 an = abs(n);
    vec3 clay = vvcol;
    clay *= 0.96 + 0.04 * hash2(floor(vworld.xy * 22.0)).x;
    float cham = 1.0 - pow(max(an.x, max(an.y, an.z)), 6.0);
    albedo = mix(clay, clay * vec3(0.86, 0.90, 0.80), cham * 0.16);
    albedo *= 0.78;
  }
  vec3 toL = light - vworld;
  float dist = length(toL);
  vec3 L = toL / max(dist, 0.001);
  float ndl = max(dot(n, L), 0.0);
  float att = 1.0 / (1.0 + 0.01 * dist * dist);
  float vis = 1.0;
  vec4 sh = light_vp * vec4(vworld, 1.0);
  vec3 sc = sh.xyz / max(sh.w, 0.0001);
  if (sc.x > 0.01 && sc.x < 0.99 && sc.y > 0.01 && sc.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
    float bias = 0.0025 + 0.012 * (1.0 - ndl);
    float t = 0.00048828125;
    float s = 0.0;
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(-t, -t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(t, -t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(-t, t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(t, t)).r + bias);
    vis = s * 0.25;
  }
  float key = ndl * att * vis;
  float shade = 0.14 + 0.86 * key;
  vec3 lit = albedo * shade * vec3(1.68, 1.52, 1.26);
  lit += vec3(0.006, 0.005, 0.003) * (1.0 - smoothstep(0.0, 0.06, lit));
  lit = lit / (1.0 + max(lit - 1.10, 0.0));
  gl_FragColor = vec4(lit, fade);
}
""";
    dvs: []i8 = """
#version 120
attribute vec3 pos;
uniform mat4 vp;
uniform vec3 origin;
uniform vec3 scale;
uniform vec2 lag;
uniform vec2 ramp_up;
void main() {
  vec3 lp = pos * scale;
  float sy = max(scale.y, 0.0001);
  float yb = lp.y + 0.5 * sy;
  float t = clamp(yb / sy, 0.0, 1.0);
  float extra = yb - t * sy;
  float L = length(lag);
  vec2 lg = lag * min(1.0, 0.18 / max(L, 0.0001));
  vec2 off = lg * (t * t);
  vec2 slope = lg * (0.7 * t);
  float ytilt = 0.0 - (lp.x * slope.x + lp.z * slope.y) / sy;
  vec3 spine = vec3(2.0 * t * lg.x, sy, 2.0 * t * lg.y);
  vec3 up = spine * inversesqrt(max(dot(spine, spine), 0.00000001));
  vec3 local = vec3(lp.x + off.x, 0.0 - 0.5 * sy + t * sy + ytilt, lp.z + off.y);
  local += up * extra;
  float ru2 = ramp_up.x * ramp_up.x + ramp_up.y * ramp_up.y;
  if (ru2 > 0.0001) {
    float amt = min(1.0, sqrt(ru2));
    vec2 r = ramp_up * inversesqrt(ru2);
    vec3 axis = vec3(0.0 - r.y, 0.0, r.x);
    float ca = cos(0.78539816 * amt);
    float sa = sin(0.78539816 * amt);
    local.y = local.y + 0.5 * sy * amt;
    vec3 v = local;
    local = v * ca + cross(axis, v) * sa + axis * dot(axis, v) * (1.0 - ca);
  }
  vec3 w = origin + local;
  gl_Position = vp * vec4(w, 1.0);
}
""";
    dfs: []i8 = """
#version 120
void main() {
}
""";
    tvs: []i8 = """
#version 120
attribute vec2 pos;
attribute vec2 uv;
uniform vec2 screen;
varying vec2 vuv;
void main() {
  gl_Position = vec4(pos.x / screen.x * 2.0 - 1.0, 1.0 - pos.y / screen.y * 2.0, 0.0, 1.0);
  vuv = uv;
}
""";
    tfs: []i8 = """
#version 120
uniform sampler2D tex;
uniform vec3 color;
uniform float alpha;
varying vec2 vuv;
void main() {
  float a = texture2D(tex, vuv).r * alpha;
  if (a <= 0.02) discard;
  gl_FragColor = vec4(color, a);
}
""";
    grass_vs: []i8 = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec2 vcol;
uniform mat4 vp;
uniform vec2 grass_origin;
uniform vec2 focus;
uniform vec2 actor;
uniform vec2 motion;
uniform float time;
varying vec3 vworld;
varying vec3 vnrm;
varying float vroot;
varying float vrand;
varying float valive;
vec2 grass_hash(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
void main() {
  vec2 grid_base = grass_origin + vcol;
  vec2 seed = grass_hash(grid_base * 4.54545 + 17.0);
  vec2 base = grid_base + (seed - 0.5) * 0.13;
  float alive = 1.0;
  float angle = seed.x * 6.2831853;
  float ca = cos(angle);
  float sa = sin(angle);
  vec2 local_xz = vec2(pos.x * ca - pos.z * sa, pos.x * sa + pos.z * ca) * 1.12;
  float height = mix(0.24, 0.37, seed.y);
  float t = clamp(pos.y, 0.0, 1.1);
  vec2 actor_delta = base - actor;
  float actor_dist = length(actor_delta);
  float touch = 1.0 - smoothstep(0.30, 0.80, actor_dist);
  vec2 away = actor_delta / max(actor_dist, 0.001);
  float motion_len = length(motion);
  vec2 motion_dir = motion / max(motion_len, 0.001);
  float moving = smoothstep(0.012, 0.12, motion_len);
  vec2 wind_dir = normalize(vec2(0.82, 0.36));
  float wind = sin(dot(base, vec2(0.43, 0.31)) + time * 0.82 + seed.x * 5.0);
  vec2 bend = wind_dir * wind * 0.025;
  bend += away * touch * 0.15;
  bend += motion_dir * touch * moving * 0.075;
  bend *= t * t;
  vec3 w = vec3(base.x + local_xz.x + bend.x, -0.017 + pos.y * height,
                base.y + local_xz.y + bend.y);
  w.y = mix(-0.017, w.y, alive);
  vec2 rn = vec2(nrm.x * ca - nrm.z * sa, nrm.x * sa + nrm.z * ca);
  vnrm = normalize(vec3(rn.x - bend.x * 1.5, 0.16, rn.y - bend.y * 1.5));
  vworld = w;
  vroot = t;
  vrand = seed.y;
  valive = alive;
  gl_Position = vp * vec4(w, 1.0);
}
""";
    grass_fs: []i8 = """
#version 120
uniform vec3 light;
uniform mat4 light_vp;
uniform sampler2D shadow_map;
uniform sampler2D check_map;
uniform vec2 mask_origin;
varying vec3 vworld;
varying vec3 vnrm;
varying float vroot;
varying float vrand;
varying float valive;
vec2 hash2(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
float sample_ground(vec2 p) {
  vec2 tc = (p - mask_origin) / 256.0;
  if (tc.x < 0.0 || tc.x > 1.0 || tc.y < 0.0 || tc.y > 1.0) {
    return 0.0;
  }
  return texture2D(check_map, tc).r;
}
float grass_at(vec2 p) {
  float r = sample_ground(p);
  return step(0.15, r) * (1.0 - step(0.50, r)) + step(0.80, r);
}
float stone_at(vec2 p) {
  return step(0.50, sample_ground(p));
}
float stone_cover(vec2 p) {
  vec2 cell = floor(p);
  vec2 f = fract(p);
  float md = 8.0;
  float md2 = 8.0;
  vec2 mc = cell;
  int j;
  int i;
  for (j = -1; j <= 1; j++) {
    for (i = -1; i <= 1; i++) {
      vec2 g = vec2(float(i), float(j));
      vec2 o = hash2(cell + g);
      vec2 r = g + o * 0.62 - f;
      float d = dot(r, r);
      if (d < md) {
        md2 = md;
        md = d;
        mc = cell + g;
      } else if (d < md2) {
        md2 = d;
      }
    }
  }
  float edge = sqrt(md2) - sqrt(md);
  return smoothstep(0.040, 0.155, edge) * stone_at(mc + 0.5);
}
void main() {
  if (valive < 0.5) {
    discard;
  }
  vec2 grass_cell = floor(vworld.xz);
  vec2 in_cell = fract(vworld.xz);
  if (grass_at(grass_cell + 0.5) < 0.5) {
    discard;
  }
  float edge_distance = 1.0;
  if (grass_at(grass_cell + vec2(-0.5, 0.5)) < 0.5) {
    edge_distance = min(edge_distance, in_cell.x);
  }
  if (grass_at(grass_cell + vec2(1.5, 0.5)) < 0.5) {
    edge_distance = min(edge_distance, 1.0 - in_cell.x);
  }
  if (grass_at(grass_cell + vec2(0.5, -0.5)) < 0.5) {
    edge_distance = min(edge_distance, in_cell.y);
  }
  if (grass_at(grass_cell + vec2(0.5, 1.5)) < 0.5) {
    edge_distance = min(edge_distance, 1.0 - in_cell.y);
  }
  float grass_amount = smoothstep(0.0, 1.0, edge_distance);
  grass_amount *= 1.0 - stone_cover(vworld.xz);
  if (vroot > grass_amount || vrand > grass_amount) {
    discard;
  }
  vec3 root_color = vec3(0.165, 0.190, 0.100);
  vec3 tip_color = vec3(0.285, 0.320, 0.175);
  vec3 albedo = mix(root_color, tip_color, smoothstep(0.0, 0.82, vroot));
  albedo *= 0.92 + 0.12 * vrand;
  albedo += vec3(0.018, 0.022, 0.006) * smoothstep(0.70, 1.0, vroot);
  vec3 toL = light - vworld;
  float dist = length(toL);
  vec3 L = toL / max(dist, 0.001);
  vec3 n = normalize(vnrm);
  float ndl = abs(dot(n, L));
  float back = max(dot(0.0 - n, L), 0.0);
  float att = 1.0 / (1.0 + 0.01 * dist * dist);
  float vis = 1.0;
  vec4 sh = light_vp * vec4(vworld, 1.0);
  vec3 sc = sh.xyz / max(sh.w, 0.0001);
  if (sc.x > 0.01 && sc.x < 0.99 && sc.y > 0.01 && sc.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
    vis = step(sc.z, texture2D(shadow_map, sc.xy).r + 0.004);
  }
  float key = ndl * att * vis;
  float shade = 0.14 + 0.74 * key;
  shade += 0.055 * back * smoothstep(0.38, 1.0, vroot);
  vec3 lit = albedo * shade * vec3(1.62, 1.46, 1.22);
  lit += vec3(0.006, 0.005, 0.003) * (1.0 - smoothstep(0.0, 0.06, lit));
  gl_FragColor = vec4(lit, 1.0);
}
""";
    prog: int = link_program(vs, fs, "nrm");
    dprog: int = link_program(dvs, dfs, "nrm");
    tprog: int = link_program(tvs, tfs, "uv");
    grass_prog: int = link_program(grass_vs, grass_fs, "nrm");
    gvs: []i8 = """
#version 120
attribute vec2 pos;
uniform vec2 screen;
void main() {
  gl_Position = vec4(pos.x / screen.x * 2.0 - 1.0, 1.0 - pos.y / screen.y * 2.0, 0.0, 1.0);
}
""";
    gfs: []i8 = """
#version 120
uniform vec3 color;
uniform float alpha;
void main() {
  gl_FragColor = vec4(color, alpha);
}
""";
    gprog: int = link_program(gvs, gfs, "uv");
    bvs: []i8 = """
#version 120
attribute vec3 pos;
uniform mat4 vp;
uniform vec3 origin;
uniform vec3 scale;
uniform vec3 cam_right;
uniform vec3 cam_up;
varying vec2 vuv;
varying vec3 vseed;
varying vec3 vworld;
void main() {
  vuv = pos.xy;
  vseed = origin;
  vec3 w = origin + cam_right * pos.x * scale.x + cam_up * pos.y * scale.y;
  vworld = w;
  gl_Position = vp * vec4(w, 1.0);
}
""";
    bfs: []i8 = """
#version 120
uniform vec3 color;
uniform vec3 light;
uniform mat4 light_vp;
uniform sampler2D shadow_map;
uniform vec3 cam_right;
uniform vec3 cam_up;
uniform vec3 cam_toward;
uniform float time;
varying vec2 vuv;
varying vec3 vseed;
varying vec3 vworld;
void main() {
  float h = fract(sin(dot(vseed.xz, vec2(12.9898, 78.233))) * 43758.5453);
  float r = length(vuv);
  if (r > 1.0) {
    discard;
  }
  float core = exp(-r * r * 14.0);
  float halo = exp(-r * r * 3.2);
  float pulse = 0.80 + 0.20 * sin(time * (1.35 + 0.90 * h) + h * 11.0);
  float vis = 1.0;
  vec4 sh = light_vp * vec4(vworld, 1.0);
  vec3 sc = sh.xyz / max(sh.w, 0.0001);
  if (sc.x > 0.01 && sc.x < 0.99 && sc.y > 0.01 && sc.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
    float bias = 0.004;
    float t = 0.00048828125;
    float s = 0.0;
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(-t, -t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(t, -t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(-t, t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(t, t)).r + bias);
    vis = s * 0.25;
  }
  vec3 toL = light - vworld;
  float dist = length(toL);
  vec3 L = toL / max(dist, 0.001);
  vec3 nw = normalize(cam_right * vuv.x + cam_up * vuv.y + cam_toward * (1.0 - r));
  float ndl = max(dot(nw, L), 0.0);
  float lit = 0.28 + 0.72 * vis * (0.72 + 0.28 * ndl);
  float glow = core * 0.80 + halo * 0.58;
  vec3 rgb = color * glow * lit * pulse;
  float a = (core * 0.50 + halo * 0.32) * pulse;
  gl_FragColor = vec4(rgb, a);
}
""";
    bdfs: []i8 = """
#version 120
varying vec2 vuv;
void main() {
  if (dot(vuv, vuv) > 0.36) {
    discard;
  }
}
""";
