    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    cube: []f32 = new f32[216](0.0);
    cube_n: int = fill_cube(cube);
    chamfer: []f32 = new f32[2200](0.0);
    chamfer_n: int = fill_chamfer_cube(chamfer);
    ids: []u32 = new u32[5](0u32);
    glGenBuffers(5, ids);
    glBindBuffer(34962, ids[0]);
    glBufferData(34962, cube_n * 4, cube, 35044);
    grass_ids: []u32 = new u32[2](0u32);
    glGenBuffers(2, grass_ids);
    grass_blades: []f32 = new f32[1024](0.0);
    grass_blade_n: int = fill_grass_blades(grass_blades);
    glBindBuffer(34962, grass_ids[0]);
    glBufferData(34962, grass_blade_n * 4, grass_blades, 35044);
    grass_instances: []f32 = new f32[GRASS_NX * GRASS_NZ * 2](0.0);
    grass_instance_n: int = fill_grass_instances(grass_instances);
    glBindBuffer(34962, grass_ids[1]);
    glBufferData(34962, grass_instance_n * 4, grass_instances, 35044);
    bubble: []f32 = new f32[36](0.0);
    bubble_n: int = fill_bubble_quad(bubble);
    bbuf: []u32 = new u32[1](0u32);
    glGenBuffers(1, bbuf);
    glBindBuffer(34962, bbuf[0]);
    glBufferData(34962, bubble_n * 4, bubble, 35044);
    glBindBuffer(34962, ids[2]);
    glBufferData(34962, chamfer_n * 4, chamfer, 35044);
    wall_verts: []f32 = new f32[7000000](0.0);
    brick_used: []int = new int[2048](0);
    brick_n: int = upload_brick_mesh(ids[4], wall_verts, chamfer, bricks, nbrick, brick_used);
    ramps: []f32 = new f32[8800](0.0);
    rd0: int = 1;
    while (rd0 <= 4) {
        rn0: int = fill_chamfer_ramp(chamfer, rd0);
        rj: int = 0;
        while (rj < rn0) {
            ramps[(rd0 - 1) * chamfer_n + rj] = chamfer[rj];
            rj = rj + 1;
        }
        rd0 = rd0 + 1;
    }
    glBindBuffer(34962, ids[3]);
    glBufferData(34962, chamfer_n * 16, ramps, 35044);
    bind_mesh(ids[0]);
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(1);
    tbuf: []u32 = new u32[1](0u32);
    glGenBuffers(1, tbuf);
    gbuf: []u32 = new u32[1](0u32);
    glGenBuffers(1, gbuf);
    ftex: []u32 = new u32[1](0u32);
    glGenTextures(1, ftex);
    if (font.ok != 0) {
        glBindTexture(3553, ftex[0]);
        glPixelStorei(3317, 1);
        glTexParameteri(3553, 10241, 9729);
        glTexParameteri(3553, 10240, 9729);
        glTexParameteri(3553, 10242, 33071);
        glTexParameteri(3553, 10243, 33071);
        glTexImage2D(3553, 0, 6409, font.w, font.h, 0, 6409, 5121, font.atlas);
    }
    htex: []u32 = new u32[1](0u32);
    glGenTextures(1, htex);
    if (hud.ok != 0) {
        glBindTexture(3553, htex[0]);
        glPixelStorei(3317, 1);
        glTexParameteri(3553, 10241, 9728);
        glTexParameteri(3553, 10240, 9728);
        glTexParameteri(3553, 10242, 33071);
        glTexParameteri(3553, 10243, 33071);
        glTexImage2D(3553, 0, 6409, hud.w, hud.h, 0, 6409, 5121, hud.atlas);
    }
    glEnable(2929);
    stex: []u32 = new u32[1](0u32);
    glGenTextures(1, stex);
    glBindTexture(3553, stex[0]);
    glTexParameteri(3553, 10241, 9728);
    glTexParameteri(3553, 10240, 9728);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 33190, SHADOW_SIZE, SHADOW_SIZE, 0, 6402, 5125, null);
    ctex: []u32 = new u32[1](0u32);
    cmask: []i8 = new i8[65536](0i8);
    glGenTextures(1, ctex);
    glBindTexture(3553, ctex[0]);
    glTexParameteri(3553, 10241, 9728);
    glTexParameteri(3553, 10240, 9728);
    glTexParameteri(3553, 10242, 33071);
    glTexParameteri(3553, 10243, 33071);
    glTexImage2D(3553, 0, 6409, MASK_SIZE, MASK_SIZE, 0, 6409, 5121, cmask);
    fbos: []u32 = new u32[1](0u32);
    glGenFramebuffers(1, fbos);
    glBindFramebuffer(36160, fbos[0]);
    glFramebufferTexture2D(36160, 36096, 3553, stex[0], 0);
    glDrawBuffer(0);
    glReadBuffer(0);
    if (glCheckFramebufferStatus(36160) != 36053) {
        die("shadow framebuffer incomplete");
    }
    glBindFramebuffer(36160, 0u32);
    glViewport(0, 0, 1200, 720);
    glClearColor(0.18, 0.16, 0.15, 1.0);
    glClear(16640);
    glXSwapBuffers(dpy, win);
    proj: []f32 = new f32[16](0.0);
    view: []f32 = new f32[16](0.0);
    vp: []f32 = new f32[16](0.0);
    mtmp: []f32 = new f32[16](0.0);
    lproj: []f32 = new f32[16](0.0);
    lview: []f32 = new f32[16](0.0);
    lcam: []f32 = new f32[16](0.0);
    lvp: []f32 = new f32[16](0.0);
    lbias: []f32 = new f32[16](0.0);
    mat_persp(proj, 2.1445, win_w / win_h, 0.4, 80.0);
    mat_persp(lproj, 0.7, 1.0, 1.5, 50.0);
    mat_bias(lbias);
    blocks: []Block = new Block[2048](empty);
    copy_blocks(blocks, 0, src, 0, n);
    shape_verts: []f32 = new f32[2200](0.0);
    lagx: []f32 = new f32[1024](0.0);
    lagz: []f32 = new f32[1024](0.0);
    ev: XEvent = XEvent.Other;
    running: int = 1;
    alive: int = 1;
    shift: int = 0;
    fps: FpsMeter = FpsMeter {
        on: 0,
        i: 0,
        n: 0,
        work0: 0,
        flo: 0.0,
        fhi: 0.0,
        mlo: 0.0,
        mhi: 0.0,
        f_step: 0.0,
        m_step: 0.0,
        h_step: 0.0,
        x_step: 0.0,
        hlo: 0.0,
        hhi: 0.0
    };
    fps_t: []int = new int[FPS_CAP](0);
    fps_work: []int = new int[FPS_CAP](0);
    fps_rate: []f32 = new f32[FPS_CAP](0.0);
    fps_mem: []int = new int[FPS_CAP](0);
    fps_lab: []i8 = new i8[24](0i8);
    present_us: []int = new int[1](0);
    mask_cache: []int = new int[3](0);
    mask_cache[0] = 0 - 999999;
    prep_cache: []int = new int[8](0);
    lean_to: []int = new int[2048](0);
    lean_from: []int = new int[2048](0);
    id_to: []int = new int[4096](0);
    id_from: []int = new int[4096](0);
    cell_head: []int = new int[4096](0);
    cell_link: []int = new int[2048](0);
    col_body: []int = new int[8](0);
    col_ramp: []int = new int[8](0);
    if (edit_mode != 0) {
        cc: int = 0;
        cr: int = 0;
        cl: int = 0;
        apply_gravity(blocks, n);
        cl = cursor_layer_at(blocks, n, cc, cr);
        dirty_level: int = 0;
        dirty_world: int = 0;
        need_mesh: int = 0;
        counts: []int = new int[5](0);
        xy: []int = new int[2](0);
        focus_x: f32 = 0.5;
        focus_z: f32 = 0.5;
        ground_brush: int = GROUND_DIRT;
        paint_anchor: int = 0;
        paint_c: int = 0;
        paint_r: int = 0;
        name_mode: int = 0;
        new_name: []i8 = "";
        name_error: []i8 = "";
        key_text: []i8 = new i8[8](0i8);
        move_mode: int = 0;
        move_sel: int = 0 - 1;
        move_dc: int = 0;
        move_dr: int = 0;
        move_rot: int = 0;
        move_ok: int = 1;
        move_cursor_c: int = 0;
        move_cursor_r: int = 0;
        move_blocks: []Block = new Block[LEVEL_MAX_BLOCKS](empty);
        move_rooms: []Room = new Room[LEVEL_MAX_ROOMS](empty_room);
        move_goals: []Goal = new Goal[LEVEL_MAX_GOALS](empty_goal);
        move_bricks: []Brick = new Brick[LEVEL_MAX_BRICKS](empty_brick);
        move_ground: []GroundCell = new GroundCell[LEVEL_MAX_GROUND](empty_ground);
        move_start: []int = new int[2](0);
        move_counts: []int = new int[4](0);
        help1: []i8 = "";
        help2: []i8 = "";
        held_l: int = 0;
        held_r: int = 0;
        held_u: int = 0;
        held_d: int = 0;
        held_w: int = 0;
        need_step: int = 0;
        step_dc: int = 0;
        step_dr: int = 0;
        arrow_t0: int = 0;
        arrow_last: int = 0;
        while (running != 0) {
            need_step = 0;
            step_dc = 0;
            step_dr = 0;
            while (XPending(dpy) != 0) {
                XNextEvent(dpy, &ev);
                match ev {
                    KeyPress -> {
                        ks: int = XLookupKeysym(&ev, 0);
                        if (move_mode != 0) {
                            changed: int = 0;
                            if (ks == 65307) {
                                copy_blocks(blocks, 0, move_blocks, 0, move_counts[0]);
                                copy_rooms(rooms, move_rooms, nroom);
                                copy_goals(goals, move_goals, move_counts[1]);
                                copy_bricks(bricks, move_bricks, move_counts[2]);
                                copy_ground(ground_cells, move_ground, move_counts[3]);
                                n = move_counts[0];
                                ngoal = move_counts[1];
                                nbrick = move_counts[2];
                                nground = move_counts[3];
                                startp[0] = move_start[0];
                                startp[1] = move_start[1];
                                cc = move_cursor_c;
                                cr = move_cursor_r;
                                move_mode = 0;
                                prep_cache[7] = 0;
                                mask_cache[0] = 0 - 999999;
                                need_mesh = 1;
                            } else if (ks == 65293 || ks == 65421) {
                                if (move_ok != 0) {
                                    copy_blocks(blocks, 0, move_blocks, 0, move_counts[0]);
                                    copy_rooms(rooms, move_rooms, nroom);
                                    copy_goals(goals, move_goals, move_counts[1]);
                                    copy_bricks(bricks, move_bricks, move_counts[2]);
                                    copy_ground(ground_cells, move_ground, move_counts[3]);
                                    n = move_counts[0];
                                    ngoal = move_counts[1];
                                    nbrick = move_counts[2];
                                    nground = move_counts[3];
                                    startp[0] = move_start[0];
                                    startp[1] = move_start[1];
                                    old_room: Room = move_rooms[move_sel];
                                    new_room: Room = transform_room_rect(old_room, move_dc, move_dr,
                                        move_rot);
                                    clear_room_destination(blocks, n, goals, ngoal, bricks, nbrick,
                                        ground_cells, nground, old_room, new_room, move_counts);
                                    n = move_counts[0];
                                    ngoal = move_counts[1];
                                    nbrick = move_counts[2];
                                    nground = move_counts[3];
                                    transform_room_contents(blocks, n, goals, ngoal, bricks, nbrick,
                                        ground_cells, nground, rooms, move_sel, move_dc, move_dr,
                                        move_rot, startp, xy);
                                    dirty_world = 1;
                                    move_mode = 0;
                                    prep_cache[7] = 0;
                                    mask_cache[0] = 0 - 999999;
                                    need_mesh = 1;
                                    clear_sparks(sparks);
                                }
                            } else if (ks == 65361) {
                                move_dc = move_dc - 1;
                                cc = cc - 1;
                                changed = 1;
                            } else if (ks == 65363) {
                                move_dc = move_dc + 1;
                                cc = cc + 1;
                                changed = 1;
                            } else if (ks == 65362) {
                                move_dr = move_dr - 1;
                                cr = cr - 1;
                                changed = 1;
                            } else if (ks == 65364) {
                                move_dr = move_dr + 1;
                                cr = cr + 1;
                                changed = 1;
                            } else if (ks == 111 || ks == 79) {
                                move_rot = (move_rot + 1) % 4;
                                changed = 1;
                            }
                            if (changed != 0) {
                                candidate: Room = transform_room_rect(move_rooms[move_sel], move_dc,
                                    move_dr, move_rot);
                                move_ok = 0;
                                if (in_bounds(candidate.x0, candidate.y0) &&
                                    in_bounds(candidate.x1, candidate.y1) &&
                                    room_overlaps_other(move_rooms, nroom, move_sel, candidate) == 0) {
                                    move_ok = 1;
                                }
                                preview_room_transform(move_blocks, move_counts[0], move_rooms,
                                    nroom, move_goals, move_counts[1], move_bricks, move_counts[2],
                                    move_ground, move_counts[3], move_start, blocks, rooms, goals,
                                    bricks, ground_cells, startp, move_sel, move_dc, move_dr,
                                    move_rot, xy);
                                prep_cache[7] = 0;
                                mask_cache[0] = 0 - 999999;
                                need_mesh = 1;
                            }
                        } else if (name_mode != 0) {
                            if (ks == 65307) {
                                name_mode = 0;
                                new_name = "";
                                name_error = "";
                            } else if (ks == 65288) {
                                new_name = text_pop(new_name);
                                name_error = "";
                            } else if (ks == 65293 || ks == 65421) {
                                want: Room = Room {
                                    x0: cc,
                                    y0: cr,
                                    x1: cc + 11,
                                    y1: cr + 8
                                };
                                if (nroom >= LEVEL_MAX_ROOMS) {
                                    name_error = "world is full";
                                } else if (valid_level_name(new_name) == 0) {
                                    name_error = "use lowercase letters, numbers, and -";
                                } else if (name_listed(pnames, nroom, new_name) != 0) {
                                    name_error = "that level already exists";
                                } else if (!in_bounds(want.x0, want.y0) ||
                                    !in_bounds(want.x1, want.y1)) {
                                    name_error = "that boundary is outside the world";
                                } else if (room_overlaps_other(rooms, nroom, 0 - 1, want) != 0) {
                                    name_error = "that boundary overlaps another level";
                                } else {
                                    pnames[nroom] = new_name;
                                    solved[nroom] = 0;
                                    nroom = add_room(rooms, titles, nroom, want.x0, want.y0,
                                        want.x1, want.y1, new_name);
                                    dirty_world = 1;
                                    paint_anchor = 0;
                                    name_mode = 0;
                                    name_error = "";
                                }
                            } else {
                                key_text[0] = 0i8;
                                got: int = XLookupString(&ev, key_text, len(key_text), null, null);
                                if (got > 0 && len(new_name) < 40) {
                                    ch: i8 = key_text[0];
                                    if (ch >= 'A' && ch <= 'Z') {
                                        ch = ch + 32i8;
                                    }
                                    if ((ch >= 'a' && ch <= 'z') ||
                                        (ch >= '0' && ch <= '9') || ch == '-') {
                                        new_name = text_push(new_name, ch);
                                        name_error = "";
                                    }
                                }
                            }
                        } else if (ks == 65505 || ks == 65506) {
                            shift = 1;
                        } else if (ks == 102 || ks == 70) {
                            ground_brush = (ground_brush + 1) % 3;
                        } else if (is_fps_key(ks) != 0) {
                            fps = toggle_fps(fps);
                        } else if (is_vsync_key(ks) != 0) {
                            vsync = set_vsync(dpy, win, 1 - vsync);
                        } else if (ks == 113 || ks == 81) {
                            running = 0;
                        } else if (ks == 65307) {
                            paint_anchor = 0;
                        } else if (ks == 32) {
                            if (shift != 0) {
                                paint_anchor = 1;
                                paint_c = cc;
                                paint_r = cr;
                            } else {
                                c0: int = cc;
                                r0: int = cr;
                                if (paint_anchor != 0) {
                                    c0 = paint_c;
                                    r0 = paint_r;
                                }
                                if (is_world != 0) {
                                    nground = paint_ground_rect(ground_cells, nground, c0, r0, cc,
                                        cr, ground_brush, 0);
                                    dirty_world = 1;
                                    mask_cache[0] = 0 - 999999;
                                } else {
                                    nground = paint_ground_rect(ground_cells, nground, c0, r0, cc,
                                        cr, ground_brush, 0);
                                    dirty_level = 1;
                                    mask_cache[0] = 0 - 999999;
                                }
                                paint_anchor = 0;
                            }
                        } else if (ks == 65361 || ks == 65362 || ks == 65363 || ks == 65364) {
                            is_rep: int = 0;
                            if (ks == 65361 && held_l != 0) {
                                is_rep = 1;
                            }
                            if (ks == 65363 && held_r != 0) {
                                is_rep = 1;
                            }
                            if (ks == 65362 && held_u != 0) {
                                is_rep = 1;
                            }
                            if (ks == 65364 && held_d != 0) {
                                is_rep = 1;
                            }
                            if (ks == 65361) {
                                held_l = 1;
                            }
                            if (ks == 65363) {
                                held_r = 1;
                            }
                            if (ks == 65362) {
                                held_u = 1;
                            }
                            if (ks == 65364) {
                                held_d = 1;
                            }
                            if (is_rep == 0) {
                                need_step = 1;
                                arrow_t0 = mono_ms();
                                arrow_last = arrow_t0;
                                if (ks == 65361) {
                                    step_dc = 0 - 1;
                                    step_dr = 0;
                                } else if (ks == 65363) {
                                    step_dc = 1;
                                    step_dr = 0;
                                } else if (ks == 65362) {
                                    step_dc = 0;
                                    step_dr = 0 - 1;
                                } else {
                                    step_dc = 0;
                                    step_dr = 1;
                                }
                            }
                        } else if (is_world != 0) {
                            sel: int = room_at(rooms, nroom, cc, cr);
                            if (ks == 109 || ks == 77) {
                                if (sel >= 0 && sel < nroom) {
                                    copy_blocks(move_blocks, 0, blocks, 0, n);
                                    copy_rooms(move_rooms, rooms, nroom);
                                    copy_goals(move_goals, goals, ngoal);
                                    copy_bricks(move_bricks, bricks, nbrick);
                                    copy_ground(move_ground, ground_cells, nground);
                                    move_counts[0] = n;
                                    move_counts[1] = ngoal;
                                    move_counts[2] = nbrick;
                                    move_counts[3] = nground;
                                    move_start[0] = startp[0];
                                    move_start[1] = startp[1];
                                    move_sel = sel;
                                    move_cursor_c = cc;
                                    move_cursor_r = cr;
                                    move_dc = 0;
                                    move_dr = 0;
                                    move_rot = 0;
                                    move_ok = 1;
                                    move_mode = 1;
                                    paint_anchor = 0;
                                }
                            } else if (ks == 110 || ks == 78) {
                                name_mode = 1;
                                new_name = "";
                                name_error = "";
                            } else if (ks == 98 || ks == 66) {
                                wl: int = free_layer_at(blocks, n, cc, cr, 0);
                                wn2: int = add_block_at(blocks, n, cc, cr, wl, 0, 0);
                                if (wn2 != n) {
                                    n = wn2;
                                    apply_gravity(blocks, n);
                                    dirty_world = 1;
                                }
                            } else if (ks == 114 || ks == 82) {
                                wt: int = highest_layer_at(blocks, n, cc, cr);
                                wi: int = 0 - 1;
                                if (wt >= 0) {
                                    wi = block_at_layer(blocks, n, cc, cr, wt);
                                }
                                if (wi >= 0 && blocks[wi].ramp != 0) {
                                    n = toggle_ramp(blocks, n, cc, cr, wt);
                                    apply_gravity(blocks, n);
                                    dirty_world = 1;
                                } else {
                                    wl: int = free_layer_at(blocks, n, cc, cr, 0);
                                    wn2: int = add_block_at(blocks, n, cc, cr, wl, 0, 1);
                                    if (wn2 != n) {
                                        n = wn2;
                                        apply_gravity(blocks, n);
                                        dirty_world = 1;
                                    }
                                }
                            } else if (ks == 119 || ks == 87) {
                                if (held_w == 0) {
                                    held_w = 1;
                                    nbrick = toggle_brick(bricks, nbrick, cc, cr);
                                    dirty_world = 1;
                                    need_mesh = 1;
                                }
                            } else if (ks == 99 || ks == 67) {
                                if (sel >= 0) {
                                    ngoal = toggle_goal(goals, ngoal, cc, cr);
                                    dirty_world = 1;
                                }
                            } else if (ks == 51 || ks == 52 || ks == 53 || ks == 54 || ks == 55) {
                                sh: int = ks - 48;
                                if (ks == 55) {
                                    sh = 15;
                                }
                                wl: int = free_layer_at(blocks, n, cc, cr, 0);
                                wn2: int = add_block_at(blocks, n, cc, cr, wl, sh, 0);
                                if (wn2 != n) {
                                    n = wn2;
                                    apply_gravity(blocks, n);
                                    dirty_world = 1;
                                }
                            } else if (ks == 120 || ks == 88 || ks == 65288) {
                                wn0: int = n;
                                n = erase_top_at(blocks, n, cc, cr);
                                if (wn0 == n && is_brick(bricks, nbrick, cc, cr)) {
                                    nbrick = toggle_brick(bricks, nbrick, cc, cr);
                                    need_mesh = 1;
                                }
                                dirty_world = 1;
                            } else if (ks == 65535) {
                                if (sel >= 0 && sel < nroom) {
                                    solved[sel] = solved[nroom - 1];
                                    nroom = delete_level_boundary(rooms, titles, pnames, nroom, sel);
                                    dirty_world = 1;
                                }
                            } else if (ks == 91 || ks == 93 || ks == 59 || ks == 39) {
                                if (sel >= 0 && sel < nroom) {
                                    want: Room = rooms[sel];
                                    if (ks == 91 && want.x1 > want.x0) {
                                        want.x1 = want.x1 - 1;
                                    } else if (ks == 93) {
                                        want.x1 = want.x1 + 1;
                                    } else if (ks == 59 && want.y1 > want.y0) {
                                        want.y1 = want.y1 - 1;
                                    } else if (ks == 39) {
                                        want.y1 = want.y1 + 1;
                                    }
                                    if (in_bounds(want.x0, want.y0) &&
                                        in_bounds(want.x1, want.y1) &&
                                        room_overlaps_other(rooms, nroom, sel, want) == 0) {
                                        rooms[sel] = want;
                                        dirty_world = 1;
                                    }
                                }
                            } else if (ks == 112 || ks == 80) {
                                startp[0] = cc;
                                startp[1] = cr;
                                dirty_world = 1;
                            } else if (ks == 115 || ks == 83) {
                                if (save_world(path, pnames, rooms, titles, nroom, blocks, n,
                                    goals, ngoal, bricks, nbrick, ground_cells, nground, dones,
                                    ndone, startp[0], startp[1]) != 0) {
                                    write(2, "save failed\n", len("save failed\n"));
                                } else {
                                    dirty_world = 0;
                                    write(2, "saved ", len("saved "));
                                    write(2, path, len(path));
                                    write(2, "\n", 1);
                                }
                            }
                        } else if (ks == 98 || ks == 66) {
                            nroom = grow_room_to(rooms, titles, nroom, cc, cr);
                            nl: int = free_layer_at(blocks, n, cc, cr, 0);
                            n2: int = add_block_at(blocks, n, cc, cr, nl, 0, 0);
                            if (n2 != n) {
                                n = n2;
                                apply_gravity(blocks, n);
                                dirty_level = 1;
                            }
                        } else if (ks == 114 || ks == 82) {
                            nroom = grow_room_to(rooms, titles, nroom, cc, cr);
                            top_r: int = highest_layer_at(blocks, n, cc, cr);
                            rbi: int = 0 - 1;
                            if (top_r >= 0) {
                                rbi = block_at_layer(blocks, n, cc, cr, top_r);
                            }
                            rb: Block = empty;
                            if (rbi >= 0) {
                                rb = blocks[rbi];
                            }
                            if (rbi >= 0 && rb.ramp != 0) {
                                n = toggle_ramp(blocks, n, cc, cr, top_r);
                                apply_gravity(blocks, n);
                                dirty_level = 1;
                            } else {
                                nlr: int = free_layer_at(blocks, n, cc, cr, 0);
                                nrp: int = add_block_at(blocks, n, cc, cr, nlr, 0, 1);
                                if (nrp != n) {
                                    n = nrp;
                                    apply_gravity(blocks, n);
                                    dirty_level = 1;
                                }
                            }
                        } else if (ks == 120 || ks == 88 || ks == 65288 || ks == 65535) {
                            n = erase_top_at(blocks, n, cc, cr);
                            dirty_level = 1;
                        } else if (ks == 51 || ks == 52 || ks == 53 || ks == 54 || ks == 55) {
                            nroom = grow_room_to(rooms, titles, nroom, cc, cr);
                            sh: int = ks - 48;
                            if (ks == 55) {
                                sh = 15;
                            }
                            nls: int = free_layer_at(blocks, n, cc, cr, 0);
                            ns: int = add_block_at(blocks, n, cc, cr, nls, sh, 0);
                            if (ns != n) {
                                n = ns;
                                apply_gravity(blocks, n);
                                dirty_level = 1;
                            }
                        } else if (ks == 112 || ks == 80) {
                            startp[0] = cc;
                            startp[1] = cr;
                            dirty_level = 1;
                        } else if (ks == 99 || ks == 67) {
                            nroom = grow_room_to(rooms, titles, nroom, cc, cr);
                            ngoal = toggle_goal(goals, ngoal, cc, cr);
                            dirty_level = 1;
                        } else if (ks == 119 || ks == 87) {
                            if (held_w == 0) {
                                held_w = 1;
                                nroom = grow_room_to(rooms, titles, nroom, cc, cr);
                                nbrick = toggle_brick(bricks, nbrick, cc, cr);
                                need_mesh = 1;
                                dirty_level = 1;
                            }
                        } else if (ks == 91 || ks == 93 || ks == 59 || ks == 39) {
                            if (nroom < 1) {
                                nroom = set_room_size(rooms, titles, 0, 12, 9);
                            }
                            rw: int = room_size_w(rooms[0]);
                            rh: int = room_size_h(rooms[0]);
                            if (ks == 91 && rw > 1) {
                                rw = rw - 1;
                            }
                            if (ks == 93) {
                                rw = rw + 1;
                            }
                            if (ks == 59 && rh > 1) {
                                rh = rh - 1;
                            }
                            if (ks == 39) {
                                rh = rh + 1;
                            }
                            nroom = set_room_size(rooms, titles, nroom, rw, rh);
                            dirty_level = 1;
                        } else if (ks == 105 || ks == 73) {
                            insert_col(blocks, n, rooms, nroom, goals, ngoal, bricks, nbrick,
                                ground_cells, nground, cc);
                            apply_gravity(blocks, n);
                            need_mesh = 1;
                            dirty_level = 1;
                        } else if (ks == 100 || ks == 68) {
                            delete_col(blocks, n, rooms, titles, nroom, goals, ngoal, bricks,
                                nbrick, ground_cells, nground, cc, counts);
                            n = counts[0];
                            nroom = counts[1];
                            ngoal = counts[2];
                            nbrick = counts[3];
                            nground = counts[4];
                            mask_cache[0] = 0 - 999999;
                            apply_gravity(blocks, n);
                            need_mesh = 1;
                            dirty_level = 1;
                        } else if (ks == 115 || ks == 83) {
                            if (save_level(path, blocks, n, rooms, titles, nroom, goals,
                                ngoal, bricks, nbrick, ground_cells, nground, startp[0],
                                startp[1]) != 0) {
                                write(2, "save failed\n", len("save failed\n"));
                            } else {
                                dirty_level = 0;
                                write(2, "saved ", len("saved "));
                                write(2, path, len(path));
                                write(2, "\n", 1);
                            }
                        }
                    }
                    KeyRelease -> {
                        kr: int = XLookupKeysym(&ev, 0);
                        if (kr == 65505 || kr == 65506) {
                            shift = 0;
                        } else if (kr == 65361) {
                            held_l = 0;
                        } else if (kr == 65363) {
                            held_r = 0;
                        } else if (kr == 65362) {
                            held_u = 0;
                        } else if (kr == 65364) {
                            held_d = 0;
                        } else if (kr == 119 || kr == 87) {
                            held_w = 0;
                        }
                    }
                    DestroyNotify -> {
                        running = 0;
                        alive = 0;
                    }
                    ClientMessage c -> {
                        if (c.l0 == proto[0]) {
                            running = 0;
                        }
                    }
                    _ -> { }
                }
            }
            if (need_step == 0 && (held_l != 0 || held_r != 0 || held_u != 0 || held_d != 0)) {
                now_ms: int = mono_ms();
                if (now_ms - arrow_t0 >= 280 && now_ms - arrow_last >= 50) {
                    need_step = 1;
                    arrow_last = now_ms;
                    if (held_l != 0) {
                        step_dc = 0 - 1;
                        step_dr = 0;
                    } else if (held_r != 0) {
                        step_dc = 1;
                        step_dr = 0;
                    } else if (held_u != 0) {
                        step_dc = 0;
                        step_dr = 0 - 1;
                    } else {
                        step_dc = 0;
                        step_dr = 1;
                    }
                }
            }
            if (need_step != 0) {
                tc: int = cc + step_dc;
                tr: int = cr + step_dr;
                if (in_bounds(tc, tr)) {
                    cc = tc;
                    cr = tr;
                }
            }
            if (need_mesh != 0) {
                brick_n = upload_brick_mesh(ids[4], wall_verts, chamfer, bricks, nbrick, brick_used);
                need_mesh = 0;
            }
            if (running != 0) {
                cl = cursor_layer_at(blocks, n, cc, cr);
                want_x: f32 = cc as f32 + 0.5;
                want_z: f32 = cr as f32 + 0.5;
                focus_x = focus_x + (want_x - focus_x) * 0.25;
                focus_z = focus_z + (want_z - focus_z) * 0.25;
                mat_look(view, focus_x, CAM_EYE_Y, focus_z + CAM_BACK, focus_x, 0.0, focus_z,
                    0.0, 1.0, 0.0);
                mat_mul(vp, proj, view, mtmp);
                lx: f32 = focus_x + 4.0;
                ly: f32 = 11.0;
                lz: f32 = focus_z + 3.0;
                mat_look(lview, lx, ly, lz, lx, 0.0, lz, 0.0, 0.0, 0.0 - 1.0);
                mat_mul(lcam, lproj, lview, mtmp);
                mat_mul(lvp, lbias, lcam, mtmp);
                sc: int = startp[0];
                sr: int = startp[1];
                st_top: int = highest_layer_at(blocks, n, sc, sr);
                st_y: f32 = 0.55;
                if (st_top >= 0) {
                    st_y = sit_y(blocks, 0, n, sc, sr, st_top) + 1.0;
                }
                now_e: int = mono_ms();
                dt_e: f32 = spark_dt(spark_last, now_e);
                step_sparks(sparks, spark_rng, spark_acc, spark_xy, rooms, nroom, solved,
                    stream_until, stream_tx, stream_tz, focus_x, focus_z, now_e, dt_e, 0, 0.0,
                    0.0, goals, ngoal, bricks, nbrick, blocks, n, finish_acc);
                draw_frame(prog, dprog, u_vp, u_origin, u_scale, u_color, u_light,
                    u_light_vp, u_lag, d_vp, d_origin, d_scale, d_color, d_lag, ids[0],
                    ids[1], ids[2], ids[3], chamfer_n, ids[4], brick_n, fbos[0], stex[0],
                    ctex[0], cmask, ground_cells, nground, rooms, nroom, goals, ngoal, focus_x,
                    focus_z, u_mask_origin,
                    vp, lcam, lvp, lx, ly, lz, blocks, 0, 0, n, sc as f32, st_y, sr as f32,
                    0.0, shape_verts, lagx, lagz, 1, cc, cr, cl, 1, ground_brush, move_mode,
                    move_sel, move_ok, paint_c, paint_r, paint_anchor, u_ramp, u_ground,
                    u_cut, u_brick, d_ramp, 0.0, 0.0, present_us, mask_cache, lean_to,
                    lean_from, id_to, id_from, cell_head, cell_link, prep_cache, sparks,
                    bprog, b_u, bbuf[0], bdprog, bd_u, grass_prog, grass_u, grass_ids[0],
                    grass_ids[1], grass_blade_n);
                if (is_world != 0) {
                    help1 = "b block  r ramp  w brick  c goal  3-7 shape  x erase  f floor";
                    help2 = "space paint  shift+space rect  m move level  del boundary  n new  p start  s save";
                } else {
                    help1 = "arrows  b block  r ramp  w brick  c goal  f floor  space paint";
                    help2 = "shift+space rect  p start  3-7 shape  x erase  [ ] ; ' size  i/d column  s save";
                    if (is_world != 0) {
                        help1 = "press e to return to the layout";
                        help2 = "e layout  b/r/w/c/p pieces  f floor  space paint  s save  q quit";
                    }
                }
                if (name_mode != 0) {
                    help1 = "new level: type a lowercase name, Enter creates it, Escape cancels";
                    help2 = name_error;
                } else if (move_mode != 0) {
                    help1 = "moving level: arrows move  o rotates  Enter confirms  Escape cancels";
                    help2 = "clear to place";
                    if (move_ok == 0) {
                        help2 = "blocked: level boundaries cannot overlap";
                    }
                }
                glDisable(2929);
                glEnable(3042);
                glBlendFunc(770, 771);
                draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0], tbuf[0], tverts,
                    648.0, help1);
                draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0], tbuf[0], tverts,
                    680.0, help2);
                if (is_world != 0) {
                    on2: int = room_at(rooms, nroom, cc, cr);
                    if (on2 >= 0 && on2 < nroom && len(titles[on2]) > 0) {
                        draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0], tbuf[0],
                            tverts, 20.0, titles[on2]);
                    }
                } else if (nroom > 0 && len(titles[0]) > 0) {
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0], tbuf[0], tverts,
                        20.0, titles[0]);
                }
                if (edit_mode != 0 && name_mode == 0 && move_mode == 0) {
                    brush_label: []i8 = "floor: dirt";
                    if (ground_brush == GROUND_GRASS) {
                        brush_label = "floor: grass";
                    } else if (ground_brush == GROUND_STONE) {
                        brush_label = "floor: flagstone";
                    }
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0], tbuf[0], tverts,
                        52.0, brush_label);
                }
                if (name_mode != 0) {
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0], tbuf[0], tverts,
                        320.0, "name:");
                    draw_help(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0], tbuf[0], tverts,
                        352.0, new_name);
                }
                fps = tick_fps(fps, fps_t, fps_work, fps_rate, fps_mem, present_us[0]);
                fps = draw_fps(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex[0], tbuf[0], tverts,
                    gprog, u_gscreen, u_gcolor, u_galpha, gbuf[0], gverts, fps, fps_t, fps_work,
                    fps_rate, fps_mem, fps_lab);
                glDisable(3042);
                glEnable(2929);
                glXSwapBuffers(dpy, win);
                fps = fps_after_swap(fps);
            }
        }
        if (dirty_level != 0 || dirty_world != 0) {
            write(2, "quit without saving\n", len("quit without saving\n"));
        }
    } else {
        hist: []Block = new Block[8192](empty);
        hpc: []int = new int[8](0);
        hpr: []int = new int[8](0);
        hph: []int = new int[8](0);
        hpm: []int = new int[8](0);
        hms: []int = new int[8](200);
        hn: int = 0;
        hstart: int = 0;
        pc: int = startp[0];
        pr: int = startp[1];
        ph: int = 0;
        pm: int = 0;
        copy_blocks(hist, 0, blocks, 0, n);
        hpc[0] = pc;
        hpr[0] = pr;
        hph[0] = ph;
        hpm[0] = pm;
        hn = 1;
        started: int = mono_ms();
        cam: []f32 = new f32[2](0.0);
        cam2: []f32 = new f32[2](0.0);
        camera_focus(pc, pr, rooms, nroom, cam);
        focus_x: f32 = cam[0];
        focus_z: f32 = cam[1];
        held_l: int = 0;
        held_r: int = 0;
        held_u: int = 0;
        held_d: int = 0;
        topx: []f32 = new f32[1024](0.0);
        topz: []f32 = new f32[1024](0.0);
        velx: []f32 = new f32[1024](0.0);
        velz: []f32 = new f32[1024](0.0);
        last_ms: []int = new int[1](0);
        while (running != 0) {
            while (XPending(dpy) != 0) {
                XNextEvent(dpy, &ev);
                match ev {
                    KeyPress -> {
                        ks: int = XLookupKeysym(&ev, 0);
                        if (ks == 65505 || ks == 65506) {
                            shift = 1;
                        } else if (is_fps_key(ks) != 0) {
                            fps = toggle_fps(fps);
                        } else if (is_vsync_key(ks) != 0) {
                            vsync = set_vsync(dpy, win, 1 - vsync);
                        } else if (ks == 113 || ks == 81 || ks == 65307) {
                            running = 0;
                        } else if (ks == 65361 || ks == 65362 || ks == 65363 || ks == 65364) {
                            is_rep: int = 0;
                            if (ks == 65361 && held_l != 0) {
                                is_rep = 1;
                            }
                            if (ks == 65363 && held_r != 0) {
                                is_rep = 1;
                            }
                            if (ks == 65362 && held_u != 0) {
                                is_rep = 1;
                            }
                            if (ks == 65364 && held_d != 0) {
                                is_rep = 1;
                            }
                            if (ks == 65361) {
                                held_l = 1;
                            }
                            if (ks == 65363) {
                                held_r = 1;
                            }
                            if (ks == 65362) {
                                held_u = 1;
                            }
                            if (ks == 65364) {
                                held_d = 1;
                            }
                            if (shift == 0) {
                                gated: int = 0;
                                if (hn < 2) {
                                    gated = 1;
                                } else if (hn < 5 && is_rep == 0) {
                                    gated = 1;
                                }
                                if (gated != 0) {
                                    dc: int = 0;
                                    dr: int = 0;
                                    if (ks == 65361) {
                                        dc = 0 - 1;
                                    } else if (ks == 65363) {
                                        dc = 1;
                                    } else if (ks == 65362) {
                                        dr = 0 - 1;
                                    } else {
                                        dr = 1;
                                    }
                                    old_c: int = pc;
                                    old_r: int = pr;
                                    packed: int = move_player(blocks, n, rooms, nroom, bricks,
                                        nbrick, pc, pr, ph, dc, dr);
                                    prevs: int = (hstart + hn - 1) % 8;
                                    yfrom: f32 = sit_y(hist, prevs * 1024, n, hpc[prevs],
                                        hpr[prevs], hph[prevs]);
                                    sfrom: int = sit_at(hist, prevs * 1024, n, hpc[prevs],
                                        hpr[prevs], hph[prevs]);
                                    pc = pos_col(packed);
                                    pr = pos_row(packed);
                                    ph = pos_layer(packed);
                                    pm = pos_mounted(packed);
                                    if (hn == 1) {
                                        started = mono_ms();
                                    }
                                    if (hn >= 8) {
                                        hstart = (hstart + 1) % 8;
                                        hn = hn - 1;
                                    }
                                    slot: int = (hstart + hn) % 8;
                                    copy_blocks(hist, slot * 1024, blocks, 0, n);
                                    hpc[slot] = pc;
                                    hpr[slot] = pr;
                                    hph[slot] = ph;
                                    hpm[slot] = pm;
                                    hms[slot] = block_step_dur(hist, prevs * 1024, slot * 1024, n,
                                        step_dur(yfrom, sit_y(hist, slot * 1024, n, pc, pr, ph),
                                        sfrom, sit_at(hist, slot * 1024, n, pc, pr, ph)));
                                    hn = hn + 1;
                                    if (is_goal(goals, ngoal, pc, pr) && (pc != old_c || pr != old_r)) {
                                        if (!is_goal(goals, ngoal, old_c, old_r)) {
                                            ri_g: int = room_at(rooms, nroom, pc, pr);
                                            if (ri_g >= 0 && ri_g < len(solved) && solved[ri_g] == 0) {
                                                solved[ri_g] = 1;
                                                stream_until[ri_g] = mono_ms() + 1600;
                                                stream_tx[ri_g] = pc as f32 + 0.5;
                                                stream_tz[ri_g] = pr as f32 + 0.5;
                                                redirect_sparks(sparks, ri_g);
                                                                                burst_stream(sparks, spark_rng, spark_xy,
                                                    rooms[ri_g], ri_g, 90, bricks, nbrick, blocks,
                                                    n);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    KeyRelease -> {
                        kr: int = XLookupKeysym(&ev, 0);
                        if (kr == 65505 || kr == 65506) {
                            shift = 0;
                        } else if (kr == 65361) {
                            held_l = 0;
                        } else if (kr == 65363) {
                            held_r = 0;
                        } else if (kr == 65362) {
                            held_u = 0;
                        } else if (kr == 65364) {
                            held_d = 0;
                        }
                    }
                    DestroyNotify -> {
                        running = 0;
                        alive = 0;
                    }
                    ClientMessage c -> {
                        if (c.l0 == proto[0]) {
                            running = 0;
                        }
                    }
                    _ -> { }
                }
            }
            if (running != 0) {
                now: int = mono_ms();
                dur: int = 200;
                if (hn > 1) {
                    dur = hms[(hstart + 1) % 8];
                    if (dur < 200) {
                        dur = 200;
                    }
                }
                while (hn > 1 && now - started >= dur) {
                    hstart = (hstart + 1) % 8;
                    hn = hn - 1;
                    started = started + dur;
                    dur = 200;
                    if (hn > 1) {
                        dur = hms[(hstart + 1) % 8];
                        if (dur < 200) {
                            dur = 200;
                        }
                    }
                }
                t: f32 = 0.0;
                if (hn > 1) {
                    t = (now - started) as f32 / dur as f32;
                    if (t > 1.0) {
                        t = 1.0;
                    }
                }
                fi: int = 0;
                ti: int = 0;
                if (hn > 1) {
                    ti = 1;
                }
                foff: int = hist_off(hstart, fi);
                toff: int = hist_off(hstart, ti);
                fc: int = hpc[(hstart + fi) % 8];
                fr: int = hpr[(hstart + fi) % 8];
                tc2: int = hpc[(hstart + ti) % 8];
                tr2: int = hpr[(hstart + ti) % 8];
                camera_focus(fc, fr, rooms, nroom, cam);
                camera_focus(tc2, tr2, rooms, nroom, cam2);
                want_fx: f32 = lerp(cam[0], cam2[0], t);
                want_fz: f32 = lerp(cam[1], cam2[1], t);
                focus_x = focus_x + (want_fx - focus_x) * 0.25;
                focus_z = focus_z + (want_fz - focus_z) * 0.25;
                mat_look(view, focus_x, CAM_EYE_Y, focus_z + CAM_BACK, focus_x, 0.0, focus_z,
                    0.0, 1.0, 0.0);
                mat_mul(vp, proj, view, mtmp);
                lx: f32 = focus_x + 4.0;
                ly: f32 = 11.0;
                lz: f32 = focus_z + 3.0;
                mat_look(lview, lx, ly, lz, lx, 0.0, lz, 0.0, 0.0, 0.0 - 1.0);
                mat_mul(lcam, lproj, lview, mtmp);
                mat_mul(lvp, lbias, lcam, mtmp);
                px: f32 = lerp(fc as f32, tc2 as f32, t);
                pz: f32 = lerp(fr as f32, tr2 as f32, t);
                fh: int = hph[(hstart + fi) % 8];
                th: int = hph[(hstart + ti) % 8];
                fill_stack_col(hist, foff, n, fc, fr, col_body, col_ramp);
                fs: int = 0;
                if (fh >= 0 && fh < 8 && col_ramp[fh] != 0) {
                    fs = 1;
                }
                y0: f32 = fh as f32 + 0.55;
                if (fs != 0) {
                    y0 = fh as f32 + 0.5;
                }
                fx0: f32 = 0.0;
                fz0: f32 = 0.0;
                if (fh >= 0 && fh < 8) {
                    fx0 = ramp_face_x(col_ramp[fh]);
                    fz0 = ramp_face_z(col_ramp[fh]);
                }
                pl0: int = 0;
                if (fh >= 0 && fh < 8) {
                    pl0 = stack_lean_col(col_body, col_ramp, fh, fs);
                }
                fill_stack_col(hist, toff, n, tc2, tr2, col_body, col_ramp);
                ts: int = 0;
                if (th >= 0 && th < 8 && col_ramp[th] != 0) {
                    ts = 1;
                }
                y1: f32 = th as f32 + 0.55;
                if (ts != 0) {
                    y1 = th as f32 + 0.5;
                }
                fx1: f32 = 0.0;
                fz1: f32 = 0.0;
                if (th >= 0 && th < 8) {
                    fx1 = ramp_face_x(col_ramp[th]);
                    fz1 = ramp_face_z(col_ramp[th]);
                }
                pl1: int = 0;
                if (th >= 0 && th < 8) {
                    pl1 = stack_lean_col(col_body, col_ramp, th, ts);
                }
                gt: f32 = fall_t(y0, y1, fs, ts, t);
                py: f32 = anim_y(y0, y1, px, pz, fc, fr, tc2, tr2, fx0, fz0, fx1, fz1, fs, ts, t);
                pru_x: f32 = lerp(ramp_face_x(lean_dir(pl0)), ramp_face_x(lean_dir(pl1)),
                    gt);
                pru_z: f32 = lerp(ramp_face_z(lean_dir(pl0)), ramp_face_z(lean_dir(pl1)),
                    gt);
                pk: f32 = lerp(lean_k(pl0) as f32, lean_k(pl1) as f32, gt);
                px = px + lean_along(pru_x, pru_z, pk, 0);
                py = py + lean_along(pru_x, pru_z, pk, 1);
                pz = pz + lean_along(pru_x, pru_z, pk, 2);
                tick_soft(hist, foff, toff, n, t, px, pz, focus_x, focus_z, topx, topz, velx, velz,
                    lagx, lagz, now, last_ms);
                on_g: int = 0;
                gx_f: f32 = pc as f32 + 0.5;
                gz_f: f32 = pr as f32 + 0.5;
                if (is_goal(goals, ngoal, pc, pr)) {
                    on_g = 1;
                }
                dt_p: f32 = spark_dt(spark_last, now);
                step_sparks(sparks, spark_rng, spark_acc, spark_xy, rooms, nroom, solved,
                    stream_until, stream_tx, stream_tz, focus_x, focus_z, now, dt_p, on_g, gx_f,
                    gz_f, goals, ngoal, bricks, nbrick, blocks, n, finish_acc);
                draw_frame(prog, dprog, u_vp, u_origin, u_scale, u_color, u_light,
                    u_light_vp, u_lag, d_vp, d_origin, d_scale, d_color, d_lag, ids[0],
                    ids[1], ids[2], ids[3], chamfer_n, ids[4], brick_n, fbos[0], stex[0],
                    ctex[0], cmask, ground_cells, nground, rooms, nroom, goals, ngoal, focus_x,
                    focus_z, u_mask_origin,
                    vp, lcam, lvp, lx, ly, lz, hist, foff, toff, n, px, py, pz, t,
                    shape_verts, lagx, lagz, 1, 0, 0, 0, 0, GROUND_DIRT, 0, 0, 1, 0, 0, 0,
                    u_ramp, u_ground,
                    u_cut, u_brick, d_ramp, pru_x, pru_z, present_us, mask_cache, lean_to,
                    lean_from, id_to, id_from, cell_head, cell_link, prep_cache, sparks,
                    bprog, b_u, bbuf[0], bdprog, bd_u, grass_prog, grass_u, grass_ids[0],
                    grass_ids[1], grass_blade_n);
                fi_t: int = room_at(rooms, nroom, fc, fr);
                ti_t: int = room_at(rooms, nroom, tc2, tr2);
                from_title: []i8 = "";
                to_title: []i8 = "";
                if (fi_t >= 0) {
                    from_title = titles[fi_t];
                }
                if (ti_t >= 0) {
                    to_title = titles[ti_t];
                }
                glDisable(2929);
                glEnable(3042);
                glBlendFunc(770, 771);
                if (titles_eq(from_title, to_title)) {
                    draw_title(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 40.0, 676.0, from_title, 1.0);
                } else {
                    draw_title(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 40.0, 676.0, from_title, 1.0 - t);
                    draw_title(font, tprog, u_tscreen, u_tcolor, u_talpha, ftex[0],
                        tbuf[0], tverts, 40.0, 676.0, to_title, t);
                }
                fps = tick_fps(fps, fps_t, fps_work, fps_rate, fps_mem, present_us[0]);
                fps = draw_fps(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex[0], tbuf[0], tverts,
                    gprog, u_gscreen, u_gcolor, u_galpha, gbuf[0], gverts, fps, fps_t, fps_work,
                    fps_rate, fps_mem, fps_lab);
                glDisable(3042);
                glEnable(2929);
                glXSwapBuffers(dpy, win);
                fps = fps_after_swap(fps);
            }
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive != 0) {
        XDestroyWindow(dpy, win);
    }
    XCloseDisplay(dpy);
    0;
}
