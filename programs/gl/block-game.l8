    grass_vs: []i8 = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec2 vcol;
uniform mat4 vp;
uniform vec2 grass_origin;
uniform vec2 focus;
uniform vec2 actor;
uniform vec2 motion;
uniform float time;
varying vec3 vworld;
varying vec3 vnrm;
varying float vroot;
varying float vrand;
varying float valive;
vec2 grass_hash(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
void main() {
  vec2 grid_base = grass_origin + vcol;
  vec2 seed = grass_hash(grid_base * 4.54545 + 17.0);
  vec2 base = grid_base + (seed - 0.5) * 0.13;
  float alive = 1.0;
  float angle = seed.x * 6.2831853;
  float ca = cos(angle);
  float sa = sin(angle);
  vec2 local_xz = vec2(pos.x * ca - pos.z * sa, pos.x * sa + pos.z * ca) * 1.12;
  float height = mix(0.24, 0.37, seed.y);
  float t = clamp(pos.y, 0.0, 1.1);
  vec2 actor_delta = base - actor;
  float actor_dist = length(actor_delta);
  float touch = 1.0 - smoothstep(0.30, 0.80, actor_dist);
  vec2 away = actor_delta / max(actor_dist, 0.001);
  float motion_len = length(motion);
  vec2 motion_dir = motion / max(motion_len, 0.001);
  float moving = smoothstep(0.012, 0.12, motion_len);
  vec2 wind_dir = normalize(vec2(0.82, 0.36));
  float wind = sin(dot(base, vec2(0.43, 0.31)) + time * 0.82 + seed.x * 5.0);
  vec2 bend = wind_dir * wind * 0.025;
  bend += away * touch * 0.15;
  bend += motion_dir * touch * moving * 0.075;
  bend *= t * t;
  vec3 w = vec3(base.x + local_xz.x + bend.x, -0.017 + pos.y * height,
                base.y + local_xz.y + bend.y);
  w.y = mix(-0.017, w.y, alive);
  vec2 rn = vec2(nrm.x * ca - nrm.z * sa, nrm.x * sa + nrm.z * ca);
  vnrm = normalize(vec3(rn.x - bend.x * 1.5, 0.16, rn.y - bend.y * 1.5));
  vworld = w;
  vroot = t;
  vrand = seed.y;
  valive = alive;
  gl_Position = vp * vec4(w, 1.0);
}
""";
    grass_fs: []i8 = """
#version 120
uniform vec3 light;
uniform mat4 light_vp;
uniform sampler2D shadow_map;
uniform sampler2D check_map;
uniform vec2 mask_origin;
varying vec3 vworld;
varying vec3 vnrm;
varying float vroot;
varying float vrand;
varying float valive;
vec2 hash2(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
float sample_ground(vec2 p) {
  vec2 tc = (p - mask_origin) / 256.0;
  if (tc.x < 0.0 || tc.x > 1.0 || tc.y < 0.0 || tc.y > 1.0) {
    return 0.0;
  }
  return texture2D(check_map, tc).r;
}
float grass_at(vec2 p) {
  float r = sample_ground(p);
  return step(0.15, r) * (1.0 - step(0.50, r)) + step(0.80, r);
}
float stone_at(vec2 p) {
  return step(0.50, sample_ground(p));
}
float stone_cover(vec2 p) {
  vec2 cell = floor(p);
  vec2 f = fract(p);
  float md = 8.0;
  float md2 = 8.0;
  vec2 mc = cell;
  int j;
  int i;
  for (j = -1; j <= 1; j++) {
    for (i = -1; i <= 1; i++) {
      vec2 g = vec2(float(i), float(j));
      vec2 o = hash2(cell + g);
      vec2 r = g + o * 0.62 - f;
      float d = dot(r, r);
      if (d < md) {
        md2 = md;
        md = d;
        mc = cell + g;
      } else if (d < md2) {
        md2 = d;
      }
    }
  }
  float edge = sqrt(md2) - sqrt(md);
  return smoothstep(0.040, 0.155, edge) * stone_at(mc + 0.5);
}
void main() {
  if (valive < 0.5) {
    discard;
  }
  vec2 grass_cell = floor(vworld.xz);
  vec2 in_cell = fract(vworld.xz);
  if (grass_at(grass_cell + 0.5) < 0.5) {
    discard;
  }
  float edge_distance = 1.0;
  if (grass_at(grass_cell + vec2(-0.5, 0.5)) < 0.5) {
    edge_distance = min(edge_distance, in_cell.x);
  }
  if (grass_at(grass_cell + vec2(1.5, 0.5)) < 0.5) {
    edge_distance = min(edge_distance, 1.0 - in_cell.x);
  }
  if (grass_at(grass_cell + vec2(0.5, -0.5)) < 0.5) {
    edge_distance = min(edge_distance, in_cell.y);
  }
  if (grass_at(grass_cell + vec2(0.5, 1.5)) < 0.5) {
    edge_distance = min(edge_distance, 1.0 - in_cell.y);
  }
  float grass_amount = smoothstep(0.0, 1.0, edge_distance);
  grass_amount *= 1.0 - stone_cover(vworld.xz);
  if (vroot > grass_amount || vrand > grass_amount) {
    discard;
  }
  vec3 root_color = vec3(0.165, 0.190, 0.100);
  vec3 tip_color = vec3(0.285, 0.320, 0.175);
  vec3 albedo = mix(root_color, tip_color, smoothstep(0.0, 0.82, vroot));
  albedo *= 0.92 + 0.12 * vrand;
  albedo += vec3(0.018, 0.022, 0.006) * smoothstep(0.70, 1.0, vroot);
  vec3 toL = light - vworld;
  float dist = length(toL);
  vec3 L = toL / max(dist, 0.001);
  vec3 n = normalize(vnrm);
  float ndl = abs(dot(n, L));
  float back = max(dot(0.0 - n, L), 0.0);
  float att = 1.0 / (1.0 + 0.01 * dist * dist);
  float vis = 1.0;
  vec4 sh = light_vp * vec4(vworld, 1.0);
  vec3 sc = sh.xyz / max(sh.w, 0.0001);
  if (sc.x > 0.01 && sc.x < 0.99 && sc.y > 0.01 && sc.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
    vis = step(sc.z, texture2D(shadow_map, sc.xy).r + 0.004);
  }
  float key = ndl * att * vis;
  float shade = 0.14 + 0.74 * key;
  shade += 0.055 * back * smoothstep(0.38, 1.0, vroot);
  vec3 lit = albedo * shade * vec3(1.62, 1.46, 1.22);
  lit += vec3(0.006, 0.005, 0.003) * (1.0 - smoothstep(0.0, 0.06, lit));
  gl_FragColor = vec4(lit, 1.0);
}
""";
    prog: int = link_program(vs, fs, "nrm");
    dprog: int = link_program(dvs, dfs, "nrm");
    tprog: int = link_program(tvs, tfs, "uv");
    grass_prog: int = link_program(grass_vs, grass_fs, "nrm");
    gvs: []i8 = """
#version 120
attribute vec2 pos;
uniform vec2 screen;
void main() {
  gl_Position = vec4(pos.x / screen.x * 2.0 - 1.0, 1.0 - pos.y / screen.y * 2.0, 0.0, 1.0);
}
""";
    gfs: []i8 = """
#version 120
uniform vec3 color;
uniform float alpha;
void main() {
  gl_FragColor = vec4(color, alpha);
}
""";
    gprog: int = link_program(gvs, gfs, "uv");
    bvs: []i8 = """
#version 120
attribute vec3 pos;
uniform mat4 vp;
uniform vec3 origin;
uniform vec3 scale;
uniform vec3 cam_right;
uniform vec3 cam_up;
varying vec2 vuv;
varying vec3 vseed;
varying vec3 vworld;
void main() {
  vuv = pos.xy;
  vseed = origin;
  vec3 w = origin + cam_right * pos.x * scale.x + cam_up * pos.y * scale.y;
  vworld = w;
  gl_Position = vp * vec4(w, 1.0);
}
""";
    bfs: []i8 = """
#version 120
uniform vec3 color;
uniform vec3 light;
uniform mat4 light_vp;
uniform sampler2D shadow_map;
uniform vec3 cam_right;
uniform vec3 cam_up;
uniform vec3 cam_toward;
uniform float time;
varying vec2 vuv;
varying vec3 vseed;
varying vec3 vworld;
void main() {
  float h = fract(sin(dot(vseed.xz, vec2(12.9898, 78.233))) * 43758.5453);
  float r = length(vuv);
  if (r > 1.0) {
    discard;
  }
  float core = exp(-r * r * 14.0);
  float halo = exp(-r * r * 3.2);
  float pulse = 0.80 + 0.20 * sin(time * (1.35 + 0.90 * h) + h * 11.0);
  float vis = 1.0;
  vec4 sh = light_vp * vec4(vworld, 1.0);
  vec3 sc = sh.xyz / max(sh.w, 0.0001);
  if (sc.x > 0.01 && sc.x < 0.99 && sc.y > 0.01 && sc.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
    float bias = 0.004;
    float t = 0.00048828125;
    float s = 0.0;
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(-t, -t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(t, -t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(-t, t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(t, t)).r + bias);
    vis = s * 0.25;
  }
  vec3 toL = light - vworld;
  float dist = length(toL);
  vec3 L = toL / max(dist, 0.001);
  vec3 nw = normalize(cam_right * vuv.x + cam_up * vuv.y + cam_toward * (1.0 - r));
  float ndl = max(dot(nw, L), 0.0);
  float lit = 0.28 + 0.72 * vis * (0.72 + 0.28 * ndl);
  float glow = core * 0.80 + halo * 0.58;
  vec3 rgb = color * glow * lit * pulse;
  float a = (core * 0.50 + halo * 0.32) * pulse;
  gl_FragColor = vec4(rgb, a);
}
""";
    bdfs: []i8 = """
#version 120
varying vec2 vuv;
void main() {
  if (dot(vuv, vuv) > 0.36) {
    discard;
  }
}
""";
