        u_gcolor, u_galpha, gvbo, gverts, 620.0, y, "?", "this list");
}

brush_slot_kind(slot: int): int {
    if (slot == 1) {
        return BRUSH_GRASS;
    }
    if (slot == 2) {
        return BRUSH_STONE;
    }
    if (slot >= 3 && slot <= 8) {
        return BRUSH_BLOCK;
    }
    if (slot == 9) {
        return BRUSH_RAMP;
    }
    if (slot == 10) {
        return BRUSH_BRICK;
    }
    if (slot == 11) {
        return BRUSH_GOAL;
    }
    if (slot == 12) {
        return BRUSH_START;
    }
    if (slot == 13) {
        return BRUSH_ROOM_START;
    }
    BRUSH_DIRT;
}

brush_slot_shape(slot: int): int {
    if (slot == 4) {
        return 3;
    }
    if (slot == 5) {
        return 4;
    }
    if (slot == 6) {
        return 5;
    }
    if (slot == 7) {
        return 6;
    }
    if (slot == 8) {
        return 15;
    }
    0;
}

brush_slot_key(slot: int): []i8 {
    if (slot == 1) {
        return "2";
    }
    if (slot == 2) {
        return "f";
    }
    if (slot == 3) {
        return "b";
    }
    if (slot == 4) {
        return "3";
    }
    if (slot == 5) {
        return "4";
    }
    if (slot == 6) {
        return "5";
    }
    if (slot == 7) {
        return "6";
    }
    if (slot == 8) {
        return "7";
    }
    if (slot == 9) {
        return "r";
    }
    if (slot == 10) {
        return "w";
    }
    if (slot == 11) {
        return "c";
    }
    if (slot == 12) {
        return "p";
    }
    if (slot == 13) {
        return "e";
    }
    "1";
}

brush_slot_on(slot: int, brush: int, shape: int): int {
    kind: int = brush_slot_kind(slot);
    if (brush != kind) {
        return 0;
    }
    if (kind != BRUSH_BLOCK) {
        return 1;
    }
    if (brush_slot_shape(slot) == shape) {
        return 1;
    }
    0;
}

fill_icon_mask(cmask: []i8) {
    i: int = 0;
    while (i < MASK_SIZE * MASK_SIZE) {
        cmask[i] = 0i8;
        i = i + 1;
    }
    r: int = 0;
    while (r < 3) {
        c: int = 0;
        while (c < 3) {
            mark_ground_cell(cmask, 0, 0, 10 + c, r, GROUND_GRASS, 0);
            mark_ground_cell(cmask, 0, 0, 20 + c, r, GROUND_GRASS, 1);
            c = c + 1;
        }
        r = r + 1;
    }
}

brush_preview_cell(brush: int, out: []f32) {
    out[0] = 1.5;
    out[1] = 1.5;
    if (brush == BRUSH_GRASS) {
        out[0] = 11.5;
        out[1] = 1.5;
    } else if (brush == BRUSH_STONE) {
        out[0] = 21.5;
        out[1] = 1.5;
    } else if (brush == BRUSH_BRICK) {
        out[0] = 0.5;
        out[1] = 0.5;
    }
}

draw_brush_preview(
    prog: int,
    u_vp: int,
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_light: int,
    u_light_vp: int,
    u_lag: int,
    u_ramp: int,
    u_ground: int,
    u_cut: int,
    u_brick: int,
    u_mask_origin: int,
    cube_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    prism_buf: u32,
    brick_buf: u32,
    chamfer_n: int,
    brick_n: int,
    shape_verts: []f32,
    mask_tex: u32,
    icon_proj: []f32,
    icon_view: []f32,
    icon_vp: []f32,
    icon_tmp: []f32,
    icon_lvp: []f32,
    look: []f32,
    brush: int,
    shape: int,
    vx: int,
    vy: int,
    vw: int,
    vh: int
) {
    if (vw < 8 || vh < 8) {
        return;
    }
    side: int = vw;
    if (vh < vw) {
        side = vh;
    }
    vx = vx + (vw - side) / 2;
    vy = vy + (vh - side) / 2;
    glEnable(3089);
    glScissor(vx, vy, side, side);
    glViewport(vx, vy, side, side);
    glClear(256);
    cx: f32 = look[0];
    cz: f32 = look[1];
    mat_look(icon_view, cx + 1.58, 1.78, cz + 1.70, cx, 0.34, cz, 0.0, 1.0, 0.0);
    mat_mul(icon_vp, icon_proj, icon_view, icon_tmp);
    glUseProgram(prog);
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(1);
    glDisableVertexAttribArray(2);
    glActiveTexture(33985);
    glBindTexture(3553, mask_tex);
    glActiveTexture(33984);
    glUniformMatrix4fv(u_vp, 1, 0, icon_vp);
    glUniformMatrix4fv(u_light_vp, 1, 0, icon_lvp);
    glUniform3f(u_light, cx + 0.85, 2.55, cz + 0.15);
    glUniform2f(u_lag, 0.0, 0.0);
    glUniform2f(u_ramp, 0.0, 0.0);
    glUniform1f(u_cut, 0.0);
    glUniform1f(u_brick, 0.0);
    glUniform1f(u_ground, 0.0);
    glUniform2f(u_mask_origin, 0.0, 0.0);
    bind_mesh(cube_buf);
    glUniform1f(u_ground, 1.0);
    draw_box(u_origin, u_scale, u_color, cx, 0.0 - 0.06, cz, 1.18, 0.12, 1.18, 0.22, 0.20, 0.18,
        36);
    glUniform1f(u_ground, 0.0);
    if (brush == BRUSH_GRASS) {
        draw_box(u_origin, u_scale, u_color, cx - 0.22, 0.16, cz + 0.08, 0.045, 0.28, 0.035, 0.28,
            0.40, 0.18, 36);
        draw_box(u_origin, u_scale, u_color, cx + 0.12, 0.20, cz - 0.18, 0.040, 0.36, 0.032, 0.30,
            0.42, 0.20, 36);
        draw_box(u_origin, u_scale, u_color, cx + 0.26, 0.14, cz + 0.20, 0.038, 0.24, 0.030, 0.26,
            0.38, 0.17, 36);
        draw_box(u_origin, u_scale, u_color, cx - 0.08, 0.18, cz - 0.28, 0.036, 0.32, 0.028, 0.32,
            0.44, 0.21, 36);
        draw_box(u_origin, u_scale, u_color, cx + 0.02, 0.22, cz + 0.26, 0.034, 0.38, 0.028, 0.29,
            0.41, 0.19, 36);
    } else if (brush == BRUSH_BLOCK) {
        if (shape == 0) {
            bind_mesh(chamfer_buf);
            glUniform1f(u_cut, 1.0);
            draw_box(u_origin, u_scale, u_color, cx, 0.50, cz, 0.92, 1.0, 0.92, 0.56, 0.54, 0.52,
                chamfer_n / 6);
            glUniform1f(u_cut, 0.0);
        } else {
            bind_mesh(prism_buf);
            glUniform3f(u_origin, cx, 0.50, cz);
            glUniform3f(u_scale, 1.0, 1.0, 1.0);
            glUniform3f(u_color, 0.988, 0.827, 0.302);
            nf: int = fill_prism(shape_verts, shape);
            if (nf > 0) {
                glBufferData(34962, nf * 4, shape_verts, 35040);
                glDrawArrays(4, 0, nf / 6);
            }
        }
    } else if (brush == BRUSH_RAMP) {
        rd: int = shape;
        if (rd < 1 || rd > 4) {
            rd = 1;
        }
        bind_mesh(ramp_buf);
        glUniform1f(u_cut, 1.0);
        glUniform3f(u_scale, 0.92, 1.0, 0.92);
        glUniform3f(u_color, 0.56, 0.54, 0.52);
        glUniform3f(u_origin, cx, 0.50, cz);
        glDrawArrays(4, (rd - 1) * (chamfer_n / 6), chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_BRICK) {
        bind_brick_mesh(brick_buf);
        glUniform1f(u_brick, 1.0);
        glUniform3f(u_origin, 0.0, 0.0, 0.0);
        glUniform3f(u_scale, 1.0, 1.0, 1.0);
        glUniform3f(u_color, 0.62, 0.32, 0.26);
        glDrawArrays(4, 0, brick_n / 9);
        glUniform1f(u_brick, 0.0);
        glDisableVertexAttribArray(2);
    } else if (brush == BRUSH_GOAL) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, cx, 0.16, cz, 0.62, 0.18, 0.62, 0.90, 0.74, 0.28,
            chamfer_n / 6);
        draw_box(u_origin, u_scale, u_color, cx, 0.42, cz, 0.22, 0.22, 0.22, 0.96, 0.82, 0.32,
            chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_START) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, cx, 0.55, cz, 0.86, 1.1, 0.86, 0.80, 0.30, 0.24,
            chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_ROOM_START) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, cx, 0.42, cz, 0.70, 0.84, 0.70, 0.22, 0.66, 0.72,
            chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    }
}

draw_brush_panel(
    hud: Font,
    tprog: int,
    u_tscreen: int,
    u_tcolor: int,
    u_talpha: int,
    htex: u32,
    tvbo: u32,
    tverts: []f32,
    gprog: int,
    u_gscreen: int,
    u_gcolor: int,
    u_galpha: int,
    gvbo: u32,
    gverts: []f32,
    prog: int,
    u_vp: int,
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_light: int,
    u_light_vp: int,
    u_lag: int,
    u_ramp: int,
    u_ground: int,
    u_cut: int,
    u_brick: int,
    u_mask_origin: int,
    cube_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    prism_buf: u32,
    brick_buf: u32,
    chamfer_n: int,
    brick_n: int,
    shape_verts: []f32,
    mask_tex: u32,
    icon_proj: []f32,
    icon_view: []f32,
    icon_vp: []f32,
    icon_tmp: []f32,
    icon_lvp: []f32,
    look: []f32,
    paint_brush: int,
    brush_shape: int
) {
    x0: f32 = 1048.0;
    y0: f32 = 112.0;
    tw: f32 = 62.0;
    th: f32 = 70.0;
    gap: f32 = 6.0;
    pad: f32 = 10.0;
    cols: int = 2;
    rows: int = 7;
    x1: f32 = x0 + pad + cols as f32 * tw + (cols - 1) as f32 * gap + pad;
    y1: f32 = y0 + pad + 18.0 + rows as f32 * th + (rows - 1) as f32 * gap + pad;
    n: int = put_quad(gverts, 0, x0, y0, x1, y1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.14, 0.11, 0.10, 0.90);
    n = put_quad(gverts, 0, x0, y0, x1, y0 + 2.0);
    n = put_quad(gverts, n, x0, y1 - 2.0, x1, y1);
    n = put_quad(gverts, n, x0, y0, x0 + 2.0, y1);
    n = put_quad(gverts, n, x1 - 2.0, y0, x1, y1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.72, 0.60, 0.44, 0.74);
    draw_title_layer(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, x0 + 12.0,
        y0 + 20.0, "Brush", 0.96, 0.86, 0.74, 0.56);
    slot: int = 0;
    while (slot < BRUSH_SLOT_N) {
        col: int = slot % cols;
        row: int = slot / cols;
        tx: f32 = x0 + pad + col as f32 * (tw + gap);
        ty: f32 = y0 + pad + 24.0 + row as f32 * (th + gap);
        on: int = brush_slot_on(slot, paint_brush, brush_shape);
        n = put_quad(gverts, 0, tx, ty, tx + tw, ty + th);
        if (on != 0) {
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.28, 0.22, 0.16, 0.96);
        } else {
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.10, 0.09, 0.08, 0.94);
        }
        slot = slot + 1;
    }
    glDisable(3042);
    glEnable(2929);
    glDepthMask(1);
    slot = 0;
    while (slot < BRUSH_SLOT_N) {
        col2: int = slot % cols;
        row2: int = slot / cols;
        tx2: f32 = x0 + pad + col2 as f32 * (tw + gap);
        ty2: f32 = y0 + pad + 24.0 + row2 as f32 * (th + gap);
        ix0: f32 = tx2 + 5.0;
        iy0: f32 = ty2 + 3.0;
        ix1: f32 = tx2 + tw - 5.0;
        iy1: f32 = ty2 + th - 18.0;
        kind: int = brush_slot_kind(slot);
        pshape: int = brush_slot_shape(slot);
        if (kind == BRUSH_RAMP) {
            pshape = 1;
            if (paint_brush == BRUSH_RAMP && brush_shape >= 1 && brush_shape <= 4) {
                pshape = brush_shape;
            }
        }
        brush_preview_cell(kind, look);
        draw_brush_preview(prog, u_vp, u_origin, u_scale, u_color, u_light, u_light_vp, u_lag, u_ramp,
            u_ground, u_cut, u_brick, u_mask_origin, cube_buf, chamfer_buf, ramp_buf, prism_buf,
            brick_buf, chamfer_n, brick_n, shape_verts, mask_tex, icon_proj, icon_view, icon_vp,
            icon_tmp, icon_lvp, look, kind, pshape, ix0 as int, 720 - (iy1 as int),
            (ix1 - ix0) as int, (iy1 - iy0) as int);
        slot = slot + 1;
    }
    glViewport(0, 0, 1200, 720);
    glDisable(3089);
    glDisable(2929);
    glEnable(3042);
    glBlendFunc(770, 771);
    slot = 0;
    while (slot < BRUSH_SLOT_N) {
        col3: int = slot % cols;
        row3: int = slot / cols;
        tx3: f32 = x0 + pad + col3 as f32 * (tw + gap);
        ty3: f32 = y0 + pad + 24.0 + row3 as f32 * (th + gap);
        on2: int = brush_slot_on(slot, paint_brush, brush_shape);
        if (on2 != 0) {
            n = put_quad(gverts, 0, tx3, ty3, tx3 + tw, ty3 + 3.0);
            n = put_quad(gverts, n, tx3, ty3 + th - 3.0, tx3 + tw, ty3 + th);
            n = put_quad(gverts, n, tx3, ty3, tx3 + 3.0, ty3 + th);
            n = put_quad(gverts, n, tx3 + tw - 3.0, ty3, tx3 + tw, ty3 + th);
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.94, 0.78, 0.42, 0.92);
        } else {
            n = put_quad(gverts, 0, tx3, ty3, tx3 + tw, ty3 + 1.0);
            n = put_quad(gverts, n, tx3, ty3 + th - 1.0, tx3 + tw, ty3 + th);
            n = put_quad(gverts, n, tx3, ty3, tx3 + 1.0, ty3 + th);
            n = put_quad(gverts, n, tx3 + tw - 1.0, ty3, tx3 + tw, ty3 + th);
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.42, 0.34, 0.26, 0.55);
        }
        key: []i8 = brush_slot_key(slot);
        kw: f32 = measure_text(hud, key) + 10.0;
        if (kw < 16.0) {
            kw = 16.0;
        }
        kx: f32 = tx3 + (tw - kw) * 0.5;
        ky: f32 = ty3 + th - 5.0;
        n = put_quad(gverts, 0, kx, ky - 11.0, kx + kw, ky + 3.0);
        if (on2 != 0) {
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.34, 0.26, 0.16, 0.94);
            draw_title_layer(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, kx + 5.0,
                ky, key, 0.98, 0.96, 0.84, 0.72);
        } else {
            draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.20, 0.16, 0.13, 0.88);
            draw_title_layer(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, kx + 5.0,
                ky, key, 0.90, 0.78, 0.66, 0.52);
        }
        slot = slot + 1;
    }
}

type FpsMeter = {
    on: int;
    i: int;
    n: int;
    work0: int;
    flo: f32;
    fhi: f32;
    mlo: f32;
    mhi: f32;
    f_step: f32;
    m_step: f32;
    h_step: f32;
    x_step: f32;
    hlo: f32;
    hhi: f32;
};

is_fps_key(ks: int): int {
    if (ks == 65472) {
        return 1;
    }
    0;
}

is_vsync_key(ks: int): int {
    if (ks == 118 || ks == 86) {
        return 1;
    }
    0;
}

set_vsync(dpy: *i8, win: int, on: int): int {
    iv: int = 0;
    if (on != 0) {
        iv = 1;
    }
    glXSwapIntervalEXT(dpy, win, iv);
    iv;
}

fps_ring(head: int, n: int, k: int): int {
    (head + FPS_CAP - n + k) % FPS_CAP;
}

tick_fps(m: FpsMeter, times: []int, works: []int, rates: []f32, heaps: []int, stall_us: int): FpsMeter {
    now: int = mono_us();
    if (m.work0 > 0) {
        work: int = now - m.work0 - stall_us;
        if (work < 0) {
            work = 0;
        }
        slot: int = m.i;
        times[slot] = now;
        works[slot] = work;
        heaps[slot] = l8_heap_used();
        m.i = (m.i + 1) % FPS_CAP;
        if (m.n < FPS_CAP) {
            m.n = m.n + 1;
        }
        rates[slot] = window_fps(times, m.i, m.n, m.n - 1);
    }
    m;
}

toggle_fps(m: FpsMeter): FpsMeter {
    if (m.on == 0) {
        m.on = 1;
    } else {
        m.on = 0;
    }
    m.i = 0;
    m.n = 0;
    m.work0 = 0;
    m.flo = 0.0;
    m.fhi = 0.0;
    m.mlo = 0.0;
    m.mhi = 0.0;
    m.f_step = 0.0;
    m.m_step = 0.0;
    m.h_step = 0.0;
    m.x_step = 0.0;
    m.hlo = 0.0;
    m.hhi = 0.0;
    m;
}

fps_after_swap(m: FpsMeter): FpsMeter {
    m.work0 = mono_us();
    m;
}

ms_of_us(us: int): f32 {
    us as f32 * 0.001;
}

mb_of_bytes(n: int): f32 {
    n as f32 / 1048576.0;
}

plot_y(v: f32, lo: f32, hi: f32, y0: f32, y1: f32): f32 {
    span: f32 = hi - lo;
    if (span < 0.001) {
        span = 0.001;
    }
    t: f32 = (v - lo) / span;
    if (t < 0.0) {
        t = 0.0;
    }
    if (t > 1.0) {
        t = 1.0;
    }
    y1 - t * (y1 - y0);
}

follow_lo(cur: f32, want: f32, ready: int): f32 {
    if (ready == 0) {
        return want;
    }
    d: f32 = want - cur;
    if (d < 0.0) {
        return cur + d * 0.34;
    }
    cur + d * 0.05;
}

follow_hi(cur: f32, want: f32, ready: int): f32 {
    if (ready == 0) {
        return want;
    }
    d: f32 = want - cur;
    if (d > 0.0) {
        return cur + d * 0.34;
    }
    cur + d * 0.05;
}

axis_pad(lo: f32, hi: f32, min_span: f32, which: int): f32 {
    if (hi < lo) {
        t: f32 = lo;
        lo = hi;
        hi = t;
    }
    span: f32 = hi - lo;
    mid: f32 = (lo + hi) * 0.5;
    if (span < min_span) {
        lo = mid - min_span * 0.5;
        hi = mid + min_span * 0.5;
        span = min_span;
    }
    pad: f32 = span * 0.14;
    lo = lo - pad;
    hi = hi + pad;
    if (lo < 0.0) {
        lo = 0.0;
    }
    if (hi <= lo) {
        hi = lo + min_span;
    }
    if (which == 0) {
        return lo;
    }
    hi;
}

window_fps(times: []int, head: int, n: int, k: int): f32 {
    if (n < 2 || k < 1) {
        return 0.0;
    }
    i1: int = fps_ring(head, n, k);
    t1: int = times[i1];
    j: int = k;
    while (j > 0 && t1 - times[fps_ring(head, n, j - 1)] <= FPS_RATE_US) {
        j = j - 1;
    }
    span: int = t1 - times[fps_ring(head, n, j)];
    count: int = k - j;
    if (count < 2 || span < 16000) {
        return 0.0;
    }
    if (n < FPS_CAP && span < 750000) {
        return 0.0;
    }
    count as f32 * 1000000.0 / span as f32;
}

put_xy(dst: []f32, i: int, x: f32, y: f32): int {
    if (i + 1 >= len(dst)) {
        return i;
    }
    dst[i] = x;
    dst[i + 1] = y;
    i + 2;
}

put_quad(dst: []f32, i: int, x0: f32, y0: f32, x1: f32, y1: f32): int {
    i = put_xy(dst, i, x0, y0);
    i = put_xy(dst, i, x1, y0);
    i = put_xy(dst, i, x1, y1);
    i = put_xy(dst, i, x0, y0);
    i = put_xy(dst, i, x1, y1);
    put_xy(dst, i, x0, y1);
}

put_line(dst: []f32, i: int, x0: f32, y0: f32, x1: f32, y1: f32, w: f32): int {
    dx: f32 = x1 - x0;
    dy: f32 = y1 - y0;
    ln: f32 = sqrt_f32(dx * dx + dy * dy);
    if (ln < 0.001) {
        return i;
    }
    nx: f32 = 0.0 - dy / ln * w * 0.5;
    ny: f32 = dx / ln * w * 0.5;
    i = put_xy(dst, i, x0 + nx, y0 + ny);
    i = put_xy(dst, i, x1 + nx, y1 + ny);
    i = put_xy(dst, i, x1 - nx, y1 - ny);
    i = put_xy(dst, i, x0 + nx, y0 + ny);
    i = put_xy(dst, i, x1 - nx, y1 - ny);
    put_xy(dst, i, x0 - nx, y0 - ny);
}

draw_solid(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    n: int,
    cr: f32,
    cg: f32,
    cb: f32,
    a: f32
) {
    if (n < 6) {
        return;
    }
    glUseProgram(prog);
    glUniform2f(u_screen, 1200.0, 720.0);
    glUniform3f(u_color, cr, cg, cb);
    glUniform1f(u_alpha, a);
    glBindBuffer(34962, vbo);
    glBufferData(34962, n * 4, verts, 35040);
    glDisableVertexAttribArray(1);
    glVertexAttribPointer(0, 2, 5126, 0, 8, 0);
    glDrawArrays(4, 0, n / 2);
}

clear_label(dst: []i8) {
    k: int = 0;
    while (k < len(dst)) {
        dst[k] = 0i8;
        k = k + 1;
    }
}

put_tenths(dst: []i8, i: int, v: f32): int {
    t: int = (v * 10.0 + 0.5) as int;
    i = put_int(dst, i, t / 10);
    i = put_ch(dst, i, '.');
    put_int(dst, i, t % 10);
}

draw_crt_panel(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32
) {
    n: int = put_quad(verts, 0, x0, y0, x1, y1);
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.01, 0.06, 0.02, 0.72);
    n = 0;
    y: f32 = y0 + 2.0;
    while (y < y1) {
        n = put_quad(verts, n, x0, y, x1, y + 1.0);
        y = y + 4.0;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.04, 0.16, 0.06, 0.18);
    n = put_quad(verts, 0, x0, y0, x1, y0 + 1.0);
    n = put_quad(verts, n, x0, y1 - 1.0, x1, y1);
    n = put_quad(verts, n, x0, y0, x0 + 1.0, y1);
    n = put_quad(verts, n, x1 - 1.0, y0, x1, y1);
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.20, 0.70, 0.32, 0.45);
}

draw_hud_text(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    x: f32,
    y: f32,
    s: []i8,
    alpha: f32
) {
    draw_title_layer(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts, x + 1.0, y + 1.0, s,
        alpha * 0.35, 0.0, 0.06, 0.02);
    draw_title_layer(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts, x, y, s, alpha, 0.38,
        0.98, 0.48);
}

first_tick(lo: f32, unit: f32): int {
    if (unit < 0.0001) {
        return 0;
    }
    k: int = (lo / unit) as int;
    if (k < 0) {
        k = 0;
    }
    while ((k as f32) * unit < lo - 0.0005) {
        k = k + 1;
    }
    k;
}

tick_major(k: int, unit: f32, major: f32): int {
    if (unit < 0.001 || major < 0.001) {
        return 0;
    }
    step: int = (major / unit + 0.5) as int;
    if (step < 1) {
        step = 1;
    }
    if (k % step == 0) {
        return 1;
    }
    0;
}

tick_count(lo: f32, hi: f32, unit: f32): int {
    n: int = 0;
    k: int = first_tick(lo, unit);
    while ((k as f32) * unit <= hi + 0.001) {
        n = n + 1;
        k = k + 1;
    }
    n;
}

nice_step(span: f32): f32 {
    if (span < 0.001) {
        span = 0.001;
    }
    target: f32 = span / 3.0;
    if (target <= 0.1) {
        return 0.1;
    }
    base: f32 = 0.1;
    n: int = 0;
    while (n < 8) {
        if (base >= target) {
            return base;
        }
        if (base * 2.0 >= target) {
            return base * 2.0;
        }
        if (base * 5.0 >= target) {
            return base * 5.0;
        }
        base = base * 10.0;
        n = n + 1;
    }
    base;
}

hold_step(cur: f32, span: f32): f32 {
    want: f32 = nice_step(span);
    if (cur < 0.05) {
        return want;
    }
    n: f32 = span / cur;
    if (n >= 2.0 && n <= 3.0) {
        return cur;
    }
    want;
}

tick_major_span(unit: f32): f32 {
    if (unit <= 0.11) {
        return 0.5;
    }
    if (unit <= 0.21) {
        return 1.0;
    }
    if (unit <= 0.51) {
        return 2.0;
    }
    if (unit <= 1.1) {
        return 5.0;
    }
    unit * 2.0;
}

draw_unit_lines(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    x0: f32,
    y0: f32,
    x1: f32,
    y1: f32,
    lo: f32,
    hi: f32,
    unit: f32,
    major: f32
) {
    n: int = 0;
    k: int = first_tick(lo, unit);
    drawn: int = 0;
    while ((k as f32) * unit <= hi + 0.001 && drawn < 4) {
        if (tick_major(k, unit, major) == 0) {
            y: f32 = plot_y((k as f32) * unit, lo, hi, y0, y1);
            n = put_quad(verts, n, x0, y - 0.45, x0 + 6.0, y + 0.45);
            n = put_quad(verts, n, x1 - 6.0, y - 0.45, x1, y + 0.45);
        }
        k = k + 1;
        drawn = drawn + 1;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.18, 0.55, 0.26, 0.42);
    n = 0;
    k = first_tick(lo, unit);
    drawn = 0;
    while ((k as f32) * unit <= hi + 0.001 && drawn < 4) {
        if (tick_major(k, unit, major) != 0) {
            y2: f32 = plot_y((k as f32) * unit, lo, hi, y0, y1);
            n = put_quad(verts, n, x0, y2 - 0.55, x0 + 8.0, y2 + 0.55);
            n = put_quad(verts, n, x1 - 8.0, y2 - 0.55, x1, y2 + 0.55);
        }
        k = k + 1;
        drawn = drawn + 1;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.22, 0.70, 0.34, 0.55);
}

draw_unit_labels(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    lab: []i8,
    x: f32,
    y0: f32,
    y1: f32,
    lo: f32,
    hi: f32,
    unit: f32,
    major: f32,
    tenths: int
) {
    shown: int = tick_count(lo, hi, unit);
    k: int = first_tick(lo, unit);
    labeled: int = 0;
    while ((k as f32) * unit <= hi + 0.001 && labeled < 4) {
        is_maj: int = tick_major(k, unit, major);
        if (is_maj != 0 || shown <= 4) {
            v: f32 = (k as f32) * unit;
            clear_label(lab);
            if (tenths != 0) {
                put_tenths(lab, 0, v);
            } else {
                put_int(lab, 0, (v + 0.5) as int);
            }
            a: f32 = 0.72;
            if (is_maj != 0) {
                a = 0.95;
            }
            draw_hud_text(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts, x,
                plot_y(v, lo, hi, y0, y1) + 4.0, lab, a);
        }
        k = k + 1;
        labeled = labeled + 1;
    }
}

plot_x_at(t: int, t0: int, t1: int, x0: f32, x1: f32): f32 {
    span: int = t1 - t0;
    if (span < 1) {
        span = 1;
    }
    x0 + (t - t0) as f32 / span as f32 * (x1 - x0);
}

align_up(t: int, step: int): int {
    if (step < 1) {
        step = 1;
    }
    r: int = t % step;
    if (r == 0) {
        return t;
    }
    t + (step - r);
}

x_step_us(unit: f32): int {
    us: int = (unit * 1000000.0 + 0.5) as int;
    if (us < 100000) {
        us = 100000;
    }
    us;
}

x_tick_major(t: int, step: int): int {
    if (step >= 1000000) {
        return 1;
    }
    if (t % 1000000 == 0) {
        return 1;
    }
    0;
}

put_pad2(dst: []i8, i: int, n: int): int {
    if (n < 10) {
        i = put_ch(dst, i, '0');
    }
    put_int(dst, i, n);
}

fill_clock(dst: []i8, wall: int, tenths: int) {
    clear_label(dst);
    if (wall < 0) {
        wall = 0;
    }
    s: int = wall / 1000000;
    i: int = put_int(dst, 0, (s / 60) % 60);
    i = put_ch(dst, i, ':');
    i = put_pad2(dst, i, s % 60);
    if (tenths != 0) {
        i = put_ch(dst, i, '.');
        put_int(dst, i, (wall / 100000) % 10);
    }
}

draw_x_lines(
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    vbo: u32,
    verts: []f32,
    x0: f32,
    y1: f32,
    x1: f32,
    t0: int,
    t1: int,
    step: int
) {
    n: int = 0;
    t: int = align_up(t0, step) - step;
    c: int = 0;
    while (t <= t1 + step && c < 8) {
        x: f32 = plot_x_at(t, t0, t1, x0, x1);
        if (x_tick_major(t, step) == 0 && x > x0 - 8.0 && x < x1 + 8.0) {
            n = put_quad(verts, n, x - 0.45, y1 - 6.0, x + 0.45, y1);
        }
        t = t + step;
        c = c + 1;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.18, 0.55, 0.26, 0.42);
    n = 0;
    t = align_up(t0, step) - step;
    c = 0;
    while (t <= t1 + step && c < 8) {
        x2: f32 = plot_x_at(t, t0, t1, x0, x1);
        if (x_tick_major(t, step) != 0 && x2 > x0 - 8.0 && x2 < x1 + 8.0) {
            n = put_quad(verts, n, x2 - 0.55, y1 - 8.0, x2 + 0.55, y1);
        }
        t = t + step;
        c = c + 1;
    }
    draw_solid(prog, u_screen, u_color, u_alpha, vbo, verts, n, 0.22, 0.70, 0.34, 0.55);
}

hud_scissor(x0: f32, y0: f32, x1: f32, y1: f32) {
    w: int = (x1 - x0) as int;
    h: int = (y1 - y0) as int;
    if (w < 1 || h < 1) {
        return;
    }
    glEnable(3089);
    glScissor(x0 as int, 720 - (y1 as int), w, h);
}

hud_unscissor() {
    glDisable(3089);
}

draw_x_labels(
    font: Font,
    prog: int,
    u_screen: int,
    u_color: int,
    u_alpha: int,
    tex: u32,
    vbo: u32,
    verts: []f32,
    lab: []i8,
    x0: f32,
    x1: f32,
    y: f32,
    t0: int,
    t1: int,
    step: int,
    wall_off: int
) {
    tenths: int = 0;
    if (step < 950000) {
        tenths = 1;
    }
    clip_x: int = x0 as int;
    clip_w: int = (x1 - x0) as int;
    if (clip_w < 1) {
        return;
    }
    glEnable(3089);
    glScissor(clip_x, 0, clip_w, 720);
    t: int = align_up(t0, step) - step;
    c: int = 0;
    while (t <= t1 + step && c < 8) {
        x: f32 = plot_x_at(t, t0, t1, x0, x1);
        if (x > x0 - 28.0 && x < x1 + 28.0) {
            fill_clock(lab, t + wall_off, tenths);
            a: f32 = 0.7;
            if (x_tick_major(t, step) != 0) {
                a = 0.9;
            }
            draw_hud_text(font, prog, u_screen, u_color, u_alpha, tex, vbo, verts, x - 16.0, y, lab,
                a);
        }
        t = t + step;
        c = c + 1;
    }
    glDisable(3089);
}

draw_fps(
    hud: Font,
    tprog: int,
    u_tscreen: int,
    u_tcolor: int,
    u_talpha: int,
    htex: u32,
    tvbo: u32,
    tverts: []f32,
    gprog: int,
    u_gscreen: int,
    u_gcolor: int,
    u_galpha: int,
    gvbo: u32,
    gverts: []f32,
    m: FpsMeter,
    times: []int,
    works: []int,
    rates: []f32,
    heaps: []int,
    lab: []i8
): FpsMeter {
    if (m.on == 0 || m.n < 1) {
        return m;
    }
    py0: f32 = 28.0;
    py1: f32 = 100.0;
    fx0: f32 = 46.0;
    fx1: f32 = 386.0;
    mx0: f32 = 440.0;
    mx1: f32 = 780.0;
    hx0: f32 = 834.0;
    hx1: f32 = 1182.0;
    last: int = fps_ring(m.i, m.n, m.n - 1);
    t1: int = times[last];
    t0: int = t1 - FPS_SPAN_US;
    span: int = FPS_SPAN_US;
    flo: f32 = 0.0;
    fhi: f32 = 0.0;
    have_f: int = 0;
    last_ms: f32 = ms_of_us(works[last]);
    last_fps: f32 = rates[last];
    last_mb: f32 = mb_of_bytes(heaps[last]);
    mlo: f32 = last_ms;
    mhi: f32 = last_ms;
    hlo: f32 = last_mb;
    hhi: f32 = last_mb;
    k: int = 0;
    while (k < m.n) {
        ms: f32 = ms_of_us(works[fps_ring(m.i, m.n, k)]);
        if (ms < mlo) {
            mlo = ms;
        }
        if (ms > mhi) {
            mhi = ms;
        }
        hb: f32 = mb_of_bytes(heaps[fps_ring(m.i, m.n, k)]);
        if (hb < hlo) {
            hlo = hb;
        }
        if (hb > hhi) {
            hhi = hb;
        }
        fpsv: f32 = rates[fps_ring(m.i, m.n, k)];
        if (fpsv > 0.001) {
            if (have_f == 0) {
                flo = fpsv;
                fhi = fpsv;
                have_f = 1;
            }
            if (fpsv < flo) {
                flo = fpsv;
            }
            if (fpsv > fhi) {
                fhi = fpsv;
            }
        }
        k = k + 1;
    }
    if (have_f == 0) {
        flo = 0.0;
        fhi = 120.0;
    }
    raw_flo: f32 = flo;
    raw_fhi: f32 = fhi;
    flo = axis_pad(raw_flo, raw_fhi, 0.8, 0);
    fhi = axis_pad(raw_flo, raw_fhi, 0.8, 1);
    raw_mlo: f32 = mlo;
    raw_mhi: f32 = mhi;
    mlo = axis_pad(raw_mlo, raw_mhi, 0.2, 0);
    mhi = axis_pad(raw_mlo, raw_mhi, 0.2, 1);
    raw_hlo: f32 = hlo;
    raw_hhi: f32 = hhi;
    hlo = axis_pad(raw_hlo, raw_hhi, 0.05, 0);
    hhi = axis_pad(raw_hlo, raw_hhi, 0.05, 1);
    ready: int = 0;
    if (m.fhi > m.flo + 0.001 && m.mhi > m.mlo + 0.001 && m.hhi > m.hlo + 0.001) {
        ready = 1;
    }
    flo = follow_lo(m.flo, flo, ready);
    fhi = follow_hi(m.fhi, fhi, ready);
    mlo = follow_lo(m.mlo, mlo, ready);
    mhi = follow_hi(m.mhi, mhi, ready);
    hlo = follow_lo(m.hlo, hlo, ready);
    hhi = follow_hi(m.hhi, hhi, ready);
    if (fhi <= flo) {
        fhi = flo + 0.8;
    }
    if (mhi <= mlo) {
        mhi = mlo + 0.2;
    }
    if (hhi <= hlo) {
        hhi = hlo + 0.05;
    }
    fps_unit: f32 = hold_step(m.f_step, fhi - flo);
    ms_unit: f32 = hold_step(m.m_step, mhi - mlo);
    heap_unit: f32 = hold_step(m.h_step, hhi - hlo);
    x_span: f32 = span as f32 / 1000000.0;
    x_unit: f32 = hold_step(m.x_step, x_span);
    m.flo = flo;
    m.fhi = fhi;
    m.mlo = mlo;
    m.mhi = mhi;
    m.hlo = hlo;
    m.hhi = hhi;
    m.f_step = fps_unit;
    m.m_step = ms_unit;
    m.h_step = heap_unit;
    m.x_step = x_unit;
    fps_major: f32 = tick_major_span(fps_unit);
    ms_major: f32 = tick_major_span(ms_unit);
    heap_major: f32 = tick_major_span(heap_unit);
    x_us: int = x_step_us(x_unit);
    wall_off: int = wall_us() - mono_us();
    draw_crt_panel(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 10.0, 10.0, 394.0, 118.0);
    draw_crt_panel(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 404.0, 10.0, 788.0, 118.0);
    draw_crt_panel(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, 798.0, 10.0, 1190.0, 118.0);
    draw_unit_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, fx0, py0, fx1, py1, flo, fhi,
        fps_unit, fps_major);
    draw_unit_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, mx0, py0, mx1, py1, mlo, mhi,
        ms_unit, ms_major);
    draw_unit_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, hx0, py0, hx1, py1, hlo, hhi,
        heap_unit, heap_major);
    draw_x_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, fx0, py1, fx1, t0, t1, x_us);
    draw_x_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, mx0, py1, mx1, t0, t1, x_us);
    draw_x_lines(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, hx0, py1, hx1, t0, t1, x_us);
    n: int = 0;
    k = 0;
    px: f32 = 0.0;
    py: f32 = 0.0;
    have: int = 0;
    while (k < m.n) {
        ix2: int = fps_ring(m.i, m.n, k);
        fpsv2: f32 = rates[ix2];
        if (fpsv2 > 0.001) {
            x2: f32 = fx0 + (times[ix2] - t0) as f32 / span as f32 * (fx1 - fx0);
            y2: f32 = plot_y(fpsv2, flo, fhi, py0, py1);
            if (have != 0) {
                n = put_line(gverts, n, px, py, x2, y2, 1.6);
            }
            px = x2;
            py = y2;
            have = 1;
        }
        k = k + 1;
    }
    hud_scissor(fx0, py0, fx1, py1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.40, 1.0, 0.50, 0.95);
    n = 0;
    k = 0;
    while (k < m.n) {
        ix: int = fps_ring(m.i, m.n, k);
        x: f32 = mx0 + (times[ix] - t0) as f32 / span as f32 * (mx1 - mx0);
        y: f32 = plot_y(ms_of_us(works[ix]), mlo, mhi, py0, py1);
        n = put_quad(gverts, n, x - 1.3, y - 1.3, x + 1.3, y + 1.3);
        k = k + 1;
    }
    hud_scissor(mx0, py0, mx1, py1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.62, 1.0, 0.42, 0.92);
    n = 0;
    k = 0;
    px = 0.0;
    py = 0.0;
    have = 0;
    while (k < m.n) {
        ix3: int = fps_ring(m.i, m.n, k);
        x3: f32 = hx0 + (times[ix3] - t0) as f32 / span as f32 * (hx1 - hx0);
        y3: f32 = plot_y(mb_of_bytes(heaps[ix3]), hlo, hhi, py0, py1);
        if (have != 0) {
            n = put_line(gverts, n, px, py, x3, y3, 1.6);
        }
        px = x3;
        py = y3;
        have = 1;
        k = k + 1;
    }
    hud_scissor(hx0, py0, hx1, py1);
    draw_solid(gprog, u_gscreen, u_gcolor, u_galpha, gvbo, gverts, n, 0.95, 0.85, 0.28, 0.95);
    hud_unscissor();
    glEnableVertexAttribArray(1);
    clear_label(lab);
    i: int = put_str(lab, 0, "FPS ");
    if (last_fps > 0.001) {
        i = put_int(lab, i, (last_fps + 0.5) as int);
    }
    draw_hud_text(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, 18.0, 22.0, lab, 0.95);
    clear_label(lab);
    i = put_str(lab, 0, "MS ");
    i = put_tenths(lab, i, last_ms);
    draw_hud_text(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, 412.0, 22.0, lab, 0.95);
    clear_label(lab);
    i = put_str(lab, 0, "MEM ");
    i = put_tenths(lab, i, last_mb);
    i = put_ch(lab, i, 'M');
    draw_hud_text(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, 806.0, 22.0, lab, 0.95);
    fps_dec: int = 0;
    if (fps_unit < 0.95) {
        fps_dec = 1;
    }
    ms_dec: int = 0;
    if (ms_unit < 0.95) {
        ms_dec = 1;
    }
    heap_dec: int = 0;
    if (heap_unit < 0.95) {
        heap_dec = 1;
    }
    draw_unit_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab, 14.0, py0,
        py1, flo, fhi, fps_unit, fps_major, fps_dec);
    draw_unit_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab, 408.0, py0,
        py1, mlo, mhi, ms_unit, ms_major, ms_dec);
    draw_unit_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab, 802.0, py0,
        py1, hlo, hhi, heap_unit, heap_major, heap_dec);
    draw_x_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab, fx0, fx1, 114.0,
        t0, t1, x_us, wall_off);
    draw_x_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab, mx0, mx1, 114.0,
        t0, t1, x_us, wall_off);
    draw_x_labels(hud, tprog, u_tscreen, u_tcolor, u_talpha, htex, tvbo, tverts, lab, hx0, hx1, 114.0,
        t0, t1, x_us, wall_off);
    m;
}

copy_rooms(dst: []Room, src: []Room, n: int) {
    i: int = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
}

copy_goals(dst: []Goal, src: []Goal, n: int) {
    i: int = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
}

copy_bricks(dst: []Brick, src: []Brick, n: int) {
    i: int = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
}

copy_room_starts(dst_c: []int, dst_r: []int, dst_h: []int, src_c: []int, src_r: []int, src_h: []int) {
    i: int = 0;
    while (i < LEVEL_MAX_ROOMS) {
        dst_c[i] = src_c[i];
        dst_r[i] = src_r[i];
        dst_h[i] = src_h[i];
        i = i + 1;
    }
}

preview_room_transform(
    src_blocks: []Block,
    n: int,
    src_rooms: []Room,
    nroom: int,
    src_goals: []Goal,
    ngoal: int,
    src_bricks: []Brick,
    nbrick: int,
    src_ground: []GroundCell,
    nground: int,
    src_start: []int,
    src_sc: []int,
    src_sr: []int,
    src_has: []int,
    blocks: []Block,
    rooms: []Room,
    goals: []Goal,
    bricks: []Brick,
    ground: []GroundCell,
    start: []int,
    start_c: []int,
    start_r: []int,
    has_start: []int,
    sel: int,
    dc: int,
    dr: int,
    rot: int,
    xy: []int
) {
    copy_blocks(blocks, 0, src_blocks, 0, n);
    copy_rooms(rooms, src_rooms, nroom);
    copy_goals(goals, src_goals, ngoal);
    copy_bricks(bricks, src_bricks, nbrick);
    copy_ground(ground, src_ground, nground);
    start[0] = src_start[0];
    start[1] = src_start[1];
    copy_room_starts(start_c, start_r, has_start, src_sc, src_sr, src_has);
    transform_room_contents(blocks, n, goals, ngoal, bricks, nbrick, ground, nground, rooms, sel,
        dc, dr, rot, start, xy, start_c, start_r, has_start);
}

draw_hedges(
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_lag: int,
    brick_buf: u32,
    brick_n: int,
    u_brick: int
) {
    glUniform2f(u_lag, 0.0, 0.0);
    bind_brick_mesh(brick_buf);
    glUniform1f(u_brick, 1.0);
    glUniform3f(u_origin, 0.0, 0.0, 0.0);
    glUniform3f(u_scale, 1.0, 1.0, 1.0);
    glUniform3f(u_color, 0.62, 0.32, 0.26);
    glDrawArrays(4, 0, brick_n / 9);
    glUniform1f(u_brick, 0.0);
}

paint_stamp_layer(blocks: []Block, n: int, col: int, row: int, brush: int): int {
    if (brush == BRUSH_BLOCK) {
        return free_layer_at(blocks, n, col, row, 0);
    }
    if (brush == BRUSH_RAMP) {
        top: int = highest_layer_at(blocks, n, col, row);
        if (top < 0) {
            return 0;
        }
        top + 1;
    } else {
        0;
    }
}

draw_paint_stamp(
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_cut: int,
    u_ramp: int,
    u_brick: int,
    cube_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    prism_buf: u32,
    brick_buf: u32,
    chamfer_n: int,
    brick_n: int,
    shape_verts: []f32,
    px: f32,
    py: f32,
    pz: f32,
    brush: int,
    shape: int
) {
    y: f32 = py;
    if (brush == BRUSH_DIRT) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.06, pz, 0.96, 0.08, 0.96, 0.55, 0.36, 0.18, 36);
    } else if (brush == BRUSH_GRASS) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.06, pz, 0.96, 0.08, 0.96, 0.34, 0.58, 0.22, 36);
    } else if (brush == BRUSH_STONE) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.06, pz, 0.96, 0.08, 0.96, 0.58, 0.58, 0.55, 36);
    } else if (brush == BRUSH_BLOCK) {
        if (shape == 0) {
            bind_mesh(chamfer_buf);
            glUniform1f(u_cut, 1.0);
            draw_box(u_origin, u_scale, u_color, px, y, pz, 0.92, 1.0, 0.92, 0.18, 0.62, 0.48,
                chamfer_n / 6);
            glUniform1f(u_cut, 0.0);
        } else {
            bind_mesh(prism_buf);
            glUniform3f(u_origin, px, y, pz);
            glUniform3f(u_scale, 1.0, 1.0, 1.0);
            glUniform3f(u_color, 0.988, 0.827, 0.302);
            nf: int = fill_prism(shape_verts, shape);
            if (nf > 0) {
                glBufferData(34962, nf * 4, shape_verts, 35040);
                glDrawArrays(4, 0, nf / 6);
            }
        }
    } else if (brush == BRUSH_RAMP) {
        rd: int = shape;
        if (rd < 1 || rd > 4) {
            rd = 1;
        }
        bind_mesh(ramp_buf);
        glUniform1f(u_cut, 1.0);
        glUniform3f(u_scale, 0.92, 1.0, 0.92);
        glUniform3f(u_color, 0.82, 0.48, 0.22);
        glUniform3f(u_origin, px, y, pz);
        glDrawArrays(4, (rd - 1) * (chamfer_n / 6), chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_BRICK) {
        bind_mesh(cube_buf);
        draw_box(u_origin, u_scale, u_color, px, 0.42, pz, 0.22, 0.84, 0.96, 0.62, 0.32, 0.26, 36);
    } else if (brush == BRUSH_GOAL) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, px, 0.16, pz, 0.62, 0.18, 0.62, 0.90, 0.74, 0.28,
            chamfer_n / 6);
        draw_box(u_origin, u_scale, u_color, px, 0.42, pz, 0.22, 0.22, 0.22, 0.96, 0.82, 0.32,
            chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_START) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, px, 0.55, pz, 0.86, 1.1, 0.86, 0.80, 0.30, 0.24,
            chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    } else if (brush == BRUSH_ROOM_START) {
        bind_mesh(chamfer_buf);
        glUniform1f(u_cut, 1.0);
        draw_box(u_origin, u_scale, u_color, px, 0.42, pz, 0.70, 0.84, 0.70, 0.22, 0.66, 0.72,
            chamfer_n / 6);
        glUniform1f(u_cut, 0.0);
    }
}

draw_paint_previews(
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_cut: int,
    u_ramp: int,
    u_lag: int,
    u_brick: int,
    cube_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    prism_buf: u32,
    brick_buf: u32,
    chamfer_n: int,
    brick_n: int,
    shape_verts: []f32,
    blocks: []Block,
    n: int,
    cur_c: int,
    cur_r: int,
    vis_x: f32,
    vis_y: f32,
    vis_z: f32,
    pend_c: int,
    pend_r: int,
    want_pend: int,
    brush: int,
    shape: int
) {
    c0: int = cur_c;
    r0: int = cur_r;
    c1: int = cur_c;
    r1: int = cur_r;
    if (want_pend != 0) {
        c0 = pend_c;
        r0 = pend_r;
    }
    if (c1 < c0) {
        t: int = c0;
        c0 = c1;
        c1 = t;
    }
    if (r1 < r0) {
        t2: int = r0;
        r0 = r1;
        r1 = t2;
    }
    glUniform2f(u_ramp, 0.0, 0.0);
    glUniform2f(u_lag, 0.0, 0.0);
    r: int = r0;
    while (r <= r1) {
        c: int = c0;
        while (c <= c1) {
            px: f32 = c as f32 + 0.5;
            pz: f32 = r as f32 + 0.5;
            if (c == cur_c && r == cur_r) {
                px = vis_x;
                pz = vis_z;
            }
            layer: int = paint_stamp_layer(blocks, n, c, r, brush);
            py: f32 = layer as f32 + 0.5;
            if (c == cur_c && r == cur_r && (brush == BRUSH_BLOCK || brush == BRUSH_RAMP)) {
                py = vis_y + 0.48;
            }
            if (layer >= 0 && layer < LEVEL_MAX_LAYER) {
                draw_paint_stamp(u_origin, u_scale, u_color, u_cut, u_ramp, u_brick, cube_buf,
                    chamfer_buf, ramp_buf, prism_buf, brick_buf, chamfer_n, brick_n, shape_verts, px,
                    py, pz, brush, shape);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    bind_mesh(cube_buf);
    glUniform1f(u_cut, 0.0);
    glUniform1f(u_brick, 0.0);
}

draw_room_start_pads(
    u_origin: int,
    u_scale: int,
    u_color: int,
    cube_buf: u32,
    start_c: []int,
    start_r: []int,
    has: []int,
    nroom: int
) {
    bind_mesh(cube_buf);
    i: int = 0;
    while (i < nroom) {
        if (i < LEVEL_MAX_ROOMS && has[i] != 0) {
            draw_box(u_origin, u_scale, u_color, start_c[i] as f32 + 0.5, 0.08,
                start_r[i] as f32 + 0.5, 0.62, 0.10, 0.62, 0.22, 0.66, 0.72, 36);
        }
        i = i + 1;
    }
}

draw_frame(
    prog: int,
    dprog: int,
    u_vp: int,
    u_origin: int,
    u_scale: int,
    u_color: int,
    u_light: int,
    u_light_vp: int,
    u_lag: int,
    d_vp: int,
    d_origin: int,
    d_scale: int,
    d_color: int,
    d_lag: int,
    cube_buf: u32,
    prism_buf: u32,
    chamfer_buf: u32,
    ramp_buf: u32,
    chamfer_n: int,
    brick_buf: u32,
    brick_n: int,
    fbo: u32,
    stex: u32,
    ctex: u32,
    cmask: []i8,
    ground_cells: []GroundCell,
    nground: int,
    rooms: []Room,
    nroom: int,
    focus_x: f32,
    focus_z: f32,
    camera_x: f32,
    camera_y: f32,
    camera_z: f32,
    u_mask_origin: int,
    vp: []f32,
    lcam: []f32,
    lvp: []f32,
    lx: f32,
    ly: f32,
    lz: f32,
    hist: []Block,
    foff: int,
    toff: int,
    n: int,
    px: f32,
    py: f32,
    pz: f32,
    t: f32,
    shape_verts: []f32,
    lagx: []f32,
    lagz: []f32,
    want_player: int,
    cur_c: int,
    cur_r: int,
    cur_l: int,
    vis_x: f32,
    vis_y: f32,
    vis_z: f32,
    want_cursor: int,
    ground_brush: int,
    brush_shape: int,
    move_mode: int,
    move_sel: int,
    move_ok: int,
    pend_c: int,
    pend_r: int,
    want_pend: int,
    u_ramp: int,
    u_ground: int,
    u_cut: int,
    u_fade: int,
    u_brick: int,
    d_ramp: int,
    pru_x: f32,
    pru_z: f32,
    present_us: []int,
    mask_cache: []int,
    lean_to: []int,
    lean_from: []int,
    id_to: []int,
    id_from: []int,
    cell_head: []int,
    cell_link: []int,
    ghosts: []int,
    ghost_amt: []f32,
    block_t: []f32,
    prep_cache: []int,
    sparks: []Spark,
    bprog: int,
    b_u: []int,
    bbuf: u32,
    bdprog: int,
    bd_u: []int,
    grass_prog: int,
    grass_u: []int,
    grass_blade_buf: u32,
    grass_instance_buf: u32,
    grass_instances: []f32,
    grass_blade_n: int
) {
    pfc: int = floor_i(focus_x);
    pfr: int = floor_i(focus_z);
    reuse: int = 0;
    if (prep_cache[7] != 0 && prep_cache[0] == foff && prep_cache[1] == toff && prep_cache[2] == n) {
        dfc: int = pfc - prep_cache[5];
        dfr: int = pfr - prep_cache[6];
        if (dfc < 0) {
            dfc = 0 - dfc;
        }
        if (dfr < 0) {
            dfr = 0 - dfr;
        }
        if (dfc < 3 && dfr < 3) {
            reuse = 1;
        }
    }
    has_lean: int = 0;
    split_hist: int = 0;
    nvis: int = 0;
    if (reuse != 0) {
        has_lean = prep_cache[3];
        split_hist = prep_cache[4];
        if (split_hist != 0) {
            nvis = fill_draw_vis(hist, foff, toff, n, cell_link, id_from, focus_x, focus_z);
        } else {
            nvis = fill_draw_vis(hist, foff, toff, n, cell_link, id_to, focus_x, focus_z);
        }
    } else {
        has_lean = prep_block_draw(hist, toff, n, lean_to, id_to, cell_head, cell_link, focus_x, focus_z);
        if (foff != toff && same_hist_slot(hist, foff, toff, n) == 0) {
            fill_from_leans(hist, foff, toff, n, lean_from, lean_to, id_from, cell_head, cell_link, focus_x, focus_z);
            split_hist = 1;
            nvis = fill_draw_vis(hist, foff, toff, n, cell_link, id_from, focus_x, focus_z);
        } else {
            nvis = fill_draw_vis(hist, foff, toff, n, cell_link, id_to, focus_x, focus_z);
        }
        prep_cache[0] = foff;
        prep_cache[1] = toff;
        prep_cache[2] = n;
        prep_cache[3] = has_lean;
        prep_cache[4] = split_hist;
        prep_cache[5] = pfc;
        prep_cache[6] = pfr;
        prep_cache[7] = 1;
    }
    stall0: int = mono_us();
    glBindFramebuffer(36160, fbo);
    glViewport(0, 0, SHADOW_SIZE, SHADOW_SIZE);
    glClear(256);
    present_us[0] = mono_us() - stall0;
    glEnable(32823);
    glPolygonOffset(2.0, 4.0);
    glUseProgram(dprog);
    glUniform2f(d_ramp, 0.0, 0.0);
    glUniformMatrix4fv(d_vp, 1, 0, lcam);
    draw_hedges(d_origin, d_scale, d_color, d_lag, brick_buf, brick_n, 0 - 1);
    if (split_hist != 0) {
        draw_casters(d_origin, d_scale, d_color, chamfer_buf, prism_buf, ramp_buf, chamfer_n,
            hist, foff, toff, n, px, py, pz, t, shape_verts, d_lag, lagx, lagz, want_player,
            d_ramp, pru_x, pru_z, 0 - 1, 0 - 1, lean_to, lean_from, id_from, has_lean, cell_link,
            nvis, ghosts, 1, block_t, ghost_amt);
    } else {
        draw_casters(d_origin, d_scale, d_color, chamfer_buf, prism_buf, ramp_buf, chamfer_n,
            hist, foff, toff, n, px, py, pz, t, shape_verts, d_lag, lagx, lagz, want_player,
            d_ramp, pru_x, pru_z, 0 - 1, 0 - 1, lean_to, lean_to, id_to, has_lean, cell_link, nvis,
            ghosts, 1, block_t, ghost_amt);
    }
    glDisable(32823);
    glUseProgram(bdprog);
    glUniformMatrix4fv(bd_u[0], 1, 0, lcam);
    bind_mesh(bbuf);
    draw_sparks(bd_u[1], bd_u[2], bd_u[3], bd_u[4], bd_u[5], bd_u[6], sparks, focus_x,
        focus_z, lx, ly, lz, lx, 0.0, lz, 0.0, 0.0, 0.0 - 1.0);
    stall1: int = mono_us();
    glBindFramebuffer(36160, 0u32);
    glDrawBuffer(1029);
    glReadBuffer(1029);
    glViewport(0, 0, 1200, 720);
    glClear(16640);
    present_us[0] = present_us[0] + (mono_us() - stall1);
    glUseProgram(prog);
    glBindTexture(3553, stex);
    glUniformMatrix4fv(u_vp, 1, 0, vp);
    glUniformMatrix4fv(u_light_vp, 1, 0, lvp);
    glUniform3f(u_light, lx, ly, lz);
    glUniform2f(u_lag, 0.0, 0.0);
    glUniform2f(u_ramp, 0.0, 0.0);
    bind_mesh(cube_buf);
    origin_c: int = mask_cache[0];
    origin_r: int = mask_cache[1];
    fc: int = floor_i(focus_x);
    fr: int = floor_i(focus_z);
    mkey: int = ground_mask_key(ground_cells, nground);
    need_mask: int = 0;
    if (origin_c < 0 - 999998 || mkey != mask_cache[2]) {
        need_mask = 1;
    } else if (fc - MASK_PAD < origin_c || fc + MASK_PAD >= origin_c + MASK_SIZE) {
        need_mask = 1;
    } else if (fr - MASK_PAD < origin_r || fr + MASK_PAD >= origin_r + MASK_SIZE) {
        need_mask = 1;
    }
    if (need_mask != 0) {
        origin_c = fc - MASK_HALF;
        origin_r = fr - MASK_HALF;
        fill_ground_mask(cmask, ground_cells, nground, origin_c, origin_r);
        mask_cache[0] = origin_c;
        mask_cache[1] = origin_r;
        mask_cache[2] = mkey;
    }
    glActiveTexture(33985);
    glBindTexture(3553, ctex);
    if (need_mask != 0) {
        glPixelStorei(3317, 1);
        glTexSubImage2D(3553, 0, 0, 0, MASK_SIZE, MASK_SIZE, 6409, 5121, cmask);
    }
    glActiveTexture(33984);
    glBindTexture(3553, stex);
    glUniform2f(u_mask_origin, origin_c as f32, origin_r as f32);
    glUniform1f(u_ground, 1.0);
    draw_box(u_origin, u_scale, u_color, focus_x, 0.0 - 0.08, focus_z, 80.0, 0.12, 80.0,
        0.22, 0.20, 0.18, 36);
    glUniform1f(u_ground, 0.0);
    draw_instanced_grass(grass_prog, grass_u, grass_blade_buf, grass_instance_buf,
        grass_instances, grass_blade_n, ground_cells, nground, focus_x, focus_z,
        px + 0.5, pz + 0.5, lagx[1023], lagz[1023], lx, ly, lz, vp, lvp, stex, ctex,
        origin_c, origin_r);
    glUseProgram(prog);
    draw_hedges(u_origin, u_scale, u_color, u_lag, brick_buf, brick_n, u_brick);
    bind_mesh(cube_buf);
    if (want_cursor != 0 && want_player != 0) {
        draw_box(u_origin, u_scale, u_color, px + 0.5, 0.04, pz + 0.5, 0.80, 0.06, 0.80,
            0.80, 0.30, 0.24, 36);
    }
    if (want_cursor != 0) {
        if (want_pend != 0) {
            anchor_r: f32 = 0.55;
            anchor_g: f32 = 0.36;
            anchor_b: f32 = 0.18;
            if (ground_brush == BRUSH_GRASS) {
                anchor_r = 0.34;
                anchor_g = 0.58;
                anchor_b = 0.22;
            } else if (ground_brush == BRUSH_STONE) {
                anchor_r = 0.58;
                anchor_g = 0.58;
                anchor_b = 0.55;
            } else if (ground_brush == BRUSH_BLOCK) {
                anchor_r = 0.18;
                anchor_g = 0.62;
                anchor_b = 0.48;
            } else if (ground_brush == BRUSH_RAMP) {
                anchor_r = 0.82;
                anchor_g = 0.48;
                anchor_b = 0.22;
            } else if (ground_brush == BRUSH_BRICK) {
                anchor_r = 0.62;
                anchor_g = 0.32;
                anchor_b = 0.26;
            } else if (ground_brush == BRUSH_GOAL) {
                anchor_r = 0.86;
                anchor_g = 0.72;
                anchor_b = 0.28;
            } else if (ground_brush == BRUSH_START) {
                anchor_r = 0.80;
                anchor_g = 0.30;
                anchor_b = 0.24;
            } else if (ground_brush == BRUSH_ROOM_START) {
                anchor_r = 0.22;
                anchor_g = 0.66;
                anchor_b = 0.72;
            }
            draw_box(u_origin, u_scale, u_color, pend_c as f32 + 0.5, 0.08, pend_r as f32 + 0.5,
                0.86, 0.08, 0.86, anchor_r, anchor_g, anchor_b, 36);
            pcx: f32 = (pend_c + cur_c + 1) as f32 * 0.5;
            pcz: f32 = (pend_r + cur_r + 1) as f32 * 0.5;
            pww: f32 = (pend_c - cur_c) as f32;
            if (pww < 0.0) {
                pww = 0.0 - pww;
            }
            pww = pww + 1.0;
            phh: f32 = (pend_r - cur_r) as f32;
            if (phh < 0.0) {
                phh = 0.0 - phh;
            }
            phh = phh + 1.0;
            draw_box(u_origin, u_scale, u_color, pcx, 0.05, pend_r as f32 + 0.5, pww, 0.04,
                0.08, anchor_r, anchor_g, anchor_b, 36);
            draw_box(u_origin, u_scale, u_color, pcx, 0.05, cur_r as f32 + 0.5, pww, 0.04,
                0.08, anchor_r, anchor_g, anchor_b, 36);
            draw_box(u_origin, u_scale, u_color, pend_c as f32 + 0.5, 0.05, pcz, 0.08, 0.04,
                phh, anchor_r, anchor_g, anchor_b, 36);
            draw_box(u_origin, u_scale, u_color, cur_c as f32 + 0.5, 0.05, pcz, 0.08, 0.04,
                phh, anchor_r, anchor_g, anchor_b, 36);
        }
    }
    if (split_hist != 0) {
        draw_casters(u_origin, u_scale, u_color, chamfer_buf, prism_buf, ramp_buf, chamfer_n,
            hist, foff, toff, n, px, py, pz, t, shape_verts, u_lag, lagx, lagz, want_player,
            u_ramp, pru_x, pru_z, u_cut, u_fade, lean_to, lean_from, id_from, has_lean, cell_link,
            nvis, ghosts, 0, block_t, ghost_amt);
    } else {
        draw_casters(u_origin, u_scale, u_color, chamfer_buf, prism_buf, ramp_buf, chamfer_n,
            hist, foff, toff, n, px, py, pz, t, shape_verts, u_lag, lagx, lagz, want_player,
            u_ramp, pru_x, pru_z, u_cut, u_fade, lean_to, lean_to, id_to, has_lean, cell_link, nvis,
            ghosts, 0, block_t, ghost_amt);
    }
    if (want_cursor != 0) {
        draw_paint_previews(u_origin, u_scale, u_color, u_cut, u_ramp, u_lag, u_brick, cube_buf,
            chamfer_buf, ramp_buf, prism_buf, brick_buf, chamfer_n, brick_n, shape_verts, hist, n,
            cur_c, cur_r, vis_x, vis_y, vis_z, pend_c, pend_r, want_pend, ground_brush, brush_shape);
        draw_room_outlines(u_origin, u_scale, u_color, cube_buf, rooms, nroom, move_mode,
            move_sel, move_ok);
    }
    glUseProgram(bprog);
    glUniformMatrix4fv(b_u[0], 1, 0, vp);
    glUniform3f(b_u[6], lx, ly, lz);
    glUniformMatrix4fv(b_u[7], 1, 0, lvp);
    glBindTexture(3553, stex);
    bind_mesh(bbuf);
    glEnable(3042);
    glBlendFunc(770, 1);
    glDepthMask(0);
    glUniform1f(b_u[10], mono_ms() as f32 * 0.001);
    draw_sparks(b_u[1], b_u[2], b_u[3], b_u[4], b_u[5], b_u[9], sparks, focus_x, focus_z,
        camera_x, camera_y, camera_z, focus_x, 0.0, focus_z, 0.0, 1.0, 0.0);
    glDepthMask(1);
    glDisable(3042);
    glUseProgram(prog);
}

main(argc: int, argv: [][z]i8): int {
    edit_mode: int = 0;
    path_i: int = 1;
    if (argc >= 2) {
        if (arg_eq(argv[1], "edit")) {
            edit_mode = 1;
            path_i = 2;
        } else if (arg_eq(argv[1], "play")) {
            path_i = 2;
        }
    }
    path: []i8 = level_path_at(argc, argv, path_i);
    empty: Block = Block {
        id: 0 - 1,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    src: []Block = new Block[2048](empty);
    empty_room: Room = Room {
        x0: 0,
        y0: 0,
        x1: 0,
        y1: 0
    };
    empty_goal: Goal = Goal {
        column: 0,
        row: 0
    };
    empty_brick: Brick = Brick {
        column: 0,
        row: 0
    };
    empty_ground: GroundCell = GroundCell {
        column: 0,
        row: 0,
        style: GROUND_DIRT,
        stone: 0
    };
    rooms: []Room = new Room[64](empty_room);
    titles: [][]i8 = new []i8[64](new i8[0](0i8));
    goals: []Goal = new Goal[64](empty_goal);
    bricks: []Brick = new Brick[2048](empty_brick);
    ground_cells: []GroundCell = new GroundCell[LEVEL_MAX_GROUND](empty_ground);
    nroom_slot: []int = new int[1](0);
    ngoal_slot: []int = new int[1](0);
    nbrick_slot: []int = new int[1](0);
    nground_slot: []int = new int[1](0);
    n: int = 0;
    nroom: int = 0;
    ngoal: int = 0;
    nbrick: int = 0;
    nground: int = 0;
    startp: []int = new int[2](0);
    room_sc: []int = new int[LEVEL_MAX_ROOMS](0);
    room_sr: []int = new int[LEVEL_MAX_ROOMS](0);
    room_has: []int = new int[LEVEL_MAX_ROOMS](0);
    is_world: int = 0;
    pnames: [][]i8 = new []i8[64](new i8[0](0i8));
    dones: [][]i8 = new []i8[64](new i8[0](0i8));
    ndone: int = 0;
    ndone_slot: []int = new int[1](0);
    solved: []int = new int[64](0);
    empty_spark: Spark = Spark {
        x: 0.0,
        y: 0.0,
        z: 0.0,
        vx: 0.0,
        vy: 0.0,
        vz: 0.0,
        life: 0.0,
        kind: 0,
        room: 0 - 1,
        blue: 0.0
    };
    sparks: []Spark = new Spark[SPARK_N](empty_spark);
    spark_rng: []int = new int[1](1);
    spark_acc: []f32 = new f32[3](0.0);
    finish_acc: []f32 = new f32[64](0.0);
    spark_xy: []int = new int[2](0);
    spark_last: []int = new int[1](0);
    stream_until: []int = new int[64](0);
    stream_tx: []f32 = new f32[64](0.0);
    stream_tz: []f32 = new f32[64](0.0);
    fd0: int = open_path(path, 0, 0);
    if (fd0 < 0) {
        if (edit_mode == 0) {
            write(2, "cannot load level ", len("cannot load level "));
            write(2, path, len(path));
            write(2, "\n", 1);
            return 1;
        }
        if (titles_eq(path, LEVEL_DEFAULT_PATH)) {
            is_world = 1;
        } else {
            nroom = set_room_size(rooms, titles, 0, 12, 9);
        }
        write(2, "new ", len("new "));
        write(2, path, len(path));
        write(2, "\n", 1);
    } else {
        close(fd0);
        raw: []i8 = slurp_path(path);
        if (looks_like_world(raw)) {
            is_world = 1;
            n = load_unified_world(path, pnames, rooms, titles, nroom_slot, src, goals,
                ngoal_slot, bricks, nbrick_slot, ground_cells, nground_slot, startp, dones,
                ndone_slot);
            if (n < 0) {
                write(2, "cannot load world ", len("cannot load world "));
                write(2, path, len(path));
                write(2, "\n", 1);
                return 1;
            }
            ndone = ndone_slot[0];
            nroom = nroom_slot[0];
            ngoal = ngoal_slot[0];
            nbrick = nbrick_slot[0];
            nground = nground_slot[0];
        } else {
            n = load_any(path, src, rooms, titles, nroom_slot, goals, ngoal_slot, bricks,
                nbrick_slot, ground_cells, nground_slot, startp);
            if (n < 0) {
                write(2, "cannot load level ", len("cannot load level "));
                write(2, path, len(path));
                write(2, "\n", 1);
                return 1;
            }
            nroom = nroom_slot[0];
            ngoal = ngoal_slot[0];
            nbrick = nbrick_slot[0];
            nground = nground_slot[0];
            if (nroom < 1) {
                nroom = set_room_size(rooms, titles, 0, 12, 9);
            }
        }
        apply_gravity(src, n);
        apply_solved(pnames, nroom, dones, ndone, solved, nroom);
    }
    prepare_room_starts(slurp_path(path), rooms, nroom, bricks, nbrick, goals, ngoal, room_sc,
        room_sr, room_has);
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        write(2, "XOpenDisplay failed (need DISPLAY / XWayland)\n", len("XOpenDisplay failed (need DISPLAY / XWayland)\n"));
        return 1;
    }
    dpy: *i8 = d0;
    g_dpy = dpy;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 16i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) {
        die("glXChooseVisual failed");
    }
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163843,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    win_w: f32 = 1200.0;
    win_h: f32 = 720.0;
    win: int = XCreateWindow(dpy, root, 0, 0, 1200, 720, 0, vis.depth as int, 1, vis.visual,
        10248, &wa);
    if (win == 0) {
        die("XCreateWindow failed");
    }
    if (edit_mode != 0) {
        XStoreName(dpy, win, cstr("L8 level editor"));
    } else {
        XStoreName(dpy, win, cstr("L8 block game"));
    }
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, cstr("WM_DELETE_WINDOW"), 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XkbSetDetectableAutoRepeat(dpy, 1, null);
    XFlush(dpy);
    if (edit_mode != 0) {
        write(2, "L8 editor (keys on screen, q quits)\n", len("L8 editor (keys on screen, q quits)\n"));
    } else {
        write(2, "L8 block game (arrows move, r restarts room, q quits)\n",
            len("L8 block game (arrows move, r restarts room, q quits)\n"));
    }
    write(2, "level: ", len("level: "));
    write(2, path, len(path));
    write(2, "\n", 1);
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) {
        die("glXCreateContext failed");
    }
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) {
        die("glXMakeCurrent failed");
    }
    vsync: int = set_vsync(dpy, win, 1);
    vs: []i8 = """
#version 120
attribute vec3 pos;
attribute vec3 nrm;
attribute vec3 vcol;
uniform mat4 vp;
uniform vec3 origin;
uniform vec3 scale;
uniform vec2 lag;
uniform vec2 ramp_up;
varying vec3 vworld;
varying vec3 vnrm;
varying vec3 vvcol;
void main() {
  vec3 lp = pos * scale;
  float sy = max(scale.y, 0.0001);
  float yb = lp.y + 0.5 * sy;
  float t = clamp(yb / sy, 0.0, 1.0);
  float extra = yb - t * sy;
  float L = length(lag);
  vec2 lg = lag * min(1.0, 0.18 / max(L, 0.0001));
  vec2 off = lg * (t * t);
  vec2 slope = lg * (0.7 * t);
  float ytilt = 0.0 - (lp.x * slope.x + lp.z * slope.y) / sy;
  vec3 spine = vec3(2.0 * t * lg.x, sy, 2.0 * t * lg.y);
  vec3 up = spine * inversesqrt(max(dot(spine, spine), 0.00000001));
  vec3 local = vec3(lp.x + off.x, 0.0 - 0.5 * sy + t * sy + ytilt, lp.z + off.y);
  local += up * extra;
  vec3 nn = nrm / scale;
  nn.x = nn.x - nn.y * slope.x / sy;
  nn.z = nn.z - nn.y * slope.y / sy;
  float ru2 = ramp_up.x * ramp_up.x + ramp_up.y * ramp_up.y;
  if (ru2 > 0.0001) {
    float amt = min(1.0, sqrt(ru2));
    vec2 r = ramp_up * inversesqrt(ru2);
    vec3 axis = vec3(0.0 - r.y, 0.0, r.x);
    float ca = cos(0.78539816 * amt);
    float sa = sin(0.78539816 * amt);
    local.y = local.y + 0.5 * sy * amt;
    vec3 v = local;
    local = v * ca + cross(axis, v) * sa + axis * dot(axis, v) * (1.0 - ca);
    vec3 nv = nn;
    nn = nv * ca + cross(axis, nv) * sa + axis * dot(axis, nv) * (1.0 - ca);
  }
  vec3 w = origin + local;
  gl_Position = vp * vec4(w, 1.0);
  vworld = w;
  vnrm = nn;
  vvcol = vcol;
}
""";
    fs: []i8 = """
#version 120
uniform vec3 color;
uniform vec3 light;
uniform mat4 light_vp;
uniform sampler2D shadow_map;
uniform sampler2D check_map;
uniform vec2 mask_origin;
uniform float ground;
uniform float cut;
uniform float brick;
uniform float fade;
varying vec3 vworld;
varying vec3 vnrm;
varying vec3 vvcol;
vec2 hash2(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.xx + p3.yz) * p3.zy);
}
float sample_ground(vec2 cell) {
  vec2 tc = (cell - mask_origin + 0.5) / 256.0;
  if (tc.x < 0.0 || tc.x > 1.0 || tc.y < 0.0 || tc.y > 1.0) {
    return 0.0;
  }
  return texture2D(check_map, tc).r;
}
float grass_at(vec2 cell) {
  float r = sample_ground(cell);
  return step(0.15, r) * (1.0 - step(0.50, r)) + step(0.80, r);
}
float stone_at(vec2 cell) {
  return step(0.50, sample_ground(cell));
}
void main() {
  vec3 n = normalize(vnrm);
  vec3 albedo = color;
  if (ground > 0.5) {
    vec2 p = vworld.xz;
    vec2 cell = floor(p);
    vec2 f = fract(p);
    float ground_grass = grass_at(cell);
    float md = 8.0;
    float md2 = 8.0;
    vec2 mr = vec2(0.0);
    vec2 mc = cell;
    int j;
    int i;
    for (j = -1; j <= 1; j++) {
      for (i = -1; i <= 1; i++) {
        vec2 g = vec2(float(i), float(j));
        vec2 o = hash2(cell + g);
        vec2 r = g + o * 0.62 - f;
        float d = dot(r, r);
        if (d < md) {
          md2 = md;
          md = d;
          mr = r;
          mc = cell + g;
        } else if (d < md2) {
          md2 = d;
        }
      }
    }
    vec2 hv = hash2(mc);
    float edge = sqrt(md2) - sqrt(md);
    float stone_m = smoothstep(0.040, 0.155, edge) * stone_at(mc);
    vec3 stone = mix(vec3(0.38, 0.36, 0.33), vec3(0.48, 0.45, 0.41), hv.x);
    vec2 gv = hash2(floor(p * 9.0));
    stone *= 0.94 + 0.06 * gv.x;
    stone = mix(vec3(0.34, 0.36, 0.28), stone, smoothstep(0.08, 0.22, edge));
    vec2 gh = hash2(floor(p * 6.0 + 19.0));
    vec3 grass = mix(vec3(0.26, 0.30, 0.20), vec3(0.32, 0.35, 0.22), gh.x);
    grass *= 0.92 + 0.06 * gh.y;
    grass *= 0.83;
    vec3 dirt = mix(vec3(0.255, 0.205, 0.145), vec3(0.305, 0.250, 0.175), gh.x);
    dirt *= 0.91 + 0.08 * gh.y;
    albedo = dirt;
    if (ground_grass > 0.5) {
      albedo = grass;
    }
    albedo = mix(albedo, stone * mix(0.80, 0.86, stone_m), stone_m);
    n = normalize(mix(n, normalize(vec3(-mr.x, 0.78, -mr.y)), stone_m * 0.32));
  } else if (cut > 0.5) {
    vec3 an = abs(n);
    vec2 uv = vworld.xz;
    if (an.x > an.y && an.x > an.z) {
      uv = vworld.zy;
    } else if (an.z > an.y) {
      uv = vworld.xy;
    }
    float side = smoothstep(0.35, 0.70, 1.0 - an.y);
    float layer = hash2(vec2(floor(uv.y * 15.0), 3.7)).x;
    vec2 hp = hash2(floor(vworld.xy * 22.0) + floor(vworld.z * 22.0));
    vec2 hb = hash2(floor(vworld.xz + 0.02) + floor(vworld.y + 0.02) * 3.1);
    float pit = smoothstep(0.93, 0.99, hp.y);
    albedo = color * (0.93 + 0.08 * hb.x);
    albedo *= 0.94 + 0.06 * hp.x + 0.04 * layer * side;
    albedo *= 1.0 - 0.11 * pit;
    float cham = 1.0 - pow(max(an.x, max(an.y, an.z)), 6.0);
    albedo = mix(albedo, albedo * vec3(0.78, 0.90, 0.64), cham * 0.28);
    n = normalize(n + vec3(hp.x - 0.5, hp.y - 0.5, layer - 0.5) * 0.035);
  } else if (brick > 0.5) {
    vec3 an = abs(n);
    vec3 clay = vvcol;
    clay *= 0.96 + 0.04 * hash2(floor(vworld.xy * 22.0)).x;
    float cham = 1.0 - pow(max(an.x, max(an.y, an.z)), 6.0);
    albedo = mix(clay, clay * vec3(0.86, 0.90, 0.80), cham * 0.16);
    albedo *= 0.78;
  }
  vec3 toL = light - vworld;
  float dist = length(toL);
  vec3 L = toL / max(dist, 0.001);
  float ndl = max(dot(n, L), 0.0);
  float att = 1.0 / (1.0 + 0.01 * dist * dist);
  float vis = 1.0;
  vec4 sh = light_vp * vec4(vworld, 1.0);
  vec3 sc = sh.xyz / max(sh.w, 0.0001);
  if (sc.x > 0.01 && sc.x < 0.99 && sc.y > 0.01 && sc.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
    float bias = 0.0025 + 0.012 * (1.0 - ndl);
    float t = 0.00048828125;
    float s = 0.0;
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(-t, -t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(t, -t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(-t, t)).r + bias);
    s += step(sc.z, texture2D(shadow_map, sc.xy + vec2(t, t)).r + bias);
    vis = s * 0.25;
  }
  float key = ndl * att * vis;
  float shade = 0.14 + 0.86 * key;
  vec3 lit = albedo * shade * vec3(1.68, 1.52, 1.26);
  lit += vec3(0.006, 0.005, 0.003) * (1.0 - smoothstep(0.0, 0.06, lit));
  lit = lit / (1.0 + max(lit - 1.10, 0.0));
  gl_FragColor = vec4(lit, fade);
}
""";
    dvs: []i8 = """
#version 120
attribute vec3 pos;
uniform mat4 vp;
uniform vec3 origin;
uniform vec3 scale;
uniform vec2 lag;
uniform vec2 ramp_up;
void main() {
  vec3 lp = pos * scale;
  float sy = max(scale.y, 0.0001);
  float yb = lp.y + 0.5 * sy;
  float t = clamp(yb / sy, 0.0, 1.0);
  float extra = yb - t * sy;
  float L = length(lag);
  vec2 lg = lag * min(1.0, 0.18 / max(L, 0.0001));
  vec2 off = lg * (t * t);
  vec2 slope = lg * (0.7 * t);
  float ytilt = 0.0 - (lp.x * slope.x + lp.z * slope.y) / sy;
  vec3 spine = vec3(2.0 * t * lg.x, sy, 2.0 * t * lg.y);
  vec3 up = spine * inversesqrt(max(dot(spine, spine), 0.00000001));
  vec3 local = vec3(lp.x + off.x, 0.0 - 0.5 * sy + t * sy + ytilt, lp.z + off.y);
  local += up * extra;
  float ru2 = ramp_up.x * ramp_up.x + ramp_up.y * ramp_up.y;
  if (ru2 > 0.0001) {
    float amt = min(1.0, sqrt(ru2));
    vec2 r = ramp_up * inversesqrt(ru2);
    vec3 axis = vec3(0.0 - r.y, 0.0, r.x);
    float ca = cos(0.78539816 * amt);
    float sa = sin(0.78539816 * amt);
    local.y = local.y + 0.5 * sy * amt;
    vec3 v = local;
    local = v * ca + cross(axis, v) * sa + axis * dot(axis, v) * (1.0 - ca);
  }
  vec3 w = origin + local;
  gl_Position = vp * vec4(w, 1.0);
}
""";
    dfs: []i8 = """
#version 120
void main() {
}
""";
    tvs: []i8 = """
#version 120
attribute vec2 pos;
attribute vec2 uv;
uniform vec2 screen;
varying vec2 vuv;
void main() {
  gl_Position = vec4(pos.x / screen.x * 2.0 - 1.0, 1.0 - pos.y / screen.y * 2.0, 0.0, 1.0);
  vuv = uv;
}
""";
    tfs: []i8 = """
#version 120
uniform sampler2D tex;
uniform vec3 color;
uniform float alpha;
varying vec2 vuv;
void main() {
  float a = texture2D(tex, vuv).r * alpha;
  if (a <= 0.02) discard;
