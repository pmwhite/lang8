// OpenGL and GLX. Imports X11; need "libGL.so.1" is pulled in with this file.
import "x.l8";

need "libGL.so.1";

extern glXChooseVisual(dpy: *i8, screen: int, attr: *i32): ?*XVisualInfo;

extern glXCreateContext(
    dpy: *i8,
    vis: *XVisualInfo,
    share: ?*i8,
    direct: int
): ?*i8;

extern glXMakeCurrent(dpy: *i8, drawable: int, ctx: ?*i8): int;

extern glXDestroyContext(dpy: *i8, ctx: *i8): int;

extern glXSwapBuffers(dpy: *i8, drawable: int): int;

extern glCreateShader(kind: int): int;

extern glShaderSource(
    sh: int,
    count: int,
    strings: **i8,
    lengths: *i32
): int;

extern glCompileShader(sh: int): int;

extern glGetShaderiv(sh: int, pname: int, out: *i32): int;

extern glGetShaderInfoLog(
    sh: int,
    max: int,
    len: ?*i32,
    buf: *i8
): int;

extern glCreateProgram(): int;

extern glAttachShader(prog: int, sh: int): int;

extern glBindAttribLocation(prog: int, index: int, name: *i8): int;

extern glLinkProgram(prog: int): int;

extern glGetProgramiv(prog: int, pname: int, out: *i32): int;

extern glUseProgram(prog: int): int;

extern glGenVertexArrays(n: int, arrays: *u32): int;

extern glBindVertexArray(arr: u32): int;

extern glGenBuffers(n: int, bufs: *u32): int;

extern glBindBuffer(target: int, buf: u32): int;

extern glBufferData(
    target: int,
    size: int,
    data: *f32,
    usage: int
): int;

extern glVertexAttribPointer(
    index: int,
    size: int,
    typ: int,
    normalized: int,
    stride: int,
    ptr: int
): int;

extern glEnableVertexAttribArray(index: int): int;

extern glViewport(
    x: int,
    y: int,
    w: int,
    h: int
): int;

extern glClearColor(
    r: f32,
    g: f32,
    b: f32,
    a: f32
): int;

extern glClear(mask: int): int;

extern glDrawArrays(mode: int, first: int, count: int): int;

extern glGetUniformLocation(prog: int, name: *i8): int;

extern glUniform2f(loc: int, x: f32, y: f32): int;

extern glUniform3f(
    loc: int,
    x: f32,
    y: f32,
    z: f32
): int;

extern glUniformMatrix4fv(
    loc: int,
    count: int,
    transpose: int,
    value: *f32
): int;

extern glEnable(cap: int): int;

extern glDisable(cap: int): int;

extern glBlendFunc(sfactor: int, dfactor: int): int;

extern glUniform1i(loc: int, v: int): int;

extern glUniform1f(loc: int, v: f32): int;

extern glGenTextures(n: int, textures: *u32): int;

extern glBindTexture(target: int, tex: u32): int;

extern glTexParameteri(target: int, pname: int, param: int): int;

extern glTexImage2D(
    target: int,
    level: int,
    internal: int,
    w: int,
    h: int,
    border: int,
    format: int,
    typ: int,
    pixels: ?*i8
): int;

extern glGenFramebuffers(n: int, fbos: *u32): int;

extern glBindFramebuffer(target: int, fbo: u32): int;

extern glFramebufferTexture2D(
    target: int,
    attachment: int,
    textarget: int,
    tex: u32,
    level: int
): int;

extern glGenRenderbuffers(n: int, rbs: *u32): int;

extern glBindRenderbuffer(target: int, rb: u32): int;

extern glRenderbufferStorage(
    target: int,
    internal: int,
    w: int,
    h: int
): int;

extern glFramebufferRenderbuffer(
    target: int,
    attachment: int,
    rbtarget: int,
    rb: u32
): int;

extern glCheckFramebufferStatus(target: int): int;

extern glPixelStorei(pname: int, param: int): int;

extern glActiveTexture(texture: int): int;

extern glDrawBuffer(buf: int): int;

extern glReadBuffer(buf: int): int;

extern glPolygonOffset(factor: f32, units: f32): int;

extern glCullFace(mode: int): int;
