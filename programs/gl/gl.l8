tag gl;

use_tag x11;

// OpenGL and GLX. Imports X11; need "libGL.so.1" is pulled in with this file.
import "../x11/x.l8";

need "libGL.so.1";

extern glXChooseVisual(dpy: *i8, screen: int, attr: *i32): ?*XVisualInfo;

extern glXCreateContext(
    dpy: *i8,
    vis: *XVisualInfo,
    share: ?*i8,
    direct: int
): ?*i8;

extern glXMakeCurrent(dpy: *i8, drawable: int, ctx: ?*i8): int;

extern glXDestroyContext(dpy: *i8, ctx: *i8): int;

extern glXSwapBuffers(dpy: *i8, drawable: int): int;

extern glXSwapIntervalEXT(dpy: *i8, drawable: int, interval: int): int;

import "core.l8"
