// FreeType 2 bindings (x86-64 offsets) and a grayscale glyph atlas.
// Face.glyph is at 152; slot advance.x at 128, FT_Bitmap at 152, bearings at 192.
need "libfreetype.so.6";

need "libc.so.6";

extern FT_Init_FreeType(alibrary: *?*i8): int;

extern FT_New_Face(
    library: *i8,
    path: *i8,
    index: int,
    aface: *?*FT_FaceRec
): int;

extern FT_Set_Pixel_Sizes(face: *FT_FaceRec, pixel_width: u32, pixel_height: u32): int;

extern FT_Load_Char(face: *FT_FaceRec, char_code: int, load_flags: int): int;

extern FT_Done_Face(face: *FT_FaceRec): int;

extern FT_Done_FreeType(library: *i8): int;

extern memmove(dest: *i8, src: *i8, n: int): *i8;

FT_LOAD_RENDER: int = 4;

FT_ATLAS: int = 512;

FT_PX: int = 32;

FT_FIRST: int = 32;

FT_LAST: int = 126;

FT_FONT_PATH: []i8 = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";

type FT_FaceRec = {
    pad: [19]int;
    glyph: *FT_Slot;
};

type FT_Slot = {
    pad0: [16]int;
    advance_x: int;
    advance_y: int;
    format: i32;
    pad1: i32;
    rows: u32;
    width: u32;
    pitch: i32;
    pad2: i32;
    buffer: ?*i8;
    pad3: int;
    palette: *i8;
    bitmap_left: i32;
    bitmap_top: i32;
};

type Glyph = {
    u0: f32;
    v0: f32;
    u1: f32;
    v1: f32;
    w: f32;
    h: f32;
    left: f32;
    top: f32;
    adv: f32;
};

type Font = {
    atlas: []i8;
    w: int;
    h: int;
    glyphs: []Glyph;
    ok: int;
};

empty_glyph(): Glyph {
    Glyph {
        u0: 0.0,
        v0: 0.0,
        u1: 0.0,
        v1: 0.0,
        w: 0.0,
        h: 0.0,
        left: 0.0,
        top: 0.0,
        adv: 0.0
    };
}

fail_font(): Font@new {
    Font {
        atlas: new i8[1](0i8),
        w: 0,
        h: 0,
        glyphs: new Glyph[1](empty_glyph()),
        ok: 0
    };
}

copy_glyph_rows(
    atlas: []i8,
    aw: int,
    ax: int,
    ay: int,
    src: []i8,
    pitch: int,
    width: int,
    rows: int
) {
    r: int = 0;
    while (r < rows) {
        memcpy(atlas, (ay + r) * aw + ax, src, r * pitch, width);
        r = r + 1;
    }
}

load_font(
    path: []i8,
    px: int,
    aw: int,
    ah: int
): Font@new {
    if (sizeof(FT_FaceRec) != 160 || sizeof(FT_Slot) != 200) {
        write(2, "freetype: unexpected ABI layout\n", len("freetype: unexpected ABI layout\n"));
        return fail_font();
    }
    if (aw < 64 || ah < 64 || px < 8) {
        return fail_font();
    }
    lib_slot: []?*i8 = new ?*i8[1](null);
    if (FT_Init_FreeType(&lib_slot[0]) != 0) {
        write(2, "freetype: init failed\n", len("freetype: init failed\n"));
        return fail_font();
    }
    lib0: ?*i8 = lib_slot[0];
    if (lib0 == null) {
        write(2, "freetype: init failed\n", len("freetype: init failed\n"));
        return fail_font();
    }
    lib: *i8 = lib0;
    pn: int = len(path);
    zpath: []i8 = new i8[pn + 1](0i8);
    memcpy(zpath, 0, path, 0, pn);
    zpath[pn] = 0i8;
    face_slot: []?*FT_FaceRec = new ?*FT_FaceRec[1](null);
    if (FT_New_Face(lib, zpath, 0, &face_slot[0]) != 0) {
        write(2, "freetype: cannot open font\n", len("freetype: cannot open font\n"));
        FT_Done_FreeType(lib);
        return fail_font();
    }
    face0: ?*FT_FaceRec = face_slot[0];
    if (face0 == null) {
        write(2, "freetype: cannot open font\n", len("freetype: cannot open font\n"));
        FT_Done_FreeType(lib);
        return fail_font();
    }
    face: *FT_FaceRec = face0;
    if (FT_Set_Pixel_Sizes(face, 0u32, px trunc u32) != 0) {
        write(2, "freetype: set size failed\n", len("freetype: set size failed\n"));
        FT_Done_Face(face);
        FT_Done_FreeType(lib);
        return fail_font();
    }
    ngl: int = FT_LAST - FT_FIRST + 1;
    glyphs: []Glyph = new Glyph[ngl](empty_glyph());
    atlas: []i8 = new i8[aw * ah](0i8);
    pad: int = 2;
    x: int = pad;
    y: int = pad;
    row_h: int = 0;
    packed: int = 1;
    ch: int = FT_FIRST;
    while (ch <= FT_LAST) {
        if (FT_Load_Char(face, ch, FT_LOAD_RENDER) != 0) {
            ch = ch + 1;
        } else {
            slot: *FT_Slot = face.glyph;
            gw: int = slot.width as int;
            gh: int = slot.rows as int;
            pitch: int = slot.pitch as int;
            if (x + gw + pad > aw) {
                x = pad;
                y = y + row_h + pad;
                row_h = 0;
            }
            if (y + gh + pad > ah) {
                packed = 0;
            } else {
                buf: ?*i8 = slot.buffer;
                if (gw > 0 && gh > 0 && pitch > 0) {
                    if (buf != null) {
                        nb: int = pitch * gh;
                        tmp: []i8 = new i8[nb](0i8);
                        memmove(tmp, buf, nb);
                        copy_glyph_rows(atlas, aw, x, y, tmp, pitch, gw, gh);
                    }
                }
                gi: int = ch - FT_FIRST;
                awf: f32 = aw as f32;
                ahf: f32 = ah as f32;
                glyphs[gi] = Glyph {
                    u0: x as f32 / awf,
                    v0: y as f32 / ahf,
                    u1: (x + gw) as f32 / awf,
                    v1: (y + gh) as f32 / ahf,
                    w: gw as f32,
                    h: gh as f32,
                    left: slot.bitmap_left as f32,
                    top: slot.bitmap_top as f32,
                    adv: (slot.advance_x / 64) as f32
                };
                x = x + gw + pad;
                if (gh > row_h) {
                    row_h = gh;
                }
            }
            ch = ch + 1;
        }
    }
    FT_Done_Face(face);
    FT_Done_FreeType(lib);
    if (packed == 0) {
        write(2, "freetype: atlas full\n", len("freetype: atlas full\n"));
        return fail_font();
    }
    Font {
        atlas: atlas,
        w: aw,
        h: ah,
        glyphs: glyphs,
        ok: 1
    };
}

load_default_font(): Font@new {
    load_font(FT_FONT_PATH, FT_PX, FT_ATLAS, FT_ATLAS);
}

emit_text(
    font: Font,
    verts: []f32,
    i: int,
    x: f32,
    y: f32,
    s: []i8
): int {
    if (font.ok == 0) {
        return i;
    }
    pen: f32 = x;
    k: int = 0;
    while (k < len(s)) {
        code: int = s[k] as int;
        if (code >= FT_FIRST && code <= FT_LAST) {
            g: Glyph = font.glyphs[code - FT_FIRST];
            gx: f32 = pen + g.left;
            gy: f32 = y - g.top;
            if (g.w > 0.0 && g.h > 0.0 && i + 24 <= len(verts)) {
                x0: f32 = gx;
                y0: f32 = gy;
                x1: f32 = gx + g.w;
                y1: f32 = gy + g.h;
                verts[i] = x0;
                verts[i + 1] = y0;
                verts[i + 2] = g.u0;
                verts[i + 3] = g.v0;
                verts[i + 4] = x1;
                verts[i + 5] = y0;
                verts[i + 6] = g.u1;
                verts[i + 7] = g.v0;
                verts[i + 8] = x0;
                verts[i + 9] = y1;
                verts[i + 10] = g.u0;
                verts[i + 11] = g.v1;
                verts[i + 12] = x1;
                verts[i + 13] = y0;
                verts[i + 14] = g.u1;
                verts[i + 15] = g.v0;
                verts[i + 16] = x0;
                verts[i + 17] = y1;
                verts[i + 18] = g.u0;
                verts[i + 19] = g.v1;
                verts[i + 20] = x1;
                verts[i + 21] = y1;
                verts[i + 22] = g.u1;
                verts[i + 23] = g.v1;
                i = i + 24;
            }
            pen = pen + g.adv;
        }
        k = k + 1;
    }
    i;
}
