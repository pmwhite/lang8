import "level.l8";

fail(msg: []i8): int {
    write(2, msg, len(msg));
    write(2, "\n", 1);
    1;
}

setup(
    blocks: []Block,
    rooms: []Room,
    room_ids: []int,
    room_hn: []int,
    snap: []int,
    rewind_n: []int,
    rewind_cur: []int,
    room_ghosting: []int
) {
    blocks[0] = Block { id: 0, column: 2, row: 2, shape: 0, layer: 0, ramp: 0, mounted: 0 };
    blocks[1] = Block { id: 1, column: 2, row: 3, shape: 0, layer: 0, ramp: 0, mounted: 0 };
    rooms[0] = Room { x0: 0, y0: 0, x1: 10, y1: 10 };
    room_ghosting[0] = 0;
    home: []int = new int[8](0 - 1);
    assign_block_homes(blocks, 2, rooms, 1, home, room_ids, room_hn);
    rewind_capture(blocks, 0, room_ids, room_hn, snap, 0);
    b0: Block = blocks[0];
    b1: Block = blocks[1];
    b0.row = 3;
    b1.row = 4;
    blocks[0] = b0;
    blocks[1] = b1;
    rewind_capture(blocks, 0, room_ids, room_hn, snap, 1);
    b0.row = 4;
    b1.row = 5;
    blocks[0] = b0;
    blocks[1] = b1;
    rewind_capture(blocks, 0, room_ids, room_hn, snap, 2);
    rewind_n[0] = 3;
    rewind_cur[0] = 2;
}

main(): int {
    empty: Block = Block {
        id: 0 - 1,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    blocks: []Block = new Block[8](empty);
    rooms: []Room = new Room[1](Room { x0: 0, y0: 0, x1: 10, y1: 10 });
    bricks: []Brick = new Brick[1](Brick { column: 0, row: 0 });
    room_ids: []int = new int[LEVEL_MAX_ROOMS * REWIND_HOME](0);
    room_hn: []int = new int[LEVEL_MAX_ROOMS](0);
    snap: []int = new int[LEVEL_MAX_ROOMS * REWIND_MAX * REWIND_HOME](0);
    rewind_n: []int = new int[LEVEL_MAX_ROOMS](0);
    rewind_cur: []int = new int[LEVEL_MAX_ROOMS](0);
    room_ghosting: []int = new int[LEVEL_MAX_ROOMS](0);

    setup(blocks, rooms, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting);
    rewind_begin(0, rewind_n, rewind_cur, room_ghosting);
    if (room_ghosting[0] == 0 || rewind_cur[0] != 2) {
        return fail("FAIL: begin did not arm rewind");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 2,
        4) != 0) {
        return fail("FAIL: dest-hits applied a rewind step");
    }
    if (blocks[0].row != 4 || blocks[1].row != 5) {
        return fail("FAIL: dest-hits moved a crate");
    }

    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: legal rewind did not step");
    }
    if (blocks[1].column != 2 || blocks[1].row != 4) {
        return fail("FAIL: crate did not rewind one step after dest cleared");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: rewind did not continue home");
    }
    if (blocks[0].column != 2 || blocks[0].row != 2 || blocks[1].column != 2 || blocks[1].row != 3) {
        return fail("FAIL: crates did not rewind home");
    }
    if (room_ghosting[0] != 0) {
        return fail("FAIL: rewind did not finish at home");
    }

    setup(blocks, rooms, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting);
    rewind_begin(0, rewind_n, rewind_cur, room_ghosting);
    side: int = move_player(blocks, 2, rooms, 1, bricks, 0, 1, 4, 0, 1, 0, room_ids, room_hn, snap,
        rewind_n, rewind_cur, room_ghosting);
    if (pos_col(side) != 2 || pos_row(side) != 4) {
        return fail("FAIL: side push did not enter the crate cell");
    }
    if (blocks[0].column != 3 || blocks[0].row != 4) {
        return fail("FAIL: side push did not move crate");
    }
    if (rewind_n[0] < 4) {
        return fail("FAIL: side push did not extend rewind stack");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 2,
        4) != 0) {
        return fail("FAIL: rewind undid a push while player blocked dest");
    }
    if (blocks[0].column != 3 || blocks[0].row != 4) {
        return fail("FAIL: pushed crate moved while player blocked dest");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: rewind did not undo push after player left dest");
    }
    if (blocks[0].column != 2 || blocks[0].row != 4) {
        return fail("FAIL: pushed crate did not rewind the push");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: rewind did not continue after undoing push");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: rewind did not finish after undoing push");
    }
    if (blocks[0].column != 2 || blocks[0].row != 2 || blocks[1].column != 2 || blocks[1].row != 3) {
        return fail("FAIL: crates did not rewind home after push");
    }

    setup(blocks, rooms, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting);
    rewind_begin(0, rewind_n, rewind_cur, room_ghosting);
    rewind_after_move(blocks, 1, 0, 0 - 1, room_ids, room_hn, snap, rewind_n, rewind_cur,
        room_ghosting);
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: leave-room rewind did not step while player was elsewhere in the room");
    }
    if (blocks[1].row == 5) {
        return fail("FAIL: leave-room rewind left crates in place");
    }

    setup(blocks, rooms, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting);
    rewind_begin(0, rewind_n, rewind_cur, room_ghosting);
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: leave rewind did not step before re-enter");
    }
    mid_row: int = blocks[1].row;
    mid_n: int = rewind_n[0];
    rewind_after_move(blocks, 1, 0 - 1, 0, room_ids, room_hn, snap, rewind_n, rewind_cur,
        room_ghosting);
    if (room_ghosting[0] != 0) {
        return fail("FAIL: re-enter did not stop leave rewind");
    }
    if (rewind_n[0] <= 1 || rewind_n[0] >= mid_n) {
        return fail("FAIL: re-enter did not keep the remaining rewind tape");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) != 0) {
        return fail("FAIL: leave rewind stepped after re-enter");
    }
    if (blocks[1].row != mid_row) {
        return fail("FAIL: crates moved after leave rewind stopped");
    }
    rewind_after_move(blocks, 1, 0, 0 - 1, room_ids, room_hn, snap, rewind_n, rewind_cur,
        room_ghosting);
    if (room_ghosting[0] != REWIND_LEAVE) {
        return fail("FAIL: leave after re-enter did not resume rewind");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: resumed leave rewind did not continue home");
    }

    setup(blocks, rooms, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting);
    rewind_begin_reset(0, rewind_n, rewind_cur, room_ghosting);
    if (room_ghosting[0] != REWIND_RESET) {
        return fail("FAIL: reset rewind did not arm");
    }
    rewind_after_move(blocks, 1, 0 - 1, 0, room_ids, room_hn, snap, rewind_n, rewind_cur,
        room_ghosting);
    if (room_ghosting[0] != REWIND_RESET) {
        return fail("FAIL: re-enter stopped reset rewind");
    }
    if (rewind_feed(blocks, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting, 8,
        8) == 0) {
        return fail("FAIL: reset rewind did not continue after re-enter");
    }

    setup(blocks, rooms, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting);
    rewind_begin(0, rewind_n, rewind_cur, room_ghosting);
    rewind_begin_reset(0, rewind_n, rewind_cur, room_ghosting);
    rewind_after_move(blocks, 1, 0 - 1, 0, room_ids, room_hn, snap, rewind_n, rewind_cur,
        room_ghosting);
    if (room_ghosting[0] != REWIND_RESET) {
        return fail("FAIL: reset did not keep a leave rewind running");
    }

    setup(blocks, rooms, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting);
    rewind_begin(0, rewind_n, rewind_cur, room_ghosting);
    crate_pose: []int = new int[8 * 8](0);
    crate_ms: []int = new int[8 * 8](0);
    crate_hs: []int = new int[8](0);
    crate_hn: []int = new int[8](0);
    crate_t0: []int = new int[8](0);
    crate_boot(blocks, 2, crate_pose, crate_hs, crate_hn, crate_t0);
    if (rewind_tick(blocks, 2, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting,
        crate_pose, crate_ms, crate_hs, crate_hn, crate_t0, 1000, 8, 8) == 0) {
        return fail("FAIL: rewind_tick did not start a crate step");
    }
    if (crate_hn[0] < 2 || crate_hn[1] < 2) {
        return fail("FAIL: rewind_tick did not queue crate poses");
    }
    cur_mid: int = rewind_cur[0];
    if (rewind_tick(blocks, 2, 1, room_ids, room_hn, snap, rewind_n, rewind_cur, room_ghosting,
        crate_pose, crate_ms, crate_hs, crate_hn, crate_t0, 1050, 8, 8) != 0) {
        return fail("FAIL: rewind_tick started another step while a crate was still moving");
    }
    if (rewind_cur[0] != cur_mid) {
        return fail("FAIL: rewind advanced while a crate step was still in motion");
    }
    hn_after: int = crate_hn[0];
    packed: int = move_player(blocks, 2, rooms, 1, bricks, 0, 1, 3, 0, 1, 0, room_ids, room_hn, snap,
        rewind_n, rewind_cur, room_ghosting);
    crate_commit_changed(blocks, 2, 1050, crate_pose, crate_ms, crate_hs, crate_hn, crate_t0);
    if (crate_hn[0] < hn_after) {
        return fail("FAIL: push replaced the in-flight crate pose instead of queueing");
    }
    if (pos_col(packed) != 2 || pos_row(packed) != 3) {
        return fail("FAIL: side push during rewind anim did not enter the crate cell");
    }
    write(2, "PASS\n", 5);
    0;
}
