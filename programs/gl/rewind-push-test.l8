import "level.l8";

fail(msg: []i8): int {
    write(2, msg, len(msg));
    write(2, "\n", 1);
    1;
}

setup(
    blocks: []Block,
    rooms: []Room,
    ghosts: []int,
    room_ids: []int,
    room_hn: []int,
    snap: []int,
    rewind_n: []int,
    rewind_cur: []int
) {
    blocks[0] = Block { id: 0, column: 2, row: 2, shape: 0, layer: 0, ramp: 0, mounted: 0 };
    blocks[1] = Block { id: 1, column: 2, row: 3, shape: 0, layer: 0, ramp: 0, mounted: 0 };
    rooms[0] = Room { x0: 0, y0: 0, x1: 10, y1: 10 };
    ghosts[0] = 0;
    ghosts[1] = 0;
    rewind_capture(blocks, 0, room_ids, room_hn, snap, 0);
    b0: Block = blocks[0];
    b1: Block = blocks[1];
    b0.row = 3;
    b1.row = 4;
    blocks[0] = b0;
    blocks[1] = b1;
    rewind_capture(blocks, 0, room_ids, room_hn, snap, 1);
    b0.row = 4;
    b1.row = 5;
    blocks[0] = b0;
    blocks[1] = b1;
    rewind_capture(blocks, 0, room_ids, room_hn, snap, 2);
    rewind_n[0] = 3;
    rewind_cur[0] = 2;
}

tick_n(
    blocks: []Block,
    rooms: []Room,
    hist: []Block,
    ghosts: []int,
    room_ids: []int,
    room_hn: []int,
    snap: []int,
    rewind_n: []int,
    rewind_cur: []int,
    rewind_ms: []int,
    rewind_dur: []int,
    rewind_remain: []int,
    room_ghosting: []int,
    room_force: []int,
    reset_room: []int,
    now: []int,
    pc: int,
    pr: int,
    n: int
) {
    i: int = 0;
    while (i < n) {
        tick_room_rewinds(blocks, rooms, 1, hist, 0, 8, pc, pr, now[0], room_ids, room_hn, snap,
            rewind_n, rewind_cur, rewind_ms, rewind_dur, rewind_remain, room_ghosting, ghosts,
            room_force, reset_room);
        now[0] = now[0] + 50;
        i = i + 1;
    }
}

main(): int {
    empty: Block = Block {
        id: 0 - 1,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    blocks: []Block = new Block[8](empty);
    rooms: []Room = new Room[1](Room { x0: 0, y0: 0, x1: 10, y1: 10 });
    bricks: []Brick = new Brick[1](Brick { column: 0, row: 0 });
    hist: []Block = new Block[16](empty);
    ghosts: []int = new int[8](0);
    room_ids: []int = new int[LEVEL_MAX_ROOMS * REWIND_HOME](0);
    room_hn: []int = new int[LEVEL_MAX_ROOMS](0);
    home: []int = new int[8](0 - 1);
    snap: []int = new int[LEVEL_MAX_ROOMS * REWIND_MAX * REWIND_HOME](0);
    rewind_n: []int = new int[LEVEL_MAX_ROOMS](0);
    rewind_cur: []int = new int[LEVEL_MAX_ROOMS](0);
    rewind_ms: []int = new int[LEVEL_MAX_ROOMS](0);
    rewind_dur: []int = new int[LEVEL_MAX_ROOMS](0);
    rewind_remain: []int = new int[LEVEL_MAX_ROOMS](0);
    room_ghosting: []int = new int[LEVEL_MAX_ROOMS](0);
    room_force: []int = new int[LEVEL_MAX_ROOMS](0);
    reset_room: []int = new int[1](0 - 1);
    wait: []int = new int[1](0);
    now: []int = new int[1](1000);
    assign_block_homes(blocks, 2, rooms, 1, home, room_ids, room_hn);

    setup(blocks, rooms, ghosts, room_ids, room_hn, snap, rewind_n, rewind_cur);
    rewind_begin(blocks, ghosts, 0, room_ids, room_hn, snap, rewind_n, rewind_cur, rewind_ms,
        rewind_dur, rewind_remain, room_ghosting, now[0], 8, 8);
    if (room_ghosting[0] == 0 || rewind_dur[0] <= 0 || ghosts[0] != 1 || ghosts[1] != 1) {
        return fail("FAIL: begin did not start rewind");
    }

    tick_n(blocks, rooms, hist, ghosts, room_ids, room_hn, snap, rewind_n, rewind_cur, rewind_ms,
        rewind_dur, rewind_remain, room_ghosting, room_force, reset_room, now, 2, 4, 8);
    if (room_ghosting[0] == 0) {
        return fail("FAIL: dest-hits finished rewind");
    }
    if (blocks[1].row == 3) {
        return fail("FAIL: dest-hits did not pause the other crate");
    }

    tick_n(blocks, rooms, hist, ghosts, room_ids, room_hn, snap, rewind_n, rewind_cur, rewind_ms,
        rewind_dur, rewind_remain, room_ghosting, room_force, reset_room, now, 8, 8, 20);
    if (blocks[1].column != 2 || blocks[1].row != 3) {
        return fail("FAIL: crate did not rewind home after stepping off dest");
    }

    setup(blocks, rooms, ghosts, room_ids, room_hn, snap, rewind_n, rewind_cur);
    room_ghosting[0] = 0;
    rewind_dur[0] = 0;
    rewind_remain[0] = 0;
    rewind_begin(blocks, ghosts, 0, room_ids, room_hn, snap, rewind_n, rewind_cur, rewind_ms,
        rewind_dur, rewind_remain, room_ghosting, now[0], 8, 8);
    packed: int = move_player(blocks, 2, rooms, 1, bricks, 0, 1, 4, 0, 1, 0, ghosts, room_ids,
        room_hn, snap, rewind_n, rewind_cur, rewind_dur, room_ghosting, wait);
    if (wait[0] != 0 || packed < 0 || ghosts[0] != 2) {
        return fail("FAIL: mid-step push did not keep crate on the player step");
    }
    if (blocks[0].column != 3 || blocks[0].row != 4) {
        return fail("FAIL: pushed crate did not move");
    }
    rewind_after_move(blocks, ghosts, 1, 0, 0, room_ids, room_hn, snap, rewind_n, rewind_cur,
        rewind_dur, rewind_remain, room_ghosting, room_force, room_force, room_force);

    tick_n(blocks, rooms, hist, ghosts, room_ids, room_hn, snap, rewind_n, rewind_cur, rewind_ms,
        rewind_dur, rewind_remain, room_ghosting, room_force, reset_room, now, 2, 4, 6);
    if (room_ghosting[0] == 0) {
        return fail("FAIL: standing on dest after push finished rewind");
    }
    if (blocks[0].column != 3 || blocks[0].row != 4) {
        return fail("FAIL: pushed crate rewound while player blocked dest");
    }

    rewind_clear_holds(ghosts, 2);
    tick_n(blocks, rooms, hist, ghosts, room_ids, room_hn, snap, rewind_n, rewind_cur, rewind_ms,
        rewind_dur, rewind_remain, room_ghosting, room_force, reset_room, now, 8, 8, 24);
    if (blocks[0].column != 2 || blocks[0].row != 2) {
        return fail("FAIL: pushed crate did not rewind home");
    }
    if (blocks[1].column != 2 || blocks[1].row != 3) {
        return fail("FAIL: other crate did not rewind home after push");
    }
    write(2, "PASS\n", 5);
    0;
}
