// Player movement, animation, undo, and room-transition logic.
lerp(a: f32, b: f32, t: f32): f32 {
    a + (b - a) * t;
}

smooth_u(u: f32): f32 {
    u * u * (3.0 - 2.0 * u);
}

clamp_along(a: f32): f32 {
    if (a > 0.5) {
        return 0.5;
    }
    if (a < 0.0 - 0.5) {
        return 0.0 - 0.5;
    }
    a;
}

slope_y(
    base: f32,
    x: f32,
    z: f32,
    column: int,
    row: int,
    rux: f32,
    ruz: f32
): f32 {
    along: f32 = (x - column as f32) * rux + (z - row as f32) * ruz;
    base + clamp_along(along);
}

fall_t(
    from_y: f32,
    to_y: f32,
    from_sit: int,
    to_sit: int,
    t: f32
): f32 {
    leave: bool = from_sit != 0 && to_sit == 0;
    mount: bool = from_sit == 0 && to_sit != 0;
    drop: bool = to_y + 0.15 < from_y;
    if (!leave && !mount && !drop) {
        return t;
    }
    lip: f32 = 0.55;
    if (t <= lip) {
        return 0.0;
    }
    smooth_u((t - lip) / (1.0 - lip));
}

anim_y(
    y0: f32,
    y1: f32,
    x: f32,
    z: f32,
    c0: int,
    r0: int,
    c1: int,
    r1: int,
    ux0: f32,
    uz0: f32,
    ux1: f32,
    uz1: f32,
    from_sit: int,
    to_sit: int,
    t: f32
): f32 {
    leave: int = 0;
    if (from_sit != 0 && to_sit == 0) {
        leave = 1;
    }
    drop: int = 0;
    if (y1 + 0.15 < y0) {
        drop = 1;
    }
    lip: f32 = 0.55;
    if (leave != 0 || from_sit != 0 && drop != 0) {
        if (t <= lip) {
            return slope_y(y0, x, z, c0, r0, ux0, uz0);
        }
        lx: f32 = lerp(c0 as f32, c1 as f32, lip);
        lz: f32 = lerp(r0 as f32, r1 as f32, lip);
        ylip: f32 = slope_y(y0, lx, lz, c0, r0, ux0, uz0);
        lerp(ylip, y1, smooth_u((t - lip) / (1.0 - lip)));
    } else if (from_sit == 0 && to_sit != 0) {
        if (t <= lip) {
            return y0;
        }
        yride: f32 = slope_y(y1, x, z, c1, r1, ux1, uz1);
        lerp(y0, yride, smooth_u((t - lip) / (1.0 - lip)));
    } else if (from_sit != 0 && to_sit != 0) {
        if (t <= lip) {
            return slope_y(y0, x, z, c0, r0, ux0, uz0);
        }
        slope_y(y1, x, z, c1, r1, ux1, uz1);
    } else if (drop != 0) {
        if (t <= lip) {
            return y0;
        }
        lerp(y0, y1, smooth_u((t - lip) / (1.0 - lip)));
    } else {
        lerp(y0, y1, t);
    }
}

step_dur(
    y0: f32,
    y1: f32,
    from_sit: int,
    to_sit: int
): int {
    ms: int = 200;
    dy: f32 = y0 - y1;
    if (from_sit != 0 && to_sit == 0 || from_sit == 0 && to_sit != 0) {
        ms = 260;
        if (dy < 0.0) {
            dy = 0.0 - dy;
        }
        if (dy < 0.3) {
            dy = 0.3;
        }
    }
    if (dy > 0.1) {
        ms = ms + (dy * 160.0) as int;
    }
    ms;
}

cargo_sit(b: Block): int {
    if (b.mounted != 0) {
        return 1;
    }
    0;
}

block_step_dur(
    hist: []Block,
    foff: int,
    toff: int,
    n: int,
    ms: int
): int {
    for i in 0..n {
        tb: Block = hist[toff + i];
        fb: Block = hist[foff + i];
        if (fb.id == tb.id) {
            d: int = step_dur(fb.layer as f32 + 0.5, tb.layer as f32 + 0.5, cargo_sit(fb),
                cargo_sit(tb));
            if (d > ms) {
                ms = d;
            }
        }
    }
    ms;
}

hist_off(hstart: int, i: int): int {
    (hstart + i) % 8 * 1024;
}

play_undo_slot(step: int, k: int): int {
    step * LEVEL_MAX_BLOCKS + k;
}

play_undo_room_slot(step: int, room: int): int {
    step * LEVEL_MAX_ROOMS + room;
}

play_undo_clear(state: []int) {
    state[0] = 0;
    state[1] = 0;
    state[2] = 0;
}

play_undo_capture(
    blocks: []Block,
    n: int,
    pose: []int,
    snap: []int,
    upc: []int,
    upr: []int,
    uph: []int,
    upm: []int,
    state: []int
): bool {
    start: int = state[0];
    count: int = state[1];
    slot: int = (start + count) % PLAY_UNDO_CAP;
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        snap[play_undo_slot(slot, i)] = pack_pos(b.column, b.row, b.layer, b.mounted);
        i = i + 1;
    }
    upc[slot] = pose[0];
    upr[slot] = pose[1];
    uph[slot] = pose[2];
    upm[slot] = pose[3];
    state[0] = start;
    state[1] = count + 1;
    true;
}

play_undo_blocks_changed(
    blocks: []Block,
    n: int,
    snap: []int,
    state: []int
): bool {
    if (state[1] < 1) {
        return false;
    }
    slot: int = (state[0] + state[1] - 1) % PLAY_UNDO_CAP;
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        p: int = pack_pos(b.column, b.row, b.layer, b.mounted);
        if (p != snap[play_undo_slot(slot, i)]) {
            return true;
        }
        i = i + 1;
    }
    false;
}

play_undo_discard(state: []int) {
    if (state[1] > 0) {
        state[1] = state[1] - 1;
    }
}

play_undo_step(
    blocks: []Block,
    n: int,
    nroom: int,
    hist: []Block,
    hpc: []int,
    hpr: []int,
    hph: []int,
    hpm: []int,
    hms: []int,
    clock: []int,
    pose: []int,
    pend: []int,
    room_ids: []int,
    room_hn: []int,
    rewind_snap: []int,
    rewind_n: []int,
    rewind_cur: []int,
    room_ghosting: []int,
    snap: []int,
    upc: []int,
    upr: []int,
    uph: []int,
    upm: []int,
    state: []int,
    u: *UndoTimeline,
    crate_pose: []int,
    crate_ms: []int,
    crate_hs: []int,
    crate_hn: []int,
    crate_t0: []int,
    now: int
): int {
    if (state[1] < 1) {
        return 0;
    }
    slot: int = (state[0] + state[1] - 1) % PLAY_UNDO_CAP;
    if (state[2] == 0) {
        for r in 0..nroom {
            u.selected[r] = u.deps[play_undo_room_slot(slot, r)];
            u.syncing[r] = 0;
        }
        state[2] = 1;
    }
    // Independent rooms keep running during catch-up. Recheck contacts before
    // committing so a newly arrived obstacle joins the synchronization too.
    undo_select_rooms(u, slot, blocks, n, snap, upc[slot], upr[slot], uph[slot]);
    for r in 0..nroom {
        if (u.selected[r] != 0 && u.syncing[r] == 0) {
            undo_build_route(u, slot, r, blocks, room_ids, room_hn, rewind_snap, rewind_cur);
            room_ghosting[r] = REWIND_HOLD;
            u.syncing[r] = 1;
        }
    }
    if (undo_sync_tick(u, blocks, n, nroom, room_ids, room_hn, crate_pose, crate_ms,
        crate_hs, crate_hn, crate_t0, now)) {
        pend[0] = 0;
        pend[1] = 0;
        return PLAY_UNDO_WAIT;
    }
    copy_blocks(hist, 0, blocks, 0, n);
    hpc[0] = pose[0];
    hpr[0] = pose[1];
    hph[0] = pose[2];
    hpm[0] = pose[3];
    i: int = 0;
    while (i < n) {
        owner: int = u.home[i];
        restore: bool = owner < 0 && u.changed[play_undo_slot(slot, i)] != 0;
        if (owner >= 0 && u.selected[owner] != 0) { restore = true; }
        if (restore) {
            blocks[i] = apply_packed(blocks[i], snap[play_undo_slot(slot, i)]);
        }
        i = i + 1;
    }
    room: int = 0;
    while (room < nroom) {
        if (u.selected[room] != 0) {
            undo_restore_history(u, slot, room, room_hn, rewind_snap, rewind_n,
                rewind_cur, room_ghosting);
        }
        room = room + 1;
    }
    copy_blocks(hist, 1024, blocks, 0, n);
    pose[0] = upc[slot];
    pose[1] = upr[slot];
    pose[2] = uph[slot];
    pose[3] = upm[slot];
    hpc[1] = pose[0];
    hpr[1] = pose[1];
    hph[1] = pose[2];
    hpm[1] = pose[3];
    step_ms: int = step_dur(sit_y(hist, 0, n, hpc[0], hpr[0], hph[0]), sit_y(hist,
        1024, n, hpc[1], hpr[1], hph[1]), sit_at(hist, 0, n, hpc[0], hpr[0], hph[0]),
        sit_at(hist, 1024, n, hpc[1], hpr[1], hph[1]));
    hms[1] = block_step_dur(hist, 0, 1024, n, step_ms);
    clock[0] = 0;
    clock[1] = 2;
    clock[2] = now;
    pend[0] = 0;
    pend[1] = 0;
    state[1] = state[1] - 1;
    state[2] = 0;
    PLAY_UNDO_DONE;
}

play_commit_pose(
    blocks: []Block,
    n: int,
    hist: []Block,
    hpc: []int,
    hpr: []int,
    hph: []int,
    hpm: []int,
    hms: []int,
    clock: []int,
    pose: []int,
    packed: int,
    step_ms: int
) {
    hstart: int = clock[0];
    hn: int = clock[1];
    prevs: int = (hstart + hn - 1) % 8;
    yfrom: f32 = sit_y(hist, prevs * 1024, n, hpc[prevs], hpr[prevs], hph[prevs]);
    sfrom: int = sit_at(hist, prevs * 1024, n, hpc[prevs], hpr[prevs], hph[prevs]);
    pose[0] = pos_col(packed);
    pose[1] = pos_row(packed);
    pose[2] = pos_layer(packed);
    pose[3] = pos_mounted(packed);
    if (hn == 1) {
        clock[2] = mono_ms();
    }
    if (hn >= 8) {
        hstart = (hstart + 1) % 8;
        hn = hn - 1;
    }
    slot: int = (hstart + hn) % 8;
    copy_blocks(hist, slot * 1024, blocks, 0, n);
    hpc[slot] = pose[0];
    hpr[slot] = pose[1];
    hph[slot] = pose[2];
    hpm[slot] = pose[3];
    ms: int = step_ms;
    if (ms <= 0) {
        ms = block_step_dur(hist, prevs * 1024, slot * 1024, n, step_dur(yfrom, sit_y(hist,
            slot * 1024, n, pose[0], pose[1], pose[2]), sfrom, sit_at(hist, slot * 1024,
            n, pose[0], pose[1], pose[2])));
    }
    hms[slot] = ms;
    hn = hn + 1;
    clock[0] = hstart;
    clock[1] = hn;
}

play_snap_pose(
    blocks: []Block,
    n: int,
    hist: []Block,
    hpc: []int,
    hpr: []int,
    hph: []int,
    hpm: []int,
    clock: []int,
    pose: []int,
    packed: int
) {
    pose[0] = pos_col(packed);
    pose[1] = pos_row(packed);
    pose[2] = pos_layer(packed);
    pose[3] = pos_mounted(packed);
    copy_blocks(hist, 0, blocks, 0, n);
    copy_blocks(hist, 1024, blocks, 0, n);
    hpc[0] = pose[0];
    hpr[0] = pose[1];
    hph[0] = pose[2];
    hpm[0] = pose[3];
    hpc[1] = pose[0];
    hpr[1] = pose[1];
    hph[1] = pose[2];
    hpm[1] = pose[3];
    clock[0] = 0;
    clock[1] = 1;
}

play_commit_move(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    hist: []Block,
    hpc: []int,
    hpr: []int,
    hph: []int,
    hpm: []int,
    hms: []int,
    clock: []int,
    pose: []int,
    packed: int,
    room_ids: []int,
    room_hn: []int,
    rewind_snap: []int,
    rewind_n: []int,
    rewind_cur: []int,
    room_ghosting: []int,
    goals: []Goal,
    ngoal: int,
    solved: []int,
    stream_until: []int,
    stream_tx: []f32,
    stream_tz: []f32,
    sparks: []Spark,
    spark_rng: []int,
    spark_xy: []int
) {
    old_c: int = pose[0];
    old_r: int = pose[1];
    old_room: int = room_at(rooms, nroom, old_c, old_r);
    nc: int = pos_col(packed);
    nr: int = pos_row(packed);
    new_room: int = room_at(rooms, nroom, nc, nr);
    rewind_after_move(blocks, nroom, old_room, new_room, room_ids, room_hn, rewind_snap,
        rewind_n, rewind_cur, room_ghosting);
    play_commit_pose(blocks, n, hist, hpc, hpr, hph, hpm, hms, clock, pose, packed,
        0);
    if (is_goal(goals, ngoal, pose[0], pose[1]) && (pose[0] != old_c || pose[1] != old_r)) {
        if (!is_goal(goals, ngoal, old_c, old_r)) {
            ri_g: int = room_at(rooms, nroom, pose[0], pose[1]);
            if (ri_g >= 0 && ri_g < len(solved) && solved[ri_g] == 0) {
                solved[ri_g] = 1;
                stream_until[ri_g] = mono_ms() + 1600;
                stream_tx[ri_g] = pose[0] as f32 + 0.5;
                stream_tz[ri_g] = pose[1] as f32 + 0.5;
                redirect_sparks(sparks, ri_g);
                burst_stream(sparks, spark_rng, spark_xy, rooms[ri_g], ri_g, 90, bricks,
                    nbrick, blocks, n);
            }
        }
    }
}

play_try_dir(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    hist: []Block,
    hpc: []int,
    hpr: []int,
    hph: []int,
    hpm: []int,
    hms: []int,
    clock: []int,
    pose: []int,
    dc: int,
    dr: int,
    pend: []int,
    room_ids: []int,
    room_hn: []int,
    rewind_snap: []int,
    rewind_n: []int,
    rewind_cur: []int,
    room_ghosting: []int,
    goals: []Goal,
    ngoal: int,
    solved: []int,
    stream_until: []int,
    stream_tx: []f32,
    stream_tz: []f32,
    sparks: []Spark,
    spark_rng: []int,
    spark_xy: []int,
    undo_snap: []int,
    undo_pc: []int,
    undo_pr: []int,
    undo_ph: []int,
    undo_pm: []int,
    undo_state: []int,
    u: *UndoTimeline@new
) {
    captured: bool = play_undo_capture(blocks, n, pose, undo_snap, undo_pc, undo_pr,
        undo_ph, undo_pm, undo_state);
    slot: int = (undo_state[0] + undo_state[1] - 1) % PLAY_UNDO_CAP;
    for r in 0..nroom { u.deps[play_undo_room_slot(slot, r)] = 0; }
    for i in 0..n { u.changed[play_undo_slot(slot, i)] = 0; }
    undo_save_history(u, slot, 0, nroom, room_hn, rewind_snap, rewind_n, rewind_cur,
        room_ghosting);
    packed: int = move_player(blocks, n, rooms, nroom, bricks, nbrick, pose[0], pose[1],
        pose[2], dc, dr, room_ids, room_hn, rewind_snap, rewind_n, rewind_cur, room_ghosting);
    moved: bool = false;
    if (pos_col(packed) != pose[0] || pos_row(packed) != pose[1] || pos_layer(packed) != pose[2] || pos_mounted(packed) != pose[3]) {
        moved = true;
    } else if (captured && play_undo_blocks_changed(blocks, n, undo_snap, undo_state)) {
        moved = true;
    }
    if (captured) {
        if (!moved) {
            play_undo_discard(undo_state);
        } else {
            undo_record_action(u, slot, blocks, n, rooms, nroom, room_hn, undo_snap,
                pose[0], pose[1], pose[2], pos_col(packed), pos_row(packed), pos_layer(packed));
        }
    }
    pend[0] = 0;
    pend[1] = 0;
    play_commit_move(blocks, n, rooms, nroom, bricks, nbrick, hist, hpc, hpr, hph,
        hpm, hms, clock, pose, packed, room_ids, room_hn, rewind_snap, rewind_n, rewind_cur,
        room_ghosting, goals, ngoal, solved, stream_until, stream_tx, stream_tz, sparks,
        spark_rng, spark_xy);
    if (moved) {
        undo_save_history(u, slot, 1, nroom, room_hn, rewind_snap, rewind_n, rewind_cur,
            room_ghosting);
        if (undo_state[1] > PLAY_UNDO_MAX) {
            undo_state[0] = (undo_state[0] + 1) % PLAY_UNDO_CAP;
            undo_state[1] = PLAY_UNDO_MAX;
        }
    }
}

play_jump_to_finish(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    goals: []Goal,
    ngoal: int,
    solved: []int,
    pose: []int,
    pend: []int,
    reset_phase: []int,
    reset_t0: []int,
    reset_room: []int,
    reset_target: []int,
    target: int,
    now: int
): int {
    if (reset_phase[0] != 0) {
        return 0;
    }
    if (target < 0 || target >= ngoal) {
        return 0;
    }
    goal: Goal = goals[target];
    target_room: int = room_at(rooms, nroom, goal.column, goal.row);
    if (target_room < 0 || target_room >= len(solved) || solved[target_room] == 0) {
        return 0;
    }
    packed: int = finish_move(blocks, n, bricks, nbrick, goal.column, goal.row, LEVEL_MAX_LAYER - 1);
    if (packed < 0 || pos_col(packed) == pose[0] && pos_row(packed) == pose[1]) {
        return 0;
    }
    reset_phase[0] = 1;
    reset_t0[0] = now;
    reset_room[0] = 0 - 1;
    reset_target[0] = packed;
    pend[0] = 0;
    pend[1] = 0;
    1;
}

tick_reset_sink(
    blocks: []Block,
    n: int,
    hist: []Block,
    hpc: []int,
    hpr: []int,
    hph: []int,
    hpm: []int,
    clock: []int,
    pose: []int,
    now: int,
    rooms: []Room,
    nroom: int,
    room_ids: []int,
    room_hn: []int,
    rewind_snap: []int,
    rewind_n: []int,
    rewind_cur: []int,
    room_ghosting: []int,
    room_starts: []RoomStart,
    reset_phase: []int,
    reset_t0: []int,
    reset_room: []int,
    reset_target: []int
): int {
    here: int = reset_room[0];
    if (reset_phase[0] == 0) {
        if (here >= 0 && here < LEVEL_MAX_ROOMS && room_ghosting[here] == 0) {
            reset_room[0] = 0 - 1;
        }
        return 0;
    }
    if (reset_phase[0] == 1 && now - reset_t0[0] >= RESET_SINK_MS) {
        if (reset_target[0] >= 0) {
            old_room: int = room_at(rooms, nroom, pose[0], pose[1]);
            new_room: int = room_at(rooms, nroom, pos_col(reset_target[0]),
                pos_row(reset_target[0]));
            rewind_after_move(blocks, nroom, old_room, new_room, room_ids, room_hn,
                rewind_snap, rewind_n, rewind_cur, room_ghosting);
            play_snap_pose(blocks, n, hist, hpc, hpr, hph, hpm, clock, pose,
                reset_target[0]);
            reset_target[0] = 0 - 1;
        } else if (here >= 0 && here < LEVEL_MAX_ROOMS) {
            play_snap_pose(blocks, n, hist, hpc, hpr, hph, hpm, clock, pose, pack_pos(room_starts[here].column,
                room_starts[here].row, 0, 0));
            rewind_begin_reset(here, rewind_n, rewind_cur, room_ghosting);
        }
        reset_phase[0] = 2;
        reset_t0[0] = now;
        return 1;
    }
    if (reset_phase[0] == 2 && now - reset_t0[0] >= RESET_EMERGE_MS) {
        reset_phase[0] = 0;
    }
    if (reset_phase[0] == 0 && here >= 0 && here < LEVEL_MAX_ROOMS) {
        if (room_ghosting[here] == 0) {
            reset_room[0] = 0 - 1;
        }
    }
    0;
}

reset_sink_k(phase: int, t0: int, now: int): f32 {
    if (phase == 1) {
        k: f32 = (now - t0) as f32 / RESET_SINK_MS as f32;
        if (k < 0.0) {
            k = 0.0;
        }
        if (k > 1.0) {
            k = 1.0;
        }
        return k;
    }
    if (phase == 2) {
        k2: f32 = 1.0 - (now - t0) as f32 / RESET_EMERGE_MS as f32;
        if (k2 < 0.0) {
            k2 = 0.0;
        }
        if (k2 > 1.0) {
            k2 = 1.0;
        }
        return k2;
    }
    0.0;
}
