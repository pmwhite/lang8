// Bouncing balls via X11/GLX. Needs DISPLAY. Quit with q, Escape, or close.
import "gl.l8";

extern exit(code: int): noreturn;

extern clock_gettime(clk: int, ts: *Timespec): int;

type Timespec = {
    sec: int;
    nsec: int;
};

type Ball = {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    r: f32;
    cr: f32;
    cg: f32;
    cb: f32;
};

die(msg: []i8): noreturn {
    write(2, msg, len(msg));
    write(2, "\n", 1);
    exit(1);
}

mono_ns(): int {
    ts: Timespec = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    ts.sec * 1000000000 + ts.nsec;
}

sqrt_f32(x: f32): f32 {
    if (x <= 0.0) {
        return 0.0;
    }
    g: f32 = x;
    i: int = 0;
    while (i < 8) {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    g;
}

compile_shader(kind: int, src: []i8): int {
    sh: int = glCreateShader(kind);
    sp: *i8 = src;
    ln: []i32 = new i32[1](len(src) trunc i32);
    glShaderSource(sh, 1, &sp, ln);
    glCompileShader(sh);
    st: []i32 = new i32[1](0i32);
    glGetShaderiv(sh, 35713, st);
    if (st[0] == 0i32) {
        logn: []i32 = new i32[1](0i32);
        glGetShaderiv(sh, 35716, logn);
        n: int = logn[0] as int;
        if (n < 1) {
            n = 1;
        }
        if (n > 4096) {
            n = 4096;
        }
        buf: []i8 = new i8[n](0i8);
        glGetShaderInfoLog(sh, n, null, buf);
        write(2, buf, n);
        die("shader compile failed");
    }
    sh;
}

ball(
    x: f32,
    y: f32,
    vx: f32,
    vy: f32,
    r: f32,
    cr: f32,
    cg: f32,
    cb: f32
): Ball {
    Ball {
        x: x,
        y: y,
        vx: vx,
        vy: vy,
        r: r,
        cr: cr,
        cg: cg,
        cb: cb
    };
}

step_balls(
    balls: []Ball,
    dt: f32,
    width: f32,
    height: f32
) {
    n: int = len(balls);
    i: int = 0;
    while (i < n) {
        b: Ball = balls[i];
        b.vy = b.vy - 520.0 * dt;
        b.x = b.x + b.vx * dt;
        b.y = b.y + b.vy * dt;
        if (b.x < b.r) {
            b.x = b.r;
            b.vx = 0.0 - b.vx;
        }
        if (b.x > width - b.r) {
            b.x = width - b.r;
            b.vx = 0.0 - b.vx;
        }
        if (b.y < b.r) {
            b.y = b.r;
            b.vy = 0.0 - b.vy * 0.92;
        }
        if (b.y > height - b.r) {
            b.y = height - b.r;
            b.vy = 0.0 - b.vy;
        }
        balls[i] = b;
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        j: int = i + 1;
        while (j < n) {
            a: Ball = balls[i];
            c: Ball = balls[j];
            dx: f32 = c.x - a.x;
            dy: f32 = c.y - a.y;
            d2: f32 = dx * dx + dy * dy;
            min: f32 = a.r + c.r;
            if (d2 > 0.0 && d2 < min * min) {
                d: f32 = sqrt_f32(d2);
                nx: f32 = dx / d;
                ny: f32 = dy / d;
                overlap: f32 = min - d;
                a.x = a.x - nx * overlap * 0.5;
                a.y = a.y - ny * overlap * 0.5;
                c.x = c.x + nx * overlap * 0.5;
                c.y = c.y + ny * overlap * 0.5;
                rel: f32 = (a.vx - c.vx) * nx + (a.vy - c.vy) * ny;
                if (rel > 0.0) {
                    a.vx = a.vx - rel * nx;
                    a.vy = a.vy - rel * ny;
                    c.vx = c.vx + rel * nx;
                    c.vy = c.vy + rel * ny;
                }
                balls[i] = a;
                balls[j] = c;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

draw_balls(
    balls: []Ball,
    u_center: int,
    u_scale: int,
    u_color: int,
    width: f32,
    height: f32
) {
    hx: f32 = width * 0.5;
    hy: f32 = height * 0.5;
    i: int = 0;
    n: int = len(balls);
    while (i < n) {
        b: Ball = balls[i];
        glUniform2f(u_center, b.x / hx - 1.0, b.y / hy - 1.0);
        glUniform2f(u_scale, b.r / hx, b.r / hy);
        glUniform3f(u_color, b.cr, b.cg, b.cb);
        glDrawArrays(5, 0, 4);
        i = i + 1;
    }
}

main(): int {
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        write(2, "XOpenDisplay failed (need DISPLAY / XWayland)\n", len("XOpenDisplay failed (need DISPLAY / XWayland)\n"));
        return 1;
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [4i32, 5i32, 8i32, 8i32, 9i32, 8i32, 10i32, 8i32, 12i32, 16i32,
        0i32];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) {
        die("glXChooseVisual failed");
    }
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163841,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    width: f32 = 640.0;
    height: f32 = 480.0;
    win: int = XCreateWindow(dpy, root, 0, 0, 640, 480, 0, vis.depth as int, 1, vis.visual,
        10248, &wa);
    if (win == 0) {
        die("XCreateWindow failed");
    }
    XStoreName(dpy, win, cstr("L8 balls"));
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, cstr("WM_DELETE_WINDOW"), 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XFlush(dpy);
    write(2, "L8 balls running (q / Escape / close to quit)\n", len("L8 balls running (q / Escape / close to quit)\n"));
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) {
        die("glXCreateContext failed");
    }
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) {
        die("glXMakeCurrent failed");
    }
    vs: []i8 = """
#version 120
attribute vec2 pos;
uniform vec2 center;
uniform vec2 scale;
varying vec2 vpos;
void main() {
  vpos = pos;
  gl_Position = vec4(center + pos * scale, 0.0, 1.0);
}
""";
    fs: []i8 = """
#version 120
uniform vec3 color;
varying vec2 vpos;
void main() {
  float d = length(vpos);
  float a = 1.0 - smoothstep(0.90, 1.0, d);
  if (a <= 0.0) discard;
  gl_FragColor = vec4(color, a);
}
""";
    vsh: int = compile_shader(35633, vs);
    fsh: int = compile_shader(35632, fs);
    prog: int = glCreateProgram();
    glAttachShader(prog, vsh);
    glAttachShader(prog, fsh);
    glBindAttribLocation(prog, 0, cstr("pos"));
    glLinkProgram(prog);
    lst: []i32 = new i32[1](0i32);
    glGetProgramiv(prog, 35714, lst);
    if (lst[0] == 0i32) {
        die("program link failed");
    }
    glUseProgram(prog);
    u_center: int = glGetUniformLocation(prog, cstr("center"));
    u_scale: int = glGetUniformLocation(prog, cstr("scale"));
    u_color: int = glGetUniformLocation(prog, cstr("color"));
    va: []u32 = new u32[1](0u32);
    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    quad: []f32 = [0.0 - 1.0, 0.0 - 1.0, 1.0, 0.0 - 1.0, 0.0 - 1.0, 1.0, 1.0, 1.0];
    ids: []u32 = new u32[1](0u32);
    glGenBuffers(1, ids);
    glBindBuffer(34962, ids[0]);
    glBufferData(34962, len(quad) * 4, quad, 35044);
    glVertexAttribPointer(0, 2, 5126, 0, 8, 0);
    glEnableVertexAttribArray(0);
    glEnable(3042);
    glBlendFunc(770, 771);
    glViewport(0, 0, 640, 480);
    glClearColor(0.06, 0.07, 0.10, 1.0);
    balls: []Ball = new Ball[10](ball(0.0, 0.0, 0.0, 0.0, 22.0, 1.0, 1.0, 1.0));
    balls[0] = ball(80.0, 380.0, 140.0, 40.0, 22.0, 0.95, 0.35, 0.35);
    balls[1] = ball(160.0, 300.0, 0.0 - 90.0, 80.0, 26.0, 0.95, 0.70, 0.25);
    balls[2] = ball(260.0, 420.0, 60.0, 0.0 - 20.0, 20.0, 0.35, 0.80, 0.45);
    balls[3] = ball(360.0, 250.0, 0.0 - 160.0, 120.0, 28.0, 0.30, 0.65, 0.95);
    balls[4] = ball(460.0, 360.0, 110.0, 0.0 - 70.0, 18.0, 0.75, 0.45, 0.95);
    balls[5] = ball(540.0, 200.0, 0.0 - 40.0, 160.0, 24.0, 0.95, 0.50, 0.70);
    balls[6] = ball(200.0, 140.0, 180.0, 30.0, 21.0, 0.40, 0.90, 0.85);
    balls[7] = ball(400.0, 120.0, 0.0 - 130.0, 90.0, 30.0, 0.95, 0.85, 0.40);
    balls[8] = ball(120.0, 80.0, 70.0, 150.0, 16.0, 0.85, 0.85, 0.90);
    balls[9] = ball(500.0, 80.0, 0.0 - 80.0, 40.0, 34.0, 0.55, 0.85, 0.40);
    prev: int = mono_ns();
    ev: XEvent = XEvent.Other;
    running: int = 1;
    alive: int = 1;
    while (running != 0) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 113 || ks == 81 || ks == 65307) {
                        running = 0;
                    }
                }
                DestroyNotify -> {
                    running = 0;
                    alive = 0;
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) {
                        running = 0;
                    }
                }
                _ -> { }
            }
        }
        if (running != 0) {
            now: int = mono_ns();
            dns: int = now - prev;
            prev = now;
            if (dns < 0) {
                dns = 0;
            }
            if (dns > 33000000) {
                dns = 33000000;
            }
            dt: f32 = dns as f32 / 1000000000.0;
            step_balls(balls, dt, width, height);
            glClear(16384);
            draw_balls(balls, u_center, u_scale, u_color, width, height);
            glXSwapBuffers(dpy, win);
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive != 0) {
        XDestroyWindow(dpy, win);
    }
    XCloseDisplay(dpy);
    0;
}
