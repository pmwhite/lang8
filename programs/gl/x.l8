// X11 types and functions. need "libX11.so.6" is pulled in with this file.
need "libX11.so.6";

type XVisualInfo = {
    visual: *i8;
    visualid: int;
    screen: i32;
    depth: i32;
    cls: i32;
    red_mask: int;
    green_mask: int;
    blue_mask: int;
    colormap_size: i32;
    bits_per_rgb: i32;
};

type XSetWindowAttributes = {
    background_pixmap: int;
    background_pixel: int;
    border_pixmap: int;
    border_pixel: int;
    bit_gravity: i32;
    win_gravity: i32;
    backing_store: i32;
    backing_planes: int;
    backing_pixel: int;
    save_under: i32;
    event_mask: int;
    do_not_propagate_mask: int;
    override_redirect: i32;
    colormap: int;
    cursor: int;
};

/* C XEvent: i32 type at 0, arms overlay, 24 longs. Match picks the arm. */
type XEvent: i32, 192 =
    | 0 Other
    | 2 KeyPress
    | 3 KeyRelease
    | 17 DestroyNotify
    | 33 ClientMessage {
        serial: int,
        send_event: i32,
        display: *i8,
        window: int,
        message_type: int,
        format: i32,
        l0: int
    };

extern XOpenDisplay(name: ?*i8): ?*i8;

extern XDefaultScreen(dpy: *i8): int;

extern XRootWindow(dpy: *i8, screen: int): int;

extern XBlackPixel(dpy: *i8, screen: int): int;

extern XWhitePixel(dpy: *i8, screen: int): int;

extern XCreateColormap(
    dpy: *i8,
    w: int,
    visual: *i8,
    alloc: int
): int;

extern XCreateSimpleWindow(
    dpy: *i8,
    parent: int,
    x: int,
    y: int,
    w: int,
    h: int,
    border: int,
    border_color: int,
    bg: int
): int;

extern XCreateWindow(
    dpy: *i8,
    parent: int,
    x: int,
    y: int,
    w: int,
    h: int,
    border: int,
    depth: int,
    cls: int,
    visual: *i8,
    mask: int,
    attrs: *XSetWindowAttributes
): int;

extern XStoreName(dpy: *i8, w: int, name: *i8): int;

extern XSetClassHint(dpy: *i8, w: int, hint: *i8): int;

extern XSetWMNormalHints(dpy: *i8, w: int, hints: *i8): int;

extern XSetWMHints(dpy: *i8, w: int, hints: *i8): int;

extern XChangeProperty(
    dpy: *i8,
    w: int,
    prop: int,
    typ: int,
    format: int,
    mode: int,
    data: *int,
    nelements: int
): int;

extern XMapRaised(dpy: *i8, w: int): int;

extern XMoveWindow(
    dpy: *i8,
    w: int,
    x: int,
    y: int
): int;

extern XFlush(dpy: *i8): int;

extern XSelectInput(dpy: *i8, w: int, mask: int): int;

extern XInternAtom(dpy: *i8, name: *i8, only_if_exists: int): int;

extern XSetWMProtocols(
    dpy: *i8,
    w: int,
    protocols: *int,
    n: int
): int;

extern XPending(dpy: *i8): int;

extern XNextEvent(dpy: *i8, ev: *XEvent): int;

extern XLookupKeysym(ev: *XEvent, index: int): int;

extern XkbSetDetectableAutoRepeat(dpy: *i8, detectable: int, supported: ?*i32): int;

extern XDestroyWindow(dpy: *i8, w: int): int;

extern XCloseDisplay(dpy: *i8): int;

cstr(s: []i8): []i8@new {
    n: int = len(s);
    o: []i8 = new i8[n + 1](0i8);
    i: int = 0;
    while (i < n) {
        o[i] = s[i];
        i = i + 1;
    }
    o[n] = 0i8;
    o;
}
