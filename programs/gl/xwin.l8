// Minimal X11 window (no GL) to check Sway/i3 mapping.
need "libX11.so.6";

extern exit(code: int): noreturn;
extern XOpenDisplay(name: ?*i8@): ?*i8;
extern XDefaultScreen(dpy: *i8@): int;
extern XRootWindow(dpy: *i8@, screen: int): int;
extern XBlackPixel(dpy: *i8@, screen: int): int;
extern XWhitePixel(dpy: *i8@, screen: int): int;
extern XCreateSimpleWindow(
    dpy: *i8@,
    parent: int,
    x: int,
    y: int,
    w: int,
    h: int,
    border: int,
    border_color: int,
    bg: int
): int;
extern XStoreName(dpy: *i8@, w: int, name: *i8@): int;
extern XSelectInput(dpy: *i8@, w: int, mask: int): int;
extern XMapRaised(dpy: *i8@, w: int): int;
extern XFlush(dpy: *i8@): int;
extern XPending(dpy: *i8@): int;
extern XNextEvent(dpy: *i8@, ev: *i8@): int;
extern l8_as_int(p: *i8@): int;

cstr(s: []i8): []i8@new {
    n: int = len(s);
    o: []i8 = new i8[n + 1](0i8);
    i: int = 0;
    while (i < n) {
        o[i] = s[i];
        i = i + 1;
    }
    o[n] = 0i8;
    o;
}

main(): int {
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        write(2, "XOpenDisplay failed\n", len("XOpenDisplay failed\n"));
        return 1;
    }
    dpy: *i8 = d0;
    scr: int = XDefaultScreen(dpy);
    root: int = XRootWindow(dpy, scr);
    black: int = XBlackPixel(dpy, scr);
    white: int = XWhitePixel(dpy, scr);
    win: int = XCreateSimpleWindow(dpy, root, 0, 0, 400, 300, 1, black, white);
    XStoreName(dpy, win, cstr("L8 xwin"));
    XSelectInput(dpy, win, 32769);
    XMapRaised(dpy, win);
    XFlush(dpy);
    write(2, "L8 xwin mapped\n", len("L8 xwin mapped\n"));
    ev: []i8 = new i8[256](0i8);
    n: int = 0;
    while (n < 200000000) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, ev);
        }
        n = n + 1;
    }
    0;
}
