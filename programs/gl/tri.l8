// OpenGL triangle via X11/GLX (XWayland is fine; native Wayland is not wired up).
// Needs DISPLAY. Quit with q, Escape, or the window close button.
need "libX11.so.6";
need "libGL.so.1";

extern exit(code: int): noreturn;
extern l8_as_int(p: *i8@): int;
extern l8_load64(p: *i8@, off: int): int;
extern XOpenDisplay(name: ?*i8@): ?*i8;
extern XDefaultScreen(dpy: *i8@): int;
extern XRootWindow(dpy: *i8@, screen: int): int;
extern XCreateColormap(dpy: *i8@, w: int, visual: int, alloc: int): int;
extern XCreateWindow(
    dpy: *i8@,
    parent: int,
    x: int,
    y: int,
    w: int,
    h: int,
    border: int,
    depth: int,
    cls: int,
    visual: int,
    mask: int,
    attrs: *i8@
): int;
extern XStoreName(dpy: *i8@, w: int, name: *i8@): int;
extern XSetClassHint(dpy: *i8@, w: int, hint: *i8@): int;
extern XSetWMNormalHints(dpy: *i8@, w: int, hints: *i8@): int;
extern XSetWMHints(dpy: *i8@, w: int, hints: *i8@): int;
extern XChangeProperty(
    dpy: *i8@,
    w: int,
    prop: int,
    typ: int,
    format: int,
    mode: int,
    data: *int@,
    nelements: int
): int;
extern XMapRaised(dpy: *i8@, w: int): int;
extern XMoveWindow(dpy: *i8@, w: int, x: int, y: int): int;
extern XFlush(dpy: *i8@): int;
extern XSelectInput(dpy: *i8@, w: int, mask: int): int;
extern XInternAtom(dpy: *i8@, name: *i8@, only_if_exists: int): int;
extern XSetWMProtocols(dpy: *i8@, w: int, protocols: *int@, n: int): int;
extern XPending(dpy: *i8@): int;
extern XNextEvent(dpy: *i8@, ev: *i8@): int;
extern XLookupKeysym(ev: *i8@, index: int): int;
extern XDestroyWindow(dpy: *i8@, w: int): int;
extern XCloseDisplay(dpy: *i8@): int;
extern glXChooseVisual(dpy: *i8@, screen: int, attr: *i8@): ?*i8;
extern glXCreateContext(dpy: *i8@, vis: *i8@, share: ?*i8@, direct: int): ?*i8;
extern glXMakeCurrent(dpy: *i8@, drawable: int, ctx: ?*i8@): int;
extern glXDestroyContext(dpy: *i8@, ctx: *i8@): int;
extern glXSwapBuffers(dpy: *i8@, drawable: int): int;
extern glCreateShader(kind: int): int;
extern glShaderSource(sh: int, count: int, strings: *int@, lengths: *i8@): int;
extern glCompileShader(sh: int): int;
extern glGetShaderiv(sh: int, pname: int, out: *i8@): int;
extern glGetShaderInfoLog(sh: int, max: int, len: ?*i8@, buf: *i8@): int;
extern glCreateProgram(): int;
extern glAttachShader(prog: int, sh: int): int;
extern glBindAttribLocation(prog: int, index: int, name: *i8@): int;
extern glLinkProgram(prog: int): int;
extern glGetProgramiv(prog: int, pname: int, out: *i8@): int;
extern glUseProgram(prog: int): int;
extern glGenVertexArrays(n: int, arrays: *i8@): int;
extern glBindVertexArray(arr: int): int;
extern glGenBuffers(n: int, bufs: *i8@): int;
extern glBindBuffer(target: int, buf: int): int;
extern glBufferData(target: int, size: int, data: *i8@, usage: int): int;
extern glVertexAttribPointer(
    index: int,
    size: int,
    typ: int,
    normalized: int,
    stride: int,
    ptr: int
): int;
extern glEnableVertexAttribArray(index: int): int;
extern glViewport(x: int, y: int, w: int, h: int): int;
extern glClearBufferfv(buffer: int, drawbuffer: int, value: *i8@): int;
extern glDrawArrays(mode: int, first: int, count: int): int;

put_i32(a: []i8, i: int, v: int) {
    o: int = i * 4;
    a[o] = (v & 255) trunc i8;
    a[o + 1] = (v >> 8 & 255) trunc i8;
    a[o + 2] = (v >> 16 & 255) trunc i8;
    a[o + 3] = (v >> 24 & 255) trunc i8;
}

put_u32(a: []i8, off: int, v: int) {
    a[off] = (v & 255) trunc i8;
    a[off + 1] = (v >> 8 & 255) trunc i8;
    a[off + 2] = (v >> 16 & 255) trunc i8;
    a[off + 3] = (v >> 24 & 255) trunc i8;
}

put_u64(a: []i8, off: int, v: int) {
    i: int = 0;
    x: int = v;
    while (i < 8) {
        a[off + i] = (x & 255) trunc i8;
        x = x >> 8;
        i = i + 1;
    }
}

get_i32(a: []i8, off: int): int {
    b0: int = a[off] as int & 255;
    b1: int = a[off + 1] as int & 255;
    b2: int = a[off + 2] as int & 255;
    b3: int = a[off + 3] as int & 255;
    b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
}

get_u64(a: []i8, off: int): int {
    v: int = 0;
    i: int = 0;
    while (i < 8) {
        v = v | (a[off + i] as int & 255) << i * 8;
        i = i + 1;
    }
    v;
}

cstr(s: []i8): []i8@new {
    n: int = len(s);
    o: []i8 = new i8[n + 1](0i8);
    i: int = 0;
    while (i < n) {
        o[i] = s[i];
        i = i + 1;
    }
    o[n] = 0i8;
    o;
}

die(msg: []i8): noreturn {
    write(2, msg, len(msg));
    write(2, "\n", 1);
    exit(1);
}

compile_shader(kind: int, src: []i8): int {
    sh: int = glCreateShader(kind);
    sp: []int = new int[1](0);
    sp[0] = l8_as_int(src);
    ln: []i8 = new i8[4](0i8);
    put_u32(ln, 0, len(src));
    glShaderSource(sh, 1, &sp[0], ln);
    glCompileShader(sh);
    st: []i8 = new i8[4](0i8);
    glGetShaderiv(sh, 35713, st);
    if (get_i32(st, 0) == 0) {
        logn: []i8 = new i8[4](0i8);
        glGetShaderiv(sh, 35716, logn);
        n: int = get_i32(logn, 0);
        if (n < 1) {
            n = 1;
        }
        if (n > 4096) {
            n = 4096;
        }
        buf: []i8 = new i8[n](0i8);
        glGetShaderInfoLog(sh, n, null, buf);
        write(2, buf, n);
        die("shader compile failed");
    }
    sh;
}

main(): int {
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        write(2, "XOpenDisplay failed (need DISPLAY / XWayland)\n", len(
            "XOpenDisplay failed (need DISPLAY / XWayland)\n"));
        return 1;
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i8 = new i8[48](0i8);
    put_i32(attr, 0, 4);
    put_i32(attr, 1, 5);
    put_i32(attr, 2, 8);
    put_i32(attr, 3, 8);
    put_i32(attr, 4, 9);
    put_i32(attr, 5, 8);
    put_i32(attr, 6, 10);
    put_i32(attr, 7, 8);
    put_i32(attr, 8, 12);
    put_i32(attr, 9, 16);
    put_i32(attr, 10, 0);
    vis0: ?*i8 = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) {
        die("glXChooseVisual failed");
    }
    vis: *i8 = vis0;
    visualp: int = l8_load64(vis, 0);
    depth: int = l8_load64(vis, 20) & 4294967295;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, visualp, 0);
    attrs: []i8 = new i8[112](0i8);
    put_u64(attrs, 24, 0);
    put_u64(attrs, 72, 163841);
    put_u64(attrs, 96, cmap);
    win: int = XCreateWindow(dpy, root, 0, 0, 640, 480, 0, depth, 1, visualp, 10248, attrs);
    if (win == 0) {
        die("XCreateWindow failed");
    }
    XStoreName(dpy, win, cstr("L8 triangle"));
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, cstr("WM_DELETE_WINDOW"), 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XFlush(dpy);
    write(2, "L8 triangle running (q / Escape / close to quit)\n", len(
        "L8 triangle running (q / Escape / close to quit)\n"));
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) {
        die("glXCreateContext failed");
    }
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) {
        die("glXMakeCurrent failed");
    }
    vs: []i8 = "#version 120\nattribute vec2 pos;\nvoid main() {\n  gl_Position = vec4(pos, 0.0, 1.0);\n}\n";
    fs: []i8 = "#version 120\nvoid main() {\n  gl_FragColor = vec4(0.2, 0.7, 1.0, 1.0);\n}\n";
    vsh: int = compile_shader(35633, vs);
    fsh: int = compile_shader(35632, fs);
    prog: int = glCreateProgram();
    glAttachShader(prog, vsh);
    glAttachShader(prog, fsh);
    glBindAttribLocation(prog, 0, cstr("pos"));
    glLinkProgram(prog);
    lst: []i8 = new i8[4](0i8);
    glGetProgramiv(prog, 35714, lst);
    if (get_i32(lst, 0) == 0) {
        die("program link failed");
    }
    glUseProgram(prog);
    va: []i8 = new i8[4](0i8);
    glGenVertexArrays(1, va);
    glBindVertexArray(get_i32(va, 0) & 4294967295);
    verts: []i8 = new i8[24](0i8);
    put_u32(verts, 0, 0);
    put_u32(verts, 4, 1061997773);
    put_u32(verts, 8, 3209481421);
    put_u32(verts, 12, 3209481421);
    put_u32(verts, 16, 1061997773);
    put_u32(verts, 20, 3209481421);
    ids: []i8 = new i8[4](0i8);
    glGenBuffers(1, ids);
    vbo: int = get_i32(ids, 0) & 4294967295;
    glBindBuffer(34962, vbo);
    glBufferData(34962, 24, verts, 35044);
    glVertexAttribPointer(0, 2, 5126, 0, 8, 0);
    glEnableVertexAttribArray(0);
    glViewport(0, 0, 640, 480);
    bg: []i8 = new i8[16](0i8);
    put_u32(bg, 12, 1065353216);
    ev: []i8 = new i8[256](0i8);
    running: int = 1;
    alive: int = 1;
    while (running != 0) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, ev);
            t: int = get_i32(ev, 0);
            if (t == 2) {
                ks: int = XLookupKeysym(ev, 0);
                if (ks == 113 || ks == 81 || ks == 65307) {
                    running = 0;
                }
            } else {
                if (t == 17) {
                    /* DestroyNotify: WM already tore the window down. */
                    running = 0;
                    alive = 0;
                } else {
                    if (t == 33) {
                        if (get_u64(ev, 56) == proto[0]) {
                            running = 0;
                        }
                    }
                }
            }
        }
        if (running != 0) {
            glClearBufferfv(6144, 0, bg);
            glDrawArrays(4, 0, 3);
            glXSwapBuffers(dpy, win);
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive != 0) {
        XDestroyWindow(dpy, win);
    }
    XCloseDisplay(dpy);
    0;
}
