// OpenGL triangle via X11/GLX (XWayland is fine; native Wayland is not wired up).
// Needs DISPLAY. Quit with q, Escape, or the window close button.
need "libX11.so.6";

need "libGL.so.1";

type XVisualInfo = {
    visual: *i8;
    visualid: int;
    screen: i32;
    depth: i32;
    cls: i32;
    red_mask: int;
    green_mask: int;
    blue_mask: int;
    colormap_size: i32;
    bits_per_rgb: i32;
};

type XSetWindowAttributes = {
    background_pixmap: int;
    background_pixel: int;
    border_pixmap: int;
    border_pixel: int;
    bit_gravity: i32;
    win_gravity: i32;
    backing_store: i32;
    backing_planes: int;
    backing_pixel: int;
    save_under: i32;
    event_mask: int;
    do_not_propagate_mask: int;
    override_redirect: i32;
    colormap: int;
    cursor: int;
};

/* C XEvent: i32 type at 0, arms overlay, 24 longs. Match picks the arm. */
type XEvent: i32, 192 =
    | 0 Other
    | 2 KeyPress
    | 17 DestroyNotify
    | 33 ClientMessage {
        serial: int,
        send_event: i32,
        display: *i8,
        window: int,
        message_type: int,
        format: i32,
        l0: int
    };

extern exit(code: int): noreturn;

extern XOpenDisplay(name: ?*i8): ?*i8;

extern XDefaultScreen(dpy: *i8): int;

extern XRootWindow(dpy: *i8, screen: int): int;

extern XCreateColormap(
    dpy: *i8,
    w: int,
    visual: *i8,
    alloc: int
): int;

extern XCreateWindow(
    dpy: *i8,
    parent: int,
    x: int,
    y: int,
    w: int,
    h: int,
    border: int,
    depth: int,
    cls: int,
    visual: *i8,
    mask: int,
    attrs: *XSetWindowAttributes
): int;

extern XStoreName(dpy: *i8, w: int, name: *i8): int;

extern XSetClassHint(dpy: *i8, w: int, hint: *i8): int;

extern XSetWMNormalHints(dpy: *i8, w: int, hints: *i8): int;

extern XSetWMHints(dpy: *i8, w: int, hints: *i8): int;

extern XChangeProperty(
    dpy: *i8,
    w: int,
    prop: int,
    typ: int,
    format: int,
    mode: int,
    data: *int,
    nelements: int
): int;

extern XMapRaised(dpy: *i8, w: int): int;

extern XMoveWindow(
    dpy: *i8,
    w: int,
    x: int,
    y: int
): int;

extern XFlush(dpy: *i8): int;

extern XSelectInput(dpy: *i8, w: int, mask: int): int;

extern XInternAtom(dpy: *i8, name: *i8, only_if_exists: int): int;

extern XSetWMProtocols(
    dpy: *i8,
    w: int,
    protocols: *int,
    n: int
): int;

extern XPending(dpy: *i8): int;

extern XNextEvent(dpy: *i8, ev: *XEvent): int;

extern XLookupKeysym(ev: *XEvent, index: int): int;

extern XDestroyWindow(dpy: *i8, w: int): int;

extern XCloseDisplay(dpy: *i8): int;

extern glXChooseVisual(dpy: *i8, screen: int, attr: *i32): ?*XVisualInfo;

extern glXCreateContext(
    dpy: *i8,
    vis: *XVisualInfo,
    share: ?*i8,
    direct: int
): ?*i8;

extern glXMakeCurrent(dpy: *i8, drawable: int, ctx: ?*i8): int;

extern glXDestroyContext(dpy: *i8, ctx: *i8): int;

extern glXSwapBuffers(dpy: *i8, drawable: int): int;

extern glCreateShader(kind: int): int;

extern glShaderSource(
    sh: int,
    count: int,
    strings: **i8,
    lengths: *i32
): int;

extern glCompileShader(sh: int): int;

extern glGetShaderiv(sh: int, pname: int, out: *i32): int;

extern glGetShaderInfoLog(
    sh: int,
    max: int,
    len: ?*i32,
    buf: *i8
): int;

extern glCreateProgram(): int;

extern glAttachShader(prog: int, sh: int): int;

extern glBindAttribLocation(prog: int, index: int, name: *i8): int;

extern glLinkProgram(prog: int): int;

extern glGetProgramiv(prog: int, pname: int, out: *i32): int;

extern glUseProgram(prog: int): int;

extern glGenVertexArrays(n: int, arrays: *u32): int;

extern glBindVertexArray(arr: u32): int;

extern glGenBuffers(n: int, bufs: *u32): int;

extern glBindBuffer(target: int, buf: u32): int;

extern glBufferData(
    target: int,
    size: int,
    data: *f32,
    usage: int
): int;

extern glVertexAttribPointer(
    index: int,
    size: int,
    typ: int,
    normalized: int,
    stride: int,
    ptr: int
): int;

extern glEnableVertexAttribArray(index: int): int;

extern glViewport(
    x: int,
    y: int,
    w: int,
    h: int
): int;

extern glClearColor(
    r: f32,
    g: f32,
    b: f32,
    a: f32
): int;

extern glClear(mask: int): int;

extern glDrawArrays(mode: int, first: int, count: int): int;

cstr(s: []i8): []i8@new {
    n: int = len(s);
    o: []i8 = new i8[n + 1](0i8);
    i: int = 0;
    while (i < n) {
        o[i] = s[i];
        i = i + 1;
    }
    o[n] = 0i8;
    o;
}

die(msg: []i8): noreturn {
    write(2, msg, len(msg));
    write(2, "\n", 1);
    exit(1);
}

compile_shader(kind: int, src: []i8): int {
    sh: int = glCreateShader(kind);
    sp: *i8 = src;
    ln: []i32 = new i32[1](len(src) trunc i32);
    glShaderSource(sh, 1, &sp, ln);
    glCompileShader(sh);
    st: []i32 = new i32[1](0i32);
    glGetShaderiv(sh, 35713, st);
    if (st[0] == 0i32) {
        logn: []i32 = new i32[1](0i32);
        glGetShaderiv(sh, 35716, logn);
        n: int = logn[0] as int;
        if (n < 1) {
            n = 1;
        }
        if (n > 4096) {
            n = 4096;
        }
        buf: []i8 = new i8[n](0i8);
        glGetShaderInfoLog(sh, n, null, buf);
        write(2, buf, n);
        die("shader compile failed");
    }
    sh;
}

main(): int {
    d0: ?*i8 = XOpenDisplay(null);
    if (d0 == null) {
        write(2, "XOpenDisplay failed (need DISPLAY / XWayland)\n", len("XOpenDisplay failed (need DISPLAY / XWayland)\n"));
        return 1;
    }
    dpy: *i8 = d0;
    screen: int = XDefaultScreen(dpy);
    attr: []i32 = [
        4i32,
        5i32,
        8i32,
        8i32,
        9i32,
        8i32,
        10i32,
        8i32,
        12i32,
        16i32,
        0i32
    ];
    vis0: ?*XVisualInfo = glXChooseVisual(dpy, screen, attr);
    if (vis0 == null) {
        die("glXChooseVisual failed");
    }
    vis: *XVisualInfo = vis0;
    root: int = XRootWindow(dpy, screen);
    cmap: int = XCreateColormap(dpy, root, vis.visual, 0);
    wa: XSetWindowAttributes = XSetWindowAttributes {
        background_pixmap: 0,
        background_pixel: 0,
        border_pixmap: 0,
        border_pixel: 0,
        bit_gravity: 0i32,
        win_gravity: 0i32,
        backing_store: 0i32,
        backing_planes: 0,
        backing_pixel: 0,
        save_under: 0i32,
        event_mask: 163841,
        do_not_propagate_mask: 0,
        override_redirect: 0i32,
        colormap: cmap,
        cursor: 0
    };
    win: int = XCreateWindow(dpy, root, 0, 0, 640, 480, 0, vis.depth as int, 1, vis.visual,
        10248, &wa);
    if (win == 0) {
        die("XCreateWindow failed");
    }
    XStoreName(dpy, win, cstr("L8 triangle"));
    proto: []int = new int[1](0);
    proto[0] = XInternAtom(dpy, cstr("WM_DELETE_WINDOW"), 0);
    XSetWMProtocols(dpy, win, &proto[0], 1);
    XMapRaised(dpy, win);
    XFlush(dpy);
    write(2, "L8 triangle running (q / Escape / close to quit)\n", len("L8 triangle running (q / Escape / close to quit)\n"));
    ctx0: ?*i8 = glXCreateContext(dpy, vis, null, 1);
    if (ctx0 == null) {
        die("glXCreateContext failed");
    }
    ctx: *i8 = ctx0;
    if (glXMakeCurrent(dpy, win, ctx) == 0) {
        die("glXMakeCurrent failed");
    }
    vs: []i8 = """
#version 120
attribute vec2 pos;
void main() {
  gl_Position = vec4(pos, 0.0, 1.0);
}
""";
    fs: []i8 = """
#version 120
void main() {
  gl_FragColor = vec4(0.2, 0.7, 1.0, 1.0);
}
""";
    vsh: int = compile_shader(35633, vs);
    fsh: int = compile_shader(35632, fs);
    prog: int = glCreateProgram();
    glAttachShader(prog, vsh);
    glAttachShader(prog, fsh);
    glBindAttribLocation(prog, 0, cstr("pos"));
    glLinkProgram(prog);
    lst: []i32 = new i32[1](0i32);
    glGetProgramiv(prog, 35714, lst);
    if (lst[0] == 0i32) {
        die("program link failed");
    }
    glUseProgram(prog);
    va: []u32 = new u32[1](0u32);
    glGenVertexArrays(1, va);
    glBindVertexArray(va[0]);
    verts: []f32 = [0.0, 0.8, -0.8, -0.8, 0.8, -0.8];
    ids: []u32 = new u32[1](0u32);
    glGenBuffers(1, ids);
    glBindBuffer(34962, ids[0]);
    glBufferData(34962, len(verts) * 4, verts, 35044);
    glVertexAttribPointer(0, 2, 5126, 0, 8, 0);
    glEnableVertexAttribArray(0);
    glViewport(0, 0, 640, 480);
    glClearColor(0.0, 0.0, 0.0, 1.0);
    ev: XEvent = XEvent.Other;
    running: int = 1;
    alive: int = 1;
    while (running != 0) {
        while (XPending(dpy) != 0) {
            XNextEvent(dpy, &ev);
            match ev {
                KeyPress -> {
                    ks: int = XLookupKeysym(&ev, 0);
                    if (ks == 113 || ks == 81 || ks == 65307) {
                        running = 0;
                    }
                }
                DestroyNotify -> {
                    running = 0;
                    alive = 0;
                }
                ClientMessage c -> {
                    if (c.l0 == proto[0]) {
                        running = 0;
                    }
                }
                _ -> { }
            }
        }
        if (running != 0) {
            glClear(16384);
            glDrawArrays(4, 0, 3);
            glXSwapBuffers(dpy, win);
        }
    }
    glXMakeCurrent(dpy, 0, null);
    glXDestroyContext(dpy, ctx);
    if (alive != 0) {
        XDestroyWindow(dpy, win);
    }
    XCloseDisplay(dpy);
    0;
}
